// tradetape: Live Trade Tape demo connecting Lexell's HTTP/1.1 + HTTP/2 server
// to LexDB over the PostgreSQL wire protocol, streaming Server-Sent Events directly
// from LexDB's `SELECT ... WAIT` clause—no polling, no connection pool, no broker.
//
// Two streaming architectures selectable via --mode:
//   --mode hub (default): ONE background LexDB `SELECT ... WAIT` connection feeds
//     in-process `sse.Feed` broadcast hubs (all-symbols + per-symbol), scaling to
//     thousands of concurrent SSE subscribers with O(1) database load.
//   --mode direct: Each SSE subscriber opens its own dedicated LexDB `SELECT ... WAIT`
//     connection (minimal 1-to-1 pattern, ideal up to ~100-200 subscribers).
//
// Usage:
//   tradetape [ADDR] [--dsn DSN] [--mode hub|direct] [--wait-sec N] [--tls-cert FILE --tls-key FILE]

import "http"
import "httpserver" as hs
import "postgres"
import "net"
import "tls"
import "task"
import "io"
import "os"
import "time"
import "strings"
import "json"
import "csv"
import "zlib"
import "zstd"
import "decimal"
import "./ui"
import "./hub"

// ---------------------------------------------------------------- domain types (derived Serialize/Deserialize)

type CreateTrade = record {
    symbol: str
    side: str
    price: Decimal
    qty: int
    note: Option[str]
}

type Trade = hub.Trade

type ReadyEvent = value record {
    after: int
    symbol: str
    proto: str
    mode: str
}

type StatsReply = value record {
    mode: str
    activeStreams: int
    openConns: int
    accepted: int
    requests: int
}

// Application state shared read-only across tasks (no DB connection pool!).
type App = value record {
    dsn: str
    waitSec: int
    hubMode: bool
    hub: hub.Hub
    activeStreams: task.Shared[int]
}

fn (a: &App) share(): App {
    return App{
        dsn: a.dsn.clone(), waitSec: a.waitSec, hubMode: a.hubMode,
        hub: a.hub.share(), activeStreams: a.activeStreams.share()
    }
}

// RAII guard that tracks active SSE subscriber count and decrements on any exit path.
type StreamGuard = record {
    counter: task.Shared[int]
}

fn (g: mut &StreamGuard) drop() {
    g.counter.with(fn(n: mut &int) { n -= 1 })
}

// ---------------------------------------------------------------- LexDB schema & queries

const SCHEMA_SQL = `
CREATE TABLE IF NOT EXISTS seq_counter (
    id text PRIMARY KEY,
    n  bigint NOT NULL
);
INSERT INTO seq_counter (id, n) VALUES ('trades', 0) ON CONFLICT (id) DO NOTHING;
CREATE TABLE IF NOT EXISTS trades (
    seq    bigint PRIMARY KEY,
    symbol text NOT NULL,
    side   text NOT NULL,
    price  numeric(14, 4) NOT NULL,
    qty    bigint NOT NULL,
    note   text NOT NULL,
    at_ms  bigint NOT NULL
);
CREATE INDEX IF NOT EXISTS trades_symbol_seq ON trades (symbol, seq);
`

fn initSchema(dsn: &str): Result[Unit, box Error] {
    var conn = try postgres.connect(dsn).context("connecting to LexDB")
    try conn.exec(SCHEMA_SQL).context("initializing trade tape schema")
    return Ok(Unit{})
}

fn normalizeSymbol(raw: &str): Result[str, hs.Error] {
    let s = strings.toUpperAscii(&(strings.trim(raw)))
    if len(s) == 0 || len(s) > 16 {
        return Err(hs.error(400, "symbol must be 1..16 alphanumeric characters"))
    }
    for i in 0..len(s) {
        let c = s[i]
        let ok = (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '/'
        if !ok { return Err(hs.error(400, "symbol contains invalid characters")) }
    }
    return Ok(s)
}

fn insertTrade(dsn: &str, sym: &str, side: &str, price: Decimal, qty: int, note: &str): Result[Trade, postgres.Error] {
    var conn = try postgres.connect(dsn)
    let pParam = try postgres.decimalParam(price, 14, 4)
    let now = time.now()
    let nowMs = now.sec * 1000 + now.nsec / 1000000
    var attempt = 0
    while attempt < 8 {
        attempt += 1
        let res = conn.transaction(fn(c: mut &postgres.Conn): Result[Trade, postgres.Error] {
            let ctr = try c.query("UPDATE seq_counter SET n = n + 1 WHERE id = 'trades' RETURNING n", &[])
            let seq = try ctr.int(0, 0)
            let _ins = try c.query(
                "INSERT INTO trades (seq, symbol, side, price, qty, note, at_ms) VALUES ($1, $2, $3, $4, $5, $6, $7)",
                &[
                    postgres.Value.Int(seq),
                    postgres.Value.Text(sym.clone()),
                    postgres.Value.Text(side.clone()),
                    pParam.clone(),
                    postgres.Value.Int(qty),
                    postgres.Value.Text(note.clone()),
                    postgres.Value.Int(nowMs)
                ]
            )
            let notional = price * decimal.Decimal.fromInt(qty)
            return Ok(Trade{
                seq: seq, symbol: sym.clone(), side: side.clone(), price: price,
                qty: qty, notional: notional, note: note.clone(), atMs: nowMs
            })
        })
        match move(res) {
            Ok(t) { return Ok(t) }
            Err(e) {
                if e.state == "40001" && attempt < 8 { continue }
                return Err(e)
            }
        }
    }
    return Err(postgres.connect(dsn).unwrapErr())
}

fn fetchTrades(dsn: &str, sym: &str, limit: int): Result[[]Trade, postgres.Error] {
    var conn = try postgres.connect(dsn)
    let rows = if len(sym) == 0 {
        try conn.query(
            "SELECT seq, symbol, side, price, qty, note, at_ms FROM trades ORDER BY seq DESC LIMIT $1",
            &[postgres.Value.Int(limit)]
        )
    } else {
        try conn.query(
            "SELECT seq, symbol, side, price, qty, note, at_ms FROM trades WHERE symbol = $1 ORDER BY seq DESC LIMIT $2",
            &[postgres.Value.Text(sym.clone()), postgres.Value.Int(limit)]
        )
    }
    var out: []Trade = []
    for i in 0..rows.rowCount() {
        append(mut &out, try hub.tradeFromRow(&rows, i))
    }
    return Ok(out)
}

fn fetchCatchup(dsn: &str, sym: &str, afterSeq: int, upToSeq: int): Result[[]Trade, postgres.Error] {
    var conn = try postgres.connect(dsn)
    let rows = if len(sym) == 0 {
        try conn.query(
            "SELECT seq, symbol, side, price, qty, note, at_ms FROM trades WHERE seq > $1 AND seq <= $2 ORDER BY seq LIMIT 500",
            &[postgres.Value.Int(afterSeq), postgres.Value.Int(upToSeq)]
        )
    } else {
        try conn.query(
            "SELECT seq, symbol, side, price, qty, note, at_ms FROM trades WHERE symbol = $1 AND seq > $2 AND seq <= $3 ORDER BY seq LIMIT 500",
            &[postgres.Value.Text(sym.clone()), postgres.Value.Int(afterSeq), postgres.Value.Int(upToSeq)]
        )
    }
    var out: []Trade = []
    for i in 0..rows.rowCount() {
        append(mut &out, try hub.tradeFromRow(&rows, i))
    }
    return Ok(out)
}

// ---------------------------------------------------------------- HTTP handlers

fn handlePostTrade(app: &App, rq: mut &hs.Request, w: mut &hs.Response): Result[Unit, hs.Error] {
    let body = try rq.text(65536)
    let req = match json.decode[CreateTrade](&body) {
        Ok(x) { x }
        Err(e) { return Err(hs.error(400, &("invalid JSON: " + e.toStr()))) }
    }
    let sym = try normalizeSymbol(&req.symbol)
    let side = strings.toUpperAscii(&(strings.trim(&req.side)))
    if side != "BUY" && side != "SELL" {
        return Err(hs.error(400, "side must be BUY or SELL"))
    }
    if req.price <= 0m {
        return Err(hs.error(400, "price must be positive"))
    }
    if req.qty <= 0 {
        return Err(hs.error(400, "qty must be positive"))
    }
    let note = match &req.note {
        Some(n) { n.clone() }
        None { "" }
    }
    let trade = try hs.check(insertTrade(&app.dsn, &sym, &side, req.price, req.qty, &note), 503)
    w.status(201)
    return w.json(&(json.encode(&trade)))
}

fn handleListTrades(app: &App, rq: mut &hs.Request, w: mut &hs.Response): Result[Unit, hs.Error] {
    var sym = ""
    match rq.query("symbol") {
        Some(raw) {
            if len(strings.trim(&raw)) > 0 { sym = try normalizeSymbol(&raw) }
        }
        None {}
    }
    var limit = 50
    match rq.query("limit") {
        Some(ls) {
            match strings.parseIntOpt(&ls) {
                Some(n) { if n >= 1 && n <= 1000 { limit = n } }
                None { return Err(hs.error(400, "limit must be an integer")) }
            }
        }
        None {}
    }
    let trades = try hs.check(fetchTrades(&app.dsn, &sym, limit), 503)
    return w.json(&(json.encode(&trades)))
}

fn handleExportCsv(app: &App, rq: mut &hs.Request, w: mut &hs.Response): Result[Unit, hs.Error] {
    var sym = ""
    match rq.query("symbol") {
        Some(raw) {
            if len(strings.trim(&raw)) > 0 { sym = try normalizeSymbol(&raw) }
        }
        None {}
    }
    let trades = try hs.check(fetchTrades(&app.dsn, &sym, 1000), 503)
    let fmt = match rq.query("format") {
        Some(f) { f }
        None { "excel" }
    }
    let opts = if fmt == "pg" { csv.postgresCsv() } else if fmt == "tsv" { csv.tsv() } else { csv.excel() }
    let body = if len(trades) == 0 {
        try hs.check(csv.stringifyWith(&[["seq", "symbol", "side", "price", "qty", "notional", "note", "atMs"]], opts), 500)
    } else {
        try hs.check(csv.encodeWith(&trades, opts), 500)
    }
    w.header("Content-Type", if fmt == "tsv" { "text/tab-separated-values; charset=utf-8" } else { "text/csv; charset=utf-8" })
    w.header("Content-Disposition", if fmt == "tsv" { "attachment; filename=\"trades.tsv\"" } else { "attachment; filename=\"trades.csv\"" })
    return w.writeStr(&body)
}

type StreamParams = record {
    sym: str
    cursor: int
    hasExplicitAfter: bool
}

fn parseStreamParams(rq: &hs.Request): Result[StreamParams, hs.Error] {
    var sym = ""
    match rq.query("symbol") {
        Some(raw) {
            if len(strings.trim(&raw)) > 0 { sym = try normalizeSymbol(&raw) }
        }
        None {}
    }
    var cursor = 0
    var explicit = false
    match rq.header("Last-Event-ID") {
        Some(v) {
            match strings.parseIntOpt(&(strings.trim(&v))) {
                Some(n) { if n >= 0 { cursor = n; explicit = true } }
                None {}
            }
        }
        None {
            match rq.query("after") {
                Some(v) {
                    match strings.parseIntOpt(&(strings.trim(&v))) {
                        Some(n) { if n >= 0 { cursor = n; explicit = true } }
                        None { return Err(hs.error(400, "after must be a non-negative integer")) }
                    }
                }
                None {}
            }
        }
    }
    return Ok(StreamParams{sym: sym, cursor: cursor, hasExplicitAfter: explicit})
}

// Mode 1 (--mode hub, default): subscribes to the in-process sse.Feed fed by a
// single background LexDB `SELECT ... WAIT` relay task. Scales to thousands of
// concurrent SSE subscribers with O(1) database load and 0 DB connections per client.
fn handleStreamHub(app: &App, rq: mut &hs.Request, w: mut &hs.Response, p: &StreamParams): Result[Unit, hs.Error] {
    let hub.Subscription{cursor: cur0, hubSeq: hubSeq} = app.hub.subscribe(&p.sym, p.cursor)
    var cur = cur0
    var lastSent = p.cursor

    app.activeStreams.with(fn(n: mut &int) { n += 1 })
    let _guard = StreamGuard{counter: app.activeStreams.share()}

    try w.startEvents()
    let ready = ReadyEvent{after: p.cursor, symbol: p.sym.clone(), proto: rq.proto.clone(), mode: "hub"}
    try w.event("ready", &(json.encode(&ready)))

    // If historical trades already exist in LexDB prior to the live feed cursor
    // (e.g. cold reconnect older than sse.KEEP or initial load after server restart),
    // catch up once from LexDB and deduplicate against the live sse.Feed cursor.
    if hubSeq > p.cursor && (!p.hasExplicitAfter || p.cursor == 0 || hubSeq - p.cursor > 60) {
        let hist = try hs.check(fetchCatchup(&app.dsn, &p.sym, p.cursor, hubSeq), 503)
        for i in 0..len(hist) {
            let t = &hist[i]
            if t.seq > lastSent {
                lastSent = t.seq
                let seqStr = t.seq.toStr()
                let payload = json.encode(t)
                try w.eventWith(&seqStr, "trade", &payload)
            }
        }
    }

    let keepAliveMs = app.waitSec * 1000
    while !task.cancelled() {
        match cur.wait(keepAliveMs) {
            Ok(optEv) {
                match optEv {
                    Some(ev) {
                        let evSeq = strings.parseIntOpt(&ev.id).unwrapOr(0)
                        if evSeq == 0 || evSeq > lastSent {
                            if evSeq > lastSent { lastSent = evSeq }
                            try w.eventWith(&ev.id, &ev.name, &ev.data)
                        }
                    }
                    None {
                        if task.cancelled() { return Ok(Unit{}) }
                        try w.keepAlive()
                    }
                }
            }
            Err(_) { return Ok(Unit{}) }
        }
    }
    return Ok(Unit{})
}

// Mode 2 (--mode direct): each SSE subscriber holds ONE dedicated LexDB connection
// running a prepared `SELECT ... WAIT` query until the client closes the stream.
fn handleStreamDirect(app: &App, rq: mut &hs.Request, w: mut &hs.Response, p: &StreamParams): Result[Unit, hs.Error] {
    var cursor = p.cursor
    var conn = try hs.check(postgres.connect(&app.dsn), 503)
    conn.setCloseOnCancel(true)
    let waitSql = if len(p.sym) == 0 {
        $"SELECT seq, symbol, side, price, qty, note, at_ms FROM trades WHERE seq > $1 ORDER BY seq LIMIT 64 WAIT {app.waitSec} SECONDS"
    } else {
        $"SELECT seq, symbol, side, price, qty, note, at_ms FROM trades WHERE symbol = $2 AND seq > $1 ORDER BY seq LIMIT 64 WAIT {app.waitSec} SECONDS"
    }
    let stmt = try hs.check(conn.prepare(&waitSql), 503)

    app.activeStreams.with(fn(n: mut &int) { n += 1 })
    let _guard = StreamGuard{counter: app.activeStreams.share()}

    try w.startEvents()
    let ready = ReadyEvent{after: cursor, symbol: p.sym.clone(), proto: rq.proto.clone(), mode: "direct"}
    try w.event("ready", &(json.encode(&ready)))

    while !task.cancelled() {
        let rowsRes = if len(p.sym) == 0 {
            conn.queryPrepared(&stmt, &[postgres.Value.Int(cursor)])
        } else {
            conn.queryPrepared(&stmt, &[postgres.Value.Int(cursor), postgres.Value.Text(p.sym.clone())])
        }
        match move(rowsRes) {
            Ok(rows) {
                if rows.rowCount() == 0 {
                    if task.cancelled() { return Ok(Unit{}) }
                    try w.keepAlive()
                    continue
                }
                for i in 0..rows.rowCount() {
                    let trade = try hs.check(hub.tradeFromRow(&rows, i), 500)
                    cursor = trade.seq
                    let seqStr = trade.seq.toStr()
                    let payload = json.encode(&trade)
                    try w.eventWith(&seqStr, "trade", &payload)
                }
            }
            Err(e) {
                if task.cancelled() || e.code == 10 { return Ok(Unit{}) }
                return Err(hs.error(503, &("lexdb wait failed: " + e.toStr())))
            }
        }
    }
    return Ok(Unit{})
}

fn handleStream(app: &App, rq: mut &hs.Request, w: mut &hs.Response): Result[Unit, hs.Error] {
    let p = try parseStreamParams(rq)
    if app.hubMode {
        return handleStreamHub(app, rq, w, &p)
    }
    return handleStreamDirect(app, rq, w, &p)
}

fn handleStats(app: &App, rq: mut &hs.Request, w: mut &hs.Response): Result[Unit, hs.Error] {
    var active = 0
    app.activeStreams.with(fn(n: mut &int) { active = n })
    let s = rq.serverStats()
    let reply = StatsReply{
        mode: if app.hubMode { "hub" } else { "direct" },
        activeStreams: active, openConns: s.open, accepted: s.accepted, requests: s.requests
    }
    return w.json(&(json.encode(&reply)))
}

// ---------------------------------------------------------------- CLI & main

type CliConfig = record {
    addr: str
    dsn: str
    hubMode: bool
    waitSec: int
    tlsCert: str
    tlsKey: str
}

fn parseCli(): Result[CliConfig, str] {
    var cfg = CliConfig{
        addr: "127.0.0.1:8080",
        dsn: os.envOr("LEXDB_DSN", "host=127.0.0.1 port=5433 dbname=lexdb user=postgres"),
        hubMode: true,
        waitSec: 10,
        tlsCert: "",
        tlsKey: ""
    }
    let args = os.arguments()
    var i = 0
    while i < len(args) {
        let a = &args[i]
        if a == "--dsn" && i + 1 < len(args) {
            cfg.dsn = args[i + 1].clone()
            i += 2
        } else if a == "--mode" && i + 1 < len(args) {
            let m = &args[i + 1]
            if m == "hub" { cfg.hubMode = true }
            else if m == "direct" { cfg.hubMode = false }
            else { return Err("--mode must be 'hub' or 'direct'") }
            i += 2
        } else if a == "--wait-sec" && i + 1 < len(args) {
            match strings.parseIntOpt(&args[i + 1]) {
                Some(n) {
                    if n < 1 || n > 60 { return Err("--wait-sec must be 1..60") }
                    cfg.waitSec = n
                }
                None { return Err("--wait-sec must be an integer") }
            }
            i += 2
        } else if a == "--tls-cert" && i + 1 < len(args) {
            cfg.tlsCert = args[i + 1].clone()
            i += 2
        } else if a == "--tls-key" && i + 1 < len(args) {
            cfg.tlsKey = args[i + 1].clone()
            i += 2
        } else if a == "-h" || a == "--help" {
            println("Usage: tradetape [ADDR] [--dsn DSN] [--mode hub|direct] [--wait-sec N] [--tls-cert FILE --tls-key FILE]")
            os.quit(0)
        } else if !strings.startsWith(a, "-") {
            cfg.addr = a.clone()
            i += 1
        } else {
            return Err("unknown argument: " + a)
        }
    }
    return Ok(cfg)
}

fn buildRouter(): hs.Router[App] {
    var r = hs.router[App]()
    r.use(hs.requestId[App])
    r.useFn(hs.compress[App]([zstd.codec(), zlib.gzipCodec(), zlib.deflateCodec()], hs.compressOpts()))

    r.handleFn("GET /{$}", box fn(app: &App, rq: mut &hs.Request, w: mut &hs.Response): Result[Unit, hs.Error] {
        w.header("Content-Type", "text/html; charset=utf-8")
        return w.writeStr(ui.DASHBOARD_HTML)
    })
    r.handle("POST /api/trades", handlePostTrade)
    r.handle("GET /api/trades", handleListTrades)
    r.handle("GET /api/trades/export.csv", handleExportCsv)
    r.handleWith("GET /api/stream", handleStream, hs.RouteOpts{deadlineMs: 0, maxBody: 0})
    r.handle("GET /api/stats", handleStats)
    r.handleFn("POST /api/shutdown", box fn(app: &App, rq: mut &hs.Request, w: mut &hs.Response): Result[Unit, hs.Error] {
        rq.stopServer()
        return w.text("shutting down\n")
    })
    return r
}

fn die(msg: &str, code: int): never {
    eprintln(msg)
    os.quit(code)
}

fn runServer(ln: net.Listener, cli: &CliConfig, app: App, router: hs.Router[App], cfg: hs.Config) {
    let bound = ln.localAddr()
    let modeName = if cli.hubMode { "hub" } else { "direct" }
    if len(cli.tlsCert) > 0 {
        let keyPath = if len(cli.tlsKey) > 0 { cli.tlsKey.clone() } else { cli.tlsCert.clone() }
        var topts = tls.defaults()
        topts.alpn = "h2,http/1.1"
        topts.certFile = cli.tlsCert.clone()
        topts.keyFile = keyPath
        let ctx = match tls.server(topts) {
            Ok(c) { c }
            Err(e) { die(&($"tradetape: tls: {e}"), 1) }
        }
        println($"listening on https://{bound} (HTTP/2 + HTTP/1.1, mode={modeName}, wait={cli.waitSec}s)")
        let _fl = io.flushStdout()
        match hs.serveTls(ln, ctx, app, router, cfg) {
            Ok(st) { println($"stopped: accepted={st.accepted} requests={st.requests}") }
            Err(e) { die(&($"tradetape: serveTls: {e}"), 1) }
        }
    } else {
        println($"listening on http://{bound} (HTTP/2 h2c + HTTP/1.1, mode={modeName}, wait={cli.waitSec}s)")
        let _fl = io.flushStdout()
        match hs.serve(ln, app, router, cfg) {
            Ok(st) { println($"stopped: accepted={st.accepted} requests={st.requests}") }
            Err(e) { die(&($"tradetape: serve: {e}"), 1) }
        }
    }
}

fn main() {
    let cli = match parseCli() {
        Ok(c) { c }
        Err(msg) { die(&($"tradetape: {msg}"), 2) }
    }

    match initSchema(&cli.dsn) {
        Ok(_) {}
        Err(e) { die(&($"tradetape: failed to initialize LexDB: {e}"), 1) }
    }

    let h = hub.newHub()
    let app = App{dsn: cli.dsn.clone(), waitSec: cli.waitSec, hubMode: cli.hubMode, hub: h.share(), activeStreams: task.shared(0)}
    let router = buildRouter()

    var cfg = hs.defaults()
    cfg.h2c = true
    cfg.drainMs = 2000

    if cli.hubMode {
        // Structured concurrency: run the single LexDB SELECT ... WAIT relay task
        // alongside httpserver.serve. When serve stops, relayFut drops -> cancels
        // the relay task -> closes its dedicated LexDB socket immediately.
        task.scope(fn(s: mut &task.Scope) {
            let task.Handoff{promise: readyPr, future: readyFut} = task.promise[str]()
            let relayFut = s.start(hub.runRelay, hub.RelayJob{
                hub: h.share(), dsn: cli.dsn.clone(), waitSec: cli.waitSec, ready: readyPr
            })
            let status = readyFut.wait().unwrap()
            if status != "ok" {
                die(&($"tradetape: relay failed: {status}"), 1)
            }
            let ln = match net.listen(&cli.addr) {
                Ok(l) { l }
                Err(e) { die(&($"tradetape: listen {cli.addr}: {e}"), 1) }
            }
            runServer(ln, &cli, app.share(), buildRouter(), cfg.clone())
            let _dropRelay = relayFut
        })
    } else {
        let ln = match net.listen(&cli.addr) {
            Ok(l) { l }
            Err(e) { die(&($"tradetape: listen {cli.addr}: {e}"), 1) }
        }
        runServer(ln, &cli, app, router, cfg)
    }
}
