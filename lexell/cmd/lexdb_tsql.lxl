// lexdb: T-SQL batches, run (design/lexdb-tds.md). lexdb_tsqlparse parses a
// batch whole (parseBatch); this runs its statements against a session with SQL
// Server's rules, and says what happened as events for the protocol
// (lexdb_tds) to send.
//
// Variables: a batch's variables are its statements' parameters. The frame
// holds them in order, @@ system values first (@@TRANCOUNT, @@ROWCOUNT,
// @@ERROR, @@SPID, @@VERSION, @@SERVERNAME, @@LANGUAGE, kept current before
// each statement), then an RPC's parameters, then what DECLARE adds; the
// k-th is $k to the executor. SELECT @v = expr and SET @v = expr assign
// (from the last row, as SQL Server does; none: unchanged).
//
// Transactions: BEGIN TRAN nests (@@TRANCOUNT); COMMIT ends the outermost;
// ROLLBACK ends them all, or goes back to a SAVE TRAN point. An error rolls
// back only its statement (each statement in a transaction runs under a
// savepoint), unless SET XACT_ABORT ON or the error dooms the transaction
// (serialization and deadlock), which roll it back and end the batch. SET
// IMPLICIT_TRANSACTIONS ON begins one at the first statement that reads or
// writes a table. Errors: the batch goes on after most; it ends after one
// that SQL Server finds compiling (an unknown table, column or function,
// an undeclared variable).
//
// SET LEXDB_DIALECT POSTGRES runs later batches in lexdb's own dialect, as
// over PostgreSQL's protocol (the first error ends a batch); SET
// LEXDB_DIALECT TSQL goes back.
import "strings"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_tsqlparse"
import "./lexdb_exec"
import "./lexdb_syscat"

type Val = lexdb_sql.Val
type DbErr = lexdb_base.DbErr
type TypeName = lexdb_sql.TypeName

pub const VERSION = "lexdb (SQL Server protocol, TDS 7.4; reports itself as Microsoft SQL Server 16.0.4315)"

// ---- events

pub const EV_ROWS = 1       // a result set: cols and rows
pub const EV_DONE = 2       // a statement's end: count (-1: none to report), cmd, error
pub const EV_ERROR = 3      // err
pub const EV_TRAN = 4       // tran: the transaction began (8), committed (9) or was rolled back (10)
pub const EV_INFO = 5       // a message (PRINT, RAISERROR under severity 11): err's text, number, sev and state
pub const EV_DB = 6         // USE: the session's database is err.msg (ENVCHANGE, and INFO 5701)

pub type Event = record {
    pub kind: int
    pub cols: []lexdb_exec.OutCol
    pub rows: [][]Val
    pub count: int
    pub cmd: int
    pub error: bool
    pub err: DbErr
    pub tran: int
    pub number: int         // EV_ERROR, EV_INFO: SQL Server's number, severity and state
    pub sev: int
    pub state: int
    // EV_ROWS of metadata only (SET FMTONLY ON, sp_prepare's): the columns as
    // SQL Server describes them, no rows (cols and rows empty)
    pub decl: []lexdb_exec.DeclCol
}

// An event to put in an emptied place (a DONE without a count).
pub fn doneEvent(): Event { return ev0(EV_DONE) }

fn ev0(kind: int): Event {
    return Event{kind: kind, cols: [], rows: [], count: -1, cmd: 0, error: false, err: lexdb_base.err("", ""), tran: 0, number: 0, sev: 0, state: 0,
                 decl: []}
}

// An error as SQL Server tells it: its number, text, severity and state
// (ERROR_NUMBER() and the rest in a CATCH block).
pub type Caught = record { pub number: int; pub message: str; pub severity: int; pub state: int }

fn caughtOf(e: &DbErr): Caught {
    let n = sqlNumber(&e.state)
    return Caught{number: n, message: sqlMessage(n, &e.msg), severity: sqlClass(n), state: 1}
}

// SQL Server's text for the errors programs look at, where lexdb's differs.
fn sqlMessage(n: int, msg: &str): str {
    if n == 8134 { return "Divide by zero error encountered." }
    return msg.toStr()
}

// DONE's CurCmd: the statement it ends
pub const CMD_SELECT = 0xC1
pub const CMD_INSERT = 0xC3
pub const CMD_DELETE = 0xC4
pub const CMD_UPDATE = 0xC5
pub const CMD_BULK = 0xF0       // a bulk load's rows (SQL Server's BULK INSERT)
pub const CMD_SETOPT = 0xFD     // what SQL Server's DONE gives INSERT BULK

fn cmdOf(kind: int): int {
    if kind == lexdb_sql.S_SELECT { return CMD_SELECT }
    if kind == lexdb_sql.S_INSERT { return CMD_INSERT }
    if kind == lexdb_sql.S_UPDATE { return CMD_UPDATE }
    if kind == lexdb_sql.S_DELETE { return CMD_DELETE }
    return 0
}

fn errorEv(ev: mut &[]Event, e: &DbErr) {
    var x = ev0(EV_ERROR)
    x.err = e
    let c = caughtOf(e)
    x.number = c.number
    x.sev = c.severity
    x.state = c.state
    append(ev, x)
}

fn caughtEv(ev: mut &[]Event, c: &Caught, kind: int) {
    var x = ev0(kind)
    x.err = lexdb_base.err("TS" + c.number.toStr(), c.message.toStr())
    x.number = c.number
    x.sev = c.severity
    x.state = c.state
    append(ev, x)
}

fn doneEv(ev: mut &[]Event, count: int, cmd: int, error: bool) {
    var x = ev0(EV_DONE)
    x.count = count
    x.cmd = cmd
    x.error = error
    append(ev, x)
}

// SQL Server's error number for a lexdb error: T-SQL's own errors carry
// theirs in the state ("TS208"); for the rest, the number SQL Server gives
// the same failure, where there is one, else 50000.
pub fn sqlNumber(state: &str): int {
    if strings.startsWith(&state, "TS") { return strings.parseIntOpt(&(state[2..len(state)].toStr())).unwrapOr(50000) }
    match state.toStr() {
        "42P01" { return 208 }      // Invalid object name
        "42703" { return 207 }      // Invalid column name
        "42601" { return 102 }      // Incorrect syntax near
        "42883" { return 195 }      // is not a recognized built-in function name
        "42P07" { return 2714 }     // There is already an object named
        "42710" { return 2714 }
        "42501" { return 229 }      // permission was denied
        "42P21" { return 468 }      // Cannot resolve the collation conflict
        "428C9" { return 544 }      // Cannot insert explicit value for identity column
        "23505" { return 2627 }     // Violation of PRIMARY KEY / UNIQUE KEY constraint
        "23502" { return 515 }      // Cannot insert the value NULL into column
        "23503" { return 547 }      // conflicted with the FOREIGN KEY constraint
        "23514" { return 547 }      // conflicted with the CHECK constraint
        "22012" { return 8134 }     // Divide by zero error encountered
        "22003" { return 8115 }     // Arithmetic overflow error
        "22001" { return 2628 }     // String or binary data would be truncated
        "22P02" { return 245 }      // Conversion failed
        "22007" { return 241 }      // Conversion failed when converting date and/or time
        "22008" { return 517 }      // Adding a value to a 'datetime' column caused an overflow
        "40001" { return 1205 }     // deadlock victim / serialization
        "40P01" { return 1205 }
        "25P02" { return 3930 }     // The current transaction cannot be committed
        "28000" { return 18456 }    // Login failed
        "28P01" { return 18456 }
        "57014" { return 3617 }     // cancelled
        else { return 50000 }
    }
}

// The severity SQL Server gives error n: 14 for a key's violation and a
// failed login, 15 for a syntax error, else 16.
pub fn sqlClass(n: int): int {
    if n == 2627 || n == 2601 || n == 18456 || n == 229 { return 14 }
    if n == 102 || n == 156 || n == 105 { return 15 }
    return 16
}

// An error SQL Server finds compiling the batch's statement: the batch ends.
fn endsBatch(e: &DbErr): bool {
    let n = sqlNumber(&e.state)
    return n == 208 || n == 207 || n == 102 || n == 195 || n == 137 || n == 134 || n == 2812 || n == 468
}

// An error after which the transaction cannot go on.
fn dooms(e: &DbErr): bool { return e.state == "40001" || e.state == "40P01" || e.state == "25P02" }

// ---- a connection's state, and a batch's variables

pub type State = record {
    pub nocount: bool
    pub xactAbort: bool
    pub implicitTx: bool
    pub quotedIdent: bool
    pub postgres: bool          // SET LEXDB_DIALECT POSTGRES
    pub trancount: int
    pub rowcount: int
    pub error: int
    pub spid: int
    saves: []str                // SAVE TRAN names, in order
    committed: bool             // the last transaction to end was committed
    // TRY ... CATCH (S4): TRY blocks in, the error that leaves one (jump),
    // the errors CATCH blocks handle (innermost last)
    tryDepth: int
    jump: bool
    pending: Caught
    caught: []Caught
    doomed: bool                // XACT_ABORT's error in a TRY block: the transaction can only be rolled back
    temps: []str                // the #temporary tables made (dropped when the connection ends or is reset)
    tableVars: []str            // the batch's table variables (#@name), dropped after it
    pub fmtOnly: bool           // SET FMTONLY ON: a SELECT's columns only, nothing else run
    pub bulk: []BulkReq         // an INSERT BULK accepted: its rows come next (lexdb_tds), one at most
}

// An INSERT BULK accepted (design/lexdb-tds.md, section 14): the table, the
// columns the rows give, KEEP_NULLS.
// bad: a column the table has not (SQL Server's DONE then says an error,
// with no message, and so does the load's).
pub type BulkReq = record { pub table: str; pub cols: []str; pub keepNulls: bool; pub bad: bool }

pub fn newState(spid: int): State {
    return State{nocount: false, xactAbort: false, implicitTx: false, quotedIdent: true, postgres: false, trancount: 0,
                 rowcount: 0, error: 0, spid: spid, saves: [], committed: false, tryDepth: 0, jump: false,
                 pending: Caught{number: 0, message: "", severity: 0, state: 0}, caught: [], doomed: false, temps: [], tableVars: [],
                 fmtOnly: false, bulk: []}
}

// An error: to the client, or (in a TRY block) to its CATCH block.
fn (st: mut &State) fail(ev: mut &[]Event, c: Caught, cmd: int) { st.failAs(ev, c, cmd, true) }

// fail; counted: a statement's (in a TRY block SQL Server ends it with a
// count of 0; RAISERROR and THROW with none).
fn (st: mut &State) failAs(ev: mut &[]Event, c: Caught, cmd: int, counted: bool) {
    st.error = c.number
    if st.tryDepth > 0 {
        if counted { doneEv(ev, if st.nocount { -1 } else { 0 }, cmd, false) }
        st.pending = c
        st.jump = true
        return
    }
    caughtEv(ev, &c, EV_ERROR)
    doneEv(ev, -1, cmd, true)
}

fn (st: mut &State) failErr(ev: mut &[]Event, e: &DbErr, cmd: int) { st.fail(ev, caughtOf(e), cmd) }

pub type Frame = record {
    pub names: []str
    pub types: []TypeName
    pub vals: []Val
}

const SYSVARS: []str = ["@@trancount", "@@rowcount", "@@error", "@@spid", "@@version", "@@servername", "@@language", "@@identity",
                         "@@error_number", "@@error_message", "@@error_severity", "@@error_state", "@@error_line", "@@error_procedure",
                         "@@xact_state"]

fn intType(oid: int): TypeName { return TypeName{kind: lexdb_sql.K_INT, oid: oid, prec: 0, scale: 0, len: 0} }
fn textType(): TypeName { return TypeName{kind: lexdb_sql.K_TEXT, oid: lexdb_sql.OID_TEXT, prec: 0, scale: 0, len: 0} }

// A frame with the system values only.
pub fn newFrame(): Frame {
    var f = Frame{names: [], types: [], vals: []}
    for n in SYSVARS {
        append(mut &f.names, n.toStr())
        append(mut &f.types, if n == "@@version" || n == "@@servername" || n == "@@language" || n == "@@error_message" || n == "@@error_procedure" { textType() }
                            else if n == "@@identity" { TypeName{kind: lexdb_sql.K_NUM, oid: lexdb_sql.OID_NUMERIC, prec: 38, scale: 0, len: 0} }
                            else { intType(lexdb_sql.OID_INT4) })
        append(mut &f.vals, Val.Null)
    }
    return f
}

// A variable added (an RPC's parameter): its index.
pub fn (f: mut &Frame) add(name: &str, t: TypeName, v: Val): int {
    append(mut &f.names, name.toStr())
    append(mut &f.types, t)
    append(mut &f.vals, v)
    return len(f.names) - 1
}

pub fn (f: &Frame) find(name: &str): int {
    for i in 0..len(f.names) { if f.names[i] == name { return i } }
    return -1
}

fn (st: &State) refresh(sess: &lexdb_exec.Session, f: mut &Frame) {
    f.vals[0] = Val.Int(st.trancount)
    f.vals[1] = Val.Int(st.rowcount)
    f.vals[2] = Val.Int(st.error)
    f.vals[3] = Val.Int(st.spid)
    f.vals[4] = Val.Text(VERSION)
    f.vals[5] = Val.Text("lexdb")
    f.vals[6] = Val.Text("us_english")
    f.vals[7] = match sess.lastIdentity() {
        Some(n) { Val.Num(Decimal.fromInt(n)) }
        None { Val.Null }
    }
    // ERROR_NUMBER() and the rest: the error the innermost CATCH block handles, NULL outside one
    let k = len(st.caught)
    if k > 0 {
        let c = &st.caught[k - 1]
        f.vals[8] = Val.Int(c.number)
        f.vals[9] = Val.Text(c.message)
        f.vals[10] = Val.Int(c.severity)
        f.vals[11] = Val.Int(c.state)
        f.vals[12] = Val.Int(1)
        f.vals[13] = Val.Null
    } else {
        for i in 8..14 { f.vals[i] = Val.Null }
    }
    f.vals[14] = Val.Int(if sess.status() == 'I' { 0 } else if st.doomed { -1 } else { 1 })
}

fn (f: &Frame) oids(): []int {
    var o: []int = []
    for t in f.types { append(mut &o, t.oid) }
    return o
}

// ---- running

// The row count in a command tag ("INSERT 0 3", "UPDATE 2", "SELECT 5"), -1 none.
fn tagCount(tag: &str): int {
    let sp = strings.lastIndexOf(&tag, " ")
    if sp < 0 { return -1 }
    let w = tag[0..strings.indexOf(&tag, " ", 0)].toStr()
    if w != "INSERT" && w != "UPDATE" && w != "DELETE" && w != "SELECT" && w != "MERGE" && w != "COPY" && w != "FETCH" && w != "MOVE" {
        return -1
    }
    return strings.parseIntOpt(&(tag[sp + 1..len(tag)].toStr())).unwrapOr(-1)
}

// A statement of lexdb's own, without parameters.
fn simple(sess: mut &lexdb_exec.Session, sql: &str): Result[lexdb_exec.Res, DbErr] {
    let stmts = try lexdb_sql.parse(sql)
    let none: []Val = []
    let nt: []int = []
    return sess.run(&stmts[0], &none, &nt)
}

const SAVE = "\"lexdb tsql statement\""

fn txStmt(kind: int): bool {
    return kind == lexdb_sql.S_BEGIN || kind == lexdb_sql.S_COMMIT || kind == lexdb_sql.S_ROLLBACK ||
           kind == lexdb_sql.S_SAVEPOINT || kind == lexdb_sql.S_RELEASE || kind == lexdb_sql.S_ROLLBACK_TO
}

// Whether SET IMPLICIT_TRANSACTIONS ON begins a transaction for s: one that
// reads or writes a table.
fn startsTx(s: &lexdb_sql.Stmt): bool {
    if txStmt(s.kind) || s.kind == lexdb_sql.S_SET || s.kind == lexdb_sql.S_SHOW { return false }
    if s.kind == lexdb_sql.S_SELECT { return len(s.from) > 0 }
    return true
}

fn noPull(): lexdb_exec.CopyPart { return lexdb_exec.CopyPart{rows: [], data: "", end: true, fail: "", proto: false} }

// Runs one statement of lexdb's parser; false when the batch ends.
fn (st: mut &State) sqlStmt(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, f: mut &Frame, ev: mut &[]Event, quiet: bool): bool {
    if st.fmtOnly && !txStmt(s.kind) { return st.fmtStmt(sess, s, ev) }
    return st.sqlStmtWith(sess, s, f, ev, quiet, noPull)
}

// SET FMTONLY ON: a SELECT gives its columns as SQL Server describes them,
// and no rows; nothing is run.
fn (st: mut &State) fmtStmt(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, ev: mut &[]Event): bool {
    if s.kind != lexdb_sql.S_SELECT || len(s.assign) > 0 {
        doneEv(ev, -1, cmdOf(s.kind), false)
        return true
    }
    match sess.describeDecl(s) {
        Ok(cols) {
            var x = ev0(EV_ROWS)
            x.decl = cols
            append(ev, x)
            doneEv(ev, if st.nocount { -1 } else { 0 }, CMD_SELECT, false)
            return true
        }
        Err(e) {
            st.failErr(ev, &e, CMD_SELECT)
            return st.tryDepth > 0 || !endsBatch(&e)
        }
    }
}

// sqlStmt; a bulk load's (s a COPY of copy.bulk) rows from pull.
fn (st: mut &State) sqlStmtWith(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, f: mut &Frame, ev: mut &[]Event, quiet: bool,
                                pull: &fn(): lexdb_exec.CopyPart): bool {
    let bulk = s.kind == lexdb_sql.S_COPY && s.copy.bulk
    if st.implicitTx && sess.status() == 'I' && startsTx(s) {
        match simple(sess, &"BEGIN") {
            Ok(_) {}
            Err(e) {
                st.failErr(ev, &e, 0)
                return false
            }
        }
    }
    let inTx = sess.status() != 'I' && !txStmt(s.kind)
    if inTx {
        let sp = simple(sess, &("SAVEPOINT " + SAVE))
    }
    let cmd = if bulk { CMD_BULK } else { cmdOf(s.kind) }
    // as SQL Server: an INSERT, UPDATE or DELETE runs in a transaction of
    // its own, nested, so @@TRANCOUNT inside it is one more
    if s.kind == lexdb_sql.S_INSERT || s.kind == lexdb_sql.S_UPDATE || s.kind == lexdb_sql.S_DELETE {
        f.vals[0] = Val.Int(max(st.trancount, if sess.status() == 'I' { 0 } else { 1 }) + 1)
    }
    let oids = f.oids()
    let r = if bulk { sess.copyInFrom(s, pull) } else { sess.run(s, &f.vals, &oids) }
    if r.isErr() {
        let e = r.unwrapErr()
        if bulk && st.tryDepth == 0 {
            // as SQL Server ends a bulk load: the error, then 3621
            st.error = sqlNumber(&e.state)
            errorEv(ev, &e)
            caughtEv(ev, &Caught{number: 3621, message: "The statement has been terminated.", severity: 0, state: 0}, EV_INFO)
            doneEv(ev, -1, cmd, true)
        } else {
            st.failErr(ev, &e, cmd)
        }
        st.rowcount = 0
        if inTx {
            if (st.xactAbort || dooms(&e)) && st.tryDepth == 0 {
                let rb = simple(sess, &"ROLLBACK")
                return false
            }
            let back = simple(sess, &("ROLLBACK TO SAVEPOINT " + SAVE))
            let rel = simple(sess, &("RELEASE SAVEPOINT " + SAVE))
            // in a TRY block: the transaction left open, to be rolled back (XACT_STATE() -1)
            if st.xactAbort || dooms(&e) { st.doomed = true }
        } else if st.xactAbort && st.tryDepth == 0 {
            return false
        }
        return st.tryDepth > 0 || !endsBatch(&e)
    }
    var res = r.unwrap()
    if inTx {
        let rel = simple(sess, &("RELEASE SAVEPOINT " + SAVE))
    }
    st.error = 0
    if len(s.assign) > 0 {
        // SELECT @v = ...: the last row's values, each to its variable's type
        let n = len(res.rows)
        if n > 0 {
            for i in 0..len(s.assign) {
                let k = f.find(&s.assign[i])
                if k < 0 || i >= len(res.rows[n - 1]) { continue }
                match lexdb_exec.coerce(res.rows[n - 1][i], &f.types[k]) {
                    Ok(v) { f.vals[k] = v }
                    Err(e) {
                        st.failErr(ev, &e, cmd)
                        return true
                    }
                }
            }
        }
        st.rowcount = n
        if !quiet { doneEv(ev, if st.nocount { -1 } else { n }, cmd, false) }
        return true
    }
    let n = tagCount(&res.tag)
    st.rowcount = max(n, 0)
    if res.hasRows {
        var x = ev0(EV_ROWS)
        x.cols = replace(mut &res.cols, [])
        x.rows = replace(mut &res.rows, [])
        append(ev, x)
    }
    if res.tag == "COMMIT" { st.committed = true }
    if res.tag == "ROLLBACK" && !txStmt(s.kind) { st.committed = false }
    doneEv(ev, if st.nocount && !bulk { -1 } else { n }, cmd, false)
    // a #temporary table made: dropped with the connection
    if s.kind == lexdb_sql.S_CREATE && strings.startsWith(&s.table, "#") && !strings.startsWith(&s.table, "#@") { append(mut &st.temps, s.table) }
    return true
}

// A statement of lexdb's own (BEGIN, COMMIT, ...) for transaction control:
// an error as an event; false when there was one.
fn (st: mut &State) control(sess: mut &lexdb_exec.Session, sql: &str, ev: mut &[]Event): bool {
    match simple(sess, sql) {
        Ok(r) {
            if r.tag == "COMMIT" { st.committed = true }
            if r.tag == "ROLLBACK" && sql == "ROLLBACK" { st.committed = false }
            return true
        }
        Err(e) {
            st.failErr(ev, &e, 0)
            return false
        }
    }
}

fn tsErr(n: int, msg: str): DbErr { return lexdb_base.err("TS" + n.toStr(), msg) }

// One statement of the batch; false when the batch ends.
fn (st: mut &State) exec(sess: mut &lexdb_exec.Session, t: &lexdb_tsqlparse.TStmt, f: mut &Frame, ev: mut &[]Event): bool {
    if t.kind == lexdb_tsqlparse.TS_SQL { return st.sqlStmt(sess, &t.stmt[0], f, ev, false) }
    if t.kind == lexdb_tsqlparse.TS_INSERTBULK {
        // the table must be there (208); its columns are looked at when the rows come
        match sess.tableDecl(&t.names[0]) {
            Ok(decl) {
                var cols: []str = []
                var bad = false
                for i in 1..len(t.names) {
                    append(mut &cols, t.names[i])
                    var k = -1
                    for j in 0..len(decl) { if strings.toLowerAscii(&decl[j].name) == t.names[i] { k = j } }
                    if k < 0 { bad = true }
                }
                st.bulk = [BulkReq{table: t.names[0], cols: cols, keepNulls: strings.contains(&t.value, "keep_nulls"), bad: bad}]
                doneEv(ev, -1, CMD_SETOPT, bad)
                return true
            }
            Err(e) {
                // (SQL Server says 208 twice)
                if sqlNumber(&e.state) == 208 { errorEv(ev, &e) }
                st.failErr(ev, &e, 0)
                return false
            }
        }
    }
    if t.kind == lexdb_tsqlparse.TS_DECLARE {
        // DECLARE @a = x, @b = y counts one row, as SQL Server
        for i in 0..len(t.stmt) {
            if !st.sqlStmt(sess, &t.stmt[i], f, ev, i + 1 < len(t.stmt)) { return false }
        }
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_SETOPT {
        let on = t.value == "on"
        for n in t.names {
            if n == "nocount" { st.nocount = on }
            else if n == "xact_abort" { st.xactAbort = on }
            else if n == "implicit_transactions" { st.implicitTx = on }
            else if n == "quoted_identifier" { st.quotedIdent = on }
            else if n == "fmtonly" { st.fmtOnly = on }
            else if n == "identity_insert" {
                sess.setIdentityInsert(&(if on { t.names[1] } else { "" }))
                break
            }
            else if n == "lexdb_dialect" {
                if t.value != "postgres" && t.value != "tsql" {
                    errorEv(ev, &lexdb_base.err("22023", "SET LEXDB_DIALECT takes POSTGRES or TSQL"))
                    doneEv(ev, -1, 0, true)
                    return true
                }
                st.postgres = t.value == "postgres"
            }
        }
        doneEv(ev, -1, 0, false)
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_BEGIN {
        if sess.status() == 'I' {
            if !st.control(sess, &"BEGIN", ev) { return true }
            st.trancount = 0
        }
        st.trancount += 1
        doneEv(ev, -1, 0, false)
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_COMMIT {
        if st.trancount == 0 {
            st.failErr(ev, &tsErr(3902, "The COMMIT TRANSACTION request has no corresponding BEGIN TRANSACTION."), 0)
            return true
        }
        st.trancount -= 1
        if st.trancount == 0 {
            if !st.control(sess, &"COMMIT", ev) { return true }
        }
        doneEv(ev, -1, 0, false)
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_ROLLBACK {
        var known = false
        if len(t.names) > 0 {
            for sv in st.saves { if sv == t.names[0] { known = true } }
        }
        if known {
            if !st.control(sess, &("ROLLBACK TO SAVEPOINT " + quoteName(&t.names[0])), ev) { return true }
            doneEv(ev, -1, 0, false)
            return true
        }
        if st.trancount == 0 && sess.status() == 'I' {
            st.failErr(ev, &tsErr(3903, "The ROLLBACK TRANSACTION request has no corresponding BEGIN TRANSACTION."), 0)
            return true
        }
        let ok = st.control(sess, &"ROLLBACK", ev)
        st.trancount = 0
        st.saves = []
        if ok { doneEv(ev, -1, 0, false) }
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_SAVE {
        if sess.status() == 'I' {
            errorEv(ev, &tsErr(628, "Cannot issue SAVE TRANSACTION when there is no active transaction."))
            doneEv(ev, -1, 0, true)
            st.error = 628
            return true
        }
        if st.control(sess, &("SAVEPOINT " + quoteName(&t.names[0])), ev) {
            append(mut &st.saves, t.names[0])
            doneEv(ev, -1, 0, false)
        }
        return true
    }
    return true
}

fn quoteName(n: &str): str { return "\"" + strings.replaceAll(&n, "\"", "\"\"") + "\"" }

// After a statement: @@TRANCOUNT kept with the session's transaction, and
// its start or end as an event.
fn (st: mut &State) after(sess: &lexdb_exec.Session, before: byte, ev: mut &[]Event) {
    let now = sess.status()
    if now == 'I' {
        st.trancount = 0
        st.saves = []
        st.doomed = false
    } else if st.trancount == 0 {
        st.trancount = 1
    }
    if before == 'I' && now != 'I' {
        var x = ev0(EV_TRAN)
        x.tran = 8
        append(ev, x)
    } else if before != 'I' && now == 'I' {
        var x = ev0(EV_TRAN)
        x.tran = if st.committed { 9 } else { 10 }
        append(ev, x)
    }
}

// Runs a batch: its events onto ev. f: its variables to start with
// (newFrame's, and an RPC's parameters), and after it the values they have.
pub fn run(sess: mut &lexdb_exec.Session, st: mut &State, sql: &str, f: mut &Frame, ev: mut &[]Event) {
    st.refresh(sess, f)
    if st.postgres {
        st.runPg(sess, sql, ev)
        return
    }
    let parsed = lexdb_tsqlparse.parseBatch(sql, lexdb_sql.Dialect{tsql: true, quotedIdent: st.quotedIdent}, &f.names)
    if parsed.isErr() {
        let e = parsed.unwrapErr()
        errorEv(ev, &e)
        doneEv(ev, -1, 0, true)
        st.error = sqlNumber(&e.state)
        return
    }
    let b = parsed.unwrap()
    let given = len(f.names)
    for k in given..len(b.vars) {
        let i = f.add(&b.vars[k], b.types[k - given], Val.Null)
    }
    if len(b.stmts) == 0 {
        doneEv(ev, -1, 0, false)
        return
    }
    if len(b.stmts) > 1 {
        for t in b.stmts {
            if t.kind == lexdb_tsqlparse.TS_INSERTBULK {
                st.fail(ev, Caught{number: 428, message: "Insert bulk cannot be used in a multi-statement batch.", severity: 16, state: 1}, 0)
                return
            }
        }
    }
    let r = st.block(sess, &b.stmts, f, ev)
    if r == F_END {
        // SET FMTONLY takes effect as the batch is compiled, as in SQL Server:
        // a batch ended by an error (SqlBulkCopy's for a table that is not
        // there) still leaves FMTONLY as its last SET FMTONLY says
        for t in b.stmts {
            if t.kind == lexdb_tsqlparse.TS_SETOPT {
                for n in t.names { if n == "fmtonly" { st.fmtOnly = t.value == "on" } }
            }
        }
    }
    // the batch's table variables go with it
    while len(st.tableVars) > 0 {
        let tv = pop(mut &st.tableVars)
        let d = simple(sess, &("DROP TABLE IF EXISTS " + quoteName(&tv)))
    }
}

// The #temporary tables a connection made, dropped (it ends, or is reset).
pub fn dropTemps(sess: mut &lexdb_exec.Session, st: mut &State) {
    if sess.status() != 'I' { let rb = simple(sess, &"ROLLBACK") }
    while len(st.temps) > 0 {
        let t = pop(mut &st.temps)
        let d = simple(sess, &("DROP TABLE IF EXISTS " + quoteName(&t)))
    }
}

// How a block's statements ended: the next goes on; BREAK, CONTINUE,
// RETURN; the batch ended (an error that ends it); an error left a TRY block.
const F_NEXT = 0
const F_BREAK = 1
const F_CONTINUE = 2
const F_RETURN = 3
const F_END = 4
const F_ERROR = 5

fn (st: mut &State) block(sess: mut &lexdb_exec.Session, ts: &[]lexdb_tsqlparse.TStmt, f: mut &Frame, ev: mut &[]Event): int {
    for t in ts {
        let r = st.one(sess, &t, f, ev)
        if r != F_NEXT { return r }
    }
    return F_NEXT
}

// IF's and WHILE's condition: 1 true, 0 not, -1 an error (its flow in fl).
fn (st: mut &State) cond(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, f: mut &Frame, ev: mut &[]Event): int {
    let oids = f.oids()
    match sess.run(s, &f.vals, &oids) {
        Ok(r) {
            if len(r.rows) > 0 && len(r.rows[0]) > 0 {
                match r.rows[0][0] {
                    Val.Int(n) { return if n == 1 { 1 } else { 0 } }
                    else {}
                }
            }
            return 0
        }
        Err(e) {
            st.failErr(ev, &e, 0)
            return -1
        }
    }
}

// The values of PRINT's, RAISERROR's and THROW's arguments; None after an error.
fn (st: mut &State) args(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, f: mut &Frame, ev: mut &[]Event): Option[[]Val] {
    let oids = f.oids()
    match sess.run(s, &f.vals, &oids) {
        Ok(r0) {
            var r = r0
            if len(r.rows) > 0 { return Some(replace(mut &r.rows[0], [])) }
            return Some([])
        }
        Err(e) {
            st.failErr(ev, &e, 0)
            return None
        }
    }
}

fn intVal(v: &Val): int {
    match v {
        Val.Int(n) { return n }
        Val.Num(d) { return d.toInt(Rounding.TOWARD_ZERO).unwrapOr(0) }
        Val.Text(t) { return strings.parseIntOpt(&(strings.trim(&t))).unwrapOr(0) }
        else { return 0 }
    }
}

// RAISERROR's message: %d %i %u %s %x %X %o with the arguments, in order
// (a width or flags between are read, not used); %% a %.
fn raiseText(fmt: &str, args: &[]Val): str {
    var out = newStrBuf()
    var k = 0
    var i = 0
    while i < len(fmt) {
        let c = fmt[i]
        if c != '%' || i + 1 >= len(fmt) {
            out.addByte(c)
            i += 1
            continue
        }
        var j = i + 1
        if fmt[j] == '%' {
            out.addByte('%')
            i = j + 1
            continue
        }
        while j < len(fmt) && (fmt[j] == '-' || fmt[j] == '+' || fmt[j] == ' ' || fmt[j] == '#' || fmt[j] == '0' || (fmt[j] >= '1' && fmt[j] <= '9') || fmt[j] == '.' || fmt[j] == 'l' || fmt[j] == 'h' || fmt[j] == 'I') { j += 1 }
        if j >= len(fmt) { break }
        let t = fmt[j]
        if k < len(args) {
            let v = args[k]
            if t == 'x' || t == 'X' {
                let h = strings.hex(intVal(&v))
                let hs: str = if t == 'X' { strings.toUpperAscii(&h) } else { h }
                out.add(&hs)
            } else if t == 'd' || t == 'i' || t == 'u' {
                out.add(&(intVal(&v).toStr()))
            } else {
                let tv: str = if lexdb_exec.isNull(&v) { "(null)" } else { lexdb_exec.text(&v) }
                out.add(&tv)
            }
        } else {
            out.add("(null)")
        }
        k += 1
        i = j + 1
    }
    return out.toStr()
}

// One statement of a batch or block, and how it ended.
fn (st: mut &State) one(sess: mut &lexdb_exec.Session, t: &lexdb_tsqlparse.TStmt, f: mut &Frame, ev: mut &[]Event): int {
    st.refresh(sess, f)
    let k = t.kind
    if k == lexdb_tsqlparse.TS_BLOCK { return st.block(sess, &t.body, f, ev) }
    if k == lexdb_tsqlparse.TS_IF {
        let c = st.cond(sess, &t.stmt[0], f, ev)
        if c < 0 { return st.flowAfterError() }
        return st.block(sess, if c == 1 { &t.body } else { &t.els }, f, ev)
    }
    if k == lexdb_tsqlparse.TS_WHILE {
        while true {
            st.refresh(sess, f)
            let c = st.cond(sess, &t.stmt[0], f, ev)
            if c < 0 { return st.flowAfterError() }
            if c == 0 { break }
            let r = st.block(sess, &t.body, f, ev)
            if r == F_BREAK { break }
            if r != F_NEXT && r != F_CONTINUE { return r }
        }
        return F_NEXT
    }
    if k == lexdb_tsqlparse.TS_BREAK { return F_BREAK }
    if k == lexdb_tsqlparse.TS_CONTINUE { return F_CONTINUE }
    if k == lexdb_tsqlparse.TS_RETURN { return F_RETURN }
    if k == lexdb_tsqlparse.TS_TRY {
        st.tryDepth += 1
        let r = st.block(sess, &t.body, f, ev)
        st.tryDepth -= 1
        if r != F_ERROR { return r }
        // the CATCH block, with the error it handles
        let pc = Caught{number: st.pending.number, message: st.pending.message, severity: st.pending.severity, state: st.pending.state}
        append(mut &st.caught, pc)
        let r2 = st.block(sess, &t.els, f, ev)
        let x = pop(mut &st.caught)
        return r2
    }
    if k == lexdb_tsqlparse.TS_PRINT {
        match st.args(sess, &t.stmt[0], f, ev) {
            Some(vs) {
                let msg = if len(vs) == 0 || lexdb_exec.isNull(&vs[0]) { "" } else { lexdb_exec.text(&vs[0]) }
                caughtEv(ev, &Caught{number: 0, message: msg, severity: 0, state: 1}, EV_INFO)
                return F_NEXT
            }
            None { return st.flowAfterError() }
        }
    }
    if k == lexdb_tsqlparse.TS_RAISERROR {
        match st.args(sess, &t.stmt[0], f, ev) {
            Some(vs) {
                var rest: []Val = []
                for i in 3..len(vs) { append(mut &rest, vs[i]) }
                let msg = raiseText(&(if lexdb_exec.isNull(&vs[0]) { "" } else { lexdb_exec.text(&vs[0]) }), &rest)
                let sev = intVal(&vs[1])
                let c = Caught{number: 50000, message: msg, severity: sev, state: intVal(&vs[2])}
                if sev <= 10 {
                    caughtEv(ev, &c, EV_INFO)
                    return F_NEXT
                }
                st.failAs(ev, c, 0, false)
                return st.flowAfterError()
            }
            None { return st.flowAfterError() }
        }
    }
    if k == lexdb_tsqlparse.TS_THROW {
        var c = Caught{number: 0, message: "", severity: 16, state: 1}
        if len(t.stmt) == 0 {
            // THROW in a CATCH block: the error it handles, again
            if len(st.caught) == 0 {
                st.fail(ev, Caught{number: 10704, message: "To rethrow an error, a THROW statement must be used inside a CATCH block. Insert the THROW statement inside a CATCH block, or add error parameters to the THROW statement.", severity: 15, state: 1}, 0)
                return st.flowAfterError()
            }
            let top = &st.caught[len(st.caught) - 1]
            c = Caught{number: top.number, message: top.message, severity: top.severity, state: top.state}
        } else {
            match st.args(sess, &t.stmt[0], f, ev) {
                Some(vs) {
                    c.number = intVal(&vs[0])
                    c.message = if lexdb_exec.isNull(&vs[1]) { "" } else { lexdb_exec.text(&vs[1]) }
                    c.state = intVal(&vs[2])
                }
                None { return st.flowAfterError() }
            }
        }
        st.failAs(ev, c, 0, false)
        // THROW ends the batch (and, with XACT_ABORT, the transaction)
        if st.jump { return F_ERROR }
        if st.xactAbort && sess.status() != 'I' { let rb = simple(sess, &"ROLLBACK") }
        return F_END
    }
    if k == lexdb_tsqlparse.TS_USE || k == lexdb_tsqlparse.TS_EXECSTR || k == lexdb_tsqlparse.TS_EXEC || k == lexdb_tsqlparse.TS_INSERTEXEC {
        let before = sess.status()
        let r = st.call(sess, t, f, ev)
        st.after(sess, before, ev)
        if st.jump {
            st.jump = false
            return F_ERROR
        }
        return r
    }
    if k == lexdb_tsqlparse.TS_TABLEVAR {
        let go = st.sqlStmt(sess, &t.stmt[0], f, ev, true)
        if go && !st.jump { append(mut &st.tableVars, "#" + t.names[0]) }
        // (CREATE TABLE's DONE: a DECLARE reports none)
        if len(ev) > 0 && ev[len(ev) - 1].kind == EV_DONE && !ev[len(ev) - 1].error { let x = pop(ev) }
        if st.jump {
            st.jump = false
            return F_ERROR
        }
        return if go { F_NEXT } else { F_END }
    }
    st.committed = false
    let before = sess.status()
    let go = st.exec(sess, t, f, ev)
    st.after(sess, before, ev)
    if st.jump {
        st.jump = false
        return F_ERROR
    }
    return if go { F_NEXT } else { F_END }
}

// ---- USE and EXEC (design/lexdb-tds.md, section 13)

// USE, EXEC (string), EXEC procedure, INSERT ... EXEC, and how they ended.
fn (st: mut &State) call(sess: mut &lexdb_exec.Session, t: &lexdb_tsqlparse.TStmt, f: mut &Frame, ev: mut &[]Event): int {
    let k = t.kind
    if k == lexdb_tsqlparse.TS_USE {
        // lexdb's database (and master, taken as it, as at login); SQL
        // Server's other system databases are listed, not opened
        let n = t.names[0]
        let id = lexdb_syscat.dbId(&n, &lexdb_exec.SYS_DB_NAME)
        if id == lexdb_exec.SYS_DB_ID || id == 1 {
            var x = ev0(EV_DB)
            x.err = lexdb_base.err("", lexdb_exec.SYS_DB_NAME)
            append(ev, x)
            doneEv(ev, -1, 0, false)
            return F_NEXT
        }
        if id > 0 {
            st.fail(ev, Caught{number: 916, message: "The server principal \"" + sess.user() + "\" is not able to access the database \"" + n +
                                                     "\" under the current security context.", severity: 14, state: 1}, 0)
        } else {
            st.fail(ev, Caught{number: 911, message: "Database '" + n + "' does not exist. Make sure that the name is entered correctly.", severity: 16,
                               state: 1}, 0)
        }
        return F_NEXT
    }
    if k == lexdb_tsqlparse.TS_INSERTEXEC {
        // the procedure's rows, inserted
        var inner: []Event = []
        let r = st.call(sess, &t.body[0], f, mut &inner)
        var rows: []str = []
        for i in 0..len(inner) {
            if inner[i].kind == EV_ROWS {
                for row in inner[i].rows {
                    var vs: []str = []
                    for v in row { append(mut &vs, litOf(&v)) }
                    append(mut &rows, "(" + strings.join(&vs, ", ") + ")")
                }
            } else if inner[i].kind == EV_ERROR || inner[i].kind == EV_INFO {
                append(ev, replace(mut &inner[i], ev0(EV_DONE)))
            }
        }
        if len(rows) == 0 {
            doneEv(ev, if st.nocount { -1 } else { 0 }, CMD_INSERT, false)
            return r
        }
        var cols: []str = []
        for i in 1..len(t.names) { append(mut &cols, "[" + t.names[i] + "]") }
        let tn = t.names[0]
        let target = if strings.startsWith(&tn, "#") { tn.toStr() } else { "[" + tn + "]" }
        let sql = "INSERT INTO " + target + (if len(cols) > 0 { " (" + strings.join(&cols, ", ") + ")" } else { "" }) + " VALUES " + strings.join(&rows, ", ")
        var fr = newFrame()
        return st.nested(sess, &sql, mut &fr, ev)
    }
    // the arguments' values
    var vals: []Val = []
    if len(t.stmt) > 0 && len(t.stmt[0].items) > 0 {
        let oids = f.oids()
        match sess.run(&t.stmt[0], &f.vals, &oids) {
            Ok(r0) {
                var r = r0
                if len(r.rows) > 0 { vals = replace(mut &r.rows[0], []) }
            }
            Err(e) {
                st.failErr(ev, &e, 0)
                return if endsBatch(&e) && st.tryDepth == 0 { F_END } else { F_NEXT }
            }
        }
    }
    if k == lexdb_tsqlparse.TS_EXECSTR {
        // dynamic SQL: a batch of its own, without the caller's variables
        let sql = if len(vals) > 0 && !lexdb_exec.isNull(&vals[0]) { lexdb_exec.text(&vals[0]) } else { "" }
        var fr = newFrame()
        return st.nested(sess, &sql, mut &fr, ev)
    }
    let proc = t.names[0]
    let outs = strings.split(&t.value, "\x1f")
    if proc == "sp_executesql" {
        if len(vals) == 0 || lexdb_exec.isNull(&vals[0]) {
            st.fail(ev, Caught{number: 201, message: "Procedure or function 'sp_executesql' expects parameter '@statement', which was not supplied.",
                               severity: 16, state: 4}, 0)
            return F_NEXT
        }
        var decls: []lexdb_tsqlparse.ParamDecl = []
        if len(vals) > 1 && !lexdb_exec.isNull(&vals[1]) {
            match lexdb_tsqlparse.parseParamDecls(&lexdb_exec.text(&vals[1])) {
                Ok(ds) { decls = ds }
                Err(e) {
                    st.failErr(ev, &e, 0)
                    return F_NEXT
                }
            }
        }
        var fr = newFrame()
        st.refresh(sess, mut &fr)
        for i in 0..len(decls) {
            var v = Val.Null
            for j in 2..len(vals) {
                let pn = if 1 + j < len(t.names) { t.names[1 + j] } else { "" }
                if pn == decls[i].name || (pn == "" && j - 2 == i) { v = vals[j] }
            }
            match lexdb_exec.coerce(v, &decls[i].typ) {
                Ok(cv) { let x = fr.add(&decls[i].name, decls[i].typ, cv) }
                Err(e) {
                    st.failErr(ev, &e, 0)
                    return F_NEXT
                }
            }
        }
        let r = st.nested(sess, &lexdb_exec.text(&vals[0]), mut &fr, ev)
        // OUTPUT parameters back to the caller's variables
        for j in 2..len(vals) {
            if j >= len(outs) || len(outs[j]) == 0 { continue }
            let pn = if 1 + j < len(t.names) && len(t.names[1 + j]) > 0 { t.names[1 + j] } else if j - 2 < len(decls) { decls[j - 2].name } else { "" }
            let kf = fr.find(&pn)
            let ko = f.find(&outs[j])
            if kf < 0 || ko < 0 { continue }
            match lexdb_exec.coerce(fr.vals[kf], &f.types[ko]) {
                Ok(cv) { f.vals[ko] = cv }
                Err(_) {}
            }
        }
        return r
    }
    if proc == "xp_instance_regread" || proc == "xp_regread" {
        // lexdb has no registry: an OUTPUT argument is NULL
        for j in 0..len(outs) {
            if len(outs[j]) == 0 { continue }
            let ko = f.find(&outs[j])
            if ko >= 0 { f.vals[ko] = Val.Null }
        }
        doneEv(ev, -1, 0, false)
        return F_NEXT
    }
    if proc == "sp_tablecollations_100" || proc == "sp_tablecollations_90" || proc == "sp_tablecollations" {
        // a table's columns' collations (SqlBulkCopy's): none for no such table
        var x = tableCollations(&[])
        if len(vals) > 0 && !lexdb_exec.isNull(&vals[0]) {
            match tableArg(&lexdb_exec.text(&vals[0])) {
                Ok(name) {
                    match sess.tableDecl(&name) {
                        Ok(cols) { x = tableCollations(&cols) }
                        Err(_) {}
                    }
                }
                Err(_) {}
            }
        }
        let n = len(x.rows)
        append(ev, x)
        doneEv(ev, if st.nocount { -1 } else { n }, CMD_SELECT, false)
        return F_NEXT
    }
    if proc == "sp_describe_first_result_set" {
        let sql = if len(vals) > 0 && !lexdb_exec.isNull(&vals[0]) { lexdb_exec.text(&vals[0]) } else { "" }
        let none: []lexdb_tsqlparse.ParamDecl = []
        match describeFirst(sess, st, &sql, &none) {
            Ok(cols) {
                let x = describeRows(&cols)
                let n = len(x.rows)
                append(ev, x)
                doneEv(ev, if st.nocount { -1 } else { n }, CMD_SELECT, false)
            }
            Err(e) { st.failErr(ev, &e, 0) }
        }
        return F_NEXT
    }
    if proc == "xp_msver" {
        var x = ev0(EV_ROWS)
        x.cols = [outCol(&"Index", lexdb_sql.OID_INT4), outCol(&"Name", lexdb_sql.OID_TEXT), outCol(&"Internal_Value", lexdb_sql.OID_INT4),
                  outCol(&"Character_Value", lexdb_sql.OID_TEXT)]
        for i in 0..len(MSVER) {
            let p = strings.split(&MSVER[i], "|")
            append(mut &x.rows, [Val.Int(i + 1), Val.Text(p[0].toStr()), if len(p[1]) == 0 { Val.Null } else { Val.Int(strings.parseIntOpt(&p[1]).unwrapOr(0)) },
                                 if len(p[2]) == 0 { Val.Null } else { Val.Text(p[2].toStr()) }])
        }
        let n = len(x.rows)
        append(ev, x)
        doneEv(ev, if st.nocount { -1 } else { n }, CMD_SELECT, false)
        return F_NEXT
    }
    st.fail(ev, Caught{number: 2812, message: "Could not find stored procedure '" + proc + "'.", severity: 16, state: 62}, 0)
    return if st.tryDepth > 0 { F_NEXT } else { F_END }
}

// xp_msver's rows, as SQL Server 2022's: name|internal value|character value.
const MSVER: []str = ["ProductName||Microsoft SQL Server", "ProductVersion|1048576|16.0.4315.2", "Language||English", "Platform||NT x64",
                      "Comments||SQL", "CompanyName||Microsoft Corporation", "FileDescription||SQL Server Windows NT - 64 Bit",
                      "FileVersion||2022.0160.4315.02 ((sql2022_rtm_qfe-cu27-gdr2).261021-1910)", "InternalName||SQLSERVR",
                      "LegalCopyright||Microsoft. All rights reserved.",
                      "LegalTrademarks||Microsoft SQL Server is a registered trademark of Microsoft Corporation.",
                      "OriginalFilename||SQLSERVR.EXE", "PrivateBuild||", "SpecialBuild|282787842|", "WindowsVersion|282787842|6.2 (9200)",
                      "ProcessorCount|16|16", "ProcessorActiveMask||            ffff", "ProcessorType|8664|",
                      "PhysicalMemory|38361|38361 (40224423936)", "Product ID||"]

fn outCol(name: &str, oid: int): lexdb_exec.OutCol {
    return lexdb_exec.OutCol{name: strings.toLowerAscii(&name), oid: oid, spell: name.toStr(), coll: "", scale: -1}
}

// A value as a T-SQL literal.
fn litOf(v: &Val): str {
    if lexdb_exec.isNull(v) { return "NULL" }
    match v {
        Val.Int(n) { return n.toStr() }
        Val.Num(d) { return d.toStr() }
        Val.Bool(b) { return if b { "1" } else { "0" } }
        else { return "N'" + strings.replaceAll(&lexdb_exec.text(v), "'", "''") + "'" }
    }
}

// A batch run inside this one (EXEC (string), sp_executesql), with its own
// variables fr; its errors end it, not the batch that ran it.
fn (st: mut &State) nested(sess: mut &lexdb_exec.Session, sql: &str, fr: mut &Frame, ev: mut &[]Event): int {
    let parsed = lexdb_tsqlparse.parseBatch(sql, lexdb_sql.Dialect{tsql: true, quotedIdent: st.quotedIdent}, &fr.names)
    if parsed.isErr() {
        let e = parsed.unwrapErr()
        st.failErr(ev, &e, 0)
        return F_NEXT
    }
    let b = parsed.unwrap()
    let given = len(fr.names)
    for k in given..len(b.vars) { let i = fr.add(&b.vars[k], b.types[k - given], Val.Null) }
    let r = st.block(sess, &b.stmts, fr, ev)
    return if r == F_ERROR { F_ERROR } else { F_NEXT }
}

// After an error in a condition or an argument: to the CATCH block, else on.
fn (st: mut &State) flowAfterError(): int {
    if st.jump {
        st.jump = false
        return F_ERROR
    }
    return F_NEXT
}

// A batch in lexdb's own dialect (SET LEXDB_DIALECT POSTGRES): the first
// error ends it; SET LEXDB_DIALECT TSQL goes back.
fn (st: mut &State) runPg(sess: mut &lexdb_exec.Session, sql: &str, ev: mut &[]Event) {
    let low = strings.toLowerAscii(&(strings.trim(&sql)))
    if strings.startsWith(&low, "set lexdb_dialect") {
        st.postgres = !strings.contains(&low, "tsql")
        doneEv(ev, -1, 0, false)
        return
    }
    match lexdb_sql.parse(sql) {
        Err(e) {
            errorEv(ev, &e)
            doneEv(ev, -1, 0, true)
        }
        Ok(stmts) {
            let none: []Val = []
            let nt: []int = []
            var any = false
            for s in stmts {
                if s.kind == lexdb_sql.S_EMPTY { continue }
                any = true
                st.committed = false
                let before = sess.status()
                let r = sess.run(&s, &none, &nt)
                if r.isErr() {
                    let e = r.unwrapErr()
                    errorEv(ev, &e)
                    doneEv(ev, -1, cmdOf(s.kind), true)
                    st.after(sess, before, ev)
                    break
                }
                var res = r.unwrap()
                if res.tag == "COMMIT" { st.committed = true }
                if res.hasRows {
                    var x = ev0(EV_ROWS)
                    x.cols = replace(mut &res.cols, [])
                    x.rows = replace(mut &res.rows, [])
                    append(ev, x)
                }
                let n = tagCount(&res.tag)
                doneEv(ev, if st.nocount { -1 } else { n }, cmdOf(s.kind), false)
                st.after(sess, before, ev)
            }
            if !any { doneEv(ev, -1, 0, false) }
        }
    }
}

// ---- bulk load and the metadata bulk-copy clients ask for first
// (design/lexdb-tds.md, section 14)

// The rows of the bulk load the last INSERT BULK accepted (st.bulk), from
// pull as they arrive: one statement, as an INSERT is (a transaction of its
// own, or under a savepoint in the open one; IMPLICIT_TRANSACTIONS begins
// one); its row count, or its error then 3621, as SQL Server ends one.
pub fn bulk(sess: mut &lexdb_exec.Session, st: mut &State, pull: &fn(): lexdb_exec.CopyPart, ev: mut &[]Event) {
    var req = pop(mut &st.bulk)
    st.bulk = []
    var s = lexdb_sql.newStmt(lexdb_sql.S_COPY)
    s.table = req.table
    s.names = replace(mut &req.cols, [])
    s.copy.from = true
    s.copy.bulk = true
    s.copy.keepNulls = req.keepNulls
    var f = newFrame()
    st.refresh(sess, mut &f)
    let before = sess.status()
    let go = st.sqlStmtWith(sess, &s, mut &f, ev, false, pull)
    st.after(sess, before, ev)
}

// The columns sql's first statement returns, as SQL Server describes them
// (sp_describe_first_result_set, sp_prepare's metadata): none for a
// statement that returns none. params: its parameters (sp_prepare's).
pub fn describeFirst(sess: mut &lexdb_exec.Session, st: &State, sql: &str, params: &[]lexdb_tsqlparse.ParamDecl): Result[[]lexdb_exec.DeclCol, DbErr] {
    var f = newFrame()
    for p in params { let k = f.add(&p.name, p.typ, Val.Null) }
    let b = try lexdb_tsqlparse.parseBatch(sql, lexdb_sql.Dialect{tsql: true, quotedIdent: st.quotedIdent}, &f.names)
    for t in b.stmts {
        if t.kind == lexdb_tsqlparse.TS_SQL {
            if t.stmt[0].kind != lexdb_sql.S_SELECT || len(t.stmt[0].assign) > 0 { return Ok([]) }
            return sess.describeDecl(&t.stmt[0])
        }
    }
    return Ok([])
}

// The TDS type a column of SQL Server's type goes as (its tds_type_id): a
// fixed-length type when NOT NULL, else its nullable kind; text, ntext and
// image as (max) types.
pub fn tdsTypeOf(d: &lexdb_exec.DeclCol): int {
    let fixed = !d.nullable
    match d.typ {
        "tinyint", "smallint", "int", "bigint" { return if fixed { d.sys } else { 0x26 } }
        "bit" { return if fixed { 0x32 } else { 0x68 } }
        "real", "float" { return if fixed { d.sys } else { 0x6D } }
        "money", "smallmoney" { return if fixed { d.sys } else { 0x6E } }
        "datetime", "smalldatetime" { return if fixed { d.sys } else { 0x6F } }
        "text" { return 0xA7 }
        "ntext" { return 0xE7 }
        "image" { return 0xA5 }
        else { return d.sys }
    }
}

// The length TDS gives a column of SQL Server's type (its tds_length):
// bytes, 65535 for a (max) type.
pub fn tdsLenOf(d: &lexdb_exec.DeclCol): int {
    if d.typ == "decimal" || d.typ == "numeric" { return 17 }
    if d.typ == "xml" { return 8100 }
    if d.maxLen < 0 || d.typ == "text" || d.typ == "ntext" || d.typ == "image" { return 65535 }
    return d.maxLen
}

// SQL Server's name of a column's type with its length, precision or scale.
fn typeText(d: &lexdb_exec.DeclCol): str {
    let t = d.typ
    if t == "varchar" || t == "char" || t == "varbinary" || t == "binary" { return t + "(" + (if d.maxLen < 0 { "max" } else { d.maxLen.toStr() }) + ")" }
    if t == "nvarchar" || t == "nchar" { return t + "(" + (if d.maxLen < 0 { "max" } else { (d.maxLen / 2).toStr() }) + ")" }
    if t == "decimal" || t == "numeric" { return t + "(" + d.prec.toStr() + "," + d.scale.toStr() + ")" }
    if t == "time" || t == "datetime2" || t == "datetimeoffset" { return t + "(" + d.scale.toStr() + ")" }
    return t.toStr()
}

// Whether the type carries a collation.
fn textual(d: &lexdb_exec.DeclCol): bool {
    let t = d.typ
    return t == "varchar" || t == "char" || t == "nvarchar" || t == "nchar" || t == "text" || t == "ntext"
}

const DESCRIBE_COLS: []str = ["is_hidden:b", "column_ordinal:i", "name:s", "is_nullable:b", "system_type_id:i", "system_type_name:s",
    "max_length:h", "precision:t", "scale:t", "collation_name:s", "user_type_id:i", "user_type_database:s", "user_type_schema:s",
    "user_type_name:s", "assembly_qualified_type_name:s", "xml_collection_id:i", "xml_collection_database:s", "xml_collection_schema:s",
    "xml_collection_name:s", "is_xml_document:b", "is_case_sensitive:b", "is_fixed_length_clr_type:b", "source_server:s",
    "source_database:s", "source_schema:s", "source_table:s", "source_column:s", "is_identity_column:b", "is_part_of_unique_key:b",
    "is_updateable:b", "is_computed_column:b", "is_sparse_column_set:b", "ordinal_in_order_by_list:h", "order_by_is_descending:h",
    "order_by_list_length:h", "tds_type_id:i", "tds_length:i", "tds_collation_id:i", "tds_collation_sort_id:t"]

// sp_describe_first_result_set's result: a row per column, SQL Server's 39
// columns (those lexdb has nothing for NULL, as SQL Server leaves them for a
// table's column read without browse information).
pub fn describeRows(cols: &[]lexdb_exec.DeclCol): Event {
    var x = ev0(EV_ROWS)
    for c in DESCRIBE_COLS {
        let p = strings.split(&c, ":")
        let k = p[1]
        let oid = if k == "b" { lexdb_sql.OID_BOOL } else if k == "s" { lexdb_sql.OID_TEXT } else if k == "i" { lexdb_sql.OID_INT4 } else { lexdb_sql.OID_INT2 }
        append(mut &x.cols, lexdb_exec.OutCol{name: p[0].toStr(), oid: oid, spell: p[0].toStr(), coll: "",
                                              scale: if k == "t" { lexdb_syscat.hint(lexdb_syscat.TS_TINYINT, 0) } else { -1 }})
    }
    for i in 0..len(cols) {
        let d = &cols[i]
        let tx = textual(d)
        let n = Val.Null
        let no = Val.Bool(false)
        append(mut &x.rows, [no, Val.Int(i + 1), Val.Text(d.name), Val.Bool(d.nullable), Val.Int(d.sys), Val.Text(typeText(d)),
                             Val.Int(d.maxLen), Val.Int(d.prec), Val.Int(d.scale), if len(d.coll) > 0 && tx { Val.Text(d.coll) } else { n },
                             n, n, n, n, n, n, n, n, n, no, no, no, n, n, n, n, n, Val.Bool(d.identity), n, Val.Bool(!d.identity), no, no, n, n, n,
                             Val.Int(tdsTypeOf(d)), Val.Int(tdsLenOf(d)), if tx { Val.Int(13632521) } else { n }, if tx { Val.Int(52) } else { n }])
    }
    return x
}

// sp_tablecollations_100's result for a table (SqlBulkCopy's): a row per
// column, its collation where it has one (TDS's 5 bytes, then its name).
fn tableCollations(cols: &[]lexdb_exec.DeclCol): Event {
    var x = ev0(EV_ROWS)
    x.cols = [outCol(&"colid", lexdb_sql.OID_INT4), outCol(&"name", lexdb_sql.OID_TEXT), outCol(&"tds_collation", lexdb_sql.OID_BYTEA),
              outCol(&"collation", lexdb_sql.OID_TEXT)]
    for i in 0..len(cols) {
        let d = &cols[i]
        let tx = textual(d)
        append(mut &x.rows, [Val.Int(i + 1), Val.Text(d.name), if tx { Val.Bytes(TDS_COLLATION) } else { Val.Null },
                             if tx { Val.Text(d.coll) } else { Val.Null }])
    }
    return x
}

// A table's name given as text ("[dbo].[t]", ".[t]", "db.dbo.t") as lexdb's.
fn tableArg(text: &str): Result[str, DbErr] {
    var t = strings.trim(&text)
    while strings.startsWith(&t, ".") { t = t[1..len(t)].toStr() }
    let none: []str = []
    var q = try lexdb_sql.tsqlParser(&t, lexdb_sql.Dialect{tsql: true, quotedIdent: true}, &none)
    return q.tableName()
}

// SQL_Latin1_General_CP1_CI_AS in TDS's 5 bytes (lexdb_tds sends every text column so)
const TDS_COLLATION = "\x09\x04\xd0\x00\x34"
