// lexdb: T-SQL batches, run (design/lexdb-tds.md). lexdb_tsqlparse parses a
// batch whole (parseBatch); this runs its statements against a session with SQL
// Server's rules, and says what happened as events for the protocol
// (lexdb_tds) to send.
//
// Variables: a batch's variables are its statements' parameters. The frame
// holds them in order, @@ system values first (@@TRANCOUNT, @@ROWCOUNT,
// @@ERROR, @@SPID, @@VERSION, @@SERVERNAME, @@LANGUAGE, kept current before
// each statement), then an RPC's parameters, then what DECLARE adds; the
// k-th is $k to the executor. SELECT @v = expr and SET @v = expr assign
// (from the last row, as SQL Server does; none: unchanged).
//
// Transactions: BEGIN TRAN nests (@@TRANCOUNT); COMMIT ends the outermost;
// ROLLBACK ends them all, or goes back to a SAVE TRAN point. An error rolls
// back only its statement (each statement in a transaction runs under a
// savepoint), unless SET XACT_ABORT ON or the error dooms the transaction
// (serialization and deadlock), which roll it back and end the batch. SET
// IMPLICIT_TRANSACTIONS ON begins one at the first statement that reads or
// writes a table. Errors: the batch goes on after most; it ends after one
// that SQL Server finds compiling (an unknown table, column or function,
// an undeclared variable).
//
// SET LEXDB_DIALECT POSTGRES runs later batches in lexdb's own dialect, as
// over PostgreSQL's protocol (the first error ends a batch); SET
// LEXDB_DIALECT TSQL goes back.
import "strings"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_tsqlparse"
import "./lexdb_exec"
import "./lexdb_syscat"

type Val = lexdb_sql.Val
type DbErr = lexdb_base.DbErr
type TypeName = lexdb_sql.TypeName

pub const VERSION = "lexdb (SQL Server protocol, TDS 7.4; reports itself as Microsoft SQL Server 16.0.4315)"

// ---- events

pub const EV_ROWS = 1       // a result set: cols and rows
pub const EV_DONE = 2       // a statement's end: count (-1: none to report), cmd, error
pub const EV_ERROR = 3      // err
pub const EV_TRAN = 4       // tran: the transaction began (8), committed (9) or was rolled back (10)
pub const EV_INFO = 5       // a message (PRINT, RAISERROR under severity 11): err's text, number, sev and state
pub const EV_DB = 6         // USE: the session's database is err.msg (ENVCHANGE, and INFO 5701)

pub type Event = record {
    pub kind: int
    pub cols: []lexdb_exec.OutCol
    pub rows: [][]Val
    pub count: int
    pub cmd: int
    pub error: bool
    pub err: DbErr
    pub tran: int
    pub number: int         // EV_ERROR, EV_INFO: SQL Server's number, severity and state
    pub sev: int
    pub state: int
    // EV_ROWS of metadata only (SET FMTONLY ON, sp_prepare's): the columns as
    // SQL Server describes them, no rows (cols and rows empty)
    pub decl: []lexdb_exec.DeclCol
}

// An event to put in an emptied place (a DONE without a count).
pub fn doneEvent(): Event { return ev0(EV_DONE) }

fn ev0(kind: int): Event {
    return Event{kind: kind, cols: [], rows: [], count: -1, cmd: 0, error: false, err: lexdb_base.err("", ""), tran: 0, number: 0, sev: 0, state: 0,
                 decl: []}
}

// An error as SQL Server tells it: its number, text, severity and state
// (ERROR_NUMBER() and the rest in a CATCH block).
pub type Caught = record { pub number: int; pub message: str; pub severity: int; pub state: int }

fn caughtOf(e: &DbErr): Caught {
    var n = sqlNumber(&e.state)
    var msg = sqlMessage(n, &e.msg)
    if n == 102 && strings.startsWith(&e.msg, "syntax error at or near \"") {
        // SQL Server says "near the keyword 'x'" (156) for a reserved word, else "near 'x'" (102)
        let tok = quotedName(&e.msg)
        if lexdb_sql.isReservedWord(&strings.toLowerAscii(&tok)) {
            n = 156
            msg = "Incorrect syntax near the keyword '" + tok + "'."
        } else {
            msg = "Incorrect syntax near '" + tok + "'."
        }
    }
    return Caught{number: n, message: msg, severity: sqlClass(n), state: 1}
}

// The text between the first pair of double quotes of msg.
fn quotedName(msg: &str): str {
    let a = strings.indexOf(msg, "\"", 0)
    if a < 0 { return "" }
    let b = strings.indexOf(msg, "\"", a + 1)
    if b < 0 { return "" }
    return msg[a + 1..b].toStr()
}

// SQL Server's text for the errors programs look at, where lexdb's differs.
fn sqlMessage(n: int, msg: &str): str {
    if n == 8134 { return "Divide by zero error encountered." }
    if n == 208 && strings.startsWith(msg, "relation \"") { return "Invalid object name '" + quotedName(msg) + "'." }
    if n == 207 && strings.startsWith(msg, "column \"") { return "Invalid column name '" + quotedName(msg) + "'." }
    return msg.toStr()
}

// DONE's CurCmd: the statement it ends
pub const CMD_SELECT = 0xC1
pub const CMD_INSERT = 0xC3
pub const CMD_DELETE = 0xC4
pub const CMD_UPDATE = 0xC5
pub const CMD_MERGE = 0x117       // (SQL Server's MERGE; its DONE carries the rows merged)
pub const CMD_BULK = 0xF0       // a bulk load's rows (SQL Server's BULK INSERT)
pub const CMD_SETOPT = 0xFD     // what SQL Server's DONE gives INSERT BULK

fn cmdOf(kind: int): int {
    if kind == lexdb_sql.S_SELECT { return CMD_SELECT }
    if kind == lexdb_sql.S_INSERT { return CMD_INSERT }
    if kind == lexdb_sql.S_UPDATE { return CMD_UPDATE }
    if kind == lexdb_sql.S_DELETE { return CMD_DELETE }
    if kind == lexdb_sql.S_MERGE { return CMD_MERGE }
    return 0
}

fn errorEv(ev: mut &[]Event, e: &DbErr) {
    var x = ev0(EV_ERROR)
    let c = caughtOf(e)
    x.err = DbErr{state: e.state, msg: c.message, context: e.context, detail: e.detail, hint: e.hint}
    x.number = c.number
    x.sev = c.severity
    x.state = c.state
    append(ev, x)
}

fn caughtEv(ev: mut &[]Event, c: &Caught, kind: int) {
    var x = ev0(kind)
    x.err = lexdb_base.err("TS" + c.number.toStr(), c.message.toStr())
    x.number = c.number
    x.sev = c.severity
    x.state = c.state
    append(ev, x)
}

fn doneEv(ev: mut &[]Event, count: int, cmd: int, error: bool) {
    var x = ev0(EV_DONE)
    x.count = count
    x.cmd = cmd
    x.error = error
    append(ev, x)
}

// SQL Server's error number for a lexdb error: T-SQL's own errors carry
// theirs in the state ("TS208"); for the rest, the number SQL Server gives
// the same failure, where there is one, else 50000.
pub fn sqlNumber(state: &str): int {
    if strings.startsWith(&state, "TS") { return strings.parseIntOpt(&(state[2..len(state)].toStr())).unwrapOr(50000) }
    match state.toStr() {
        "42P01" { return 208 }      // Invalid object name
        "42703" { return 207 }      // Invalid column name
        "42601" { return 102 }      // Incorrect syntax near
        "42883" { return 195 }      // is not a recognized built-in function name
        "42P07" { return 2714 }     // There is already an object named
        "42710" { return 2714 }
        "42501" { return 229 }      // permission was denied
        "42P21" { return 468 }      // Cannot resolve the collation conflict
        "428C9" { return 544 }      // Cannot insert explicit value for identity column
        "23505" { return 2627 }     // Violation of PRIMARY KEY / UNIQUE KEY constraint
        "23502" { return 515 }      // Cannot insert the value NULL into column
        "23503" { return 547 }      // conflicted with the FOREIGN KEY constraint
        "23514" { return 547 }      // conflicted with the CHECK constraint
        "22012" { return 8134 }     // Divide by zero error encountered
        "22003" { return 8115 }     // Arithmetic overflow error
        "22001" { return 2628 }     // String or binary data would be truncated
        "22P02" { return 245 }      // Conversion failed
        "22007" { return 241 }      // Conversion failed when converting date and/or time
        "22008" { return 517 }      // Adding a value to a 'datetime' column caused an overflow
        "40001" { return 1205 }     // deadlock victim / serialization
        "40P01" { return 1205 }
        "25P02" { return 3930 }     // The current transaction cannot be committed
        "28000" { return 18456 }    // Login failed
        "28P01" { return 18456 }
        "57014" { return 3617 }     // cancelled
        else { return 50000 }
    }
}

// The severity SQL Server gives error n: 14 for a key's violation and a
// failed login, 15 for a syntax error, else 16.
pub fn sqlClass(n: int): int {
    if n == 2627 || n == 2601 || n == 18456 || n == 229 { return 14 }
    if n == 102 || n == 156 || n == 105 || n == 10713 || n == 10710 || n == 10711 || n == 10714 || n == 109 || n == 110 { return 15 }
    return 16
}

// An error SQL Server finds compiling the batch's statement: the batch ends.
fn endsBatch(e: &DbErr): bool {
    let n = sqlNumber(&e.state)
    return n == 208 || n == 207 || n == 102 || n == 195 || n == 137 || n == 134 || n == 2812 || n == 468
}

// An error after which the transaction cannot go on.
fn dooms(e: &DbErr): bool { return e.state == "40001" || e.state == "40P01" || e.state == "25P02" }

// ---- a connection's state, and a batch's variables

pub type State = record {
    pub nocount: bool
    pub xactAbort: bool
    pub implicitTx: bool
    pub quotedIdent: bool
    pub postgres: bool          // SET LEXDB_DIALECT POSTGRES
    pub trancount: int
    pub rowcount: int
    pub rowLimit: int           // SET ROWCOUNT n: a SELECT returns at most n rows (0: all)
    pub error: int
    pub spid: int
    saves: []str                // SAVE TRAN names, in order
    committed: bool             // the last transaction to end was committed
    // TRY ... CATCH (S4): TRY blocks in, the error that leaves one (jump),
    // the errors CATCH blocks handle (innermost last)
    tryDepth: int
    jump: bool
    pending: Caught
    caught: []Caught
    doomed: bool                // XACT_ABORT's error in a TRY block: the transaction can only be rolled back
    temps: []str                // the #temporary tables made (dropped when the connection ends or is reset)
    tableVars: []str            // the batch's table variables (#@name), dropped after it
    pub fmtOnly: bool           // SET FMTONLY ON: a SELECT's columns only, nothing else run
    pub bulk: []BulkReq         // an INSERT BULK accepted: its rows come next (lexdb_tds), one at most
    roTables: []str             // the table-valued parameters' temporary tables while their call runs (bindTable)
    roParams: []str             // ... their parameters' names, parallel
}

// An INSERT BULK accepted (design/lexdb-tds.md, section 14): the table, the
// columns the rows give, KEEP_NULLS.
// bad: a column the table has not (SQL Server's DONE then says an error,
// with no message, and so does the load's).
pub type BulkReq = record { pub table: str; pub cols: []str; pub keepNulls: bool; pub bad: bool }

pub fn newState(spid: int): State {
    return State{nocount: false, xactAbort: false, implicitTx: false, quotedIdent: true, postgres: false, trancount: 0,
                 rowcount: 0, rowLimit: 0, error: 0, spid: spid, saves: [], committed: false, tryDepth: 0, jump: false,
                 pending: Caught{number: 0, message: "", severity: 0, state: 0}, caught: [], doomed: false, temps: [], tableVars: [],
                 fmtOnly: false, bulk: [], roTables: [], roParams: []}
}

// An error: to the client, or (in a TRY block) to its CATCH block.
fn (st: mut &State) fail(ev: mut &[]Event, c: Caught, cmd: int) { st.failAs(ev, c, cmd, true) }

// fail; counted: a statement's (in a TRY block SQL Server ends it with a
// count of 0; RAISERROR and THROW with none).
fn (st: mut &State) failAs(ev: mut &[]Event, c: Caught, cmd: int, counted: bool) {
    st.error = c.number
    if st.tryDepth > 0 {
        if counted { doneEv(ev, if st.nocount { -1 } else { 0 }, cmd, false) }
        st.pending = c
        st.jump = true
        return
    }
    caughtEv(ev, &c, EV_ERROR)
    doneEv(ev, -1, cmd, true)
}

fn (st: mut &State) failErr(ev: mut &[]Event, e: &DbErr, cmd: int) { st.fail(ev, caughtOf(e), cmd) }

pub type Frame = record {
    pub names: []str
    pub types: []TypeName
    pub vals: []Val
}

const SYSVARS: []str = ["@@trancount", "@@rowcount", "@@error", "@@spid", "@@version", "@@servername", "@@language", "@@identity",
                         "@@error_number", "@@error_message", "@@error_severity", "@@error_state", "@@error_line", "@@error_procedure",
                         "@@xact_state"]

fn intType(oid: int): TypeName { return TypeName{kind: lexdb_sql.K_INT, oid: oid, prec: 0, scale: 0, len: 0} }
fn textType(): TypeName { return TypeName{kind: lexdb_sql.K_TEXT, oid: lexdb_sql.OID_TEXT, prec: 0, scale: 0, len: 0} }

// A frame with the system values only.
pub fn newFrame(): Frame {
    var f = Frame{names: [], types: [], vals: []}
    for n in SYSVARS {
        append(mut &f.names, n.toStr())
        append(mut &f.types, if n == "@@version" || n == "@@servername" || n == "@@language" || n == "@@error_message" || n == "@@error_procedure" { textType() }
                            else if n == "@@identity" { TypeName{kind: lexdb_sql.K_NUM, oid: lexdb_sql.OID_NUMERIC, prec: 38, scale: 0, len: 0} }
                            else { intType(lexdb_sql.OID_INT4) })
        append(mut &f.vals, Val.Null)
    }
    return f
}

// A variable added (an RPC's parameter): its index.
pub fn (f: mut &Frame) add(name: &str, t: TypeName, v: Val): int {
    append(mut &f.names, name.toStr())
    append(mut &f.types, t)
    append(mut &f.vals, v)
    return len(f.names) - 1
}

pub fn (f: &Frame) find(name: &str): int {
    for i in 0..len(f.names) { if f.names[i] == name { return i } }
    return -1
}

fn (st: &State) refresh(sess: &lexdb_exec.Session, f: mut &Frame) {
    f.vals[0] = Val.Int(st.trancount)
    f.vals[1] = Val.Int(st.rowcount)
    f.vals[2] = Val.Int(st.error)
    f.vals[3] = Val.Int(st.spid)
    f.vals[4] = Val.Text(VERSION)
    f.vals[5] = Val.Text("lexdb")
    f.vals[6] = Val.Text("us_english")
    f.vals[7] = match sess.lastIdentity() {
        Some(n) { Val.Num(Decimal.fromInt(n)) }
        None { Val.Null }
    }
    // ERROR_NUMBER() and the rest: the error the innermost CATCH block handles, NULL outside one
    let k = len(st.caught)
    if k > 0 {
        let c = &st.caught[k - 1]
        f.vals[8] = Val.Int(c.number)
        f.vals[9] = Val.Text(c.message)
        f.vals[10] = Val.Int(c.severity)
        f.vals[11] = Val.Int(c.state)
        f.vals[12] = Val.Int(1)
        f.vals[13] = Val.Null
    } else {
        for i in 8..14 { f.vals[i] = Val.Null }
    }
    f.vals[14] = Val.Int(if sess.status() == 'I' { 0 } else if st.doomed { -1 } else { 1 })
}

fn (f: &Frame) oids(): []int {
    var o: []int = []
    for t in f.types { append(mut &o, t.oid) }
    return o
}

// ---- running

// The row count in a command tag ("INSERT 0 3", "UPDATE 2", "SELECT 5"), -1 none.
fn tagCount(tag: &str): int {
    let sp = strings.lastIndexOf(&tag, " ")
    if sp < 0 { return -1 }
    let w = tag[0..strings.indexOf(&tag, " ", 0)].toStr()
    if w != "INSERT" && w != "UPDATE" && w != "DELETE" && w != "SELECT" && w != "MERGE" && w != "COPY" && w != "FETCH" && w != "MOVE" {
        return -1
    }
    return strings.parseIntOpt(&(tag[sp + 1..len(tag)].toStr())).unwrapOr(-1)
}

// A statement of lexdb's own, without parameters.
fn simple(sess: mut &lexdb_exec.Session, sql: &str): Result[lexdb_exec.Res, DbErr] {
    let stmts = try lexdb_sql.parse(sql)
    let none: []Val = []
    let nt: []int = []
    return sess.run(&stmts[0], &none, &nt)
}

const SAVE = "\"lexdb tsql statement\""

fn txStmt(kind: int): bool {
    return kind == lexdb_sql.S_BEGIN || kind == lexdb_sql.S_COMMIT || kind == lexdb_sql.S_ROLLBACK ||
           kind == lexdb_sql.S_SAVEPOINT || kind == lexdb_sql.S_RELEASE || kind == lexdb_sql.S_ROLLBACK_TO
}

// Whether SET IMPLICIT_TRANSACTIONS ON begins a transaction for s: one that
// reads or writes a table.
fn startsTx(s: &lexdb_sql.Stmt): bool {
    if txStmt(s.kind) || s.kind == lexdb_sql.S_SET || s.kind == lexdb_sql.S_SHOW { return false }
    if s.kind == lexdb_sql.S_SELECT { return len(s.from) > 0 }
    return true
}

fn noPull(): lexdb_exec.CopyPart { return lexdb_exec.CopyPart{rows: [], data: "", end: true, fail: "", proto: false} }

// Runs one statement of lexdb's parser; false when the batch ends.
fn (st: mut &State) sqlStmt(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, f: mut &Frame, ev: mut &[]Event, quiet: bool): bool {
    if st.fmtOnly && !txStmt(s.kind) { return st.fmtStmt(sess, s, ev) }
    return st.sqlStmtWith(sess, s, f, ev, quiet, noPull)
}

// SET FMTONLY ON: a SELECT gives its columns as SQL Server describes them,
// and no rows; nothing is run.
fn (st: mut &State) fmtStmt(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, ev: mut &[]Event): bool {
    if s.kind != lexdb_sql.S_SELECT || len(s.assign) > 0 {
        doneEv(ev, -1, cmdOf(s.kind), false)
        return true
    }
    match sess.describeDecl(s) {
        Ok(cols) {
            var x = ev0(EV_ROWS)
            x.decl = cols
            append(ev, x)
            doneEv(ev, if st.nocount { -1 } else { 0 }, CMD_SELECT, false)
            return true
        }
        Err(e) {
            st.failErr(ev, &e, CMD_SELECT)
            return st.tryDepth > 0 || !endsBatch(&e)
        }
    }
}

// sqlStmt; a bulk load's (s a COPY of copy.bulk) rows from pull.
fn (st: mut &State) sqlStmtWith(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, f: mut &Frame, ev: mut &[]Event, quiet: bool,
                                pull: &fn(): lexdb_exec.CopyPart): bool {
    let bulk = s.kind == lexdb_sql.S_COPY && s.copy.bulk
    if st.implicitTx && sess.status() == 'I' && startsTx(s) {
        match simple(sess, &"BEGIN") {
            Ok(_) {}
            Err(e) {
                st.failErr(ev, &e, 0)
                return false
            }
        }
    }
    let inTx = sess.status() != 'I' && !txStmt(s.kind)
    if inTx {
        let sp = simple(sess, &("SAVEPOINT " + SAVE))
    }
    let cmd = if bulk { CMD_BULK } else { cmdOf(s.kind) }
    // as SQL Server: an INSERT, UPDATE or DELETE runs in a transaction of
    // its own, nested, so @@TRANCOUNT inside it is one more
    if s.kind == lexdb_sql.S_INSERT || s.kind == lexdb_sql.S_UPDATE || s.kind == lexdb_sql.S_DELETE || s.kind == lexdb_sql.S_MERGE {
        f.vals[0] = Val.Int(max(st.trancount, if sess.status() == 'I' { 0 } else { 1 }) + 1)
    }
    let oids = f.oids()
    let r = if bulk { sess.copyInFrom(s, pull) } else { sess.run(s, &f.vals, &oids) }
    if r.isErr() {
        let e = r.unwrapErr()
        if bulk && st.tryDepth == 0 {
            // as SQL Server ends a bulk load: the error, then 3621
            st.error = sqlNumber(&e.state)
            errorEv(ev, &e)
            caughtEv(ev, &Caught{number: 3621, message: "The statement has been terminated.", severity: 0, state: 0}, EV_INFO)
            doneEv(ev, -1, cmd, true)
        } else {
            st.failErr(ev, &e, cmd)
        }
        st.rowcount = 0
        if inTx {
            if (st.xactAbort || dooms(&e)) && st.tryDepth == 0 {
                let rb = simple(sess, &"ROLLBACK")
                return false
            }
            let back = simple(sess, &("ROLLBACK TO SAVEPOINT " + SAVE))
            let rel = simple(sess, &("RELEASE SAVEPOINT " + SAVE))
            // in a TRY block: the transaction left open, to be rolled back (XACT_STATE() -1)
            if st.xactAbort || dooms(&e) { st.doomed = true }
        } else if st.xactAbort && st.tryDepth == 0 {
            return false
        }
        return st.tryDepth > 0 || !endsBatch(&e)
    }
    var res = r.unwrap()
    if inTx {
        let rel = simple(sess, &("RELEASE SAVEPOINT " + SAVE))
    }
    st.error = 0
    if len(s.assign) > 0 {
        // SELECT @v = ...: the last row's values, each to its variable's type
        let n = len(res.rows)
        if n > 0 {
            for i in 0..len(s.assign) {
                let k = f.find(&s.assign[i])
                if k < 0 || i >= len(res.rows[n - 1]) { continue }
                match lexdb_exec.coerce(res.rows[n - 1][i], &f.types[k]) {
                    Ok(v) { f.vals[k] = v }
                    Err(e) {
                        st.failErr(ev, &e, cmd)
                        return true
                    }
                }
            }
        }
        st.rowcount = n
        if !quiet { doneEv(ev, if st.nocount { -1 } else { n }, cmd, false) }
        return true
    }
    let n = tagCount(&res.tag)
    st.rowcount = max(n, 0)
    if res.hasRows {
        var x = ev0(EV_ROWS)
        x.cols = replace(mut &res.cols, [])
        x.rows = replace(mut &res.rows, [])
        if st.rowLimit > 0 && s.kind == lexdb_sql.S_SELECT && len(x.rows) > st.rowLimit { x.rows = copyRows(&x.rows, st.rowLimit) }
        append(ev, x)
    }
    if res.tag == "COMMIT" { st.committed = true }
    if res.tag == "ROLLBACK" && !txStmt(s.kind) { st.committed = false }
    doneEv(ev, if st.nocount && !bulk { -1 } else { n }, cmd, false)
    // a #temporary table made: dropped with the connection
    if s.kind == lexdb_sql.S_CREATE && strings.startsWith(&s.table, "#") && !strings.startsWith(&s.table, "#@") { append(mut &st.temps, s.table) }
    return true
}

// The first n of rows.
fn copyRows(rows: &[][]Val, n: int): [][]Val {
    var out: [][]Val = []
    for i in 0..n {
        var r: []Val = []
        for v in rows[i] { append(mut &r, v) }
        append(mut &out, r)
    }
    return out
}

// A statement of lexdb's own (BEGIN, COMMIT, ...) for transaction control:
// an error as an event; false when there was one.
fn (st: mut &State) control(sess: mut &lexdb_exec.Session, sql: &str, ev: mut &[]Event): bool {
    match simple(sess, sql) {
        Ok(r) {
            if r.tag == "COMMIT" { st.committed = true }
            if r.tag == "ROLLBACK" && sql == "ROLLBACK" { st.committed = false }
            return true
        }
        Err(e) {
            st.failErr(ev, &e, 0)
            return false
        }
    }
}

fn tsErr(n: int, msg: str): DbErr { return lexdb_base.err("TS" + n.toStr(), msg) }

// One statement of the batch; false when the batch ends.
fn (st: mut &State) exec(sess: mut &lexdb_exec.Session, t: &lexdb_tsqlparse.TStmt, f: mut &Frame, ev: mut &[]Event): bool {
    if t.kind == lexdb_tsqlparse.TS_SQL { return st.sqlStmt(sess, &t.stmt[0], f, ev, false) }
    if t.kind == lexdb_tsqlparse.TS_INSERTBULK {
        // the table must be there (208); its columns are looked at when the rows come
        match sess.tableDecl(&t.names[0]) {
            Ok(decl) {
                var cols: []str = []
                var bad = false
                for i in 1..len(t.names) {
                    append(mut &cols, t.names[i])
                    var k = -1
                    for j in 0..len(decl) { if strings.toLowerAscii(&decl[j].name) == t.names[i] { k = j } }
                    if k < 0 { bad = true }
                }
                st.bulk = [BulkReq{table: t.names[0], cols: cols, keepNulls: strings.contains(&t.value, "keep_nulls"), bad: bad}]
                doneEv(ev, -1, CMD_SETOPT, bad)
                return true
            }
            Err(e) {
                // (SQL Server says 208 twice)
                if sqlNumber(&e.state) == 208 { errorEv(ev, &e) }
                st.failErr(ev, &e, 0)
                return false
            }
        }
    }
    if t.kind == lexdb_tsqlparse.TS_DECLARE {
        // DECLARE @a = x, @b = y counts one row, as SQL Server
        for i in 0..len(t.stmt) {
            if !st.sqlStmt(sess, &t.stmt[i], f, ev, i + 1 < len(t.stmt)) { return false }
        }
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_SETOPT {
        let on = t.value == "on"
        for n in t.names {
            if n == "nocount" { st.nocount = on }
            else if n == "xact_abort" { st.xactAbort = on }
            else if n == "implicit_transactions" { st.implicitTx = on }
            else if n == "quoted_identifier" { st.quotedIdent = on }
            else if n == "fmtonly" { st.fmtOnly = on }
            else if n == "rowcount" { st.rowLimit = max(strings.parseIntOpt(&t.value).unwrapOr(0), 0) }
            else if n == "identity_insert" {
                sess.setIdentityInsert(&(if on { t.names[1] } else { "" }))
                break
            }
            else if n == "lexdb_dialect" {
                if t.value != "postgres" && t.value != "tsql" {
                    errorEv(ev, &lexdb_base.err("22023", "SET LEXDB_DIALECT takes POSTGRES or TSQL"))
                    doneEv(ev, -1, 0, true)
                    return true
                }
                st.postgres = t.value == "postgres"
            }
        }
        doneEv(ev, -1, 0, false)
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_BEGIN {
        if sess.status() == 'I' {
            if !st.control(sess, &"BEGIN", ev) { return true }
            st.trancount = 0
        }
        st.trancount += 1
        doneEv(ev, -1, 0, false)
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_COMMIT {
        if st.trancount == 0 {
            st.failErr(ev, &tsErr(3902, "The COMMIT TRANSACTION request has no corresponding BEGIN TRANSACTION."), 0)
            return true
        }
        st.trancount -= 1
        if st.trancount == 0 {
            if !st.control(sess, &"COMMIT", ev) { return true }
        }
        doneEv(ev, -1, 0, false)
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_ROLLBACK {
        var known = false
        if len(t.names) > 0 {
            for sv in st.saves { if sv == t.names[0] { known = true } }
        }
        if known {
            if !st.control(sess, &("ROLLBACK TO SAVEPOINT " + quoteName(&t.names[0])), ev) { return true }
            doneEv(ev, -1, 0, false)
            return true
        }
        if st.trancount == 0 && sess.status() == 'I' {
            st.failErr(ev, &tsErr(3903, "The ROLLBACK TRANSACTION request has no corresponding BEGIN TRANSACTION."), 0)
            return true
        }
        let ok = st.control(sess, &"ROLLBACK", ev)
        st.trancount = 0
        st.saves = []
        if ok { doneEv(ev, -1, 0, false) }
        return true
    }
    if t.kind == lexdb_tsqlparse.TS_SAVE {
        if sess.status() == 'I' {
            errorEv(ev, &tsErr(628, "Cannot issue SAVE TRANSACTION when there is no active transaction."))
            doneEv(ev, -1, 0, true)
            st.error = 628
            return true
        }
        if st.control(sess, &("SAVEPOINT " + quoteName(&t.names[0])), ev) {
            append(mut &st.saves, t.names[0])
            doneEv(ev, -1, 0, false)
        }
        return true
    }
    return true
}

fn quoteName(n: &str): str { return "\"" + strings.replaceAll(&n, "\"", "\"\"") + "\"" }

// After a statement: @@TRANCOUNT kept with the session's transaction, and
// its start or end as an event.
fn (st: mut &State) after(sess: &lexdb_exec.Session, before: byte, ev: mut &[]Event) {
    let now = sess.status()
    if now == 'I' {
        st.trancount = 0
        st.saves = []
        st.doomed = false
    } else if st.trancount == 0 {
        st.trancount = 1
    }
    if before == 'I' && now != 'I' {
        var x = ev0(EV_TRAN)
        x.tran = 8
        append(ev, x)
    } else if before != 'I' && now == 'I' {
        var x = ev0(EV_TRAN)
        x.tran = if st.committed { 9 } else { 10 }
        append(ev, x)
    }
}

// Runs a batch: its events onto ev. f: its variables to start with
// (newFrame's, and an RPC's parameters), and after it the values they have.
pub fn run(sess: mut &lexdb_exec.Session, st: mut &State, sql: &str, f: mut &Frame, ev: mut &[]Event) {
    st.refresh(sess, f)
    if st.postgres {
        st.runPg(sess, sql, ev)
        return
    }
    let text = withTableTypes(sess, sql)
    let parsed = lexdb_tsqlparse.parseBatch(&text, lexdb_sql.Dialect{tsql: true, quotedIdent: st.quotedIdent}, &f.names)
    if parsed.isErr() {
        let e = parsed.unwrapErr()
        errorEv(ev, &e)
        doneEv(ev, -1, 0, true)
        st.error = sqlNumber(&e.state)
        return
    }
    let b = parsed.unwrap()
    if len(st.roTables) > 0 {
        // a table-valued parameter written to: the batch is not run (SQL Server finds it compiling)
        match st.writesReadOnly(&b.stmts) {
            Some(c) {
                st.fail(ev, c, 0)
                return
            }
            None {}
        }
    }
    let given = len(f.names)
    for k in given..len(b.vars) {
        let i = f.add(&b.vars[k], b.types[k - given], Val.Null)
    }
    if len(b.stmts) == 0 {
        doneEv(ev, -1, 0, false)
        return
    }
    if len(b.stmts) > 1 {
        for t in b.stmts {
            if t.kind == lexdb_tsqlparse.TS_INSERTBULK {
                st.fail(ev, Caught{number: 428, message: "Insert bulk cannot be used in a multi-statement batch.", severity: 16, state: 1}, 0)
                return
            }
        }
    }
    let r = st.block(sess, &b.stmts, f, ev)
    if r == F_END {
        // SET FMTONLY takes effect as the batch is compiled, as in SQL Server:
        // a batch ended by an error (SqlBulkCopy's for a table that is not
        // there) still leaves FMTONLY as its last SET FMTONLY says
        for t in b.stmts {
            if t.kind == lexdb_tsqlparse.TS_SETOPT {
                for n in t.names { if n == "fmtonly" { st.fmtOnly = t.value == "on" } }
            }
        }
    }
    // the batch's table variables go with it
    while len(st.tableVars) > 0 {
        let tv = pop(mut &st.tableVars)
        let d = simple(sess, &("DROP TABLE IF EXISTS " + quoteName(&tv)))
    }
}

// ---- table-valued parameters (design/lexdb-tds.md, "As built: table-valued parameters")
//
// A table-valued parameter @x of an RPC (lexdb_tds decodes it) is, while its
// call runs, the temporary table tvpTable("@x") of the session: made from
// its table type's definition (a CREATE TABLE of the type's text) and filled
// with the client's rows; the call's SQL names it for @x (lexdb_tsqlparse's
// renameVars), so it reads as any table in FROM, JOIN, IN (SELECT ...),
// INSERT ... SELECT. Writing to it is SQL Server's 10700, found before the
// batch runs. dropTables drops them when the call is done.

// The temporary table of the table-valued parameter name (@x).
pub fn tvpTable(name: &str): str {
    let n = strings.toLowerAscii(name)
    return "#tvp_" + (if strings.startsWith(&n, "@") { n[1..len(n)].toStr() } else { n })
}

const TVP_SAVE = "\"lexdb tsql tvp\""

// Makes the table-valued parameter param (@x) of the table type tt: its
// temporary table, and in it rows, each a value per column of sent (the
// type's columns the client sent, by place; the rest take their defaults),
// as the client sent them (srcTypes: their TDS types' names, for SQL
// Server's messages). ncols: the columns the client described (-1: the
// type's default, no rows). Errors as SQL Server's: 500 for another column
// count, 1077 for a value of an identity column, conversion errors (257,
// 245, 8114, 8115, 241, 8169, 206, 2628), 515 and 2627 for the type's own
// constraints. In a transaction, under a savepoint: an error leaves it as
// it was.
pub fn bindTable(sess: mut &lexdb_exec.Session, st: mut &State, param: &str, tt: &lexdb_exec.TabType, ncols: int, sent: &[]int,
                 srcTypes: &[]str, rows: mut &[][]Val): Result[Unit, DbErr] {
    let tmp = tvpTable(param)
    let inTx = sess.status() != 'I'
    if inTx { let sp = simple(sess, &("SAVEPOINT " + TVP_SAVE)) }
    let r = fillTable(sess, &tmp, param, tt, ncols, sent, srcTypes, rows)
    if inTx {
        if r.isErr() { let back = simple(sess, &("ROLLBACK TO SAVEPOINT " + TVP_SAVE)) }
        let rel = simple(sess, &("RELEASE SAVEPOINT " + TVP_SAVE))
    }
    append(mut &st.roTables, tmp)
    append(mut &st.roParams, param.toStr())
    return r
}

fn fillTable(sess: mut &lexdb_exec.Session, tmp: &str, param: &str, tt: &lexdb_exec.TabType, ncols: int, sent: &[]int,
             srcTypes: &[]str, rows: mut &[][]Val): Result[Unit, DbErr] {
    let none: []Val = []
    let nt: []int = []
    let noVars: []str = []
    let d0 = simple(sess, &("DROP TABLE IF EXISTS " + quoteName(tmp)))
    var q = try lexdb_sql.tsqlParser(&tt.body, lexdb_sql.Dialect{tsql: true, quotedIdent: true}, &noVars)
    let create = try q.tableDef(tmp)
    let made = try sess.run(&create, &none, &nt)
    let cols = try sess.tableColumns(tmp)
    if ncols < 0 { return Ok(Unit{}) }
    if ncols != len(cols) {
        return Err(tsErr(500, "Trying to pass a table-valued parameter with " + ncols.toStr() + " column(s) where the corresponding " +
                              "user-defined table type requires " + len(cols).toStr() + " column(s)."))
    }
    let decl = try sess.tableDecl(tmp)
    var names: []str = []
    for k in sent {
        if cols[k].identity != lexdb_sql.ID_NONE { return Err(tsErr(1077, "INSERT into an identity column not allowed on table variables.")) }
        append(mut &names, cols[k].name)
    }
    // a column SQL Server converts no value of (not even a NULL): text into binary
    for j in 0..len(sent) {
        let d = &decl[sent[j]]
        let src = if j < len(srcTypes) { srcTypes[j] } else { "" }
        let text = src == "nvarchar" || src == "varchar" || src == "nchar" || src == "char" || src == "ntext" || src == "text" || src == "xml"
        if text && (d.typ == "varbinary" || d.typ == "binary" || d.typ == "image") {
            let spec = if d.typ == "image" { "image" } else if d.maxLen < 0 { d.typ + "(max)" } else { d.typ + "(" + d.maxLen.toStr() + ")" }
            return Err(tsErr(257, "Implicit conversion from data type " + src + " to " + spec + " is not allowed. Use the CONVERT function to run this query."))
        }
    }
    // each value its column's type, as SQL Server converts a parameter's
    for r in 0..len(rows) {
        for j in 0..len(sent) {
            if j >= len(rows[r]) { break }
            let c = &cols[sent[j]]
            var v = rows[r][j]
            match v {
                Val.Bool(b) { if c.typ.kind != lexdb_sql.K_BOOL { v = Val.Int(if b { 1 } else { 0 }) } }
                else {}
            }
            match lexdb_exec.coerce(v, &c.typ) {
                Ok(x) { rows[r][j] = x }
                Err(e) { return Err(convErr(e, &(if j < len(srcTypes) { srcTypes[j].toStr() } else { "nvarchar" }), &decl[sent[j]], &rows[r][j], param)) }
            }
        }
    }
    if len(rows) == 0 { return Ok(Unit{}) }
    var s = lexdb_sql.newStmt(lexdb_sql.S_COPY)
    s.table = tmp.toStr()
    s.names = names
    s.copy.from = true
    s.copy.bulk = true
    s.copy.keepNulls = true
    var all = replace(rows, [])
    let pull = fn(): lexdb_exec.CopyPart { return lexdb_exec.CopyPart{rows: replace(mut &all, []), data: "", end: true, fail: "", proto: false} }
    match sess.copyInFrom(&s, pull) {
        Ok(_) { return Ok(Unit{}) }
        Err(e) {
            if e.state == "23502" {
                let col = quotedName(&e.msg)
                return Err(tsErr(515, "Cannot insert the value NULL into column '" + col + "', table '" + param + "'; column does not allow nulls. INSERT fails."))
            }
            if e.state == "22001" {
                return Err(tsErr(2628, "String or binary data would be truncated in table '" + param + "'."))
            }
            if e.state == "23505" {
                // SQL Server's words: the constraint (lexdb's name), the parameter as the object, the values
                let con = quotedName(&e.msg)
                let kind = if strings.endsWith(&con, "_pkey") { "PRIMARY KEY" } else { "UNIQUE KEY" }
                var dup = ""
                let eq = strings.indexOf(&e.detail, ")=(", 0)
                let close = strings.lastIndexOf(&e.detail, ")")
                if eq >= 0 && close > eq + 3 { dup = " The duplicate key value is (" + e.detail[eq + 3..close] + ")." }
                return Err(tsErr(2627, "Violation of " + kind + " constraint '" + con + "'. Cannot insert duplicate key in object 'dbo." + param + "'." + dup))
            }
            return Err(e)
        }
    }
}

// SQL Server's error for a table-valued parameter's value v (of the TDS type
// src) its column (d) cannot take; e: coerce's.
fn convErr(e: DbErr, src: &str, d: &lexdb_exec.DeclCol, v: &Val, param: &str): DbErr {
    let from = if src == "decimal" { "numeric" } else { src.toStr() }
    let to = d.typ
    let isNum = to == "decimal" || to == "numeric" || to == "money" || to == "smallmoney"
    let isInt = to == "int" || to == "bigint" || to == "smallint" || to == "tinyint" || to == "bit"
    let isTime = to == "date" || to == "time" || to == "datetime" || to == "datetime2" || to == "smalldatetime" || to == "datetimeoffset"
    if e.state == "22001" {
        return tsErr(2628, "String or binary data would be truncated in table '" + param + "', column '" + d.name + "'. Truncated value: '" +
                           truncText(&lexdb_exec.text(v), d.maxLen, to == "nvarchar" || to == "nchar") + "'.")
    }
    if e.state == "22003" {
        if isNum { return tsErr(8115, "Arithmetic overflow error converting " + from + " to data type numeric.") }
        return tsErr(8115, "Arithmetic overflow error converting expression to data type " + to + ".")
    }
    if e.state == "42804" || e.state == "42846" { return tsErr(206, "Operand type clash: " + from + " is incompatible with " + to) }
    if isTime { return tsErr(241, "Conversion failed when converting date and/or time from character string.") }
    if to == "uniqueidentifier" { return tsErr(8169, "Conversion failed when converting from a character string to uniqueidentifier.") }
    if isNum { return tsErr(8114, "Error converting data type " + from + " to numeric.") }
    if to == "float" || to == "real" { return tsErr(8114, "Error converting data type " + from + " to " + to + ".") }
    if to == "bigint" { return tsErr(8114, "Error converting data type " + from + " to bigint.") }
    if isInt { return tsErr(245, "Conversion failed when converting the " + from + " value '" + lexdb_exec.text(v) + "' to data type " + to + ".") }
    return e
}

// The first n characters of s (n bytes / 2 for an n-type), as SQL Server shows a truncated value.
fn truncText(s: &str, maxLen: int, wide: bool): str {
    let n = if maxLen <= 0 { len(s) } else if wide { maxLen / 2 } else { maxLen }
    var out: []byte = []
    var k = 0
    var i = 0
    while i < len(s) && k < n {
        var j = i + 1
        while j < len(s) && (s[j] & 0xC0) == 0x80 { j += 1 }
        appendStr(mut &out, s[i..j])
        k += 1
        i = j
    }
    return strFromBytes(&out)
}

// The first statement of ts (any depth) that writes to a table-valued
// parameter's table: SQL Server's 10700 for it (102 for TRUNCATE).
fn (st: &State) writesReadOnly(ts: &[]lexdb_tsqlparse.TStmt): Option[Caught] {
    for t in ts {
        for s in t.stmt {
            let k = s.kind
            if k == lexdb_sql.S_INSERT || k == lexdb_sql.S_UPDATE || k == lexdb_sql.S_DELETE || k == lexdb_sql.S_MERGE || k == lexdb_sql.S_TRUNCATE {
                var targets: []str = [s.table]
                for n in s.names { if k == lexdb_sql.S_TRUNCATE { append(mut &targets, n) } }
                // UPDATE x ... FROM @t x: the alias's table
                if k == lexdb_sql.S_UPDATE || k == lexdb_sql.S_DELETE {
                    for fi in s.from { if fi.alias == s.table && len(fi.table) > 0 { append(mut &targets, fi.table) } }
                }
                for x in targets {
                    for i in 0..len(st.roTables) {
                        if x == st.roTables[i] {
                            if k == lexdb_sql.S_TRUNCATE {
                                return Some(Caught{number: 102, message: "Incorrect syntax near '" + st.roParams[i] + "'.", severity: 15, state: 1})
                            }
                            return Some(Caught{number: 10700, message: "The table-valued parameter \"" + st.roParams[i] +
                                                                       "\" is READONLY and cannot be modified.", severity: 16, state: 1})
                        }
                    }
                }
            }
        }
        match st.writesReadOnly(&t.body) {
            Some(c) { return Some(c) }
            None {}
        }
        match st.writesReadOnly(&t.els) {
            Some(c) { return Some(c) }
            None {}
        }
    }
    return None
}

// sql with DECLARE @x name, name a table type, made DECLARE @x TABLE (its
// definition): a table variable of the type.
fn withTableTypes(sess: mut &lexdb_exec.Session, sql: &str): str {
    let refs = lexdb_tsqlparse.userTypeDecls(sql)
    if len(refs) == 0 { return sql.toStr() }
    var out = newStrBuf()
    var at = 0
    for r in refs {
        match sess.tableType(&r.key) {
            Ok(x) {
                match x {
                    Some(tt) {
                        out.add(sql[at..r.at])
                        out.add(&("TABLE " + tt.body))
                        at = r.end
                    }
                    None {}
                }
            }
            Err(_) {}
        }
    }
    out.add(sql[at..len(sql)])
    return out.toStr()
}

// The table-valued parameters' tables of the call just run, dropped.
pub fn dropTables(sess: mut &lexdb_exec.Session, st: mut &State) {
    while len(st.roTables) > 0 {
        let t = pop(mut &st.roTables)
        let p = pop(mut &st.roParams)
        let d = simple(sess, &("DROP TABLE IF EXISTS " + quoteName(&t)))
    }
}

// The #temporary tables a connection made, dropped (it ends, or is reset).
pub fn dropTemps(sess: mut &lexdb_exec.Session, st: mut &State) {
    if sess.status() != 'I' { let rb = simple(sess, &"ROLLBACK") }
    while len(st.temps) > 0 {
        let t = pop(mut &st.temps)
        let d = simple(sess, &("DROP TABLE IF EXISTS " + quoteName(&t)))
    }
}

// How a block's statements ended: the next goes on; BREAK, CONTINUE,
// RETURN; the batch ended (an error that ends it); an error left a TRY block.
const F_NEXT = 0
const F_BREAK = 1
const F_CONTINUE = 2
const F_RETURN = 3
const F_END = 4
const F_ERROR = 5

fn (st: mut &State) block(sess: mut &lexdb_exec.Session, ts: &[]lexdb_tsqlparse.TStmt, f: mut &Frame, ev: mut &[]Event): int {
    for t in ts {
        let r = st.one(sess, &t, f, ev)
        if r != F_NEXT { return r }
    }
    return F_NEXT
}

// IF's and WHILE's condition: 1 true, 0 not, -1 an error (its flow in fl).
fn (st: mut &State) cond(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, f: mut &Frame, ev: mut &[]Event): int {
    let oids = f.oids()
    match sess.run(s, &f.vals, &oids) {
        Ok(r) {
            if len(r.rows) > 0 && len(r.rows[0]) > 0 {
                match r.rows[0][0] {
                    Val.Int(n) { return if n == 1 { 1 } else { 0 } }
                    else {}
                }
            }
            return 0
        }
        Err(e) {
            st.failErr(ev, &e, 0)
            return -1
        }
    }
}

// The values of PRINT's, RAISERROR's and THROW's arguments; None after an error.
fn (st: mut &State) args(sess: mut &lexdb_exec.Session, s: &lexdb_sql.Stmt, f: mut &Frame, ev: mut &[]Event): Option[[]Val] {
    let oids = f.oids()
    match sess.run(s, &f.vals, &oids) {
        Ok(r0) {
            var r = r0
            if len(r.rows) > 0 { return Some(replace(mut &r.rows[0], [])) }
            return Some([])
        }
        Err(e) {
            st.failErr(ev, &e, 0)
            return None
        }
    }
}

fn intVal(v: &Val): int {
    match v {
        Val.Int(n) { return n }
        Val.Num(d) { return d.toInt(Rounding.TOWARD_ZERO).unwrapOr(0) }
        Val.Text(t) { return strings.parseIntOpt(&(strings.trim(&t))).unwrapOr(0) }
        else { return 0 }
    }
}

// RAISERROR's message: %d %i %u %s %x %X %o with the arguments, in order
// (a width or flags between are read, not used); %% a %.
fn raiseText(fmt: &str, args: &[]Val): str {
    var out = newStrBuf()
    var k = 0
    var i = 0
    while i < len(fmt) {
        let c = fmt[i]
        if c != '%' || i + 1 >= len(fmt) {
            out.addByte(c)
            i += 1
            continue
        }
        var j = i + 1
        if fmt[j] == '%' {
            out.addByte('%')
            i = j + 1
            continue
        }
        while j < len(fmt) && (fmt[j] == '-' || fmt[j] == '+' || fmt[j] == ' ' || fmt[j] == '#' || fmt[j] == '0' || (fmt[j] >= '1' && fmt[j] <= '9') || fmt[j] == '.' || fmt[j] == 'l' || fmt[j] == 'h' || fmt[j] == 'I') { j += 1 }
        if j >= len(fmt) { break }
        let t = fmt[j]
        if k < len(args) {
            let v = args[k]
            if t == 'x' || t == 'X' {
                let h = strings.hex(intVal(&v))
                let hs: str = if t == 'X' { strings.toUpperAscii(&h) } else { h }
                out.add(&hs)
            } else if t == 'd' || t == 'i' || t == 'u' {
                out.add(&(intVal(&v).toStr()))
            } else {
                let tv: str = if lexdb_exec.isNull(&v) { "(null)" } else { lexdb_exec.text(&v) }
                out.add(&tv)
            }
        } else {
            out.add("(null)")
        }
        k += 1
        i = j + 1
    }
    return out.toStr()
}

// One statement of a batch or block, and how it ended.
fn (st: mut &State) one(sess: mut &lexdb_exec.Session, t: &lexdb_tsqlparse.TStmt, f: mut &Frame, ev: mut &[]Event): int {
    st.refresh(sess, f)
    let k = t.kind
    if k == lexdb_tsqlparse.TS_BLOCK { return st.block(sess, &t.body, f, ev) }
    if k == lexdb_tsqlparse.TS_IF {
        let c = st.cond(sess, &t.stmt[0], f, ev)
        if c < 0 { return st.flowAfterError() }
        return st.block(sess, if c == 1 { &t.body } else { &t.els }, f, ev)
    }
    if k == lexdb_tsqlparse.TS_WHILE {
        while true {
            st.refresh(sess, f)
            let c = st.cond(sess, &t.stmt[0], f, ev)
            if c < 0 { return st.flowAfterError() }
            if c == 0 { break }
            let r = st.block(sess, &t.body, f, ev)
            if r == F_BREAK { break }
            if r != F_NEXT && r != F_CONTINUE { return r }
        }
        return F_NEXT
    }
    if k == lexdb_tsqlparse.TS_BREAK { return F_BREAK }
    if k == lexdb_tsqlparse.TS_CONTINUE { return F_CONTINUE }
    if k == lexdb_tsqlparse.TS_RETURN { return F_RETURN }
    if k == lexdb_tsqlparse.TS_TRY {
        st.tryDepth += 1
        let r = st.block(sess, &t.body, f, ev)
        st.tryDepth -= 1
        if r != F_ERROR { return r }
        // the CATCH block, with the error it handles
        let pc = Caught{number: st.pending.number, message: st.pending.message, severity: st.pending.severity, state: st.pending.state}
        append(mut &st.caught, pc)
        let r2 = st.block(sess, &t.els, f, ev)
        let x = pop(mut &st.caught)
        return r2
    }
    if k == lexdb_tsqlparse.TS_PRINT {
        match st.args(sess, &t.stmt[0], f, ev) {
            Some(vs) {
                let msg = if len(vs) == 0 || lexdb_exec.isNull(&vs[0]) { "" } else { lexdb_exec.text(&vs[0]) }
                caughtEv(ev, &Caught{number: 0, message: msg, severity: 0, state: 1}, EV_INFO)
                return F_NEXT
            }
            None { return st.flowAfterError() }
        }
    }
    if k == lexdb_tsqlparse.TS_RAISERROR {
        match st.args(sess, &t.stmt[0], f, ev) {
            Some(vs) {
                var rest: []Val = []
                for i in 3..len(vs) { append(mut &rest, vs[i]) }
                let msg = raiseText(&(if lexdb_exec.isNull(&vs[0]) { "" } else { lexdb_exec.text(&vs[0]) }), &rest)
                let sev = intVal(&vs[1])
                let c = Caught{number: 50000, message: msg, severity: sev, state: intVal(&vs[2])}
                if sev <= 10 {
                    caughtEv(ev, &c, EV_INFO)
                    return F_NEXT
                }
                st.failAs(ev, c, 0, false)
                return st.flowAfterError()
            }
            None { return st.flowAfterError() }
        }
    }
    if k == lexdb_tsqlparse.TS_THROW {
        var c = Caught{number: 0, message: "", severity: 16, state: 1}
        if len(t.stmt) == 0 {
            // THROW in a CATCH block: the error it handles, again
            if len(st.caught) == 0 {
                st.fail(ev, Caught{number: 10704, message: "To rethrow an error, a THROW statement must be used inside a CATCH block. Insert the THROW statement inside a CATCH block, or add error parameters to the THROW statement.", severity: 15, state: 1}, 0)
                return st.flowAfterError()
            }
            let top = &st.caught[len(st.caught) - 1]
            c = Caught{number: top.number, message: top.message, severity: top.severity, state: top.state}
        } else {
            match st.args(sess, &t.stmt[0], f, ev) {
                Some(vs) {
                    c.number = intVal(&vs[0])
                    c.message = if lexdb_exec.isNull(&vs[1]) { "" } else { lexdb_exec.text(&vs[1]) }
                    c.state = intVal(&vs[2])
                }
                None { return st.flowAfterError() }
            }
        }
        st.failAs(ev, c, 0, false)
        // THROW ends the batch (and, with XACT_ABORT, the transaction)
        if st.jump { return F_ERROR }
        if st.xactAbort && sess.status() != 'I' { let rb = simple(sess, &"ROLLBACK") }
        return F_END
    }
    if k == lexdb_tsqlparse.TS_USE || k == lexdb_tsqlparse.TS_EXECSTR || k == lexdb_tsqlparse.TS_EXEC || k == lexdb_tsqlparse.TS_INSERTEXEC {
        let before = sess.status()
        let r = st.call(sess, t, f, ev)
        st.after(sess, before, ev)
        if st.jump {
            st.jump = false
            return F_ERROR
        }
        return r
    }
    if k == lexdb_tsqlparse.TS_TABLEVAR {
        let go = st.sqlStmt(sess, &t.stmt[0], f, ev, true)
        if go && !st.jump { append(mut &st.tableVars, "#" + t.names[0]) }
        // (CREATE TABLE's DONE: a DECLARE reports none)
        if len(ev) > 0 && ev[len(ev) - 1].kind == EV_DONE && !ev[len(ev) - 1].error { let x = pop(ev) }
        if st.jump {
            st.jump = false
            return F_ERROR
        }
        return if go { F_NEXT } else { F_END }
    }
    st.committed = false
    let before = sess.status()
    let go = st.exec(sess, t, f, ev)
    st.after(sess, before, ev)
    if st.jump {
        st.jump = false
        return F_ERROR
    }
    return if go { F_NEXT } else { F_END }
}

// ---- USE and EXEC (design/lexdb-tds.md, section 13)

// USE, EXEC (string), EXEC procedure, INSERT ... EXEC, and how they ended.
fn (st: mut &State) call(sess: mut &lexdb_exec.Session, t: &lexdb_tsqlparse.TStmt, f: mut &Frame, ev: mut &[]Event): int {
    let k = t.kind
    if k == lexdb_tsqlparse.TS_USE {
        // lexdb's database (and master, taken as it, as at login); SQL
        // Server's other system databases are listed, not opened
        let n = t.names[0]
        let id = lexdb_syscat.dbId(&n, &lexdb_exec.SYS_DB_NAME)
        if id == lexdb_exec.SYS_DB_ID || id == 1 {
            var x = ev0(EV_DB)
            x.err = lexdb_base.err("", lexdb_exec.SYS_DB_NAME)
            append(ev, x)
            doneEv(ev, -1, 0, false)
            return F_NEXT
        }
        if id > 0 {
            st.fail(ev, Caught{number: 916, message: "The server principal \"" + sess.user() + "\" is not able to access the database \"" + n +
                                                     "\" under the current security context.", severity: 14, state: 1}, 0)
        } else {
            st.fail(ev, Caught{number: 911, message: "Database '" + n + "' does not exist. Make sure that the name is entered correctly.", severity: 16,
                               state: 1}, 0)
        }
        return F_NEXT
    }
    if k == lexdb_tsqlparse.TS_INSERTEXEC {
        // the procedure's rows, inserted
        var inner: []Event = []
        let r = st.call(sess, &t.body[0], f, mut &inner)
        var rows: []str = []
        for i in 0..len(inner) {
            if inner[i].kind == EV_ROWS {
                for row in inner[i].rows {
                    var vs: []str = []
                    for v in row { append(mut &vs, litOf(&v)) }
                    append(mut &rows, "(" + strings.join(&vs, ", ") + ")")
                }
            } else if inner[i].kind == EV_ERROR || inner[i].kind == EV_INFO {
                append(ev, replace(mut &inner[i], ev0(EV_DONE)))
            }
        }
        if len(rows) == 0 {
            doneEv(ev, if st.nocount { -1 } else { 0 }, CMD_INSERT, false)
            return r
        }
        var cols: []str = []
        for i in 1..len(t.names) { append(mut &cols, "[" + t.names[i] + "]") }
        let tn = t.names[0]
        let target = if strings.startsWith(&tn, "#") { tn.toStr() } else { "[" + tn + "]" }
        let sql = "INSERT INTO " + target + (if len(cols) > 0 { " (" + strings.join(&cols, ", ") + ")" } else { "" }) + " VALUES " + strings.join(&rows, ", ")
        var fr = newFrame()
        return st.nested(sess, &sql, mut &fr, ev)
    }
    // the arguments' values
    var vals: []Val = []
    if len(t.stmt) > 0 && len(t.stmt[0].items) > 0 {
        let oids = f.oids()
        match sess.run(&t.stmt[0], &f.vals, &oids) {
            Ok(r0) {
                var r = r0
                if len(r.rows) > 0 { vals = replace(mut &r.rows[0], []) }
            }
            Err(e) {
                st.failErr(ev, &e, 0)
                return if endsBatch(&e) && st.tryDepth == 0 { F_END } else { F_NEXT }
            }
        }
    }
    if k == lexdb_tsqlparse.TS_EXECSTR {
        // dynamic SQL: a batch of its own, without the caller's variables
        let sql = if len(vals) > 0 && !lexdb_exec.isNull(&vals[0]) { lexdb_exec.text(&vals[0]) } else { "" }
        var fr = newFrame()
        return st.nested(sess, &sql, mut &fr, ev)
    }
    let proc = t.names[0]
    let outs = strings.split(&t.value, "\x1f")
    if proc == "sp_executesql" {
        if len(vals) == 0 || lexdb_exec.isNull(&vals[0]) {
            st.fail(ev, Caught{number: 201, message: "Procedure or function 'sp_executesql' expects parameter '@statement', which was not supplied.",
                               severity: 16, state: 4}, 0)
            return F_NEXT
        }
        var decls: []lexdb_tsqlparse.ParamDecl = []
        if len(vals) > 1 && !lexdb_exec.isNull(&vals[1]) {
            match lexdb_tsqlparse.parseParamDecls(&lexdb_exec.text(&vals[1])) {
                Ok(ds) { decls = ds }
                Err(e) {
                    st.failErr(ev, &e, 0)
                    return F_NEXT
                }
            }
        }
        var fr = newFrame()
        st.refresh(sess, mut &fr)
        for i in 0..len(decls) {
            var v = Val.Null
            for j in 2..len(vals) {
                let pn = if 1 + j < len(t.names) { t.names[1 + j] } else { "" }
                if pn == decls[i].name || (pn == "" && j - 2 == i) { v = vals[j] }
            }
            match lexdb_exec.coerce(v, &decls[i].typ) {
                Ok(cv) { let x = fr.add(&decls[i].name, decls[i].typ, cv) }
                Err(e) {
                    st.failErr(ev, &e, 0)
                    return F_NEXT
                }
            }
        }
        let r = st.nested(sess, &lexdb_exec.text(&vals[0]), mut &fr, ev)
        // OUTPUT parameters back to the caller's variables
        for j in 2..len(vals) {
            if j >= len(outs) || len(outs[j]) == 0 { continue }
            let pn = if 1 + j < len(t.names) && len(t.names[1 + j]) > 0 { t.names[1 + j] } else if j - 2 < len(decls) { decls[j - 2].name } else { "" }
            let kf = fr.find(&pn)
            let ko = f.find(&outs[j])
            if kf < 0 || ko < 0 { continue }
            match lexdb_exec.coerce(fr.vals[kf], &f.types[ko]) {
                Ok(cv) { f.vals[ko] = cv }
                Err(_) {}
            }
        }
        return r
    }
    if proc == "xp_instance_regread" || proc == "xp_regread" {
        // lexdb has no registry: an OUTPUT argument is NULL
        for j in 0..len(outs) {
            if len(outs[j]) == 0 { continue }
            let ko = f.find(&outs[j])
            if ko >= 0 { f.vals[ko] = Val.Null }
        }
        doneEv(ev, -1, 0, false)
        return F_NEXT
    }
    if proc == "sp_tablecollations_100" || proc == "sp_tablecollations_90" || proc == "sp_tablecollations" {
        // a table's columns' collations (SqlBulkCopy's): none for no such table
        var x = tableCollations(&[])
        if len(vals) > 0 && !lexdb_exec.isNull(&vals[0]) {
            match tableArg(&lexdb_exec.text(&vals[0])) {
                Ok(name) {
                    match sess.tableDecl(&name) {
                        Ok(cols) { x = tableCollations(&cols) }
                        Err(_) {}
                    }
                }
                Err(_) {}
            }
        }
        let n = len(x.rows)
        append(ev, x)
        doneEv(ev, if st.nocount { -1 } else { n }, CMD_SELECT, false)
        return F_NEXT
    }
    if proc == "sp_describe_first_result_set" {
        let sql = if len(vals) > 0 && !lexdb_exec.isNull(&vals[0]) { lexdb_exec.text(&vals[0]) } else { "" }
        let none: []lexdb_tsqlparse.ParamDecl = []
        match describeFirst(sess, st, &sql, &none) {
            Ok(cols) {
                let x = describeRows(&cols)
                let n = len(x.rows)
                append(ev, x)
                doneEv(ev, if st.nocount { -1 } else { n }, CMD_SELECT, false)
            }
            Err(e) { st.failErr(ev, &e, 0) }
        }
        return F_NEXT
    }
    if proc == "xp_msver" {
        var x = ev0(EV_ROWS)
        x.cols = [outCol(&"Index", lexdb_sql.OID_INT4), outCol(&"Name", lexdb_sql.OID_TEXT), outCol(&"Internal_Value", lexdb_sql.OID_INT4),
                  outCol(&"Character_Value", lexdb_sql.OID_TEXT)]
        for i in 0..len(MSVER) {
            let p = strings.split(&MSVER[i], "|")
            append(mut &x.rows, [Val.Int(i + 1), Val.Text(p[0].toStr()), if len(p[1]) == 0 { Val.Null } else { Val.Int(strings.parseIntOpt(&p[1]).unwrapOr(0)) },
                                 if len(p[2]) == 0 { Val.Null } else { Val.Text(p[2].toStr()) }])
        }
        let n = len(x.rows)
        append(ev, x)
        doneEv(ev, if st.nocount { -1 } else { n }, CMD_SELECT, false)
        return F_NEXT
    }
    let cat = catalogProcSql(&proc, &vals, &t.names)
    if len(cat) > 0 {
        var fr = newFrame()
        return st.nested(sess, &cat, mut &fr, ev)
    }
    st.fail(ev, Caught{number: 2812, message: "Could not find stored procedure '" + proc + "'.", severity: 16, state: 62}, 0)
    return if st.tryDepth > 0 { F_NEXT } else { F_END }
}

// ---- the catalog procedures a driver calls for its metadata (mssql-jdbc's DatabaseMetaData: sp_tables, sp_columns_100,
// sp_pkeys, sp_fkeys, sp_statistics_100, sp_special_columns_100, sp_stored_procedures, sp_sproc_columns_100,
// sp_datatype_info_100, sp_table_privileges, sp_column_privileges): each the SELECT that gives SQL Server's columns of the
// same answer from lexdb's sys views. Their arguments: by name (@table_name = ...) or by place.

// The argument named name (or at place pos, among those without a name) of a call: the SQL literal for it, "NULL" if none or NULL.
fn argLit(vals: &[]Val, names: &[]str, name: str, pos: int): str {
    for j in 0..len(vals) {
        let pn = if 1 + j < len(names) { names[1 + j] } else { "" }
        if (len(pn) > 0 && strings.toLowerAscii(&pn) == name) || (len(pn) == 0 && j == pos) {
            if lexdb_exec.isNull(&vals[j]) { return "NULL" }
            return litOf(&vals[j])
        }
    }
    return "NULL"
}

// "col LIKE lit" for a pattern argument, nothing for NULL (an empty owner or name matches nothing but a blank, as SQL Server's).
fn likeCond(col: str, lit: str): str {
    if lit == "NULL" { return "" }
    return " AND " + col + " LIKE " + lit
}

// The JDBC/ODBC SQL type code of a system type's name.
const SQLTYPE_CASE: str = "CASE ty.name WHEN 'int' THEN 4 WHEN 'bigint' THEN -5 WHEN 'smallint' THEN 5 WHEN 'tinyint' THEN -6 WHEN 'bit' THEN -7 " +
    "WHEN 'decimal' THEN 3 WHEN 'numeric' THEN 2 WHEN 'money' THEN 3 WHEN 'smallmoney' THEN 3 WHEN 'float' THEN 6 WHEN 'real' THEN 7 " +
    "WHEN 'varchar' THEN 12 WHEN 'char' THEN 1 WHEN 'nvarchar' THEN -9 WHEN 'nchar' THEN -15 WHEN 'text' THEN -1 WHEN 'ntext' THEN -16 " +
    "WHEN 'datetime' THEN 93 WHEN 'smalldatetime' THEN 93 WHEN 'datetime2' THEN 93 WHEN 'date' THEN 91 WHEN 'time' THEN 92 " +
    "WHEN 'datetimeoffset' THEN -155 WHEN 'varbinary' THEN -3 WHEN 'binary' THEN -2 WHEN 'image' THEN -4 WHEN 'uniqueidentifier' THEN 1 " +
    "WHEN 'xml' THEN -152 WHEN 'sql_variant' THEN -150 WHEN 'timestamp' THEN -2 WHEN 'sysname' THEN -9 ELSE 12 END"

// The column size (ODBC's PRECISION) of a column c of type ty.
const SIZE_CASE: str = "CASE WHEN ty.name IN ('char', 'varchar', 'binary', 'varbinary') THEN CASE WHEN c.max_length < 0 THEN 2147483647 ELSE c.max_length END " +
    "WHEN ty.name IN ('nchar', 'nvarchar') THEN CASE WHEN c.max_length < 0 THEN 1073741823 ELSE c.max_length / 2 END " +
    "WHEN ty.name IN ('decimal', 'numeric') THEN c.precision WHEN ty.name = 'int' THEN 10 WHEN ty.name = 'bigint' THEN 19 WHEN ty.name = 'smallint' THEN 5 " +
    "WHEN ty.name = 'tinyint' THEN 3 WHEN ty.name = 'bit' THEN 1 WHEN ty.name = 'float' THEN 15 WHEN ty.name = 'real' THEN 7 " +
    "WHEN ty.name = 'money' THEN 19 WHEN ty.name = 'smallmoney' THEN 10 WHEN ty.name = 'datetime' THEN 23 WHEN ty.name = 'smalldatetime' THEN 16 " +
    "WHEN ty.name = 'date' THEN 10 WHEN ty.name = 'time' THEN CASE WHEN c.scale > 0 THEN 9 + c.scale ELSE 8 END " +
    "WHEN ty.name = 'datetime2' THEN CASE WHEN c.scale > 0 THEN 20 + c.scale ELSE 19 END " +
    "WHEN ty.name = 'datetimeoffset' THEN CASE WHEN c.scale > 0 THEN 27 + c.scale ELSE 26 END WHEN ty.name = 'uniqueidentifier' THEN 36 " +
    "WHEN ty.name IN ('text', 'ntext', 'image', 'xml') THEN 2147483647 ELSE c.max_length END"

// sp_datatype_info_100: SQL Server 2022's own rows (mssql-jdbc's getTypeInfo).
const DATATYPE_INFO_SQL: str = "SELECT TYPE_NAME = CONVERT(nvarchar(128), 'datetimeoffset'), DATA_TYPE = CONVERT(smallint, -155), PRECISION = CONVERT(int, 34), LITERAL_PREFIX = CONVERT(varchar(32), ''''), LITERAL_SUFFIX = CONVERT(varchar(32), ''''), CREATE_PARAMS = CONVERT(varchar(32), 'scale'), NULLABLE = CONVERT(smallint, 1), CASE_SENSITIVE = CONVERT(smallint, 0), SEARCHABLE = CONVERT(smallint, 3), UNSIGNED_ATTRIBUTE = CONVERT(smallint, NULL), FIXED_PREC_SCALE = CONVERT(smallint, 0), AUTO_INCREMENT = CONVERT(smallint, NULL), LOCAL_TYPE_NAME = CONVERT(nvarchar(128), 'datetimeoffset'), MINIMUM_SCALE = CONVERT(smallint, 0), MAXIMUM_SCALE = CONVERT(smallint, 7), SQL_DATA_TYPE = CONVERT(smallint, -155), SQL_DATETIME_SUB = CONVERT(smallint, 0), NUM_PREC_RADIX = CONVERT(int, NULL), INTERVAL_PRECISION = CONVERT(smallint, NULL), USERTYPE = CONVERT(smallint, 0) UNION ALL SELECT 'time', 92, 16, '''', '''', 'scale', 1, 0, 3, NULL, 0, NULL, 'time', 0, 7, -154, 0, NULL, NULL, 0 UNION ALL SELECT 'xml', -16, 0, 'N''', '''', NULL, 1, 1, 0, NULL, 0, NULL, 'xml', NULL, NULL, -152, NULL, NULL, NULL, 0 UNION ALL SELECT 'sql_variant', -150, 8000, NULL, NULL, NULL, 1, 0, 2, NULL, 0, NULL, 'sql_variant', 0, 0, -150, NULL, 10, NULL, 0 UNION ALL SELECT 'uniqueidentifier', 1, 36, '''', '''', NULL, 1, 0, 2, NULL, 0, NULL, 'uniqueidentifier', NULL, NULL, -11, NULL, NULL, NULL, 0 UNION ALL SELECT 'ntext', -16, 1073741823, 'N''', '''', NULL, 1, 0, 1, NULL, 0, NULL, 'ntext', NULL, NULL, -10, NULL, NULL, NULL, 0 UNION ALL SELECT 'nvarchar', -9, 4000, 'N''', '''', 'max length', 1, 0, 3, NULL, 0, NULL, 'nvarchar', NULL, NULL, -9, NULL, NULL, NULL, 0 UNION ALL SELECT 'sysname', -9, 128, 'N''', '''', NULL, 0, 0, 3, NULL, 0, NULL, 'sysname', NULL, NULL, -9, NULL, NULL, NULL, 18 UNION ALL SELECT 'nchar', -15, 4000, 'N''', '''', 'length', 1, 0, 3, NULL, 0, NULL, 'nchar', NULL, NULL, -8, NULL, NULL, NULL, 0 UNION ALL SELECT 'bit', -7, 1, NULL, NULL, NULL, 1, 0, 2, NULL, 0, NULL, 'bit', 0, 0, -7, NULL, NULL, NULL, 16 UNION ALL SELECT 'tinyint', -6, 3, NULL, NULL, NULL, 1, 0, 2, 1, 0, 0, 'tinyint', 0, 0, -6, NULL, 10, NULL, 5 UNION ALL SELECT 'tinyint identity', -6, 3, NULL, NULL, NULL, 0, 0, 2, 1, 0, 1, 'tinyint identity', 0, 0, -6, NULL, 10, NULL, 5 UNION ALL SELECT 'bigint', -5, 19, NULL, NULL, NULL, 1, 0, 2, 0, 0, 0, 'bigint', 0, 0, -5, NULL, 10, NULL, 0 UNION ALL SELECT 'bigint identity', -5, 19, NULL, NULL, NULL, 0, 0, 2, 0, 0, 1, 'bigint identity', 0, 0, -5, NULL, 10, NULL, 0 UNION ALL SELECT 'image', -4, 2147483647, '0x', NULL, NULL, 1, 0, 0, NULL, 0, NULL, 'image', NULL, NULL, -4, NULL, NULL, NULL, 20 UNION ALL SELECT 'varbinary', -3, 8000, '0x', NULL, 'max length', 1, 0, 2, NULL, 0, NULL, 'varbinary', NULL, NULL, -3, NULL, NULL, NULL, 4 UNION ALL SELECT 'binary', -2, 8000, '0x', NULL, 'length', 1, 0, 2, NULL, 0, NULL, 'binary', NULL, NULL, -2, NULL, NULL, NULL, 3 UNION ALL SELECT 'timestamp', -2, 8, '0x', NULL, NULL, 0, 0, 2, NULL, 0, NULL, 'timestamp', NULL, NULL, -2, NULL, NULL, NULL, 80 UNION ALL SELECT 'text', -1, 2147483647, '''', '''', NULL, 1, 0, 1, NULL, 0, NULL, 'text', NULL, NULL, -1, NULL, NULL, NULL, 19 UNION ALL SELECT 'char', 1, 8000, '''', '''', 'length', 1, 0, 3, NULL, 0, NULL, 'char', NULL, NULL, 1, NULL, NULL, NULL, 1 UNION ALL SELECT 'numeric', 2, 38, NULL, NULL, 'precision,scale', 1, 0, 2, 0, 0, 0, 'numeric', 0, 38, 2, NULL, 10, NULL, 10 UNION ALL SELECT 'numeric() identity', 2, 38, NULL, NULL, 'precision', 0, 0, 2, 0, 0, 1, 'numeric() identity', 0, 0, 2, NULL, 10, NULL, 10 UNION ALL SELECT 'decimal', 3, 38, NULL, NULL, 'precision,scale', 1, 0, 2, 0, 0, 0, 'decimal', 0, 38, 3, NULL, 10, NULL, 24 UNION ALL SELECT 'money', 3, 19, '$', NULL, NULL, 1, 0, 2, 0, 1, 0, 'money', 4, 4, 3, NULL, 10, NULL, 11 UNION ALL SELECT 'smallmoney', 3, 10, '$', NULL, NULL, 1, 0, 2, 0, 1, 0, 'smallmoney', 4, 4, 3, NULL, 10, NULL, 21 UNION ALL SELECT 'decimal() identity', 3, 38, NULL, NULL, 'precision', 0, 0, 2, 0, 0, 1, 'decimal() identity', 0, 0, 3, NULL, 10, NULL, 24 UNION ALL SELECT 'int', 4, 10, NULL, NULL, NULL, 1, 0, 2, 0, 0, 0, 'int', 0, 0, 4, NULL, 10, NULL, 7 UNION ALL SELECT 'int identity', 4, 10, NULL, NULL, NULL, 0, 0, 2, 0, 0, 1, 'int identity', 0, 0, 4, NULL, 10, NULL, 7 UNION ALL SELECT 'smallint', 5, 5, NULL, NULL, NULL, 1, 0, 2, 0, 0, 0, 'smallint', 0, 0, 5, NULL, 10, NULL, 6 UNION ALL SELECT 'smallint identity', 5, 5, NULL, NULL, NULL, 0, 0, 2, 0, 0, 1, 'smallint identity', 0, 0, 5, NULL, 10, NULL, 6 UNION ALL SELECT 'float', 8, 53, NULL, NULL, NULL, 1, 0, 2, 0, 0, 0, 'float', NULL, NULL, 6, NULL, 2, NULL, 8 UNION ALL SELECT 'real', 7, 24, NULL, NULL, NULL, 1, 0, 2, 0, 0, 0, 'real', NULL, NULL, 7, NULL, 2, NULL, 23 UNION ALL SELECT 'varchar', 12, 8000, '''', '''', 'max length', 1, 0, 3, NULL, 0, NULL, 'varchar', NULL, NULL, 12, NULL, NULL, NULL, 2 UNION ALL SELECT 'date', 91, 10, '''', '''', NULL, 1, 0, 3, NULL, 0, NULL, 'date', NULL, 0, 9, 1, NULL, NULL, 0 UNION ALL SELECT 'datetime2', 93, 27, '''', '''', 'scale', 1, 0, 3, NULL, 0, NULL, 'datetime2', 0, 7, 9, 3, NULL, NULL, 0 UNION ALL SELECT 'datetime', 93, 23, '''', '''', NULL, 1, 0, 3, NULL, 0, NULL, 'datetime', 3, 3, 9, 3, NULL, NULL, 12 UNION ALL SELECT 'smalldatetime', 93, 16, '''', '''', NULL, 1, 0, 3, NULL, 0, NULL, 'smalldatetime', 0, 0, 9, 3, NULL, NULL, 22"

fn catalogProcSql(proc: &str, vals: &[]Val, names: &[]str): str {
    let p = strings.toLowerAscii(proc)
    let db = "db_name()"
    if p == "sp_tables" {
        let nm = argLit(vals, names, "@table_name", 0)
        let ow = argLit(vals, names, "@table_owner", 1)
        let tt = argLit(vals, names, "@table_type", 3)
        var cond = likeCond("o.name", nm) + likeCond("schema_name(o.schema_id)", ow)
        if tt != "NULL" {
            var kinds: []str = []
            let up = strings.toUpperAscii(&tt)
            if strings.contains(&up, "TABLE") && !strings.contains(&up, "SYSTEM TABLE") { append(mut &kinds, "'U'") }
            if strings.contains(&up, "SYSTEM TABLE") { append(mut &kinds, "'S'") }
            if strings.contains(&up, "VIEW") { append(mut &kinds, "'V'") }
            if len(kinds) == 0 { append(mut &kinds, "'~'") }
            cond = cond + " AND o.type IN (" + strings.join(&kinds, ", ") + ")"
        }
        return "SELECT TABLE_QUALIFIER = CONVERT(sysname, " + db + "), TABLE_OWNER = CONVERT(sysname, schema_name(o.schema_id)), TABLE_NAME = CONVERT(sysname, o.name), " +
               "TABLE_TYPE = CONVERT(varchar(32), CASE o.type WHEN 'U' THEN 'TABLE' WHEN 'V' THEN 'VIEW' ELSE 'SYSTEM TABLE' END), REMARKS = CONVERT(varchar(254), NULL) " +
               "FROM sys.all_objects o WHERE o.type IN ('U', 'V', 'S')" + cond + " ORDER BY 4, 2, 3"
    }
    if strings.startsWith(&p, "sp_columns") {
        let nm = argLit(vals, names, "@table_name", 0)
        let ow = argLit(vals, names, "@table_owner", 1)
        let cn = argLit(vals, names, "@column_name", 3)
        let cond = likeCond("o.name", nm) + likeCond("schema_name(o.schema_id)", ow) + likeCond("c.name", cn)
        return "SELECT TABLE_QUALIFIER = CONVERT(sysname, " + db + "), TABLE_OWNER = CONVERT(sysname, schema_name(o.schema_id)), TABLE_NAME = CONVERT(sysname, o.name), " +
               "COLUMN_NAME = CONVERT(sysname, c.name), DATA_TYPE = CONVERT(smallint, " + SQLTYPE_CASE + "), " +
               "TYPE_NAME = CONVERT(sysname, ty.name + CASE WHEN c.is_identity = 1 THEN ' identity' ELSE '' END), PRECISION = CONVERT(int, " + SIZE_CASE + "), " +
               "LENGTH = CONVERT(int, CASE WHEN ty.name IN ('decimal', 'numeric') THEN c.precision + 2 WHEN ty.name = 'datetime2' THEN 16 WHEN ty.name = 'datetimeoffset' THEN 20 " +
               "WHEN ty.name = 'time' THEN 12 WHEN ty.name = 'date' THEN 6 WHEN ty.name IN ('nchar', 'nvarchar') THEN c.max_length ELSE CASE WHEN c.max_length < 0 THEN 2147483647 ELSE c.max_length END END), " +
               "SCALE = CONVERT(smallint, CASE WHEN ty.name IN ('decimal', 'numeric', 'datetime2', 'datetimeoffset', 'time') THEN c.scale " +
               "WHEN ty.name IN ('int', 'bigint', 'smallint', 'tinyint', 'money', 'smallmoney') THEN CASE WHEN ty.name IN ('money') THEN 4 WHEN ty.name = 'smallmoney' THEN 4 ELSE 0 END ELSE NULL END), " +
               "RADIX = CONVERT(smallint, CASE WHEN ty.name IN ('decimal', 'numeric', 'int', 'bigint', 'smallint', 'tinyint', 'money', 'smallmoney') THEN 10 WHEN ty.name IN ('float', 'real') THEN 2 ELSE NULL END), " +
               "NULLABLE = CONVERT(smallint, c.is_nullable), REMARKS = CONVERT(varchar(254), NULL), COLUMN_DEF = CONVERT(nvarchar(4000), NULL), " +
               "SQL_DATA_TYPE = CONVERT(smallint, CASE WHEN ty.name IN ('datetime2', 'datetimeoffset', 'time', 'date', 'datetime', 'smalldatetime') THEN 9 ELSE " + SQLTYPE_CASE + " END), " +
               "SQL_DATETIME_SUB = CONVERT(smallint, CASE WHEN ty.name IN ('datetime2', 'datetimeoffset', 'time', 'datetime', 'smalldatetime') THEN 3 WHEN ty.name = 'date' THEN 1 ELSE NULL END), " +
               "CHAR_OCTET_LENGTH = CONVERT(int, CASE WHEN ty.name IN ('char', 'varchar', 'nchar', 'nvarchar', 'binary', 'varbinary') THEN CASE WHEN c.max_length < 0 THEN 2147483647 ELSE c.max_length END ELSE NULL END), " +
               "ORDINAL_POSITION = CONVERT(int, c.column_id), IS_NULLABLE = CONVERT(varchar(254), CASE WHEN c.is_nullable = 1 THEN 'YES' ELSE 'NO' END), " +
               "SS_IS_SPARSE = CONVERT(smallint, 0), SS_IS_COLUMN_SET = CONVERT(smallint, 0), SS_IS_COMPUTED = CONVERT(smallint, c.is_computed), SS_IS_IDENTITY = CONVERT(smallint, c.is_identity), " +
               "SS_UDT_CATALOG_NAME = CONVERT(nvarchar(128), NULL), SS_UDT_SCHEMA_NAME = CONVERT(nvarchar(128), NULL), SS_UDT_ASSEMBLY_TYPE_NAME = CONVERT(nvarchar(max), NULL), " +
               "SS_XML_SCHEMACOLLECTION_CATALOG_NAME = CONVERT(nvarchar(128), NULL), SS_XML_SCHEMACOLLECTION_SCHEMA_NAME = CONVERT(nvarchar(128), NULL), " +
               "SS_XML_SCHEMACOLLECTION_NAME = CONVERT(nvarchar(128), NULL), SS_DATA_TYPE = CONVERT(tinyint, CASE WHEN ty.name = 'int' THEN CASE WHEN c.is_nullable = 1 THEN 38 ELSE 56 END " +
               "WHEN ty.name IN ('varchar') THEN 39 WHEN ty.name IN ('decimal') THEN 106 WHEN ty.name IN ('numeric') THEN 108 WHEN ty.name = 'datetime2' THEN 0 ELSE c.system_type_id END) " +
               "FROM sys.all_columns c JOIN sys.all_objects o ON o.object_id = c.object_id JOIN sys.types ty ON ty.user_type_id = c.user_type_id " +
               "WHERE o.type IN ('U', 'V', 'S')" + cond + " ORDER BY 2, 3, c.column_id"
    }
    if p == "sp_pkeys" {
        let nm = argLit(vals, names, "@table_name", 0)
        let ow = argLit(vals, names, "@table_owner", 1)
        var cond = ""
        if nm != "NULL" { cond = cond + " AND o.name = " + nm }
        if ow != "NULL" { cond = cond + " AND schema_name(o.schema_id) = " + ow }
        return "SELECT TABLE_QUALIFIER = CONVERT(sysname, " + db + "), TABLE_OWNER = CONVERT(sysname, schema_name(o.schema_id)), TABLE_NAME = CONVERT(sysname, o.name), " +
               "COLUMN_NAME = CONVERT(sysname, c.name), KEY_SEQ = CONVERT(smallint, ic.key_ordinal), PK_NAME = CONVERT(sysname, i.name) " +
               "FROM sys.indexes i JOIN sys.index_columns ic ON ic.object_id = i.object_id AND ic.index_id = i.index_id " +
               "JOIN sys.columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id JOIN sys.objects o ON o.object_id = i.object_id " +
               "WHERE i.is_primary_key = 1" + cond + " ORDER BY 3, ic.key_ordinal"
    }
    if p == "sp_fkeys" {
        let pn = argLit(vals, names, "@pktable_name", 0)
        let po = argLit(vals, names, "@pktable_owner", 1)
        let fn2 = argLit(vals, names, "@fktable_name", 3)
        let fo = argLit(vals, names, "@fktable_owner", 4)
        var cond = ""
        if pn != "NULL" { cond = cond + " AND po.name = " + pn }
        if po != "NULL" { cond = cond + " AND schema_name(po.schema_id) = " + po }
        if fn2 != "NULL" { cond = cond + " AND fo.name = " + fn2 }
        if fo != "NULL" { cond = cond + " AND schema_name(fo.schema_id) = " + fo }
        return "SELECT PKTABLE_QUALIFIER = CONVERT(sysname, " + db + "), PKTABLE_OWNER = CONVERT(sysname, schema_name(po.schema_id)), PKTABLE_NAME = CONVERT(sysname, po.name), " +
               "PKCOLUMN_NAME = CONVERT(sysname, pc.name), FKTABLE_QUALIFIER = CONVERT(sysname, " + db + "), FKTABLE_OWNER = CONVERT(sysname, schema_name(fo.schema_id)), " +
               "FKTABLE_NAME = CONVERT(sysname, fo.name), FKCOLUMN_NAME = CONVERT(sysname, fc.name), KEY_SEQ = CONVERT(smallint, k.constraint_column_id), " +
               "UPDATE_RULE = CONVERT(smallint, CASE f.update_referential_action WHEN 0 THEN 1 WHEN 1 THEN 0 ELSE f.update_referential_action END), " +
               "DELETE_RULE = CONVERT(smallint, CASE f.delete_referential_action WHEN 0 THEN 1 WHEN 1 THEN 0 ELSE f.delete_referential_action END), " +
               "FK_NAME = CONVERT(sysname, f.name), PK_NAME = CONVERT(sysname, pi.name), DEFERRABILITY = CONVERT(smallint, 7) " +
               "FROM sys.foreign_keys f JOIN sys.foreign_key_columns k ON k.constraint_object_id = f.object_id JOIN sys.objects po ON po.object_id = f.referenced_object_id " +
               "JOIN sys.objects fo ON fo.object_id = f.parent_object_id JOIN sys.columns pc ON pc.object_id = k.referenced_object_id AND pc.column_id = k.referenced_column_id " +
               "JOIN sys.columns fc ON fc.object_id = k.parent_object_id AND fc.column_id = k.parent_column_id " +
               "LEFT JOIN sys.indexes pi ON pi.object_id = f.referenced_object_id AND pi.index_id = f.key_index_id WHERE 1 = 1" + cond +
               " ORDER BY 3, 7, 12, k.constraint_column_id"
    }
    if p == "sp_statistics" || p == "sp_statistics_100" {
        let nm = argLit(vals, names, "@table_name", 0)
        let ow = argLit(vals, names, "@table_owner", 1)
        let un = argLit(vals, names, "@is_unique", 4)
        var cond = ""
        if nm != "NULL" { cond = cond + " AND o.name = " + nm }
        if ow != "NULL" { cond = cond + " AND schema_name(o.schema_id) = " + ow }
        var cond2 = cond
        if un == "'Y'" || un == "N'Y'" { cond2 = cond2 + " AND i.is_unique = 1" }
        return "SELECT TABLE_QUALIFIER = CONVERT(sysname, " + db + "), TABLE_OWNER = CONVERT(sysname, schema_name(o.schema_id)), TABLE_NAME = CONVERT(sysname, o.name), " +
               "NON_UNIQUE = CONVERT(smallint, NULL), INDEX_QUALIFIER = CONVERT(sysname, NULL), INDEX_NAME = CONVERT(sysname, NULL), TYPE = CONVERT(smallint, 0), " +
               "SEQ_IN_INDEX = CONVERT(smallint, NULL), COLUMN_NAME = CONVERT(sysname, NULL), COLLATION = CONVERT(char(1), NULL), CARDINALITY = CONVERT(int, 0), " +
               "PAGES = CONVERT(int, 0), FILTER_CONDITION = CONVERT(varchar(128), NULL) FROM sys.objects o WHERE o.type IN ('U', 'V')" + cond +
               " UNION ALL " +
               "SELECT CONVERT(sysname, " + db + "), CONVERT(sysname, schema_name(o.schema_id)), CONVERT(sysname, o.name), CONVERT(smallint, CASE WHEN i.is_unique = 1 THEN 0 ELSE 1 END), " +
               "CONVERT(sysname, o.name), CONVERT(sysname, i.name), CONVERT(smallint, CASE WHEN i.type = 1 THEN 1 ELSE 3 END), CONVERT(smallint, ic.key_ordinal), " +
               "CONVERT(sysname, c.name), CONVERT(char(1), CASE WHEN ic.is_descending_key = 1 THEN 'D' ELSE 'A' END), CONVERT(int, CASE WHEN i.type = 1 THEN 0 ELSE NULL END), CONVERT(int, CASE WHEN i.type = 1 THEN 0 ELSE NULL END), CONVERT(varchar(128), NULL) " +
               "FROM sys.indexes i JOIN sys.index_columns ic ON ic.object_id = i.object_id AND ic.index_id = i.index_id AND ic.key_ordinal > 0 " +
               "JOIN sys.columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id JOIN sys.objects o ON o.object_id = i.object_id " +
               "WHERE i.type > 0" + cond2 + " ORDER BY 4, 7, 6, 8"
    }
    if strings.startsWith(&p, "sp_special_columns") {
        let nm = argLit(vals, names, "@table_name", 0)
        let ow = argLit(vals, names, "@table_owner", 1)
        let ct = argLit(vals, names, "@col_type", 3)
        var cond = ""
        if nm != "NULL" { cond = cond + " AND o.name = " + nm }
        if ow != "NULL" { cond = cond + " AND schema_name(o.schema_id) = " + ow }
        if ct == "'V'" || ct == "N'V'" { cond = cond + " AND 1 = 0" }       // version columns: lexdb has none
        return "SELECT SCOPE = CONVERT(smallint, 1), COLUMN_NAME = CONVERT(sysname, c.name), DATA_TYPE = CONVERT(smallint, " + SQLTYPE_CASE + "), " +
               "TYPE_NAME = CONVERT(sysname, ty.name), PRECISION = CONVERT(int, " + SIZE_CASE + "), LENGTH = CONVERT(int, c.max_length), " +
               "SCALE = CONVERT(smallint, CASE WHEN ty.name IN ('decimal', 'numeric') THEN c.scale WHEN ty.name IN ('int', 'bigint', 'smallint', 'tinyint') THEN 0 ELSE NULL END), PSEUDO_COLUMN = CONVERT(smallint, 1) " +
               "FROM sys.indexes i JOIN sys.index_columns ic ON ic.object_id = i.object_id AND ic.index_id = i.index_id " +
               "JOIN sys.columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id JOIN sys.types ty ON ty.user_type_id = c.user_type_id " +
               "JOIN sys.objects o ON o.object_id = i.object_id WHERE i.is_primary_key = 1" + cond + " ORDER BY ic.key_ordinal"
    }
    if strings.startsWith(&p, "sp_datatype_info") { return DATATYPE_INFO_SQL }
    if p == "sp_stored_procedures" {
        return "SELECT PROCEDURE_QUALIFIER = CONVERT(sysname, " + db + "), PROCEDURE_OWNER = CONVERT(sysname, NULL), PROCEDURE_NAME = CONVERT(nvarchar(134), NULL), " +
               "NUM_INPUT_PARAMS = CONVERT(int, NULL), NUM_OUTPUT_PARAMS = CONVERT(int, NULL), NUM_RESULT_SETS = CONVERT(int, NULL), REMARKS = CONVERT(varchar(254), NULL), " +
               "PROCEDURE_TYPE = CONVERT(smallint, NULL) WHERE 1 = 0"
    }
    if p == "sp_sproc_columns" || p == "sp_sproc_columns_100" {
        return "SELECT PROCEDURE_QUALIFIER = CONVERT(sysname, " + db + "), PROCEDURE_OWNER = CONVERT(sysname, NULL), PROCEDURE_NAME = CONVERT(nvarchar(134), NULL), " +
               "COLUMN_NAME = CONVERT(sysname, NULL), COLUMN_TYPE = CONVERT(smallint, NULL), DATA_TYPE = CONVERT(smallint, NULL), TYPE_NAME = CONVERT(sysname, NULL), " +
               "PRECISION = CONVERT(int, NULL), LENGTH = CONVERT(int, NULL), SCALE = CONVERT(smallint, NULL), RADIX = CONVERT(smallint, NULL), NULLABLE = CONVERT(smallint, NULL), " +
               "REMARKS = CONVERT(varchar(254), NULL), COLUMN_DEF = CONVERT(nvarchar(4000), NULL), SQL_DATA_TYPE = CONVERT(smallint, NULL), SQL_DATETIME_SUB = CONVERT(smallint, NULL), " +
               "CHAR_OCTET_LENGTH = CONVERT(int, NULL), ORDINAL_POSITION = CONVERT(int, NULL), IS_NULLABLE = CONVERT(varchar(254), NULL), SS_TYPE_CATALOG_NAME = CONVERT(nvarchar(128), NULL), " +
               "SS_TYPE_SCHEMA_NAME = CONVERT(nvarchar(128), NULL), SS_UDT_CATALOG_NAME = CONVERT(nvarchar(128), NULL), SS_UDT_SCHEMA_NAME = CONVERT(nvarchar(128), NULL), " +
               "SS_UDT_ASSEMBLY_TYPE_NAME = CONVERT(nvarchar(max), NULL), SS_XML_SCHEMACOLLECTION_CATALOG_NAME = CONVERT(nvarchar(128), NULL), " +
               "SS_XML_SCHEMACOLLECTION_SCHEMA_NAME = CONVERT(nvarchar(128), NULL), SS_XML_SCHEMACOLLECTION_NAME = CONVERT(nvarchar(128), NULL), SS_DATA_TYPE = CONVERT(tinyint, NULL) WHERE 1 = 0"
    }
    if p == "sp_table_privileges" || p == "sp_column_privileges" {
        let col = p == "sp_column_privileges"
        let nm = argLit(vals, names, "@table_name", 0)
        let ow = argLit(vals, names, "@table_owner", 1)
        var cond = ""
        if nm != "NULL" { cond = cond + " AND o.name = " + nm }
        if ow != "NULL" { cond = cond + " AND schema_name(o.schema_id) = " + ow }
        if col { cond = cond + likeCond("c.name", argLit(vals, names, "@column_name", 3)) }
        return "SELECT TABLE_QUALIFIER = CONVERT(sysname, " + db + "), TABLE_OWNER = CONVERT(sysname, schema_name(o.schema_id)), TABLE_NAME = CONVERT(sysname, o.name), " +
               (if col { "COLUMN_NAME = CONVERT(sysname, c.name), " } else { "" }) + "GRANTOR = CONVERT(sysname, 'dbo'), GRANTEE = CONVERT(sysname, 'dbo'), " +
               "PRIVILEGE = CONVERT(varchar(32), pv.p), IS_GRANTABLE = CONVERT(varchar(3), 'YES') FROM sys.objects o " +
               (if col { "JOIN sys.columns c ON c.object_id = o.object_id " } else { "" }) +
               "CROSS JOIN (SELECT 'DELETE' p UNION ALL SELECT 'INSERT' UNION ALL SELECT 'REFERENCES' UNION ALL SELECT 'SELECT' UNION ALL SELECT 'UPDATE') pv " +
               (if col { "" } else { "" }) +
               "WHERE o.type IN ('U', 'V')" + (if col { " AND pv.p <> 'DELETE'" } else { "" }) + cond + " ORDER BY 3, " + (if col { "4, " } else { "" }) + "pv.p"
    }
    return ""
}

// xp_msver's rows, as SQL Server 2022's: name|internal value|character value.
const MSVER: []str = ["ProductName||Microsoft SQL Server", "ProductVersion|1048576|16.0.4315.2", "Language||English", "Platform||NT x64",
                      "Comments||SQL", "CompanyName||Microsoft Corporation", "FileDescription||SQL Server Windows NT - 64 Bit",
                      "FileVersion||2022.0160.4315.02 ((sql2022_rtm_qfe-cu27-gdr2).261021-1910)", "InternalName||SQLSERVR",
                      "LegalCopyright||Microsoft. All rights reserved.",
                      "LegalTrademarks||Microsoft SQL Server is a registered trademark of Microsoft Corporation.",
                      "OriginalFilename||SQLSERVR.EXE", "PrivateBuild||", "SpecialBuild|282787842|", "WindowsVersion|282787842|6.2 (9200)",
                      "ProcessorCount|16|16", "ProcessorActiveMask||            ffff", "ProcessorType|8664|",
                      "PhysicalMemory|38361|38361 (40224423936)", "Product ID||"]

fn outCol(name: &str, oid: int): lexdb_exec.OutCol {
    return lexdb_exec.OutCol{name: strings.toLowerAscii(&name), oid: oid, spell: name.toStr(), coll: "", scale: -1}
}

// A value as a T-SQL literal.
fn litOf(v: &Val): str {
    if lexdb_exec.isNull(v) { return "NULL" }
    match v {
        Val.Int(n) { return n.toStr() }
        Val.Num(d) { return d.toStr() }
        Val.Bool(b) { return if b { "1" } else { "0" } }
        else { return "N'" + strings.replaceAll(&lexdb_exec.text(v), "'", "''") + "'" }
    }
}

// A batch run inside this one (EXEC (string), sp_executesql), with its own
// variables fr; its errors end it, not the batch that ran it.
fn (st: mut &State) nested(sess: mut &lexdb_exec.Session, sql: &str, fr: mut &Frame, ev: mut &[]Event): int {
    let text = withTableTypes(sess, sql)
    let parsed = lexdb_tsqlparse.parseBatch(&text, lexdb_sql.Dialect{tsql: true, quotedIdent: st.quotedIdent}, &fr.names)
    if parsed.isErr() {
        let e = parsed.unwrapErr()
        st.failErr(ev, &e, 0)
        return F_NEXT
    }
    let b = parsed.unwrap()
    let given = len(fr.names)
    for k in given..len(b.vars) { let i = fr.add(&b.vars[k], b.types[k - given], Val.Null) }
    let r = st.block(sess, &b.stmts, fr, ev)
    return if r == F_ERROR { F_ERROR } else { F_NEXT }
}

// After an error in a condition or an argument: to the CATCH block, else on.
fn (st: mut &State) flowAfterError(): int {
    if st.jump {
        st.jump = false
        return F_ERROR
    }
    return F_NEXT
}

// A batch in lexdb's own dialect (SET LEXDB_DIALECT POSTGRES): the first
// error ends it; SET LEXDB_DIALECT TSQL goes back.
fn (st: mut &State) runPg(sess: mut &lexdb_exec.Session, sql: &str, ev: mut &[]Event) {
    let low = strings.toLowerAscii(&(strings.trim(&sql)))
    if strings.startsWith(&low, "set lexdb_dialect") {
        st.postgres = !strings.contains(&low, "tsql")
        doneEv(ev, -1, 0, false)
        return
    }
    match lexdb_sql.parse(sql) {
        Err(e) {
            errorEv(ev, &e)
            doneEv(ev, -1, 0, true)
        }
        Ok(stmts) {
            let none: []Val = []
            let nt: []int = []
            var any = false
            for s in stmts {
                if s.kind == lexdb_sql.S_EMPTY { continue }
                any = true
                st.committed = false
                let before = sess.status()
                let r = sess.run(&s, &none, &nt)
                if r.isErr() {
                    let e = r.unwrapErr()
                    errorEv(ev, &e)
                    doneEv(ev, -1, cmdOf(s.kind), true)
                    st.after(sess, before, ev)
                    break
                }
                var res = r.unwrap()
                if res.tag == "COMMIT" { st.committed = true }
                if res.hasRows {
                    var x = ev0(EV_ROWS)
                    x.cols = replace(mut &res.cols, [])
                    x.rows = replace(mut &res.rows, [])
                    append(ev, x)
                }
                let n = tagCount(&res.tag)
                doneEv(ev, if st.nocount { -1 } else { n }, cmdOf(s.kind), false)
                st.after(sess, before, ev)
            }
            if !any { doneEv(ev, -1, 0, false) }
        }
    }
}

// ---- bulk load and the metadata bulk-copy clients ask for first
// (design/lexdb-tds.md, section 14)

// The rows of the bulk load the last INSERT BULK accepted (st.bulk), from
// pull as they arrive: one statement, as an INSERT is (a transaction of its
// own, or under a savepoint in the open one; IMPLICIT_TRANSACTIONS begins
// one); its row count, or its error then 3621, as SQL Server ends one.
pub fn bulk(sess: mut &lexdb_exec.Session, st: mut &State, pull: &fn(): lexdb_exec.CopyPart, ev: mut &[]Event) {
    var req = pop(mut &st.bulk)
    st.bulk = []
    var s = lexdb_sql.newStmt(lexdb_sql.S_COPY)
    s.table = req.table
    s.names = replace(mut &req.cols, [])
    s.copy.from = true
    s.copy.bulk = true
    s.copy.keepNulls = req.keepNulls
    var f = newFrame()
    st.refresh(sess, mut &f)
    let before = sess.status()
    let go = st.sqlStmtWith(sess, &s, mut &f, ev, false, pull)
    st.after(sess, before, ev)
}

// The columns sql's first statement returns, as SQL Server describes them
// (sp_describe_first_result_set, sp_prepare's metadata): none for a
// statement that returns none. params: its parameters (sp_prepare's).
pub fn describeFirst(sess: mut &lexdb_exec.Session, st: &State, sql: &str, params: &[]lexdb_tsqlparse.ParamDecl): Result[[]lexdb_exec.DeclCol, DbErr] {
    var f = newFrame()
    for p in params { let k = f.add(&p.name, p.typ, Val.Null) }
    let b = try lexdb_tsqlparse.parseBatch(sql, lexdb_sql.Dialect{tsql: true, quotedIdent: st.quotedIdent}, &f.names)
    for t in b.stmts {
        if t.kind == lexdb_tsqlparse.TS_SQL {
            if t.stmt[0].kind != lexdb_sql.S_SELECT || len(t.stmt[0].assign) > 0 { return Ok([]) }
            return sess.describeDecl(&t.stmt[0])
        }
    }
    return Ok([])
}

// The TDS type a column of SQL Server's type goes as (its tds_type_id): a
// fixed-length type when NOT NULL, else its nullable kind; text, ntext and
// image as (max) types.
pub fn tdsTypeOf(d: &lexdb_exec.DeclCol): int {
    let fixed = !d.nullable
    match d.typ {
        "tinyint", "smallint", "int", "bigint" { return if fixed { d.sys } else { 0x26 } }
        "bit" { return if fixed { 0x32 } else { 0x68 } }
        "real", "float" { return if fixed { d.sys } else { 0x6D } }
        "money", "smallmoney" { return if fixed { d.sys } else { 0x6E } }
        "datetime", "smalldatetime" { return if fixed { d.sys } else { 0x6F } }
        "text" { return 0xA7 }
        "ntext" { return 0xE7 }
        "image" { return 0xA5 }
        else { return d.sys }
    }
}

// The length TDS gives a column of SQL Server's type (its tds_length):
// bytes, 65535 for a (max) type.
pub fn tdsLenOf(d: &lexdb_exec.DeclCol): int {
    if d.typ == "decimal" || d.typ == "numeric" { return 17 }
    if d.typ == "xml" { return 8100 }
    if d.maxLen < 0 || d.typ == "text" || d.typ == "ntext" || d.typ == "image" { return 65535 }
    return d.maxLen
}

// SQL Server's name of a column's type with its length, precision or scale.
fn typeText(d: &lexdb_exec.DeclCol): str {
    let t = d.typ
    if t == "varchar" || t == "char" || t == "varbinary" || t == "binary" { return t + "(" + (if d.maxLen < 0 { "max" } else { d.maxLen.toStr() }) + ")" }
    if t == "nvarchar" || t == "nchar" { return t + "(" + (if d.maxLen < 0 { "max" } else { (d.maxLen / 2).toStr() }) + ")" }
    if t == "decimal" || t == "numeric" { return t + "(" + d.prec.toStr() + "," + d.scale.toStr() + ")" }
    if t == "time" || t == "datetime2" || t == "datetimeoffset" { return t + "(" + d.scale.toStr() + ")" }
    return t.toStr()
}

// Whether the type carries a collation.
fn textual(d: &lexdb_exec.DeclCol): bool {
    let t = d.typ
    return t == "varchar" || t == "char" || t == "nvarchar" || t == "nchar" || t == "text" || t == "ntext"
}

const DESCRIBE_COLS: []str = ["is_hidden:b", "column_ordinal:i", "name:s", "is_nullable:b", "system_type_id:i", "system_type_name:s",
    "max_length:h", "precision:t", "scale:t", "collation_name:s", "user_type_id:i", "user_type_database:s", "user_type_schema:s",
    "user_type_name:s", "assembly_qualified_type_name:s", "xml_collection_id:i", "xml_collection_database:s", "xml_collection_schema:s",
    "xml_collection_name:s", "is_xml_document:b", "is_case_sensitive:b", "is_fixed_length_clr_type:b", "source_server:s",
    "source_database:s", "source_schema:s", "source_table:s", "source_column:s", "is_identity_column:b", "is_part_of_unique_key:b",
    "is_updateable:b", "is_computed_column:b", "is_sparse_column_set:b", "ordinal_in_order_by_list:h", "order_by_is_descending:h",
    "order_by_list_length:h", "tds_type_id:i", "tds_length:i", "tds_collation_id:i", "tds_collation_sort_id:t"]

// sp_describe_first_result_set's result: a row per column, SQL Server's 39
// columns (those lexdb has nothing for NULL, as SQL Server leaves them for a
// table's column read without browse information).
pub fn describeRows(cols: &[]lexdb_exec.DeclCol): Event {
    var x = ev0(EV_ROWS)
    for c in DESCRIBE_COLS {
        let p = strings.split(&c, ":")
        let k = p[1]
        let oid = if k == "b" { lexdb_sql.OID_BOOL } else if k == "s" { lexdb_sql.OID_TEXT } else if k == "i" { lexdb_sql.OID_INT4 } else { lexdb_sql.OID_INT2 }
        append(mut &x.cols, lexdb_exec.OutCol{name: p[0].toStr(), oid: oid, spell: p[0].toStr(), coll: "",
                                              scale: if k == "t" { lexdb_syscat.hint(lexdb_syscat.TS_TINYINT, 0) } else { -1 }})
    }
    for i in 0..len(cols) {
        let d = &cols[i]
        let tx = textual(d)
        let n = Val.Null
        let no = Val.Bool(false)
        append(mut &x.rows, [no, Val.Int(i + 1), Val.Text(d.name), Val.Bool(d.nullable), Val.Int(d.sys), Val.Text(typeText(d)),
                             Val.Int(d.maxLen), Val.Int(d.prec), Val.Int(d.scale), if len(d.coll) > 0 && tx { Val.Text(d.coll) } else { n },
                             n, n, n, n, n, n, n, n, n, no, no, no, n, n, n, n, n, Val.Bool(d.identity), n, Val.Bool(!d.identity), no, no, n, n, n,
                             Val.Int(tdsTypeOf(d)), Val.Int(tdsLenOf(d)), if tx { Val.Int(13632521) } else { n }, if tx { Val.Int(52) } else { n }])
    }
    return x
}

// sp_tablecollations_100's result for a table (SqlBulkCopy's): a row per
// column, its collation where it has one (TDS's 5 bytes, then its name).
fn tableCollations(cols: &[]lexdb_exec.DeclCol): Event {
    var x = ev0(EV_ROWS)
    x.cols = [outCol(&"colid", lexdb_sql.OID_INT4), outCol(&"name", lexdb_sql.OID_TEXT), outCol(&"tds_collation", lexdb_sql.OID_BYTEA),
              outCol(&"collation", lexdb_sql.OID_TEXT)]
    for i in 0..len(cols) {
        let d = &cols[i]
        let tx = textual(d)
        append(mut &x.rows, [Val.Int(i + 1), Val.Text(d.name), if tx { Val.Bytes(TDS_COLLATION) } else { Val.Null },
                             if tx { Val.Text(d.coll) } else { Val.Null }])
    }
    return x
}

// A table's name given as text ("[dbo].[t]", ".[t]", "db.dbo.t") as lexdb's.
fn tableArg(text: &str): Result[str, DbErr] {
    var t = strings.trim(&text)
    while strings.startsWith(&t, ".") { t = t[1..len(t)].toStr() }
    let none: []str = []
    var q = try lexdb_sql.tsqlParser(&t, lexdb_sql.Dialect{tsql: true, quotedIdent: true}, &none)
    return q.tableName()
}

// SQL_Latin1_General_CP1_CI_AS in TDS's 5 bytes (lexdb_tds sends every text column so)
const TDS_COLLATION = "\x09\x04\xd0\x00\x34"
