// lexdb_token: whole-word search on text, by tokenbf's tokens (lexdb_skip):
// a token is a longest run of ASCII letters and digits, anything else
// (punctuation, space, '_', a byte of a character outside ASCII) between.
//
// - has_token(text, word) / has_token_ci(text, word): whether word is one of
//   text's tokens (ClickHouse's hasToken / hasTokenCaseInsensitive; their
//   names are accepted too). word must be one token.
// - reRuns: the literal runs a regular expression's every match must hold,
//   each with whether a word boundary (\y \m \M \b, ^ $ \A \Z) is next to it,
//   so a tokenbf can skip a block that has none of a run's whole tokens
//   (url ~ '\ycheckout\y') and an ngrambf one that has none of its n-grams.
import "strings"

type VB = vector[byte]

// Whether c is a byte of a token.
pub fn isTokenByte(c: byte): bool {
    return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
}

// Whether w is one token: not empty, letters and digits only.
pub fn validToken(w: &str): bool {
    if len(w) == 0 { return false }
    for i in 0..len(w) { if !isTokenByte(w[i]) { return false } }
    return true
}

fn foldByte(c: byte): byte { return if c >= 'A' && c <= 'Z' { c + 32 } else { c } }

fn tokenMidEq(s: &str, pos: int, w: &str, fold: bool): bool {
    if fold {
        for k in 1..len(w) - 1 {
            if foldByte(s[pos + k]) != w[k] { return false }
        }
        return true
    }
    for k in 1..len(w) - 1 {
        if s[pos + k] != w[k] { return false }
    }
    return true
}

// Whether w (a token; folded to lower case when fold) is one of s's tokens,
// s's ASCII letters folded when fold. Uses 2-byte branchless vector[byte] SIMD.
pub fn hasToken(s: &str, w: &str, fold: bool): bool {
    return hasTokenRange(s, 0, len(s), w, fold)
}

// Zero-copy hasToken on s[lo..hi].
pub fn hasTokenRange(s: &str, lo: int, hi: int, w: &str, fold: bool): bool {
    let n = hi - lo
    let m = len(w)
    if m == 0 || m > n { return false }
    let lim = hi - m + 1
    let b0 = w[0]
    let v0Lo = VB.splat(b0)
    let vM0 = if fold && b0 >= 'a' && b0 <= 'z' { VB.splat(byte(0x20)) } else { VB.zero() }
    var i = lo
    if m == 1 {
        while i + VB.lanes <= lim {
            var bm = ((VB.load(s, i) | vM0) == v0Lo).bitmask()
            while bm != u64(0) {
                let pos = i + int(bm.trailingZeros())
                if (pos == lo || !isTokenByte(s[pos - 1])) && (pos + 1 == hi || !isTokenByte(s[pos + 1])) { return true }
                bm = bm & (bm - u64(1))
            }
            i += VB.lanes
        }
        if i < lim {
            var bm = ((VB.loadPartial(s, i, byte(0)) | vM0) == v0Lo).bitmask() & VB.tailMask(lim - i)
            while bm != u64(0) {
                let pos = i + int(bm.trailingZeros())
                if (pos == lo || !isTokenByte(s[pos - 1])) && (pos + 1 == hi || !isTokenByte(s[pos + 1])) { return true }
                bm = bm & (bm - u64(1))
            }
        }
        return false
    }
    let off1 = m - 1
    let b1 = w[off1]
    let v1Lo = VB.splat(b1)
    let vM1 = if fold && b1 >= 'a' && b1 <= 'z' { VB.splat(byte(0x20)) } else { VB.zero() }
    while i + VB.lanes <= lim {
        let ma = (VB.load(s, i) | vM0) == v0Lo
        let mb = (VB.load(s, i + off1) | vM1) == v1Lo
        var bm = (ma & mb).bitmask()
        while bm != u64(0) {
            let pos = i + int(bm.trailingZeros())
            if (pos == lo || !isTokenByte(s[pos - 1])) && (pos + m == hi || !isTokenByte(s[pos + m])) && (m == 2 || tokenMidEq(s, pos, w, fold)) {
                return true
            }
            bm = bm & (bm - u64(1))
        }
        i += VB.lanes
    }
    if i < lim {
        let ma = (VB.loadPartial(s, i, byte(0)) | vM0) == v0Lo
        let mb = (VB.loadPartial(s, i + off1, byte(0)) | vM1) == v1Lo
        var bm = (ma & mb).bitmask() & VB.tailMask(lim - i)
        while bm != u64(0) {
            let pos = i + int(bm.trailingZeros())
            if (pos == lo || !isTokenByte(s[pos - 1])) && (pos + m == hi || !isTokenByte(s[pos + m])) && (m == 2 || tokenMidEq(s, pos, w, fold)) {
                return true
            }
            bm = bm & (bm - u64(1))
        }
    }
    return false
}

// reRuns's anchors: a word boundary just before a run (RUN_START), just after it (RUN_END).
pub const RUN_START = 1
pub const RUN_END = 2

const K_NONE = 0        // nothing yet, or something that matches we know not what
const K_LIT = 1         // a literal character, the run's last
const K_BOUND = 2       // a word boundary or an anchor

// The runs of literal text every match of pattern pat must contain, and per run
// its anchors (RUN_START, RUN_END). false: none can be said (an alternation,
// embedded options, an escape not known here); then runs says nothing. tsql:
// SQL Server's pattern (RE2's syntax as it is), else PostgreSQL's and Oracle's
// (lexdb_func.arePattern: \y \m \M are \b). Only what is surely in every match
// is kept: a character a quantifier follows (* ? {) is left out, a group or a
// bracket is skipped whole, and a run ends at either.
pub fn reRuns(pat: &str, tsql: bool, runs: mut &[]str, anchors: mut &[]int): bool {
    let n = len(pat)
    if n >= 3 && pat[0] == '*' && pat[1] == '*' && pat[2] == '*' { return false }    // ARE's ***= ***: directors
    var run = ""
    var aStart = false
    var last = K_NONE
    var litAt = 0           // where the run's last character starts (a quantifier takes it away)
    var i = 0
    while i < n {
        let c = pat[i]
        if c == '\\' {
            if i + 1 >= n { return false }
            let d = pat[i + 1]
            let bound = d == 'b' || d == 'A' || (!tsql && (d == 'y' || d == 'm' || d == 'M' || d == 'Z')) || (tsql && d == 'z')
            if bound {
                pushRun(mut &run, aStart, last == K_LIT, runs, anchors)
                aStart = true
                last = K_BOUND
                i += 2
                continue
            }
            if isTokenByte(d) {
                // a class or a control character of one letter: something, not known; any other (\x41, \u, \p, \Q, \1): give up
                if d == 'd' || d == 'D' || d == 'w' || d == 'W' || d == 's' || d == 'S' || d == 'B' || (!tsql && d == 'Y') ||
                   d == 'n' || d == 't' || d == 'r' || d == 'f' || d == 'v' {
                    pushRun(mut &run, aStart, false, runs, anchors)
                    aStart = false
                    last = K_NONE
                    i += 2
                    continue
                }
                return false
            }
            // an escaped punctuation character: itself
            litAt = len(run)
            run.addByte(d)
            last = K_LIT
            i += 2
            continue
        }
        if c == '|' { return false }
        if c == '^' || c == '$' {
            pushRun(mut &run, aStart, last == K_LIT, runs, anchors)
            aStart = true
            last = K_BOUND
            i += 1
            continue
        }
        if c == '*' || c == '?' || c == '{' || c == '+' {
            if last == K_BOUND { return false }     // a boundary made optional or repeated
            if last == K_LIT && c != '+' {
                // the character before is not surely there
                run = run[0..litAt].toStr()
            }
            pushRun(mut &run, aStart, false, runs, anchors)
            aStart = false
            last = K_NONE
            i += 1
            if c == '{' {
                while i < n && pat[i] != '}' { i += 1 }
                if i >= n { return false }
                i += 1
            }
            continue
        }
        if c == '(' {
            if i + 1 < n && pat[i + 1] == '?' { return false }     // embedded options, lookaround, a named group
            let e = groupEnd(pat, i)
            if e < 0 { return false }
            pushRun(mut &run, aStart, false, runs, anchors)
            aStart = false
            last = K_NONE
            i = e + 1
            continue
        }
        if c == ')' { return false }
        if c == '[' {
            let e = bracketEnd(pat, i)
            if e < 0 { return false }
            pushRun(mut &run, aStart, false, runs, anchors)
            aStart = false
            last = K_NONE
            i = e + 1
            continue
        }
        if c == '.' || c == '}' {
            pushRun(mut &run, aStart, false, runs, anchors)
            aStart = false
            last = K_NONE
            i += 1
            continue
        }
        // a literal character (all of its bytes, outside ASCII)
        litAt = len(run)
        run.addByte(c)
        i += 1
        if c >= 128 {
            while i < n && pat[i] >= 128 && pat[i] < 192 {
                run.addByte(pat[i])
                i += 1
            }
        }
        last = K_LIT
    }
    pushRun(mut &run, aStart, false, runs, anchors)
    return true
}

// Ends the run (cleared), kept when not empty with its anchors.
fn pushRun(run: mut &str, aStart: bool, aEnd: bool, runs: mut &[]str, anchors: mut &[]int) {
    if len(run) > 0 {
        append(runs, run.toStr())
        append(anchors, (if aStart { RUN_START } else { 0 }) | (if aEnd { RUN_END } else { 0 }))
    }
    run.clear()
}

// The place of the ) closing the group that opens at at; -1 none.
fn groupEnd(p: &str, at: int): int {
    var depth = 0
    var i = at
    let n = len(p)
    while i < n {
        let c = p[i]
        if c == '\\' { i += 2; continue }
        if c == '[' {
            let e = bracketEnd(p, i)
            if e < 0 { return -1 }
            i = e + 1
            continue
        }
        if c == '(' { depth += 1 }
        else if c == ')' {
            depth -= 1
            if depth == 0 { return i }
        }
        i += 1
    }
    return -1
}

// The place of the ] closing the bracket expression that opens at at; -1
// none. A ] first (after ^) is itself; [:class:], [.x.] and [=x=] inside.
fn bracketEnd(p: &str, at: int): int {
    let n = len(p)
    var i = at + 1
    if i < n && p[i] == '^' { i += 1 }
    if i < n && p[i] == ']' { i += 1 }
    while i < n {
        let c = p[i]
        if c == '\\' { i += 2; continue }
        if c == '[' && i + 1 < n && (p[i + 1] == ':' || p[i + 1] == '.' || p[i + 1] == '=') {
            let k = p[i + 1]
            var j = i + 2
            while j + 1 < n && !(p[j] == k && p[j + 1] == ']') { j += 1 }
            if j + 1 >= n { return -1 }
            i = j + 2
            continue
        }
        if c == ']' { return i }
        i += 1
    }
    return -1
}
