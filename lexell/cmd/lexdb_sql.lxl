// lexdb: SQL text to statements (design/lexdb.md 4.8): a lexer and a
// recursive-descent parser for the subset lexdb runs.
//
// Statements: CREATE TABLE (a primary key is required), DROP TABLE, INSERT
// ... VALUES, SELECT (one table or none; WHERE, GROUP BY, ORDER BY, LIMIT,
// OFFSET; aggregates), UPDATE, DELETE, BEGIN / START TRANSACTION, COMMIT /
// END, ROLLBACK, and SET (accepted and ignored). Names are folded to lower
// case unless quoted. Expressions: literals, $n parameters, columns
// (table.column too), + - * / % ||, comparisons, AND OR NOT, IS [NOT] NULL,
// casts (::type and CAST(x AS type)) and function calls.
import "strings"
import "./lexdb_base"

// Column kinds.
pub const K_INT = 1
pub const K_BOOL = 2
pub const K_NUM = 3
pub const K_TEXT = 4

// Postgres type OIDs.
pub const OID_BOOL = 16
pub const OID_INT8 = 20
pub const OID_INT2 = 21
pub const OID_INT4 = 23
pub const OID_TEXT = 25
pub const OID_VARCHAR = 1043
pub const OID_NUMERIC = 1700
pub const OID_UNKNOWN = 705

pub type TypeName = value record {
    pub kind: int
    pub oid: int
    pub prec: int       // numeric precision, 0 when not given
    pub scale: int      // numeric scale
    pub len: int        // varchar length, 0 when not given
}

pub type Val = value closed {
    Null
    Int(int)
    Bool(bool)
    Num(Decimal)
    Text(str)
}

pub type Expr = closed {
    Lit(Val)
    Param(int)                  // $n, from 1
    Col(str)
    Unary(str, Expr)            // "-", "not"
    Bin(str, Expr, Expr)        // + - * / % || = <> < <= > >= and or
    IsNull(Expr, bool)          // IS NULL; true: IS NOT NULL
    Call(str, []Expr, bool)     // name, arguments, count(*)
    Cast(Expr, TypeName)
}

pub type ColDef = record {
    pub name: str
    pub typ: TypeName
    pub notNull: bool
}

pub type SelItem = record {
    pub star: bool
    pub qual: str               // t.* : the table (or alias); "" for *
    pub expr: Option[Expr]
    pub alias: str
}

// A table in FROM: how it joins the ones before it.
pub const J_FIRST = 0
pub const J_INNER = 1
pub const J_LEFT = 2
pub const J_CROSS = 3
pub const J_RIGHT = 4
pub const J_FULL = 5

pub type FromItem = record {
    pub table: str
    pub alias: str              // the name its columns are qualified by
    pub join: int
    pub on: Option[Expr]
    pub sub: int                // a subquery (in FROM, or a CTE's): its number; -1: a table
    pub cols: []str             // names for its columns (AS x(a, b)); the rest keep theirs
    pub work: int               // a recursive CTE in its own body: the CTE's number (its working table); -1
}

pub type OrderItem = record { pub expr: Expr; pub desc: bool }

pub type SetItem = record { pub col: str; pub expr: Expr }

pub const S_EMPTY = 0
pub const S_CREATE = 1
pub const S_DROP = 2
pub const S_INSERT = 3
pub const S_SELECT = 4
pub const S_UPDATE = 5
pub const S_DELETE = 6
pub const S_BEGIN = 7
pub const S_COMMIT = 8
pub const S_ROLLBACK = 9
pub const S_SET = 10
pub const S_CREATE_INDEX = 11
pub const S_DROP_INDEX = 12
pub const S_EXPLAIN = 13

pub type Stmt = record {
    pub kind: int
    pub table: str
    pub ifFlag: bool            // IF NOT EXISTS / IF EXISTS; BEGIN READ ONLY; EXPLAIN ANALYZE
    pub cols: []ColDef          // CREATE
    pub pk: []str
    pub names: []str            // INSERT's column list
    pub rows: [][]Expr          // INSERT's VALUES
    pub items: []SelItem        // SELECT
    pub where: Option[Expr]
    pub group: []Expr
    pub order: []OrderItem
    pub limit: Option[Expr]
    pub offset: Option[Expr]
    pub sets: []SetItem         // UPDATE
    pub params: int             // the highest $n
    pub from: []FromItem        // SELECT
    pub index: str              // CREATE INDEX / DROP INDEX: the index's name
    pub unique: bool
    pub inner: []Stmt           // EXPLAIN: the statement explained
    pub distinct: bool          // SELECT DISTINCT
    pub having: Option[Expr]
    pub subs: []Stmt            // its subqueries: an expression names one by number (#sub, #exists, #in)
    pub use: int                // a subquery: what it is used as (SUB_SCALAR, SUB_EXISTS, SUB_IN)
    pub setop: int              // UNION, INTERSECT or EXCEPT of inner[0] and inner[1] (SET_*); 0 none
    pub setAll: bool            // ... ALL
    pub cte: int                // a CTE where it is used: its number in the statement; -1 none
    pub rec: bool               // a recursive CTE: inner[1] reads its working table
}

pub const SET_UNION = 1
pub const SET_INTERSECT = 2
pub const SET_EXCEPT = 3

// What a subquery is used as.
pub const SUB_SCALAR = 1
pub const SUB_EXISTS = 2
pub const SUB_IN = 3
pub const SUB_FROM = 4          // in FROM: a subquery, or a CTE where it is used

fn newStmt(kind: int): Stmt {
    return Stmt{kind: kind, table: "", ifFlag: false, cols: [], pk: [], names: [], rows: [], items: [], where: None,
                group: [], order: [], limit: None, offset: None, sets: [], params: 0, from: [], index: "",
                unique: false, inner: [], distinct: false, having: None, subs: [], use: 0, setop: 0, setAll: false,
                cte: -1, rec: false}
}

// ---- the lexer

const T_EOF = 0
const T_IDENT = 1        // folded to lower case
const T_QIDENT = 2       // "quoted"
const T_NUM = 3
const T_STR = 4
const T_PARAM = 5
const T_OP = 6

type Tok = value record { kind: int; text: str; at: int }

fn syntax(msg: str): lexdb_base.DbErr { return lexdb_base.err("42601", msg) }

fn isIdentStart(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c >= 128 }
fn isIdentChar(c: byte): bool { return isIdentStart(c) || (c >= '0' && c <= '9') || c == '$' }
fn isDigit(c: byte): bool { return c >= '0' && c <= '9' }

fn lex(s: &str): Result[[]Tok, lexdb_base.DbErr] {
    var out: []Tok = []
    var i = 0
    let n = len(s)
    while i < n {
        let c = s[i]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 12 {
            i += 1
            continue
        }
        if c == '-' && i + 1 < n && s[i + 1] == '-' {
            while i < n && s[i] != '\n' { i += 1 }
            continue
        }
        if c == '/' && i + 1 < n && s[i + 1] == '*' {
            i += 2
            while i + 1 < n && !(s[i] == '*' && s[i + 1] == '/') { i += 1 }
            i += 2
            continue
        }
        let start = i
        if isIdentStart(c) {
            while i < n && isIdentChar(s[i]) { i += 1 }
            append(mut &out, Tok{kind: T_IDENT, text: strings.toLowerAscii(s[start..i]), at: start})
            continue
        }
        if c == '"' {
            var b = newStrBuf()
            i += 1
            while true {
                if i >= n { return Err(syntax("unterminated quoted identifier")) }
                if s[i] == '"' {
                    if i + 1 < n && s[i + 1] == '"' {
                        b.addByte('"')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                b.addByte(s[i])
                i += 1
            }
            append(mut &out, Tok{kind: T_QIDENT, text: b.toStr(), at: start})
            continue
        }
        if isDigit(c) || (c == '.' && i + 1 < n && isDigit(s[i + 1])) {
            while i < n && (isDigit(s[i]) || s[i] == '.') { i += 1 }
            if i < n && (s[i] == 'e' || s[i] == 'E') {
                i += 1
                if i < n && (s[i] == '+' || s[i] == '-') { i += 1 }
                while i < n && isDigit(s[i]) { i += 1 }
            }
            append(mut &out, Tok{kind: T_NUM, text: s[start..i], at: start})
            continue
        }
        if c == '\'' {
            var b = newStrBuf()
            i += 1
            while true {
                if i >= n { return Err(syntax("unterminated quoted string")) }
                if s[i] == '\'' {
                    if i + 1 < n && s[i + 1] == '\'' {
                        b.addByte('\'')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                b.addByte(s[i])
                i += 1
            }
            append(mut &out, Tok{kind: T_STR, text: b.toStr(), at: start})
            continue
        }
        if c == '$' && i + 1 < n && isDigit(s[i + 1]) {
            i += 1
            while i < n && isDigit(s[i]) { i += 1 }
            append(mut &out, Tok{kind: T_PARAM, text: s[start + 1..i], at: start})
            continue
        }
        // operators
        var op = s[i..i + 1]
        if i + 1 < n {
            let two = s[i..i + 2]
            if two == "<=" || two == ">=" || two == "<>" || two == "!=" || two == "||" || two == "::" { op = two }
        }
        if !strings.contains(&"(),;.*+-/%=<>|:![]", &op[0..1]) {
            return Err(syntax("syntax error at or near \"" + op + "\""))
        }
        i += len(op)
        append(mut &out, Tok{kind: T_OP, text: op, at: start})
    }
    append(mut &out, Tok{kind: T_EOF, text: "", at: n})
    return Ok(out)
}

// ---- the parser

type P = record {
    toks: []Tok
    pos: int
    params: int
    subs: []Stmt        // the subqueries of the statement being parsed
    ctes: []Cte         // the CTEs in scope, innermost last
    nextCte: int        // the statement's CTEs are numbered
    inCte: []InCte      // the recursive CTEs whose bodies are being parsed
    depth: int          // subqueries deep
}

// A CTE: kept as its text (where its tokens start), parsed again as a
// subquery in FROM wherever it is used, seeing the CTEs before it (and a
// recursive one itself).
type Cte = record { name: str; cols: []str; start: int; id: int; rec: bool }

type InCte = record { id: int; depth: int; refs: int }

fn (p: &P) peek(): Tok { return p.toks[p.pos] }
fn (p: &P) peekAt(k: int): Tok {
    let i = if p.pos + k < len(p.toks) { p.pos + k } else { len(p.toks) - 1 }
    return p.toks[i]
}
fn (p: mut &P) next(): Tok {
    let t = p.toks[p.pos]
    if t.kind != T_EOF { p.pos += 1 }
    return t
}

fn near(t: &Tok): lexdb_base.DbErr {
    if t.kind == T_EOF { return syntax("syntax error at end of input") }
    return syntax("syntax error at or near \"" + t.text + "\"")
}

// Is the next token the keyword (or operator) w?
fn (p: &P) isKw(w: str): bool {
    let t = p.peek()
    return (t.kind == T_IDENT || t.kind == T_OP) && t.text == w
}

fn (p: mut &P) acceptKw(w: str): bool {
    if p.isKw(w) {
        p.pos += 1
        return true
    }
    return false
}

fn (p: mut &P) expectKw(w: str): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw(w) { return Ok(Unit{}) }
    return Err(near(&p.peek()))
}

const RESERVED: []str = ["select", "from", "where", "group", "order", "by", "limit", "offset", "and", "or", "not", "is",
                  "null", "as", "values", "set", "into", "insert", "update", "delete", "create", "table",
                  "primary", "key", "asc", "desc", "true", "false", "cast", "on", "join", "inner", "left",
                  "right", "full", "outer", "cross", "using", "natural", "having", "distinct", "in", "like", "ilike", "between",
                  "case", "when", "then", "else", "end", "union", "intersect", "except", "with"]

fn isReserved(w: &str): bool {
    for r in RESERVED { if r == w { return true } }
    return false
}

fn (p: mut &P) name(): Result[str, lexdb_base.DbErr] {
    let t = p.peek()
    if t.kind == T_QIDENT || (t.kind == T_IDENT && !isReserved(&t.text)) {
        p.pos += 1
        return Ok(t.text)
    }
    return Err(near(&t))
}

fn (p: mut &P) typeName(): Result[TypeName, lexdb_base.DbErr] {
    let w = try p.name()
    var t = TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}
    match w {
        "int", "integer", "int4" { t = TypeName{kind: K_INT, oid: OID_INT4, prec: 0, scale: 0, len: 0} }
        "bigint", "int8" { t = TypeName{kind: K_INT, oid: OID_INT8, prec: 0, scale: 0, len: 0} }
        "smallint", "int2" { t = TypeName{kind: K_INT, oid: OID_INT2, prec: 0, scale: 0, len: 0} }
        "boolean", "bool" { t = TypeName{kind: K_BOOL, oid: OID_BOOL, prec: 0, scale: 0, len: 0} }
        "numeric", "decimal" { t = TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 0, scale: 0, len: 0} }
        "text" { t = TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0} }
        "varchar" { t = TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: 0} }
        "character" {
            if p.acceptKw("varying") {
                t = TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: 0}
            } else {
                return Err(lexdb_base.err("0A000", "type character is not supported (use varchar or text)"))
            }
        }
        else { return Err(lexdb_base.err("42704", "type \"" + w + "\" does not exist")) }
    }
    if p.acceptKw("(") {
        let a = try p.intLit()
        if t.kind == K_NUM {
            t.prec = a
            if p.acceptKw(",") { t.scale = try p.intLit() }
            if t.prec < 1 || t.prec > 38 {
                return Err(lexdb_base.err("22023", "NUMERIC precision " + t.prec.toStr() + " must be between 1 and 38"))
            }
            if t.scale < 0 || t.scale > t.prec {
                return Err(lexdb_base.err("22023", "NUMERIC scale " + t.scale.toStr() + " must be between 0 and precision " + t.prec.toStr()))
            }
        } else if t.kind == K_TEXT {
            t.len = a
        } else {
            return Err(near(&p.toks[p.pos - 1]))
        }
        try p.expectKw(")")
    }
    return Ok(t)
}

fn (p: mut &P) intLit(): Result[int, lexdb_base.DbErr] {
    let t = p.next()
    if t.kind != T_NUM { return Err(near(&t)) }
    match strings.parseIntOpt(t.text) {
        Some(n) { return Ok(n) }
        None { return Err(near(&t)) }
    }
}

// ---- expressions, by precedence: OR, AND, NOT, comparison and IS, ||,
// + -, * / %, unary -, ::.

fn (p: mut &P) expr(): Result[Expr, lexdb_base.DbErr] { return p.orExpr() }

fn (p: mut &P) orExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.andExpr()
    while p.acceptKw("or") {
        let r = try p.andExpr()
        e = Expr.Bin("or", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) andExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.notExpr()
    while p.acceptKw("and") {
        let r = try p.notExpr()
        e = Expr.Bin("and", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) notExpr(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("not") {
        let e = try p.notExpr()
        return Ok(Expr.Unary("not", e))
    }
    return p.cmpExpr()
}

fn (p: mut &P) cmpExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.catExpr()
    let t = p.peek()
    if t.kind == T_OP && (t.text == "=" || t.text == "<>" || t.text == "!=" || t.text == "<" || t.text == "<=" ||
                          t.text == ">" || t.text == ">=") {
        p.pos += 1
        let r = try p.catExpr()
        let op = if t.text == "!=" { "<>" } else { t.text }
        return Ok(Expr.Bin(op, e, r))
    }
    // [NOT] LIKE, ILIKE, IN, BETWEEN
    var neg = false
    let nt = p.peekAt(1)
    if p.isKw("not") && nt.kind == T_IDENT && (nt.text == "like" || nt.text == "ilike" || nt.text == "in" || nt.text == "between") {
        p.pos += 1
        neg = true
    }
    if p.isKw("like") || p.isKw("ilike") {
        let kw = p.next().text
        var args: []Expr = [e]
        append(mut &args, try p.catExpr())
        if p.acceptKw("escape") { append(mut &args, try p.catExpr()) }
        return Ok(negate(neg, Expr.Call(kw, args, false)))
    }
    if p.acceptKw("in") {
        try p.expectKw("(")
        if p.isKw("select") || p.isKw("with") {
            let i = try p.subquery(SUB_IN)
            return Ok(negate(neg, Expr.Call("#in", [Expr.Lit(Val.Int(i)), e], false)))
        }
        var args: []Expr = [e]
        append(mut &args, try p.expr())
        while p.acceptKw(",") { append(mut &args, try p.expr()) }
        try p.expectKw(")")
        return Ok(negate(neg, Expr.Call("in", args, false)))
    }
    if p.acceptKw("between") {
        // a BETWEEN b AND c is a >= b AND a <= c: the planner knows those
        let lo = try p.catExpr()
        try p.expectKw("and")
        let hi = try p.catExpr()
        let again = cloneE(&e)
        return Ok(negate(neg, Expr.Bin("and", Expr.Bin(">=", e, lo), Expr.Bin("<=", again, hi))))
    }
    if neg { return Err(near(&p.peek())) }
    if p.acceptKw("is") {
        let isNot = p.acceptKw("not")
        if p.acceptKw("distinct") {
            try p.expectKw("from")
            let r = try p.catExpr()
            let d = Expr.Call("distinct from", [e, r], false)
            return Ok(if isNot { Expr.Unary("not", d) } else { d })
        }
        if p.acceptKw("null") { return Ok(Expr.IsNull(e, isNot)) }
        if p.acceptKw("true") {
            let x = Expr.Bin("=", e, Expr.Lit(Val.Bool(true)))
            return Ok(if isNot { Expr.Unary("not", x) } else { x })
        }
        if p.acceptKw("false") {
            let x = Expr.Bin("=", e, Expr.Lit(Val.Bool(false)))
            return Ok(if isNot { Expr.Unary("not", x) } else { x })
        }
        return Err(near(&p.peek()))
    }
    return Ok(e)
}

fn (p: mut &P) catExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.addExpr()
    while p.acceptKw("||") {
        let r = try p.addExpr()
        e = Expr.Bin("||", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) addExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.mulExpr()
    while p.isKw("+") || p.isKw("-") {
        let op = p.next().text
        let r = try p.mulExpr()
        e = Expr.Bin(op, e, r)
    }
    return Ok(e)
}

fn (p: mut &P) mulExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.unary()
    while p.isKw("*") || p.isKw("/") || p.isKw("%") {
        let op = p.next().text
        let r = try p.unary()
        e = Expr.Bin(op, e, r)
    }
    return Ok(e)
}

fn (p: mut &P) unary(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("-") {
        let e = try p.unary()
        return Ok(Expr.Unary("-", e))
    }
    if p.acceptKw("+") { return p.unary() }
    var e = try p.primary()
    while p.acceptKw("::") {
        let t = try p.typeName()
        e = Expr.Cast(e, t)
    }
    return Ok(e)
}

fn negate(neg: bool, x: Expr): Expr { return if neg { Expr.Unary("not", x) } else { x } }

fn cloneE(x: &Expr): Expr {
    match x {
        Expr.Lit(v) { return Expr.Lit(v) }
        Expr.Param(n) { return Expr.Param(n) }
        Expr.Col(n) { return Expr.Col(n) }
        Expr.Unary(op, a) { return Expr.Unary(op, cloneE(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, cloneE(&a), cloneE(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(cloneE(&a), neg) }
        Expr.Cast(a, t) { return Expr.Cast(cloneE(&a), t) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, cloneE(&a)) }
            return Expr.Call(n, out, star)
        }
    }
}

// CASE [x] WHEN a THEN b ... [ELSE c] END: a call "case" (or "case else")
// of the WHEN and THEN pairs, then the ELSE; CASE x WHEN a is WHEN x = a.
fn (p: mut &P) caseExpr(): Result[Expr, lexdb_base.DbErr] {
    var operand: []Expr = []
    if !p.isKw("when") { append(mut &operand, try p.expr()) }
    var args: []Expr = []
    while p.acceptKw("when") {
        var w = try p.expr()
        if len(operand) > 0 { w = Expr.Bin("=", cloneE(&operand[0]), w) }
        try p.expectKw("then")
        append(mut &args, w)
        append(mut &args, try p.expr())
    }
    if len(args) == 0 { return Err(near(&p.peek())) }
    var name = "case"
    if p.acceptKw("else") {
        append(mut &args, try p.expr())
        name = "case else"
    }
    try p.expectKw("end")
    return Ok(Expr.Call(name, args, false))
}

// A subquery, after its "(": its own subqueries go with it, and the
// statement it is in gets it, numbered.
fn (p: mut &P) subquery(use: int): Result[int, lexdb_base.DbErr] {
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    var pushed = 0
    if p.acceptKw("with") { pushed = try p.withList() }
    try p.expectKw("select")
    var sq = try p.select()
    p.popCtes(pushed)
    sq.subs = replace(mut &p.subs, saved)
    sq.use = use
    try p.expectKw(")")
    append(mut &p.subs, sq)
    p.depth -= 1
    return Ok(len(p.subs) - 1)
}

// WITH's list, after "with": the CTEs go in scope (how many: the result).
// Each is parsed now to check it, and again where it is used.
fn (p: mut &P) withList(): Result[int, lexdb_base.DbErr] {
    let rec = p.acceptKw("recursive")
    var n = 0
    while true {
        let name = try p.name()
        var cols: []str = []
        if p.acceptKw("(") {
            append(mut &cols, try p.name())
            while p.acceptKw(",") { append(mut &cols, try p.name()) }
            try p.expectKw(")")
        }
        try p.expectKw("as")
        if p.acceptKw("not") { try p.expectKw("materialized") } else { let m = p.acceptKw("materialized") }
        try p.expectKw("(")
        for k in len(p.ctes) - n..len(p.ctes) {
            if p.ctes[k].name == name {
                return Err(lexdb_base.err("42712", "WITH query name \"" + name + "\" specified more than once"))
            }
        }
        let id = p.nextCte
        p.nextCte += 1
        let start = p.pos
        // a recursive one is in scope in its own body
        if rec {
            var cs: []str = []
            for c in cols { append(mut &cs, c) }
            append(mut &p.ctes, Cte{name: name, cols: cs, start: start, id: id, rec: true})
        }
        let keep = len(p.subs)
        if rec { append(mut &p.inCte, InCte{id: id, depth: p.depth + 1, refs: 0}) }
        let i = try p.subquery(SUB_FROM)
        if rec { let x = pop(mut &p.inCte) }
        while len(p.subs) > keep { let x = pop(mut &p.subs) }
        if !rec { append(mut &p.ctes, Cte{name: name, cols: cols, start: start, id: id, rec: false}) }
        n += 1
        if !p.acceptKw(",") { break }
    }
    return Ok(n)
}

fn (p: mut &P) popCtes(n: int) { for i in 0..n { let c = pop(mut &p.ctes) } }

// A use of CTE ci: its text parsed again, here, with the CTEs before it in
// scope.
fn (p: mut &P) cteRef(ci: int): Result[int, lexdb_base.DbErr] {
    let saved = replace(mut &p.ctes, [])
    let rec = saved[ci].rec
    let id = saved[ci].id
    let upto = if rec { ci + 1 } else { ci }
    for i in 0..upto {
        var cols: []str = []
        for c in saved[i].cols { append(mut &cols, c) }
        append(mut &p.ctes, Cte{name: saved[i].name, cols: cols, start: saved[i].start, id: saved[i].id, rec: saved[i].rec})
    }
    let pos = p.pos
    p.pos = saved[ci].start
    if rec { append(mut &p.inCte, InCte{id: id, depth: p.depth + 1, refs: 0}) }
    let r = p.subquery(SUB_FROM)
    var selfRefs = 0
    if rec { selfRefs = pop(mut &p.inCte).refs }
    p.pos = pos
    p.ctes = saved
    let i = try r
    p.subs[i].cte = id
    p.subs[i].rec = selfRefs > 0
    return Ok(i)
}

fn subRef(name: str, i: int): Expr { return Expr.Call(name, [Expr.Lit(Val.Int(i))], false) }

fn (p: mut &P) primary(): Result[Expr, lexdb_base.DbErr] {
    let t = p.next()
    if t.kind == T_IDENT && t.text == "case" { return p.caseExpr() }
    if t.kind == T_IDENT && t.text == "exists" && p.isKw("(") {
        p.pos += 1
        return Ok(subRef("#exists", try p.subquery(SUB_EXISTS)))
    }
    if t.kind == T_NUM {
        if !strings.contains(&t.text, ".") && !strings.contains(&t.text, "e") && !strings.contains(&t.text, "E") {
            match strings.parseIntOpt(t.text) {
                Some(n) { return Ok(Expr.Lit(Val.Int(n))) }
                None {}
            }
        }
        match Decimal.parse(t.text) {
            Ok(d) { return Ok(Expr.Lit(Val.Num(d))) }
            Err(_) { return Err(lexdb_base.err("22003", "numeric literal out of range: " + t.text)) }
        }
    }
    if t.kind == T_STR { return Ok(Expr.Lit(Val.Text(t.text))) }
    if t.kind == T_PARAM {
        let n = strings.parseIntOpt(t.text).unwrapOr(0)
        if n < 1 || n > 65535 { return Err(near(&t)) }
        if n > p.params { p.params = n }
        return Ok(Expr.Param(n))
    }
    if t.kind == T_OP && t.text == "(" {
        if p.isKw("select") || p.isKw("with") { return Ok(subRef("#sub", try p.subquery(SUB_SCALAR))) }
        let e = try p.expr()
        try p.expectKw(")")
        return Ok(e)
    }
    if t.kind == T_IDENT {
        match t.text {
            "null" { return Ok(Expr.Lit(Val.Null)) }
            "true" { return Ok(Expr.Lit(Val.Bool(true))) }
            "false" { return Ok(Expr.Lit(Val.Bool(false))) }
            "cast" {
                try p.expectKw("(")
                let e = try p.expr()
                try p.expectKw("as")
                let ty = try p.typeName()
                try p.expectKw(")")
                return Ok(Expr.Cast(e, ty))
            }
            else {}
        }
        // left( and right( are functions, as in PostgreSQL
        let fn2 = (t.text == "left" || t.text == "right") && p.isKw("(")
        if isReserved(&t.text) && !fn2 { return Err(near(&t)) }
    }
    if t.kind == T_IDENT || t.kind == T_QIDENT {
        if p.isKw("(") && t.kind == T_IDENT {
            p.pos += 1
            var args: []Expr = []
            var star = false
            var fname = t.text
            if p.acceptKw("*") {
                star = true
            } else if !p.isKw(")") {
                // agg(DISTINCT x): the name carries it, "count distinct"
                if p.acceptKw("distinct") { fname = fname + " distinct" } else { let al = p.acceptKw("all") }
                append(mut &args, try p.expr())
                while p.acceptKw(",") { append(mut &args, try p.expr()) }
            }
            try p.expectKw(")")
            if p.acceptKw("filter") {
                // agg(...) FILTER (WHERE cond): the condition is the last argument
                try p.expectKw("(")
                try p.expectKw("where")
                append(mut &args, try p.expr())
                try p.expectKw(")")
                fname = fname + " filter"
            }
            return Ok(Expr.Call(fname, args, star))
        }
        var name = t.text
        if p.acceptKw(".") {
            let col = try p.name()
            name = t.text + "." + col     // qualified: table (or alias) dot column
        }
        return Ok(Expr.Col(name))
    }
    return Err(near(&t))
}

// ---- statements

fn (p: mut &P) createTable(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_CREATE)
    if p.acceptKw("if") {
        try p.expectKw("not")
        try p.expectKw("exists")
        s.ifFlag = true
    }
    s.table = try p.name()
    try p.expectKw("(")
    while true {
        if p.acceptKw("primary") {
            try p.expectKw("key")
            try p.expectKw("(")
            append(mut &s.pk, try p.name())
            while p.acceptKw(",") { append(mut &s.pk, try p.name()) }
            try p.expectKw(")")
        } else {
            let n = try p.name()
            let ty = try p.typeName()
            var c = ColDef{name: n, typ: ty, notNull: false}
            while true {
                if p.acceptKw("not") {
                    try p.expectKw("null")
                    c.notNull = true
                } else if p.acceptKw("null") {
                } else if p.acceptKw("primary") {
                    try p.expectKw("key")
                    append(mut &s.pk, n)
                    c.notNull = true
                } else {
                    break
                }
            }
            append(mut &s.cols, c)
        }
        if !p.acceptKw(",") { break }
    }
    try p.expectKw(")")
    return Ok(s)
}

fn (p: mut &P) insert(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("into")
    var s = newStmt(S_INSERT)
    s.table = try p.name()
    if p.acceptKw("(") {
        append(mut &s.names, try p.name())
        while p.acceptKw(",") { append(mut &s.names, try p.name()) }
        try p.expectKw(")")
    }
    try p.expectKw("values")
    while true {
        try p.expectKw("(")
        var row: []Expr = []
        append(mut &row, try p.expr())
        while p.acceptKw(",") { append(mut &row, try p.expr()) }
        try p.expectKw(")")
        append(mut &s.rows, row)
        if !p.acceptKw(",") { break }
    }
    return Ok(s)
}

// SELECT, after its keyword: a query, or queries joined by UNION,
// INTERSECT (first) and EXCEPT; then ORDER BY, LIMIT and OFFSET, of the
// whole. The queries joined each keep their subqueries.
fn (p: mut &P) select(): Result[Stmt, lexdb_base.DbErr] {
    var first = try p.selectCore()
    if !p.isKw("union") && !p.isKw("intersect") && !p.isKw("except") {
        try p.orderLimit(mut &first)
        return Ok(first)
    }
    first.subs = replace(mut &p.subs, [])
    var lhs = try p.intersects(first)
    while p.isKw("union") || p.isKw("except") {
        var op = SET_EXCEPT
        if p.acceptKw("union") { op = SET_UNION } else { let x = p.acceptKw("except") }
        let all = p.setAll()
        let rhs = try p.intersects(try p.setBranch())
        lhs = setOf(op, all, lhs, rhs)
    }
    try p.orderLimit(mut &lhs)
    return Ok(lhs)
}

fn (p: mut &P) setAll(): bool {
    if p.acceptKw("all") { return true }
    let d = p.acceptKw("distinct")
    return false
}

fn setOf(op: int, all: bool, l: Stmt, r: Stmt): Stmt {
    var s = newStmt(S_SELECT)
    s.setop = op
    s.setAll = all
    append(mut &s.inner, l)
    append(mut &s.inner, r)
    return s
}

fn (p: mut &P) intersects(first: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var lhs = first
    while p.acceptKw("intersect") {
        let all = p.setAll()
        let rhs = try p.setBranch()
        lhs = setOf(SET_INTERSECT, all, lhs, rhs)
    }
    return Ok(lhs)
}

// One query of a UNION (and the like): SELECT ..., or one in parentheses
// with its own ORDER BY and LIMIT.
fn (p: mut &P) setBranch(): Result[Stmt, lexdb_base.DbErr] {
    var b = newStmt(S_SELECT)
    if p.acceptKw("(") {
        try p.expectKw("select")
        b = try p.select()
        try p.expectKw(")")
    } else {
        try p.expectKw("select")
        b = try p.selectCore()
    }
    b.subs = replace(mut &p.subs, [])
    return Ok(b)
}

// A query: the select list to HAVING.
fn (p: mut &P) selectCore(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_SELECT)
    if p.acceptKw("distinct") {
        if p.isKw("on") { return Err(lexdb_base.err("0A000", "SELECT DISTINCT ON is not supported")) }
        s.distinct = true
    } else {
        let all = p.acceptKw("all")
    }
    while true {
        let q = p.peek()
        if p.acceptKw("*") {
            append(mut &s.items, SelItem{star: true, qual: "", expr: None, alias: ""})
        } else if (q.kind == T_IDENT || q.kind == T_QIDENT) && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." &&
                  p.peekAt(2).kind == T_OP && p.peekAt(2).text == "*" {
            p.pos += 3
            append(mut &s.items, SelItem{star: true, qual: q.text, expr: None, alias: ""})
        } else {
            let e = try p.expr()
            var alias = ""
            if p.acceptKw("as") {
                alias = try p.name()
            } else {
                let t = p.peek()
                if t.kind == T_QIDENT || (t.kind == T_IDENT && !isReserved(&t.text)) {
                    alias = t.text
                    p.pos += 1
                }
            }
            append(mut &s.items, SelItem{star: false, qual: "", expr: Some(e), alias: alias})
        }
        if !p.acceptKw(",") { break }
    }
    if p.acceptKw("from") {
        append(mut &s.from, try p.fromItem(J_FIRST))
        while true {
            if p.acceptKw(",") {
                append(mut &s.from, try p.fromItem(J_CROSS))
            } else if p.acceptKw("cross") {
                try p.expectKw("join")
                append(mut &s.from, try p.fromItem(J_CROSS))
            } else if p.isKw("join") || p.isKw("inner") || p.isKw("left") || p.isKw("right") || p.isKw("full") {
                var kind = J_INNER
                if p.acceptKw("left") {
                    let o = p.acceptKw("outer")
                    kind = J_LEFT
                } else if p.acceptKw("right") {
                    let o = p.acceptKw("outer")
                    kind = J_RIGHT
                } else if p.acceptKw("full") {
                    let o = p.acceptKw("outer")
                    kind = J_FULL
                } else {
                    let i = p.acceptKw("inner")
                }
                try p.expectKw("join")
                var f = try p.fromItem(kind)
                try p.expectKw("on")
                f.on = Some(try p.expr())
                append(mut &s.from, f)
            } else if p.isKw("natural") {
                return Err(lexdb_base.err("0A000", "NATURAL joins are not supported"))
            } else {
                break
            }
        }
        s.table = s.from[0].table
    }
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    if p.acceptKw("group") {
        try p.expectKw("by")
        append(mut &s.group, try p.expr())
        while p.acceptKw(",") { append(mut &s.group, try p.expr()) }
    }
    if p.acceptKw("having") { s.having = Some(try p.expr()) }
    return Ok(s)
}

fn (p: mut &P) orderLimit(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("order") {
        try p.expectKw("by")
        while true {
            let e = try p.expr()
            var desc = false
            if p.acceptKw("desc") { desc = true } else { let a = p.acceptKw("asc") }
            append(mut &s.order, OrderItem{expr: e, desc: desc})
            if !p.acceptKw(",") { break }
        }
    }
    while p.isKw("limit") || p.isKw("offset") {
        if p.acceptKw("limit") {
            if p.acceptKw("all") { s.limit = None } else { s.limit = Some(try p.expr()) }
        } else {
            let o = p.acceptKw("offset")
            s.offset = Some(try p.expr())
            let r = p.acceptKw("rows") || p.acceptKw("row")
        }
    }
    return Ok(Unit{})
}

fn (p: mut &P) fromItem(join: int): Result[FromItem, lexdb_base.DbErr] {
    if p.acceptKw("(") {
        // a subquery in FROM
        if !p.isKw("select") && !p.isKw("with") { return Err(lexdb_base.err("0A000", "parenthesized joins are not supported")) }
        let i = try p.subquery(SUB_FROM)
        var alias = "unnamed_subquery"
        var cols: []str = []
        try p.aliasOf(mut &alias, mut &cols)
        return Ok(FromItem{table: "", alias: alias, join: join, on: None, sub: i, cols: cols, work: -1})
    }
    let table = try p.name()
    var alias = table
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols)
    // a CTE in scope (the innermost of the name) before a table
    var ci = -1
    for i in 0..len(p.ctes) { if p.ctes[i].name == table { ci = i } }
    if ci >= 0 {
        if len(cols) == 0 { for c in p.ctes[ci].cols { append(mut &cols, c) } }
        // in its own body: its working table
        for k in 0..len(p.inCte) {
            if p.inCte[k].id == p.ctes[ci].id {
                if p.inCte[k].depth != p.depth {
                    return Err(lexdb_base.err("42P19", "recursive reference to query \"" + table + "\" must not appear within a subquery"))
                }
                p.inCte[k].refs += 1
                return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: -1, cols: cols, work: p.ctes[ci].id})
            }
        }
        let i = try p.cteRef(ci)
        return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: i, cols: cols, work: -1})
    }
    if len(cols) > 0 { return Err(lexdb_base.err("0A000", "column aliases for a table are not supported")) }
    return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: -1, cols: cols, work: -1})
}

// [AS] alias [(column, ...)]
fn (p: mut &P) aliasOf(alias: mut &str, cols: mut &[]str): Result[Unit, lexdb_base.DbErr] {
    var got = false
    if p.acceptKw("as") {
        let old = replace(alias, try p.name())
        got = true
    } else {
        let t = p.peek()
        if t.kind == T_QIDENT || (t.kind == T_IDENT && !isReserved(&t.text)) {
            let old = replace(alias, t.text)
            p.pos += 1
            got = true
        }
    }
    if got && p.acceptKw("(") {
        append(cols, try p.name())
        while p.acceptKw(",") { append(cols, try p.name()) }
        try p.expectKw(")")
    }
    return Ok(Unit{})
}

fn (p: mut &P) createIndex(unique: bool): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_CREATE_INDEX)
    s.unique = unique
    if p.acceptKw("if") {
        try p.expectKw("not")
        try p.expectKw("exists")
        s.ifFlag = true
    }
    s.index = try p.name()
    try p.expectKw("on")
    s.table = try p.name()
    if p.acceptKw("using") {
        let m = try p.name()
        if m != "btree" { return Err(lexdb_base.err("0A000", "index method \"" + m + "\" is not supported")) }
    }
    try p.expectKw("(")
    append(mut &s.names, try p.name())
    while p.acceptKw(",") { append(mut &s.names, try p.name()) }
    try p.expectKw(")")
    if p.acceptKw("where") { s.where = Some(try p.expr()) }      // a filtered index
    return Ok(s)
}

fn (p: mut &P) update(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_UPDATE)
    s.table = try p.name()
    try p.expectKw("set")
    while true {
        let c = try p.name()
        try p.expectKw("=")
        let e = try p.expr()
        append(mut &s.sets, SetItem{col: c, expr: e})
        if !p.acceptKw(",") { break }
    }
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    return Ok(s)
}

fn (p: mut &P) delete(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("from")
    var s = newStmt(S_DELETE)
    s.table = try p.name()
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    return Ok(s)
}

fn (p: mut &P) statement(): Result[Stmt, lexdb_base.DbErr] {
    let t = p.peek()
    if t.kind == T_EOF || (t.kind == T_OP && t.text == ";") { return Ok(newStmt(S_EMPTY)) }
    if t.kind != T_IDENT { return Err(near(&t)) }
    p.pos += 1
    match t.text {
        "select" { return p.select() }
        "with" {
            let n = try p.withList()
            if !p.isKw("select") { return Err(lexdb_base.err("0A000", "WITH is supported before SELECT only")) }
            p.pos += 1
            let r = p.select()
            p.popCtes(n)
            return r
        }
        "insert" { return p.insert() }
        "update" { return p.update() }
        "delete" { return p.delete() }
        "create" {
            if p.acceptKw("table") { return p.createTable() }
            if p.acceptKw("index") { return p.createIndex(false) }
            if p.acceptKw("unique") {
                try p.expectKw("index")
                return p.createIndex(true)
            }
            return Err(lexdb_base.err("0A000", "only CREATE TABLE and CREATE INDEX are supported"))
        }
        "explain" {
            var s = newStmt(S_EXPLAIN)
            s.ifFlag = p.acceptKw("analyze")        // EXPLAIN ANALYZE: run it and count
            var inner = try p.statement()
            inner.subs = replace(mut &p.subs, [])
            inner.params = p.params
            if s.ifFlag && inner.kind != S_SELECT {
                return Err(lexdb_base.err("0A000", "EXPLAIN ANALYZE takes SELECT"))
            }
            if inner.kind != S_SELECT && inner.kind != S_UPDATE && inner.kind != S_DELETE {
                return Err(lexdb_base.err("0A000", "EXPLAIN takes SELECT, UPDATE or DELETE"))
            }
            append(mut &s.inner, inner)
            return Ok(s)
        }
        "drop" {
            if p.acceptKw("index") {
                var s = newStmt(S_DROP_INDEX)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.index = try p.name()
                return Ok(s)
            }
            try p.expectKw("table")
            var s = newStmt(S_DROP)
            if p.acceptKw("if") {
                try p.expectKw("exists")
                s.ifFlag = true
            }
            s.table = try p.name()
            return Ok(s)
        }
        "begin", "start" {
            if t.text == "start" { try p.expectKw("transaction") } else {
                let a = p.acceptKw("transaction") || p.acceptKw("work")
            }
            // READ ONLY makes a snapshot; ISOLATION LEVEL and the rest are
            // accepted (read-write blocks are serializable).
            var b = newStmt(S_BEGIN)
            while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") {
                if p.acceptKw("read") {
                    if p.acceptKw("only") { b.ifFlag = true } else { let wr = p.acceptKw("write") }
                } else {
                    p.pos += 1
                }
            }
            return Ok(b)
        }
        "commit", "end" {
            let a = p.acceptKw("transaction") || p.acceptKw("work")
            return Ok(newStmt(S_COMMIT))
        }
        "rollback", "abort" {
            let a = p.acceptKw("transaction") || p.acceptKw("work")
            return Ok(newStmt(S_ROLLBACK))
        }
        "set", "reset", "discard", "deallocate" {
            // lexdb's own settings: SET max_recursion = n, RESET max_recursion;
            // the rest are accepted and ignored
            var st = newStmt(S_SET)
            st.ifFlag = t.text == "reset"
            let u = p.acceptKw("session")
            if p.isKw("max_recursion") && (t.text == "set" || t.text == "reset") {
                p.pos += 1
                st.table = "max_recursion"
                if t.text == "set" {
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    if p.acceptKw("default") { st.limit = None } else { st.limit = Some(try p.expr()) }
                }
                return Ok(st)
            }
            p.skipToEnd()
            return Ok(st)
        }
        else {}
    }
    return Err(near(&t))
}

// Skips the rest of a statement (the options of BEGIN, a SET's value).
fn (p: mut &P) skipToEnd() {
    while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") { p.pos += 1 }
}

// Parses SQL text into its statements (separated by ;). params is the
// highest $n in each.
pub fn parse(sql: &str): Result[[]Stmt, lexdb_base.DbErr] {
    let toks = try lex(sql)
    var p = P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0}
    var out: []Stmt = []
    while true {
        p.params = 0
        p.subs = []
        p.ctes = []
        p.nextCte = 0
        p.inCte = []
        p.depth = 0
        var s = try p.statement()
        s.params = p.params
        if s.kind != S_EXPLAIN { s.subs = replace(mut &p.subs, []) }
        let t = p.peek()
        if t.kind == T_EOF {
            if s.kind != S_EMPTY || len(out) == 0 { append(mut &out, s) }
            break
        }
        if t.kind == T_OP && t.text == ";" {
            p.pos += 1
            if s.kind != S_EMPTY { append(mut &out, s) }
            continue
        }
        return Err(near(&t))
    }
    return Ok(out)
}

// ---- expressions as text: a filtered index's predicate is kept in the
// catalog so, and parsed again when the table is read.

fn typeText(t: &TypeName): str {
    if t.oid == OID_INT2 { return "smallint" }
    if t.oid == OID_INT4 { return "integer" }
    if t.oid == OID_INT8 { return "bigint" }
    if t.oid == OID_BOOL { return "boolean" }
    if t.kind == K_NUM {
        if t.prec > 0 { return "numeric(" + t.prec.toStr() + ", " + t.scale.toStr() + ")" }
        return "numeric"
    }
    if t.oid == OID_VARCHAR {
        if t.len > 0 { return "varchar(" + t.len.toStr() + ")" }
        return "varchar"
    }
    return "text"
}

fn quoteIdent(n: &str): str { return "\"" + strings.replaceAll(n, "\"", "\"\"") + "\"" }

// SQL text that parses back to x.
pub fn exprText(x: &Expr): str {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Null { return "null" }
                Val.Int(n) { return n.toStr() }
                Val.Bool(b) { return if b { "true" } else { "false" } }
                Val.Num(d) { return d.canonical() }
                Val.Text(t) { return "'" + strings.replaceAll(t, "'", "''") + "'" }
            }
        }
        Expr.Param(n) { return "$" + n.toStr() }
        Expr.Col(n) {
            let d = strings.indexOf(n, ".", 0)
            if d < 0 { return quoteIdent(&n) }
            return quoteIdent(&n[0..d]) + "." + quoteIdent(&n[d + 1..len(n)])
        }
        Expr.Unary(op, a) { return "(" + op + " " + exprText(&a) + ")" }
        Expr.Bin(op, a, b) { return "(" + exprText(&a) + " " + op + " " + exprText(&b) + ")" }
        Expr.IsNull(a, neg) { return "(" + exprText(&a) + (if neg { " is not null)" } else { " is null)" }) }
        Expr.Cast(a, t) { return "cast(" + exprText(&a) + " as " + typeText(&t) + ")" }
        Expr.Call(n, args, star) {
            if n == "#sub" || n == "#exists" || n == "#in" {
                // a subquery: by its number, from 1
                var i = 0
                match args[0] { Expr.Lit(v) { match v { Val.Int(k) { i = k } else {} } } else {} }
                let sq = "(subquery " + (i + 1).toStr() + ")"
                if n == "#sub" { return sq }
                if n == "#exists" { return "(exists " + sq + ")" }
                let at = if len(args) > 3 { 3 } else { 1 }
                return "(" + exprText(&args[at]) + " in " + sq + ")"
            }
            if n == "like" || n == "ilike" {
                var out = "(" + exprText(&args[0]) + " " + n + " " + exprText(&args[1])
                if len(args) > 2 { out = out + " escape " + exprText(&args[2]) }
                return out + ")"
            }
            if n == "in" {
                var parts: []str = []
                for i in 1..len(args) { append(mut &parts, exprText(&args[i])) }
                return "(" + exprText(&args[0]) + " in (" + strings.join(&parts, ", ") + "))"
            }
            if n == "distinct from" { return "(" + exprText(&args[0]) + " is distinct from " + exprText(&args[1]) + ")" }
            if n == "case" || n == "case else" {
                var out = "(case"
                var i = 0
                while i + 1 < len(args) {
                    out = out + " when " + exprText(&args[i]) + " then " + exprText(&args[i + 1])
                    i += 2
                }
                if n == "case else" { out = out + " else " + exprText(&args[len(args) - 1]) }
                return out + " end)"
            }
            // modifiers in the name: "count distinct filter"
            let words = strings.split(&n, " ")
            let base = words[0].toStr()
            let distinct = strings.contains(n, " distinct")
            let filtered = strings.contains(n, " filter")
            var parts: []str = []
            let last = if filtered { len(args) - 1 } else { len(args) }
            for i in 0..last { append(mut &parts, exprText(&args[i])) }
            var out = if star { base + "(*)" } else { base + "(" + (if distinct { "distinct " } else { "" }) + strings.join(&parts, ", ") + ")" }
            if filtered { out = out + " filter (where " + exprText(&args[len(args) - 1]) + ")" }
            return out
        }
    }
}

// One expression and nothing after it.
pub fn parseExpr(sql: &str): Result[Expr, lexdb_base.DbErr] {
    let toks = try lex(sql)
    var p = P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0}
    let x = try p.expr()
    let t = p.peek()
    if t.kind != T_EOF { return Err(near(&t)) }
    return Ok(x)
}

