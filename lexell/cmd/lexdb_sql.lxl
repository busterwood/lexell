// lexdb: SQL text to statements (design/lexdb.md 4.8): a lexer and a
// recursive-descent parser for the subset lexdb runs.
//
// Statements: CREATE TABLE (a primary key is required), DROP TABLE, INSERT
// ... VALUES, SELECT (one table or none; WHERE, GROUP BY, ORDER BY, LIMIT,
// OFFSET; aggregates), UPDATE, DELETE, BEGIN / START TRANSACTION, COMMIT /
// END, ROLLBACK, and SET (accepted and ignored). Names are folded to lower
// case unless quoted. Expressions: literals, $n parameters, columns
// (table.column too), + - * / % ||, comparisons, AND OR NOT, IS [NOT] NULL,
// casts (::type and CAST(x AS type)) and function calls.
import "strings"
import "./lexdb_base"

// Column kinds.
pub const K_INT = 1
pub const K_BOOL = 2
pub const K_NUM = 3
pub const K_TEXT = 4
pub const K_ARRAY = 5       // one dimension; its value is PostgreSQL's text form, {1,2,NULL} (9.27)

// Postgres type OIDs.
pub const OID_BOOL = 16
pub const OID_INT8 = 20
pub const OID_INT2 = 21
pub const OID_INT4 = 23
pub const OID_TEXT = 25
pub const OID_VARCHAR = 1043
pub const OID_NUMERIC = 1700
pub const OID_UNKNOWN = 705

// The array types: element OIDs and, at the same places, their arrays'.
const ELEM_OIDS: []int = [16, 21, 23, 25, 1043, 20, 1700]
const ARRAY_OIDS: []int = [1000, 1005, 1007, 1009, 1015, 1016, 1231]

// The array type of an element type (0: none).
pub fn arrayOid(elem: int): int {
    for i in 0..len(ELEM_OIDS) { if ELEM_OIDS[i] == elem { return ARRAY_OIDS[i] } }
    return 0
}

// The element type of an array type (0: not an array).
pub fn elemOid(arr: int): int {
    for i in 0..len(ARRAY_OIDS) { if ARRAY_OIDS[i] == arr { return ELEM_OIDS[i] } }
    return 0
}

pub type TypeName = value record {
    pub kind: int
    pub oid: int
    pub prec: int       // numeric precision, 0 when not given
    pub scale: int      // numeric scale
    pub len: int        // varchar length, 0 when not given
}

pub type Val = value closed {
    Null
    Int(int)
    Bool(bool)
    Num(Decimal)
    Text(str)
}

pub type Expr = closed {
    Lit(Val)
    Param(int)                  // $n, from 1
    Col(str)
    Unary(str, Expr)            // "-", "not"
    Bin(str, Expr, Expr)        // + - * / % || = <> < <= > >= and or
    IsNull(Expr, bool)          // IS NULL; true: IS NOT NULL
    Call(str, []Expr, bool)     // name, arguments, count(*)
    Cast(Expr, TypeName)
}

pub type ColDef = record {
    pub name: str
    pub typ: TypeName
    pub notNull: bool
    pub def: Option[Expr]       // a table's column: its DEFAULT (9.38)
    pub missing: Val            // a table's column: its value in rows written before it was added
    pub identity: int           // ID_*: SERIAL or an identity column (9.43)
    pub seq: str                // with one: the catalog key of its sequence, whose nextval is its default
}

// A column's sequence (ColDef.identity).
pub const ID_NONE = 0
pub const ID_BY_DEFAULT = 1     // GENERATED BY DEFAULT AS IDENTITY
pub const ID_ALWAYS = 2         // GENERATED ALWAYS AS IDENTITY: a value given is refused
pub const ID_SERIAL = 3         // serial, bigserial, smallserial

// A column with no default.
pub fn colDef(name: str, typ: TypeName, notNull: bool): ColDef {
    return ColDef{name: name, typ: typ, notNull: notNull, def: None, missing: Val.Null, identity: ID_NONE, seq: ""}
}

// A sequence's options as CREATE SEQUENCE, ALTER SEQUENCE and an identity
// column give them (9.43); has*: given.
pub type SeqOpts = record {
    pub typ: int                // AS: OID_INT2, OID_INT4, OID_INT8; 0 not given
    pub inc: int
    pub hasInc: bool
    pub min: int
    pub hasMin: int             // 0 not given, 1 MINVALUE n, 2 NO MINVALUE
    pub max: int
    pub hasMax: int
    pub start: int
    pub hasStart: bool
    pub restart: int            // ALTER: 0 not given, 1 RESTART, 2 RESTART WITH n (restartWith)
    pub restartWith: int
    pub cache: int              // 0 not given
    pub cycle: int              // 0 not given, 1 CYCLE, 2 NO CYCLE
    pub owned: []str            // OWNED BY: [table name, column]; ["", ""] NONE; [] not given
}

pub fn noSeqOpts(): SeqOpts {
    return SeqOpts{typ: 0, inc: 0, hasInc: false, min: 0, hasMin: 0, max: 0, hasMax: 0, start: 0, hasStart: false,
                   restart: 0, restartWith: 0, cache: 0, cycle: 0, owned: []}
}

// An identity column's sequence options.
pub type IdOpts = record { pub col: str; pub opts: SeqOpts }

// The DEFAULT keyword where a value goes (INSERT's VALUES, UPDATE's SET).
pub const DEFAULT_MARK: str = "#default"

pub fn isDefault(x: &Expr): bool {
    match x {
        Expr.Call(n, a, s) { return n == DEFAULT_MARK }
        else { return false }
    }
}

// A table constraint other than its key and NOT NULL (9.39).
pub const C_UNIQUE = 1
pub const C_CHECK = 2
pub const C_FOREIGN = 3

// A foreign key's action when the row it references is deleted or its key
// changed (9.41).
pub const FK_NO_ACTION = 0      // checked at the statement's end
pub const FK_RESTRICT = 1       // checked at once
pub const FK_CASCADE = 2
pub const FK_SET_NULL = 3
pub const FK_SET_DEFAULT = 4

pub type Constraint = record {
    pub kind: int
    pub name: str               // "" when not given: one is made
    pub cols: []str             // UNIQUE's, a foreign key's
    pub expr: Option[Expr]      // CHECK's
    pub refTable: str           // a foreign key's table and columns
    pub refCols: []str
    pub onDelete: int
    pub onUpdate: int
}

pub fn newConstraint(kind: int, name: str): Constraint {
    return Constraint{kind: kind, name: name, cols: [], expr: None, refTable: "", refCols: [], onDelete: 0, onUpdate: 0}
}

pub type SelItem = record {
    pub star: bool
    pub qual: str               // t.* : the table (or alias); "" for *
    pub expr: Option[Expr]
    pub alias: str
}

// A table in FROM: how it joins the ones before it.
pub const J_FIRST = 0
pub const J_INNER = 1
pub const J_LEFT = 2
pub const J_CROSS = 3
pub const J_RIGHT = 4
pub const J_FULL = 5

pub type FromItem = record {
    pub table: str
    pub alias: str              // the name its columns are qualified by
    pub join: int
    pub on: Option[Expr]
    pub sub: int                // a subquery (in FROM, or a CTE's): its number; -1: a table
    pub cols: []str             // names for its columns (AS x(a, b)); the rest keep theirs
    pub work: int               // a recursive CTE in its own body: the CTE's number (its working table); -1
    pub lateral: bool           // LATERAL: a subquery that sees the FROM items before it
}

// ORDER BY's item: NULLs first or last (by default last going up, first
// going down, as PostgreSQL).
pub type OrderItem = record { pub expr: Expr; pub desc: bool; pub nullsFirst: bool }

pub type SetItem = record { pub col: str; pub expr: Expr }

pub const S_EMPTY = 0
pub const S_CREATE = 1
pub const S_DROP = 2
pub const S_INSERT = 3
pub const S_SELECT = 4
pub const S_UPDATE = 5
pub const S_DELETE = 6
pub const S_BEGIN = 7
pub const S_COMMIT = 8
pub const S_ROLLBACK = 9
pub const S_SET = 10

// The settings lexdb keeps per session (lexdb_exec.Session); SET of any
// other is accepted and ignored.
pub const SETTINGS: []str = ["max_recursion", "statement_timeout", "max_statement_mem", "search_path"]
pub const S_CREATE_INDEX = 11
pub const S_DROP_INDEX = 12
pub const S_EXPLAIN = 13
pub const S_CREATE_SCHEMA = 14
pub const S_DROP_SCHEMA = 15
pub const S_SHOW = 16
pub const S_ALTER = 17
pub const S_ALTER_INDEX = 18    // ALTER INDEX index RENAME TO alters[0].name
pub const S_ALTER_SCHEMA = 19   // ALTER SCHEMA table RENAME TO alters[0].name
pub const S_CREATE_SEQ = 20     // CREATE SEQUENCE table, its options in seq (9.43)
pub const S_ALTER_SEQ = 21
pub const S_DROP_SEQ = 22
pub const S_COPY = 23           // COPY table [(names)] FROM STDIN / TO STDOUT, COPY (inner[0]) TO STDOUT (9.45)

// COPY's options (Stmt.copy).
pub type CopyOpts = record {
    pub from: bool              // FROM STDIN; else TO STDOUT
    pub csv: bool               // FORMAT csv; else text
    pub delim: str              // one byte
    pub null: str               // the text of a NULL
    pub header: bool
    pub quote: str              // CSV: one byte
    pub escape: str             // CSV: one byte
    pub forceQuote: []str       // CSV TO: these columns' values quoted always
    pub quoteAll: bool          // ... FORCE_QUOTE *: every column's
    pub forceNotNull: []str     // CSV FROM: these columns never NULL (o.null is a value)
    pub forceNull: []str        // CSV FROM: these columns NULL when o.null even quoted
}

fn noCopyOpts(): CopyOpts {
    return CopyOpts{from: false, csv: false, delim: "", null: "", header: false, quote: "", escape: "",
                    forceQuote: [], quoteAll: false, forceNotNull: [], forceNull: []}
}

// INSERT's OVERRIDING (Stmt.overriding).
pub const OVR_NONE = 0
pub const OVR_SYSTEM = 1        // OVERRIDING SYSTEM VALUE: an ALWAYS identity column takes the value given
pub const OVR_USER = 2          // OVERRIDING USER VALUE: identity columns take their defaults

// ALTER TABLE's actions (Alter.kind).
pub const A_ADD = 1             // ADD COLUMN
pub const A_RENAME_COL = 2      // RENAME COLUMN name TO to
pub const A_RENAME = 3          // RENAME TO name
pub const A_SET_NOT_NULL = 4    // ALTER COLUMN name SET NOT NULL
pub const A_DROP_NOT_NULL = 5   // ALTER COLUMN name DROP NOT NULL
pub const A_DROP_COL = 6        // DROP COLUMN name
pub const A_TYPE = 7            // ALTER COLUMN name TYPE col.typ [USING using]
pub const A_SET_SCHEMA = 8      // SET SCHEMA name
pub const A_SET_DEFAULT = 9     // ALTER COLUMN name SET DEFAULT col.def
pub const A_DROP_DEFAULT = 10   // ALTER COLUMN name DROP DEFAULT
pub const A_ADD_CON = 11        // ADD [CONSTRAINT name] UNIQUE (...) ...
pub const A_DROP_CON = 12       // DROP CONSTRAINT [IF EXISTS] name

pub type Alter = record {
    pub kind: int
    pub col: ColDef             // A_ADD: the column
    pub name: str               // the column changed; A_RENAME: the table's new name
    pub to: str                 // A_RENAME_COL: the column's new name
    pub ifFlag: bool            // ADD COLUMN IF NOT EXISTS, DROP COLUMN IF EXISTS
    pub using: Option[Expr]     // A_TYPE: the new value, of the row as it was
    pub cons: []Constraint      // A_ADD_CON: the constraint
    pub cascade: bool           // DROP COLUMN, DROP CONSTRAINT: CASCADE (foreign keys on it dropped)
}

// A qualified name, schema.name, as the parser gives it: the two joined by
// QSEP (an identifier never holds it, so "a.b" quoted stays one name).
pub const QSEP: str = "\x1f"

// public's names are kept unqualified: public.t is t.
pub fn qual(schema: &str, name: &str): str {
    if schema == "public" { return name }
    return schema + QSEP + name
}

// The schema part of a name (public: unqualified).
pub fn schemaOf(n: &str): str {
    let i = strings.indexOf(n, QSEP, 0)
    if i < 0 { return "public" }
    return n[0..i]
}

pub fn isQual(n: &str): bool { return strings.indexOf(n, QSEP, 0) >= 0 }

// The name part of a possibly qualified name.
pub fn baseName(n: &str): str {
    let i = strings.indexOf(n, QSEP, 0)
    if i < 0 { return n }
    return n[i + len(QSEP)..len(n)]
}

// A possibly qualified name as SQL shows it: schema.name.
pub fn shown(n: &str): str { return strings.replaceAll(n, QSEP, ".") }

pub type Stmt = record {
    pub kind: int
    pub table: str
    pub ifFlag: bool            // IF NOT EXISTS / IF EXISTS; BEGIN READ ONLY; EXPLAIN ANALYZE
    pub cols: []ColDef          // CREATE
    pub pk: []str
    pub names: []str            // INSERT's column list
    pub rows: [][]Expr          // INSERT's VALUES
    pub items: []SelItem        // SELECT; INSERT, UPDATE and DELETE: RETURNING's (9.44)
    pub where: Option[Expr]
    pub group: []Expr
    pub order: []OrderItem
    pub limit: Option[Expr]
    pub offset: Option[Expr]
    pub sets: []SetItem         // UPDATE
    pub params: int             // the highest $n
    pub from: []FromItem        // SELECT
    pub index: str              // CREATE INDEX / DROP INDEX: the index's name
    pub unique: bool
    pub inner: []Stmt           // EXPLAIN: the statement explained
    pub distinct: bool          // SELECT DISTINCT
    pub having: Option[Expr]
    pub subs: []Stmt            // its subqueries: an expression names one by number (#sub, #exists, #in)
    pub use: int                // a subquery: what it is used as (SUB_SCALAR, SUB_EXISTS, SUB_IN)
    pub setop: int              // UNION, INTERSECT or EXCEPT of inner[0] and inner[1] (SET_*); 0 none
    pub setAll: bool            // ... ALL
    pub cte: int                // a CTE where it is used: its number in the statement; -1 none
    pub rec: bool               // a recursive CTE: inner[1] reads its working table
    pub cascade: bool           // DROP SCHEMA, DROP TABLE ... CASCADE
    src: str                    // a scalar subquery: its tokens (one written twice is one subquery)
    pub srf: str                // in FROM, a function: generate_series or unnest; its arguments are items
    pub ordin: bool             // ... WITH ORDINALITY
    pub alters: []Alter         // ALTER TABLE: its actions, in order
    pub cons: []Constraint      // CREATE TABLE's constraints (UNIQUE, CHECK, FOREIGN KEY)
    pub seqNames: []str         // the sequences its nextval, currval and setval calls name (9.43)
    pub seq: SeqOpts            // CREATE and ALTER SEQUENCE's options
    pub idOpts: []IdOpts        // CREATE TABLE, ADD COLUMN: identity columns' sequence options
    pub overriding: int         // INSERT: OVR_*
    pub copy: CopyOpts          // COPY's
    pub wins: []WinDef          // its window calls: an expression names one by number (#win, 9.46)
    pub windows: []NamedWin     // WINDOW name AS (...), ...
}

// A window call: f(args) OVER (...). In its query's expressions it is
// Call("#win", [Lit(i), the call]), i its number in Stmt.wins (the call
// kept there for the column's name and type).
pub type WinDef = record {
    pub call: Expr              // Call(name, args, star), the name carrying " filter" and the like
    pub ref: str                // OVER w, OVER (w ...): the named window it starts from; "" none
    pub bare: bool              // OVER w (not in parentheses): the named window as it is, frame and all
    pub part: []Expr            // PARTITION BY
    pub order: []WinOrder       // ORDER BY
    pub frame: Frame
}

pub type WinOrder = record { pub expr: Expr; pub desc: bool; pub nullsFirst: bool }

pub type NamedWin = record { pub name: str; pub def: WinDef }

// A window's frame: FR_NONE (the default), or ROWS, RANGE or GROUPS
// BETWEEN start AND end (B_*), offsets for B_PRECEDING and B_FOLLOWING,
// and EXCLUDE (EX_*).
pub type Frame = record {
    pub mode: int
    pub start: int
    pub startOff: Option[Expr]
    pub end: int
    pub endOff: Option[Expr]
    pub exclude: int
}

pub const FR_NONE = 0
pub const FR_ROWS = 1
pub const FR_RANGE = 2
pub const FR_GROUPS = 3
pub const B_UNBOUNDED_PRECEDING = 1
pub const B_PRECEDING = 2
pub const B_CURRENT = 3
pub const B_FOLLOWING = 4
pub const B_UNBOUNDED_FOLLOWING = 5
pub const EX_NONE = 0
pub const EX_CURRENT = 1
pub const EX_GROUP = 2
pub const EX_TIES = 3

pub fn noFrame(): Frame {
    return Frame{mode: FR_NONE, start: B_UNBOUNDED_PRECEDING, startOff: None, end: B_CURRENT, endOff: None, exclude: EX_NONE}
}

pub const SET_UNION = 1
pub const SET_INTERSECT = 2
pub const SET_EXCEPT = 3

// What a subquery is used as.
pub const SUB_SCALAR = 1
pub const SUB_EXISTS = 2
pub const SUB_IN = 3
pub const SUB_FROM = 4          // in FROM: a subquery, or a CTE where it is used

fn newStmt(kind: int): Stmt {
    return Stmt{kind: kind, table: "", ifFlag: false, cols: [], pk: [], names: [], rows: [], items: [], where: None,
                group: [], order: [], limit: None, offset: None, sets: [], params: 0, from: [], index: "",
                unique: false, inner: [], distinct: false, having: None, subs: [], use: 0, setop: 0, setAll: false,
                cte: -1, rec: false, cascade: false, src: "", srf: "", ordin: false, alters: [], cons: [], seqNames: [], seq: noSeqOpts(), idOpts: [], overriding: OVR_NONE,
                copy: noCopyOpts(), wins: [], windows: []}
}

// ---- the lexer

const T_EOF = 0
const T_IDENT = 1        // folded to lower case
const T_QIDENT = 2       // "quoted"
const T_NUM = 3
const T_STR = 4
const T_PARAM = 5
const T_OP = 6

type Tok = value record { kind: int; text: str; at: int }

fn syntax(msg: str): lexdb_base.DbErr { return lexdb_base.err("42601", msg) }

fn isIdentStart(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c >= 128 }
fn isIdentChar(c: byte): bool { return isIdentStart(c) || (c >= '0' && c <= '9') || c == '$' }
fn isDigit(c: byte): bool { return c >= '0' && c <= '9' }

// A backslash escape's character, s[i] the one after the backslash, added
// to b: \b \f \n \r \t \v, \ooo octal, \xh[h] hex, else the character
// itself (E'' strings, COPY's text format). The index after it.
pub fn unescape(s: &str, i: int, b: mut &StrBuf): int {
    let c = s[i]
    if c == 'b' { b.addByte(byte(8)) }
    else if c == 'f' { b.addByte(byte(12)) }
    else if c == 'n' { b.addByte('\n') }
    else if c == 'r' { b.addByte('\r') }
    else if c == 't' { b.addByte('\t') }
    else if c == 'v' { b.addByte(byte(11)) }
    else if c >= '0' && c <= '7' {
        var v = 0
        var j = i
        while j < len(s) && j < i + 3 && s[j] >= '0' && s[j] <= '7' {
            v = v * 8 + (int(s[j]) - int('0'))
            j += 1
        }
        b.addByte(byte(v & 255))
        return j
    } else if c == 'x' && i + 1 < len(s) && hexVal(s[i + 1]) >= 0 {
        var v = hexVal(s[i + 1])
        var j = i + 2
        if j < len(s) && hexVal(s[j]) >= 0 {
            v = v * 16 + hexVal(s[j])
            j += 1
        }
        b.addByte(byte(v))
        return j
    } else { b.addByte(c) }
    return i + 1
}

fn hexVal(c: byte): int {
    if c >= '0' && c <= '9' { return int(c) - int('0') }
    if c >= 'a' && c <= 'f' { return int(c) - int('a') + 10 }
    if c >= 'A' && c <= 'F' { return int(c) - int('A') + 10 }
    return -1
}

fn lex(s: &str): Result[[]Tok, lexdb_base.DbErr] {
    var out: []Tok = []
    var i = 0
    let n = len(s)
    while i < n {
        let c = s[i]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 12 {
            i += 1
            continue
        }
        if c == '-' && i + 1 < n && s[i + 1] == '-' {
            while i < n && s[i] != '\n' { i += 1 }
            continue
        }
        if c == '/' && i + 1 < n && s[i + 1] == '*' {
            i += 2
            while i + 1 < n && !(s[i] == '*' && s[i + 1] == '/') { i += 1 }
            i += 2
            continue
        }
        let start = i
        if (c == 'e' || c == 'E') && i + 1 < n && s[i + 1] == '\'' {
            // E'...': an escape string (\n, \t, \\, \', octal, \xhh, ...)
            var b = newStrBuf()
            i += 2
            while true {
                if i >= n { return Err(syntax("unterminated quoted string")) }
                let d = s[i]
                if d == '\'' {
                    if i + 1 < n && s[i + 1] == '\'' {
                        b.addByte('\'')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                if d == '\\' && i + 1 < n {
                    i += 1
                    i = unescape(s, i, mut &b)
                    continue
                }
                b.addByte(d)
                i += 1
            }
            append(mut &out, Tok{kind: T_STR, text: b.toStr(), at: start})
            continue
        }
        if isIdentStart(c) {
            while i < n && isIdentChar(s[i]) { i += 1 }
            append(mut &out, Tok{kind: T_IDENT, text: strings.toLowerAscii(s[start..i]), at: start})
            continue
        }
        if c == '"' {
            var b = newStrBuf()
            i += 1
            while true {
                if i >= n { return Err(syntax("unterminated quoted identifier")) }
                if s[i] == '"' {
                    if i + 1 < n && s[i + 1] == '"' {
                        b.addByte('"')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                b.addByte(s[i])
                i += 1
            }
            append(mut &out, Tok{kind: T_QIDENT, text: b.toStr(), at: start})
            continue
        }
        if isDigit(c) || (c == '.' && i + 1 < n && isDigit(s[i + 1])) {
            while i < n && (isDigit(s[i]) || s[i] == '.') { i += 1 }
            if i < n && (s[i] == 'e' || s[i] == 'E') {
                i += 1
                if i < n && (s[i] == '+' || s[i] == '-') { i += 1 }
                while i < n && isDigit(s[i]) { i += 1 }
            }
            append(mut &out, Tok{kind: T_NUM, text: s[start..i], at: start})
            continue
        }
        if c == '\'' {
            var b = newStrBuf()
            i += 1
            while true {
                if i >= n { return Err(syntax("unterminated quoted string")) }
                if s[i] == '\'' {
                    if i + 1 < n && s[i + 1] == '\'' {
                        b.addByte('\'')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                b.addByte(s[i])
                i += 1
            }
            append(mut &out, Tok{kind: T_STR, text: b.toStr(), at: start})
            continue
        }
        if c == '$' && i + 1 < n && isDigit(s[i + 1]) {
            i += 1
            while i < n && isDigit(s[i]) { i += 1 }
            append(mut &out, Tok{kind: T_PARAM, text: s[start + 1..i], at: start})
            continue
        }
        // operators
        var op = s[i..i + 1]
        if i + 1 < n {
            let two = s[i..i + 2]
            if two == "<=" || two == ">=" || two == "<>" || two == "!=" || two == "||" || two == "::" { op = two }
        }
        if !strings.contains(&"(),;.*+-/%=<>|:![]", &op[0..1]) {
            return Err(syntax("syntax error at or near \"" + op + "\""))
        }
        i += len(op)
        append(mut &out, Tok{kind: T_OP, text: op, at: start})
    }
    append(mut &out, Tok{kind: T_EOF, text: "", at: n})
    return Ok(out)
}

// ---- the parser

type P = record {
    toks: []Tok
    pos: int
    params: int
    subs: []Stmt        // the subqueries of the statement being parsed
    ctes: []Cte         // the CTEs in scope, innermost last
    nextCte: int        // the statement's CTEs are numbered
    inCte: []InCte      // the recursive CTEs whose bodies are being parsed
    depth: int          // subqueries deep
    seqs: []str         // the sequences named by nextval, currval and setval so far
    wins: []WinDef      // the window calls of the query being parsed (9.46)
}

// A CTE: kept as its text (where its tokens start), parsed again as a
// subquery in FROM wherever it is used, seeing the CTEs before it (and a
// recursive one itself).
type Cte = record { name: str; cols: []str; start: int; id: int; rec: bool }

type InCte = record { id: int; depth: int; refs: int }

fn (p: &P) peek(): Tok { return p.toks[p.pos] }
fn (p: &P) peekAt(k: int): Tok {
    let i = if p.pos + k < len(p.toks) { p.pos + k } else { len(p.toks) - 1 }
    return p.toks[i]
}
fn (p: mut &P) next(): Tok {
    let t = p.toks[p.pos]
    if t.kind != T_EOF { p.pos += 1 }
    return t
}

fn near(t: &Tok): lexdb_base.DbErr {
    if t.kind == T_EOF { return syntax("syntax error at end of input") }
    return syntax("syntax error at or near \"" + t.text + "\"")
}

// Is the next token the keyword (or operator) w?
fn (p: &P) isKw(w: str): bool {
    let t = p.peek()
    return (t.kind == T_IDENT || t.kind == T_OP) && t.text == w
}

fn (p: mut &P) acceptKw(w: str): bool {
    if p.isKw(w) {
        p.pos += 1
        return true
    }
    return false
}

fn (p: mut &P) expectKw(w: str): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw(w) { return Ok(Unit{}) }
    return Err(near(&p.peek()))
}

const RESERVED: []str = ["select", "from", "where", "group", "order", "by", "limit", "offset", "and", "or", "not", "is",
                  "null", "as", "values", "set", "into", "insert", "update", "delete", "create", "table",
                  "primary", "key", "asc", "desc", "true", "false", "cast", "on", "join", "inner", "left",
                  "right", "full", "outer", "cross", "using", "natural", "having", "distinct", "in", "like", "ilike", "between",
                  "case", "when", "then", "else", "end", "union", "intersect", "except", "with", "returning", "window"]

fn isReserved(w: &str): bool {
    for r in RESERVED { if r == w { return true } }
    return false
}

fn (p: mut &P) name(): Result[str, lexdb_base.DbErr] {
    let t = p.peek()
    if t.kind == T_QIDENT || (t.kind == T_IDENT && !isReserved(&t.text)) {
        p.pos += 1
        return Ok(t.text)
    }
    return Err(near(&t))
}

// A table's (or an index's) name: name or schema.name (qual).
fn (p: mut &P) qname(): Result[str, lexdb_base.DbErr] {
    let first = try p.name()
    if p.acceptKw(".") { return Ok(qual(&first, &(try p.name()))) }
    return Ok(first)
}

fn (p: mut &P) typeName(): Result[TypeName, lexdb_base.DbErr] {
    let w = try p.name()
    var t = TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}
    match w {
        "int", "integer", "int4" { t = TypeName{kind: K_INT, oid: OID_INT4, prec: 0, scale: 0, len: 0} }
        "bigint", "int8" { t = TypeName{kind: K_INT, oid: OID_INT8, prec: 0, scale: 0, len: 0} }
        "smallint", "int2" { t = TypeName{kind: K_INT, oid: OID_INT2, prec: 0, scale: 0, len: 0} }
        "boolean", "bool" { t = TypeName{kind: K_BOOL, oid: OID_BOOL, prec: 0, scale: 0, len: 0} }
        "numeric", "decimal" { t = TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 0, scale: 0, len: 0} }
        "text" { t = TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0} }
        "regclass" { t = TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0} }     // a relation's name, as text
        "varchar" { t = TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: 0} }
        "character" {
            if p.acceptKw("varying") {
                t = TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: 0}
            } else {
                return Err(lexdb_base.err("0A000", "type character is not supported (use varchar or text)"))
            }
        }
        else { return Err(lexdb_base.err("42704", "type \"" + w + "\" does not exist")) }
    }
    if p.acceptKw("(") {
        let a = try p.intLit()
        if t.kind == K_NUM {
            t.prec = a
            if p.acceptKw(",") { t.scale = try p.intLit() }
            if t.prec < 1 || t.prec > 38 {
                return Err(lexdb_base.err("22023", "NUMERIC precision " + t.prec.toStr() + " must be between 1 and 38"))
            }
            if t.scale < 0 || t.scale > t.prec {
                return Err(lexdb_base.err("22023", "NUMERIC scale " + t.scale.toStr() + " must be between 0 and precision " + t.prec.toStr()))
            }
        } else if t.kind == K_TEXT {
            t.len = a
        } else {
            return Err(near(&p.toks[p.pos - 1]))
        }
        try p.expectKw(")")
    }
    if p.acceptKw("[") {
        // T[]: an array of T (its length, if given, is not kept: PostgreSQL
        // does not check it either)
        if p.peek().kind == T_NUM { let n = try p.intLit() }
        try p.expectKw("]")
        return Ok(TypeName{kind: K_ARRAY, oid: arrayOid(t.oid), prec: 0, scale: 0, len: 0})
    }
    return Ok(t)
}

fn (p: mut &P) intLit(): Result[int, lexdb_base.DbErr] {
    let t = p.next()
    if t.kind != T_NUM { return Err(near(&t)) }
    match strings.parseIntOpt(t.text) {
        Some(n) { return Ok(n) }
        None { return Err(near(&t)) }
    }
}

// ---- expressions, by precedence: OR, AND, NOT, comparison and IS, ||,
// + -, * / %, unary -, ::.

fn (p: mut &P) expr(): Result[Expr, lexdb_base.DbErr] { return p.orExpr() }

fn (p: mut &P) orExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.andExpr()
    while p.acceptKw("or") {
        let r = try p.andExpr()
        e = Expr.Bin("or", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) andExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.notExpr()
    while p.acceptKw("and") {
        let r = try p.notExpr()
        e = Expr.Bin("and", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) notExpr(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("not") {
        let e = try p.notExpr()
        return Ok(Expr.Unary("not", e))
    }
    return p.cmpExpr()
}

fn (p: mut &P) cmpExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.catExpr()
    let t = p.peek()
    if t.kind == T_OP && (t.text == "=" || t.text == "<>" || t.text == "!=" || t.text == "<" || t.text == "<=" ||
                          t.text == ">" || t.text == ">=") {
        p.pos += 1
        let op = if t.text == "!=" { "<>" } else { t.text }
        let q = p.peek()
        if q.kind == T_IDENT && (q.text == "any" || q.text == "some" || q.text == "all") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
            // x op ANY (array), x op ALL (array): the call "any op" or "all op"
            // (9.28); with a subquery, = ANY is IN and <> ALL is NOT IN
            let all = q.text == "all"
            p.pos += 2
            if p.isKw("select") || p.isKw("with") {
                if (op == "=" && !all) || (op == "<>" && all) {
                    let i = try p.subquery(SUB_IN)
                    return Ok(negate(all, Expr.Call("#in", [Expr.Lit(Val.Int(i)), e], false)))
                }
                return Err(lexdb_base.err("0A000", "lexdb: a subquery after ANY or ALL is supported with = ANY and <> ALL only"))
            }
            let arr = try p.expr()
            try p.expectKw(")")
            return Ok(Expr.Call((if all { "all " } else { "any " }) + op, [e, arr], false))
        }
        let r = try p.catExpr()
        return Ok(Expr.Bin(op, e, r))
    }
    // [NOT] LIKE, ILIKE, IN, BETWEEN
    var neg = false
    let nt = p.peekAt(1)
    if p.isKw("not") && nt.kind == T_IDENT && (nt.text == "like" || nt.text == "ilike" || nt.text == "in" || nt.text == "between") {
        p.pos += 1
        neg = true
    }
    if p.isKw("like") || p.isKw("ilike") {
        let kw = p.next().text
        var args: []Expr = [e]
        append(mut &args, try p.catExpr())
        if p.acceptKw("escape") { append(mut &args, try p.catExpr()) }
        return Ok(negate(neg, Expr.Call(kw, args, false)))
    }
    if p.acceptKw("in") {
        try p.expectKw("(")
        if p.isKw("select") || p.isKw("with") {
            let i = try p.subquery(SUB_IN)
            return Ok(negate(neg, Expr.Call("#in", [Expr.Lit(Val.Int(i)), e], false)))
        }
        var args: []Expr = [e]
        append(mut &args, try p.expr())
        while p.acceptKw(",") { append(mut &args, try p.expr()) }
        try p.expectKw(")")
        return Ok(negate(neg, Expr.Call("in", args, false)))
    }
    if p.acceptKw("between") {
        // a BETWEEN b AND c is a >= b AND a <= c: the planner knows those
        let lo = try p.catExpr()
        try p.expectKw("and")
        let hi = try p.catExpr()
        let again = cloneE(&e)
        return Ok(negate(neg, Expr.Bin("and", Expr.Bin(">=", e, lo), Expr.Bin("<=", again, hi))))
    }
    if neg { return Err(near(&p.peek())) }
    if p.acceptKw("is") {
        let isNot = p.acceptKw("not")
        if p.acceptKw("distinct") {
            try p.expectKw("from")
            let r = try p.catExpr()
            let d = Expr.Call("distinct from", [e, r], false)
            return Ok(if isNot { Expr.Unary("not", d) } else { d })
        }
        if p.acceptKw("null") { return Ok(Expr.IsNull(e, isNot)) }
        if p.acceptKw("true") {
            let x = Expr.Bin("=", e, Expr.Lit(Val.Bool(true)))
            return Ok(if isNot { Expr.Unary("not", x) } else { x })
        }
        if p.acceptKw("false") {
            let x = Expr.Bin("=", e, Expr.Lit(Val.Bool(false)))
            return Ok(if isNot { Expr.Unary("not", x) } else { x })
        }
        return Err(near(&p.peek()))
    }
    return Ok(e)
}

fn (p: mut &P) catExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.addExpr()
    while p.acceptKw("||") {
        let r = try p.addExpr()
        e = Expr.Bin("||", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) addExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.mulExpr()
    while p.isKw("+") || p.isKw("-") {
        let op = p.next().text
        let r = try p.mulExpr()
        e = Expr.Bin(op, e, r)
    }
    return Ok(e)
}

fn (p: mut &P) mulExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.unary()
    while p.isKw("*") || p.isKw("/") || p.isKw("%") {
        let op = p.next().text
        let r = try p.unary()
        e = Expr.Bin(op, e, r)
    }
    return Ok(e)
}

fn (p: mut &P) unary(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("-") {
        let e = try p.unary()
        return Ok(Expr.Unary("-", e))
    }
    if p.acceptKw("+") { return p.unary() }
    var e = try p.primary()
    while p.acceptKw("::") {
        let t = try p.typeName()
        e = Expr.Cast(e, t)
    }
    return Ok(e)
}

fn negate(neg: bool, x: Expr): Expr { return if neg { Expr.Unary("not", x) } else { x } }

fn cloneE(x: &Expr): Expr {
    match x {
        Expr.Lit(v) { return Expr.Lit(v) }
        Expr.Param(n) { return Expr.Param(n) }
        Expr.Col(n) { return Expr.Col(n) }
        Expr.Unary(op, a) { return Expr.Unary(op, cloneE(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, cloneE(&a), cloneE(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(cloneE(&a), neg) }
        Expr.Cast(a, t) { return Expr.Cast(cloneE(&a), t) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, cloneE(&a)) }
            return Expr.Call(n, out, star)
        }
    }
}

// CASE [x] WHEN a THEN b ... [ELSE c] END: a call "case" (or "case else")
// of the WHEN and THEN pairs, then the ELSE; CASE x WHEN a is WHEN x = a.
fn (p: mut &P) caseExpr(): Result[Expr, lexdb_base.DbErr] {
    var operand: []Expr = []
    if !p.isKw("when") { append(mut &operand, try p.expr()) }
    var args: []Expr = []
    while p.acceptKw("when") {
        var w = try p.expr()
        if len(operand) > 0 { w = Expr.Bin("=", cloneE(&operand[0]), w) }
        try p.expectKw("then")
        append(mut &args, w)
        append(mut &args, try p.expr())
    }
    if len(args) == 0 { return Err(near(&p.peek())) }
    var name = "case"
    if p.acceptKw("else") {
        append(mut &args, try p.expr())
        name = "case else"
    }
    try p.expectKw("end")
    return Ok(Expr.Call(name, args, false))
}

// A subquery, after its "(": its own subqueries go with it, and the
// statement it is in gets it, numbered.
fn (p: mut &P) subquery(use: int): Result[int, lexdb_base.DbErr] {
    p.depth += 1
    let start = p.pos
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var pushed = 0
    if p.acceptKw("with") { pushed = try p.withList() }
    try p.expectKw("select")
    var sq = try p.select()
    p.popCtes(pushed)
    sq.subs = replace(mut &p.subs, saved)
    sq.wins = replace(mut &p.wins, savedW)
    sq.use = use
    p.depth -= 1
    // a scalar subquery written again in the same query is the same one:
    // GROUP BY (subquery) then matches it in the select list, and it runs
    // once per row
    if use == SUB_SCALAR {
        var kb = newStrBuf()
        for i in start..p.pos {
            kb.add(p.toks[i].kind.toStr())
            kb.addByte(1)
            kb.add(p.toks[i].text)
            kb.addByte(0)
        }
        sq.src = kb.toStr()
        for i in 0..len(p.subs) {
            if p.subs[i].use == SUB_SCALAR && p.subs[i].src == sq.src {
                try p.expectKw(")")
                return Ok(i)
            }
        }
    }
    try p.expectKw(")")
    append(mut &p.subs, sq)
    return Ok(len(p.subs) - 1)
}

// WITH's list, after "with": the CTEs go in scope (how many: the result).
// Each is parsed now to check it, and again where it is used.
fn (p: mut &P) withList(): Result[int, lexdb_base.DbErr] {
    let rec = p.acceptKw("recursive")
    var n = 0
    while true {
        let name = try p.name()
        var cols: []str = []
        if p.acceptKw("(") {
            append(mut &cols, try p.name())
            while p.acceptKw(",") { append(mut &cols, try p.name()) }
            try p.expectKw(")")
        }
        try p.expectKw("as")
        if p.acceptKw("not") { try p.expectKw("materialized") } else { let m = p.acceptKw("materialized") }
        try p.expectKw("(")
        for k in len(p.ctes) - n..len(p.ctes) {
            if p.ctes[k].name == name {
                return Err(lexdb_base.err("42712", "WITH query name \"" + name + "\" specified more than once"))
            }
        }
        let id = p.nextCte
        p.nextCte += 1
        let start = p.pos
        // a recursive one is in scope in its own body
        if rec {
            var cs: []str = []
            for c in cols { append(mut &cs, c) }
            append(mut &p.ctes, Cte{name: name, cols: cs, start: start, id: id, rec: true})
        }
        let keep = len(p.subs)
        if rec { append(mut &p.inCte, InCte{id: id, depth: p.depth + 1, refs: 0}) }
        let i = try p.subquery(SUB_FROM)
        if rec { let x = pop(mut &p.inCte) }
        while len(p.subs) > keep { let x = pop(mut &p.subs) }
        if !rec { append(mut &p.ctes, Cte{name: name, cols: cols, start: start, id: id, rec: false}) }
        n += 1
        if !p.acceptKw(",") { break }
    }
    return Ok(n)
}

fn (p: mut &P) popCtes(n: int) { for i in 0..n { let c = pop(mut &p.ctes) } }

// A use of CTE ci: its text parsed again, here, with the CTEs before it in
// scope.
fn (p: mut &P) cteRef(ci: int): Result[int, lexdb_base.DbErr] {
    let saved = replace(mut &p.ctes, [])
    let rec = saved[ci].rec
    let id = saved[ci].id
    let upto = if rec { ci + 1 } else { ci }
    for i in 0..upto {
        var cols: []str = []
        for c in saved[i].cols { append(mut &cols, c) }
        append(mut &p.ctes, Cte{name: saved[i].name, cols: cols, start: saved[i].start, id: saved[i].id, rec: saved[i].rec})
    }
    let pos = p.pos
    p.pos = saved[ci].start
    if rec { append(mut &p.inCte, InCte{id: id, depth: p.depth + 1, refs: 0}) }
    let r = p.subquery(SUB_FROM)
    var selfRefs = 0
    if rec { selfRefs = pop(mut &p.inCte).refs }
    p.pos = pos
    p.ctes = saved
    let i = try r
    p.subs[i].cte = id
    p.subs[i].rec = selfRefs > 0
    return Ok(i)
}

fn subRef(name: str, i: int): Expr { return Expr.Call(name, [Expr.Lit(Val.Int(i))], false) }

fn (p: mut &P) primary(): Result[Expr, lexdb_base.DbErr] {
    let t = p.next()
    if t.kind == T_IDENT && t.text == "case" { return p.caseExpr() }
    if t.kind == T_IDENT && t.text == "array" && p.isKw("[") {
        // ARRAY[a, b, ...]: an array of the values
        p.pos += 1
        var xs: []Expr = []
        if !p.isKw("]") {
            append(mut &xs, try p.expr())
            while p.acceptKw(",") { append(mut &xs, try p.expr()) }
        }
        try p.expectKw("]")
        return Ok(Expr.Call("array", xs, false))
    }
    if t.kind == T_IDENT && t.text == "exists" && p.isKw("(") {
        p.pos += 1
        return Ok(subRef("#exists", try p.subquery(SUB_EXISTS)))
    }
    if t.kind == T_NUM {
        if !strings.contains(&t.text, ".") && !strings.contains(&t.text, "e") && !strings.contains(&t.text, "E") {
            match strings.parseIntOpt(t.text) {
                Some(n) { return Ok(Expr.Lit(Val.Int(n))) }
                None {}
            }
        }
        match Decimal.parse(t.text) {
            Ok(d) { return Ok(Expr.Lit(Val.Num(d))) }
            Err(_) { return Err(lexdb_base.err("22003", "numeric literal out of range: " + t.text)) }
        }
    }
    if t.kind == T_STR { return Ok(Expr.Lit(Val.Text(t.text))) }
    if t.kind == T_PARAM {
        let n = strings.parseIntOpt(t.text).unwrapOr(0)
        if n < 1 || n > 65535 { return Err(near(&t)) }
        if n > p.params { p.params = n }
        return Ok(Expr.Param(n))
    }
    if t.kind == T_OP && t.text == "(" {
        if p.isKw("select") || p.isKw("with") { return Ok(subRef("#sub", try p.subquery(SUB_SCALAR))) }
        let e = try p.expr()
        try p.expectKw(")")
        return Ok(e)
    }
    if t.kind == T_IDENT {
        match t.text {
            "null" { return Ok(Expr.Lit(Val.Null)) }
            "true" { return Ok(Expr.Lit(Val.Bool(true))) }
            "false" { return Ok(Expr.Lit(Val.Bool(false))) }
            "cast" {
                try p.expectKw("(")
                let e = try p.expr()
                try p.expectKw("as")
                let ty = try p.typeName()
                try p.expectKw(")")
                return Ok(Expr.Cast(e, ty))
            }
            else {}
        }
        // left( and right( are functions, as in PostgreSQL
        let fn2 = (t.text == "left" || t.text == "right") && p.isKw("(")
        if isReserved(&t.text) && !fn2 { return Err(near(&t)) }
    }
    if t.kind == T_IDENT || t.kind == T_QIDENT {
        if p.isKw("(") && t.kind == T_IDENT {
            p.pos += 1
            var args: []Expr = []
            var star = false
            var fname = t.text
            if p.acceptKw("*") {
                star = true
            } else if !p.isKw(")") {
                // agg(DISTINCT x): the name carries it, "count distinct"
                if p.acceptKw("distinct") { fname = fname + " distinct" } else { let al = p.acceptKw("all") }
                append(mut &args, try p.expr())
                while p.acceptKw(",") { append(mut &args, try p.expr()) }
                if p.acceptKw("order") {
                    // agg(x ORDER BY k [ASC | DESC] [NULLS FIRST | LAST], ...): the
                    // keys follow the arguments, the name carries their order:
                    // a ascending (NULLs last), A with NULLs first, d
                    // descending (NULLs first), D with NULLs last
                    try p.expectKw("by")
                    var dirs = ""
                    while true {
                        append(mut &args, try p.expr())
                        var desc = false
                        if p.acceptKw("desc") { desc = true } else { let asc = p.acceptKw("asc") }
                        var flip = false
                        if p.acceptKw("nulls") {
                            if p.acceptKw("first") { flip = !desc } else {
                                try p.expectKw("last")
                                flip = desc
                            }
                        }
                        dirs = dirs + (if desc { if flip { "D" } else { "d" } } else { if flip { "A" } else { "a" } })
                        if !p.acceptKw(",") { break }
                    }
                    fname = fname + " order:" + dirs
                }
            }
            try p.expectKw(")")
            if p.acceptKw("filter") {
                // agg(...) FILTER (WHERE cond): the condition is the last argument
                try p.expectKw("(")
                try p.expectKw("where")
                append(mut &args, try p.expr())
                try p.expectKw(")")
                fname = fname + " filter"
            }
            if (fname == "nextval" || fname == "currval" || fname == "setval") && len(args) > 0 {
                match litText(&args[0]) {
                    Some(n) { append(mut &p.seqs, n) }
                    None {}
                }
            }
            if p.acceptKw("over") {
                // a window call (9.46): kept in the query, named here by number
                var d = try p.over()
                var copied: []Expr = []
                for a in args { append(mut &copied, cloneE(&a)) }
                d.call = Expr.Call(fname, copied, star)
                append(mut &p.wins, d)
                return Ok(Expr.Call("#win", [Expr.Lit(Val.Int(len(p.wins) - 1)), Expr.Call(fname, args, star)], false))
            }
            return Ok(Expr.Call(fname, args, star))
        }
        var name = t.text
        if p.acceptKw(".") {
            let col = try p.name()
            name = t.text + "." + col     // qualified: table (or alias) dot column
            if p.acceptKw(".") {
                // schema.table.column: the table's columns are qualified by
                // its name in FROM (lenient: the schema is not checked)
                let c3 = try p.name()
                name = col + "." + c3
            }
        }
        return Ok(Expr.Col(name))
    }
    return Err(near(&t))
}

// ---- statements

fn (p: mut &P) createTable(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_CREATE)
    if p.acceptKw("if") {
        try p.expectKw("not")
        try p.expectKw("exists")
        s.ifFlag = true
    }
    s.table = try p.qname()
    try p.expectKw("(")
    while true {
        var cname = ""
        if p.acceptKw("constraint") { cname = try p.name() }
        if p.acceptKw("primary") {
            try p.expectKw("key")
            try p.expectKw("(")
            append(mut &s.pk, try p.name())
            while p.acceptKw(",") { append(mut &s.pk, try p.name()) }
            try p.expectKw(")")
        } else if len(cname) > 0 || p.isKw("unique") || p.isKw("check") || p.isKw("foreign") || p.isKw("exclude") {
            append(mut &s.cons, try p.tableConstraint(cname))
        } else {
            let n = try p.name()
            var c = noCol()
            c.name = n
            try p.colType(mut &c)
            while true {
                // CONSTRAINT name names the one after it (a UNIQUE's; the
                // others' names are not kept)
                var cn = ""
                if p.acceptKw("constraint") { cn = try p.name() }
                if p.acceptKw("not") {
                    try p.expectKw("null")
                    c.notNull = true
                } else if p.acceptKw("null") {
                } else if p.acceptKw("primary") {
                    try p.expectKw("key")
                    append(mut &s.pk, n)
                    c.notNull = true
                } else if p.acceptKw("default") {
                    c.def = Some(try p.defaultExpr())
                } else if p.acceptKw("generated") {
                    try p.identity(mut &c, mut &s)
                } else if p.acceptKw("unique") {
                    try p.uniqueTail()
                    var u = newConstraint(C_UNIQUE, cn)
                    append(mut &u.cols, n)
                    append(mut &s.cons, u)
                } else if p.acceptKw("check") {
                    var ck = try p.checkTail(cn)
                    append(mut &ck.cols, n)         // a column's: named for it
                    append(mut &s.cons, ck)
                } else if p.acceptKw("references") {
                    var fk = newConstraint(C_FOREIGN, cn)
                    append(mut &fk.cols, n)
                    try p.fkTail(mut &fk)
                    append(mut &s.cons, fk)
                } else if len(cn) > 0 {
                    return Err(near(&p.peek()))
                } else {
                    break
                }
            }
            append(mut &s.cols, c)
        }
        if !p.acceptKw(",") { break }
    }
    try p.expectKw(")")
    return Ok(s)
}

// A table constraint, after [CONSTRAINT name]: UNIQUE (cols), CHECK (expr)
// or FOREIGN KEY (cols) REFERENCES ....
fn (p: mut &P) tableConstraint(name: str): Result[Constraint, lexdb_base.DbErr] {
    if p.acceptKw("check") { return p.checkTail(name) }
    if p.acceptKw("foreign") {
        try p.expectKw("key")
        var c = newConstraint(C_FOREIGN, name)
        try p.expectKw("(")
        append(mut &c.cols, try p.name())
        while p.acceptKw(",") { append(mut &c.cols, try p.name()) }
        try p.expectKw(")")
        try p.expectKw("references")
        try p.fkTail(mut &c)
        return Ok(c)
    }
    if p.acceptKw("unique") {
        var c = newConstraint(C_UNIQUE, name)
        try p.uniqueTail()
        try p.expectKw("(")
        append(mut &c.cols, try p.name())
        while p.acceptKw(",") { append(mut &c.cols, try p.name()) }
        try p.expectKw(")")
        return Ok(c)
    }
    return Err(p.notYet())
}

// After UNIQUE: NULLS [NOT] DISTINCT (only the default, DISTINCT, is lexdb's).
fn (p: mut &P) uniqueTail(): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("nulls") {
        if p.acceptKw("not") { return Err(lexdb_base.err("0A000", "lexdb: UNIQUE NULLS NOT DISTINCT is not supported")) }
        try p.expectKw("distinct")
    }
    return Ok(Unit{})
}

// After CHECK: (expr) [NO INHERIT]. No subquery or parameter; NOT VALID is
// not lexdb's (rows there are always checked).
fn (p: mut &P) checkTail(name: str): Result[Constraint, lexdb_base.DbErr] {
    var c = newConstraint(C_CHECK, name)
    try p.expectKw("(")
    let subs = len(p.subs)
    let params = p.params
    c.expr = Some(try p.expr())
    if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in check constraint")) }
    if p.params > params { return Err(lexdb_base.err("42P02", "there is no parameter $" + p.params.toStr())) }
    try p.expectKw(")")
    if p.acceptKw("no") { try p.expectKw("inherit") }
    if p.isKw("not") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "valid" {
        return Err(lexdb_base.err("0A000", "lexdb: NOT VALID is not supported (the rows there are checked)"))
    }
    return Ok(c)
}

// After REFERENCES: table [(cols)], then in any order MATCH SIMPLE, ON
// DELETE action, ON UPDATE action, [NOT] DEFERRABLE, INITIALLY IMMEDIATE.
// MATCH FULL and PARTIAL and deferred checks are not lexdb's.
fn (p: mut &P) fkTail(c: mut &Constraint): Result[Unit, lexdb_base.DbErr] {
    c.refTable = try p.qname()
    if p.acceptKw("(") {
        append(mut &c.refCols, try p.name())
        while p.acceptKw(",") { append(mut &c.refCols, try p.name()) }
        try p.expectKw(")")
    }
    while true {
        if p.acceptKw("match") {
            if p.isKw("full") || p.isKw("partial") {
                return Err(lexdb_base.err("0A000", "lexdb: MATCH FULL and MATCH PARTIAL are not supported (MATCH SIMPLE is)"))
            }
            try p.expectKw("simple")
        } else if p.isKw("on") && p.pos + 1 < len(p.toks) && (p.toks[p.pos + 1].text == "delete" || p.toks[p.pos + 1].text == "update") {
            p.pos += 1
            let del = p.acceptKw("delete")
            if !del { try p.expectKw("update") }
            let act = try p.fkAction()
            if del { c.onDelete = act } else { c.onUpdate = act }
        } else if p.acceptKw("deferrable") {
            return Err(lexdb_base.err("0A000", "lexdb: deferrable constraints are not supported"))
        } else if p.isKw("not") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].text == "deferrable" {
            p.pos += 2
        } else if p.acceptKw("initially") {
            if p.isKw("deferred") { return Err(lexdb_base.err("0A000", "lexdb: deferrable constraints are not supported")) }
            try p.expectKw("immediate")
        } else {
            break
        }
    }
    return Ok(Unit{})
}

fn (p: mut &P) fkAction(): Result[int, lexdb_base.DbErr] {
    if p.acceptKw("no") {
        try p.expectKw("action")
        return Ok(FK_NO_ACTION)
    }
    if p.acceptKw("restrict") { return Ok(FK_RESTRICT) }
    if p.acceptKw("cascade") { return Ok(FK_CASCADE) }
    try p.expectKw("set")
    var act = FK_SET_NULL
    if !p.acceptKw("null") {
        try p.expectKw("default")
        act = FK_SET_DEFAULT
    }
    if p.isKw("(") { return Err(lexdb_base.err("0A000", "lexdb: SET NULL and SET DEFAULT of some columns are not supported")) }
    return Ok(act)
}

fn (p: &P) notYet(): lexdb_base.DbErr {
    if p.isKw("exclude") { return lexdb_base.err("0A000", "lexdb: EXCLUDE constraints are not supported") }
    return near(&p.peek())
}

// A text literal, or one cast ('s'::regclass): its text.
pub fn litText(x: &Expr): Option[str] {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Text(t) { return Some(t) }
                else { return None }
            }
        }
        Expr.Cast(a, _) { return litText(&a) }
        else { return None }
    }
}

// A column's type: serial, bigserial and smallserial are integers taking
// their defaults from a sequence of their own.
fn (p: mut &P) colType(c: mut &ColDef): Result[Unit, lexdb_base.DbErr] {
    let w = p.peek()
    if w.kind == T_IDENT {
        var oid = 0
        if w.text == "serial" || w.text == "serial4" { oid = OID_INT4 }
        if w.text == "bigserial" || w.text == "serial8" { oid = OID_INT8 }
        if w.text == "smallserial" || w.text == "serial2" { oid = OID_INT2 }
        if oid != 0 {
            p.pos += 1
            c.typ = TypeName{kind: K_INT, oid: oid, prec: 0, scale: 0, len: 0}
            c.identity = ID_SERIAL
            c.notNull = true
            return Ok(Unit{})
        }
    }
    c.typ = try p.typeName()
    return Ok(Unit{})
}

// After GENERATED: {ALWAYS | BY DEFAULT} AS IDENTITY [(options)].
fn (p: mut &P) identity(c: mut &ColDef, s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("always") {
        c.identity = ID_ALWAYS
    } else {
        try p.expectKw("by")
        try p.expectKw("default")
        c.identity = ID_BY_DEFAULT
    }
    try p.expectKw("as")
    if p.isKw("(") { return Err(lexdb_base.err("0A000", "lexdb: generated columns are not supported")) }
    try p.expectKw("identity")
    c.notNull = true
    if p.acceptKw("(") {
        var o = noSeqOpts()
        try p.seqOptions(mut &o, false)
        try p.expectKw(")")
        append(mut &s.idOpts, IdOpts{col: c.name, opts: o})
    }
    return Ok(Unit{})
}

// Sequence options, in any order, until none follows.
fn (p: mut &P) seqOptions(o: mut &SeqOpts, alter: bool): Result[Unit, lexdb_base.DbErr] {
    while true {
        if p.acceptKw("as") {
            let t = try p.typeName()
            if t.kind != K_INT { return Err(lexdb_base.err("22023", "sequence type must be smallint, integer, or bigint")) }
            o.typ = t.oid
        } else if p.acceptKw("increment") {
            let by = p.acceptKw("by")
            o.inc = try p.signedInt()
            o.hasInc = true
        } else if p.acceptKw("minvalue") {
            o.min = try p.signedInt()
            o.hasMin = 1
        } else if p.acceptKw("maxvalue") {
            o.max = try p.signedInt()
            o.hasMax = 1
        } else if p.isKw("no") && p.pos + 1 < len(p.toks) && (p.toks[p.pos + 1].text == "minvalue" || p.toks[p.pos + 1].text == "maxvalue" || p.toks[p.pos + 1].text == "cycle") {
            p.pos += 1
            if p.acceptKw("minvalue") {
                o.hasMin = 2
            } else if p.acceptKw("maxvalue") {
                o.hasMax = 2
            } else {
                try p.expectKw("cycle")
                o.cycle = 2
            }
        } else if p.acceptKw("start") {
            let w = p.acceptKw("with")
            o.start = try p.signedInt()
            o.hasStart = true
        } else if alter && p.acceptKw("restart") {
            o.restart = 1
            let w = p.acceptKw("with")
            if w || p.peek().kind == T_NUM || p.isKw("-") {
                o.restart = 2
                o.restartWith = try p.signedInt()
            }
        } else if p.acceptKw("cache") {
            o.cache = try p.signedInt()
            if o.cache < 1 { return Err(lexdb_base.err("22023", "CACHE (" + o.cache.toStr() + ") must be greater than zero")) }
        } else if p.acceptKw("cycle") {
            o.cycle = 1
        } else if p.acceptKw("owned") {
            try p.expectKw("by")
            if p.acceptKw("none") {
                o.owned = ["", ""]
            } else {
                // table.column, schema.table.column
                var ns = [try p.name()]
                while p.acceptKw(".") { append(mut &ns, try p.name()) }
                if len(ns) < 2 || len(ns) > 3 { return Err(lexdb_base.err("42601", "invalid OWNED BY option (table.column or OWNED BY NONE)")) }
                let col = pop(mut &ns)
                var tn = ns[0]
                if len(ns) == 2 { tn = qual(&ns[0], &ns[1]) }
                o.owned = [tn, col]
            }
        } else {
            break
        }
    }
    return Ok(Unit{})
}

// An integer literal, perhaps negative.
fn (p: mut &P) signedInt(): Result[int, lexdb_base.DbErr] {
    let neg = p.acceptKw("-")
    let n = try p.intLit()
    return Ok(if neg { -n } else { n })
}

// CREATE SEQUENCE, after SEQUENCE; ALTER SEQUENCE, after SEQUENCE.
fn (p: mut &P) seqStmt(kind: int): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(kind)
    if p.acceptKw("if") {
        if kind == S_CREATE_SEQ { try p.expectKw("not") }
        try p.expectKw("exists")
        s.ifFlag = true
    }
    s.table = try p.qname()
    if kind == S_ALTER_SEQ && (p.isKw("rename") || p.isKw("set") || p.isKw("owner")) {
        return Err(lexdb_base.err("0A000", "lexdb: ALTER SEQUENCE takes its options (RESTART, INCREMENT, ...), not RENAME, SET or OWNER"))
    }
    try p.seqOptions(mut &s.seq, kind == S_ALTER_SEQ)
    return Ok(s)
}

fn noCol(): ColDef { return colDef("", TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}, false) }

// A DEFAULT's expression: no subquery, no parameter (column references and
// aggregates are refused where the table is known).
fn (p: mut &P) defaultExpr(): Result[Expr, lexdb_base.DbErr] {
    let subs = len(p.subs)
    let params = p.params
    let x = try p.catExpr()      // no NOT, AND or IS at the top: "DEFAULT 1 NOT NULL" 
    if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in DEFAULT expression")) }
    if p.params > params { return Err(lexdb_base.err("42P02", "there is no parameter $" + p.params.toStr())) }
    return Ok(x)
}

// A value, or DEFAULT (INSERT's VALUES, UPDATE's SET).
fn (p: mut &P) valueOrDefault(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("default") { return Ok(Expr.Call(DEFAULT_MARK, [], false)) }
    return p.expr()
}

// ALTER TABLE [IF EXISTS] [ONLY] name, then RENAME [COLUMN] a TO b,
// RENAME TO name or SET SCHEMA name (each alone), or actions separated by commas: ADD
// [COLUMN] [IF NOT EXISTS] name type [NOT NULL | NULL], DROP [COLUMN] [IF
// EXISTS] name [RESTRICT | CASCADE], ALTER [COLUMN] name [SET DATA] TYPE
// type [USING expr], ALTER [COLUMN] name SET NOT NULL or DROP NOT NULL.
fn (p: mut &P) alterTable(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_ALTER)
    if p.acceptKw("if") {
        try p.expectKw("exists")
        s.ifFlag = true
    }
    let only = p.acceptKw("only")
    s.table = try p.qname()
    if p.isKw("set") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "schema" {
        p.pos += 2
        append(mut &s.alters, Alter{kind: A_SET_SCHEMA, col: noCol(), name: try p.name(), to: "", ifFlag: false, using: None, cons: [], cascade: false})
        return Ok(s)
    }
    if p.acceptKw("rename") {
        if p.acceptKw("to") {
            append(mut &s.alters, Alter{kind: A_RENAME, col: noCol(), name: try p.name(), to: "", ifFlag: false, using: None, cons: [], cascade: false})
            return Ok(s)
        }
        let c = p.acceptKw("column")
        let from = try p.name()
        try p.expectKw("to")
        append(mut &s.alters, Alter{kind: A_RENAME_COL, col: noCol(), name: from, to: try p.name(), ifFlag: false, using: None, cons: [], cascade: false})
        return Ok(s)
    }
    while true {
        if p.acceptKw("add") {
            if p.isKw("primary") {
                return Err(lexdb_base.err("0A000", "lexdb: a table's primary key cannot be changed"))
            }
            if p.isKw("constraint") || p.isKw("unique") || p.isKw("check") || p.isKw("foreign") || p.isKw("exclude") {
                var cname = ""
                if p.acceptKw("constraint") { cname = try p.name() }
                if p.isKw("primary") { return Err(lexdb_base.err("0A000", "lexdb: a table's primary key cannot be changed")) }
                var a = Alter{kind: A_ADD_CON, col: noCol(), name: "", to: "", ifFlag: false, using: None, cons: [], cascade: false}
                append(mut &a.cons, try p.tableConstraint(cname))
                append(mut &s.alters, a)
                if !p.acceptKw(",") { break }
                continue
            }
            let c = p.acceptKw("column")
            var a = Alter{kind: A_ADD, col: noCol(), name: "", to: "", ifFlag: false, using: None, cons: [], cascade: false}
            if p.acceptKw("if") {
                try p.expectKw("not")
                try p.expectKw("exists")
                a.ifFlag = true
            }
            a.col.name = try p.name()
            try p.colType(mut &a.col)
            while true {
                if p.acceptKw("not") {
                    try p.expectKw("null")
                    a.col.notNull = true
                } else if p.acceptKw("null") {
                } else if p.acceptKw("generated") {
                    try p.identity(mut &a.col, mut &s)
                } else if p.isKw("primary") {
                    return Err(lexdb_base.err("0A000", "lexdb: a table's primary key cannot be changed"))
                } else if p.acceptKw("default") {
                    a.col.def = Some(try p.defaultExpr())
                } else if p.isKw("unique") || p.isKw("check") || p.isKw("references") || p.isKw("constraint") {
                    return Err(lexdb_base.err("0A000", "lexdb: ADD COLUMN takes no constraint but NOT NULL and DEFAULT (ADD UNIQUE (...) after it)"))
                } else {
                    break
                }
            }
            append(mut &s.alters, a)
        } else if p.acceptKw("drop") {
            if p.acceptKw("constraint") {
                var a = Alter{kind: A_DROP_CON, col: noCol(), name: "", to: "", ifFlag: false, using: None, cons: [], cascade: false}
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    a.ifFlag = true
                }
                a.name = try p.name()
                if p.acceptKw("cascade") { a.cascade = true } else { let r = p.acceptKw("restrict") }
                append(mut &s.alters, a)
                if !p.acceptKw(",") { break }
                continue
            }
            let c = p.acceptKw("column")
            var a = Alter{kind: A_DROP_COL, col: noCol(), name: "", to: "", ifFlag: false, using: None, cons: [], cascade: false}
            if p.acceptKw("if") {
                try p.expectKw("exists")
                a.ifFlag = true
            }
            a.name = try p.name()
            if p.acceptKw("cascade") { a.cascade = true } else { let r = p.acceptKw("restrict") }
            append(mut &s.alters, a)
        } else if p.acceptKw("alter") {
            let c = p.acceptKw("column")
            let n = try p.name()
            let data = p.isKw("set") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "data"
            if data {
                p.pos += 2
                try p.expectKw("type")
            }
            if data || p.acceptKw("type") {
                var a = Alter{kind: A_TYPE, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false}
                a.col.typ = try p.typeName()
                if p.acceptKw("using") {
                    let subs = len(p.subs)
                    let params = p.params
                    a.using = Some(try p.expr())
                    if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in transform expression")) }
                    if p.params > params { return Err(lexdb_base.err("42P02", "there is no parameter $" + p.params.toStr())) }
                }
                append(mut &s.alters, a)
            } else if p.acceptKw("set") {
                if p.acceptKw("default") {
                    var a = Alter{kind: A_SET_DEFAULT, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false}
                    a.col.def = Some(try p.defaultExpr())
                    append(mut &s.alters, a)
                    if !p.acceptKw(",") { break }
                    continue
                }
                try p.expectKw("not")
                try p.expectKw("null")
                append(mut &s.alters, Alter{kind: A_SET_NOT_NULL, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false})
            } else if p.acceptKw("drop") {
                if p.acceptKw("default") {
                    append(mut &s.alters, Alter{kind: A_DROP_DEFAULT, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false})
                    if !p.acceptKw(",") { break }
                    continue
                }
                try p.expectKw("not")
                try p.expectKw("null")
                append(mut &s.alters, Alter{kind: A_DROP_NOT_NULL, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false})
            } else {
                return Err(lexdb_base.err("0A000", "lexdb: ALTER COLUMN takes TYPE, SET or DROP NOT NULL, SET or DROP DEFAULT"))
            }
        } else {
            return Err(lexdb_base.err("0A000", "lexdb: ALTER TABLE takes ADD COLUMN, DROP COLUMN, RENAME, and ALTER COLUMN ... SET or DROP NOT NULL"))
        }
        if !p.acceptKw(",") { break }
    }
    return Ok(s)
}

// "(" then SELECT: a query in parentheses, not a column list.
fn (p: &P) selectNext(): bool {
    return p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "select"
}

fn (p: mut &P) insert(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("into")
    var s = newStmt(S_INSERT)
    s.table = try p.qname()
    if p.isKw("(") && !p.selectNext() {
        p.pos += 1
        append(mut &s.names, try p.name())
        while p.acceptKw(",") { append(mut &s.names, try p.name()) }
        try p.expectKw(")")
    }
    if p.acceptKw("overriding") {
        if p.acceptKw("system") { s.overriding = OVR_SYSTEM } else {
            try p.expectKw("user")
            s.overriding = OVR_USER
        }
        try p.expectKw("value")
    }
    // INSERT ... SELECT: the query in inner[0], with its own subqueries
    let paren = p.isKw("(") && p.selectNext()
    if paren || p.isKw("select") {
        if paren { p.pos += 1 }
        try p.expectKw("select")
        var q = try p.select()
        if paren { try p.expectKw(")") }
        q.subs = replace(mut &p.subs, [])
        q.wins = replace(mut &p.wins, [])
        q.params = p.params
        append(mut &s.inner, q)
        try p.returning(mut &s)
        return Ok(s)
    }
    if p.acceptKw("default") {
        // DEFAULT VALUES: one row, every column its default
        try p.expectKw("values")
        append(mut &s.rows, [])
        try p.returning(mut &s)
        return Ok(s)
    }
    try p.expectKw("values")
    while true {
        try p.expectKw("(")
        var row: []Expr = []
        append(mut &row, try p.valueOrDefault())
        while p.acceptKw(",") { append(mut &row, try p.valueOrDefault()) }
        try p.expectKw(")")
        append(mut &s.rows, row)
        if !p.acceptKw(",") { break }
    }
    try p.returning(mut &s)
    return Ok(s)
}

// SELECT, after its keyword: a query, or queries joined by UNION,
// INTERSECT (first) and EXCEPT; then ORDER BY, LIMIT and OFFSET, of the
// whole. The queries joined each keep their subqueries.
fn (p: mut &P) select(): Result[Stmt, lexdb_base.DbErr] {
    var first = try p.selectCore()
    if !p.isKw("union") && !p.isKw("intersect") && !p.isKw("except") {
        try p.orderLimit(mut &first)
        return Ok(first)
    }
    first.subs = replace(mut &p.subs, [])
    first.wins = replace(mut &p.wins, [])
    var lhs = try p.intersects(first)
    while p.isKw("union") || p.isKw("except") {
        var op = SET_EXCEPT
        if p.acceptKw("union") { op = SET_UNION } else { let x = p.acceptKw("except") }
        let all = p.setAll()
        let rhs = try p.intersects(try p.setBranch())
        lhs = setOf(op, all, lhs, rhs)
    }
    try p.orderLimit(mut &lhs)
    return Ok(lhs)
}

fn (p: mut &P) setAll(): bool {
    if p.acceptKw("all") { return true }
    let d = p.acceptKw("distinct")
    return false
}

fn setOf(op: int, all: bool, l: Stmt, r: Stmt): Stmt {
    var s = newStmt(S_SELECT)
    s.setop = op
    s.setAll = all
    append(mut &s.inner, l)
    append(mut &s.inner, r)
    return s
}

fn (p: mut &P) intersects(first: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var lhs = first
    while p.acceptKw("intersect") {
        let all = p.setAll()
        let rhs = try p.setBranch()
        lhs = setOf(SET_INTERSECT, all, lhs, rhs)
    }
    return Ok(lhs)
}

// One query of a UNION (and the like): SELECT ..., or one in parentheses
// with its own ORDER BY and LIMIT.
fn (p: mut &P) setBranch(): Result[Stmt, lexdb_base.DbErr] {
    var b = newStmt(S_SELECT)
    if p.acceptKw("(") {
        try p.expectKw("select")
        b = try p.select()
        try p.expectKw(")")
    } else {
        try p.expectKw("select")
        b = try p.selectCore()
    }
    b.subs = replace(mut &p.subs, [])
    b.wins = replace(mut &p.wins, [])
    return Ok(b)
}

// A SELECT's output list, or RETURNING's: *, t.*, expr [[AS] alias], ...
fn (p: mut &P) itemList(items: mut &[]SelItem): Result[Unit, lexdb_base.DbErr] {
    while true {
        let q = p.peek()
        if p.acceptKw("*") {
            append(items, SelItem{star: true, qual: "", expr: None, alias: ""})
        } else if (q.kind == T_IDENT || q.kind == T_QIDENT) && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." &&
                  p.peekAt(2).kind == T_OP && p.peekAt(2).text == "*" {
            p.pos += 3
            append(items, SelItem{star: true, qual: q.text, expr: None, alias: ""})
        } else {
            let e = try p.expr()
            var alias = ""
            if p.acceptKw("as") {
                alias = try p.name()
            } else {
                let t = p.peek()
                if t.kind == T_QIDENT || (t.kind == T_IDENT && !isReserved(&t.text)) {
                    alias = t.text
                    p.pos += 1
                }
            }
            append(items, SelItem{star: false, qual: "", expr: Some(e), alias: alias})
        }
        if !p.acceptKw(",") { break }
    }
    return Ok(Unit{})
}

// RETURNING items, after INSERT, UPDATE or DELETE (9.44).
fn (p: mut &P) returning(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("returning") { try p.itemList(mut &s.items) }
    return Ok(Unit{})
}

// A query: the select list to HAVING.
fn (p: mut &P) selectCore(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_SELECT)
    if p.acceptKw("distinct") {
        if p.isKw("on") { return Err(lexdb_base.err("0A000", "SELECT DISTINCT ON is not supported")) }
        s.distinct = true
    } else {
        let all = p.acceptKw("all")
    }
    try p.itemList(mut &s.items)
    if p.acceptKw("from") {
        append(mut &s.from, try p.fromItem(J_FIRST))
        while true {
            if p.acceptKw(",") {
                append(mut &s.from, try p.fromItem(J_CROSS))
            } else if p.acceptKw("cross") {
                try p.expectKw("join")
                append(mut &s.from, try p.fromItem(J_CROSS))
            } else if p.isKw("join") || p.isKw("inner") || p.isKw("left") || p.isKw("right") || p.isKw("full") {
                var kind = J_INNER
                if p.acceptKw("left") {
                    let o = p.acceptKw("outer")
                    kind = J_LEFT
                } else if p.acceptKw("right") {
                    let o = p.acceptKw("outer")
                    kind = J_RIGHT
                } else if p.acceptKw("full") {
                    let o = p.acceptKw("outer")
                    kind = J_FULL
                } else {
                    let i = p.acceptKw("inner")
                }
                try p.expectKw("join")
                var f = try p.fromItem(kind)
                try p.expectKw("on")
                f.on = Some(try p.expr())
                append(mut &s.from, f)
            } else if p.isKw("natural") {
                return Err(lexdb_base.err("0A000", "NATURAL joins are not supported"))
            } else {
                break
            }
        }
        s.table = s.from[0].table
    }
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    if p.acceptKw("group") {
        try p.expectKw("by")
        append(mut &s.group, try p.expr())
        while p.acceptKw(",") { append(mut &s.group, try p.expr()) }
    }
    if p.acceptKw("having") { s.having = Some(try p.expr()) }
    if p.acceptKw("window") {
        // WINDOW name AS (spec), ...
        while true {
            let n = try p.name()
            try p.expectKw("as")
            try p.expectKw("(")
            let d = try p.winSpec()
            for w in s.windows { if w.name == n { return Err(lexdb_base.err("42P20", "window \"" + n + "\" is already defined")) } }
            append(mut &s.windows, NamedWin{name: n, def: d})
            if !p.acceptKw(",") { break }
        }
    }
    return Ok(s)
}

fn (p: mut &P) orderLimit(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("order") {
        try p.expectKw("by")
        while true {
            let e = try p.expr()
            var desc = false
            if p.acceptKw("desc") { desc = true } else { let a = p.acceptKw("asc") }
            var nf = desc
            if p.acceptKw("nulls") {
                if p.acceptKw("first") { nf = true } else {
                    try p.expectKw("last")
                    nf = false
                }
            }
            append(mut &s.order, OrderItem{expr: e, desc: desc, nullsFirst: nf})
            if !p.acceptKw(",") { break }
        }
    }
    while p.isKw("limit") || p.isKw("offset") {
        if p.acceptKw("limit") {
            if p.acceptKw("all") { s.limit = None } else { s.limit = Some(try p.expr()) }
        } else {
            let o = p.acceptKw("offset")
            s.offset = Some(try p.expr())
            let r = p.acceptKw("rows") || p.acceptKw("row")
        }
    }
    return Ok(Unit{})
}

fn (p: mut &P) fromItem(join: int): Result[FromItem, lexdb_base.DbErr] {
    let lateral = p.acceptKw("lateral")
    if p.peek().kind == T_IDENT && (p.peek().text == "generate_series" || p.peek().text == "unnest") &&
       p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_OP && p.toks[p.pos + 1].text == "(" {
        return p.fromFunction(join)
    }
    if lateral && !p.isKw("(") { return Err(lexdb_base.err("0A000", "LATERAL is supported before a subquery or a function only")) }
    if p.acceptKw("(") {
        // a subquery in FROM
        if !p.isKw("select") && !p.isKw("with") { return Err(lexdb_base.err("0A000", "parenthesized joins are not supported")) }
        let i = try p.subquery(SUB_FROM)
        var alias = "unnamed_subquery"
        var cols: []str = []
        try p.aliasOf(mut &alias, mut &cols)
        return Ok(FromItem{table: "", alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: lateral})
    }
    let table = try p.qname()
    var alias = baseName(&table)
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols)
    // a CTE in scope (the innermost of the name) before a table; a
    // qualified name is always a table
    var ci = -1
    for i in 0..len(p.ctes) { if p.ctes[i].name == table { ci = i } }
    if ci >= 0 {
        if len(cols) == 0 { for c in p.ctes[ci].cols { append(mut &cols, c) } }
        // in its own body: its working table
        for k in 0..len(p.inCte) {
            if p.inCte[k].id == p.ctes[ci].id {
                if p.inCte[k].depth != p.depth {
                    return Err(lexdb_base.err("42P19", "recursive reference to query \"" + table + "\" must not appear within a subquery"))
                }
                p.inCte[k].refs += 1
                return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: -1, cols: cols, work: p.ctes[ci].id, lateral: false})
            }
        }
        let i = try p.cteRef(ci)
        return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: false})
    }
    if len(cols) > 0 { return Err(lexdb_base.err("0A000", "column aliases for a table are not supported")) }
    return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: -1, cols: cols, work: -1, lateral: false})
}

// [AS] alias [(column, ...)]
// A function in FROM (9.27): generate_series(start, stop [, step]) or
// unnest(array, ...), [WITH ORDINALITY], [AS alias [(columns)]]. It is a
// subquery (SUB_FROM) whose items are the arguments and whose srf names the
// function; it may use the FROM items before it (LATERAL, as in
// PostgreSQL).
fn (p: mut &P) fromFunction(join: int): Result[FromItem, lexdb_base.DbErr] {
    let name = p.next().text
    try p.expectKw("(")
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var s = newStmt(S_SELECT)
    s.srf = name
    s.use = SUB_FROM
    if !p.isKw(")") {
        while true {
            append(mut &s.items, SelItem{star: false, qual: "", expr: Some(try p.expr()), alias: ""})
            if !p.acceptKw(",") { break }
        }
    }
    try p.expectKw(")")
    s.subs = replace(mut &p.subs, saved)
    s.wins = replace(mut &p.wins, savedW)
    p.depth -= 1
    if p.acceptKw("with") {
        try p.expectKw("ordinality")
        s.ordin = true
    }
    append(mut &p.subs, s)
    let i = len(p.subs) - 1
    var alias = name
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols)
    // one column, an alias and no column names: the column is the alias
    let single = name == "generate_series" || len(p.subs[i].items) == 1
    if single && alias != name && len(cols) == 0 { append(mut &cols, alias) }
    return Ok(FromItem{table: name, alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: true})
}

fn (p: mut &P) aliasOf(alias: mut &str, cols: mut &[]str): Result[Unit, lexdb_base.DbErr] {
    var got = false
    if p.acceptKw("as") {
        let old = replace(alias, try p.name())
        got = true
    } else {
        let t = p.peek()
        if t.kind == T_QIDENT || (t.kind == T_IDENT && !isReserved(&t.text)) {
            let old = replace(alias, t.text)
            p.pos += 1
            got = true
        }
    }
    if got && p.acceptKw("(") {
        append(cols, try p.name())
        while p.acceptKw(",") { append(cols, try p.name()) }
        try p.expectKw(")")
    }
    return Ok(Unit{})
}

fn (p: mut &P) createIndex(unique: bool): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_CREATE_INDEX)
    s.unique = unique
    if p.acceptKw("if") {
        try p.expectKw("not")
        try p.expectKw("exists")
        s.ifFlag = true
    }
    s.index = try p.name()                  // in its table's schema
    try p.expectKw("on")
    s.table = try p.qname()
    if p.acceptKw("using") {
        let m = try p.name()
        if m != "btree" { return Err(lexdb_base.err("0A000", "index method \"" + m + "\" is not supported")) }
    }
    try p.expectKw("(")
    append(mut &s.names, try p.name())
    while p.acceptKw(",") { append(mut &s.names, try p.name()) }
    try p.expectKw(")")
    if p.acceptKw("where") { s.where = Some(try p.expr()) }      // a filtered index
    return Ok(s)
}

fn (p: mut &P) update(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_UPDATE)
    s.table = try p.qname()
    try p.expectKw("set")
    while true {
        let c = try p.name()
        try p.expectKw("=")
        let e = try p.valueOrDefault()
        append(mut &s.sets, SetItem{col: c, expr: e})
        if !p.acceptKw(",") { break }
    }
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    try p.returning(mut &s)
    return Ok(s)
}

fn (p: mut &P) delete(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("from")
    var s = newStmt(S_DELETE)
    s.table = try p.qname()
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    try p.returning(mut &s)
    return Ok(s)
}

// COPY (9.45), after its keyword:
//   COPY table [(col, ...)] FROM STDIN [options]
//   COPY {table [(col, ...)] | (query)} TO STDOUT [options]
// options: [WITH] (FORMAT text|csv, DELIMITER 'c', NULL 's', HEADER [bool],
// QUOTE 'c', ESCAPE 'c', ENCODING 'utf8'), or the old form [WITH] [BINARY]
// [DELIMITER [AS] 'c'] [NULL [AS] 's'] [CSV [HEADER] [QUOTE [AS] 'c']
// [ESCAPE [AS] 'c']]. A table's TO is the query SELECT cols FROM table.
fn (p: mut &P) copyStmt(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_COPY)
    var query = false
    if p.isKw("(") {
        p.pos += 1
        query = true
        var q: Stmt = newStmt(S_SELECT)
        if p.acceptKw("select") { q = try p.select() }
        else if p.acceptKw("with") {
            let n = try p.withList()
            try p.expectKw("select")
            let r = p.select()
            p.popCtes(n)
            q = try r
        } else { return Err(lexdb_base.err("0A000", "lexdb: COPY's query must be a SELECT")) }
        try p.expectKw(")")
        q.subs = replace(mut &p.subs, [])
        q.wins = replace(mut &p.wins, [])
        q.params = p.params
        append(mut &s.inner, q)
    } else {
        s.table = try p.qname()
        if p.acceptKw("(") {
            append(mut &s.names, try p.name())
            while p.acceptKw(",") { append(mut &s.names, try p.name()) }
            try p.expectKw(")")
        }
    }
    if p.acceptKw("from") {
        if query { return Err(lexdb_base.err("42601", "COPY FROM takes a table, not a query")) }
        s.copy.from = true
        if !p.acceptKw("stdin") { return Err(lexdb_base.err("0A000", "lexdb: COPY FROM reads only STDIN (a file on the server: use psql's \\copy)")) }
    } else {
        try p.expectKw("to")
        if !p.acceptKw("stdout") { return Err(lexdb_base.err("0A000", "lexdb: COPY TO writes only STDOUT (a file on the server: use psql's \\copy)")) }
    }
    var format = ""
    var hasQuote = false
    var hasEscape = false
    var delim: Option[str] = None
    var null: Option[str] = None
    let with = p.acceptKw("with")
    if p.acceptKw("(") {
        while true {
            let t = p.peek()
            if t.kind != T_IDENT { return Err(near(&t)) }
            p.pos += 1
            let v = p.peek()
            match t.text {
                "format" {
                    if v.kind != T_IDENT && v.kind != T_STR { return Err(near(&v)) }
                    p.pos += 1
                    format = strings.toLowerAscii(v.text)
                }
                "header" {
                    if v.kind == T_IDENT && v.text != "match" { p.pos += 1; s.copy.header = !(v.text == "false" || v.text == "off") }
                    else if v.kind == T_NUM { p.pos += 1; s.copy.header = v.text != "0" }
                    else if v.kind == T_IDENT { return Err(lexdb_base.err("0A000", "lexdb: COPY's HEADER MATCH is not supported")) }
                    else { s.copy.header = true }
                }
                "delimiter" { delim = Some(try p.copyStr()) }
                "null" { null = Some(try p.copyStr()) }
                "quote" { s.copy.quote = try p.copyStr(); hasQuote = true }
                "escape" { s.copy.escape = try p.copyStr(); hasEscape = true }
                "encoding" {
                    let enc = strings.toLowerAscii(try p.copyStr())
                    if enc != "utf8" && enc != "utf-8" && enc != "unicode" && enc != "sql_ascii" {
                        return Err(lexdb_base.err("0A000", "lexdb: COPY's encoding is UTF8 only"))
                    }
                }
                "freeze" {
                    // a hint: accepted (with its boolean) and ignored
                    if v.kind == T_IDENT && (v.text == "true" || v.text == "false" || v.text == "on" || v.text == "off") { p.pos += 1 }
                }
                "force_quote" {
                    if p.acceptKw("*") { s.copy.quoteAll = true } else { s.copy.forceQuote = try p.nameList() }
                }
                "force_not_null" { s.copy.forceNotNull = try p.nameList() }
                "force_null" { s.copy.forceNull = try p.nameList() }
                "on_error", "default", "log_verbosity", "reject_limit" {
                    return Err(lexdb_base.err("0A000", "lexdb: COPY's option \"" + t.text + "\" is not supported"))
                }
                else { return Err(lexdb_base.err("42601", "option \"" + t.text + "\" not recognized")) }
            }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    } else {
        while true {
            if p.acceptKw("binary") { format = "binary" }
            else if p.acceptKw("delimiter") { let a = p.acceptKw("as"); delim = Some(try p.copyStr()) }
            else if p.acceptKw("null") { let a = p.acceptKw("as"); null = Some(try p.copyStr()) }
            else if p.acceptKw("csv") { format = "csv" }
            else if p.acceptKw("header") { s.copy.header = true }
            else if p.acceptKw("quote") { let a = p.acceptKw("as"); s.copy.quote = try p.copyStr(); hasQuote = true }
            else if p.acceptKw("escape") { let a = p.acceptKw("as"); s.copy.escape = try p.copyStr(); hasEscape = true }
            else if p.acceptKw("force") {
                // FORCE QUOTE {* | col, ...}, FORCE NOT NULL col, ...
                if p.acceptKw("quote") {
                    if p.acceptKw("*") { s.copy.quoteAll = true } else { s.copy.forceQuote = try p.bareNames() }
                } else {
                    try p.expectKw("not")
                    try p.expectKw("null")
                    s.copy.forceNotNull = try p.bareNames()
                }
            }
            else { break }
        }
    }
    if format == "binary" { return Err(lexdb_base.err("0A000", "lexdb: COPY's binary format is not supported")) }
    if format != "" && format != "text" && format != "csv" { return Err(lexdb_base.err("22023", "COPY format \"" + format + "\" not recognized")) }
    s.copy.csv = format == "csv"
    s.copy.delim = delim.unwrapOr(if s.copy.csv { "," } else { "\t" })
    s.copy.null = null.unwrapOr(if s.copy.csv { "" } else { "\\N" })
    if !s.copy.csv && (hasQuote || hasEscape) {
        return Err(lexdb_base.err("0A000", "COPY " + (if hasQuote { "quote" } else { "escape" }) + " available only in CSV mode"))
    }
    if !hasQuote { s.copy.quote = "\"" }
    if !hasEscape { s.copy.escape = s.copy.quote }
    if len(s.copy.delim) != 1 { return Err(lexdb_base.err("22023", "COPY delimiter must be a single one-byte character")) }
    if s.copy.delim == "\n" || s.copy.delim == "\r" { return Err(lexdb_base.err("22023", "COPY delimiter cannot be newline or carriage return")) }
    if !s.copy.csv && strings.indexOf(&"\\.abcdefghijklmnopqrstuvwxyz0123456789", s.copy.delim, 0) >= 0 {
        return Err(lexdb_base.err("22023", "COPY delimiter cannot be \"" + s.copy.delim + "\""))
    }
    if s.copy.csv {
        if len(s.copy.quote) != 1 { return Err(lexdb_base.err("22023", "COPY quote must be a single one-byte character")) }
        if len(s.copy.escape) != 1 { return Err(lexdb_base.err("22023", "COPY escape must be a single one-byte character")) }
        if s.copy.quote == s.copy.delim { return Err(lexdb_base.err("22023", "COPY delimiter and quote must be different")) }
    }
    let anyQuote = s.copy.quoteAll || len(s.copy.forceQuote) > 0
    if (anyQuote || len(s.copy.forceNotNull) > 0 || len(s.copy.forceNull) > 0) && !s.copy.csv {
        let which = if anyQuote { "force quote" } else if len(s.copy.forceNotNull) > 0 { "force not null" } else { "force null" }
        return Err(lexdb_base.err("0A000", "COPY " + which + " available only in CSV mode"))
    }
    if anyQuote && s.copy.from { return Err(lexdb_base.err("0A000", "COPY force quote only available using COPY TO")) }
    if len(s.copy.forceNotNull) > 0 && !s.copy.from { return Err(lexdb_base.err("0A000", "COPY force not null only available using COPY FROM")) }
    if len(s.copy.forceNull) > 0 && !s.copy.from { return Err(lexdb_base.err("0A000", "COPY force null only available using COPY FROM")) }
    if strings.indexOf(&s.copy.null, s.copy.delim, 0) >= 0 {
        return Err(lexdb_base.err("22023", "COPY delimiter character must not appear in the NULL specification"))
    }
    if strings.indexOf(&s.copy.null, "\n", 0) >= 0 || strings.indexOf(&s.copy.null, "\r", 0) >= 0 {
        return Err(lexdb_base.err("22023", "COPY null representation cannot use newline or carriage return"))
    }
    if !query && !s.copy.from {
        // TO from a table: its query
        var q = newStmt(S_SELECT)
        if len(s.names) == 0 { append(mut &q.items, SelItem{star: true, qual: "", expr: None, alias: ""}) }
        for n in s.names { append(mut &q.items, SelItem{star: false, qual: "", expr: Some(Expr.Col(n)), alias: ""}) }
        append(mut &q.from, FromItem{table: s.table, alias: baseName(&s.table), join: J_FIRST, on: None, sub: -1, cols: [], work: -1, lateral: false})
        append(mut &s.inner, q)
    }
    return Ok(s)
}

// (col, ...): COPY's FORCE options.
fn (p: mut &P) nameList(): Result[[]str, lexdb_base.DbErr] {
    try p.expectKw("(")
    let ns = try p.bareNames()
    try p.expectKw(")")
    return Ok(ns)
}

// col, ...: in the old options' form no comma separates options, so one
// here always continues the list.
fn (p: mut &P) bareNames(): Result[[]str, lexdb_base.DbErr] {
    var ns: []str = [try p.name()]
    while p.acceptKw(",") { append(mut &ns, try p.name()) }
    return Ok(ns)
}

// ---- windows (9.46)

// After OVER: a window's name, or (spec).
fn (p: mut &P) over(): Result[WinDef, lexdb_base.DbErr] {
    if p.acceptKw("(") { return p.winSpec() }
    let n = try p.name()
    return Ok(WinDef{call: Expr.Lit(Val.Null), ref: n, bare: true, part: [], order: [], frame: noFrame()})
}

// A window's spec, after its "(": [name] [PARTITION BY ...] [ORDER BY ...]
// [frame], and its ")".
fn (p: mut &P) winSpec(): Result[WinDef, lexdb_base.DbErr] {
    var d = WinDef{call: Expr.Lit(Val.Null), ref: "", bare: false, part: [], order: [], frame: noFrame()}
    let t = p.peek()
    if (t.kind == T_IDENT || t.kind == T_QIDENT) && !(t.kind == T_IDENT &&
        (t.text == "partition" || t.text == "order" || t.text == "rows" || t.text == "range" || t.text == "groups")) {
        d.ref = try p.name()
    }
    if p.acceptKw("partition") {
        try p.expectKw("by")
        append(mut &d.part, try p.expr())
        while p.acceptKw(",") { append(mut &d.part, try p.expr()) }
    }
    if p.acceptKw("order") {
        try p.expectKw("by")
        while true {
            let x = try p.expr()
            var desc = false
            if p.acceptKw("desc") { desc = true } else { let a = p.acceptKw("asc") }
            var nf = desc                   // NULLs come first going down, last going up
            if p.acceptKw("nulls") {
                if p.acceptKw("first") { nf = true } else {
                    try p.expectKw("last")
                    nf = false
                }
            }
            append(mut &d.order, WinOrder{expr: x, desc: desc, nullsFirst: nf})
            if !p.acceptKw(",") { break }
        }
    }
    var mode = FR_NONE
    if p.acceptKw("rows") { mode = FR_ROWS }
    else if p.acceptKw("range") { mode = FR_RANGE }
    else if p.acceptKw("groups") { mode = FR_GROUPS }
    if mode != FR_NONE {
        var f = noFrame()
        f.mode = mode
        if p.acceptKw("between") {
            try p.bound(mut &f, true)
            try p.expectKw("and")
            try p.bound(mut &f, false)
        } else {
            try p.bound(mut &f, true)
            f.end = B_CURRENT
        }
        if p.acceptKw("exclude") {
            if p.acceptKw("current") { try p.expectKw("row"); f.exclude = EX_CURRENT }
            else if p.acceptKw("group") { f.exclude = EX_GROUP }
            else if p.acceptKw("ties") { f.exclude = EX_TIES }
            else { try p.expectKw("no"); try p.expectKw("others") }
        }
        if f.start == B_UNBOUNDED_FOLLOWING { return Err(lexdb_base.err("42P20", "frame start cannot be UNBOUNDED FOLLOWING")) }
        if f.end == B_UNBOUNDED_PRECEDING { return Err(lexdb_base.err("42P20", "frame end cannot be UNBOUNDED PRECEDING")) }
        if f.start == B_CURRENT && f.end == B_PRECEDING {
            return Err(lexdb_base.err("42P20", "frame starting from current row cannot have preceding rows"))
        }
        if f.start == B_FOLLOWING && (f.end == B_PRECEDING || f.end == B_CURRENT) {
            return Err(lexdb_base.err("42P20", "frame starting from following row cannot have preceding rows"))
        }
        d.frame = f
    }
    try p.expectKw(")")
    return Ok(d)
}

// A frame's bound: UNBOUNDED PRECEDING | n PRECEDING | CURRENT ROW |
// n FOLLOWING | UNBOUNDED FOLLOWING.
fn (p: mut &P) bound(f: mut &Frame, start: bool): Result[Unit, lexdb_base.DbErr] {
    var kind = 0
    var off: Option[Expr] = None
    if p.acceptKw("unbounded") {
        if p.acceptKw("preceding") { kind = B_UNBOUNDED_PRECEDING } else {
            try p.expectKw("following")
            kind = B_UNBOUNDED_FOLLOWING
        }
    } else if p.acceptKw("current") {
        try p.expectKw("row")
        kind = B_CURRENT
    } else {
        off = Some(try p.expr())
        if p.acceptKw("preceding") { kind = B_PRECEDING } else {
            try p.expectKw("following")
            kind = B_FOLLOWING
        }
    }
    if start {
        f.start = kind
        f.startOff = off
    } else {
        f.end = kind
        f.endOff = off
    }
    return Ok(Unit{})
}

// A COPY option's value: a string.
fn (p: mut &P) copyStr(): Result[str, lexdb_base.DbErr] {
    let t = p.peek()
    if t.kind != T_STR { return Err(near(&t)) }
    p.pos += 1
    return Ok(t.text)
}

fn (p: mut &P) statement(): Result[Stmt, lexdb_base.DbErr] {
    let t = p.peek()
    if t.kind == T_EOF || (t.kind == T_OP && t.text == ";") { return Ok(newStmt(S_EMPTY)) }
    if t.kind != T_IDENT { return Err(near(&t)) }
    p.pos += 1
    match t.text {
        "select" { return p.select() }
        "with" {
            // its queries are used where they are named (cteRef): in an
            // INSERT's SELECT, an UPDATE's or a DELETE's subqueries
            let n = try p.withList()
            var r: Result[Stmt, lexdb_base.DbErr] = Err(lexdb_base.err("42601", "WITH must be followed by SELECT, INSERT, UPDATE or DELETE"))
            if p.acceptKw("select") { r = p.select() }
            else if p.acceptKw("insert") { r = p.insert() }
            else if p.acceptKw("update") { r = p.update() }
            else if p.acceptKw("delete") { r = p.delete() }
            p.popCtes(n)
            return r
        }
        "insert" { return p.insert() }
        "alter" {
            if p.acceptKw("table") { return p.alterTable() }
            if p.acceptKw("sequence") { return p.seqStmt(S_ALTER_SEQ) }
            // ALTER INDEX [IF EXISTS] name RENAME TO new, ALTER SCHEMA name
            // RENAME TO new
            let idx = p.acceptKw("index")
            if idx || p.acceptKw("schema") {
                var s = newStmt(if idx { S_ALTER_INDEX } else { S_ALTER_SCHEMA })
                if idx {
                    if p.acceptKw("if") {
                        try p.expectKw("exists")
                        s.ifFlag = true
                    }
                    s.index = try p.qname()
                } else {
                    s.table = try p.name()
                }
                if !p.acceptKw("rename") {
                    return Err(lexdb_base.err("0A000", "lexdb: ALTER " + (if idx { "INDEX" } else { "SCHEMA" }) + " takes RENAME TO only"))
                }
                try p.expectKw("to")
                append(mut &s.alters, Alter{kind: A_RENAME, col: noCol(), name: try p.name(), to: "", ifFlag: false, using: None, cons: [], cascade: false})
                return Ok(s)
            }
            return Err(lexdb_base.err("0A000", "only ALTER TABLE, ALTER INDEX and ALTER SCHEMA are supported"))
        }
        "update" { return p.update() }
        "delete" { return p.delete() }
        "copy" { return p.copyStmt() }
        "create" {
            if p.acceptKw("table") { return p.createTable() }
            if p.acceptKw("sequence") { return p.seqStmt(S_CREATE_SEQ) }
            if p.acceptKw("schema") {
                var s = newStmt(S_CREATE_SCHEMA)
                if p.acceptKw("if") {
                    try p.expectKw("not")
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.table = try p.name()
                return Ok(s)
            }
            if p.acceptKw("index") { return p.createIndex(false) }
            if p.acceptKw("unique") {
                try p.expectKw("index")
                return p.createIndex(true)
            }
            return Err(lexdb_base.err("0A000", "only CREATE TABLE, CREATE INDEX, CREATE SCHEMA and CREATE SEQUENCE are supported"))
        }
        "explain" {
            var s = newStmt(S_EXPLAIN)
            s.ifFlag = p.acceptKw("analyze")        // EXPLAIN ANALYZE: run it and count
            var inner = try p.statement()
            inner.subs = replace(mut &p.subs, [])
            inner.wins = replace(mut &p.wins, [])
            inner.params = p.params
            if s.ifFlag && inner.kind != S_SELECT {
                return Err(lexdb_base.err("0A000", "EXPLAIN ANALYZE takes SELECT"))
            }
            if inner.kind != S_SELECT && inner.kind != S_UPDATE && inner.kind != S_DELETE {
                return Err(lexdb_base.err("0A000", "EXPLAIN takes SELECT, UPDATE or DELETE"))
            }
            append(mut &s.inner, inner)
            return Ok(s)
        }
        "drop" {
            if p.acceptKw("index") {
                var s = newStmt(S_DROP_INDEX)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.index = try p.qname()
                return Ok(s)
            }
            if p.acceptKw("sequence") {
                var s = newStmt(S_DROP_SEQ)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.table = try p.qname()
                if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(s)
            }
            if p.acceptKw("schema") {
                var s = newStmt(S_DROP_SCHEMA)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.table = try p.name()
                if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(s)
            }
            try p.expectKw("table")
            var s = newStmt(S_DROP)
            if p.acceptKw("if") {
                try p.expectKw("exists")
                s.ifFlag = true
            }
            s.table = try p.qname()
            if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
            return Ok(s)
        }
        "begin", "start" {
            if t.text == "start" { try p.expectKw("transaction") } else {
                let a = p.acceptKw("transaction") || p.acceptKw("work")
            }
            // READ ONLY makes a snapshot; ISOLATION LEVEL and the rest are
            // accepted (read-write blocks are serializable).
            var b = newStmt(S_BEGIN)
            while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") {
                if p.acceptKw("read") {
                    if p.acceptKw("only") { b.ifFlag = true } else { let wr = p.acceptKw("write") }
                } else {
                    p.pos += 1
                }
            }
            return Ok(b)
        }
        "commit", "end" {
            let a = p.acceptKw("transaction") || p.acceptKw("work")
            return Ok(newStmt(S_COMMIT))
        }
        "rollback", "abort" {
            let a = p.acceptKw("transaction") || p.acceptKw("work")
            return Ok(newStmt(S_ROLLBACK))
        }
        "show" {
            var st = newStmt(S_SHOW)
            if p.acceptKw("all") { st.table = "all" } else { st.table = try p.name() }
            if st.table == "transaction" { st.table = "transaction_isolation" }   // SHOW TRANSACTION ISOLATION LEVEL
            p.skipToEnd()
            return Ok(st)
        }
        "set", "reset", "discard", "deallocate" {
            // lexdb's own settings (SETTINGS): SET name = value | TO value |
            // = DEFAULT, RESET name, RESET ALL; the rest are accepted and ignored
            var st = newStmt(S_SET)
            st.ifFlag = t.text == "reset"
            let u = p.acceptKw("session")
            if t.text == "reset" && p.acceptKw("all") {
                st.table = "all"
                return Ok(st)
            }
            if t.text == "set" && p.acceptKw("schema") {
                // SET SCHEMA 'x': the search path x
                st.table = "search_path"
                let v = p.peek()
                if v.kind == T_STR { p.pos += 1; append(mut &st.names, v.text) } else { append(mut &st.names, try p.name()) }
                return Ok(st)
            }
            var known = false
            for name in SETTINGS { if p.isKw(name) { known = true } }
            if known && (t.text == "set" || t.text == "reset") {
                st.table = p.toks[p.pos].text
                p.pos += 1
                if t.text == "set" && st.table == "search_path" {
                    // a list of schemas, names or strings ('a, b' splits too); DEFAULT
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    if p.acceptKw("default") { return Ok(st) }
                    while true {
                        let v = p.peek()
                        if v.kind == T_STR {
                            p.pos += 1
                            for part in strings.split(&v.text, ",") {
                                var x = strings.trim(part)
                                if len(x) >= 2 && x[0] == '"' && x[len(x) - 1] == '"' { x = x[1..len(x) - 1] }
                                if len(x) > 0 { append(mut &st.names, x) }
                            }
                        } else {
                            append(mut &st.names, try p.name())
                        }
                        if !p.acceptKw(",") { break }
                    }
                    if len(st.names) == 0 { return Err(lexdb_base.err("22023", "search_path names no schema")) }
                    return Ok(st)
                }
                if t.text == "set" {
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    if p.acceptKw("default") { st.limit = None } else { st.limit = Some(try p.expr()) }
                }
                return Ok(st)
            }
            p.skipToEnd()
            return Ok(st)
        }
        else {}
    }
    return Err(near(&t))
}

// Skips the rest of a statement (the options of BEGIN, a SET's value).
fn (p: mut &P) skipToEnd() {
    while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") { p.pos += 1 }
}

// Parses SQL text into its statements (separated by ;). params is the
// highest $n in each.
pub fn parse(sql: &str): Result[[]Stmt, lexdb_base.DbErr] {
    let toks = try lex(sql)
    var p = P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0, seqs: [], wins: []}
    var out: []Stmt = []
    while true {
        p.params = 0
        p.subs = []
        p.ctes = []
        p.nextCte = 0
        p.inCte = []
        p.depth = 0
        p.seqs = []
        p.wins = []
        var s = try p.statement()
        s.params = p.params
        s.seqNames = replace(mut &p.seqs, [])
        if s.kind != S_EXPLAIN {
            s.subs = replace(mut &p.subs, [])
            s.wins = replace(mut &p.wins, [])
        }
        let t = p.peek()
        if t.kind == T_EOF {
            if s.kind != S_EMPTY || len(out) == 0 { append(mut &out, s) }
            break
        }
        if t.kind == T_OP && t.text == ";" {
            p.pos += 1
            if s.kind != S_EMPTY { append(mut &out, s) }
            continue
        }
        return Err(near(&t))
    }
    return Ok(out)
}

// ---- expressions as text: a filtered index's predicate is kept in the
// catalog so, and parsed again when the table is read.

pub fn typeText(t: &TypeName): str {
    if t.kind == K_ARRAY {
        let e = elemOid(t.oid)
        let k = if e == OID_BOOL { K_BOOL } else if e == OID_NUMERIC { K_NUM } else if e == OID_INT2 || e == OID_INT4 || e == OID_INT8 { K_INT } else { K_TEXT }
        return typeText(&TypeName{kind: k, oid: e, prec: 0, scale: 0, len: 0}) + "[]"
    }
    if t.oid == OID_INT2 { return "smallint" }
    if t.oid == OID_INT4 { return "integer" }
    if t.oid == OID_INT8 { return "bigint" }
    if t.oid == OID_BOOL { return "boolean" }
    if t.kind == K_NUM {
        if t.prec > 0 { return "numeric(" + t.prec.toStr() + ", " + t.scale.toStr() + ")" }
        return "numeric"
    }
    if t.oid == OID_VARCHAR {
        if t.len > 0 { return "varchar(" + t.len.toStr() + ")" }
        return "varchar"
    }
    return "text"
}

fn quoteIdent(n: &str): str { return "\"" + strings.replaceAll(n, "\"", "\"\"") + "\"" }

// SQL text that parses back to x.
// x op ANY (array), x op ALL (array): the call's name, "any =", "all <>".
pub fn isQuant(n: &str): bool { return strings.startsWith(n, "any ") || strings.startsWith(n, "all ") }

pub fn exprText(x: &Expr): str {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Null { return "null" }
                Val.Int(n) { return n.toStr() }
                Val.Bool(b) { return if b { "true" } else { "false" } }
                Val.Num(d) { return d.canonical() }
                Val.Text(t) { return "'" + strings.replaceAll(t, "'", "''") + "'" }
            }
        }
        Expr.Param(n) { return "$" + n.toStr() }
        Expr.Col(n) {
            let d = strings.indexOf(n, ".", 0)
            if d < 0 { return quoteIdent(&n) }
            return quoteIdent(&n[0..d]) + "." + quoteIdent(&n[d + 1..len(n)])
        }
        Expr.Unary(op, a) { return "(" + op + " " + exprText(&a) + ")" }
        Expr.Bin(op, a, b) { return "(" + exprText(&a) + " " + op + " " + exprText(&b) + ")" }
        Expr.IsNull(a, neg) { return "(" + exprText(&a) + (if neg { " is not null)" } else { " is null)" }) }
        Expr.Cast(a, t) { return "cast(" + exprText(&a) + " as " + typeText(&t) + ")" }
        Expr.Call(n, args, star) {
            if n == "#sub" || n == "#exists" || n == "#in" {
                // a subquery: by its number, from 1
                var i = 0
                match args[0] { Expr.Lit(v) { match v { Val.Int(k) { i = k } else {} } } else {} }
                let sq = "(subquery " + (i + 1).toStr() + ")"
                if n == "#sub" { return sq }
                if n == "#exists" { return "(exists " + sq + ")" }
                let at = if len(args) > 3 { 3 } else { 1 }
                return "(" + exprText(&args[at]) + " in " + sq + ")"
            }
            if n == "like" || n == "ilike" {
                var out = "(" + exprText(&args[0]) + " " + n + " " + exprText(&args[1])
                if len(args) > 2 { out = out + " escape " + exprText(&args[2]) }
                return out + ")"
            }
            if n == "in" {
                var parts: []str = []
                for i in 1..len(args) { append(mut &parts, exprText(&args[i])) }
                return "(" + exprText(&args[0]) + " in (" + strings.join(&parts, ", ") + "))"
            }
            if n == "distinct from" { return "(" + exprText(&args[0]) + " is distinct from " + exprText(&args[1]) + ")" }
            if isQuant(&n) {
                let sp = strings.indexOf(n, " ", 0)
                return "(" + exprText(&args[0]) + " " + n[sp + 1..len(n)] + " " + n[0..sp] + " (" + exprText(&args[1]) + "))"
            }
            if n == "case" || n == "case else" {
                var out = "(case"
                var i = 0
                while i + 1 < len(args) {
                    out = out + " when " + exprText(&args[i]) + " then " + exprText(&args[i + 1])
                    i += 2
                }
                if n == "case else" { out = out + " else " + exprText(&args[len(args) - 1]) }
                return out + " end)"
            }
            // modifiers in the name: "string_agg distinct order:ad filter"
            let words = strings.split(&n, " ")
            let base = words[0].toStr()
            let distinct = strings.contains(n, " distinct")
            let filtered = strings.contains(n, " filter")
            var dirs = ""
            for w in words { if strings.startsWith(w, "order:") { dirs = w[6..len(w)] } }
            var parts: []str = []
            let last = if filtered { len(args) - 1 } else { len(args) }
            let keysAt = last - len(dirs)
            for i in 0..keysAt { append(mut &parts, exprText(&args[i])) }
            var ord = ""
            if len(dirs) > 0 {
                var ks: []str = []
                for k in 0..len(dirs) {
                    let d = dirs[k]
                    let how = if d == 'A' { " nulls first" } else if d == 'd' { " desc" } else if d == 'D' { " desc nulls last" } else { "" }
                    append(mut &ks, exprText(&args[keysAt + k]) + how)
                }
                ord = " order by " + strings.join(&ks, ", ")
            }
            var out = if star { base + "(*)" } else { base + "(" + (if distinct { "distinct " } else { "" }) + strings.join(&parts, ", ") + ord + ")" }
            if filtered { out = out + " filter (where " + exprText(&args[len(args) - 1]) + ")" }
            return out
        }
    }
}

// One expression and nothing after it.
pub fn parseExpr(sql: &str): Result[Expr, lexdb_base.DbErr] {
    let toks = try lex(sql)
    var p = P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0, seqs: [], wins: []}
    let x = try p.expr()
    let t = p.peek()
    if t.kind != T_EOF { return Err(near(&t)) }
    return Ok(x)
}

