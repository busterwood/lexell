// lexdb: SQL text to statements (design/lexdb.md 4.8): a lexer and a
// recursive-descent parser for the subset lexdb runs.
//
// Statements: CREATE TABLE (a primary key is required), DROP TABLE, INSERT
// ... VALUES, SELECT (one table or none; WHERE, GROUP BY, ORDER BY, LIMIT,
// OFFSET; aggregates), UPDATE, DELETE, BEGIN / START TRANSACTION, COMMIT /
// END, ROLLBACK, and SET (accepted and ignored). Names are folded to lower
// case unless quoted. Expressions: literals, $n parameters, columns
// (table.column too), + - * / % ||, comparisons, AND OR NOT, IS [NOT] NULL,
// casts (::type and CAST(x AS type)) and function calls.
import "strings"
import "./lexdb_base"
import "./lexdb_time"
import "./lexdb_float"
import "./lexdb_pgcat"

// Column kinds.
pub const K_INT = 1
pub const K_BOOL = 2
pub const K_NUM = 3
pub const K_TEXT = 4
pub const K_ARRAY = 5       // one dimension; its value is PostgreSQL's text form, {1,2,NULL} (9.27)
pub const K_DATE = 6        // the date and time kinds (9.76, lexdb_time): their values Val.Date and so on
pub const K_TIME = 7
pub const K_TS = 8
pub const K_TSTZ = 9
pub const K_IVAL = 10
pub const K_UUID = 11       // its value Val.Uuid (9.78)
pub const K_BYTEA = 12      // its value Val.Bytes
pub const K_FLOAT = 13      // real (OID 700, Val.Real) and double precision (701, Val.Float): 9.79
pub const K_REG = 14        // regclass, regtype, regnamespace, regproc: Val.Reg, an OID and its name (9.80)
pub const K_ENUM = 15       // a CREATE TYPE ... AS ENUM's (9.90): its OID the type's; its values texts, its labels

// The marker in Stmt.seqNames of a type of the user's a statement names
// (9.90), then its name: found (or 42704) when the statement runs.
pub const TYPE_MARK: str = "\x00type\x00"

// An object's OID from its kind and catalog key (lexdb has no OID counter:
// a name's is the same each time). lexdb_exec's catOid.
pub fn nameOid(kind: &str, key: &str): int {
    var h = 2166136261
    let s = kind + "\x00" + key
    for i in 0..len(s) { h = ((h ^ int(s[i])) * 16777619) & 0xFFFFFFFF }
    return 16384 + h % 2000000000
}

// Postgres type OIDs.
pub const OID_BOOL = 16
pub const OID_INT8 = 20
pub const OID_INT2 = 21
pub const OID_INT4 = 23
pub const OID_TEXT = 25
pub const OID_VARCHAR = 1043
pub const OID_BPCHAR = 1042     // char(n), character(n), bpchar (9.94): blank-padded to n (len), compared without them
pub const OID_NUMERIC = 1700
pub const OID_DATE = 1082
pub const OID_TIME = 1083
pub const OID_TS = 1114
pub const OID_TSTZ = 1184
pub const OID_IVAL = 1186
pub const OID_UUID = 2950
pub const OID_BYTEA = 17
pub const OID_FLOAT4 = 700
pub const OID_OID = 26
pub const OID_NAME = 19
pub const OID_CHAR = 18
pub const OID_REGCLASS = 2205
pub const OID_REGTYPE = 2206
pub const OID_REGNAMESPACE = 4089
pub const OID_REGPROC = 24
pub const OID_FLOAT8 = 701
pub const OID_UNKNOWN = 705

// The array types: element OIDs and, at the same places, their arrays'.
// int2vector (22) and oidvector (30) are arrays of int2 and oid here, after
// int2[] and oid[] so that those are the arrays of int2 and oid (9.80).
const ELEM_OIDS: []int = [16, 21, 23, 25, 1043, 20, 1700, 1082, 1083, 1114, 1184, 1186, 2950, 17, 700, 701, 26, 19, 18, 2205, 2206, 21, 26, 1042]
const ARRAY_OIDS: []int = [1000, 1005, 1007, 1009, 1015, 1016, 1231, 1182, 1183, 1115, 1185, 1187, 2951, 1001, 1021, 1022, 1028, 1003, 1002, 2210, 2211, 22, 30, 1014]

// The array type of an element type (0: none).
pub fn arrayOid(elem: int): int {
    for i in 0..len(ELEM_OIDS) { if ELEM_OIDS[i] == elem { return ARRAY_OIDS[i] } }
    return 0
}

// The element type of an array type (0: not an array).
pub fn elemOid(arr: int): int {
    for i in 0..len(ARRAY_OIDS) { if ARRAY_OIDS[i] == arr { return ELEM_OIDS[i] } }
    return 0
}

pub type TypeName = value record {
    pub kind: int
    pub oid: int
    pub prec: int       // numeric precision, 0 when not given; a time type's: 1 when given (in scale)
    pub scale: int      // numeric scale; a time type's fractional digits (0 to 6) when prec is 1
    pub len: int        // varchar's and char's length, 0 when not given (char: 1; bpchar: none)
}

pub type Val = value closed {
    Null
    Int(int)
    Bool(bool)
    Num(Decimal)
    Text(str)
    Date(int)               // days since 2000-01-01 (negative before: 4713 BC to 5874897 AD)
    Time(int)               // microseconds since midnight
    Ts(int)                 // a timestamp: microseconds since 2000-01-01 00:00, local
    Tstz(int)               // a timestamptz: microseconds since 2000-01-01 00:00 UTC
    Ival(lexdb_time.Ival)   // an interval
    Uuid(str)               // a uuid: its 36-character lowercase form (9.78)
    Bytes(str)              // a bytea: its bytes
    Float(float)            // a double precision (9.79)
    Real(float)             // a real: a double holding a single-precision value
    Reg(int, str)           // a regclass, regtype, ...: its OID and the name it shows (9.80)
}

pub fn floatType(oid: int): TypeName { return TypeName{kind: K_FLOAT, oid: oid, prec: 0, scale: 0, len: 0} }

// In a statement's seqNames: it reads the catalog (a catalog relation, a
// reg type, a catalog function), so the catalog is bound before it runs.
pub const CAT_MARK: str = "\x00catalog"

// In a statement's seqNames: it calls current_setting or set_config (9.92),
// so the session's settings are put where they can read them.
pub const SET_MARK: str = "\x00settings"

// The functions that read the catalog (9.80).
const CAT_FNS: []str = ["pg_get_userbyid", "pg_table_is_visible", "pg_type_is_visible", "pg_function_is_visible",
                        "pg_collation_is_visible", "pg_get_expr", "pg_get_constraintdef", "pg_get_indexdef",
                        "pg_get_serial_sequence", "to_regclass", "to_regtype", "to_regnamespace", "obj_description",
                        "col_description", "pg_relation_is_publishable", "pg_partition_ancestors", "current_user",
                        "session_user", "current_schema", "has_table_privilege", "has_schema_privilege", "has_database_privilege",
                        "has_sequence_privilege", "has_any_column_privilege",
                        "pg_get_viewdef", "pg_relation_size", "pg_total_relation_size", "pg_table_size", "pg_indexes_size",
                        "pg_database_size",
                        "format_type"]

pub fn isCatFn(n: &str): bool {
    for f in CAT_FNS { if f == n { return true } }
    return false
}

// A bytea's text: PostgreSQL's hex form, \x0001ff.
pub fn bytesHex(b: &str): str {
    let digits = "0123456789abcdef"
    var out = newStrBuf()
    out.add("\\x")
    for i in 0..len(b) {
        out.addByte(digits[int(b[i]) >> 4])
        out.addByte(digits[int(b[i]) & 15])
    }
    return out.toStr()
}

// The kind of a date or time type's OID (K_DATE ...), else 0.
pub fn timeKind(oid: int): int {
    if oid == OID_DATE { return K_DATE }
    if oid == OID_TIME { return K_TIME }
    if oid == OID_TS { return K_TS }
    if oid == OID_TSTZ { return K_TSTZ }
    if oid == OID_IVAL { return K_IVAL }
    return 0
}

pub fn timeType(oid: int): TypeName { return TypeName{kind: timeKind(oid), oid: oid, prec: 0, scale: 0, len: 0} }

pub type Expr = closed {
    Lit(Val)
    Param(int)                  // $n, from 1
    Col(str)
    Unary(str, Expr)            // "-", "not"
    Bin(str, Expr, Expr)        // + - * / % || = <> < <= > >= and or
    IsNull(Expr, bool)          // IS NULL; true: IS NOT NULL
    Call(str, []Expr, bool)     // name, arguments, count(*)
    Cast(Expr, TypeName)
}

pub type ColDef = record {
    pub name: str
    pub typ: TypeName
    pub notNull: bool
    pub def: Option[Expr]       // a table's column: its DEFAULT (9.38)
    pub missing: Val            // a table's column: its value in rows written before it was added
    pub identity: int           // ID_*: SERIAL or an identity column (9.43)
    pub seq: str                // with one: the catalog key of its sequence, whose nextval is its default
    // A query's column after JOIN ... USING (9.93): "" as any; USING_HIDDEN,
    // the side of a merged pair a bare name does not mean (nor *); else the
    // other sides' names (FULL JOIN), a bare name meaning COALESCE of them
    pub using: str
    pub pos: int                // its place in * when the query has a USING join; -1 none
    pub spell: str              // its name as written, where that differs from name (L6); "" else
    pub coll: str               // a text column's collation, its name as written (L2); "" exact (lexdb's default)
}

pub const USING_HIDDEN: str = "\x00"

// A column's sequence (ColDef.identity).
pub const ID_NONE = 0
pub const ID_BY_DEFAULT = 1     // GENERATED BY DEFAULT AS IDENTITY
pub const ID_ALWAYS = 2         // GENERATED ALWAYS AS IDENTITY: a value given is refused
pub const ID_SERIAL = 3         // serial, bigserial, smallserial

// A column with no default.
pub fn colDef(name: str, typ: TypeName, notNull: bool): ColDef {
    return ColDef{name: name, typ: typ, notNull: notNull, def: None, missing: Val.Null, identity: ID_NONE, seq: "", using: "", pos: -1, spell: "", coll: ""}
}

// A sequence's options as CREATE SEQUENCE, ALTER SEQUENCE and an identity
// column give them (9.43); has*: given.
pub type SeqOpts = record {
    pub typ: int                // AS: OID_INT2, OID_INT4, OID_INT8; 0 not given
    pub inc: int
    pub hasInc: bool
    pub min: int
    pub hasMin: int             // 0 not given, 1 MINVALUE n, 2 NO MINVALUE
    pub max: int
    pub hasMax: int
    pub start: int
    pub hasStart: bool
    pub restart: int            // ALTER: 0 not given, 1 RESTART, 2 RESTART WITH n (restartWith)
    pub restartWith: int
    pub cache: int              // 0 not given
    pub cycle: int              // 0 not given, 1 CYCLE, 2 NO CYCLE
    pub owned: []str            // OWNED BY: [table name, column]; ["", ""] NONE; [] not given
}

pub fn noSeqOpts(): SeqOpts {
    return SeqOpts{typ: 0, inc: 0, hasInc: false, min: 0, hasMin: 0, max: 0, hasMax: 0, start: 0, hasStart: false,
                   restart: 0, restartWith: 0, cache: 0, cycle: 0, owned: []}
}

// An identity column's sequence options.
pub type IdOpts = record { pub col: str; pub opts: SeqOpts }

// The DEFAULT keyword where a value goes (INSERT's VALUES, UPDATE's SET).
pub const DEFAULT_MARK: str = "#default"

pub fn isDefault(x: &Expr): bool {
    match x {
        Expr.Call(n, a, s) { return n == DEFAULT_MARK }
        else { return false }
    }
}

// A table constraint other than its key and NOT NULL (9.39).
pub const C_UNIQUE = 1
pub const C_CHECK = 2
pub const C_FOREIGN = 3

// A foreign key's action when the row it references is deleted or its key
// changed (9.41).
pub const FK_NO_ACTION = 0      // checked at the statement's end
pub const FK_RESTRICT = 1       // checked at once
pub const FK_CASCADE = 2
pub const FK_SET_NULL = 3
pub const FK_SET_DEFAULT = 4

pub type Constraint = record {
    pub kind: int
    pub name: str               // "" when not given: one is made
    pub cols: []str             // UNIQUE's, a foreign key's
    pub expr: Option[Expr]      // CHECK's
    pub refTable: str           // a foreign key's table and columns
    pub refCols: []str
    pub onDelete: int
    pub onUpdate: int
    pub deferrable: bool        // a foreign key's DEFERRABLE (9.85)
    pub deferred: bool          // INITIALLY DEFERRED
}

pub fn newConstraint(kind: int, name: str): Constraint {
    return Constraint{kind: kind, name: name, cols: [], expr: None, refTable: "", refCols: [], onDelete: 0, onUpdate: 0,
                      deferrable: false, deferred: false}
}

pub type SelItem = record {
    pub star: bool
    pub qual: str               // t.* : the table (or alias); "" for *
    pub expr: Option[Expr]
    pub alias: str
    pub spell: str              // its column's name as written: the alias's, or a column's (L6); "" as name
}

// A table in FROM: how it joins the ones before it.
pub const J_FIRST = 0
pub const J_INNER = 1
pub const J_LEFT = 2
pub const J_CROSS = 3
pub const J_RIGHT = 4
pub const J_FULL = 5

pub type FromItem = record {
    pub table: str
    pub alias: str              // the name its columns are qualified by
    pub join: int
    pub on: Option[Expr]
    pub sub: int                // a subquery (in FROM, or a CTE's): its number; -1: a table
    pub cols: []str             // names for its columns (AS x(a, b)); the rest keep theirs
    pub work: int               // a recursive CTE in its own body: the CTE's number (its working table); -1
    pub lateral: bool           // LATERAL: a subquery that sees the FROM items before it
    pub using: []str            // JOIN ... USING (names) (9.93)
    pub natural: bool           // NATURAL JOIN: USING the names both sides have
    pub comma: bool             // first in FROM or after a comma: a join tree starts here (USING's left side, 9.93)
}

// ORDER BY's item: NULLs first or last (by default last going up, first
// going down, as PostgreSQL).
pub type OrderItem = record { pub expr: Expr; pub desc: bool; pub nullsFirst: bool }

pub type SetItem = record { pub col: str; pub expr: Expr }

pub const S_EMPTY = 0
pub const S_CREATE = 1
pub const S_DROP = 2
pub const S_INSERT = 3
pub const S_SELECT = 4
pub const S_UPDATE = 5
pub const S_DELETE = 6
pub const S_BEGIN = 7
pub const S_COMMIT = 8
pub const S_ROLLBACK = 9
pub const S_SET = 10

// The settings lexdb keeps per session (lexdb_exec.Session); SET of any
// other is accepted and ignored.
pub const SETTINGS: []str = ["max_recursion", "statement_timeout", "max_statement_mem", "search_path", "lexdb_batch", "lexdb_planner"]
pub const S_CREATE_INDEX = 11
pub const S_DROP_INDEX = 12
pub const S_EXPLAIN = 13
pub const S_CREATE_SCHEMA = 14
pub const S_DROP_SCHEMA = 15
pub const S_SHOW = 16
pub const S_ALTER = 17
pub const S_ALTER_INDEX = 18    // ALTER INDEX index RENAME TO alters[0].name
pub const S_ALTER_SCHEMA = 19   // ALTER SCHEMA table RENAME TO alters[0].name
pub const S_CREATE_SEQ = 20     // CREATE SEQUENCE table, its options in seq (9.43)
pub const S_ALTER_SEQ = 21
pub const S_DROP_SEQ = 22
pub const S_COPY = 23           // COPY table [(names)] FROM STDIN / TO STDOUT, COPY (inner[0]) TO STDOUT (9.45)
pub const S_SAVEPOINT = 41      // SAVEPOINT name (9.80); its name in table
pub const S_RELEASE = 42        // RELEASE [SAVEPOINT] name
pub const S_ROLLBACK_TO = 43    // ROLLBACK [WORK | TRANSACTION] TO [SAVEPOINT] name
pub const S_CREATE_ROLE = 44    // CREATE ROLE | USER name [WITH] options (9.81): its name in table, options in names
pub const S_ALTER_ROLE = 45     // ALTER ROLE | USER name [WITH] options | RENAME TO new
pub const S_DROP_ROLE = 46      // DROP ROLE | USER [IF EXISTS] name, ...: the names in names
pub const S_CREATE_VIEW = 47    // CREATE [OR REPLACE] VIEW name [(cols)] AS query (9.82): name in table, columns in names,
                                // the query's text in index, OR REPLACE in ifFlag
pub const S_DROP_VIEW = 48      // DROP VIEW [IF EXISTS] name, ... [CASCADE]: the names in cols
pub const S_ALTER_VIEW = 49     // ALTER VIEW [IF EXISTS] name RENAME TO new: the new name in index
pub const S_GRANT = 50          // GRANT (9.83): privileges in names, the object's kind in index, the objects in cols,
                                // the grantees in pk; a role's: index "role", the roles granted in cols
pub const S_REVOKE = 51         // REVOKE: the same
pub const S_OWNER = 52          // ALTER TABLE | VIEW | SEQUENCE | SCHEMA name OWNER TO role: the kind in index, the role in names
pub const S_CREATE_TYPE = 53    // CREATE TYPE name AS ENUM (labels): the labels in names (9.90)
pub const S_DROP_TYPE = 54      // DROP TYPE [IF EXISTS] name, ...: the others in names
pub const S_ALTER_TYPE = 55     // ALTER TYPE name ADD VALUE [IF NOT EXISTS] 'v' [BEFORE | AFTER 'w']: v in names, w in index, "before" or "after" in alias
pub const S_TRUNCATE = 56      // TRUNCATE [TABLE] name, ... [RESTART IDENTITY] [CASCADE] (9.91): the first in table, the
                                // rest in names; RESTART IDENTITY in ifFlag
pub const S_MAINT = 57          // VACUUM, ANALYZE, CHECKPOINT, REINDEX, CLUSTER (9.94), done as nothing: the tag in alias,
                                // the tables to check in names (their columns in maintCols), an index in index; in table
                                // what cannot run in a block ("" none); unique: a view is refused
pub const S_ANALYZE = 58        // ANALYZE, or VACUUM with ANALYZE: S_MAINT's form, run (optimizer 20, 31): its tables in
                                // names ([] every table), its tag in alias

// COPY's options (Stmt.copy).
pub type CopyOpts = record {
    pub from: bool              // FROM STDIN; else TO STDOUT
    pub csv: bool               // FORMAT csv; else text
    pub delim: str              // one byte
    pub null: str               // the text of a NULL
    pub header: bool
    pub quote: str              // CSV: one byte
    pub escape: str             // CSV: one byte
    pub forceQuote: []str       // CSV TO: these columns' values quoted always
    pub quoteAll: bool          // ... FORCE_QUOTE *: every column's
    pub forceNotNull: []str     // CSV FROM: these columns never NULL (o.null is a value)
    pub forceNull: []str        // CSV FROM: these columns NULL when o.null even quoted
    pub batchRows: int          // lexdb's batch_rows n: FROM commits each n rows (9.87); 0 once
}

fn noCopyOpts(): CopyOpts {
    return CopyOpts{from: false, csv: false, delim: "", null: "", header: false, quote: "", escape: "",
                    forceQuote: [], quoteAll: false, forceNotNull: [], forceNull: [], batchRows: 0}
}

// INSERT's OVERRIDING (Stmt.overriding).
pub const OVR_NONE = 0
pub const OVR_SYSTEM = 1        // OVERRIDING SYSTEM VALUE: an ALWAYS identity column takes the value given
pub const OVR_USER = 2          // OVERRIDING USER VALUE: identity columns take their defaults

// ALTER TABLE's actions (Alter.kind).
pub const A_ADD = 1             // ADD COLUMN
pub const A_RENAME_COL = 2      // RENAME COLUMN name TO to
pub const A_RENAME = 3          // RENAME TO name
pub const A_SET_NOT_NULL = 4    // ALTER COLUMN name SET NOT NULL
pub const A_DROP_NOT_NULL = 5   // ALTER COLUMN name DROP NOT NULL
pub const A_DROP_COL = 6        // DROP COLUMN name
pub const A_TYPE = 7            // ALTER COLUMN name TYPE col.typ [USING using]
pub const A_SET_SCHEMA = 8      // SET SCHEMA name
pub const A_SET_DEFAULT = 9     // ALTER COLUMN name SET DEFAULT col.def
pub const A_DROP_DEFAULT = 10   // ALTER COLUMN name DROP DEFAULT
pub const A_ADD_CON = 11        // ADD [CONSTRAINT name] UNIQUE (...) ...
pub const A_DROP_CON = 12       // DROP CONSTRAINT [IF EXISTS] name

pub type Alter = record {
    pub kind: int
    pub col: ColDef             // A_ADD: the column
    pub name: str               // the column changed; A_RENAME: the table's new name
    pub to: str                 // A_RENAME_COL: the column's new name
    pub ifFlag: bool            // ADD COLUMN IF NOT EXISTS, DROP COLUMN IF EXISTS
    pub using: Option[Expr]     // A_TYPE: the new value, of the row as it was
    pub cons: []Constraint      // A_ADD_CON: the constraint
    pub cascade: bool           // DROP COLUMN, DROP CONSTRAINT: CASCADE (foreign keys on it dropped)
}

// A qualified name, schema.name, as the parser gives it: the two joined by
// QSEP (an identifier never holds it, so "a.b" quoted stays one name).
pub const QSEP: str = "\x1f"

// public's names are kept unqualified: public.t is t.
pub fn qual(schema: &str, name: &str): str {
    if schema == "public" { return name }
    return schema + QSEP + name
}

// The schema part of a name (public: unqualified).
pub fn schemaOf(n: &str): str {
    let i = strings.indexOf(n, QSEP, 0)
    if i < 0 { return "public" }
    return n[0..i]
}

pub fn isQual(n: &str): bool { return strings.indexOf(n, QSEP, 0) >= 0 }

// The name part of a possibly qualified name.
pub fn baseName(n: &str): str {
    let i = strings.indexOf(n, QSEP, 0)
    if i < 0 { return n }
    return n[i + len(QSEP)..len(n)]
}

// A possibly qualified name as SQL shows it: schema.name.
pub fn shown(n: &str): str { return strings.replaceAll(n, QSEP, ".") }

pub type Stmt = record {
    pub kind: int
    pub table: str
    pub ifFlag: bool            // IF NOT EXISTS / IF EXISTS; BEGIN READ ONLY; EXPLAIN ANALYZE
    pub cols: []ColDef          // CREATE
    pub pk: []str
    pub names: []str            // INSERT's column list
    pub rows: [][]Expr          // INSERT's VALUES
    pub items: []SelItem        // SELECT; INSERT, UPDATE and DELETE: RETURNING's (9.44)
    pub where: Option[Expr]
    pub group: []Expr
    pub order: []OrderItem
    pub limit: Option[Expr]
    pub offset: Option[Expr]
    pub sets: []SetItem         // UPDATE
    pub params: int             // the highest $n
    pub from: []FromItem        // SELECT
    pub index: str              // CREATE INDEX / DROP INDEX: the index's name
    pub unique: bool
    pub inner: []Stmt           // EXPLAIN: the statement explained
    pub distinct: bool          // SELECT DISTINCT
    pub having: Option[Expr]
    pub subs: []Stmt            // its subqueries: an expression names one by number (#sub, #exists, #in)
    pub use: int                // a subquery: what it is used as (SUB_SCALAR, SUB_EXISTS, SUB_IN)
    pub setop: int              // UNION, INTERSECT or EXCEPT of inner[0] and inner[1] (SET_*); 0 none
    pub setAll: bool            // ... ALL
    pub cte: int                // a CTE where it is used: its number in the statement; -1 none
    pub rec: bool               // a recursive CTE: inner[1] reads its working table
    pub cascade: bool           // DROP SCHEMA, DROP TABLE ... CASCADE
    src: str                    // a scalar subquery: its tokens (one written twice is one subquery)
    pub srf: str                // in FROM, a function: generate_series or unnest; its arguments are items
    pub ordin: bool             // ... WITH ORDINALITY
    pub alters: []Alter         // ALTER TABLE: its actions, in order
    pub cons: []Constraint      // CREATE TABLE's constraints (UNIQUE, CHECK, FOREIGN KEY)
    pub seqNames: []str         // the sequences its nextval, currval and setval calls name (9.43)
    pub seq: SeqOpts            // CREATE and ALTER SEQUENCE's options
    pub idOpts: []IdOpts        // CREATE TABLE, ADD COLUMN: identity columns' sequence options
    pub overriding: int         // INSERT: OVR_*
    pub copy: CopyOpts          // COPY's
    pub wins: []WinDef          // its window calls: an expression names one by number (#win, 9.46)
    pub windows: []NamedWin     // WINDOW name AS (...), ...
    // INSERT ... ON CONFLICT (9.77): CONFLICT_*; its target (columns, or a
    // constraint's name); DO UPDATE's SET in sets, its WHERE in where
    pub conflict: int
    pub conflictCols: []str
    pub conflictCon: str
    pub alias: str              // INSERT INTO t AS alias
    pub conc: bool              // CREATE INDEX CONCURRENTLY, DROP INDEX CONCURRENTLY (9.85)
    pub lockMode: int           // SELECT ... FOR UPDATE and the like (9.86): LOCK_*; 0 none
    pub lockOf: []str           // ... OF these tables (names or aliases); [] all
    pub lockWait: int           // WAIT_BLOCK, WAIT_NOWAIT, WAIT_SKIP
    pub noData: bool            // CREATE TABLE ... AS ... WITH NO DATA (9.88)
    pub into: str               // SELECT ... INTO t: t (9.88); made a CREATE TABLE ... AS
    pub exprs: []Expr           // CREATE INDEX: per column, its expression (9.89; a Lit NULL for a column, whose name is in names)
    // 9.94
    pub distinctOn: []Expr      // SELECT DISTINCT ON (exprs)
    pub withTies: bool          // FETCH FIRST n ROWS WITH TIES (its n in limit)
    pub gsets: [][]int          // GROUP BY ROLLUP, CUBE, GROUPING SETS: each set, places in group; [] a plain GROUP BY
    pub maintCols: [][]str      // S_MAINT: per table in names, the columns named
    // 9.96: CREATE TEMPORARY TABLE, SEQUENCE or VIEW, SELECT ... INTO
    // TEMPORARY; CREATE TABLE's ON COMMIT (ONC_*)
    pub temp: bool
    pub onCommit: int
    pub assign: []str           // T-SQL SELECT @v = expr, ...: each item's variable ("" none); [] no assignment (design/lexdb-tds.md)
    // The spelling of the name the statement makes (CREATE TABLE, VIEW, ...
    // AS, SELECT INTO; L6), "" as table's; and of names', parallel to them
    // where they name columns it makes (CREATE VIEW, CREATE TABLE ... AS)
    pub spell: str
    pub spells: []str
}

pub const ONC_NONE = 0
pub const ONC_PRESERVE = 1
pub const ONC_DELETE = 2
pub const ONC_DROP = 3

pub const CONFLICT_NONE = 0
pub const CONFLICT_NOTHING = 1
pub const CONFLICT_UPDATE = 2

// A window call: f(args) OVER (...). In its query's expressions it is
// Call("#win", [Lit(i), the call]), i its number in Stmt.wins (the call
// kept there for the column's name and type).
pub type WinDef = record {
    pub call: Expr              // Call(name, args, star), the name carrying " filter" and the like
    pub ref: str                // OVER w, OVER (w ...): the named window it starts from; "" none
    pub bare: bool              // OVER w (not in parentheses): the named window as it is, frame and all
    pub part: []Expr            // PARTITION BY
    pub order: []WinOrder       // ORDER BY
    pub frame: Frame
}

pub type WinOrder = record { pub expr: Expr; pub desc: bool; pub nullsFirst: bool }

pub type NamedWin = record { pub name: str; pub def: WinDef }

// A window's frame: FR_NONE (the default), or ROWS, RANGE or GROUPS
// BETWEEN start AND end (B_*), offsets for B_PRECEDING and B_FOLLOWING,
// and EXCLUDE (EX_*).
pub type Frame = record {
    pub mode: int
    pub start: int
    pub startOff: Option[Expr]
    pub end: int
    pub endOff: Option[Expr]
    pub exclude: int
}

pub const FR_NONE = 0
pub const FR_ROWS = 1
pub const FR_RANGE = 2
pub const FR_GROUPS = 3
pub const B_UNBOUNDED_PRECEDING = 1
pub const B_PRECEDING = 2
pub const B_CURRENT = 3
pub const B_FOLLOWING = 4
pub const B_UNBOUNDED_FOLLOWING = 5
pub const EX_NONE = 0
pub const EX_CURRENT = 1
pub const EX_GROUP = 2
pub const EX_TIES = 3

pub fn noFrame(): Frame {
    return Frame{mode: FR_NONE, start: B_UNBOUNDED_PRECEDING, startOff: None, end: B_CURRENT, endOff: None, exclude: EX_NONE}
}

pub const SET_UNION = 1
pub const SET_INTERSECT = 2
pub const SET_EXCEPT = 3

// What a subquery is used as.
pub const SUB_SCALAR = 1
pub const SUB_EXISTS = 2
pub const SUB_IN = 3
pub const SUB_FROM = 4          // in FROM: a subquery, or a CTE where it is used

pub fn newStmt(kind: int): Stmt {
    return Stmt{kind: kind, table: "", ifFlag: false, cols: [], pk: [], names: [], rows: [], items: [], where: None,
                group: [], order: [], limit: None, offset: None, sets: [], params: 0, from: [], index: "",
                unique: false, inner: [], distinct: false, having: None, subs: [], use: 0, setop: 0, setAll: false,
                cte: -1, rec: false, cascade: false, src: "", srf: "", ordin: false, alters: [], cons: [], seqNames: [], seq: noSeqOpts(), idOpts: [], overriding: OVR_NONE,
                copy: noCopyOpts(), wins: [], windows: [], conflict: CONFLICT_NONE, conflictCols: [], conflictCon: "", alias: "", conc: false, lockMode: 0, lockOf: [], lockWait: 0, noData: false, into: "", exprs: [],
                distinctOn: [], withTies: false, gsets: [], maintCols: [], temp: false, onCommit: ONC_NONE, assign: [], spell: "", spells: []}
}

// ---- the lexer

pub const T_EOF = 0
pub const T_IDENT = 1        // folded to lower case
pub const T_QIDENT = 2       // "quoted"
pub const T_NUM = 3
pub const T_STR = 4
pub const T_PARAM = 5
pub const T_OP = 6
pub const T_VAR = 7          // T-SQL: @name or @@name, folded to lower case

// How SQL text is read (design/lexdb-tds.md): lexdb's own dialect, or
// T-SQL's (@variables, [quoted] names, N'...' strings, SQL Server's type
// names; with QUOTED_IDENTIFIER OFF, "..." is a string).
pub type Dialect = value record { pub tsql: bool; pub quotedIdent: bool }

pub fn pgDialect(): Dialect { return Dialect{tsql: false, quotedIdent: true} }

// A token. A name's text is folded (lexdb_sql matches names without regard
// to case, design/lexdb-tds.md L6); spell is its spelling where that differs
// from text: a quoted name's, and in T-SQL a bare name's ("" else).
pub type Tok = value record { pub kind: int; pub text: str; pub at: int; pub spell: str }

// A name's token: its text folded, its spelling kept if that differs.
fn nameTok(kind: int, raw: str, at: int): Tok {
    let f = strings.toLowerAscii(raw)
    return Tok{kind: kind, text: f, at: at, spell: if f == raw { "" } else { raw }}
}

fn syntax(msg: str): lexdb_base.DbErr { return lexdb_base.err("42601", msg) }

fn isIdentStart(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c >= 128 }
fn isIdentChar(c: byte): bool { return isIdentStart(c) || (c >= '0' && c <= '9') || c == '$' }
fn isDigit(c: byte): bool { return c >= '0' && c <= '9' }

// A backslash escape's character, s[i] the one after the backslash, added
// to b: \b \f \n \r \t \v, \ooo octal, \xh[h] hex, else the character
// itself (E'' strings, COPY's text format). The index after it.
pub fn unescape(s: &str, i: int, b: mut &StrBuf): int {
    let c = s[i]
    if c == 'b' { b.addByte(byte(8)) }
    else if c == 'f' { b.addByte(byte(12)) }
    else if c == 'n' { b.addByte('\n') }
    else if c == 'r' { b.addByte('\r') }
    else if c == 't' { b.addByte('\t') }
    else if c == 'v' { b.addByte(byte(11)) }
    else if c >= '0' && c <= '7' {
        var v = 0
        var j = i
        while j < len(s) && j < i + 3 && s[j] >= '0' && s[j] <= '7' {
            v = v * 8 + (int(s[j]) - int('0'))
            j += 1
        }
        b.addByte(byte(v & 255))
        return j
    } else if c == 'x' && i + 1 < len(s) && hexVal(s[i + 1]) >= 0 {
        var v = hexVal(s[i + 1])
        var j = i + 2
        if j < len(s) && hexVal(s[j]) >= 0 {
            v = v * 16 + hexVal(s[j])
            j += 1
        }
        b.addByte(byte(v))
        return j
    } else { b.addByte(c) }
    return i + 1
}

fn hexVal(c: byte): int {
    if c >= '0' && c <= '9' { return int(c) - int('0') }
    if c >= 'a' && c <= 'f' { return int(c) - int('a') + 10 }
    if c >= 'A' && c <= 'F' { return int(c) - int('A') + 10 }
    return -1
}

fn lex(s: &str): Result[[]Tok, lexdb_base.DbErr] { return lexIn(s, pgDialect()) }

// A quoted string or name, s[i] its opening quote, closed by q (doubled
// inside: itself); the index after it.
fn quoted(s: &str, i: int, q: byte, b: mut &StrBuf): Result[int, lexdb_base.DbErr] {
    var j = i + 1
    while true {
        if j >= len(s) { return Err(syntax(if q == '\'' { "unterminated quoted string" } else { "unterminated quoted identifier" })) }
        if s[j] == q {
            if j + 1 < len(s) && s[j + 1] == q {
                b.addByte(q)
                j += 2
                continue
            }
            return Ok(j + 1)
        }
        b.addByte(s[j])
        j += 1
    }
    return Ok(j)
}

fn lexIn(s: &str, dialect: Dialect): Result[[]Tok, lexdb_base.DbErr] {
    var out: []Tok = []
    var i = 0
    let n = len(s)
    while i < n {
        let c = s[i]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 12 {
            i += 1
            continue
        }
        if c == '-' && i + 1 < n && s[i + 1] == '-' {
            while i < n && s[i] != '\n' { i += 1 }
            continue
        }
        if c == '/' && i + 1 < n && s[i + 1] == '*' {
            i += 2
            while i + 1 < n && !(s[i] == '*' && s[i + 1] == '/') { i += 1 }
            i += 2
            continue
        }
        let start = i
        if dialect.tsql {
            // @name and @@name; [name]; N'...'; "..." a string when QUOTED_IDENTIFIER is OFF
            if c == '@' && i + 1 < n && (isIdentStart(s[i + 1]) || s[i + 1] == '@') {
                i += if s[i + 1] == '@' { 2 } else { 1 }
                while i < n && (isIdentChar(s[i]) || s[i] == '@' || s[i] == '#') { i += 1 }
                append(mut &out, Tok{kind: T_VAR, text: strings.toLowerAscii(s[start..i]), at: start, spell: ""})
                continue
            }
            if c == '[' || (c == '"' && dialect.quotedIdent) {
                var b = newStrBuf()
                i = try quoted(s, i, if c == '[' { ']' } else { '"' }, mut &b)
                append(mut &out, nameTok(T_QIDENT, b.toStr(), start))
                continue
            }
            if (c == 'n' || c == 'N') && i + 1 < n && s[i + 1] == '\'' {
                var b = newStrBuf()
                i = try quoted(s, i + 1, '\'', mut &b)
                append(mut &out, Tok{kind: T_STR, text: b.toStr(), at: start, spell: ""})
                continue
            }
            if c == '"' && !dialect.quotedIdent {
                var b = newStrBuf()
                i = try quoted(s, i, '"', mut &b)
                append(mut &out, Tok{kind: T_STR, text: b.toStr(), at: start, spell: ""})
                continue
            }
        }
        if !dialect.tsql && (c == 'e' || c == 'E') && i + 1 < n && s[i + 1] == '\'' {
            // E'...': an escape string (\n, \t, \\, \', octal, \xhh, ...)
            var b = newStrBuf()
            i += 2
            while true {
                if i >= n { return Err(syntax("unterminated quoted string")) }
                let d = s[i]
                if d == '\'' {
                    if i + 1 < n && s[i + 1] == '\'' {
                        b.addByte('\'')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                if d == '\\' && i + 1 < n {
                    i += 1
                    i = unescape(s, i, mut &b)
                    continue
                }
                b.addByte(d)
                i += 1
            }
            append(mut &out, Tok{kind: T_STR, text: b.toStr(), at: start, spell: ""})
            continue
        }
        if isIdentStart(c) {
            while i < n && isIdentChar(s[i]) { i += 1 }
            // a bare name: in T-SQL spelled as written, in PostgreSQL folded
            if dialect.tsql { append(mut &out, nameTok(T_IDENT, s[start..i].toStr(), start)) }
            else { append(mut &out, Tok{kind: T_IDENT, text: strings.toLowerAscii(s[start..i]), at: start, spell: ""}) }
            continue
        }
        if c == '"' {
            var b = newStrBuf()
            i += 1
            while true {
                if i >= n { return Err(syntax("unterminated quoted identifier")) }
                if s[i] == '"' {
                    if i + 1 < n && s[i + 1] == '"' {
                        b.addByte('"')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                b.addByte(s[i])
                i += 1
            }
            append(mut &out, nameTok(T_QIDENT, b.toStr(), start))
            continue
        }
        if isDigit(c) || (c == '.' && i + 1 < n && isDigit(s[i + 1])) {
            while i < n && (isDigit(s[i]) || s[i] == '.') { i += 1 }
            if i < n && (s[i] == 'e' || s[i] == 'E') {
                i += 1
                if i < n && (s[i] == '+' || s[i] == '-') { i += 1 }
                while i < n && isDigit(s[i]) { i += 1 }
            }
            append(mut &out, Tok{kind: T_NUM, text: s[start..i], at: start, spell: ""})
            continue
        }
        if c == '\'' {
            var b = newStrBuf()
            i += 1
            while true {
                if i >= n { return Err(syntax("unterminated quoted string")) }
                if s[i] == '\'' {
                    if i + 1 < n && s[i + 1] == '\'' {
                        b.addByte('\'')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                b.addByte(s[i])
                i += 1
            }
            append(mut &out, Tok{kind: T_STR, text: b.toStr(), at: start, spell: ""})
            continue
        }
        if c == '$' && i + 1 < n && isDigit(s[i + 1]) {
            i += 1
            while i < n && isDigit(s[i]) { i += 1 }
            append(mut &out, Tok{kind: T_PARAM, text: s[start + 1..i], at: start, spell: ""})
            continue
        }
        // operators
        var op = s[i..i + 1]
        if i + 1 < n {
            let two = s[i..i + 2]
            if two == "<=" || two == ">=" || two == "<>" || two == "!=" || two == "||" || two == "::" || two == "!~" || two == "~*" ||
               two == "<<" || two == ">>" || two == "@>" || two == "<@" || two == "&&" { op = two }
            if two == "!~" && i + 2 < n && s[i + 2] == '*' { op = "!~*" }
        }
        if !strings.contains(&"(),;.*+-/%=<>|:![]~&#^@", &op[0..1]) {
            return Err(syntax("syntax error at or near \"" + op + "\""))
        }
        i += len(op)
        append(mut &out, Tok{kind: T_OP, text: op, at: start, spell: ""})
    }
    append(mut &out, Tok{kind: T_EOF, text: "", at: n, spell: ""})
    return Ok(out)
}

// ---- the parser

type P = record {
    toks: []Tok
    pos: int
    params: int
    subs: []Stmt        // the subqueries of the statement being parsed
    ctes: []Cte         // the CTEs in scope, innermost last
    nextCte: int        // the statement's CTEs are numbered
    inCte: []InCte      // the recursive CTEs whose bodies are being parsed
    depth: int          // subqueries deep
    seqs: []str         // the sequences named by nextval, currval and setval so far
    wins: []WinDef      // the window calls of the query being parsed (9.46)
    src: str            // the SQL text (a view keeps its query's, 9.82)
    tsql: bool          // T-SQL (design/lexdb-tds.md): its type names, SELECT @v = ...
    vars: []str         // T-SQL: the variables in scope, @name is $k for vars[k - 1]
    spelled: str        // the spelling of the name name() read last, "" its text (L6)
}

// A CTE: kept as its text (where its tokens start), parsed again as a
// subquery in FROM wherever it is used, seeing the CTEs before it (and a
// recursive one itself).
type Cte = record { name: str; cols: []str; start: int; id: int; rec: bool }

type InCte = record { id: int; depth: int; refs: int }

fn (p: &P) peek(): Tok { return p.toks[p.pos] }
fn (p: &P) peekAt(k: int): Tok {
    let i = if p.pos + k < len(p.toks) { p.pos + k } else { len(p.toks) - 1 }
    return p.toks[i]
}
fn (p: mut &P) next(): Tok {
    let t = p.toks[p.pos]
    if t.kind != T_EOF { p.pos += 1 }
    return t
}

fn near(t: &Tok): lexdb_base.DbErr {
    if t.kind == T_EOF { return syntax("syntax error at end of input") }
    return syntax("syntax error at or near \"" + t.text + "\"")
}

// Is the next token the keyword (or operator) w?
fn (p: &P) isKw(w: str): bool {
    // the token read in place, not copied (asked many times per token)
    let k = p.toks[p.pos].kind
    return (k == T_IDENT || k == T_OP) && p.toks[p.pos].text == w
}

fn (p: mut &P) acceptKw(w: str): bool {
    if p.isKw(w) {
        p.pos += 1
        return true
    }
    return false
}

fn (p: mut &P) expectKw(w: str): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw(w) { return Ok(Unit{}) }
    return Err(near(&p.peek()))
}

const RESERVED: []str = ["select", "from", "where", "group", "order", "by", "limit", "offset", "and", "or", "not", "is",
                  "null", "as", "values", "set", "into", "insert", "update", "delete", "create", "table",
                  "primary", "asc", "desc", "true", "false", "cast", "on", "join", "inner", "left",
                  "right", "full", "outer", "cross", "using", "natural", "having", "distinct", "in", "like", "ilike", "between",
                  "case", "when", "then", "else", "end", "union", "intersect", "except", "with", "returning", "window", "for"]

// Whether w is a reserved word (RESERVED's): a match on the words, three
// times faster than a loop over the list (9.53; the parser asks per name).
pub fn isReservedWord(w: &str): bool { return isReserved(w) }

fn isReserved(w: &str): bool {
    match w {
        "select", "from", "where", "group", "order", "by", "limit", "offset", "and", "or", "not", "is", "null", "as", "values", "set", "into", "insert", "update", "delete", "create", "table", "primary", "asc", "desc", "true", "false", "cast", "on", "join", "inner", "left", "right", "full", "outer", "cross", "using", "natural", "having", "distinct", "in", "like", "ilike", "between", "case", "when", "then", "else", "end", "union", "intersect", "except", "with", "returning", "window", "for" { return true }
        else { return false }
    }
}

fn (p: mut &P) name(): Result[str, lexdb_base.DbErr] {
    let t = p.peek()
    if t.kind == T_QIDENT || (t.kind == T_IDENT && !isReserved(&t.text)) {
        p.pos += 1
        p.spelled = t.spell
        return Ok(t.text)
    }
    return Err(near(&t))
}

// A table's (or an index's) name: name or schema.name (qual).
fn (p: mut &P) qname(): Result[str, lexdb_base.DbErr] {
    let first = try p.name()
    if p.acceptKw(".") { return Ok(qual(&first, &(try p.name()))) }
    return Ok(first)
}

// A relation's name where a statement reads or writes it: qname, but
// public.name kept so (PUBLIC_Q), not made name: a temporary relation of
// the name, found first along the path, must not hide it (9.96). The
// executor's lookups (lexdb_exec.catKey) make it name.
fn (p: mut &P) rname(): Result[str, lexdb_base.DbErr] {
    let first = try p.name()
    if p.acceptKw(".") {
        let n = try p.name()
        if first == "public" { return Ok(PUBLIC_Q + n) }
        return Ok(qual(&first, &n))
    }
    return Ok(first)
}

// "public" and QSEP: an explicitly public name (rname).
pub const PUBLIC_Q: str = "public\x1f"

fn (p: mut &P) typeName(): Result[TypeName, lexdb_base.DbErr] {
    // pg_catalog.type: the type
    if p.peek().kind == T_IDENT && p.peek().text == "pg_catalog" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." { p.pos += 2 }
    let quoted = p.peek().kind == T_QIDENT
    let w = try p.name()
    var t = TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}
    if p.tsql {
        match try p.tsqlType(&w) {
            Some(x) { return Ok(x) }
            None {}
        }
    }
    if quoted && w == "char" { return p.arraySuffix(TypeName{kind: K_TEXT, oid: OID_CHAR, prec: 0, scale: 0, len: 0}) }
    match w {
        "oid" { t = TypeName{kind: K_INT, oid: OID_OID, prec: 0, scale: 0, len: 0} }
        "name" { t = TypeName{kind: K_TEXT, oid: OID_NAME, prec: 0, scale: 0, len: 0} }
        "regclass", "regtype", "regnamespace", "regproc", "regprocedure", "regrole" {
            // catalog lookups: the statement binds the catalog (9.80)
            append(mut &p.seqs, CAT_MARK)
            let o = if w == "regclass" { OID_REGCLASS } else if w == "regtype" { OID_REGTYPE } else if w == "regnamespace" { OID_REGNAMESPACE } else { OID_REGPROC }
            t = TypeName{kind: K_REG, oid: o, prec: 0, scale: 0, len: 0}
        }
        "int2vector" { return Ok(TypeName{kind: K_ARRAY, oid: 22, prec: 0, scale: 0, len: 0}) }
        "oidvector" { return Ok(TypeName{kind: K_ARRAY, oid: 30, prec: 0, scale: 0, len: 0}) }
        "int", "integer", "int4" { t = TypeName{kind: K_INT, oid: OID_INT4, prec: 0, scale: 0, len: 0} }
        "bigint", "int8" { t = TypeName{kind: K_INT, oid: OID_INT8, prec: 0, scale: 0, len: 0} }
        "smallint", "int2" { t = TypeName{kind: K_INT, oid: OID_INT2, prec: 0, scale: 0, len: 0} }
        "boolean", "bool" { t = TypeName{kind: K_BOOL, oid: OID_BOOL, prec: 0, scale: 0, len: 0} }
        "numeric", "decimal" { t = TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 0, scale: 0, len: 0} }
        "text" { t = TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0} }
        "varchar" { t = TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: 0} }
        "date" { t = timeType(OID_DATE) }
        "uuid" { t = TypeName{kind: K_UUID, oid: OID_UUID, prec: 0, scale: 0, len: 0} }
        "real", "float4" { t = floatType(OID_FLOAT4) }
        "float8" { t = floatType(OID_FLOAT8) }
        "double" {
            try p.expectKw("precision")
            t = floatType(OID_FLOAT8)
        }
        "float" {
            // float(p): real to 24 bits, double precision to 53
            var oid = OID_FLOAT8
            if p.acceptKw("(") {
                let n = try p.intLit()
                if n < 1 { return Err(lexdb_base.err("22023", "precision for type float must be at least 1 bit")) }
                if n > 53 { return Err(lexdb_base.err("22023", "precision for type float must be less than 54 bits")) }
                if n <= 24 { oid = OID_FLOAT4 }
                try p.expectKw(")")
            }
            return Ok(try p.arraySuffix(floatType(oid)))
        }
        "bytea" { t = TypeName{kind: K_BYTEA, oid: OID_BYTEA, prec: 0, scale: 0, len: 0} }
        "time", "timestamp", "timestamptz", "timetz", "interval" {
            var oid = if w == "time" { OID_TIME } else if w == "interval" { OID_IVAL } else if w == "timestamptz" { OID_TSTZ } else if w == "timetz" { 0 } else { OID_TS }
            t = timeType(oid)
            if p.acceptKw("(") {
                let n = try p.intLit()
                if n < 0 || n > 6 { return Err(lexdb_base.err("22023", "precision " + n.toStr() + " must be between 0 and 6")) }
                t.prec = 1
                t.scale = n
                try p.expectKw(")")
            }
            if (w == "time" || w == "timestamp") && (p.isKw("with") || p.isKw("without")) {
                let with = p.acceptKw("with")
                if !with { try p.expectKw("without") }
                try p.expectKw("time")
                try p.expectKw("zone")
                if with { oid = if w == "time" { 0 } else { OID_TSTZ } }
            }
            if oid == 0 { return Err(lexdb_base.err("0A000", "lexdb: time with time zone is not supported (use timestamptz)")) }
            t.kind = timeKind(oid)
            t.oid = oid
            if w == "interval" { t.prec = 0 }       // fields (interval day to second) are not read
            return Ok(try p.arraySuffix(t))
        }
        "character", "char", "bpchar", "nchar" {
            if w != "bpchar" && p.acceptKw("varying") {
                t = TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: 0}
            } else {
                // char(n) (9.94): char alone is char(1), bpchar has no length
                t = TypeName{kind: K_TEXT, oid: OID_BPCHAR, prec: 0, scale: 0, len: if w == "bpchar" { 0 } else { 1 }}
                if p.acceptKw("(") {
                    t.len = try p.intLit()
                    if t.len < 1 { return Err(lexdb_base.err("22023", "length for type " + (if w == "bpchar" { "bpchar" } else { "char" }) + " must be at least 1")) }
                    if t.len > 10485760 { return Err(lexdb_base.err("22023", "length for type " + (if w == "bpchar" { "bpchar" } else { "char" }) + " cannot exceed 10485760")) }
                    try p.expectKw(")")
                }
                return p.arraySuffix(t)
            }
        }
        else {
            // a type of the user's (9.90): an enum, found when the statement runs
            var key = w
            if p.isKw(".") && (p.peekAt(1).kind == T_IDENT || p.peekAt(1).kind == T_QIDENT) {
                p.pos += 1
                key = qual(&w, &(try p.name()))
            }
            if p.isKw("[") { return Err(lexdb_base.err("0A000", "lexdb: arrays of enum types are not supported")) }
            append(mut &p.seqs, TYPE_MARK + key)
            return Ok(TypeName{kind: K_ENUM, oid: nameOid(&"T", &key), prec: 0, scale: 0, len: 0})
        }
    }
    if p.acceptKw("(") {
        let a = try p.intLit()
        if t.kind == K_NUM {
            t.prec = a
            if p.acceptKw(",") { t.scale = try p.intLit() }
            if t.prec < 1 || t.prec > 38 {
                return Err(lexdb_base.err("22023", "NUMERIC precision " + t.prec.toStr() + " must be between 1 and 38"))
            }
            if t.scale < 0 || t.scale > t.prec {
                return Err(lexdb_base.err("22023", "NUMERIC scale " + t.scale.toStr() + " must be between 0 and precision " + t.prec.toStr()))
            }
        } else if t.kind == K_TEXT {
            t.len = a
        } else {
            return Err(near(&p.toks[p.pos - 1]))
        }
        try p.expectKw(")")
    }
    return p.arraySuffix(t)
}

// T[]: an array of T (its length, if given, is not kept: PostgreSQL does
// not check it either); else t.
fn (p: mut &P) arraySuffix(t: TypeName): Result[TypeName, lexdb_base.DbErr] {
    if p.acceptKw("[") {
        if p.peek().kind == T_NUM { let n = try p.intLit() }
        try p.expectKw("]")
        return Ok(TypeName{kind: K_ARRAY, oid: arrayOid(t.oid), prec: 0, scale: 0, len: 0})
    }
    return Ok(t)
}

fn (p: mut &P) intLit(): Result[int, lexdb_base.DbErr] {
    let t = p.next()
    if t.kind != T_NUM { return Err(near(&t)) }
    match strings.parseIntOpt(t.text) {
        Some(n) { return Ok(n) }
        None { return Err(near(&t)) }
    }
}

// ---- expressions, by precedence: OR, AND, NOT, comparison and IS, ||,
// + -, * / %, unary -, ::.

fn (p: mut &P) expr(): Result[Expr, lexdb_base.DbErr] { return p.orExpr() }

fn (p: mut &P) orExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.andExpr()
    while p.acceptKw("or") {
        let r = try p.andExpr()
        e = Expr.Bin("or", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) andExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.notExpr()
    while p.acceptKw("and") {
        let r = try p.notExpr()
        e = Expr.Bin("and", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) notExpr(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("not") {
        let e = try p.notExpr()
        return Ok(Expr.Unary("not", e))
    }
    return p.cmpExpr()
}

fn (p: mut &P) cmpExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.catExpr()
    let t = p.peek()
    if t.kind == T_OP && (t.text == "=" || t.text == "<>" || t.text == "!=" || t.text == "<" || t.text == "<=" ||
                          t.text == ">" || t.text == ">=") {
        p.pos += 1
        let op = if t.text == "!=" { "<>" } else { t.text }
        let q = p.peek()
        if q.kind == T_IDENT && (q.text == "any" || q.text == "some" || q.text == "all") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
            // x op ANY (array), x op ALL (array): the call "any op" or "all op"
            // (9.28); with a subquery, = ANY is IN and <> ALL is NOT IN
            let all = q.text == "all"
            p.pos += 2
            if isRow(&e) {
                // (a, b) = ANY (subquery) is IN, <> ALL NOT IN (9.94)
                if (p.isKw("select") || p.isKw("with")) && ((op == "=" && !all) || (op == "<>" && all)) {
                    return Ok(negate(all, try p.rowSub(&"in", &e)))
                }
                return Err(lexdb_base.err("0A000", "lexdb: a row before ANY or ALL is supported with = ANY (subquery) and <> ALL (subquery) only"))
            }
            if p.isKw("select") || p.isKw("with") {
                if (op == "=" && !all) || (op == "<>" && all) {
                    let i = try p.subquery(SUB_IN)
                    return Ok(negate(all, Expr.Call("#in", [Expr.Lit(Val.Int(i)), e], false)))
                }
                // another op: over the array of the subquery's values (9.94)
                let arr = try p.arrayOfSub()
                return Ok(Expr.Call((if all { "all " } else { "any " }) + op, [e, arr], false))
            }
            let arr = try p.expr()
            try p.expectKw(")")
            return Ok(Expr.Call((if all { "all " } else { "any " }) + op, [e, arr], false))
        }
        if isRow(&e) && p.isKw("(") && (p.peekAt(1).text == "select" || p.peekAt(1).text == "with") {
            // (a, b) op (subquery) (9.94)
            p.pos += 1
            return p.rowSub(&op, &e)
        }
        let r = try p.catExpr()
        if isRow(&e) || isRow(&r) { return rowCmp(&op, &e, &r) }
        return Ok(Expr.Bin(op, e, r))
    }
    // x ~ pattern, !~, ~*, !~*; OPERATOR(pg_catalog.op) as op (9.80)
    var rop = ""
    if t.kind == T_OP && (t.text == "~" || t.text == "!~" || t.text == "~*" || t.text == "!~*") {
        p.pos += 1
        rop = t.text
    } else if t.kind == T_IDENT && t.text == "operator" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
        p.pos += 2
        if p.peek().kind == T_IDENT && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." { p.pos += 2 }
        let o = p.next()
        if o.kind != T_OP { return Err(near(&o)) }
        try p.expectKw(")")
        rop = if o.text == "!=" { "<>" } else { o.text }
        if rop == "=" || rop == "<>" || rop == "<" || rop == "<=" || rop == ">" || rop == ">=" {
            let r = try p.catExpr()
            return Ok(Expr.Bin(rop, e, r))
        }
        if rop != "~" && rop != "!~" && rop != "~*" && rop != "!~*" { return Err(lexdb_base.err("42883", "operator does not exist: " + rop)) }
    }
    if len(rop) > 0 {
        let r = try p.catExpr()
        return Ok(Expr.Call(rop, [e, r], false))
    }
    // [NOT] LIKE, ILIKE, SIMILAR TO, IN, BETWEEN
    var neg = false
    let nt = p.peekAt(1)
    if p.isKw("not") && nt.kind == T_IDENT && (nt.text == "like" || nt.text == "ilike" || nt.text == "in" || nt.text == "between" ||
                                               nt.text == "similar") {
        p.pos += 1
        neg = true
    }
    if p.isKw("like") || p.isKw("ilike") {
        let kw = p.next().text
        let q = p.peek()
        if q.kind == T_IDENT && (q.text == "any" || q.text == "some" || q.text == "all") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
            // x [NOT] LIKE ANY | ALL (array or subquery) (9.94): the call "any like",
            // "all not like" and the like; NOT is the element's, as PostgreSQL's
            let all = q.text == "all"
            p.pos += 2
            var arr = Expr.Lit(Val.Null)
            if p.isKw("select") || p.isKw("with") {
                arr = try p.arrayOfSub()
            } else {
                arr = try p.expr()
                try p.expectKw(")")
            }
            return Ok(Expr.Call((if all { "all " } else { "any " }) + (if neg { "not " } else { "" }) + kw, [e, arr], false))
        }
        var args: []Expr = [e]
        append(mut &args, try p.catExpr())
        if p.acceptKw("escape") { append(mut &args, try p.catExpr()) }
        return Ok(negate(neg, Expr.Call(kw, args, false)))
    }
    if p.isKw("similar") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "to" {
        // x SIMILAR TO pattern [ESCAPE e] (9.94): the call "similar"
        p.pos += 2
        var args: []Expr = [e]
        append(mut &args, try p.catExpr())
        if p.acceptKw("escape") { append(mut &args, try p.catExpr()) }
        return Ok(negate(neg, Expr.Call("similar", args, false)))
    }
    if p.acceptKw("in") {
        try p.expectKw("(")
        if isRow(&e) {
            // (a, b) IN ((1, 2), (3, 4)): row equalities ORed; IN (subquery) (9.94)
            if p.isKw("select") || p.isKw("with") { return Ok(negate(neg, try p.rowSub(&"in", &e))) }
            var any = try rowCmp(&"=", &e, &(try p.expr()))
            while p.acceptKw(",") { any = Expr.Bin("or", any, try rowCmp(&"=", &e, &(try p.expr()))) }
            try p.expectKw(")")
            return Ok(negate(neg, any))
        }
        if p.isKw("select") || p.isKw("with") {
            let i = try p.subquery(SUB_IN)
            return Ok(negate(neg, Expr.Call("#in", [Expr.Lit(Val.Int(i)), e], false)))
        }
        var args: []Expr = [e]
        append(mut &args, try p.expr())
        while p.acceptKw(",") { append(mut &args, try p.expr()) }
        try p.expectKw(")")
        return Ok(negate(neg, Expr.Call("in", args, false)))
    }
    if p.acceptKw("between") {
        // a BETWEEN b AND c is a >= b AND a <= c: the planner knows those.
        // SYMMETRIC (9.94): either way round, (a >= b AND a <= c) OR (a >= c
        // AND a <= b), as PostgreSQL rewrites it
        let sym = p.acceptKw("symmetric")
        if !sym { let asym = p.acceptKw("asymmetric") }
        let lo = try p.catExpr()
        try p.expectKw("and")
        let hi = try p.catExpr()
        let x = Expr.Bin("and", try cmpOf(&">=", &e, &lo), try cmpOf(&"<=", &e, &hi))
        if sym {
            let other = Expr.Bin("and", try cmpOf(&">=", &e, &hi), try cmpOf(&"<=", &e, &lo))
            return Ok(negate(neg, Expr.Bin("or", x, other)))
        }
        return Ok(negate(neg, x))
    }
    if neg { return Err(near(&p.peek())) }
    if p.acceptKw("is") {
        let isNot = p.acceptKw("not")
        if p.acceptKw("distinct") {
            try p.expectKw("from")
            let r = try p.catExpr()
            if isRow(&e) || isRow(&r) {
                // rows (9.94): distinct when a pair of fields is
                let ls = try rowItems(&e)
                let rs = try rowItems(&r)
                if len(ls) != len(rs) { return Err(lexdb_base.err("42601", "unequal number of entries in row expressions")) }
                var d = Expr.Call("distinct from", [cloneE(&ls[0]), cloneE(&rs[0])], false)
                for i in 1..len(ls) { d = Expr.Bin("or", d, Expr.Call("distinct from", [cloneE(&ls[i]), cloneE(&rs[i])], false)) }
                return Ok(if isNot { Expr.Unary("not", d) } else { d })
            }
            let d = Expr.Call("distinct from", [e, r], false)
            return Ok(if isNot { Expr.Unary("not", d) } else { d })
        }
        if p.acceptKw("null") {
            if isRow(&e) {
                // a row IS NULL: each field is; IS NOT NULL: none is (9.94)
                let xs = try rowItems(&e)
                var all = Expr.IsNull(cloneE(&xs[0]), isNot)
                for i in 1..len(xs) { all = Expr.Bin("and", all, Expr.IsNull(cloneE(&xs[i]), isNot)) }
                return Ok(all)
            }
            return Ok(Expr.IsNull(e, isNot))
        }
        if p.acceptKw("true") {
            let x = Expr.Bin("=", e, Expr.Lit(Val.Bool(true)))
            return Ok(if isNot { Expr.Unary("not", x) } else { x })
        }
        if p.acceptKw("false") {
            let x = Expr.Bin("=", e, Expr.Lit(Val.Bool(false)))
            return Ok(if isNot { Expr.Unary("not", x) } else { x })
        }
        return Err(near(&p.peek()))
    }
    return Ok(e)
}

// ||, and the bitwise & | # << >> (9.85): PostgreSQL's "any other
// operator", between + - and the comparisons, left to right.
fn (p: mut &P) catExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.addExpr()
    while p.isKw("||") || p.isKw("&") || p.isKw("|") || p.isKw("#") || p.isKw("<<") || p.isKw(">>") || p.isKw("@>") ||
          p.isKw("<@") || p.isKw("&&") {
        let op = p.next().text
        let r = try p.addExpr()
        // the array operators (9.92) are calls
        e = if op == "@>" || op == "<@" || op == "&&" { Expr.Call(op, [e, r], false) } else { Expr.Bin(op, e, r) }
    }
    return Ok(e)
}

fn (p: mut &P) addExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.mulExpr()
    while p.isKw("+") || p.isKw("-") {
        let op = p.next().text
        let r = try p.mulExpr()
        e = Expr.Bin(op, e, r)
    }
    return Ok(e)
}

fn (p: mut &P) mulExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.powExpr()
    while p.isKw("*") || p.isKw("/") || p.isKw("%") {
        let op = p.next().text
        let r = try p.powExpr()
        e = Expr.Bin(op, e, r)
    }
    return Ok(e)
}

// x ^ y (9.92): above * and /, below a sign, left to right, as PostgreSQL's.
fn (p: mut &P) powExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.atExpr()
    while p.isKw("^") {
        p.pos += 1
        let r = try p.atExpr()
        e = Expr.Bin("^", e, r)
    }
    return Ok(e)
}

// x AT TIME ZONE zone, x AT LOCAL (9.95): above ^, as PostgreSQL's; the
// calls timezone(zone, x) and timezone(x).
fn (p: mut &P) atExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.unary()
    while p.isKw("at") && p.toks[p.pos + 1].kind == T_IDENT &&
          ((p.toks[p.pos + 1].text == "time" && p.toks[p.pos + 2].kind == T_IDENT && p.toks[p.pos + 2].text == "zone") ||
           p.toks[p.pos + 1].text == "local") {
        p.pos += 1
        if p.acceptKw("local") {
            e = Expr.Call("timezone", [e], false)
        } else {
            p.pos += 2
            let z = try p.unary()
            e = Expr.Call("timezone", [z, e], false)
        }
    }
    return Ok(e)
}

fn (p: mut &P) unary(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("-") {
        let e = try p.unary()
        return Ok(Expr.Unary("-", e))
    }
    if p.acceptKw("~") {
        let e = try p.unary()
        return Ok(Expr.Unary("~", e))
    }
    if p.acceptKw("+") { return p.unary() }
    var e = try p.primary()
    while true {
        if p.acceptKw("::") {
            let t = try p.typeName()
            e = Expr.Cast(e, t)
        } else if p.acceptKw("[") {
            // x[i]: an array's element (9.80)
            let i = try p.expr()
            try p.expectKw("]")
            e = Expr.Call("#elem", [e, i], false)
        } else if p.acceptKw("collate") {
            // x COLLATE name: the call "#collate" (L2: an explicit collation)
            let c = try p.collName()
            e = Expr.Call("#collate", [e, Expr.Lit(Val.Text(c))], false)
        } else {
            break
        }
    }
    return Ok(e)
}

// At a call's "(": whether its arguments are the SQL standard's words
// (FROM, FOR, PLACING) rather than commas.
fn (p: &P) sqlForm(): bool {
    var depth = 0
    var i = p.pos
    while i < len(p.toks) {
        let t = p.toks[i]
        if t.kind == T_EOF { return false }
        if t.kind == T_OP && (t.text == "(" || t.text == "[") { depth += 1 }
        if t.kind == T_OP && (t.text == ")" || t.text == "]") {
            depth -= 1
            if depth == 0 { return false }
        }
        if depth == 1 && t.kind == T_OP && t.text == "," { return false }
        if depth == 1 && t.kind == T_IDENT && (t.text == "from" || t.text == "for" || t.text == "placing" || t.text == "similar") { return true }
        i += 1
    }
    return false
}

fn negate(neg: bool, x: Expr): Expr { return if neg { Expr.Unary("not", x) } else { x } }

fn cloneE(x: &Expr): Expr {
    match x {
        Expr.Lit(v) { return Expr.Lit(v) }
        Expr.Param(n) { return Expr.Param(n) }
        Expr.Col(n) { return Expr.Col(n) }
        Expr.Unary(op, a) { return Expr.Unary(op, cloneE(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, cloneE(&a), cloneE(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(cloneE(&a), neg) }
        Expr.Cast(a, t) { return Expr.Cast(cloneE(&a), t) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, cloneE(&a)) }
            return Expr.Call(n, out, star)
        }
    }
}

// CASE [x] WHEN a THEN b ... [ELSE c] END: a call "case" (or "case else")
// of the WHEN and THEN pairs, then the ELSE; CASE x WHEN a is WHEN x = a.
fn (p: mut &P) caseExpr(): Result[Expr, lexdb_base.DbErr] {
    var operand: []Expr = []
    if !p.isKw("when") { append(mut &operand, try p.expr()) }
    var args: []Expr = []
    while p.acceptKw("when") {
        var w = try p.expr()
        if len(operand) > 0 { w = Expr.Bin("=", cloneE(&operand[0]), w) }
        try p.expectKw("then")
        append(mut &args, w)
        append(mut &args, try p.expr())
    }
    if len(args) == 0 { return Err(near(&p.peek())) }
    var name = "case"
    if p.acceptKw("else") {
        append(mut &args, try p.expr())
        name = "case else"
    }
    try p.expectKw("end")
    return Ok(Expr.Call(name, args, false))
}

// A subquery, after its "(": its own subqueries go with it, and the
// statement it is in gets it, numbered.
fn (p: mut &P) subquery(use: int): Result[int, lexdb_base.DbErr] {
    p.depth += 1
    let start = p.pos
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var pushed = 0
    if p.acceptKw("with") { pushed = try p.withList() }
    try p.expectKw("select")
    var sq = try p.select()
    p.popCtes(pushed)
    sq.subs = replace(mut &p.subs, saved)
    sq.wins = replace(mut &p.wins, savedW)
    sq.use = use
    p.depth -= 1
    // a scalar subquery written again in the same query is the same one:
    // GROUP BY (subquery) then matches it in the select list, and it runs
    // once per row
    if use == SUB_SCALAR {
        var kb = newStrBuf()
        for i in start..p.pos {
            kb.add(p.toks[i].kind.toStr())
            kb.addByte(1)
            kb.add(p.toks[i].text)
            kb.addByte(0)
        }
        sq.src = kb.toStr()
        for i in 0..len(p.subs) {
            if p.subs[i].use == SUB_SCALAR && p.subs[i].src == sq.src {
                try p.expectKw(")")
                return Ok(i)
            }
        }
    }
    try p.expectKw(")")
    append(mut &p.subs, sq)
    return Ok(len(p.subs) - 1)
}

// WITH's list, after "with": the CTEs go in scope (how many: the result).
// Each is parsed now to check it, and again where it is used.
fn (p: mut &P) withList(): Result[int, lexdb_base.DbErr] {
    let rec = p.acceptKw("recursive")
    var n = 0
    while true {
        let name = try p.name()
        var cols: []str = []
        if p.acceptKw("(") {
            append(mut &cols, try p.name())
            while p.acceptKw(",") { append(mut &cols, try p.name()) }
            try p.expectKw(")")
        }
        try p.expectKw("as")
        if p.acceptKw("not") { try p.expectKw("materialized") } else { let m = p.acceptKw("materialized") }
        try p.expectKw("(")
        for k in len(p.ctes) - n..len(p.ctes) {
            if p.ctes[k].name == name {
                return Err(lexdb_base.err("42712", "WITH query name \"" + name + "\" specified more than once"))
            }
        }
        let id = p.nextCte
        p.nextCte += 1
        let start = p.pos
        // a recursive one is in scope in its own body
        if rec {
            var cs: []str = []
            for c in cols { append(mut &cs, c) }
            append(mut &p.ctes, Cte{name: name, cols: cs, start: start, id: id, rec: true})
        }
        let keep = len(p.subs)
        if rec { append(mut &p.inCte, InCte{id: id, depth: p.depth + 1, refs: 0}) }
        let i = try p.subquery(SUB_FROM)
        if rec { let x = pop(mut &p.inCte) }
        while len(p.subs) > keep { let x = pop(mut &p.subs) }
        if !rec { append(mut &p.ctes, Cte{name: name, cols: cols, start: start, id: id, rec: false}) }
        n += 1
        if !p.acceptKw(",") { break }
    }
    return Ok(n)
}

fn (p: mut &P) popCtes(n: int) { for i in 0..n { let c = pop(mut &p.ctes) } }

// A use of CTE ci: its text parsed again, here, with the CTEs before it in
// scope.
fn (p: mut &P) cteRef(ci: int): Result[int, lexdb_base.DbErr] {
    let saved = replace(mut &p.ctes, [])
    let rec = saved[ci].rec
    let id = saved[ci].id
    let upto = if rec { ci + 1 } else { ci }
    for i in 0..upto {
        var cols: []str = []
        for c in saved[i].cols { append(mut &cols, c) }
        append(mut &p.ctes, Cte{name: saved[i].name, cols: cols, start: saved[i].start, id: saved[i].id, rec: saved[i].rec})
    }
    let pos = p.pos
    p.pos = saved[ci].start
    if rec { append(mut &p.inCte, InCte{id: id, depth: p.depth + 1, refs: 0}) }
    let r = p.subquery(SUB_FROM)
    var selfRefs = 0
    if rec { selfRefs = pop(mut &p.inCte).refs }
    p.pos = pos
    p.ctes = saved
    let i = try r
    p.subs[i].cte = id
    p.subs[i].rec = selfRefs > 0
    return Ok(i)
}

fn subRef(name: str, i: int): Expr { return Expr.Call(name, [Expr.Lit(Val.Int(i))], false) }

// A row constructor, (a, b) or ROW(a, b) (9.94): the call "row". Rows are
// compared, field by field, and nothing else.
pub fn isRow(x: &Expr): bool {
    match x {
        Expr.Call(n, args, star) { return n == "row" && !star }
        else { return false }
    }
}

// Whether x names one of its statement's subqueries or window calls by
// number (#sub, #win and the like).
fn hasMark(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasMark(&a) }
        Expr.Bin(_, a, b) { return hasMark(&a) || hasMark(&b) }
        Expr.IsNull(a, _) { return hasMark(&a) }
        Expr.Cast(a, _) { return hasMark(&a) }
        Expr.Call(n, args, _) {
            if n == "#sub" || n == "#exists" || n == "#in" || n == "#win" { return true }
            for a in args { if hasMark(&a) { return true } }
            return false
        }
        else { return false }
    }
}

fn rowItems(x: &Expr): Result[[]Expr, lexdb_base.DbErr] {
    match x {
        Expr.Call(n, args, star) {
            if n == "row" {
                var out: []Expr = []
                for a in args { append(mut &out, cloneE(&a)) }
                return Ok(out)
            }
        }
        else {}
    }
    return Err(lexdb_base.err("42883", "operator does not exist: a row compared with a value that is not a row"))
}

// Two rows compared (9.94), as PostgreSQL: = when each pair is equal, <>
// when one is not; <, <=, >, >= by the first pair not equal, NULL when a
// pair before it is NULL: (a, b) < (c, d) is a < c OR (a = c AND b < d).
// The order's comparisons start with a <= c (or a >= c), true whenever the
// whole is, so that an index on a serves as a range.
fn rowCmp(op: &str, l: &Expr, r: &Expr): Result[Expr, lexdb_base.DbErr] {
    let ls = try rowItems(l)
    let rs = try rowItems(r)
    let n = len(ls)
    if n != len(rs) { return Err(lexdb_base.err("42601", "unequal number of entries in row expressions")) }
    if n == 0 { return Err(lexdb_base.err("42601", "cannot compare rows of zero length")) }
    if op == "=" || op == "<>" {
        var x = Expr.Bin(op.toStr(), cloneE(&ls[0]), cloneE(&rs[0]))
        for i in 1..n { x = Expr.Bin(if op == "=" { "and" } else { "or" }, x, Expr.Bin(op.toStr(), cloneE(&ls[i]), cloneE(&rs[i]))) }
        return Ok(x)
    }
    let strict = op[0..1].toStr()
    var x = Expr.Bin(op.toStr(), cloneE(&ls[n - 1]), cloneE(&rs[n - 1]))
    var i = n - 2
    while i >= 0 {
        x = Expr.Bin("or", Expr.Bin(strict, cloneE(&ls[i]), cloneE(&rs[i])), Expr.Bin("and", Expr.Bin("=", cloneE(&ls[i]), cloneE(&rs[i])), x))
        i -= 1
    }
    if n > 1 { x = Expr.Bin("and", Expr.Bin(strict + "=", cloneE(&ls[0]), cloneE(&rs[0])), x) }
    return Ok(x)
}

// l op r, rows too (rowCmp).
fn cmpOf(op: &str, l: &Expr, r: &Expr): Result[Expr, lexdb_base.DbErr] {
    if isRow(l) || isRow(r) { return rowCmp(op, l, r) }
    return Ok(Expr.Bin(op.toStr(), cloneE(l), cloneE(r)))
}

// A row compared with a subquery's row, after the "(" (9.94): op, or "in"
// (= ANY). A scalar subquery over the subquery, its columns named "#1",
// "#2", ...: (SELECT row op (#1, #2) FROM (subquery) AS "#row"("#1", ...)),
// NULL for no rows and an error for two; for IN, of its rows' answers the
// best: true, else NULL, else false (none).
fn (p: mut &P) rowSub(op: &str, row: &Expr): Result[Expr, lexdb_base.DbErr] {
    let xs = try rowItems(row)
    for x in xs {
        if hasMark(&x) { return Err(lexdb_base.err("0A000", "lexdb: a subquery or window call in a row compared with a subquery is not supported")) }
    }
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let inner = try p.subquery(SUB_FROM)
    var star = false
    for it in p.subs[inner].items { if it.star { star = true } }
    let k = len(p.subs[inner].items)
    if !star && k > len(xs) { return Err(lexdb_base.err("42601", "subquery has too many columns")) }
    if !star && k < len(xs) { return Err(lexdb_base.err("42601", "subquery has too few columns")) }
    var w = newStmt(S_SELECT)
    var names: []str = []
    var cols: []Expr = []
    for i in 0..len(xs) {
        append(mut &names, "#" + (i + 1).toStr())
        append(mut &cols, Expr.Col("#row.#" + (i + 1).toStr()))
    }
    append(mut &w.from, FromItem{table: "", alias: "#row", join: J_FIRST, on: None, sub: inner, cols: names, work: -1, lateral: false, using: [], natural: false, comma: false})
    var item = Expr.Lit(Val.Null)
    if op == "in" {
        let c = try rowCmp(&"=", row, &Expr.Call("row", cols, false))
        let rank = Expr.Call("case else", [cloneE(&c), Expr.Lit(Val.Int(2)), Expr.IsNull(c, false), Expr.Lit(Val.Int(1)), Expr.Lit(Val.Int(0))], false)
        let best = Expr.Call("max", [rank], false)
        item = Expr.Call("case else", [Expr.Bin("=", cloneE(&best), Expr.Lit(Val.Int(2))), Expr.Lit(Val.Bool(true)),
                                       Expr.Bin("=", best, Expr.Lit(Val.Int(1))), Expr.Lit(Val.Null), Expr.Lit(Val.Bool(false))], false)
    } else {
        item = try rowCmp(op, row, &Expr.Call("row", cols, false))
    }
    append(mut &w.items, SelItem{star: false, qual: "", expr: Some(item), alias: "?column?", spell: ""})
    w.subs = replace(mut &p.subs, saved)
    w.use = SUB_SCALAR
    p.depth -= 1
    append(mut &p.subs, w)
    return Ok(subRef("#sub", len(p.subs) - 1))
}

// ARRAY(subquery), after its "(": (SELECT array_agg(a) FROM (subquery) AS
// "#arr"(a)), '{}' for no rows. Also op ANY | ALL (subquery) other than = ANY
// and <> ALL (9.94).
fn (p: mut &P) arrayOfSub(): Result[Expr, lexdb_base.DbErr] {
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let inner = try p.subquery(SUB_FROM)
    var w = newStmt(S_SELECT)
    append(mut &w.from, FromItem{table: "", alias: "#arr", join: J_FIRST, on: None, sub: inner, cols: ["#a"], work: -1, lateral: false, using: [], natural: false, comma: false})
    let agg = Expr.Call("array_agg", [Expr.Col("#arr.#a")], false)
    append(mut &w.items, SelItem{star: false, qual: "", expr: Some(Expr.Call("coalesce", [agg, Expr.Lit(Val.Text("{}"))], false)), alias: "array", spell: ""})
    w.subs = replace(mut &p.subs, saved)
    w.use = SUB_SCALAR
    p.depth -= 1
    append(mut &p.subs, w)
    return Ok(subRef("#sub", len(p.subs) - 1))
}

fn (p: mut &P) primary(): Result[Expr, lexdb_base.DbErr] {
    // pg_catalog.f(...): f (9.80)
    if p.peek().kind == T_IDENT && p.peek().text == "pg_catalog" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." &&
       p.peekAt(2).kind == T_IDENT && p.peekAt(3).kind == T_OP && p.peekAt(3).text == "(" {
        p.pos += 2
    }
    let t = p.next()
    if t.kind == T_IDENT && t.text == "case" { return p.caseExpr() }
    if t.kind == T_IDENT && t.text == "substring" && p.isKw("(") && p.sqlForm() {
        // substring(x [FROM a] [FOR b]) (9.92): substring(x, a [, b]), FOR alone
        // from 1; a text a is a pattern (lexdb_exec)
        p.pos += 1
        let x = try p.expr()
        var args: []Expr = [x]
        if p.acceptKw("similar") {
            // substring(x SIMILAR pattern ESCAPE e) (9.94): as FROM pattern FOR e
            append(mut &args, try p.expr())
            try p.expectKw("escape")
            append(mut &args, try p.expr())
        } else if p.acceptKw("from") {
            append(mut &args, try p.expr())
            if p.acceptKw("for") { append(mut &args, try p.expr()) }
        } else {
            try p.expectKw("for")
            append(mut &args, Expr.Lit(Val.Int(1)))
            append(mut &args, try p.expr())
        }
        try p.expectKw(")")
        return Ok(Expr.Call("substring", args, false))
    }
    if t.kind == T_IDENT && t.text == "position" && p.isKw("(") {
        // position(a IN b): b's place of a; a is read above IN's level
        p.pos += 1
        let a = try p.catExpr()
        try p.expectKw("in")
        let b = try p.expr()
        try p.expectKw(")")
        return Ok(Expr.Call("position", [b, a], false))
    }
    if t.kind == T_IDENT && t.text == "overlay" && p.isKw("(") && p.sqlForm() {
        // overlay(x PLACING y FROM n [FOR m])
        p.pos += 1
        var args: []Expr = [try p.expr()]
        try p.expectKw("placing")
        append(mut &args, try p.expr())
        try p.expectKw("from")
        append(mut &args, try p.expr())
        if p.acceptKw("for") { append(mut &args, try p.expr()) }
        try p.expectKw(")")
        return Ok(Expr.Call("overlay", args, false))
    }
    if t.kind == T_IDENT && t.text == "trim" && p.isKw("(") {
        // trim([LEADING | TRAILING | BOTH] [chars] FROM x), or trim(x [, chars]):
        // ltrim, rtrim or btrim of x and chars (9.82)
        p.pos += 1
        var f = "btrim"
        var std = false
        if p.acceptKw("leading") { f = "ltrim"; std = true } else if p.acceptKw("trailing") { f = "rtrim"; std = true } else if p.acceptKw("both") { std = true }
        var chars: []Expr = []
        if !p.isKw("from") {
            let first = try p.expr()
            if p.acceptKw("from") {
                let x = try p.expr()
                try p.expectKw(")")
                return Ok(Expr.Call(f, [x, first], false))
            }
            if std { return Err(near(&p.peek())) }
            // trim(x [, chars])
            var args: []Expr = [first]
            while p.acceptKw(",") { append(mut &args, try p.expr()) }
            try p.expectKw(")")
            return Ok(Expr.Call("btrim", args, false))
        }
        try p.expectKw("from")
        let x = try p.expr()
        try p.expectKw(")")
        return Ok(Expr.Call(f, [x], false))
    }
    if t.kind == T_IDENT && (t.text == "current_user" || t.text == "session_user" || t.text == "user" || t.text == "current_role" ||
                             t.text == "current_schema" || t.text == "current_catalog") && !p.isKw("(") && !p.isKw(".") {
        append(mut &p.seqs, CAT_MARK)
        return Ok(Expr.Call(if t.text == "user" || t.text == "current_role" { "current_user" } else { t.text }, [], false))
    }
    if t.kind == T_IDENT && t.text == "array" && p.isKw("(") && (p.peekAt(1).text == "select" || p.peekAt(1).text == "with") {
        p.pos += 1
        return p.arrayOfSub()
    }
    if t.kind == T_IDENT && t.text == "array" && p.isKw("[") {
        // ARRAY[a, b, ...]: an array of the values
        p.pos += 1
        var xs: []Expr = []
        if !p.isKw("]") {
            append(mut &xs, try p.expr())
            while p.acceptKw(",") { append(mut &xs, try p.expr()) }
        }
        try p.expectKw("]")
        return Ok(Expr.Call("array", xs, false))
    }
    if t.kind == T_IDENT && t.text == "exists" && p.isKw("(") {
        p.pos += 1
        return Ok(subRef("#exists", try p.subquery(SUB_EXISTS)))
    }
    if t.kind == T_NUM {
        if !strings.contains(&t.text, ".") && !strings.contains(&t.text, "e") && !strings.contains(&t.text, "E") {
            match strings.parseIntOpt(t.text) {
                Some(n) { return Ok(Expr.Lit(Val.Int(n))) }
                None {}
            }
        }
        match Decimal.parse(t.text) {
            Ok(d) { return Ok(Expr.Lit(Val.Num(d))) }
            Err(_) { return Err(lexdb_base.err("22003", "numeric literal out of range: " + t.text)) }
        }
    }
    if t.kind == T_STR { return Ok(Expr.Lit(Val.Text(t.text))) }
    if t.kind == T_VAR { return p.variable(&t) }
    if t.kind == T_PARAM {
        let n = strings.parseIntOpt(t.text).unwrapOr(0)
        if n < 1 || n > 65535 { return Err(near(&t)) }
        if n > p.params { p.params = n }
        return Ok(Expr.Param(n))
    }
    if t.kind == T_OP && t.text == "(" {
        if p.isKw("select") || p.isKw("with") { return Ok(subRef("#sub", try p.subquery(SUB_SCALAR))) }
        let e = try p.expr()
        if p.isKw(",") {
            // (a, b, ...): a row (9.94), for comparisons
            var xs: []Expr = [e]
            while p.acceptKw(",") { append(mut &xs, try p.expr()) }
            try p.expectKw(")")
            return Ok(Expr.Call("row", xs, false))
        }
        try p.expectKw(")")
        return Ok(e)
    }
    if t.kind == T_IDENT {
        match t.text {
            "null" { return Ok(Expr.Lit(Val.Null)) }
            "true" { return Ok(Expr.Lit(Val.Bool(true))) }
            "false" { return Ok(Expr.Lit(Val.Bool(false))) }
            "cast" {
                try p.expectKw("(")
                let e = try p.expr()
                try p.expectKw("as")
                let ty = try p.typeName()
                try p.expectKw(")")
                return Ok(Expr.Cast(e, ty))
            }
            // the date and time keywords that are not called (9.76)
            "current_date", "current_timestamp", "localtimestamp", "current_time", "localtime" {
                if p.acceptKw("(") {
                    let n = try p.intLit()        // a precision: rounded to it
                    try p.expectKw(")")
                    return Ok(Expr.Call(t.text, [Expr.Lit(Val.Int(n))], false))
                }
                return Ok(Expr.Call(t.text, [], false))
            }
            "extract" {
                if p.isKw("(") {
                    // EXTRACT(field FROM x): date_part('field', x)
                    p.pos += 1
                    let f = p.next()
                    if f.kind != T_IDENT && f.kind != T_STR && f.kind != T_QIDENT { return Err(near(&f)) }
                    try p.expectKw("from")
                    let x = try p.expr()
                    try p.expectKw(")")
                    return Ok(Expr.Call("date_part", [Expr.Lit(Val.Text(strings.toLowerAscii(f.text))), x], false))
                }
            }
            "date", "time", "timestamp", "timestamptz", "interval" {
                // a typed literal: date '2026-11-11', timestamp(3) with time zone '...'
                let at = p.pos
                p.pos -= 1
                match p.typeName() {
                    Ok(ty) {
                        if p.peek().kind == T_STR {
                            let lit = p.next().text
                            return Ok(Expr.Cast(Expr.Lit(Val.Text(lit)), ty))
                        }
                    }
                    Err(_) {}
                }
                p.pos = at
            }
            else {}
        }
        // left( and right( are functions, as in PostgreSQL
        let fn2 = (t.text == "left" || t.text == "right") && p.isKw("(")
        if isReserved(&t.text) && !fn2 { return Err(near(&t)) }
    }
    if t.kind == T_IDENT || t.kind == T_QIDENT {
        if p.isKw("(") && t.kind == T_IDENT {
            p.pos += 1
            var args: []Expr = []
            var star = false
            var fname = t.text
            if p.acceptKw("*") {
                star = true
            } else if !p.isKw(")") {
                // agg(DISTINCT x): the name carries it, "count distinct"
                if p.acceptKw("distinct") { fname = fname + " distinct" } else { let al = p.acceptKw("all") }
                append(mut &args, try p.expr())
                while p.acceptKw(",") { append(mut &args, try p.expr()) }
                if p.acceptKw("order") {
                    // agg(x ORDER BY k [ASC | DESC] [NULLS FIRST | LAST], ...): the
                    // keys follow the arguments, the name carries their order:
                    // a ascending (NULLs last), A with NULLs first, d
                    // descending (NULLs first), D with NULLs last
                    try p.expectKw("by")
                    var dirs = ""
                    while true {
                        append(mut &args, try p.expr())
                        var desc = false
                        if p.acceptKw("desc") { desc = true } else { let asc = p.acceptKw("asc") }
                        var flip = false
                        if p.acceptKw("nulls") {
                            if p.acceptKw("first") { flip = !desc } else {
                                try p.expectKw("last")
                                flip = desc
                            }
                        }
                        dirs = dirs + (if desc { if flip { "D" } else { "d" } } else { if flip { "A" } else { "a" } })
                        if !p.acceptKw(",") { break }
                    }
                    fname = fname + " order:" + dirs
                }
            }
            try p.expectKw(")")
            if p.acceptKw("filter") {
                // agg(...) FILTER (WHERE cond): the condition is the last argument
                try p.expectKw("(")
                try p.expectKw("where")
                append(mut &args, try p.expr())
                try p.expectKw(")")
                fname = fname + " filter"
            }
            if isCatFn(&fname) { append(mut &p.seqs, CAT_MARK) }
            if fname == "current_setting" || fname == "set_config" { append(mut &p.seqs, SET_MARK) }
            if (fname == "nextval" || fname == "currval" || fname == "setval") && len(args) > 0 {
                match litText(&args[0]) {
                    Some(n) { append(mut &p.seqs, n) }
                    None {}
                }
            }
            if p.acceptKw("over") {
                // a window call (9.46): kept in the query, named here by number
                var d = try p.over()
                var copied: []Expr = []
                for a in args { append(mut &copied, cloneE(&a)) }
                d.call = Expr.Call(fname, copied, star)
                append(mut &p.wins, d)
                return Ok(Expr.Call("#win", [Expr.Lit(Val.Int(len(p.wins) - 1)), Expr.Call(fname, args, star)], false))
            }
            return Ok(Expr.Call(fname, args, star))
        }
        var name = t.text
        if p.acceptKw(".") {
            let col = try p.name()
            name = t.text + "." + col     // qualified: table (or alias) dot column
            if p.acceptKw(".") {
                // schema.table.column: the table's columns are qualified by
                // its name in FROM (lenient: the schema is not checked)
                let c3 = try p.name()
                name = col + "." + c3
            }
        }
        return Ok(Expr.Col(name))
    }
    return Err(near(&t))
}

// ---- statements

fn (p: mut &P) createTable(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_CREATE)
    if p.acceptKw("if") {
        try p.expectKw("not")
        try p.expectKw("exists")
        s.ifFlag = true
    }
    s.table = try p.rname()
    s.spell = p.spelled
    if p.isKw("as") || p.isKw("on") || (p.isKw("(") && p.nameListThenAs()) { return p.createTableAs(s) }
    try p.expectKw("(")
    while true {
        var cname = ""
        if p.acceptKw("constraint") { cname = try p.name() }
        if p.acceptKw("primary") {
            try p.expectKw("key")
            try p.expectKw("(")
            append(mut &s.pk, try p.name())
            while p.acceptKw(",") { append(mut &s.pk, try p.name()) }
            try p.expectKw(")")
        } else if len(cname) > 0 || p.isKw("unique") || p.isKw("check") || p.isKw("foreign") || p.isKw("exclude") {
            append(mut &s.cons, try p.tableConstraint(cname))
        } else {
            let n = try p.name()
            var c = noCol()
            c.name = n
            c.spell = p.spelled
            try p.colType(mut &c)
            while true {
                // CONSTRAINT name names the one after it (a UNIQUE's; the
                // others' names are not kept)
                var cn = ""
                if p.acceptKw("constraint") { cn = try p.name() }
                if p.acceptKw("not") {
                    try p.expectKw("null")
                    c.notNull = true
                } else if p.acceptKw("null") {
                } else if p.acceptKw("primary") {
                    try p.expectKw("key")
                    append(mut &s.pk, n)
                    c.notNull = true
                } else if p.acceptKw("default") {
                    c.def = Some(try p.defaultExpr())
                } else if p.acceptKw("generated") {
                    try p.identity(mut &c, mut &s)
                } else if p.acceptKw("unique") {
                    try p.uniqueTail()
                    var u = newConstraint(C_UNIQUE, cn)
                    append(mut &u.cols, n)
                    append(mut &s.cons, u)
                } else if p.acceptKw("check") {
                    var ck = try p.checkTail(cn)
                    append(mut &ck.cols, n)         // a column's: named for it
                    append(mut &s.cons, ck)
                } else if p.acceptKw("references") {
                    var fk = newConstraint(C_FOREIGN, cn)
                    append(mut &fk.cols, n)
                    try p.fkTail(mut &fk)
                    append(mut &s.cons, fk)
                } else if len(cn) > 0 {
                    return Err(near(&p.peek()))
                } else {
                    break
                }
            }
            append(mut &s.cols, c)
        }
        if !p.acceptKw(",") { break }
    }
    try p.expectKw(")")
    try p.onCommit(mut &s)
    return Ok(s)
}

// [ON COMMIT PRESERVE ROWS | DELETE ROWS | DROP] (9.96).
fn (p: mut &P) onCommit(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if !p.acceptKw("on") { return Ok(Unit{}) }
    try p.expectKw("commit")
    if p.acceptKw("drop") {
        s.onCommit = ONC_DROP
        return Ok(Unit{})
    }
    if p.acceptKw("preserve") { s.onCommit = ONC_PRESERVE } else {
        try p.expectKw("delete")
        s.onCommit = ONC_DELETE
    }
    try p.expectKw("rows")
    return Ok(Unit{})
}

// Whether ( names ) AS follows: CREATE TABLE ... AS's column names, not a
// table's definition.
fn (p: &P) nameListThenAs(): bool {
    var k = 1
    while true {
        let t = p.peekAt(k)
        if t.kind != T_IDENT && t.kind != T_QIDENT { return false }
        let u = p.peekAt(k + 1)
        if u.kind == T_OP && u.text == ")" { return p.peekAt(k + 2).kind == T_IDENT && (p.peekAt(k + 2).text == "as" || p.peekAt(k + 2).text == "on") }
        if !(u.kind == T_OP && u.text == ",") { return false }
        k += 2
    }
    return false
}

// CREATE TABLE name [(names)] AS query [WITH [NO] DATA] (9.88): the query
// in inner[0], with its own subqueries; the column names in names.
fn (p: mut &P) createTableAs(s0: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var s = s0
    if p.acceptKw("(") {
        while true {
            append(mut &s.names, try p.name())
            append(mut &s.spells, p.spelled)
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    }
    try p.onCommit(mut &s)
    try p.expectKw("as")
    var q = try p.query()
    if p.acceptKw("with") {
        s.noData = p.acceptKw("no")
        try p.expectKw("data")
    }
    append(mut &s.inner, q)
    return Ok(s)
}

// A query where a statement takes one (CREATE TABLE ... AS): SELECT,
// VALUES or WITH ... SELECT, in parentheses or not, with its own
// subqueries, window calls and parameters.
fn (p: mut &P) query(): Result[Stmt, lexdb_base.DbErr] {
    let paren = p.acceptKw("(")
    var n = 0
    if p.acceptKw("with") { n = try p.withList() }
    var q = newStmt(S_SELECT)
    if p.acceptKw("select") {
        q = try p.select()
    } else if p.acceptKw("values") {
        q = try p.valuesQuery()
        try p.orderLimit(mut &q)
    } else {
        return Err(near(&p.peek()))
    }
    if paren { try p.expectKw(")") }
    q.subs = replace(mut &p.subs, [])
    q.wins = replace(mut &p.wins, [])
    q.params = p.params
    if n > 0 { p.popCtes(n) }
    return Ok(q)
}

// A table constraint, after [CONSTRAINT name]: UNIQUE (cols), CHECK (expr)
// or FOREIGN KEY (cols) REFERENCES ....
fn (p: mut &P) tableConstraint(name: str): Result[Constraint, lexdb_base.DbErr] {
    if p.acceptKw("check") { return p.checkTail(name) }
    if p.acceptKw("foreign") {
        try p.expectKw("key")
        var c = newConstraint(C_FOREIGN, name)
        try p.expectKw("(")
        append(mut &c.cols, try p.name())
        while p.acceptKw(",") { append(mut &c.cols, try p.name()) }
        try p.expectKw(")")
        try p.expectKw("references")
        try p.fkTail(mut &c)
        return Ok(c)
    }
    if p.acceptKw("unique") {
        var c = newConstraint(C_UNIQUE, name)
        try p.uniqueTail()
        try p.expectKw("(")
        append(mut &c.cols, try p.name())
        while p.acceptKw(",") { append(mut &c.cols, try p.name()) }
        try p.expectKw(")")
        return Ok(c)
    }
    return Err(p.notYet())
}

// After UNIQUE: NULLS [NOT] DISTINCT (only the default, DISTINCT, is lexdb's).
fn (p: mut &P) uniqueTail(): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("nulls") {
        if p.acceptKw("not") { return Err(lexdb_base.err("0A000", "lexdb: UNIQUE NULLS NOT DISTINCT is not supported")) }
        try p.expectKw("distinct")
    }
    return Ok(Unit{})
}

// After CHECK: (expr) [NO INHERIT]. No subquery or parameter; NOT VALID is
// not lexdb's (rows there are always checked).
fn (p: mut &P) checkTail(name: str): Result[Constraint, lexdb_base.DbErr] {
    var c = newConstraint(C_CHECK, name)
    try p.expectKw("(")
    let subs = len(p.subs)
    let params = p.params
    c.expr = Some(try p.expr())
    if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in check constraint")) }
    if p.params > params { return Err(lexdb_base.err("42P02", "there is no parameter $" + p.params.toStr())) }
    try p.expectKw(")")
    if p.acceptKw("no") { try p.expectKw("inherit") }
    if p.isKw("not") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "valid" {
        return Err(lexdb_base.err("0A000", "lexdb: NOT VALID is not supported (the rows there are checked)"))
    }
    return Ok(c)
}

// After REFERENCES: table [(cols)], then in any order MATCH SIMPLE, ON
// DELETE action, ON UPDATE action, [NOT] DEFERRABLE, INITIALLY IMMEDIATE |
// DEFERRED (9.85). MATCH FULL and PARTIAL are not lexdb's.
fn (p: mut &P) fkTail(c: mut &Constraint): Result[Unit, lexdb_base.DbErr] {
    var notDeferrable = false
    c.refTable = try p.qname()
    if p.acceptKw("(") {
        append(mut &c.refCols, try p.name())
        while p.acceptKw(",") { append(mut &c.refCols, try p.name()) }
        try p.expectKw(")")
    }
    while true {
        if p.acceptKw("match") {
            if p.isKw("full") || p.isKw("partial") {
                return Err(lexdb_base.err("0A000", "lexdb: MATCH FULL and MATCH PARTIAL are not supported (MATCH SIMPLE is)"))
            }
            try p.expectKw("simple")
        } else if p.isKw("on") && p.pos + 1 < len(p.toks) && (p.toks[p.pos + 1].text == "delete" || p.toks[p.pos + 1].text == "update") {
            p.pos += 1
            let del = p.acceptKw("delete")
            if !del { try p.expectKw("update") }
            let act = try p.fkAction()
            if del { c.onDelete = act } else { c.onUpdate = act }
        } else if p.acceptKw("deferrable") {
            c.deferrable = true
        } else if p.isKw("not") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].text == "deferrable" {
            p.pos += 2
            c.deferrable = false
            notDeferrable = true
        } else if p.acceptKw("initially") {
            if p.acceptKw("deferred") { c.deferred = true } else { try p.expectKw("immediate") }
        } else {
            break
        }
    }
    if c.deferred {
        if notDeferrable { return Err(lexdb_base.err("42601", "constraint declared INITIALLY DEFERRED must be DEFERRABLE")) }
        c.deferrable = true
    }
    return Ok(Unit{})
}

fn (p: mut &P) fkAction(): Result[int, lexdb_base.DbErr] {
    if p.acceptKw("no") {
        try p.expectKw("action")
        return Ok(FK_NO_ACTION)
    }
    if p.acceptKw("restrict") { return Ok(FK_RESTRICT) }
    if p.acceptKw("cascade") { return Ok(FK_CASCADE) }
    try p.expectKw("set")
    var act = FK_SET_NULL
    if !p.acceptKw("null") {
        try p.expectKw("default")
        act = FK_SET_DEFAULT
    }
    if p.isKw("(") { return Err(lexdb_base.err("0A000", "lexdb: SET NULL and SET DEFAULT of some columns are not supported")) }
    return Ok(act)
}

fn (p: &P) notYet(): lexdb_base.DbErr {
    if p.isKw("exclude") { return lexdb_base.err("0A000", "lexdb: EXCLUDE constraints are not supported") }
    return near(&p.peek())
}

// A text literal, or one cast ('s'::regclass): its text.
pub fn litText(x: &Expr): Option[str] {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Text(t) { return Some(t) }
                else { return None }
            }
        }
        Expr.Cast(a, _) { return litText(&a) }
        else { return None }
    }
}

// A column's type: serial, bigserial and smallserial are integers taking
// their defaults from a sequence of their own.
fn (p: mut &P) colType(c: mut &ColDef): Result[Unit, lexdb_base.DbErr] {
    let w = p.peek()
    if w.kind == T_IDENT {
        var oid = 0
        if w.text == "serial" || w.text == "serial4" { oid = OID_INT4 }
        if w.text == "bigserial" || w.text == "serial8" { oid = OID_INT8 }
        if w.text == "smallserial" || w.text == "serial2" { oid = OID_INT2 }
        if oid != 0 {
            p.pos += 1
            c.typ = TypeName{kind: K_INT, oid: oid, prec: 0, scale: 0, len: 0}
            c.identity = ID_SERIAL
            c.notNull = true
            return Ok(Unit{})
        }
    }
    c.typ = try p.typeName()
    // its collation (L2): COLLATE name; in T-SQL a text column's is SQL
    // Server's default, case-insensitive
    if p.acceptKw("collate") { c.coll = try p.collName() }
    else if p.tsql && c.typ.kind == K_TEXT { c.coll = TSQL_COLLATION }
    return Ok(Unit{})
}

// SQL Server's default collation: a T-SQL text column's, and a TDS
// session's (design/lexdb-tds.md L2).
pub const TSQL_COLLATION: str = "SQL_Latin1_General_CP1_CI_AS"

// How a collation compares (L2): COLL_CI, SQL Server's *_CI_* (case
// folded, trailing spaces ignored); COLL_PAD, SQL Server's other ones
// (*_CS_*, *_BIN*: trailing spaces ignored, as SQL Server ignores them
// under every collation); COLL_EXACT, "" and every other name (bytes).
pub const COLL_EXACT = 0
pub const COLL_PAD = 1
pub const COLL_CI = 2

pub fn collKind(name: &str): int {
    let l = strings.toLowerAscii(name)
    if strings.contains(&l, "_ci_") { return COLL_CI }
    if strings.contains(&l, "_cs_") || strings.contains(&l, "_bin") { return COLL_PAD }
    return COLL_EXACT
}

// A collation's name after COLLATE, as written: name or schema.name.
fn (p: mut &P) collName(): Result[str, lexdb_base.DbErr] {
    var n = try p.name()
    var sp = if len(p.spelled) > 0 { p.spelled } else { n }
    if p.acceptKw(".") {
        n = try p.name()
        sp = if len(p.spelled) > 0 { p.spelled } else { n }
    }
    return Ok(sp)
}

// After GENERATED: {ALWAYS | BY DEFAULT} AS IDENTITY [(options)].
fn (p: mut &P) identity(c: mut &ColDef, s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("always") {
        c.identity = ID_ALWAYS
    } else {
        try p.expectKw("by")
        try p.expectKw("default")
        c.identity = ID_BY_DEFAULT
    }
    try p.expectKw("as")
    if p.isKw("(") { return Err(lexdb_base.err("0A000", "lexdb: generated columns are not supported")) }
    try p.expectKw("identity")
    c.notNull = true
    if p.acceptKw("(") {
        var o = noSeqOpts()
        try p.seqOptions(mut &o, false)
        try p.expectKw(")")
        append(mut &s.idOpts, IdOpts{col: c.name, opts: o})
    }
    return Ok(Unit{})
}

// Sequence options, in any order, until none follows.
fn (p: mut &P) seqOptions(o: mut &SeqOpts, alter: bool): Result[Unit, lexdb_base.DbErr] {
    while true {
        if p.acceptKw("as") {
            let t = try p.typeName()
            if t.kind != K_INT { return Err(lexdb_base.err("22023", "sequence type must be smallint, integer, or bigint")) }
            o.typ = t.oid
        } else if p.acceptKw("increment") {
            let by = p.acceptKw("by")
            o.inc = try p.signedInt()
            o.hasInc = true
        } else if p.acceptKw("minvalue") {
            o.min = try p.signedInt()
            o.hasMin = 1
        } else if p.acceptKw("maxvalue") {
            o.max = try p.signedInt()
            o.hasMax = 1
        } else if p.isKw("no") && p.pos + 1 < len(p.toks) && (p.toks[p.pos + 1].text == "minvalue" || p.toks[p.pos + 1].text == "maxvalue" || p.toks[p.pos + 1].text == "cycle") {
            p.pos += 1
            if p.acceptKw("minvalue") {
                o.hasMin = 2
            } else if p.acceptKw("maxvalue") {
                o.hasMax = 2
            } else {
                try p.expectKw("cycle")
                o.cycle = 2
            }
        } else if p.acceptKw("start") {
            let w = p.acceptKw("with")
            o.start = try p.signedInt()
            o.hasStart = true
        } else if alter && p.acceptKw("restart") {
            o.restart = 1
            let w = p.acceptKw("with")
            if w || p.peek().kind == T_NUM || p.isKw("-") {
                o.restart = 2
                o.restartWith = try p.signedInt()
            }
        } else if p.acceptKw("cache") {
            o.cache = try p.signedInt()
            if o.cache < 1 { return Err(lexdb_base.err("22023", "CACHE (" + o.cache.toStr() + ") must be greater than zero")) }
        } else if p.acceptKw("cycle") {
            o.cycle = 1
        } else if p.acceptKw("owned") {
            try p.expectKw("by")
            if p.acceptKw("none") {
                o.owned = ["", ""]
            } else {
                // table.column, schema.table.column
                var ns = [try p.name()]
                while p.acceptKw(".") { append(mut &ns, try p.name()) }
                if len(ns) < 2 || len(ns) > 3 { return Err(lexdb_base.err("42601", "invalid OWNED BY option (table.column or OWNED BY NONE)")) }
                let col = pop(mut &ns)
                var tn = ns[0]
                if len(ns) == 2 { tn = qual(&ns[0], &ns[1]) }
                o.owned = [tn, col]
            }
        } else {
            break
        }
    }
    return Ok(Unit{})
}

// An integer literal, perhaps negative.
fn (p: mut &P) signedInt(): Result[int, lexdb_base.DbErr] {
    let neg = p.acceptKw("-")
    let n = try p.intLit()
    return Ok(if neg { -n } else { n })
}

// CREATE SEQUENCE, after SEQUENCE; ALTER SEQUENCE, after SEQUENCE.
fn (p: mut &P) seqStmt(kind: int): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(kind)
    if p.acceptKw("if") {
        if kind == S_CREATE_SEQ { try p.expectKw("not") }
        try p.expectKw("exists")
        s.ifFlag = true
    }
    s.table = try p.rname()
    if kind == S_ALTER_SEQ && (p.isKw("rename") || p.isKw("set") || p.isKw("owner")) {
        return Err(lexdb_base.err("0A000", "lexdb: ALTER SEQUENCE takes its options (RESTART, INCREMENT, ...), not RENAME, SET or OWNER"))
    }
    try p.seqOptions(mut &s.seq, kind == S_ALTER_SEQ)
    return Ok(s)
}

fn noCol(): ColDef { return colDef("", TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}, false) }

// A DEFAULT's expression: no subquery, no parameter (column references and
// aggregates are refused where the table is known).
fn (p: mut &P) defaultExpr(): Result[Expr, lexdb_base.DbErr] {
    let subs = len(p.subs)
    let params = p.params
    let x = try p.catExpr()      // no NOT, AND or IS at the top: "DEFAULT 1 NOT NULL" 
    if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in DEFAULT expression")) }
    if p.params > params { return Err(lexdb_base.err("42P02", "there is no parameter $" + p.params.toStr())) }
    return Ok(x)
}

// A value, or DEFAULT (INSERT's VALUES, UPDATE's SET).
fn (p: mut &P) valueOrDefault(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("default") { return Ok(Expr.Call(DEFAULT_MARK, [], false)) }
    return p.expr()
}

// ALTER TABLE [IF EXISTS] [ONLY] name, then RENAME [COLUMN] a TO b,
// RENAME TO name or SET SCHEMA name (each alone), or actions separated by commas: ADD
// [COLUMN] [IF NOT EXISTS] name type [NOT NULL | NULL], DROP [COLUMN] [IF
// EXISTS] name [RESTRICT | CASCADE], ALTER [COLUMN] name [SET DATA] TYPE
// type [USING expr], ALTER [COLUMN] name SET NOT NULL or DROP NOT NULL.
fn (p: mut &P) alterTable(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_ALTER)
    if p.acceptKw("if") {
        try p.expectKw("exists")
        s.ifFlag = true
    }
    let only = p.acceptKw("only")
    s.table = try p.rname()
    if p.isKw("set") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "schema" {
        p.pos += 2
        append(mut &s.alters, Alter{kind: A_SET_SCHEMA, col: noCol(), name: try p.name(), to: "", ifFlag: false, using: None, cons: [], cascade: false})
        return Ok(s)
    }
    if p.acceptKw("rename") {
        // the new name's spelling in col.spell (L6)
        var sp = noCol()
        if p.acceptKw("to") {
            let to = try p.name()
            sp.spell = p.spelled
            append(mut &s.alters, Alter{kind: A_RENAME, col: sp, name: to, to: "", ifFlag: false, using: None, cons: [], cascade: false})
            return Ok(s)
        }
        let c = p.acceptKw("column")
        let from = try p.name()
        try p.expectKw("to")
        let to = try p.name()
        sp.spell = p.spelled
        append(mut &s.alters, Alter{kind: A_RENAME_COL, col: sp, name: from, to: to, ifFlag: false, using: None, cons: [], cascade: false})
        return Ok(s)
    }
    while true {
        if p.acceptKw("add") {
            if p.isKw("primary") {
                return Err(lexdb_base.err("0A000", "lexdb: a table's primary key cannot be changed"))
            }
            if p.isKw("constraint") || p.isKw("unique") || p.isKw("check") || p.isKw("foreign") || p.isKw("exclude") {
                var cname = ""
                if p.acceptKw("constraint") { cname = try p.name() }
                if p.isKw("primary") { return Err(lexdb_base.err("0A000", "lexdb: a table's primary key cannot be changed")) }
                var a = Alter{kind: A_ADD_CON, col: noCol(), name: "", to: "", ifFlag: false, using: None, cons: [], cascade: false}
                append(mut &a.cons, try p.tableConstraint(cname))
                append(mut &s.alters, a)
                if !p.acceptKw(",") { break }
                continue
            }
            let c = p.acceptKw("column")
            var a = Alter{kind: A_ADD, col: noCol(), name: "", to: "", ifFlag: false, using: None, cons: [], cascade: false}
            if p.acceptKw("if") {
                try p.expectKw("not")
                try p.expectKw("exists")
                a.ifFlag = true
            }
            a.col.name = try p.name()
            a.col.spell = p.spelled
            try p.colType(mut &a.col)
            // its UNIQUE, CHECK and REFERENCES: added after it, as ADD
            // CONSTRAINT would (9.85)
            var cons: []Constraint = []
            while true {
                var cn = ""
                if p.acceptKw("constraint") { cn = try p.name() }
                if p.acceptKw("not") {
                    try p.expectKw("null")
                    a.col.notNull = true
                } else if p.acceptKw("null") {
                } else if p.acceptKw("generated") {
                    try p.identity(mut &a.col, mut &s)
                } else if p.isKw("primary") {
                    return Err(lexdb_base.err("0A000", "lexdb: a table's primary key cannot be changed"))
                } else if p.acceptKw("default") {
                    a.col.def = Some(try p.defaultExpr())
                } else if p.acceptKw("unique") {
                    try p.uniqueTail()
                    var u = newConstraint(C_UNIQUE, cn)
                    append(mut &u.cols, a.col.name)
                    append(mut &cons, u)
                } else if p.acceptKw("check") {
                    var ck = try p.checkTail(cn)
                    append(mut &ck.cols, a.col.name)
                    append(mut &cons, ck)
                } else if p.acceptKw("references") {
                    var fk = newConstraint(C_FOREIGN, cn)
                    append(mut &fk.cols, a.col.name)
                    try p.fkTail(mut &fk)
                    append(mut &cons, fk)
                } else if len(cn) > 0 {
                    return Err(near(&p.peek()))
                } else {
                    break
                }
            }
            let added = a.col.name
            let ifNot = a.ifFlag
            append(mut &s.alters, a)
            // in the order written
            var k = 0
            while k < len(cons) / 2 {
                swap(mut &cons, k, len(cons) - 1 - k)
                k += 1
            }
            while len(cons) > 0 {
                var ac = Alter{kind: A_ADD_CON, col: noCol(), name: "", to: "", ifFlag: false, using: None, cons: [], cascade: false}
                // ADD COLUMN IF NOT EXISTS of a column there: its constraints not added either
                if ifNot { ac.name = added }
                append(mut &ac.cons, pop(mut &cons))
                append(mut &s.alters, ac)
            }
        } else if p.acceptKw("drop") {
            if p.acceptKw("constraint") {
                var a = Alter{kind: A_DROP_CON, col: noCol(), name: "", to: "", ifFlag: false, using: None, cons: [], cascade: false}
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    a.ifFlag = true
                }
                a.name = try p.name()
                if p.acceptKw("cascade") { a.cascade = true } else { let r = p.acceptKw("restrict") }
                append(mut &s.alters, a)
                if !p.acceptKw(",") { break }
                continue
            }
            let c = p.acceptKw("column")
            var a = Alter{kind: A_DROP_COL, col: noCol(), name: "", to: "", ifFlag: false, using: None, cons: [], cascade: false}
            if p.acceptKw("if") {
                try p.expectKw("exists")
                a.ifFlag = true
            }
            a.name = try p.name()
            if p.acceptKw("cascade") { a.cascade = true } else { let r = p.acceptKw("restrict") }
            append(mut &s.alters, a)
        } else if p.acceptKw("alter") {
            let c = p.acceptKw("column")
            let n = try p.name()
            let data = p.isKw("set") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "data"
            if data {
                p.pos += 2
                try p.expectKw("type")
            }
            if data || p.acceptKw("type") {
                var a = Alter{kind: A_TYPE, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false}
                a.col.typ = try p.typeName()
                if p.acceptKw("using") {
                    let subs = len(p.subs)
                    let params = p.params
                    a.using = Some(try p.expr())
                    if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in transform expression")) }
                    if p.params > params { return Err(lexdb_base.err("42P02", "there is no parameter $" + p.params.toStr())) }
                }
                append(mut &s.alters, a)
            } else if p.acceptKw("set") {
                if p.acceptKw("default") {
                    var a = Alter{kind: A_SET_DEFAULT, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false}
                    a.col.def = Some(try p.defaultExpr())
                    append(mut &s.alters, a)
                    if !p.acceptKw(",") { break }
                    continue
                }
                try p.expectKw("not")
                try p.expectKw("null")
                append(mut &s.alters, Alter{kind: A_SET_NOT_NULL, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false})
            } else if p.acceptKw("drop") {
                if p.acceptKw("default") {
                    append(mut &s.alters, Alter{kind: A_DROP_DEFAULT, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false})
                    if !p.acceptKw(",") { break }
                    continue
                }
                try p.expectKw("not")
                try p.expectKw("null")
                append(mut &s.alters, Alter{kind: A_DROP_NOT_NULL, col: noCol(), name: n, to: "", ifFlag: false, using: None, cons: [], cascade: false})
            } else {
                return Err(lexdb_base.err("0A000", "lexdb: ALTER COLUMN takes TYPE, SET or DROP NOT NULL, SET or DROP DEFAULT"))
            }
        } else {
            return Err(lexdb_base.err("0A000", "lexdb: ALTER TABLE takes ADD COLUMN, DROP COLUMN, RENAME, and ALTER COLUMN ... SET or DROP NOT NULL"))
        }
        if !p.acceptKw(",") { break }
    }
    return Ok(s)
}

// "(" then SELECT: a query in parentheses, not a column list.
fn (p: &P) selectNext(): bool {
    return p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "select"
}

fn (p: mut &P) insert(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("into")
    var s = newStmt(S_INSERT)
    s.table = try p.rname()
    if p.acceptKw("as") { s.alias = try p.name() }
    if p.isKw("(") && !p.selectNext() {
        p.pos += 1
        append(mut &s.names, try p.name())
        while p.acceptKw(",") { append(mut &s.names, try p.name()) }
        try p.expectKw(")")
    }
    if p.acceptKw("overriding") {
        if p.acceptKw("system") { s.overriding = OVR_SYSTEM } else {
            try p.expectKw("user")
            s.overriding = OVR_USER
        }
        try p.expectKw("value")
    }
    // INSERT ... SELECT: the query in inner[0], with its own subqueries
    let paren = p.isKw("(") && p.selectNext()
    if paren || p.isKw("select") {
        if paren { p.pos += 1 }
        try p.expectKw("select")
        var q = try p.select()
        if paren { try p.expectKw(")") }
        q.subs = replace(mut &p.subs, [])
        q.wins = replace(mut &p.wins, [])
        q.params = p.params
        append(mut &s.inner, q)
        try p.onConflict(mut &s)
        try p.returning(mut &s)
        return Ok(s)
    }
    if p.acceptKw("default") {
        // DEFAULT VALUES: one row, every column its default
        try p.expectKw("values")
        append(mut &s.rows, [])
        try p.onConflict(mut &s)
        try p.returning(mut &s)
        return Ok(s)
    }
    try p.expectKw("values")
    while true {
        try p.expectKw("(")
        var row: []Expr = []
        append(mut &row, try p.valueOrDefault())
        while p.acceptKw(",") { append(mut &row, try p.valueOrDefault()) }
        try p.expectKw(")")
        append(mut &s.rows, row)
        if !p.acceptKw(",") { break }
    }
    try p.onConflict(mut &s)
    try p.returning(mut &s)
    return Ok(s)
}

// ON CONFLICT [(col, ...) [WHERE pred] | ON CONSTRAINT name]
//   DO NOTHING | DO UPDATE SET col = expr, ... [WHERE cond]  (9.77)
// A target's WHERE (a partial unique index's predicate) is read and not
// kept: the index is chosen by its columns.
fn (p: mut &P) onConflict(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if !p.isKw("on") { return Ok(Unit{}) }
    p.pos += 1
    try p.expectKw("conflict")
    if p.acceptKw("(") {
        append(mut &s.conflictCols, try p.name())
        while p.acceptKw(",") { append(mut &s.conflictCols, try p.name()) }
        try p.expectKw(")")
        if p.acceptKw("where") { let pred = try p.expr() }
    } else if p.acceptKw("on") {
        try p.expectKw("constraint")
        s.conflictCon = try p.name()
    }
    try p.expectKw("do")
    if p.acceptKw("nothing") {
        s.conflict = CONFLICT_NOTHING
        return Ok(Unit{})
    }
    try p.expectKw("update")
    try p.expectKw("set")
    s.conflict = CONFLICT_UPDATE
    try p.setList(s)
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    return Ok(Unit{})
}

// SET's list (UPDATE's, ON CONFLICT DO UPDATE's): col = value, or (a, b) =
// (x, y); a value may be DEFAULT.
fn (p: mut &P) setList(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    while true {
        if p.acceptKw("(") {
            var cols: []str = [try p.name()]
            while p.acceptKw(",") { append(mut &cols, try p.name()) }
            try p.expectKw(")")
            try p.expectKw("=")
            try p.expectKw("(")
            for i in 0..len(cols) {
                if i > 0 { try p.expectKw(",") }
                append(mut &s.sets, SetItem{col: cols[i], expr: try p.valueOrDefault()})
            }
            try p.expectKw(")")
        } else {
            let c = try p.name()
            try p.expectKw("=")
            append(mut &s.sets, SetItem{col: c, expr: try p.valueOrDefault()})
        }
        if !p.acceptKw(",") { break }
    }
    return Ok(Unit{})
}

// SELECT, after its keyword: a query, or queries joined by UNION,
// INTERSECT (first) and EXCEPT; then ORDER BY, LIMIT and OFFSET, of the
// whole. The queries joined each keep their subqueries.
fn (p: mut &P) select(): Result[Stmt, lexdb_base.DbErr] {
    var first = try p.selectCore()
    if !p.isKw("union") && !p.isKw("intersect") && !p.isKw("except") {
        try p.orderLimit(mut &first)
        return Ok(first)
    }
    first.subs = replace(mut &p.subs, [])
    first.wins = replace(mut &p.wins, [])
    var lhs = try p.intersects(first)
    while p.isKw("union") || p.isKw("except") {
        var op = SET_EXCEPT
        if p.acceptKw("union") { op = SET_UNION } else { let x = p.acceptKw("except") }
        let all = p.setAll()
        let rhs = try p.intersects(try p.setBranch())
        lhs = setOf(op, all, lhs, rhs)
    }
    try p.orderLimit(mut &lhs)
    return Ok(lhs)
}

fn (p: mut &P) setAll(): bool {
    if p.acceptKw("all") { return true }
    let d = p.acceptKw("distinct")
    return false
}

fn setOf(op: int, all: bool, l: Stmt, r: Stmt): Stmt {
    var s = newStmt(S_SELECT)
    s.setop = op
    s.setAll = all
    append(mut &s.inner, l)
    append(mut &s.inner, r)
    return s
}

fn (p: mut &P) intersects(first: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var lhs = first
    while p.acceptKw("intersect") {
        let all = p.setAll()
        let rhs = try p.setBranch()
        lhs = setOf(SET_INTERSECT, all, lhs, rhs)
    }
    return Ok(lhs)
}

// A role as GRANT and the like name it: a name, PUBLIC (""), CURRENT_USER
// and the like (as "#current_user", resolved when run).
fn (p: mut &P) roleSpec(): Result[str, lexdb_base.DbErr] {
    let t = p.peek()
    if t.kind == T_IDENT && t.text == "public" {
        p.pos += 1
        return Ok("")
    }
    if t.kind == T_IDENT && (t.text == "current_user" || t.text == "session_user" || t.text == "current_role") {
        p.pos += 1
        return Ok("#" + (if t.text == "session_user" { "session_user" } else { "current_user" }))
    }
    if t.kind == T_IDENT && t.text == "user" {
        p.pos += 1
        return Ok("#current_user")
    }
    return p.name()
}

// GRANT privileges ON object TO roles, REVOKE [GRANT OPTION FOR]
// privileges ON object FROM roles [CASCADE | RESTRICT]; GRANT role, ... TO
// role, ..., REVOKE role, ... FROM role, ... (9.83).
fn (p: mut &P) grantStmt(grant: bool): Result[Stmt, lexdb_base.DbErr] {
    var g = newStmt(if grant { S_GRANT } else { S_REVOKE })
    if !grant && p.isKw("grant") && p.peekAt(1).text == "option" {
        return Err(lexdb_base.err("0A000", "lexdb: grant options are not supported"))
    }
    // privileges, or roles: names until ON (privileges) or TO / FROM (roles)
    if p.acceptKw("all") {
        let pr = p.acceptKw("privileges")
        append(mut &g.names, "all")
    } else {
        while true {
            let w = p.next()
            if w.kind != T_IDENT && w.kind != T_QIDENT { return Err(near(&w)) }
            append(mut &g.names, w.text)
            if p.isKw("(") { return Err(lexdb_base.err("0A000", "lexdb: column privileges are not supported")) }
            if !p.acceptKw(",") { break }
        }
    }
    if p.acceptKw("on") {
        if p.acceptKw("all") {
            let w = p.next().text
            if w != "tables" && w != "sequences" { return Err(lexdb_base.err("0A000", "lexdb: GRANT ON ALL " + strings.toUpperAscii(w) + " is not supported")) }
            try p.expectKw("in")
            try p.expectKw("schema")
            g.index = "all " + w
        } else if p.acceptKw("sequence") {
            g.index = "sequence"
        } else if p.acceptKw("schema") {
            g.index = "schema"
        } else if p.acceptKw("database") {
            g.index = "database"
        } else if p.isKw("function") || p.isKw("procedure") || p.isKw("routine") || p.isKw("type") || p.isKw("domain") ||
                  p.isKw("language") || p.isKw("tablespace") || p.isKw("foreign") || p.isKw("large") {
            return Err(lexdb_base.err("0A000", "lexdb: privileges on " + p.peek().text + " are not supported"))
        } else {
            let tb = p.acceptKw("table")
            g.index = "table"
        }
        while true {
            let nm = if g.index == "table" || g.index == "sequence" { try p.qname() } else { try p.name() }
            append(mut &g.cols, colDef(nm, TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
            if !p.acceptKw(",") { break }
        }
    } else {
        // GRANT role, ... TO ...: the roles were read as names
        g.index = "role"
        let granted = replace(mut &g.names, [])
        for r in granted { append(mut &g.cols, colDef(r, TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false)) }
    }
    if grant { try p.expectKw("to") } else { try p.expectKw("from") }
    while true {
        let a = p.acceptKw("group")
        append(mut &g.pk, try p.roleSpec())
        if !p.acceptKw(",") { break }
    }
    if p.acceptKw("with") {
        let w = p.next().text
        if w == "grant" || w == "admin" { return Err(lexdb_base.err("0A000", "lexdb: grant and admin options are not supported")) }
        if w == "inherit" || w == "set" { return Err(lexdb_base.err("0A000", "lexdb: membership options are not supported")) }
        return Err(near(&p.toks[p.pos - 1]))
    }
    if p.acceptKw("granted") {
        try p.expectKw("by")
        let by = try p.roleSpec()
    }
    if p.acceptKw("cascade") { g.cascade = true } else { let r = p.acceptKw("restrict") }
    return Ok(g)
}

// CREATE [OR REPLACE] VIEW name [(column, ...)] AS query, after "view":
// the query is parsed to check it, and kept as its text (from its first
// token to the statement's end), to be parsed again where it is used (9.82).
fn (p: mut &P) createView(orReplace: bool): Result[Stmt, lexdb_base.DbErr] {
    var v = newStmt(S_CREATE_VIEW)
    v.ifFlag = orReplace
    v.table = try p.rname()
    v.spell = p.spelled
    if p.acceptKw("(") {
        while true {
            append(mut &v.names, try p.name())
            append(mut &v.spells, p.spelled)
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    }
    if p.isKw("with") { return Err(lexdb_base.err("0A000", "lexdb: view options (WITH (...)) are not supported")) }
    try p.expectKw("as")
    let start = p.peek().at
    let t = p.next()
    var q = newStmt(S_SELECT)
    if t.kind == T_IDENT && t.text == "select" {
        q = try p.select()
    } else if t.kind == T_IDENT && t.text == "values" {
        q = try p.valuesQuery()
        try p.orderLimit(mut &q)
    } else if t.kind == T_IDENT && t.text == "with" {
        let n = try p.withList()
        try p.expectKw("select")
        q = try p.select()
        p.popCtes(n)
    } else {
        return Err(near(&t))
    }
    let end = p.peek().at
    if p.isKw("with") { return Err(lexdb_base.err("0A000", "lexdb: WITH CHECK OPTION is not supported")) }
    v.index = strings.trim(&p.src[start..end]).toStr()
    // the query's subqueries were parsed into the statement's: dropped (the
    // text is parsed again where the view is used)
    p.subs = []
    p.wins = []
    if q.params > 0 || p.params > 0 { return Err(lexdb_base.err("42P02", "there is no parameter $1")) }
    return Ok(v)
}

// A role's options, after its name: [WITH] LOGIN, NOLOGIN, SUPERUSER,
// NOSUPERUSER, [ENCRYPTED] PASSWORD 'text' | NULL into s.names ("login",
// "nologin", "superuser", "nosuperuser", "password:" and the text,
// "password-null"); the rest PostgreSQL has are read and not kept.
fn (p: mut &P) roleOptions(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    let w = p.acceptKw("with")
    while p.peek().kind == T_IDENT {
        let o = p.next().text
        match o {
            "login", "nologin", "superuser", "nosuperuser" { append(mut &s.names, o) }
            "encrypted", "password" {
                if o == "encrypted" { try p.expectKw("password") }
                if p.acceptKw("null") {
                    append(mut &s.names, "password-null")
                } else {
                    let t = p.next()
                    if t.kind != T_STR { return Err(near(&t)) }
                    append(mut &s.names, "password:" + t.text)
                }
            }
            "createdb", "nocreatedb", "createrole", "nocreaterole", "inherit", "noinherit", "replication", "noreplication",
            "bypassrls", "nobypassrls" {}
            "connection" {
                try p.expectKw("limit")
                if p.acceptKw("-") {}
                let n = try p.intLit()
            }
            "valid" {
                try p.expectKw("until")
                let t = p.next()
                if t.kind != T_STR { return Err(near(&t)) }
            }
            "sysid" { let n = try p.intLit() }
            "in", "role", "admin", "user" {
                if o == "in" { if !p.acceptKw("role") { try p.expectKw("group") } }
                let n = try p.name()
                while p.acceptKw(",") { let m = try p.name() }
            }
            else { return Err(lexdb_base.err("42601", "unrecognized role option \"" + o + "\"")) }
        }
    }
    return Ok(Unit{})
}

// VALUES (a, b), (c, d), ... after "values": a function in FROM
// ("#values:" and its width) whose arguments are the rows' values, row by
// row; its number in p.subs (9.80).
fn (p: mut &P) valuesSub(): Result[int, lexdb_base.DbErr] {
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var s = newStmt(S_SELECT)
    s.use = SUB_FROM
    var k = -1
    while true {
        try p.expectKw("(")
        var n = 0
        while true {
            append(mut &s.items, SelItem{star: false, qual: "", expr: Some(try p.expr()), alias: "", spell: ""})
            n += 1
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
        if k < 0 { k = n } else if k != n { return Err(lexdb_base.err("42601", "VALUES lists must all be the same length")) }
        if !p.acceptKw(",") { break }
    }
    s.srf = "#values:" + k.toStr()
    s.subs = replace(mut &p.subs, saved)
    s.wins = replace(mut &p.wins, savedW)
    p.depth -= 1
    append(mut &p.subs, s)
    return Ok(len(p.subs) - 1)
}

// VALUES ... as a query: SELECT * FROM (VALUES ...) AS "*VALUES*".
fn (p: mut &P) valuesQuery(): Result[Stmt, lexdb_base.DbErr] {
    let i = try p.valuesSub()
    var s = newStmt(S_SELECT)
    append(mut &s.items, SelItem{star: true, qual: "", expr: None, alias: "", spell: ""})
    append(mut &s.from, FromItem{table: "", alias: "*VALUES*", join: J_FIRST, on: None, sub: i, cols: [], work: -1, lateral: false, using: [], natural: false, comma: false})
    return Ok(s)
}

// One query of a UNION (and the like): SELECT ..., VALUES ..., or one in
// parentheses with its own ORDER BY and LIMIT.
fn (p: mut &P) setBranch(): Result[Stmt, lexdb_base.DbErr] {
    var b = newStmt(S_SELECT)
    if p.acceptKw("values") {
        b = try p.valuesQuery()
    } else if p.acceptKw("(") {
        try p.expectKw("select")
        b = try p.select()
        try p.expectKw(")")
    } else {
        try p.expectKw("select")
        b = try p.selectCore()
    }
    b.subs = replace(mut &p.subs, [])
    b.wins = replace(mut &p.wins, [])
    return Ok(b)
}

fn isColExpr(x: &Expr): bool {
    match x {
        Expr.Col(n) { return true }
        else { return false }
    }
}

// A SELECT's output list, or RETURNING's: *, t.*, expr [[AS] alias], ...
fn (p: mut &P) itemList(items: mut &[]SelItem): Result[Unit, lexdb_base.DbErr] {
    var none: []str = []
    return p.itemListAssign(items, mut &none)
}

// itemList with T-SQL's SELECT @v = expr: assign gets each item's variable
// ("" none) once there is one, else stays [].
fn (p: mut &P) itemListAssign(items: mut &[]SelItem, assign: mut &[]str): Result[Unit, lexdb_base.DbErr] {
    while true {
        let q = p.peek()
        if p.acceptKw("*") {
            append(items, SelItem{star: true, qual: "", expr: None, alias: "", spell: ""})
        } else if (q.kind == T_IDENT || q.kind == T_QIDENT) && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." &&
                  p.peekAt(2).kind == T_OP && p.peekAt(2).text == "*" {
            p.pos += 3
            append(items, SelItem{star: true, qual: q.text, expr: None, alias: "", spell: ""})
        } else if p.tsql && q.kind == T_VAR && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "=" {
            // T-SQL: SELECT @v = expr (design/lexdb-tds.md)
            let target = try p.variable(&q)
            p.pos += 2
            let e = try p.expr()
            while len(assign) < len(items) { append(assign, "") }
            append(assign, q.text)
            append(items, SelItem{star: false, qual: "", expr: Some(e), alias: q.text, spell: ""})
        } else {
            let e = try p.expr()
            // the column's name as written (L6): a bare column's, or the alias's
            var spell = ""
            if isColExpr(&e) && p.pos > 0 { spell = p.toks[p.pos - 1].spell }
            var alias = ""
            if p.acceptKw("as") {
                alias = try p.name()
                spell = p.spelled
            } else {
                let t = p.peek()
                if t.kind == T_QIDENT || (t.kind == T_IDENT && !isReserved(&t.text)) {
                    alias = t.text
                    spell = t.spell
                    p.pos += 1
                }
            }
            append(items, SelItem{star: false, qual: "", expr: Some(e), alias: alias, spell: spell})
        }
        if !p.acceptKw(",") { break }
    }
    return Ok(Unit{})
}

// RETURNING items, after INSERT, UPDATE or DELETE (9.44).
fn (p: mut &P) returning(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("returning") { try p.itemList(mut &s.items) }
    return Ok(Unit{})
}

// A query: the select list to HAVING.
fn (p: mut &P) selectCore(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_SELECT)
    if p.acceptKw("distinct") {
        if p.acceptKw("on") {
            // DISTINCT ON (exprs) (9.94)
            try p.expectKw("(")
            append(mut &s.distinctOn, try p.expr())
            while p.acceptKw(",") { append(mut &s.distinctOn, try p.expr()) }
            try p.expectKw(")")
        } else {
            s.distinct = true
        }
    } else {
        let all = p.acceptKw("all")
    }
    try p.itemListAssign(mut &s.items, mut &s.assign)
    if len(s.assign) > 0 {
        while len(s.assign) < len(s.items) { append(mut &s.assign, "") }
        for a in s.assign {
            if len(a) == 0 { return Err(lexdb_base.err("TS141", "A SELECT statement that assigns a value to a variable must not be combined with data-retrieval operations.")) }
        }
    }
    if p.acceptKw("into") {
        // SELECT ... INTO [TEMPORARY | UNLOGGED] [TABLE] name (9.88)
        let gl = p.acceptKw("global") || p.acceptKw("local")
        s.temp = p.acceptKw("temporary") || p.acceptKw("temp")
        if gl && !s.temp { return Err(near(&p.peek())) }
        let ul = !s.temp && p.acceptKw("unlogged")
        let tb = p.acceptKw("table")
        s.into = try p.qname()
        s.spell = p.spelled
    }
    if p.acceptKw("from") {
        try p.fromList(mut &s.from, J_FIRST)
        s.table = s.from[0].table
    }
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    if p.acceptKw("group") {
        try p.expectKw("by")
        try p.groupBy(mut &s)
    }
    if p.acceptKw("having") { s.having = Some(try p.expr()) }
    if p.acceptKw("window") {
        // WINDOW name AS (spec), ...
        while true {
            let n = try p.name()
            try p.expectKw("as")
            try p.expectKw("(")
            let d = try p.winSpec()
            for w in s.windows { if w.name == n { return Err(lexdb_base.err("42P20", "window \"" + n + "\" is already defined")) } }
            append(mut &s.windows, NamedWin{name: n, def: d})
            if !p.acceptKw(",") { break }
        }
    }
    return Ok(s)
}

// GROUP BY's list, after BY (9.94 for ROLLUP, CUBE, GROUPING SETS, () and
// DISTINCT): its expressions, each once, in group; with any of those, the
// grouping sets as places in group (gsets), the items' sets crossed. A row
// (a, b) is its fields.
fn (p: mut &P) groupBy(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    var distinct = false
    if p.acceptKw("distinct") { distinct = true } else { let al = p.acceptKw("all") }
    var sets: [][]Expr = [[]]          // the cross product so far
    var special = false
    while true {
        let mine = try p.groupItem(true, mut &special)
        var next: [][]Expr = []
        for a in sets {
            for b in mine {
                var u: []Expr = []
                for x in a { append(mut &u, cloneE(&x)) }
                for x in b { append(mut &u, cloneE(&x)) }
                append(mut &next, u)
            }
        }
        sets = next
        if !p.acceptKw(",") { break }
    }
    var texts: []str = []
    for st in sets {
        for x in st {
            let t = exprText(&x)
            var seen = false
            for y in texts { if y == t { seen = true } }
            if !seen {
                append(mut &texts, t)
                append(mut &s.group, cloneE(&x))
            }
        }
    }
    if !special { return Ok(Unit{}) }
    var keys: []str = []
    for st in sets {
        var places: []int = []
        for x in st {
            let t = exprText(&x)
            for i in 0..len(texts) {
                if texts[i] == t {
                    var dup = false
                    for q in places { if q == i { dup = true } }
                    if !dup { append(mut &places, i) }
                }
            }
        }
        if distinct {
            // GROUP BY DISTINCT: a set listed again (in any order) once
            var sorted: []int = []
            for i in 0..len(texts) { for q in places { if q == i { append(mut &sorted, i) } } }
            var kb = newStrBuf()
            for q in sorted { kb.add(q.toStr() + ",") }
            let k = kb.toStr()
            var again = false
            for y in keys { if y == k { again = true } }
            if again { continue }
            append(mut &keys, k)
        }
        append(mut &s.gsets, places)
    }
    return Ok(Unit{})
}

// One item of GROUP BY (top: of the list itself), as its grouping sets:
// an expression [[x]]; (a, b) [[a, b]] (at the top, the same); () [[]];
// ROLLUP (x, y) [[x, y], [x], []]; CUBE (x, y) every subset; GROUPING SETS
// (...) its items' sets one after another.
fn (p: mut &P) groupItem(top: bool, special: mut &bool): Result[[][]Expr, lexdb_base.DbErr] {
    if p.isKw("(") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == ")" {
        p.pos += 2
        special = true
        return Ok([[]])
    }
    let t = p.peek()
    let kw = if t.kind == T_IDENT && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" { t.text } else { "" }
    if kw == "rollup" || kw == "cube" {
        p.pos += 2
        special = true
        var parts: [][]Expr = []
        while true {
            let x = try p.expr()
            if isRow(&x) { append(mut &parts, try rowItems(&x)) } else { append(mut &parts, [x]) }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
        var out: [][]Expr = []
        let n = len(parts)
        if kw == "rollup" {
            var k = n
            while k >= 0 {
                var u: []Expr = []
                for i in 0..k { for x in parts[i] { append(mut &u, cloneE(&x)) } }
                append(mut &out, u)
                k -= 1
            }
        } else {
            if n > 12 { return Err(lexdb_base.err("54001", "CUBE is limited to 12 elements")) }
            // as PostgreSQL lists them: the larger sets first
            var size = n
            while size >= 0 {
                for mask in 0..(1 << n) {
                    var bits = 0
                    for i in 0..n { if (mask >> (n - 1 - i)) & 1 == 1 { bits += 1 } }
                    if bits != size { continue }
                    var u: []Expr = []
                    for i in 0..n { if (mask >> (n - 1 - i)) & 1 == 1 { for x in parts[i] { append(mut &u, cloneE(&x)) } } }
                    append(mut &out, u)
                }
                size -= 1
            }
        }
        return Ok(out)
    }
    if t.kind == T_IDENT && t.text == "grouping" && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "sets" {
        p.pos += 2
        special = true
        try p.expectKw("(")
        var out: [][]Expr = []
        while true {
            var got = try p.groupItem(false, special)
            for i in 0..len(got) { append(mut &out, replace(mut &got[i], [])) }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
        return Ok(out)
    }
    let x = try p.expr()
    if isRow(&x) { return Ok([try rowItems(&x)]) }
    return Ok([[x]])
}

// A row lock's strength (9.86), weakest first, as PostgreSQL's.
pub const LOCK_KEY_SHARE = 1
pub const LOCK_SHARE = 2
pub const LOCK_NO_KEY_UPDATE = 3
pub const LOCK_UPDATE = 4

// What a lock held by another transaction does: wait, fail (NOWAIT), or
// leave the row out (SKIP LOCKED).
pub const WAIT_BLOCK = 0
pub const WAIT_NOWAIT = 1
pub const WAIT_SKIP = 2

pub fn lockName(m: int): str {
    if m == LOCK_KEY_SHARE { return "FOR KEY SHARE" }
    if m == LOCK_SHARE { return "FOR SHARE" }
    if m == LOCK_NO_KEY_UPDATE { return "FOR NO KEY UPDATE" }
    return "FOR UPDATE"
}

// FOR UPDATE | NO KEY UPDATE | SHARE | KEY SHARE [OF t, ...] [NOWAIT |
// SKIP LOCKED], after FOR. Several: the strongest, the tables of all.
fn (p: mut &P) lockClause(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    var m = LOCK_UPDATE
    if p.acceptKw("update") { m = LOCK_UPDATE }
    else if p.acceptKw("share") { m = LOCK_SHARE }
    else if p.acceptKw("no") {
        try p.expectKw("key")
        try p.expectKw("update")
        m = LOCK_NO_KEY_UPDATE
    } else {
        try p.expectKw("key")
        try p.expectKw("share")
        m = LOCK_KEY_SHARE
    }
    if m > s.lockMode { s.lockMode = m }
    if p.acceptKw("of") {
        append(mut &s.lockOf, try p.qname())
        while p.acceptKw(",") { append(mut &s.lockOf, try p.qname()) }
    }
    if p.acceptKw("nowait") { s.lockWait = WAIT_NOWAIT }
    else if p.acceptKw("skip") {
        try p.expectKw("locked")
        s.lockWait = WAIT_SKIP
    }
    return Ok(Unit{})
}

fn (p: mut &P) orderLimit(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("order") {
        try p.expectKw("by")
        while true {
            let e = try p.expr()
            var desc = false
            if p.acceptKw("desc") { desc = true } else { let a = p.acceptKw("asc") }
            var nf = desc
            if p.acceptKw("nulls") {
                if p.acceptKw("first") { nf = true } else {
                    try p.expectKw("last")
                    nf = false
                }
            }
            append(mut &s.order, OrderItem{expr: e, desc: desc, nullsFirst: nf})
            if !p.acceptKw(",") { break }
        }
    }
    var limited = false
    var offset = false
    while p.isKw("limit") || p.isKw("offset") || p.isKw("for") || p.isKw("fetch") {
        if p.acceptKw("for") {
            try p.lockClause(s)
        } else if p.isKw("limit") || p.isKw("fetch") {
            if limited { return Err(lexdb_base.err("42601", "multiple LIMIT clauses not allowed")) }
            limited = true
            if p.acceptKw("limit") {
                if p.acceptKw("all") { s.limit = None } else { s.limit = Some(try p.expr()) }
            } else {
                // FETCH FIRST | NEXT [n] ROW | ROWS ONLY | WITH TIES (9.94): n a
                // constant, a parameter or in parentheses; 1 when not given
                p.pos += 1
                if !p.acceptKw("first") { try p.expectKw("next") }
                s.limit = Some(Expr.Lit(Val.Int(1)))
                if !p.isKw("row") && !p.isKw("rows") { s.limit = Some(try p.unary()) }
                if !p.acceptKw("rows") { try p.expectKw("row") }
                if p.acceptKw("with") {
                    try p.expectKw("ties")
                    s.withTies = true
                } else {
                    try p.expectKw("only")
                }
            }
        } else {
            if offset { return Err(lexdb_base.err("42601", "multiple OFFSET clauses not allowed")) }
            offset = true
            let o = p.acceptKw("offset")
            s.offset = Some(try p.expr())
            let r = p.acceptKw("rows") || p.acceptKw("row")
        }
    }
    if s.withTies {
        if len(s.order) == 0 { return Err(lexdb_base.err("42601", "WITH TIES cannot be specified without ORDER BY clause")) }
        if s.lockWait == WAIT_SKIP { return Err(lexdb_base.err("42601", "SKIP LOCKED and WITH TIES options cannot be used together")) }
    }
    return Ok(Unit{})
}

// FROM's list (after FROM; UPDATE's FROM and DELETE's USING, 9.91): its
// first item joined as join, the rest by commas and JOINs.
fn (p: mut &P) fromList(from: mut &[]FromItem, join: int): Result[Unit, lexdb_base.DbErr] {
    var first = try p.fromItem(join)
    first.comma = true
    append(from, first)
    while true {
        if p.acceptKw(",") {
            var f = try p.fromItem(J_CROSS)
            f.comma = true
            append(from, f)
        } else if p.acceptKw("cross") {
            try p.expectKw("join")
            append(from, try p.fromItem(J_CROSS))
        } else if p.isKw("join") || p.isKw("inner") || p.isKw("left") || p.isKw("right") || p.isKw("full") || p.isKw("natural") {
            let natural = p.acceptKw("natural")
            var kind = J_INNER
            if p.acceptKw("left") {
                let o = p.acceptKw("outer")
                kind = J_LEFT
            } else if p.acceptKw("right") {
                let o = p.acceptKw("outer")
                kind = J_RIGHT
            } else if p.acceptKw("full") {
                let o = p.acceptKw("outer")
                kind = J_FULL
            } else {
                let i = p.acceptKw("inner")
            }
            try p.expectKw("join")
            var f = try p.fromItem(kind)
            if natural {
                f.natural = true
            } else if p.acceptKw("using") {
                // USING (a, ...) (9.93)
                try p.expectKw("(")
                append(mut &f.using, try p.name())
                while p.acceptKw(",") { append(mut &f.using, try p.name()) }
                try p.expectKw(")")
                if p.isKw("as") { return Err(lexdb_base.err("0A000", "lexdb: an alias for JOIN ... USING is not supported")) }
            } else {
                try p.expectKw("on")
                f.on = Some(try p.expr())
            }
            append(from, f)
        } else {
            break
        }
    }
    return Ok(Unit{})
}

// The functions that may be a FROM item.
pub fn isFromFn(n: &str): bool {
    return n == "generate_series" || n == "unnest" || n == "pg_partition_ancestors" || n == "pg_available_extensions" || n == "regexp_matches" ||
           n == "regexp_split_to_table" || n == "string_to_table"
}

fn (p: mut &P) fromItem(join: int): Result[FromItem, lexdb_base.DbErr] {
    let lateral = p.acceptKw("lateral")
    if p.peek().kind == T_IDENT && p.peek().text == "pg_catalog" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." &&
       p.peekAt(3).kind == T_OP && p.peekAt(3).text == "(" {
        p.pos += 2
    }
    if p.peek().kind == T_IDENT && isFromFn(&p.peek().text) &&
       p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_OP && p.toks[p.pos + 1].text == "(" {
        return p.fromFunction(join)
    }
    if lateral && !p.isKw("(") { return Err(lexdb_base.err("0A000", "LATERAL is supported before a subquery or a function only")) }
    if p.isKw("(") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "values" {
        // (VALUES (...), ...) [AS] alias [(columns)] (9.80)
        p.pos += 2
        let vi = try p.valuesSub()
        try p.expectKw(")")
        var valias = "*VALUES*"
        var vcols: []str = []
        try p.aliasOf(mut &valias, mut &vcols)
        return Ok(FromItem{table: "", alias: valias, join: join, on: None, sub: vi, cols: vcols, work: -1, lateral: false, using: [], natural: false, comma: false})
    }
    if p.acceptKw("(") {
        // a subquery in FROM
        if !p.isKw("select") && !p.isKw("with") { return Err(lexdb_base.err("0A000", "parenthesized joins are not supported")) }
        let i = try p.subquery(SUB_FROM)
        var alias = "unnamed_subquery"
        var cols: []str = []
        try p.aliasOf(mut &alias, mut &cols)
        return Ok(FromItem{table: "", alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: lateral, using: [], natural: false, comma: false})
    }
    let table = try p.rname()
    var alias = baseName(&table)
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols)
    // a CTE in scope (the innermost of the name) before a table; a
    // qualified name is always a table
    var ci = -1
    for i in 0..len(p.ctes) { if p.ctes[i].name == table { ci = i } }
    let rel = if ci >= 0 { "" } else { lexdb_pgcat.relOf(&(if isQual(&table) { schemaOf(&table) } else { "" }), &baseName(&table)) }
    if len(rel) > 0 {
        // a pg_catalog or information_schema relation (9.80): a function
        // in FROM whose rows the executor makes from its catalog
        var s = newStmt(S_SELECT)
        s.srf = "#" + rel
        s.use = SUB_FROM
        append(mut &p.subs, s)
        append(mut &p.seqs, CAT_MARK)
        return Ok(FromItem{table: rel, alias: alias, join: join, on: None, sub: len(p.subs) - 1, cols: cols, work: -1, lateral: false, using: [], natural: false, comma: false})
    }
    if ci >= 0 {
        if len(cols) == 0 { for c in p.ctes[ci].cols { append(mut &cols, c) } }
        // in its own body: its working table
        for k in 0..len(p.inCte) {
            if p.inCte[k].id == p.ctes[ci].id {
                if p.inCte[k].depth != p.depth {
                    return Err(lexdb_base.err("42P19", "recursive reference to query \"" + table + "\" must not appear within a subquery"))
                }
                p.inCte[k].refs += 1
                return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: -1, cols: cols, work: p.ctes[ci].id, lateral: false, using: [], natural: false, comma: false})
            }
        }
        let i = try p.cteRef(ci)
        return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: false, using: [], natural: false, comma: false})
    }
    return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: -1, cols: cols, work: -1, lateral: false, using: [], natural: false, comma: false})
}

// [AS] alias [(column, ...)]
// A function in FROM (9.27): generate_series(start, stop [, step]) or
// unnest(array, ...), [WITH ORDINALITY], [AS alias [(columns)]]. It is a
// subquery (SUB_FROM) whose items are the arguments and whose srf names the
// function; it may use the FROM items before it (LATERAL, as in
// PostgreSQL).
fn (p: mut &P) fromFunction(join: int): Result[FromItem, lexdb_base.DbErr] {
    let name = p.next().text
    try p.expectKw("(")
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var s = newStmt(S_SELECT)
    s.srf = name
    s.use = SUB_FROM
    if !p.isKw(")") {
        while true {
            append(mut &s.items, SelItem{star: false, qual: "", expr: Some(try p.expr()), alias: "", spell: ""})
            if !p.acceptKw(",") { break }
        }
    }
    try p.expectKw(")")
    s.subs = replace(mut &p.subs, saved)
    s.wins = replace(mut &p.wins, savedW)
    p.depth -= 1
    if p.acceptKw("with") {
        try p.expectKw("ordinality")
        s.ordin = true
    }
    append(mut &p.subs, s)
    let i = len(p.subs) - 1
    var alias = name
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols)
    // one column, an alias and no column names: the column is the alias
    let single = name == "generate_series" || name == "regexp_matches" || name == "regexp_split_to_table" || name == "string_to_table" ||
                 len(p.subs[i].items) == 1
    if single && alias != name && len(cols) == 0 { append(mut &cols, alias) }
    return Ok(FromItem{table: name, alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: true, using: [], natural: false, comma: false})
}

fn (p: mut &P) aliasOf(alias: mut &str, cols: mut &[]str): Result[Unit, lexdb_base.DbErr] {
    var got = false
    if p.acceptKw("as") {
        let old = replace(alias, try p.name())
        got = true
    } else {
        let t = p.peek()
        if t.kind == T_QIDENT || (t.kind == T_IDENT && !isReserved(&t.text)) {
            let old = replace(alias, t.text)
            p.pos += 1
            got = true
        }
    }
    if got && p.acceptKw("(") {
        append(cols, try p.name())
        while p.acceptKw(",") { append(cols, try p.name()) }
        try p.expectKw(")")
    }
    return Ok(Unit{})
}

fn (p: mut &P) createIndex(unique: bool): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_CREATE_INDEX)
    s.unique = unique
    s.conc = p.acceptKw("concurrently")
    if p.acceptKw("if") {
        try p.expectKw("not")
        try p.expectKw("exists")
        s.ifFlag = true
    }
    // in its table's schema; none (9.94): PostgreSQL's name is chosen (lexdb_exec)
    if s.ifFlag || !p.isKw("on") { s.index = try p.name() }
    try p.expectKw("on")
    s.table = try p.rname()
    if p.acceptKw("using") {
        let m = try p.name()
        if m != "btree" { return Err(lexdb_base.err("0A000", "index method \"" + m + "\" is not supported")) }
    }
    try p.expectKw("(")
    try p.indexCol(mut &s)
    while p.acceptKw(",") { try p.indexCol(mut &s) }
    try p.expectKw(")")
    if p.acceptKw("where") { s.where = Some(try p.expr()) }      // a filtered index
    return Ok(s)
}

// PostgreSQL's B-tree operator classes for the types lexdb has.
fn isOpClass(n: &str): bool {
    match n {
        "text_ops", "text_pattern_ops", "varchar_ops", "varchar_pattern_ops", "bpchar_ops", "bpchar_pattern_ops", "name_ops",
        "int2_ops", "int4_ops", "int8_ops", "numeric_ops", "float4_ops", "float8_ops", "bool_ops", "oid_ops", "char_ops",
        "uuid_ops", "bytea_ops", "date_ops", "time_ops", "timestamp_ops", "timestamptz_ops", "interval_ops", "array_ops" { return true }
        else { return false }
    }
}

// An index's column: name [COLLATE c] [opclass] [ASC | DESC] [NULLS FIRST |
// LAST] (9.85). The name in names; the rest in pk, as PostgreSQL shows it
// ("" none). They change nothing: lexdb's text compares bytewise (C, which
// the pattern operator classes are for), and a B+tree is read either way.
fn (p: mut &P) indexCol(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.isKw("(") || (p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(") {
        // an expression (9.89): (expr), or a function's call
        let subs = len(p.subs)
        let params = p.params
        let x = try p.unary()
        if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in index expression")) }
        if p.params > params { return Err(lexdb_base.err("42P02", "there is no parameter $" + p.params.toStr())) }
        append(mut &s.names, "")
        append(mut &s.exprs, x)
    } else {
        append(mut &s.names, try p.name())
        append(mut &s.exprs, Expr.Lit(Val.Null))
    }
    var opts: []str = []
    if p.acceptKw("collate") {
        // a collation's name as written: PostgreSQL's are matched by case ("C")
        let c = try p.qname()
        let sp = if len(p.spelled) > 0 { p.spelled } else { baseName(&c) }
        append(mut &opts, "COLLATE \"" + (if isQual(&c) { qual(&schemaOf(&c), &sp) } else { sp }) + "\"")
    }
    let t = p.peek()
    if t.kind == T_IDENT && t.text != "asc" && t.text != "desc" && t.text != "nulls" {
        let oc = try p.qname()
        if !isOpClass(&baseName(&oc)) {
            return Err(lexdb_base.err("42704", "operator class \"" + oc + "\" does not exist for access method \"btree\""))
        }
        append(mut &opts, oc)
    }
    var desc = false
    if p.acceptKw("desc") { desc = true } else { let asc = p.acceptKw("asc") }
    if desc { append(mut &opts, "DESC") }
    if p.acceptKw("nulls") {
        // shown when not the default: last ascending, first descending
        let first = p.acceptKw("first")
        if !first { try p.expectKw("last") }
        if first != desc { append(mut &opts, if first { "NULLS FIRST" } else { "NULLS LAST" }) }
    }
    append(mut &s.pk, strings.join(&opts, " "))
    return Ok(Unit{})
}

// UPDATE [ONLY] t [[AS] alias] SET ... [FROM list] [WHERE ...] [RETURNING ...]
// (FROM and the alias: 9.91). The alias in alias, FROM's items in from.
fn (p: mut &P) update(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_UPDATE)
    try p.dmlTarget(mut &s)
    try p.expectKw("set")
    try p.setList(mut &s)
    if p.acceptKw("from") { try p.fromList(mut &s.from, J_CROSS) }
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    try p.returning(mut &s)
    return Ok(s)
}

// DELETE FROM [ONLY] t [[AS] alias] [USING list] [WHERE ...] [RETURNING ...]
fn (p: mut &P) delete(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("from")
    var s = newStmt(S_DELETE)
    try p.dmlTarget(mut &s)
    if p.acceptKw("using") { try p.fromList(mut &s.from, J_CROSS) }
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    try p.returning(mut &s)
    return Ok(s)
}

// UPDATE's and DELETE's table: [ONLY] name [*] [[AS] alias]. lexdb has no
// inheritance, so ONLY and * change nothing.
fn (p: mut &P) dmlTarget(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    let only = p.acceptKw("only")
    s.table = try p.rname()
    let star = p.acceptKw("*")
    var cols: []str = []
    try p.aliasOf(mut &s.alias, mut &cols)
    if len(cols) > 0 { return Err(lexdb_base.err("42601", "syntax error at or near \"(\"")) }
    return Ok(Unit{})
}

// TRUNCATE [TABLE] [ONLY] name [*], ... [RESTART IDENTITY | CONTINUE
// IDENTITY] [CASCADE | RESTRICT] (9.91): the first name in table, the
// others in names; RESTART IDENTITY in ifFlag, CASCADE in cascade.
fn (p: mut &P) truncate(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_TRUNCATE)
    let tb = p.acceptKw("table")
    while true {
        let only = p.acceptKw("only")
        let n = try p.rname()
        let star = p.acceptKw("*")
        if len(s.table) == 0 { s.table = n } else { append(mut &s.names, n) }
        if !p.acceptKw(",") { break }
    }
    if p.acceptKw("restart") {
        try p.expectKw("identity")
        s.ifFlag = true
    } else if p.acceptKw("continue") {
        try p.expectKw("identity")
    }
    if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
    return Ok(s)
}

// The maintenance statements (9.94), after their keyword: checked, then
// done as nothing.
//   VACUUM [(option, ...)] [FULL] [FREEZE] [VERBOSE] [ANALYZE] [[ONLY] table [(col, ...)], ...]
//   ANALYZE [(option, ...)] [VERBOSE] [[ONLY] table [(col, ...)], ...]
//   CHECKPOINT
//   REINDEX [(option, ...)] {INDEX | TABLE | SCHEMA | DATABASE | SYSTEM} [CONCURRENTLY] [name]
//   CLUSTER [(option, ...)] [VERBOSE] [table [USING index]]
fn (p: mut &P) maint(w: str): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_MAINT)
    let kw = if w == "analyse" { "analyze" } else { w }
    s.alias = strings.toUpperAscii(kw)
    if kw == "checkpoint" { return Ok(s) }
    var analyze = kw == "analyze"
    var full = false
    var parallel = false
    var conc = false
    if p.acceptKw("(") {
        while true {
            let o = p.next()
            if o.kind != T_IDENT { return Err(near(&o)) }
            let known = match kw {
                "vacuum" { o.text == "full" || o.text == "freeze" || o.text == "verbose" || o.text == "analyze" || o.text == "disable_page_skipping" ||
                           o.text == "skip_locked" || o.text == "index_cleanup" || o.text == "process_main" || o.text == "process_toast" ||
                           o.text == "truncate" || o.text == "parallel" || o.text == "skip_database_stats" || o.text == "only_database_stats" ||
                           o.text == "buffer_usage_limit" }
                "analyze" { o.text == "verbose" || o.text == "skip_locked" || o.text == "buffer_usage_limit" }
                "reindex" { o.text == "concurrently" || o.text == "tablespace" || o.text == "verbose" }
                else { o.text == "verbose" }
            }
            if !known { return Err(lexdb_base.err("42601", "unrecognized \"" + s.alias + "\" option \"" + o.text + "\"")) }
            // its value, if any: a word, a number or a text
            var off = false
            if !p.isKw(",") && !p.isKw(")") {
                let v = p.next()
                off = v.text == "false" || v.text == "off" || v.text == "0"
            }
            if !off {
                if o.text == "analyze" { analyze = true }
                if o.text == "full" { full = true }
                if o.text == "parallel" { parallel = true }
                if o.text == "concurrently" { conc = true }
            }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    } else {
        while true {
            if p.acceptKw("verbose") { continue }
            if kw == "vacuum" && (p.isKw("full") || p.isKw("freeze") || p.isKw("analyze") || p.isKw("analyse")) {
                let o = p.next().text
                if o == "full" { full = true }
                if o == "analyze" || o == "analyse" { analyze = true }
                continue
            }
            break
        }
    }
    if full && parallel { return Err(lexdb_base.err("0A000", "VACUUM FULL cannot be performed in parallel")) }
    if kw == "vacuum" || kw == "analyze" {
        if kw == "vacuum" { s.table = "VACUUM" }
        // ANALYZE gathers the planner's statistics (lexdb_exec, optimizer 31)
        if analyze { s.kind = S_ANALYZE }
        while p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT {
            let only = p.acceptKw("only")
            append(mut &s.names, try p.qname())
            var cols: []str = []
            if p.acceptKw("(") {
                append(mut &cols, try p.name())
                while p.acceptKw(",") { append(mut &cols, try p.name()) }
                try p.expectKw(")")
                if !analyze { return Err(lexdb_base.err("0A000", "ANALYZE option must be specified when a column list is provided")) }
            }
            append(mut &s.maintCols, cols)
            if !p.acceptKw(",") { break }
        }
        return Ok(s)
    }
    s.unique = true
    if kw == "reindex" {
        let what = p.next()
        if what.kind != T_IDENT || (what.text != "index" && what.text != "table" && what.text != "schema" && what.text != "database" &&
                                    what.text != "system") { return Err(near(&what)) }
        if p.acceptKw("concurrently") { conc = true }
        let whole = what.text == "database" || what.text == "system"
        if whole && what.text == "system" && conc { return Err(lexdb_base.err("0A000", "cannot reindex system catalogs concurrently")) }
        if conc { s.table = "REINDEX CONCURRENTLY" } else if whole { s.table = "REINDEX " + strings.toUpperAscii(what.text) }
        if whole {
            if p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT {
                let n = try p.name()
                if n != "lexdb" { return Err(lexdb_base.err("0A000", "can only reindex the currently open database")) }
            }
        } else if what.text == "schema" {
            s.index = SCHEMA_MARK + (try p.name())
        } else if what.text == "index" {
            s.index = try p.qname()
        } else {
            append(mut &s.names, try p.qname())
        }
        return Ok(s)
    }
    // CLUSTER
    if p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT {
        append(mut &s.names, try p.qname())
        if p.acceptKw("using") { s.index = try p.qname() }
    } else {
        s.table = "CLUSTER"
    }
    return Ok(s)
}

// In S_MAINT's index: REINDEX SCHEMA's schema, to check.
pub const SCHEMA_MARK: str = "\x00schema:"

// COPY (9.45), after its keyword:
//   COPY table [(col, ...)] FROM STDIN [options]
//   COPY {table [(col, ...)] | (query)} TO STDOUT [options]
// options: [WITH] (FORMAT text|csv, DELIMITER 'c', NULL 's', HEADER [bool],
// QUOTE 'c', ESCAPE 'c', ENCODING 'utf8'), or the old form [WITH] [BINARY]
// [DELIMITER [AS] 'c'] [NULL [AS] 's'] [CSV [HEADER] [QUOTE [AS] 'c']
// [ESCAPE [AS] 'c']]. A table's TO is the query SELECT cols FROM table.
fn (p: mut &P) copyStmt(): Result[Stmt, lexdb_base.DbErr] {
    var s = newStmt(S_COPY)
    var query = false
    if p.isKw("(") {
        p.pos += 1
        query = true
        var q: Stmt = newStmt(S_SELECT)
        if p.acceptKw("select") { q = try p.select() }
        else if p.acceptKw("with") {
            let n = try p.withList()
            try p.expectKw("select")
            let r = p.select()
            p.popCtes(n)
            q = try r
        } else { return Err(lexdb_base.err("0A000", "lexdb: COPY's query must be a SELECT")) }
        try p.expectKw(")")
        q.subs = replace(mut &p.subs, [])
        q.wins = replace(mut &p.wins, [])
        q.params = p.params
        append(mut &s.inner, q)
    } else {
        s.table = try p.rname()
        if p.acceptKw("(") {
            append(mut &s.names, try p.name())
            while p.acceptKw(",") { append(mut &s.names, try p.name()) }
            try p.expectKw(")")
        }
    }
    if p.acceptKw("from") {
        if query { return Err(lexdb_base.err("42601", "COPY FROM takes a table, not a query")) }
        s.copy.from = true
        if !p.acceptKw("stdin") { return Err(lexdb_base.err("0A000", "lexdb: COPY FROM reads only STDIN (a file on the server: use psql's \\copy)")) }
    } else {
        try p.expectKw("to")
        if !p.acceptKw("stdout") { return Err(lexdb_base.err("0A000", "lexdb: COPY TO writes only STDOUT (a file on the server: use psql's \\copy)")) }
    }
    var format = ""
    var hasQuote = false
    var hasEscape = false
    var delim: Option[str] = None
    var null: Option[str] = None
    let with = p.acceptKw("with")
    if p.acceptKw("(") {
        while true {
            let t = p.peek()
            if t.kind != T_IDENT { return Err(near(&t)) }
            p.pos += 1
            let v = p.peek()
            match t.text {
                "format" {
                    if v.kind != T_IDENT && v.kind != T_STR { return Err(near(&v)) }
                    p.pos += 1
                    format = strings.toLowerAscii(v.text)
                }
                "header" {
                    if v.kind == T_IDENT && v.text != "match" { p.pos += 1; s.copy.header = !(v.text == "false" || v.text == "off") }
                    else if v.kind == T_NUM { p.pos += 1; s.copy.header = v.text != "0" }
                    else if v.kind == T_IDENT { return Err(lexdb_base.err("0A000", "lexdb: COPY's HEADER MATCH is not supported")) }
                    else { s.copy.header = true }
                }
                "delimiter" { delim = Some(try p.copyStr()) }
                "null" { null = Some(try p.copyStr()) }
                "quote" { s.copy.quote = try p.copyStr(); hasQuote = true }
                "escape" { s.copy.escape = try p.copyStr(); hasEscape = true }
                "encoding" {
                    let enc = strings.toLowerAscii(try p.copyStr())
                    if enc != "utf8" && enc != "utf-8" && enc != "unicode" && enc != "sql_ascii" {
                        return Err(lexdb_base.err("0A000", "lexdb: COPY's encoding is UTF8 only"))
                    }
                }
                "freeze" {
                    // a hint: accepted (with its boolean) and ignored
                    if v.kind == T_IDENT && (v.text == "true" || v.text == "false" || v.text == "on" || v.text == "off") { p.pos += 1 }
                }
                "force_quote" {
                    if p.acceptKw("*") { s.copy.quoteAll = true } else { s.copy.forceQuote = try p.nameList() }
                }
                "force_not_null" { s.copy.forceNotNull = try p.nameList() }
                "force_null" { s.copy.forceNull = try p.nameList() }
                "batch_rows" {
                    // lexdb's own (9.87)
                    if v.kind != T_NUM { return Err(near(&v)) }
                    p.pos += 1
                    let n = strings.parseIntOpt(v.text).unwrapOr(0)
                    if n < 1 { return Err(lexdb_base.err("22023", "batch_rows must be a positive integer")) }
                    s.copy.batchRows = n
                }
                "on_error", "default", "log_verbosity", "reject_limit" {
                    return Err(lexdb_base.err("0A000", "lexdb: COPY's option \"" + t.text + "\" is not supported"))
                }
                else { return Err(lexdb_base.err("42601", "option \"" + t.text + "\" not recognized")) }
            }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    } else {
        while true {
            if p.acceptKw("binary") { format = "binary" }
            else if p.acceptKw("delimiter") { let a = p.acceptKw("as"); delim = Some(try p.copyStr()) }
            else if p.acceptKw("null") { let a = p.acceptKw("as"); null = Some(try p.copyStr()) }
            else if p.acceptKw("csv") { format = "csv" }
            else if p.acceptKw("header") { s.copy.header = true }
            else if p.acceptKw("quote") { let a = p.acceptKw("as"); s.copy.quote = try p.copyStr(); hasQuote = true }
            else if p.acceptKw("escape") { let a = p.acceptKw("as"); s.copy.escape = try p.copyStr(); hasEscape = true }
            else if p.acceptKw("force") {
                // FORCE QUOTE {* | col, ...}, FORCE NOT NULL col, ...
                if p.acceptKw("quote") {
                    if p.acceptKw("*") { s.copy.quoteAll = true } else { s.copy.forceQuote = try p.bareNames() }
                } else {
                    try p.expectKw("not")
                    try p.expectKw("null")
                    s.copy.forceNotNull = try p.bareNames()
                }
            }
            else { break }
        }
    }
    if format == "binary" { return Err(lexdb_base.err("0A000", "lexdb: COPY's binary format is not supported")) }
    if format != "" && format != "text" && format != "csv" { return Err(lexdb_base.err("22023", "COPY format \"" + format + "\" not recognized")) }
    s.copy.csv = format == "csv"
    s.copy.delim = delim.unwrapOr(if s.copy.csv { "," } else { "\t" })
    s.copy.null = null.unwrapOr(if s.copy.csv { "" } else { "\\N" })
    if !s.copy.csv && (hasQuote || hasEscape) {
        return Err(lexdb_base.err("0A000", "COPY " + (if hasQuote { "quote" } else { "escape" }) + " available only in CSV mode"))
    }
    if !hasQuote { s.copy.quote = "\"" }
    if !hasEscape { s.copy.escape = s.copy.quote }
    if len(s.copy.delim) != 1 { return Err(lexdb_base.err("22023", "COPY delimiter must be a single one-byte character")) }
    if s.copy.delim == "\n" || s.copy.delim == "\r" { return Err(lexdb_base.err("22023", "COPY delimiter cannot be newline or carriage return")) }
    if !s.copy.csv && strings.indexOf(&"\\.abcdefghijklmnopqrstuvwxyz0123456789", s.copy.delim, 0) >= 0 {
        return Err(lexdb_base.err("22023", "COPY delimiter cannot be \"" + s.copy.delim + "\""))
    }
    if s.copy.csv {
        if len(s.copy.quote) != 1 { return Err(lexdb_base.err("22023", "COPY quote must be a single one-byte character")) }
        if len(s.copy.escape) != 1 { return Err(lexdb_base.err("22023", "COPY escape must be a single one-byte character")) }
        if s.copy.quote == s.copy.delim { return Err(lexdb_base.err("22023", "COPY delimiter and quote must be different")) }
    }
    let anyQuote = s.copy.quoteAll || len(s.copy.forceQuote) > 0
    if (anyQuote || len(s.copy.forceNotNull) > 0 || len(s.copy.forceNull) > 0) && !s.copy.csv {
        let which = if anyQuote { "force quote" } else if len(s.copy.forceNotNull) > 0 { "force not null" } else { "force null" }
        return Err(lexdb_base.err("0A000", "COPY " + which + " available only in CSV mode"))
    }
    if anyQuote && s.copy.from { return Err(lexdb_base.err("0A000", "COPY force quote only available using COPY TO")) }
    if len(s.copy.forceNotNull) > 0 && !s.copy.from { return Err(lexdb_base.err("0A000", "COPY force not null only available using COPY FROM")) }
    if len(s.copy.forceNull) > 0 && !s.copy.from { return Err(lexdb_base.err("0A000", "COPY force null only available using COPY FROM")) }
    if strings.indexOf(&s.copy.null, s.copy.delim, 0) >= 0 {
        return Err(lexdb_base.err("22023", "COPY delimiter character must not appear in the NULL specification"))
    }
    if strings.indexOf(&s.copy.null, "\n", 0) >= 0 || strings.indexOf(&s.copy.null, "\r", 0) >= 0 {
        return Err(lexdb_base.err("22023", "COPY null representation cannot use newline or carriage return"))
    }
    if !query && !s.copy.from {
        // TO from a table: its query
        var q = newStmt(S_SELECT)
        if len(s.names) == 0 { append(mut &q.items, SelItem{star: true, qual: "", expr: None, alias: "", spell: ""}) }
        for n in s.names { append(mut &q.items, SelItem{star: false, qual: "", expr: Some(Expr.Col(n)), alias: "", spell: ""}) }
        append(mut &q.from, FromItem{table: s.table, alias: baseName(&s.table), join: J_FIRST, on: None, sub: -1, cols: [], work: -1, lateral: false, using: [], natural: false, comma: false})
        append(mut &s.inner, q)
    }
    return Ok(s)
}

// (col, ...): COPY's FORCE options.
fn (p: mut &P) nameList(): Result[[]str, lexdb_base.DbErr] {
    try p.expectKw("(")
    let ns = try p.bareNames()
    try p.expectKw(")")
    return Ok(ns)
}

// col, ...: in the old options' form no comma separates options, so one
// here always continues the list.
fn (p: mut &P) bareNames(): Result[[]str, lexdb_base.DbErr] {
    var ns: []str = [try p.name()]
    while p.acceptKw(",") { append(mut &ns, try p.name()) }
    return Ok(ns)
}

// ---- windows (9.46)

// After OVER: a window's name, or (spec).
fn (p: mut &P) over(): Result[WinDef, lexdb_base.DbErr] {
    if p.acceptKw("(") { return p.winSpec() }
    let n = try p.name()
    return Ok(WinDef{call: Expr.Lit(Val.Null), ref: n, bare: true, part: [], order: [], frame: noFrame()})
}

// A window's spec, after its "(": [name] [PARTITION BY ...] [ORDER BY ...]
// [frame], and its ")".
fn (p: mut &P) winSpec(): Result[WinDef, lexdb_base.DbErr] {
    var d = WinDef{call: Expr.Lit(Val.Null), ref: "", bare: false, part: [], order: [], frame: noFrame()}
    let t = p.peek()
    if (t.kind == T_IDENT || t.kind == T_QIDENT) && !(t.kind == T_IDENT &&
        (t.text == "partition" || t.text == "order" || t.text == "rows" || t.text == "range" || t.text == "groups")) {
        d.ref = try p.name()
    }
    if p.acceptKw("partition") {
        try p.expectKw("by")
        append(mut &d.part, try p.expr())
        while p.acceptKw(",") { append(mut &d.part, try p.expr()) }
    }
    if p.acceptKw("order") {
        try p.expectKw("by")
        while true {
            let x = try p.expr()
            var desc = false
            if p.acceptKw("desc") { desc = true } else { let a = p.acceptKw("asc") }
            var nf = desc                   // NULLs come first going down, last going up
            if p.acceptKw("nulls") {
                if p.acceptKw("first") { nf = true } else {
                    try p.expectKw("last")
                    nf = false
                }
            }
            append(mut &d.order, WinOrder{expr: x, desc: desc, nullsFirst: nf})
            if !p.acceptKw(",") { break }
        }
    }
    var mode = FR_NONE
    if p.acceptKw("rows") { mode = FR_ROWS }
    else if p.acceptKw("range") { mode = FR_RANGE }
    else if p.acceptKw("groups") { mode = FR_GROUPS }
    if mode != FR_NONE {
        var f = noFrame()
        f.mode = mode
        if p.acceptKw("between") {
            try p.bound(mut &f, true)
            try p.expectKw("and")
            try p.bound(mut &f, false)
        } else {
            try p.bound(mut &f, true)
            f.end = B_CURRENT
        }
        if p.acceptKw("exclude") {
            if p.acceptKw("current") { try p.expectKw("row"); f.exclude = EX_CURRENT }
            else if p.acceptKw("group") { f.exclude = EX_GROUP }
            else if p.acceptKw("ties") { f.exclude = EX_TIES }
            else { try p.expectKw("no"); try p.expectKw("others") }
        }
        if f.start == B_UNBOUNDED_FOLLOWING { return Err(lexdb_base.err("42P20", "frame start cannot be UNBOUNDED FOLLOWING")) }
        if f.end == B_UNBOUNDED_PRECEDING { return Err(lexdb_base.err("42P20", "frame end cannot be UNBOUNDED PRECEDING")) }
        if f.start == B_CURRENT && f.end == B_PRECEDING {
            return Err(lexdb_base.err("42P20", "frame starting from current row cannot have preceding rows"))
        }
        if f.start == B_FOLLOWING && (f.end == B_PRECEDING || f.end == B_CURRENT) {
            return Err(lexdb_base.err("42P20", "frame starting from following row cannot have preceding rows"))
        }
        d.frame = f
    }
    try p.expectKw(")")
    return Ok(d)
}

// A frame's bound: UNBOUNDED PRECEDING | n PRECEDING | CURRENT ROW |
// n FOLLOWING | UNBOUNDED FOLLOWING.
fn (p: mut &P) bound(f: mut &Frame, start: bool): Result[Unit, lexdb_base.DbErr] {
    var kind = 0
    var off: Option[Expr] = None
    if p.acceptKw("unbounded") {
        if p.acceptKw("preceding") { kind = B_UNBOUNDED_PRECEDING } else {
            try p.expectKw("following")
            kind = B_UNBOUNDED_FOLLOWING
        }
    } else if p.acceptKw("current") {
        try p.expectKw("row")
        kind = B_CURRENT
    } else {
        off = Some(try p.expr())
        if p.acceptKw("preceding") { kind = B_PRECEDING } else {
            try p.expectKw("following")
            kind = B_FOLLOWING
        }
    }
    if start {
        f.start = kind
        f.startOff = off
    } else {
        f.end = kind
        f.endOff = off
    }
    return Ok(Unit{})
}

// A COPY option's value: a string.
fn (p: mut &P) copyStr(): Result[str, lexdb_base.DbErr] {
    let t = p.peek()
    if t.kind != T_STR { return Err(near(&t)) }
    p.pos += 1
    return Ok(t.text)
}

fn (p: mut &P) statement(): Result[Stmt, lexdb_base.DbErr] {
    let t = p.peek()
    if t.kind == T_EOF || (t.kind == T_OP && t.text == ";") { return Ok(newStmt(S_EMPTY)) }
    if t.kind != T_IDENT { return Err(near(&t)) }
    p.pos += 1
    match t.text {
        "select" {
            var q = try p.select()
            if len(q.into) == 0 { return Ok(q) }
            // SELECT ... INTO t: CREATE TABLE t AS the query (9.88)
            var c = newStmt(S_CREATE)
            c.table = replace(mut &q.into, "")
            c.temp = q.temp
            c.spell = replace(mut &q.spell, "")
            q.subs = replace(mut &p.subs, [])
            q.wins = replace(mut &p.wins, [])
            q.params = p.params
            append(mut &c.inner, q)
            return Ok(c)
        }
        "values" {
            var vq = try p.valuesQuery()
            try p.orderLimit(mut &vq)
            return Ok(vq)
        }
        "with" {
            // its queries are used where they are named (cteRef): in an
            // INSERT's SELECT, an UPDATE's or a DELETE's subqueries
            let n = try p.withList()
            var r: Result[Stmt, lexdb_base.DbErr] = Err(lexdb_base.err("42601", "WITH must be followed by SELECT, INSERT, UPDATE or DELETE"))
            if p.acceptKw("select") { r = p.select() }
            else if p.acceptKw("insert") { r = p.insert() }
            else if p.acceptKw("update") { r = p.update() }
            else if p.acceptKw("delete") { r = p.delete() }
            p.popCtes(n)
            return r
        }
        "insert" { return p.insert() }
        "alter" {
            // ALTER TABLE | VIEW | SEQUENCE | SCHEMA [IF EXISTS] name OWNER TO role (9.83)
            if p.isKw("table") || p.isKw("view") || p.isKw("sequence") || p.isKw("schema") {
                let back = p.pos
                let kind = p.next().text
                let ife = p.acceptKw("if")
                if ife { try p.expectKw("exists") }
                let nm = if kind == "schema" { try p.name() } else { try p.qname() }
                if p.acceptKw("owner") {
                    try p.expectKw("to")
                    var o = newStmt(S_OWNER)
                    o.index = kind
                    o.table = nm
                    o.ifFlag = ife
                    append(mut &o.names, try p.roleSpec())
                    return Ok(o)
                }
                p.pos = back
            }
            if p.acceptKw("view") {
                var v = newStmt(S_ALTER_VIEW)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    v.ifFlag = true
                }
                v.table = try p.qname()
                if !p.acceptKw("rename") { return Err(lexdb_base.err("0A000", "lexdb: ALTER VIEW supports RENAME TO only")) }
                try p.expectKw("to")
                v.index = try p.name()
                return Ok(v)
            }
            if p.acceptKw("table") { return p.alterTable() }
            if p.acceptKw("type") {
                // ALTER TYPE name ADD VALUE [IF NOT EXISTS] 'v' [BEFORE | AFTER 'w'] (9.90)
                var ty = newStmt(S_ALTER_TYPE)
                ty.table = try p.qname()
                if !p.acceptKw("add") {
                    return Err(lexdb_base.err("0A000", "lexdb: ALTER TYPE supports ADD VALUE only"))
                }
                try p.expectKw("value")
                if p.acceptKw("if") {
                    try p.expectKw("not")
                    try p.expectKw("exists")
                    ty.ifFlag = true
                }
                let v = p.next()
                if v.kind != T_STR { return Err(near(&v)) }
                append(mut &ty.names, v.text)
                if p.isKw("before") || p.isKw("after") {
                    ty.alias = p.next().text
                    let w = p.next()
                    if w.kind != T_STR { return Err(near(&w)) }
                    ty.index = w.text
                }
                return Ok(ty)
            }
            if p.acceptKw("role") || p.acceptKw("user") {
                var r = newStmt(S_ALTER_ROLE)
                r.table = try p.name()
                if p.acceptKw("rename") {
                    try p.expectKw("to")
                    append(mut &r.names, "rename:" + (try p.name()))
                    return Ok(r)
                }
                if p.isKw("set") || p.isKw("reset") {
                    return Err(lexdb_base.err("0A000", "lexdb: a role's own settings (ALTER ROLE ... SET) are not supported"))
                }
                try p.roleOptions(mut &r)
                return Ok(r)
            }
            if p.acceptKw("sequence") { return p.seqStmt(S_ALTER_SEQ) }
            // ALTER INDEX [IF EXISTS] name RENAME TO new, ALTER SCHEMA name
            // RENAME TO new
            let idx = p.acceptKw("index")
            if idx || p.acceptKw("schema") {
                var s = newStmt(if idx { S_ALTER_INDEX } else { S_ALTER_SCHEMA })
                if idx {
                    if p.acceptKw("if") {
                        try p.expectKw("exists")
                        s.ifFlag = true
                    }
                    s.index = try p.qname()
                } else {
                    s.table = try p.name()
                }
                if !p.acceptKw("rename") {
                    return Err(lexdb_base.err("0A000", "lexdb: ALTER " + (if idx { "INDEX" } else { "SCHEMA" }) + " takes RENAME TO only"))
                }
                try p.expectKw("to")
                append(mut &s.alters, Alter{kind: A_RENAME, col: noCol(), name: try p.name(), to: "", ifFlag: false, using: None, cons: [], cascade: false})
                return Ok(s)
            }
            return Err(lexdb_base.err("0A000", "only ALTER TABLE, ALTER INDEX and ALTER SCHEMA are supported"))
        }
        "update" { return p.update() }
        "delete" { return p.delete() }
        "truncate" { return p.truncate() }
        "vacuum", "analyze", "analyse", "checkpoint", "reindex", "cluster" { return p.maint(t.text) }
        "copy" { return p.copyStmt() }
        "create" {
            var orReplace = false
            if p.isKw("or") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "replace" {
                p.pos += 2
                orReplace = true
                if !p.isKw("view") && !p.isKw("temp") && !p.isKw("temporary") {
                    return Err(lexdb_base.err("0A000", "lexdb: CREATE OR REPLACE is supported for views only"))
                }
            }
            // [GLOBAL | LOCAL] {TEMPORARY | TEMP}, or UNLOGGED (a table as any:
            // lexdb's are logged), before TABLE, SEQUENCE or VIEW (9.96)
            var temp = false
            if p.isKw("global") || p.isKw("local") {
                p.pos += 1
                if !p.acceptKw("temporary") { try p.expectKw("temp") }
                temp = true
            } else if p.acceptKw("temporary") || p.acceptKw("temp") {
                temp = true
            } else if !orReplace && p.isKw("unlogged") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "table" {
                p.pos += 1
            }
            if p.acceptKw("view") {
                var v = try p.createView(orReplace)
                v.temp = temp
                return Ok(v)
            }
            if orReplace && temp { return Err(near(&p.peek())) }
            if p.acceptKw("table") {
                var ct = try p.createTable()
                ct.temp = temp
                return Ok(ct)
            }
            if temp {
                if !p.acceptKw("sequence") { return Err(near(&p.peek())) }
                var q = try p.seqStmt(S_CREATE_SEQ)
                q.temp = true
                return Ok(q)
            }
            if p.acceptKw("type") {
                // CREATE TYPE name AS ENUM ('a', ...) (9.90)
                var ty = newStmt(S_CREATE_TYPE)
                ty.table = try p.qname()
                try p.expectKw("as")
                if !p.acceptKw("enum") { return Err(lexdb_base.err("0A000", "lexdb: CREATE TYPE supports AS ENUM only")) }
                try p.expectKw("(")
                if !p.acceptKw(")") {
                    while true {
                        let v = p.next()
                        if v.kind != T_STR { return Err(near(&v)) }
                        append(mut &ty.names, v.text)
                        if !p.acceptKw(",") { break }
                    }
                    try p.expectKw(")")
                }
                return Ok(ty)
            }
            if p.isKw("role") || p.isKw("user") {
                let user = p.next().text == "user"
                var r = newStmt(S_CREATE_ROLE)
                r.table = try p.name()
                if user { append(mut &r.names, "login") }       // CREATE USER: LOGIN unless NOLOGIN
                try p.roleOptions(mut &r)
                return Ok(r)
            }
            if p.acceptKw("sequence") { return p.seqStmt(S_CREATE_SEQ) }
            if p.acceptKw("schema") {
                var s = newStmt(S_CREATE_SCHEMA)
                if p.acceptKw("if") {
                    try p.expectKw("not")
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                // name [AUTHORIZATION role], or AUTHORIZATION role (the schema named for it)
                if p.acceptKw("authorization") {
                    let r = try p.roleSpec()
                    s.table = r
                    append(mut &s.names, r)
                    return Ok(s)
                }
                s.table = try p.name()
                if p.acceptKw("authorization") { append(mut &s.names, try p.roleSpec()) }
                return Ok(s)
            }
            if p.acceptKw("index") { return p.createIndex(false) }
            if p.acceptKw("unique") {
                try p.expectKw("index")
                return p.createIndex(true)
            }
            return Err(lexdb_base.err("0A000", "only CREATE TABLE, CREATE INDEX, CREATE SCHEMA and CREATE SEQUENCE are supported"))
        }
        "explain" {
            var s = newStmt(S_EXPLAIN)
            s.ifFlag = p.acceptKw("analyze")        // EXPLAIN ANALYZE: run it and count
            var inner = try p.statement()
            inner.subs = replace(mut &p.subs, [])
            inner.wins = replace(mut &p.wins, [])
            inner.params = p.params
            if s.ifFlag && inner.kind != S_SELECT {
                return Err(lexdb_base.err("0A000", "EXPLAIN ANALYZE takes SELECT"))
            }
            if inner.kind != S_SELECT && inner.kind != S_UPDATE && inner.kind != S_DELETE {
                return Err(lexdb_base.err("0A000", "EXPLAIN takes SELECT, UPDATE or DELETE"))
            }
            append(mut &s.inner, inner)
            return Ok(s)
        }
        "drop" {
            if p.acceptKw("view") {
                var v = newStmt(S_DROP_VIEW)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    v.ifFlag = true
                }
                while true {
                    append(mut &v.cols, colDef(try p.rname(), TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
                    if !p.acceptKw(",") { break }
                }
                if p.acceptKw("cascade") { v.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(v)
            }
            if p.acceptKw("role") || p.acceptKw("user") {
                var r = newStmt(S_DROP_ROLE)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    r.ifFlag = true
                }
                append(mut &r.cols, colDef(try p.name(), TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
                while p.acceptKw(",") {
                    append(mut &r.cols, colDef(try p.name(), TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
                }
                return Ok(r)
            }
            if p.acceptKw("index") {
                var s = newStmt(S_DROP_INDEX)
                s.conc = p.acceptKw("concurrently")
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.index = try p.qname()
                return Ok(s)
            }
            if p.acceptKw("type") {
                var s = newStmt(S_DROP_TYPE)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.table = try p.qname()
                while p.acceptKw(",") { append(mut &s.names, try p.qname()) }
                if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(s)
            }
            if p.acceptKw("sequence") {
                var s = newStmt(S_DROP_SEQ)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.table = try p.qname()
                if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(s)
            }
            if p.acceptKw("schema") {
                var s = newStmt(S_DROP_SCHEMA)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.table = try p.name()
                if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(s)
            }
            try p.expectKw("table")
            var s = newStmt(S_DROP)
            if p.acceptKw("if") {
                try p.expectKw("exists")
                s.ifFlag = true
            }
            s.table = try p.rname()
            // DROP TABLE a, b, ...: the others in names (9.88)
            while p.acceptKw(",") { append(mut &s.names, try p.rname()) }
            if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
            return Ok(s)
        }
        "begin", "start" {
            if t.text == "start" { try p.expectKw("transaction") } else {
                let a = p.acceptKw("transaction") || p.acceptKw("work")
            }
            // READ ONLY makes a snapshot; ISOLATION LEVEL and the rest are
            // accepted (read-write blocks are serializable).
            var b = newStmt(S_BEGIN)
            while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") {
                if p.acceptKw("read") {
                    if p.acceptKw("only") { b.ifFlag = true } else { let wr = p.acceptKw("write") }
                } else {
                    p.pos += 1
                }
            }
            return Ok(b)
        }
        "commit", "end" {
            let a = p.acceptKw("transaction") || p.acceptKw("work")
            return Ok(newStmt(S_COMMIT))
        }
        "rollback", "abort" {
            let a = p.acceptKw("transaction") || p.acceptKw("work")
            if t.text == "rollback" && p.acceptKw("to") {
                let sp = p.acceptKw("savepoint")
                var r = newStmt(S_ROLLBACK_TO)
                r.table = try p.name()
                return Ok(r)
            }
            return Ok(newStmt(S_ROLLBACK))
        }
        "savepoint" {
            var r = newStmt(S_SAVEPOINT)
            r.table = try p.name()
            return Ok(r)
        }
        "release" {
            let sp = p.acceptKw("savepoint")
            var r = newStmt(S_RELEASE)
            r.table = try p.name()
            return Ok(r)
        }
        "grant", "revoke" { return p.grantStmt(t.text == "grant") }
        "show" {
            var st = newStmt(S_SHOW)
            if p.acceptKw("all") { st.table = "all" } else {
                st.table = try p.name()
                if p.acceptKw(".") { st.table = st.table + "." + (try p.name()) }   // a custom setting (9.92)
            }
            if st.table == "transaction" { st.table = "transaction_isolation" }   // SHOW TRANSACTION ISOLATION LEVEL
            if st.table == "time" && p.acceptKw("zone") { st.table = "timezone" }  // SHOW TIME ZONE
            p.skipToEnd()
            return Ok(st)
        }
        "set", "reset", "discard", "deallocate" {
            // lexdb's own settings (SETTINGS): SET name = value | TO value |
            // = DEFAULT, RESET name, RESET ALL; the rest are accepted and ignored
            var st = newStmt(S_SET)
            st.ifFlag = t.text == "reset"
            if t.text == "discard" {
                // DISCARD ALL | TEMP | TEMPORARY | PLANS | SEQUENCES (9.96): table
                // "discard:" and what
                let w = p.next()
                if w.kind != T_IDENT || (w.text != "all" && w.text != "temp" && w.text != "temporary" && w.text != "plans" && w.text != "sequences") {
                    return Err(near(&w))
                }
                st.table = "discard:" + (if w.text == "temporary" { "temp" } else { w.text })
                return Ok(st)
            }
            let u = p.acceptKw("session")
            if t.text == "reset" && p.acceptKw("all") {
                st.table = "all"
                return Ok(st)
            }
            // SET [SESSION | LOCAL] TIME ZONE value | LOCAL | DEFAULT, SET [SESSION | LOCAL]
            // timezone = | TO value | DEFAULT, RESET timezone, RESET TIME ZONE (9.95):
            // table "timezone", the value in names ("\x01": the default), then "local"
            var tzAt = p.pos
            let tzLocal = t.text == "set" && p.isKw("local")
            if tzLocal { tzAt += 1 }
            let tzWords = p.toks[tzAt].kind == T_IDENT && p.toks[tzAt].text == "time" && p.toks[tzAt + 1].kind == T_IDENT &&
                          p.toks[tzAt + 1].text == "zone"
            if (t.text == "set" || t.text == "reset") &&
               (tzWords || ((p.toks[tzAt].kind == T_IDENT || p.toks[tzAt].kind == T_QIDENT) && strings.toLowerAscii(p.toks[tzAt].text) == "timezone")) {
                p.pos = tzAt + (if tzWords { 2 } else { 1 })
                st.table = "timezone"
                if t.text == "reset" { return Ok(st) }
                if !tzWords && !p.acceptKw("to") { try p.expectKw("=") }
                append(mut &st.names, try p.zoneValue(tzWords))
                if tzLocal { append(mut &st.names, "local") }
                return Ok(st)
            }
            // SET [SESSION] ROLE name | NONE, RESET ROLE, SET SESSION AUTHORIZATION name |
            // DEFAULT, RESET SESSION AUTHORIZATION (9.83): the role in names, none for NONE and DEFAULT
            if p.isKw("role") || p.isKw("authorization") {
                st.table = if p.next().text == "role" { "role" } else { "session_authorization" }
                if t.text == "set" {
                    let eq = p.acceptKw("to") || p.acceptKw("=")
                    if !p.acceptKw("none") && !p.acceptKw("default") {
                        let v = p.peek()
                        if v.kind == T_STR { p.pos += 1; append(mut &st.names, v.text) } else { append(mut &st.names, try p.name()) }
                    }
                }
                return Ok(st)
            }
            // SET CONSTRAINTS ALL | name, ... DEFERRED | IMMEDIATE (9.85):
            // table "constraints:deferred" or ":immediate", the names in
            // names (none for ALL)
            if t.text == "set" && p.acceptKw("constraints") {
                if !p.acceptKw("all") {
                    append(mut &st.names, try p.qname())
                    while p.acceptKw(",") { append(mut &st.names, try p.qname()) }
                }
                if p.acceptKw("deferred") { st.table = "constraints:deferred" } else {
                    try p.expectKw("immediate")
                    st.table = "constraints:immediate"
                }
                return Ok(st)
            }
            if t.text == "set" && p.acceptKw("schema") {
                // SET SCHEMA 'x': the search path x
                st.table = "search_path"
                let v = p.peek()
                if v.kind == T_STR { p.pos += 1; append(mut &st.names, v.text) } else { append(mut &st.names, try p.name()) }
                return Ok(st)
            }
            var known = false
            for name in SETTINGS { if p.isKw(name) { known = true } }
            if known && (t.text == "set" || t.text == "reset") {
                st.table = p.toks[p.pos].text
                p.pos += 1
                if t.text == "set" && st.table == "search_path" {
                    // a list of schemas, names or strings ('a, b' splits too); DEFAULT
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    if p.acceptKw("default") { return Ok(st) }
                    while true {
                        let v = p.peek()
                        if v.kind == T_STR {
                            p.pos += 1
                            for part in strings.split(&v.text, ",") {
                                var x = strings.trim(part)
                                if len(x) >= 2 && x[0] == '"' && x[len(x) - 1] == '"' { x = x[1..len(x) - 1] }
                                if len(x) > 0 { append(mut &st.names, x) }
                            }
                        } else {
                            append(mut &st.names, try p.name())
                        }
                        if !p.acceptKw(",") { break }
                    }
                    if len(st.names) == 0 { return Err(lexdb_base.err("22023", "search_path names no schema")) }
                    return Ok(st)
                }
                if t.text == "set" && (st.table == "lexdb_batch" || st.table == "lexdb_planner") {
                    // lexdb_batch: on, off, true, false, 1, 0, a string of one of
                    // them, DEFAULT; lexdb_planner: cost, rules (optimizer 20), a word or a string
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    let v = p.peek()
                    if v.kind == T_EOF { return Err(near(&v)) }
                    p.pos += 1
                    if v.text != "default" { st.limit = Some(Expr.Lit(Val.Text(v.text))) }
                    return Ok(st)
                }
                if t.text == "set" {
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    if p.acceptKw("default") { st.limit = None } else { st.limit = Some(try p.expr()) }
                }
                return Ok(st)
            }
            // a custom setting, a dot in its name (9.92): SET [LOCAL] a.b = value | TO value
            // | DEFAULT, RESET a.b: the name in table, the value in names (then
            // "local")
            var at = p.pos
            let local = t.text == "set" && p.isKw("local")
            if local { at += 1 }
            if (t.text == "set" || t.text == "reset") && (p.toks[at].kind == T_IDENT || p.toks[at].kind == T_QIDENT) &&
               p.toks[at + 1].kind == T_OP && p.toks[at + 1].text == "." && (p.toks[at + 2].kind == T_IDENT || p.toks[at + 2].kind == T_QIDENT) {
                p.pos = at + 3
                st.table = p.toks[at].text + "." + p.toks[at + 2].text
                if t.text == "reset" { return Ok(st) }
                if !p.acceptKw("to") { try p.expectKw("=") }
                if p.acceptKw("default") {
                    st.ifFlag = true
                    return Ok(st)
                }
                var vals: []str = []
                while true {
                    let v = p.next()
                    if v.kind == T_EOF || (v.kind == T_OP && v.text != "-") { return Err(near(&v)) }
                    if v.kind == T_OP {
                        let w = p.next()
                        append(mut &vals, "-" + w.text)
                    } else {
                        append(mut &vals, v.text)
                    }
                    if !p.acceptKw(",") { break }
                }
                append(mut &st.names, strings.join(&vals, ", "))
                if local { append(mut &st.names, "local") }
                return Ok(st)
            }
            p.skipToEnd()
            return Ok(st)
        }
        else {}
    }
    return Err(near(&t))
}

// SET TIME ZONE's value (9.95): a string, a name, a number (an offset in
// hours: "-5"), INTERVAL '...' [unit [TO unit]] ("INTERVAL '...'", a bare
// number given its unit), DEFAULT; LOCAL after TIME ZONE. "\x01": the
// default.
fn (p: mut &P) zoneValue(words: bool): Result[str, lexdb_base.DbErr] {
    if p.acceptKw("default") || (words && p.acceptKw("local")) { return Ok("\x01") }
    if p.acceptKw("interval") {
        let v = p.next()
        if v.kind != T_STR { return Err(near(&v)) }
        var body = v.text
        var unit = ""
        for u in ["year", "month", "day", "hour", "minute", "second"] { if unit == "" && p.acceptKw(u) { unit = u } }
        var last = unit
        if unit != "" && p.acceptKw("to") {
            let u2 = p.next()
            if u2.kind != T_IDENT { return Err(near(&u2)) }
            last = u2.text
        }
        var bare = len(body) > 0
        for i in 0..len(body) { if !((body[i] >= '0' && body[i] <= '9') || body[i] == '.' || body[i] == '-' || body[i] == '+' || body[i] == ' ') { bare = false } }
        if bare && unit != "" { body = body + " " + unit }
        // the qualifier's last unit cuts what is below it (HOUR TO MINUTE: no seconds)
        return Ok("INTERVAL '" + body + "'" + (if last == "hour" || last == "minute" { " " + last } else { "" }))
    }
    let v = p.next()
    if v.kind == T_STR || v.kind == T_IDENT || v.kind == T_QIDENT || v.kind == T_NUM { return Ok(v.text) }
    if v.kind == T_OP && (v.text == "-" || v.text == "+") {
        let n = p.next()
        if n.kind != T_NUM { return Err(near(&n)) }
        return Ok(v.text + n.text)
    }
    return Err(near(&v))
}

// Skips the rest of a statement (the options of BEGIN, a SET's value).
fn (p: mut &P) skipToEnd() {
    while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") { p.pos += 1 }
}

// Parses SQL text into its statements (separated by ;). params is the
// highest $n in each.
pub fn parse(sql: &str): Result[[]Stmt, lexdb_base.DbErr] {
    let toks = try lex(sql)
    var p = P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0, seqs: [], wins: [], src: sql.toStr(), tsql: false, vars: [], spelled: ""}
    var out: []Stmt = []
    while true {
        p.params = 0
        p.subs = []
        p.ctes = []
        p.nextCte = 0
        p.inCte = []
        p.depth = 0
        p.seqs = []
        p.wins = []
        var s = try p.statement()
        s.params = p.params
        s.seqNames = replace(mut &p.seqs, [])
        if s.kind != S_EXPLAIN {
            s.subs = replace(mut &p.subs, [])
            s.wins = replace(mut &p.wins, [])
        }
        let t = p.peek()
        if t.kind == T_EOF {
            if s.kind != S_EMPTY || len(out) == 0 { append(mut &out, s) }
            break
        }
        if t.kind == T_OP && t.text == ";" {
            p.pos += 1
            if s.kind != S_EMPTY { append(mut &out, s) }
            continue
        }
        return Err(near(&t))
    }
    return Ok(out)
}

// ---- expressions as text: a filtered index's predicate is kept in the
// catalog so, and parsed again when the table is read.

pub fn typeText(t: &TypeName): str {
    if t.kind == K_ARRAY {
        let e = elemOid(t.oid)
        let k = if e == OID_BOOL { K_BOOL } else if e == OID_NUMERIC { K_NUM } else if e == OID_INT2 || e == OID_INT4 || e == OID_INT8 { K_INT } else if timeKind(e) > 0 { timeKind(e) } else if e == OID_UUID { K_UUID } else if e == OID_BYTEA { K_BYTEA } else if e == OID_FLOAT4 || e == OID_FLOAT8 { K_FLOAT } else if e == OID_OID { K_INT } else if e == OID_REGCLASS || e == OID_REGTYPE { K_REG } else { K_TEXT }
        return typeText(&TypeName{kind: k, oid: e, prec: 0, scale: 0, len: 0}) + "[]"
    }
    if t.oid == OID_INT2 { return "smallint" }
    if t.oid == OID_INT4 { return "integer" }
    if t.oid == OID_INT8 { return "bigint" }
    if t.oid == OID_BOOL { return "boolean" }
    if t.kind == K_NUM {
        if t.prec > 0 { return "numeric(" + t.prec.toStr() + ", " + t.scale.toStr() + ")" }
        return "numeric"
    }
    if t.oid == OID_VARCHAR {
        if t.len > 0 { return "varchar(" + t.len.toStr() + ")" }
        return "varchar"
    }
    if t.oid == OID_BPCHAR {
        if t.len > 0 { return "character(" + t.len.toStr() + ")" }
        return "bpchar"
    }
    let p = if t.prec == 1 { "(" + t.scale.toStr() + ")" } else { "" }
    if t.oid == OID_DATE { return "date" }
    if t.oid == OID_UUID { return "uuid" }
    if t.oid == OID_FLOAT4 { return "real" }
    if t.oid == OID_OID { return "oid" }
    if t.oid == OID_NAME { return "name" }
    if t.oid == OID_CHAR { return "\"char\"" }
    if t.oid == OID_REGCLASS { return "regclass" }
    if t.oid == OID_REGTYPE { return "regtype" }
    if t.oid == OID_REGNAMESPACE { return "regnamespace" }
    if t.oid == OID_REGPROC { return "regproc" }
    if t.oid == OID_FLOAT8 { return "double precision" }
    if t.oid == OID_BYTEA { return "bytea" }
    if t.oid == OID_TIME { return "time" + p + " without time zone" }
    if t.oid == OID_TS { return "timestamp" + p + " without time zone" }
    if t.oid == OID_TSTZ { return "timestamp" + p + " with time zone" }
    if t.oid == OID_IVAL { return "interval" + p }
    return "text"
}

fn quoteIdent(n: &str): str { return "\"" + strings.replaceAll(n, "\"", "\"\"") + "\"" }

// SQL text that parses back to x.
// x op ANY (array), x op ALL (array): the call's name, "any =", "all <>".
pub fn isQuant(n: &str): bool { return strings.startsWith(n, "any ") || strings.startsWith(n, "all ") }

pub fn exprText(x: &Expr): str {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Null { return "null" }
                Val.Int(n) { return n.toStr() }
                Val.Bool(b) { return if b { "true" } else { "false" } }
                Val.Num(d) {
                    // a point kept: read back, 2.0 stays numeric, not an integer (9.89)
                    let c = d.canonical()
                    return if strings.contains(&c, ".") || strings.contains(&c, "e") || strings.contains(&c, "E") { c } else { c + ".0" }
                }
                Val.Text(t) { return "'" + strings.replaceAll(t, "'", "''") + "'" }
                Val.Date(d) { return "'" + lexdb_time.fmtDate(d) + "'::date" }
                Val.Time(u) { return "'" + lexdb_time.fmtTime(u) + "'::time" }
                Val.Ts(u) { return "'" + lexdb_time.fmtTs(u) + "'::timestamp" }
                Val.Tstz(u) { return "'" + lexdb_time.fmtTstz(u, &lexdb_time.utc()) + "'::timestamptz" }
                Val.Ival(iv) { return "'" + lexdb_time.fmtIval(&iv) + "'::interval" }
                Val.Uuid(u) { return "'" + u + "'::uuid" }
                Val.Bytes(b) { return "'" + bytesHex(&b) + "'::bytea" }
                Val.Float(fx) { return "'" + lexdb_float.fmt8(fx) + "'::double precision" }
                Val.Real(fx) { return "'" + lexdb_float.fmt4(fx) + "'::real" }
                Val.Reg(o, _) { return o.toStr() }
            }
        }
        Expr.Param(n) { return "$" + n.toStr() }
        Expr.Col(n) {
            let d = strings.indexOf(n, ".", 0)
            if d < 0 { return quoteIdent(&n) }
            return quoteIdent(&n[0..d]) + "." + quoteIdent(&n[d + 1..len(n)])
        }
        Expr.Unary(op, a) { return "(" + op + " " + exprText(&a) + ")" }
        Expr.Bin(op, a, b) { return "(" + exprText(&a) + " " + op + " " + exprText(&b) + ")" }
        Expr.IsNull(a, neg) { return "(" + exprText(&a) + (if neg { " is not null)" } else { " is null)" }) }
        Expr.Cast(a, t) { return "cast(" + exprText(&a) + " as " + typeText(&t) + ")" }
        Expr.Call(n, args, star) {
            if n == "#sub" || n == "#exists" || n == "#in" {
                // a subquery: by its number, from 1
                var i = 0
                match args[0] { Expr.Lit(v) { match v { Val.Int(k) { i = k } else {} } } else {} }
                let sq = "(subquery " + (i + 1).toStr() + ")"
                if n == "#sub" { return sq }
                if n == "#exists" { return "(exists " + sq + ")" }
                let at = if len(args) > 3 { 3 } else { 1 }
                return "(" + exprText(&args[at]) + " in " + sq + ")"
            }
            if n == "like" || n == "ilike" || n == "similar" {
                var out = "(" + exprText(&args[0]) + " " + (if n == "similar" { "similar to" } else { n }) + " " + exprText(&args[1])
                if len(args) > 2 { out = out + " escape " + exprText(&args[2]) }
                return out + ")"
            }
            if n == "in" {
                var parts: []str = []
                for i in 1..len(args) { append(mut &parts, exprText(&args[i])) }
                return "(" + exprText(&args[0]) + " in (" + strings.join(&parts, ", ") + "))"
            }
            if n == "distinct from" { return "(" + exprText(&args[0]) + " is distinct from " + exprText(&args[1]) + ")" }
            // the date and time keywords, read back without "()" (9.95)
            if len(args) == 0 && (n == "current_date" || n == "current_timestamp" || n == "localtimestamp" || n == "current_time" || n == "localtime") { return n }
            if (n == "~" || n == "!~" || n == "~*" || n == "!~*" || n == "@>" || n == "<@" || n == "&&") && len(args) == 2 {
                return "(" + exprText(&args[0]) + " " + n + " " + exprText(&args[1]) + ")"
            }
            if n == "position" && len(args) == 2 { return "position(" + exprText(&args[1]) + " in " + exprText(&args[0]) + ")" }
            if isQuant(&n) {
                let sp = strings.indexOf(n, " ", 0)
                return "(" + exprText(&args[0]) + " " + n[sp + 1..len(n)] + " " + n[0..sp] + " (" + exprText(&args[1]) + "))"
            }
            if n == "case" || n == "case else" {
                var out = "(case"
                var i = 0
                while i + 1 < len(args) {
                    out = out + " when " + exprText(&args[i]) + " then " + exprText(&args[i + 1])
                    i += 2
                }
                if n == "case else" { out = out + " else " + exprText(&args[len(args) - 1]) }
                return out + " end)"
            }
            // modifiers in the name: "string_agg distinct order:ad filter"
            let words = strings.split(&n, " ")
            let base = words[0].toStr()
            let distinct = strings.contains(n, " distinct")
            let filtered = strings.contains(n, " filter")
            var dirs = ""
            for w in words { if strings.startsWith(w, "order:") { dirs = w[6..len(w)] } }
            var parts: []str = []
            let last = if filtered { len(args) - 1 } else { len(args) }
            let keysAt = last - len(dirs)
            for i in 0..keysAt { append(mut &parts, exprText(&args[i])) }
            var ord = ""
            if len(dirs) > 0 {
                var ks: []str = []
                for k in 0..len(dirs) {
                    let d = dirs[k]
                    let how = if d == 'A' { " nulls first" } else if d == 'd' { " desc" } else if d == 'D' { " desc nulls last" } else { "" }
                    append(mut &ks, exprText(&args[keysAt + k]) + how)
                }
                ord = " order by " + strings.join(&ks, ", ")
            }
            var out = if star { base + "(*)" } else { base + "(" + (if distinct { "distinct " } else { "" }) + strings.join(&parts, ", ") + ord + ")" }
            if filtered { out = out + " filter (where " + exprText(&args[len(args) - 1]) + ")" }
            return out
        }
    }
}

// One expression and nothing after it.
pub fn parseExpr(sql: &str): Result[Expr, lexdb_base.DbErr] {
    let toks = try lex(sql)
    var p = P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0, seqs: [], wins: [], src: sql.toStr(), tsql: false, vars: [], spelled: ""}
    let x = try p.expr()
    let t = p.peek()
    if t.kind != T_EOF { return Err(near(&t)) }
    return Ok(x)
}


// ---- T-SQL (design/lexdb-tds.md) inside lexdb's grammar: @variables and
// SQL Server's type names. A batch's own statements (DECLARE, SET, BEGIN
// TRAN, ...) are lexdb_tsqlparse's.

// @name: $k for the k-th variable in scope; SQL Server's error for one not declared.
fn (p: mut &P) variable(t: &Tok): Result[Expr, lexdb_base.DbErr] {
    for k in 0..len(p.vars) {
        if p.vars[k] == t.text {
            if k + 1 > p.params { p.params = k + 1 }
            return Ok(Expr.Param(k + 1))
        }
    }
    if strings.startsWith(t.text, "@@") { return Err(lexdb_base.err("TS195", "'" + t.text + "' is not a recognized built-in function name.")) }
    return Err(lexdb_base.err("TS137", "Must declare the scalar variable \"" + t.text + "\"."))
}

// (n) or (max) after a type name: n, 0 for max, -1 when there is none.
fn (p: mut &P) tsqlLen(): Result[int, lexdb_base.DbErr] {
    if !p.acceptKw("(") { return Ok(-1) }
    var n = 0
    if !p.acceptKw("max") { n = try p.intLit() }
    if p.acceptKw(",") { let x = try p.intLit() }
    try p.expectKw(")")
    return Ok(n)
}

// SQL Server's type names as lexdb's types; None for a name both share or
// lexdb's own. Lengths are kept for varchar; (max) is text.
fn (p: mut &P) tsqlType(w: &str): Result[Option[TypeName], lexdb_base.DbErr] {
    match w.toStr() {
        "nvarchar", "varchar", "nchar", "char", "sysname" {
            var n = try p.tsqlLen()
            if w == "sysname" { n = 128 }
            if n > 0 { return Ok(Some(TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: n})) }
            return Ok(Some(TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}))
        }
        "ntext", "xml" { return Ok(Some(TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0})) }
        "bit" { return Ok(Some(TypeName{kind: K_BOOL, oid: OID_BOOL, prec: 0, scale: 0, len: 0})) }
        "tinyint" { return Ok(Some(TypeName{kind: K_INT, oid: OID_INT2, prec: 0, scale: 0, len: 0})) }
        "money" { return Ok(Some(TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 19, scale: 4, len: 0})) }
        "smallmoney" { return Ok(Some(TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 10, scale: 4, len: 0})) }
        "uniqueidentifier" { return Ok(Some(TypeName{kind: K_UUID, oid: OID_UUID, prec: 0, scale: 0, len: 0})) }
        "varbinary", "binary", "image", "rowversion", "timestamp" {
            let n = try p.tsqlLen()
            return Ok(Some(TypeName{kind: K_BYTEA, oid: OID_BYTEA, prec: 0, scale: 0, len: 0}))
        }
        "datetime", "smalldatetime", "datetime2", "datetimeoffset", "time" {
            let oid = if w == "datetimeoffset" { OID_TSTZ } else if w == "time" { OID_TIME } else { OID_TS }
            var t = timeType(oid)
            var n = if w == "datetime" { 3 } else if w == "smalldatetime" { 0 } else { 7 }
            if w != "datetime" && w != "smalldatetime" && p.acceptKw("(") {
                n = try p.intLit()
                if n < 0 || n > 7 { return Err(lexdb_base.err("TS1002", "Line 1: Specified scale " + n.toStr() + " is invalid.")) }
                try p.expectKw(")")
            }
            t.prec = 1
            t.scale = min(n, 6)              // lexdb keeps microseconds
            return Ok(Some(t))
        }
        else { return Ok(None) }
    }
}


// ---- a cursor over T-SQL text, for lexdb_tsqlparse (which reads a batch's
// own statements: DECLARE, SET, transaction control, and later IF, WHILE,
// TRY ... CATCH, procedures). Every other statement, and every expression
// and type name, is lexdb's grammar here, read in T-SQL mode.

pub type Parser = record { p: P }

// A parser over sql read as T-SQL; vars: the variables in scope at its
// start ($1, $2, ... in that order).
pub fn tsqlParser(sql: &str, d: Dialect, vars: &[]str): Result[Parser, lexdb_base.DbErr] {
    var dt = d
    dt.tsql = true
    let toks = try lexIn(sql, dt)
    var given: []str = []
    for v in vars { append(mut &given, v) }
    return Ok(Parser{p: P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0, seqs: [], wins: [], src: sql.toStr(), tsql: true, vars: given, spelled: ""}})
}

pub fn (q: &Parser) peek(): Tok { return q.p.peek() }
pub fn (q: &Parser) peekAt(k: int): Tok { return q.p.peekAt(k) }
pub fn (q: mut &Parser) next(): Tok { return q.p.next() }
pub fn (q: mut &Parser) skip(n: int) { q.p.pos += n }
pub fn (q: &Parser) isKw(w: str): bool { return q.p.isKw(w) }
pub fn (q: mut &Parser) acceptKw(w: str): bool { return q.p.acceptKw(w) }
pub fn (q: mut &Parser) expectKw(w: str): Result[Unit, lexdb_base.DbErr] { return q.p.expectKw(w) }

// The syntax error for the next token.
pub fn (q: &Parser) unexpected(): lexdb_base.DbErr { return near(&q.p.peek()) }

// Starts a statement: the state gathered per statement (parameters,
// subqueries, ...) cleared.
pub fn (q: mut &Parser) fresh() { q.p.fresh() }

pub fn (q: mut &Parser) expr(): Result[Expr, lexdb_base.DbErr] { return q.p.expr() }
pub fn (q: mut &Parser) typeName(): Result[TypeName, lexdb_base.DbErr] { return q.p.typeName() }

// A variable's use: $k, or SQL Server's error for one not declared.
pub fn (q: mut &Parser) variable(t: &Tok): Result[Expr, lexdb_base.DbErr] { return q.p.variable(t) }

// One of lexdb's statements, whole.
pub fn (q: mut &Parser) statement(): Result[Stmt, lexdb_base.DbErr] {
    q.p.fresh()
    var s = try q.p.statement()
    q.p.finish(mut &s)
    return Ok(s)
}

// SELECT @v = e, as SET @v = e and DECLARE's initialiser are run; e parsed
// since the last fresh().
pub fn (q: mut &Parser) assign(v: &str, e: Expr): Stmt {
    var s = newStmt(S_SELECT)
    append(mut &s.items, SelItem{star: false, qual: "", expr: Some(e), alias: v.toStr(), spell: ""})
    append(mut &s.assign, v.toStr())
    q.p.finish(mut &s)
    return s
}

// Whether v is in scope; declare adds one.
pub fn (q: &Parser) hasVar(v: &str): bool {
    for x in q.p.vars { if x == v { return true } }
    return false
}
pub fn (q: mut &Parser) declare(v: &str) { append(mut &q.p.vars, v.toStr()) }
pub fn (q: mut &Parser) takeVars(): []str { return replace(mut &q.p.vars, []) }

// The per-statement state, fresh.
fn (p: mut &P) fresh() {
    p.params = 0
    p.subs = []
    p.ctes = []
    p.nextCte = 0
    p.inCte = []
    p.depth = 0
    p.seqs = []
    p.wins = []
}

// A statement's parts gathered while it was parsed, moved into it.
fn (p: mut &P) finish(s: mut &Stmt) {
    s.params = p.params
    s.seqNames = replace(mut &p.seqs, [])
    if s.kind != S_EXPLAIN {
        s.subs = replace(mut &p.subs, [])
        s.wins = replace(mut &p.wins, [])
    }
}
