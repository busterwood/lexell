// lexdb_access: how a relation is laid out in the store's trees
// (design/lexdb-layers.md 4.2). Its secret: a table's rows live in the
// tree of its primary key (the hidden row id's when it has none), their
// key its primary key's columns encoded so that byte order is SQL order,
// their value the row (lexdb_rows' codecs: column leaves at rest, a row
// with large values stored apart); a secondary index is a tree of its own
// whose entries are its columns (each after a NULL marker) then the
// primary key, the primary key the value.
//
// Above it, a relation is a Rel (a table's layout, lent by the catalog), a
// range of it a Scan made from bound values, and its rows come out as
// rows of values or as batches (lexdb_rows.Batch). Nothing above reads a
// key's bytes or a leaf.
import "binary"
import "strings"
import "math"
import "collections"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_rows"
import "./lexdb_store"
import "./lexdb_time"
import "./lexdb_sqlcoll"
import "./lexdb_like"
import "./lexdb_vec"

type Val = lexdb_sql.Val
type Expr = lexdb_sql.Expr
type DbErr = lexdb_base.DbErr
type FixedLay = lexdb_rows.FixedLay
type Batch = lexdb_rows.Batch
type BPlan = lexdb_rows.Projection

const BROWS: int = lexdb_rows.BROWS
const BK_INT: int = lexdb_rows.BK_INT
const BK_BOOL: int = lexdb_rows.BK_BOOL
const BK_VAL: int = lexdb_rows.BK_VAL
const PK_TEXT: byte = lexdb_rows.PK_TEXT
const FIXED: byte = lexdb_rows.FIXED

// The hidden row id column a table without a primary key has (its key).
pub const ROWID: str = "\x00rowid"

// A secondary index: its tree, and per part its table's column (-1: its
// expression's in exprs). The catalog's metadata (its name, a constraint's,
// how it is shown) travels with it.
pub type Index = record {
    pub name: str
    pub tree: int
    pub cols: []int
    pub unique: bool
    pub pred: Option[Expr]      // a filtered index: the rows it holds (column names bare)
    pub con: bool               // a UNIQUE constraint's (9.39): dropped with the constraint, not by DROP INDEX
    pub opts: []str             // per column, its options as shown (opclass, DESC, NULLS ...: 9.85); [] none
    // per column, an expression's (9.89): where cols holds -1, its value is
    // exprs' (column names bare); [] none
    pub exprs: []Expr
}

// A relation as it is laid out: its table's trees, columns, primary key,
// indexes and row layouts (lexdb_catalog.relOf lends them from its Table).
pub type Rel = value record {
    pub name: &str
    pub tree: int
    pub cols: &[]lexdb_sql.ColDef
    pub pk: &[]int
    pub indexes: &[]Index
    pub slots: &[]int           // where each column is in a stored row ([] column i at i)
    pub width: int              // the places a row has, with slots
    pub layouts: &[][]byte
    pub lays: &[]FixedLay
}

fn isNull(v: &Val): bool {
    match v {
        Val.Null { return true }
        else { return false }
    }
}

// The places a stored row has: its table's columns, and dropped ones.
pub fn rowWidth(t: &Rel): int { return if len(t.slots) == 0 { len(t.cols) } else { t.width } }

pub fn rowsFor(t: &Rel): lexdb_rows.Rows {
    return lexdb_rows.Rows{layouts: t.layouts, cols: t.cols, slots: t.slots, width: rowWidth(t), lays: t.lays}
}

// ---- keys: a value in byte order = SQL order

pub fn encKeyPart(b: mut &str, v: &Val) {
    match v {
        Val.Int(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Date(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Time(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Ts(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Tstz(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Ival(iv) {
            // as PostgreSQL compares intervals: a month as 30 days, then the time of day left
            let k = lexdb_time.ivalKey(&iv)
            binary.addU64BE(b, k.days ^ (-9223372036854775807 - 1))
            binary.addU64BE(b, k.us ^ (-9223372036854775807 - 1))
        }
        Val.Bool(x) { b.addByte(if x { 1 } else { 0 }) }
        Val.Num(d) { encNum(b, &d) }
        Val.Text(s) { encBytesKey(b, &s) }
        Val.Uuid(u) { encBytesKey(b, &u) }       // its lowercase form sorts as its bytes do
        Val.Float(x) { binary.addU64BE(b, floatKey(x)) }
        Val.Real(x) { binary.addU64BE(b, floatKey(x)) }
        Val.Reg(o, _) { binary.addU64BE(b, o ^ (-9223372036854775807 - 1)) }
        Val.Bytes(x) { encBytesKey(b, &x) }
        else {}
    }
}

// encIdxPart of a text t (not NULL), from its bytes (no value made).
pub fn encIdxText(b: mut &str, t: &str) {
    b.addByte(1)
    encBytesKey(b, t)
}

// Bytes in key order: a 0 byte as 0 FF, the end as 0 0.
fn encBytesKey(b: mut &str, s: &str) {
    for i in 0..len(s) {
        b.addByte(s[i])
        if s[i] == 0 { b.addByte(0xFF) }
    }
    b.addByte(0)
    b.addByte(0)
}

// A numeric in key order: 0x80 zero; 0x81, the exponent of its leading
// digit, its digits, 00 positive; 0x7F and all of that complemented
// negative. Decimal is canonical (no trailing zero digits), so equal values
// have equal keys whatever their scale.
pub fn encNum(b: mut &str, d: &Decimal) {
    if d.isZero() {
        b.addByte(0x80)
        return
    }
    // trailing zeros dropped: equal values (1.5, 1.50) have one key
    var digs = d.coefficient().toStr()
    var nd = len(digs)
    while nd > 1 && digs[nd - 1] == '0' { nd -= 1 }
    let ex = len(digs) + d.exponent() + 0x40000000
    digs = digs[0..nd].clone()
    if d.isNeg() {
        b.addByte(0x7F)
        binary.addU32BE(b, 0x7FFFFFFF - ex)
        for i in 0..len(digs) { b.addByte(0xFF - digs[i]) }
        b.addByte(0xFF)
    } else {
        b.addByte(0x81)
        binary.addU32BE(b, ex)
        for i in 0..len(digs) { b.addByte(digs[i]) }
        b.addByte(0)
    }
}

// An index's key part: a marker first so that NULL has a place, last as
// PostgreSQL sorts it: 1 a value, 2 NULL.
pub fn encIdxPart(b: mut &str, v: &Val) {
    if isNull(v) {
        b.addByte(2)
        return
    }
    b.addByte(1)
    encKeyPart(b, v)
}

pub fn encPart(b: mut &str, v: &Val, index: bool) {
    if index { encIdxPart(b, v) } else { encKeyPart(b, v) }
}

// A float's key: its bits in an order that sorts as the values do, -0 as
// 0, every NaN as one, after +Infinity.
pub fn floatKey(x: float): int {
    let bits = if x.isNaN() { 0x7ff8000000000000 } else if x == 0.0f { 0 } else { math.bitsOf(x) }
    return if bits < 0 { ~bits } else { bits ^ (-9223372036854775807 - 1) }
}

// The key of a row: its primary key's values, in byte order = SQL order.
pub fn keyOf(t: &Rel, row: &[]Val): str {
    var b = ""
    for i in t.pk { encKeyPart(mut &b, &collKeyVal(&t.cols[i], &row[i])) }
    return b
}

// The collation kind of a column (L2): lexdb_sql.COLL_*, a text column's.
pub fn colCollKind(c: &lexdb_sql.ColDef): int {
    if c.typ.kind != lexdb_sql.K_TEXT || len(c.coll) == 0 { return lexdb_sql.COLL_EXACT }
    return lexdb_sql.collKind(&c.coll)
}

// A column's value as its keys hold it (L2): under a case-insensitive
// collation its ciKey, under SQL Server's others its trailing spaces
// dropped; else itself. The row holds the value.
pub fn collKeyVal(c: &lexdb_sql.ColDef, v: &Val): Val {
    let k = colCollKind(c)
    if k == lexdb_sql.COLL_EXACT { return v.clone() }
    match v {
        Val.Text(s) { return Val.Text(if k == lexdb_sql.COLL_CI { ciKey(&s) } else { padKey(&s) }) }
        else { return v.clone() }
    }
}

// The smallest string after every string that starts with s ("" when there
// is none: the end of the tree).
pub fn succ(s: &str): str {
    var bs = strToBytes(s)
    while len(bs) > 0 && bs[len(bs) - 1] == 0xFF { let x = pop(mut &bs) }
    if len(bs) == 0 { return "" }
    bs[len(bs) - 1] = bs[len(bs) - 1] + 1
    return strFromBytes(&bs)
}

// The smallest key after k.
pub fn after(k: &str): str {
    var b = ""
    b += &k
    b.addByte(0)
    return b
}

// ---- collations' keys (design/lexdb-tds.md L2)

// The key of a text under SQL Server's default collation (L2): equal for
// texts it holds equal, in its order, byte by byte. From lexdb_sqlcoll's
// table (generated from SQL Server): a combining mark after a letter
// composed with it where there is one letter for both; trailing spaces and
// ignored characters dropped; then each letter's primary weight (3 bytes;
// an expansion, as ae for ae's ligature, two), 0 0 0, each letter's
// secondary weight (its accent: 2 bytes; a combining mark left over adds
// to its letter's), and each hyphen-like mark: how many letters before it
// (2 bytes), its weight. Case is in none of them.
pub fn ciKey(s: &str): str {
    var cps: []int = []
    var i = 0
    while i < len(s) {
        let d = strings.decodeAt(&s, i)
        i += d.size
        let r = d.rune
        let n = len(cps)
        if n > 0 && collClass(collAt(r)) == 2 {
            let c = collCompose(cps[n - 1], r)
            if c >= 0 && collClass(collAt(c)) == 1 {
                cps[n - 1] = c
                continue
            }
        }
        append(mut &cps, r)
    }
    while len(cps) > 0 && (cps[len(cps) - 1] == 32 || collClass(collAt(cps[len(cps) - 1])) == 0) { let x = pop(mut &cps) }
    var prim = ""
    var sec: []int = []
    var spec = ""
    for cp in cps {
        let v = collAt(cp)
        let k = collClass(v)
        if k == 0 { continue }
        if k == 2 {
            if len(sec) > 0 { sec[len(sec) - 1] += 1000 + (v & 0xFFFFFF) }
            continue
        }
        if k == 3 {
            binary.addU16BE(mut &spec, len(sec))
            spec.addByte(byte(v & 0xFF))
            continue
        }
        let e = collExpansion(cp)
        if e >= 0 {
            let at = int(lexdb_sqlcoll.EXP_AT[e])
            for j in 0..int(lexdb_sqlcoll.EXP_N[e]) {
                let el = int(lexdb_sqlcoll.EXP_EL[at + j])
                addU24(mut &prim, el >> 8)
                append(mut &sec, el & 0xFF)
            }
        } else if v < 0 {
            addU24(mut &prim, (1 << 20) + cp)       // not in the table: after all of it
            append(mut &sec, 0)
        } else {
            addU24(mut &prim, (v >> 8) & 0xFFFF)
            append(mut &sec, v & 0xFF)
        }
    }
    addU24(mut &prim, 0)
    for x in sec { binary.addU16BE(mut &prim, x + 1) }
    prim += &spec
    return prim
}

fn addU24(b: mut &str, x: int) {
    b.addByte(byte((x >> 16) & 0xFF))
    b.addByte(byte((x >> 8) & 0xFF))
    b.addByte(byte(x & 0xFF))
}

// A code point's value in lexdb_sqlcoll's table (kind << 24 | data), -1
// if it is in none of its runs.
fn collAt(cp: int): int {
    if cp >= 0 && cp < 128 { return int(lexdb_sqlcoll.ASCII[cp]) }
    var lo = 0
    var hi = len(lexdb_sqlcoll.RUN_START)
    while lo < hi {
        let m = (lo + hi) / 2
        if int(lexdb_sqlcoll.RUN_START[m]) <= cp { lo = m + 1 } else { hi = m }
    }
    let i = lo - 1
    if i < 0 { return -1 }
    let st = int(lexdb_sqlcoll.RUN_START[i])
    if cp >= st + int(lexdb_sqlcoll.RUN_LEN[i]) { return -1 }
    return int(lexdb_sqlcoll.RUN_VAL[i]) + (cp - st) * int(lexdb_sqlcoll.RUN_STEP[i])
}

// Its kind: 0 ignored, 1 a letter (one not in the table too), 2 a
// combining mark, 3 hyphen-like.
fn collClass(v: int): int { return if v < 0 { 1 } else { v >> 24 } }

// The letter a letter and a combining mark make, -1 none.
fn collCompose(base: int, mark: int): int {
    var lo = 0
    var hi = len(lexdb_sqlcoll.COMP_BASE)
    while lo < hi {
        let m = (lo + hi) / 2
        let b = int(lexdb_sqlcoll.COMP_BASE[m])
        let k = int(lexdb_sqlcoll.COMP_MARK[m])
        if b < base || (b == base && k < mark) { lo = m + 1 } else { hi = m }
    }
    if lo < len(lexdb_sqlcoll.COMP_BASE) && int(lexdb_sqlcoll.COMP_BASE[lo]) == base && int(lexdb_sqlcoll.COMP_MARK[lo]) == mark {
        return int(lexdb_sqlcoll.COMP_TO[lo])
    }
    return -1
}

// An expansion's number, -1 if cp is none.
fn collExpansion(cp: int): int {
    var lo = 0
    var hi = len(lexdb_sqlcoll.EXP_CP)
    while lo < hi {
        let m = (lo + hi) / 2
        if int(lexdb_sqlcoll.EXP_CP[m]) < cp { lo = m + 1 } else { hi = m }
    }
    if lo < len(lexdb_sqlcoll.EXP_CP) && int(lexdb_sqlcoll.EXP_CP[lo]) == cp { return lo }
    return -1
}

// A text's key under SQL Server's case-sensitive collations: its trailing
// spaces dropped.
pub fn padKey(s: &str): str {
    var end = len(s)
    while end > 0 && s[end - 1] == ' ' { end -= 1 }
    return s[0..end].toStr()
}

// ---- ranges

// A range of a relation's tree: the keys [lo, hi) of its primary key or
// an index ("" hi the end), one primary key, none, or the whole table.
pub type Scan = record {
    pub empty: bool     // a bound is NULL: no row can match
    pub point: bool     // one primary key (lo)
    lo: str
    hi: str
    pub whole: bool     // the whole table, in primary key order, whatever the path's index
}

// The lower bound of a scan: a point's key.
pub fn (sc: &Scan) lowKey(): str { return sc.lo.clone() }

// No row: a bound is NULL, or one its column cannot hold.
pub fn noScan(): Scan { return Scan{empty: true, point: false, lo: "", hi: "", whole: false} }

// The whole table in primary key order, whatever the path's index.
pub fn wholeScan(): Scan { return Scan{empty: false, point: false, lo: "", hi: "", whole: true} }

// Every entry of the path's tree: its index's, or the primary key's.
pub fn allScan(): Scan { return Scan{empty: false, point: false, lo: "", hi: "", whole: false} }

// Whether a and b cover the same keys [lo, hi).
pub fn sameRange(a: &Scan, b: &Scan): bool { return a.lo == b.lo && a.hi == b.hi }

pub fn (sc: &Scan) copy(): Scan { return Scan{empty: sc.empty, point: sc.point, lo: sc.lo.clone(), hi: sc.hi.clone(), whole: sc.whole} }

// The number of a primary key's columns (ix -1) or index ix's parts.
fn partCount(t: &Rel, ix: int): int { return if ix < 0 { len(t.pk) } else { len(t.indexes[ix].cols) } }

// The keys of index ix (-1 the primary key) whose leading parts equal eqs
// (bound to their columns' types, none NULL) and whose next part is at
// least each of los and at most each of his. Both are inclusive: a bound
// made its column's type may have been rounded, and every row is checked
// against the WHERE. Through an index, its NULLs of the next part are left
// out when it has bounds or noNulls. The whole primary key: one key.
pub fn rangeScan(t: &Rel, ix: int, eqs: &[]Val, los: &[]Val, his: &[]Val, noNulls: bool): Scan {
    let index = ix >= 0
    var prefix = ""
    for v in eqs { encPart(mut &prefix, &v, index) }
    let pre = prefix
    if !index && len(eqs) == partCount(t, ix) { return Scan{empty: false, point: true, lo: pre, hi: "", whole: false} }
    var lo = pre.clone()
    var hi = if len(pre) > 0 { succ(&pre) } else { "" }
    for v in los {
        var kb = ""
        kb += &pre
        encPart(mut &kb, &v, index)
        let kv = kb
        if kv > lo { lo = kv }
    }
    for v in his {
        var kb = ""
        kb += &pre
        encPart(mut &kb, &v, index)
        let s = succ(&(kb))
        if s != "" && (hi == "" || s < hi) { hi = s }
    }
    if index && (len(los) + len(his) > 0 || noNulls) {
        // an index's NULLs sort last (marker 2): no range includes them
        var nb = ""
        nb += &pre
        nb.addByte(2)
        let nk = nb
        if hi == "" || nk < hi { hi = nk }
    }
    return Scan{empty: false, point: false, lo: lo, hi: hi, whole: false}
}

// The keys of index ix (-1 the primary key) whose leading parts equal eqs
// and whose next part is one of vals (bound to its column's type; a NULL
// matches none), each once, in key order (backward when desc): a point
// each where that makes the whole primary key, else a range.
pub fn inScans(t: &Rel, ix: int, eqs: &[]Val, vals: &[]Val, desc: bool): []Scan {
    let index = ix >= 0
    var prefix = ""
    for v in eqs { encPart(mut &prefix, &v, index) }
    let pre = prefix
    var keys: []str = []
    for v in vals {
        if isNull(&v) { continue }
        var kb = ""
        kb += &pre
        encPart(mut &kb, &v, index)
        append(mut &keys, kb)
    }
    collections.sortBy(mut &keys, fn(a: &str, b: &str): int { return a.cmp(b) })
    let point = !index && len(eqs) + 1 == partCount(t, ix)
    var out: []Scan = []
    for i in 0..len(keys) {
        if i > 0 && keys[i] == keys[i - 1] { continue }
        if point { append(mut &out, Scan{empty: false, point: true, lo: keys[i].clone(), hi: "", whole: false}) } else {
            append(mut &out, Scan{empty: false, point: false, lo: keys[i].clone(), hi: succ(&keys[i]), whole: false})
        }
    }
    if desc {
        var rev: []Scan = []
        while len(out) > 0 { append(mut &rev, pop(mut &out)) }
        return rev
    }
    return out
}

// The keys of index ix (-1 the primary key) whose first n parts are row's
// values of their columns (as the keys hold them: collKeyVal), a range
// even when they make a whole primary key.
pub fn prefixScan(t: &Rel, ix: int, row: &[]Val, n: int): Scan {
    var b = ""
    if ix < 0 {
        for j in 0..n { encKeyPart(mut &b, &collKeyVal(&t.cols[t.pk[j]], &row[t.pk[j]])) }
    } else {
        let cs = &t.indexes[ix].cols
        for j in 0..n { encIdxPart(mut &b, &collKeyVal(&t.cols[cs[j]], &row[cs[j]])) }
    }
    let pre = b
    return Scan{empty: false, point: false, lo: pre, hi: succ(&pre), whole: false}
}

// A range's bounds after its leading equal parts, for many prefixes (a
// join's lookups per row: rangeOf): the next part's bounds encoded once.
pub type Tail = record {
    lo: []str
    hi: []str
    capNulls: bool
}

pub fn noTail(): Tail { return Tail{lo: [], hi: [], capNulls: false} }

// The bounds rangeScan puts on index ix's (-1 the primary key's) next part:
// at least each of los, at most each of his; capNulls: an index's NULLs
// left out.
pub fn tailOf(ix: int, los: &[]Val, his: &[]Val, capNulls: bool): Tail {
    var t = noTail()
    t.capNulls = capNulls
    for v in los {
        var kb = ""
        encPart(mut &kb, &v, ix >= 0)
        append(mut &t.lo, kb)
    }
    for v in his {
        var kb = ""
        encPart(mut &kb, &v, ix >= 0)
        append(mut &t.hi, kb)
    }
    return t
}

// Where a scan read in parts is: forward, the key to go on from; backward,
// the end (exclusive).
// want: the rows the next batch of a backward or point read takes (0: its
// first size); it doubles per batch up to BROWS, so a LIMIT reads little
// past its rows. pos: a lookup list's scans taken so far (fillRanges).
// An index range read in key order (optimizer 47: sorted): chunk, its
// entries' primary keys up to at, sorted (a counted handle: a copy of the
// cursor shares it), pos the next of them to read; at, the index's key to
// go on from after the chunk; tail, the range has no entries after it.
pub type Cursor = record { at: str; started: bool; pub done: bool; pub want: int; pub pos: int; pub sorted: bool; chunk: Option[rc []str]; tail: bool }

pub fn newCursor(): Cursor { return Cursor{at: "", started: false, done: false, want: 0, pos: 0, sorted: false, chunk: None, tail: false} }

pub fn (c: &Cursor) copy(): Cursor {
    return Cursor{at: c.at.clone(), started: c.started, done: c.done, want: c.want, pos: c.pos, sorted: c.sorted, chunk: c.chunk.clone(), tail: c.tail}
}

// The first batch size of a backward or point read, and the next one.
const FIRST_WANT = 32
fn nextWant(cur: mut &Cursor): int {
    if cur.want == 0 { cur.want = FIRST_WANT }
    let n = cur.want
    cur.want = min(BROWS, n * 2)
    return n
}

// The scans of a primary key path from key from on (a batched statement's resume): a point before it is dropped, a range starts
// at it at the latest, and the whole table is a range from it.
pub fn afterScans(scans: &[]Scan, from: &str): []Scan {
    var out: []Scan = []
    for sc in scans {
        if sc.empty { append(mut &out, Scan{empty: true, point: false, lo: "", hi: "", whole: false}); continue }
        if sc.point {
            if sc.lo >= from { append(mut &out, Scan{empty: false, point: true, lo: sc.lo.clone(), hi: "", whole: false}) }
            continue
        }
        var lo: str = if sc.whole { "" } else { sc.lo.clone() }
        let hi: &str = if sc.whole { "" } else { &sc.hi }
        if lo < from { lo = from.toStr() }
        if len(hi) > 0 && lo >= hi { continue }
        append(mut &out, Scan{empty: false, point: false, lo: lo, hi: hi.toStr(), whole: false})
    }
    return out
}

// ---- rows

// A row from a stored value as a Part read gives it: a large row from its
// first bytes when the columns used are all there, else read whole (9.31).
// n and need are of the row's places (rowWidth, placesNeeded); the values
// are the table's columns'.
pub fn rowOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, key: &str, v: &str, n: int,
         need: &[]bool, missing: &[]Val): Result[[]Val, DbErr] {
    let places = try placesOf(st, txn, t, key, v, n, need, missing)
    if len(t.slots) == 0 { return Ok(places) }
    var out: []Val = []
    for k in t.slots { append(mut &out, places[k].clone()) }
    return Ok(out)
}

// The values rows written before a column was added have for it, by
// place ([] when all are NULL).
pub fn placesMissing(t: &Rel): []Val { let r = rowsFor(t); return lexdb_rows.placesMissing(&r) }

pub fn placesNeeded(t: &Rel, need: &[]bool): []bool { let r = rowsFor(t); return lexdb_rows.placesNeeded(&r, need) }

fn placesOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, key: &str, v: &str, n: int,
            need: &[]bool, missing: &[]Val): Result[[]Val, DbErr] {
    match lexdb_rows.partOf(v) {
        Some(p) {
            if lexdb_rows.fitsIn(&p, n, need) { return lexdb_rows.decodeRowNeed(&p, n, need, missing, &t.lays) }
            let w = try st.whole(txn, t.tree, key, v)
            return lexdb_rows.decodeRowNeed(&w, n, need, missing, &t.lays)
        }
        None { return lexdb_rows.decodeRowNeed(v, n, need, missing, &t.lays) }
    }
}

pub const BATCH = 256

// How rows are read for the columns need marks (all: [], as fetch's need):
// their places, the values rows written before a column was added have
// for it, and whether in part (getPart: only some columns used).
pub type RowRead = record {
    n: int
    places: []bool
    missing: []Val
    part: bool
}

pub fn rowRead(t: &Rel, need: &[]bool): RowRead {
    return RowRead{n: rowWidth(t), places: placesNeeded(t, need), missing: placesMissing(t), part: len(need) > 0}
}

// The row of primary key key, as rr reads it; None: there is none.
pub fn getRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, rr: &RowRead, key: &str): Result[Option[[]Val], DbErr] {
    let got = if rr.part { try st.getPart(txn, t.tree, key) } else { try st.get(txn, t.tree, key) }
    match got {
        Some(v) { return Ok(Some(try rowOf(st, txn, t, key, &v, rr.n, &rr.places, &rr.missing))) }
        None { return Ok(None) }
    }
}

// Appends up to BATCH rows of a scan to out, from the cursor on. Rows are
// read in batches so that what is done with them (a join's lookups, an
// index's entries) can use the transaction between.
pub fn fetch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: int, desc: bool, sc: &Scan, need: &[]bool, cur: mut &Cursor,
         out: mut &[][]Val): Result[Unit, DbErr] {
    let n = rowWidth(t)
    let places = placesNeeded(t, need)
    let missing = placesMissing(t)
    // only some columns used: large rows are read in part (rowOf)
    let part = len(need) > 0
    if sc.empty {
        cur.done = true
        return Ok(Unit{})
    }
    if sc.point {
        cur.done = true
        let got = if part { try st.getPart(txn, t.tree, &sc.lo) } else { try st.get(txn, t.tree, &sc.lo) }
        match got {
            Some(v) { append(out, try rowOf(st, txn, t, &sc.lo, &v, n, &places, &missing)) }
            None {}
        }
        return Ok(Unit{})
    }
    // a range read in key order (optimizer 47), or one a batch began so
    if cur.sorted && ix >= 0 && !sc.whole && !desc { return fetchSorted(st, txn, t, ix, sc, need, cur, out) }
    let byIndex = ix >= 0 && !sc.whole
    let tree = if byIndex { t.indexes[ix].tree } else { t.tree }
    // an index whose entries hold every column used (a SELECT's: need
    // narrowed, 9.31): read alone, no row read (9.107)
    var alone = false
    var dec = IdxDec{cols: [], codes: [], marked: [], want: [], last: 0}
    if byIndex && len(need) > 0 {
        match idxDecOf(t, ix, need) {
            Some(d) {
                dec = d
                alone = true
            }
            None {}
        }
    }
    var vals: []str = []
    var keys: []str = []
    var last = ""
    let inPart = part && !byIndex
    if desc {
        // backward: the cursor is the exclusive end
        let to: &str = if cur.started { &cur.at } else { &sc.hi }
        cur.started = true
        if inPart {
            try st.scanBackPart(txn, tree, &sc.lo, to, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val.clone())
            append(mut &keys, en.key.clone())
            return len(vals) < BATCH
        })
        } else {
            try st.scanBack(txn, tree, &sc.lo, to, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val.clone())
            append(mut &keys, en.key.clone())
            return len(vals) < BATCH
        })
        }
        if len(keys) > 0 { last = keys[len(keys) - 1].clone() }      // (the batch's last key, once)
        if len(vals) < BATCH { cur.done = true } else { cur.at = last }
    } else {
        let from: &str = if cur.started { &cur.at } else { &sc.lo }
        cur.started = true
        if inPart {
            try st.scanPart(txn, tree, from, &sc.hi, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val.clone())
            append(mut &keys, en.key.clone())
            return len(vals) < BATCH
        })
        } else {
            try st.scan(txn, tree, from, &sc.hi, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val.clone())
            append(mut &keys, en.key.clone())
            return len(vals) < BATCH
        })
        }
        if len(keys) > 0 { last = keys[len(keys) - 1].clone() }      // (the batch's last key, once)
        if len(vals) < BATCH { cur.done = true } else { cur.at = after(&last) }
    }
    for k in 0..len(vals) {
        if !byIndex {
            append(out, try rowOf(st, txn, t, &keys[k], &vals[k], n, &places, &missing))
        } else if alone {
            append(out, try idxRow(t, &dec, &keys[k]))
        } else {
            let got = if part { try st.getPart(txn, t.tree, &vals[k]) } else { try st.get(txn, t.tree, &vals[k]) }
            match got {
                Some(rv) { append(out, try rowOf(st, txn, t, &vals[k], &rv, n, &places, &missing)) }
                None { return Err(lexdb_base.corrupt(&("an index entry of \"" + t.name + "\" without its row"))) }
            }
        }
    }
    return Ok(Unit{})
}

// ---- index entries read back (9.107)

const ID_INT = 1        // integers of each width: 8 bytes in key order (encKeyPart)
const ID_BOOL = 2
const ID_TEXT = 3       // text and varchar under no collation: its bytes, 0 as 0 FF, ended by 0 0
const ID_DATE = 4
const ID_TIME = 5
const ID_TS = 6
const ID_TSTZ = 7
const ID_UUID = 8
const ID_BYTES = 9

// How column c's values are kept in an index's key, when they can be read
// back as the row holds them: ID_*; 0 not. (A text under a collation is
// kept as its collation's key, a numeric without its scale, a float with
// -0 as 0, an interval as its days: not read back.)
fn idCode(c: &lexdb_sql.ColDef): int {
    let o = c.typ.oid
    let k = c.typ.kind
    if (o == lexdb_sql.OID_INT2 || o == lexdb_sql.OID_INT4 || o == lexdb_sql.OID_INT8) && k == lexdb_sql.K_INT { return ID_INT }
    if o == lexdb_sql.OID_BOOL && k == lexdb_sql.K_BOOL { return ID_BOOL }
    if (o == lexdb_sql.OID_TEXT || o == lexdb_sql.OID_VARCHAR) && k == lexdb_sql.K_TEXT && colCollKind(c) == lexdb_sql.COLL_EXACT { return ID_TEXT }
    if o == lexdb_sql.OID_DATE && k == lexdb_sql.K_DATE { return ID_DATE }
    if o == lexdb_sql.OID_TIME && k == lexdb_sql.K_TIME { return ID_TIME }
    if o == lexdb_sql.OID_TS && k == lexdb_sql.K_TS { return ID_TS }
    if o == lexdb_sql.OID_TSTZ && k == lexdb_sql.K_TSTZ { return ID_TSTZ }
    if o == lexdb_sql.OID_UUID && k == lexdb_sql.K_UUID { return ID_UUID }
    if o == lexdb_sql.OID_BYTEA && k == lexdb_sql.K_BYTEA { return ID_BYTES }
    return 0
}

// An index's entries decoded: per part of their keys (the index's columns,
// each after its marker, 1 a value and 2 NULL; then the primary key's,
// unmarked) the table's column, its code (idCode), and whether it is
// decoded (a column used, at its first part). Parts from last on are not
// read.
pub type IdxDec = record {
    pub cols: []int
    pub codes: []int
    pub marked: []bool
    pub want: []bool
    pub last: int
}

// How index ix of t's entries give the columns needCol; None: one of them
// is not in its entries, an index column is an expression's, or a part
// up to the last one used is not read back (idCode).
pub fn idxDecOf(t: &Rel, ix: int, needCol: &[]bool): Option[IdxDec] {
    let x = &t.indexes[ix]
    if len(t.pk) == 0 || len(needCol) != len(t.cols) { return None }
    var d = IdxDec{cols: [], codes: [], marked: [], want: [], last: 0}
    for c in x.cols {
        if c < 0 { return None }
        append(mut &d.cols, c)
        append(mut &d.codes, idCode(&t.cols[c]))
        append(mut &d.marked, true)
    }
    for c in t.pk {
        append(mut &d.cols, c)
        append(mut &d.codes, idCode(&t.cols[c]))
        append(mut &d.marked, false)
    }
    var have: []bool = array(len(t.cols), false)
    for p in 0..len(d.cols) {
        let c = d.cols[p]
        let w = needCol[c] && !have[c]
        append(mut &d.want, w)
        if w {
            have[c] = true
            d.last = p + 1
        }
    }
    for c in 0..len(t.cols) { if needCol[c] && !have[c] { return None } }
    for p in 0..d.last { if d.codes[p] == 0 { return None } }
    return Some(d)
}

// A value of an index key's part at at (after its marker), code's kind;
// at goes past it.
fn idVal(s: &str, at: mut &int, code: int): Val {
    if code == ID_BOOL {
        let x = s[at] == 1
        at += 1
        return Val.Bool(x)
    }
    if code == ID_TEXT || code == ID_UUID || code == ID_BYTES {
        let tx = idBytes(s, at)
        return if code == ID_TEXT { Val.Text(tx) } else if code == ID_UUID { Val.Uuid(tx) } else { Val.Bytes(tx) }
    }
    let n = binary.readI64BEStr(s, at) ^ (-9223372036854775807 - 1)
    at += 8
    if code == ID_DATE { return Val.Date(n) }
    if code == ID_TIME { return Val.Time(n) }
    if code == ID_TS { return Val.Ts(n) }
    if code == ID_TSTZ { return Val.Tstz(n) }
    return Val.Int(n)
}

// Bytes kept in key order (encBytesKey) at at: the value; at goes past
// their end.
fn idBytes(s: &str, at: mut &int): str {
    var i = at + 0
    while i + 1 < len(s) && !(s[i] == 0 && s[i + 1] != 0xFF) { i += if s[i] == 0 { 2 } else { 1 } }
    let raw = s[at..i]
    at = i + 2
    var esc = false
    for j in 0..len(raw) { if raw[j] == 0 { esc = true } }
    if !esc { return raw.clone() }
    var b = ""
    var j = 0
    while j < len(raw) {
        b.addByte(raw[j])
        j += if raw[j] == 0 { 2 } else { 1 }
    }
    return b
}

// Index entry key s decoded into row r of b (its parts dec.want); false: a
// value its column's batch does not hold, or not such an entry.
fn bIdxInto(s: &str, r: int, b: mut &Batch, bp: &BPlan, dec: &IdxDec): bool {
    var at = 0
    for p in 0..dec.last {
        if at >= len(s) { return false }
        let w = dec.want[p]
        let c = dec.cols[p]
        if dec.marked[p] {
            let m = s[at]
            at += 1
            if m == 2 {
                if w { b.cols[c].nul[r] = true }
                continue
            }
        }
        let code = dec.codes[p]
        if !w {
            let skip = idVal(s, mut &at, code)
            continue
        }
        let k = bp.kinds[c]
        if code == ID_INT && k == BK_INT {
            if at + 8 > len(s) { return false }
            b.cols[c].v[r] = ((int(s[at]) << 56) | (int(s[at + 1]) << 48) | (int(s[at + 2]) << 40) | (int(s[at + 3]) << 32) |
                              (int(s[at + 4]) << 24) | (int(s[at + 5]) << 16) | (int(s[at + 6]) << 8) | int(s[at + 7])) ^ (-9223372036854775807 - 1)
            at += 8
        } else if code == ID_BOOL && k == BK_BOOL {
            b.cols[c].v[r] = if s[at] == 1 { 1 } else { 0 }
            at += 1
        } else if k == BK_VAL {
            b.vals[c][r] = idVal(s, mut &at, code)
        } else if k == lexdb_rows.BK_TEXT {
            if !lexdb_rows.put(b, c, r, idVal(s, mut &at, code), k) { return false }
        } else {
            return false
        }
    }
    return true
}

// Index entry key s as a row of t's columns: those dec decodes, NULL the
// others (as a narrowed row reads them).
fn idxRow(t: &Rel, dec: &IdxDec, s: &str): Result[[]Val, DbErr] {
    var out: []Val = array(len(t.cols), Val.Null)
    var at = 0
    for p in 0..dec.last {
        if at >= len(s) { return Err(lexdb_base.corrupt(&("an index entry of \"" + t.name + "\""))) }
        if dec.marked[p] {
            let m = s[at]
            at += 1
            if m == 2 { continue }
        }
        let v = idVal(s, mut &at, dec.codes[p])
        if dec.want[p] { out[dec.cols[p]] = v }
    }
    return Ok(out)
}

// How the first level's batches read its table (bLevelPlan): ix -1 by
// its primary key (fillBatch); else through index ix, alone (only: its
// entries decoded by dec) or each entry's row read, backward when desc;
// byKeys: the rows of keys, its range's primary keys (the switch's count
// read them: firstSwitch), not the range read again.
pub type IxRead = record {
    pub ix: int
    pub only: bool
    pub dec: IdxDec
    pub desc: bool
    pub byKeys: bool
    pub keys: []str
    pub small: bool     // the read may stop early (a LIMIT): its batches start at 32 entries and double to BROWS (the cursor's want)
    pub sorted: bool    // its range's rows read in key order (optimizer 47: fillSorted), unless the reads are noted
}

pub fn noIxRead(): IxRead { return IxRead{ix: -1, only: false, dec: IdxDec{cols: [], codes: [], marked: [], want: [], last: 0}, desc: false, byKeys: false, keys: [], small: false, sorted: false} }

// The index entries the batch reads have taken (the tests: a LIMIT's first
// batch is 32 of them, not BROWS).
var idxTaken: int = 0
pub fn idxEntries(): int { return idxTaken }

// The entries the next batch of an index read takes: BROWS, or where the
// read may stop early the cursor's next size (32, doubling to BROWS).
fn idxWant(rd: &IxRead, cur: mut &Cursor): int {
    if rd.small { return nextWant(cur) }
    return BROWS
}

// ---- batches

// A row read whole by the row path (a value stored apart) into row r of b;
// false: a value of a kind its column's batch does not hold.
fn bRowOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, key: &str, v: &str, r: int, b: mut &Batch,
          bp: &BPlan): Result[bool, DbErr] {
    let row = try rowOf(st, txn, t, key, v, bp.width, &bp.needP, &bp.missing)
    for i in 0..len(bp.kinds) {
        if bp.needCol[i] && !lexdb_rows.put(b, i, r, row[i].clone(), bp.kinds[i]) { return Ok(false) }
    }
    return Ok(true)
}

// An empty range or a key lookup as a batch: a stored value read whole
// (a stub) is decoded by the row path. None: a value of a kind its
// column's batch does not hold.
fn fillPoint(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, sc: &Scan, part: bool,
             cur: mut &Cursor, bp: &BPlan): Result[Option[Batch], DbErr] {
    let rw = rowsFor(t)
    cur.done = true
    if sc.empty { return Ok(Some(lexdb_rows.newBatch(bp, 0))) }
    var b = lexdb_rows.newBatch(bp, 1)
    let got = if part { try st.getPart(txn, t.tree, &sc.lo) } else { try st.get(txn, t.tree, &sc.lo) }
    match got {
        Some(v) {
            let code = try lexdb_rows.decodeRow(&v, 0, mut &b, bp, &rw)
            if code == 1 { return Ok(None) }
            if code == 2 && !(try bRowOf(st, txn, t, &sc.lo, &v, 0, mut &b, bp)) { return Ok(None) }
            b.n = 1
        }
        None {}
    }
    return Ok(Some(b))
}

// The next batch of a scan, its rows decoded from the leaves in place
// (lexdb_store.scanLeaves: no entry copied out); None: a value of a kind
// its column's batch does not hold. A key lookup or an empty range goes
// through fillPoint; scanLeaves gives a replica's rows and the
// transaction's own writes and cuts as one path too. Its batch is spare's
// when that is of the plan (lexdb_rows.reuse), as fillPickIn's.
fn fillBatch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, sc: &Scan, part: bool, cur: mut &Cursor,
             bp: &BPlan, spare: mut &Batch): Result[Option[Batch], DbErr] {
    if sc.empty || sc.point { return fillPoint(st, txn, t, sc, part, cur, bp) }
    var b = lexdb_rows.reuse(spare, bp)
    let rw = rowsFor(t)
    while b.n < BROWS && !cur.done {
        let from: &str = if cur.started { &cur.at } else { &sc.lo }
        cur.started = true
        var stopKey = ""
        var stop = 0                // 1 the batch is full, 2 a value stored apart
        var bail = false
        var bad: []DbErr = []
        try st.scanLeaves(txn, t.tree, from, sc.hi.clone(), fn(leaf: &lexdb_rows.LeafView, i: int, j: int): bool {
            if len(bp.ranges) > 0 && leaf.isCols && lexdb_rows.excluded(leaf, bp, &rw) { return true }
            var k = i
            while k < j {
                if b.n == BROWS {
                    stop = 1
                    stopKey = lexdb_rows.leafKey(leaf, k)
                    return false
                }
                // a run of rows in one fixed layout: a column at a time
                match lexdb_rows.decodeRun(leaf, k, min(j, k + BROWS - b.n), mut &b, bp, &rw) {
                    Ok(got) {
                        if got < 0 {
                            bail = true
                            return false
                        }
                        if got > 0 {
                            b.n += got
                            k += got
                            continue
                        }
                    }
                    Err(x) {
                        append(mut &bad, x)
                        return false
                    }
                }
                match lexdb_rows.decodeRow(lexdb_rows.leafValAt(leaf, k), b.n, mut &b, bp, &rw) {
                    Ok(code) {
                        if code == 1 {
                            bail = true
                            return false
                        }
                        if code == 2 {
                            stop = 2
                            stopKey = lexdb_rows.leafKey(leaf, k)
                            return false
                        }
                    }
                    Err(x) {
                        append(mut &bad, x)
                        return false
                    }
                }
                b.n += 1
                k += 1
            }
            return true
        })
        if len(bad) > 0 { return Err(bad[0].clone()) }
        if bail { return Ok(None) }
                if stop == 1 {
            cur.at = stopKey
            return Ok(Some(b))
        }
        if stop == 2 {
            let got = if part { try st.getPart(txn, t.tree, &stopKey) } else { try st.get(txn, t.tree, &stopKey) }
            match got {
                Some(v) {
                    if !(try bRowOf(st, txn, t, &stopKey, &v, b.n, mut &b, bp)) { return Ok(None) }
                    b.n += 1
                }
                None {}
            }
            cur.at = after(&stopKey)
            continue
        }
        cur.done = true
    }
    return Ok(Some(b))
}

// The next batch of the first level, as rd reads it (fillBatch for the
// primary key, and for a scan of the whole table in an index's place;
// spare as fillBatch's).
pub fn fillLevel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, rd: &IxRead, sc: &Scan, part: bool, cur: mut &Cursor,
             bp: &BPlan, spare: mut &Batch): Result[Option[Batch], DbErr] {
    if rd.ix < 0 && rd.desc && !sc.empty && !sc.point { return fillBackBatch(st, txn, t, sc, part, cur, bp, spare) }
    if rd.ix < 0 || sc.whole { return fillBatch(st, txn, t, sc, part, cur, bp, spare) }
    if sc.empty {
        cur.done = true
        return Ok(Some(lexdb_rows.newBatch(bp, 0)))
    }
    if rd.only { return fillIdxOnly(st, txn, t, rd, sc, cur, bp) }
    if (rd.sorted || cur.sorted) && !rd.desc && !rd.byKeys && !txn.noting() { return fillSorted(st, txn, t, rd.ix, sc, part, cur, bp) }
    return fillIdxRows(st, txn, t, rd, sc, part, cur, bp)
}

// ---- an index range read in key order (optimizer 47)
//
// PostgreSQL's bitmap heap scan in lexdb's terms: the range's entries'
// primary keys are collected (a chunk of at most SORT_CHUNK), sorted, and
// the rows read by them in that order, so that the rows of a leaf are read
// together and the leaves in order. The cursor holds the chunk (Cursor);
// the batches (fillSorted) and the row path (fetchSorted) read from it
// alike, so a batch that gives way is read again by the row path from its
// first key.

// The keys a chunk holds at most (about 40 bytes each with their handles).
const SORT_CHUNK = 262144

var sortChunk: int = SORT_CHUNK

// The chunks' size (the tests: several chunks of a small table; 0 SORT_CHUNK).
pub fn setSortChunk(n: int) { sortChunk = if n > 0 { n } else { SORT_CHUNK } }

// The chunks of keys sorted (the tests).
var sortedChunkN: int = 0
pub fn sortedChunks(): int { return sortedChunkN }

// The cursor's chunk, the next one collected when it is read (none left:
// done): index ix's entries of sc from the cursor's place on, at most
// SORT_CHUNK, their primary keys sorted. cur.sorted is set.
fn sortedChunk(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: int, sc: &Scan, cur: mut &Cursor): Result[Unit, DbErr] {
    cur.sorted = true
    match &cur.chunk {
        Some(ks) { if cur.pos < len(ks) { return Ok(Unit{}) } }
        None {}
    }
    if cur.tail || sc.empty {
        cur.done = true
        return Ok(Unit{})
    }
    let tree = t.indexes[ix].tree
    var pks: []str = []
    var stopKey = ""
    var full = false
    let from: str = if cur.started { cur.at.clone() } else { sc.lo.clone() }
    cur.started = true
    try st.scanLeaves(txn, tree, &from, sc.hi.clone(), fn(leaf: &lexdb_rows.LeafView, i: int, j: int): bool {
        var k = i
        while k < j {
            if len(pks) == sortChunk {
                full = true
                stopKey = lexdb_rows.leafKey(leaf, k)
                return false
            }
            append(mut &pks, lexdb_rows.leafVal(leaf, k))
            k += 1
        }
        return true
    })
    if full { cur.at = stopKey } else { cur.tail = true }
    idxTaken += len(pks)
    sortedChunkN += 1
    let n = len(pks)
    cur.chunk = Some(rc(sortedKeys(pks)))
    cur.pos = 0
    if n == 0 { cur.done = true }
    return Ok(Unit{})
}

// Keys ks in key order (sortKeysPerm's), moved.
pub fn sortedKeys(ks0: []str): []str {
    var ks = ks0
    let n = len(ks)
    var order: []int = withCapacity(n)
    for i in 0..n { append(mut &order, i) }
    sortKeysPerm(&ks, mut &order)
    var out: []str = withCapacity(n)
    for i in order { append(mut &out, replace(mut &ks[i], "")) }
    return out
}

// The next keys of the cursor's chunk to read, at most n (a handle on the
// chunk and the places [from, to)); the cursor moves past them, done when
// they are the range's last.
fn sortedTake(cur: mut &Cursor, n: int, from: mut &int, to: mut &int): Option[rc []str] {
    let got: Option[rc []str] = cur.chunk.clone()
    match &got {
        Some(ks) {
            from = cur.pos
            to = min(len(ks), cur.pos + n)
        }
        None { return None }
    }
    cur.pos = to
    match &got { Some(ks) { if to == len(ks) && cur.tail { cur.done = true } } None {} }
    return got
}

// The next batch of an index range read in key order: up to BROWS rows of
// the cursor's chunk (the next chunk collected when it is read), read
// together (rowsOfKeys) and decoded where they lie. None: a value its
// column's batch does not hold.
fn fillSorted(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: int, sc: &Scan, part: bool, cur: mut &Cursor,
              bp: &BPlan): Result[Option[Batch], DbErr] {
    try sortedChunk(st, txn, t, ix, sc, cur)
    if cur.done && cur.chunk.isNone() { return Ok(Some(lexdb_rows.newBatch(bp, 0))) }
    var from = 0
    var to = 0
    let got = sortedTake(cur, BROWS, mut &from, mut &to)
    if got.isNone() || to == from { return Ok(Some(lexdb_rows.newBatch(bp, 0))) }
    let ks = got.unwrap()
    var views: []&str = withCapacity(to - from)
    for i in from..to { append(mut &views, &ks[i]) }
    var b = lexdb_rows.newBatch(bp, to - from)
    var at: []int = []
    let none: []int = []
    if !(try rowsOfKeys(st, txn, t, &views, part, bp, &none, mut &b, mut &at)) { return Ok(None) }
    for r in at { if r < 0 { return Err(lexdb_base.corrupt(&("an index entry of \"" + t.name + "\" without its row"))) } }
    return Ok(Some(b))
}

// fetch's reading of an index range in key order: up to BATCH rows of the
// cursor's chunk (the next chunk collected when it is read), by key, as
// the row path reads them (need: fetch's).
fn fetchSorted(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: int, sc: &Scan, need: &[]bool, cur: mut &Cursor,
               out: mut &[][]Val): Result[Unit, DbErr] {
    try sortedChunk(st, txn, t, ix, sc, cur)
    var from = 0
    var to = 0
    let got = sortedTake(cur, BATCH, mut &from, mut &to)
    if got.isNone() || to == from { return Ok(Unit{}) }
    let ks = got.unwrap()
    let rr = rowRead(t, need)
    for i in from..to {
        match try getRow(st, txn, t, &rr, &ks[i]) {
            Some(r) { append(out, r) }
            None { return Err(lexdb_base.corrupt(&("an index entry of \"" + t.name + "\" without its row"))) }
        }
    }
    return Ok(Unit{})
}

// ---- the OR of index paths (optimizer 52)
//
// PostgreSQL's BitmapOr in lexdb's terms: the rows of several index paths
// (one per branch of an OR), each row once. Each arm's entries' primary
// keys are collected, sorted and deduplicated, and its rows read by them
// as primary key points, in key order (as an IN list's on the primary key:
// the readers' points), the level's conditions checked on each.

// One arm: its index (-1 the primary key) and its ranges (pathScans').
pub type OrArm = record { pub ix: int; pub scans: []Scan }

// The keys an OR collects at most: past them the table is read whole
// (the scan's cost is bounded; the planner takes an OR well below it).
const OR_KEYS = 262144

var orKeysMax: int = OR_KEYS

// The most keys an OR collects (the tests: a small table read whole; 0 OR_KEYS).
pub fn setOrKeys(n: int) { orKeysMax = if n > 0 { n } else { OR_KEYS } }

// The ORs read by their keys (the tests).
var orReadN: int = 0
pub fn orReads(): int { return orReadN }

// The rows of arms' ranges as points of t's primary key, each once, in key
// order; the whole table (wholeScan) past orKeysMax keys, or when an arm
// reads it whole.
pub fn orPoints(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, arms: &[]OrArm): Result[[]Scan, DbErr] {
    var pks: []str = []
    var over = false
    for a in arms {
        let tree = if a.ix < 0 { t.tree } else { t.indexes[a.ix].tree }
        let byPk = a.ix < 0
        for sc in a.scans {
            if over { break }
            if sc.empty { continue }
            if sc.whole { return Ok([wholeScan()]) }
            if sc.point {
                if len(pks) == orKeysMax {
                    over = true
                    break
                }
                append(mut &pks, sc.lo.clone())
                continue
            }
            try st.scanLeaves(txn, tree, &sc.lo, sc.hi.clone(), fn(leaf: &lexdb_rows.LeafView, i: int, j: int): bool {
                var k = i
                while k < j {
                    if len(pks) == orKeysMax {
                        over = true
                        return false
                    }
                    append(mut &pks, if byPk { lexdb_rows.leafKey(leaf, k) } else { lexdb_rows.leafVal(leaf, k) })
                    k += 1
                }
                return true
            })
        }
        if over { break }
    }
    if over { return Ok([wholeScan()]) }
    idxTaken += len(pks)
    orReadN += 1
    let ks = sortedKeys(pks)
    var out: []Scan = withCapacity(len(ks))
    for i in 0..len(ks) {
        if i > 0 && ks[i] == ks[i - 1] { continue }
        append(mut &out, Scan{empty: false, point: true, lo: ks[i].clone(), hi: "", whole: false})
    }
    return Ok(out)
}

// The next batch of an index read alone: up to BROWS entries from the
// cursor on (the cursor as fetch keeps it: forward, the key to go on
// from; backward, the end), their keys decoded. Forward from the leaves
// in place; a range the transaction has written, or a backward read,
// copied (scan and scanBack merge its writes). None: a value its column's
// batch does not hold.
fn fillIdxOnly(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, rd: &IxRead, sc: &Scan, cur: mut &Cursor,
               bp: &BPlan): Result[Option[Batch], DbErr] {
    let tree = t.indexes[rd.ix].tree
    let want = idxWant(rd, cur)
    var b = lexdb_rows.newBatch(bp, want)
    var bail = false
    if rd.desc {
        let to: &str = if cur.started { &cur.at } else { &sc.hi }
        cur.started = true
        var last = ""
        try st.scanBack(txn, tree, &sc.lo, to, fn(en: &lexdb_store.Entry): bool {
            if !bIdxInto(&en.key, b.n, mut &b, bp, &rd.dec) {
                bail = true
                return false
            }
            b.n += 1
            last = en.key.clone()
            return b.n < want
        })
        if bail { return Ok(None) }
        idxTaken += b.n
        if b.n < want { cur.done = true } else { cur.at = last }
        return Ok(Some(b))
    }
    while b.n < want && !cur.done {
        let from: &str = if cur.started { &cur.at } else { &sc.lo }
        cur.started = true
        var stopKey = ""
        var full = false
        try st.scanLeaves(txn, tree, from, sc.hi.clone(), fn(leaf: &lexdb_rows.LeafView, i: int, j: int): bool {
            var k = i
            while k < j {
                if b.n == want {
                    full = true
                    stopKey = lexdb_rows.leafKey(leaf, k)
                    return false
                }
                if !bIdxInto(&lexdb_rows.leafKey(leaf, k), b.n, mut &b, bp, &rd.dec) {
                    bail = true
                    return false
                }
                b.n += 1
                k += 1
            }
            return true
        })
        if bail { return Ok(None) }
                if full {
            cur.at = stopKey
            idxTaken += b.n
            return Ok(Some(b))
        }
        cur.done = true
    }
    idxTaken += b.n
    return Ok(Some(b))
}

// The next batch of an index's entries' rows: up to BROWS entries from the
// cursor on (as fillIdxOnly), then their rows by primary key, read in key
// order (getMany), each decoded at its entry's place. None: a value its
// column's batch does not hold.
fn fillIdxRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, rd: &IxRead, sc: &Scan, part: bool, cur: mut &Cursor,
               bp: &BPlan): Result[Option[Batch], DbErr] {
    let tree = t.indexes[rd.ix].tree
    var pks: []str = []
    if rd.byKeys {
        cur.done = true
        for k in rd.keys { append(mut &pks, k.clone()) }
    } else if rd.desc {
        let want = idxWant(rd, cur)
        let to: &str = if cur.started { &cur.at } else { &sc.hi }
        cur.started = true
        var last = ""
        try st.scanBack(txn, tree, &sc.lo, to, fn(en: &lexdb_store.Entry): bool {
            append(mut &pks, en.val.clone())
            last = en.key.clone()
            return len(pks) < want
        })
        if len(pks) < want { cur.done = true } else { cur.at = last }
    } else {
        let want = idxWant(rd, cur)
        while len(pks) < want && !cur.done {
            let from: &str = if cur.started { &cur.at } else { &sc.lo }
            cur.started = true
            var stopKey = ""
            var full = false
            try st.scanLeaves(txn, tree, from, sc.hi.clone(), fn(leaf: &lexdb_rows.LeafView, i: int, j: int): bool {
                var k = i
                while k < j {
                    if len(pks) == want {
                        full = true
                        stopKey = lexdb_rows.leafKey(leaf, k)
                        return false
                    }
                    append(mut &pks, lexdb_rows.leafVal(leaf, k))
                    k += 1
                }
                return true
            })
                        if full {
                cur.at = stopKey
                break
            }
            cur.done = true
        }
    }
    let n = len(pks)
    idxTaken += n
    var b = lexdb_rows.newBatch(bp, n)
    // the rows in key order, unless the reads are noted (then in the
    // index's, as the row path reads them)
    var order: []int = withCapacity(n)
    for i in 0..n { append(mut &order, i) }
    if !txn.noting() { sortKeysPerm(&pks, mut &order) }
    let pkl = move(pks)                       // (a let: ks borrows it in a loop)
    var ks: []&str = withCapacity(n)
    for i in order { append(mut &ks, &pkl[i]) }
    var at: []int = []
    if !(try rowsOfKeys(st, txn, t, &ks, part, bp, &order, mut &b, mut &at)) { return Ok(None) }
    for r in at { if r < 0 { return Err(lexdb_base.corrupt(&("an index entry of \"" + t.name + "\" without its row"))) } }
    b.n = n
    return Ok(Some(b))
}

// order (places in ks) sorted by their keys, stably (equal keys keep
// their order); nothing done when they are in order already. Keys of 8
// bytes or more are compared by their first 8 as an integer (an integer
// primary key's, or a composite key's first column), the rest only between
// keys of one prefix: a few (SORT_FEW) by insertion, more by radixPerm
// when they span less than 2^62 (then each run of one prefix by
// insertion); others by comparison.
pub fn sortKeysPerm(ks: &[]str, order: mut &[]int) {
    let n = len(order)
    var sorted = true
    for i in 1..n {
        if ks[order[i]] < ks[order[i - 1]] {
            sorted = false
            break
        }
    }
    if sorted { return }
    var pre: []int = withCapacity(n)
    var lo = 0
    var hi = 0
    var ok = true
    var exact = true
    for i in 0..n {
        let k = &ks[order[i]]
        if len(k) < 8 {
            ok = false
            break
        }
        if len(k) != 8 { exact = false }
        let x = binary.readI64BEStr(k, 0) ^ (-9223372036854775807 - 1)
        if i == 0 || x < lo { lo = x }
        if i == 0 || x > hi { hi = x }
        append(mut &pre, x)
    }
    if ok && n <= SORT_FEW {
        // insertion by the prefixes (pre in order's places), the whole key on a tie
        var o: []int = withCapacity(n)
        for i in 0..n { append(mut &o, i) }
        for i in 1..n {
            let v = o[i]
            var j = i
            while j > 0 && keyAfter(ks, order, &pre, exact, o[j - 1], v) {
                o[j] = o[j - 1]
                j -= 1
            }
            o[j] = v
        }
        var out: []int = withCapacity(n)
        for j in o { append(mut &out, order[j]) }
        order = out
        return
    }
    var span = -1
    if ok {
        match hi.checkedSub(lo) {
            Some(d) { if d < (1 << 62) { span = d } }
            None {}
        }
    }
    if span < 0 {
        collections.sortBy(order, fn(a: &int, b: &int): int { return ks[a].cmp(&ks[b]) })
        return
    }
    var bits = 0
    while bits < 62 && (span >> bits) > 0 { bits += 1 }
    for i in 0..n { pre[i] = pre[i] - lo }
    var perm = lexdb_vec.radixPerm(&pre, bits)
    if !exact {
        // (stable: each run of one prefix in its first order) the runs by the whole key
        var a = 0
        while a < n {
            var z = a + 1
            while z < n && pre[perm[z]] == pre[perm[a]] { z += 1 }
            for i in a + 1..z {
                let v = perm[i]
                var j = i
                while j > a && ks[order[perm[j - 1]]] > ks[order[v]] {
                    perm[j] = perm[j - 1]
                    j -= 1
                }
                perm[j] = v
            }
            a = z
        }
    }
    var out: []int = withCapacity(n)
    for j in perm { append(mut &out, order[j]) }
    order = out
}

// The keys sortKeysPerm sorts by insertion, at most.
const SORT_FEW = 32

// Whether order's place a sorts after its place b (sortKeysPerm): by their
// prefixes (pre), then by the whole keys unless they are 8 bytes (exact).
fn keyAfter(ks: &[]str, order: &[]int, pre: &[]int, exact: bool, a: int, b: int): bool {
    if pre[a] != pre[b] { return pre[a] > pre[b] }
    return !exact && ks[order[a]] > ks[order[b]]
}

// A top-N's bar (sortBatches): a row whose first key (an integer column,
// col of the batch) sorts after the heap's last row's (v, nul) cannot
// enter the heap.
pub type Bar = record {
    pub on: bool
    pub col: int
    pub v: int
    pub nul: bool
    pub desc: bool
    pub nf: bool
}

pub fn noBar(): Bar { return Bar{on: false, col: -1, v: 0, nul: false, desc: false, nf: false} }

pub type Lazy = record {
    pub on: bool
    pub first: []int        // the places read first, in order
    pub rest: []int         // the other places used
    // conditions run on the rows' bytes, before anything is decoded: a
    // simple LIKE (literal text and %) on a text column no other
    // condition reads; per one, its condition, its column's place and its
    // pattern's pieces (lexdb_like)
    pub raw: []int
    pub rawPl: []int
    pub pieces: [][]str
    pub skip: []bool        // per condition: one of raw
    // A tagged row's (9.76: a row with a date or a timestamp mostly is)
    // two steps (bTagLazy): first the places of first and raw (bf's
    // placeCol, stopAt), then those of rest for the rows kept (br's)
    pub bf: BPlan
    pub br: BPlan
}

// A batch decoded and its rows chosen: the rows the conditions chose and
// the bar did not drop (their columns all decoded), in order; kept: the
// rows the conditions chose.
pub type Picked = record {
    pub b: Batch
    pub idx: []int
    pub kept: int
}

// Whether stored row s is a tagged one (decodeRow's last way): not in the
// fixed layout, not stored apart, not one with long texts kept whole.
fn plainTagged(s: &str): bool {
    if len(s) > 0 && (s[0] == FIXED || s[0] == 6 || s[0] == 0xFF) { return false }
    return lexdb_rows.partOf(s).isNone()
}

// bRunLazy for a run of tagged rows from vs[from] up to vs[to]: each decoded
// into b's rows b.n on at the places of the conditions (lz.bf), the
// conditions and the bar run over the run, the rest decoded for the rows
// kept (lz.br), which are added to idx (kept: the conditions' count added
// to). Before, every place a tagged row's level used was decoded for every
// row (an UPDATE of 1% of a million rows with a timestamp: 296 ms, 80 of
// them choosing the rows). The rows decoded (0: vs[from] is not a tagged
// row); -1 a value of a kind its column's batch does not hold; -2 a
// condition's error on one of them.
fn bTagLazy(leaf: &lexdb_rows.LeafView, from: int, to: int, b: mut &Batch, bp: &BPlan, t: &Rel, lz: &Lazy,
            narrow: &fn(&[]bool, &Batch, []int): Option[[]int],
            bar: &Bar, idx: mut &[]int, kept: mut &int): Result[int, DbErr] {
    let r0 = b.n
    let rw = rowsFor(t)
    var end = from
    while end < to {
        let s = lexdb_rows.leafValAt(leaf, end)
        if !plainTagged(s) { break }
        if try lexdb_rows.decodeRow(s, r0 + end - from, b, &lz.bf, &rw) != 0 { return Ok(-1) }
        end += 1
    }
    let n = end - from
    if n == 0 { return Ok(0) }
    var rs: []int = withCapacity(n)
    for q in 0..n { append(mut &rs, r0 + q) }
    // (raw LIKEs too: their places were decoded)
    let none: []bool = []
    let got = narrow(&none, b, rs)
    if got.isNone() { return Ok(-2) }
    var ch = got.unwrap()
    kept += len(ch)
    if bar.on && len(ch) > 0 {
        var ok: []int = withCapacity(len(ch))
        let kc = &b.cols[bar.col]
        for r in ch { if !barAfter(bar, kc.v[r], kc.nul[r]) { append(mut &ok, r) } }
        ch = ok
    }
    for r in ch {
        if try lexdb_rows.decodeRow(lexdb_rows.leafValAt(leaf, from + r - r0), r, b, &lz.br, &rw) != 0 { return Ok(-1) }
        append(idx, r)
    }
    return Ok(n)
}

// Rows rs of a run (their bytes rows[r - r0], of layout lay) a simple LIKE
// on place pl holds for, read in place: as Like over the decoded text.
fn likeRaw(rows: &[]&str, rs: &[]int, r0: int, pl: int, lay: &FixedLay, ps: &[]str): Result[[]int, DbErr] {
    let at = lay.bm + pl / 8
    let bit = pl % 8
    let o = lay.off[pl]
    let pv = lay.prev[pl]
    let v0 = lay.v0
    var out: []int = []
    for r in rs {
        let s = rows[r - r0]
        if (int(s[at]) >> bit) & 1 == 1 { continue }
        let e = binary.readU16LEStr(s, o)
        let st = if pv < 0 { 0 } else { binary.readU16LEStr(s, pv) }
        if st > e || v0 + e > len(s) { return Err(lexdb_base.corrupt("a row's variable part")) }
        if lexdb_like.likeRange(s, v0 + st, v0 + e, ps) { append(mut &out, r) }
    }
    return Ok(out)
}

// Whether integer key x (nul) sorts after the bar's (bar.v, bar.nul), as
// skCmp orders an integer key.
fn barAfter(bar: &Bar, x: int, nul: bool): bool {
    if nul || bar.nul {
        if nul && bar.nul { return false }
        if nul { return !bar.nf }
        return bar.nf
    }
    if x == bar.v { return false }
    return (x > bar.v) != bar.desc
}

// bRunInto in two steps (Lazy): the rows vs[from..to) in the fixed layout
// of vs[from] decoded at lz.first into rows b.n on, the conditions and the
// bar run over them, their other places decoded for the rows kept, which
// are added to idx (kept: the conditions' count added to). The rows
// decoded; 0, -1 as bRunInto; -2 a condition's error on one of them.
fn bRunLazy(leaf: &lexdb_rows.LeafView, from: int, to: int, b: mut &Batch, bp: &BPlan, t: &Rel, lz: &Lazy,
            narrow: &fn(&[]bool, &Batch, []int): Option[[]int],
            bar: &Bar, idx: mut &[]int, kept: mut &int): Result[int, DbErr] {
    if leaf.isCols { return cRunLazy(leaf, from, to, b, bp, t, lz, narrow, bar, idx, kept) }
    let rw = rowsFor(t)
    let rows = try lexdb_rows.fixedRunRows(leaf, from, to, &rw)
    if len(rows) == 0 { return Ok(0) }
    let id = try lexdb_rows.layOf(rows[0], rw.lays)
    let lay = &rw.lays[id]
    let n = len(rows)
    let r0 = b.n
    let np = len(lay.kinds)
    var rs: []int = withCapacity(n)
    for q in 0..n { append(mut &rs, r0 + q) }
    // the simple LIKEs on the rows' bytes
    for x in 0..len(lz.raw) {
        if len(rs) == 0 { break }
        let ci = lz.raw[x]
        let pl = lz.rawPl[x]
        if pl < np && lay.kinds[pl] == PK_TEXT {
            rs = try likeRaw(&rows, &rs, r0, pl, lay, &lz.pieces[x])
            continue
        }
        // (a layout whose place is not a text: decoded, then the condition)
        var qs1: []int = withCapacity(len(rs))
        for r in rs { append(mut &qs1, r - r0) }
        if !(try lexdb_rows.runCols(&rows, &qs1, r0, &[pl], b, bp, lay)) { return Ok(-1) }
        var only: []bool = array(len(lz.skip), true)
        only[ci] = false
        let got1 = narrow(&only, b, rs)
        if got1.isNone() { return Ok(-2) }
        rs = got1.unwrap()
    }
    var qs0: []int = withCapacity(len(rs))
    for r in rs { append(mut &qs0, r - r0) }
    if !(try lexdb_rows.runCols(&rows, &qs0, r0, &lz.first, b, bp, lay)) { return Ok(-1) }
    let got = narrow(&lz.skip, b, rs)
    if got.isNone() { return Ok(-2) }
    var ch = got.unwrap()
    kept += len(ch)
    if bar.on && len(ch) > 0 {
        var ok: []int = withCapacity(len(ch))
        let kc = &b.cols[bar.col]
        for r in ch { if !barAfter(bar, kc.v[r], kc.nul[r]) { append(mut &ok, r) } }
        ch = ok
    }
    var qs: []int = withCapacity(len(ch))
    for r in ch { append(mut &qs, r - r0) }
    if !(try lexdb_rows.runCols(&rows, &qs, r0, &lz.rest, b, bp, lay)) { return Ok(-1) }
    for r in ch { append(idx, r) }
    return Ok(n)
}

// bRunLazy for a column leaf: rows from..to, the places the conditions
// read first, the conditions, then the other places for the rows kept
// (added to idx). A simple LIKE on a dictionary's text is matched once per
// entry. The rows decoded (to - from), -1 and -2 as bRunLazy.
fn cRunLazy(leaf: &lexdb_rows.LeafView, from: int, to: int, b: mut &Batch, bp: &BPlan, t: &Rel, lz: &Lazy,
            narrow: &fn(&[]bool, &Batch, []int): Option[[]int],
            bar: &Bar, idx: mut &[]int, kept: mut &int): Result[int, DbErr] {
    let n = to - from
    let r0 = b.n
    let rw = rowsFor(t)
    var rs: []int = withCapacity(n)
    for q in 0..n { append(mut &rs, r0 + q) }
    if !lexdb_rows.layoutOk(leaf, &rw) {
        // row by row, the conditions over them all
        if (try lexdb_rows.rowsInto(leaf, from, to, b, bp, &rw)) < 0 { return Ok(-1) }
        let none: []bool = []
        let got0 = narrow(&none, b, rs)
        if got0.isNone() { return Ok(-2) }
        let ch0 = got0.unwrap()
        kept += len(ch0)
        for r in ch0 { append(idx, r) }
        return Ok(n)
    }
    let np = lexdb_rows.leafPlaces(leaf)
    // the simple LIKEs on the leaf's bytes
    for x in 0..len(lz.raw) {
        if len(rs) == 0 { break }
        let ci = lz.raw[x]
        let pl = lz.rawPl[x]
        if pl < np && lexdb_rows.leafPlaceKind(leaf, pl) == PK_TEXT {
            rs = lexdb_rows.likeInLeaf(leaf, from, &rs, r0, pl, &lz.pieces[x])
            continue
        }
        var qs1: []int = withCapacity(len(rs))
        for r in rs { append(mut &qs1, r - r0) }
        if !(try lexdb_rows.colsInto(leaf, from, &qs1, false, r0, &[pl], b, bp)) { return Ok(-1) }
        var only: []bool = array(len(lz.skip), true)
        only[ci] = false
        let got1 = narrow(&only, b, rs)
        if got1.isNone() { return Ok(-2) }
        rs = got1.unwrap()
    }
    var qs0: []int = withCapacity(len(rs))
    for r in rs { append(mut &qs0, r - r0) }
    if !(try lexdb_rows.colsInto(leaf, from, &qs0, len(rs) == n, r0, &lz.first, b, bp)) { return Ok(-1) }
    let got = narrow(&lz.skip, b, rs)
    if got.isNone() { return Ok(-2) }
    var ch = got.unwrap()
    kept += len(ch)
    if bar.on && len(ch) > 0 {
        var ok: []int = withCapacity(len(ch))
        let kc = &b.cols[bar.col]
        for r in ch { if !barAfter(bar, kc.v[r], kc.nul[r]) { append(mut &ok, r) } }
        ch = ok
    }
    var qs: []int = withCapacity(len(ch))
    for r in ch { append(mut &qs, r - r0) }
    if !(try lexdb_rows.colsInto(leaf, from, &qs, len(ch) == n, r0, &lz.rest, b, bp)) { return Ok(-1) }
    for r in ch { append(idx, r) }
    return Ok(n)
}

// The index in ks (sorted point keys) of the first point a cursor has not
// read: 0 before its first batch, else the first key after its last one.
pub fn (c: &Cursor) resumeAt(ks: &[]str): int {
    if !c.started { return 0 }
    return firstAfter(ks, &c.at)
}

// The index of the first key after key in ks (sorted): ks[i] > key.
pub fn firstAfter(ks: &[]str, key: &str): int {
    var lo = 0
    var hi = len(ks)
    while lo < hi {
        let mid = (lo + hi) / 2
        if ks[mid] <= key { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

// The next batch of an IN list's primary keys: ks (sorted, unique, as
// inScans makes them), the keys after cur's, up to cur's next size, read
// together (fetchMany) and given in key order. cur.at is the last key read.
// None: a value its column's batch cannot hold.
pub fn fillPoints(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ks: &[]str, part: bool, cur: mut &Cursor,
                  bp: &BPlan): Result[Option[Picked], DbErr] {
    let from = if cur.started { firstAfter(ks, &cur.at) } else { 0 }
    let to = min(len(ks), from + nextWant(cur))
    var pr = probes(-1, to - from)
    for i in from..to { append(mut &pr.keys, ks[i].clone()) }
    if to == len(ks) { cur.done = true }
    if to > from {
        cur.started = true
        cur.at = ks[to - 1].clone()
    }
    if to == from { return Ok(Some(Picked{kept: 0, idx: [], b: lexdb_rows.newBatch(bp, 0)})) }
    let got = try fetchMany(st, txn, t, &pr, part, bp)
    match got {
        Some(f) {
            var idx: []int = withCapacity(len(f.at))
            for r in f.at { if r >= 0 { append(mut &idx, r) } }
            return Ok(Some(Picked{kept: len(idx), idx: idx, b: f.rows}))
        }
        None { return Ok(None) }
    }
}

// The rows a lookup list's batch may hold (bytes at ROOM_ROW each): past
// it fewer keys are read together.
const ROOM_BYTES = 8 * 1024 * 1024
const ROOM_ROW = 64

// The keys of a lookup list's first chunk where the read may stop early
// (a LIMIT): a few keys' rows are often enough.
const FIRST_KEYS = 2

// The chunks of lookup lists read (the tests).
var rangeChunkN: int = 0
pub fn rangeChunks(): int { return rangeChunkN }

// The next batch of a lookup list over index ix (-1 the primary key): scans
// (an IN list's values or a primary key's prefixes, each a range [key, its
// successor), as inScans makes them: unique, in key order, backward when
// desc), the keys after cur's, up to cur's next size, read together
// (rangeMany: in one pass over the sorted ranges, an index's entries decoded
// when they cover the columns used, else their rows by getMany) and given in
// the list's order: each range's rows in index order (reversed when desc).
// cur.pos: the scans taken. A chunk whose rows do not fit in room (bytes; -1
// ROOM_BYTES) is read in halves. stops: the read may stop early (a LIMIT):
// the first chunk is FIRST_KEYS keys, not 32. None: a value its column's batch cannot
// hold, or one key's rows past room.
pub fn fillRanges(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: int, scans: &[]Scan, desc: bool, part: bool,
                  cur: mut &Cursor, bp: &BPlan, room: int, stops: bool): Result[Option[Picked], DbErr] {
    let from = cur.pos
    // (a read that may stop early starts with few keys)
    if stops && cur.want == 0 { cur.want = FIRST_KEYS }
    var n = nextWant(cur)
    let room0 = if room >= 0 && room < ROOM_BYTES { room } else { ROOM_BYTES }
    while true {
        let to = min(len(scans), from + n)
        var pr = probes(ix, to - from)
        for i in from..to { append(mut &pr.keys, scans[i].lo.clone()) }
        var over = false
        let got = try rangeManyIn(st, txn, t, ix, &pr, &noTail(), false, false, bp, part, room0, ROOM_ROW, mut &over)
        match got {
            Some(rg0) {
                var rg = rg0
                let rows = replace(mut &rg.rows, lexdb_rows.newBatch(bp, 0))
                var idx: []int = withCapacity(rows.n)
                for i in 0..(to - from) {
                    if desc {
                        var r = rg.hi[i]
                        while r > rg.lo[i] {
                            r -= 1
                            append(mut &idx, r)
                        }
                    } else {
                        for r in rg.lo[i]..rg.hi[i] { append(mut &idx, r) }
                    }
                }
                rangeChunkN += 1
                cur.pos = to
                cur.started = true
                cur.done = to >= len(scans)
                cur.want = min(BROWS, n * 2)
                return Ok(Some(Picked{kept: len(idx), idx: idx, b: rows}))
            }
            None {
                if !over || n == 1 { return Ok(None) }
                n = n / 2
            }
        }
    }
    return Ok(None)
}

// The next batch of a primary key's backward read: up to cur's next size of
// the entries of [sc.lo, cur's end or sc.hi), from the last one backward,
// their rows decoded in that order (descending). With part, a stored-apart
// value comes in part (scanBackPart), as the row path reads it, not whole
// for columns the query may not use. None: a value its column's batch does
// not hold.
fn fillBackBatch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, sc: &Scan, part: bool, cur: mut &Cursor,
                 bp: &BPlan, spare: mut &Batch): Result[Option[Batch], DbErr] {
    let n = nextWant(cur)
    let to: &str = if cur.started { &cur.at } else { &sc.hi }
    cur.started = true
    var keys: []str = withCapacity(n)
    var vals: []str = withCapacity(n)
    if part {
        try st.scanBackPart(txn, t.tree, &sc.lo, to, fn(en: &lexdb_store.Entry): bool {
            append(mut &keys, en.key.clone())
            append(mut &vals, en.val.clone())
            return len(keys) < n
        })
    } else {
        try st.scanBack(txn, t.tree, &sc.lo, to, fn(en: &lexdb_store.Entry): bool {
            append(mut &keys, en.key.clone())
            append(mut &vals, en.val.clone())
            return len(keys) < n
        })
    }
    if len(keys) < n { cur.done = true } else { cur.at = keys[len(keys) - 1].clone() }
    var b = lexdb_rows.reuse(spare, bp)
    let rw = rowsFor(t)
    for i in 0..len(keys) {
        let r = b.n
        let code = try lexdb_rows.decodeRow(&vals[i], r, mut &b, bp, &rw)
        if code == 1 { return Ok(None) }
        // a stored-apart value: the row path's decoding of it, as the scan
        // gave it (as getPart or get would, so not read again; fillPoint)
        if code == 2 && !(try bRowOf(st, txn, t, &keys[i], &vals[i], r, mut &b, bp)) { return Ok(None) }
        b.n += 1
    }
    return Ok(Some(b))
}

// The next batch of a level, decoded in two steps when lz is on and the
// level is a scan of its table (else as fillLevel reads it, whole), its
// rows chosen by the level's conditions (narrow: idx narrowed to the rows
// of b they hold for, those skip marks left out; None an error on one of
// them) and the bar. Its batch is spare's when that is of the plan
// (bReuse): a caller that is done with a batch gives it back there for the
// next. None: a value of a kind its column's batch does not hold, or a
// condition's error on one of its rows (the caller reads the batch by the
// row path).
pub fn fillPickIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, sc: &Scan, part: bool, cur: mut &Cursor,
                  bp: &BPlan, rd: &IxRead, lz: &Lazy, narrow: &fn(&[]bool, &Batch, []int): Option[[]int], bar: &Bar,
                  spare: mut &Batch): Result[Option[Picked], DbErr] {
    // a primary key read backward, its batch decoded then narrowed (the
    // lazy reading is for forward reads)
    if rd.desc && rd.ix < 0 && !sc.empty && !sc.point {
        let got = try fillBackBatch(st, txn, t, sc, part, cur, bp, spare)
        if got.isNone() { return Ok(None) }
        let b = got.unwrap()
        var all: []int = withCapacity(b.n)
        for r in 0..b.n { append(mut &all, r) }
        let none: []bool = []
        let ch = narrow(&none, &b, all)
        if ch.isNone() { return Ok(None) }
        let idx = ch.unwrap()
        return Ok(Some(Picked{kept: len(idx), idx: idx, b: b}))
    }
    // (an index's read, 9.107, whole: an index-only entry's columns come
    // from its key all at once; its rows, fetched by their keys, as fillLevel reads them)
    if !lz.on || sc.empty || sc.point || (rd.ix >= 0 && !sc.whole) {
        let got = try fillLevel(st, txn, t, rd, sc, part, cur, bp, spare)
        if got.isNone() { return Ok(None) }
        let b = got.unwrap()
        var all: []int = withCapacity(b.n)
        for r in 0..b.n { append(mut &all, r) }
        let none: []bool = []
        let ch = narrow(&none, &b, all)
        if ch.isNone() { return Ok(None) }
        let idx = ch.unwrap()
        return Ok(Some(Picked{kept: len(idx), idx: idx, b: b}))
    }
    var b = lexdb_rows.reuse(spare, bp)
    let rw = rowsFor(t)
    var idx: []int = []
    var pend: []int = []                // rows decoded whole: chosen at the end
    var kept = 0
    while b.n < BROWS && !cur.done {
        let from: &str = if cur.started { &cur.at } else { &sc.lo }
        cur.started = true
        var stopKey = ""
        var stop = 0                // 1 the batch is full, 2 a value stored apart
        var bail = false
        var bad: []DbErr = []
        try st.scanLeaves(txn, t.tree, from, sc.hi.clone(), fn(leaf: &lexdb_rows.LeafView, i: int, j: int): bool {
            if len(bp.ranges) > 0 && leaf.isCols && lexdb_rows.excluded(leaf, bp, &rw) { return true }
            var k = i
            while k < j {
                if b.n == BROWS {
                    stop = 1
                    stopKey = lexdb_rows.leafKey(leaf, k)
                    return false
                }
                match bRunLazy(leaf, k, min(j, k + BROWS - b.n), mut &b, bp, t, lz, narrow, bar, mut &idx, mut &kept) {
                    Ok(got) {
                        if got < 0 {
                            bail = true
                            return false
                        }
                        if got > 0 {
                            b.n += got
                            k += got
                            continue
                        }
                    }
                    Err(x) {
                        append(mut &bad, x)
                        return false
                    }
                }
                match bTagLazy(leaf, k, min(j, k + BROWS - b.n), mut &b, bp, t, lz, narrow, bar, mut &idx, mut &kept) {
                    Ok(got) {
                        if got < 0 {
                            bail = true
                            return false
                        }
                        if got > 0 {
                            b.n += got
                            k += got
                            continue
                        }
                    }
                    Err(x) {
                        append(mut &bad, x)
                        return false
                    }
                }
                match lexdb_rows.decodeRow(lexdb_rows.leafValAt(leaf, k), b.n, mut &b, bp, &rw) {
                    Ok(code) {
                        if code == 1 {
                            bail = true
                            return false
                        }
                        if code == 2 {
                            stop = 2
                            stopKey = lexdb_rows.leafKey(leaf, k)
                            return false
                        }
                    }
                    Err(x) {
                        append(mut &bad, x)
                        return false
                    }
                }
                append(mut &pend, b.n)
                b.n += 1
                k += 1
            }
            return true
        })
        if len(bad) > 0 { return Err(bad[0].clone()) }
        if bail { return Ok(None) }
                if stop == 1 {
            cur.at = stopKey
            break
        }
        if stop == 2 {
            let got = if part { try st.getPart(txn, t.tree, &stopKey) } else { try st.get(txn, t.tree, &stopKey) }
            match got {
                Some(v) {
                    if !(try bRowOf(st, txn, t, &stopKey, &v, b.n, mut &b, bp)) { return Ok(None) }
                    append(mut &pend, b.n)
                    b.n += 1
                }
                None {}
            }
            cur.at = after(&stopKey)
            continue
        }
        cur.done = true
    }
    if len(pend) > 0 {
        // the rows decoded whole: chosen now, then in order among the others
        let none: []bool = []
        let got = narrow(&none, &b, pend)
        if got.isNone() { return Ok(None) }
        let pk = got.unwrap()
        kept += len(pk)
        var merged: []int = withCapacity(len(idx) + len(pk))
        var x = 0
        var y = 0
        while x < len(idx) || y < len(pk) {
            if y >= len(pk) || (x < len(idx) && idx[x] < pk[y]) {
                append(mut &merged, idx[x])
                x += 1
            } else {
                append(mut &merged, pk[y])
                y += 1
            }
        }
        idx = merged
    }
    return Ok(Some(Picked{kept: kept, idx: idx, b: b}))
}

// The table's rows, counted until there are more than most.
pub fn countRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, most: int): Result[int, DbErr] {
    var n = 0
    try st.scanLeaves(txn, t.tree, "", "", fn(leaf: &lexdb_rows.LeafView, i: int, j: int): bool {
        n += j - i
        return n <= most
    })
    return Ok(n)
}

// The pages t's table tree holds (its rows, long values included).
pub fn pages(st: &lexdb_store.Store, t: &Rel): Result[int, DbErr] { return st.treePages(t.tree) }

// Whether t has a row (its first one read).
pub fn anyRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel): Result[bool, DbErr] {
    var any = false
    try st.scan(txn, t.tree, "", "", fn(en: &lexdb_store.Entry): bool {
        any = true
        return false
    })
    return Ok(any)
}

// How many rows t has (exact, from the leaf headers).
pub fn rowCount(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel): Result[int, DbErr] { return st.countRange(txn, t.tree, &"", &"") }

// Counts index ix's entries of sc from the cursor on until n reaches lim
// (n counts them, across calls), their primary keys appended to keys when
// keep. True: the limit was reached and the range goes on (the cursor at
// the entry that reached it); false: the range ended first.
pub fn countEntries(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: int, sc: &Scan, cur: mut &Cursor, n: mut &int,
                    lim: int, keep: bool, keys: mut &[]str): Result[bool, DbErr] {
    let from: &str = if cur.started { &cur.at } else { &sc.lo }
    cur.started = true
    var more = false
    var last = ""
    try st.scan(txn, t.indexes[ix].tree, from, &sc.hi, fn(en: &lexdb_store.Entry): bool {
        if n == lim {
            more = true
            return false
        }
        n += 1
        last = en.key.clone()
        if keep { append(keys, en.val.clone()) }
        return true
    })
    if more { cur.at = after(&last) } else { cur.done = true }
    return Ok(more)
}

// Before a list of primary keys (an IN list's lookups: two or more point
// scans) is read key by key, their nodes not in memory are read together
// (Store.warm, lexdb.md 9.132): what is read and noted is unchanged.
pub fn warmPoints(st: &lexdb_store.Store, txn: &lexdb_store.Txn, t: &Rel, scans: &[]Scan): Result[Unit, DbErr] {
    if len(scans) < 2 { return Ok(Unit{}) }
    var ks: []str = []
    for sc in scans {
        if !sc.point { return Ok(Unit{}) }
        append(mut &ks, sc.lo.clone())
    }
    return st.warm(txn, t.tree, &ks)
}

// ---- lookups for a batch of rows (9.103, 9.107)

// Keys made a part at a time for a batch's lookups (fetchMany, rangeMany):
// per lookup its key's values in order, then end (or clear: one is NULL).
pub type Probes = record {
    index: bool
    b: str
    keys: []str
}

// Probes of index ix's keys (-1 the primary key's), room for n.
pub fn probes(ix: int, n: int): Probes { return Probes{index: ix >= 0, b: "", keys: withCapacity(n)} }

// The next part's value (bound to its column's type, not NULL).
pub fn (p: mut &Probes) part(v: &Val) { encPart(mut &p.b, v, p.index) }

// The key made of the parts given is done.
pub fn (p: mut &Probes) end() {
    append(mut &p.keys, p.b.toStr())
    p.b.clear()
}

// The parts given are forgotten: the lookup has no key.
pub fn (p: mut &Probes) clear() { p.b.clear() }

// A whole primary key of one integer column: x (in its column's range).
pub fn (p: mut &Probes) intKey(x: int) {
    var ib = ""
    binary.addU64BE(mut &ib, x ^ (-9223372036854775807 - 1))
    append(mut &p.keys, ib)
}

// The last key once more.
pub fn (p: mut &Probes) again() {
    let same = p.keys[len(p.keys) - 1].clone()
    append(mut &p.keys, same)
}

pub fn (p: &Probes) count(): int { return len(p.keys) }

// The rows of a batch's keys: rows, and per key its row there (-1 none).
pub type Fetched = record {
    pub rows: Batch
    pub at: []int
}

// The rows of keys ks read at once (getManyIn) and decoded where they lie:
// a column leaf's a column at a time, a row leaf's row by row, then the
// values not in a leaf (the transaction's own writes, a replica's) and
// the rows stored apart (get, getPart). Key x's row goes to b's row
// dest[x], or with dest empty is added at b.n (b.n counts it). at[x]: key
// x's row, -1 not found. false: a value its column's batch cannot hold.
fn rowsOfKeys(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ks: &[]&str, part: bool, bp: &BPlan,
              dest: &[]int, b: mut &Batch, at: mut &[]int): Result[bool, DbErr] {
    let dense = len(dest) == 0
    let rw = rowsFor(t)
    for x in 0..len(ks) { append(at, -1) }
    var apart: []int = []                     // keys whose rows are stored apart: read after
    var bail = false
    var bad: []DbErr = []
    var got: []Option[str] = withCapacity(len(ks))
    let whole = try st.getManyIn(txn, t.tree, ks, part, fn(leaf: &lexdb_rows.LeafView, es: &[]int, xs: &[]int): bool {
        let m = len(es)
        if leaf.isCols && lexdb_rows.layoutOk(leaf, &rw) {
            var rs: []int = withCapacity(m)
            for k in 0..m { append(mut &rs, if dense { b.n + k } else { dest[xs[k]] }) }
            match lexdb_rows.colsPick(leaf, 0, es, &rs, false, 0, &bp.usedP, b, bp) {
                Ok(ok) {
                    if !ok {
                        bail = true
                        return false
                    }
                }
                Err(x) {
                    append(mut &bad, x)
                    return false
                }
            }
            for k in 0..m { at[xs[k]] = rs[k] }
            if dense { b.n += m }
            return true
        }
        for k in 0..m {
            // a row leaf's row in place; a column leaf's in another layout rebuilt
            let rebuilt = if leaf.isCols { lexdb_rows.leafVal(leaf, es[k]) } else { "" }
            let v: &str = if leaf.isCols { &rebuilt } else { lexdb_rows.leafValAt(leaf, es[k]) }
            let r = if dense { b.n } else { dest[xs[k]] }
            match lexdb_rows.decodeRow(v, r, b, bp, &rw) {
                Ok(code) {
                    if code == 1 {
                        bail = true
                        return false
                    }
                    if code == 2 {
                        append(mut &apart, xs[k])
                        continue
                    }
                }
                Err(x) {
                    append(mut &bad, x)
                    return false
                }
            }
            at[xs[k]] = r
            if dense { b.n += 1 }
        }
        return true
    }, mut &got)
    if len(bad) > 0 { return Err(bad[0].clone()) }
    if bail || !whole { return Ok(false) }
    for x in 0..len(ks) {
        match got[x] {
            Some(v) {
                let r = if dense { b.n } else { dest[x] }
                let code = try lexdb_rows.decodeRow(&v, r, b, bp, &rw)
                if code == 1 { return Ok(false) }
                if code == 2 && !(try bRowOf(st, txn, t, ks[x], &v, r, b, bp)) { return Ok(false) }
                at[x] = r
                if dense { b.n += 1 }
            }
            None {}
        }
    }
    for x in apart {
        let v = if part { try st.getPart(txn, t.tree, ks[x]) } else { try st.get(txn, t.tree, ks[x]) }
        let r = if dense { b.n } else { dest[x] }
        match v {
            Some(w) { if !(try bRowOf(st, txn, t, ks[x], &w, r, b, bp)) { return Ok(false) } }
            None { return Err(lexdb_base.corrupt(&("a row of \"" + t.name + "\" read and gone"))) }
        }
        at[x] = r
        if dense { b.n += 1 }
    }
    return Ok(true)
}

// The rows of the primary keys pr made, decoded into a batch by bp (part:
// only some columns used, as getPart reads them). The keys are read at once
// (getMany): each from the leaf of the one before, not from the root.
// Unless the transaction's reads are noted, they are read in key order
// (sorted, if they do not come so) and a key repeated is read once; with
// reads noted, in the batch's order, each as the row path reads it, so
// that they are noted as its are. Each row read is decoded once, in the
// order read. None: a value its column's batch cannot hold.
pub fn fetchMany(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, pr: &Probes, part: bool,
                 bp: &BPlan): Result[Option[Fetched], DbErr] {
    let keys = &pr.keys
    let nk = len(keys)
    var order: []int = withCapacity(nk)
    for i in 0..nk { append(mut &order, i) }
    let noted = txn.noting()
    if !noted { sortKeysPerm(keys, mut &order) }
    var ks: []&str = withCapacity(nk)         // views of pr's keys
    var first: []int = array(nk, -1)          // per key: the place in ks it is read at
    for i in order {
        if !noted && len(ks) > 0 && keys[i] == ks[len(ks) - 1] {
            first[i] = len(ks) - 1
            continue
        }
        first[i] = len(ks)
        append(mut &ks, &keys[i])
    }
    // each row read decoded once, in the order read
    var rows = lexdb_rows.newBatch(bp, len(ks))
    var at: []int = []                        // per key read: its row in rows
    if !(try rowsOfKeys(st, txn, t, &ks, part, bp, &[], mut &rows, mut &at)) { return Ok(None) }
    var each: []int = withCapacity(nk)
    for i in 0..nk { append(mut &each, at[first[i]]) }
    return Ok(Some(Fetched{rows: rows, at: each}))
}

// The rows of a batch's ranges: rows, and per key the rows [lo, hi) of
// its range; pks: the index entries read for them (their primary keys).
pub type Ranged = record {
    pub rows: Batch
    pub lo: []int
    pub hi: []int
    pub pks: int
}

// The rows of the ranges of index ix (-1 the primary key) whose leading
// parts are each key pr made, narrowed by tail (none: noRange), decoded
// into a batch by bp; one: a range's first row only. Each key's range is
// read in place (scanLeaves), its rows decoded as a scan's batches are (a
// run of a column leaf at a time); an index's entries are decoded when
// they hold every column used (bp's), else their primary keys are kept
// and their rows read after (getMany, in key order unless the reads are
// noted). Unless the reads are noted, the keys are read in key order and
// a key repeated (q21's lineitem rows of one order) is read once. The
// rows read are held: past room (bytes, perRow a row; -1 no limit) the
// reading stops. None: past room, or a value its column's batch cannot
// hold.
pub fn rangeMany(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: int, pr: &Probes, tail: &Tail, noRange: bool,
                 one: bool, bp: &BPlan, part: bool, room0: int, perRow: int): Result[Option[Ranged], DbErr] {
    var over = false
    return rangeManyIn(st, txn, t, ix, pr, tail, noRange, one, bp, part, room0, perRow, mut &over)
}

// rangeMany, telling whether a None is for room (over: fewer keys may
// fit), not for a value its column's batch cannot hold.
pub fn rangeManyIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: int, pr: &Probes, tail: &Tail, noRange: bool,
                   one: bool, bp: &BPlan, part: bool, room0: int, perRow: int, outOver: mut &bool): Result[Option[Ranged], DbErr] {
    let index = ix >= 0
    var dec = IdxDec{cols: [], codes: [], marked: [], want: [], last: 0}
    var only = false
    if index {
        match idxDecOf(t, ix, &bp.needCol) {
            Some(d) {
                dec = d
                only = true
            }
            None {}
        }
    }
    let keys = &pr.keys
    let nk = len(keys)
    var order: []int = withCapacity(nk)
    for i in 0..nk { append(mut &order, i) }
    let noted = txn.noting()
    if !noted { sortKeysPerm(keys, mut &order) }
    var ks: []&str = withCapacity(nk)         // views of pr's keys
    var first: []int = array(nk, -1)          // per key: the place in ks it is read at
    for i in order {
        if !noted && len(ks) > 0 && keys[i] == ks[len(ks) - 1] {
            first[i] = len(ks) - 1
            continue
        }
        first[i] = len(ks)
        append(mut &ks, &keys[i])
    }
    let tree = if index { t.indexes[ix].tree } else { t.tree }
    let rw = rowsFor(t)
    var rows = lexdb_rows.newBatch(bp, 64)
    var room = 64
    var pks: []str = []                       // an index's entries' primary keys (not only)
    var apart: []str = []                     // rows stored apart: their keys ...
    var apartAt: []int = []                   // ... and places
    var lo: []int = withCapacity(len(ks))
    var hi: []int = withCapacity(len(ks))
    var bail = false
    var bad: []DbErr = []
    var over = false
    // per key its range: its prefix's, narrowed by the bounds (rangeScan's);
    // an empty one [rlo, rlo)
    var rlos: []str = withCapacity(len(ks))
    var rhis: []str = withCapacity(len(ks))
    for x in 0..len(ks) {
        var rlo = ks[x].clone()
        var rhi = succ(&ks[x])
        for sf in tail.lo {
            let lk = ks[x] + sf
            if lk > rlo { rlo = lk }
        }
        for sf in tail.hi {
            let sv = succ(&(ks[x] + sf))
            if sv != "" && (rhi == "" || sv < rhi) { rhi = sv }
        }
        if tail.capNulls {
            var nb = ""
            nb += &ks[x]
            nb.addByte(2)
            let nulAt = nb
            if rhi == "" || nulAt < rhi { rhi = nulAt }
        }
        if noRange || (rhi != "" && rlo >= rhi) { rhi = rlo.clone() }
        append(mut &rlos, rlo)
        append(mut &rhis, rhi)
    }
    // range x's entries in a leaf, rows (or primary keys) taken: 0 go on,
    // 1 the range is done (one), 2 stop (bail, over, bad); lo[x]: where its
    // rows start (-1 none yet)
    lo = array(len(ks), -1)
    {
        let take = fn(x: int, leaf: &lexdb_rows.LeafView, i0: int, j0: int): int {
            if lo[x] < 0 { lo[x] = if index && !only { len(pks) } else { rows.n } }
            var e = i0
            while e < j0 {
                if room0 >= 0 && (rows.n + len(pks)) * perRow > room0 {
                    over = true
                    return 2
                }
                if index && !only {
                    append(mut &pks, lexdb_rows.leafVal(leaf, e))
                    e += 1
                    if one { return 1 }
                    continue
                }
                let want = if one { 1 } else { j0 - e }
                bRoom(mut &rows, bp, mut &room, rows.n + want)
                if index {
                    if !bIdxInto(&lexdb_rows.leafKey(leaf, e), rows.n, mut &rows, bp, &dec) {
                        bail = true
                        return 2
                    }
                    rows.n += 1
                    e += 1
                    if one { return 1 }
                    continue
                }
                match lexdb_rows.decodeRun(leaf, e, e + want, mut &rows, bp, &rw) {
                    Ok(got) {
                        if got < 0 {
                            bail = true
                            return 2
                        }
                        if got > 0 {
                            rows.n += got
                            e += got
                            if one { return 1 }
                            continue
                        }
                    }
                    Err(er) {
                        append(mut &bad, er)
                        return 2
                    }
                }
                match lexdb_rows.decodeRow(lexdb_rows.leafValAt(leaf, e), rows.n, mut &rows, bp, &rw) {
                    Ok(code) {
                        if code == 1 {
                            bail = true
                            return 2
                        }
                        if code == 2 {
                            append(mut &apart, lexdb_rows.leafKey(leaf, e))
                            append(mut &apartAt, rows.n)
                        }
                    }
                    Err(er) {
                        append(mut &bad, er)
                        return 2
                    }
                }
                rows.n += 1
                e += 1
                if one { return 1 }
            }
            return 0
        }
        if noted {
            // range by range, in the keys' order (the reads noted as made)
            for x in 0..len(ks) {
                if len(rhis[x]) > 0 && rlos[x] >= rhis[x] { continue }
                var code = 0
                try st.scanLeaves(txn, tree, &rlos[x], rhis[x].clone(), fn(leaf: &lexdb_rows.LeafView, i0: int, j0: int): bool {
                    code = take(x, leaf, i0, j0)
                    return code == 0
                })
                if code == 2 { break }      // (bail, over or bad: take's)
            }
        } else {
            // the ranges in key order, those in one leaf by one descent
            try st.scanRanges(txn, tree, &rlos, &rhis, take)
        }
    }
    // where each range's rows end: where the next range with rows starts
    // (ranges are read in order), the last at the end
    var next = if index && !only { len(pks) } else { rows.n }
    hi = array(len(ks), 0)
    var x = len(ks)
    while x > 0 {
        x -= 1
        hi[x] = next
        if lo[x] < 0 { lo[x] = next } else { next = lo[x] }
    }
    if len(bad) > 0 { return Err(bad[0].clone()) }
    outOver = over && !bail
    if bail || over { return Ok(None) }
    for a in 0..len(apart) {
        let got = if part { try st.getPart(txn, t.tree, &apart[a]) } else { try st.get(txn, t.tree, &apart[a]) }
        match got {
            Some(v) { if !(try bRowOf(st, txn, t, &apart[a], &v, apartAt[a], mut &rows, bp)) { return Ok(None) } }
            None { return Err(lexdb_base.corrupt(&("a row of \"" + t.name + "\" read and gone"))) }
        }
    }
    let npks = len(pks)
    if index && !only {
        // an index's entries: their rows by primary key, in key order
        // unless the reads are noted
        let ne = len(pks)
        var po: []int = withCapacity(ne)
        for e in 0..ne { append(mut &po, e) }
        if !noted { sortKeysPerm(&pks, mut &po) }
        let pkl = move(pks)                   // (a let: sk borrows it in a loop)
        var sk: []&str = withCapacity(ne)
        for e in po { append(mut &sk, &pkl[e]) }
        rows = lexdb_rows.newBatch(bp, ne)
        var at: []int = []
        if !(try rowsOfKeys(st, txn, t, &sk, part, bp, &po, mut &rows, mut &at)) { return Ok(None) }
        for r in at { if r < 0 { return Err(lexdb_base.corrupt(&("an index entry of \"" + t.name + "\" without its row"))) } }
        rows.n = ne
    }
    var eachLo: []int = withCapacity(nk)
    var eachHi: []int = withCapacity(nk)
    for i in 0..nk {
        append(mut &eachLo, lo[first[i]])
        append(mut &eachHi, hi[first[i]])
    }
    return Ok(Some(Ranged{rows: rows, lo: eachLo, hi: eachHi, pks: npks}))
}

// b with room for m rows at least (room: its rows now; its n kept): its
// columns copied into a batch twice as large, or m.
fn bRoom(b: mut &Batch, bp: &BPlan, room: mut &int, m: int) {
    if m <= room { return }
    var cap = room * 2
    if cap < m { cap = m }
    var nb = lexdb_rows.newBatch(bp, cap)
    for c in 0..len(bp.kinds) {
        if !bp.needCol[c] { continue }
        for r in 0..b.n {
            nb.cols[c].v[r] = b.cols[c].v[r]
            nb.cols[c].nul[r] = b.cols[c].nul[r]
        }
        // (moved: b is replaced; a text column's bytes whole, its places kept)
        if bp.kinds[c] == BK_VAL { for r in 0..b.n { nb.vals[c][r] = replace(mut &b.vals[c][r], Val.Null) } }
        nb.txt[c] = replace(mut &b.txt[c], "")
    }
    nb.n = b.n
    b = nb
    room = cap
}

// ---- a look at the trees, for the tests

// How many of t's stored rows are in the fixed layout.
pub fn fixedRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel): int {
    var n = 0
    let r = st.scan(txn, t.tree, "", "", fn(en: &lexdb_store.Entry): bool {
        if lexdb_rows.isFixedRow(&en.val) { n += 1 }
        return true
    })
    return n
}

// t's stored rows per layout (by layout number), then those in the tagged
// form.
pub fn layoutRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel): []int {
    var counts: []int = array(len(t.layouts), 0)
    var tagged = 0
    let r = st.scan(txn, t.tree, "", "", fn(en: &lexdb_store.Entry): bool {
        if len(en.val) > 2 && lexdb_rows.isFixedRow(&en.val) {
            let id = binary.readU16LEStr(&en.val, 1)
            if id < len(counts) { counts[id] += 1 }
        } else {
            tagged += 1
        }
        return true
    })
    append(mut &counts, tagged)
    return counts
}

// t's leaves: column leaves, leaves of rows, rows read whole (9.114).
pub fn leafKinds(st: &lexdb_store.Store, t: &Rel): Result[[]int, DbErr] { return st.leafKinds(t.tree) }

// t's trees, "name entries hash" each, its table's first and then each
// index's: every entry's key and value hashed.
pub fn treeDump(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel): []str {
    var out: []str = []
    var trees: []int = [t.tree]
    var names: []str = ["table"]
    for ix in t.indexes {
        append(mut &trees, ix.tree)
        append(mut &names, ix.name.clone())
    }
    for k in 0..len(trees) {
        var n = 0
        var h = 0
        let r = st.scan(txn, trees[k], "", "", fn(en: &lexdb_store.Entry): bool {
            n += 1
            for i in 0..len(en.key) { h = (h * 131 + int(en.key[i]) + 1) & 0xffffffffffff }
            h = (h * 131 + 7) & 0xffffffffffff
            for i in 0..len(en.val) { h = (h * 131 + int(en.val[i]) + 1) & 0xffffffffffff }
            return true
        })
        append(mut &out, names[k] + " " + n.toStr() + " " + h.toStr())
    }
    return out
}

// ---- writes: rows and every index they are in
//
// A row written reaches each index of its table here. What an index needs
// from above comes as two closures: pred (a filtered index's predicate on
// a row: whether the index holds it) and expr (an expression part's value
// for a row, of the expression's type). Both are called only for an index
// that has one. wrote is called once a row's own tree is written, before
// its index entries (the caller counts it there for its statistics).
// Writes take a chunk of rows; a conflict stops the chunk and is reported,
// not raised: what it means (UNIQUE, ON CONFLICT, the error's text) is the
// caller's.

// No conflict, or one on the primary key; else an index's number.
pub const NO_CONFLICT: int = -2
pub const PK_CONFLICT: int = -1

// The first conflict of a chunk: its row (at; -1 none) and on what (ix:
// PK_CONFLICT, or an index of the relation).
pub type Conflict = value record {
    pub at: int
    pub ix: int
}

pub fn noConflict(): Conflict { return Conflict{at: -1, ix: NO_CONFLICT} }

// Whether t's key is the hidden row id (a table without a primary key: its
// sequence gives every row a new one).
pub fn rowidKeyed(t: &Rel): bool { return len(t.pk) == 1 && t.pk[0] < len(t.cols) && t.cols[t.pk[0]].name == ROWID }

// A row as t stores it: its values at their places, NULL at a dropped
// column's.
pub fn encRow(t: &Rel, row: &[]Val): str {
    let r = rowsFor(t)
    return lexdb_rows.encodeRowOf(&r, row)
}

// Index ix's k-th part for row: a column's value as the keys hold it, or
// an expression's (expr).
pub fn ixPart(t: &Rel, ix: &Index, k: int, row: &[]Val, expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[Val, DbErr] {
    let c = ix.cols[k]
    // (a virtual column is not in the row: the callback computes it)
    if c >= 0 && t.cols[c].genKind != lexdb_sql.GEN_VIRTUAL { return Ok(collKeyVal(&t.cols[c], &row[c])) }
    return expr(ix, k, row)
}

// Whether index ix holds row: always, or its predicate is true.
fn ixHolds(ix: &Index, row: &[]Val, pred: &fn(&Index, &[]Val): Result[bool, DbErr]): Result[bool, DbErr] {
    if ix.pred.isNone() { return Ok(true) }
    return pred(ix, row)
}

// Index ix's parts for row encoded (its entry less the primary key), and
// whether one is NULL.
type IxKey = record { pre: str; nul: bool }

fn ixKey(t: &Rel, ix: &Index, row: &[]Val, expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[IxKey, DbErr] {
    var b = ""
    var nul = false
    for k in 0..len(ix.cols) {
        let v = try ixPart(t, ix, k, row, expr)
        if isNull(&v) { nul = true }
        encIdxPart(mut &b, &v)
    }
    return Ok(IxKey{pre: b, nul: nul})
}

// Whether a unique index ix holds the parts pre (none NULL) for a row
// other than pk's. The scan reads the index's leaf, so a commit that adds
// the same value meanwhile fails one of the two with 40001.
fn ixClash(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, ix: &Index, pre: &str, pk: &str): Result[bool, DbErr] {
    var clash = false
    try st.scan(txn, ix.tree, pre, &(succ(pre)), fn(en: &lexdb_store.Entry): bool {
        if en.val != pk {
            clash = true
            return false
        }
        return true
    })
    return Ok(clash)
}

// Row's entries (its key pk) added to t's indexes: a unique one's value
// held for another row is a conflict (its index), and the entries after
// it are not added. NO_CONFLICT: all added.
fn addEntries(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, row: &[]Val, pk: &str,
              pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[int, DbErr] {
    for i in 0..len(t.indexes) {
        let ix = &t.indexes[i]
        if !(try ixHolds(ix, row, pred)) { continue }
        let k = try ixKey(t, ix, row, expr)
        if ix.unique && !k.nul && (try ixClash(st, txn, ix, &k.pre, pk)) { return Ok(i) }
        try txn.put(ix.tree, &(k.pre + pk), pk)
    }
    return Ok(NO_CONFLICT)
}

// Rows inserted into t, each with its index entries. Each row's key must
// be free (a conflict on the primary key; the hidden row id is never
// looked for: no row can have it already), and a unique index's value
// too. The rows before a conflict stay written.
pub fn insert(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, rows: &[]&[]Val,
              pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr],
              wrote: &fn(&lexdb_store.Txn)): Result[Conflict, DbErr] {
    for at in 0..len(rows) {
        let c = try insertRow(st, txn, t, rows[at], pred, expr, wrote)
        if c != NO_CONFLICT { return Ok(Conflict{at: at, ix: c}) }
    }
    return Ok(noConflict())
}

// insert for one row: NO_CONFLICT, PK_CONFLICT or the index's number.
pub fn insertRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, row: &[]Val,
                 pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr],
                 wrote: &fn(&lexdb_store.Txn)): Result[int, DbErr] {
    let key = keyOf(t, row)
    if !rowidKeyed(t) && (try st.get(txn, t.tree, &key)).isSome() { return Ok(PK_CONFLICT) }
    let enc = encRow(t, row)
    try txn.putRow(t.tree, &key, &enc, lexdb_rows.rowHead(&enc))
    wrote(txn)
    return addEntries(st, txn, t, row, &key, pred, expr)
}

// Rows olds[i] of t changed to news[i], their index entries with them: a
// row whose key changes must find the new one free, and a unique index's
// value is checked as an insert's.
pub fn update(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, olds: &[]&[]Val, news: &[]&[]Val,
              pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr],
              wrote: &fn(&lexdb_store.Txn)): Result[Conflict, DbErr] {
    for at in 0..len(olds) {
        let c = try updateRow(st, txn, t, olds[at], news[at], pred, expr, wrote)
        if c != NO_CONFLICT { return Ok(Conflict{at: at, ix: c}) }
    }
    return Ok(noConflict())
}

// update for one row: NO_CONFLICT, PK_CONFLICT or the index's number.
pub fn updateRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, old: &[]Val, row: &[]Val,
                 pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr],
                 wrote: &fn(&lexdb_store.Txn)): Result[int, DbErr] {
    let oldKey = keyOf(t, old)
    let key = keyOf(t, row)
    if key != oldKey {
        if (try st.get(txn, t.tree, &key)).isSome() { return Ok(PK_CONFLICT) }
        txn.del(t.tree, &oldKey)
    }
    let enc = encRow(t, row)
    try txn.putRow(t.tree, &key, &enc, lexdb_rows.rowHead(&enc))
    wrote(txn)
    for i in 0..len(t.indexes) {
        let ix = &t.indexes[i]
        let was = try ixHolds(ix, old, pred)
        let now = try ixHolds(ix, row, pred)
        // (an entry made only for a row the index holds: an expression
        // need not have a value outside a filtered index's rows)
        let a = if was { (try ixKey(t, ix, old, expr)).pre + oldKey } else { "" }
        var b = ""
        var nul = false
        if now {
            let k = try ixKey(t, ix, row, expr)
            b = k.pre + key
            nul = k.nul
        }
        if a == b && was == now { continue }
        if was { txn.del(ix.tree, &a) }
        if now {
            if ix.unique && !nul && (try ixClash(st, txn, ix, &b[0..len(b) - len(key)], &key)) { return Ok(i) }
            try txn.put(ix.tree, &b, &key)
        }
    }
    return Ok(NO_CONFLICT)
}

// Rows of t deleted, with their index entries.
pub fn delete(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, rows: &[]&[]Val,
              pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr],
              wrote: &fn(&lexdb_store.Txn)): Result[Unit, DbErr] {
    for row in rows { try deleteRow(st, txn, t, row, pred, expr, wrote) }
    return Ok(Unit{})
}

// delete for one row.
pub fn deleteRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, row: &[]Val,
                 pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr],
                 wrote: &fn(&lexdb_store.Txn)): Result[Unit, DbErr] {
    let key = keyOf(t, row)
    txn.del(t.tree, &key)
    wrote(txn)
    for ix in t.indexes { if try ixHolds(&ix, row, pred) { txn.del(ix.tree, &((try ixKey(t, &ix, row, expr)).pre + key)) } }
    return Ok(Unit{})
}

// Per row, the row of t it would conflict with on one of the unique keys
// arb (-1 the primary key, else an index; in that order), read whole; None
// none. An index's value with a NULL, or a row a filtered index does not
// hold, conflicts with nothing there.
pub fn conflicts(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, arb: &[]int, rows: &[]&[]Val,
                 pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[[]Option[[]Val], DbErr] {
    var out: []Option[[]Val] = withCapacity(len(rows))
    for row in rows { append(mut &out, try conflictRow(st, txn, t, arb, row, pred, expr)) }
    return Ok(out)
}

// conflicts for one row.
pub fn conflictRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, arb: &[]int, row: &[]Val,
                   pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[Option[[]Val], DbErr] {
    for a in arb {
        var pk = ""
        if a < 0 {
            pk = keyOf(t, row)
        } else {
            let ix = &t.indexes[a]
            // (its parts first, then its predicate, as the check reads them)
            var nul = false
            for k in 0..len(ix.cols) { if isNull(&(try ixPart(t, ix, k, row, expr))) { nul = true; break } }
            if nul || !(try ixHolds(ix, row, pred)) { continue }
            let pre = (try ixKey(t, ix, row, expr)).pre
            var hit: []str = []
            try st.scan(txn, ix.tree, &pre, &(succ(&pre)), fn(en: &lexdb_store.Entry): bool {
                append(mut &hit, en.val.clone())
                return false
            })
            if len(hit) == 0 { continue }
            pk = pop(mut &hit)
        }
        match try st.get(txn, t.tree, &pk) {
            Some(v) {
                let all: []bool = []
                return Ok(Some(try rowOf(st, txn, t, &pk, &v, rowWidth(t), &all, &placesMissing(t))))
            }
            None {}
        }
    }
    return Ok(None)
}

// Per row, whether t has a row with its values: through its primary key
// (via -1: the row's key) or index via (an entry with its parts).
pub fn hasKeys(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, via: int, rows: &[]&[]Val,
               expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[[]bool, DbErr] {
    var out: []bool = withCapacity(len(rows))
    for row in rows { append(mut &out, try hasKey(st, txn, t, via, row, expr)) }
    return Ok(out)
}

// hasKeys for one row.
pub fn hasKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, via: int, row: &[]Val,
              expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[bool, DbErr] {
    if via < 0 { return Ok((try st.get(txn, t.tree, &(keyOf(t, row)))).isSome()) }
    let ix = &t.indexes[via]
    let pre = (try ixKey(t, ix, row, expr)).pre
    var found = false
    try st.scan(txn, ix.tree, &pre, &(succ(&pre)), fn(en: &lexdb_store.Entry): bool {
        found = true
        return false
    })
    return Ok(found)
}

// Per key of ks (primary keys, as keyOf makes them), whether t has a row
// with it: what hasKey's primary key lookup gives for each, read at once
// (getManyIn) in the order given (sorted, each found from the leaf of the one
// before), the reads noted as getMany notes them. The rows themselves are
// not read. A foreign key's parents probed for a chunk of rows
// (lexdb_fkprobe).
pub fn hasMany(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ks: &[]&str): Result[[]bool, DbErr] {
    let n = len(ks)
    var hit: []bool = array(n, false)
    var vals: []Option[str] = []
    let whole = try st.getManyIn(txn, t.tree, ks, true, fn(leaf: &lexdb_rows.LeafView, es: &[]int, xs: &[]int): bool {
        for k in 0..len(es) { hit[xs[k]] = true }
        return true
    }, mut &vals)
    for x in 0..n { if vals[x].isSome() { hit[x] = true } }
    return Ok(hit)
}

// The keys of [lo, hi) for equalities eqs on the first columns and a lower
// and an upper bound on the next, each inclusive or not (in an index: each
// part under its marker): exact, for a range delete. noScan: none.
pub fn exactRange(eqs: &[]Val, lower: &Option[Val], lowIncl: bool, upper: &Option[Val], upIncl: bool, ix: bool): Scan {
    var pb = ""
    for v in eqs { encPart(mut &pb, &v, ix) }
    let p = pb
    var lo = p.clone()
    var hi = if len(p) > 0 { succ(&p) } else { "" }
    match lower {
        Some(v) {
            var kb = ""
            kb += &p
            encPart(mut &kb, &v, ix)
            let e = kb
            if lowIncl {
                lo = e
            } else {
                // just after every key that starts with e; none: nothing is above it
                let n = succ(&e)
                if n == "" { return noScan() }
                lo = n
            }
        }
        None {}
    }
    match upper {
        Some(v) {
            var kb = ""
            kb += &p
            encPart(mut &kb, &v, ix)
            let e = kb
            // (inclusive with nothing after e: to the end, no tighter than hi)
            let h = if upIncl { succ(&e) } else { e }
            if h != "" && (hi == "" || h < hi) { hi = h }
        }
        None {}
    }
    if len(hi) > 0 && lo >= hi { return noScan() }
    return Scan{empty: false, point: false, lo: lo, hi: hi, whole: false}
}

// Whether a transaction other than txn holds a row lock in t's range sc.
pub fn rangeLocked(st: &lexdb_store.Store, txn: &lexdb_store.Txn, t: &Rel, sc: &Scan): bool {
    return st.locks.locksIn(txn.lockOwner(), t.tree, &sc.lo, &sc.hi)
}

// A range delete of t: its rows of main dropped as subtrees, and the
// entries of indexes ixs (their ranges ixr) too; the entries of indexes
// slow, which do not lead with the key, deleted one by one (delEntries,
// their columns need). The range is noted as read before it is counted,
// so a commit into it meanwhile fails this one (40001). The rows deleted;
// -1 the count gave up (nothing deleted).
pub fn deleteRange(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, main: &Scan, ixs: &[]int, ixr: &[]Scan, slow: &[]int,
                   need: &[]bool, pred: &fn(&Index, &[]Val): Result[bool, DbErr],
                   expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[int, DbErr] {
    st.noteRange(txn, t.tree, &main.lo, &main.hi)
    // with indexes to delete entry by entry, the rows are read (through the
    // transaction's own view) and counted: the rows read are the rows
    // deleted, whatever the transaction wrote or cut before
    let n = if len(slow) > 0 { try delEntries(st, txn, t, &main.lo, &main.hi, slow, need, pred, expr) }
            else { try st.countView(txn, t.tree, &main.lo, &main.hi) }
    if n <= 0 { return Ok(n) }
    txn.delRange(t.tree, &main.lo, &main.hi)
    for i in 0..len(ixs) { txn.delRange(t.indexes[ixs[i]].tree, &ixr[i].lo, &ixr[i].hi) }
    return Ok(n)
}

// The entries of the indexes slow (places in t.indexes) of the rows of [lo, hi) of table t, deleted one by one
// as the row path's delRow does (an expression's value, a filtered index's predicate, the key from the row's
// key): the number of rows read. Only the columns those indexes use (need) are read, in batches (the rows are not
// held), and through the transaction's own view, so a row it wrote is read as written and one it deleted or
// cut is not.
fn delEntries(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, lo: &str, hi: &str, slow: &[]int, need: &[]bool,
              pred: &fn(&Index, &[]Val): Result[bool, DbErr], expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[int, DbErr] {
    let n = rowWidth(t)
    let places = placesNeeded(t, need)
    let missing = placesMissing(t)
    var from = lo.toStr()
    var count = 0
    while true {
        var keys: []str = []
        var vals: []str = []
        try st.scanPart(txn, t.tree, &from, hi, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val.clone())
            append(mut &keys, en.key.clone())
            return len(vals) < BATCH
        })
        for k in 0..len(keys) {
            let row = try rowOf(st, txn, t, &keys[k], &vals[k], n, &places, &missing)
            for x in slow {
                let ix = &t.indexes[x]
                if try ixHolds(ix, &row, pred) { txn.del(ix.tree, &((try ixKey(t, ix, &row, expr)).pre + keys[k])) }
            }
        }
        count += len(keys)
        if len(keys) < BATCH { break }
        from = after(&keys[len(keys) - 1])
    }
    return Ok(count)
}

// ---- bulk builds: a table's rows, or an index's entries, made again into
// new trees and written in key order, as a sorted index build writes them:
// each goes past the tree's last, so its leaves are left full (lexdb_store
// applyPut; design/lexdb.md 9.109).

// A duplicate a build found: on what (NO_CONFLICT none, PK_CONFLICT the
// primary key, else the index) and one of its rows ([] not known).
pub type Dup = record {
    pub ix: int
    pub row: []Val
}

fn noDup(): Dup { return Dup{ix: NO_CONFLICT, row: []} }

// A table's rows made again (ALTER TABLE's rewrite): their keys and bytes,
// and the entries of the indexes made again (redo, places in its indexes;
// per one, each entry's row and, for a unique index, the length of its
// parts, -1 one NULL). held: the bytes held so far.
pub type Build = record {
    keys: []str
    encs: []str
    redo: []int
    ents: [][]str
    rows: [][]int
    pres: [][]int
    pub held: int
}

pub fn newBuild(redo: &[]int): Build {
    var b = Build{keys: [], encs: [], redo: [], ents: [], rows: [], pres: [], held: 0}
    for x in redo {
        append(mut &b.redo, x)
        append(mut &b.ents, [])
        append(mut &b.rows, [])
        append(mut &b.pres, [])
    }
    return b
}

pub fn (b: &Build) count(): int { return len(b.keys) }

// A row of the build: its key, its bytes, its entries in the indexes made
// again (held counts them).
pub fn buildAdd(t: &Rel, b: mut &Build, row: &[]Val, pred: &fn(&Index, &[]Val): Result[bool, DbErr],
                expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[Unit, DbErr] {
    let key = keyOf(t, row)
    let enc = encRow(t, row)
    b.held += len(key) + len(enc) + 48
    let r = len(b.keys)
    for j in 0..len(b.redo) {
        let ix = &t.indexes[b.redo[j]]
        if !(try ixHolds(ix, row, pred)) { continue }
        let k = try ixKey(t, ix, row, expr)
        let en = k.pre + key
        b.held += len(en) + 32
        append(mut &b.ents[j], en)
        append(mut &b.rows[j], r)
        if ix.unique { append(mut &b.pres[j], if k.nul { -1 } else { len(k.pre) }) }
    }
    append(mut &b.keys, key)
    append(mut &b.encs, enc)
    return Ok(Unit{})
}

// Whether xs are in order already (a key that follows the rows' order, as
// an id filled as rows came: no sort needed).
fn inOrder(xs: &[]str): bool {
    for i in 1..len(xs) { if xs[i - 1].cmp(&xs[i]) > 0 { return false } }
    return true
}

// The build written to t's (new) trees: the rows in key order (sorted
// unless sorted says they come so, or they do), then each index's entries.
// Two rows of one key, or two entries of a unique index with equal parts
// (none NULL), are a duplicate: nothing more is written.
pub fn buildWrite(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, b: &Build, sorted: bool,
                  wrote: &fn(&lexdb_store.Txn)): Result[Dup, DbErr] {
    var order: []int = array(len(b.keys), 0)
    for i in 0..len(order) { order[i] = i }
    if !sorted && !inOrder(&b.keys) { collections.sortBy(mut &order, fn(x: &int, y: &int): int { return b.keys[x].cmp(&b.keys[y]) }) }
    for j in 0..len(order) {
        let i = order[j]
        if j > 0 && b.keys[i] == b.keys[order[j - 1]] {
            let row = try rowOf(st, txn, t, &b.keys[i], &b.encs[i], rowWidth(t), &[], &[])
            return Ok(Dup{ix: PK_CONFLICT, row: row})
        }
        try txn.putRow(t.tree, &b.keys[i], &b.encs[i], lexdb_rows.rowHead(&b.encs[i]))
        wrote(txn)
    }
    for j in 0..len(b.redo) {
        var pks: []str = []
        for r in b.rows[j] { append(mut &pks, b.keys[r].clone()) }
        match try fillIndex(st, txn, t, &t.indexes[b.redo[j]], &b.ents[j], &pks, &b.pres[j]) {
            Some(row) { return Ok(Dup{ix: b.redo[j], row: row}) }
            None {}
        }
    }
    return Ok(noDup())
}

// Index ix (not yet one of t's: CREATE INDEX) filled from t's rows, a
// unique one checked: the entries sorted, so a unique index's duplicates
// are neighbours (the tree is new, so they are all there is to check).
// Some: a duplicate, one of its rows ([] not known).
pub fn buildIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: &Index, pred: &fn(&Index, &[]Val): Result[bool, DbErr],
                  expr: &fn(&Index, int, &[]Val): Result[Val, DbErr]): Result[Option[[]Val], DbErr] {
    let sc = allScan()
    var cur = newCursor()
    var ents: []str = []
    var pks: []str = []
    var pres: []int = []                // a unique index's: the length of each entry's parts, -1 one NULL
    while !cur.done {
        var batch: [][]Val = []
        let all: []bool = []
        try fetch(st, txn, t, -1, false, &sc, &all, mut &cur, mut &batch)
        for r in batch {
            if !(try ixHolds(ix, &r, pred)) { continue }
            let pk = keyOf(t, &r)
            let k = try ixKey(t, ix, &r, expr)
            if ix.unique { append(mut &pres, if k.nul { -1 } else { len(k.pre) }) }
            append(mut &ents, k.pre + pk)
            append(mut &pks, pk)
        }
    }
    return fillIndex(st, txn, t, ix, &ents, &pks, &pres)
}

// Fills index ix's (new) tree with its entries ents, each ending with its
// row's key pks[i], in their order; a unique one's (pres: each entry's
// parts' length, -1 one NULL) two of equal parts are then neighbours: a
// duplicate, its row read back from t's tree (Some).
fn fillIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, ix: &Index, ents: &[]str, pks: &[]str,
             pres: &[]int): Result[Option[[]Val], DbErr] {
    var order: []int = array(len(ents), 0)
    for i in 0..len(ents) { order[i] = i }
    if !inOrder(ents) { collections.sortBy(mut &order, fn(a: &int, b: &int): int { return ents[a].cmp(&ents[b]) }) }
    for j in 0..len(order) {
        let i = order[j]
        if ix.unique && j > 0 {
            let h = order[j - 1]
            if pres[i] >= 0 && pres[h] == pres[i] && ents[i][0..pres[i]] == ents[h][0..pres[h]] {
                var row: []Val = []
                match try st.get(txn, t.tree, &pks[i]) {
                    Some(v) { row = try rowOf(st, txn, t, &pks[i], &v, rowWidth(t), &[], &placesMissing(t)) }
                    None {}
                }
                return Ok(Some(row))
            }
        }
        try txn.put(ix.tree, &ents[i], &pks[i])
    }
    return Ok(None)
}

// ---- a load in key order (COPY's fast path)

// Where a load is: the last key loaded, and whether its rows have entered
// the own-writes map (a key came out of order).
pub type Load = record {
    lastId: int
    haveLast: bool
    indexed: bool
}

pub fn newLoad(): Load { return Load{lastId: 0, haveLast: false, indexed: false} }

// Row bytes row (t's stored form) of the primary key id (one integer
// column) loaded into t: in key order straight to the tree's end
// (putRowLoad: no own-writes entry); once a key comes out of order, the
// rows so far enter the own-writes map and from there each key is looked
// for before it is written. False: that key is there already.
pub fn loadRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Rel, id: int, row: &str, ld: mut &Load): Result[bool, DbErr] {
    let outOfOrder = ld.haveLast && id <= ld.lastId
    ld.lastId = id
    ld.haveLast = true
    var kb = ""
    binary.addU64BE(mut &kb, id ^ (-9223372036854775807 - 1))
    let key = kb
    if outOfOrder && !ld.indexed {
        txn.indexWrites()
        ld.indexed = true
    }
    if ld.indexed {
        match try st.get(txn, t.tree, &key) {
            Some(_) { return Ok(false) }
            None {}
        }
        try txn.putRow(t.tree, &key, row, 0)
    } else {
        try txn.putRowLoad(t.tree, &key, row, 0)
    }
    return Ok(true)
}

// ---- column leaves

// Gives the store t's layouts for its column leaves (lexdb_store.setColSpec),
// and the values its rows written before a column was added have for it
// (as a row in its current layout: lexdb_rows.Spec.fill).
pub fn setSpec(st: &lexdb_store.Store, t: &Rel) {
    let miss = placesMissing(t)
    var fill = ""
    var ok = true
    if len(miss) > 0 {
        let r = rowsFor(t)
        match lexdb_rows.encodeFixed(&r, &miss) {
            Some(f) { fill = f }
            None { ok = false }
        }
    }
    st.setColSpec(t.tree, t.layouts, &fill, ok)
}

// Up to most of t's leaves from from on made column leaves where their rows
// allow (VACUUM).
pub fn upgrade(st: &lexdb_store.Store, t: &Rel, from: &str, most: int): Result[lexdb_store.Upgrade, DbErr] {
    return st.upgradeTree(t.tree, from, most)
}
