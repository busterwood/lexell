// lexdb_graph: SQL/PGQ in the Oracle door (Oracle 23ai's property graphs; design/lexdb-new-features.md O22, 6.3 item 1 and
// section 13), checked against Oracle Database Free 23.26.3.
//
// A property graph is a catalog row of its own (graphKey: GRAPH_PRE and the graph's key, made as a table's: its schema and
// name): its elements, each a vertex or an edge table (the element's name, the table's catalog key, its key columns, its
// labels with their properties, an edge's source and destination: the vertex element and the columns on each side). The
// tables keep their row layout, encoding and read paths: nothing of the graph is in them. A graph names its tables and
// columns by name, so one dropped, renamed or altered under it makes it invalid (USER_OBJECTS' STATUS, ORA-04045 where it is
// used) until one of that name is there again, as Oracle's is. The row goes through the log as any catalog row: restart,
// replay and replicas need nothing more.
//
// GRAPH_TABLE (g MATCH ... [WHERE ...] COLUMNS (...)) in FROM (lexdb_parse.graphTable keeps its text) is written here as a
// query (expand) where it is planned: a match of the pattern is a join of its element tables on the edges' keys, the
// pattern's and the elements' WHERE its conditions, COLUMNS its select list; a UNION ALL takes the elements a variable may
// be bound to, the lengths of a bounded quantifier (each its own join) and the two directions of an edge pattern without
// one. The planner then sees nothing but joins.
import "strings"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_store"
import "./lexdb_catalog"
import "./lexdb_parse"
import "./lexdb_bind"
import "./lexdb_assert"

type DbErr = lexdb_base.DbErr
type Tok = lexdb_parse.Tok
type TypeName = lexdb_sql.TypeName
type Table = lexdb_catalog.Table
type Stmt = lexdb_sql.Stmt

const T_EOF = lexdb_parse.T_EOF
const T_IDENT = lexdb_parse.T_IDENT
const T_QIDENT = lexdb_parse.T_QIDENT
const T_NUM = lexdb_parse.T_NUM
const T_STR = lexdb_parse.T_STR
const T_PARAM = lexdb_parse.T_PARAM
const T_OP = lexdb_parse.T_OP

const MD_PG = lexdb_sql.MD_PG
const MD_TSQL = lexdb_sql.MD_TSQL
const MD_ORA = lexdb_sql.MD_ORA

pub const GRAPH_PRE = lexdb_catalog.GRAPH_PRE
pub const GRAPH_END = lexdb_catalog.GRAPH_END
pub const PGQ_SHORTEST_PRE = "#pgq_shortest:"

// A graph's catalog row's key.
pub fn graphKey(key: &str): str { return GRAPH_PRE + key }

// What the statements' module gives this one: a statement's columns (lexdb_exec.describe), and the catalog's version bumped.
pub type DescribeFn = fn(&lexdb_store.Store, &Stmt, &[]int, &[]str): Result[[]lexdb_bind.OutCol, DbErr]
pub type BumpFn = fn(&lexdb_store.Store, mut &lexdb_store.Txn): Result[Unit, DbErr]
pub type Up = value record {
    pub describe: DescribeFn
    pub bump: BumpFn
}

// A label's property: its name as Oracle shows it, its definition's text over the table's columns, the column it is (lexdb's
// name; "" for an expression), the columns its expression reads, its type.
pub type Prop = record {
    pub name: str
    pub expr: str
    pub col: str
    pub uses: []str
    pub typ: TypeName
}

pub type Label = record {
    pub name: str
    pub props: []Prop
}

// An edge's end: the vertex element, the edge table's columns and the vertex table's they equal.
pub type End = record {
    pub elem: str
    pub cols: []str
    pub refs: []str
}

pub type Elem = record {
    pub name: str               // the element's name (the table's, or its alias), as Oracle shows it
    pub vertex: bool
    pub table: str              // the table's catalog key
    pub keys: []str             // its key's columns (lexdb's names)
    pub labels: []Label
    pub src: End                // an edge's
    pub dst: End
}

pub type Graph = record {
    pub key: str                // its catalog key (a table's)
    pub name: str               // as Oracle shows it
    pub elems: []Elem
}

fn e(code: &str, msg: &str): DbErr { return lexdb_base.err(code, msg) }
fn ora(n: int, msg: &str): DbErr { return lexdb_base.err(&("ORA" + strings.padLeft(&(n.toStr()), 5, '0')), msg) }
fn tsErr(n: int, msg: &str): DbErr { return lexdb_base.err(&("TS" + n.toStr()), msg) }
fn gerr(oraMode: bool, n: int, pgCode: &str, msg: &str): DbErr { return if oraMode { ora(n, msg) } else { e(pgCode, msg) } }

// ---- the catalog row: its strings (lexdb_catalog.addStrs), in order

fn addList(xs: mut &[]str, l: &[]str) {
    append(xs, len(l).toStr())
    for x in l { append(xs, x.clone()) }
}

fn addEnd(xs: mut &[]str, d: &End) {
    append(xs, d.elem.clone())
    addList(xs, &d.cols)
    addList(xs, &d.refs)
}

pub fn encode(g: &Graph): str {
    var xs: []str = ["1", g.key.clone(), g.name.clone(), len(g.elems).toStr()]
    for el in g.elems {
        append(mut &xs, el.name.clone())
        append(mut &xs, if el.vertex { "v" } else { "e" })
        append(mut &xs, el.table.clone())
        addList(mut &xs, &el.keys)
        append(mut &xs, len(el.labels).toStr())
        for l in el.labels {
            append(mut &xs, l.name.clone())
            append(mut &xs, len(l.props).toStr())
            for p in l.props {
                append(mut &xs, p.name.clone())
                append(mut &xs, p.expr.clone())
                append(mut &xs, p.col.clone())
                addList(mut &xs, &p.uses)
                append(mut &xs, lexdb_catalog.typeStr(&p.typ))
            }
        }
        addEnd(mut &xs, &el.src)
        addEnd(mut &xs, &el.dst)
    }
    var b = ""
    lexdb_catalog.addStrs(mut &b, &xs)
    return b
}

type Rd = record { xs: []str; at: int }

fn (r: mut &Rd) s(): str {
    if r.at >= len(r.xs) { return "" }
    let v = r.xs[r.at].clone()
    r.at += 1
    return v
}

fn (r: mut &Rd) n(): int { return lexdb_base.num(&r.s()) }

fn (r: mut &Rd) list(): []str {
    var out: []str = []
    let n = r.n()
    for i in 0..n { append(mut &out, r.s()) }
    return out
}

fn (r: mut &Rd) end(): End {
    let el = r.s()
    let cols = r.list()
    return End{elem: el, cols: cols, refs: r.list()}
}

fn noEnd(): End { return End{elem: "", cols: [], refs: []} }

pub fn decode(v: &str): Graph {
    var r = Rd{xs: lexdb_catalog.strsAt(v, 0), at: 1}
    let key = r.s()
    let name = r.s()
    var g = Graph{key: key, name: name, elems: []}
    let ne = r.n()
    for i in 0..ne {
        let nm = r.s()
        let vx = r.s() == "v"
        let tb = r.s()
        let keys = r.list()
        var labels: []Label = []
        let nl = r.n()
        for j in 0..nl {
            let ln = r.s()
            var props: []Prop = []
            let np = r.n()
            for k in 0..np {
                let pn = r.s()
                let ex = r.s()
                let col = r.s()
                let uses = r.list()
                append(mut &props, Prop{name: pn, expr: ex, col: col, uses: uses, typ: lexdb_catalog.strType(&r.s())})
            }
            append(mut &labels, Label{name: ln, props: props})
        }
        let src = r.end()
        let dst = r.end()
        append(mut &g.elems, Elem{name: nm, vertex: vx, table: tb, keys: keys, labels: labels, src: src, dst: dst})
    }
    return g
}

// Every graph, as their catalog rows are (lexdb_catalog.catSnap keeps them for the dictionary views).
pub fn all(raw: &[]str): []Graph {
    var out: []Graph = []
    for v in raw { append(mut &out, decode(&v)) }
    return out
}

// Whether a view's text (of a view in schema) reads GRAPH_TABLE of a graph that is not there (USER_OBJECTS shows the view INVALID,
// and reading it is ORA-04063, as Oracle's; the fourth bug slice, design/lexdb-robust.md).
pub fn viewGraphGone(text: &str, schema: &str, graphs: &[]Graph): bool {
    if !strings.startsWith(text, lexdb_sql.ORA_VIEW) || !strings.contains(&strings.toLowerAscii(text), "graph_table") { return false }
    let kept = lexdb_sql.viewKept(text)
    let ts = match lexdb_parse.oraTokens(&kept[len(lexdb_sql.ORA_VIEW)..len(kept)]) {
        Ok(x) { x }
        Err(_) { return false }
    }
    for i in 0..len(ts) {
        if !(isName(&ts[i]) && strings.toLowerAscii(&ts[i].text) == "graph_table" && i + 2 < len(ts) && ts[i + 1].kind == T_OP && ts[i + 1].text == "(" && isName(&ts[i + 2])) { continue }
        var n = ts[i + 2].text.clone()
        if i + 4 < len(ts) && ts[i + 3].kind == T_OP && ts[i + 3].text == "." && isName(&ts[i + 4]) { n = lexdb_sql.qual(&n, &ts[i + 4].text) }
        var found = false
        for g in graphs {
            if g.key == n || (!lexdb_sql.isQual(&n) && lexdb_sql.baseName(&g.key) == n && (lexdb_sql.schemaOf(&g.key) == schema || lexdb_sql.schemaOf(&g.key) == "public")) { found = true }
            if lexdb_sql.isQual(&n) && lexdb_sql.schemaOf(&n) == "public" && g.key == lexdb_sql.baseName(&n) { found = true }
        }
        if !found { return true }
    }
    return false
}

// A property's expression's tokens (lexdb_oracat shows it as Oracle does), without the end; [] if it does not read.
pub fn exprToks(text: &str): []Tok {
    match lexdb_parse.oraTokens(text) {
        Ok(ts) {
            var out = ts
            let x = pop(mut &out)
            return out
        }
        Err(_) { return [] }
    }
}

fn readGraph(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str): Result[Option[Graph], DbErr] {
    match try st.get(txn, lexdb_catalog.CATALOG, &graphKey(key)) {
        Some(v) { return Ok(Some(decode(&v))) }
        None { return Ok(None) }
    }
}

// ---- names

// A name's token as its dialect keeps it: in Oracle bare upper case and quoted as written;
// in PostgreSQL bare lower case and quoted as written; in T-SQL case-insensitive (lower case).
fn canonIn(t: &Tok, md: int): str {
    if md == MD_ORA { return if len(t.spell) > 0 { t.spell.clone() } else { t.text.clone() } }
    if md == MD_TSQL { return t.text.clone() }
    return if t.kind == T_QIDENT && len(t.spell) > 0 { t.spell.clone() } else { t.text.clone() }
}

fn isName(t: &Tok): bool { return t.kind == T_IDENT || t.kind == T_QIDENT }

// A lexdb name as Oracle shows it (a column's, a schema's): upper case unless it was written so.
pub fn shownOf(n: &str, spell: &str): str {
    if len(spell) > 0 { return spell.toStr() }
    return lexdb_sql.oraShown(n)
}

fn shownIn(n: &str, spell: &str, md: int): str {
    if md == MD_ORA { return shownOf(n, spell) }
    if md == MD_TSQL { return n.toStr() }
    return if len(spell) > 0 { spell.toStr() } else { n.toStr() }
}

// A name quoted for SQL text in md (Oracle, PostgreSQL, or T-SQL).
fn qIn(n: &str, md: int): str {
    if md == MD_ORA { return "\"" + strings.replaceAll(&lexdb_sql.oraShown(n), "\"", "\"\"") + "\"" }
    return "\"" + strings.replaceAll(n, "\"", "\"\"") + "\""
}

// A relation's catalog key as SQL text.
fn relTextIn(key: &str, md: int): str {
    let sc = lexdb_sql.schemaOf(key)
    let outSc = if md == MD_TSQL && sc == "public" { "dbo".toStr() } else { sc }
    return qIn(&outSc, md) + "." + qIn(&lexdb_sql.baseName(key), md)
}

pub fn parseSql(sql: &str, md: int, nls: []str): Result[[]Stmt, DbErr] {
    if md == MD_ORA { return lexdb_parse.oraParseNls(sql, nls) }
    if md == MD_TSQL { return lexdb_parse.parseTsqlVars(sql, &nls) }
    return lexdb_parse.parse(sql)
}

fn schemaHas(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: &str): Result[bool, DbErr] {
    if sc == "public" { return Ok(true) }
    return Ok((try st.get(txn, lexdb_catalog.CATALOG, &("\x03" + sc))).isSome())
}

// The key of relation n (folded; qualified or not) along the transaction's path, "" none.
fn relKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[str, DbErr] {
    if lexdb_sql.isQual(n) || len(txn.sql.path) == 0 {
        let k = if lexdb_sql.schemaOf(n) == "public" { lexdb_sql.baseName(n) } else { n.toStr() }
        return Ok(if (try st.get(txn, lexdb_catalog.CATALOG, &k)).isSome() { k } else { "" })
    }
    let path = txn.sql.path.clone()
    for sc in path {
        let k = lexdb_sql.qual(&sc, n)
        if (try st.get(txn, lexdb_catalog.CATALOG, &k)).isSome() { return Ok(k) }
    }
    return Ok("")
}

// The key of graph n along the path, "" none.
fn graphOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[str, DbErr] {
    if lexdb_sql.isQual(n) || len(txn.sql.path) == 0 {
        let k = if lexdb_sql.schemaOf(n) == "public" { lexdb_sql.baseName(n) } else { n.toStr() }
        return Ok(if (try st.get(txn, lexdb_catalog.CATALOG, &graphKey(&k))).isSome() { k } else { "" })
    }
    let path = txn.sql.path.clone()
    for sc in path {
        let k = lexdb_sql.qual(&sc, n)
        if (try st.get(txn, lexdb_catalog.CATALOG, &graphKey(&k))).isSome() { return Ok(k) }
    }
    return Ok("")
}

// The key CREATE PROPERTY GRAPH n makes: in its schema, or the first on the path that exists.
fn newKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str, md: int): Result[str, DbErr] {
    if lexdb_sql.isQual(n) {
        let sc = lexdb_sql.schemaOf(n)
        if !(try schemaHas(st, txn, &sc)) {
            if md == MD_ORA { return Err(ora(1918, &("user '" + strings.toUpperAscii(&sc) + "' does not exist"))) }
            if md == MD_TSQL { return Err(tsErr(2760, &("The specified schema name \"" + sc + "\" either does not exist or you do not have permission to use it."))) }
            return Err(e("3F000", &("schema \"" + sc + "\" does not exist")))
        }
        return Ok(if sc == "public" { lexdb_sql.baseName(n) } else { n.toStr() })
    }
    let path = txn.sql.path.clone()
    for sc in path {
        if lexdb_base.isTempSchema(&sc) || sc == "pg_temp" { continue }
        if try schemaHas(st, txn, &sc) { return Ok(lexdb_sql.qual(&sc, n)) }
    }
    return Ok(n.toStr())
}

// Whether the database has had a property graph since the process started (bootstrap's look, or a CREATE PROPERTY GRAPH): a
// database without them reads nothing more where a table, view or sequence is made (freeKey).
var graphsSeen: bool = false

// At the start (lexdb_exec.bootstrap): whether there are graphs.
pub fn noteGraphs(st: &lexdb_store.Store): Result[Unit, DbErr] {
    var t = lexdb_store.begin()
    var any = false
    let r = st.scan(mut &t, lexdb_catalog.CATALOG, GRAPH_PRE, GRAPH_END, fn(en: &lexdb_store.Entry): bool {
        any = true
        return false
    })
    st.abort(t)
    let ok = try r
    if any { graphsSeen = true }
    return lexdb_assert.noteAsserts(st)         // (and the assertions': their names are taken too, O23)
}

// CREATE TABLE, VIEW, SEQUENCE ... of key k (lexdb_exec.createKey): Oracle's ORA-00955 where a graph has the name.
pub fn freeKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: str): Result[str, DbErr] {
    if graphsSeen && (try st.get(txn, lexdb_catalog.CATALOG, &graphKey(&k))).isSome() {
        return Err(e("42P07", &("relation \"" + lexdb_sql.baseName(&k) + "\" already exists")))
    }
    return lexdb_assert.freeKey(st, txn, k)
}

fn hasInt(xs: &[]int, x: int): bool {
    for y in xs { if y == x { return true } }
    return false
}

fn tableOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str): Result[Option[Table], DbErr] {
    match try st.get(txn, lexdb_catalog.CATALOG, key) {
        Some(v) { return Ok(Some(try lexdb_catalog.decTable(key, &v, lexdb_parse.parseExpr))) }
        None { return Ok(None) }
    }
}

fn colIdx(t: &Table, n: &str): int {
    for i in 0..len(t.cols) { if t.cols[i].name == n && t.cols[i].name != lexdb_catalog.ROWID { return i } }
    return -1
}

// ---- a token reader

type Rdr = record { toks: []Tok; pos: int; src: str; ora: bool; md: int }

fn readerIn(text: &str, md: int): Result[Rdr, DbErr] {
    let toks = try lexdb_parse.tokensIn(text, md)
    return Ok(Rdr{toks: toks, pos: 0, src: text.toStr(), ora: md == MD_ORA, md: md})
}

fn graphReaderIn(text: &str, md: int): Result[Rdr, DbErr] {
    let toks = try lexdb_parse.graphTokens(text, md)
    return Ok(Rdr{toks: toks, pos: 0, src: text.toStr(), ora: md == MD_ORA, md: md})
}

fn (r: &Rdr) peek(): &Tok { return &r.toks[r.pos] }
fn (r: &Rdr) at(k: int): &Tok { return &r.toks[if r.pos + k < len(r.toks) { r.pos + k } else { len(r.toks) - 1 }] }
fn (r: &Rdr) kw(w: &str): bool { return r.peek().kind == T_IDENT && r.peek().text == w }
fn (r: &Rdr) kwAt(k: int, w: &str): bool { return r.at(k).kind == T_IDENT && r.at(k).text == w }
fn (r: &Rdr) op(o: &str): bool { return r.peek().kind == T_OP && r.peek().text == o }
fn (r: &Rdr) opAt(k: int, o: &str): bool { return r.at(k).kind == T_OP && r.at(k).text == o }

fn (r: mut &Rdr) accept(w: &str): bool {
    if r.kw(w) {
        r.pos += 1
        return true
    }
    return false
}

fn (r: mut &Rdr) acceptOp(o: &str): bool {
    if r.op(o) {
        r.pos += 1
        return true
    }
    return false
}

fn (r: &Rdr) near(): DbErr {
    let t = r.peek()
    if t.kind == T_EOF { return gerr(r.ora, 921, "42601", if r.ora { "unexpected end of SQL command" } else { "syntax error at end of input" }) }
    if r.ora { return ora(900, &("invalid SQL statement near \"" + r.src[t.at..min(len(r.src), t.at + 20)] + "\"")) }
    return e("42601", &("syntax error at or near \"" + t.text + "\""))
}

fn (r: mut &Rdr) expectOp(o: &str): Result[Unit, DbErr] {
    if r.acceptOp(o) { return Ok(Unit{}) }
    if o == ")" { return Err(gerr(r.ora, 907, "42601", "missing right parenthesis")) }
    if o == "(" { return Err(gerr(r.ora, 906, "42601", "missing left parenthesis")) }
    return Err(r.near())
}

fn (r: mut &Rdr) expectKw(w: &str): Result[Unit, DbErr] {
    if r.accept(w) { return Ok(Unit{}) }
    return Err(gerr(r.ora, 2000, "42601", &("missing " + strings.toUpperAscii(w) + " keyword")))
}

// A name (its token), ORA-00931 / 42601 if none.
fn (r: mut &Rdr) nameTok(): Result[Tok, DbErr] {
    let t = r.peek().clone()
    if !isName(&t) { return Err(gerr(r.ora, 931, "42601", "missing identifier")) }
    r.pos += 1
    return Ok(t)
}

// [db.][schema.]name: folded, qualified with lexdb_sql.qual (dbo -> public in T-SQL); and the last part as its dialect shows it.
fn (r: mut &Rdr) relName(shown: mut &str): Result[str, DbErr] {
    let a = try r.nameTok()
    if r.md == MD_TSQL && r.op(".") && isName(r.at(1)) {
        r.pos += 1
        let b = try r.nameTok()
        if r.op(".") && isName(r.at(1)) {
            r.pos += 1
            let c = try r.nameTok()
            let old = replace(shown, canonIn(&c, r.md))
            return Ok(if b.text == "dbo" { c.text.clone() } else { lexdb_sql.qual(&b.text, &c.text) })
        }
        let old = replace(shown, canonIn(&b, r.md))
        return Ok(if a.text == "dbo" { b.text.clone() } else { lexdb_sql.qual(&a.text, &b.text) })
    }
    if r.op(".") && isName(r.at(1)) {
        r.pos += 1
        let b = try r.nameTok()
        let old = replace(shown, canonIn(&b, r.md))
        return Ok(lexdb_sql.qual(&a.text, &b.text))
    }
    let old = replace(shown, canonIn(&a, r.md))
    return Ok(a.text.clone())
}

// The end of the bracketed list or item that starts here: the position of the "," or ")" at depth 0.
fn (r: &Rdr) itemEnd(from: int): int {
    var d = 0
    var i = from
    while i < len(r.toks) && r.toks[i].kind != T_EOF {
        let t = &r.toks[i]
        if t.kind == T_OP {
            if t.text == "(" || t.text == "[" || t.text == "{" { d += 1 }
            else if t.text == ")" || t.text == "]" || t.text == "}" {
                if d == 0 { return i }
                d -= 1
            } else if t.text == "," && d == 0 { return i }
        }
        i += 1
    }
    return i
}

// The text of tokens [lo, hi).
fn (r: &Rdr) text(lo: int, hi: int): str {
    if lo >= hi { return "" }
    let end = if hi < len(r.toks) { r.toks[hi].at } else { len(r.src) }
    return strings.trim(&r.src[r.toks[lo].at..end]).toStr()
}

// ---- CREATE and DROP PROPERTY GRAPH

// The statement's tag (lexdb_exec runs it).
pub fn ddl(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &Stmt, up: &Up): Result[str, DbErr] {
    let md = s.mdialect
    let oraMode = md == MD_ORA
    if s.kind == lexdb_sql.S_DROP_GRAPH {
        let k = try graphOf(st, txn, &s.table)
        if len(k) == 0 {
            if s.ifFlag { return Ok("DROP PROPERTY GRAPH") }
            if md == MD_TSQL {
                let shown = if len(s.spell) > 0 { s.spell.clone() } else { lexdb_sql.baseName(&s.table).toStr() }
                return Err(tsErr(3701, &("Cannot drop the property graph '" + shown + "', because it does not exist or you do not have permission.")))
            }
            return Err(gerr(oraMode, 42421, "42704", "property graph does not exist"))
        }
        txn.del(lexdb_catalog.CATALOG, &graphKey(&k))
        try up.bump(st, txn)
        return Ok("DROP PROPERTY GRAPH")
    }
    let key = try newKey(st, txn, &s.table, md)
    if (try st.get(txn, lexdb_catalog.CATALOG, &graphKey(&key))).isSome() {
        if s.unique { return Ok("CREATE PROPERTY GRAPH") }
        if !s.ifFlag {
            let msg = if oraMode { "name is already used by an existing object".toStr() } else { "relation \"" + lexdb_sql.baseName(&key) + "\" already exists" }
            return Err(gerr(oraMode, 955, "42P07", &msg))
        }
    } else if (try st.get(txn, lexdb_catalog.CATALOG, &key)).isSome() || (try st.get(txn, lexdb_catalog.CATALOG, &lexdb_catalog.seqRow(&key))).isSome() {
        let msg = if oraMode { "name is already used by an existing object".toStr() } else { "relation \"" + lexdb_sql.baseName(&key) + "\" already exists" }
        return Err(gerr(oraMode, 955, "42P07", &msg))
    }
    let name = shownIn(&lexdb_sql.baseName(&key), &s.spell, md)
    let g = try define(st, txn, &s.index, &key, &name, up, md)
    try txn.put(lexdb_catalog.CATALOG, &graphKey(&key), &encode(&g))
    graphsSeen = true
    try up.bump(st, txn)
    return Ok("CREATE PROPERTY GRAPH")
}

// An element being read: its table too.
type Def = record { el: Elem; t: Table; srcAt: int; dstAt: int }

fn define(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, text: &str, key: &str, name: &str, up: &Up, md: int): Result[Graph, DbErr] {
    let oraMode = md == MD_ORA
    var r = try readerIn(text, md)
    if !(r.accept("vertex") || (!oraMode && r.accept("node"))) { return Err(gerr(oraMode, 2000, "42601", "missing VERTEX keyword")) }
    try r.expectKw("tables")
    try r.expectOp("(")
    var defs: []Def = []
    while true {
        append(mut &defs, try elemDef(st, txn, mut &r, true, &defs, up))
        if !r.acceptOp(",") { break }
    }
    try r.expectOp(")")
    if r.accept("edge") || (!oraMode && r.accept("relationship")) {
        try r.expectKw("tables")
        try r.expectOp("(")
        while true {
            append(mut &defs, try elemDef(st, txn, mut &r, false, &defs, up))
            if !r.acceptOp(",") { break }
        }
        try r.expectOp(")")
    }
    if r.peek().kind != T_EOF { return Err(gerr(oraMode, 922, "42601", "missing or invalid option")) }
    // a label of several elements (or given twice) has one set of properties, each of one type
    var seen: []Label = []
    for d in defs {
        for l in d.el.labels {
            var at = -1
            for i in 0..len(seen) { if seen[i].name == l.name { at = i } }
            if at < 0 {
                append(mut &seen, l.clone())
                continue
            }
            var same = len(seen[at].props) == len(l.props)
            for p in l.props {
                var found = false
                for x in seen[at].props { if x.name == p.name { found = true } }
                if !found { same = false }
            }
            if !same { return Err(gerr(oraMode, 42409, "42710", &("label " + l.name + " already defined"))) }
            for p in l.props {
                for x in seen[at].props {
                    if x.name == p.name && family(&x.typ) != family(&p.typ) {
                        return Err(gerr(oraMode, 42414, "42804", &("cannot use mixed type for property " + p.name + " of label " + l.name)))
                    }
                }
            }
        }
    }
    var g = Graph{key: key.toStr(), name: name.toStr(), elems: []}
    for d in defs { append(mut &g.elems, d.el.clone()) }
    return Ok(g)
}

// The kind of type Oracle tells apart in a label's property (ORA-42414): number, text, date, timestamp, ...
fn family(t: &TypeName): int {
    let k = t.kind
    if k == lexdb_sql.K_INT || k == lexdb_sql.K_NUM || k == lexdb_sql.K_FLOAT { return 1 }
    if k == lexdb_sql.K_TEXT { return 2 }
    return 10 + k
}

// One element table of VERTEX TABLES (vertex) or EDGE TABLES.
fn elemDef(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, r: mut &Rdr, vertex: bool, defs: &[]Def, up: &Up): Result[Def, DbErr] {
    var shown = ""
    let rn = try r.relName(mut &shown)
    let tk = try relKey(st, txn, &rn)
    if len(tk) == 0 { return Err(gerr(r.ora, 942, "42P01", &("table or view \"" + shown + "\" does not exist"))) }
    let t = (try tableOf(st, txn, &tk)).unwrap()
    var ename = shown.clone()
    let words = ["key", "label", "default", "properties", "no", "source", "destination"]
    if r.accept("as") {
        ename = canonIn(&(try r.nameTok()), r.md)
    } else if isName(r.peek()) && !(r.peek().kind == T_IDENT && lexdb_base.hasStr(&words, &r.peek().text)) {
        ename = canonIn(&(try r.nameTok()), r.md)
    }
    for d in defs { if d.el.name == ename { return Err(gerr(r.ora, 42404, "42710", &("graph element table name " + ename + " already defined"))) } }
    var el = Elem{name: ename.clone(), vertex: vertex, table: tk.clone(), keys: [], labels: [], src: noEnd(), dst: noEnd()}
    if r.accept("key") {
        el.keys = try colList(r, &t)
        for i in 0..len(el.keys) {
            for j in 0..i {
                if el.keys[i] == el.keys[j] { return Err(gerr(r.ora, 42416, "42701", &("duplicate column name " + shownIn(&el.keys[i], &"", r.md) + " in key definition"))) }
            }
        }
    } else {
        if lexdb_catalog.hasPk(&t) { for p in t.pk { append(mut &el.keys, t.cols[p].name.clone()) } }
        if len(el.keys) == 0 {
            return Err(if len(t.view) > 0 { gerr(r.ora, 42442, "42P10", &("KEY is not specified for view graph element table " + shown + ".")) } else { gerr(r.ora, 42402, "42P10", &("cannot infer key for graph element table " + shown)) })
        }
    }
    if !vertex {
        if !r.accept("source") { return Err(gerr(r.ora, 2000, "42601", "missing SOURCE keyword")) }
        el.src = try endDef(st, txn, r, &t, &el.name, defs)
        if !r.accept("destination") { return Err(gerr(r.ora, 2000, "42601", "missing DESTINATION keyword")) }
        el.dst = try endDef(st, txn, r, &t, &el.name, defs)
    }
    // its labels and properties: LABEL l [props] | DEFAULT LABEL [props], or props alone (the default label's); none: the
    // default label (the element's name) with every column
    var any = false
    while true {
        if r.accept("label") {
            let l = canonIn(&(try r.nameTok()), r.md)
            append(mut &el.labels, Label{name: l, props: try propsDef(st, txn, r, &t, &tk, up)})
            any = true
        } else if r.kw("default") && r.kwAt(1, "label") {
            r.pos += 2
            append(mut &el.labels, Label{name: el.name.clone(), props: try propsDef(st, txn, r, &t, &tk, up)})
            any = true
        } else if !any && (r.kw("properties") || (r.kw("no") && r.kwAt(1, "properties"))) {
            append(mut &el.labels, Label{name: el.name.clone(), props: try propsDef(st, txn, r, &t, &tk, up)})
            any = true
            break
        } else {
            break
        }
    }
    if !any { append(mut &el.labels, Label{name: el.name.clone(), props: allCols(&t, &[], r.md)}) }
    for l in el.labels {
        for i in 0..len(l.props) {
            for j in 0..i {
                if l.props[i].name == l.props[j].name { return Err(gerr(r.ora, 42407, "42701", &("duplicate property name in label " + l.name + " : " + l.props[i].name))) }
            }
        }
    }
    return Ok(Def{el: el, t: t, srcAt: -1, dstAt: -1})
}

// (col, ...): the columns of t (lexdb's names), ORA-00904 / 42703 for one it has not.
fn colList(r: mut &Rdr, t: &Table): Result[[]str, DbErr] {
    try r.expectOp("(")
    var out: []str = []
    if r.op(")") { return Err(gerr(r.ora, 936, "42601", "missing expression")) }
    while true {
        let c = try r.nameTok()
        if colIdx(t, &c.text) < 0 { return Err(gerr(r.ora, 904, "42703", &("\"" + canonIn(&c, r.md) + "\": invalid identifier"))) }
        append(mut &out, c.text.clone())
        if !r.acceptOp(",") { break }
    }
    try r.expectOp(")")
    return Ok(out)
}

// An edge's SOURCE or DESTINATION: [KEY (cols) REFERENCES] vertex [(cols)], or the vertex alone (the edge table's one foreign
// key to the vertex table).
fn endDef(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, r: mut &Rdr, t: &Table, edge: &str, defs: &[]Def): Result[End, DbErr] {
    var cols: []str = []
    let keyed = r.accept("key")
    if keyed {
        cols = try colList(r, t)
        try r.expectKw("references")
    }
    let vt = try r.nameTok()
    let vn = canonIn(&vt, r.md)
    var vi = -1
    for i in 0..len(defs) { if defs[i].el.vertex && defs[i].el.name == vn { vi = i } }
    if vi < 0 { return Err(gerr(r.ora, 42405, "42P01", &("Referenced vertex table " + vn + " does not exist."))) }
    let v = &defs[vi]
    var refs: []str = []
    if r.op("(") { refs = try colList(r, &v.t) } else { for k in v.el.keys { append(mut &refs, k.clone()) } }
    if !keyed {
        // the foreign key from the edge table to the vertex table, if it has one only
        var found = 0
        for f in t.fks {
            if f.ref == v.el.table {
                found += 1
                cols = f.cols.clone()
                refs = f.refCols.clone()
            }
        }
        if found > 1 { return Err(gerr(r.ora, 42431, "42P10", &("ambiguous edge relationship for graph edge table " + edge))) }
        if found != 1 { return Err(gerr(r.ora, 42413, "42P10", &("cannot infer edge relationship for edge table " + edge))) }
    }
    if len(cols) != len(refs) { return Err(gerr(r.ora, 42415, "42P10", "missing key column in edge reference definition")) }
    return Ok(End{elem: vn, cols: cols, refs: refs})
}

// Every column of t as a property, but those in except.
fn allCols(t: &Table, except: &[]str, md: int): []Prop {
    var out: []Prop = []
    for c in t.cols {
        if c.name == lexdb_catalog.ROWID || lexdb_base.hasStr(except, &c.name) { continue }
        append(mut &out, Prop{name: shownIn(&c.name, &c.spell, md), expr: c.name.clone(), col: c.name.clone(), uses: [c.name.clone()], typ: viewTyp(t, &c.typ)})
    }
    return out
}

// The functions a property's expression may not call (only pure/immutable functions).
fn impureIn(w: &str, md: int): bool {
    match w.toStr() {
        "sysdate", "systimestamp", "current_date", "current_timestamp", "localtimestamp", "sys_guid", "dbms_random", "user", "uid",
        "userenv", "sys_context", "rownum", "level", "dbtimezone", "sessiontimezone", "uuid" { return true }
        "random", "gen_random_uuid", "now", "clock_timestamp", "statement_timestamp", "timeofday" { return md != MD_ORA }
        "getdate", "getutcdate", "sysdatetime", "sysutcdatetime", "sysdatetimeoffset", "newid", "rand", "user_name", "suser_sname", "db_name", "host_name", "app_name" { return md == MD_TSQL }
        else { return false }
    }
}

// PROPERTIES (item, ...) | PROPERTIES [ARE] ALL COLUMNS [EXCEPT (cols)] | NO PROPERTIES; none: every column.
fn propsDef(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, r: mut &Rdr, t: &Table, tk: &str, up: &Up): Result[[]Prop, DbErr] {
    if r.kw("no") && r.kwAt(1, "properties") {
        r.pos += 2
        return Ok([])
    }
    if !r.accept("properties") { return Ok(allCols(t, &[], r.md)) }
    let are = r.accept("are")
    if r.accept("all") {
        try r.expectKw("columns")
        var except: []str = []
        if r.accept("except") { except = try colList(r, t) }
        return Ok(allCols(t, &except, r.md))
    }
    if are { return Err(gerr(r.ora, 2000, "42601", "missing ALL keyword")) }
    try r.expectOp("(")
    if r.op(")") { return Err(gerr(r.ora, 936, "42601", "missing expression")) }
    var out: []Prop = []
    var exprs: []int = []          // the expressions' places in out
    var sel = ""
    while true {
        let lo = r.pos
        let hi = r.itemEnd(lo)
        if lo == hi { return Err(gerr(r.ora, 936, "42601", "missing expression")) }
        // [expr] [AS name]
        var end = hi
        var pname = ""
        if hi - lo >= 2 && r.toks[hi - 2].kind == T_IDENT && r.toks[hi - 2].text == "as" && isName(&r.toks[hi - 1]) {
            pname = canonIn(&r.toks[hi - 1], r.md)
            end = hi - 2
        }
        if end - lo == 1 && isName(&r.toks[lo]) {
            let c = &r.toks[lo]
            let ci = colIdx(t, &c.text)
            if ci < 0 && c.kind == T_IDENT && impureIn(&c.text, r.md) { return Err(gerr(r.ora, 42439, "42P17", "only pure functions can be specified in a column expression used to define a property")) }
            if ci < 0 { return Err(gerr(r.ora, 904, "42703", &("\"" + canonIn(c, r.md) + "\": invalid identifier"))) }
            if len(pname) == 0 { pname = shownIn(&t.cols[ci].name, &t.cols[ci].spell, r.md) }
            append(mut &out, Prop{name: pname, expr: c.text.clone(), col: c.text.clone(), uses: [c.text.clone()], typ: viewTyp(t, &t.cols[ci].typ)})
        } else {
            if len(pname) == 0 { return Err(gerr(r.ora, 42424, "42601", "An expression based label property definition must use the AS clause.")) }
            var uses: []str = []
            for i in lo..end {
                let x = &r.toks[i]
                if x.kind == T_IDENT && impureIn(&x.text, r.md) { return Err(gerr(r.ora, 42439, "42P17", "only pure functions can be specified in a column expression used to define a property")) }
                if isName(x) && !(i + 1 < end && r.toks[i + 1].kind == T_OP && r.toks[i + 1].text == "(") && !(i > lo && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") &&
                   colIdx(t, &x.text) >= 0 && !lexdb_base.hasStr(&uses, &x.text) {
                    append(mut &uses, x.text.clone())
                }
            }
            let ex = r.text(lo, end)
            if len(sel) > 0 { sel += ", " }
            sel += "(" + ex + ")"
            append(mut &exprs, len(out))
            append(mut &out, Prop{name: pname, expr: ex, col: "", uses: uses, typ: lexdb_sql.TypeName{kind: lexdb_sql.K_TEXT, oid: lexdb_sql.OID_TEXT, prec: 0, scale: 0, len: 0}})
        }
        r.pos = hi
        if !r.acceptOp(",") { break }
    }
    try r.expectOp(")")
    if len(exprs) > 0 {
        // the expressions' types: as a query of the table gives them
        var ss = try parseSql(&("select " + sel + " from " + relTextIn(tk, r.md)), r.md, [])
        let none: []int = []
        let cols = try up.describe(st, &ss[0], &none, &txn.sql.path)
        for i in 0..len(exprs) {
            if i >= len(cols) { continue }
            var ty = lexdb_catalog.typeOfMod(cols[i].oid, -1)
            // (a query's text column has no length: an expression's is its text columns' longest, or their sum for ||/+, else 4,000)
            if ty.kind == lexdb_sql.K_TEXT && ty.len == 0 { ty.len = textLen(t, &out[exprs[i]]) }
            out[exprs[i]].typ = ty
        }
    }
    return Ok(out)
}

fn textLen(t: &Table, p: &Prop): int {
    var most = 0
    var sum = 0
    for u in p.uses {
        let ci = colIdx(t, &u)
        if ci >= 0 && t.cols[ci].typ.kind == lexdb_sql.K_TEXT && t.cols[ci].typ.len > 0 {
            sum += t.cols[ci].typ.len
            if t.cols[ci].typ.len > most { most = t.cols[ci].typ.len }
        }
    }
    let n = if strings.contains(&p.expr, "||") || strings.contains(&p.expr, "+") { sum } else { most }
    return if n > 0 && n <= 4000 { n } else { 4000 }
}

// ---- GRAPH_TABLE

pub fn isGraph(s: &Stmt): bool { return s.srf == lexdb_sql.GRAPH_MARK }

// A GRAPH_TABLE subquery (isGraph) as the query it stands for, parsed, to be planned in its place.
pub fn expand(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &Stmt): Result[Stmt, DbErr] {
    let md = s.mdialect
    var gt = try parseGT(st, txn, &s.index, md)
    if gt.shortest { return expandShortest(st, txn, &gt, md, s.names.clone()) }
    let sql = try rewriteIn(st, txn, &s.index, md)
    var ss = try parseSql(&sql, md, s.names.clone())
    if len(ss) != 1 { return Err(lexdb_base.corrupt("GRAPH_TABLE's query")) }
    var out = pop(mut &ss)
    out.use = lexdb_sql.SUB_FROM
    out.mdialect = s.mdialect
    return Ok(out)
}

// GRAPH_TABLE's text as the SQL of its query (exec_graph's tests compare the two).
pub fn rewriteText(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, text: &str): Result[str, DbErr] { return rewriteIn(st, txn, text, MD_ORA) }

const DIR_R = 1                 // ->
const DIR_L = 2                 // <-
const DIR_ANY = 3               // -

// An element pattern: (v IS l WHERE c) or -[e IS l WHERE c]->: its variable ("" none), label expression (an OR of ANDs; []
// none), WHERE's tokens [wlo, whi) (wlo -1 none), an edge's direction.
type EP = record {
    vertex: bool
    vname: str
    lab: [][]str
    wlo: int
    whi: int
    dir: int
}

// A path's item: an element pattern, or a bracketed path (sub) with its quantifier; an edge with a quantifier is a path of one.
type PI = record {
    group: bool
    ep: EP
    sub: []PI
    lo: int
    hi: int
    gid: int
}

// A variable as the pattern declares it: a vertex's or an edge's, of a quantified part (group >= 0) or not.
type Decl = record {
    name: str
    vertex: bool
    group: int
    labs: [][][]str             // its label expressions (each must hold)
}

// A COLUMNS item: its tokens, its name.
type Col = record {
    lo: int
    hi: int
    name: str
    vname: str                    // var.prop alone (or var.* expanded): the variable and the property
    prop: str
    matchnum: bool
}

// The parsed GRAPH_TABLE.
type GT = record {
    r: Rdr
    ora: bool
    md: int
    g: Graph
    tabs: []Table               // per element, its table
    paths: [][]PI
    decls: []Decl
    groups: []int               // per quantified part, its count of lengths ([lo, hi]: hi - lo + 1)
    glo: []int
    ghi: []int
    wlo: int                    // MATCH's WHERE
    whi: int
    cols: []Col
    owner: str
    allCols: []str              // every column of every element table (a bare name that is one is an undeclared variable)
    shortest: bool              // MATCH [p =] ANY SHORTEST [PATH] ...
    pathVar: str                // optional path variable name (p)
}

// A variable of one expansion: its occurrences' constraints.
type Var = record {
    name: str                   // its own (a quantified part's copies: name#gid.copy)
    base: str                   // the pattern's
    vertex: bool
    group: int
    copy: int
    labs: [][][]str
    wheres: []Wh
    rep: int                    // the variable it is one with (two vertex patterns side by side); its own index if none
}

type Wh = value record { lo: int; hi: int; group: int; copy: int }

// An edge pattern's place in one expansion: the edge, the vertices on its left and right, its direction.
type Occ = value record { e: int; x: int; y: int; dir: int }

// One expansion: its variables and edges.
type Exp = record {
    vars: []Var
    occs: []Occ
    counts: []int               // per quantified part, its length here
}

fn noEP(): EP { return EP{vertex: true, vname: "", lab: [], wlo: -1, whi: -1, dir: 0} }

fn rewriteIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, text: &str, md: int): Result[str, DbErr] {
    var mn = false
    let branches = try branchTextsIn(st, txn, text, md, mut &mn)
    let body = strings.join(&branches, " union all ")
    if !mn { return Ok(body) }
    // MATCHNUM(): the matches numbered (the names: the first branch's columns)
    var gt = try parseGT(st, txn, text, md)
    var sel: []str = []
    let rn = if md == MD_ORA { "row_number() over (order by null) " } else { "row_number() over () " }
    for c in gt.cols {
        if c.matchnum { append(mut &sel, rn + qIn(&c.name, md)) } else { append(mut &sel, "\"gt$m\"." + qIn(&c.name, md) + " " + qIn(&c.name, md)) }
    }
    return Ok("select " + strings.join(&sel, ", ") + " from (" + body + ") \"gt$m\"")
}

// The joins GRAPH_TABLE's text stands for, each a SELECT (their UNION ALL its query); mn: it has MATCHNUM().
fn branchTextsIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, text: &str, md: int, mn: mut &bool): Result[[]str, DbErr] {
    var gt = try parseGT(st, txn, text, md)
    // the lengths of each quantified part: every combination, an expansion
    var exps: []Exp = []
    var counts: []int = []
    for i in 0..len(gt.glo) { append(mut &counts, gt.glo[i]) }
    while true {
        append(mut &exps, try expansion(&gt, &counts))
        var k = len(counts) - 1
        while k >= 0 {
            if counts[k] < gt.ghi[k] {
                counts[k] += 1
                break
            }
            counts[k] = gt.glo[k]
            k -= 1
        }
        if k < 0 { break }
        if len(exps) > 4096 { return Err(e("0A000", "lexdb: GRAPH_TABLE's pattern has too many lengths (more than 4,096 combinations)")) }
    }
    try checkRefs(&gt)
    var branches: []str = []
    for x in exps { try branchesOf(&gt, &x, mut &branches) }
    if len(branches) > 4096 { return Err(e("0A000", "lexdb: GRAPH_TABLE's pattern stands for more than 4,096 joins")) }
    if len(branches) == 0 {
        // nothing can match: the first expansion with its first elements, under a false condition (for the columns' types)
        try fallback(&gt, &exps[0], mut &branches)
    }
    for c in gt.cols { if c.matchnum { let old = replace(mn, true) } }
    return Ok(branches)
}

// ---- a query of GRAPH_TABLE alone written as its join (a subquery in FROM costs the row engine a copy of each row)

// Whether a statement reads GRAPH_TABLE in its own FROM (the parser marks such a statement: Stmt.udf).
pub fn hasGraph(s: &Stmt): bool {
    for f in s.from { if f.sub >= 0 && f.sub < len(s.subs) && isGraph(&s.subs[f.sub]) { return true } }
    return false
}

// SELECT ... FROM GRAPH_TABLE (...) [alias] [WHERE ...] [GROUP BY ...] [ORDER BY ...] whose pattern is one join (no UNION ALL, no
// MATCHNUM), and no other FROM item or subquery: the statement with that join in FROM, its conditions added to WHERE, and each
// GRAPH_TABLE column it names its COLUMNS expression. None where that does not hold (or a name is not one of GRAPH_TABLE's
// columns): the subquery is planned as it is (lexdb_exec.bindFrom, expand).
pub fn flatQuery(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &Stmt): Result[Option[Stmt], DbErr] {
    if s.kind != lexdb_sql.S_SELECT || s.setop != 0 || len(s.from) != 1 || len(s.subs) != 1 || len(s.windows) > 0 || len(s.mr) > 0 ||
       s.lockMode != 0 || len(s.into) > 0 || s.waitFor || len(s.inner) > 0 || len(s.distinctOn) > 0 {
        return Ok(None)
    }
    let f = &s.from[0]
    if f.sub != 0 || !isGraph(&s.subs[0]) || len(f.cols) > 0 || f.lateral { return Ok(None) }
    let g = &s.subs[0]
    if strings.contains(&strings.toLowerAscii(&g.index), "shortest") { return Ok(None) }
    let md = g.mdialect
    var mn = false
    let branches = try branchTextsIn(st, txn, &g.index, md, mut &mn)
    if len(branches) > 1 && !mn { return unionOnly(s, &branches, md) }
    if len(branches) != 1 || mn { return Ok(None) }
    var bs = try parseSql(&branches[0], md, g.names.clone())
    if len(bs) != 1 { return Ok(None) }
    let b = pop(mut &bs)
    if len(b.subs) > 0 || len(b.wins) > 0 || len(b.group) > 0 { return Ok(None) }
    var names: []str = []
    var exprs: []Expr = []
    for it in b.items {
        match it.expr {
            Some(x) {
                append(mut &names, it.alias.clone())
                append(mut &exprs, lexdb_sql.cloneExpr(&x))
            }
            None { return Ok(None) }
        }
    }
    var own: []str = []                 // the select list's own aliases (ORDER BY and GROUP BY may name them)
    for it in s.items { if len(it.alias) > 0 { append(mut &own, it.alias.clone()) } }
    let sb = Sub{al: f.alias.clone(), names: names, exprs: exprs, own: []}
    var miss = false
    var out = s.clone()
    out.subs = []
    out.udf = false
    out.from = b.from.clone()
    if b.params > out.params { out.params = b.params }
    var items: []lexdb_sql.SelItem = []
    for it in s.items {
        if it.star {
            if len(it.qual) > 0 && it.qual != f.alias { return Ok(None) }
            for x in b.items { append(mut &items, x.clone()) }
            continue
        }
        var n = it.clone()
        match it.expr {
            Some(x) {
                n.expr = Some(subst(&x, &sb, mut &miss))
                // a column of GRAPH_TABLE's named alone keeps its name
                if len(it.alias) == 0 {
                    match x {
                        Expr.Col(cn, _) {
                            let k = colAt(&sb, &cn)
                            if k >= 0 {
                                n.alias = b.items[k].alias.clone()
                                n.spell = b.items[k].spell.clone()
                            }
                        }
                        else {}
                    }
                }
            }
            None {}
        }
        append(mut &items, n)
    }
    out.items = items
    var sw: Option[Expr] = None
    match &s.where {
        Some(w) { sw = Some(subst(&w, &sb, mut &miss)) }
        None {}
    }
    out.where = andOf(&b.where, sw)
    let sbo = Sub{al: f.alias.clone(), names: sb.names.clone(), exprs: sb.exprs.clone(), own: own}
    var group: []Expr = []
    for x in s.group { append(mut &group, subst(&x, &sbo, mut &miss)) }
    out.group = group
    out.having = match &s.having {
        Some(h) { Some(subst(&h, &sbo, mut &miss)) }
        None { None }
    }
    var order: []lexdb_sql.OrderItem = []
    for o in s.order { append(mut &order, lexdb_sql.OrderItem{expr: subst(&o.expr, &sbo, mut &miss), desc: o.desc, nullsFirst: o.nullsFirst}) }
    out.order = order
    var wins: []lexdb_sql.WinDef = []
    for w in s.wins {
        var d = w.clone()
        d.call = subst(&w.call, &sb, mut &miss)
        var part: []Expr = []
        for x in w.part { append(mut &part, subst(&x, &sb, mut &miss)) }
        d.part = part
        var wo: []lexdb_sql.WinOrder = []
        for o in w.order { append(mut &wo, lexdb_sql.WinOrder{expr: subst(&o.expr, &sb, mut &miss), desc: o.desc, nullsFirst: o.nullsFirst}) }
        d.order = wo
        append(mut &wins, d)
    }
    out.wins = wins
    if miss { return Ok(None) }
    return Ok(Some(out))
}

type Expr = lexdb_sql.Expr

// SELECT * FROM GRAPH_TABLE (...) [ORDER BY positions] whose pattern is several joins: their UNION ALL itself (with the ORDER BY).
fn unionOnly(s: &Stmt, branches: &[]str, md: int): Result[Option[Stmt], DbErr] {
    if len(s.items) != 1 || !s.items[0].star || s.where.isSome() || len(s.group) > 0 || s.having.isSome() || s.distinct ||
       len(s.wins) > 0 || s.limit.isSome() || s.offset.isSome() || len(s.gsets) > 0 {
        return Ok(None)
    }
    var text = strings.join(branches, " union all ")
    var ord: []str = []
    for o in s.order {
        let k = lexdb_sql.litInt(&o.expr)
        if k < 1 { return Ok(None) }
        append(mut &ord, k.toStr() + (if o.desc { " desc" } else { "" }) + (if o.nullsFirst { " nulls first" } else { " nulls last" }))
    }
    if len(ord) > 0 { text += " order by " + strings.join(&ord, ", ") }
    var ss = try parseSql(&text, md, s.subs[0].names.clone())
    if len(ss) != 1 { return Ok(None) }
    var out = pop(mut &ss)
    out.mdialect = s.mdialect
    if s.params > out.params { out.params = s.params }
    return Ok(Some(out))
}

fn andOf(a: &Option[Expr], b: Option[Expr]): Option[Expr] {
    match a {
        Some(x) {
            match b {
                Some(y) { return Some(Expr.Bin("and", lexdb_sql.cloneExpr(&x), y)) }
                None { return Some(lexdb_sql.cloneExpr(&x)) }
            }
        }
        None { return b }
    }
}

// GRAPH_TABLE's columns (names folded, as the select list's aliases) and their expressions, the FROM item's alias, the select
// list's own aliases (a name of ORDER BY or GROUP BY that is one of them is left as it is).
type Sub = record { al: str; names: []str; exprs: []Expr; own: []str }

// The column of GRAPH_TABLE a name is (alias.name or name), -1 none.
fn colAt(sb: &Sub, n: &str): int {
    var c = n.toStr()
    if strings.contains(n, ".") {
        if !strings.startsWith(n, &(sb.al + ".")) { return -1 }
        c = n[len(sb.al) + 1..len(n)].toStr()
    }
    for i in 0..len(sb.names) { if sb.names[i] == c { return i } }
    return -1
}

// x with GRAPH_TABLE's columns made their expressions; miss: a name that is none of them (nor, sb.own, a select alias).
fn subst(x: &Expr, sb: &Sub, miss: mut &bool): Expr {
    match x {
        Expr.Col(n, _) {
            let k = colAt(sb, n)
            if k >= 0 { return lexdb_sql.cloneExpr(&sb.exprs[k]) }
            if !(len(n) > 0 && n[0] == '#') && !lexdb_base.hasStr(&sb.own, n) { let old = replace(miss, true) }
            return lexdb_sql.cloneExpr(x)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), subst(&a, sb, miss)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), subst(&a, sb, miss), subst(&b, sb, miss)) }
        Expr.IsNull(a, not) { return Expr.IsNull(subst(&a, sb, miss), not) }
        Expr.Call(n, args, star) {
            if lexdb_sql.isSubCall(n) {
                let old = replace(miss, true)
                return lexdb_sql.cloneExpr(x)
            }
            var xs: []Expr = []
            for y in args { append(mut &xs, subst(&y, sb, miss)) }
            return Expr.Call(n.clone(), xs, star)
        }
        Expr.Cast(a, t) { return Expr.Cast(subst(&a, sb, miss), t) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// ---- reading GRAPH_TABLE's text

fn parseGT(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, text: &str, md: int): Result[GT, DbErr] {
    let oraMode = md == MD_ORA
    var r = try graphReaderIn(text, md)
    var shown = ""
    let gn = try r.relName(mut &shown)
    let gk = try graphOf(st, txn, &gn)
    if len(gk) == 0 {
        if md == MD_TSQL { return Err(tsErr(208, &("Invalid object name '" + shown + "'."))) }
        return Err(gerr(oraMode, 42421, "42704", "property graph does not exist"))
    }
    let g = (try readGraph(st, txn, &gk)).unwrap()
    let sc = lexdb_sql.schemaOf(&gk)
    let owner = if oraMode {
        if sc == "public" { strings.toUpperAscii(&st.memo.get(&lexdb_catalog.userKey(txn.sql.sess)).unwrapOr("lexdb")) } else { shownOf(&sc, &"") }
    } else if md == MD_TSQL {
        if sc == "public" { "dbo".toStr() } else { sc.clone() }
    } else {
        sc.clone()
    }
    // its tables and columns as they are now: one gone makes the graph invalid
    var tabs: []Table = []
    var allCols: []str = []
    // (with its cause on a second line, as Oracle's: a table gone, ORA-00942, before a column, ORA-00904)
    let bad = "errors during recompilation or revalidation of " + owner + "." + g.name
    for el in g.elems {
        if (try tableOf(st, txn, &el.table)).isNone() {
            if oraMode {
                return Err(ora(4045, &(bad + "\nORA-00942: table or view \"" + owner + "\".\"" + strings.toUpperAscii(&lexdb_sql.baseName(&el.table)) + "\" does not exist")))
            }
            return Err(e("42P01", &("property graph \"" + g.name + "\" references missing relation \"" + lexdb_sql.baseName(&el.table) + "\"")))
        }
    }
    for el in g.elems {
        let t = (try tableOf(st, txn, &el.table)).unwrap()
        var need: []str = []
        for k in el.keys { append(mut &need, k.clone()) }
        for k in el.src.cols { append(mut &need, k.clone()) }
        for k in el.dst.cols { append(mut &need, k.clone()) }
        for l in el.labels { for p in l.props { for u in p.uses { append(mut &need, u.clone()) } } }
        for n in need {
            if colIdx(&t, &n) < 0 {
                if oraMode {
                    return Err(ora(4045, &(bad + "\nORA-00904: \"" + strings.toUpperAscii(&n) + "\": invalid identifier")))
                }
                return Err(e("42703", &("property graph \"" + g.name + "\" references missing column \"" + n + "\"")))
            }
        }
        for c in t.cols { if !lexdb_base.hasStr(&allCols, &c.name) { append(mut &allCols, c.name.clone()) } }
        append(mut &tabs, t)
    }
    // (an edge's vertex columns are its vertex's key: checked with it)
    var gt = GT{r: Rdr{toks: [], pos: 0, src: "", ora: oraMode, md: md}, ora: oraMode, md: md, g: g, tabs: tabs, paths: [], decls: [], groups: [], glo: [], ghi: [], wlo: -1, whi: -1, cols: [], owner: owner, allCols: allCols, shortest: false, pathVar: ""}
    if !r.accept("match") { return Err(gerr(oraMode, 2000, "42601", "missing MATCH keyword")) }
    if isName(r.peek()) && r.opAt(1, "=") && r.kwAt(2, "any") && r.kwAt(3, "shortest") {
        gt.pathVar = canonIn(r.peek(), md)
        gt.shortest = true
        r.pos += 4
        let _ = r.accept("path")
    } else if r.kw("any") && r.kwAt(1, "shortest") {
        gt.shortest = true
        r.pos += 2
        let _ = r.accept("path")
    }
    while true {
        var path: []PI = []
        try pathOf(mut &r, mut &gt, mut &path, -1, 0)
        if len(path) == 0 { return Err(gerr(oraMode, 40997, "42601", "invalid path pattern expression is specified in a GRAPH_TABLE operator")) }
        append(mut &gt.paths, path)
        if !r.acceptOp(",") { break }
    }
    if r.accept("where") {
        gt.wlo = r.pos
        var d = 0
        while r.peek().kind != T_EOF {
            if r.op("(") { d += 1 } else if r.op(")") { d -= 1 }
            if d == 0 && (r.kw("columns") || (r.kw("one") && r.kwAt(1, "row"))) { break }
            r.pos += 1
        }
        gt.whi = r.pos
        if gt.whi == gt.wlo { return Err(gerr(oraMode, 936, "42601", "missing expression")) }
    }
    if r.kw("one") && r.kwAt(1, "row") && r.kwAt(2, "per") {
        r.pos += 3
        if r.accept("vertex") || r.accept("step") {
            return Err(e("0A000", "lexdb: GRAPH_TABLE's ONE ROW PER VERTEX and ONE ROW PER STEP are not supported (ONE ROW PER MATCH is)"))
        }
        try r.expectKw("match")
    }
    if !r.accept("columns") { return Err(gerr(oraMode, 40997, "42601", "invalid path pattern expression is specified in a GRAPH_TABLE operator")) }
    try r.expectOp("(")
    if r.op(")") { return Err(gerr(oraMode, 936, "42601", "missing expression")) }
    while true {
        let lo = r.pos
        let hi = r.itemEnd(lo)
        if lo == hi { return Err(gerr(oraMode, 936, "42601", "missing expression")) }
        try colItem(&r, mut &gt, lo, hi)
        r.pos = hi
        if !r.acceptOp(",") { break }
    }
    try r.expectOp(")")
    if r.peek().kind != T_EOF { return Err(r.near()) }
    for i in 0..len(gt.cols) {
        for j in 0..i {
            if gt.cols[i].name == gt.cols[j].name { return Err(gerr(oraMode, 918, "42702", &(gt.cols[i].name + ": column ambiguously specified"))) }
        }
    }
    gt.r = r
    return Ok(gt)
}

// A label expression: l | l & l | (expr), in disjunctive form.
fn labelExpr(r: mut &Rdr): Result[[][]str, DbErr] {
    var out = try labelTerm(r)
    while r.acceptOp("|") {
        for t in try labelTerm(r) { append(mut &out, t) }
    }
    return Ok(out)
}

fn labelTerm(r: mut &Rdr): Result[[][]str, DbErr] {
    var out = try labelFactor(r)
    while r.acceptOp("&") {
        let f = try labelFactor(r)
        var next: [][]str = []
        for a in out {
            for b in f {
                var c = a.clone()
                for x in b { append(mut &c, x.clone()) }
                append(mut &next, c)
            }
        }
        out = next
    }
    return Ok(out)
}

fn labelFactor(r: mut &Rdr): Result[[][]str, DbErr] {
    if r.acceptOp("(") {
        let x = try labelExpr(r)
        try r.expectOp(")")
        return Ok(x)
    }
    if r.op("!") { return Err(gerr(r.ora, 40951, "0A000", "unsupported operation for GRAPH_TABLE: Complex label expressions")) }
    if r.op("%") { return Err(gerr(r.ora, 911, "42601", "%: invalid character after IS")) }
    let t = try r.nameTok()
    return Ok([[canonIn(&t, r.md)]])
}

// The inside of an element pattern: [var] [IS labels] [WHERE cond], up to close.
fn epBody(r: mut &Rdr, gt: mut &GT, vertex: bool, close: &str, group: int): Result[EP, DbErr] {
    var ep = noEP()
    ep.vertex = vertex
    if isName(r.peek()) && !r.kw("is") && !r.kw("where") {
        let t = try r.nameTok()
        ep.vname = canonIn(&t, r.md)
    }
    if r.accept("is") { ep.lab = try labelExpr(r) }
    if r.accept("where") {
        ep.wlo = r.pos
        var d = 0
        while r.peek().kind != T_EOF {
            if r.op("(") || r.op("[") { d += 1 }
            else if r.op(")") || r.op("]") {
                if d == 0 { break }
                d -= 1
            }
            r.pos += 1
        }
        ep.whi = r.pos
    }
    if !r.acceptOp(close) { return Err(if close == ")" { gerr(r.ora, 907, "42601", "missing right parenthesis") } else { r.near() }) }
    // the variable declared (or met again)
    if len(ep.vname) > 0 {
        var found = -1
        for i in 0..len(gt.decls) { if gt.decls[i].name == ep.vname { found = i } }
        if found >= 0 {
            if gt.decls[found].vertex != vertex { return Err(gerr(r.ora, 49000, "42P10", "A vertex variable has the same name as an edge variable.")) }
            if len(ep.lab) > 0 { append(mut &gt.decls[found].labs, ep.lab.clone()) }
        } else {
            var labs: [][][]str = []
            if len(ep.lab) > 0 { append(mut &labs, ep.lab.clone()) }
            append(mut &gt.decls, Decl{name: ep.vname.clone(), vertex: vertex, group: group, labs: labs})
        }
    }
    // its labels are the graph's (a vertex's among the vertex tables', an edge's among the edge tables')
    for t in ep.lab {
        for l in t {
            var known = false
            for el in gt.g.elems { if el.vertex == vertex { for x in el.labels { if x.name == l { known = true } } } }
            if !known { return Err(gerr(r.ora, 40954, "42704", "unknown label")) }
        }
    }
    return Ok(ep)
}

// A quantifier after an edge or a bracketed path: {n}, {m,n}, {,n}; lo and hi -1: none.
// Under ANY SHORTEST (allowUnbounded = true), also accepts +, *, ?, {m,} (hi = -1: unbounded) and {0,n}.
fn quant(r: mut &Rdr, allowUnbounded: bool, lo: mut &int, hi: mut &int): Result[Unit, DbErr] {
    if allowUnbounded {
        if r.acceptOp("+") {
            let x = replace(lo, 1)
            let y = replace(hi, -1)
            return Ok(Unit{})
        }
        if r.acceptOp("*") {
            let x = replace(lo, 0)
            let y = replace(hi, -1)
            return Ok(Unit{})
        }
        if r.acceptOp("?") {
            let x = replace(lo, 0)
            let y = replace(hi, 1)
            return Ok(Unit{})
        }
        if !r.acceptOp("{") { return Ok(Unit{}) }
        var a = 0
        var b = -1
        if r.peek().kind == T_NUM {
            a = lexdb_base.num(&r.peek().text)
            r.pos += 1
            b = a
        }
        if r.acceptOp(",") {
            if r.peek().kind == T_NUM {
                b = lexdb_base.num(&r.peek().text)
                r.pos += 1
            } else {
                b = -1
            }
        }
        if !r.acceptOp("}") { return Err(gerr(r.ora, 40984, "42601", "invalid value specified for quantifier in a GRAPH_TABLE operator")) }
        if a < 0 || (b >= 0 && a > b) { return Err(gerr(r.ora, 40984, "42601", "invalid value specified for quantifier in a GRAPH_TABLE operator")) }
        let x = replace(lo, a)
        let y = replace(hi, b)
        return Ok(Unit{})
    }
    if r.op("+") || r.op("*") { return Err(gerr(r.ora, 40985, "0A000", "unsupported quantifier for variable path pattern in a GRAPH_TABLE operator")) }
    if r.op("?") { return Err(gerr(r.ora, 49003, "0A000", "Using a question mark in path pattern is not supported.")) }
    if !r.acceptOp("{") { return Ok(Unit{}) }
    var a = 0
    var b = -1
    if r.peek().kind == T_NUM {
        a = lexdb_base.num(&r.peek().text)
        r.pos += 1
        b = a
    }
    if r.acceptOp(",") {
        if r.peek().kind != T_NUM { return Err(gerr(r.ora, 40984, "42601", "invalid value specified for bounded quantifier in a GRAPH_TABLE operator")) }     // ({m,})
        b = lexdb_base.num(&r.peek().text)
        r.pos += 1
    }
    if !r.acceptOp("}") { return Err(gerr(r.ora, 40984, "42601", "invalid value specified for bounded quantifier in a GRAPH_TABLE operator")) }
    if b < 1 || a > b { return Err(gerr(r.ora, 40984, "42601", "invalid value specified for bounded quantifier in a GRAPH_TABLE operator")) }
    let x = replace(lo, a)
    let y = replace(hi, b)
    return Ok(Unit{})
}

fn newGroup(gt: mut &GT, lo: int, hi: int): int {
    append(mut &gt.glo, lo)
    append(mut &gt.ghi, hi)
    return len(gt.glo) - 1
}

// A path pattern's items up to a "," at depth 0, the end, WHERE, COLUMNS or ONE (depth 0), or the ")" closing a bracketed path
// (depth > 0).
fn pathOf(r: mut &Rdr, gt: mut &GT, out: mut &[]PI, group: int, depth: int): Result[Unit, DbErr] {
    while true {
        if r.op("(") {
            // a vertex pattern, or a bracketed path
            let k = if isName(r.at(1)) && !r.kwAt(1, "is") && !r.kwAt(1, "where") { 2 } else { 1 }
            let vtx = r.opAt(k, ")") || r.kwAt(k, "is") || r.kwAt(k, "where") || (k == 1 && (r.kwAt(1, "is") || r.kwAt(1, "where")))
            if vtx {
                r.pos += 1
                let ep = try epBody(r, gt, true, &")", group)
                if r.op("{") || r.op("+") || r.op("*") || r.op("?") {
                    return Err(gerr(r.ora, 40997, "42601", "invalid path pattern expression is specified in a GRAPH_TABLE operator"))
                }
                append(out, PI{group: false, ep: ep, sub: [], lo: 1, hi: 1, gid: -1})
                continue
            }
            if group >= 0 { return Err(e("0A000", "lexdb: a quantified path pattern inside another is not supported")) }
            r.pos += 1
            var sub: []PI = []
            // (its variables are the group's: its number is known once its quantifier is read, so made now and set after)
            let gid = newGroup(gt, 1, 1)
            try pathOf(r, gt, mut &sub, gid, depth + 1)
            try r.expectOp(")")
            var lo = -1
            var hi = -1
            try quant(r, gt.shortest, mut &lo, mut &hi)
            if lo < 0 { lo = 1; hi = 1 }
            gt.glo[gid] = lo
            gt.ghi[gid] = hi
            append(out, PI{group: true, ep: noEP(), sub: sub, lo: lo, hi: hi, gid: gid})
            continue
        }
        if r.op("-") || r.op("->") || (r.op("<") && r.opAt(1, "-")) {
            var ep = noEP()
            ep.vertex = false
            let arrow = r.op("->")
            let left = r.op("<")
            if left { r.pos += 2 } else { r.pos += 1 }
            if !arrow && r.op("[") {
                r.pos += 1
                // (the quantifier's group, if one follows: the variable belongs to it)
                let save = r.pos
                var depthB = 0
                var j = r.pos
                while j < len(r.toks) && r.toks[j].kind != T_EOF {
                    if r.toks[j].kind == T_OP && r.toks[j].text == "[" { depthB += 1 }
                    if r.toks[j].kind == T_OP && r.toks[j].text == "]" {
                        if depthB == 0 { break }
                        depthB -= 1
                    }
                    j += 1
                }
                // after "]": "-" or "->", then perhaps a quantifier
                var k = j + 1
                var right = false
                var rightStep = 1
                if k < len(r.toks) && r.toks[k].kind == T_OP && r.toks[k].text == "-" {
                    k += 1
                    if !left && k < len(r.toks) && r.toks[k].kind == T_OP && r.toks[k].text == ">" {
                        right = true
                        rightStep = 2
                        k += 1
                    }
                } else if !left && k < len(r.toks) && r.toks[k].kind == T_OP && r.toks[k].text == "->" {
                    right = true
                    rightStep = 1
                    k += 1
                } else {
                    return Err(gerr(r.ora, 40997, "42601", "invalid path pattern expression is specified in a GRAPH_TABLE operator"))
                }
                let quantified = k < len(r.toks) && r.toks[k].kind == T_OP && (r.toks[k].text == "{" || r.toks[k].text == "+" || r.toks[k].text == "*" || r.toks[k].text == "?")
                var gid = group
                if quantified && group < 0 { gid = newGroup(gt, 1, 1) }
                if quantified && group >= 0 { return Err(e("0A000", "lexdb: a quantified path pattern inside another is not supported")) }
                r.pos = save
                let body = try epBody(r, gt, false, &"]", gid)
                ep = body
                ep.vertex = false
                r.pos = j + 1
                r.pos += rightStep
                ep.dir = if left { DIR_L } else if right { DIR_R } else { DIR_ANY }
                if quantified && group < 0 {
                    var lo = -1
                    var hi = -1
                    try quant(r, gt.shortest, mut &lo, mut &hi)
                    gt.glo[gid] = lo
                    gt.ghi[gid] = hi
                    append(out, PI{group: true, ep: noEP(), sub: [PI{group: false, ep: ep, sub: [], lo: 1, hi: 1, gid: -1}], lo: lo, hi: hi, gid: gid})
                    continue
                }
                append(out, PI{group: false, ep: ep, sub: [], lo: 1, hi: 1, gid: -1})
                continue
            }
            // the abbreviated ->, <-, -
            if arrow {
                ep.dir = DIR_R
            } else if !left && r.op(">") {
                r.pos += 1
                ep.dir = DIR_R
            } else {
                ep.dir = if left { DIR_L } else { DIR_ANY }
            }
            if (r.op("{") || r.op("+") || r.op("*") || r.op("?")) && group < 0 {
                var lo = -1
                var hi = -1
                try quant(r, gt.shortest, mut &lo, mut &hi)
                let gid = newGroup(gt, lo, hi)
                append(out, PI{group: true, ep: noEP(), sub: [PI{group: false, ep: ep, sub: [], lo: 1, hi: 1, gid: -1}], lo: lo, hi: hi, gid: gid})
                continue
            }
            append(out, PI{group: false, ep: ep, sub: [], lo: 1, hi: 1, gid: -1})
            continue
        }
        break
    }
    return Ok(Unit{})
}

// A COLUMNS item: expr [AS name]; var.prop is named prop; var.* is every property of the variable's labels.
fn colItem(r: &Rdr, gt: mut &GT, lo: int, hi: int): Result[Unit, DbErr] {
    var end = hi
    var name = ""
    if hi - lo >= 3 && r.toks[hi - 2].kind == T_IDENT && r.toks[hi - 2].text == "as" && isName(&r.toks[hi - 1]) {
        name = canonIn(&r.toks[hi - 1], r.md)
        end = hi - 2
    }
    let t = &r.toks[lo]
    if end - lo == 3 && isName(t) && r.toks[lo + 1].kind == T_OP && r.toks[lo + 1].text == "." && r.toks[lo + 2].kind == T_OP && r.toks[lo + 2].text == "*" && len(name) == 0 {
        let v = canonIn(t, r.md)
        let d = try declOf(gt, &v)
        if gt.decls[d].group >= 0 { return Err(gerr(r.ora, 40990, "42P10", &("invalid reference of group variable " + v + " in the COLUMNS clause of a GRAPH_TABLE operator"))) }
        for p in propsOf(gt, d) {
            append(mut &gt.cols, Col{lo: lo, hi: lo + 3, name: p.clone(), vname: v.clone(), prop: p, matchnum: false})
        }
        return Ok(Unit{})
    }
    if end - lo == 3 && isName(t) && r.toks[lo + 1].kind == T_OP && r.toks[lo + 1].text == "." && isName(&r.toks[lo + 2]) {
        let v = canonIn(t, r.md)
        let p = canonIn(&r.toks[lo + 2], r.md)
        if len(name) == 0 { name = p.clone() }
        append(mut &gt.cols, Col{lo: lo, hi: end, name: name, vname: v, prop: p, matchnum: false})
        return Ok(Unit{})
    }
    if len(name) == 0 { return Err(gerr(r.ora, 2000, "42601", "missing AS keyword")) }
    let mn = end - lo == 3 && t.kind == T_IDENT && t.text == "matchnum" && r.toks[lo + 1].kind == T_OP && r.toks[lo + 1].text == "(" && r.toks[lo + 2].kind == T_OP && r.toks[lo + 2].text == ")"
    append(mut &gt.cols, Col{lo: lo, hi: end, name: name, vname: "", prop: "", matchnum: mn})
    return Ok(Unit{})
}

fn declOf(gt: &GT, v: &str): Result[int, DbErr] {
    for i in 0..len(gt.decls) { if gt.decls[i].name == v { return Ok(i) } }
    return Err(gerr(gt.ora, 40996, "42704", &("Variable " + v + " is not declared in the MATCH clause of a GRAPH_TABLE operator.")))
}

// The labels a declared variable may have: every label of the elements it may be bound to.
fn labelsOf(gt: &GT, d: int): []str {
    // (Oracle's: every label of the elements the variable may be bound to, not only those its expressions name)
    var out: []str = []
    let dv = &gt.decls[d]
    for i in candidates(gt, dv.vertex, &dv.labs) {
        for l in gt.g.elems[i].labels { if !lexdb_base.hasStr(&out, &l.name) { append(mut &out, l.name.clone()) } }
    }
    return out
}

// The properties of a declared variable's labels, in the order the graph defines them.
fn propsOf(gt: &GT, d: int): []str {
    let ls = labelsOf(gt, d)
    var out: []str = []
    for el in gt.g.elems {
        if el.vertex != gt.decls[d].vertex { continue }
        for l in el.labels {
            if !lexdb_base.hasStr(&ls, &l.name) { continue }
            for p in l.props { if !lexdb_base.hasStr(&out, &p.name) { append(mut &out, p.name.clone()) } }
        }
    }
    return out
}

// Whether element el has the labels of an expression (an OR of ANDs).
fn satisfies(el: &Elem, lab: &[][]str): bool {
    if len(lab) == 0 { return true }
    for t in lab {
        var all = true
        for l in t {
            var has = false
            for x in el.labels { if x.name == l { has = true } }
            if !has { all = false }
        }
        if all { return true }
    }
    return false
}

// The elements a variable with these label expressions may be bound to.
fn candidates(gt: &GT, vertex: bool, labs: &[][][]str): []int {
    var out: []int = []
    for i in 0..len(gt.g.elems) {
        let el = &gt.g.elems[i]
        if el.vertex != vertex { continue }
        var ok = true
        for lab in labs { if !satisfies(el, lab) { ok = false } }
        if ok { append(mut &out, i) }
    }
    return out
}

// The property references of COLUMNS and WHERE checked before anything is made: ORA-40983 (no label has it), ORA-49044 (not the
// variable's labels'), ORA-49013 (no element has the variable's labels).
fn checkRefs(gt: &GT): Result[Unit, DbErr] {
    let r = &gt.r
    var spans: [][]int = []
    if gt.wlo >= 0 { append(mut &spans, [gt.wlo, gt.whi]) }
    for c in gt.cols { append(mut &spans, [c.lo, c.hi]) }
    for pt in gt.paths { epSpans(&pt, mut &spans) }
    for sp in spans {
        var i = sp[0]
        while i + 2 < sp[1] {
            let t = &r.toks[i]
            if isName(t) && r.toks[i + 1].kind == T_OP && r.toks[i + 1].text == "." && isName(&r.toks[i + 2]) && !(i > 0 && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") {
                let v = canonIn(t, gt.md)
                var d = -1
                for k in 0..len(gt.decls) { if gt.decls[k].name == v { d = k } }
                if d >= 0 { try checkProp(gt, d, &canonIn(&r.toks[i + 2], gt.md)) }
                i += 3
                continue
            }
            i += 1
        }
    }
    return Ok(Unit{})
}

fn epSpans(pt: &[]PI, out: mut &[][]int) {
    for it in pt {
        if it.group { epSpans(&it.sub, out) }
        else if it.ep.wlo >= 0 { append(out, [it.ep.wlo, it.ep.whi]) }
    }
}

fn checkProp(gt: &GT, d: int, p: &str): Result[Unit, DbErr] {
    // (ORA-40983 / 42703 when no label of the variable's kind has it: a vertex's property read through an edge variable too)
    var anywhere = false
    for el in gt.g.elems { if el.vertex == gt.decls[d].vertex { for l in el.labels { for x in l.props { if x.name == p { anywhere = true } } } } }
    if !anywhere { return Err(gerr(gt.ora, 40983, "42703", &("property \"" + p + "\" is never defined"))) }
    let v = &gt.decls[d].name
    if len(candidates(gt, gt.decls[d].vertex, &gt.decls[d].labs)) == 0 {
        return Err(gerr(gt.ora, 49013, "42703", &("Invalid property reference \"" + p + "\" because the label expression for variable \"" + v + "\" is not satisfied.")))
    }
    if !lexdb_base.hasStr(&propsOf(gt, d), p) {
        return Err(gerr(gt.ora, 49044, "42703", &("Property \"" + p + "\" is never defined when evaluating the label expression for element variable \"" + v + "\".")))
    }
    return Ok(Unit{})
}

// ---- one expansion: the quantified parts at the lengths of counts

fn expansion(gt: &GT, counts: &[]int): Result[Exp, DbErr] {
    var x = Exp{vars: [], occs: [], counts: counts.clone()}
    var anon = 0
    for pt in gt.paths {
        // the path flattened: its element patterns, a quantified part's copies (variables of copy c named name#gid.c)
        var flat: []Var = []
        var dirs: []int = []
        flatten(gt, &pt, counts, -1, 0, mut &flat, mut &dirs, mut &anon)
        // vertices between edges and at the ends; two vertices side by side are one
        var seq: []int = []          // the path's variables (indexes in x.vars), vertex, edge, vertex, ...
        var seqDir: []int = []
        var lastVertex = false
        for i in 0..len(flat) {
            let isV = flat[i].vertex
            if isV && lastVertex {
                let a = seq[len(seq) - 1]
                let b = varIndex(mut &x, &flat[i])
                unite(mut &x, a, b)
                continue
            }
            if !isV && !lastVertex {
                anon += 1
                append(mut &seq, varIndex(mut &x, &anonVar(anon)))
                append(mut &seqDir, 0)
            }
            append(mut &seq, varIndex(mut &x, &flat[i]))
            append(mut &seqDir, dirs[i])
            lastVertex = isV
        }
        if !lastVertex {
            anon += 1
            append(mut &seq, varIndex(mut &x, &anonVar(anon)))
            append(mut &seqDir, 0)
        }
        var i = 1
        while i + 1 < len(seq) {
            append(mut &x.occs, Occ{e: seq[i], x: seq[i - 1], y: seq[i + 1], dir: seqDir[i]})
            i += 2
        }
    }
    return Ok(x)
}

fn anonVar(n: int): Var {
    return Var{name: "#v" + n.toStr(), base: "", vertex: true, group: -1, copy: 0, labs: [], wheres: [], rep: -1}
}

fn flatten(gt: &GT, pt: &[]PI, counts: &[]int, group: int, copy: int, out: mut &[]Var, dirs: mut &[]int, anon: mut &int) {
    for it in pt {
        if it.group {
            for c in 1..counts[it.gid] + 1 { flatten(gt, &it.sub, counts, it.gid, c, out, dirs, anon) }
            continue
        }
        var v = Var{name: "", base: it.ep.vname.clone(), vertex: it.ep.vertex, group: group, copy: copy, labs: [], wheres: [], rep: -1}
        if len(v.base) == 0 {
            anon += 1
            v.name = "#a" + anon.toStr()
        } else if group >= 0 {
            v.name = v.base + "#" + group.toStr() + "." + copy.toStr()
        } else {
            v.name = v.base.clone()
        }
        if len(it.ep.lab) > 0 { append(mut &v.labs, it.ep.lab.clone()) }
        if it.ep.wlo >= 0 { append(mut &v.wheres, Wh{lo: it.ep.wlo, hi: it.ep.whi, group: group, copy: copy}) }
        append(out, v)
        append(dirs, it.ep.dir)
    }
}

// The variable of v in x (added, or its constraints added to the one of its name).
fn varIndex(x: mut &Exp, v: &Var): int {
    for i in 0..len(x.vars) {
        if x.vars[i].name == v.name {
            for l in v.labs { append(mut &x.vars[i].labs, l.clone()) }
            for w in v.wheres { append(mut &x.vars[i].wheres, w) }
            return i
        }
    }
    var n = v.clone()
    n.rep = len(x.vars)
    append(mut &x.vars, n)
    return len(x.vars) - 1
}

fn repOf(x: &Exp, i: int): int {
    var k = i
    while x.vars[k].rep != k { k = x.vars[k].rep }
    return k
}

// Two vertex variables made one (b's constraints go to a's).
fn unite(x: mut &Exp, a0: int, b0: int) {
    let a = repOf(x, a0)
    let b = repOf(x, b0)
    if a == b { return }
    let labs = x.vars[b].labs.clone()
    let ws = x.vars[b].wheres.clone()
    for l in labs { append(mut &x.vars[a].labs, l) }
    for w in ws { append(mut &x.vars[a].wheres, w) }
    x.vars[b].rep = a
}

// ---- the joins of one expansion

// A vertex variable eliminated because an enforced non-deferred FK on an incident edge guarantees an exact 1-to-1 match on its
// unique key, and no non-key column of the vertex table is read.
type VSub = record {
    edgeVar: int
    occ: int
    isSrc: bool
    vCols: []str
    eCols: []str
    nullable: []bool
}

fn noVSub(): VSub { return VSub{edgeVar: -1, occ: -1, isSrc: false, vCols: [], eCols: [], nullable: []} }

// A binding of an expansion's variables to elements: per variable (its representative's), the element; per edge occurrence,
// whether the edge's source is on its left; per variable, its vertex-table elimination (if any).
type Bind = record { el: []int; fwd: []bool; elim: []VSub }

fn branchesOf(gt: &GT, x: &Exp, out: mut &[]str): Result[Unit, DbErr] {
    var cands: [][]int = []
    for i in 0..len(x.vars) {
        if repOf(x, i) != i {
            append(mut &cands, [])
            continue
        }
        append(mut &cands, candidates(gt, x.vars[i].vertex, &x.vars[i].labs))
    }
    var b = Bind{el: array(len(x.vars), -1), fwd: array(len(x.occs), true), elim: []}
    try bindEdges(gt, x, &cands, 0, mut &b, out)
    return Ok(Unit{})
}

// The edges' elements and directions chosen one by one, then the vertices': each binding that holds a join.
fn bindEdges(gt: &GT, x: &Exp, cands: &[][]int, k: int, b: mut &Bind, out: mut &[]str): Result[Unit, DbErr] {
    if len(out) > 4096 { return Err(e("0A000", "lexdb: GRAPH_TABLE's pattern stands for more than 4,096 joins")) }
    // the edge variables first
    var ev: []int = []
    for i in 0..len(x.vars) { if !x.vars[i].vertex && repOf(x, i) == i { append(mut &ev, i) } }
    if k < len(ev) {
        for c in cands[ev[k]] {
            b.el[ev[k]] = c
            try bindEdges(gt, x, cands, k + 1, b, out)
        }
        b.el[ev[k]] = -1
        return Ok(Unit{})
    }
    // then each occurrence's direction
    let o = k - len(ev)
    if o < len(x.occs) {
        if x.occs[o].dir == DIR_ANY {
            b.fwd[o] = true
            try bindEdges(gt, x, cands, k + 1, b, out)
            b.fwd[o] = false
            try bindEdges(gt, x, cands, k + 1, b, out)
            b.fwd[o] = true
            return Ok(Unit{})
        }
        b.fwd[o] = x.occs[o].dir == DIR_R
        return bindEdges(gt, x, cands, k + 1, b, out)
    }
    // the vertices the edges fix, then the others
    var vel: []int = array(len(x.vars), -1)
    for i in 0..len(x.occs) {
        let oc = &x.occs[i]
        let el = &gt.g.elems[b.el[repOf(x, oc.e)]]
        let sx = elemIndex(gt, &el.src.elem)
        let dx = elemIndex(gt, &el.dst.elem)
        let lx = repOf(x, oc.x)
        let ly = repOf(x, oc.y)
        let wl = if b.fwd[i] { sx } else { dx }
        let wr = if b.fwd[i] { dx } else { sx }
        if (vel[lx] >= 0 && vel[lx] != wl) || (vel[ly] >= 0 && vel[ly] != wr) { return Ok(Unit{}) }
        vel[lx] = wl
        vel[ly] = wr
    }
    for i in 0..len(x.vars) {
        if !x.vars[i].vertex || repOf(x, i) != i || vel[i] < 0 { continue }
        if !hasInt(&cands[i], vel[i]) { return Ok(Unit{}) }
        b.el[i] = vel[i]
    }
    return bindFree(gt, x, cands, 0, b, out)
}

fn bindFree(gt: &GT, x: &Exp, cands: &[][]int, from: int, b: mut &Bind, out: mut &[]str): Result[Unit, DbErr] {
    var i = from
    while i < len(x.vars) && !(x.vars[i].vertex && repOf(x, i) == i && b.el[i] < 0) { i += 1 }
    if i == len(x.vars) {
        append(out, try branchSql(gt, x, b, false))
        return Ok(Unit{})
    }
    for c in cands[i] {
        b.el[i] = c
        try bindFree(gt, x, cands, i + 1, b, out)
    }
    b.el[i] = -1
    return Ok(Unit{})
}

fn elemIndex(gt: &GT, n: &str): int {
    for i in 0..len(gt.g.elems) { if gt.g.elems[i].vertex && gt.g.elems[i].name == n { return i } }
    return -1
}

// No binding holds: one made of the first elements of each kind, its condition false.
fn fallback(gt: &GT, x: &Exp, out: mut &[]str): Result[Unit, DbErr] {
    var b = Bind{el: array(len(x.vars), -1), fwd: array(len(x.occs), true), elim: []}
    for i in 0..len(x.vars) {
        if repOf(x, i) != i { continue }
        let cs = candidates(gt, x.vars[i].vertex, &x.vars[i].labs)
        if len(cs) > 0 { b.el[i] = cs[0] } else {
            for k in 0..len(gt.g.elems) { if gt.g.elems[k].vertex == x.vars[i].vertex && b.el[i] < 0 { b.el[i] = k } }
        }
    }
    append(out, try branchSql(gt, x, &b, true))
    return Ok(Unit{})
}

fn alias(i: int): str { return "\"gt$" + i.toStr() + "\"" }

fn isUniqueKey(t: &Table, cols: &[]str): bool {
    if len(cols) == 0 { return false }
    if len(t.pk) == len(cols) {
        var ok = true
        for c in cols {
            var found = false
            for pi in t.pk { if t.cols[pi].name == c { found = true } }
            if !found { ok = false }
        }
        if ok { return true }
    }
    for ix in t.indexes {
        if !ix.unique || ix.pred.isSome() || len(ix.exprs) > 0 || len(ix.cols) != len(cols) { continue }
        var ok = true
        for c in cols {
            var found = false
            for ci in ix.cols { if ci >= 0 && t.cols[ci].name == c { found = true } }
            if !found { ok = false }
        }
        if ok { return true }
    }
    return false
}

fn hasEnforcedFk(te: &Table, eCols: &[]str, vTable: &str, vRefs: &[]str): bool {
    if len(eCols) == 0 || len(eCols) != len(vRefs) { return false }
    for fk in te.fks {
        if fk.ref != vTable || fk.deferred || lexdb_base.hasStr(&te.invalid, &fk.name) { continue }
        if len(fk.cols) != len(eCols) || len(fk.refCols) != len(vRefs) { continue }
        var ok = true
        for j in 0..len(eCols) {
            var found = false
            for m in 0..len(fk.cols) {
                if fk.cols[m] == eCols[j] && fk.refCols[m] == vRefs[j] { found = true }
            }
            if !found { ok = false }
        }
        if ok { return true }
    }
    return false
}

// Whether every (eCols[j], vRefs[j]) pair has the exact same column type OID and collation, so substituting edge columns for
// vertex key columns preserves Describe OIDs and comparisons identically.
fn sameEndTypes(te: &Table, eCols: &[]str, tv: &Table, vRefs: &[]str, nulls: mut &[]bool): bool {
    var ns: []bool = []
    for j in 0..len(eCols) {
        let ec = colIdx(te, &eCols[j])
        let vc = colIdx(tv, &vRefs[j])
        if ec < 0 || vc < 0 { return false }
        if te.cols[ec].typ.oid != tv.cols[vc].typ.oid || te.cols[ec].coll != tv.cols[vc].coll { return false }
        append(mut &ns, !te.cols[ec].notNull)
    }
    let old = replace(nulls, ns)
    return true
}

fn tryElim(gt: &GT, x: &Exp, b: &Bind, noRows: bool): []VSub {
    var out: []VSub = []
    for i in 0..len(x.vars) { append(mut &out, noVSub()) }
    if noRows { return out }
    for k in 0..len(x.occs) {
        let oc = &x.occs[k]
        let ei = repOf(x, oc.e)
        let el = &gt.g.elems[b.el[ei]]
        let te = &gt.tabs[b.el[ei]]
        let l = repOf(x, oc.x)
        let rr = repOf(x, oc.y)
        let srcV = if b.fwd[k] { l } else { rr }
        let dstV = if b.fwd[k] { rr } else { l }
        if out[srcV].edgeVar < 0 {
            let tv = &gt.tabs[b.el[srcV]]
            let ev = &gt.g.elems[b.el[srcV]]
            var ns: []bool = []
            if len(tv.view) == 0 && isUniqueKey(tv, &el.src.refs) && hasEnforcedFk(te, &el.src.cols, &ev.table, &el.src.refs) &&
               sameEndTypes(te, &el.src.cols, tv, &el.src.refs, mut &ns) {
                out[srcV] = VSub{edgeVar: ei, occ: k, isSrc: true, vCols: el.src.refs.clone(), eCols: el.src.cols.clone(), nullable: ns}
            }
        }
        if out[dstV].edgeVar < 0 {
            let tv = &gt.tabs[b.el[dstV]]
            let ev = &gt.g.elems[b.el[dstV]]
            var ns: []bool = []
            if len(tv.view) == 0 && isUniqueKey(tv, &el.dst.refs) && hasEnforcedFk(te, &el.dst.cols, &ev.table, &el.dst.refs) &&
               sameEndTypes(te, &el.dst.cols, tv, &el.dst.refs, mut &ns) {
                out[dstV] = VSub{edgeVar: ei, occ: k, isSrc: false, vCols: el.dst.refs.clone(), eCols: el.dst.cols.clone(), nullable: ns}
            }
        }
    }
    return out
}

fn colRef(b: &Bind, vi: int, col: &str, md: int, keep: mut &[]bool): str {
    if vi < len(b.elim) && b.elim[vi].edgeVar >= 0 {
        for j in 0..len(b.elim[vi].vCols) {
            if b.elim[vi].vCols[j] == col {
                return alias(b.elim[vi].edgeVar) + "." + qIn(&b.elim[vi].eCols[j], md)
            }
        }
        if vi < len(keep) { keep[vi] = true }
    }
    return alias(vi) + "." + qIn(col, md)
}

fn renderParts(gt: &GT, x: &Exp, b: &Bind, wconds: mut &[]str, items: mut &[]str, keep: mut &[]bool): Result[Unit, DbErr] {
    var wc: []str = []
    var its: []str = []
    for k in 0..len(x.occs) {
        let oc = &x.occs[k]
        let ei = repOf(x, oc.e)
        let el = &gt.g.elems[b.el[ei]]
        let l = repOf(x, oc.x)
        let rr = repOf(x, oc.y)
        if oc.dir == DIR_ANY && !b.fwd[k] && el.src.elem == el.dst.elem {
            let v = &gt.g.elems[b.el[l]]
            var same: []str = []
            for c in v.keys { append(mut &same, colRef(b, l, &c, gt.md, keep) + " = " + colRef(b, rr, &c, gt.md, keep)) }
            append(mut &wc, "not (" + strings.join(&same, " and ") + ")")
        }
    }
    for i in 0..len(x.vars) {
        for w in x.vars[i].wheres {
            append(mut &wc, "(" + try exprSql(gt, x, b, w.lo, w.hi, 2, w.group, w.copy, keep) + ")")
        }
    }
    if gt.wlo >= 0 { append(mut &wc, "(" + try exprSql(gt, x, b, gt.wlo, gt.whi, 1, -1, 0, keep) + ")") }
    for c in gt.cols {
        if c.matchnum { continue }
        let v = if len(c.vname) > 0 {
            "(" + try propRef(gt, x, b, &c.vname, &c.prop, 0, -1, 0, keep) + ")"
        } else {
            try exprSql(gt, x, b, c.lo, c.hi, 0, -1, 0, keep)
        }
        append(mut &its, v + " " + qIn(&c.name, gt.md))
    }
    let old1 = replace(wconds, wc)
    let old2 = replace(items, its)
    return Ok(Unit{})
}

// The SQL of one binding: its tables, joined on the edges' keys, with the conditions and COLUMNS' items.
fn branchSql(gt: &GT, x: &Exp, b0: &Bind, noRows: bool): Result[str, DbErr] {
    var b = Bind{el: b0.el.clone(), fwd: b0.fwd.clone(), elim: tryElim(gt, x, b0, noRows)}
    var keep: []bool = array(len(x.vars), false)
    var wconds: []str = []
    var items: []str = []
    try renderParts(gt, x, &b, mut &wconds, mut &items, mut &keep)
    var redo = false
    for i in 0..len(x.vars) {
        if b.elim[i].edgeVar >= 0 && keep[i] {
            b.elim[i].edgeVar = -1
            redo = true
        }
    }
    if redo {
        keep = array(len(x.vars), false)
        try renderParts(gt, x, &b, mut &wconds, mut &items, mut &keep)
    }
    var from: []str = []
    var conds: []str = []
    for i in 0..len(x.vars) {
        if repOf(x, i) != i { continue }
        if b.el[i] < 0 { return Err(lexdb_base.corrupt("GRAPH_TABLE: a variable without an element")) }
        if b.elim[i].edgeVar >= 0 { continue }
        append(mut &from, relTextIn(&gt.g.elems[b.el[i]].table, gt.md) + " " + alias(i))
    }
    // Track first incident edge per kept vertex so multiple edges meeting at a kept vertex also get direct transitive equalities.
    var firstEdge: []int = array(len(x.vars), -1)
    var firstIsSrc: []bool = array(len(x.vars), false)
    var firstOcc: []int = array(len(x.vars), -1)
    var noKeep: []bool = []
    for k in 0..len(x.occs) {
        let oc = &x.occs[k]
        let ei = repOf(x, oc.e)
        let el = &gt.g.elems[b.el[ei]]
        let l = repOf(x, oc.x)
        let rr = repOf(x, oc.y)
        let srcV = if b.fwd[k] { l } else { rr }
        let dstV = if b.fwd[k] { rr } else { l }
        if b.elim[srcV].edgeVar >= 0 && b.elim[srcV].occ == k && b.elim[srcV].isSrc {
            for j in 0..len(el.src.cols) {
                if b.elim[srcV].nullable[j] { append(mut &conds, alias(ei) + "." + qIn(&el.src.cols[j], gt.md) + " is not null") }
            }
        } else {
            for j in 0..len(el.src.cols) {
                append(mut &conds, alias(ei) + "." + qIn(&el.src.cols[j], gt.md) + " = " + colRef(&b, srcV, &el.src.refs[j], gt.md, mut &noKeep))
            }
            if b.elim[srcV].edgeVar < 0 {
                if firstEdge[srcV] < 0 {
                    firstEdge[srcV] = ei
                    firstIsSrc[srcV] = true
                    firstOcc[srcV] = k
                } else if firstEdge[srcV] != ei || !firstIsSrc[srcV] {
                    let fei = firstEdge[srcV]
                    let fel = &gt.g.elems[b.el[fei]]
                    let fend = if firstIsSrc[srcV] { &fel.src } else { &fel.dst }
                    for j in 0..len(el.src.cols) {
                        for m in 0..len(fend.refs) {
                            if fend.refs[m] == el.src.refs[j] {
                                append(mut &conds, alias(ei) + "." + qIn(&el.src.cols[j], gt.md) + " = " + alias(fei) + "." + qIn(&fend.cols[m], gt.md))
                            }
                        }
                    }
                }
            }
        }
        if b.elim[dstV].edgeVar >= 0 && b.elim[dstV].occ == k && !b.elim[dstV].isSrc {
            for j in 0..len(el.dst.cols) {
                if b.elim[dstV].nullable[j] { append(mut &conds, alias(ei) + "." + qIn(&el.dst.cols[j], gt.md) + " is not null") }
            }
        } else {
            for j in 0..len(el.dst.cols) {
                append(mut &conds, alias(ei) + "." + qIn(&el.dst.cols[j], gt.md) + " = " + colRef(&b, dstV, &el.dst.refs[j], gt.md, mut &noKeep))
            }
            if b.elim[dstV].edgeVar < 0 {
                if firstEdge[dstV] < 0 {
                    firstEdge[dstV] = ei
                    firstIsSrc[dstV] = false
                    firstOcc[dstV] = k
                } else if firstEdge[dstV] != ei || firstIsSrc[dstV] {
                    let fei = firstEdge[dstV]
                    let fel = &gt.g.elems[b.el[fei]]
                    let fend = if firstIsSrc[dstV] { &fel.src } else { &fel.dst }
                    for j in 0..len(el.dst.cols) {
                        for m in 0..len(fend.refs) {
                            if fend.refs[m] == el.dst.refs[j] {
                                append(mut &conds, alias(ei) + "." + qIn(&el.dst.cols[j], gt.md) + " = " + alias(fei) + "." + qIn(&fend.cols[m], gt.md))
                            }
                        }
                    }
                }
            }
        }
    }
    for c in wconds { append(mut &conds, c) }
    if noRows { append(mut &conds, "1 = 0") }
    if len(items) == 0 { append(mut &items, "null \"gt$none\"") }
    var sql = "select " + strings.join(&items, ", ") + " from " + strings.join(&from, ", ")
    if len(conds) > 0 { sql += " where " + strings.join(&conds, " and ") }
    return Ok(sql)
}

// The variable of the pattern's name v in a binding: in the quantified part's copy (group, copy) where it is one of its, else the
// one outside every quantified part. where: 0 COLUMNS, 1 MATCH's WHERE, 2 an element's WHERE (its errors differ).
fn varFor(gt: &GT, x: &Exp, v: &str, where: int, group: int, copy: int): Result[int, DbErr] {
    for i in 0..len(x.vars) {
        if x.vars[i].base == v && x.vars[i].group == group && group >= 0 && x.vars[i].copy == copy { return Ok(repOf(x, i)) }
    }
    for i in 0..len(x.vars) { if x.vars[i].base == v && x.vars[i].group < 0 { return Ok(repOf(x, i)) } }
    let d = try declOf(gt, v)
    if gt.decls[d].group >= 0 {
        if where == 1 { return Err(gerr(gt.ora, 40998, "42P10", &("invalid reference of group variable " + v + " in the WHERE clause of a GRAPH_TABLE operator"))) }
        return Err(gerr(gt.ora, 40990, "42P10", &("invalid reference of group variable " + v + " in the COLUMNS clause of a GRAPH_TABLE operator")))
    }
    return Err(lexdb_base.corrupt("GRAPH_TABLE: a variable not bound"))
}

// v.p in a binding: the property's definition over v's table (NULL where v's element has not the property among its labels).
fn propRef(gt: &GT, x: &Exp, b: &Bind, v: &str, p: &str, where: int, group: int, copy: int, keep: mut &[]bool): Result[str, DbErr] {
    let i = try varFor(gt, x, v, where, group, copy)
    let d = try declOf(gt, v)
    let ls = labelsOf(gt, d)
    let el = &gt.g.elems[b.el[i]]
    for l in el.labels {
        if !lexdb_base.hasStr(&ls, &l.name) { continue }
        for pr in l.props {
            if pr.name == p { return qualified(&pr, b, i, gt.md, keep) }
        }
    }
    return Ok(nullOf(gt, p))
}

// A property the bound element has not: NULL of the property's type (where another element has it), so that the UNION ALL's
// column has that type and not NULL's.
fn nullOf(gt: &GT, p: &str): str {
    for el in gt.g.elems {
        for l in el.labels {
            for pr in l.props {
                if pr.name != p { continue }
                let k = pr.typ.kind
                if gt.ora {
                    if k == lexdb_sql.K_INT || k == lexdb_sql.K_NUM || k == lexdb_sql.K_FLOAT { return "cast(null as number)" }
                    if k == lexdb_sql.K_TEXT { return "cast(null as varchar2(4000))" }
                    if k == lexdb_sql.K_DATE { return "cast(null as date)" }
                    if k == lexdb_sql.K_TS { return "cast(null as timestamp)" }
                    if k == lexdb_sql.K_TSTZ { return "cast(null as timestamp with time zone)" }
                    return "null"
                }
                if gt.md == MD_TSQL {
                    if k == lexdb_sql.K_INT {
                        if pr.typ.oid == lexdb_sql.OID_INT2 { return "cast(null as smallint)" }
                        if pr.typ.oid == lexdb_sql.OID_INT4 { return "cast(null as int)" }
                        return "cast(null as bigint)"
                    }
                    if k == lexdb_sql.K_NUM { return "cast(null as decimal)" }
                    if k == lexdb_sql.K_FLOAT { return if pr.typ.oid == lexdb_sql.OID_FLOAT4 { "cast(null as real)" } else { "cast(null as float)" } }
                    if k == lexdb_sql.K_TEXT { return "cast(null as nvarchar(max))" }
                    if k == lexdb_sql.K_BOOL { return "cast(null as bit)" }
                    if k == lexdb_sql.K_DATE { return "cast(null as date)" }
                    if k == lexdb_sql.K_TIME { return "cast(null as time)" }
                    if k == lexdb_sql.K_TS { return "cast(null as datetime2)" }
                    if k == lexdb_sql.K_TSTZ { return "cast(null as datetimeoffset)" }
                    if k == lexdb_sql.K_UUID { return "cast(null as uniqueidentifier)" }
                    if k == lexdb_sql.K_BYTEA { return "cast(null as varbinary(max))" }
                    return "null"
                }
                if k == lexdb_sql.K_INT {
                    if pr.typ.oid == lexdb_sql.OID_INT2 { return "cast(null as smallint)" }
                    if pr.typ.oid == lexdb_sql.OID_INT4 { return "cast(null as integer)" }
                    return "cast(null as bigint)"
                }
                if k == lexdb_sql.K_NUM { return "cast(null as numeric)" }
                if k == lexdb_sql.K_FLOAT { return if pr.typ.oid == lexdb_sql.OID_FLOAT4 { "cast(null as real)" } else { "cast(null as double precision)" } }
                if k == lexdb_sql.K_TEXT { return "cast(null as text)" }
                if k == lexdb_sql.K_BOOL { return "cast(null as boolean)" }
                if k == lexdb_sql.K_DATE { return "cast(null as date)" }
                if k == lexdb_sql.K_TIME { return "cast(null as time)" }
                if k == lexdb_sql.K_TS { return "cast(null as timestamp)" }
                if k == lexdb_sql.K_TSTZ { return "cast(null as timestamptz)" }
                if k == lexdb_sql.K_UUID { return "cast(null as uuid)" }
                if k == lexdb_sql.K_BYTEA { return "cast(null as bytea)" }
                return "null"
            }
        }
    }
    return "null"
}

// A view's text column has no length in lexdb (its USER_TAB_COLUMNS shows 4,000): its property's the same.
fn viewTyp(t: &Table, ty: &TypeName): TypeName {
    var x = ty.clone()
    if len(t.view) > 0 && x.kind == lexdb_sql.K_TEXT && x.len == 0 { x.len = 4000 }
    return x
}

// A property's definition with its columns qualified by the alias (or substituted from an anchor edge when eliminated).
fn qualified(p: &Prop, b: &Bind, vi: int, md: int, keep: mut &[]bool): Result[str, DbErr] {
    if len(p.col) > 0 { return Ok(colRef(b, vi, &p.col, md, keep)) }
    let r = try readerIn(&p.expr, md)
    var out = ""
    for i in 0..len(r.toks) - 1 {
        let t = &r.toks[i]
        let piece = &r.src[t.at..r.toks[i + 1].at]
        if isName(t) && lexdb_base.hasStr(&p.uses, &t.text) && !(r.toks[i + 1].kind == T_OP && r.toks[i + 1].text == "(") &&
           !(i > 0 && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") {
            out += colRef(b, vi, &t.text, md, keep) + " "
            continue
        }
        out += piece
    }
    return Ok(out)
}

// The aggregates COLUMNS may take of a quantified part's variable.
fn isAggNameIn(n: &str, md: int): bool {
    return n == "count" || n == "sum" || n == "min" || n == "max" || n == "avg" || n == "listagg" || (md != MD_ORA && n == "string_agg")
}

// The matching ")" of the "(" at i.
fn closeOf(r: &Rdr, i: int, hi: int): int {
    var d = 0
    var k = i
    while k < hi {
        let t = &r.toks[k]
        if t.kind == T_OP && t.text == "(" { d += 1 }
        if t.kind == T_OP && t.text == ")" {
            d -= 1
            if d == 0 { return k }
        }
        k += 1
    }
    return hi
}

fn edgeLocalCmp(gt: &GT, x: &Exp, b: &Bind, lo: int, hi: int, i: int, where: int, group: int, copy: int): Option[str] {
    if where == 0 || i + 6 >= hi { return None }
    let r = &gt.r
    if i > lo && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == "." { return None }
    if i + 7 < hi && r.toks[i + 7].kind == T_OP && (r.toks[i + 7].text == "." || r.toks[i + 7].text == "(") { return None }
    let t0 = &r.toks[i]
    let t1 = &r.toks[i + 1]
    let t2 = &r.toks[i + 2]
    let op = &r.toks[i + 3]
    let t4 = &r.toks[i + 4]
    let t5 = &r.toks[i + 5]
    let t6 = &r.toks[i + 6]
    if !isName(t0) || t1.kind != T_OP || t1.text != "." || !isName(t2) { return None }
    if op.kind != T_OP || !(op.text == "<" || op.text == "<=" || op.text == ">" || op.text == ">=" || op.text == "=" || op.text == "<>" || op.text == "!=") { return None }
    if !isName(t4) || t5.kind != T_OP || t5.text != "." || !isName(t6) { return None }
    let v1 = canonIn(t0, gt.md)
    let v2 = canonIn(t4, gt.md)
    if v1 == v2 { return None }
    let p1 = canonIn(t2, gt.md)
    let p2 = canonIn(t6, gt.md)
    var d1 = -1
    var d2 = -1
    for k in 0..len(gt.decls) {
        if gt.decls[k].name == v1 { d1 = k }
        if gt.decls[k].name == v2 { d2 = k }
    }
    if d1 < 0 || d2 < 0 || !gt.decls[d1].vertex || !gt.decls[d2].vertex { return None }
    var vi1 = -1
    var vi2 = -1
    match varFor(gt, x, &v1, where, group, copy) { Ok(v) { vi1 = v } Err(_) { return None } }
    match varFor(gt, x, &v2, where, group, copy) { Ok(v) { vi2 = v } Err(_) { return None } }
    if vi1 == vi2 || vi1 >= len(b.elim) || vi2 >= len(b.elim) { return None }
    if b.elim[vi1].edgeVar < 0 || b.elim[vi2].edgeVar < 0 { return None }
    // Resolve p1 and p2 to bare column names on vi1 and vi2
    var c1 = ""
    let el1 = &gt.g.elems[b.el[vi1]]
    let ls1 = labelsOf(gt, d1)
    for l in el1.labels {
        if !lexdb_base.hasStr(&ls1, &l.name) { continue }
        for pr in l.props { if pr.name == p1 && len(pr.col) > 0 { c1 = pr.col.clone() } }
    }
    var c2 = ""
    let el2 = &gt.g.elems[b.el[vi2]]
    let ls2 = labelsOf(gt, d2)
    for l in el2.labels {
        if !lexdb_base.hasStr(&ls2, &l.name) { continue }
        for pr in l.props { if pr.name == p2 && len(pr.col) > 0 { c2 = pr.col.clone() } }
    }
    if len(c1) == 0 || len(c2) == 0 { return None }
    // Check if an edge occurrence directly connects vi1 and vi2 on columns c1 and c2
    for k in 0..len(x.occs) {
        let oc = &x.occs[k]
        let ei = repOf(x, oc.e)
        let l = repOf(x, oc.x)
        let rr = repOf(x, oc.y)
        let srcV = if b.fwd[k] { l } else { rr }
        let dstV = if b.fwd[k] { rr } else { l }
        let eel = &gt.g.elems[b.el[ei]]
        let te = &gt.tabs[b.el[ei]]
        if srcV == vi1 && dstV == vi2 {
            var ec1 = ""
            var ec2 = ""
            for j in 0..len(eel.src.refs) { if eel.src.refs[j] == c1 { ec1 = eel.src.cols[j].clone() } }
            for j in 0..len(eel.dst.refs) { if eel.dst.refs[j] == c2 { ec2 = eel.dst.cols[j].clone() } }
            var ns1: []bool = []
            var ns2: []bool = []
            if len(ec1) > 0 && len(ec2) > 0 &&
               sameEndTypes(te, &[ec1.clone()], &gt.tabs[b.el[vi1]], &[c1.clone()], mut &ns1) &&
               sameEndTypes(te, &[ec2.clone()], &gt.tabs[b.el[vi2]], &[c2.clone()], mut &ns2) {
                return Some("((" + alias(ei) + "." + qIn(&ec1, gt.md) + ") " + op.text + " (" + alias(ei) + "." + qIn(&ec2, gt.md) + ")) ")
            }
        } else if srcV == vi2 && dstV == vi1 {
            var ec1 = ""
            var ec2 = ""
            for j in 0..len(eel.dst.refs) { if eel.dst.refs[j] == c1 { ec1 = eel.dst.cols[j].clone() } }
            for j in 0..len(eel.src.refs) { if eel.src.refs[j] == c2 { ec2 = eel.src.cols[j].clone() } }
            var ns1: []bool = []
            var ns2: []bool = []
            if len(ec1) > 0 && len(ec2) > 0 &&
               sameEndTypes(te, &[ec1.clone()], &gt.tabs[b.el[vi1]], &[c1.clone()], mut &ns1) &&
               sameEndTypes(te, &[ec2.clone()], &gt.tabs[b.el[vi2]], &[c2.clone()], mut &ns2) {
                return Some("((" + alias(ei) + "." + qIn(&ec1, gt.md) + ") " + op.text + " (" + alias(ei) + "." + qIn(&ec2, gt.md) + ")) ")
            }
        }
    }
    return None
}

// The SQL of tokens [lo, hi) of an expression in a binding: v.p its property's definition, VERTEX_ID and EDGE_ID their JSON's
// text, IS LABELED and IS SOURCE OF / IS DESTINATION OF conditions, a quantified part's aggregate an expression over its copies.
fn exprSql(gt: &GT, x: &Exp, b: &Bind, lo: int, hi: int, where: int, group: int, copy: int, keep: mut &[]bool): Result[str, DbErr] {
    let r = &gt.r
    var out = ""
    var i = lo
    while i < hi {
        match edgeLocalCmp(gt, x, b, lo, hi, i, where, group, copy) {
            Some(s) {
                out += s
                i += 7
                continue
            }
            None {}
        }
        let t = &r.toks[i]
        let nx = &r.toks[i + 1]
        let piece = &r.src[t.at..r.toks[i + 1].at]
        if t.kind == T_OP && t.text == "(" && nx.kind == T_IDENT && (nx.text == "select" || nx.text == "with") {
            return Err(gerr(gt.ora, 40988, "0A000", "Subquery is not allowed in a GRAPH_TABLE operator."))
        }
        if isName(t) && nx.kind == T_OP && nx.text == "." && !(i > lo && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") {
            let v = canonIn(t, gt.md)
            var d = -1
            for k in 0..len(gt.decls) { if gt.decls[k].name == v { d = k } }
            if d >= 0 && i + 2 < hi && isName(&r.toks[i + 2]) {
                out += "(" + try propRef(gt, x, b, &v, &canonIn(&r.toks[i + 2], gt.md), where, group, copy, keep) + ") "
                i += 3
                continue
            }
            if d >= 0 { return Err(gerr(gt.ora, 40956, "42601", "invalid property name format")) }
            // a qualified function's name (pkg.f(...)) is left as it is; anything else names no variable
            if !(i + 3 < hi && isName(&r.toks[i + 2]) && r.toks[i + 3].kind == T_OP && r.toks[i + 3].text == "(") {
                return Err(gerr(gt.ora, 40996, "42704", &("Variable " + v + " is not declared in the MATCH clause of a GRAPH_TABLE operator.")))
            }
        }
        if t.kind == T_IDENT && nx.kind == T_OP && nx.text == "(" {
            let c = closeOf(r, i + 1, hi)
            if t.text == "vertex_id" || t.text == "edge_id" {
                out += try idSql(gt, x, b, i + 2, c, t.text == "vertex_id", where, group, copy, keep) + " "
                i = c + 1
                continue
            }
            if t.text == "json_serialize" && i + 3 < hi && r.toks[i + 2].kind == T_IDENT && (r.toks[i + 2].text == "vertex_id" || r.toks[i + 2].text == "edge_id") {
                let c2 = closeOf(r, i + 3, hi)
                out += try idSql(gt, x, b, i + 4, c2, r.toks[i + 2].text == "vertex_id", where, group, copy, keep) + " "
                i = c + 1
                continue
            }
            if t.text == "element_number" { return Err(gerr(gt.ora, 49033, "42P10", "ELEMENT_NUMBER can only be used in combination with ONE ROW PER VERTEX or STEP.")) }
            if t.text == "matchnum" { return Err(e("0A000", "lexdb: MATCHNUM() is supported as a COLUMNS item by itself")) }
            if isAggNameIn(&t.text, gt.md) && group < 0 {
                out += try aggSql(gt, x, b, &t.text, i + 2, c, where, keep) + " "
                i = c + 1
                continue
            }
        }
        if isName(t) && !(nx.kind == T_OP && (nx.text == "(" || nx.text == ".")) && !(i > lo && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") {
            let v = canonIn(t, gt.md)
            var d = -1
            for k in 0..len(gt.decls) { if gt.decls[k].name == v { d = k } }
            if d >= 0 && nx.kind == T_IDENT && nx.text == "is" {
                var n = 0
                out += try isSql(gt, x, b, i, hi, where, group, copy, mut &n, keep) + " "
                i += n
                continue
            }
            if d >= 0 { return Err(gerr(gt.ora, 40956, "42601", "invalid property name format")) }
            // a bare name that is a column of the graph's tables would be read from them: no such variable
            if t.kind == T_QIDENT || lexdb_base.hasStr(&gt.allCols, &t.text) {
                return Err(gerr(gt.ora, 40996, "42704", &("Variable \"" + v + "\" is not declared in the MATCH clause of a GRAPH_TABLE operator.")))
            }
        }
        out += piece
        i += 1
    }
    return Ok(out)
}

// VERTEX_ID(v) or EDGE_ID(e) (its argument tokens [lo, hi)): JSON text.
fn idSql(gt: &GT, x: &Exp, b: &Bind, lo: int, hi: int, vertex: bool, where: int, group: int, copy: int, keep: mut &[]bool): Result[str, DbErr] {
    let r = &gt.r
    if hi - lo != 1 || !isName(&r.toks[lo]) { return Err(gerr(gt.ora, 40956, "42601", "invalid property name format")) }
    let v = canonIn(&r.toks[lo], gt.md)
    let i = try varFor(gt, x, &v, where, group, copy)
    let el = &gt.g.elems[b.el[i]]
    let t = &gt.tabs[b.el[i]]
    var parts: []str = []
    for k in el.keys {
        let ci = colIdx(t, &k)
        let name = shownIn(&t.cols[ci].name, &t.cols[ci].spell, gt.md)
        let ref = colRef(b, i, &k, gt.md, keep)
        let kind = t.cols[ci].typ.kind
        let val = if kind == lexdb_sql.K_INT || kind == lexdb_sql.K_NUM || kind == lexdb_sql.K_FLOAT {
            if gt.md == MD_TSQL { "cast(" + ref + " as nvarchar(max))" } else { ref }
        } else {
            "'\"' || " + ref + " || '\"'"
        }
        append(mut &parts, "'\"" + name + "\":' || " + val)
    }
    return Ok("('{\"GRAPH_OWNER\":\"" + gt.owner + "\",\"GRAPH_NAME\":\"" + gt.g.name + "\",\"ELEM_TABLE\":\"" + el.name + "\",\"KEY_VALUE\":{' || " +
              strings.join(&parts, " || ',' || ") + " || '}}')")
}

// v IS [NOT] LABELED l, v IS [NOT] SOURCE OF e, v IS [NOT] DESTINATION OF e (from i): its condition; n the tokens read.
fn isSql(gt: &GT, x: &Exp, b: &Bind, i: int, hi: int, where: int, group: int, copy: int, n: mut &int, keep: mut &[]bool): Result[str, DbErr] {
    let r = &gt.r
    var k = i + 2
    var neg = false
    if k < hi && r.toks[k].kind == T_IDENT && r.toks[k].text == "not" {
        neg = true
        k += 1
    }
    let v = canonIn(&r.toks[i], gt.md)
    let vi = try varFor(gt, x, &v, where, group, copy)
    let el = &gt.g.elems[b.el[vi]]
    if k < hi && r.toks[k].kind == T_IDENT && r.toks[k].text == "labeled" {
        k += 1
        if k >= hi || !isName(&r.toks[k]) { return Err(gerr(gt.ora, 931, "42601", "missing identifier")) }
        let l = canonIn(&r.toks[k], gt.md)
        var known = false
        for g in gt.g.elems { for x2 in g.labels { if x2.name == l { known = true } } }
        if !known { return Err(gerr(gt.ora, 40954, "42704", "unknown label")) }
        var has = false
        for x2 in el.labels { if x2.name == l { has = true } }
        let old = replace(n, k + 1 - i)
        return Ok(if has != neg { "1 = 1" } else { "1 = 0" })
    }
    if k + 2 < hi + 1 && r.toks[k].kind == T_IDENT && (r.toks[k].text == "source" || r.toks[k].text == "destination") &&
       r.toks[k + 1].kind == T_IDENT && r.toks[k + 1].text == "of" && isName(&r.toks[k + 2]) {
        let src = r.toks[k].text == "source"
        let ev = canonIn(&r.toks[k + 2], gt.md)
        let ei = try varFor(gt, x, &ev, where, group, copy)
        let ed = &gt.g.elems[b.el[ei]]
        let end = if src { &ed.src } else { &ed.dst }
        let old = replace(n, k + 3 - i)
        if gt.g.elems[b.el[ei]].vertex || !el.vertex { return Err(gerr(gt.ora, 40956, "42601", "invalid property name format")) }
        if end.elem != el.name {
            return Ok(if neg { "1 = 1" } else { "1 = 0" })
        }
        var eq: []str = []
        for j in 0..len(end.cols) { append(mut &eq, alias(ei) + "." + qIn(&end.cols[j], gt.md) + " = " + colRef(b, vi, &end.refs[j], gt.md, keep)) }
        let c = "(" + strings.join(&eq, " and ") + ")"
        return Ok(if neg { "not " + c } else { c })
    }
    return Err(gerr(gt.ora, 40956, "42601", "invalid property name format"))
}

// An aggregate of COLUMNS over a quantified part's copies (its argument tokens [lo, hi)): COUNT, SUM, MIN, MAX, AVG, LISTAGG/STRING_AGG,
// each an expression over the copies' values (none at length 0: COUNT 0, the others NULL).
fn aggSql(gt: &GT, x: &Exp, b: &Bind, f: &str, lo: int, hi: int, where: int, keep: mut &[]bool): Result[str, DbErr] {
    let r = &gt.r
    if where != 0 { return Err(e("0A000", "lexdb: an aggregate of a quantified variable is supported in COLUMNS only")) }
    if lo < hi && r.toks[lo].kind == T_OP && r.toks[lo].text == "*" { return Err(gerr(gt.ora, 49011, "42P10", "A group function inside GRAPH_TABLE() must have a group reference.")) }
    if lo < hi && r.toks[lo].kind == T_IDENT && (r.toks[lo].text == "distinct" || r.toks[lo].text == "all") {
        return Err(e("0A000", "lexdb: DISTINCT in an aggregate of GRAPH_TABLE is not supported"))
    }
    if hi + 1 < len(r.toks) && r.toks[hi + 1].kind == T_IDENT && (r.toks[hi + 1].text == "within" || r.toks[hi + 1].text == "over") {
        return Err(e("0A000", "lexdb: WITHIN GROUP and OVER after an aggregate of GRAPH_TABLE are not supported"))
    }
    // its argument, and LISTAGG/STRING_AGG's separator
    var aend = hi
    var sep = ""
    var d = 0
    for k in lo..hi {
        let t = &r.toks[k]
        if t.kind == T_OP && t.text == "(" { d += 1 }
        if t.kind == T_OP && t.text == ")" { d -= 1 }
        if t.kind == T_OP && t.text == "," && d == 0 {
            aend = k
            if (f != "listagg" && f != "string_agg") || k + 2 != hi || r.toks[k + 1].kind != T_STR { return Err(e("0A000", "lexdb: LISTAGG of GRAPH_TABLE takes a text literal as its separator")) }
            sep = r.toks[k + 1].text.clone()
            break
        }
    }
    // the quantified part its variables are of
    var grp = -1
    for k in lo..aend {
        let t = &r.toks[k]
        if isName(t) && k + 1 < aend && r.toks[k + 1].kind == T_OP && r.toks[k + 1].text == "." {
            let v = canonIn(t, gt.md)
            for dd in gt.decls { if dd.name == v && dd.group >= 0 { grp = dd.group } }
        }
        if isName(t) && !(k + 1 < aend && r.toks[k + 1].kind == T_OP && (r.toks[k + 1].text == "." || r.toks[k + 1].text == "(")) {
            for dd in gt.decls { if dd.name == canonIn(t, gt.md) { return Err(gerr(gt.ora, 40956, "42601", "invalid property name format")) } }
        }
    }
    if grp < 0 { return Err(gerr(gt.ora, 49011, "42P10", "A group function inside GRAPH_TABLE() must have a group reference.")) }
    let n = x.counts[grp]
    var vals: []str = []
    for c in 1..n + 1 { append(mut &vals, "(" + try exprSql(gt, x, b, lo, aend, 0, grp, c, keep) + ")") }
    if n == 0 { return Ok(if f == "count" { "0" } else { "null" }) }
    if f == "count" {
        var ps: []str = []
        for v in vals { append(mut &ps, "(case when " + v + " is null then 0 else 1 end)") }
        return Ok("(" + strings.join(&ps, " + ") + ")")
    }
    if f == "sum" || f == "avg" {
        var nulls: []str = []
        var ps: []str = []
        var cs: []str = []
        for v in vals {
            append(mut &nulls, v + " is null")
            append(mut &ps, "coalesce(" + v + ", 0)")
            append(mut &cs, "(case when " + v + " is null then 0 else 1 end)")
        }
        let sum = "(case when " + strings.join(&nulls, " and ") + " then null else " + strings.join(&ps, " + ") + " end)"
        if f == "sum" { return Ok(sum) }
        return Ok("(" + sum + " / nullif(" + strings.join(&cs, " + ") + ", 0))")
    }
    if f == "min" || f == "max" {
        if n == 1 { return Ok(vals[0].clone()) }
        var ps: []str = []
        for k in 0..n {
            var order: []str = [vals[k].clone()]
            for j in 0..n { if j != k { append(mut &order, vals[j].clone()) } }
            append(mut &ps, "coalesce(" + strings.join(&order, ", ") + ")")
        }
        return Ok((if f == "min" { "least(" } else { "greatest(" }) + strings.join(&ps, ", ") + ")")
    }
    // LISTAGG / STRING_AGG: the values not NULL in the path's order, the separator between them
    let lit = "'" + strings.replaceAll(&sep, "'", "''") + "'"
    let castTyp = if gt.md == MD_TSQL { "nvarchar(max)" } else { "text" }
    var ps: []str = []
    for v in vals {
        let tv = if gt.ora { if len(sep) > 0 { lit + " || " + v } else { "to_char(" + v + ")" } } else { if len(sep) > 0 { lit + " || cast(" + v + " as " + castTyp + ")" } else { "cast(" + v + " as " + castTyp + ")" } }
        append(mut &ps, "(case when " + v + " is not null then " + tv + " end)")
    }
    let cat = "(" + strings.join(&ps, " || ") + ")"
    if len(sep) == 0 { return Ok(cat) }
    return Ok("substr(" + cat + ", " + (len(sep) + 1).toStr() + ")")
}

// ---- SQL:2023 ANY SHORTEST [PATH] (CSR / bidirectional BFS via #pgq_shortest: SRF)

fn isIntOid(oid: int): bool {
    return oid == lexdb_sql.OID_INT2 || oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT8
}

// Split tokens [lo, hi) on top-level AND (ignoring AND inside BETWEEN ... AND ...).
fn splitAnds(r: &Rdr, lo: int, hi: int): [][]int {
    var out: [][]int = []
    var start = lo
    var d = 0
    var inBetween = false
    for i in lo..hi {
        let t = &r.toks[i]
        if t.kind == T_OP && (t.text == "(" || t.text == "[") { d += 1 }
        else if t.kind == T_OP && (t.text == ")" || t.text == "]") { d -= 1 }
        else if d == 0 && t.kind == T_IDENT && t.text == "between" { inBetween = true }
        else if d == 0 && t.kind == T_IDENT && t.text == "and" {
            if inBetween {
                inBetween = false
            } else {
                if i > start { append(mut &out, [start, i]) }
                start = i + 1
            }
        }
    }
    if hi > start { append(mut &out, [start, hi]) }
    return out
}

// Bitmask of variables referenced in tokens [lo, hi): 1=a, 2=b, 4=e, 8=pathVar/agg.
fn shortestTokVars(gt: &GT, lo: int, hi: int, aName: &str, bName: &str, eName: &str): int {
    let r = &gt.r
    var mask = 0
    var i = lo
    while i < hi {
        let t = &r.toks[i]
        let nx = &r.toks[i + 1]
        if isName(t) && nx.kind == T_OP && nx.text == "." && !(i > lo && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") {
            let v = canonIn(t, gt.md)
            if len(aName) > 0 && v == aName { mask |= 1 }
            if len(bName) > 0 && v == bName { mask |= 2 }
            if len(eName) > 0 && v == eName { mask |= 4 }
            i += 3
            continue
        }
        if t.kind == T_IDENT && nx.kind == T_OP && nx.text == "(" {
            if t.text == "path_length" || isAggNameIn(&t.text, gt.md) {
                mask |= 8
            } else if t.text == "vertex_id" || t.text == "edge_id" {
                let c = closeOf(r, i + 1, hi)
                if c - (i + 2) == 1 && isName(&r.toks[i + 2]) {
                    let v = canonIn(&r.toks[i + 2], gt.md)
                    if len(aName) > 0 && v == aName { mask |= 1 }
                    if len(bName) > 0 && v == bName { mask |= 2 }
                    if len(eName) > 0 && v == eName { mask |= 4 }
                }
            }
        }
        if isName(t) && !(nx.kind == T_OP && (nx.text == "(" || nx.text == ".")) && !(i > lo && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") {
            let v = canonIn(t, gt.md)
            if len(gt.pathVar) > 0 && v == gt.pathVar { mask |= 8 }
            if nx.kind == T_IDENT && nx.text == "is" {
                if len(aName) > 0 && v == aName { mask |= 1 }
                if len(bName) > 0 && v == bName { mask |= 2 }
                if len(eName) > 0 && v == eName { mask |= 4 }
            }
        }
        i += 1
    }
    return mask
}

fn qualPropSimple(p: &Prop, al: &str, md: int): Result[str, DbErr] {
    if len(p.col) > 0 { return Ok(al.toStr() + "." + qIn(&p.col, md)) }
    let r = try readerIn(&p.expr, md)
    var out = ""
    for i in 0..len(r.toks) - 1 {
        let t = &r.toks[i]
        let piece = &r.src[t.at..r.toks[i + 1].at]
        if isName(t) && lexdb_base.hasStr(&p.uses, &t.text) && !(r.toks[i + 1].kind == T_OP && r.toks[i + 1].text == "(") &&
           !(i > 0 && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") {
            out += al.toStr() + "." + qIn(&t.text, md) + " "
            continue
        }
        out += piece
    }
    return Ok(out)
}

fn shortestPropSql(gt: &GT, elIdx: int, al: &str, vKeyCol: &str, spCol: &str, pName: &str, needJoin: mut &bool): Result[str, DbErr] {
    let el = &gt.g.elems[elIdx]
    for l in el.labels {
        for pr in l.props {
            if pr.name == pName {
                if len(spCol) > 0 && len(pr.col) > 0 && pr.col == vKeyCol {
                    return Ok("\"gt$sp\"." + qIn(spCol, gt.md))
                }
                let _ = replace(needJoin, true)
                return qualPropSimple(&pr, al, gt.md)
            }
        }
    }
    return Ok(nullOf(gt, pName))
}

fn shortestVertexIdSql(gt: &GT, vElIdx: int, vKeyCol: &str, spCol: &str): str {
    let el = &gt.g.elems[vElIdx]
    let t = &gt.tabs[vElIdx]
    let ci = colIdx(t, vKeyCol)
    let name = shownIn(&t.cols[ci].name, &t.cols[ci].spell, gt.md)
    let ref = "\"gt$sp\"." + qIn(spCol, gt.md)
    let val = if gt.md == MD_TSQL { "cast(" + ref + " as nvarchar(max))" } else { ref }
    return "('{\"GRAPH_OWNER\":\"" + gt.owner + "\",\"GRAPH_NAME\":\"" + gt.g.name + "\",\"ELEM_TABLE\":\"" + el.name + "\",\"KEY_VALUE\":{\"" + name + "\":' || " + val + " || '}}')"
}

fn edgePropNonNull(gt: &GT, eElIdx: int, pName: &str): bool {
    let el = &gt.g.elems[eElIdx]
    let t = &gt.tabs[eElIdx]
    for l in el.labels {
        for pr in l.props {
            if pr.name != pName { continue }
            if len(pr.col) == 0 { return false }
            let ci = colIdx(t, &pr.col)
            if ci < 0 { return false }
            if t.cols[ci].notNull { return true }
            for pi in t.pk { if pi == ci { return true } }
            return false
        }
    }
    return false
}

// Render tokens [lo, hi) for ANY SHORTEST:
// mode: 0 = outer COLUMNS/WHERE, 1 = srcSql (a), 2 = dstSql (b), 3 = edgeSql (e).
fn shortestExprSql(gt: &GT, lo: int, hi: int, mode: int, aName: &str, bName: &str, eName: &str,
                   sameVar: bool, vElIdx: int, eElIdx: int, vKeyCol: &str,
                   needA: mut &bool, needB: mut &bool): Result[str, DbErr] {
    let r = &gt.r
    var out = ""
    var i = lo
    while i < hi {
        let t = &r.toks[i]
        let nx = &r.toks[i + 1]
        let piece = &r.src[t.at..r.toks[i + 1].at]
        if t.kind == T_OP && t.text == "(" && nx.kind == T_IDENT && (nx.text == "select" || nx.text == "with") {
            return Err(gerr(gt.ora, 40988, "0A000", "Subquery is not allowed in a GRAPH_TABLE operator."))
        }
        // v.p
        if isName(t) && nx.kind == T_OP && nx.text == "." && !(i > lo && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") {
            let v = canonIn(t, gt.md)
            var d = -1
            for k in 0..len(gt.decls) { if gt.decls[k].name == v { d = k } }
            if d >= 0 && i + 2 < hi && isName(&r.toks[i + 2]) {
                let p = canonIn(&r.toks[i + 2], gt.md)
                if mode == 1 {
                    var ign = false
                    out += "(" + try shortestPropSql(gt, vElIdx, "\"gt$s\"", vKeyCol, "", &p, mut &ign) + ") "
                } else if mode == 2 {
                    var ign = false
                    out += "(" + try shortestPropSql(gt, vElIdx, "\"gt$d\"", vKeyCol, "", &p, mut &ign) + ") "
                } else if mode == 3 {
                    var ign = false
                    out += "(" + try shortestPropSql(gt, eElIdx, "\"gt$e\"", "", "", &p, mut &ign) + ") "
                } else {
                    if len(aName) > 0 && v == aName {
                        out += "(" + try shortestPropSql(gt, vElIdx, "\"gt$a\"", vKeyCol, "src", &p, needA) + ") "
                    } else if len(bName) > 0 && v == bName {
                        out += "(" + try shortestPropSql(gt, vElIdx, "\"gt$b\"", vKeyCol, "dst", &p, needB) + ") "
                    } else if len(eName) > 0 && v == eName {
                        return Err(gerr(gt.ora, 40990, "42P10", &("invalid reference of group variable " + v + " in the COLUMNS clause of a GRAPH_TABLE operator")))
                    } else {
                        return Err(gerr(gt.ora, 40996, "42704", &("Variable " + v + " is not declared in the MATCH clause of a GRAPH_TABLE operator.")))
                    }
                }
                i += 3
                continue
            }
            if d >= 0 { return Err(gerr(gt.ora, 40956, "42601", "invalid property name format")) }
        }
        // Function calls: path_length(p), count(e.prop), vertex_id(v)
        if t.kind == T_IDENT && nx.kind == T_OP && nx.text == "(" {
            let c = closeOf(r, i + 1, hi)
            if t.text == "path_length" {
                if mode != 0 { return Err(e("0A000", "lexdb: PATH_LENGTH() is supported in COLUMNS and outer WHERE only")) }
                if c - (i + 2) != 1 || !isName(&r.toks[i + 2]) { return Err(gerr(gt.ora, 40956, "42601", "invalid argument to PATH_LENGTH()")) }
                let pv = canonIn(&r.toks[i + 2], gt.md)
                if len(gt.pathVar) == 0 || pv != gt.pathVar {
                    return Err(gerr(gt.ora, 40996, "42704", &("Path variable \"" + pv + "\" is not declared in the MATCH clause of a GRAPH_TABLE operator.")))
                }
                out += "\"gt$sp\".\"hops\" "
                i = c + 1
                continue
            }
            if t.text == "count" && mode == 0 {
                // count(e.prop) or count(e) on the quantified edge variable -> hops
                let alo = i + 2
                var handled = false
                if c - alo == 3 && isName(&r.toks[alo]) && r.toks[alo + 1].kind == T_OP && r.toks[alo + 1].text == "." && isName(&r.toks[alo + 2]) {
                    let ev = canonIn(&r.toks[alo], gt.md)
                    let ep = canonIn(&r.toks[alo + 2], gt.md)
                    if len(eName) > 0 && ev == eName {
                        if !edgePropNonNull(gt, eElIdx, &ep) {
                            return Err(e("0A000", "lexdb: COUNT() over a nullable edge property in ANY SHORTEST is not supported (use PATH_LENGTH(p) or a NOT NULL key property)"))
                        }
                        out += "\"gt$sp\".\"hops\" "
                        handled = true
                    }
                } else if c - alo == 1 && isName(&r.toks[alo]) && len(eName) > 0 && canonIn(&r.toks[alo], gt.md) == eName {
                    out += "\"gt$sp\".\"hops\" "
                    handled = true
                }
                if handled {
                    i = c + 1
                    continue
                }
            }
            if t.text == "vertex_id" || (t.text == "json_serialize" && i + 3 < hi && r.toks[i + 2].kind == T_IDENT && r.toks[i + 2].text == "vertex_id") {
                let innerLo = if t.text == "vertex_id" { i + 2 } else { i + 4 }
                let innerHi = if t.text == "vertex_id" { c } else { closeOf(r, i + 3, hi) }
                if innerHi - innerLo != 1 || !isName(&r.toks[innerLo]) { return Err(gerr(gt.ora, 40956, "42601", "invalid property name format")) }
                let v = canonIn(&r.toks[innerLo], gt.md)
                if mode == 0 && len(aName) > 0 && v == aName {
                    out += shortestVertexIdSql(gt, vElIdx, vKeyCol, "src") + " "
                    i = c + 1
                    continue
                }
                if mode == 0 && len(bName) > 0 && v == bName {
                    out += shortestVertexIdSql(gt, vElIdx, vKeyCol, "dst") + " "
                    i = c + 1
                    continue
                }
            }
            if t.text == "element_number" { return Err(gerr(gt.ora, 49033, "42P10", "ELEMENT_NUMBER can only be used in combination with ONE ROW PER VERTEX or STEP.")) }
            if t.text == "matchnum" { return Err(e("0A000", "lexdb: MATCHNUM() is supported as a COLUMNS item by itself")) }
            if isAggNameIn(&t.text, gt.md) {
                return Err(e("0A000", "lexdb: only PATH_LENGTH(p) and COUNT(e.key) aggregates are supported in ANY SHORTEST"))
            }
        }
        // v IS [NOT] LABELED l
        if isName(t) && !(nx.kind == T_OP && (nx.text == "(" || nx.text == ".")) && !(i > lo && r.toks[i - 1].kind == T_OP && r.toks[i - 1].text == ".") {
            let v = canonIn(t, gt.md)
            var d = -1
            for k in 0..len(gt.decls) { if gt.decls[k].name == v { d = k } }
            if d >= 0 && nx.kind == T_IDENT && nx.text == "is" {
                var k = i + 2
                var neg = false
                if k < hi && r.toks[k].kind == T_IDENT && r.toks[k].text == "not" { neg = true; k += 1 }
                if k + 1 < hi && r.toks[k].kind == T_IDENT && r.toks[k].text == "labeled" && isName(&r.toks[k + 1]) {
                    let l = canonIn(&r.toks[k + 1], gt.md)
                    var known = false
                    for g2 in gt.g.elems { for x2 in g2.labels { if x2.name == l { known = true } } }
                    if !known { return Err(gerr(gt.ora, 40954, "42704", "unknown label")) }
                    let elIdx = if gt.decls[d].vertex { vElIdx } else { eElIdx }
                    var has = false
                    for x2 in gt.g.elems[elIdx].labels { if x2.name == l { has = true } }
                    out += if has != neg { "1 = 1 " } else { "1 = 0 " }
                    i = k + 2
                    continue
                }
            }
            if d >= 0 { return Err(gerr(gt.ora, 40956, "42601", "invalid property name format")) }
        }
        out += piece
        i += 1
    }
    return Ok(out)
}

fn expandShortest(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, gt: &GT, md: int, nls: []str): Result[Stmt, DbErr] {
    try checkRefs(gt)
    if len(gt.paths) != 1 || len(gt.paths[0]) != 3 {
        return Err(e("0A000", "lexdb: ANY SHORTEST requires a single path pattern of the form (a)-[e]->{...}(b)"))
    }
    let p0 = &gt.paths[0][0]
    let p1 = &gt.paths[0][1]
    let p2 = &gt.paths[0][2]
    if p0.group || !p0.ep.vertex || p2.group || !p2.ep.vertex {
        return Err(e("0A000", "lexdb: ANY SHORTEST requires vertex patterns at both endpoints"))
    }
    var minHops = 1
    var maxHops = 1
    var eEp = noEP()
    if p1.group {
        if len(p1.sub) != 1 || p1.sub[0].group || p1.sub[0].ep.vertex {
            return Err(e("0A000", "lexdb: ANY SHORTEST currently supports a single quantified edge pattern"))
        }
        eEp = p1.sub[0].ep.clone()
        minHops = p1.lo
        maxHops = p1.hi
    } else {
        if p1.ep.vertex {
            return Err(e("0A000", "lexdb: ANY SHORTEST requires an edge pattern between endpoints"))
        }
        eEp = p1.ep.clone()
    }

    let aName = p0.ep.vname.clone()
    let bName = p2.ep.vname.clone()
    let eName = eEp.vname.clone()
    let sameVar = len(aName) > 0 && aName == bName

    var aLabs: [][][]str = []
    if len(p0.ep.lab) > 0 { append(mut &aLabs, p0.ep.lab.clone()) }
    var bLabs: [][][]str = []
    if len(p2.ep.lab) > 0 { append(mut &bLabs, p2.ep.lab.clone()) }
    if sameVar {
        for l in bLabs { append(mut &aLabs, l.clone()) }
        bLabs = aLabs.clone()
    }
    var eLabs: [][][]str = []
    if len(eEp.lab) > 0 { append(mut &eLabs, eEp.lab.clone()) }

    let aCands = candidates(gt, true, &aLabs)
    let bCands = candidates(gt, true, &bLabs)
    let eCands = candidates(gt, false, &eLabs)

    // Find compatible (vEl, eEl) where eEl connects vEl -> vEl
    var matchV = -1
    var matchE = -1
    var matchCount = 0
    for ei in eCands {
        let el = &gt.g.elems[ei]
        let sx = elemIndex(gt, &el.src.elem)
        let dx = elemIndex(gt, &el.dst.elem)
        if sx < 0 || dx < 0 { continue }
        if sx == dx && hasInt(&aCands, sx) && hasInt(&bCands, dx) {
            matchV = sx
            matchE = ei
            matchCount += 1
        }
    }
    if matchCount == 0 {
        // No compatible elements: return empty result with properly typed columns
        var items: []str = []
        for c in gt.cols {
            if c.matchnum {
                append(mut &items, "cast(null as bigint) " + qIn(&c.name, md))
            } else if len(c.vname) > 0 {
                append(mut &items, nullOf(gt, &c.prop) + " " + qIn(&c.name, md))
            } else {
                append(mut &items, "cast(null as bigint) " + qIn(&c.name, md))
            }
        }
        let emptySql = "select " + strings.join(&items, ", ") + " where 1 = 0"
        var ss = try parseSql(&emptySql, md, nls)
        var out = pop(mut &ss)
        out.use = lexdb_sql.SUB_FROM
        out.mdialect = md
        return Ok(out)
    }
    if matchCount > 1 {
        return Err(e("0A000", "lexdb: ANY SHORTEST currently supports a single edge element table (specify an edge label with IS)"))
    }

    let vEl = &gt.g.elems[matchV]
    let eEl = &gt.g.elems[matchE]
    let vt = &gt.tabs[matchV]
    let et = &gt.tabs[matchE]
    if len(vEl.keys) != 1 || len(eEl.src.cols) != 1 || len(eEl.dst.cols) != 1 ||
       len(eEl.src.refs) != 1 || len(eEl.dst.refs) != 1 ||
       eEl.src.refs[0] != vEl.keys[0] || eEl.dst.refs[0] != vEl.keys[0] {
        return Err(e("0A000", "lexdb: ANY SHORTEST requires single-column vertex and edge endpoint keys"))
    }
    let vKeyCol = vEl.keys[0].clone()
    let eSrcCol = eEl.src.cols[0].clone()
    let eDstCol = eEl.dst.cols[0].clone()
    let vKeyIdx = colIdx(vt, &vKeyCol)
    let eSrcIdx = colIdx(et, &eSrcCol)
    let eDstIdx = colIdx(et, &eDstCol)
    if vKeyIdx < 0 || eSrcIdx < 0 || eDstIdx < 0 ||
       !isIntOid(vt.cols[vKeyIdx].typ.oid) || !isIntOid(et.cols[eSrcIdx].typ.oid) || !isIntOid(et.cols[eDstIdx].typ.oid) {
        return Err(e("0A000", "lexdb: ANY SHORTEST requires integer vertex and edge key columns"))
    }
    let vKeyOid = vt.cols[vKeyIdx].typ.oid
    let csrDir = if eEp.dir == DIR_R { 0 } else if eEp.dir == DIR_L { 1 } else { 2 }

    // Partition element WHEREs and outer MATCH WHERE conjuncts
    var aSpans: [][]int = []
    var bSpans: [][]int = []
    var eSpans: [][]int = []
    var postSpans: [][]int = []
    if p0.ep.wlo >= 0 {
        append(mut &aSpans, [p0.ep.wlo, p0.ep.whi])
        if sameVar { append(mut &bSpans, [p0.ep.wlo, p0.ep.whi]) }
    }
    if p2.ep.wlo >= 0 {
        append(mut &bSpans, [p2.ep.wlo, p2.ep.whi])
        if sameVar { append(mut &aSpans, [p2.ep.wlo, p2.ep.whi]) }
    }
    if eEp.wlo >= 0 { append(mut &eSpans, [eEp.wlo, eEp.whi]) }
    if gt.wlo >= 0 {
        for sp in splitAnds(&gt.r, gt.wlo, gt.whi) {
            let m = shortestTokVars(gt, sp[0], sp[1], &aName, &bName, &eName)
            if sameVar {
                if (m & 12) == 0 && (m & 3) != 0 {
                    append(mut &aSpans, sp.clone())
                    append(mut &bSpans, sp)
                } else if m == 4 {
                    append(mut &eSpans, sp)
                } else {
                    append(mut &postSpans, sp)
                }
            } else {
                if m == 1 { append(mut &aSpans, sp) }
                else if m == 2 { append(mut &bSpans, sp) }
                else if m == 4 { append(mut &eSpans, sp) }
                else { append(mut &postSpans, sp) }
            }
        }
    }

    var ignA = false
    var ignB = false
    var aConds: []str = []
    for sp in aSpans {
        append(mut &aConds, "(" + try shortestExprSql(gt, sp[0], sp[1], 1, &aName, &bName, &eName, sameVar, matchV, matchE, &vKeyCol, mut &ignA, mut &ignB) + ")")
    }
    var bConds: []str = []
    for sp in bSpans {
        append(mut &bConds, "(" + try shortestExprSql(gt, sp[0], sp[1], 2, &aName, &bName, &eName, sameVar, matchV, matchE, &vKeyCol, mut &ignA, mut &ignB) + ")")
    }
    var eConds: []str = []
    for sp in eSpans {
        append(mut &eConds, "(" + try shortestExprSql(gt, sp[0], sp[1], 3, &aName, &bName, &eName, sameVar, matchV, matchE, &vKeyCol, mut &ignA, mut &ignB) + ")")
    }

    let srcSql = "select \"gt$s\"." + qIn(&vKeyCol, md) + " from " + relTextIn(&vEl.table, md) + " \"gt$s\"" +
                 (if len(aConds) > 0 { " where " + strings.join(&aConds, " and ") } else { "" })
    let dstSql = if len(bConds) > 0 {
        "select \"gt$d\"." + qIn(&vKeyCol, md) + " from " + relTextIn(&vEl.table, md) + " \"gt$d\" where " + strings.join(&bConds, " and ")
    } else { "" }
    let edgeSql = if len(eConds) > 0 {
        "select \"gt$e\"." + qIn(&eSrcCol, md) + ", \"gt$e\"." + qIn(&eDstCol, md) + " from " + relTextIn(&eEl.table, md) + " \"gt$e\" where " + strings.join(&eConds, " and ")
    } else { "" }

    // Render outer post-conditions and COLUMNS, tracking whether vertex table joins are needed
    var needA = false
    var needB = false
    var postConds: []str = []
    if sameVar { append(mut &postConds, "\"gt$sp\".\"src\" = \"gt$sp\".\"dst\"") }
    for sp in postSpans {
        append(mut &postConds, "(" + try shortestExprSql(gt, sp[0], sp[1], 0, &aName, &bName, &eName, sameVar, matchV, matchE, &vKeyCol, mut &needA, mut &needB) + ")")
    }
    var items: []str = []
    var hasMn = false
    let rn = if md == MD_ORA { "row_number() over (order by null) " } else { "row_number() over () " }
    for c in gt.cols {
        if c.matchnum {
            hasMn = true
            append(mut &items, rn + qIn(&c.name, md))
            continue
        }
        let ex = if len(c.vname) > 0 {
            if len(aName) > 0 && c.vname == aName {
                "(" + try shortestPropSql(gt, matchV, "\"gt$a\"", &vKeyCol, "src", &c.prop, mut &needA) + ")"
            } else if len(bName) > 0 && c.vname == bName {
                "(" + try shortestPropSql(gt, matchV, "\"gt$b\"", &vKeyCol, "dst", &c.prop, mut &needB) + ")"
            } else {
                return Err(gerr(gt.ora, 40990, "42P10", &("invalid reference of variable " + c.vname + " in the COLUMNS clause of a GRAPH_TABLE operator")))
            }
        } else {
            try shortestExprSql(gt, c.lo, c.hi, 0, &aName, &bName, &eName, sameVar, matchV, matchE, &vKeyCol, mut &needA, mut &needB)
        }
        append(mut &items, ex + " " + qIn(&c.name, md))
    }
    if len(items) == 0 { append(mut &items, "null \"gt$none\"") }

    var from: []str = ["\"gt$sp_placeholder\" \"gt$sp\""]
    var conds: []str = []
    if needA {
        append(mut &from, relTextIn(&vEl.table, md) + " \"gt$a\"")
        append(mut &conds, "\"gt$a\"." + qIn(&vKeyCol, md) + " = \"gt$sp\".\"src\"")
    }
    if needB {
        append(mut &from, relTextIn(&vEl.table, md) + " \"gt$b\"")
        append(mut &conds, "\"gt$b\"." + qIn(&vKeyCol, md) + " = \"gt$sp\".\"dst\"")
    }
    for pc in postConds { append(mut &conds, pc) }

    var outerSql = "select " + strings.join(&items, ", ") + " from " + strings.join(&from, ", ")
    if len(conds) > 0 { outerSql += " where " + strings.join(&conds, " and ") }
    var ss = try parseSql(&outerSql, md, nls)
    if len(ss) != 1 { return Err(lexdb_base.corrupt("GRAPH_TABLE ANY SHORTEST query")) }
    var out = pop(mut &ss)

    // Encode #pgq_shortest: SRF spec and attach as subquery replacing gt$sp_placeholder
    var specBuf = ""
    let specParts: []str = [
        eEl.table.clone(),
        eSrcIdx.toStr(),
        eDstIdx.toStr(),
        vKeyOid.toStr(),
        csrDir.toStr(),
        minHops.toStr(),
        maxHops.toStr(),
        md.toStr(),
        srcSql,
        dstSql,
        edgeSql
    ]
    lexdb_catalog.addStrs(mut &specBuf, &specParts)
    var sp = lexdb_sql.newStmt(lexdb_sql.S_SELECT)
    sp.use = lexdb_sql.SUB_FROM
    sp.srf = PGQ_SHORTEST_PRE + specBuf
    sp.mdialect = md
    let spIdx = len(out.subs)
    append(mut &out.subs, sp)
    for fi in 0..len(out.from) {
        if out.from[fi].table == "gt$sp_placeholder" {
            out.from[fi].table = ""
            out.from[fi].sub = spIdx
        }
    }
    // Preserve max $n parameter count across srcSql / dstSql / edgeSql / outer
    for tk in gt.r.toks {
        if tk.kind == T_PARAM && len(tk.text) > 1 {
            let pn = lexdb_base.num(&tk.text[1..len(tk.text)])
            if pn > out.params { out.params = pn }
        }
    }
    out.use = lexdb_sql.SUB_FROM
    out.mdialect = md
    let _ = hasMn
    return Ok(out)
}
