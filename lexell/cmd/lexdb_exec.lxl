// lexdb: running statements (design/lexdb.md 4.2, 4.8). Tables, rows and
// keys on the store's trees; the planner's rules; a session's transaction.
//
// The catalog is tree 1: table name -> its definition (its tree, columns,
// primary key), read and written in the statement's transaction like any
// row, so DDL is transactional. A row is one entry of its table's tree: the
// key is the primary key's columns, encoded so that byte order is SQL
// order; the value is every column.
//
// A secondary index is a tree of its own: per row, the indexed columns then
// the primary key as the key, the primary key as the value. Its definition
// is part of its table's catalog entry, and its name maps to the table.
//
// Plans are rules, not costs (choosePath): the primary key or an index,
// by its leading equalities and a range on the next column, else a full
// scan; every row is then checked against the WHERE. Joins run in FROM order,
// a nested loop through a key or an index when one fits, else a hash join.
import "binary"
import "strings"
import "collections"
import "time"
import "task"
import "./lexdb_base"
import "./lexdb_store"
import "./lexdb_sql"

pub const CATALOG = 1

type Val = lexdb_sql.Val
type Expr = lexdb_sql.Expr
type DbErr = lexdb_base.DbErr

fn e(state: str, msg: str): DbErr { return lexdb_base.err(state, msg) }

pub type Index = record {
    pub name: str
    pub tree: int
    pub cols: []int
    pub unique: bool
    pub pred: Option[Expr]      // a filtered index: the rows it holds (column names bare)
}

pub type Table = record {
    pub name: str
    pub tree: int
    pub cols: []lexdb_sql.ColDef
    pub pk: []int
    pub indexes: []Index
}

// A result column: its name and type OID.
pub type OutCol = value record { pub name: str; pub oid: int }

pub type Res = record {
    pub cols: []OutCol
    pub rows: [][]Val
    pub tag: str
    pub hasRows: bool       // a statement that returns rows (SELECT), even none
}

fn tagOnly(tag: str): Res { return Res{cols: [], rows: [], tag: tag, hasRows: false} }

// ---- values

// The text a client sees for a value (NULL is told apart by the caller).
pub fn text(v: &Val): str {
    match v {
        Val.Null { return "" }
        Val.Int(n) { return n.toStr() }
        Val.Bool(b) { return if b { "t" } else { "f" } }
        Val.Num(d) { return d.toStr() }
        Val.Text(s) { return s }
    }
}

pub fn isNull(v: &Val): bool {
    match v {
        Val.Null { return true }
        else { return false }
    }
}

fn kindName(t: &lexdb_sql.TypeName): str {
    if t.kind == lexdb_sql.K_INT {
        return if t.oid == lexdb_sql.OID_INT8 { "bigint" } else if t.oid == lexdb_sql.OID_INT2 { "smallint" } else { "integer" }
    }
    if t.kind == lexdb_sql.K_BOOL { return "boolean" }
    if t.kind == lexdb_sql.K_NUM { return "numeric" }
    return if t.oid == lexdb_sql.OID_VARCHAR { "character varying" } else { "text" }
}

fn badInput(t: &lexdb_sql.TypeName, s: &str): DbErr {
    return e("22P02", "invalid input syntax for type " + kindName(t) + ": \"" + s + "\"")
}

fn parseBool(s: &str): Option[bool] {
    let l = strings.toLowerAscii(strings.trim(s))
    if l == "t" || l == "true" || l == "yes" || l == "on" || l == "1" || l == "y" { return Some(true) }
    if l == "f" || l == "false" || l == "no" || l == "off" || l == "0" || l == "n" { return Some(false) }
    return None
}

fn intDigits(d: &Decimal): int {
    let s = d.abs().toStr()
    let dot = strings.indexOf(&s, ".", 0)
    let ip = if dot < 0 { s } else { s[0..dot] }
    if ip == "0" { return 0 }
    return len(ip)
}

fn intRange(t: &lexdb_sql.TypeName, n: int): Result[int, DbErr] {
    if t.oid == lexdb_sql.OID_INT4 && (n < -2147483648 || n > 2147483647) { return Err(e("22003", "integer out of range")) }
    if t.oid == lexdb_sql.OID_INT2 && (n < -32768 || n > 32767) { return Err(e("22003", "smallint out of range")) }
    return Ok(n)
}

// A value made fit for a column of type t (an assignment's conversion).
pub fn coerce(v: Val, t: &lexdb_sql.TypeName): Result[Val, DbErr] {
    match v {
        Val.Null { return Ok(Val.Null) }
        else {}
    }
    if t.kind == lexdb_sql.K_INT {
        match v {
            Val.Int(n) { return Ok(Val.Int(try intRange(t, n))) }
            Val.Num(d) {
                match d.toInt(Rounding.HALF_AWAY) {
                    Ok(n) { return Ok(Val.Int(try intRange(t, n))) }
                    Err(_) { return Err(e("22003", kindName(t) + " out of range")) }
                }
            }
            Val.Text(s) {
                match strings.parseIntOpt(strings.trim(s)) {
                    Some(n) { return Ok(Val.Int(try intRange(t, n))) }
                    None { return Err(badInput(t, &s)) }
                }
            }
            else {}
        }
    } else if t.kind == lexdb_sql.K_BOOL {
        match v {
            Val.Bool(b) { return Ok(Val.Bool(b)) }
            Val.Text(s) {
                match parseBool(&s) {
                    Some(b) { return Ok(Val.Bool(b)) }
                    None { return Err(badInput(t, &s)) }
                }
            }
            else {}
        }
    } else if t.kind == lexdb_sql.K_NUM {
        var d = Decimal.zero()
        match v {
            Val.Int(n) { d = Decimal.fromInt(n) }
            Val.Num(x) { d = x }
            Val.Text(s) {
                match Decimal.parse(strings.trim(s)) {
                    Ok(x) { d = x }
                    Err(_) { return Err(badInput(t, &s)) }
                }
            }
            else { return Err(e("42804", "column is of type numeric but expression is of type boolean")) }
        }
        if t.prec > 0 {
            match d.quantize(t.scale, Rounding.HALF_AWAY) {
                Ok(q) { d = q }
                Err(_) { return Err(e("22003", "numeric field overflow")) }
            }
            if intDigits(&d) > t.prec - t.scale {
                return Err(e("22003", "numeric field overflow: a field with precision " + t.prec.toStr() + ", scale " +
                             t.scale.toStr() + " must round to an absolute value less than 10^" + (t.prec - t.scale).toStr()))
            }
        }
        return Ok(Val.Num(d))
    } else if t.kind == lexdb_sql.K_ARRAY {
        match v {
            Val.Text(x) {
                let et = oidType(lexdb_sql.elemOid(t.oid))
                var vals: []Val = []
                for part in try arrayParts(&x) {
                    match part {
                        Some(p) { append(mut &vals, try coerce(Val.Text(p), &et)) }
                        None { append(mut &vals, Val.Null) }
                    }
                }
                return Ok(Val.Text(arrayText(&vals)))
            }
            else { return Err(e("42804", "cannot cast a " + kindName(&oidType(kindOid(&v))) + " to " + lexdb_sql.typeText(t))) }
        }
    } else {
        var s = ""
        match v {
            Val.Text(x) { s = x }
            Val.Int(n) { s = n.toStr() }
            Val.Num(d) { s = d.toStr() }
            Val.Bool(b) { s = if b { "true" } else { "false" } }
            else {}
        }
        if t.len > 0 && strings.runeCount(&s) > t.len {
            return Err(e("22001", "value too long for type character varying(" + t.len.toStr() + ")"))
        }
        return Ok(Val.Text(s))
    }
    return Err(e("42804", "column is of type " + kindName(t) + " but the expression is of another type"))
}

// ---- arrays (9.27): one dimension, held as PostgreSQL's text form

// The elements of an array's text form, {a,"b c",NULL}: None for NULL.
fn arrayParts(s: &str): Result[[]Option[str], DbErr] {
    let bad = e("22P02", "malformed array literal: \"" + s + "\"")
    var out: []Option[str] = []
    var i = 0
    let n = len(s)
    while i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n') { i += 1 }
    if i >= n || s[i] != '{' { return Err(bad) }
    i += 1
    while i < n && s[i] == ' ' { i += 1 }
    if i < n && s[i] == '}' { return Ok(out) }
    while true {
        while i < n && s[i] == ' ' { i += 1 }
        if i >= n { return Err(bad) }
        if s[i] == '{' { return Err(e("0A000", "lexdb: arrays of more than one dimension are not supported")) }
        if s[i] == '"' {
            var b = newStrBuf()
            i += 1
            while i < n && s[i] != '"' {
                if s[i] == '\\' { i += 1 }
                if i >= n { return Err(bad) }
                b.addByte(s[i])
                i += 1
            }
            if i >= n { return Err(bad) }
            i += 1
            append(mut &out, Some(b.toStr()))
        } else {
            var b = newStrBuf()
            while i < n && s[i] != ',' && s[i] != '}' {
                if s[i] == '\\' { i += 1 }
                if i >= n { return Err(bad) }
                b.addByte(s[i])
                i += 1
            }
            let w = strings.trim(b.toStr())
            if len(w) == 0 { return Err(bad) }
            if strings.toLowerAscii(w) == "null" { append(mut &out, None) } else { append(mut &out, Some(w)) }
        }
        while i < n && s[i] == ' ' { i += 1 }
        if i >= n { return Err(bad) }
        if s[i] == '}' {
            i += 1
            break
        }
        if s[i] != ',' { return Err(bad) }
        i += 1
    }
    while i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n') { i += 1 }
    if i != n { return Err(bad) }
    return Ok(out)
}

// An array's text form: elements quoted when they must be.
pub fn arrayText(vals: &[]Val): str {
    var b = newStrBuf()
    b.addByte('{')
    for i in 0..len(vals) {
        if i > 0 { b.addByte(',') }
        match vals[i] {
            Val.Null { b.add("NULL") }
            Val.Bool(x) { b.add(if x { "t" } else { "f" }) }
            Val.Text(x) {
                var plain = len(x) > 0 && strings.toLowerAscii(x) != "null"
                for k in 0..len(x) {
                    let c = x[k]
                    if c == ',' || c == '{' || c == '}' || c == '"' || c == '\\' || c == ' ' || c == '\t' || c == '\n' { plain = false }
                }
                if plain { b.add(x) } else {
                    b.addByte('"')
                    for k in 0..len(x) {
                        if x[k] == '"' || x[k] == '\\' { b.addByte('\\') }
                        b.addByte(x[k])
                    }
                    b.addByte('"')
                }
            }
            else { b.add(text(&vals[i])) }
        }
    }
    b.addByte('}')
    return b.toStr()
}

// A value's type OID by its kind (for messages).
fn kindOid(v: &Val): int {
    match v {
        Val.Int(_) { return lexdb_sql.OID_INT8 }
        Val.Bool(_) { return lexdb_sql.OID_BOOL }
        Val.Num(_) { return lexdb_sql.OID_NUMERIC }
        else { return lexdb_sql.OID_TEXT }
    }
}

// A function in FROM: its columns, from its arguments' types.
fn srfCols(name: &str, ordin: bool, args: &[]OutCol): Result[[]OutCol, DbErr] {
    var out: []OutCol = []
    if name == "generate_series" {
        if len(args) < 2 || len(args) > 3 {
            return Err(e("42883", "function generate_series with " + len(args).toStr() + " arguments does not exist"))
        }
        var oid = lexdb_sql.OID_INT4
        for a in args {
            if a.oid == lexdb_sql.OID_NUMERIC { oid = lexdb_sql.OID_NUMERIC }
            else if oid != lexdb_sql.OID_NUMERIC && a.oid != lexdb_sql.OID_INT4 && a.oid != lexdb_sql.OID_INT2 { oid = lexdb_sql.OID_INT8 }
        }
        for a in args {
            let k = oidType(a.oid).kind
            if k != lexdb_sql.K_INT && k != lexdb_sql.K_NUM && a.oid != lexdb_sql.OID_TEXT {
                return Err(e("42883", "function generate_series needs numbers"))
            }
        }
        append(mut &out, OutCol{name: "generate_series", oid: oid})
    } else {
        if len(args) == 0 { return Err(e("42883", "function unnest() does not exist")) }
        for k in 0..len(args) {
            let el = lexdb_sql.elemOid(args[k].oid)
            if el == 0 {
                return Err(e("42804", "function unnest: argument " + (k + 1).toStr() + " is not an array (cast it: $1::int[], '{1,2}'::text[])"))
            }
            append(mut &out, OutCol{name: "unnest", oid: el})
        }
    }
    if ordin { append(mut &out, OutCol{name: "ordinality", oid: lexdb_sql.OID_INT8}) }
    return Ok(out)
}

// A function in FROM, run: its arguments, then its rows.
fn execSrf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int,
           rs: mut &Run): Result[Res, DbErr] {
    let m = try prepare(st, txn, &sel.q, params, rs)
    let noRow: []Val = []
    let env = Env{cols: &sel.q.cols, row: &noRow, aggs: &noRow, params: params, subs: &m.subs, cur: &noRow}
    var args: []Val = []
    for x in sel.exprs { append(mut &args, try evalX(st, txn, &sel.q, &x, &env, rs)) }
    var rows: [][]Val = []
    let room = rs.room()
    var bytes = 0
    if sel.srf == "generate_series" {
        for a in args { if isNull(&a) { return Ok(Res{cols: [], rows: [], tag: "", hasRows: true}) } }
        let ty = oidType(sel.outs[0].oid)
        let start = try coerce(args[0], &ty)
        let stop = try coerce(args[1], &ty)
        let step = if len(args) > 2 { try coerce(args[2], &ty) } else { try coerce(Val.Int(1), &ty) }
        let zero = try coerce(Val.Int(0), &ty)
        let dir = try compare(&step, &zero)
        if dir == 0 { return Err(e("22023", "step size cannot equal zero")) }
        var v = start
        var n = 0
        while true {
            let c = try compare(&v, &stop)
            if (dir > 0 && c > 0) || (dir < 0 && c < 0) { break }
            if cap >= 0 && len(rows) >= cap { break }
            n += 1
            var row: []Val = [v]
            if sel.ordin { append(mut &row, Val.Int(n)) }
            bytes += rowBytes(&row)
            if room >= 0 && bytes > room { return Err(memErr(rs.maxHeld)) }
            append(mut &rows, row)
            try rs.tick()
            // the next value; past the type's range: the end
            match arith(&"+", &v, &step) {
                Ok(x) { v = x }
                Err(_) { break }
            }
            if ty.kind == lexdb_sql.K_INT {
                match coerce(v, &ty) {
                    Ok(x) { v = x }
                    Err(_) { break }
                }
            }
        }
    } else {
        // unnest: the arrays side by side, the shorter padded with NULLs
        var cols: [][]Val = []
        var most = 0
        for k in 0..len(args) {
            var vals: []Val = []
            match args[k] {
                Val.Text(x) {
                    let et = oidType(sel.outs[k].oid)
                    for part in try arrayParts(&x) {
                        match part {
                            Some(p) { append(mut &vals, try coerce(Val.Text(p), &et)) }
                            None { append(mut &vals, Val.Null) }
                        }
                    }
                }
                else {}
            }
            if len(vals) > most { most = len(vals) }
            append(mut &cols, vals)
        }
        for i in 0..most {
            if cap >= 0 && len(rows) >= cap { break }
            var row: []Val = []
            for k in 0..len(cols) { append(mut &row, if i < len(cols[k]) { cols[k][i] } else { Val.Null }) }
            if sel.ordin { append(mut &row, Val.Int(i + 1)) }
            bytes += rowBytes(&row)
            if room >= 0 && bytes > room { return Err(memErr(rs.maxHeld)) }
            append(mut &rows, row)
            try rs.tick()
        }
    }
    return Ok(Res{cols: [], rows: rows, tag: "", hasRows: true})
}

fn kindOf(v: &Val): int {
    match v {
        Val.Null { return 0 }
        Val.Int(_) { return lexdb_sql.K_INT }
        Val.Bool(_) { return lexdb_sql.K_BOOL }
        Val.Num(_) { return lexdb_sql.K_NUM }
        Val.Text(_) { return lexdb_sql.K_TEXT }
    }
}

fn asNum(v: &Val): Option[Decimal] {
    match v {
        Val.Int(n) { return Some(Decimal.fromInt(n)) }
        Val.Num(d) { return Some(d) }
        Val.Text(s) {
            match Decimal.parse(strings.trim(s)) {
                Ok(d) { return Some(d) }
                Err(_) { return None }
            }
        }
        else { return None }
    }
}

// Compares two values that are not NULL; a text compared with a number or a
// boolean is read as one (a parameter sent as text).
fn compare(a: &Val, b: &Val): Result[int, DbErr] {
    let ka = kindOf(a)
    let kb = kindOf(b)
    match a {
        Val.Int(x) {
            match b {
                Val.Int(y) { return Ok(x.cmp(&y)) }
                Val.Text(s) {
                    match strings.parseIntOpt(strings.trim(s)) {
                        Some(y) { return Ok(x.cmp(&y)) }
                        None {}
                    }
                }
                else {}
            }
        }
        Val.Text(x) {
            match b {
                Val.Text(y) { return Ok(x.cmp(&y)) }
                Val.Int(_) {
                    let r = try compare(b, a)
                    return Ok(-r)
                }
                Val.Bool(_) {
                    let r = try compare(b, a)
                    return Ok(-r)
                }
                Val.Num(_) {
                    let r = try compare(b, a)
                    return Ok(-r)
                }
                else {}
            }
        }
        Val.Bool(x) {
            let y = match b {
                Val.Bool(v) { Some(v) }
                Val.Text(s) { parseBool(&s) }
                else { None }
            }
            match y {
                Some(v) { return Ok(if x == v { 0 } else if !x { -1 } else { 1 }) }
                None {}
            }
        }
        else {}
    }
    if ka == lexdb_sql.K_NUM || kb == lexdb_sql.K_NUM {
        match asNum(a) {
            Some(x) {
                match asNum(b) {
                    Some(y) { return Ok(x.cmp(&y)) }
                    None {}
                }
            }
            None {}
        }
    }
    return Err(e("42883", "operator does not exist: " + text(a) + " compared with " + text(b)))
}

fn decErr(): DbErr { return e("22003", "numeric value out of range") }

fn arith(op: &str, a: &Val, b: &Val): Result[Val, DbErr] {
    if isNull(a) || isNull(b) { return Ok(Val.Null) }
    var x = 0
    var y = 0
    var ints = false
    match a {
        Val.Int(n) {
            match b {
                Val.Int(m) {
                    x = n
                    y = m
                    ints = true
                }
                Val.Text(s) {
                    match strings.parseIntOpt(strings.trim(s)) {
                        Some(m) {
                            x = n
                            y = m
                            ints = true
                        }
                        None {}
                    }
                }
                else {}
            }
        }
        Val.Text(s) {
            match b {
                Val.Int(m) {
                    match strings.parseIntOpt(strings.trim(s)) {
                        Some(n) {
                            x = n
                            y = m
                            ints = true
                        }
                        None {}
                    }
                }
                else {}
            }
        }
        else {}
    }
    if ints {
        var r: Option[int] = None
        match op {
            "+" { r = x.checkedAdd(y) }
            "-" { r = x.checkedSub(y) }
            "*" { r = x.checkedMul(y) }
            "/" {
                if y == 0 { return Err(e("22012", "division by zero")) }
                r = x.checkedDiv(y)
            }
            "%" {
                if y == 0 { return Err(e("22012", "division by zero")) }
                r = x.checkedRem(y)
            }
            else {}
        }
        match r {
            Some(v) { return Ok(Val.Int(v)) }
            None { return Err(e("22003", "bigint out of range")) }
        }
    }
    let da = asNum(a)
    let db = asNum(b)
    if da.isNone() || db.isNone() {
        return Err(e("42883", "operator does not exist: " + text(a) + " " + op + " " + text(b)))
    }
    let p = da.unwrap()
    let q = db.unwrap()
    var r: Result[Decimal, DecError] = Ok(Decimal.zero())
    match op {
        "+" { r = p.addExact(q) }
        "-" { r = p.subExact(q) }
        "*" { r = p.mulExact(q) }
        "/" {
            if q.isZero() { return Err(e("22012", "division by zero")) }
            var sc = 16
            if p.scale() > sc { sc = p.scale() }
            if q.scale() > sc { sc = q.scale() }
            r = p.div(q, sc, Rounding.HALF_EVEN)
        }
        "%" {
            if q.isZero() { return Err(e("22012", "division by zero")) }
            r = p.remExact(q)
        }
        else {}
    }
    match r {
        Ok(v) { return Ok(Val.Num(v)) }
        Err(_) { return Err(decErr()) }
    }
}

fn truth(v: &Val): Option[bool] {
    match v {
        Val.Bool(b) { return Some(b) }
        Val.Text(s) { return parseBool(&s) }
        else { return None }
    }
}

// An aggregate's name without its modifiers ("count distinct filter").
fn aggBase(name: &str): str {
    let i = strings.indexOf(name, " ", 0)
    return if i < 0 { name } else { name[0..i] }
}

const AGGS: []str = ["count", "sum", "avg", "min", "max", "string_agg", "bool_and", "bool_or", "every", "stddev",
                     "stddev_samp", "stddev_pop", "variance", "var_samp", "var_pop"]

fn isAgg(name: &str): bool {
    let b = aggBase(name)
    for a in AGGS { if a == b { return true } }
    return false
}

pub fn hasAgg(x: &Expr): bool {
    match x {
        Expr.Call(name, args, _) {
            if isAgg(&name) { return true }
            for a in args { if hasAgg(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return hasAgg(&a) }
        Expr.Bin(_, a, b) { return hasAgg(&a) || hasAgg(&b) }
        Expr.IsNull(a, _) { return hasAgg(&a) }
        Expr.Cast(a, _) { return hasAgg(&a) }
        else { return false }
    }
}

// What an expression is evaluated against: the columns, a row, the values
// of the query's aggregates for the row's group (an aggregate call is
// rewritten to its slot, "#agg"; none outside a grouped query) and the
// statement's parameters.
pub type Env = value record {
    cols: &[]lexdb_sql.ColDef
    row: &[]Val
    aggs: &[]Val
    params: &[]Val
    subs: &[]SubRes     // the results of the subqueries run once
    cur: &[]Val         // the correlated subqueries' values for this row
}

fn colIndex(cols: &[]lexdb_sql.ColDef, name: &str): int {
    for i in 0..len(cols) { if cols[i].name == name { return i } }
    return -1
}

pub fn eval(x: &Expr, env: &Env): Result[Val, DbErr] {
    match x {
        Expr.Lit(v) { return Ok(v) }
        Expr.Param(n) {
            if n > len(env.params) { return Err(e("08P01", "there is no parameter $" + n.toStr())) }
            return Ok(env.params[n - 1])
        }
        Expr.Col(name) {
            let i = colIndex(&env.cols, &name)
            if i < 0 { return Err(e("42703", "column \"" + name + "\" does not exist")) }
            if len(env.row) == 0 { return Ok(Val.Null) }
            return Ok(env.row[i])
        }
        Expr.Unary(op, a) {
            let v = try eval(&a, env)
            if op == "-" {
                match v {
                    Val.Null { return Ok(Val.Null) }
                    Val.Int(n) {
                        match (0).checkedSub(n) {
                            Some(m) { return Ok(Val.Int(m)) }
                            None { return Err(e("22003", "bigint out of range")) }
                        }
                    }
                    Val.Num(d) { return Ok(Val.Num(d.neg())) }
                    else { return arith(&"-", &Val.Int(0), &v) }
                }
            }
            if isNull(&v) { return Ok(Val.Null) }
            match truth(&v) {
                Some(b) { return Ok(Val.Bool(!b)) }
                None { return Err(e("42804", "argument of NOT must be type boolean")) }
            }
        }
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" {
                let l = truth(&(try eval(&a, env)))
                if op == "and" && l == Some(false) { return Ok(Val.Bool(false)) }
                if op == "or" && l == Some(true) { return Ok(Val.Bool(true)) }
                let r = truth(&(try eval(&b, env)))
                if op == "and" {
                    if r == Some(false) { return Ok(Val.Bool(false)) }
                    if l.isNone() || r.isNone() { return Ok(Val.Null) }
                    return Ok(Val.Bool(true))
                }
                if r == Some(true) { return Ok(Val.Bool(true)) }
                if l.isNone() || r.isNone() { return Ok(Val.Null) }
                return Ok(Val.Bool(false))
            }
            let l = try eval(&a, env)
            let r = try eval(&b, env)
            if op == "||" {
                if isNull(&l) || isNull(&r) { return Ok(Val.Null) }
                return Ok(Val.Text(text(&l) + text(&r)))
            }
            if op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                if isNull(&l) || isNull(&r) { return Ok(Val.Null) }
                let c = try compare(&l, &r)
                let t = match op {
                    "=" { c == 0 }
                    "<>" { c != 0 }
                    "<" { c < 0 }
                    "<=" { c <= 0 }
                    ">" { c > 0 }
                    else { c >= 0 }
                }
                return Ok(Val.Bool(t))
            }
            return arith(&op, &l, &r)
        }
        Expr.IsNull(a, neg) {
            let v = try eval(&a, env)
            return Ok(Val.Bool(isNull(&v) != neg))
        }
        Expr.Cast(a, t) {
            let v = try eval(&a, env)
            return coerce(v, &t)
        }
        Expr.Call(name, args, star) {
            if isSubCall(&name) {
                let i = litInt(&args[0])
                if len(args) > subFixed(&name) {
                    if i < len(env.cur) { return Ok(env.cur[i]) }
                    return Err(e("0A000", "a correlated subquery is not supported here"))
                }
                if len(args) < subFixed(&name) || i >= len(env.subs) { return Err(e("0A000", "a subquery is not supported here")) }
                let xv = if name == "#in" { try eval(&args[3], env) } else { Val.Null }
                return Ok(subValue(&name, &env.subs[i], &xv))
            }
            if name == "#agg" {
                match args[0] {
                    Expr.Lit(v) {
                        match v {
                            Val.Int(i) { return Ok(env.aggs[i]) }
                            else {}
                        }
                    }
                    else {}
                }
            }
            if isAgg(&name) { return Err(e("42803", "aggregate functions are not allowed here")) }
            if name == "case" || name == "case else" {
                // only the branch taken is evaluated
                let pairs = if name == "case else" { (len(args) - 1) / 2 } else { len(args) / 2 }
                for k in 0..pairs { if truth(&(try eval(&args[2 * k], env))) == Some(true) { return eval(&args[2 * k + 1], env) } }
                if name == "case else" { return eval(&args[len(args) - 1], env) }
                return Ok(Val.Null)
            }
            var vs: []Val = []
            for a in args { append(mut &vs, try eval(&a, env)) }
            return call(&name, &vs)
        }
    }
}

fn intArg(v: Val, fname: &str): Result[int, DbErr] {
    match v {
        Val.Int(n) { return Ok(n) }
        else {
            match try coerce(v, &lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}) {
                Val.Int(n) { return Ok(n) }
                else { return Err(e("42883", "function " + fname + " needs an integer")) }
            }
        }
    }
}

// LIKE: % any run of characters, _ one character, the escape character
// (backslash unless given; '' for none) before either for itself.
fn likeMatch(s: str, pat: str, esc: str, fold: bool): Result[bool, DbErr] {
    let sr = strings.runes(if fold { strings.toLowerAscii(s) } else { s })
    let pr = strings.runes(if fold { strings.toLowerAscii(pat) } else { pat })
    let er = strings.runes(esc)
    if len(er) > 1 { return Err(e("22019", "invalid escape string")) }
    let ec = if len(er) == 1 { er[0] } else { -1 }
    var kind: []int = []            // 0 a character, 1 _, 2 %
    var lit: []int = []
    var i = 0
    while i < len(pr) {
        let c = pr[i]
        if c == ec {
            if i + 1 >= len(pr) { return Err(e("22025", "LIKE pattern must not end with escape character")) }
            append(mut &kind, 0)
            append(mut &lit, pr[i + 1])
            i += 2
            continue
        }
        if c == 37 {
            if len(kind) == 0 || kind[len(kind) - 1] != 2 {
                append(mut &kind, 2)
                append(mut &lit, 0)
            }
        } else if c == 95 {
            append(mut &kind, 1)
            append(mut &lit, 0)
        } else {
            append(mut &kind, 0)
            append(mut &lit, c)
        }
        i += 1
    }
    var si = 0
    var pi = 0
    var star = -1
    var mark = 0
    while si < len(sr) {
        if pi < len(kind) && (kind[pi] == 1 || (kind[pi] == 0 && lit[pi] == sr[si])) {
            si += 1
            pi += 1
        } else if pi < len(kind) && kind[pi] == 2 {
            star = pi
            mark = si
            pi += 1
        } else if star >= 0 {
            pi = star + 1
            mark += 1
            si = mark
        } else {
            return Ok(false)
        }
    }
    while pi < len(kind) && kind[pi] == 2 { pi += 1 }
    return Ok(pi == len(kind))
}

// substr(s, from [, count]), by characters, from 1, as PostgreSQL clips it.
fn substr(s: str, from: int, count: int, hasCount: bool): Result[str, DbErr] {
    let rs = strings.runes(s)
    if hasCount && count < 0 { return Err(e("22011", "negative substring length not allowed")) }
    var lo = from
    var hi = if hasCount { from + count } else { len(rs) + 1 }
    if lo < 1 { lo = 1 }
    if hi > len(rs) + 1 { hi = len(rs) + 1 }
    if hi <= lo { return Ok("") }
    var out: []int = []
    for i in lo - 1..hi - 1 { append(mut &out, rs[i]) }
    return Ok(strings.fromRunes(&out))
}

fn call(name: &str, vs: &[]Val): Result[Val, DbErr] {
    if name == "array" { return Ok(Val.Text(arrayText(vs))) }
    let n = len(vs)
    if name == "in" {
        // x IN (a, b): true if one equals x; else NULL if x or one of them is NULL
        if isNull(&vs[0]) { return Ok(Val.Null) }
        var sawNull = false
        for i in 1..n {
            if isNull(&vs[i]) {
                sawNull = true
                continue
            }
            if (try compare(&vs[0], &vs[i])) == 0 { return Ok(Val.Bool(true)) }
        }
        return Ok(if sawNull { Val.Null } else { Val.Bool(false) })
    }
    if name == "distinct from" {
        let na = isNull(&vs[0])
        let nb = isNull(&vs[1])
        if na || nb { return Ok(Val.Bool(na != nb)) }
        return Ok(Val.Bool((try compare(&vs[0], &vs[1])) != 0))
    }
    if name == "like" || name == "ilike" {
        for v in vs { if isNull(&v) { return Ok(Val.Null) } }
        let esc = if n > 2 { text(&vs[2]) } else { "\\" }
        return Ok(Val.Bool(try likeMatch(text(&vs[0]), text(&vs[1]), esc, name == "ilike")))
    }
    if name == "nullif" && n == 2 {
        if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(vs[0]) }
        if (try compare(&vs[0], &vs[1])) == 0 { return Ok(Val.Null) }
        return Ok(vs[0])
    }
    if (name == "greatest" || name == "least") && n >= 1 {
        var best = Val.Null
        for v in vs {
            if isNull(&v) { continue }
            if isNull(&best) { best = v } else {
                let c = try compare(&v, &best)
                if (name == "greatest" && c > 0) || (name == "least" && c < 0) { best = v }
            }
        }
        return Ok(best)
    }
    if name == "concat" {
        var out = ""
        for v in vs { if !isNull(&v) { out = out + text(&v) } }
        return Ok(Val.Text(out))
    }
    let strFn = name == "substr" || name == "substring" || name == "strpos" || name == "replace" || name == "left" ||
                name == "right"
    if n >= 2 && strFn {
        for v in vs { if isNull(&v) { return Ok(Val.Null) } }
        let a = text(&vs[0])
        if (name == "substr" || name == "substring") && n <= 3 {
            let from = try intArg(vs[1], name)
            let count = if n == 3 { try intArg(vs[2], name) } else { 0 }
            return Ok(Val.Text(try substr(a, from, count, n == 3)))
        }
        if name == "strpos" && n == 2 {
            let i = strings.indexOf(a, text(&vs[1]), 0)
            return Ok(Val.Int(if i < 0 { 0 } else { strings.runeCount(&a[0..i]) + 1 }))
        }
        if name == "replace" && n == 3 {
            let from = text(&vs[1])
            if len(from) == 0 { return Ok(Val.Text(a)) }
            return Ok(Val.Text(strings.replaceAll(a, from, text(&vs[2]))))
        }
        if (name == "left" || name == "right") && n == 2 {
            let k = try intArg(vs[1], name)
            let total = strings.runeCount(&a)
            var take = if k >= 0 { k } else { total + k }
            if take < 0 { take = 0 }
            if take > total { take = total }
            if name == "left" { return Ok(Val.Text(try substr(a, 1, take, true))) }
            return Ok(Val.Text(try substr(a, total - take + 1, take, true)))
        }
    }
    if name == "coalesce" {
        for v in vs { if !isNull(&v) { return Ok(v) } }
        return Ok(Val.Null)
    }
    if name == "version" && n == 0 { return Ok(Val.Text("PostgreSQL 16.0 (lexdb 0.1)")) }
    if name == "current_database" && n == 0 { return Ok(Val.Text("lexdb")) }
    if n == 1 {
        let v = vs[0]
        if isNull(&v) { return Ok(Val.Null) }
        match name {
            "lower" { return Ok(Val.Text(strings.toLowerAscii(text(&v)))) }
            "trim", "btrim" { return Ok(Val.Text(strings.trim(text(&v)))) }
            "ltrim" { return Ok(Val.Text(strings.trimLeft(text(&v)))) }
            "rtrim" { return Ok(Val.Text(strings.trimRight(text(&v)))) }
            "upper" { return Ok(Val.Text(strings.toUpperAscii(text(&v)))) }
            "length", "char_length" { return Ok(Val.Int(strings.runeCount(&text(&v)))) }
            "abs" {
                match v {
                    Val.Int(x) { return Ok(Val.Int(if x < 0 { try arithInt(0, x) } else { x })) }
                    Val.Num(d) { return Ok(Val.Num(d.abs())) }
                    else {}
                }
            }
            "round" {
                match asNum(&v) {
                    Some(d) {
                        match d.roundAway(0) {
                            Ok(r) { return Ok(Val.Num(r)) }
                            Err(_) { return Err(decErr()) }
                        }
                    }
                    None {}
                }
            }
            else {}
        }
    }
    if n == 2 && name == "round" {
        match asNum(&vs[0]) {
            Some(d) {
                match vs[1] {
                    Val.Int(s) {
                        match d.roundAway(s) {
                            Ok(r) { return Ok(Val.Num(r)) }
                            Err(_) { return Err(decErr()) }
                        }
                    }
                    else {}
                }
            }
            None {}
        }
    }
    return Err(e("42883", "function " + name + " with " + n.toStr() + " arguments does not exist"))
}

fn arithInt(a: int, b: int): Result[int, DbErr] {
    match a.checkedSub(b) {
        Some(v) { return Ok(v) }
        None { return Err(e("22003", "bigint out of range")) }
    }
}

// ---- keys and rows

fn encKeyPart(b: mut &StrBuf, v: &Val) {
    match v {
        Val.Int(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Bool(x) { b.addByte(if x { 1 } else { 0 }) }
        Val.Num(d) { encNum(b, &d) }
        Val.Text(s) {
            for i in 0..len(s) {
                b.addByte(s[i])
                if s[i] == 0 { b.addByte(0xFF) }
            }
            b.addByte(0)
            b.addByte(0)
        }
        else {}
    }
}

// A numeric in key order: 0x80 zero; 0x81, the exponent of its leading
// digit, its digits, 00 positive; 0x7F and all of that complemented
// negative. Decimal is canonical (no trailing zero digits), so equal values
// have equal keys whatever their scale.
fn encNum(b: mut &StrBuf, d: &Decimal) {
    if d.isZero() {
        b.addByte(0x80)
        return
    }
    // trailing zeros dropped: equal values (1.5, 1.50) have one key
    var digs = d.coefficient().toStr()
    var nd = len(digs)
    while nd > 1 && digs[nd - 1] == '0' { nd -= 1 }
    let ex = len(digs) + d.exponent() + 0x40000000
    digs = digs[0..nd]
    if d.isNeg() {
        b.addByte(0x7F)
        binary.addU32BE(b, 0x7FFFFFFF - ex)
        for i in 0..len(digs) { b.addByte(0xFF - digs[i]) }
        b.addByte(0xFF)
    } else {
        b.addByte(0x81)
        binary.addU32BE(b, ex)
        for i in 0..len(digs) { b.addByte(digs[i]) }
        b.addByte(0)
    }
}

// An index's key part: a marker first so that NULL has a place, last as
// PostgreSQL sorts it: 1 a value, 2 NULL.
fn encIdxPart(b: mut &StrBuf, v: &Val) {
    if isNull(v) {
        b.addByte(2)
        return
    }
    b.addByte(1)
    encKeyPart(b, v)
}

// The key of a row: its primary key's values, in byte order = SQL order.
fn keyOf(t: &Table, row: &[]Val): str {
    var b = newStrBuf()
    for i in t.pk { encKeyPart(mut &b, &row[i]) }
    return b.toStr()
}

// The smallest string after every string that starts with s ("" when there
// is none: the end of the tree).
fn succ(s: &str): str {
    var bs = strToBytes(s)
    while len(bs) > 0 && bs[len(bs) - 1] == 0xFF { let x = pop(mut &bs) }
    if len(bs) == 0 { return "" }
    bs[len(bs) - 1] = bs[len(bs) - 1] + 1
    return strFromBytes(&bs)
}

fn encRow(row: &[]Val): str {
    var b = newStrBuf()
    for v in row {
        match v {
            Val.Null { b.addByte(0) }
            Val.Int(n) {
                b.addByte(1)
                binary.addU64LE(mut &b, n)
            }
            Val.Bool(x) {
                b.addByte(2)
                b.addByte(if x { 1 } else { 0 })
            }
            Val.Num(d) {
                b.addByte(3)
                let s = d.toStr()
                binary.addU32LE(mut &b, len(s))
                b.add(s)
            }
            Val.Text(s) {
                b.addByte(4)
                binary.addU32LE(mut &b, len(s))
                b.add(s)
            }
        }
    }
    return b.toStr()
}

fn decRow(s: &str, n: int): Result[[]Val, DbErr] {
    var out: []Val = []
    var at = 0
    for i in 0..n {
        if at >= len(s) {
            append(mut &out, Val.Null)       // a column added after the row was written
            continue
        }
        let tag = s[at]
        at += 1
        if tag == 0 {
            append(mut &out, Val.Null)
        } else if tag == 1 {
            append(mut &out, Val.Int(binary.readI64LEStr(s, at)))
            at += 8
        } else if tag == 2 {
            append(mut &out, Val.Bool(s[at] == 1))
            at += 1
        } else if tag == 3 || tag == 4 {
            let l = binary.readU32LEStr(s, at)
            let t = s[at + 4..at + 4 + l]
            at += 4 + l
            if tag == 4 {
                append(mut &out, Val.Text(t))
            } else {
                match Decimal.parse(t) {
                    Ok(d) { append(mut &out, Val.Num(d)) }
                    Err(_) { return Err(lexdb_base.corrupt("a numeric value in a row")) }
                }
            }
        } else {
            return Err(lexdb_base.corrupt("a row's value tag"))
        }
    }
    return Ok(out)
}

// ---- the catalog

fn encTable(t: &Table): str {
    var b = newStrBuf()
    binary.addU32LE(mut &b, t.tree)
    binary.addU32LE(mut &b, len(t.cols))
    for c in t.cols {
        binary.addU32LE(mut &b, len(c.name))
        b.add(c.name)
        binary.addU32LE(mut &b, c.typ.kind)
        binary.addU32LE(mut &b, c.typ.oid)
        binary.addU32LE(mut &b, c.typ.prec)
        binary.addU32LE(mut &b, c.typ.scale)
        binary.addU32LE(mut &b, c.typ.len)
        b.addByte(if c.notNull { 1 } else { 0 })
    }
    binary.addU32LE(mut &b, len(t.pk))
    for i in t.pk { binary.addU32LE(mut &b, i) }
    binary.addU32LE(mut &b, len(t.indexes))
    for ix in t.indexes {
        binary.addU32LE(mut &b, len(ix.name))
        b.add(ix.name)
        binary.addU32LE(mut &b, ix.tree)
        let filtered = ix.pred.isSome()
        b.addByte((if ix.unique { 1 } else { 0 }) + (if filtered { 2 } else { 0 }))
        binary.addU32LE(mut &b, len(ix.cols))
        for c in ix.cols { binary.addU32LE(mut &b, c) }
        match ix.pred {
            Some(x) {
                let text = lexdb_sql.exprText(&x)
                binary.addU32LE(mut &b, len(text))
                b.add(text)
            }
            None {}
        }
    }
    return b.toStr()
}

fn decTable(name: str, s: &str): Result[Table, DbErr] {
    var t = Table{name: name, tree: binary.readU32LEStr(s, 0), cols: [], pk: [], indexes: []}
    let n = binary.readU32LEStr(s, 4)
    var at = 8
    for i in 0..n {
        let l = binary.readU32LEStr(s, at)
        let cn = s[at + 4..at + 4 + l]
        at += 4 + l
        let ty = lexdb_sql.TypeName{kind: binary.readU32LEStr(s, at), oid: binary.readU32LEStr(s, at + 4),
                                    prec: binary.readU32LEStr(s, at + 8), scale: binary.readU32LEStr(s, at + 12),
                                    len: binary.readU32LEStr(s, at + 16)}
        at += 20
        append(mut &t.cols, lexdb_sql.ColDef{name: cn, typ: ty, notNull: s[at] == 1})
        at += 1
    }
    let k = binary.readU32LEStr(s, at)
    at += 4
    for i in 0..k {
        append(mut &t.pk, binary.readU32LEStr(s, at))
        at += 4
    }
    if at >= len(s) { return Ok(t) }
    let ni = binary.readU32LEStr(s, at)
    at += 4
    for i in 0..ni {
        let l = binary.readU32LEStr(s, at)
        var ix = Index{name: s[at + 4..at + 4 + l], tree: 0, cols: [], unique: false, pred: None}
        at += 4 + l
        ix.tree = binary.readU32LEStr(s, at)
        let flags = s[at + 4]
        ix.unique = flags == 1 || flags == 3
        let nc = binary.readU32LEStr(s, at + 5)
        at += 9
        for j in 0..nc {
            append(mut &ix.cols, binary.readU32LEStr(s, at))
            at += 4
        }
        if flags >= 2 {
            let pl = binary.readU32LEStr(s, at)
            match lexdb_sql.parseExpr(&s[at + 4..at + 4 + pl]) {
                Ok(x) { ix.pred = Some(x) }
                Err(_) { return Err(lexdb_base.corrupt("the predicate of index \"" + ix.name + "\"")) }
            }
            at += 4 + pl
        }
        append(mut &t.indexes, ix)
    }
    return Ok(t)
}

// The catalog's version: a row every DDL statement bumps, read through the
// transaction, so it names the schema the transaction sees (a snapshot may
// predate the latest DDL). Its key sorts before every name (index names
// start with 1, table names with a letter).
const CAT_VERSION: str = "\x02version"

fn catVersion(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[str, DbErr] {
    match try st.get(txn, CATALOG, CAT_VERSION) {
        Some(v) { return Ok(v) }
        None { return Ok("0") }
    }
}

fn bumpCatalog(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[Unit, DbErr] {
    let v = strings.parseIntOpt(try catVersion(st, txn)).unwrapOr(0)
    try txn.put(CATALOG, CAT_VERSION, (v + 1).toStr())
    return Ok(Unit{})
}

// ---- schemas (9.20): a table's catalog key is its name qualified by its
// schema (lexdb_sql.qual: schema QSEP name), public's unqualified. A schema
// is a catalog row of its own (schemaKey). An unqualified name is looked up
// along the transaction's search path (Txn.path, [] for public alone).

fn schemaKey(n: &str): str { return "\x03" + n }

fn schemaExists(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[bool, DbErr] {
    if n == "public" { return Ok(true) }
    return Ok((try st.get(txn, CATALOG, schemaKey(n))).isSome())
}

// The schema new unqualified names go in: the first on the path that
// exists ("" none).
fn createSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[str, DbErr] {
    if len(txn.path) == 0 { return Ok("public") }
    for i in 0..len(txn.path) {
        let sc = txn.path[i]
        if try schemaExists(st, txn, &sc) { return Ok(sc) }
    }
    return Ok("")
}

// The catalog key of a table (idx false) or an index named n: n if it is
// qualified or the path is public's; else the first schema on the path
// holding it, or none: the schema new names would go in (it is not there).
fn catKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str, idx: bool): Result[str, DbErr] {
    if len(txn.path) == 0 || lexdb_sql.isQual(n) { return Ok(n) }
    for i in 0..len(txn.path) {
        let sc = txn.path[i]
        let k = lexdb_sql.qual(&sc, n)
        let found = try st.get(txn, CATALOG, if idx { idxName(&k) } else { k })
        if found.isSome() { return Ok(k) }
    }
    let sc = try createSchema(st, txn)
    let first = txn.path[0]
    return Ok(lexdb_sql.qual(if len(sc) > 0 { &sc } else { &first }, n))
}

fn findTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str): Result[Option[Table], DbErr] {
    let k = try catKey(st, txn, name, false)
    match try st.get(txn, CATALOG, k) {
        Some(s) { return Ok(Some(try decTable(&k, &s))) }
        None { return Ok(None) }
    }
}

fn needTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str): Result[Table, DbErr] {
    match try findTable(st, txn, name) {
        Some(t) { return Ok(t) }
        None { return Err(e("42P01", "relation \"" + lexdb_sql.shown(name) + "\" does not exist")) }
    }
}

// Makes the catalog when the store is new.
pub fn bootstrap(st: &lexdb_store.Store): Result[Unit, DbErr] {
    st.watch(CATALOG)
    for id in st.trees() { if id == CATALOG { return Ok(Unit{}) } }
    var t = lexdb_store.begin()
    let id = st.createTree(mut &t)
    if id != CATALOG { return Err(lexdb_base.corrupt("the store has trees but no catalog")) }
    return st.commit(t)
}

// ---- planning: access paths and joins

fn conjuncts(x: &Expr, out: mut &[]Expr) {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" {
                conjuncts(&a, out)
                conjuncts(&b, out)
                return
            }
        }
        else {}
    }
    append(out, clone(x))
}
fn cloneAll(xs: &[]Expr): []Expr {
    var out: []Expr = []
    for x in xs { append(mut &out, clone(&x)) }
    return out
}
// A copy of an expression (Expr is boxed and owned).
pub fn clone(x: &Expr): Expr {
    match x {
        Expr.Lit(v) { return Expr.Lit(v) }
        Expr.Param(n) { return Expr.Param(n) }
        Expr.Col(n) { return Expr.Col(n) }
        Expr.Unary(op, a) { return Expr.Unary(op, clone(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, clone(&a), clone(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(clone(&a), neg) }
        Expr.Call(n, args, star) { return Expr.Call(n, cloneAll(&args), star) }
        Expr.Cast(a, t) { return Expr.Cast(clone(&a), t) }
    }
}


// A conjunct "col op value" (or "value op col", turned round).
type Bound = record { op: str; val: Expr }

// A table's way in: its primary key (index -1) or one of its indexes, with
// an equality for each of the first len(eqs) key columns, then perhaps
// bounds on the next one. No equality and no bound is a full scan.
type Path = record {
    index: int
    eqs: []Expr
    rng: []Bound
    desc: bool          // read backward (ORDER BY ... DESC, MAX)
    noNulls: bool       // an index path: leave out its next column's NULLs (MIN, MAX)
    ins: []Expr         // x IN (...) on the column after the equalities: a lookup per value
    inSub: int          // or x IN (subquery), uncorrelated: a lookup per value it gives; -1 none
}

// An IN subquery's values looked up one by one at most; past this many its
// path reads the whole table instead (no row counts to choose by yet).
const IN_LOOKUP_MAX: int = 1000

type Scan = record {
    empty: bool         // a bound is NULL: no row can match
    point: bool         // one primary key (lo)
    lo: str             // the keys [lo, hi) of the primary key or the index; hi "" for the end
    hi: str
    whole: bool         // the whole table, in primary key order, whatever the path's index
}

// One table of a query, in FROM order. Its rows join the rows of the tables
// before it: looked up per row through its path when the path's values come
// from them (a nested loop over a key or an index), else read once and
// matched by a hash of the equalities that link it to them (none: every
// row, a cross product).
pub type Level = record {
    t: Table
    alias: str
    join: int
    first: int              // its first column in the joined row
    path: Path
    cond: []Expr            // the conjuncts a row of it must satisfy to join
    post: []Expr            // a LEFT JOIN's WHERE conjuncts, checked after its NULL row is made
    local: []Expr           // the match conjuncts on its own columns only (hash: read once)
    perRow: bool
    hashCols: []int         // hash: its columns ...
    hashVals: []Expr        // ... equal to these values from earlier tables
    src: int                // a subquery in FROM (or a CTE): its number, its rows read from the run; -1 a table
    work: int               // a recursive CTE's working table: the CTE's number; -1
    lateral: bool           // a subquery in FROM using outer values (LATERAL): run per row
}

// A level of rows held by the run (a subquery's, a working table), not a table's.
fn (lv: &Level) virt(): bool { return lv.src >= 0 || lv.work >= 0 }

// What one table of a query did (EXPLAIN ANALYZE).
type Counts = value record {
    starts: int         // scans or lookups begun (per row: one per row of the tables before); hash: probes
    read: int           // candidate rows tried
    joined: int         // rows that met the join's conditions
    nulls: int          // LEFT JOIN rows made with NULLs
    built: int          // hash: rows read to build it, and kept
    kept: int
    unmatched: int      // RIGHT and FULL JOIN: its rows that joined nothing
}

// A query's run: the counts, and per RIGHT or FULL JOIN table which of its
// rows have joined.
type Run = record {
    cnt: []Counts
    seen: [][]bool
    memo: []Map[str, int]       // per subquery (correlated): its outer values -> its result in memoRes
    memoRes: [][]SubRes
    stats: []SubStat            // per subquery (or part of a UNION): its runs (EXPLAIN ANALYZE)
    cache: CteCache
    maxRounds: int              // a recursive CTE's rounds at most (the session's max_recursion); 0 no limit
    held: int                   // about the bytes of rows the statement holds (its runs inside: their own and this)
    maxHeld: int                // max_statement_mem; 0 no limit
    deadline: int               // statement_timeout: the monotonic clock's ns to stop at; 0 none
    ticks: int
    turnEnd: int                // the monotonic clock's ns after which the statement lets other sessions run
}

// A statement that does not wait (its pages in the cache) lets the other
// sessions run after this much time: lexdb runs SQL on one thread
// (design/lexdb.md 9.15).
pub const TURN_NS = 100000

// A session's limits on one statement (SET max_recursion,
// max_statement_mem, statement_timeout).
pub type Limits = value record {
    pub rounds: int             // a recursive CTE's rounds; 0 no limit
    pub mem: int                // bytes of rows held; 0 no limit
    pub deadline: int           // time.monotonicNs() to stop at; 0 none
}

pub fn noLimits(): Limits { return Limits{rounds: 0, mem: 0, deadline: 0} }

fn (rs: mut &Run) limit(l: &Limits) {
    rs.maxRounds = l.rounds
    rs.maxHeld = l.mem
    rs.deadline = l.deadline
}

// Rows of about n bytes now held until the statement ends (or its run
// inside another does).
fn (rs: mut &Run) hold(n: int): Result[Unit, DbErr] {
    rs.held += n
    if rs.maxHeld > 0 && rs.held > rs.maxHeld { return Err(memErr(rs.maxHeld)) }
    return Ok(Unit{})
}

// The bytes a run may still hold (-1: no limit), for code that cannot reach
// the run (a row callback): it counts and checks itself, then holds.
fn (rs: &Run) room(): int { return if rs.maxHeld > 0 { rs.maxHeld - rs.held } else { -1 } }

fn memErr(max: int): DbErr {
    return e("53200", "statement holds more than max_statement_mem (" + (max / 1024).toStr() +
             " kB) of rows; SET max_statement_mem to allow more, 0 for no limit")
}

// Per row looked at: every 256th, the clock. Past statement_timeout: an
// error. After a turn of TURN_NS: the other sessions run, then this again.
fn (rs: mut &Run) tick(): Result[Unit, DbErr] {
    rs.ticks += 1
    if rs.ticks % 256 != 0 { return Ok(Unit{}) }
    let now = time.monotonicNs()
    if rs.deadline != 0 && now > rs.deadline { return Err(e("57014", "canceling statement due to statement timeout")) }
    if rs.turnEnd == 0 {
        rs.turnEnd = now + TURN_NS
    } else if now > rs.turnEnd {
        // a yield looks at the sockets: a session whose query has arrived runs
        match task.yield() {
            Ok(_) {}
            Err(_) { return Err(e("57014", "canceling statement: its session has ended")) }
        }
        rs.turnEnd = time.monotonicNs() + TURN_NS
    }
    return Ok(Unit{})
}

// About the memory a row takes: its array, and per value its tag and
// payload (text and numbers their bytes).
fn rowBytes(r: &[]Val): int {
    var n = 32
    for v in r {
        n += 24
        match v {
            Val.Text(t) { n += len(t) }
            Val.Num(_) { n += 32 }
            else {}
        }
    }
    return n
}

fn rowsBytes(rows: &[][]Val): int {
    var n = 24
    for r in rows { n += rowBytes(&r) }
    return n
}

// A subquery's kept result: its rows, its set's and groups' keys.
fn resBytes(r: &SubRes): int {
    var n = 96 + rowsBytes(&r.data)
    for i in 0..r.set.size() { n += 48 + len(r.set.keyAt(i)) }
    for i in 0..r.groups.size() { n += 48 + len(r.groups.keyAt(i)) }
    return n
}

// max_recursion's default: rounds of a recursive CTE.
pub const MAX_RECURSION = 1000

// What a subquery did: runs, results taken from the cache, and its own
// counts and subqueries' over all its runs.
type SubStat = record { runs: int; hits: int; cnt: []Counts; inner: []SubStat }

fn newRun(q: &Query): Run {
    var seen: [][]bool = []
    for k in 0..len(q.levels) { append(mut &seen, []) }
    var memo: []Map[str, int] = []
    var memoRes: [][]SubRes = []
    var stats: []SubStat = []
    for i in 0..len(q.subs) {
        append(mut &memo, newMap())
        append(mut &memoRes, [])
        append(mut &stats, SubStat{runs: 0, hits: 0, cnt: [], inner: []})
    }
    return Run{cnt: array(len(q.levels), Counts{starts: 0, read: 0, joined: 0, nulls: 0, built: 0, kept: 0, unmatched: 0}),
               seen: seen, memo: memo, memoRes: memoRes, stats: stats, cache: newCache(), maxRounds: MAX_RECURSION,
               held: 0, maxHeld: 0, deadline: 0, ticks: 0, turnEnd: 0}
}

fn keepsRight(join: int): bool { return join == lexdb_sql.J_RIGHT || join == lexdb_sql.J_FULL }

fn keepsLeft(join: int): bool { return join == lexdb_sql.J_LEFT || join == lexdb_sql.J_FULL }

fn isOuter(join: int): bool { return keepsLeft(join) || keepsRight(join) }

pub type Query = record {
    levels: []Level
    cols: []lexdb_sql.ColDef    // the joined row's columns, named alias.column
    top: []Expr                 // no FROM: the WHERE
    subs: []SubPlan             // its subqueries, by number
    base: int                   // the statement's parameters; then refs' values
    corr: bool                  // a subquery of it is correlated
    refs: []Expr                // a subquery: the outer values it uses (in the outer query's terms)
}

fn dotAt(s: &str): int {
    for i in 0..len(s) { if s[i] == '.' { return i } }
    return -1
}

// The column part of alias.column (a repeated name's mark taken off).
fn colPart(q: &str): str {
    let i = dotAt(q)
    let c = if i < 0 { q } else { q[i + 1..len(q)] }
    let d = strings.indexOf(c, DUPSEP, 0)
    return if d < 0 { c } else { c[0..d] }
}

// Marks a column name repeated in one FROM item: name DUPSEP position.
const DUPSEP: str = "\x1e"

// The column a name refers to among the first n columns: alias.column, or a
// column name only one table has.
fn resolveName(cols: &[]lexdb_sql.ColDef, n: int, name: &str): Result[str, DbErr] {
    let d = dotAt(name)
    if d >= 0 {
        for i in 0..n {
            if cols[i].name == name {
                let again = name + DUPSEP
                for j in 0..n { if strings.startsWith(cols[j].name, again) { return Err(e("42702", "column reference \"" + name + "\" is ambiguous")) } }
                return Ok(name)
            }
        }
        let alias = name[0..d]
        var known = false
        for i in 0..n {
            let cd = dotAt(&cols[i].name)
            if cols[i].name[0..cd] == alias { known = true }
        }
        if !known { return Err(e("42P01", "missing FROM-clause entry for table \"" + alias + "\"")) }
        return Err(e("42703", "column " + name + " does not exist"))
    }
    var found = -1
    for i in 0..n {
        if colPart(&cols[i].name) == name {
            if found >= 0 { return Err(e("42702", "column reference \"" + name + "\" is ambiguous")) }
            found = i
        }
    }
    if found < 0 { return Err(e("42703", "column \"" + name + "\" does not exist")) }
    return Ok(cols[found].name)
}

// An expression with its column names made alias.column.
// A name not among a query's columns may be one of a query around it
// (a correlated subquery): then it is a parameter.
fn resolve(x: &Expr, cols: &[]lexdb_sql.ColDef, n: int, sc: mut &Scope): Result[Expr, DbErr] {
    match x {
        Expr.Col(name) {
            match resolveName(cols, n, &name) {
                Ok(r) { return Ok(Expr.Col(r)) }
                Err(err) {
                    var mine = false
                    match resolveName(cols, len(cols), &name) {
                        Ok(_) { mine = true }
                        Err(x2) { mine = x2.state == "42702" }
                    }
                    if !mine && len(sc.frames) > 1 {
                        match try outerRef(sc, &name) {
                            Some(r) { return Ok(r) }
                            None {}
                        }
                    }
                    return Err(err)
                }
            }
        }
        Expr.Unary(op, a) { return Ok(Expr.Unary(op, try resolve(&a, cols, n, sc))) }
        Expr.Bin(op, a, b) {
            let l = try resolve(&a, cols, n, sc)
            let r = try resolve(&b, cols, n, sc)
            return Ok(Expr.Bin(op, l, r))
        }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try resolve(&a, cols, n, sc), neg)) }
        Expr.Cast(a, t) { return Ok(Expr.Cast(try resolve(&a, cols, n, sc), t)) }
        Expr.Call(nm, args, star) {
            var out: []Expr = []
            if isSubCall(&nm) && len(args) < subFixed(&nm) {
                // a subquery: its number, type and name, (IN: the value), then the outer values it needs
                let i = litInt(&args[0])
                var xs: []Expr = []
                if nm == "#in" { append(mut &xs, try resolve(&args[1], cols, n, sc)) }
                let f = &sc.frames[len(sc.frames) - 1]
                append(mut &out, Expr.Lit(Val.Int(i)))
                append(mut &out, Expr.Lit(Val.Int(f.subOids[i])))
                append(mut &out, Expr.Lit(Val.Text(f.subNames[i])))
                if len(xs) > 0 { append(mut &out, pop(mut &xs)) }
                for r in f.subRefs[i] { append(mut &out, clone(&r)) }
                return Ok(Expr.Call(nm, out, star))
            }
            for a in args { append(mut &out, try resolve(&a, cols, n, sc)) }
            return Ok(Expr.Call(nm, out, star))
        }
        else { return Ok(clone(x)) }
    }
}

fn colNames(x: &Expr, out: mut &[]str) {
    match x {
        Expr.Col(n) { append(out, n) }
        Expr.Unary(_, a) { colNames(&a, out) }
        Expr.Bin(_, a, b) {
            colNames(&a, out)
            colNames(&b, out)
        }
        Expr.IsNull(a, _) { colNames(&a, out) }
        Expr.Cast(a, _) { colNames(&a, out) }
        Expr.Call(_, args, _) { for a in args { colNames(&a, out) } }
        else {}
    }
}

fn (q: &Query) valBefore(x: &Expr, k: int): bool { return q.maxLevel(x) < k && !(q.corr && hasCorr(x)) }

// A path's key value for level k: it uses only the tables before k. A
// correlated subquery in it is run per row of them before k is read
// (runLevel: pathCur), so it may be one too (9.23).
fn (q: &Query) keyBefore(x: &Expr, k: int): bool { return q.maxLevel(x) < k }

fn (q: &Query) levelOf(name: &str): int {
    let i = colIndex(&q.cols, name)
    var k = -1
    for j in 0..len(q.levels) { if q.levels[j].first <= i { k = j } }
    return k
}

// The latest table an expression uses (-1: none) and the earliest (len: none).
fn (q: &Query) maxLevel(x: &Expr): int {
    var ns: []str = []
    colNames(x, mut &ns)
    var m = -1
    for n in ns {
        let l = q.levelOf(&n)
        if l > m { m = l }
    }
    return m
}

fn (q: &Query) minLevel(x: &Expr): int {
    var ns: []str = []
    colNames(x, mut &ns)
    var m = len(q.levels)
    for n in ns {
        let l = q.levelOf(&n)
        if l < m { m = l }
    }
    return m
}

// The conjuncts "col op value" whose value uses only tables before level k.
fn bounds(cs: &[]Expr, col: &str, k: int, q: &Query): []Bound {
    var out: []Bound = []
    for c in cs { likeBounds(&c, col, q, mut &out) }
    for c in cs {
        match c {
            Expr.Bin(op, a, b) {
                if op == "=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                    var done = false
                    match a {
                        Expr.Col(n) {
                            if n == col && q.keyBefore(&b, k) {
                                append(mut &out, Bound{op: op, val: clone(&b)})
                                done = true
                            }
                        }
                        else {}
                    }
                    if !done {
                        match b {
                            Expr.Col(n) {
                                if n == col && q.keyBefore(&a, k) {
                                    let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { "=" } }
                                    append(mut &out, Bound{op: flip, val: clone(&a)})
                                }
                            }
                            else {}
                        }
                    }
                }
            }
            else {}
        }
    }
    return out
}

// ---- filtered indexes: when a query's conditions imply the predicate

// The value of an expression without columns, if it has one now (NULL: none).
fn constVal(x: &Expr, params: &[]Val): Option[Val] {
    var ns: []str = []
    colNames(x, mut &ns)
    if len(ns) > 0 || hasAgg(x) { return None }
    let noCols: []lexdb_sql.ColDef = []
    let noRow: []Val = []
    let noAggs: []Val = []
    let noSubs: []SubRes = []
    let env = Env{cols: &noCols, row: &noRow, aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs}
    match eval(x, &env) {
        Ok(v) {
            if isNull(&v) { return None }
            return Some(v)
        }
        Err(_) { return None }
    }
}

fn isCmp(op: &str): bool { return op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">=" }

// "column op value", from a comparison of a column with a constant.
type Cmp = record { col: str; op: str; val: Val }

fn asCmp(x: &Expr, params: &[]Val): Option[Cmp] {
    match x {
        Expr.Bin(op, a, b) {
            if !isCmp(&op) { return None }
            match a {
                Expr.Col(n) {
                    match constVal(&b, params) {
                        Some(v) { return Some(Cmp{col: n, op: op, val: v}) }
                        None {}
                    }
                }
                else {}
            }
            match b {
                Expr.Col(n) {
                    match constVal(&a, params) {
                        Some(v) {
                            let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { op } }
                            return Some(Cmp{col: n, op: flip, val: v})
                        }
                        None {}
                    }
                }
                else {}
            }
        }
        else {}
    }
    return None
}

fn holds(op: &str, d: int): bool {
    return match op {
        "=" { d == 0 }
        "<>" { d != 0 }
        "<" { d < 0 }
        "<=" { d <= 0 }
        ">" { d > 0 }
        else { d >= 0 }
    }
}

fn mentions(x: &Expr, col: &str): bool {
    match x {
        Expr.Col(n) { return n == col }
        else { return false }
    }
}

// Whether a query's conjunct c implies a predicate's conjunct p: the same
// text; a comparison of a column for "column IS NOT NULL"; or comparisons
// of a column with constants (x >= 3 implies x > 0).
// Planning that looks at a parameter's value counts here (a partial index's
// predicate implied, a LIMIT or OFFSET): a plan made with any look is not
// kept for the next execution (PlanCache). The SQL thread is one, so a
// module counter will do.
var PARAM_LOOKS: int = 0

fn impliesOne(c: &Expr, p: &Expr, params: &[]Val): bool {
    if len(params) > 0 { PARAM_LOOKS += 1 }
    if lexdb_sql.exprText(c) == lexdb_sql.exprText(p) { return true }
    match p {
        Expr.IsNull(a, neg) {
            if !neg { return false }
            match a {
                Expr.Col(n) {
                    match c {
                        Expr.Bin(op, l, r) { return isCmp(&op) && (mentions(&l, &n) || mentions(&r, &n)) }
                        else { return false }
                    }
                }
                else { return false }
            }
        }
        else {}
    }
    match asCmp(p, params) {
        Some(pc) {
            match asCmp(c, params) {
                Some(cc) {
                    if cc.col != pc.col { return false }
                    let d = match compare(&cc.val, &pc.val) { Ok(x) { x } Err(_) { return false } }
                    let po = pc.op
                    match cc.op {
                        "=" { return holds(&po, d) }
                        ">" { return (po == ">" || po == ">=" || po == "<>") && d >= 0 }
                        ">=" { return ((po == ">" || po == "<>") && d > 0) || (po == ">=" && d >= 0) }
                        "<" { return (po == "<" || po == "<=" || po == "<>") && d <= 0 }
                        "<=" { return ((po == "<" || po == "<>") && d < 0) || (po == "<=" && d <= 0) }
                        else { return po == "<>" && d == 0 }
                    }
                }
                None { return false }
            }
        }
        None { return false }
    }
}

// A predicate's column names, as alias.column.
fn qualify(x: &Expr, alias: &str): Expr {
    match x {
        Expr.Col(n) { return Expr.Col(alias + "." + n) }
        Expr.Unary(op, a) { return Expr.Unary(op, qualify(&a, alias)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, qualify(&a, alias), qualify(&b, alias)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(qualify(&a, alias), neg) }
        Expr.Cast(a, t) { return Expr.Cast(qualify(&a, alias), t) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, qualify(&a, alias)) }
            return Expr.Call(n, out, star)
        }
        else { return clone(x) }
    }
}

// Whether index c of level k may be used under conditions cs: it is not
// filtered, or they imply each conjunct of its predicate.
fn (q: &Query) usable(k: int, c: int, cs: &[]Expr, params: &[]Val): bool {
    if c < 0 { return true }
    let lv = &q.levels[k]
    match lv.t.indexes[c].pred {
        Some(pr) {
            var ps: []Expr = []
            conjuncts(&qualify(&pr, &lv.alias), mut &ps)
            for pc in ps {
                var ok = false
                for cc in cs { if impliesOne(&cc, &pc, params) { ok = true } }
                if !ok { return false }
            }
            return true
        }
        None { return true }
    }
}

// The values of a conjunct "col IN (...)" whose values use only tables
// before level k (none: no such conjunct).
fn inList(cs: &[]Expr, col: &str, k: int, q: &Query): []Expr {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "in" && len(args) > 1 {
                    var ok = false
                    match args[0] { Expr.Col(x) { ok = x == col } else {} }
                    for i in 1..len(args) { if !q.keyBefore(&args[i], k) { ok = false } }
                    if ok {
                        var out: []Expr = []
                        for i in 1..len(args) { append(mut &out, clone(&args[i])) }
                        return out
                    }
                }
            }
            else {}
        }
    }
    return []
}

// col IN (subquery), the subquery uncorrelated (run once, before the
// tables are read): its number, else -1.
fn inSubOf(cs: &[]Expr, col: &str): int {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "#in" && len(args) == subFixed(&n) {
                    match args[3] { Expr.Col(x) { if x == col { return litInt(&args[0]) } } else {} }
                }
            }
            else {}
        }
    }
    return -1
}

// LIKE 'abc%' on a text column: the strings from 'abc' to 'abd'.
fn likeBounds(c: &Expr, col: &str, q: &Query, out: mut &[]Bound) {
    match c {
        Expr.Call(n, args, _) {
            if n != "like" || len(args) != 2 { return }
            match args[0] {
                Expr.Col(x) { if x != col { return } }
                else { return }
            }
            let ci = colIndex(&q.cols, col)
            if ci < 0 || q.cols[ci].typ.kind != lexdb_sql.K_TEXT { return }
            match args[1] {
                Expr.Lit(v) {
                    match v {
                        Val.Text(pat) {
                            // the characters before the first wildcard; \ escapes
                            var pre = newStrBuf()
                            var i = 0
                            while i < len(pat) {
                                let b = pat[i]
                                if b == '%' || b == '_' { break }
                                if b == '\\' {
                                    if i + 1 >= len(pat) { return }
                                    i += 1
                                }
                                pre.addByte(pat[i])
                                i += 1
                            }
                            let p = pre.toStr()
                            if len(p) == 0 { return }
                            append(out, Bound{op: ">=", val: Expr.Lit(Val.Text(p))})
                            let next = succ(&p)
                            if next != "" { append(out, Bound{op: "<", val: Expr.Lit(Val.Text(next))}) }
                        }
                        else {}
                    }
                }
                else {}
            }
        }
        else {}
    }
}

fn keyCols(t: &Table, index: int): []int {
    var out: []int = []
    if index < 0 {
        for i in t.pk { append(mut &out, i) }
    } else {
        for i in t.indexes[index].cols { append(mut &out, i) }
    }
    return out
}

// The rules (4.8): the whole primary key equal; then a unique index whose
// columns are all equal; then the most leading equalities, then a range on
// the next column; the primary key wins a tie. Nothing: a full scan.
fn choosePath(q: &Query, k: int, cs: &[]Expr, params: &[]Val): Path {
    let lv = &q.levels[k]
    var best = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1}
    var bestScore = 0
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if !q.usable(k, c, cs, params) { continue }
        let cols = keyCols(&lv.t, c)
        var eqs: []Expr = []
        var rng: []Bound = []
        var ins: []Expr = []
        var inSub = -1
        for ci in cols {
            let name = lv.alias + "." + lv.t.cols[ci].name
            var bs = bounds(cs, &name, k, q)
            var eqAt = -1
            for i in 0..len(bs) { if bs[i].op == "=" && eqAt < 0 { eqAt = i } }
            if eqAt < 0 {
                ins = inList(cs, &name, k, q)
                if len(ins) == 0 { inSub = inSubOf(cs, &name) }
                if len(ins) == 0 && inSub < 0 { rng = bs }
                break
            }
            append(mut &eqs, replace(mut &bs[eqAt].val, Expr.Lit(Val.Null)))
        }
        // an IN list counts as an equality; the full key by one is a lookup per value
        let hasIn = len(ins) > 0 || inSub >= 0
        var score = 2 * (len(eqs) + (if hasIn { 1 } else { 0 })) + (if len(rng) > 0 { 1 } else { 0 })
        if c >= 0 && lv.t.indexes[c].pred.isSome() { score += 1 }      // filtered: fewer rows
        if len(eqs) == len(cols) {
            if c < 0 { score = 1000 } else if lv.t.indexes[c].unique { score = 999 }
        } else if hasIn && len(eqs) + 1 == len(cols) {
            if c < 0 { score = 500 } else if lv.t.indexes[c].unique { score = 499 }
        }
        if score > bestScore {
            bestScore = score
            best = Path{index: c, eqs: eqs, rng: rng, desc: false, noNulls: false, ins: ins, inSub: inSub}
        }
    }
    return best
}

// Whether the path's values change from row to row of the tables before
// it: they use those tables, or a correlated subquery (run per row).
fn (q: &Query) pathOuter(p: &Path): bool {
    for x in p.eqs { if q.maxLevel(&x) >= 0 { return true } }
    for x in p.ins { if q.maxLevel(&x) >= 0 { return true } }
    for b in p.rng { if q.maxLevel(&b.val) >= 0 { return true } }
    return q.corr && pathCorr(p)
}

fn pathCorr(p: &Path): bool {
    for x in p.eqs { if hasCorr(&x) { return true } }
    for x in p.ins { if hasCorr(&x) { return true } }
    for b in p.rng { if hasCorr(&b.val) { return true } }
    return false
}

// The values of the correlated subqueries in a path's key values, for
// env's row (fillCur; memoized as the filter's are).
fn pathCur(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, p: &Path, env: &Env, rs: mut &Run): Result[[]Val, DbErr] {
    var cur: []Val = array(len(q.subs), Val.Null)
    for x in p.eqs { try fillCur(st, txn, q, &x, env, rs, mut &cur) }
    for x in p.ins { try fillCur(st, txn, q, &x, env, rs, mut &cur) }
    for b in p.rng { try fillCur(st, txn, q, &b.val, env, rs, mut &cur) }
    return Ok(cur)
}

fn encPart(b: mut &StrBuf, v: &Val, index: bool) {
    if index { encIdxPart(b, v) } else { encKeyPart(b, v) }
}

// The keys a path covers, its values evaluated now.
// A column's type for its bounds: a value too long for varchar(n) is not
// an error there, it only matches nothing.
fn boundType(t: &lexdb_sql.TypeName): lexdb_sql.TypeName {
    return lexdb_sql.TypeName{kind: t.kind, oid: t.oid, prec: t.prec, scale: t.scale, len: 0}
}

// The keys a path covers: with an IN list, a lookup (or range) per value,
// in key order (backward for a backward path).
fn pathScans(t: &Table, p: &Path, env: &Env): Result[[]Scan, DbErr] {
    if len(p.ins) == 0 && p.inSub < 0 { return Ok([try pathScan(t, p, env)]) }
    if p.inSub >= 0 && len(env.subs[p.inSub].vals) > IN_LOOKUP_MAX {
        return Ok([Scan{empty: false, point: false, lo: "", hi: "", whole: true}])
    }
    let ix = p.index >= 0
    let cols = keyCols(t, p.index)
    var prefix = newStrBuf()
    for k in 0..len(p.eqs) {
        let v = try coerce(try eval(&p.eqs[k], env), &boundType(&t.cols[cols[k]].typ))
        if isNull(&v) { return Ok([]) }
        encPart(mut &prefix, &v, ix)
    }
    let pre = prefix.toStr()
    let typ = boundType(&t.cols[cols[len(p.eqs)]].typ)
    var vs: []Val = []
    if p.inSub >= 0 {
        // the subquery's values; one not of the column's type is left to
        // the condition, which stays (it decides what IN means)
        for x in env.subs[p.inSub].vals {
            match coerce(x, &typ) {
                Ok(v) { append(mut &vs, v) }
                Err(_) {}
            }
        }
    } else {
        for x in p.ins { append(mut &vs, try coerce(try eval(&x, env), &typ)) }
    }
    var keys: []str = []
    for v in vs {
        if isNull(&v) { continue }
        var kb = newStrBuf()
        kb.add(pre)
        encPart(mut &kb, &v, ix)
        append(mut &keys, kb.toStr())
    }
    collections.sortBy(mut &keys, fn(a: &str, b: &str): int { return a.cmp(b) })
    let point = !ix && len(p.eqs) + 1 == len(cols)
    var out: []Scan = []
    for i in 0..len(keys) {
        if i > 0 && keys[i] == keys[i - 1] { continue }
        if point { append(mut &out, Scan{empty: false, point: true, lo: keys[i], hi: "", whole: false}) } else {
            append(mut &out, Scan{empty: false, point: false, lo: keys[i], hi: succ(&keys[i]), whole: false})
        }
    }
    if p.desc {
        var rev: []Scan = []
        while len(out) > 0 { append(mut &rev, pop(mut &out)) }
        return Ok(rev)
    }
    return Ok(out)
}

fn pathScan(t: &Table, p: &Path, env: &Env): Result[Scan, DbErr] {
    let none = Scan{empty: true, point: false, lo: "", hi: "", whole: false}
    let ix = p.index >= 0
    let cols = keyCols(t, p.index)
    var prefix = newStrBuf()
    for k in 0..len(p.eqs) {
        let v = try coerce(try eval(&p.eqs[k], env), &boundType(&t.cols[cols[k]].typ))
        if isNull(&v) { return Ok(none) }
        encPart(mut &prefix, &v, ix)
    }
    let pre = prefix.toStr()
    if !ix && len(p.eqs) == len(cols) { return Ok(Scan{empty: false, point: true, lo: pre, hi: "", whole: false}) }
    var lo = pre
    var hi = if len(pre) > 0 { succ(&pre) } else { "" }
    if len(p.rng) > 0 {
        let typ = boundType(&t.cols[cols[len(p.eqs)]].typ)
        for b in p.rng {
            let v = try coerce(try eval(&b.val, env), &typ)
            if isNull(&v) { return Ok(none) }
            var kb = newStrBuf()
            kb.add(pre)
            encPart(mut &kb, &v, ix)
            let kv = kb.toStr()
            if b.op == ">" || b.op == ">=" {
                if kv > lo { lo = kv }
            } else {
                // Inclusive even for <: the value coerced to the column's type
                // may have been rounded. Every row is checked against the WHERE.
                let s = succ(&kv)
                if s != "" && (hi == "" || s < hi) { hi = s }
            }
        }
    }
    if ix && (len(p.rng) > 0 || p.noNulls) {
        {
            // An index's NULLs sort last (marker 2): no range includes them.
            var nb = newStrBuf()
            nb.add(pre)
            nb.addByte(2)
            let nk = nb.toStr()
            if hi == "" || nk < hi { hi = nk }
        }
    }
    return Ok(Scan{empty: false, point: false, lo: lo, hi: hi, whole: false})
}

const BATCH = 256

type Cursor = record { at: str; started: bool; done: bool }

fn newCursor(): Cursor { return Cursor{at: "", started: false, done: false} }

// The smallest key after k.
fn after(k: &str): str {
    var b = newStrBuf()
    b.add(k)
    b.addByte(0)
    return b.toStr()
}

// Appends up to BATCH rows of a scan to out, from the cursor on. Rows are
// read in batches so that what is done with them (a join's lookups, an
// index's entries) can use the transaction between.
fn fetch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, p: &Path, sc: &Scan, cur: mut &Cursor,
         out: mut &[][]Val): Result[Unit, DbErr] {
    let n = len(t.cols)
    if sc.empty {
        cur.done = true
        return Ok(Unit{})
    }
    if sc.point {
        cur.done = true
        match try st.get(txn, t.tree, sc.lo) {
            Some(v) { append(out, try decRow(&v, n)) }
            None {}
        }
        return Ok(Unit{})
    }
    let byIndex = p.index >= 0 && !sc.whole
    let tree = if byIndex { t.indexes[p.index].tree } else { t.tree }
    var vals: []str = []
    var last = ""
    if p.desc {
        // backward: the cursor is the exclusive end
        let to = if cur.started { cur.at } else { sc.hi }
        cur.started = true
        try st.scanBack(txn, tree, sc.lo, to, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val)
            last = en.key
            return len(vals) < BATCH
        })
        if len(vals) < BATCH { cur.done = true } else { cur.at = last }
    } else {
        let from = if cur.started { cur.at } else { sc.lo }
        cur.started = true
        try st.scan(txn, tree, from, sc.hi, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val)
            last = en.key
            return len(vals) < BATCH
        })
        if len(vals) < BATCH { cur.done = true } else { cur.at = after(&last) }
    }
    for v in vals {
        if !byIndex {
            append(out, try decRow(&v, n))
        } else {
            match try st.get(txn, t.tree, v) {
                Some(rv) { append(out, try decRow(&rv, n)) }
                None { return Err(lexdb_base.corrupt("an index entry of \"" + t.name + "\" without its row")) }
            }
        }
    }
    return Ok(Unit{})
}

fn allTrue(cs: &[]Expr, cols: &[]lexdb_sql.ColDef, row: &[]Val, params: &[]Val): Result[bool, DbErr] {
    if len(cs) == 0 { return Ok(true) }
    let noAggs: []Val = []
    let noSubs: []SubRes = []
    let env = Env{cols: cols, row: row, aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs}
    for c in cs { if truth(&(try eval(&c, &env))) != Some(true) { return Ok(false) } }
    return Ok(true)
}

fn newLevel(t: Table, alias: str, join: int, first: int): Level {
    return Level{t: t, alias: alias, join: join, first: first, path: Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1}, cond: [],
                 post: [], local: [], perRow: true, hashCols: [], hashVals: [], src: -1, work: -1, lateral: false}
}

// Plans a query over the tables of FROM (4.8): the tables are joined in the
// order written, and each WHERE conjunct is checked at the first table
// where all its columns are known.
fn buildQuery(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, from: &[]lexdb_sql.FromItem,
              where: &Option[Expr], params: &[]Val, subs: &[]lexdb_sql.Stmt, sc: mut &Scope): Result[Query, DbErr] {
    var q = Query{levels: [], cols: [], top: [], subs: [], base: sc.base, corr: false, refs: []}
    // a subquery in FROM is planned first: it sees the queries around this
    // one, not this one's tables
    var planned: [][]SubPlan = []
    for i in 0..len(subs) { append(mut &planned, []) }
    // its scope comes first, its columns added as its tables are read: a
    // LATERAL subquery sees the tables before it, another none of them
    append(mut &sc.frames, Frame{cols: [], refs: [], refOids: [], subRefs: [], subOids: [], subNames: [], hidden: false})
    let me = len(sc.frames) - 1
    for f in from {
        for lv in q.levels {
            if lv.alias == f.alias { return Err(e("42712", "table name \"" + f.alias + "\" specified more than once")) }
        }
        var t = Table{name: f.alias, tree: -1, cols: [], pk: [], indexes: []}
        var lateral = false
        if f.sub >= 0 {
            sc.frames[me].hidden = !f.lateral
            let planning = planSub(st, txn, &subs[f.sub], params, sc)
            sc.frames[me].hidden = false
            let sp = try planning
            // outer values: run per row of the tables before it (and cached by them)
            lateral = len(sp.sel.q.refs) > 0
            if lateral && keepsRight(f.join) {
                return Err(e("42P10", "a LATERAL subquery cannot be the right side of a RIGHT or FULL JOIN"))
            }
            if len(f.cols) > len(sp.sel.outs) {
                return Err(e("42P10", "table \"" + f.alias + "\" has " + len(sp.sel.outs).toStr() + " columns available but " +
                             len(f.cols).toStr() + " columns specified"))
            }
            for i in 0..len(sp.sel.outs) {
                let name = if i < len(f.cols) { f.cols[i] } else { sp.sel.outs[i].name }
                append(mut &t.cols, lexdb_sql.ColDef{name: name, typ: oidType(sp.sel.outs[i].oid), notNull: false})
            }
            append(mut &planned[f.sub], sp)
        } else if f.work >= 0 {
            var w = -1
            for i in 0..len(sc.works) { if sc.works[i].id == f.work { w = i } }
            if w < 0 {
                return Err(e("42P19", "recursive reference to query \"" + f.table + "\" must not appear within its non-recursive term"))
            }
            if len(f.cols) > len(sc.works[w].cols) {
                return Err(e("42P10", "table \"" + f.alias + "\" has " + len(sc.works[w].cols).toStr() + " columns available but " +
                             len(f.cols).toStr() + " columns specified"))
            }
            for i in 0..len(sc.works[w].cols) {
                let name = if i < len(f.cols) { f.cols[i] } else { sc.works[w].cols[i].name }
                append(mut &t.cols, lexdb_sql.ColDef{name: name, typ: sc.works[w].cols[i].typ, notNull: false})
            }
        } else {
            t = try needTable(st, txn, &f.table)
        }
        let first = len(q.cols)
        for k in 0..len(t.cols) {
            // a name repeated in one FROM item ((SELECT 1 AS a, 2 AS a) x,
            // unnest(a, b)): each its own column, the name ambiguous
            var name = t.cols[k].name
            for j in 0..k { if t.cols[j].name == name { name = name + DUPSEP + k.toStr() } }
            append(mut &q.cols, lexdb_sql.ColDef{name: f.alias + "." + name, typ: t.cols[k].typ, notNull: t.cols[k].notNull})
        }
        var lv = newLevel(t, f.alias, f.join, first)
        lv.src = f.sub
        lv.work = f.work
        lv.lateral = lateral
        append(mut &q.levels, lv)
        if len(subs) > 0 {
            // only its subqueries look here
            for i in first..len(q.cols) {
                append(mut &sc.frames[me].cols, lexdb_sql.ColDef{name: q.cols[i].name, typ: q.cols[i].typ, notNull: q.cols[i].notNull})
            }
        }
    }
    for i in 0..len(subs) {
        if len(planned[i]) == 0 { append(mut &planned[i], try planSub(st, txn, &subs[i], params, sc)) }
        let sp = pop(mut &planned[i])
        let top = len(sc.frames) - 1
        append(mut &sc.frames[top].subRefs, cloneAll(&sp.sel.q.refs))
        append(mut &sc.frames[top].subOids, sp.oid)
        append(mut &sc.frames[top].subNames, sp.name)
        if len(sp.sel.q.refs) > 0 { q.corr = true }
        append(mut &q.subs, sp)
    }
    let nl = len(q.levels)
    // A RIGHT or FULL JOIN can make the columns before it NULL: no WHERE
    // conjunct goes below the last one.
    var lastRight = -1
    for k in 0..nl { if keepsRight(q.levels[k].join) { lastRight = k } }
    var ms: [][]Expr = []
    var ps: [][]Expr = []
    for k in 0..nl {
        append(mut &ms, [])
        append(mut &ps, [])
        match from[k].on {
            Some(on) {
                // ON sees this table and those before it
                let r = try resolve(&on, &q.cols, q.levels[k].first + len(q.levels[k].t.cols), sc)
                conjuncts(&r, mut &ms[k])
            }
            None {}
        }
    }
    match where {
        Some(w) {
            let r = try resolve(&w, &q.cols, len(q.cols), sc)
            var cs: []Expr = []
            conjuncts(&r, mut &cs)
            for i in 0..len(cs) {
                let c = replace(mut &cs[i], Expr.Lit(Val.Null))
                if nl == 0 {
                    append(mut &q.top, c)
                } else {
                    var k = q.maxLevel(&c)
                    if k < 0 { k = 0 }
                    if lastRight > k { k = lastRight }
                    if isOuter(q.levels[k].join) { append(mut &ps[k], c) } else { append(mut &ms[k], c) }
                }
            }
        }
        None {}
    }
    if q.corr {
        // a correlated subquery runs per row: its conjuncts go last
        for k in 0..nl {
            ms[k] = subsLast(replace(mut &ms[k], []))
            ps[k] = subsLast(replace(mut &ps[k], []))
        }
        q.top = subsLast(replace(mut &q.top, []))
    }
    for k in 0..nl {
        let m = replace(mut &ms[k], [])
        // a subquery's rows have no key: read them all
        var path = if q.levels[k].virt() { Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1} } else {
            choosePath(&q, k, &m, params)
        }
        var perRow = k == 0 || q.pathOuter(&path) || q.levels[k].lateral
        let right = keepsRight(q.levels[k].join)
        if right {
            // Every row of it is kept: read it all once, and remember which joined.
            path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1}
            perRow = false
        }
        var local: []Expr = []
        var hcols: []int = []
        var hvals: []Expr = []
        if !perRow {
            for c in m {
                if q.minLevel(&c) >= k {
                    if !right { append(mut &local, clone(&c)) }
                    continue
                }
                match c {
                    Expr.Bin(op, a, b) {
                        if op == "=" {
                            var got = false
                            match a {
                                Expr.Col(n) {
                                    if q.levelOf(&n) == k && q.valBefore(&b, k) {
                                        append(mut &hcols, colIndex(&q.cols, &n) - q.levels[k].first)
                                        append(mut &hvals, clone(&b))
                                        got = true
                                    }
                                }
                                else {}
                            }
                            if !got {
                                match b {
                                    Expr.Col(n) {
                                        if q.levelOf(&n) == k && q.valBefore(&a, k) {
                                            append(mut &hcols, colIndex(&q.cols, &n) - q.levels[k].first)
                                            append(mut &hvals, clone(&a))
                                        }
                                    }
                                    else {}
                                }
                            }
                        }
                    }
                    else {}
                }
            }
        }
        q.levels[k].path = path
        q.levels[k].perRow = perRow
        q.levels[k].cond = m
        q.levels[k].post = replace(mut &ps[k], [])
        q.levels[k].local = local
        q.levels[k].hashCols = hcols
        q.levels[k].hashVals = hvals
    }
    return Ok(q)
}

// Reads the tables that are joined by hash, once.
fn materialize(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: mut &Mats, params: &[]Val,
               rs: mut &Run): Result[Unit, DbErr] {
    for k in 1..len(q.levels) {
        if q.levels[k].perRow { continue }
        var rows: [][]Val = []
        var mat: [][]Val = []
        var keys: Map[str, int] = newMap()
        var buckets: [][]int = []
        {
            let lv = &q.levels[k]
            var full: []Val = array(len(q.cols), Val.Null)
            if lv.virt() {
                for r in m.vrows[k] { append(mut &rows, copyRow(&r)) }
            } else {
                let noAggs: []Val = []
                let env = Env{cols: &q.cols, row: &full, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
                let scans = try pathScans(&lv.t, &lv.path, &env)
                for sc in scans {
                    var cur = newCursor()
                    while !cur.done { try fetch(st, txn, &lv.t, &lv.path, &sc, mut &cur, mut &rows) }
                }
            }
            rs.cnt[k].built += len(rows)
            try rs.hold(rowsBytes(&rows))
            let keepAll = keepsRight(lv.join)
            for i in 0..len(rows) {
                let r = replace(mut &rows[i], [])
                for j in 0..len(r) { full[lv.first + j] = r[j] }
                if !(try allTrueX(st, txn, q, m, &lv.local, &full, params, rs)) { continue }
                var kb = newStrBuf()
                var nul = false
                for c in lv.hashCols {
                    if isNull(&r[c]) { nul = true }
                    if lv.virt() { keyPart(mut &kb, &r[c]) } else { encIdxPart(mut &kb, &r[c]) }
                }
                if nul {
                    // NULL equals nothing; a RIGHT or FULL JOIN still keeps the row
                    if keepAll {
                        append(mut &mat, r)
                        rs.cnt[k].kept += 1
                    }
                    continue
                }
                let key = kb.toStr()
                var b = -1
                match keys.get(&key) {
                    Some(x) { b = x }
                    None {
                        b = len(buckets)
                        keys.put(key, b)
                        append(mut &buckets, [])
                    }
                }
                append(mut &buckets[b], len(mat))
                append(mut &mat, r)
                rs.cnt[k].kept += 1
            }
        }
        if keepsRight(q.levels[k].join) { rs.seen[k] = array(len(mat), false) }
        m.mat[k] = mat
        m.keys[k] = keys
        m.buckets[k] = buckets
    }
    return Ok(Unit{})
}

// Places a candidate row of level k in the joined row and goes on to the
// next level if it joins: -1 stop, 0 it does not join, 1 it joined.
fn tryRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, k: int, r: &[]Val, ri: int,
          row: mut &[]Val, params: &[]Val, emit: &fn(&[]Val): Result[bool, DbErr], rs: mut &Run): Result[int, DbErr] {
    try rs.tick()
    let lv = &q.levels[k]
    for i in 0..len(r) { row[lv.first + i] = r[i] }
    rs.cnt[k].read += 1
    if !(try allTrueX(st, txn, q, m, &lv.cond, row, params, rs)) { return Ok(0) }
    rs.cnt[k].joined += 1
    if ri >= 0 && len(rs.seen[k]) > 0 { rs.seen[k][ri] = true }
    if !(try allTrueX(st, txn, q, m, &lv.post, row, params, rs)) { return Ok(1) }
    if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(-1) }
    return Ok(1)
}

// Joins the rows of level k on to the joined row (levels before k filled),
// calling emit for each complete row; false: emit asked to stop.
fn runLevel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, k: int, row: mut &[]Val,
            params: &[]Val, emit: &fn(&[]Val): Result[bool, DbErr], rs: mut &Run): Result[bool, DbErr] {
    if k == len(q.levels) { return emit(row) }
    let lv = &q.levels[k]
    var matched = false
    rs.cnt[k].starts += 1
    if !lv.perRow {
        var kb = newStrBuf()
        var nul = false
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
            for i in 0..len(lv.hashCols) {
                if lv.virt() {
                    let v = try eval(&lv.hashVals[i], &env)
                    if isNull(&v) { nul = true }
                    keyPart(mut &kb, &v)
                } else {
                    let v = try coerce(try eval(&lv.hashVals[i], &env), &lv.t.cols[lv.hashCols[i]].typ)
                    if isNull(&v) { nul = true }
                    encIdxPart(mut &kb, &v)
                }
            }
        }
        if !nul {
            match m.keys[k].get(&kb.toStr()) {
                Some(b) {
                    for ri in m.buckets[k][b] {
                        let got = try tryRow(st, txn, q, m, k, &m.mat[k][ri], ri, row, params, emit, rs)
                        if got < 0 { return Ok(false) }
                        if got > 0 { matched = true }
                    }
                }
                None {}
            }
        }
    } else if lv.lateral {
        // its subquery with this row's values, its rows kept per values
        let i = lv.src
        var refVals: []Val = []
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
            for x in q.subs[i].sel.q.refs { append(mut &refVals, try eval(&x, &env)) }
        }
        let key = valsKey(&refVals)
        var at = -1
        match rs.memo[i].get(&key) {
            Some(n) { at = n }
            None {}
        }
        var rows: [][]Val = []
        if at >= 0 {
            rs.stats[i].hits += 1
            rows = replace(mut &rs.memoRes[i][at].data, [])
        } else {
            var ps: []Val = []
            for j in 0..q.base { append(mut &ps, params[j]) }
            for v in refVals { append(mut &ps, v) }
            var res = try runChild(st, txn, &q.subs[i].sel, &ps, -1, rs, i)
            rows = replace(mut &res.rows, [])
            if len(rs.memoRes[i]) < MEMO_MAX {
                try rs.hold(rowsBytes(&rows) + len(key) + 48)
                at = len(rs.memoRes[i])
                rs.memo[i].put(key, at)
                append(mut &rs.memoRes[i], emptyRes())
            }
        }
        for r in rows {
            let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
            if got < 0 { return Ok(false) }
            if got > 0 { matched = true }
        }
        if at >= 0 { rs.memoRes[i][at].data = rows }
    } else if lv.virt() {
        for r in m.vrows[k] {
            let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
            if got < 0 { return Ok(false) }
            if got > 0 { matched = true }
        }
    } else {
        var scans: []Scan = []
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
            if q.corr && pathCorr(&lv.path) {
                let cur = try pathCur(st, txn, q, &lv.path, &env, rs)
                let env2 = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &cur}
                scans = try pathScans(&lv.t, &lv.path, &env2)
            } else {
                scans = try pathScans(&lv.t, &lv.path, &env)
            }
        }
        for sc in scans {
            var cur = newCursor()
            while !cur.done {
                var batch: [][]Val = []
                try fetch(st, txn, &lv.t, &lv.path, &sc, mut &cur, mut &batch)
                for r in batch {
                    let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
                    if got < 0 { return Ok(false) }
                    if got > 0 { matched = true }
                }
            }
        }
    }
    if keepsLeft(lv.join) && !matched {
        for i in 0..len(lv.t.cols) { row[lv.first + i] = Val.Null }
        rs.cnt[k].nulls += 1
        if try allTrueX(st, txn, q, m, &lv.post, row, params, rs) {
            if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(false) }
        }
    }
    return Ok(true)
}

// Calls emit on each row of the query (materialize first).
fn runQuery(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val,
            emit: &fn(&[]Val): Result[bool, DbErr], rs: mut &Run): Result[Unit, DbErr] {
    if len(q.levels) == 0 {
        let none: []Val = []
        if try allTrueX(st, txn, q, m, &q.top, &none, params, rs) { let more = try emit(&none) }
        return Ok(Unit{})
    }
    var row: []Val = array(len(q.cols), Val.Null)
    if !(try runLevel(st, txn, q, m, 0, mut &row, params, emit, rs)) { return Ok(Unit{}) }
    // A RIGHT or FULL JOIN's rows that joined nothing, with NULLs for the
    // tables before it, go on through the tables after it.
    for k in 1..len(q.levels) {
        let lv = &q.levels[k]
        if !keepsRight(lv.join) { continue }
        for ri in 0..len(m.mat[k]) {
            if rs.seen[k][ri] { continue }
            for i in 0..len(row) { row[i] = Val.Null }
            for i in 0..len(m.mat[k][ri]) { row[lv.first + i] = m.mat[k][ri][i] }
            rs.cnt[k].unmatched += 1
            if try allTrueX(st, txn, q, m, &lv.post, &row, params, rs) {
                if !(try runLevel(st, txn, q, m, k + 1, mut &row, params, emit, rs)) { return Ok(Unit{}) }
            }
        }
    }
    return Ok(Unit{})
}

// ---- subqueries (design 9.8)
//
// A statement's subqueries are planned with it, each inside the query it is
// in. A name not among a query's own columns is looked for in the queries
// around it, nearest first, and becomes a parameter after the statement's
// own: the query it is in supplies its value (its "refs"), and a query in
// between passes it down. A subquery with no refs is run once per
// execution, before the query; one with refs is run for each row that needs
// it, its result kept per value of its refs.

const MEMO_MAX = 10000          // results kept per correlated subquery

type SubPlan = record {
    use: int                    // lexdb_sql.SUB_SCALAR, SUB_EXISTS, SUB_IN
    sel: Sel
    oid: int                    // its column's type
    name: str                   // its column's name, as an output column
    hashed: bool                // correlated, run once into a hash: sel outputs the key (then IN's value, a scalar's aggregate)
    keyOuter: []Expr            // per key column: what it equals, of outer values only (refs as parameters)
    keyText: []str              // EXPLAIN: "inner = outer"
    cte: int                    // a CTE's use: the CTE's number (its rows shared); -1
}

// A subquery's result: a scalar's value, how many rows, IN's values.
type SubRes = record {
    val: Val
    rows: int
    set: Map[str, int]
    numeric: bool               // the values are numbers: keyed as numbers
    hasNull: bool
    groups: Map[str, int]       // hashed: key -> 1 rows, 3 rows and a NULL value (IN)
    data: [][]Val               // in FROM: its rows
    vals: []Val                 // IN: its distinct values not NULL, IN_LOOKUP_MAX + 1 at most (Path.inSub)
}

fn emptyRes(): SubRes {
    return SubRes{val: Val.Null, rows: 0, set: newMap(), numeric: false, hasNull: false, groups: newMap(), data: [], vals: []}
}

// The queries being planned, outermost first.
type Frame = record {
    cols: []lexdb_sql.ColDef
    refs: []Expr                // the outer values it uses, in the terms of the query around it
    refOids: []int
    subRefs: [][]Expr           // per subquery of it: the subquery's refs, in its terms
    subOids: []int
    subNames: []str
    hidden: bool                // its columns are not in scope (a FROM subquery that is not LATERAL)
}

pub type Scope = record {
    frames: []Frame
    base: int                   // the statement's parameters
    ptypes: []int
    works: []Work               // the working tables of recursive CTEs being planned
}

type Work = record { id: int; cols: []lexdb_sql.ColDef }

fn newScope(params: &[]Val, ptypes: &[]int): Scope {
    var pt: []int = []
    for i in 0..len(params) { append(mut &pt, if i < len(ptypes) { ptypes[i] } else { 0 }) }
    return Scope{frames: [], base: len(params), ptypes: pt, works: []}
}

// The parameter types of the query being planned: the statement's, then
// its refs'.
fn ptypesOf(sc: &Scope): []int {
    var out: []int = []
    for t in sc.ptypes { append(mut &out, t) }
    if len(sc.frames) > 0 { for t in sc.frames[len(sc.frames) - 1].refOids { append(mut &out, t) } }
    return out
}

// A name of a query around the one being planned, as a parameter of it.
fn outerRef(sc: mut &Scope, name: &str): Result[Option[Expr], DbErr] {
    let top = len(sc.frames) - 1
    var f = top - 1
    var found = ""
    var oid = 0
    while f >= 0 && found == "" {
        if sc.frames[f].hidden {
            f -= 1
            continue
        }
        match resolveName(&sc.frames[f].cols, len(sc.frames[f].cols), name) {
            Ok(n) {
                oid = sc.frames[f].cols[colIndex(&sc.frames[f].cols, &n)].typ.oid
                found = n
            }
            Err(x) {
                // ambiguous there, or its table is there and the column is not
                if x.state == "42702" || (x.state == "42703" && dotAt(name) >= 0) { return Err(x) }
            }
        }
        if found == "" { f -= 1 }
    }
    if found == "" { return Ok(None) }
    var x = Expr.Col(found)
    for g in f + 1..top + 1 {
        let t = lexdb_sql.exprText(&x)
        var at = -1
        for i in 0..len(sc.frames[g].refs) { if lexdb_sql.exprText(&sc.frames[g].refs[i]) == t { at = i } }
        if at < 0 {
            at = len(sc.frames[g].refs)
            append(mut &sc.frames[g].refs, clone(&x))
            append(mut &sc.frames[g].refOids, oid)
        }
        x = Expr.Param(sc.base + at + 1)
    }
    return Ok(Some(x))
}

// The query being planned is done: its refs are what the query around it
// must supply.
fn endScope(sc: mut &Scope, q: mut &Query) {
    var f = pop(mut &sc.frames)
    q.refs = replace(mut &f.refs, [])
}

fn planSub(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val,
           sc: mut &Scope): Result[SubPlan, DbErr] {
    var sel = try planSelect(st, txn, s, params, sc)
    if len(s.srf) > 0 { sel.outs = try srfCols(&s.srf, s.ordin, &sel.outs) }
    if s.use == lexdb_sql.SUB_IN && len(sel.outs) != 1 { return Err(e("42601", "subquery has too many columns")) }
    if s.use == lexdb_sql.SUB_SCALAR && len(sel.outs) != 1 { return Err(e("42601", "subquery must return only one column")) }
    let oid = if s.use == lexdb_sql.SUB_EXISTS || len(sel.outs) == 0 { lexdb_sql.OID_BOOL } else { sel.outs[0].oid }
    let name = if s.use == lexdb_sql.SUB_EXISTS { "exists" } else if s.use == lexdb_sql.SUB_SCALAR { sel.outs[0].name } else { "?column?" }
    // (in FROM: its columns are its outs)
    var sp = SubPlan{use: s.use, sel: sel, oid: oid, name: name, hashed: false, keyOuter: [], keyText: [], cte: s.cte}
    if len(sp.sel.q.refs) > 0 && s.use != lexdb_sql.SUB_FROM { hashSub(mut &sp, sc.base) }
    return Ok(sp)
}

// ---- hashed subqueries: a semi-join (EXISTS, IN) or anti-join (NOT ...)
//
// A correlated EXISTS or IN whose outer values are used only in WHERE
// equalities "inner = outer" (outer: of outer values only), none of them a
// lookup's key, is the same
// subquery without them, keyed by their inner sides: it is run once into a
// hash, and each outer row probes it. (With such a key, an index, it stays
// per row: a lookup each.)

fn refOf(x: &Expr, base: int): int {
    match x {
        Expr.Param(n) { if n > base { return n - base - 1 } }
        else {}
    }
    return -1
}

fn usesRefs(x: &Expr, base: int): bool {
    match x {
        Expr.Param(n) { return n > base }
        Expr.Unary(_, a) { return usesRefs(&a, base) }
        Expr.Bin(_, a, b) { return usesRefs(&a, base) || usesRefs(&b, base) }
        Expr.IsNull(a, _) { return usesRefs(&a, base) }
        Expr.Cast(a, _) { return usesRefs(&a, base) }
        Expr.Call(_, args, _) {
            for a in args { if usesRefs(&a, base) { return true } }
            return false
        }
        else { return false }
    }
}

type HashKeys = record {
    inner: []Expr
    outer: []Expr
    texts: []str                // the conjuncts taken out, by their text
}

// Of outer values only: no column of the subquery's, no subquery.
fn outerOnly(x: &Expr, base: int): bool {
    var ns: []str = []
    colNames(x, mut &ns)
    return len(ns) == 0 && usesRefs(x, base) && !hasAgg(x) && !hasSubCall(x)
}

fn hasSubCall(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasSubCall(&a) }
        Expr.Bin(_, a, b) { return hasSubCall(&a) || hasSubCall(&b) }
        Expr.IsNull(a, _) { return hasSubCall(&a) }
        Expr.Cast(a, _) { return hasSubCall(&a) }
        Expr.Call(n, args, _) {
            if isSubCall(&n) { return true }
            for a in args { if hasSubCall(&a) { return true } }
            return false
        }
        else { return false }
    }
}

// A conjunct "inner = outer" (either way round), into hk; false: it uses an
// outer value otherwise.
fn keyConj(c: &Expr, base: int, hk: mut &HashKeys): bool {
    let t = lexdb_sql.exprText(c)
    for x in hk.texts { if x == t { return true } }
    match c {
        Expr.Bin(op, a, b) {
            if op != "=" { return false }
            var inner = clone(&a)
            var outer = clone(&b)
            if !outerOnly(&outer, base) {
                inner = clone(&b)
                outer = clone(&a)
            }
            if !outerOnly(&outer, base) || usesRefs(&inner, base) || hasCorr(&inner) { return false }
            append(mut &hk.inner, inner)
            append(mut &hk.outer, outer)
            append(mut &hk.texts, t)
            return true
        }
        else { return false }
    }
}

fn keyConjs(cs: &[]Expr, base: int, hk: mut &HashKeys, movable: bool): bool {
    for c in cs {
        if !usesRefs(&c, base) { continue }
        if !movable || !keyConj(&c, base, hk) { return false }
    }
    return true
}

fn noRefs(xs: &[]Expr, base: int): bool {
    for x in xs { if usesRefs(&x, base) { return false } }
    return true
}

fn dropTexts(cs: []Expr, texts: &[]str): []Expr {
    var all = cs
    var out: []Expr = []
    for i in 0..len(all) {
        let c = replace(mut &all[i], Expr.Lit(Val.Null))
        let t = lexdb_sql.exprText(&c)
        var drop = false
        for x in texts { if x == t { drop = true } }
        if !drop { append(mut &out, c) }
    }
    return out
}

fn hashSub(sp: mut &SubPlan, base: int) {
    var hk = HashKeys{inner: [], outer: [], texts: []}
    // a scalar subquery: one aggregate row, no GROUP BY, its key's groups
    // then its value per group (9.26)
    let scalar = sp.use == lexdb_sql.SUB_SCALAR
    {
        let sel = &sp.sel
        if sel.setop != 0 || sel.limit >= 0 || sel.offset > 0 || len(sel.groupBy) > 0 { return }
        if scalar {
            if !sel.aggQ || sel.having.isSome() || sel.distinct || len(sel.exprs) != 1 || hasSubCall(&sel.exprs[0]) { return }
        } else if sel.aggQ { return }
        if !noRefs(&sel.exprs, base) || !noRefs(&sel.order, base) { return }
        let q = &sel.q
        for lv in q.levels {
            if !noRefs(&lv.path.eqs, base) || !noRefs(&lv.path.ins, base) || !noRefs(&lv.hashVals, base) { return }
            for b in lv.path.rng { if usesRefs(&b.val, base) { return } }
            // an outer join's ON conjuncts are not WHERE filters: they stay
            if !keyConjs(&lv.cond, base, mut &hk, !isOuter(lv.join)) { return }
            if !keyConjs(&lv.post, base, mut &hk, true) { return }
            if !keyConjs(&lv.local, base, mut &hk, !isOuter(lv.join)) { return }
        }
        if !keyConjs(&q.top, base, mut &hk, true) { return }
        if len(hk.inner) == 0 { return }
    }
    for k in 0..len(sp.sel.q.levels) {
        sp.sel.q.levels[k].cond = dropTexts(replace(mut &sp.sel.q.levels[k].cond, []), &hk.texts)
        sp.sel.q.levels[k].post = dropTexts(replace(mut &sp.sel.q.levels[k].post, []), &hk.texts)
        sp.sel.q.levels[k].local = dropTexts(replace(mut &sp.sel.q.levels[k].local, []), &hk.texts)
    }
    sp.sel.q.top = dropTexts(replace(mut &sp.sel.q.top, []), &hk.texts)
    // it outputs the key, then IN's value or the scalar's aggregate (grouped
    // by the key)
    var outs: []Expr = []
    for x in hk.inner { append(mut &outs, clone(&x)) }
    if sp.use == lexdb_sql.SUB_IN || scalar { append(mut &outs, clone(&sp.sel.exprs[0])) }
    if scalar {
        var gb: []Expr = []
        for x in hk.inner { append(mut &gb, clone(&x)) }
        sp.sel.groupBy = gb
        sp.sel.first = -1               // per group now: no stopping at the first row
    }
    var texts: []str = []
    for i in 0..len(hk.inner) {
        let r = refOf(&hk.outer[i], base)
        var outer = "an outer expression"
        if r >= 0 {
            outer = match sp.sel.q.refs[r] {
                Expr.Col(n) { n }
                else { "an outer value" }
            }
        }
        let inner = match hk.inner[i] {
            Expr.Col(n) { n }
            else { lexdb_sql.exprText(&hk.inner[i]) }
        }
        append(mut &texts, inner + " = " + outer)
    }
    sp.sel.exprs = outs
    sp.sel.order = []
    sp.sel.sort = false
    sp.sel.distinct = false
    sp.sel.desc = []
    sp.hashed = true
    sp.keyOuter = replace(mut &hk.outer, [])
    sp.keyText = texts
}

// A hash key's part: numbers by value (2 = 2.0), else as the value.
fn keyPart(b: mut &StrBuf, v: &Val) {
    match v {
        Val.Int(_) {}
        Val.Num(_) {}
        else {
            encIdxPart(b, v)
            return
        }
    }
    match asNum(v) {
        Some(d) {
            b.addByte(3)
            encNum(b, &d)
        }
        None { encIdxPart(b, v) }
    }
}

// Runs a hashed subquery once: its keys (a NULL key matches nothing), and
// for IN its values per key.
fn runHashed(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
             i: int): Result[SubRes, DbErr] {
    let res = try runChild(st, txn, &sp.sel, params, -1, parent, i)
    var out = emptyRes()
    out.rows = len(res.rows)
    let nk = len(sp.keyOuter)
    if sp.use == lexdb_sql.SUB_SCALAR {
        for r in res.rows {
            var gk = newStrBuf()
            var nul = false
            for j in 0..nk {
                if isNull(&r[j]) { nul = true }
                keyPart(mut &gk, &r[j])
            }
            if nul { continue }
            out.groups.put(gk.toStr(), len(out.data))
            append(mut &out.data, [r[nk]])
        }
        // a key with no rows: the aggregate over none (count 0, sum NULL)
        var vals: []Val = []
        for spec in sp.sel.specs {
            let a = newAccs(1)
            append(mut &vals, try finish(&spec, &a[0]))
        }
        let noRow: []Val = array(len(sp.sel.q.cols), Val.Null)
        let noSubs: []SubRes = []
        let env = Env{cols: &sp.sel.q.cols, row: &noRow, aggs: &vals, params: params, subs: &noSubs, cur: &noRow}
        out.val = try eval(&sp.sel.exprs[nk], &env)
        return Ok(out)
    }
    for r in res.rows {
        var gk = newStrBuf()
        var nul = false
        for j in 0..nk {
            if isNull(&r[j]) { nul = true }
            keyPart(mut &gk, &r[j])
        }
        if nul { continue }
        let g = gk.toStr()
        var f = 1
        if sp.use == lexdb_sql.SUB_IN {
            if isNull(&r[nk]) {
                f = 3
            } else {
                var mk = newStrBuf()
                mk.add(g)
                keyPart(mut &mk, &r[nk])
                out.set.put(mk.toStr(), 1)
            }
        }
        match out.groups.get(&g) {
            Some(old) { if old < f { out.groups.put(g, f) } }
            None { out.groups.put(g, f) }
        }
    }
    return Ok(out)
}

// A hashed subquery's value for an outer row: its key's values, IN's x.
fn hashValue(n: &str, r: &SubRes, keyVals: &[]Val, x: &Val): Val {
    var gk = newStrBuf()
    var miss = false
    for v in keyVals {
        if isNull(&v) { miss = true }               // inner = NULL: no row
        keyPart(mut &gk, &v)
    }
    if n == "#sub" {
        // a scalar: its group's value, or the aggregate over no rows
        if miss { return r.val }
        match r.groups.get(&gk.toStr()) {
            Some(i) { return r.data[i][0] }
            None { return r.val }
        }
    }
    var f = 0
    if !miss {
        match r.groups.get(&gk.toStr()) {
            Some(v) { f = v }
            None {}
        }
    }
    if f == 0 { return Val.Bool(false) }            // no rows for it
    if n == "#exists" { return Val.Bool(true) }
    if isNull(x) { return Val.Null }
    var mk = newStrBuf()
    mk.add(gk.toStr())
    keyPart(mut &mk, x)
    if r.set.get(&mk.toStr()).isSome() { return Val.Bool(true) }
    return if f == 3 { Val.Null } else { Val.Bool(false) }
}

fn isSubCall(n: &str): bool { return n == "#sub" || n == "#exists" || n == "#in" }

// A resolved subquery call's arguments before its refs: number, type, name
// (and IN's value).
fn subFixed(n: &str): int { return if n == "#in" { 4 } else { 3 } }

fn litInt(x: &Expr): int {
    match x {
        Expr.Lit(v) { match v { Val.Int(n) { return n } else {} } }
        else {}
    }
    return -1
}

// Has a correlated subquery: one run per row.
fn hasCorr(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasCorr(&a) }
        Expr.Bin(_, a, b) { return hasCorr(&a) || hasCorr(&b) }
        Expr.IsNull(a, _) { return hasCorr(&a) }
        Expr.Cast(a, _) { return hasCorr(&a) }
        Expr.Call(n, args, _) {
            if isSubCall(&n) && len(args) > subFixed(&n) { return true }
            for a in args { if hasCorr(&a) { return true } }
            return false
        }
        else { return false }
    }
}

fn subsLast(cs: []Expr): []Expr {
    var all = cs
    var first: []Expr = []
    var last: []Expr = []
    for i in 0..len(all) {
        let c = replace(mut &all[i], Expr.Lit(Val.Null))
        if hasCorr(&c) { append(mut &last, c) } else { append(mut &first, c) }
    }
    for i in 0..len(last) { append(mut &first, replace(mut &last[i], Expr.Lit(Val.Null))) }
    return first
}

// An IN set's key: numbers by value (1 = 1.0), else as the value.
fn setKey(v: &Val, numeric: bool): Option[str] {
    var kb = newStrBuf()
    if numeric {
        match asNum(v) {
            Some(d) {
                encNum(mut &kb, &d)
                return Some(kb.toStr())
            }
            None { return None }
        }
    }
    encIdxPart(mut &kb, v)
    return Some(kb.toStr())
}

// x IN (subquery): true if one equals x; else NULL if x or one is NULL.
fn inProbe(r: &SubRes, x: &Val): Val {
    if r.rows == 0 { return Val.Bool(false) }
    if isNull(x) { return Val.Null }
    match setKey(x, r.numeric) {
        Some(k) { if r.set.get(&k).isSome() { return Val.Bool(true) } }
        None {}
    }
    return if r.hasNull { Val.Null } else { Val.Bool(false) }
}

fn subValue(n: &str, r: &SubRes, x: &Val): Val {
    if n == "#exists" { return Val.Bool(r.rows > 0) }
    if n == "#in" { return inProbe(r, x) }
    return r.val
}

fn addCounts(a: mut &[]Counts, b: &[]Counts) {
    if len(a) == 0 {
        for c in b { append(a, c) }
        return
    }
    for i in 0..len(b) {
        a[i].starts += b[i].starts
        a[i].read += b[i].read
        a[i].joined += b[i].joined
        a[i].nulls += b[i].nulls
        a[i].built += b[i].built
        a[i].kept += b[i].kept
        a[i].unmatched += b[i].unmatched
    }
}

fn mergeStats(a: mut &[]SubStat, b: &[]SubStat) {
    for i in 0..len(b) {
        if i >= len(a) { append(a, SubStat{runs: 0, hits: 0, cnt: [], inner: []}) }
        a[i].runs += b[i].runs
        a[i].hits += b[i].hits
        addCounts(mut &a[i].cnt, &b[i].cnt)
        mergeStats(mut &a[i].inner, &b[i].inner)
    }
}

// A subquery in FROM: its rows.
fn runFrom(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
           i: int): Result[SubRes, DbErr] {
    var out = emptyRes()
    // a CTE: run once in the statement, its rows kept for its other uses
    let key = "c" + sp.cte.toStr()
    if sp.cte >= 0 {
        let at = cacheAt(&parent.cache, &key)
        if at >= 0 {
            out.data = copyRows(&parent.cache.rows[at])
            out.rows = len(out.data)
            parent.stats[i].hits += 1
            return Ok(out)
        }
    }
    var res = try runChild(st, txn, &sp.sel, params, -1, parent, i)
    out.rows = len(res.rows)
    out.data = replace(mut &res.rows, [])
    if sp.cte >= 0 {
        try parent.hold(rowsBytes(&out.data))
        cachePut(mut &parent.cache, key, copyRows(&out.data))
    }
    return Ok(out)
}

// Rows the statement's queries share while it runs: a CTE's ("c" and its
// number), a recursive CTE's working table ("w"). A query's run hands them
// to the runs inside it and takes them back.
type CteCache = record { index: Map[str, int]; rows: [][][]Val }

fn newCache(): CteCache { return CteCache{index: newMap(), rows: []} }

fn cacheAt(c: &CteCache, key: &str): int {
    match c.index.get(key) {
        Some(i) { return i }
        None { return -1 }
    }
}

fn cachePut(c: mut &CteCache, key: str, rows: [][]Val) {
    let at = cacheAt(c, &key)
    if at >= 0 {
        c.rows[at] = rows
        return
    }
    c.index.put(key, len(c.rows))
    append(mut &c.rows, rows)
}

fn copyRows(rows: &[][]Val): [][]Val {
    var out: [][]Val = []
    for r in rows { append(mut &out, copyRow(&r)) }
    return out
}

// Runs a planned query inside another's run: the shared rows go with it,
// and its counts add to the parent's slot i (EXPLAIN ANALYZE).
fn runChild(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int, parent: mut &Run,
            i: int): Result[Res, DbErr] {
    var rs = newRun(&sel.q)
    rs.maxRounds = parent.maxRounds
    rs.maxHeld = parent.maxHeld
    rs.deadline = parent.deadline
    rs.held = parent.held
    rs.ticks = parent.ticks
    rs.turnEnd = parent.turnEnd
    rs.cache = replace(mut &parent.cache, newCache())
    let r = execSel(st, txn, sel, params, cap, mut &rs)
    parent.cache = replace(mut &rs.cache, newCache())
    parent.ticks = rs.ticks
    parent.turnEnd = rs.turnEnd
    while len(parent.stats) <= i { append(mut &parent.stats, SubStat{runs: 0, hits: 0, cnt: [], inner: []}) }
    parent.stats[i].runs += 1
    addCounts(mut &parent.stats[i].cnt, &rs.cnt)
    mergeStats(mut &parent.stats[i].inner, &rs.stats)
    return r
}

// A column type for a result's OID.
fn oidType(oid: int): lexdb_sql.TypeName {
    if lexdb_sql.elemOid(oid) > 0 { return lexdb_sql.TypeName{kind: lexdb_sql.K_ARRAY, oid: oid, prec: 0, scale: 0, len: 0} }
    var kind = lexdb_sql.K_TEXT
    var o = oid
    if oid == lexdb_sql.OID_BOOL { kind = lexdb_sql.K_BOOL }
    if oid == lexdb_sql.OID_INT2 || oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT8 { kind = lexdb_sql.K_INT }
    if oid == lexdb_sql.OID_NUMERIC { kind = lexdb_sql.K_NUM }
    if kind == lexdb_sql.K_TEXT && oid != lexdb_sql.OID_VARCHAR { o = lexdb_sql.OID_TEXT }
    return lexdb_sql.TypeName{kind: kind, oid: o, prec: 0, scale: 0, len: 0}
}

// Runs a subquery: EXISTS stops at its first row, a scalar at its second.
fn runSub(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
          i: int): Result[SubRes, DbErr] {
    let cap = if sp.use == lexdb_sql.SUB_EXISTS { 1 } else if sp.use == lexdb_sql.SUB_SCALAR { 2 } else { -1 }
    let res = try runChild(st, txn, &sp.sel, params, cap, parent, i)
    var out = emptyRes()
    out.rows = len(res.rows)
    if sp.use == lexdb_sql.SUB_SCALAR {
        if len(res.rows) > 1 { return Err(e("21000", "more than one row returned by a subquery used as an expression")) }
        if len(res.rows) == 1 { out.val = res.rows[0][0] }
    } else if sp.use == lexdb_sql.SUB_IN {
        for r in res.rows {
            match r[0] {
                Val.Int(_) { out.numeric = true }
                Val.Num(_) { out.numeric = true }
                else {}
            }
        }
        for r in res.rows {
            if isNull(&r[0]) {
                out.hasNull = true
                continue
            }
            match setKey(&r[0], out.numeric) {
                Some(k) {
                    if out.set.get(&k).isNone() && len(out.vals) <= IN_LOOKUP_MAX { append(mut &out.vals, r[0]) }
                    out.set.put(k, 1)
                }
                None {}
            }
        }
    }
    return Ok(out)
}

// The values of the correlated subqueries in x for env's row, into cur.
fn fillCur(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, x: &Expr, env: &Env, rs: mut &Run,
           cur: mut &[]Val): Result[Unit, DbErr] {
    match x {
        Expr.Unary(_, a) { return fillCur(st, txn, q, &a, env, rs, cur) }
        Expr.Bin(_, a, b) {
            try fillCur(st, txn, q, &a, env, rs, cur)
            return fillCur(st, txn, q, &b, env, rs, cur)
        }
        Expr.IsNull(a, _) { return fillCur(st, txn, q, &a, env, rs, cur) }
        Expr.Cast(a, _) { return fillCur(st, txn, q, &a, env, rs, cur) }
        Expr.Call(n, args, _) {
            let fixed = subFixed(&n)
            if !(isSubCall(&n) && len(args) > fixed) {
                for a in args { try fillCur(st, txn, q, &a, env, rs, cur) }
                return Ok(Unit{})
            }
            let i = litInt(&args[0])
            var xv = Val.Null
            if n == "#in" {
                try fillCur(st, txn, q, &args[3], env, rs, cur)
                let env2 = Env{cols: env.cols, row: env.row, aggs: env.aggs, params: env.params, subs: env.subs, cur: cur}
                xv = try eval(&args[3], &env2)
            }
            var refVals: []Val = []
            for j in fixed..len(args) { append(mut &refVals, try eval(&args[j], env)) }
            if q.subs[i].hashed {
                // its key's outer sides, over the statement's parameters and its refs' values
                var ps: []Val = []
                for j in 0..q.base { append(mut &ps, env.params[j]) }
                for v in refVals { append(mut &ps, v) }
                let noCols: []lexdb_sql.ColDef = []
                let noRow: []Val = []
                let kenv = Env{cols: &noCols, row: &noRow, aggs: &noRow, params: &ps, subs: env.subs, cur: &noRow}
                var kv: []Val = []
                for ko in q.subs[i].keyOuter { append(mut &kv, try eval(&ko, &kenv)) }
                rs.stats[i].hits += 1
                cur[i] = hashValue(&n, &env.subs[i], &kv, &xv)
                return Ok(Unit{})
            }
            let key = valsKey(&refVals)
            var at = -1
            match rs.memo[i].get(&key) {
                Some(k) { at = k }
                None {}
            }
            if at >= 0 {
                rs.stats[i].hits += 1
                cur[i] = subValue(&n, &rs.memoRes[i][at], &xv)
                return Ok(Unit{})
            }
            var ps: []Val = []
            for j in 0..q.base { append(mut &ps, env.params[j]) }
            for v in refVals { append(mut &ps, v) }
            let r = try runSub(st, txn, &q.subs[i], &ps, rs, i)
            cur[i] = subValue(&n, &r, &xv)
            if len(rs.memoRes[i]) < MEMO_MAX {
                try rs.hold(resBytes(&r) + len(key) + 48)
                rs.memo[i].put(key, len(rs.memoRes[i]))
                append(mut &rs.memoRes[i], r)
            }
            return Ok(Unit{})
        }
        else { return Ok(Unit{}) }
    }
}

// eval, running x's correlated subqueries for env's row first.
fn evalX(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, x: &Expr, env: &Env,
         rs: mut &Run): Result[Val, DbErr] {
    if !q.corr || !hasCorr(x) { return eval(x, env) }
    var cur: []Val = array(len(q.subs), Val.Null)
    try fillCur(st, txn, q, x, env, rs, mut &cur)
    let env2 = Env{cols: env.cols, row: env.row, aggs: env.aggs, params: env.params, subs: env.subs, cur: &cur}
    return eval(x, &env2)
}

fn allTrueX(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, cs: &[]Expr, row: &[]Val,
            params: &[]Val, rs: mut &Run): Result[bool, DbErr] {
    if len(cs) == 0 { return Ok(true) }
    let noAggs: []Val = []
    let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
    for c in cs { if truth(&(try evalX(st, txn, q, &c, &env, rs))) != Some(true) { return Ok(false) } }
    return Ok(true)
}

// What a query's run reads besides its tables: per hash-joined level its
// rows, and the results of the subqueries run once.
type Mats = record {
    vrows: [][][]Val            // per level of rows held by the run: its rows
    mat: [][][]Val
    keys: []Map[str, int]       // hash key -> bucket
    buckets: [][][]int          // rows of mat
    subs: []SubRes
}

// Before a query runs: its subqueries without refs, then its hash tables.
fn prepare(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, params: &[]Val,
           rs: mut &Run): Result[Mats, DbErr] {
    var m = Mats{vrows: [], mat: [], keys: [], buckets: [], subs: []}
    for k in 0..len(q.levels) {
        append(mut &m.vrows, [])
        append(mut &m.mat, [])
        append(mut &m.keys, newMap())
        append(mut &m.buckets, [])
    }
    for i in 0..len(q.subs) {
        let sp = &q.subs[i]
        if len(sp.sel.q.refs) > 0 && !sp.hashed {
            append(mut &m.subs, emptyRes())
            continue
        }
        var ps: []Val = []
        for j in 0..q.base { append(mut &ps, params[j]) }
        if sp.use == lexdb_sql.SUB_FROM {
            append(mut &m.subs, try runFrom(st, txn, sp, &ps, rs, i))
        } else if sp.hashed {
            append(mut &m.subs, try runHashed(st, txn, sp, &ps, rs, i))
        } else {
            append(mut &m.subs, try runSub(st, txn, sp, &ps, rs, i))
        }
        try rs.hold(resBytes(&m.subs[len(m.subs) - 1]))
    }
    // the levels' rows: a subquery's (each is read by one level), a working table's
    for k in 0..len(q.levels) {
        if q.levels[k].src >= 0 { m.vrows[k] = replace(mut &m.subs[q.levels[k].src].data, []) }
        if q.levels[k].work >= 0 {
            let at = cacheAt(&rs.cache, &("w" + q.levels[k].work.toStr()))
            if at < 0 { return Err(e("XX000", "a working table is missing")) }
            m.vrows[k] = copyRows(&rs.cache.rows[at])
        }
    }
    try materialize(st, txn, q, mut &m, params, rs)
    return Ok(m)
}

// EXPLAIN's lines for a query's subqueries (with their runs, ANALYZE).
fn subLines(q: &Query, stats: &[]SubStat, out: mut &[]str) {
    let none: []Counts = []
    let noStats: []SubStat = []
    for i in 0..len(q.subs) {
        let sp = &q.subs[i]
        let what = if sp.use == lexdb_sql.SUB_EXISTS { "exists" } else if sp.use == lexdb_sql.SUB_IN { "in" } else if sp.use == lexdb_sql.SUB_FROM { "from" } else { "scalar" }
        var head = "subquery " + (i + 1).toStr() + " (" + what + "): "
        if sp.hashed {
            head = head + "hashed on " + strings.join(&sp.keyText, ", ")
        } else if len(sp.sel.q.refs) == 0 {
            head = head + "run once"
        } else {
            var rs: []str = []
            for r in sp.sel.q.refs {
                match r {
                    Expr.Col(n) { append(mut &rs, n) }
                    else { append(mut &rs, "an outer value") }
                }
            }
            head = head + "per row, on " + strings.join(&rs, ", ")
        }
        var inner: []str = []
        if i < len(stats) && sp.hashed {
            head = head + " (runs " + stats[i].runs.toStr() + ", probes " + stats[i].hits.toStr() + ")"
            inner = selLines(&sp.sel, &stats[i].cnt, &stats[i].inner)
        } else if i < len(stats) {
            head = head + " (runs " + stats[i].runs.toStr() + ", from cache " + stats[i].hits.toStr() + ")"
            inner = selLines(&sp.sel, &stats[i].cnt, &stats[i].inner)
        } else {
            inner = selLines(&sp.sel, &none, &noStats)
        }
        append(out, head)
        for l in inner { append(out, "  " + l) }
    }
}

fn pathText(lv: &Level): str {
    if lv.lateral { return "rows of subquery " + (lv.src + 1).toStr() + ", run" }
    if lv.src >= 0 { return "rows of subquery " + (lv.src + 1).toStr() }
    if lv.work >= 0 { return "rows of the working table" }
    let p = &lv.path
    let cols = keyCols(&lv.t, p.index)
    if len(p.ins) > 0 || p.inSub >= 0 {
        let many = if p.inSub >= 0 { " value of subquery " + (p.inSub + 1).toStr() } else { " of " + len(p.ins).toStr() + " values" }
        let each = " for each" + many + (if p.desc { " backward" } else { "" })
        if p.index < 0 { return "primary key " + (if len(p.eqs) + 1 == len(cols) { "lookup" } else { "range" }) + each }
        return "index " + lexdb_sql.baseName(&lv.t.indexes[p.index].name) + (if lv.t.indexes[p.index].pred.isSome() { " (filtered)" } else { "" }) +
               " lookup" + each
    }
    if p.index < 0 {
        if len(p.eqs) == len(cols) { return "primary key lookup" }
        if len(p.eqs) > 0 || len(p.rng) > 0 { return "primary key range" }
        return "full scan" + (if p.desc { " backward" } else { "" })
    }
    let what = if len(p.eqs) == len(cols) { " lookup" } else if len(p.eqs) > 0 || len(p.rng) > 0 { " range" } else { " scan" }
    let filtered = if lv.t.indexes[p.index].pred.isSome() { " (filtered)" } else { "" }
    return "index " + lexdb_sql.baseName(&lv.t.indexes[p.index].name) + filtered + what + (if p.desc { " backward" } else { "" })
}

// EXPLAIN: a line per table; with counts (EXPLAIN ANALYZE), what each did.
fn explainLines(q: &Query, cnt: &[]Counts): []str {
    var out: []str = []
    for k in 0..len(q.levels) {
        var tail = ""
        if len(cnt) > 0 {
            let c = cnt[k]
            var parts: []str = []
            if k > 0 && !q.levels[k].perRow {
                append(mut &parts, "table rows " + c.kept.toStr() + " of " + c.built.toStr() + " read")
                append(mut &parts, "probes " + c.starts.toStr())
            } else if k > 0 {
                append(mut &parts, "lookups " + c.starts.toStr())
            }
            append(mut &parts, "rows read " + c.read.toStr())
            append(mut &parts, (if k == 0 { "kept " } else { "joined " }) + c.joined.toStr())
            if keepsLeft(q.levels[k].join) { append(mut &parts, "null rows " + c.nulls.toStr()) }
            if keepsRight(q.levels[k].join) { append(mut &parts, "unmatched rows " + c.unmatched.toStr()) }
            tail = " (" + strings.join(&parts, ", ") + ")"
        }
        let lv = &q.levels[k]
        let tn = lexdb_sql.baseName(&lv.t.name)
        let name = if lv.alias == tn { tn } else { tn + " " + lv.alias }
        if k == 0 {
            append(mut &out, "scan " + name + ": " + pathText(lv) + tail)
            continue
        }
        let kind = match lv.join {
            lexdb_sql.J_LEFT { "left join " }
            lexdb_sql.J_RIGHT { "right join " }
            lexdb_sql.J_FULL { "full join " }
            lexdb_sql.J_CROSS { "cross join " }
            else { "join " }
        }
        var how = ""
        if lv.perRow {
            how = pathText(lv) + " per row"
        } else if len(lv.hashCols) > 0 {
            var cs: []str = []
            for c in lv.hashCols { append(mut &cs, lv.t.cols[c].name) }
            how = "hash on (" + strings.join(&cs, ", ") + ") over " + pathText(lv)
        } else {
            how = "loop over " + pathText(lv)
        }
        append(mut &out, kind + name + ": " + how + tail)
    }
    return out
}

fn copyRow(r: &[]Val): []Val {
    var out: []Val = []
    for v in r { append(mut &out, v) }
    return out
}

fn oneTable(name: &str): []lexdb_sql.FromItem {
    return [lexdb_sql.FromItem{table: name, alias: lexdb_sql.baseName(name), join: lexdb_sql.J_FIRST, on: None, sub: -1, cols: [], work: -1, lateral: false}]
}

// ---- indexes: an entry per row, its key the indexed columns then the
// primary key, its value the primary key.

fn idxName(name: &str): str {
    var b = newStrBuf()
    b.addByte(1)                    // the catalog's index names: no table name starts with 1
    b.add(name)
    return b.toStr()
}

fn idxPrefix(ix: &Index, row: &[]Val): str {
    var b = newStrBuf()
    for c in ix.cols { encIdxPart(mut &b, &row[c]) }
    return b.toStr()
}

fn idxEntry(ix: &Index, row: &[]Val, pk: &str): str { return idxPrefix(ix, row) + pk }

fn hasNull(ix: &Index, row: &[]Val): bool {
    for c in ix.cols { if isNull(&row[c]) { return true } }
    return false
}

// A unique index may hold a value once, NULLs aside (they are all distinct).
// The scan reads the index's leaf, so a commit that adds the same value
// meanwhile fails one of the two with 40001.
fn checkUnique(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, ix: &Index, row: &[]Val,
               pk: &str): Result[Unit, DbErr] {
    if !ix.unique || hasNull(ix, row) { return Ok(Unit{}) }
    let pre = idxPrefix(ix, row)
    var clash = false
    try st.scan(txn, ix.tree, pre, succ(&pre), fn(en: &lexdb_store.Entry): bool {
        if en.val != pk {
            clash = true
            return false
        }
        return true
    })
    if !clash { return Ok(Unit{}) }
    var names: []str = []
    var vals: []str = []
    for c in ix.cols {
        append(mut &names, t.cols[c].name)
        append(mut &vals, text(&row[c]))
    }
    return Err(e("23505", "duplicate key value violates unique constraint \"" + lexdb_sql.baseName(&ix.name) + "\": Key (" +
                 strings.join(&names, ", ") + ")=(" + strings.join(&vals, ", ") + ") already exists."))
}

// Whether a row belongs in an index: always, or its predicate is true.
fn inIndex(t: &Table, ix: &Index, row: &[]Val): Result[bool, DbErr] {
    match ix.pred {
        Some(x) {
            let noAggs: []Val = []
            let noParams: []Val = []
            let noSubs: []SubRes = []
            let env = Env{cols: &t.cols, row: row, aggs: &noAggs, params: &noParams, subs: &noSubs, cur: &noAggs}
            return Ok(truth(&(try eval(&x, &env))) == Some(true))
        }
        None { return Ok(true) }
    }
}

fn addIndexes(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, row: &[]Val, pk: &str): Result[Unit, DbErr] {
    for ix in t.indexes {
        if !(try inIndex(t, &ix, row)) { continue }
        try checkUnique(st, txn, t, &ix, row, pk)
        try txn.put(ix.tree, idxEntry(&ix, row, pk), pk)
    }
    return Ok(Unit{})
}

fn changeIndexes(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, old: &[]Val, oldPk: &str, row: &[]Val,
                 pk: &str): Result[Unit, DbErr] {
    for ix in t.indexes {
        let a = idxEntry(&ix, old, oldPk)
        let b = idxEntry(&ix, row, pk)
        let was = try inIndex(t, &ix, old)
        let now = try inIndex(t, &ix, row)
        if a == b && was == now { continue }
        if was { txn.del(ix.tree, a) }
        if now {
            try checkUnique(st, txn, t, &ix, row, pk)
            try txn.put(ix.tree, b, pk)
        }
    }
    return Ok(Unit{})
}

// ---- statements

fn createTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var key = s.table
    if lexdb_sql.isQual(&s.table) {
        let sn = lexdb_sql.schemaOf(&s.table)
        if !(try schemaExists(st, txn, &sn)) { return Err(e("3F000", "schema \"" + sn + "\" does not exist")) }
    } else {
        let sn = try createSchema(st, txn)
        if len(sn) == 0 { return Err(e("3F000", "no schema has been selected to create in")) }
        key = lexdb_sql.qual(&sn, &s.table)
    }
    let base = lexdb_sql.baseName(&key)
    let exists = (try st.get(txn, CATALOG, key)).isSome() || (try st.get(txn, CATALOG, idxName(&key))).isSome()
    if exists {
        if s.ifFlag { return Ok(tagOnly("CREATE TABLE")) }
        return Err(e("42P07", "relation \"" + base + "\" already exists"))
    }
    if len(s.pk) == 0 {
        return Err(e("42P16", "lexdb: table \"" + base + "\" needs a PRIMARY KEY"))
    }
    var t = Table{name: key, tree: 0, cols: [], pk: [], indexes: []}
    for c in s.cols {
        if colIndex(&t.cols, &c.name) >= 0 { return Err(e("42701", "column \"" + c.name + "\" specified more than once")) }
        append(mut &t.cols, lexdb_sql.ColDef{name: c.name, typ: c.typ, notNull: c.notNull})
    }
    for p in s.pk {
        let i = colIndex(&t.cols, &p)
        if i < 0 { return Err(e("42703", "column \"" + p + "\" named in key does not exist")) }
        t.cols[i].notNull = true
        append(mut &t.pk, i)
    }
    if len(t.pk) > 1 {
        for a in 0..len(t.pk) {
            for b in a + 1..len(t.pk) {
                if t.pk[a] == t.pk[b] { return Err(e("42701", "column appears twice in primary key")) }
            }
        }
    }
    t.tree = st.createTree(txn)
    try txn.put(CATALOG, key, encTable(&t))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("CREATE TABLE"))
}

fn dropTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    match try findTable(st, txn, &s.table) {
        Some(t) {
            dropOne(txn, &t)
            try bumpCatalog(st, txn)
            return Ok(tagOnly("DROP TABLE"))
        }
        None {
            if s.ifFlag { return Ok(tagOnly("DROP TABLE")) }
            return Err(e("42P01", "table \"" + lexdb_sql.shown(&s.table) + "\" does not exist"))
        }
    }
}

// A table's trees and catalog rows, its indexes' too.
fn dropOne(txn: mut &lexdb_store.Txn, t: &Table) {
    for ix in t.indexes {
        txn.dropTree(ix.tree)
        txn.del(CATALOG, idxName(&ix.name))
    }
    txn.dropTree(t.tree)
    txn.del(CATALOG, t.name)
}

fn createSchemaStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if try schemaExists(st, txn, &s.table) {
        if s.ifFlag { return Ok(tagOnly("CREATE SCHEMA")) }
        return Err(e("42P06", "schema \"" + s.table + "\" already exists"))
    }
    if strings.startsWith(s.table, "pg_") { return Err(e("42939", "unacceptable schema name \"" + s.table + "\"")) }
    try txn.put(CATALOG, schemaKey(&s.table), "")
    try bumpCatalog(st, txn)
    return Ok(tagOnly("CREATE SCHEMA"))
}

// DROP SCHEMA: refused while it holds a table, unless CASCADE, which drops
// them.
fn dropSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if s.table == "public" { return Err(e("0A000", "lexdb: schema public cannot be dropped")) }
    if !(try schemaExists(st, txn, &s.table)) {
        if s.ifFlag { return Ok(tagOnly("DROP SCHEMA")) }
        return Err(e("3F000", "schema \"" + s.table + "\" does not exist"))
    }
    let from = lexdb_sql.qual(&s.table, &"")
    var keys: []str = []
    try st.scan(txn, CATALOG, from, from + "\xff", fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key)
        return true
    })
    if len(keys) > 0 && !s.cascade {
        return Err(e("2BP01", "cannot drop schema " + s.table + " because other objects depend on it"))
    }
    for k in keys {
        match try findTable(st, txn, &k) {
            Some(t) { dropOne(txn, &t) }
            None {}
        }
    }
    txn.del(CATALOG, schemaKey(&s.table))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("DROP SCHEMA"))
}

// CREATE [UNIQUE] INDEX: a tree of its own, filled from the table's rows in
// the same transaction.
fn createIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var t = try needTable(st, txn, &s.table)
    let ixKey = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &s.index)     // in its table's schema
    let exists = (try st.get(txn, CATALOG, ixKey)).isSome() || (try st.get(txn, CATALOG, idxName(&ixKey))).isSome()
    if exists {
        if s.ifFlag { return Ok(tagOnly("CREATE INDEX")) }
        return Err(e("42P07", "relation \"" + s.index + "\" already exists"))
    }
    var cols: []int = []
    for n in s.names {
        let i = colIndex(&t.cols, &n)
        if i < 0 { return Err(e("42703", "column \"" + n + "\" does not exist")) }
        append(mut &cols, i)
    }
    var pred: Option[Expr] = None
    match s.where {
        Some(w) {
            // A filtered index: its predicate uses the table's columns, and no
            // parameters or aggregates.
            var ns: []str = []
            colNames(&w, mut &ns)
            for n in ns {
                if colIndex(&t.cols, &n) < 0 { return Err(e("42703", "column \"" + n + "\" does not exist")) }
            }
            if hasAgg(&w) { return Err(e("42803", "aggregate functions are not allowed in index predicates")) }
            if len(s.subs) > 0 { return Err(e("0A000", "cannot use subquery in index predicate")) }
            if s.params > 0 { return Err(e("42P02", "there is no parameter $1")) }
            pred = Some(clone(&w))
        }
        None {}
    }
    let ix = Index{name: ixKey, tree: st.createTree(txn), cols: cols, unique: s.unique, pred: pred}
    let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1}
    let sc = Scan{empty: false, point: false, lo: "", hi: "", whole: false}
    var cur = newCursor()
    while !cur.done {
        var batch: [][]Val = []
        try fetch(st, txn, &t, &path, &sc, mut &cur, mut &batch)
        for r in batch {
            if !(try inIndex(&t, &ix, &r)) { continue }
            let pk = keyOf(&t, &r)
            match checkUnique(st, txn, &t, &ix, &r, &pk) {
                Ok(_) {}
                Err(x) {
                    if x.state != "23505" { return Err(x) }
                    return Err(e("23505", "could not create unique index \"" + s.index + "\": a value is duplicated"))
                }
            }
            try txn.put(ix.tree, idxEntry(&ix, &r, &pk), pk)
        }
    }
    append(mut &t.indexes, ix)
    try txn.put(CATALOG, t.name, encTable(&t))
    try txn.put(CATALOG, idxName(&ixKey), t.name)
    try bumpCatalog(st, txn)
    return Ok(tagOnly("CREATE INDEX"))
}

fn dropIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let ixKey = try catKey(st, txn, &s.index, true)
    match try st.get(txn, CATALOG, idxName(&ixKey)) {
        Some(tn) {
            var t = try needTable(st, txn, &tn)
            var old = replace(mut &t.indexes, [])
            var rev: []Index = []
            while len(old) > 0 {
                let ix = pop(mut &old)
                if ix.name == ixKey { txn.dropTree(ix.tree) } else { append(mut &rev, ix) }
            }
            while len(rev) > 0 { append(mut &t.indexes, pop(mut &rev)) }
            txn.del(CATALOG, idxName(&ixKey))
            try txn.put(CATALOG, t.name, encTable(&t))
            try bumpCatalog(st, txn)
            return Ok(tagOnly("DROP INDEX"))
        }
        None {
            if s.ifFlag { return Ok(tagOnly("DROP INDEX")) }
            return Err(e("42704", "index \"" + lexdb_sql.shown(&s.index) + "\" does not exist"))
        }
    }
}

fn checkRow(t: &Table, row: &[]Val): Result[Unit, DbErr] {
    for i in 0..len(t.cols) {
        if t.cols[i].notNull && isNull(&row[i]) {
            return Err(e("23502", "null value in column \"" + t.cols[i].name + "\" of relation \"" + lexdb_sql.baseName(&t.name) +
                         "\" violates not-null constraint"))
        }
    }
    return Ok(Unit{})
}

fn dupKey(t: &Table, row: &[]Val): DbErr {
    var names: []str = []
    var vals: []str = []
    for i in t.pk {
        append(mut &names, t.cols[i].name)
        append(mut &vals, text(&row[i]))
    }
    return e("23505", "duplicate key value violates unique constraint \"" + lexdb_sql.baseName(&t.name) + "_pkey\": Key (" +
             strings.join(&names, ", ") + ")=(" + strings.join(&vals, ", ") + ") already exists.")
}

fn insert(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    let t = try needTable(st, txn, &s.table)
    var targets: []int = []
    if len(s.names) == 0 {
        for i in 0..len(t.cols) { append(mut &targets, i) }
    } else {
        for n in s.names {
            let i = colIndex(&t.cols, &n)
            if i < 0 { return Err(e("42703", "column \"" + n + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist")) }
            append(mut &targets, i)
        }
    }
    if len(s.inner) > 0 {
        // INSERT ... SELECT: the query runs to its end first, so it never
        // reads the rows it inserts
        let noTypes: []int = []
        var pc = oneShot()
        let res = try select(st, txn, &s.inner[0], params, &noTypes, lim, mut &pc)
        var count = 0
        for r in res.rows {
            try insertOne(st, txn, &t, &targets, &r)
            count += 1
        }
        return Ok(tagOnly("INSERT 0 " + count.toStr()))
    }
    // its subqueries are run first
    var sc = newScope(params, &[])
    let noFrom: []lexdb_sql.FromItem = []
    let noWhere: Option[Expr] = None
    var q = try buildQuery(st, txn, &noFrom, &noWhere, params, &s.subs, mut &sc)
    var rows: [][]Expr = []
    if len(s.subs) > 0 {
        for r in s.rows {
            var rr: []Expr = []
            for x in r { append(mut &rr, try resolve(&x, &q.cols, 0, mut &sc)) }
            append(mut &rows, rr)
        }
    }
    endScope(mut &sc, mut &q)
    var rs = newRun(&q)
    rs.limit(&lim)
    let m = try prepare(st, txn, &q, params, mut &rs)
    let noAggs: []Val = []
    let env = Env{cols: &q.cols, row: &noAggs, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
    if len(s.subs) > 0 { return insertRows(st, txn, &t, &targets, &rows, &env) }
    return insertRows(st, txn, &t, &targets, &s.rows, &env)
}

fn insertRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, targets: &[]int, rows: &[][]Expr,
              env: &Env): Result[Res, DbErr] {
    var count = 0
    for r in rows {
        var vs: []Val = []
        for x in r { append(mut &vs, try eval(&x, env)) }
        try insertOne(st, txn, t, targets, &vs)
        count += 1
    }
    return Ok(tagOnly("INSERT 0 " + count.toStr()))
}

// A row of values for the target columns (the rest NULL).
fn insertOne(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, targets: &[]int, vs: &[]Val): Result[Unit, DbErr] {
    if len(vs) > len(targets) { return Err(e("42601", "INSERT has more expressions than target columns")) }
    var row: []Val = array(len(t.cols), Val.Null)
    for k in 0..len(vs) {
        let ci = targets[k]
        row[ci] = try coerce(vs[k], &t.cols[ci].typ)
    }
    try checkRow(t, &row)
    let key = keyOf(t, &row)
    if (try st.get(txn, t.tree, key)).isSome() { return Err(dupKey(t, &row)) }
    try txn.put(t.tree, key, encRow(&row))
    try addIndexes(st, txn, t, &row, &key)
    return Ok(Unit{})
}

fn update(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    var sc = newScope(params, &[])
    var q = try buildQuery(st, txn, &oneTable(&s.table), &s.where, params, &s.subs, mut &sc)
    var targets: []int = []
    var sets: []Expr = []
    for set in s.sets {
        let i = colIndex(&q.levels[0].t.cols, &set.col)
        if i < 0 {
            return Err(e("42703", "column \"" + set.col + "\" of relation \"" + lexdb_sql.baseName(&q.levels[0].t.name) + "\" does not exist"))
        }
        append(mut &targets, i)
        append(mut &sets, try resolve(&set.expr, &q.cols, len(q.cols), mut &sc))
    }
    endScope(mut &sc, mut &q)
    let t = &q.levels[0].t
    var found: [][]Val = []
    var rs = newRun(&q)
    rs.limit(&lim)
    let m = try prepare(st, txn, &q, params, mut &rs)
    let room = rs.room()
    let max = rs.maxHeld
    var held = 0
    try runQuery(st, txn, &q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
        held += 2 * rowBytes(r)             // the row found, and its write
        if room >= 0 && held > room { return Err(memErr(max)) }
        append(mut &found, copyRow(r))
        return Ok(true)
    }, mut &rs)
    let noAggs: []Val = []
    for old in found {
        let env = Env{cols: &q.cols, row: &old, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
        var row = copyRow(&old)
        for k in 0..len(sets) {
            row[targets[k]] = try coerce(try evalX(st, txn, &q, &sets[k], &env, mut &rs), &t.cols[targets[k]].typ)
        }
        try checkRow(t, &row)
        let oldKey = keyOf(t, &old)
        let key = keyOf(t, &row)
        if key != oldKey {
            if (try st.get(txn, t.tree, key)).isSome() { return Err(dupKey(t, &row)) }
            txn.del(t.tree, oldKey)
        }
        try txn.put(t.tree, key, encRow(&row))
        try changeIndexes(st, txn, t, &old, &oldKey, &row, &key)
    }
    return Ok(tagOnly("UPDATE " + len(found).toStr()))
}

fn delete(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    var sc = newScope(params, &[])
    var q = try buildQuery(st, txn, &oneTable(&s.table), &s.where, params, &s.subs, mut &sc)
    endScope(mut &sc, mut &q)
    let t = &q.levels[0].t
    var found: [][]Val = []
    var rs = newRun(&q)
    rs.limit(&lim)
    let m = try prepare(st, txn, &q, params, mut &rs)
    let room = rs.room()
    let max = rs.maxHeld
    var held = 0
    try runQuery(st, txn, &q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
        held += 2 * rowBytes(r)             // the row found, and its write
        if room >= 0 && held > room { return Err(memErr(max)) }
        append(mut &found, copyRow(r))
        return Ok(true)
    }, mut &rs)
    for row in found {
        let key = keyOf(t, &row)
        txn.del(t.tree, key)
        for ix in t.indexes { if try inIndex(t, &ix, &row) { txn.del(ix.tree, idxEntry(&ix, &row, &key)) } }
    }
    return Ok(tagOnly("DELETE " + len(found).toStr()))
}

fn explain(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, x: &lexdb_sql.Stmt, params: &[]Val, lim: Limits,
           ptypes: &[]int): Result[Res, DbErr] {
    let s = &x.inner[0]
    var res = Res{cols: [OutCol{name: "QUERY PLAN", oid: lexdb_sql.OID_TEXT}], rows: [], tag: "EXPLAIN", hasRows: true}
    var lines: []str = []
    let none: []Counts = []
    if x.ifFlag {
        // ANALYZE: run it, counting what each table does
        let t0 = time.monotonicNs()
        let r = try selectWith(st, txn, s, params, ptypes, lim, true, mut &lines)
        let us = (time.monotonicNs() - t0) / 1000
        append(mut &lines, "result: " + len(r.rows).toStr() + " rows in " + (us / 1000).toStr() + "." +
               strings.padLeft((us % 1000).toStr(), 3, '0') + " ms")
    } else if s.kind == lexdb_sql.S_SELECT {
        var sc = newScope(params, ptypes)
        let sel = try planSelect(st, txn, s, params, mut &sc)
        let noStats: []SubStat = []
        lines = selLines(&sel, &none, &noStats)
    } else {
        var sc = newScope(params, ptypes)
        var q = try buildQuery(st, txn, &oneTable(&s.table), &s.where, params, &s.subs, mut &sc)
        endScope(mut &sc, mut &q)
        lines = explainLines(&q, &none)
        let noStats: []SubStat = []
        subLines(&q, &noStats, mut &lines)
    }
    for l in lines { append(mut &res.rows, [Val.Text(l)]) }
    return Ok(res)
}

// ---- SELECT

fn exprName(x: &Expr): str {
    match x {
        Expr.Col(n) { return colPart(&n) }
        Expr.Call(n, args, _) {
            if isSubCall(&n) && len(args) >= 3 {
                match args[2] { Expr.Lit(v) { return text(&v) } else {} }
            }
            return aggBase(&n)
        }
        Expr.Cast(a, t) {
            let inner = exprName(&a)
            return if inner == "?column?" { kindName(&t) } else { inner }
        }
        else { return "?column?" }
    }
}

// The type OID of an expression, as far as it can be told before running.
pub fn exprOid(x: &Expr, cols: &[]lexdb_sql.ColDef, ptypes: &[]int): int {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Int(n) { return if n >= -2147483648 && n <= 2147483647 { lexdb_sql.OID_INT4 } else { lexdb_sql.OID_INT8 } }
                Val.Bool(_) { return lexdb_sql.OID_BOOL }
                Val.Num(_) { return lexdb_sql.OID_NUMERIC }
                else { return lexdb_sql.OID_TEXT }
            }
        }
        Expr.Param(n) {
            if n <= len(ptypes) && ptypes[n - 1] != 0 { return ptypes[n - 1] }
            return lexdb_sql.OID_TEXT
        }
        Expr.Col(n) {
            let i = colIndex(cols, &n)
            return if i >= 0 { cols[i].typ.oid } else { lexdb_sql.OID_TEXT }
        }
        Expr.Unary(op, a) { return if op == "not" { lexdb_sql.OID_BOOL } else { exprOid(&a, cols, ptypes) } }
        Expr.Bin(op, a, b) {
            if op == "||" { return lexdb_sql.OID_TEXT }
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
                let l = exprOid(&a, cols, ptypes)
                let r = exprOid(&b, cols, ptypes)
                if l == lexdb_sql.OID_NUMERIC || r == lexdb_sql.OID_NUMERIC { return lexdb_sql.OID_NUMERIC }
                if l == lexdb_sql.OID_INT8 || r == lexdb_sql.OID_INT8 { return lexdb_sql.OID_INT8 }
                return lexdb_sql.OID_INT4
            }
            return lexdb_sql.OID_BOOL
        }
        Expr.IsNull(_, _) { return lexdb_sql.OID_BOOL }
        Expr.Cast(_, t) { return t.oid }
        Expr.Call(n, args, _) {
            if isSubCall(&n) {
                if n != "#sub" { return lexdb_sql.OID_BOOL }
                let oid = if len(args) >= 2 { litInt(&args[1]) } else { -1 }
                return if oid > 0 { oid } else { lexdb_sql.OID_TEXT }
            }
            match aggBase(&n) {
                "count" { return lexdb_sql.OID_INT8 }
                "bool_and", "bool_or", "every" { return lexdb_sql.OID_BOOL }
                "string_agg" { return lexdb_sql.OID_TEXT }
                "like", "ilike", "in", "distinct" { return lexdb_sql.OID_BOOL }
                "case" { return if len(args) > 1 { exprOid(&args[1], cols, ptypes) } else { lexdb_sql.OID_TEXT } }
                "nullif", "greatest", "least" { return if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_TEXT } }
                "strpos" { return lexdb_sql.OID_INT4 }
                "array" {
                    var el = lexdb_sql.OID_TEXT
                    for a in args {
                        let o = exprOid(&a, cols, ptypes)
                        if o != lexdb_sql.OID_TEXT { el = o }
                    }
                    let ao = lexdb_sql.arrayOid(el)
                    return if ao > 0 { ao } else { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                }
                "stddev", "stddev_samp", "stddev_pop", "variance", "var_samp", "var_pop" { return lexdb_sql.OID_NUMERIC }
                "avg" { return lexdb_sql.OID_NUMERIC }
                "sum" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_INT8 }
                    return if a == lexdb_sql.OID_NUMERIC { lexdb_sql.OID_NUMERIC } else { lexdb_sql.OID_INT8 }
                }
                "min", "max", "abs", "coalesce" {
                    return if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_TEXT }
                }
                "length", "char_length" { return lexdb_sql.OID_INT4 }
                "round" { return lexdb_sql.OID_NUMERIC }
                else { return lexdb_sql.OID_TEXT }
            }
        }
    }
}

// The output columns of a SELECT: (name, OID), and the expressions behind
// them (* expanded).
fn selectCols(s: &lexdb_sql.Stmt, cols: &[]lexdb_sql.ColDef, sc: mut &Scope, exprs: mut &[]Expr): Result[[]OutCol, DbErr] {
    var out: []OutCol = []
    for it in s.items {
        if it.star {
            if len(s.from) == 0 { return Err(e("42601", "SELECT * with no tables specified is not valid")) }
            var any = false
            for c in cols {
                if it.qual != "" && c.name[0..dotAt(&c.name)] != it.qual { continue }
                any = true
                append(mut &out, OutCol{name: colPart(&c.name), oid: c.typ.oid})
                append(exprs, Expr.Col(c.name))
            }
            if !any { return Err(e("42P01", "missing FROM-clause entry for table \"" + it.qual + "\"")) }
            continue
        }
        match it.expr {
            Some(x) {
                let r = try resolve(&x, cols, len(cols), sc)
                let name = if it.alias != "" { it.alias } else { exprName(&r) }
                let pt = ptypesOf(sc)
                append(mut &out, OutCol{name: name, oid: exprOid(&r, cols, &pt)})
                append(exprs, r)
            }
            None {}
        }
    }
    return Ok(out)
}

// ORDER BY: an output column's name, if no input column has it, else an
// expression over the input.
fn resolveOrder(o: &Expr, cols: &[]lexdb_sql.ColDef, outs: &[]OutCol, sc: mut &Scope): Result[Expr, DbErr] {
    match o {
        Expr.Col(n) {
            match resolveName(cols, len(cols), &n) {
                Ok(r) { return Ok(Expr.Col(r)) }
                Err(x) {
                    for oc in outs { if oc.name == n { return Ok(Expr.Col(n)) } }
                    return Err(x)
                }
            }
        }
        else {}
    }
    return resolve(o, cols, len(cols), sc)
}

type OutRow = record { vals: []Val; ord: []Val }

fn sortCmp(a: &Val, b: &Val): int {
    let na = isNull(a)
    let nb = isNull(b)
    if na && nb { return 0 }
    if na { return 1 }          // NULLS LAST ascending
    if nb { return -1 }
    match compare(a, b) {
        Ok(c) { return c }
        Err(_) { return kindOf(a) - kindOf(b) }
    }
}

fn evalInt(x: &Option[Expr], params: &[]Val, what: str): Result[int, DbErr] {
    match x {
        Some(v) {
            match v {
                Expr.Lit(_) {}
                else { PARAM_LOOKS += 1 }
            }
            let noCols: []lexdb_sql.ColDef = []
            let noRow: []Val = []
            let noAggs: []Val = []
            let noSubs: []SubRes = []
            let env = Env{cols: &noCols, row: &noRow, aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs}
            match try coerce(try eval(&v, &env), &lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}) {
                Val.Int(n) {
                    if n < 0 { return Err(e("2201W", what + " must not be negative")) }
                    return Ok(n)
                }
                else { return Ok(-1) }
            }
        }
        None { return Ok(-1) }
    }
}

// An ORDER BY item may name an output column by position or by its alias.
fn orderValue(o: &Expr, outs: &[]OutCol, vals: &[]Val, env: &Env): Result[Val, DbErr] {
    match o {
        Expr.Lit(v) {
            match v {
                Val.Int(n) {
                    if n < 1 || n > len(vals) { return Err(e("42P10", "ORDER BY position " + n.toStr() + " is not in select list")) }
                    return Ok(vals[n - 1])
                }
                else {}
            }
        }
        Expr.Col(n) {
            if colIndex(&env.cols, &n) < 0 {
                for i in 0..len(outs) { if outs[i].name == n { return Ok(vals[i]) } }
            }
        }
        else {}
    }
    return eval(o, env)
}

fn select(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
          lim: Limits, pc: mut &PlanCache): Result[Res, DbErr] {
    // A prepared statement's plan, kept while the schema the transaction
    // sees is the same and the plan looked at no parameter's value.
    var ver = try catVersion(st, txn)
    if len(txn.path) > 0 { ver = ver + "|" + strings.join(&txn.path, ",") }      // its names resolved by the path
    if len(pc.sels) == 0 || pc.ver != ver {
        pc.sels = []
        var sc = newScope(params, ptypes)
        let looks = PARAM_LOOKS
        let sel = try planSelect(st, txn, s, params, mut &sc)
        if PARAM_LOOKS != looks || !pc.keep { return runSel(st, txn, &sel, params, lim) }
        append(mut &pc.sels, sel)
        pc.ver = ver
        pc.plans += 1
    }
    return runSel(st, txn, &pc.sels[0], params, lim)
}

fn runSel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    var rs = newRun(&sel.q)
    rs.limit(&lim)
    return execSel(st, txn, sel, params, -1, mut &rs)
}

// A prepared statement's plan (select), with the catalog version it was
// made for. keep false: never kept (a statement run once).
pub type PlanCache = record { sels: []Sel; ver: str; keep: bool; pub plans: int }

pub fn newPlanCache(): PlanCache { return PlanCache{sels: [], ver: "", keep: true, plans: 0} }

pub fn oneShot(): PlanCache { return PlanCache{sels: [], ver: "", keep: false, plans: 0} }

// ---- aggregates: one accumulator per call and group, so a grouped
// query holds its groups, not its rows

// An aggregate call of the query: its function, arguments, modifiers.
type AggSpec = record {
    fname: str
    args: []Expr
    star: bool
    distinct: bool
    filter: Option[Expr]
    order: []Expr           // ORDER BY in the call (string_agg's result depends on it; the others' not)
    dirs: str               // per key: a, A (NULLs first), d, D (NULLs last), as the parser gives them
    text: str               // to share one accumulator between equal calls
}

type Acc = record {
    n: int
    val: Val                // min, max, bool_and, bool_or
    sum: Val                // sum, avg; the variances: the sum ...
    sumsq: Val              // ... and the sum of squares
    parts: []str            // string_agg
    seps: []Val             // ... with ORDER BY: each value's separator
    ords: [][]Val           // ... and its keys (sorted when it finishes)
    seen: Map[str, int]     // DISTINCT
}

fn newAccs(n: int): []Acc {
    var out: []Acc = []
    for i in 0..n { append(mut &out, Acc{n: 0, val: Val.Null, sum: Val.Null, sumsq: Val.Null, parts: [], seps: [], ords: [], seen: newMap()}) }
    return out
}

fn slotRef(i: int): Expr { return Expr.Call("#agg", [Expr.Lit(Val.Int(i))], false) }

// x with each aggregate call replaced by its slot, the calls added to specs.
fn collectAggs(x: &Expr, specs: mut &[]AggSpec): Result[Expr, DbErr] {
    match x {
        Expr.Call(name, args, star) {
            if !isAgg(&name) {
                var out: []Expr = []
                for a in args { append(mut &out, try collectAggs(&a, specs)) }
                return Ok(Expr.Call(name, out, star))
            }
            let base = aggBase(&name)
            var aargs = cloneAll(&args)
            var filter: Option[Expr] = None
            if strings.contains(name, " filter") { filter = Some(pop(mut &aargs)) }
            var order: []Expr = []
            var dirs = ""
            let oi = strings.indexOf(name, " order:", 0)
            if oi >= 0 {
                let rest = name[oi + 7..len(name)]
                let sp = strings.indexOf(rest, " ", 0)
                dirs = if sp < 0 { rest } else { rest[0..sp] }
                var rev: []Expr = []
                for k in 0..len(dirs) { append(mut &rev, pop(mut &aargs)) }
                while len(rev) > 0 { append(mut &order, pop(mut &rev)) }
                for o in order { if hasAgg(&o) { return Err(e("42803", "aggregate function calls cannot be nested")) } }
            }
            for a in aargs { if hasAgg(&a) { return Err(e("42803", "aggregate function calls cannot be nested")) } }
            match filter {
                Some(f) { if hasAgg(&f) { return Err(e("42803", "aggregate functions are not allowed in FILTER")) } }
                None {}
            }
            let want = if base == "string_agg" { 2 } else { 1 }
            if star && base != "count" { return Err(e("42809", base + "(*) is not an aggregate that takes *")) }
            if !star && len(aargs) != want {
                return Err(e("42883", "function " + base + " takes " + want.toStr() + " argument" + (if want > 1 { "s" } else { "" })))
            }
            let text = lexdb_sql.exprText(x)
            for i in 0..len(specs) { if specs[i].text == text { return Ok(slotRef(i)) } }
            append(specs, AggSpec{fname: base, args: aargs, star: star, distinct: strings.contains(name, " distinct"),
                                  filter: filter, order: order, dirs: dirs, text: text})
            return Ok(slotRef(len(specs) - 1))
        }
        Expr.Unary(op, a) { return Ok(Expr.Unary(op, try collectAggs(&a, specs))) }
        Expr.Bin(op, a, b) {
            let l = try collectAggs(&a, specs)
            let r = try collectAggs(&b, specs)
            return Ok(Expr.Bin(op, l, r))
        }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try collectAggs(&a, specs), neg)) }
        Expr.Cast(a, t) { return Ok(Expr.Cast(try collectAggs(&a, specs), t)) }
        else { return Ok(clone(x)) }
    }
}

fn numOf(v: &Val, fname: &str): Result[Val, DbErr] {
    match asNum(v) {
        Some(d) { return Ok(Val.Num(d)) }
        None { return Err(e("42883", "function " + fname + " needs a number")) }
    }
}

// A grouped query's groups so far: per group its first row (for grouped
// columns) and its accumulators.
type Groups = record {
    index: Map[str, int]        // GROUP BY key -> group
    firsts: [][]Val
    accs: [][]Acc
}

// Adds a row to its group (env: the row, and its correlated subqueries'
// values if any).
fn addToGroup(sel: &Sel, gs: mut &Groups, r: &[]Val, env: &Env, held: mut &int, room: int, rs0max: int): Result[Unit, DbErr] {
    var g = 0
    if len(sel.groupBy) > 0 {
        var kb = newStrBuf()
        for x in sel.groupBy { encIdxPart(mut &kb, &(try eval(&x, env))) }
        let k = kb.toStr()
        match gs.index.get(&k) {
            Some(i) { g = i }
            None {
                g = len(gs.firsts)
                held += rowBytes(r) + 64 * (len(sel.specs) + 1) + len(k)
                if room >= 0 && held > room { return Err(memErr(rs0max)) }
                gs.index.put(k, g)
                append(mut &gs.firsts, copyRow(r))
                append(mut &gs.accs, newAccs(len(sel.specs)))
            }
        }
    } else if len(gs.firsts) == 0 {
        append(mut &gs.firsts, copyRow(r))
        append(mut &gs.accs, newAccs(len(sel.specs)))
    }
    for i in 0..len(sel.specs) { try accumulate(&sel.specs[i], mut &gs.accs[g][i], env) }
    return Ok(Unit{})
}

// A correlated subquery in a GROUP BY key or an aggregate's argument or
// FILTER.
fn groupCorr(sel: &Sel): bool {
    for g in sel.groupBy { if hasCorr(&g) { return true } }
    for sp in sel.specs {
        for a in sp.args { if hasCorr(&a) { return true } }
        for o in sp.order { if hasCorr(&o) { return true } }
        match sp.filter {
            Some(f) { if hasCorr(&f) { return true } }
            None {}
        }
    }
    return false
}

// Adds one row (env) to an accumulator.
fn accumulate(sp: &AggSpec, acc: mut &Acc, env: &Env): Result[Unit, DbErr] {
    match sp.filter {
        Some(f) { if truth(&(try eval(&f, env))) != Some(true) { return Ok(Unit{}) } }
        None {}
    }
    if sp.star {
        acc.n += 1
        return Ok(Unit{})
    }
    let v = try eval(&sp.args[0], env)
    if isNull(&v) { return Ok(Unit{}) }
    if sp.distinct {
        var kb = newStrBuf()
        encIdxPart(mut &kb, &v)
        let k = kb.toStr()
        if acc.seen.get(&k).isSome() { return Ok(Unit{}) }
        acc.seen.put(k, 1)
    }
    let f = sp.fname
    if f == "sum" || f == "avg" {
        acc.sum = if isNull(&acc.sum) { v } else { try arith(&"+", &acc.sum, &v) }
    } else if f == "min" {
        if isNull(&acc.val) || (try compare(&v, &acc.val)) < 0 { acc.val = v }
    } else if f == "max" {
        if isNull(&acc.val) || (try compare(&v, &acc.val)) > 0 { acc.val = v }
    } else if f == "bool_and" || f == "every" || f == "bool_or" {
        let b = match truth(&v) {
            Some(x) { x }
            None { return Err(e("42883", "function " + f + " needs a boolean")) }
        }
        let prev = match acc.val { Val.Bool(x) { x } else { f != "bool_or" } }
        acc.val = Val.Bool(if f == "bool_or" { prev || b } else { prev && b })
    } else if f == "string_agg" {
        let sep = try eval(&sp.args[1], env)
        if len(sp.order) > 0 {
            var ks: []Val = []
            for o in sp.order { append(mut &ks, try eval(&o, env)) }
            append(mut &acc.parts, text(&v))
            append(mut &acc.seps, sep)
            append(mut &acc.ords, ks)
        } else {
            if acc.n > 0 && !isNull(&sep) { append(mut &acc.parts, text(&sep)) }
            append(mut &acc.parts, text(&v))
        }
    } else if f != "count" {
        // the variances and standard deviations
        let x = try numOf(&v, &f)
        let sq = try arith(&"*", &x, &x)
        acc.sum = if isNull(&acc.sum) { x } else { try arith(&"+", &acc.sum, &x) }
        acc.sumsq = if isNull(&acc.sumsq) { sq } else { try arith(&"+", &acc.sumsq, &sq) }
    }
    acc.n += 1
    return Ok(Unit{})
}

// The square root at 16 places (Newton's method at 20).
fn sqrtNum(v: &Val): Result[Val, DbErr] {
    let a = asNum(v).unwrap()
    if a.isNeg() { return Err(e("2201F", "cannot take square root of a negative number")) }
    if a.isZero() { return Ok(Val.Num(a)) }
    var x = if (try compare(v, &Val.Int(1))) > 0 { a } else { Decimal.fromInt(1) }
    let two = Decimal.fromInt(2)
    for i in 0..200 {
        let q = match a.div(x, 20, Rounding.HALF_EVEN) { Ok(d) { d } Err(_) { return Err(decErr()) } }
        let next = match q.addExact(x) { Ok(d) { d } Err(_) { return Err(decErr()) } }
        let half = match next.div(two, 20, Rounding.HALF_EVEN) { Ok(d) { d } Err(_) { return Err(decErr()) } }
        if half.canonical() == x.canonical() { break }
        x = half
    }
    match x.quantize(16, Rounding.HALF_EVEN) {
        Ok(d) { return Ok(Val.Num(d)) }
        Err(_) { return Err(decErr()) }
    }
}

// string_agg with ORDER BY: its values sorted by their keys (stable: equal
// keys keep their order), each after its own separator but the first.
fn orderedParts(sp: &AggSpec, acc: &Acc): Result[str, DbErr] {
    var idx: []int = []
    for i in 0..len(acc.parts) { append(mut &idx, i) }
    var bad = false
    collections.sortBy(mut &idx, fn(a: &int, b: &int): int {
        for k in 0..len(sp.dirs) {
            let d = sp.dirs[k]
            let desc = d == 'd' || d == 'D'
            let nullsFirst = d == 'A' || d == 'd'
            let x = &acc.ords[a][k]
            let y = &acc.ords[b][k]
            let xn = isNull(x)
            let yn = isNull(y)
            if xn || yn {
                if xn && yn { continue }
                return if xn == nullsFirst { -1 } else { 1 }
            }
            let r = compare(x, y)
            if r.isErr() { bad = true }
            let c = r.unwrapOr(0)
            if c != 0 { return if desc { -c } else { c } }
        }
        return a - b
    })
    if bad { return Err(e("42804", "string_agg: its ORDER BY keys cannot be compared")) }
    var b = newStrBuf()
    for j in 0..len(idx) {
        let i = idx[j]
        if j > 0 && !isNull(&acc.seps[i]) { b.add(text(&acc.seps[i])) }
        b.add(acc.parts[i])
    }
    return Ok(b.toStr())
}

// An accumulator's result.
fn finish(sp: &AggSpec, acc: &Acc): Result[Val, DbErr] {
    let f = sp.fname
    if f == "count" { return Ok(Val.Int(acc.n)) }
    if acc.n == 0 { return Ok(Val.Null) }
    if f == "sum" { return Ok(acc.sum) }
    if f == "avg" { return arith(&"/", &(try numOf(&acc.sum, &f)), &Val.Num(Decimal.fromInt(acc.n))) }
    if f == "string_agg" && len(sp.order) > 0 { return Ok(Val.Text(try orderedParts(sp, acc))) }
    if f == "string_agg" { return Ok(Val.Text(strings.join(&acc.parts, ""))) }
    if f == "min" || f == "max" || f == "bool_and" || f == "bool_or" || f == "every" { return Ok(acc.val) }
    // variance: (n * sum of squares - sum * sum) / (n * (n - 1)), or n * n for the population's
    let pop = f == "var_pop" || f == "stddev_pop"
    if !pop && acc.n < 2 { return Ok(Val.Null) }
    let n = Val.Int(acc.n)
    let num = try arith(&"-", &(try arith(&"*", &n, &acc.sumsq)), &(try arith(&"*", &acc.sum, &acc.sum)))
    let den = Val.Int(if pop { acc.n * acc.n } else { acc.n * (acc.n - 1) })
    let vr = try arith(&"/", &(try numOf(&num, &f)), &(try numOf(&den, &f)))
    if f == "variance" || f == "var_samp" || f == "var_pop" { return Ok(vr) }
    return sqrtNum(&vr)
}

// A grouped query's output may use a column only inside an aggregate, as
// part of a GROUP BY expression, or from a table whose whole primary key
// is grouped (its other columns follow from it).
fn checkGrouped(x: &Expr, gtexts: &[]str, okLevels: &[]bool, q: &Query): Result[Unit, DbErr] {
    let t = lexdb_sql.exprText(x)
    for g in gtexts { if g == t { return Ok(Unit{}) } }
    match x {
        Expr.Col(n) {
            let i = colIndex(&q.cols, &n)
            if i < 0 { return Ok(Unit{}) }      // an output column's alias (ORDER BY)
            let l = q.levelOf(&n)
            if l >= 0 && okLevels[l] { return Ok(Unit{}) }
            return Err(e("42803", "column \"" + n + "\" must appear in the GROUP BY clause or be used in an aggregate function"))
        }
        Expr.Call(name, args, _) {
            if name == "#agg" { return Ok(Unit{}) }
            for a in args { try checkGrouped(&a, gtexts, okLevels, q) }
        }
        Expr.Unary(_, a) { try checkGrouped(&a, gtexts, okLevels, q) }
        Expr.Bin(_, a, b) {
            try checkGrouped(&a, gtexts, okLevels, q)
            try checkGrouped(&b, gtexts, okLevels, q)
        }
        Expr.IsNull(a, _) { try checkGrouped(&a, gtexts, okLevels, q) }
        Expr.Cast(a, _) { try checkGrouped(&a, gtexts, okLevels, q) }
        else {}
    }
    return Ok(Unit{})
}

// GROUP BY: an input column or expression; else an output column's
// position or name, meaning its expression.
fn resolveGroup(g: &Expr, cols: &[]lexdb_sql.ColDef, outs: &[]OutCol, exprs: &[]Expr, sc: mut &Scope): Result[Expr, DbErr] {
    match g {
        Expr.Lit(v) {
            match v {
                Val.Int(n) {
                    if n < 1 || n > len(exprs) { return Err(e("42P10", "GROUP BY position " + n.toStr() + " is not in select list")) }
                    return Ok(clone(&exprs[n - 1]))
                }
                else {}
            }
        }
        Expr.Col(n) {
            match resolveName(cols, len(cols), &n) {
                Ok(r) { return Ok(Expr.Col(r)) }
                Err(x) {
                    for i in 0..len(outs) { if outs[i].name == n { return Ok(clone(&exprs[i])) } }
                    return Err(x)
                }
            }
        }
        else {}
    }
    return resolve(g, cols, len(cols), sc)
}

fn valsKey(vs: &[]Val): str {
    var kb = newStrBuf()
    for v in vs { encIdxPart(mut &kb, &v) }
    return kb.toStr()
}

// A SELECT, planned: its query, its output, and how its order is had.
type Sel = record {
    q: Query
    exprs: []Expr
    outs: []OutCol
    groupBy: []Expr
    order: []Expr
    aggQ: bool
    sort: bool              // ORDER BY sorts; false: the scan gives the order
    first: int              // MIN or MAX served by the scan's order: stop at the first non-NULL value of this column
    limit: int
    offset: int
    having: Option[Expr]
    specs: []AggSpec        // the aggregate calls; exprs, having and order use their slots
    distinct: bool
    desc: []bool            // per ORDER BY item
    parts: []Sel            // UNION, INTERSECT, EXCEPT: its two queries (q has no tables, refs theirs)
    setop: int
    setAll: bool
    split: int              // refs: the first query's, then the second's
    rec: int                // a recursive CTE: its number; -1
    srf: str                // a function in FROM: its name; exprs are its arguments, outs its columns (9.27)
    ordin: bool             // ... WITH ORDINALITY
}

// The column of level 0 an expression is, else -1.
fn (q: &Query) firstCol(x: &Expr): int {
    match x {
        Expr.Col(n) {
            if q.levelOf(&n) == 0 { return colIndex(&q.cols, &n) }
        }
        else {}
    }
    return -1
}

// The columns of the first table an ORDER BY sorts by, all one way: the
// direction (0 up, 1 down), or -1 when it sorts by anything else.
fn orderCols(q: &Query, order: &[]Expr, items: &[]lexdb_sql.OrderItem, exprs: &[]Expr, outs: &[]OutCol,
             cols: mut &[]int): int {
    if len(order) == 0 || len(q.levels) == 0 { return -1 }
    for i in 0..len(order) {
        if items[i].desc != items[0].desc { return -1 }
        var c = q.firstCol(&order[i])
        match order[i] {
            Expr.Lit(v) {
                match v {
                    Val.Int(n) { if n >= 1 && n <= len(exprs) { c = q.firstCol(&exprs[n - 1]) } }
                    else {}
                }
            }
            Expr.Col(n) {
                if c < 0 {
                    for j in 0..len(outs) { if outs[j].name == n { c = q.firstCol(&exprs[j]) } }
                }
            }
            else {}
        }
        if c < 0 { return -1 }
        append(cols, c)
    }
    return if items[0].desc { 1 } else { 0 }
}

// Whether a path of the first table gives its rows in the order of cols:
// they follow its key (an index's key ends with the primary key) after its
// equalities, skipping columns held equal.
fn servesOrder(t: &Table, p: &Path, cols: &[]int): bool {
    if p.inSub >= 0 { return false }        // past IN_LOOKUP_MAX it reads in primary key order
    var key = keyCols(t, p.index)
    if p.index >= 0 { for c in t.pk { append(mut &key, c) } }
    if p.index < 0 && len(p.eqs) == len(t.pk) { return true }     // one row
    var j = len(p.eqs)
    for c in cols {
        if j < len(key) && key[j] == c {
            j += 1
            continue
        }
        var held = false
        for x in 0..len(p.eqs) { if key[x] == c { held = true } }
        if !held { return false }
    }
    return true
}

// A full scan of the primary key or an index that gives the order, if one does.
fn orderedScan(q: &Query, cols: &[]int, params: &[]Val): Option[int] {
    let t = &q.levels[0].t
    for c0 in 0..len(t.indexes) + 1 {
        if !q.usable(0, c0 - 1, &q.levels[0].cond, params) { continue }
        let p = Path{index: c0 - 1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1}
        if servesOrder(t, &p, cols) { return Some(c0 - 1) }
    }
    return None
}

// The column of the first table every output is MIN (0) or MAX (1) of, else -1.
fn minMax(q: &Query, exprs: &[]Expr, dir: mut &int): int {
    var col = -1
    var fname = ""
    for x in exprs {
        match x {
            Expr.Call(n, args, star) {
                if (n != "min" && n != "max") || star || len(args) != 1 { return -1 }
                let c = q.firstCol(&args[0])
                if c < 0 || (col >= 0 && (c != col || n != fname)) { return -1 }
                col = c
                fname = n
            }
            else { return -1 }
        }
    }
    dir = if fname == "max" { 1 } else { 0 }
    return col
}

fn planSelect(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val,
              sc: mut &Scope): Result[Sel, DbErr] {
    if s.rec && s.setop != lexdb_sql.SET_UNION {
        return Err(e("42P19", "recursive query does not have the form non-recursive-term UNION [ALL] recursive-term"))
    }
    if s.setop != 0 { return planSet(st, txn, s, params, sc) }
    var q = try buildQuery(st, txn, &s.from, &s.where, params, &s.subs, sc)
    var exprs: []Expr = []
    let outs = try selectCols(s, &q.cols, sc, mut &exprs)
    var groupBy: []Expr = []
    for g in s.group {
        let r = try resolveGroup(&g, &q.cols, &outs, &exprs, sc)
        if hasAgg(&r) { return Err(e("42803", "aggregate functions are not allowed in GROUP BY")) }
        append(mut &groupBy, r)
    }
    var order: []Expr = []
    for o in s.order { append(mut &order, try resolveOrder(&o.expr, &q.cols, &outs, sc)) }
    var having: Option[Expr] = None
    match s.having {
        Some(h) { having = Some(try resolve(&h, &q.cols, len(q.cols), sc)) }
        None {}
    }
    endScope(sc, mut &q)
    var aggQ = len(groupBy) > 0 || having.isSome()
    for x in exprs { if hasAgg(&x) { aggQ = true } }
    for x in order { if hasAgg(&x) { aggQ = true } }
    if s.distinct {
        // SELECT DISTINCT: ORDER BY may use only what it outputs
        for o in order {
            var ok = false
            match o {
                Expr.Lit(v) { match v { Val.Int(_) { ok = true } else {} } }
                Expr.Col(n) { if colIndex(&q.cols, &n) < 0 { ok = true } }
                else {}
            }
            let t = lexdb_sql.exprText(&o)
            for x in exprs { if lexdb_sql.exprText(&x) == t { ok = true } }
            if !ok { return Err(e("42P10", "for SELECT DISTINCT, ORDER BY expressions must appear in select list")) }
        }
    }
    let limit = try evalInt(&s.limit, params, "LIMIT")
    let offset = try evalInt(&s.offset, params, "OFFSET")
    var sort = len(order) > 0
    var first = -1
    // The first table's order holds through the joins, unless a RIGHT or
    // FULL JOIN adds its unmatched rows at the end.
    var keeps = len(q.levels) > 0 && !q.levels[0].virt()
    for lv in q.levels { if keepsRight(lv.join) { keeps = false } }
    var setIndex = -2               // the first table's path, changed: its index, its direction
    var setDesc = false
    var setNoNulls = false
    if keeps {
        let t = &q.levels[0].t
        let path = &q.levels[0].path
        var cols: []int = []
        var dir = -1
        var mm = -1
        if !aggQ {
            dir = orderCols(&q, &order, &s.order, &exprs, &outs, mut &cols)
        } else if len(groupBy) == 0 {
            var d = 0
            mm = minMax(&q, &exprs, mut &d)
            if mm >= 0 {
                append(mut &cols, mm)
                dir = d
            }
        }
        if dir >= 0 {
            var ix = path.index
            var use = servesOrder(t, path, &cols)
            let full = len(path.eqs) == 0 && len(path.rng) == 0 && len(path.ins) == 0 && path.inSub < 0
            // A full scan changes to an index for its order only when that
            // saves reading everything: a LIMIT, or MIN/MAX. Else a sort is
            // cheaper than a lookup per row.
            if !use && full && (limit >= 0 || mm >= 0) {
                match orderedScan(&q, &cols, params) {
                    Some(x) {
                        ix = x
                        use = true
                    }
                    None {}
                }
            }
            if use {
                setIndex = ix
                setDesc = dir == 1
                if mm >= 0 {
                    first = mm
                    // MIN and MAX skip NULLs: an index whose next column it is need not read them
                    let key = keyCols(t, ix)
                    setNoNulls = ix >= 0 && len(path.eqs) < len(key) && key[len(path.eqs)] == mm
                } else {
                    sort = false
                }
            }
        }
    }
    if setIndex > -2 {
        q.levels[0].path.index = setIndex
        q.levels[0].path.desc = setDesc
        q.levels[0].path.noNulls = setNoNulls
    }
    // A grouped query: its aggregate calls become accumulators, and its
    // columns must be grouped.
    var specs: []AggSpec = []
    if aggQ {
        var rx: []Expr = []
        for x in exprs { append(mut &rx, try collectAggs(&x, mut &specs)) }
        exprs = rx
        var ro: []Expr = []
        for x in order { append(mut &ro, try collectAggs(&x, mut &specs)) }
        order = ro
        var rh: Option[Expr] = None
        match having {
            Some(h) { rh = Some(try collectAggs(&h, mut &specs)) }
            None {}
        }
        having = rh
        var gtexts: []str = []
        for g in groupBy { append(mut &gtexts, lexdb_sql.exprText(&g)) }
        var okLevels: []bool = []
        for lv in q.levels {
            var all = true
            for c in lv.t.pk {
                let name = lv.alias + "." + lv.t.cols[c].name
                var found = false
                for g in groupBy {
                    match g {
                        Expr.Col(n) { if n == name { found = true } }
                        else {}
                    }
                }
                if !found { all = false }
            }
            append(mut &okLevels, all && len(groupBy) > 0 && len(lv.t.pk) > 0)
        }
        for x in exprs { try checkGrouped(&x, &gtexts, &okLevels, &q) }
        for x in order { try checkGrouped(&x, &gtexts, &okLevels, &q) }
        match having {
            Some(h) { try checkGrouped(&h, &gtexts, &okLevels, &q) }
            None {}
        }
    }
    var desc: []bool = []
    for o in s.order { append(mut &desc, o.desc) }
    return Ok(Sel{q: q, exprs: exprs, outs: outs, groupBy: groupBy, order: order, aggQ: aggQ, sort: sort,
                  first: first, limit: limit, offset: offset, having: having, specs: specs, distinct: s.distinct, desc: desc,
                  parts: [], setop: 0, setAll: false, split: 0, rec: -1, srf: s.srf, ordin: s.ordin})
}

// UNION, INTERSECT, EXCEPT: its two queries, planned on their own; the
// whole has their output (the first's names), ORDER BY over that output,
// LIMIT and OFFSET. A recursive CTE's second query reads the working table,
// with the first's columns.
fn planSet(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val,
           sc: mut &Scope): Result[Sel, DbErr] {
    let l = try planSelect(st, txn, &s.inner[0], params, sc)
    if s.rec {
        var cols: []lexdb_sql.ColDef = []
        for o in l.outs { append(mut &cols, lexdb_sql.ColDef{name: o.name, typ: oidType(o.oid), notNull: false}) }
        append(mut &sc.works, Work{id: s.cte, cols: cols})
    }
    let rr = planSelect(st, txn, &s.inner[1], params, sc)
    if s.rec { let w = pop(mut &sc.works) }
    let r = try rr
    let what = if s.setop == lexdb_sql.SET_UNION { "UNION" } else if s.setop == lexdb_sql.SET_INTERSECT { "INTERSECT" } else { "EXCEPT" }
    if len(l.outs) != len(r.outs) { return Err(e("42601", "each " + what + " query must have the same number of columns")) }
    var outs: []OutCol = []
    for o in l.outs { append(mut &outs, o) }
    var order: []Expr = []
    for o in s.order {
        var ok = false
        match o.expr {
            Expr.Lit(v) { match v { Val.Int(n) { ok = n >= 1 && n <= len(outs) } else {} } }
            Expr.Col(n) { for oc in outs { if oc.name == n { ok = true } } }
            else {}
        }
        if !ok { return Err(e("42P10", "invalid " + what + " ORDER BY clause: name or number an output column")) }
        append(mut &order, clone(&o.expr))
    }
    var desc: []bool = []
    for o in s.order { append(mut &desc, o.desc) }
    var refs = cloneAll(&l.q.refs)
    for x in r.q.refs { append(mut &refs, clone(&x)) }
    let split = len(l.q.refs)
    let limit = try evalInt(&s.limit, params, "LIMIT")
    let offset = try evalInt(&s.offset, params, "OFFSET")
    let q = Query{levels: [], cols: [], top: [], subs: [], base: sc.base, corr: false, refs: refs}
    return Ok(Sel{q: q, exprs: [], outs: outs, groupBy: [], order: order, aggQ: false, sort: len(order) > 0, first: -1,
                  limit: limit, offset: offset, having: None, specs: [], distinct: false, desc: desc, parts: [l, r],
                  setop: s.setop, setAll: s.setAll, split: split, rec: if s.rec { s.cte } else { -1 }, srf: "", ordin: false})
}

// A row's key for UNION and the like (NULLs alike; 2 = 2.0).
fn rowKey(vs: &[]Val): str {
    var kb = newStrBuf()
    for v in vs { keyPart(mut &kb, &v) }
    return kb.toStr()
}

fn distinctRows(rows: [][]Val, seen: mut &Map[str, int]): [][]Val {
    var all = rows
    var out: [][]Val = []
    for i in 0..len(all) {
        let k = rowKey(&all[i])
        if seen.get(&k).isSome() { continue }
        seen.put(k, 1)
        append(mut &out, replace(mut &all[i], []))
    }
    return out
}

fn combine(op: int, all: bool, l: [][]Val, r: [][]Val): [][]Val {
    var la = l
    var ra = r
    if op == lexdb_sql.SET_UNION {
        if all {
            for i in 0..len(ra) { append(mut &la, replace(mut &ra[i], [])) }
            return la
        }
        var seen: Map[str, int] = newMap()
        var out = distinctRows(la, mut &seen)
        let more = distinctRows(ra, mut &seen)
        var mo = more
        for i in 0..len(mo) { append(mut &out, replace(mut &mo[i], [])) }
        return out
    }
    var cnt: Map[str, int] = newMap()
    for row in ra {
        let k = rowKey(&row)
        let n = cnt.get(&k).unwrapOr(0)
        cnt.put(k, n + 1)
    }
    var out: [][]Val = []
    var done: Map[str, int] = newMap()
    for i in 0..len(la) {
        let k = rowKey(&la[i])
        let n = cnt.get(&k).unwrapOr(0)
        if op == lexdb_sql.SET_INTERSECT {
            if n > 0 {
                append(mut &out, replace(mut &la[i], []))
                cnt.put(k, if all { n - 1 } else { 0 })
            }
        } else if all {
            if n > 0 { cnt.put(k, n - 1) } else { append(mut &out, replace(mut &la[i], [])) }
        } else if n == 0 && done.get(&k).isNone() {
            done.put(k, 1)
            append(mut &out, replace(mut &la[i], []))
        }
    }
    return out
}

// The rows of a UNION, INTERSECT or EXCEPT: each query with the statement's
// parameters and its own refs.
fn runSet(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val,
          rs: mut &Run): Result[[][]Val, DbErr] {
    let base = sel.q.base
    var lp: []Val = []
    var rp: []Val = []
    for j in 0..base {
        append(mut &lp, params[j])
        append(mut &rp, params[j])
    }
    for j in base..base + sel.split { append(mut &lp, params[j]) }
    for j in base + sel.split..len(params) { append(mut &rp, params[j]) }
    if sel.rec >= 0 { return runRecursive(st, txn, sel, &lp, &rp, rs) }
    var lres = try runChild(st, txn, &sel.parts[0], &lp, -1, rs, 0)
    try rs.hold(rowsBytes(&lres.rows))
    var rres = try runChild(st, txn, &sel.parts[1], &rp, -1, rs, 1)
    try rs.hold(rowsBytes(&rres.rows))
    return Ok(combine(sel.setop, sel.setAll, replace(mut &lres.rows, []), replace(mut &rres.rows, [])))
}

// A recursive CTE: the first query's rows, then rounds of the second over
// the rows the last round added (the working table) until a round adds
// none; with UNION (not ALL), rows seen before are not added.
fn runRecursive(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, lp: &[]Val, rp: &[]Val,
                rs: mut &Run): Result[[][]Val, DbErr] {
    let key = "w" + sel.rec.toStr()
    var seen: Map[str, int] = newMap()
    var lres = try runChild(st, txn, &sel.parts[0], lp, -1, rs, 0)
    var work = replace(mut &lres.rows, [])
    if !sel.setAll { work = distinctRows(work, mut &seen) }
    var out: [][]Val = []
    // max_recursion: rounds that add rows (the last round, adding none, is free)
    var rounds = 0
    while len(work) > 0 {
        try rs.tick()
        try rs.hold(rowsBytes(&work) * 2)       // kept in the result and as the working table
        for r in work { append(mut &out, copyRow(&r)) }
        cachePut(mut &rs.cache, key, work)
        var rres = try runChild(st, txn, &sel.parts[1], rp, -1, rs, 1)
        work = replace(mut &rres.rows, [])
        if !sel.setAll { work = distinctRows(work, mut &seen) }
        rounds += 1
        if rs.maxRounds > 0 && rounds > rs.maxRounds && len(work) > 0 {
            return Err(e("54001", "recursive query still adding rows after " + rs.maxRounds.toStr() +
                         " rounds (max_recursion); SET max_recursion = n to allow more, 0 for no limit"))
        }
    }
    return Ok(out)
}

// EXPLAIN's lines for a planned SELECT.
fn selLines(sel: &Sel, cnt: &[]Counts, stats: &[]SubStat): []str {
    if sel.setop != 0 { return setLines(sel, stats) }
    var lines = explainLines(&sel.q, cnt)
    if len(sel.srf) > 0 { append(mut &lines, "function " + sel.srf + (if sel.ordin { " with ordinality" } else { "" })) }
    else if len(sel.q.levels) == 0 { append(mut &lines, "result") }
    if sel.first >= 0 { append(mut &lines, "min/max: the first value in the scan's order") }
    if len(sel.groupBy) > 0 || (sel.aggQ && sel.first < 0) { append(mut &lines, "aggregate") }
    if sel.having.isSome() { append(mut &lines, "having") }
    if sel.distinct { append(mut &lines, "distinct") }
    if len(sel.order) > 0 { append(mut &lines, if sel.sort { "order: sort" } else { "order: the scan's" }) }
    if sel.limit >= 0 && !sel.aggQ && !sel.sort { append(mut &lines, "limit: stops the scan") }
    subLines(&sel.q, stats, mut &lines)
    return lines
}

fn setLines(sel: &Sel, stats: &[]SubStat): []str {
    var lines: []str = []
    let op = if sel.setop == lexdb_sql.SET_UNION { "union" } else if sel.setop == lexdb_sql.SET_INTERSECT { "intersect" } else { "except" }
    append(mut &lines, (if sel.rec >= 0 { "recursive " } else { "" }) + op + (if sel.setAll { " all" } else { "" }))
    let none: []Counts = []
    let noStats: []SubStat = []
    for i in 0..len(sel.parts) {
        var head = if sel.rec >= 0 { if i == 0 { "first" } else { "then, per round, over the working table" } } else { "query " + (i + 1).toStr() }
        var inner: []str = []
        if i < len(stats) {
            head = head + " (runs " + stats[i].runs.toStr() + ")"
            inner = selLines(&sel.parts[i], &stats[i].cnt, &stats[i].inner)
        } else {
            inner = selLines(&sel.parts[i], &none, &noStats)
        }
        append(mut &lines, "  " + head + ":")
        for l in inner { append(mut &lines, "    " + l) }
    }
    if len(sel.order) > 0 { append(mut &lines, "order: sort") }
    return lines
}

// A SELECT; with analyze, plan gets EXPLAIN ANALYZE's lines (a line per
// table, with what it did). The counts are kept for every query: an add each.
fn selectWith(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
              lim: Limits, analyze: bool, plan: mut &[]str): Result[Res, DbErr] {
    var sc = newScope(params, ptypes)
    let sel = try planSelect(st, txn, s, params, mut &sc)
    var rs = newRun(&sel.q)
    rs.limit(&lim)
    let res = try execSel(st, txn, &sel, params, -1, mut &rs)
    if analyze {
        let lines = selLines(&sel, &rs.cnt, &rs.stats)
        for l in lines { append(plan, l) }
    }
    return Ok(res)
}

// An ORDER BY value, running its correlated subqueries.
fn orderX(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, o: &Expr, outs: &[]OutCol, vals: &[]Val,
          env: &Env, rs: mut &Run): Result[Val, DbErr] {
    if q.corr && hasCorr(o) { return evalX(st, txn, q, o, env, rs) }
    return orderValue(o, outs, vals, env)
}

// Runs a planned SELECT. cap >= 0: at most that many rows are wanted (a
// subquery: EXISTS 1, in any order; a scalar 2).
fn execSel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int,
           rs: mut &Run): Result[Res, DbErr] {
    if len(sel.srf) > 0 { return execSrf(st, txn, sel, params, cap, rs) }
    let m = try prepare(st, txn, &sel.q, params, rs)
    let q = &sel.q
    let limit = if cap >= 0 && (sel.limit < 0 || cap < sel.limit) { cap } else { sel.limit }
    let offset = sel.offset
    let sorting = sel.sort && cap != 1
    // correlated subqueries in the output run after the scan, from its rows kept
    var late = false
    if q.corr && !sel.aggQ {
        for x in sel.exprs { if hasCorr(&x) { late = true } }
        if sorting { for x in sel.order { if hasCorr(&x) { late = true } } }
    }
    var outRows: []OutRow = []
    // the rows kept here, counted in the row callbacks (they cannot reach rs)
    let room = rs.room()
    var held = 0
    if sel.setop != 0 {
        var rows = try runSet(st, txn, sel, params, rs)
        let noCols: []lexdb_sql.ColDef = []
        for i in 0..len(rows) {
            let vals = replace(mut &rows[i], [])
            var ord: []Val = []
            if sorting {
                let none: []Val = []
                let env = Env{cols: &noCols, row: &vals, aggs: &none, params: params, subs: &m.subs, cur: &none}
                for o in sel.order { append(mut &ord, try orderValue(&o, &sel.outs, &vals, &env)) }
            }
            held += rowBytes(&ord)
            append(mut &outRows, OutRow{vals: vals, ord: ord})
        }
    }
    let rs0max = rs.maxHeld
    let early = !sel.aggQ && !sorting && limit >= 0 && !(late && sel.distinct)
    let stopAt = if offset > 0 { limit + offset } else { limit }
    let noAggs: []Val = []
    var seen: Map[str, int] = newMap()      // SELECT DISTINCT
    if sel.setop != 0 {
        // done above
    } else if sel.aggQ {
        // per group: its first row (for grouped columns) and its accumulators
        var gs = Groups{index: newMap(), firsts: [], accs: []}
        // A correlated subquery in a GROUP BY key or an aggregate's argument
        // runs per row, which it cannot while the rows are read (runQuery
        // holds the run): the rows are kept, then grouped (9.24).
        let later = q.corr && groupCorr(sel)
        var kept: [][]Val = []
        try runQuery(st, txn, q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
            if sel.first >= 0 && isNull(&r[sel.first]) { return Ok(true) }
            if later {
                held += rowBytes(r)
                if room >= 0 && held > room { return Err(memErr(rs0max)) }
                append(mut &kept, copyRow(r))
                return Ok(sel.first < 0)
            }
            let env = Env{cols: &q.cols, row: r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
            try addToGroup(sel, mut &gs, r, &env, mut &held, room, rs0max)
            return Ok(sel.first < 0)        // MIN/MAX in order: its first value is the answer
        }, rs)
        for r in kept {
            let env = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
            var cur: []Val = array(len(q.subs), Val.Null)
            for x in sel.groupBy { try fillCur(st, txn, q, &x, &env, rs, mut &cur) }
            for sp in sel.specs {
                for a in sp.args { try fillCur(st, txn, q, &a, &env, rs, mut &cur) }
                for o in sp.order { try fillCur(st, txn, q, &o, &env, rs, mut &cur) }
                match sp.filter {
                    Some(f) { try fillCur(st, txn, q, &f, &env, rs, mut &cur) }
                    None {}
                }
            }
            let env2 = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &cur}
            try addToGroup(sel, mut &gs, &r, &env2, mut &held, room, rs0max)
        }
        var firsts = replace(mut &gs.firsts, [])
        var accs = replace(mut &gs.accs, [])
        if len(firsts) == 0 && len(sel.groupBy) == 0 {
            append(mut &firsts, [])         // no rows, no GROUP BY: one group, empty
            append(mut &accs, newAccs(len(sel.specs)))
        }
        for gi in 0..len(firsts) {
            var vals: []Val = []
            for i in 0..len(sel.specs) { append(mut &vals, try finish(&sel.specs[i], &accs[gi][i])) }
            let env = Env{cols: &q.cols, row: &firsts[gi], aggs: &vals, params: params, subs: &m.subs, cur: &noAggs}
            match sel.having {
                Some(h) { if truth(&(try evalX(st, txn, q, &h, &env, rs))) != Some(true) { continue } }
                None {}
            }
            var out: []Val = []
            for x in sel.exprs { append(mut &out, try evalX(st, txn, q, &x, &env, rs)) }
            if sel.distinct {
                let k = valsKey(&out)
                if seen.get(&k).isSome() { continue }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for o in sel.order { append(mut &ord, try orderX(st, txn, q, &o, &sel.outs, &out, &env, rs)) } }
            held += rowBytes(&out) + rowBytes(&ord)
            append(mut &outRows, OutRow{vals: out, ord: ord})
        }
    } else if late {
        var raws: [][]Val = []
        try runQuery(st, txn, q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
            held += rowBytes(r)
            if room >= 0 && held > room { return Err(memErr(rs0max)) }
            append(mut &raws, copyRow(r))
            return Ok(!early || len(raws) < stopAt)
        }, rs)
        for r in raws {
            let env = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
            var vals: []Val = []
            for x in sel.exprs { append(mut &vals, try evalX(st, txn, q, &x, &env, rs)) }
            if sel.distinct {
                let k = valsKey(&vals)
                if seen.get(&k).isSome() { continue }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for o in sel.order { append(mut &ord, try orderX(st, txn, q, &o, &sel.outs, &vals, &env, rs)) } }
            held += rowBytes(&vals) + rowBytes(&ord)
            append(mut &outRows, OutRow{vals: vals, ord: ord})
        }
    } else {
        try runQuery(st, txn, q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
            let env = Env{cols: &q.cols, row: r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs}
            var vals: []Val = []
            for x in sel.exprs { append(mut &vals, try eval(&x, &env)) }
            if sel.distinct {
                let k = valsKey(&vals)
                if seen.get(&k).isSome() { return Ok(true) }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for o in sel.order { append(mut &ord, try orderValue(&o, &sel.outs, &vals, &env)) } }
            held += rowBytes(&vals) + rowBytes(&ord)
            if room >= 0 && held > room { return Err(memErr(rs0max)) }
            append(mut &outRows, OutRow{vals: vals, ord: ord})
            return Ok(!early || len(outRows) < stopAt)
        }, rs)
    }
    try rs.hold(held)
    if sorting {
        collections.sortBy(mut &outRows, fn(a: &OutRow, b: &OutRow): int {
            for i in 0..len(sel.desc) {
                var c = sortCmp(&a.ord[i], &b.ord[i])
                if sel.desc[i] { c = -c }
                if c != 0 { return c }
            }
            return 0
        })
    }
    var outs: []OutCol = []
    for oc in sel.outs { append(mut &outs, oc) }
    var res = Res{cols: outs, rows: [], tag: "", hasRows: true}
    var i = 0
    for r in outRows {
        if i >= offset || offset < 0 {
            if limit >= 0 && len(res.rows) >= limit { break }
            var vs: []Val = []
            for v in r.vals { append(mut &vs, v) }
            append(mut &res.rows, vs)
        }
        i += 1
    }
    res.tag = "SELECT " + len(res.rows).toStr()
    return Ok(res)
}

// ---- describing a statement before it runs (the extended protocol)

// The parameter types of a statement: the client's, else what the
// statement compares or assigns them to, else text.
fn paramTypes(st: &lexdb_store.Store, s: &lexdb_sql.Stmt, given: &[]int, path: &[]str): []int {
    var out: []int = []
    for i in 0..s.params { append(mut &out, if i < len(given) { given[i] } else { 0 }) }
    stmtCasts(s, mut &out)              // $1::int[]: the cast's type
    if s.kind == lexdb_sql.S_EXPLAIN && len(s.inner) > 0 {
        guessParams(st, &s.inner[0], mut &out, path)
    } else {
        guessParams(st, s, mut &out, path)
    }
    for i in 0..len(out) { if out[i] == 0 { out[i] = lexdb_sql.OID_TEXT } }
    return out
}

// A parameter cast where it is used ($1::int[]) is of the cast's type.
fn castParams(x: &Expr, out: mut &[]int) {
    match x {
        Expr.Cast(a, t) {
            setParam(&a, t.oid, out)
            castParams(&a, out)
        }
        Expr.Unary(_, a) { castParams(&a, out) }
        Expr.Bin(_, a, b) {
            castParams(&a, out)
            castParams(&b, out)
        }
        Expr.IsNull(a, _) { castParams(&a, out) }
        Expr.Call(_, args, _) { for a in args { castParams(&a, out) } }
        else {}
    }
}

fn optCasts(x: &Option[Expr], out: mut &[]int) {
    match x {
        Some(v) { castParams(&v, out) }
        None {}
    }
}

fn stmtCasts(s: &lexdb_sql.Stmt, out: mut &[]int) {
    for it in s.items { optCasts(&it.expr, out) }
    for r in s.rows { for x in r { castParams(&x, out) } }
    for si in s.sets { castParams(&si.expr, out) }
    for g in s.group { castParams(&g, out) }
    for o in s.order { castParams(&o.expr, out) }
    optCasts(&s.where, out)
    optCasts(&s.having, out)
    optCasts(&s.limit, out)
    optCasts(&s.offset, out)
    for f in s.from { optCasts(&f.on, out) }
    for b in s.subs { stmtCasts(&b, out) }
    for b in s.inner { stmtCasts(&b, out) }
}

fn setParam(x: &Expr, oid: int, out: mut &[]int) {
    match x {
        Expr.Param(n) { if n <= len(out) && out[n - 1] == 0 { out[n - 1] = oid } }
        else {}
    }
}

fn guessParams(st: &lexdb_store.Store, s: &lexdb_sql.Stmt, out: mut &[]int, path: &[]str) {
    if s.kind == lexdb_sql.S_INSERT && len(s.inner) > 0 { guessParams(st, &s.inner[0], out, path) }
    if s.setop != 0 {
        for b in s.inner { guessParams(st, &b, out, path) }
        return
    }
    var txn = lexdb_store.begin()
    for x in path { append(mut &txn.path, x) }
    match findTable(st, mut &txn, &s.table) {
        Ok(found) {
            match found {
                Some(tb) {
                    if s.kind == lexdb_sql.S_INSERT {
                        for r in s.rows {
                            for k in 0..len(r) {
                                let ci = if len(s.names) == 0 { k } else { colIndex(&tb.cols, &s.names[k]) }
                                if ci >= 0 && ci < len(tb.cols) { setParam(&r[k], tb.cols[ci].typ.oid, out) }
                            }
                        }
                    }
                    for si in s.sets {
                        let ci = colIndex(&tb.cols, &si.col)
                        if ci >= 0 { setParam(&si.expr, tb.cols[ci].typ.oid, out) }
                    }
                }
                None {}
            }
        }
        Err(_) {}
    }
    if s.kind != lexdb_sql.S_SELECT && s.kind != lexdb_sql.S_UPDATE && s.kind != lexdb_sql.S_DELETE { return }
    let np: []Val = array(len(out), Val.Null)
    let noTypes: []int = []
    var sc = newScope(&np, &noTypes)
    let built = if s.kind == lexdb_sql.S_SELECT { buildQuery(st, mut &txn, &s.from, &s.where, &np, &s.subs, mut &sc) } else {
        buildQuery(st, mut &txn, &oneTable(&s.table), &s.where, &np, &s.subs, mut &sc)
    }
    match built {
        Ok(q) { comparedIn(&q, out) }
        Err(_) {}
    }
}

fn comparedIn(q: &Query, out: mut &[]int) {
    for lv in q.levels {
        for c in lv.cond { compared(&c, q, out) }
        for c in lv.post { compared(&c, q, out) }
    }
    for sp in q.subs { comparedIn(&sp.sel.q, out) }
}

// A parameter compared with a column takes the column's type.
fn compared(c: &Expr, q: &Query, out: mut &[]int) {
    match c {
        Expr.Bin(op, a, b) {
            if op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                match a {
                    Expr.Col(n) {
                        let i = colIndex(&q.cols, &n)
                        if i >= 0 { setParam(&b, q.cols[i].typ.oid, out) }
                    }
                    else {}
                }
                match b {
                    Expr.Col(n) {
                        let i = colIndex(&q.cols, &n)
                        if i >= 0 { setParam(&a, q.cols[i].typ.oid, out) }
                    }
                    else {}
                }
            }
        }
        else {}
    }
}

// The columns a statement returns (none unless it is a SELECT or EXPLAIN).
fn describe(st: &lexdb_store.Store, s: &lexdb_sql.Stmt, ptypes: &[]int, path: &[]str): Result[[]OutCol, DbErr] {
    if s.kind == lexdb_sql.S_EXPLAIN { return Ok([OutCol{name: "QUERY PLAN", oid: lexdb_sql.OID_TEXT}]) }
    if s.kind == lexdb_sql.S_SHOW { return Ok(showCols(&s.table)) }
    if s.kind != lexdb_sql.S_SELECT { return Ok([]) }
    var txn = lexdb_store.begin()
    for x in path { append(mut &txn.path, x) }
    if s.setop != 0 {
        let np: []Val = array(if s.params > len(ptypes) { s.params } else { len(ptypes) }, Val.Null)
        var sc = newScope(&np, ptypes)
        let sel = try planSelect(st, mut &txn, s, &np, mut &sc)
        var outs: []OutCol = []
        for o in sel.outs { append(mut &outs, o) }
        return Ok(outs)
    }
    let none: Option[Expr] = None
    let np: []Val = array(if s.params > len(ptypes) { s.params } else { len(ptypes) }, Val.Null)
    var sc = newScope(&np, ptypes)
    let q = try buildQuery(st, mut &txn, &s.from, &none, &np, &s.subs, mut &sc)
    var exprs: []Expr = []
    return selectCols(s, &q.cols, mut &sc, mut &exprs)
}

// ---- sessions

pub type Session = record {
    st: lexdb_store.Store
    txn: []lexdb_store.Txn      // the open transaction block, if any
    failed: bool                // an error in the block: only ROLLBACK (or COMMIT) now
    maxRecursion: int           // SET max_recursion: a recursive CTE's rounds at most; 0 no limit
    timeoutMs: int              // SET statement_timeout: a statement's time at most; 0 no limit
    maxMem: int                 // SET max_statement_mem: the bytes of rows a statement holds at most; 0 no limit
    saved: []Limits             // in a transaction block: the settings at its BEGIN (a ROLLBACK restores them)
    readOnly: bool              // the block is BEGIN READ ONLY
    path: []str                 // SET search_path: its schemas; [] public alone (the default)
    pathAt: int                 // bumped when the path changes (the wire's kept descriptions)
    savedPath: [][]str          // in a transaction block: the path at its BEGIN
}

// The columns a statement returns, its names looked up along the session's
// search path.
pub fn (s: &Session) describe(stmt: &lexdb_sql.Stmt, ptypes: &[]int): Result[[]OutCol, DbErr] {
    return describe(&s.st, stmt, ptypes, &s.path)
}

// A statement's parameter types (paramTypes), along the session's path.
pub fn (s: &Session) paramTypes(stmt: &lexdb_sql.Stmt, given: &[]int): []int {
    return paramTypes(&s.st, stmt, given, &s.path)
}

// Changes when the search path does: a statement's description kept from
// before may name other tables.
pub fn (s: &Session) pathVersion(): int { return s.pathAt }

fn (s: mut &Session) setPath(names: &[]str) {
    var p: []str = []
    for n in names { append(mut &p, n) }
    if len(p) == 1 && p[0] == "public" { p = [] }
    s.path = p
    s.pathAt += 1
    if len(s.txn) > 0 {
        var q: []str = []
        for n in s.path { append(mut &q, n) }
        s.txn[0].path = q
    }
}

// SHOW's columns: the setting's name, or SHOW ALL's name and setting.
fn showCols(name: &str): []OutCol {
    if name == "all" { return [OutCol{name: "name", oid: lexdb_sql.OID_TEXT}, OutCol{name: "setting", oid: lexdb_sql.OID_TEXT}] }
    return [OutCol{name: name, oid: lexdb_sql.OID_TEXT}]
}

fn (s: &Session) setting(name: &str): Option[str] {
    match name {
        "search_path" { return Some(if len(s.path) == 0 { "public" } else { strings.join(&s.path, ", ") }) }
        "max_recursion" { return Some(s.maxRecursion.toStr()) }
        "statement_timeout" { return Some(if s.timeoutMs == 0 { "0" } else { s.timeoutMs.toStr() + "ms" }) }
        "max_statement_mem" { return Some(if s.maxMem == 0 { "0" } else { (s.maxMem / 1024).toStr() + "kB" }) }
        "transaction_isolation" { return Some("serializable") }
        else { return None }
    }
}

fn (s: &Session) show(name: &str): Result[Res, DbErr] {
    var res = Res{cols: showCols(name), rows: [], tag: "SHOW", hasRows: true}
    if name == "all" {
        for n in lexdb_sql.SETTINGS { append(mut &res.rows, [Val.Text(n), Val.Text(s.setting(&n).unwrap())]) }
        return Ok(res)
    }
    match s.setting(name) {
        Some(v) { append(mut &res.rows, [Val.Text(v)]) }
        None { return Err(e("42704", "unrecognized configuration parameter \"" + name + "\"")) }
    }
    return Ok(res)
}

pub fn newSession(st: lexdb_store.Store): Session {
    return Session{st: st, txn: [], failed: false, maxRecursion: MAX_RECURSION, timeoutMs: 0, maxMem: MAX_STATEMENT_MEM,
                   saved: [], readOnly: false, path: [], pathAt: 0, savedPath: []}
}

// max_statement_mem's default.
pub const MAX_STATEMENT_MEM = 256 * 1024 * 1024

// A transaction block rolled back: its SETs with it (as PostgreSQL's).
fn (s: mut &Session) restore() {
    if len(s.saved) == 0 { return }
    let l = pop(mut &s.saved)
    if len(s.savedPath) > 0 {
        let p = pop(mut &s.savedPath)
        if strings.join(&p, ",") != strings.join(&s.path, ",") {
            if len(p) == 0 { s.setPath(&["public"]) } else { s.setPath(&p) }
        }
    }
    s.maxRecursion = l.rounds
    s.maxMem = l.mem
    s.timeoutMs = l.deadline                // saved there: the timeout in ms
}

// The limits for a statement starting now.
fn (s: &Session) limits(): Limits {
    let dl = if s.timeoutMs > 0 { time.monotonicNs() + s.timeoutMs * 1000000 } else { 0 }
    return Limits{rounds: s.maxRecursion, mem: s.maxMem, deadline: dl}
}

// A setting's value: a number (statement_timeout in ms, max_statement_mem
// in kB, as PostgreSQL's), or a string with a unit ('5s', '64MB').
fn settingValue(name: &str, v: &Val): Result[int, DbErr] {
    let bad = e("22023", "invalid value for parameter \"" + name + "\"")
    var n = 0
    var unit = ""
    match v {
        Val.Int(i) { n = i }
        Val.Text(t) {
            var i = 0
            while i < len(t) && t[i] >= '0' && t[i] <= '9' { i += 1 }
            if i == 0 { return Err(bad) }
            n = strings.parseIntOpt(t[0..i]).unwrapOr(-1)
            unit = strings.toLowerAscii(strings.trim(t[i..len(t)]))
        }
        else { return Err(bad) }
    }
    if n < 0 { return Err(bad) }
    if name == "statement_timeout" {
        if unit == "" || unit == "ms" { return Ok(n) }
        if unit == "s" { return Ok(n * 1000) }
        if unit == "min" { return Ok(n * 60000) }
        if unit == "h" { return Ok(n * 3600000) }
        return Err(bad)
    }
    if name == "max_statement_mem" {
        if unit == "" || unit == "kb" { return Ok(n * 1024) }
        if unit == "mb" { return Ok(n * 1024 * 1024) }
        if unit == "gb" { return Ok(n * 1024 * 1024 * 1024) }
        return Err(bad)
    }
    if unit != "" { return Err(bad) }
    return Ok(n)
}

// Ends the session: an open block is rolled back (a snapshot released).
pub fn (s: mut &Session) close() {
    if len(s.txn) > 0 { s.st.abort(pop(mut &s.txn)) }
    s.failed = false
}

fn isWrite(kind: int): bool {
    return kind == lexdb_sql.S_CREATE || kind == lexdb_sql.S_DROP || kind == lexdb_sql.S_INSERT ||
           kind == lexdb_sql.S_UPDATE || kind == lexdb_sql.S_DELETE || kind == lexdb_sql.S_CREATE_INDEX ||
           kind == lexdb_sql.S_DROP_INDEX || kind == lexdb_sql.S_CREATE_SCHEMA || kind == lexdb_sql.S_DROP_SCHEMA
}

fn stmtName(kind: int): str {
    return match kind {
        lexdb_sql.S_CREATE { "CREATE TABLE" }
        lexdb_sql.S_DROP { "DROP TABLE" }
        lexdb_sql.S_INSERT { "INSERT" }
        lexdb_sql.S_UPDATE { "UPDATE" }
        lexdb_sql.S_CREATE_INDEX { "CREATE INDEX" }
        lexdb_sql.S_DROP_INDEX { "DROP INDEX" }
        lexdb_sql.S_CREATE_SCHEMA { "CREATE SCHEMA" }
        lexdb_sql.S_DROP_SCHEMA { "DROP SCHEMA" }
        else { "DELETE" }
    }
}

// 'I' idle, 'T' in a transaction block, 'E' in a failed one.
pub fn (s: &Session) status(): byte {
    if len(s.txn) == 0 { return 'I' }
    return if s.failed { 'E' } else { 'T' }
}

fn execIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
          lim: Limits, pc: mut &PlanCache): Result[Res, DbErr] {
    // with subqueries, the outer values they use are numbered after all the
    // statement's parameters: those not sent are NULL
    let subs = hasSubs(s)
    let want = if s.params > len(ptypes) { s.params } else { len(ptypes) }
    if subs && len(params) < want {
        var ps: []Val = []
        for v in params { append(mut &ps, v) }
        while len(ps) < want { append(mut &ps, Val.Null) }
        return execStmt(st, txn, s, &ps, ptypes, lim, pc)
    }
    return execStmt(st, txn, s, params, ptypes, lim, pc)
}

fn hasSubs(s: &lexdb_sql.Stmt): bool {
    if len(s.subs) > 0 { return true }
    for x in s.inner { if hasSubs(&x) { return true } }
    return false
}

fn execStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
            lim: Limits, pc: mut &PlanCache): Result[Res, DbErr] {
    match s.kind {
        lexdb_sql.S_CREATE { return createTable(st, txn, s) }
        lexdb_sql.S_DROP { return dropTable(st, txn, s) }
        lexdb_sql.S_INSERT { return insert(st, txn, s, params, lim) }
        lexdb_sql.S_SELECT { return select(st, txn, s, params, ptypes, lim, pc) }
        lexdb_sql.S_UPDATE { return update(st, txn, s, params, lim) }
        lexdb_sql.S_DELETE { return delete(st, txn, s, params, lim) }
        lexdb_sql.S_CREATE_INDEX { return createIndex(st, txn, s) }
        lexdb_sql.S_DROP_INDEX { return dropIndex(st, txn, s) }
        lexdb_sql.S_CREATE_SCHEMA { return createSchemaStmt(st, txn, s) }
        lexdb_sql.S_DROP_SCHEMA { return dropSchema(st, txn, s) }
        lexdb_sql.S_EXPLAIN { return explain(st, txn, s, params, lim, ptypes) }
        else { return Err(e("XX000", "not a data statement")) }
    }
}

// Converts the parameters a client sent as text to values of their types.
pub fn paramVals(texts: &[]Option[str], ptypes: &[]int): Result[[]Val, DbErr] {
    var out: []Val = []
    for i in 0..len(texts) {
        match texts[i] {
            None { append(mut &out, Val.Null) }
            Some(s) {
                let oid = if i < len(ptypes) { ptypes[i] } else { lexdb_sql.OID_TEXT }
                var ty = lexdb_sql.TypeName{kind: lexdb_sql.K_TEXT, oid: lexdb_sql.OID_TEXT, prec: 0, scale: 0, len: 0}
                if oid == lexdb_sql.OID_INT8 || oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT2 {
                    ty = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
                } else if oid == lexdb_sql.OID_BOOL {
                    ty = lexdb_sql.TypeName{kind: lexdb_sql.K_BOOL, oid: oid, prec: 0, scale: 0, len: 0}
                } else if oid == lexdb_sql.OID_NUMERIC {
                    ty = lexdb_sql.TypeName{kind: lexdb_sql.K_NUM, oid: oid, prec: 0, scale: 0, len: 0}
                } else if lexdb_sql.elemOid(oid) > 0 {
                    ty = oidType(oid)
                }
                append(mut &out, try coerce(Val.Text(s), &ty))
            }
        }
    }
    return Ok(out)
}

// Runs one statement: in the open transaction block, or in a transaction of
// its own that is committed at once (retried a few times on a
// serialization failure: nothing the client saw depends on the first try).
pub fn (s: mut &Session) run(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int): Result[Res, DbErr] {
    var pc = oneShot()
    return s.runCached(stmt, params, ptypes, mut &pc)
}

// run, keeping a SELECT's plan in pc for the next run of the same statement.
pub fn (s: mut &Session) runCached(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &PlanCache): Result[Res, DbErr] {
    match stmt.kind {
        lexdb_sql.S_EMPTY { return Ok(tagOnly("")) }
        lexdb_sql.S_SHOW { return s.show(&stmt.table) }
        lexdb_sql.S_SET {
            if stmt.table == "search_path" {
                if stmt.ifFlag || len(stmt.names) == 0 { s.setPath(&["public"]) } else { s.setPath(&stmt.names) }
                return Ok(tagOnly(if stmt.ifFlag { "RESET" } else { "SET" }))
            }
            if stmt.table == "all" {
                if len(s.path) > 0 { s.setPath(&["public"]) }
                s.maxRecursion = MAX_RECURSION
                s.timeoutMs = 0
                s.maxMem = MAX_STATEMENT_MEM
            } else if stmt.table != "" {
                var v = -1                          // DEFAULT, RESET
                match stmt.limit {
                    Some(x) {
                        let noCols: []lexdb_sql.ColDef = []
                        let none: []Val = []
                        let noSubs: []SubRes = []
                        let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none}
                        v = try settingValue(&stmt.table, &(try eval(&x, &env)))
                    }
                    None {}
                }
                if stmt.table == "max_recursion" { s.maxRecursion = if v < 0 { MAX_RECURSION } else { v } }
                if stmt.table == "statement_timeout" { s.timeoutMs = if v < 0 { 0 } else { v } }
                if stmt.table == "max_statement_mem" { s.maxMem = if v < 0 { MAX_STATEMENT_MEM } else { v } }
            }
            return Ok(tagOnly(if stmt.ifFlag { "RESET" } else { "SET" }))
        }
        lexdb_sql.S_BEGIN {
            if len(s.txn) == 0 {
                if stmt.ifFlag {
                    append(mut &s.txn, try s.st.beginSnapshot())     // READ ONLY: a snapshot (4.5)
                } else {
                    append(mut &s.txn, try s.st.beginBlock())       // a snapshot with its writes (9.16)
                }
                s.readOnly = stmt.ifFlag
                s.failed = false
                s.saved = [Limits{rounds: s.maxRecursion, mem: s.maxMem, deadline: s.timeoutMs}]
                var p: []str = []
                for n in s.path { append(mut &p, n) }
                s.savedPath = [p]
                var q: []str = []
                for n in s.path { append(mut &q, n) }
                s.txn[0].path = q
            }
            return Ok(tagOnly("BEGIN"))
        }
        lexdb_sql.S_COMMIT {
            if len(s.txn) == 0 { return Ok(tagOnly("COMMIT")) }
            let t = pop(mut &s.txn)
            if s.failed {
                s.failed = false
                s.st.abort(t)
                s.restore()
                return Ok(tagOnly("ROLLBACK"))
            }
            s.saved = []
            s.savedPath = []
            try s.st.commit(t)
            return Ok(tagOnly("COMMIT"))
        }
        lexdb_sql.S_ROLLBACK {
            if len(s.txn) > 0 { s.st.abort(pop(mut &s.txn)) }
            s.failed = false
            s.restore()
            return Ok(tagOnly("ROLLBACK"))
        }
        else {}
    }
    if len(s.txn) > 0 {
        if s.failed {
            return Err(e("25P02", "current transaction is aborted, commands ignored until end of transaction block"))
        }
        if s.readOnly && isWrite(stmt.kind) {
            s.failed = true
            return Err(e("25006", "cannot execute " + stmtName(stmt.kind) + " in a read-only transaction"))
        }
        let st = s.st
        // UPDATE and DELETE read the live tree: the rows they change are
        // checked at COMMIT either way, and the latest is less often stale
        s.txn[0].live = stmt.kind == lexdb_sql.S_UPDATE || stmt.kind == lexdb_sql.S_DELETE || stmt.kind == lexdb_sql.S_INSERT
        let r = execIn(&st, mut &s.txn[0], stmt, params, ptypes, s.limits(), pc)
        s.txn[0].live = false
        if r.isErr() {
            s.failed = true
            return r
        }
        return r
    }
    var tries = 0
    let lim = s.limits()                    // retries share the statement's time
    while true {
        // A SELECT runs on a snapshot: it sees one state and never conflicts.
        // It may be long, letting other sessions run (Run.tick) and commit
        // meanwhile; run optimistically, it would conflict with them and
        // run again (design/lexdb.md 9.15). A snapshot whose old versions
        // went over their budget (72000) is tried again on a new one.
        let snap = stmt.kind == lexdb_sql.S_SELECT
        var t = if snap { try s.st.beginSnapshot() } else { lexdb_store.begin() }
        for n in s.path { append(mut &t.path, n) }
        match execIn(&s.st, mut &t, stmt, params, ptypes, lim, pc) {
            Ok(r) {
                match s.st.commit(t) {
                    Ok(_) { return Ok(r) }
                    Err(x) {
                        tries += 1
                        if x.state != lexdb_base.S_CONFLICT || tries >= 10 { return Err(x) }
                    }
                }
            }
            Err(x) {
                s.st.abort(t)
                tries += 1
                if !(snap && x.state == "72000") || tries >= 10 { return Err(x) }
            }
        }
    }
    return Err(e("XX000", "unreachable"))
}

// Parses and runs SQL text with no parameters (for the tests and tools).
pub fn (s: mut &Session) exec(sql: &str): Result[[]Res, DbErr] {
    let stmts = try lexdb_sql.parse(sql)
    var out: []Res = []
    let none: []Val = []
    let nt: []int = []
    for st in stmts { append(mut &out, try s.run(&st, &none, &nt)) }
    return Ok(out)
}
