// lexdb: running statements (design/lexdb.md 4.2, 4.8). Tables, rows and
// keys on the store's trees; the planner's rules; a session's transaction.
//
// The catalog is tree 1: table name -> its definition (its tree, columns,
// primary key), read and written in the statement's transaction like any
// row, so DDL is transactional. A row is one entry of its table's tree: the
// key is the primary key's columns, encoded so that byte order is SQL
// order; the value is every column.
//
// A secondary index is a tree of its own: per row, the indexed columns then
// the primary key as the key, the primary key as the value. Its definition
// is part of its table's catalog entry, and its name maps to the table.
//
// Plans are rules, not costs (choosePath): the primary key or an index,
// by its leading equalities and a range on the next column, else a full
// scan; every row is then checked against the WHERE. Joins run in FROM order,
// a nested loop through a key or an index when one fits, else a hash join.
import "binary"
import "strings"
import "collections"
import "time"
import "task"
import "os"
import "./lexdb_base"
import "./lexdb_time"
import "./lexdb_float"
import "./lexdb_pgcat"
import "./lexdb_auth"
import "regex"
import "math"
import "base64"
import "./lexdb_page"
import "./lexdb_store"
import "./lexdb_sql"

pub const CATALOG = 1

type Val = lexdb_sql.Val
type Expr = lexdb_sql.Expr
type DbErr = lexdb_base.DbErr

fn e(state: str, msg: str): DbErr { return lexdb_base.err(state, msg) }

pub type Index = record {
    pub name: str
    pub tree: int
    pub cols: []int
    pub unique: bool
    pub pred: Option[Expr]      // a filtered index: the rows it holds (column names bare)
    pub con: bool               // a UNIQUE constraint's (9.39): dropped with the constraint, not by DROP INDEX
}

pub type Table = record {
    pub name: str
    pub tree: int
    pub cols: []lexdb_sql.ColDef
    pub pk: []int
    pub indexes: []Index
    // Where each column is in a stored row, once a column has been dropped
    // (9.35): a column keeps its place, and a dropped one's is skipped.
    // [] when none has been: column i is at i.
    pub slots: []int
    pub width: int              // the places a row has (with slots)
    pub checks: []Check         // CHECK constraints (9.40)
    pub fks: []ForeignKey       // its foreign keys (9.41)
    pub refBy: []str            // the tables with foreign keys to it (itself among them if so)
    // The row layouts its rows may have (9.50): each place's kind (PK_*),
    // the last one the current. A row names its own; one is added when a
    // column is added, dropped or retyped, and rows are not rewritten.
    layouts: [][]byte
    lays: []FixedLay            // where each layout's places are (layOfKinds), not stored
    // A view (9.82): its query's text ("" a table), and the catalog keys of
    // the relations it reads; its cols are its output columns.
    pub view: str
    pub deps: []str
}

// A foreign key: cols of its table hold a key of table ref, refCols (a
// primary key or a unique index's columns, in any order). Columns by name.
pub type ForeignKey = record {
    pub name: str
    pub cols: []str
    pub ref: str                // the table's catalog key
    pub refCols: []str
    pub onDelete: int           // lexdb_sql.FK_*
    pub onUpdate: int
}

fn emptyTable(name: str): Table {
    return Table{name: name, tree: 0, cols: [], pk: [], indexes: [], slots: [], width: 0, checks: [], fks: [], refBy: [], layouts: [], lays: [],
                 view: "", deps: []}
}

// A CHECK constraint: a row may not make expr false (column names bare).
pub type Check = record { pub name: str; pub expr: Expr }

// A result column: its name and type OID.
pub type OutCol = value record { pub name: str; pub oid: int }

pub type Res = record {
    pub cols: []OutCol
    pub rows: [][]Val
    pub tag: str
    pub hasRows: bool       // a statement that returns rows (SELECT), even none
    pub copy: int           // COPY (9.45): COPY_IN, the client sends its rows now; COPY_OUT, rows are its lines
}

fn tagOnly(tag: str): Res { return Res{cols: [], rows: [], tag: tag, hasRows: false, copy: COPY_NONE} }

// ---- values

// The text a client sees for a value (NULL is told apart by the caller).
pub fn text(v: &Val): str {
    match v {
        Val.Null { return "" }
        Val.Int(n) { return n.toStr() }
        Val.Bool(b) { return if b { "t" } else { "f" } }
        Val.Num(d) { return d.toStr() }
        Val.Text(s) { return s }
        Val.Date(d) { return lexdb_time.fmtDate(d) }
        Val.Time(u) { return lexdb_time.fmtTime(u) }
        Val.Ts(u) { return lexdb_time.fmtTs(u) }
        Val.Tstz(u) { return lexdb_time.fmtTstz(u) }
        Val.Ival(iv) { return lexdb_time.fmtIval(&iv) }
        Val.Uuid(u) { return u }
        Val.Bytes(b) { return lexdb_sql.bytesHex(&b) }
        Val.Float(x) { return lexdb_float.fmt8(x) }
        Val.Real(x) { return lexdb_float.fmt4(x) }
        Val.Reg(_, n) { return n }
    }
}

pub fn isNull(v: &Val): bool {
    match v {
        Val.Null { return true }
        else { return false }
    }
}

fn kindName(t: &lexdb_sql.TypeName): str {
    if t.kind == lexdb_sql.K_INT {
        return if t.oid == lexdb_sql.OID_INT8 { "bigint" } else if t.oid == lexdb_sql.OID_INT2 { "smallint" } else { "integer" }
    }
    if t.kind == lexdb_sql.K_BOOL { return "boolean" }
    if t.kind == lexdb_sql.K_NUM { return "numeric" }
    if isTimeKind(t.kind) { return lexdb_sql.typeText(&lexdb_sql.timeType(t.oid)) }
    if t.kind == lexdb_sql.K_UUID { return "uuid" }
    if t.kind == lexdb_sql.K_BYTEA { return "bytea" }
    if t.kind == lexdb_sql.K_FLOAT { return if t.oid == lexdb_sql.OID_FLOAT4 { "real" } else { "double precision" } }
    if t.kind == lexdb_sql.K_REG || t.oid == lexdb_sql.OID_OID || t.oid == lexdb_sql.OID_NAME || t.oid == lexdb_sql.OID_CHAR { return lexdb_sql.typeText(t) }
    return if t.oid == lexdb_sql.OID_VARCHAR { "character varying" } else { "text" }
}

fn isTimeKind(k: int): bool { return k >= lexdb_sql.K_DATE && k <= lexdb_sql.K_IVAL }

fn badInput(t: &lexdb_sql.TypeName, s: &str): DbErr {
    return e("22P02", "invalid input syntax for type " + kindName(t) + ": \"" + s + "\"")
}

fn parseBool(s: &str): Option[bool] {
    let l = strings.toLowerAscii(strings.trim(s))
    if l == "t" || l == "true" || l == "yes" || l == "on" || l == "1" || l == "y" { return Some(true) }
    if l == "f" || l == "false" || l == "no" || l == "off" || l == "0" || l == "n" { return Some(false) }
    return None
}

fn intDigits(d: &Decimal): int {
    let s = d.abs().toStr()
    let dot = strings.indexOf(&s, ".", 0)
    let ip = if dot < 0 { s } else { s[0..dot] }
    if ip == "0" { return 0 }
    return len(ip)
}

fn intRange(t: &lexdb_sql.TypeName, n: int): Result[int, DbErr] {
    if t.oid == lexdb_sql.OID_INT4 && (n < -2147483648 || n > 2147483647) { return Err(e("22003", "integer out of range")) }
    if t.oid == lexdb_sql.OID_INT2 && (n < -32768 || n > 32767) { return Err(e("22003", "smallint out of range")) }
    return Ok(n)
}

// A value made fit for a column of type t (an assignment's conversion).
pub fn coerce(v: Val, t: &lexdb_sql.TypeName): Result[Val, DbErr] {
    match v {
        Val.Null { return Ok(Val.Null) }
        else {}
    }
    if t.kind == lexdb_sql.K_INT {
        match v {
            Val.Int(n) { return Ok(Val.Int(try intRange(t, n))) }
            Val.Num(d) {
                match d.toInt(Rounding.HALF_AWAY) {
                    Ok(n) { return Ok(Val.Int(try intRange(t, n))) }
                    Err(_) { return Err(e("22003", kindName(t) + " out of range")) }
                }
            }
            Val.Float(x) { return Ok(Val.Int(try floatToInt(x, t))) }
            Val.Real(x) { return Ok(Val.Int(try floatToInt(x, t))) }
            Val.Reg(o, _) { return Ok(Val.Int(o)) }
            Val.Text(s) {
                match strings.parseIntOpt(strings.trim(s)) {
                    Some(n) { return Ok(Val.Int(try intRange(t, n))) }
                    None { return Err(badInput(t, &s)) }
                }
            }
            else {}
        }
    } else if t.kind == lexdb_sql.K_BOOL {
        match v {
            Val.Bool(b) { return Ok(Val.Bool(b)) }
            Val.Text(s) {
                match parseBool(&s) {
                    Some(b) { return Ok(Val.Bool(b)) }
                    None { return Err(badInput(t, &s)) }
                }
            }
            else {}
        }
    } else if t.kind == lexdb_sql.K_NUM {
        var d = Decimal.zero()
        match v {
            Val.Int(n) { d = Decimal.fromInt(n) }
            Val.Num(x) { d = x }
            Val.Text(s) {
                match Decimal.parse(strings.trim(s)) {
                    Ok(x) { d = x }
                    Err(_) { return Err(badInput(t, &s)) }
                }
            }
            Val.Float(x) { d = try floatNum(x, false) }
            Val.Real(x) { d = try floatNum(x, true) }
            else { return Err(e("42804", "column is of type numeric but expression is of type boolean")) }
        }
        if t.prec > 0 {
            match d.quantize(t.scale, Rounding.HALF_AWAY) {
                Ok(q) { d = q }
                Err(_) { return Err(e("22003", "numeric field overflow")) }
            }
            if intDigits(&d) > t.prec - t.scale {
                return Err(e("22003", "numeric field overflow: a field with precision " + t.prec.toStr() + ", scale " +
                             t.scale.toStr() + " must round to an absolute value less than 10^" + (t.prec - t.scale).toStr()))
            }
        }
        return Ok(Val.Num(d))
    } else if isTimeKind(t.kind) {
        return coerceTime(v, t)
    } else if t.kind == lexdb_sql.K_FLOAT {
        return coerceFloat(v, t)
    } else if t.kind == lexdb_sql.K_REG {
        // without the catalog (eval's casts look names up: regCast)
        match v {
            Val.Reg(o, n) { return Ok(Val.Reg(o, n)) }
            else {
                match oidArg(&v) {
                    Some(o) { return Ok(Val.Reg(o, o.toStr())) }
                    None { return Err(e("0A000", "lexdb: a name cast to " + kindName(t) + " is not supported here")) }
                }
            }
        }
    } else if t.kind == lexdb_sql.K_UUID {
        match v {
            Val.Uuid(u) { return Ok(Val.Uuid(u)) }
            Val.Text(x) { return Ok(Val.Uuid(try parseUuid(&x))) }
            else { return Err(e("42846", "cannot cast type " + kindName(&oidType(kindOid(&v))) + " to uuid")) }
        }
    } else if t.kind == lexdb_sql.K_BYTEA {
        match v {
            Val.Bytes(x) { return Ok(Val.Bytes(x)) }
            Val.Text(x) { return Ok(Val.Bytes(try parseBytea(&x))) }
            else { return Err(e("42846", "cannot cast type " + kindName(&oidType(kindOid(&v))) + " to bytea")) }
        }
    } else if t.kind == lexdb_sql.K_ARRAY {
        match v {
            Val.Text(x) {
                let et = oidType(lexdb_sql.elemOid(t.oid))
                var vals: []Val = []
                for part in try arrayParts(&x) {
                    match part {
                        Some(p) { append(mut &vals, try coerce(Val.Text(p), &et)) }
                        None { append(mut &vals, Val.Null) }
                    }
                }
                return Ok(Val.Text(arrayText(&vals)))
            }
            else { return Err(e("42804", "cannot cast a " + kindName(&oidType(kindOid(&v))) + " to " + lexdb_sql.typeText(t))) }
        }
    } else {
        var s = ""
        match v {
            Val.Text(x) { s = x }
            Val.Int(n) { s = n.toStr() }
            Val.Num(d) { s = d.toStr() }
            Val.Bool(b) { s = if b { "true" } else { "false" } }
            else { s = text(&v) }
        }
        if t.len > 0 && strings.runeCount(&s) > t.len {
            return Err(e("22001", "value too long for type character varying(" + t.len.toStr() + ")"))
        }
        return Ok(Val.Text(s))
    }
    return Err(e("42804", "column is of type " + kindName(t) + " but the expression is of another type"))
}

// ---- real and double precision (9.79; lexdb_float)

fn isFloat(v: &Val): bool { return kindOf(v) == lexdb_sql.K_FLOAT }

fn isReal(v: &Val): bool {
    match v {
        Val.Real(_) { return true }
        else { return false }
    }
}

// A number as a double: an integer, numeric or float, or a text (a
// parameter) read as a double precision.
fn asFloat(v: &Val): Option[float] {
    match v {
        Val.Int(n) { return Some(float(n)) }
        Val.Num(d) { return math.parse(d.toStr()) }
        Val.Float(x) { return Some(x) }
        Val.Real(x) { return Some(x) }
        Val.Text(s) {
            match lexdb_float.parse(&s, false) {
                Ok(x) { return Some(x) }
                Err(_) { return None }
            }
        }
        else { return None }
    }
}

// A value made a real or double precision.
fn coerceFloat(v: Val, t: &lexdb_sql.TypeName): Result[Val, DbErr] {
    let real = t.oid == lexdb_sql.OID_FLOAT4
    var x = 0.0f
    match v {
        Val.Float(f) { x = f }
        Val.Real(f) { x = f }
        Val.Int(n) { x = float(n) }
        Val.Num(d) {
            x = math.parse(d.toStr()).unwrapOr(0.0f)
            if x.isInf() { return Err(e("22003", "value out of range: overflow")) }
        }
        Val.Text(s) { x = try lexdb_float.parse(&s, real) }
        else { return Err(e("42846", "cannot cast type " + kindName(&oidType(kindOid(&v))) + " to " + kindName(t))) }
    }
    if !real { return Ok(Val.Float(x)) }
    let r = lexdb_float.round4(x)
    if r.isInf() && !x.isInf() { return Err(e("22003", "value out of range: overflow")) }
    if r == 0.0f && x != 0.0f { return Err(e("22003", "value out of range: underflow")) }
    return Ok(Val.Real(r))
}

// A float as an integer type: rounded half to even, as PostgreSQL's rint.
fn floatToInt(x: float, t: &lexdb_sql.TypeName): Result[int, DbErr] {
    let r = x.roundEven()
    if x.isNaN() || r < -9223372036854775808.0f || r >= 9223372036854775808.0f {
        return Err(e("22003", kindName(t) + " out of range"))
    }
    return intRange(t, int(r))
}

// A float as a numeric: 15 significant digits (a real's 6).
fn floatNum(x: float, real: bool): Result[Decimal, DbErr] {
    match lexdb_float.numericText(x, real) {
        Some(s) {
            match Decimal.parse(s) {
                Ok(d) { return Ok(d) }
                Err(_) {}
            }
        }
        None {}
    }
    return Err(e("0A000", "lexdb: cannot convert " + lexdb_float.fmt8(x) + " to numeric"))
}

// Floats in order: NaN equal to itself and after every other value.
fn floatCmp(x: float, y: float): int {
    if x.isNaN() || y.isNaN() { return if x.isNaN() && y.isNaN() { 0 } else if x.isNaN() { 1 } else { -1 } }
    return if x < y { -1 } else if x > y { 1 } else { 0 }
}

// + - * / with a float: a real's with two reals (rounded to single
// precision), else a double's; overflow and underflow from finite operands
// are 22003, as in PostgreSQL.
fn arithFloat(op: &str, a: &Val, b: &Val): Result[Val, DbErr] {
    let real = isReal(a) && isReal(b)
    let xo = asFloat(a)
    let yo = asFloat(b)
    if xo.isNone() || yo.isNone() || !(op == "+" || op == "-" || op == "*" || op == "/") {
        return Err(e("42883", "operator does not exist: " + kindName(&oidType(kindOid(a))) + " " + op + " " +
                     kindName(&oidType(kindOid(b)))))
    }
    let x = xo.unwrap()
    let y = yo.unwrap()
    var r = 0.0f
    if op == "+" { r = x + y }
    else if op == "-" { r = x - y }
    else if op == "*" { r = x * y }
    else {
        if y == 0.0f { return Err(e("22012", "division by zero")) }
        r = x / y
    }
    if real { r = lexdb_float.round4(r) }
    if r.isInf() && !x.isInf() && !y.isInf() { return Err(e("22003", "value out of range: overflow")) }
    if r == 0.0f && x != 0.0f && ((op == "*" && y != 0.0f) || (op == "/" && !y.isInf())) {
        return Err(e("22003", "value out of range: underflow"))
    }
    return Ok(if real { Val.Real(r) } else { Val.Float(r) })
}

// A float function's argument as a double: an integer or float (a numeric is
// not: PostgreSQL's numeric versions answer in numeric digits).
fn floatArg(v: &Val, name: &str): Result[float, DbErr] {
    match v {
        Val.Int(n) { return Ok(float(n)) }
        Val.Float(x) { return Ok(x) }
        Val.Real(x) { return Ok(x) }
        else { return Err(e("0A000", "lexdb: " + name + " of a " + kindName(&oidType(kindOid(v))) + " is not supported (cast it to double precision)")) }
    }
}

// The math functions over double precision (9.79): one argument's, None if
// name is none of them.
fn callFloat(name: &str, v: &Val): Result[Option[Val], DbErr] {
    if name == "floor" || name == "ceil" || name == "ceiling" || name == "trunc" || name == "round" {
        // a numeric stays one (to 0 places); an integer or float is a double precision
        match asNum(v) {
            Some(d) {
                if !isFloat(v) && kindOf(v) != lexdb_sql.K_INT {
                    let r = if name == "floor" { d.floor(0) } else if name == "trunc" { d.trunc(0) } else if name == "round" { d.roundAway(0) } else { d.ceil(0) }
                    match r {
                        Ok(x) { return Ok(Some(Val.Num(x))) }
                        Err(_) { return Err(decErr()) }
                    }
                }
            }
            None {}
        }
        let x = try floatArg(v, name)
        let r = if name == "floor" { x.floor() } else if name == "trunc" { x.trunc() } else if name == "round" { x.roundEven() } else { x.ceil() }
        return Ok(Some(Val.Float(r)))
    }
    if name == "sqrt" || name == "cbrt" || name == "exp" || name == "ln" || name == "log10" {
        let x = try floatArg(v, name)
        if name == "sqrt" && x < 0.0f { return Err(e("2201F", "cannot take square root of a negative number")) }
        if (name == "ln" || name == "log10") && x == 0.0f { return Err(e("2201E", "cannot take logarithm of zero")) }
        if (name == "ln" || name == "log10") && x < 0.0f { return Err(e("2201E", "cannot take logarithm of a negative number")) }
        let r = if name == "sqrt" { x.sqrt() } else if name == "cbrt" { x.cbrt() } else if name == "exp" { x.exp() } else if name == "ln" { x.ln() } else { x.log10() }
        if r.isInf() && !x.isInf() { return Err(e("22003", "value out of range: overflow")) }
        if r == 0.0f && name == "exp" && !x.isInf() { return Err(e("22003", "value out of range: underflow")) }
        return Ok(Some(Val.Float(r)))
    }
    if name == "sign" {
        match v {
            Val.Int(n) { return Ok(Some(Val.Num(Decimal.fromInt(if n > 0 { 1 } else if n < 0 { -1 } else { 0 })))) }
            Val.Num(d) { return Ok(Some(Val.Num(Decimal.fromInt(if d.isNeg() { -1 } else if d.isZero() { 0 } else { 1 })))) }
            else {}
        }
        let x = try floatArg(v, name)
        return Ok(Some(Val.Float(if x > 0.0f { 1.0f } else if x < 0.0f { -1.0f } else { 0.0f })))
    }
    return Ok(None)
}

// power(x, y) over double precision.
fn powerOf(a: &Val, b: &Val): Result[Val, DbErr] {
    let x = try floatArg(a, &"power")
    let y = try floatArg(b, &"power")
    if x == 0.0f && y < 0.0f { return Err(e("2201F", "zero raised to a negative power is undefined")) }
    if x < 0.0f && y.floor() != y { return Err(e("2201F", "a negative number raised to a non-integer power yields a complex result")) }
    let r = x.pow(y)
    if r.isInf() && !x.isInf() && !y.isInf() { return Err(e("22003", "value out of range: overflow")) }
    if r == 0.0f && x != 0.0f && !y.isInf() { return Err(e("22003", "value out of range: underflow")) }
    return Ok(Val.Float(r))
}

// random(): a double in [0, 1), from the kernel's random bytes.
fn randomFloat(): Result[Val, DbErr] {
    var b = array(8, byte(0))
    if getrandom(mut &b, 8, u32(0)) != 8 { return Err(e("58000", "could not generate random values")) }
    var n = 0
    for i in 0..7 { n = n * 256 + int(b[i]) }
    n = n >> 3                  // 53 bits
    return Ok(Val.Float(float(n) / 9007199254740992.0f))
}

// A float's key: its bits in an order that sorts as the values do, -0 as
// 0, every NaN as one, after +Infinity.
fn floatKey(x: float): int {
    let bits = if x.isNaN() { 0x7ff8000000000000 } else if x == 0.0f { 0 } else { math.bitsOf(x) }
    return if bits < 0 { ~bits } else { bits ^ (-9223372036854775807 - 1) }
}

// ---- dates, times, timestamps and intervals (9.76; lexdb_time)

// A value made a date or time type: text read in PostgreSQL's forms, the
// date and time kinds converted (a timestamp to a timestamptz in the
// session's zone, and back), rounded to the type's fractional digits.
fn coerceTime(v: Val, t: &lexdb_sql.TypeName): Result[Val, DbErr] {
    let k = t.kind
    let p = if t.prec == 1 { t.scale } else { 6 }
    match v {
        Val.Text(s) {
            if k == lexdb_sql.K_DATE { return Ok(Val.Date(try lexdb_time.parseDate(&s))) }
            if k == lexdb_sql.K_TIME { return Ok(Val.Time(lexdb_time.roundUs(try lexdb_time.parseTime(&s), p))) }
            if k == lexdb_sql.K_TS { return Ok(Val.Ts(lexdb_time.roundUs(try lexdb_time.parseTs(&s), p))) }
            if k == lexdb_sql.K_TSTZ { return Ok(Val.Tstz(lexdb_time.roundUs(try lexdb_time.parseTstz(&s), p))) }
            let iv = try lexdb_time.parseIval(&s)
            return Ok(Val.Ival(lexdb_time.Ival{months: iv.months, days: iv.days, us: lexdb_time.roundUs(iv.us, p)}))
        }
        Val.Date(d) {
            if k == lexdb_sql.K_DATE { return Ok(Val.Date(d)) }
            if k == lexdb_sql.K_TS { return Ok(Val.Ts(lexdb_time.dateToTs(d))) }
            if k == lexdb_sql.K_TSTZ { return Ok(Val.Tstz(lexdb_time.tsToTstz(lexdb_time.dateToTs(d)))) }
        }
        Val.Ts(u) {
            if k == lexdb_sql.K_TS { return Ok(Val.Ts(lexdb_time.roundUs(u, p))) }
            if k == lexdb_sql.K_DATE { return Ok(Val.Date(lexdb_time.tsToDate(u))) }
            if k == lexdb_sql.K_TSTZ { return Ok(Val.Tstz(lexdb_time.roundUs(lexdb_time.tsToTstz(u), p))) }
            if k == lexdb_sql.K_TIME { return Ok(Val.Time(lexdb_time.roundUs(floorModInt(u, lexdb_time.DAY_US), p))) }
        }
        Val.Tstz(u) {
            if k == lexdb_sql.K_TSTZ { return Ok(Val.Tstz(lexdb_time.roundUs(u, p))) }
            let local = lexdb_time.tstzToTs(u)
            if k == lexdb_sql.K_TS { return Ok(Val.Ts(lexdb_time.roundUs(local, p))) }
            if k == lexdb_sql.K_DATE { return Ok(Val.Date(lexdb_time.tsToDate(local))) }
            if k == lexdb_sql.K_TIME { return Ok(Val.Time(lexdb_time.roundUs(floorModInt(local, lexdb_time.DAY_US), p))) }
        }
        Val.Time(u) {
            if k == lexdb_sql.K_TIME { return Ok(Val.Time(lexdb_time.roundUs(u, p))) }
            if k == lexdb_sql.K_IVAL { return Ok(Val.Ival(lexdb_time.Ival{months: 0, days: 0, us: u})) }
        }
        Val.Ival(iv) {
            if k == lexdb_sql.K_IVAL { return Ok(Val.Ival(lexdb_time.Ival{months: iv.months, days: iv.days, us: lexdb_time.roundUs(iv.us, p)})) }
            if k == lexdb_sql.K_TIME { return Ok(Val.Time(floorModInt(iv.us, lexdb_time.DAY_US))) }
        }
        else {}
    }
    return Err(e("42846", "cannot cast type " + kindName(&oidType(kindOid(&v))) + " to " + lexdb_sql.typeText(t)))
}

fn floorModInt(a: int, b: int): int {
    let r = a % b
    return if r < 0 { r + b } else { r }
}

// The type of a date or time value (a text's: the other side's type).
fn timeTypeOf(v: &Val): lexdb_sql.TypeName { return lexdb_sql.timeType(kindOid(v)) }

// A timestamp-like value as a timestamptz's microseconds (a date at
// midnight, a timestamp in the session's zone), for comparing across them.
fn asTstz(v: &Val): Option[int] {
    match v {
        Val.Date(d) { return Some(lexdb_time.tsToTstz(lexdb_time.dateToTs(d))) }
        Val.Ts(u) { return Some(lexdb_time.tsToTstz(u)) }
        Val.Tstz(u) { return Some(u) }
        else { return None }
    }
}

// Compares two values of which one is a date or time kind: the same kind
// directly, a date, timestamp and timestamptz with each other, a text read
// as the other's type.
fn compareTime(a: &Val, b: &Val): Result[int, DbErr] {
    match a {
        Val.Text(s) {
            let x = try coerce(Val.Text(s), &timeTypeOf(b))
            return compareTime(&x, b)
        }
        else {}
    }
    match b {
        Val.Text(s) {
            let y = try coerce(Val.Text(s), &timeTypeOf(a))
            return compareTime(a, &y)
        }
        else {}
    }
    match a {
        Val.Date(x) { match b { Val.Date(y) { return Ok(x.cmp(&y)) } else {} } }
        Val.Ts(x) { match b { Val.Ts(y) { return Ok(x.cmp(&y)) } else {} } }
        Val.Tstz(x) { match b { Val.Tstz(y) { return Ok(x.cmp(&y)) } else {} } }
        Val.Time(x) { match b { Val.Time(y) { return Ok(x.cmp(&y)) } else {} } }
        Val.Ival(x) { match b { Val.Ival(y) { return Ok(lexdb_time.ivalCmp(&x, &y)) } else {} } }
        else {}
    }
    match asTstz(a) {
        Some(x) {
            match asTstz(b) {
                Some(y) { return Ok(x.cmp(&y)) }
                None {}
            }
        }
        None {}
    }
    return Err(e("42883", "operator does not exist: " + kindName(&oidType(kindOid(a))) + " compared with " +
                 kindName(&oidType(kindOid(b)))))
}

fn opErr(op: &str, a: &Val, b: &Val): DbErr {
    return e("42883", "operator does not exist: " + kindName(&oidType(kindOid(a))) + " " + op + " " + kindName(&oidType(kindOid(b))))
}

fn intOf(v: &Val): Option[int] {
    match v {
        Val.Int(n) { return Some(n) }
        Val.Text(s) { return strings.parseIntOpt(strings.trim(s)) }
        else { return None }
    }
}

fn ivalOfVal(v: &Val): Result[Option[lexdb_time.Ival], DbErr] {
    match v {
        Val.Ival(iv) { return Ok(Some(iv)) }
        Val.Text(s) { return Ok(Some(try lexdb_time.parseIval(&s))) }
        else { return Ok(None) }
    }
}

// Arithmetic with a date or time kind, as PostgreSQL's operators: a date
// and days, dates' difference in days, a date-time and an interval, the
// difference of two date-times, intervals with each other and times a
// number. A text on one side is read as the type the operator needs.
fn arithTime(op: &str, a: &Val, b: &Val): Result[Val, DbErr] {
    let plus = op == "+"
    let minus = op == "-"
    match a {
        Val.Date(d) {
            if plus || minus {
                match b {
                    Val.Date(d2) { if minus { return Ok(Val.Int(d - d2)) } }
                    Val.Time(t) { if plus { return Ok(Val.Ts(lexdb_time.dateToTs(d) + t)) } }
                    Val.Ival(iv) {
                        let x = if minus { lexdb_time.ivalNeg(&iv) } else { iv }
                        return Ok(Val.Ts(try lexdb_time.tsPlus(lexdb_time.dateToTs(d), &x)))
                    }
                    Val.Int(n) { return Ok(Val.Date(if plus { d + n } else { d - n })) }
                    Val.Text(s) {
                        match strings.parseIntOpt(strings.trim(s)) {
                            Some(n) { return Ok(Val.Date(if plus { d + n } else { d - n })) }
                            None {}
                        }
                        if minus {
                            match lexdb_time.parseDate(&s) {
                                Ok(d2) { return Ok(Val.Int(d - d2)) }
                                Err(_) {}
                            }
                        }
                        return arithTime(op, a, &Val.Ival(try lexdb_time.parseIval(&s)))
                    }
                    else {}
                }
            }
        }
        Val.Ts(u) {
            if plus || minus {
                match b {
                    Val.Ts(u2) { if minus { return Ok(Val.Ival(try lexdb_time.tsDiff(u, u2))) } }
                    Val.Text(s) {
                        // timestamp - '...': a timestamp, as PostgreSQL reads it
                        if minus { return arithTime(op, a, &Val.Ts(try lexdb_time.parseTs(&s))) }
                    }
                    else {}
                }
                match try ivalOfVal(b) {
                    Some(iv) {
                        let x = if minus { lexdb_time.ivalNeg(&iv) } else { iv }
                        return Ok(Val.Ts(try lexdb_time.tsPlus(u, &x)))
                    }
                    None {}
                }
            }
        }
        Val.Tstz(u) {
            if plus || minus {
                match b {
                    Val.Tstz(u2) { if minus { return Ok(Val.Ival(try lexdb_time.tsDiff(u, u2))) } }
                    Val.Text(s) {
                        if minus { return arithTime(op, a, &Val.Tstz(try lexdb_time.parseTstz(&s))) }
                    }
                    else {}
                }
                match try ivalOfVal(b) {
                    Some(iv) {
                        let x = if minus { lexdb_time.ivalNeg(&iv) } else { iv }
                        return Ok(Val.Tstz(try lexdb_time.tstzPlus(u, &x)))
                    }
                    None {}
                }
            }
        }
        Val.Time(t) {
            if plus || minus {
                match b {
                    Val.Time(t2) { if minus { return Ok(Val.Ival(lexdb_time.Ival{months: 0, days: 0, us: t - t2})) } }
                    Val.Date(d) { if plus { return Ok(Val.Ts(lexdb_time.dateToTs(d) + t)) } }
                    else {}
                }
                match try ivalOfVal(b) {
                    Some(iv) { return Ok(Val.Time(floorModInt(if plus { t + iv.us } else { t - iv.us }, lexdb_time.DAY_US))) }
                    None {}
                }
            }
        }
        Val.Ival(iv) {
            if plus || minus {
                match b {
                    Val.Ival(iv2) { return Ok(Val.Ival(lexdb_time.ivalPlus(&iv, &(if minus { lexdb_time.ivalNeg(&iv2) } else { iv2 })))) }
                    Val.Text(s) { return arithTime(op, a, &Val.Ival(try lexdb_time.parseIval(&s))) }
                    else {}
                }
                if plus { return arithTime(op, b, a) }      // interval + a date-time
            }
            if op == "*" || op == "/" {
                match asNum(b) {
                    Some(f) {
                        return Ok(Val.Ival(if op == "*" { try lexdb_time.ivalTimes(&iv, &f) } else { try lexdb_time.ivalDiv(&iv, &f) }))
                    }
                    None {}
                }
            }
        }
        else {
            // a number times an interval; a text before a date-time
            if op == "*" {
                match b { Val.Ival(_) { return arithTime(op, b, a) } else {} }
            }
            if plus {
                match b {
                    Val.Date(_) { return arithTime(op, b, a) }
                    Val.Ts(_) { return arithTime(op, b, a) }
                    Val.Tstz(_) { return arithTime(op, b, a) }
                    Val.Time(_) { return arithTime(op, b, a) }
                    else {}
                }
            }
            match a {
                Val.Text(s) {
                    // '2026-01-02' - date '2026-01-01', '...' - interval: the text as the other's type
                    match b {
                        Val.Ival(_) {}
                        else {
                            if isTimeKind(kindOf(b)) { return arithTime(op, &(try coerce(Val.Text(s), &timeTypeOf(b))), b) }
                        }
                    }
                }
                else {}
            }
        }
    }
    return Err(opErr(op, a, b))
}

// The date and time functions (9.76): None when name is not one.
// now: the transaction's start (microseconds since 2000), 0 for the clock.
fn callTime(name: &str, vs: &[]Val, now: int): Result[Option[Val], DbErr] {
    let n = len(vs)
    let prec = if n == 1 { intOf(&vs[0]).unwrapOr(6) } else { 6 }
    // the transaction's start, as PostgreSQL's now(); clock_timestamp() the clock
    let at = if now != 0 && name != "clock_timestamp" { now } else { lexdb_time.nowTstz() }
    let local = lexdb_time.tstzToTs(at)
    match name {
        "now", "current_timestamp", "transaction_timestamp", "statement_timestamp", "clock_timestamp" {
            return Ok(Some(Val.Tstz(lexdb_time.roundUs(at, prec))))
        }
        "localtimestamp" { return Ok(Some(Val.Ts(lexdb_time.roundUs(local, prec)))) }
        "current_date" { return Ok(Some(Val.Date(lexdb_time.tsToDate(local)))) }
        "current_time", "localtime" { return Ok(Some(Val.Time(lexdb_time.roundUs(floorModInt(local, lexdb_time.DAY_US), prec)))) }
        "date_part", "date_trunc", "age", "make_date", "to_timestamp", "isfinite" {}
        else { return Ok(None) }                // not a date or time function
    }
    for v in vs { if isNull(&v) { return Ok(Some(Val.Null)) } }
    if (name == "date_part" || name == "date_trunc") && n == 2 {
        let field = text(&vs[0])
        var x = vs[1]
        match x {
            Val.Text(s) { x = Val.Tstz(try lexdb_time.parseTstz(&s)) }
            else {}
        }
        if name == "date_part" {
            match x {
                Val.Date(d) {
                    // a date's fields are whole numbers (its epoch and Julian day too)
                    try lexdb_time.dateField(&field)
                    let u = lexdb_time.dateToTs(d)
                    let xd = try lexdb_time.extractTs(&field, u, u, &"date")
                    return Ok(Some(Val.Num(xd.trunc(0).unwrapOr(xd))))
                }
                Val.Ts(u) { return Ok(Some(Val.Num(try lexdb_time.extractTs(&field, u, u, &"timestamp without time zone")))) }
                Val.Tstz(u) { return Ok(Some(Val.Num(try lexdb_time.extractTs(&field, lexdb_time.tstzToTs(u), u, &"timestamp with time zone")))) }
                Val.Time(u) { return Ok(Some(Val.Num(try lexdb_time.extractIval(&field, &lexdb_time.Ival{months: 0, days: 0, us: u})))) }
                Val.Ival(iv) { return Ok(Some(Val.Num(try lexdb_time.extractIval(&field, &iv)))) }
                else { return Err(e("42883", "function date_part(text, " + kindName(&oidType(kindOid(&x))) + ") does not exist")) }
            }
        }
        match x {
            Val.Date(d) { return Ok(Some(Val.Tstz(lexdb_time.tsToTstz(try lexdb_time.truncTs(&field, lexdb_time.dateToTs(d)))))) }
            Val.Ts(u) { return Ok(Some(Val.Ts(try lexdb_time.truncTs(&field, u)))) }
            Val.Tstz(u) { return Ok(Some(Val.Tstz(lexdb_time.tsToTstz(try lexdb_time.truncTs(&field, lexdb_time.tstzToTs(u)))))) }
            Val.Ival(iv) { return Ok(Some(Val.Ival(try lexdb_time.truncIval(&field, &iv)))) }
            else { return Err(e("42883", "function date_trunc(text, " + kindName(&oidType(kindOid(&x))) + ") does not exist")) }
        }
    }
    if name == "age" && (n == 1 || n == 2) {
        let a = if n == 2 { try tsOfVal(&vs[0]) } else { lexdb_time.dateToTs(lexdb_time.today()) }
        let b = try tsOfVal(&vs[n - 1])
        return Ok(Some(Val.Ival(try lexdb_time.age(a, b))))
    }
    if name == "make_date" && n == 3 {
        match intOf(&vs[0]) {
            Some(y) {
                match intOf(&vs[1]) {
                    Some(m) {
                        match intOf(&vs[2]) {
                            Some(d) { return Ok(Some(Val.Date(try lexdb_time.makeDate(y, m, d)))) }
                            None {}
                        }
                    }
                    None {}
                }
            }
            None {}
        }
        return Err(e("42883", "function make_date needs three integers"))
    }
    if name == "to_timestamp" && n == 1 {
        match asNum(&vs[0]) {
            Some(d) { return Ok(Some(Val.Tstz(try lexdb_time.fromEpochSeconds(&d)))) }
            None { return Err(e("42883", "function to_timestamp(text) does not exist")) }
        }
    }
    if name == "isfinite" && n == 1 {
        match vs[0] {
            Val.Date(d) { return Ok(Some(Val.Bool(d != lexdb_time.INF && d != lexdb_time.NINF))) }
            Val.Ts(u) { return Ok(Some(Val.Bool(u != lexdb_time.INF && u != lexdb_time.NINF))) }
            Val.Tstz(u) { return Ok(Some(Val.Bool(u != lexdb_time.INF && u != lexdb_time.NINF))) }
            Val.Ival(_) { return Ok(Some(Val.Bool(true))) }
            else {}
        }
    }
    return Ok(None)
}

// A timestamp's local microseconds for age(): a date at midnight, a
// timestamptz in the session's zone.
fn tsOfVal(v: &Val): Result[int, DbErr] {
    match v {
        Val.Date(d) { return Ok(lexdb_time.dateToTs(d)) }
        Val.Ts(u) { return Ok(u) }
        Val.Tstz(u) { return Ok(lexdb_time.tstzToTs(u)) }
        Val.Text(s) { return Ok(try lexdb_time.parseTs(&s)) }
        else { return Err(e("42883", "function age(" + kindName(&oidType(kindOid(v))) + ") does not exist")) }
    }
}

// The result type of a date or time operator (0: not one).
fn timeOpOid(op: &str, l: int, r: int): int {
    let tl = lexdb_sql.timeKind(l)
    let tr = lexdb_sql.timeKind(r)
    if tl == 0 && tr == 0 { return 0 }
    let D = lexdb_sql.OID_DATE
    let T = lexdb_sql.OID_TIME
    let TS = lexdb_sql.OID_TS
    let TZ = lexdb_sql.OID_TSTZ
    let IV = lexdb_sql.OID_IVAL
    if op == "*" || op == "/" { return IV }
    if l == D && r == D { return if op == "-" { lexdb_sql.OID_INT4 } else { 0 } }
    if l == D && r == IV || l == IV && r == D { return TS }
    if l == D && r == T || l == T && r == D { return TS }
    if l == D { return D }                              // a date and days
    if r == D && op == "+" { return D }
    if (l == TS && r == TS) || (l == TZ && r == TZ) || (l == T && r == T) { return if op == "-" { IV } else { 0 } }
    if l == TS || r == TS { return TS }
    if l == TZ || r == TZ { return TZ }
    if l == T || r == T { return T }
    return IV
}

// ---- arrays (9.27): one dimension, held as PostgreSQL's text form

// The elements of an array's text form, {a,"b c",NULL}: None for NULL.
fn arrayParts(s: &str): Result[[]Option[str], DbErr] {
    let bad = e("22P02", "malformed array literal: \"" + s + "\"")
    var out: []Option[str] = []
    var i = 0
    let n = len(s)
    while i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n') { i += 1 }
    if i < n && s[i] != '{' {
        // an int2vector's or oidvector's form: numbers and spaces (9.80)
        for c in 0..n { if !((s[c] >= '0' && s[c] <= '9') || s[c] == ' ' || s[c] == '-') { return Err(bad) } }
        for f in strings.split(s, " ") { if len(f) > 0 { append(mut &out, Some(f.toStr())) } }
        return Ok(out)
    }
    if i >= n { return Err(bad) }
    i += 1
    while i < n && s[i] == ' ' { i += 1 }
    if i < n && s[i] == '}' { return Ok(out) }
    while true {
        while i < n && s[i] == ' ' { i += 1 }
        if i >= n { return Err(bad) }
        if s[i] == '{' { return Err(e("0A000", "lexdb: arrays of more than one dimension are not supported")) }
        if s[i] == '"' {
            var b = newStrBuf()
            i += 1
            while i < n && s[i] != '"' {
                if s[i] == '\\' { i += 1 }
                if i >= n { return Err(bad) }
                b.addByte(s[i])
                i += 1
            }
            if i >= n { return Err(bad) }
            i += 1
            append(mut &out, Some(b.toStr()))
        } else {
            var b = newStrBuf()
            while i < n && s[i] != ',' && s[i] != '}' {
                if s[i] == '\\' { i += 1 }
                if i >= n { return Err(bad) }
                b.addByte(s[i])
                i += 1
            }
            let w = strings.trim(b.toStr())
            if len(w) == 0 { return Err(bad) }
            if strings.toLowerAscii(w) == "null" { append(mut &out, None) } else { append(mut &out, Some(w)) }
        }
        while i < n && s[i] == ' ' { i += 1 }
        if i >= n { return Err(bad) }
        if s[i] == '}' {
            i += 1
            break
        }
        if s[i] != ',' { return Err(bad) }
        i += 1
    }
    while i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n') { i += 1 }
    if i != n { return Err(bad) }
    return Ok(out)
}

// An array's text form: elements quoted when they must be.
pub fn arrayText(vals: &[]Val): str {
    var b = newStrBuf()
    b.addByte('{')
    for i in 0..len(vals) {
        if i > 0 { b.addByte(',') }
        match vals[i] {
            Val.Null { b.add("NULL") }
            Val.Bool(x) { b.add(if x { "t" } else { "f" }) }
            Val.Text(x) {
                var plain = len(x) > 0 && strings.toLowerAscii(x) != "null"
                for k in 0..len(x) {
                    let c = x[k]
                    if c == ',' || c == '{' || c == '}' || c == '"' || c == '\\' || c == ' ' || c == '\t' || c == '\n' { plain = false }
                }
                if plain { b.add(x) } else {
                    b.addByte('"')
                    for k in 0..len(x) {
                        if x[k] == '"' || x[k] == '\\' { b.addByte('\\') }
                        b.addByte(x[k])
                    }
                    b.addByte('"')
                }
            }
            else { b.add(text(&vals[i])) }
        }
    }
    b.addByte('}')
    return b.toStr()
}

// x op ANY (array), x op ALL (array), as PostgreSQL: ANY is true if one
// comparison is, else NULL if one is NULL, else false (an empty array:
// false); ALL is false if one is false, else NULL if one is NULL, else true.
// The elements are read as x's type.
fn quantified(name: &str, x: &Val, arr: &Val): Result[Val, DbErr] {
    let all = strings.startsWith(name, "all ")
    let op = name[4..len(name)]
    let a = match arr {
        Val.Text(t) { t }
        Val.Null { return Ok(Val.Null) }
        else { return Err(e("42809", "op ANY/ALL (array) requires an array on the right")) }
    }
    let parts = try arrayParts(&a)
    if len(parts) == 0 { return Ok(Val.Bool(all)) }
    if isNull(x) { return Ok(Val.Null) }
    let ty = oidType(if kindOf(x) == lexdb_sql.K_INT { lexdb_sql.OID_INT8 } else { kindOid(x) })
    var sawNull = false
    for part in parts {
        match part {
            None { sawNull = true }
            Some(p) {
                let v = try coerce(Val.Text(p), &ty)
                let c = try compare(x, &v)
                let ok = if op == "=" { c == 0 } else if op == "<>" { c != 0 } else if op == "<" { c < 0 } else if op == "<=" { c <= 0 } else if op == ">" { c > 0 } else { c >= 0 }
                if ok && !all { return Ok(Val.Bool(true)) }
                if !ok && all { return Ok(Val.Bool(false)) }
            }
        }
    }
    if sawNull { return Ok(Val.Null) }
    return Ok(Val.Bool(all))
}

// A value's type OID by its kind (for messages).
fn kindOid(v: &Val): int {
    match v {
        Val.Int(_) { return lexdb_sql.OID_INT8 }
        Val.Bool(_) { return lexdb_sql.OID_BOOL }
        Val.Num(_) { return lexdb_sql.OID_NUMERIC }
        Val.Date(_) { return lexdb_sql.OID_DATE }
        Val.Time(_) { return lexdb_sql.OID_TIME }
        Val.Ts(_) { return lexdb_sql.OID_TS }
        Val.Tstz(_) { return lexdb_sql.OID_TSTZ }
        Val.Ival(_) { return lexdb_sql.OID_IVAL }
        Val.Uuid(_) { return lexdb_sql.OID_UUID }
        Val.Bytes(_) { return lexdb_sql.OID_BYTEA }
        Val.Float(_) { return lexdb_sql.OID_FLOAT8 }
        Val.Real(_) { return lexdb_sql.OID_FLOAT4 }
        Val.Reg(_, _) { return lexdb_sql.OID_REGCLASS }
        else { return lexdb_sql.OID_TEXT }
    }
}

// A function in FROM: its columns, from its arguments' types.
fn srfCols(name: &str, ordin: bool, args: &[]OutCol): Result[[]OutCol, DbErr] {
    var out: []OutCol = []
    if name == "pg_partition_ancestors" {
        append(mut &out, OutCol{name: "relid", oid: lexdb_sql.OID_REGCLASS})
        if ordin { append(mut &out, OutCol{name: "ordinality", oid: lexdb_sql.OID_INT8}) }
        return Ok(out)
    }
    if strings.startsWith(name, "#values:") {
        // VALUES (9.80): a column's type is its first typed value's
        let k = strings.parseIntOpt(name[8..len(name)]).unwrapOr(1)
        for c in 0..k {
            var oid = lexdb_sql.OID_TEXT
            var r = c
            while r < len(args) {
                if args[r].oid != lexdb_sql.OID_TEXT && args[r].oid != lexdb_sql.OID_UNKNOWN { oid = args[r].oid }
                if oid != lexdb_sql.OID_TEXT { break }
                r += k
            }
            append(mut &out, OutCol{name: "column" + (c + 1).toStr(), oid: oid})
        }
        return Ok(out)
    }
    if strings.startsWith(name, "#") {
        // a catalog relation (9.80)
        for c in lexdb_pgcat.relCols(&name[1..len(name)]) { append(mut &out, OutCol{name: c.name, oid: c.oid}) }
        return Ok(out)
    }
    if name == "generate_series" {
        if len(args) < 2 || len(args) > 3 {
            return Err(e("42883", "function generate_series with " + len(args).toStr() + " arguments does not exist"))
        }
        var oid = lexdb_sql.OID_INT4
        for a in args {
            if a.oid == lexdb_sql.OID_NUMERIC { oid = lexdb_sql.OID_NUMERIC }
            else if oid != lexdb_sql.OID_NUMERIC && a.oid != lexdb_sql.OID_INT4 && a.oid != lexdb_sql.OID_INT2 { oid = lexdb_sql.OID_INT8 }
        }
        for a in args {
            let k = oidType(a.oid).kind
            if k != lexdb_sql.K_INT && k != lexdb_sql.K_NUM && a.oid != lexdb_sql.OID_TEXT {
                return Err(e("42883", "function generate_series needs numbers"))
            }
        }
        append(mut &out, OutCol{name: "generate_series", oid: oid})
    } else {
        if len(args) == 0 { return Err(e("42883", "function unnest() does not exist")) }
        for k in 0..len(args) {
            let el = lexdb_sql.elemOid(args[k].oid)
            if el == 0 {
                return Err(e("42804", "function unnest: argument " + (k + 1).toStr() + " is not an array (cast it: $1::int[], '{1,2}'::text[])"))
            }
            append(mut &out, OutCol{name: "unnest", oid: el})
        }
    }
    if ordin { append(mut &out, OutCol{name: "ordinality", oid: lexdb_sql.OID_INT8}) }
    return Ok(out)
}

// A function in FROM, run: its arguments, then its rows.
fn execSrf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int,
           rs: mut &Run): Result[Res, DbErr] {
    let sqe = seqEnv(st, txn)
    let m = try prepare(st, txn, &sel.q, params, rs)
    let noRow: []Val = []
    let env = Env{cols: &sel.q.cols, row: &noRow, aggs: &noRow, params: params, subs: &m.subs, cur: &noRow, seq: sqe}
    var args: []Val = []
    for x in sel.exprs { append(mut &args, try evalX(st, txn, &sel.q, &x, &env, rs)) }
    var rows: [][]Val = []
    let room = rs.room()
    var bytes = 0
    if sel.srf == "pg_partition_ancestors" {
        // no partitions in lexdb: a relation is its only ancestor
        if len(args) == 1 && !isNull(&args[0]) {
            let o = oidArg(&args[0]).unwrapOr(0)
            var row: []Val = [Val.Reg(o, o.toStr())]
            if sel.ordin { append(mut &row, Val.Int(1)) }
            append(mut &rows, row)
        }
    } else if strings.startsWith(&sel.srf, "#values:") {
        let k = len(sel.outs)
        var i = 0
        while i + k <= len(args) {
            var row: []Val = []
            for c in 0..k {
                let ty = oidType(sel.outs[c].oid)
                append(mut &row, if ty.kind == lexdb_sql.K_TEXT { args[i + c] } else { try coerce(args[i + c], &ty) })
            }
            append(mut &rows, row)
            i += k
        }
    } else if strings.startsWith(&sel.srf, "#") {
        rows = try catRows(st, txn, &sel.srf[1..len(sel.srf)])
    } else if sel.srf == "generate_series" {
        for a in args { if isNull(&a) { return Ok(Res{cols: [], rows: [], tag: "", hasRows: true, copy: COPY_NONE}) } }
        let ty = oidType(sel.outs[0].oid)
        let start = try coerce(args[0], &ty)
        let stop = try coerce(args[1], &ty)
        let step = if len(args) > 2 { try coerce(args[2], &ty) } else { try coerce(Val.Int(1), &ty) }
        let zero = try coerce(Val.Int(0), &ty)
        let dir = try compare(&step, &zero)
        if dir == 0 { return Err(e("22023", "step size cannot equal zero")) }
        var v = start
        var n = 0
        while true {
            let c = try compare(&v, &stop)
            if (dir > 0 && c > 0) || (dir < 0 && c < 0) { break }
            if cap >= 0 && len(rows) >= cap { break }
            n += 1
            var row: []Val = [v]
            if sel.ordin { append(mut &row, Val.Int(n)) }
            bytes += rowBytes(&row)
            if room >= 0 && bytes > room { return Err(memErr(rs.maxHeld)) }
            append(mut &rows, row)
            try rs.tick()
            // the next value; past the type's range: the end
            match arith(&"+", &v, &step) {
                Ok(x) { v = x }
                Err(_) { break }
            }
            if ty.kind == lexdb_sql.K_INT {
                match coerce(v, &ty) {
                    Ok(x) { v = x }
                    Err(_) { break }
                }
            }
        }
    } else {
        // unnest: the arrays side by side, the shorter padded with NULLs
        var cols: [][]Val = []
        var most = 0
        for k in 0..len(args) {
            var vals: []Val = []
            match args[k] {
                Val.Text(x) {
                    let et = oidType(sel.outs[k].oid)
                    for part in try arrayParts(&x) {
                        match part {
                            Some(p) { append(mut &vals, try coerce(Val.Text(p), &et)) }
                            None { append(mut &vals, Val.Null) }
                        }
                    }
                }
                else {}
            }
            if len(vals) > most { most = len(vals) }
            append(mut &cols, vals)
        }
        for i in 0..most {
            if cap >= 0 && len(rows) >= cap { break }
            var row: []Val = []
            for k in 0..len(cols) { append(mut &row, if i < len(cols[k]) { cols[k][i] } else { Val.Null }) }
            if sel.ordin { append(mut &row, Val.Int(i + 1)) }
            bytes += rowBytes(&row)
            if room >= 0 && bytes > room { return Err(memErr(rs.maxHeld)) }
            append(mut &rows, row)
            try rs.tick()
        }
    }
    return Ok(Res{cols: [], rows: rows, tag: "", hasRows: true, copy: COPY_NONE})
}

fn kindOf(v: &Val): int {
    match v {
        Val.Null { return 0 }
        Val.Int(_) { return lexdb_sql.K_INT }
        Val.Bool(_) { return lexdb_sql.K_BOOL }
        Val.Num(_) { return lexdb_sql.K_NUM }
        Val.Text(_) { return lexdb_sql.K_TEXT }
        Val.Date(_) { return lexdb_sql.K_DATE }
        Val.Time(_) { return lexdb_sql.K_TIME }
        Val.Ts(_) { return lexdb_sql.K_TS }
        Val.Tstz(_) { return lexdb_sql.K_TSTZ }
        Val.Ival(_) { return lexdb_sql.K_IVAL }
        Val.Uuid(_) { return lexdb_sql.K_UUID }
        Val.Bytes(_) { return lexdb_sql.K_BYTEA }
        Val.Float(_) { return lexdb_sql.K_FLOAT }
        Val.Real(_) { return lexdb_sql.K_FLOAT }
        Val.Reg(_, _) { return lexdb_sql.K_REG }
    }
}

fn asNum(v: &Val): Option[Decimal] {
    match v {
        Val.Int(n) { return Some(Decimal.fromInt(n)) }
        Val.Num(d) { return Some(d) }
        Val.Float(x) { return floatNum(x, false).ok() }
        Val.Real(x) { return floatNum(x, true).ok() }
        Val.Text(s) {
            match Decimal.parse(strings.trim(s)) {
                Ok(d) { return Some(d) }
                Err(_) { return None }
            }
        }
        else { return None }
    }
}

// Compares two values that are not NULL; a text compared with a number or a
// boolean is read as one (a parameter sent as text).
fn compare(a: &Val, b: &Val): Result[int, DbErr] {
    let ka = kindOf(a)
    let kb = kindOf(b)
    if isTimeKind(ka) || isTimeKind(kb) { return compareTime(a, b) }
    if ka == lexdb_sql.K_UUID || kb == lexdb_sql.K_UUID || ka == lexdb_sql.K_BYTEA || kb == lexdb_sql.K_BYTEA {
        // a text with either is read as its type; then as bytes, which is their order
        let k = if ka == lexdb_sql.K_UUID || kb == lexdb_sql.K_UUID { lexdb_sql.K_UUID } else { lexdb_sql.K_BYTEA }
        let ty = oidType(if k == lexdb_sql.K_UUID { lexdb_sql.OID_UUID } else { lexdb_sql.OID_BYTEA })
        let x = try coerce(a, &ty)
        let y = try coerce(b, &ty)
        return Ok(text(&x).cmp(&text(&y)))
    }
    if ka == lexdb_sql.K_REG || kb == lexdb_sql.K_REG {
        // a reg type compares as its OID
        match oidArg(a) {
            Some(x) {
                match oidArg(b) {
                    Some(y) { return Ok(x.cmp(&y)) }
                    None {}
                }
            }
            None {}
        }
    }
    if ka == lexdb_sql.K_FLOAT || kb == lexdb_sql.K_FLOAT {
        match asFloat(a) {
            Some(x) {
                match asFloat(b) {
                    Some(y) { return Ok(floatCmp(x, y)) }
                    None {}
                }
            }
            None {}
        }
    }
    match a {
        Val.Int(x) {
            match b {
                Val.Int(y) { return Ok(x.cmp(&y)) }
                Val.Text(s) {
                    match strings.parseIntOpt(strings.trim(s)) {
                        Some(y) { return Ok(x.cmp(&y)) }
                        None {}
                    }
                }
                else {}
            }
        }
        Val.Text(x) {
            match b {
                Val.Text(y) { return Ok(x.cmp(&y)) }
                Val.Int(_) {
                    let r = try compare(b, a)
                    return Ok(-r)
                }
                Val.Bool(_) {
                    let r = try compare(b, a)
                    return Ok(-r)
                }
                Val.Num(_) {
                    let r = try compare(b, a)
                    return Ok(-r)
                }
                else {}
            }
        }
        Val.Bool(x) {
            let y = match b {
                Val.Bool(v) { Some(v) }
                Val.Text(s) { parseBool(&s) }
                else { None }
            }
            match y {
                Some(v) { return Ok(if x == v { 0 } else if !x { -1 } else { 1 }) }
                None {}
            }
        }
        else {}
    }
    if ka == lexdb_sql.K_NUM || kb == lexdb_sql.K_NUM {
        match asNum(a) {
            Some(x) {
                match asNum(b) {
                    Some(y) { return Ok(x.cmp(&y)) }
                    None {}
                }
            }
            None {}
        }
    }
    return Err(e("42883", "operator does not exist: " + text(a) + " compared with " + text(b)))
}

fn decErr(): DbErr { return e("22003", "numeric value out of range") }

fn arith(op: &str, a: &Val, b: &Val): Result[Val, DbErr] {
    if isNull(a) || isNull(b) { return Ok(Val.Null) }
    if isTimeKind(kindOf(a)) || isTimeKind(kindOf(b)) { return arithTime(op, a, b) }
    if isFloat(a) || isFloat(b) { return arithFloat(op, a, b) }
    var x = 0
    var y = 0
    var ints = false
    match a {
        Val.Int(n) {
            match b {
                Val.Int(m) {
                    x = n
                    y = m
                    ints = true
                }
                Val.Text(s) {
                    match strings.parseIntOpt(strings.trim(s)) {
                        Some(m) {
                            x = n
                            y = m
                            ints = true
                        }
                        None {}
                    }
                }
                else {}
            }
        }
        Val.Text(s) {
            match b {
                Val.Int(m) {
                    match strings.parseIntOpt(strings.trim(s)) {
                        Some(n) {
                            x = n
                            y = m
                            ints = true
                        }
                        None {}
                    }
                }
                else {}
            }
        }
        else {}
    }
    if ints {
        var r: Option[int] = None
        match op {
            "+" { r = x.checkedAdd(y) }
            "-" { r = x.checkedSub(y) }
            "*" { r = x.checkedMul(y) }
            "/" {
                if y == 0 { return Err(e("22012", "division by zero")) }
                r = x.checkedDiv(y)
            }
            "%" {
                if y == 0 { return Err(e("22012", "division by zero")) }
                r = x.checkedRem(y)
            }
            else {}
        }
        match r {
            Some(v) { return Ok(Val.Int(v)) }
            None { return Err(e("22003", "bigint out of range")) }
        }
    }
    let da = asNum(a)
    let db = asNum(b)
    if da.isNone() || db.isNone() {
        return Err(e("42883", "operator does not exist: " + text(a) + " " + op + " " + text(b)))
    }
    let p = da.unwrap()
    let q = db.unwrap()
    var r: Result[Decimal, DecError] = Ok(Decimal.zero())
    match op {
        "+" { r = p.addExact(q) }
        "-" { r = p.subExact(q) }
        "*" { r = p.mulExact(q) }
        "/" {
            if q.isZero() { return Err(e("22012", "division by zero")) }
            var sc = 16
            if p.scale() > sc { sc = p.scale() }
            if q.scale() > sc { sc = q.scale() }
            r = p.div(q, sc, Rounding.HALF_EVEN)
        }
        "%" {
            if q.isZero() { return Err(e("22012", "division by zero")) }
            r = p.remExact(q)
        }
        else {}
    }
    match r {
        Ok(v) { return Ok(Val.Num(v)) }
        Err(_) { return Err(decErr()) }
    }
}

fn truth(v: &Val): Option[bool] {
    match v {
        Val.Bool(b) { return Some(b) }
        Val.Text(s) { return parseBool(&s) }
        else { return None }
    }
}

// An aggregate's name without its modifiers ("count distinct filter").
fn aggBase(name: &str): str {
    let i = strings.indexOf(name, " ", 0)
    return if i < 0 { name } else { name[0..i] }
}

const AGGS: []str = ["count", "sum", "avg", "min", "max", "string_agg", "array_agg", "bool_and", "bool_or", "every", "stddev",
                     "stddev_samp", "stddev_pop", "variance", "var_samp", "var_pop"]

fn isAgg(name: &str): bool {
    let b = aggBase(name)
    for a in AGGS { if a == b { return true } }
    return false
}

pub fn hasAgg(x: &Expr): bool {
    match x {
        Expr.Call(name, args, _) {
            if isAgg(&name) { return true }
            for a in args { if hasAgg(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return hasAgg(&a) }
        Expr.Bin(_, a, b) { return hasAgg(&a) || hasAgg(&b) }
        Expr.IsNull(a, _) { return hasAgg(&a) }
        Expr.Cast(a, _) { return hasAgg(&a) }
        else { return false }
    }
}

// What an expression is evaluated against: the columns, a row, the values
// of the query's aggregates for the row's group (an aggregate call is
// rewritten to its slot, "#agg"; none outside a grouped query) and the
// statement's parameters.
pub type Env = value record {
    cols: &[]lexdb_sql.ColDef
    row: &[]Val
    aggs: &[]Val
    params: &[]Val
    subs: &[]SubRes     // the results of the subqueries run once
    cur: &[]Val         // the correlated subqueries' values for this row
    seq: Option[SeqEnv] // nextval and its kind: the store and session (none: not allowed here)
}

fn colIndex(cols: &[]lexdb_sql.ColDef, name: &str): int {
    for i in 0..len(cols) { if cols[i].name == name { return i } }
    return -1
}

pub fn eval(x: &Expr, env: &Env): Result[Val, DbErr] {
    match x {
        Expr.Lit(v) { return Ok(v) }
        Expr.Param(n) {
            if n > len(env.params) { return Err(e("08P01", "there is no parameter $" + n.toStr())) }
            return Ok(env.params[n - 1])
        }
        Expr.Col(name) {
            let i = colIndex(&env.cols, &name)
            if i < 0 { return Err(e("42703", "column \"" + name + "\" does not exist")) }
            if len(env.row) == 0 { return Ok(Val.Null) }
            return Ok(env.row[i])
        }
        Expr.Unary(op, a) {
            let v = try eval(&a, env)
            if op == "-" {
                match v {
                    Val.Null { return Ok(Val.Null) }
                    Val.Int(n) {
                        match (0).checkedSub(n) {
                            Some(m) { return Ok(Val.Int(m)) }
                            None { return Err(e("22003", "bigint out of range")) }
                        }
                    }
                    Val.Num(d) { return Ok(Val.Num(d.neg())) }
                    Val.Ival(iv) { return Ok(Val.Ival(lexdb_time.ivalNeg(&iv))) }
                    Val.Float(fx) { return Ok(Val.Float(-fx)) }
                    Val.Real(fx) { return Ok(Val.Real(-fx)) }
                    else { return arith(&"-", &Val.Int(0), &v) }
                }
            }
            if isNull(&v) { return Ok(Val.Null) }
            match truth(&v) {
                Some(b) { return Ok(Val.Bool(!b)) }
                None { return Err(e("42804", "argument of NOT must be type boolean")) }
            }
        }
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" {
                let l = truth(&(try eval(&a, env)))
                if op == "and" && l == Some(false) { return Ok(Val.Bool(false)) }
                if op == "or" && l == Some(true) { return Ok(Val.Bool(true)) }
                let r = truth(&(try eval(&b, env)))
                if op == "and" {
                    if r == Some(false) { return Ok(Val.Bool(false)) }
                    if l.isNone() || r.isNone() { return Ok(Val.Null) }
                    return Ok(Val.Bool(true))
                }
                if r == Some(true) { return Ok(Val.Bool(true)) }
                if l.isNone() || r.isNone() { return Ok(Val.Null) }
                return Ok(Val.Bool(false))
            }
            let l = try eval(&a, env)
            let r = try eval(&b, env)
            if op == "||" {
                if isNull(&l) || isNull(&r) { return Ok(Val.Null) }
                if kindOf(&l) == lexdb_sql.K_BYTEA || kindOf(&r) == lexdb_sql.K_BYTEA {
                    let ty = oidType(lexdb_sql.OID_BYTEA)
                    let lb = try coerce(l, &ty)
                    let rb = try coerce(r, &ty)
                    match lb { Val.Bytes(p) { match rb { Val.Bytes(q) { return Ok(Val.Bytes(p + q)) } else {} } } else {} }
                }
                return Ok(Val.Text(text(&l) + text(&r)))
            }
            if op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                if isNull(&l) || isNull(&r) { return Ok(Val.Null) }
                let c = try compare(&l, &r)
                let t = match op {
                    "=" { c == 0 }
                    "<>" { c != 0 }
                    "<" { c < 0 }
                    "<=" { c <= 0 }
                    ">" { c > 0 }
                    else { c >= 0 }
                }
                return Ok(Val.Bool(t))
            }
            return arith(&op, &l, &r)
        }
        Expr.IsNull(a, neg) {
            let v = try eval(&a, env)
            return Ok(Val.Bool(isNull(&v) != neg))
        }
        Expr.Cast(a, t) {
            let v = try eval(&a, env)
            if t.kind == lexdb_sql.K_REG { return regCast(&v, t.oid, &env.seq) }
            return coerce(v, &t)
        }
        Expr.Call(name, args, star) {
            if isSubCall(&name) {
                let i = litInt(&args[0])
                if len(args) > subFixed(&name) {
                    if i < len(env.cur) { return Ok(env.cur[i]) }
                    return Err(e("0A000", "a correlated subquery is not supported here"))
                }
                if len(args) < subFixed(&name) || i >= len(env.subs) { return Err(e("0A000", "a subquery is not supported here")) }
                let xv = if name == "#in" { try eval(&args[3], env) } else { Val.Null }
                return Ok(subValue(&name, &env.subs[i], &xv))
            }
            if name == "#agg" {
                match args[0] {
                    Expr.Lit(v) {
                        match v {
                            Val.Int(i) { return Ok(env.aggs[i]) }
                            else {}
                        }
                    }
                    else {}
                }
            }
            if isAgg(&name) { return Err(e("42803", "aggregate functions are not allowed here")) }
            if name == "#win" || name == "#wmark" { return Err(e("42P20", "window functions are not allowed here")) }
            if isWinFn(&name) { return Err(e("42809", "window function " + name + " requires an OVER clause")) }
            if name == "case" || name == "case else" {
                // only the branch taken is evaluated
                let pairs = if name == "case else" { (len(args) - 1) / 2 } else { len(args) / 2 }
                for k in 0..pairs { if truth(&(try eval(&args[2 * k], env))) == Some(true) { return eval(&args[2 * k + 1], env) } }
                if name == "case else" { return eval(&args[len(args) - 1], env) }
                return Ok(Val.Null)
            }
            var vs: []Val = []
            for a in args { append(mut &vs, try eval(&a, env)) }
            if isSeqFn(&name) { return seqCall(&name, &vs, env) }
            if lexdb_sql.isCatFn(&name) || name == "current_schema" {
                match env.seq {
                    Some(se) {
                        match try callCat(&name, &vs, &se) {
                            Some(r) { return Ok(r) }
                            None {}
                        }
                    }
                    None { return Err(e("0A000", "lexdb: " + name + " is not allowed here")) }
                }
            }
            // now() and the rest: the transaction's start (9.76)
            match env.seq {
                Some(se) { return callAt(&name, &vs, lexdb_time.fromUnixUs(se.now)) }
                None {}
            }
            return call(&name, &vs)
        }
    }
}

fn intArg(v: Val, fname: &str): Result[int, DbErr] {
    match v {
        Val.Int(n) { return Ok(n) }
        else {
            match try coerce(v, &lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}) {
                Val.Int(n) { return Ok(n) }
                else { return Err(e("42883", "function " + fname + " needs an integer")) }
            }
        }
    }
}

// Whether LIKE pattern pat is literal text and % only (no _, no escape
// character): matched as bytes (likePieces). UTF-8 text matches a literal
// piece only at a character's start, so bytes give what characters do.
fn likeSimple(pat: &str, esc: &str): bool {
    for i in 0..len(pat) { if pat[i] == '_' { return false } }
    if len(esc) == 0 { return true }
    var i = 0
    while i + len(esc) <= len(pat) {
        if bytesAt(pat, i, esc) { return false }
        i += 1
    }
    return true
}

// pat's pieces between its %s ("a%b%" gives "a", "b", "").
fn likeSplit(pat: &str): []str {
    var out: []str = []
    var from = 0
    for i in 0..len(pat) {
        if pat[i] == '%' {
            append(mut &out, pat[from..i])
            from = i + 1
        }
    }
    append(mut &out, pat[from..len(pat)])
    return out
}

fn bytesAt(s: &str, at: int, p: &str): bool {
    if at < 0 || at + len(p) > len(s) { return false }
    for i in 0..len(p) { if s[at + i] != p[i] { return false } }
    return true
}

// Whether s matches the pattern of these pieces (likeSplit): the first at
// its start, the last at its end, the others in order between, each at the
// first place it is found.
fn likePieces(s: &str, ps: &[]str): bool {
    let n = len(ps)
    if n == 1 { return len(s) == len(ps[0]) && bytesAt(s, 0, &ps[0]) }
    let first = &ps[0]
    let last = &ps[n - 1]
    if len(s) < len(first) + len(last) { return false }
    if !bytesAt(s, 0, first) || !bytesAt(s, len(s) - len(last), last) { return false }
    var at = len(first)
    let end = len(s) - len(last)
    for k in 1..n - 1 {
        let p = &ps[k]
        if len(p) == 0 { continue }
        var found = -1
        var i = at
        while i + len(p) <= end {
            if s[i] == p[0] && bytesAt(s, i, p) {
                found = i
                break
            }
            i += 1
        }
        if found < 0 { return false }
        at = found + len(p)
    }
    return true
}

// LIKE: % any run of characters, _ one character, the escape character
// (backslash unless given; '' for none) before either for itself.
fn likeMatch(s: str, pat: str, esc: str, fold: bool): Result[bool, DbErr] {
    let er = strings.runes(esc)
    if len(er) > 1 { return Err(e("22019", "invalid escape string")) }
    // literal text and % only: its pieces, found in order as bytes (9.52)
    if !fold && likeSimple(&pat, &esc) { return Ok(likePieces(&s, &likeSplit(&pat))) }
    let sr = strings.runes(if fold { strings.toLowerAscii(s) } else { s })
    let pr = strings.runes(if fold { strings.toLowerAscii(pat) } else { pat })
    let ec = if len(er) == 1 { er[0] } else { -1 }
    var kind: []int = []            // 0 a character, 1 _, 2 %
    var lit: []int = []
    var i = 0
    while i < len(pr) {
        let c = pr[i]
        if c == ec {
            if i + 1 >= len(pr) { return Err(e("22025", "LIKE pattern must not end with escape character")) }
            append(mut &kind, 0)
            append(mut &lit, pr[i + 1])
            i += 2
            continue
        }
        if c == 37 {
            if len(kind) == 0 || kind[len(kind) - 1] != 2 {
                append(mut &kind, 2)
                append(mut &lit, 0)
            }
        } else if c == 95 {
            append(mut &kind, 1)
            append(mut &lit, 0)
        } else {
            append(mut &kind, 0)
            append(mut &lit, c)
        }
        i += 1
    }
    var si = 0
    var pi = 0
    var star = -1
    var mark = 0
    while si < len(sr) {
        if pi < len(kind) && (kind[pi] == 1 || (kind[pi] == 0 && lit[pi] == sr[si])) {
            si += 1
            pi += 1
        } else if pi < len(kind) && kind[pi] == 2 {
            star = pi
            mark = si
            pi += 1
        } else if star >= 0 {
            pi = star + 1
            mark += 1
            si = mark
        } else {
            return Ok(false)
        }
    }
    while pi < len(kind) && kind[pi] == 2 { pi += 1 }
    return Ok(pi == len(kind))
}

// substr(s, from [, count]), by characters, from 1, as PostgreSQL clips it.
fn substr(s: str, from: int, count: int, hasCount: bool): Result[str, DbErr] {
    let rs = strings.runes(s)
    if hasCount && count < 0 { return Err(e("22011", "negative substring length not allowed")) }
    var lo = from
    var hi = if hasCount { from + count } else { len(rs) + 1 }
    if lo < 1 { lo = 1 }
    if hi > len(rs) + 1 { hi = len(rs) + 1 }
    if hi <= lo { return Ok("") }
    var out: []int = []
    for i in lo - 1..hi - 1 { append(mut &out, rs[i]) }
    return Ok(strings.fromRunes(&out))
}

fn call(name: &str, vs: &[]Val): Result[Val, DbErr] { return callAt(name, vs, 0) }

// call, with now the transaction's start (microseconds since 2000; 0: the clock).
fn callAt(name: &str, vs: &[]Val, now: int): Result[Val, DbErr] {
    match try callMisc(name, vs) {
        Some(r) { return Ok(r) }
        None {}
    }
    if name == "gen_random_uuid" && len(vs) == 0 { return randomUuid() }
    if name == "random" && len(vs) == 0 { return randomFloat() }
    if (name == "encode" || name == "decode") && len(vs) == 2 {
        if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Val.Null) }
        if name == "encode" {
            let b = try coerce(vs[0], &oidType(lexdb_sql.OID_BYTEA))
            match b { Val.Bytes(x) { return Ok(Val.Text(try encodeBytes(&x, &text(&vs[1])))) } else {} }
        }
        return Ok(Val.Bytes(try decodeBytes(&text(&vs[0]), &text(&vs[1]))))
    }
    match try callTime(name, vs, now) {
        Some(v) { return Ok(v) }
        None {}
    }
    if name == "array" { return Ok(Val.Text(arrayText(vs))) }
    if lexdb_sql.isQuant(name) { return quantified(name, &vs[0], &vs[1]) }
    let n = len(vs)
    if name == "in" {
        // x IN (a, b): true if one equals x; else NULL if x or one of them is NULL
        if isNull(&vs[0]) { return Ok(Val.Null) }
        var sawNull = false
        for i in 1..n {
            if isNull(&vs[i]) {
                sawNull = true
                continue
            }
            if (try compare(&vs[0], &vs[i])) == 0 { return Ok(Val.Bool(true)) }
        }
        return Ok(if sawNull { Val.Null } else { Val.Bool(false) })
    }
    if name == "distinct from" {
        let na = isNull(&vs[0])
        let nb = isNull(&vs[1])
        if na || nb { return Ok(Val.Bool(na != nb)) }
        return Ok(Val.Bool((try compare(&vs[0], &vs[1])) != 0))
    }
    if name == "like" || name == "ilike" {
        for v in vs { if isNull(&v) { return Ok(Val.Null) } }
        let esc = if n > 2 { text(&vs[2]) } else { "\\" }
        return Ok(Val.Bool(try likeMatch(text(&vs[0]), text(&vs[1]), esc, name == "ilike")))
    }
    if name == "nullif" && n == 2 {
        if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(vs[0]) }
        if (try compare(&vs[0], &vs[1])) == 0 { return Ok(Val.Null) }
        return Ok(vs[0])
    }
    if (name == "greatest" || name == "least") && n >= 1 {
        var best = Val.Null
        for v in vs {
            if isNull(&v) { continue }
            if isNull(&best) { best = v } else {
                let c = try compare(&v, &best)
                if (name == "greatest" && c > 0) || (name == "least" && c < 0) { best = v }
            }
        }
        return Ok(best)
    }
    if name == "concat" {
        var out = ""
        for v in vs { if !isNull(&v) { out = out + text(&v) } }
        return Ok(Val.Text(out))
    }
    let strFn = name == "substr" || name == "substring" || name == "strpos" || name == "replace" || name == "left" ||
                name == "right"
    if n >= 2 && strFn {
        for v in vs { if isNull(&v) { return Ok(Val.Null) } }
        let a = text(&vs[0])
        if (name == "substr" || name == "substring") && n <= 3 {
            let from = try intArg(vs[1], name)
            let count = if n == 3 { try intArg(vs[2], name) } else { 0 }
            return Ok(Val.Text(try substr(a, from, count, n == 3)))
        }
        if name == "strpos" && n == 2 {
            let i = strings.indexOf(a, text(&vs[1]), 0)
            return Ok(Val.Int(if i < 0 { 0 } else { strings.runeCount(&a[0..i]) + 1 }))
        }
        if name == "replace" && n == 3 {
            let from = text(&vs[1])
            if len(from) == 0 { return Ok(Val.Text(a)) }
            return Ok(Val.Text(strings.replaceAll(a, from, text(&vs[2]))))
        }
        if (name == "left" || name == "right") && n == 2 {
            let k = try intArg(vs[1], name)
            let total = strings.runeCount(&a)
            var take = if k >= 0 { k } else { total + k }
            if take < 0 { take = 0 }
            if take > total { take = total }
            if name == "left" { return Ok(Val.Text(try substr(a, 1, take, true))) }
            return Ok(Val.Text(try substr(a, total - take + 1, take, true)))
        }
    }
    if name == "coalesce" {
        for v in vs { if !isNull(&v) { return Ok(v) } }
        return Ok(Val.Null)
    }
    if name == "version" && n == 0 { return Ok(Val.Text("PostgreSQL 16.0 (lexdb 0.1)")) }
    if name == "current_database" && n == 0 { return Ok(Val.Text("lexdb")) }
    if n == 1 {
        let v = vs[0]
        if isNull(&v) { return Ok(Val.Null) }
        match name {
            "lower" { return Ok(Val.Text(strings.toLowerAscii(text(&v)))) }
            "trim", "btrim" { return Ok(Val.Text(strings.trim(text(&v)))) }
            "ltrim" { return Ok(Val.Text(strings.trimLeft(text(&v)))) }
            "rtrim" { return Ok(Val.Text(strings.trimRight(text(&v)))) }
            "upper" { return Ok(Val.Text(strings.toUpperAscii(text(&v)))) }
            "length", "char_length" {
                match v {
                    Val.Bytes(x) { return Ok(Val.Int(len(x))) }
                    else { return Ok(Val.Int(strings.runeCount(&text(&v)))) }
                }
            }
            "octet_length" {
                match v {
                    Val.Bytes(x) { return Ok(Val.Int(len(x))) }
                    else { return Ok(Val.Int(len(text(&v)))) }
                }
            }
            "abs" {
                match v {
                    Val.Int(x) { return Ok(Val.Int(if x < 0 { try arithInt(0, x) } else { x })) }
                    Val.Num(d) { return Ok(Val.Num(d.abs())) }
                    Val.Float(x) { return Ok(Val.Float(x.abs())) }
                    Val.Real(x) { return Ok(Val.Real(x.abs())) }
                    else {}
                }
            }
            "floor", "ceil", "ceiling", "trunc", "sqrt", "cbrt", "exp", "ln", "log10", "sign" {
                match try callFloat(&name, &v) {
                    Some(r) { return Ok(r) }
                    None {}
                }
            }
            "round" {
                if isFloat(&v) { return Ok(Val.Float(asFloat(&v).unwrap().roundEven())) }
                match asNum(&v) {
                    Some(d) {
                        match d.roundAway(0) {
                            Ok(r) { return Ok(Val.Num(r)) }
                            Err(_) { return Err(decErr()) }
                        }
                    }
                    None {}
                }
            }
            else {}
        }
    }
    if n == 2 && (name == "power" || name == "pow") {
        if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Val.Null) }
        return powerOf(&vs[0], &vs[1])
    }
    if n == 2 && name == "round" {
        match asNum(&vs[0]) {
            Some(d) {
                match vs[1] {
                    Val.Int(s) {
                        match d.roundAway(s) {
                            Ok(r) { return Ok(Val.Num(r)) }
                            Err(_) { return Err(decErr()) }
                        }
                    }
                    else {}
                }
            }
            None {}
        }
    }
    return Err(e("42883", "function " + name + " with " + n.toStr() + " arguments does not exist"))
}

fn arithInt(a: int, b: int): Result[int, DbErr] {
    match a.checkedSub(b) {
        Some(v) { return Ok(v) }
        None { return Err(e("22003", "bigint out of range")) }
    }
}

// ---- keys and rows

fn encKeyPart(b: mut &StrBuf, v: &Val) {
    match v {
        Val.Int(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Date(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Time(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Ts(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Tstz(n) { binary.addU64BE(b, n ^ (-9223372036854775807 - 1)) }
        Val.Ival(iv) {
            // as PostgreSQL compares intervals: a month as 30 days, then the time of day left
            let k = lexdb_time.ivalKey(&iv)
            binary.addU64BE(b, k.days ^ (-9223372036854775807 - 1))
            binary.addU64BE(b, k.us ^ (-9223372036854775807 - 1))
        }
        Val.Bool(x) { b.addByte(if x { 1 } else { 0 }) }
        Val.Num(d) { encNum(b, &d) }
        Val.Text(s) { encBytesKey(b, &s) }
        Val.Uuid(u) { encBytesKey(b, &u) }       // its lowercase form sorts as its bytes do
        Val.Float(x) { binary.addU64BE(b, floatKey(x)) }
        Val.Real(x) { binary.addU64BE(b, floatKey(x)) }
        Val.Reg(o, _) { binary.addU64BE(b, o ^ (-9223372036854775807 - 1)) }
        Val.Bytes(x) { encBytesKey(b, &x) }
        else {}
    }
}

// Bytes in key order: a 0 byte as 0 FF, the end as 0 0.
fn encBytesKey(b: mut &StrBuf, s: &str) {
    for i in 0..len(s) {
        b.addByte(s[i])
        if s[i] == 0 { b.addByte(0xFF) }
    }
    b.addByte(0)
    b.addByte(0)
}

// A numeric in key order: 0x80 zero; 0x81, the exponent of its leading
// digit, its digits, 00 positive; 0x7F and all of that complemented
// negative. Decimal is canonical (no trailing zero digits), so equal values
// have equal keys whatever their scale.
fn encNum(b: mut &StrBuf, d: &Decimal) {
    if d.isZero() {
        b.addByte(0x80)
        return
    }
    // trailing zeros dropped: equal values (1.5, 1.50) have one key
    var digs = d.coefficient().toStr()
    var nd = len(digs)
    while nd > 1 && digs[nd - 1] == '0' { nd -= 1 }
    let ex = len(digs) + d.exponent() + 0x40000000
    digs = digs[0..nd]
    if d.isNeg() {
        b.addByte(0x7F)
        binary.addU32BE(b, 0x7FFFFFFF - ex)
        for i in 0..len(digs) { b.addByte(0xFF - digs[i]) }
        b.addByte(0xFF)
    } else {
        b.addByte(0x81)
        binary.addU32BE(b, ex)
        for i in 0..len(digs) { b.addByte(digs[i]) }
        b.addByte(0)
    }
}

// An index's key part: a marker first so that NULL has a place, last as
// PostgreSQL sorts it: 1 a value, 2 NULL.
fn encIdxPart(b: mut &StrBuf, v: &Val) {
    if isNull(v) {
        b.addByte(2)
        return
    }
    b.addByte(1)
    encKeyPart(b, v)
}

// The key of a row: its primary key's values, in byte order = SQL order.
fn keyOf(t: &Table, row: &[]Val): str {
    var b = newStrBuf()
    for i in t.pk { encKeyPart(mut &b, &row[i]) }
    return b.toStr()
}

// The smallest string after every string that starts with s ("" when there
// is none: the end of the tree).
fn succ(s: &str): str {
    var bs = strToBytes(s)
    while len(bs) > 0 && bs[len(bs) - 1] == 0xFF { let x = pop(mut &bs) }
    if len(bs) == 0 { return "" }
    bs[len(bs) - 1] = bs[len(bs) - 1] + 1
    return strFromBytes(&bs)
}

// A row's stored form: per column a tag (0 NULL, 1 int, 2 bool, 3 numeric,
// 4 text) and its value. A row with a text of LONG bytes or more begins with
// tag 6 and its column count, and each such text is tag 5 and its length
// in place, its bytes after the last column (9.31): the columns before
// them stay at the row's start, which a large row keeps in its leaf.
const LONG = 256

fn encRow(row: &[]Val): str {
    var long = false
    for v in row {
        match v {
            Val.Text(s) { if len(s) >= LONG { long = true } }
            else {}
        }
    }
    if long { return encLong(row) }
    var b = newStrBuf()
    for v in row { encVal(mut &b, &v) }
    return b.toStr()
}

// A value in a row: its tag and its bytes (a text of any length in place).
// Tags 7 to 10 are a date, time, timestamp and timestamptz (8 bytes), 11 an
// interval (months, days, microseconds: 24 bytes) (9.76).
fn encVal(b: mut &StrBuf, v: &Val) {
    match v {
        Val.Null { b.addByte(0) }
        Val.Int(n) {
            b.addByte(1)
            binary.addU64LE(b, n)
        }
        Val.Bool(x) {
            b.addByte(2)
            b.addByte(if x { 1 } else { 0 })
        }
        Val.Num(d) {
            b.addByte(3)
            let s = d.toStr()
            binary.addU32LE(b, len(s))
            b.add(s)
        }
        Val.Text(s) {
            b.addByte(4)
            binary.addU32LE(b, len(s))
            b.add(s)
        }
        Val.Date(n) {
            b.addByte(7)
            binary.addU64LE(b, n)
        }
        Val.Time(n) {
            b.addByte(8)
            binary.addU64LE(b, n)
        }
        Val.Ts(n) {
            b.addByte(9)
            binary.addU64LE(b, n)
        }
        Val.Tstz(n) {
            b.addByte(10)
            binary.addU64LE(b, n)
        }
        Val.Ival(iv) {
            b.addByte(11)
            binary.addU64LE(b, iv.months)
            binary.addU64LE(b, iv.days)
            binary.addU64LE(b, iv.us)
        }
        Val.Uuid(u) {
            b.addByte(12)
            b.add(uuidBytes(&u))
        }
        Val.Bytes(x) {
            b.addByte(13)
            binary.addU32LE(b, len(x))
            b.add(x)
        }
        Val.Float(x) {
            b.addByte(14)
            binary.addU64LE(b, math.bitsOf(x))
        }
        Val.Real(x) {
            b.addByte(15)
            binary.addU32LE(b, math.bitsOf32Int(x))
        }
        Val.Reg(o, _) { encVal(b, &Val.Int(o)) }      // stored as its OID
    }
}

// A value of tag 7 to 15 in a row at s[at..]: a date or time kind, a
// uuid, a bytea, a double precision or a real.
fn timeVal(s: &str, at: int, tag: byte): Val {
    if tag == 12 { return Val.Uuid(uuidText(&s[at..at + 16])) }
    if tag == 13 { return Val.Bytes(s[at + 4..at + 4 + binary.readU32LEStr(s, at)]) }
    if tag == 14 { return Val.Float(math.fromBits(binary.readI64LEStr(s, at))) }
    if tag == 15 { return Val.Real(math.fromBits32Int(binary.readU32LEStr(s, at))) }
    let x = binary.readI64LEStr(s, at)
    if tag == 7 { return Val.Date(x) }
    if tag == 8 { return Val.Time(x) }
    if tag == 9 { return Val.Ts(x) }
    if tag == 10 { return Val.Tstz(x) }
    return Val.Ival(lexdb_time.Ival{months: x, days: binary.readI64LEStr(s, at + 8), us: binary.readI64LEStr(s, at + 16)})
}

// ---- uuid and bytea (9.78)

extern "c" fn getrandom(buf: mut &[byte], n: int, flags: u32): int

fn hexVal(c: byte): int {
    if c >= '0' && c <= '9' { return int(c - '0') }
    if c >= 'a' && c <= 'f' { return int(c - 'a') + 10 }
    if c >= 'A' && c <= 'F' { return int(c - 'A') + 10 }
    return -1
}

// A uuid in any of PostgreSQL's forms (upper or lower case, in braces, a
// hyphen after any group of four digits or none), as its canonical form.
fn parseUuid(s: &str): Result[str, DbErr] {
    let bad = e("22P02", "invalid input syntax for type uuid: \"" + s + "\"")
    var t = strings.trim(s)
    if len(t) > 0 && t[0] == '{' {
        if len(t) < 2 || t[len(t) - 1] != '}' { return Err(bad) }
        t = t[1..len(t) - 1]
    }
    var hex = newStrBuf()
    var n = 0
    for i in 0..len(t) {
        let c = t[i]
        if c == '-' {
            if n == 0 || n % 4 != 0 || n >= 32 || t[i - 1] == '-' { return Err(bad) }
            continue
        }
        let v = hexVal(c)
        if v < 0 || n >= 32 { return Err(bad) }
        hex.addByte(if c >= 'A' && c <= 'F' { c + 32 } else { c })
        n += 1
    }
    if n != 32 || t[len(t) - 1] == '-' { return Err(bad) }
    let h = hex.toStr()
    return Ok(h[0..8] + "-" + h[8..12] + "-" + h[12..16] + "-" + h[16..20] + "-" + h[20..32])
}

// A canonical uuid's 16 bytes, and back.
fn uuidBytes(u: &str): str {
    var b = newStrBuf()
    var i = 0
    while i < len(u) {
        if u[i] == '-' {
            i += 1
            continue
        }
        b.addByte(byte(hexVal(u[i]) * 16 + hexVal(u[i + 1])))
        i += 2
    }
    return b.toStr()
}

fn uuidText(raw: &str): str {
    let h = lexdb_sql.bytesHex(raw)
    return h[2..10] + "-" + h[10..14] + "-" + h[14..18] + "-" + h[18..22] + "-" + h[22..34]
}

// gen_random_uuid(): version 4, from the kernel's random bytes.
fn randomUuid(): Result[Val, DbErr] {
    var b = array(16, byte(0))
    if getrandom(mut &b, 16, u32(0)) != 16 { return Err(e("58000", "could not generate random values")) }
    b[6] = byte((int(b[6]) & 0x0f) | 0x40)
    b[8] = byte((int(b[8]) & 0x3f) | 0x80)
    return Ok(Val.Uuid(uuidText(&strFromBytes(&b))))
}

// A bytea from its text: hex (\x0001ff, pairs perhaps spaced) or the
// escape form (\\ a backslash, \nnn an octal byte, the rest as is).
fn parseBytea(s: &str): Result[str, DbErr] {
    let bad = e("22P02", "invalid input syntax for type bytea")
    var b = newStrBuf()
    if len(s) >= 2 && s[0] == '\\' && (s[1] == 'x' || s[1] == 'X') {
        var i = 2
        while i < len(s) {
            if s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r' {
                i += 1
                continue
            }
            if i + 1 >= len(s) { return Err(e("22023", "invalid hexadecimal data: odd number of digits")) }
            let hi = hexVal(s[i])
            let lo = hexVal(s[i + 1])
            if hi < 0 || lo < 0 { return Err(e("22023", "invalid hexadecimal digit: \"" + s[if hi < 0 { i } else { i + 1 }..if hi < 0 { i + 1 } else { i + 2 }] + "\"")) }
            b.addByte(byte(hi * 16 + lo))
            i += 2
        }
        return Ok(b.toStr())
    }
    var i = 0
    while i < len(s) {
        if s[i] != '\\' {
            b.addByte(s[i])
            i += 1
        } else if i + 1 < len(s) && s[i + 1] == '\\' {
            b.addByte('\\')
            i += 2
        } else if i + 3 < len(s) && s[i + 1] >= '0' && s[i + 1] <= '3' && s[i + 2] >= '0' && s[i + 2] <= '7' && s[i + 3] >= '0' && s[i + 3] <= '7' {
            b.addByte(byte((int(s[i + 1] - '0') * 8 + int(s[i + 2] - '0')) * 8 + int(s[i + 3] - '0')))
            i += 4
        } else {
            return Err(bad)
        }
    }
    return Ok(b.toStr())
}

// encode(bytes, format): hex, base64 or escape.
fn encodeBytes(b: &str, f: &str): Result[str, DbErr] {
    let fmt = strings.toLowerAscii(f)
    if fmt == "hex" { return Ok(lexdb_sql.bytesHex(b)[2..]) }
    if fmt == "base64" {
        // 76 characters a line, as PostgreSQL writes it
        let x = base64.encode(b.toStr())
        var out = newStrBuf()
        var i = 0
        while i < len(x) {
            if i > 0 { out.addByte('\n') }
            let end = if i + 76 < len(x) { i + 76 } else { len(x) }
            out.add(&x[i..end])
            i = end
        }
        return Ok(out.toStr())
    }
    if fmt == "escape" {
        var out = newStrBuf()
        for i in 0..len(b) {
            let c = b[i]
            if c == '\\' { out.add("\\\\") }
            else if c < 32 || c > 126 {
                out.addByte('\\')
                out.addByte('0' + (c >> 6))
                out.addByte('0' + ((c >> 3) & 7))
                out.addByte('0' + (c & 7))
            } else { out.addByte(c) }
        }
        return Ok(out.toStr())
    }
    return Err(e("22023", "unrecognized encoding: \"" + f + "\""))
}

// decode(text, format): hex, base64 or escape.
fn decodeBytes(t: &str, f: &str): Result[str, DbErr] {
    let fmt = strings.toLowerAscii(f)
    if fmt == "hex" { return parseBytea(&("\\x" + t)) }
    if fmt == "base64" {
        var clean = newStrBuf()
        for i in 0..len(t) { if t[i] != '\n' && t[i] != '\r' && t[i] != ' ' && t[i] != '\t' { clean.addByte(t[i]) } }
        match base64.decodeStrict(clean.toStr()) {
            Some(x) { return Ok(x) }
            None { return Err(e("22023", "invalid base64 input")) }
        }
    }
    if fmt == "escape" { return parseBytea(t) }
    return Err(e("22023", "unrecognized encoding: \"" + f + "\""))
}

// The bytes after its tag a value of tag takes in a row at s[at..]; -1 for
// a tag that is not one.
fn valSize(s: &str, at: int, tag: byte): int {
    if tag == 0 { return 0 }
    if tag == 1 || (tag >= 7 && tag <= 10) { return 8 }
    if tag == 2 { return 1 }
    if tag == 3 || tag == 4 { return 4 + binary.readU32LEStr(s, at) }
    if tag == 5 { return 4 }
    if tag == 11 { return 24 }
    if tag == 12 { return 16 }
    if tag == 13 { return 4 + binary.readU32LEStr(s, at) }
    if tag == 14 { return 8 }
    if tag == 15 { return 4 }
    return -1
}

fn encLong(row: &[]Val): str {
    var b = newStrBuf()
    b.addByte(6)
    binary.addU32LE(mut &b, len(row))
    for v in row {
        match v {
            Val.Text(s) {
                if len(s) >= LONG {
                    b.addByte(5)
                    binary.addU32LE(mut &b, len(s))
                } else {
                    encVal(mut &b, &v)
                }
            }
            else { encVal(mut &b, &v) }
        }
    }
    for v in row {
        match v {
            Val.Text(s) { if len(s) >= LONG { b.add(s) } }
            else {}
        }
    }
    return b.toStr()
}

// A row from a stored value as a Part read gives it: a large row from its
// first bytes when the columns used are all there, else read whole (9.31).
// n and need are of the row's places (rowWidth, placesNeeded); the values
// are the table's columns'.
fn rowOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, key: &str, v: &str, n: int,
         need: &[]bool, missing: &[]Val): Result[[]Val, DbErr] {
    let places = try placesOf(st, txn, t, key, v, n, need, missing)
    if len(t.slots) == 0 { return Ok(places) }
    var out: []Val = []
    for k in t.slots { append(mut &out, places[k]) }
    return Ok(out)
}

// The places a stored row has: its table's columns, and dropped ones.
fn rowWidth(t: &Table): int { return if len(t.slots) == 0 { len(t.cols) } else { t.width } }

// The values rows written before a column was added have for it, by
// place ([] when all are NULL).
fn placesMissing(t: &Table): []Val {
    var any = false
    for c in t.cols { if !isNull(&c.missing) { any = true } }
    var out: []Val = []
    if !any { return out }
    out = array(rowWidth(t), Val.Null)
    for i in 0..len(t.cols) { out[if len(t.slots) == 0 { i } else { t.slots[i] }] = t.cols[i].missing }
    return out
}

// need ([] all) of the table's columns as of the row's places.
fn placesNeeded(t: &Table, need: &[]bool): []bool {
    var out: []bool = []
    if len(t.slots) == 0 || len(need) == 0 {
        for x in need { append(mut &out, x) }
        return out
    }
    out = array(t.width, false)
    for i in 0..len(t.slots) { out[t.slots[i]] = need[i] }
    return out
}

// A table's row as stored: its values at their places, NULL at a dropped
// column's.
fn encRowOf(t: &Table, row: &[]Val): str {
    if fixedRows {
        // the fixed layout (9.50) when every value fits it
        if len(t.slots) == 0 {
            match encFixed(t, row) {
                Some(f) { return f }
                None {}
            }
        } else {
            var ps: []Val = array(t.width, Val.Null)
            for i in 0..len(t.slots) { ps[t.slots[i]] = row[i] }
            match encFixed(t, &ps) {
                Some(f) { return f }
                None {}
            }
        }
    }
    if len(t.slots) == 0 { return encRow(row) }
    var places: []Val = array(t.width, Val.Null)
    for i in 0..len(t.slots) { places[t.slots[i]] = row[i] }
    return encRow(&places)
}

fn placesOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, key: &str, v: &str, n: int,
            need: &[]bool, missing: &[]Val): Result[[]Val, DbErr] {
    match lexdb_store.partOf(v) {
        Some(p) {
            if fitsIn(&p, n, need) { return decRowNeed(&p, n, need, missing, &t.lays) }
            let w = try st.whole(txn, t.tree, key, v)
            return decRowNeed(&w, n, need, missing, &t.lays)
        }
        None { return decRowNeed(v, n, need, missing, &t.lays) }
    }
}

// Whether a large row's first bytes hold all the columns used: all its
// columns before its long texts, and none of those texts used.
fn fitsIn(p: &str, n: int, need: &[]bool): bool {
    if len(need) == 0 || len(p) < 5 || p[0] != 6 { return false }
    let cols = binary.readU32LEStr(p, 1)
    var at = 5
    for i in 0..cols {
        if at >= len(p) { return false }
        let tag = p[at]
        at += 1
        if tag == 5 {
            if i < n && need[i] { return false }
            at += 4
        } else {
            if (tag == 3 || tag == 4 || tag == 13) && at + 4 > len(p) { return false }
            let sz = valSize(p, at, tag)
            if sz < 0 { return false }
            at += sz
        }
        if at > len(p) { return false }
    }
    return true
}

// A stored row's columns before its long texts: the bytes a large row
// keeps in its leaf (lexdb_store.putRow), 0 for a row with no long text.
fn rowHead(s: &str): int {
    if len(s) < 5 || s[0] != 6 { return 0 }
    let cols = binary.readU32LEStr(s, 1)
    var at = 5
    for i in 0..cols {
        let tag = s[at]
        at += 1
        at += valSize(s, at, tag)
    }
    return at
}

fn decRow(s: &str, n: int): Result[[]Val, DbErr] {
    let all: []bool = []
    let none: []Val = []
    let lays: []FixedLay = []
    return decRowNeed(s, n, &all, &none, &lays)
}

// A row's values; need: the columns used ([] all), the others NULL and not
// decoded (9.31).
// lays: the row's table's layouts (Table.lays), for a row in the fixed form.
fn decRowNeed(s: &str, n: int, need: &[]bool, missing: &[]Val, lays: &[]FixedLay): Result[[]Val, DbErr] {
    if len(s) > 0 && s[0] == FIXED { return decFixed(s, n, need, missing, lays) }
    var out: []Val = []
    var at = 0
    let some = len(need) > 0
    // a row with long texts: its column count, and where each long text is
    var cols = n
    let long = len(s) > 0 && s[0] == 6
    if long {
        cols = binary.readU32LEStr(s, 1)
        at = 5
    }
    var longAt: []int = []               // the long texts' columns, in order
    var longLen: []int = []
    for i in 0..n {
        if i >= cols || (!long && at >= len(s)) {
            // a column added after the row was written: its default then
            append(mut &out, if i < len(missing) { missing[i] } else { Val.Null })
            continue
        }
        let tag = s[at]
        at += 1
        if tag == 5 {
            append(mut &longAt, i)
            append(mut &longLen, binary.readU32LEStr(s, at))
            at += 4
            append(mut &out, Val.Null)
            continue
        }
        if some && !need[i] {
            let sz = valSize(s, at, tag)
            if sz < 0 { return Err(lexdb_base.corrupt("a row's value tag")) }
            at += sz
            append(mut &out, Val.Null)
            continue
        }
        if tag == 0 {
            append(mut &out, Val.Null)
        } else if tag == 1 {
            append(mut &out, Val.Int(binary.readI64LEStr(s, at)))
            at += 8
        } else if tag == 2 {
            append(mut &out, Val.Bool(s[at] == 1))
            at += 1
        } else if tag == 3 || tag == 4 {
            let l = binary.readU32LEStr(s, at)
            let t = s[at + 4..at + 4 + l]
            at += 4 + l
            if tag == 4 {
                append(mut &out, Val.Text(t))
            } else {
                match Decimal.parse(t) {
                    Ok(d) { append(mut &out, Val.Num(d)) }
                    Err(_) { return Err(lexdb_base.corrupt("a numeric value in a row")) }
                }
            }
        } else if tag >= 7 && tag <= 15 {
            append(mut &out, timeVal(s, at, tag))
            at += valSize(s, at, tag)
        } else {
            return Err(lexdb_base.corrupt("a row's value tag"))
        }
    }
    if long {
        // the columns not read when the row has more than the table (none yet)
        for i in n..cols {
            let tag = s[at]
            at += 1
            if tag == 5 {
                append(mut &longAt, i)
                append(mut &longLen, binary.readU32LEStr(s, at))
                at += 4
            } else { at += valSize(s, at, tag) }
        }
        for k in 0..len(longAt) {
            let l = longLen[k]
            let i = longAt[k]
            if i < n && (!some || need[i]) {
                if at + l > len(s) { return Err(lexdb_base.corrupt("a row's long text")) }
                out[i] = Val.Text(s[at..at + l])
            }
            at += l
        }
    }
    return Ok(out)
}

// ---- the catalog

fn encTable(t: &Table): str {
    var b = newStrBuf()
    binary.addU32LE(mut &b, t.tree)
    binary.addU32LE(mut &b, len(t.cols))
    for c in t.cols {
        binary.addU32LE(mut &b, len(c.name))
        b.add(c.name)
        binary.addU32LE(mut &b, c.typ.kind)
        binary.addU32LE(mut &b, c.typ.oid)
        binary.addU32LE(mut &b, c.typ.prec)
        binary.addU32LE(mut &b, c.typ.scale)
        binary.addU32LE(mut &b, c.typ.len)
        b.addByte(if c.notNull { 1 } else { 0 })
    }
    binary.addU32LE(mut &b, len(t.pk))
    for i in t.pk { binary.addU32LE(mut &b, i) }
    binary.addU32LE(mut &b, len(t.indexes))
    for ix in t.indexes {
        binary.addU32LE(mut &b, len(ix.name))
        b.add(ix.name)
        binary.addU32LE(mut &b, ix.tree)
        let filtered = ix.pred.isSome()
        b.addByte((if ix.unique { 1 } else { 0 }) + (if filtered { 2 } else { 0 }) + (if ix.con { 4 } else { 0 }))
        binary.addU32LE(mut &b, len(ix.cols))
        for c in ix.cols { binary.addU32LE(mut &b, c) }
        match ix.pred {
            Some(x) {
                let text = lexdb_sql.exprText(&x)
                binary.addU32LE(mut &b, len(text))
                b.add(text)
            }
            None {}
        }
    }
    // then defaults, after the places (written, with none, when there are
    // defaults)
    // (all written: the layouts come last)
    let defs = true
    let fkx = true
    let checks = true
    if len(t.slots) > 0 || defs || checks {
        binary.addU32LE(mut &b, t.width)
        binary.addU32LE(mut &b, len(t.slots))
        for k in t.slots { binary.addU32LE(mut &b, k) }
    }
    if defs || checks {
        for c in t.cols {
            let missing = !isNull(&c.missing)
            b.addByte((if c.def.isSome() { 1 } else { 0 }) + (if missing { 2 } else { 0 }) + (if len(c.seq) > 0 { 4 } else { 0 }))
            match c.def {
                Some(x) {
                    let text = lexdb_sql.exprText(&x)
                    binary.addU32LE(mut &b, len(text))
                    b.add(text)
                }
                None {}
            }
            if missing {
                let v = encRow(&[c.missing])
                binary.addU32LE(mut &b, len(v))
                b.add(v)
            }
            if len(c.seq) > 0 {
                b.addByte(byte(c.identity))
                addStr(mut &b, &c.seq)
            }
        }
    }
    // then the checks
    if checks {
        binary.addU32LE(mut &b, len(t.checks))
        for c in t.checks {
            binary.addU32LE(mut &b, len(c.name))
            b.add(c.name)
            let text = lexdb_sql.exprText(&c.expr)
            binary.addU32LE(mut &b, len(text))
            b.add(text)
        }
    }
    // then the foreign keys, and the tables referencing it
    if fkx {
        binary.addU32LE(mut &b, len(t.fks))
        for f in t.fks {
            addStr(mut &b, &f.name)
            addStrs(mut &b, &f.cols)
            addStr(mut &b, &f.ref)
            addStrs(mut &b, &f.refCols)
            b.addByte(byte(f.onDelete))
            b.addByte(byte(f.onUpdate))
        }
        addStrs(mut &b, &t.refBy)
    }
    // then the row layouts, the current one last
    let cur = placeKinds(t)
    let n = len(t.layouts)
    let add = n == 0 || !sameKinds(&t.layouts[n - 1], &cur)
    binary.addU32LE(mut &b, n + (if add { 1 } else { 0 }))
    for l in t.layouts { addKinds(mut &b, &l) }
    if add { addKinds(mut &b, &cur) }
    return b.toStr()
}

fn addKinds(b: mut &StrBuf, ks: &[]byte) {
    binary.addU32LE(b, len(ks))
    for k in ks { b.addByte(k) }
}

fn sameKinds(a: &[]byte, b: &[]byte): bool {
    if len(a) != len(b) { return false }
    for i in 0..len(a) { if a[i] != b[i] { return false } }
    return true
}

// Makes the table's current layout (placeKinds) its last, as encTable
// will store it: for rows written before the catalog row is.
fn syncLayouts(t: mut &Table) {
    let cur = placeKinds(t)
    let n = len(t.layouts)
    if n > 0 && sameKinds(&t.layouts[n - 1], &cur) { return }
    append(mut &t.lays, layOfKinds(&cur))
    append(mut &t.layouts, cur)
}

fn addStr(b: mut &StrBuf, x: &str) {
    binary.addU32LE(b, len(x))
    b.add(x)
}

fn addStrs(b: mut &StrBuf, xs: &[]str) {
    binary.addU32LE(b, len(xs))
    for x in xs { addStr(b, &x) }
}

// A string addStr wrote at at (it takes 4 + its length).
fn strAt(s: &str, at: int): str {
    let l = binary.readU32LEStr(s, at)
    return s[at + 4..at + 4 + l]
}

// The strings addStrs wrote at at.
fn strsAt(s: &str, at: int): []str {
    let n = binary.readU32LEStr(s, at)
    var p = at + 4
    var out: []str = []
    for i in 0..n {
        let x = strAt(s, p)
        p += 4 + len(x)
        append(mut &out, x)
    }
    return out
}

fn strsLen(xs: &[]str): int {
    var n = 4
    for x in xs { n += 4 + len(x) }
    return n
}

fn decTable(name: str, s: &str): Result[Table, DbErr] {
    if strings.startsWith(s, VIEW_MARK) { return Ok(decView(name, s)) }
    var t = emptyTable(name)
    t.tree = binary.readU32LEStr(s, 0)
    let n = binary.readU32LEStr(s, 4)
    var at = 8
    for i in 0..n {
        let l = binary.readU32LEStr(s, at)
        let cn = s[at + 4..at + 4 + l]
        at += 4 + l
        let ty = lexdb_sql.TypeName{kind: binary.readU32LEStr(s, at), oid: binary.readU32LEStr(s, at + 4),
                                    prec: binary.readU32LEStr(s, at + 8), scale: binary.readU32LEStr(s, at + 12),
                                    len: binary.readU32LEStr(s, at + 16)}
        at += 20
        append(mut &t.cols, lexdb_sql.colDef(cn, ty, s[at] == 1))
        at += 1
    }
    let k = binary.readU32LEStr(s, at)
    at += 4
    for i in 0..k {
        append(mut &t.pk, binary.readU32LEStr(s, at))
        at += 4
    }
    if at >= len(s) { return Ok(t) }
    let ni = binary.readU32LEStr(s, at)
    at += 4
    for i in 0..ni {
        let l = binary.readU32LEStr(s, at)
        var ix = Index{name: s[at + 4..at + 4 + l], tree: 0, cols: [], unique: false, pred: None, con: false}
        at += 4 + l
        ix.tree = binary.readU32LEStr(s, at)
        let flags = s[at + 4]
        ix.unique = flags & 1 != 0
        ix.con = flags & 4 != 0
        let nc = binary.readU32LEStr(s, at + 5)
        at += 9
        for j in 0..nc {
            append(mut &ix.cols, binary.readU32LEStr(s, at))
            at += 4
        }
        if flags & 2 != 0 {
            let pl = binary.readU32LEStr(s, at)
            match lexdb_sql.parseExpr(&s[at + 4..at + 4 + pl]) {
                Ok(x) { ix.pred = Some(x) }
                Err(_) { return Err(lexdb_base.corrupt("the predicate of index \"" + ix.name + "\"")) }
            }
            at += 4 + pl
        }
        append(mut &t.indexes, ix)
    }
    if at + 8 <= len(s) {
        t.width = binary.readU32LEStr(s, at)
        let ns = binary.readU32LEStr(s, at + 4)
        at += 8
        for i in 0..ns {
            append(mut &t.slots, binary.readU32LEStr(s, at))
            at += 4
        }
    }
    if at < len(s) {
        for i in 0..len(t.cols) {
            let flags = s[at]
            at += 1
            if flags & 1 != 0 {
                let l = binary.readU32LEStr(s, at)
                match lexdb_sql.parseExpr(&s[at + 4..at + 4 + l]) {
                    Ok(x) { t.cols[i].def = Some(x) }
                    Err(_) { return Err(lexdb_base.corrupt("the default of column \"" + t.cols[i].name + "\"")) }
                }
                at += 4 + l
            }
            if flags & 2 != 0 {
                let l = binary.readU32LEStr(s, at)
                let vs = try decRow(&s[at + 4..at + 4 + l], 1)
                t.cols[i].missing = vs[0]
                at += 4 + l
            }
            if flags & 4 != 0 {
                t.cols[i].identity = int(s[at])
                t.cols[i].seq = strAt(s, at + 1)
                at += 5 + len(t.cols[i].seq)
            }
        }
    }
    if at + 4 <= len(s) {
        let nc = binary.readU32LEStr(s, at)
        at += 4
        for i in 0..nc {
            let l = binary.readU32LEStr(s, at)
            let cn = s[at + 4..at + 4 + l]
            at += 4 + l
            let xl = binary.readU32LEStr(s, at)
            match lexdb_sql.parseExpr(&s[at + 4..at + 4 + xl]) {
                Ok(x) { append(mut &t.checks, Check{name: cn, expr: x}) }
                Err(_) { return Err(lexdb_base.corrupt("check constraint \"" + cn + "\"")) }
            }
            at += 4 + xl
        }
    }
    if at + 4 <= len(s) {
        let nf = binary.readU32LEStr(s, at)
        at += 4
        for i in 0..nf {
            let fname = strAt(s, at)
            at += 4 + len(fname)
            let fcols = strsAt(s, at)
            at += strsLen(&fcols)
            let fref = strAt(s, at)
            at += 4 + len(fref)
            let frefCols = strsAt(s, at)
            at += strsLen(&frefCols)
            append(mut &t.fks, ForeignKey{name: fname, cols: fcols, ref: fref, refCols: frefCols, onDelete: int(s[at]), onUpdate: int(s[at + 1])})
            at += 2
        }
        t.refBy = strsAt(s, at)
        at += strsLen(&t.refBy)
    }
    if at + 4 <= len(s) {
        let nl = binary.readU32LEStr(s, at)
        at += 4
        for i in 0..nl {
            let np = binary.readU32LEStr(s, at)
            at += 4
            if at + np > len(s) { return Err(lexdb_base.corrupt("the row layouts of table \"" + t.name + "\"")) }
            var ks: []byte = []
            for j in 0..np { append(mut &ks, s[at + j]) }
            at += np
            append(mut &t.lays, layOfKinds(&ks))
            append(mut &t.layouts, ks)
        }
    }
    return Ok(t)
}

// The catalog's version: a row every DDL statement bumps, read through the
// transaction, so it names the schema the transaction sees (a snapshot may
// predate the latest DDL). Its key sorts before every name (index names
// start with 1, table names with a letter).
const CAT_VERSION: str = "\x02version"

fn catVersion(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[str, DbErr] {
    match try st.get(txn, CATALOG, CAT_VERSION) {
        Some(v) { return Ok(v) }
        None { return Ok("0") }
    }
}

fn bumpCatalog(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[Unit, DbErr] {
    let v = strings.parseIntOpt(try catVersion(st, txn)).unwrapOr(0)
    try txn.put(CATALOG, CAT_VERSION, (v + 1).toStr())
    return Ok(Unit{})
}

// ---- schemas (9.20): a table's catalog key is its name qualified by its
// schema (lexdb_sql.qual: schema QSEP name), public's unqualified. A schema
// is a catalog row of its own (schemaKey). An unqualified name is looked up
// along the transaction's search path (Txn.path, [] for public alone).

fn schemaKey(n: &str): str { return "\x03" + n }

fn schemaExists(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[bool, DbErr] {
    if n == "public" { return Ok(true) }
    return Ok((try st.get(txn, CATALOG, schemaKey(n))).isSome())
}

// The schema new unqualified names go in: the first on the path that
// exists ("" none).
fn createSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[str, DbErr] {
    if len(txn.path) == 0 { return Ok("public") }
    for i in 0..len(txn.path) {
        let sc = txn.path[i]
        if try schemaExists(st, txn, &sc) { return Ok(sc) }
    }
    return Ok("")
}

// The catalog key of a table (idx false) or an index named n: n if it is
// qualified or the path is public's; else the first schema on the path
// holding it, or none: the schema new names would go in (it is not there).
fn catKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str, idx: bool): Result[str, DbErr] {
    if len(txn.path) == 0 || lexdb_sql.isQual(n) { return Ok(n) }
    for i in 0..len(txn.path) {
        let sc = txn.path[i]
        let k = lexdb_sql.qual(&sc, n)
        let found = try st.get(txn, CATALOG, if idx { idxName(&k) } else { k })
        if found.isSome() { return Ok(k) }
    }
    let sc = try createSchema(st, txn)
    let first = txn.path[0]
    return Ok(lexdb_sql.qual(if len(sc) > 0 { &sc } else { &first }, n))
}

fn findTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str): Result[Option[Table], DbErr] {
    let k = try catKey(st, txn, name, false)
    match try st.get(txn, CATALOG, k) {
        Some(s) { return Ok(Some(try decTable(&k, &s))) }
        None { return Ok(None) }
    }
}

fn needTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str): Result[Table, DbErr] {
    match try findTable(st, txn, name) {
        Some(t) {
            if len(t.view) > 0 { return Err(e("42809", "\"" + lexdb_sql.shown(name) + "\" is a view")) }
            return Ok(t)
        }
        None { return Err(e("42P01", "relation \"" + lexdb_sql.shown(name) + "\" does not exist")) }
    }
}

// Makes the catalog when the store is new.
pub fn bootstrap(st: &lexdb_store.Store): Result[Unit, DbErr] {
    st.watch(CATALOG)
    var have = false
    for id in st.trees() { if id == CATALOG { have = true } }
    if !have {
        var t = lexdb_store.begin()
        let id = st.createTree(mut &t)
        if id != CATALOG { return Err(lexdb_base.corrupt("the store has trees but no catalog")) }
        try st.commit(t)
    }
    // the sequences' values (9.43): a tree of their own, made once
    var r = lexdb_store.begin()
    let seqs = try st.get(mut &r, CATALOG, SEQ_TREE)
    if seqs.isSome() {
        st.abort(r)
        return Ok(Unit{})
    }
    let tree = st.createTree(mut &r)
    try r.put(CATALOG, SEQ_TREE, tree.toStr())
    return st.commit(r)
}

// ---- planning: access paths and joins

fn conjuncts(x: &Expr, out: mut &[]Expr) {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" {
                conjuncts(&a, out)
                conjuncts(&b, out)
                return
            }
        }
        else {}
    }
    append(out, clone(x))
}
fn cloneAll(xs: &[]Expr): []Expr {
    var out: []Expr = []
    for x in xs { append(mut &out, clone(&x)) }
    return out
}
// A copy of an expression (Expr is boxed and owned).
pub fn clone(x: &Expr): Expr {
    match x {
        Expr.Lit(v) { return Expr.Lit(v) }
        Expr.Param(n) { return Expr.Param(n) }
        Expr.Col(n) { return Expr.Col(n) }
        Expr.Unary(op, a) { return Expr.Unary(op, clone(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, clone(&a), clone(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(clone(&a), neg) }
        Expr.Call(n, args, star) { return Expr.Call(n, cloneAll(&args), star) }
        Expr.Cast(a, t) { return Expr.Cast(clone(&a), t) }
    }
}


// A conjunct "col op value" (or "value op col", turned round).
type Bound = record { op: str; val: Expr }

// A table's way in: its primary key (index -1) or one of its indexes, with
// an equality for each of the first len(eqs) key columns, then perhaps
// bounds on the next one. No equality and no bound is a full scan.
type Path = record {
    index: int
    eqs: []Expr
    rng: []Bound
    desc: bool          // read backward (ORDER BY ... DESC, MAX)
    noNulls: bool       // an index path: leave out its next column's NULLs (MIN, MAX)
    ins: []Expr         // x IN (...) on the column after the equalities: a lookup per value
    inSub: int          // or x IN (subquery), uncorrelated: a lookup per value it gives; -1 none
    inArr: []Expr       // or x = ANY (array): its one expression, a lookup per element (9.28); [] none
}

// An IN subquery's values looked up one by one at most; past this many its
// path reads the whole table instead (no row counts to choose by yet).
const IN_LOOKUP_MAX: int = 1000

type Scan = record {
    empty: bool         // a bound is NULL: no row can match
    point: bool         // one primary key (lo)
    lo: str             // the keys [lo, hi) of the primary key or the index; hi "" for the end
    hi: str
    whole: bool         // the whole table, in primary key order, whatever the path's index
}

// One table of a query, in FROM order. Its rows join the rows of the tables
// before it: looked up per row through its path when the path's values come
// from them (a nested loop over a key or an index), else read once and
// matched by a hash of the equalities that link it to them (none: every
// row, a cross product).
pub type Level = record {
    t: Table
    alias: str
    join: int
    first: int              // its first column in the joined row
    path: Path
    cond: []Expr            // the conjuncts a row of it must satisfy to join
    post: []Expr            // a LEFT JOIN's WHERE conjuncts, checked after its NULL row is made
    local: []Expr           // the match conjuncts on its own columns only (hash: read once)
    perRow: bool
    hashCols: []int         // hash: its columns ...
    hashVals: []Expr        // ... equal to these values from earlier tables
    src: int                // a subquery in FROM (or a CTE): its number, its rows read from the run; -1 a table
    work: int               // a recursive CTE's working table: the CTE's number; -1
    lateral: bool           // a subquery in FROM using outer values (LATERAL): run per row
    need: []bool            // a table's columns the statement uses (the others are read as NULL); [] all (9.31)
}

// A level of rows held by the run (a subquery's, a working table), not a table's.
fn (lv: &Level) virt(): bool { return lv.src >= 0 || lv.work >= 0 }

// What one table of a query did (EXPLAIN ANALYZE).
type Counts = value record {
    starts: int         // scans or lookups begun (per row: one per row of the tables before); hash: probes
    read: int           // candidate rows tried
    joined: int         // rows that met the join's conditions
    nulls: int          // LEFT JOIN rows made with NULLs
    built: int          // hash: rows read to build it, and kept
    kept: int
    unmatched: int      // RIGHT and FULL JOIN: its rows that joined nothing
    batches: int        // the batches its rows were read and aggregated in (9.47)
}

// A query's run: the counts, and per RIGHT or FULL JOIN table which of its
// rows have joined.
type Run = record {
    cnt: []Counts
    seen: [][]bool
    memo: []Map[str, int]       // per subquery (correlated): its outer values -> its result in memoRes
    memoRes: [][]SubRes
    stats: []SubStat            // per subquery (or part of a UNION): its runs (EXPLAIN ANALYZE)
    cache: CteCache
    maxRounds: int              // a recursive CTE's rounds at most (the session's max_recursion); 0 no limit
    held: int                   // about the bytes of rows the statement holds (its runs inside: their own and this)
    maxHeld: int                // max_statement_mem; 0 no limit
    deadline: int               // statement_timeout: the monotonic clock's ns to stop at; 0 none
    ticks: int
    turnEnd: int                // the monotonic clock's ns after which the statement lets other sessions run
    batch: bool                 // aggregates over batches of rows (SET lexdb_batch: 9.47)
}

// A statement that does not wait (its pages in the cache) lets the other
// sessions run after this much time: lexdb runs SQL on one thread
// (design/lexdb.md 9.15).
pub const TURN_NS = 100000

// A session's limits on one statement (SET max_recursion,
// max_statement_mem, statement_timeout).
pub type Limits = value record {
    pub rounds: int             // a recursive CTE's rounds; 0 no limit
    pub mem: int                // bytes of rows held; 0 no limit
    pub deadline: int           // time.monotonicNs() to stop at; 0 none
    pub batch: bool             // SET lexdb_batch: aggregates over batches of rows (9.47)
}

pub fn noLimits(): Limits { return Limits{rounds: 0, mem: 0, deadline: 0, batch: true} }

fn (rs: mut &Run) limit(l: &Limits) {
    rs.maxRounds = l.rounds
    rs.maxHeld = l.mem
    rs.deadline = l.deadline
    rs.batch = l.batch
}

// Rows of about n bytes now held until the statement ends (or its run
// inside another does).
fn (rs: mut &Run) hold(n: int): Result[Unit, DbErr] {
    rs.held += n
    if rs.maxHeld > 0 && rs.held > rs.maxHeld { return Err(memErr(rs.maxHeld)) }
    return Ok(Unit{})
}

// The bytes a run may still hold (-1: no limit), for code that cannot reach
// the run (a row callback): it counts and checks itself, then holds.
fn (rs: &Run) room(): int { return if rs.maxHeld > 0 { rs.maxHeld - rs.held } else { -1 } }

fn memErr(max: int): DbErr {
    return e("53200", "statement holds more than max_statement_mem (" + (max / 1024).toStr() +
             " kB) of rows; SET max_statement_mem to allow more, 0 for no limit")
}

// Per row looked at: every 256th, the clock. Past statement_timeout: an
// error. After a turn of TURN_NS: the other sessions run, then this again.
fn (rs: mut &Run) tick(): Result[Unit, DbErr] {
    rs.ticks += 1
    if rs.ticks % 256 != 0 { return Ok(Unit{}) }
    return rs.checkTime()
}

// tick for n rows at once (a batch: 9.47).
fn (rs: mut &Run) tickN(n: int): Result[Unit, DbErr] {
    rs.ticks += n
    return rs.checkTime()
}

fn (rs: mut &Run) checkTime(): Result[Unit, DbErr] {
    let now = time.monotonicNs()
    if rs.deadline != 0 && now > rs.deadline { return Err(e("57014", "canceling statement due to statement timeout")) }
    if rs.turnEnd == 0 {
        rs.turnEnd = now + TURN_NS
    } else if now > rs.turnEnd {
        // a yield looks at the sockets: a session whose query has arrived runs
        match task.yield() {
            Ok(_) {}
            Err(_) { return Err(e("57014", "canceling statement: its session has ended")) }
        }
        rs.turnEnd = time.monotonicNs() + TURN_NS
    }
    return Ok(Unit{})
}

// About the memory a row takes: its array, and per value its tag and
// payload (text and numbers their bytes).
fn rowBytes(r: &[]Val): int {
    var n = 32
    for v in r {
        n += 24
        match v {
            Val.Text(t) { n += len(t) }
            Val.Num(_) { n += 32 }
            Val.Ival(_) { n += 24 }
            else {}
        }
    }
    return n
}

fn rowsBytes(rows: &[][]Val): int {
    var n = 24
    for r in rows { n += rowBytes(&r) }
    return n
}

// A subquery's kept result: its rows, its set's and groups' keys.
fn resBytes(r: &SubRes): int {
    var n = 96 + rowsBytes(&r.data)
    for i in 0..r.set.size() { n += 48 + len(r.set.keyAt(i)) }
    for i in 0..r.groups.size() { n += 48 + len(r.groups.keyAt(i)) }
    return n
}

// max_recursion's default: rounds of a recursive CTE.
pub const MAX_RECURSION = 1000

// What a subquery did: runs, results taken from the cache, and its own
// counts and subqueries' over all its runs.
type SubStat = record { runs: int; hits: int; cnt: []Counts; inner: []SubStat }

fn newRun(q: &Query): Run {
    var seen: [][]bool = []
    for k in 0..len(q.levels) { append(mut &seen, []) }
    var memo: []Map[str, int] = []
    var memoRes: [][]SubRes = []
    var stats: []SubStat = []
    for i in 0..len(q.subs) {
        append(mut &memo, newMap())
        append(mut &memoRes, [])
        append(mut &stats, SubStat{runs: 0, hits: 0, cnt: [], inner: []})
    }
    return Run{cnt: array(len(q.levels), Counts{starts: 0, read: 0, joined: 0, nulls: 0, built: 0, kept: 0, unmatched: 0, batches: 0}),
               seen: seen, memo: memo, memoRes: memoRes, stats: stats, cache: newCache(), maxRounds: MAX_RECURSION,
               held: 0, maxHeld: 0, deadline: 0, ticks: 0, turnEnd: 0, batch: true}
}

fn keepsRight(join: int): bool { return join == lexdb_sql.J_RIGHT || join == lexdb_sql.J_FULL }

fn keepsLeft(join: int): bool { return join == lexdb_sql.J_LEFT || join == lexdb_sql.J_FULL }

fn isOuter(join: int): bool { return keepsLeft(join) || keepsRight(join) }

pub type Query = record {
    levels: []Level
    cols: []lexdb_sql.ColDef    // the joined row's columns, named alias.column
    top: []Expr                 // no FROM: the WHERE
    subs: []SubPlan             // its subqueries, by number
    base: int                   // the statement's parameters; then refs' values
    corr: bool                  // a subquery of it is correlated
    refs: []Expr                // a subquery: the outer values it uses (in the outer query's terms)
}

fn dotAt(s: &str): int {
    for i in 0..len(s) { if s[i] == '.' { return i } }
    return -1
}

// The column part of alias.column (a repeated name's mark taken off).
fn colPart(q: &str): str {
    let i = dotAt(q)
    let c = if i < 0 { q } else { q[i + 1..len(q)] }
    let d = strings.indexOf(c, DUPSEP, 0)
    return if d < 0 { c } else { c[0..d] }
}

// Marks a column name repeated in one FROM item: name DUPSEP position.
const DUPSEP: str = "\x1e"

// The column a name refers to among the first n columns: alias.column, or a
// column name only one table has.
fn resolveName(cols: &[]lexdb_sql.ColDef, n: int, name: &str): Result[str, DbErr] {
    let d = dotAt(name)
    if d >= 0 {
        for i in 0..n {
            if cols[i].name == name {
                let again = name + DUPSEP
                for j in 0..n { if strings.startsWith(cols[j].name, again) { return Err(e("42702", "column reference \"" + name + "\" is ambiguous")) } }
                return Ok(name)
            }
        }
        let alias = name[0..d]
        var known = false
        for i in 0..n {
            let cd = dotAt(&cols[i].name)
            if cols[i].name[0..cd] == alias { known = true }
        }
        if !known { return Err(e("42P01", "missing FROM-clause entry for table \"" + alias + "\"")) }
        return Err(e("42703", "column " + name + " does not exist"))
    }
    var found = -1
    for i in 0..n {
        if colPart(&cols[i].name) == name {
            if found >= 0 { return Err(e("42702", "column reference \"" + name + "\" is ambiguous")) }
            found = i
        }
    }
    if found < 0 { return Err(e("42703", "column \"" + name + "\" does not exist")) }
    return Ok(cols[found].name)
}

// An expression with its column names made alias.column.
// A name not among a query's columns may be one of a query around it
// (a correlated subquery): then it is a parameter.
fn resolve(x: &Expr, cols: &[]lexdb_sql.ColDef, n: int, sc: mut &Scope): Result[Expr, DbErr] {
    match x {
        Expr.Col(name) {
            match resolveName(cols, n, &name) {
                Ok(r) { return Ok(Expr.Col(r)) }
                Err(err) {
                    var mine = false
                    match resolveName(cols, len(cols), &name) {
                        Ok(_) { mine = true }
                        Err(x2) { mine = x2.state == "42702" }
                    }
                    if !mine && len(sc.frames) > 1 {
                        match try outerRef(sc, &name) {
                            Some(r) { return Ok(r) }
                            None {}
                        }
                    }
                    return Err(err)
                }
            }
        }
        Expr.Unary(op, a) { return Ok(Expr.Unary(op, try resolve(&a, cols, n, sc))) }
        Expr.Bin(op, a, b) {
            let l = try resolve(&a, cols, n, sc)
            let r = try resolve(&b, cols, n, sc)
            return Ok(Expr.Bin(op, l, r))
        }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try resolve(&a, cols, n, sc), neg)) }
        Expr.Cast(a, t) { return Ok(Expr.Cast(try resolve(&a, cols, n, sc), t)) }
        Expr.Call(nm, args, star) {
            var out: []Expr = []
            if isSubCall(&nm) && len(args) < subFixed(&nm) {
                // a subquery: its number, type and name, (IN: the value), then the outer values it needs
                let i = litInt(&args[0])
                var xs: []Expr = []
                if nm == "#in" { append(mut &xs, try resolve(&args[1], cols, n, sc)) }
                let f = &sc.frames[len(sc.frames) - 1]
                append(mut &out, Expr.Lit(Val.Int(i)))
                append(mut &out, Expr.Lit(Val.Int(f.subOids[i])))
                append(mut &out, Expr.Lit(Val.Text(f.subNames[i])))
                if len(xs) > 0 { append(mut &out, pop(mut &xs)) }
                for r in f.subRefs[i] { append(mut &out, clone(&r)) }
                return Ok(Expr.Call(nm, out, star))
            }
            for a in args { append(mut &out, try resolve(&a, cols, n, sc)) }
            if nm == "pg_typeof" && len(out) == 1 && !star {
                // its argument's type, known now: a text (PostgreSQL's regtype, shown by name)
                return Ok(Expr.Lit(Val.Text(lexdb_sql.typeText(&oidType(exprOid(&out[0], cols, &[]))))))
            }
            return Ok(Expr.Call(nm, out, star))
        }
        else { return Ok(clone(x)) }
    }
}

fn colNames(x: &Expr, out: mut &[]str) {
    match x {
        Expr.Col(n) { append(out, n) }
        Expr.Unary(_, a) { colNames(&a, out) }
        Expr.Bin(_, a, b) {
            colNames(&a, out)
            colNames(&b, out)
        }
        Expr.IsNull(a, _) { colNames(&a, out) }
        Expr.Cast(a, _) { colNames(&a, out) }
        Expr.Call(_, args, _) { for a in args { colNames(&a, out) } }
        else {}
    }
}

fn (q: &Query) valBefore(x: &Expr, k: int): bool { return q.maxLevel(x) < k && !(q.corr && hasCorr(x)) }

// A path's key value for level k: it uses only the tables before k. A
// correlated subquery in it is run per row of them before k is read
// (runLevel: pathCur), so it may be one too (9.23).
fn (q: &Query) keyBefore(x: &Expr, k: int): bool { return q.maxLevel(x) < k }

fn (q: &Query) levelOf(name: &str): int {
    let i = colIndex(&q.cols, name)
    var k = -1
    for j in 0..len(q.levels) { if q.levels[j].first <= i { k = j } }
    return k
}

// The latest table an expression uses (-1: none) and the earliest (len: none).
fn (q: &Query) maxLevel(x: &Expr): int {
    var ns: []str = []
    colNames(x, mut &ns)
    var m = -1
    for n in ns {
        let l = q.levelOf(&n)
        if l > m { m = l }
    }
    return m
}

fn (q: &Query) minLevel(x: &Expr): int {
    var ns: []str = []
    colNames(x, mut &ns)
    var m = len(q.levels)
    for n in ns {
        let l = q.levelOf(&n)
        if l < m { m = l }
    }
    return m
}

// The conjuncts "col op value" whose value uses only tables before level k.
fn bounds(cs: &[]Expr, col: &str, k: int, q: &Query): []Bound {
    var out: []Bound = []
    for c in cs { likeBounds(&c, col, q, mut &out) }
    for c in cs {
        match c {
            Expr.Bin(op, a, b) {
                if op == "=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                    var done = false
                    match a {
                        Expr.Col(n) {
                            if n == col && q.keyBefore(&b, k) {
                                append(mut &out, Bound{op: op, val: clone(&b)})
                                done = true
                            }
                        }
                        else {}
                    }
                    if !done {
                        match b {
                            Expr.Col(n) {
                                if n == col && q.keyBefore(&a, k) {
                                    let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { "=" } }
                                    append(mut &out, Bound{op: flip, val: clone(&a)})
                                }
                            }
                            else {}
                        }
                    }
                }
            }
            else {}
        }
    }
    return out
}

// ---- filtered indexes: when a query's conditions imply the predicate

// The value of an expression without columns, if it has one now (NULL: none).
fn constVal(x: &Expr, params: &[]Val): Option[Val] {
    var ns: []str = []
    colNames(x, mut &ns)
    if len(ns) > 0 || hasAgg(x) { return None }
    let noCols: []lexdb_sql.ColDef = []
    let noRow: []Val = []
    let noAggs: []Val = []
    let noSubs: []SubRes = []
    let env = Env{cols: &noCols, row: &noRow, aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs, seq: None}
    match eval(x, &env) {
        Ok(v) {
            if isNull(&v) { return None }
            return Some(v)
        }
        Err(_) { return None }
    }
}

fn isCmp(op: &str): bool { return op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">=" }

// "column op value", from a comparison of a column with a constant.
type Cmp = record { col: str; op: str; val: Val }

fn asCmp(x: &Expr, params: &[]Val): Option[Cmp] {
    match x {
        Expr.Bin(op, a, b) {
            if !isCmp(&op) { return None }
            match a {
                Expr.Col(n) {
                    match constVal(&b, params) {
                        Some(v) { return Some(Cmp{col: n, op: op, val: v}) }
                        None {}
                    }
                }
                else {}
            }
            match b {
                Expr.Col(n) {
                    match constVal(&a, params) {
                        Some(v) {
                            let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { op } }
                            return Some(Cmp{col: n, op: flip, val: v})
                        }
                        None {}
                    }
                }
                else {}
            }
        }
        else {}
    }
    return None
}

fn holds(op: &str, d: int): bool {
    return match op {
        "=" { d == 0 }
        "<>" { d != 0 }
        "<" { d < 0 }
        "<=" { d <= 0 }
        ">" { d > 0 }
        else { d >= 0 }
    }
}

fn mentions(x: &Expr, col: &str): bool {
    match x {
        Expr.Col(n) { return n == col }
        else { return false }
    }
}

// Whether a query's conjunct c implies a predicate's conjunct p: the same
// text; a comparison of a column for "column IS NOT NULL"; or comparisons
// of a column with constants (x >= 3 implies x > 0).
// Planning that looks at a parameter's value counts here (a partial index's
// predicate implied, a LIMIT or OFFSET): a plan made with any look is not
// kept for the next execution (PlanCache). The SQL thread is one, so a
// module counter will do.
var PARAM_LOOKS: int = 0

fn impliesOne(c: &Expr, p: &Expr, params: &[]Val): bool {
    if len(params) > 0 { PARAM_LOOKS += 1 }
    if lexdb_sql.exprText(c) == lexdb_sql.exprText(p) { return true }
    match p {
        Expr.IsNull(a, neg) {
            if !neg { return false }
            match a {
                Expr.Col(n) {
                    match c {
                        Expr.Bin(op, l, r) { return isCmp(&op) && (mentions(&l, &n) || mentions(&r, &n)) }
                        else { return false }
                    }
                }
                else { return false }
            }
        }
        else {}
    }
    match asCmp(p, params) {
        Some(pc) {
            match asCmp(c, params) {
                Some(cc) {
                    if cc.col != pc.col { return false }
                    let d = match compare(&cc.val, &pc.val) { Ok(x) { x } Err(_) { return false } }
                    let po = pc.op
                    match cc.op {
                        "=" { return holds(&po, d) }
                        ">" { return (po == ">" || po == ">=" || po == "<>") && d >= 0 }
                        ">=" { return ((po == ">" || po == "<>") && d > 0) || (po == ">=" && d >= 0) }
                        "<" { return (po == "<" || po == "<=" || po == "<>") && d <= 0 }
                        "<=" { return ((po == "<" || po == "<>") && d < 0) || (po == "<=" && d <= 0) }
                        else { return po == "<>" && d == 0 }
                    }
                }
                None { return false }
            }
        }
        None { return false }
    }
}

// A predicate's column names, as alias.column.
fn qualify(x: &Expr, alias: &str): Expr {
    match x {
        Expr.Col(n) { return Expr.Col(alias + "." + n) }
        Expr.Unary(op, a) { return Expr.Unary(op, qualify(&a, alias)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, qualify(&a, alias), qualify(&b, alias)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(qualify(&a, alias), neg) }
        Expr.Cast(a, t) { return Expr.Cast(qualify(&a, alias), t) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, qualify(&a, alias)) }
            return Expr.Call(n, out, star)
        }
        else { return clone(x) }
    }
}

// Whether index c of level k may be used under conditions cs: it is not
// filtered, or they imply each conjunct of its predicate.
fn (q: &Query) usable(k: int, c: int, cs: &[]Expr, params: &[]Val): bool {
    if c < 0 { return true }
    let lv = &q.levels[k]
    match lv.t.indexes[c].pred {
        Some(pr) {
            var ps: []Expr = []
            conjuncts(&qualify(&pr, &lv.alias), mut &ps)
            for pc in ps {
                var ok = false
                for cc in cs { if impliesOne(&cc, &pc, params) { ok = true } }
                if !ok { return false }
            }
            return true
        }
        None { return true }
    }
}

// The values of a conjunct "col IN (...)" whose values use only tables
// before level k (none: no such conjunct).
fn inList(cs: &[]Expr, col: &str, k: int, q: &Query): []Expr {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "in" && len(args) > 1 {
                    var ok = false
                    match args[0] { Expr.Col(x) { ok = x == col } else {} }
                    for i in 1..len(args) { if !q.keyBefore(&args[i], k) { ok = false } }
                    if ok {
                        var out: []Expr = []
                        for i in 1..len(args) { append(mut &out, clone(&args[i])) }
                        return out
                    }
                }
            }
            else {}
        }
    }
    return []
}

// col = ANY (array), the array from the tables before level k: [it], else [].
fn anyOf(cs: &[]Expr, col: &str, k: int, q: &Query): []Expr {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "any =" && len(args) == 2 && q.keyBefore(&args[1], k) {
                    match args[0] { Expr.Col(x) { if x == col { return [clone(&args[1])] } } else {} }
                }
            }
            else {}
        }
    }
    return []
}

// col IN (subquery), the subquery uncorrelated (run once, before the
// tables are read): its number, else -1.
fn inSubOf(cs: &[]Expr, col: &str): int {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "#in" && len(args) == subFixed(&n) {
                    match args[3] { Expr.Col(x) { if x == col { return litInt(&args[0]) } } else {} }
                }
            }
            else {}
        }
    }
    return -1
}

// LIKE 'abc%' on a text column: the strings from 'abc' to 'abd'.
fn likeBounds(c: &Expr, col: &str, q: &Query, out: mut &[]Bound) {
    match c {
        Expr.Call(n, args, _) {
            if n != "like" || len(args) != 2 { return }
            match args[0] {
                Expr.Col(x) { if x != col { return } }
                else { return }
            }
            let ci = colIndex(&q.cols, col)
            if ci < 0 || q.cols[ci].typ.kind != lexdb_sql.K_TEXT { return }
            match args[1] {
                Expr.Lit(v) {
                    match v {
                        Val.Text(pat) {
                            // the characters before the first wildcard; \ escapes
                            var pre = newStrBuf()
                            var i = 0
                            while i < len(pat) {
                                let b = pat[i]
                                if b == '%' || b == '_' { break }
                                if b == '\\' {
                                    if i + 1 >= len(pat) { return }
                                    i += 1
                                }
                                pre.addByte(pat[i])
                                i += 1
                            }
                            let p = pre.toStr()
                            if len(p) == 0 { return }
                            append(out, Bound{op: ">=", val: Expr.Lit(Val.Text(p))})
                            let next = succ(&p)
                            if next != "" { append(out, Bound{op: "<", val: Expr.Lit(Val.Text(next))}) }
                        }
                        else {}
                    }
                }
                else {}
            }
        }
        else {}
    }
}

fn keyCols(t: &Table, index: int): []int {
    var out: []int = []
    if index < 0 {
        for i in t.pk { append(mut &out, i) }
    } else {
        for i in t.indexes[index].cols { append(mut &out, i) }
    }
    return out
}

// The rules (4.8): the whole primary key equal; then a unique index whose
// columns are all equal; then the most leading equalities, then a range on
// the next column; the primary key wins a tie. Nothing: a full scan.
fn choosePath(q: &Query, k: int, cs: &[]Expr, params: &[]Val): Path {
    let lv = &q.levels[k]
    var best = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []}
    var bestScore = 0
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if !q.usable(k, c, cs, params) { continue }
        let cols = keyCols(&lv.t, c)
        var eqs: []Expr = []
        var rng: []Bound = []
        var ins: []Expr = []
        var inSub = -1
        var inArr: []Expr = []
        for ci in cols {
            let name = lv.alias + "." + lv.t.cols[ci].name
            var bs = bounds(cs, &name, k, q)
            var eqAt = -1
            for i in 0..len(bs) { if bs[i].op == "=" && eqAt < 0 { eqAt = i } }
            if eqAt < 0 {
                ins = inList(cs, &name, k, q)
                if len(ins) == 0 { inSub = inSubOf(cs, &name) }
                if len(ins) == 0 && inSub < 0 { inArr = anyOf(cs, &name, k, q) }
                if len(ins) == 0 && inSub < 0 && len(inArr) == 0 { rng = bs }
                break
            }
            append(mut &eqs, replace(mut &bs[eqAt].val, Expr.Lit(Val.Null)))
        }
        // an IN list counts as an equality; the full key by one is a lookup per value
        let hasIn = len(ins) > 0 || inSub >= 0 || len(inArr) > 0
        var score = 2 * (len(eqs) + (if hasIn { 1 } else { 0 })) + (if len(rng) > 0 { 1 } else { 0 })
        if c >= 0 && lv.t.indexes[c].pred.isSome() { score += 1 }      // filtered: fewer rows
        if len(eqs) == len(cols) {
            if c < 0 { score = 1000 } else if lv.t.indexes[c].unique { score = 999 }
        } else if hasIn && len(eqs) + 1 == len(cols) {
            if c < 0 { score = 500 } else if lv.t.indexes[c].unique { score = 499 }
        }
        if score > bestScore {
            bestScore = score
            best = Path{index: c, eqs: eqs, rng: rng, desc: false, noNulls: false, ins: ins, inSub: inSub, inArr: inArr}
        }
    }
    return best
}

// Whether the path's values change from row to row of the tables before
// it: they use those tables, or a correlated subquery (run per row).
fn (q: &Query) pathOuter(p: &Path): bool {
    for x in p.eqs { if q.maxLevel(&x) >= 0 { return true } }
    for x in p.ins { if q.maxLevel(&x) >= 0 { return true } }
    for b in p.rng { if q.maxLevel(&b.val) >= 0 { return true } }
    for x in p.inArr { if q.maxLevel(&x) >= 0 { return true } }
    return q.corr && pathCorr(p)
}

fn pathCorr(p: &Path): bool {
    for x in p.eqs { if hasCorr(&x) { return true } }
    for x in p.ins { if hasCorr(&x) { return true } }
    for b in p.rng { if hasCorr(&b.val) { return true } }
    for x in p.inArr { if hasCorr(&x) { return true } }
    return false
}

// The values of the correlated subqueries in a path's key values, for
// env's row (fillCur; memoized as the filter's are).
fn pathCur(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, p: &Path, env: &Env, rs: mut &Run): Result[[]Val, DbErr] {
    var cur: []Val = array(len(q.subs), Val.Null)
    for x in p.eqs { try fillCur(st, txn, q, &x, env, rs, mut &cur) }
    for x in p.ins { try fillCur(st, txn, q, &x, env, rs, mut &cur) }
    for b in p.rng { try fillCur(st, txn, q, &b.val, env, rs, mut &cur) }
    for x in p.inArr { try fillCur(st, txn, q, &x, env, rs, mut &cur) }
    return Ok(cur)
}

fn encPart(b: mut &StrBuf, v: &Val, index: bool) {
    if index { encIdxPart(b, v) } else { encKeyPart(b, v) }
}

// The keys a path covers, its values evaluated now.
// A column's type for its bounds: a value too long for varchar(n) is not
// an error there, it only matches nothing.
fn boundType(t: &lexdb_sql.TypeName): lexdb_sql.TypeName {
    return lexdb_sql.TypeName{kind: t.kind, oid: t.oid, prec: t.prec, scale: t.scale, len: 0}
}

// The keys a path covers: with an IN list, a lookup (or range) per value,
// in key order (backward for a backward path).
fn pathScans(t: &Table, p: &Path, env: &Env): Result[[]Scan, DbErr] {
    if len(p.ins) == 0 && p.inSub < 0 && len(p.inArr) == 0 { return Ok([try pathScan(t, p, env)]) }
    if p.inSub >= 0 && len(env.subs[p.inSub].vals) > IN_LOOKUP_MAX {
        return Ok([Scan{empty: false, point: false, lo: "", hi: "", whole: true}])
    }
    let ix = p.index >= 0
    let cols = keyCols(t, p.index)
    var prefix = newStrBuf()
    for k in 0..len(p.eqs) {
        let v = try coerce(try eval(&p.eqs[k], env), &boundType(&t.cols[cols[k]].typ))
        if isNull(&v) { return Ok([]) }
        encPart(mut &prefix, &v, ix)
    }
    let pre = prefix.toStr()
    let typ = boundType(&t.cols[cols[len(p.eqs)]].typ)
    var vs: []Val = []
    if p.inSub >= 0 {
        // the subquery's values; one not of the column's type is left to
        // the condition, which stays (it decides what IN means)
        for x in env.subs[p.inSub].vals {
            match coerce(x, &typ) {
                Ok(v) { append(mut &vs, v) }
                Err(_) {}
            }
        }
    } else if len(p.inArr) > 0 {
        // the array's elements; one not of the column's type is left to
        // the condition (it stays), as an IN subquery's are
        match try eval(&p.inArr[0], env) {
            Val.Text(a) {
                for part in try arrayParts(&a) {
                    match part {
                        Some(x) {
                            match coerce(Val.Text(x), &typ) {
                                Ok(v) { append(mut &vs, v) }
                                Err(_) {}
                            }
                        }
                        None {}
                    }
                }
            }
            else {}
        }
    } else {
        for x in p.ins { append(mut &vs, try coerce(try eval(&x, env), &typ)) }
    }
    var keys: []str = []
    for v in vs {
        if isNull(&v) { continue }
        var kb = newStrBuf()
        kb.add(pre)
        encPart(mut &kb, &v, ix)
        append(mut &keys, kb.toStr())
    }
    collections.sortBy(mut &keys, fn(a: &str, b: &str): int { return a.cmp(b) })
    let point = !ix && len(p.eqs) + 1 == len(cols)
    var out: []Scan = []
    for i in 0..len(keys) {
        if i > 0 && keys[i] == keys[i - 1] { continue }
        if point { append(mut &out, Scan{empty: false, point: true, lo: keys[i], hi: "", whole: false}) } else {
            append(mut &out, Scan{empty: false, point: false, lo: keys[i], hi: succ(&keys[i]), whole: false})
        }
    }
    if p.desc {
        var rev: []Scan = []
        while len(out) > 0 { append(mut &rev, pop(mut &out)) }
        return Ok(rev)
    }
    return Ok(out)
}

fn pathScan(t: &Table, p: &Path, env: &Env): Result[Scan, DbErr] {
    let none = Scan{empty: true, point: false, lo: "", hi: "", whole: false}
    let ix = p.index >= 0
    let cols = keyCols(t, p.index)
    var prefix = newStrBuf()
    for k in 0..len(p.eqs) {
        let v = try coerce(try eval(&p.eqs[k], env), &boundType(&t.cols[cols[k]].typ))
        if isNull(&v) { return Ok(none) }
        encPart(mut &prefix, &v, ix)
    }
    let pre = prefix.toStr()
    if !ix && len(p.eqs) == len(cols) { return Ok(Scan{empty: false, point: true, lo: pre, hi: "", whole: false}) }
    var lo = pre
    var hi = if len(pre) > 0 { succ(&pre) } else { "" }
    if len(p.rng) > 0 {
        let typ = boundType(&t.cols[cols[len(p.eqs)]].typ)
        for b in p.rng {
            let v = try coerce(try eval(&b.val, env), &typ)
            if isNull(&v) { return Ok(none) }
            var kb = newStrBuf()
            kb.add(pre)
            encPart(mut &kb, &v, ix)
            let kv = kb.toStr()
            if b.op == ">" || b.op == ">=" {
                if kv > lo { lo = kv }
            } else {
                // Inclusive even for <: the value coerced to the column's type
                // may have been rounded. Every row is checked against the WHERE.
                let s = succ(&kv)
                if s != "" && (hi == "" || s < hi) { hi = s }
            }
        }
    }
    if ix && (len(p.rng) > 0 || p.noNulls) {
        {
            // An index's NULLs sort last (marker 2): no range includes them.
            var nb = newStrBuf()
            nb.add(pre)
            nb.addByte(2)
            let nk = nb.toStr()
            if hi == "" || nk < hi { hi = nk }
        }
    }
    return Ok(Scan{empty: false, point: false, lo: lo, hi: hi, whole: false})
}

const BATCH = 256

type Cursor = record { at: str; started: bool; done: bool }

fn newCursor(): Cursor { return Cursor{at: "", started: false, done: false} }

// The smallest key after k.
fn after(k: &str): str {
    var b = newStrBuf()
    b.add(k)
    b.addByte(0)
    return b.toStr()
}

// Appends up to BATCH rows of a scan to out, from the cursor on. Rows are
// read in batches so that what is done with them (a join's lookups, an
// index's entries) can use the transaction between.
fn fetch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, p: &Path, sc: &Scan, need: &[]bool, cur: mut &Cursor,
         out: mut &[][]Val): Result[Unit, DbErr] {
    let n = rowWidth(t)
    let places = placesNeeded(t, need)
    let missing = placesMissing(t)
    // only some columns used: large rows are read in part (rowOf)
    let part = len(need) > 0
    if sc.empty {
        cur.done = true
        return Ok(Unit{})
    }
    if sc.point {
        cur.done = true
        let got = if part { try st.getPart(txn, t.tree, sc.lo) } else { try st.get(txn, t.tree, sc.lo) }
        match got {
            Some(v) { append(out, try rowOf(st, txn, t, &sc.lo, &v, n, &places, &missing)) }
            None {}
        }
        return Ok(Unit{})
    }
    let byIndex = p.index >= 0 && !sc.whole
    let tree = if byIndex { t.indexes[p.index].tree } else { t.tree }
    var vals: []str = []
    var keys: []str = []
    var last = ""
    let inPart = part && !byIndex
    if p.desc {
        // backward: the cursor is the exclusive end
        let to = if cur.started { cur.at } else { sc.hi }
        cur.started = true
        if inPart {
            try st.scanBackPart(txn, tree, sc.lo, to, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val)
            append(mut &keys, en.key)
            last = en.key
            return len(vals) < BATCH
        })
        } else {
            try st.scanBack(txn, tree, sc.lo, to, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val)
            append(mut &keys, en.key)
            last = en.key
            return len(vals) < BATCH
        })
        }
        if len(vals) < BATCH { cur.done = true } else { cur.at = last }
    } else {
        let from = if cur.started { cur.at } else { sc.lo }
        cur.started = true
        if inPart {
            try st.scanPart(txn, tree, from, sc.hi, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val)
            append(mut &keys, en.key)
            last = en.key
            return len(vals) < BATCH
        })
        } else {
            try st.scan(txn, tree, from, sc.hi, fn(en: &lexdb_store.Entry): bool {
            append(mut &vals, en.val)
            append(mut &keys, en.key)
            last = en.key
            return len(vals) < BATCH
        })
        }
        if len(vals) < BATCH { cur.done = true } else { cur.at = after(&last) }
    }
    for k in 0..len(vals) {
        if !byIndex {
            append(out, try rowOf(st, txn, t, &keys[k], &vals[k], n, &places, &missing))
        } else {
            let got = if part { try st.getPart(txn, t.tree, vals[k]) } else { try st.get(txn, t.tree, vals[k]) }
            match got {
                Some(rv) { append(out, try rowOf(st, txn, t, &vals[k], &rv, n, &places, &missing)) }
                None { return Err(lexdb_base.corrupt("an index entry of \"" + t.name + "\" without its row")) }
            }
        }
    }
    return Ok(Unit{})
}

fn allTrue(cs: &[]Expr, cols: &[]lexdb_sql.ColDef, row: &[]Val, params: &[]Val): Result[bool, DbErr] {
    if len(cs) == 0 { return Ok(true) }
    let noAggs: []Val = []
    let noSubs: []SubRes = []
    let env = Env{cols: cols, row: row, aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs, seq: None}
    for c in cs { if truth(&(try eval(&c, &env))) != Some(true) { return Ok(false) } }
    return Ok(true)
}

fn newLevel(t: Table, alias: str, join: int, first: int): Level {
    return Level{t: t, alias: alias, join: join, first: first, path: Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []}, cond: [],
                 post: [], local: [], perRow: true, hashCols: [], hashVals: [], src: -1, work: -1, lateral: false, need: []}
}

// Plans a query over the tables of FROM (4.8): the tables are joined in the
// order written, and each WHERE conjunct is checked at the first table
// where all its columns are known.
fn buildQuery(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, from: &[]lexdb_sql.FromItem,
              where: &Option[Expr], params: &[]Val, subs: &[]lexdb_sql.Stmt, sc: mut &Scope): Result[Query, DbErr] {
    var q = Query{levels: [], cols: [], top: [], subs: [], base: sc.base, corr: false, refs: []}
    // a subquery in FROM is planned first: it sees the queries around this
    // one, not this one's tables
    var planned: [][]SubPlan = []
    for i in 0..len(subs) { append(mut &planned, []) }
    // its scope comes first, its columns added as its tables are read: a
    // LATERAL subquery sees the tables before it, another none of them
    append(mut &sc.frames, Frame{cols: [], refs: [], refOids: [], subRefs: [], subOids: [], subNames: [], hidden: false})
    let me = len(sc.frames) - 1
    var views: []SubPlan = []              // the views read, planned (9.82)
    for f in from {
        for lv in q.levels {
            if lv.alias == f.alias { return Err(e("42712", "table name \"" + f.alias + "\" specified more than once")) }
        }
        var viewSrc = -1
        var t = Table{name: f.alias, tree: -1, cols: [], pk: [], indexes: [], slots: [], width: 0, checks: [], fks: [], refBy: [], layouts: [], lays: [],
                      view: "", deps: []}
        var lateral = false
        if f.sub >= 0 {
            sc.frames[me].hidden = !f.lateral
            let planning = planSub(st, txn, &subs[f.sub], params, sc)
            sc.frames[me].hidden = false
            let sp = try planning
            // outer values: run per row of the tables before it (and cached by them)
            lateral = len(sp.sel.q.refs) > 0
            if lateral && keepsRight(f.join) {
                return Err(e("42P10", "a LATERAL subquery cannot be the right side of a RIGHT or FULL JOIN"))
            }
            if len(f.cols) > len(sp.sel.outs) {
                return Err(e("42P10", "table \"" + f.alias + "\" has " + len(sp.sel.outs).toStr() + " columns available but " +
                             len(f.cols).toStr() + " columns specified"))
            }
            for i in 0..len(sp.sel.outs) {
                let name = if i < len(f.cols) { f.cols[i] } else { sp.sel.outs[i].name }
                append(mut &t.cols, lexdb_sql.colDef(name, oidType(sp.sel.outs[i].oid), false))
            }
            append(mut &planned[f.sub], sp)
        } else if f.work >= 0 {
            var w = -1
            for i in 0..len(sc.works) { if sc.works[i].id == f.work { w = i } }
            if w < 0 {
                return Err(e("42P19", "recursive reference to query \"" + f.table + "\" must not appear within its non-recursive term"))
            }
            if len(f.cols) > len(sc.works[w].cols) {
                return Err(e("42P10", "table \"" + f.alias + "\" has " + len(sc.works[w].cols).toStr() + " columns available but " +
                             len(f.cols).toStr() + " columns specified"))
            }
            for i in 0..len(sc.works[w].cols) {
                let name = if i < len(f.cols) { f.cols[i] } else { sc.works[w].cols[i].name }
                append(mut &t.cols, lexdb_sql.colDef(name, sc.works[w].cols[i].typ, false))
            }
        } else {
            let found = try findTable(st, txn, &f.table)
            if found.isNone() { return Err(e("42P01", "relation \"" + lexdb_sql.shown(&f.table) + "\" does not exist")) }
            t = found.unwrap()
            if t.name != sc.target { try scCheck(st, txn, sc, &t.name, &(if len(t.view) > 0 { "view" } else { "table" })) }
            if len(t.view) > 0 {
                // a view: its query planned as a subquery in FROM (9.82),
                // its plan after the statement's own subqueries; its
                // relations read as its owner (9.83)
                if len(sc.frames) > 64 { return Err(e("42P17", "infinite recursion detected in rules for relation \"" + lexdb_sql.shown(&f.table) + "\"")) }
                let vs = try viewQuery(&t)
                let vowner = (try readAcl(st, txn, &relObj(&t.name))).owner
                if len(vowner) > 0 { append(mut &sc.asRole, vowner) }
                sc.frames[me].hidden = true
                let planning = planSub(st, txn, &vs, params, sc)
                sc.frames[me].hidden = false
                if len(vowner) > 0 { let x = pop(mut &sc.asRole) }
                let sp = try planning
                if len(f.cols) > len(t.cols) {
                    return Err(e("42P10", "table \"" + f.alias + "\" has " + len(t.cols).toStr() + " columns available but " +
                                 len(f.cols).toStr() + " columns specified"))
                }
                var vt = Table{name: f.alias, tree: -1, cols: [], pk: [], indexes: [], slots: [], width: 0, checks: [], fks: [], refBy: [], layouts: [], lays: [],
                               view: "", deps: []}
                for i in 0..len(sp.sel.outs) {
                    let name = if i < len(f.cols) { f.cols[i] } else if i < len(t.cols) { t.cols[i].name } else { sp.sel.outs[i].name }
                    append(mut &vt.cols, lexdb_sql.colDef(name, oidType(sp.sel.outs[i].oid), false))
                }
                viewSrc = len(subs) + len(views)
                append(mut &views, sp)
                t = vt
            } else if len(f.cols) > 0 {
                // t AS x(a, b): its first columns named so
                if len(f.cols) > len(t.cols) {
                    return Err(e("42P10", "table \"" + f.alias + "\" has " + len(t.cols).toStr() + " columns available but " +
                                 len(f.cols).toStr() + " columns specified"))
                }
                for i in 0..len(f.cols) { t.cols[i].name = f.cols[i] }
            }
        }
        let first = len(q.cols)
        for k in 0..len(t.cols) {
            // a name repeated in one FROM item ((SELECT 1 AS a, 2 AS a) x,
            // unnest(a, b)): each its own column, the name ambiguous
            var name = t.cols[k].name
            for j in 0..k { if t.cols[j].name == name { name = name + DUPSEP + k.toStr() } }
            append(mut &q.cols, lexdb_sql.colDef(f.alias + "." + name, t.cols[k].typ, t.cols[k].notNull))
        }
        var lv = newLevel(t, f.alias, f.join, first)
        lv.src = if viewSrc >= 0 { viewSrc } else { f.sub }
        lv.work = f.work
        lv.lateral = lateral
        append(mut &q.levels, lv)
        if len(subs) > 0 {
            // only its subqueries look here
            for i in first..len(q.cols) {
                append(mut &sc.frames[me].cols, lexdb_sql.colDef(q.cols[i].name, q.cols[i].typ, q.cols[i].notNull))
            }
        }
    }
    for i in 0..len(subs) {
        if len(planned[i]) == 0 { append(mut &planned[i], try planSub(st, txn, &subs[i], params, sc)) }
        let sp = pop(mut &planned[i])
        let top = len(sc.frames) - 1
        append(mut &sc.frames[top].subRefs, cloneAll(&sp.sel.q.refs))
        append(mut &sc.frames[top].subOids, sp.oid)
        append(mut &sc.frames[top].subNames, sp.name)
        if len(sp.sel.q.refs) > 0 { q.corr = true }
        append(mut &q.subs, sp)
    }
    // the views' plans, numbered after the statement's subqueries
    var later: []SubPlan = []
    while len(views) > 0 { append(mut &later, pop(mut &views)) }
    while len(later) > 0 {
        let vp = pop(mut &later)
        let top = len(sc.frames) - 1
        append(mut &sc.frames[top].subRefs, [])
        append(mut &sc.frames[top].subOids, vp.oid)
        append(mut &sc.frames[top].subNames, vp.name)
        append(mut &q.subs, vp)
    }
    let nl = len(q.levels)
    // A RIGHT or FULL JOIN can make the columns before it NULL: no WHERE
    // conjunct goes below the last one.
    var lastRight = -1
    for k in 0..nl { if keepsRight(q.levels[k].join) { lastRight = k } }
    var ms: [][]Expr = []
    var ps: [][]Expr = []
    for k in 0..nl {
        append(mut &ms, [])
        append(mut &ps, [])
        match from[k].on {
            Some(on) {
                // ON sees this table and those before it
                let r = try resolve(&on, &q.cols, q.levels[k].first + len(q.levels[k].t.cols), sc)
                conjuncts(&r, mut &ms[k])
            }
            None {}
        }
    }
    match where {
        Some(w) {
            let r = try resolve(&w, &q.cols, len(q.cols), sc)
            var cs: []Expr = []
            conjuncts(&r, mut &cs)
            for i in 0..len(cs) {
                let c = replace(mut &cs[i], Expr.Lit(Val.Null))
                if nl == 0 {
                    append(mut &q.top, c)
                } else {
                    var k = q.maxLevel(&c)
                    if k < 0 { k = 0 }
                    if lastRight > k { k = lastRight }
                    if isOuter(q.levels[k].join) { append(mut &ps[k], c) } else { append(mut &ms[k], c) }
                }
            }
        }
        None {}
    }
    if q.corr {
        // a correlated subquery runs per row: its conjuncts go last
        for k in 0..nl {
            ms[k] = subsLast(replace(mut &ms[k], []))
            ps[k] = subsLast(replace(mut &ps[k], []))
        }
        q.top = subsLast(replace(mut &q.top, []))
    }
    for k in 0..nl {
        let m = replace(mut &ms[k], [])
        // a subquery's rows have no key: read them all
        var path = if q.levels[k].virt() { Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []} } else {
            choosePath(&q, k, &m, params)
        }
        var perRow = k == 0 || q.pathOuter(&path) || q.levels[k].lateral
        let right = keepsRight(q.levels[k].join)
        if right {
            // Every row of it is kept: read it all once, and remember which joined.
            path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []}
            perRow = false
        }
        var local: []Expr = []
        var hcols: []int = []
        var hvals: []Expr = []
        if !perRow {
            for c in m {
                if q.minLevel(&c) >= k {
                    if !right { append(mut &local, clone(&c)) }
                    continue
                }
                match c {
                    Expr.Bin(op, a, b) {
                        if op == "=" {
                            var got = false
                            match a {
                                Expr.Col(n) {
                                    if q.levelOf(&n) == k && q.valBefore(&b, k) {
                                        append(mut &hcols, colIndex(&q.cols, &n) - q.levels[k].first)
                                        append(mut &hvals, clone(&b))
                                        got = true
                                    }
                                }
                                else {}
                            }
                            if !got {
                                match b {
                                    Expr.Col(n) {
                                        if q.levelOf(&n) == k && q.valBefore(&a, k) {
                                            append(mut &hcols, colIndex(&q.cols, &n) - q.levels[k].first)
                                            append(mut &hvals, clone(&a))
                                        }
                                    }
                                    else {}
                                }
                            }
                        }
                    }
                    else {}
                }
            }
        }
        q.levels[k].path = path
        q.levels[k].perRow = perRow
        q.levels[k].cond = m
        q.levels[k].post = replace(mut &ps[k], [])
        q.levels[k].local = local
        q.levels[k].hashCols = hcols
        q.levels[k].hashVals = hvals
    }
    return Ok(q)
}

// Reads the tables that are joined by hash, once.
fn materialize(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: mut &Mats, params: &[]Val,
               rs: mut &Run): Result[Unit, DbErr] {
    let sqe = seqEnv(st, txn)
    for k in 1..len(q.levels) {
        if q.levels[k].perRow { continue }
        var rows: [][]Val = []
        var mat: [][]Val = []
        var keys: Map[str, int] = newMap()
        var buckets: [][]int = []
        {
            let lv = &q.levels[k]
            var full: []Val = array(len(q.cols), Val.Null)
            if lv.virt() {
                for r in m.vrows[k] { append(mut &rows, copyRow(&r)) }
            } else {
                let noAggs: []Val = []
                let env = Env{cols: &q.cols, row: &full, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
                let scans = try pathScans(&lv.t, &lv.path, &env)
                for sc in scans {
                    var cur = newCursor()
                    while !cur.done { try fetch(st, txn, &lv.t, &lv.path, &sc, &lv.need, mut &cur, mut &rows) }
                }
            }
            rs.cnt[k].built += len(rows)
            try rs.hold(rowsBytes(&rows))
            let keepAll = keepsRight(lv.join)
            for i in 0..len(rows) {
                let r = replace(mut &rows[i], [])
                for j in 0..len(r) { full[lv.first + j] = r[j] }
                if !(try allTrueX(st, txn, q, m, &lv.local, &full, params, rs)) { continue }
                var kb = newStrBuf()
                var nul = false
                for c in lv.hashCols {
                    if isNull(&r[c]) { nul = true }
                    if lv.virt() { keyPart(mut &kb, &r[c]) } else { encIdxPart(mut &kb, &r[c]) }
                }
                if nul {
                    // NULL equals nothing; a RIGHT or FULL JOIN still keeps the row
                    if keepAll {
                        append(mut &mat, r)
                        rs.cnt[k].kept += 1
                    }
                    continue
                }
                let key = kb.toStr()
                var b = -1
                match keys.get(&key) {
                    Some(x) { b = x }
                    None {
                        b = len(buckets)
                        keys.put(key, b)
                        append(mut &buckets, [])
                    }
                }
                append(mut &buckets[b], len(mat))
                append(mut &mat, r)
                rs.cnt[k].kept += 1
            }
        }
        if keepsRight(q.levels[k].join) { rs.seen[k] = array(len(mat), false) }
        m.mat[k] = mat
        m.keys[k] = keys
        m.buckets[k] = buckets
    }
    return Ok(Unit{})
}

// Places a candidate row of level k in the joined row and goes on to the
// next level if it joins: -1 stop, 0 it does not join, 1 it joined.
fn tryRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, k: int, r: &[]Val, ri: int,
          row: mut &[]Val, params: &[]Val, emit: &fn(&[]Val): Result[bool, DbErr], rs: mut &Run): Result[int, DbErr] {
    try rs.tick()
    let lv = &q.levels[k]
    for i in 0..len(r) { row[lv.first + i] = r[i] }
    rs.cnt[k].read += 1
    if !(try allTrueX(st, txn, q, m, &lv.cond, row, params, rs)) { return Ok(0) }
    rs.cnt[k].joined += 1
    if ri >= 0 && len(rs.seen[k]) > 0 { rs.seen[k][ri] = true }
    if !(try allTrueX(st, txn, q, m, &lv.post, row, params, rs)) { return Ok(1) }
    if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(-1) }
    return Ok(1)
}

// Joins the rows of level k on to the joined row (levels before k filled),
// calling emit for each complete row; false: emit asked to stop.
fn runLevel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, k: int, row: mut &[]Val,
            params: &[]Val, emit: &fn(&[]Val): Result[bool, DbErr], rs: mut &Run): Result[bool, DbErr] {
    let sqe = seqEnv(st, txn)
    if k == len(q.levels) { return emit(row) }
    let lv = &q.levels[k]
    var matched = false
    rs.cnt[k].starts += 1
    // the first level scanned in batches (9.52), or -1
    let bl = if k == 0 { try batchLevel(st, txn, q, m, row, params, emit, rs, mut &matched) } else { -1 }
    if bl == 1 { return Ok(false) }
    if bl == 0 {
        // done: its rows went on
    } else if !lv.perRow {
        var kb = newStrBuf()
        var nul = false
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            for i in 0..len(lv.hashCols) {
                if lv.virt() {
                    let v = try eval(&lv.hashVals[i], &env)
                    if isNull(&v) { nul = true }
                    keyPart(mut &kb, &v)
                } else {
                    let v = try coerce(try eval(&lv.hashVals[i], &env), &lv.t.cols[lv.hashCols[i]].typ)
                    if isNull(&v) { nul = true }
                    encIdxPart(mut &kb, &v)
                }
            }
        }
        if !nul {
            match m.keys[k].get(&kb.toStr()) {
                Some(b) {
                    for ri in m.buckets[k][b] {
                        let got = try tryRow(st, txn, q, m, k, &m.mat[k][ri], ri, row, params, emit, rs)
                        if got < 0 { return Ok(false) }
                        if got > 0 { matched = true }
                    }
                }
                None {}
            }
        }
    } else if lv.lateral {
        // its subquery with this row's values, its rows kept per values
        let i = lv.src
        var refVals: []Val = []
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            for x in q.subs[i].sel.q.refs { append(mut &refVals, try eval(&x, &env)) }
        }
        let key = valsKey(&refVals)
        var at = -1
        match rs.memo[i].get(&key) {
            Some(n) { at = n }
            None {}
        }
        var rows: [][]Val = []
        if at >= 0 {
            rs.stats[i].hits += 1
            rows = replace(mut &rs.memoRes[i][at].data, [])
        } else {
            var ps: []Val = []
            for j in 0..q.base { append(mut &ps, params[j]) }
            for v in refVals { append(mut &ps, v) }
            var res = try runChild(st, txn, &q.subs[i].sel, &ps, -1, rs, i)
            rows = replace(mut &res.rows, [])
            if len(rs.memoRes[i]) < MEMO_MAX {
                try rs.hold(rowsBytes(&rows) + len(key) + 48)
                at = len(rs.memoRes[i])
                rs.memo[i].put(key, at)
                append(mut &rs.memoRes[i], emptyRes())
            }
        }
        for r in rows {
            let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
            if got < 0 { return Ok(false) }
            if got > 0 { matched = true }
        }
        if at >= 0 { rs.memoRes[i][at].data = rows }
    } else if lv.virt() {
        for r in m.vrows[k] {
            let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
            if got < 0 { return Ok(false) }
            if got > 0 { matched = true }
        }
    } else {
        var scans: []Scan = []
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            if q.corr && pathCorr(&lv.path) {
                let cur = try pathCur(st, txn, q, &lv.path, &env, rs)
                let env2 = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &cur, seq: sqe}
                scans = try pathScans(&lv.t, &lv.path, &env2)
            } else {
                scans = try pathScans(&lv.t, &lv.path, &env)
            }
        }
        for sc in scans {
            var cur = newCursor()
            while !cur.done {
                var batch: [][]Val = []
                try fetch(st, txn, &lv.t, &lv.path, &sc, &lv.need, mut &cur, mut &batch)
                for r in batch {
                    let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
                    if got < 0 { return Ok(false) }
                    if got > 0 { matched = true }
                }
            }
        }
    }
    if keepsLeft(lv.join) && !matched {
        for i in 0..len(lv.t.cols) { row[lv.first + i] = Val.Null }
        rs.cnt[k].nulls += 1
        if try allTrueX(st, txn, q, m, &lv.post, row, params, rs) {
            if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(false) }
        }
    }
    return Ok(true)
}

// Calls emit on each row of the query (materialize first).
fn runQuery(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val,
            emit: &fn(&[]Val): Result[bool, DbErr], rs: mut &Run): Result[Unit, DbErr] {
    if len(q.levels) == 0 {
        let none: []Val = []
        if try allTrueX(st, txn, q, m, &q.top, &none, params, rs) { let more = try emit(&none) }
        return Ok(Unit{})
    }
    var row: []Val = array(len(q.cols), Val.Null)
    if !(try runLevel(st, txn, q, m, 0, mut &row, params, emit, rs)) { return Ok(Unit{}) }
    // A RIGHT or FULL JOIN's rows that joined nothing, with NULLs for the
    // tables before it, go on through the tables after it.
    for k in 1..len(q.levels) {
        let lv = &q.levels[k]
        if !keepsRight(lv.join) { continue }
        for ri in 0..len(m.mat[k]) {
            if rs.seen[k][ri] { continue }
            for i in 0..len(row) { row[i] = Val.Null }
            for i in 0..len(m.mat[k][ri]) { row[lv.first + i] = m.mat[k][ri][i] }
            rs.cnt[k].unmatched += 1
            if try allTrueX(st, txn, q, m, &lv.post, &row, params, rs) {
                if !(try runLevel(st, txn, q, m, k + 1, mut &row, params, emit, rs)) { return Ok(Unit{}) }
            }
        }
    }
    return Ok(Unit{})
}

// ---- subqueries (design 9.8)
//
// A statement's subqueries are planned with it, each inside the query it is
// in. A name not among a query's own columns is looked for in the queries
// around it, nearest first, and becomes a parameter after the statement's
// own: the query it is in supplies its value (its "refs"), and a query in
// between passes it down. A subquery with no refs is run once per
// execution, before the query; one with refs is run for each row that needs
// it, its result kept per value of its refs.

const MEMO_MAX = 10000          // results kept per correlated subquery

type SubPlan = record {
    use: int                    // lexdb_sql.SUB_SCALAR, SUB_EXISTS, SUB_IN
    sel: Sel
    oid: int                    // its column's type
    name: str                   // its column's name, as an output column
    hashed: bool                // correlated, run once into a hash: sel outputs the key (then IN's value, a scalar's aggregate)
    keyOuter: []Expr            // per key column: what it equals, of outer values only (refs as parameters)
    keyText: []str              // EXPLAIN: "inner = outer"
    cte: int                    // a CTE's use: the CTE's number (its rows shared); -1
}

// A subquery's result: a scalar's value, how many rows, IN's values.
type SubRes = record {
    val: Val
    rows: int
    set: Map[str, int]
    numeric: bool               // the values are numbers: keyed as numbers
    hasNull: bool
    groups: Map[str, int]       // hashed: key -> 1 rows, 3 rows and a NULL value (IN)
    data: [][]Val               // in FROM: its rows
    vals: []Val                 // IN: its distinct values not NULL, IN_LOOKUP_MAX + 1 at most (Path.inSub)
}

fn emptyRes(): SubRes {
    return SubRes{val: Val.Null, rows: 0, set: newMap(), numeric: false, hasNull: false, groups: newMap(), data: [], vals: []}
}

// The queries being planned, outermost first.
type Frame = record {
    cols: []lexdb_sql.ColDef
    refs: []Expr                // the outer values it uses, in the terms of the query around it
    refOids: []int
    subRefs: [][]Expr           // per subquery of it: the subquery's refs, in its terms
    subOids: []int
    subNames: []str
    hidden: bool                // its columns are not in scope (a FROM subquery that is not LATERAL)
}

pub type Scope = record {
    frames: []Frame
    base: int                   // the statement's parameters
    ptypes: []int
    works: []Work               // the working tables of recursive CTEs being planned
    // privileges (9.83): the roles a view's query is checked as (its
    // owner's, innermost last; none: the session's), the role checks so
    // far, and an UPDATE's or DELETE's target, checked by its statement
    asRole: []str
    whos: []Who
    target: str
}

type Work = record { id: int; cols: []lexdb_sql.ColDef }

// SELECT on relation key, for a query being planned: as its view's owner,
// or the session's role (9.83).
fn scCheck(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: mut &Scope, key: &str, kind: &str): Result[Unit, DbErr] {
    let actAs = if len(sc.asRole) > 0 { sc.asRole[len(sc.asRole) - 1] } else { currentRole(st, txn.sess) }
    var at = -1
    for i in 0..len(sc.whos) { if sc.whos[i].name == actAs { at = i } }
    if at < 0 {
        append(mut &sc.whos, try whoIs(st, txn, &actAs))
        at = len(sc.whos) - 1
    }
    if sc.whos[at].super { return Ok(Unit{}) }
    let w = Who{name: sc.whos[at].name, super: false, roles: copyStrs(&sc.whos[at].roles)}
    return needRel(st, txn, &w, key, &"r", kind)
}

fn newScope(params: &[]Val, ptypes: &[]int): Scope {
    var pt: []int = []
    for i in 0..len(params) { append(mut &pt, if i < len(ptypes) { ptypes[i] } else { 0 }) }
    return Scope{frames: [], base: len(params), ptypes: pt, works: [], asRole: [], whos: [], target: ""}
}

// The parameter types of the query being planned: the statement's, then
// its refs'.
fn ptypesOf(sc: &Scope): []int {
    var out: []int = []
    for t in sc.ptypes { append(mut &out, t) }
    if len(sc.frames) > 0 { for t in sc.frames[len(sc.frames) - 1].refOids { append(mut &out, t) } }
    return out
}

// A name of a query around the one being planned, as a parameter of it.
fn outerRef(sc: mut &Scope, name: &str): Result[Option[Expr], DbErr] {
    let top = len(sc.frames) - 1
    var f = top - 1
    var found = ""
    var oid = 0
    while f >= 0 && found == "" {
        if sc.frames[f].hidden {
            f -= 1
            continue
        }
        match resolveName(&sc.frames[f].cols, len(sc.frames[f].cols), name) {
            Ok(n) {
                oid = sc.frames[f].cols[colIndex(&sc.frames[f].cols, &n)].typ.oid
                found = n
            }
            Err(x) {
                // ambiguous there, or its table is there and the column is not
                if x.state == "42702" || (x.state == "42703" && dotAt(name) >= 0) { return Err(x) }
            }
        }
        if found == "" { f -= 1 }
    }
    if found == "" { return Ok(None) }
    var x = Expr.Col(found)
    for g in f + 1..top + 1 {
        let t = lexdb_sql.exprText(&x)
        var at = -1
        for i in 0..len(sc.frames[g].refs) { if lexdb_sql.exprText(&sc.frames[g].refs[i]) == t { at = i } }
        if at < 0 {
            at = len(sc.frames[g].refs)
            append(mut &sc.frames[g].refs, clone(&x))
            append(mut &sc.frames[g].refOids, oid)
        }
        x = Expr.Param(sc.base + at + 1)
    }
    return Ok(Some(x))
}

// The query being planned is done: its refs are what the query around it
// must supply.
fn endScope(sc: mut &Scope, q: mut &Query) {
    var f = pop(mut &sc.frames)
    q.refs = replace(mut &f.refs, [])
}

fn planSub(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val,
           sc: mut &Scope): Result[SubPlan, DbErr] {
    var sel = try planSelect(st, txn, s, params, sc)
    if len(s.srf) > 0 { sel.outs = try srfCols(&s.srf, s.ordin, &sel.outs) }
    if s.use == lexdb_sql.SUB_IN && len(sel.outs) != 1 { return Err(e("42601", "subquery has too many columns")) }
    if s.use == lexdb_sql.SUB_SCALAR && len(sel.outs) != 1 { return Err(e("42601", "subquery must return only one column")) }
    let oid = if s.use == lexdb_sql.SUB_EXISTS || len(sel.outs) == 0 { lexdb_sql.OID_BOOL } else { sel.outs[0].oid }
    let name = if s.use == lexdb_sql.SUB_EXISTS { "exists" } else if s.use == lexdb_sql.SUB_SCALAR { sel.outs[0].name } else { "?column?" }
    // (in FROM: its columns are its outs)
    var sp = SubPlan{use: s.use, sel: sel, oid: oid, name: name, hashed: false, keyOuter: [], keyText: [], cte: s.cte}
    if len(sp.sel.q.refs) > 0 && s.use != lexdb_sql.SUB_FROM { hashSub(mut &sp, sc.base) }
    return Ok(sp)
}

// ---- hashed subqueries: a semi-join (EXISTS, IN) or anti-join (NOT ...)
//
// A correlated EXISTS or IN whose outer values are used only in WHERE
// equalities "inner = outer" (outer: of outer values only), none of them a
// lookup's key, is the same
// subquery without them, keyed by their inner sides: it is run once into a
// hash, and each outer row probes it. (With such a key, an index, it stays
// per row: a lookup each.)

fn refOf(x: &Expr, base: int): int {
    match x {
        Expr.Param(n) { if n > base { return n - base - 1 } }
        else {}
    }
    return -1
}

fn usesRefs(x: &Expr, base: int): bool {
    match x {
        Expr.Param(n) { return n > base }
        Expr.Unary(_, a) { return usesRefs(&a, base) }
        Expr.Bin(_, a, b) { return usesRefs(&a, base) || usesRefs(&b, base) }
        Expr.IsNull(a, _) { return usesRefs(&a, base) }
        Expr.Cast(a, _) { return usesRefs(&a, base) }
        Expr.Call(_, args, _) {
            for a in args { if usesRefs(&a, base) { return true } }
            return false
        }
        else { return false }
    }
}

type HashKeys = record {
    inner: []Expr
    outer: []Expr
    texts: []str                // the conjuncts taken out, by their text
}

// Of outer values only: no column of the subquery's, no subquery.
fn outerOnly(x: &Expr, base: int): bool {
    var ns: []str = []
    colNames(x, mut &ns)
    return len(ns) == 0 && usesRefs(x, base) && !hasAgg(x) && !hasSubCall(x)
}

fn hasSubCall(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasSubCall(&a) }
        Expr.Bin(_, a, b) { return hasSubCall(&a) || hasSubCall(&b) }
        Expr.IsNull(a, _) { return hasSubCall(&a) }
        Expr.Cast(a, _) { return hasSubCall(&a) }
        Expr.Call(n, args, _) {
            if isSubCall(&n) { return true }
            for a in args { if hasSubCall(&a) { return true } }
            return false
        }
        else { return false }
    }
}

// A conjunct "inner = outer" (either way round), into hk; false: it uses an
// outer value otherwise.
fn keyConj(c: &Expr, base: int, hk: mut &HashKeys): bool {
    let t = lexdb_sql.exprText(c)
    for x in hk.texts { if x == t { return true } }
    match c {
        Expr.Bin(op, a, b) {
            if op != "=" { return false }
            var inner = clone(&a)
            var outer = clone(&b)
            if !outerOnly(&outer, base) {
                inner = clone(&b)
                outer = clone(&a)
            }
            if !outerOnly(&outer, base) || usesRefs(&inner, base) || hasCorr(&inner) { return false }
            append(mut &hk.inner, inner)
            append(mut &hk.outer, outer)
            append(mut &hk.texts, t)
            return true
        }
        else { return false }
    }
}

fn keyConjs(cs: &[]Expr, base: int, hk: mut &HashKeys, movable: bool): bool {
    for c in cs {
        if !usesRefs(&c, base) { continue }
        if !movable || !keyConj(&c, base, hk) { return false }
    }
    return true
}

fn noRefs(xs: &[]Expr, base: int): bool {
    for x in xs { if usesRefs(&x, base) { return false } }
    return true
}

fn dropTexts(cs: []Expr, texts: &[]str): []Expr {
    var all = cs
    var out: []Expr = []
    for i in 0..len(all) {
        let c = replace(mut &all[i], Expr.Lit(Val.Null))
        let t = lexdb_sql.exprText(&c)
        var drop = false
        for x in texts { if x == t { drop = true } }
        if !drop { append(mut &out, c) }
    }
    return out
}

fn hashSub(sp: mut &SubPlan, base: int) {
    var hk = HashKeys{inner: [], outer: [], texts: []}
    // a scalar subquery: one aggregate row, no GROUP BY, its key's groups
    // then its value per group (9.26)
    let scalar = sp.use == lexdb_sql.SUB_SCALAR
    {
        let sel = &sp.sel
        if sel.setop != 0 || sel.limit >= 0 || sel.offset > 0 || len(sel.groupBy) > 0 { return }
        if scalar {
            if !sel.aggQ || sel.having.isSome() || sel.distinct || len(sel.exprs) != 1 || hasSubCall(&sel.exprs[0]) { return }
        } else if sel.aggQ { return }
        if !noRefs(&sel.exprs, base) || !noRefs(&sel.order, base) { return }
        let q = &sel.q
        for lv in q.levels {
            if !noRefs(&lv.path.eqs, base) || !noRefs(&lv.path.ins, base) || !noRefs(&lv.hashVals, base) { return }
            for b in lv.path.rng { if usesRefs(&b.val, base) { return } }
            // an outer join's ON conjuncts are not WHERE filters: they stay
            if !keyConjs(&lv.cond, base, mut &hk, !isOuter(lv.join)) { return }
            if !keyConjs(&lv.post, base, mut &hk, true) { return }
            if !keyConjs(&lv.local, base, mut &hk, !isOuter(lv.join)) { return }
        }
        if !keyConjs(&q.top, base, mut &hk, true) { return }
        if len(hk.inner) == 0 { return }
    }
    for k in 0..len(sp.sel.q.levels) {
        sp.sel.q.levels[k].cond = dropTexts(replace(mut &sp.sel.q.levels[k].cond, []), &hk.texts)
        sp.sel.q.levels[k].post = dropTexts(replace(mut &sp.sel.q.levels[k].post, []), &hk.texts)
        sp.sel.q.levels[k].local = dropTexts(replace(mut &sp.sel.q.levels[k].local, []), &hk.texts)
    }
    sp.sel.q.top = dropTexts(replace(mut &sp.sel.q.top, []), &hk.texts)
    // it outputs the key, then IN's value or the scalar's aggregate (grouped
    // by the key)
    var outs: []Expr = []
    for x in hk.inner { append(mut &outs, clone(&x)) }
    if sp.use == lexdb_sql.SUB_IN || scalar { append(mut &outs, clone(&sp.sel.exprs[0])) }
    if scalar {
        var gb: []Expr = []
        for x in hk.inner { append(mut &gb, clone(&x)) }
        sp.sel.groupBy = gb
        sp.sel.first = -1               // per group now: no stopping at the first row
    }
    var texts: []str = []
    for i in 0..len(hk.inner) {
        let r = refOf(&hk.outer[i], base)
        var outer = "an outer expression"
        if r >= 0 {
            outer = match sp.sel.q.refs[r] {
                Expr.Col(n) { n }
                else { "an outer value" }
            }
        }
        let inner = match hk.inner[i] {
            Expr.Col(n) { n }
            else { lexdb_sql.exprText(&hk.inner[i]) }
        }
        append(mut &texts, inner + " = " + outer)
    }
    sp.sel.exprs = outs
    sp.sel.order = []
    sp.sel.sort = false
    sp.sel.distinct = false
    sp.sel.desc = []
    sp.sel.nullsFirst = []
    sp.hashed = true
    sp.keyOuter = replace(mut &hk.outer, [])
    sp.keyText = texts
}

// A hash key's part: numbers by value (2 = 2.0), else as the value.
fn keyPart(b: mut &StrBuf, v: &Val) {
    match v {
        Val.Int(_) {}
        Val.Num(_) {}
        else {
            encIdxPart(b, v)
            return
        }
    }
    match asNum(v) {
        Some(d) {
            b.addByte(3)
            encNum(b, &d)
        }
        None { encIdxPart(b, v) }
    }
}

// Runs a hashed subquery once: its keys (a NULL key matches nothing), and
// for IN its values per key.
fn runHashed(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
             i: int): Result[SubRes, DbErr] {
    let sqe = seqEnv(st, txn)
    let res = try runChild(st, txn, &sp.sel, params, -1, parent, i)
    var out = emptyRes()
    out.rows = len(res.rows)
    let nk = len(sp.keyOuter)
    if sp.use == lexdb_sql.SUB_SCALAR {
        for r in res.rows {
            var gk = newStrBuf()
            var nul = false
            for j in 0..nk {
                if isNull(&r[j]) { nul = true }
                keyPart(mut &gk, &r[j])
            }
            if nul { continue }
            out.groups.put(gk.toStr(), len(out.data))
            append(mut &out.data, [r[nk]])
        }
        // a key with no rows: the aggregate over none (count 0, sum NULL)
        var vals: []Val = []
        for spec in sp.sel.specs {
            let a = newAccs(1)
            append(mut &vals, try finish(&spec, &a[0]))
        }
        let noRow: []Val = array(len(sp.sel.q.cols), Val.Null)
        let noSubs: []SubRes = []
        let env = Env{cols: &sp.sel.q.cols, row: &noRow, aggs: &vals, params: params, subs: &noSubs, cur: &noRow, seq: sqe}
        out.val = try eval(&sp.sel.exprs[nk], &env)
        return Ok(out)
    }
    for r in res.rows {
        var gk = newStrBuf()
        var nul = false
        for j in 0..nk {
            if isNull(&r[j]) { nul = true }
            keyPart(mut &gk, &r[j])
        }
        if nul { continue }
        let g = gk.toStr()
        var f = 1
        if sp.use == lexdb_sql.SUB_IN {
            if isNull(&r[nk]) {
                f = 3
            } else {
                var mk = newStrBuf()
                mk.add(g)
                keyPart(mut &mk, &r[nk])
                out.set.put(mk.toStr(), 1)
            }
        }
        match out.groups.get(&g) {
            Some(old) { if old < f { out.groups.put(g, f) } }
            None { out.groups.put(g, f) }
        }
    }
    return Ok(out)
}

// A hashed subquery's value for an outer row: its key's values, IN's x.
fn hashValue(n: &str, r: &SubRes, keyVals: &[]Val, x: &Val): Val {
    var gk = newStrBuf()
    var miss = false
    for v in keyVals {
        if isNull(&v) { miss = true }               // inner = NULL: no row
        keyPart(mut &gk, &v)
    }
    if n == "#sub" {
        // a scalar: its group's value, or the aggregate over no rows
        if miss { return r.val }
        match r.groups.get(&gk.toStr()) {
            Some(i) { return r.data[i][0] }
            None { return r.val }
        }
    }
    var f = 0
    if !miss {
        match r.groups.get(&gk.toStr()) {
            Some(v) { f = v }
            None {}
        }
    }
    if f == 0 { return Val.Bool(false) }            // no rows for it
    if n == "#exists" { return Val.Bool(true) }
    if isNull(x) { return Val.Null }
    var mk = newStrBuf()
    mk.add(gk.toStr())
    keyPart(mut &mk, x)
    if r.set.get(&mk.toStr()).isSome() { return Val.Bool(true) }
    return if f == 3 { Val.Null } else { Val.Bool(false) }
}

fn isSubCall(n: &str): bool { return n == "#sub" || n == "#exists" || n == "#in" }

// A resolved subquery call's arguments before its refs: number, type, name
// (and IN's value).
fn subFixed(n: &str): int { return if n == "#in" { 4 } else { 3 } }

fn litInt(x: &Expr): int {
    match x {
        Expr.Lit(v) { match v { Val.Int(n) { return n } else {} } }
        else {}
    }
    return -1
}

// Has a correlated subquery: one run per row.
fn hasCorr(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasCorr(&a) }
        Expr.Bin(_, a, b) { return hasCorr(&a) || hasCorr(&b) }
        Expr.IsNull(a, _) { return hasCorr(&a) }
        Expr.Cast(a, _) { return hasCorr(&a) }
        Expr.Call(n, args, _) {
            if isSubCall(&n) && len(args) > subFixed(&n) { return true }
            for a in args { if hasCorr(&a) { return true } }
            return false
        }
        else { return false }
    }
}

fn subsLast(cs: []Expr): []Expr {
    var all = cs
    var first: []Expr = []
    var last: []Expr = []
    for i in 0..len(all) {
        let c = replace(mut &all[i], Expr.Lit(Val.Null))
        if hasCorr(&c) { append(mut &last, c) } else { append(mut &first, c) }
    }
    for i in 0..len(last) { append(mut &first, replace(mut &last[i], Expr.Lit(Val.Null))) }
    return first
}

// An IN set's key: numbers by value (1 = 1.0), else as the value.
fn setKey(v: &Val, numeric: bool): Option[str] {
    var kb = newStrBuf()
    if numeric {
        match asNum(v) {
            Some(d) {
                encNum(mut &kb, &d)
                return Some(kb.toStr())
            }
            None { return None }
        }
    }
    encIdxPart(mut &kb, v)
    return Some(kb.toStr())
}

// x IN (subquery): true if one equals x; else NULL if x or one is NULL.
fn inProbe(r: &SubRes, x: &Val): Val {
    if r.rows == 0 { return Val.Bool(false) }
    if isNull(x) { return Val.Null }
    match setKey(x, r.numeric) {
        Some(k) { if r.set.get(&k).isSome() { return Val.Bool(true) } }
        None {}
    }
    return if r.hasNull { Val.Null } else { Val.Bool(false) }
}

fn subValue(n: &str, r: &SubRes, x: &Val): Val {
    if n == "#exists" { return Val.Bool(r.rows > 0) }
    if n == "#in" { return inProbe(r, x) }
    return r.val
}

fn addCounts(a: mut &[]Counts, b: &[]Counts) {
    if len(a) == 0 {
        for c in b { append(a, c) }
        return
    }
    for i in 0..len(b) {
        a[i].starts += b[i].starts
        a[i].read += b[i].read
        a[i].joined += b[i].joined
        a[i].nulls += b[i].nulls
        a[i].built += b[i].built
        a[i].kept += b[i].kept
        a[i].unmatched += b[i].unmatched
        a[i].batches += b[i].batches
    }
}

fn mergeStats(a: mut &[]SubStat, b: &[]SubStat) {
    for i in 0..len(b) {
        if i >= len(a) { append(a, SubStat{runs: 0, hits: 0, cnt: [], inner: []}) }
        a[i].runs += b[i].runs
        a[i].hits += b[i].hits
        addCounts(mut &a[i].cnt, &b[i].cnt)
        mergeStats(mut &a[i].inner, &b[i].inner)
    }
}

// A subquery in FROM: its rows.
fn runFrom(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
           i: int): Result[SubRes, DbErr] {
    var out = emptyRes()
    // a CTE: run once in the statement, its rows kept for its other uses
    let key = "c" + sp.cte.toStr()
    if sp.cte >= 0 {
        let at = cacheAt(&parent.cache, &key)
        if at >= 0 {
            out.data = copyRows(&parent.cache.rows[at])
            out.rows = len(out.data)
            parent.stats[i].hits += 1
            return Ok(out)
        }
    }
    var res = try runChild(st, txn, &sp.sel, params, -1, parent, i)
    out.rows = len(res.rows)
    out.data = replace(mut &res.rows, [])
    if sp.cte >= 0 {
        try parent.hold(rowsBytes(&out.data))
        cachePut(mut &parent.cache, key, copyRows(&out.data))
    }
    return Ok(out)
}

// Rows the statement's queries share while it runs: a CTE's ("c" and its
// number), a recursive CTE's working table ("w"). A query's run hands them
// to the runs inside it and takes them back.
type CteCache = record { index: Map[str, int]; rows: [][][]Val }

fn newCache(): CteCache { return CteCache{index: newMap(), rows: []} }

fn cacheAt(c: &CteCache, key: &str): int {
    match c.index.get(key) {
        Some(i) { return i }
        None { return -1 }
    }
}

fn cachePut(c: mut &CteCache, key: str, rows: [][]Val) {
    let at = cacheAt(c, &key)
    if at >= 0 {
        c.rows[at] = rows
        return
    }
    c.index.put(key, len(c.rows))
    append(mut &c.rows, rows)
}

fn copyRows(rows: &[][]Val): [][]Val {
    var out: [][]Val = []
    for r in rows { append(mut &out, copyRow(&r)) }
    return out
}

// Runs a planned query inside another's run: the shared rows go with it,
// and its counts add to the parent's slot i (EXPLAIN ANALYZE).
fn runChild(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int, parent: mut &Run,
            i: int): Result[Res, DbErr] {
    var rs = newRun(&sel.q)
    rs.maxRounds = parent.maxRounds
    rs.maxHeld = parent.maxHeld
    rs.deadline = parent.deadline
    rs.batch = parent.batch
    rs.held = parent.held
    rs.ticks = parent.ticks
    rs.turnEnd = parent.turnEnd
    rs.cache = replace(mut &parent.cache, newCache())
    let r = execSel(st, txn, sel, params, cap, mut &rs)
    parent.cache = replace(mut &rs.cache, newCache())
    parent.ticks = rs.ticks
    parent.turnEnd = rs.turnEnd
    while len(parent.stats) <= i { append(mut &parent.stats, SubStat{runs: 0, hits: 0, cnt: [], inner: []}) }
    parent.stats[i].runs += 1
    addCounts(mut &parent.stats[i].cnt, &rs.cnt)
    mergeStats(mut &parent.stats[i].inner, &rs.stats)
    return r
}

// A column type for a result's OID.
fn oidType(oid: int): lexdb_sql.TypeName {
    if lexdb_sql.timeKind(oid) > 0 { return lexdb_sql.timeType(oid) }
    if oid == lexdb_sql.OID_UUID { return lexdb_sql.TypeName{kind: lexdb_sql.K_UUID, oid: oid, prec: 0, scale: 0, len: 0} }
    if oid == lexdb_sql.OID_BYTEA { return lexdb_sql.TypeName{kind: lexdb_sql.K_BYTEA, oid: oid, prec: 0, scale: 0, len: 0} }
    if oid == lexdb_sql.OID_FLOAT4 || oid == lexdb_sql.OID_FLOAT8 { return lexdb_sql.floatType(oid) }
    if lexdb_sql.elemOid(oid) > 0 { return lexdb_sql.TypeName{kind: lexdb_sql.K_ARRAY, oid: oid, prec: 0, scale: 0, len: 0} }
    var kind = lexdb_sql.K_TEXT
    var o = oid
    if oid == lexdb_sql.OID_BOOL { kind = lexdb_sql.K_BOOL }
    if oid == lexdb_sql.OID_INT2 || oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT8 { kind = lexdb_sql.K_INT }
    if oid == lexdb_sql.OID_NUMERIC { kind = lexdb_sql.K_NUM }
    if kind == lexdb_sql.K_TEXT && oid != lexdb_sql.OID_VARCHAR { o = lexdb_sql.OID_TEXT }
    return lexdb_sql.TypeName{kind: kind, oid: o, prec: 0, scale: 0, len: 0}
}

// Runs a subquery: EXISTS stops at its first row, a scalar at its second.
fn runSub(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
          i: int): Result[SubRes, DbErr] {
    let cap = if sp.use == lexdb_sql.SUB_EXISTS { 1 } else if sp.use == lexdb_sql.SUB_SCALAR { 2 } else { -1 }
    let res = try runChild(st, txn, &sp.sel, params, cap, parent, i)
    var out = emptyRes()
    out.rows = len(res.rows)
    if sp.use == lexdb_sql.SUB_SCALAR {
        if len(res.rows) > 1 { return Err(e("21000", "more than one row returned by a subquery used as an expression")) }
        if len(res.rows) == 1 { out.val = res.rows[0][0] }
    } else if sp.use == lexdb_sql.SUB_IN {
        for r in res.rows {
            match r[0] {
                Val.Int(_) { out.numeric = true }
                Val.Num(_) { out.numeric = true }
                else {}
            }
        }
        for r in res.rows {
            if isNull(&r[0]) {
                out.hasNull = true
                continue
            }
            match setKey(&r[0], out.numeric) {
                Some(k) {
                    if out.set.get(&k).isNone() && len(out.vals) <= IN_LOOKUP_MAX { append(mut &out.vals, r[0]) }
                    out.set.put(k, 1)
                }
                None {}
            }
        }
    }
    return Ok(out)
}

// The values of the correlated subqueries in x for env's row, into cur.
fn fillCur(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, x: &Expr, env: &Env, rs: mut &Run,
           cur: mut &[]Val): Result[Unit, DbErr] {
    let sqe = seqEnv(st, txn)
    match x {
        Expr.Unary(_, a) { return fillCur(st, txn, q, &a, env, rs, cur) }
        Expr.Bin(_, a, b) {
            try fillCur(st, txn, q, &a, env, rs, cur)
            return fillCur(st, txn, q, &b, env, rs, cur)
        }
        Expr.IsNull(a, _) { return fillCur(st, txn, q, &a, env, rs, cur) }
        Expr.Cast(a, _) { return fillCur(st, txn, q, &a, env, rs, cur) }
        Expr.Call(n, args, _) {
            let fixed = subFixed(&n)
            if !(isSubCall(&n) && len(args) > fixed) {
                for a in args { try fillCur(st, txn, q, &a, env, rs, cur) }
                return Ok(Unit{})
            }
            let i = litInt(&args[0])
            var xv = Val.Null
            if n == "#in" {
                try fillCur(st, txn, q, &args[3], env, rs, cur)
                let env2 = Env{cols: env.cols, row: env.row, aggs: env.aggs, params: env.params, subs: env.subs, cur: cur, seq: sqe}
                xv = try eval(&args[3], &env2)
            }
            var refVals: []Val = []
            for j in fixed..len(args) { append(mut &refVals, try eval(&args[j], env)) }
            if q.subs[i].hashed {
                // its key's outer sides, over the statement's parameters and its refs' values
                var ps: []Val = []
                for j in 0..q.base { append(mut &ps, env.params[j]) }
                for v in refVals { append(mut &ps, v) }
                let noCols: []lexdb_sql.ColDef = []
                let noRow: []Val = []
                let kenv = Env{cols: &noCols, row: &noRow, aggs: &noRow, params: &ps, subs: env.subs, cur: &noRow, seq: sqe}
                var kv: []Val = []
                for ko in q.subs[i].keyOuter { append(mut &kv, try eval(&ko, &kenv)) }
                rs.stats[i].hits += 1
                cur[i] = hashValue(&n, &env.subs[i], &kv, &xv)
                return Ok(Unit{})
            }
            let key = valsKey(&refVals)
            var at = -1
            match rs.memo[i].get(&key) {
                Some(k) { at = k }
                None {}
            }
            if at >= 0 {
                rs.stats[i].hits += 1
                cur[i] = subValue(&n, &rs.memoRes[i][at], &xv)
                return Ok(Unit{})
            }
            var ps: []Val = []
            for j in 0..q.base { append(mut &ps, env.params[j]) }
            for v in refVals { append(mut &ps, v) }
            let r = try runSub(st, txn, &q.subs[i], &ps, rs, i)
            cur[i] = subValue(&n, &r, &xv)
            if len(rs.memoRes[i]) < MEMO_MAX {
                try rs.hold(resBytes(&r) + len(key) + 48)
                rs.memo[i].put(key, len(rs.memoRes[i]))
                append(mut &rs.memoRes[i], r)
            }
            return Ok(Unit{})
        }
        else { return Ok(Unit{}) }
    }
}

// eval, running x's correlated subqueries for env's row first.
fn evalX(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, x: &Expr, env: &Env,
         rs: mut &Run): Result[Val, DbErr] {
    if !q.corr || !hasCorr(x) { return eval(x, env) }
    let sqe = seqEnv(st, txn)
    var cur: []Val = array(len(q.subs), Val.Null)
    try fillCur(st, txn, q, x, env, rs, mut &cur)
    let env2 = Env{cols: env.cols, row: env.row, aggs: env.aggs, params: env.params, subs: env.subs, cur: &cur, seq: sqe}
    return eval(x, &env2)
}

fn allTrueX(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, cs: &[]Expr, row: &[]Val,
            params: &[]Val, rs: mut &Run): Result[bool, DbErr] {
    let sqe = seqEnv(st, txn)
    if len(cs) == 0 { return Ok(true) }
    let noAggs: []Val = []
    let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
    for c in cs { if truth(&(try evalX(st, txn, q, &c, &env, rs))) != Some(true) { return Ok(false) } }
    return Ok(true)
}

// What a query's run reads besides its tables: per hash-joined level its
// rows, and the results of the subqueries run once.
type Mats = record {
    vrows: [][][]Val            // per level of rows held by the run: its rows
    mat: [][][]Val
    keys: []Map[str, int]       // hash key -> bucket
    buckets: [][][]int          // rows of mat
    subs: []SubRes
}

// Before a query runs: its subqueries without refs, then its hash tables.
fn prepare(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, params: &[]Val,
           rs: mut &Run): Result[Mats, DbErr] {
    var m = Mats{vrows: [], mat: [], keys: [], buckets: [], subs: []}
    for k in 0..len(q.levels) {
        append(mut &m.vrows, [])
        append(mut &m.mat, [])
        append(mut &m.keys, newMap())
        append(mut &m.buckets, [])
    }
    for i in 0..len(q.subs) {
        let sp = &q.subs[i]
        if len(sp.sel.q.refs) > 0 && !sp.hashed {
            append(mut &m.subs, emptyRes())
            continue
        }
        var ps: []Val = []
        for j in 0..q.base { append(mut &ps, params[j]) }
        if sp.use == lexdb_sql.SUB_FROM {
            append(mut &m.subs, try runFrom(st, txn, sp, &ps, rs, i))
        } else if sp.hashed {
            append(mut &m.subs, try runHashed(st, txn, sp, &ps, rs, i))
        } else {
            append(mut &m.subs, try runSub(st, txn, sp, &ps, rs, i))
        }
        try rs.hold(resBytes(&m.subs[len(m.subs) - 1]))
    }
    // the levels' rows: a subquery's (each is read by one level), a working table's
    for k in 0..len(q.levels) {
        if q.levels[k].src >= 0 { m.vrows[k] = replace(mut &m.subs[q.levels[k].src].data, []) }
        if q.levels[k].work >= 0 {
            let at = cacheAt(&rs.cache, &("w" + q.levels[k].work.toStr()))
            if at < 0 { return Err(e("XX000", "a working table is missing")) }
            m.vrows[k] = copyRows(&rs.cache.rows[at])
        }
    }
    try materialize(st, txn, q, mut &m, params, rs)
    return Ok(m)
}

// EXPLAIN's lines for a query's subqueries (with their runs, ANALYZE).
fn subLines(q: &Query, stats: &[]SubStat, out: mut &[]str) {
    let none: []Counts = []
    let noStats: []SubStat = []
    for i in 0..len(q.subs) {
        let sp = &q.subs[i]
        let what = if sp.use == lexdb_sql.SUB_EXISTS { "exists" } else if sp.use == lexdb_sql.SUB_IN { "in" } else if sp.use == lexdb_sql.SUB_FROM { "from" } else { "scalar" }
        var head = "subquery " + (i + 1).toStr() + " (" + what + "): "
        if sp.hashed {
            head = head + "hashed on " + strings.join(&sp.keyText, ", ")
        } else if len(sp.sel.q.refs) == 0 {
            head = head + "run once"
        } else {
            var rs: []str = []
            for r in sp.sel.q.refs {
                match r {
                    Expr.Col(n) { append(mut &rs, n) }
                    else { append(mut &rs, "an outer value") }
                }
            }
            head = head + "per row, on " + strings.join(&rs, ", ")
        }
        var inner: []str = []
        if i < len(stats) && sp.hashed {
            head = head + " (runs " + stats[i].runs.toStr() + ", probes " + stats[i].hits.toStr() + ")"
            inner = selLines(&sp.sel, &stats[i].cnt, &stats[i].inner)
        } else if i < len(stats) {
            head = head + " (runs " + stats[i].runs.toStr() + ", from cache " + stats[i].hits.toStr() + ")"
            inner = selLines(&sp.sel, &stats[i].cnt, &stats[i].inner)
        } else {
            inner = selLines(&sp.sel, &none, &noStats)
        }
        append(out, head)
        for l in inner { append(out, "  " + l) }
    }
}

fn pathText(lv: &Level): str {
    if lv.lateral { return "rows of subquery " + (lv.src + 1).toStr() + ", run" }
    if lv.src >= 0 { return "rows of subquery " + (lv.src + 1).toStr() }
    if lv.work >= 0 { return "rows of the working table" }
    let p = &lv.path
    let cols = keyCols(&lv.t, p.index)
    if len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 {
        let many = if p.inSub >= 0 { " value of subquery " + (p.inSub + 1).toStr() } else if len(p.inArr) > 0 { " element of the array" } else { " of " + len(p.ins).toStr() + " values" }
        let each = " for each" + many + (if p.desc { " backward" } else { "" })
        if p.index < 0 { return "primary key " + (if len(p.eqs) + 1 == len(cols) { "lookup" } else { "range" }) + each }
        return "index " + lexdb_sql.baseName(&lv.t.indexes[p.index].name) + (if lv.t.indexes[p.index].pred.isSome() { " (filtered)" } else { "" }) +
               " lookup" + each
    }
    if p.index < 0 {
        if len(p.eqs) == len(cols) { return "primary key lookup" }
        if len(p.eqs) > 0 || len(p.rng) > 0 { return "primary key range" }
        return "full scan" + (if p.desc { " backward" } else { "" })
    }
    let what = if len(p.eqs) == len(cols) { " lookup" } else if len(p.eqs) > 0 || len(p.rng) > 0 { " range" } else { " scan" }
    let filtered = if lv.t.indexes[p.index].pred.isSome() { " (filtered)" } else { "" }
    return "index " + lexdb_sql.baseName(&lv.t.indexes[p.index].name) + filtered + what + (if p.desc { " backward" } else { "" })
}

// EXPLAIN: a line per table; with counts (EXPLAIN ANALYZE), what each did.
fn explainLines(q: &Query, cnt: &[]Counts): []str {
    var out: []str = []
    for k in 0..len(q.levels) {
        var tail = ""
        if len(cnt) > 0 {
            let c = cnt[k]
            var parts: []str = []
            if k > 0 && !q.levels[k].perRow {
                append(mut &parts, "table rows " + c.kept.toStr() + " of " + c.built.toStr() + " read")
                append(mut &parts, "probes " + c.starts.toStr())
            } else if k > 0 {
                append(mut &parts, "lookups " + c.starts.toStr())
            }
            append(mut &parts, "rows read " + c.read.toStr())
            append(mut &parts, (if k == 0 { "kept " } else { "joined " }) + c.joined.toStr())
            if keepsLeft(q.levels[k].join) { append(mut &parts, "null rows " + c.nulls.toStr()) }
            if keepsRight(q.levels[k].join) { append(mut &parts, "unmatched rows " + c.unmatched.toStr()) }
            if c.batches > 0 { append(mut &parts, "batches " + c.batches.toStr()) }
            tail = " (" + strings.join(&parts, ", ") + ")"
        }
        let lv = &q.levels[k]
        let tn = lexdb_sql.baseName(&lv.t.name)
        let name = if lv.alias == tn { tn } else { tn + " " + lv.alias }
        if k == 0 {
            append(mut &out, "scan " + name + ": " + pathText(lv) + tail)
            continue
        }
        let kind = match lv.join {
            lexdb_sql.J_LEFT { "left join " }
            lexdb_sql.J_RIGHT { "right join " }
            lexdb_sql.J_FULL { "full join " }
            lexdb_sql.J_CROSS { "cross join " }
            else { "join " }
        }
        var how = ""
        if lv.perRow {
            how = pathText(lv) + " per row"
        } else if len(lv.hashCols) > 0 {
            var cs: []str = []
            for c in lv.hashCols { append(mut &cs, lv.t.cols[c].name) }
            how = "hash on (" + strings.join(&cs, ", ") + ") over " + pathText(lv)
        } else {
            how = "loop over " + pathText(lv)
        }
        append(mut &out, kind + name + ": " + how + tail)
    }
    return out
}

fn copyRow(r: &[]Val): []Val {
    var out: []Val = []
    for v in r { append(mut &out, v) }
    return out
}

fn oneTable(name: &str): []lexdb_sql.FromItem {
    return [lexdb_sql.FromItem{table: name, alias: lexdb_sql.baseName(name), join: lexdb_sql.J_FIRST, on: None, sub: -1, cols: [], work: -1, lateral: false}]
}

// ---- indexes: an entry per row, its key the indexed columns then the
// primary key, its value the primary key.

fn idxName(name: &str): str {
    var b = newStrBuf()
    b.addByte(1)                    // the catalog's index names: no table name starts with 1
    b.add(name)
    return b.toStr()
}

fn idxPrefix(ix: &Index, row: &[]Val): str {
    var b = newStrBuf()
    for c in ix.cols { encIdxPart(mut &b, &row[c]) }
    return b.toStr()
}

fn idxEntry(ix: &Index, row: &[]Val, pk: &str): str { return idxPrefix(ix, row) + pk }

fn hasNull(ix: &Index, row: &[]Val): bool {
    for c in ix.cols { if isNull(&row[c]) { return true } }
    return false
}

// A unique index may hold a value once, NULLs aside (they are all distinct).
// The scan reads the index's leaf, so a commit that adds the same value
// meanwhile fails one of the two with 40001.
fn checkUnique(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, ix: &Index, row: &[]Val,
               pk: &str): Result[Unit, DbErr] {
    if !ix.unique || hasNull(ix, row) { return Ok(Unit{}) }
    let pre = idxPrefix(ix, row)
    var clash = false
    try st.scan(txn, ix.tree, pre, succ(&pre), fn(en: &lexdb_store.Entry): bool {
        if en.val != pk {
            clash = true
            return false
        }
        return true
    })
    if !clash { return Ok(Unit{}) }
    var names: []str = []
    var vals: []str = []
    for c in ix.cols {
        append(mut &names, t.cols[c].name)
        append(mut &vals, text(&row[c]))
    }
    return Err(e("23505", "duplicate key value violates unique constraint \"" + lexdb_sql.baseName(&ix.name) + "\": Key (" +
                 strings.join(&names, ", ") + ")=(" + strings.join(&vals, ", ") + ") already exists."))
}

// Whether a row belongs in an index: always, or its predicate is true.
fn inIndex(t: &Table, ix: &Index, row: &[]Val): Result[bool, DbErr] {
    match ix.pred {
        Some(x) {
            let noAggs: []Val = []
            let noParams: []Val = []
            let noSubs: []SubRes = []
            let env = Env{cols: &t.cols, row: row, aggs: &noAggs, params: &noParams, subs: &noSubs, cur: &noAggs, seq: None}
            return Ok(truth(&(try eval(&x, &env))) == Some(true))
        }
        None { return Ok(true) }
    }
}

fn addIndexes(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, row: &[]Val, pk: &str): Result[Unit, DbErr] {
    for ix in t.indexes {
        if !(try inIndex(t, &ix, row)) { continue }
        try checkUnique(st, txn, t, &ix, row, pk)
        try txn.put(ix.tree, idxEntry(&ix, row, pk), pk)
    }
    return Ok(Unit{})
}

fn changeIndexes(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, old: &[]Val, oldPk: &str, row: &[]Val,
                 pk: &str): Result[Unit, DbErr] {
    for ix in t.indexes {
        let a = idxEntry(&ix, old, oldPk)
        let b = idxEntry(&ix, row, pk)
        let was = try inIndex(t, &ix, old)
        let now = try inIndex(t, &ix, row)
        if a == b && was == now { continue }
        if was { txn.del(ix.tree, a) }
        if now {
            try checkUnique(st, txn, t, &ix, row, pk)
            try txn.put(ix.tree, b, pk)
        }
    }
    return Ok(Unit{})
}

// ---- statements

fn createTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var key = s.table
    if lexdb_sql.isQual(&s.table) {
        let sn = lexdb_sql.schemaOf(&s.table)
        if !(try schemaExists(st, txn, &sn)) { return Err(e("3F000", "schema \"" + sn + "\" does not exist")) }
    } else {
        let sn = try createSchema(st, txn)
        if len(sn) == 0 { return Err(e("3F000", "no schema has been selected to create in")) }
        key = lexdb_sql.qual(&sn, &s.table)
    }
    let base = lexdb_sql.baseName(&key)
    let exists = try relExists(st, txn, &key)
    if exists {
        if s.ifFlag { return Ok(tagOnly("CREATE TABLE")) }
        return Err(e("42P07", "relation \"" + base + "\" already exists"))
    }
    try needCreate(st, txn, &key)
    if len(s.pk) == 0 {
        return Err(e("42P16", "lexdb: table \"" + base + "\" needs a PRIMARY KEY"))
    }
    var t = emptyTable(key)
    for c in s.cols {
        if colIndex(&t.cols, &c.name) >= 0 { return Err(e("42701", "column \"" + c.name + "\" specified more than once")) }
        var col = lexdb_sql.colDef(c.name, c.typ, c.notNull)
        col.identity = c.identity
        match c.def {
            Some(x) {
                let v = try defaultValue(&x, &col)
                col.def = Some(clone(&x))
            }
            None {}
        }
        append(mut &t.cols, col)
    }
    for p in s.pk {
        let i = colIndex(&t.cols, &p)
        if i < 0 { return Err(e("42703", "column \"" + p + "\" named in key does not exist")) }
        t.cols[i].notNull = true
        append(mut &t.pk, i)
    }
    if len(t.pk) > 1 {
        for a in 0..len(t.pk) {
            for b in a + 1..len(t.pk) {
                if t.pk[a] == t.pk[b] { return Err(e("42701", "column appears twice in primary key")) }
            }
        }
    }
    t.tree = st.createTree(txn)
    try makeColSeqs(st, txn, mut &t, -1, &s.idOpts)
    for c in t.cols { try defaultSeqs(st, txn, &c) }
    for c in s.cons { if c.kind != lexdb_sql.C_FOREIGN { try addConstraint(st, txn, mut &t, &c) } }
    for c in s.cons { if c.kind == lexdb_sql.C_FOREIGN { try addConstraint(st, txn, mut &t, &c) } }
    try txn.put(CATALOG, key, encTable(&t))
    try bumpCatalog(st, txn)
    // its owner, and its columns' sequences' (9.83)
    try ownNew(st, txn, &relObj(&key))
    match try st.get(txn, CATALOG, key) {
        Some(v) {
            let made = try decTable(key, &v)
            for c in made.cols { if len(c.seq) > 0 { try ownNew(st, txn, &relObj(&c.seq)) } }
        }
        None {}
    }
    return Ok(tagOnly("CREATE TABLE"))
}

fn dropTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    match try findTable(st, txn, &s.table) {
        Some(t) {
            if len(t.view) > 0 { return Err(e("42809", "\"" + lexdb_sql.shown(&s.table) + "\" is not a table (use DROP VIEW)")) }
            try needRelOwner(st, txn, &t.name, &"table")
            try dropDependentViews(st, txn, &t.name, s.cascade, &"table")
            var d = t
            try unlinkTable(st, txn, mut &d, s.cascade)
            try dropOwnedSeqs(st, txn, &d, &"")
            dropOne(txn, &d)
            try bumpCatalog(st, txn)
            return Ok(tagOnly("DROP TABLE"))
        }
        None {
            if s.ifFlag { return Ok(tagOnly("DROP TABLE")) }
            return Err(e("42P01", "table \"" + lexdb_sql.shown(&s.table) + "\" does not exist"))
        }
    }
}

// A table's trees and catalog rows, its indexes' too.
fn dropOne(txn: mut &lexdb_store.Txn, t: &Table) {
    dropAcl(txn, &relObj(&t.name))
    for ix in t.indexes {
        txn.dropTree(ix.tree)
        txn.del(CATALOG, idxName(&ix.name))
    }
    txn.dropTree(t.tree)
    txn.del(CATALOG, t.name)
}

// ---- column defaults (9.38)

// A default calling sequence functions: the sequences it names must be.
fn defaultSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, c: &lexdb_sql.ColDef): Result[Unit, DbErr] {
    match c.def {
        Some(x) {
            var ns: []str = []
            seqNamesOf(&x, mut &ns)
            for n in ns { let d = try needSeq(st, txn, &nameOfText(&n)) }
        }
        None {}
    }
    return Ok(Unit{})
}

// A DEFAULT checked for column c: no column and no aggregate in it; its
// value, of c's type. lexdb has no volatile function, so the value is the
// same whenever it is made: a bad default fails here, not at each INSERT.
fn defaultValue(x: &Expr, c: &lexdb_sql.ColDef): Result[Val, DbErr] {
    var ns: []str = []
    colNames(x, mut &ns)
    if len(ns) > 0 { return Err(e("0A000", "cannot use column reference in DEFAULT expression")) }
    if hasAgg(x) { return Err(e("42803", "aggregate functions are not allowed in DEFAULT expressions")) }
    if isVolatile(x) { return Ok(Val.Null) }        // nextval's: per row (defaultsOf)
    let none: []Val = []
    let noCols: []lexdb_sql.ColDef = []
    let noSubs: []SubRes = []
    let env = Env{cols: &noCols, row: &none, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: None}
    return coerce(try eval(x, &env), &c.typ)
}


// ---- ALTER TABLE (9.34)

// x with column from named to.
fn renameCol(x: &Expr, from: &str, to: &str): Expr {
    match x {
        Expr.Col(n) { return Expr.Col(if n == from { to } else { n }) }
        Expr.Unary(op, a) { return Expr.Unary(op, renameCol(&a, from, to)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, renameCol(&a, from, to), renameCol(&b, from, to)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(renameCol(&a, from, to), neg) }
        Expr.Call(f, args, star) {
            var xs: []Expr = []
            for a in args { append(mut &xs, renameCol(&a, from, to)) }
            return Expr.Call(f, xs, star)
        }
        Expr.Cast(a, ty) { return Expr.Cast(renameCol(&a, from, to), ty) }
        else { return clone(x) }
    }
}

// Whether the table has a row (col < 0), or a row whose column col is NULL.
fn anyRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, col: int): Result[bool, DbErr] {
    let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []}
    let sc = Scan{empty: false, point: false, lo: "", hi: "", whole: false}
    var need: []bool = []
    if col >= 0 {
        for i in 0..len(t.cols) { append(mut &need, i == col) }
    }
    var cur = newCursor()
    while !cur.done {
        var batch: [][]Val = []
        try fetch(st, txn, t, &path, &sc, &need, mut &cur, mut &batch)
        for r in batch {
            if col < 0 { return Ok(true) }
            match r[col] {
                Val.Null { return Ok(true) }
                else {}
            }
        }
    }
    return Ok(false)
}

// Drops column i: its place in the rows is kept and skipped, and its
// values go as rows are written again. The indexes on it, or whose
// predicate names it, are dropped (as PostgreSQL's are).
fn dropColumn(txn: mut &lexdb_store.Txn, t: mut &Table, i: int): Result[Unit, DbErr] {
    let name = t.cols[i].name
    for k in t.pk {
        if k == i { return Err(e("0A000", "lexdb: column \"" + name + "\" is in the primary key, which cannot be changed")) }
    }
    if len(t.slots) == 0 {
        for k in 0..len(t.cols) { append(mut &t.slots, k) }
        t.width = len(t.cols)
    }
    let gone = collections.removeAt(mut &t.cols, i)
    let place = collections.removeAt(mut &t.slots, i)
    for k in 0..len(t.pk) { if t.pk[k] > i { t.pk[k] -= 1 } }
    var old = replace(mut &t.indexes, [])
    var rev: []Index = []
    while len(old) > 0 {
        var ix = pop(mut &old)
        var uses = false
        for c in ix.cols { if c == i { uses = true } }
        match ix.pred {
            Some(x) {
                var ns: []str = []
                colNames(&x, mut &ns)
                for n in ns { if n == name { uses = true } }
            }
            None {}
        }
        if uses {
            txn.dropTree(ix.tree)
            txn.del(CATALOG, idxName(&ix.name))
        } else {
            for k in 0..len(ix.cols) { if ix.cols[k] > i { ix.cols[k] -= 1 } }
            append(mut &rev, ix)
        }
    }
    while len(rev) > 0 { append(mut &t.indexes, pop(mut &rev)) }
    // the checks naming it go too (as PostgreSQL's do)
    var k = 0
    while k < len(t.checks) {
        var ns: []str = []
        colNames(&t.checks[k].expr, mut &ns)
        var uses = false
        for n in ns { if n == name { uses = true } }
        if uses { let dropped = collections.removeAt(mut &t.checks, k) } else { k += 1 }
    }
    return Ok(Unit{})
}

// ---- moving between schemas, renaming indexes and schemas (9.37)

// Moves table t and its indexes to schema sc, their names kept: their
// catalog rows under the new keys, the index rows naming the table's.
fn moveTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, sc: &str): Result[Unit, DbErr] {
    txn.del(CATALOG, t.name)
    let old = t.name
    t.name = lexdb_sql.qual(sc, &lexdb_sql.baseName(&t.name))
    try moveAcl(st, txn, &relObj(&old), &relObj(&t.name))
    try relink(st, txn, t, &old)
    try ownerMoved(st, txn, t, &old, &"", &"", sc)
    for k in 0..len(t.indexes) {
        txn.del(CATALOG, idxName(&t.indexes[k].name))
        t.indexes[k].name = lexdb_sql.qual(sc, &lexdb_sql.baseName(&t.indexes[k].name))
    }
    for ix in t.indexes { try txn.put(CATALOG, idxName(&ix.name), t.name) }
    try txn.put(CATALOG, t.name, encTable(t))
    return Ok(Unit{})
}

// Whether a table or an index has catalog key k.
fn relExists(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[bool, DbErr] {
    return Ok((try st.get(txn, CATALOG, k)).isSome() || (try st.get(txn, CATALOG, idxName(k))).isSome() ||
              (try st.get(txn, CATALOG, seqRow(k))).isSome())
}

// ALTER TABLE ... SET SCHEMA: the table and its indexes, unless a name is
// taken there.
fn setSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, sc: &str): Result[Unit, DbErr] {
    if !(try schemaExists(st, txn, sc)) { return Err(e("3F000", "schema \"" + sc + "\" does not exist")) }
    if lexdb_sql.schemaOf(&t.name) == sc { return Ok(Unit{}) }
    var names = [lexdb_sql.baseName(&t.name)]
    for ix in t.indexes { append(mut &names, lexdb_sql.baseName(&ix.name)) }
    for n in names {
        if try relExists(st, txn, &lexdb_sql.qual(sc, &n)) {
            return Err(e("42P07", "relation \"" + n + "\" already exists in schema \"" + sc + "\""))
        }
    }
    return moveTable(st, txn, t, sc)
}

fn alterIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let ixKey = try catKey(st, txn, &s.index, true)
    let owner = try st.get(txn, CATALOG, idxName(&ixKey))
    if owner.isNone() {
        if s.ifFlag { return Ok(tagOnly("ALTER INDEX")) }
        return Err(e("42P01", "relation \"" + lexdb_sql.shown(&s.index) + "\" does not exist"))
    }
    var t = try needTable(st, txn, &owner.unwrap())
    try needRelOwner(st, txn, &t.name, &"index")
    let to = s.alters[0].name
    let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&ixKey), &to)
    if key == ixKey { return Ok(tagOnly("ALTER INDEX")) }
    if try relExists(st, txn, &key) { return Err(e("42P07", "relation \"" + to + "\" already exists")) }
    for k in 0..len(t.indexes) { if t.indexes[k].name == ixKey { t.indexes[k].name = key } }
    txn.del(CATALOG, idxName(&ixKey))
    try txn.put(CATALOG, idxName(&key), t.name)
    try txn.put(CATALOG, t.name, encTable(&t))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("ALTER INDEX"))
}

// ALTER SCHEMA ... RENAME TO: its tables and indexes move to the new name.
fn alterSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let to = s.alters[0].name
    if s.table == "public" { return Err(e("0A000", "lexdb: schema public cannot be renamed")) }
    if !(try schemaExists(st, txn, &s.table)) { return Err(e("3F000", "schema \"" + s.table + "\" does not exist")) }
    if try schemaExists(st, txn, &to) { return Err(e("42P06", "schema \"" + to + "\" already exists")) }
    if strings.startsWith(to, "pg_") { return Err(e("42939", "unacceptable schema name \"" + to + "\"")) }
    try needOwner(st, txn, &(try whoNow(st, txn)), &nspObj(&s.table), &"schema", &s.table)
    for v in try allViews(st, txn) {
        var touches = lexdb_sql.schemaOf(&v.name) == s.table
        for d in v.deps { if lexdb_sql.schemaOf(&d) == s.table { touches = true } }
        if touches {
            return Err(e("2BP01", "cannot rename schema " + s.table + " because view " + lexdb_sql.shown(&v.name) +
                         " is in it or reads from it (lexdb keeps a view's text)"))
        }
    }
    let from = lexdb_sql.qual(&s.table, &"")
    var keys: []str = []
    try st.scan(txn, CATALOG, from, from + "\xff", fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key)
        return true
    })
    for k in keys {
        match try byKeyOpt(st, txn, &k) {
            Some(t) {
                var m = t
                try moveTable(st, txn, mut &m, &to)
            }
            None {}
        }
    }
    for d in try allSeqs(st, txn, &s.table) {
        var m = seqCopy(&d)
        txn.del(CATALOG, seqRow(&m.key))
        let was = m.key
        m.key = lexdb_sql.qual(&to, &lexdb_sql.baseName(&m.key))
        try moveAcl(st, txn, &relObj(&was), &relObj(&m.key))
        try txn.put(CATALOG, seqRow(&m.key), encSeq(&m))
    }
    txn.del(CATALOG, schemaKey(&s.table))
    try txn.put(CATALOG, schemaKey(&to), "")
    try moveAcl(st, txn, &nspObj(&s.table), &nspObj(&to))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("ALTER SCHEMA"))
}

// ---- ALTER COLUMN TYPE (9.36)

// A column's new type: col its number, using its new value (None: the
// column's value converted).
type Retype = record { col: int; typ: lexdb_sql.TypeName; using: Option[Expr] }

fn intRank(oid: int): int {
    if oid == lexdb_sql.OID_INT2 { return 1 }
    if oid == lexdb_sql.OID_INT4 { return 2 }
    return 3
}

// Whether a column of type a may become b with no USING: PostgreSQL's
// assignment casts among lexdb's types.
fn autoCast(a: &lexdb_sql.TypeName, b: &lexdb_sql.TypeName): bool {
    if a.kind == b.kind && (a.kind != lexdb_sql.K_ARRAY || a.oid == b.oid) { return true }
    if b.kind == lexdb_sql.K_TEXT { return true }
    return (a.kind == lexdb_sql.K_INT && b.kind == lexdb_sql.K_NUM) || (a.kind == lexdb_sql.K_NUM && b.kind == lexdb_sql.K_INT)
}

// Whether every value of type a is one of type b as it is stored: then
// the rows need not change.
fn widens(a: &lexdb_sql.TypeName, b: &lexdb_sql.TypeName): bool {
    if a.kind != b.kind { return false }
    if a.kind == lexdb_sql.K_INT { return intRank(b.oid) >= intRank(a.oid) }
    if a.kind == lexdb_sql.K_BOOL { return true }
    if a.kind == lexdb_sql.K_TEXT { return b.len == 0 || (a.len > 0 && b.len >= a.len) }
    if a.kind == lexdb_sql.K_NUM { return b.prec == 0 || (a.prec > 0 && b.scale == a.scale && b.prec >= a.prec) }
    return a.oid == b.oid
}

// Rewrites table t with its columns' new types, as PostgreSQL does: each
// row, its new values converted to the column's type, goes to a new tree,
// and the indexes on a column changed (on any, when one is in the key) are
// made again; the old trees are dropped. All in the transaction, the rows
// held in memory as an UPDATE's are (max_statement_mem).
fn retype(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, changes: &[]Retype, lim: Limits): Result[Unit, DbErr] {
    let sqe = seqEnv(st, txn)
    // the rows, read as the table stands (the statement's other actions done)
    try txn.put(CATALOG, t.name, encTable(t))
    var sc = newScope(&[], &[])
    let noWhere: Option[Expr] = None
    let noParams: []Val = []
    let noSubs: []lexdb_sql.Stmt = []
    var q = try buildQuery(st, txn, &oneTable(&t.name), &noWhere, &noParams, &noSubs, mut &sc)
    var xs: []Expr = []
    for ch in changes {
        let x = match ch.using {
            Some(u) { clone(&u) }
            None { Expr.Col(t.cols[ch.col].name) }
        }
        if hasAgg(&x) { return Err(e("42803", "cannot use aggregate function in transform expression")) }
        append(mut &xs, try resolve(&x, &q.cols, len(q.cols), mut &sc))
    }
    endScope(mut &sc, mut &q)
    var found: [][]Val = []
    var rs = newRun(&q)
    rs.limit(&lim)
    let m = try prepare(st, txn, &q, &noParams, mut &rs)
    let room = rs.room()
    let max = rs.maxHeld
    var held = 0
    try runQuery(st, txn, &q, &m, &noParams, fn(r: &[]Val): Result[bool, DbErr] {
        held += 2 * rowBytes(r)             // the row found, and its new one
        if room >= 0 && held > room { return Err(memErr(max)) }
        append(mut &found, copyRow(r))
        return Ok(true)
    }, mut &rs)

    var changed: []bool = array(len(t.cols), false)
    var keyChanged = false
    // every row written below has every place
    for k in 0..len(t.cols) { t.cols[k].missing = Val.Null }
    for ch in changes {
        t.cols[ch.col].typ = ch.typ
        changed[ch.col] = true
        for k in t.pk { if k == ch.col { keyChanged = true } }
    }
    // the rows below are in the new types' layout
    syncLayouts(t)
    let old = t.tree
    t.tree = st.createTree(txn)
    txn.dropTree(old)
    var rows: [][]Val = []
    var keys: []str = []
    let noAggs: []Val = []
    for f in found {
        let env = Env{cols: &q.cols, row: &f, aggs: &noAggs, params: &noParams, subs: &m.subs, cur: &noAggs, seq: sqe}
        var row = copyRow(&f)
        for k in 0..len(changes) {
            row[changes[k].col] = try coerce(try evalX(st, txn, &q, &xs[k], &env, mut &rs), &changes[k].typ)
        }
        try checkRow(t, &row)
        try checkChecks(t, &row)
        let key = keyOf(t, &row)
        if (try st.get(txn, t.tree, key)).isSome() { return Err(dupKey(t, &row)) }
        let enc = encRowOf(t, &row)
        try txn.putRow(t.tree, key, enc, rowHead(&enc))
        append(mut &rows, row)
        append(mut &keys, key)
    }

    // the indexes whose entries change
    var redo: []int = []
    for k in 0..len(t.indexes) {
        var uses = keyChanged
        for c in t.indexes[k].cols { if changed[c] { uses = true } }
        match t.indexes[k].pred {
            Some(x) {
                var ns: []str = []
                colNames(&x, mut &ns)
                for n in ns {
                    let c = colIndex(&t.cols, &n)
                    if c >= 0 && changed[c] { uses = true }
                }
            }
            None {}
        }
        if uses {
            txn.dropTree(t.indexes[k].tree)
            t.indexes[k].tree = st.createTree(txn)
            append(mut &redo, k)
        }
    }
    for k in redo {
        let ix = &t.indexes[k]
        for r in 0..len(rows) {
            if !(try inIndex(t, ix, &rows[r])) { continue }
            match checkUnique(st, txn, t, ix, &rows[r], &keys[r]) {
                Ok(_) {}
                Err(x) {
                    if x.state != "23505" { return Err(x) }
                    return Err(e("23505", "could not create unique index \"" + lexdb_sql.baseName(&ix.name) + "\": a value is duplicated"))
                }
            }
            try txn.put(ix.tree, idxEntry(ix, &rows[r], &keys[r]), keys[r])
        }
    }
    return Ok(Unit{})
}

// ALTER TABLE: its actions in order, on the table's catalog row. None
// rewrites a row: a row written before a column was added has fewer
// values, read as NULL (decRowNeed); a dropped column's place is skipped
// (Table.slots).
fn alterTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, lim: Limits): Result[Res, DbErr] {
    let found = try findTable(st, txn, &s.table)
    if found.isNone() {
        if s.ifFlag { return Ok(tagOnly("ALTER TABLE")) }
        return Err(e("42P01", "relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist"))
    }
    match found {
        Some(ft) {
            if len(ft.view) > 0 { return Err(e("42809", "\"" + lexdb_sql.shown(&s.table) + "\" is a view (use ALTER VIEW)")) }
            try needRelOwner(st, txn, &ft.name, &"table")
            // a view keeps its query's text: names it reads may not change under it
            for a in s.alters {
                if a.kind == lexdb_sql.A_RENAME || a.kind == lexdb_sql.A_RENAME_COL || a.kind == lexdb_sql.A_DROP_COL ||
                   a.kind == lexdb_sql.A_TYPE || a.kind == lexdb_sql.A_SET_SCHEMA {
                    let deps = try dependentViews(st, txn, &ft.name)
                    if len(deps) > 0 {
                        return Err(e("2BP01", "cannot alter table " + lexdb_sql.shown(&ft.name) + " because view " +
                                     lexdb_sql.shown(&deps[0]) + " depends on it (lexdb keeps a view's text: drop the view, then make it again)"))
                    }
                }
            }
        }
        None {}
    }
    var t = found.unwrap()
    // TYPE actions are done together, after the others, by the names then
    var types: []int = []
    for j in 0..len(s.alters) {
        let a = &s.alters[j]
        let rel = lexdb_sql.baseName(&t.name)
        if a.kind == lexdb_sql.A_TYPE {
            append(mut &types, j)
        } else if a.kind == lexdb_sql.A_ADD_CON {
            try addConstraint(st, txn, mut &t, &a.cons[0])
        } else if a.kind == lexdb_sql.A_DROP_CON {
            if !(try dropConstraint(st, txn, mut &t, &a.name, a.cascade)) {
                if a.name == rel + "_pkey" { return Err(e("0A000", "lexdb: a table's primary key cannot be changed")) }
                if !a.ifFlag {
                    return Err(e("42704", "constraint \"" + a.name + "\" of relation \"" + rel + "\" does not exist"))
                }
            }
        } else if a.kind == lexdb_sql.A_SET_SCHEMA {
            try setSchema(st, txn, mut &t, &a.name)
        } else if a.kind == lexdb_sql.A_ADD {
            if colIndex(&t.cols, &a.col.name) >= 0 {
                if a.ifFlag { continue }
                return Err(e("42701", "column \"" + a.col.name + "\" of relation \"" + rel + "\" already exists"))
            }
            // the rows there read the default as it is now (no row is written)
            var col = lexdb_sql.colDef(a.col.name, a.col.typ, a.col.notNull)
            col.identity = a.col.identity
            var perRow = a.col.identity != lexdb_sql.ID_NONE
            match a.col.def {
                Some(x) {
                    col.missing = try defaultValue(&x, &col)
                    col.def = Some(clone(&x))
                    if isVolatile(&x) { perRow = true }
                }
                None {}
            }
            try defaultSeqs(st, txn, &col)
            if perRow && try anyRow(st, txn, &t, -1) {
                return Err(e("0A000", "lexdb: a column whose default is a sequence's cannot be added to a table with rows"))
            }
            let full = a.col.notNull && isNull(&col.missing) && try anyRow(st, txn, &t, -1)
            if full {
                return Err(e("23502", "column \"" + a.col.name + "\" of relation \"" + rel + "\" contains null values"))
            }
            append(mut &t.cols, col)
            if len(t.slots) > 0 {
                append(mut &t.slots, t.width)
                t.width += 1
            }
            try makeColSeqs(st, txn, mut &t, len(t.cols) - 1, &s.idOpts)
        } else if a.kind == lexdb_sql.A_DROP_COL {
            let i = colIndex(&t.cols, &a.name)
            if i < 0 {
                if a.ifFlag { continue }
                return Err(e("42703", "column \"" + a.name + "\" of relation \"" + rel + "\" does not exist"))
            }
            try fkDropColumn(st, txn, mut &t, &a.name, a.cascade)
            try dropOwnedSeqs(st, txn, &t, &a.name)
            try dropColumn(txn, mut &t, i)
        } else if a.kind == lexdb_sql.A_RENAME {
            let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &a.name)
            if key == t.name { continue }
            if try relExists(st, txn, &key) {
                return Err(e("42P07", "relation \"" + a.name + "\" already exists"))
            }
            txn.del(CATALOG, t.name)
            let old = t.name
            t.name = key
            try moveAcl(st, txn, &relObj(&old), &relObj(&key))
            try relink(st, txn, mut &t, &old)
            try ownerMoved(st, txn, mut &t, &old, &"", &"", &"")
            for ix in t.indexes { try txn.put(CATALOG, idxName(&ix.name), key) }
        } else {
            let i = colIndex(&t.cols, &a.name)
            if i < 0 { return Err(e("42703", "column \"" + a.name + "\" does not exist")) }
            if a.kind == lexdb_sql.A_RENAME_COL {
                if a.to == a.name { continue }
                if colIndex(&t.cols, &a.to) >= 0 {
                    return Err(e("42701", "column \"" + a.to + "\" of relation \"" + rel + "\" already exists"))
                }
                t.cols[i].name = a.to
                // a filtered index's predicate names its columns
                for k in 0..len(t.indexes) {
                    var renamed: Option[Expr] = None
                    match t.indexes[k].pred {
                        Some(x) { renamed = Some(renameCol(&x, &a.name, &a.to)) }
                        None {}
                    }
                    if renamed.isSome() { t.indexes[k].pred = renamed }
                }
                for k in 0..len(t.checks) { t.checks[k].expr = renameCol(&t.checks[k].expr, &a.name, &a.to) }
                try renameFkCol(st, txn, mut &t, &a.name, &a.to)
                let tn = t.name
                try ownerMoved(st, txn, mut &t, &tn, &a.name, &a.to, &"")
            } else if a.kind == lexdb_sql.A_SET_NOT_NULL {
                let nulls = !t.cols[i].notNull && try anyRow(st, txn, &t, i)
                if nulls {
                    return Err(e("23502", "column \"" + a.name + "\" of relation \"" + rel + "\" contains null values"))
                }
                t.cols[i].notNull = true
            } else if a.kind == lexdb_sql.A_SET_DEFAULT {
                // for rows inserted from now on; those there keep their values
                if t.cols[i].identity == lexdb_sql.ID_ALWAYS || t.cols[i].identity == lexdb_sql.ID_BY_DEFAULT {
                    return Err(e("42601", "column \"" + a.name + "\" of relation \"" + rel + "\" is an identity column"))
                }
                match a.col.def {
                    Some(x) {
                        let v = try defaultValue(&x, &t.cols[i])
                        t.cols[i].def = Some(clone(&x))
                        try defaultSeqs(st, txn, &t.cols[i])
                    }
                    None {}
                }
                // a serial column's default is replaced (its sequence stays, owned by it)
                t.cols[i].seq = ""
                t.cols[i].identity = lexdb_sql.ID_NONE
            } else if a.kind == lexdb_sql.A_DROP_DEFAULT {
                if t.cols[i].identity == lexdb_sql.ID_ALWAYS || t.cols[i].identity == lexdb_sql.ID_BY_DEFAULT {
                    return Err(e("42601", "column \"" + a.name + "\" of relation \"" + rel + "\" is an identity column"))
                }
                t.cols[i].def = None
                t.cols[i].seq = ""
                t.cols[i].identity = lexdb_sql.ID_NONE
            } else if a.kind == lexdb_sql.A_DROP_NOT_NULL {
                for k in t.pk {
                    if k == i { return Err(e("42P16", "column \"" + a.name + "\" is in a primary key")) }
                }
                t.cols[i].notNull = false
            }
        }
    }
    var changes: []Retype = []
    var rewrite = false
    for j in types {
        let a = &s.alters[j]
        let i = colIndex(&t.cols, &a.name)
        if i < 0 { return Err(e("42703", "column \"" + a.name + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist")) }
        for ch in changes {
            if ch.col == i { return Err(e("42601", "multiple changes of the type of column \"" + a.name + "\"")) }
        }
        if len(t.cols[i].seq) > 0 && a.col.typ.kind != lexdb_sql.K_INT {
            return Err(e("0A000", "lexdb: column \"" + a.name + "\" takes its default from a sequence, so its type stays an integer"))
        }
        if try fkUses(st, txn, &t, &a.name) {
            return Err(e("0A000", "lexdb: column \"" + a.name + "\" is in a foreign key, so its type cannot be changed (drop the constraint first)"))
        }
        if a.using.isNone() && !autoCast(&t.cols[i].typ, &a.col.typ) {
            return Err(e("42804", "column \"" + a.name + "\" cannot be cast automatically to type " + lexdb_sql.typeText(&a.col.typ) +
                         " (USING " + a.name + "::" + lexdb_sql.typeText(&a.col.typ) + " would)"))
        }
        if a.using.isSome() || !widens(&t.cols[i].typ, &a.col.typ) { rewrite = true }
        let u = match a.using { Some(x) { Some(clone(&x)) } None { None } }
        append(mut &changes, Retype{col: i, typ: a.col.typ, using: u})
    }
    if rewrite { try retype(st, txn, mut &t, &changes, lim) }
    else { for ch in changes { t.cols[ch.col].typ = ch.typ } }
    // a default must be one of the new type
    for ch in changes {
        match t.cols[ch.col].def {
            Some(x) { let v = try defaultValue(&x, &t.cols[ch.col]) }
            None {}
        }
    }
    try txn.put(CATALOG, t.name, encTable(&t))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("ALTER TABLE"))
}

fn createSchemaStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if try schemaExists(st, txn, &s.table) {
        if s.ifFlag { return Ok(tagOnly("CREATE SCHEMA")) }
        return Err(e("42P06", "schema \"" + s.table + "\" already exists"))
    }
    if strings.startsWith(s.table, "pg_") { return Err(e("42939", "unacceptable schema name \"" + s.table + "\"")) }
    // a superuser's (PostgreSQL: the database's CREATE, its owner's); owned by AUTHORIZATION's role, or its maker
    let w = try whoNow(st, txn)
    if !w.super { return Err(e("42501", "permission denied for database lexdb")) }
    var owner = currentRole(st, txn.sess)
    if len(s.names) > 0 {
        owner = roleName(st, txn, &s.names[0])
        if !(try roleExists(st, txn, &owner)) { return Err(e("42704", "role \"" + owner + "\" does not exist")) }
    }
    try txn.put(CATALOG, schemaKey(&s.table), "")
    try writeAcl(txn, &nspObj(&s.table), &Acl{owner: owner, grants: [], set: false})
    try bumpCatalog(st, txn)
    return Ok(tagOnly("CREATE SCHEMA"))
}

// DROP SCHEMA: refused while it holds a table, unless CASCADE, which drops
// them.
fn dropSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if s.table == "public" { return Err(e("0A000", "lexdb: schema public cannot be dropped")) }
    if !(try schemaExists(st, txn, &s.table)) {
        if s.ifFlag { return Ok(tagOnly("DROP SCHEMA")) }
        return Err(e("3F000", "schema \"" + s.table + "\" does not exist"))
    }
    try needOwner(st, txn, &(try whoNow(st, txn)), &nspObj(&s.table), &"schema", &s.table)
    let from = lexdb_sql.qual(&s.table, &"")
    var keys: []str = []
    try st.scan(txn, CATALOG, from, from + "\xff", fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key)
        return true
    })
    let seqs = try allSeqs(st, txn, &s.table)
    if (len(keys) > 0 || len(seqs) > 0) && !s.cascade {
        return Err(e("2BP01", "cannot drop schema " + s.table + " because other objects depend on it"))
    }
    for k in keys {
        match try byKeyOpt(st, txn, &k) {
            Some(t) {
                if len(t.view) > 0 {
                    try dropDependentViews(st, txn, &t.name, true, &"view")
                    txn.del(CATALOG, t.name)
                    dropAcl(txn, &relObj(&t.name))
                } else {
                    var d = t
                    try dropDependentViews(st, txn, &d.name, true, &"table")
                    try unlinkTable(st, txn, mut &d, true)
                    dropOne(txn, &d)
                }
            }
            None {}
        }
    }
    for d in try allSeqs(st, txn, &s.table) { try dropSeqRows(st, txn, &d) }
    txn.del(CATALOG, schemaKey(&s.table))
    dropAcl(txn, &nspObj(&s.table))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("DROP SCHEMA"))
}

// CREATE [UNIQUE] INDEX: a tree of its own, filled from the table's rows in
// the same transaction.
fn createIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var t = try needTable(st, txn, &s.table)
    try needRelOwner(st, txn, &t.name, &"table")
    let ixKey = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &s.index)     // in its table's schema
    let exists = try relExists(st, txn, &ixKey)
    if exists {
        if s.ifFlag { return Ok(tagOnly("CREATE INDEX")) }
        return Err(e("42P07", "relation \"" + s.index + "\" already exists"))
    }
    var cols: []int = []
    for n in s.names {
        let i = colIndex(&t.cols, &n)
        if i < 0 { return Err(e("42703", "column \"" + n + "\" does not exist")) }
        append(mut &cols, i)
    }
    var pred: Option[Expr] = None
    match s.where {
        Some(w) {
            // A filtered index: its predicate uses the table's columns, and no
            // parameters or aggregates.
            var ns: []str = []
            colNames(&w, mut &ns)
            for n in ns {
                if colIndex(&t.cols, &n) < 0 { return Err(e("42703", "column \"" + n + "\" does not exist")) }
            }
            if hasAgg(&w) { return Err(e("42803", "aggregate functions are not allowed in index predicates")) }
            if len(s.subs) > 0 { return Err(e("0A000", "cannot use subquery in index predicate")) }
            if s.params > 0 { return Err(e("42P02", "there is no parameter $1")) }
            pred = Some(clone(&w))
        }
        None {}
    }
    let ix = Index{name: ixKey, tree: st.createTree(txn), cols: cols, unique: s.unique, pred: pred, con: false}
    try addIndex(st, txn, mut &t, ix)
    try txn.put(CATALOG, t.name, encTable(&t))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("CREATE INDEX"))
}

// Fills index ix from table t's rows (a unique one checked) and adds it to
// t, its catalog row naming t (t's own row is the caller's to write).
fn addIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, ix: Index): Result[Unit, DbErr] {
    let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []}
    let sc = Scan{empty: false, point: false, lo: "", hi: "", whole: false}
    var cur = newCursor()
    while !cur.done {
        var batch: [][]Val = []
        let all: []bool = []
        try fetch(st, txn, t, &path, &sc, &all, mut &cur, mut &batch)
        for r in batch {
            if !(try inIndex(t, &ix, &r)) { continue }
            let pk = keyOf(t, &r)
            match checkUnique(st, txn, t, &ix, &r, &pk) {
                Ok(_) {}
                Err(x) {
                    if x.state != "23505" { return Err(x) }
                    return Err(e("23505", "could not create unique index \"" + lexdb_sql.baseName(&ix.name) + "\": a value is duplicated"))
                }
            }
            try txn.put(ix.tree, idxEntry(&ix, &r, &pk), pk)
        }
    }
    try txn.put(CATALOG, idxName(&ix.name), t.name)
    append(mut &t.indexes, ix)
    return Ok(Unit{})
}

// ---- UNIQUE constraints (9.39): a unique index the constraint owns, of
// the same name.

// A name PostgreSQL's way: table, columns and a suffix joined by "_", cut
// to 63 bytes, a number added while the name is taken in the schema.
// A CHECK's name need only be free among the table's constraints (rel
// false): it is not a relation.
fn makeName(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, cols: &[]str, suffix: &str, rel: bool): Result[str, DbErr] {
    var parts = [lexdb_sql.baseName(&t.name)]
    for c in cols { append(mut &parts, c) }
    var base = strings.join(&parts, "_")
    if len(base) + 1 + len(suffix) > 63 { base = base[0..63 - 1 - len(suffix)] }
    let sc = lexdb_sql.schemaOf(&t.name)
    var n = 0
    while true {
        let name = base + "_" + suffix + (if n == 0 { "" } else { n.toStr() })
        let taken = rel && try relExists(st, txn, &lexdb_sql.qual(&sc, &name))
        if !taken && !hasConName(t, &name) { return Ok(name) }
        n += 1
    }
    return Ok("")
}

fn hasConName(t: &Table, name: &str): bool {
    for ix in t.indexes { if ix.con && lexdb_sql.baseName(&ix.name) == name { return true } }
    for c in t.checks { if c.name == name { return true } }
    for f in t.fks { if f.name == name { return true } }
    return false
}

// Adds constraint c to table t (its rows checked against it).
fn addConstraint(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, c: &lexdb_sql.Constraint): Result[Unit, DbErr] {
    if c.kind == lexdb_sql.C_CHECK { return addCheck(st, txn, t, c) }
    if c.kind == lexdb_sql.C_FOREIGN { return addForeign(st, txn, t, c) }
    var cols: []int = []
    for n in c.cols {
        let i = colIndex(&t.cols, &n)
        if i < 0 { return Err(e("42703", "column \"" + n + "\" named in key does not exist")) }
        for k in cols { if k == i { return Err(e("42701", "column \"" + n + "\" appears twice in unique constraint")) } }
        append(mut &cols, i)
    }
    var name = c.name
    if len(name) == 0 { name = try makeName(st, txn, t, &c.cols, &"key", true) }
    let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &name)
    if hasConName(t, &name) { return Err(e("42710", "constraint \"" + name + "\" for relation \"" + lexdb_sql.baseName(&t.name) + "\" already exists")) }
    if try relExists(st, txn, &key) { return Err(e("42P07", "relation \"" + name + "\" already exists")) }
    let ix = Index{name: key, tree: st.createTree(txn), cols: cols, unique: true, pred: None, con: true}
    return addIndex(st, txn, t, ix)
}

// ---- CHECK constraints (9.40)

// Adds a CHECK to table t, the rows there checked. Its columns must be
// t's; no aggregate (a subquery or parameter the parser refused).
fn addCheck(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, c: &lexdb_sql.Constraint): Result[Unit, DbErr] {
    let x = match c.expr {
        Some(v) { clone(&v) }
        None { Expr.Lit(Val.Bool(true)) }
    }
    var ns: []str = []
    colNames(&x, mut &ns)
    var refs: []str = []
    for n in ns {
        if colIndex(&t.cols, &n) < 0 { return Err(e("42703", "column \"" + n + "\" does not exist")) }
        var seen = false
        for r in refs { if r == n { seen = true } }
        if !seen { append(mut &refs, n) }
    }
    if hasAgg(&x) { return Err(e("42803", "aggregate functions are not allowed in check constraints")) }
    var name = c.name
    if len(name) == 0 {
        // a column's is named for it, a table's for its one column, or none
        let none: []str = []
        let named = if len(c.cols) > 0 { &c.cols } else if len(refs) == 1 { &refs } else { &none }
        name = try makeName(st, txn, t, named, &"check", false)
    }
    if hasConName(t, &name) { return Err(e("42710", "constraint \"" + name + "\" for relation \"" + lexdb_sql.baseName(&t.name) + "\" already exists")) }
    let ck = Check{name: name, expr: x}
    // Not a boolean: tried on a row of zeros ('' and false), as there is
    // no type of an expression without a row (an error then is let be:
    // a division by the zero).
    var zeros: []Val = []
    for col in t.cols {
        let k = col.typ.kind
        append(mut &zeros, if k == lexdb_sql.K_INT { Val.Int(0) } else if k == lexdb_sql.K_BOOL { Val.Bool(false) }
                           else if k == lexdb_sql.K_NUM { Val.Num(Decimal.zero()) } else if k == lexdb_sql.K_ARRAY { Val.Text("{}") } else { Val.Text("") })
    }
    match passes(t, &ck, &zeros) {
        Ok(_) {}
        Err(bad) { if bad.state == "42804" { return Err(bad) } }
    }
    // the rows there
    let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []}
    let sc = Scan{empty: false, point: false, lo: "", hi: "", whole: false}
    var cur = newCursor()
    while !cur.done {
        var batch: [][]Val = []
        let all: []bool = []
        try fetch(st, txn, t, &path, &sc, &all, mut &cur, mut &batch)
        for r in batch {
            if !(try passes(t, &ck, &r)) {
                return Err(e("23514", "check constraint \"" + name + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" is violated by some row"))
            }
        }
    }
    append(mut &t.checks, ck)
    return Ok(Unit{})
}

// Whether row passes check c: true or NULL (as SQL's CHECK has it).
fn passes(t: &Table, c: &Check, row: &[]Val): Result[bool, DbErr] {
    let noAggs: []Val = []
    let noParams: []Val = []
    let noSubs: []SubRes = []
    let env = Env{cols: &t.cols, row: row, aggs: &noAggs, params: &noParams, subs: &noSubs, cur: &noAggs, seq: None}
    let v = try eval(&c.expr, &env)
    match v {
        Val.Null { return Ok(true) }
        Val.Bool(b) { return Ok(b) }
        else { return Err(e("42804", "argument of CHECK must be type boolean")) }
    }
}

// A row to be written, against table t's checks.
fn checkChecks(t: &Table, row: &[]Val): Result[Unit, DbErr] {
    for c in t.checks {
        if !(try passes(t, &c, row)) {
            return Err(e("23514", "new row for relation \"" + lexdb_sql.baseName(&t.name) + "\" violates check constraint \"" + c.name + "\""))
        }
    }
    return Ok(Unit{})
}

// Drops table t's constraint named name: false when it has none. A unique
// constraint a foreign key needs is refused, or with cascade the foreign
// key dropped too.
fn dropConstraint(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, name: &str, cascade: bool): Result[bool, DbErr] {
    for k in 0..len(t.checks) {
        if t.checks[k].name == name {
            let gone = collections.removeAt(mut &t.checks, k)
            return Ok(true)
        }
    }
    for k in 0..len(t.fks) {
        if t.fks[k].name == name {
            try dropOwnFk(st, txn, t, k)
            return Ok(true)
        }
    }
    for k in 0..len(t.indexes) {
        if t.indexes[k].con && lexdb_sql.baseName(&t.indexes[k].name) == name {
            try dropNeeded(st, txn, t, k, cascade, &("constraint " + name + " on table " + lexdb_sql.baseName(&t.name)))
            let ix = collections.removeAt(mut &t.indexes, k)
            txn.dropTree(ix.tree)
            txn.del(CATALOG, idxName(&ix.name))
            return Ok(true)
        }
    }
    return Ok(false)
}

fn dropIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let ixKey = try catKey(st, txn, &s.index, true)
    match try st.get(txn, CATALOG, idxName(&ixKey)) {
        Some(tn) {
            var t = try needTable(st, txn, &tn)
            try needRelOwner(st, txn, &t.name, &"index")
            for k in 0..len(t.indexes) {
                if t.indexes[k].name == ixKey && t.indexes[k].con {
                    let n = lexdb_sql.baseName(&ixKey)
                    return Err(e("2BP01", "cannot drop index " + n + " because constraint " + n + " on table " + lexdb_sql.baseName(&t.name) +
                                 " requires it (drop the constraint instead)"))
                }
                if t.indexes[k].name == ixKey {
                    try dropNeeded(st, txn, mut &t, k, false, &("index " + lexdb_sql.baseName(&ixKey)))
                }
            }
            var old = replace(mut &t.indexes, [])
            var rev: []Index = []
            while len(old) > 0 {
                let ix = pop(mut &old)
                if ix.name == ixKey { txn.dropTree(ix.tree) } else { append(mut &rev, ix) }
            }
            while len(rev) > 0 { append(mut &t.indexes, pop(mut &rev)) }
            txn.del(CATALOG, idxName(&ixKey))
            try txn.put(CATALOG, t.name, encTable(&t))
            try bumpCatalog(st, txn)
            return Ok(tagOnly("DROP INDEX"))
        }
        None {
            if s.ifFlag { return Ok(tagOnly("DROP INDEX")) }
            return Err(e("42704", "index \"" + lexdb_sql.shown(&s.index) + "\" does not exist"))
        }
    }
}

fn checkRow(t: &Table, row: &[]Val): Result[Unit, DbErr] {
    for i in 0..len(t.cols) {
        if t.cols[i].notNull && isNull(&row[i]) {
            return Err(e("23502", "null value in column \"" + t.cols[i].name + "\" of relation \"" + lexdb_sql.baseName(&t.name) +
                         "\" violates not-null constraint"))
        }
    }
    return Ok(Unit{})
}

fn dupKey(t: &Table, row: &[]Val): DbErr {
    var names: []str = []
    var vals: []str = []
    for i in t.pk {
        append(mut &names, t.cols[i].name)
        append(mut &vals, text(&row[i]))
    }
    return e("23505", "duplicate key value violates unique constraint \"" + lexdb_sql.baseName(&t.name) + "_pkey\": Key (" +
             strings.join(&names, ", ") + ")=(" + strings.join(&vals, ", ") + ") already exists.")
}

fn insert(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    try notView(st, txn, &s.table, &"insert into")
    try dmlCheck(st, txn, s, &"a")
    let sqe = seqEnv(st, txn)
    let t = try needTable(st, txn, &s.table)
    var targets: []int = []
    if len(s.names) == 0 {
        for i in 0..len(t.cols) { append(mut &targets, i) }
    } else {
        for n in s.names {
            let i = colIndex(&t.cols, &n)
            if i < 0 { return Err(e("42703", "column \"" + n + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist")) }
            append(mut &targets, i)
        }
    }
    // its subqueries are run first; with RETURNING, over the table's columns
    var sc = newScope(params, &[])
    let noFrom: []lexdb_sql.FromItem = []
    let noWhere: Option[Expr] = None
    let from = if len(s.items) > 0 { oneTable(&s.table) } else { noFrom }
    var q = try buildQuery(st, txn, &from, &noWhere, params, &s.subs, mut &sc)
    var rows: [][]Expr = []
    let resolved = len(s.subs) > 0 || len(s.items) > 0
    if resolved && len(s.inner) == 0 {
        for r in s.rows {
            var rr: []Expr = []
            for x in r { append(mut &rr, try resolve(&x, &q.cols, 0, mut &sc)) }
            append(mut &rows, rr)
        }
    }
    var ret = try retOf(s, &q, mut &sc)
    var up = try upsertOf(s, &t, mut &sc)
    endScope(mut &sc, mut &q)
    var rs = newRun(&q)
    rs.limit(&lim)
    let m = try prepare(st, txn, &q, params, mut &rs)
    var kept: [][]Val = []
    var count = 0
    let parents = up.mode == lexdb_sql.CONFLICT_UPDATE        // an update may change a key other rows refer to
    if len(s.inner) > 0 {
        // INSERT ... SELECT: the query runs to its end first, so it never
        // reads the rows it inserts
        let noTypes: []int = []
        var pc = oneShot()
        let res = try select(st, txn, &s.inner[0], params, &noTypes, lim, mut &pc)
        let defs = try defaultsOf(st, txn, &t)
        let fw = try fkTables(st, txn, &t, true, parents)
        var later: []FkLater = []
        let noAggs: []Val = []
        let env = Env{cols: &q.cols, row: &noAggs, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
        for r in res.rows {
            var vs: []Val = []
            for k in 0..len(r) {
                if k < len(targets) && try idDefault(&t, targets[k], false, s.overriding) {
                    append(mut &vs, try defAt(st, txn, &defs, &t, targets[k]))
                } else {
                    append(mut &vs, r[k])
                }
            }
            match try insertOne(st, txn, &t, &targets, &vs, &defs, &fw, mut &later, mut &up, &env) {
                Some(row) {
                    if ret.on { append(mut &kept, row) }
                    count += 1
                }
                None {}
            }
        }
        try fkFinish(st, txn, &fw, mut &later)
    } else {
        let noAggs: []Val = []
        let env = Env{cols: &q.cols, row: &noAggs, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
        count = if resolved { try insertRows(st, txn, &t, &targets, &rows, &env, s.overriding, ret.on, mut &kept, mut &up) }
                else { try insertRows(st, txn, &t, &targets, &s.rows, &env, s.overriding, ret.on, mut &kept, mut &up) }
    }
    for row in kept { try retAdd(st, txn, &q, &m, params, mut &ret, &row, mut &rs) }
    return Ok(retRes(ret, "INSERT 0 " + count.toStr()))
}

// ---- RETURNING (9.44): rows of values per row written, over the table's
// columns (an INSERT's or UPDATE's new row, a DELETE's old one)

type Ret = record {
    on: bool                    // the statement has RETURNING
    outs: []OutCol
    exprs: []Expr
    rows: [][]Val
}

// Its items resolved over q's columns (q: the statement's table alone).
fn retOf(s: &lexdb_sql.Stmt, q: &Query, sc: mut &Scope): Result[Ret, DbErr] {
    var r = Ret{on: len(s.items) > 0, outs: [], exprs: [], rows: []}
    if !r.on { return Ok(r) }
    r.outs = try itemCols(&s.items, true, &q.cols, sc, mut &r.exprs)
    for x in r.exprs {
        if hasAgg(&x) { return Err(e("42803", "aggregate functions are not allowed in RETURNING")) }
    }
    return Ok(r)
}

fn retAdd(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val, r: mut &Ret,
          row: &[]Val, rs: mut &Run): Result[Unit, DbErr] {
    if !r.on { return Ok(Unit{}) }
    let noAggs: []Val = []
    let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: seqEnv(st, txn)}
    var out: []Val = []
    for x in r.exprs { append(mut &out, try evalX(st, txn, q, &x, &env, rs)) }
    append(mut &r.rows, out)
    return Ok(Unit{})
}

fn retRes(r: Ret, tag: str): Res {
    if !r.on { return tagOnly(tag) }
    let Ret{on: _, outs: outs, exprs: _, rows: rows} = move(r)
    return Res{cols: outs, rows: rows, tag: tag, hasRows: true, copy: COPY_NONE}
}

// Whether column i of t takes its default though a value was given (an
// identity column under OVERRIDING USER VALUE); an error if it may not
// take one (GENERATED ALWAYS, with no OVERRIDING SYSTEM VALUE).
fn idDefault(t: &Table, i: int, isDef: bool, ovr: int): Result[bool, DbErr] {
    let id = t.cols[i].identity
    if isDef || (id != lexdb_sql.ID_ALWAYS && id != lexdb_sql.ID_BY_DEFAULT) { return Ok(false) }
    if ovr == lexdb_sql.OVR_USER { return Ok(true) }
    if id == lexdb_sql.ID_ALWAYS && ovr != lexdb_sql.OVR_SYSTEM {
        return Err(e("428C9", "cannot insert a non-DEFAULT value into column \"" + t.cols[i].name + "\": it is GENERATED ALWAYS AS IDENTITY (OVERRIDING SYSTEM VALUE inserts it)"))
    }
    return Ok(false)
}

// The rows of VALUES inserted: their count (each kept, with keep).
fn insertRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, targets: &[]int, rows: &[][]Expr,
              env: &Env, ovr: int, keep: bool, kept: mut &[][]Val, up: mut &Upsert): Result[int, DbErr] {
    let defs = try defaultsOf(st, txn, t)
    let fw = try fkTables(st, txn, t, true, up.mode == lexdb_sql.CONFLICT_UPDATE)
    var later: []FkLater = []
    var count = 0
    for r in rows {
        var vs: []Val = []
        for k in 0..len(r) {
            if k >= len(targets) { return Err(e("42601", "INSERT has more expressions than target columns")) }
            let isDef = lexdb_sql.isDefault(&r[k])
            if isDef || try idDefault(t, targets[k], false, ovr) {
                append(mut &vs, try defAt(st, txn, &defs, t, targets[k]))
            } else {
                append(mut &vs, try eval(&r[k], env))
            }
        }
        match try insertOne(st, txn, t, targets, &vs, &defs, &fw, mut &later, up, env) {
            Some(row) {
                if keep { append(kept, row) }
                count += 1
            }
            None {}
        }
    }
    try fkFinish(st, txn, &fw, mut &later)
    return Ok(count)
}

// A row of values for the target columns (the rest their defaults): the
// row inserted, or under ON CONFLICT the row it updated instead (9.77);
// None when it did neither (DO NOTHING, or DO UPDATE's WHERE false).
fn insertOne(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, targets: &[]int, vs: &[]Val,
             defs: &Defs, fw: &[]Table, later: mut &[]FkLater, up: mut &Upsert, env: &Env): Result[Option[[]Val], DbErr] {
    if len(vs) > len(targets) { return Err(e("42601", "INSERT has more expressions than target columns")) }
    var row = nullRow(len(t.cols))
    var given: []bool = []
    for i in 0..len(t.cols) { append(mut &given, false) }
    for k in 0..len(vs) {
        let ci = targets[k]
        row[ci] = try coerce(vs[k], &t.cols[ci].typ)
        given[ci] = true
    }
    // the others their defaults (a sequence's taken only for these)
    for i in 0..len(t.cols) { if !given[i] { row[i] = try defAt(st, txn, defs, t, i) } }
    try checkRow(t, &row)
    try checkChecks(t, &row)
    if up.mode != lexdb_sql.CONFLICT_NONE {
        match try conflictOf(st, txn, t, up, &row) {
            Some(old) { return upsertOld(st, txn, t, defs, fw, later, up, env, &old, &row) }
            None {}
        }
    }
    let r = try storeRow(st, txn, t, row, fw, later)
    if up.mode != lexdb_sql.CONFLICT_NONE { up.touched.put(keyOf(t, &r), 1) }
    return Ok(Some(r))
}

// ---- INSERT ... ON CONFLICT (9.77)

// What an INSERT does on a conflict: nothing, or update the row there.
type Upsert = record {
    mode: int                   // lexdb_sql.CONFLICT_*
    arb: []int                  // the unique keys that count: -1 the primary key, else an index of t.indexes
    targets: []int              // DO UPDATE SET's columns
    sets: []Expr                // ... and values, over cols
    cond: Option[Expr]          // DO UPDATE's WHERE, over cols
    cols: []lexdb_sql.ColDef    // the table's columns (alias.column), then EXCLUDED's (excluded.column)
    touched: Map[str, int]      // the rows the statement inserted or updated, by primary key
}

fn noUpsert(): Upsert {
    return Upsert{mode: lexdb_sql.CONFLICT_NONE, arb: [], targets: [], sets: [], cond: None, cols: [], touched: newMap()}
}

fn sameCols(a: &[]int, b: &[]int): bool {
    if len(a) != len(b) { return false }
    for x in a {
        var found = false
        for y in b { if x == y { found = true } }
        if !found { return false }
    }
    return true
}

// The ON CONFLICT of s on table t: its unique keys (the target's, or every
// one for DO NOTHING without a target) and DO UPDATE's assignments,
// resolved over the table's columns as alias.column and EXCLUDED's as
// excluded.column: a bare name in an expression is in both, so ambiguous
// (42702), as in PostgreSQL; only the column SET names stands alone.
fn upsertOf(s: &lexdb_sql.Stmt, t: &Table, sc: mut &Scope): Result[Upsert, DbErr] {
    var up = noUpsert()
    up.mode = s.conflict
    if s.conflict == lexdb_sql.CONFLICT_NONE { return Ok(up) }
    let tname = lexdb_sql.baseName(&t.name)
    if len(s.conflictCols) > 0 {
        var cs: []int = []
        for n in s.conflictCols {
            let i = colIndex(&t.cols, &n)
            if i < 0 { return Err(e("42703", "column \"" + n + "\" does not exist")) }
            append(mut &cs, i)
        }
        if sameCols(&cs, &t.pk) { append(mut &up.arb, -1) }
        for i in 0..len(t.indexes) { if t.indexes[i].unique && sameCols(&cs, &t.indexes[i].cols) { append(mut &up.arb, i) } }
        if len(up.arb) == 0 {
            return Err(e("42P10", "there is no unique or exclusion constraint matching the ON CONFLICT specification"))
        }
    } else if s.conflictCon != "" {
        if s.conflictCon == tname + "_pkey" { append(mut &up.arb, -1) }
        for i in 0..len(t.indexes) {
            if t.indexes[i].unique && lexdb_sql.baseName(&t.indexes[i].name) == s.conflictCon { append(mut &up.arb, i) }
        }
        if len(up.arb) == 0 { return Err(e("42704", "constraint \"" + s.conflictCon + "\" for table \"" + tname + "\" does not exist")) }
    } else {
        if s.conflict == lexdb_sql.CONFLICT_UPDATE {
            return Err(e("42601", "ON CONFLICT DO UPDATE requires inference specification or constraint name"))
        }
        append(mut &up.arb, -1)
        for i in 0..len(t.indexes) { if t.indexes[i].unique { append(mut &up.arb, i) } }
    }
    if s.conflict == lexdb_sql.CONFLICT_NOTHING { return Ok(up) }
    let alias = if s.alias != "" { s.alias } else { tname }
    for c in t.cols { append(mut &up.cols, lexdb_sql.colDef(alias + "." + c.name, c.typ, false)) }
    for c in t.cols { append(mut &up.cols, lexdb_sql.colDef("excluded." + c.name, c.typ, false)) }
    for set in s.sets {
        let i = colIndex(&t.cols, &set.col)
        if i < 0 { return Err(e("42703", "column \"" + set.col + "\" of relation \"" + tname + "\" does not exist")) }
        if t.cols[i].identity == lexdb_sql.ID_ALWAYS && !lexdb_sql.isDefault(&set.expr) {
            return Err(e("428C9", "column \"" + t.cols[i].name + "\" can only be updated to DEFAULT"))
        }
        append(mut &up.targets, i)
        append(mut &up.sets, try resolve(&set.expr, &up.cols, len(up.cols), sc))
    }
    match s.where {
        Some(w) { up.cond = Some(try resolve(&w, &up.cols, len(up.cols), sc)) }
        None {}
    }
    return Ok(up)
}

// The row already in t that row conflicts with on one of up's unique keys,
// if any.
fn conflictOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, up: &Upsert, row: &[]Val): Result[Option[[]Val], DbErr] {
    for a in up.arb {
        var pk = ""
        if a < 0 {
            pk = keyOf(t, row)
        } else {
            let ix = &t.indexes[a]
            if hasNull(ix, row) || !(try inIndex(t, ix, row)) { continue }
            let pre = idxPrefix(ix, row)
            var hit: []str = []
            try st.scan(txn, ix.tree, pre, succ(&pre), fn(en: &lexdb_store.Entry): bool {
                append(mut &hit, en.val)
                return false
            })
            if len(hit) == 0 { continue }
            pk = hit[0]
        }
        match try st.get(txn, t.tree, pk) {
            Some(v) {
                let all: []bool = []
                return Ok(Some(try rowOf(st, txn, t, &pk, &v, rowWidth(t), &all, &placesMissing(t))))
            }
            None {}
        }
    }
    return Ok(None)
}

// The row there (old), the row proposed (row): DO NOTHING leaves it; DO
// UPDATE sets its columns, unless its WHERE is not true, and may not touch
// a row the statement inserted or updated already (21000).
fn upsertOld(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, defs: &Defs, fw: &[]Table, later: mut &[]FkLater,
             up: mut &Upsert, env: &Env, old: &[]Val, row: &[]Val): Result[Option[[]Val], DbErr] {
    if up.mode == lexdb_sql.CONFLICT_NOTHING { return Ok(None) }
    let oldKey = keyOf(t, old)
    if up.touched.has(&oldKey) {
        return Err(e("21000", "ON CONFLICT DO UPDATE command cannot affect row a second time"))
    }
    var both: []Val = copyRow(old)
    for v in row { append(mut &both, v) }
    let uenv = Env{cols: &up.cols, row: &both, aggs: env.aggs, params: env.params, subs: env.subs, cur: env.cur, seq: env.seq}
    match up.cond {
        Some(c) { if truth(&(try eval(&c, &uenv))) != Some(true) { return Ok(None) } }
        None {}
    }
    var next = copyRow(old)
    for k in 0..len(up.sets) {
        let ci = up.targets[k]
        if lexdb_sql.isDefault(&up.sets[k]) { next[ci] = try defAt(st, txn, defs, t, ci) }
        else { next[ci] = try coerce(try eval(&up.sets[k], &uenv), &t.cols[ci].typ) }
    }
    try updRow(st, txn, t, old, &next, fw, later)
    up.touched.put(keyOf(t, &next), 1)
    return Ok(Some(next))
}

// A built row stored: its key free, its indexes and foreign keys checked.
fn storeRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, row: []Val, fw: &[]Table,
            later: mut &[]FkLater): Result[[]Val, DbErr] {
    let key = keyOf(t, &row)
    if (try st.get(txn, t.tree, key)).isSome() { return Err(dupKey(t, &row)) }
    let enc = encRowOf(t, &row)
    try txn.putRow(t.tree, key, enc, rowHead(&enc))
    try addIndexes(st, txn, t, &row, &key)
    if len(t.fks) > 0 {
        let none: []Val = []
        try childSide(st, txn, t, fw, &row, &none, later)
    }
    return Ok(row)
}

fn update(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    try notView(st, txn, &s.table, &"update")
    try dmlCheck(st, txn, s, &"w")
    let sqe = seqEnv(st, txn)
    var sc = newScope(params, &[])
    sc.target = try catKey(st, txn, &s.table, false)
    var q = try buildQuery(st, txn, &oneTable(&s.table), &s.where, params, &s.subs, mut &sc)
    var targets: []int = []
    var sets: []Expr = []
    for set in s.sets {
        let i = colIndex(&q.levels[0].t.cols, &set.col)
        if i < 0 {
            return Err(e("42703", "column \"" + set.col + "\" of relation \"" + lexdb_sql.baseName(&q.levels[0].t.name) + "\" does not exist"))
        }
        append(mut &targets, i)
        append(mut &sets, try resolve(&set.expr, &q.cols, len(q.cols), mut &sc))
    }
    var ret = try retOf(s, &q, mut &sc)
    endScope(mut &sc, mut &q)
    let t = &q.levels[0].t
    var found: [][]Val = []
    var rs = newRun(&q)
    rs.limit(&lim)
    let m = try prepare(st, txn, &q, params, mut &rs)
    let room = rs.room()
    let max = rs.maxHeld
    var held = 0
    try runQuery(st, txn, &q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
        held += 2 * rowBytes(r)             // the row found, and its write
        if room >= 0 && held > room { return Err(memErr(max)) }
        append(mut &found, copyRow(r))
        return Ok(true)
    }, mut &rs)
    let noAggs: []Val = []
    let defs = try defaultsOf(st, txn, t)
    for k in 0..len(sets) {
        if t.cols[targets[k]].identity == lexdb_sql.ID_ALWAYS && !lexdb_sql.isDefault(&sets[k]) {
            return Err(e("428C9", "column \"" + t.cols[targets[k]].name + "\" can only be updated to DEFAULT"))
        }
    }
    let fw = try fkTables(st, txn, t, true, true)
    var later: []FkLater = []
    for old in found {
        let env = Env{cols: &q.cols, row: &old, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
        var row = copyRow(&old)
        for k in 0..len(sets) {
            if lexdb_sql.isDefault(&sets[k]) { row[targets[k]] = try defAt(st, txn, &defs, t, targets[k]) }
            else { row[targets[k]] = try coerce(try evalX(st, txn, &q, &sets[k], &env, mut &rs), &t.cols[targets[k]].typ) }
        }
        try updRow(st, txn, t, &old, &row, &fw, mut &later)
        try retAdd(st, txn, &q, &m, params, mut &ret, &row, mut &rs)
    }
    try fkFinish(st, txn, &fw, mut &later)
    return Ok(retRes(ret, "UPDATE " + len(found).toStr()))
}

fn delete(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    try notView(st, txn, &s.table, &"delete from")
    try dmlCheck(st, txn, s, &"d")
    var sc = newScope(params, &[])
    sc.target = try catKey(st, txn, &s.table, false)
    var q = try buildQuery(st, txn, &oneTable(&s.table), &s.where, params, &s.subs, mut &sc)
    var ret = try retOf(s, &q, mut &sc)
    endScope(mut &sc, mut &q)
    let t = &q.levels[0].t
    var found: [][]Val = []
    var rs = newRun(&q)
    rs.limit(&lim)
    let m = try prepare(st, txn, &q, params, mut &rs)
    let room = rs.room()
    let max = rs.maxHeld
    var held = 0
    try runQuery(st, txn, &q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
        held += 2 * rowBytes(r)             // the row found, and its write
        if room >= 0 && held > room { return Err(memErr(max)) }
        append(mut &found, copyRow(r))
        return Ok(true)
    }, mut &rs)
    let fw = try fkTables(st, txn, t, false, true)
    var later: []FkLater = []
    for row in found {
        try retAdd(st, txn, &q, &m, params, mut &ret, &row, mut &rs)
        try delRow(st, txn, t, &row, &fw, mut &later)
    }
    try fkFinish(st, txn, &fw, mut &later)
    return Ok(retRes(ret, "DELETE " + len(found).toStr()))
}

fn explain(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, x: &lexdb_sql.Stmt, params: &[]Val, lim: Limits,
           ptypes: &[]int): Result[Res, DbErr] {
    let s = &x.inner[0]
    var res = Res{cols: [OutCol{name: "QUERY PLAN", oid: lexdb_sql.OID_TEXT}], rows: [], tag: "EXPLAIN", hasRows: true, copy: COPY_NONE}
    var lines: []str = []
    let none: []Counts = []
    if x.ifFlag {
        // ANALYZE: run it, counting what each table does
        let t0 = time.monotonicNs()
        let r = try selectWith(st, txn, s, params, ptypes, lim, true, mut &lines)
        let us = (time.monotonicNs() - t0) / 1000
        append(mut &lines, "result: " + len(r.rows).toStr() + " rows in " + (us / 1000).toStr() + "." +
               strings.padLeft((us % 1000).toStr(), 3, '0') + " ms")
    } else if s.kind == lexdb_sql.S_SELECT {
        var sc = newScope(params, ptypes)
        let sel = try planSelect(st, txn, s, params, mut &sc)
        let noStats: []SubStat = []
        lines = selLines(&sel, &none, &noStats)
    } else {
        var sc = newScope(params, ptypes)
        var q = try buildQuery(st, txn, &oneTable(&s.table), &s.where, params, &s.subs, mut &sc)
        endScope(mut &sc, mut &q)
        lines = explainLines(&q, &none)
        let noStats: []SubStat = []
        subLines(&q, &noStats, mut &lines)
    }
    for l in lines { append(mut &res.rows, [Val.Text(l)]) }
    return Ok(res)
}

// ---- SELECT

fn exprName(x: &Expr): str {
    match x {
        Expr.Col(n) { return colPart(&n) }
        Expr.Call(n, args, _) {
            if isSubCall(&n) && len(args) >= 3 {
                match args[2] { Expr.Lit(v) { return text(&v) } else {} }
            }
            if n == "#win" && len(args) == 2 { return exprName(&args[1]) }
            return aggBase(&n)
        }
        Expr.Cast(a, t) {
            let inner = exprName(&a)
            return if inner == "?column?" { kindName(&t) } else { inner }
        }
        else { return "?column?" }
    }
}

// The type OID of an expression, as far as it can be told before running.
fn isFloatOid(o: int): bool { return o == lexdb_sql.OID_FLOAT4 || o == lexdb_sql.OID_FLOAT8 }

pub fn exprOid(x: &Expr, cols: &[]lexdb_sql.ColDef, ptypes: &[]int): int {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Int(n) { return if n >= -2147483648 && n <= 2147483647 { lexdb_sql.OID_INT4 } else { lexdb_sql.OID_INT8 } }
                Val.Bool(_) { return lexdb_sql.OID_BOOL }
                Val.Num(_) { return lexdb_sql.OID_NUMERIC }
                Val.Date(_) { return lexdb_sql.OID_DATE }
                Val.Time(_) { return lexdb_sql.OID_TIME }
                Val.Ts(_) { return lexdb_sql.OID_TS }
                Val.Tstz(_) { return lexdb_sql.OID_TSTZ }
                Val.Ival(_) { return lexdb_sql.OID_IVAL }
                Val.Uuid(_) { return lexdb_sql.OID_UUID }
                Val.Bytes(_) { return lexdb_sql.OID_BYTEA }
        Val.Float(_) { return lexdb_sql.OID_FLOAT8 }
        Val.Real(_) { return lexdb_sql.OID_FLOAT4 }
        Val.Reg(_, _) { return lexdb_sql.OID_REGCLASS }
                else { return lexdb_sql.OID_TEXT }
            }
        }
        Expr.Param(n) {
            if n <= len(ptypes) && ptypes[n - 1] != 0 { return ptypes[n - 1] }
            return lexdb_sql.OID_TEXT
        }
        Expr.Col(n) {
            let i = colIndex(cols, &n)
            return if i >= 0 { cols[i].typ.oid } else { lexdb_sql.OID_TEXT }
        }
        Expr.Unary(op, a) { return if op == "not" { lexdb_sql.OID_BOOL } else { exprOid(&a, cols, ptypes) } }
        Expr.Bin(op, a, b) {
            if op == "||" {
                let l = exprOid(&a, cols, ptypes)
                let r = exprOid(&b, cols, ptypes)
                return if l == lexdb_sql.OID_BYTEA || r == lexdb_sql.OID_BYTEA { lexdb_sql.OID_BYTEA } else { lexdb_sql.OID_TEXT }
            }
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
                let l = exprOid(&a, cols, ptypes)
                let r = exprOid(&b, cols, ptypes)
                let to = timeOpOid(&op, l, r)
                if to > 0 { return to }
                if l == lexdb_sql.OID_FLOAT4 && r == lexdb_sql.OID_FLOAT4 { return lexdb_sql.OID_FLOAT4 }
                if isFloatOid(l) || isFloatOid(r) { return lexdb_sql.OID_FLOAT8 }
                if l == lexdb_sql.OID_NUMERIC || r == lexdb_sql.OID_NUMERIC { return lexdb_sql.OID_NUMERIC }
                if l == lexdb_sql.OID_INT8 || r == lexdb_sql.OID_INT8 { return lexdb_sql.OID_INT8 }
                return lexdb_sql.OID_INT4
            }
            return lexdb_sql.OID_BOOL
        }
        Expr.IsNull(_, _) { return lexdb_sql.OID_BOOL }
        Expr.Cast(_, t) { return t.oid }
        Expr.Call(n, args, _) {
            if n == "#win" && len(args) == 2 {
                // a window call: its function's type (9.46)
                match args[1] {
                    Expr.Call(f, fa, _) {
                        let b = aggBase(&f)
                        if b == "row_number" || b == "rank" || b == "dense_rank" || b == "ntile" { return lexdb_sql.OID_INT8 }
                        if b == "percent_rank" || b == "cume_dist" { return lexdb_sql.OID_NUMERIC }
                        if b == "lag" || b == "lead" || b == "first_value" || b == "last_value" || b == "nth_value" {
                            return if len(fa) > 0 { exprOid(&fa[0], cols, ptypes) } else { lexdb_sql.OID_TEXT }
                        }
                    }
                    else {}
                }
                return exprOid(&args[1], cols, ptypes)
            }
            if isSubCall(&n) {
                if n != "#sub" { return lexdb_sql.OID_BOOL }
                let oid = if len(args) >= 2 { litInt(&args[1]) } else { -1 }
                return if oid > 0 { oid } else { lexdb_sql.OID_TEXT }
            }
            match aggBase(&n) {
                "count" { return lexdb_sql.OID_INT8 }
                "bool_and", "bool_or", "every" { return lexdb_sql.OID_BOOL }
                "string_agg" { return lexdb_sql.OID_TEXT }
                "array_agg" {
                    let el = if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_TEXT }
                    let ao = lexdb_sql.arrayOid(if el == lexdb_sql.OID_UNKNOWN { lexdb_sql.OID_TEXT } else { el })
                    return if ao > 0 { ao } else { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                }
                "like", "ilike", "in", "distinct", "any", "all" { return lexdb_sql.OID_BOOL }
                "case" { return if len(args) > 1 { exprOid(&args[1], cols, ptypes) } else { lexdb_sql.OID_TEXT } }
                "nullif", "greatest", "least" { return if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_TEXT } }
                "strpos" { return lexdb_sql.OID_INT4 }
                "array" {
                    var el = lexdb_sql.OID_TEXT
                    for a in args {
                        let o = exprOid(&a, cols, ptypes)
                        if o != lexdb_sql.OID_TEXT { el = o }
                    }
                    let ao = lexdb_sql.arrayOid(el)
                    return if ao > 0 { ao } else { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                }
                "stddev", "stddev_samp", "stddev_pop", "variance", "var_samp", "var_pop", "avg" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_INT8 }
                    return if isFloatOid(a) { lexdb_sql.OID_FLOAT8 } else { lexdb_sql.OID_NUMERIC }
                }
                "sum" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_INT8 }
                    return if a == lexdb_sql.OID_NUMERIC || isFloatOid(a) { a } else { lexdb_sql.OID_INT8 }
                }
                "floor", "ceil", "ceiling", "trunc" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_FLOAT8 }
                    return if a == lexdb_sql.OID_NUMERIC { a } else { lexdb_sql.OID_FLOAT8 }
                }
                "sign" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_FLOAT8 }
                    return if isFloatOid(a) { lexdb_sql.OID_FLOAT8 } else { lexdb_sql.OID_NUMERIC }
                }
                "sqrt", "cbrt", "exp", "ln", "log10", "power", "pow", "random" { return lexdb_sql.OID_FLOAT8 }
                "format_type", "pg_get_expr", "pg_get_constraintdef", "pg_get_indexdef", "pg_get_serial_sequence", "quote_ident",
                "array_to_string", "obj_description", "col_description", "shobj_description", "pg_get_viewdef", "json_build_object",
                "jsonb_build_object", "pg_get_userbyid", "repeat", "pg_get_triggerdef", "pg_get_ruledef", "pg_get_statisticsobjdef_columns",
                "pg_get_function_result", "pg_get_function_arguments" {
                    return lexdb_sql.OID_TEXT
                }
                "current_user", "session_user", "current_schema", "pg_encoding_to_char" { return lexdb_sql.OID_NAME }
                "has_sequence_privilege", "has_any_column_privilege" { return lexdb_sql.OID_BOOL }
                "pg_table_is_visible", "pg_type_is_visible", "pg_function_is_visible", "pg_collation_is_visible", "~", "!~", "~*",
                "!~*", "has_table_privilege", "has_schema_privilege", "has_database_privilege", "pg_relation_is_publishable" {
                    return lexdb_sql.OID_BOOL
                }
                "array_length", "array_upper", "array_lower", "cardinality", "generate_subscripts" { return lexdb_sql.OID_INT4 }
                "pg_relation_size", "pg_total_relation_size", "pg_table_size", "pg_indexes_size" { return lexdb_sql.OID_INT8 }
                "to_regclass", "pg_partition_ancestors" { return lexdb_sql.OID_REGCLASS }
                "to_regtype" { return lexdb_sql.OID_REGTYPE }
                "to_regnamespace" { return lexdb_sql.OID_REGNAMESPACE }
                "unnest", "#elem" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_TEXT }
                    let el = lexdb_sql.elemOid(a)
                    return if el > 0 { el } else { lexdb_sql.OID_TEXT }
                }
                "min", "max", "abs", "coalesce" {
                    return if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_TEXT }
                }
                "length", "char_length", "octet_length" { return lexdb_sql.OID_INT4 }
                "gen_random_uuid" { return lexdb_sql.OID_UUID }
                "encode" { return lexdb_sql.OID_TEXT }
                "decode" { return lexdb_sql.OID_BYTEA }
                "now", "current_timestamp", "transaction_timestamp", "statement_timestamp", "clock_timestamp", "to_timestamp" {
                    return lexdb_sql.OID_TSTZ
                }
                "localtimestamp" { return lexdb_sql.OID_TS }
                "current_date", "make_date" { return lexdb_sql.OID_DATE }
                "current_time", "localtime" { return lexdb_sql.OID_TIME }
                "date_part" { return lexdb_sql.OID_NUMERIC }
                "age" { return lexdb_sql.OID_IVAL }
                "isfinite" { return lexdb_sql.OID_BOOL }
                "date_trunc" {
                    let a = if len(args) > 1 { exprOid(&args[1], cols, ptypes) } else { lexdb_sql.OID_TSTZ }
                    return if a == lexdb_sql.OID_TS || a == lexdb_sql.OID_IVAL { a } else { lexdb_sql.OID_TSTZ }
                }
                "nextval", "currval", "setval", "lastval" { return lexdb_sql.OID_INT8 }
                "round" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes) } else { lexdb_sql.OID_NUMERIC }
                    return if isFloatOid(a) && len(args) == 1 { lexdb_sql.OID_FLOAT8 } else { lexdb_sql.OID_NUMERIC }
                }
                else { return lexdb_sql.OID_TEXT }
            }
        }
    }
}

// The output columns of a SELECT: (name, OID), and the expressions behind
// them (* expanded).
fn selectCols(s: &lexdb_sql.Stmt, cols: &[]lexdb_sql.ColDef, sc: mut &Scope, exprs: mut &[]Expr): Result[[]OutCol, DbErr] {
    return itemCols(&s.items, len(s.from) > 0, cols, sc, exprs)
}

// An item list's output columns (a SELECT's or RETURNING's), over cols.
fn itemCols(items: &[]lexdb_sql.SelItem, from: bool, cols: &[]lexdb_sql.ColDef, sc: mut &Scope,
            exprs: mut &[]Expr): Result[[]OutCol, DbErr] {
    var out: []OutCol = []
    for it in items {
        if it.star {
            if !from { return Err(e("42601", "SELECT * with no tables specified is not valid")) }
            var any = false
            for c in cols {
                if it.qual != "" && c.name[0..dotAt(&c.name)] != it.qual { continue }
                any = true
                append(mut &out, OutCol{name: colPart(&c.name), oid: c.typ.oid})
                append(exprs, Expr.Col(c.name))
            }
            if !any { return Err(e("42P01", "missing FROM-clause entry for table \"" + it.qual + "\"")) }
            continue
        }
        match it.expr {
            Some(x) {
                let r = try resolve(&x, cols, len(cols), sc)
                let name = if it.alias != "" { it.alias } else { exprName(&r) }
                let pt = ptypesOf(sc)
                append(mut &out, OutCol{name: name, oid: exprOid(&r, cols, &pt)})
                append(exprs, r)
            }
            None {}
        }
    }
    return Ok(out)
}

// ORDER BY: an output column's name, if no input column has it, else an
// expression over the input.
fn resolveOrder(o: &Expr, cols: &[]lexdb_sql.ColDef, outs: &[]OutCol, sc: mut &Scope): Result[Expr, DbErr] {
    match o {
        Expr.Col(n) {
            match resolveName(cols, len(cols), &n) {
                Ok(r) { return Ok(Expr.Col(r)) }
                Err(x) {
                    for oc in outs { if oc.name == n { return Ok(Expr.Col(n)) } }
                    return Err(x)
                }
            }
        }
        else {}
    }
    return resolve(o, cols, len(cols), sc)
}

type OutRow = record { vals: []Val; ord: []Val }

fn sortCmp(a: &Val, b: &Val): int {
    let na = isNull(a)
    let nb = isNull(b)
    if na && nb { return 0 }
    if na { return 1 }          // NULLS LAST ascending
    if nb { return -1 }
    match compare(a, b) {
        Ok(c) { return c }
        Err(_) { return kindOf(a) - kindOf(b) }
    }
}

fn evalInt(x: &Option[Expr], params: &[]Val, what: str): Result[int, DbErr] {
    match x {
        Some(v) {
            match v {
                Expr.Lit(_) {}
                else { PARAM_LOOKS += 1 }
            }
            let noCols: []lexdb_sql.ColDef = []
            let noRow: []Val = []
            let noAggs: []Val = []
            let noSubs: []SubRes = []
            let env = Env{cols: &noCols, row: &noRow, aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs, seq: None}
            match try coerce(try eval(&v, &env), &lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}) {
                Val.Int(n) {
                    if n < 0 { return Err(e("2201W", what + " must not be negative")) }
                    return Ok(n)
                }
                else { return Ok(-1) }
            }
        }
        None { return Ok(-1) }
    }
}

// An ORDER BY item may name an output column by position or by its alias.
fn orderValue(o: &Expr, outs: &[]OutCol, vals: &[]Val, env: &Env): Result[Val, DbErr] {
    match o {
        Expr.Lit(v) {
            match v {
                Val.Int(n) {
                    if n < 1 || n > len(vals) { return Err(e("42P10", "ORDER BY position " + n.toStr() + " is not in select list")) }
                    return Ok(vals[n - 1])
                }
                else {}
            }
        }
        Expr.Col(n) {
            if colIndex(&env.cols, &n) < 0 {
                for i in 0..len(outs) { if outs[i].name == n { return Ok(vals[i]) } }
            }
        }
        else {}
    }
    return eval(o, env)
}

fn select(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
          lim: Limits, pc: mut &PlanCache): Result[Res, DbErr] {
    // A prepared statement's plan, kept while the schema the transaction
    // sees is the same and the plan looked at no parameter's value.
    var ver = try catVersion(st, txn)
    if len(txn.path) > 0 { ver = ver + "|" + strings.join(&txn.path, ",") }      // its names resolved by the path
    // its privileges checked as the role: SET ROLE plans it again (9.83)
    match st.memoGet(&roleKeyOf(txn.sess)) {
        Some(r) { if len(r) > 0 { ver = ver + "|r" + r } }
        None {}
    }
    match st.memoGet(&sessAuthKey(txn.sess)) {
        Some(r) { if len(r) > 0 { ver = ver + "|s" + r } }
        None {}
    }
    if len(pc.sels) == 0 || pc.ver != ver {
        pc.sels = []
        var sc = newScope(params, ptypes)
        let looks = PARAM_LOOKS
        let sel = try planSelect(st, txn, s, params, mut &sc)
        if PARAM_LOOKS != looks || !pc.keep { return runSel(st, txn, &sel, params, lim) }
        append(mut &pc.sels, sel)
        pc.ver = ver
        pc.plans += 1
    }
    return runSel(st, txn, &pc.sels[0], params, lim)
}

fn runSel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    var rs = newRun(&sel.q)
    rs.limit(&lim)
    return execSel(st, txn, sel, params, -1, mut &rs)
}

// A prepared statement's plan (select), with the catalog version it was
// made for. keep false: never kept (a statement run once).
pub type PlanCache = record { sels: []Sel; ver: str; keep: bool; pub plans: int }

pub fn newPlanCache(): PlanCache { return PlanCache{sels: [], ver: "", keep: true, plans: 0} }

pub fn oneShot(): PlanCache { return PlanCache{sels: [], ver: "", keep: false, plans: 0} }

// ---- aggregates: one accumulator per call and group, so a grouped
// query holds its groups, not its rows

// An aggregate call of the query: its function, arguments, modifiers.
type AggSpec = record {
    fname: str
    args: []Expr
    star: bool
    distinct: bool
    filter: Option[Expr]
    order: []Expr           // ORDER BY in the call (string_agg's result depends on it; the others' not)
    dirs: str               // per key: a, A (NULLs first), d, D (NULLs last), as the parser gives them
    text: str               // to share one accumulator between equal calls
}

type Acc = record {
    n: int
    val: Val                // min, max, bool_and, bool_or
    sum: Val                // sum, avg; the variances: the sum ...
    sumsq: Val              // ... and the sum of squares
    parts: []str            // string_agg
    seps: []Val             // ... with ORDER BY: each value's separator
    ords: [][]Val           // ... and its keys (sorted when it finishes)
    seen: Map[str, int]     // DISTINCT
}

fn newAccs(n: int): []Acc {
    var out: []Acc = []
    for i in 0..n { append(mut &out, Acc{n: 0, val: Val.Null, sum: Val.Null, sumsq: Val.Null, parts: [], seps: [], ords: [], seen: newMap()}) }
    return out
}

fn slotRef(i: int): Expr { return Expr.Call("#agg", [Expr.Lit(Val.Int(i))], false) }

// x with each aggregate call replaced by its slot, the calls added to specs.
fn collectAggs(x: &Expr, specs: mut &[]AggSpec): Result[Expr, DbErr] {
    match x {
        Expr.Call(name, args, star) {
            if !isAgg(&name) {
                var out: []Expr = []
                for a in args { append(mut &out, try collectAggs(&a, specs)) }
                return Ok(Expr.Call(name, out, star))
            }
            let base = aggBase(&name)
            var aargs = cloneAll(&args)
            var filter: Option[Expr] = None
            if strings.contains(name, " filter") { filter = Some(pop(mut &aargs)) }
            var order: []Expr = []
            var dirs = ""
            let oi = strings.indexOf(name, " order:", 0)
            if oi >= 0 {
                let rest = name[oi + 7..len(name)]
                let sp = strings.indexOf(rest, " ", 0)
                dirs = if sp < 0 { rest } else { rest[0..sp] }
                var rev: []Expr = []
                for k in 0..len(dirs) { append(mut &rev, pop(mut &aargs)) }
                while len(rev) > 0 { append(mut &order, pop(mut &rev)) }
                for o in order { if hasAgg(&o) { return Err(e("42803", "aggregate function calls cannot be nested")) } }
            }
            for a in aargs { if hasAgg(&a) { return Err(e("42803", "aggregate function calls cannot be nested")) } }
            for a in aargs { if hasWin(&a) { return Err(e("42803", "aggregate function calls cannot contain window function calls")) } }
            match filter {
                Some(f) { if hasAgg(&f) { return Err(e("42803", "aggregate functions are not allowed in FILTER")) } }
                None {}
            }
            let want = if base == "string_agg" { 2 } else { 1 }
            if star && base != "count" { return Err(e("42809", base + "(*) is not an aggregate that takes *")) }
            if !star && len(aargs) != want {
                return Err(e("42883", "function " + base + " takes " + want.toStr() + " argument" + (if want > 1 { "s" } else { "" })))
            }
            let text = lexdb_sql.exprText(x)
            for i in 0..len(specs) { if specs[i].text == text { return Ok(slotRef(i)) } }
            append(specs, AggSpec{fname: base, args: aargs, star: star, distinct: strings.contains(name, " distinct"),
                                  filter: filter, order: order, dirs: dirs, text: text})
            return Ok(slotRef(len(specs) - 1))
        }
        Expr.Unary(op, a) { return Ok(Expr.Unary(op, try collectAggs(&a, specs))) }
        Expr.Bin(op, a, b) {
            let l = try collectAggs(&a, specs)
            let r = try collectAggs(&b, specs)
            return Ok(Expr.Bin(op, l, r))
        }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try collectAggs(&a, specs), neg)) }
        Expr.Cast(a, t) { return Ok(Expr.Cast(try collectAggs(&a, specs), t)) }
        else { return Ok(clone(x)) }
    }
}

fn numOf(v: &Val, fname: &str): Result[Val, DbErr] {
    if isFloat(v) { return Ok(Val.Float(asFloat(v).unwrap())) }      // a float's variance is a double precision
    match asNum(v) {
        Some(d) { return Ok(Val.Num(d)) }
        None { return Err(e("42883", "function " + fname + " needs a number")) }
    }
}

// A grouped query's groups so far: per group its first row (for grouped
// columns) and its accumulators.
type Groups = record {
    index: Map[str, int]        // GROUP BY key -> group
    firsts: [][]Val
    accs: [][]Acc
}

// Adds a row to its group (env: the row, and its correlated subqueries'
// values if any).
fn addToGroup(sel: &Sel, gs: mut &Groups, r: &[]Val, env: &Env, held: mut &int, room: int, rs0max: int): Result[Unit, DbErr] {
    var g = 0
    if len(sel.groupBy) > 0 {
        var kb = newStrBuf()
        for x in sel.groupBy { encIdxPart(mut &kb, &(try eval(&x, env))) }
        let k = kb.toStr()
        match gs.index.get(&k) {
            Some(i) { g = i }
            None {
                g = len(gs.firsts)
                held += rowBytes(r) + 64 * (len(sel.specs) + 1) + len(k)
                if room >= 0 && held > room { return Err(memErr(rs0max)) }
                gs.index.put(k, g)
                append(mut &gs.firsts, copyRow(r))
                append(mut &gs.accs, newAccs(len(sel.specs)))
            }
        }
    } else if len(gs.firsts) == 0 {
        append(mut &gs.firsts, copyRow(r))
        append(mut &gs.accs, newAccs(len(sel.specs)))
    }
    for i in 0..len(sel.specs) { try accumulate(&sel.specs[i], mut &gs.accs[g][i], env) }
    return Ok(Unit{})
}

// A correlated subquery in a GROUP BY key or an aggregate's argument or
// FILTER.
fn groupCorr(sel: &Sel): bool {
    for g in sel.groupBy { if hasCorr(&g) { return true } }
    for sp in sel.specs {
        for a in sp.args { if hasCorr(&a) { return true } }
        for o in sp.order { if hasCorr(&o) { return true } }
        match sp.filter {
            Some(f) { if hasCorr(&f) { return true } }
            None {}
        }
    }
    return false
}

// Adds one row (env) to an accumulator.
fn accumulate(sp: &AggSpec, acc: mut &Acc, env: &Env): Result[Unit, DbErr] {
    match sp.filter {
        Some(f) { if truth(&(try eval(&f, env))) != Some(true) { return Ok(Unit{}) } }
        None {}
    }
    if sp.star {
        acc.n += 1
        return Ok(Unit{})
    }
    let v = try eval(&sp.args[0], env)
    if isNull(&v) && sp.fname != "array_agg" { return Ok(Unit{}) }      // array_agg keeps NULLs, as elements
    if sp.distinct {
        var kb = newStrBuf()
        encIdxPart(mut &kb, &v)
        let k = kb.toStr()
        if acc.seen.get(&k).isSome() { return Ok(Unit{}) }
        acc.seen.put(k, 1)
    }
    let f = sp.fname
    if f == "sum" || f == "avg" {
        // avg of reals adds in double precision, as PostgreSQL's float4_accum
        let w = if f == "avg" && isReal(&v) { Val.Float(asFloat(&v).unwrap()) } else { v }
        // and squares them, so overflows where PostgreSQL's float8_accum does
        if f == "avg" && isFloat(&w) { let sq = try arith(&"*", &w, &w) }
        acc.sum = if isNull(&acc.sum) { w } else { try arith(&"+", &acc.sum, &w) }
    } else if f == "min" {
        // of equal values the last, as PostgreSQL's numeric_smaller gives
        // (0.5 and 0.500: 0.500 if it comes after)
        if isNull(&acc.val) || (try compare(&v, &acc.val)) <= 0 { acc.val = v }
    } else if f == "max" {
        if isNull(&acc.val) || (try compare(&v, &acc.val)) >= 0 { acc.val = v }
    } else if f == "bool_and" || f == "every" || f == "bool_or" {
        let b = match truth(&v) {
            Some(x) { x }
            None { return Err(e("42883", "function " + f + " needs a boolean")) }
        }
        let prev = match acc.val { Val.Bool(x) { x } else { f != "bool_or" } }
        acc.val = Val.Bool(if f == "bool_or" { prev || b } else { prev && b })
    } else if f == "array_agg" {
        // the values, and their ORDER BY keys (parts keeps orderIdx's count)
        append(mut &acc.seps, v)
        append(mut &acc.parts, "")
        if len(sp.order) > 0 {
            var ks: []Val = []
            for o in sp.order { append(mut &ks, try eval(&o, env)) }
            append(mut &acc.ords, ks)
        }
    } else if f == "string_agg" {
        let sep = try eval(&sp.args[1], env)
        if len(sp.order) > 0 {
            var ks: []Val = []
            for o in sp.order { append(mut &ks, try eval(&o, env)) }
            append(mut &acc.parts, text(&v))
            append(mut &acc.seps, sep)
            append(mut &acc.ords, ks)
        } else {
            if acc.n > 0 && !isNull(&sep) { append(mut &acc.parts, text(&sep)) }
            append(mut &acc.parts, text(&v))
        }
    } else if f != "count" {
        // the variances and standard deviations
        let x = try numOf(&v, &f)
        let sq = try arith(&"*", &x, &x)
        acc.sum = if isNull(&acc.sum) { x } else { try arith(&"+", &acc.sum, &x) }
        acc.sumsq = if isNull(&acc.sumsq) { sq } else { try arith(&"+", &acc.sumsq, &sq) }
    }
    acc.n += 1
    return Ok(Unit{})
}

// The square root at 16 places (Newton's method at 20).
fn sqrtNum(v: &Val): Result[Val, DbErr] {
    if isFloat(v) { return Ok(Val.Float(asFloat(v).unwrap().sqrt())) }
    let a = asNum(v).unwrap()
    if a.isNeg() { return Err(e("2201F", "cannot take square root of a negative number")) }
    if a.isZero() { return Ok(Val.Num(a)) }
    var x = if (try compare(v, &Val.Int(1))) > 0 { a } else { Decimal.fromInt(1) }
    let two = Decimal.fromInt(2)
    for i in 0..200 {
        let q = match a.div(x, 20, Rounding.HALF_EVEN) { Ok(d) { d } Err(_) { return Err(decErr()) } }
        let next = match q.addExact(x) { Ok(d) { d } Err(_) { return Err(decErr()) } }
        let half = match next.div(two, 20, Rounding.HALF_EVEN) { Ok(d) { d } Err(_) { return Err(decErr()) } }
        if half.canonical() == x.canonical() { break }
        x = half
    }
    match x.quantize(16, Rounding.HALF_EVEN) {
        Ok(d) { return Ok(Val.Num(d)) }
        Err(_) { return Err(decErr()) }
    }
}

// string_agg with ORDER BY: its values sorted by their keys (stable: equal
// keys keep their order), each after its own separator but the first.
fn orderedParts(sp: &AggSpec, acc: &Acc): Result[str, DbErr] {
    let idx = try orderIdx(sp, acc)
    var b = newStrBuf()
    for j in 0..len(idx) {
        let i = idx[j]
        if j > 0 && !isNull(&acc.seps[i]) { b.add(text(&acc.seps[i])) }
        b.add(acc.parts[i])
    }
    return Ok(b.toStr())
}

// The order of an ordered aggregate's values (string_agg's, array_agg's):
// by its ORDER BY keys, ties as they came.
fn orderIdx(sp: &AggSpec, acc: &Acc): Result[[]int, DbErr] {
    var idx: []int = []
    for i in 0..len(acc.parts) { append(mut &idx, i) }
    var bad = false
    collections.sortBy(mut &idx, fn(a: &int, b: &int): int {
        for k in 0..len(sp.dirs) {
            let d = sp.dirs[k]
            let desc = d == 'd' || d == 'D'
            let nullsFirst = d == 'A' || d == 'd'
            let x = &acc.ords[a][k]
            let y = &acc.ords[b][k]
            let xn = isNull(x)
            let yn = isNull(y)
            if xn || yn {
                if xn && yn { continue }
                return if xn == nullsFirst { -1 } else { 1 }
            }
            let r = compare(x, y)
            if r.isErr() { bad = true }
            let c = r.unwrapOr(0)
            if c != 0 { return if desc { -c } else { c } }
        }
        return a - b
    })
    if bad { return Err(e("42804", sp.fname + ": its ORDER BY keys cannot be compared")) }
    return Ok(idx)
}

// An accumulator's result.
fn finish(sp: &AggSpec, acc: &Acc): Result[Val, DbErr] {
    let f = sp.fname
    if f == "count" { return Ok(Val.Int(acc.n)) }
    if acc.n == 0 { return Ok(Val.Null) }
    if f == "sum" { return Ok(acc.sum) }
    if f == "avg" { return arith(&"/", &(try numOf(&acc.sum, &f)), &Val.Num(Decimal.fromInt(acc.n))) }
    if f == "string_agg" && len(sp.order) > 0 { return Ok(Val.Text(try orderedParts(sp, acc))) }
    if f == "string_agg" { return Ok(Val.Text(strings.join(&acc.parts, ""))) }
    if f == "array_agg" {
        // its values in order, as an array's text (9.27)
        let idx = if len(sp.order) > 0 { try orderIdx(sp, acc) } else { [] }
        var vals: []Val = []
        if len(sp.order) > 0 { for i in idx { append(mut &vals, acc.seps[i]) } } else { for v in acc.seps { append(mut &vals, v) } }
        return Ok(Val.Text(arrayText(&vals)))
    }
    if f == "min" || f == "max" || f == "bool_and" || f == "bool_or" || f == "every" { return Ok(acc.val) }
    // variance: (n * sum of squares - sum * sum) / (n * (n - 1)), or n * n for the population's
    let pop = f == "var_pop" || f == "stddev_pop"
    if !pop && acc.n < 2 { return Ok(Val.Null) }
    let n = Val.Int(acc.n)
    let num = try arith(&"-", &(try arith(&"*", &n, &acc.sumsq)), &(try arith(&"*", &acc.sum, &acc.sum)))
    let den = Val.Int(if pop { acc.n * acc.n } else { acc.n * (acc.n - 1) })
    let vr = try arith(&"/", &(try numOf(&num, &f)), &(try numOf(&den, &f)))
    if f == "variance" || f == "var_samp" || f == "var_pop" { return Ok(vr) }
    return sqrtNum(&vr)
}

// A grouped query's output may use a column only inside an aggregate, as
// part of a GROUP BY expression, or from a table whose whole primary key
// is grouped (its other columns follow from it).
fn checkGrouped(x: &Expr, gtexts: &[]str, okLevels: &[]bool, q: &Query): Result[Unit, DbErr] {
    let t = lexdb_sql.exprText(x)
    for g in gtexts { if g == t { return Ok(Unit{}) } }
    match x {
        Expr.Col(n) {
            let i = colIndex(&q.cols, &n)
            if i < 0 { return Ok(Unit{}) }      // an output column's alias (ORDER BY)
            let l = q.levelOf(&n)
            if l >= 0 && okLevels[l] { return Ok(Unit{}) }
            return Err(e("42803", "column \"" + n + "\" must appear in the GROUP BY clause or be used in an aggregate function"))
        }
        Expr.Call(name, args, _) {
            if name == "#agg" { return Ok(Unit{}) }
            for a in args { try checkGrouped(&a, gtexts, okLevels, q) }
        }
        Expr.Unary(_, a) { try checkGrouped(&a, gtexts, okLevels, q) }
        Expr.Bin(_, a, b) {
            try checkGrouped(&a, gtexts, okLevels, q)
            try checkGrouped(&b, gtexts, okLevels, q)
        }
        Expr.IsNull(a, _) { try checkGrouped(&a, gtexts, okLevels, q) }
        Expr.Cast(a, _) { try checkGrouped(&a, gtexts, okLevels, q) }
        else {}
    }
    return Ok(Unit{})
}

// GROUP BY: an input column or expression; else an output column's
// position or name, meaning its expression.
fn resolveGroup(g: &Expr, cols: &[]lexdb_sql.ColDef, outs: &[]OutCol, exprs: &[]Expr, sc: mut &Scope): Result[Expr, DbErr] {
    match g {
        Expr.Lit(v) {
            match v {
                Val.Int(n) {
                    if n < 1 || n > len(exprs) { return Err(e("42P10", "GROUP BY position " + n.toStr() + " is not in select list")) }
                    return Ok(clone(&exprs[n - 1]))
                }
                else {}
            }
        }
        Expr.Col(n) {
            match resolveName(cols, len(cols), &n) {
                Ok(r) { return Ok(Expr.Col(r)) }
                Err(x) {
                    for i in 0..len(outs) { if outs[i].name == n { return Ok(clone(&exprs[i])) } }
                    return Err(x)
                }
            }
        }
        else {}
    }
    return resolve(g, cols, len(cols), sc)
}

fn valsKey(vs: &[]Val): str {
    var kb = newStrBuf()
    for v in vs { encIdxPart(mut &kb, &v) }
    return kb.toStr()
}

// A SELECT, planned: its query, its output, and how its order is had.
type Sel = record {
    q: Query
    exprs: []Expr
    outs: []OutCol
    groupBy: []Expr
    order: []Expr
    aggQ: bool
    sort: bool              // ORDER BY sorts; false: the scan gives the order
    first: int              // MIN or MAX served by the scan's order: stop at the first non-NULL value of this column
    limit: int
    offset: int
    having: Option[Expr]
    specs: []AggSpec        // the aggregate calls; exprs, having and order use their slots
    distinct: bool
    desc: []bool            // per ORDER BY item
    nullsFirst: []bool      // ... NULLs first
    parts: []Sel            // UNION, INTERSECT, EXCEPT: its two queries (q has no tables, refs theirs)
    setop: int
    setAll: bool
    split: int              // refs: the first query's, then the second's
    rec: int                // a recursive CTE: its number; -1
    srf: str                // a function in FROM: its name; exprs are its arguments, outs its columns (9.27)
    ordin: bool             // ... WITH ORDINALITY
    wins: []WinPlan         // its window calls (9.46): exprs and order read their values from slots nAggs + i
    nAggs: int
}

// The column of level 0 an expression is, else -1.
fn (q: &Query) firstCol(x: &Expr): int {
    match x {
        Expr.Col(n) {
            if q.levelOf(&n) == 0 { return colIndex(&q.cols, &n) }
        }
        else {}
    }
    return -1
}

// The columns of the first table an ORDER BY sorts by, all one way: the
// direction (0 up, 1 down), or -1 when it sorts by anything else.
fn orderCols(q: &Query, order: &[]Expr, items: &[]lexdb_sql.OrderItem, exprs: &[]Expr, outs: &[]OutCol,
             cols: mut &[]int): int {
    if len(order) == 0 || len(q.levels) == 0 { return -1 }
    for i in 0..len(order) {
        if items[i].desc != items[0].desc { return -1 }
        if items[i].nullsFirst != items[i].desc { return -1 }    // NULLs where an index does not keep them
        var c = q.firstCol(&order[i])
        match order[i] {
            Expr.Lit(v) {
                match v {
                    Val.Int(n) { if n >= 1 && n <= len(exprs) { c = q.firstCol(&exprs[n - 1]) } }
                    else {}
                }
            }
            Expr.Col(n) {
                if c < 0 {
                    for j in 0..len(outs) { if outs[j].name == n { c = q.firstCol(&exprs[j]) } }
                }
            }
            else {}
        }
        if c < 0 { return -1 }
        append(cols, c)
    }
    return if items[0].desc { 1 } else { 0 }
}

// Whether a path of the first table gives its rows in the order of cols:
// they follow its key (an index's key ends with the primary key) after its
// equalities, skipping columns held equal.
fn servesOrder(t: &Table, p: &Path, cols: &[]int): bool {
    if p.inSub >= 0 { return false }        // past IN_LOOKUP_MAX it reads in primary key order
    var key = keyCols(t, p.index)
    if p.index >= 0 { for c in t.pk { append(mut &key, c) } }
    if p.index < 0 && len(p.eqs) == len(t.pk) { return true }     // one row
    var j = len(p.eqs)
    for c in cols {
        if j < len(key) && key[j] == c {
            j += 1
            continue
        }
        var held = false
        for x in 0..len(p.eqs) { if key[x] == c { held = true } }
        if !held { return false }
    }
    return true
}

// A full scan of the primary key or an index that gives the order, if one does.
fn orderedScan(q: &Query, cols: &[]int, params: &[]Val): Option[int] {
    let t = &q.levels[0].t
    for c0 in 0..len(t.indexes) + 1 {
        if !q.usable(0, c0 - 1, &q.levels[0].cond, params) { continue }
        let p = Path{index: c0 - 1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []}
        if servesOrder(t, &p, cols) { return Some(c0 - 1) }
    }
    return None
}

// The column of the first table every output is MIN (0) or MAX (1) of, else -1.
fn minMax(q: &Query, exprs: &[]Expr, dir: mut &int): int {
    var col = -1
    var fname = ""
    for x in exprs {
        match x {
            Expr.Call(n, args, star) {
                if (n != "min" && n != "max") || star || len(args) != 1 { return -1 }
                let c = q.firstCol(&args[0])
                if c < 0 || (col >= 0 && (c != col || n != fname)) { return -1 }
                col = c
                fname = n
            }
            else { return -1 }
        }
    }
    dir = if fname == "max" { 1 } else { 0 }
    return col
}

// The columns a statement names, without their tables, in any of its
// parts and subqueries; star: a * anywhere in it.
fn stmtNames(s: &lexdb_sql.Stmt, names: mut &Map[str, int], star: mut &bool) {
    var xs: []str = []
    for it in s.items {
        if it.star { star = true }
        match it.expr { Some(x) { colNames(&x, mut &xs) } None {} }
    }
    match s.where { Some(x) { colNames(&x, mut &xs) } None {} }
    match s.having { Some(x) { colNames(&x, mut &xs) } None {} }
    match s.limit { Some(x) { colNames(&x, mut &xs) } None {} }
    match s.offset { Some(x) { colNames(&x, mut &xs) } None {} }
    for g in s.group { colNames(&g, mut &xs) }
    for o in s.order { colNames(&o.expr, mut &xs) }
    for f in s.from { match f.on { Some(x) { colNames(&x, mut &xs) } None {} } }
    for r in s.rows { for x in r { colNames(&x, mut &xs) } }
    for si in s.sets { colNames(&si.expr, mut &xs) }
    for w in s.wins { winNames(&w, mut &xs) }
    for nw in s.windows { winNames(&nw.def, mut &xs) }
    for x in xs { names.put(colPart(&x), 1) }
    for b in s.subs { stmtNames(&b, names, star) }
    for b in s.inner { stmtNames(&b, names, star) }
}

// A SELECT reads of its tables only the columns it names (9.31): its
// results depend on nothing else. (UPDATE and DELETE write rows back
// whole; they are not planned here.)
fn narrow(q: mut &Query, s: &lexdb_sql.Stmt) {
    var names: Map[str, int] = newMap()
    var star = false
    stmtNames(s, mut &names, mut &star)
    if star { return }
    for k in 0..len(q.levels) {
        if q.levels[k].virt() { continue }
        var need: []bool = []
        for c in q.levels[k].t.cols { append(mut &need, names.has(&c.name)) }
        q.levels[k].need = need
    }
}

fn planSelect(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val,
              sc: mut &Scope): Result[Sel, DbErr] {
    if s.rec && s.setop != lexdb_sql.SET_UNION {
        return Err(e("42P19", "recursive query does not have the form non-recursive-term UNION [ALL] recursive-term"))
    }
    if s.setop != 0 { return planSet(st, txn, s, params, sc) }
    var q = try buildQuery(st, txn, &s.from, &s.where, params, &s.subs, sc)
    if s.kind == lexdb_sql.S_SELECT { narrow(mut &q, s) }
    var exprs: []Expr = []
    let outs = try selectCols(s, &q.cols, sc, mut &exprs)
    var groupBy: []Expr = []
    for g in s.group {
        let r = try resolveGroup(&g, &q.cols, &outs, &exprs, sc)
        if hasAgg(&r) { return Err(e("42803", "aggregate functions are not allowed in GROUP BY")) }
        append(mut &groupBy, r)
    }
    var order: []Expr = []
    for o in s.order { append(mut &order, try resolveOrder(&o.expr, &q.cols, &outs, sc)) }
    var having: Option[Expr] = None
    match s.having {
        Some(h) { having = Some(try resolve(&h, &q.cols, len(q.cols), sc)) }
        None {}
    }
    // window calls (9.46): not where rows are chosen or grouped; their
    // definitions merged with the named windows and resolved
    var wdefs: []lexdb_sql.WinDef = []
    if len(s.wins) > 0 {
        if hasWinOpt(&s.where) { return Err(e("42P20", "window functions are not allowed in WHERE")) }
        if hasWinOpt(&s.having) { return Err(e("42P20", "window functions are not allowed in HAVING")) }
        for g in groupBy { if hasWin(&g) { return Err(e("42P20", "window functions are not allowed in GROUP BY")) } }
        for f in s.from { if hasWinOpt(&f.on) { return Err(e("42P20", "window functions are not allowed in JOIN conditions")) } }
        for w in s.wins {
            let d = try mergeWin(&w, &s.windows, 0)
            var r = lexdb_sql.WinDef{call: try resolve(&d.call, &q.cols, len(q.cols), sc), ref: "", bare: false, part: [], order: [],
                                     frame: cloneFrame(&d.frame)}
            for x in d.part { append(mut &r.part, try resolve(&x, &q.cols, len(q.cols), sc)) }
            for o in d.order {
                append(mut &r.order, lexdb_sql.WinOrder{expr: try resolve(&o.expr, &q.cols, len(q.cols), sc), desc: o.desc, nullsFirst: o.nullsFirst})
            }
            var inDef = false
            for x in r.part { if hasWin(&x) { inDef = true } }
            for o in r.order { if hasWin(&o.expr) { inDef = true } }
            if inDef { return Err(e("42P20", "window functions are not allowed in window definitions")) }
            if hasWin(&r.call) { return Err(e("42P20", "window function calls cannot be nested")) }
            append(mut &wdefs, r)
        }
        var mx: []Expr = []
        for x in exprs { append(mut &mx, winMarks(&x)) }
        exprs = mx
        var mo: []Expr = []
        for x in order { append(mut &mo, winMarks(&x)) }
        order = mo
    }
    endScope(sc, mut &q)
    var aggQ = len(groupBy) > 0 || having.isSome()
    for x in exprs { if hasAgg(&x) { aggQ = true } }
    for x in order { if hasAgg(&x) { aggQ = true } }
    for d in wdefs { if winHasAgg(&d) { aggQ = true } }
    if s.distinct {
        // SELECT DISTINCT: ORDER BY may use only what it outputs
        for o in order {
            var ok = false
            match o {
                Expr.Lit(v) { match v { Val.Int(_) { ok = true } else {} } }
                Expr.Col(n) { if colIndex(&q.cols, &n) < 0 { ok = true } }
                else {}
            }
            let t = lexdb_sql.exprText(&o)
            for x in exprs { if lexdb_sql.exprText(&x) == t { ok = true } }
            if !ok { return Err(e("42P10", "for SELECT DISTINCT, ORDER BY expressions must appear in select list")) }
        }
    }
    let limit = try evalInt(&s.limit, params, "LIMIT")
    let offset = try evalInt(&s.offset, params, "OFFSET")
    var sort = len(order) > 0
    var first = -1
    // The first table's order holds through the joins, unless a RIGHT or
    // FULL JOIN adds its unmatched rows at the end.
    var keeps = len(q.levels) > 0 && !q.levels[0].virt()
    for lv in q.levels { if keepsRight(lv.join) { keeps = false } }
    var setIndex = -2               // the first table's path, changed: its index, its direction
    var setDesc = false
    var setNoNulls = false
    if keeps {
        let t = &q.levels[0].t
        let path = &q.levels[0].path
        var cols: []int = []
        var dir = -1
        var mm = -1
        if !aggQ {
            dir = orderCols(&q, &order, &s.order, &exprs, &outs, mut &cols)
        } else if len(groupBy) == 0 {
            var d = 0
            mm = minMax(&q, &exprs, mut &d)
            if mm >= 0 {
                append(mut &cols, mm)
                dir = d
            }
        }
        if dir >= 0 {
            var ix = path.index
            var use = servesOrder(t, path, &cols)
            let full = len(path.eqs) == 0 && len(path.rng) == 0 && len(path.ins) == 0 && path.inSub < 0 && len(path.inArr) == 0
            // A full scan changes to an index for its order only when that
            // saves reading everything: a LIMIT, or MIN/MAX. Else a sort is
            // cheaper than a lookup per row.
            if !use && full && (limit >= 0 || mm >= 0) {
                match orderedScan(&q, &cols, params) {
                    Some(x) {
                        ix = x
                        use = true
                    }
                    None {}
                }
            }
            if use {
                setIndex = ix
                setDesc = dir == 1
                if mm >= 0 {
                    first = mm
                    // MIN and MAX skip NULLs: an index whose next column it is need not read them
                    let key = keyCols(t, ix)
                    setNoNulls = ix >= 0 && len(path.eqs) < len(key) && key[len(path.eqs)] == mm
                } else {
                    sort = false
                }
            }
        }
    }
    if setIndex > -2 {
        q.levels[0].path.index = setIndex
        q.levels[0].path.desc = setDesc
        q.levels[0].path.noNulls = setNoNulls
    }
    // A grouped query: its aggregate calls become accumulators, and its
    // columns must be grouped.
    var specs: []AggSpec = []
    if aggQ {
        var rx: []Expr = []
        for x in exprs { append(mut &rx, try collectAggs(&x, mut &specs)) }
        exprs = rx
        var ro: []Expr = []
        for x in order { append(mut &ro, try collectAggs(&x, mut &specs)) }
        order = ro
        var rh: Option[Expr] = None
        match having {
            Some(h) { rh = Some(try collectAggs(&h, mut &specs)) }
            None {}
        }
        having = rh
        // a window's arguments, partitions and order: over the groups, their aggregates in slots
        for k in 0..len(wdefs) {
            var call = clone(&wdefs[k].call)
            match wdefs[k].call {
                Expr.Call(f, args, star) {
                    var ca: []Expr = []
                    for a in args { append(mut &ca, try collectAggs(&a, mut &specs)) }
                    call = Expr.Call(f, ca, star)
                }
                else {}
            }
            wdefs[k].call = call
            var wp: []Expr = []
            for x in wdefs[k].part { append(mut &wp, try collectAggs(&x, mut &specs)) }
            wdefs[k].part = wp
            for j in 0..len(wdefs[k].order) { wdefs[k].order[j].expr = try collectAggs(&wdefs[k].order[j].expr, mut &specs) }
        }
        var gtexts: []str = []
        for g in groupBy { append(mut &gtexts, lexdb_sql.exprText(&g)) }
        var okLevels: []bool = []
        for lv in q.levels {
            var all = true
            for c in lv.t.pk {
                let name = lv.alias + "." + lv.t.cols[c].name
                var found = false
                for g in groupBy {
                    match g {
                        Expr.Col(n) { if n == name { found = true } }
                        else {}
                    }
                }
                if !found { all = false }
            }
            append(mut &okLevels, all && len(groupBy) > 0 && len(lv.t.pk) > 0)
        }
        for x in exprs { try checkGrouped(&x, &gtexts, &okLevels, &q) }
        for x in order { try checkGrouped(&x, &gtexts, &okLevels, &q) }
        match having {
            Some(h) { try checkGrouped(&h, &gtexts, &okLevels, &q) }
            None {}
        }
        for d in wdefs {
            match d.call {
                Expr.Call(_, args, _) { for a in args { try checkGrouped(&a, &gtexts, &okLevels, &q) } }
                else {}
            }
            for x in d.part { try checkGrouped(&x, &gtexts, &okLevels, &q) }
            for o in d.order { try checkGrouped(&o.expr, &gtexts, &okLevels, &q) }
        }
    }
    // the window values' slots follow the aggregates'
    let nAggs = len(specs)
    var wins: []WinPlan = []
    if len(wdefs) > 0 {
        var wx: []Expr = []
        for x in exprs { append(mut &wx, winSlots(&x, nAggs)) }
        exprs = wx
        var wo: []Expr = []
        for x in order { append(mut &wo, winSlots(&x, nAggs)) }
        order = wo
        for d in wdefs { append(mut &wins, try winPlan(&d)) }
    }
    var desc: []bool = []
    var nullsFirst: []bool = []
    for o in s.order {
        append(mut &desc, o.desc)
        append(mut &nullsFirst, o.nullsFirst)
    }
    return Ok(Sel{q: q, exprs: exprs, outs: outs, groupBy: groupBy, order: order, aggQ: aggQ, sort: sort,
                  first: first, limit: limit, offset: offset, having: having, specs: specs, distinct: s.distinct, desc: desc, nullsFirst: nullsFirst,
                  parts: [], setop: 0, setAll: false, split: 0, rec: -1, srf: s.srf, ordin: s.ordin, wins: wins, nAggs: nAggs})
}

// UNION, INTERSECT, EXCEPT: its two queries, planned on their own; the
// whole has their output (the first's names), ORDER BY over that output,
// LIMIT and OFFSET. A recursive CTE's second query reads the working table,
// with the first's columns.
fn planSet(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val,
           sc: mut &Scope): Result[Sel, DbErr] {
    if len(s.wins) > 0 { return Err(e("0A000", "lexdb: window functions in the ORDER BY of a UNION, INTERSECT or EXCEPT are not supported")) }
    let l = try planSelect(st, txn, &s.inner[0], params, sc)
    if s.rec {
        var cols: []lexdb_sql.ColDef = []
        for o in l.outs { append(mut &cols, lexdb_sql.colDef(o.name, oidType(o.oid), false)) }
        append(mut &sc.works, Work{id: s.cte, cols: cols})
    }
    let rr = planSelect(st, txn, &s.inner[1], params, sc)
    if s.rec { let w = pop(mut &sc.works) }
    let r = try rr
    let what = if s.setop == lexdb_sql.SET_UNION { "UNION" } else if s.setop == lexdb_sql.SET_INTERSECT { "INTERSECT" } else { "EXCEPT" }
    if len(l.outs) != len(r.outs) { return Err(e("42601", "each " + what + " query must have the same number of columns")) }
    var outs: []OutCol = []
    for o in l.outs { append(mut &outs, o) }
    var order: []Expr = []
    for o in s.order {
        var ok = false
        match o.expr {
            Expr.Lit(v) { match v { Val.Int(n) { ok = n >= 1 && n <= len(outs) } else {} } }
            Expr.Col(n) { for oc in outs { if oc.name == n { ok = true } } }
            else {}
        }
        if !ok { return Err(e("42P10", "invalid " + what + " ORDER BY clause: name or number an output column")) }
        append(mut &order, clone(&o.expr))
    }
    var desc: []bool = []
    var nullsFirst: []bool = []
    for o in s.order {
        append(mut &desc, o.desc)
        append(mut &nullsFirst, o.nullsFirst)
    }
    var refs = cloneAll(&l.q.refs)
    for x in r.q.refs { append(mut &refs, clone(&x)) }
    let split = len(l.q.refs)
    let limit = try evalInt(&s.limit, params, "LIMIT")
    let offset = try evalInt(&s.offset, params, "OFFSET")
    let q = Query{levels: [], cols: [], top: [], subs: [], base: sc.base, corr: false, refs: refs}
    return Ok(Sel{q: q, exprs: [], outs: outs, groupBy: [], order: order, aggQ: false, sort: len(order) > 0, first: -1,
                  limit: limit, offset: offset, having: None, specs: [], distinct: false, desc: desc, nullsFirst: nullsFirst, parts: [l, r],
                  setop: s.setop, setAll: s.setAll, split: split, rec: if s.rec { s.cte } else { -1 }, srf: "", ordin: false,
                  wins: [], nAggs: 0})
}

// A row's key for UNION and the like (NULLs alike; 2 = 2.0).
fn rowKey(vs: &[]Val): str {
    var kb = newStrBuf()
    for v in vs { keyPart(mut &kb, &v) }
    return kb.toStr()
}

fn distinctRows(rows: [][]Val, seen: mut &Map[str, int]): [][]Val {
    var all = rows
    var out: [][]Val = []
    for i in 0..len(all) {
        let k = rowKey(&all[i])
        if seen.get(&k).isSome() { continue }
        seen.put(k, 1)
        append(mut &out, replace(mut &all[i], []))
    }
    return out
}

fn combine(op: int, all: bool, l: [][]Val, r: [][]Val): [][]Val {
    var la = l
    var ra = r
    if op == lexdb_sql.SET_UNION {
        if all {
            for i in 0..len(ra) { append(mut &la, replace(mut &ra[i], [])) }
            return la
        }
        var seen: Map[str, int] = newMap()
        var out = distinctRows(la, mut &seen)
        let more = distinctRows(ra, mut &seen)
        var mo = more
        for i in 0..len(mo) { append(mut &out, replace(mut &mo[i], [])) }
        return out
    }
    var cnt: Map[str, int] = newMap()
    for row in ra {
        let k = rowKey(&row)
        let n = cnt.get(&k).unwrapOr(0)
        cnt.put(k, n + 1)
    }
    var out: [][]Val = []
    var done: Map[str, int] = newMap()
    for i in 0..len(la) {
        let k = rowKey(&la[i])
        let n = cnt.get(&k).unwrapOr(0)
        if op == lexdb_sql.SET_INTERSECT {
            if n > 0 {
                append(mut &out, replace(mut &la[i], []))
                cnt.put(k, if all { n - 1 } else { 0 })
            }
        } else if all {
            if n > 0 { cnt.put(k, n - 1) } else { append(mut &out, replace(mut &la[i], [])) }
        } else if n == 0 && done.get(&k).isNone() {
            done.put(k, 1)
            append(mut &out, replace(mut &la[i], []))
        }
    }
    return out
}

// The rows of a UNION, INTERSECT or EXCEPT: each query with the statement's
// parameters and its own refs.
fn runSet(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val,
          rs: mut &Run): Result[[][]Val, DbErr] {
    let base = sel.q.base
    var lp: []Val = []
    var rp: []Val = []
    for j in 0..base {
        append(mut &lp, params[j])
        append(mut &rp, params[j])
    }
    for j in base..base + sel.split { append(mut &lp, params[j]) }
    for j in base + sel.split..len(params) { append(mut &rp, params[j]) }
    if sel.rec >= 0 { return runRecursive(st, txn, sel, &lp, &rp, rs) }
    var lres = try runChild(st, txn, &sel.parts[0], &lp, -1, rs, 0)
    try rs.hold(rowsBytes(&lres.rows))
    var rres = try runChild(st, txn, &sel.parts[1], &rp, -1, rs, 1)
    try rs.hold(rowsBytes(&rres.rows))
    return Ok(combine(sel.setop, sel.setAll, replace(mut &lres.rows, []), replace(mut &rres.rows, [])))
}

// A recursive CTE: the first query's rows, then rounds of the second over
// the rows the last round added (the working table) until a round adds
// none; with UNION (not ALL), rows seen before are not added.
fn runRecursive(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, lp: &[]Val, rp: &[]Val,
                rs: mut &Run): Result[[][]Val, DbErr] {
    let key = "w" + sel.rec.toStr()
    var seen: Map[str, int] = newMap()
    var lres = try runChild(st, txn, &sel.parts[0], lp, -1, rs, 0)
    var work = replace(mut &lres.rows, [])
    if !sel.setAll { work = distinctRows(work, mut &seen) }
    var out: [][]Val = []
    // max_recursion: rounds that add rows (the last round, adding none, is free)
    var rounds = 0
    while len(work) > 0 {
        try rs.tick()
        try rs.hold(rowsBytes(&work) * 2)       // kept in the result and as the working table
        for r in work { append(mut &out, copyRow(&r)) }
        cachePut(mut &rs.cache, key, work)
        var rres = try runChild(st, txn, &sel.parts[1], rp, -1, rs, 1)
        work = replace(mut &rres.rows, [])
        if !sel.setAll { work = distinctRows(work, mut &seen) }
        rounds += 1
        if rs.maxRounds > 0 && rounds > rs.maxRounds && len(work) > 0 {
            return Err(e("54001", "recursive query still adding rows after " + rs.maxRounds.toStr() +
                         " rounds (max_recursion); SET max_recursion = n to allow more, 0 for no limit"))
        }
    }
    return Ok(out)
}

// EXPLAIN's lines for a planned SELECT.
fn selLines(sel: &Sel, cnt: &[]Counts, stats: &[]SubStat): []str {
    if sel.setop != 0 { return setLines(sel, stats) }
    var lines = explainLines(&sel.q, cnt)
    if len(sel.srf) > 0 { append(mut &lines, "function " + sel.srf + (if sel.ordin { " with ordinality" } else { "" })) }
    else if len(sel.q.levels) == 0 { append(mut &lines, "result") }
    if sel.first >= 0 { append(mut &lines, "min/max: the first value in the scan's order") }
    if len(sel.groupBy) > 0 || (sel.aggQ && sel.first < 0) { append(mut &lines, "aggregate") }
    if sel.having.isSome() { append(mut &lines, "having") }
    if sel.distinct { append(mut &lines, "distinct") }
    if len(sel.order) > 0 { append(mut &lines, if sel.sort { "order: sort" } else { "order: the scan's" }) }
    if sel.limit >= 0 && !sel.aggQ && !sel.sort { append(mut &lines, "limit: stops the scan") }
    subLines(&sel.q, stats, mut &lines)
    return lines
}

fn setLines(sel: &Sel, stats: &[]SubStat): []str {
    var lines: []str = []
    let op = if sel.setop == lexdb_sql.SET_UNION { "union" } else if sel.setop == lexdb_sql.SET_INTERSECT { "intersect" } else { "except" }
    append(mut &lines, (if sel.rec >= 0 { "recursive " } else { "" }) + op + (if sel.setAll { " all" } else { "" }))
    let none: []Counts = []
    let noStats: []SubStat = []
    for i in 0..len(sel.parts) {
        var head = if sel.rec >= 0 { if i == 0 { "first" } else { "then, per round, over the working table" } } else { "query " + (i + 1).toStr() }
        var inner: []str = []
        if i < len(stats) {
            head = head + " (runs " + stats[i].runs.toStr() + ")"
            inner = selLines(&sel.parts[i], &stats[i].cnt, &stats[i].inner)
        } else {
            inner = selLines(&sel.parts[i], &none, &noStats)
        }
        append(mut &lines, "  " + head + ":")
        for l in inner { append(mut &lines, "    " + l) }
    }
    if len(sel.order) > 0 { append(mut &lines, "order: sort") }
    return lines
}

// A SELECT; with analyze, plan gets EXPLAIN ANALYZE's lines (a line per
// table, with what it did). The counts are kept for every query: an add each.
fn selectWith(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
              lim: Limits, analyze: bool, plan: mut &[]str): Result[Res, DbErr] {
    var sc = newScope(params, ptypes)
    let sel = try planSelect(st, txn, s, params, mut &sc)
    var rs = newRun(&sel.q)
    rs.limit(&lim)
    let res = try execSel(st, txn, &sel, params, -1, mut &rs)
    if analyze {
        let lines = selLines(&sel, &rs.cnt, &rs.stats)
        for l in lines { append(plan, l) }
    }
    return Ok(res)
}

// An ORDER BY value, running its correlated subqueries.
fn orderX(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, o: &Expr, outs: &[]OutCol, vals: &[]Val,
          env: &Env, rs: mut &Run): Result[Val, DbErr] {
    if q.corr && hasCorr(o) { return evalX(st, txn, q, o, env, rs) }
    return orderValue(o, outs, vals, env)
}

// How ORDER BY places rows with sort values a and b: negative a first.
fn ordCmp(sel: &Sel, a: &[]Val, b: &[]Val): int {
    for i in 0..len(sel.desc) {
        let na = isNull(&a[i])
        let nb = isNull(&b[i])
        if na && nb { continue }
        if na { return if sel.nullsFirst[i] { -1 } else { 1 } }
        if nb { return if sel.nullsFirst[i] { 1 } else { -1 } }
        var c = sortCmp(&a[i], &b[i])
        if sel.desc[i] { c = -c }
        if c != 0 { return c }
    }
    return 0
}

// Top-N (9.52): rows sorted and cut to the first k, in the order the full
// sort gives (sortBy is stable, and the rows kept came before those added
// after them). The last one's sort values, for the rows to come.
fn keepFirst(sel: &Sel, rows: mut &[]OutRow, k: int): []Val {
    collections.sortBy(rows, fn(a: &OutRow, b: &OutRow): int { return ordCmp(sel, &a.ord, &b.ord) })
    while len(rows) > k { let gone = pop(rows) }
    return copyRow(&rows[len(rows) - 1].ord)
}

// Runs a planned SELECT. cap >= 0: at most that many rows are wanted (a
// subquery: EXISTS 1, in any order; a scalar 2).
fn execSel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int,
           rs: mut &Run): Result[Res, DbErr] {
    let sqe = seqEnv(st, txn)
    if len(sel.srf) > 0 { return execSrf(st, txn, sel, params, cap, rs) }
    let m = try prepare(st, txn, &sel.q, params, rs)
    let q = &sel.q
    let limit = if cap >= 0 && (sel.limit < 0 || cap < sel.limit) { cap } else { sel.limit }
    let offset = sel.offset
    let sorting = sel.sort && cap != 1
    // correlated subqueries in the output run after the scan, from its rows kept
    var late = false
    if q.corr && !sel.aggQ {
        for x in sel.exprs { if hasCorr(&x) { late = true } }
        if sorting { for x in sel.order { if hasCorr(&x) { late = true } } }
    }
    // with window calls the rows are kept first, then their values made (9.46)
    let windowed = len(sel.wins) > 0
    if windowed && !sel.aggQ { late = true }
    var bases: []WinRow = []
    var outRows: []OutRow = []
    // the rows kept here, counted in the row callbacks (they cannot reach rs)
    let room = rs.room()
    var held = 0
    if sel.setop != 0 {
        var rows = try runSet(st, txn, sel, params, rs)
        let noCols: []lexdb_sql.ColDef = []
        for i in 0..len(rows) {
            let vals = replace(mut &rows[i], [])
            var ord: []Val = []
            if sorting {
                let none: []Val = []
                let env = Env{cols: &noCols, row: &vals, aggs: &none, params: params, subs: &m.subs, cur: &none, seq: sqe}
                for o in sel.order { append(mut &ord, try orderValue(&o, &sel.outs, &vals, &env)) }
            }
            held += rowBytes(&ord)
            append(mut &outRows, OutRow{vals: vals, ord: ord})
        }
    }
    let rs0max = rs.maxHeld
    let early = !sel.aggQ && !sorting && limit >= 0 && !(late && sel.distinct) && !windowed
    let stopAt = if offset > 0 { limit + offset } else { limit }
    let noAggs: []Val = []
    var seen: Map[str, int] = newMap()      // SELECT DISTINCT
    if sel.setop != 0 {
        // done above
    } else if sel.aggQ {
        // per group: its first row (for grouped columns) and its accumulators
        var gs = Groups{index: newMap(), firsts: [], accs: []}
        // A correlated subquery in a GROUP BY key or an aggregate's argument
        // runs per row, which it cannot while the rows are read (runQuery
        // holds the run): the rows are kept, then grouped (9.24).
        let later = q.corr && groupCorr(sel)
        var kept: [][]Val = []
        // over batches of rows when the query allows (9.47), else row by row
        var batched = false
        if !later { batched = try batchGroups(st, txn, sel, &m, params, rs, mut &gs, mut &held, room, rs0max) }
        if !batched {
        try runQuery(st, txn, q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
            if sel.first >= 0 && isNull(&r[sel.first]) { return Ok(true) }
            if later {
                held += rowBytes(r)
                if room >= 0 && held > room { return Err(memErr(rs0max)) }
                append(mut &kept, copyRow(r))
                return Ok(sel.first < 0)
            }
            let env = Env{cols: &q.cols, row: r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            try addToGroup(sel, mut &gs, r, &env, mut &held, room, rs0max)
            return Ok(sel.first < 0)        // MIN/MAX in order: its first value is the answer
        }, rs)
        }
        for r in kept {
            let env = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            var cur: []Val = array(len(q.subs), Val.Null)
            for x in sel.groupBy { try fillCur(st, txn, q, &x, &env, rs, mut &cur) }
            for sp in sel.specs {
                for a in sp.args { try fillCur(st, txn, q, &a, &env, rs, mut &cur) }
                for o in sp.order { try fillCur(st, txn, q, &o, &env, rs, mut &cur) }
                match sp.filter {
                    Some(f) { try fillCur(st, txn, q, &f, &env, rs, mut &cur) }
                    None {}
                }
            }
            let env2 = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &cur, seq: sqe}
            try addToGroup(sel, mut &gs, &r, &env2, mut &held, room, rs0max)
        }
        var firsts = replace(mut &gs.firsts, [])
        var accs = replace(mut &gs.accs, [])
        if len(firsts) == 0 && len(sel.groupBy) == 0 {
            append(mut &firsts, [])         // no rows, no GROUP BY: one group, empty
            append(mut &accs, newAccs(len(sel.specs)))
        }
        for gi in 0..len(firsts) {
            var vals: []Val = []
            for i in 0..len(sel.specs) { append(mut &vals, try finish(&sel.specs[i], &accs[gi][i])) }
            let env = Env{cols: &q.cols, row: &firsts[gi], aggs: &vals, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            match sel.having {
                Some(h) { if truth(&(try evalX(st, txn, q, &h, &env, rs))) != Some(true) { continue } }
                None {}
            }
            if windowed {
                append(mut &bases, WinRow{row: copyRow(&firsts[gi]), aggs: copyRow(&vals)})
                continue
            }
            var out: []Val = []
            for x in sel.exprs { append(mut &out, try evalX(st, txn, q, &x, &env, rs)) }
            if sel.distinct {
                let k = valsKey(&out)
                if seen.get(&k).isSome() { continue }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for o in sel.order { append(mut &ord, try orderX(st, txn, q, &o, &sel.outs, &out, &env, rs)) } }
            held += rowBytes(&out) + rowBytes(&ord)
            append(mut &outRows, OutRow{vals: out, ord: ord})
        }
    } else if late {
        var raws: [][]Val = []
        try runQuery(st, txn, q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
            held += rowBytes(r)
            if room >= 0 && held > room { return Err(memErr(rs0max)) }
            append(mut &raws, copyRow(r))
            return Ok(!early || len(raws) < stopAt)
        }, rs)
        if windowed {
            for i in 0..len(raws) { append(mut &bases, WinRow{row: replace(mut &raws[i], []), aggs: []}) }
        }
        for r in raws {
            if windowed { break }
            let env = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            var vals: []Val = []
            for x in sel.exprs { append(mut &vals, try evalX(st, txn, q, &x, &env, rs)) }
            if sel.distinct {
                let k = valsKey(&vals)
                if seen.get(&k).isSome() { continue }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for o in sel.order { append(mut &ord, try orderX(st, txn, q, &o, &sel.outs, &vals, &env, rs)) } }
            held += rowBytes(&vals) + rowBytes(&ord)
            append(mut &outRows, OutRow{vals: vals, ord: ord})
        }
    } else {
        // ORDER BY with LIMIT: only the first limit + offset rows are kept
        // (top-N); a row that sorts after the last of them is dropped
        let topK = if sorting && limit >= 0 && !sel.distinct { limit + max(offset, 0) } else { -1 }
        var bar: []Val = []                 // the last kept row's sort values, once cut
        var barSet = false
        try runQuery(st, txn, q, &m, params, fn(r: &[]Val): Result[bool, DbErr] {
            let env = Env{cols: &q.cols, row: r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            var vals: []Val = []
            for x in sel.exprs { append(mut &vals, try eval(&x, &env)) }
            if sel.distinct {
                let k = valsKey(&vals)
                if seen.get(&k).isSome() { return Ok(true) }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for o in sel.order { append(mut &ord, try orderValue(&o, &sel.outs, &vals, &env)) } }
            if topK >= 0 {
                if topK == 0 { return Ok(true) }
                // after the last kept, or tied with it: the full sort puts it after
                if barSet && ordCmp(sel, &ord, &bar) >= 0 { return Ok(true) }
            }
            held += rowBytes(&vals) + rowBytes(&ord)
            if room >= 0 && held > room { return Err(memErr(rs0max)) }
            append(mut &outRows, OutRow{vals: vals, ord: ord})
            if topK > 0 && len(outRows) >= 2 * topK + 16 {
                bar = keepFirst(sel, mut &outRows, topK)
                barSet = true
                held = 0
                for o in outRows { held += rowBytes(&o.vals) + rowBytes(&o.ord) }
            }
            return Ok(!early || len(outRows) < stopAt)
        }, rs)
    }
    if windowed {
        var wv = try winValues(st, txn, sel, &bases, &m, params, rs)
        for bi in 0..len(bases) {
            // the slots: the row's aggregates, then its window values
            var aggs = if len(bases[bi].aggs) == 0 { replace(mut &wv[bi], []) } else { copyRow(&bases[bi].aggs) }
            if len(bases[bi].aggs) > 0 { for v in wv[bi] { append(mut &aggs, v) } }
            let env = Env{cols: &q.cols, row: &bases[bi].row, aggs: &aggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            var vals: []Val = []
            for x in sel.exprs { append(mut &vals, try evalX(st, txn, q, &x, &env, rs)) }
            if sel.distinct {
                let k = valsKey(&vals)
                if seen.get(&k).isSome() { continue }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for o in sel.order { append(mut &ord, try orderX(st, txn, q, &o, &sel.outs, &vals, &env, rs)) } }
            held += rowBytes(&vals) + rowBytes(&ord)
            append(mut &outRows, OutRow{vals: vals, ord: ord})
        }
    }
    try rs.hold(held)
    if hasSrfCall(&sel.exprs) { try expandSrfs(mut &outRows, &sel.outs) }
    if sorting { collections.sortBy(mut &outRows, fn(a: &OutRow, b: &OutRow): int { return ordCmp(sel, &a.ord, &b.ord) }) }
    var outs: []OutCol = []
    for oc in sel.outs { append(mut &outs, oc) }
    var res = Res{cols: outs, rows: [], tag: "", hasRows: true, copy: COPY_NONE}
    var i = 0
    for r in outRows {
        if i >= offset || offset < 0 {
            if limit >= 0 && len(res.rows) >= limit { break }
            var vs: []Val = []
            for v in r.vals { append(mut &vs, v) }
            append(mut &res.rows, vs)
        }
        i += 1
    }
    res.tag = "SELECT " + len(res.rows).toStr()
    return Ok(res)
}

// ---- describing a statement before it runs (the extended protocol)

// The parameter types of a statement: the client's, else what the
// statement compares or assigns them to, else text.
fn paramTypes(st: &lexdb_store.Store, s: &lexdb_sql.Stmt, given: &[]int, path: &[]str): []int {
    var out: []int = []
    for i in 0..s.params { append(mut &out, if i < len(given) { given[i] } else { 0 }) }
    stmtCasts(s, mut &out)              // $1::int[]: the cast's type
    if s.kind == lexdb_sql.S_EXPLAIN && len(s.inner) > 0 {
        guessParams(st, &s.inner[0], mut &out, path)
    } else {
        guessParams(st, s, mut &out, path)
    }
    for i in 0..len(out) { if out[i] == 0 { out[i] = lexdb_sql.OID_TEXT } }
    return out
}

// A parameter cast where it is used ($1::int[]) is of the cast's type.
fn castParams(x: &Expr, out: mut &[]int) {
    match x {
        Expr.Cast(a, t) {
            setParam(&a, t.oid, out)
            castParams(&a, out)
        }
        Expr.Unary(_, a) { castParams(&a, out) }
        Expr.Bin(_, a, b) {
            castParams(&a, out)
            castParams(&b, out)
        }
        Expr.IsNull(a, _) { castParams(&a, out) }
        Expr.Call(_, args, _) { for a in args { castParams(&a, out) } }
        else {}
    }
}

fn optCasts(x: &Option[Expr], out: mut &[]int) {
    match x {
        Some(v) { castParams(&v, out) }
        None {}
    }
}

fn stmtCasts(s: &lexdb_sql.Stmt, out: mut &[]int) {
    for it in s.items { optCasts(&it.expr, out) }
    for r in s.rows { for x in r { castParams(&x, out) } }
    for si in s.sets { castParams(&si.expr, out) }
    for g in s.group { castParams(&g, out) }
    for o in s.order { castParams(&o.expr, out) }
    optCasts(&s.where, out)
    optCasts(&s.having, out)
    optCasts(&s.limit, out)
    optCasts(&s.offset, out)
    for f in s.from { optCasts(&f.on, out) }
    for b in s.subs { stmtCasts(&b, out) }
    for b in s.inner { stmtCasts(&b, out) }
}

fn setParam(x: &Expr, oid: int, out: mut &[]int) {
    match x {
        Expr.Param(n) { if n <= len(out) && out[n - 1] == 0 { out[n - 1] = oid } }
        else {}
    }
}

fn guessParams(st: &lexdb_store.Store, s: &lexdb_sql.Stmt, out: mut &[]int, path: &[]str) {
    if s.kind == lexdb_sql.S_INSERT && len(s.inner) > 0 { guessParams(st, &s.inner[0], out, path) }
    if s.setop != 0 {
        for b in s.inner { guessParams(st, &b, out, path) }
        return
    }
    var txn = lexdb_store.begin()
    for x in path { append(mut &txn.path, x) }
    match findTable(st, mut &txn, &s.table) {
        Ok(found) {
            match found {
                Some(tb) {
                    if s.kind == lexdb_sql.S_INSERT {
                        for r in s.rows {
                            for k in 0..len(r) {
                                let ci = if len(s.names) == 0 { k } else { colIndex(&tb.cols, &s.names[k]) }
                                if ci >= 0 && ci < len(tb.cols) { setParam(&r[k], tb.cols[ci].typ.oid, out) }
                            }
                        }
                    }
                    for si in s.sets {
                        let ci = colIndex(&tb.cols, &si.col)
                        if ci >= 0 { setParam(&si.expr, tb.cols[ci].typ.oid, out) }
                    }
                }
                None {}
            }
        }
        Err(_) {}
    }
    if s.kind != lexdb_sql.S_SELECT && s.kind != lexdb_sql.S_UPDATE && s.kind != lexdb_sql.S_DELETE { return }
    let np: []Val = array(len(out), Val.Null)
    let noTypes: []int = []
    var sc = newScope(&np, &noTypes)
    let built = if s.kind == lexdb_sql.S_SELECT { buildQuery(st, mut &txn, &s.from, &s.where, &np, &s.subs, mut &sc) } else {
        buildQuery(st, mut &txn, &oneTable(&s.table), &s.where, &np, &s.subs, mut &sc)
    }
    match built {
        Ok(q) { comparedIn(&q, out) }
        Err(_) {}
    }
}

fn comparedIn(q: &Query, out: mut &[]int) {
    for lv in q.levels {
        for c in lv.cond { compared(&c, q, out) }
        for c in lv.post { compared(&c, q, out) }
    }
    for sp in q.subs { comparedIn(&sp.sel.q, out) }
}

// A parameter compared with a column takes the column's type; in col op
// ANY ($1), an array of it.
fn compared(c: &Expr, q: &Query, out: mut &[]int) {
    match c {
        Expr.Call(n, args, _) {
            if lexdb_sql.isQuant(&n) && len(args) == 2 {
                match args[0] {
                    Expr.Col(x) {
                        let i = colIndex(&q.cols, &x)
                        if i >= 0 && lexdb_sql.arrayOid(q.cols[i].typ.oid) > 0 { setParam(&args[1], lexdb_sql.arrayOid(q.cols[i].typ.oid), out) }
                    }
                    else {}
                }
            }
        }
        Expr.Bin(op, a, b) {
            if op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                match a {
                    Expr.Col(n) {
                        let i = colIndex(&q.cols, &n)
                        if i >= 0 { setParam(&b, q.cols[i].typ.oid, out) }
                    }
                    else {}
                }
                match b {
                    Expr.Col(n) {
                        let i = colIndex(&q.cols, &n)
                        if i >= 0 { setParam(&a, q.cols[i].typ.oid, out) }
                    }
                    else {}
                }
            }
        }
        else {}
    }
}

// Whether a statement returns rows (so Describe has columns for it).
pub fn returnsRows(s: &lexdb_sql.Stmt): bool {
    let k = s.kind
    if k == lexdb_sql.S_SELECT || k == lexdb_sql.S_SHOW || k == lexdb_sql.S_EXPLAIN { return true }
    return (k == lexdb_sql.S_INSERT || k == lexdb_sql.S_UPDATE || k == lexdb_sql.S_DELETE) && len(s.items) > 0
}

// The columns a statement returns (none unless it is a SELECT, EXPLAIN,
// SHOW, or has RETURNING).
fn describe(st: &lexdb_store.Store, s: &lexdb_sql.Stmt, ptypes: &[]int, path: &[]str): Result[[]OutCol, DbErr] {
    if s.kind == lexdb_sql.S_EXPLAIN { return Ok([OutCol{name: "QUERY PLAN", oid: lexdb_sql.OID_TEXT}]) }
    if s.kind == lexdb_sql.S_SHOW { return Ok(showCols(&s.table)) }
    let dml = s.kind == lexdb_sql.S_INSERT || s.kind == lexdb_sql.S_UPDATE || s.kind == lexdb_sql.S_DELETE
    if s.kind != lexdb_sql.S_SELECT && !(dml && len(s.items) > 0) { return Ok([]) }
    var txn = lexdb_store.begin()
    for x in path { append(mut &txn.path, x) }
    if dml {
        let none: Option[Expr] = None
        let np: []Val = array(if s.params > len(ptypes) { s.params } else { len(ptypes) }, Val.Null)
        var sc = newScope(&np, ptypes)
        let q = try buildQuery(st, mut &txn, &oneTable(&s.table), &none, &np, &s.subs, mut &sc)
        var exprs: []Expr = []
        return itemCols(&s.items, true, &q.cols, mut &sc, mut &exprs)
    }
    if s.setop != 0 {
        let np: []Val = array(if s.params > len(ptypes) { s.params } else { len(ptypes) }, Val.Null)
        var sc = newScope(&np, ptypes)
        let sel = try planSelect(st, mut &txn, s, &np, mut &sc)
        var outs: []OutCol = []
        for o in sel.outs { append(mut &outs, o) }
        return Ok(outs)
    }
    let none: Option[Expr] = None
    let np: []Val = array(if s.params > len(ptypes) { s.params } else { len(ptypes) }, Val.Null)
    var sc = newScope(&np, ptypes)
    let q = try buildQuery(st, mut &txn, &s.from, &none, &np, &s.subs, mut &sc)
    var exprs: []Expr = []
    return selectCols(s, &q.cols, mut &sc, mut &exprs)
}

// ---- sessions

pub type Session = record {
    st: lexdb_store.Store
    txn: []lexdb_store.Txn      // the open transaction block, if any
    failed: bool                // an error in the block: only ROLLBACK (or COMMIT) now
    maxRecursion: int           // SET max_recursion: a recursive CTE's rounds at most; 0 no limit
    timeoutMs: int              // SET statement_timeout: a statement's time at most; 0 no limit
    maxMem: int                 // SET max_statement_mem: the bytes of rows a statement holds at most; 0 no limit
    saved: []Limits             // in a transaction block: the settings at its BEGIN (a ROLLBACK restores them)
    readOnly: bool              // the block is BEGIN READ ONLY
    path: []str                 // SET search_path: its schemas; [] public alone (the default)
    pathAt: int                 // bumped when the path changes (the wire's kept descriptions)
    savedPath: [][]str          // in a transaction block: the path at its BEGIN
    id: int                     // its number while the store is open (its sequences' currval: 9.43)
    batch: bool                 // SET lexdb_batch (9.47)
    saves: []SavePt             // the open block's savepoints, oldest first (9.80)
    savedRoles: []str           // in a transaction block: SET ROLE's and SET SESSION AUTHORIZATION's at its BEGIN (9.83)
}

// A savepoint: its name and the block's writes when it was made.
type SavePt = record { name: str; mark: int }

// The columns a statement returns, its names looked up along the session's
// search path.
pub fn (s: &Session) describe(stmt: &lexdb_sql.Stmt, ptypes: &[]int): Result[[]OutCol, DbErr] {
    return describe(&s.st, stmt, ptypes, &s.path)
}

// A statement's parameter types (paramTypes), along the session's path.
pub fn (s: &Session) paramTypes(stmt: &lexdb_sql.Stmt, given: &[]int): []int {
    return paramTypes(&s.st, stmt, given, &s.path)
}

// Changes when the search path does: a statement's description kept from
// before may name other tables.
pub fn (s: &Session) pathVersion(): int { return s.pathAt }

fn (s: mut &Session) setPath(names: &[]str) {
    var p: []str = []
    for n in names { append(mut &p, n) }
    if len(p) == 1 && p[0] == "public" { p = [] }
    s.path = p
    s.pathAt += 1
    if len(s.txn) > 0 {
        var q: []str = []
        for n in s.path { append(mut &q, n) }
        s.txn[0].path = q
    }
}

// SHOW's columns: the setting's name, or SHOW ALL's name and setting.
fn showCols(name: &str): []OutCol {
    if name == "all" { return [OutCol{name: "name", oid: lexdb_sql.OID_TEXT}, OutCol{name: "setting", oid: lexdb_sql.OID_TEXT}] }
    return [OutCol{name: name, oid: lexdb_sql.OID_TEXT}]
}

fn (s: &Session) setting(name: &str): Option[str] {
    match name {
        "search_path" { return Some(if len(s.path) == 0 { "public" } else { strings.join(&s.path, ", ") }) }
        "max_recursion" { return Some(s.maxRecursion.toStr()) }
        "statement_timeout" { return Some(if s.timeoutMs == 0 { "0" } else { s.timeoutMs.toStr() + "ms" }) }
        "max_statement_mem" { return Some(if s.maxMem == 0 { "0" } else { (s.maxMem / 1024).toStr() + "kB" }) }
        "transaction_isolation", "default_transaction_isolation" { return Some("serializable") }
        // PostgreSQL's that clients ask for, fixed in lexdb (9.80)
        "standard_conforming_strings", "integer_datetimes", "is_superuser" { return Some("on") }
        "transaction_read_only", "default_transaction_read_only", "in_hot_standby" { return Some("off") }
        "server_version" { return Some("16.0") }
        "server_version_num" { return Some("160000") }
        "server_encoding", "client_encoding" { return Some("UTF8") }
        "datestyle" { return Some("ISO, MDY") }
        "timezone", "log_timezone" { return Some("UTC") }
        "intervalstyle" { return Some("postgres") }
        "lc_collate", "lc_ctype", "lc_messages", "lc_monetary", "lc_numeric", "lc_time" { return Some("C") }
        "max_identifier_length" { return Some("63") }
        "application_name" { return Some("") }
        "bytea_output" { return Some("hex") }
        else { return None }
    }
}

fn (s: &Session) show(name: &str): Result[Res, DbErr] {
    var res = Res{cols: showCols(name), rows: [], tag: "SHOW", hasRows: true, copy: COPY_NONE}
    if name == "all" {
        for n in lexdb_sql.SETTINGS { append(mut &res.rows, [Val.Text(n), Val.Text(s.setting(&n).unwrap())]) }
        return Ok(res)
    }
    match s.setting(name) {
        Some(v) { append(mut &res.rows, [Val.Text(v)]) }
        None { return Err(e("42704", "unrecognized configuration parameter \"" + name + "\"")) }
    }
    return Ok(res)
}

pub fn newSession(st: lexdb_store.Store): Session {
    // LEXDB_ROWFMT=tagged: rows written in the tagged form, not the fixed
    // layout (9.50): to compare the two, and to test the tagged reader
    match os.env("LEXDB_ROWFMT") {
        Some(v) { fixedRows = v != "tagged" }
        None {}
    }
    let id = num(&st.memoGet(&"sessions").unwrapOr("0")) + 1
    st.memoPut(&"sessions", &id.toStr())
    return Session{st: st, txn: [], failed: false, maxRecursion: MAX_RECURSION, timeoutMs: 0, maxMem: MAX_STATEMENT_MEM,
                   saved: [], readOnly: false, path: [], pathAt: 0, savedPath: [], id: id, batch: true, saves: [], savedRoles: []}
}

// max_statement_mem's default.
pub const MAX_STATEMENT_MEM = 256 * 1024 * 1024

// A transaction block rolled back: its SETs with it (as PostgreSQL's).
fn (s: mut &Session) restore() {
    if len(s.savedRoles) > 0 {
        let r = pop(mut &s.savedRoles)
        let nl = strings.indexOf(&r, "\n", 0)
        s.st.memoPut(&roleKeyOf(s.id), &r[0..nl])
        s.st.memoPut(&sessAuthKey(s.id), &r[nl + 1..len(r)])
    }
    if len(s.saved) == 0 { return }
    let l = pop(mut &s.saved)
    if len(s.savedPath) > 0 {
        let p = pop(mut &s.savedPath)
        if strings.join(&p, ",") != strings.join(&s.path, ",") {
            if len(p) == 0 { s.setPath(&["public"]) } else { s.setPath(&p) }
        }
    }
    s.maxRecursion = l.rounds
    s.maxMem = l.mem
    s.timeoutMs = l.deadline                // saved there: the timeout in ms
    s.batch = l.batch
}

// The limits for a statement starting now.
fn (s: &Session) limits(): Limits {
    let dl = if s.timeoutMs > 0 { time.monotonicNs() + s.timeoutMs * 1000000 } else { 0 }
    return Limits{rounds: s.maxRecursion, mem: s.maxMem, deadline: dl, batch: s.batch}
}

// A setting's value: a number (statement_timeout in ms, max_statement_mem
// in kB, as PostgreSQL's), or a string with a unit ('5s', '64MB').
fn settingValue(name: &str, v: &Val): Result[int, DbErr] {
    let bad = e("22023", "invalid value for parameter \"" + name + "\"")
    var n = 0
    var unit = ""
    match v {
        Val.Int(i) { n = i }
        Val.Text(t) {
            var i = 0
            while i < len(t) && t[i] >= '0' && t[i] <= '9' { i += 1 }
            if i == 0 { return Err(bad) }
            n = strings.parseIntOpt(t[0..i]).unwrapOr(-1)
            unit = strings.toLowerAscii(strings.trim(t[i..len(t)]))
        }
        else { return Err(bad) }
    }
    if n < 0 { return Err(bad) }
    if name == "statement_timeout" {
        if unit == "" || unit == "ms" { return Ok(n) }
        if unit == "s" { return Ok(n * 1000) }
        if unit == "min" { return Ok(n * 60000) }
        if unit == "h" { return Ok(n * 3600000) }
        return Err(bad)
    }
    if name == "max_statement_mem" {
        if unit == "" || unit == "kb" { return Ok(n * 1024) }
        if unit == "mb" { return Ok(n * 1024 * 1024) }
        if unit == "gb" { return Ok(n * 1024 * 1024 * 1024) }
        return Err(bad)
    }
    if unit != "" { return Err(bad) }
    return Ok(n)
}

// Ends the session: an open block is rolled back (a snapshot released).
pub fn (s: mut &Session) close() {
    if len(s.txn) > 0 { s.st.abort(pop(mut &s.txn)) }
    s.failed = false
}

fn isWrite(kind: int): bool {
    return kind == lexdb_sql.S_CREATE || kind == lexdb_sql.S_DROP || kind == lexdb_sql.S_INSERT ||
           kind == lexdb_sql.S_UPDATE || kind == lexdb_sql.S_DELETE || kind == lexdb_sql.S_CREATE_INDEX ||
           kind == lexdb_sql.S_DROP_INDEX || kind == lexdb_sql.S_CREATE_SCHEMA || kind == lexdb_sql.S_DROP_SCHEMA ||
           kind == lexdb_sql.S_ALTER || kind == lexdb_sql.S_ALTER_INDEX || kind == lexdb_sql.S_ALTER_SCHEMA ||
           kind == lexdb_sql.S_CREATE_SEQ || kind == lexdb_sql.S_ALTER_SEQ || kind == lexdb_sql.S_DROP_SEQ ||
           kind == lexdb_sql.S_CREATE_ROLE || kind == lexdb_sql.S_ALTER_ROLE || kind == lexdb_sql.S_DROP_ROLE ||
           kind == lexdb_sql.S_CREATE_VIEW || kind == lexdb_sql.S_DROP_VIEW || kind == lexdb_sql.S_ALTER_VIEW ||
           kind == lexdb_sql.S_GRANT || kind == lexdb_sql.S_REVOKE || kind == lexdb_sql.S_OWNER
}

fn stmtName(kind: int): str {
    return match kind {
        lexdb_sql.S_CREATE { "CREATE TABLE" }
        lexdb_sql.S_DROP { "DROP TABLE" }
        lexdb_sql.S_INSERT { "INSERT" }
        lexdb_sql.S_UPDATE { "UPDATE" }
        lexdb_sql.S_CREATE_INDEX { "CREATE INDEX" }
        lexdb_sql.S_DROP_INDEX { "DROP INDEX" }
        lexdb_sql.S_CREATE_SCHEMA { "CREATE SCHEMA" }
        lexdb_sql.S_DROP_SCHEMA { "DROP SCHEMA" }
        lexdb_sql.S_CREATE_ROLE { "CREATE ROLE" }
        lexdb_sql.S_CREATE_VIEW { "CREATE VIEW" }
        lexdb_sql.S_GRANT { "GRANT" }
        lexdb_sql.S_REVOKE { "REVOKE" }
        lexdb_sql.S_OWNER { "ALTER" }
        lexdb_sql.S_DROP_VIEW { "DROP VIEW" }
        lexdb_sql.S_ALTER_VIEW { "ALTER VIEW" }
        lexdb_sql.S_ALTER_ROLE { "ALTER ROLE" }
        lexdb_sql.S_DROP_ROLE { "DROP ROLE" }
        lexdb_sql.S_ALTER { "ALTER TABLE" }
        lexdb_sql.S_ALTER_INDEX { "ALTER INDEX" }
        lexdb_sql.S_ALTER_SCHEMA { "ALTER SCHEMA" }
        lexdb_sql.S_CREATE_SEQ { "CREATE SEQUENCE" }
        lexdb_sql.S_ALTER_SEQ { "ALTER SEQUENCE" }
        lexdb_sql.S_DROP_SEQ { "DROP SEQUENCE" }
        lexdb_sql.S_COPY { "COPY FROM" }
        else { "DELETE" }
    }
}

// 'I' idle, 'T' in a transaction block, 'E' in a failed one.
pub fn (s: &Session) status(): byte {
    if len(s.txn) == 0 { return 'I' }
    return if s.failed { 'E' } else { 'T' }
}

fn execIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
          lim: Limits, pc: mut &PlanCache, input: &CopyInput): Result[Res, DbErr] {
    try bindSeqs(st, txn, &s.seqNames)
    // with subqueries, the outer values they use are numbered after all the
    // statement's parameters: those not sent are NULL
    let subs = hasSubs(s)
    let want = if s.params > len(ptypes) { s.params } else { len(ptypes) }
    if subs && len(params) < want {
        var ps: []Val = []
        for v in params { append(mut &ps, v) }
        while len(ps) < want { append(mut &ps, Val.Null) }
        return execStmt(st, txn, s, &ps, ptypes, lim, pc, input)
    }
    return execStmt(st, txn, s, params, ptypes, lim, pc, input)
}

fn hasSubs(s: &lexdb_sql.Stmt): bool {
    if len(s.subs) > 0 { return true }
    for x in s.inner { if hasSubs(&x) { return true } }
    return false
}

fn execStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
            lim: Limits, pc: mut &PlanCache, input: &CopyInput): Result[Res, DbErr] {
    if st.isReplica() {
        match writesOn(s) {
            Some(what) { return Err(lexdb_store.readOnly(&what)) }
            None {}
        }
    }
    if len(s.wins) > 0 && s.kind != lexdb_sql.S_SELECT {
        let what = if len(s.items) > 0 && s.kind != lexdb_sql.S_SELECT { "RETURNING" } else { stmtName(s.kind) }
        return Err(e("42P20", "window functions are not allowed in " + what))
    }
    match s.kind {
        lexdb_sql.S_CREATE { return createTable(st, txn, s) }
        lexdb_sql.S_DROP { return dropTable(st, txn, s) }
        lexdb_sql.S_INSERT { return insert(st, txn, s, params, lim) }
        lexdb_sql.S_SELECT { return select(st, txn, s, params, ptypes, lim, pc) }
        lexdb_sql.S_UPDATE { return update(st, txn, s, params, lim) }
        lexdb_sql.S_DELETE { return delete(st, txn, s, params, lim) }
        lexdb_sql.S_CREATE_INDEX { return createIndex(st, txn, s) }
        lexdb_sql.S_DROP_INDEX { return dropIndex(st, txn, s) }
        lexdb_sql.S_CREATE_SCHEMA { return createSchemaStmt(st, txn, s) }
        lexdb_sql.S_CREATE_ROLE, lexdb_sql.S_ALTER_ROLE, lexdb_sql.S_DROP_ROLE { return roleStmt(st, txn, s) }
        lexdb_sql.S_CREATE_VIEW { return createView(st, txn, s) }
        lexdb_sql.S_GRANT, lexdb_sql.S_REVOKE { return grantStmt(st, txn, s) }
        lexdb_sql.S_OWNER { return ownerStmt(st, txn, s) }
        lexdb_sql.S_DROP_VIEW { return dropView(st, txn, s) }
        lexdb_sql.S_ALTER_VIEW { return alterView(st, txn, s) }
        lexdb_sql.S_DROP_SCHEMA { return dropSchema(st, txn, s) }
        lexdb_sql.S_ALTER { return alterTable(st, txn, s, lim) }
        lexdb_sql.S_ALTER_INDEX { return alterIndex(st, txn, s) }
        lexdb_sql.S_ALTER_SCHEMA { return alterSchema(st, txn, s) }
        lexdb_sql.S_CREATE_SEQ { return createSeq(st, txn, s) }
        lexdb_sql.S_ALTER_SEQ { return alterSeq(st, txn, s) }
        lexdb_sql.S_DROP_SEQ { return dropSeq(st, txn, s) }
        lexdb_sql.S_COPY { return copyStmt(st, txn, s, params, ptypes, lim, pc, input) }
        lexdb_sql.S_EXPLAIN { return explain(st, txn, s, params, lim, ptypes) }
        else { return Err(e("XX000", "not a data statement")) }
    }
}

// What a statement would write, refused on a replica before it runs (as a
// PostgreSQL standby does): None for a query, COPY TO, and EXPLAIN without
// ANALYZE of a write. A write the statement gets to anyway (a sequence's
// nextval) fails at its commit (lexdb_store.readOnly).
fn writesOn(s: &lexdb_sql.Stmt): Option[str] {
    if s.kind == lexdb_sql.S_SELECT { return None }
    if s.kind == lexdb_sql.S_COPY { return if s.copy.from { Some("COPY FROM") } else { None } }
    if s.kind == lexdb_sql.S_EXPLAIN {
        if s.ifFlag && len(s.inner) > 0 { return writesOn(&s.inner[0]) }
        return None
    }
    return Some(stmtName(s.kind))
}

// Converts the parameters a client sent as text to values of their types.
pub fn paramVals(texts: &[]Option[str], ptypes: &[]int): Result[[]Val, DbErr] {
    var out: []Val = []
    for i in 0..len(texts) {
        match texts[i] {
            None { append(mut &out, Val.Null) }
            Some(s) {
                let oid = if i < len(ptypes) { ptypes[i] } else { lexdb_sql.OID_TEXT }
                var ty = lexdb_sql.TypeName{kind: lexdb_sql.K_TEXT, oid: lexdb_sql.OID_TEXT, prec: 0, scale: 0, len: 0}
                if oid == lexdb_sql.OID_INT8 || oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT2 {
                    ty = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
                } else if oid == lexdb_sql.OID_BOOL {
                    ty = lexdb_sql.TypeName{kind: lexdb_sql.K_BOOL, oid: oid, prec: 0, scale: 0, len: 0}
                } else if oid == lexdb_sql.OID_NUMERIC {
                    ty = lexdb_sql.TypeName{kind: lexdb_sql.K_NUM, oid: oid, prec: 0, scale: 0, len: 0}
                } else if lexdb_sql.elemOid(oid) > 0 || lexdb_sql.timeKind(oid) > 0 || oid == lexdb_sql.OID_UUID || oid == lexdb_sql.OID_BYTEA || oid == lexdb_sql.OID_FLOAT4 || oid == lexdb_sql.OID_FLOAT8 {
                    ty = oidType(oid)
                }
                append(mut &out, try coerce(Val.Text(s), &ty))
            }
        }
    }
    return Ok(out)
}

// Runs one statement: in the open transaction block, or in a transaction of
// its own that is committed at once (retried a few times on a
// serialization failure: nothing the client saw depends on the first try).
pub fn (s: mut &Session) run(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int): Result[Res, DbErr] {
    var pc = oneShot()
    return s.runCached(stmt, params, ptypes, mut &pc)
}

// run, keeping a SELECT's plan in pc for the next run of the same statement.
pub fn (s: mut &Session) runCached(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &PlanCache): Result[Res, DbErr] {
    return s.runIn(stmt, params, ptypes, pc, &noInput())
}

// COPY FROM STDIN with the client's input (after run gave COPY_IN): its
// rows inserted, as one statement.
pub fn (s: mut &Session) copyIn(stmt: &lexdb_sql.Stmt, input: CopyInput): Result[Res, DbErr] {
    var pc = oneShot()
    let none: []Val = []
    let nt: []int = []
    return s.runIn(stmt, &none, &nt, mut &pc, &input)
}

fn (s: mut &Session) runIn(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &PlanCache,
                           input: &CopyInput): Result[Res, DbErr] {
    match stmt.kind {
        lexdb_sql.S_EMPTY { return Ok(tagOnly("")) }
        lexdb_sql.S_SHOW { return s.show(&stmt.table) }
        lexdb_sql.S_SET {
            if stmt.table == "role" || stmt.table == "session_authorization" { return s.setRole(stmt) }
            if stmt.table == "search_path" {
                if stmt.ifFlag || len(stmt.names) == 0 { s.setPath(&["public"]) } else { s.setPath(&stmt.names) }
                return Ok(tagOnly(if stmt.ifFlag { "RESET" } else { "SET" }))
            }
            if stmt.table == "all" {
                if len(s.path) > 0 { s.setPath(&["public"]) }
                s.maxRecursion = MAX_RECURSION
                s.timeoutMs = 0
                s.maxMem = MAX_STATEMENT_MEM
                s.batch = true
            } else if stmt.table == "lexdb_batch" {
                var on = true                       // DEFAULT, RESET
                match stmt.limit {
                    Some(x) {
                        let noCols: []lexdb_sql.ColDef = []
                        let none: []Val = []
                        let noSubs: []SubRes = []
                        let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none, seq: None}
                        let v = try eval(&x, &env)
                        let b = match v { Val.Text(t) { parseBool(&t) } Val.Bool(y) { Some(y) } else { None } }
                        match b {
                            Some(y) { on = y }
                            None { return Err(e("22023", "parameter \"lexdb_batch\" requires a Boolean value")) }
                        }
                    }
                    None {}
                }
                s.batch = on
            } else if stmt.table != "" {
                var v = -1                          // DEFAULT, RESET
                match stmt.limit {
                    Some(x) {
                        let noCols: []lexdb_sql.ColDef = []
                        let none: []Val = []
                        let noSubs: []SubRes = []
                        let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none, seq: None}
                        v = try settingValue(&stmt.table, &(try eval(&x, &env)))
                    }
                    None {}
                }
                if stmt.table == "max_recursion" { s.maxRecursion = if v < 0 { MAX_RECURSION } else { v } }
                if stmt.table == "statement_timeout" { s.timeoutMs = if v < 0 { 0 } else { v } }
                if stmt.table == "max_statement_mem" { s.maxMem = if v < 0 { MAX_STATEMENT_MEM } else { v } }
            }
            return Ok(tagOnly(if stmt.ifFlag { "RESET" } else { "SET" }))
        }
        lexdb_sql.S_BEGIN {
            if len(s.txn) == 0 {
                if stmt.ifFlag {
                    append(mut &s.txn, try s.st.beginSnapshot())     // READ ONLY: a snapshot (4.5)
                } else {
                    append(mut &s.txn, try s.st.beginBlock())       // a snapshot with its writes (9.16)
                }
                s.readOnly = stmt.ifFlag
                s.failed = false
                s.saves = []
                s.saved = [Limits{rounds: s.maxRecursion, mem: s.maxMem, deadline: s.timeoutMs, batch: s.batch}]
                var p: []str = []
                for n in s.path { append(mut &p, n) }
                s.savedPath = [p]
                s.savedRoles = [s.st.memoGet(&roleKeyOf(s.id)).unwrapOr("") + "\n" + s.st.memoGet(&sessAuthKey(s.id)).unwrapOr("")]
                var q: []str = []
                for n in s.path { append(mut &q, n) }
                s.txn[0].path = q
                s.txn[0].sess = s.id
            }
            return Ok(tagOnly("BEGIN"))
        }
        lexdb_sql.S_COMMIT {
            if len(s.txn) == 0 { return Ok(tagOnly("COMMIT")) }
            s.saves = []
            let t = pop(mut &s.txn)
            if s.failed {
                s.failed = false
                s.st.abort(t)
                s.restore()
                return Ok(tagOnly("ROLLBACK"))
            }
            s.saved = []
            s.savedPath = []
            s.savedRoles = []
            try s.st.commit(t)
            return Ok(tagOnly("COMMIT"))
        }
        lexdb_sql.S_ROLLBACK {
            if len(s.txn) > 0 { s.st.abort(pop(mut &s.txn)) }
            s.failed = false
            s.saves = []
            s.restore()
            return Ok(tagOnly("ROLLBACK"))
        }
        lexdb_sql.S_SAVEPOINT, lexdb_sql.S_RELEASE, lexdb_sql.S_ROLLBACK_TO {
            let what = if stmt.kind == lexdb_sql.S_SAVEPOINT { "SAVEPOINT" } else if stmt.kind == lexdb_sql.S_RELEASE { "RELEASE SAVEPOINT" } else { "ROLLBACK TO SAVEPOINT" }
            if len(s.txn) == 0 { return Err(e("25P01", what + " can only be used in transaction blocks")) }
            if s.failed && stmt.kind != lexdb_sql.S_ROLLBACK_TO {
                return Err(e("25P02", "current transaction is aborted, commands ignored until end of transaction block"))
            }
            if stmt.kind == lexdb_sql.S_SAVEPOINT {
                append(mut &s.saves, SavePt{name: stmt.table, mark: s.txn[0].mark()})
                return Ok(tagOnly("SAVEPOINT"))
            }
            var i = len(s.saves) - 1
            while i >= 0 && s.saves[i].name != stmt.table { i -= 1 }
            if i < 0 {
                s.failed = true
                return Err(e("3B001", "savepoint \"" + stmt.table + "\" does not exist"))
            }
            if stmt.kind == lexdb_sql.S_RELEASE {
                while len(s.saves) > i { let x = pop(mut &s.saves) }
                return Ok(tagOnly("RELEASE"))
            }
            // ROLLBACK TO: its writes since, and the error if any, gone; it stays
            s.txn[0].undoTo(s.saves[i].mark)
            while len(s.saves) > i + 1 { let x = pop(mut &s.saves) }
            s.failed = false
            return Ok(tagOnly("ROLLBACK"))
        }
        else {}
    }
    if len(s.txn) > 0 {
        if s.failed {
            return Err(e("25P02", "current transaction is aborted, commands ignored until end of transaction block"))
        }
        if s.readOnly && (isWrite(stmt.kind) || (stmt.kind == lexdb_sql.S_COPY && stmt.copy.from)) {
            s.failed = true
            return Err(e("25006", "cannot execute " + stmtName(stmt.kind) + " in a read-only transaction"))
        }
        let st = s.st
        // UPDATE and DELETE read the live tree: the rows they change are
        // checked at COMMIT either way, and the latest is less often stale
        s.txn[0].live = stmt.kind == lexdb_sql.S_UPDATE || stmt.kind == lexdb_sql.S_DELETE || stmt.kind == lexdb_sql.S_INSERT ||
                        (stmt.kind == lexdb_sql.S_COPY && stmt.copy.from)
        let r = execIn(&st, mut &s.txn[0], stmt, params, ptypes, s.limits(), pc, input)
        s.txn[0].live = false
        if r.isErr() {
            s.failed = true
            return r
        }
        return r
    }
    var tries = 0
    let lim = s.limits()                    // retries share the statement's time
    while true {
        // A SELECT runs on a snapshot: it sees one state and never conflicts.
        // It may be long, letting other sessions run (Run.tick) and commit
        // meanwhile; run optimistically, it would conflict with them and
        // run again (design/lexdb.md 9.15). A snapshot whose old versions
        // went over their budget (72000) is tried again on a new one.
        let snap = stmt.kind == lexdb_sql.S_SELECT || (stmt.kind == lexdb_sql.S_COPY && !stmt.copy.from)
        var t = if snap { try s.st.beginSnapshot() } else { lexdb_store.begin() }
        for n in s.path { append(mut &t.path, n) }
        t.sess = s.id
        match execIn(&s.st, mut &t, stmt, params, ptypes, lim, pc, input) {
            Ok(r) {
                match s.st.commit(t) {
                    Ok(_) { return Ok(r) }
                    Err(x) {
                        tries += 1
                        if x.state != lexdb_base.S_CONFLICT || tries >= 10 { return Err(x) }
                    }
                }
            }
            Err(x) {
                s.st.abort(t)
                tries += 1
                if !(snap && x.state == "72000") || tries >= 10 { return Err(x) }
            }
        }
    }
    return Err(e("XX000", "unreachable"))
}

// Parses and runs SQL text with no parameters (for the tests and tools).
pub fn (s: mut &Session) exec(sql: &str): Result[[]Res, DbErr] {
    let stmts = try lexdb_sql.parse(sql)
    var out: []Res = []
    let none: []Val = []
    let nt: []int = []
    for st in stmts { append(mut &out, try s.run(&st, &none, &nt)) }
    return Ok(out)
}

// ---- foreign keys (9.41)
//
// A foreign key is kept in its table's catalog row (Table.fks), and the
// table it references names it back (Table.refBy), so that a statement on
// either finds the other. Columns are kept by name.
//
// MATCH SIMPLE: a row with a NULL in the key's columns references nothing.
// A row's key is looked up in the referenced table as it is written; one
// not there (it may come later in the statement: a table referencing
// itself) is looked up again at the statement's end. What a referenced key
// deleted or changed does waits for the statement's end too, as
// PostgreSQL's triggers do: the rows referencing it deleted or set
// (CASCADE, SET NULL, SET DEFAULT), or none may be left referencing it (NO
// ACTION, unless the key is back by then; RESTRICT).

// Table k from the catalog (k a catalog key, not a name to look up).
fn byKeyOpt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[Option[Table], DbErr] {
    match try st.get(txn, CATALOG, k) {
        Some(v) { return Ok(Some(try decTable(k, &v))) }
        None { return Ok(None) }
    }
}

fn byKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[Table, DbErr] {
    match try byKeyOpt(st, txn, k) {
        Some(t) { return Ok(t) }
        None { return Err(lexdb_base.corrupt("table \"" + lexdb_sql.shown(k) + "\", which a foreign key names")) }
    }
}

fn putTable(txn: mut &lexdb_store.Txn, t: &Table): Result[Unit, DbErr] {
    try txn.put(CATALOG, t.name, encTable(t))
    return Ok(Unit{})
}

fn addKey(xs: mut &[]str, k: &str) {
    for i in 0..len(xs) { if xs[i] == k { return } }
    append(xs, k)
}

fn dropKey(xs: mut &[]str, k: &str) {
    var i = 0
    while i < len(xs) {
        if xs[i] == k { let gone = collections.removeAt(xs, i) } else { i += 1 }
    }
}

fn colsOf(t: &Table, names: &[]str): []int {
    var out: []int = []
    for n in names { append(mut &out, colIndex(&t.cols, &n)) }
    return out
}

// Whether the first n of xs are cols, in any order.
fn prefixSame(xs: &[]int, n: int, cols: &[]int): bool {
    if len(xs) < n || len(cols) != n { return false }
    for j in 0..n {
        var found = false
        for c in cols { if c == xs[j] { found = true } }
        if !found { return false }
    }
    return true
}

// Which of table p's unique keys is cols, in any order: -1 its primary key,
// else an index of p's (unique and not filtered), other than except; -2
// none.
fn keyIndex(p: &Table, cols: &[]int, except: int): int {
    if len(p.pk) == len(cols) && prefixSame(&p.pk, len(cols), cols) { return -1 }
    for k in 0..len(p.indexes) {
        let ix = &p.indexes[k]
        if k != except && ix.unique && ix.pred.isNone() && len(ix.cols) == len(cols) && prefixSame(&ix.cols, len(cols), cols) { return k }
    }
    return -2
}

// A foreign key's columns as numbers: its table's, the referenced table's,
// and the referenced table's key holding them (keyIndex).
type FkCols = record { cols: []int; refCols: []int; via: int }

fn fkCols(c: &Table, f: &ForeignKey, p: &Table): FkCols {
    let rc = colsOf(p, &f.refCols)
    let via = keyIndex(p, &rc, -1)
    return FkCols{cols: colsOf(c, &f.cols), refCols: rc, via: via}
}

fn valsAt(row: &[]Val, cols: &[]int): []Val {
    var out: []Val = []
    for c in cols { append(mut &out, row[c]) }
    return out
}

fn hasNullAt(row: &[]Val, cols: &[]int): bool {
    for c in cols { if isNull(&row[c]) { return true } }
    return false
}

// Values as a key: equal values (1.5 and 1.50) the same.
fn encVals(vs: &[]Val): str {
    var b = newStrBuf()
    for v in vs { encIdxPart(mut &b, &v) }
    return b.toStr()
}

fn nullRow(n: int): []Val {
    var out: []Val = []
    for i in 0..n { append(mut &out, Val.Null) }
    return out
}

// Whether table p has a row with key vals (in fc.refCols' order).
fn parentHas(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, p: &Table, fc: &FkCols, vals: &[]Val): Result[bool, DbErr] {
    var prow = nullRow(len(p.cols))
    for k in 0..len(vals) { prow[fc.refCols[k]] = vals[k] }
    if fc.via == -1 { return Ok((try st.get(txn, p.tree, keyOf(p, &prow))).isSome()) }
    if fc.via < 0 { return Ok(false) }
    let ix = &p.indexes[fc.via]
    let pre = idxPrefix(ix, &prow)
    var found = false
    try st.scan(txn, ix.tree, pre, succ(&pre), fn(en: &lexdb_store.Entry): bool {
        found = true
        return false
    })
    return Ok(found)
}

// Whether a row of table c has vals in its columns cols.
fn referenced(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, c: &Table, cols: &[]int, vals: &[]Val): Result[bool, DbErr] {
    let rows = try refRows(st, txn, c, cols, vals, true)
    return Ok(len(rows) > 0)
}

// The rows of table c with vals in its columns cols (the first only, with
// one): through its primary key or an index starting with them, else read
// whole (as PostgreSQL, lexdb makes no index for a foreign key).
fn refRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, c: &Table, cols: &[]int, vals: &[]Val, one: bool): Result[[][]Val, DbErr] {
    let n = len(cols)
    var crow = nullRow(len(c.cols))
    for j in 0..n { crow[cols[j]] = vals[j] }
    var path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []}
    var sc = Scan{empty: false, point: false, lo: "", hi: "", whole: false}
    if prefixSame(&c.pk, n, cols) {
        var b = newStrBuf()
        for j in 0..n { encKeyPart(mut &b, &crow[c.pk[j]]) }
        let pre = b.toStr()
        sc.lo = pre
        sc.hi = succ(&pre)
    } else {
        for k in 0..len(c.indexes) {
            if path.index < 0 && c.indexes[k].pred.isNone() && prefixSame(&c.indexes[k].cols, n, cols) {
                var b = newStrBuf()
                for j in 0..n { encIdxPart(mut &b, &crow[c.indexes[k].cols[j]]) }
                let pre = b.toStr()
                path.index = k
                sc.lo = pre
                sc.hi = succ(&pre)
            }
        }
    }
    let want = encVals(vals)
    let all: []bool = []
    var out: [][]Val = []
    var cur = newCursor()
    while !cur.done {
        var batch: [][]Val = []
        try fetch(st, txn, c, &path, &sc, &all, mut &cur, mut &batch)
        for r in batch {
            if encVals(&valsAt(&r, cols)) == want {
                append(mut &out, copyRow(&r))
                if one { return Ok(out) }
            }
        }
    }
    return Ok(out)
}

fn keyText(names: &[]str, vals: &[]Val): str {
    var vs: []str = []
    for v in vals { append(mut &vs, text(&v)) }
    return "Key (" + strings.join(names, ", ") + ")=(" + strings.join(&vs, ", ") + ")"
}

fn notPresent(c: &Table, f: &ForeignKey, p: &Table, vals: &[]Val): DbErr {
    return e("23503", "insert or update on table \"" + lexdb_sql.baseName(&c.name) + "\" violates foreign key constraint \"" + f.name + "\": " +
             keyText(&f.cols, vals) + " is not present in table \"" + lexdb_sql.baseName(&p.name) + "\".")
}

fn stillRef(p: &Table, c: &Table, f: &ForeignKey, vals: &[]Val): DbErr {
    return e("23503", "update or delete on table \"" + lexdb_sql.baseName(&p.name) + "\" violates foreign key constraint \"" + f.name +
             "\" on table \"" + lexdb_sql.baseName(&c.name) + "\": " + keyText(&f.refCols, vals) + " is still referenced from table \"" +
             lexdb_sql.baseName(&c.name) + "\".")
}

// What a statement does at its end, in order (each may add more):
const FK_MISSING = 0    // a row's key was not in the table it references: look again
const FK_GONE = 1       // a referenced key gone (NO ACTION, RESTRICT): no row may still reference it
const FK_DELETE = 2     // ON DELETE CASCADE: the rows referencing it deleted
const FK_SET = 3        // ON ... SET NULL, SET DEFAULT, ON UPDATE CASCADE: their key's columns set

// child is the referencing table, fk its foreign key's number, vals the key
// (in the foreign key's column order); act the action (FK_GONE, FK_SET);
// to the new key (ON UPDATE CASCADE).
type FkLater = record { kind: int; child: str; fk: int; vals: []Val; act: int; to: []Val }

fn fkLater(kind: int, child: &str, fk: int, vals: []Val, act: int, to: []Val): FkLater {
    return FkLater{kind: kind, child: child, fk: fk, vals: vals, act: act, to: to}
}

// The tables a statement on t needs for its foreign keys, t itself among
// them: those it references (parents); those referencing it (children),
// and when an action writes their rows, the tables those need in turn.
// None when t has no foreign key either way.
fn fkTables(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, parents: bool, children: bool): Result[[]Table, DbErr] {
    var out: []Table = []
    if len(t.fks) == 0 && len(t.refBy) == 0 { return Ok(out) }
    let ti = try loadTab(st, txn, mut &out, &t.name)
    if parents { for f in t.fks { let pi = try loadTab(st, txn, mut &out, &f.ref) } }
    if !children { return Ok(out) }
    var written = [t.name]
    var w = 0
    while w < len(written) {
        let wn = written[w]
        w += 1
        let wi = try loadTab(st, txn, mut &out, &wn)
        var kids: []str = []
        for k in out[wi].refBy { append(mut &kids, k) }
        for ck in kids {
            let ci = try loadTab(st, txn, mut &out, &ck)
            var acts = false
            var refs: []str = []
            for f in out[ci].fks {
                if f.ref == wn && (f.onDelete >= lexdb_sql.FK_CASCADE || f.onUpdate >= lexdb_sql.FK_CASCADE) { acts = true }
                append(mut &refs, f.ref)
            }
            var seen = false
            for x in written { if x == ck { seen = true } }
            if acts && !seen {
                append(mut &written, ck)
                for r in refs { let ri = try loadTab(st, txn, mut &out, &r) }
            }
        }
    }
    return Ok(out)
}

fn loadTab(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, out: mut &[]Table, k: &str): Result[int, DbErr] {
    for i in 0..len(out) { if out[i].name == k { return Ok(i) } }
    append(out, try byKey(st, txn, k))
    return Ok(len(out) - 1)
}

fn findTab(fw: &[]Table, k: &str): int {
    for i in 0..len(fw) { if fw[i].name == k { return i } }
    return -1
}

// Row old of table t changed to row: checked, written, its indexes, and
// its foreign keys either way.
fn updRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, old: &[]Val, row: &[]Val, fw: &[]Table,
          later: mut &[]FkLater): Result[Unit, DbErr] {
    try checkRow(t, row)
    try checkChecks(t, row)
    let oldKey = keyOf(t, old)
    let key = keyOf(t, row)
    if key != oldKey {
        if (try st.get(txn, t.tree, key)).isSome() { return Err(dupKey(t, row)) }
        txn.del(t.tree, oldKey)
    }
    let enc = encRowOf(t, row)
    try txn.putRow(t.tree, key, enc, rowHead(&enc))
    try changeIndexes(st, txn, t, old, &oldKey, row, &key)
    if len(t.fks) > 0 { try childSide(st, txn, t, fw, row, old, later) }
    if len(t.refBy) > 0 { try parentSide(st, txn, t, fw, old, row, true, later) }
    return Ok(Unit{})
}

// Row of table t deleted, its index entries, and what references it.
fn delRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, row: &[]Val, fw: &[]Table,
          later: mut &[]FkLater): Result[Unit, DbErr] {
    let key = keyOf(t, row)
    txn.del(t.tree, key)
    for ix in t.indexes { if try inIndex(t, &ix, row) { txn.del(ix.tree, idxEntry(&ix, row, &key)) } }
    if len(t.refBy) > 0 {
        let none: []Val = []
        try parentSide(st, txn, t, fw, row, &none, false, later)
    }
    return Ok(Unit{})
}

// Row of table t written (old the row it was, [] for an INSERT): its keys
// in the tables it references.
fn childSide(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, fw: &[]Table, row: &[]Val, old: &[]Val,
             later: mut &[]FkLater): Result[Unit, DbErr] {
    for k in 0..len(t.fks) {
        let f = &t.fks[k]
        let pi = findTab(fw, &f.ref)
        let fc = fkCols(t, f, &fw[pi])
        if hasNullAt(row, &fc.cols) { continue }
        let vals = valsAt(row, &fc.cols)
        if len(old) > 0 && encVals(&valsAt(old, &fc.cols)) == encVals(&vals) { continue }
        let has = try parentHas(st, txn, &fw[pi], &fc, &vals)
        let none: []Val = []
        if !has { append(later, fkLater(FK_MISSING, &t.name, k, vals, 0, none)) }
    }
    return Ok(Unit{})
}

// Row old of table t deleted, or changed to row (upd): what its keys going
// does to the rows referencing them, at the statement's end.
fn parentSide(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, fw: &[]Table, old: &[]Val, row: &[]Val, upd: bool,
              later: mut &[]FkLater): Result[Unit, DbErr] {
    for ck in t.refBy {
        let c = &fw[findTab(fw, &ck)]
        for k in 0..len(c.fks) {
            if c.fks[k].ref != t.name { continue }
            let fc = fkCols(c, &c.fks[k], t)
            if hasNullAt(old, &fc.refCols) { continue }
            let vals = valsAt(old, &fc.refCols)
            if upd && encVals(&valsAt(row, &fc.refCols)) == encVals(&vals) { continue }
            let act = if upd { c.fks[k].onUpdate } else { c.fks[k].onDelete }
            let none: []Val = []
            if act == lexdb_sql.FK_CASCADE && !upd {
                append(later, fkLater(FK_DELETE, &ck, k, vals, act, none))
            } else if act == lexdb_sql.FK_CASCADE {
                append(later, fkLater(FK_SET, &ck, k, vals, act, valsAt(row, &fc.refCols)))
            } else if act >= lexdb_sql.FK_SET_NULL {
                append(later, fkLater(FK_SET, &ck, k, vals, act, none))
            } else {
                // NO ACTION, RESTRICT: nothing to do while no row references it
                let refd = try referenced(st, txn, c, &fc.cols, &vals)
                if refd { append(later, fkLater(FK_GONE, &ck, k, vals, act, none)) }
            }
        }
    }
    return Ok(Unit{})
}

// A statement's end: what it left, in order; deleting and setting rows
// may add more.
fn fkFinish(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, fw: &[]Table, later: mut &[]FkLater): Result[Unit, DbErr] {
    var i = 0
    while i < len(later) {
        let kind = later[i].kind
        let child = later[i].child
        let k = later[i].fk
        let act = later[i].act
        let vals = copyRow(&later[i].vals)
        let to = copyRow(&later[i].to)
        i += 1
        let c = &fw[findTab(fw, &child)]
        let f = &c.fks[k]
        let p = &fw[findTab(fw, &f.ref)]
        let fc = fkCols(c, f, p)
        if kind == FK_MISSING {
            let has = try parentHas(st, txn, p, &fc, &vals)
            if !has { return Err(notPresent(c, f, p, &vals)) }
        } else if kind == FK_GONE {
            // NO ACTION lets a key back by now be
            let back = act != lexdb_sql.FK_RESTRICT && try parentHas(st, txn, p, &fc, &vals)
            if !back {
                let refd = try referenced(st, txn, c, &fc.cols, &vals)
                if refd { return Err(stillRef(p, c, f, &vals)) }
            }
        } else {
            let rows = try refRows(st, txn, c, &fc.cols, &vals, false)
            if kind == FK_DELETE {
                for r in rows { try delRow(st, txn, c, &r, fw, later) }
            } else {
                let defs = try defaultsOf(st, txn, c)
                for r in rows {
                    var nr = copyRow(&r)
                    for j in 0..len(fc.cols) {
                        let col = fc.cols[j]
                        if act == lexdb_sql.FK_CASCADE { nr[col] = to[j] }
                        else if act == lexdb_sql.FK_SET_NULL { nr[col] = Val.Null }
                        else { nr[col] = try defAt(st, txn, &defs, c, col) }
                    }
                    try updRow(st, txn, c, &r, &nr, fw, later)
                }
            }
        }
    }
    return Ok(Unit{})
}

// ---- foreign keys made, dropped, renamed

// Adds foreign key c to table t, the table it references naming t back.
fn addForeign(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, c: &lexdb_sql.Constraint): Result[Unit, DbErr] {
    let refKey = try catKey(st, txn, &c.refTable, false)
    if refKey == t.name {
        let f = try makeFk(st, txn, t, t, c, &refKey)
        append(mut &t.fks, f)
        addKey(mut &t.refBy, &t.name)
        return Ok(Unit{})
    }
    match try byKeyOpt(st, txn, &refKey) {
        Some(p) {
            let f = try makeFk(st, txn, t, &p, c, &refKey)
            append(mut &t.fks, f)
            var pm = p
            addKey(mut &pm.refBy, &t.name)
            return putTable(txn, &pm)
        }
        None { return Err(e("42P01", "relation \"" + lexdb_sql.shown(&c.refTable) + "\" does not exist")) }
    }
}

// Foreign key c of table t to table p, checked, and the rows of t there
// checked against p.
fn makeFk(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, p: &Table, c: &lexdb_sql.Constraint, refKey: &str): Result[ForeignKey, DbErr] {
    var refCols: []str = []
    if len(c.refCols) == 0 { for i in p.pk { append(mut &refCols, p.cols[i].name) } }
    else { for n in c.refCols { append(mut &refCols, n) } }
    if len(refCols) != len(c.cols) {
        return Err(e("42830", "number of referencing and referenced columns for foreign key disagree"))
    }
    var cols: []int = []
    for n in c.cols {
        let i = colIndex(&t.cols, &n)
        if i < 0 { return Err(e("42703", "column \"" + n + "\" referenced in foreign key constraint does not exist")) }
        for k in cols { if k == i { return Err(e("42701", "column \"" + n + "\" appears twice in foreign key constraint")) } }
        append(mut &cols, i)
    }
    var rc: []int = []
    for n in refCols {
        let i = colIndex(&p.cols, &n)
        if i < 0 { return Err(e("42703", "column \"" + n + "\" referenced in foreign key constraint does not exist")) }
        for k in rc { if k == i { return Err(e("42701", "column \"" + n + "\" appears twice in foreign key constraint")) } }
        append(mut &rc, i)
    }
    let via = keyIndex(p, &rc, -1)
    if via == -2 {
        return Err(e("42830", "there is no unique constraint matching given keys for referenced table \"" + lexdb_sql.baseName(&p.name) + "\""))
    }
    var name = c.name
    if len(name) == 0 { name = try makeName(st, txn, t, &c.cols, &"fkey", false) }
    if hasConName(t, &name) { return Err(e("42710", "constraint \"" + name + "\" for relation \"" + lexdb_sql.baseName(&t.name) + "\" already exists")) }
    for j in 0..len(cols) {
        let a = &t.cols[cols[j]]
        let b = &p.cols[rc[j]]
        if a.typ.kind != b.typ.kind {
            return Err(e("42804", "foreign key constraint \"" + name + "\" cannot be implemented: Key columns \"" + a.name + "\" and \"" + b.name +
                         "\" are of incompatible types: " + lexdb_sql.typeText(&a.typ) + " and " + lexdb_sql.typeText(&b.typ) + "."))
        }
    }
    var own: []str = []
    for n in c.cols { append(mut &own, n) }
    let f = ForeignKey{name: name, cols: own, ref: refKey, refCols: refCols, onDelete: c.onDelete, onUpdate: c.onUpdate}
    // the rows there
    let fc = FkCols{cols: cols, refCols: rc, via: via}
    let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: []}
    let sc = Scan{empty: false, point: false, lo: "", hi: "", whole: false}
    var cur = newCursor()
    while !cur.done {
        var batch: [][]Val = []
        let all: []bool = []
        try fetch(st, txn, t, &path, &sc, &all, mut &cur, mut &batch)
        for r in batch {
            if hasNullAt(&r, &fc.cols) { continue }
            let vals = valsAt(&r, &fc.cols)
            let has = try parentHas(st, txn, p, &fc, &vals)
            if !has { return Err(notPresent(t, &f, p, &vals)) }
        }
    }
    return Ok(f)
}

// Drops table t's foreign key k; the table it references no longer names t
// when no other does.
fn dropOwnFk(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, k: int): Result[Unit, DbErr] {
    let f = collections.removeAt(mut &t.fks, k)
    for g in t.fks { if g.ref == f.ref { return Ok(Unit{}) } }
    if f.ref == t.name {
        dropKey(mut &t.refBy, &f.ref)
        return Ok(Unit{})
    }
    var p = try byKey(st, txn, &f.ref)
    dropKey(mut &p.refBy, &t.name)
    return putTable(txn, &p)
}

fn depends(what: &str): DbErr {
    return e("2BP01", "cannot drop " + what + " because other objects depend on it (with CASCADE the foreign keys on it are dropped)")
}

// The foreign keys referencing table t (its own among them) that hit says
// depend on what is dropped: refused, or with cascade dropped.
fn dropReferencing(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, cascade: bool, what: &str,
                   hit: &fn(&ForeignKey, &Table): bool): Result[Unit, DbErr] {
    var kids: []str = []
    for k in t.refBy { append(mut &kids, k) }
    for ck in kids {
        if ck == t.name {
            var k = 0
            while k < len(t.fks) {
                let h = t.fks[k].ref == t.name && hit(&t.fks[k], t)
                if h {
                    if !cascade { return Err(depends(what)) }
                    try dropOwnFk(st, txn, t, k)
                } else {
                    k += 1
                }
            }
        } else {
            var c = try byKey(st, txn, &ck)
            var changed = false
            var k = 0
            while k < len(c.fks) {
                let h = c.fks[k].ref == t.name && hit(&c.fks[k], t)
                if h {
                    if !cascade { return Err(depends(what)) }
                    let gone = collections.removeAt(mut &c.fks, k)
                    changed = true
                } else {
                    k += 1
                }
            }
            if changed {
                var still = false
                for f in c.fks { if f.ref == t.name { still = true } }
                if !still { dropKey(mut &t.refBy, &ck) }
                try putTable(txn, &c)
            }
        }
    }
    return Ok(Unit{})
}

// Index ix of table t to be dropped: the foreign keys referencing t through
// it, with no other unique key of the same columns.
fn dropNeeded(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, ix: int, cascade: bool, what: &str): Result[Unit, DbErr] {
    return dropReferencing(st, txn, t, cascade, what, fn(f: &ForeignKey, p: &Table): bool {
        return keyIndex(p, &colsOf(p, &f.refCols), ix) == -2
    })
}

// Table t to be dropped: the tables referencing it (refused, or with
// cascade their foreign keys dropped), and those it references no longer
// naming it.
fn unlinkTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, cascade: bool): Result[Unit, DbErr] {
    var k = 0
    while k < len(t.fks) {
        if t.fks[k].ref == t.name { try dropOwnFk(st, txn, t, k) } else { k += 1 }
    }
    try dropReferencing(st, txn, t, cascade, &("table " + lexdb_sql.baseName(&t.name)), fn(f: &ForeignKey, p: &Table): bool { return true })
    var parents: []str = []
    for f in t.fks { addKey(mut &parents, &f.ref) }
    for pn in parents {
        var p = try byKey(st, txn, &pn)
        dropKey(mut &p.refBy, &t.name)
        try putTable(txn, &p)
    }
    return Ok(Unit{})
}

// Column name of table t to be dropped: its foreign keys on it go (as
// PostgreSQL's do); those of other tables referencing it are refused, or
// with cascade dropped.
fn fkDropColumn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, name: &str, cascade: bool): Result[Unit, DbErr] {
    var k = 0
    while k < len(t.fks) {
        var uses = false
        for n in t.fks[k].cols { if n == name { uses = true } }
        if uses { try dropOwnFk(st, txn, t, k) } else { k += 1 }
    }
    let col = name + ""
    return dropReferencing(st, txn, t, cascade, &("column " + name + " of table " + lexdb_sql.baseName(&t.name)),
                           fn(f: &ForeignKey, p: &Table): bool {
        for n in f.refCols { if n == col { return true } }
        return false
    })
}

// Whether column name of table t is in a foreign key, either way.
fn fkUses(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, name: &str): Result[bool, DbErr] {
    for f in t.fks { for n in f.cols { if n == name { return Ok(true) } } }
    for ck in t.refBy {
        if ck == t.name {
            for f in t.fks { if f.ref == t.name { for n in f.refCols { if n == name { return Ok(true) } } } }
        } else {
            let c = try byKey(st, txn, &ck)
            for f in c.fks { if f.ref == t.name { for n in f.refCols { if n == name { return Ok(true) } } } }
        }
    }
    return Ok(false)
}

// Column from of table t renamed to: in its foreign keys, and in those
// referencing it.
fn renameFkCol(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, from: &str, to: &str): Result[Unit, DbErr] {
    for k in 0..len(t.fks) {
        for j in 0..len(t.fks[k].cols) { if t.fks[k].cols[j] == from { t.fks[k].cols[j] = to } }
    }
    var kids: []str = []
    for k in t.refBy { append(mut &kids, k) }
    for ck in kids {
        if ck == t.name {
            for k in 0..len(t.fks) {
                if t.fks[k].ref == t.name {
                    for j in 0..len(t.fks[k].refCols) { if t.fks[k].refCols[j] == from { t.fks[k].refCols[j] = to } }
                }
            }
        } else {
            var c = try byKey(st, txn, &ck)
            for k in 0..len(c.fks) {
                if c.fks[k].ref == t.name {
                    for j in 0..len(c.fks[k].refCols) { if c.fks[k].refCols[j] == from { c.fks[k].refCols[j] = to } }
                }
            }
            try putTable(txn, &c)
        }
    }
    return Ok(Unit{})
}

// Table t's catalog key changed from old (a rename, another schema): the
// tables it references and those referencing it name the new one.
fn relink(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, old: &str): Result[Unit, DbErr] {
    let now = t.name
    for k in 0..len(t.fks) { if t.fks[k].ref == old { t.fks[k].ref = now } }
    for k in 0..len(t.refBy) { if t.refBy[k] == old { t.refBy[k] = now } }
    var parents: []str = []
    for f in t.fks { if f.ref != now { addKey(mut &parents, &f.ref) } }
    for pn in parents {
        var p = try byKey(st, txn, &pn)
        for k in 0..len(p.refBy) { if p.refBy[k] == old { p.refBy[k] = now } }
        try putTable(txn, &p)
    }
    var kids: []str = []
    for ck in t.refBy { if ck != now { addKey(mut &kids, &ck) } }
    for ck in kids {
        var c = try byKey(st, txn, &ck)
        for k in 0..len(c.fks) { if c.fks[k].ref == old { c.fks[k].ref = now } }
        try putTable(txn, &c)
    }
    return Ok(Unit{})
}

// ---- sequences (9.43)
//
// A sequence is a catalog row of its own, seqRow(key), in the relations'
// namespace (a table, an index or a sequence may not share a name): its
// definition (Seq), changed only by DDL, in the DDL's transaction.
//
// Its values are outside any transaction, as PostgreSQL's: nextval in a
// transaction rolled back is not given again, and two transactions taking
// values never conflict. They are handed out from the store's memo
// (Store.memoGet), a block at a time: before a block's first value is given,
// its last is written, in a transaction of its own, to the sequences' tree
// (SEQ_TREE, not the catalog, whose writes make the wire describe
// statements again). After a crash the sequence goes on after the last
// block written, skipping what was left of it (as PostgreSQL skips what it
// logged ahead).

pub type Seq = record {
    key: str            // its catalog key
    id: str             // made when it was: its values' memo and durable row
    typ: int            // OID_INT2, OID_INT4, OID_INT8
    inc: int
    min: int
    max: int
    start: int
    cache: int
    cycle: bool
    ownerT: str         // OWNED BY: a table's catalog key and column; "" none
    ownerC: str
}

fn seqCopy(d: &Seq): Seq {
    return Seq{key: d.key, id: d.id, typ: d.typ, inc: d.inc, min: d.min, max: d.max, start: d.start, cache: d.cache,
               cycle: d.cycle, ownerT: d.ownerT, ownerC: d.ownerC}
}

fn noSeq(): Seq {
    return Seq{key: "", id: "", typ: 0, inc: 1, min: 1, max: 1, start: 1, cache: 1, cycle: false, ownerT: "", ownerC: ""}
}

// The catalog key holding the id of the sequences' tree.
const SEQ_TREE: str = "\x02seqs"

fn seqRow(k: &str): str { return "\x04" + k }

// What a session's evaluation needs for nextval and its kind (Env.seq).
pub type SeqEnv = value record { st: lexdb_store.Store; sess: int; now: int }

fn seqEnv(st: &lexdb_store.Store, txn: &lexdb_store.Txn): Option[SeqEnv] {
    return Some(SeqEnv{st: st.handle(), sess: txn.sess, now: txn.now})
}

fn encSeq(d: &Seq): str {
    var b = newStrBuf()
    addStrs(mut &b, &[d.key, d.id, d.typ.toStr(), d.inc.toStr(), d.min.toStr(), d.max.toStr(), d.start.toStr(), d.cache.toStr(),
                     if d.cycle { "1" } else { "0" }, d.ownerT, d.ownerC])
    return b.toStr()
}

fn num(s: &str): int { return strings.parseIntOpt(s).unwrapOr(0) }

fn decSeq(s: &str): Seq {
    let f = strsAt(s, 0)
    return Seq{key: f[0], id: f[1], typ: num(&f[2]), inc: num(&f[3]), min: num(&f[4]), max: num(&f[5]), start: num(&f[6]),
               cache: num(&f[7]), cycle: f[8] == "1", ownerT: f[9], ownerC: f[10]}
}

fn typMax(oid: int): int {
    if oid == lexdb_sql.OID_INT2 { return 32767 }
    if oid == lexdb_sql.OID_INT4 { return 2147483647 }
    return 9223372036854775807
}

fn typMin(oid: int): int {
    if oid == lexdb_sql.OID_INT2 { return -32768 }
    if oid == lexdb_sql.OID_INT4 { return -2147483648 }
    return -9223372036854775807 - 1
}

// A sequence's name in a string, as nextval('...') takes it: unquoted
// parts lower-cased, "quoted" ones kept, schema.name qualified.
fn nameOfText(t: &str): str {
    var parts: []str = []
    var cur = newStrBuf()
    var quoted = false
    var i = 0
    while i < len(t) {
        let c = t[i]
        if quoted {
            if c == '"' {
                if i + 1 < len(t) && t[i + 1] == '"' {
                    cur.addByte('"')
                    i += 1
                } else {
                    quoted = false
                }
            } else {
                cur.addByte(c)
            }
        } else if c == '"' {
            quoted = true
        } else if c == '.' {
            append(mut &parts, cur.toStr())
            cur = newStrBuf()
        } else if c >= 'A' && c <= 'Z' {
            cur.addByte(byte(c + 32))
        } else {
            cur.addByte(c)
        }
        i += 1
    }
    append(mut &parts, cur.toStr())
    let n = len(parts)
    if n >= 2 { return lexdb_sql.qual(&parts[n - 2], &parts[n - 1]) }
    return parts[0]
}

// The sequence named n (a name as written: along the search path), or none.
fn findSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[Option[Seq], DbErr] {
    var keys: []str = []
    if len(txn.path) == 0 || lexdb_sql.isQual(n) {
        append(mut &keys, n)
    } else {
        for sc in txn.path { append(mut &keys, lexdb_sql.qual(&sc, n)) }
    }
    for k in keys {
        match try st.get(txn, CATALOG, seqRow(&k)) {
            Some(v) { return Ok(Some(decSeq(&v))) }
            None {}
        }
    }
    return Ok(None)
}

fn needSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[Seq, DbErr] {
    match try findSeq(st, txn, n) {
        Some(d) { return Ok(d) }
        None { return Err(e("42P01", "relation \"" + lexdb_sql.shown(n) + "\" does not exist")) }
    }
}

// The id of the sequences' tree (made by bootstrap).
fn seqTree(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[int, DbErr] {
    match try st.get(txn, CATALOG, SEQ_TREE) {
        Some(v) { return Ok(num(&v)) }
        None { return Err(lexdb_base.corrupt("the sequences' tree")) }
    }
}

// A sequence's definition from its options: those not given as d has them
// (CREATE: d the defaults for its type).
fn seqFrom(o: &lexdb_sql.SeqOpts, d: &Seq, creating: bool): Result[Seq, DbErr] {
    var r = seqCopy(d)
    if o.typ != 0 { r.typ = o.typ }
    if o.hasInc { r.inc = o.inc }
    if r.inc == 0 { return Err(e("22023", "INCREMENT must not be zero")) }
    let tn = lexdb_sql.typeText(&lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: r.typ, prec: 0, scale: 0, len: 0})
    if o.hasMax == 1 { r.max = o.max } else if o.hasMax == 2 || creating || o.typ != 0 { r.max = if r.inc > 0 { typMax(r.typ) } else { -1 } }
    if o.hasMin == 1 { r.min = o.min } else if o.hasMin == 2 || creating || o.typ != 0 { r.min = if r.inc > 0 { 1 } else { typMin(r.typ) } }
    if r.max > typMax(r.typ) || r.max < typMin(r.typ) {
        return Err(e("22023", "MAXVALUE (" + r.max.toStr() + ") is out of range for sequence data type " + tn))
    }
    if r.min > typMax(r.typ) || r.min < typMin(r.typ) {
        return Err(e("22023", "MINVALUE (" + r.min.toStr() + ") is out of range for sequence data type " + tn))
    }
    if r.min >= r.max { return Err(e("22023", "MINVALUE (" + r.min.toStr() + ") must be less than MAXVALUE (" + r.max.toStr() + ")")) }
    if o.hasStart { r.start = o.start } else if creating { r.start = if r.inc > 0 { r.min } else { r.max } }
    if r.start < r.min { return Err(e("22023", "START value (" + r.start.toStr() + ") cannot be less than MINVALUE (" + r.min.toStr() + ")")) }
    if r.start > r.max { return Err(e("22023", "START value (" + r.start.toStr() + ") cannot be greater than MAXVALUE (" + r.max.toStr() + ")")) }
    if o.cache > 0 { r.cache = o.cache }
    if o.cycle != 0 { r.cycle = o.cycle == 1 }
    return Ok(r)
}

// A new sequence key, its definition from o (typ its type unless o says).
fn newSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str, typ: int, o: &lexdb_sql.SeqOpts): Result[Seq, DbErr] {
    var d = noSeq()
    d.key = key
    d.typ = typ
    // unique: the catalog's version (one per DDL statement) and the time
    d.id = (try catVersion(st, txn)) + "." + time.unixMillis().toStr() + "." + time.monotonicNs().toStr()
    let r = try seqFrom(o, &d, true)
    try txn.put(CATALOG, seqRow(key), encSeq(&r))
    return Ok(r)
}

// ---- a sequence's values (nextval, setval)

// Its memo: "sn:" the next value to give ("e" none left), "sl:" the last
// value of the block written ("" none), "sb:" a block being written, "sg:"
// the last value given.
fn memoGiven(d: &Seq): str { return "sg:" + d.id }
fn memoNext(d: &Seq): str { return "sn:" + d.id }
fn memoLast(d: &Seq): str { return "sl:" + d.id }
fn memoBusy(d: &Seq): str { return "sb:" + d.id }

// What follows n ("e" past its bounds).
fn seqAfter(d: &Seq, n: int): str {
    if d.inc > 0 && n > d.max - d.inc { return "e" }
    if d.inc < 0 && n < d.min - d.inc { return "e" }
    return (n + d.inc).toStr()
}

// Waits while a block of sequence d is being written, then marks one.
fn seqLock(st: &lexdb_store.Store, d: &Seq) {
    while st.memoGet(&memoBusy(d)).isSome() { let y = task.yield() }
    st.memoPut(&memoBusy(d), &"1")
}

// Writes v as sequence d's last durable value, in a transaction of its own,
// not waiting for the disk: a commit using its values waits for it too.
fn seqWrite(st: &lexdb_store.Store, d: &Seq, v: int): Result[Unit, DbErr] {
    var t = lexdb_store.begin()
    let tree = try seqTree(st, mut &t)
    try t.put(tree, d.id, v.toStr())
    // durable before any transaction using the block's values is
    return st.commitAhead(t)
}

// The sequence's next value.
fn nextVal(st: &lexdb_store.Store, d: &Seq): Result[int, DbErr] {
    let kn = memoNext(d)
    let kl = memoLast(d)
    while true {
        if st.memoGet(&kn).isNone() {
            // first used since the store opened: after its last value written
            seqLock(st, d)
            if st.memoGet(&kn).isNone() {
                var t = lexdb_store.begin()
                let tree = seqTree(st, mut &t)
                match tree {
                    Ok(tr) {
                        match st.get(mut &t, tr, d.id) {
                            Ok(got) {
                                match got {
                                    Some(v) {
                                        st.memoPut(&kn, &seqAfter(d, num(&v)))
                                        st.memoPut(&kl, &v)
                                    }
                                    None {
                                        st.memoPut(&kn, &d.start.toStr())
                                        st.memoPut(&kl, &"")
                                    }
                                }
                            }
                            Err(x) {
                                st.abort(t)
                                st.memoDel(&memoBusy(d))
                                return Err(x)
                            }
                        }
                    }
                    Err(x) {
                        st.abort(t)
                        st.memoDel(&memoBusy(d))
                        return Err(x)
                    }
                }
                st.abort(t)
            }
            st.memoDel(&memoBusy(d))
            continue
        }
        let nv = st.memoGet(&kn).unwrap()
        if nv == "e" {
            if !d.cycle {
                let edge = if d.inc > 0 { "maximum value of sequence \"" + lexdb_sql.baseName(&d.key) + "\" (" + d.max.toStr() + ")" }
                           else { "minimum value of sequence \"" + lexdb_sql.baseName(&d.key) + "\" (" + d.min.toStr() + ")" }
                return Err(e("2200H", "nextval: reached " + edge))
            }
            st.memoPut(&kn, &(if d.inc > 0 { d.min } else { d.max }).toStr())
            st.memoPut(&kl, &"")
            continue
        }
        let n = num(&nv)
        let lv = st.memoGet(&kl).unwrapOr("")
        let held = len(lv) > 0 && (if d.inc > 0 { n <= num(&lv) } else { n >= num(&lv) })
        if held {
            st.memoPut(&kn, &seqAfter(d, n))
            st.memoPut(&memoGiven(d), &n.toStr())
            return Ok(n)
        }
        // the next block: its last value written before its first is given
        if st.memoGet(&memoBusy(d)).isSome() {
            let y = task.yield()
            continue
        }
        st.memoPut(&memoBusy(d), &"1")
        let steps = (if d.cache > 32 { d.cache } else { 32 }) - 1
        var room = steps
        if d.inc > 0 {
            if !(n < 0 && d.max - 9223372036854775807 > n) { room = (d.max - n) / d.inc }
        } else {
            if !(n > 0 && d.min + 9223372036854775807 < n) { room = (n - d.min) / (0 - d.inc) }
        }
        let hi = n + d.inc * (if room < steps { room } else { steps })
        let w = seqWrite(st, d, hi)
        st.memoDel(&memoBusy(d))
        match w {
            Ok(_) { st.memoPut(&kl, &hi.toStr()) }
            Err(x) { return Err(x) }
        }
    }
    return Ok(0)
}

// setval(d, v, called): the next value v + inc (called) or v; written at
// once.
fn setVal(st: &lexdb_store.Store, d: &Seq, v: int, called: bool): Result[Unit, DbErr] {
    if v < d.min || v > d.max {
        return Err(e("22003", "setval: value " + v.toStr() + " is out of bounds for sequence \"" + lexdb_sql.baseName(&d.key) +
                     "\" (" + d.min.toStr() + ".." + d.max.toStr() + ")"))
    }
    seqLock(st, d)
    // the last value given: v, or (not called) the one before it
    var last = v
    var next = seqAfter(d, v)
    if !called {
        next = v.toStr()
        last = v - d.inc
        if (d.inc > 0 && v == typMin(d.typ)) || (d.inc < 0 && v == typMax(d.typ)) { last = v }
    }
    let w = seqWrite(st, d, last)
    match w {
        Ok(_) {
            st.memoPut(&memoNext(d), &next)
            st.memoPut(&memoLast(d), &(if called { last.toStr() } else { "" }))
            if called { st.memoPut(&memoGiven(d), &v.toStr()) } else { st.memoDel(&memoGiven(d)) }
        }
        Err(_) {}
    }
    st.memoDel(&memoBusy(d))
    return w
}

// Sequence d's definition changed: its next value follows the last given,
// by its new increment, in a block written anew (or, none given since the
// store opened, the last written).
fn seqForget(st: &lexdb_store.Store, d: &Seq) {
    match st.memoGet(&memoGiven(d)) {
        Some(g) {
            let gv = num(&g)
            var nx = seqAfter(d, gv)
            if nx != "e" && (num(&nx) < d.min || num(&nx) > d.max) { nx = "e" }
            st.memoPut(&memoNext(d), &nx)
        }
        None { st.memoDel(&memoNext(d)) }
    }
    st.memoPut(&memoLast(d), &"")
}

// ---- the session's side: currval, lastval, and the names its statement binds

fn curKey(sess: int, d: &Seq): str { return "cv:" + sess.toStr() + ":" + d.id }
fn lastKey(sess: int): str { return "lv:" + sess.toStr() }
fn bindKey(sess: int, name: &str): str { return "bd:" + sess.toStr() + ":" + name }
fn stmtKey(sess: int): str { return "bs:" + sess.toStr() }

// nextval for session sess: its currval and lastval too.
fn nextFor(st: &lexdb_store.Store, sess: int, d: &Seq): Result[int, DbErr] {
    let v = try nextVal(st, d)
    st.memoPut(&curKey(sess, d), &v.toStr())
    st.memoPut(&lastKey(sess), &v.toStr())
    return Ok(v)
}

// A statement's start: the sequences its calls name, looked up in its
// transaction (a sequence made earlier in it is seen) and kept for its
// evaluation, under a number of this statement's.
fn bindSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, names: &[]str): Result[Unit, DbErr] {
    if len(names) == 0 { return Ok(Unit{}) }
    let no = num(&st.memoGet(&stmtKey(txn.sess)).unwrapOr("0")) + 1
    st.memoPut(&stmtKey(txn.sess), &no.toStr())
    for n in names {
        if n == lexdb_sql.CAT_MARK {
            try bindCatalog(st, txn)
            continue
        }
        let d = try needSeq(st, txn, &nameOfText(&n))
        // nextval, setval: USAGE or UPDATE; currval: USAGE or SELECT (9.83: checked
        // for the sequences a statement names, not a column's own)
        let w = try whoNow(st, txn)
        if !w.super {
            let a = try readAcl(st, txn, &relObj(&d.key))
            if !allows(&w, &a, &"U") && !allows(&w, &a, &"w") && !allows(&w, &a, &"r") { return Err(denied(&"sequence", &d.key)) }
        }
        st.memoPut(&bindKey(txn.sess, &n), &(no.toStr() + "\n" + encSeq(&d)))
    }
    return Ok(Unit{})
}

// The sequence a call names, as its statement bound it.
fn boundSeq(q: &SeqEnv, name: &str, f: &str): Result[Seq, DbErr] {
    let no = q.st.memoGet(&stmtKey(q.sess)).unwrapOr("")
    match q.st.memoGet(&bindKey(q.sess, name)) {
        Some(v) {
            let i = strings.indexOf(&v, "\n", 0)
            if i > 0 && v[0..i] == no { return Ok(decSeq(&v[i + 1..len(v)])) }
        }
        None {}
    }
    return Err(e("0A000", "lexdb: " + f + " takes its sequence's name as a literal ('name')"))
}

fn isSeqFn(name: &str): bool { return name == "nextval" || name == "currval" || name == "setval" || name == "lastval" }

// nextval, currval, setval, lastval.
fn seqCall(name: &str, vs: &[]Val, env: &Env): Result[Val, DbErr] {
    match env.seq {
        None { return Err(e("0A000", "lexdb: " + name + " is not allowed here")) }
        Some(q) {
            if name == "lastval" {
                if len(vs) != 0 { return Err(e("42883", "function lastval takes no arguments")) }
                match q.st.memoGet(&lastKey(q.sess)) {
                    Some(v) { return Ok(Val.Int(num(&v))) }
                    None { return Err(e("55000", "lastval is not yet defined in this session")) }
                }
            }
            if len(vs) == 0 || isNull(&vs[0]) { return Ok(Val.Null) }
            let d = try boundSeq(&q, &text(&vs[0]), name)
            if name == "nextval" {
                if len(vs) != 1 { return Err(e("42883", "function nextval takes one argument")) }
                return Ok(Val.Int(try nextFor(&q.st, q.sess, &d)))
            }
            if name == "currval" {
                if len(vs) != 1 { return Err(e("42883", "function currval takes one argument")) }
                match q.st.memoGet(&curKey(q.sess, &d)) {
                    Some(v) { return Ok(Val.Int(num(&v))) }
                    None { return Err(e("55000", "currval of sequence \"" + lexdb_sql.baseName(&d.key) + "\" is not yet defined in this session")) }
                }
            }
            // setval(name, v [, called])
            if len(vs) < 2 || len(vs) > 3 { return Err(e("42883", "function setval takes two or three arguments")) }
            if isNull(&vs[1]) { return Ok(Val.Null) }
            let v = match vs[1] { Val.Int(n) { n } else { 0 } }
            match vs[1] {
                Val.Int(_) {}
                else { return Err(e("42804", "setval takes a bigint")) }
            }
            var called = true
            if len(vs) == 3 {
                match vs[2] {
                    Val.Bool(b) { called = b }
                    else { return Err(e("42804", "setval's third argument is a boolean")) }
                }
            }
            try setVal(&q.st, &d, v, called)
            return Ok(Val.Int(v))
        }
    }
}

// Whether x calls a sequence function (evaluated per row, never once).
fn isVolatile(x: &Expr): bool {
    match x {
        Expr.Call(n, args, _) {
            if isSeqFn(&n) { return true }
            for a in args { if isVolatile(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return isVolatile(&a) }
        Expr.Bin(_, a, b) { return isVolatile(&a) || isVolatile(&b) }
        Expr.IsNull(a, _) { return isVolatile(&a) }
        Expr.Cast(a, _) { return isVolatile(&a) }
        else { return false }
    }
}

// The sequence names x's calls give as literals.
fn seqNamesOf(x: &Expr, out: mut &[]str) {
    match x {
        Expr.Call(n, args, _) {
            if (n == "nextval" || n == "currval" || n == "setval") && len(args) > 0 {
                match lexdb_sql.litText(&args[0]) {
                    Some(t) { append(out, t) }
                    None {}
                }
            }
            for a in args { seqNamesOf(&a, out) }
        }
        Expr.Unary(_, a) { seqNamesOf(&a, out) }
        Expr.Bin(_, a, b) {
            seqNamesOf(&a, out)
            seqNamesOf(&b, out)
        }
        Expr.IsNull(a, _) { seqNamesOf(&a, out) }
        Expr.Cast(a, _) { seqNamesOf(&a, out) }
        else {}
    }
}

// ---- defaults with sequences: a statement's (9.38's defaultsOf, per row
// where a column's default is its sequence's nextval or calls one)

type Defs = record {
    vals: []Val             // the defaults that are values
    seqs: []Seq             // a column's own sequence (key "" none)
    exprs: []Option[Expr]   // a default calling a sequence function: evaluated per row
}

fn defaultsOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table): Result[Defs, DbErr] {
    var d = Defs{vals: [], seqs: [], exprs: []}
    var names: []str = []
    for c in t.cols {
        var v = Val.Null
        var sq = noSeq()
        var x: Option[Expr] = None
        if len(c.seq) > 0 {
            match try st.get(txn, CATALOG, seqRow(&c.seq)) {
                Some(r) { sq = decSeq(&r) }
                None { return Err(lexdb_base.corrupt("the sequence of column \"" + c.name + "\"")) }
            }
        } else {
            match c.def {
                Some(dx) {
                    if isVolatile(&dx) {
                        seqNamesOf(&dx, mut &names)
                        x = Some(clone(&dx))
                    } else {
                        v = try defaultValue(&dx, &c)
                    }
                }
                None {}
            }
        }
        append(mut &d.vals, v)
        append(mut &d.seqs, sq)
        append(mut &d.exprs, x)
    }
    if len(names) > 0 { try bindSeqs(st, txn, &names) }
    return Ok(d)
}

// Column i's default for a row.
fn defAt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, d: &Defs, t: &Table, i: int): Result[Val, DbErr] {
    let sqe = seqEnv(st, txn)
    if len(d.seqs[i].key) > 0 { return Ok(Val.Int(try nextFor(st, txn.sess, &d.seqs[i]))) }
    match d.exprs[i] {
        Some(x) {
            let none: []Val = []
            let noCols: []lexdb_sql.ColDef = []
            let noSubs: []SubRes = []
            let env = Env{cols: &noCols, row: &none, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: sqe}
            return coerce(try eval(&x, &env), &t.cols[i].typ)
        }
        None { return Ok(d.vals[i]) }
    }
}

// ---- sequences made, changed, dropped

// CREATE SEQUENCE.
fn createSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var key = s.table
    if lexdb_sql.isQual(&s.table) {
        let sn = lexdb_sql.schemaOf(&s.table)
        if !(try schemaExists(st, txn, &sn)) { return Err(e("3F000", "schema \"" + sn + "\" does not exist")) }
    } else {
        let sn = try createSchema(st, txn)
        if len(sn) == 0 { return Err(e("3F000", "no schema has been selected to create in")) }
        key = lexdb_sql.qual(&sn, &s.table)
    }
    if try relExists(st, txn, &key) {
        if s.ifFlag { return Ok(tagOnly("CREATE SEQUENCE")) }
        return Err(e("42P07", "relation \"" + lexdb_sql.baseName(&key) + "\" already exists"))
    }
    try needCreate(st, txn, &key)
    try ownNew(st, txn, &relObj(&key))
    var d = try newSeq(st, txn, &key, lexdb_sql.OID_INT8, &s.seq)
    if len(s.seq.owned) == 2 && len(s.seq.owned[0]) > 0 {
        try ownSeq(st, txn, mut &d, &s.seq.owned)
        try txn.put(CATALOG, seqRow(&key), encSeq(&d))
    }
    try bumpCatalog(st, txn)
    return Ok(tagOnly("CREATE SEQUENCE"))
}

// OWNED BY table.column: in the sequence's schema, as PostgreSQL has it.
fn ownSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, d: mut &Seq, owned: &[]str): Result[Unit, DbErr] {
    if len(owned[0]) == 0 {
        d.ownerT = ""
        d.ownerC = ""
        return Ok(Unit{})
    }
    let t = try needTable(st, txn, &owned[0])
    if colIndex(&t.cols, &owned[1]) < 0 {
        return Err(e("42703", "column \"" + owned[1] + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist"))
    }
    if lexdb_sql.schemaOf(&t.name) != lexdb_sql.schemaOf(&d.key) {
        return Err(e("55000", "sequence must be in same schema as table it is linked to"))
    }
    d.ownerT = t.name
    d.ownerC = owned[1]
    return Ok(Unit{})
}

// ALTER SEQUENCE: its options; RESTART at once (as setval).
fn alterSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let found = try findSeq(st, txn, &s.table)
    if found.isNone() {
        if s.ifFlag { return Ok(tagOnly("ALTER SEQUENCE")) }
        return Err(e("42P01", "relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist"))
    }
    let old = found.unwrap()
    try needRelOwner(st, txn, &old.key, &"sequence")
    var d = try seqFrom(&s.seq, &old, false)
    if len(s.seq.owned) == 2 { try ownSeq(st, txn, mut &d, &s.seq.owned) }
    try txn.put(CATALOG, seqRow(&d.key), encSeq(&d))
    seqForget(st, &d)
    if s.seq.restart > 0 {
        try setVal(st, &d, if s.seq.restart == 2 { s.seq.restartWith } else { d.start }, false)
    }
    try bumpCatalog(st, txn)
    return Ok(tagOnly("ALTER SEQUENCE"))
}

// Sequence d's rows deleted (its definition and last value).
fn dropSeqRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, d: &Seq): Result[Unit, DbErr] {
    txn.del(CATALOG, seqRow(&d.key))
    dropAcl(txn, &relObj(&d.key))
    txn.del(try seqTree(st, txn), d.id)
    return Ok(Unit{})
}

// DROP SEQUENCE: refused while it is a column's (its default), unless
// CASCADE, which takes the column's default away.
fn dropSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let found = try findSeq(st, txn, &s.table)
    if found.isNone() {
        if s.ifFlag { return Ok(tagOnly("DROP SEQUENCE")) }
        return Err(e("42P01", "sequence \"" + lexdb_sql.shown(&s.table) + "\" does not exist"))
    }
    let d = found.unwrap()
    try needRelOwner(st, txn, &d.key, &"sequence")
    if len(d.ownerT) > 0 {
        match try byKeyOpt(st, txn, &d.ownerT) {
            Some(t) {
                var u = t
                var used = false
                for i in 0..len(u.cols) {
                    if u.cols[i].seq == d.key {
                        used = true
                        if !s.cascade {
                            return Err(e("2BP01", "cannot drop sequence " + lexdb_sql.baseName(&d.key) + " because column " + u.cols[i].name +
                                         " of table " + lexdb_sql.baseName(&u.name) + " requires it (with CASCADE its default is dropped)"))
                        }
                        u.cols[i].seq = ""
                        u.cols[i].identity = lexdb_sql.ID_NONE
                    }
                }
                if used { try putTable(txn, &u) }
            }
            None {}
        }
    }
    try dropSeqRows(st, txn, &d)
    try bumpCatalog(st, txn)
    return Ok(tagOnly("DROP SEQUENCE"))
}

// The sequences in the catalog: in schema sc ("" all).
fn allSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: &str): Result[[]Seq, DbErr] {
    let from = if len(sc) > 0 { seqRow(&lexdb_sql.qual(sc, &"")) } else { "\x04" }
    let to = if len(sc) > 0 { from + "\xff" } else { "\x05" }
    var out: []Seq = []
    try st.scan(txn, CATALOG, from, to, fn(en: &lexdb_store.Entry): bool {
        append(mut &out, decSeq(&en.val))
        return true
    })
    return Ok(out)
}

// Table t's columns' sequences (SERIAL, identity) made: named table_column_seq
// as PostgreSQL names them, owned by their columns. Its own options from
// ids (an identity column's).
fn makeColSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, only: int, ids: &[]lexdb_sql.IdOpts): Result[Unit, DbErr] {
    for i in 0..len(t.cols) {
        if (only >= 0 && i != only) || t.cols[i].identity == lexdb_sql.ID_NONE || len(t.cols[i].seq) > 0 { continue }
        let cname = t.cols[i].name
        let ctyp = t.cols[i].typ
        let cid = t.cols[i].identity
        let cdef = t.cols[i].def.isSome()
        if ctyp.kind != lexdb_sql.K_INT { return Err(e("22023", "identity column type must be smallint, integer, or bigint")) }
        if cdef {
            if cid == lexdb_sql.ID_SERIAL {
                return Err(e("42601", "multiple default values specified for column \"" + cname + "\" of table \"" + lexdb_sql.baseName(&t.name) + "\""))
            }
            return Err(e("42601", "both default and identity specified for column \"" + cname + "\" of table \"" + lexdb_sql.baseName(&t.name) + "\""))
        }
        var oi = -1
        for k in 0..len(ids) { if ids[k].col == cname { oi = k } }
        let none = lexdb_sql.noSeqOpts()
        let o = if oi >= 0 { &ids[oi].opts } else { &none }
        if len(o.owned) > 0 { return Err(e("42601", "lexdb: an identity column's sequence is owned by it (no OWNED BY)")) }
        let name = try makeName(st, txn, t, &[cname], &"seq", true)
        let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &name)
        var d = try newSeq(st, txn, &key, ctyp.oid, o)
        d.ownerT = t.name
        d.ownerC = cname
        try txn.put(CATALOG, seqRow(&key), encSeq(&d))
        t.cols[i].seq = key
    }
    return Ok(Unit{})
}

// The sequences owned by table t (its column col; "" any) dropped.
fn dropOwnedSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, col: &str): Result[Unit, DbErr] {
    for d in try allSeqs(st, txn, &"") {
        if d.ownerT == t.name && (len(col) == 0 || d.ownerC == col) { try dropSeqRows(st, txn, &d) }
    }
    return Ok(Unit{})
}

// Table t renamed from old (a key), or its column from renamed to: its
// sequences' owner. Moved to schema sc ("" not moved): its sequences with it,
// unless a name is taken there.
fn ownerMoved(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, old: &str, from: &str, to: &str, sc: &str): Result[Unit, DbErr] {
    for d in try allSeqs(st, txn, &"") {
        if d.ownerT != old { continue }
        var m = seqCopy(&d)
        m.ownerT = t.name
        if len(from) > 0 && m.ownerC == from { m.ownerC = to }
        if len(sc) > 0 && lexdb_sql.schemaOf(&m.key) != sc {
            let nk = lexdb_sql.qual(sc, &lexdb_sql.baseName(&m.key))
            if try relExists(st, txn, &nk) {
                return Err(e("42P07", "relation \"" + lexdb_sql.baseName(&m.key) + "\" already exists in schema \"" + sc + "\""))
            }
            txn.del(CATALOG, seqRow(&m.key))
            for i in 0..len(t.cols) { if t.cols[i].seq == m.key { t.cols[i].seq = nk } }
            m.key = nk
        }
        try txn.put(CATALOG, seqRow(&m.key), encSeq(&m))
    }
    return Ok(Unit{})
}

// ---- COPY (9.45): rows in and out as text or CSV, the client's input
// whole (the wire collects it) so that a COPY is one statement, run again
// on a conflict as any.

pub const COPY_NONE = 0
pub const COPY_IN = 1
pub const COPY_OUT = 2

// What the client sent for COPY FROM STDIN: its data, or its CopyFail's
// message (proto: a message not of COPY's, the wire's own error).
pub type CopyInput = record { pub have: bool; pub data: str; pub fail: str; pub proto: bool }

fn noInput(): CopyInput { return CopyInput{have: false, data: "", fail: "", proto: false} }

fn copyStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
            lim: Limits, pc: mut &PlanCache, input: &CopyInput): Result[Res, DbErr] {
    if !s.copy.from { return copyOut(st, txn, s, params, ptypes, lim, pc) }
    let t = try needTable(st, txn, &s.table)
    try needRel(st, txn, &(try whoNow(st, txn)), &t.name, &"a", &"table")
    var targets: []int = []
    var names: []str = []
    if len(s.names) == 0 {
        for i in 0..len(t.cols) { append(mut &targets, i) }
    } else {
        for n in s.names {
            let i = colIndex(&t.cols, &n)
            if i < 0 { return Err(e("42703", "column \"" + n + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist")) }
            for k in targets { if k == i { return Err(e("42701", "column \"" + n + "\" specified more than once")) } }
            append(mut &targets, i)
        }
    }
    var cols: []OutCol = []
    for i in targets {
        append(mut &cols, OutCol{name: t.cols[i].name, oid: t.cols[i].typ.oid})
        append(mut &names, t.cols[i].name)
    }
    if !input.have { return Ok(Res{cols: cols, rows: [], tag: "", hasRows: false, copy: COPY_IN}) }
    if input.fail != "" {
        if input.proto { return Err(e("08P01", input.fail)) }
        return Err(e("57014", "COPY from stdin failed: " + input.fail))
    }
    // its identity columns take the values given (as OVERRIDING SYSTEM VALUE)
    let defs = try defaultsOf(st, txn, &t)
    let fw = try fkTables(st, txn, &t, true, false)
    var later: []FkLater = []
    var rd = CopyRd{at: 0, line: 0, start: 0, notNull: try forced(&s.copy.forceNotNull, &names, &"FORCE_NOT_NULL"),
                    forceNull: try forced(&s.copy.forceNull, &names, &"FORCE_NULL")}
    var vs: []Val = []
    var count = 0
    let data = &input.data
    let where = "COPY " + lexdb_sql.baseName(&s.table) + ", line "
    var noUp = noUpsert()                   // COPY has no ON CONFLICT
    let noCols: []lexdb_sql.ColDef = []
    let none: []Val = []
    let noSubs: []SubRes = []
    let noEnv = Env{cols: &noCols, row: &none, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: None}
    if s.copy.header {
        match copyRecord(data, &s.copy, mut &rd, mut &vs) {
            Ok(_) {}
            Err(x) { return Err(within(x, where + rd.line.toStr() + ": " + quoted(&recordText(data, &rd)))) }
        }
    }
    while true {
        match copyRecord(data, &s.copy, mut &rd, mut &vs) {
            Ok(more) { if !more { break } }
            Err(x) { return Err(within(x, where + rd.line.toStr() + ": " + quoted(&recordText(data, &rd)))) }
        }
        let at = where + rd.line.toStr()
        if len(vs) < len(targets) {
            return Err(within(e("22P04", "missing data for column \"" + names[len(vs)] + "\""), at + ": " + quoted(&recordText(data, &rd))))
        }
        if len(vs) > len(targets) {
            return Err(within(e("22P04", "extra data after last expected column"), at + ": " + quoted(&recordText(data, &rd))))
        }
        // each value its column's type here, to say which column is wrong
        for k in 0..len(vs) {
            let raw = vs[k]
            match coerce(raw, &t.cols[targets[k]].typ) {
                Ok(v) { vs[k] = v }
                Err(x) { return Err(within(x, at + ", column " + names[k] + ": " + quoted(&text(&vs[k])))) }
            }
        }
        match insertOne(st, txn, &t, &targets, &vs, &defs, &fw, mut &later, mut &noUp, &noEnv) {
            Ok(_) {}
            Err(x) { return Err(within(x, at)) }
        }
        count += 1
    }
    try fkFinish(st, txn, &fw, mut &later)
    return Ok(Res{cols: [], rows: [], tag: "COPY " + count.toStr(), hasRows: false, copy: COPY_NONE})
}

// An error with where it happened (PostgreSQL's CONTEXT).
fn within(x: DbErr, context: str): DbErr {
    var r = x
    r.context = context
    return r
}

fn quoted(s: &str): str { return "\"" + s + "\"" }

// Where COPY's reading of its input is: the byte, the line of the record
// read last (from 1), and where that record began.
type CopyRd = record {
    at: int
    line: int
    start: int
    notNull: []bool             // per field: FORCE_NOT_NULL
    forceNull: []bool           // per field: FORCE_NULL
}

// Which of names a FORCE option lists (each it lists must be one).
fn forced(list: &[]str, names: &[]str, opt: &str): Result[[]bool, DbErr] {
    var r: []bool = []
    for n in names { append(mut &r, false) }
    for x in list {
        var found = false
        for k in 0..len(names) {
            if names[k] == x {
                r[k] = true
                found = true
            }
        }
        if !found { return Err(e("42703", opt + " column \"" + x + "\" not referenced by COPY")) }
    }
    return Ok(r)
}

// The text of the record read last, without its line's end (one not read
// to its end, an unterminated CSV field: the rest of the data).
fn recordText(data: &str, rd: &CopyRd): str {
    if rd.at <= rd.start { return data[rd.start..len(data)] }
    var end = rd.at
    if end > rd.start && data[end - 1] == '\n' { end -= 1 }
    if end > rd.start && data[end - 1] == '\r' { end -= 1 }
    return data[rd.start..end]
}

// The next record of data into vs (NULL or text per field); false at its
// end (the data's, or a line \. ).
fn copyRecord(data: &str, o: &lexdb_sql.CopyOpts, rd: mut &CopyRd, vs: mut &[]Val): Result[bool, DbErr] {
    let n = len(data)
    if rd.at >= n { return Ok(false) }
    // the end marker: a line \. alone
    if rd.at + 1 < n && data[rd.at] == '\\' && data[rd.at + 1] == '.' {
        let k = rd.at + 2
        if k == n || data[k] == '\n' || (data[k] == '\r' && (k + 1 == n || data[k + 1] == '\n')) { return Ok(false) }
    }
    rd.line += 1
    rd.start = rd.at
    replace(vs, [])
    if !o.csv {
        rd.at = textRecord(data, o, rd.at, vs)
        return Ok(true)
    }
    let first = rd.line
    match csvRecord(data, o, rd.at, mut &rd.line, &rd.notNull, &rd.forceNull, vs) {
        Ok(next) { rd.at = next }
        Err(x) {
            rd.line = first                 // the line it began on, as PostgreSQL says
            return Err(x)
        }
    }
    return Ok(true)
}

// The text format: fields split by the delimiter, backslash escapes, NULL
// written as o.null (compared before the escapes are undone). The index
// after the record's line.
fn textRecord(data: &str, o: &lexdb_sql.CopyOpts, at: int, vs: mut &[]Val): int {
    let n = len(data)
    let d = o.delim[0]
    var b = newStrBuf()
    var raw = at
    var i = at
    while true {
        let end = i >= n || data[i] == '\n' || (data[i] == '\r' && i + 1 < n && data[i + 1] == '\n')
        if end || data[i] == d {
            if data[raw..i] == o.null { append(vs, Val.Null) } else { append(vs, Val.Text(b.toStr())) }
            b.clear()
            if end {
                if i < n && data[i] == '\r' { i += 1 }
                return if i < n { i + 1 } else { n }
            }
            i += 1
            raw = i
            continue
        }
        if data[i] == '\\' && i + 1 < n {
            i = lexdb_sql.unescape(data, i + 1, mut &b)
            continue
        }
        b.addByte(data[i])
        i += 1
    }
    return n
}

// CSV: fields split by the delimiter, quoted with o.quote (in which a
// quote is written after o.escape, and newlines are data); an unquoted
// field equal to o.null is NULL. Lines counted in line (a quoted field may
// hold some). The index after the record.
fn csvRecord(data: &str, o: &lexdb_sql.CopyOpts, at: int, line: mut &int, notNull: &[]bool, forceNull: &[]bool,
             vs: mut &[]Val): Result[int, DbErr] {
    let n = len(data)
    let d = o.delim[0]
    let q = o.quote[0]
    let esc = o.escape[0]
    var b = newStrBuf()
    var i = at
    while true {
        let raw = i
        var quoted = false
        while i < n {
            let c = data[i]
            if c == q {
                quoted = true
                i += 1
                while true {
                    if i >= n { return Err(e("22P04", "unterminated CSV quoted field")) }
                    let c2 = data[i]
                    if c2 == esc && i + 1 < n && (data[i + 1] == q || data[i + 1] == esc) {
                        b.addByte(data[i + 1])
                        i += 2
                        continue
                    }
                    if c2 == q {
                        i += 1
                        break
                    }
                    if c2 == '\n' { line += 1 }
                    b.addByte(c2)
                    i += 1
                }
                continue
            }
            if c == d || c == '\n' || (c == '\r' && i + 1 < n && data[i + 1] == '\n') { break }
            b.addByte(c)
            i += 1
        }
        let k = len(vs)
        let v = b.toStr()
        let isNull = if quoted { k < len(forceNull) && forceNull[k] && v == o.null }
                     else { data[raw..i] == o.null && !(k < len(notNull) && notNull[k]) }
        if isNull { append(vs, Val.Null) } else { append(vs, Val.Text(v)) }
        b.clear()
        if i < n && data[i] == d {
            i += 1
            continue
        }
        if i < n && data[i] == '\r' { i += 1 }
        return Ok(if i < n { i + 1 } else { n })
    }
    return Ok(n)
}

// COPY ... TO STDOUT: its query's rows, a line each (the header first).
fn copyOut(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
           lim: Limits, pc: mut &PlanCache): Result[Res, DbErr] {
    var res = try select(st, txn, &s.inner[0], params, ptypes, lim, pc)
    var names: []str = []
    for c in res.cols { append(mut &names, c.name) }
    var fq = try forced(&s.copy.forceQuote, &names, &"FORCE_QUOTE")
    if s.copy.quoteAll { for k in 0..len(fq) { fq[k] = true } }
    var lines: [][]Val = []
    var b = newStrBuf()
    if s.copy.header {
        for k in 0..len(res.cols) {
            if k > 0 { b.add(s.copy.delim) }
            copyField(&Val.Text(res.cols[k].name), &s.copy, len(res.cols) == 1, false, mut &b)
        }
        b.addByte('\n')
        append(mut &lines, [Val.Text(b.toStr())])
    }
    for r in res.rows {
        b.clear()
        for k in 0..len(r) {
            if k > 0 { b.add(s.copy.delim) }
            copyField(&r[k], &s.copy, len(r) == 1, k < len(fq) && fq[k], mut &b)
        }
        b.addByte('\n')
        append(mut &lines, [Val.Text(b.toStr())])
    }
    let n = len(res.rows)
    return Ok(Res{cols: replace(mut &res.cols, []), rows: lines, tag: "COPY " + n.toStr(), hasRows: false, copy: COPY_OUT})
}

// A value as COPY writes it: in the text format escaped, in CSV quoted
// where it must be.
fn copyField(v: &Val, o: &lexdb_sql.CopyOpts, single: bool, force: bool, b: mut &StrBuf) {
    if isNull(v) {
        b.add(o.null)
        return
    }
    let t = text(v)
    let d = o.delim[0]
    if !o.csv {
        for k in 0..len(t) {
            let c = t[k]
            if c == '\\' { b.add("\\\\") }
            else if c == '\n' { b.add("\\n") }
            else if c == '\r' { b.add("\\r") }
            else if c == '\t' { b.add("\\t") }
            else if c == byte(8) { b.add("\\b") }
            else if c == byte(12) { b.add("\\f") }
            else if c == byte(11) { b.add("\\v") }
            else if c == d {
                b.addByte('\\')
                b.addByte(c)
            } else { b.addByte(c) }
        }
        return
    }
    let q = o.quote[0]
    let esc = o.escape[0]
    // \. alone on a line would end the data
    var must = force || t == o.null || (single && t == "\\.")
    for k in 0..len(t) {
        let c = t[k]
        if c == d || c == q || c == '\n' || c == '\r' { must = true }
    }
    if !must {
        b.add(t)
        return
    }
    b.addByte(q)
    for k in 0..len(t) {
        let c = t[k]
        if c == q || c == esc { b.addByte(esc) }
        b.addByte(c)
    }
    b.addByte(q)
}

// ---- window functions (9.46)
//
// f(args) OVER (PARTITION BY ... ORDER BY ... frame): after the rows are
// found, grouped and HAVING has chosen, before DISTINCT, ORDER BY and
// LIMIT. The rows (a grouped query's groups, with their aggregates) are
// kept (WinRow); per window call, they are sorted by partition and order,
// and each gets the call's value, which the select list and ORDER BY read
// from a slot after the aggregates' (#agg nAggs + i).

const WIN_FNS: []str = ["row_number", "rank", "dense_rank", "percent_rank", "cume_dist", "ntile", "lag", "lead",
                        "first_value", "last_value", "nth_value"]

fn isWinFn(name: &str): bool {
    for w in WIN_FNS { if w == name { return true } }
    return false
}

// A row a window call ranges over: the query's row (a group's first), and
// its aggregates' values.
type WinRow = record { row: []Val; aggs: []Val }

type WinPlan = record {
    fname: str              // row_number ... nth_value, or an aggregate's
    agg: bool               // an aggregate over the frame, with spec
    spec: AggSpec
    args: []Expr            // a ranking or value function's arguments
    part: []Expr
    order: []Expr
    desc: []bool
    nullsFirst: []bool
    mode: int               // FR_ROWS, FR_RANGE, FR_GROUPS
    start: int              // B_*
    startOff: Option[Expr]
    end: int
    endOff: Option[Expr]
    exclude: int            // EX_*
}

fn hasWin(x: &Expr): bool {
    match x {
        Expr.Call(name, args, _) {
            if name == "#win" || name == "#wmark" { return true }
            for a in args { if hasWin(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return hasWin(&a) }
        Expr.Bin(_, a, b) { return hasWin(&a) || hasWin(&b) }
        Expr.IsNull(a, _) { return hasWin(&a) }
        Expr.Cast(a, _) { return hasWin(&a) }
        else { return false }
    }
}

fn hasWinOpt(x: &Option[Expr]): bool {
    match x {
        Some(v) { return hasWin(&v) }
        None { return false }
    }
}

// Whether a window's arguments, partitions or order use aggregates (the
// query is then grouped; a window aggregate itself does not make it so).
fn winHasAgg(d: &lexdb_sql.WinDef): bool {
    match d.call {
        Expr.Call(_, args, _) { for a in args { if hasAgg(&a) { return true } } }
        else {}
    }
    for x in d.part { if hasAgg(&x) { return true } }
    for o in d.order { if hasAgg(&o.expr) { return true } }
    return false
}

fn winNames(d: &lexdb_sql.WinDef, out: mut &[]str) {
    colNames(&d.call, out)
    for x in d.part { colNames(&x, out) }
    for o in d.order { colNames(&o.expr, out) }
}

// x with its window calls (#win i, the call inside) marked (#wmark i), so
// that a window aggregate is not taken for the query's.
fn winMarks(x: &Expr): Expr {
    match x {
        Expr.Call(name, args, star) {
            if name == "#win" { return Expr.Call("#wmark", [clone(&args[0])], false) }
            var out: []Expr = []
            for a in args { append(mut &out, winMarks(&a)) }
            return Expr.Call(name, out, star)
        }
        Expr.Unary(op, a) { return Expr.Unary(op, winMarks(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, winMarks(&a), winMarks(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(winMarks(&a), neg) }
        Expr.Cast(a, t) { return Expr.Cast(winMarks(&a), t) }
        else { return clone(x) }
    }
}

// x with each mark read from its slot, after the aggregates' (base).
fn winSlots(x: &Expr, base: int): Expr {
    match x {
        Expr.Call(name, args, star) {
            if name == "#wmark" { return slotRef(base + litInt(&args[0])) }
            var out: []Expr = []
            for a in args { append(mut &out, winSlots(&a, base)) }
            return Expr.Call(name, out, star)
        }
        Expr.Unary(op, a) { return Expr.Unary(op, winSlots(&a, base)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op, winSlots(&a, base), winSlots(&b, base)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(winSlots(&a, base), neg) }
        Expr.Cast(a, t) { return Expr.Cast(winSlots(&a, base), t) }
        else { return clone(x) }
    }
}

fn optClone(x: &Option[Expr]): Option[Expr] {
    match x {
        Some(v) { return Some(clone(&v)) }
        None { return None }
    }
}

fn cloneFrame(f: &lexdb_sql.Frame): lexdb_sql.Frame {
    return lexdb_sql.Frame{mode: f.mode, start: f.start, startOff: optClone(&f.startOff), end: f.end, endOff: optClone(&f.endOff),
                           exclude: f.exclude}
}

fn cloneWin(d: &lexdb_sql.WinDef): lexdb_sql.WinDef {
    var order: []lexdb_sql.WinOrder = []
    for o in d.order { append(mut &order, lexdb_sql.WinOrder{expr: clone(&o.expr), desc: o.desc, nullsFirst: o.nullsFirst}) }
    return lexdb_sql.WinDef{call: clone(&d.call), ref: d.ref, bare: d.bare, part: cloneAll(&d.part), order: order,
                            frame: cloneFrame(&d.frame)}
}

// A window call's definition with the named window it names merged in,
// by PostgreSQL's rules: OVER w is w as it is; OVER (w ...) takes w's
// partitions and order, and may add an order (if w has none) and a frame
// (w may not have one).
fn mergeWin(d: &lexdb_sql.WinDef, named: &[]lexdb_sql.NamedWin, depth: int): Result[lexdb_sql.WinDef, DbErr] {
    if d.ref == "" { return Ok(cloneWin(d)) }
    var k = -1
    for i in 0..len(named) { if named[i].name == d.ref { k = i } }
    if k < 0 || depth > len(named) { return Err(e("42704", "window \"" + d.ref + "\" does not exist")) }
    var b = try mergeWin(&named[k].def, named, depth + 1)
    b.call = clone(&d.call)
    b.ref = ""
    b.bare = false
    if d.bare { return Ok(b) }
    if len(d.part) > 0 { return Err(e("42P20", "cannot override PARTITION BY clause of window \"" + d.ref + "\"")) }
    if len(b.order) > 0 && len(d.order) > 0 { return Err(e("42P20", "cannot override ORDER BY clause of window \"" + d.ref + "\"")) }
    if b.frame.mode != lexdb_sql.FR_NONE { return Err(e("42P20", "cannot copy window \"" + d.ref + "\" because it has a frame clause")) }
    if len(d.order) > 0 {
        var order: []lexdb_sql.WinOrder = []
        for o in d.order { append(mut &order, lexdb_sql.WinOrder{expr: clone(&o.expr), desc: o.desc, nullsFirst: o.nullsFirst}) }
        b.order = order
    }
    b.frame = cloneFrame(&d.frame)
    return Ok(b)
}

fn noSpec(): AggSpec {
    return AggSpec{fname: "", args: [], star: false, distinct: false, filter: None, order: [], dirs: "", text: ""}
}

fn modeName(m: int): str {
    return if m == lexdb_sql.FR_ROWS { "ROWS" } else if m == lexdb_sql.FR_GROUPS { "GROUPS" } else { "RANGE" }
}

// A window call planned: its function checked, its frame made whole (the
// default: RANGE UNBOUNDED PRECEDING to CURRENT ROW, which without ORDER BY
// is the whole partition: every row a peer).
fn winPlan(d: &lexdb_sql.WinDef): Result[WinPlan, DbErr] {
    var name = ""
    var args: []Expr = []
    var star = false
    match d.call {
        Expr.Call(n, a, st) {
            name = n
            args = cloneAll(&a)
            star = st
        }
        else {}
    }
    let base = aggBase(&name)
    var w = WinPlan{fname: base, agg: false, spec: noSpec(), args: [], part: cloneAll(&d.part), order: [], desc: [], nullsFirst: [],
                    mode: d.frame.mode, start: d.frame.start, startOff: optClone(&d.frame.startOff), end: d.frame.end,
                    endOff: optClone(&d.frame.endOff), exclude: d.frame.exclude}
    for o in d.order {
        append(mut &w.order, clone(&o.expr))
        append(mut &w.desc, o.desc)
        append(mut &w.nullsFirst, o.nullsFirst)
    }
    if w.mode == lexdb_sql.FR_NONE {
        w.mode = lexdb_sql.FR_RANGE
        w.start = lexdb_sql.B_UNBOUNDED_PRECEDING
        w.end = lexdb_sql.B_CURRENT
    }
    if strings.contains(name, " distinct") { return Err(e("0A000", "DISTINCT is not implemented for window functions")) }
    if isAgg(&name) {
        if strings.contains(name, " order:") { return Err(e("0A000", "aggregate ORDER BY is not implemented for window functions")) }
        var specs: []AggSpec = []
        let r = try collectAggs(&d.call, mut &specs)
        w.agg = true
        w.spec = pop(mut &specs)
    } else if isWinFn(&base) {
        if strings.contains(name, " filter") { return Err(e("0A000", "FILTER is not implemented for non-aggregate window functions")) }
        let n = len(args)
        let none = base == "row_number" || base == "rank" || base == "dense_rank" || base == "percent_rank" || base == "cume_dist"
        let ok = (none && n == 0) || (base == "ntile" && n == 1) || ((base == "lag" || base == "lead") && n >= 1 && n <= 3) ||
                 ((base == "first_value" || base == "last_value") && n == 1) || (base == "nth_value" && n == 2)
        if !ok || star { return Err(e("42883", "function " + base + " with " + n.toStr() + " argument" + (if n == 1 { "" } else { "s" }) + " does not exist")) }
        w.args = args
    } else {
        return Err(e("42809", "OVER specified, but " + base + " is not a window function nor an aggregate function"))
    }
    let offs = w.start == lexdb_sql.B_PRECEDING || w.start == lexdb_sql.B_FOLLOWING || w.end == lexdb_sql.B_PRECEDING ||
               w.end == lexdb_sql.B_FOLLOWING
    if w.mode == lexdb_sql.FR_RANGE && offs && len(w.order) != 1 {
        return Err(e("42P20", "RANGE with offset PRECEDING/FOLLOWING requires exactly one ORDER BY column"))
    }
    if w.mode == lexdb_sql.FR_GROUPS && len(w.order) == 0 { return Err(e("42P20", "GROUPS mode requires an ORDER BY clause")) }
    var ns: []str = []
    match w.startOff { Some(x) { colNames(&x, mut &ns) } None {} }
    match w.endOff { Some(x) { colNames(&x, mut &ns) } None {} }
    if len(ns) > 0 { return Err(e("42P10", "argument of " + modeName(w.mode) + " must not contain variables")) }
    return Ok(w)
}

// Two rows' ORDER BY values in a window's order (0: peers).
fn winCmp(a: &[]Val, b: &[]Val, w: &WinPlan): int {
    for k in 0..len(a) {
        let na = isNull(&a[k])
        let nb = isNull(&b[k])
        if na && nb { continue }
        if na { return if w.nullsFirst[k] { -1 } else { 1 } }
        if nb { return if w.nullsFirst[k] { 1 } else { -1 } }
        var c = sortCmp(&a[k], &b[k])
        if w.desc[k] { c = -c }
        if c != 0 { return c }
    }
    return 0
}

// A frame's offset: evaluated once, not NULL, not negative (ROWS and
// GROUPS: a whole number).
fn frameOff(x: &Option[Expr], w: &WinPlan, start: bool, params: &[]Val): Result[Val, DbErr] {
    let which = if start { "starting" } else { "ending" }
    match x {
        Some(v) {
            let noCols: []lexdb_sql.ColDef = []
            let none: []Val = []
            let noSubs: []SubRes = []
            let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none, seq: None}
            let r = try eval(&v, &env)
            if isNull(&r) { return Err(e("22004", "frame " + which + " offset must not be null")) }
            if w.mode != lexdb_sql.FR_RANGE {
                let t = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
                let n = try coerce(r, &t)
                match n {
                    Val.Int(i) { if i < 0 { return Err(e("22013", "frame " + which + " offset must not be negative")) } }
                    else {}
                }
                return Ok(n)
            }
            if try compare(&r, &Val.Int(0)) < 0 { return Err(e("22013", "invalid preceding or following size in window function")) }
            return Ok(r)
        }
        None { return Ok(Val.Int(0)) }
    }
}

// A fraction without its trailing zeros (0.5, not 0.5000000000000000): as
// PostgreSQL's float8 shows percent_rank and cume_dist.
fn shortest(v: Val): Val {
    match v {
        Val.Num(d) {
            match Decimal.parse(d.canonical()) {
                Ok(x) { return Val.Num(x) }
                Err(_) {}
            }
        }
        else {}
    }
    return v
}

fn offInt(v: &Val): int {
    match v {
        Val.Int(i) { return i }
        else { return 0 }
    }
}

// The values of a query's window calls for each of its rows.
fn winValues(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, rows: &[]WinRow, m: &Mats, params: &[]Val,
             rs: mut &Run): Result[[][]Val, DbErr] {
    let sqe = seqEnv(st, txn)
    let q = &sel.q
    let n = len(rows)
    var out: [][]Val = []
    for b in 0..n { append(mut &out, array(len(sel.wins), Val.Null)) }
    let noAggs: []Val = []
    // windows of one partitioning and order share their sort (as PostgreSQL's)
    var specs: []str = []
    for w in sel.wins { append(mut &specs, winSpecText(&w)) }
    var done: []bool = array(len(sel.wins), false)
    for wi in 0..len(sel.wins) {
        if done[wi] { continue }
        let w = &sel.wins[wi]
        // each row's partition and order
        var keys: []str = []
        var ords: [][]Val = []
        for b in 0..n {
            let env = Env{cols: &q.cols, row: &rows[b].row, aggs: &rows[b].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            if len(w.part) == 0 {
                append(mut &keys, "")
            } else {
                var kb = newStrBuf()
                for x in w.part { encIdxPart(mut &kb, &(try evalX(st, txn, q, &x, &env, rs))) }
                append(mut &keys, kb.toStr())
            }
            var ov: []Val = []
            for x in w.order { append(mut &ov, try evalX(st, txn, q, &x, &env, rs)) }
            append(mut &ords, ov)
        }
        var idx: []int = []
        for b in 0..n { append(mut &idx, b) }
        // rows often come in the window's order already (ORDER BY the key the scan follows)
        var sorted = true
        for b in 1..n {
            if keys[b - 1] != keys[b] || winCmp(&ords[b - 1], &ords[b], w) > 0 {
                sorted = false
                break
            }
        }
        if !sorted { collections.sortBy(mut &idx, fn(a: &int, b: &int): int {
            if keys[a] != keys[b] { return if keys[a] < keys[b] { -1 } else { 1 } }
            let c = winCmp(&ords[a], &ords[b], w)
            if c != 0 { return c }
            return a - b                        // peers keep the rows' order
        }) }
        for wj in wi..len(sel.wins) {
            if done[wj] || specs[wj] != specs[wi] { continue }
            done[wj] = true
            let wv = &sel.wins[wj]
            let so = try frameOff(&wv.startOff, wv, true, params)
            let eo = try frameOff(&wv.endOff, wv, false, params)
            var lo = 0
            while lo < n {
                var hi = lo + 1
                while hi < n && keys[idx[hi]] == keys[idx[lo]] { hi += 1 }
                try winPartition(st, txn, sel, wj, rows, &idx, lo, hi, &ords, &so, &eo, m, params, rs, mut &out)
                lo = hi
            }
        }
    }
    return Ok(out)
}

// A window's partitioning and order as text: windows with the same share
// a sort.
fn winSpecText(w: &WinPlan): str {
    var b = newStrBuf()
    for x in w.part {
        b.add(lexdb_sql.exprText(&x))
        b.add(";")
    }
    b.add("|")
    for k in 0..len(w.order) {
        b.add(lexdb_sql.exprText(&w.order[k]))
        b.add(if w.desc[k] { " d" } else { " a" })
        b.add(if w.nullsFirst[k] { "f;" } else { "l;" })
    }
    return b.toStr()
}

// The frame's first and last positions in the partition (k the current
// row's; may be empty: first > last).
fn frameBounds(w: &WinPlan, k: int, n: int, grp: &[]int, gStart: &[]int, gEnd: &[]int, keyAt: &[]Val, so: &Val, eo: &Val,
               first: mut &int, last: mut &int): Result[Unit, DbErr] {
    let g = grp[k]
    let ng = len(gStart)
    var a = 0
    var b = n - 1
    if w.mode == lexdb_sql.FR_ROWS {
        if w.start == lexdb_sql.B_PRECEDING { a = k - offInt(so) }
        else if w.start == lexdb_sql.B_CURRENT { a = k }
        else if w.start == lexdb_sql.B_FOLLOWING { a = k + offInt(so) }
        if w.end == lexdb_sql.B_PRECEDING { b = k - offInt(eo) }
        else if w.end == lexdb_sql.B_CURRENT { b = k }
        else if w.end == lexdb_sql.B_FOLLOWING { b = k + offInt(eo) }
    } else if w.mode == lexdb_sql.FR_GROUPS {
        if w.start == lexdb_sql.B_PRECEDING { a = if g - offInt(so) < 0 { 0 } else { gStart[g - offInt(so)] } }
        else if w.start == lexdb_sql.B_CURRENT { a = gStart[g] }
        else if w.start == lexdb_sql.B_FOLLOWING { a = if g + offInt(so) >= ng { n } else { gStart[g + offInt(so)] } }
        if w.end == lexdb_sql.B_PRECEDING { b = if g - offInt(eo) < 0 { -1 } else { gEnd[g - offInt(eo)] - 1 } }
        else if w.end == lexdb_sql.B_CURRENT { b = gEnd[g] - 1 }
        else if w.end == lexdb_sql.B_FOLLOWING { b = if g + offInt(eo) >= ng { n - 1 } else { gEnd[g + offInt(eo)] - 1 } }
    } else {
        // RANGE: by the one ORDER BY value; a NULL one's frame is its peers
        if w.start == lexdb_sql.B_CURRENT { a = gStart[g] }
        if w.end == lexdb_sql.B_CURRENT { b = gEnd[g] - 1 }
        let sOff = w.start == lexdb_sql.B_PRECEDING || w.start == lexdb_sql.B_FOLLOWING
        let eOff = w.end == lexdb_sql.B_PRECEDING || w.end == lexdb_sql.B_FOLLOWING
        if sOff || eOff {
            let v = &keyAt[k]
            if isNull(v) {
                if sOff { a = gStart[g] }
                if eOff { b = gEnd[g] - 1 }
            } else {
                if sOff {
                    let t = try rangeTarget(v, so, w.start == lexdb_sql.B_PRECEDING, w.desc[0])
                    a = try firstNot(keyAt, &t, w, false)
                }
                if eOff {
                    let t = try rangeTarget(v, eo, w.end == lexdb_sql.B_PRECEDING, w.desc[0])
                    b = (try firstNot(keyAt, &t, w, true)) - 1
                }
            }
        }
    }
    first = if a < 0 { 0 } else { a }
    last = if b > n - 1 { n - 1 } else { b }
    return Ok(Unit{})
}

// v - off or v + off: the value a RANGE bound stands at (preceding rows
// have smaller values going up, larger going down).
fn rangeTarget(v: &Val, off: &Val, preceding: bool, desc: bool): Result[Val, DbErr] {
    return arith(&(if preceding != desc { "-" } else { "+" }), v, off)
}

// The first position whose value is not before t (after: not after t is
// the test, so this is one past the last at or before it), in the
// window's order: the values sorted, NULLs at one end.
fn firstNot(keyAt: &[]Val, t: &Val, w: &WinPlan, after: bool): Result[int, DbErr] {
    var lo = 0
    var hi = len(keyAt)
    while lo < hi {
        let mid = (lo + hi) / 2
        var c = 0
        if isNull(&keyAt[mid]) { c = if w.nullsFirst[0] { -1 } else { 1 } } else {
            c = try compare(&keyAt[mid], t)
            if w.desc[0] { c = -c }
        }
        // before: c < 0; at or before: c <= 0
        let moveOn = if after { c <= 0 } else { c < 0 }
        if moveOn { lo = mid + 1 } else { hi = mid }
    }
    return Ok(lo)
}

// Whether frame position p is left out of row k's frame (EXCLUDE).
fn excluded(w: &WinPlan, p: int, k: int, grp: &[]int): bool {
    if w.exclude == lexdb_sql.EX_CURRENT { return p == k }
    if w.exclude == lexdb_sql.EX_GROUP { return grp[p] == grp[k] }
    if w.exclude == lexdb_sql.EX_TIES { return grp[p] == grp[k] && p != k }
    return false
}

// One partition's values of window call wi: its rows rows[idx[lo..hi]],
// in its order.
fn winPartition(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, wi: int, rows: &[]WinRow, idx: &[]int, lo: int,
                hi: int, ords: &[][]Val, so: &Val, eo: &Val, m: &Mats, params: &[]Val, rs: mut &Run,
                out: mut &[][]Val): Result[Unit, DbErr] {
    let sqe = seqEnv(st, txn)
    let q = &sel.q
    let w = &sel.wins[wi]
    let n = hi - lo
    let noAggs: []Val = []
    // peer groups: rows equal in the window's ORDER BY
    var grp: []int = []
    var gStart: []int = []
    var gEnd: []int = []
    for k in 0..n {
        if k == 0 || winCmp(&ords[idx[lo + k - 1]], &ords[idx[lo + k]], w) != 0 {
            if k > 0 { append(mut &gEnd, k) }
            append(mut &gStart, k)
        }
        append(mut &grp, len(gStart) - 1)
    }
    append(mut &gEnd, n)
    var keyAt: []Val = []
    if w.mode == lexdb_sql.FR_RANGE && len(w.order) == 1 { for k in 0..n { append(mut &keyAt, ords[idx[lo + k]][0]) } }
    let f = w.fname
    if f == "row_number" || f == "rank" || f == "dense_rank" || f == "percent_rank" || f == "cume_dist" {
        for k in 0..n {
            let g = grp[k]
            var v = Val.Int(k + 1)
            if f == "rank" { v = Val.Int(gStart[g] + 1) }
            if f == "dense_rank" { v = Val.Int(g + 1) }
            if f == "percent_rank" {
                v = if n <= 1 { Val.Num(Decimal.fromInt(0)) } else {
                    try arith(&"/", &Val.Num(Decimal.fromInt(gStart[g])), &Val.Num(Decimal.fromInt(n - 1)))
                }
            }
            if f == "cume_dist" { v = try arith(&"/", &Val.Num(Decimal.fromInt(gEnd[g])), &Val.Num(Decimal.fromInt(n))) }
            if f == "percent_rank" || f == "cume_dist" { v = shortest(v) }
            out[idx[lo + k]][wi] = v
        }
        return Ok(Unit{})
    }
    if f == "ntile" || f == "lag" || f == "lead" {
        for k in 0..n {
            let r = idx[lo + k]
            let env = Env{cols: &q.cols, row: &rows[r].row, aggs: &rows[r].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            if f == "ntile" {
                let bv = try evalX(st, txn, q, &w.args[0], &env, rs)
                if isNull(&bv) { continue }
                let t = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
                let nb = offInt(&(try coerce(bv, &t)))
                if nb <= 0 { return Err(e("22014", "argument of ntile must be greater than zero")) }
                // n rows in nb buckets: the first n % nb one row bigger
                let size = n / nb
                let extra = n % nb
                var bucket = k + 1
                if size > 0 {
                    bucket = if k < (size + 1) * extra { k / (size + 1) + 1 } else { extra + (k - (size + 1) * extra) / size + 1 }
                }
                out[r][wi] = Val.Int(bucket)
                continue
            }
            var off = 1
            if len(w.args) > 1 {
                let ov = try evalX(st, txn, q, &w.args[1], &env, rs)
                if isNull(&ov) { continue }
                let t = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
                off = offInt(&(try coerce(ov, &t)))
            }
            let at = if f == "lag" { k - off } else { k + off }
            if at >= 0 && at < n {
                let tr = idx[lo + at]
                let env2 = Env{cols: &q.cols, row: &rows[tr].row, aggs: &rows[tr].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
                out[r][wi] = try evalX(st, txn, q, &w.args[0], &env2, rs)
            } else if len(w.args) > 2 {
                out[r][wi] = try evalX(st, txn, q, &w.args[2], &env, rs)
            }
        }
        return Ok(Unit{})
    }
    // over the frame: an aggregate, first_value, last_value, nth_value
    if w.agg && w.start == lexdb_sql.B_UNBOUNDED_PRECEDING && w.exclude == lexdb_sql.EX_NONE {
        // the frame only grows: one accumulator, its value made again only when it does
        var acc = newAccs(1)
        var added = -1
        var lastEnd = -2
        var val = Val.Null
        for k in 0..n {
            var a = 0
            var b = 0
            try frameBounds(w, k, n, &grp, &gStart, &gEnd, &keyAt, so, eo, mut &a, mut &b)
            while added < b {
                added += 1
                let tr = idx[lo + added]
                let env = Env{cols: &q.cols, row: &rows[tr].row, aggs: &rows[tr].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
                try accumulate(&w.spec, mut &acc[0], &env)
            }
            if b != lastEnd {
                val = try finish(&w.spec, &acc[0])
                lastEnd = b
            }
            out[idx[lo + k]][wi] = val
        }
        return Ok(Unit{})
    }
    for k in 0..n {
        let r = idx[lo + k]
        var a = 0
        var b = 0
        try frameBounds(w, k, n, &grp, &gStart, &gEnd, &keyAt, so, eo, mut &a, mut &b)
        if w.agg {
            var acc = newAccs(1)
            for p in a..b + 1 {
                if excluded(w, p, k, &grp) { continue }
                let tr = idx[lo + p]
                let env = Env{cols: &q.cols, row: &rows[tr].row, aggs: &rows[tr].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
                try accumulate(&w.spec, mut &acc[0], &env)
            }
            out[r][wi] = try finish(&w.spec, &acc[0])
            continue
        }
        var nth = 1
        if f == "nth_value" {
            let env = Env{cols: &q.cols, row: &rows[r].row, aggs: &rows[r].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            let nv = try evalX(st, txn, q, &w.args[1], &env, rs)
            if isNull(&nv) { continue }
            let t = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
            nth = offInt(&(try coerce(nv, &t)))
            if nth <= 0 { return Err(e("22016", "argument of nth_value must be greater than zero")) }
        }
        // the frame's rows, those excluded left out
        var at = -1
        var seen = 0
        if f == "last_value" {
            var p = b
            while p >= a {
                if !excluded(w, p, k, &grp) {
                    at = p
                    break
                }
                p -= 1
            }
        } else {
            for p in a..b + 1 {
                if excluded(w, p, k, &grp) { continue }
                seen += 1
                if seen == nth {
                    at = p
                    break
                }
            }
        }
        if at >= 0 {
            let tr = idx[lo + at]
            let env = Env{cols: &q.cols, row: &rows[tr].row, aggs: &rows[tr].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: sqe}
            out[r][wi] = try evalX(st, txn, q, &w.args[0], &env, rs)
        }
    }
    return Ok(Unit{})
}

// ---- Batches (design/lexdb.md 9.47, a prototype)
//
// An aggregate query over one table, read in primary key order, runs over
// batches of rows: each batch's columns used are decoded into arrays (an
// integer or boolean column as ints and NULL flags, any other as values),
// the WHERE narrows a list of the rows chosen (one loop per condition, not
// one tree walk per row), and each aggregate adds a column's values into
// plain accumulators per group. The groups end as the row path leaves
// them (Groups), so HAVING, the output and ORDER BY run as before. A query
// of another shape, or a stored value of an unexpected kind, gives false:
// the row path runs instead.

const BROWS = 1024

const BK_INT = 0        // a column's kind in a batch: an integer ...
const BK_BOOL = 1       // ... a boolean (0, 1) ...
const BK_VAL = 2        // ... or any other, as values
const BK_NONE = -1      // a query's column not in the batch (of another table)

const BT_INT = 0        // an expression's type in a batch
const BT_BOOL = 1
const BT_NULL = 2       // a NULL constant: any type
const BT_OTHER = 3      // a column of another type: IS NULL and count only

const BA_STAR = 0       // count(*)
const BA_COUNT = 1
const BA_SUM = 2
const BA_AVG = 3
const BA_MIN = 4
const BA_MAX = 5

// A column of a batch, or an expression's values for the rows chosen.
type BVec = record {
    v: []int
    nul: []bool
}

type Batch = record {
    cols: []BVec            // per column of the row ([] those not used)
    vals: [][]Val           // per column of kind BK_VAL: its values
    n: int
}

// An expression over a batch. Operators: + - * / % as 0 to 4; = <> < <=
// > >= as 0 to 5.
type BNode = closed {
    Const(int, bool)        // the value, NULL
    Col(int)
    Arith(int, BNode, BNode)
    Neg(BNode)
    Cmp(int, BNode, BNode)
    And(BNode, BNode)
    Or(BNode, BNode)
    Not(BNode)
    IsNull(BNode, bool)     // true: IS NOT NULL
    // a column of values (BK_VAL) compared with a constant, as eval
    // compares them (compare); true: the constant on the left
    ValCmp(int, int, Val, bool)
    Like(int, LikePat)      // a column of values LIKE (ILIKE) a constant pattern
}

type LikePat = record {
    pat: str
    esc: str
    fold: bool              // ILIKE
    simple: bool            // literal text and % only (likeSimple): pieces
    pieces: []str
}

type BComp = record {
    n: BNode
    typ: int
}

type BSpec = record {
    kind: int
    arg: Option[BNode]
    filter: Option[BNode]
    // a column of values (BK_VAL) whose min, max, or numeric sum or avg
    // this is (9.52): its values kept per group as the row path keeps
    // them (bAccVal); -1 an integer aggregate
    vcol: int
}

type RawRows = record {
    keys: []str
    vals: []str
}

fn colKind(c: &lexdb_sql.ColDef): int {
    let o = c.typ.oid
    if o == lexdb_sql.OID_INT2 || o == lexdb_sql.OID_INT4 || o == lexdb_sql.OID_INT8 { return BK_INT }
    if o == lexdb_sql.OID_BOOL { return BK_BOOL }
    return BK_VAL
}

// Whether x has no column (its value is the same for every row).
fn bConst(x: &Expr): bool {
    match x {
        Expr.Lit(_) { return true }
        Expr.Param(_) { return true }
        Expr.Col(_) { return false }
        Expr.Unary(_, a) { return bConst(&a) }
        Expr.Bin(_, a, b) { return bConst(&a) && bConst(&b) }
        Expr.IsNull(a, _) { return bConst(&a) }
        Expr.Cast(a, _) { return bConst(&a) }
        Expr.Call(_, _, _) { return false }
    }
}

fn arithCode(op: &str): int {
    if op == "+" { return 0 }
    if op == "-" { return 1 }
    if op == "*" { return 2 }
    if op == "/" { return 3 }
    if op == "%" { return 4 }
    return -1
}

fn cmpCode(op: &str): int {
    if op == "=" { return 0 }
    if op == "<>" { return 1 }
    if op == "<" { return 2 }
    if op == "<=" { return 3 }
    if op == ">" { return 4 }
    if op == ">=" { return 5 }
    return -1
}

// c's node (c given up).
fn takeN(c: BComp): BNode {
    var x = c
    return replace(mut &x.n, BNode.Const(0, false))
}

fn intLike(t: int): bool { return t == BT_INT || t == BT_NULL }
fn boolLike(t: int): bool { return t == BT_BOOL || t == BT_NULL }

// x over a batch; None: not one the batches evaluate (the row path does).
fn bCompile(x: &Expr, q: &Query, kinds: &[]int, env: &Env): Option[BComp] {
    if bConst(x) {
        // its value once; an error is left for the row path to give
        match eval(x, env) {
            Ok(v) {
                match v {
                    Val.Int(i) { return Some(BComp{n: BNode.Const(i, false), typ: BT_INT}) }
                    Val.Bool(b) { return Some(BComp{n: BNode.Const(if b { 1 } else { 0 }, false), typ: BT_BOOL}) }
                    Val.Null { return Some(BComp{n: BNode.Const(0, true), typ: BT_NULL}) }
                    else { return None }
                }
            }
            Err(_) { return None }
        }
    }
    match x {
        Expr.Col(name) {
            let i = colIndex(&q.cols, &name)
            // (a column of another table than the one batched: BK_NONE)
            if i < 0 || i >= len(kinds) || kinds[i] == BK_NONE { return None }
            let k = kinds[i]
            return Some(BComp{n: BNode.Col(i), typ: if k == BK_INT { BT_INT } else if k == BK_BOOL { BT_BOOL } else { BT_OTHER }})
        }
        Expr.Unary(op, a) {
            let ca = bCompile(&a, q, kinds, env)
            if ca.isNone() { return None }
            let c = ca.unwrap()
            let ty = c.typ
            if op == "not" && boolLike(ty) { return Some(BComp{n: BNode.Not(takeN(c)), typ: BT_BOOL}) }
            if op == "-" && intLike(ty) { return Some(BComp{n: BNode.Neg(takeN(c)), typ: BT_INT}) }
            return None
        }
        Expr.Bin(op, a, b) {
            let vc = bValCmp(&op, &a, &b, q, kinds, env)
            if vc.isSome() { return vc }
            let ca = bCompile(&a, q, kinds, env)
            if ca.isNone() { return None }
            let cb = bCompile(&b, q, kinds, env)
            if cb.isNone() { return None }
            let lc = ca.unwrap()
            let rc = cb.unwrap()
            let lt = lc.typ
            let rt = rc.typ
            let l = takeN(lc)
            let r = takeN(rc)
            if op == "and" || op == "or" {
                if !boolLike(lt) || !boolLike(rt) { return None }
                if op == "and" { return Some(BComp{n: BNode.And(l, r), typ: BT_BOOL}) }
                return Some(BComp{n: BNode.Or(l, r), typ: BT_BOOL})
            }
            let cc = cmpCode(&op)
            if cc >= 0 {
                let ok = (intLike(lt) && intLike(rt)) || (boolLike(lt) && boolLike(rt))
                if !ok { return None }
                return Some(BComp{n: BNode.Cmp(cc, l, r), typ: BT_BOOL})
            }
            let ac = arithCode(&op)
            if ac >= 0 && intLike(lt) && intLike(rt) { return Some(BComp{n: BNode.Arith(ac, l, r), typ: BT_INT}) }
            return None
        }
        Expr.IsNull(a, neg) {
            let ca = bCompile(&a, q, kinds, env)
            if ca.isNone() { return None }
            return Some(BComp{n: BNode.IsNull(takeN(ca.unwrap()), neg), typ: BT_BOOL})
        }
        Expr.Call(name, args, star) {
            if star || (name != "like" && name != "ilike") || len(args) < 2 || len(args) > 3 { return None }
            let c = bValCol(&args[0], q, kinds)
            if c < 0 { return None }
            var cs: []Val = []
            for i in 1..len(args) {
                if !bConst(&args[i]) { return None }
                match eval(&args[i], env) {
                    Ok(v) { append(mut &cs, v) }
                    Err(_) { return None }
                }
            }
            for v in cs { if isNull(&v) { return Some(BComp{n: BNode.Const(0, true), typ: BT_NULL}) } }
            let pat = text(&cs[0])
            let esc = if len(cs) > 1 { text(&cs[1]) } else { "\\" }
            let fold = name == "ilike"
            let simple = !fold && likeSimple(&pat, &esc) && len(strings.runes(esc)) <= 1
            let pieces = if simple { likeSplit(&pat) } else { [] }
            return Some(BComp{n: BNode.Like(c, LikePat{pat: pat, esc: esc, fold: fold, simple: simple, pieces: pieces}), typ: BT_BOOL})
        }
        else { return None }
    }
}

// The batch column of x when it is a column of values (BK_VAL), else -1.
fn bValCol(x: &Expr, q: &Query, kinds: &[]int): int {
    match x {
        Expr.Col(name) {
            let i = colIndex(&q.cols, &name)
            if i < 0 || i >= len(kinds) || kinds[i] != BK_VAL { return -1 }
            return i
        }
        else { return -1 }
    }
}

// a op b, one a column of values and the other a constant (its value made
// once): ValCmp. None otherwise, or when the constant gives an error (the
// row path gives it).
fn bValCmp(op: &str, a: &Expr, b: &Expr, q: &Query, kinds: &[]int, env: &Env): Option[BComp] {
    let cc = cmpCode(op)
    if cc < 0 { return None }
    let ca = bValCol(a, q, kinds)
    if ca >= 0 { return bValCmpOf(cc, ca, b, false, env) }
    let cb = bValCol(b, q, kinds)
    if cb >= 0 { return bValCmpOf(cc, cb, a, true, env) }
    return None
}

fn bValCmpOf(cc: int, c: int, k: &Expr, left: bool, env: &Env): Option[BComp] {
    if !bConst(k) { return None }
    match eval(k, env) {
        Ok(v) { return Some(BComp{n: BNode.ValCmp(cc, c, v, left), typ: BT_BOOL}) }
        Err(_) { return None }
    }
}

fn bvec(m: int): BVec { return BVec{v: array(m, 0), nul: array(m, false)} }

// n's values for the rows idx of b.
fn bEval(n: &BNode, b: &Batch, idx: &[]int): Result[BVec, DbErr] {
    let m = len(idx)
    match n {
        BNode.Const(v, nul) { return Ok(BVec{v: array(m, v), nul: array(m, nul)}) }
        BNode.Col(c) {
            var out = bvec(m)
            let src = &b.cols[c]
            for j in 0..m {
                let r = idx[j]
                out.v[j] = src.v[r]
                out.nul[j] = src.nul[r]
            }
            return Ok(out)
        }
        BNode.Arith(op, x, y) {
            var a = try bEval(&x, b, idx)
            let c = try bEval(&y, b, idx)
            for j in 0..m { if c.nul[j] { a.nul[j] = true } }
            if op == 0 {
                for j in 0..m {
                    if a.nul[j] { continue }
                    match a.v[j].checkedAdd(c.v[j]) {
                        Some(r) { a.v[j] = r }
                        None { return Err(e("22003", "bigint out of range")) }
                    }
                }
            } else if op == 1 {
                for j in 0..m {
                    if a.nul[j] { continue }
                    match a.v[j].checkedSub(c.v[j]) {
                        Some(r) { a.v[j] = r }
                        None { return Err(e("22003", "bigint out of range")) }
                    }
                }
            } else if op == 2 {
                for j in 0..m {
                    if a.nul[j] { continue }
                    match a.v[j].checkedMul(c.v[j]) {
                        Some(r) { a.v[j] = r }
                        None { return Err(e("22003", "bigint out of range")) }
                    }
                }
            } else {
                for j in 0..m {
                    if a.nul[j] { continue }
                    if c.v[j] == 0 { return Err(e("22012", "division by zero")) }
                    let r = if op == 3 { a.v[j].checkedDiv(c.v[j]) } else { a.v[j].checkedRem(c.v[j]) }
                    match r {
                        Some(w) { a.v[j] = w }
                        None { return Err(e("22003", "bigint out of range")) }
                    }
                }
            }
            return Ok(a)
        }
        BNode.Neg(x) {
            var a = try bEval(&x, b, idx)
            for j in 0..m {
                if a.nul[j] { continue }
                match (0).checkedSub(a.v[j]) {
                    Some(r) { a.v[j] = r }
                    None { return Err(e("22003", "bigint out of range")) }
                }
            }
            return Ok(a)
        }
        BNode.ValCmp(op, c, k, left) {
            var out = bvec(m)
            let kn = isNull(&k)
            for j in 0..m {
                let r = idx[j]
                if kn || b.cols[c].nul[r] {
                    out.nul[j] = true
                    continue
                }
                let x = if left { try compare(&k, &b.vals[c][r]) } else { try compare(&b.vals[c][r], &k) }
                let t = if op == 0 { x == 0 } else if op == 1 { x != 0 } else if op == 2 { x < 0 } else if op == 3 { x <= 0 }
                        else if op == 4 { x > 0 } else { x >= 0 }
                out.v[j] = if t { 1 } else { 0 }
            }
            return Ok(out)
        }
        BNode.Like(c, lp) {
            var out = bvec(m)
            for j in 0..m {
                let r = idx[j]
                if b.cols[c].nul[r] {
                    out.nul[j] = true
                    continue
                }
                let hit = if lp.simple {
                    match b.vals[c][r] {
                        Val.Text(x) { likePieces(&x, &lp.pieces) }
                        else { likePieces(&text(&b.vals[c][r]), &lp.pieces) }
                    }
                } else {
                    try likeMatch(text(&b.vals[c][r]), lp.pat, lp.esc, lp.fold)
                }
                out.v[j] = if hit { 1 } else { 0 }
            }
            return Ok(out)
        }
        BNode.Cmp(op, x, y) {
            var a = try bEval(&x, b, idx)
            match y {
                BNode.Const(k, kn) {
                    // against a constant: one loop with it in a register
                    if kn {
                        for j in 0..m { a.nul[j] = true }
                        return Ok(a)
                    }
                    cmpConst(op, mut &a, k)
                    return Ok(a)
                }
                else {}
            }
            let c = try bEval(&y, b, idx)
            for j in 0..m { if c.nul[j] { a.nul[j] = true } }
            if op == 0 { for j in 0..m { a.v[j] = if a.v[j] == c.v[j] { 1 } else { 0 } } }
            else if op == 1 { for j in 0..m { a.v[j] = if a.v[j] != c.v[j] { 1 } else { 0 } } }
            else if op == 2 { for j in 0..m { a.v[j] = if a.v[j] < c.v[j] { 1 } else { 0 } } }
            else if op == 3 { for j in 0..m { a.v[j] = if a.v[j] <= c.v[j] { 1 } else { 0 } } }
            else if op == 4 { for j in 0..m { a.v[j] = if a.v[j] > c.v[j] { 1 } else { 0 } } }
            else { for j in 0..m { a.v[j] = if a.v[j] >= c.v[j] { 1 } else { 0 } } }
            return Ok(a)
        }
        BNode.And(x, y) {
            // y only for the rows x leaves open (true or NULL), as eval
            var a = try bEval(&x, b, idx)
            var sub: []int = []
            for j in 0..m { if a.nul[j] || a.v[j] != 0 { append(mut &sub, idx[j]) } }
            if len(sub) == 0 { return Ok(a) }
            let c = try bEval(&y, b, &sub)
            var k = 0
            for j in 0..m {
                if !a.nul[j] && a.v[j] == 0 { continue }
                if !c.nul[k] && c.v[k] == 0 {
                    a.v[j] = 0
                    a.nul[j] = false
                } else if a.nul[j] || c.nul[k] {
                    a.nul[j] = true
                } else {
                    a.v[j] = 1
                }
                k += 1
            }
            return Ok(a)
        }
        BNode.Or(x, y) {
            var a = try bEval(&x, b, idx)
            var sub: []int = []
            for j in 0..m { if a.nul[j] || a.v[j] == 0 { append(mut &sub, idx[j]) } }
            if len(sub) == 0 { return Ok(a) }
            let c = try bEval(&y, b, &sub)
            var k = 0
            for j in 0..m {
                if !a.nul[j] && a.v[j] != 0 { continue }
                if !c.nul[k] && c.v[k] != 0 {
                    a.v[j] = 1
                    a.nul[j] = false
                } else if a.nul[j] || c.nul[k] {
                    a.nul[j] = true
                } else {
                    a.v[j] = 0
                }
                k += 1
            }
            return Ok(a)
        }
        BNode.Not(x) {
            var a = try bEval(&x, b, idx)
            for j in 0..m { a.v[j] = 1 - a.v[j] }
            return Ok(a)
        }
        BNode.IsNull(x, neg) {
            var a = try bEval(&x, b, idx)
            for j in 0..m {
                a.v[j] = if a.nul[j] != neg { 1 } else { 0 }
                a.nul[j] = false
            }
            return Ok(a)
        }
    }
}

fn cmpConst(op: int, a: mut &BVec, k: int) {
    let m = len(a.v)
    if op == 0 { for j in 0..m { a.v[j] = if a.v[j] == k { 1 } else { 0 } } }
    else if op == 1 { for j in 0..m { a.v[j] = if a.v[j] != k { 1 } else { 0 } } }
    else if op == 2 { for j in 0..m { a.v[j] = if a.v[j] < k { 1 } else { 0 } } }
    else if op == 3 { for j in 0..m { a.v[j] = if a.v[j] <= k { 1 } else { 0 } } }
    else if op == 4 { for j in 0..m { a.v[j] = if a.v[j] > k { 1 } else { 0 } } }
    else { for j in 0..m { a.v[j] = if a.v[j] >= k { 1 } else { 0 } } }
}

// The positions j of idx whose row n holds for (true, not NULL).
fn bTrue(n: &BNode, b: &Batch, idx: &[]int): Result[[]int, DbErr] {
    let t = try bEval(n, b, idx)
    var out: []int = []
    for j in 0..len(idx) { if t.v[j] == 1 && !t.nul[j] { append(mut &out, j) } }
    return Ok(out)
}

// Up to BROWS stored rows of a scan, from the cursor on.
fn fetchRaw(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, sc: &Scan, part: bool,
            cur: mut &Cursor): Result[RawRows, DbErr] {
    var ks: []str = []
    var vs: []str = []
    if sc.empty {
        cur.done = true
        return Ok(RawRows{keys: ks, vals: vs})
    }
    if sc.point {
        cur.done = true
        let got = if part { try st.getPart(txn, t.tree, sc.lo) } else { try st.get(txn, t.tree, sc.lo) }
        match got {
            Some(v) {
                append(mut &ks, sc.lo)
                append(mut &vs, v)
            }
            None {}
        }
        return Ok(RawRows{keys: ks, vals: vs})
    }
    let from = if cur.started { cur.at } else { sc.lo }
    cur.started = true
    var last = ""
    if part {
        try st.scanPart(txn, t.tree, from, sc.hi, fn(en: &lexdb_store.Entry): bool {
            append(mut &ks, en.key)
            append(mut &vs, en.val)
            last = en.key
            return len(vs) < BROWS
        })
    } else {
        try st.scan(txn, t.tree, from, sc.hi, fn(en: &lexdb_store.Entry): bool {
            append(mut &ks, en.key)
            append(mut &vs, en.val)
            last = en.key
            return len(vs) < BROWS
        })
    }
    if len(vs) < BROWS { cur.done = true } else { cur.at = after(&last) }
    return Ok(RawRows{keys: ks, vals: vs})
}

// Puts value v at row r of column c; false: not of the column's kind.
fn bPut(b: mut &Batch, c: int, r: int, v: Val, kind: int): bool {
    match v {
        Val.Null {
            b.cols[c].nul[r] = true
            return true
        }
        Val.Int(i) {
            if kind == BK_INT {
                b.cols[c].v[r] = i
                return true
            }
        }
        Val.Bool(x) {
            if kind == BK_BOOL {
                b.cols[c].v[r] = if x { 1 } else { 0 }
                return true
            }
        }
        else {}
    }
    if kind != BK_VAL { return false }
    b.vals[c][r] = v
    return true
}

// Where a batch reads the columns used: per place its column (-1 none),
// the places used in order, the last one's end (a tagged row is read to it).
type BPlan = record {
    kinds: []int            // per column of the table: BK_*
    needCol: []bool
    placeCol: []int
    usedP: []int
    stopAt: int
    missing: []Val          // by place
    needP: []bool           // by place, for decRowNeed and rowOf
    width: int
}

fn newBatch(bp: &BPlan, cap: int): Batch {
    var b = Batch{cols: [], vals: [], n: 0}
    for i in 0..len(bp.kinds) {
        if bp.needCol[i] { append(mut &b.cols, bvec(cap)) } else { append(mut &b.cols, bvec(0)) }
        if bp.needCol[i] && bp.kinds[i] == BK_VAL { append(mut &b.vals, array(cap, Val.Null)) } else { append(mut &b.vals, []) }
    }
    return b
}

// Decodes stored row s into row r of b: 0 done, 1 a value of a kind its
// column's batch does not hold (the row path reads the query), 2 a value
// stored apart (the store must be read: the caller's).
fn bRowInto(s: &str, r: int, b: mut &Batch, bp: &BPlan, t: &Table): Result[int, DbErr] {
    let kinds = &bp.kinds
    let placeCol = &bp.placeCol
    let missing = &bp.missing
    if len(s) > 0 && s[0] == FIXED {
        // one load per column used, at its offset (9.50)
        let lay = &t.lays[try layOf(s, &t.lays)]
        let np = len(lay.kinds)
        for pl in bp.usedP {
            let c = placeCol[pl]
            let k = kinds[c]
            if pl >= np {
                let mv = if pl < len(missing) { missing[pl] } else { Val.Null }
                if !bPut(b, c, r, mv, k) { return Ok(1) }
                continue
            }
            let pk = lay.kinds[pl]
            if pk == PK_NONE || (int(s[lay.bm + pl / 8]) >> (pl % 8)) & 1 == 1 {
                b.cols[c].nul[r] = true
            } else if k == BK_INT && isIntKind(pk) {
                b.cols[c].v[r] = readIntK(s, lay.off[pl], pk)
            } else if pk == PK_BOOL && k == BK_BOOL {
                b.cols[c].v[r] = if s[lay.off[pl]] == 1 { 1 } else { 0 }
            } else if k != BK_VAL {
                return Ok(1)
            } else {
                b.vals[c][r] = try fixedVal(s, pl, pk, lay)
            }
        }
        return Ok(0)
    }
    if lexdb_store.partOf(s).isSome() || (len(s) > 0 && s[0] == 0xFF) { return Ok(2) }
    if len(s) > 0 && s[0] == 6 {
        // a row with long texts, kept whole in its leaf: read as the row path reads it
        let places = try decRowNeed(s, bp.width, &bp.needP, missing, &t.lays)
        for i in 0..len(kinds) {
            if !bp.needCol[i] { continue }
            let pl = if len(t.slots) == 0 { i } else { t.slots[i] }
            if !bPut(b, i, r, places[pl], kinds[i]) { return Ok(1) }
        }
        return Ok(0)
    }
    var at = 0
    for pl in 0..bp.stopAt {
        let c = placeCol[pl]
        if at >= len(s) {
            // a column added after the row was written: its value then
            if c >= 0 {
                let mv = if pl < len(missing) { missing[pl] } else { Val.Null }
                if !bPut(b, c, r, mv, kinds[c]) { return Ok(1) }
            }
            continue
        }
        let tag = s[at]
        at += 1
        if c < 0 {
            let sz = valSize(s, at, tag)
            if sz < 0 { return Err(lexdb_base.corrupt("a row's value tag")) }
            at += sz
            continue
        }
        let k = kinds[c]
        if tag == 0 {
            b.cols[c].nul[r] = true
        } else if tag == 1 && k == BK_INT {
            b.cols[c].v[r] = binary.readI64LEStr(s, at)
            at += 8
        } else if tag == 2 && k == BK_BOOL {
            b.cols[c].v[r] = if s[at] == 1 { 1 } else { 0 }
            at += 1
        } else if k != BK_VAL {
            return Ok(1)
        } else if tag == 1 {
            b.vals[c][r] = Val.Int(binary.readI64LEStr(s, at))
            at += 8
        } else if tag == 2 {
            b.vals[c][r] = Val.Bool(s[at] == 1)
            at += 1
        } else if tag == 3 || tag == 4 {
            let l = binary.readU32LEStr(s, at)
            let tx = s[at + 4..at + 4 + l]
            at += 4 + l
            if tag == 4 {
                b.vals[c][r] = Val.Text(tx)
            } else {
                match Decimal.parse(tx) {
                    Ok(d) { b.vals[c][r] = Val.Num(d) }
                    Err(_) { return Err(lexdb_base.corrupt("a numeric value in a row")) }
                }
            }
        } else if tag >= 7 && tag <= 15 {
            b.vals[c][r] = timeVal(s, at, tag)
            at += valSize(s, at, tag)
        } else {
            return Err(lexdb_base.corrupt("a row's value tag"))
        }
    }
    return Ok(0)
}

// Decodes the rows vs[from..] that are in the fixed layout of vs[from],
// up to vs[to], into rows b.n on of b, a column at a time: per column used
// its offset, kind and NULL bit are the run's, and an integer is read in
// place (9.53). The number of rows decoded: 0 when vs[from] is not in the
// fixed layout (bRowInto reads it), -1 a value of a kind its column's
// batch does not hold (as bRowInto's 1).
fn bRunInto(leaf: &lexdb_page.Node, from: int, to: int, b: mut &Batch, bp: &BPlan, t: &Table): Result[int, DbErr] {
    let s0 = leaf.valView(from)
    if len(s0) < 3 || s0[0] != FIXED { return Ok(0) }
    let id = try layOf(s0, &t.lays)
    let lay = &t.lays[id]
    let id0 = s0[1]
    let id1 = s0[2]
    let v0 = lay.v0
    // each row's bytes, found once (a lazy leaf's are in its page's body:
    // lexdb_page.valView) and read below once per column
    var rows: []&str = withCapacity(to - from)
    append(mut &rows, s0)
    var end = from + 1
    while end < to {
        let s = leaf.valView(end)
        if len(s) < v0 || s[0] != FIXED || s[1] != id0 || s[2] != id1 { break }
        append(mut &rows, s)
        end += 1
    }
    let n = end - from
    let r0 = b.n
    let np = len(lay.kinds)
    for pl in bp.usedP {
        let c = bp.placeCol[pl]
        let k = bp.kinds[c]
        if pl >= np {
            let mv = if pl < len(bp.missing) { bp.missing[pl] } else { Val.Null }
            for q in 0..n { if !bPut(b, c, r0 + q, mv, k) { return Ok(-1) } }
            continue
        }
        let pk = lay.kinds[pl]
        if pk == PK_NONE {
            for q in 0..n { b.cols[c].nul[r0 + q] = true }
            continue
        }
        let at = lay.bm + pl / 8
        let bit = pl % 8
        let o = lay.off[pl]
        if k == BK_INT && pk == PK_INT4 {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    col.nul[r0 + q] = true
                } else {
                    let u = int(s[o]) | (int(s[o + 1]) << 8) | (int(s[o + 2]) << 16) | (int(s[o + 3]) << 24)
                    col.v[r0 + q] = if u >= 0x80000000 { u - 0x100000000 } else { u }
                }
            }
            b.cols[c] = col
        } else if k == BK_INT && pk == PK_INT {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    col.nul[r0 + q] = true
                } else {
                    col.v[r0 + q] = int(s[o]) | (int(s[o + 1]) << 8) | (int(s[o + 2]) << 16) | (int(s[o + 3]) << 24) |
                                    (int(s[o + 4]) << 32) | (int(s[o + 5]) << 40) | (int(s[o + 6]) << 48) | (int(s[o + 7]) << 56)
                }
            }
            b.cols[c] = col
        } else if k == BK_INT && pk == PK_INT2 {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    col.nul[r0 + q] = true
                } else {
                    let u = int(s[o]) | (int(s[o + 1]) << 8)
                    col.v[r0 + q] = if u >= 0x8000 { u - 0x10000 } else { u }
                }
            }
            b.cols[c] = col
        } else if k == BK_BOOL && pk == PK_BOOL {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 { col.nul[r0 + q] = true } else { col.v[r0 + q] = if s[o] == 1 { 1 } else { 0 } }
            }
            b.cols[c] = col
        } else if k == BK_VAL {
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 { b.cols[c].nul[r0 + q] = true } else { b.vals[c][r0 + q] = try fixedVal(s, pl, pk, lay) }
            }
        } else {
            return Ok(-1)
        }
    }
    return Ok(n)
}

// A row read whole by the row path (a value stored apart) into row r of b;
// false: a value of a kind its column's batch does not hold.
fn bRowOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, key: &str, v: &str, r: int, b: mut &Batch,
          bp: &BPlan): Result[bool, DbErr] {
    let row = try rowOf(st, txn, t, key, v, bp.width, &bp.needP, &bp.missing)
    for i in 0..len(bp.kinds) {
        if bp.needCol[i] && !bPut(b, i, r, row[i], bp.kinds[i]) { return Ok(false) }
    }
    return Ok(true)
}

// The columns used of a batch of stored rows (copied out by fetchRaw);
// None: a value of a kind its column's batch does not hold.
fn bDecode(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, raw: &RawRows, bp: &BPlan): Result[Option[Batch], DbErr] {
    let n = len(raw.vals)
    var b = newBatch(bp, n)
    for r in 0..n {
        let code = try bRowInto(&raw.vals[r], r, mut &b, bp, t)
        if code == 1 { return Ok(None) }
        if code == 2 && !(try bRowOf(st, txn, t, &raw.keys[r], &raw.vals[r], r, mut &b, bp)) { return Ok(None) }
    }
    b.n = n
    return Ok(Some(b))
}

// The next batch of a scan, its rows decoded from the leaves in place
// (lexdb_store.scanLeaves: no entry copied out); None: a value of a kind
// its column's batch does not hold. A key lookup, and a scan whose range
// the transaction has written, go through fetchRaw (it merges those
// writes); a value stored apart is read by the row path.
fn fillBatch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, sc: &Scan, part: bool, cur: mut &Cursor,
             bp: &BPlan): Result[Option[Batch], DbErr] {
    if sc.empty || sc.point {
        let raw = try fetchRaw(st, txn, t, sc, part, cur)
        return bDecode(st, txn, t, &raw, bp)
    }
    var b = newBatch(bp, BROWS)
    while b.n < BROWS && !cur.done {
        let from = if cur.started { cur.at } else { sc.lo }
        cur.started = true
        var stopKey = ""
        var stop = 0                // 1 the batch is full, 2 a value stored apart
        var bail = false
        var bad: []DbErr = []
        let inPlace = try st.scanLeaves(txn, t.tree, from, sc.hi, fn(leaf: &lexdb_page.Node, i: int, j: int): bool {
            var k = i
            while k < j {
                if b.n == BROWS {
                    stop = 1
                    stopKey = leaf.key(k)
                    return false
                }
                // a run of rows in one fixed layout: a column at a time
                match bRunInto(leaf, k, min(j, k + BROWS - b.n), mut &b, bp, t) {
                    Ok(got) {
                        if got < 0 {
                            bail = true
                            return false
                        }
                        if got > 0 {
                            b.n += got
                            k += got
                            continue
                        }
                    }
                    Err(x) {
                        append(mut &bad, x)
                        return false
                    }
                }
                match bRowInto(leaf.valView(k), b.n, mut &b, bp, t) {
                    Ok(code) {
                        if code == 1 {
                            bail = true
                            return false
                        }
                        if code == 2 {
                            stop = 2
                            stopKey = leaf.key(k)
                            return false
                        }
                    }
                    Err(x) {
                        append(mut &bad, x)
                        return false
                    }
                }
                b.n += 1
                k += 1
            }
            return true
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if bail { return Ok(None) }
        if !inPlace {
            // the transaction's own writes in the range: copied and merged
            cur.at = from
            if b.n > 0 { return Ok(Some(b)) }
            let raw = try fetchRaw(st, txn, t, sc, part, cur)
            return bDecode(st, txn, t, &raw, bp)
        }
        if stop == 1 {
            cur.at = stopKey
            return Ok(Some(b))
        }
        if stop == 2 {
            let got = if part { try st.getPart(txn, t.tree, stopKey) } else { try st.get(txn, t.tree, stopKey) }
            match got {
                Some(v) {
                    if !(try bRowOf(st, txn, t, &stopKey, &v, b.n, mut &b, bp)) { return Ok(None) }
                    b.n += 1
                }
                None {}
            }
            cur.at = after(&stopKey)
            continue
        }
        cur.done = true
    }
    return Ok(Some(b))
}

// Row r of a batch as the row path gives it: its columns used, NULL for
// the others.
fn bRow(b: &Batch, r: int, kinds: &[]int, needCol: &[]bool): []Val {
    var out: []Val = array(len(kinds), Val.Null)
    for i in 0..len(kinds) {
        if !needCol[i] || b.cols[i].nul[r] { continue }
        let k = kinds[i]
        out[i] = if k == BK_INT { Val.Int(b.cols[i].v[r]) } else if k == BK_BOOL { Val.Bool(b.cols[i].v[r] == 1) } else { b.vals[i][r] }
    }
    return out
}

// A group key's value at row r: an expression's (BVec at position j) or a
// column's of another type.
fn bKeyVal(c: &BComp, kv: &BVec, j: int, b: &Batch, r: int): Val {
    if c.typ == BT_OTHER {
        match c.n {
            BNode.Col(i) { return b.vals[i][r] }
            else { return Val.Null }
        }
    }
    if kv.nul[j] { return Val.Null }
    if c.typ == BT_BOOL { return Val.Bool(kv.v[j] == 1) }
    return Val.Int(kv.v[j])
}

// Marks the columns n reads.
fn bColsOf(n: &BNode, used: mut &[]bool) {
    match n {
        BNode.Const(_, _) {}
        BNode.Col(c) { used[c] = true }
        BNode.Arith(_, a, b) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
        BNode.Neg(a) { bColsOf(&a, used) }
        BNode.Cmp(_, a, b) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
        BNode.And(a, b) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
        BNode.Or(a, b) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
        BNode.Not(a) { bColsOf(&a, used) }
        BNode.IsNull(a, _) { bColsOf(&a, used) }
        BNode.ValCmp(_, c, _, _) { used[c] = true }
        BNode.Like(c, _) { used[c] = true }
    }
}

// Adds the rows (gids: their groups) of a batch to a value aggregate's
// counts and values (sp.vcol): row by row, in order, with eval's arith and
// compare, as accumulate does (the last of equal values kept).
fn bAccVal(sp: &BSpec, b: &Batch, rows: &[]int, gids: &[]int, cn: mut &[]int, av: mut &[]Val): Result[Unit, DbErr] {
    let c = sp.vcol
    let summing = sp.kind == BA_SUM || sp.kind == BA_AVG
    let mx = sp.kind == BA_MAX
    for j in 0..len(rows) {
        let r = rows[j]
        if b.cols[c].nul[r] { continue }
        let g = gids[j]
        if isNull(&av[g]) {
            av[g] = b.vals[c][r]
        } else if summing {
            av[g] = try arith(&"+", &av[g], &b.vals[c][r])
        } else {
            let x = try compare(&b.vals[c][r], &av[g])
            if (mx && x >= 0) || (!mx && x <= 0) { av[g] = b.vals[c][r] }
        }
        cn[g] += 1
    }
    return Ok(Unit{})
}

// Adds the rows (gids: their groups) of a batch to an aggregate's counts,
// sums and minima or maxima per group; one: a single group (its values
// kept in registers through the loop).
fn bAccum(sp: &BSpec, b: &Batch, rows: &[]int, gids: &[]int, one: bool, cn: mut &[]int, su: mut &[]int,
          mm: mut &[]int): Result[Unit, DbErr] {
    let k = len(rows)
    if sp.kind == BA_STAR {
        if one { cn[0] += k } else { for j in 0..k { cn[gids[j]] += 1 } }
        return Ok(Unit{})
    }
    let a = match sp.arg {
        Some(x) { try bEval(&x, b, rows) }
        None { bvec(0) }
    }
    if sp.kind == BA_COUNT {
        if one {
            var c = cn[0]
            for j in 0..k { if !a.nul[j] { c += 1 } }
            cn[0] = c
        } else {
            for j in 0..k { if !a.nul[j] { cn[gids[j]] += 1 } }
        }
        return Ok(Unit{})
    }
    if sp.kind == BA_SUM || sp.kind == BA_AVG {
        if one {
            var s = su[0]
            var c = cn[0]
            for j in 0..k {
                if a.nul[j] { continue }
                match s.checkedAdd(a.v[j]) {
                    Some(w) { s = w }
                    None { return Err(e("22003", "bigint out of range")) }
                }
                c += 1
            }
            su[0] = s
            cn[0] = c
        } else {
            for j in 0..k {
                if a.nul[j] { continue }
                let g = gids[j]
                match su[g].checkedAdd(a.v[j]) {
                    Some(w) { su[g] = w }
                    None { return Err(e("22003", "bigint out of range")) }
                }
                cn[g] += 1
            }
        }
        return Ok(Unit{})
    }
    let mx = sp.kind == BA_MAX
    for j in 0..k {
        if a.nul[j] { continue }
        let g = if one { 0 } else { gids[j] }
        let v = a.v[j]
        if cn[g] == 0 || (if mx { v > mm[g] } else { v < mm[g] }) { mm[g] = v }
        cn[g] += 1
    }
    return Ok(Unit{})
}

// Scans the first level's table in batches (9.52): the level's
// conditions that batches can evaluate pick the rows, and only those are
// made into rows and go on as the row path's would (tryRow, which checks
// all the level's conditions). -1: not a level the batches scan (nothing
// done); 0 done; 1 done, emit asked to stop. matched: whether a row went
// on. A batch with a value its column's batch cannot hold, or whose
// conditions give an error on one of its rows, ends the batches: the row
// path reads the rest of that scan from the batch's start (and gives the
// error only if it gets to that row).
fn batchLevel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, row: mut &[]Val,
              params: &[]Val, emit: &fn(&[]Val): Result[bool, DbErr], rs: mut &Run, matched: mut &bool): Result[int, DbErr] {
    if !rs.batch || len(q.levels) == 0 { return Ok(-1) }
    let lv = &q.levels[0]
    if lv.first != 0 || !lv.perRow || lv.lateral || lv.virt() || (q.corr && pathCorr(&lv.path)) { return Ok(-1) }
    let p = &lv.path
    if p.index >= 0 || p.desc || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 { return Ok(-1) }
    let t = &lv.t
    var kinds: []int = []
    for c in t.cols { append(mut &kinds, colKind(&c)) }
    var qkinds: []int = array(len(q.cols), BK_NONE)
    for i in 0..len(t.cols) { qkinds[i] = kinds[i] }
    let noAggs: []Val = []
    let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: None}
    // the conditions batches evaluate. Any of them, in any order: tryRow
    // checks every condition on the rows they keep, and a batch on one of
    // whose rows one gives an error goes to the row path, which tries them
    // in order (an error the row path would not reach is not given).
    var conds: []BNode = []
    for x in lv.cond {
        let c = bCompile(&x, q, &qkinds, &env)
        if c.isNone() { continue }
        let cc = c.unwrap()
        if !boolLike(cc.typ) { continue }
        append(mut &conds, takeN(cc))
    }
    if len(conds) == 0 { return Ok(-1) }
    var needCol: []bool = []
    for i in 0..len(t.cols) { append(mut &needCol, len(lv.need) == 0 || lv.need[i]) }
    let part = len(lv.need) > 0
    let width = rowWidth(t)
    var placeCol: []int = array(width, -1)
    for i in 0..len(t.cols) {
        if needCol[i] { placeCol[if len(t.slots) == 0 { i } else { t.slots[i] }] = i }
    }
    var usedP: []int = []
    for pl in 0..width { if placeCol[pl] >= 0 { append(mut &usedP, pl) } }
    let stopAt = if len(usedP) == 0 { 0 } else { usedP[len(usedP) - 1] + 1 }
    var needList: []bool = []
    for x in lv.need { append(mut &needList, x) }
    let bp = BPlan{kinds: kinds, needCol: needCol, placeCol: placeCol, usedP: usedP, stopAt: stopAt,
                   missing: placesMissing(t), needP: placesNeeded(t, &needList), width: width}
    let scans = try pathScans(t, p, &env)
    // key lookups: a row each, not worth a batch
    var ranges = false
    for sc in scans { if !sc.point && !sc.empty { ranges = true } }
    if !ranges { return Ok(-1) }
    for sc in scans {
        var cur = newCursor()
        var rowPath = false
        while !cur.done {
            let saved = Cursor{at: cur.at, started: cur.started, done: cur.done}
            let got = try fillBatch(st, txn, t, &sc, part, mut &cur, &bp)
            if got.isNone() {
                cur = saved
                rowPath = true
                break
            }
            let b = got.unwrap()
            let nr = b.n
            if nr == 0 { continue }
            var idx: []int = []
            for r in 0..nr { append(mut &idx, r) }
            var failed = false
            for c in conds {
                if len(idx) == 0 { break }
                match bTrue(&c, &b, &idx) {
                    Ok(pos) {
                        var next: []int = []
                        for j in pos { append(mut &next, idx[j]) }
                        idx = next
                    }
                    Err(_) {
                        failed = true
                        break
                    }
                }
            }
            if failed {
                // an error on some row of the batch: the row path reads it,
                // and gives the error only if it gets to that row (a LIMIT
                // may stop it first)
                cur = saved
                rowPath = true
                break
            }
            rs.cnt[0].batches += 1
            // the rows dropped count as read, as the row path counts them
            try rs.tickN(nr - len(idx))
            rs.cnt[0].read += nr - len(idx)
            for j in idx {
                let r = bRow(&b, j, &bp.kinds, &bp.needCol)
                let got2 = try tryRow(st, txn, q, m, 0, &r, -1, row, params, emit, rs)
                if got2 < 0 { return Ok(1) }
                if got2 > 0 { matched = true }
            }
        }
        while rowPath && !cur.done {
            var batch: [][]Val = []
            try fetch(st, txn, t, p, &sc, &lv.need, mut &cur, mut &batch)
            for r in batch {
                let got2 = try tryRow(st, txn, q, m, 0, &r, -1, row, params, emit, rs)
                if got2 < 0 { return Ok(1) }
                if got2 > 0 { matched = true }
            }
        }
    }
    return Ok(0)
}

// Runs sel's grouping over batches into gs; false: the query is not one
// the batches run (nothing done; the row path runs it).
fn batchGroups(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, m: &Mats, params: &[]Val, rs: mut &Run,
               gs: mut &Groups, held: mut &int, room: int, rs0max: int): Result[bool, DbErr] {
    let q = &sel.q
    if !rs.batch || sel.setop != 0 || len(sel.wins) > 0 || sel.first >= 0 || q.corr || len(q.subs) > 0 || len(q.levels) != 1 { return Ok(false) }
    let lv = &q.levels[0]
    if lv.src >= 0 || lv.work >= 0 || lv.lateral || !lv.perRow || lv.first != 0 || len(lv.post) > 0 { return Ok(false) }
    if len(q.cols) != len(lv.t.cols) { return Ok(false) }
    let p = &lv.path
    if p.index >= 0 || p.desc || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 { return Ok(false) }
    let t = &lv.t
    var kinds: []int = []
    for c in t.cols { append(mut &kinds, colKind(&c)) }
    var needCol: []bool = []
    for i in 0..len(t.cols) { append(mut &needCol, len(lv.need) == 0 || lv.need[i]) }
    let noAggs: []Val = []
    let nullRow: []Val = array(len(q.cols), Val.Null)
    let env = Env{cols: &q.cols, row: &nullRow, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: None}
    // the conditions, the group keys and the aggregates over batches
    var conds: []BNode = []
    for x in lv.cond {
        let c = bCompile(&x, q, &kinds, &env)
        if c.isNone() { return Ok(false) }
        let cc = c.unwrap()
        if !boolLike(cc.typ) { return Ok(false) }
        append(mut &conds, takeN(cc))
    }
    var keys: []BComp = []
    for x in sel.groupBy {
        let c = bCompile(&x, q, &kinds, &env)
        if c.isNone() { return Ok(false) }
        let cc = c.unwrap()
        if cc.typ == BT_OTHER {
            match cc.n {
                BNode.Col(_) {}
                else { return Ok(false) }
            }
        }
        append(mut &keys, cc)
    }
    var specs: []BSpec = []
    for sp in sel.specs {
        if sp.distinct || len(sp.order) > 0 { return Ok(false) }
        let f = sp.fname
        var kind = -1
        if sp.star { kind = BA_STAR } else if f == "count" { kind = BA_COUNT } else if f == "sum" { kind = BA_SUM }
        else if f == "avg" { kind = BA_AVG } else if f == "min" { kind = BA_MIN } else if f == "max" { kind = BA_MAX }
        if kind < 0 { return Ok(false) }
        var arg: Option[BNode] = None
        var vcol = -1
        if kind != BA_STAR {
            if len(sp.args) != 1 { return Ok(false) }
            let c = bCompile(&sp.args[0], q, &kinds, &env)
            if c.isNone() { return Ok(false) }
            let cc = c.unwrap()
            if kind != BA_COUNT && cc.typ != BT_INT {
                // min or max of a column of values, sum or avg of a numeric one
                let vc = bValCol(&sp.args[0], q, &kinds)
                if vc < 0 { return Ok(false) }
                let numeric = t.cols[vc].typ.oid == lexdb_sql.OID_NUMERIC
                if !(kind == BA_MIN || kind == BA_MAX || ((kind == BA_SUM || kind == BA_AVG) && numeric)) { return Ok(false) }
                vcol = vc
            }
            arg = Some(takeN(cc))
        }
        var filt: Option[BNode] = None
        match sp.filter {
            Some(fx) {
                let c = bCompile(&fx, q, &kinds, &env)
                if c.isNone() { return Ok(false) }
                let cc = c.unwrap()
                if !boolLike(cc.typ) { return Ok(false) }
                filt = Some(takeN(cc))
            }
            None {}
        }
        append(mut &specs, BSpec{kind: kind, arg: arg, filter: filt, vcol: vcol})
    }
    // With no GROUP BY no column is used outside an aggregate (42803): the
    // columns read are those of the conditions and the aggregates only
    // (none for count(*)), large rows read in part.
    var part = len(lv.need) > 0
    if len(keys) == 0 {
        var used: []bool = array(len(t.cols), false)
        for c in conds { bColsOf(&c, mut &used) }
        for sp in specs {
            match sp.arg {
                Some(x) { bColsOf(&x, mut &used) }
                None {}
            }
            match sp.filter {
                Some(x) { bColsOf(&x, mut &used) }
                None {}
            }
        }
        needCol = used
        part = true
    }
    var needList: []bool = []
    for x in needCol { append(mut &needList, x) }
    let scans = try pathScans(t, p, &env)
    // where each column used is in a stored row
    let width = rowWidth(t)
    var placeCol: []int = array(width, -1)
    for i in 0..len(t.cols) {
        if needCol[i] { placeCol[if len(t.slots) == 0 { i } else { t.slots[i] }] = i }
    }
    var usedP: []int = []
    for pl in 0..width { if placeCol[pl] >= 0 { append(mut &usedP, pl) } }
    // a tagged row is read up to its last place used (none: not at all)
    let stopAt = if len(usedP) == 0 { 0 } else { usedP[len(usedP) - 1] + 1 }
    let bp = BPlan{kinds: kinds, needCol: needCol, placeCol: placeCol, usedP: usedP, stopAt: stopAt,
                   missing: placesMissing(t), needP: placesNeeded(t, &needList), width: width}
    // the groups: their first rows, and per aggregate its counts, sums and minima or maxima
    let ns = len(specs)
    var firsts: [][]Val = []
    var an: [][]int = []
    var asum: [][]int = []
    var amm: [][]int = []
    var aval: [][]Val = []              // per value aggregate (vcol) and group: its sum, min or max
    for i in 0..ns {
        append(mut &an, [])
        append(mut &asum, [])
        append(mut &amm, [])
        append(mut &aval, [])
    }
    var byInt: Map[int, int] = newMap()
    var byKey: Map[str, int] = newMap()
    var nullGroup = -1
    let oneKey = len(keys) == 1 && keys[0].typ != BT_OTHER
    var added = 0                       // the bytes counted in held (given back if the row path runs after all)
    var nRead = 0
    var nJoined = 0
    var nBatches = 0
    for sc in scans {
        var cur = newCursor()
        while !cur.done {
            let got = try fillBatch(st, txn, t, &sc, part, mut &cur, &bp)
            if got.isNone() {
                held -= added
                return Ok(false)
            }
            let b = got.unwrap()
            let nr = b.n
            if nr == 0 { continue }
            try rs.tickN(nr)
            nRead += nr
            nBatches += 1
            // WHERE: the rows chosen, narrowed condition by condition
            var idx: []int = []
            for r in 0..nr { append(mut &idx, r) }
            for c in conds {
                if len(idx) == 0 { break }
                let pos = try bTrue(&c, &b, &idx)
                var next: []int = []
                for j in pos { append(mut &next, idx[j]) }
                idx = next
            }
            let nc = len(idx)
            nJoined += nc
            if nc == 0 { continue }
            // each row's group, new groups made in the rows' order
            var gid: []int = array(nc, 0)
            if len(keys) == 0 {
                if len(firsts) == 0 {
                    let row = bRow(&b, idx[0], &bp.kinds, &bp.needCol)
                    let cost = rowBytes(&row) + 64 * (len(sel.specs) + 1)
                    held += cost
                    added += cost
                    if room >= 0 && held > room { return Err(memErr(rs0max)) }
                    append(mut &firsts, row)
                    for i in 0..ns {
                        append(mut &an[i], 0)
                        append(mut &asum[i], 0)
                        append(mut &amm[i], 0)
                        append(mut &aval[i], Val.Null)
                    }
                }
            } else {
                var kvs: []BVec = []
                for k in keys { append(mut &kvs, try bEval(&k.n, &b, &idx)) }
                for j in 0..nc {
                    var g = -1
                    var klen = 9
                    if oneKey {
                        if kvs[0].nul[j] {
                            g = nullGroup
                        } else {
                            match byInt.get(&kvs[0].v[j]) {
                                Some(x) { g = x }
                                None {}
                            }
                        }
                    }
                    var kstr = ""
                    if !oneKey {
                        var kb = newStrBuf()
                        for ki in 0..len(keys) { encIdxPart(mut &kb, &bKeyVal(&keys[ki], &kvs[ki], j, &b, idx[j])) }
                        kstr = kb.toStr()
                        klen = len(kstr)
                        match byKey.get(&kstr) {
                            Some(x) { g = x }
                            None {}
                        }
                    }
                    if g < 0 {
                        g = len(firsts)
                        let row = bRow(&b, idx[j], &bp.kinds, &bp.needCol)
                        let cost = rowBytes(&row) + 64 * (len(sel.specs) + 1) + klen
                        held += cost
                        added += cost
                        if room >= 0 && held > room { return Err(memErr(rs0max)) }
                        append(mut &firsts, row)
                        for i in 0..ns {
                            append(mut &an[i], 0)
                            append(mut &asum[i], 0)
                            append(mut &amm[i], 0)
                            append(mut &aval[i], Val.Null)
                        }
                        if oneKey {
                            if kvs[0].nul[j] { nullGroup = g } else { byInt.put(kvs[0].v[j], g) }
                        } else {
                            byKey.put(kstr, g)
                        }
                    }
                    gid[j] = g
                }
            }
            // the aggregates: per aggregate its rows (FILTER), its argument's values, one loop
            for si in 0..ns {
                let sp = &specs[si]
                match sp.filter {
                    Some(fx) {
                        let pos = try bTrue(&fx, &b, &idx)
                        var r2: []int = []
                        var g2: []int = []
                        for j in pos {
                            append(mut &r2, idx[j])
                            append(mut &g2, gid[j])
                        }
                        if sp.vcol >= 0 { try bAccVal(sp, &b, &r2, &g2, mut &an[si], mut &aval[si]) }
                        else { try bAccum(sp, &b, &r2, &g2, len(keys) == 0, mut &an[si], mut &asum[si], mut &amm[si]) }
                    }
                    None {
                        if sp.vcol >= 0 { try bAccVal(sp, &b, &idx, &gid, mut &an[si], mut &aval[si]) }
                        else { try bAccum(sp, &b, &idx, &gid, len(keys) == 0, mut &an[si], mut &asum[si], mut &amm[si]) }
                    }
                }
            }
        }
    }
    // the groups as the row path leaves them
    for g in 0..len(firsts) {
        var accs = newAccs(len(sel.specs))
        for si in 0..ns {
            let kd = specs[si].kind
            accs[si].n = an[si][g]
            if an[si][g] > 0 && specs[si].vcol >= 0 {
                if kd == BA_SUM || kd == BA_AVG { accs[si].sum = aval[si][g] }
                if kd == BA_MIN || kd == BA_MAX { accs[si].val = aval[si][g] }
            } else if an[si][g] > 0 {
                if kd == BA_SUM || kd == BA_AVG { accs[si].sum = Val.Int(asum[si][g]) }
                if kd == BA_MIN || kd == BA_MAX { accs[si].val = Val.Int(amm[si][g]) }
            }
        }
        append(mut &gs.accs, accs)
    }
    gs.firsts = firsts
    rs.cnt[0].starts += 1
    rs.cnt[0].read += nRead
    rs.cnt[0].joined += nJoined
    rs.cnt[0].batches += nBatches
    return Ok(true)
}

// ---- The row layout (design/lexdb.md 9.48, 9.50)
//
// A row: FIXED; its layout's number in its table's (Table.layouts), 2
// bytes; a NULL bitmap (bit p%8 of byte p/8); the fixed part, per place in
// order: 8, 4 or 2 bytes an integer (its column's type's width), 1 a
// boolean, 2 a variable-length value's end (from the start of the variable
// part), none a dropped place; then the variable part: texts, and numerics
// in their binary form (Decimal.toBin). Each place is at an offset its
// layout gives, so reading one is a load, not a walk over the places before
// it. A row this cannot hold is in the tagged form (encRow): one with a
// long text (LONG, encLong), over 255 places, a value not of its place's
// kind, or written with LEXDB_ROWFMT=tagged.

const FIXED: byte = 8
const PK_NONE: byte = 0     // a dropped column's place
const PK_INT: byte = 1      // 8 bytes
const PK_BOOL: byte = 2
const PK_NUM: byte = 3
const PK_TEXT: byte = 4
const PK_INT4: byte = 5
const PK_INT2: byte = 6

var fixedRows: bool = true

pub fn setFixedRows(on: bool) { fixedRows = on }

// How many of table name's stored rows are in the fixed layout (a test's
// look at the bytes).
pub fn countFixedRows(st: &lexdb_store.Store, name: &str): int {
    var txn = lexdb_store.begin()
    var n = 0
    let found = findTable(st, mut &txn, name).unwrapOr(None)
    match found {
        Some(t) {
            let r = st.scan(mut &txn, t.tree, "", "", fn(en: &lexdb_store.Entry): bool {
                if len(en.val) > 0 && en.val[0] == FIXED { n += 1 }
                return true
            })
        }
        None {}
    }
    st.abort(txn)
    return n
}

// Table name's rows by layout ("0:200 3:150", by layout number; "tagged:N"
// for rows in the tagged form) and its layouts' count: a test's look at
// the bytes.
pub fn rowLayouts(st: &lexdb_store.Store, name: &str): str {
    var txn = lexdb_store.begin()
    var counts: []int = []
    var tagged = 0
    var nl = 0
    let found = findTable(st, mut &txn, name).unwrapOr(None)
    match found {
        Some(t) {
            nl = len(t.layouts)
            counts = array(nl, 0)
            let r = st.scan(mut &txn, t.tree, "", "", fn(en: &lexdb_store.Entry): bool {
                if len(en.val) > 2 && en.val[0] == FIXED {
                    let id = binary.readU16LEStr(&en.val, 1)
                    if id < len(counts) { counts[id] += 1 }
                } else {
                    tagged += 1
                }
                return true
            })
        }
        None {}
    }
    st.abort(txn)
    var out: []str = []
    for i in 0..len(counts) { if counts[i] > 0 { append(mut &out, i.toStr() + ":" + counts[i].toStr()) } }
    if tagged > 0 { append(mut &out, "tagged:" + tagged.toStr()) }
    return strings.join(&out, " ") + " of " + nl.toStr() + " layouts"
}

// Each place's kind, from its column's type.
fn placeKinds(t: &Table): []byte {
    var out: []byte = array(rowWidth(t), PK_NONE)
    for i in 0..len(t.cols) {
        let o = t.cols[i].typ.oid
        var k = PK_TEXT
        if o == lexdb_sql.OID_INT8 { k = PK_INT }
        else if o == lexdb_sql.OID_INT4 { k = PK_INT4 }
        else if o == lexdb_sql.OID_INT2 { k = PK_INT2 }
        else if o == lexdb_sql.OID_BOOL { k = PK_BOOL }
        else if o == lexdb_sql.OID_NUMERIC { k = PK_NUM }
        out[if len(t.slots) == 0 { i } else { t.slots[i] }] = k
    }
    return out
}

fn fixedSize(k: byte): int {
    if k == PK_INT { return 8 }
    if k == PK_INT4 { return 4 }
    if k == PK_INT2 || k == PK_NUM || k == PK_TEXT { return 2 }
    if k == PK_BOOL { return 1 }
    return 0
}

fn isIntKind(k: byte): bool { return k == PK_INT || k == PK_INT4 || k == PK_INT2 }

// Whether integer v fits a place of kind k.
fn intFits(k: byte, v: int): bool {
    if k == PK_INT { return true }
    if k == PK_INT4 { return v >= -2147483648 && v <= 2147483647 }
    if k == PK_INT2 { return v >= -32768 && v <= 32767 }
    return false
}

// The integer of kind k at s[at..].
fn readIntK(s: &str, at: int, k: byte): int {
    if k == PK_INT { return binary.readI64LEStr(s, at) }
    if k == PK_INT4 { return binary.readI32LEStr(s, at) }
    return binary.readI16LEStr(s, at)
}

// The table's row in its current layout; None when the row does not fit it
// (a value of another kind than its place's, a long text, over 255 places)
// or the table has no current layout yet (a schema change not yet stored:
// syncLayouts).
fn encFixed(t: &Table, places: &[]Val): Option[str] {
    let nl = len(t.layouts)
    if nl == 0 || nl > 65536 { return None }
    let kinds = &t.layouts[nl - 1]
    let n = len(kinds)
    if n > 255 || len(places) != n { return None }
    // the table as it stands must have this layout as its current one
    let cur = placeKinds(t)
    if !sameKinds(kinds, &cur) { return None }
    var bits: []byte = array((n + 7) / 8, byte(0))
    var vars: []str = []
    for p in 0..n {
        let k = kinds[p]
        match places[p] {
            Val.Null { bits[p / 8] = bits[p / 8] | byte(1 << (p % 8)) }
            Val.Int(v) { if !intFits(k, v) { return None } }
            Val.Bool(_) { if k != PK_BOOL { return None } }
            Val.Num(d) {
                if k != PK_NUM { return None }
                append(mut &vars, d.toBin())
            }
            Val.Text(x) {
                if k != PK_TEXT || len(x) >= LONG { return None }
                append(mut &vars, x)
            }
            else { return None }        // the date and time kinds: the tagged form (9.76)
        }
    }
    var b = newStrBuf()
    b.addByte(FIXED)
    binary.addU16LE(mut &b, nl - 1)
    for x in bits { b.addByte(x) }
    var end = 0
    var vi = 0
    for p in 0..n {
        let k = kinds[p]
        if isIntKind(k) {
            let v = match places[p] { Val.Int(v) { v } else { 0 } }
            if k == PK_INT { binary.addU64LE(mut &b, v) }
            else if k == PK_INT4 { binary.addU32LE(mut &b, v & 0xFFFFFFFF) }
            else { binary.addU16LE(mut &b, v & 0xFFFF) }
        } else if k == PK_BOOL {
            b.addByte(match places[p] { Val.Bool(x) { if x { 1 } else { 0 } } else { 0 } })
        } else if k == PK_NUM || k == PK_TEXT {
            if !isNull(&places[p]) {
                end += len(vars[vi])
                vi += 1
            }
            if end > 65535 { return None }
            binary.addU16LE(mut &b, end)
        }
    }
    for x in vars { b.add(x) }
    return Some(b.toStr())
}

// The layout of a row in the fixed form, of its table's lays.
fn layOf(s: &str, lays: &[]FixedLay): Result[int, DbErr] {
    if len(s) < 3 { return Err(lexdb_base.corrupt("a row's layout number")) }
    let id = binary.readU16LEStr(s, 1)
    if id >= len(lays) { return Err(lexdb_base.corrupt("a row's layout number")) }
    if lays[id].v0 > len(s) { return Err(lexdb_base.corrupt("a row's fixed part")) }
    return Ok(id)
}

// The value of kind k at place p of row s in layout lay (not NULL).
fn fixedVal(s: &str, p: int, k: byte, lay: &FixedLay): Result[Val, DbErr] {
    let at = lay.off[p]
    if isIntKind(k) { return Ok(Val.Int(readIntK(s, at, k))) }
    if k == PK_BOOL { return Ok(Val.Bool(s[at] == 1)) }
    let end = binary.readU16LEStr(s, at)
    let start = if lay.prev[p] < 0 { 0 } else { binary.readU16LEStr(s, lay.prev[p]) }
    if start > end || lay.v0 + end > len(s) { return Err(lexdb_base.corrupt("a row's variable part")) }
    if k == PK_TEXT { return Ok(Val.Text(s[lay.v0 + start..lay.v0 + end])) }
    match Decimal.fromBin(s, lay.v0 + start, end - start) {
        Ok(d) { return Ok(Val.Num(d)) }
        Err(_) { return Err(lexdb_base.corrupt("a numeric value in a row")) }
    }
}

// decRowNeed for a row in the fixed layout.
fn decFixed(s: &str, n: int, need: &[]bool, missing: &[]Val, lays: &[]FixedLay): Result[[]Val, DbErr] {
    let lay = &lays[try layOf(s, lays)]
    let np = len(lay.kinds)
    let some = len(need) > 0
    var out: []Val = array(n, Val.Null)
    for p in 0..n {
        if p >= np {
            if p < len(missing) { out[p] = missing[p] }
            continue
        }
        if some && !need[p] { continue }
        let k = lay.kinds[p]
        if k == PK_NONE || (int(s[lay.bm + p / 8]) >> (p % 8)) & 1 == 1 { continue }
        out[p] = try fixedVal(s, p, k, lay)
    }
    return Ok(out)
}

// Where the places of rows in one layout are: each one's offset in the row,
// and for a variable-length value the offset of the previous one's end (-1:
// it starts the variable part).
type FixedLay = record {
    kinds: []byte
    off: []int              // per place
    prev: []int
    bm: int                 // the bitmap's offset
    v0: int                 // the variable part's
}

// The layout of rows with these places' kinds.
fn layOfKinds(kinds: &[]byte): FixedLay {
    let np = len(kinds)
    var ks: []byte = []
    for k in kinds { append(mut &ks, k) }
    let bm = 3
    var at = bm + (np + 7) / 8
    var off: []int = array(np, 0)
    var prev: []int = array(np, -1)
    var lastVar = -1
    for p in 0..np {
        off[p] = at
        let k = kinds[p]
        if k == PK_NUM || k == PK_TEXT {
            prev[p] = lastVar
            lastVar = at
        }
        at += fixedSize(k)
    }
    return FixedLay{kinds: ks, off: off, prev: prev, bm: bm, v0: at}
}

// ---- pg_catalog and information_schema (9.80)
//
// The catalog relations are functions in FROM ("#pg_class", ...) whose
// rows are made here from lexdb's own catalog when a statement runs. OIDs
// are made from names (catOid), so a relation keeps its OID while it keeps
// its name. The catalog functions (pg_get_constraintdef, regclass, ...)
// read the catalog as the statement bound it (bindCatalog): a summary in the
// store's memo, keyed by the session, as nextval's sequences are bound.

const OID_PUBLIC = 2200
const OID_PG_CATALOG = 11
const OID_INFO_SCHEMA = 13000
const OID_OWNER = 10

fn copyStrs(xs: &[]str): []str {
    var out: []str = []
    for x in xs { append(mut &out, x) }
    return out
}

fn copyInts(xs: &[]int): []int {
    var out: []int = []
    for x in xs { append(mut &out, x) }
    return out
}

fn cloneOptE(x: &Option[Expr]): Option[Expr] {
    match x {
        Some(e) { return Some(clone(&e)) }
        None { return None }
    }
}

fn catOid(kind: &str, key: &str): int {
    var h = 2166136261
    let s = kind + "\x00" + key
    for i in 0..len(s) { h = ((h ^ int(s[i])) * 16777619) & 0xFFFFFFFF }
    return 16384 + h % 2000000000
}

fn nspOid(n: &str): int {
    if n == "public" { return OID_PUBLIC }
    if n == "pg_catalog" { return OID_PG_CATALOG }
    if n == "information_schema" { return OID_INFO_SCHEMA }
    return catOid(&"n", n)
}

// PostgreSQL's own OIDs for the relations clients name (as classoid).
fn sysRelOid(rel: &str): int {
    match rel {
        "pg_class" { return 1259 }
        "pg_type" { return 1247 }
        "pg_attribute" { return 1249 }
        "pg_proc" { return 1255 }
        "pg_namespace" { return 2615 }
        "pg_constraint" { return 2606 }
        "pg_index" { return 2610 }
        "pg_description" { return 2609 }
        "pg_attrdef" { return 2604 }
        "pg_database" { return 1262 }
        else { return catOid(&"r", &("pg_catalog\x1f" + rel)) }
    }
}

// quote_ident: the name as is when it needs no quotes.
fn quoteIfNeeded(n: &str): str {
    var plain = len(n) > 0 && ((n[0] >= 'a' && n[0] <= 'z') || n[0] == '_')
    for i in 0..len(n) {
        let c = n[i]
        if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') { plain = false }
    }
    if plain && lexdb_sql.isReservedWord(n) { plain = false }
    return if plain { n.toStr() } else { "\"" + strings.replaceAll(n, "\"", "\"\"") + "\"" }
}

type CatIdx = record {
    name: str
    oid: int
    cols: []int             // attnums
    unique: bool
    primary: bool
    con: bool               // a constraint's (primary key, UNIQUE)
    pred: Option[Expr]
}

type CatTab = record {
    key: str
    t: Table
    oid: int
    schema: str
    name: str
    shown: str              // as regclass shows it: qualified unless on the path
    idxs: []CatIdx
}

type CatCon = record {
    oid: int
    name: str
    typ: str                // p u f c
    rel: int                // its table's OID
    schema: str
    cols: []int
    refRel: int
    refCols: []int
    idx: int                // conindid
    def: str
    upd: str
    del: str
    check: str              // a CHECK's expression, as PostgreSQL shows it
}

type CatSnap = record {
    acls: Map[str, str]     // owners and grants, by object, encoded (9.83)
    tabs: []CatTab
    views: []CatTab         // views (9.82): t.view their text, t.cols their columns
    cons: []CatCon
    seqs: []Seq
    schemas: []str          // public and those made
    path: []str
    user: str
}

fn userKey(sess: int): str { return "\x00user\x00" + sess.toStr() }
fn catMemoKey(sess: int): str { return "\x00cat\x00" + sess.toStr() }

// The session's user, from its startup message.
pub fn (s: &Session) setUser(u: &str) { s.st.memoPut(&userKey(s.id), u) }

fn visibleIn(path: &[]str, schema: &str): bool {
    if schema == "pg_catalog" { return true }
    if len(path) == 0 { return schema == "public" }
    for p in path { if p == schema { return true } }
    return false
}

fn shownIn(path: &[]str, schema: &str, name: &str): str {
    if visibleIn(path, schema) { return quoteIfNeeded(name) }
    return quoteIfNeeded(schema) + "." + quoteIfNeeded(name)
}

fn colNum(t: &Table, name: &str): int {
    for i in 0..len(t.cols) { if t.cols[i].name == name { return i + 1 } }
    return 0
}

fn fkAction(a: int): str {
    if a == lexdb_sql.FK_RESTRICT { return "r" }
    if a == lexdb_sql.FK_CASCADE { return "c" }
    if a == lexdb_sql.FK_SET_NULL { return "n" }
    if a == lexdb_sql.FK_SET_DEFAULT { return "d" }
    return "a"
}

fn fkActionText(a: &str): str {
    if a == "r" { return "RESTRICT" }
    if a == "c" { return "CASCADE" }
    if a == "n" { return "SET NULL" }
    if a == "d" { return "SET DEFAULT" }
    return "NO ACTION"
}

fn colList(t: &Table, nums: &[]int): str {
    var parts: []str = []
    for n in nums { if n >= 1 && n <= len(t.cols) { append(mut &parts, quoteIfNeeded(&t.cols[n - 1].name)) } }
    return strings.join(&parts, ", ")
}

// An expression as PostgreSQL's deparser writes it (near enough): names
// bare where they can be, constants typed, AND and OR in capitals.
fn pgExprText(x: &Expr, typ: &Option[lexdb_sql.TypeName]): str {
    match x {
        Expr.Lit(v) {
            let tn = match typ {
                Some(t) { lexdb_pgcat.formatType(t.oid, -1) }
                None { "" }
            }
            match v {
                Val.Null { return if len(tn) > 0 { "NULL::" + tn } else { "NULL" } }
                Val.Int(n) {
                    if n >= 0 { return n.toStr() }
                    return "'" + n.toStr() + "'::" + (if n < -2147483648 { "bigint" } else { "integer" })
                }
                Val.Num(d) { return if d.isNeg() { "'" + d.toStr() + "'::numeric" } else { d.toStr() } }
                Val.Bool(b) { return if b { "true" } else { "false" } }
                Val.Text(s) { return "'" + strings.replaceAll(s, "'", "''") + "'::" + (if len(tn) > 0 { tn } else { "text" }) }
                else { return lexdb_sql.exprText(x) }
            }
        }
        Expr.Col(n) {
            let d = strings.indexOf(&n, ".", 0)
            return quoteIfNeeded(&(if d < 0 { n } else { n[d + 1..len(n)] }))
        }
        Expr.Bin(op, a, b) {
            let o = if op == "and" { "AND" } else if op == "or" { "OR" } else { op }
            let none: Option[lexdb_sql.TypeName] = None
            return "(" + pgExprText(&a, &none) + " " + o + " " + pgExprText(&b, &none) + ")"
        }
        Expr.Unary(op, a) {
            let none: Option[lexdb_sql.TypeName] = None
            if op == "-" {
                // a negative constant: as PostgreSQL folds it, '-1'::integer
                match a {
                    Expr.Lit(v) {
                        match v {
                            Val.Int(n) { return pgExprText(&Expr.Lit(Val.Int(-n)), &none) }
                            Val.Num(d) { return pgExprText(&Expr.Lit(Val.Num(d.neg())), &none) }
                            else {}
                        }
                    }
                    else {}
                }
            }
            return if op == "not" { "(NOT " + pgExprText(&a, &none) + ")" } else { "(- " + pgExprText(&a, &none) + ")" }
        }
        Expr.IsNull(a, neg) {
            let none: Option[lexdb_sql.TypeName] = None
            return "(" + pgExprText(&a, &none) + (if neg { " IS NOT NULL)" } else { " IS NULL)" })
        }
        Expr.Cast(a, t) {
            match a {
                Expr.Lit(v) {
                    match v {
                        Val.Text(s) { return "'" + strings.replaceAll(s, "'", "''") + "'::" + lexdb_pgcat.formatType(t.oid, -1) }
                        else {}
                    }
                }
                else {}
            }
            let none: Option[lexdb_sql.TypeName] = None
            return "(" + pgExprText(&a, &none) + ")::" + lexdb_pgcat.formatType(t.oid, -1)
        }
        Expr.Call(n, args, _) {
            if len(args) == 0 {
                if n == "current_timestamp" || n == "current_date" || n == "current_time" || n == "localtimestamp" || n == "localtime" {
                    return strings.toUpperAscii(n)
                }
                return n + "()"
            }
            return lexdb_sql.exprText(x)
        }
        else { return lexdb_sql.exprText(x) }
    }
}

// A column's DEFAULT as pg_attrdef shows it; None for none (an identity
// column has none: its sequence is its own).
fn defaultText(snap: &CatSnap, c: &lexdb_sql.ColDef): Option[str] {
    if c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT { return None }
    if c.identity == lexdb_sql.ID_SERIAL && len(c.seq) > 0 {
        return Some("nextval('" + shownIn(&snap.path, &lexdb_sql.schemaOf(&c.seq), &lexdb_sql.baseName(&c.seq)) + "'::regclass)")
    }
    match c.def {
        Some(d) { return Some(pgExprText(&d, &Some(c.typ))) }
        None { return None }
    }
}

// The catalog as the transaction sees it.
fn catSnap(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[CatSnap, DbErr] {
    var keys: []str = []
    var schemas: []str = ["public"]
    try st.scan(txn, CATALOG, "\x03", "\x04", fn(en: &lexdb_store.Entry): bool {
        append(mut &schemas, en.key[1..len(en.key)])
        return true
    })
    var raw: []str = []
    try st.scan(txn, CATALOG, "\x06", "", fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key)
        append(mut &raw, en.val)
        return true
    })
    var snap = CatSnap{acls: newMap(), tabs: [], views: [], cons: [], seqs: try allSeqs(st, txn, &""), schemas: schemas, path: copyStrs(&txn.path),
                       user: st.memoGet(&userKey(txn.sess)).unwrapOr("lexdb")}
    var aclKeys: []str = []
    var aclVals: []str = []
    try st.scan(txn, CATALOG, ACL_PRE, ACL_PRE + "\xff", fn(en: &lexdb_store.Entry): bool {
        append(mut &aclKeys, en.key[len(ACL_PRE)..len(en.key)].toStr())
        append(mut &aclVals, en.val)
        return true
    })
    for i in 0..len(aclKeys) { snap.acls.put(aclKeys[i], aclVals[i]) }
    for i in 0..len(keys) {
        let t = try decTable(&keys[i], &raw[i])
        let schema = lexdb_sql.schemaOf(&keys[i])
        let name = lexdb_sql.baseName(&keys[i])
        if len(t.view) > 0 {
            append(mut &snap.views, CatTab{key: keys[i], t: t, oid: catOid(&"r", &keys[i]), schema: schema, name: name,
                                           shown: shownIn(&txn.path, &schema, &name), idxs: []})
            continue
        }
        var idxs: []CatIdx = []
        if len(t.pk) > 0 {
            var cs: []int = []
            for p in t.pk { append(mut &cs, p + 1) }
            let pn = name + "_pkey"
            append(mut &idxs, CatIdx{name: pn, oid: catOid(&"i", &lexdb_sql.qual(&schema, &pn)), cols: cs, unique: true, primary: true,
                                     con: true, pred: None})
        }
        for ix in t.indexes {
            var cs: []int = []
            for c in ix.cols { append(mut &cs, c + 1) }
            let iname = lexdb_sql.baseName(&ix.name)
            append(mut &idxs, CatIdx{name: iname, oid: catOid(&"i", &lexdb_sql.qual(&schema, &iname)), cols: cs, unique: ix.unique,
                                     primary: false, con: ix.con, pred: cloneOptE(&ix.pred)})
        }
        append(mut &snap.tabs, CatTab{key: keys[i], t: t, oid: catOid(&"r", &keys[i]), schema: schema, name: name,
                                      shown: shownIn(&txn.path, &schema, &name), idxs: idxs})
    }
    // the constraints, now that every table's OID is known
    var cons: []CatCon = []
    for ti in 0..len(snap.tabs) {
        let ct = &snap.tabs[ti]
        for ix in ct.idxs {
            if !ix.con { continue }
            let ty = if ix.primary { "p" } else { "u" }
            let def = (if ix.primary { "PRIMARY KEY (" } else { "UNIQUE (" }) + colList(&ct.t, &ix.cols) + ")"
            append(mut &cons, CatCon{oid: catOid(&"c", &(ct.key + "\x00" + ix.name)), name: ix.name, typ: ty, rel: ct.oid,
                                          schema: ct.schema, cols: copyInts(&ix.cols), refRel: 0, refCols: [], idx: ix.oid, def: def,
                                          upd: " ", del: " ", check: ""})
        }
        for fk in ct.t.fks {
            var cs: []int = []
            for c in fk.cols { append(mut &cs, colNum(&ct.t, &c)) }
            var refRel = 0
            var refCols: []int = []
            var refIdx = 0
            var refShown = lexdb_sql.shown(&fk.ref)
            for rt in snap.tabs {
                if rt.key != fk.ref { continue }
                refRel = rt.oid
                refShown = rt.shown
                for c in fk.refCols { append(mut &refCols, colNum(&rt.t, &c)) }
                for ix in rt.idxs {
                    if ix.unique && len(ix.cols) == len(refCols) {
                        var same = true
                        for c in refCols {
                            var has = false
                            for d in ix.cols { if d == c { has = true } }
                            if !has { same = false }
                        }
                        if same && refIdx == 0 { refIdx = ix.oid }
                    }
                }
            }
            var refNames: []str = []
            for c in fk.refCols { append(mut &refNames, quoteIfNeeded(&c)) }
            var fcols: []str = []
            for c in fk.cols { append(mut &fcols, quoteIfNeeded(&c)) }
            let upd = fkAction(fk.onUpdate)
            let del = fkAction(fk.onDelete)
            var def = "FOREIGN KEY (" + strings.join(&fcols, ", ") + ") REFERENCES " + refShown + "(" + strings.join(&refNames, ", ") + ")"
            if upd != "a" { def = def + " ON UPDATE " + fkActionText(&upd) }
            if del != "a" { def = def + " ON DELETE " + fkActionText(&del) }
            append(mut &cons, CatCon{oid: catOid(&"c", &(ct.key + "\x00" + fk.name)), name: fk.name, typ: "f", rel: ct.oid,
                                          schema: ct.schema, cols: cs, refRel: refRel, refCols: refCols, idx: refIdx, def: def,
                                          upd: upd, del: del, check: ""})
        }
        for ck in ct.t.checks {
            let none: Option[lexdb_sql.TypeName] = None
            let x = pgExprText(&ck.expr, &none)
            let body = if strings.startsWith(&x, "(") { x } else { "(" + x + ")" }
            append(mut &cons, CatCon{oid: catOid(&"c", &(ct.key + "\x00" + ck.name)), name: ck.name, typ: "c", rel: ct.oid,
                                          schema: ct.schema, cols: [], refRel: 0, refCols: [], idx: 0, def: "CHECK (" + body + ")",
                                          upd: " ", del: " ", check: body})
        }
    }
    snap.cons = cons
    return Ok(snap)
}

fn idxDef(ct: &CatTab, ix: &CatIdx): str {
    var d = "CREATE " + (if ix.unique { "UNIQUE " } else { "" }) + "INDEX " + quoteIfNeeded(&ix.name) + " ON " +
            quoteIfNeeded(&ct.schema) + "." + quoteIfNeeded(&ct.name) + " USING btree (" + colList(&ct.t, &ix.cols) + ")"
    match ix.pred {
        Some(p) {
            let none: Option[lexdb_sql.TypeName] = None
            let x = pgExprText(&p, &none)
            d = d + " WHERE " + (if strings.startsWith(&x, "(") { x } else { "(" + x + ")" })
        }
        None {}
    }
    return d
}

fn seqOid(d: &Seq): int { return catOid(&"S", &d.key) }

fn clean(s: &str): str { return strings.replaceAll(strings.replaceAll(s, "\t", " "), "\n", " ") }

// What the catalog functions look up, in the memo: one line a fact.
fn bindCatalog(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[Unit, DbErr] {
    let snap = try catSnap(st, txn)
    var b = newStrBuf()
    b.add("u\t" + currentRole(st, txn.sess) + "\n")
    b.add("U\t" + sessionUser(st, txn.sess) + "\n")
    // the roles: OID, name, superuser, the roles each acts as; and every owner and grant (9.83)
    for r in try rolesIn(st, txn) {
        let w = try whoIs(st, txn, &r.name)
        b.add("R\t" + catOid(&"a", &r.name).toStr() + "\t" + r.name + "\t" + (if w.super { "1" } else { "0" }) + "\t" +
              strings.join(&w.roles, "\x1e") + "\n")
    }
    var aks: []str = []
    var avs: []str = []
    try st.scan(txn, CATALOG, ACL_PRE, ACL_PRE + "\xff", fn(en: &lexdb_store.Entry): bool {
        append(mut &aks, en.key[len(ACL_PRE)..len(en.key)].toStr())
        append(mut &avs, strings.replaceAll(strings.replaceAll(en.val, "\n", "\x1e"), "\t", "\x1d"))
        return true
    })
    for i in 0..len(aks) { b.add("A\t" + aks[i] + "\t" + avs[i] + "\n") }
    let cur = if len(snap.path) == 0 { "public" } else { snap.path[0] }
    b.add("p\t" + cur + "\n")
    for ct in snap.tabs {
        b.add("r\t" + ct.oid.toStr() + "\t" + ct.shown + "\t" + ct.schema + "\t" + ct.name + "\n")
        for ix in ct.idxs {
            b.add("r\t" + ix.oid.toStr() + "\t" + shownIn(&snap.path, &ct.schema, &ix.name) + "\t" + ct.schema + "\t" + ix.name + "\n")
            var cols: []str = []
            for c in ix.cols { append(mut &cols, if c >= 1 && c <= len(ct.t.cols) { ct.t.cols[c - 1].name } else { "" }) }
            b.add("x\t" + ix.oid.toStr() + "\t" + clean(&idxDef(&ct, &ix)) + "\t" + strings.join(&cols, "\x1e") + "\n")
        }
        for c in ct.t.cols {
            if len(c.seq) > 0 {
                b.add("s\t" + ct.oid.toStr() + "\t" + c.name + "\t" + quoteIfNeeded(&lexdb_sql.schemaOf(&c.seq)) + "." +
                      quoteIfNeeded(&lexdb_sql.baseName(&c.seq)) + "\n")
            }
        }
    }
    for v in snap.views {
        b.add("r\t" + v.oid.toStr() + "\t" + v.shown + "\t" + v.schema + "\t" + v.name + "\n")
        b.add("w\t" + v.oid.toStr() + "\t" + clean(&v.t.view) + "\n")
    }
    for d in snap.seqs {
        let sc = lexdb_sql.schemaOf(&d.key)
        let nm = lexdb_sql.baseName(&d.key)
        b.add("r\t" + seqOid(&d).toStr() + "\t" + shownIn(&snap.path, &sc, &nm) + "\t" + sc + "\t" + nm + "\n")
    }
    for r in lexdb_pgcat.relNames() {
        let dot = strings.indexOf(&r, ".", 0)
        let sc = if dot < 0 { "pg_catalog" } else { r[0..dot] }
        let nm = if dot < 0 { r } else { r[dot + 1..len(r)] }
        b.add("r\t" + (if dot < 0 { sysRelOid(&r) } else { catOid(&"r", &(sc + "\x1f" + nm)) }).toStr() + "\t" +
              shownIn(&snap.path, &sc, &nm) + "\t" + sc + "\t" + nm + "\n")
    }
    for c in snap.cons { b.add("c\t" + c.oid.toStr() + "\t" + clean(&c.def) + "\n") }
    for s in snap.schemas { b.add("n\t" + nspOid(&s).toStr() + "\t" + s + "\n") }
    b.add("n\t11\tpg_catalog\nn\t13000\tinformation_schema\n")
    st.memoPut(&catMemoKey(txn.sess), &b.toStr())
    return Ok(Unit{})
}

// The bound catalog's lines of a kind, split at tabs.
fn catLines(se: &SeqEnv, kind: &str): [][]str {
    let all = se.st.memoGet(&catMemoKey(se.sess)).unwrapOr("")
    var out: [][]str = []
    for l in strings.split(&all, "\n") {
        if len(l) > 2 && l[0..1] == kind && l[1] == '\t' {
            var fs: []str = []
            for f in strings.split(&l[2..len(l)], "\t") { append(mut &fs, f.toStr()) }
            append(mut &out, fs)
        }
    }
    return out
}

fn catUser(se: &SeqEnv): str {
    for l in catLines(se, &"u") { return l[0] }
    return se.st.memoGet(&userKey(se.sess)).unwrapOr("lexdb")
}

// A relation's OID by its name as written (schema.name, or a name on the
// path; quoted parts as they are), 0 if none.
fn relOidOf(se: &SeqEnv, s: &str): int {
    var sc = ""
    var nm = strings.trim(s)
    var parts: []str = []
    var cur = newStrBuf()
    var q = false
    for i in 0..len(nm) {
        let c = nm[i]
        if c == '"' { q = !q }
        else if c == '.' && !q {
            append(mut &parts, cur.toStr())
            cur = newStrBuf()
        } else { cur.addByte(if !q && c >= 'A' && c <= 'Z' { c + 32 } else { c }) }
    }
    append(mut &parts, cur.toStr())
    if len(parts) == 2 { sc = parts[0] }
    let name = parts[len(parts) - 1]
    for l in catLines(se, &"r") {
        if l[3] != name { continue }
        if len(sc) > 0 && l[2] != sc { continue }
        if len(sc) == 0 && strings.indexOf(&l[1], ".", 0) >= 0 && l[1] != quoteIfNeeded(&name) { continue }
        return strings.parseIntOpt(l[0]).unwrapOr(0)
    }
    return 0
}

fn relShown(se: &SeqEnv, oid: int): Option[str] {
    let k = oid.toStr()
    for l in catLines(se, &"r") { if l[0] == k { return Some(l[1]) } }
    return None
}

fn oidArg(v: &Val): Option[int] {
    match v {
        Val.Int(n) { return Some(n) }
        Val.Reg(o, _) { return Some(o) }
        Val.Text(s) { return strings.parseIntOpt(strings.trim(s)) }
        else { return None }
    }
}

// A value cast to a reg type: a name looked up, an OID shown by its name.
fn regCast(v: &Val, oid: int, se: &Option[SeqEnv]): Result[Val, DbErr] {
    if isNull(v) { return Ok(Val.Null) }
    let num = oidArg(v)
    let name = match v {
        Val.Text(s) { s }
        else { "" }
    }
    if oid == lexdb_sql.OID_REGTYPE {
        match num {
            Some(n) { return Ok(Val.Reg(n, if lexdb_pgcat.typeOf(n).isSome() { lexdb_pgcat.formatType(n, -1) } else { n.toStr() })) }
            None {}
        }
        let t = lexdb_pgcat.typeByName(&name)
        if t == 0 { return Err(e("42704", "type \"" + name + "\" does not exist")) }
        return Ok(Val.Reg(t, lexdb_pgcat.formatType(t, -1)))
    }
    let q = match se {
        Some(x) { x }
        None { return Err(e("0A000", "lexdb: a reg type is not allowed here")) }
    }
    if oid == lexdb_sql.OID_REGNAMESPACE {
        for l in catLines(&q, &"n") {
            match num {
                Some(n) { if l[0] == n.toStr() { return Ok(Val.Reg(n, quoteIfNeeded(&l[1]))) } }
                None { if l[1] == name { return Ok(Val.Reg(strings.parseIntOpt(l[0]).unwrapOr(0), quoteIfNeeded(&l[1]))) } }
            }
        }
        match num {
            Some(n) { return Ok(Val.Reg(n, n.toStr())) }
            None { return Err(e("3F000", "schema \"" + name + "\" does not exist")) }
        }
    }
    match num {
        Some(n) { return Ok(Val.Reg(n, relShown(&q, n).unwrapOr(n.toStr()))) }
        None {}
    }
    let o = relOidOf(&q, &name)
    if o == 0 {
        if oid == lexdb_sql.OID_REGCLASS { return Err(e("42P01", "relation \"" + name + "\" does not exist")) }
        return Err(e("42883", "function \"" + name + "\" does not exist"))
    }
    return Ok(Val.Reg(o, relShown(&q, o).unwrapOr(name)))
}

// A set-returning function in a select list (unnest, generate_subscripts,
// pg_partition_ancestors): its values, marked, expanded into rows when the
// query's rows are made (expandSrfs).
const SRF_MARK: str = "\x00srf"

// Whether a select list calls a set-returning function: only then are its
// rows looked through for marked values.
fn hasSrfCall(xs: &[]Expr): bool {
    for x in xs { if srfIn(&x) { return true } }
    return false
}

fn srfIn(x: &Expr): bool {
    match x {
        Expr.Call(n, args, _) {
            if n == "unnest" || n == "generate_subscripts" || n == "pg_partition_ancestors" { return true }
            for a in args { if srfIn(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return srfIn(&a) }
        Expr.Bin(_, a, b) { return srfIn(&a) || srfIn(&b) }
        Expr.IsNull(a, _) { return srfIn(&a) }
        Expr.Cast(a, _) { return srfIn(&a) }
        else { return false }
    }
}

fn srfMark(vals: &[]Val): Val { return Val.Text(SRF_MARK + arrayText(vals)) }

fn srfParts(v: &Val): Option[[]Option[str]] {
    match v {
        Val.Text(s) {
            if strings.startsWith(&s, SRF_MARK) {
                match arrayParts(&s[len(SRF_MARK)..len(s)]) {
                    Ok(p) { return Some(p) }
                    Err(_) {}
                }
            }
        }
        else {}
    }
    return None
}

// Each row with set-returning values made into as many rows as the longest
// has values (the others NULL past their end), as PostgreSQL 10 on does;
// none if every one is empty.
fn expandSrfs(rows: mut &[]OutRow, outs: &[]OutCol): Result[Unit, DbErr] {
    var any = false
    for r in rows { for v in r.vals { if srfParts(&v).isSome() { any = true } } }
    if !any { return Ok(Unit{}) }
    var out: []OutRow = []
    for ri in 0..len(rows) {
        let r = replace(mut &rows[ri], OutRow{vals: [], ord: []})
        var parts: []Option[[]Option[str]] = []
        var n = -1
        for v in r.vals {
            let p = srfParts(&v)
            match p {
                Some(ps) { if len(ps) > n { n = len(ps) } }
                None {}
            }
            append(mut &parts, p)
        }
        if n < 0 {
            append(mut &out, r)
            continue
        }
        for k in 0..n {
            var vals: []Val = []
            for c in 0..len(r.vals) {
                match parts[c] {
                    Some(ps) {
                        if k < len(ps) {
                            match ps[k] {
                                Some(t) {
                                    let ty = oidType(if c < len(outs) { outs[c].oid } else { lexdb_sql.OID_TEXT })
                                    append(mut &vals, if ty.kind == lexdb_sql.K_REG { Val.Reg(strings.parseIntOpt(t).unwrapOr(0), t) } else { try coerce(Val.Text(t), &ty) })
                                }
                                None { append(mut &vals, Val.Null) }
                            }
                        } else {
                            append(mut &vals, Val.Null)
                        }
                    }
                    None { append(mut &vals, r.vals[c]) }
                }
            }
            append(mut &out, OutRow{vals: vals, ord: copyRow(&r.ord)})
        }
    }
    let gone = replace(rows, out)
    return Ok(Unit{})
}

// s without the parentheses around the whole of it, if it has them.
fn unwrapParens(s: &str): str {
    if len(s) < 2 || s[0] != '(' || s[len(s) - 1] != ')' { return s.toStr() }
    var depth = 0
    var q = false
    for i in 0..len(s) {
        let c = s[i]
        if c == '\'' { q = !q }
        if q { continue }
        if c == '(' { depth += 1 }
        if c == ')' {
            depth -= 1
            if depth == 0 && i < len(s) - 1 { return s.toStr() }
        }
    }
    return s[1..len(s) - 1].toStr()
}

fn jsonText(v: &Val): str {
    match v {
        Val.Null { return "null" }
        Val.Int(n) { return n.toStr() }
        Val.Num(d) { return d.toStr() }
        Val.Bool(b) { return if b { "true" } else { "false" } }
        Val.Float(_) { return text(v) }
        else {
            var b = newStrBuf()
            b.addByte('"')
            let s = text(v)
            for i in 0..len(s) {
                let c = s[i]
                if c == '"' { b.add("\\\"") }
                else if c == '\\' { b.add("\\\\") }
                else if c == '\n' { b.add("\\n") }
                else if c == '\t' { b.add("\\t") }
                else if c == '\r' { b.add("\\r") }
                else { b.addByte(c) }
            }
            b.addByte('"')
            return b.toStr()
        }
    }
}

// The functions that need no catalog: None if name is none of them.
fn callMisc(name: &str, vs: &[]Val): Result[Option[Val], DbErr] {
    let n = len(vs)
    if name == "~" || name == "!~" || name == "~*" || name == "!~*" {
        if n != 2 { return Ok(None) }
        if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Some(Val.Null)) }
        let pat = (if strings.contains(name, "*") { "(?i)" } else { "" }) + text(&vs[1])
        match regex.compile(pat) {
            Ok(re) {
                let m = re.isMatch(text(&vs[0]))
                return Ok(Some(Val.Bool(if strings.startsWith(name, "!") { !m } else { m })))
            }
            Err(err) { return Err(e("2201B", "invalid regular expression: " + err.toStr())) }
        }
    }
    if name == "#elem" && n == 2 {
        if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Some(Val.Null)) }
        let i = oidArg(&vs[1]).unwrapOr(0)
        let ps = try arrayParts(&text(&vs[0]))
        if i < 1 || i > len(ps) { return Ok(Some(Val.Null)) }
        match ps[i - 1] {
            Some(p) { return Ok(Some(Val.Text(p))) }
            None { return Ok(Some(Val.Null)) }
        }
    }
    if name == "unnest" && n == 1 {
        if isNull(&vs[0]) { return Ok(Some(srfMark(&[]))) }
        var vals: []Val = []
        for p in try arrayParts(&text(&vs[0])) {
            match p {
                Some(x) { append(mut &vals, Val.Text(x)) }
                None { append(mut &vals, Val.Null) }
            }
        }
        return Ok(Some(srfMark(&vals)))
    }
    if name == "generate_subscripts" && (n == 2 || n == 3) {
        if isNull(&vs[0]) { return Ok(Some(srfMark(&[]))) }
        let k = len(try arrayParts(&text(&vs[0])))
        var vals: []Val = []
        for i in 1..k + 1 { append(mut &vals, Val.Int(i)) }
        if n == 3 && truth(&vs[2]) == Some(true) {
            var rev: []Val = []
            var j = len(vals) - 1
            while j >= 0 {
                append(mut &rev, vals[j])
                j -= 1
            }
            return Ok(Some(srfMark(&rev)))
        }
        return Ok(Some(srfMark(&vals)))
    }
    if name == "format_type" && n == 2 {
        if isNull(&vs[0]) { return Ok(Some(Val.Null)) }
        let m = if isNull(&vs[1]) { -1 } else { oidArg(&vs[1]).unwrapOr(-1) }
        return Ok(Some(Val.Text(lexdb_pgcat.formatType(oidArg(&vs[0]).unwrapOr(0), m))))
    }
    if (name == "btrim" || name == "ltrim" || name == "rtrim") && n == 2 {
        // the characters of vs[1] off the start, the end, or both
        if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Some(Val.Null)) }
        let x = text(&vs[0])
        let cs = text(&vs[1])
        var a = 0
        var b = len(x)
        if name != "rtrim" { while a < b && strings.contains(&cs, &x[a..a + 1]) { a += 1 } }
        if name != "ltrim" { while b > a && strings.contains(&cs, &x[b - 1..b]) { b -= 1 } }
        return Ok(Some(Val.Text(x[a..b].toStr())))
    }
    if name == "repeat" && n == 2 {
        if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Some(Val.Null)) }
        let k = oidArg(&vs[1]).unwrapOr(0)
        let t = text(&vs[0])
        if k > 0 && len(t) * k > 1073741823 { return Err(e("54000", "requested length too large")) }
        return Ok(Some(Val.Text(if k <= 0 { "" } else { strings.repeat(t, k) })))
    }
    if name == "quote_ident" && n == 1 {
        if isNull(&vs[0]) { return Ok(Some(Val.Null)) }
        return Ok(Some(Val.Text(quoteIfNeeded(&text(&vs[0])))))
    }
    if (name == "array_to_string" && (n == 2 || n == 3)) {
        if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Some(Val.Null)) }
        var parts: []str = []
        for p in try arrayParts(&text(&vs[0])) {
            match p {
                Some(x) { append(mut &parts, x) }
                None { if n == 3 && !isNull(&vs[2]) { append(mut &parts, text(&vs[2])) } }
            }
        }
        return Ok(Some(Val.Text(strings.join(&parts, &text(&vs[1])))))
    }
    if (name == "array_length" || name == "array_upper" || name == "array_lower" || name == "cardinality") && (n == 2 || (n == 1 && name == "cardinality")) {
        if isNull(&vs[0]) { return Ok(Some(Val.Null)) }
        let k = len(try arrayParts(&text(&vs[0])))
        if k == 0 { return Ok(Some(if name == "cardinality" { Val.Int(0) } else { Val.Null })) }
        if n == 2 && oidArg(&vs[1]).unwrapOr(0) != 1 { return Ok(Some(Val.Null)) }
        return Ok(Some(Val.Int(if name == "array_lower" { 1 } else { k })))
    }
    if name == "pg_encoding_to_char" && n == 1 { return Ok(Some(Val.Text(if oidArg(&vs[0]) == Some(6) { "UTF8" } else { "SQL_ASCII" }))) }
    if (name == "json_build_object" || name == "jsonb_build_object") {
        if n % 2 != 0 { return Err(e("22023", "argument list must have even number of elements")) }
        var parts: []str = []
        var k = 0
        while k < n {
            if isNull(&vs[k]) { return Err(e("22004", "null value not allowed for object key")) }
            append(mut &parts, jsonText(&Val.Text(text(&vs[k]))) + " : " + jsonText(&vs[k + 1]))
            k += 2
        }
        return Ok(Some(Val.Text("{" + strings.join(&parts, ", ") + "}")))
    }
    if (name == "pg_type_is_visible" || name == "pg_function_is_visible" || name == "pg_collation_is_visible") && n == 1 {
        return Ok(Some(if isNull(&vs[0]) { Val.Null } else { Val.Bool(true) }))
    }
    if (name == "obj_description" || name == "col_description" || name == "shobj_description" ||
        name == "pg_get_triggerdef" || name == "pg_get_ruledef" || name == "pg_get_statisticsobjdef_columns" || name == "pg_get_function_result" ||
        name == "pg_get_function_arguments") {
        return Ok(Some(Val.Null))
    }
    if name == "pg_get_expr" && (n == 2 || n == 3) {
        // pretty: without the parentheses around the whole
        if n == 3 && truth(&vs[2]) == Some(true) && !isNull(&vs[0]) { return Ok(Some(Val.Text(unwrapParens(&text(&vs[0]))))) }
        return Ok(Some(vs[0]))
    }
    return Ok(None)
}

// The functions that read the bound catalog: None if name is none of them.
fn callCat(name: &str, vs: &[]Val, se: &SeqEnv): Result[Option[Val], DbErr] {
    let n = len(vs)
    if name == "current_user" { return Ok(Some(Val.Text(catUser(se)))) }
    if name == "session_user" {
        for l in catLines(se, &"U") { return Ok(Some(Val.Text(l[0]))) }
        return Ok(Some(Val.Text(catUser(se))))
    }
    if name == "current_schema" && n == 0 {
        for l in catLines(se, &"p") { return Ok(Some(Val.Text(l[0]))) }
        return Ok(Some(Val.Text("public")))
    }
    if name == "pg_get_userbyid" && n == 1 {
        if isNull(&vs[0]) { return Ok(Some(Val.Null)) }
        let o = oidArg(&vs[0]).unwrapOr(0).toStr()
        for l in catLines(se, &"R") { if l[0] == o { return Ok(Some(Val.Text(l[1]))) } }
        for l in catLines(se, &"U") { return Ok(Some(Val.Text(l[0]))) }
        return Ok(Some(Val.Text(catUser(se))))
    }
    if name == "has_database_privilege" { return Ok(Some(Val.Bool(true))) }
    if name == "has_table_privilege" || name == "has_schema_privilege" || name == "has_sequence_privilege" || name == "has_any_column_privilege" {
        for v in vs { if isNull(&v) { return Ok(Some(Val.Null)) } }
        return Ok(Some(try hasPrivFn(se, name, vs)))
    }
    if name == "pg_relation_is_publishable" { return Ok(Some(Val.Bool(false))) }
    if (name == "pg_relation_size" || name == "pg_total_relation_size" || name == "pg_table_size" || name == "pg_indexes_size") {
        return Ok(Some(Val.Int(0)))
    }
    if n >= 1 && isNull(&vs[0]) { return Ok(Some(Val.Null)) }
    if name == "pg_table_is_visible" && n == 1 {
        match relShown(se, oidArg(&vs[0]).unwrapOr(0)) {
            Some(s) { return Ok(Some(Val.Bool(strings.indexOf(&s, ".", 0) < 0 || strings.startsWith(&s, "\"")))) }
            None { return Ok(Some(Val.Null)) }
        }
    }
    if name == "pg_get_constraintdef" && (n == 1 || n == 2) {
        let k = oidArg(&vs[0]).unwrapOr(0).toStr()
        let pretty = n == 2 && truth(&vs[1]) == Some(true)
        for l in catLines(se, &"c") {
            if l[0] != k { continue }
            // pretty: CHECK (x), not CHECK ((x))
            if pretty && strings.startsWith(&l[1], "CHECK (") && strings.endsWith(&l[1], ")") {
                return Ok(Some(Val.Text("CHECK (" + unwrapParens(&l[1][7..len(l[1]) - 1]) + ")")))
            }
            return Ok(Some(Val.Text(l[1])))
        }
        return Ok(Some(Val.Null))
    }
    if name == "pg_get_indexdef" && (n == 1 || n == 3) {
        let k = oidArg(&vs[0]).unwrapOr(0).toStr()
        let col = if n == 3 { oidArg(&vs[1]).unwrapOr(0) } else { 0 }
        for l in catLines(se, &"x") {
            if l[0] != k { continue }
            if col == 0 { return Ok(Some(Val.Text(l[1]))) }
            let cs = strings.split(&l[2], "\x1e")
            if col <= len(cs) { return Ok(Some(Val.Text(quoteIfNeeded(&cs[col - 1])))) }
            return Ok(Some(Val.Text("")))
        }
        return Ok(Some(Val.Null))
    }
    if name == "pg_get_serial_sequence" && n == 2 {
        let rel = relOidOf(se, &text(&vs[0]))
        if rel == 0 { return Err(e("42P01", "relation \"" + text(&vs[0]) + "\" does not exist")) }
        let col = text(&vs[1])
        for l in catLines(se, &"s") { if l[0] == rel.toStr() && l[1] == col { return Ok(Some(Val.Text(l[2]))) } }
        return Ok(Some(Val.Null))
    }
    if (name == "to_regclass" || name == "to_regtype" || name == "to_regnamespace") && n == 1 {
        let o = if name == "to_regclass" { lexdb_sql.OID_REGCLASS } else if name == "to_regtype" { lexdb_sql.OID_REGTYPE } else { lexdb_sql.OID_REGNAMESPACE }
        match regCast(&Val.Text(text(&vs[0])), o, &Some(se)) {
            Ok(v) { return Ok(Some(v)) }
            Err(_) { return Ok(Some(Val.Null)) }
        }
    }
    if name == "pg_get_viewdef" && (n == 1 || n == 2) {
        // by OID, or by name; the text as it was written, with PostgreSQL's ;
        var o = oidArg(&vs[0]).unwrapOr(0)
        if o == 0 { o = relOidOf(se, &text(&vs[0])) }
        for l in catLines(se, &"w") { if l[0] == o.toStr() { return Ok(Some(Val.Text(l[1] + ";"))) } }
        return Ok(Some(Val.Null))
    }
    if name == "pg_partition_ancestors" && n == 1 {
        let o = oidArg(&vs[0]).unwrapOr(0)
        return Ok(Some(srfMark(&[Val.Int(o)])))
    }
    return Ok(None)
}

// ---- the catalog relations' rows

fn bv(b: bool): Val { return Val.Bool(b) }
fn tv(s: &str): Val { return Val.Text(s.toStr()) }
fn iv(n: int): Val { return Val.Int(n) }
fn intsArr(ns: &[]int): Val {
    var vs: []Val = []
    for x in ns { append(mut &vs, Val.Int(x)) }
    return Val.Text(arrayText(&vs))
}
// An int2vector or oidvector: its numbers, spaced.
fn vecOf(ns: &[]int): Val {
    var parts: []str = []
    for x in ns { append(mut &parts, x.toStr()) }
    return Val.Text(strings.join(&parts, " "))
}

fn zeros(n: int): Val {
    var ns: []int = []
    for i in 0..n { append(mut &ns, 0) }
    return vecOf(&ns)
}

fn typLenOf(oid: int): int {
    match lexdb_pgcat.typeOf(oid) {
        Some(t) { return t.len }
        None { return -1 }
    }
}

// A column's typmod: varchar's length + 4, numeric's precision << 16 |
// scale + 4, a time type's precision; -1 none.
fn typmodOf(t: &lexdb_sql.TypeName): int {
    if t.oid == lexdb_sql.OID_VARCHAR && t.len > 0 { return t.len + 4 }
    if t.kind == lexdb_sql.K_NUM && t.prec > 0 { return ((t.prec << 16) | t.scale) + 4 }
    if isTimeKind(t.kind) && t.prec > 0 { return t.scale }
    return -1
}

fn collOf(oid: int): int {
    return if oid == lexdb_sql.OID_TEXT || oid == lexdb_sql.OID_VARCHAR || oid == lexdb_sql.OID_NAME || oid == 1009 || oid == 1015 { 100 } else { 0 }
}

fn attRow(rel: int, name: &str, typ: int, mod: int, num: int, notNull: bool, hasDef: bool, ident: str): []Val {
    let ty = lexdb_pgcat.typeOf(typ)
    let byval = match ty {
        Some(t) { t.byval }
        None { false }
    }
    let align = match lexdb_pgcat.typeOf(typ) {
        Some(t) { t.align }
        None { "i" }
    }
    let isArr = lexdb_sql.elemOid(typ) > 0 && typ != 22 && typ != 30
    return [iv(rel), tv(&name), iv(typ), iv(typLenOf(typ)), iv(num), iv(-1), iv(mod), iv(if isArr { 1 } else { 0 }), bv(byval),
            tv(&align), tv(&if byval { "p" } else { "x" }), tv(&""), bv(notNull), bv(hasDef), bv(false), tv(&ident), tv(&""),
            bv(false), bv(true), iv(0), iv(-1), iv(collOf(typ)), Val.Null, Val.Null, Val.Null, Val.Null]
}

fn identOf(c: &lexdb_sql.ColDef): str {
    if c.identity == lexdb_sql.ID_ALWAYS { return "a" }
    if c.identity == lexdb_sql.ID_BY_DEFAULT { return "d" }
    return ""
}

fn infoType(t: &lexdb_sql.TypeName): str {
    if t.kind == lexdb_sql.K_ARRAY { return "ARRAY" }
    let f = lexdb_pgcat.formatType(t.oid, -1)
    return f
}

// The rows of catalog relation rel.
fn catRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, rel: &str): Result[[][]Val, DbErr] {
    let snap = try catSnap(st, txn)
    var rows: [][]Val = []
    let db = "lexdb"
    let owner = snap.user
    let roles = try rolesIn(st, txn)
    match rel {
        "pg_namespace" {
            append(mut &rows, [iv(OID_PG_CATALOG), tv(&"pg_catalog"), iv(OID_OWNER), Val.Null])
            append(mut &rows, [iv(OID_INFO_SCHEMA), tv(&"information_schema"), iv(OID_OWNER), Val.Null])
            for s in snap.schemas {
                let na = aclOf(&snap, &nspObj(&s))
                append(mut &rows, [iv(nspOid(&s)), tv(&s), iv(roleOid(&ownerName(&snap, &na), &roles)), aclText(&snap, &na, &"UC")])
            }
        }
        "pg_class" {
            for ct in snap.tabs {
                let hasIdx = len(ct.idxs) > 0
                let trig = len(ct.t.fks) > 0 || len(ct.t.refBy) > 0
                let ta = aclOf(&snap, &relObj(&ct.key))
                append(mut &rows, [iv(ct.oid), tv(&ct.name), iv(nspOid(&ct.schema)), iv(0), iv(0), iv(roleOid(&ownerName(&snap, &ta), &roles)), iv(2), iv(ct.oid), iv(0),
                                   iv(0), Val.Real(-1.0f), iv(0), iv(0), bv(hasIdx), bv(false), tv(&"p"), tv(&"r"), iv(len(ct.t.cols)),
                                   iv(len(ct.t.checks)), bv(false), bv(trig), bv(false), bv(false), bv(false), bv(true), tv(&"d"),
                                   bv(false), iv(0), iv(0), iv(0), aclText(&snap, &ta, &"arwdDxt"), Val.Null, Val.Null])
                for ix in ct.idxs {
                    append(mut &rows, [iv(ix.oid), tv(&ix.name), iv(nspOid(&ct.schema)), iv(0), iv(0), iv(OID_OWNER), iv(403), iv(ix.oid),
                                       iv(0), iv(0), Val.Real(0.0f), iv(0), iv(0), bv(false), bv(false), tv(&"p"), tv(&"i"), iv(len(ix.cols)),
                                       iv(0), bv(false), bv(false), bv(false), bv(false), bv(false), bv(true), tv(&"n"), bv(false),
                                       iv(0), iv(0), iv(0), Val.Null, Val.Null, Val.Null])
                }
            }
            for v in snap.views {
                let va = aclOf(&snap, &relObj(&v.key))
                append(mut &rows, [iv(v.oid), tv(&v.name), iv(nspOid(&v.schema)), iv(0), iv(0), iv(roleOid(&ownerName(&snap, &va), &roles)), iv(0), iv(0), iv(0),
                                   iv(0), Val.Real(-1.0f), iv(0), iv(0), bv(false), bv(false), tv(&"p"), tv(&"v"), iv(len(v.t.cols)),
                                   iv(0), bv(true), bv(false), bv(false), bv(false), bv(false), bv(true), tv(&"n"),
                                   bv(false), iv(0), iv(0), iv(0), aclText(&snap, &va, &"arwdDxt"), Val.Null, Val.Null])
            }
            for d in snap.seqs {
                let sc = lexdb_sql.schemaOf(&d.key)
                let sa = aclOf(&snap, &relObj(&d.key))
                append(mut &rows, [iv(seqOid(&d)), tv(&lexdb_sql.baseName(&d.key)), iv(nspOid(&sc)), iv(0), iv(0), iv(roleOid(&ownerName(&snap, &sa), &roles)), iv(0),
                                   iv(seqOid(&d)), iv(0), iv(1), Val.Real(1.0f), iv(0), iv(0), bv(false), bv(false), tv(&"p"), tv(&"S"),
                                   iv(3), iv(0), bv(false), bv(false), bv(false), bv(false), bv(false), bv(true), tv(&"n"), bv(false),
                                   iv(0), iv(0), iv(0), aclText(&snap, &sa, &"rwU"), Val.Null, Val.Null])
            }
            for r in lexdb_pgcat.relNames() {
                let dot = strings.indexOf(&r, ".", 0)
                let sc = if dot < 0 { "pg_catalog" } else { r[0..dot] }
                let nm = if dot < 0 { r } else { r[dot + 1..len(r)] }
                let o = if dot < 0 { sysRelOid(&r) } else { catOid(&"r", &(sc + "\x1f" + nm)) }
                let view = dot >= 0 || strings.startsWith(&r, "pg_tables") || r == "pg_indexes" || r == "pg_views" ||
                           r == "pg_matviews" || r == "pg_sequences" || r == "pg_settings" || r == "pg_roles" || r == "pg_user"
                append(mut &rows, [iv(o), tv(&nm), iv(nspOid(&sc)), iv(0), iv(0), iv(OID_OWNER), iv(if view { 0 } else { 2 }), iv(o),
                                   iv(0), iv(0), Val.Real(-1.0f), iv(0), iv(0), bv(false), bv(false), tv(&"p"), tv(&if view { "v" } else { "r" }),
                                   iv(len(lexdb_pgcat.relCols(&r))), iv(0), bv(view), bv(false), bv(false), bv(false), bv(false),
                                   bv(true), tv(&if view { "n" } else { "d" }), bv(false), iv(0), iv(0), iv(0), Val.Null, Val.Null, Val.Null])
            }
        }
        "pg_attribute" {
            for ct in snap.tabs {
                for i in 0..len(ct.t.cols) {
                    let c = &ct.t.cols[i]
                    var nn = c.notNull
                    for p in ct.t.pk { if p == i { nn = true } }
                    append(mut &rows, attRow(ct.oid, &c.name, c.typ.oid, typmodOf(&c.typ), i + 1, nn, defaultText(&snap, c).isSome(), identOf(c)))
                }
                for ix in ct.idxs {
                    for k in 0..len(ix.cols) {
                        let cn = ix.cols[k]
                        if cn < 1 || cn > len(ct.t.cols) { continue }
                        let c = &ct.t.cols[cn - 1]
                        append(mut &rows, attRow(ix.oid, &c.name, c.typ.oid, typmodOf(&c.typ), k + 1, false, false, ""))
                    }
                }
            }
            for v in snap.views {
                for i in 0..len(v.t.cols) {
                    let c = &v.t.cols[i]
                    append(mut &rows, attRow(v.oid, &c.name, c.typ.oid, typmodOf(&c.typ), i + 1, false, false, ""))
                }
            }
            for r in lexdb_pgcat.relNames() {
                let dot = strings.indexOf(&r, ".", 0)
                let o = if dot < 0 { sysRelOid(&r) } else { catOid(&"r", &(r[0..dot] + "\x1f" + r[dot + 1..len(r)])) }
                let cs = lexdb_pgcat.relCols(&r)
                for k in 0..len(cs) { append(mut &rows, attRow(o, &cs[k].name, cs[k].oid, -1, k + 1, false, false, "")) }
            }
        }
        "pg_attrdef" {
            for ct in snap.tabs {
                for i in 0..len(ct.t.cols) {
                    match defaultText(&snap, &ct.t.cols[i]) {
                        Some(d) { append(mut &rows, [iv(catOid(&"d", &(ct.key + "\x00" + ct.t.cols[i].name))), iv(ct.oid), iv(i + 1), tv(&d)]) }
                        None {}
                    }
                }
            }
        }
        "pg_type" {
            for t in lexdb_pgcat.types() {
                let arr = t.cat == "A"
                append(mut &rows, [iv(t.oid), tv(&t.name), iv(OID_PG_CATALOG), iv(OID_OWNER), iv(t.len), bv(t.byval), tv(&"b"), tv(&t.cat),
                                   bv(t.pref), bv(true), tv(&","), iv(0), tv(&if arr { "array_subscript_handler" } else { "-" }),
                                   iv(t.elem), iv(t.array), tv(&if arr { "array_in" } else { t.name + "in" }),
                                   tv(&if arr { "array_out" } else { t.name + "out" }), tv(&"-"), tv(&"-"), tv(&"-"), tv(&"-"), tv(&"-"),
                                   tv(&t.align), tv(&if t.byval { "p" } else { "x" }), bv(false), iv(0), iv(-1), iv(0), iv(t.coll),
                                   Val.Null, Val.Null, Val.Null])
            }
        }
        "pg_index" {
            for ct in snap.tabs {
                for ix in ct.idxs {
                    var colls: []int = []
                    for c in ix.cols { append(mut &colls, if c >= 1 && c <= len(ct.t.cols) { collOf(ct.t.cols[c - 1].typ.oid) } else { 0 }) }
                    let pred = predVal(&ix.pred)
                    append(mut &rows, [iv(ix.oid), iv(ct.oid), iv(len(ix.cols)), iv(len(ix.cols)), bv(ix.unique), bv(false), bv(ix.primary),
                                       bv(false), bv(true), bv(false), bv(true), bv(false), bv(true), bv(true), bv(false),
                                       vecOf(&ix.cols), vecOf(&colls), zeros(len(ix.cols)), zeros(len(ix.cols)), Val.Null, pred])
                }
            }
        }
        "pg_constraint" {
            for c in snap.cons {
                let isF = c.typ == "f"
                append(mut &rows, [iv(c.oid), tv(&c.name), iv(nspOid(&c.schema)), tv(&c.typ), bv(false), bv(false), bv(true), iv(c.rel),
                                   iv(0), iv(c.idx), iv(0), iv(c.refRel), tv(&c.upd), tv(&c.del), tv(&if isF { "s" } else { " " }),
                                   bv(true), iv(0), bv(false), if c.typ == "c" { Val.Null } else { intsArr(&c.cols) },
                                   if isF { intsArr(&c.refCols) } else { Val.Null }, Val.Null, Val.Null, Val.Null, Val.Null, Val.Null,
                                   if c.typ == "c" { tv(&c.check) } else { Val.Null }, bv(false)])
            }
        }
        "pg_sequence" {
            for d in snap.seqs {
                append(mut &rows, [iv(seqOid(&d)), iv(d.typ), iv(d.start), iv(d.inc), iv(d.max), iv(d.min), iv(d.cache), bv(d.cycle)])
            }
        }
        "pg_depend" {
            for ct in snap.tabs {
                for i in 0..len(ct.t.cols) {
                    let c = &ct.t.cols[i]
                    if len(c.seq) == 0 { continue }
                    append(mut &rows, [iv(1259), iv(catOid(&"S", &c.seq)), iv(0), iv(1259), iv(ct.oid), iv(i + 1),
                                       tv(&if c.identity == lexdb_sql.ID_SERIAL { "a" } else { "i" })])
                }
            }
        }
        "pg_collation" {
            append(mut &rows, [iv(100), tv(&"default"), iv(OID_PG_CATALOG), iv(OID_OWNER), tv(&"d"), bv(true), iv(-1), Val.Null, Val.Null, Val.Null, Val.Null, Val.Null])
            append(mut &rows, [iv(950), tv(&"C"), iv(OID_PG_CATALOG), iv(OID_OWNER), tv(&"c"), bv(true), iv(-1), tv(&"C"), tv(&"C"), Val.Null, Val.Null, Val.Null])
            append(mut &rows, [iv(951), tv(&"POSIX"), iv(OID_PG_CATALOG), iv(OID_OWNER), tv(&"c"), bv(true), iv(-1), tv(&"POSIX"), tv(&"POSIX"), Val.Null, Val.Null, Val.Null])
        }
        "pg_am" {
            append(mut &rows, [iv(2), tv(&"heap"), tv(&"heap_tableam_handler"), tv(&"t")])
            append(mut &rows, [iv(403), tv(&"btree"), tv(&"bthandler"), tv(&"i")])
            append(mut &rows, [iv(405), tv(&"hash"), tv(&"hashhandler"), tv(&"i")])
        }
        "pg_database" {
            append(mut &rows, [iv(16384), tv(&db), iv(OID_OWNER), iv(6), tv(&"c"), bv(false), bv(true), iv(-1), iv(0), iv(1), iv(1663),
                               tv(&"C"), tv(&"C"), Val.Null, Val.Null, Val.Null, Val.Null, Val.Null])
        }
        "pg_tablespace" {
            append(mut &rows, [iv(1663), tv(&"pg_default"), iv(OID_OWNER), Val.Null, Val.Null])
            append(mut &rows, [iv(1664), tv(&"pg_global"), iv(OID_OWNER), Val.Null, Val.Null])
        }
        "pg_roles", "pg_user" {
            var rs = try rolesIn(st, txn)
            var seen = false
            let sessUser = sessionUser(st, txn.sess)
            for r in rs { if r.name == owner { seen = true } }
            if !seen { append(mut &rs, Role{name: owner, login: true, superuser: true, verifier: ""}) }
            for r in rs {
                let o = roleOid(&r.name, &roles)
                let pw = if len(r.verifier) > 0 { tv(&"********") } else { Val.Null }
                if rel == "pg_roles" {
                    append(mut &rows, [tv(&r.name), bv(r.superuser), bv(true), bv(r.superuser), bv(r.superuser), bv(r.login), bv(false),
                                       iv(-1), pw, Val.Null, bv(r.superuser), Val.Null, iv(o)])
                } else if r.login {
                    append(mut &rows, [tv(&r.name), iv(o), bv(r.superuser), bv(r.superuser), bv(false), bv(r.superuser), pw, Val.Null, Val.Null])
                }
            }
        }
        "pg_tables" {
            for ct in snap.tabs {
                append(mut &rows, [tv(&ct.schema), tv(&ct.name), tv(&ownerName(&snap, &aclOf(&snap, &relObj(&ct.key)))), Val.Null, bv(len(ct.idxs) > 0), bv(false),
                                   bv(len(ct.t.fks) > 0 || len(ct.t.refBy) > 0), bv(false)])
            }
        }
        "pg_indexes" {
            for ct in snap.tabs {
                for ix in ct.idxs { append(mut &rows, [tv(&ct.schema), tv(&ct.name), tv(&ix.name), Val.Null, tv(&idxDef(&ct, &ix))]) }
            }
        }
        "pg_sequences" {
            for d in snap.seqs {
                append(mut &rows, [tv(&lexdb_sql.schemaOf(&d.key)), tv(&lexdb_sql.baseName(&d.key)), tv(&owner),
                                   Val.Reg(d.typ, lexdb_pgcat.formatType(d.typ, -1)), iv(d.start), iv(d.min), iv(d.max), iv(d.inc),
                                   bv(d.cycle), iv(d.cache), Val.Null])
            }
        }
        "information_schema.schemata" {
            for s in ["pg_catalog", "information_schema"] {
                append(mut &rows, [tv(&db), tv(&s), tv(&owner), Val.Null, Val.Null, Val.Null, Val.Null])
            }
            for s in snap.schemas { append(mut &rows, [tv(&db), tv(&s), tv(&owner), Val.Null, Val.Null, Val.Null, Val.Null]) }
        }
        "information_schema.tables" {
            for ct in snap.tabs {
                append(mut &rows, [tv(&db), tv(&ct.schema), tv(&ct.name), tv(&"BASE TABLE"), Val.Null, Val.Null, Val.Null, Val.Null, Val.Null,
                                   tv(&"YES"), tv(&"NO"), Val.Null])
            }
            for v in snap.views {
                append(mut &rows, [tv(&db), tv(&v.schema), tv(&v.name), tv(&"VIEW"), Val.Null, Val.Null, Val.Null, Val.Null, Val.Null,
                                   tv(&"NO"), tv(&"NO"), Val.Null])
            }
        }
        "pg_auth_members" {
            var mems: []str = []
            try st.scan(txn, CATALOG, MEM_PRE, MEM_PRE + "\xff", fn(en: &lexdb_store.Entry): bool {
                append(mut &mems, en.key[len(MEM_PRE)..len(en.key)].toStr())
                return true
            })
            for pr in mems {
                let z = strings.indexOf(&pr, "\x00", 0)
                append(mut &rows, [iv(catOid(&"m", &pr)), iv(roleOid(&pr[0..z], &roles)), iv(roleOid(&pr[z + 1..len(pr)], &roles)), iv(OID_OWNER),
                                   bv(false), bv(true), bv(true)])
            }
        }
        "information_schema.table_privileges" {
            // each grant, the owner's own included, as privilege names
            for which in 0..2 {
                for ct in (if which == 0 { &snap.tabs } else { &snap.views }) {
                    let a = aclOf(&snap, &relObj(&ct.key))
                    let o = ownerName(&snap, &a)
                    var gs: []Grant = [Grant{to: o, privs: "arwdDxt"}]
                    if a.set { for g in a.grants { if g.to != o { append(mut &gs, Grant{to: g.to, privs: g.privs}) } } }
                    for g in gs {
                        for k in 0..len(g.privs) {
                            let pn = privName(&g.privs[k..k + 1])
                            if len(pn) == 0 { continue }
                            append(mut &rows, [tv(&o), tv(&(if len(g.to) > 0 { g.to } else { "PUBLIC" })), tv(&db), tv(&ct.schema), tv(&ct.name), tv(&pn),
                                               tv(&(if g.to == o { "YES" } else { "NO" })), tv(&(if pn == "SELECT" { "YES" } else { "NO" }))])
                        }
                    }
                }
            }
        }
        "information_schema.views" {
            for v in snap.views {
                append(mut &rows, [tv(&db), tv(&v.schema), tv(&v.name), tv(&(v.t.view + ";")), tv(&"NONE"), tv(&"NO"), tv(&"NO"),
                                   tv(&"NO"), tv(&"NO"), tv(&"NO")])
            }
        }
        "pg_views" {
            for v in snap.views { append(mut &rows, [tv(&v.schema), tv(&v.name), tv(&ownerName(&snap, &aclOf(&snap, &relObj(&v.key)))), tv(&(v.t.view + ";"))]) }
        }
        "information_schema.columns" {
            for which in 0..2 {
            for ct in (if which == 0 { &snap.tabs } else { &snap.views }) {
                for i in 0..len(ct.t.cols) {
                    let c = &ct.t.cols[i]
                    var nn = c.notNull
                    for p in ct.t.pk { if p == i { nn = true } }
                    let o = c.typ.oid
                    let isInt = o == lexdb_sql.OID_INT2 || o == lexdb_sql.OID_INT4 || o == lexdb_sql.OID_INT8
                    let isFl = o == lexdb_sql.OID_FLOAT4 || o == lexdb_sql.OID_FLOAT8
                    let isNumT = o == lexdb_sql.OID_NUMERIC
                    let isChar = o == lexdb_sql.OID_VARCHAR || o == lexdb_sql.OID_TEXT
                    let prec = if o == lexdb_sql.OID_INT2 { iv(16) } else if o == lexdb_sql.OID_INT4 { iv(32) } else if o == lexdb_sql.OID_INT8 { iv(64) }
                               else if o == lexdb_sql.OID_FLOAT4 { iv(24) } else if o == lexdb_sql.OID_FLOAT8 { iv(53) }
                               else if isNumT && c.typ.prec > 0 { iv(c.typ.prec) } else { Val.Null }
                    let radix = if isInt || isFl { iv(2) } else if isNumT { iv(10) } else { Val.Null }
                    let scale = if isInt { iv(0) } else if isNumT && c.typ.prec > 0 { iv(c.typ.scale) } else { Val.Null }
                    let dtp = if o == lexdb_sql.OID_DATE { iv(0) } else if isTimeKind(c.typ.kind) { iv(if c.typ.prec > 0 { c.typ.scale } else { 6 }) } else { Val.Null }
                    let maxLen = if o == lexdb_sql.OID_VARCHAR && c.typ.len > 0 { iv(c.typ.len) } else { Val.Null }
                    let octLen = if o == lexdb_sql.OID_VARCHAR && c.typ.len > 0 { iv(c.typ.len * 4) } else if isChar { iv(1073741824) } else { Val.Null }
                    let udt = match lexdb_pgcat.typeOf(o) {
                        Some(t) { t.name }
                        None { "text" }
                    }
                    let ident = identOf(c)
                    let isId = len(ident) > 0
                    var sq = noSeq()
                    if isId { for d in snap.seqs { if d.key == c.seq { sq = seqCopy(&d) } } }
                    let dflt = match defaultText(&snap, c) {
                        Some(d) { tv(&d) }
                        None { Val.Null }
                    }
                    append(mut &rows, [tv(&db), tv(&ct.schema), tv(&ct.name), tv(&c.name), iv(i + 1), dflt, tv(&if nn { "NO" } else { "YES" }),
                                       tv(&infoType(&c.typ)), maxLen, octLen, prec, radix, scale, dtp, Val.Null, Val.Null,
                                       Val.Null, Val.Null, Val.Null, Val.Null, Val.Null, Val.Null, Val.Null, Val.Null, Val.Null,
                                       tv(&db), tv(&"pg_catalog"), tv(&udt), Val.Null, Val.Null, Val.Null, Val.Null, tv(&(i + 1).toStr()),
                                       tv(&"NO"), tv(&if isId { "YES" } else { "NO" }),
                                       if isId { tv(&if ident == "a" { "ALWAYS" } else { "BY DEFAULT" }) } else { Val.Null },
                                       if isId { tv(&sq.start.toStr()) } else { Val.Null }, if isId { tv(&sq.inc.toStr()) } else { Val.Null },
                                       if isId { tv(&sq.max.toStr()) } else { Val.Null }, if isId { tv(&sq.min.toStr()) } else { Val.Null },
                                       if isId { tv(&if sq.cycle { "YES" } else { "NO" }) } else { tv(&"NO") },
                                       tv(&"NEVER"), Val.Null, tv(&(if len(ct.t.view) > 0 { "NO" } else { "YES" }))])
                }
            }
            }
        }
        "information_schema.table_constraints" {
            for c in snap.cons {
                let ct = catTabOf(&snap, c.rel)
                let ty = if c.typ == "p" { "PRIMARY KEY" } else if c.typ == "u" { "UNIQUE" } else if c.typ == "f" { "FOREIGN KEY" } else { "CHECK" }
                append(mut &rows, [tv(&db), tv(&c.schema), tv(&c.name), tv(&db), tv(&c.schema), tv(&ct), tv(&ty), tv(&"NO"), tv(&"NO"),
                                   tv(&"YES"), if c.typ == "u" || c.typ == "p" { tv(&"YES") } else { Val.Null }])
            }
        }
        "information_schema.key_column_usage" {
            for c in snap.cons {
                if c.typ == "c" { continue }
                let ti = catTabIdx(&snap, c.rel)
                if ti < 0 { continue }
                for k in 0..len(c.cols) {
                    let cn = c.cols[k]
                    if cn < 1 || cn > len(snap.tabs[ti].t.cols) { continue }
                    var pos = Val.Null
                    if c.typ == "f" { pos = iv(k + 1) }
                    append(mut &rows, [tv(&db), tv(&c.schema), tv(&c.name), tv(&db), tv(&c.schema), tv(&snap.tabs[ti].name),
                                       tv(&snap.tabs[ti].t.cols[cn - 1].name), iv(k + 1), pos])
                }
            }
        }
        "information_schema.referential_constraints" {
            for c in snap.cons {
                if c.typ != "f" { continue }
                var uname = Val.Null
                var usch = Val.Null
                for u in snap.cons {
                    if (u.typ == "p" || u.typ == "u") && u.idx == c.idx && u.rel == c.refRel {
                        uname = tv(&u.name)
                        usch = tv(&u.schema)
                    }
                }
                append(mut &rows, [tv(&db), tv(&c.schema), tv(&c.name), tv(&db), usch, uname, tv(&"NONE"), tv(&fkActionText(&c.upd)),
                                   tv(&fkActionText(&c.del))])
            }
        }
        "information_schema.constraint_column_usage" {
            for c in snap.cons {
                let ti = catTabIdx(&snap, if c.typ == "f" { c.refRel } else { c.rel })
                if ti < 0 { continue }
                let cols = if c.typ == "f" { copyInts(&c.refCols) } else if c.typ == "c" { checkCols(&snap.tabs[ti].t, &c) } else { copyInts(&c.cols) }
                for cn in cols {
                    if cn < 1 || cn > len(snap.tabs[ti].t.cols) { continue }
                    append(mut &rows, [tv(&db), tv(&snap.tabs[ti].schema), tv(&snap.tabs[ti].name), tv(&snap.tabs[ti].t.cols[cn - 1].name),
                                       tv(&db), tv(&c.schema), tv(&c.name)])
                }
            }
        }
        "information_schema.check_constraints" {
            for c in snap.cons {
                if c.typ == "c" { append(mut &rows, [tv(&db), tv(&c.schema), tv(&c.name), tv(&c.check)]) }
            }
        }
        "information_schema.sequences" {
            // not an identity column's (PostgreSQL leaves those out)
            var idSeqs: []str = []
            for ct in snap.tabs { for c in ct.t.cols { if len(identOf(&c)) > 0 { append(mut &idSeqs, c.seq) } } }
            for d in snap.seqs {
                var skip = false
                for k in idSeqs { if k == d.key { skip = true } }
                if skip { continue }
                let p = if d.typ == lexdb_sql.OID_INT2 { 16 } else if d.typ == lexdb_sql.OID_INT4 { 32 } else { 64 }
                append(mut &rows, [tv(&db), tv(&lexdb_sql.schemaOf(&d.key)), tv(&lexdb_sql.baseName(&d.key)), tv(&lexdb_pgcat.formatType(d.typ, -1)),
                                   iv(p), iv(2), iv(0), tv(&d.start.toStr()), tv(&d.min.toStr()), tv(&d.max.toStr()), tv(&d.inc.toStr()),
                                   tv(&if d.cycle { "YES" } else { "NO" })])
            }
        }
        else {}         // the rest have no rows: no comments, triggers, policies, views, ...
    }
    return Ok(rows)
}

fn predVal(p: &Option[Expr]): Val {
    let none: Option[lexdb_sql.TypeName] = None
    match p {
        Some(x) { return tv(&pgExprText(&x, &none)) }
        None { return Val.Null }
    }
}

fn catTabIdx(snap: &CatSnap, oid: int): int {
    for i in 0..len(snap.tabs) { if snap.tabs[i].oid == oid { return i } }
    return -1
}

fn catTabOf(snap: &CatSnap, oid: int): str {
    let i = catTabIdx(snap, oid)
    return if i < 0 { "" } else { snap.tabs[i].name }
}

// The columns a CHECK names.
fn checkCols(t: &Table, c: &CatCon): []int {
    var out: []int = []
    for i in 0..len(t.cols) {
        if strings.contains(&c.check, &t.cols[i].name) { append(mut &out, i + 1) }
    }
    return out
}

// ---- roles (9.81)
//
// A role is a catalog row of its own, roleKey(name): whether it may log in,
// whether it is a superuser, and its password's SCRAM verifier ("" none).
// Roles matter to SCRAM authentication (lexdb_wire); a session that came in
// by trust is not checked against them.

pub type Role = record {
    pub name: str
    pub login: bool
    pub superuser: bool
    pub verifier: str
}

fn roleKey(n: &str): str { return "\x05" + n }

fn encRole(r: &Role): str { return (if r.login { "1" } else { "0" }) + "\t" + (if r.superuser { "1" } else { "0" }) + "\t" + r.verifier }

fn decRole(name: &str, v: &str): Role {
    let f = strings.split(v, "\t")
    return Role{name: name.toStr(), login: len(f) > 0 && f[0] == "1", superuser: len(f) > 1 && f[1] == "1",
                verifier: if len(f) > 2 { f[2].toStr() } else { "" }}
}

fn rolesIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]Role, DbErr] {
    var out: []Role = []
    try st.scan(txn, CATALOG, "\x05", "\x06", fn(en: &lexdb_store.Entry): bool {
        append(mut &out, decRole(&en.key[1..len(en.key)], &en.val))
        return true
    })
    return Ok(out)
}

// The roles as committed (the wire's authentication reads them).
pub fn roles(st: &lexdb_store.Store): Result[[]Role, DbErr] {
    var t = try st.beginSnapshot()
    let r = rolesIn(st, mut &t)
    st.abort(t)
    return r
}

// A role's options applied: LOGIN, SUPERUSER, PASSWORD and their NOs.
fn applyRoleOpts(r: mut &Role, opts: &[]str): Result[Unit, DbErr] {
    for o in opts {
        if o == "login" { r.login = true }
        else if o == "nologin" { r.login = false }
        else if o == "superuser" { r.superuser = true }
        else if o == "nosuperuser" { r.superuser = false }
        else if o == "password-null" { r.verifier = "" }
        else if strings.startsWith(&o, "password:") {
            let pw = o[9..len(o)]
            if lexdb_auth.parseVerifier(&pw).isSome() {
                r.verifier = pw.toStr()                 // a verifier given (pg_dump writes them): kept
            } else if len(pw) == 35 && strings.startsWith(&pw, "md5") {
                return Err(e("0A000", "lexdb: MD5 passwords are not supported; give the password, or a SCRAM-SHA-256 verifier"))
            } else if len(pw) == 0 {
                r.verifier = ""                         // as PostgreSQL: an empty password is none
            } else {
                r.verifier = try lexdb_auth.makeVerifier(&pw)
            }
        }
    }
    return Ok(Unit{})
}

// CREATE ROLE, ALTER ROLE, DROP ROLE. Who may: a superuser role, or a
// session that is no role (trust); a role may change its own password.
fn roleStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let me = currentRole(st, txn.sess)
    let all = try rolesIn(st, txn)
    var mine = false
    var su = true
    for r in all {
        if r.name == me {
            mine = true
            su = r.superuser
        }
    }
    let ownPassword = s.kind == lexdb_sql.S_ALTER_ROLE && s.table == me && mine && len(s.names) > 0 &&
                      (strings.startsWith(&s.names[0], "password") && len(s.names) == 1)
    if !su && !ownPassword { return Err(e("42501", "permission denied to " + (if s.kind == lexdb_sql.S_CREATE_ROLE { "create" } else if s.kind == lexdb_sql.S_DROP_ROLE { "drop" } else { "alter" }) + " role")) }
    try bumpCatalog(st, txn)
    if s.kind == lexdb_sql.S_DROP_ROLE {
        for c in s.cols {
            let had = (try st.get(txn, CATALOG, roleKey(&c.name))).isSome()
            if !had {
                if s.ifFlag { continue }
                return Err(e("42704", "role \"" + c.name + "\" does not exist"))
            }
            if c.name == me { return Err(e("55006", "current user cannot be dropped")) }
            // what it owns stays: refused; its grants and memberships go with it
            let owned = try renameInAcls(st, txn, &c.name, &"", true)
            if len(owned) > 0 {
                return Err(e("2BP01", "role \"" + c.name + "\" cannot be dropped because some objects depend on it (it owns " + owned + ")"))
            }
            let x = try renameInAcls(st, txn, &c.name, &"", false)
            txn.del(CATALOG, roleKey(&c.name))
        }
        return Ok(tagOnly("DROP ROLE"))
    }
    let k = roleKey(&s.table)
    let have = try st.get(txn, CATALOG, k)
    if s.kind == lexdb_sql.S_CREATE_ROLE {
        if have.isSome() { return Err(e("42710", "role \"" + s.table + "\" already exists")) }
        if strings.startsWith(&s.table, "pg_") { return Err(e("42939", "role name \"" + s.table + "\" is reserved")) }
        var r = Role{name: s.table, login: false, superuser: false, verifier: ""}
        try applyRoleOpts(mut &r, &s.names)
        try txn.put(CATALOG, k, encRole(&r))
        return Ok(tagOnly("CREATE ROLE"))
    }
    var r = match have {
        Some(v) { decRole(&s.table, &v) }
        None { return Err(e("42704", "role \"" + s.table + "\" does not exist")) }
    }
    if len(s.names) == 1 && strings.startsWith(&s.names[0], "rename:") {
        let to = s.names[0][7..len(s.names[0])]
        if s.table == me { return Err(e("0A000", "session user cannot be renamed")) }
        if (try st.get(txn, CATALOG, roleKey(&to))).isSome() { return Err(e("42710", "role \"" + to + "\" already exists")) }
        txn.del(CATALOG, k)
        r.name = to.toStr()
        try txn.put(CATALOG, roleKey(&to), encRole(&r))
        let x = try renameInAcls(st, txn, &s.table, &to, false)
        return Ok(tagOnly("ALTER ROLE"))
    }
    try applyRoleOpts(mut &r, &s.names)
    try txn.put(CATALOG, k, encRole(&r))
    return Ok(tagOnly("ALTER ROLE"))
}

// ---- views (9.82)
//
// A view is a catalog row under its name, as a table is (the two share
// names): VIEW_MARK, then its columns (name and type), its query's text, and
// the catalog keys of the relations that query reads. Where it is named in
// FROM, the text is parsed and planned as a subquery (buildQuery). Its text
// names relations by name, so a relation it reads is not renamed, dropped,
// or changed in a column under it (dependentViews).

const VIEW_MARK: str = "\xff\xff\xff\xffview"

fn encView(cols: &[]lexdb_sql.ColDef, text: &str, deps: &[]str): str {
    var b = newStrBuf()
    b.add(VIEW_MARK)
    var names: []str = []
    var oids: []str = []
    var mods: []str = []
    for c in cols {
        append(mut &names, c.name)
        append(mut &oids, c.typ.oid.toStr())
        append(mut &mods, typmodOf(&c.typ).toStr())
    }
    addStrs(mut &b, &names)
    addStrs(mut &b, &oids)
    addStrs(mut &b, &mods)
    addStrs(mut &b, &[text.toStr()])
    addStrs(mut &b, deps)
    return b.toStr()
}

// A column's type from its OID and typmod (varchar's length, numeric's
// precision and scale), as a view keeps it.
fn typeOfMod(oid: int, mod: int): lexdb_sql.TypeName {
    var t = oidType(oid)
    if mod >= 4 && t.oid == lexdb_sql.OID_VARCHAR { t.len = mod - 4 }
    if mod >= 4 && t.kind == lexdb_sql.K_NUM {
        t.prec = (mod - 4) >> 16
        t.scale = (mod - 4) & 0xFFFF
    }
    if mod >= 0 && isTimeKind(t.kind) && t.oid != lexdb_sql.OID_DATE {
        t.prec = 1
        t.scale = mod
    }
    return t
}

fn decView(name: str, s: &str): Table {
    var t = emptyTable(name)
    var at = len(VIEW_MARK)
    let names = strsAt(s, at)
    at += strsLen(&names)
    let oids = strsAt(s, at)
    at += strsLen(&oids)
    let mods = strsAt(s, at)
    at += strsLen(&mods)
    let text = strsAt(s, at)
    at += strsLen(&text)
    t.deps = strsAt(s, at)
    t.tree = -1
    t.view = if len(text) > 0 { text[0] } else { "select" }
    for i in 0..len(names) {
        let o = strings.parseIntOpt(oids[i]).unwrapOr(lexdb_sql.OID_TEXT)
        let m = if i < len(mods) { strings.parseIntOpt(mods[i]).unwrapOr(-1) } else { -1 }
        append(mut &t.cols, lexdb_sql.colDef(names[i], typeOfMod(o, m), false))
    }
    return t
}

// A view's query, parsed to be planned where the view is used.
fn viewQuery(t: &Table): Result[lexdb_sql.Stmt, DbErr] {
    var ss = try lexdb_sql.parse(&t.view)
    if len(ss) != 1 || ss[0].kind != lexdb_sql.S_SELECT { return Err(lexdb_base.corrupt("the query of view \"" + t.name + "\"")) }
    var q = pop(mut &ss)
    q.use = lexdb_sql.SUB_FROM
    return Ok(q)
}

// INSERT, UPDATE and DELETE on a view: refused (no updatable views yet).
fn notView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str, what: &str): Result[Unit, DbErr] {
    match try findTable(st, txn, name) {
        Some(t) {
            if len(t.view) > 0 {
                return Err(e("0A000", "cannot " + what + " view \"" + lexdb_sql.shown(name) + "\" (lexdb's views are read-only)"))
            }
        }
        None {}
    }
    return Ok(Unit{})
}

// The catalog keys of the relations a statement reads by name, its
// subqueries' and set operations' too (CTEs are among its subqueries).
fn readsOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, out: mut &[]str): Result[Unit, DbErr] {
    for f in s.from {
        if f.sub >= 0 || f.work >= 0 || len(f.table) == 0 { continue }
        let k = try catKey(st, txn, &f.table, false)
        if (try st.get(txn, CATALOG, k)).isSome() {
            var have = false
            for x in out { if x == k { have = true } }
            if !have { append(out, k) }
        }
    }
    for q in s.subs { try readsOf(st, txn, &q, out) }
    for q in s.inner { try readsOf(st, txn, &q, out) }
    return Ok(Unit{})
}

// Every view, by catalog key.
fn allViews(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]Table, DbErr] {
    var out: []Table = []
    var keys: []str = []
    var vals: []str = []
    try st.scan(txn, CATALOG, "\x06", "", fn(en: &lexdb_store.Entry): bool {
        if strings.startsWith(&en.val, VIEW_MARK) {
            append(mut &keys, en.key)
            append(mut &vals, en.val)
        }
        return true
    })
    for i in 0..len(keys) { append(mut &out, decView(keys[i], &vals[i])) }
    return Ok(out)
}

// The views that read relation k, directly or through other views.
fn dependentViews(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[[]str, DbErr] {
    let vs = try allViews(st, txn)
    var out: []str = []
    var todo: []str = [k.toStr()]
    while len(todo) > 0 {
        let cur = pop(mut &todo)
        for v in vs {
            var reads = false
            for d in v.deps { if d == cur { reads = true } }
            var seen = false
            for x in out { if x == v.name { seen = true } }
            if reads && !seen {
                append(mut &out, v.name)
                append(mut &todo, v.name)
            }
        }
    }
    return Ok(out)
}

// Before relation k is dropped: the views on it dropped (CASCADE), or 2BP01.
fn dropDependentViews(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str, cascade: bool, kind: &str): Result[Unit, DbErr] {
    let deps = try dependentViews(st, txn, k)
    if len(deps) == 0 { return Ok(Unit{}) }
    if !cascade {
        return Err(e("2BP01", "cannot drop " + kind + " " + lexdb_sql.shown(k) + " because other objects depend on it"))
    }
    for d in deps {
        txn.del(CATALOG, d)
        dropAcl(txn, &relObj(&d))
    }
    return Ok(Unit{})
}

fn createView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var key = s.table
    if lexdb_sql.isQual(&s.table) {
        let sn = lexdb_sql.schemaOf(&s.table)
        if !(try schemaExists(st, txn, &sn)) { return Err(e("3F000", "schema \"" + sn + "\" does not exist")) }
    } else {
        let sn = try createSchema(st, txn)
        if len(sn) == 0 { return Err(e("3F000", "no schema has been selected to create in")) }
        key = try catKey(st, txn, &s.table, false)
        if !(try relExists(st, txn, &key)) { key = lexdb_sql.qual(&sn, &s.table) }
    }
    let base = lexdb_sql.baseName(&key)
    var old: Option[Table] = None
    if try relExists(st, txn, &key) {
        let have = try st.get(txn, CATALOG, key)
        let isView = match have {
            Some(v) { strings.startsWith(&v, VIEW_MARK) }
            None { false }
        }
        if !isView { return Err(e(if s.ifFlag { "42809" } else { "42P07" }, if s.ifFlag { "\"" + base + "\" is not a view" } else { "relation \"" + base + "\" already exists" })) }
        if !s.ifFlag { return Err(e("42P07", "relation \"" + base + "\" already exists")) }
        old = Some(decView(key, &have.unwrap()))
        try needRelOwner(st, txn, &key, &"view")
    } else {
        try needCreate(st, txn, &key)
    }
    // the query planned: its columns, and the relations it reads
    var q = try viewQuery(&decView(key, &encView(&[], &s.index, &[])))
    q.use = lexdb_sql.SUB_SCALAR - lexdb_sql.SUB_SCALAR     // a statement of its own
    var sc = newScope(&[], &[])
    let sel = try planSelect(st, txn, &q, &[], mut &sc)
    if len(s.names) > len(sel.outs) { return Err(e("42601", "CREATE VIEW specifies more column names than columns")) }
    var cols: []lexdb_sql.ColDef = []
    for i in 0..len(sel.outs) {
        let n = if i < len(s.names) { s.names[i] } else { sel.outs[i].name }
        for c in cols { if c.name == n { return Err(e("42701", "column \"" + n + "\" specified more than once")) } }
        append(mut &cols, lexdb_sql.colDef(n, oidType(sel.outs[i].oid), false))
    }
    // a column's typmod, where the query's column is a table's
    var deps: []str = []
    try readsOf(st, txn, &q, mut &deps)
    for d in deps { if d == key { return Err(e("42P17", "infinite recursion detected in rules for relation \"" + base + "\"")) } }
    match old {
        Some(o) {
            // OR REPLACE: the old columns kept, in order, with their names and types; new ones after
            if len(cols) < len(o.cols) { return Err(e("42P16", "cannot drop columns from view")) }
            for i in 0..len(o.cols) {
                if cols[i].name != o.cols[i].name {
                    return Err(e("42P16", "cannot change name of view column \"" + o.cols[i].name + "\" to \"" + cols[i].name + "\""))
                }
                if cols[i].typ.oid != o.cols[i].typ.oid {
                    return Err(e("42P16", "cannot change data type of view column \"" + o.cols[i].name + "\" from " +
                                 lexdb_pgcat.formatType(o.cols[i].typ.oid, -1) + " to " + lexdb_pgcat.formatType(cols[i].typ.oid, -1)))
                }
                cols[i].typ = o.cols[i].typ
            }
        }
        None {}
    }
    try txn.put(CATALOG, key, encView(&cols, &s.index, &deps))
    if old.isNone() { try ownNew(st, txn, &relObj(&key)) }
    try bumpCatalog(st, txn)
    return Ok(tagOnly("CREATE VIEW"))
}

fn dropView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    for c in s.cols {
        match try findTable(st, txn, &c.name) {
            Some(t) {
                if len(t.view) == 0 { return Err(e("42809", "\"" + lexdb_sql.shown(&c.name) + "\" is not a view (use DROP TABLE)")) }
                try needRelOwner(st, txn, &t.name, &"view")
                try dropDependentViews(st, txn, &t.name, s.cascade, &"view")
                txn.del(CATALOG, t.name)
                dropAcl(txn, &relObj(&t.name))
            }
            None {
                if !s.ifFlag { return Err(e("42P01", "view \"" + lexdb_sql.shown(&c.name) + "\" does not exist")) }
            }
        }
    }
    try bumpCatalog(st, txn)
    return Ok(tagOnly("DROP VIEW"))
}

// ALTER VIEW name RENAME TO new: refused while another view reads it.
fn alterView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let found = try findTable(st, txn, &s.table)
    if found.isNone() {
        if s.ifFlag { return Ok(tagOnly("ALTER VIEW")) }
        return Err(e("42P01", "relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist"))
    }
    let t = found.unwrap()
    if len(t.view) == 0 { return Err(e("42809", "\"" + lexdb_sql.shown(&s.table) + "\" is not a view")) }
    try needRelOwner(st, txn, &t.name, &"view")
    let deps = try dependentViews(st, txn, &t.name)
    if len(deps) > 0 {
        return Err(e("2BP01", "cannot rename view " + lexdb_sql.shown(&t.name) + " because view " + lexdb_sql.shown(&deps[0]) +
                     " depends on it (lexdb keeps a view's text)"))
    }
    let to = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &s.index)
    if try relExists(st, txn, &to) { return Err(e("42P07", "relation \"" + s.index + "\" already exists")) }
    let v = (try st.get(txn, CATALOG, t.name)).unwrap()
    txn.del(CATALOG, t.name)
    try txn.put(CATALOG, to, v)
    try moveAcl(st, txn, &relObj(&t.name), &relObj(&to))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("ALTER VIEW"))
}

// ---- privileges (9.83)
//
// Owners and privileges as PostgreSQL's: an object's owner may do anything
// with it; others what was granted to them, to a role they are a member of
// (transitively), or to PUBLIC. A role that is a superuser, and a session
// whose user is no role (it came in by trust), are not checked. The facts
// are catalog rows of their own: ACL_PRE and an object ("r:" a relation's
// catalog key, "n:" a schema) holds its owner and grants; MEM_PRE, a role
// and a member, a membership. Privileges are letters, as in PostgreSQL's
// aclitem: r SELECT, a INSERT, w UPDATE, d DELETE, x REFERENCES, t TRIGGER,
// U USAGE, C CREATE.

const ACL_PRE: str = "\x02acl\x00"
const MEM_PRE: str = "\x02mem\x00"

fn relObj(k: &str): str { return "r:" + k }
fn nspObj(n: &str): str { return "n:" + n }

type Grant = record { to: str; privs: str }

type Acl = record {
    owner: str              // "" unknown: made before privileges, or by no role
    grants: []Grant         // "" PUBLIC
    set: bool               // grants were given: relacl is not NULL
}

fn encAcl(a: &Acl): str {
    var b = newStrBuf()
    b.add(a.owner)
    b.add(if a.set { "\n1" } else { "\n0" })
    for g in a.grants {
        b.addByte('\n')
        b.add(g.to)
        b.addByte('\t')
        b.add(g.privs)
    }
    return b.toStr()
}

// The privileges an object has without a GRANT: the schema public's USAGE
// for PUBLIC (PostgreSQL 15 on: not CREATE).
fn defaultGrants(obj: &str): []Grant {
    if obj == "n:public" { return [Grant{to: "", privs: "U"}] }
    return []
}

fn readAcl(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, obj: &str): Result[Acl, DbErr] {
    match try st.get(txn, CATALOG, ACL_PRE + obj) {
        Some(v) { return Ok(decAcl(obj, &v)) }
        None { return Ok(Acl{owner: "", grants: defaultGrants(obj), set: false}) }
    }
}

fn decAcl(obj: &str, v: &str): Acl {
    let ls = strings.split(v, "\n")
    var a = Acl{owner: ls[0].toStr(), grants: [], set: len(ls) > 1 && ls[1] == "1"}
    for i in 2..len(ls) {
        let tb = strings.indexOf(&ls[i], "\t", 0)
        if tb >= 0 { append(mut &a.grants, Grant{to: ls[i][0..tb].toStr(), privs: ls[i][tb + 1..len(ls[i])].toStr()}) }
    }
    if !a.set { a.grants = defaultGrants(obj) }
    return a
}

fn writeAcl(txn: mut &lexdb_store.Txn, obj: &str, a: &Acl): Result[Unit, DbErr] {
    try txn.put(CATALOG, ACL_PRE + obj, encAcl(a))
    return Ok(Unit{})
}

fn dropAcl(txn: mut &lexdb_store.Txn, obj: &str) { txn.del(CATALOG, ACL_PRE + obj) }

fn moveAcl(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, from: &str, to: &str): Result[Unit, DbErr] {
    match try st.get(txn, CATALOG, ACL_PRE + from) {
        Some(v) {
            txn.del(CATALOG, ACL_PRE + from)
            try txn.put(CATALOG, ACL_PRE + to, v)
        }
        None {}
    }
    return Ok(Unit{})
}

// A new object's owner: the session's current role.
fn ownNew(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, obj: &str): Result[Unit, DbErr] {
    return writeAcl(txn, obj, &Acl{owner: currentRole(st, txn.sess), grants: [], set: false})
}

fn roleKeyOf(sess: int): str { return "\x00role\x00" + sess.toStr() }
fn sessAuthKey(sess: int): str { return "\x00sessauth\x00" + sess.toStr() }

// The session's user as SET SESSION AUTHORIZATION made it, else its login's.
fn sessionUser(st: &lexdb_store.Store, sess: int): str {
    match st.memoGet(&sessAuthKey(sess)) {
        Some(u) { if len(u) > 0 { return u } }
        None {}
    }
    return st.memoGet(&userKey(sess)).unwrapOr("lexdb")
}

// The role privileges are checked as: SET ROLE's, else the session user.
fn currentRole(st: &lexdb_store.Store, sess: int): str {
    match st.memoGet(&roleKeyOf(sess)) {
        Some(r) { if len(r) > 0 { return r } }
        None {}
    }
    return sessionUser(st, sess)
}

// Who a role is, for checks: whether it is a superuser (or no role: a
// trusted session's user), and the roles it acts as: itself, the roles it is
// a member of, PUBLIC ("").
pub type Who = record { name: str; super: bool; roles: []str }

fn hasStr(xs: &[]str, x: &str): bool {
    for y in xs { if y == x { return true } }
    return false
}

fn whoIs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str): Result[Who, DbErr] {
    match try st.get(txn, CATALOG, roleKey(name)) {
        Some(v) {
            let r = decRole(name, &v)
            var w = Who{name: name.toStr(), super: r.superuser, roles: [name.toStr(), ""]}
            if w.super { return Ok(w) }
            // memberships: role, member pairs, followed from name up
            var pairs: []str = []
            try st.scan(txn, CATALOG, MEM_PRE, MEM_PRE + "\xff", fn(en: &lexdb_store.Entry): bool {
                append(mut &pairs, en.key[len(MEM_PRE)..len(en.key)].toStr())
                return true
            })
            var todo: []str = [name.toStr()]
            while len(todo) > 0 {
                let m = pop(mut &todo)
                for pr in pairs {
                    let z = strings.indexOf(&pr, "\x00", 0)
                    let role = pr[0..z].toStr()
                    if pr[z + 1..len(pr)] == m && !hasStr(&w.roles, &role) {
                        append(mut &w.roles, role)
                        append(mut &todo, role)
                    }
                }
            }
            return Ok(w)
        }
        None { return Ok(Who{name: name.toStr(), super: true, roles: [name.toStr(), ""]}) }
    }
}

fn whoNow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[Who, DbErr] { return whoIs(st, txn, &currentRole(st, txn.sess)) }

fn allows(w: &Who, a: &Acl, letter: &str): bool {
    if w.super { return true }
    if len(a.owner) > 0 && hasStr(&w.roles, &a.owner) { return true }
    for g in a.grants { if hasStr(&w.roles, &g.to) && strings.contains(&g.privs, letter) { return true } }
    return false
}

fn may(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, w: &Who, obj: &str, letter: &str): Result[bool, DbErr] {
    if w.super { return Ok(true) }
    return Ok(allows(w, &(try readAcl(st, txn, obj)), letter))
}

fn denied(kind: &str, name: &str): DbErr { return e("42501", "permission denied for " + kind + " " + lexdb_sql.baseName(name)) }

// A relation's privilege (and its schema's USAGE): 42501 without them.
fn needRel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, w: &Who, key: &str, letter: &str, kind: &str): Result[Unit, DbErr] {
    if w.super { return Ok(Unit{}) }
    let sc = lexdb_sql.schemaOf(key)
    if !(try may(st, txn, w, &nspObj(&sc), &"U")) { return Err(denied(&"schema", &sc)) }
    if !(try may(st, txn, w, &relObj(key), letter)) { return Err(denied(kind, key)) }
    return Ok(Unit{})
}

fn needOwner(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, w: &Who, obj: &str, kind: &str, name: &str): Result[Unit, DbErr] {
    if w.super { return Ok(Unit{}) }
    let a = try readAcl(st, txn, obj)
    if len(a.owner) > 0 && hasStr(&w.roles, &a.owner) { return Ok(Unit{}) }
    return Err(e("42501", "must be owner of " + kind + " " + lexdb_sql.baseName(name)))
}

// CREATE in a schema.
fn needCreate(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str): Result[Unit, DbErr] {
    let w = try whoNow(st, txn)
    let sc = lexdb_sql.schemaOf(key)
    if !(try may(st, txn, &w, &nspObj(&sc), &"C")) { return Err(denied(&"schema", &sc)) }
    return Ok(Unit{})
}

// The owner check for a relation's DDL (ALTER, DROP, CREATE INDEX on it).
fn needRelOwner(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str, kind: &str): Result[Unit, DbErr] {
    let w = try whoNow(st, txn)
    return needOwner(st, txn, &w, &relObj(key), kind, key)
}

// The letters a privilege name stands for on an object of a kind
// (table, sequence, schema); "" if it is not one of them.
fn privLetters(name: &str, kind: &str): str {
    if kind == "schema" {
        return match name { "usage" { "U" } "create" { "C" } "all" { "UC" } else { "" } }
    }
    if kind == "sequence" {
        return match name { "select" { "r" } "update" { "w" } "usage" { "U" } "all" { "rwU" } else { "" } }
    }
    return match name {
        "select" { "r" }
        "insert" { "a" }
        "update" { "w" }
        "delete" { "d" }
        "references" { "x" }
        "trigger" { "t" }
        "truncate" { "D" }
        "maintain" { "" }
        "all" { "arwdDxt" }
        else { "" }
    }
}

fn addLetters(have: &str, more: &str): str {
    var out = have.toStr()
    for i in 0..len(more) { if !strings.contains(&out, &more[i..i + 1]) { out = out + more[i..i + 1] } }
    // in PostgreSQL's order
    var sorted = ""
    for c in ["a", "r", "w", "d", "D", "x", "t", "U", "C"] { if strings.contains(&out, &c) { sorted = sorted + c } }
    return sorted
}

fn dropLetters(have: &str, gone: &str): str {
    var out = ""
    for i in 0..len(have) { if !strings.contains(gone, &have[i..i + 1]) { out = out + have[i..i + 1] } }
    return out
}

// A role spec's name: CURRENT_USER and SESSION_USER resolved.
fn roleName(st: &lexdb_store.Store, txn: &lexdb_store.Txn, r: &str): str {
    if r == "#current_user" { return currentRole(st, txn.sess) }
    if r == "#session_user" { return sessionUser(st, txn.sess) }
    return r.toStr()
}

fn roleExists(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, r: &str): Result[bool, DbErr] {
    return Ok((try st.get(txn, CATALOG, roleKey(r))).isSome())
}

// The objects a GRANT or REVOKE names: (object, kind word, name) for each.
type Target = record { obj: str; kind: str; name: str }

fn grantTargets(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[[]Target, DbErr] {
    var out: []Target = []
    for c in s.cols {
        if s.index == "schema" {
            if !(try schemaExists(st, txn, &c.name)) { return Err(e("3F000", "schema \"" + c.name + "\" does not exist")) }
            append(mut &out, Target{obj: nspObj(&c.name), kind: "schema", name: c.name})
        } else if s.index == "all tables" || s.index == "all sequences" {
            if !(try schemaExists(st, txn, &c.name)) { return Err(e("3F000", "schema \"" + c.name + "\" does not exist")) }
            if s.index == "all tables" {
                // its tables and views, as they are now
                let from = lexdb_sql.qual(&c.name, &"")
                var keys: []str = []
                try st.scan(txn, CATALOG, if c.name == "public" { "\x06" } else { from }, if c.name == "public" { "" } else { from + "\xff" },
                            fn(en: &lexdb_store.Entry): bool {
                    if lexdb_sql.schemaOf(&en.key) == c.name { append(mut &keys, en.key) }
                    return true
                })
                for k in keys { append(mut &out, Target{obj: relObj(&k), kind: "table", name: k}) }
            } else {
                for d in try allSeqs(st, txn, &(if c.name == "public" { "" } else { c.name })) {
                    if lexdb_sql.schemaOf(&d.key) == c.name { append(mut &out, Target{obj: relObj(&d.key), kind: "sequence", name: d.key}) }
                }
            }
        } else if s.index == "sequence" {
            match try findSeq(st, txn, &c.name) {
                Some(d) { append(mut &out, Target{obj: relObj(&d.key), kind: "sequence", name: d.key}) }
                None { return Err(e("42P01", "relation \"" + lexdb_sql.shown(&c.name) + "\" does not exist")) }
            }
        } else {
            // a table or a view; a sequence named as a table is one too, as in PostgreSQL
            match try findTable(st, txn, &c.name) {
                Some(t) { append(mut &out, Target{obj: relObj(&t.name), kind: if len(t.view) > 0 { "view" } else { "table" }, name: t.name}) }
                None {
                    match try findSeq(st, txn, &c.name) {
                        Some(d) { append(mut &out, Target{obj: relObj(&d.key), kind: "sequence", name: d.key}) }
                        None { return Err(e("42P01", "relation \"" + lexdb_sql.shown(&c.name) + "\" does not exist")) }
                    }
                }
            }
        }
    }
    return Ok(out)
}

fn grantStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let grant = s.kind == lexdb_sql.S_GRANT
    let tag = if grant { "GRANT" } else { "REVOKE" }
    if s.index == "database" { return Ok(tagOnly(tag)) }       // lexdb has no database privileges: CONNECT and the rest hold
    let w = try whoNow(st, txn)
    var grantees: []str = []
    for g in s.pk {
        let r = roleName(st, txn, &g)
        if len(r) > 0 && !(try roleExists(st, txn, &r)) { return Err(e("42704", "role \"" + r + "\" does not exist")) }
        append(mut &grantees, r)
    }
    if s.index == "role" {
        // memberships: a superuser's to give
        if !w.super { return Err(e("42501", "permission denied to grant role")) }
        for c in s.cols {
            if !(try roleExists(st, txn, &c.name)) { return Err(e("42704", "role \"" + c.name + "\" does not exist")) }
            for m in grantees {
                if len(m) == 0 { return Err(e("0LP01", "role \"public\" cannot be a member of a role")) }
                if m == c.name { return Err(e("0LP01", "role \"" + m + "\" is a member of role \"" + c.name + "\"")) }
                if grant {
                    // no cycles: c may not already be a member of m
                    let up = try whoIs(st, txn, &c.name)
                    if hasStr(&up.roles, &m) { return Err(e("0LP01", "role \"" + c.name + "\" is a member of role \"" + m + "\"")) }
                    try txn.put(CATALOG, MEM_PRE + c.name + "\x00" + m, "")
                } else {
                    txn.del(CATALOG, MEM_PRE + c.name + "\x00" + m)
                }
            }
        }
        try bumpCatalog(st, txn)
        return Ok(tagOnly(tag + " ROLE"))
    }
    let targets = try grantTargets(st, txn, s)
    for tg in targets {
        var letters = ""
        for pn in s.names {
            let l = privLetters(&pn, &(if tg.kind == "view" { "table" } else { tg.kind }))
            if len(l) == 0 && pn != "maintain" {
                return Err(e("0LP01", "invalid privilege type " + strings.toUpperAscii(pn) + " for " + tg.kind))
            }
            letters = addLetters(&letters, &l)
        }
        try needOwner(st, txn, &w, &tg.obj, &tg.kind, &tg.name)
        var a = try readAcl(st, txn, &tg.obj)
        if !a.set { a.set = true }
        for g in grantees {
            var found = -1
            for i in 0..len(a.grants) { if a.grants[i].to == g { found = i } }
            if grant {
                if found < 0 { append(mut &a.grants, Grant{to: g, privs: addLetters(&"", &letters)}) }
                else { a.grants[found].privs = addLetters(&a.grants[found].privs, &letters) }
            } else if found >= 0 {
                a.grants[found].privs = dropLetters(&a.grants[found].privs, &letters)
            }
        }
        var kept: []Grant = []
        for g in a.grants { if len(g.privs) > 0 { append(mut &kept, Grant{to: g.to, privs: g.privs}) } }
        a.grants = kept
        try writeAcl(txn, &tg.obj, &a)
    }
    try bumpCatalog(st, txn)
    return Ok(tagOnly(tag))
}

// ALTER TABLE | VIEW | SEQUENCE | SCHEMA name OWNER TO role: a superuser's,
// or the owner's when it is a member of the new owner (PostgreSQL's rule).
fn ownerStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let tag = "ALTER " + strings.toUpperAscii(s.index)
    let to = roleName(st, txn, &s.names[0])
    if len(to) == 0 || !(try roleExists(st, txn, &to)) { return Err(e("42704", "role \"" + (if len(to) == 0 { "public" } else { to }) + "\" does not exist")) }
    var obj = ""
    var name = s.table
    if s.index == "schema" {
        if !(try schemaExists(st, txn, &s.table)) { return Err(e("3F000", "schema \"" + s.table + "\" does not exist")) }
        obj = nspObj(&s.table)
    } else if s.index == "sequence" {
        match try findSeq(st, txn, &s.table) {
            Some(d) {
                obj = relObj(&d.key)
                name = d.key
            }
            None {}
        }
    } else {
        match try findTable(st, txn, &s.table) {
            Some(t) {
                if (s.index == "view") != (len(t.view) > 0) {
                    return Err(e("42809", "\"" + lexdb_sql.shown(&s.table) + "\" is not a " + s.index))
                }
                obj = relObj(&t.name)
                name = t.name
            }
            None {}
        }
    }
    if len(obj) == 0 {
        if s.ifFlag { return Ok(tagOnly(tag)) }
        return Err(e("42P01", "relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist"))
    }
    let w = try whoNow(st, txn)
    try needOwner(st, txn, &w, &obj, &s.index, &name)
    if !w.super && !hasStr(&w.roles, &to) { return Err(e("42501", "must be able to SET ROLE \"" + to + "\"")) }
    var a = try readAcl(st, txn, &obj)
    a.owner = to
    try writeAcl(txn, &obj, &a)
    try bumpCatalog(st, txn)
    return Ok(tagOnly(tag))
}

// INSERT, UPDATE, DELETE: the privilege (letter) on the target; and SELECT
// where the statement reads its rows: a WHERE, RETURNING, a SET reading a
// column, ON CONFLICT DO UPDATE (which needs UPDATE too).
fn dmlCheck(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, letter: &str): Result[Unit, DbErr] {
    let w = try whoNow(st, txn)
    if w.super { return Ok(Unit{}) }
    let key = try catKey(st, txn, &s.table, false)
    if !(try relExists(st, txn, &key)) { return Ok(Unit{}) }      // the statement says it does not exist
    try needRel(st, txn, &w, &key, letter, &"table")
    var reads = s.where.isSome() || len(s.items) > 0
    if letter == "w" { for set in s.sets { if colsIn(&set.expr) { reads = true } } }
    if letter == "a" && s.conflict == lexdb_sql.CONFLICT_UPDATE {
        try needRel(st, txn, &w, &key, &"w", &"table")
        reads = true
    }
    if reads { try needRel(st, txn, &w, &key, &"r", &"table") }
    return Ok(Unit{})
}

fn colsIn(x: &Expr): bool {
    match x {
        Expr.Col(_) { return true }
        Expr.Unary(_, a) { return colsIn(&a) }
        Expr.Bin(_, a, b) { return colsIn(&a) || colsIn(&b) }
        Expr.IsNull(a, _) { return colsIn(&a) }
        Expr.Cast(a, _) { return colsIn(&a) }
        Expr.Call(_, args, _) {
            for a in args { if colsIn(&a) { return true } }
            return false
        }
        else { return false }
    }
}

// SET ROLE name | NONE, RESET ROLE: privileges checked as the role, which
// the session's user must be a member of (or a superuser). SET SESSION
// AUTHORIZATION name | DEFAULT: the session's user, for a superuser's login
// only; it ends SET ROLE.
fn (s: mut &Session) setRole(stmt: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let name = if len(stmt.names) > 0 && !stmt.ifFlag { stmt.names[0] } else { "" }
    let tag = if stmt.ifFlag { "RESET" } else { "SET" }
    var t = try s.st.beginSnapshot()
    let st = s.st
    let r = setRoleIn(&st, mut &t, s.id, &stmt.table, &name)
    st.abort(t)
    try r
    return Ok(tagOnly(tag))
}

fn setRoleIn(st: &lexdb_store.Store, t: mut &lexdb_store.Txn, id: int, what: &str, name: &str): Result[Unit, DbErr] {
    if len(name) > 0 && !(try roleExists(st, t, name)) { return Err(e("22023", "role \"" + name + "\" does not exist")) }
    if what == "session_authorization" {
        let login = st.memoGet(&userKey(id)).unwrapOr("lexdb")
        if !(try whoIs(st, t, &login)).super && name != login {
            return Err(e("42501", "permission denied to set session authorization"))
        }
        st.memoPut(&sessAuthKey(id), name)
        st.memoPut(&roleKeyOf(id), &"")
        return Ok(Unit{})
    }
    if len(name) > 0 {
        let w = try whoIs(st, t, &sessionUser(st, id))
        if !w.super && !hasStr(&w.roles, name) { return Err(e("42501", "permission denied to set role \"" + name + "\"")) }
    }
    st.memoPut(&roleKeyOf(id), name)
    return Ok(Unit{})
}

// A role's name in the owners, grants and memberships: renamed to to, or
// ("" ) taken out of grants and memberships. With check, nothing changes:
// the first object it owns, "" if none.
fn renameInAcls(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, from: &str, to: &str, check: bool): Result[str, DbErr] {
    var keys: []str = []
    var vals: []str = []
    try st.scan(txn, CATALOG, ACL_PRE, ACL_PRE + "\xff", fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key)
        append(mut &vals, en.val)
        return true
    })
    for i in 0..len(keys) {
        let obj = keys[i][len(ACL_PRE)..len(keys[i])].toStr()
        var a = try readAcl(st, txn, &obj)
        if check {
            if a.owner == from { return Ok(if strings.startsWith(&obj, "n:") { "schema " + obj[2..len(obj)] } else { lexdb_sql.shown(&obj[2..len(obj)]) }) }
            continue
        }
        if a.owner == from { a.owner = to.toStr() }
        var kept: []Grant = []
        for g in a.grants {
            if g.to == from { if len(to) > 0 { append(mut &kept, Grant{to: to.toStr(), privs: g.privs}) } }
            else { append(mut &kept, Grant{to: g.to, privs: g.privs}) }
        }
        a.grants = kept
        try writeAcl(txn, &obj, &a)
    }
    if check { return Ok("") }
    var mems: []str = []
    try st.scan(txn, CATALOG, MEM_PRE, MEM_PRE + "\xff", fn(en: &lexdb_store.Entry): bool {
        append(mut &mems, en.key[len(MEM_PRE)..len(en.key)].toStr())
        return true
    })
    for pr in mems {
        let z = strings.indexOf(&pr, "\x00", 0)
        let role = pr[0..z].toStr()
        let member = pr[z + 1..len(pr)].toStr()
        if role != from && member != from { continue }
        txn.del(CATALOG, MEM_PRE + pr)
        if len(to) > 0 {
            try txn.put(CATALOG, MEM_PRE + (if role == from { to.toStr() } else { role }) + "\x00" + (if member == from { to.toStr() } else { member }), "")
        }
    }
    return Ok("")
}

// The catalog's view of owners and grants (9.83).

// A role's OID: the trusted session's user (no role) and the unknown owner 10.
fn roleOid(r: &str, roles: &[]Role): int {
    for x in roles { if x.name == r { return catOid(&"a", r) } }
    return OID_OWNER
}

fn aclOf(snap: &CatSnap, obj: &str): Acl {
    var a = match snap.acls.get(obj) {
        Some(v) { decAcl(obj, &v) }
        None { Acl{owner: "", grants: defaultGrants(obj), set: false} }
    }
    // the schema public's own grants are shown, as PostgreSQL shows them
    if obj == "n:public" { a.set = true }
    return a
}

fn copyGrants(gs: &[]Grant): []Grant {
    var out: []Grant = []
    for g in gs { append(mut &out, Grant{to: g.to, privs: g.privs}) }
    return out
}

fn ownerName(snap: &CatSnap, a: &Acl): str { return if len(a.owner) > 0 { a.owner } else { snap.user } }

// relacl, nspacl: PostgreSQL's aclitem[] text, NULL until a GRANT or REVOKE.
fn aclText(snap: &CatSnap, a: &Acl, all: &str): Val {
    if !a.set { return Val.Null }
    let o = ownerName(snap, a)
    var items: []str = [quoteIfNeeded(&o) + "=" + all + "/" + quoteIfNeeded(&o)]
    for g in a.grants {
        if g.to == o { continue }
        append(mut &items, (if len(g.to) > 0 { quoteIfNeeded(&g.to) } else { "" }) + "=" + g.privs + "/" + quoteIfNeeded(&o))
    }
    return Val.Text("{" + strings.join(&items, ",") + "}")
}

fn privName(l: &str): str {
    return match l {
        "r" { "SELECT" } "a" { "INSERT" } "w" { "UPDATE" } "d" { "DELETE" } "D" { "TRUNCATE" } "x" { "REFERENCES" }
        "t" { "TRIGGER" } "U" { "USAGE" } "C" { "CREATE" } else { "" }
    }
}

// has_table_privilege([role,] relation, 'SELECT, INSERT'), and the schema's
// and sequence's: true if the role holds any of the privileges named, by
// the bound catalog's roles and grants.
fn hasPrivFn(se: &SeqEnv, name: &str, vs: &[]Val): Result[Val, DbErr] {
    let n = len(vs)
    if n != 2 && n != 3 { return Err(e("42883", "function " + name + " with " + n.toStr() + " arguments does not exist")) }
    // the role: a name or an OID; the session's current role by default
    var role = catUser(se)
    if n == 3 {
        match vs[0] {
            Val.Text(t) { role = t }
            else {
                let o = oidArg(&vs[0]).unwrapOr(0).toStr()
                for l in catLines(se, &"R") { if l[0] == o { role = l[1] } }
            }
        }
    }
    var w = Who{name: role, super: true, roles: [role, ""]}
    var known = false
    for l in catLines(se, &"R") {
        if l[1] == role {
            known = true
            w.super = l[2] == "1"
            w.roles = []
            for r in strings.split(&l[3], "\x1e") { append(mut &w.roles, r.toStr()) }
        }
    }
    if !known && n == 3 && len(catLines(se, &"R")) > 0 && role != catUser(se) {
        let sess = catLines(se, &"U")
        if len(sess) == 0 || sess[0][0] != role { return Err(e("42704", "role \"" + role + "\" does not exist")) }
    }
    let target = &vs[n - 2]
    let kind = if name == "has_schema_privilege" { "schema" } else if name == "has_sequence_privilege" { "sequence" } else { "table" }
    var obj = ""
    if kind == "schema" {
        let sn = text(target)
        for l in catLines(se, &"n") { if l[1] == sn || l[0] == sn { obj = nspObj(&l[1]) } }
        if len(obj) == 0 { return Err(e("3F000", "schema \"" + sn + "\" does not exist")) }
    } else {
        var o = oidArg(target).unwrapOr(0)
        if o == 0 { o = relOidOf(se, &text(target)) }
        for l in catLines(se, &"r") { if l[0] == o.toStr() { obj = relObj(&lexdb_sql.qual(&l[2], &l[3])) } }
        if len(obj) == 0 { return Err(e("42P01", "relation \"" + text(target) + "\" does not exist")) }
    }
    var a = Acl{owner: "", grants: defaultGrants(&obj), set: false}
    for l in catLines(se, &"A") { if l[0] == obj { a = decAcl(&obj, &strings.replaceAll(strings.replaceAll(&l[1], "\x1e", "\n"), "\x1d", "\t")) } }
    for part in strings.split(&text(&vs[n - 1]), ",") {
        var p = strings.toLowerAscii(strings.trim(&part))
        let grantOpt = strings.endsWith(&p, " with grant option")
        if grantOpt { p = strings.trim(&p[0..len(p) - 18]) }
        let letters = privLetters(&p, &kind)
        if len(letters) == 0 { return Err(e("22023", "unrecognized privilege type: \"" + strings.trim(&part) + "\"")) }
        if grantOpt {
            // the owner's and a superuser's only: lexdb gives no grant options
            if w.super || (len(a.owner) > 0 && hasStr(&w.roles, &a.owner)) { return Ok(Val.Bool(true)) }
            continue
        }
        for k in 0..len(letters) { if allows(&w, &a, &letters[k..k + 1]) { return Ok(Val.Bool(true)) } }
    }
    return Ok(Val.Bool(false))
}
