type SqlT = lexdb_syscat.SqlT
type OraT = lexdb_oracat.OraT

type Val = lexdb_sql.Val
type Expr = lexdb_sql.Expr
type DbErr = lexdb_base.DbErr
type Ctx = lexdb_pipe.Ctx
type AggSpec = lexdb_agg.AggSpec
type Acc = lexdb_agg.Acc

type Index = lexdb_catalog.Index
type Table = lexdb_catalog.Table
type ForeignKey = lexdb_catalog.ForeignKey
type Check = lexdb_catalog.Check
type Seq = lexdb_catalog.Seq
type EnumType = lexdb_catalog.EnumType
type TabType = lexdb_catalog.TabType
type CatIdx = lexdb_catalog.CatIdx
type CatTab = lexdb_catalog.CatTab
type CatCon = lexdb_catalog.CatCon
type CatSnap = lexdb_catalog.CatSnap
type ProcSrc = lexdb_catalog.ProcSrc
type Role = lexdb_catalog.Role
type Grant = lexdb_catalog.Grant
type Acl = lexdb_catalog.Acl
type TabStat = lexdb_catalog.TabStat
type CatView = lexdb_catalog.CatView

fn e(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

// A foreign key: cols of its table hold a key of table ref, refCols (a
// primary key or a unique index's columns, in any order). Columns by name.

// A result column (lexdb_bind's).
type OutCol = lexdb_bind.OutCol

pub type Res = record {
    pub cols: []OutCol
    pub rows: [][]Val
    pub tag: str
    pub hasRows: bool       // a statement that returns rows (SELECT), even none
    pub copy: int           // COPY (9.45): COPY_IN, the client sends its rows now; COPY_OUT, rows are its lines
}

fn tagOnly(tag: &str): Res { return Res{cols: [], rows: [], tag: tag.clone(), hasRows: false, copy: COPY_NONE} }

// ---- char(n) (9.94)
//
// A char(n) value is kept and shown padded with blanks to n characters
// (bpchar, no n: as given). Its trailing blanks do not count: comparisons,
// length() and the text functions see it without them, as PostgreSQL's
// cast of bpchar to text gives it. Values carry no type, so the resolver
// (resolve) puts those casts in where an expression of the type is used:
// #bptrim(x), and #bppad(x, n) for a value compared with a char(n) column
// with =, which keeps its index usable.

// A table's stored expression (a CHECK, an index's predicate), kept as
// written, with the char casts resolve would put in (bpFix).
fn bpEval(t: &Table, x: &Expr, env: &Env): Result[Val, DbErr] {
    for c in t.cols {
        if c.typ.oid == lexdb_sql.OID_BPCHAR { return eval(&bpFix(x, &t.cols), env) }
    }
    return eval(x, env)
}

fn bpFix(x: &Expr, cols: &[]lexdb_sql.ColDef): Expr {
    match x {
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), bpFix(&a, cols)) }
        Expr.Bin(op, a, b) {
            let l = bpFix(&a, cols)
            let r = bpFix(&b, cols)
            if op == "||" {
                let lt = if lexdb_bind.isBp(&l, cols, &typing()) { lexdb_bind.trimmed(l) } else { l }
                let rt = if lexdb_bind.isBp(&r, cols, &typing()) { lexdb_bind.trimmed(r) } else { r }
                return Expr.Bin(op.clone(), lt, rt)
            }
            if lexdb_bind.isCmp(&op) { return lexdb_bind.bpCmp(&op, l, r, cols, &typing()) }
            return Expr.Bin(op.clone(), l, r)
        }
        Expr.IsNull(a, neg) { return Expr.IsNull(bpFix(&a, cols), neg) }
        Expr.Cast(a, t) {
            let cx = bpFix(&a, cols)
            if t.kind == lexdb_sql.K_TEXT && t.oid != lexdb_sql.OID_BPCHAR && lexdb_bind.isBp(&cx, cols, &typing()) { return Expr.Cast(lexdb_bind.trimmed(cx), t) }
            return Expr.Cast(cx, t)
        }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, bpFix(&a, cols)) }
            return lexdb_bind.bpCall(&n, out, star, cols, &typing())
        }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// A function in FROM: its columns, from its arguments' types.
fn srfCols(name: &str, ordin: bool, args: &[]OutCol): Result[[]OutCol, DbErr] {
    var out: []OutCol = []
    if name == "pg_available_extensions" {
        // lexdb has no extensions: no rows
        append(mut &out, OutCol{name: "name", oid: lexdb_sql.OID_NAME, spell: "", coll: "", scale: -1})
        append(mut &out, OutCol{name: "default_version", oid: lexdb_sql.OID_TEXT, spell: "", coll: "", scale: -1})
        append(mut &out, OutCol{name: "comment", oid: lexdb_sql.OID_TEXT, spell: "", coll: "", scale: -1})
        return Ok(out)
    }
    if name == "pg_partition_ancestors" {
        append(mut &out, OutCol{name: "relid", oid: lexdb_sql.OID_REGCLASS, spell: "", coll: "", scale: -1})
        if ordin { append(mut &out, OutCol{name: "ordinality", oid: lexdb_sql.OID_INT8, spell: "", coll: "", scale: -1}) }
        return Ok(out)
    }
    if strings.startsWith(&name, "#values:") {
        // VALUES (9.80): a column's type is the common type of its values
        // (lexdb_bind.commonOid; an untyped literal's type 705 here); of
        // different categories, its first typed value's
        let k = strings.parseIntOpt(&name[8..len(name)]).unwrapOr(1)
        let ty = typing()
        for c in 0..k {
            var os: []int = []
            var r = c
            while r < len(args) {
                append(mut &os, args[r].oid)
                r += k
            }
            var oid = lexdb_bind.commonOid(&ty, &os)
            r = c
            while oid == 0 && r < len(args) {
                if args[r].oid != lexdb_sql.OID_TEXT && args[r].oid != lexdb_sql.OID_UNKNOWN { oid = args[r].oid }
                r += k
            }
            if oid == 0 { oid = lexdb_sql.OID_TEXT }
            append(mut &out, OutCol{name: "column" + (c + 1).toStr(), oid: oid, spell: "", coll: "", scale: -1})
        }
        return Ok(out)
    }
    if strings.startsWith(&name, "#sys.") {
        // SQL Server's catalog views (design/lexdb-tds.md, section 13): its
        // type rides in scale (lexdb_syscat.colHint)
        for c in lexdb_syscat.cols(&name[5..len(name)]) {
            append(mut &out, OutCol{name: c.name.clone(), oid: lexdb_syscat.lexOid(&c.typ), spell: "", coll: if lexdb_syscat.lexOid(&c.typ) == lexdb_sql.OID_TEXT { c.coll.clone() } else { "" },
                                    scale: lexdb_syscat.colHint(&c)})
        }
        return Ok(out)
    }
    if strings.startsWith(name, "#ora.") {
        // Oracle's catalog views (design/lexdb-oracle.md, O4): names folded as its identifiers
        for c in lexdb_oracat.cols(&name[5..len(name)]) {
            append(mut &out, OutCol{name: strings.toLowerAscii(&c.name), oid: lexdb_oracat.lexOid(&c), spell: c.name.clone(), coll: "", scale: -1})
        }
        return Ok(out)
    }
    if strings.startsWith(name, &("#" + SEQ_REL)) {
        for c in seqRelation(&lexdb_catalog.noSeq()).cols { append(mut &out, OutCol{name: c.name.clone(), oid: c.typ.oid, spell: "", coll: "", scale: -1}) }
        return Ok(out)
    }
    if strings.startsWith(&name, "#") {
        // a catalog relation (9.80)
        for c in lexdb_pgcat.relCols(&name[1..len(name)]) { append(mut &out, OutCol{name: c.name.clone(), oid: c.oid, spell: "", coll: "", scale: -1}) }
        return Ok(out)
    }
    if name == "regexp_matches" || name == "regexp_split_to_table" || name == "string_to_table" {
        // (9.92) their values made by the call, as in a select list
        append(mut &out, OutCol{name: name.clone(), oid: if name == "regexp_matches" { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) } else { lexdb_sql.OID_TEXT }, spell: "", coll: "", scale: -1})
        if ordin { append(mut &out, OutCol{name: "ordinality", oid: lexdb_sql.OID_INT8, spell: "", coll: "", scale: -1}) }
        return Ok(out)
    }
    if name == "generate_series" {
        if len(args) < 2 || len(args) > 3 {
            return Err(e("42883", &("function generate_series with " + len(args).toStr() + " arguments does not exist")))
        }
        // of timestamps (9.95): a timestamp's, else a timestamptz's (a date's too)
        var tsOid = 0
        for a in args {
            if a.oid == lexdb_sql.OID_TSTZ || a.oid == lexdb_sql.OID_DATE { tsOid = lexdb_sql.OID_TSTZ }
            if a.oid == lexdb_sql.OID_TS && tsOid == 0 { tsOid = lexdb_sql.OID_TS }
        }
        if tsOid != 0 {
            if len(args) != 3 { return Err(e("42883", &("function generate_series(" + lexdb_sql.typeText(&lexdb_sql.oidType(tsOid)) + ", ...) needs an interval step"))) }
            append(mut &out, OutCol{name: "generate_series", oid: tsOid, spell: "", coll: "", scale: -1})
            return Ok(out)
        }
        var oid = lexdb_sql.OID_INT4
        for a in args {
            if a.oid == lexdb_sql.OID_NUMERIC { oid = lexdb_sql.OID_NUMERIC }
            else if oid != lexdb_sql.OID_NUMERIC && a.oid != lexdb_sql.OID_INT4 && a.oid != lexdb_sql.OID_INT2 { oid = lexdb_sql.OID_INT8 }
        }
        for a in args {
            let k = lexdb_sql.oidType(a.oid).kind
            if k != lexdb_sql.K_INT && k != lexdb_sql.K_NUM && a.oid != lexdb_sql.OID_TEXT {
                return Err(e("42883", "function generate_series needs numbers"))
            }
        }
        append(mut &out, OutCol{name: "generate_series", oid: oid, spell: "", coll: "", scale: -1})
    } else {
        if len(args) == 0 { return Err(e("42883", "function unnest() does not exist")) }
        for k in 0..len(args) {
            let el = lexdb_sql.elemOid(args[k].oid)
            if el == 0 {
                return Err(e("42804", &("function unnest: argument " + (k + 1).toStr() + " is not an array (cast it: $1::int[], '{1,2}'::text[])")))
            }
            append(mut &out, OutCol{name: "unnest", oid: el, spell: "", coll: "", scale: -1})
        }
    }
    if ordin { append(mut &out, OutCol{name: "ordinality", oid: lexdb_sql.OID_INT8, spell: "", coll: "", scale: -1}) }
    return Ok(out)
}

// A function in FROM, run: its arguments, then its rows.
fn execSrf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int,
           rs: mut &Run): Result[Res, DbErr] {
    let sqe = seqEnv(st, txn)
    let m = try prepare(st, txn, &sel.q, params, rs)
    let noRow: []Val = []
    let env = Env{cols: &sel.q.cols, row: &noRow, aggs: &noRow, params: params, subs: &m.subs, cur: &noRow, seq: &sqe}
    var args: []Val = []
    for x in sel.exprs { append(mut &args, try evalX(st, txn, &sel.q, &x, &env, rs)) }
    var rows: [][]Val = []
    let room = rs.bud.room()
    var bytes = 0
    if sel.srf == "pg_available_extensions" {
        // none
    } else if sel.srf == "pg_partition_ancestors" {
        // no partitions in lexdb: a relation is its only ancestor
        if len(args) == 1 && !lexdb_ops.isNull(&args[0]) {
            let o = lexdb_ops.oidArg(&args[0]).unwrapOr(0)
            var row: []Val = [Val.Reg(o, o.toStr())]
            if sel.ordin { append(mut &row, Val.Int(1)) }
            append(mut &rows, row)
        }
    } else if strings.startsWith(&sel.srf, "#values:") {
        let k = len(sel.outs)
        var i = 0
        // T-SQL: '' in a column of numbers is 0 (design/lexdb-tds.md, section 13)
        let tsql = len(sessColl(st, txn.sql.sess)) > 0
        while i + k <= len(args) {
            var row: []Val = []
            for c in 0..k {
                let ty = lexdb_sql.oidType(sel.outs[c].oid)
                let blank = tsql && (ty.kind == lexdb_sql.K_INT || ty.kind == lexdb_sql.K_FLOAT) && lexdb_ops.kindOf(&args[i + c]) == lexdb_sql.K_TEXT &&
                            len(strings.trim(&lexdb_sql.text(&args[i + c]))) == 0
                append(mut &row, if ty.kind == lexdb_sql.K_TEXT { replace(mut &args[i + c], Val.Null) } else if blank { try lexdb_ops.coerceZ(Val.Int(0), &ty, &txn.sql.zone) } else { try lexdb_ops.coerceZ(replace(mut &args[i + c], Val.Null), &ty, &txn.sql.zone) })
            }
            append(mut &rows, row)
            i += k
        }
    } else if strings.startsWith(&sel.srf, &("#" + SEQ_REL)) {
        let k = sel.srf[1 + len(SEQ_REL)..len(sel.srf)]
        match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&k))) {
            Some(v) { append(mut &rows, try seqState(st, &lexdb_catalog.decSeq(&v))) }
            None {}
        }
    } else if strings.startsWith(&sel.srf, "#") {
        rows = try catRows(st, txn, &sel.srf[1..len(sel.srf)])
    } else if sel.srf == "regexp_matches" || sel.srf == "regexp_split_to_table" || sel.srf == "string_to_table" {
        let v = try call(&sel.srf, &args)
        match srfParts(&v) {
            Some(ps) {
                for i in 0..len(ps) {
                    if cap >= 0 && len(rows) >= cap { break }
                    var row: []Val = [match ps[i] { Some(t) { Val.Text(t.clone()) } None { Val.Null } }]
                    if sel.ordin { append(mut &row, Val.Int(i + 1)) }
                    bytes += lexdb_pipe.rowBytes(&row)
                    if room >= 0 && bytes > room { return Err(lexdb_pipe.memErr(rs.bud.maxHeld)) }
                    append(mut &rows, row)
                }
            }
            None {}
        }
    } else if sel.srf == "generate_series" {
        for a in args { if lexdb_ops.isNull(&a) { return Ok(Res{cols: [], rows: [], tag: "", hasRows: true, copy: COPY_NONE}) } }
        let ty = lexdb_sql.oidType(sel.outs[0].oid)
        if ty.kind == lexdb_sql.K_TS || ty.kind == lexdb_sql.K_TSTZ {
            // timestamps stepped by an interval; a timestamptz's days and months in the session's zone (9.95)
            let zone = &txn.sql.zone
            var v = try lexdb_ops.coerceZ(replace(mut &args[0], Val.Null), &ty, zone)
            let stop = try lexdb_ops.coerceZ(replace(mut &args[1], Val.Null), &ty, zone)
            let step = try lexdb_ops.coerceZ(replace(mut &args[2], Val.Null), &lexdb_sql.oidType(lexdb_sql.OID_IVAL), zone)
            let dir = match step { Val.Ival(iv) { lexdb_time.ivalCmp(&iv, &lexdb_time.Ival{months: 0, days: 0, us: 0}) } else { 0 } }
            if dir == 0 { return Err(e("22023", "step size cannot equal zero")) }
            var n = 0
            while true {
                let c = try lexdb_ops.compare(&v, &stop)
                if (dir > 0 && c > 0) || (dir < 0 && c < 0) { break }
                if cap >= 0 && len(rows) >= cap { break }
                n += 1
                var row: []Val = [v.clone()]
                if sel.ordin { append(mut &row, Val.Int(n)) }
                bytes += lexdb_pipe.rowBytes(&row)
                if room >= 0 && bytes > room { return Err(lexdb_pipe.memErr(rs.bud.maxHeld)) }
                append(mut &rows, row)
                try rs.bud.tick()
                match lexdb_ops.arithZ(lexdb_ops.OP_ADD, &v, &step, &zone) {
                    Ok(x) { v = x }
                    Err(_) { break }
                }
            }
            return Ok(Res{cols: [], rows: rows, tag: "", hasRows: true, copy: COPY_NONE})
        }
        let start = try lexdb_ops.coerceZ(replace(mut &args[0], Val.Null), &ty, &txn.sql.zone)
        let stop = try lexdb_ops.coerceZ(replace(mut &args[1], Val.Null), &ty, &txn.sql.zone)
        let step = if len(args) > 2 { try lexdb_ops.coerceZ(replace(mut &args[2], Val.Null), &ty, &txn.sql.zone) } else { try lexdb_ops.coerce(Val.Int(1), &ty) }
        let zero = try lexdb_ops.coerce(Val.Int(0), &ty)
        let dir = try lexdb_ops.compare(&step, &zero)
        if dir == 0 { return Err(e("22023", "step size cannot equal zero")) }
        var v = start
        var n = 0
        while true {
            let c = try lexdb_ops.compare(&v, &stop)
            if (dir > 0 && c > 0) || (dir < 0 && c < 0) { break }
            if cap >= 0 && len(rows) >= cap { break }
            n += 1
            var row: []Val = [v.clone()]
            if sel.ordin { append(mut &row, Val.Int(n)) }
            bytes += lexdb_pipe.rowBytes(&row)
            if room >= 0 && bytes > room { return Err(lexdb_pipe.memErr(rs.bud.maxHeld)) }
            append(mut &rows, row)
            try rs.bud.tick()
            // the next value; past the type's range: the end
            match lexdb_ops.arithZ(lexdb_ops.OP_ADD, &v, &step, &txn.sql.zone) {
                Ok(x) { v = x }
                Err(_) { break }
            }
            if ty.kind == lexdb_sql.K_INT {
                match lexdb_ops.coerce(v.clone(), &ty) {
                    Ok(x) { v = x }
                    Err(_) { break }
                }
            }
        }
    } else {
        // unnest: the arrays side by side, the shorter padded with NULLs
        var cols: [][]Val = []
        var most = 0
        for k in 0..len(args) {
            var vals: []Val = []
            match args[k] {
                Val.Text(x) {
                    let et = lexdb_sql.oidType(sel.outs[k].oid)
                    for part in try lexdb_ops.arrayParts(&x) {
                        match part {
                            Some(p) { append(mut &vals, try lexdb_ops.coerce(Val.Text(p), &et)) }
                            None { append(mut &vals, Val.Null) }
                        }
                    }
                }
                else {}
            }
            if len(vals) > most { most = len(vals) }
            append(mut &cols, vals)
        }
        for i in 0..most {
            if cap >= 0 && len(rows) >= cap { break }
            var row: []Val = []
            for k in 0..len(cols) { append(mut &row, if i < len(cols[k]) { replace(mut &cols[k][i], Val.Null) } else { Val.Null }) }
            if sel.ordin { append(mut &row, Val.Int(i + 1)) }
            bytes += lexdb_pipe.rowBytes(&row)
            if room >= 0 && bytes > room { return Err(lexdb_pipe.memErr(rs.bud.maxHeld)) }
            append(mut &rows, row)
            try rs.bud.tick()
        }
    }
    return Ok(Res{cols: [], rows: rows, tag: "", hasRows: true, copy: COPY_NONE})
}

pub fn hasAgg(x: &Expr): bool {
    match x {
        Expr.Call(name, args, _) {
            if lexdb_bind.isAgg(&name) { return true }
            for a in args { if hasAgg(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return hasAgg(&a) }
        Expr.Bin(_, a, b) { return hasAgg(&a) || hasAgg(&b) }
        Expr.IsNull(a, _) { return hasAgg(&a) }
        Expr.Cast(a, _) { return hasAgg(&a) }
        else { return false }
    }
}

// What an expression is evaluated against: the columns, a row, the values
// of the query's aggregates for the row's group (an aggregate call is
// rewritten to its slot, "#agg"; none outside a grouped query) and the
// statement's parameters.
pub type Env = value record {
    cols: &[]lexdb_sql.ColDef
    row: &[]Val
    aggs: &[]Val
    params: &[]Val
    subs: &[]SubRes     // the results of the subqueries run once
    cur: &[]Val         // the correlated subqueries' values for this row
    seq: &Option[SeqEnv] // nextval and its kind: the store and session (none: not allowed here)
}

// The session's time zone an expression is evaluated in (9.95): UTC where
// there is no session (a CHECK, a DEFAULT, an index's expression).
fn envZone(env: &Env): &lexdb_time.Zone {
    match env.seq {
        Some(se) { return &se.zone }
        None { return lexdb_time.utc() }
    }
}

fn colIndex(cols: &[]lexdb_sql.ColDef, name: &str): int {
    for i in 0..len(cols) { if cols[i].name == name { return i } }
    return -1
}

pub fn eval(x: &Expr, env: &Env): Result[Val, DbErr] {
    match x {
        Expr.Lit(v) { return Ok(v.clone()) }
        Expr.Param(n) {
            if n > len(env.params) { return Err(e("08P01", &("there is no parameter $" + n.toStr()))) }
            return Ok(env.params[n - 1].clone())
        }
        Expr.Col(name, slot) {
            // the slot it was resolved at, when the row is that list's
            // (lexdb_bind.colSlot's rule); else found by name
            let i = if slot >= 0 && slot < len(env.cols) && env.cols[slot].name == name { slot } else { colIndex(&env.cols, &name) }
            if i < 0 { return Err(e("42703", &("column \"" + name + "\" does not exist"))) }
            if len(env.row) == 0 { return Ok(Val.Null) }
            return Ok(env.row[i].clone())
        }
        Expr.Unary(op, a) {
            let v = try eval(&a, env)
            return lexdb_ops.unaryVal(&op, v)
        }
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" {
                let l = lexdb_ops.truth(&(try eval(&a, env)))
                if op == "and" && l == Some(false) { return Ok(Val.Bool(false)) }
                if op == "or" && l == Some(true) { return Ok(Val.Bool(true)) }
                let r = lexdb_ops.truth(&(try eval(&b, env)))
                if op == "and" {
                    if r == Some(false) { return Ok(Val.Bool(false)) }
                    if l.isNone() || r.isNone() { return Ok(Val.Null) }
                    return Ok(Val.Bool(true))
                }
                if r == Some(true) { return Ok(Val.Bool(true)) }
                if l.isNone() || r.isNone() { return Ok(Val.Null) }
                return Ok(Val.Bool(false))
            }
            let l = try eval(&a, env)
            let r = try eval(&b, env)
            if op == "||" && (lexdb_pipe.looksArray(&l) || lexdb_pipe.looksArray(&r)) {
                // arrays, in an expression resolve has not seen (9.92)
                let noCols: []lexdb_sql.ColDef = []
                let noTypes: []int = []
                let f = arrayConcat(&a, &b, &noCols, &noTypes)
                if len(f) > 0 { return call(&f, &[l, r]) }
            }
            return binVal(&op, l, r, &env.seq)
        }
        Expr.IsNull(a, neg) {
            let v = try eval(&a, env)
            return Ok(Val.Bool(lexdb_ops.isNull(&v) != neg))
        }
        Expr.Cast(a, t) {
            let v = try eval(&a, env)
            return castVal(v, &t, &env.seq)
        }
        Expr.Call(name, args, star) {
            if lexdb_sql.isSubCall(&name) {
                let i = lexdb_sql.litInt(&args[0])
                if len(args) > lexdb_bind.subFixed(&name) {
                    if i < len(env.cur) { return Ok(env.cur[i].clone()) }
                    return Err(e("0A000", "a correlated subquery is not supported here"))
                }
                if len(args) < lexdb_bind.subFixed(&name) || i >= len(env.subs) { return Err(e("0A000", "a subquery is not supported here")) }
                let xv = if name == "#in" { try eval(&args[3], env) } else { Val.Null }
                return Ok(lexdb_pipe.subValue(&name, &env.subs[i].v, &xv, envZone(env)))
            }
            if name == "#agg" {
                match args[0] {
                    Expr.Lit(v) {
                        match v {
                            Val.Int(i) { return Ok(env.aggs[i].clone()) }
                            else {}
                        }
                    }
                    else {}
                }
            }
            if lexdb_bind.isAgg(&name) { return Err(e("42803", "aggregate functions are not allowed here")) }
            if name == "#ora_sub" && lexdb_bind.oraSubStamp(&args, env.cols, &[], &typing()) {
                // Oracle's timestamp minus timestamp: an INTERVAL DAY TO SECOND
                let ta = try eval(&args[0], env)
                let tb = try eval(&args[1], env)
                match try callDialectFn(&"#ora_tsdiff", &[ta, tb], envZone(env)) {
                    Some(v) { return Ok(v) }
                    None {}
                }
            }
            if name == "#win" || name == "#wmark" { return Err(e("42P20", "window functions are not allowed here")) }
            if name == "row" { return Err(e("0A000", "lexdb: a row value is supported only where rows are compared")) }
            if lexdb_bind.isWinFn(&name) { return Err(e("42809", &("window function " + name + " requires an OVER clause"))) }
            if name == "case" || name == "case else" {
                // only the branch taken is evaluated
                let pairs = if name == "case else" { (len(args) - 1) / 2 } else { len(args) / 2 }
                for k in 0..pairs { if lexdb_ops.truth(&(try eval(&args[2 * k], env))) == Some(true) { return eval(&args[2 * k + 1], env) } }
                if name == "case else" { return eval(&args[len(args) - 1], env) }
                return Ok(Val.Null)
            }
            if name == "#try" && len(args) == 1 {
                // T-SQL's TRY_CAST and TRY_CONVERT: NULL for a value that does not convert
                match eval(&args[0], env) {
                    Ok(v) { return Ok(v) }
                    Err(_) { return Ok(Val.Null) }
                }
            }
            var vs: []Val = []
            for a in args { append(mut &vs, try eval(&a, env)) }
            if name == "#tdiv" && len(vs) == 3 { return lexdb_lib.tdiv(&vs) }
            if name == "#tavg" && len(vs) == 2 { return lexdb_lib.tavg(&vs) }
            if isDialectFn(&name) {
                match try callDialectFn(&name, &vs, envZone(env)) {
                    Some(v) { return Ok(v) }
                    None {}
                }
            }
            if lexdb_bind.isSeqFn(&name) { return seqCall(&name, &vs, env) }
            if isSessFn(&name) { return sessCall(&name, &vs, env) }
            if lexdb_bind.isAdvFn(&name) { return advCall(&name, &vs, env) }
            if lexdb_sql.isCatFn(&name) || name == "current_schema" {
                match env.seq {
                    Some(se) {
                        match try callCat(&name, &vs, &se) {
                            Some(r) { return Ok(r) }
                            None {}
                        }
                    }
                    None { return Err(e("0A000", &("lexdb: " + name + " is not allowed here"))) }
                }
            }
            // now() and the rest: the transaction's start (9.76)
            match env.seq {
                Some(se) { return lexdb_pipe.callAt(&name, &vs, lexdb_time.fromUnixUs(se.now), &se.zone, catEntry) }
                None {}
            }
            return call(&name, &vs)
        }
    }
}

// The session's zone of an evaluation's seq (envZone).
fn seqZone(seq: &Option[SeqEnv]): lexdb_time.Zone {
    match seq {
        Some(se) { return se.zone.clone() }
        None { return lexdb_time.utc().clone() }
    }
}

// l op r, op not AND or OR, nor || of arrays (eval's Expr.Bin after its
// operands); seq: the evaluation's (its zone: 9.95). Shared with compiled
// expressions (cEval).
fn binVal(op: &str, l: Val, r: Val, seq: &Option[SeqEnv]): Result[Val, DbErr] {
    let code = lexdb_ops.opCode(op)
    if code < 0 {
        if lexdb_ops.isNull(&l) || lexdb_ops.isNull(&r) { return Ok(Val.Null) }
        return Err(e("42883", &("operator does not exist: " + lexdb_ops.kindName(&lexdb_sql.oidType(lexdb_ops.kindOid(&l))) + " " + op + " " +
                                lexdb_ops.kindName(&lexdb_sql.oidType(lexdb_ops.kindOid(&r))))))
    }
    return lexdb_ops.binOp(code, l, r, fn(): lexdb_time.Zone { return seqZone(seq) })
}

// v cast to t (eval's Expr.Cast after its operand); seq: the evaluation's.
fn castVal(v: Val, t: &lexdb_sql.TypeName, seq: &Option[SeqEnv]): Result[Val, DbErr] {
    if t.kind == lexdb_sql.K_REG { return regCast(&v, t.oid, seq) }
    return lexdb_ops.castTo(v, t, fn(): lexdb_time.Zone { return seqZone(seq) })
}

// ---- Bound expressions (design/lexdb.md 9.108; lexdb_bind.BX, design/lexdb-layers.md 4.4.1)
//
// lexdb_bind binds an expression once for a statement's run (bindExpr,
// with fnRefOf); lexdb_pipe.bxEval evaluates it, in a context (Ctx) whose
// hooks (Up) exec supplies. What eval alone evaluates (a subquery, an
// aggregate, a window call, a sequence, session, lock or catalog function,
// a reg cast) does not bind (fnRefOf's
// FN_NONE): eval runs it.

// The evaluator's hooks as exec supplies them.
fn execUp(): lexdb_pipe.Up { return lexdb_pipe.Up{entry: catEntry, dialect: callDialectFn} }

// The context a bound expression is evaluated in for seq's session: its
// transaction's start and time zone, exec's hooks; no parameters yet.
fn cenvOf(seq: &Option[SeqEnv]): Ctx {
    var now = 0
    var z = lexdb_time.utc().clone()
    match seq {
        Some(se) {
            now = lexdb_time.fromUnixUs(se.now)
            z = se.zone.clone()
        }
        None {}
    }
    return Ctx{now: now, zone: z, params: [], up: execUp(), subs: []}
}

// Whether name is a T-SQL or Oracle function that lexdb's own functions do
// not cover (lexdb_tsqlfn, lexdb_orafn).
fn isDialectFn(name: &str): bool { return lexdb_tsqlfn.isTsqlFn(name) || lexdb_orafn.isOraFn(name) }

// The call of a dialect function (isDialectFn).
fn callDialectFn(name: &str, vs: &[]Val, z: &lexdb_time.Zone): Result[Option[Val], DbErr] {
    if lexdb_orafn.isOraFn(name) { return lexdb_orafn.call(name, vs, z) }
    return lexdb_tsqlfn.call(name, vs, z)
}

// name's call of n arguments, bound (lexdb_bind's Typing.fnBind): FN_NONE
// for one eval alone evaluates; else its entries, found once here
// (lexdb_pipe.entryAt; lexdb_lib.entry1Of for one argument: FN_ONE), after its
// dialect's call for a T-SQL or Oracle name, as eval.
fn fnRefOf(name: &str, n: int): lexdb_bind.FnRef {
    if lexdb_bind.isAgg(name) || name == "#win" || name == "#wmark" || name == "row" || lexdb_bind.isWinFn(name) ||
       lexdb_bind.isSeqFn(name) || isSessFn(name) || lexdb_bind.isAdvFn(name) || lexdb_sql.isCatFn(name) || name == "current_schema" {
        return lexdb_bind.FnRef{name: name.toStr(), way: lexdb_bind.FN_NONE, f: lexdb_lib.restFn, f1: lexdb_lib.no1, dialect: false}
    }
    var way = lexdb_bind.FN_GEN
    var f1: lexdb_lib.Lib1 = lexdb_lib.no1
    if n == 1 {
        match lexdb_lib.entry1Of(name) {
            Some(f) {
                f1 = f
                way = lexdb_bind.FN_ONE
            }
            None {}
        }
    }
    return lexdb_bind.FnRef{name: name.toStr(), way: way, f: lexdb_pipe.entryAt(name, n, catEntry), f1: f1, dialect: isDialectFn(name)}
}

// name's call at the clock's time, in UTC.
fn call(name: &str, vs: &[]Val): Result[Val, DbErr] { return lexdb_pipe.callAt(name, vs, 0, lexdb_time.utc(), catEntry) }

// The two catalog functions that read PostgreSQL's dialect (lexdb_pgcat,
// lexdb_pg): the evaluator's entry hook (Up.entry).
fn catEntry(name: &str, n: int): Option[lexdb_lib.LibFn] {
    if name == "format_type" && n == 2 { return Some(formatTypeFn) }
    if name == "pg_size_pretty" && n == 1 { return Some(sizePrettyFn) }
    return None
}

fn formatTypeFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if lexdb_ops.isNull(&vs[0]) { return Ok(Val.Null) }
    let m = if lexdb_ops.isNull(&vs[1]) { -1 } else { lexdb_ops.oidArg(&vs[1]).unwrapOr(-1) }
    return Ok(Val.Text(lexdb_pgcat.formatType(lexdb_ops.oidArg(&vs[0]).unwrapOr(0), m)))
}

fn sizePrettyFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    match vs[0] {
        Val.Null { return Ok(Val.Null) }
        Val.Int(x) { return Ok(Val.Text(lexdb_pg.sizePretty(x))) }
        else {
            match lexdb_ops.coerce(vs[0].clone(), &lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}) {
                Ok(iv) {
                    match iv {
                        Val.Int(x) { return Ok(Val.Text(lexdb_pg.sizePretty(x))) }
                        else { return Ok(Val.Null) }
                    }
                }
                Err(x) { return Err(x) }
            }
        }
    }
}

// ---- keys and rows

// A column, bare or under a collation's key (#ci(col), #pad(col)): its
// name and the kind; name "" when x is neither.
type KeyedCol = value record { name: str; kind: int }

fn keyedCol(x: &Expr): KeyedCol {
    match x {
        Expr.Col(n, _) { return KeyedCol{name: n.clone(), kind: lexdb_sql.COLL_EXACT} }
        Expr.Call(f, args, _) {
            if (f == "#ci" || f == "#pad") && len(args) == 1 {
                match args[0] {
                    Expr.Col(n, _) { return KeyedCol{name: n.clone(), kind: if f == "#ci" { lexdb_sql.COLL_CI } else { lexdb_sql.COLL_PAD }} }
                    else {}
                }
            }
        }
        else {}
    }
    return KeyedCol{name: "", kind: lexdb_sql.COLL_EXACT}
}

// The places a stored row has: its table's columns, and dropped ones.
fn rowWidth(t: &Table): int { return if len(t.slots) == 0 { len(t.cols) } else { t.width } }

fn decRow(s: &str, n: int): Result[[]Val, DbErr] {
    let all: []bool = []
    let none: []Val = []
    let lays: []FixedLay = []
    return decRowNeed(s, n, &all, &none, &lays)
}

fn decRowNeed(s: &str, n: int, need: &[]bool, missing: &[]Val, lays: &[]FixedLay): Result[[]Val, DbErr] {
    return lexdb_rows.decodeRowNeed(s, n, need, missing, lays)
}

// ---- the catalog

// The name of table t's primary key constraint (and its index).

// Whether t has a primary key of its own (not the hidden one, 9.88).

// A column's name as written (L6).

// A name as stored (its spelling, L6) made a column: its name folded, its
// spelling kept if that differs.

// Makes the table's current layout (placeKinds) its last, as encTable
// will store it: for rows written before the catalog row is.

// A string addStr wrote at at (it takes 4 + its length).

// The strings addStrs wrote at at.

// The catalog's version: a row every DDL statement bumps, read through the
// transaction, so it names the schema the transaction sees (a snapshot may
// predate the latest DDL). Its key sorts before every name (index names
// start with 1, table names with a letter).
const CAT_VERSION: str = "\x02version"

fn catVersion(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[str, DbErr] {
    match try st.get(txn, lexdb_catalog.CATALOG, CAT_VERSION) {
        Some(v) { return Ok(v) }
        None { return Ok("0") }
    }
}

fn bumpCatalog(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[Unit, DbErr] {
    let v = try catVersion(st, txn)
    try txn.put(lexdb_catalog.CATALOG, CAT_VERSION, &(lexdb_catalog.nextVersion(&v)))
    return Ok(Unit{})
}

// ---- ANALYZE (optimizer 20): the statement; the statistics, their row,
// the estimates and the automatic statistics are lexdb_stats'.

// ANALYZE [table]: the statistics of the table, or of every table, counted
// from a full read (lexdb_stats.analyze); only the statistics' rows and
// version are written, so prepared statements are planned again with them.
fn analyzeStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, lim: Limits): Result[Res, DbErr] {
    // lexdb's checks of the maintenance statement first (9.94): the
    // tables and columns exist, VACUUM not in a block (optimizer 31)
    let checked = try maint(st, txn, s)
    var tabs: []Table = []
    if len(s.names) > 0 {
        for n in s.names {
            // (maint found each; a view has no rows of its own, nothing to count)
            match try findTable(st, txn, &n) {
                Some(t) { if len(t.view) == 0 { append(mut &tabs, t) } }
                None {}
            }
        }
    } else {
        var keys: []str = []
        var raw: []str = []
        // (not other sessions' temporary tables, as PostgreSQL: optimizer 40)
        try catScan(st, txn, &"\x06", &"", &"", fn(en: &lexdb_store.Entry): bool {
            append(mut &keys, en.key.clone())
            append(mut &raw, en.val.clone())
            return true
        })
        for i in 0..len(keys) {
            let t = try decTable(&keys[i], &raw[i])
            if len(t.view) == 0 { append(mut &tabs, t) }
        }
    }
    try lexdb_stats.analyze(st, txn, &tabs, lim.deadline, &statsUp())
    // a temporary table's statistics are its session's alone: its kept
    // plans are made again (tmpBump), no other session's (optimizer 40)
    var perm = false
    var temp = false
    for t in tabs { if lexdb_catalog.tempRel(&t.name) { temp = true } else { perm = true } }
    if temp { tmpBump(st, txn) }
    if perm || len(tabs) == 0 { try lexdb_stats.bumpVersion(st, txn) }
    return Ok(checked)
}

// What the statistics need of the executor: index values and predicates
// evaluated, catalog rows decoded with their expressions.
fn statsUp(): lexdb_stats.Up { return lexdb_stats.Up{idxVal: idxVal, inIndex: inIndex, decTable: decTable} }

// The automatic statistics' task (lexdb's master starts it) and one look
// (lexdb_stats.autoAnalyzer, autoAnalyzeStep), with the executor's hooks.
pub fn autoAnalyzer(st: lexdb_store.Store): int { return lexdb_stats.autoAnalyzer(st, &statsUp()) }
pub fn autoAnalyzeStep(st: &lexdb_store.Store): Result[int, DbErr] { return lexdb_stats.autoAnalyzeStep(st, &statsUp()) }


// ---- schemas (9.20): a table's catalog key is its name qualified by its
// schema (lexdb_sql.qual: schema QSEP name), public's unqualified. A schema
// is a catalog row of its own (schemaKey). An unqualified name is looked up
// along the transaction's search path (Txn.path, [] for public alone).

fn schemaKey(n: &str): str { return "\x03" + n }

fn schemaExists(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[bool, DbErr] {
    if n == "public" { return Ok(true) }
    // the session's temporary schema, once it has one (9.96); another's is none
    if len(n) > 0 && n[0] == 'p' && (n == "pg_temp" || lexdb_base.isTempSchema(n)) { return Ok(len(txn.tmp) > 0 && (n == "pg_temp" || n == txn.tmp)) }
    return Ok((try st.get(txn, lexdb_catalog.CATALOG, &(schemaKey(n)))).isSome())
}

// The schema new unqualified names go in: the first on the path that
// exists ("" none), never the temporary one (9.96).
fn createSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[str, DbErr] {
    if len(txn.sql.path) == 0 { return Ok("public") }
    for i in 0..len(txn.sql.path) {
        let sc = txn.sql.path[i].clone()
        if len(txn.tmp) > 0 && sc == txn.tmp { continue }
        if try schemaExists(st, txn, &sc) { return Ok(sc) }
    }
    return Ok("")
}

// ---- T-SQL's temporary tables (design/lexdb-tds.md S4): #name (and a
// table variable, #@name) is a session's own, a temporary table (9.96) of
// that name in its temporary schema.

fn isTempName(n: &str): bool { return len(n) > 1 && n[0] == '#' && n[1] != '#' }

fn tempSchema(sess: int): str { return tmpName(sess) }

fn tempKey(sess: int, n: &str): str { return lexdb_sql.qual(&tempSchema(sess), n) }

// The catalog key of a table (idx false) or an index named n: n if it is
// qualified or the path is public's; else the first schema on the path
// holding it, or none: the schema new names would go in (it is not there).
// pg_temp is the session's temporary schema; another session's is refused
// (9.96).
fn catKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str, idx: bool): Result[str, DbErr] {
    if isTempName(n) { return Ok(tempKey(txn.sql.sess, n)) }
    let q = lexdb_sql.isQual(n)
    if q && n[0] == 'p' { return tmpQual(st, txn, n) }
    if len(txn.sql.path) == 0 || q { return Ok(n.clone()) }
    for i in 0..len(txn.sql.path) {
        let sc = &txn.sql.path[i]
        let k = lexdb_sql.qual(sc, n)
        let found = if idx { try st.get(txn, lexdb_catalog.CATALOG, &(idxName(&k))) } else { try st.get(txn, lexdb_catalog.CATALOG, &k) }
        if found.isSome() { return Ok(k) }
    }
    let sc = try createSchema(st, txn)
    var first = txn.sql.path[0].clone()
    if len(txn.tmp) > 0 && first == txn.tmp && len(txn.sql.path) > 1 { first = txn.sql.path[1].clone() }
    return Ok(lexdb_sql.qual(if len(sc) > 0 { &sc } else { &first }, n))
}

// ---- temporary objects (9.96)
//
// A session's temporary tables, views, sequences and indexes live in its
// own schema, pg_temp_N (N the session's number, Session.id), made when
// it first makes one: the transaction carries it (Txn.tmp) and its search
// path starts with it (withTmp). Their catalog rows are under their own
// keys (lexdb_base.tempCatKey), which no other session reads: the scans
// of the whole catalog read other sessions' temporary ranges quietly and
// leave them out (catScan). Their DDL bumps only the session's own
// catalog version (tmpBump), in the memo. They go when the session ends
// (Session.close), at DISCARD TEMP and ALL, and those a crash left at
// the next start (bootstrap).

fn tmpName(sess: int): str { return "pg_temp_" + sess.toStr() }

// The session's temporary schema, in the memo once it has one; and the
// version of its temporary objects' catalog.
fn tmpMemo(sess: int): str { return "\x00tmp\x00" + sess.toStr() }
fn tmpVerKey(sess: int): str { return "\x00tmpver\x00" + sess.toStr() }

fn otherTemp(): DbErr { return e("0A000", "cannot access temporary tables of other sessions") }

// A qualified name starting with p: pg_temp's names the session's
// temporary schema; another session's is refused where it holds the name.
fn tmpQual(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[str, DbErr] {
    let sc = lexdb_sql.schemaOf(n)
    if sc == "public" { return Ok(lexdb_sql.baseName(n)) }         // public.name as written (lexdb_sql.rname)
    if sc == "pg_temp" {
        if len(txn.tmp) > 0 { return Ok(lexdb_sql.qual(&txn.tmp, &lexdb_sql.baseName(n))) }
        return Ok(n.clone())
    }
    if lexdb_base.isTempSchema(&sc) && sc != txn.tmp && (try relExists(st, txn, n)) { return Err(otherTemp()) }
    return Ok(n.clone())
}

// A search path with the temporary schema tmp first, unless it names
// pg_temp, which is then tmp; [] (public alone) becomes [tmp, public].
pub fn withTmp(path: &[]str, tmp: &str): []str {
    var out: []str = []
    var named = false
    for n in path { if n == "pg_temp" || n == tmp { named = true } }
    if !named { append(mut &out, tmp.toStr()) }
    for n in path { append(mut &out, if n == "pg_temp" { tmp.toStr() } else { n.clone() }) }
    if len(path) == 0 { append(mut &out, "public") }
    return out
}

// The transaction's session's temporary schema, made if it has none yet.
fn useTmp(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): str {
    if len(txn.tmp) > 0 { return txn.tmp.clone() }
    let n = tmpName(txn.sql.sess)
    txn.sql.path = withTmp(&txn.sql.path, &n)
    txn.tmp = n.clone()
    st.memo.put(&tmpMemo(txn.sql.sess), &n)
    return n
}

// A temporary object's catalog changed: the session's kept plans and
// descriptions are made again (and again if the transaction rolls back:
// Session.tmpUndo). Other sessions' are not touched.
fn tmpBump(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn) {
    txn.tmpDdl = true
    tmpChanged(st, txn.sql.sess)
}

fn tmpChanged(st: &lexdb_store.Store, sess: int) {
    let k = tmpVerKey(sess)
    st.memo.put(&k, &(lexdb_base.num(&st.memo.get(&k).unwrapOr("0")) + 1).toStr())
}

// The catalog's version bumped for DDL on relation key k: a temporary
// one's bumps its session's only.
fn bumpFor(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[Unit, DbErr] {
    if lexdb_catalog.tempRel(k) {
        tmpBump(st, txn)
        return Ok(Unit{})
    }
    return bumpCatalog(st, txn)
}

// The key CREATE of relation n makes (TEMPORARY when temp, or named in
// pg_temp): in its schema, or the first on the path; a temporary one's in
// the session's temporary schema, made if need be. Errors as PostgreSQL's.
fn createKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str, temp: bool): Result[str, DbErr] {
    var tmp = temp || isTempName(n)       // T-SQL's #name (S4)
    if lexdb_sql.isQual(n) {
        let sn = lexdb_sql.schemaOf(n)
        if sn == "pg_temp" || sn == tmpName(txn.sql.sess) {
            tmp = true
        } else {
            if !(try schemaExists(st, txn, &sn)) { return Err(e("3F000", &("schema \"" + sn + "\" does not exist"))) }
            if tmp { return Err(e("42P16", "cannot create temporary relation in non-temporary schema")) }
            if sn == "public" { return Ok(lexdb_sql.baseName(n)) }        // public.name as written (lexdb_sql.rname)
            return Ok(n.clone())
        }
    }
    if tmp { return Ok(lexdb_sql.qual(&useTmp(st, txn), &lexdb_sql.baseName(n))) }
    let sn = try createSchema(st, txn)
    if len(sn) == 0 { return Err(e("3F000", "no schema has been selected to create in")) }
    return Ok(lexdb_sql.qual(&sn, n))
}

// Scans the catalog [lo, hi) as st.scan does, leaving out other sessions'
// temporary objects: keys pre + "pg_temp_..." (pre "" a relation's, "\x01"
// an index's, "\x04" a sequence's, ACL_PRE + "r:" an owner's), whose range
// is read quietly, so their DDL never conflicts with this transaction.

fn findTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str): Result[Option[Table], DbErr] {
    match try findTableRc(st, txn, name) {
        Some(h) { return Ok(Some(copyTable(h))) }
        None { return Ok(None) }
    }
}

// A table of its own (h lent as &Table: the value copied, not the handle).
fn copyTable(t: &Table): Table { return t.clone() }

// findTable, the table shared with the cache of tables decoded
// (lexdb_catalog.decTableCached): unshare it to change it.
fn findTableRc(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str): Result[Option[rc Table], DbErr] {
    let k = try catKey(st, txn, name, false)
    match try st.get(txn, lexdb_catalog.CATALOG, &k) {
        Some(s) {
            let t = try lexdb_catalog.decTableCached(&k, &s, lexdb_parse.parseExpr)
            // its layouts, for the store's column leaves (9.112): committed
            // ones only, which rows may be converted to (9.114)
            if !txn.wrote(lexdb_catalog.CATALOG, &k) { setSpec(st, t) }
            return Ok(Some(t))
        }
        None { return Ok(None) }
    }
}

// Gives the store table t's layouts (lexdb_store.setColSpec), and the
// values its rows written before a column was added have for it (as a row
// in its current layout: lexdb_rows.Spec.fill).
fn setSpec(st: &lexdb_store.Store, t: &Table) {
    if t.tree <= 0 || len(t.layouts) == 0 || len(t.view) > 0 { return }
    lexdb_access.setSpec(st, &lexdb_catalog.relOf(t))
}

// Every table (not a view, nor another session's temporary table).

// VACUUM (9.114): the named tables' leaves, or every table's, made column
// leaves where their rows allow (lexdb_store.upgradeTree), a checkpoint
// after each VACUUM_STEP leaves converted.
const VACUUM_STEP = 2048

fn vacuumTables(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, names: &[]str): Result[Unit, DbErr] {
    if st.follower().isSome() { return Ok(Unit{}) }
    var tabs: []Table = []
    if len(names) > 0 {
        for n in names {
            match try findTable(st, txn, &n) {
                Some(t) { if len(t.view) == 0 { append(mut &tabs, t) } }
                None {}
            }
        }
    } else {
        tabs = try seenTables(st, txn)
        for t in tabs { setSpec(st, &t) }
    }
    for t in tabs {
        if t.tree <= 0 || len(t.layouts) == 0 { continue }
        var from = ""
        while true {
            let u = try lexdb_access.upgrade(st, &lexdb_catalog.relOf(&t), &from, VACUUM_STEP)
            if u.converted > 0 { try st.checkpointAll() }
            if u.done { break }
            from = u.next.clone()
        }
    }
    return Ok(Unit{})
}

fn needTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str): Result[Table, DbErr] {
    match try findTable(st, txn, name) {
        Some(t) {
            if len(t.view) > 0 { return Err(e("42809", &("\"" + lexdb_sql.shown(name) + "\" is a view"))) }
            return Ok(t)
        }
        None { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(name) + "\" does not exist"))) }
    }
}

// Makes the catalog when the store is new.
pub fn bootstrap(st: &lexdb_store.Store): Result[Unit, DbErr] {
    st.watch(lexdb_catalog.CATALOG)
    var have = false
    for id in st.trees() { if id == lexdb_catalog.CATALOG { have = true } }
    if !have {
        var t = lexdb_store.begin()
        let id = st.createTree(mut &t)
        if id != lexdb_catalog.CATALOG { return Err(lexdb_base.corrupt("the store has trees but no catalog")) }
        try st.commit(t)
    }
    // the sequences' values (9.43): a tree of their own, made once
    var r = lexdb_store.begin()
    let seqs = try st.get(mut &r, lexdb_catalog.CATALOG, SEQ_TREE)
    if seqs.isSome() {
        st.abort(r)
    } else {
        let tree = st.createTree(mut &r)
        try r.put(lexdb_catalog.CATALOG, SEQ_TREE, &(tree.toStr()))
        try st.commit(r)
    }
    // temporary objects left by a crash (9.96); a replica's go with the master's
    if !st.follower().isSome() { try dropLeftTemps(st) }
    return Ok(Unit{})
}

// ---- planning: access paths and joins

fn conjuncts(x: &Expr, out: mut &[]Expr) {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" {
                conjuncts(&a, out)
                conjuncts(&b, out)
                return
            }
        }
        else {}
    }
    append(out, lexdb_sql.cloneExpr(x))
}
// A copy of an expression (Expr is boxed and owned).

// A conjunct "col op value" (or "value op col", turned round).

// A table's way in: its primary key (index -1) or one of its indexes, with
// an equality for each of the first len(eqs) key columns, then perhaps
// bounds on the next one. No equality and no bound is a full scan.

// An IN subquery's values looked up one by one at most; past this many its
// path reads the whole table instead (no row counts to choose by yet).

// The encoded index part of a constant equality value: a literal, or one of
// the statement's parameters, coerced to the column's type. "" when it is
// neither (a value from another table, an outer value), NULL, or not of the type.
fn constKey(x: &Expr, typ: &lexdb_sql.TypeName, params: &[]Val): str {
    var v = Val.Null
    match x {
        Expr.Lit(l) { v = l.clone() }
        Expr.Param(n) {
            if n < 1 || n > len(params) { return "" }
            v = params[n - 1].clone()
        }
        else {
            // a literal expression (a cast: date '2021-06-01'), worked out
            match litValue(x) {
                Some(l) { v = l }
                None { return "" }
            }
        }
    }
    if lexdb_ops.isNull(&v) { return "" }
    match lexdb_ops.coerce(v, &boundType(typ)) {
        Ok(cv) {
            var b = ""
            lexdb_access.encIdxPart(mut &b, &cv)
            return b
        }
        Err(_) { return "" }
    }
}

// An estimate's scale: the looks compare scales, so values whose estimates
// are within about a factor of two share a plan.
fn scaleOf(n: int): int {
    var s = 0
    var x = n + 1
    while x > 1 {
        x = x / 2
        s += 1
    }
    return s
}

// An index's (or the primary key's, by the table's tree) entries; -1 none.

// What the statistics say a path reads (optimizer 24): rows, and whether that is an
// estimate or only a bound (at most rows). rows -1: no figure (no
// statistics, or an index ANALYZE has not seen).

// A path's figure: its equalities' rows by the statistics, the first by its
// value when it is constant; an IN list a lookup per value; a range, an IN
// subquery or an array only bounded by the rows of its equalities (no range
// estimates without samples). The primary key of one column has no
// statistics of its own: the table's rows bound it.
fn pathFig(lv: &Level, p: &Path, params: &[]Val): Fig {
    let none = Fig{rows: -1, bound: false}
    if lv.est.rows < 0 { return none }
    let c = p.index
    let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
    let cols = keyCols(&lv.t, c)
    let unique = c < 0 || lv.t.indexes[c].unique
    var pre = lv.est.entriesOf(tree)
    if pre < 0 {
        if c >= 0 || len(cols) > 1 { return none }
        pre = lv.est.rows
    }
    let ne = len(p.eqs)
    if ne > 0 {
        if ne == len(cols) && unique {
            pre = 1
        } else {
            let key = constKey(&p.eqs[0], &keyType(&lv.t, c, 0), params)
            pre = lv.est.rowsFor(tree, ne, &key)
            if pre < 0 { return none }
        }
    }
    if len(p.ins) > 0 {
        // a lookup per value: a literal's own rows when it is on the leading
        // column, else the average of the next prefix
        var n = 0
        let noParams: []Val = []
        for x in p.ins {
            var per = -1
            if ne + 1 == len(cols) && unique {
                per = 1
            } else {
                let key = if ne == 0 { constKey(&x, &keyType(&lv.t, c, 0), &noParams) } else { "" }
                per = lv.est.rowsFor(tree, ne + 1, &key)
            }
            if per < 0 { return Fig{rows: pre, bound: true} }
            n += per
        }
        if n < pre { return Fig{rows: n, bound: false} }
        return Fig{rows: pre, bound: true}
    }
    if ne == 0 && len(p.rng) > 0 && len(cols) > 0 && cols[0] >= 0 {
        // a range of the leading column: by its samples, when its bounds are
        // literals (optimizer 37); else only bounded
        let e = q0LeadEntry(lv, cols[0])
        if e >= 0 && len(lv.est.samp[e]) > 0 {
            var ops: []str = []
            var vals: []Expr = []
            for b in p.rng {
                if b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" {
                    append(mut &ops, b.op.clone())
                    append(mut &vals, lexdb_sql.cloneExpr(&b.val))
                }
            }
            if len(ops) == len(p.rng) {
                let sh = sampOnly(lv, e, cols[0], &ops, &vals)
                if sh >= 0.0f { return Fig{rows: int(fmax(sh * float(lv.est.entries[e]), 1.0f)), bound: false} }
            }
        }
    }
    if p.inSub >= 0 || len(p.inArr) > 0 || len(p.rng) > 0 { return Fig{rows: pre, bound: true} }
    return Fig{rows: pre, bound: false}
}

// leadEntry for a level outside a Query (pathFig's).
fn q0LeadEntry(lv: &Level, col: int): int {
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        if len(cols) == 0 || cols[0] != col { continue }
        let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
        for j in 0..len(lv.est.trees) { if lv.est.trees[j] == tree { return j } }
    }
    return -1
}

// A range's share by entry e's samples alone (literal bounds); -1 none.
fn sampOnly(lv: &Level, e: int, col: int, ops: &[]str, vals: &[]Expr): float {
    let typ = boundType(&lv.t.cols[col].typ)
    let noParams: []Val = []
    var hasLo = false
    var hasHi = false
    var loKey = ""
    var hiKey = ""
    var loIncl = false
    var hiIncl = false
    var loNum = 0.0f
    var hiNum = 0.0f
    var nums = true
    for i in 0..len(ops) {
        let key = constKey(&vals[i], &typ, &noParams)
        if len(key) == 0 { return -1.0f }
        let xn = litNumOf(lv, col, &vals[i])
        if xn.isNone() { nums = false }
        let x = xn.unwrapOr(0.0f)
        if ops[i] == ">" || ops[i] == ">=" {
            if !hasLo || key > loKey || (key == loKey && ops[i] == ">") {
                loKey = key
                loIncl = ops[i] == ">="
                loNum = x
            }
            hasLo = true
        } else {
            if !hasHi || key < hiKey || (key == hiKey && ops[i] == "<") {
                hiKey = key
                hiIncl = ops[i] == "<="
                hiNum = x
            }
            hasHi = true
        }
    }
    return lv.est.sampShare(e, hasLo, &loKey, loNum, loIncl, hasHi, &hiKey, hiNum, hiIncl, nums)
}

// A path's figure for EXPLAIN: none for a whole-key lookup (one row, by the
// rules) or a path with no condition.
fn pathEst(lv: &Level, p: &Path, params: &[]Val): Fig {
    let none = Fig{rows: -1, bound: false}
    let cols = keyCols(&lv.t, p.index)
    let unique = p.index < 0 || lv.t.indexes[p.index].unique
    if len(p.eqs) == len(cols) && unique { return none }
    if len(p.eqs) == 0 && len(p.rng) == 0 && len(p.ins) == 0 && p.inSub < 0 && len(p.inArr) == 0 { return none }
    return pathFig(lv, p, params)
}

// A figure's cost in reads (section 15's model): a primary key row is one
// read, an index entry two (the entry, then its row).
// (optimizer 36: in tenths of the measured units of COST_*: a descent 12,
// a row through an index 45, a primary key range's row 1.7 as the first
// table, 12 after it)
fn figCost(f: &Fig, index: int, first: bool): int {
    return 120 + f.rows * (if index >= 0 { 450 } else if first { 17 } else { 120 })
}

// One table of a query, in FROM order. Its rows join the rows of the tables
// before it: looked up per row through its path when the path's values come
// from them (a nested loop over a key or an index), else read once and
// matched by a hash of the equalities that link it to them (none: every
// row, a cross product).
pub type Level = record {
    t: rc Table             // shared with the cache of tables decoded (unshare to change)
    alias: str
    join: int
    first: int              // its first column in the joined row
    path: Path
    cond: []Expr            // the conjuncts a row of it must satisfy to join
    post: []Expr            // a LEFT JOIN's WHERE conjuncts, checked after its NULL row is made
    local: []Expr           // the match conjuncts on its own columns only (hash: read once)
    perRow: bool
    hashCols: []int         // hash: its columns ...
    hashVals: []Expr        // ... equal to these values from earlier tables
    hashKinds: []int        // ... per column, the collation its key is under (L2: #ci(col) = x)
    hashInt: bool           // a semi-join's one integer key: its own map, by value
    src: int                // a subquery in FROM (or a CTE): its number, its rows read from the run; -1 a table
    work: int               // a recursive CTE's working table: the CTE's number; -1
    lateral: bool           // a subquery in FROM using outer values (LATERAL): run per row
    need: []bool            // a table's columns the statement uses (the others are read as NULL); [] all (9.31)
    lock: int               // SELECT ... FOR UPDATE and the like: its rows locked (lexdb_sql.LOCK_*, 9.86); 0 none
    lockWait: int           // lexdb_sql.WAIT_*
    keeps: bool             // the path is chosen for ORDER BY or MIN/MAX: no switch to a scan (optimizer 19)
    est: Est                // its table's statistics from ANALYZE, for choosePath (optimizer 20)
    stops: bool             // the first table's reading may stop early (a LIMIT, EXISTS): no switch to a scan (optimizer 19)
    estRows: int            // its path's expected rows (EXPLAIN); -1 unknown (optimizer 23)
    estMax: bool            // estRows only bounds them: at most (optimizer 24)
    readOnce: bool          // the join order read it once (a hash join), not per row of the tables before (optimizer 26)
    semi: bool              // a semi-join (9.104): subquery src's rows, hashed; a row of the tables before goes on once if any matches
    anti: bool              // a NOT EXISTS/IN's: the row goes on once if none matches
    resNot: bool            // a semi/anti filter "inner <> outer": per key, mixed or one value (resCol)
    resCol: int             // the filter's inner column in t.cols
    resVal: Expr            // ... and its outer value
    semiSub: int            // a semi/anti join of a table looked up per row of the tables before it (semiLook): its subquery's number (EXPLAIN); -1
}

// A level of rows held by the run (a subquery's, a working table), not a table's.
fn (lv: &Level) virt(): bool { return lv.src >= 0 || lv.work >= 0 }

// A query's run: the counts, and per RIGHT or FULL JOIN table which of its
// rows have joined.
type Run = record {
    noLimit: bool               // the SELECT's LIMIT and OFFSET not applied (a locking one applies them as it locks, 9.86)
    cnt: []lexdb_pipe.Counts
    seen: [][]bool
    memo: []Map[str, int]       // per subquery (correlated): its outer values -> its result in memoRes
    memoRes: [][]SubRes
    stats: []SubStat            // per subquery (or part of a UNION): its runs (EXPLAIN ANALYZE)
    cache: CteCache
    maxRounds: int              // a recursive CTE's rounds at most (the session's max_recursion); 0 no limit
    maxSteps: int               // MATCH_RECOGNIZE: steps per start row at most (the session's max_match_steps); 0 no limit
    bud: lexdb_pipe.Budget      // the rows it holds, its deadline and turns
    batch: bool                 // vector scans and batch operators (SET lexdb_batch: 9.47); compiled expressions and typed sorts are always on
    writes: bool                // an INSERT, UPDATE or DELETE's run: no index-to-scan switch (optimizer 19)
    // The first level's switch (firstSwitch, 9.107), decided once for its
    // range swScan, for the batches and the row path: -1 not yet;
    // indexOrScan's answer, swKeys its keys
    sw: int
    swKeys: []str
    swScan: Scan
    after: str                  // a batched DELETE or UPDATE (stage 8): the first level's primary key scan starts at this key; "" none
    // the subqueries' results a pipeline run was given up for the row engine
    // after (a few held rows first in a join: keepSubs), kept for its runSubs
    pre: []SubRes
}

// A session's limits on one statement (SET max_recursion,
// max_statement_mem, statement_timeout).
pub type Limits = value record {
    pub rounds: int             // a recursive CTE's rounds; 0 no limit
    pub steps: int              // MATCH_RECOGNIZE's steps per start row; 0 no limit
    pub mem: int                // bytes of rows held; 0 no limit
    pub deadline: int           // time.monotonicNs() to stop at; 0 none
    pub batch: bool             // SET lexdb_batch: vector scans and batch operators (9.47); compiled expressions and typed sorts are always on
    pub rules: bool             // SET lexdb_planner = rules: kept with the others for a block's ROLLBACK (optimizer 20)
    pub auto: bool              // SET lexdb_autoanalyze: the session's changes counted for the automatic statistics (optimizer 44)
    pub rdel: bool              // SET lexdb_range_delete: a DELETE of a key range may drop its subtrees (design/lexdb-bulkdelete.md)
}

pub fn noLimits(): Limits { return Limits{rounds: 0, steps: 0, mem: 0, deadline: 0, batch: true, rules: false, auto: true, rdel: true} }

fn (rs: mut &Run) limit(l: &Limits) {
    rs.maxRounds = l.rounds
    rs.maxSteps = l.steps
    rs.bud.maxHeld = l.mem
    rs.bud.deadline = l.deadline
    rs.batch = l.batch
}

// A subquery's kept result: its rows, its set's and groups' keys.
fn resBytes(r: &SubRes): int {
    var n = 96 + lexdb_pipe.rowsBytes(&r.data)
    for i in 0..r.v.set.size() { n += 48 + len(r.v.set.keyAt(i)) }
    for i in 0..r.groups.size() { n += 48 + len(r.groups.keyAt(i)) }
    n += lexdb_pipe.rowBytes(&r.vals)
    return n
}

// max_recursion's default: rounds of a recursive CTE.
pub const MAX_RECURSION = 1000

// max_match_steps's default: MATCH_RECOGNIZE's steps per start row (design/lexdb-match-recognize.md 6).
pub const MAX_MATCH_STEPS = 10000000

// What a subquery did: runs, results taken from the cache, and its own
// counts and subqueries' over all its runs.
type SubStat = record { runs: int; hits: int; cnt: []lexdb_pipe.Counts; inner: []SubStat }

fn newRun(q: &Query): Run {
    var seen: [][]bool = []
    for k in 0..len(q.levels) { append(mut &seen, []) }
    var memo: []Map[str, int] = []
    var memoRes: [][]SubRes = []
    var stats: []SubStat = []
    for i in 0..len(q.subs) {
        append(mut &memo, newMap())
        append(mut &memoRes, [])
        append(mut &stats, SubStat{runs: 0, hits: 0, cnt: [], inner: []})
    }
    return Run{noLimit: false, cnt: array(len(q.levels), lexdb_pipe.noCounts()),
               seen: seen, memo: memo, memoRes: memoRes, stats: stats, cache: newCache(), maxRounds: MAX_RECURSION, maxSteps: MAX_MATCH_STEPS,
               bud: lexdb_pipe.newBudget(), batch: true, writes: false, sw: -1, swKeys: [], swScan: lexdb_access.noScan(), after: "", pre: []}
}

fn keepsRight(join: int): bool { return join == lexdb_sql.J_RIGHT || join == lexdb_sql.J_FULL }

fn keepsLeft(join: int): bool { return join == lexdb_sql.J_LEFT || join == lexdb_sql.J_FULL }

fn isOuter(join: int): bool { return keepsLeft(join) || keepsRight(join) }

pub type Query = record {
    levels: []Level
    cols: []lexdb_sql.ColDef    // the joined row's columns, named alias.column
    top: []Expr                 // no FROM: the WHERE
    subs: []SubPlan             // its subqueries, by number
    base: int                   // the statement's parameters; then refs' values
    corr: bool                  // a subquery of it is correlated
    refs: []Expr                // a subquery: the outer values it uses (in the outer query's terms)
    implied: bool               // its implied equalities were added (optimizer 27): a constant's equality is taken first
    colAt: Map[str, int]        // cols by name, once its tables are read (levelOf's; a name missing: colIndex)
    pinned: bool                // its join starts from a pinned row (optimizer 35): an outer value's equality is taken first
    noRefKeys: bool             // its outer values (refs) are not a path's or a hash's keys (Scope.noRefKeys, 9.104)
    // per level, its conditions and the WHERE conjuncts after it bound once
    // for the plan (bindSel; parameters as slots); [] bound per run (prepare)
    cc: [][]Option[lexdb_bind.BX]
    cp: [][]Option[lexdb_bind.BX]
    lp: lexdb_bind.LPlan        // FROM and WHERE as the binder gives them (buildQuery; planSelect moves it into Sel.lp)
    // its joins as the pipeline runs them for the row engine (slice P2c:
    // lexdb_pipe.compileLevels), where its Sel's own plan is not the
    // pipeline's; None: the row engine joins
    jp: Option[lexdb_pipe.Prog]
}

// Column c added to q's joined row, at the next slot. (Its binder's
// column, a BCol, is in q.lp's Get or Sub: buildQuery.)
fn addCol(q: mut &Query, c: lexdb_sql.ColDef) {
    append(mut &q.cols, c)
}

fn hasIdx(xs: &[]int, x: int): bool {
    for y in xs { if y == x { return true } }
    return false
}

fn (q: &Query) valBefore(x: &Expr, k: int): bool { return q.maxLevel(x) < k && !(q.corr && hasCorr(x)) && !(q.noRefKeys && usesRefs(x, q.base)) }

// A path's key value for level k: it uses only the tables before k. A
// correlated subquery in it is run per row of them before k is read
// (runLevel: pathCur), so it may be one too (9.23).
fn (q: &Query) keyBefore(x: &Expr, k: int): bool { return q.maxLevel(x) < k && !(q.noRefKeys && usesRefs(x, q.base)) }

// The level whose columns hold name's (-1 none). Levels hold their columns
// where FROM put them, whatever order they run in (join order, optimizer 25).
// Column name's slot in q's joined row (-1: none).
fn (q: &Query) slotOf(name: &str): int {
    let i = q.colAt.getOr(name, -1)
    return if i >= 0 { i } else { colIndex(&q.cols, name) }
}

fn (q: &Query) levelOf(name: &str): int {
    let i = q.slotOf(name)
    if i < 0 { return -1 }
    for j in 0..len(q.levels) {
        let f = q.levels[j].first
        if f <= i && i < f + len(q.levels[j].t.cols) { return j }
    }
    return -1
}

// The latest table an expression uses (-1: none) and the earliest (len: none).
fn (q: &Query) maxLevel(x: &Expr): int {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    var m = -1
    for n in ns {
        let l = q.levelOf(&n)
        if l > m { m = l }
    }
    return m
}

fn (q: &Query) minLevel(x: &Expr): int {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    var m = len(q.levels)
    for n in ns {
        let l = q.levelOf(&n)
        if l < m { m = l }
    }
    return m
}

// The conjuncts "col op value" whose value uses only tables before level k.
fn bounds(cs: &[]Expr, col: &str, k: int, q: &Query): []Bound {
    var out: []Bound = []
    for c in cs { likeBounds(&c, col, q, mut &out) }
    for c in cs {
        match c {
            Expr.Bin(op, a, b) {
                if op == "=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                    var done = false
                    match a {
                        Expr.Col(n, _) {
                            if n == col && q.keyBefore(&b, k) {
                                append(mut &out, Bound{op: op.clone(), val: lexdb_sql.cloneExpr(&b)})
                                done = true
                            }
                        }
                        else {}
                    }
                    if !done {
                        match b {
                            Expr.Col(n, _) {
                                if n == col && q.keyBefore(&a, k) {
                                    let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { "=" } }
                                    append(mut &out, Bound{op: flip, val: lexdb_sql.cloneExpr(&a)})
                                }
                            }
                            else {}
                        }
                    }
                }
            }
            else {}
        }
    }
    return out
}

// An index expression with its columns named as a query names them
// (alias.column).
fn qualified(x: &Expr, alias: &str): Expr {
    match x {
        Expr.Col(n, _) { return Expr.Col(alias + "." + n, -1) }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), qualified(&a, alias)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), qualified(&a, alias), qualified(&b, alias)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(qualified(&a, alias), neg) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, qualified(&a, alias)) }
            return Expr.Call(n.clone(), out, star)
        }
        Expr.Cast(a, t) { return Expr.Cast(qualified(&a, alias), t) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// Whether two expressions are the same.
fn sameExpr(a: &Expr, b: &Expr): bool { return lexdb_sql.exprText(a) == lexdb_sql.exprText(b) }

// bounds for an index expression (9.89): conjuncts comparing target with a
// value known before level k.
fn exprBounds(cs: &[]Expr, target: &Expr, k: int, q: &Query): []Bound {
    var out: []Bound = []
    for c in cs {
        match c {
            Expr.Bin(op, a, b) {
                if op == "=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                    if sameExpr(&a, target) && q.keyBefore(&b, k) {
                        append(mut &out, Bound{op: op.clone(), val: lexdb_sql.cloneExpr(&b)})
                    } else if sameExpr(&b, target) && q.keyBefore(&a, k) {
                        let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { "=" } }
                        append(mut &out, Bound{op: flip, val: lexdb_sql.cloneExpr(&a)})
                    }
                }
            }
            else {}
        }
    }
    return out
}

// ---- filtered indexes: when a query's conditions imply the predicate

// The value of an expression without columns, if it has one now (NULL: none).
fn constVal(x: &Expr, params: &[]Val): Option[Val] {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    if len(ns) > 0 || hasAgg(x) { return None }
    let noCols: []lexdb_sql.ColDef = []
    let noRow: []Val = []
    let noAggs: []Val = []
    let noSubs: []SubRes = []
    let noSeq: Option[SeqEnv] = None
    let env = Env{cols: &noCols, row: &noRow, aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs, seq: &noSeq}
    match eval(x, &env) {
        Ok(v) {
            if lexdb_ops.isNull(&v) { return None }
            return Some(v)
        }
        Err(_) { return None }
    }
}

// "column op value", from a comparison of a column with a constant.

fn asCmp(x: &Expr, params: &[]Val): Option[Cmp] {
    match x {
        Expr.Bin(op, a, b) {
            if !lexdb_bind.isCmp(&op) { return None }
            match a {
                Expr.Col(n, _) {
                    match constVal(&b, params) {
                        Some(v) { return Some(Cmp{col: n.clone(), op: op.clone(), val: v}) }
                        None {}
                    }
                }
                else {}
            }
            match b {
                Expr.Col(n, _) {
                    match constVal(&a, params) {
                        Some(v) {
                            let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { op.clone() } }
                            return Some(Cmp{col: n.clone(), op: flip, val: v})
                        }
                        None {}
                    }
                }
                else {}
            }
        }
        else {}
    }
    return None
}

fn holds(op: &str, d: int): bool {
    return match op {
        "=" { d == 0 }
        "<>" { d != 0 }
        "<" { d < 0 }
        "<=" { d <= 0 }
        ">" { d > 0 }
        else { d >= 0 }
    }
}

fn mentions(x: &Expr, col: &str): bool {
    match x {
        Expr.Col(n, _) { return n == col }
        else { return false }
    }
}

// Whether a query's conjunct c implies a predicate's conjunct p: the same
// text; a comparison of a column for "column IS NOT NULL"; or comparisons
// of a column with constants (x >= 3 implies x > 0).
//
// Planning that looks at a parameter's value (optimizer 22): whether a partial
// index's predicate is implied for it (yes or no), and a LIMIT or OFFSET (its
// value, which the plan keeps). Each look is noted in the planning's scope
// (Scope.looks) with what it gave; select() keeps the plan with them and takes
// it again only for parameters that give the same (looksHold). So a statement
// keeps a plan per outcome, at most PLAN_VARIANTS.
// kind 0: an implication (c implies p; out 1 yes); 1: a LIMIT or OFFSET (c;
// out its value); 2: an estimate (c a parameter equal to an index's leading
// column of type typ, its common values cm; out the estimate's scale, optimizer 23).

fn noType(): lexdb_sql.TypeName { return lexdb_sql.TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0} }

fn impliesOne(c: &Expr, p: &Expr, params: &[]Val, lk: mut &[]Look): bool {
    let r = impliesRaw(c, p, params)
    if len(params) > 0 { append(lk, Look{kind: 0, c: lexdb_sql.cloneExpr(c), p: lexdb_sql.cloneExpr(p), out: if r { 1 } else { 0 }, typ: noType(), cm: lexdb_stats.noCommon()}) }
    return r
}

// Whether the parameters give what the plan's looks gave.
fn looksHold(ls: &[]Look, params: &[]Val): bool {
    for l in ls {
        if l.kind == 0 {
            if impliesRaw(&l.c, &l.p, params) != (l.out == 1) { return false }
        } else if l.kind == 2 {
            if scaleOf(lexdb_stats.rowsOf(&l.cm, &constKey(&l.c, &l.typ, params))) != l.out { return false }
        } else {
            let x = Some(lexdb_sql.cloneExpr(&l.c))
            var none: []Look = []
            match evalInt(&x, params, "LIMIT", mut &none) {
                Ok(n) { if n != l.out { return false } }
                Err(_) { return false }
            }
        }
    }
    return true
}

fn impliesRaw(c: &Expr, p: &Expr, params: &[]Val): bool {
    if lexdb_sql.exprText(c) == lexdb_sql.exprText(p) { return true }
    match p {
        Expr.IsNull(a, neg) {
            if !neg { return false }
            match a {
                Expr.Col(n, _) {
                    match c {
                        Expr.Bin(op, l, r) { return lexdb_bind.isCmp(&op) && (mentions(&l, &n) || mentions(&r, &n)) }
                        else { return false }
                    }
                }
                else { return false }
            }
        }
        else {}
    }
    match asCmp(p, params) {
        Some(pc) {
            match asCmp(c, params) {
                Some(cc) {
                    if cc.col != pc.col { return false }
                    let d = match lexdb_ops.compare(&cc.val, &pc.val) { Ok(x) { x } Err(_) { return false } }
                    let po = pc.op.clone()
                    match cc.op {
                        "=" { return holds(&po, d) }
                        ">" { return (po == ">" || po == ">=" || po == "<>") && d >= 0 }
                        ">=" { return ((po == ">" || po == "<>") && d > 0) || (po == ">=" && d >= 0) }
                        "<" { return (po == "<" || po == "<=" || po == "<>") && d <= 0 }
                        "<=" { return ((po == "<" || po == "<>") && d < 0) || (po == "<=" && d <= 0) }
                        else { return po == "<>" && d == 0 }
                    }
                }
                None { return false }
            }
        }
        None { return false }
    }
}

// A predicate's column names, as alias.column.
fn qualify(x: &Expr, alias: &str): Expr {
    match x {
        Expr.Col(n, _) { return Expr.Col(alias + "." + n, -1) }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), qualify(&a, alias)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), qualify(&a, alias), qualify(&b, alias)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(qualify(&a, alias), neg) }
        Expr.Cast(a, t) { return Expr.Cast(qualify(&a, alias), t) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, qualify(&a, alias)) }
            return Expr.Call(n.clone(), out, star)
        }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// Whether index c of level k may be used under conditions cs: it is not
// filtered, or they imply each conjunct of its predicate.
fn (q: &Query) usable(k: int, c: int, cs: &[]Expr, params: &[]Val, lk: mut &[]Look): bool {
    if c < 0 { return true }
    let lv = &q.levels[k]
    match lv.t.indexes[c].pred {
        Some(pr) {
            var ps: []Expr = []
            conjuncts(&qualify(&pr, &lv.alias), mut &ps)
            for pc in ps {
                var ok = false
                for cc in cs { if impliesOne(&cc, &pc, params, lk) { ok = true } }
                if !ok { return false }
            }
            return true
        }
        None { return true }
    }
}

// The values of a conjunct "col IN (...)" whose values use only tables
// before level k (none: no such conjunct).
fn inList(cs: &[]Expr, col: &str, k: int, q: &Query): []Expr {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "in" && len(args) > 1 {
                    var ok = false
                    match args[0] { Expr.Col(x, _) { ok = x == col } else {} }
                    for i in 1..len(args) { if !q.keyBefore(&args[i], k) { ok = false } }
                    if ok {
                        var out: []Expr = []
                        for i in 1..len(args) { append(mut &out, lexdb_sql.cloneExpr(&args[i])) }
                        return out
                    }
                }
            }
            else {}
        }
    }
    return []
}

// col = ANY (array), the array from the tables before level k: [it], else [].
fn anyOf(cs: &[]Expr, col: &str, k: int, q: &Query): []Expr {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "any =" && len(args) == 2 && q.keyBefore(&args[1], k) {
                    match args[0] { Expr.Col(x, _) { if x == col { return [lexdb_sql.cloneExpr(&args[1])] } } else {} }
                }
            }
            else {}
        }
    }
    return []
}

// Whether one of cs is x IN (subquery), the subquery uncorrelated.
fn hasInSub(cs: &[]Expr): bool {
    for c in cs {
        match c {
            Expr.Call(n, args, _) { if n == "#in" && len(args) == lexdb_bind.subFixed(&n) { return true } }
            else {}
        }
    }
    return false
}

// col IN (subquery), the subquery uncorrelated (run once, before the
// tables are read): its number, else -1.
fn inSubOf(cs: &[]Expr, col: &str): int {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "#in" && len(args) == lexdb_bind.subFixed(&n) {
                    match args[3] { Expr.Col(x, _) { if x == col { return lexdb_sql.litInt(&args[0]) } } else {} }
                }
            }
            else {}
        }
    }
    return -1
}

// LIKE 'abc%' on a text column: the strings from 'abc' to 'abd'.
fn likeBounds(c: &Expr, col: &str, q: &Query, out: mut &[]Bound) {
    match c {
        Expr.Call(n, args, _) {
            if n != "like" || len(args) != 2 { return }
            match args[0] {
                Expr.Col(x, _) { if x != col { return } }
                else { return }
            }
            let ci = colIndex(&q.cols, col)
            if ci < 0 || q.cols[ci].typ.kind != lexdb_sql.K_TEXT { return }
            match args[1] {
                Expr.Lit(v) {
                    match v {
                        Val.Text(pat) {
                            // the characters before the first wildcard; \ escapes
                            var pre = ""
                            var i = 0
                            while i < len(pat) {
                                let b = pat[i]
                                if b == '%' || b == '_' { break }
                                if b == '\\' {
                                    if i + 1 >= len(pat) { return }
                                    i += 1
                                }
                                pre.addByte(pat[i])
                                i += 1
                            }
                            let p = pre
                            if len(p) == 0 { return }
                            append(out, Bound{op: ">=", val: Expr.Lit(Val.Text(p.clone()))})
                            let next = lexdb_access.succ(&p)
                            if next != "" { append(out, Bound{op: "<", val: Expr.Lit(Val.Text(next))}) }
                        }
                        else {}
                    }
                }
                else {}
            }
        }
        else {}
    }
}

fn keyCols(t: &Table, index: int): []int {
    var out: []int = []
    if index < 0 {
        for i in t.pk { append(mut &out, i) }
    } else {
        for i in t.indexes[index].cols { append(mut &out, i) }
    }
    return out
}

// ---- join order (optimizer 25): the constraint-bound order, no statistics. A
// SELECT's inner joins run from the first table (in FROM order) that a
// unique key's equalities pin to one row, their values constants or
// parameters; then, each time, the first table left that a unique key binds
// to the tables placed (a row per row at most), else the first that a key's
// or an index's leading column reaches from them (a lookup per row), else
// the first an equality links to them (a hash join), else the first left (a
// cross product). So most OLTP joins (one order, its lines, their products)
// read from the row they are about, whatever FROM's order, and the order
// never depends on the data. Outer joins and LATERAL keep FROM's order, and
// so does SET lexdb_planner = rules. The tables keep their columns' places
// in the joined row (Level.first): only the order they run in changes.

// ---- equal columns (optimizer 27): an inner join's equalities make
// classes of columns equal to each other, and perhaps to a constant (a
// literal or a parameter). Columns of one class are joined only when their
// types are of one kind, so that a comparison means the same whichever two
// are compared. The implied equalities (a = b and b = c: a = c; a = 5 and
// a = b: b = 5) are added to the conjuncts, so that a table is reached
// straight from any other of its class, or by the constant. They hold
// whenever the written ones do (a row where a = b and b = c are true has
// a = c true), so the results are the same.

fn (q: &Query) colKind(name: &str): int {
    let i = colIndex(&q.cols, name)
    return if i < 0 { -1 } else { q.cols[i].typ.kind }
}

// A constant for the classes: a literal (not NULL) or a parameter.
fn eqConst(x: &Expr): bool {
    match x {
        Expr.Lit(v) { return !lexdb_ops.isNull(&v) }
        else { return lexdb_bind.refParam(x) }
    }
}

fn (q: &Query) eqClasses(cs: &[]Expr): []EqClass {
    var names: []str = []
    var parent: []int = []
    var konstOf: []int = []             // per constant conjunct: the name's index
    var konsts: []Expr = []
    for c in cs {
        match c {
            Expr.Bin(op, l, r) {
                if op != "=" { continue }
                var a = ""
                var b = ""
                match l { Expr.Col(n, _) { a = n.clone() } else {} }
                match r { Expr.Col(n, _) { b = n.clone() } else {} }
                if len(a) > 0 && len(b) > 0 {
                    if q.levelOf(&a) < 0 || q.levelOf(&b) < 0 || q.colKind(&a) != q.colKind(&b) { continue }
                    let i = nameIdx(mut &names, mut &parent, &a)
                    let j = nameIdx(mut &names, mut &parent, &b)
                    let ri = ufRoot(&parent, i)
                    let rj = ufRoot(&parent, j)
                    if ri != rj { parent[rj] = ri }
                } else if len(a) > 0 && eqConst(&r) && q.levelOf(&a) >= 0 {
                    append(mut &konstOf, nameIdx(mut &names, mut &parent, &a))
                    append(mut &konsts, lexdb_sql.cloneExpr(&r))
                } else if len(b) > 0 && eqConst(&l) && q.levelOf(&b) >= 0 {
                    append(mut &konstOf, nameIdx(mut &names, mut &parent, &b))
                    append(mut &konsts, lexdb_sql.cloneExpr(&l))
                }
            }
            else {}
        }
    }
    var roots: []int = []
    var out: []EqClass = []
    for i in 0..len(names) {
        let r = ufRoot(&parent, i)
        var at = -1
        for j in 0..len(roots) { if roots[j] == r { at = j } }
        if at < 0 {
            append(mut &roots, r)
            append(mut &out, EqClass{names: [], levels: [], konst: []})
            at = len(out) - 1
        }
        append(mut &out[at].names, names[i].toStr())
        append(mut &out[at].levels, q.levelOf(&names[i]))
    }
    for i in 0..len(konstOf) {
        let r = ufRoot(&parent, konstOf[i])
        for j in 0..len(roots) { if roots[j] == r && len(out[j].konst) == 0 { append(mut &out[j].konst, lexdb_sql.cloneExpr(&konsts[i])) } }
    }
    return out
}

fn nameIdx(names: mut &[]str, parent: mut &[]int, n: &str): int {
    for i in 0..len(names) { if names[i] == n { return i } }
    append(names, n.toStr())
    append(parent, len(parent))
    return len(names) - 1
}

fn ufRoot(parent: &[]int, i: int): int {
    var x = i
    while parent[x] != x { x = parent[x] }
    return x
}

// One equality per class into each table (ms: the conjuncts per level, the
// implied ones added): of a class's equalities between a column of level k
// and a column of an earlier level, the first is kept and one whose earlier
// column is another level's is left out, since the two earlier columns
// were made equal at the later of their levels (implied adds every pair of
// levels a class joins). PostgreSQL makes one clause per equivalence class
// for each join (equivclass.c, generate_join_implied_equalities). TPC-H
// q5 hashed supplier on (s_suppkey, s_nationkey, s_nationkey): c_nationkey
// = s_nationkey and n_nationkey = s_nationkey; one key of each is enough,
// and a hash of one integer key has its own map. Two columns of the same
// earlier level both stay: nothing need have made them equal. Only an
// equality whose two columns are in the class, and of one integer type or
// both dates (plainEqCols), is left out or stands for another: the classes
// leave out equalities across types (int = numeric), which no other
// equality implies.
fn (q: &Query) oneEqPerClass(ms: mut &[][]Expr) {
    var all: []Expr = []
    for m in ms { for c in m { append(mut &all, lexdb_sql.cloneExpr(&c)) } }
    let cls = q.eqClasses(&all)
    for k in 1..len(ms) {
        var keep: []Expr = []
        var kc: []int = []          // per equality kept: its class, its earlier level
        var kl: []int = []
        let xs = replace(mut &ms[k], [])
        for c in xs {
            var drop = false
            match c {
                Expr.Bin(op, l, r) {
                    if op == "=" {
                        match l {
                            Expr.Col(a, _) {
                                match r {
                                    Expr.Col(b, _) {
                                        let la = q.levelOf(&a)
                                        let lb = q.levelOf(&b)
                                        if la >= 0 && lb >= 0 && (la == k) != (lb == k) && la <= k && lb <= k && q.plainEqCols(&a, &b) {
                                            let mine = if la == k { &a } else { &b }
                                            let lo = if la == k { lb } else { la }
                                            var ci = -1
                                            for x in 0..len(cls) {
                                                var hasA = false
                                                var hasB = false
                                                for n in cls[x].names {
                                                    if n == &a { hasA = true }
                                                    if n == &b { hasB = true }
                                                }
                                                if hasA && hasB { ci = x }
                                            }
                                            if ci >= 0 {
                                                for i in 0..len(kc) { if kc[i] == ci && kl[i] != lo { drop = true } }
                                                if !drop {
                                                    append(mut &kc, ci)
                                                    append(mut &kl, lo)
                                                }
                                            }
                                        }
                                    }
                                    else {}
                                }
                            }
                            else {}
                        }
                    }
                }
                else {}
            }
            if !drop { append(mut &keep, lexdb_sql.cloneExpr(&c)) }
        }
        ms[k] = keep
    }
}

// Whether a = b is an equality oneEqPerClass may stand for by another of
// its class: both columns of one integer type, or both dates. Their
// equality is the values' own, so it is transitive. Not across types (an
// int and a numeric, a date and a timestamp: the classes leave those out,
// and the equality is a conversion's), and not texts (a char(n)'s padding,
// a collation), floats (NaN, -0) or others, where a written equality is
// kept as written.
fn (q: &Query) plainEqCols(a: &str, b: &str): bool {
    let i = colIndex(&q.cols, a)
    let j = colIndex(&q.cols, b)
    if i < 0 || j < 0 { return false }
    let o = q.cols[i].typ.oid
    if o != q.cols[j].typ.oid { return false }
    return o == lexdb_sql.OID_INT2 || o == lexdb_sql.OID_INT4 || o == lexdb_sql.OID_INT8 || o == lexdb_sql.OID_DATE
}

// The equalities cs holds, as text, each way round (a set, so that the
// implied ones are checked against it at once: a star of 24 tables implies
// hundreds).
fn eqTexts(cs: &[]Expr): Map[str, int] {
    var m: Map[str, int] = newMap()
    for c in cs {
        match c {
            Expr.Bin(op, l, r) {
                if op == "=" {
                    let a = lexdb_sql.exprText(&l)
                    let b = lexdb_sql.exprText(&r)
                    m.put(a + "\x00" + b, 1)
                    m.put(b + "\x00" + a, 1)
                }
            }
            else {}
        }
    }
    return m
}

// The equalities the classes imply that cs does not hold: between columns
// of two tables, and of each column with its class's constant.
fn (q: &Query) implied(cs: &[]Expr): []Expr {
    var out: []Expr = []
    let have = eqTexts(cs)
    for cl in q.eqClasses(cs) {
        var texts: []str = []
        for n in cl.names { append(mut &texts, lexdb_sql.exprText(&Expr.Col(n.toStr(), -1))) }
        let kt = if len(cl.konst) > 0 { lexdb_sql.exprText(&cl.konst[0]) } else { "" }
        for i in 0..len(cl.names) {
            for j in i + 1..len(cl.names) {
                if cl.levels[i] == cl.levels[j] { continue }
                if !have.has(&(texts[i] + "\x00" + texts[j])) {
                    append(mut &out, Expr.Bin("=", Expr.Col(cl.names[i].toStr(), q.slotOf(&cl.names[i])), Expr.Col(cl.names[j].toStr(), q.slotOf(&cl.names[j]))))
                }
            }
            if len(cl.konst) > 0 && !have.has(&(texts[i] + "\x00" + kt)) {
                append(mut &out, Expr.Bin("=", Expr.Col(cl.names[i].toStr(), q.slotOf(&cl.names[i])), lexdb_sql.cloneExpr(&cl.konst[0])))
            }
        }
    }
    return out
}

// ---- join order, step 2 (optimizer 26): by cost, with ANALYZE's statistics.
// When every table of a SELECT's inner join has statistics and there are at
// most JOIN_SEARCH_MAX (24), the order is the cheapest left-deep order:
// found exactly by dynamic programming over the sets of tables placed to
// JOIN_EXACT_MAX tables, past that by SQLite's N-best search (optimizer 28,
// 30); and
// each table after the first is read either by a lookup per row of the
// tables before it or once (a hash join), whichever costs less. Costs are
// reads (optimizer 24): a lookup's descent one, a row by the primary key
// one, by an index two; a row put in a hash HASH_BUILD, a probe of it
// HASH_PROBE (so the smaller side is hashed); each row a join gives ROW_COST. A table's rows by its constant conditions come from its
// statistics (a literal by its value; a parameter as an unknown value, so
// that the order does not depend on parameters); an equality between two
// tables' columns keeps 1 / the larger distinct count of the two (a one-column
// primary key or unique index: the table's rows; an index's leading column:
// ANALYZE's count; else about 10 rows a value, SQLite's default). A set is
// extended only by a table a conjunct links to it, unless none is (no cross
// product while a join is left: a chain of n tables visits n(n+1)/2 sets, not
// 2^n). Without statistics for every table, the order bound by keys
// (optimizer 25) stands.

// Exact search to this many tables; past it SQLite's N-best search, keeping
// the JOIN_BEST cheapest partial orders at each step (optimizer 28).
// The costs, measured (optimizer 36, design/experiments/calib.lxl, in
// memory), in units of a row of a scan in batches (25 ns): a scan read row
// by row (a hashed table's) 12 (307 ns); a primary key range's row, first
// table, 1.7 (42 ns); a descent of a tree 12; a row fetched by its key (a
// lookup's, an index entry's) 45 (about 1,100 ns); a joined row 2. A hash's
// row built 8 and a probe 2 (optimizer 41, calib_batch.lxl: joins over
// batches, lexdb.md 9.102, probe a batch at a time: 13 to 21 ns an outer
// row on an integer key, 79 on a text key; a row read once and hashed 554
// ns, its read's 12 and 8). They were 22 and 22 when each probe went
// through the row path (about 450 ns). The first table's index range, in
// batches (lexdb.md 9.107: its entries' rows read in key order;
// calib_index.lxl, 467 ns an entry against a scan's row's 29), 16 an
// entry, where it was a row by key's 45.
// Measured again on settled tables (optimizer 45: column leaves read from
// their pages, as a server's; the three calib programs load, vacuum and
// checkpoint, then measure in a store opened again): a scan's row in
// batches 12 ns (the unit; it was 25 to 28 on rows just inserted); a row
// read row by row 527 to 568 ns, 44; a primary key range's row 22 ns, 1.8;
// an index range's entry and its row 584 ns, 49; a lookup by primary key
// 436 to 648 ns, 36 to 54 (12 + 36); a row read once and hashed 757 ns, so
// 19 for the hash over the read; a probe 18 ns (a text key's 71).

// A key column's values among the conjuncts: per value, the levels it uses
// (a bit each; 0 constants and parameters) and its key when it is a literal
// ("" else).

// A way into a level: its primary key (index -1) or an unfiltered index.

// Its expected rows and reads each time it is taken; outer: it uses values of
// the levels placed. rows -1: none.
// cost: as the first table (scanned in batches) or per lookup; inner: read
// once as a hashed table (row by row, optimizer 36).

fn fmax(a: float, b: float): float { return if a > b { a } else { b } }

fn (q: &Query) levelMask(x: &Expr): int {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    var m = 0
    for n in ns {
        let l = q.levelOf(&n)
        if l < 0 { return -1 }
        m = m | (1 << l)
    }
    return m
}

// The ways into level k, their key columns' values among cs.
fn (q: &Query) wayCands(k: int, cs: &[]Expr): []WayCand {
    let lv = &q.levels[k]
    var out: []WayCand = []
    let noParams: []Val = []
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        var bcs: []BindCol = []
        for pos in 0..len(cols) {
            var b = BindCol{deps: [], keys: []}
            if cols[pos] >= 0 {
                let name = lv.alias + "." + lv.t.cols[cols[pos]].name
                for x in cs {
                    match x {
                        Expr.Bin(op, l, r) {
                            if op == "=" {
                                for side in 0..2 {
                                    let me = if side == 0 { &l } else { &r }
                                    let other = if side == 0 { &r } else { &l }
                                    match me {
                                        Expr.Col(n, _) {
                                            if n == name && !hasCorr(other) {
                                                let m = q.levelMask(other)
                                                if m >= 0 && (m & (1 << k)) == 0 {
                                                    append(mut &b.deps, m)
                                                    append(mut &b.keys, if m == 0 { constKey(other, &keyType(&lv.t, c, pos), &noParams) } else { "" })
                                                }
                                            }
                                        }
                                        else {}
                                    }
                                }
                            }
                        }
                        else {}
                    }
                }
            }
            append(mut &bcs, b)
        }
        append(mut &out, WayCand{index: c, tree: if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree },
                                 unique: c < 0 || lv.t.indexes[c].unique, cols: bcs, colIds: collections.copyOf(&cols)})
    }
    return out
}

// Whether path choice has a way into level k by its constants (an equality,
// a range or an IN list on a leading column) that does not give the order
// of cols (its columns): it would not read the table in that order.
fn (q: &Query) constWay(k: int, cands: &[]WayCand, cs: &[]Expr, cols: &[]int): bool {
    let lv = &q.levels[k]
    for wc in cands {
        if len(wc.colIds) == 0 || wc.colIds[0] < 0 { continue }
        let name = lv.alias + "." + lv.t.cols[wc.colIds[0]].name
        if len(inList(cs, &name, k, q)) > 0 { return true }
        var any = false
        for b in bounds(cs, &name, k, q) { if q.maxLevel(&b.val) < 0 && !hasCorr(&b.val) { any = true } }
        if !any { continue }
        // its leading constant equalities, then (a range) in key order
        var eqs: []Expr = []
        for bc in wc.cols {
            var konst = false
            for d in bc.deps { if d == 0 { konst = true } }
            if !konst { break }
            append(mut &eqs, Expr.Lit(Val.Null))
        }
        let p = Path{index: wc.index, eqs: eqs, rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
        if !servesOrder(&lv.t, &p, cols) { return true }
    }
    return false
}

// The cheapest way into level k with the levels of mask placed: outer, one
// using their values (a lookup per row; rows -1 when there is none); else
// one by constants only (equalities, then a range of the next column, cs's:
// optimizer 29), a full scan at worst.
fn (q: &Query) wayInto(k: int, cands: &[]WayCand, mask: int, outer: bool, cs: &[]Expr): Way {
    let lv = &q.levels[k]
    let t = float(lv.est.rows)
    var best = if outer { Way{rows: -1.0f, cost: 0.0f, outer: true, inner: 0.0f} } else {
        Way{rows: t, cost: t * lexdb_plan.COST_SCAN, outer: false, inner: t * lexdb_plan.COST_SCAN_INNER}
    }
    for ci in 0..len(cands) {
        let wc = &cands[ci]
        var n = 0
        var uses = false
        var key = ""
        for bi in 0..len(wc.cols) {
            let b = &wc.cols[bi]
            var found = -1
            for i in 0..len(b.deps) {
                let d = b.deps[i]
                let ok = if outer { (d & ~mask) == 0 } else { d == 0 }
                if found < 0 && ok { found = i }
            }
            if found < 0 { break }
            if b.deps[found] != 0 { uses = true }
            if n == 0 { key = b.keys[found].clone() }
            n += 1
        }
        if outer && (n == 0 || !uses) { continue }
        var m = 1.0f
        if n == 0 {
            let e = lv.est.entriesOf(wc.tree)
            m = if e >= 0 { float(e) } else { t }
        } else if n < len(wc.cols) || !wc.unique {
            let r = lv.est.rowsFor(wc.tree, n, &key)
            m = if r >= 0 { float(r) } else { fmax(t / 10.0f, 1.0f) }
        }
        if n < len(wc.colIds) && wc.colIds[n] >= 0 {
            // a range of the next column (optimizer 29), by constants:
            // a lookup's too, after its equalities
            let sh = q.rangeShare(k, wc.colIds[n], cs)
            if n == 0 && sh >= 1.0f { continue }        // a whole index: no better than the full scan
            m = m * sh
        } else if n == 0 {
            continue
        }
        // a row by key through an index, or the primary key's own (one: a
        // point; more: a range, in batches as the first table)
        let point = wc.index < 0 && n == len(wc.cols) && wc.unique
        let perRow = if point || (wc.index >= 0 && outer) { lexdb_plan.COST_KEY_ROW } else if wc.index >= 0 { lexdb_plan.COST_IX_ROW } else if outer { lexdb_plan.COST_SCAN_INNER } else { lexdb_plan.COST_PK_RANGE }
        let cost = lexdb_plan.COST_DESCENT + m * perRow
        let inner = lexdb_plan.COST_DESCENT + m * (if wc.index >= 0 || point { lexdb_plan.COST_KEY_ROW } else { lexdb_plan.COST_SCAN_INNER })
        if best.rows < 0.0f || cost < best.cost { best = Way{rows: m, cost: cost, outer: outer, inner: fmin(inner, best.inner)} }
        else if !outer && inner < best.inner { best.inner = inner }
    }
    return best
}

// ---- a table's own conditions (optimizer 29): the share of its rows they
// keep, for the join order's estimates. An equality with a literal on a
// column leading an index or the primary key: its value's rows (the common
// values); else 1 / the column's distinct values. A range on a column whose
// least and greatest ANALYZE has (a leading column of numbers, dates or
// times), with literal bounds: the part of that span it covers; else 1/4,
// 1/16 bounded on both sides (SQLite's). An IN list of n: n / the distinct
// values. Anything else: 1/2. A parameter is an unknown value (the order
// does not depend on parameters).

// Level k's statistics entry for a column leading its primary key or an
// unfiltered index (-1 none).
fn (q: &Query) leadEntry(k: int, col: int): int {
    let lv = &q.levels[k]
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        if len(cols) == 0 || cols[0] != col { continue }
        let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
        for j in 0..len(lv.est.trees) { if lv.est.trees[j] == tree { return j } }
    }
    return -1
}

// A literal as a number of column col's type; None: not a literal (a cast
// of one counts: date '2021-06-01', optimizer 36), or not a number.
fn (q: &Query) litNum(k: int, col: int, x: &Expr): Option[float] { return litNumOf(&q.levels[k], col, x) }

fn litNumOf(lv: &Level, col: int, x: &Expr): Option[float] {
    match litValue(x) {
        Some(v) {
            if lexdb_ops.isNull(&v) { return None }
            match lexdb_ops.coerce(v, &boundType(&lv.t.cols[col].typ)) {
                Ok(cv) { return lexdb_stats.spanNum(&cv) }
                Err(_) { return None }
            }
        }
        None { return None }
    }
}

// Whether x is made of literals only: no column, parameter or call.
fn litOnly(x: &Expr): bool {
    match x {
        Expr.Lit(_) { return true }
        Expr.Unary(_, a) { return litOnly(&a) }
        Expr.Bin(_, a, b) { return litOnly(&a) && litOnly(&b) }
        Expr.Cast(a, _) { return litOnly(&a) }
        else { return false }
    }
}

// A literal's value, or a literal expression's (a cast, arithmetic) worked
// out; None: not one, or it gives an error.
fn litValue(x: &Expr): Option[Val] {
    match x {
        Expr.Lit(v) { return Some(v.clone()) }
        else {}
    }
    if !litOnly(x) { return None }
    let noCols: []lexdb_sql.ColDef = []
    let none: []Val = []
    let noSubs: []SubRes = []
    let noSeq: Option[SeqEnv] = None
    let env = Env{cols: &noCols, row: &none, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: &noSeq}
    match eval(x, &env) {
        Ok(v) { return Some(v) }
        Err(_) { return None }
    }
}

// x compares the column name with a constant: its operator, the column on
// the left ("" not such a comparison), and the constant in val.
fn (q: &Query) colCmp(name: &str, x: &Expr, val: mut &Expr): str {
    match x {
        Expr.Bin(op, l, r) {
            if !lexdb_bind.isCmp(&op) { return "" }
            match l {
                Expr.Col(n, _) {
                    if n == name && q.levelMask(&r) == 0 && !hasCorr(&r) {
                        val = lexdb_sql.cloneExpr(&r)
                        return op.clone()
                    }
                }
                else {}
            }
            match r {
                Expr.Col(n, _) {
                    if n == name && q.levelMask(&l) == 0 && !hasCorr(&l) {
                        val = lexdb_sql.cloneExpr(&l)
                        return if op == "<" { ">" } else if op == "<=" { ">=" } else if op == ">" { "<" } else if op == ">=" { "<=" } else { op.clone() }
                    }
                }
                else {}
            }
            return ""
        }
        else { return "" }
    }
}

// The share of level k's rows its range conditions on column col keep (1:
// none). By the samples of the column when it leads the primary key or an
// index and the bounds are literals (optimizer 37); else by its least and
// greatest (optimizer 29); else 1/4, 1/16 bounded on both sides.
fn (q: &Query) rangeShare(k: int, col: int, cs: &[]Expr): float {
    let lv = &q.levels[k]
    let name = lv.alias + "." + lv.t.cols[col].name
    var ops: []str = []
    var vals: []Expr = []
    for c in cs {
        var v = Expr.Lit(Val.Null)
        let op = q.colCmp(&name, &c, mut &v)
        if op != "<" && op != "<=" && op != ">" && op != ">=" { continue }
        append(mut &ops, op)
        append(mut &vals, v)
    }
    if len(ops) == 0 { return 1.0f }
    return q.boundsShare(k, col, &ops, &vals)
}

// The share of level k's rows within bounds (ops: "<", "<=", ">", ">=") on
// its column col.
fn (q: &Query) boundsShare(k: int, col: int, ops: &[]str, vals: &[]Expr): float {
    let lv = &q.levels[k]
    var hasLo = false
    var hasHi = false
    var known = true
    var lo = 0.0f
    var hi = 0.0f
    for i in 0..len(ops) {
        let x = q.litNum(k, col, &vals[i])
        if x.isNone() { known = false }
        let f = x.unwrapOr(0.0f)
        if ops[i] == ">" || ops[i] == ">=" {
            if !hasLo || f > lo { lo = f }
            hasLo = true
        } else {
            if !hasHi || f < hi { hi = f }
            hasHi = true
        }
    }
    let e = q.leadEntry(k, col)
    let t = fmax(float(lv.est.rows), 1.0f)
    if e >= 0 && e < len(lv.est.samp) {
        let sh = sampOnly(lv, e, col, ops, vals)
        if sh >= 0.0f { return fmax(sh, 1.0f / t) }
    }
    if known && e >= 0 && lv.est.span[e] {
        let mn = lv.est.lo[e]
        let mx = lv.est.hi[e]
        if mx <= mn { return 1.0f }
        let a = if hasLo && lo > mn { lo } else { mn }
        let b = if hasHi && hi < mx { hi } else { mx }
        if b < a { return 1.0f / t }
        return fmax((b - a) / (mx - mn), 1.0f / t)
    }
    return if hasLo && hasHi { 1.0f / 16.0f } else { 0.25f }
}

// The share of level k's rows its own conditions among cs keep (masks:
// the levels each uses); guessed set when a condition's share is a guess (no
// statistics say: an equality on a column no index leads with, or another
// test).
fn (q: &Query) localShare(k: int, cs: &[]Expr, masks: &[]int, guessed: mut &bool): float {
    var mine: []Expr = []
    for i in 0..len(cs) {
        if masks[i] != (1 << k) || hasCorr(&cs[i]) { continue }
        append(mut &mine, lexdb_sql.cloneExpr(&cs[i]))
    }
    return q.andShare(k, &mine, guessed)
}

// The share a conjunction of a level's own conditions keeps of its rows.
fn (q: &Query) andShare(k: int, cs: &[]Expr, guessed: mut &bool): float {
    let lv = &q.levels[k]
    var share = 1.0f
    var ranged: []int = []
    var names: []str = []
    for i in 0..len(cs) {
        // a disjunction: each branch's own share, as if independent
        // (PostgreSQL has no OR estimate either; 1 - (1-s1)(1-s2)...)
        if matchesOr(&cs[i]) {
            share = share * q.orShare(k, &cs[i], guessed)
            continue
        }
        if len(names) == 0 { for c in lv.t.cols { append(mut &names, lv.alias + "." + c.name) } }
        let c = &cs[i]
        var done = false
        for col in 0..len(lv.t.cols) {
            if done { break }
            var v = Expr.Lit(Val.Null)
            let op = q.colCmp(&names[col], c, mut &v)
            if op == "" { continue }
            done = true
            let name = &names[col]
            if op == "=" {
                share = share * q.eqShare(k, col, &v, guessed)
            } else if op == "<>" {
                share = share * (1.0f - 1.0f / q.distinctOf(name, k))
            } else {
                var seen = false
                for r in ranged { if r == col { seen = true } }
                if !seen {
                    append(mut &ranged, col)
                    share = share * q.rangeShare(k, col, cs)
                }
            }
        }
        if done { continue }
        match cs[i] {
            Expr.Call(n, args, _) {
                if n == "in" && len(args) > 1 {
                    match args[0] {
                        Expr.Col(a, _) {
                            let d = q.distinctKnown(&a, k)
                            if d <= 0.0f { guessed = true }
                            share = share * fmin(1.0f, float(len(args) - 1) * (if d > 0.0f { 1.0f / d } else { lexdb_plan.EQ_GUESS }))
                            continue
                        }
                        else {}
                    }
                }
            }
            else {}
        }
        share = share * 0.5f
        guessed = true
    }
    return share
}

// The share of level k's rows an OR of branches keeps: each branch's
// conditions on k only, multiplied within the branch; a branch with none
// leaves k alone (share 1).
fn (q: &Query) orShare(k: int, x: &Expr, guessed: mut &bool): float {
    var branches: []Expr = []
    orParts(x, mut &branches)
    var miss = 1.0f
    for b in branches {
        var ps: []Expr = []
        andParts(&b, mut &ps)
        var local: []Expr = []
        for d in ps {
            if q.levelMask(&d) == (1 << k) && !hasCorr(&d) { append(mut &local, lexdb_sql.cloneExpr(&d)) }
        }
        if len(local) == 0 { return 1.0f }
        miss = miss * (1.0f - fmin(1.0f, q.andShare(k, &local, guessed)))
    }
    return 1.0f - miss
}

// The share of level k's rows equal to v on column col.
fn (q: &Query) eqShare(k: int, col: int, v: &Expr, guessed: mut &bool): float {
    let lv = &q.levels[k]
    let e = q.leadEntry(k, col)
    if e >= 0 && lv.est.entries[e] > 0 {
        let noParams: []Val = []
        let key = constKey(v, &boundType(&lv.t.cols[col].typ), &noParams)
        let r = lexdb_stats.rowsOf(&lv.est.cm[e], &key)
        if r >= 0 { return fmax(float(r), 1.0f) / float(lv.est.entries[e]) }
    }
    let d = q.distinctKnown(&(lv.alias + "." + lv.t.cols[col].name), k)
    if d <= 0.0f { guessed = true }
    return if d > 0.0f { 1.0f / d } else { lexdb_plan.EQ_GUESS }
}

// An equality with a constant on a column whose distinct values are not
// known (no index leads with it): the share of the rows it keeps, SQLite's
// guess (a quarter). The table's rows / 10 (distinctOf's guess) made it
// about 10 rows whatever the table's size, which the measured costs
// (optimizer 36) turned into a full scan of the largest table (optimizer 39).

fn fmin(a: float, b: float): float { return if a < b { a } else { b } }

// A column's distinct values (level k's), for an equality's share.
fn (q: &Query) distinctOf(name: &str, k: int): float {
    let d = q.distinctKnown(name, k)
    if d > 0.0f { return d }
    return fmax(fmax(float(q.levels[k].est.rows), 1.0f) / 10.0f, 1.0f)
}

// A column's distinct values when a key or an index (with statistics) leads
// with it; -1 not known.
fn (q: &Query) distinctKnown(name: &str, k: int): float {
    let lv = &q.levels[k]
    let i = colIndex(&q.cols, name) - lv.first
    let t = fmax(float(lv.est.rows), 1.0f)
    if len(lv.t.pk) == 1 && lv.t.pk[0] == i { return t }
    for x in 0..len(lv.t.indexes) + 1 {
        let c = x - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        if len(cols) == 0 || cols[0] != i { continue }
        if len(cols) == 1 && (c < 0 || lv.t.indexes[c].unique) { return t }
        let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
        for j in 0..len(lv.est.trees) { if lv.est.trees[j] == tree && lv.est.cm[j].d > 0 { return float(lv.est.cm[j].d) } }
    }
    // ANALYZE's count of another column (optimizer 39); none but NULLs: an
    // equality keeps a row at most
    if i >= 0 && i < len(lv.t.cols) {
        for j in 0..len(lv.est.cols) {
            if lv.est.cols[j] == lv.t.cols[i].name && lv.est.cnd[j] >= 0 { return if lv.est.cnd[j] > 0 { float(lv.est.cnd[j]) } else { t } }
        }
    }
    return -1.0f
}

// The rows of a set of levels (mask): its tables' by their constants,
// times each class's share between its lowest table and the rest: 1 / the
// largest distinct count among the class's columns there; at least one row.
// Defined by the lowest table, so a set's rows do not depend on the order
// that reached it. memo: the sets computed.
fn (q: &Query) setRows(mask: int, nl: int, base: &[]Way, cmask: &[]int, cdist: &[]float, memo: mut &Map[int, float]): float {
    if memo.has(&mask) { return memo.getOr(&mask, 1.0f) }
    var low = 0
    while (mask & (1 << low)) == 0 { low += 1 }
    let rest = mask & ~(1 << low)
    var r = base[low].rows * (if rest == 0 { 1.0f } else { q.setRows(rest, nl, base, cmask, cdist, memo) })
    for ci in 0..len(cmask) {
        let cm = cmask[ci]
        if (cm & (1 << low)) == 0 { continue }
        let other = cm & rest
        if other == 0 { continue }
        // the class's most selective column among the set's
        var d = cdist[ci * nl + low]
        for l in 0..nl { if (other & (1 << l)) != 0 { d = fmax(d, cdist[ci * nl + l]) } }
        r = r / d
    }
    let v = fmax(r, 1.0f)
    memo.put(mask, v)
    return v
}

// SQLite's N-best search from the levels init (each a one-table start):
// the order (order, flags: read once) and its cost (optimizer 28; from a
// given start, optimizer 32).
fn (q: &Query) nBest(init: &[]int, nl: int, cands: &[][]WayCand, owns: &[][]Expr, base: &[]Way, adj: &[]int, cmask: &[]int, cdist: &[]float,
                     memo: mut &Map[int, float], lookups: bool, cap: float, order: mut &[]int, flags: mut &[]bool): float {
    // SQLite's N-best search: at each step the JOIN_BEST cheapest
    // partial orders are kept (one per set of tables), each extended by
    // every table it may take next
    var pm: []int = []
    var pc: []float = []
    var po: [][]int = []
    var pf: [][]bool = []
    for k in init {
        append(mut &pm, 1 << k)
        append(mut &pc, base[k].cost)
        append(mut &po, [k])
        append(mut &pf, [false])
    }
    bestOf(mut &pm, mut &pc, mut &po, mut &pf)
    for step in 1..nl {
        // the extensions: per set of tables the cheapest, as its parent
        // path and the table added (copied only when kept)
        var nm: []int = []
        var nc: []float = []
        var npar: []int = []
        var nk: []int = []
        var nh: []bool = []
        var at: Map[int, int] = newMap()
        for p in 0..len(pm) {
            let mask = pm[p]
            let rin = q.setRows(mask, nl, base, cmask, cdist, memo)
            var nb = 0
            for l in 0..nl { if (mask & (1 << l)) != 0 { nb = nb | adj[l] } }
            let linked = (nb & ~mask) != 0
            for k in 0..nl {
                if (mask & (1 << k)) != 0 { continue }
                if linked && (adj[k] & mask) == 0 { continue }
                let next = mask | (1 << k)
                var o = false
                let rnext = q.setRows(next, nl, base, cmask, cdist, memo)
                let total = pc[p] + q.joinStep(k, &cands[k], &owns[k], &base[k], mask, rin, rnext, lookups, cap, mut &o)
                let j = at.getOr(&next, -1)
                if j >= 0 {
                    if nc[j] <= total { continue }
                    nc[j] = total
                    npar[j] = p
                    nk[j] = k
                    nh[j] = o
                } else {
                    at.put(next, len(nm))
                    append(mut &nm, next)
                    append(mut &nc, total)
                    append(mut &npar, p)
                    append(mut &nk, k)
                    append(mut &nh, o)
                }
            }
        }
        // the JOIN_BEST cheapest, cheapest first (a tie: the earlier)
        var taken: []bool = array(len(nm), false)
        var m2: []int = []
        var c2: []float = []
        var o2: [][]int = []
        var f2: [][]bool = []
        while len(m2) < lexdb_plan.JOIN_BEST && len(m2) < len(nm) {
            var b = -1
            for i in 0..len(nm) { if !taken[i] && (b < 0 || nc[i] < nc[b]) { b = i } }
            taken[b] = true
            append(mut &m2, nm[b])
            append(mut &c2, nc[b])
            var ord = collections.copyOf(&po[npar[b]])
            append(mut &ord, nk[b])
            var fl = collections.copyOf(&pf[npar[b]])
            append(mut &fl, nh[b])
            append(mut &o2, ord)
            append(mut &f2, fl)
        }
        pm = m2
        pc = c2
        po = o2
        pf = f2
    }
    // the cheapest (the first: bestOf orders them)
    order = replace(mut &po[0], [])
    flags = replace(mut &pf[0], [])
    return pc[0]
}

// The cost of joining level k to the set mask (rin its rows; rnext the rows
// of the set with k): its constant way read once and hashed, then a probe
// per row; or a lookup per row, whichever is cheaper (hashed: the first).
// Where a lookup is possible, it is taken when lookups is set, or when the
// hash would hold more than cap bytes (statement memory, optimizer 26
// review).
fn (q: &Query) joinStep(k: int, cands: &[]WayCand, own: &[]Expr, base: &Way, mask: int, rin: float, rnext: float, lookups: bool,
                        cap: float, hashed: mut &bool): float {
    let out = rnext * lexdb_plan.ROW_COST
    var add = base.inner + base.rows * lexdb_plan.HASH_BUILD + rin * lexdb_plan.HASH_PROBE + out
    hashed = true
    let w = q.wayInto(k, cands, mask, true, own)
    if w.rows >= 0.0f {
        let big = base.rows * float(estRowBytes(&q.levels[k].t)) > cap
        if lookups || big || rin * w.cost + out < add {
            add = rin * w.cost + out
            hashed = false
        }
    }
    return add
}

// A hash join's rows at most, in bytes, unless there is no lookup: a
// quarter of the default statement memory (MAX_STATEMENT_MEM); less when
// the session's max_statement_mem is lower (half of it).

// A row's size in a hash, estimated as rowBytes counts a row held: 32
// bytes, 24 a value, and a text's bytes (32 taken as its length).
fn estRowBytes(t: &Table): int {
    var n = 32
    for c in t.cols { n += 24 + (if c.typ.kind == lexdb_sql.K_TEXT { 32 } else { 0 }) }
    return n
}

// Keeps the JOIN_BEST cheapest of the partial orders, cheapest first (a tie:
// the earlier).
fn bestOf(pm: mut &[]int, pc: mut &[]float, po: mut &[][]int, pf: mut &[][]bool) {
    var taken: []bool = array(len(pm), false)
    var m: []int = []
    var c: []float = []
    var o: [][]int = []
    var f: [][]bool = []
    while len(m) < lexdb_plan.JOIN_BEST && len(m) < len(pm) {
        var b = -1
        for i in 0..len(pm) { if !taken[i] && (b < 0 || pc[i] < pc[b]) { b = i } }
        taken[b] = true
        append(mut &m, pm[b])
        append(mut &c, pc[b])
        append(mut &o, replace(mut &po[b], []))
        append(mut &f, replace(mut &pf[b], []))
    }
    pm = m
    pc = c
    po = o
    pf = f
}

// A query with outer joins, its tables in FROM's order (optimizer 41):
// per table after the first, whether it is read once and hashed (true)
// or looked up per row of the tables before it, whichever costs less, as
// joinStep weighs them: the rows reaching it are the first table's by its
// own conditions, then times each table's rows a lookup gives (a LEFT
// JOIN keeps a row that joins none). false: it does not apply (a RIGHT or
// FULL JOIN, LATERAL, a table without statistics). early: a lookup stays a
// lookup (reading may stop early); cap: a hash's bytes at most.
fn (q: &Query) outerReadOnce(ms: &[][]Expr, early: bool, cap: float, ro: mut &[]bool): bool {
    let nl = len(q.levels)
    for lv in q.levels {
        if keepsRight(lv.join) || lv.lateral || (lv.est.rows < 0 && !lv.virt()) { return false }
    }
    var out: []bool = array(nl, false)
    var rin = 1.0f
    for k in 0..nl {
        let lv = &q.levels[k]
        if lv.virt() { continue }
        let cs = &ms[k]
        var own: []Expr = []
        var ownMasks: []int = []
        for c in cs {
            let mk = q.levelMask(&c)
            if mk == (1 << k) {
                append(mut &own, lexdb_sql.cloneExpr(&c))
                append(mut &ownMasks, mk)
            }
        }
        let cands = q.wayCands(k, cs)
        var g = false
        let rows = fmax(float(lv.est.rows) * q.localShare(k, &own, &ownMasks, mut &g), 1.0f)
        if k == 0 {
            rin = rows
            continue
        }
        let w = q.wayInto(k, &cands, (1 << k) - 1, true, &own)
        if w.rows < 0.0f { continue }               // no lookup: hashed in any case
        let base = q.wayInto(k, &cands, 0, false, &own)
        let hash = base.inner + rows * lexdb_plan.HASH_BUILD + rin * lexdb_plan.HASH_PROBE
        let big = rows * float(estRowBytes(&lv.t)) > cap
        if !early && !big && hash < rin * w.cost { out[k] = true }
        rin = if keepsLeft(lv.join) { rin * fmax(w.rows, 1.0f) } else { rin * w.rows }
    }
    ro = out
    return true
}

// Whether the right join's hash of level 0 (a, rightCheaper) fits in cap
// bytes: its rows (by ANALYZE) at what a row is held as (32 bytes, 24 a
// value) plus its stored size on average (its table's pages, long values'
// included, over its rows). The stored size counts every column, not only
// those the statement uses: an overestimate, so a hash that might not fit
// keeps the lookups (which hold nothing).
fn (q: &Query) rightFits(st: &lexdb_store.Store, cap: float): Result[bool, DbErr] {
    let a = &q.levels[0]
    if a.est.rows <= 0 || a.t.tree < 0 { return Ok(a.est.rows == 0) }
    let pages = try lexdb_access.pages(st, &lexdb_catalog.relOf(&a.t))
    let stored = float(pages * lexdb_rows.PAGE) / float(a.est.rows)
    let held = float(a.est.rows) * (32.0f + 24.0f * float(len(a.t.cols)) + stored)
    return Ok(held <= cap)
}

// Whether "a LEFT JOIN b" (two tables, FROM's order) costs less as a hash
// right join: b read first by its own ON conditions, a read once into a
// hash on the join's equalities, each row of b probing it, and a's rows that
// joined none added at the end with NULLs for b (PostgreSQL's Hash Right
// Join, tpch-perf 4.outer). The left join's way is what outerReadOnce chose
// (ro): a lookup into b per row of a, or b hashed. Not where a's hash would
// hold more than cap bytes, nor without an equality to hash on.
fn (q: &Query) rightCheaper(ms: &[][]Expr, ps: &[][]Expr, cap: float, ro: &[]bool): bool {
    if len(q.levels) != 2 { return false }
    let a = &q.levels[0]
    let b = &q.levels[1]
    if b.join != lexdb_sql.J_LEFT || a.virt() || b.virt() || a.lateral || b.lateral || a.lock != 0 || b.lock != 0 { return false }
    if a.est.rows < 0 || b.est.rows < 0 { return false }
    // every conjunct of this query's own columns (no outer value, no subquery)
    var ownA: []Expr = []
    var maskA: []int = []
    var ownB: []Expr = []
    var maskB: []int = []
    var eq = false
    for k in 0..2 {
        for c in ms[k] {
            let mk = q.levelMask(&c)
            if mk < 0 || hasSubCall(&c) || !immutable(&c) { return false }
            if k == 0 && mk == 1 {
                append(mut &ownA, lexdb_sql.cloneExpr(&c))
                append(mut &maskA, mk)
            } else if k == 1 && mk == 2 && cannotFail(&c) {
                append(mut &ownB, lexdb_sql.cloneExpr(&c))
                append(mut &maskB, mk)
            } else if k == 1 && mk == 3 {
                // an equality a hash of a keys on: a column of a (bare or
                // under its collation's key) equal to a value of b's alone
                match c {
                    Expr.Bin(op, x, y) {
                        if op == "=" {
                            let kx = keyedCol(&x)
                            let ky = keyedCol(&y)
                            if len(kx.name) > 0 && q.levelOf(&kx.name) == 0 && q.levelMask(&y) == 2 { eq = true }
                            if len(ky.name) > 0 && q.levelOf(&ky.name) == 0 && q.levelMask(&x) == 2 { eq = true }
                        }
                    }
                    else {}
                }
            }
        }
        for c in ps[k] { if q.levelMask(&c) < 0 || hasSubCall(&c) || !immutable(&c) { return false } }
    }
    if !eq { return false }
    var g = false
    let rowsA = fmax(float(a.est.rows) * q.localShare(0, &ownA, &maskA, mut &g), 1.0f)
    let rowsB = fmax(float(b.est.rows) * q.localShare(1, &ownB, &maskB, mut &g), 1.0f)
    let candsA = q.wayCands(0, &ms[0])
    let firstA = q.wayInto(0, &candsA, 0, false, &ownA)
    let candsB = q.wayCands(1, &ms[1])
    let firstB = q.wayInto(1, &candsB, 0, false, &ownB)
    // the left join: a first, then b looked up per row or hashed
    var left = firstA.cost
    if len(ro) > 1 && ro[1] {
        left += firstB.inner + rowsB * lexdb_plan.HASH_BUILD + rowsA * lexdb_plan.HASH_PROBE
    } else {
        let w = q.wayInto(1, &candsB, 1, true, &ownB)
        if w.rows < 0.0f { return false }
        left += rowsA * w.cost
    }
    // the right join: b first, a hashed
    let right = firstB.cost + firstA.inner + rowsA * lexdb_plan.HASH_BUILD + rowsB * lexdb_plan.HASH_PROBE
    return right < left
}

// The cheapest order by cost: perm (old indexes, [] when it is FROM's) and
// per new place whether it is read once. false: it does not apply (a table
// without statistics, an outer join, LATERAL, too many tables).
// lookups: a table a lookup reaches is not read once instead.
// cap: a hash's bytes at most where a lookup is possible. ordT: the level an
// ORDER BY with a LIMIT can be read in order from (-1 none), ordCols its
// columns there, lim the rows
// the LIMIT and OFFSET take (optimizer 32).
fn (q: &Query) costOrder(ms: &[][]Expr, lookups: bool, cap: float, ordT: int, ordCols: &[]int, lim: float, perm: mut &[]int, ro: mut &[]bool): bool {
    let nl = len(q.levels)
    if nl < 2 || nl > lexdb_plan.JOIN_SEARCH_MAX { return false }
    for lv in q.levels {
        if isOuter(lv.join) || lv.lateral || lv.virt() || lv.est.rows < 0 { return false }
    }
    var cs: []Expr = []
    for m in ms { for c in m { append(mut &cs, lexdb_sql.cloneExpr(&c)) } }
    // the levels each conjunct uses
    var masks: []int = []
    for x in cs { append(mut &masks, q.levelMask(&x)) }
    var cands: [][]WayCand = []
    var base: []Way = []                // each level by its constants alone
    var guessed: []bool = []            // per level: its rows by a guessed share
    var owns: [][]Expr = []             // per level: its own conditions
    for k in 0..nl {
        append(mut &cands, q.wayCands(k, &cs))
        // its own conditions (no other table's columns)
        var own: []Expr = []
        var ownMasks: []int = []
        for i in 0..len(cs) {
            if masks[i] == (1 << k) {
                append(mut &own, lexdb_sql.cloneExpr(&cs[i]))
                append(mut &ownMasks, masks[i])
            }
        }
        // read by its constants; its rows: the table's, times the share its
        // own conditions keep (optimizer 29)
        let w = q.wayInto(k, &cands[k], 0, false, &own)
        let t = float(q.levels[k].est.rows)
        var g = false
        append(mut &base, Way{rows: fmax(t * q.localShare(k, &own, &ownMasks, mut &g), 1.0f), cost: w.cost, outer: false, inner: w.inner})
        append(mut &guessed, g)
        append(mut &owns, own)
    }
    // the levels each level shares a conjunct with
    var adj: []int = array(nl, 0)
    for m in masks {
        if m > 0 { for k in 0..nl { if (m & (1 << k)) != 0 { adj[k] = adj[k] | (m & ~(1 << k)) } } }
    }
    // the classes of equal columns (optimizer 27): a class joins the tables
    // holding its columns once, by 1 / the larger distinct count of the two
    // sides; a class with a constant joins nothing (each table's constant
    // condition has counted)
    // flat, for the loop over every set: per class the levels holding it
    // (a mask) and per class and level its column's distinct values
    var cmask: []int = []
    var cdist: []float = []             // class * nl + level
    let all = q.eqClasses(&cs)
    for x in 0..len(all) {
        if len(all[x].konst) > 0 { continue }
        var m = 0
        var ds: []float = array(nl, 0.0f)
        for i in 0..len(all[x].names) {
            let l = all[x].levels[i]
            if (m & (1 << l)) == 0 {
                m = m | (1 << l)
                ds[l] = q.distinctOf(&all[x].names[i], l)
            }
        }
        if m & (m - 1) == 0 { continue }        // one table's columns only
        append(mut &cmask, m)
        for d in ds { append(mut &cdist, d) }
    }
    var order: []int = []
    var flags: []bool = []
    var bestCost = 0.0f
    // the rows of a set, as needed (2^n sets past JOIN_EXACT_MAX is too many
    // to list: optimizer 30)
    var memo: Map[int, float] = newMap()
    if nl <= lexdb_plan.JOIN_EXACT_MAX {
        let full = (1 << nl) - 1
        var cost: []float = array(full + 1, -1.0f)
        var last: []int = array(full + 1, -1)
        var lastOnce: []bool = array(full + 1, false)
        for k in 0..nl {
            cost[1 << k] = base[k].cost
            last[1 << k] = k
        }
        for mask in 1..full + 1 {
            if cost[mask] < 0.0f { continue }
            let rin = q.setRows(mask, nl, &base, &cmask, &cdist, mut &memo)
            var nb = 0
            for l in 0..nl { if (mask & (1 << l)) != 0 { nb = nb | adj[l] } }
            let linked = (nb & ~mask) != 0
            for k in 0..nl {
                if (mask & (1 << k)) != 0 { continue }
                if linked && (adj[k] & mask) == 0 { continue }       // a cross product while a join is left
                let next = mask | (1 << k)
                var o = false
                let rnext = q.setRows(next, nl, &base, &cmask, &cdist, mut &memo)
                let total = cost[mask] + q.joinStep(k, &cands[k], &owns[k], &base[k], mask, rin, rnext, lookups, cap, mut &o)
                if cost[next] < 0.0f || total < cost[next] {
                    cost[next] = total
                    last[next] = k
                    lastOnce[next] = o
                }
            }
        }
        bestCost = cost[full]
        var rev: []int = []
        var revOnce: []bool = []
        var m = full
        while m != 0 {
            let k = last[m]
            append(mut &rev, k)
            append(mut &revOnce, lastOnce[m] && (m & ~(1 << k)) != 0)
            m = m & ~(1 << k)
        }
        for i in 0..nl {
            append(mut &order, rev[nl - 1 - i])
            append(mut &flags, revOnce[nl - 1 - i])
        }
    } else {
        var starts: []int = []
        for k in 0..nl { append(mut &starts, k) }
        bestCost = q.nBest(&starts, nl, &cands, &owns, &base, &adj, &cmask, &cdist, mut &memo, lookups, cap, mut &order, mut &flags)
    }
    // ORDER BY ... LIMIT (optimizer 32): the ordered table first, read in its
    // order (a full scan the planner turns into its index), each other table
    // looked up per row, stopping after the LIMIT: its cost is the whole
    // order's, times the share of the rows the LIMIT takes. It is taken when
    // that is cheaper than the best order's cost and a sort of its rows. Not
    // with a hash: a hash is built whole before the first row.
    // Only when the table has no way in by its constants, so path choice
    // will read it in order: its cost no longer says so, an index's way can
    // cost more than the scan (optimizer 39).
    //
    // Not when another table's rows are a guess (optimizer 39): if it keeps
    // far fewer than guessed, the LIMIT's rows come late and the ordered
    // table is read whole, a lookup per row (a filter on a column without an
    // index). A hash is built whole before the first row: its cost counts in
    // full, not the LIMIT's share (a hash of one pinned row is no reason
    // against it).
    var sure = true
    for k in 0..nl { if k != ordT && guessed[k] { sure = false } }
    if ordT >= 0 && sure && !q.constWay(ordT, &cands[ordT], &cs, ordCols) {
        var o2: []int = []
        var f2: []bool = []
        let c2 = q.nBest(&[ordT], nl, &cands, &owns, &base, &adj, &cmask, &cdist, mut &memo, true, cap, mut &o2, mut &f2)
        var builds = 0.0f
        for i in 1..nl { if f2[i] { builds += base[o2[i]].cost + base[o2[i]].rows * lexdb_plan.HASH_BUILD } }
        let rall = q.setRows((1 << nl) - 1, nl, &base, &cmask, &cdist, mut &memo)
        let frac = fmin(1.0f, lim / rall)
        let sortCost = rall * lexdb_plan.ROW_COST * float(scaleOf(int(rall)))
        if fmax(c2 - builds, 0.0f) * frac + builds < bestCost + sortCost {
            order = o2
            flags = f2
        }
    }
    var ident = true
    for i in 0..nl {
        append(perm, order[i])
        append(ro, flags[i])
        if order[i] != i { ident = false }
    }
    if ident { perm = [] }
    return true
}

// Whether a SELECT reads all its rows before giving one: GROUP BY, an
// aggregate, DISTINCT, a window (optimizer 33).
fn stmtGathers(s: &lexdb_sql.Stmt): bool {
    if len(s.group) > 0 || len(s.gsets) > 0 || s.having.isSome() || s.distinct || len(s.distinctOn) > 0 || len(s.wins) > 0 { return true }
    for it in s.items { match it.expr { Some(x) { if hasAgg(&x) { return true } } None {} } }
    return false
}

// A LIMIT's (or OFFSET's) rows for the join order: a literal's value, else
// (a parameter, an expression) 100; none 0.
fn limitGuess(x: &Option[Expr]): int {
    match x {
        Some(e) {
            match e {
                Expr.Lit(v) {
                    match v {
                        Val.Int(n) { return if n < 0 { 0 } else { n } }
                        else { return 100 }
                    }
                }
                else { return 100 }
            }
        }
        None { return 0 }
    }
}

// The level whose rows an ORDER BY sorts by, all its items plain columns of
// that one table in one direction (NULLs where an index keeps them), and a
// key or an unfiltered index of it giving that order: its index; else -1.
fn (q: &Query) orderedLevel(items: &[]lexdb_sql.OrderItem, out: mut &[]int): int {
    if len(items) == 0 { return -1 }
    var lv = -1
    var cols: []int = []
    for it in items {
        if it.desc != items[0].desc || it.nullsFirst != it.desc { return -1 }
        match it.expr {
            Expr.Col(n, _) {
                match lexdb_bind.resolveName(&q.cols, len(q.cols), &n) {
                    Ok(ci) {
                        let l = q.levelOf(&q.cols[ci].name)
                        if l < 0 || (lv >= 0 && l != lv) { return -1 }
                        lv = l
                        append(mut &cols, ci - q.levels[l].first)
                    }
                    Err(_) { return -1 }
                }
            }
            else { return -1 }
        }
    }
    if q.levels[lv].virt() { return -1 }
    let t = &q.levels[lv].t
    for c0 in 0..len(t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && t.indexes[c].pred.isSome() { continue }
        let p = Path{index: c, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
        if servesOrder(t, &p, &cols) {
            for x in cols { append(out, x) }
            return lv
        }
    }
    return -1
}

// A table of nothing (a level's place while levels are moved).
fn noTable(): Table {
    return Table{name: "", tree: -1, cols: [], pk: [], indexes: [], slots: [], width: 0, checks: [], fks: [], refBy: [], layouts: [], lays: [],
                 view: "", deps: [], rn: [], onCommit: 0, spell: "", pkName: "", invalid: []}
}

// Whether a table is pinned to one row by its key's equalities with
// constants or parameters (optimizer 35), and the order bound by keys from
// it reaches every other table by a key or an index of the tables before
// (optimizer 39): a pinned row that binds nothing else (a settings row) says
// nothing about how to read the rest, which costing decides. The order (old
// indexes, every level) when it is so, else [].
fn (q: &Query) pinnedOrder(ms: &[][]Expr): []int {
    if !q.innerOnly() { return [] }
    let nl = len(q.levels)
    var cs: []Expr = []
    for m in ms { for c in m { append(mut &cs, lexdb_sql.cloneExpr(&c)) } }
    var placed: []bool = array(nl, false)
    var start = -1
    for k in 0..nl { if start < 0 && q.bindOf(k, &cs, &placed) == 3 { start = k } }
    if start < 0 { return [] }
    placed[start] = true
    var out: []int = [start]
    for n in 1..nl {
        var best = -1
        var bb = -1
        for k in 0..nl {
            if placed[k] { continue }
            let b = q.bindOf(k, &cs, &placed)
            if b > bb {
                bb = b
                best = k
            }
        }
        // a subquery's rows have no key: read once, wherever they go
        if bb < 2 && !q.levels[best].virt() { return [] }
        placed[best] = true
        append(mut &out, best)
    }
    return out
}

// Whether every join is inner and none LATERAL: its tables may run in any
// order, and its equalities imply others.
fn (q: &Query) innerOnly(): bool {
    for lv in q.levels { if isOuter(lv.join) || lv.lateral { return false } }
    return true
}

// The new order of q's levels (old indexes), [] when FROM's stands. ms: the
// conjuncts placed so far, per level.
fn (q: &Query) joinOrder(ms: &[][]Expr): []int {
    let nl = len(q.levels)
    if !q.innerOnly() { return [] }
    var cs: []Expr = []
    for m in ms { for c in m { append(mut &cs, lexdb_sql.cloneExpr(&c)) } }
    var placed: []bool = array(nl, false)
    var start = -1
    for k in 0..nl { if start < 0 && q.bindOf(k, &cs, &placed) == 3 { start = k } }
    if start < 0 { return [] }
    var out: []int = [start]
    placed[start] = true
    while len(out) < nl {
        var best = -1
        var bb = -1
        for k in 0..nl {
            if placed[k] { continue }
            let b = q.bindOf(k, &cs, &placed)
            if b > bb {
                bb = b
                best = k
            }
        }
        placed[best] = true
        append(mut &out, best)
    }
    for i in 0..nl { if out[i] != i { return out } }
    return []
}

// How the conjuncts cs bind level k's rows to the placed levels' (or to
// constants and parameters): 3 a unique key (the primary key or a unique
// index, not filtered) all equal: a row at most; 2 the leading column of a
// key or an index equal: a lookup; 1 another column equal: a hash join; 0
// none.
fn (q: &Query) bindOf(k: int, cs: &[]Expr, placed: &[]bool): int {
    let lv = &q.levels[k]
    var got = 0
    for ci in 0..len(lv.t.cols) {
        if got == 0 && q.eqBound(cs, &(lv.alias + "." + lv.t.cols[ci].name), k, placed) { got = 1 }
    }
    if lv.virt() { return got }
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        var n = 0
        for ci in cols {
            if ci < 0 || !q.eqBound(cs, &(lv.alias + "." + lv.t.cols[ci].name), k, placed) { break }
            n += 1
        }
        if n > 0 && n == len(cols) && (c < 0 || lv.t.indexes[c].unique) { return 3 }
        if n > 0 { got = 2 }
    }
    return got
}

// Whether a conjunct makes column name (level k's) equal to a value of the
// placed levels only, or of none.
fn (q: &Query) eqBound(cs: &[]Expr, name: &str, k: int, placed: &[]bool): bool {
    for c in cs {
        match c {
            Expr.Bin(op, a, b) {
                if op == "=" {
                    match a { Expr.Col(x, _) { if x == name && q.onlyPlaced(&b, k, placed) { return true } } else {} }
                    match b { Expr.Col(x, _) { if x == name && q.onlyPlaced(&a, k, placed) { return true } } else {} }
                }
            }
            else {}
        }
    }
    return false
}

fn (q: &Query) onlyPlaced(x: &Expr, k: int, placed: &[]bool): bool {
    if hasCorr(x) { return false }
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    for n in ns {
        let l = q.levelOf(&n)
        if l < 0 || l == k || !placed[l] { return false }
    }
    return true
}

// The rules (4.8): the whole primary key equal; then a unique index whose
// columns are all equal; then the most leading equalities, then a range on
// the next column; the primary key wins a tie. Nothing: a full scan.
//
// With ANALYZE's statistics (optimizer 24) the estimates decide between the
// candidates, not only their ties: the fewest reads (figCost) wins, a tie by
// the rules' order. The rules still decide
// - a whole-key equality on the primary key or a unique index (one row);
// - when the rules' choice has no figure (an index ANALYZE has not seen);
// and estimates compare only candidates of the rules' choice's kind: looked
// up per row of the tables before (its values come from them), or read once
// (a hash join); comparing those needs the rows before, which is join
// ordering's work. A candidate without a figure takes no part.
fn choosePath(q: &Query, k: int, cs: &[]Expr, params: &[]Val, lk: mut &[]Look): Path {
    let lv = &q.levels[k]
    var paths: []Path = []
    var scores: []int = []
    var figs: []Fig = []
    var outer: []bool = []
    var looks: []Look = []              // per candidate: its estimate's look if a parameter set it (optimizer 23); kind -1 none
    var best = -1
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if !q.usable(k, c, cs, params, lk) { continue }
        let cols = keyCols(&lv.t, c)
        var eqs: []Expr = []
        var rng: []Bound = []
        var ins: []Expr = []
        var inSub = -1
        var inArr: []Expr = []
        var feqs: []Expr = []           // from a pinned row: the equalities for the figure
        var fdiff = false
        for pos in 0..len(cols) {
            let ci = cols[pos]
            let ck = if ci >= 0 { lexdb_access.colCollKind(&lv.t.cols[ci]) } else { lexdb_sql.COLL_EXACT }
            if ci < 0 || ck != lexdb_sql.COLL_EXACT {
                // an expression's (9.89): the conditions on the same
                // expression; a column under a collation's keys (L2): the
                // conditions on its key, #ci(col) or #pad(col)
                let target = if ci < 0 { qualified(&lv.t.indexes[c].exprs[pos], &lv.alias) }
                             else { lexdb_bind.collKeyOf(ck, Expr.Col(lv.alias + "." + lv.t.cols[ci].name, -1)) }
                var xb = q.onceBounds(exprBounds(cs, &target, k, q), lv.readOnce)
                var xeq = -1
                for i in 0..len(xb) { if xb[i].op == "=" && xeq < 0 { xeq = i } }
                if xeq < 0 {
                    rng = xb
                    break
                }
                if q.pinned { append(mut &feqs, lexdb_sql.cloneExpr(&xb[xeq].val)) }
                append(mut &eqs, replace(mut &xb[xeq].val, Expr.Lit(Val.Null)))
                continue
            }
            let name = lv.alias + "." + lv.t.cols[ci].name
            var bs = q.onceBounds(bounds(cs, &name, k, q), lv.readOnce)
            var eqAt = -1
            // a constant's equality first where they are implied (optimizer
            // 27): the same for every row of the tables before, so the table
            // can be read once
            if q.implied {
                for i in 0..len(bs) { if bs[i].op == "=" && eqAt < 0 && q.maxLevel(&bs[i].val) < 0 && !hasCorr(&bs[i].val) { eqAt = i } }
            }
            // from a pinned row, the lookup per row (one row): an outer
            // value's equality before a constant's (optimizer 35)
            if q.pinned {
                for i in 0..len(bs) { if bs[i].op == "=" && eqAt < 0 && q.maxLevel(&bs[i].val) >= 0 { eqAt = i } }
            }
            for i in 0..len(bs) { if bs[i].op == "=" && eqAt < 0 { eqAt = i } }
            if eqAt < 0 {
                ins = inList(cs, &name, k, q)
                if lv.readOnce && q.anyOuter(&ins) { ins = [] }
                if len(ins) == 0 { inSub = inSubOf(cs, &name) }
                if len(ins) == 0 && inSub < 0 { inArr = anyOf(cs, &name, k, q) }
                if lv.readOnce && q.anyOuter(&inArr) { inArr = [] }
                if len(ins) == 0 && inSub < 0 && len(inArr) == 0 { rng = bs }
                break
            }
            if q.pinned {
                // the figure by the constant the outer value equals (it is
                // implied: the same rows), not the average (optimizer 39)
                var kAt = -1
                for i in 0..len(bs) { if bs[i].op == "=" && kAt < 0 && q.maxLevel(&bs[i].val) < 0 && !hasCorr(&bs[i].val) { kAt = i } }
                if kAt >= 0 && kAt != eqAt { fdiff = true }
                append(mut &feqs, lexdb_sql.cloneExpr(&bs[if kAt >= 0 { kAt } else { eqAt }].val))
            }
            append(mut &eqs, replace(mut &bs[eqAt].val, Expr.Lit(Val.Null)))
        }
        // an IN list counts as an equality; the full key by one is a lookup per value
        let hasIn = len(ins) > 0 || inSub >= 0 || len(inArr) > 0
        var score = 2 * (len(eqs) + (if hasIn { 1 } else { 0 })) + (if len(rng) > 0 { 1 } else { 0 })
        if c >= 0 && lv.t.indexes[c].pred.isSome() { score += 1 }      // filtered: fewer rows
        if len(eqs) == len(cols) {
            if c < 0 { score = 1000 } else if lv.t.indexes[c].unique { score = 999 }
        } else if hasIn && len(eqs) + 1 == len(cols) {
            if c < 0 { score = 500 } else if lv.t.indexes[c].unique { score = 499 }
        }
        if score == 0 { continue }
        var p = Path{index: c, eqs: eqs, rng: rng, desc: false, noNulls: false, ins: ins, inSub: inSub, inArr: inArr, stats: false, inMax: 0}
        if lv.readOnce && q.pathOuter(&p) { continue }          // read once (optimizer 26)
        let po = q.pathOuter(&p)
        var saved: []Expr = []
        if fdiff { saved = replace(mut &p.eqs, feqs) }
        let f = pathFig(lv, &p, params)
        // The first table's pure range, if the samples estimate it over
        // 1/SCAN_SHARE of the table, is read as a scan: skip the candidate.
        // (A later table's range is a hash build, read once: q10's orders
        // range of 3.8% is 57k rows to build from and 1.5M to scan.) A
        // range they estimate as narrower is the planner's index (stats: the
        // executor must not count it again). No sample: the counted switch
        // decides at run time; a per-row (correlated) range keeps its index.
        if !q.pinned && k == 0 && c >= 0 && lv.est.rows >= lexdb_plan.SCAN_MIN_ROWS &&
           len(p.eqs) == 0 && len(p.rng) > 0 && len(cols) > 0 && cols[0] >= 0 &&
           f.rows >= 0 && !f.bound && lv.est.rows > 0 && !ixCovers(lv, c) {
            if f.rows * lexdb_plan.SCAN_SHARE >= lv.est.rows { continue }
            p.stats = true
        }
        // the first equality's value set the figure: a look (optimizer 23)
        var lo = Look{kind: -1, c: Expr.Lit(Val.Null), p: Expr.Lit(Val.Null), out: 0, typ: noType(), cm: lexdb_stats.noCommon()}
        if f.rows >= 0 && len(p.eqs) >= 1 && !hasIn && score < 999 {
            let byParam = lexdb_bind.refParam(&p.eqs[0])
            if byParam && len(p.eqs) == 1 {
                let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
                let typ = keyType(&lv.t, c, 0)
                lo = Look{kind: 2, c: lexdb_sql.cloneExpr(&p.eqs[0]), p: Expr.Lit(Val.Null), out: scaleOf(f.rows), typ: typ, cm: lv.est.commonOf(tree)}
            }
        }
        if fdiff { p.eqs = saved }
        // x IN (subquery) on the first table: a lookup per value costs a
        // descent and the value's rows; past the values where those cost
        // more than reading the table once, the table is read whole
        // (pathScans). q20's 2,127 part keys into partsupp's 800,000 rows
        // were over the old fixed IN_LOOKUP_MAX.
        if inSub >= 0 && k == 0 && lv.est.rows > 0 {
            let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
            let r = lv.est.rowsFor(tree, len(p.eqs) + 1, &"")
            if r >= 0 {
                let one = lexdb_plan.COST_DESCENT + float(r) * (if c < 0 { lexdb_plan.COST_PK_RANGE } else { lexdb_plan.COST_IX_ROW })
                let most = float(lv.est.rows) * lexdb_plan.COST_SCAN / one
                p.inMax = if most > 1000000000.0f { 1000000000 } else { int(most) }
            }
        }
        append(mut &outer, po)
        append(mut &paths, p)
        append(mut &scores, score)
        append(mut &figs, f)
        append(mut &looks, lo)
        if best < 0 || score > scores[best] { best = len(scores) - 1 }
    }
    if best < 0 { return Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0} }
    var pick = best
    if scores[best] < 999 && figs[best].rows >= 0 {
        var pc = figCost(&figs[best], paths[best].index, k == 0)
        var group = 0
        for i in 0..len(paths) {
            // from a pinned row the tables before give one row, or rows of
            // the same values: per row or read once compare (optimizer 39)
            if (outer[i] != outer[best] && !q.pinned) || figs[i].rows < 0 { continue }
            group += 1
            let ci = figCost(&figs[i], paths[i].index, k == 0)
            if ci < pc || (ci == pc && scores[i] > scores[pick]) {
                pick = i
                pc = ci
            }
        }
        // a parameter's value set a figure that was compared: the plan is kept
        // for values of the same scale
        if group >= 2 {
            for i in 0..len(paths) {
                if (outer[i] == outer[best] || q.pinned) && figs[i].rows >= 0 && looks[i].kind == 2 {
                    append(lk, replace(mut &looks[i], Look{kind: -1, c: Expr.Lit(Val.Null), p: Expr.Lit(Val.Null), out: 0, typ: noType(), cm: lexdb_stats.noCommon()}))
                }
            }
        }
    }
    return replace(mut &paths[pick], Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0})
}

// A level read once (a hash join, optimizer 26) takes only the bounds whose
// values are the same for every row of the tables before: a constant
// equality or range is kept, an outer value's dropped, rather than the
// whole path (optimizer 33).
fn (q: &Query) onceBounds(bs: []Bound, readOnce: bool): []Bound {
    if !readOnce { return bs }
    var out: []Bound = []
    var all = bs
    for i in 0..len(all) {
        if q.maxLevel(&all[i].val) < 0 && !hasCorr(&all[i].val) {
            append(mut &out, Bound{op: replace(mut &all[i].op, ""), val: replace(mut &all[i].val, Expr.Lit(Val.Null))})
        }
    }
    return out
}

fn (q: &Query) anyOuter(xs: &[]Expr): bool {
    for x in xs { if q.maxLevel(&x) >= 0 || hasCorr(&x) { return true } }
    return false
}

// Whether the path's values change from row to row of the tables before
// it: they use those tables, or a correlated subquery (run per row).
fn (q: &Query) pathOuter(p: &Path): bool {
    for x in p.eqs { if q.maxLevel(&x) >= 0 { return true } }
    for x in p.ins { if q.maxLevel(&x) >= 0 { return true } }
    for b in p.rng { if q.maxLevel(&b.val) >= 0 { return true } }
    for x in p.inArr { if q.maxLevel(&x) >= 0 { return true } }
    return q.corr && pathCorr(p)
}

fn pathCorr(p: &Path): bool {
    for x in p.eqs { if hasCorr(&x) { return true } }
    for x in p.ins { if hasCorr(&x) { return true } }
    for b in p.rng { if hasCorr(&b.val) { return true } }
    for x in p.inArr { if hasCorr(&x) { return true } }
    return false
}

// The values of the correlated subqueries in a path's key values, for
// env's row (fillCur; memoized as the filter's are).
fn pathCur(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, p: &Path, env: &Env, rs: mut &Run): Result[[]Val, DbErr] {
    var cur: []Val = array(len(q.subs), Val.Null)
    for x in p.eqs { try fillCur(st, txn, q, &x, env, rs, mut &cur) }
    for x in p.ins { try fillCur(st, txn, q, &x, env, rs, mut &cur) }
    for b in p.rng { try fillCur(st, txn, q, &b.val, env, rs, mut &cur) }
    for x in p.inArr { try fillCur(st, txn, q, &x, env, rs, mut &cur) }
    return Ok(cur)
}

// The keys a path covers, its values evaluated now.
// A column's type for its bounds: a value too long for varchar(n) is not
// an error there, it only matches nothing.
fn boundType(t: &lexdb_sql.TypeName): lexdb_sql.TypeName {
    return lexdb_sql.TypeName{kind: t.kind, oid: t.oid, prec: t.prec, scale: t.scale, len: 0}
}

// The keys a path covers: with an IN list, a lookup (or range) per value,
// in key order (backward for a backward path).
fn pathScans(t: &Table, p: &Path, env: &Env): Result[[]Scan, DbErr] {
    if len(p.ins) == 0 && p.inSub < 0 && len(p.inArr) == 0 { return Ok([try pathScan(t, p, env)]) }
    if p.inSub >= 0 && len(env.subs[p.inSub].vals) > (if p.inMax > lexdb_plan.IN_LOOKUP_MAX { p.inMax } else { lexdb_plan.IN_LOOKUP_MAX }) {
        return Ok([lexdb_access.wholeScan()])
    }
    var eqs: []Val = []
    for k in 0..len(p.eqs) {
        let v = match try keyVal(try eval(&p.eqs[k], env), &keyType(t, p.index, k), envZone(env)) { Some(x) { x } None { return Ok([]) } }
        if lexdb_ops.isNull(&v) { return Ok([]) }
        append(mut &eqs, v)
    }
    let typ = keyType(t, p.index, len(p.eqs))
    // values of another class than the column's (a float for a numeric, a
    // timestamp for a date): = does not compare them as the column's type,
    // so one made the column's type would miss rows (a float 0.1 equals a
    // numeric 0.10000000000000000001); the table is read whole and the
    // condition decides
    if p.inSub >= 0 {
        let sc = env.subs[p.inSub].cls
        if sc != -2 && sc != lexdb_pipe.typeClass(&typ) { return Ok([lexdb_access.wholeScan()]) }
    }
    var vs: []Val = []
    if p.inSub >= 0 {
        // the subquery's values; one not of the column's type is left to
        // the condition, which stays (it decides what IN means)
        for x in env.subs[p.inSub].vals {
            match lexdb_ops.coerceZ(x.clone(), &typ, envZone(env)) {
                Ok(v) { append(mut &vs, v) }
                Err(_) {}
            }
        }
    } else if len(p.inArr) > 0 {
        // the array's elements; one not of the column's type is left to
        // the condition (it stays), as an IN subquery's are
        match try eval(&p.inArr[0], env) {
            Val.Text(a) {
                for part in try lexdb_ops.arrayParts(&a) {
                    match part {
                        Some(x) {
                            match lexdb_ops.coerceZ(Val.Text(x), &typ, envZone(env)) {
                                Ok(v) { append(mut &vs, v) }
                                Err(_) {}
                            }
                        }
                        None {}
                    }
                }
            }
            else {}
        }
    } else {
        for x in p.ins {
            match try keyVal(try eval(&x, env), &typ, envZone(env)) {
                Some(v) { append(mut &vs, v) }
                None {}
            }
        }
    }
    return Ok(lexdb_access.inScans(&lexdb_catalog.relOf(t), p.index, &eqs, &vs, p.desc))
}

// A key's value v as the column's type (for its bounds: keyType, boundType):
// None when it is out of the type's range (22003), as a bigint past an
// int's: it equals no value of the column, so it matches no row rather than
// failing (PostgreSQL compares the two as bigints). Other errors stand.
fn keyVal(v: Val, typ: &lexdb_sql.TypeName, z: &lexdb_time.Zone): Result[Option[Val], DbErr] {
    match lexdb_ops.coerceZ(v, typ, z) {
        Ok(x) { return Ok(Some(x)) }
        Err(x) {
            if x.state == "22003" { return Ok(None) }
            return Err(x)
        }
    }
}

fn pathScan(t: &Table, p: &Path, env: &Env): Result[Scan, DbErr] {
    var eqs: []Val = []
    for k in 0..len(p.eqs) {
        let v = match try keyVal(try eval(&p.eqs[k], env), &keyType(t, p.index, k), envZone(env)) { Some(x) { x } None { return Ok(lexdb_access.noScan()) } }
        if lexdb_ops.isNull(&v) { return Ok(lexdb_access.noScan()) }
        append(mut &eqs, v)
    }
    var los: []Val = []
    var his: []Val = []
    if len(p.rng) > 0 && (p.index >= 0 || len(p.eqs) < len(t.pk)) {
        let typ = keyType(t, p.index, len(p.eqs))
        for b in p.rng {
            let v = try lexdb_ops.coerceZ(try eval(&b.val, env), &typ, envZone(env))
            if lexdb_ops.isNull(&v) { return Ok(lexdb_access.noScan()) }
            if b.op == ">" || b.op == ">=" { append(mut &los, v) } else { append(mut &his, v) }
        }
    }
    return Ok(lexdb_access.rangeScan(&lexdb_catalog.relOf(t), p.index, &eqs, &los, &his, p.noNulls))
}

fn newLevel(t: rc Table, alias: &str, join: int, first: int): Level {
    return Level{t: t, alias: alias.clone(), join: join, first: first, path: Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}, cond: [],
                 post: [], local: [], perRow: true, hashCols: [], hashVals: [], hashKinds: [], hashInt: false, src: -1, work: -1, lateral: false, need: [],
                 lock: 0, lockWait: 0, keeps: false, est: lexdb_stats.noEst(), stops: false, estRows: -1, estMax: false, readOnce: false, semi: false, anti: false, resNot: false, resCol: -1, resVal: Expr.Lit(Val.Null), semiSub: -1}
}

// Plans a query over the tables of FROM (4.8): the tables are joined in the
// order written, and each WHERE conjunct is checked at the first table
// where all its columns are known.
// reorder: the tables of inner joins may run in another order than FROM's
// (a SELECT's; UPDATE ... FROM and DELETE ... USING keep their target first).
// The binder's pass (bindFrom: FROM, its columns, ON and WHERE resolved,
// the subqueries numbered; Query.lp) and then the planner's (planFrom,
// which reads the ON and WHERE conjuncts from Query.lp).
fn buildQuery(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, from: &[]lexdb_sql.FromItem,
              where: &Option[Expr], params: &[]Val, subs: &[]lexdb_sql.Stmt, selNames: &Map[str, int], star: bool,
              sc: mut &Scope, reorder: bool): Result[Query, DbErr] {
    var q = Query{levels: [], cols: [], top: [], subs: [], base: sc.names.base, corr: false, refs: [], implied: false, colAt: newMap(), pinned: false, noRefKeys: false, cc: [], cp: [], lp: lexdb_bind.noPlan(), jp: None}
    // this query's (its subqueries set their own)
    let early = sc.early
    sc.early = false
    let locking = sc.locking
    sc.locking = false
    q.noRefKeys = sc.noRefKeys
    sc.noRefKeys = false
    // the subqueries a semi-join may run (9.104): WHERE's top-level
    // conjuncts x IN (subquery) and EXISTS (subquery), of a SELECT
    var semiCand: []bool = array(len(subs), false)
    var anySemi = false
    if reorder {
        match where {
            Some(w) { anySemi = semiCands(&w, mut &semiCand) }
            None {}
        }
    }
    let hs = FromHints{early: early, locking: locking, ordBy: replace(mut &sc.ordBy, []), ordLim: sc.ordLim, semiCand: semiCand, anySemi: anySemi}
    sc.ordLim = -1
    let bf = try bindFrom(st, txn, from, where, params, subs, sc, mut &q)
    try planFrom(st, txn, mut &q, &hs, &bf, params, subs, selNames, star, sc, reorder)
    return Ok(q)
}

// Marks in cand the subqueries of x's top-level conjuncts (conjuncts')
// that are x IN (subquery) or EXISTS (subquery), as parsed (semiParsed);
// whether any. (Read in place: a WHERE is not copied for it.)
fn semiCands(x: &Expr, cand: mut &[]bool): bool {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" {
                let l = semiCands(&a, cand)
                let r = semiCands(&b, cand)
                return l || r
            }
        }
        else {}
    }
    let i = semiParsed(x)
    if i >= 0 && i < len(cand) {
        cand[i] = true
        return true
    }
    return false
}

// The hints planSelect left on the Scope for this query, taken by
// buildQuery before anything is planned (its subqueries set their own).
type FromHints = record {
    early: bool                 // Scope.early
    locking: bool               // Scope.locking
    ordBy: []lexdb_sql.OrderItem  // Scope.ordBy
    ordLim: int                 // Scope.ordLim
    semiCand: []bool            // per subquery: a semi-join's (WHERE's top-level x IN (subquery), EXISTS (subquery), 9.104)
    anySemi: bool
}

// What bindFrom found beside the Query.
type FromBound = record {
    anyUsing: bool              // a JOIN ... USING or NATURAL JOIN (*'s order in ColDef.pos)
    where: bool                 // Query.lp's top is WHERE's Filter
}

// The binder's pass over FROM (2e slice 2): each FROM item read (a table,
// a view planned under its owner, a FROM subquery planned first, a working
// table) and its columns added, USING's and NATURAL's ON made, the
// expression subqueries planned and numbered (the views' after them), ON
// and WHERE resolved. Its result is q's levels, columns and subqueries and
// q.lp: the items left-deep in FROM's order, each Join with its ON, and
// WHERE's Filter over them. The frame it pushes stays for the planner and
// the select list (endScope pops it).
fn bindFrom(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, from: &[]lexdb_sql.FromItem, where: &Option[Expr],
            params: &[]Val, subs: &[]lexdb_sql.Stmt, sc: mut &Scope, q: mut &Query): Result[FromBound, DbErr] {
    // a subquery in FROM is planned first: it sees the queries around this
    // one, not this one's tables
    var planned: [][]SubPlan = []
    for i in 0..len(subs) { append(mut &planned, []) }
    // its scope comes first, its columns added as its tables are read: a
    // LATERAL subquery sees the tables before it, another none of them
    append(mut &sc.names.frames, Frame{cols: [], exact: [], refs: [], refOids: [], subRefs: [], subOids: [], subNames: [], subColls: [], subKinds: [], subReads: [], hidden: false})
    let me = len(sc.names.frames) - 1
    var views: []SubPlan = []              // the views read, planned (9.82)
    var usingOn: []Option[Expr] = []       // per FROM item, the ON its USING or NATURAL makes (9.93)
    var order: []int = []                  // the columns in *'s order
    var anyUsing = false
    var tree = 0                           // the first column of the join tree being built (after the last comma)
    var items: []lexdb_bind.LPlan = []     // per FROM item, its logical plan (Query.lp)
    for f in from {
        for lv in q.levels {
            if lv.alias == f.alias { return Err(e("42712", &("table name \"" + f.alias + "\" specified more than once"))) }
        }
        var viewSrc = -1
        var item = lexdb_bind.noPlan()         // its plan, before its columns are renamed into the row (Sub)
        var viewName = ""
        var t = rc(Table{name: f.alias.clone(), tree: -1, cols: [], pk: [], indexes: [], slots: [], width: 0, checks: [], fks: [], refBy: [], layouts: [], lays: [],
                         view: "", deps: [], rn: [], onCommit: 0, spell: "", pkName: "", invalid: []})
        var lateral = false
        if f.sub >= 0 {
            sc.names.frames[me].hidden = !f.lateral
            let planning = planSub(st, txn, &subs[f.sub], params, sc, false)
            sc.names.frames[me].hidden = false
            var sp = try planning
            // (a CTE's use: its body's plan stays in its SubPlan, bound per use today)
            let spLp = if subs[f.sub].cte >= 0 { lexdb_bind.noPlan() } else { takeLp(mut &sp.sel) }
            // outer values: run per row of the tables before it (and cached by them)
            lateral = len(sp.sel.q.refs) > 0
            if lateral && keepsRight(f.join) {
                return Err(e("42P10", "a LATERAL subquery cannot be the right side of a RIGHT or FULL JOIN"))
            }
            let fcols = fromCols(&sp.sel)
            if len(f.cols) > len(fcols) {
                return Err(e("42P10", &("table \"" + f.alias + "\" has " + len(fcols).toStr() + " columns available but " +
                             len(f.cols).toStr() + " columns specified")))
            }
            for i in 0..len(fcols) {
                let name = if i < len(f.cols) { f.cols[i].clone() } else { fcols[i].name.clone() }
                var col = lexdb_sql.colDef(&name, outType(&fcols[i]), false)
                if i >= len(f.cols) || (f.cols[i] == "dummy" && sp.sel.srf == "#values:01") { col.spell = if i >= len(f.cols) { fcols[i].spell.clone() } else { "DUMMY" } }
                col.coll = fcols[i].coll.clone()
                append(mut &t.unshare().cols, col)
            }
            item = if subs[f.sub].cte >= 0 { lexdb_bind.LPlan.CteRef(subs[f.sub].cte, false, outBCols(fcols)) } else { spLp }
            append(mut &planned[f.sub], sp)
        } else if f.work >= 0 {
            var w = -1
            for i in 0..len(sc.works) { if sc.works[i].id == f.work { w = i } }
            if w < 0 {
                return Err(e("42P19", &("recursive reference to query \"" + f.table + "\" must not appear within its non-recursive term")))
            }
            if len(f.cols) > len(sc.works[w].cols) {
                return Err(e("42P10", &("table \"" + f.alias + "\" has " + len(sc.works[w].cols).toStr() + " columns available but " +
                             len(f.cols).toStr() + " columns specified")))
            }
            for i in 0..len(sc.works[w].cols) {
                let name = if i < len(f.cols) { f.cols[i].clone() } else { sc.works[w].cols[i].name.clone() }
                var col = lexdb_sql.colDef(&name, sc.works[w].cols[i].typ, false)
                if i >= len(f.cols) || (f.cols[i] == "dummy" && sc.works[w].cols[i].spell == "DUMMY") { col.spell = sc.works[w].cols[i].spell.clone() }
                col.coll = sc.works[w].cols[i].coll.clone()
                append(mut &t.unshare().cols, col)
            }
            var wcols: []lexdb_bind.BCol = []
            for i in 0..len(sc.works[w].cols) { append(mut &wcols, lexdb_bind.bcolOf(i, &sc.works[w].cols[i])) }
            item = lexdb_bind.LPlan.CteRef(f.work, true, wcols)
        } else {
            var tname = f.table.clone()
            for r in sc.rn {
                let rp = strings.split(&r, lexdb_catalog.RN_SEP)
                if len(rp) == 3 && rp[0] == "t" && rp[1] == f.table { tname = rp[2].toStr() }
            }
            let found = try findTableRc(st, txn, &tname)
            if found.isNone() {
                // a sequence: its one row (9.117), as a view of it
                match try findSeq(st, txn, &f.table) {
                    Some(d) { t = rc(seqRelation(&d)) }
                    None { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&f.table) + "\" does not exist"))) }
                }
            } else {
                t = found.unwrap()
            }
            if t.name != sc.target { try scCheck(st, txn, sc, &t.name, &(if len(t.view) > 0 { "view" } else { "table" })) }
            if len(t.view) > 0 {
                // a view: its query planned as a subquery in FROM (9.82),
                // its plan after the statement's own subqueries; its
                // relations read as its owner (9.83)
                if len(sc.names.frames) > 64 { return Err(e("42P17", &("infinite recursion detected in rules for relation \"" + lexdb_sql.shown(&f.table) + "\""))) }
                let vs = try viewQuery(&t)
                let vowner = (try readAcl(st, txn, &lexdb_catalog.relObj(&t.name))).owner
                if len(vowner) > 0 { append(mut &sc.asRole, vowner.clone()) }
                sc.names.frames[me].hidden = true
                let outerRn = replace(mut &sc.rn, t.rn.clone())
                let planning = planSub(st, txn, &vs, params, sc, false)
                sc.rn = outerRn
                sc.names.frames[me].hidden = false
                if len(vowner) > 0 { let x = pop(mut &sc.asRole) }
                // Oracle: a view whose query no longer plans (a table or a column it names was renamed or dropped) has errors
                var sp = try viewPlanned(st, txn, &t, move(planning))
                item = takeLp(mut &sp.sel)
                viewName = t.name.toStr()
                if len(f.cols) > len(t.cols) {
                    return Err(e("42P10", &("table \"" + f.alias + "\" has " + len(t.cols).toStr() + " columns available but " +
                                 len(f.cols).toStr() + " columns specified")))
                }
                var vt = Table{name: f.alias.clone(), tree: -1, cols: [], pk: [], indexes: [], slots: [], width: 0, checks: [], fks: [], refBy: [], layouts: [], lays: [],
                               view: "", deps: [], rn: [], onCommit: 0, spell: "", pkName: "", invalid: []}
                for i in 0..len(sp.sel.outs) {
                    let name = if i < len(f.cols) { f.cols[i].clone() } else if i < len(t.cols) { t.cols[i].name.clone() } else { sp.sel.outs[i].name.clone() }
                    var col = lexdb_sql.colDef(&name, outType(&sp.sel.outs[i]), false)
                    col.spell = if i < len(f.cols) { (if f.cols[i] == "dummy" && sp.sel.srf == "#values:01" { "DUMMY" } else { "" }) } else if i < len(t.cols) { t.cols[i].spell.clone() } else { sp.sel.outs[i].spell.clone() }
                    col.coll = sp.sel.outs[i].coll.clone()
                    append(mut &vt.cols, col)
                }
                viewSrc = len(subs) + len(views)
                append(mut &views, sp)
                t = rc(vt)
            } else if len(f.cols) > 0 {
                // t AS x(a, b): its first columns named so
                if len(f.cols) > len(t.cols) {
                    return Err(e("42P10", &("table \"" + f.alias + "\" has " + len(t.cols).toStr() + " columns available but " +
                                 len(f.cols).toStr() + " columns specified")))
                }
                for i in 0..len(f.cols) {
                    let tw = t.unshare()
                    tw.cols[i].name = f.cols[i].clone()
                    tw.cols[i].spell = ""
                }
            } else if len(sc.rn) > 0 && f.sub < 0 && f.work < 0 {
                // in a view's query: a column renamed since is named as the query's text names it
                for r in sc.rn {
                    let rp = strings.split(&r, lexdb_catalog.RN_SEP)
                    if len(rp) != 4 || rp[0] != "c" || rp[1] != t.name { continue }
                    let ci = colIndex(&t.cols, &rp[2].toStr())
                    if ci >= 0 {
                        let tw = t.unshare()
                        tw.cols[ci].name = rp[3].toStr()
                        tw.cols[ci].spell = ""
                    }
                }
            }
        }
        let first = len(q.cols)
        var icols: []lexdb_bind.BCol = []      // its columns in the row, as the binder's (the LPlan's)
        for k in 0..len(t.cols) {
            // a name repeated in one FROM item ((SELECT 1 AS a, 2 AS a) x,
            // unnest(a, b)): each its own column, the name ambiguous
            var name = t.cols[k].name.clone()
            for j in 0..k { if t.cols[j].name == name { name = name + lexdb_bind.DUPSEP + k.toStr() } }
            var qc = lexdb_sql.colDef(&(f.alias + "." + name), t.cols[k].typ, t.cols[k].notNull)
            qc.spell = t.cols[k].spell.clone()
            qc.coll = t.cols[k].coll.clone()
            append(mut &icols, lexdb_bind.bcolOf(len(q.cols), &qc))
            addCol(q, qc)
        }
        if f.sub < 0 && f.work < 0 && viewSrc < 0 {
            append(mut &items, lexdb_bind.LPlan.Get(t.name.toStr(), f.alias.toStr(), icols))
        } else {
            append(mut &items, lexdb_bind.LPlan.Sub(viewName, if viewSrc >= 0 { viewSrc } else { f.sub }, item, icols))
        }
        var lv = newLevel(t, &f.alias, f.join, first)
        lv.src = if viewSrc >= 0 { viewSrc } else { f.sub }
        lv.work = f.work
        lv.lateral = lateral
        append(mut &q.levels, lv)
        if len(subs) > 0 {
            // only its subqueries look here
            for i in first..len(q.cols) {
                var fc = lexdb_sql.colDef(&q.cols[i].name, q.cols[i].typ, q.cols[i].notNull)
                fc.spell = q.cols[i].spell.clone()
                fc.coll = q.cols[i].coll.clone()
                append(mut &sc.names.frames[me].cols, fc)
                // a subquery's, a view's, a working table's column is typed
                // by its first branch (a UNION's int over a numeric): not exact
                append(mut &sc.names.frames[me].exact, f.sub < 0 && f.work < 0 && viewSrc < 0)
            }
        }
        // JOIN ... USING and NATURAL JOIN (9.93): an ON made of the names'
        // equalities, and of each pair one side a bare name and * mean (the
        // left's, a RIGHT JOIN's right's, a FULL JOIN's COALESCE of both)
        var uon: Option[Expr] = None
        var merged: []int = []
        var gone: []int = []
        if f.comma { tree = first }
        if len(q.levels) > 1 && (len(f.using) > 0 || f.natural) {
            anyUsing = true
            var names: []str = []
            if f.natural {
                // the left's names in *'s order that the right has too
                for i in order {
                    if i < tree || i >= first || lexdb_catalog.hiddenName(&q.cols[i].name) || q.cols[i].using == lexdb_sql.USING_HIDDEN { continue }
                    let nm = lexdb_bind.colPart(&q.cols[i].name)
                    if lexdb_base.hasStr(&names, &nm) { continue }
                    var both = false
                    for j in first..len(q.cols) { if lexdb_bind.colPart(&q.cols[j].name) == nm && !lexdb_catalog.hiddenName(&q.cols[j].name) { both = true } }
                    if both { append(mut &names, nm) }
                }
            } else {
                for u in f.using {
                    if lexdb_base.hasStr(&names, &u) { return Err(e("42701", &("column name \"" + u + "\" appears more than once in USING clause"))) }
                    append(mut &names, u.clone())
                }
            }
            var conds: []Expr = []
            for nm in names {
                let li = try lexdb_bind.usingSide(&q.cols, tree, first, &nm, &"left")
                let ri = try lexdb_bind.usingSide(&q.cols, first, len(q.cols), &nm, &"right")
                let lx = lexdb_bind.colExpr(&q.cols, li)
                append(mut &conds, Expr.Bin("=", lx, Expr.Col(q.cols[ri].name.clone(), ri)))
                if f.join == lexdb_sql.J_RIGHT {
                    q.cols[li].using = lexdb_sql.USING_HIDDEN
                    append(mut &merged, ri)
                    append(mut &gone, li)
                } else if f.join == lexdb_sql.J_FULL {
                    let was = replace(mut &q.cols[li].using, "")
                    q.cols[li].using = if len(was) > 0 { was + "\x1f" + q.cols[ri].name } else { q.cols[ri].name.clone() }
                    q.cols[ri].using = lexdb_sql.USING_HIDDEN
                    append(mut &merged, li)
                    append(mut &gone, ri)
                } else {
                    q.cols[ri].using = lexdb_sql.USING_HIDDEN
                    append(mut &merged, li)
                    append(mut &gone, ri)
                }
            }
            if len(conds) > 0 {
                var x = pop(mut &conds)
                while len(conds) > 0 { x = Expr.Bin("and", pop(mut &conds), x) }
                uon = Some(x)
            }
            // the subqueries see the same
            for i in 0..len(sc.names.frames[me].cols) {
                let ci = colIndex(&q.cols, &sc.names.frames[me].cols[i].name)
                if ci >= 0 { sc.names.frames[me].cols[i].using = q.cols[ci].using.clone() }
            }
        }
        append(mut &usingOn, uon)
        var next: []int = []
        for i in merged { append(mut &next, i) }
        for i in order { if !hasIdx(&merged, i) && !hasIdx(&gone, i) { append(mut &next, i) } }
        for i in first..len(q.cols) { if !hasIdx(&merged, i) && !hasIdx(&gone, i) { append(mut &next, i) } }
        order = next
    }
    if anyUsing { for j in 0..len(order) { q.cols[order[j]].pos = j } }
    for i in 0..len(subs) {
        if len(planned[i]) == 0 { append(mut &planned[i], try planSub(st, txn, &subs[i], params, sc, false)) }
        let sp = pop(mut &planned[i])
        let top = len(sc.names.frames) - 1
        append(mut &sc.names.frames[top].subRefs, lexdb_sql.cloneAllExpr(&sp.sel.q.refs))
        append(mut &sc.names.frames[top].subOids, sp.oid)
        append(mut &sc.names.frames[top].subNames, sp.name.clone())
        append(mut &sc.names.frames[top].subColls, if len(sp.sel.outs) > 0 && lexdb_bind.isTextOid(sp.sel.outs[0].oid) { sp.sel.outs[0].coll.clone() } else { "" })
        append(mut &sc.names.frames[top].subKinds, lexdb_sql.COLL_EXACT)
        append(mut &sc.names.frames[top].subReads, 0)
        if len(sp.sel.q.refs) > 0 { q.corr = true }
        append(mut &q.subs, sp)
    }
    // the views' plans, numbered after the statement's subqueries
    var later: []SubPlan = []
    while len(views) > 0 { append(mut &later, pop(mut &views)) }
    while len(later) > 0 {
        let vp = pop(mut &later)
        let top = len(sc.names.frames) - 1
        append(mut &sc.names.frames[top].subRefs, [])
        append(mut &sc.names.frames[top].subOids, vp.oid)
        append(mut &sc.names.frames[top].subNames, vp.name.clone())
        append(mut &sc.names.frames[top].subColls, "")
        append(mut &sc.names.frames[top].subKinds, lexdb_sql.COLL_EXACT)
        append(mut &sc.names.frames[top].subReads, 0)
        append(mut &q.subs, vp)
    }
    let nl = len(q.levels)
    var lp = if nl == 0{ lexdb_bind.LPlan.One([]) } else { replace(mut &items[0], lexdb_bind.noPlan()) }
    for k in 0..nl {
        var jon: []Expr = []               // the logical plan's Join's ON
        match from[k].on {
            Some(on) {
                // ON sees this table and those before it
                let r = try enumOrder(st, txn, &(try lexdb_bind.resolve(&on, &q.cols, q.levels[k].first + len(q.levels[k].t.cols), mut &sc.names)), &q.cols)
                append(mut &jon, r)
            }
            None {}
        }
        match usingOn[k] {
            Some(u) {
                // its names qualified already; resolved as an ON is, for the
                // types' casts (char(n)'s, 9.94) and enums' order
                let r = try enumOrder(st, txn, &(try lexdb_bind.resolve(&u, &q.cols, q.levels[k].first + len(q.levels[k].t.cols), mut &sc.names)), &q.cols)
                append(mut &jon, r)
            }
            None {}
        }
        if k > 0 {
            let lc = lexdb_bind.lpColumns(&lp)
            let rc = lexdb_bind.lpColumns(&items[k])
            var jcols: []lexdb_bind.BCol = withCapacity(len(lc) + len(rc))
            for c in lc { append(mut &jcols, lexdb_bind.BCol{slot: c.slot, name: c.name.clone(), spell: c.spell.clone(), ty: c.ty.clone()}) }
            for c in rc { append(mut &jcols, lexdb_bind.BCol{slot: c.slot, name: c.name.clone(), spell: c.spell.clone(), ty: c.ty.clone()}) }
            lp = lexdb_bind.LPlan.Join(from[k].join, q.levels[k].lateral, lp, replace(mut &items[k], lexdb_bind.noPlan()), jon, jcols)
        } else if len(jon) > 0 {
            // (a first item's ON, which SQL's grammar does not make: a
            // Filter over it, level 0's condition)
            lp = lexdb_bind.LPlan.Filter(lp, jon, [])
        }
    }
    var hasWhere = false
    match where {
        Some(w0) {
            let w = pullCommonOr(w0)
            let r = try enumOrder(st, txn, &(try lexdb_bind.resolve(&w, &q.cols, len(q.cols), mut &sc.names)), &q.cols)
            lp = lexdb_bind.LPlan.Filter(lp, [r], [])
            hasWhere = true
        }
        None {}
    }
    q.lp = lp
    return Ok(FromBound{anyUsing: anyUsing, where: hasWhere})
}

// The ON conjuncts of q.lp's FROM part, per level (ms[k]: the k-th
// left-deep Join's), and WHERE's (where: q.lp's top is its Filter), as
// bindFrom left them; conjuncts copies them.
fn fromConds(p: &lexdb_bind.LPlan, where: bool, ms: mut &[][]Expr, cs: mut &[]Expr) {
    if where {
        match p {
            lexdb_bind.LPlan.Filter(i, w, _) {
                let n = onConds(&i, ms)
                for x in w { conjuncts(&x, cs) }
                return
            }
            else {}
        }
    }
    let n = onConds(p, ms)
}

// The levels in p, its Joins' ON conjuncts into ms by level.
fn onConds(p: &lexdb_bind.LPlan, ms: mut &[][]Expr): int {
    match p {
        lexdb_bind.LPlan.Join(_, _, l, _, on, _) {
            let k = onConds(&l, ms)
            if k < len(ms) { for x in on { conjuncts(&x, mut &ms[k]) } }
            return k + 1
        }
        lexdb_bind.LPlan.Filter(_, on, _) {
            // a first item's ON (bindFrom)
            if len(ms) > 0 { for x in on { conjuncts(&x, mut &ms[0]) } }
            return 1
        }
        else {}
    }
    return 1
}

// The planner's pass over FROM (2e slice 2), after bindFrom: the semi-join
// alternatives, the ON and WHERE conjuncts placed per level (read from
// q.lp), the implied equalities, the join order, the paths, hashing, the
// semi-joins.
fn planFrom(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, hs: &FromHints, bf: &FromBound,
            params: &[]Val, subs: &[]lexdb_sql.Stmt, selNames: &Map[str, int], star: bool, sc: mut &Scope,
            reorder: bool): Result[Unit, DbErr] {
    let early = hs.early
    let locking = hs.locking
    let anyUsing = bf.anyUsing
    // each table's statistics where they choose its path (a join's other
    // tables': when its order is costed, optimizer 35)
    for k in 0..len(q.levels) {
        if q.levels[k].src < 0 && q.levels[k].work < 0 { q.levels[k].est = try lexdb_stats.loadEst(st, txn, &q.levels[k].t, false, txn.sql.rules) }
    }
    var semiAlts: []Option[SubPlan] = []
    for i in 0..len(subs) { append(mut &semiAlts, None) }
    var semiLooks: []bool = array(len(subs), false)    // ... may be a lookup per row as a join's level (semiLook)
    // A correlated EXISTS or IN of a semi-join's that 9.9 could not hash,
    // its outer values a lookup's keys: planned again without them as
    // keys, to be hashed if a hash costs less (semiJoins). Not where
    // reading may stop early, nor in a transaction whose reads are noted:
    // there the lookups' reads stand (as in the join order). Planner work:
    // after every subquery is numbered and typed.
    if hs.anySemi && !early && !txn.noting() && !txn.sql.rules {
        for i in 0..len(subs) {
            if !hs.semiCand[i] { continue }
            let sp = &q.subs[i]
            if !((sp.use == lexdb_sql.SUB_EXISTS || sp.use == lexdb_sql.SUB_IN) && len(sp.sel.q.refs) > 0 && !sp.hashed && sp.cte < 0) { continue }
            semiLooks[i] = true
            sc.noRefKeys = true
            let nf = len(sc.names.frames)
            let again = planSub(st, txn, &subs[i], params, sc, true)
            sc.noRefKeys = false
            // (a plan that failed may have left its frame: this query's is the top one)
            while len(sc.names.frames) > nf { let gone = pop(mut &sc.names.frames) }
            let got = again.ok()
            if got.isSome() {
                let alt = got.unwrap()
                if alt.hashed && semiAltOk(&alt, &q.subs[i]) { semiAlts[i] = Some(alt) }
            }
        }
    }
    let nl = len(q.levels)
    // the columns by name, for levelOf (the planner asks it often: optimizer 30)
    if nl >= 2 { for i in 0..len(q.cols) { if !q.colAt.has(&q.cols[i].name) { q.colAt.put(q.cols[i].name.toStr(), i) } } }
    // A RIGHT or FULL JOIN can make the columns before it NULL: no WHERE
    // conjunct goes below the last one.
    var lastRight = -1
    for k in 0..nl { if keepsRight(q.levels[k].join) { lastRight = k } }
    var ms: [][]Expr = []
    var ps: [][]Expr = []
    for k in 0..nl {
        append(mut &ms, [])
        append(mut &ps, [])
    }
    var cs: []Expr = []                    // WHERE's conjuncts
    fromConds(&q.lp, bf.where, mut &ms, mut &cs)
    for i in 0..len(cs) {
        let c = replace(mut &cs[i], Expr.Lit(Val.Null))
        if nl == 0 {
            append(mut &q.top, c)
        } else {
            var k = q.maxLevel(&c)
            if k < 0 { k = 0 }
            if lastRight > k { k = lastRight }
            // An OR across tables: each table's own part of it is a
            // necessary filter, so a scan of that table can cut its
            // rows before the join (q19's part brand/container).
            // Not a LEFT JOIN's nullable side: its conditions are its
            // ON's, and a branch that holds for its NULL-extended row
            // ("b.y is null") would lose that row's match. Not a
            // volatile OR: its copy would draw again (random()).
            let om = q.levelMask(&c)
            if lastRight < 0 && matchesOr(&c) && (om & (om - 1)) != 0 && !hasSubCall(&c) && immutable(&c) {
                for lev in 0..nl {
                    if (om & (1 << lev)) == 0 || isOuter(q.levels[lev].join) { continue }
                    let got = orLevels(&c, lev, q)
                    if got.isSome() { append(mut &ms[lev], got.unwrap()) }
                }
            }
            if isOuter(q.levels[k].join) { append(mut &ps[k], c) } else { append(mut &ms[k], c) }
        }
    }
    // the columns the SELECT names, for the index-only choice (9.31):
    // narrow's, but before the paths are chosen rather than after
    if !star {
        for k in 0..len(q.levels) {
            if q.levels[k].virt() { continue }
            var need: []bool = []
            for c in q.levels[k].t.cols { append(mut &need, selNames.has(&c.name)) }
            q.levels[k].need = need
        }
    }
    var rightLocal: []Expr = []            // a's WHERE conjuncts when "a LEFT JOIN b" runs as a right join
    if reorder && nl >= 2 && !txn.sql.rules {
        // the join order: by cost with statistics (optimizer 26), else bound
        // by keys (optimizer 25); the conjuncts go again to the latest table
        // they use, in the new order
        if q.innerOnly() {
            // the implied equalities (optimizer 27), at the latest table they use
            var all: []Expr = []
            for m in ms { for c in m { append(mut &all, lexdb_sql.cloneExpr(&c)) } }
            let extra = q.implied(&all)
            for i in 0..len(extra) {
                var k = q.maxLevel(&extra[i])
                if k < 0 { k = 0 }
                append(mut &ms[k], lexdb_sql.cloneExpr(&extra[i]))
            }
            q.implied = true
        }
        var ro: []bool = []
        var perm: []int = []
        // By cost, except in a transaction whose reads are noted: there a
        // whole-table read, a hash's or a first table's scan, would conflict
        // with every write to the table (as the index-to-scan switch,
        // optimizer 19), so the order bound by keys stands, which starts
        // from a pinned row. Where reading may stop early, a lookup stays a
        // lookup (optimizer 26 review).
        // a hash holds at most half the statement's memory, 64 MB at most
        var cap = lexdb_plan.HASH_MAX_BYTES
        if txn.sql.memMax > 0 && float(txn.sql.memMax) / 2.0f < cap { cap = float(txn.sql.memMax) / 2.0f }
        var ordCols: []int = []
        let ordT = q.orderedLevel(&hs.ordBy, mut &ordCols)
        // A join that starts from a row its key pins (optimizer 35): the
        // order bound by keys, at once; no statistics read for it and no
        // search (most OLTP joins, planned on every run unless prepared).
        // Not with an ORDER BY ... LIMIT a table can serve: reading it in
        // order and stopping early (optimizer 32) may beat starting from the
        // pinned row (optimizer 39).
        var po: []int = []
        if ordT < 0 || hs.ordLim < 0 { po = q.pinnedOrder(&ms) }
        let pinned = len(po) > 0
        // from one row, a lookup per row is one lookup: cheaper than a hash
        // of what a constant reaches (the "constant first" rule, optimizer 27)
        if pinned {
            q.implied = false
            q.pinned = true
        }
        if !pinned && !txn.noting() {
            for k in 0..nl {
                if q.levels[k].est.rows < 0 && !q.levels[k].virt() {
                    let es = try lexdb_stats.loadEst(st, txn, &q.levels[k].t, true, txn.sql.rules)
                    q.levels[k].est = es
                }
            }
        }
        if pinned {
            var ident = true
            for i in 0..nl { if po[i] != i { ident = false } }
            if !ident { perm = po }
        } else if txn.noting() || !q.costOrder(&ms, early, cap, ordT, &ordCols, float(hs.ordLim), mut &perm, mut &ro) {
            perm = q.joinOrder(&ms)
            // outer joins, in FROM's order: each table hashed or looked up
            // by cost (optimizer 41)
            if !txn.noting() && len(perm) == 0 && !q.innerOnly() {
                if !q.outerReadOnce(&ms, early, cap, mut &ro) { ro = [] }
                // "a LEFT JOIN b" as "b RIGHT JOIN a", a hashed (rightCheaper):
                // b's own ON conditions are its filter (its rows that join
                // none are dropped either way); the rest of the ON is the
                // right join's; WHERE's conjuncts on a alone filter a's
                // rows as they are hashed (a row they drop neither joins
                // nor is kept), the others are checked after the join, on
                // the joined rows and a's rows kept with NULLs
                if !early && !locking && !anyUsing && len(q.subs) == 0 && q.rightCheaper(&ms, &ps, cap, &ro) &&
                   (try q.rightFits(st, cap)) {
                    var onB: []Expr = []
                    var onAB: []Expr = []
                    var post: []Expr = []
                    var xs = replace(mut &ms[1], [])
                    for i in 0..len(xs) {
                        let c = replace(mut &xs[i], Expr.Lit(Val.Null))
                        if q.levelMask(&c) == 2 && cannotFail(&c) { append(mut &onB, c) } else { append(mut &onAB, c) }
                    }
                    xs = replace(mut &ms[0], [])
                    for i in 0..len(xs) {
                        let c = replace(mut &xs[i], Expr.Lit(Val.Null))
                        if q.levelMask(&c) == 1 { append(mut &rightLocal, c) } else { append(mut &post, c) }
                    }
                    xs = replace(mut &ps[1], [])
                    for i in 0..len(xs) { append(mut &post, replace(mut &xs[i], Expr.Lit(Val.Null))) }
                    xs = replace(mut &ps[0], [])
                    for i in 0..len(xs) { append(mut &post, replace(mut &xs[i], Expr.Lit(Val.Null))) }
                    let la = replace(mut &q.levels[0], newLevel(rc(noTable()), "", 0, 0))
                    let lb = replace(mut &q.levels[1], newLevel(rc(noTable()), "", 0, 0))
                    q.levels[0] = lb
                    q.levels[1] = la
                    q.levels[0].join = lexdb_sql.J_FIRST
                    q.levels[1].join = lexdb_sql.J_RIGHT
                    ms[0] = onB
                    ms[1] = onAB
                    ps[1] = post
                    ro = []
                }
            }
        }
        if len(perm) == nl {
            var pool: []Expr = []
            for k in 0..nl {
                var xs = replace(mut &ms[k], [])
                for i in 0..len(xs) { append(mut &pool, replace(mut &xs[i], Expr.Lit(Val.Null))) }
            }
            var lvs: []Level = []
            for i in 0..nl { append(mut &lvs, replace(mut &q.levels[perm[i]], newLevel(rc(noTable()), "", 0, 0))) }
            q.levels = lvs
            for i in 0..nl { q.levels[i].join = if i == 0 { lexdb_sql.J_FIRST } else { lexdb_sql.J_INNER } }
            for i in 0..len(pool) {
                let c = replace(mut &pool[i], Expr.Lit(Val.Null))
                var k = q.maxLevel(&c)
                if k < 0 { k = 0 }
                append(mut &ms[k], c)
            }
        }
        for i in 0..len(ro) { q.levels[i].readOnce = ro[i] }
        if q.innerOnly() { q.oneEqPerClass(mut &ms) }
    }
    if q.corr {
        // a correlated subquery runs per row: its conjuncts go last
        for k in 0..nl {
            ms[k] = subsLast(replace(mut &ms[k], []))
            ps[k] = subsLast(replace(mut &ps[k], []))
        }
        q.top = subsLast(replace(mut &q.top, []))
    }
    for k in 0..nl {
        let m = replace(mut &ms[k], [])
        // a subquery's rows have no key: read them all
        // an IN (subquery) on it: its statistics, for the lookups' limit by
        // cost (Path.inMax), as a join's are loaded
        if !q.levels[k].virt() && q.levels[k].est.rows < 0 && !txn.sql.rules && !txn.noting() && hasInSub(&m) {
            q.levels[k].est = try lexdb_stats.loadEst(st, txn, &q.levels[k].t, true, txn.sql.rules)
        }
        var path = if q.levels[k].virt() { Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0} } else {
            choosePath(q, k, &m, params, mut &sc.looks)
        }
        var perRow = k == 0 || q.pathOuter(&path) || q.levels[k].lateral
        let right = keepsRight(q.levels[k].join)
        if right {
            // Every row of it is kept: read it all once, and remember which joined.
            path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
            perRow = false
        }
        var local: []Expr = []
        var hcols: []int = []
        var hvals: []Expr = []
        var hkinds: []int = []
        if !perRow {
            for c in m {
                if q.minLevel(&c) >= k {
                    if !right { append(mut &local, lexdb_sql.cloneExpr(&c)) }
                    continue
                }
                match c {
                    Expr.Bin(op, a, b) {
                        if op == "=" {
                            // col = x, or a collation's #ci(col) = #ci(x) (L2): hashed on the key
                            let ka = keyedCol(&a)
                            let kb = keyedCol(&b)
                            if len(ka.name) > 0 && q.levelOf(&ka.name) == k && q.valBefore(&b, k) {
                                append(mut &hcols, colIndex(&q.cols, &ka.name) - q.levels[k].first)
                                append(mut &hvals, lexdb_sql.cloneExpr(&b))
                                append(mut &hkinds, ka.kind)
                            } else if len(kb.name) > 0 && q.levelOf(&kb.name) == k && q.valBefore(&a, k) {
                                append(mut &hcols, colIndex(&q.cols, &kb.name) - q.levels[k].first)
                                append(mut &hvals, lexdb_sql.cloneExpr(&a))
                                append(mut &hkinds, kb.kind)
                            }
                        }
                    }
                    else {}
                }
            }
        }
        q.levels[k].path = path
        let er = pathEst(&q.levels[k], &q.levels[k].path, params)
        q.levels[k].estRows = er.rows
        q.levels[k].estMax = er.bound
        q.levels[k].perRow = perRow
        q.levels[k].cond = m
        q.levels[k].post = replace(mut &ps[k], [])
        q.levels[k].local = local
        q.levels[k].hashCols = hcols
        q.levels[k].hashVals = hvals
        q.levels[k].hashKinds = hkinds
    }
    for i in 0..len(rightLocal) { append(mut &q.levels[1].local, replace(mut &rightLocal[i], Expr.Lit(Val.Null))) }
    if hs.anySemi && nl > 0 { try semiJoins(st, txn, q, mut &semiAlts, &hs.semiCand, &semiLooks, params, sc) }
    return Ok(Unit{})
}

// Reads the tables that are joined by hash, once.
// Whether a semi-join hashes one integer key: its own map, not a string's
// (q4/q21 hash millions of order keys).
fn semiIntKey(lv: &Level): bool {
    if !lv.semi || !lv.hashInt || len(lv.hashCols) != 1 { return false }
    if len(lv.hashKinds) > 0 && lv.hashKinds[0] != lexdb_sql.COLL_EXACT { return false }
    return lexdb_rows.colKind(&lv.t.cols[lv.hashCols[0]]) == BK_INT
}

fn materialize(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: mut &Mats, params: &[]Val,
               rs: mut &Run): Result[Unit, DbErr] {
    let sqe = seqEnv(st, txn)
    for k in 1..len(q.levels) {
        if q.levels[k].perRow { continue }
        var rows: [][]Val = []
        var mat: [][]Val = []
        var keys: Map[str, int] = newMap()
        var ikeys: Map[int, int] = newMap()
        let fast = semiIntKey(&q.levels[k])
        var mixed: []bool = []
        var single: []Val = []
        var buckets: [][]int = []
        {
            let lv = &q.levels[k]
            var full: []Val = array(len(q.cols), Val.Null)
            if lv.virt() {
                for r in m.vrows[k] { append(mut &rows, collections.copyOf(&r)) }
            } else {
                let noAggs: []Val = []
                let env = Env{cols: &q.cols, row: &full, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
                let scans = try pathScans(&lv.t, &lv.path, &env)
                for sc in scans {
                    var cur = lexdb_access.newCursor()
                    while !cur.done { try fetch(st, txn, &lv.t, &lv.path, &sc, &lv.need, mut &cur, mut &rows) }
                }
            }
            rs.cnt[k].built += len(rows)
            try rs.bud.hold(lexdb_pipe.rowsBytes(&rows))
            let keepAll = keepsRight(lv.join)
            for i in 0..len(rows) {
                let r = replace(mut &rows[i], [])
                for j in 0..len(r) { full[lv.first + j] = r[j].clone() }
                if !(try allTrueX(st, txn, q, m, &lv.local, &full, params, rs)) { continue }
                var b = -1
                if fast {
                    // its one key, by value; a NULL key matches nothing
                    match r[lv.hashCols[0]] {
                        Val.Int(x) {
                            match ikeys.get(&x) {
                                Some(y) { b = y }
                                None {
                                    b = len(buckets)
                                    ikeys.put(x, b)
                                    append(mut &buckets, [])
                                    append(mut &mixed, false)
                                    append(mut &single, Val.Null)
                                }
                            }
                        }
                        else { continue }
                    }
                } else {
                    var kb = ""
                    var nul = false
                    for j in 0..len(lv.hashCols) {
                        let c = lv.hashCols[j]
                        if lexdb_ops.isNull(&r[c]) { nul = true }
                        let hv = if j < len(lv.hashKinds) { lexdb_sort.collVal(lv.hashKinds[j], &r[c]) } else { r[c].clone() }
                        if lv.virt() { lexdb_pipe.keyPart(mut &kb, &hv) } else { lexdb_access.encIdxPart(mut &kb, &hv) }
                    }
                    if nul {
                        // NULL equals nothing; a RIGHT or FULL JOIN still keeps the row
                        if keepAll {
                            append(mut &mat, r)
                            rs.cnt[k].kept += 1
                        }
                        continue
                    }
                    let key = kb
                    match keys.get(&key) {
                        Some(x) { b = x }
                        None {
                            b = len(buckets)
                            keys.put(key, b)
                            append(mut &buckets, [])
                            append(mut &mixed, false)
                            append(mut &single, Val.Null)
                        }
                    }
                }
                if lv.resNot {
                    let rv = &r[lv.resCol]
                    if !lexdb_ops.isNull(&rv) {
                        if lexdb_ops.isNull(&single[b]) {
                            single[b] = rv.clone()
                        } else {
                            match lexdb_ops.compare(&single[b], &rv) {
                                Ok(c) { if c != 0 { mixed[b] = true } }
                                Err(_) {}
                            }
                        }
                    }
                }
                // a "<>" summary is all a probe reads: no candidate row
                // to keep (q21's 6M)
                if !lv.resNot {
                    append(mut &buckets[b], len(mat))
                    append(mut &mat, r)
                }
                rs.cnt[k].kept += 1
            }
        }
        if keepsRight(q.levels[k].join) { rs.seen[k] = array(len(mat), false) }
        m.mat[k] = mat
        m.keys[k] = keys
        m.ikeys[k] = ikeys
        m.buckets[k] = buckets
        m.resMixed[k] = mixed
        m.resSingle[k] = single
    }
    return Ok(Unit{})
}

// Places a candidate row of level k in the joined row and goes on to the
// next level if it joins: -1 stop, 0 it does not join, 1 it joined.
fn tryRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, k: int, r: &[]Val, ri: int,
          row: mut &[]Val, params: &[]Val, emit: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr], rs: mut &Run): Result[int, DbErr] {
    try rs.bud.tick()
    let lv = &q.levels[k]
    for i in 0..len(r) { row[lv.first + i] = r[i].clone() }
    rs.cnt[k].read += 1
    if !(try allTrueC(st, txn, q, m, &lv.cond, (if len(m.cc) > 0 { &m.cc[k] } else { &q.cc[k] }), row, params, rs)) { return Ok(0) }
    rs.cnt[k].joined += 1
    if ri >= 0 && len(rs.seen[k]) > 0 { rs.seen[k][ri] = true }
    if !(try allTrueC(st, txn, q, m, &lv.post, (if len(m.cp) > 0 { &m.cp[k] } else { &q.cp[k] }), row, params, rs)) { return Ok(1) }
    if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(-1) }
    return Ok(1)
}

// The index-to-scan switch (optimizer 19) is decided by counting, before any row is
// read. An index entry costs about two reads (the entry, then its row by
// primary key) and a scanned row one, so a scan is cheaper when the range
// holds more than half the table. A range of at most SWITCH_ENTRIES entries
// always takes the index (its keys are kept, so it is read once). A longer one
// is counted up to n entries and the table up to 2n rows, n doubling, until one
// of them ends; when the range ends first, the table is counted up to twice
// the range. So a scan is chosen exactly when the table has at most twice the
// range's entries, and the counting costs a small multiple of the path chosen.
// The table is counted a leaf at a time. No statistics are needed.
const SWITCH_ENTRIES: int = 1024

// The cost mode's switch: an index range's entry and the row it fetches cost
// about 16 scanned rows when both are read in batches (optimizer 45), so a
// scan is cheaper when the table has at most 16 times the range's entries
// (a range over about a sixteenth of the table). The plan decides a pure
// range's path from ANALYZE's samples (choosePath); this counted check is
// for a range they do not estimate. COST_IX_ROW (49) is the row-by-row
// measure; switching at 1/49 read the whole table for every date range, and
// a flat quarter kept q6's 15% lineitem range on an index 2.2x slower than
// the scan.
const SWITCH_ENTRIES_COST: int = 64
const SWITCH_TIMES: int = 16

// The table's rows at most for a scan in place of a range of n entries.
fn switchMost(rules: bool, n: int): int {
    if rules { return 2 * n }
    return SWITCH_TIMES * n
}

// 0: the index, keys holding its range's primary keys (the range ended within
// SWITCH_ENTRIES, so it is read once); 2: the index, its range read again;
// 1: a scan.
fn indexOrScan(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, p: &Path, sc: &Scan,
               keys: mut &[]str, decided: bool): Result[int, DbErr] {
    let start = if txn.sql.rules { SWITCH_ENTRIES } else { SWITCH_ENTRIES_COST }
    var lim = start
    var cur = lexdb_access.newCursor()
    var n = 0
    var got: []str = []
    while true {
        let first = lim == start
        let more = try lexdb_access.countEntries(st, txn, &lexdb_catalog.relOf(t), p.index, sc, mut &cur, mut &n, lim, first, mut &got)
        if !more {
            if first {
                // a short range: the index, unless (cost mode) the table is
                // smaller than r times it
                if decided {
                    for x in move(got) { append(keys, x) }
                    return Ok(0)
                }
                if !txn.sql.rules && n > 0 && try countRows(st, txn, t, switchMost(false, n)) <= switchMost(false, n) { return Ok(1) }
                for x in move(got) { append(keys, x) }
                return Ok(0)
            }
            // the range has n entries: a scan if the table has at most switchMost rows
            let most = switchMost(txn.sql.rules, n)
            if try countRows(st, txn, t, most) <= most { return Ok(1) }
            return Ok(2)
        }
        // the planner chose this range from its samples: no count
        if decided { return Ok(2) }
        let most = switchMost(txn.sql.rules, lim)
        if try countRows(st, txn, t, most) <= most { return Ok(1) }
        lim = lim * 2
    }
    return Ok(2)
}

// optimizer 19's switch for the first level's index range (scans, one), as
// runLevel's comment says when it applies, decided once a run (Run.sw) for
// the batches (bLevelPlan) and the row path alike: 1 a scan (counted as
// switched), 0 the index with keys its range's primary keys (read once:
// the row path reads them), 2 the index; -1 it does not apply.
fn firstSwitch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, scans: &[]Scan, rs: mut &Run, keys: mut &[]str): Result[int, DbErr] {
    let lv = &q.levels[0]
    if lv.keeps || lv.stops || rs.writes || txn.noting() || len(q.refs) > 0 || (q.corr && pathCorr(&lv.path)) || len(scans) != 1 ||
       lv.path.index < 0 || len(lv.path.ins) > 0 || lv.path.inSub >= 0 || len(lv.path.inArr) > 0 || scans[0].point || scans[0].empty ||
       scans[0].whole || ixCovers(lv, lv.path.index) { return Ok(-1) }
    if rs.sw < 0 || !lexdb_access.sameRange(&rs.swScan, &scans[0]) {
        var got: []str = []
        rs.sw = try indexOrScan(st, txn, &lv.t, &lv.path, &scans[0], mut &got, lv.path.stats)
        rs.swKeys = got
        rs.swScan = scans[0].copy()
    }
    if rs.sw == 1 { rs.cnt[0].switched = if txn.sql.rules { 1 } else { 2 } }
    if rs.sw == 0 { for x in rs.swKeys { append(keys, x.clone()) } }
    return Ok(rs.sw)
}

// Joins the rows of level k on to the joined row (levels before k filled),
// calling emit for each complete row; false: emit asked to stop.
fn runLevel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, k: int, row: mut &[]Val,
            params: &[]Val, emit: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr], rs: mut &Run): Result[bool, DbErr] {
    if k == len(q.levels) { return emit(txn, row) }
    let sqe = seqEnv(st, txn)               // (not for the row emitted: a handle and a zone's copy per row, 9.99)
    let lv = &q.levels[k]
    var matched = false
    rs.cnt[k].starts += 1
    // the first level scanned in batches (9.52), or -1
    let bl = if k == 0 { try batchLevel(st, txn, q, m, row, params, emit, rs, mut &matched) } else { -1 }
    if bl == 1 { return Ok(false) }
    if bl == 0 {
        // done: its rows went on
    } else if !lv.perRow {
        let useFast = semiIntKey(lv)
        var fastKey = 0
        var hasKey = false
        var kb = ""
        var nul = false
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            if useFast {
                // its one integer key by value, as materialize held it
                match try keyVal(try eval(&lv.hashVals[0], &env), &boundType(&lv.t.cols[lv.hashCols[0]].typ), &txn.sql.zone) {
                    Some(v) {
                        match v {
                            Val.Int(x) { fastKey = x; hasKey = true }
                            else { nul = true }
                        }
                    }
                    None { nul = true }
                }
            } else {
                for i in 0..len(lv.hashCols) {
                    if lv.virt() {
                        let v = try eval(&lv.hashVals[i], &env)
                        if lexdb_ops.isNull(&v) { nul = true }
                        lexdb_pipe.keyPart(mut &kb, &v)
                    } else {
                        // of the column's type for its bounds: a value it cannot
                        // hold matches no row (optimizer 26 review)
                        match try keyVal(try eval(&lv.hashVals[i], &env), &boundType(&lv.t.cols[lv.hashCols[i]].typ), &txn.sql.zone) {
                            Some(v) {
                                if lexdb_ops.isNull(&v) { nul = true }
                                lexdb_access.encIdxPart(mut &kb, &v)
                            }
                            None { nul = true }
                        }
                    }
                }
            }
        }
        var b = -1
        if useFast {
            if hasKey {
                match m.ikeys[k].get(&fastKey) { Some(x) { b = x } None {} }
            }
        } else if !nul {
            match m.keys[k].get(&kb) { Some(x) { b = x } None {} }
        }
        if lv.resNot {
            // "inner <> outer": the bucket's mixed/single value is enough
            var hit = false
            if b >= 0 {
                let noAggs: []Val = []
                let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
                let ov = try eval(&lv.resVal, &env)
                if !lexdb_ops.isNull(&ov) {
                    hit = m.resMixed[k][b]
                    let sm = &m.resSingle[k][b]
                    if !hit && !lexdb_ops.isNull(&sm) {
                        let c = try lexdb_ops.compare(&sm, &ov)
                        if c != 0 { hit = true }
                    }
                }
            }
            rs.cnt[k].read += 1
            // joined: the rows that found one (an anti join's are
            // dropped), as bJoinTail counts them
            if hit { rs.cnt[k].joined += 1 }
            if lv.anti {
                if hit { return Ok(true) }
            } else {
                if !hit { return Ok(true) }
            }
            if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(false) }
            return Ok(true)
        }
        if lv.anti {
            // a NOT EXISTS/IN: a matching candidate drops the row; none
            // goes on once, without the level's (hidden) columns
            var found = false
            if b >= 0 {
                for ri in m.buckets[k][b] {
                    let r = &m.mat[k][ri]
                    for i in 0..len(r) { row[lv.first + i] = r[i].clone() }
                    rs.cnt[k].read += 1
                    if try allTrueC(st, txn, q, m, &lv.cond, (if len(m.cc) > 0 { &m.cc[k] } else { &q.cc[k] }), row, params, rs) { found = true; break }
                }
            }
            if found {
                rs.cnt[k].joined += 1
                return Ok(true)
            }
            if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(false) }
            return Ok(true)
        }
        if b >= 0 {
            for ri in m.buckets[k][b] {
                let got = try tryRow(st, txn, q, m, k, &m.mat[k][ri], ri, row, params, emit, rs)
                if got < 0 { return Ok(false) }
                if got > 0 {
                    matched = true
                    // a semi-join: the row goes on once (9.104)
                    if lv.semi { break }
                }
            }
        }
    } else if lv.semiSub >= 0 {
        // a semi/anti join looked up per row (semiLook): its path's rows
        // for this row until one passes its filters
        var scans: []Scan = []
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            scans = try pathScans(&lv.t, &lv.path, &env)
        }
        var found = false
        for sc in scans {
            var cur = lexdb_access.newCursor()
            while !cur.done && !found {
                var batch: [][]Val = []
                try fetch(st, txn, &lv.t, &lv.path, &sc, &lv.need, mut &cur, mut &batch)
                for r in batch {
                    try rs.bud.tick()
                    for i in 0..len(r) { row[lv.first + i] = r[i].clone() }
                    rs.cnt[k].read += 1
                    if try allTrueC(st, txn, q, m, &lv.cond, (if len(m.cc) > 0 { &m.cc[k] } else { &q.cc[k] }), row, params, rs) {
                        found = true
                        break
                    }
                }
            }
            if found { break }
        }
        // its columns are hidden: NULL as an anti join's batches give them;
        // joined: the rows that found one (an anti join's are dropped), as
        // bJoinTail counts them
        for i in 0..len(lv.t.cols) { row[lv.first + i] = Val.Null }
        if found { rs.cnt[k].joined += 1 }
        if found != lv.anti {
            if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(false) }
        }
        return Ok(true)
    } else if lv.lateral {
        // its subquery with this row's values, its rows kept per values
        let i = lv.src
        var refVals: []Val = []
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            for x in q.subs[i].sel.q.refs { append(mut &refVals, try eval(&x, &env)) }
        }
        let key = valsKey(&refVals)
        var at = -1
        match rs.memo[i].get(&key) {
            Some(n) { at = n }
            None {}
        }
        var rows: [][]Val = []
        if at >= 0 {
            rs.stats[i].hits += 1
            rows = replace(mut &rs.memoRes[i][at].data, [])
        } else {
            var ps: []Val = []
            for j in 0..q.base { append(mut &ps, params[j].clone()) }
            for v in move(refVals) { append(mut &ps, v) }
            var res = try runChild(st, txn, &q.subs[i].sel, &ps, -1, rs, i)
            rows = replace(mut &res.rows, [])
            if len(rs.memoRes[i]) < MEMO_MAX {
                try rs.bud.hold(lexdb_pipe.rowsBytes(&rows) + len(key) + 48)
                at = len(rs.memoRes[i])
                rs.memo[i].put(key, at)
                append(mut &rs.memoRes[i], emptyRes())
            }
        }
        for r in rows {
            let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
            if got < 0 { return Ok(false) }
            if got > 0 { matched = true }
        }
        if at >= 0 { rs.memoRes[i][at].data = rows }
    } else if lv.virt() && lv.src >= 0 && m.subs[lv.src].series {
        // generate_series, made as it is read (lazySeries); as execSrf's.
        // The query's only level with no conditions: each value straight to
        // emit, counted as tryRow counts it (9.100)
        let sr = &m.subs[lv.src]
        let direct = len(q.levels) == 1 && len(lv.cond) == 0 && len(lv.post) == 0 && !sr.sOrdin
        if len(sr.vals) == 3 && direct {
            let ty = lexdb_sql.oidType(sr.sOid)
            let dir = try lexdb_ops.compare(&sr.vals[2], &(try lexdb_ops.coerce(Val.Int(0), &ty)))
            var v = sr.vals[0].clone()
            while true {
                let c = try lexdb_ops.compare(&v, &sr.vals[1])
                if (dir > 0 && c > 0) || (dir < 0 && c < 0) { break }
                try rs.bud.tick()
                rs.cnt[k].read += 1
                rs.cnt[k].joined += 1
                row[lv.first] = v.clone()
                matched = true
                if !(try emit(txn, row)) { return Ok(false) }
                match lexdb_ops.arithZ(lexdb_ops.OP_ADD, &v, &sr.vals[2], &txn.sql.zone) {
                    Ok(x) { v = x }
                    Err(_) { break }
                }
                match lexdb_ops.coerce(replace(mut &v, Val.Null), &ty) {
                    Ok(x) { v = x }
                    Err(_) { break }
                }
            }
        } else if len(sr.vals) == 3 {
            let ty = lexdb_sql.oidType(sr.sOid)
            let dir = try lexdb_ops.compare(&sr.vals[2], &(try lexdb_ops.coerce(Val.Int(0), &ty)))
            var v = sr.vals[0].clone()
            var n = 0
            while true {
                let c = try lexdb_ops.compare(&v, &sr.vals[1])
                if (dir > 0 && c > 0) || (dir < 0 && c < 0) { break }
                n += 1
                var r: []Val = [v.clone()]
                if sr.sOrdin { append(mut &r, Val.Int(n)) }
                let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
                if got < 0 { return Ok(false) }
                if got > 0 { matched = true }
                // the next value; past the type's range: the end
                match lexdb_ops.arithZ(lexdb_ops.OP_ADD, &v, &sr.vals[2], &txn.sql.zone) {
                    Ok(x) { v = x }
                    Err(_) { break }
                }
                match lexdb_ops.coerce(replace(mut &v, Val.Null), &ty) {
                    Ok(x) { v = x }
                    Err(_) { break }
                }
            }
        }
    } else if lv.virt() {
        for r in m.vrows[k] {
            let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
            if got < 0 { return Ok(false) }
            if got > 0 { matched = true }
        }
    } else {
        var scans: []Scan = []
        {
            let noAggs: []Val = []
            let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            if q.corr && pathCorr(&lv.path) {
                let cur = try pathCur(st, txn, q, &lv.path, &env, rs)
                let env2 = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &cur, seq: &sqe}
                scans = try pathScans(&lv.t, &lv.path, &env2)
            } else {
                scans = try pathScans(&lv.t, &lv.path, &env)
            }
        }
        // optimizer 19: the first table's index range may be run as a scan, decided by
        // counting before any row is read (indexOrScan), so nothing returned
        // needs skipping. Not for:
        // - a path chosen for its order (ORDER BY, MIN/MAX);
        // - a query run once per outer row (a correlated subquery, LATERAL):
        //   a scan there would be paid per row;
        // - a reading that may stop early (LIMIT, EXISTS): the counting could
        //   cost more than the rows it needs;
        // - a write, or any transaction whose reads are noted (a block that may
        //   write, an autocommit INSERT ... SELECT): a scan's read is the whole
        //   table, checked at commit, so it would conflict with every write to
        //   the table.
        // - an index read alone (9.107): it costs no more than a scan.
        var keys: []str = []
        var byKeys = false
        // a batched DELETE or UPDATE's next batch (stage 8): the primary key scan goes on after the last key done
        if k == 0 && len(rs.after) > 0 && lv.path.index < 0 { scans = lexdb_access.afterScans(&scans, &rs.after) }
        if k == 0 {
            let how = try firstSwitch(st, txn, q, &scans, rs, mut &keys)
            if how == 1 {
                scans = [lexdb_access.wholeScan()]
            } else if how == 0 {
                byKeys = true
            }
        }
        if byKeys {
            // the range's primary keys, already read: its rows, one by one
            let t = &lv.t
            let rr = lexdb_access.rowRead(&lexdb_catalog.relOf(t), &lv.need)
            for i in 0..len(keys) {
                match try lexdb_access.getRow(st, txn, &lexdb_catalog.relOf(t), &rr, &keys[i]) {
                    Some(r) {
                        let g = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
                        if g < 0 { return Ok(false) }
                        if g > 0 { matched = true }
                    }
                    None { return Err(lexdb_base.corrupt(&("an index entry of \"" + t.name + "\" without its row"))) }
                }
            }
        } else {
            try warmPoints(st, txn, &lv.t, &scans)
            for sc in scans {
                var cur = lexdb_access.newCursor()
                while !cur.done {
                    var batch: [][]Val = []
                    try fetch(st, txn, &lv.t, &lv.path, &sc, &lv.need, mut &cur, mut &batch)
                    for r in batch {
                        let got = try tryRow(st, txn, q, m, k, &r, -1, row, params, emit, rs)
                        if got < 0 { return Ok(false) }
                        if got > 0 { matched = true }
                    }
                }
            }
        }
    }
    if keepsLeft(lv.join) && !matched {
        for i in 0..len(lv.t.cols) { row[lv.first + i] = Val.Null }
        rs.cnt[k].nulls += 1
        if try allTrueX(st, txn, q, m, &lv.post, row, params, rs) {
            if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(false) }
        }
    }
    return Ok(true)
}

// Calls emit on each row of the query (materialize first).
fn runQuery(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val,
            emit: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr], rs: mut &Run): Result[Unit, DbErr] {
    if len(q.levels) == 0 {
        let none: []Val = []
        if try allTrueX(st, txn, q, m, &q.top, &none, params, rs) { let more = try emit(txn, &none) }
        return Ok(Unit{})
    }
    // (its joins the pipeline's, slice P2c; a value or key a batch cannot
    // hold: the row engine, when no row was given yet)
    if rs.batch {
        match q.jp {
            Some(pg) {
                var emitted = 0
                let got = runLevelsProg(st, txn, q, m, params, &pg, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
                    emitted += 1
                    return emit(tx, r)
                }, rs)
                match got {
                    Ok(_) { return Ok(Unit{}) }
                    Err(x) { if !lexdb_pipe.isBat(&x) || emitted > 0 { return Err(x) } }
                }
                // (prepare built no hash for it: the row engine's, with them)
                rs.batch = false
                let m2 = try prepareIn(st, txn, q, params, rs, true, true)
                rs.batch = true
                var row2: []Val = array(len(q.cols), Val.Null)
                return runRows(st, txn, q, &m2, params, mut &row2, emit, rs)
            }
            None {}
        }
    }
    var row: []Val = array(len(q.cols), Val.Null)
    return runRows(st, txn, q, m, params, mut &row, emit, rs)
}

// runQuery's row engine: the levels from the first, then a RIGHT or FULL
// JOIN's rows that joined nothing.
fn runRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val, row: mut &[]Val,
           emit: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr], rs: mut &Run): Result[Unit, DbErr] {
    if !(try runLevel(st, txn, q, m, 0, row, params, emit, rs)) { return Ok(Unit{}) }
    // A RIGHT or FULL JOIN's rows that joined nothing, with NULLs for the
    // tables before it, go on through the tables after it.
    for k in 1..len(q.levels) {
        let lv = &q.levels[k]
        if !keepsRight(lv.join) { continue }
        for ri in 0..len(m.mat[k]) {
            if rs.seen[k][ri] { continue }
            for i in 0..len(row) { row[i] = Val.Null }
            for i in 0..len(m.mat[k][ri]) { row[lv.first + i] = m.mat[k][ri][i].clone() }
            rs.cnt[k].unmatched += 1
            if try allTrueX(st, txn, q, m, &lv.post, &row, params, rs) {
                if !(try runLevel(st, txn, q, m, k + 1, row, params, emit, rs)) { return Ok(Unit{}) }
            }
        }
    }
    return Ok(Unit{})
}

// ---- subqueries (design 9.8)
//
// A statement's subqueries are planned with it, each inside the query it is
// in. A name not among a query's own columns is looked for in the queries
// around it, nearest first, and becomes a parameter after the statement's
// own: the query it is in supplies its value (its "refs"), and a query in
// between passes it down. A subquery with no refs is run once per
// execution, before the query; one with refs is run for each row that needs
// it, its result kept per value of its refs.

const MEMO_MAX = 10000          // results kept per correlated subquery

type SubPlan = record {
    use: int                    // lexdb_sql.SUB_SCALAR, SUB_EXISTS, SUB_IN
    sel: Sel
    oid: int                    // its column's type
    name: str                   // its column's name, as an output column
    hashed: bool                // correlated, run once into a hash: sel outputs the key (then IN's value, a scalar's aggregate)
    keyOuter: []Expr            // per key column: what it equals, of outer values only (refs as parameters)
    keyText: []str              // EXPLAIN: "inner = outer"
    cte: int                    // a CTE's use: the CTE's number (its rows shared); -1
    kind: int                   // IN: the collation kind its values are compared under (L2)
    semi: bool                  // a semi-join's (9.104): run once, its rows a level's (Level.semi)
    res: []Expr                 // correlated filters that are not keys (q21's l_suppkey <> outer), run once
    resText: []str              // ... their text, the outer values by name (EXPLAIN)
    readAs: int                 // IN: the type its values are read as, as = reads a text beside a value of that type; 0 as they are
}

// A subquery's result: a scalar's value, how many rows, IN's values.
type SubRes = record {
    v: lexdb_pipe.SubVal        // its rows, a scalar's value, IN's set: what a plan reads of it
    cls: int                    // IN: the values' class (lexdb_pipe.inClass), all the same; -1 mixed, -2 none
    groups: Map[str, int]       // hashed: key -> 1 rows, 3 rows and a NULL value (IN)
    data: [][]Val               // in FROM: its rows
    vals: []Val                 // IN: its distinct values not NULL, all of them (Path.inSub, inMax); a series: start, stop, step ([] none)
    // In FROM, an integer generate_series the first level reads: its rows
    // made as they are read (runLevel), not held (lazySeries). Its type
    // and WITH ORDINALITY.
    series: bool
    sOid: int
    sOrdin: bool
}

fn emptyRes(): SubRes {
    return SubRes{v: lexdb_pipe.noSubVal(), cls: -2, groups: newMap(), data: [], vals: [],
                  series: false, sOid: 0, sOrdin: false}
}

// Whether subquery i of q, in FROM, is an integer generate_series read by
// q's first level only, as a series made as it is read: nothing reads it
// again (a hash join's or a second scan's rows are held), and its values
// do not depend on the row.
fn lazySeries(q: &Query, i: int): bool {
    let sp = &q.subs[i]
    if sp.use != lexdb_sql.SUB_FROM || sp.sel.srf != "generate_series" || sp.cte >= 0 || len(sp.sel.q.refs) > 0 || len(sp.sel.outs) == 0 { return false }
    if lexdb_sql.oidType(sp.sel.outs[0].oid).kind != lexdb_sql.K_INT { return false }
    if len(q.levels) == 0 || q.levels[0].src != i || q.levels[0].lateral { return false }
    for k in 1..len(q.levels) { if q.levels[k].src == i { return false } }
    return true
}

// A lazy series' arguments (lazySeries), as execSrf takes them: start,
// stop and step in the series' type; none (no rows) if one is NULL.
fn seriesRes(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, rs: mut &Run): Result[SubRes, DbErr] {
    let sel = &sp.sel
    let sqe = seqEnv(st, txn)
    let m = try prepare(st, txn, &sel.q, params, rs)
    let noRow: []Val = []
    let env = Env{cols: &sel.q.cols, row: &noRow, aggs: &noRow, params: params, subs: &m.subs, cur: &noRow, seq: &sqe}
    var args: []Val = []
    for x in sel.exprs { append(mut &args, try evalX(st, txn, &sel.q, &x, &env, rs)) }
    var out = emptyRes()
    out.series = true
    out.sOid = sel.outs[0].oid
    out.sOrdin = sel.ordin
    for a in args { if lexdb_ops.isNull(&a) { return Ok(out) } }
    let ty = lexdb_sql.oidType(out.sOid)
    let start = try lexdb_ops.coerceZ(replace(mut &args[0], Val.Null), &ty, &txn.sql.zone)
    let stop = try lexdb_ops.coerceZ(replace(mut &args[1], Val.Null), &ty, &txn.sql.zone)
    let step = if len(args) > 2 { try lexdb_ops.coerceZ(replace(mut &args[2], Val.Null), &ty, &txn.sql.zone) } else { try lexdb_ops.coerce(Val.Int(1), &ty) }
    if try lexdb_ops.compare(&step, &(try lexdb_ops.coerce(Val.Int(0), &ty))) == 0 { return Err(e("22023", "step size cannot equal zero")) }
    out.vals = [start, stop, step]
    return Ok(out)
}

type Frame = lexdb_bind.Frame
type Names = lexdb_bind.Names

pub type Scope = record {
    names: Names
    works: []Work               // the working tables of recursive CTEs being planned
    // privileges (9.83): the roles a view's query is checked as (its
    // owner's, innermost last; none: the session's), the role checks so
    // far, and an UPDATE's or DELETE's target, checked by its statement
    asRole: []str
    whos: []Who
    target: str
    looks: []Look               // the planning's looks at parameters' values (optimizer 22)
    // the next query planned may stop reading early (a LIMIT without a sort,
    // EXISTS, a scalar subquery): its join order keeps lookups (optimizer 26
    // review). Set by planSub and planSelect, taken by buildQuery.
    early: bool
    // the next query planned locks rows (FOR UPDATE and the like, applied
    // after it is planned): its tables keep FROM's order and join methods
    // that keep it. Set by planSelect, taken by buildQuery.
    locking: bool
    // the next query's ORDER BY when it has a LIMIT (and no grouping or
    // window), and its LIMIT plus OFFSET (a parameter's taken as 100);
    // -1: none. The join order may read the table ordered by them first
    // and stop early (optimizer 32). Set by planSelect, taken by buildQuery.
    ordBy: []lexdb_sql.OrderItem
    ordLim: int
    // the next query planned may not use its outer values as a path's keys
    // (a semi-join's subquery planned to be hashed, 9.104). Set by
    // buildQuery for a subquery, taken by the subquery's buildQuery.
    noRefKeys: bool
    // the next SELECT planned is a statement's own, whose logical plan
    // nothing reads (select runs the Sel): its Sel.lp is not built (a point
    // select's planning cost). Set by select, taken by planSelect.
    noLp: bool
    // the renames (Table.rn) of the view whose query is being planned: its text's names are what they became
    rn: []str
}

type Work = record { id: int; cols: []lexdb_sql.ColDef }

// SELECT on relation key, for a query being planned: as its view's owner,
// or the session's role (9.83).
fn scCheck(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: mut &Scope, key: &str, kind: &str): Result[Unit, DbErr] {
    let actAs = if len(sc.asRole) > 0 { sc.asRole[len(sc.asRole) - 1].clone() } else { currentRole(st, txn.sql.sess) }
    var at = -1
    for i in 0..len(sc.whos) { if sc.whos[i].name == actAs { at = i } }
    if at < 0 {
        append(mut &sc.whos, try whoIs(st, txn, &actAs))
        at = len(sc.whos) - 1
    }
    if sc.whos[at].super { return Ok(Unit{}) }
    let w = Who{name: sc.whos[at].name.clone(), super: false, roles: collections.copyOf(&sc.whos[at].roles)}
    return needRel(st, txn, &w, key, &"r", kind)
}

// A constant cast to t as resolve converts it (lexdb_bind.Names.constCast):
// castVal with no session.
fn constLit(v: Val, t: &lexdb_sql.TypeName): Result[Val, DbErr] {
    let none: Option[SeqEnv] = None
    return castVal(v, t, &none)
}

fn newScope(params: &[]Val, ptypes: &[]int): Scope {
    var pt: []int = []
    for i in 0..len(params) { append(mut &pt, if i < len(ptypes) { ptypes[i] } else { 0 }) }
    return Scope{names: Names{frames: [], base: len(params), ptypes: pt, coll: "", ty: typing(), blank: lexdb_syscat.tsqlBlank, constCast: constLit, colScale: typScale, outScale: exprScale}, works: [], asRole: [], whos: [], target: "", looks: [], early: false, locking: false, ordBy: [], ordLim: -1, noRefKeys: false, noLp: false, rn: []}
}

// newScope for a statement of txn's session: its default collation (L2).
fn newScopeIn(st: &lexdb_store.Store, txn: &lexdb_store.Txn, params: &[]Val, ptypes: &[]int): Scope {
    var sc = newScope(params, ptypes)
    sc.names.coll = sessColl(st, txn.sql.sess)
    return sc
}

fn collKey(sess: int): str { return "\x00coll\x00" + sess.toStr() }

// A session's default collation (L2): "" exact, PostgreSQL's; a TDS
// session's SQL Server's (lexdb_tds sets it).
fn sessColl(st: &lexdb_store.Store, sess: int): str { return st.memo.get(&collKey(sess)).unwrapOr("") }

fn identKey(sess: int): str { return "\x00idins\x00" + sess.toStr() }

// The table SET IDENTITY_INSERT is ON for in a session (its name, folded),
// "" none.
fn identityInsertOf(st: &lexdb_store.Store, sess: int): str { return st.memo.get(&identKey(sess)).unwrapOr("") }

pub fn (s: &Session) setIdentityInsert(table: &str) {
    if len(table) == 0 { s.st.memo.del(&identKey(s.id)) } else { s.st.memo.put(&identKey(s.id), table) }
}

// The session's last identity (or sequence) value: @@IDENTITY.
pub fn (s: &Session) lastIdentity(): Option[int] {
    match s.st.memo.get(&lastKey(s.id)) {
        Some(v) { return Some(lexdb_base.num(&v)) }
        None { return None }
    }
}

pub fn (s: &Session) setCollation(name: &str) {
    if len(name) == 0 { s.st.memo.del(&collKey(s.id)) } else { s.st.memo.put(&collKey(s.id), name) }
}

// A time type's fractional seconds where it says them (prec 1), else -1.
// Or SQL Server's type, where a T-SQL type name said it (lexdb_parse.tsqlCode),
// as lexdb_syscat.hint: it and the length (lexdb_tds sends tinyint,
// varchar, char, datetime, ... as SQL Server would).
fn typScale(t: &lexdb_sql.TypeName): int {
    let code = lexdb_parse.tsqlCode(t)
    if code > 0 { return lexdb_syscat.hint(code, if code == lexdb_syscat.TS_DATETIME || code == lexdb_syscat.TS_SMALLDATETIME { 0 } else { t.len }) }
    if t.kind == lexdb_sql.K_NUM && t.len == lexdb_syscat.TS_NUMERIC { return lexdb_syscat.hint(lexdb_syscat.TS_NUMERIC, 0) }
    if lexdb_sql.isTimeKind(t.kind) && t.prec >= 1 { return t.scale }
    return oraDecl(t)
}

// The declared type of a column, for Oracle's DESCRIBE (design/lexdb-oracle.md, O5):
// OutCol.scale holds -2 - (tag | a << 8 | b << 24) for tag ORA_VARCHAR (a the length),
// ORA_NUMBER (a the precision, b the scale), ORA_CLOB, ORA_BLOB; -1 where none.
pub const ORA_VARCHAR = 1
pub const ORA_NUMBER = 2
pub const ORA_CLOB = 3
pub const ORA_BLOB = 4

fn oraDecl(t: &lexdb_sql.TypeName): int {
    if t.kind == lexdb_sql.K_TEXT && t.prec == 1 { return -2 - ORA_CLOB }
    if t.kind == lexdb_sql.K_BYTEA && t.prec == 1 { return -2 - ORA_BLOB }
    if t.kind == lexdb_sql.K_TEXT && t.oid == lexdb_sql.OID_VARCHAR && t.len > 0 && t.prec < 34 { return -2 - (ORA_VARCHAR | (t.len << 8)) }
    if t.kind == lexdb_sql.K_NUM && t.prec > 0 && t.len != lexdb_syscat.TS_NUMERIC { return -2 - (ORA_NUMBER | (t.prec << 8) | (t.scale << 24)) }
    return -1
}

// The parts of a declared type in OutCol.scale: tag (0 none), a, b.
pub fn declTag(scale: int): int { return if scale <= -3 { (-2 - scale) & 0xff } else { 0 } }
pub fn declA(scale: int): int { return if scale <= -3 { ((-2 - scale) >> 8) & 0xffff } else { 0 } }
pub fn declB(scale: int): int { return if scale <= -3 { ((-2 - scale) >> 24) & 0xff } else { 0 } }

// A query's output column as a column of the query reading it (a subquery
// in FROM, a catalog relation, a view): its type, with SQL Server's type
// where it carries one (typScale).
fn outType(o: &OutCol): lexdb_sql.TypeName {
    var t = lexdb_sql.oidType(o.oid)
    let code = lexdb_syscat.hintCode(o.scale)
    if code > 0 && (t.kind == lexdb_sql.K_TEXT || t.kind == lexdb_sql.K_INT || t.kind == lexdb_sql.K_BYTEA) {
        t.prec = code
        t.len = lexdb_syscat.hintLen(o.scale)
    }
    if code == lexdb_syscat.TS_NUMERIC && t.kind == lexdb_sql.K_NUM { t.len = code }
    // a time column's fractional digits (an Oracle DATE has none, a TIMESTAMP 1 to 9)
    if code == 0 && lexdb_sql.isTimeKind(t.kind) && t.oid == lexdb_sql.OID_TS && o.scale >= 0 && o.scale <= 9 {
        t.prec = 1
        t.scale = o.scale
    }
    if code > 0 && lexdb_sql.isTimeKind(t.kind) {
        t.prec = code
        t.scale = if code == lexdb_syscat.TS_DATETIME { 3 } else { 0 }
    }
    return t
}

// An expression's, where a cast or a column says them.
fn exprScale(x: &Expr, cols: &[]lexdb_sql.ColDef): int {
    match x {
        Expr.Cast(_, t) { return typScale(&t) }
        // T-SQL's ISNULL and IIF, and DATABASEPROPERTYEX's CASE: the value's
        // a bare NULL: SQL Server's int
        Expr.Lit(v) { return if lexdb_ops.isNull(&v) { lexdb_syscat.hint(lexdb_syscat.TS_INT, 0) } else { -1 } }
        Expr.Call(f, args, _) {
            if f == "coalesce" && len(args) > 0 { return exprScale(&args[0], cols) }
            // Oracle's DATE: a time to the second
            if f == "#ora_todate" || f == "#ora_addmonths" || f == "#ora_lastday" || f == "#ora_nextday" { return 0 }
            if (f == "#ora_add" || f == "#ora_sub" || f == "#ora_trunc") && len(args) > 0 && exprScale(&args[0], cols) == 0 { return 0 }
            if f == "date_trunc" && len(args) == 2 {
                match args[0] {
                    Expr.Lit(v) {
                        match v {
                            Val.Text(u) { if u == "second" { return 0 } }
                            else {}
                        }
                    }
                    else {}
                }
            }
            if f == "case else" && len(args) == 3 { return exprScale(&args[2], cols) }
            return -1
        }
        Expr.Col(n, _) {
            for c in cols { if c.name == n { return typScale(&c.typ) } }
            return -1
        }
        else { return -1 }
    }
}

// The query being planned is done: its refs are what the query around it
// must supply.
fn endScope(sc: mut &Scope, q: mut &Query) {
    var f = pop(mut &sc.names.frames)
    q.refs = replace(mut &f.refs, [])
    for i in 0..len(f.subKinds) { if i < len(q.subs) { q.subs[i].kind = f.subKinds[i] } }
    for i in 0..len(f.subReads) { if i < len(q.subs) { q.subs[i].readAs = f.subReads[i] } }
}

// A view's plan, or its error: Oracle says a view whose query no longer plans (a table or a column it names was renamed or
// dropped) has errors (ORA-04063).
fn viewPlanned(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, planning: Result[SubPlan, DbErr]): Result[SubPlan, DbErr] {
    match planning {
        Ok(x) { return Ok(x) }
        Err(pe) {
            let ora = strings.startsWith(&t.view, lexdb_sql.ORA_VIEW)
            let gone = pe.state == "42P01" || pe.state == "42703"
            if ora && gone {
                let owner = if lexdb_sql.isQual(&t.name) { lexdb_sql.schemaOf(&t.name) } else { currentRole(st, txn.sql.sess) }
                return Err(e("ORA04063", &("view \"" + strings.toUpperAscii(&owner) + "." + strings.toUpperAscii(&lexdb_sql.baseName(&t.name)) + "\" has errors")))
            }
            return Err(pe)
        }
    }
}

fn planSub(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val,
           sc: mut &Scope, res: bool): Result[SubPlan, DbErr] {
    // EXISTS stops at its first row; a scalar subquery at its second, unless
    // it aggregates, groups or is DISTINCT (then it reads everything:
    // optimizer 33)
    sc.early = s.use == lexdb_sql.SUB_EXISTS || (s.use == lexdb_sql.SUB_SCALAR && !stmtGathers(s))
    var sel = try planSelect(st, txn, s, params, sc)
    if len(s.mr) > 0 {
        try planMatch(st, txn, &s.mr[0], mut &sel, params, sc)
    }
    // EXISTS stops at its first row, a scalar at its second (runSub): its
    // first table's reading may stop early, so no switch to a scan (optimizer 19)
    if len(sel.q.levels) > 0 && (s.use == lexdb_sql.SUB_EXISTS || (s.use == lexdb_sql.SUB_SCALAR && !sel.aggQ)) { sel.q.levels[0].stops = true }
    if len(s.srf) > 0 {
        if strings.startsWith(&s.srf, "#values:") && len(sel.exprs) == len(sel.outs) {
            // an untyped literal or parameter takes its column's type (srfCols)
            let pt = lexdb_bind.ptypesOf(&sc.names)
            let ty = typing()
            let noCols: []lexdb_sql.ColDef = []
            for i in 0..len(sel.outs) { if lexdb_bind.argOid(&sel.exprs[i], &noCols, &pt, &ty) == lexdb_sql.OID_UNKNOWN { sel.outs[i].oid = lexdb_sql.OID_UNKNOWN } }
        }
        sel.outs = try srfCols(&s.srf, s.ordin, &sel.outs)
        // the logical plan: the function or VALUES, its arguments the select list's
        let args = lexdb_sql.cloneAllExpr(&sel.exprs)
        sel.lp = if strings.startsWith(&s.srf, "#values:") { lexdb_bind.LPlan.Values(strings.parseIntOpt(&s.srf[8..len(s.srf)]).unwrapOr(1), args, outBCols(&sel.outs)) }
                 else { lexdb_bind.LPlan.Func(s.srf.toStr(), s.ordin, args, outBCols(&sel.outs)) }
    }
    if s.use == lexdb_sql.SUB_IN && len(sel.outs) != 1 { return Err(e("42601", "subquery has too many columns")) }
    if s.use == lexdb_sql.SUB_SCALAR && len(sel.outs) != 1 { return Err(e("42601", "subquery must return only one column")) }
    let oid = if s.use == lexdb_sql.SUB_EXISTS || len(sel.outs) == 0 { lexdb_sql.OID_BOOL } else { sel.outs[0].oid }
    let name = if s.use == lexdb_sql.SUB_EXISTS { "exists" } else if s.use == lexdb_sql.SUB_SCALAR { sel.outs[0].name.clone() } else { "?column?" }
    // (in FROM: its columns are its outs)
    var sp = SubPlan{use: s.use, sel: sel, oid: oid, name: name, hashed: false, keyOuter: [], keyText: [], cte: s.cte, kind: lexdb_sql.COLL_EXACT, semi: false, res: [], resText: [], readAs: 0}
    // res: a semi-join's alternative (buildQuery), which may keep correlated
    // filters that are not keys as residuals (SubPlan.res) for its level to
    // check. Any other hashed subquery must not: nothing else reads them.
    if len(sp.sel.q.refs) > 0 && s.use != lexdb_sql.SUB_FROM { hashSub(mut &sp, sc.names.base, res) }
    return Ok(sp)
}

// ---- hashed subqueries: a semi-join (EXISTS, IN) or anti-join (NOT ...)
//
// A correlated EXISTS or IN whose outer values are used only in WHERE
// equalities "inner = outer" (outer: of outer values only), none of them a
// lookup's key, is the same
// subquery without them, keyed by their inner sides: it is run once into a
// hash, and each outer row probes it. (With such a key, an index, it stays
// per row: a lookup each.)

fn refOf(x: &Expr, base: int): int {
    match x {
        Expr.Param(n) { if n > base { return n - base - 1 } }
        Expr.Cast(a, _) { return refOf(&a, base) }
        else {}
    }
    return -1
}

fn usesRefs(x: &Expr, base: int): bool {
    match x {
        Expr.Param(n) { return n > base }
        Expr.Unary(_, a) { return usesRefs(&a, base) }
        Expr.Bin(_, a, b) { return usesRefs(&a, base) || usesRefs(&b, base) }
        Expr.IsNull(a, _) { return usesRefs(&a, base) }
        Expr.Cast(a, _) { return usesRefs(&a, base) }
        Expr.Call(_, args, _) {
            for a in args { if usesRefs(&a, base) { return true } }
            return false
        }
        else { return false }
    }
}

type HashKeys = record {
    inner: []Expr
    outer: []Expr
    texts: []str                // the conjuncts taken out, by their text
    res: []Expr                 // a filter that is not a key: outer values stay, the inner row's checked
}

// Of outer values only: no column of the subquery's, no subquery.
fn outerOnly(x: &Expr, base: int): bool {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    return len(ns) == 0 && usesRefs(x, base) && !hasAgg(x) && !hasSubCall(x)
}

fn hasSubCall(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasSubCall(&a) }
        Expr.Bin(_, a, b) { return hasSubCall(&a) || hasSubCall(&b) }
        Expr.IsNull(a, _) { return hasSubCall(&a) }
        Expr.Cast(a, _) { return hasSubCall(&a) }
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) { return true }
            for a in args { if hasSubCall(&a) { return true } }
            return false
        }
        else { return false }
    }
}

// Whether a hashed subquery's key inner = outer compares as = does:
// semiTypes's kinds; one type on both sides, a float's or a char(n)'s
// of one n (padded alike); or an outer value of no known type (a derived
// table's column: an untyped parameter, keyed as before).
fn hashKeyTypes(inner: &Expr, outer: &Expr, cols: &[]lexdb_sql.ColDef): bool {
    match outer {
        Expr.Param(_) { return true }
        else {}
    }
    let io = exprOid(inner, cols, &[])
    let oo = exprOid(outer, cols, &[])
    if semiTypes(io, oo) { return true }
    if io == oo && (io == lexdb_sql.OID_FLOAT4 || io == lexdb_sql.OID_FLOAT8) { return true }
    if io == oo && io == lexdb_sql.OID_BPCHAR {
        let n = lexdb_bind.bpLen(inner, cols)
        return n > 0 && n == lexdb_bind.bpLen(outer, cols)
    }
    return false
}

// A conjunct "inner = outer" (either way round), into hk; false: it uses an
// outer value otherwise.
fn keyConj(c: &Expr, base: int, hk: mut &HashKeys, cols: &[]lexdb_sql.ColDef): bool {
    let t = lexdb_sql.exprText(c)
    for x in hk.texts { if x == t { return true } }
    match c {
        Expr.Bin(op, a, b) {
            if op != "=" { return false }
            var inner = lexdb_sql.cloneExpr(&a)
            var outer = lexdb_sql.cloneExpr(&b)
            if !outerOnly(&outer, base) {
                inner = lexdb_sql.cloneExpr(&b)
                outer = lexdb_sql.cloneExpr(&a)
            }
            if !outerOnly(&outer, base) || usesRefs(&inner, base) || hasCorr(&inner) { return false }
            // a hash compares keys by value (lexdb_pipe.keyPart), which = does only
            // for the same kinds of value (semiTypes): a timestamp with a
            // date, a text with an integer, a float with a numeric compare
            // equal as = converts them, and not as keys. The outer value's
            // type: its column's (outerRef types it)
            if !hashKeyTypes(&inner, &outer, cols) { return false }
            append(mut &hk.inner, inner)
            append(mut &hk.outer, outer)
            append(mut &hk.texts, t)
            return true
        }
        else { return false }
    }
}

fn keyConjs(cs: &[]Expr, base: int, hk: mut &HashKeys, movable: bool, res: bool, cols: &[]lexdb_sql.ColDef): bool {
    for c in cs {
        if !usesRefs(&c, base) { continue }
        if !movable { return false }
        if !keyConj(&c, base, hk, cols) {
            if !res { return false }
            // not inner = outer: a filter the once-run subquery cannot keep
            // (the outer value is a parameter now), checked per candidate
            // row of the key's bucket instead
            if hasAgg(&c) || hasSubCall(&c) { return false }
            append(mut &hk.res, lexdb_sql.cloneExpr(&c))
            append(mut &hk.texts, lexdb_sql.exprText(&c))
        }
    }
    return true
}

fn noRefs(xs: &[]Expr, base: int): bool {
    for x in xs { if usesRefs(&x, base) { return false } }
    return true
}

fn dropTexts(cs: []Expr, texts: &[]str): []Expr {
    var all = cs
    var out: []Expr = []
    for i in 0..len(all) {
        let c = replace(mut &all[i], Expr.Lit(Val.Null))
        let t = lexdb_sql.exprText(&c)
        var drop = false
        for x in texts { if x == t { drop = true } }
        if !drop { append(mut &out, c) }
    }
    return out
}

fn hashSub(sp: mut &SubPlan, base: int, res: bool) {
    var hk = HashKeys{inner: [], outer: [], texts: [], res: []}
    // a scalar subquery: one aggregate row, no GROUP BY, its key's groups
    // then its value per group (9.26)
    let scalar = sp.use == lexdb_sql.SUB_SCALAR
    {
        let sel = &sp.sel
        if sel.setop != 0 || sel.limit >= 0 || sel.offset > 0 || len(sel.groupBy) > 0 { return }
        if scalar {
            if !sel.aggQ || sel.having.isSome() || sel.distinct || len(sel.exprs) != 1 || hasSubCall(&sel.exprs[0]) { return }
        } else if sel.aggQ { return }
        if !noRefs(&sel.exprs, base) || !noRefs(&sel.order, base) { return }
        let q = &sel.q
        for lv in q.levels {
            if !noRefs(&lv.path.eqs, base) || !noRefs(&lv.path.ins, base) || !noRefs(&lv.hashVals, base) { return }
            // a semi or anti join's conditions (a residual on its hidden
            // columns, a lookup level's filters) are its own: a condition
            // on an outer value there is no WHERE conjunct of this query,
            // to be a key or a residual of it
            if lv.semi && (!noRefs(&lv.cond, base) || usesRefs(&lv.resVal, base)) { return }
            for b in lv.path.rng { if usesRefs(&b.val, base) { return } }
            // an outer join's ON conjuncts are not WHERE filters: they stay
            if !keyConjs(&lv.cond, base, mut &hk, !isOuter(lv.join), res, &q.cols) { return }
            if !keyConjs(&lv.post, base, mut &hk, true, res, &q.cols) { return }
            if !keyConjs(&lv.local, base, mut &hk, !isOuter(lv.join), res, &q.cols) { return }
        }
        if !keyConjs(&q.top, base, mut &hk, true, res, &q.cols) { return }
        if len(hk.inner) == 0 { return }
    }
    for k in 0..len(sp.sel.q.levels) {
        sp.sel.q.levels[k].cond = dropTexts(replace(mut &sp.sel.q.levels[k].cond, []), &hk.texts)
        sp.sel.q.levels[k].post = dropTexts(replace(mut &sp.sel.q.levels[k].post, []), &hk.texts)
        sp.sel.q.levels[k].local = dropTexts(replace(mut &sp.sel.q.levels[k].local, []), &hk.texts)
    }
    sp.sel.q.top = dropTexts(replace(mut &sp.sel.q.top, []), &hk.texts)
    // it outputs the key, then IN's value or the scalar's aggregate (grouped
    // by the key)
    var outs: []Expr = []
    for x in hk.inner { append(mut &outs, lexdb_sql.cloneExpr(&x)) }
    if sp.use == lexdb_sql.SUB_IN || scalar { append(mut &outs, lexdb_sql.cloneExpr(&sp.sel.exprs[0])) }
    if scalar {
        var gb: []Expr = []
        for x in hk.inner { append(mut &gb, lexdb_sql.cloneExpr(&x)) }
        sp.sel.groupBy = gb
        sp.sel.first = -1               // per group now: no stopping at the first row
    }
    var texts: []str = []
    for i in 0..len(hk.inner) {
        let r = refOf(&hk.outer[i], base)
        var outer = "an outer expression"
        if r >= 0 {
            outer = match sp.sel.q.refs[r] {
                Expr.Col(n, _) { n.clone() }
                else { "an outer value" }
            }
        }
        let inner = match hk.inner[i] {
            Expr.Col(n, _) { n.clone() }
            else { lexdb_sql.exprText(&hk.inner[i]) }
        }
        append(mut &texts, inner + " = " + outer)
    }
    sp.sel.lp = takeLp(mut &sp.sel)
    sp.sel.exprs = outs
    sp.sel.order = []
    sp.sel.sort = false
    sp.sel.distinct = false
    sp.sel.desc = []
    sp.sel.nullsFirst = []
    sp.hashed = true
    sp.keyOuter = replace(mut &hk.outer, [])
    sp.keyText = texts
    var rt: []str = []
    for x in hk.res { append(mut &rt, lexdb_sql.exprText(&substRefs(&x, base, &sp.sel.q.refs))) }
    sp.resText = rt
    sp.res = replace(mut &hk.res, [])
}

// Runs a hashed subquery once: its keys (a NULL key matches nothing), and
// for IN its values per key.
fn runHashed(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
             i: int): Result[SubRes, DbErr] {
    let sqe = seqEnv(st, txn)
    let res = try runChild(st, txn, &sp.sel, params, -1, parent, i)
    var out = emptyRes()
    out.v.rows = len(res.rows)
    let nk = len(sp.keyOuter)
    if sp.use == lexdb_sql.SUB_SCALAR {
        for r in res.rows {
            var gk = ""
            var nul = false
            for j in 0..nk {
                if lexdb_ops.isNull(&r[j]) { nul = true }
                lexdb_pipe.keyPart(mut &gk, &r[j])
            }
            if nul { continue }
            out.groups.put(gk, len(out.data))
            append(mut &out.data, [r[nk].clone()])
        }
        // a key with no rows: the aggregate over none (count 0, sum NULL)
        var vals: []Val = []
        for spec in sp.sel.specs {
            let a = lexdb_agg.newAccs(1)
            append(mut &vals, try lexdb_agg.finish(&spec, &a[0]))
        }
        let noRow: []Val = array(len(sp.sel.q.cols), Val.Null)
        let noSubs: []SubRes = []
        let env = Env{cols: &sp.sel.q.cols, row: &noRow, aggs: &vals, params: params, subs: &noSubs, cur: &noRow, seq: &sqe}
        out.v.val = try eval(&sp.sel.exprs[nk], &env)
        return Ok(out)
    }
    let z = txn.sql.zone.clone()
    for r in res.rows {
        var gk = ""
        var nul = false
        for j in 0..nk {
            if lexdb_ops.isNull(&r[j]) { nul = true }
            lexdb_pipe.keyPart(mut &gk, &r[j])
        }
        if nul { continue }
        let g = gk
        var f = 1
        if sp.use == lexdb_sql.SUB_IN {
            if lexdb_ops.isNull(&r[nk]) {
                f = 3
            } else {
                let v = lexdb_sort.collVal(sp.kind, &(try inVal(sp, r[nk].clone(), &z)))
                var ks: []str = []
                lexdb_pipe.inValKeys(&v, true, true, &z, mut &ks)
                for k in ks { out.v.set.put(g + k, 1) }
            }
        }
        match out.groups.get(&g) {
            Some(old) { if old < f { out.groups.put(g, f) } }
            None { out.groups.put(g, f) }
        }
    }
    return Ok(out)
}

// A hashed subquery's value for an outer row: its key's values, IN's x.
fn hashValue(n: &str, r: &SubRes, keyVals: &[]Val, x: &Val, z: &lexdb_time.Zone): Val {
    var gk = ""
    var miss = false
    for v in keyVals {
        if lexdb_ops.isNull(&v) { miss = true }               // inner = NULL: no row
        lexdb_pipe.keyPart(mut &gk, &v)
    }
    if n == "#sub" {
        // a scalar: its group's value, or the aggregate over no rows
        if miss { return r.v.val.clone() }
        match r.groups.get(&gk) {
            Some(i) { return r.data[i][0].clone() }
            None { return r.v.val.clone() }
        }
    }
    var f = 0
    if !miss {
        match r.groups.get(&gk) {
            Some(v) { f = v }
            None {}
        }
    }
    if f == 0 { return Val.Bool(false) }            // no rows for it
    if n == "#exists" { return Val.Bool(true) }
    if lexdb_ops.isNull(x) { return Val.Null }
    // x's keys (lexdb_pipe.inProbeKeys) after the key's
    var ks: []str = []
    lexdb_pipe.inProbeKeys(x, true, true, z, mut &ks)
    let g = gk
    for k in ks { if r.v.set.get(&(g + k)).isSome() { return Val.Bool(true) } }
    return if f == 3 { Val.Null } else { Val.Bool(false) }
}

// ---- semi-joins (design/lexdb.md 9.104)
//
// A conjunct of a SELECT's WHERE, x IN (subquery) or EXISTS (subquery),
// becomes a level of its own, right after the level it was checked at: the
// subquery's rows, run once before the query (prepare) and hashed on its
// keys (materialize). Each row of the tables before probes the hash and
// goes on once if any row matches, however many do (runLevel; over
// batches, bProbe). The level's columns have no name a query can use and
// are not in *.
// - IN, the subquery uncorrelated: hashed on its value; x is the probe.
// - EXISTS or IN, correlated, that 9.9 hashed (its outer values only in its
//   WHERE's equalities inner = outer): hashed on the inner sides (then IN's
//   value); the outer sides are the probe.
// - The same that 9.9 could not hash as planned (an outer value a lookup's
//   key): planned again without outer values as keys (Scope.noRefKeys),
//   and taken when its hash costs less than a lookup per row by the
//   statistics (semiCheaper); else it stays per row.
// Not: NOT IN, NOT EXISTS, a conjunct under OR, outside WHERE, of an outer
// join's table; a key whose types a hash would compare otherwise than = or
// IN does (semiTypes); a subquery a path reads its IN values from
// (Path.inSub).

// A WHERE conjunct as parsed, x IN (subquery) or EXISTS (subquery): the
// subquery's number; -1 none.
fn semiParsed(c: &Expr): int {
    match c {
        Expr.Call(n, args, _) {
            if (n == "#exists" && len(args) == 1) || (n == "#in" && len(args) == 2) { return lexdb_sql.litInt(&args[0]) }
        }
        Expr.Unary(op, a) { if op == "not" { return semiParsedNot(&a) } }
        else {}
    }
    return -1
}

// NOT EXISTS's subquery number; NOT IN keeps its row path's NULL rules.
fn semiParsedNot(x: &Expr): int {
    match x {
        Expr.Call(n, args, _) { if n == "#exists" && len(args) == 1 { return lexdb_sql.litInt(&args[0]) } }
        else {}
    }
    return -1
}

// The same, resolved.
fn semiResolved(c: &Expr): int {
    match c {
        Expr.Call(n, args, _) {
            if (n == "#exists" || n == "#in") && len(args) >= lexdb_bind.subFixed(&n) { return lexdb_sql.litInt(&args[0]) }
        }
        Expr.Unary(op, a) { if op == "not" { return semiResolvedNot(&a) } }
        else {}
    }
    return -1
}

fn semiResolvedNot(x: &Expr): int {
    match x {
        Expr.Call(n, args, _) { if n == "#exists" && len(args) >= lexdb_bind.subFixed(&n) { return lexdb_sql.litInt(&args[0]) } }
        else {}
    }
    return -1
}

// x with a subquery's outer values (parameters after base) as the outer
// query has them (refs).
fn substRefs(x: &Expr, base: int, refs: &[]Expr): Expr {
    match x {
        Expr.Param(n) { if n > base && n - base - 1 < len(refs) { return lexdb_sql.cloneExpr(&refs[n - base - 1]) } }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), substRefs(&a, base, refs)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), substRefs(&a, base, refs), substRefs(&b, base, refs)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(substRefs(&a, base, refs), neg) }
        Expr.Cast(a, t) {
            // an outer column typed as itself (outerRef): the column
            // (a bare parameter's: a cast written over it stays)
            match a {
                Expr.Param(n) { if n > base && n - base - 1 < len(refs) && lexdb_bind.refTyped(t.oid) { return lexdb_sql.cloneExpr(&refs[n - base - 1]) } }
                else {}
            }
            return Expr.Cast(substRefs(&a, base, refs), t)
        }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, substRefs(&a, base, refs)) }
            return Expr.Call(n.clone(), out, star)
        }
        else {}
    }
    return lexdb_sql.cloneExpr(x)
}

// Whether subquery sp planned again to be hashed (alt) is sp with other
// keys: the same outer values, and nothing whose value would differ when
// run once instead of per row (a subquery of its own; random(), a
// sequence's, the clock).
fn semiAltOk(alt: &SubPlan, sp: &SubPlan): bool {
    let a = &alt.sel.q
    let b = &sp.sel.q
    if len(a.refs) != len(b.refs) || len(a.subs) > 0 || len(b.subs) > 0 { return false }
    for i in 0..len(a.refs) { if lexdb_sql.exprText(&a.refs[i]) != lexdb_sql.exprText(&b.refs[i]) { return false } }
    for x in alt.sel.exprs { if !immutable(&x) { return false } }
    for x in alt.keyOuter { if !immutable(&x) { return false } }
    // a residual is checked per outer row (or once per key's summary)
    for x in alt.res { if !immutable(&x) { return false } }
    for x in a.top { if !immutable(&x) { return false } }
    for lv in a.levels {
        if lv.virt() { return false }
        for x in lv.cond { if !immutable(&x) { return false } }
        for x in lv.post { if !immutable(&x) { return false } }
        for x in lv.local { if !immutable(&x) { return false } }
    }
    return true
}

// Whether keys of types a and b (OIDs) in a hash (lexdb_pipe.keyPart) match exactly
// when = says they are equal, and IN's set (lexdb_pipe.setKey): integers and numerics
// by value, texts and varchars by their text, a few types each with
// itself. (Not floats: -0 and 0; not intervals: '1 day' and '24 hours'; not
// char(n): its blanks.)
fn semiTypes(a: int, b: int): bool {
    let na = lexdb_bind.isIntOid(a) || a == lexdb_sql.OID_NUMERIC
    let nb = lexdb_bind.isIntOid(b) || b == lexdb_sql.OID_NUMERIC
    if na || nb { return na && nb }
    let ta = a == lexdb_sql.OID_TEXT || a == lexdb_sql.OID_VARCHAR
    let tb = b == lexdb_sql.OID_TEXT || b == lexdb_sql.OID_VARCHAR
    if ta || tb { return ta && tb }
    return a == b && (a == lexdb_sql.OID_BOOL || a == lexdb_sql.OID_DATE || a == lexdb_sql.OID_TS || a == lexdb_sql.OID_TSTZ ||
                      a == lexdb_sql.OID_UUID)
}

// A semi-join's keys: per column of the subquery's rows, the outer value
// it is to equal, its type, its name (EXPLAIN); and the correlated filters
// that are not keys (q21's l_suppkey <> outer), checked on the candidates.
type SemiKeys = record { vals: []Expr; oids: []int; names: []str; res: []Expr }

// The keys of a semi-join of subquery sp for conjunct c of q; None: it is
// not one.
fn semiKeys(q: &Query, sp: &SubPlan, c: &Expr, pt: &[]int): Option[SemiKeys] {
    match c {
        Expr.Unary(op, a) { if op == "not" { return semiKeys(q, sp, &a, pt) } }
        else {}
    }
    let isIn = sp.use == lexdb_sql.SUB_IN
    if (!isIn && sp.use != lexdb_sql.SUB_EXISTS) || sp.cte >= 0 || sp.semi { return None }
    var out = SemiKeys{vals: [], oids: [], names: [], res: []}
    let sq = &sp.sel.q
    if sp.hashed {
        for j in 0..len(sp.keyOuter) {
            let ov = substRefs(&sp.keyOuter[j], q.base, &sq.refs)
            let io = exprOid(&sp.sel.exprs[j], &sq.cols, pt)
            if hasSubCall(&ov) || !semiTypes(io, exprOid(&ov, &q.cols, pt)) { return None }
            let nm = match sp.sel.exprs[j] {
                Expr.Col(n, _) { lexdb_bind.colPart(&n) }
                else { lexdb_sql.exprText(&sp.sel.exprs[j]) }
            }
            append(mut &out.vals, ov)
            append(mut &out.oids, io)
            append(mut &out.names, nm)
        }
    } else if !isIn || len(sq.refs) > 0 {
        return None
    }
    for x in sp.res { append(mut &out.res, substRefs(&x, q.base, &sq.refs)) }
    if isIn {
        if len(sp.sel.outs) != 1 { return None }
        var x = Expr.Lit(Val.Null)
        match c {
            Expr.Call(_, args, _) { x = lexdb_sql.cloneExpr(&args[3]) }
            else { return None }
        }
        let vo = sp.sel.outs[0].oid
        if hasSubCall(&x) || vo == lexdb_sql.OID_BPCHAR || !semiTypes(vo, exprOid(&x, &q.cols, pt)) { return None }
        append(mut &out.vals, x)
        append(mut &out.oids, vo)
        append(mut &out.names, sp.sel.outs[0].name.toStr())
    }
    return Some(out)
}

// About the rows a level reads by its path: one by a unique key, else by
// ANALYZE's statistics (loaded for the figure if the level has none: a
// query of one table, optimizer 24); -1 unknown.
fn semiRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, lv: mut &Level, params: &[]Val): Result[float, DbErr] {
    if lv.virt() { return Ok(-1.0f) }
    let cols = keyCols(&lv.t, lv.path.index)
    let unique = lv.path.index < 0 || lv.t.indexes[lv.path.index].unique
    if len(lv.path.eqs) > 0 && len(lv.path.eqs) == len(cols) && unique { return Ok(1.0f) }
    if lv.estRows >= 0 { return Ok(float(lv.estRows)) }
    let loaded = lv.est.rows < 0
    if loaded { lv.est = try lexdb_stats.loadEst(st, txn, &lv.t, true, txn.sql.rules) }
    var n = -1.0f
    if lv.est.rows >= 0 {
        n = float(lv.est.rows)
        let f = pathFig(lv, &lv.path, params)
        if f.rows >= 0 { n = float(f.rows) }
    }
    if loaded { lv.est = lexdb_stats.noEst() }
    return Ok(n)
}

// The rows a subquery's tables read, summed; -1 unknown.
fn semiInner(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sq: mut &Query, params: &[]Val): Result[float, DbErr] {
    var n = 0.0f
    for k in 0..len(sq.levels) {
        let r = try semiRows(st, txn, mut &sq.levels[k], params)
        if r < 0.0f { return Ok(-1.0f) }
        n += r
    }
    return Ok(n)
}

// Whether the subquery's rows (inner) read once and hashed, each of the
// outer rows probing them, cost less than a lookup per outer row (as the
// join order weighs them, optimizer 41).
// The per-row alternative's fixed cost, measured (optimizer 45's units):
// a primary-key range run (q4's 2.4 lineitem rows) 140 us, ~5000 scan
// rows; a secondary index's lookup (q22's orders) 26 us, ~100. PostgreSQL
// has no such term: its subquery is a plan node. This is the executor's
// per-run setup, so it is charged by the path's shape, not the table's size.
const SEMI_RUN_PK: float = 5000.0f
const SEMI_RUN_INDEX: float = 100.0f

fn semiCheaper(outer: float, inner: float, run: float): bool {
    // The inner side is read once and hashed (COST_SCAN), not once per outer
    // row; the per-row side pays a run each (semiRun). One pinned row is
    // one run: no build.
    if outer <= 1.0f { return false }
    return inner * (lexdb_plan.COST_SCAN + lexdb_plan.HASH_BUILD) + outer * lexdb_plan.HASH_PROBE < outer * run
}

// One per-row run's cost, by its first table's path: its setup and the
// first row's lookup for a key's (a primary key's range, a secondary
// index's), its setup and every row for a path with no key: a full scan
// reads the inner side (about inner rows) again on each run. Charging it as
// a lookup chose 40 runs of a 100k-row scan, 2.76M rows, over one hash.
fn semiRun(lv: &Level, inner: float): float {
    let p = &lv.path
    let keyed = len(p.eqs) > 0 || len(p.rng) > 0 || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0
    if !keyed || lv.virt() { return SEMI_RUN_PK + inner * lexdb_plan.COST_SCAN }
    let setup = if p.index < 0 { SEMI_RUN_PK } else { SEMI_RUN_INDEX }
    return setup + lexdb_plan.COST_DESCENT + lexdb_plan.COST_KEY_ROW
}

// ---- a semi/anti join looked up per row (PostgreSQL's nested loop semi
// and anti join over an index scan, nodeNestloop.c: the inner scan stops
// at its first match). An EXISTS or NOT EXISTS over one table whose path
// is keyed by outer values (q4's lineitem by l_orderkey, q22's orders by
// o_custkey) becomes a level of that table, read per row of the tables
// before it by the path's range, its filters (the residual too: q21's
// l_suppkey <> outer) checked on each row found; a row of the tables
// before goes on once if one passes (semi), or if none does (anti). The
// subquery is not run: a run cost about 140 us (a primary-key range) or
// 26 us (a secondary index), the lookup a descent and the rows read. The
// batches read a batch's ranges together (bRange).

// Whether subquery i of q can be a looked-up semi/anti level (semiLook):
// EXISTS over one table, no grouping, aggregate, LIMIT or set operation,
// its path's leading equalities of outer values and constants only (no
// range, IN list or backward read: what bRange reads), at least one an
// outer value; its filters with no subquery and nothing whose value may
// change between rows (the subquery read them per row too, but a range
// read once for two outer rows of one key must give both the same rows).
fn semiLookable(q: &Query, i: int): bool {
    let sp = &q.subs[i]
    if sp.use != lexdb_sql.SUB_EXISTS || sp.cte >= 0 || sp.semi || sp.hashed { return false }
    let sel = &sp.sel
    if sel.setop != 0 || sel.aggQ || sel.having.isSome() || len(sel.groupBy) > 0 || sel.limit >= 0 || sel.offset > 0 || len(sel.wins) > 0 ||
       len(sel.locks) > 0 || len(sel.srf) > 0 || sel.rec >= 0 || len(sel.mr) > 0 || len(sel.gsets) > 0 { return false }
    let sq = &sel.q
    if len(sq.levels) != 1 || len(sq.subs) > 0 || len(sq.refs) == 0 { return false }
    let sl = &sq.levels[0]
    if sl.virt() || sl.lateral || sl.lock != 0 || len(sl.post) > 0 || len(sl.t.cols) == 0 { return false }
    let p = &sl.path
    if len(p.eqs) == 0 || len(p.rng) > 0 || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 || p.desc { return false }
    var keyed = false
    for x in p.eqs {
        var ns: []str = []
        lexdb_sql.colNames(&x, mut &ns)
        if len(ns) > 0 || hasSubCall(&x) || hasAgg(&x) || !immutable(&x) { return false }
        if usesRefs(&x, q.base) { keyed = true }
    }
    if !keyed { return false }
    for x in sl.cond { if hasSubCall(&x) || hasAgg(&x) || !immutable(&x) { return false } }
    for x in sl.local { if hasSubCall(&x) || hasAgg(&x) || !immutable(&x) { return false } }
    for x in sq.top { if hasSubCall(&x) || hasAgg(&x) || !immutable(&x) { return false } }
    // Nothing of it may use q's own outer values (q a subquery, the
    // EXISTS's outer value one of the query around q): q's level would
    // carry a condition on them, which q's own unnesting (hashSub) could
    // take for a key "inner = outer" of q and drop from the level.
    for x in p.eqs { if usesRefs(&substRefs(&x, q.base, &sq.refs), q.base) { return false } }
    for x in sl.cond { if usesRefs(&substRefs(&x, q.base, &sq.refs), q.base) { return false } }
    for x in sl.local { if usesRefs(&substRefs(&x, q.base, &sq.refs), q.base) { return false } }
    for x in sq.top { if usesRefs(&substRefs(&x, q.base, &sq.refs), q.base) { return false } }
    return true
}

// A looked-up semi/anti level's cost per outer row (optimizer 45's
// units): a descent and the first row's read (a lookup's, COST_DESCENT +
// COST_KEY_ROW), then each further row of the key's range: a primary
// key's or an index read alone 1.8 (COST_PK_RANGE), an index entry and
// its row 49 (COST_IX_ROW). With no filter the first row decides. rows:
// the path's rows per key, -1 unknown (10 assumed, SQLite's default).
fn semiLookRun(t: &Table, lv: &Level, rows: float): float {
    var r = if rows < 0.0f { 10.0f } else { fmax(rows, 1.0f) }
    if len(lv.cond) == 0 { r = 1.0f }
    let ix = lv.path.index
    let each = if ix < 0 || idxDecOf(t, ix, &lv.need).isSome() { lexdb_plan.COST_PK_RANGE } else { lexdb_plan.COST_IX_ROW }
    return lexdb_plan.COST_DESCENT + lexdb_plan.COST_KEY_ROW + (r - 1.0f) * each
}

// Subquery i of q (semiLookable) as a semi (anti: an anti) join level of
// its table, its columns after q's (semiLookAdd adds them, hidden, and
// moves the table in: t is noTable until then); its path and filters with
// the subquery's columns renamed to the level's and its outer values as q
// has them.
fn semiLook(q: &Query, i: int, anti: bool, pt: &[]int): Level {
    let alias = "\x00sj" + (i + 1).toStr()
    let first = len(q.cols)
    var names: []str = []
    var path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
    var conds: []Expr = []
    var estRows = -1
    var estMax = false
    {
        let sq = &q.subs[i].sel.q
        let sl = &sq.levels[0]
        var from: []str = []
        var to: []str = []
        for j in 0..len(sl.t.cols) {
            append(mut &names, sl.t.cols[j].name.toStr())
            append(mut &from, sq.cols[sl.first + j].name.toStr())
            append(mut &to, alias + "." + lexdb_catalog.ROWID + j.toStr())
        }
        var xs: []Expr = []
        for x in sl.cond { append(mut &xs, lexdb_sql.cloneExpr(&x)) }
        for x in sl.local { append(mut &xs, lexdb_sql.cloneExpr(&x)) }
        for x in sq.top { append(mut &xs, lexdb_sql.cloneExpr(&x)) }
        for x in xs {
            var rc = lexdb_sql.cloneExpr(&x)
            for j in 0..len(from) { rc = renameCol(&rc, &from[j], &to[j], first + j) }
            // (local repeats some of cond: each once)
            let r2 = substRefs(&rc, q.base, &sq.refs)
            let tx = lexdb_sql.exprText(&r2)
            var have = false
            for c in conds { if lexdb_sql.exprText(&c) == tx { have = true } }
            if !have { append(mut &conds, r2) }
        }
        path.index = sl.path.index
        for x in sl.path.eqs { append(mut &path.eqs, substRefs(&x, q.base, &sq.refs)) }
        // a key column's equality with its path value, both integers: the
        // range holds exactly its rows (keyVal: a value out of the
        // column's range reads none), so no filter is left and a range
        // stops at its first row (bRange)
        let kc = keyCols(&sl.t, sl.path.index)
        var kept: []Expr = []
        for ci in 0..len(conds) {
            let c = replace(mut &conds[ci], Expr.Lit(Val.Null))
            var key = false
            match c {
                Expr.Bin(op, a, b) {
                    if op == "=" {
                        for j in 0..len(path.eqs) {
                            if j >= len(kc) || kc[j] < 0 || !lexdb_bind.isIntOid(sl.t.cols[kc[j]].typ.oid) { continue }
                            let want = &to[kc[j]]
                            let et = lexdb_sql.exprText(&path.eqs[j])
                            match a {
                                Expr.Col(n, _) { if n == want && lexdb_sql.exprText(&b) == et && lexdb_bind.isIntOid(exprOid(&b, &q.cols, pt)) { key = true } }
                                else {}
                            }
                            match b {
                                Expr.Col(n, _) { if n == want && lexdb_sql.exprText(&a) == et && lexdb_bind.isIntOid(exprOid(&a, &q.cols, pt)) { key = true } }
                                else {}
                            }
                        }
                    }
                }
                else {}
            }
            if !key { append(mut &kept, c) }
        }
        conds = kept
        estRows = sl.estRows
        estMax = sl.estMax
    }
    // its columns read: those its filters name
    var ns: []str = []
    for c in conds { lexdb_sql.colNames(&c, mut &ns) }
    var need: []bool = []
    for j in 0..len(names) {
        let want = alias + "." + lexdb_catalog.ROWID + j.toStr()
        var used = false
        for n in ns { if n == want { used = true } }
        append(mut &need, used)
    }
    var lv = newLevel(rc(noTable()), &alias, lexdb_sql.J_INNER, first)
    lv.path = path
    lv.cond = conds
    lv.need = need
    lv.perRow = true
    lv.semi = true
    lv.anti = anti
    lv.semiSub = i
    lv.estRows = estRows
    lv.estMax = estMax
    return lv
}

// Level lv of semiLook taken: its table moved in from the subquery's
// level (which is no longer run), its columns added to q's, hidden.
fn semiLookAdd(q: mut &Query, lv: mut &Level) {
    let i = lv.semiSub
    lv.t = replace(mut &q.subs[i].sel.q.levels[0].t, rc(noTable()))
    let t = &lv.t
    for j in 0..len(t.cols) {
        // a name no query can use, in no * (hiddenName)
        var qc = lexdb_sql.colDef(&(lv.alias + "." + lexdb_catalog.ROWID + j.toStr()), t.cols[j].typ, t.cols[j].notNull)
        qc.coll = t.cols[j].coll.clone()
        qc.using = lexdb_sql.USING_HIDDEN
        addCol(q, qc)
    }
    q.subs[i].semi = true
}

// The rows the first k + 1 levels of q's order give, per k: the join
// order's estimates (costOrder's: each table's rows by its own conditions,
// a class of equal columns joining by its distinct values), before any
// semi-join. [] when one has no statistics or is not an inner join's
// plain table.
fn (q: &Query) orderRows(): []float {
    let nl = len(q.levels)
    if nl < 2 || nl > lexdb_plan.JOIN_SEARCH_MAX { return [] }
    for lv in q.levels {
        if isOuter(lv.join) || lv.lateral || lv.virt() || lv.est.rows < 0 { return [] }
    }
    var cs: []Expr = []
    for lv in q.levels { for c in lv.cond { if !hasSubCall(&c) { append(mut &cs, lexdb_sql.cloneExpr(&c)) } } }
    var masks: []int = []
    for x in cs { append(mut &masks, q.levelMask(&x)) }
    var base: []Way = []
    for k in 0..nl {
        var own: []Expr = []
        var ownMasks: []int = []
        for i in 0..len(cs) {
            if masks[i] == (1 << k) {
                append(mut &own, lexdb_sql.cloneExpr(&cs[i]))
                append(mut &ownMasks, masks[i])
            }
        }
        let t = float(q.levels[k].est.rows)
        var g = false
        append(mut &base, Way{rows: fmax(t * q.localShare(k, &own, &ownMasks, mut &g), 1.0f), cost: 0.0f, outer: false, inner: 0.0f})
    }
    var cmask: []int = []
    var cdist: []float = []
    let all = q.eqClasses(&cs)
    for x in 0..len(all) {
        if len(all[x].konst) > 0 { continue }
        var m = 0
        var ds: []float = array(nl, 0.0f)
        for i in 0..len(all[x].names) {
            let l = all[x].levels[i]
            if (m & (1 << l)) == 0 {
                m = m | (1 << l)
                ds[l] = q.distinctOf(&all[x].names[i], l)
            }
        }
        if m & (m - 1) == 0 { continue }
        append(mut &cmask, m)
        for d in ds { append(mut &cdist, d) }
    }
    var memo: Map[int, float] = newMap()
    var out: []float = []
    for k in 0..nl { append(mut &out, q.setRows((1 << (k + 1)) - 1, nl, &base, &cmask, &cdist, mut &memo)) }
    return out
}

// Reads a subquery's tables only the columns its output and its conditions
// name. Planned before it was unhashed, a semi-join's subquery still said
// "select *": its scan then fetched every column (q4/q21's lineitem) though
// the keys were all the join needed.
fn narrowSub(sel: mut &Sel) {
    // a window, a lock or a set-returning function reads columns its own
    // code names; those queries keep every column
    if len(sel.wins) > 0 || len(sel.locks) > 0 || len(sel.srf) > 0 { return }
    var xs: []str = []
    for x in sel.exprs { lexdb_sql.colNames(&x, mut &xs) }
    for g in sel.groupBy { lexdb_sql.colNames(&g, mut &xs) }
    match sel.having { Some(x) { lexdb_sql.colNames(&x, mut &xs) } None {} }
    for x in sel.order { lexdb_sql.colNames(&x, mut &xs) }
    for x in sel.q.top { lexdb_sql.colNames(&x, mut &xs) }
    for k in 0..len(sel.q.levels) {
        let lv = &sel.q.levels[k]
        for x in lv.cond { lexdb_sql.colNames(&x, mut &xs) }
        for x in lv.post { lexdb_sql.colNames(&x, mut &xs) }
        for x in lv.local { lexdb_sql.colNames(&x, mut &xs) }
        for x in lv.hashVals { lexdb_sql.colNames(&x, mut &xs) }
    }
    var names: Map[str, int] = newMap()
    for x in xs { if !names.has(&lexdb_bind.colPart(&x)) { names.put(lexdb_bind.colPart(&x), 1) } }
    for k in 0..len(sel.q.levels) {
        if sel.q.levels[k].virt() { continue }
        var need: []bool = []
        for c in sel.q.levels[k].t.cols { append(mut &need, names.has(&c.name)) }
        sel.q.levels[k].need = need
    }
}

// The semi-join level of conjunct c (subquery i) of q, or None: c stays.
// kind: IN's collation kind (resolve's); outer: about the rows reaching it.
fn semiLevel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, c: &Expr, i: int, kind: int, pt: &[]int,
             alts: mut &[]Option[SubPlan], outer: float, params: &[]Val, anti: bool, lookOk: bool): Result[Option[Level], DbErr] {
    var keys = SemiKeys{vals: [], oids: [], names: [], res: []}
    var ok = false
    // a lookup per row as a join's level (semiLook), in place of the
    // subquery run per row
    var look: Option[Level] = None
    var lookRun = 0.0f
    if lookOk && semiLookable(q, i) {
        let lk = semiLook(q, i, anti, pt)
        let rows = try semiRows(st, txn, mut &q.subs[i].sel.q.levels[0], params)
        lookRun = semiLookRun(&q.subs[i].sel.q.levels[0].t, &lk, rows)
        look = Some(lk)
    }
    if alts[i].isSome() && !q.subs[i].hashed {
        var alt = replace(mut &alts[i], None).unwrap()
        let inner = try semiInner(st, txn, mut &alt.sel.q, params)
        // the per-row plan's run (the subquery as planned, not alt), or
        // the lookup's
        var run = SEMI_RUN_PK + lexdb_plan.COST_DESCENT + lexdb_plan.COST_KEY_ROW
        if look.isSome() {
            run = lookRun
        } else if len(q.subs[i].sel.q.levels) > 0 {
            run = semiRun(&q.subs[i].sel.q.levels[0], inner)
        }
        if outer >= 0.0f && inner >= 0.0f && semiCheaper(outer, inner, run) {
            let got = semiKeys(q, &alt, c, pt)
            if got.isSome() {
                keys = got.unwrap()
                ok = true
                q.subs[i] = alt
            }
        }
    } else {
        let got = semiKeys(q, &q.subs[i], c, pt)
        if got.isSome() {
            keys = got.unwrap()
            ok = true
        }
    }
    if !ok {
        if look.isSome() {
            var lk = look.unwrap()
            semiLookAdd(q, mut &lk)
            return Ok(Some(lk))
        }
        return Ok(None)
    }
    let w = len(keys.vals)
    let nk = if q.subs[i].use == lexdb_sql.SUB_IN { w - 1 } else { w }
    // its name and its columns' are no names a query can use: no table, a
    // column in no *
    let alias = "\x00sj" + (i + 1).toStr()
    var t = noTable()
    t.name = alias.toStr()
    let first = len(q.cols)
    for j in 0..w {
        append(mut &t.cols, lexdb_sql.colDef(&(keys.names[j].toStr()), lexdb_sql.oidType(keys.oids[j]), false))
        var qc = lexdb_sql.colDef(&(alias + "." + lexdb_catalog.ROWID + j.toStr()), lexdb_sql.oidType(keys.oids[j]), false)
        qc.using = lexdb_sql.USING_HIDDEN
        addCol(q, qc)
    }
    // a correlated filter's own inner columns: output them with the keys,
    // and check the filter on each candidate row of the key's bucket
    var resCols: []str = []
    var resTypes: []lexdb_sql.TypeName = []
    {
        let sq = &q.subs[i].sel.q
        for x in keys.res {
            var ns: []str = []
            lexdb_sql.colNames(&x, mut &ns)
            for n in move(ns) {
                let ci = colIndex(&sq.cols, &n)
                if ci < 0 { continue }
                var have = false
                for y in resCols { if y == n { have = true } }
                if have { continue }
                append(mut &resCols, n.clone())
                append(mut &resTypes, sq.cols[ci].typ)
            }
        }
    }
    var resFrom: []str = []
    var resTo: []str = []
    for j in 0..len(resCols) {
        let n = &resCols[j]
        let pos = w + j
        append(mut &t.cols, lexdb_sql.colDef(&lexdb_bind.colPart(n), resTypes[j], false))
        var qc = lexdb_sql.colDef(&(alias + "." + lexdb_catalog.ROWID + pos.toStr()), resTypes[j], false)
        qc.using = lexdb_sql.USING_HIDDEN
        addCol(q, qc)
        var have = false
        let want = lexdb_sql.exprText(&Expr.Col(n.toStr(), -1))
        for e in q.subs[i].sel.exprs { if lexdb_sql.exprText(&e) == want { have = true } }
        if !have { append(mut &q.subs[i].sel.exprs, Expr.Col(n.toStr(), -1)) }
        append(mut &resFrom, n.toStr())
        append(mut &resTo, alias + "." + lexdb_catalog.ROWID + pos.toStr())
    }
    var lv = newLevel(rc(t), &alias, lexdb_sql.J_INNER, first)
    lv.src = i
    lv.perRow = false
    lv.semi = true
    lv.anti = anti
    var lcond: []Expr = []
    for x in keys.res {
        var rc = lexdb_sql.cloneExpr(&x)
        for j in 0..len(resFrom) { rc = renameCol(&rc, &resFrom[j], &resTo[j], first + w + j) }
        append(mut &lcond, rc)
    }
    // one "inner <> outer" filter: a bucket needs only whether it holds
    // more than one inner value, or the one it holds (q21's l_suppkey)
    if len(lcond) == 1 {
        match lcond[0] {
            Expr.Bin(op, a, b) {
                if op == "<>" {
                    var ii = -1
                    var oval = Expr.Lit(Val.Null)
                    match a {
                        Expr.Col(n, _) { for j in 0..len(resTo) { if resTo[j] == n { ii = j } } }
                        else {}
                    }
                    if ii >= 0 {
                        oval = lexdb_sql.cloneExpr(&b)
                    } else {
                        match b {
                            Expr.Col(n, _) { for j in 0..len(resTo) { if resTo[j] == n { ii = j } } }
                            else {}
                        }
                        if ii >= 0 { oval = lexdb_sql.cloneExpr(&a) }
                    }
                    var ovalOk = ii >= 0 && !hasSubCall(&oval)
                    if ovalOk {
                        var ns: []str = []
                        lexdb_sql.colNames(&oval, mut &ns)
                        for n in ns { for j in 0..len(resTo) { if resTo[j] == n { ovalOk = false } } }
                    }
                    if ovalOk {
                        lv.resNot = true
                        lv.resCol = w + ii
                        lv.resVal = oval
                    }
                }
            }
            else {}
        }
    }
    lv.cond = if lv.resNot { [] } else { lcond }
    var hc: []int = []
    var hk: []int = []
    for j in 0..w {
        append(mut &hc, j)
        // IN's value under its collation, as runSub keys its set
        append(mut &hk, if j == nk { kind } else { lexdb_sql.COLL_EXACT })
    }
    lv.hashCols = hc
    lv.hashVals = replace(mut &keys.vals, [])
    lv.hashKinds = hk
    // one integer key on both sides: materialize's own map (q4/q21's
    // order keys; a numeric's value is not an integer's key)
    if len(lv.hashCols) == 1 && len(keys.oids) == 1 && lexdb_bind.isIntOid(keys.oids[0]) && lexdb_bind.isIntOid(exprOid(&lv.hashVals[0], &q.cols, pt)) {
        lv.hashInt = true
    }
    q.subs[i].semi = true
    // run whole, once: not stopping at its first row (EXISTS)
    if len(q.subs[i].sel.q.levels) > 0 { q.subs[i].sel.q.levels[0].stops = false }
    narrowSub(mut &q.subs[i].sel)
    return Ok(Some(lv))
}

// The semi-joins of q (planned to its last level): each conjunct that is
// one taken from its level's conditions, its level placed after it.
// alts: per candidate subquery, its plan to be hashed (buildQuery).
fn semiJoins(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, alts: mut &[]Option[SubPlan], cand: &[]bool,
             looks: &[]bool, params: &[]Val, sc: &Scope): Result[Unit, DbErr] {
    let pt = lexdb_bind.ptypesOf(&sc.names)
    let fr = &sc.names.frames[len(sc.names.frames) - 1]
    var used: []bool = array(len(q.subs), false)       // a path's IN values (Path.inSub)
    for lv in q.levels { if lv.path.inSub >= 0 && lv.path.inSub < len(used) { used[lv.path.inSub] = true } }
    // the rows reaching a semi-join, about: the first table's (a lower
    // bound in most joins: it leans to the lookups of the plan as it was)
    let first = try semiRows(st, txn, mut &q.levels[0], params)
    // Where it goes: after the level, from the one where its outer values
    // are all known on, whose rows are fewest by the join order's
    // estimates (orderRows), as PostgreSQL's join search places a semi
    // join among the others (q21's after supplier and nation cut lineitem's
    // 3.8M rows to 150k); not past an outer join. Without estimates, there.
    let est = q.orderRows()
    let nl = len(q.levels)
    var olds = replace(mut &q.levels, [])
    var placed: [][]Level = []
    for k in 0..nl { append(mut &placed, []) }
    var any = false
    for k in 0..nl {
        var lv = replace(mut &olds[k], newLevel(rc(noTable()), "", 0, 0))
        var semis: []Level = []
        var ats: []int = []
        if !isOuter(lv.join) {
            var cs = replace(mut &lv.cond, [])
            var keep: []Expr = []
            for ci in 0..len(cs) {
                let c = replace(mut &cs[ci], Expr.Lit(Val.Null))
                let i = semiResolved(&c)
                var made = false
                if i >= 0 && i < len(cand) && cand[i] && !used[i] && i < len(fr.subKinds) && (i >= len(fr.subReads) || fr.subReads[i] == 0) {
                    var anti = false
                    match c {
                        Expr.Unary(op, _) { if op == "not" { anti = true } }
                        else {}
                    }
                    var at = k
                    var outer = first
                    if len(est) == nl {
                        for p in k + 1..nl {
                            if isOuter(olds[p].join) { break }
                            if est[p] < est[at] { at = p }
                        }
                        outer = est[at]
                    }
                    let got = try semiLevel(st, txn, q, &c, i, fr.subKinds[i], &pt, alts, outer, params, anti, i < len(looks) && looks[i])
                    if got.isSome() {
                        append(mut &semis, got.unwrap())
                        append(mut &ats, at)
                        made = true
                        any = true
                    }
                }
                if !made { append(mut &keep, c) }
            }
            lv.cond = keep
            // a table read once and hashed has its own columns' conjuncts
            // among its hash's filters too (local): not a semi-join's
            if len(semis) > 0 {
                var ls = replace(mut &lv.local, [])
                var lkeep: []Expr = []
                for li in 0..len(ls) {
                    let lc = replace(mut &ls[li], Expr.Lit(Val.Null))
                    var gone = false
                    for sl in semis { if semiResolved(&lc) == (if sl.semiSub >= 0 { sl.semiSub } else { sl.src }) { gone = true } }
                    if !gone { append(mut &lkeep, lc) }
                }
                lv.local = lkeep
            }
        }
        for j in 0..len(semis) { append(mut &placed[ats[j]], replace(mut &semis[j], newLevel(rc(noTable()), "", 0, 0))) }
        append(mut &q.levels, lv)
        for j in 0..len(placed[k]) { append(mut &q.levels, replace(mut &placed[k][j], newLevel(rc(noTable()), "", 0, 0))) }
    }
    if !any { return Ok(Unit{}) }
    // its columns by name (levelOf); a subquery still run per row
    for i in 0..len(q.cols) { if !q.colAt.has(&q.cols[i].name) { q.colAt.put(q.cols[i].name.toStr(), i) } }
    var corr = false
    for sp in q.subs { if len(sp.sel.q.refs) > 0 && !sp.semi { corr = true } }
    q.corr = corr
    return Ok(Unit{})
}

// A semi-join's subquery run once: its rows (prepare: the level's).
fn runSemi(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
           i: int): Result[SubRes, DbErr] {
    var res = try runChild(st, txn, &sp.sel, params, -1, parent, i)
    var out = emptyRes()
    out.v.rows = len(res.rows)
    out.data = replace(mut &res.rows, [])
    return Ok(out)
}

// Rows cut to n values (a semi-join's: its keys, of a subquery's rows).
fn cutRows(rows: [][]Val, n: int): [][]Val {
    var all = rows
    var long = false
    for r in all { if len(r) > n { long = true } }
    if !long { return all }
    var out: [][]Val = []
    for r in all {
        var x: []Val = []
        for j in 0..n { append(mut &x, r[j].clone()) }
        append(mut &out, x)
    }
    return out
}

// Has a correlated subquery: one run per row.
fn hasCorr(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasCorr(&a) }
        Expr.Bin(_, a, b) { return hasCorr(&a) || hasCorr(&b) }
        Expr.IsNull(a, _) { return hasCorr(&a) }
        Expr.Cast(a, _) { return hasCorr(&a) }
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) && len(args) > lexdb_bind.subFixed(&n) { return true }
            for a in args { if hasCorr(&a) { return true } }
            return false
        }
        else { return false }
    }
}

fn subsLast(cs: []Expr): []Expr {
    var all = cs
    var first: []Expr = []
    var last: []Expr = []
    for i in 0..len(all) {
        let c = replace(mut &all[i], Expr.Lit(Val.Null))
        if hasCorr(&c) { append(mut &last, c) } else { append(mut &first, c) }
    }
    for i in 0..len(last) { append(mut &first, replace(mut &last[i], Expr.Lit(Val.Null))) }
    return first
}

fn addCounts(a: mut &[]lexdb_pipe.Counts, b: &[]lexdb_pipe.Counts) {
    if len(a) == 0 {
        for c in b { append(a, c) }
        return
    }
    for i in 0..len(b) {
        a[i].starts += b[i].starts
        a[i].read += b[i].read
        a[i].joined += b[i].joined
        a[i].nulls += b[i].nulls
        a[i].built += b[i].built
        a[i].kept += b[i].kept
        a[i].unmatched += b[i].unmatched
        a[i].batches += b[i].batches
    }
}

fn mergeStats(a: mut &[]SubStat, b: &[]SubStat) {
    for i in 0..len(b) {
        if i >= len(a) { append(a, SubStat{runs: 0, hits: 0, cnt: [], inner: []}) }
        a[i].runs += b[i].runs
        a[i].hits += b[i].hits
        addCounts(mut &a[i].cnt, &b[i].cnt)
        mergeStats(mut &a[i].inner, &b[i].inner)
    }
}

// A subquery in FROM: its rows.
fn runFrom(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
           i: int): Result[SubRes, DbErr] {
    var out = emptyRes()
    // a CTE: run once in the statement, its rows kept for its other uses
    let key = "c" + sp.cte.toStr()
    if sp.cte >= 0 {
        let at = cacheAt(&parent.cache, &key)
        if at >= 0 {
            out.data = copyRows(&parent.cache.rows[at])
            out.v.rows = len(out.data)
            parent.stats[i].hits += 1
            return Ok(out)
        }
    }
    var res = try runChild(st, txn, &sp.sel, params, -1, parent, i)
    out.v.rows = len(res.rows)
    out.data = replace(mut &res.rows, [])
    if sp.cte >= 0 {
        try parent.bud.hold(lexdb_pipe.rowsBytes(&out.data))
        cachePut(mut &parent.cache, key, copyRows(&out.data))
    }
    return Ok(out)
}

// Rows the statement's queries share while it runs: a CTE's ("c" and its
// number), a recursive CTE's working table ("w"). A query's run hands them
// to the runs inside it and takes them back.
type CteCache = record { index: Map[str, int]; rows: [][][]Val }

fn newCache(): CteCache { return CteCache{index: newMap(), rows: []} }

fn cacheAt(c: &CteCache, key: &str): int {
    match c.index.get(key) {
        Some(i) { return i }
        None { return -1 }
    }
}

fn cachePut(c: mut &CteCache, key: str, rows: [][]Val) {
    let at = cacheAt(c, &key)
    if at >= 0 {
        c.rows[at] = rows
        return
    }
    c.index.put(key, len(c.rows))
    append(mut &c.rows, rows)
}

fn copyRows(rows: &[][]Val): [][]Val {
    var out: [][]Val = []
    for r in rows { append(mut &out, collections.copyOf(&r)) }
    return out
}

// Runs a planned query inside another's run: the shared rows go with it,
// and its counts add to the parent's slot i (EXPLAIN ANALYZE).
fn runChild(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int, parent: mut &Run,
            i: int): Result[Res, DbErr] {
    var rs = newRun(&sel.q)
    rs.maxRounds = parent.maxRounds
    rs.maxSteps = parent.maxSteps
    rs.bud.maxHeld = parent.bud.maxHeld
    rs.bud.deadline = parent.bud.deadline
    rs.batch = parent.batch
    rs.writes = parent.writes
    rs.bud.held = parent.bud.held
    rs.bud.ticks = parent.bud.ticks
    rs.bud.turnEnd = parent.bud.turnEnd
    rs.cache = replace(mut &parent.cache, newCache())
    let r = execSel(st, txn, sel, params, cap, mut &rs)
    parent.cache = replace(mut &rs.cache, newCache())
    parent.bud.ticks = rs.bud.ticks
    parent.bud.turnEnd = rs.bud.turnEnd
    while len(parent.stats) <= i { append(mut &parent.stats, SubStat{runs: 0, hits: 0, cnt: [], inner: []}) }
    parent.stats[i].runs += 1
    addCounts(mut &parent.stats[i].cnt, &rs.cnt)
    mergeStats(mut &parent.stats[i].inner, &rs.stats)
    return r
}

// A column type for a result's OID.

// An IN subquery's value as compared: a char's without its blanks (the
// value IN it is made a text by resolve, 9.94).
fn inVal(sp: &SubPlan, v: Val, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if sp.readAs != 0 { return lexdb_ops.coerceZ(v, &lexdb_sql.oidType(sp.readAs), z) }
    if len(sp.sel.outs) > 0 && sp.sel.outs[0].oid == lexdb_sql.OID_BPCHAR && lexdb_ops.kindOf(&v) == lexdb_sql.K_TEXT { return Ok(Val.Text(lexdb_ops.bpTrim(&lexdb_sql.text(&v)))) }
    return Ok(v)
}

fn matchesOr(x: &Expr): bool {
    match x { Expr.Bin(op, _, _) { if op == "or" { return true } } else {} }
    return false
}

// The OR's operands, flattened.
fn orParts(x: &Expr, out: mut &[]Expr) {
    match x {
        Expr.Bin(op, a, b) {
            if op == "or" { orParts(&a, out); orParts(&b, out); return }
        }
        else {}
    }
    append(out, lexdb_sql.cloneExpr(x))
}

// The AND's operands, flattened.
fn andParts(x: &Expr, out: mut &[]Expr) {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" { andParts(&a, out); andParts(&b, out); return }
        }
        else {}
    }
    append(out, lexdb_sql.cloneExpr(x))
}

fn andOf(xs: &[]Expr): Expr {
    if len(xs) == 0 { return Expr.Lit(Val.Bool(true)) }
    var out = lexdb_sql.cloneExpr(&xs[0])
    for i in 1..len(xs) { out = Expr.Bin("and", out, lexdb_sql.cloneExpr(&xs[i])) }
    return out
}

fn orOf(xs: &[]Expr): Expr {
    if len(xs) == 0 { return Expr.Lit(Val.Bool(false)) }
    var out = lexdb_sql.cloneExpr(&xs[0])
    for i in 1..len(xs) { out = Expr.Bin("or", out, lexdb_sql.cloneExpr(&xs[i])) }
    return out
}

// Whether x can raise no error on a row's values: columns, constants and
// comparisons of them, AND, OR, NOT, IS NULL, IN and LIKE. A part with no
// column is a constant, the same value (or error) on every row. Arithmetic
// (division by zero, overflow), a cast or another call can fail on some
// row's values, so a copy of it must not be evaluated on rows the query
// as written would not evaluate it on (pullCommonOr, orLevels).
fn cannotFail(x: &Expr): bool {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    if len(ns) == 0 { return !hasSubCall(x) && immutable(x) }
    match x {
        Expr.Col(_, _) { return true }
        Expr.Unary(op, a) { return op == "not" && cannotFail(&a) }
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" || op == "=" || op == "<>" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                return cannotFail(&a) && cannotFail(&b)
            }
            return false
        }
        Expr.IsNull(a, _) { return cannotFail(&a) }
        Expr.Call(n, args, star) {
            if star || (n != "in" && n != "like" && n != "ilike") { return false }
            for a in args { if !cannotFail(&a) { return false } }
            return true
        }
        else { return false }
    }
}

// (A and X) or (A and Y) -> A and (X or Y), when A is the same conjunct in
// every branch. q19's OR of three joins shares p_partkey = l_partkey, and
// pulling it out is what lets the planner join the tables instead of
// crossing them. Only immutable, subquery-free conjuncts are pulled, and
// only those that cannot fail: A then runs before the branches' guards
// ("id > 100 and 1/(id - 5) > 0").
fn pullCommonOr(x: &Expr): Expr {
    if !matchesOr(x) { return lexdb_sql.cloneExpr(x) }
    var branches: []Expr = []
    orParts(x, mut &branches)
    if len(branches) < 2 { return lexdb_sql.cloneExpr(x) }
    var parts: [][]Expr = []
    for b in branches {
        var ps: []Expr = []
        andParts(&b, mut &ps)
        append(mut &parts, ps)
    }
    var common: []Expr = []
    for c in parts[0] {
        if !immutable(&c) || hasSubCall(&c) || !cannotFail(&c) { continue }
        var all = true
        for j in 1..len(parts) {
            var found = false
            for d in parts[j] { if sameExpr(&c, &d) { found = true } }
            if !found { all = false }
        }
        if all { append(mut &common, lexdb_sql.cloneExpr(&c)) }
    }
    if len(common) == 0 { return lexdb_sql.cloneExpr(x) }
    var rest: []Expr = []
    for j in 0..len(parts) {
        var rem: []Expr = []
        for d in parts[j] {
            var used = false
            for c in common { if sameExpr(&c, &d) { used = true } }
            if !used { append(mut &rem, lexdb_sql.cloneExpr(&d)) }
        }
        append(mut &rest, andOf(&rem))
    }
    append(mut &common, orOf(&rest))
    return andOf(&common)
}

// The necessary filter an OR of branches puts on one table: each branch's
// conditions on it, or'd. Branch 1's part may pair with branch 2's
// lineitem, so the full OR stays at the join; this only cuts the table's
// rows first, as PostgreSQL's BitmapOr does with an index per branch.
// Only conditions that cannot fail are copied: the table's rows are tested
// before the join, some of them rows the OR itself never sees (a.id = 5
// with no b row: "1/(a.id - 5) > 0" would divide by zero). Leaving one out
// keeps the filter necessary, only weaker.
fn orLevels(x: &Expr, k: int, q: &Query): Option[Expr] {
    var branches: []Expr = []
    orParts(x, mut &branches)
    var outs: []Expr = []
    for b in branches {
        var ps: []Expr = []
        andParts(&b, mut &ps)
        var local: []Expr = []
        for d in ps {
            if q.levelMask(&d) == (1 << k) && !hasCorr(&d) && !hasSubCall(&d) && cannotFail(&d) { append(mut &local, lexdb_sql.cloneExpr(&d)) }
        }
        if len(local) == 0 { return None }
        append(mut &outs, andOf(&local))
    }
    if len(outs) < 2 { return None }
    return Some(orOf(&outs))
}

// Runs a subquery: EXISTS stops at its first row, a scalar at its second.
fn runSub(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sp: &SubPlan, params: &[]Val, parent: mut &Run,
          i: int): Result[SubRes, DbErr] {
    let cap = if sp.use == lexdb_sql.SUB_EXISTS { 1 } else if sp.use == lexdb_sql.SUB_SCALAR { 2 } else { -1 }
    var res = try runChild(st, txn, &sp.sel, params, cap, parent, i)
    if sp.use == lexdb_sql.SUB_IN && (sp.readAs != 0 || (len(sp.sel.outs) > 0 && sp.sel.outs[0].oid == lexdb_sql.OID_BPCHAR)) {
        // its values as they are compared (inVal: a char's without its blanks, texts
        // read as the value's type as = reads them), before they are classed
        let rz = txn.sql.zone.clone()
        for k in 0..len(res.rows) { res.rows[k][0] = try inVal(sp, replace(mut &res.rows[k][0], Val.Null), &rz) }
    }
    var out = emptyRes()
    out.v.rows = len(res.rows)
    if sp.use == lexdb_sql.SUB_SCALAR {
        if len(res.rows) > 1 { return Err(e("21000", "more than one row returned by a subquery used as an expression")) }
        if len(res.rows) == 1 { out.v.val = replace(mut &res.rows[0][0], Val.Null) }
    } else if sp.use == lexdb_sql.SUB_IN {
        // the values' class (lexdb_pipe.inClass), all the same or -1 (pathScans);
        // numbers by value when any is an integer or numeric (lexdb_pipe.setKey)
        for r in res.rows {
            if lexdb_ops.isNull(&r[0]) { continue }
            let c = lexdb_pipe.inClass(&r[0])
            if out.cls == -2 { out.cls = c } else if out.cls != c { out.cls = -1 }
            match r[0] {
                Val.Int(_) { out.v.numeric = true }
                Val.Num(_) { out.v.numeric = true }
                else {}
            }
        }
        let z = txn.sql.zone.clone()
        for r in res.rows {
            if lexdb_ops.isNull(&r[0]) {
                out.v.hasNull = true
                continue
            }
            let v = lexdb_sort.collVal(sp.kind, &r[0])
            var ks: []str = []
            lexdb_pipe.inValKeys(&v, out.v.numeric, false, &z, mut &ks)
            if len(ks) == 0 { continue }
            if out.v.set.get(&ks[0]).isNone() { append(mut &out.vals, v) }
            for k in move(ks) { out.v.set.put(k, 1) }
        }
    }
    return Ok(out)
}

// The values of the correlated subqueries in x for env's row, into cur.
fn fillCur(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, x: &Expr, env: &Env, rs: mut &Run,
           cur: mut &[]Val): Result[Unit, DbErr] {
    let sqe = seqEnv(st, txn)
    match x {
        Expr.Unary(_, a) { return fillCur(st, txn, q, &a, env, rs, cur) }
        Expr.Bin(_, a, b) {
            try fillCur(st, txn, q, &a, env, rs, cur)
            return fillCur(st, txn, q, &b, env, rs, cur)
        }
        Expr.IsNull(a, _) { return fillCur(st, txn, q, &a, env, rs, cur) }
        Expr.Cast(a, _) { return fillCur(st, txn, q, &a, env, rs, cur) }
        Expr.Call(n, args, _) {
            let fixed = lexdb_bind.subFixed(&n)
            if !(lexdb_sql.isSubCall(&n) && len(args) > fixed) {
                for a in args { try fillCur(st, txn, q, &a, env, rs, cur) }
                return Ok(Unit{})
            }
            let i = lexdb_sql.litInt(&args[0])
            var xv = Val.Null
            if n == "#in" {
                try fillCur(st, txn, q, &args[3], env, rs, cur)
                let env2 = Env{cols: env.cols, row: env.row, aggs: env.aggs, params: env.params, subs: env.subs, cur: cur, seq: &sqe}
                xv = try eval(&args[3], &env2)
            }
            var refVals: []Val = []
            for j in fixed..len(args) { append(mut &refVals, try eval(&args[j], env)) }
            if q.subs[i].hashed {
                // its key's outer sides, over the statement's parameters and its refs' values
                var ps: []Val = []
                for j in 0..q.base { append(mut &ps, env.params[j].clone()) }
                for v in move(refVals) { append(mut &ps, v) }
                let noCols: []lexdb_sql.ColDef = []
                let noRow: []Val = []
                let kenv = Env{cols: &noCols, row: &noRow, aggs: &noRow, params: &ps, subs: env.subs, cur: &noRow, seq: &sqe}
                var kv: []Val = []
                for ko in q.subs[i].keyOuter { append(mut &kv, try eval(&ko, &kenv)) }
                rs.stats[i].hits += 1
                cur[i] = hashValue(&n, &env.subs[i], &kv, &xv, envZone(env))
                return Ok(Unit{})
            }
            let key = valsKey(&refVals)
            var at = -1
            match rs.memo[i].get(&key) {
                Some(k) { at = k }
                None {}
            }
            if at >= 0 {
                rs.stats[i].hits += 1
                cur[i] = lexdb_pipe.subValue(&n, &rs.memoRes[i][at].v, &xv, envZone(env))
                return Ok(Unit{})
            }
            var ps: []Val = []
            for j in 0..q.base { append(mut &ps, env.params[j].clone()) }
            for v in move(refVals) { append(mut &ps, v) }
            let r = try runSub(st, txn, &q.subs[i], &ps, rs, i)
            cur[i] = lexdb_pipe.subValue(&n, &r.v, &xv, envZone(env))
            if len(rs.memoRes[i]) < MEMO_MAX {
                try rs.bud.hold(resBytes(&r) + len(key) + 48)
                rs.memo[i].put(key, len(rs.memoRes[i]))
                append(mut &rs.memoRes[i], r)
            }
            return Ok(Unit{})
        }
        else { return Ok(Unit{}) }
    }
}

// eval, running x's correlated subqueries for env's row first.
fn evalX(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, x: &Expr, env: &Env,
         rs: mut &Run): Result[Val, DbErr] {
    if !q.corr || !hasCorr(x) { return eval(x, env) }
    let sqe = seqEnv(st, txn)
    var cur: []Val = array(len(q.subs), Val.Null)
    try fillCur(st, txn, q, x, env, rs, mut &cur)
    let env2 = Env{cols: env.cols, row: env.row, aggs: env.aggs, params: env.params, subs: env.subs, cur: &cur, seq: &sqe}
    return eval(x, &env2)
}

// The conditions xs of q compiled (9.108); None those eval evaluates (a
// correlated subquery's among them).
fn cxsOf(q: &Query, xs: &[]Expr, params: &[]Val): []Option[lexdb_bind.BX] {
    var out: []Option[lexdb_bind.BX] = []
    for x in xs {
        append(mut &out, if !(q.corr && hasCorr(&x)) { lexdb_bind.bindExpr(&x, &q.cols, params, false, &typing()) } else { None })
    }
    return out
}

// Whether q's levels' conditions were bound for the plan (bindSel) and
// are still its conditions, one each.
fn boundOnce(q: &Query): bool {
    if len(q.cc) != len(q.levels) || len(q.cp) != len(q.levels) { return false }
    for k in 0..len(q.levels) { if len(q.cc[k]) != len(q.levels[k].cond) || len(q.cp[k]) != len(q.levels[k].post) { return false } }
    return true
}

// The levels' conditions of sel's queries (its own, its parts', its
// subqueries', recursively) bound once (lexdb_bind.bindExpr, parameters as
// slots), for every run of the plan: prepare reads them, not binding them
// again per run (a correlated subquery's 8,508 runs in q20).
fn bindSel(sel: mut &Sel) {
    bindQuery(mut &sel.q)
    let none: []Val = []
    var ox: []Option[lexdb_bind.BX] = []
    for x in sel.exprs {
        var col = false
        match x {
            Expr.Col(name, sl) { col = lexdb_bind.colSlot(&sel.q.cols, &name, sl) >= 0 }
            else {}
        }
        append(mut &ox, if col || (sel.q.corr && hasCorr(&x)) { None } else { lexdb_bind.bindExpr(&x, &sel.q.cols, &none, false, &typing()) })
    }
    var par = false
    for x in ox {
        match x {
            Some(b) { if lexdb_bind.hasParam(&b) { par = true } }
            None {}
        }
    }
    sel.ox = ox
    sel.oxParam = par
    for i in 0..len(sel.parts) { bindSel(mut &sel.parts[i]) }
}

fn bindQuery(q: mut &Query) {
    let none: []Val = []
    var cc: [][]Option[lexdb_bind.BX] = []
    var cp: [][]Option[lexdb_bind.BX] = []
    for k in 0..len(q.levels) {
        append(mut &cc, cxsOf(q, &q.levels[k].cond, &none))
        append(mut &cp, cxsOf(q, &q.levels[k].post, &none))
    }
    q.cc = cc
    q.cp = cp
    for i in 0..len(q.subs) { bindSel(mut &q.subs[i].sel) }
}

// allTrueX, the conditions compiled in ccs (cxsOf) run by cEval.
fn allTrueC(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, cs: &[]Expr, ccs: &[]Option[lexdb_bind.BX],
            row: &[]Val, params: &[]Val, rs: mut &Run): Result[bool, DbErr] {
    if len(cs) == 0 { return Ok(true) }
    if len(ccs) != len(cs) { return allTrueX(st, txn, q, m, cs, row, params, rs) }
    let noAggs: []Val = []
    var all = true
    for c in ccs { if c.isNone() { all = false } }
    if all {
        for i in 0..len(cs) {
            match ccs[i] {
                Some(cx) { if lexdb_ops.truth(&(try lexdb_pipe.bxEval(&cx, row, &noAggs, &m.ce))) != Some(true) { return Ok(false) } }
                None {}
            }
        }
        return Ok(true)
    }
    // in order, as allTrueX (a later condition's error not given when an
    // earlier one fails)
    let sqe = seqEnv(st, txn)
    let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
    for i in 0..len(cs) {
        match ccs[i] {
            Some(cx) { if lexdb_ops.truth(&(try lexdb_pipe.bxEval(&cx, row, &noAggs, &m.ce))) != Some(true) { return Ok(false) } }
            None { if lexdb_ops.truth(&(try evalX(st, txn, q, &cs[i], &env, rs))) != Some(true) { return Ok(false) } }
        }
    }
    return Ok(true)
}

fn allTrueX(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, cs: &[]Expr, row: &[]Val,
            params: &[]Val, rs: mut &Run): Result[bool, DbErr] {
    let sqe = seqEnv(st, txn)
    if len(cs) == 0 { return Ok(true) }
    let noAggs: []Val = []
    let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
    for c in cs { if lexdb_ops.truth(&(try evalX(st, txn, q, &c, &env, rs))) != Some(true) { return Ok(false) } }
    return Ok(true)
}

// What a query's run reads besides its tables: per hash-joined level its
// rows, and the results of the subqueries run once.
type Mats = record {
    vrows: [][][]Val            // per level of rows held by the run: its rows
    mat: [][][]Val
    keys: []Map[str, int]       // hash key -> bucket
    ikeys: []Map[int, int]      // a semi-join's one integer key: value -> bucket
    buckets: [][][]int          // rows of mat
    resMixed: [][]bool          // a semi/anti "inner <> outer": per bucket, more than one inner value
    resSingle: [][]Val          // ... or its one inner value (NULL: only NULLs or no row)
    subs: []SubRes
    // per level, its conditions and the WHERE conjuncts after it compiled
    // (9.108: columns by place, functions bound once), with batches on;
    // None: evaluated by eval
    cc: [][]Option[lexdb_bind.BX]
    cp: [][]Option[lexdb_bind.BX]
    ce: Ctx
}

// Before a query runs: its subqueries without refs, then its hash tables.
fn prepare(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, params: &[]Val,
           rs: mut &Run): Result[Mats, DbErr] {
    return prepareIn(st, txn, q, params, rs, true, true)
}

// prepare; bind: the levels' conditions bound for the run where the plan
// did not bind them (false: the pipeline's plan holds them).
fn prepareIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, params: &[]Val,
             rs: mut &Run, bind: bool, mat: bool): Result[Mats, DbErr] {
    var m = Mats{vrows: [], mat: [], keys: [], ikeys: [], buckets: [], resMixed: [], resSingle: [], subs: [], cc: [], cp: [], ce: cenvOf(seqEnv(st, txn))}
    for k in 0..len(q.levels) {
        append(mut &m.vrows, [])
        append(mut &m.mat, [])
        append(mut &m.keys, newMap())
        append(mut &m.ikeys, newMap())
        append(mut &m.buckets, [])
        append(mut &m.resMixed, [])
        append(mut &m.resSingle, [])
    }
    m.ce.params = collections.copyOf(params)
    if bind && !boundOnce(q) {
        for k in 0..len(q.levels) {
            append(mut &m.cc, cxsOf(q, &q.levels[k].cond, params))
            append(mut &m.cp, cxsOf(q, &q.levels[k].post, params))
        }
    }
    m.subs = try runSubs(st, txn, q, params, rs)
    if rs.batch { m.ce.subs = condSubVals(q, &m.subs) }
    // the levels' rows: a subquery's (each is read by one level), a working table's
    for k in 0..len(q.levels) {
        if q.levels[k].src >= 0 { m.vrows[k] = replace(mut &m.subs[q.levels[k].src].data, []) }
        if q.levels[k].semi { m.vrows[k] = cutRows(replace(mut &m.vrows[k], []), len(q.levels[k].t.cols)) }
        if q.levels[k].work >= 0 {
            let at = cacheAt(&rs.cache, &("w" + q.levels[k].work.toStr()))
            if at < 0 { return Err(e("XX000", "a working table is missing")) }
            m.vrows[k] = copyRows(&rs.cache.rows[at])
        }
    }
    // (the pipeline builds a join's hashes itself: slice P2; a levels
    // program's too, Query.jp)
    if mat && !(rs.batch && q.jp.isSome()) { try materialize(st, txn, q, mut &m, params, rs) }
    return Ok(m)
}

// q's subqueries run before it: those run once, in FROM, of a semi-join or
// hashed; a correlated one's result is made per row (emptyRes here).
fn runSubs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, params: &[]Val, rs: mut &Run): Result[[]SubRes, DbErr] {
    // (the results of a run the pipeline gave up: kept, not run again)
    if len(rs.pre) > 0 && len(rs.pre) == len(q.subs) {
        return Ok(replace(mut &rs.pre, []))
    }
    var subs: []SubRes = []
    for i in 0..len(q.subs) {
        let sp = &q.subs[i]
        if len(sp.sel.q.refs) > 0 && !sp.hashed {
            append(mut &subs, emptyRes())
            continue
        }
        var ps: []Val = []
        for j in 0..q.base { append(mut &ps, params[j].clone()) }
        if lazySeries(q, i) {
            append(mut &subs, try seriesRes(st, txn, sp, &ps, rs))
        } else if sp.use == lexdb_sql.SUB_FROM {
            append(mut &subs, try runFrom(st, txn, sp, &ps, rs, i))
        } else if sp.semi {
            append(mut &subs, try runSemi(st, txn, sp, &ps, rs, i))
        } else if sp.hashed {
            append(mut &subs, try runHashed(st, txn, sp, &ps, rs, i))
        } else {
            append(mut &subs, try runSub(st, txn, sp, &ps, rs, i))
        }
        try rs.bud.hold(resBytes(&subs[len(subs) - 1]))
    }
    return Ok(subs)
}

// The numbers of the subqueries x calls (a #sub, #exists or #in call's first argument).
fn subCalls(x: &Expr, out: mut &[]int) {
    match x {
        Expr.Unary(_, a) { subCalls(&a, out) }
        Expr.Bin(_, a, b) {
            subCalls(&a, out)
            subCalls(&b, out)
        }
        Expr.IsNull(a, _) { subCalls(&a, out) }
        Expr.Cast(a, _) { subCalls(&a, out) }
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) && len(args) > 0 { append(out, lexdb_sql.litInt(&args[0])) }
            for a in args { subCalls(&a, out) }
        }
        else {}
    }
}

// Whether q's subquery i runs once before the query (no outer values, not in
// FROM, not a semi join, hashed or looked up): its value is the run's.
fn subOnce(q: &Query, i: int): bool {
    if i < 0 || i >= len(q.subs) { return false }
    let sp = &q.subs[i]
    if sp.use == lexdb_sql.SUB_FROM || len(sp.sel.q.refs) > 0 || sp.hashed || sp.semi { return false }
    for lv in q.levels { if lv.semiSub == i { return false } }
    return true
}

// The values of the subqueries run once that q's first level's conditions
// call (Ctx.subs: by number, the others empty), which its batches read
// (bCondNode): copied from subs, which the row path reads. [] when no
// condition calls one.
fn condSubVals(q: &Query, subs: &[]SubRes): []lexdb_pipe.SubVal {
    if len(q.levels) == 0 || len(q.subs) == 0 { return [] }
    var used: []int = []
    for x in q.levels[0].cond { subCalls(&x, mut &used) }
    if len(used) == 0 { return [] }
    var out: []lexdb_pipe.SubVal = []
    for i in 0..len(subs) { append(mut &out, lexdb_pipe.noSubVal()) }
    for i in used { if i < len(subs) && subOnce(q, i) { out[i] = lexdb_pipe.copySub(&subs[i].v) } }
    return out
}

// The values of subs, moved out for a plan's run (lexdb_pipe.Ctx.subs);
// subsBack puts them back.
fn subVals(subs: mut &[]SubRes): []lexdb_pipe.SubVal {
    var out: []lexdb_pipe.SubVal = []
    for i in 0..len(subs) { append(mut &out, replace(mut &subs[i].v, lexdb_pipe.noSubVal())) }
    return out
}

fn subsBack(subs: mut &[]SubRes, vs: []lexdb_pipe.SubVal) {
    var v = vs
    for i in 0..len(v) { subs[i].v = replace(mut &v[i], lexdb_pipe.noSubVal()) }
}

// EXPLAIN's lines for a query's subqueries (with their runs, ANALYZE).
// q's subqueries as the physical plan has them (lexdb_plan.PSub): each
// one's plan, and how it runs, as the planner left it.
fn subsOf(q: &Query): []lexdb_plan.PSub {
    var out: []lexdb_plan.PSub = []
    for i in 0..len(q.subs) {
        let sp = &q.subs[i]
        var run = lexdb_plan.RUN_PER_ROW
        var anti = false
        var looked = false
        for lv in q.levels {
            if lv.semiSub == i {
                looked = true
                anti = lv.anti
            }
        }
        if looked {
            // a join's level looked up per row (semiLook): not run; its
            // table is the level's now
            run = lexdb_plan.RUN_LOOKED
        } else if sp.semi {
            // NOT EXISTS's level is an anti join (Level.anti)
            run = lexdb_plan.RUN_SEMI
            for lv in q.levels { if lv.semi && lv.src == i && lv.anti { anti = true } }
        } else if sp.hashed {
            run = lexdb_plan.RUN_HASHED
        } else if len(sp.sel.q.refs) == 0 {
            run = lexdb_plan.RUN_ONCE
        }
        append(mut &out, lexdb_plan.PSub{use: sp.use, run: run, anti: anti, plan: physOf(&sp.sel)})
    }
    return out
}

// A planned Sel's operators (lexdb_plan.PPlan; design/lexdb-layers.md 6.1,
// step 3), made when asked, in the order execSel applies them. The Sel holds
// their details.
fn physOf(sel: &Sel): lexdb_plan.PPlan {
    let subs = subsOf(&sel.q)
    if sel.setop != 0 {
        var parts: []lexdb_plan.PPlan = []
        for i in 0..len(sel.parts) { append(mut &parts, physOf(&sel.parts[i])) }
        let set = lexdb_plan.PPlan.SetOp(sel.setop, sel.setAll, sel.rec, parts, subs)
        let sorted = if len(sel.order) > 0 { lexdb_plan.PPlan.Sort(set, sel.sort, None) } else { set }
        return if sel.limit >= 0 || sel.offset > 0 { lexdb_plan.PPlan.Limit(sorted, false, sel.limit, max(sel.offset, 0)) } else { sorted }
    }
    let leaf = if len(sel.srf) > 0 { lexdb_plan.PPlan.Func(sel.srf.toStr(), sel.ordin, subs) }
               else if len(sel.q.levels) == 0 { lexdb_plan.PPlan.Result(subs) }
               else { lexdb_plan.PPlan.Levels(len(sel.q.levels), subs) }
    let p1 = if sel.first >= 0 { lexdb_plan.PPlan.MinMax(leaf) } else { leaf }
    let p2 = if len(sel.groupBy) > 0 || (sel.aggQ && sel.first < 0) { lexdb_plan.PPlan.Agg(p1, len(sel.gsets) > 0, None) } else { p1 }
    return physAbove(sel, p2)
}

// physOf's operators over the groups (or the rows): HAVING, the window
// calls, the select list, DISTINCT, ORDER BY, the locks, the LIMIT and
// MATCH_RECOGNIZE, as views over p2.
fn physAbove(sel: &Sel, p2: lexdb_plan.PPlan): lexdb_plan.PPlan {
    let p3 = if sel.having.isSome() { lexdb_plan.PPlan.Having(p2) } else { p2 }
    let p4 = if len(sel.wins) > 0 { lexdb_plan.PPlan.Window(p3) } else { p3 }
    // a function's select list is its arguments
    let p5 = if len(sel.srf) == 0 { lexdb_plan.PPlan.Project(p4, []) } else { p4 }
    let p6 = if sel.distinct { lexdb_plan.PPlan.Distinct(p5, sel.donKey > 0, []) } else { p5 }
    let p7 = if len(sel.order) > 0 { lexdb_plan.PPlan.Sort(p6, sel.sort, None) } else { p6 }
    let p8 = if len(sel.locks) > 0 { lexdb_plan.PPlan.Lock(p7) } else { p7 }
    let p9 = if sel.limit >= 0 || sel.offset > 0 || sel.topMode != 0 { lexdb_plan.PPlan.Limit(p8, sel.limit >= 0 && !sel.aggQ && !sel.sort, sel.limit, max(sel.offset, 0)) } else { p8 }
    return if len(sel.mr) > 0 { lexdb_plan.PPlan.Match(p9) } else { p9 }
}

// EXPLAIN's lines for q's subqueries (subs: their plans, subsOf).
fn subLines(q: &Query, subs: &[]lexdb_plan.PSub, stats: &[]SubStat, out: mut &[]str) {
    let none: []lexdb_pipe.Counts = []
    let noStats: []SubStat = []
    for i in 0..len(q.subs) {
        let sp = &q.subs[i]
        let ps = &subs[i]
        let what = if sp.use == lexdb_sql.SUB_EXISTS { "exists" } else if sp.use == lexdb_sql.SUB_IN { "in" } else if sp.use == lexdb_sql.SUB_FROM { "from" } else { "scalar" }
        var head = "subquery " + (i + 1).toStr() + " (" + what + "): "
        if ps.run == lexdb_plan.RUN_LOOKED {
            append(out, head + (if ps.anti { "anti join" } else { "semi join" }) + ", looked up per row by the join")
            continue
        }
        if ps.run == lexdb_plan.RUN_SEMI {
            head = head + (if ps.anti { "anti join" } else { "semi join" }) + (if sp.hashed { " on " + strings.join(&sp.keyText, ", ") } else { "" })
            if len(sp.resText) > 0 { head = head + ", filter " + strings.join(&sp.resText, " and ") }
            head = head + ", run once"
        } else if ps.run == lexdb_plan.RUN_HASHED {
            head = head + "hashed on " + strings.join(&sp.keyText, ", ")
        } else if ps.run == lexdb_plan.RUN_ONCE {
            head = head + "run once"
        } else {
            var rs: []str = []
            for r in sp.sel.q.refs {
                match r {
                    Expr.Col(n, _) { append(mut &rs, n.clone()) }
                    else { append(mut &rs, "an outer value") }
                }
            }
            head = head + "per row, on " + strings.join(&rs, ", ")
        }
        var inner: []str = []
        if i < len(stats) && ps.run == lexdb_plan.RUN_SEMI {
            head = head + " (runs " + stats[i].runs.toStr() + ")"
            inner = planLines(&sp.sel, &ps.plan, &stats[i].cnt, &stats[i].inner)
        } else if i < len(stats) && ps.run == lexdb_plan.RUN_HASHED {
            head = head + " (runs " + stats[i].runs.toStr() + ", probes " + stats[i].hits.toStr() + ")"
            inner = planLines(&sp.sel, &ps.plan, &stats[i].cnt, &stats[i].inner)
        } else if i < len(stats) {
            head = head + " (runs " + stats[i].runs.toStr() + ", from cache " + stats[i].hits.toStr() + ")"
            inner = planLines(&sp.sel, &ps.plan, &stats[i].cnt, &stats[i].inner)
        } else {
            inner = planLines(&sp.sel, &ps.plan, &none, &noStats)
        }
        append(out, head)
        for l in inner { append(out, "  " + l) }
    }
}

// A level's figure (optimizer 23, optimizer 24): "" when none.
fn estText(lv: &Level): str {
    if lv.estRows < 0 { return "" }
    return if lv.estMax { " (at most " } else { " (estimated " } + lv.estRows.toStr() + " rows)"
}

fn pathText(lv: &Level): str {
    if lv.lateral { return "rows of subquery " + (lv.src + 1).toStr() + ", run" }
    if lv.src >= 0 { return "rows of subquery " + (lv.src + 1).toStr() }
    if lv.work >= 0 { return "rows of the working table" }
    let p = &lv.path
    let cols = keyCols(&lv.t, p.index)
    if len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 {
        let many = if p.inSub >= 0 { " value of subquery " + (p.inSub + 1).toStr() } else if len(p.inArr) > 0 { " element of the array" } else { " of " + len(p.ins).toStr() + " values" }
        let each = " for each" + many + (if p.desc { " backward" } else { "" })
        if p.index < 0 { return "primary key " + (if len(p.eqs) + 1 == len(cols) { "lookup" } else { "range" }) + each + estText(lv) }
        return "index " + lexdb_sql.baseName(&lv.t.indexes[p.index].name) + (if lv.t.indexes[p.index].pred.isSome() { " (filtered)" } else { "" }) +
               " lookup" + each + (if ixCovers(lv, p.index) { ", index only" } else { "" }) + estText(lv)
    }
    if p.index < 0 {
        if len(p.eqs) == len(cols) { return "primary key lookup" }
        if len(p.eqs) > 0 || len(p.rng) > 0 { return "primary key range" + estText(lv) }
        return "full scan" + (if p.desc { " backward" } else { "" })
    }
    let what = if len(p.eqs) == len(cols) { " lookup" } else if len(p.eqs) > 0 || len(p.rng) > 0 { " range" } else { " scan" }
    let filtered = if lv.t.indexes[p.index].pred.isSome() { " (filtered)" } else { "" }
    let alone = if ixCovers(lv, p.index) { ", index only" } else { "" }
    return "index " + lexdb_sql.baseName(&lv.t.indexes[p.index].name) + filtered + what + (if p.desc { " backward" } else { "" }) + alone + estText(lv)
}

// EXPLAIN: a line per table; with counts (EXPLAIN ANALYZE), what each did.
fn explainLines(q: &Query, cnt: &[]lexdb_pipe.Counts): []str {
    var out: []str = []
    for k in 0..len(q.levels) {
        var tail = ""
        if len(cnt) > 0 {
            let c = cnt[k]
            var parts: []str = []
            if k > 0 && !q.levels[k].perRow {
                append(mut &parts, "table rows " + c.kept.toStr() + " of " + c.built.toStr() + " read")
                append(mut &parts, "probes " + c.starts.toStr())
            } else if k > 0 {
                append(mut &parts, "lookups " + c.starts.toStr())
            }
            append(mut &parts, "rows read " + c.read.toStr())
            append(mut &parts, (if k == 0 { "kept " } else { "joined " }) + c.joined.toStr())
            if keepsLeft(q.levels[k].join) { append(mut &parts, "null rows " + c.nulls.toStr()) }
            if keepsRight(q.levels[k].join) { append(mut &parts, "unmatched rows " + c.unmatched.toStr()) }
            if c.batches > 0 { append(mut &parts, "batches " + c.batches.toStr()) }
            if c.switched == 1 { append(mut &parts, "switched to scan: the range holds over half the table") }
            if c.switched == 2 { append(mut &parts, "switched to scan: cheaper than the range, by the measured costs") }
            tail = " (" + strings.join(&parts, ", ") + ")"
        }
        let lv = &q.levels[k]
        if lv.semiSub >= 0 {
            // semi join l2: primary key range per row (semiLook)
            let sn = &q.subs[lv.semiSub].sel.q.levels[0].alias
            let filt = if len(lv.cond) > 0 { ", filter per row read" } else { "" }
            append(mut &out, (if lv.anti { "anti join " } else { "semi join " }) + sn + ": " + pathText(lv) + " per row" + filt + tail)
            continue
        }
        if lv.semi {
            // semi join d: hash on (k) over rows of subquery 1
            let sq = &q.subs[lv.src].sel.q
            let sn = if len(sq.levels) == 1 { sq.levels[0].alias.toStr() } else { "subquery " + (lv.src + 1).toStr() }
            var cs: []str = []
            for c in lv.hashCols { append(mut &cs, lv.t.cols[c].name.clone()) }
            // a residual filter: the subquery's line names it
            var filt = ""
            if lv.resNot { filt = ", filter by a summary per key" } else if len(lv.cond) > 0 { filt = ", filter per candidate" }
            append(mut &out, (if lv.anti { "anti join " } else { "semi join " }) + sn + ": hash on (" + strings.join(&cs, ", ") + ") over " + pathText(lv) + filt + tail)
            continue
        }
        let tn = lexdb_sql.baseName(&lv.t.name)
        let name = if lv.alias == tn { tn } else { tn + " " + lv.alias }
        if k == 0 {
            append(mut &out, "scan " + name + ": " + pathText(lv) + tail)
            continue
        }
        let kind = match lv.join {
            lexdb_sql.J_LEFT { "left join " }
            lexdb_sql.J_RIGHT { "right join " }
            lexdb_sql.J_FULL { "full join " }
            lexdb_sql.J_CROSS { "cross join " }
            else { "join " }
        }
        var how = ""
        if lv.perRow {
            how = pathText(lv) + " per row"
        } else if len(lv.hashCols) > 0 {
            var cs: []str = []
            for c in lv.hashCols { append(mut &cs, lv.t.cols[c].name.clone()) }
            how = "hash on (" + strings.join(&cs, ", ") + ") over " + pathText(lv)
        } else {
            how = "loop over " + pathText(lv)
        }
        append(mut &out, kind + name + ": " + how + tail)
    }
    return out
}

fn oneTable(name: &str): []lexdb_sql.FromItem {
    return [lexdb_sql.FromItem{table: name.clone(), alias: lexdb_sql.baseName(name), join: lexdb_sql.J_FIRST, on: None, sub: -1, cols: [], work: -1, lateral: false, using: [], natural: false, comma: false}]
}

// UPDATE's and DELETE's FROM items: the table written (under its alias),
// then UPDATE's FROM or DELETE's USING (9.91), joined to it as a cross join
// that WHERE narrows. The table written is the first level, so its
// columns come first in each row found. A RIGHT or FULL JOIN among the
// others would make the table written NULL in this order (PostgreSQL joins
// the list first): refused.
fn dmlFrom(s: &lexdb_sql.Stmt): Result[[]lexdb_sql.FromItem, DbErr] {
    var out = oneTable(&s.table)
    if len(s.alias) > 0 { out[0].alias = s.alias.clone() }
    for f in s.from {
        if keepsRight(f.join) {
            let what = if s.kind == lexdb_sql.S_UPDATE { "UPDATE ... FROM" } else { "DELETE ... USING" }
            return Err(e("0A000", &("lexdb: RIGHT and FULL joins in " + what + " are not supported")))
        }
        let on: Option[Expr] = match f.on {
            Some(x) { Some(lexdb_sql.cloneExpr(&x)) }
            None { None }
        }
        var cols: []str = []
        for c in f.cols { append(mut &cols, c.clone()) }
        var us: []str = []
        for u in f.using { append(mut &us, u.clone()) }
        append(mut &out, lexdb_sql.FromItem{table: f.table.clone(), alias: f.alias.clone(), join: f.join, on: on, sub: f.sub, cols: cols, work: f.work, lateral: f.lateral, using: us, natural: f.natural, comma: f.comma})
    }
    return Ok(out)
}

// The rows found by UPDATE ... FROM or DELETE ... USING, once per row of t
// (its columns first): PostgreSQL also changes a row that several rows of
// FROM join once, with one of them.
fn onceEach(t: &Table, found: [][]Val, joined: bool): [][]Val {
    if !joined { return found }
    var seen: Map[str, int] = newMap()
    var out: [][]Val = []
    for r in found {
        let k = keyOf(t, &r)
        if seen.has(&k) { continue }
        seen.put(k, 1)
        append(mut &out, collections.copyOf(&r))
    }
    return out
}

// The first n values of r: the table written's, in a joined row.
fn rowPrefix(r: &[]Val, n: int): []Val {
    if len(r) == n { return collections.copyOf(r) }
    var out: []Val = []
    for i in 0..n { append(mut &out, r[i].clone()) }
    return out
}

// ---- indexes: an entry per row, its key the indexed columns then the
// primary key, its value the primary key.

fn idxName(name: &str): str {
    var b = ""
    b.addByte(1)                    // the catalog's index names: no table name starts with 1
    b += &name
    return b
}

// An index's k-th value for row of t: its column's, or its expression's
// (9.89), of the expression's type.
fn idxVal(t: &Table, ix: &Index, k: int, row: &[]Val): Result[Val, DbErr] {
    let c = ix.cols[k]
    if c >= 0 { return Ok(lexdb_access.collKeyVal(&t.cols[c], &row[c])) }
    let none: []Val = []
    let noSubs: []SubRes = []
    let noSeq: Option[SeqEnv] = None
    let env = Env{cols: &t.cols, row: row, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: &noSeq}
    let v = try eval(&ix.exprs[k], &env)
    if lexdb_ops.isNull(&v) { return Ok(v) }
    return lexdb_ops.coerce(v, &exprType(t, &ix.exprs[k]))
}

// An index expression's type, from the table's columns.
fn exprType(t: &Table, x: &Expr): lexdb_sql.TypeName {
    let none: []int = []
    let o = exprOid(x, &t.cols, &none)
    return boundType(&lexdb_sql.oidType(if o == 0 || o == 705 { lexdb_sql.OID_TEXT } else { o }))
}

// The type of an index's (or the primary key's: index -1) k-th value, for
// its bounds.
fn keyType(t: &Table, index: int, k: int): lexdb_sql.TypeName {
    if index >= 0 && t.indexes[index].cols[k] < 0 { return exprType(t, &t.indexes[index].exprs[k]) }
    let cols = keyCols(t, index)
    return boundType(&t.cols[cols[k]].typ)
}

// Whether an index expression's value depends on the row alone: no
// function whose value changes (time, random, sequences).
fn immutable(x: &Expr): bool {
    match x {
        Expr.Call(n, args, _) {
            if !lexdb_bind.immutableName(&n) { return false }
            for a in args { if !immutable(&a) { return false } }
            return true
        }
        Expr.Unary(_, a) { return immutable(&a) }
        Expr.Bin(_, a, b) { return immutable(&a) && immutable(&b) }
        Expr.IsNull(a, _) { return immutable(&a) }
        Expr.Cast(a, _) { return immutable(&a) }
        else { return true }
    }
}

// The error for row's value in unique index ix that another row holds
// already (lexdb_access reports the conflict).
fn uniqueErr(t: &Table, ix: &Index, row: &[]Val): Result[DbErr, DbErr] {
    var names: []str = []
    var vals: []str = []
    for k in 0..len(ix.cols) {
        let c = ix.cols[k]
        if c >= 0 { append(mut &names, t.cols[c].name.clone()) } else {
            let none: Option[lexdb_sql.TypeName] = None
            append(mut &names, lexdb_pg.exprText(&ix.exprs[k], &none))
        }
        // the value as written, not its key (L2)
        append(mut &vals, lexdb_sql.text(&(if c >= 0 { row[c].clone() } else { try idxVal(t, ix, k, row) })))
    }
    return Ok(lexdb_base.errDetail("23505", &("duplicate key value violates unique constraint \"" + lexdb_sql.baseName(&ix.name) + "\""),
                                    &("Key (" + strings.join(&names, ", ") + ")=(" + strings.join(&vals, ", ") + ") already exists."), ""))
}

// Whether a row belongs in an index: always, or its predicate is true.
fn inIndex(t: &Table, ix: &Index, row: &[]Val): Result[bool, DbErr] {
    match ix.pred {
        Some(x) {
            let noAggs: []Val = []
            let noParams: []Val = []
            let noSubs: []SubRes = []
            let noSeq: Option[SeqEnv] = None
            let env = Env{cols: &t.cols, row: row, aggs: &noAggs, params: &noParams, subs: &noSubs, cur: &noAggs, seq: &noSeq}
            return Ok(lexdb_ops.truth(&(try bpEval(t, &x, &env))) == Some(true))
        }
        None { return Ok(true) }
    }
}

// ---- statements

fn createTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let key = try createKey(st, txn, &s.table, s.temp)
    if s.onCommit != lexdb_sql.ONC_NONE && !lexdb_catalog.tempRel(&key) { return Err(e("42P16", "ON COMMIT can only be used on temporary tables")) }
    let base = lexdb_sql.baseName(&key)
    let exists = try relExists(st, txn, &key)
    if exists {
        if s.ifFlag {
            notice(st, txn, &"42P07", &("relation \"" + base + "\" already exists, skipping"), &"")
            return Ok(tagOnly("CREATE TABLE"))
        }
        return Err(e("42P07", &("relation \"" + base + "\" already exists")))
    }
    try needCreate(st, txn, &key)
    var t = lexdb_catalog.emptyTable(&key)
    t.spell = s.spell.clone()
    for c in s.cols {
        if colIndex(&t.cols, &c.name) >= 0 { return Err(e("42701", &("column \"" + c.name + "\" specified more than once"))) }
        var col = lexdb_sql.colDef(&c.name, c.typ, c.notNull)
        col.identity = c.identity
        col.spell = c.spell.clone()
        col.coll = c.coll.clone()
        match c.def {
            Some(x) {
                let v = try defaultValue(&x, &col, &seqEnv(st, txn))
                col.def = Some(lexdb_sql.cloneExpr(&x))
            }
            None {}
        }
        append(mut &t.cols, col)
    }
    for p in s.pk {
        let i = colIndex(&t.cols, &p)
        if i < 0 { return Err(e("42703", &("column \"" + p + "\" named in key does not exist"))) }
        t.cols[i].notNull = true
        append(mut &t.pk, i)
    }
    if len(t.pk) > 1 {
        for a in 0..len(t.pk) {
            for b in a + 1..len(t.pk) {
                if t.pk[a] == t.pk[b] { return Err(e("42701", "column appears twice in primary key")) }
            }
        }
    }
    // CONSTRAINT name PRIMARY KEY: its name (9.117)
    if len(t.pk) > 0 && len(s.pkName) > 0 && s.pkName != base + "_pkey" { t.pkName = s.pkName.clone() }
    if len(t.pk) == 0 {
        // no primary key: the rows keyed by a hidden one (9.88)
        var rc = lexdb_sql.colDef(lexdb_catalog.ROWID, lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}, true)
        rc.identity = lexdb_sql.ID_ALWAYS
        append(mut &t.pk, len(t.cols))
        append(mut &t.cols, rc)
    }
    t.tree = st.createTree(txn)
    try makeColSeqs(st, txn, mut &t, -1, &s.idOpts)
    for c in t.cols { try defaultSeqs(st, txn, &c) }
    for c in s.cons { if c.kind != lexdb_sql.C_FOREIGN { try addConstraint(st, txn, mut &t, &c, false) } }
    for c in s.cons { if c.kind == lexdb_sql.C_FOREIGN { try addConstraint(st, txn, mut &t, &c, false) } }
    t.onCommit = s.onCommit
    if s.onCommit > lexdb_sql.ONC_PRESERVE { append(mut &txn.onCommit, key.clone()) }
    try txn.put(lexdb_catalog.CATALOG, &key, &(lexdb_catalog.encTable(&t)))
    try bumpFor(st, txn, &key)
    // its owner, and its columns' sequences' (9.83)
    try ownNew(st, txn, &lexdb_catalog.relObj(&key))
    match try st.get(txn, lexdb_catalog.CATALOG, &key) {
        Some(v) {
            let made = try decTable(&key, &v)
            for c in made.cols { if len(c.seq) > 0 { try ownNew(st, txn, &lexdb_catalog.relObj(&c.seq)) } }
        }
        None {}
    }
    return Ok(tagOnly("CREATE TABLE"))
}

// ---- enum types (9.90)
//
// CREATE TYPE name AS ENUM (labels): a catalog row by the type's OID (from
// its name, as every OID: lexdb_sql.nameOid "T"), its name and its labels
// in order. A column of the type has kind K_ENUM and the type's OID; its
// values are texts, each a label: checked as rows are written. They order
// as their labels do: comparisons (< and the like) and ORDER BY of an enum
// are made comparisons and orders of the labels' places (#enumpos), when
// the query is planned, so an index on the column (in the labels' text
// order) serves equality only.

fn createType(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let key = s.table.clone()
    if lexdb_sql.isQual(&key) {
        let sn = lexdb_sql.schemaOf(&key)
        if sn == "pg_temp" || lexdb_base.isTempSchema(&sn) { return Err(e("0A000", "lexdb: types in the temporary schema are not supported")) }
        if !(try schemaExists(st, txn, &sn)) { return Err(e("3F000", &("schema \"" + sn + "\" does not exist"))) }
    }
    let oid = lexdb_sql.nameOid(&"T", &key)
    let isTable = len(s.names) == 1 && s.names[0] == "table" && len(s.index) > 0
    if (try lexdb_catalog.readEnum(st, txn, oid)).isSome() || (try lexdb_catalog.readTabType(st, txn, &key)).isSome() {
        if isTable { return Err(e("TS219", &("The type '" + s.alias + "' already exists, or you do not have permission to create it."))) }
        return Err(e("42710", &("type \"" + lexdb_sql.baseName(&key) + "\" already exists")))
    }
    if isTable {
        let spell = if len(s.spell) > 0 { s.spell.clone() } else { lexdb_sql.baseName(&key) }
        try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.tabTypeKey(&key)), &(lexdb_catalog.encTabType(&TabType{key: key, spell: spell, body: s.index.clone(), cols: parseTabTypeCols(&s.index)})))
        try bumpCatalog(st, txn)
        return Ok(tagOnly("CREATE TYPE"))
    }
    for i in 0..len(s.names) {
        if len(s.names[i]) == 0 || len(s.names[i]) > 63 {
            return Err(e("22P02", &("invalid enum label \"" + s.names[i] + "\"")))
        }
        // (PostgreSQL's: its pg_enum's unique index)
        for j in 0..i { if s.names[j] == s.names[i] { return Err(e("23505", "duplicate key value violates unique constraint \"pg_enum_typid_label_index\"")) } }
    }
    try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.enumKey(oid)), &(lexdb_catalog.encEnum(&EnumType{key: key, oid: oid, labels: collections.copyOf(&s.names)})))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("CREATE TYPE"))
}

fn dropType(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var names: []str = [s.table.clone()]
    for n in s.names { append(mut &names, n.clone()) }
    for ni in 0..len(names) {
        let n = &names[ni]
        let oid = lexdb_sql.nameOid(&"T", &n)
        if (try lexdb_catalog.readEnum(st, txn, oid)).isNone() && (try lexdb_catalog.readTabType(st, txn, &n)).isSome() {
            txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.tabTypeKey(&n)))
            continue
        }
        if (try lexdb_catalog.readEnum(st, txn, oid)).isNone() {
            if s.ifFlag && ni < len(s.spells) { continue }          // T-SQL's: no message
            if ni < len(s.spells) {
                return Err(e("TS218", &("Could not find the type '" + s.spells[ni] + "'. Either it does not exist or you do not have the necessary permission.")))
            }
            if s.ifFlag {
                notice(st, txn, &"00000", &("type \"" + lexdb_sql.shown(&n) + "\" does not exist, skipping"), &"")
                continue
            }
            return Err(e("42704", &("type \"" + lexdb_sql.baseName(&n) + "\" does not exist")))
        }
        // a column of the type: refused (CASCADE would drop the columns)
        for t in try allTables(st, txn) {
            for c in t.cols {
                if c.typ.kind == lexdb_sql.K_ENUM && c.typ.oid == oid {
                    if s.cascade { return Err(e("0A000", "lexdb: DROP TYPE ... CASCADE is not supported (drop or change the columns first)")) }
                    return Err(e("2BP01", &("cannot drop type " + lexdb_sql.shown(&n) + " because other objects depend on it")))
                }
            }
        }
        txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.enumKey(oid)))
    }
    try bumpCatalog(st, txn)
    return Ok(tagOnly("DROP TYPE"))
}

fn alterType(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let oid = lexdb_sql.nameOid(&"T", &s.table)
    var en = match try lexdb_catalog.readEnum(st, txn, oid) {
        Some(x) { x }
        None { return Err(e("42704", &("type \"" + lexdb_sql.baseName(&s.table) + "\" does not exist"))) }
    }
    let v = &s.names[0]
    for l in en.labels {
        if l == v {
            if s.ifFlag { return Ok(tagOnly("ALTER TYPE")) }
            return Err(e("42710", &("enum label \"" + v + "\" already exists")))
        }
    }
    if len(v) == 0 || len(v) > 63 { return Err(e("22P02", &("invalid enum label \"" + v + "\""))) }
    var at = len(en.labels)
    if len(s.alias) > 0 {
        var w = -1
        for i in 0..len(en.labels) { if en.labels[i] == s.index { w = i } }
        if w < 0 { return Err(e("22023", &("\"" + s.index + "\" is not an existing enum label"))) }
        at = if s.alias == "before" { w } else { w + 1 }
    }
    var labels: []str = []
    for i in 0..len(en.labels) {
        if i == at { append(mut &labels, v.clone()) }
        append(mut &labels, replace(mut &en.labels[i], ""))
    }
    if at == len(en.labels) { append(mut &labels, v.clone()) }
    en.labels = labels
    try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.enumKey(oid)), &(lexdb_catalog.encEnum(&en)))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("ALTER TYPE"))
}

// ---- table types (T-SQL's CREATE TYPE name AS TABLE (...); design/lexdb-tds.md,
// "As built: table-valued parameters")
//
// A catalog row by the type's key (a table's: dbo is public): its key, its
// name as written, and its definition, the ( ... ) of a CREATE TABLE, as
// text: read again where it is used (sys.columns; the temporary table a
// table-valued parameter becomes, lexdb_tds). Its user_type_id and its
// table's object_id (sys.table_types) are OIDs of its key. It shares its
// names with the enum types (9.90): DROP TYPE drops either.

// A table type's columns as its CREATE TABLE text gives them (sys.columns,
// and a table-valued parameter's temporary table). Parsed here, where the
// grammar lives; lexdb_catalog only carries the result.
fn parseTabTypeCols(body: &str): []lexdb_sql.ColDef {
    let none: []str = []
    match lexdb_parse.tsqlParser(body, lexdb_parse.Dialect{tsql: true, quotedIdent: true}, &none) {
        Ok(q0) {
            var q = q0
            match q.tableDef(&"#t") {
                Ok(s0) {
                    var s = s0
                    var all = replace(mut &s.cols, [])
                    for i in 0..len(all) {
                        for p in s.pk { if p == all[i].name { all[i].notNull = true } }
                    }
                    return all
                }
                Err(_) {}
            }
        }
        Err(_) {}
    }
    return []
}

// A table type's user_type_id, and its table's object_id.
pub fn tabTypeId(key: &str): int { return lexdb_sql.nameOid(&"T", key) }
// The table type of key (T-SQL's name: dbo as public), None if there is none.
pub fn (s: mut &Session) tableType(key: &str): Result[Option[TabType], DbErr] {
    if len(s.txn) > 0 {
        let st = &s.st
        return lexdb_catalog.readTabType(st, mut &s.txn[0], key)
    }
    var t = lexdb_store.begin()
    s.setUp(mut &t)
    let r = lexdb_catalog.readTabType(&s.st, mut &t, key)
    s.st.abort(t)
    return r
}

// A table's columns (as CREATE TABLE made them, its hidden key left out); 42P01 when there is none of the name.
pub fn (s: mut &Session) tableColumns(name: &str): Result[[]lexdb_sql.ColDef, DbErr] {
    var t = try s.tableNamed(name)
    var out: []lexdb_sql.ColDef = []
    for i in 0..len(t.cols) { if t.cols[i].name != lexdb_catalog.ROWID { append(mut &out, replace(mut &t.cols[i], lexdb_sql.colDef("", lexdb_sql.TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}, false))) } }
    return Ok(out)
}

// A row's enum values each one of its type's labels.
fn checkEnums(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, row: &[]Val): Result[Unit, DbErr] {
    for i in 0..len(t.cols) {
        if t.cols[i].typ.kind != lexdb_sql.K_ENUM || lexdb_ops.isNull(&row[i]) { continue }
        match try lexdb_catalog.readEnum(st, txn, t.cols[i].typ.oid) {
            Some(en) {
                let v = lexdb_sql.text(&row[i])
                var found = false
                for l in en.labels { if l == v { found = true } }
                if !found { return Err(e("22P02", &("invalid input value for enum " + lexdb_sql.baseName(&en.key) + ": \"" + v + "\""))) }
            }
            None { return Err(e("42704", &("type of column \"" + t.cols[i].name + "\" does not exist"))) }
        }
    }
    return Ok(Unit{})
}

// The enum type x is of (by its OID), its name and labels joined by \x1f.
fn enumOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, x: &Expr, cols: &[]lexdb_sql.ColDef): Result[Option[str], DbErr] {
    let none: []int = []
    let o = exprOid(x, cols, &none)
    if o < 16384 || lexdb_pgcat.typeOf(o).isSome() { return Ok(None) }
    match try lexdb_catalog.readEnum(st, txn, o) {
        Some(en) {
            var all: []str = [lexdb_sql.baseName(&en.key)]
            for l in en.labels { append(mut &all, l.clone()) }
            return Ok(Some(strings.join(&all, "\x1f")))
        }
        None { return Ok(None) }
    }
}

fn enumPos(x: &Expr, enc: &str): Expr { return Expr.Call("#enumpos", [lexdb_sql.cloneExpr(x), Expr.Lit(Val.Text(enc.toStr()))], false) }

// x with its comparisons of enum values made comparisons of their labels'
// places (9.90).
fn enumOrder(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, x: &Expr, cols: &[]lexdb_sql.ColDef): Result[Expr, DbErr] {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" {
                return Ok(Expr.Bin(op.clone(), try enumOrder(st, txn, &a, cols), try enumOrder(st, txn, &b, cols)))
            }
            if op == "<" || op == "<=" || op == ">" || op == ">=" {
                var enc = try enumOf(st, txn, &a, cols)
                if enc.isNone() { enc = try enumOf(st, txn, &b, cols) }
                match enc {
                    Some(en) { return Ok(Expr.Bin(op.clone(), enumPos(&a, &en), enumPos(&b, &en))) }
                    None {}
                }
            }
            return Ok(lexdb_sql.cloneExpr(x))
        }
        Expr.Unary(op, a) { if op == "not" { return Ok(Expr.Unary(op.clone(), try enumOrder(st, txn, &a, cols))) } }
        else {}
    }
    return Ok(lexdb_sql.cloneExpr(x))
}

// ---- tables without a primary key (9.88)
//
// Their rows are keyed by a hidden bigint column, ROWID, the last of those
// the table was made with, whose identity sequence numbers them: so UPDATE,
// DELETE, indexes, COPY and replication find a row by its key as for any
// table. No SQL can name it (its name starts with a NUL byte, which no
// statement text holds), and what shows a table's columns leaves it out:
// SELECT *, INSERT's and COPY's columns, the catalog (pg_attribute and the
// rest, whose attnums are the others' own, so a column added later leaves a
// gap, as a dropped one does in PostgreSQL), its key's index and sequence.

// A name of the hidden column (a table's, a query's "alias.column", its
// sequence's).

// CREATE TABLE t [(names)] AS query [WITH [NO] DATA], and SELECT ... INTO t
// (9.88): t's columns the query's (named as given, else as its output),
// of their types; no primary key (a hidden one); the rows inserted as the
// query makes them. The tag, as PostgreSQL's: SELECT and the rows.
fn createTableAs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
                 lim: Limits): Result[Res, DbErr] {
    if s.ifFlag {
        // (where it would be made: a temporary one in the session's schema)
        let k = try createKey(st, txn, &s.table, s.temp)
        if (try relExists(st, txn, &k)) {
            notice(st, txn, &"42P07", &("relation \"" + lexdb_sql.baseName(&k) + "\" already exists, skipping"), &"")
            return Ok(tagOnly("CREATE TABLE AS"))
        }
    }
    var sc = newScopeIn(st, txn, params, ptypes)
    var sel = try planSelect(st, txn, &s.inner[0], params, mut &sc)
    bindSel(mut &sel)
    pipeSelIn(mut &sel, false)
    if len(s.names) > len(sel.outs) { return Err(e("42601", "too many column names were specified")) }
    var mk = lexdb_sql.newStmt(lexdb_sql.S_CREATE)
    mk.table = s.table.clone()
    mk.temp = s.temp
    mk.onCommit = s.onCommit
    mk.spell = s.spell.clone()
    for i in 0..len(sel.outs) {
        let n = if i < len(s.names) { s.names[i].clone() } else { sel.outs[i].name.clone() }
        if i >= len(s.names) && sel.outs[i].spell == lexdb_sql.ANON {
            return Err(e("TS1038", "An object or column name is missing or empty. For SELECT INTO statements, verify each column has a name."))
        }
        for c in mk.cols { if c.name == n { return Err(e("42701", &("column \"" + n + "\" specified more than once"))) } }
        let o = sel.outs[i].oid
        let ty = if o == 0 || o == 705 { lexdb_sql.oidType(lexdb_sql.OID_TEXT) } else { lexdb_sql.oidType(o) }
        var col = lexdb_sql.colDef(&n, ty, false)
        col.spell = if i < len(s.names) { if i < len(s.spells) { s.spells[i].clone() } else { "" } } else { sel.outs[i].spell.clone() }
        if ty.kind == lexdb_sql.K_TEXT { col.coll = sel.outs[i].coll.clone() }     // the query's column's collation (L2)
        append(mut &mk.cols, col)
    }
    let made = try createTable(st, txn, &mk)
    if s.noData { return Ok(tagOnly("CREATE TABLE AS")) }
    let t = try byKey(st, txn, &(try createKey(st, txn, &s.table, s.temp)))
    var targets: []int = []
    for i in 0..len(t.cols) { if t.cols[i].name != lexdb_catalog.ROWID { append(mut &targets, i) } }
    let defs = try defaultsOf(st, txn, &t)
    let fw: []Table = []
    var later: []FkLater = []
    var noUp = noUpsert()
    let noCols: []lexdb_sql.ColDef = []
    let none: []Val = []
    let noSubs: []SubRes = []
    let noSeq: Option[SeqEnv] = None
    let noEnv = Env{cols: &noCols, row: &none, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: &noSeq}
    // the query's rows made whole first: it reads in the same transaction
    // (a table made earlier in the block), which the inserts write
    let res = try runSel(st, txn, &sel, params, lim)
    for r in res.rows { let got = try insertOne(st, txn, &t, &targets, &r, &defs, &fw, mut &later, mut &noUp, &noEnv) }
    return Ok(tagOnly(&("SELECT " + len(res.rows).toStr())))
}

fn dropTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    try dropTableNamed(st, txn, &s.table, s)
    for n in s.names { try dropTableNamed(st, txn, &n, s) }
    return Ok(tagOnly("DROP TABLE"))
}

fn dropTableNamed(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    match try findTable(st, txn, name) {
        Some(t) {
            if len(t.view) > 0 { return Err(e("42809", &("\"" + lexdb_sql.shown(name) + "\" is not a table (use DROP VIEW)"))) }
            try needRelOwner(st, txn, &t.name, &"table")
            try dropDependentViews(st, txn, &t.name, s.cascade, &"table")
            var d = t
            try unlinkTable(st, txn, mut &d, s.cascade)
            try dropOwnedSeqs(st, txn, &d, &"")
            dropOne(txn, &d)
            try bumpFor(st, txn, &d.name)
            return Ok(tagOnly("DROP TABLE"))
        }
        None {
            if s.ifFlag {
                notice(st, txn, &"00000", &("table \"" + lexdb_sql.shown(name) + "\" does not exist, skipping"), &"")
                return Ok(tagOnly("DROP TABLE"))
            }
            return Err(e("42P01", &("table \"" + lexdb_sql.shown(name) + "\" does not exist")))
        }
    }
}

// TRUNCATE (9.91): each table named given new, empty trees, its indexes
// too, and the old trees dropped, as PostgreSQL gives it a new file. Rows
// are not deleted one by one, so no foreign key action runs: a table a
// foreign key outside the list references is refused, unless CASCADE adds
// it. RESTART IDENTITY restarts the sequences the tables own (at once, as
// setval: PostgreSQL's is undone by a ROLLBACK).
fn truncate(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var names: []str = [s.table.clone()]
    for n in s.names { append(mut &names, n.clone()) }
    var keys: []str = []
    for n in names {
        match try findTable(st, txn, &n) {
            Some(t) {
                if len(t.view) > 0 { return Err(e("42809", &("\"" + lexdb_sql.baseName(&n) + "\" is not a table"))) }
                addKey(mut &keys, &t.name)
            }
            None { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&n) + "\" does not exist"))) }
        }
    }
    let w = try whoNow(st, txn)
    for k in keys { try needRel(st, txn, &w, &k, &"D", &"table") }
    // the tables that reference them: named too, or added by CASCADE
    var i = 0
    while i < len(keys) {
        let t = try byKey(st, txn, &keys[i])
        for ck in t.refBy {
            if lexdb_base.hasStr(&keys, &ck) { continue }
            if !s.cascade {
                return Err(e("0A000", &("cannot truncate a table referenced in a foreign key constraint: Table \"" + lexdb_sql.baseName(&ck) +
                             "\" references \"" + lexdb_sql.baseName(&t.name) + "\". Truncate table \"" + lexdb_sql.baseName(&ck) +
                             "\" at the same time, or use TRUNCATE ... CASCADE.")))
            }
            try needRel(st, txn, &w, &ck, &"D", &"table")
            append(mut &keys, ck.clone())
        }
        i += 1
    }
    var seqs: []Seq = []
    if s.ifFlag { seqs = try lexdb_catalog.allSeqs(st, txn, &"") }
    for k in keys {
        var t = try byKey(st, txn, &k)
        let old = t.tree
        t.tree = st.createTree(txn)
        txn.dropTree(old)
        for x in 0..len(t.indexes) {
            let oi = t.indexes[x].tree
            t.indexes[x].tree = st.createTree(txn)
            txn.dropTree(oi)
        }
        try putTable(txn, &t)
        for d in seqs { if d.ownerT == t.name { try setVal(st, &d, d.start, false) } }
    }
    try bumpKeys(st, txn, &keys)
    return Ok(tagOnly("TRUNCATE TABLE"))
}

// Every object in temporary schema sc dropped (9.96): its views, its
// tables with their indexes, sequences, foreign keys and grants, and its
// other sequences. Nothing is checked: they are the session's. The count.
fn dropTempIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: &str): Result[int, DbErr] {
    var views: []str = []
    var tabs: []str = []
    try st.scan(txn, lexdb_catalog.CATALOG, &(sc + "\x1f"), &(sc + "\x20"), fn(en: &lexdb_store.Entry): bool {
        if strings.startsWith(&en.val, lexdb_catalog.VIEW_MARK) { append(mut &views, en.key.clone()) } else { append(mut &tabs, en.key.clone()) }
        return true
    })
    for v in views {
        txn.del(lexdb_catalog.CATALOG, &v)
        dropAcl(txn, &lexdb_catalog.relObj(&v))
    }
    for k in tabs {
        // read again: dropping one before may have changed it (its foreign keys)
        match try byKeyOpt(st, txn, &k) {
            Some(t) {
                var d = t
                try unlinkTable(st, txn, mut &d, true)
                try dropOwnedSeqs(st, txn, &d, &"")
                dropOne(txn, &d)
            }
            None {}
        }
    }
    let seqs = try lexdb_catalog.allSeqs(st, txn, sc)
    for d in seqs { try dropSeqRows(st, txn, &d) }
    let n = len(views) + len(tabs) + len(seqs)
    if n > 0 { tmpBump(st, txn) }
    return Ok(n)
}

// The temporary schemas a crash (or a server stopped with sessions open)
// left, dropped when the store opens (9.96): a session's number is used
// again after a restart, and must not find them.
fn dropLeftTemps(st: &lexdb_store.Store): Result[Unit, DbErr] {
    var r = lexdb_store.begin()
    var scs: []str = []
    for pre in ["", "\x04"] {
        try st.scan(mut &r, lexdb_catalog.CATALOG, &(pre + "pg_temp_"), &(pre + "pg_temp`"), fn(en: &lexdb_store.Entry): bool {
            let k = &en.key[len(pre)..len(en.key)]
            let sc = lexdb_sql.schemaOf(k)
            if lexdb_sql.isQual(k) && lexdb_base.isTempSchema(&sc) && !lexdb_base.hasStr(&scs, &sc) { append(mut &scs, sc) }
            return true
        })
    }
    if len(scs) == 0 {
        st.abort(r)
        return Ok(Unit{})
    }
    for sc in scs { let n = try dropTempIn(st, mut &r, &sc) }
    // their owners' rows, should any be left without their objects
    var acls: []str = []
    try st.scan(mut &r, lexdb_catalog.CATALOG, &(lexdb_catalog.ACL_PRE + "r:pg_temp_"), &(lexdb_catalog.ACL_PRE + "r:pg_temp`"), fn(en: &lexdb_store.Entry): bool {
        if lexdb_base.tempCatKey(&en.key) { append(mut &acls, en.key.clone()) }
        return true
    })
    for k in acls { r.del(lexdb_catalog.CATALOG, &k) }
    return st.commit(r)
}

// Before a commit, the ON COMMIT of the session's temporary tables (9.96):
// those ON COMMIT DROP dropped; those ON COMMIT DELETE ROWS emptied, as
// TRUNCATE empties a table (new trees), when they hold rows. have: the
// DELETE ROWS tables known before (Session.onCommit), the transaction's own
// made ones added; gives those still there.
fn onCommitDo(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, have: &[]str): Result[[]str, DbErr] {
    var keys = collections.copyOf(have)
    for k in txn.onCommit { addKey(mut &keys, &k) }
    var kept: []str = []
    var full: []str = []
    for k in keys {
        match try byKeyOpt(st, txn, &k) {
            Some(t) {
                if t.onCommit == lexdb_sql.ONC_DROP {
                    var d = t
                    try dropDependentViews(st, txn, &d.name, true, &"table")
                    try unlinkTable(st, txn, mut &d, true)
                    try dropOwnedSeqs(st, txn, &d, &"")
                    dropOne(txn, &d)
                    tmpBump(st, txn)
                } else if t.onCommit == lexdb_sql.ONC_DELETE {
                    append(mut &kept, k.clone())
                    if try lexdb_access.anyRow(st, txn, &lexdb_catalog.relOf(&t)) { append(mut &full, k.clone()) }
                }
            }
            None {}
        }
    }
    // a table referencing one emptied must be emptied too (PostgreSQL's check)
    for k in kept {
        let t = try byKey(st, txn, &k)
        for r in t.refBy {
            if !lexdb_base.hasStr(&kept, &r) {
                return Err(e("0A000", &("unsupported ON COMMIT and foreign key combination: Table \"" + lexdb_sql.baseName(&r) + "\" references \"" +
                             lexdb_sql.baseName(&k) + "\", but they do not have the same ON COMMIT setting.")))
            }
        }
    }
    for k in full {
        var t = try byKey(st, txn, &k)
        let old = t.tree
        t.tree = st.createTree(txn)
        txn.dropTree(old)
        for x in 0..len(t.indexes) {
            let oi = t.indexes[x].tree
            t.indexes[x].tree = st.createTree(txn)
            txn.dropTree(oi)
        }
        try putTable(txn, &t)
    }
    if len(full) > 0 { tmpBump(st, txn) }
    return Ok(kept)
}

// bumpFor each relation key of ks: the catalog's version once if any is
// not temporary.
fn bumpKeys(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, ks: &[]str): Result[Unit, DbErr] {
    var perm = false
    var temp = false
    for k in ks { if lexdb_catalog.tempRel(&k) { temp = true } else { perm = true } }
    if temp { tmpBump(st, txn) }
    if perm { try bumpCatalog(st, txn) }
    return Ok(Unit{})
}

// VACUUM, ANALYZE, CHECKPOINT, REINDEX and CLUSTER (9.94): each is
// checked as PostgreSQL checks it: the tables, columns, index or schema it
// names must exist, and some cannot run in a block. REINDEX and CLUSTER
// then do nothing (lexdb's pages are reused as freed); VACUUM makes leaves
// of rows column leaves (9.114), ANALYZE keeps statistics (optimizer 20),
// and CHECKPOINT (a superuser's, as PostgreSQL's) takes a checkpoint and
// waits until it is written (design/lexdb.md 9.136): on a replica, nothing.
fn maint(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if s.alias == "CHECKPOINT" {
        let w = try whoNow(st, txn)
        if !w.super { return Err(e("42501", "permission denied to execute CHECKPOINT command")) }
        try st.checkpointAll()
        return Ok(tagOnly(&s.alias))
    }
    if len(s.table) > 0 && txn.inBlock() { return Err(e("25001", &(s.table + " cannot run inside a transaction block"))) }
    for i in 0..len(s.names) {
        let n = &s.names[i]
        match try findTable(st, txn, n) {
            Some(t) {
                if s.unique && len(t.view) > 0 { return Err(e("42809", &("\"" + lexdb_sql.baseName(n) + "\" is not a table or materialized view"))) }
                if i < len(s.maintCols) {
                    let cols = &s.maintCols[i]
                    for j in 0..len(cols) {
                        var found = false
                        for c in t.cols { if c.name == cols[j] && !lexdb_catalog.hiddenName(&c.name) { found = true } }
                        if !found {
                            return Err(e("42703", &("column \"" + cols[j] + "\" of relation \"" + lexdb_sql.baseName(n) + "\" does not exist")))
                        }
                        for k in 0..j {
                            if cols[k] == cols[j] {
                                return Err(e("42701", &("column \"" + cols[j] + "\" of relation \"" + lexdb_sql.baseName(n) + "\" appears more than once")))
                            }
                        }
                    }
                }
            }
            None { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(n) + "\" does not exist"))) }
        }
    }
    // VACUUM (and VACUUM ANALYZE, before its ANALYZE): leaves of rows made
    // column leaves (9.114)
    if s.alias == "VACUUM" && !txn.inBlock() { try vacuumTables(st, txn, &s.names) }
    if strings.startsWith(&s.index, lexdb_sql.SCHEMA_MARK) {
        let sc = s.index[len(lexdb_sql.SCHEMA_MARK)..len(s.index)]
        if !(try schemaExists(st, txn, &sc)) && sc != "pg_catalog" && sc != "information_schema" {
            return Err(e("3F000", &("schema \"" + sc + "\" does not exist")))
        }
    } else if len(s.index) > 0 {
        let ixKey = try catKey(st, txn, &s.index, true)
        var found = try st.get(txn, lexdb_catalog.CATALOG, &(idxName(&ixKey)))
        if found.isNone() {
            // a primary key's index is its table's own tree
            match try pkIndexTable(st, txn, &ixKey) {
                Some(t) { found = Some(t.name.clone()) }
                None {}
            }
        }
        match found {
            Some(tn) {
                // CLUSTER t USING i: i must be t's
                if len(s.names) > 0 {
                    let t = try needTable(st, txn, &s.names[0])
                    if tn != t.name {
                        return Err(e("42809", &("\"" + lexdb_sql.baseName(&ixKey) + "\" is not an index for table \"" + lexdb_sql.baseName(&t.name) + "\"")))
                    }
                }
            }
            None {
                if len(s.names) > 0 {
                    return Err(e("42704", &("index \"" + lexdb_sql.shown(&s.index) + "\" for table \"" + lexdb_sql.shown(&s.names[0]) + "\" does not exist")))
                }
                return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&s.index) + "\" does not exist")))
            }
        }
    }
    return Ok(tagOnly(&s.alias))
}

// A table's trees and catalog rows, its indexes' too.
fn dropOne(txn: mut &lexdb_store.Txn, t: &Table) {
    dropAcl(txn, &lexdb_catalog.relObj(&t.name))
    for ix in t.indexes {
        txn.dropTree(ix.tree)
        txn.del(lexdb_catalog.CATALOG, &(idxName(&ix.name)))
    }
    txn.dropTree(t.tree)
    txn.del(lexdb_catalog.CATALOG, &t.name)
    lexdb_stats.dropStats(txn, &t.name)         // its statistics (optimizer 20)
}

// ---- column defaults (9.38)

// A default calling sequence functions: the sequences it names must be.
fn defaultSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, c: &lexdb_sql.ColDef): Result[Unit, DbErr] {
    match c.def {
        Some(x) {
            var ns: []str = []
            seqNamesOf(&x, mut &ns)
            for n in ns { let d = try needSeq(st, txn, &nameOfText(&n)) }
        }
        None {}
    }
    return Ok(Unit{})
}

// A DEFAULT checked for column c: no column and no aggregate in it; its
// value, of c's type. lexdb has no volatile function, so the value is the
// same whenever it is made: a bad default fails here, not at each INSERT.
// se: the statement's session (its time zone and now(), 9.95), or None
// (UTC) where it is only checked.
fn defaultValue(x: &Expr, c: &lexdb_sql.ColDef, se: &Option[SeqEnv]): Result[Val, DbErr] {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    if len(ns) > 0 { return Err(e("0A000", "cannot use column reference in DEFAULT expression")) }
    if hasAgg(x) { return Err(e("42803", "aggregate functions are not allowed in DEFAULT expressions")) }
    if isVolatile(x) { return Ok(Val.Null) }        // nextval's: per row (defaultsOf)
    let none: []Val = []
    let noCols: []lexdb_sql.ColDef = []
    let noSubs: []SubRes = []
    let env = Env{cols: &noCols, row: &none, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: se}
    return lexdb_ops.coerceZ(try eval(&bpFix(x, &noCols), &env), &c.typ, envZone(&env))
}

// ---- ALTER TABLE (9.34)

// x with column from named to, at slot (-1: not known).
fn renameCol(x: &Expr, from: &str, to: &str, slot: int): Expr {
    match x {
        Expr.Col(n, s) { return if n == from { Expr.Col(to.clone(), slot) } else { Expr.Col(n.clone(), s) } }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), renameCol(&a, from, to, slot)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), renameCol(&a, from, to, slot), renameCol(&b, from, to, slot)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(renameCol(&a, from, to, slot), neg) }
        Expr.Call(f, args, star) {
            var xs: []Expr = []
            for a in args { append(mut &xs, renameCol(&a, from, to, slot)) }
            return Expr.Call(f.clone(), xs, star)
        }
        Expr.Cast(a, ty) { return Expr.Cast(renameCol(&a, from, to, slot), ty) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// Whether the table has a row (col < 0), or a row whose column col is NULL.
fn anyRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, col: int): Result[bool, DbErr] {
    let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
    let sc = lexdb_access.allScan()
    var need: []bool = []
    if col >= 0 {
        for i in 0..len(t.cols) { append(mut &need, i == col) }
    }
    var cur = lexdb_access.newCursor()
    while !cur.done {
        var batch: [][]Val = []
        try fetch(st, txn, t, &path, &sc, &need, mut &cur, mut &batch)
        for r in batch {
            if col < 0 { return Ok(true) }
            match r[col] {
                Val.Null { return Ok(true) }
                else {}
            }
        }
    }
    return Ok(false)
}

// Drops column i: its place in the rows is kept and skipped, and its
// values go as rows are written again. The indexes on it, or whose
// predicate names it, are dropped (as PostgreSQL's are).
fn dropColumn(txn: mut &lexdb_store.Txn, t: mut &Table, i: int): Result[Unit, DbErr] {
    let name = t.cols[i].name.clone()
    for k in t.pk {
        if k == i { return Err(e("0A000", &("lexdb: column \"" + name + "\" is in the primary key, which cannot be changed"))) }
    }
    if len(t.slots) == 0 {
        for k in 0..len(t.cols) { append(mut &t.slots, k) }
        t.width = len(t.cols)
    }
    let gone = collections.removeAt(mut &t.cols, i)
    let place = collections.removeAt(mut &t.slots, i)
    for k in 0..len(t.pk) { if t.pk[k] > i { t.pk[k] -= 1 } }
    var old = replace(mut &t.indexes, [])
    var rev: []Index = []
    while len(old) > 0 {
        var ix = pop(mut &old)
        var uses = false
        for c in ix.cols { if c == i { uses = true } }
        for ixe in ix.exprs {
            var ixn: []str = []
            lexdb_sql.colNames(&ixe, mut &ixn)
            for n in ixn { if n == name { uses = true } }
        }
        match ix.pred {
            Some(x) {
                var ns: []str = []
                lexdb_sql.colNames(&x, mut &ns)
                for n in ns { if n == name { uses = true } }
            }
            None {}
        }
        if uses {
            txn.dropTree(ix.tree)
            txn.del(lexdb_catalog.CATALOG, &(idxName(&ix.name)))
        } else {
            for k in 0..len(ix.cols) { if ix.cols[k] > i { ix.cols[k] -= 1 } }
            append(mut &rev, ix)
        }
    }
    while len(rev) > 0 { append(mut &t.indexes, pop(mut &rev)) }
    // the checks naming it go too (as PostgreSQL's do)
    var k = 0
    while k < len(t.checks) {
        var ns: []str = []
        lexdb_sql.colNames(&t.checks[k].expr, mut &ns)
        var uses = false
        for n in ns { if n == name { uses = true } }
        if uses { let dropped = collections.removeAt(mut &t.checks, k) } else { k += 1 }
    }
    return Ok(Unit{})
}

// ---- moving between schemas, renaming indexes and schemas (9.37)

// Moves table t and its indexes to schema sc, their names kept: their
// catalog rows under the new keys, the index rows naming the table's.
fn moveTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, sc: &str): Result[Unit, DbErr] {
    txn.del(lexdb_catalog.CATALOG, &t.name)
    let old = t.name.clone()
    t.name = lexdb_sql.qual(sc, &lexdb_sql.baseName(&t.name))
    try moveAcl(st, txn, &lexdb_catalog.relObj(&old), &lexdb_catalog.relObj(&t.name))
    try relink(st, txn, t, &old)
    try lexdb_stats.moveStats(st, txn, &old, &t.name)
    try ownerMoved(st, txn, t, &old, &"", &"", sc)
    for k in 0..len(t.indexes) {
        txn.del(lexdb_catalog.CATALOG, &(idxName(&t.indexes[k].name)))
        t.indexes[k].name = lexdb_sql.qual(sc, &lexdb_sql.baseName(&t.indexes[k].name))
    }
    for ix in t.indexes { try txn.put(lexdb_catalog.CATALOG, &(idxName(&ix.name)), &t.name) }
    try txn.put(lexdb_catalog.CATALOG, &t.name, &(lexdb_catalog.encTable(t)))
    return Ok(Unit{})
}

// The table whose primary key's index has catalog key k (its schema's
// tables', by their keys' names: pkConName), if any.
fn pkIndexTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[Option[Table], DbErr] {
    let sc = lexdb_sql.schemaOf(k)
    let base = lexdb_sql.baseName(k)
    var tabs = try seenTables(st, txn)
    while len(tabs) > 0 {
        let t = pop(mut &tabs)
        if lexdb_sql.schemaOf(&t.name) == sc && lexdb_catalog.hasPk(&t) && lexdb_catalog.pkConName(&t) == base { return Ok(Some(t)) }
    }
    return Ok(None)
}

// Whether a table or an index has catalog key k.
fn relExists(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[bool, DbErr] {
    return Ok((try st.get(txn, lexdb_catalog.CATALOG, &k)).isSome() || (try st.get(txn, lexdb_catalog.CATALOG, &(idxName(k)))).isSome() ||
              (try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(k)))).isSome())
}

// ALTER TABLE ... SET SCHEMA: the table and its indexes, unless a name is
// taken there.
fn setSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, sc: &str): Result[Unit, DbErr] {
    if lexdb_catalog.tempRel(&t.name) || sc == "pg_temp" || lexdb_base.isTempSchema(sc) { return Err(e("0A000", "cannot move objects into or out of temporary schemas")) }
    if !(try schemaExists(st, txn, sc)) { return Err(e("3F000", &("schema \"" + sc + "\" does not exist"))) }
    if lexdb_sql.schemaOf(&t.name) == sc { return Ok(Unit{}) }
    var names = [lexdb_sql.baseName(&t.name)]
    for ix in t.indexes { append(mut &names, lexdb_sql.baseName(&ix.name)) }
    for n in names {
        if try relExists(st, txn, &lexdb_sql.qual(sc, &n)) {
            return Err(e("42P07", &("relation \"" + n + "\" already exists in schema \"" + sc + "\"")))
        }
    }
    return moveTable(st, txn, t, sc)
}

fn alterIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let ixKey = try catKey(st, txn, &s.index, true)
    let owner = try st.get(txn, lexdb_catalog.CATALOG, &(idxName(&ixKey)))
    if owner.isNone() {
        // a primary key's index (its table's own tree): the key renamed,
        // as Rails' rename_table renames it (9.117)
        match try pkIndexTable(st, txn, &ixKey) {
            Some(pt) {
                var t = pt
                try needRelOwner(st, txn, &t.name, &"index")
                let to = s.alters[0].name.clone()
                let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&ixKey), &to)
                if key == ixKey { return Ok(tagOnly("ALTER INDEX")) }
                if try relExists(st, txn, &key) { return Err(e("42P07", &("relation \"" + to + "\" already exists"))) }
                if conTaken(&t, &to) { return Err(e("42710", &("constraint \"" + to + "\" for relation \"" + lexdb_sql.baseName(&t.name) + "\" already exists"))) }
                t.pkName = to
                try txn.put(lexdb_catalog.CATALOG, &t.name, &(lexdb_catalog.encTable(&t)))
                try bumpFor(st, txn, &t.name)
                return Ok(tagOnly("ALTER INDEX"))
            }
            None {}
        }
        if s.ifFlag {
            notice(st, txn, &"00000", &("relation \"" + lexdb_sql.shown(&s.index) + "\" does not exist, skipping"), &"")
            return Ok(tagOnly("ALTER INDEX"))
        }
        return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&s.index) + "\" does not exist")))
    }
    var t = try needTable(st, txn, &owner.unwrap())
    try needRelOwner(st, txn, &t.name, &"index")
    let to = s.alters[0].name.clone()
    let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&ixKey), &to)
    if key == ixKey { return Ok(tagOnly("ALTER INDEX")) }
    if try relExists(st, txn, &key) { return Err(e("42P07", &("relation \"" + to + "\" already exists"))) }
    for k in 0..len(t.indexes) { if t.indexes[k].name == ixKey { t.indexes[k].name = key.clone() } }
    txn.del(lexdb_catalog.CATALOG, &(idxName(&ixKey)))
    try txn.put(lexdb_catalog.CATALOG, &(idxName(&key)), &t.name)
    try txn.put(lexdb_catalog.CATALOG, &t.name, &(lexdb_catalog.encTable(&t)))
    try bumpFor(st, txn, &t.name)
    return Ok(tagOnly("ALTER INDEX"))
}

// ALTER SCHEMA ... RENAME TO: its tables and indexes move to the new name.
fn alterSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let to = s.alters[0].name.clone()
    if s.table == "public" { return Err(e("0A000", "lexdb: schema public cannot be renamed")) }
    if !(try schemaExists(st, txn, &s.table)) { return Err(e("3F000", &("schema \"" + s.table + "\" does not exist"))) }
    if try schemaExists(st, txn, &to) { return Err(e("42P06", &("schema \"" + to + "\" already exists"))) }
    if strings.startsWith(&to, "pg_") { return Err(e("42939", &("unacceptable schema name \"" + to + "\""))) }
    try needOwner(st, txn, &(try whoNow(st, txn)), &lexdb_catalog.nspObj(&s.table), &"schema", &s.table)
    for v in try lexdb_catalog.allViews(st, txn) {
        var touches = lexdb_sql.schemaOf(&v.name) == s.table
        for d in v.deps { if lexdb_sql.schemaOf(&d) == s.table { touches = true } }
        if touches {
            return Err(e("2BP01", &("cannot rename schema " + s.table + " because view " + lexdb_sql.shown(&v.name) +
                         " is in it or reads from it (lexdb keeps a view's text)")))
        }
    }
    let from = lexdb_sql.qual(&s.table, &"")
    var keys: []str = []
    try st.scan(txn, lexdb_catalog.CATALOG, &from, &(from + "\xff"), fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key.clone())
        return true
    })
    for k in keys {
        match try byKeyOpt(st, txn, &k) {
            Some(t) {
                var m = t
                try moveTable(st, txn, mut &m, &to)
            }
            None {}
        }
    }
    for d in try lexdb_catalog.allSeqs(st, txn, &s.table) {
        var m = lexdb_catalog.seqCopy(&d)
        txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&m.key)))
        let was = m.key.clone()
        m.key = lexdb_sql.qual(&to, &lexdb_sql.baseName(&m.key))
        try moveAcl(st, txn, &lexdb_catalog.relObj(&was), &lexdb_catalog.relObj(&m.key))
        try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&m.key)), &(lexdb_catalog.encSeq(&m)))
    }
    txn.del(lexdb_catalog.CATALOG, &(schemaKey(&s.table)))
    try txn.put(lexdb_catalog.CATALOG, &(schemaKey(&to)), "")
    try moveAcl(st, txn, &lexdb_catalog.nspObj(&s.table), &lexdb_catalog.nspObj(&to))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("ALTER SCHEMA"))
}

// ---- ALTER COLUMN TYPE (9.36)

// A column's new type: col its number, using its new value (None: the
// column's value converted).
type Retype = record { col: int; typ: lexdb_sql.TypeName; using: Option[Expr] }

fn intRank(oid: int): int {
    if oid == lexdb_sql.OID_INT2 { return 1 }
    if oid == lexdb_sql.OID_INT4 { return 2 }
    return 3
}

// What column i of t holds: whether any row has a value there, and the longest text (in bytes).
fn columnData(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, col: int): Result[[]int, DbErr] {
    let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
    let sc = lexdb_access.allScan()
    var need: []bool = []
    for k in 0..len(t.cols) { append(mut &need, k == col) }
    var has = 0
    var longest = 0
    var cur = lexdb_access.newCursor()
    while !cur.done {
        var batch: [][]Val = []
        try fetch(st, txn, t, &path, &sc, &need, mut &cur, mut &batch)
        for r in batch {
            match r[col] {
                Val.Null {}
                Val.Text(x) {
                    has = 1
                    if len(x) > longest { longest = len(x) }
                }
                else { has = 1 }
            }
        }
    }
    return Ok([has, longest])
}

// Oracle's MODIFY of a column's type: a column with values keeps its kind of type (numbers, text, dates), a text may not be
// made shorter than its longest value (ORA-01441), a number's precision or scale not lower (ORA-01440); another type needs
// the column empty (ORA-01439).
fn oracleModify(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, i: int, nw: &lexdb_sql.TypeName): Result[Unit, DbErr] {
    let old = &t.cols[i].typ
    if old.oid == nw.oid && old.len == nw.len && old.prec == nw.prec && old.scale == nw.scale { return Ok(Unit{}) }
    let data = try columnData(st, txn, t, i)
    if data[0] == 0 { return Ok(Unit{}) }
    let fo = oraFamily(old.kind)
    if fo != oraFamily(nw.kind) { return Err(e("ORA01439", "column to be modified must be empty to change datatype")) }
    if old.kind == lexdb_sql.K_TEXT && nw.len > 0 && data[1] > nw.len {
        return Err(e("ORA01441", "cannot decrease column length because some value is too big"))
    }
    if fo == 1 && nw.kind != lexdb_sql.K_FLOAT && old.kind != lexdb_sql.K_FLOAT {
        let lower = nw.prec > 0 && (old.prec == 0 || nw.prec < old.prec || nw.scale < old.scale)
        if lower { return Err(e("ORA01440", "column to be modified must be empty to decrease precision or scale")) }
    }
    return Ok(Unit{})
}

fn oraFamily(k: int): int {
    if k == lexdb_sql.K_INT || k == lexdb_sql.K_NUM || k == lexdb_sql.K_FLOAT { return 1 }
    if k == lexdb_sql.K_TEXT { return 2 }
    if k == lexdb_sql.K_DATE || k == lexdb_sql.K_TS || k == lexdb_sql.K_TSTZ { return 3 }
    return 100 + k
}

// A rewrite's error for a type change: SQL Server's overflow of a conversion to a small integer is its own.
fn retypeErr(bad: DbErr, dia: int, changes: &[]Retype, fromInt4: &[]int): DbErr {
    var small = false
    for ch in changes { if ch.typ.oid == lexdb_sql.OID_INT2 { for k in fromInt4 { if k == ch.col { small = true } } } }
    // (a text that is no number: 8114 for a decimal or float, 245 for an integer)
    var toNum = false
    for ch in changes { if ch.typ.kind == lexdb_sql.K_NUM || ch.typ.kind == lexdb_sql.K_FLOAT { toNum = true } }
    if dia == lexdb_sql.MD_TSQL && bad.state == "22P02" && toNum { return e("TS8114", &("Error converting data type varchar to numeric.")) }
    if dia == lexdb_sql.MD_TSQL && bad.state == "22003" && small { return e("TS220", "Arithmetic overflow error for data type smallint.") }
    return bad
}

// The object that stops SQL Server from changing column i of t to type nt, "" none: its key, an index, a CHECK or a
// foreign key on it, unless a varchar only grows; a default unless the type stays (its length, precision, scale change).
fn tsqlBlocker(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, i: int, nt: &lexdb_sql.TypeName): Result[str, DbErr] {
    let old = &t.cols[i].typ
    if old.oid == nt.oid && old.len == nt.len && old.prec == nt.prec && old.scale == nt.scale { return Ok("") }
    let name = t.cols[i].name.clone()
    if t.cols[i].def.isSome() && old.oid != nt.oid { return Ok("DF_" + lexdb_sql.baseName(&t.name) + "_" + name) }
    let grows = old.kind == lexdb_sql.K_TEXT && nt.kind == lexdb_sql.K_TEXT && old.oid == nt.oid && old.len > 0 && nt.len >= old.len
    if grows { return Ok("") }
    for k in t.pk { if k == i { return Ok(lexdb_catalog.pkConName(t)) } }
    for ix in t.indexes {
        for c in ix.cols { if c == i { return Ok(lexdb_sql.baseName(&ix.name)) } }
        for x in ix.exprs {
            var ns: []str = []
            lexdb_sql.colNames(&x, mut &ns)
            for n in ns { if n == name { return Ok(lexdb_sql.baseName(&ix.name)) } }
        }
    }
    for c in t.checks {
        var ns: []str = []
        lexdb_sql.colNames(&c.expr, mut &ns)
        for n in ns { if n == name { return Ok(c.name.clone()) } }
    }
    for f in t.fks { for n in f.cols { if n == name { return Ok(f.name.clone()) } } }
    if try fkUses(st, txn, t, &name) { return Ok("FK_" + lexdb_sql.baseName(&t.name)) }
    return Ok("")
}

// Whether a column of type a may become b with no USING: PostgreSQL's
// assignment casts among lexdb's types.
fn autoCast(a: &lexdb_sql.TypeName, b: &lexdb_sql.TypeName): bool {
    if a.kind == b.kind && a.kind != lexdb_sql.K_ARRAY { return true }
    if a.kind == lexdb_sql.K_ARRAY && b.kind == lexdb_sql.K_ARRAY {
        return a.oid == b.oid || autoCast(&lexdb_sql.oidType(lexdb_sql.elemOid(a.oid)), &lexdb_sql.oidType(lexdb_sql.elemOid(b.oid)))
    }
    if b.kind == lexdb_sql.K_TEXT { return true }
    // the numbers among themselves, the date and time stamps among themselves
    let an = a.kind == lexdb_sql.K_INT || a.kind == lexdb_sql.K_NUM || a.kind == lexdb_sql.K_FLOAT
    let bn = b.kind == lexdb_sql.K_INT || b.kind == lexdb_sql.K_NUM || b.kind == lexdb_sql.K_FLOAT
    if an && bn { return true }
    let at = a.kind == lexdb_sql.K_DATE || a.kind == lexdb_sql.K_TS || a.kind == lexdb_sql.K_TSTZ
    let bt = b.kind == lexdb_sql.K_DATE || b.kind == lexdb_sql.K_TS || b.kind == lexdb_sql.K_TSTZ
    return at && bt
}

// Whether every value of type a is one of type b as it is stored: then
// the rows need not change.
fn widens(a: &lexdb_sql.TypeName, b: &lexdb_sql.TypeName): bool {
    if a.kind != b.kind { return false }
    if a.kind == lexdb_sql.K_INT { return intRank(b.oid) >= intRank(a.oid) }
    if a.kind == lexdb_sql.K_BOOL { return true }
    if a.kind == lexdb_sql.K_TEXT { return b.len == 0 || (a.len > 0 && b.len >= a.len) }
    if a.kind == lexdb_sql.K_NUM { return b.prec == 0 || (a.prec > 0 && b.scale == a.scale && b.prec >= a.prec) }
    return a.oid == b.oid
}

// What a rewrite does besides the columns' new types (9.117):
// - rekey: the key changed (t.pk is the new one), so every index is made
//   again (its entries hold the key);
// - fills: columns given their defaults row by row, in the rows' order (a
//   serial or identity column added over rows: its sequence's next value;
//   a volatile default);
// - rowid: the hidden key column (9.88), numbered from 1 in the rows' order
//   (a primary key dropped); -1 none;
// - nn: the columns the statement made NOT NULL: a NULL there is 23502
//   "contains null values", as PostgreSQL's;
// - sorted: the rows are read in their new key's order (the key unchanged).
type Rewrite = record { rekey: bool; fills: []int; rowid: int; nn: []int; sorted: bool }

fn noRewrite(): Rewrite { return Rewrite{rekey: false, fills: [], rowid: -1, nn: [], sorted: true} }

// A rewrite's rows as made: each row's key and stored bytes; per index made
// again, its entries, each one's row and (a unique one's) the length of its
// columns' part (-1 one NULL); the bytes held.

// Rewrites table t, as PostgreSQL does: each row, with its columns' new
// types (changes, USING's values converted to them) and what rw says,
// goes to a new tree under its key, and the indexes whose entries change
// (all of them when the key does) are made again into new trees; the old
// trees are dropped. The rows go in key order and the index entries in
// theirs, as CREATE INDEX writes them (addIndex), so the leaves are full.
// All in the transaction. Only the rows' keys and bytes and the entries are
// held (bounded by max_statement_mem), not the rows: but USING's rows are
// made by a query, and held as an UPDATE's are.
fn rewrite(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, changes: &[]Retype, rw: &Rewrite, lim: Limits): Result[int, DbErr] {
    let sqe = seqEnv(st, txn)
    // the rows are read as the table stands (the statement's other actions
    // done), through a copy of it: t takes the new types before they are
    // written
    let rd = try decTable(&t.name, &lexdb_catalog.encTable(t))
    var withUsing = false
    for ch in changes { if ch.using.isSome() { withUsing = true } }
    var found: [][]Val = []
    if withUsing {
        // USING's values, of the row as it was: by a query over the table
        try txn.put(lexdb_catalog.CATALOG, &t.name, &(lexdb_catalog.encTable(t)))
        var sc = newScopeIn(st, txn, &[], &[])
        let noWhere: Option[Expr] = None
        let noParams: []Val = []
        let noSubs: []lexdb_sql.Stmt = []
        var q = try buildQuery(st, txn, &oneTable(&t.name), &noWhere, &noParams, &noSubs, &newMap(), true, mut &sc, false)
        var xs: []Expr = []
        for ch in changes {
            let x = match ch.using {
                Some(u) { lexdb_sql.cloneExpr(&u) }
                None { Expr.Col(t.cols[ch.col].name.clone(), -1) }
            }
            if hasAgg(&x) { return Err(e("42803", "cannot use aggregate function in transform expression")) }
            append(mut &xs, try lexdb_bind.resolve(&x, &q.cols, len(q.cols), mut &sc.names))
        }
        endScope(mut &sc, mut &q)
        var rs = newRun(&q)
        rs.limit(&lim)
        rs.writes = true                // optimizer 19: a write keeps its index paths (its read set)
        let m = try prepare(st, txn, &q, &noParams, mut &rs)
        let room = rs.bud.room()
        let max = rs.bud.maxHeld
        var held = 0
        try runQuery(st, txn, &q, &m, &noParams, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
            held += 2 * lexdb_pipe.rowBytes(r)             // the row found, and its new one
            if room >= 0 && held > room { return Err(lexdb_pipe.memErr(max)) }
            append(mut &found, collections.copyOf(r))
            return Ok(true)
        }, mut &rs)
        let noAggs: []Val = []
        for f in 0..len(found) {
            var vals: []Val = []
            {
                let env = Env{cols: &q.cols, row: &found[f], aggs: &noAggs, params: &noParams, subs: &m.subs, cur: &noAggs, seq: &sqe}
                for k in 0..len(changes) {
                    append(mut &vals, try lexdb_ops.coerceZ(try evalX(st, txn, &q, &xs[k], &env, mut &rs), &changes[k].typ, &txn.sql.zone))
                }
            }
            for k in 0..len(changes) { found[f][changes[k].col] = vals[k].clone() }
        }
    }

    var changed: []bool = array(len(t.cols), false)
    var keyChanged = rw.rekey
    // every row written below has every place
    for k in 0..len(t.cols) { t.cols[k].missing = Val.Null }
    for ch in changes {
        t.cols[ch.col].typ = ch.typ
        changed[ch.col] = true
        for k in t.pk { if k == ch.col { keyChanged = true } }
    }
    for f in rw.fills { changed[f] = true }
    // the rows below are in the new types' layout
    lexdb_catalog.syncLayouts(t)
    let old = t.tree
    t.tree = st.createTree(txn)
    txn.dropTree(old)
    // the indexes whose entries change
    var redo: []int = []
    for k in 0..len(t.indexes) {
        var uses = keyChanged
        for c in t.indexes[k].cols { if c >= 0 && changed[c] { uses = true } }
        for ixe in t.indexes[k].exprs {
            var ixn: []str = []
            lexdb_sql.colNames(&ixe, mut &ixn)
            for n in ixn {
                let ci = colIndex(&t.cols, &n)
                if ci >= 0 && changed[ci] { uses = true }
            }
        }
        match t.indexes[k].pred {
            Some(x) {
                var ns: []str = []
                lexdb_sql.colNames(&x, mut &ns)
                for n in ns {
                    let c = colIndex(&t.cols, &n)
                    if c >= 0 && changed[c] { uses = true }
                }
            }
            None {}
        }
        if uses {
            txn.dropTree(t.indexes[k].tree)
            t.indexes[k].tree = st.createTree(txn)
            append(mut &redo, k)
        }
    }
    var out = lexdb_access.newBuild(&redo)
    // the defaults of the columns filled (only theirs: making them binds
    // the sequences they name)
    let defs = if len(rw.fills) > 0 { try defaultsOf(st, txn, t) } else { Defs{vals: [], seqs: [], exprs: []} }
    let room = if lim.mem > 0 { lim.mem } else { -1 }
    // a row's checks are those its new values may fail: not a key's change
    let checked = len(changes) > 0 || len(rw.fills) > 0
    var n = 0
    if withUsing {
        for f in found {
            var row = collections.copyOf(&f)
            try rwRow(st, txn, t, &defs, rw, n, mut &row, checked)
            try rwAdd(t, &row, mut &out, room)
            n += 1
        }
    } else {
        let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
        let sc = lexdb_access.allScan()
        var cur = lexdb_access.newCursor()
        while !cur.done {
            var batch: [][]Val = []
            let all: []bool = []
            try fetch(st, txn, &rd, &path, &sc, &all, mut &cur, mut &batch)
            for r in batch {
                var row = collections.copyOf(&r)
                for ch in changes { row[ch.col] = try lexdb_ops.coerceZ(row[ch.col].clone(), &ch.typ, &txn.sql.zone) }
                try rwRow(st, txn, t, &defs, rw, n, mut &row, checked)
                try rwAdd(t, &row, mut &out, room)
                n += 1
            }
        }
    }
    // the rows, in key order: two of one key are 23505, as the key's index
    // made again would find them (PostgreSQL's "could not create unique
    // index"); then the indexes made again, each in its key order
    let d = try lexdb_access.buildWrite(st, txn, &lexdb_catalog.relOf(t), &out, !keyChanged && rw.sorted,
                                        fn(tx: &lexdb_store.Txn) { lexdb_stats.noteChg(st, tx.sql.sess, t, 0) })   // the new tree's rows, for its statistics (optimizer 44)
    if d.ix == lexdb_access.PK_CONFLICT { return Err(dupMade(t, &lexdb_catalog.pkConName(t), &t.pk, &[], &d.row)) }
    if d.ix >= 0 {
        let ix = &t.indexes[d.ix]
        return Err(dupMade(t, &lexdb_sql.baseName(&ix.name), &ix.cols, &ix.exprs, &d.row))
    }
    // the old trees' statistics are of no use (the new tree's are made as
    // its rows are counted)
    lexdb_stats.dropStats(txn, &t.name)
    // the store's column leaves for the new tree from the first checkpoint
    // on: its rows are all in the layout the catalog row will have, and a
    // rollback drops the tree (9.114 keeps an uncommitted layout from trees
    // whose rows were there before)
    setSpec(st, t)
    return Ok(out.count())
}

// Row n of a rewrite (its new types' values in): rw's columns given, then
// checked.
fn rwRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, defs: &Defs, rw: &Rewrite, n: int, row: mut &[]Val,
         checked: bool): Result[Unit, DbErr] {
    for f in rw.fills { row[f] = try defAt(st, txn, defs, t, f) }
    if rw.rowid >= 0 { row[rw.rowid] = Val.Int(n + 1) }
    for c in rw.nn {
        if lexdb_ops.isNull(&row[c]) {
            return Err(e("23502", &("column \"" + t.cols[c].name + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" contains null values")))
        }
    }
    try checkRow(t, row)
    if checked {
        for c in t.checks {
            if lexdb_base.hasStr(&t.invalid, &c.name) { continue }
            if !(try passes(t, &c, row)) {
                return Err(e("23514", &("check constraint \"" + c.name + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" is violated by some row")))
            }
        }
    }
    return Ok(Unit{})
}

// A rewrite's row made: its key, its bytes, its entries in the indexes made
// again.
fn rwAdd(t: &Table, row: &[]Val, out: mut &lexdb_access.Build, room: int): Result[Unit, DbErr] {
    try lexdb_access.buildAdd(&lexdb_catalog.relOf(t), out, row,
                              fn(xi: &Index, r: &[]Val): Result[bool, DbErr] { return inIndex(t, xi, r) },
                              fn(xi: &Index, k: int, r: &[]Val): Result[Val, DbErr] { return idxVal(t, xi, k, r) })
    if room >= 0 && out.held > room { return Err(lexdb_pipe.memErr(room)) }
    return Ok(Unit{})
}

// 23505 for a unique index made over rows two of which have equal values
// in cols (exprs, an expression's where cols holds -1): row is one of them
// ([] not known).
fn dupMade(t: &Table, name: &str, cols: &[]int, exprs: &[]Expr, row: &[]Val): DbErr {
    let msg = "could not create unique index \"" + name + "\""
    if len(row) == 0 { return e("23505", &msg) }
    var names: []str = []
    var vals: []str = []
    for k in 0..len(cols) {
        if cols[k] >= 0 {
            append(mut &names, lexdb_pg.quoteIfNeeded(&t.cols[cols[k]].name))
            append(mut &vals, lexdb_sql.text(&row[cols[k]]))
        } else {
            let none: Option[lexdb_sql.TypeName] = None
            append(mut &names, lexdb_pg.exprText(&exprs[k], &none))
            let noAggs: []Val = []
            let noParams: []Val = []
            let noSubs: []SubRes = []
            let noSeq: Option[SeqEnv] = None
            let env = Env{cols: &t.cols, row: row, aggs: &noAggs, params: &noParams, subs: &noSubs, cur: &noAggs, seq: &noSeq}
            match bpEval(t, &exprs[k], &env) {
                Ok(v) { append(mut &vals, lexdb_sql.text(&v)) }
                Err(_) { append(mut &vals, "?") }
            }
        }
    }
    return lexdb_base.errDetail("23505", &msg, &("Key (" + strings.join(&names, ", ") + ")=(" + strings.join(&vals, ", ") + ") is duplicated."), "")
}

// ALTER TABLE: its actions in order, on the table's catalog row. Most
// rewrite no row: a row written before a column was added has fewer
// values, read as NULL (decRowNeed); a dropped column's place is skipped
// (Table.slots). The table is rewritten once, after them, when its key
// changes, a column added over rows takes a value per row (9.117), or a
// type changes its values (9.36).
fn alterTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, lim: Limits): Result[Res, DbErr] {
    let found = try findTable(st, txn, &s.table)
    if found.isNone() {
        // a sequence's RENAME TO and SET SCHEMA (Rails' rename_table renames
        // its key's sequence so)
        if len(s.alters) == 1 && (s.alters[0].kind == lexdb_sql.A_RENAME || s.alters[0].kind == lexdb_sql.A_SET_SCHEMA) {
            match try findSeq(st, txn, &s.table) {
                Some(d) {
                    try needRelOwner(st, txn, &d.key, &"sequence")
                    let r = try moveSeq(st, txn, &d, &s.alters[0])
                    return Ok(tagOnly("ALTER TABLE"))
                }
                None {}
            }
        }
        if s.ifFlag {
            notice(st, txn, &"00000", &("relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist, skipping"), &"")
            return Ok(tagOnly("ALTER TABLE"))
        }
        if s.mdialect == lexdb_sql.MD_TSQL {
            return Err(e("TS4902", &("Cannot find the object \"" + lexdb_sql.baseName(&s.table) + "\" because it does not exist or you do not have permissions.")))
        }
        return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist")))
    }
    var follow: []Follow = []
    match found {
        Some(ft) {
            if len(ft.view) > 0 {
                // Oracle's RENAME renames a view too
                if s.mdialect == lexdb_sql.MD_ORA && len(s.alters) == 1 && s.alters[0].kind == lexdb_sql.A_RENAME {
                    return renameView(st, txn, &ft, &s.alters[0].name, &s.alters[0].col.spell, false, "ALTER TABLE")
                }
                return Err(e("42809", &("\"" + lexdb_sql.shown(&s.table) + "\" is a view (use ALTER VIEW)")))
            }
            try needRelOwner(st, txn, &ft.name, &"table")
            // a view keeps its query's text. PostgreSQL's follow a renamed table or column (what the view records is applied
            // after); SQL Server's and Oracle's keep their text and stop working, a retyped column changes under them; a
            // PostgreSQL view using a retyped column, a dropped column or a moved table stops it
            for a in s.alters {
                if a.kind == lexdb_sql.A_SET_SCHEMA && (lexdb_catalog.tempRel(&ft.name) || a.name == "pg_temp" || lexdb_base.isTempSchema(&a.name)) {
                    return Err(e("0A000", "cannot move objects into or out of temporary schemas"))
                }
                if a.kind == lexdb_sql.A_RENAME || a.kind == lexdb_sql.A_RENAME_COL || a.kind == lexdb_sql.A_DROP_COL ||
                   a.kind == lexdb_sql.A_TYPE || a.kind == lexdb_sql.A_SET_SCHEMA {
                    let deps = try lexdb_catalog.dependentViews(st, txn, &ft.name)
                    if len(deps) == 0 { continue }
                    let pg = s.mdialect == lexdb_sql.MD_PG
                    if a.kind == lexdb_sql.A_RENAME || a.kind == lexdb_sql.A_RENAME_COL {
                        if pg && a.kind == lexdb_sql.A_RENAME && len(follow) == 0 { follow = try followPlan(st, txn, &ft.name) }
                        continue
                    }
                    // (a retyped column: checked with the type's other conditions, below)
                    if a.kind == lexdb_sql.A_TYPE { continue }
                    return Err(e("2BP01", &("cannot alter table " + lexdb_sql.shown(&ft.name) + " because view " +
                                 lexdb_sql.shown(&deps[0]) + " depends on it (lexdb keeps a view's text: drop the view, then make it again)")))
                }
            }
        }
        None {}
    }
    var t = found.unwrap()
    // SQL Server's ALTER COLUMN of a type: refused where an index, key or constraint is on the column (its length may grow)
    if s.mdialect == lexdb_sql.MD_TSQL {
        for a in s.alters {
            if a.kind == lexdb_sql.A_DROP_NOT_NULL {
                let pi = colIndex(&t.cols, &a.name)
                if pi >= 0 && t.cols[pi].notNull { for k in t.pk { if k == pi && lexdb_catalog.hasPk(&t) {
                    return Err(e("TS5074", &("The object '" + lexdb_catalog.pkConName(&t) + "' is dependent on column '" + a.name + "'.")))
                } } }
            }
            if a.kind != lexdb_sql.A_TYPE { continue }
            let ci = colIndex(&t.cols, &a.name)
            if ci < 0 { return Err(e("TS4924", &("ALTER TABLE ALTER COLUMN failed because column '" + a.name + "' does not exist in table '" + lexdb_sql.baseName(&t.name) + "'."))) }
            let blocker = try tsqlBlocker(st, txn, &t, ci, &a.col.typ)
            if len(blocker) > 0 { return Err(e("TS5074", &("The object '" + blocker + "' is dependent on column '" + a.name + "'."))) }
        }
    }
    // the key as it was, by its columns' names ([] the hidden one)
    var keyWas: []str = []
    if lexdb_catalog.hasPk(&t) { for i in t.pk { append(mut &keyWas, t.cols[i].name.clone()) } }
    var pk = PkChange{changed: false, nn: []}
    var fills: []str = []               // columns added over rows that take a value per row
    // TYPE actions are done together, after the others, by the names then
    var types: []int = []
    var skipped: []str = []             // columns ADD COLUMN IF NOT EXISTS found there: their constraints not added
    for j in 0..len(s.alters) {
        let a = &s.alters[j]
        let rel = lexdb_sql.baseName(&t.name)
        if a.kind == lexdb_sql.A_TYPE {
            append(mut &types, j)
        } else if a.kind == lexdb_sql.A_ADD_CON {
            var skip = false
            for n in skipped { if len(a.name) > 0 && n == a.name { skip = true } }
            if skip { continue }
            let c = &a.cons[0]
            if c.kind == lexdb_sql.C_PRIMARY {
                try addPrimary(st, txn, mut &t, c, mut &pk)
            } else if c.kind == lexdb_sql.C_UNIQUE && len(c.index) > 0 {
                try uniqueUsing(st, txn, mut &t, c)
            } else {
                try addConstraint(st, txn, mut &t, c, true)
            }
        } else if a.kind == lexdb_sql.A_DROP_CON {
            if lexdb_catalog.hasPk(&t) && a.name == lexdb_catalog.pkConName(&t) {
                try dropPrimary(st, txn, mut &t, a.cascade, &"")
                pk.changed = true
            } else if !(try dropConstraint(st, txn, mut &t, &a.name, a.cascade)) {
                if !a.ifFlag {
                    return Err(e("42704", &("constraint \"" + a.name + "\" of relation \"" + rel + "\" does not exist")))
                }
                notice(st, txn, &"00000", &("constraint \"" + a.name + "\" of relation \"" + rel + "\" does not exist, skipping"), &"")
            }
        } else if a.kind == lexdb_sql.A_RENAME_CON {
            try renameConstraint(st, txn, mut &t, &a.name, &a.to)
        } else if a.kind == lexdb_sql.A_VALIDATE {
            try validateConstraint(st, txn, mut &t, &a.name)
        } else if a.kind == lexdb_sql.A_SET_SCHEMA {
            try setSchema(st, txn, mut &t, &a.name)
        } else if a.kind == lexdb_sql.A_ADD {
            if colIndex(&t.cols, &a.col.name) >= 0 {
                if a.ifFlag {
                    append(mut &skipped, a.col.name.clone())
                    notice(st, txn, &"42701", &("column \"" + a.col.name + "\" of relation \"" + rel + "\" already exists, skipping"), &"")
                    continue
                }
                return Err(e("42701", &("column \"" + a.col.name + "\" of relation \"" + rel + "\" already exists")))
            }
            // the rows there read the default as it is now (no row is
            // written), unless it is a sequence's or volatile: then each row
            // is given one when the table is rewritten (9.117)
            var col = lexdb_sql.colDef(&a.col.name, a.col.typ, a.col.notNull)
            col.identity = a.col.identity
            col.spell = a.col.spell.clone()
            col.coll = a.col.coll.clone()
            var perRow = a.col.identity != lexdb_sql.ID_NONE
            match a.col.def {
                Some(x) {
                    col.missing = try defaultValue(&x, &col, seqEnv(st, txn))
                    col.def = Some(lexdb_sql.cloneExpr(&x))
                    if isVolatile(&x) { perRow = true }
                }
                None {}
            }
            try defaultSeqs(st, txn, &col)
            let rows = (perRow || (a.col.notNull && lexdb_ops.isNull(&col.missing))) && try anyRow(st, txn, &t, -1)
            if perRow && rows { append(mut &fills, a.col.name.clone()) }
            if a.col.notNull && lexdb_ops.isNull(&col.missing) && rows && !perRow {
                return Err(e("23502", &("column \"" + a.col.name + "\" of relation \"" + rel + "\" contains null values")))
            }
            append(mut &t.cols, col)
            if len(t.slots) > 0 {
                append(mut &t.slots, t.width)
                t.width += 1
            }
            try makeColSeqs(st, txn, mut &t, len(t.cols) - 1, &s.idOpts)
            try ownColSeq(st, txn, &t, len(t.cols) - 1)
        } else if a.kind == lexdb_sql.A_DROP_COL {
            let i = colIndex(&t.cols, &a.name)
            if i < 0 {
                if a.ifFlag {
                    notice(st, txn, &"00000", &("column \"" + a.name + "\" of relation \"" + rel + "\" does not exist, skipping"), &"")
                    continue
                }
                return Err(e("42703", &("column \"" + a.name + "\" of relation \"" + rel + "\" does not exist")))
            }
            // a key column's drop drops the key, as PostgreSQL's (its
            // index goes with the column)
            var inKey = false
            for k in t.pk { if k == i { inKey = true } }
            if inKey && lexdb_catalog.hasPk(&t) {
                try dropPrimary(st, txn, mut &t, a.cascade, &a.name)
                pk.changed = true
            }
            try fkDropColumn(st, txn, mut &t, &a.name, a.cascade)
            try dropOwnedSeqs(st, txn, &t, &a.name)
            try dropColumn(txn, mut &t, i)
        } else if a.kind == lexdb_sql.A_RENAME {
            let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &a.name)
            t.spell = a.col.spell.clone()
            // (PostgreSQL's and Oracle's say so for the table's own name; SQL Server's sp_rename does not)
            if key == t.name {
                if s.mdialect == lexdb_sql.MD_TSQL { continue }
                return Err(e("42P07", &("relation \"" + a.name + "\" already exists")))
            }
            if try relExists(st, txn, &key) {
                return Err(e("42P07", &("relation \"" + a.name + "\" already exists")))
            }
            // its key's index keeps its name, as PostgreSQL's
            if lexdb_catalog.hasPk(&t) && len(t.pkName) == 0 { t.pkName = lexdb_catalog.pkConName(&t) }
            txn.del(lexdb_catalog.CATALOG, &t.name)
            let old = t.name.clone()
            t.name = key.clone()
            try moveAcl(st, txn, &lexdb_catalog.relObj(&old), &lexdb_catalog.relObj(&key))
            try relink(st, txn, mut &t, &old)
            try lexdb_stats.moveStats(st, txn, &old, &t.name)
            try ownerMoved(st, txn, mut &t, &old, &"", &"", &"")
            for ix in t.indexes { try txn.put(lexdb_catalog.CATALOG, &(idxName(&ix.name)), &key) }
            try followApply(st, txn, &follow, &old, &key)
        } else {
            let i = colIndex(&t.cols, &a.name)
            if i < 0 { return Err(e("42703", &("column \"" + a.name + "\" of relation \"" + rel + "\" does not exist"))) }
            if a.kind == lexdb_sql.A_RENAME_COL {
                t.cols[i].spell = a.col.spell.clone()
                if a.to == a.name && s.mdialect == lexdb_sql.MD_TSQL { continue }
                if colIndex(&t.cols, &a.to) >= 0 {
                    return Err(e(if s.mdialect == lexdb_sql.MD_ORA { "ORA00957" } else { "42701" },
                                 &("column \"" + a.to + "\" of relation \"" + rel + "\" already exists")))
                }
                t.cols[i].name = a.to.clone()
                // a filtered index's predicate names its columns
                for k in 0..len(t.indexes) {
                    var renamed: Option[Expr] = None
                    match t.indexes[k].pred {
                        Some(x) { renamed = Some(renameCol(&x, &a.name, &a.to, -1)) }
                        None {}
                    }
                    if renamed.isSome() { t.indexes[k].pred = renamed }
                    var rx: []Expr = []
                    for x in t.indexes[k].exprs { append(mut &rx, renameCol(&x, &a.name, &a.to, -1)) }
                    t.indexes[k].exprs = rx
                }
                for k in 0..len(t.checks) { t.checks[k].expr = renameCol(&t.checks[k].expr, &a.name, &a.to, -1) }
                try renameFkCol(st, txn, mut &t, &a.name, &a.to)
                if s.mdialect == lexdb_sql.MD_PG { try followColumn(st, txn, &t.name, &a.name, &a.to) }
                let tn = t.name.clone()
                try ownerMoved(st, txn, mut &t, &tn, &a.name, &a.to, &"")
                for k in 0..len(pk.nn) { if pk.nn[k] == a.name { pk.nn[k] = a.to.clone() } }
                for k in 0..len(fills) { if fills[k] == a.name { fills[k] = a.to.clone() } }
            } else if a.kind == lexdb_sql.A_SET_NOT_NULL {
                let nulls = !t.cols[i].notNull && try anyRow(st, txn, &t, i)
                if nulls {
                    if s.mdialect == lexdb_sql.MD_ORA { return Err(e("ORA02296", "cannot enable - null values found")) }
                    return Err(e("23502", &("column \"" + a.name + "\" of relation \"" + rel + "\" contains null values")))
                }
                t.cols[i].notNull = true
            } else if a.kind == lexdb_sql.A_SET_DEFAULT {
                // for rows inserted from now on; those there keep their values
                if t.cols[i].identity == lexdb_sql.ID_ALWAYS || t.cols[i].identity == lexdb_sql.ID_BY_DEFAULT {
                    return Err(e("42601", &("column \"" + a.name + "\" of relation \"" + rel + "\" is an identity column")))
                }
                match a.col.def {
                    Some(x) {
                        let v = try defaultValue(&x, &t.cols[i], &seqEnv(st, txn))
                        t.cols[i].def = Some(lexdb_sql.cloneExpr(&x))
                        try defaultSeqs(st, txn, &t.cols[i])
                    }
                    None {}
                }
                // a serial column's default is replaced (its sequence stays, owned by it)
                t.cols[i].seq = ""
                t.cols[i].identity = lexdb_sql.ID_NONE
            } else if a.kind == lexdb_sql.A_DROP_DEFAULT {
                if t.cols[i].identity == lexdb_sql.ID_ALWAYS || t.cols[i].identity == lexdb_sql.ID_BY_DEFAULT {
                    return Err(lexdb_base.errDetail("42601", &("column \"" + a.name + "\" of relation \"" + rel + "\" is an identity column"), "",
                                                    "Use ALTER TABLE ... ALTER COLUMN ... DROP IDENTITY instead."))
                }
                t.cols[i].def = None
                t.cols[i].seq = ""
                t.cols[i].identity = lexdb_sql.ID_NONE
            } else if a.kind == lexdb_sql.A_DROP_NOT_NULL {
                for k in t.pk {
                    if k == i { return Err(e("42P16", &("column \"" + a.name + "\" is in a primary key"))) }
                }
                if t.cols[i].identity == lexdb_sql.ID_ALWAYS || t.cols[i].identity == lexdb_sql.ID_BY_DEFAULT {
                    return Err(e("42601", &("column \"" + a.name + "\" of relation \"" + rel + "\" is an identity column")))
                }
                t.cols[i].notNull = false
            } else if a.kind == lexdb_sql.A_ADD_IDENTITY {
                try addIdentity(st, txn, mut &t, i, a)
            } else if a.kind == lexdb_sql.A_SET_IDENTITY {
                try setIdentity(st, txn, mut &t, i, a)
            } else if a.kind == lexdb_sql.A_DROP_IDENTITY {
                if !isIdentity(&t.cols[i]) {
                    if !a.ifFlag { return Err(notIdentity(&t, &a.name)) }
                    notice(st, txn, &"00000", &("column \"" + a.name + "\" of relation \"" + rel + "\" is not an identity column, skipping"), &"")
                    continue
                }
                match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&t.cols[i].seq))) {
                    Some(v) { try dropSeqRows(st, txn, &lexdb_catalog.decSeq(&v)) }
                    None {}
                }
                t.cols[i].seq = ""
                t.cols[i].identity = lexdb_sql.ID_NONE
            }
        }
    }
    var changes: []Retype = []
    var fromInt4: []int = []
    var retyped = false
    for j in types {
        let a = &s.alters[j]
        let i = colIndex(&t.cols, &a.name)
        if i < 0 { return Err(e("42703", &("column \"" + a.name + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist"))) }
        for ch in changes {
            if ch.col == i { return Err(e("42601", &("multiple changes of the type of column \"" + a.name + "\""))) }
        }
        if len(t.cols[i].seq) > 0 && a.col.typ.kind != lexdb_sql.K_INT {
            return Err(e("0A000", &("lexdb: column \"" + a.name + "\" takes its default from a sequence, so its type stays an integer")))
        }
        if s.mdialect != lexdb_sql.MD_TSQL && (try fkUses(st, txn, &t, &a.name)) {
            return Err(e("0A000", &("lexdb: column \"" + a.name + "\" is in a foreign key, so its type cannot be changed (drop the constraint first)")))
        }
        if s.mdialect == lexdb_sql.MD_ORA { try oracleModify(st, txn, &t, i, &a.col.typ) }
        if s.mdialect == lexdb_sql.MD_PG && a.using.isNone() && !autoCast(&t.cols[i].typ, &a.col.typ) {
            return Err(e("42804", &("column \"" + a.name + "\" cannot be cast automatically to type " + lexdb_sql.typeText(&a.col.typ) +
                         " (USING " + a.name + "::" + lexdb_sql.typeText(&a.col.typ) + " would)")))
        }
        // PostgreSQL's view over a retyped column stops it (SQL Server's and Oracle's views are not stopped)
        if s.mdialect == lexdb_sql.MD_PG {
            let used = try viewUsing(st, txn, &t.name, &a.name)
            if len(used) > 0 {
                return Err(lexdb_base.errDetail("0A000", "cannot alter type of a column used by a view or rule",
                                                &("view " + lexdb_sql.baseName(&used) + " depends on column \"" + a.name + "\" of table " + lexdb_sql.baseName(&t.name)), ""))
            }
        }
        if a.using.isSome() || !widens(&t.cols[i].typ, &a.col.typ) { retyped = true }
        var u = match a.using { Some(x) { Some(lexdb_sql.cloneExpr(&x)) } None { None } }
        // SQL Server's bit converts to a number
        if s.mdialect == lexdb_sql.MD_TSQL && u.isNone() && t.cols[i].typ.kind == lexdb_sql.K_BOOL && a.col.typ.kind == lexdb_sql.K_INT {
            u = Some(Expr.Cast(Expr.Col(a.name.clone(), -1), a.col.typ))
            retyped = true
        }
        // (and a decimal or float to an integer drops the fraction: SQL Server does not round)
        if s.mdialect == lexdb_sql.MD_TSQL && u.isNone() && (t.cols[i].typ.kind == lexdb_sql.K_NUM || t.cols[i].typ.kind == lexdb_sql.K_FLOAT) && a.col.typ.kind == lexdb_sql.K_INT {
            u = Some(Expr.Cast(Expr.Call("trunc", [Expr.Col(a.name.clone(), -1)], false), a.col.typ))
            retyped = true
        }
        if t.cols[i].typ.oid == lexdb_sql.OID_INT4 { append(mut &fromInt4, i) }
        append(mut &changes, Retype{col: i, typ: a.col.typ, using: u})
    }
    // the key: none left, the hidden one (9.88); one like the old, nothing
    // to rewrite
    var rw = noRewrite()
    if pk.changed {
        if len(t.pk) == 0 {
            var rc = lexdb_sql.colDef(lexdb_catalog.ROWID, lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}, true)
            rc.identity = lexdb_sql.ID_ALWAYS
            append(mut &t.cols, rc)
            if len(t.slots) > 0 {
                append(mut &t.slots, t.width)
                t.width += 1
            }
            t.pk = [len(t.cols) - 1]
            t.pkName = ""
            try makeColSeqs(st, txn, mut &t, len(t.cols) - 1, &[])
            try ownColSeq(st, txn, &t, len(t.cols) - 1)
            rw.rowid = len(t.cols) - 1
        }
        var keyNow: []str = []
        if lexdb_catalog.hasPk(&t) { for i in t.pk { append(mut &keyNow, t.cols[i].name.clone()) } }
        var same = len(keyNow) == len(keyWas) && len(keyNow) > 0
        if same { for k in 0..len(keyNow) { if keyNow[k] != keyWas[k] { same = false } } }
        if !same {
            rw.rekey = true
            rw.sorted = rw.rowid >= 0
            for n in pk.nn {
                let c = colIndex(&t.cols, &n)
                if c >= 0 { append(mut &rw.nn, c) }
            }
        }
    }
    for n in fills {
        let c = colIndex(&t.cols, &n)
        if c >= 0 { append(mut &rw.fills, c) }
    }
    if retyped || rw.rekey || len(rw.fills) > 0 {
        let rr = rewrite(st, txn, mut &t, &changes, &rw, lim)
        let n = match rr {
            Ok(x) { x }
            Err(bad) { return Err(retypeErr(bad, s.mdialect, &changes, &fromInt4)) }
        }
        // the hidden key's sequence goes on after the rows numbered
        if rw.rowid >= 0 {
            if n > 0 {
                match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&t.cols[rw.rowid].seq))) {
                    Some(v) { try setVal(st, &lexdb_catalog.decSeq(&v), n, true) }
                    None {}
                }
            }
        }
    } else {
        for ch in changes { t.cols[ch.col].typ = ch.typ }
    }
    // a default must be one of the new type
    for ch in changes {
        match t.cols[ch.col].def {
            Some(x) {
                match defaultValue(&x, &t.cols[ch.col], &Option[SeqEnv].None) {
                    Ok(v) {}
                    Err(bad) {
                        if s.mdialect != lexdb_sql.MD_PG || (bad.state != "22P02" && bad.state != "22003" && bad.state != "22007") { return Err(bad) }
                        return Err(lexdb_base.errDetail("42804", &("default for column \"" + t.cols[ch.col].name + "\" cannot be cast automatically to type " + lexdb_sql.typeText(&ch.typ)), "", &("You will need to rewrite or remove the default expression.")))
                    }
                }
            }
            None {}
        }
        // an identity column's sequence takes its new type, its bounds the
        // type's where they were the old's (PostgreSQL's AS; a serial's
        // sequence keeps its own), 9.117
        if isIdentity(&t.cols[ch.col]) && ch.typ.kind == lexdb_sql.K_INT {
            match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&t.cols[ch.col].seq))) {
                Some(v) {
                    var d = lexdb_catalog.decSeq(&v)
                    if d.typ != ch.typ.oid {
                        if d.max == typMax(d.typ) { d.max = typMax(ch.typ.oid) }
                        if d.min == typMin(d.typ) { d.min = typMin(ch.typ.oid) }
                        if d.max > typMax(ch.typ.oid) || d.min < typMin(ch.typ.oid) {
                            return Err(e("22023", &("MAXVALUE (" + d.max.toStr() + ") is out of range for sequence data type " + lexdb_sql.typeText(&ch.typ))))
                        }
                        d.typ = ch.typ.oid
                        try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&d.key)), &(lexdb_catalog.encSeq(&d)))
                    }
                }
                None {}
            }
        }
    }
    pruneInvalid(mut &t)
    try txn.put(lexdb_catalog.CATALOG, &t.name, &(lexdb_catalog.encTable(&t)))
    try bumpFor(st, txn, &t.name)
    return Ok(tagOnly("ALTER TABLE"))
}

// ---- a table's primary key changed (9.117)
//
// lexdb keeps a table's rows in a tree under their key (a table without one
// under a hidden one, 9.88), so a new key is a new tree: ALTER TABLE
// changes t.pk as its actions come, and rewrites the table once after them
// (rewrite). The key's name is t.pkName.

// What ALTER TABLE's actions did to the key: changed, and the columns ADD
// PRIMARY KEY made NOT NULL (their rows checked by the rewrite).
type PkChange = record { changed: bool; nn: []str }

// Whether name is taken among t's constraints, its key's among them.
fn conTaken(t: &Table, name: &str): bool { return hasConName(t, name) || (lexdb_catalog.hasPk(t) && lexdb_catalog.pkConName(t) == name) }

// ADD [CONSTRAINT name] PRIMARY KEY (cols) | USING INDEX ix: t.pk made
// those columns (NOT NULL), the hidden key's column dropped.
fn addPrimary(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, c: &lexdb_sql.Constraint, pk: mut &PkChange): Result[Unit, DbErr] {
    let rel = lexdb_sql.baseName(&t.name)
    if lexdb_catalog.hasPk(t) { return Err(e("42P16", &("multiple primary keys for table \"" + rel + "\" are not allowed"))) }
    var cols: []int = []
    var name = c.name.clone()
    if len(c.index) > 0 {
        let k = try usableIndex(st, txn, t, &c.index)
        for x in t.indexes[k].cols { append(mut &cols, x) }
        if len(name) == 0 { name = lexdb_sql.baseName(&t.indexes[k].name) }
        if conTaken(t, &name) { return Err(e("42710", &("constraint \"" + name + "\" for relation \"" + rel + "\" already exists"))) }
        if name != lexdb_sql.baseName(&t.indexes[k].name) {
            if try relExists(st, txn, &lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &name)) {
                return Err(e("42P07", &("relation \"" + name + "\" already exists")))
            }
            notice(st, txn, &"00000", &("ALTER TABLE / ADD CONSTRAINT USING INDEX will rename index \"" + lexdb_sql.baseName(&t.indexes[k].name) +
                                        "\" to \"" + name + "\""), &"")
        }
        // the key is the table's own tree: the index goes
        let ix = collections.removeAt(mut &t.indexes, k)
        txn.dropTree(ix.tree)
        txn.del(lexdb_catalog.CATALOG, &(idxName(&ix.name)))
    } else {
        for n in c.cols {
            let i = colIndex(&t.cols, &n)
            if i < 0 { return Err(e("42703", &("column \"" + n + "\" of relation \"" + rel + "\" does not exist"))) }
            for x in cols { if x == i { return Err(e("42701", &("column \"" + n + "\" appears twice in primary key constraint"))) } }
            append(mut &cols, i)
        }
        if len(name) == 0 { name = try makeName(st, txn, t, &[], &"pkey", true) }
        if conTaken(t, &name) { return Err(e("42710", &("constraint \"" + name + "\" for relation \"" + rel + "\" already exists"))) }
        if try relExists(st, txn, &lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &name)) {
            return Err(e("42P07", &("relation \"" + name + "\" already exists")))
        }
    }
    for i in cols {
        if !t.cols[i].notNull {
            t.cols[i].notNull = true
            append(mut &pk.nn, t.cols[i].name.clone())
        }
    }
    let hidden = if lexdb_catalog.rowidKeyed(t) { t.pk[0] } else { -1 }
    t.pk = cols
    t.pkName = if name == rel + "_pkey" { "" } else { name }
    if hidden >= 0 {
        // the hidden key's column and its sequence go
        try dropOwnedSeqs(st, txn, t, &lexdb_catalog.ROWID)
        try dropColumn(txn, t, hidden)
    }
    pk.changed = true
    return Ok(Unit{})
}

// DROP CONSTRAINT of t's key (or DROP COLUMN of a column in it): the
// foreign keys referencing it through it (refused, or with cascade
// dropped); t.pk then [] (the statement's end gives it the hidden one).
// Its columns stay NOT NULL, as in PostgreSQL 18.
// col: the column whose drop drops it ("" DROP CONSTRAINT), for the errors.
fn dropPrimary(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, cascade: bool, col: &str): Result[Unit, DbErr] {
    let name = lexdb_catalog.pkConName(t)
    var key: []int = []
    for i in t.pk { append(mut &key, i) }
    let what = if len(col) > 0 { "column " + col + " of table " + lexdb_sql.baseName(&t.name) } else { "constraint " + name + " on table " + lexdb_sql.baseName(&t.name) }
    let on = if len(col) > 0 { what.clone() } else { "index " + name }
    try dropKeyRefs(st, txn, t, &what, &on, cascade, fn(f: &ForeignKey, p: &Table): bool {
        let rc = colsOf(p, &f.refCols)
        return len(rc) == len(key) && prefixSame(&key, len(rc), &rc) && keyIndex(p, &rc, -1) == -1 && uniqueOn(p, &rc, -1) < 0
    })
    t.pk = []
    t.pkName = ""
    return Ok(Unit{})
}

// Which of p's unique indexes (not filtered) is cols, in any order, other
// than except; -1 none.
fn uniqueOn(p: &Table, cols: &[]int, except: int): int {
    for k in 0..len(p.indexes) {
        let ix = &p.indexes[k]
        if k != except && ix.unique && ix.pred.isNone() && len(ix.cols) == len(cols) && prefixSame(&ix.cols, len(cols), cols) { return k }
    }
    return -1
}

// The foreign keys referencing table t (its own among them) that depend on
// its constraint con (hit says which): refused, as PostgreSQL's 2BP01 with
// the first named, or with cascade dropped, a notice naming them.
// what: what is dropped ("constraint x on table t"); on: what they depend
// on ("index x").
fn dropKeyRefs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, what0: &str, on: &str, cascade: bool,
               hit: &fn(&ForeignKey, &Table): bool): Result[Unit, DbErr] {
    var gone: []str = []
    var kids: []str = []
    for k in t.refBy { append(mut &kids, k.clone()) }
    for ck in kids {
        if ck == t.name {
            var k = 0
            while k < len(t.fks) {
                let h = t.fks[k].ref == t.name && hit(&t.fks[k], t)
                if h {
                    let what = "constraint " + t.fks[k].name + " on table " + lexdb_sql.baseName(&t.name)
                    if !cascade { return Err(keyDepends(what0, on, &what)) }
                    append(mut &gone, what)
                    try dropOwnFk(st, txn, t, k)
                } else {
                    k += 1
                }
            }
        } else {
            var c = try byKey(st, txn, &ck)
            var changed = false
            var k = 0
            while k < len(c.fks) {
                let h = c.fks[k].ref == t.name && hit(&c.fks[k], t)
                if h {
                    let what = "constraint " + c.fks[k].name + " on table " + lexdb_sql.baseName(&c.name)
                    if !cascade { return Err(keyDepends(what0, on, &what)) }
                    append(mut &gone, what)
                    let dropped = collections.removeAt(mut &c.fks, k)
                    changed = true
                } else {
                    k += 1
                }
            }
            if changed {
                var still = false
                for f in c.fks { if f.ref == t.name { still = true } }
                if !still { dropKey(mut &t.refBy, &ck) }
                try putTable(txn, &c)
            }
        }
    }
    if len(gone) == 1 { notice(st, txn, &"00000", &("drop cascades to " + gone[0]), &"") }
    if len(gone) > 1 {
        var lines: []str = []
        for g in gone { append(mut &lines, "drop cascades to " + g) }
        notice(st, txn, &"00000", &("drop cascades to " + len(gone).toStr() + " other objects"), &strings.join(&lines, "\n"))
    }
    return Ok(Unit{})
}

fn keyDepends(dropped: &str, on: &str, what: &str): DbErr {
    return lexdb_base.errDetail("2BP01", &("cannot drop " + dropped + " because other objects depend on it"),
                                &(what + " depends on " + on), "Use DROP ... CASCADE to drop the dependent objects too.")
}

// The index of t named n, for a constraint USING INDEX: PostgreSQL's
// checks, in its order.
fn usableIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, n: &str): Result[int, DbErr] {
    let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), n)
    let owner = try st.get(txn, lexdb_catalog.CATALOG, &(idxName(&key)))
    if owner.isNone() { return Err(e("42704", &("index \"" + n + "\" does not exist"))) }
    var k = -1
    for x in 0..len(t.indexes) { if t.indexes[x].name == key { k = x } }
    if k < 0 {
        // (another table's: PostgreSQL tells a constraint's first)
        let other = try needTable(st, txn, &owner.unwrap())
        for ox in other.indexes { if ox.name == key && ox.con { return Err(e("55000", &("index \"" + n + "\" is already associated with a constraint"))) } }
        return Err(e("55000", &("index \"" + n + "\" does not belong to table \"" + lexdb_sql.baseName(&t.name) + "\"")))
    }
    let ix = &t.indexes[k]
    let why = "Cannot create a primary key or unique constraint using such an index."
    if ix.con { return Err(e("55000", &("index \"" + n + "\" is already associated with a constraint"))) }
    if !ix.unique { return Err(lexdb_base.errDetail("42809", &("\"" + n + "\" is not a unique index"), &why, "")) }
    for c in ix.cols { if c < 0 { return Err(lexdb_base.errDetail("42809", &("index \"" + n + "\" contains expressions"), &why, "")) } }
    if ix.pred.isSome() { return Err(lexdb_base.errDetail("42809", &("\"" + n + "\" is a partial index"), &why, "")) }
    for j in 0..len(ix.opts) {
        if len(ix.opts[j]) > 0 && strings.toLowerAscii(&ix.opts[j]) != "asc" && strings.toLowerAscii(&ix.opts[j]) != "asc nulls last" {
            return Err(lexdb_base.errDetail("42809", &("index \"" + n + "\" column number " + (j + 1).toStr() + " does not have default sorting behavior"), &why, ""))
        }
    }
    return Ok(k)
}

// ADD [CONSTRAINT name] UNIQUE USING INDEX ix: the index made the
// constraint's (renamed to its name).
fn uniqueUsing(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, c: &lexdb_sql.Constraint): Result[Unit, DbErr] {
    let k = try usableIndex(st, txn, t, &c.index)
    let was = lexdb_sql.baseName(&t.indexes[k].name)
    let name = if len(c.name) > 0 { c.name.clone() } else { was.clone() }
    if conTaken(t, &name) { return Err(e("42710", &("constraint \"" + name + "\" for relation \"" + lexdb_sql.baseName(&t.name) + "\" already exists"))) }
    if name != was {
        let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &name)
        if try relExists(st, txn, &key) { return Err(e("42P07", &("relation \"" + name + "\" already exists"))) }
        notice(st, txn, &"00000", &("ALTER TABLE / ADD CONSTRAINT USING INDEX will rename index \"" + was + "\" to \"" + name + "\""), &"")
        txn.del(lexdb_catalog.CATALOG, &(idxName(&t.indexes[k].name)))
        t.indexes[k].name = key.clone()
        try txn.put(lexdb_catalog.CATALOG, &(idxName(&key)), &t.name)
    }
    t.indexes[k].con = true
    return Ok(Unit{})
}

// RENAME CONSTRAINT from TO to: a CHECK's, a foreign key's, a UNIQUE's
// (its index too) or the key's.
fn renameConstraint(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, from: &str, to: &str): Result[Unit, DbErr] {
    let rel = lexdb_sql.baseName(&t.name)
    if !conTaken(t, from) { return Err(e("42704", &("constraint \"" + from + "\" for table \"" + rel + "\" does not exist"))) }
    if from == to { return Ok(Unit{}) }
    if conTaken(t, to) { return Err(e("42710", &("constraint \"" + to + "\" for relation \"" + rel + "\" already exists"))) }
    let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), to)
    for k in 0..len(t.invalid) { if t.invalid[k] == from { t.invalid[k] = to.toStr() } }
    for k in 0..len(t.checks) { if t.checks[k].name == from { t.checks[k].name = to.toStr() } }
    for k in 0..len(t.fks) { if t.fks[k].name == from { t.fks[k].name = to.toStr() } }
    for k in 0..len(t.indexes) {
        if t.indexes[k].con && lexdb_sql.baseName(&t.indexes[k].name) == from {
            if try relExists(st, txn, &key) { return Err(e("42P07", &("relation \"" + to + "\" already exists"))) }
            txn.del(lexdb_catalog.CATALOG, &(idxName(&t.indexes[k].name)))
            t.indexes[k].name = key.clone()
            try txn.put(lexdb_catalog.CATALOG, &(idxName(&key)), &t.name)
        }
    }
    if lexdb_catalog.hasPk(t) && lexdb_catalog.pkConName(t) == from {
        if try relExists(st, txn, &key) { return Err(e("42P07", &("relation \"" + to + "\" already exists"))) }
        t.pkName = to.toStr()
    }
    return Ok(Unit{})
}

// VALIDATE CONSTRAINT name: a CHECK or foreign key added NOT VALID, its
// rows checked now.
fn validateConstraint(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, name: &str): Result[Unit, DbErr] {
    let rel = lexdb_sql.baseName(&t.name)
    var kind = 0
    for c in t.checks { if c.name == name { kind = 1 } }
    for f in t.fks { if f.name == name { kind = 2 } }
    if kind == 0 {
        if conTaken(t, name) {
            return Err(lexdb_base.errDetail("42809", &("cannot validate constraint \"" + name + "\" of relation \"" + rel + "\""),
                                            "This operation is not supported for this type of constraint.", ""))
        }
        return Err(e("42704", &("constraint \"" + name + "\" of relation \"" + rel + "\" does not exist")))
    }
    if !lexdb_base.hasStr(&t.invalid, name) { return Ok(Unit{}) }
    if kind == 1 {
        for c in t.checks { if c.name == name { try checkRows(st, txn, t, &c) } }
    } else {
        for f in t.fks {
            if f.name != name { continue }
            if f.ref == t.name {
                let pt = try decTable(&t.name, &lexdb_catalog.encTable(t))
                try fkRows(st, txn, t, &f, &pt)
            } else {
                let pt = try byKey(st, txn, &f.ref)
                try fkRows(st, txn, t, &f, &pt)
            }
        }
    }
    dropKey(mut &t.invalid, name)
    return Ok(Unit{})
}

// t.invalid without the names of constraints gone.
fn pruneInvalid(t: mut &Table) {
    var keep: []str = []
    for n in t.invalid {
        var there = false
        for c in t.checks { if c.name == n { there = true } }
        for f in t.fks { if f.name == n { there = true } }
        if there { append(mut &keep, n.clone()) }
    }
    t.invalid = keep
}

// The rows of t against check c (23514).
fn checkRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, c: &Check): Result[Unit, DbErr] {
    let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
    let sc = lexdb_access.allScan()
    var cur = lexdb_access.newCursor()
    while !cur.done {
        var batch: [][]Val = []
        let all: []bool = []
        try fetch(st, txn, t, &path, &sc, &all, mut &cur, mut &batch)
        for r in batch {
            if !(try passes(t, c, &r)) {
                return Err(e("23514", &("check constraint \"" + c.name + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" is violated by some row")))
            }
        }
    }
    return Ok(Unit{})
}

// ---- identity columns changed (9.117)

fn isIdentity(c: &lexdb_sql.ColDef): bool {
    return (c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT) && len(c.seq) > 0 && c.name != lexdb_catalog.ROWID
}

fn notIdentity(t: &Table, col: &str): DbErr {
    return e("55000", &("column \"" + col + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" is not an identity column"))
}

// ALTER COLUMN c ADD GENERATED ... AS IDENTITY [(options)]: its sequence
// made (t_c_seq), starting where its options say; the rows there keep their
// values, as in PostgreSQL.
fn addIdentity(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, i: int, a: &lexdb_sql.Alter): Result[Unit, DbErr] {
    let rel = lexdb_sql.baseName(&t.name)
    let cn = t.cols[i].name.clone()
    if t.cols[i].typ.kind != lexdb_sql.K_INT { return Err(e("22023", "identity column type must be smallint, integer, or bigint")) }
    if !t.cols[i].notNull {
        return Err(e("55000", &("column \"" + cn + "\" of relation \"" + rel + "\" must be declared NOT NULL before identity can be added")))
    }
    if isIdentity(&t.cols[i]) { return Err(e("55000", &("column \"" + cn + "\" of relation \"" + rel + "\" is already an identity column"))) }
    if t.cols[i].def.isSome() || len(t.cols[i].seq) > 0 {
        return Err(e("55000", &("column \"" + cn + "\" of relation \"" + rel + "\" already has a default value")))
    }
    t.cols[i].identity = a.col.identity
    try makeColSeqs(st, txn, t, i, &[lexdb_sql.IdOpts{col: cn, opts: seqOptsCopy(&a.seq)}])
    return ownColSeq(st, txn, t, i)
}

fn seqOptsCopy(o: &lexdb_sql.SeqOpts): lexdb_sql.SeqOpts {
    var r = lexdb_sql.noSeqOpts()
    lexdb_sql.mergeSeqOpts(mut &r, o)
    r.restart = o.restart
    r.restartWith = o.restartWith
    return r
}

// Column i's new sequence (serial, identity) owned by its table's owner,
// as PostgreSQL's (a superuser's ALTER of another's table included).
fn ownColSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, i: int): Result[Unit, DbErr] {
    if len(t.cols[i].seq) == 0 { return Ok(Unit{}) }
    let a = try readAcl(st, txn, &lexdb_catalog.relObj(&t.name))
    let owner = if len(a.owner) > 0 { a.owner.clone() } else { currentRole(st, txn.sql.sess) }
    return writeAcl(txn, &lexdb_catalog.relObj(&t.cols[i].seq), &Acl{owner: owner, grants: [], set: false})
}

// ALTER COLUMN c SET GENERATED ..., SET options, RESTART [WITH n]: its
// sequence's options changed as ALTER SEQUENCE's; RESTART at once, as there.
fn setIdentity(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, i: int, a: &lexdb_sql.Alter): Result[Unit, DbErr] {
    if !isIdentity(&t.cols[i]) { return Err(notIdentity(t, &t.cols[i].name)) }
    if a.col.identity != lexdb_sql.ID_NONE { t.cols[i].identity = a.col.identity }
    let o = &a.seq
    let any = o.typ != 0 || o.hasInc || o.hasMin != 0 || o.hasMax != 0 || o.hasStart || o.cache != 0 || o.cycle != 0 || o.restart != 0
    if !any { return Ok(Unit{}) }
    let old = match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&t.cols[i].seq))) {
        Some(v) { lexdb_catalog.decSeq(&v) }
        None { return Err(lexdb_base.corrupt(&("the sequence of column \"" + t.cols[i].name + "\""))) }
    }
    let d = try seqFrom(o, &old, false)
    try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&d.key)), &(lexdb_catalog.encSeq(&d)))
    seqForget(st, &d)
    if o.restart > 0 { try restartSeq(st, &d, if o.restart == 2 { o.restartWith } else { d.start }) }
    return Ok(Unit{})
}

// RESTART [WITH v] of sequence d: PostgreSQL's bounds errors, then as
// setval(d, v, false).
fn restartSeq(st: &lexdb_store.Store, d: &Seq, v: int): Result[Unit, DbErr] {
    if v < d.min { return Err(e("22023", &("RESTART value (" + v.toStr() + ") cannot be less than MINVALUE (" + d.min.toStr() + ")"))) }
    if v > d.max { return Err(e("22023", &("RESTART value (" + v.toStr() + ") cannot be greater than MAXVALUE (" + d.max.toStr() + ")"))) }
    return setVal(st, d, v, false)
}

fn createSchemaStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if try schemaExists(st, txn, &s.table) {
        if s.ifFlag {
            notice(st, txn, &"42P06", &("schema \"" + s.table + "\" already exists, skipping"), &"")
            return Ok(tagOnly("CREATE SCHEMA"))
        }
        return Err(e("42P06", &("schema \"" + s.table + "\" already exists")))
    }
    if strings.startsWith(&s.table, "pg_") { return Err(e("42939", &("unacceptable schema name \"" + s.table + "\""))) }
    // a superuser's (PostgreSQL: the database's CREATE, its owner's); owned by AUTHORIZATION's role, or its maker
    let w = try whoNow(st, txn)
    if !w.super { return Err(e("42501", "permission denied for database lexdb")) }
    var owner = currentRole(st, txn.sql.sess)
    if len(s.names) > 0 {
        owner = roleName(st, txn, &s.names[0])
        if !(try roleExists(st, txn, &owner)) { return Err(e("42704", &("role \"" + owner + "\" does not exist"))) }
    }
    try txn.put(lexdb_catalog.CATALOG, &(schemaKey(&s.table)), "")
    try writeAcl(txn, &lexdb_catalog.nspObj(&s.table), &Acl{owner: owner, grants: [], set: false})
    try bumpCatalog(st, txn)
    return Ok(tagOnly("CREATE SCHEMA"))
}

// DROP SCHEMA: refused while it holds a table, unless CASCADE, which drops
// them.
fn dropSchema(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if s.table == "public" { return Err(e("0A000", "lexdb: schema public cannot be dropped")) }
    if !(try schemaExists(st, txn, &s.table)) {
        if s.ifFlag {
            notice(st, txn, &"00000", &("schema \"" + s.table + "\" does not exist, skipping"), &"")
            return Ok(tagOnly("DROP SCHEMA"))
        }
        return Err(e("3F000", &("schema \"" + s.table + "\" does not exist")))
    }
    try needOwner(st, txn, &(try whoNow(st, txn)), &lexdb_catalog.nspObj(&s.table), &"schema", &s.table)
    let from = lexdb_sql.qual(&s.table, &"")
    var keys: []str = []
    try st.scan(txn, lexdb_catalog.CATALOG, &from, &(from + "\xff"), fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key.clone())
        return true
    })
    let seqs = try lexdb_catalog.allSeqs(st, txn, &s.table)
    var rtns: []lexdb_sql.Routine = []
    for r in try lexdb_catalog.allRoutines(st, txn) { if lexdb_sql.schemaOf(&r.key) == s.table { append(mut &rtns, r.clone()) } }
    if (len(keys) > 0 || len(seqs) > 0 || len(rtns) > 0) && !s.cascade {
        return Err(e("2BP01", &("cannot drop schema " + s.table + " because other objects depend on it")))
    }
    for r in rtns { txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.routineKey(r.dialect, &r.key, &lexdb_routine.sigOf(&r)))) }
    for k in keys {
        match try byKeyOpt(st, txn, &k) {
            Some(t) {
                if len(t.view) > 0 {
                    try dropDependentViews(st, txn, &t.name, true, &"view")
                    txn.del(lexdb_catalog.CATALOG, &t.name)
                    dropAcl(txn, &lexdb_catalog.relObj(&t.name))
                } else {
                    var d = t
                    try dropDependentViews(st, txn, &d.name, true, &"table")
                    try unlinkTable(st, txn, mut &d, true)
                    dropOne(txn, &d)
                }
            }
            None {}
        }
    }
    for d in try lexdb_catalog.allSeqs(st, txn, &s.table) { try dropSeqRows(st, txn, &d) }
    txn.del(lexdb_catalog.CATALOG, &(schemaKey(&s.table)))
    dropAcl(txn, &lexdb_catalog.nspObj(&s.table))
    try bumpCatalog(st, txn)
    return Ok(tagOnly("DROP SCHEMA"))
}

// CREATE [UNIQUE] INDEX: a tree of its own, filled from the table's rows in
// the same transaction.
fn createIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if s.conc && txn.inBlock() { return Err(e("25001", "CREATE INDEX CONCURRENTLY cannot run inside a transaction block")) }
    var t = try needTable(st, txn, &s.table)
    try needRelOwner(st, txn, &t.name, &"table")
    var ixName = s.index.clone()
    if len(ixName) == 0 {
        // CREATE INDEX ON t (...) (9.94): the name PostgreSQL chooses
        var cns: []str = []
        for k in 0..len(s.names) {
            append(mut &cns, if len(s.names[k]) == 0 && k < len(s.exprs) { indexColName(&s.exprs[k]) } else { s.names[k].clone() })
        }
        ixName = try chooseIndexName(st, txn, &t, &cns)
    }
    let ixKey = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &ixName)     // in its table's schema
    let exists = try relExists(st, txn, &ixKey)
    if exists {
        if s.ifFlag {
            notice(st, txn, &"42P07", &("relation \"" + ixName + "\" already exists, skipping"), &"")
            return Ok(tagOnly("CREATE INDEX"))
        }
        return Err(e("42P07", &("relation \"" + s.index + "\" already exists")))
    }
    var cols: []int = []
    var exprs: []Expr = []
    var anyExpr = false
    for k in 0..len(s.names) {
        let n = s.names[k].clone()
        if len(n) == 0 && k < len(s.exprs) {
            // an expression (9.89): of the table's columns, no aggregate,
            // nothing whose value changes (PostgreSQL's IMMUTABLE)
            let x = &s.exprs[k]
            var ns: []str = []
            lexdb_sql.colNames(x, mut &ns)
            for cn in ns { if colIndex(&t.cols, &cn) < 0 { return Err(e("42703", &("column \"" + cn + "\" does not exist"))) } }
            if hasAgg(x) { return Err(e("42803", "aggregate functions are not allowed in index expressions")) }
            if !immutable(x) { return Err(e("42P17", "functions in index expression must be marked IMMUTABLE")) }
            append(mut &cols, -1)
            append(mut &exprs, lexdb_sql.slotted(x, &t.cols))
            anyExpr = true
            continue
        }
        let i = colIndex(&t.cols, &n)
        if i < 0 { return Err(e("42703", &("column \"" + n + "\" does not exist"))) }
        append(mut &cols, i)
        append(mut &exprs, Expr.Lit(Val.Null))
    }
    if !anyExpr { exprs = [] }
    var pred: Option[Expr] = None
    match s.where {
        Some(w) {
            // A filtered index: its predicate uses the table's columns, and no
            // parameters or aggregates.
            var ns: []str = []
            lexdb_sql.colNames(&w, mut &ns)
            for n in ns {
                if colIndex(&t.cols, &n) < 0 { return Err(e("42703", &("column \"" + n + "\" does not exist"))) }
            }
            if hasAgg(&w) { return Err(e("42803", "aggregate functions are not allowed in index predicates")) }
            if len(s.subs) > 0 { return Err(e("0A000", "cannot use subquery in index predicate")) }
            if s.params > 0 { return Err(e("42P02", "there is no parameter $1")) }
            pred = Some(lexdb_sql.slotted(&w, &t.cols))
        }
        None {}
    }
    let ix = Index{name: ixKey, tree: st.createTree(txn), cols: cols, unique: s.unique, pred: pred, con: false, opts: collections.copyOf(&s.pk), exprs: exprs}
    try addIndex(st, txn, mut &t, ix)
    try txn.put(lexdb_catalog.CATALOG, &t.name, &(lexdb_catalog.encTable(&t)))
    try bumpFor(st, txn, &t.name)
    return Ok(tagOnly("CREATE INDEX"))
}

// Fills index ix from table t's rows (a unique one checked) and adds it to
// t, its catalog row naming t (t's own row is the caller's to write).
// The entries are written in key order (sorted here, as PostgreSQL's and
// SQLite's index builds sort): each then goes past the tree's last, so its
// leaves are left full (lexdb_store applyPut), where the table's order put
// them anywhere and left them about 70% full (design/lexdb.md 9.109). A
// unique index's duplicates are then neighbours: two entries with the same
// columns, none NULL (the tree is new, so they are all there is to check).
fn addIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, ix: Index): Result[Unit, DbErr] {
    match try lexdb_access.buildIndex(st, txn, &lexdb_catalog.relOf(t), &ix,
                                      fn(xi: &Index, r: &[]Val): Result[bool, DbErr] { return inIndex(t, xi, r) },
                                      fn(xi: &Index, k: int, r: &[]Val): Result[Val, DbErr] { return idxVal(t, xi, k, r) }) {
        Some(row) { return Err(dupMade(t, &lexdb_sql.baseName(&ix.name), &ix.cols, &ix.exprs, &row)) }
        None {}
    }
    try txn.put(lexdb_catalog.CATALOG, &(idxName(&ix.name)), &t.name)
    append(mut &t.indexes, ix)
    return Ok(Unit{})
}

// ---- UNIQUE constraints (9.39): a unique index the constraint owns, of
// the same name.

// A name PostgreSQL's way: table, columns and a suffix joined by "_", cut
// to 63 bytes, a number added while the name is taken in the schema.
// A CHECK's name need only be free among the table's constraints (rel
// false): it is not a relation.
fn makeName(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, cols: &[]str, suffix: &str, rel: bool): Result[str, DbErr] {
    var parts = [lexdb_sql.baseName(&t.name)]
    for c in cols { append(mut &parts, c.clone()) }
    var base = strings.join(&parts, "_")
    if len(base) + 1 + len(suffix) > 63 { base = base[0..63 - 1 - len(suffix)].clone() }
    let sc = lexdb_sql.schemaOf(&t.name)
    var n = 0
    while true {
        let name = base + "_" + suffix + (if n == 0 { "" } else { n.toStr() })
        let taken = rel && try relExists(st, txn, &lexdb_sql.qual(&sc, &name))
        if !taken && !hasConName(t, &name) { return Ok(name) }
        n += 1
    }
    return Ok("")
}

// An index expression's part of an index's name, as PostgreSQL's
// FigureIndexColname: a call's name, a cast's operand's, "case", else "expr".
fn indexColName(x: &Expr): str {
    match x {
        Expr.Col(n, _) { return lexdb_bind.colPart(&n) }
        Expr.Cast(a, t) {
            let n = indexColName(&a)
            return if n == "expr" { lexdb_sql.typeText(&t) } else { n }
        }
        Expr.Call(n, args, star) {
            if n == "case" || n == "case else" { return "case" }
            if strings.startsWith(&n, "#") || lexdb_sql.isQuant(&n) || n == "like" || n == "ilike" || n == "similar" || n == "in" ||
               n == "distinct from" { return "expr" }
            let sp = strings.indexOf(&n, " ", 0)
            return if sp < 0 { n.clone() } else { n[0..sp].clone() }
        }
        else { return "expr" }
    }
}

// The first n bytes of s or fewer, not splitting a character.
fn clipName(s: &str, n: int): str {
    if len(s) <= n { return s.toStr() }
    var k = n
    while k > 0 && (s[k] & 0xC0) == 0x80 { k -= 1 }
    return s[0..k].toStr()
}

// PostgreSQL's makeObjectName: name1_name2_label in 63 bytes, the longer
// of name1 and name2 cut first.
fn objectName(name1: &str, name2: &str, label: &str): str {
    var n1 = len(name1)
    var n2 = len(name2)
    let avail = 63 - (if len(name2) > 0 { 1 } else { 0 }) - (len(label) + 1)
    while n1 + n2 > avail {
        if n1 > n2 { n1 -= 1 } else { n2 -= 1 }
    }
    var out = clipName(name1, n1)
    if len(name2) > 0 { out = out + "_" + clipName(name2, n2) }
    return out + "_" + label
}

// The name of CREATE INDEX ON t (...) without one (9.94), as PostgreSQL's
// ChooseIndexName: t, the columns' names (an expression's from
// indexColName; one again numbered) joined by _, and idx; idx1, idx2 ...
// while a relation in t's schema has it.
fn chooseIndexName(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, cols: &[]str): Result[str, DbErr] {
    var names: []str = []
    for c in cols {
        var cur = c.toStr()
        var i = 1
        while lexdb_base.hasStr(&names, &cur) {
            let suf = i.toStr()
            cur = clipName(&c, 63 - len(suf)) + suf
            i += 1
        }
        append(mut &names, cur)
    }
    var add = ""
    for n in names {
        if len(add) > 0 { add = add + "_" }
        add = add + n
        if len(add) >= 64 { break }
    }
    add = clipName(&add, 63)
    let sc = lexdb_sql.schemaOf(&t.name)
    var pass = 0
    while true {
        let name = objectName(&lexdb_sql.baseName(&t.name), &add, &("idx" + (if pass == 0 { "" } else { pass.toStr() })))
        if !(try relExists(st, txn, &lexdb_sql.qual(&sc, &name))) { return Ok(name) }
        pass += 1
    }
    return Ok("")
}

fn hasConName(t: &Table, name: &str): bool {
    for ix in t.indexes { if ix.con && lexdb_sql.baseName(&ix.name) == name { return true } }
    for c in t.checks { if c.name == name { return true } }
    for f in t.fks { if f.name == name { return true } }
    return false
}

// Adds constraint c to table t (its rows checked against it).
// alter: ALTER TABLE's (its CHECK and FOREIGN KEY may be NOT VALID: the
// rows there not checked, 9.117), not CREATE TABLE's.
fn addConstraint(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, c: &lexdb_sql.Constraint, alter: bool): Result[Unit, DbErr] {
    let later = alter && c.notValid
    if c.kind == lexdb_sql.C_CHECK { return addCheck(st, txn, t, c, later) }
    if c.kind == lexdb_sql.C_FOREIGN { return addForeign(st, txn, t, c, later) }
    var cols: []int = []
    for n in c.cols {
        let i = colIndex(&t.cols, &n)
        if i < 0 { return Err(e("42703", &("column \"" + n + "\" named in key does not exist"))) }
        for k in cols { if k == i { return Err(e("42701", &("column \"" + n + "\" appears twice in unique constraint"))) } }
        append(mut &cols, i)
    }
    var name = c.name.clone()
    if len(name) == 0 { name = try makeName(st, txn, t, &c.cols, &"key", true) }
    let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &name)
    if hasConName(t, &name) { return Err(e("42710", &("constraint \"" + name + "\" for relation \"" + lexdb_sql.baseName(&t.name) + "\" already exists"))) }
    // (the key's index's name is a relation's in PostgreSQL)
    if (lexdb_catalog.hasPk(t) && lexdb_catalog.pkConName(t) == name) || try relExists(st, txn, &key) { return Err(e("42P07", &("relation \"" + name + "\" already exists"))) }
    let ix = Index{name: key, tree: st.createTree(txn), cols: cols, unique: true, pred: None, con: true, opts: [], exprs: []}
    return addIndex(st, txn, t, ix)
}

// ---- CHECK constraints (9.40)

// Adds a CHECK to table t, the rows there checked. Its columns must be
// t's; no aggregate (a subquery or parameter the parser refused).
// later: NOT VALID, the rows there left unchecked until VALIDATE.
fn addCheck(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, c: &lexdb_sql.Constraint, later: bool): Result[Unit, DbErr] {
    let x = match c.expr {
        Some(v) { lexdb_sql.cloneExpr(&v) }
        None { Expr.Lit(Val.Bool(true)) }
    }
    var ns: []str = []
    lexdb_sql.colNames(&x, mut &ns)
    var refs: []str = []
    for n in ns {
        if colIndex(&t.cols, &n) < 0 { return Err(e("42703", &("column \"" + n + "\" does not exist"))) }
        var seen = false
        for r in refs { if r == n { seen = true } }
        if !seen { append(mut &refs, n.clone()) }
    }
    if hasAgg(&x) { return Err(e("42803", "aggregate functions are not allowed in check constraints")) }
    var name = c.name.clone()
    if len(name) == 0 {
        // a column's is named for it, a table's for its one column, or none
        let none: []str = []
        let named = if len(c.cols) > 0 { &c.cols } else if len(refs) == 1 { &refs } else { &none }
        name = try makeName(st, txn, t, named, &"check", false)
    }
    if hasConName(t, &name) { return Err(e("42710", &("constraint \"" + name + "\" for relation \"" + lexdb_sql.baseName(&t.name) + "\" already exists"))) }
    let ck = Check{name: name.clone(), expr: lexdb_sql.slotted(&x, &t.cols)}
    // Not a boolean: tried on a row of zeros ('' and false), as there is
    // no type of an expression without a row (an error then is let be:
    // a division by the zero).
    var zeros: []Val = []
    for col in t.cols {
        let k = col.typ.kind
        append(mut &zeros, if k == lexdb_sql.K_INT { Val.Int(0) } else if k == lexdb_sql.K_BOOL { Val.Bool(false) }
                           else if k == lexdb_sql.K_NUM { Val.Num(Decimal.zero()) } else if k == lexdb_sql.K_ARRAY { Val.Text("{}") } else { Val.Text("") })
    }
    match passes(t, &ck, &zeros) {
        Ok(_) {}
        Err(bad) { if bad.state == "42804" { return Err(bad) } }
    }
    // the rows there
    if later { append(mut &t.invalid, name) } else { try checkRows(st, txn, t, &ck) }
    append(mut &t.checks, ck)
    return Ok(Unit{})
}

// Whether row passes check c: true or NULL (as SQL's CHECK has it).
fn passes(t: &Table, c: &Check, row: &[]Val): Result[bool, DbErr] {
    let noAggs: []Val = []
    let noParams: []Val = []
    let noSubs: []SubRes = []
    let noSeq: Option[SeqEnv] = None
    let env = Env{cols: &t.cols, row: row, aggs: &noAggs, params: &noParams, subs: &noSubs, cur: &noAggs, seq: &noSeq}
    let v = try bpEval(t, &c.expr, &env)
    match v {
        Val.Null { return Ok(true) }
        Val.Bool(b) { return Ok(b) }
        else { return Err(e("42804", "argument of CHECK must be type boolean")) }
    }
}

// A row to be written, against table t's checks.
fn checkChecks(t: &Table, row: &[]Val): Result[Unit, DbErr] {
    for c in t.checks {
        if !(try passes(t, &c, row)) {
            return Err(e("23514", &("new row for relation \"" + lexdb_sql.baseName(&t.name) + "\" violates check constraint \"" + c.name + "\"")))
        }
    }
    return Ok(Unit{})
}

// Drops table t's constraint named name: false when it has none. A unique
// constraint a foreign key needs is refused, or with cascade the foreign
// key dropped too.
fn dropConstraint(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, name: &str, cascade: bool): Result[bool, DbErr] {
    for k in 0..len(t.checks) {
        if t.checks[k].name == name {
            let gone = collections.removeAt(mut &t.checks, k)
            return Ok(true)
        }
    }
    for k in 0..len(t.fks) {
        if t.fks[k].name == name {
            try dropOwnFk(st, txn, t, k)
            return Ok(true)
        }
    }
    for k in 0..len(t.indexes) {
        if t.indexes[k].con && lexdb_sql.baseName(&t.indexes[k].name) == name {
            try dropNeeded(st, txn, t, k, cascade, &("constraint " + name + " on table " + lexdb_sql.baseName(&t.name)))
            let ix = collections.removeAt(mut &t.indexes, k)
            txn.dropTree(ix.tree)
            txn.del(lexdb_catalog.CATALOG, &(idxName(&ix.name)))
            return Ok(true)
        }
    }
    return Ok(false)
}

fn dropIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if s.conc && txn.inBlock() { return Err(e("25001", "DROP INDEX CONCURRENTLY cannot run inside a transaction block")) }
    let ixKey = try catKey(st, txn, &s.index, true)
    match try st.get(txn, lexdb_catalog.CATALOG, &(idxName(&ixKey))) {
        Some(tn) {
            var t = try needTable(st, txn, &tn)
            try needRelOwner(st, txn, &t.name, &"index")
            for k in 0..len(t.indexes) {
                if t.indexes[k].name == ixKey && t.indexes[k].con {
                    let n = lexdb_sql.baseName(&ixKey)
                    return Err(e("2BP01", &("cannot drop index " + n + " because constraint " + n + " on table " + lexdb_sql.baseName(&t.name) +
                                 " requires it (drop the constraint instead)")))
                }
                if t.indexes[k].name == ixKey {
                    try dropNeeded(st, txn, mut &t, k, false, &("index " + lexdb_sql.baseName(&ixKey)))
                }
            }
            var old = replace(mut &t.indexes, [])
            var rev: []Index = []
            while len(old) > 0 {
                let ix = pop(mut &old)
                if ix.name == ixKey { txn.dropTree(ix.tree) } else { append(mut &rev, ix) }
            }
            while len(rev) > 0 { append(mut &t.indexes, pop(mut &rev)) }
            txn.del(lexdb_catalog.CATALOG, &(idxName(&ixKey)))
            try txn.put(lexdb_catalog.CATALOG, &t.name, &(lexdb_catalog.encTable(&t)))
            try bumpFor(st, txn, &t.name)
            return Ok(tagOnly("DROP INDEX"))
        }
        None {
            if s.ifFlag {
                notice(st, txn, &"00000", &("index \"" + lexdb_sql.shown(&s.index) + "\" does not exist, skipping"), &"")
                return Ok(tagOnly("DROP INDEX"))
            }
            return Err(e("42704", &("index \"" + lexdb_sql.shown(&s.index) + "\" does not exist")))
        }
    }
}

fn checkRow(t: &Table, row: &[]Val): Result[Unit, DbErr] {
    for i in 0..len(t.cols) {
        if t.cols[i].notNull && lexdb_ops.isNull(&row[i]) {
            return Err(lexdb_base.errDetail("23502", &("null value in column \"" + t.cols[i].name + "\" of relation \"" + lexdb_sql.baseName(&t.name) +
                                            "\" violates not-null constraint"), &(failingRow(t, row)), ""))
        }
    }
    return Ok(Unit{})
}

// PostgreSQL's DETAIL for a row refused: its values, NULL as null (the
// hidden key's left out, 9.117).
fn failingRow(t: &Table, row: &[]Val): str {
    var vs: []str = []
    for i in 0..len(t.cols) {
        if t.cols[i].name == lexdb_catalog.ROWID || i >= len(row) { continue }
        append(mut &vs, if lexdb_ops.isNull(&row[i]) { "null" } else { lexdb_sql.text(&row[i]) })
    }
    return "Failing row contains (" + strings.join(&vs, ", ") + ")."
}

fn dupKey(t: &Table, row: &[]Val): DbErr {
    var names: []str = []
    var vals: []str = []
    for i in t.pk {
        append(mut &names, t.cols[i].name.clone())
        append(mut &vals, lexdb_sql.text(&row[i]))
    }
    return lexdb_base.errDetail("23505", &("duplicate key value violates unique constraint \"" + lexdb_catalog.pkConName(t) + "\""),
                                &("Key (" + strings.join(&names, ", ") + ")=(" + strings.join(&vals, ", ") + ") already exists."), "")
}

fn insert(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    try notView(st, txn, &s.table, &"insert into")
    try dmlCheck(st, txn, s, &"a")
    let sqe = seqEnv(st, txn)
    let t = try needTable(st, txn, &s.table)
    // T-SQL's SET IDENTITY_INSERT t ON (design/lexdb-tds.md S3)
    let ovr = if s.overriding == lexdb_sql.OVR_NONE && identityInsertOf(st, txn.sql.sess) == lexdb_sql.baseName(&t.name) { lexdb_sql.OVR_TSQL } else { s.overriding }
    var targets: []int = []
    if len(s.names) == 0 {
        for i in 0..len(t.cols) { if t.cols[i].name != lexdb_catalog.ROWID { append(mut &targets, i) } }
    } else {
        for n in s.names {
            let i = colIndex(&t.cols, &n)
            if i < 0 { return Err(e("42703", &("column \"" + n + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist"))) }
            append(mut &targets, i)
        }
    }
    // its subqueries are run first; with RETURNING, over the table's columns
    var sc = newScopeIn(st, txn, params, &[])
    let noFrom: []lexdb_sql.FromItem = []
    let noWhere: Option[Expr] = None
    let from = if len(s.items) > 0 { oneTable(&s.table) } else { noFrom }
    var q = try buildQuery(st, txn, &from, &noWhere, params, &s.subs, &newMap(), true, mut &sc, false)
    var rows: [][]Expr = []
    let resolved = len(s.subs) > 0 || len(s.items) > 0
    if resolved && len(s.inner) == 0 {
        for r in s.rows {
            var rr: []Expr = []
            for x in r { append(mut &rr, try lexdb_bind.resolve(&x, &q.cols, 0, mut &sc.names)) }
            append(mut &rows, rr)
        }
    }
    var ret = try retOf(s, &q, mut &sc)
    var up = try upsertOf(s, &t, mut &sc)
    up.idBump = ovr == lexdb_sql.OVR_TSQL
    endScope(mut &sc, mut &q)
    var rs = newRun(&q)
    rs.limit(&lim)
    rs.writes = true                // optimizer 19: a write keeps its index paths (its read set)
    let m = try prepare(st, txn, &q, params, mut &rs)
    var kept: [][]Val = []
    var count = 0
    let parents = up.mode == lexdb_sql.CONFLICT_UPDATE        // an update may change a key other rows refer to
    if len(s.inner) > 0 {
        // INSERT ... SELECT: the query's rows inserted as it gives them
        // (eachRow), so they are not all held first. A query that reads the
        // table it inserts into runs to its end first, so it never reads the
        // rows it inserts.
        let noTypes: []int = []
        var ssc = newScopeIn(st, txn, params, &noTypes)
        var sel = try planSelect(st, txn, &s.inner[0], params, mut &ssc)
        // (its aggregates the pipeline's)
        bindSel(mut &sel)
        pipeSelIn(mut &sel, false)
        // the logical plan (read by nothing yet): the query's plan its source
        let lp = lexdb_bind.LPlan.Insert(t.name.toStr(), collections.copyOf(&targets), takeLp(mut &sel), retBCols(&ret))
        let defs = try defaultsOf(st, txn, &t)
        let fw = try fkTables(st, txn, &t, true, parents)
        var later: []FkLater = []
        let noAggs: []Val = []
        let env = Env{cols: &q.cols, row: &noAggs, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
        if try stmtReads(st, txn, &s.inner[0], &t.name) {
            var res = try runSel(st, txn, &sel, params, lim)
            for i in 0..len(res.rows) {
                let r = replace(mut &res.rows[i], [])
                count += try insertSelRow(st, txn, &t, &targets, &sel.outs, &r, &defs, ovr, &fw, mut &later, mut &up, &env, ret.on, mut &kept)
            }
        } else {
            // With foreign keys, rows are held up to a chunk (32, doubling to BROWS) and their parents probed
            // together (fkAhead), then written in order; a query's error comes after the writes of the rows
            // before it, as when they were written as they came
            let chunked = len(t.fks) > 0 && up.mode != lexdb_sql.CONFLICT_UPDATE && plainDefaults(&t, &targets, &defs)
            var held: [][]Val = []
            var heldBytes = 0
            var want = 32
            let ran = eachRow(st, txn, &sel, params, lim, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
                if !chunked {
                    count += try insertSelRow(st, tx, &t, &targets, &sel.outs, r, &defs, ovr, &fw, mut &later, mut &up, &env, ret.on, mut &kept)
                    return Ok(true)
                }
                append(mut &held, collections.copyOf(r))
                heldBytes += lexdb_pipe.rowBytes(r)
                if len(held) >= want || heldBytes >= HELD_BYTES {
                    count += try insertSelRows(st, tx, &t, &targets, &sel.outs, &held, &defs, ovr, &fw, mut &later, mut &up, &env, ret.on, mut &kept)
                    held = []
                    heldBytes = 0
                    want = min(want * 2, lexdb_rows.BROWS)
                }
                return Ok(true)
            })
            if len(held) > 0 { count += try insertSelRows(st, txn, &t, &targets, &sel.outs, &held, &defs, ovr, &fw, mut &later, mut &up, &env, ret.on, mut &kept) }
            try ran
        }
        try fkFinish(st, txn, &fw, mut &later)
    } else {
        // the logical plan (read by nothing yet): VALUES its source, its rows the statement's
        let lp = lexdb_bind.LPlan.Insert(t.name.toStr(), collections.copyOf(&targets),
                                         lexdb_bind.LPlan.Values(if len(s.rows) > 0 { len(s.rows[0]) } else { 0 }, [], []), retBCols(&ret))
        let noAggs: []Val = []
        let env = Env{cols: &q.cols, row: &noAggs, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
        count = if resolved { try insertRows(st, txn, &t, &targets, &rows, &env, ovr, ret.on, mut &kept, mut &up) }
                else { try insertRows(st, txn, &t, &targets, &s.rows, &env, ovr, ret.on, mut &kept, mut &up) }
    }
    for row in kept { try retAdd(st, txn, &q, &m, params, mut &ret, &row, mut &rs) }
    // IDENTITY_INSERT: an identity given a value past its own goes on from there
    for j in 0..len(up.idCols) {
        let d = try needSeq(st, txn, &t.cols[up.idCols[j]].seq)
        let v = up.idMax[j]
        let next = try seqPeek(st, txn, &d)
        if (d.inc > 0 && v >= next) || (d.inc < 0 && v <= next) { try setVal(st, &d, v, true) }
    }
    return Ok(retRes(ret, &("INSERT 0 " + count.toStr())))
}

// The most an INSERT ... SELECT holds of the rows it reads ahead, in bytes.
const HELD_BYTES: int = 4 * 1024 * 1024

// A chunk of an INSERT ... SELECT's rows inserted, in order, their parents
// looked up together first: how many were inserted.
fn insertSelRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, targets: &[]int, cols: &[]OutCol, rows: &[][]Val,
                 defs: &Defs, ovr: int, fw: &[]Table, later: mut &[]FkLater, up: mut &Upsert, env: &Env,
                 keep: bool, kept: mut &[][]Val): Result[int, DbErr] {
    try fkAhead(st, txn, t, fw, targets, up, rows)
    var n = 0
    for r in rows { n += try insertSelRow(st, txn, t, targets, cols, &r, defs, ovr, fw, later, up, env, keep, kept) }
    return Ok(n)
}

// One row of an INSERT ... SELECT's query inserted: 1, or 0 (ON CONFLICT
// DO NOTHING). cols: the query's columns.
fn insertSelRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, targets: &[]int, cols: &[]OutCol, r: &[]Val,
                defs: &Defs, ovr: int, fw: &[]Table, later: mut &[]FkLater, up: mut &Upsert, env: &Env,
                keep: bool, kept: mut &[][]Val): Result[int, DbErr] {
    var vs: []Val = []
    for k in 0..len(r) {
        if k < len(targets) && try idDefault(t, targets[k], false, ovr) {
            append(mut &vs, try defAt(st, txn, defs, t, targets[k]))
        } else if k < len(cols) && k < len(targets) && cols[k].oid == lexdb_sql.OID_BPCHAR && lexdb_ops.kindOf(&r[k]) == lexdb_sql.K_TEXT &&
                  t.cols[targets[k]].typ.kind == lexdb_sql.K_TEXT && t.cols[targets[k]].typ.oid != lexdb_sql.OID_BPCHAR {
            append(mut &vs, Val.Text(lexdb_ops.bpTrim(&lexdb_sql.text(&r[k]))))     // a char into a text: without its blanks (9.94)
        } else {
            append(mut &vs, r[k].clone())
        }
    }
    match try insertOne(st, txn, t, targets, &vs, defs, fw, later, up, env) {
        Some(row) {
            if keep { append(kept, row) }
            return Ok(1)
        }
        None { return Ok(0) }
    }
}

// Whether a query reads relation key (a table's catalog key): in FROM, in
// a view it reads (any view not known to leave it out counts), or in its
// subqueries and set operations' branches.
fn stmtReads(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, key: &str): Result[bool, DbErr] {
    for f in s.from {
        if f.sub >= 0 || f.work >= 0 || len(f.table) == 0 { continue }       // (subqueries: below)
        match try findTable(st, txn, &f.table) {
            Some(t) {
                if t.name == key { return Ok(true) }
                if len(t.view) > 0 {
                    for d in t.deps {
                        if d == key { return Ok(true) }
                        // a view over a view: read through, the same way
                        match try byKeyOpt(st, txn, &d) {
                            Some(dt) { if len(dt.view) > 0 { return Ok(true) } }
                            None {}
                        }
                    }
                }
            }
            None {}
        }
    }
    for b in s.subs { if try stmtReads(st, txn, &b, key) { return Ok(true) } }
    for b in s.inner { if try stmtReads(st, txn, &b, key) { return Ok(true) } }
    return Ok(false)
}

// The value a sequence's nextval would give now (not taking it).
fn seqPeek(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, d: &Seq): Result[int, DbErr] {
    match st.memo.get(&memoNext(d)) {
        Some(nv) { return Ok(if nv == "e" { if d.inc > 0 { d.max } else { d.min } } else { lexdb_base.num(&nv) }) }
        None {}
    }
    let tree = try seqTree(st, txn)
    match try st.get(txn, tree, &d.id) {
        Some(v) { return Ok(lexdb_base.num(&v) + d.inc) }
        None { return Ok(d.start) }
    }
}

// ---- RETURNING (9.44): rows of values per row written, over the table's
// columns (an INSERT's or UPDATE's new row, a DELETE's old one)

type Ret = record {
    on: bool                    // the statement has RETURNING
    outs: []OutCol
    exprs: []Expr
    rows: [][]Val
}

// Its items resolved over q's columns (q: the statement's table alone).
fn retOf(s: &lexdb_sql.Stmt, q: &Query, sc: mut &Scope): Result[Ret, DbErr] {
    var r = Ret{on: len(s.items) > 0, outs: [], exprs: [], rows: []}
    if !r.on { return Ok(r) }
    r.outs = try lexdb_bind.itemCols(&s.items, true, &q.cols, mut &sc.names, mut &r.exprs)
    for x in r.exprs {
        if hasAgg(&x) { return Err(e("42803", "aggregate functions are not allowed in RETURNING")) }
    }
    return Ok(r)
}

// RETURNING's columns as a DML operator's (LPlan.Insert and the like): [] none.
fn retBCols(r: &Ret): []lexdb_bind.BCol {
    if !r.on { return [] }
    return outBCols(&r.outs)
}

fn retAdd(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val, r: mut &Ret,
          row: &[]Val, rs: mut &Run): Result[Unit, DbErr] {
    let none: []Val = []
    return retAddOld(st, txn, q, m, params, r, row, &none, rs)
}

// retAdd with the row before an UPDATE: T-SQL's OUTPUT DELETED.c (#old(c)).
fn retAddOld(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val, r: mut &Ret,
             row: &[]Val, old: &[]Val, rs: mut &Run): Result[Unit, DbErr] {
    if !r.on { return Ok(Unit{}) }
    let noAggs: []Val = []
    let sqe1 = seqEnv(st, txn)
    let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe1}
    var out: []Val = []
    for x0 in r.exprs {
        let x = if len(old) > 0 { oldRefs(&x0, &q.cols, old) } else { lexdb_sql.cloneExpr(&x0) }
        append(mut &out, try evalX(st, txn, q, &x, &env, rs))
    }
    append(mut &r.rows, out)
    return Ok(Unit{})
}

// #old(c): the old row's c, as a value.
fn oldRefs(x: &Expr, cols: &[]lexdb_sql.ColDef, old: &[]Val): Expr {
    match x {
        Expr.Call(f, args, star) {
            if f == "#old" && len(args) == 1 {
                match args[0] {
                    Expr.Col(n, sl) {
                        let i = lexdb_bind.colSlot(cols, &n, sl)
                        if i >= 0 && i < len(old) { return Expr.Lit(old[i].clone()) }
                    }
                    else {}
                }
            }
            var out: []Expr = []
            for a in args { append(mut &out, oldRefs(&a, cols, old)) }
            return Expr.Call(f.clone(), out, star)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), oldRefs(&a, cols, old)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), oldRefs(&a, cols, old), oldRefs(&b, cols, old)) }
        Expr.Cast(a, t) { return Expr.Cast(oldRefs(&a, cols, old), t) }
        Expr.IsNull(a, n) { return Expr.IsNull(oldRefs(&a, cols, old), n) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

fn retRes(r: Ret, tag: &str): Res {
    if !r.on { return tagOnly(tag) }
    let Ret{on: _, outs: outs, exprs: _, rows: rows} = move(r)
    return Res{cols: outs, rows: rows, tag: tag.clone(), hasRows: true, copy: COPY_NONE}
}

// Whether column i of t takes its default though a value was given (an
// identity column under OVERRIDING USER VALUE); an error if it may not
// take one (GENERATED ALWAYS, with no OVERRIDING SYSTEM VALUE).
fn idDefault(t: &Table, i: int, isDef: bool, ovr: int): Result[bool, DbErr] {
    let id = t.cols[i].identity
    if isDef || (id != lexdb_sql.ID_ALWAYS && id != lexdb_sql.ID_BY_DEFAULT) { return Ok(false) }
    if ovr == lexdb_sql.OVR_USER { return Ok(true) }
    if id == lexdb_sql.ID_ALWAYS && ovr != lexdb_sql.OVR_SYSTEM && ovr != lexdb_sql.OVR_TSQL {
        return Err(lexdb_base.errDetail("428C9", &("cannot insert a non-DEFAULT value into column \"" + t.cols[i].name + "\""),
                                        &("Column \"" + t.cols[i].name + "\" is an identity column defined as GENERATED ALWAYS."),
                                        "Use OVERRIDING SYSTEM VALUE to override."))
    }
    return Ok(false)
}

// The rows of VALUES inserted: their count (each kept, with keep).
fn insertRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, targets: &[]int, rows: &[][]Expr,
              env: &Env, ovr: int, keep: bool, kept: mut &[][]Val, up: mut &Upsert): Result[int, DbErr] {
    let defs = try defaultsOf(st, txn, t)
    let fw = try fkTables(st, txn, t, true, up.mode == lexdb_sql.CONFLICT_UPDATE)
    var later: []FkLater = []
    var count = 0
    var chunkEnd = 0
    var want = 32
    for ri in 0..len(rows) {
        let r = &rows[ri]
        if ri == chunkEnd && len(rows) > 1 && len(t.fks) > 0 {
            // a chunk's parents looked up together, from the literals and parameters it gives for the keys
            let to = min(ri + want, len(rows))
            if len(up.fk.fks) == 0 && up.mode != lexdb_sql.CONFLICT_UPDATE { up.fk = fkProbes(t, &fw, targets) }
            if up.fk.any() {
                let spec = up.fk.given(rows, ri, to, len(targets), env.params)
                try fkAhead(st, txn, t, &fw, targets, up, &spec)
            }
            chunkEnd = to
            want = min(want * 2, lexdb_rows.BROWS)
        }
        var vs: []Val = []
        for k in 0..len(r) {
            if k >= len(targets) { return Err(e("42601", "INSERT has more expressions than target columns")) }
            let isDef = lexdb_sql.isDefault(&r[k])
            if isDef || try idDefault(t, targets[k], false, ovr) {
                append(mut &vs, try defAt(st, txn, &defs, t, targets[k]))
            } else {
                append(mut &vs, try eval(&r[k], env))
            }
        }
        match try insertOne(st, txn, t, targets, &vs, &defs, &fw, mut &later, up, env) {
            Some(row) {
                if keep { append(kept, row) }
                count += 1
            }
            None {}
        }
    }
    try fkFinish(st, txn, &fw, mut &later)
    return Ok(count)
}

// A row of values for the target columns (the rest their defaults): the
// row inserted, or under ON CONFLICT the row it updated instead (9.77);
// None when it did neither (DO NOTHING, or DO UPDATE's WHERE false).
fn insertOne(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, targets: &[]int, vs: &[]Val,
             defs: &Defs, fw: &[]Table, later: mut &[]FkLater, up: mut &Upsert, env: &Env): Result[Option[[]Val], DbErr] {
    if len(vs) > len(targets) { return Err(e("42601", "INSERT has more expressions than target columns")) }
    var row = array(len(t.cols), Val.Null)
    var given: []bool = []
    for i in 0..len(t.cols) { append(mut &given, false) }
    for k in 0..len(vs) {
        let ci = targets[k]
        row[ci] = try lexdb_ops.coerceZ(vs[k].clone(), &t.cols[ci].typ, &txn.sql.zone)
        given[ci] = true
    }
    // the others their defaults (a sequence's taken only for these)
    for i in 0..len(t.cols) {
        if given[i] { continue }
        if len(defs.seqs[i].key) > 0 && t.cols[i].name == lexdb_catalog.ROWID {
            // the hidden key: the statement's run of its sequence's values;
            // currval and lastval are not set, as PostgreSQL has no such key
            if up.ridLeft == 0 {
                let r = try nextRun(st, &defs.seqs[i], up.ridWant)
                up.ridNext = r.first
                up.ridLeft = r.count
                if up.ridWant < ROWID_RUN { up.ridWant = up.ridWant * 2 }
            }
            row[i] = Val.Int(up.ridNext)
            up.ridNext += defs.seqs[i].inc
            up.ridLeft -= 1
            continue
        }
        row[i] = try defAt(st, txn, defs, t, i)
    }
    if up.idBump {
        for i in 0..len(t.cols) {
            if !given[i] || len(t.cols[i].seq) == 0 { continue }
            match row[i] {
                Val.Int(v) {
                    var at = -1
                    for j in 0..len(up.idCols) { if up.idCols[j] == i { at = j } }
                    if at < 0 {
                        append(mut &up.idCols, i)
                        append(mut &up.idMax, v)
                    } else if v > up.idMax[at] { up.idMax[at] = v }
                }
                else {}
            }
        }
    }
    try checkRow(t, &row)
    try checkChecks(t, &row)
    if up.mode != lexdb_sql.CONFLICT_NONE {
        match try conflictOf(st, txn, t, up, &row) {
            Some(old) { return upsertOld(st, txn, t, defs, fw, later, up, env, &old, &row) }
            None {}
        }
    }
    let r = try storeRow(st, txn, t, row, fw, later, mut &up.fk)
    if up.mode != lexdb_sql.CONFLICT_NONE { up.touched.put(keyOf(t, &r), 1) }
    return Ok(Some(r))
}

// ---- INSERT ... ON CONFLICT (9.77)

// What an INSERT does on a conflict: nothing, or update the row there.
type Upsert = record {
    mode: int                   // lexdb_sql.CONFLICT_*
    arb: []int                  // the unique keys that count: -1 the primary key, else an index of t.indexes
    targets: []int              // DO UPDATE SET's columns
    sets: []Expr                // ... and values, over cols
    cond: Option[Expr]          // DO UPDATE's WHERE, over cols
    cols: []lexdb_sql.ColDef    // the table's columns (alias.column), then EXCLUDED's (excluded.column)
    touched: Map[str, int]      // the rows the statement inserted or updated, by primary key
    // IDENTITY_INSERT (lexdb_sql.OVR_TSQL): per identity column given a
    // value, the largest (idCols[i] the column)
    idBump: bool
    idCols: []int
    idMax: []int
    // the hidden key's values not yet used, from its sequence's last run
    // (9.119): next, then left more; want, the next run's size (doubled each
    // time, up to ROWID_RUN, so a one-row INSERT takes one)
    ridNext: int
    ridLeft: int
    ridWant: int
    // the statement's foreign keys' parents probed ahead (lexdb_fkprobe): empty
    // for a single row, under DO UPDATE (it may change a key a row refers to),
    // and until the first chunk
    fk: lexdb_fkprobe.Probes
}

const ROWID_RUN: int = 1024

fn noUpsert(): Upsert {
    return Upsert{mode: lexdb_sql.CONFLICT_NONE, arb: [], targets: [], sets: [], cond: None, cols: [], touched: newMap(), idBump: false,
                  idCols: [], idMax: [], ridNext: 0, ridLeft: 0, ridWant: 1, fk: lexdb_fkprobe.none()}
}

fn sameCols(a: &[]int, b: &[]int): bool {
    if len(a) != len(b) { return false }
    for x in a {
        var found = false
        for y in b { if x == y { found = true } }
        if !found { return false }
    }
    return true
}

// The ON CONFLICT of s on table t: its unique keys (the target's, or every
// one for DO NOTHING without a target) and DO UPDATE's assignments,
// resolved over the table's columns as alias.column and EXCLUDED's as
// excluded.column: a bare name in an expression is in both, so ambiguous
// (42702), as in PostgreSQL; only the column SET names stands alone.
fn upsertOf(s: &lexdb_sql.Stmt, t: &Table, sc: mut &Scope): Result[Upsert, DbErr] {
    var up = noUpsert()
    up.mode = s.conflict
    if s.conflict == lexdb_sql.CONFLICT_NONE { return Ok(up) }
    let tname = lexdb_sql.baseName(&t.name)
    if len(s.conflictCols) > 0 {
        var cs: []int = []
        for n in s.conflictCols {
            let i = colIndex(&t.cols, &n)
            if i < 0 { return Err(e("42703", &("column \"" + n + "\" does not exist"))) }
            append(mut &cs, i)
        }
        if sameCols(&cs, &t.pk) { append(mut &up.arb, -1) }
        for i in 0..len(t.indexes) { if t.indexes[i].unique && sameCols(&cs, &t.indexes[i].cols) { append(mut &up.arb, i) } }
        if len(up.arb) == 0 {
            return Err(e("42P10", "there is no unique or exclusion constraint matching the ON CONFLICT specification"))
        }
    } else if s.conflictCon != "" {
        if lexdb_catalog.hasPk(t) && s.conflictCon == lexdb_catalog.pkConName(t) { append(mut &up.arb, -1) }
        for i in 0..len(t.indexes) {
            if t.indexes[i].unique && lexdb_sql.baseName(&t.indexes[i].name) == s.conflictCon { append(mut &up.arb, i) }
        }
        if len(up.arb) == 0 { return Err(e("42704", &("constraint \"" + s.conflictCon + "\" for table \"" + tname + "\" does not exist"))) }
    } else {
        if s.conflict == lexdb_sql.CONFLICT_UPDATE {
            return Err(e("42601", "ON CONFLICT DO UPDATE requires inference specification or constraint name"))
        }
        append(mut &up.arb, -1)
        for i in 0..len(t.indexes) { if t.indexes[i].unique { append(mut &up.arb, i) } }
    }
    if s.conflict == lexdb_sql.CONFLICT_NOTHING { return Ok(up) }
    let alias = if s.alias != "" { s.alias.clone() } else { tname.clone() }
    for c in t.cols { append(mut &up.cols, lexdb_sql.colDef(&(alias + "." + c.name), c.typ, false)) }
    for c in t.cols { append(mut &up.cols, lexdb_sql.colDef(&("excluded." + c.name), c.typ, false)) }
    for set in s.sets {
        let i = colIndex(&t.cols, &set.col)
        if i < 0 { return Err(e("42703", &("column \"" + set.col + "\" of relation \"" + tname + "\" does not exist"))) }
        if t.cols[i].identity == lexdb_sql.ID_ALWAYS && !lexdb_sql.isDefault(&set.expr) {
            return Err(lexdb_base.errDetail("428C9", &("column \"" + t.cols[i].name + "\" can only be updated to DEFAULT"),
                                            &("Column \"" + t.cols[i].name + "\" is an identity column defined as GENERATED ALWAYS."), ""))
        }
        append(mut &up.targets, i)
        append(mut &up.sets, lexdb_bind.bpAssign(try lexdb_bind.resolve(&set.expr, &up.cols, len(up.cols), mut &sc.names), &t.cols[i].typ, &up.cols, &typing()))
    }
    match s.where {
        Some(w) { up.cond = Some(try lexdb_bind.resolve(&w, &up.cols, len(up.cols), mut &sc.names)) }
        None {}
    }
    return Ok(up)
}

// The row already in t that row conflicts with on one of up's unique keys,
// if any.
fn conflictOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, up: &Upsert, row: &[]Val): Result[Option[[]Val], DbErr] {
    return lexdb_access.conflictRow(st, txn, &lexdb_catalog.relOf(t), &up.arb, row,
                                    fn(xi: &Index, r: &[]Val): Result[bool, DbErr] { return inIndex(t, xi, r) },
                                    fn(xi: &Index, k: int, r: &[]Val): Result[Val, DbErr] { return idxVal(t, xi, k, r) })
}

// The row there (old), the row proposed (row): DO NOTHING leaves it; DO
// UPDATE sets its columns, unless its WHERE is not true, and may not touch
// a row the statement inserted or updated already (21000).
fn upsertOld(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, defs: &Defs, fw: &[]Table, later: mut &[]FkLater,
             up: mut &Upsert, env: &Env, old: &[]Val, row: &[]Val): Result[Option[[]Val], DbErr] {
    if up.mode == lexdb_sql.CONFLICT_NOTHING { return Ok(None) }
    let oldKey = keyOf(t, old)
    if up.touched.has(&oldKey) {
        return Err(e("21000", "ON CONFLICT DO UPDATE command cannot affect row a second time"))
    }
    var both: []Val = collections.copyOf(old)
    for v in row { append(mut &both, v.clone()) }
    let uenv = Env{cols: &up.cols, row: &both, aggs: env.aggs, params: env.params, subs: env.subs, cur: env.cur, seq: env.seq}
    match up.cond {
        Some(c) { if lexdb_ops.truth(&(try eval(&c, &uenv))) != Some(true) { return Ok(None) } }
        None {}
    }
    var next = collections.copyOf(old)
    for k in 0..len(up.sets) {
        let ci = up.targets[k]
        if lexdb_sql.isDefault(&up.sets[k]) { next[ci] = try defAt(st, txn, defs, t, ci) }
        else { next[ci] = try lexdb_ops.coerceZ(try eval(&up.sets[k], &uenv), &t.cols[ci].typ, &txn.sql.zone) }
    }
    try updRow(st, txn, t, old, &next, fw, later)
    up.touched.put(keyOf(t, &next), 1)
    return Ok(Some(next))
}

// A built row stored: its key free, its indexes and foreign keys checked.
fn storeRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, row: []Val, fw: &[]Table,
            later: mut &[]FkLater, pr: mut &lexdb_fkprobe.Probes): Result[[]Val, DbErr] {
    try checkEnums(st, txn, t, &row)
    // its key free (the hidden key is its sequence's next value, never
    // given: not looked for, 9.119), its index entries added
    let c = try lexdb_access.insertRow(st, txn, &lexdb_catalog.relOf(t), &row,
                                       fn(xi: &Index, r: &[]Val): Result[bool, DbErr] { return inIndex(t, xi, r) },
                                       fn(xi: &Index, k: int, r: &[]Val): Result[Val, DbErr] { return idxVal(t, xi, k, r) },
                                       fn(tx: &lexdb_store.Txn) { lexdb_stats.noteChg(st, tx.sql.sess, t, 0) })
    if c == lexdb_access.PK_CONFLICT { return Err(dupKey(t, &row)) }
    if c >= 0 { return Err(try uniqueErr(t, &t.indexes[c], &row)) }
    if len(t.fks) > 0 {
        let none: []Val = []
        try childSide(st, txn, t, fw, &row, &none, later, pr)
    }
    return Ok(row)
}

fn update(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    if s.copy.batchRows > 0 { return batchDml(st, txn, s, params, lim) }
    var win = noWin()
    return updateB(st, txn, s, params, lim, mut &win)
}

fn updateB(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits, win: mut &Win): Result[Res, DbErr] {
    try notView(st, txn, &s.table, &"update")
    try dmlCheck(st, txn, s, &"w")
    let sqe = seqEnv(st, txn)
    var sc = newScopeIn(st, txn, params, &[])
    sc.target = try catKey(st, txn, &s.table, false)
    var q = try buildQuery(st, txn, &(try dmlFrom(s)), &s.where, params, &s.subs, &newMap(), true, mut &sc, false)
    var targets: []int = []
    var sets: []Expr = []
    for set in s.sets {
        let i = colIndex(&q.levels[0].t.cols, &set.col)
        if i < 0 {
            return Err(e("42703", &("column \"" + set.col + "\" of relation \"" + lexdb_sql.baseName(&q.levels[0].t.name) + "\" does not exist")))
        }
        append(mut &targets, i)
        append(mut &sets, lexdb_bind.bpAssign(try lexdb_bind.resolve(&set.expr, &q.cols, len(q.cols), mut &sc.names), &q.levels[0].t.cols[i].typ, &q.cols, &typing()))
    }
    var ret = try retOf(s, &q, mut &sc)
    // the logical plan (read by nothing yet): the FROM and WHERE part its source
    let lp = lexdb_bind.LPlan.Update(replace(mut &q.lp, lexdb_bind.noPlan()), collections.copyOf(&targets), retBCols(&ret))
    endScope(mut &sc, mut &q)
    if len(s.from) > 0 { levelsProgQ(mut &q, false) }         // its joins in batches (Query.jp)
    if win.n > 0 {
        // a batch's rows are found in primary key order, from the key after the last batch's (stage 8): an UPDATE
        // always reads by the key, so that a row it changed is not found again (the Halloween problem across
        // batches), and may not change the key, which would move a row past the cursor
        if q.levels[0].path.index >= 0 || q.levels[0].path.desc {
            q.levels[0].path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
        }
        win.keyed = true
        for k in targets { for p in q.levels[0].t.pk { if p == k {
            return Err(e("0A000", "lexdb: UPDATE with batch_rows cannot assign a primary key column"))
        } } }
    }
    let t = &q.levels[0].t
    var found: [][]Val = []
    var rs = newRun(&q)
    rs.limit(&lim)
    rs.writes = true                // optimizer 19: a write keeps its index paths (its read set)
    rs.after = win.after.clone()
    var m = try prepare(st, txn, &q, params, mut &rs)
    let room = rs.bud.room()
    let max = rs.bud.maxHeld
    var held = 0
    let wn = win.n
    // a key changed: FOR UPDATE's lock, else FOR NO KEY UPDATE's (9.86)
    var lmode = lexdb_sql.LOCK_NO_KEY_UPDATE
    for k in targets { for p in t.pk { if p == k { lmode = lexdb_sql.LOCK_UPDATE } } }
    let reads0 = txn.readCount()
    while true {
        try runQuery(st, txn, &q, &m, params, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
            held += 2 * lexdb_pipe.rowBytes(r)             // the row found, and its write
            if room >= 0 && held > room { return Err(lexdb_pipe.memErr(max)) }
            append(mut &found, collections.copyOf(r))
            return Ok(wn == 0 || len(found) < wn)         // a batch stops at its n rows
        }, mut &rs)
        found = onceEach(t, found, len(s.from) > 0)
        var nolk: []Look = []
        found = firstN(found, try evalInt(&s.limit, params, "TOP", mut &nolk))     // T-SQL's UPDATE TOP (n), DELETE TOP (n)
        if !(try lockFound(st, txn, t, &found, lmode)) { break }
        // a lock waited for: the rows found again, holding the locks
        found = []
        held = 0
        txn.forgetReads(reads0)
        rs = newRun(&q)
        rs.limit(&lim)
        rs.after = win.after.clone()
        m = try prepare(st, txn, &q, params, mut &rs)
    }
    if win.n > 0 { winEnd(win, t, &found, rs.cnt[0].read) }
    let noAggs: []Val = []
    let defs = try defaultsOf(st, txn, t)
    for k in 0..len(sets) {
        if t.cols[targets[k]].identity == lexdb_sql.ID_ALWAYS && !lexdb_sql.isDefault(&sets[k]) {
            return Err(lexdb_base.errDetail("428C9", &("column \"" + t.cols[targets[k]].name + "\" can only be updated to DEFAULT"),
                                            &("Column \"" + t.cols[targets[k]].name + "\" is an identity column defined as GENERATED ALWAYS."), ""))
        }
    }
    let fw = try fkTables(st, txn, t, true, true)
    var later: []FkLater = []
    // a joined row: t's columns, then FROM's, which SET, RETURNING and
    // WHERE may read
    let nt = len(t.cols)
    for joined in found {
        let env = Env{cols: &q.cols, row: &joined, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
        var all = collections.copyOf(&joined)
        for k in 0..len(sets) {
            if lexdb_sql.isDefault(&sets[k]) { all[targets[k]] = try defAt(st, txn, &defs, t, targets[k]) }
            else { all[targets[k]] = try lexdb_ops.coerceZ(try evalX(st, txn, &q, &sets[k], &env, mut &rs), &t.cols[targets[k]].typ, &txn.sql.zone) }
        }
        // (the table's alone, without FROM: the rows as they are, not copied)
        if len(joined) == nt {
            try updRow(st, txn, t, &joined, &all, &fw, mut &later)
        } else {
            try updRow(st, txn, t, &rowPrefix(&joined, nt), &rowPrefix(&all, nt), &fw, mut &later)
        }
        try retAddOld(st, txn, &q, &m, params, mut &ret, &all, &joined, mut &rs)
    }
    try fkFinish(st, txn, &fw, mut &later)
    return Ok(retRes(ret, &("UPDATE " + len(found).toStr())))
}

fn delete(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    if s.copy.batchRows > 0 { return batchDml(st, txn, s, params, lim) }
    var win = noWin()
    return deleteB(st, txn, s, params, lim, mut &win)
}

fn deleteB(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits, win: mut &Win): Result[Res, DbErr] {
    try notView(st, txn, &s.table, &"delete from")
    try dmlCheck(st, txn, s, &"d")
    var sc = newScopeIn(st, txn, params, &[])
    sc.target = try catKey(st, txn, &s.table, false)
    var q = try buildQuery(st, txn, &(try dmlFrom(s)), &s.where, params, &s.subs, &newMap(), true, mut &sc, false)
    var ret = try retOf(s, &q, mut &sc)
    // the logical plan (read by nothing yet): the FROM and WHERE part its source
    let lp = lexdb_bind.LPlan.Delete(replace(mut &q.lp, lexdb_bind.noPlan()), retBCols(&ret))
    endScope(mut &sc, mut &q)
    if len(s.from) > 0 { levelsProgQ(mut &q, false) }         // its joins in batches (Query.jp)
    delNarrow(mut &q, s)
    // a batched DELETE (stage 8) takes the range path when it can, in its first batch: one write, so already bounded, and
    // atomic; not with entries of other indexes to delete one by one, which are writes too
    if win.n == 0 || win.first {
        match try rangeDelete(st, txn, s, &q, params, &lim, win.n > 0) {
            Some(r) {
                win.done = true
                return Ok(r)
            }
            None {}
        }
    }
    // a batch of a DELETE read by the primary key goes on after the last key done; one read by an index runs
    // again (the entries of the rows deleted are gone), and finds its next rows first
    win.keyed = win.n > 0 && !q.levels[0].virt() && q.levels[0].path.index < 0 && !q.levels[0].path.desc
    let t = &q.levels[0].t
    var found: [][]Val = []
    var rs = newRun(&q)
    rs.limit(&lim)
    rs.writes = true                // optimizer 19: a write keeps its index paths (its read set)
    if win.keyed { rs.after = win.after.clone() }
    var m = try prepare(st, txn, &q, params, mut &rs)
    let room = rs.bud.room()
    let max = rs.bud.maxHeld
    var held = 0
    let wn = win.n
    let reads0 = txn.readCount()
    while true {
        try runQuery(st, txn, &q, &m, params, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
            held += 2 * lexdb_pipe.rowBytes(r)             // the row found, and its write
            if room >= 0 && held > room { return Err(lexdb_pipe.memErr(max)) }
            append(mut &found, collections.copyOf(r))
            return Ok(wn == 0 || len(found) < wn)         // a batch stops at its n rows
        }, mut &rs)
        found = onceEach(t, found, len(s.from) > 0)
        var nolk: []Look = []
        found = firstN(found, try evalInt(&s.limit, params, "TOP", mut &nolk))     // T-SQL's UPDATE TOP (n), DELETE TOP (n)
        if !(try lockFound(st, txn, t, &found, lexdb_sql.LOCK_UPDATE)) { break }
        found = []
        held = 0
        txn.forgetReads(reads0)
        rs = newRun(&q)
        rs.limit(&lim)
        if win.keyed { rs.after = win.after.clone() }
        m = try prepare(st, txn, &q, params, mut &rs)
    }
    if win.n > 0 { winEnd(win, t, &found, rs.cnt[0].read) }
    let fw = try fkTables(st, txn, t, false, true)
    var later: []FkLater = []
    let nt = len(t.cols)
    for joined in found {
        try retAdd(st, txn, &q, &m, params, mut &ret, &joined, mut &rs)
        if len(joined) == nt { try delRow(st, txn, t, &joined, &fw, mut &later) }
        else { try delRow(st, txn, t, &rowPrefix(&joined, nt), &fw, mut &later) }
    }
    try fkFinish(st, txn, &fw, mut &later)
    return Ok(retRes(ret, &("DELETE " + len(found).toStr())))
}

// ---- batched DELETE and UPDATE (design/lexdb-bulkdelete.md section 3, stage 8)
//
// DELETE ... WITH (batch_rows n) and UPDATE ... WITH (batch_rows n) commit
// each n rows as their own transaction (as COPY's batch_rows, 9.87), so a
// statement over millions of rows holds n rows' writes, not all of them. Not
// atomic: a failure keeps the batches committed before it, and says how
// many in its context.
// - Each batch (deleteB, updateB with a Win) runs the statement for at most
//   n rows, changes them, checks their foreign keys, and batchDml commits
//   and starts a new transaction (the same path, session, temporary schema,
//   time zone and now()).
// - Where the next batch starts: a DELETE or UPDATE read by the primary key
//   goes on from the key after the last row of the batch (Run.after, applied
//   to the first level's scans), so no row is read twice: not those that did
//   not match (the scan is linear over the statement, not over each batch),
//   nor an UPDATE's own (a row whose changed column the WHERE reads is not
//   found again: the Halloween problem). An UPDATE always reads by the key
//   (its path is made the key's, whatever the planner chose) and may not
//   assign a key column (0A000: the row would move past the cursor). A
//   DELETE read by an index runs again: the entries of the rows deleted are
//   gone, so the next run starts at the next match.
// - A DELETE that takes the range path (2.1) in its first batch ignores
//   batch_rows: it is one write whatever its rows, and atomic. A range
//   delete with indexes whose entries go one by one (stage 6) is not taken:
//   those are as many writes as rows, and batch_rows is for those.
// - A conflict at a batch's commit (40001) runs that batch again from the
//   same key, up to 10 times in all; the statement as a whole does not.
// - Refused: inside a transaction block (25001: it must commit), RETURNING
//   or OUTPUT (0A000: the rows would grow without bound), UPDATE of a key
//   column (0A000), and (not in the design) USING or FROM and TOP (0A000: a
//   joined row is not a key to resume from, and TOP is a limit of its own).
// - Not seen: rows committed behind the cursor by others during the run, and
//   a subquery in the WHERE reads the table as it is at each batch.

type Win = record {
    n: int              // rows a batch finds at most; 0 not batched
    first: bool         // the first batch
    after: str          // the key to start at (the last key done, then a zero byte); "" the start
    keyed: bool         // the batch is read by the primary key: the cursor applies
    done: bool          // the statement took the range path: it is whole, one write
    count: int          // the rows the batch changed
    full: bool          // it stopped at n rows: there may be more
    last: str           // the key of the batch's last row
}

fn noWin(): Win { return Win{n: 0, first: false, after: "", keyed: false, done: false, count: 0, full: false, last: ""} }

// The rows read, and the batches run, by batched statements since the process began (a test's check).
var BATCH_READ: int = 0
var BATCH_RUNS: int = 0
var BATCH_RETRIES: int = 0
var BATCH_HOOK: once []fn(lexdb_store.Store, int)

pub fn batchRead(): int { return BATCH_READ }
pub fn batchRuns(): int { return BATCH_RUNS }
pub fn batchRetries(): int { return BATCH_RETRIES }

// A test's, set once for the process: called with the number of batches run so far after a batch's rows are changed and before it commits.
pub fn setBatchHook(f: fn(lexdb_store.Store, int)) { if !BATCH_HOOK.isSet() { BATCH_HOOK.set([f]) } }

// A batch's end: the rows it found.
fn winEnd(win: mut &Win, t: &Table, found: &[][]Val, read: int) {
    BATCH_READ += read
    BATCH_RUNS += 1
    win.count = len(found)
    win.full = len(found) >= win.n
    if len(found) > 0 { win.last = keyOf(t, &found[len(found) - 1]) }
}

// A transaction like txn's for the next batch.
fn freshTxn(txn: &lexdb_store.Txn): lexdb_store.Txn {
    var fresh = lexdb_store.begin()
    for n in txn.sql.path { append(mut &fresh.sql.path, n.clone()) }
    fresh.sql.sess = txn.sql.sess
    fresh.tmp = txn.tmp.clone()
    fresh.now = txn.now
    fresh.sql.zone = txn.sql.zone.clone()
    fresh.sql.rules = txn.sql.rules
    fresh.sql.memMax = txn.sql.memMax
    return fresh
}

fn batchFail(x: DbErr, total: int, what: &str, n: int): DbErr {
    let c = what + " with batch_rows " + n.toStr() + ": " + total.toStr() + " rows committed before the error"
    return within(x, &(if len(x.context) > 0 { x.context + "; " + c } else { c }))
}

fn batchDml(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    let del = s.kind == lexdb_sql.S_DELETE
    let what = if del { "DELETE" } else { "UPDATE" }
    if txn.inBlock() { return Err(e("25001", &("lexdb: " + what + " with batch_rows cannot run inside a transaction block"))) }
    if len(s.items) > 0 { return Err(e("0A000", &("lexdb: " + what + " with batch_rows cannot return rows (RETURNING, OUTPUT)"))) }
    if len(s.from) > 0 { return Err(e("0A000", &("lexdb: " + what + " with batch_rows cannot join (" + (if del { "USING" } else { "FROM" }) + ")"))) }
    if s.limit.isSome() { return Err(e("0A000", &("lexdb: " + what + " with batch_rows cannot have TOP"))) }
    var win = noWin()
    win.n = s.copy.batchRows
    win.first = true
    var total = 0
    var tries = 0
    while true {
        let r = if del { deleteB(st, txn, s, params, lim, mut &win) } else { updateB(st, txn, s, params, lim, mut &win) }
        match move(r) {
            Ok(res) { if win.done { return Ok(res) } }
            Err(x) {
                // a conflict found as the batch ran (it read the live tree): the batch again, on a new transaction
                tries += 1
                if x.state != lexdb_base.S_CONFLICT || tries >= 10 { return Err(batchFail(x, total, &what, win.n)) }
                BATCH_RETRIES += 1
                let fresh = freshTxn(txn)
                let old = replace(txn, fresh)
                st.abort(old)
                continue
            }
        }
        if BATCH_HOOK.isSet() { BATCH_HOOK.get()[0](st.handle(), BATCH_RUNS) }
        win.first = false
        let fresh = freshTxn(txn)
        let done = replace(txn, fresh)
        match st.commit(done) {
            Ok(_) {
                total += win.count
                tries = 0
                if !win.full { break }
                if win.keyed { win.after = lexdb_access.after(&win.last) }
            }
            Err(x) {
                // a conflict: this batch again, from the same key
                tries += 1
                if x.state != lexdb_base.S_CONFLICT || tries >= 10 { return Err(batchFail(x, total, &what, win.n)) }
                BATCH_RETRIES += 1
            }
        }
    }
    return Ok(tagOnly(&(what + " " + total.toStr())))
}

// ---- range delete (design/lexdb-bulkdelete.md 2.1)
//
// A DELETE whose WHERE is exactly a range of the primary key's leading
// columns (equalities on the first k, at most a lower and an upper bound on
// the next, or no WHERE) drops the key range from the tree as one write
// (Txn.delRange) instead of deleting the rows one by one. The count is the
// store's (countRange: exact, from the leaf headers).
// - In a transaction block, or after writes (stage 5), the count is the
//   store's corrected for the transaction's own writes and range deletes of
//   the tree (countView), which falls back to the row path when it is not
//   exact; the transaction's own reads then see the range gone (Txn.cuts).
//   The rows are not locked, as the row path locks them in a block: a
//   session that locks or writes one of them later is not made to wait, and
//   one of the two fails with 40001 at its commit (the range is a read
//   noted by noteRange, the delete a write); a lock held by another
//   session already sends the statement to the row path, which waits.
// - The WHERE is read from the level's conjuncts, not from its Path: the
//   Path's bounds are supersets, the rows being checked again. Every
//   conjunct must be column op constant on a key column, in the leading
//   columns, one equality per column and at most one bound each way on the
//   next. Anything else (an OR, IN, a residual, a function of the column)
//   takes the row path unchanged.
// - A bound counts only if its value survives the column's type: the value
//   made the column's type compares equal to it (id < 10.5 on an int does
//   not: the planner's bounds are inclusive for that, here the range must
//   be the whole predicate).
// - Indexes: one that leads with the range's key columns is cut by range
//   (an index entry is marker, value, ..., key: the rows of the range are
//   one range of it); the others (stage 6) have their entries deleted one
//   by one from the rows read (delEntries), the table's subtrees still
//   being dropped, and the count is the rows read.
// - Not: RETURNING or OUTPUT, TOP and ROWNUM (a limit), USING, a table
//   others reference (their FK actions need the rows), a key of float, a
//   collation other than the exact one, rows locked by others in the range
//   (the row path waits for them), a point lookup (all key columns equal:
//   one row).

// The DELETEs that took the range path since the process began (a test's check).
var RDEL_TAKEN: int = 0

pub fn rangeDeletes(): int { return RDEL_TAKEN }

type RdBound = record { pos: int; op: str; x: Expr }

// [lo, hi) of a tree (hi "": to the end), or nothing.

type RPlan = record {
    empty: bool                 // no row can match (a NULL bound): DELETE 0
    main: Scan
    ixs: []int                  // the indexes (places in t.indexes) that take the same op, with their ranges
    ixr: []Scan
    slow: []int                 // the others: their entries are deleted one by one, from the rows read (stage 6)
    text: str                   // EXPLAIN's line
}

const RD_FNS: []str = ["now", "current_timestamp", "current_date", "current_time", "localtimestamp", "localtime", "transaction_timestamp",
                       "statement_timestamp", "date_trunc", "make_date", "make_timestamp", "make_timestamptz", "to_timestamp", "to_date",
                       "timezone", "#dateadd", "dateadd", "add_months", "trunc", "abs", "greatest", "least"]

// Whether x has the same value throughout the statement and reads no row:
// a literal, a parameter, a stable function of those, an uncorrelated
// scalar subquery.
fn rdConst(q: &Query, x: &Expr): bool {
    match x {
        Expr.Lit(_) { return true }
        Expr.Param(_) { return true }
        Expr.Col(_, _) { return false }
        Expr.Unary(op, a) { return op == "-" && rdConst(q, &a) }
        Expr.Bin(op, a, b) {
            if op != "+" && op != "-" && op != "*" && op != "/" && op != "%" && op != "||" && op != "t+" { return false }
            return rdConst(q, &a) && rdConst(q, &b)
        }
        Expr.Cast(a, _) { return rdConst(q, &a) }
        Expr.Call(n, args, star) {
            if star { return false }
            if n == "#sub" {
                let i = if len(args) > 0 { lexdb_sql.litInt(&args[0]) } else { -1 }
                if i < 0 || i >= len(q.subs) { return false }
                let sp = &q.subs[i]
                return sp.use == lexdb_sql.SUB_SCALAR && len(sp.sel.q.refs) == 0 && !sp.hashed && !sp.semi && sp.cte < 0
            }
            var known = false
            for f in RD_FNS { if f == n { known = true } }
            if !known { return false }
            for a in args { if !rdConst(q, &a) { return false } }
            return true
        }
        else { return false }
    }
}

// The primary key position of the column name (alias.column) names, -1 none.
fn rdPos(lv: &Level, name: &str): int {
    for i in 0..len(lv.t.pk) {
        if lv.alias + "." + lv.t.cols[lv.t.pk[i]].name == name { return i }
    }
    return -1
}

fn rdFlip(op: &str): str { return match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { "=" } } }

// The conjunct as a bound on a key column; None when it is anything else.
fn rdBound(q: &Query, lv: &Level, c: &Expr): Option[RdBound] {
    match c {
        Expr.Bin(op, a, b) {
            if op != "=" && op != "<" && op != "<=" && op != ">" && op != ">=" { return None }
            match a {
                Expr.Col(n, _) {
                    let p = rdPos(lv, &n)
                    if p >= 0 && rdConst(q, &b) { return Some(RdBound{pos: p, op: op.clone(), x: lexdb_sql.cloneExpr(&b)}) }
                }
                else {}
            }
            match b {
                Expr.Col(n, _) {
                    let p = rdPos(lv, &n)
                    if p >= 0 && rdConst(q, &a) { return Some(RdBound{pos: p, op: rdFlip(&op), x: lexdb_sql.cloneExpr(&a)}) }
                }
                else {}
            }
            return None
        }
        else { return None }
    }
}

// Whether a key column's values order as their keys do, and a bound on it
// is one value: the integers, numeric, the date and time kinds, uuid and
// text under the exact collation (not float: NaN and -0; not a case-
// insensitive or padded text; not char(n)).
fn rdExactCol(c: &lexdb_sql.ColDef): bool {
    let k = c.typ.kind
    if k == lexdb_sql.K_TEXT { return lexdb_access.colCollKind(c) == lexdb_sql.COLL_EXACT && c.typ.oid != lexdb_sql.OID_BPCHAR }
    return k == lexdb_sql.K_INT || k == lexdb_sql.K_NUM || k == lexdb_sql.K_DATE || k == lexdb_sql.K_TIME || k == lexdb_sql.K_TS ||
           k == lexdb_sql.K_TSTZ || k == lexdb_sql.K_UUID
}

fn rdNone(): RPlan { return RPlan{empty: false, main: lexdb_access.allScan(), ixs: [], ixr: [], slow: [], text: ""} }

// The range delete s makes of q's one table, or None for the row path.
fn rangePlan(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, q: &Query, params: &[]Val,
             lim: &Limits, shown: bool): Result[Option[RPlan], DbErr] {
    // (EXPLAIN runs on a snapshot, whose reads are not noted: it shows what a DELETE would do)
    // (inside a block, or after writes, the count is corrected for the transaction's own writes and range deletes: countView)
    if !lim.rdel || txn.quiet || !(shown || txn.noting()) { return Ok(None) }
    if len(s.items) > 0 || s.limit.isSome() || len(s.from) > 0 || len(q.levels) != 1 || len(q.top) > 0 { return Ok(None) }
    let lv = &q.levels[0]
    if lv.virt() || lv.lateral { return Ok(None) }
    let t = &lv.t
    if len(t.view) > 0 || len(t.refBy) > 0 || len(t.pk) == 0 { return Ok(None) }
    for sp in q.subs {
        if !(sp.use == lexdb_sql.SUB_SCALAR && len(sp.sel.q.refs) == 0 && !sp.hashed && !sp.semi && sp.cte < 0) { return Ok(None) }
    }
    // the conjuncts: one equality per column, in the leading columns, then a bound each way on the next
    let np = len(t.pk)
    var eqAt: []int = array(np, -1)
    var loAt: []int = array(np, -1)
    var hiAt: []int = array(np, -1)
    var bs: []RdBound = []
    for c in lv.cond {
        match rdBound(q, lv, &c) {
            Some(b) {
                let at = len(bs)
                if b.op == "=" {
                    if eqAt[b.pos] >= 0 { return Ok(None) }
                    eqAt[b.pos] = at
                } else if b.op == ">" || b.op == ">=" {
                    if loAt[b.pos] >= 0 { return Ok(None) }
                    loAt[b.pos] = at
                } else {
                    if hiAt[b.pos] >= 0 { return Ok(None) }
                    hiAt[b.pos] = at
                }
                append(mut &bs, b)
            }
            None { return Ok(None) }
        }
    }
    var k = 0
    while k < np && eqAt[k] >= 0 { k += 1 }
    for j in k + 1..np { if eqAt[j] >= 0 { return Ok(None) } }          // an equality after a gap
    // bounds only on column k
    for j in 0..np {
        if j != k && (loAt[j] >= 0 || hiAt[j] >= 0) { return Ok(None) }
    }
    if k == np { return Ok(None) }                  // the whole key: one row, a lookup
    let ranged = loAt[k] >= 0 || hiAt[k] >= 0
    let used = k + (if ranged { 1 } else { 0 })
    for j in 0..used { if !rdExactCol(&t.cols[t.pk[j]]) { return Ok(None) } }
    // the indexes: one that leads with the key columns the range uses is cut by range too; any other
    // (another column, an expression, too short) has its entries deleted one by one (delEntries)
    var ixs: []int = []
    var slow: []int = []
    for x in 0..len(t.indexes) {
        let ix = &t.indexes[x]
        var lead = len(ix.cols) >= used
        if lead { for j in 0..used { if ix.cols[j] != t.pk[j] { lead = false } } }
        if lead { append(mut &ixs, x) } else { append(mut &slow, x) }
    }
    // the values, once
    var rs = newRun(q)
    rs.limit(lim)
    rs.writes = true
    let m = try prepare(st, txn, q, params, mut &rs)
    let noAggs: []Val = []
    let noRow: []Val = []
    let sqe1 = seqEnv(st, txn)
    let env = Env{cols: &q.cols, row: &noRow, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe1}
    var vals: []Val = array(len(bs), Val.Null)
    for i in 0..len(bs) {
        let col = &t.cols[t.pk[bs[i].pos]]
        var v = Val.Null
        match eval(&bs[i].x, &env) {
            Ok(x) { v = x }
            Err(_) { return Ok(None) }                  // the row path gives its error
        }
        if lexdb_ops.isNull(&v) {
            // col op NULL is never true: no row
            var p = rdNone()
            p.empty = true
            p.text = "range delete: no row can match"
            return Ok(Some(p))
        }
        let typ = boundType(&col.typ)
        match lexdb_ops.coerceZ(v.clone(), &typ, &txn.sql.zone) {
            Ok(c) {
                match lexdb_ops.compareZ(&v, &c, &txn.sql.zone) {
                    Ok(r) { if r != 0 { return Ok(None) } }
                    Err(_) { return Ok(None) }
                }
                vals[i] = c
            }
            Err(_) { return Ok(None) }
        }
    }
    var eqs: []Val = []
    for j in 0..k { append(mut &eqs, vals[eqAt[j]].clone()) }
    var lower: Option[Val] = None
    var upper: Option[Val] = None
    var lowIncl = true
    var upIncl = true
    if loAt[k] >= 0 {
        lower = Some(vals[loAt[k]].clone())
        lowIncl = bs[loAt[k]].op == ">="
    }
    if hiAt[k] >= 0 {
        upper = Some(vals[hiAt[k]].clone())
        upIncl = bs[hiAt[k]].op == "<="
    }
    var p = rdNone()
    p.main = lexdb_access.exactRange(&eqs, &lower, lowIncl, &upper, upIncl, false)
    if p.main.empty {
        p.empty = true
        p.text = "range delete: no row can match"
        return Ok(Some(p))
    }
    if lexdb_access.rangeLocked(st, txn, &lexdb_catalog.relOf(t), &p.main) { return Ok(None) }
    for x in ixs {
        append(mut &p.ixs, x)
        append(mut &p.ixr, lexdb_access.exactRange(&eqs, &lower, lowIncl, &upper, upIncl, true))
    }
    p.slow = slow
    p.text = "range delete: primary key " + (if used == 0 { "whole table" } else { "range" }) + ", subtrees dropped" +
             (if len(t.indexes) > 0 { " (" + len(ixs).toStr() + " of " + len(t.indexes).toStr() + " indexes cut by range, " +
                                      len(p.slow).toStr() + " entry by entry)" } else { "" })
    return Ok(Some(p))
}

// The columns of t indexes slow (places in t.indexes) use: their columns,
// expressions and predicates'.
fn slowNeed(t: &Table, slow: &[]int): []bool {
    var names: []str = []
    for x in slow {
        let ix = &t.indexes[x]
        for c in ix.cols { if c >= 0 { append(mut &names, t.cols[c].name.clone()) } }
        for e in ix.exprs { lexdb_sql.colNames(&e, mut &names) }
        match ix.pred { Some(e) { lexdb_sql.colNames(&e, mut &names) } None {} }
    }
    var used: Map[str, int] = newMap()
    for x in names { used.put(lexdb_bind.colPart(&x), 1) }
    var need: []bool = []
    for c in t.cols { append(mut &need, used.has(&c.name)) }
    return need
}

// DELETE as a range delete when it can be one: its result, or None for the
// row path (also when the count gave up after its restarts).
fn rangeDelete(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, q: &Query, params: &[]Val,
               lim: &Limits, noSlow: bool): Result[Option[Res], DbErr] {
    let pl = match try rangePlan(st, txn, s, q, params, lim, false) { Some(p) { p } None { return Ok(None) } }
    if noSlow && len(pl.slow) > 0 { return Ok(None) }
    if pl.empty {
        RDEL_TAKEN += 1
        return Ok(Some(tagOnly(&"DELETE 0")))
    }
    let t = &q.levels[0].t
    // noted before the count: a commit into the range meanwhile fails this one (40001), not unseen; the
    // indexes not cut by range have their entries deleted one by one, reading the columns they use
    let need = slowNeed(t, &pl.slow)
    let n = try lexdb_access.deleteRange(st, txn, &lexdb_catalog.relOf(t), &pl.main, &pl.ixs, &pl.ixr, &pl.slow, &need,
                                         fn(xi: &Index, r: &[]Val): Result[bool, DbErr] { return inIndex(t, xi, r) },
                                         fn(xi: &Index, k: int, r: &[]Val): Result[Val, DbErr] { return idxVal(t, xi, k, r) })
    if n < 0 { return Ok(None) }
    RDEL_TAKEN += 1
    if n == 0 { return Ok(Some(tagOnly(&"DELETE 0"))) }
    lexdb_stats.noteChgN(st, txn.sql.sess, t, n)
    return Ok(Some(tagOnly(&("DELETE " + n.toStr()))))
}

// ---- MERGE (design/lexdb.md 9.121): the same statement in all three dialects

// MERGE's FROM items: the source (as the statement gave it), then the target
// joined to it on ON, as the clauses need rows: a source row with no target
// row (WHEN NOT MATCHED) keeps the source's, a target row with no source row
// (BY SOURCE) the target's; the source first, so its rows come out in its own
// order. A row is the source's columns, then the target's.
fn mergeFrom(s: &lexdb_sql.Stmt): []lexdb_sql.FromItem {
    var needSrc = false
    var needTgt = false
    for c in s.merges {
        if c.when == lexdb_sql.MC_NOT_MATCHED { needSrc = true }
        if c.when == lexdb_sql.MC_BY_SOURCE { needTgt = true }
    }
    let f = &s.from[0]
    var cols: []str = []
    for c in f.cols { append(mut &cols, c.clone()) }
    var us: []str = []
    for u in f.using { append(mut &us, u.clone()) }
    var out: []lexdb_sql.FromItem = [lexdb_sql.FromItem{table: f.table.clone(), alias: f.alias.clone(), join: lexdb_sql.J_FIRST, on: None, sub: f.sub, cols: cols,
                                                         work: f.work, lateral: f.lateral, using: us, natural: false, comma: false}]
    let join = if needSrc && needTgt { lexdb_sql.J_FULL } else if needSrc { lexdb_sql.J_LEFT } else if needTgt { lexdb_sql.J_RIGHT } else { lexdb_sql.J_INNER }
    var on: Option[Expr] = None
    match s.where {
        Some(w) { on = Some(lexdb_sql.cloneExpr(&w)) }
        None {}
    }
    append(mut &out, lexdb_sql.FromItem{table: s.table.clone(), alias: if len(s.alias) > 0 { s.alias.clone() } else { lexdb_sql.baseName(&s.table) }, join: join,
                                        on: on, sub: -1, cols: [], work: -1, lateral: false, using: [], natural: false, comma: false})
    return out
}

// The privileges MERGE needs: each action's, and SELECT (ON reads the table).
fn mergeCheck(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Unit, DbErr] {
    let w = try whoNow(st, txn)
    if w.super { return Ok(Unit{}) }
    let key = try catKey(st, txn, &s.table, false)
    if !(try relExists(st, txn, &key)) { return Ok(Unit{}) }
    var ins = false
    var upd = false
    var del = false
    for c in s.merges {
        if c.act == lexdb_sql.MA_INSERT { ins = true }
        if c.act == lexdb_sql.MA_UPDATE { upd = true }
        if c.act == lexdb_sql.MA_DELETE { del = true }
    }
    if ins { try needRel(st, txn, &w, &key, &"a", &"table") }
    if upd { try needRel(st, txn, &w, &key, &"w", &"table") }
    if del { try needRel(st, txn, &w, &key, &"d", &"table") }
    try needRel(st, txn, &w, &key, &"r", &"table")
    return Ok(Unit{})
}

// A WHEN clause resolved over the joined row.
type MClause = record {
    when: int
    cond: Option[Expr]
    act: int
    targets: []int              // UPDATE: SET's columns; INSERT: the columns inserted
    exprs: []Expr               // ... their values
    defaults: bool
    delWhere: Option[Expr]
}

// MERGE's RETURNING or OUTPUT items: as written, but DELETED.* (the
// qualifier "\x01deleted") the old row's columns.
fn mergeItems(s: &lexdb_sql.Stmt, t: &Table, alias: &str): []lexdb_sql.SelItem {
    var out: []lexdb_sql.SelItem = []
    for it in s.items {
        if it.star && it.qual == "\x01deleted" {
            for c in t.cols {
                if c.name == lexdb_catalog.ROWID { continue }
                out = append1(out, lexdb_sql.SelItem{star: false, qual: "", expr: Some(Expr.Call("#old", [Expr.Col(alias + "." + c.name, -1)], false)), alias: c.name.clone(), spell: c.spell.clone()})
            }
        } else {
            out = append1(out, lexdb_sql.SelItem{star: it.star, qual: it.qual.clone(), expr: match &it.expr { Some(x) { Some(lexdb_sql.cloneExpr(x)) } None { None } }, alias: it.alias.clone(), spell: it.spell.clone()})
        }
    }
    return out
}

fn append1(xs: []lexdb_sql.SelItem, x: lexdb_sql.SelItem): []lexdb_sql.SelItem {
    var out = xs
    append(mut &out, x)
    return out
}

// An expression with each merge_action() ($action) its action's name.
fn actionRefs(x: &Expr, action: &str): Expr {
    match x {
        Expr.Call(f, args, star) {
            if f == "#maction" { return Expr.Lit(Val.Text(action.toStr())) }
            var out: []Expr = []
            for a in args { append(mut &out, actionRefs(&a, action)) }
            return Expr.Call(f.clone(), out, star)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), actionRefs(&a, action)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), actionRefs(&a, action), actionRefs(&b, action)) }
        Expr.Cast(a, t) { return Expr.Cast(actionRefs(&a, action), t) }
        Expr.IsNull(a, n) { return Expr.IsNull(actionRefs(&a, action), n) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// One row of RETURNING: row the joined row as it is after the action (a
// deleted row's target part: its old values, or NULLs in T-SQL), old the
// joined row as it was before.
fn mergeRetAdd(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val, r: mut &Ret,
               row: &[]Val, old: &[]Val, action: &str, rs: mut &Run): Result[Unit, DbErr] {
    let noAggs: []Val = []
    let sqe1 = seqEnv(st, txn)
    let env = Env{cols: &q.cols, row: row, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe1}
    var out: []Val = []
    for x0 in r.exprs {
        let x = oldRefs(&actionRefs(&x0, action), &q.cols, old)
        append(mut &out, try evalX(st, txn, q, &x, &env, rs))
    }
    append(mut &r.rows, out)
    return Ok(Unit{})
}

// x with each bare name of a column of t the target's (alias.name).
fn oraTarget(x: &Expr, t: &Table, alias: &str): Expr {
    match x {
        Expr.Col(n, _) {
            if !strings.contains(&n, ".") && colIndex(&t.cols, &n) >= 0 { return Expr.Col(alias + "." + n, -1) }
            return Expr.Col(n.toStr(), -1)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), oraTarget(&a, t, alias)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), oraTarget(&a, t, alias), oraTarget(&b, t, alias)) }
        Expr.Cast(a, ty) { return Expr.Cast(oraTarget(&a, t, alias), ty) }
        Expr.IsNull(a, n) { return Expr.IsNull(oraTarget(&a, t, alias), n) }
        Expr.Call(f, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, oraTarget(&a, t, alias)) }
            return Expr.Call(f.clone(), out, star)
        }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

fn mergeErr(dialect: int): DbErr {
    if dialect == lexdb_sql.MD_TSQL {
        return e("TS8672", "The MERGE statement attempted to UPDATE or DELETE the same row more than once. This happens when a target row matches more than one source row. A MERGE statement cannot UPDATE/DELETE the same row of the target table multiple times. Refine the ON clause to ensure a target row matches at most one source row, or use the GROUP BY clause to group the source rows.")
    }
    if dialect == lexdb_sql.MD_ORA { return e("ORA30926", "The operation attempted to update the same row twice.") }
    return lexdb_base.errDetail("21000", "MERGE command cannot affect row a second time", "",
                                "Ensure that not more than one source row matches any one target row.")
}

// A MERGE whose source is a few rows the run holds (under HELD_BATCH) joins
// them row by row, as a SELECT's join does (runPipe): the batched join's
// set-up costs more than they save. The hash tables prepare left out for
// the levels program are then built.
fn fewSource(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, m: mut &Mats, params: &[]Val, rs: mut &Run): Result[Unit, DbErr] {
    if q.jp.isNone() || !q.levels[0].virt() { return Ok(Unit{}) }
    let sr = &m.subs[q.levels[0].src]
    if !lexdb_pipe.heldSmall(len(m.vrows[0]), sr.series, &sr.vals, sr.sOid, sr.sOrdin) { return Ok(Unit{}) }
    q.jp = None
    return materialize(st, txn, q, m, params, rs)
}

fn merge(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    try notView(st, txn, &s.table, &"merge into")
    try mergeCheck(st, txn, s)
    let sqe = seqEnv(st, txn)
    var sc = newScopeIn(st, txn, params, &[])
    sc.target = try catKey(st, txn, &s.table, false)
    let none: Option[Expr] = None
    var q = try buildQuery(st, txn, &mergeFrom(s), &none, params, &s.subs, &newMap(), true, mut &sc, false)
    let tl = len(q.levels) - 1
    let t = try needTable(st, txn, &s.table)
    let nt = len(t.cols)
    let ns = q.levels[tl].first
    let alias = if len(s.alias) > 0 { s.alias.clone() } else { lexdb_sql.baseName(&t.name) }
    // T-SQL's SET IDENTITY_INSERT t ON
    let ovr = if s.overriding == lexdb_sql.OVR_NONE && identityInsertOf(st, txn.sql.sess) == lexdb_sql.baseName(&t.name) { lexdb_sql.OVR_TSQL } else { s.overriding }
    var cl: []MClause = []
    var bySource = false
    // the target's columns ON names (Oracle: they cannot be updated)
    var onCols: Map[str, int] = newMap()
    match s.where {
        Some(w) {
            var ns2: []str = []
            lexdb_sql.colNames(&w, mut &ns2)
            for n in ns2 {
                match lexdb_bind.resolveName(&q.cols, len(q.cols), &n) { Ok(r) { onCols.put(q.cols[r].name.toStr(), 1) } Err(_) {} }
            }
        }
        None {}
    }
    for c in s.merges {
        var m = MClause{when: c.when, cond: None, act: c.act, targets: [], exprs: [], defaults: c.defaults, delWhere: None}
        if c.when == lexdb_sql.MC_BY_SOURCE { bySource = true }
        // Oracle: in an UPDATE clause a name both tables have is the target's
        let ou = s.mdialect == lexdb_sql.MD_ORA && c.act == lexdb_sql.MA_UPDATE
        match c.cond { Some(x) { m.cond = Some(try lexdb_bind.resolve(&(if ou { oraTarget(&x, &t, &alias) } else { lexdb_sql.cloneExpr(&x) }), &q.cols, len(q.cols), mut &sc.names)) } None {} }
        match c.delWhere { Some(x) { m.delWhere = Some(try lexdb_bind.resolve(&(if ou { oraTarget(&x, &t, &alias) } else { lexdb_sql.cloneExpr(&x) }), &q.cols, len(q.cols), mut &sc.names)) } None {} }
        if c.act == lexdb_sql.MA_UPDATE {
            for set in c.sets {
                let i = colIndex(&t.cols, &set.col)
                if i < 0 {
                    return Err(e("42703", &("column \"" + set.col + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist")))
                }
                if s.mdialect == lexdb_sql.MD_ORA && onCols.has(&(alias + "." + t.cols[i].name)) {
                    return Err(e("ORA38104", &("Columns referenced in the ON Clause cannot be updated: \"" + strings.toUpperAscii(&alias) + "\".\"" + strings.toUpperAscii(&t.cols[i].name) + "\"")))
                }
                append(mut &m.targets, i)
                append(mut &m.exprs, lexdb_bind.bpAssign(try lexdb_bind.resolve(&(if ou { oraTarget(&set.expr, &t, &alias) } else { lexdb_sql.cloneExpr(&set.expr) }), &q.cols, len(q.cols), mut &sc.names), &t.cols[i].typ, &q.cols, &typing()))
            }
        }
        if c.act == lexdb_sql.MA_INSERT {
            if len(c.names) == 0 {
                for i in 0..nt { if t.cols[i].name != lexdb_catalog.ROWID { append(mut &m.targets, i) } }
            } else {
                for n in c.names {
                    let i = colIndex(&t.cols, &n)
                    if i < 0 { return Err(e("42703", &("column \"" + n + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist"))) }
                    append(mut &m.targets, i)
                }
            }
            if s.mdialect == lexdb_sql.MD_TSQL && !c.defaults && len(c.vals) != len(m.targets) {
                if len(c.names) == 0 { return Err(e("TS213", "Column name or number of supplied values does not match table definition.")) }
                if len(c.vals) > len(m.targets) {
                    return Err(e("TS110", "There are fewer columns in the INSERT statement than values specified in the VALUES clause. The number of values in the VALUES clause must match the number of columns specified in the INSERT statement."))
                }
                return Err(e("TS109", "There are more columns in the INSERT statement than values specified in the VALUES clause. The number of values in the VALUES clause must match the number of columns specified in the INSERT statement."))
            }
            if len(c.vals) > len(m.targets) { return Err(e("42601", "INSERT has more expressions than target columns")) }
            if s.mdialect == lexdb_sql.MD_ORA && len(c.vals) < len(m.targets) && !c.defaults { return Err(e("ORA00947", "not enough values")) }
            if len(c.names) > 0 && len(c.vals) < len(m.targets) && !c.defaults {
                return Err(e("42601", "INSERT has more target columns than expressions"))
            }
            if s.mdialect == lexdb_sql.MD_ORA {
                // the target's columns are not there to read (ORA-38101)
                var used: []str = []
                for x in c.vals { lexdb_sql.colNames(&x, mut &used) }
                for n in move(used) {
                    var col = ""
                    if !strings.contains(&n, ".") { if colIndex(&t.cols, &n) >= 0 { col = n } }
                    else if n[0..strings.indexOf(&n, ".", 0)] == alias { col = n[strings.indexOf(&n, ".", 0) + 1..len(n)].toStr() }
                    if len(col) > 0 {
                        return Err(e("ORA38101", &("Invalid column in the INSERT VALUES Clause: \"" + strings.toUpperAscii(&alias) + "\".\"" + strings.toUpperAscii(&col) + "\"")))
                    }
                }
            }
            for x in c.vals { append(mut &m.exprs, lexdb_bind.bpAssign(try lexdb_bind.resolve(&x, &q.cols, len(q.cols), mut &sc.names), &t.cols[m.targets[len(m.exprs)]].typ, &q.cols, &typing())) }
        }
        append(mut &cl, m)
    }
    var ret = Ret{on: len(s.items) > 0, outs: [], exprs: [], rows: []}
    if ret.on {
        let items = mergeItems(s, &t, &alias)
        ret.outs = try lexdb_bind.itemCols(&items, true, &q.cols, mut &sc.names, mut &ret.exprs)
        for x in ret.exprs { if hasAgg(&x) { return Err(e("42803", "aggregate functions are not allowed in RETURNING")) } }
    }
    // the logical plan (read by nothing yet): the source joined to the target its source
    let lp = lexdb_bind.LPlan.Merge(replace(mut &q.lp, lexdb_bind.noPlan()), retBCols(&ret))
    endScope(mut &sc, mut &q)
    // its source join in batches (Query.jp; a BY SOURCE's RIGHT or FULL join too)
    levelsProgQ(mut &q, true)
    var found: [][]Val = []
    var rs = newRun(&q)
    rs.limit(&lim)
    rs.writes = true                // optimizer 19: a write keeps its index paths (its read set)
    var m = try prepare(st, txn, &q, params, mut &rs)
    try fewSource(st, txn, mut &q, mut &m, params, mut &rs)
    let room = rs.bud.room()
    let max = rs.bud.maxHeld
    var held = 0
    var lmode = lexdb_sql.LOCK_NO_KEY_UPDATE
    for c in cl { for k in c.targets { for p in t.pk { if p == k && c.act == lexdb_sql.MA_UPDATE { lmode = lexdb_sql.LOCK_UPDATE } } } }
    let reads0 = txn.readCount()
    while true {
        try runQuery(st, txn, &q, &m, params, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
            held += 2 * lexdb_pipe.rowBytes(r)             // the row found, and its write
            if room >= 0 && held > room { return Err(lexdb_pipe.memErr(max)) }
            append(mut &found, collections.copyOf(r))
            return Ok(true)
        }, mut &rs)
        var nolk: []Look = []
        found = firstN(found, try evalInt(&s.limit, params, "TOP", mut &nolk))     // T-SQL's MERGE TOP (n)
        // the target rows read are locked (as UPDATE's); one waited for: the rows found again
        var held2: [][]Val = []
        for r in found { if tgtPresent(&t, &r, ns) { append(mut &held2, rowSlice(&r, ns, nt)) } }
        if !(try lockFound(st, txn, &t, &held2, lmode)) { break }
        found = []
        held = 0
        txn.forgetReads(reads0)
        rs = newRun(&q)
        rs.limit(&lim)
        m = try prepare(st, txn, &q, params, mut &rs)
    }
    let noAggs: []Val = []
    let defs = try defaultsOf(st, txn, &t)
    for c in cl {
        if c.act != lexdb_sql.MA_UPDATE { continue }
        for k in 0..len(c.targets) {
            if t.cols[c.targets[k]].identity == lexdb_sql.ID_ALWAYS && !lexdb_sql.isDefault(&c.exprs[k]) {
                if s.mdialect == lexdb_sql.MD_TSQL { return Err(e("TS8102", &("Cannot update identity column '" + t.cols[c.targets[k]].name + "'."))) }
                if s.mdialect == lexdb_sql.MD_ORA { return Err(e("ORA32796", "cannot update a generated always identity column")) }
                return Err(lexdb_base.errDetail("428C9", &("column \"" + t.cols[c.targets[k]].name + "\" can only be updated to DEFAULT"),
                                                &("Column \"" + t.cols[c.targets[k]].name + "\" is an identity column defined as GENERATED ALWAYS."), ""))
            }
        }
    }
    let fw = try fkTables(st, txn, &t, true, true)
    var later: []FkLater = []
    var up = noUpsert()
    up.idBump = ovr == lexdb_sql.OVR_TSQL
    var touched: Map[str, int] = newMap()
    var count = 0
    let tsql = s.mdialect == lexdb_sql.MD_TSQL
    for joined in found {
        var kind = lexdb_sql.MC_NOT_MATCHED
        if tgtPresent(&t, &joined, ns) {
            kind = lexdb_sql.MC_MATCHED
            if bySource && allNull(&joined, 0, ns) { kind = lexdb_sql.MC_BY_SOURCE }
        }
        let env = Env{cols: &q.cols, row: &joined, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
        var fired = -1
        for ci in 0..len(cl) {
            if cl[ci].when != kind { continue }
            match cl[ci].cond {
                Some(c) { if lexdb_ops.truth(&(try evalX(st, txn, &q, &c, &env, mut &rs))) != Some(true) { continue } }
                None {}
            }
            fired = ci
            break
        }
        if fired < 0 { continue }
        let c = &cl[fired]
        if c.act == lexdb_sql.MA_NOTHING { continue }
        if c.act == lexdb_sql.MA_INSERT {
            var vs: []Val = []
            for k in 0..len(c.exprs) {
                if lexdb_sql.isDefault(&c.exprs[k]) || (try idDefault(&t, c.targets[k], false, ovr)) {
                    append(mut &vs, try defAt(st, txn, &defs, &t, c.targets[k]))
                } else {
                    append(mut &vs, try evalX(st, txn, &q, &c.exprs[k], &env, mut &rs))
                }
            }
            // (no column list: the values given are the first columns', the rest their defaults)
            match try insertOne(st, txn, &t, &c.targets, &vs, &defs, &fw, mut &later, mut &up, &env) {
                Some(row) {
                    count += 1
                    if ret.on {
                        var after = collections.copyOf(&joined)
                        for i in 0..nt { after[ns + i] = row[i].clone() }
                        let before = nullRowPart(&joined, ns, nt)
                        try mergeRetAdd(st, txn, &q, &m, params, mut &ret, &after, &before, "INSERT", mut &rs)
                    }
                }
                None {}
            }
            continue
        }
        // UPDATE and DELETE: the row of the target, once
        let old = rowSlice(&joined, ns, nt)
        let key = keyOf(&t, &old)
        // (SQL Server lets several source rows delete a row, once)
        if tsql && c.act == lexdb_sql.MA_DELETE && touched.getOr(&key, 0) == 2 { continue }
        if touched.has(&key) { return Err(mergeErr(s.mdialect)) }
        if c.act == lexdb_sql.MA_DELETE {
            touched.put(key, 2)
            try delRow(st, txn, &t, &old, &fw, mut &later)
            count += 1
            if ret.on {
                var after = collections.copyOf(&joined)
                if tsql { for i in 0..nt { after[ns + i] = Val.Null } }
                try mergeRetAdd(st, txn, &q, &m, params, mut &ret, &after, &joined, "DELETE", mut &rs)
            }
            continue
        }
        var all = collections.copyOf(&joined)
        for k in 0..len(c.targets) {
            let ti = c.targets[k]
            if lexdb_sql.isDefault(&c.exprs[k]) { all[ns + ti] = try defAt(st, txn, &defs, &t, ti) }
            else { all[ns + ti] = try lexdb_ops.coerceZ(try evalX(st, txn, &q, &c.exprs[k], &env, mut &rs), &t.cols[ti].typ, &txn.sql.zone) }
        }
        touched.put(key, 1)
        let nw = rowSlice(&all, ns, nt)
        // Oracle's DELETE WHERE: the row as updated, if it holds, is deleted
        var gone = false
        match c.delWhere {
            Some(w) {
                let denv = Env{cols: &q.cols, row: &all, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
                if lexdb_ops.truth(&(try evalX(st, txn, &q, &w, &denv, mut &rs))) == Some(true) { gone = true }
            }
            None {}
        }
        if gone {
            try updRow(st, txn, &t, &old, &nw, &fw, mut &later)
            try delRow(st, txn, &t, &nw, &fw, mut &later)
            count += 1
            continue
        }
        match updRow(st, txn, &t, &old, &nw, &fw, mut &later) {
            Ok(_) {}
            Err(x) {
                // (a NULL where one cannot be: Oracle's ORA-01407 for an update, not ORA-01400's)
                if x.state == "23502" { var y = x; y.context = "update"; return Err(y) }
                return Err(x)
            }
        }
        count += 1
        if ret.on { try mergeRetAdd(st, txn, &q, &m, params, mut &ret, &all, &joined, "UPDATE", mut &rs) }
    }
    try fkFinish(st, txn, &fw, mut &later)
    // IDENTITY_INSERT: an identity given a value past its own goes on from there
    for j in 0..len(up.idCols) {
        let d = try needSeq(st, txn, &t.cols[up.idCols[j]].seq)
        let v = up.idMax[j]
        let next = try seqPeek(st, txn, &d)
        if (d.inc > 0 && v >= next) || (d.inc < 0 && v <= next) { try setVal(st, &d, v, true) }
    }
    return Ok(retRes(ret, &("MERGE " + count.toStr())))
}

// Whether the joined row has a target row (its key is not NULL).
fn tgtPresent(t: &Table, row: &[]Val, ns: int): bool {
    if len(t.pk) == 0 { return false }
    return !lexdb_ops.isNull(&row[ns + t.pk[0]])
}

fn allNull(row: &[]Val, from: int, n: int): bool {
    for i in from..from + n { if !lexdb_ops.isNull(&row[i]) { return false } }
    return true
}

// The n values of row from its place at.
fn rowSlice(row: &[]Val, at: int, n: int): []Val {
    var out: []Val = []
    for i in at..at + n { append(mut &out, row[i].clone()) }
    return out
}

// The joined row with its target part NULL: the row before an insert.
fn nullRowPart(row: &[]Val, at: int, n: int): []Val {
    var out = collections.copyOf(row)
    for i in at..at + n { out[i] = Val.Null }
    return out
}

fn explain(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, x: &lexdb_sql.Stmt, params: &[]Val, lim: Limits,
           ptypes: &[]int): Result[Res, DbErr] {
    let s = &x.inner[0]
    var res = Res{cols: [OutCol{name: "QUERY PLAN", oid: lexdb_sql.OID_TEXT, spell: "", coll: "", scale: -1}], rows: [], tag: "EXPLAIN", hasRows: true, copy: COPY_NONE}
    var lines: []str = []
    let none: []lexdb_pipe.Counts = []
    if x.ifFlag {
        // ANALYZE: run it, counting what each table does
        let t0 = time.monotonicNs()
        let r = try selectWith(st, txn, s, params, ptypes, lim, true, mut &lines)
        let us = (time.monotonicNs() - t0) / 1000
        append(mut &lines, "result: " + len(r.rows).toStr() + " rows in " + (us / 1000).toStr() + "." +
               strings.padLeft(&((us % 1000).toStr()), 3, '0') + " ms")
    } else if s.kind == lexdb_sql.S_SELECT {
        var sc = newScopeIn(st, txn, params, ptypes)
        var sel = try planSelect(st, txn, s, params, mut &sc)
        bindSel(mut &sel)
        pipeSel(mut &sel)
        let noStats: []SubStat = []
        lines = selLines(&sel, &none, &noStats)
    } else {
        var sc = newScopeIn(st, txn, params, ptypes)
        let noOn: Option[Expr] = None
        var q = if s.kind == lexdb_sql.S_MERGE { try buildQuery(st, txn, &mergeFrom(s), &noOn, params, &s.subs, &newMap(), true, mut &sc, false) }
                else { try buildQuery(st, txn, &(try dmlFrom(s)), &s.where, params, &s.subs, &newMap(), true, mut &sc, false) }
        endScope(mut &sc, mut &q)
        lines = explainLines(&q, &none)
        let noStats: []SubStat = []
        subLines(&q, &subsOf(&q), &noStats, mut &lines)
        if s.kind == lexdb_sql.S_DELETE {
            // (what delete would take, its bounds evaluated now)
            match try rangePlan(st, txn, s, &q, params, &lim, true) {
                Some(p) { append(mut &lines, p.text.clone()) }
                None {}
            }
        }
    }
    for l in move(lines) { append(mut &res.rows, [Val.Text(l)]) }
    return Ok(res)
}

// ---- SELECT

// The type OID of an expression, as far as it can be told before running
// (lexdb_bind's, with the dialects' functions).
pub fn exprOid(x: &Expr, cols: &[]lexdb_sql.ColDef, ptypes: &[]int): int { return lexdb_bind.exprOid(x, cols, ptypes, &typing()) }

// What the dialects supply the binder (lexdb_bind.Typing).
fn typing(): lexdb_bind.Typing { return lexdb_bind.Typing{rules: lexdb_dialect.RULES_PG, fnOid: lexdb_orafn.resultOid, fnBind: fnRefOf} }

type OutRow = record { vals: []Val; ord: []Val }

fn firstN(rows: [][]Val, n: int): [][]Val {
    if n < 0 || len(rows) <= n { return rows }
    var all = rows
    var out: [][]Val = []
    for i in 0..n { append(mut &out, replace(mut &all[i], [])) }
    return out
}

fn evalInt(x: &Option[Expr], params: &[]Val, what: &str, lk: mut &[]Look): Result[int, DbErr] {
    match x {
        Some(v) {
            let lit = match v { Expr.Lit(_) { true } else { false } }
            let noCols: []lexdb_sql.ColDef = []
            let noRow: []Val = []
            let noAggs: []Val = []
            let noSubs: []SubRes = []
            let noSeq: Option[SeqEnv] = None
            let env = Env{cols: &noCols, row: &noRow, aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs, seq: &noSeq}
            var n = -1                      // NULL: no limit
            match try lexdb_ops.coerce(try eval(&v, &env), &lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}) {
                Val.Int(i) {
                    if i < 0 { return Err(e("2201W", &(what + " must not be negative"))) }
                    n = i
                }
                else {}
            }
            // a look (optimizer 22): the plan keeps the value
            if !lit { append(lk, Look{kind: 1, c: lexdb_sql.cloneExpr(&v), p: Expr.Lit(Val.Null), out: n, typ: noType(), cm: lexdb_stats.noCommon()}) }
            return Ok(n)
        }
        None { return Ok(-1) }
    }
}

// An ORDER BY or DISTINCT ON item's text, as the output column it names
// by position or alias, if it does (9.94).
fn outText(o: &Expr, exprs: &[]Expr, outs: &[]OutCol, cols: &[]lexdb_sql.ColDef): str {
    match o {
        Expr.Lit(v) {
            match v {
                Val.Int(n) { if n >= 1 && n <= len(exprs) { return lexdb_sql.exprText(&exprs[n - 1]) } }
                else {}
            }
        }
        Expr.Col(n, sl) {
            if lexdb_bind.colSlot(cols, &n, sl) < 0 {
                for i in 0..len(outs) { if outs[i].name == n && i < len(exprs) { return lexdb_sql.exprText(&exprs[i]) } }
            }
        }
        else {}
    }
    return lexdb_sql.exprText(o)
}

// An ORDER BY item may name an output column by position or by its alias.
fn orderValue(o: &Expr, outs: &[]OutCol, vals: &[]Val, env: &Env): Result[Val, DbErr] {
    match o {
        Expr.Lit(v) {
            match v {
                Val.Int(n) {
                    if n < 1 || n > len(vals) { return Err(e("42P10", &("ORDER BY position " + n.toStr() + " is not in select list"))) }
                    return Ok(vals[n - 1].clone())
                }
                else {}
            }
        }
        Expr.Col(n, sl) {
            if lexdb_bind.colSlot(&env.cols, &n, sl) < 0 {
                for i in 0..len(outs) { if outs[i].name == n { return Ok(vals[i].clone()) } }
            }
        }
        else {}
    }
    return eval(o, env)
}

fn select(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
          lim: Limits, pc: mut &PlanCache, sink: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool): Result[Res, DbErr] {
    if pc.keep {
        let ver = try planVersion(st, txn)
        if pc.ver != ver {
            pc.sels = []
            pc.looks = []
            pc.ver = ver
        }
        for i in 0..len(pc.sels) {
            if looksHold(&pc.looks[i], params) { return runSelTo(st, txn, &pc.sels[i], params, lim, sink) }
        }
    } else {
        // a plan for this run only (oneShot: the simple protocol's) keeps
        // nothing and needs no version; the catalog's is read as for a
        // kept plan (a read the transaction notes)
        let noted = try catVersion(st, txn)
    }
    var sc = newScopeIn(st, txn, params, ptypes)
    sc.noLp = true
    var sel = try planSelect(st, txn, s, params, mut &sc)
    bindSel(mut &sel)
    pipeSel(mut &sel)
    let looks = replace(mut &sc.looks, [])
    if !pc.keep || len(pc.sels) >= PLAN_VARIANTS { return runSelTo(st, txn, &sel, params, lim, sink) }
    append(mut &pc.sels, sel)
    append(mut &pc.looks, looks)
    pc.plans += 1
    return runSelTo(st, txn, &pc.sels[len(pc.sels) - 1], params, lim, sink)
}

// The version a prepared statement's plans (select's PlanCache) are kept
// for: while the schema the transaction sees is the same (and the
// statistics and the planner's mode). Its plans are one per outcome of the
// looks at its parameters' values (optimizer 22), the first whose looks
// the parameters give again taken.
fn planVersion(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[str, DbErr] {
    var ver = try catVersion(st, txn)
    if len(txn.sql.path) > 0 { ver = ver + "|" + strings.join(&txn.sql.path, ",") }      // its names resolved by the path
    // the session's temporary objects (9.96): their DDL bumps this, not the catalog's version
    if len(txn.tmp) > 0 { ver = ver + "|t" + st.memo.get(&tmpVerKey(txn.sql.sess)).unwrapOr("0") }
    // the time zone (9.95): nothing planned depends on it now (a value is
    // read in it when the plan runs), but a plan is not kept across it
    if !txn.sql.zone.isUtc() { ver = ver + "|z" + txn.sql.zone.name }
    // its privileges checked as the role: SET ROLE plans it again (9.83)
    match st.memo.get(&roleKeyOf(txn.sql.sess)) {
        Some(r) { if len(r) > 0 { ver = ver + "|r" + r } }
        None {}
    }
    match st.memo.get(&sessAuthKey(txn.sql.sess)) {
        Some(r) { if len(r) > 0 { ver = ver + "|s" + r } }
        None {}
    }
    // the join order differs where reads are noted (optimizer 29, 33)
    if txn.sql.rules { ver = ver + "|rules" } else { ver = ver + "|" + (try lexdb_stats.statVersion(st, txn)) + "|m" + txn.sql.memMax.toStr() + (if txn.noting() { "|n" } else { "" }) }   // optimizer 20
    return Ok(ver)
}

// runSel, or its rows given to sink as they are made (a client's: the
// wire sends them as they come, so they are not all held). sink(cols, [],
// ob, true) asks first: false, the caller wants them held, as do queries
// whose rows need anything after the scan (streams). Then each row, or
// batch of rows (OutBatch, 9.101). sink false for one: the client is gone
// (08006).
fn runSelTo(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits,
            sink: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool): Result[Res, DbErr] {
    var sh = newShare()
    return runSelToIn(st, txn, sel, params, lim, sink, mut &sh)
}

// What the runs of one statement that are not each other's children (a
// set operation's parts given to a sink, each run by runSelToIn) hand on
// from one to the next, as runChild hands them from a parent to its
// child: the CTEs' rows (a CTE runs once in the statement, so a volatile
// one gives every part the same rows), the rows held before the run, and
// the steps and turns taken.
type Share = record { cache: CteCache; held: int; ticks: int; turnEnd: int; pre: []SubRes }

fn newShare(): Share { return Share{cache: newCache(), held: 0, ticks: 0, turnEnd: 0, pre: []} }

// A run starts from what sh holds: the CTEs' rows move into it.
fn (rs: mut &Run) takeShare(sh: mut &Share) {
    rs.cache = replace(mut &sh.cache, newCache())
    rs.pre = replace(mut &sh.pre, [])
    rs.bud.held = sh.held
    rs.bud.ticks = sh.ticks
    rs.bud.turnEnd = sh.turnEnd
}

// A run done (or given up for another): the CTEs' rows back to sh, with
// its steps and turns (the rows it held are its own, let go).
fn (sh: mut &Share) giveBack(rs: mut &Run) {
    sh.cache = replace(mut &rs.cache, newCache())
    // (results kept for the next run: their bytes held, counted in sh)
    if len(rs.pre) > 0 { sh.held = rs.bud.held }
    sh.pre = replace(mut &rs.pre, [])
    sh.ticks = rs.bud.ticks
    sh.turnEnd = rs.bud.turnEnd
}

// runSelTo, its runs starting from sh and handing back to it.
fn runSelToIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits,
              sink: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool, sh: mut &Share): Result[Res, DbErr] {
    let noRow: []Val = []
    let noB = noBatch()
    if sel.setop != 0 && streamsSet(sel) {
        let base = sh.held
        let sp = setopSpec(sel, lim.mem, base)
        if sel.sort {
            // ORDER BY: the parts' rows go to the pipeline's sort, its rows
            // to the sink at the end (a value it does not sort: held)
            let r = lexdb_setop.runSorted(txn, &sp, sink, fn(tx: mut &lexdb_store.Txn, i: int, held: int,
                                         sk: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool): Result[[][]Val, DbErr] {
                return setPartRun(st, tx, sel, params, lim, i, held, sk, sh)
            })
            sh.held = base
            match r {
                Ok(o) {
                    var oo = o
                    return Ok(setRes(sel, replace(mut &oo.rows, []), oo.n))
                }
                Err(x) { if !lexdb_pipe.isBat(&x) { return Err(x) } }
            }
            return runSelIn(st, txn, sel, params, lim, sh)
        }
        // each part's rows go to the sink as the part makes them (asked
        // once, as a SELECT's; refused, the rows are held)
        if !sink(&sel.outs, &noRow, &noB, true) { return runSelIn(st, txn, sel, params, lim, sh) }
        let r = lexdb_setop.runUnsorted(txn, &sp, sink, fn(tx: mut &lexdb_store.Txn, i: int, held: int,
                                        sk: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool): Result[[][]Val, DbErr] {
            return setPartRun(st, tx, sel, params, lim, i, held, sk, sh)
        })
        sh.held = base
        var o = try r
        return Ok(setRes(sel, replace(mut &o.rows, []), o.n))
    }
    if !streams(sel) {
        // sorted or DISTINCT by the pipeline (slice P3; 9.105): its rows go
        // to the sink as one OutBatch if it wants them so (it is asked once,
        // only then); else they are held, as runSel holds them
        if !pipeSorts(sel) { return runSelIn(st, txn, sel, params, lim, sh) }
        var rs = newRun(&sel.q)
        rs.limit(&lim)
        if !rs.batch || rs.noLimit { return runSelIn(st, txn, sel, params, lim, sh) }
        rs.takeShare(sh)
        var asked = false
        var want = false
        var rows: [][]Val = []
        var row: []Val = []
        let got = runPipe(st, txn, sel, params, -1, mut &rs, fn(tx: mut &lexdb_store.Txn, ob: &OutBatch, r: &[]Val): Result[bool, DbErr] {
            if !asked {
                asked = true
                want = sink(&sel.outs, &noRow, &noB, true)
            }
            if want {
                if !sink(&sel.outs, &noRow, ob, false) { return Err(lostRows()) }
                return Ok(true)
            }
            for j in 0..ob.n {
                lexdb_pipe.obRow(ob, j, mut &row)
                append(mut &rows, collections.copyOf(&row))
            }
            return Ok(true)
        })
        sh.giveBack(mut &rs)
        var outs: []OutCol = []
        for oc in sel.outs { append(mut &outs, oc.clone()) }
        match got {
            Ok(n) { return Ok(Res{cols: outs, rows: rows, tag: "SELECT " + n.toStr(), hasRows: true, copy: COPY_NONE}) }
            Err(x) {
                // (a value it does not sort: the row engine, nothing given)
                if !lexdb_pipe.isBat(&x) || asked { return Err(x) }
                return runSelIn(st, txn, sel, params, lim, sh)
            }
        }
    }
    if !sink(&sel.outs, &noRow, &noB, true) { return runSelIn(st, txn, sel, params, lim, sh) }
    let n = try eachRowBIn(st, txn, sel, params, lim, true, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
        if !sink(&sel.outs, r, &noB, false) { return Err(lostRows()) }
        return Ok(true)
    }, fn(tx: mut &lexdb_store.Txn, ob: &OutBatch): Result[bool, DbErr] {
        if !sink(&sel.outs, &noRow, ob, false) { return Err(lostRows()) }
        return Ok(true)
    }, sh)
    var outs: []OutCol = []
    for oc in sel.outs { append(mut &outs, oc.clone()) }
    return Ok(Res{cols: outs, rows: [], tag: "SELECT " + n.toStr(), hasRows: true, copy: COPY_NONE})
}

fn lostRows(): DbErr { return e("08006", "the connection was lost while rows were sent") }

// No sink: rows held (runSelTo).
fn noSink(c: &[]OutCol, r: &[]Val, ob: &OutBatch, start: bool): bool { return false }

// The plans a prepared statement keeps at most (optimizer 22): past them, a run with
// parameters none of them fits is planned and not kept.
const PLAN_VARIANTS: int = 4

fn runSel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    var sh = newShare()
    return runSelIn(st, txn, sel, params, lim, mut &sh)
}

// runSel, its run starting from sh and handing back to it.
fn runSelIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits,
            sh: mut &Share): Result[Res, DbErr] {
    if len(sel.locks) > 0 { return runLocking(st, txn, sel, params, lim) }
    var rs = newRun(&sel.q)
    rs.limit(&lim)
    rs.takeShare(sh)
    let r = execSel(st, txn, sel, params, -1, mut &rs)
    sh.giveBack(mut &rs)
    return r
}

// A SELECT ... FOR UPDATE (9.86). Its rows are made without LIMIT and
// OFFSET, then locked in their order, as PostgreSQL's LockRows below its
// Limit: a row SKIP LOCKED leaves out does not count towards the LIMIT,
// one OFFSET passes over is locked too. A lock waited for means the rows
// may have changed: the query runs again, holding the locks it has.
fn runLocking(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits): Result[Res, DbErr] {
    while true {
        var rs = newRun(&sel.q)
        rs.limit(&lim)
        rs.noLimit = true
        // its reads not noted: the rows it gives are kept by their locks
        let quiet = txn.quiet
        txn.quiet = true
        let ran = execSel(st, txn, sel, params, -1, mut &rs)
        txn.quiet = quiet
        var res = try ran
        var out: [][]Val = []
        var passed = 0
        var waited = false
        for i in 0..len(res.rows) {
            if sel.limit >= 0 && len(out) >= sel.limit { break }
            var skip = false
            for lk in sel.locks {
                var b = ""
                let lt = &sel.q.levels[lk.level].t
                for j in 0..lk.n { lexdb_access.encKeyPart(mut &b, &lexdb_access.collKeyVal(&lt.cols[lt.pk[j]], &res.rows[i][lk.at + j])) }
                let got = try lockOf(st, txn, &sel.q.levels[lk.level].t, &b, lk.mode, lk.wait, true)
                if got == lexdb_locks.LOCK_SKIPPED { skip = true }
                if got == lexdb_locks.LOCKED_AFTER_WAIT { waited = true }
                if skip || waited { break }
            }
            if waited { break }
            if skip { continue }
            if passed < sel.offset {
                passed += 1
                continue
            }
            var r = replace(mut &res.rows[i], [])
            while len(r) > sel.nOut { let x = pop(mut &r) }
            append(mut &out, r)
        }
        if waited { continue }
        res.tag = "SELECT " + len(out).toStr()
        res.rows = out
        return Ok(res)
    }
    return Err(e("XX000", "unreachable"))
}

// Calls each on the rows of a planned SELECT, in order, while it gives
// true. A query whose rows need nothing after the scan (no sort, grouping,
// DISTINCT, window, set operation or OFFSET) gives them as they are read,
// so they are not kept; any other runs whole first (execSel).
fn eachRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits,
           each: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr]): Result[Unit, DbErr] {
    let n = try eachRowB(st, txn, sel, params, lim, false, each, noEachB)
    return Ok(Unit{})
}

fn noEachB(tx: mut &lexdb_store.Txn, ob: &OutBatch): Result[bool, DbErr] { return Ok(false) }

// eachRow, giving the number of rows given. batched: a query whose rows a
// scan in batches makes, outputs and all (the pipeline's), gives them to eachB a
// batch at a time (OutBatch, 9.101), not to each; each still gets those
// the row path makes (from a batch on one of whose rows an expression
// gives an error, as batchLevel).
fn eachRowB(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits, batched: bool,
            each: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr],
            eachB: &fn(mut &lexdb_store.Txn, &OutBatch): Result[bool, DbErr]): Result[int, DbErr] {
    var sh = newShare()
    return eachRowBIn(st, txn, sel, params, lim, batched, each, eachB, mut &sh)
}

// eachRowB, its runs starting from sh and handing back to it.
fn eachRowBIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits, batched: bool,
              each: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr],
              eachB: &fn(mut &lexdb_store.Txn, &OutBatch): Result[bool, DbErr], sh: mut &Share): Result[int, DbErr] {
    if !streams(sel) {
        var res = try runSelIn(st, txn, sel, params, lim, sh)
        var k = 0
        for i in 0..len(res.rows) {
            let r = replace(mut &res.rows[i], [])
            if !(try each(txn, &r)) { break }
            k += 1
        }
        return Ok(k)
    }
    if sel.limit == 0 { return Ok(0) }
    var rs = newRun(&sel.q)
    rs.limit(&lim)
    rs.takeShare(sh)
    if rs.batch && pipeRows(sel) {
        var row: []Val = []
        var given = 0
        let got = runPipe(st, txn, sel, params, -1, mut &rs, fn(tx: mut &lexdb_store.Txn, ob: &OutBatch, r: &[]Val): Result[bool, DbErr] {
            given += 1
            if ob.n == 0 { return each(tx, r) }
            if batched { return eachB(tx, ob) }
            for j in 0..ob.n {
                lexdb_pipe.obRow(ob, j, mut &row)
                if !(try each(tx, &row)) { return Ok(false) }
            }
            return Ok(true)
        })
        sh.giveBack(mut &rs)
        match got {
            Ok(n) { return Ok(n) }
            Err(x) {
                // (a value a join's batch cannot hold, an expression it does
                // not compile: the row engine, when nothing was given yet)
                if !lexdb_pipe.isBat(&x) || given > 0 { return Err(x) }
                rs = newRun(&sel.q)
                rs.limit(&lim)
                rs.takeShare(sh)
            }
        }
    }
    let sqe = seqEnv(st, txn)
    let m = try prepare(st, txn, &sel.q, params, mut &rs)
    let q = &sel.q
    var n = 0
    var vals: []Val = []                // one row's values, the array used again for each (9.99)
    let oc = outC(sel, params, seqEnv(st, txn))
    try runQuery(st, txn, q, &m, params, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
        try outRow(sel, &m, params, sqe, &oc, r, mut &vals)
        if !(try each(tx, &vals)) { return Ok(false) }
        n += 1
        return Ok(sel.limit < 0 || n < sel.limit)
    }, mut &rs)
    sh.giveBack(mut &rs)
    return Ok(n)
}

// A streamed SELECT's outputs as the row path makes them (outRow): per
// output its column's place, found once, not by its name per row as eval
// finds it (9.100), -1 others; the others compiled (9.108: their columns by
// place, functions bound once), with eval only where a correlated subquery
// needs it. plain: every output a column, no Env per row; none: no output
// needs eval.
type OutC = record {
    at: []int
    cxs: []Option[lexdb_bind.BX]
    plain: bool
    none: bool
    ce: Ctx
}

// Output i's value from its bound expression (sel.ox, or oc's bound per
// run); None: eval evaluates it.
fn outBound(sel: &Sel, oc: &OutC, i: int, r: &[]Val): Result[Option[Val], DbErr] {
    let none: []Val = []
    if len(oc.cxs) > 0 {
        match oc.cxs[i] {
            Some(cx) { return Ok(Some(try lexdb_pipe.bxEval(&cx, r, &none, &oc.ce))) }
            None { return Ok(None) }
        }
    }
    match sel.ox[i] {
        Some(cx) { return Ok(Some(try lexdb_pipe.bxEval(&cx, r, &none, &oc.ce))) }
        None { return Ok(None) }
    }
}

fn outC(sel: &Sel, params: &[]Val, seq: &Option[SeqEnv]): OutC {
    let q = &sel.q
    var oc = OutC{at: [], cxs: [], plain: true, none: true, ce: cenvOf(seq)}
    // bound once for the plan (bindSel): its outputs read from sel.ox, the run's parameters in ce
    let bound1 = len(sel.ox) == len(sel.exprs) && len(sel.exprs) > 0
    if bound1 && sel.oxParam { oc.ce.params = collections.copyOf(params) }
    for x in sel.exprs {
        var c = -1
        match x {
            Expr.Col(name, sl) { c = lexdb_bind.colSlot(&q.cols, &name, sl) }
            else {}
        }
        append(mut &oc.at, c)
        if bound1 {
            if c < 0 {
                oc.plain = false
                if sel.ox[len(oc.at) - 1].isNone() { oc.none = false }
            }
            continue
        }
        var cx: Option[lexdb_bind.BX] = None
        if c < 0 {
            oc.plain = false
            if !(q.corr && hasCorr(&x)) {
                cx = lexdb_bind.bindExpr(&x, &q.cols, params, false, &typing())
            }
            if cx.isNone() { oc.none = false }
        }
        append(mut &oc.cxs, cx)
    }
    return oc
}

// A SELECT's output row for the query's row r (eachRow), into vals: its
// outputs that are columns copied, the others evaluated (oc).
fn outRow(sel: &Sel, m: &Mats, params: &[]Val, sqe: &Option[SeqEnv], oc: &OutC, r: &[]Val,
          vals: mut &[]Val): Result[Unit, DbErr] {
    let q = &sel.q
    while len(vals) > 0 { let x = pop(vals) }
    if len(r) != len(q.cols) || !oc.none {
        let noAggs: []Val = []
        let env = Env{cols: &q.cols, row: r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
        for i in 0..len(sel.exprs) {
            let c = oc.at[i]
            if c >= 0 && c < len(r) { append(vals, r[c].clone()) } else { append(vals, try eval(&sel.exprs[i], &env)) }
        }
        return Ok(Unit{})
    }
    if oc.plain {
        for c in oc.at { append(vals, r[c].clone()) }
        return Ok(Unit{})
    }
    let noAggs: []Val = []
    for i in 0..len(sel.exprs) {
        let c = oc.at[i]
        if c >= 0 {
            append(vals, r[c].clone())
            continue
        }
        match try outBound(sel, oc, i, r) {
            Some(v) { append(vals, v) }
            None {}
        }
    }
    return Ok(Unit{})
}

// Whether a planned SELECT's rows can be given as the scan reads them
// (eachRow): execSel's last branch, with nothing kept for after it.
fn streams(sel: &Sel): bool {
    if sel.setop != 0 || len(sel.srf) > 0 || sel.aggQ || sel.sort || len(sel.wins) > 0 || sel.distinct || sel.offset > 0 || len(sel.locks) > 0 { return false }
    if sel.q.corr { for x in sel.exprs { if hasCorr(&x) { return false } } }
    return !hasSrfCall(&sel.exprs)
}

// ---- the pipeline's plans (lexdb_pipe; design/lexdb-layers.md 6.2.3, slice P1)
//
// A SELECT the pipeline runs has its plan made at the end of planning
// (pipeSel, after bindSel) and kept with the Sel, so the plan cache keeps
// it: Limit? (Project (Filter? (Scan))) over one table, or an Agg over
// the same under the Sel's views. Its arms take what the plan bound (the
// outputs, Sel.ox; the table's conditions, Query.cc), moved out of the
// Sel; what it did not bind for a subquery run once is bound for the plan
// (lexdb_bind.bindSubs). With SET lexdb_batch on, every run of the Sel is
// the pipeline's (runPipe, pipeGroups): streamed (eachRowB) and held
// (execSelIn) alike, the subqueries run once first and their values given.
// With it off the row engine runs it, binding per run.

// Makes sel's plan the pipeline's when it runs it (Sel.pipe); else
// leaves sel as it was. Its subqueries' and set parts' aggregates too.
fn pipeSel(sel: mut &Sel) { pipeSelIn(sel, true) }

// pipeSel; rows: a plan of rows too (a SELECT's own; false: a subquery's,
// a set's part, or a statement's query: only its aggregates, slice P1b).
// A query with joins whose plan is not then the pipeline's has its joins
// run by it for the row engine (Query.jp, slice P2c).
fn pipeSelIn(sel: mut &Sel, rows: bool) {
    pipeSelMain(sel, rows)
    if len(sel.q.levels) > 1 && !pipeJoins(sel) { levelsProg(sel) }
}

// The joins of sel's query as a program for the row engine (Query.jp):
// its first table's conditions and the joins' expressions bound for it
// (copies: the row engine keeps its own).
fn levelsProg(sel: mut &Sel) { levelsProgQ(mut &sel.q, false) }

// levelsProg of a query; held: its first level may be rows the run holds
// (a MERGE's source: a view, VALUES, a derived table).
fn levelsProgQ(q: mut &Query, held: bool) {
    if q.corr || len(q.refs) > 0 || len(q.top) > 0 { return }
    if !(tableRead(&q.levels[0]) || (held && heldRead(q, &q.levels[0]))) { return }
    var cs: []BX = []
    for x in q.levels[0].cond {
        match planX(&x, q) {
            Some(b) { append(mut &cs, b) }
            None { return }
        }
    }
    let base = filterOver(scanArm(q, false), cs, subsOf(q))
    let joined = joinsOver(q, base)
    match move(joined) {
        Ok(p) {
            match lexdb_pipe.compileLevels(p, &q.cols) {
                Ok(pg) { q.jp = Some(pg) }
                Err(_) {}
            }
        }
        Err(_) {}
    }
}

fn pipeSelMain(sel: mut &Sel, rows: bool) {
    // (a subquery in FROM: its rows too, held for its level, slice P2)
    for i in 0..len(sel.q.subs) { pipeSelIn(mut &sel.q.subs[i].sel, sel.q.subs[i].use == lexdb_sql.SUB_FROM) }
    for i in 0..len(sel.parts) { pipeSelIn(mut &sel.parts[i], true) }
    if sel.aggQ {
        if aggShape(sel) { pipeAgg(sel) }
        return
    }
    if !rows || !pipeShape(sel) { return }
    // the outputs: as bindSel bound them (moved), a column by its slot,
    // else bound for the plan; none if one does not bind (those moved
    // given back)
    var xs: []BX = withCapacity(len(sel.exprs))
    for i in 0..len(sel.exprs) {
        match replace(mut &sel.ox[i], None) {
            Some(b) {
                append(mut &xs, b)
                continue
            }
            None {}
        }
        let c = match sel.exprs[i] {
            Expr.Col(name, sl) { lexdb_bind.colSlot(&sel.q.cols, &name, sl) }
            else { -1 }
        }
        let b = if c >= 0 { Some(BX.Col(c)) } else { planX(&sel.exprs[i], &sel.q) }
        if b.isNone() {
            oxBack(sel, xs)
            return
        }
        append(mut &xs, b.unwrap())
    }
    let got = planConds(sel)
    if got.isNone() {
        oxBack(sel, xs)
        return
    }
    let cs = got.unwrap()
    let base = filterOver(scanArm(&sel.q, false), cs, subsOf(&sel.q))
    let joined = if len(sel.q.levels) > 1 { joinsOver(&sel.q, base) } else { Ok(base) }
    var jp = lexdb_plan.PPlan.Result([])
    match move(joined) {
        Ok(x) { jp = x }
        Err(b) {
            unplan(sel, b)
            oxBack(sel, xs)
            return
        }
    }
    // ORDER BY sorted (slice P3): per key the output it is, else its
    // expression made after the outputs
    var ps: Option[lexdb_plan.PSort] = None
    if sel.sort {
        var srt = lexdb_plan.PSort{shown: len(xs), out: [], desc: [], nf: [], coll: []}
        for oi in 0..len(sel.order) {
            var o = lexdb_bind.orderOut(&sel.order[oi], &sel.q.cols, &sel.outs, len(sel.exprs))
            if o == -2 {
                // a position not in the list: the row path's error
                oxBack(sel, xs)
                unplan(sel, jp)
                return
            }
            if o < 0 {
                match planX(&sel.order[oi], &sel.q) {
                    Some(b) { append(mut &xs, b) }
                    None {
                        oxBack(sel, xs)
                        unplan(sel, jp)
                        return
                    }
                }
                o = len(xs) - 1
            }
            append(mut &srt.out, o)
            append(mut &srt.desc, sel.desc[oi])
            append(mut &srt.nf, sel.nullsFirst[oi])
            append(mut &srt.coll, if oi < len(sel.ordKinds) { sel.ordKinds[oi] } else { lexdb_sql.COLL_EXACT })
        }
        ps = Some(srt)
    }
    let proj = lexdb_plan.PPlan.Project(jp, xs)
    // the operators over it as physAbove makes them (EXPLAIN prints them)
    let dist = if sel.distinct { lexdb_plan.PPlan.Distinct(proj, false, collections.copyOf(&sel.outKinds)) } else { proj }
    let ordered = if len(sel.order) > 0 { lexdb_plan.PPlan.Sort(dist, sel.sort, ps) } else { dist }
    let plan = if sel.limit >= 0 || sel.offset > 0 { lexdb_plan.PPlan.Limit(ordered, sel.limit >= 0 && !sel.sort, sel.limit, max(sel.offset, 0)) } else { ordered }
    match lexdb_pipe.compile(plan, &sel.q.cols) {
        Ok(pg) { sel.pipe = Some(pg) }
        Err(back) { unplan(sel, back) }
    }
}

// x bound for a plan the pipeline runs: over q's columns by place, its
// parameters as slots, a subquery run once as its value (BX.Sub).
fn planX(x: &Expr, q: &Query): Option[BX] {
    let none: []Val = []
    return lexdb_bind.bindSubs(x, &q.cols, &none, &typing())
}

// sel's table's conditions for its plan: moved from Query.cc[0], one the
// plan did not bind bound now (planX); None if one does not bind
// (nothing moved).
fn planConds(sel: mut &Sel): Option[[]BX] {
    var more = match condsMore(&sel.q) {
        Some(x) { x }
        None { return None }
    }
    var cc = replace(mut &sel.q.cc[0], [])
    var cs: []BX = withCapacity(len(cc))
    for i in 0..len(cc) {
        match replace(mut &cc[i], None) {
            Some(b) { append(mut &cs, b) }
            None { append(mut &cs, replace(mut &more[i], None).unwrap()) }
        }
    }
    return Some(cs)
}

// Per condition of q's table the plan did not bind, its binding for the
// plan (planX); [] when the plan bound every one; None if one does not
// bind.
fn condsMore(q: &Query): Option[[]Option[BX]] {
    var more: []Option[BX] = []
    for i in 0..len(q.cc[0]) {
        if q.cc[0][i].isSome() { continue }
        let b = planX(&q.levels[0].cond[i], q)
        if b.isNone() { return None }
        while len(more) < i { append(mut &more, None) }
        append(mut &more, b)
    }
    return Some(more)
}

// The scan of sel's only table (lexdb_plan.PScan): its columns' kinds by
// their slots, those decoded, and whether it reads batches (aggs: an
// aggregate's, which reads a primary key's points as a batch too).
fn scanArm(q: &Query, aggs: bool): lexdb_plan.PScan {
    let lv = &q.levels[0]
    let t = &lv.t
    var kinds: []int = array(len(q.cols), lexdb_rows.BK_NONE)
    for i in 0..len(t.cols) { kinds[lv.first + i] = lexdb_rows.pipeKind(&t.cols[i], false) }
    var need: []bool = withCapacity(len(t.cols))
    for i in 0..len(t.cols) { append(mut &need, len(lv.need) == 0 || lv.need[i]) }
    // (rows the run holds: always read as batches, or row by row if few)
    let held = if lv.virt() { lv.src } else { -1 }
    let batch = held >= 0 || lexdb_plan.firstBatches(&lv.path, len(t.pk), ixCovers(lv, lv.path.index), lv.stops, aggs)
    return lexdb_plan.PScan{level: 0, first: lv.first, kinds: kinds, need: need, part: len(lv.need) > 0, batch: batch, stops: lv.stops, held: held}
}

// Scan (ps, its query's subqueries), under a Filter of cs if any.
fn filterOver(ps: lexdb_plan.PScan, cs: []BX, subs: []lexdb_plan.PSub): lexdb_plan.PPlan {
    let leaf = lexdb_plan.PPlan.Scan(ps, subs)
    return if len(cs) > 0 { lexdb_plan.PPlan.Filter(leaf, cs) } else { leaf }
}

// The tables after sel's first joined over base (its Filter? (Scan)):
// a Join arm per level (slice P2), its keys, conditions and WHERE
// conjuncts bound for the plan, its table's arm (lexdb_plan.PJoin): a
// hash (read once) of a table, a lookup per row by its whole primary key,
// or a range per row (as the batch driver chose them, bJoinPlan: not
// where the first table's reading may stop early). Err(base): a level the
// pipeline does not join (a subquery's or CTE's rows, LATERAL, a semi or
// anti join, RIGHT or FULL, a locked table, a per-row path of another
// kind, a collation's key, an expression that does not bind).
fn joinsOver(q: &Query, base: lexdb_plan.PPlan): Result[lexdb_plan.PPlan, lexdb_plan.PPlan] {
    let l0 = &q.levels[0]
    var p = base
    for k in 1..len(q.levels) {
        let lv = &q.levels[k]
        let inner = lv.join == lexdb_sql.J_INNER || lv.join == lexdb_sql.J_CROSS
        let rj = keepsRight(lv.join)
        if !(inner || rj || lv.join == lexdb_sql.J_LEFT) || lv.lateral || lv.lock != 0 { return Err(p) }
        if lv.src >= 0 && lazySeries(q, lv.src) { return Err(p) }
        if inner && len(lv.post) > 0 { return Err(p) }
        if q.corr && pathCorr(&lv.path) { return Err(p) }
        // (a RIGHT or FULL JOIN: hashed, each with its own marks of the rows that joined)
        if rj && lv.perRow { return Err(p) }
        let mark = if lv.anti { lexdb_plan.MK_ANTI } else if lv.semi || lv.semiSub >= 0 { lexdb_plan.MK_SEMI } else { lexdb_plan.MK_JOIN }
        let look = lv.perRow && !l0.stops && lv.semiSub < 0 && lookupPath(q, lv)
        let range = lv.perRow && !l0.stops && !look && rangePath(q, lv)
        if lv.perRow && !look && !range { return Err(p) }
        let t = &lv.t
        var kinds: []int = array(len(q.cols), lexdb_rows.BK_NONE)
        for i in 0..len(t.cols) { kinds[lv.first + i] = lexdb_rows.pipeKind(&t.cols[i], false) }
        var need: []bool = withCapacity(len(t.cols))
        for i in 0..len(t.cols) { append(mut &need, len(lv.need) == 0 || lv.need[i]) }
        let batch = lexdb_plan.scanBatches(&lv.path, len(t.pk), ixCovers(lv, lv.path.index), false, true)
        var j = lexdb_plan.PJoin{how: lexdb_plan.JH_HASH, kind: if inner { lexdb_sql.J_INNER } else { lv.join }, mark: lexdb_plan.MK_JOIN, resCol: -1, res: [],
                                 scan: lexdb_plan.PScan{level: k, first: lv.first, kinds: kinds, need: need, part: len(lv.need) > 0, batch: batch, stops: false, held: -1},
                                 build: [], hcols: [], keys: [], ktypes: [], exact: true, conds: [], keq: -1, post: [], index: lv.path.index,
                                 rng: [], capNulls: false, noNulls: lv.path.noNulls}
        j.mark = mark
        if !lv.perRow {
            if lv.virt() { j.how = lexdb_plan.JH_ROWS }
            if lv.resNot {
                j.resCol = lv.resCol
                match planX(&lv.resVal, q) {
                    Some(b) { append(mut &j.res, b) }
                    None { return Err(p) }
                }
            }
            // (no key: an inner join of every pair, its conditions per pair)
            if len(lv.hashCols) == 0 {
                if !inner || mark != lexdb_plan.MK_JOIN || lv.resNot { return Err(p) }
            } else if len(lv.hashVals) != len(lv.hashCols) { return Err(p) }
            for hk in lv.hashKinds { if hk != lexdb_sql.COLL_EXACT { return Err(p) } }
            for i in 0..len(lv.hashCols) {
                append(mut &j.hcols, lv.hashCols[i])
                append(mut &j.ktypes, boundType(&t.cols[lv.hashCols[i]].typ))
                match planX(&lv.hashVals[i], q) {
                    Some(b) { append(mut &j.keys, b) }
                    None { return Err(p) }
                }
            }
            for x in lv.local {
                match planX(&x, q) {
                    Some(b) { append(mut &j.build, b) }
                    None { return Err(p) }
                }
            }
            // its conditions but those on its own columns (applied as its
            // rows are read: Level.local)
            for x in lv.cond {
                // (a semi join's and a RIGHT JOIN's: every one, none applied as read)
                if !rj && !lv.semi && q.minLevel(&x) >= k { continue }
                if len(lv.hashCols) == 1 && isKeyEq(&x, q, lv) { j.keq = len(j.conds) }
                match planX(&x, q) {
                    Some(b) { append(mut &j.conds, b) }
                    None { return Err(p) }
                }
            }
        } else {
            j.how = if look { lexdb_plan.JH_LOOK } else { lexdb_plan.JH_RANGE }
            let ix = if look { -1 } else { lv.path.index }
            for i in 0..len(lv.path.eqs) {
                append(mut &j.ktypes, keyType(t, ix, i))
                match planX(&lv.path.eqs[i], q) {
                    Some(b) { append(mut &j.keys, b) }
                    None { return Err(p) }
                }
            }
            if range && len(lv.path.rng) > 0 {
                append(mut &j.ktypes, keyType(t, ix, len(lv.path.eqs)))
                for b in lv.path.rng {
                    match planX(&b.val, q) {
                        Some(v) { append(mut &j.rng, lexdb_plan.PBound{op: b.op.toStr(), val: v}) }
                        None { return Err(p) }
                    }
                }
            }
            j.capNulls = range && lv.path.index >= 0 && (len(lv.path.rng) > 0 || lv.path.noNulls)
            for x in lv.cond {
                match planX(&x, q) {
                    Some(b) { append(mut &j.conds, b) }
                    None { return Err(p) }
                }
            }
        }
        for x in lv.post {
            match planX(&x, q) {
                Some(b) { append(mut &j.post, b) }
                None { return Err(p) }
            }
        }
        p = lexdb_plan.PPlan.Join(p, j)
    }
    return Ok(p)
}

// Whether sel is a SELECT the pipeline may run (what lexdb_pipe.compile
// takes, and what this Sel must give it): streamed (no sort, grouping,
// DISTINCT, window, set or OFFSET), one table read per row, no correlated
// subquery, its outputs and conditions bound for the plan.
fn pipeShape(sel: &Sel): bool {
    let q = &sel.q
    if !(streams(sel) || sortShape(sel)) || len(sel.mr) > 0 || len(sel.feedback) > 0 || sel.topMode != 0 || sel.withTies || sel.first >= 0 { return false }
    if len(q.levels) == 0 || len(q.refs) > 0 || q.corr || len(q.top) > 0 { return false }
    if !firstRead(q, &q.levels[0]) { return false }
    return len(sel.exprs) > 0 && len(sel.exprs) == len(sel.outs) && len(sel.ox) == len(sel.exprs) && boundOnce(q)
}

// Whether sel sorts or is DISTINCT and the pipeline's Sort may run it
// (slice P3): rows of one select list, no grouping, window, set
// operation, lock, DISTINCT ON, WITH TIES, TOP, SELECT @v, or function
// returning rows in it.
fn sortShape(sel: &Sel): bool {
    if sel.setop != 0 || len(sel.srf) > 0 || sel.aggQ || len(sel.wins) > 0 || len(sel.locks) > 0 || len(sel.feedback) > 0 { return false }
    if !(sel.sort || sel.distinct) || sel.donKey > 0 || sel.withTies || sel.topMode != 0 || hasSrfCall(&sel.exprs) { return false }
    if sel.q.corr {
        for x in sel.exprs { if hasCorr(&x) { return false } }
        for x in sel.order { if hasCorr(&x) { return false } }
    }
    return true
}

// Whether lv is a table read per row: not a subquery's or CTE's rows, not
// LATERAL, not locked, no WHERE after it, not a semi or anti join's.
fn tableRead(lv: &Level): bool {
    return lv.perRow && !lv.lateral && !lv.virt() && lv.lock == 0 && len(lv.post) == 0 && !lv.semi && !lv.anti && lv.semiSub < 0
}

// Whether lv is rows the run holds that the pipeline reads as q's first
// table, cut into batches (lexdb_held; item 6 of design/lexdb-batch-gaps.md):
// a subquery in FROM's (a derived table, view, CTE, VALUES, a function
// scan, a catalog relation, an integer series made as it is read), not a
// recursive CTE's working table, not LATERAL, locked, with a WHERE after
// it, or a semi or anti join's. A series is one of smallint, integer or
// bigint (its end is the type's range: lexdb_held.seriesOf).
fn heldRead(q: &Query, lv: &Level): bool {
    if lv.src < 0 || lv.work >= 0 || !lv.perRow || lv.lateral || lv.lock != 0 || len(lv.post) > 0 || lv.semi || lv.anti || lv.semiSub >= 0 { return false }
    if lazySeries(q, lv.src) {
        let oid = q.subs[lv.src].sel.outs[0].oid
        return oid == lexdb_sql.OID_INT2 || oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT8
    }
    return true
}

// Whether lv is a first table the pipeline reads: a table (tableRead) or
// rows the run holds (heldRead).
fn firstRead(q: &Query, lv: &Level): bool { return tableRead(lv) || heldRead(q, lv) }

// Makes an aggregate's plan the pipeline's when it runs it (slice P1b):
// Agg (Filter? (Scan)) under physOf's operators over the groups (views:
// HAVING, the outputs, DISTINCT, ORDER BY and LIMIT stay execSel's, over
// the groups the pipeline gives). The keys and calls bound for the plan,
// and the table's conditions (Query.cc) moved, into the arms.
fn pipeAgg(sel: mut &Sel) {
    var keys: []BX = []
    for x in sel.groupBy {
        match planX(&x, &sel.q) {
            Some(b) { append(mut &keys, b) }
            None { return }
        }
    }
    var calls: []lexdb_plan.PCall = []
    for sp in sel.specs {
        let f = &sp.fname
        // (the calls it accumulates: lexdb_pipe.compile's)
        if sp.kind != lexdb_sql.COLL_EXACT { return }
        var arg: Option[BX] = None
        // (the values besides the argument: string_agg's separator, the ORDER BY keys)
        var more: []BX = []
        if !sp.star {
            if len(sp.args) < 1 || len(sp.args) > 2 { return }
            arg = planX(&sp.args[0], &sel.q)
            if arg.isNone() { return }
            for k in 1..len(sp.args) {
                match planX(&sp.args[k], &sel.q) {
                    Some(b) { append(mut &more, b) }
                    None { return }
                }
            }
        }
        for o in sp.order {
            match planX(&o, &sel.q) {
                Some(b) { append(mut &more, b) }
                None { return }
            }
        }
        var filt: Option[BX] = None
        match sp.filter {
            Some(fx) {
                filt = planX(&fx, &sel.q)
                if filt.isNone() { return }
            }
            None {}
        }
        append(mut &calls, lexdb_plan.PCall{fname: f.toStr(), star: sp.star, arg: arg, filter: filt, distinct: sp.distinct, more: more, dirs: sp.dirs.clone(), dia: sp.dia})
    }
    let cs = match planConds(sel) {
        Some(x) { x }
        None { return }
    }
    var ps = scanArm(&sel.q, true)
    // (over joins every table's columns are the plan's: lexdb_plan.needs)
    if len(keys) == 0 && len(sel.q.levels) == 1 {
        ps.need = lexdb_plan.callsNeed(len(ps.need), &cs, &calls)
        ps.part = true
    }
    var keep: []bool = array(len(sel.q.cols), false)
    for ci in afterCols(sel, &sel.q) { keep[ci] = true }
    let base = filterOver(ps, cs, subsOf(&sel.q))
    // (over joins: slice P2)
    let joined = if len(sel.q.levels) > 1 { joinsOver(&sel.q, base) } else { Ok(base) }
    var input = lexdb_plan.PPlan.Result([])
    match move(joined) {
        Ok(x) { input = x }
        Err(b) {
            unplan(sel, b)
            return
        }
    }
    let agg = lexdb_plan.PPlan.Agg(input, len(sel.gsets) > 0, Some(lexdb_plan.PAgg{keys: keys, calls: calls, keep: keep, sets: copySets(&sel.gsets)}))
    match lexdb_pipe.compile(physAbove(sel, agg), &sel.q.cols) {
        Ok(pg) { sel.pipe = Some(pg) }
        Err(back) { unplan(sel, back) }
    }
}

// Whether sel is an aggregate the pipeline may run: one table read per
// row (the query's only columns), GROUP BY (grouping sets too; no
// collation's keys), no window, no correlated subquery, no MIN/MAX by the
// scan's order.
fn aggShape(sel: &Sel): bool {
    let q = &sel.q
    if sel.setop != 0 || len(sel.srf) > 0 || len(sel.wins) > 0 || sel.first >= 0 || len(sel.locks) > 0 { return false }
    // (a correlated subquery's own: its outer values are its parameters)
    if len(q.levels) == 0 || q.corr || len(q.top) > 0 || !firstRead(q, &q.levels[0]) || !boundOnce(q) { return false }
    // (one table: the query's only columns; joins: each level's, joinsOver)
    if len(q.levels) == 1 && (q.levels[0].first != 0 || len(q.cols) != len(q.levels[0].t.cols)) { return false }
    for k in sel.groupKinds { if k != lexdb_sql.COLL_EXACT { return false } }
    return true
}

// Whether sel's rows are the pipeline's (run, runPipe); its groups
// (pipeGroups) are an aggregate's.
fn pipeRows(sel: &Sel): bool {
    match sel.pipe {
        Some(pg) { return !pg.groups }
        None { return false }
    }
}

fn pipeJoins(sel: &Sel): bool {
    match sel.pipe {
        Some(pg) { return pg.joins }
        None { return false }
    }
}

// Whether sel's pipeline plan sorts or is DISTINCT (slice P3).
fn pipeSorts(sel: &Sel): bool {
    match sel.pipe {
        Some(pg) { return pg.sorts }
        None { return false }
    }
}

fn pipeAggs(sel: &Sel): bool {
    match sel.pipe {
        Some(pg) { return pg.groups }
        None { return false }
    }
}

// Runs sel's aggregate by its pipeline plan: its groups into gs, as the
// row engine leaves them (each group's first row and accumulators). A
// HAVING of no volatile function or subquery is checked here first: a
// group it drops is not kept (q18's subquery keeps 57 of 1.5M), and the
// select checks the others again. m: the run's, its subqueries run
// (their values lent to the plan's run). room: the bytes the groups may
// hold (-1 no limit). The bytes they hold.
fn pipeGroups(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, m: mut &Mats, params: &[]Val, rs: mut &Run,
              gs: mut &Groups, room: int): Result[int, DbErr] {
    let q = &sel.q
    match sel.pipe {
        Some(pg) {
            let src = if pg.joins { lexdb_pipe.noSrc() } else { try pipeSrc(st, txn, sel, &pg, params, &m.subs, len(m.vrows[0]), rs) }
            // (not without GROUP BY: there the one group stays even when
            // HAVING drops it, as the select's empty group)
            var fuse = false
            match sel.having {
                Some(h) { fuse = len(sel.groupBy) > 0 && len(sel.gsets) == 0 && immutable(&h) && !hasSubCall(&h) && len(q.subs) == 0 }
                None {}
            }
            let sqe = seqEnv(st, txn)
            let noAggs: []Val = []
            let noSubs: []SubRes = []
            var firsts: [][]Val = []
            var accss: [][]Acc = []
            var sets: []int = []
            var cnt: []lexdb_pipe.Counts = []
            var vals: []Val = []
            var srcs: []lexdb_pipe.Src = []
            var tabs: []&Table = []
            if pg.joins {
                // (slice P2) every table's arm: its table and where it is read
                // (its path's values read before the subqueries' are lent)
                srcs = try joinSrcs(st, txn, sel, &pg, params, &m.subs, if q.levels[0].virt() { len(m.vrows[0]) } else { 0 }, rs)
                // (a few rows held first: the row engine, from the rows prepared)
                if srcs[0].held && !srcs[0].batch { return Err(lexdb_pipe.batErr()) }
                for k in 0..len(q.levels) { append(mut &tabs, &q.levels[k].t) }
            }
            var cx = pipeCtx(st, txn, params, mut &m.subs)
            let got = lexdb_pipe.runAggAny(st, txn, &pg, &q.cols, &q.levels[0].t, &src, &tabs, &srcs, &m.vrows, &cx, room, mut &rs.bud, mut &cnt,
                                        fn(first: &[]Val, set: int, ps: mut &[]Acc): Result[Unit, DbErr] {
                if fuse {
                    while len(vals) > 0 { let gone = pop(mut &vals) }
                    for i in 0..len(ps) { append(mut &vals, try lexdb_agg.finish(&sel.specs[i], &ps[i])) }
                    let henv = Env{cols: &q.cols, row: first, aggs: &vals, params: params, subs: &noSubs, cur: &noAggs, seq: &sqe}
                    match sel.having {
                        Some(h) { if lexdb_ops.truth(&(try eval(&h, &henv))) != Some(true) { return Ok(Unit{}) } }
                        None {}
                    }
                }
                append(mut &firsts, collections.copyOf(first))
                append(mut &accss, replace(mut &ps, []))
                if set >= 0 { append(mut &sets, set) }
                return Ok(Unit{})
            })
            subsBack(mut &m.subs, replace(mut &cx.subs, []))
            let n = try got
            gs.firsts = firsts
            gs.accs = accss
            gs.sets = sets
            if pg.joins { levelCounts(rs, &cnt) } else { scanCounts(rs, &cnt) }
            return Ok(n)
        }
        None { return Err(e("XX000", "a plan the pipeline does not run")) }
    }
}

// The context a run of a pipeline plan is evaluated in: the session's, the
// run's parameters, and the values of its subqueries run once, moved out
// of subs (subsBack puts them back).
fn pipeCtx(st: &lexdb_store.Store, txn: &lexdb_store.Txn, params: &[]Val, subs: mut &[]SubRes): Ctx {
    var cx = cenvOf(seqEnv(st, txn))
    cx.params = collections.copyOf(params)
    cx.subs = subVals(subs)
    return cx
}

// A run's scan counts (its first operator's) added to the run's first
// table's (EXPLAIN ANALYZE).
fn scanCounts(rs: mut &Run, cnt: &[]lexdb_pipe.Counts) {
    if len(cnt) == 0 { return }
    rs.cnt[0].starts += cnt[0].starts
    rs.cnt[0].read += cnt[0].read
    rs.cnt[0].joined += cnt[0].joined
    rs.cnt[0].batches += cnt[0].batches
}

// A plan the pipeline did not take: its outputs and conditions back to
// sel, those bound for the plan alone (a subquery's value) as unbound.
fn unplan(sel: mut &Sel, p: lexdb_plan.PPlan) {
    match move(p) {
        lexdb_plan.PPlan.Limit(i, _, _, _) { unplan(sel, i) }
        lexdb_plan.PPlan.Sort(i, _, _) { unplan(sel, i) }
        lexdb_plan.PPlan.Distinct(i, _, _) { unplan(sel, i) }
        lexdb_plan.PPlan.Having(i) { unplan(sel, i) }
        // (its keys and calls were bound for the plan only)
        lexdb_plan.PPlan.Agg(i, _, _) { unplan(sel, i) }
        // (a join's expressions were bound for the plan only)
        lexdb_plan.PPlan.Join(i, _) { unplan(sel, i) }
        lexdb_plan.PPlan.Project(i, xs) {
            if len(xs) == 0 {
                // a view: the Sel holds its outputs
                unplan(sel, i)
                return
            }
            oxBack(sel, xs)
            unplan(sel, i)
        }
        lexdb_plan.PPlan.Filter(i, cs) {
            var v = cs
            var cc: []Option[BX] = []
            for k in 0..len(v) { append(mut &cc, unbound(replace(mut &v[k], BX.Const(Val.Null)), false)) }
            sel.q.cc[0] = cc
        }
        else {}
    }
}

// The outputs xs (the first len(xs)) back to sel.ox, as unbound those
// bound for the plan alone.
fn oxBack(sel: mut &Sel, xs: []BX) {
    var v = xs
    // (keys made after the outputs, slice P3: the plan's alone)
    for k in 0..min(len(v), len(sel.exprs)) {
        let col = match sel.exprs[k] {
            Expr.Col(name, sl) { lexdb_bind.colSlot(&sel.q.cols, &name, sl) >= 0 }
            else { false }
        }
        sel.ox[k] = unbound(replace(mut &v[k], BX.Const(Val.Null)), col)
    }
}

// b as the Sel holds it: None for a column (col) or what only a plan's
// run evaluates (a subquery's value).
fn unbound(b: BX, col: bool): Option[BX] { return if col || lexdb_bind.hasSub(&b) { None } else { Some(b) } }

// A pipeline run given up before anything was given, for the row engine
// (batErr): subs, the subqueries' results (a derived table's rows too),
// kept in rs for its runSubs, not run again (a volatile call in them is
// made once); their bytes stay held (a Share given them carries the count).
fn heldFew(pg: &lexdb_pipe.Prog, sr: &SubRes): bool {
    return lexdb_pipe.heldSmall(len(sr.data), sr.series, &sr.vals, sr.sOid, sr.sOrdin)
}

fn keepSubs(rs: mut &Run, subs: []SubRes) {
    rs.pre = subs
}

// Runs sel's pipeline plan: at most cap rows (-1 no cap), given to give
// (lexdb_pipe.run's: a chunk, or a row read one by one), its subqueries
// run once first. The scan's counts go to the run's (EXPLAIN ANALYZE).
// The rows given.
fn runPipe(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int, rs: mut &Run,
           give: &fn(mut &lexdb_store.Txn, &OutBatch, &[]Val): Result[bool, DbErr]): Result[int, DbErr] {
    match sel.pipe {
        Some(pg) {
            var subs = try runSubs(st, txn, &sel.q, params, rs)
            if pg.joins {
                // (slice P2) every table's arm: its table and where it is read
                let l0 = &sel.q.levels[0]
                if l0.virt() && heldFew(&pg, &subs[l0.src]) {
                    // a few rows held first: joined row by row, as before they were
                    // the pipeline's (a join's set-up costs more than they save)
                    keepSubs(rs, subs)
                    return Err(lexdb_pipe.batErr())
                }
                let srcs = try joinSrcs(st, txn, sel, &pg, params, &subs, if l0.virt() { len(subs[l0.src].data) } else { 0 }, rs)
                let cx = pipeCtx(st, txn, params, mut &subs)
                var tabs: []&Table = []
                for k in 0..len(sel.q.levels) { append(mut &tabs, &sel.q.levels[k].t) }
                // a subquery's rows a level's (in FROM, a semi join's: cut to its columns)
                var vrows: [][][]Val = []
                for k in 0..len(sel.q.levels) {
                    let lv = &sel.q.levels[k]
                    if lv.work >= 0 {
                        // a recursive CTE's working table (as prepare reads it)
                        let at = cacheAt(&rs.cache, &("w" + lv.work.toStr()))
                        if at < 0 { return Err(e("XX000", "a working table is missing")) }
                        append(mut &vrows, copyRows(&rs.cache.rows[at]))
                        continue
                    }
                    if lv.src < 0 {
                        append(mut &vrows, [])
                        continue
                    }
                    let rows = replace(mut &subs[lv.src].data, [])
                    append(mut &vrows, if lv.semi { cutRows(rows, len(lv.t.cols)) } else { rows })
                }
                var cnt: []lexdb_pipe.Counts = []
                let n = try lexdb_pipe.runJ(st, txn, &pg, &sel.q.cols, &tabs, &srcs, &vrows, &cx, cap, mut &rs.bud, mut &cnt, give)
                levelCounts(rs, &cnt)
                return Ok(n)
            }
            // (rows the run holds as the first level: read from the subquery's result)
            let l0 = &sel.q.levels[0]
            let none: [][]Val = []
            let src = try pipeSrc(st, txn, sel, &pg, params, &subs, if l0.virt() { len(subs[l0.src].data) } else { 0 }, rs)
            let cx = pipeCtx(st, txn, params, mut &subs)
            let held = if l0.virt() { &subs[l0.src].data } else { &none }
            var cnt: []lexdb_pipe.Counts = []
            let n = try lexdb_pipe.run(st, txn, &pg, &sel.q.cols, &sel.q.levels[0].t, &src, held, &cx, cap, mut &rs.bud, mut &cnt, give)
            scanCounts(rs, &cnt)
            return Ok(n)
        }
        None { return Err(e("XX000", "a plan the pipeline does not run")) }
    }
}

// Where a run of sel's pipeline plan pg reads its table, for the run's
// parameters and subqueries' results (its path's values): its scans, and
// optimizer 19's switch, decided once a run as runLevel decides it; the
// pipeline reads them (lexdb_pipe.srcOf: in batches or row by row).
fn pipeSrc(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, pg: &lexdb_pipe.Prog, params: &[]Val, subs: &[]SubRes,
           held: int, rs: mut &Run): Result[lexdb_pipe.Src, DbErr] {
    return pipeSrcQ(st, txn, &sel.q, pg, params, subs, held, rs)
}

// held: the rows of a first level the run holds (a plan without joins reads
// them in batches when there are enough), else 0.
fn pipeSrcQ(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, pg: &lexdb_pipe.Prog, params: &[]Val, subs: &[]SubRes,
            held: int, rs: mut &Run): Result[lexdb_pipe.Src, DbErr] {
    let lv = &q.levels[0]
    if lv.virt() {
        // rows the run holds: its caller gives them to the run, a series
        // (made as it is read) its arguments
        let sr = &subs[lv.src]
        return lexdb_pipe.srcHeld(pg, held, sr.series, &sr.vals, sr.sOid, sr.sOrdin)
    }
    let p = &lv.path
    let noAggs: []Val = []
    let nullRow: []Val = array(len(q.cols), Val.Null)
    // (its session: the time zone its scans' bounds are read in, 9.95)
    let sqe1 = seqEnv(st, txn)
    let env = Env{cols: &q.cols, row: &nullRow, aggs: &noAggs, params: params, subs: subs, cur: &noAggs, seq: &sqe1}
    var scans = try pathScans(&lv.t, p, &env)
    if len(rs.after) > 0 && p.index < 0 { scans = lexdb_access.afterScans(&scans, &rs.after) }
    var keys: []str = []
    let how = try firstSwitch(st, txn, q, &scans, rs, mut &keys)
    return lexdb_pipe.srcOf(pg, &lv.t, scans, p.index, p.desc, ixCovers(lv, p.index), how, keys)
}

// Where each table of a join plan is read, by level: the first as
// pipeSrc reads it; a hash's by its path, read once (as materialize reads
// it); a table looked up per row: nothing.
fn joinSrcs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, pg: &lexdb_pipe.Prog, params: &[]Val, subs: &[]SubRes,
            held: int, rs: mut &Run): Result[[]lexdb_pipe.Src, DbErr] {
    return joinSrcsQ(st, txn, &sel.q, pg, params, subs, held, rs)
}

fn joinSrcsQ(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, pg: &lexdb_pipe.Prog, params: &[]Val, subs: &[]SubRes,
             held: int, rs: mut &Run): Result[[]lexdb_pipe.Src, DbErr] {
    var out: []lexdb_pipe.Src = []
    append(mut &out, try pipeSrcQ(st, txn, q, pg, params, subs, held, rs))
    let noAggs: []Val = []
    let nullRow: []Val = array(len(q.cols), Val.Null)
    let sqe1 = seqEnv(st, txn)
    let env = Env{cols: &q.cols, row: &nullRow, aggs: &noAggs, params: params, subs: subs, cur: &noAggs, seq: &sqe1}
    for k in 1..len(q.levels) {
        let lv = &q.levels[k]
        if lv.perRow {
            append(mut &out, lexdb_pipe.noSrc())
            continue
        }
        let scans = try pathScans(&lv.t, &lv.path, &env)
        append(mut &out, try lexdb_pipe.srcAt(pg, k, &lv.t, scans, lv.path.index, lv.path.desc, ixCovers(lv, lv.path.index)))
    }
    return Ok(out)
}

// Runs q's levels program (Query.jp) for the row engine: its joined rows
// to emit; m: the run's (its subqueries' values copied into the run's
// context, a subquery's rows a level's).
fn runLevelsProg(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val, pg: &lexdb_pipe.Prog,
                 emit: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr], rs: mut &Run): Result[Unit, DbErr] {
    let srcs = try joinSrcsQ(st, txn, q, pg, params, &m.subs, if q.levels[0].virt() { len(m.vrows[0]) } else { 0 }, rs)
    var cx = cenvOf(seqEnv(st, txn))
    cx.params = collections.copyOf(params)
    for i in 0..len(m.subs) { append(mut &cx.subs, lexdb_pipe.copySub(&m.subs[i].v)) }
    var tabs: []&Table = []
    for k in 0..len(q.levels) { append(mut &tabs, &q.levels[k].t) }
    var vrows: [][][]Val = []
    for k in 0..len(q.levels) { append(mut &vrows, if q.levels[k].virt() { copyRows(&m.vrows[k]) } else { [] }) }
    var cnt: []lexdb_pipe.Counts = []
    try lexdb_pipe.runLevels(st, txn, pg, &q.cols, &tabs, &srcs, &vrows, &cx, mut &rs.bud, mut &cnt, emit)
    levelCounts(rs, &cnt)
    return Ok(Unit{})
}

// A join run's counts, per level (the pipeline's first ones), added to
// the run's (EXPLAIN ANALYZE).
fn levelCounts(rs: mut &Run, cnt: &[]lexdb_pipe.Counts) {
    for k in 0..len(rs.cnt) {
        if k >= len(cnt) - 1 { break }
        rs.cnt[k].starts += cnt[k].starts
        rs.cnt[k].read += cnt[k].read
        rs.cnt[k].joined += cnt[k].joined
        rs.cnt[k].nulls += cnt[k].nulls
        rs.cnt[k].built += cnt[k].built
        rs.cnt[k].kept += cnt[k].kept
        rs.cnt[k].unmatched += cnt[k].unmatched
        rs.cnt[k].batches += cnt[k].batches
    }
}

// sel's rows held (execSel), by its pipeline plan: counted against
// max_statement_mem as execSel's row path counts them.
fn pipeHeld(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int, rs: mut &Run): Result[Res, DbErr] {
    // (a Sort's or Distinct's rows: held, and counted, by the pipeline)
    let counted = !pipeSorts(sel)
    let room = if counted { rs.bud.room() } else { -1 }
    let rs0max = rs.bud.maxHeld
    var held = 0
    var rows: [][]Val = []
    let noOrd: []Val = []
    var vals: []Val = []
    let n = try runPipe(st, txn, sel, params, cap, rs, fn(tx: mut &lexdb_store.Txn, ob: &OutBatch, r: &[]Val): Result[bool, DbErr] {
        if ob.n == 0 {
            held += lexdb_pipe.rowBytes(r) + lexdb_pipe.rowBytes(&noOrd)
            if room >= 0 && held > room { return Err(lexdb_pipe.memErr(rs0max)) }
            append(mut &rows, collections.copyOf(r))
            return Ok(true)
        }
        for j in 0..ob.n {
            lexdb_pipe.obRow(ob, j, mut &vals)
            held += lexdb_pipe.rowBytes(&vals) + lexdb_pipe.rowBytes(&noOrd)
            if room >= 0 && held > room { return Err(lexdb_pipe.memErr(rs0max)) }
            append(mut &rows, collections.copyOf(&vals))
        }
        return Ok(true)
    })
    if counted { try rs.bud.hold(held) }
    var outs: []OutCol = []
    for oc in sel.outs { append(mut &outs, oc.clone()) }
    let tag = "SELECT " + len(rows).toStr()
    return Ok(Res{cols: outs, rows: rows, tag: tag, hasRows: true, copy: COPY_NONE})
}

// A prepared statement's plan (select), with the catalog version it was
// made for. keep false: never kept (a statement run once).
pub type PlanCache = record { sels: []Sel; looks: [][]Look; ver: str; keep: bool; pub plans: int }

pub fn newPlanCache(): PlanCache { return PlanCache{sels: [], looks: [], ver: "", keep: true, plans: 0} }

pub fn oneShot(): PlanCache { return PlanCache{sels: [], looks: [], ver: "", keep: false, plans: 0} }

// ---- aggregates: one accumulator per call and group, so a grouped
// query holds its groups, not its rows

fn slotRef(i: int): Expr { return Expr.Call("#agg", [Expr.Lit(Val.Int(i))], false) }

// x with each aggregate call replaced by its slot, the calls added to specs.
fn collectAggs(x: &Expr, specs: mut &[]AggSpec): Result[Expr, DbErr] {
    match x {
        Expr.Call(name, args, star) {
            if !lexdb_bind.isAgg(&name) {
                var out: []Expr = []
                for a in args { append(mut &out, try collectAggs(&a, specs)) }
                return Ok(Expr.Call(name.clone(), out, star))
            }
            let base = lexdb_sql.aggBase(&name)
            var aargs = lexdb_sql.cloneAllExpr(&args)
            var filter: Option[Expr] = None
            if strings.contains(&name, " filter") { filter = Some(pop(mut &aargs)) }
            var order: []Expr = []
            var dirs = ""
            let oi = strings.indexOf(&name, " order:", 0)
            // percentile_cont / percentile_disc (lexdb_pct): the call's arguments are the
            // value (WITHIN GROUP's key) and the fraction; the letter is the key's direction
            let pct = lexdb_pct.isPct(&base)
            if oi >= 0 {
                let rest = name[oi + 7..len(name)]
                let sp = strings.indexOf(&rest, " ", 0)
                dirs = if sp < 0 { rest.clone() } else { rest[0..sp].clone() }
                if !pct {
                    var rev: []Expr = []
                    for k in 0..len(dirs) { append(mut &rev, pop(mut &aargs)) }
                    while len(rev) > 0 { append(mut &order, pop(mut &rev)) }
                    for o in order { if hasAgg(&o) { return Err(e("42803", "aggregate function calls cannot be nested")) } }
                }
            }
            for a in aargs { if hasAgg(&a) { return Err(e("42803", "aggregate function calls cannot be nested")) } }
            for a in aargs { if hasWin(&a) { return Err(e("42803", "aggregate function calls cannot contain window function calls")) } }
            match filter {
                Some(f) { if hasAgg(&f) { return Err(e("42803", "aggregate functions are not allowed in FILTER")) } }
                None {}
            }
            let want = if base == "string_agg" || pct { 2 } else { 1 }
            let dia = lexdb_pct.dialectOf(&name)
            // the fraction, checked now where it is a literal, as the dialects do (before any row)
            if pct && !star && len(aargs) == 2 { try lexdb_pct.checkArg(dia, &base, &aargs[1]) }
            if star && base != "count" { return Err(e("42809", &(base + "(*) is not an aggregate that takes *"))) }
            if !star && len(aargs) != want {
                return Err(e("42883", &("function " + base + " takes " + want.toStr() + " argument" + (if want > 1 { "s" } else { "" }))))
            }
            let text = lexdb_sql.exprText(x)
            for i in 0..len(specs) { if specs[i].text == text { return Ok(slotRef(i)) } }
            var made = lexdb_agg.spec(base, aargs, star, strings.contains(&name, " distinct"), filter, order, dirs, text, lexdb_sql.COLL_EXACT)
            made.dia = dia
            append(specs, made)
            return Ok(slotRef(len(specs) - 1))
        }
        Expr.Unary(op, a) { return Ok(Expr.Unary(op.clone(), try collectAggs(&a, specs))) }
        Expr.Bin(op, a, b) {
            let l = try collectAggs(&a, specs)
            let r = try collectAggs(&b, specs)
            return Ok(Expr.Bin(op.clone(), l, r))
        }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try collectAggs(&a, specs), neg)) }
        Expr.Cast(a, t) { return Ok(Expr.Cast(try collectAggs(&a, specs), t)) }
        else { return Ok(lexdb_sql.cloneExpr(x)) }
    }
}

// A grouped query's groups so far: per group its first row (for grouped
// columns) and its accumulators.
type Groups = record {
    index: Map[str, int]        // GROUP BY key -> group
    firsts: [][]Val
    accs: [][]Acc
    sets: []int                 // grouping sets (9.94): each group's set
}

// Adds a row to its group (env: the row, and its correlated subqueries'
// values if any).
fn addToGroup(sel: &Sel, gs: mut &Groups, r: &[]Val, env: &Env, held: mut &int, room: int, rs0max: int): Result[Unit, DbErr] {
    if len(sel.gsets) > 0 {
        // grouping sets (9.94): the row joins a group of each set
        var vals: []Val = []
        for x in sel.groupBy { append(mut &vals, try eval(&x, env)) }
        for si in 0..len(sel.gsets) {
            var kb = ""
            kb += &si.toStr()
            kb.addByte(0)
            for j in sel.gsets[si] { lexdb_access.encIdxPart(mut &kb, &vals[j]) }
            let k = kb
            var g = 0
            match gs.index.get(&k) {
                Some(i) { g = i }
                None {
                    g = len(gs.firsts)
                    held += lexdb_pipe.rowBytes(r) + 64 * (len(sel.specs) + 1) + len(k)
                    if room >= 0 && held > room { return Err(lexdb_pipe.memErr(rs0max)) }
                    gs.index.put(k, g)
                    append(mut &gs.firsts, collections.copyOf(r))
                    append(mut &gs.accs, lexdb_agg.newAccs(len(sel.specs)))
                    append(mut &gs.sets, si)
                }
            }
            for i in 0..len(sel.specs) { try accumulate(&sel.specs[i], mut &gs.accs[g][i], env) }
        }
        return Ok(Unit{})
    }
    var g = 0
    if len(sel.groupBy) > 0 {
        var kb = ""
        for gi in 0..len(sel.groupBy) {
            let v = try eval(&sel.groupBy[gi], env)
            lexdb_access.encIdxPart(mut &kb, &(if gi < len(sel.groupKinds) { lexdb_sort.collVal(sel.groupKinds[gi], &v) } else { v }))
        }
        let k = kb
        match gs.index.get(&k) {
            Some(i) { g = i }
            None {
                g = len(gs.firsts)
                held += lexdb_pipe.rowBytes(r) + 64 * (len(sel.specs) + 1) + len(k)
                if room >= 0 && held > room { return Err(lexdb_pipe.memErr(rs0max)) }
                gs.index.put(k, g)
                append(mut &gs.firsts, collections.copyOf(r))
                append(mut &gs.accs, lexdb_agg.newAccs(len(sel.specs)))
            }
        }
    } else if len(gs.firsts) == 0 {
        append(mut &gs.firsts, collections.copyOf(r))
        append(mut &gs.accs, lexdb_agg.newAccs(len(sel.specs)))
    }
    for i in 0..len(sel.specs) { try accumulate(&sel.specs[i], mut &gs.accs[g][i], env) }
    return Ok(Unit{})
}

// A correlated subquery in a GROUP BY key or an aggregate's argument or
// FILTER.
fn groupCorr(sel: &Sel): bool {
    for g in sel.groupBy { if hasCorr(&g) { return true } }
    for sp in sel.specs {
        for a in sp.args { if hasCorr(&a) { return true } }
        for o in sp.order { if hasCorr(&o) { return true } }
        match sp.filter {
            Some(f) { if hasCorr(&f) { return true } }
            None {}
        }
    }
    return false
}

// Adds one row (env) to an accumulator: the call's FILTER, then its
// argument's value (a NULL not counted); lexdb_agg takes the value, with
// the separator and ORDER BY keys read only for a value it accumulates.
fn accumulate(sp: &AggSpec, acc: mut &Acc, env: &Env): Result[Unit, DbErr] {
    match sp.filter {
        Some(f) { if lexdb_ops.truth(&(try eval(&f, env))) != Some(true) { return Ok(Unit{}) } }
        None {}
    }
    if sp.star {
        acc.n += 1
        return Ok(Unit{})
    }
    let v = try eval(&sp.args[0], env)
    if !lexdb_agg.admit(sp, acc, &v) { return Ok(Unit{}) }
    var more: []Val = []
    if lexdb_agg.hasSep(sp) { append(mut &more, try eval(&sp.args[1], env)) }
    for o in sp.order { append(mut &more, try eval(&o, env)) }
    return lexdb_agg.add(sp, acc, v, more)
}

// A grouped query's output may use a column only inside an aggregate, as
// part of a GROUP BY expression, or from a table whose whole primary key
// is grouped (its other columns follow from it).
fn checkGrouped(x: &Expr, gtexts: &[]str, okLevels: &[]bool, q: &Query): Result[Unit, DbErr] {
    let t = lexdb_sql.exprText(x)
    for g in gtexts { if g == t { return Ok(Unit{}) } }
    match x {
        Expr.Col(n, sl) {
            let i = lexdb_bind.colSlot(&q.cols, &n, sl)
            if i < 0 { return Ok(Unit{}) }      // an output column's alias (ORDER BY)
            let l = q.levelOf(&n)
            if l >= 0 && okLevels[l] { return Ok(Unit{}) }
            return Err(e("42803", &("column \"" + n + "\" must appear in the GROUP BY clause or be used in an aggregate function")))
        }
        Expr.Call(name, args, _) {
            if name == "#agg" { return Ok(Unit{}) }
            for a in args { try checkGrouped(&a, gtexts, okLevels, q) }
        }
        Expr.Unary(_, a) { try checkGrouped(&a, gtexts, okLevels, q) }
        Expr.Bin(_, a, b) {
            try checkGrouped(&a, gtexts, okLevels, q)
            try checkGrouped(&b, gtexts, okLevels, q)
        }
        Expr.IsNull(a, _) { try checkGrouped(&a, gtexts, okLevels, q) }
        Expr.Cast(a, _) { try checkGrouped(&a, gtexts, okLevels, q) }
        else {}
    }
    return Ok(Unit{})
}

fn valsKey(vs: &[]Val): str {
    var kb = ""
    for v in vs { lexdb_access.encIdxPart(mut &kb, &v) }
    return kb
}

// A SELECT, planned: its query, its output, and how its order is had.
type Sel = record {
    q: Query
    exprs: []Expr
    outs: []OutCol
    groupBy: []Expr
    order: []Expr
    aggQ: bool
    sort: bool              // ORDER BY sorts; false: the scan gives the order
    first: int              // MIN or MAX served by the scan's order: stop at the first non-NULL value of this column
    limit: int
    offset: int
    having: Option[Expr]
    specs: []AggSpec        // the aggregate calls; exprs, having and order use their slots
    distinct: bool
    desc: []bool            // per ORDER BY item
    nullsFirst: []bool      // ... NULLs first
    parts: []Sel            // UNION, INTERSECT, EXCEPT: its two queries (q has no tables, refs theirs)
    setop: int
    setAll: bool
    split: int              // refs: the first query's, then the second's
    rec: int                // a recursive CTE: its number; -1
    srf: str                // a function in FROM: its name; exprs are its arguments, outs its columns (9.27)
    ordin: bool             // ... WITH ORDINALITY
    wins: []WinPlan         // its window calls (9.46): exprs and order read their values from slots nAggs + i
    nAggs: int
    // FOR UPDATE and the like (9.86): per table locked, its key's columns,
    // added to exprs after the output's (nOut of them)
    locks: []SelLock
    nOut: int
    donKey: int             // DISTINCT ON (9.94): the first donKey sort values tell rows apart; 0 none
    withTies: bool          // FETCH ... WITH TIES: rows tied with the last kept are kept too
    gsets: [][]int          // ROLLUP, CUBE, GROUPING SETS: the sets, places in groupBy; [] plain
    gx: [][]Expr            // ... per set, exprs, order and having as that set sees them
    gord: [][]Expr
    gh: []Option[Expr]
    // collations (L2): per GROUP BY key, ORDER BY item and output column,
    // the kind it is grouped, sorted and made distinct by (lexdb_sql.COLL_*)
    groupKinds: []int
    ordKinds: []int
    outKinds: []int
    // T-SQL's TOP n PERCENT and WITH TIES (lexdb_sql.TOP_*): limit is -1,
    // topN the n, applied to the rows sorted
    topMode: int
    topN: int
    // T-SQL's SELECT @v = f(@v, ...) (design/lexdb-tds.md S4): per output
    // column the parameter it assigns (0 none), when one reads another's:
    // the rows evaluated in their order, each seeing the last's values
    feedback: []int
    mr: []MrPlan            // MATCH_RECOGNIZE's wrapper (design/lexdb-match-recognize.md): its plan; outs stay the input's
    // per output expression (exprs), bound once for the plan (bindSel;
    // parameters as slots; None for a column, read at its place, or one eval
    // evaluates); [] bound per run (outC)
    ox: []Option[lexdb_bind.BX]
    oxParam: bool           // one of ox reads a parameter slot (outC copies the run's parameters only then)
    // UNION, INTERSECT, EXCEPT: per output column, the parts whose values
    // are converted to its type (lexdb_bind.converts): 1 the first, 2 the
    // second; [] none
    conv: []int
    lp: lexdb_bind.LPlan        // the query as the binder gives it (design/lexdb-layers.md 4.4.1, 2e); read by nothing yet
    // the plan as the pipeline runs it (pipeSel; design/lexdb-layers.md
    // 6.2.3): its arms hold the outputs and conditions bound (then not in
    // ox and q.cc); None: the row engine and the batch drivers run it
    pipe: Option[lexdb_pipe.Prog]
}

fn copySets(xs: &[][]int): [][]int {
    var out: [][]int = []
    for x in xs { append(mut &out, collections.copyOf(&x)) }
    return out
}

fn hasGrouping(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasGrouping(&a) }
        Expr.Bin(_, a, b) { return hasGrouping(&a) || hasGrouping(&b) }
        Expr.IsNull(a, _) { return hasGrouping(&a) }
        Expr.Cast(a, _) { return hasGrouping(&a) }
        Expr.Call(n, args, _) {
            if n == "grouping" { return true }
            for a in args { if hasGrouping(&a) { return true } }
            return false
        }
        else { return false }
    }
}

// x as a grouping set sees it (9.94): an expression grouped by (gtexts)
// but not in the set (ins) is NULL; GROUPING(a, ...) is its bits, the
// first argument's highest, 1 for one not in the set.
fn setSubst(x: &Expr, gtexts: &[]str, ins: &[]str): Result[Expr, DbErr] {
    let t = lexdb_sql.exprText(x)
    for g in gtexts {
        if g == t {
            for i in ins { if i == t { return Ok(lexdb_sql.cloneExpr(x)) } }
            return Ok(Expr.Lit(Val.Null))
        }
    }
    match x {
        Expr.Unary(op, a) { return Ok(Expr.Unary(op.clone(), try setSubst(&a, gtexts, ins))) }
        Expr.Bin(op, a, b) { return Ok(Expr.Bin(op.clone(), try setSubst(&a, gtexts, ins), try setSubst(&b, gtexts, ins))) }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try setSubst(&a, gtexts, ins), neg)) }
        Expr.Cast(a, ty) { return Ok(Expr.Cast(try setSubst(&a, gtexts, ins), ty)) }
        Expr.Call(n, args, star) {
            if n == "grouping" {
                if len(args) > 31 { return Err(e("54011", "GROUPING must have fewer than 32 arguments")) }
                var mask = 0
                for a in args {
                    let at = lexdb_sql.exprText(&a)
                    var grouped = false
                    for g in gtexts { if g == at { grouped = true } }
                    if !grouped { return Err(e("42803", "arguments to GROUPING must be grouping expressions of the associated query level")) }
                    var inSet = false
                    for i in ins { if i == at { inSet = true } }
                    mask = (mask << 1) | (if inSet { 0 } else { 1 })
                }
                // a cast, not a bare number: ORDER BY reads that as a column's place
                return Ok(Expr.Cast(Expr.Lit(Val.Int(mask)), lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT4, prec: 0, scale: 0, len: 0}))
            }
            if n == "#agg" { return Ok(lexdb_sql.cloneExpr(x)) }
            var out: []Expr = []
            for a in args { append(mut &out, try setSubst(&a, gtexts, ins)) }
            return Ok(Expr.Call(n.clone(), out, star))
        }
        else { return Ok(lexdb_sql.cloneExpr(x)) }
    }
}

type SelLock = value record { level: int; at: int; n: int; mode: int; wait: int }

// The column of level 0 an expression is, else -1.
fn (q: &Query) firstCol(x: &Expr): int {
    match x {
        Expr.Col(n, sl) {
            if q.levelOf(&n) == 0 { return lexdb_bind.colSlot(&q.cols, &n, sl) - q.levels[0].first }
        }
        else {}
    }
    return -1
}

// The columns of the first table an ORDER BY sorts by, all one way: the
// direction (0 up, 1 down), or -1 when it sorts by anything else.
fn orderCols(q: &Query, order: &[]Expr, items: &[]lexdb_sql.OrderItem, exprs: &[]Expr, outs: &[]OutCol,
             cols: mut &[]int): int {
    if len(order) == 0 || len(q.levels) == 0 { return -1 }
    for i in 0..len(order) {
        if items[i].desc != items[0].desc { return -1 }
        if items[i].nullsFirst != items[i].desc { return -1 }    // NULLs where an index does not keep them
        var c = q.firstCol(&order[i])
        match order[i] {
            Expr.Lit(v) {
                match v {
                    Val.Int(n) { if n >= 1 && n <= len(exprs) { c = q.firstCol(&exprs[n - 1]) } }
                    else {}
                }
            }
            Expr.Col(n, _) {
                if c < 0 {
                    for j in 0..len(outs) { if outs[j].name == n { c = q.firstCol(&exprs[j]) } }
                }
            }
            else {}
        }
        if c < 0 { return -1 }
        append(cols, c)
    }
    return if items[0].desc { 1 } else { 0 }
}

// Whether a path of the first table gives its rows in the order of cols:
// they follow its key (an index's key ends with the primary key) after its
// equalities, skipping columns held equal.
fn servesOrder(t: &Table, p: &Path, cols: &[]int): bool {
    if p.inSub >= 0 { return false }        // past IN_LOOKUP_MAX it reads in primary key order
    var key = keyCols(t, p.index)
    if p.index >= 0 { for c in t.pk { append(mut &key, c) } }
    if p.index < 0 && len(p.eqs) == len(t.pk) { return true }     // one row
    var j = len(p.eqs)
    for c in cols {
        if j < len(key) && key[j] == c {
            j += 1
            continue
        }
        var held = false
        for x in 0..len(p.eqs) { if key[x] == c { held = true } }
        if !held { return false }
    }
    return true
}

// Lookups in key order (9.107): the first table, scanned whole, is read
// instead through an index holding every column it uses (read alone),
// whose first column is the value a later table is looked up by (the
// first column of its primary key, per row: lookupPath). That table's
// keys then come in order, and the batches' lookups (bLookup, getMany)
// find each from the leaf of the one before. Not where reading may stop
// early (a LIMIT: the rows it gives would change), nor where the path was
// chosen for an order.
fn orderLookups(q: mut &Query) {
    if len(q.levels) < 2 { return }
    var ix = -1
    {
        let l0 = &q.levels[0]
        let p = &l0.path
        if l0.virt() || !l0.perRow || l0.lateral || l0.keeps || l0.stops || p.index >= 0 || p.desc || len(p.eqs) > 0 || len(p.rng) > 0 ||
           len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 || len(l0.need) == 0 { return }
        for k in 1..len(q.levels) {
            let lv = &q.levels[k]
            if !lv.perRow || !lookupPath(q, lv) { continue }
            var c = -1
            match lv.path.eqs[0] {
                Expr.Col(n, sl) {
                    let at = lexdb_bind.colSlot(&q.cols, &n, sl)
                    if at >= l0.first && at < l0.first + len(l0.t.cols) { c = at - l0.first }
                }
                else {}
            }
            if c < 0 { continue }
            for i in 0..len(l0.t.indexes) {
                let x = &l0.t.indexes[i]
                if ix < 0 && x.pred.isNone() && len(x.cols) > 0 && x.cols[0] == c && ixCovers(l0, i) { ix = i }
            }
            break
        }
    }
    if ix >= 0 { q.levels[0].path.index = ix }
}

// A full scan of the primary key or an index that gives the order, if one does.
fn orderedScan(q: &Query, cols: &[]int, params: &[]Val, lk: mut &[]Look): Option[int] {
    let t = &q.levels[0].t
    for c0 in 0..len(t.indexes) + 1 {
        if !q.usable(0, c0 - 1, &q.levels[0].cond, params, lk) { continue }
        let p = Path{index: c0 - 1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
        if servesOrder(t, &p, cols) { return Some(c0 - 1) }
    }
    return None
}

// The column of the first table every output is MIN (0) or MAX (1) of, else -1.
fn minMax(q: &Query, exprs: &[]Expr, dir: mut &int): int {
    var col = -1
    var fname = ""
    for x in exprs {
        match x {
            Expr.Call(n, args, star) {
                if (n != "min" && n != "max") || star || len(args) != 1 { return -1 }
                let c = q.firstCol(&args[0])
                if c < 0 || (col >= 0 && (c != col || n != fname)) { return -1 }
                col = c
                fname = n.clone()
            }
            else { return -1 }
        }
    }
    dir = if fname == "max" { 1 } else { 0 }
    return col
}

// The columns a statement names, without their tables, in any of its
// parts and subqueries; star: a * anywhere in it that reads every column.
// An EXISTS's select list is not read (PostgreSQL drops it), so its * is
// none, unless the rows it counts depend on their values: a set operation,
// GROUP BY (a position names a column of *) or DISTINCT. q21's and q4's
// "exists (select * from lineitem ...)" read every column of every table
// before (design/lexdb-layers.md 6.2.2).
fn stmtNames(s: &lexdb_sql.Stmt, names: mut &Map[str, int], star: mut &bool) {
    var xs: []str = []
    let listRead = !(s.use == lexdb_sql.SUB_EXISTS && s.setop == 0 && len(s.group) == 0 && len(s.gsets) == 0 && !s.distinct &&
                     len(s.distinctOn) == 0)
    for it in s.items {
        if it.star && listRead { star = true }
        match it.expr { Some(x) { lexdb_sql.colNames(&x, mut &xs) } None {} }
    }
    match s.where { Some(x) { lexdb_sql.colNames(&x, mut &xs) } None {} }
    match s.having { Some(x) { lexdb_sql.colNames(&x, mut &xs) } None {} }
    match s.limit { Some(x) { lexdb_sql.colNames(&x, mut &xs) } None {} }
    match s.offset { Some(x) { lexdb_sql.colNames(&x, mut &xs) } None {} }
    for g in s.group { lexdb_sql.colNames(&g, mut &xs) }
    for o in s.order { lexdb_sql.colNames(&o.expr, mut &xs) }
    // DISTINCT ON's keys, which need not be in ORDER BY
    for d in s.distinctOn { lexdb_sql.colNames(&d, mut &xs) }
    for f in s.from {
        match f.on { Some(x) { lexdb_sql.colNames(&x, mut &xs) } None {} }
        // USING's names join the sides; NATURAL's are known only from the
        // tables, so it reads them whole (9.93)
        for u in f.using { append(mut &xs, u.clone()) }
        if f.natural { star = true }
    }
    for r in s.rows { for x in r { lexdb_sql.colNames(&x, mut &xs) } }
    for si in s.sets { lexdb_sql.colNames(&si.expr, mut &xs) }
    for w in s.wins { winNames(&w, mut &xs) }
    for nw in s.windows { winNames(&nw.def, mut &xs) }
    for x in xs { names.put(lexdb_bind.colPart(&x), 1) }
    for b in s.subs { stmtNames(&b, names, star) }
    for b in s.inner { stmtNames(&b, names, star) }
}

// A SELECT reads of its tables only the columns it names (9.31): its
// results depend on nothing else. (UPDATE and DELETE write rows back
// whole; they are not planned here.)
fn narrow(q: mut &Query, s: &lexdb_sql.Stmt) {
    var names: Map[str, int] = newMap()
    var star = false
    stmtNames(s, mut &names, mut &star)
    if star { return }
    for k in 0..len(q.levels) {
        if q.levels[k].virt() { continue }
        var need: []bool = []
        for c in q.levels[k].t.cols { append(mut &need, names.has(&c.name)) }
        q.levels[k].need = need
    }
}

// DELETE reads of its table's rows only the columns it uses, as narrow does
// for SELECT: those its WHERE and RETURNING name, the primary key's, and
// each index's (its columns, expressions and predicate: delRow deletes the
// entries by value). The rows of a table that foreign keys reference, of a
// DELETE ... USING, or named whole, are read whole. A DELETE of 10,000 of
// w's million rows decoded all nine columns of every row to delete by key
// (design/lexdb.md 9.109).
fn delNarrow(q: mut &Query, s: &lexdb_sql.Stmt) {
    if len(q.levels) != 1 || len(s.from) > 0 || q.levels[0].virt() || len(q.levels[0].t.refBy) > 0 { return }
    var names: Map[str, int] = newMap()
    var star = false
    stmtNames(s, mut &names, mut &star)
    if star || names.has(&q.levels[0].alias) || names.has(&lexdb_sql.baseName(&q.levels[0].t.name)) { return }
    var xs: []str = []
    for p in q.levels[0].t.pk { append(mut &xs, q.levels[0].t.cols[p].name.clone()) }
    for ix in q.levels[0].t.indexes {
        for c in ix.cols { if c >= 0 { append(mut &xs, q.levels[0].t.cols[c].name.clone()) } }
        for x in ix.exprs { lexdb_sql.colNames(&x, mut &xs) }
        match ix.pred { Some(x) { lexdb_sql.colNames(&x, mut &xs) } None {} }
    }
    for x in xs { names.put(lexdb_bind.colPart(&x), 1) }
    var need: []bool = []
    for c in q.levels[0].t.cols { append(mut &need, names.has(&c.name)) }
    q.levels[0].need = need
}

// ---- row locks (9.86)

// FOR UPDATE and the like on the query's tables: those OF names, or all.
// A locked table's rows are read whole (their keys) and from the latest
// commit (Session.runIn); a lock waited for runs the query again (runSel).
fn applyLocks(q: mut &Query, s: &lexdb_sql.Stmt): Result[Unit, DbErr] {
    let what = lexdb_sql.lockName(s.lockMode)
    for n in s.lockOf {
        var found = false
        for lv in q.levels { if lv.alias == n || lv.t.name == n { found = true } }
        if !found { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&n) + "\" in " + what + " clause not found in FROM clause"))) }
    }
    for k in 0..len(q.levels) {
        var named = len(s.lockOf) == 0
        for n in s.lockOf { if q.levels[k].alias == n || q.levels[k].t.name == n { named = true } }
        if !named || q.levels[k].virt() { continue }
        // the nullable side of an outer join has no row to lock
        var nullable = k > 0 && keepsLeft(q.levels[k].join)
        for j in k + 1..len(q.levels) { if keepsRight(q.levels[j].join) { nullable = true } }
        if nullable { return Err(e("0A000", &(what + " cannot be applied to the nullable side of an outer join"))) }
        q.levels[k].lock = s.lockMode
        q.levels[k].lockWait = s.lockWait
        q.levels[k].need = []
    }
    return Ok(Unit{})
}

// Locks row key of table t (lexdb_store.lockRow), NOWAIT's error naming t.
fn lockOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, key: &str, mode: int, wait: int, keep: bool): Result[int, DbErr] {
    match st.lockRow(txn, t.tree, key, mode, wait, keep) {
        Ok(g) { return Ok(g) }
        Err(x) {
            if x.state == "55P03" { return Err(e("55P03", &("could not obtain lock on row in relation \"" + lexdb_sql.baseName(&t.name) + "\""))) }
            return Err(x)
        }
    }
}

// UPDATE and DELETE: the rows found locked before they are written, in a
// block until it ends; outside one only waited for (its commit follows at
// once). true: one was waited for, so what was found may have changed.
fn lockFound(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, found: &[][]Val, mode: int): Result[bool, DbErr] {
    let keep = txn.inBlock()
    if !keep && st.locks.count() == 0 { return Ok(false) }
    var waited = false
    for r in found {
        let got = try lockOf(st, txn, t, &keyOf(t, &r), mode, lexdb_sql.WAIT_BLOCK, keep)
        if got == lexdb_locks.LOCKED_AFTER_WAIT { waited = true }
    }
    return Ok(waited)
}

fn planSelect(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val,
              sc: mut &Scope): Result[Sel, DbErr] {
    if s.rec && s.setop != lexdb_sql.SET_UNION {
        return Err(e("42P19", "recursive query does not have the form non-recursive-term UNION [ALL] recursive-term"))
    }
    if s.lockMode > 0 {
        let what = lexdb_sql.lockName(s.lockMode) + " is not allowed with "
        if s.setop != 0 { return Err(e("0A000", &(what + "UNION/INTERSECT/EXCEPT"))) }
        if len(s.group) > 0 { return Err(e("0A000", &(what + "GROUP BY clause"))) }
        if s.having.isSome() { return Err(e("0A000", &(what + "HAVING clause"))) }
        if s.distinct || len(s.distinctOn) > 0 { return Err(e("0A000", &(what + "DISTINCT clause"))) }
        if s.withTies { return Err(e("0A000", &("lexdb: " + lexdb_sql.lockName(s.lockMode) + " is not supported with WITH TIES"))) }
        if len(s.wins) > 0 { return Err(e("0A000", &(what + "window functions"))) }
    }
    // (a set's parts and the subqueries build theirs: their callers take them)
    let noLp = sc.noLp
    sc.noLp = false
    if s.setop != 0 { return planSet(st, txn, s, params, sc) }
    sc.early = sc.early || (s.limit.isSome() && len(s.order) == 0 && !stmtGathers(s))
    sc.ordLim = -1
    sc.ordBy = []
    if s.limit.isSome() && len(s.order) > 0 && len(s.group) == 0 && !s.distinct && len(s.distinctOn) == 0 && len(s.wins) == 0 &&
       s.having.isNone() && len(s.gsets) == 0 {
        var agg = false
        for it in s.items { match it.expr { Some(x) { if hasAgg(&x) { agg = true } } None {} } }
        for o in s.order { if hasAgg(&o.expr) { agg = true } }
        if !agg {
            sc.ordLim = limitGuess(&s.limit) + limitGuess(&s.offset)
            for o in s.order { append(mut &sc.ordBy, lexdb_sql.OrderItem{expr: lexdb_sql.cloneExpr(&o.expr), desc: o.desc, nullsFirst: o.nullsFirst}) }
        }
    }
    var needNames: Map[str, int] = newMap()
    var needStar = false
    stmtNames(s, mut &needNames, mut &needStar)
    sc.locking = s.lockMode > 0
    var q = try buildQuery(st, txn, &s.from, &s.where, params, &s.subs, &needNames, needStar, sc, true)
    if s.kind == lexdb_sql.S_SELECT { narrow(mut &q, s) }
    if s.lockMode > 0 { try applyLocks(mut &q, s) }
    // The select list as resolved: the plan's Project's. The planner reads it
    // in place; its first rewrite (winMarks, collectAggs, winSlots: rewriteList)
    // builds the planner's own list from it, and the resolved one goes to
    // the plan (bx). Where none runs, Sel.exprs is the resolved list and the
    // Project's is [] (lexdb_bind.lpLentExprs; takeLp fills it when the
    // plan leaves the Sel).
    var exprs: []Expr = []
    let outs = try lexdb_bind.selectCols(s, &q.cols, mut &sc.names, mut &exprs)
    var bx: []Expr = []
    var xRewritten = false
    var groupBy: []Expr = []
    var groupKinds: []int = []
    for g in s.group {
        let r = try lexdb_bind.resolveGroup(&g, &q.cols, &outs, &exprs, mut &sc.names)
        if hasAgg(&r) { return Err(e("42803", "aggregate functions are not allowed in GROUP BY")) }
        append(mut &groupKinds, lexdb_bind.exprKind(&r, &q.cols, &sc.names))
        append(mut &groupBy, r)
    }
    // GROUP BY as resolved: the plan's Agg's keys (bg), moved there when the
    // planner has built its own list from it (the redundant keys dropped:
    // gb), copied where the Sel keeps it as resolved (grouping sets)
    var bg: []Expr = []
    var order: []Expr = []
    var ordKinds: []int = []
    for o in s.order {
        // an enum's order is its labels' (9.90)
        let r = try lexdb_bind.resolveOrder(&o.expr, &q.cols, &outs, mut &sc.names)
        // its collation's (L2): an output column's, or the expression's
        var ok = outRefKind(&r, &outs)
        match r {
            Expr.Col(n, sl) { if lexdb_bind.colSlot(&q.cols, &n, sl) >= 0 { ok = lexdb_bind.exprKind(&r, &q.cols, &sc.names) } }
            Expr.Lit(_) {}
            else { ok = lexdb_bind.exprKind(&r, &q.cols, &sc.names) }
        }
        append(mut &ordKinds, ok)
        match try enumOf(st, txn, &r, &q.cols) {
            Some(en) { append(mut &order, enumPos(&r, &en)) }
            None { append(mut &order, r) }
        }
    }
    // DISTINCT ON (9.94), as PostgreSQL's transformDistinctOnClause: the
    // ORDER BY items that are DISTINCT ON's come first, the others it has
    // not are sorted by after them, and the rows are told apart by those
    // (donKey of them): the first of each kept
    var donKey = 0
    var added = 0
    var lpOn: []Expr = []
    if len(s.distinctOn) > 0 {
        var dt: []str = []
        for d in s.distinctOn {
            var r = try lexdb_bind.resolveOrder(&d, &q.cols, &outs, mut &sc.names)
            match try enumOf(st, txn, &r, &q.cols) {
                Some(en) { r = enumPos(&r, &en) }
                None {}
            }
            append(mut &dt, outText(&r, &exprs, &outs, &q.cols))
            append(mut &lpOn, r)
        }
        let bad = e("42P10", "SELECT DISTINCT ON expressions must match initial ORDER BY expressions")
        var used: []bool = array(len(dt), false)
        var skipped = false
        for o in order {
            let ot = outText(&o, &exprs, &outs, &q.cols)
            var m = false
            for j in 0..len(dt) {
                if dt[j] == ot {
                    used[j] = true
                    m = true
                }
            }
            if m {
                if skipped { return Err(bad) }
                donKey += 1
            } else {
                skipped = true
            }
        }
        for j in 0..len(dt) {
            if used[j] { continue }
            if skipped { return Err(bad) }
            for k in j..len(dt) { if dt[k] == dt[j] { used[k] = true } }
            var r = try lexdb_bind.resolveOrder(&s.distinctOn[j], &q.cols, &outs, mut &sc.names)
            match try enumOf(st, txn, &r, &q.cols) {
                Some(en) { r = enumPos(&r, &en) }
                None {}
            }
            append(mut &order, r)
            donKey += 1
            added += 1
        }
    }
    // ORDER BY as resolved (DISTINCT ON's keys added): the plan's Sort's
    // keys, read in place and set aside by the planner's first rewrite as
    // the select list is (bo); where none runs, the Sort's are [] and
    // Sel.order is the list (lexdb_bind.lpLentOrder)
    var bo: []Expr = []
    var oRewritten = false
    var having: Option[Expr] = None
    match s.having {
        Some(h) { having = Some(try lexdb_bind.resolve(&h, &q.cols, len(q.cols), mut &sc.names)) }
        None {}
    }
    // HAVING as resolved: the plan's Filter's (bh), moved there by the
    // planner's rewrite (collectAggs), which always runs where it is
    var bh: Option[Expr] = None
    // window calls (9.46): not where rows are chosen or grouped; their
    // definitions merged with the named windows and resolved
    // (the plan's Window's as resolved: bw, set aside where the planner's
    // collectAggs pass builds its own, else moved after winPlan has read them)
    var wdefs: []lexdb_sql.WinDef = []
    var bw: []lexdb_sql.WinDef = []
    if len(s.wins) > 0 {
        if hasWinOpt(&s.where) { return Err(e("42P20", "window functions are not allowed in WHERE")) }
        if hasWinOpt(&s.having) { return Err(e("42P20", "window functions are not allowed in HAVING")) }
        for g in groupBy { if hasWin(&g) { return Err(e("42P20", "window functions are not allowed in GROUP BY")) } }
        for f in s.from { if hasWinOpt(&f.on) { return Err(e("42P20", "window functions are not allowed in JOIN conditions")) } }
        for w in s.wins {
            let d = try mergeWin(&w, &s.windows, 0)
            var r = lexdb_sql.WinDef{call: try lexdb_bind.resolve(&d.call, &q.cols, len(q.cols), mut &sc.names), ref: "", bare: false, part: [], order: [],
                                     frame: cloneFrame(&d.frame)}
            // partitions and the window's order under their collations (L2): by keys
            for x in d.part {
                let rx = try lexdb_bind.resolve(&x, &q.cols, len(q.cols), mut &sc.names)
                append(mut &r.part, lexdb_bind.collKeyOf(lexdb_bind.exprKind(&rx, &q.cols, &sc.names), rx))
            }
            for o in d.order {
                let ro = try lexdb_bind.resolve(&o.expr, &q.cols, len(q.cols), mut &sc.names)
                append(mut &r.order, lexdb_sql.WinOrder{expr: lexdb_bind.collKeyOf(lexdb_bind.exprKind(&ro, &q.cols, &sc.names), ro), desc: o.desc, nullsFirst: o.nullsFirst})
            }
            var inDef = false
            for x in r.part { if hasWin(&x) { inDef = true } }
            for o in r.order { if hasWin(&o.expr) { inDef = true } }
            if inDef { return Err(e("42P20", "window functions are not allowed in window definitions")) }
            if hasWin(&r.call) { return Err(e("42P20", "window function calls cannot be nested")) }
            append(mut &wdefs, r)
        }
        var mx: []Expr = []
        for x in exprs { append(mut &mx, winMarks(&x)) }
        rewriteList(mut &exprs, mx, mut &bx, mut &xRewritten)
        var mo: []Expr = []
        for x in order { append(mut &mo, winMarks(&x)) }
        rewriteList(mut &order, mo, mut &bo, mut &oRewritten)
    }
    endScope(sc, mut &q)
    var aggQ = len(groupBy) > 0 || having.isSome() || len(s.gsets) > 0
    if len(s.gsets) > 0 && len(wdefs) > 0 { return Err(e("0A000", "lexdb: window functions with ROLLUP, CUBE or GROUPING SETS are not supported")) }
    for x in exprs { if hasAgg(&x) { aggQ = true } }
    for x in order { if hasAgg(&x) { aggQ = true } }
    for d in wdefs { if winHasAgg(&d) { aggQ = true } }
    if aggQ && s.lockMode > 0 { return Err(e("0A000", &(lexdb_sql.lockName(s.lockMode) + " is not allowed with aggregate functions"))) }
    if s.distinct {
        // SELECT DISTINCT: ORDER BY may use only what it outputs
        for o in order {
            var ok = false
            match o {
                Expr.Lit(v) { match v { Val.Int(_) { ok = true } else {} } }
                Expr.Col(n, sl) { if lexdb_bind.colSlot(&q.cols, &n, sl) < 0 { ok = true } }
                else {}
            }
            let t = lexdb_sql.exprText(&o)
            for x in exprs { if lexdb_sql.exprText(&x) == t { ok = true } }
            if !ok { return Err(e("42P10", "for SELECT DISTINCT, ORDER BY expressions must appear in select list")) }
        }
    }
    // T-SQL's TOP n PERCENT and WITH TIES: no limit while running, the n kept for the end
    let n0 = try evalInt(&s.limit, params, if s.topMode != 0 { "TOP" } else { "LIMIT" }, mut &sc.looks)
    let topN = if s.topMode != 0 { n0 } else { -1 }
    let limit = if s.topMode != 0 { -1 } else { n0 }
    let offset = try evalInt(&s.offset, params, "OFFSET", mut &sc.looks)
    var sort = len(order) > 0
    var first = -1
    // The first table's order holds through the joins, unless a RIGHT or
    // FULL JOIN adds its unmatched rows at the end.
    var keeps = len(q.levels) > 0 && !q.levels[0].virt()
    for lv in q.levels { if keepsRight(lv.join) { keeps = false } }
    // DISTINCT ON and WITH TIES sort (9.94): their keys are the sort's values
    if len(s.distinctOn) > 0 || s.withTies { keeps = false }
    var setIndex = -2               // the first table's path, changed: its index, its direction
    var setDesc = false
    var setNoNulls = false
    if keeps {
        let t = &q.levels[0].t
        let path = &q.levels[0].path
        var cols: []int = []
        var dir = -1
        var mm = -1
        if !aggQ {
            dir = orderCols(&q, &order, &s.order, &exprs, &outs, mut &cols)
        } else if len(groupBy) == 0 {
            var d = 0
            mm = minMax(&q, &exprs, mut &d)
            if mm >= 0 {
                append(mut &cols, mm)
                dir = d
            }
        }
        if dir >= 0 {
            var ix = path.index
            var use = servesOrder(t, path, &cols)
            let full = len(path.eqs) == 0 && len(path.rng) == 0 && len(path.ins) == 0 && path.inSub < 0 && len(path.inArr) == 0
            // A full scan changes to an index for its order only when that
            // saves reading everything: a LIMIT, or MIN/MAX; or when the
            // index holds every column the table's rows give (read alone,
            // 9.107: no row read, and no sort). Else a sort is cheaper than
            // a lookup per row.
            if !use && full {
                match orderedScan(&q, &cols, params, mut &sc.looks) {
                    Some(x) {
                        if limit >= 0 || mm >= 0 || ixCovers(&q.levels[0], x) {
                            ix = x
                            use = true
                        }
                    }
                    None {}
                }
            }
            if use {
                setIndex = ix
                setDesc = dir == 1
                if mm >= 0 {
                    first = mm + q.levels[0].first        // its place in the joined row
                    // MIN and MAX skip NULLs: an index whose next column it is need not read them
                    let key = keyCols(t, ix)
                    setNoNulls = ix >= 0 && len(path.eqs) < len(key) && key[len(path.eqs)] == mm
                } else {
                    sort = false
                }
            }
        }
    }
    if setIndex > -2 {
        q.levels[0].path.index = setIndex
        q.levels[0].path.desc = setDesc
        q.levels[0].path.noNulls = setNoNulls
        q.levels[0].keeps = true
        let er = pathEst(&q.levels[0], &q.levels[0].path, params)
        q.levels[0].estRows = er.rows
        q.levels[0].estMax = er.bound
    }
    // a LIMIT may stop the first table's reading early, unless a sort or the
    // grouping reads it all first: the switch stays off (optimizer 19)
    if limit >= 0 && !aggQ && !sort && len(q.levels) > 0 { q.levels[0].stops = true }
    if setIndex == -2 { orderLookups(mut &q) }
    // A grouped query: its aggregate calls become accumulators, and its
    // columns must be grouped.
    var specs: []AggSpec = []
    var gx: [][]Expr = []               // grouping sets (9.94): per set, exprs, order and having
    var gord: [][]Expr = []
    var gh: []Option[Expr] = []
    if aggQ {
        var rx: []Expr = []
        for x in exprs { append(mut &rx, try collectAggs(&x, mut &specs)) }
        rewriteList(mut &exprs, rx, mut &bx, mut &xRewritten)
        // min, max and DISTINCT compare under their argument's collation (L2)
        for i in 0..len(specs) { if len(specs[i].args) > 0 { specs[i].kind = lexdb_bind.exprKind(&specs[i].args[0], &q.cols, &sc.names) } }
        var ro: []Expr = []
        for x in order { append(mut &ro, try collectAggs(&x, mut &specs)) }
        rewriteList(mut &order, ro, mut &bo, mut &oRewritten)
        var rh: Option[Expr] = None
        match having {
            Some(h) { rh = Some(try collectAggs(&h, mut &specs)) }
            None {}
        }
        bh = replace(mut &having, rh)
        // a window's arguments, partitions and order: over the groups, their
        // aggregates in slots (new definitions; the resolved ones go to bw)
        if len(wdefs) > 0 {
            var cw: []lexdb_sql.WinDef = withCapacity(len(wdefs))
            for d in wdefs {
                var call: Expr = Expr.Lit(Val.Null)
                match d.call {
                    Expr.Call(f, args, star) {
                        var ca: []Expr = []
                        for a in args { append(mut &ca, try collectAggs(&a, mut &specs)) }
                        call = Expr.Call(f.clone(), ca, star)
                    }
                    else { call = lexdb_sql.cloneExpr(&d.call) }
                }
                var wp: []Expr = []
                for x in d.part { append(mut &wp, try collectAggs(&x, mut &specs)) }
                var wo: []lexdb_sql.WinOrder = []
                for o in d.order { append(mut &wo, lexdb_sql.WinOrder{expr: try collectAggs(&o.expr, mut &specs), desc: o.desc, nullsFirst: o.nullsFirst}) }
                append(mut &cw, lexdb_sql.WinDef{call: call, ref: d.ref.clone(), bare: d.bare, part: wp, order: wo, frame: cloneFrame(&d.frame)})
            }
            bw = replace(mut &wdefs, cw)
        }
        var gtexts: []str = []
        for g in groupBy { append(mut &gtexts, lexdb_sql.exprText(&g)) }
        var okLevels: []bool = []
        for lv in q.levels {
            var all = true
            for c in lv.t.pk {
                let name = lv.alias + "." + lv.t.cols[c].name
                var found = false
                for g in groupBy {
                    match g {
                        Expr.Col(n, _) { if n == name { found = true } }
                        else {}
                    }
                }
                if !found { all = false }
            }
            append(mut &okLevels, all && len(groupBy) > 0 && len(lv.t.pk) > 0 && len(s.gsets) == 0)
        }
        for x in exprs { try checkGrouped(&x, &gtexts, &okLevels, &q) }
        for x in order { try checkGrouped(&x, &gtexts, &okLevels, &q) }
        match having {
            Some(h) { try checkGrouped(&h, &gtexts, &okLevels, &q) }
            None {}
        }
        for d in wdefs {
            match d.call {
                Expr.Call(_, args, _) { for a in args { try checkGrouped(&a, &gtexts, &okLevels, &q) } }
                else {}
            }
            for x in d.part { try checkGrouped(&x, &gtexts, &okLevels, &q) }
            for o in d.order { try checkGrouped(&o.expr, &gtexts, &okLevels, &q) }
        }
        // GROUPING() and the grouping sets (9.94): per set, the expressions
        // with those grouped by but not in the set NULL, and GROUPING() its
        // bits; plain GROUP BY is one set of all
        var sets: [][]int = []
        for gset in s.gsets { append(mut &sets, collections.copyOf(&gset)) }
        if len(sets) == 0 {
            var all: []int = []
            for i in 0..len(groupBy) { append(mut &all, i) }
            append(mut &sets, all)
        }
        for gset in sets {
            var ins: []str = []
            for i in gset { if i < len(gtexts) { append(mut &ins, gtexts[i].clone()) } }
            var sx: []Expr = []
            for x in exprs { append(mut &sx, try setSubst(&x, &gtexts, &ins)) }
            var so: []Expr = []
            for x in order { append(mut &so, try setSubst(&x, &gtexts, &ins)) }
            var sh: Option[Expr] = None
            match having {
                Some(h) { sh = Some(try setSubst(&h, &gtexts, &ins)) }
                None {}
            }
            append(mut &gx, sx)
            append(mut &gord, so)
            append(mut &gh, sh)
        }
        if len(s.gsets) == 0 {
            // one set: the expressions themselves
            exprs = replace(mut &gx[0], [])
            order = replace(mut &gord[0], [])
            having = replace(mut &gh[0], None)
            gx = []
            gord = []
            gh = []
            // A table whose primary key is grouped has one row per group of
            // it: its other columns grouped by are the same in every row of
            // a group, and need not be in the group's key (PostgreSQL's
            // remove_useless_groupby_columns). The group's first row still
            // gives their values. (q10 groups by c_custkey and six other
            // customer columns, three of them long texts.)
            var gb: []Expr = []
            var gk: []int = []
            for gi in 0..len(groupBy) {
                var redundant = false
                match groupBy[gi] {
                    Expr.Col(n, sl) {
                        let ci = lexdb_bind.colSlot(&q.cols, &n, sl)
                        for li in 0..len(q.levels) {
                            let lv = &q.levels[li]
                            if !okLevels[li] || ci < lv.first || ci >= lv.first + len(lv.t.cols) { continue }
                            redundant = !hasIdx(&lv.t.pk, ci - lv.first)
                        }
                    }
                    else {}
                }
                if !redundant {
                    append(mut &gb, lexdb_sql.cloneExpr(&groupBy[gi]))
                    append(mut &gk, groupKinds[gi])
                }
            }
            bg = replace(mut &groupBy, gb)
            groupKinds = gk
        } else {
            bg = lexdb_sql.cloneAllExpr(&groupBy)
        }
    } else {
        for x in exprs { if hasGrouping(&x) { return Err(e("42803", "arguments to GROUPING must be grouping expressions of the associated query level")) } }
        for x in order { if hasGrouping(&x) { return Err(e("42803", "arguments to GROUPING must be grouping expressions of the associated query level")) } }
    }
    // the window values' slots follow the aggregates'
    let nAggs = len(specs)
    var wins: []WinPlan = []
    if len(wdefs) > 0 {
        var wx: []Expr = []
        for x in exprs { append(mut &wx, winSlots(&x, nAggs)) }
        rewriteList(mut &exprs, wx, mut &bx, mut &xRewritten)
        var wo: []Expr = []
        for x in order { append(mut &wo, winSlots(&x, nAggs)) }
        rewriteList(mut &order, wo, mut &bo, mut &oRewritten)
        for d in wdefs { append(mut &wins, try winPlan(&d)) }
        if len(bw) == 0 { bw = replace(mut &wdefs, []) }
    }
    // FOR UPDATE and the like (9.86): each locked table's key read with
    // the output, after it (where no rewrite ran, after the resolved list:
    // the Project's are the first nOut)
    let nOut = len(exprs)
    var locks: []SelLock = []
    for k in 0..len(q.levels) {
        if q.levels[k].lock == 0 { continue }
        let at = len(exprs)
        for p in q.levels[k].t.pk { append(mut &exprs, Expr.Col(q.cols[q.levels[k].first + p].name.clone(), -1)) }
        append(mut &locks, SelLock{level: k, at: at, n: len(exprs) - at, mode: q.levels[k].lock, wait: q.levels[k].lockWait})
    }
    var desc: []bool = []
    var nullsFirst: []bool = []
    for o in s.order {
        append(mut &desc, o.desc)
        append(mut &nullsFirst, o.nullsFirst)
    }
    for i in 0..added {
        append(mut &desc, false)
        append(mut &nullsFirst, false)
    }
    // FOR UPDATE and the like: a Lock over the FROM and WHERE part, with
    // the levels applyLocks locks
    var base = replace(mut &q.lp, lexdb_bind.noPlan())
    if s.lockMode > 0 && !noLp {
        var lv: []int = []
        for k in 0..len(q.levels) { if q.levels[k].lock != 0 { append(mut &lv, k) } }
        base = lexdb_bind.LPlan.Lock(base, s.lockMode, s.lockWait, lv, [])
    }
    let lp = if noLp { lexdb_bind.noPlan() }
             else { selPlan(base, s, if xRewritten { replace(mut &bx, []) } else { [] }, &outs, aggQ, bg,
                            len(specs), bh, bw, lpOn, if oRewritten { replace(mut &bo, []) } else { [] }, collections.copyOf(&desc),
                            collections.copyOf(&nullsFirst)) }
    return Ok(Sel{q: q, exprs: exprs, outs: outs, groupBy: groupBy, order: order, aggQ: aggQ, sort: sort,
                  first: first, limit: limit, offset: offset, having: having, specs: specs, distinct: s.distinct, desc: desc, nullsFirst: nullsFirst,
                  parts: [], setop: 0, setAll: false, split: 0, rec: -1, srf: s.srf.clone(), ordin: s.ordin, wins: wins, nAggs: nAggs,
                  locks: locks, nOut: nOut, donKey: donKey, withTies: s.withTies, gsets: copySets(&s.gsets), gx: gx, gord: gord, gh: gh,
                  groupKinds: groupKinds, ordKinds: ordKinds, outKinds: outKindsOf(&outs),
                  topMode: s.topMode, topN: topN, feedback: if aggQ || s.distinct || len(wins) > 0 { [] } else { feedbackOf(s, &exprs) }, mr: [], conv: [], ox: [], oxParam: false, lp: lp, pipe: None})
}

// The outputs of a SELECT as a logical operator's columns (lexdb_bind.outBCol),
// each with the typmod a query reading it gives its column (outType's).
fn outBCols(outs: &[]OutCol): []lexdb_bind.BCol {
    var out: []lexdb_bind.BCol = withCapacity(len(outs))
    for i in 0..len(outs) {
        // (a typmod only from a dialect's wire hint: outType's, as buildQuery's row column has it)
        let mod = if lexdb_syscat.hintCode(outs[i].scale) > 0 { lexdb_bind.tyOf(&outType(&outs[i]), &outs[i].coll, false).mod } else { -1 }
        append(mut &out, lexdb_bind.outBCol(i, &outs[i], mod))
    }
    return out
}

// A planner's rewrite of a list the binder resolved (planSelect's select
// list): nx, built from xs, becomes xs; the first time, the resolved list
// goes to keep (for the plan) and done is set.
fn rewriteList(xs: mut &[]Expr, nx: []Expr, keep: mut &[]Expr, done: mut &bool) {
    if done {
        xs = nx
        return
    }
    keep = replace(xs, nx)
    done = true
}

// sel's plan, taken out of it (a FROM subquery's, a view's, a set
// operation's side) or before its lists change (hashSub): whole, the
// Project's list and the Sort's keys copies of the Sel's where the plan
// lends them (lpLentExprs, lpLentOrder).
fn takeLp(sel: mut &Sel): lexdb_bind.LPlan {
    let lp = replace(mut &sel.lp, lexdb_bind.noPlan())
    let n = lexdb_bind.lpLentExprs(&lp)
    let lentOrder = lexdb_bind.lpLentOrder(&lp)
    if n < 0 && !lentOrder { return lp }
    var xs: []Expr = []
    if n > 0 {
        xs = withCapacity(n)
        for i in 0..n { append(mut &xs, lexdb_sql.cloneExpr(&sel.exprs[i])) }
    }
    return lexdb_bind.lpRestore(lp, xs, if lentOrder { lexdb_sql.cloneAllExpr(&sel.order) } else { [] })
}

// A SELECT's logical plan (Sel.lp) over its FROM and WHERE's (base): its
// clauses as resolved (before the planner's rewrites); exprs and order []
// where they are the Sel's (lexdb_bind.lpLentExprs, lpLentOrder).
fn selPlan(base: lexdb_bind.LPlan, s: &lexdb_sql.Stmt, exprs: []Expr, outs: &[]OutCol, aggQ: bool, group: []Expr, nAggs: int,
           having: Option[Expr], wins: []lexdb_sql.WinDef, on: []Expr, order: []Expr, desc: []bool, nullsFirst: []bool): lexdb_bind.LPlan {
    var lp = base
    if aggQ { lp = lexdb_bind.LPlan.Agg(lp, group, copySets(&s.gsets), nAggs, []) }
    if having.isSome() { lp = lexdb_bind.LPlan.Filter(lp, [having.unwrap()], []) }
    if len(wins) > 0 { lp = lexdb_bind.LPlan.Window(lp, wins, []) }
    lp = lexdb_bind.LPlan.Project(lp, exprs, outBCols(outs))
    if s.distinct || len(on) > 0 { lp = lexdb_bind.LPlan.Distinct(lp, on, []) }
    return topPlan(lp, s, order, desc, nullsFirst)
}

// ORDER BY and LIMIT over lp: a Sort where there are keys (desc's; order
// [] where they are the Sel's, lexdb_bind.lpLentOrder).
fn topPlan(base: lexdb_bind.LPlan, s: &lexdb_sql.Stmt, order: []Expr, desc: []bool, nullsFirst: []bool): lexdb_bind.LPlan {
    var lp = base
    if len(desc) > 0 { lp = lexdb_bind.LPlan.Sort(lp, order, desc, nullsFirst, []) }
    if s.limit.isSome() || s.offset.isSome() || s.withTies {
        lp = lexdb_bind.LPlan.Limit(lp, optClone(&s.limit), optClone(&s.offset), s.withTies, s.topMode, [])
    }
    return lp
}

// UNION, INTERSECT, EXCEPT: its two queries, planned on their own; the
// whole has their output (the first's names), ORDER BY over that output,
// LIMIT and OFFSET. A recursive CTE's second query reads the working table,
// with the first's columns.
fn planSet(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val,
           sc: mut &Scope): Result[Sel, DbErr] {
    if len(s.wins) > 0 { return Err(e("0A000", "lexdb: window functions in the ORDER BY of a UNION, INTERSECT or EXCEPT are not supported")) }
    var l = try planSelect(st, txn, &s.inner[0], params, sc)
    if s.rec {
        var cols: []lexdb_sql.ColDef = []
        for o in l.outs {
            var c = lexdb_sql.colDef(&o.name, lexdb_sql.oidType(o.oid), false)
            c.spell = o.spell.clone()
            c.coll = o.coll.clone()
            append(mut &cols, c)
        }
        append(mut &sc.works, Work{id: s.cte, cols: cols})
    }
    let rr = planSelect(st, txn, &s.inner[1], params, sc)
    if s.rec { let w = pop(mut &sc.works) }
    var r = try rr
    let what = if s.setop == lexdb_sql.SET_UNION { "UNION" } else if s.setop == lexdb_sql.SET_INTERSECT { "INTERSECT" } else { "EXCEPT" }
    if len(l.outs) != len(r.outs) { return Err(e("42601", &("each " + what + " query must have the same number of columns"))) }
    var outs: []OutCol = []
    for o in l.outs { append(mut &outs, o.clone()) }
    for i in 0..len(outs) { if len(outs[i].coll) == 0 { outs[i].coll = r.outs[i].coll.clone() } }
    // each column of the type of both sides' values (lexdb_bind.commonOid),
    // the side of another type converted (runSet); of different categories,
    // or in a recursive CTE, the first side's as before
    var conv: []int = []
    if !s.rec {
        let ty = typing()
        for i in 0..len(outs) {
            let lo = branchOid(&s.inner[0], &l, i)
            let ro = branchOid(&s.inner[1], &r, i)
            let o = lexdb_bind.commonOid(&ty, &[lo, ro])
            var bits = 0
            if o != 0 {
                if o != outs[i].oid {
                    outs[i].scale = if r.outs[i].oid == o { r.outs[i].scale } else { -1 }
                    outs[i].oid = o
                }
                if lexdb_bind.converts(&ty, lo, o) { bits = bits | 1 }
                if lexdb_bind.converts(&ty, ro, o) { bits = bits | 2 }
            }
            append(mut &conv, bits)
        }
    }
    var order: []Expr = []
    var ordKinds: []int = []
    for o in s.order {
        append(mut &ordKinds, outRefKind(&o.expr, &outs))
        var ok = false
        match o.expr {
            Expr.Lit(v) { match v { Val.Int(n) { ok = n >= 1 && n <= len(outs) } else {} } }
            Expr.Col(n, _) { for oc in outs { if oc.name == n { ok = true } } }
            else {}
        }
        if !ok { return Err(e("42P10", &("invalid " + what + " ORDER BY clause: name or number an output column"))) }
        append(mut &order, lexdb_sql.cloneExpr(&o.expr))
    }
    var desc: []bool = []
    var nullsFirst: []bool = []
    for o in s.order {
        append(mut &desc, o.desc)
        append(mut &nullsFirst, o.nullsFirst)
    }
    var refs = lexdb_sql.cloneAllExpr(&l.q.refs)
    for x in r.q.refs { append(mut &refs, lexdb_sql.cloneExpr(&x)) }
    let split = len(l.q.refs)
    let limit = try evalInt(&s.limit, params, "LIMIT", mut &sc.looks)
    let offset = try evalInt(&s.offset, params, "OFFSET", mut &sc.looks)
    let q = Query{levels: [], cols: [], top: [], subs: [], base: sc.names.base, corr: false, refs: refs, implied: false, colAt: newMap(), pinned: false, noRefKeys: false, cc: [], cp: [], lp: lexdb_bind.noPlan(), jp: None}
    let lpl = takeLp(mut &l)
    let lpr = takeLp(mut &r)
    let set = if s.rec { lexdb_bind.LPlan.Recursive(s.cte, lpl, lpr, outBCols(&outs)) }
              else { lexdb_bind.LPlan.SetOp(s.setop, s.setAll, lpl, lpr, outBCols(&outs)) }
    // the Sort lends its keys (Sel.order, lexdb_bind.lpLentOrder)
    let lp = topPlan(set, s, [], collections.copyOf(&desc), collections.copyOf(&nullsFirst))
    return Ok(Sel{q: q, exprs: [], outs: outs, groupBy: [], order: order, aggQ: false, sort: len(order) > 0, first: -1,
                  limit: limit, offset: offset, having: None, specs: [], distinct: false, desc: desc, nullsFirst: nullsFirst, parts: [l, r],
                  setop: s.setop, setAll: s.setAll, split: split, rec: if s.rec { s.cte } else { -1 }, srf: "", ordin: false,
                  wins: [], nAggs: 0, locks: [], nOut: len(outs), donKey: 0, withTies: s.withTies, gsets: [], gx: [], gord: [], gh: [],
                  groupKinds: [], ordKinds: ordKinds, outKinds: outKindsOf(&outs),
                  topMode: 0, topN: -1, feedback: [], mr: [], conv: conv, ox: [], oxParam: false, lp: lp, pipe: None})
}

// The type of a set operation's side's i-th column for its common type:
// 705 for an untyped literal ('x', NULL) in a plain select list, else its
// planned type.
fn branchOid(s: &lexdb_sql.Stmt, sel: &Sel, i: int): int {
    if s.setop == 0 && i < len(s.items) {
        var star = false
        for it in s.items { if it.star { star = true } }
        if !star {
            match s.items[i].expr {
                Some(x) { if lexdb_bind.isUnknownLit(&x) { return lexdb_sql.OID_UNKNOWN } }
                None {}
            }
        }
    }
    return sel.outs[i].oid
}

// A set operation's side's rows with the values of the columns whose
// conv has bit converted to the operation's types.
fn convRows(rows: mut &[][]Val, sel: &Sel, bit: int, z: &lexdb_time.Zone): Result[Unit, DbErr] {
    for c in 0..len(sel.conv) {
        if (sel.conv[c] & bit) == 0 { continue }
        let t = lexdb_sql.oidType(sel.outs[c].oid)
        for i in 0..len(rows) { rows[i][c] = try lexdb_ops.coerceZ(replace(mut &rows[i][c], Val.Null), &t, z) }
    }
    return Ok(Unit{})
}

// A row's key for UNION and the like (NULLs alike; 2 = 2.0).
fn rowKey(vs: &[]Val): str {
    var kb = ""
    for v in vs { lexdb_pipe.keyPart(mut &kb, &v) }
    return kb
}

// A SELECT @v = ... whose expressions read what it assigns: its
// parameters, per output column; [] none.
fn feedbackOf(s: &lexdb_sql.Stmt, exprs: &[]Expr): []int {
    if len(s.assignAt) == 0 { return [] }
    var reads = false
    for x in exprs { for k in s.assignAt { if k > 0 && usesParam(&x, k) { reads = true } } }
    if !reads { return [] }
    var out: []int = []
    for k in s.assignAt { append(mut &out, k) }
    return out
}

fn usesParam(x: &Expr, k: int): bool {
    match x {
        Expr.Param(n) { return n == k }
        Expr.Unary(_, a) { return usesParam(&a, k) }
        Expr.Bin(_, a, b) { return usesParam(&a, k) || usesParam(&b, k) }
        Expr.IsNull(a, _) { return usesParam(&a, k) }
        Expr.Cast(a, _) { return usesParam(&a, k) }
        Expr.Call(_, args, _) {
            for a in args { if usesParam(&a, k) { return true } }
            return false
        }
        else { return false }
    }
}

// An ORDER BY value under its item's collation.
fn ordVal(sel: &Sel, i: int, v: Val): Val { return if i < len(sel.ordKinds) { lexdb_sort.collVal(sel.ordKinds[i], &v) } else { v } }

fn valsKeyIn(vs: &[]Val, kinds: &[]int): str {
    var kb = ""
    for i in 0..len(vs) { lexdb_access.encIdxPart(mut &kb, &(if i < len(kinds) { lexdb_sort.collVal(kinds[i], &vs[i]) } else { vs[i].clone() })) }
    return kb
}

// The collation kinds of a query's output columns.
fn outKindsOf(outs: &[]OutCol): []int {
    var out: []int = []
    for o in outs { append(mut &out, if lexdb_bind.isTextOid(o.oid) { lexdb_sql.collKind(&o.coll) } else { lexdb_sql.COLL_EXACT }) }
    return out
}

// ORDER BY's item as an output column (a number, a name): its kind.
fn outRefKind(x: &Expr, outs: &[]OutCol): int {
    let ks = outKindsOf(outs)
    match x {
        Expr.Lit(v) { match v { Val.Int(n) { if n >= 1 && n <= len(ks) { return ks[n - 1] } } else {} } }
        Expr.Col(n, _) { for i in 0..len(outs) { if outs[i].name == n { return ks[i] } } }
        else {}
    }
    return lexdb_sql.COLL_EXACT
}

// The rows of a UNION, INTERSECT or EXCEPT: each query with the statement's
// parameters and its own refs.
fn runSet(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val,
          rs: mut &Run): Result[[][]Val, DbErr] {
    let base = sel.q.base
    var lp: []Val = []
    var rp: []Val = []
    for j in 0..base {
        append(mut &lp, params[j].clone())
        append(mut &rp, params[j].clone())
    }
    for j in base..base + sel.split { append(mut &lp, params[j].clone()) }
    for j in base + sel.split..len(params) { append(mut &rp, params[j].clone()) }
    if sel.rec >= 0 { return runRecursive(st, txn, sel, &lp, &rp, rs) }
    var lres = try runChild(st, txn, &sel.parts[0], &lp, -1, rs, 0)
    try convRows(mut &lres.rows, sel, 1, &txn.sql.zone)
    try rs.bud.hold(lexdb_pipe.rowsBytes(&lres.rows))
    var rres = try runChild(st, txn, &sel.parts[1], &rp, -1, rs, 1)
    try convRows(mut &rres.rows, sel, 2, &txn.sql.zone)
    try rs.bud.hold(lexdb_pipe.rowsBytes(&rres.rows))
    return Ok(lexdb_setop.combine(sel.setop, sel.setAll, replace(mut &lres.rows, []), replace(mut &rres.rows, []), &sel.outKinds))
}

// Whether a set operation's rows can go to a sink as its parts make them:
// with no coercion of a part's values, no lock, MATCH_RECOGNIZE, recursion
// or WITH TIES (those need every row first). ORDER BY goes through a sort
// fed by the parts (runSetSorted); OFFSET skips rows as they come.
fn streamsSet(sel: &Sel): bool {
    if sel.rec >= 0 || sel.withTies || len(sel.locks) > 0 || len(sel.mr) > 0 { return false }
    for c in sel.conv { if c != 0 { return false } }
    return true
}

// The parameters a set operation's part i reads: the statement's shared
// ones, then its own (the split).
fn setParamsOf(sel: &Sel, params: &[]Val, i: int): []Val {
    let base = sel.q.base
    var out: []Val = []
    for j in 0..base { append(mut &out, params[j].clone()) }
    if i == 0 {
        for j in base..base + sel.split { append(mut &out, params[j].clone()) }
    } else {
        for j in base + sel.split..len(params) { append(mut &out, params[j].clone()) }
    }
    return out
}

// What lexdb_setop needs of a set operation to run it streamed: sh.held is
// what the statement holds before it.
fn setopSpec(sel: &Sel, mem: int, held: int): lexdb_setop.Spec {
    var outs: []OutCol = []
    for oc in sel.outs { append(mut &outs, oc.clone()) }
    var order: []Expr = []
    for o in sel.order { append(mut &order, lexdb_sql.cloneExpr(&o)) }
    return lexdb_setop.Spec{setop: sel.setop, setAll: sel.setAll, limit: sel.limit, offset: sel.offset, outs: outs,
                            outKinds: collections.copyOf(&sel.outKinds), order: order, desc: collections.copyOf(&sel.desc),
                            nullsFirst: collections.copyOf(&sel.nullsFirst), ordKinds: collections.copyOf(&sel.ordKinds),
                            mem: mem, held: held}
}

// Part i of a set operation run as a SELECT given to sink, with the
// parameters it reads, from what the statement's runs share (sh: its CTEs'
// rows, run once) holding `held` bytes; the rows it held (lexdb_setop's
// hook for running a part).
fn setPartRun(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, lim: Limits, i: int, held: int,
              sink: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool, sh: mut &Share): Result[[][]Val, DbErr] {
    let ps = setParamsOf(sel, params, i)
    sh.held = held
    let r = runSelToIn(st, txn, &sel.parts[i], &ps, lim, sink, sh)
    match r {
        Ok(res) { return Ok(res.rows) }
        Err(x) { return Err(x) }
    }
}

// The result of a streamed set operation: the rows lexdb_setop did not give, n rows in all.
fn setRes(sel: &Sel, rows: [][]Val, n: int): Res {
    var outs: []OutCol = []
    for oc in sel.outs { append(mut &outs, oc.clone()) }
    return Res{cols: outs, rows: rows, tag: "SELECT " + n.toStr(), hasRows: true, copy: COPY_NONE}
}

// A recursive CTE: the first query's rows, then rounds of the second over
// the rows the last round added (the working table) until a round adds
// none; with UNION (not ALL), rows seen before are not added.
fn runRecursive(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, lp: &[]Val, rp: &[]Val,
                rs: mut &Run): Result[[][]Val, DbErr] {
    let key = "w" + sel.rec.toStr()
    var seen: Map[str, int] = newMap()
    var lres = try runChild(st, txn, &sel.parts[0], lp, -1, rs, 0)
    var work = replace(mut &lres.rows, [])
    if !sel.setAll { work = lexdb_setop.distinctRows(work, mut &seen, &sel.outKinds) }
    var out: [][]Val = []
    // max_recursion: rounds that add rows (the last round, adding none, is free)
    var rounds = 0
    while len(work) > 0 {
        try rs.bud.tick()
        try rs.bud.hold(lexdb_pipe.rowsBytes(&work) * 2)       // kept in the result and as the working table
        for r in work { append(mut &out, collections.copyOf(&r)) }
        cachePut(mut &rs.cache, key.clone(), work)
        var rres = try runChild(st, txn, &sel.parts[1], rp, -1, rs, 1)
        work = replace(mut &rres.rows, [])
        if !sel.setAll { work = lexdb_setop.distinctRows(work, mut &seen, &sel.outKinds) }
        rounds += 1
        if rs.maxRounds > 0 && rounds > rs.maxRounds && len(work) > 0 {
            return Err(e("54001", &("recursive query still adding rows after " + rs.maxRounds.toStr() +
                         " rounds (max_recursion); SET max_recursion = n to allow more, 0 for no limit")))
        }
    }
    return Ok(out)
}

// EXPLAIN's lines for a planned SELECT.
// EXPLAIN's lines for a planned Sel: its operators (physOf), then its
// subqueries'; with counts (EXPLAIN ANALYZE), what each table did.
fn selLines(sel: &Sel, cnt: &[]lexdb_pipe.Counts, stats: &[]SubStat): []str {
    // the pipeline's plan, kept with the Sel; else a view of the Sel's
    match sel.pipe {
        Some(pg) { return planLines(sel, &pg.plan, cnt, stats) }
        None {}
    }
    let p = physOf(sel)
    return planLines(sel, &p, cnt, stats)
}

// selLines over sel's operators p.
fn planLines(sel: &Sel, p: &lexdb_plan.PPlan, cnt: &[]lexdb_pipe.Counts, stats: &[]SubStat): []str {
    if sel.setop != 0 { return setLines(sel, p, stats) }
    var lines: []str = []
    opLines(sel, p, cnt, mut &lines)
    subLines(&sel.q, lexdb_plan.pSubs(p), stats, mut &lines)
    return lines
}

// An operator's line after its input's (a table's each: explainLines),
// MATCH_RECOGNIZE's before them; those that print none: the window calls,
// the select list, a lock, a LIMIT the scan does not stop for.
fn opLines(sel: &Sel, p: &lexdb_plan.PPlan, cnt: &[]lexdb_pipe.Counts, out: mut &[]str) {
    match p {
        lexdb_plan.PPlan.Levels(_, _) { for l in explainLines(&sel.q, cnt) { append(out, l) } }
        // (the pipeline's: its table's line as a level's, its conditions there)
        lexdb_plan.PPlan.Scan(_, _) { for l in explainLines(&sel.q, cnt) { append(out, l) } }
        // (the joins' tables: lines of the Scan's, as levels)
        lexdb_plan.PPlan.Join(i, _) { opLines(sel, &i, cnt, out) }
        lexdb_plan.PPlan.Filter(i, _) { opLines(sel, &i, cnt, out) }
        lexdb_plan.PPlan.Result(_) {
            for l in explainLines(&sel.q, cnt) { append(out, l) }
            append(out, "result")
        }
        lexdb_plan.PPlan.Func(n, ordin, _) {
            for l in explainLines(&sel.q, cnt) { append(out, l) }
            append(out, "function " + n + (if ordin { " with ordinality" } else { "" }))
        }
        lexdb_plan.PPlan.SetOp(_, _, _, _, _) {}           // setLines'
        lexdb_plan.PPlan.MinMax(i) {
            opLines(sel, &i, cnt, out)
            append(out, "min/max: the first value in the scan's order")
        }
        lexdb_plan.PPlan.Agg(i, _, _) {
            opLines(sel, &i, cnt, out)
            append(out, "aggregate")
        }
        lexdb_plan.PPlan.Having(i) {
            opLines(sel, &i, cnt, out)
            append(out, "having")
        }
        lexdb_plan.PPlan.Window(i) { opLines(sel, &i, cnt, out) }
        lexdb_plan.PPlan.Project(i, _) { opLines(sel, &i, cnt, out) }
        lexdb_plan.PPlan.Distinct(i, _, _) {
            opLines(sel, &i, cnt, out)
            append(out, "distinct")
        }
        lexdb_plan.PPlan.Sort(i, sorted, _) {
            opLines(sel, &i, cnt, out)
            append(out, if sorted { "order: sort" } else { "order: the scan's" })
        }
        lexdb_plan.PPlan.Lock(i) { opLines(sel, &i, cnt, out) }
        lexdb_plan.PPlan.Limit(i, stops, _, _) {
            opLines(sel, &i, cnt, out)
            if stops { append(out, "limit: stops the scan") }
        }
        lexdb_plan.PPlan.Match(i) {
            append(out, "match_recognize: " + sel.mr[0].text + "; " + (if sel.mr[0].local { "memo" } else { "steps" }))
            opLines(sel, &i, cnt, out)
        }
    }
}

fn setLines(sel: &Sel, p: &lexdb_plan.PPlan, stats: &[]SubStat): []str {
    var lines: []str = []
    let op = if sel.setop == lexdb_sql.SET_UNION { "union" } else if sel.setop == lexdb_sql.SET_INTERSECT { "intersect" } else { "except" }
    append(mut &lines, (if sel.rec >= 0 { "recursive " } else { "" }) + op + (if sel.setAll { " all" } else { "" }))
    let none: []lexdb_pipe.Counts = []
    let noStats: []SubStat = []
    match lexdb_plan.pLeaf(p) {
        lexdb_plan.PPlan.SetOp(_, _, _, parts, _) {
            for i in 0..len(sel.parts) {
                var head = if sel.rec >= 0 { if i == 0 { "first" } else { "then, per round, over the working table" } } else { "query " + (i + 1).toStr() }
                var inner: []str = []
                if i < len(stats) {
                    head = head + " (runs " + stats[i].runs.toStr() + ")"
                    inner = planLines(&sel.parts[i], &parts[i], &stats[i].cnt, &stats[i].inner)
                } else {
                    inner = planLines(&sel.parts[i], &parts[i], &none, &noStats)
                }
                append(mut &lines, "  " + head + ":")
                for l in inner { append(mut &lines, "    " + l) }
            }
        }
        else {}
    }
    if len(sel.order) > 0 { append(mut &lines, "order: sort") }
    return lines
}

// A SELECT; with analyze, plan gets EXPLAIN ANALYZE's lines (a line per
// table, with what it did). The counts are kept for every query: an add each.
fn selectWith(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
              lim: Limits, analyze: bool, plan: mut &[]str): Result[Res, DbErr] {
    var sc = newScopeIn(st, txn, params, ptypes)
    var sel = try planSelect(st, txn, s, params, mut &sc)
    bindSel(mut &sel)
    pipeSel(mut &sel)
    var rs = newRun(&sel.q)
    rs.limit(&lim)
    let res = try execSel(st, txn, &sel, params, -1, mut &rs)
    if analyze {
        let lines = selLines(&sel, &rs.cnt, &rs.stats)
        for l in move(lines) { append(plan, l) }
    }
    return Ok(res)
}

// An ORDER BY value, running its correlated subqueries.
fn orderX(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, o: &Expr, outs: &[]OutCol, vals: &[]Val,
          env: &Env, rs: mut &Run): Result[Val, DbErr] {
    if q.corr && hasCorr(o) { return evalX(st, txn, q, o, env, rs) }
    return orderValue(o, outs, vals, env)
}

// How ORDER BY places rows with sort values a and b: negative a first.
fn ordCmp(sel: &Sel, a: &[]Val, b: &[]Val): int {
    for i in 0..len(sel.desc) {
        let na = lexdb_ops.isNull(&a[i])
        let nb = lexdb_ops.isNull(&b[i])
        if na && nb { continue }
        if na { return if sel.nullsFirst[i] { -1 } else { 1 } }
        if nb { return if sel.nullsFirst[i] { 1 } else { -1 } }
        var c = lexdb_sort.sortCmp(&a[i], &b[i])
        if sel.desc[i] { c = -c }
        if c != 0 { return c }
    }
    return 0
}

// Top-N (9.52): rows sorted and cut to the first k, in the order the full
// sort gives (sortBy is stable, and the rows kept came before those added
// after them). The last one's sort values, for the rows to come.
fn keepFirst(sel: &Sel, rows: mut &[]OutRow, k: int): []Val {
    sortOutRows(sel, rows)
    while len(rows) > k { let gone = pop(rows) }
    return collections.copyOf(&rows[len(rows) - 1].ord)
}

// The rows in ORDER BY's order (ordCmp's, ties in their order): typed, by
// their sort values as typed keys (9.105); when a key's values are of mixed
// kinds, by collections.sortBy with ordCmp.
fn sortOutRows(sel: &Sel, rows: mut &[]OutRow) {
    let n = len(rows)
    if n > 1 {
        var keys: []lexdb_sort.SKey = []
        var ok = true
        for k in 0..len(sel.desc) {
            var vs: []Val = withCapacity(n)
            for i in 0..n { append(mut &vs, rows[i].ord[k].clone()) }
            var key = lexdb_sort.newSKey(lexdb_sort.SK_VAL, sel.desc[k], sel.nullsFirst[k])
            if !lexdb_sort.skOfVals(vs, sel.desc[k], sel.nullsFirst[k], mut &key) {
                ok = false
                break
            }
            append(mut &keys, key)
        }
        if ok {
            let perm = lexdb_sort.skSort(mut &keys, n)
            var out: []OutRow = withCapacity(n)
            for p in perm { append(mut &out, replace(mut &rows[p], OutRow{vals: [], ord: []})) }
            rows = out
            return
        }
    }
    collections.sortBy(rows, fn(a: &OutRow, b: &OutRow): int { return ordCmp(sel, &a.ord, &b.ord) })
}

// Runs a planned SELECT. cap >= 0: at most that many rows are wanted (a
// subquery: EXISTS 1, in any order; a scalar 2).
fn execSel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int,
           rs: mut &Run): Result[Res, DbErr] {
    if len(sel.mr) > 0 {
        let r = try execSelIn(st, txn, sel, params, -1, rs)
        return execMatch(&sel.mr[0], r, params, rs)
    }
    return execSelIn(st, txn, sel, params, cap, rs)
}

// execSel but MATCH_RECOGNIZE.
fn execSelIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, params: &[]Val, cap: int,
             rs: mut &Run): Result[Res, DbErr] {
    let sqe = seqEnv(st, txn)
    if len(sel.srf) > 0 { return execSrf(st, txn, sel, params, cap, rs) }
    if rs.batch && pipeRows(sel) && !rs.noLimit {
        // (a value a join's batch cannot hold, an expression it does not
        // compile: the row engine, nothing given yet)
        match pipeHeld(st, txn, sel, params, cap, rs) {
            Ok(r) { return Ok(r) }
            Err(x) { if !lexdb_pipe.isBat(&x) { return Err(x) } }
        }
    }
    // (an aggregate the pipeline runs: its conditions are its plan's, not bound per run)
    let pa = rs.batch && pipeAggs(sel)
    var m = try prepareIn(st, txn, &sel.q, params, rs, !pa, !(pa && pipeJoins(sel)))
    let q = &sel.q
    let limit = if rs.noLimit { -1 } else if cap >= 0 && (sel.limit < 0 || cap < sel.limit) { cap } else { sel.limit }
    let offset = if rs.noLimit { -1 } else { sel.offset }
    let sorting = sel.sort && cap != 1
    // correlated subqueries in the output run after the scan, from its rows kept
    var late = false
    if q.corr && !sel.aggQ {
        for x in sel.exprs { if hasCorr(&x) { late = true } }
        if sorting { for x in sel.order { if hasCorr(&x) { late = true } } }
    }
    // with window calls the rows are kept first, then their values made (9.46)
    let windowed = len(sel.wins) > 0
    if windowed && !sel.aggQ { late = true }
    if len(sel.feedback) > 0 { late = true }
    var bases: []WinRow = []
    var outRows: []OutRow = []
    // the rows kept here, counted in the row callbacks (they cannot reach rs)
    let room = rs.bud.room()
    var held = 0
    if sel.setop != 0 {
        var rows = try runSet(st, txn, sel, params, rs)
        let noCols: []lexdb_sql.ColDef = []
        for i in 0..len(rows) {
            let vals = replace(mut &rows[i], [])
            var ord: []Val = []
            if sorting {
                let none: []Val = []
                let env = Env{cols: &noCols, row: &vals, aggs: &none, params: params, subs: &m.subs, cur: &none, seq: &sqe}
                for oi in 0..len(sel.order) { append(mut &ord, ordVal(sel, oi, try orderValue(&sel.order[oi], &sel.outs, &vals, &env))) }
            }
            held += lexdb_pipe.rowBytes(&ord)
            append(mut &outRows, OutRow{vals: vals, ord: ord})
        }
    }
    let rs0max = rs.bud.maxHeld
    let early = !sel.aggQ && !sorting && limit >= 0 && !(late && sel.distinct) && !windowed
    let stopAt = if offset > 0 { limit + offset } else { limit }
    let noAggs: []Val = []
    var seen: Map[str, int] = newMap()      // SELECT DISTINCT
    if sel.setop != 0 {
        // done above
    } else if sel.aggQ {
        // per group: its first row (for grouped columns) and its accumulators
        var gs = Groups{index: newMap(), firsts: [], accs: [], sets: []}
        // A correlated subquery in a GROUP BY key or an aggregate's argument
        // runs per row, which it cannot while the rows are read (runQuery
        // holds the run): the rows are kept, then grouped (9.24).
        let later = q.corr && groupCorr(sel)
        var kept: [][]Val = []
        // over batches of rows when the query allows (9.47), else row by row
        var batched = false
        if !later && rs.batch && pipeAggs(sel) {
            match pipeGroups(st, txn, sel, mut &m, params, rs, mut &gs, if room >= 0 { room - held } else { -1 }) {
                Ok(h) {
                    held += h
                    batched = true
                }
                Err(x) {
                    // a value a join's batch cannot hold: the row engine
                    // (its hashes built now), nothing given yet
                    if !lexdb_pipe.isBat(&x) { return Err(x) }
                    gs = Groups{index: newMap(), firsts: [], accs: [], sets: []}
                    try materialize(st, txn, q, mut &m, params, rs)
                }
            }
        }

        if !batched {
        try runQuery(st, txn, q, &m, params, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
            if sel.first >= 0 && lexdb_ops.isNull(&r[sel.first]) { return Ok(true) }
            if later {
                held += lexdb_pipe.rowBytes(r)
                if room >= 0 && held > room { return Err(lexdb_pipe.memErr(rs0max)) }
                append(mut &kept, collections.copyOf(r))
                return Ok(sel.first < 0)
            }
            let env = Env{cols: &q.cols, row: r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            try addToGroup(sel, mut &gs, r, &env, mut &held, room, rs0max)
            return Ok(sel.first < 0)        // MIN/MAX in order: its first value is the answer
        }, rs)
        }
        for r in kept {
            let env = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            var cur: []Val = array(len(q.subs), Val.Null)
            for x in sel.groupBy { try fillCur(st, txn, q, &x, &env, rs, mut &cur) }
            for sp in sel.specs {
                for a in sp.args { try fillCur(st, txn, q, &a, &env, rs, mut &cur) }
                for o in sp.order { try fillCur(st, txn, q, &o, &env, rs, mut &cur) }
                match sp.filter {
                    Some(f) { try fillCur(st, txn, q, &f, &env, rs, mut &cur) }
                    None {}
                }
            }
            let env2 = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &cur, seq: &sqe}
            try addToGroup(sel, mut &gs, &r, &env2, mut &held, room, rs0max)
        }
        var firsts = replace(mut &gs.firsts, [])
        var accs = replace(mut &gs.accs, [])
        var gsets = replace(mut &gs.sets, [])
        if len(firsts) == 0 && len(sel.groupBy) == 0 && len(sel.gsets) == 0 {
            append(mut &firsts, [])         // no rows, no GROUP BY: one group, empty
            append(mut &accs, lexdb_agg.newAccs(len(sel.specs)))
        }
        if len(firsts) == 0 {
            // no rows: a group for each empty grouping set (9.94)
            for si in 0..len(sel.gsets) {
                if len(sel.gsets[si]) > 0 { continue }
                append(mut &firsts, [])
                append(mut &accs, lexdb_agg.newAccs(len(sel.specs)))
                append(mut &gsets, si)
            }
        }
        for gi in 0..len(firsts) {
            let si = if len(sel.gsets) > 0 { gsets[gi] } else { -1 }
            var vals: []Val = []
            for i in 0..len(sel.specs) { append(mut &vals, try lexdb_agg.finish(&sel.specs[i], &accs[gi][i])) }
            let env = Env{cols: &q.cols, row: &firsts[gi], aggs: &vals, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            if si >= 0 {
                // a grouping set's group: its own expressions
                match sel.gh[si] {
                    Some(h) { if lexdb_ops.truth(&(try evalX(st, txn, q, &h, &env, rs))) != Some(true) { continue } }
                    None {}
                }
                var out: []Val = []
                for x in sel.gx[si] { append(mut &out, try evalX(st, txn, q, &x, &env, rs)) }
                if sel.distinct {
                    let k = valsKey(&out)
                    if seen.get(&k).isSome() { continue }
                    seen.put(k, 1)
                }
                var ord: []Val = []
                if sorting { for o in sel.gord[si] { append(mut &ord, try orderX(st, txn, q, &o, &sel.outs, &out, &env, rs)) } }
                held += lexdb_pipe.rowBytes(&out) + lexdb_pipe.rowBytes(&ord)
                append(mut &outRows, OutRow{vals: out, ord: ord})
                continue
            }
            match sel.having {
                Some(h) { if lexdb_ops.truth(&(try evalX(st, txn, q, &h, &env, rs))) != Some(true) { continue } }
                None {}
            }
            if windowed {
                append(mut &bases, WinRow{row: collections.copyOf(&firsts[gi]), aggs: collections.copyOf(&vals)})
                continue
            }
            var out: []Val = []
            for x in sel.exprs { append(mut &out, try evalX(st, txn, q, &x, &env, rs)) }
            if sel.distinct {
                let k = valsKeyIn(&out, &sel.outKinds)
                if seen.get(&k).isSome() { continue }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for oi in 0..len(sel.order) { append(mut &ord, ordVal(sel, oi, try orderX(st, txn, q, &sel.order[oi], &sel.outs, &out, &env, rs))) } }
            held += lexdb_pipe.rowBytes(&out) + lexdb_pipe.rowBytes(&ord)
            append(mut &outRows, OutRow{vals: out, ord: ord})
        }
    } else if late {
        var raws: [][]Val = []
        // a window's rows straight from the batches of its one table (9.108)
        var fromBatches = false
        if windowed && len(sel.feedback) == 0 { fromBatches = try winBatch(st, txn, q, &m, params, rs, mut &raws, mut &held, room, rs0max) }
        if !fromBatches {
        try runQuery(st, txn, q, &m, params, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
            held += lexdb_pipe.rowBytes(r)
            if room >= 0 && held > room { return Err(lexdb_pipe.memErr(rs0max)) }
            append(mut &raws, collections.copyOf(r))
            return Ok(!early || len(raws) < stopAt)
        }, rs)
        }
        if windowed {
            for i in 0..len(raws) { append(mut &bases, WinRow{row: replace(mut &raws[i], []), aggs: []}) }
        }
        if len(sel.feedback) > 0 {
            // SELECT @v = f(@v, ...): the rows in their order, each one's
            // values the parameters of the next
            var keyed: []OutRow = []
            for i in 0..len(raws) {
                let r = replace(mut &raws[i], [])
                var ord: []Val = []
                if sorting {
                    let env = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
                    let noVals: []Val = []
                    for oi in 0..len(sel.order) { append(mut &ord, ordVal(sel, oi, try orderX(st, txn, q, &sel.order[oi], &sel.outs, &noVals, &env, rs))) }
                }
                append(mut &keyed, OutRow{vals: r, ord: ord})
            }
            if sorting { collections.sortBy(mut &keyed, fn(a: &OutRow, b: &OutRow): int { return ordCmp(sel, &a.ord, &b.ord) }) }
            var pv = collections.copyOf(params)
            for kr in keyed {
                var vals: []Val = []
                {
                    let env = Env{cols: &q.cols, row: &kr.vals, aggs: &noAggs, params: &pv, subs: &m.subs, cur: &noAggs, seq: &sqe}
                    for x in sel.exprs { append(mut &vals, try evalX(st, txn, q, &x, &env, rs)) }
                }
                for i in 0..len(sel.feedback) {
                    let k = sel.feedback[i]
                    if k > 0 && k <= len(pv) && i < len(vals) { pv[k - 1] = vals[i].clone() }
                }
                held += lexdb_pipe.rowBytes(&vals)
                append(mut &outRows, OutRow{vals: vals, ord: []})
            }
            raws = []
        }
        let oc = outC(sel, params, seqEnv(st, txn))
        for r in raws {
            if windowed { break }
            let env = Env{cols: &q.cols, row: &r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            var vals: []Val = []
            for xi in 0..len(sel.exprs) {
                match try outBound(sel, &oc, xi, &r) {
                    Some(v) { append(mut &vals, v) }
                    None { append(mut &vals, try evalX(st, txn, q, &sel.exprs[xi], &env, rs)) }
                }
            }
            if sel.distinct {
                let k = valsKeyIn(&vals, &sel.outKinds)
                if seen.get(&k).isSome() { continue }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for oi in 0..len(sel.order) { append(mut &ord, ordVal(sel, oi, try orderX(st, txn, q, &sel.order[oi], &sel.outs, &vals, &env, rs))) } }
            held += lexdb_pipe.rowBytes(&vals) + lexdb_pipe.rowBytes(&ord)
            append(mut &outRows, OutRow{vals: vals, ord: ord})
        }
    } else {
        // ORDER BY with LIMIT: only the first limit + offset rows are kept
        // (top-N); a row that sorts after the last of them is dropped
        let topK = if sorting && limit >= 0 && !sel.distinct && sel.donKey == 0 && !sel.withTies { limit + max(offset, 0) } else { -1 }
        var bar: []Val = []                 // the last kept row's sort values, once cut
        var barSet = false
        let oc = outC(sel, params, seqEnv(st, txn))
        try runQuery(st, txn, q, &m, params, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
            let env = Env{cols: &q.cols, row: r, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            var vals: []Val = []
            for xi in 0..len(sel.exprs) {
                let c = oc.at[xi]
                if c >= 0 && c < len(r) {
                    append(mut &vals, r[c].clone())
                    continue
                }
                match try outBound(sel, &oc, xi, r) {
                    Some(v) { append(mut &vals, v) }
                    None { append(mut &vals, try eval(&sel.exprs[xi], &env)) }
                }
            }
            if sel.distinct {
                let k = valsKeyIn(&vals, &sel.outKinds)
                if seen.get(&k).isSome() { return Ok(true) }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for oi in 0..len(sel.order) { append(mut &ord, ordVal(sel, oi, try orderValue(&sel.order[oi], &sel.outs, &vals, &env))) } }
            if topK >= 0 {
                if topK == 0 { return Ok(true) }
                // after the last kept, or tied with it: the full sort puts it after
                if barSet && ordCmp(sel, &ord, &bar) >= 0 { return Ok(true) }
            }
            held += lexdb_pipe.rowBytes(&vals) + lexdb_pipe.rowBytes(&ord)
            if room >= 0 && held > room { return Err(lexdb_pipe.memErr(rs0max)) }
            append(mut &outRows, OutRow{vals: vals, ord: ord})
            if topK > 0 && len(outRows) >= 2 * topK + 16 {
                bar = keepFirst(sel, mut &outRows, topK)
                barSet = true
                held = 0
                for o in outRows { held += lexdb_pipe.rowBytes(&o.vals) + lexdb_pipe.rowBytes(&o.ord) }
            }
            return Ok(!early || len(outRows) < stopAt)
        }, rs)
    }
    if windowed {
        var wv = try winValues(st, txn, sel, &bases, &m, params, rs)
        // an output that is a column read at its place, found once (9.105);
        // the others compiled (9.108)
        var at: []int = []
        var cxs: []Option[lexdb_bind.BX] = []
        for x in sel.exprs {
            match x {
                Expr.Col(name, sl) { append(mut &at, lexdb_bind.colSlot(&q.cols, &name, sl)) }
                else { append(mut &at, -1) }
            }
            append(mut &cxs, if !(q.corr && hasCorr(&x)) { lexdb_bind.bindExpr(&x, &q.cols, params, true, &typing()) } else { None })
        }
        let ce = cenvOf(seqEnv(st, txn))
        for bi in 0..len(bases) {
            // the slots: the row's aggregates, then its window values
            var aggs = if len(bases[bi].aggs) == 0 { replace(mut &wv[bi], []) } else { collections.copyOf(&bases[bi].aggs) }
            if len(bases[bi].aggs) > 0 { for v in wv[bi] { append(mut &aggs, v.clone()) } }
            let env = Env{cols: &q.cols, row: &bases[bi].row, aggs: &aggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
            var vals: []Val = []
            for xi in 0..len(sel.exprs) {
                let c = at[xi]
                if c >= 0 && c < len(bases[bi].row) { append(mut &vals, bases[bi].row[c].clone()) }
                else {
                    match cxs[xi] {
                        Some(cx) { append(mut &vals, try lexdb_pipe.bxEval(&cx, &bases[bi].row, &aggs, &ce)) }
                        None { append(mut &vals, try evalX(st, txn, q, &sel.exprs[xi], &env, rs)) }
                    }
                }
            }
            if sel.distinct {
                let k = valsKeyIn(&vals, &sel.outKinds)
                if seen.get(&k).isSome() { continue }
                seen.put(k, 1)
            }
            var ord: []Val = []
            if sorting { for oi in 0..len(sel.order) { append(mut &ord, ordVal(sel, oi, try orderX(st, txn, q, &sel.order[oi], &sel.outs, &vals, &env, rs))) } }
            held += lexdb_pipe.rowBytes(&vals) + lexdb_pipe.rowBytes(&ord)
            append(mut &outRows, OutRow{vals: vals, ord: ord})
        }
    }
    try rs.bud.hold(held)
    if hasSrfCall(&sel.exprs) { try expandSrfs(mut &outRows, &sel.outs) }
    // (rows assigned in their order are in it already)
    if sorting && len(sel.feedback) == 0 { sortOutRows(sel, mut &outRows) }
    if sorting && sel.donKey > 0 {
        // DISTINCT ON (9.94): the first row of each run of equal keys
        var kept: []OutRow = []
        var last = ""
        for i in 0..len(outRows) {
            var kb = ""
            for j in 0..sel.donKey { lexdb_access.encIdxPart(mut &kb, &outRows[i].ord[j]) }
            let k = kb
            if i > 0 && k == last { continue }
            last = k
            append(mut &kept, replace(mut &outRows[i], OutRow{vals: [], ord: []}))
        }
        outRows = kept
    }
    var outs: []OutCol = []
    for oc in sel.outs { append(mut &outs, oc.clone()) }
    var res = Res{cols: outs, rows: [], tag: "", hasRows: true, copy: COPY_NONE}
    // TOP n PERCENT: n percent of the rows, rounded up; WITH TIES: then the
    // rows that sort as the last one does
    var cut = limit
    if sel.topMode & lexdb_sql.TOP_PERCENT != 0 {
        if sel.topN < 0 || sel.topN > 100 { return Err(e("TS1031", "Percent values must be between 0 and 100.")) }
        cut = (len(outRows) * sel.topN + 99) / 100
    } else if sel.topMode != 0 { cut = sel.topN }
    let ties = sel.topMode & lexdb_sql.TOP_TIES != 0 || (sel.withTies && sorting)
    var i = 0
    var lastAt = -1
    for k in 0..len(outRows) {
        if i >= offset || offset < 0 {
            if cut >= 0 && len(res.rows) >= cut {
                if !ties || lastAt < 0 || ordCmp(sel, &outRows[k].ord, &outRows[lastAt].ord) != 0 { break }
            }
            append(mut &res.rows, replace(mut &outRows[k].vals, []))      // (moved: only ord is read after)
            lastAt = k
        }
        i += 1
    }
    res.tag = "SELECT " + len(res.rows).toStr()
    return Ok(res)
}

// A windowed SELECT's rows (execSel's late rows) from the batches of its
// one table (9.108): each kept row's columns used put at their places, not
// made by the row path and copied; counted and held as the row path's.
// false: not a query whose table batches scan (nothing done). A batch the
// batches cannot read goes to the row path, from its start, with the rest
// of its scan (as batchLevel).
fn winBatch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val, rs: mut &Run,
            raws: mut &[][]Val, held: mut &int, room: int, rs0max: int): Result[bool, DbErr] {
    if !rs.batch || len(q.levels) != 1 { return Ok(false) }
    let got0 = try bLevelPlan(st, txn, q, m, params, rs)
    if got0.isNone() { return Ok(false) }
    let lp = got0.unwrap()
    let lv = &q.levels[0]
    if len(lv.post) > 0 || !lp.all || !lp.ranges { return Ok(false) }
    let t = &lv.t
    let bp = &lp.bp
    let nq = len(q.cols)
    rs.cnt[0].starts += 1
    try warmPoints(st, txn, t, &lp.scans)
    for sc in lp.scans {
        var cur = lexdb_access.newCursor()
        var rowPath = false
        while !cur.done {
            let saved = cur.copy()
            let got = try fillPick(st, txn, t, &sc, lp.part, mut &cur, bp, &lp.rd, &lp.lazy, &lp.conds, &lexdb_access.noBar())
            if got.isNone() {
                cur = saved
                rowPath = true
                break
            }
            var pk = got.unwrap()
            let b = replace(mut &pk.b, lexdb_rows.noRows())
            let nr = b.n
            if nr == 0 { continue }
            rs.cnt[0].batches += 1
            let nt = len(bp.kinds)
            for j in pk.idx {
                // (rowBytes' count)
                var n = 32 + 24 * nq
                var r: []Val = array(nq, Val.Null)
                for i in 0..nt {
                    if !bp.needCol[i] || b.cols[i].nul[j] { continue }
                    let v = lexdb_pipe.bValAt(&b, i, bp.kinds[i], j)
                    n += lexdb_pipe.valExtra(&v)
                    r[lv.first + i] = v
                }
                held += n
                if room >= 0 && held > room { return Err(lexdb_pipe.memErr(rs0max)) }
                append(raws, r)
            }
            rs.cnt[0].read += nr
            rs.cnt[0].joined += len(pk.idx)
            try rs.bud.tickN(nr)
        }
        while rowPath && !cur.done {
            var batch: [][]Val = []
            try fetch(st, txn, t, &lv.path, &sc, &lv.need, mut &cur, mut &batch)
            var row: []Val = array(nq, Val.Null)
            for r in batch {
                let got2 = try tryRow(st, txn, q, m, 0, &r, -1, mut &row, params, fn(tx: mut &lexdb_store.Txn, x: &[]Val): Result[bool, DbErr] {
                    held += lexdb_pipe.rowBytes(x)
                    if room >= 0 && held > room { return Err(lexdb_pipe.memErr(rs0max)) }
                    append(raws, collections.copyOf(x))
                    return Ok(true)
                }, rs)
            }
        }
    }
    return Ok(true)
}

// ---- describing a statement before it runs (the extended protocol)

// The parameter types of a statement: the client's, else what the
// statement compares or assigns them to, else text.
fn paramTypes(st: &lexdb_store.Store, s: &lexdb_sql.Stmt, given: &[]int, path: &[]str): []int {
    var out: []int = []
    for i in 0..s.params { append(mut &out, if i < len(given) { given[i] } else { 0 }) }
    stmtCasts(s, mut &out)              // $1::int[]: the cast's type
    if s.kind == lexdb_sql.S_EXPLAIN && len(s.inner) > 0 {
        guessParams(st, &s.inner[0], mut &out, path)
    } else {
        guessParams(st, s, mut &out, path)
    }
    for i in 0..len(out) { if out[i] == 0 { out[i] = lexdb_sql.OID_TEXT } }
    return out
}

// A parameter cast where it is used ($1::int[]) is of the cast's type.
fn castParams(x: &Expr, out: mut &[]int) {
    match x {
        Expr.Cast(a, t) {
            setParam(&a, t.oid, out)
            castParams(&a, out)
        }
        Expr.Unary(_, a) { castParams(&a, out) }
        Expr.Bin(_, a, b) {
            castParams(&a, out)
            castParams(&b, out)
        }
        Expr.IsNull(a, _) { castParams(&a, out) }
        Expr.Call(_, args, _) { for a in args { castParams(&a, out) } }
        else {}
    }
}

fn optCasts(x: &Option[Expr], out: mut &[]int) {
    match x {
        Some(v) { castParams(&v, out) }
        None {}
    }
}

fn stmtCasts(s: &lexdb_sql.Stmt, out: mut &[]int) {
    for it in s.items { optCasts(&it.expr, out) }
    for r in s.rows { for x in r { castParams(&x, out) } }
    for si in s.sets { castParams(&si.expr, out) }
    for g in s.group { castParams(&g, out) }
    for o in s.order { castParams(&o.expr, out) }
    optCasts(&s.where, out)
    optCasts(&s.having, out)
    optCasts(&s.limit, out)
    optCasts(&s.offset, out)
    optCasts(&s.waitMs, out)
    for f in s.from { optCasts(&f.on, out) }
    for b in s.subs { stmtCasts(&b, out) }
    for b in s.inner { stmtCasts(&b, out) }
}

fn setParam(x: &Expr, oid: int, out: mut &[]int) {
    match x {
        Expr.Param(n) { if n <= len(out) && out[n - 1] == 0 { out[n - 1] = oid } }
        else {}
    }
}

fn guessParams(st: &lexdb_store.Store, s: &lexdb_sql.Stmt, out: mut &[]int, path: &[]str) {
    match s.waitMs {
        Some(x) { setParam(&x, lexdb_sql.OID_INT8, out) }         // WAIT $n
        None {}
    }
    if s.kind == lexdb_sql.S_INSERT && len(s.inner) > 0 { guessParams(st, &s.inner[0], out, path) }
    if s.setop != 0 {
        for b in s.inner { guessParams(st, &b, out, path) }
        return
    }
    var txn = lexdb_store.begin()
    for x in path { append(mut &txn.sql.path, x.clone()) }
    txn.tmp = tmpOf(path)
    match findTable(st, mut &txn, &s.table) {
        Ok(found) {
            match found {
                Some(tb) {
                    if s.kind == lexdb_sql.S_INSERT {
                        for r in s.rows {
                            for k in 0..len(r) {
                                let ci = if len(s.names) == 0 { k } else { colIndex(&tb.cols, &s.names[k]) }
                                if ci >= 0 && ci < len(tb.cols) { setParam(&r[k], tb.cols[ci].typ.oid, out) }
                            }
                        }
                    }
                    for si in s.sets {
                        let ci = colIndex(&tb.cols, &si.col)
                        if ci >= 0 { setParam(&si.expr, tb.cols[ci].typ.oid, out) }
                    }
                }
                None {}
            }
        }
        Err(_) {}
    }
    if s.kind == lexdb_sql.S_MERGE {
        match findTable(st, mut &txn, &s.table) {
            Ok(found) {
                match found {
                    Some(tb) {
                        for c in s.merges {
                            for si in c.sets {
                                let ci = colIndex(&tb.cols, &si.col)
                                if ci >= 0 { setParam(&si.expr, tb.cols[ci].typ.oid, out) }
                            }
                            for k in 0..len(c.vals) {
                                let ci = if len(c.names) == 0 { k } else if k < len(c.names) { colIndex(&tb.cols, &c.names[k]) } else { -1 }
                                if ci >= 0 && ci < len(tb.cols) { setParam(&c.vals[k], tb.cols[ci].typ.oid, out) }
                            }
                        }
                    }
                    None {}
                }
            }
            Err(_) {}
        }
        return
    }
    if s.kind != lexdb_sql.S_SELECT && s.kind != lexdb_sql.S_UPDATE && s.kind != lexdb_sql.S_DELETE { return }
    let np: []Val = array(len(out), Val.Null)
    let noTypes: []int = []
    var sc = newScopeIn(st, &txn, &np, &noTypes)
    let built = if s.kind == lexdb_sql.S_SELECT { buildQuery(st, mut &txn, &s.from, &s.where, &np, &s.subs, &newMap(), true, mut &sc, false) } else {
        match dmlFrom(s) {
            Ok(from) { buildQuery(st, mut &txn, &from, &s.where, &np, &s.subs, &newMap(), true, mut &sc, false) }
            Err(x) { Err(x) }
        }
    }
    match built {
        Ok(q) { comparedIn(&q, out) }
        Err(_) {}
    }
}

fn comparedIn(q: &Query, out: mut &[]int) {
    for lv in q.levels {
        for c in lv.cond { compared(&c, q, out) }
        for c in lv.post { compared(&c, q, out) }
    }
    for sp in q.subs { comparedIn(&sp.sel.q, out) }
}

// A parameter compared with a column takes the column's type; in col op
// ANY ($1), an array of it.
fn compared(c: &Expr, q: &Query, out: mut &[]int) {
    match c {
        Expr.Call(n, args, _) {
            if lexdb_sql.isQuant(&n) && len(args) == 2 {
                match args[0] {
                    Expr.Col(x, sl) {
                        let i = lexdb_bind.colSlot(&q.cols, &x, sl)
                        if i >= 0 && lexdb_sql.arrayOid(q.cols[i].typ.oid) > 0 { setParam(&args[1], lexdb_sql.arrayOid(q.cols[i].typ.oid), out) }
                    }
                    else {}
                }
            }
        }
        Expr.Bin(op, a, b) {
            if op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                match a {
                    Expr.Col(n, sl) {
                        let i = lexdb_bind.colSlot(&q.cols, &n, sl)
                        if i >= 0 { setParam(&b, q.cols[i].typ.oid, out) }
                    }
                    else {}
                }
                match b {
                    Expr.Col(n, sl) {
                        let i = lexdb_bind.colSlot(&q.cols, &n, sl)
                        if i >= 0 { setParam(&a, q.cols[i].typ.oid, out) }
                    }
                    else {}
                }
            }
        }
        else {}
    }
}

// Whether a statement returns rows (so Describe has columns for it).
pub fn returnsRows(s: &lexdb_sql.Stmt): bool {
    let k = s.kind
    if k == lexdb_sql.S_SELECT || k == lexdb_sql.S_SHOW || k == lexdb_sql.S_EXPLAIN || k == lexdb_sql.S_CALL { return true }
    return (k == lexdb_sql.S_INSERT || k == lexdb_sql.S_UPDATE || k == lexdb_sql.S_DELETE || k == lexdb_sql.S_MERGE) && len(s.items) > 0
}

// The columns a statement returns (none unless it is a SELECT, EXPLAIN,
// SHOW, or has RETURNING).
fn describe(st: &lexdb_store.Store, s: &lexdb_sql.Stmt, ptypes: &[]int, path: &[]str): Result[[]OutCol, DbErr] {
    if s.kind == lexdb_sql.S_EXPLAIN { return Ok([OutCol{name: "QUERY PLAN", oid: lexdb_sql.OID_TEXT, spell: "", coll: "", scale: -1}]) }
    if s.kind == lexdb_sql.S_SHOW { return Ok(showCols(&s.table)) }
    let dml = s.kind == lexdb_sql.S_INSERT || s.kind == lexdb_sql.S_UPDATE || s.kind == lexdb_sql.S_DELETE || s.kind == lexdb_sql.S_MERGE
    if s.kind != lexdb_sql.S_SELECT && !(dml && len(s.items) > 0) { return Ok([]) }
    var txn = lexdb_store.begin()
    for x in path { append(mut &txn.sql.path, x.clone()) }
    txn.tmp = tmpOf(path)
    if dml {
        let none: Option[Expr] = None
        let np: []Val = array(if s.params > len(ptypes) { s.params } else { len(ptypes) }, Val.Null)
        var sc = newScopeIn(st, &txn, &np, ptypes)
        let from = if s.kind == lexdb_sql.S_INSERT { oneTable(&s.table) } else if s.kind == lexdb_sql.S_MERGE { mergeFrom(s) } else { try dmlFrom(s) }
        let q = try buildQuery(st, mut &txn, &from, &none, &np, &s.subs, &newMap(), true, mut &sc, false)
        var exprs: []Expr = []
        if s.kind == lexdb_sql.S_MERGE {
            let items = mergeItems(s, &q.levels[len(q.levels) - 1].t, &(if len(s.alias) > 0 { s.alias.clone() } else { lexdb_sql.baseName(&s.table) }))
            return lexdb_bind.itemCols(&items, true, &q.cols, mut &sc.names, mut &exprs)
        }
        return lexdb_bind.itemCols(&s.items, true, &q.cols, mut &sc.names, mut &exprs)
    }
    if s.setop != 0 {
        let np: []Val = array(if s.params > len(ptypes) { s.params } else { len(ptypes) }, Val.Null)
        var sc = newScopeIn(st, &txn, &np, ptypes)
        let sel = try planSelect(st, mut &txn, s, &np, mut &sc)
        var outs: []OutCol = []
        for o in sel.outs { append(mut &outs, o.clone()) }
        return Ok(outs)
    }
    let none: Option[Expr] = None
    let np: []Val = array(if s.params > len(ptypes) { s.params } else { len(ptypes) }, Val.Null)
    var sc = newScopeIn(st, &txn, &np, ptypes)
    let q = try buildQuery(st, mut &txn, &s.from, &none, &np, &s.subs, &newMap(), true, mut &sc, false)
    var exprs: []Expr = []
    return lexdb_bind.selectCols(s, &q.cols, mut &sc.names, mut &exprs)
}

// ---- sessions

pub type Session = record {
    st: lexdb_store.Store
    txn: []lexdb_store.Txn      // the open transaction block, if any
    failed: bool                // an error in the block: only ROLLBACK (or COMMIT) now
    maxRecursion: int           // SET max_recursion: a recursive CTE's rounds at most; 0 no limit
    maxSteps: int               // SET max_match_steps: MATCH_RECOGNIZE's steps per start row at most; 0 no limit
    timeoutMs: int              // SET statement_timeout: a statement's time at most; 0 no limit
    maxMem: int                 // SET max_statement_mem: the bytes of rows a statement holds at most; 0 no limit
    saved: []Limits             // in a transaction block: the settings at its BEGIN (a ROLLBACK restores them)
    readOnly: bool              // the block is BEGIN READ ONLY
    path: []str                 // SET search_path: its schemas; [] public alone (the default)
    pathAt: int                 // bumped when the path changes (the wire's kept descriptions)
    savedPath: [][]str          // in a transaction block: the path at its BEGIN
    id: int                     // its number while the store is open (its sequences' currval: 9.43)
    batch: bool                 // SET lexdb_batch: vector scans and batch operators (9.47)
    rules: bool                 // SET lexdb_planner = rules: no statistics in planning (optimizer 20)
    auto: bool                  // SET lexdb_autoanalyze: its committed changes counted for the automatic statistics (optimizer 44)
    rdel: bool                  // SET lexdb_range_delete: a DELETE of a key range may drop its subtrees (design/lexdb-bulkdelete.md)
    saves: []SavePt             // the open block's savepoints, oldest first (9.80)
    savedRoles: []str           // in a transaction block: SET ROLE's and SET SESSION AUTHORIZATION's at its BEGIN (9.83)
    custom: []str               // the settings with a dot in their names (SET my.x, set_config): "name\x00value" (9.92)
    savedCustom: [][]str        // in a transaction block: custom at its BEGIN
    localUndo: []str            // in a transaction block: the settings SET LOCAL or set_config(..., true) changed, "name\x00old"
    zone: lexdb_time.Zone       // SET TimeZone (9.95): copied to each statement's Txn
    savedZone: []lexdb_time.Zone // in a transaction block: the zone at its BEGIN
    tmp: str                    // its temporary schema once it has made one (9.96): pg_temp_ and id
    onCommit: []str             // its temporary tables ON COMMIT DELETE ROWS (and DROP, made in the open block)
    fresh: bool                 // the open block has run no statement yet: a WAITFOR may begin it (design/lexdb-events.md)
    // PostgreSQL's SQL functions' names as of lexdb_routine's generation fnGen (-1: not looked up): a statement compares
    // one integer, not the store's memo, to know whether it may call one (inlineFunctions)
    fnGen: int
    fnNames: []str
}

// The session's time zone (SET TimeZone, 9.95).
pub fn (s: &Session) zone(): lexdb_time.Zone { return s.zone.clone() }

// The text a client sees for a value of a column of type oid, in the
// session's zone (textOut).
pub fn (s: &Session) text(v: &Val, oid: int): str { return lexdb_ops.textOut(v, oid, &s.zone) }

// Values sent as text by a client for parameters of these types, read in
// the session's zone (paramVals).
pub fn (s: &Session) paramVals(texts: &[]Option[str], ptypes: &[]int): Result[[]Val, DbErr] {
    return paramValsIn(texts, ptypes, &s.zone)
}

// A TimeZone given at the connection's start (9.95).
pub fn (s: mut &Session) startupZone(v: &str): Result[Unit, DbErr] {
    s.setZone(try lexdb_time.settingZone(v))
    return Ok(Unit{})
}

// The session's zone made z, in its open block's transaction too.
fn (s: mut &Session) setZone(z: lexdb_time.Zone) {
    if len(s.txn) > 0 { s.txn[0].sql.zone = z.clone() }
    s.zone = z
}

// A savepoint: its name and the block's writes when it was made.
type SavePt = record { name: str; mark: int; fresh: bool }     // fresh: Session.fresh when it was set (a WAITFOR may follow a ROLLBACK TO it)

// The columns a statement returns, its names looked up along the session's
// search path.
pub fn (s: mut &Session) describe(stmt: &lexdb_sql.Stmt, ptypes: &[]int): Result[[]OutCol, DbErr] {
    // a CALL's columns are its procedure's OUT parameters; a query's calls of SQL functions are written as their bodies (package F)
    if stmt.kind == lexdb_sql.S_CALL { return s.callCols(stmt) }
    match try s.inlineFunctions(stmt) {
        Some(t) { return describe(&s.st, &t, ptypes, &s.txnPath()) }
        None {}
    }
    return describe(&s.st, stmt, ptypes, &s.txnPath())
}

// A statement's parameter types (paramTypes), along the session's path.
pub fn (s: &Session) paramTypes(stmt: &lexdb_sql.Stmt, given: &[]int): []int {
    return paramTypes(&s.st, stmt, given, &s.txnPath())
}

// Changes when the search path does: a statement's description kept from
// before may name other tables. And when its temporary objects change
// (9.96).
pub fn (s: &Session) pathVersion(): int {
    if len(s.tmp) == 0 { return s.pathAt }
    return s.pathAt + lexdb_base.num(&s.st.memo.get(&tmpVerKey(s.id)).unwrapOr("0"))
}

// The path its statements' transactions carry: its temporary schema
// first, once it has one (9.96).
fn (s: &Session) txnPath(): []str {
    if len(s.tmp) > 0 { return withTmp(&s.path, &s.tmp) }
    var q: []str = []
    for n in s.path { append(mut &q, n.clone()) }
    return q
}

// The temporary schema on a transaction's path, "" none.
fn tmpOf(path: &[]str): str {
    for n in path { if lexdb_base.isTempSchema(&n) { return n.clone() } }
    return ""
}

// A transaction of the session's: its path, temporary schema, number and
// time zone.
fn (s: &Session) setUp(t: mut &lexdb_store.Txn) {
    t.sql.path = s.txnPath()
    t.tmp = s.tmp.clone()
    t.sql.sess = s.id
    t.sql.zone = s.zone.clone()
    t.sql.rules = s.rules
    t.sql.memMax = s.maxMem
}

// A transaction ended without committing: if it changed temporary objects'
// catalog, the session's kept plans and descriptions go (9.96).
fn (s: &Session) tmpUndo(t: &lexdb_store.Txn) { if t.tmpDdl { tmpChanged(&s.st, s.id) } }

// After a statement: the temporary schema it made, if it did.
fn (s: mut &Session) adopt(t: &lexdb_store.Txn) { if len(s.tmp) == 0 && len(t.tmp) > 0 { s.tmp = t.tmp.clone() } }

fn (s: mut &Session) setPath(names: &[]str) {
    var p: []str = []
    for n in names { append(mut &p, n.clone()) }
    if len(p) == 1 && p[0] == "public" { p = [] }
    s.path = p
    s.pathAt += 1
    if len(s.txn) > 0 { s.txn[0].sql.path = s.txnPath() }
}

// SHOW's columns: the setting's name, or SHOW ALL's name and setting.
fn showCols(name: &str): []OutCol {
    if name == "all" { return [OutCol{name: "name", oid: lexdb_sql.OID_TEXT, spell: "", coll: "", scale: -1}, OutCol{name: "setting", oid: lexdb_sql.OID_TEXT, spell: "", coll: "", scale: -1}] }
    if name == "timezone" { return [OutCol{name: "TimeZone", oid: lexdb_sql.OID_TEXT, spell: "", coll: "", scale: -1}] }
    return [OutCol{name: name.toStr(), oid: lexdb_sql.OID_TEXT, spell: "", coll: "", scale: -1}]
}

fn (s: &Session) setting(name: &str): Option[str] {
    match name {
        "search_path" { return Some(if len(s.path) == 0 { "public" } else { strings.join(&s.path, ", ") }) }
        "max_recursion" { return Some(s.maxRecursion.toStr()) }
        "max_match_steps" { return Some(s.maxSteps.toStr()) }
        "statement_timeout" { return Some(if s.timeoutMs == 0 { "0" } else { s.timeoutMs.toStr() + "ms" }) }
        "max_statement_mem" { return Some(if s.maxMem == 0 { "0" } else { (s.maxMem / 1024).toStr() + "kB" }) }
        "transaction_isolation", "default_transaction_isolation" { return Some("serializable") }
        // PostgreSQL's that clients ask for, fixed in lexdb (9.80)
        "standard_conforming_strings", "integer_datetimes", "is_superuser" { return Some("on") }
        "transaction_read_only", "default_transaction_read_only", "in_hot_standby" { return Some("off") }
        "server_version" { return Some("16.0") }
        "server_version_num" { return Some("160000") }
        "server_encoding", "client_encoding" { return Some("UTF8") }
        "datestyle" { return Some("ISO, MDY") }
        "timezone" { return Some(s.zone.name.clone()) }
        "log_timezone" { return Some("UTC") }
        "intervalstyle" { return Some("postgres") }
        "lc_collate", "lc_ctype", "lc_messages", "lc_monetary", "lc_numeric", "lc_time" { return Some("C") }
        "max_identifier_length" { return Some("63") }
        "application_name" { return Some("") }
        "bytea_output" { return Some("hex") }
        "lexdb_planner" { return Some(if s.rules { "rules" } else { "cost" }) }
        "lexdb_batch" { return Some(if s.batch { "on" } else { "off" }) }
        "lexdb_autoanalyze" { return Some(if s.auto { "on" } else { "off" }) }
        "lexdb_range_delete" { return Some(if s.rdel { "on" } else { "off" }) }
        else {}
    }
    let k = strings.toLowerAscii(&name)
    for c in s.custom {
        let z = strings.indexOf(&c, "\x00", 0)
        if c[0..z] == k { return Some(c[z + 1..len(c)].toStr()) }
    }
    return None
}

// The settings setting() knows by name (besides the custom ones).
const SHOWN: []str = ["search_path", "max_recursion", "max_match_steps", "statement_timeout", "max_statement_mem", "transaction_isolation",
                      "default_transaction_isolation", "standard_conforming_strings", "integer_datetimes", "is_superuser",
                      "transaction_read_only", "default_transaction_read_only", "in_hot_standby", "server_version",
                      "server_version_num", "server_encoding", "client_encoding", "datestyle", "timezone", "log_timezone",
                      "intervalstyle", "lc_collate", "lc_ctype", "lc_messages", "lc_monetary", "lc_numeric", "lc_time",
                      "max_identifier_length", "application_name", "bytea_output", "lexdb_batch", "lexdb_planner", "lexdb_autoanalyze", "lexdb_range_delete"]

// The session's settings for current_setting and set_config (9.92), in the
// memo while a statement calling them runs: a line each, name TAB value.
fn settingsKey(sess: int): str { return "\x00settings\x00" + sess.toStr() }
fn setCfgKey(sess: int): str { return "\x00setcfg\x00" + sess.toStr() }

fn (s: &Session) publishSettings() {
    var b = ""
    for n in SHOWN {
        match s.setting(&n) {
            Some(v) {
                b += &n
                b.addByte('\t')
                b += &v
                b.addByte('\n')
            }
            None {}
        }
    }
    for c in s.custom {
        let z = strings.indexOf(&c, "\x00", 0)
        b += &(c[0..z].toStr())
        b.addByte('\t')
        b += &(c[z + 1..len(c)].toStr())
        b.addByte('\n')
    }
    s.st.memo.put(&settingsKey(s.id), &b)
    s.st.memo.put(&setCfgKey(s.id), &"")
}

// A setting given a value as text, as SET would: lexdb's own (SETTINGS), a
// custom one (with a dot), or one of PostgreSQL's lexdb shows fixed
// (accepted, not changed). local: until the transaction block ends.
fn (s: mut &Session) applySetting(name: &str, value: &str, local: bool): Result[Unit, DbErr] {
    let k = strings.toLowerAscii(&name)
    if local {
        if len(s.txn) == 0 { return Ok(Unit{}) }       // PostgreSQL warns, and nothing lasts
        let old = s.setting(&k)
        var had = false
        for u in s.localUndo { if strings.startsWith(&u, &(k + "\x00")) { had = true } }
        if !had {
            match old {
                Some(o) { append(mut &s.localUndo, k + "\x00" + o) }
                None { append(mut &s.localUndo, k + "\x00\x01") }
            }
        }
    }
    if strings.contains(&k, ".") {
        var out: []str = []
        for c in s.custom { if !strings.startsWith(&c, &(k + "\x00")) { append(mut &out, c.clone()) } }
        if value != "\x01" { append(mut &out, k + "\x00" + value) }
        s.custom = out
        return Ok(Unit{})
    }
    if k == "search_path" {
        var names: []str = []
        for part in strings.split(&value, ",") {
            var x = strings.trim(&(part.toStr()))
            if len(x) >= 2 && x[0] == '"' && x[len(x) - 1] == '"' { x = x[1..len(x) - 1].toStr() }
            if len(x) > 0 { append(mut &names, x) }
        }
        if len(names) == 0 { s.setPath(&["public"]) } else { s.setPath(&names) }
        return Ok(Unit{})
    }
    if k == "timezone" {
        // SET TIME ZONE (9.95): "\x01" or DEFAULT, lexdb's default, UTC
        if value == "\x01" || strings.toLowerAscii(&value) == "default" { s.setZone(lexdb_time.utc().clone()) } else { s.setZone(try lexdb_time.settingZone(value)) }
        return Ok(Unit{})
    }
    if k == "lexdb_planner" {
        // set_config (9.92) as SET (optimizer 20)
        let v = strings.toLowerAscii(&(strings.trim(value)))
        if v != "rules" && v != "cost" { return Err(e("22023", "invalid value for parameter \"lexdb_planner\": use cost or rules")) }
        s.rules = v == "rules"
        if len(s.txn) > 0 { s.txn[0].sql.rules = s.rules }
        return Ok(Unit{})
    }
    if k == "lexdb_batch" {
        match lexdb_ops.parseBool(&strings.toLowerAscii(&(strings.trim(value)))) {
            Some(y) { s.batch = y }
            None { return Err(e("22023", "parameter \"lexdb_batch\" requires a Boolean value")) }
        }
        return Ok(Unit{})
    }
    if k == "lexdb_autoanalyze" {
        match lexdb_ops.parseBool(&strings.toLowerAscii(&(strings.trim(value)))) {
            Some(y) { s.auto = y }
            None { return Err(e("22023", "parameter \"lexdb_autoanalyze\" requires a Boolean value")) }
        }
        return Ok(Unit{})
    }
    if k == "lexdb_range_delete" {
        match lexdb_ops.parseBool(&strings.toLowerAscii(&(strings.trim(value)))) {
            Some(y) { s.rdel = y }
            None { return Err(e("22023", "parameter \"lexdb_range_delete\" requires a Boolean value")) }
        }
        return Ok(Unit{})
    }
    if k == "max_recursion" || k == "max_match_steps" || k == "statement_timeout" || k == "max_statement_mem" {
        let v = try settingValue(&k, &Val.Text(value.toStr()))
        if k == "max_recursion" { s.maxRecursion = v }
        if k == "max_match_steps" { s.maxSteps = v }
        if k == "statement_timeout" { s.timeoutMs = v }
        if k == "max_statement_mem" { s.maxMem = if v == 0 { MAX_STATEMENT_MEM } else { v } }
        return Ok(Unit{})
    }
    return Ok(Unit{})
}

// After a statement that called set_config: its changes made.
fn (s: mut &Session) takeSetConfigs(): Result[Unit, DbErr] {
    let pending = s.st.memo.get(&setCfgKey(s.id)).unwrapOr("")
    s.st.memo.put(&setCfgKey(s.id), &"")
    for l in strings.split(&pending, "\n") {
        if len(l) == 0 { continue }
        let f = strings.split(&l, "\t")
        if len(f) < 3 { continue }
        try s.applySetting(&f[0], &f[1], f[2] == "1")
    }
    return Ok(Unit{})
}

// A transaction block's end: what SET LOCAL changed goes back.
fn (s: mut &Session) undoLocal() {
    let us = replace(mut &s.localUndo, [])
    var i = len(us) - 1
    while i >= 0 {
        let z = strings.indexOf(&us[i], "\x00", 0)
        let r = s.applySetting(&us[i][0..z], &us[i][z + 1..len(us[i])], false)
        i -= 1
    }
}

fn (s: &Session) show(name: &str): Result[Res, DbErr] {
    var res = Res{cols: showCols(name), rows: [], tag: "SHOW", hasRows: true, copy: COPY_NONE}
    if name == "all" {
        for n in lexdb_sql.settingsList() { append(mut &res.rows, [Val.Text(n.clone()), Val.Text(s.setting(&n).unwrap())]) }
        return Ok(res)
    }
    match s.setting(name) {
        Some(v) { append(mut &res.rows, [Val.Text(v)]) }
        None { return Err(e("42704", &("unrecognized configuration parameter \"" + name + "\""))) }
    }
    return Ok(res)
}

// A Session holding a Wire's place while its own is out (a COPY TO's run,
// lexdb_wire): no id of its own, never run.
pub fn parkedSession(st: lexdb_store.Store): Session {
    return Session{st: st, txn: [], failed: false, maxRecursion: MAX_RECURSION, maxSteps: MAX_MATCH_STEPS, timeoutMs: 0, maxMem: MAX_STATEMENT_MEM,
                   saved: [], readOnly: false, path: [], pathAt: 0, savedPath: [], id: 0, batch: true, rules: false, auto: true, rdel: true, saves: [], savedRoles: [],
                   custom: [], savedCustom: [], localUndo: [], zone: lexdb_time.utc().clone(), savedZone: [], tmp: "", onCommit: [], fresh: false, fnGen: -1, fnNames: []}
}

pub fn newSession(st: lexdb_store.Store): Session {
    let id = lexdb_base.num(&st.memo.get(&"sessions").unwrapOr("0")) + 1
    st.memo.put(&"sessions", &id.toStr())
    return Session{st: st, txn: [], failed: false, maxRecursion: MAX_RECURSION, maxSteps: MAX_MATCH_STEPS, timeoutMs: 0, maxMem: MAX_STATEMENT_MEM,
                   saved: [], readOnly: false, path: [], pathAt: 0, savedPath: [], id: id, batch: true, rules: false, auto: true, rdel: true, saves: [], savedRoles: [],
                   custom: [], savedCustom: [], localUndo: [], zone: lexdb_time.utc().clone(), savedZone: [], tmp: "", onCommit: [], fresh: false, fnGen: -1, fnNames: []}
}

// max_statement_mem's default.
pub const MAX_STATEMENT_MEM = 256 * 1024 * 1024

// A transaction block rolled back: its SETs with it (as PostgreSQL's).
fn (s: mut &Session) restore() {
    s.localUndo = []
    if len(s.savedZone) > 0 { s.zone = pop(mut &s.savedZone) }
    if len(s.savedCustom) > 0 { s.custom = pop(mut &s.savedCustom) }
    if len(s.savedRoles) > 0 {
        let r = pop(mut &s.savedRoles)
        let nl = strings.indexOf(&r, "\n", 0)
        s.st.memo.put(&roleKeyOf(s.id), &r[0..nl])
        s.st.memo.put(&sessAuthKey(s.id), &r[nl + 1..len(r)])
    }
    if len(s.saved) == 0 { return }
    let l = pop(mut &s.saved)
    if len(s.savedPath) > 0 {
        let p = pop(mut &s.savedPath)
        if strings.join(&p, ",") != strings.join(&s.path, ",") {
            if len(p) == 0 { s.setPath(&["public"]) } else { s.setPath(&p) }
        }
    }
    s.maxRecursion = l.rounds
    s.maxSteps = l.steps
    s.maxMem = l.mem
    s.timeoutMs = l.deadline                // saved there: the timeout in ms
    s.batch = l.batch
    s.rules = l.rules
    s.auto = l.auto
    s.rdel = l.rdel
}

// The limits for a statement starting now.
fn (s: &Session) limits(): Limits {
    let dl = if s.timeoutMs > 0 { time.monotonicNs() + s.timeoutMs * 1000000 } else { 0 }
    return Limits{rounds: s.maxRecursion, steps: s.maxSteps, mem: s.maxMem, deadline: dl, batch: s.batch, rules: s.rules, auto: s.auto, rdel: s.rdel}
}

// A setting's value: a number (statement_timeout in ms, max_statement_mem
// in kB, as PostgreSQL's), or a string with a unit ('5s', '64MB').
fn settingValue(name: &str, v: &Val): Result[int, DbErr] {
    let bad = e("22023", &("invalid value for parameter \"" + name + "\""))
    var n = 0
    var unit = ""
    match v {
        Val.Int(i) { n = i }
        Val.Text(t) {
            var i = 0
            while i < len(t) && t[i] >= '0' && t[i] <= '9' { i += 1 }
            if i == 0 { return Err(bad) }
            n = strings.parseIntOpt(&t[0..i]).unwrapOr(-1)
            unit = strings.toLowerAscii(&(strings.trim(&t[i..len(t)])))
        }
        else { return Err(bad) }
    }
    if n < 0 { return Err(bad) }
    if name == "statement_timeout" {
        if unit == "" || unit == "ms" { return Ok(n) }
        if unit == "s" { return Ok(n * 1000) }
        if unit == "min" { return Ok(n * 60000) }
        if unit == "h" { return Ok(n * 3600000) }
        return Err(bad)
    }
    if name == "max_statement_mem" {
        if unit == "" || unit == "kb" { return Ok(n * 1024) }
        if unit == "mb" { return Ok(n * 1024 * 1024) }
        if unit == "gb" { return Ok(n * 1024 * 1024 * 1024) }
        return Err(bad)
    }
    if unit != "" { return Err(bad) }
    return Ok(n)
}

// Ends the session: an open block is rolled back (a snapshot released,
// its locks), and its advisory locks released.
pub fn (s: mut &Session) close() {
    if len(s.txn) > 0 {
        let t = pop(mut &s.txn)
        s.tmpUndo(&t)
        s.st.abort(t)
    }
    lexdb_stats.chgEnd(&s.st, s.id, false)
    s.failed = false
    // its temporary objects (9.96); should this fail, the next start drops them
    if len(s.tmp) > 0 { let r = s.dropTemps() }
    advRelease(&s.st, s.id, true)
    s.st.memo.del(&collKey(s.id))
    s.st.memo.del(&identKey(s.id))
    s.st.memo.del(&noticeKey(s.id))
    s.st.memo.del(&doorKey(s.id))
    s.st.memo.del(&sysUserKey(s.id))
}

// ---- notices (9.117): what a statement tells the client besides its
// result (IF EXISTS's "skipping", a rename USING INDEX makes), as
// PostgreSQL's NOTICE messages. Kept in the store's memo under the session
// (the executor sees its session only as Txn.sess) until the wire sends
// them before the statement's end; a statement run again drops its first
// try's.

fn noticeKey(sess: int): str { return "nt:" + sess.toStr() }

// A notice for the session running txn: SQLSTATE state (00000, or the
// condition's own, as PostgreSQL's 42701 for ADD COLUMN IF NOT EXISTS),
// msg, and a DETAIL ("" none).
fn notice(st: &lexdb_store.Store, txn: &lexdb_store.Txn, state: &str, msg: &str, detail: &str) {
    let k = noticeKey(txn.sql.sess)
    let was = st.memo.get(&k).unwrapOr("")
    st.memo.put(&k, &(was + state + "\x01" + msg + "\x01" + detail + "\x00"))
}

// The session's notices, oldest first, taken: each a DbErr (its state,
// message and detail).
pub fn (s: &Session) takeNotices(): []DbErr {
    var out: []DbErr = []
    match s.st.memo.get(&noticeKey(s.id)) {
        Some(v) {
            s.st.memo.del(&noticeKey(s.id))
            for one in strings.split(&v, "\x00") {
                let f = strings.split(&one, "\x01")
                if len(f) == 3 { append(mut &out, lexdb_base.errDetail(&(f[0].toStr()), &(f[1].toStr()), &(f[2].toStr()), "")) }
            }
        }
        None {}
    }
    return out
}

// Its temporary objects dropped, in a transaction of their own (tried
// again on a serialization failure).
fn (s: mut &Session) dropTemps(): Result[Unit, DbErr] {
    var tries = 0
    while true {
        var t = lexdb_store.begin()
        s.setUp(mut &t)
        let st = s.st.share()
        match dropTempIn(&st, mut &t, &s.tmp) {
            Ok(n) {
                if n == 0 {
                    st.abort(t)
                    s.onCommit = []
                    return Ok(Unit{})
                }
                match st.commit(t) {
                    Ok(_) {
                        s.onCommit = []
                        return Ok(Unit{})
                    }
                    Err(x) {
                        tmpChanged(&st, s.id)
                        tries += 1
                        if x.state != lexdb_base.S_CONFLICT || tries >= 10 { return Err(x) }
                    }
                }
            }
            Err(x) {
                st.abort(t)
                return Err(x)
            }
        }
    }
    return Err(e("XX000", "unreachable"))
}

// DISCARD TEMP | ALL | PLANS | SEQUENCES (9.96). ALL drops the temporary
// objects, resets the settings (RESET ALL) and releases the advisory
// locks; PLANS and SEQUENCES are accepted and do nothing (a kept plan
// follows the catalog anyway; currval is not forgotten).
fn (s: mut &Session) discard(what: &str): Result[Res, DbErr] {
    let tag = "DISCARD " + strings.toUpperAscii(&what)
    if what == "all" && len(s.txn) > 0 {
        s.failed = true
        return Err(e("25001", "DISCARD ALL cannot run inside a transaction block"))
    }
    if (what == "temp" || what == "all") && len(s.tmp) > 0 {
        if len(s.txn) > 0 {
            if s.failed { return Err(e("25P02", "current transaction is aborted, commands ignored until end of transaction block")) }
            if s.readOnly {
                s.failed = true
                return Err(e("25006", "cannot execute DISCARD TEMP in a read-only transaction"))
            }
            let st = s.st.share()
            match dropTempIn(&st, mut &s.txn[0], &s.tmp) {
                Ok(_) {}
                Err(x) {
                    s.failed = true
                    return Err(x)
                }
            }
        } else {
            try s.dropTemps()
        }
    }
    if what == "all" {
        s.resetAll()
        advRelease(&s.st, s.id, true)
    }
    return Ok(tagOnly(&tag))
}

// RESET ALL: lexdb's settings to their defaults.
fn (s: mut &Session) resetAll() {
    s.setZone(lexdb_time.utc().clone())
    if len(s.path) > 0 { s.setPath(&["public"]) }
    s.maxRecursion = MAX_RECURSION
    s.maxSteps = MAX_MATCH_STEPS
    s.timeoutMs = 0
    s.maxMem = MAX_STATEMENT_MEM
    if len(s.txn) > 0 { s.txn[0].sql.memMax = s.maxMem }
    s.batch = true
    s.rules = false
    if len(s.txn) > 0 { s.txn[0].sql.rules = false }
    s.auto = true
    s.rdel = true
}

// Whether a statement a READ ONLY block refuses writes only temporary
// tables, which PostgreSQL allows (INSERT, UPDATE, DELETE, COPY FROM: not
// DDL, nor TRUNCATE).
fn (s: mut &Session) tempWrite(stmt: &lexdb_sql.Stmt): bool {
    if len(s.tmp) == 0 || len(s.txn) == 0 { return false }
    if !(stmt.kind == lexdb_sql.S_INSERT || stmt.kind == lexdb_sql.S_UPDATE || stmt.kind == lexdb_sql.S_DELETE ||
         stmt.kind == lexdb_sql.S_MERGE || (stmt.kind == lexdb_sql.S_COPY && stmt.copy.from)) { return false }
    let st = s.st.share()
    match catKey(&st, mut &s.txn[0], &stmt.table, false) {
        Ok(k) { return lexdb_catalog.tempRel(&k) }
        Err(_) { return false }
    }
}

fn isWrite(kind: int): bool {
    return kind == lexdb_sql.S_CREATE || kind == lexdb_sql.S_DROP || kind == lexdb_sql.S_INSERT ||
           kind == lexdb_sql.S_UPDATE || kind == lexdb_sql.S_DELETE || kind == lexdb_sql.S_CREATE_INDEX ||
           kind == lexdb_sql.S_DROP_INDEX || kind == lexdb_sql.S_CREATE_SCHEMA || kind == lexdb_sql.S_DROP_SCHEMA ||
           kind == lexdb_sql.S_ALTER || kind == lexdb_sql.S_ALTER_INDEX || kind == lexdb_sql.S_ALTER_SCHEMA ||
           kind == lexdb_sql.S_CREATE_SEQ || kind == lexdb_sql.S_ALTER_SEQ || kind == lexdb_sql.S_DROP_SEQ ||
           kind == lexdb_sql.S_CREATE_ROLE || kind == lexdb_sql.S_ALTER_ROLE || kind == lexdb_sql.S_DROP_ROLE ||
           kind == lexdb_sql.S_CREATE_VIEW || kind == lexdb_sql.S_DROP_VIEW || kind == lexdb_sql.S_ALTER_VIEW ||
           kind == lexdb_sql.S_GRANT || kind == lexdb_sql.S_REVOKE || kind == lexdb_sql.S_OWNER ||
           kind == lexdb_sql.S_CREATE_TYPE || kind == lexdb_sql.S_DROP_TYPE || kind == lexdb_sql.S_ALTER_TYPE ||
           kind == lexdb_sql.S_TRUNCATE || kind == lexdb_sql.S_ANALYZE || kind == lexdb_sql.S_MERGE || kind == lexdb_sql.S_ALTER_DB || kind == lexdb_sql.S_SP_RENAME ||
           kind == lexdb_sql.S_CREATE_ROUTINE || kind == lexdb_sql.S_DROP_ROUTINE
}

fn stmtName(kind: int): str {
    return match kind {
        lexdb_sql.S_CREATE { "CREATE TABLE" }
        lexdb_sql.S_DROP { "DROP TABLE" }
        lexdb_sql.S_INSERT { "INSERT" }
        lexdb_sql.S_UPDATE { "UPDATE" }
        lexdb_sql.S_CREATE_INDEX { "CREATE INDEX" }
        lexdb_sql.S_ANALYZE { "ANALYZE" }      // (or VACUUM ANALYZE: its tag is the statement's alias)
        lexdb_sql.S_DROP_INDEX { "DROP INDEX" }
        lexdb_sql.S_CREATE_SCHEMA { "CREATE SCHEMA" }
        lexdb_sql.S_DROP_SCHEMA { "DROP SCHEMA" }
        lexdb_sql.S_CREATE_ROLE { "CREATE ROLE" }
        lexdb_sql.S_CREATE_VIEW { "CREATE VIEW" }
        lexdb_sql.S_GRANT { "GRANT" }
        lexdb_sql.S_REVOKE { "REVOKE" }
        lexdb_sql.S_OWNER { "ALTER" }
        lexdb_sql.S_CREATE_TYPE { "CREATE TYPE" }
        lexdb_sql.S_DROP_TYPE { "DROP TYPE" }
        lexdb_sql.S_ALTER_TYPE { "ALTER TYPE" }
        lexdb_sql.S_TRUNCATE { "TRUNCATE TABLE" }
        lexdb_sql.S_DROP_VIEW { "DROP VIEW" }
        lexdb_sql.S_ALTER_VIEW { "ALTER VIEW" }
        lexdb_sql.S_ALTER_ROLE { "ALTER ROLE" }
        lexdb_sql.S_DROP_ROLE { "DROP ROLE" }
        lexdb_sql.S_ALTER { "ALTER TABLE" }
        lexdb_sql.S_ALTER_INDEX { "ALTER INDEX" }
        lexdb_sql.S_ALTER_SCHEMA { "ALTER SCHEMA" }
        lexdb_sql.S_CREATE_SEQ { "CREATE SEQUENCE" }
        lexdb_sql.S_ALTER_SEQ { "ALTER SEQUENCE" }
        lexdb_sql.S_DROP_SEQ { "DROP SEQUENCE" }
        lexdb_sql.S_COPY { "COPY FROM" }
        lexdb_sql.S_MERGE { "MERGE" }
        lexdb_sql.S_CREATE_ROUTINE { "CREATE FUNCTION" }
        lexdb_sql.S_DROP_ROUTINE { "DROP FUNCTION" }
        lexdb_sql.S_ALTER_DB { "ALTER DATABASE" }
        lexdb_sql.S_SP_RENAME { "EXECUTE" }
        else { "DELETE" }
    }
}

// 'I' idle, 'T' in a transaction block, 'E' in a failed one.
pub fn (s: &Session) status(): byte {
    if len(s.txn) == 0 { return 'I' }
    return if s.failed { 'E' } else { 'T' }
}

fn execIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
          lim: Limits, pc: mut &PlanCache, input: &CopyInput, out: &fn(int, &[]byte): bool, pull: &fn(): CopyPart,
          sink: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool): Result[Res, DbErr] {
    try bindSeqs(st, txn, &s.seqNames)
    // with subqueries, the outer values they use are numbered after all the
    // statement's parameters: those not sent are NULL
    let subs = hasSubs(s)
    let want = if s.params > len(ptypes) { s.params } else { len(ptypes) }
    var r: Result[Res, DbErr] = Err(e("XX000", "unreachable"))
    if subs && len(params) < want {
        var ps: []Val = []
        for v in params { append(mut &ps, v.clone()) }
        while len(ps) < want { append(mut &ps, Val.Null) }
        r = execStmt(st, txn, s, &ps, ptypes, lim, pc, input, out, pull, sink)
    } else {
        r = execStmt(st, txn, s, params, ptypes, lim, pc, input, out, pull, sink)
    }
    match move(r) {
        Ok(res) { return Ok(res) }
        Err(x) {
            // Rows that do not read in the table as the statement found it
            // (a row's layout number past its table's): a statement reading
            // the live tree read the catalog, then rows another session wrote
            // after changing it (9.120). What it read has changed, so it is a
            // conflict, as its commit would be: outside a block it runs again.
            if x.state == lexdb_base.S_CORRUPT && st.liveStale(txn) { return Err(lexdb_base.conflict()) }
            return Err(x)
        }
    }
}

fn hasSubs(s: &lexdb_sql.Stmt): bool {
    if len(s.subs) > 0 { return true }
    for x in s.inner { if hasSubs(&x) { return true } }
    return false
}

fn execStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
            lim: Limits, pc: mut &PlanCache, input: &CopyInput, out: &fn(int, &[]byte): bool, pull: &fn(): CopyPart,
            sink: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool): Result[Res, DbErr] {
    if st.follower().isSome() {
        match writesOn(s) {
            Some(what) { return Err(lexdb_base.err(lexdb_base.S_READ_ONLY, &("cannot execute " + what + " in a read-only transaction"))) }
            None {}
        }
    }
    if len(s.wins) > 0 && s.kind != lexdb_sql.S_SELECT {
        let what = if len(s.items) > 0 && s.kind != lexdb_sql.S_SELECT { "RETURNING" } else { stmtName(s.kind) }
        return Err(e("42P20", &("window functions are not allowed in " + what)))
    }
    match s.kind {
        lexdb_sql.S_CREATE {
            if len(s.inner) > 0 { return createTableAs(st, txn, s, params, ptypes, lim) }
            return createTable(st, txn, s)
        }
        lexdb_sql.S_DROP { return dropTable(st, txn, s) }
        lexdb_sql.S_INSERT { return insert(st, txn, s, params, lim) }
        lexdb_sql.S_SELECT { return select(st, txn, s, params, ptypes, lim, pc, sink) }
        lexdb_sql.S_UPDATE { return update(st, txn, s, params, lim) }
        lexdb_sql.S_DELETE { return delete(st, txn, s, params, lim) }
        lexdb_sql.S_MERGE { return merge(st, txn, s, params, lim) }
        lexdb_sql.S_CREATE_INDEX { return createIndex(st, txn, s) }
        lexdb_sql.S_ANALYZE { return analyzeStmt(st, txn, s, lim) }
        lexdb_sql.S_DROP_INDEX { return dropIndex(st, txn, s) }
        lexdb_sql.S_CREATE_SCHEMA { return createSchemaStmt(st, txn, s) }
        lexdb_sql.S_CREATE_ROLE, lexdb_sql.S_ALTER_ROLE, lexdb_sql.S_DROP_ROLE { return roleStmt(st, txn, s) }
        lexdb_sql.S_CREATE_VIEW { return createView(st, txn, s) }
        lexdb_sql.S_GRANT, lexdb_sql.S_REVOKE { return grantStmt(st, txn, s) }
        lexdb_sql.S_OWNER { return ownerStmt(st, txn, s) }
        lexdb_sql.S_CREATE_TYPE { return createType(st, txn, s) }
        lexdb_sql.S_DROP_TYPE { return dropType(st, txn, s) }
        lexdb_sql.S_ALTER_TYPE { return alterType(st, txn, s) }
        lexdb_sql.S_TRUNCATE { return truncate(st, txn, s) }
        lexdb_sql.S_MAINT { return maint(st, txn, s) }
        lexdb_sql.S_DROP_VIEW { return dropView(st, txn, s) }
        lexdb_sql.S_ALTER_VIEW { return alterView(st, txn, s) }
        lexdb_sql.S_ALTER_DB { return alterDatabase(st, txn, s) }
        lexdb_sql.S_SP_RENAME { return spRename(st, txn, s, lim) }
        lexdb_sql.S_DROP_SCHEMA { return dropSchema(st, txn, s) }
        lexdb_sql.S_ALTER { return alterTable(st, txn, s, lim) }
        lexdb_sql.S_ALTER_INDEX { return alterIndex(st, txn, s) }
        lexdb_sql.S_ALTER_SCHEMA { return alterSchema(st, txn, s) }
        lexdb_sql.S_CREATE_SEQ { return createSeq(st, txn, s) }
        lexdb_sql.S_ALTER_SEQ { return alterSeq(st, txn, s) }
        lexdb_sql.S_DROP_SEQ { return dropSeq(st, txn, s) }
        lexdb_sql.S_CREATE_ROUTINE { return createRoutine(st, txn, s) }
        lexdb_sql.S_DROP_ROUTINE { return dropRoutine(st, txn, s) }
        lexdb_sql.S_COPY { return copyStmt(st, txn, s, params, ptypes, lim, pc, input, out, pull) }
        lexdb_sql.S_EXPLAIN { return explain(st, txn, s, params, lim, ptypes) }
        else { return Err(e("XX000", "not a data statement")) }
    }
}

// What a statement would write, refused on a replica before it runs (as a
// PostgreSQL standby does): None for a query, COPY TO, and EXPLAIN without
// ANALYZE of a write. A write the statement gets to anyway (a sequence's
// nextval) fails at its commit (lexdb_store.readOnly).
fn writesOn(s: &lexdb_sql.Stmt): Option[str] {
    if s.kind == lexdb_sql.S_SELECT && s.lockMode > 0 { return Some("SELECT " + lexdb_sql.lockName(s.lockMode)) }
    if s.kind == lexdb_sql.S_SELECT { return None }
    if s.kind == lexdb_sql.S_COPY { return if s.copy.from { Some("COPY FROM") } else { None } }
    if s.kind == lexdb_sql.S_EXPLAIN {
        if s.ifFlag && len(s.inner) > 0 { return writesOn(&s.inner[0]) }
        return None
    }
    return Some(stmtName(s.kind))
}

// Converts the parameters a client sent as text to values of their types.
pub fn paramVals(texts: &[]Option[str], ptypes: &[]int): Result[[]Val, DbErr] { return paramValsIn(texts, ptypes, lexdb_time.utc()) }

// paramVals, a date or time read in zone z (the session's).
fn paramValsIn(texts: &[]Option[str], ptypes: &[]int, z: &lexdb_time.Zone): Result[[]Val, DbErr] {
    var out: []Val = []
    for i in 0..len(texts) {
        match texts[i] {
            None { append(mut &out, Val.Null) }
            Some(s) {
                let oid = if i < len(ptypes) { ptypes[i] } else { lexdb_sql.OID_TEXT }
                var ty = lexdb_sql.TypeName{kind: lexdb_sql.K_TEXT, oid: lexdb_sql.OID_TEXT, prec: 0, scale: 0, len: 0}
                if oid == lexdb_sql.OID_INT8 || oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT2 {
                    ty = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
                } else if oid == lexdb_sql.OID_BOOL {
                    ty = lexdb_sql.TypeName{kind: lexdb_sql.K_BOOL, oid: oid, prec: 0, scale: 0, len: 0}
                } else if oid == lexdb_sql.OID_NUMERIC {
                    ty = lexdb_sql.TypeName{kind: lexdb_sql.K_NUM, oid: oid, prec: 0, scale: 0, len: 0}
                } else if lexdb_sql.elemOid(oid) > 0 || lexdb_sql.timeKind(oid) > 0 || oid == lexdb_sql.OID_UUID || oid == lexdb_sql.OID_BYTEA || oid == lexdb_sql.OID_FLOAT4 || oid == lexdb_sql.OID_FLOAT8 {
                    ty = lexdb_sql.oidType(oid)
                }
                append(mut &out, try lexdb_ops.coerceZ(Val.Text(s.toStr()), &ty, z))
            }
        }
    }
    return Ok(out)
}

// Runs one statement: in the open transaction block, or in a transaction of
// its own that is committed at once (retried a few times on a
// serialization failure: nothing the client saw depends on the first try).
pub fn (s: mut &Session) run(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int): Result[Res, DbErr] {
    var pc = oneShot()
    return s.runCached(stmt, params, ptypes, mut &pc)
}

// run, keeping a SELECT's plan in pc for the next run of the same statement.
pub fn (s: mut &Session) runCached(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &PlanCache): Result[Res, DbErr] {
    let r = s.runIn(stmt, params, ptypes, pc, &noInput(), noOut, noPull, noSink)
    if len(s.txn) == 0 { advRelease(&s.st, s.id, false) }      // its transaction over: its advisory locks (9.86)
    return r
}

// runCached with a SELECT's rows given to sink as they are made, so they
// are not all held (runSelTo): sink(cols, [], ob, true) first, then each
// row (sink(cols, row, ob, false), ob.n 0) or batch of rows (sink(cols,
// [], ob, false), ob.n > 0: OutBatch, 9.101); the result then has the
// columns and tag, no rows. Rows that need
// anything after the scan (a sort, grouping ...) are held and in the
// result, sink not asked. sink giving false for a row (the client gone)
// ends the statement (08006).
pub fn (s: mut &Session) runRows(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &PlanCache,
                                 sink: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool): Result[Res, DbErr] {
    let r = s.runIn(stmt, params, ptypes, pc, &noInput(), noOut, noPull, sink)
    if len(s.txn) == 0 { advRelease(&s.st, s.id, false) }
    return r
}

// runCached for COPY ... TO STDOUT, its lines given to out as they are
// made, not kept: out(n, b) is given b, CopyData messages (a line each) of
// a query of n columns, at least once (b may be empty), and gives false if
// they could not be sent (the statement then ends, 08006). The result is
// COPY_NONE with its tag only.
pub fn (s: mut &Session) runOut(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &PlanCache,
                                out: &fn(int, &[]byte): bool): Result[Res, DbErr] {
    let r = s.runIn(stmt, params, ptypes, pc, &CopyInput{have: false, data: "", fail: "", proto: false, stream: true, pull: false}, out, noPull, noSink)
    if len(s.txn) == 0 { advRelease(&s.st, s.id, false) }
    return r
}

fn noOut(n: int, b: &[]byte): bool { return false }

// COPY FROM STDIN with the client's input (after run gave COPY_IN): its
// rows inserted, as one statement.
pub fn (s: mut &Session) copyIn(stmt: &lexdb_sql.Stmt, input: &CopyInput): Result[Res, DbErr] {
    var pc = oneShot()
    let none: []Val = []
    let nt: []int = []
    return s.runIn(stmt, &none, &nt, mut &pc, &input, noOut, noPull, noSink)
}

// copyIn with the data as it arrives (9.87): pull gives its parts, the
// last with end set. Not run again on a conflict at its commit (40001):
// what was read is gone.
pub fn (s: mut &Session) copyInFrom(stmt: &lexdb_sql.Stmt, pull: &fn(): CopyPart): Result[Res, DbErr] {
    var pc = oneShot()
    let none: []Val = []
    let nt: []int = []
    return s.runIn(stmt, &none, &nt, mut &pc, &CopyInput{have: true, data: "", fail: "", proto: false, stream: false, pull: true}, noOut, pull, noSink)
}

fn (s: mut &Session) runIn(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &PlanCache,
                           input: &CopyInput, out: &fn(int, &[]byte): bool, pull: &fn(): CopyPart,
                           sink: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool): Result[Res, DbErr] {
    // current_setting and set_config read and change the session's settings (9.92)
    var marked = false
    for n in stmt.seqNames { if n == lexdb_sql.SET_MARK { marked = true } }
    if !marked { return s.runStmt(stmt, params, ptypes, pc, input, out, pull, sink) }
    s.publishSettings()
    let r = s.runStmt(stmt, params, ptypes, pc, input, out, pull, sink)
    if r.isOk() { try s.takeSetConfigs() } else { s.st.memo.put(&setCfgKey(s.id), &"") }
    return r
}

fn (s: mut &Session) runStmt(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &PlanCache,
                             input: &CopyInput, out: &fn(int, &[]byte): bool, pull: &fn(): CopyPart,
                             sink: &fn(&[]OutCol, &[]Val, &OutBatch, bool): bool): Result[Res, DbErr] {
    // a block's first statement may be a WAITFOR: any other but a
    // savepoint's (and BEGIN's, which does nothing in a block) ends that
    if !stmt.waitFor && stmt.kind != lexdb_sql.S_SAVEPOINT && stmt.kind != lexdb_sql.S_RELEASE &&
       stmt.kind != lexdb_sql.S_ROLLBACK_TO && stmt.kind != lexdb_sql.S_BEGIN { s.fresh = false }
    // PostgreSQL's SQL functions it calls, written as their bodies (package F)
    if stmt.kind == lexdb_sql.S_SELECT || stmt.kind == lexdb_sql.S_INSERT || stmt.kind == lexdb_sql.S_UPDATE || stmt.kind == lexdb_sql.S_DELETE ||
       stmt.kind == lexdb_sql.S_MERGE {
        match try s.inlineFunctions(stmt) {
            Some(t) { return s.runStmt(&t, params, ptypes, pc, input, out, pull, sink) }
            None {}
        }
    }
    match stmt.kind {
        lexdb_sql.S_EMPTY { return Ok(tagOnly("")) }
        lexdb_sql.S_CALL { return s.callRoutine(stmt, params, ptypes) }
        lexdb_sql.S_SHOW { return s.show(&stmt.table) }
        lexdb_sql.S_SET {
            if strings.startsWith(&stmt.table, "discard:") { return s.discard(&stmt.table[8..len(stmt.table)]) }
            if stmt.table == "role" || stmt.table == "session_authorization" { return s.setRole(stmt) }
            if strings.startsWith(&stmt.table, "constraints:") {
                // outside a block it does nothing (PostgreSQL warns)
                if len(s.txn) == 0 { return Ok(tagOnly("SET CONSTRAINTS")) }
                if s.failed { return Err(e("25P02", "current transaction is aborted, commands ignored until end of transaction block")) }
                let st = s.st.share()
                match setConstraints(&st, mut &s.txn[0], stmt) {
                    Ok(_) { return Ok(tagOnly("SET CONSTRAINTS")) }
                    Err(x) {
                        s.failed = true
                        return Err(x)
                    }
                }
            }
            if strings.contains(&stmt.table, ".") {
                // a custom setting (9.92)
                let v: &str = if stmt.ifFlag || len(stmt.names) == 0 { "\x01" } else { &stmt.names[0] }
                try s.applySetting(&stmt.table, v, len(stmt.names) > 1)
                return Ok(tagOnly(if stmt.ifFlag { "RESET" } else { "SET" }))
            }
            if stmt.table == "search_path" {
                if stmt.ifFlag || len(stmt.names) == 0 { s.setPath(&["public"]) } else { s.setPath(&stmt.names) }
                return Ok(tagOnly(if stmt.ifFlag { "RESET" } else { "SET" }))
            }
            if stmt.table == "timezone" {
                // SET [LOCAL] TIME ZONE, SET timezone, RESET (9.95): the value in names (then "local")
                let v: &str = if stmt.ifFlag || len(stmt.names) == 0 { "\x01" } else { &stmt.names[0] }
                try s.applySetting(&stmt.table, v, len(stmt.names) > 1)
                return Ok(tagOnly(if stmt.ifFlag { "RESET" } else { "SET" }))
            }
            if stmt.table == "all" {
                s.resetAll()
            } else if stmt.table == "lexdb_planner" {
                // cost (the default): statistics from ANALYZE break the rules'
                // ties; rules: they are not read (optimizer 20)
                var rules = false                   // DEFAULT, RESET
                match stmt.limit {
                    Some(x) {
                        let noCols: []lexdb_sql.ColDef = []
                        let none: []Val = []
                        let noSubs: []SubRes = []
                        let noSeq: Option[SeqEnv] = None
                        let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none, seq: &noSeq}
                        let v = match try eval(&x, &env) { Val.Text(t) { strings.toLowerAscii(&t) } else { "" } }
                        if v == "rules" { rules = true } else if v != "cost" {
                            return Err(e("22023", "invalid value for parameter \"lexdb_planner\": use cost or rules"))
                        }
                    }
                    None {}
                }
                s.rules = rules
                if len(s.txn) > 0 { s.txn[0].sql.rules = rules }
            } else if stmt.table == "lexdb_batch" {
                var on = true                       // DEFAULT, RESET
                match stmt.limit {
                    Some(x) {
                        let noCols: []lexdb_sql.ColDef = []
                        let none: []Val = []
                        let noSubs: []SubRes = []
                        let noSeq: Option[SeqEnv] = None
                        let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none, seq: &noSeq}
                        let v = try eval(&x, &env)
                        let b = match v { Val.Text(t) { lexdb_ops.parseBool(&t) } Val.Bool(y) { Some(y) } else { None } }
                        match b {
                            Some(y) { on = y }
                            None { return Err(e("22023", "parameter \"lexdb_batch\" requires a Boolean value")) }
                        }
                    }
                    None {}
                }
                s.batch = on
            } else if stmt.table == "lexdb_autoanalyze" {
                var on = true                       // DEFAULT, RESET
                match stmt.limit {
                    Some(x) {
                        let noCols: []lexdb_sql.ColDef = []
                        let none: []Val = []
                        let noSubs: []SubRes = []
                        let noSeq: Option[SeqEnv] = None
                        let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none, seq: &noSeq}
                        let v = try eval(&x, &env)
                        let b = match v { Val.Text(t) { lexdb_ops.parseBool(&t) } Val.Bool(y) { Some(y) } else { None } }
                        match b {
                            Some(y) { on = y }
                            None { return Err(e("22023", "parameter \"lexdb_autoanalyze\" requires a Boolean value")) }
                        }
                    }
                    None {}
                }
                s.auto = on
            } else if stmt.table == "lexdb_range_delete" {
                var on = true                       // DEFAULT, RESET
                match stmt.limit {
                    Some(x) {
                        let noCols: []lexdb_sql.ColDef = []
                        let none: []Val = []
                        let noSubs: []SubRes = []
                        let noSeq: Option[SeqEnv] = None
                        let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none, seq: &noSeq}
                        let v = try eval(&x, &env)
                        let b = match v { Val.Text(t) { lexdb_ops.parseBool(&t) } Val.Bool(y) { Some(y) } else { None } }
                        match b {
                            Some(y) { on = y }
                            None { return Err(e("22023", "parameter \"lexdb_range_delete\" requires a Boolean value")) }
                        }
                    }
                    None {}
                }
                s.rdel = on
            } else if stmt.table != "" {
                var v = -1                          // DEFAULT, RESET
                match stmt.limit {
                    Some(x) {
                        let noCols: []lexdb_sql.ColDef = []
                        let none: []Val = []
                        let noSubs: []SubRes = []
                        let noSeq: Option[SeqEnv] = None
                        let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none, seq: &noSeq}
                        v = try settingValue(&stmt.table, &(try eval(&x, &env)))
                    }
                    None {}
                }
                if stmt.table == "max_recursion" { s.maxRecursion = if v < 0 { MAX_RECURSION } else { v } }
                if stmt.table == "max_match_steps" { s.maxSteps = if v < 0 { MAX_MATCH_STEPS } else { v } }
                if stmt.table == "statement_timeout" { s.timeoutMs = if v < 0 { 0 } else { v } }
                if stmt.table == "max_statement_mem" {
                    s.maxMem = if v < 0 { MAX_STATEMENT_MEM } else { v }
                    if len(s.txn) > 0 { s.txn[0].sql.memMax = s.maxMem }
                }
            }
            return Ok(tagOnly(if stmt.ifFlag { "RESET" } else { "SET" }))
        }
        lexdb_sql.S_BEGIN {
            if len(s.txn) == 0 {
                lexdb_stats.chgEnd(&s.st, s.id, false)          // (counts an earlier failed statement left: optimizer 44)
                if stmt.ifFlag {
                    append(mut &s.txn, try s.st.beginSnapshot())     // READ ONLY: a snapshot (4.5)
                } else {
                    append(mut &s.txn, try s.st.beginBlock())       // a snapshot with its writes (9.16)
                }
                s.readOnly = stmt.ifFlag
                s.failed = false
                s.fresh = true
                s.saves = []
                s.saved = [Limits{rounds: s.maxRecursion, steps: s.maxSteps, mem: s.maxMem, deadline: s.timeoutMs, batch: s.batch, rules: s.rules, auto: s.auto, rdel: s.rdel}]
                var p: []str = []
                for n in s.path { append(mut &p, n.clone()) }
                s.savedPath = [p]
                s.savedRoles = [s.st.memo.get(&roleKeyOf(s.id)).unwrapOr("") + "\n" + s.st.memo.get(&sessAuthKey(s.id)).unwrapOr("")]
                var cs: []str = []
                for c in s.custom { append(mut &cs, c.clone()) }
                s.savedCustom = [cs]
                s.localUndo = []
                s.savedZone = [s.zone.clone()]
                let q = s.txnPath()
                s.txn[0].sql.path = q
                s.txn[0].tmp = s.tmp.clone()
                s.txn[0].sql.sess = s.id
                s.txn[0].sql.zone = s.zone.clone()
                s.txn[0].sql.rules = s.rules
                s.txn[0].sql.memMax = s.maxMem
            }
            return Ok(tagOnly("BEGIN"))
        }
        lexdb_sql.S_COMMIT {
            if len(s.txn) == 0 { return Ok(tagOnly("COMMIT")) }
            s.saves = []
            // the deferred foreign key checks (9.85): one failing rolls back
            if !s.failed && len(s.txn[0].sql.pending) > 0 {
                let st = &s.st
                let all: Option[[]str] = None
                match checkPending(&st, mut &s.txn[0], &all) {
                    Ok(_) {}
                    Err(x) {
                        let t = pop(mut &s.txn)
                        s.tmpUndo(&t)
                        s.st.abort(t)
                        s.restore()
                        return Err(x)
                    }
                }
            }
            // its temporary tables' ON COMMIT (9.96)
            var kept: []str = []
            if !s.failed && ((len(s.onCommit) > 0 && s.txn[0].hasWrites()) || len(s.txn[0].onCommit) > 0) {
                let st = &s.st
                let have = collections.copyOf(&s.onCommit)
                match onCommitDo(&st, mut &s.txn[0], &have) {
                    Ok(k) { kept = k }
                    Err(x) {
                        let t = pop(mut &s.txn)
                        s.tmpUndo(&t)
                        s.st.abort(t)
                        s.restore()
                        return Err(x)
                    }
                }
            } else {
                kept = collections.copyOf(&s.onCommit)
            }
            let t = pop(mut &s.txn)
            if s.failed {
                s.failed = false
                s.tmpUndo(&t)
                s.st.abort(t)
                s.restore()
                lexdb_stats.chgEnd(&s.st, s.id, false)
                return Ok(tagOnly("ROLLBACK"))
            }
            s.saved = []
            s.savedPath = []
            s.savedRoles = []
            s.undoLocal()
            s.savedCustom = []
            s.savedZone = []
            let ddl = t.tmpDdl
            match s.st.commit(t) {
                Ok(_) {
                    s.onCommit = kept
                    lexdb_stats.chgEnd(&s.st, s.id, s.auto)
                }
                Err(x) {
                    lexdb_stats.chgEnd(&s.st, s.id, false)
                    if ddl { tmpChanged(&s.st, s.id) }
                    return Err(x)
                }
            }
            return Ok(tagOnly("COMMIT"))
        }
        lexdb_sql.S_ROLLBACK {
            if len(s.txn) > 0 {
                let t = pop(mut &s.txn)
                s.tmpUndo(&t)
                s.st.abort(t)
            }
            lexdb_stats.chgEnd(&s.st, s.id, false)
            s.failed = false
            s.saves = []
            s.restore()
            return Ok(tagOnly("ROLLBACK"))
        }
        lexdb_sql.S_SAVEPOINT, lexdb_sql.S_RELEASE, lexdb_sql.S_ROLLBACK_TO {
            let what = if stmt.kind == lexdb_sql.S_SAVEPOINT { "SAVEPOINT" } else if stmt.kind == lexdb_sql.S_RELEASE { "RELEASE SAVEPOINT" } else { "ROLLBACK TO SAVEPOINT" }
            if len(s.txn) == 0 { return Err(e("25P01", &(what + " can only be used in transaction blocks"))) }
            if s.failed && stmt.kind != lexdb_sql.S_ROLLBACK_TO {
                return Err(e("25P02", "current transaction is aborted, commands ignored until end of transaction block"))
            }
            if stmt.kind == lexdb_sql.S_SAVEPOINT {
                append(mut &s.saves, SavePt{name: stmt.table.clone(), mark: s.txn[0].mark(), fresh: s.fresh})
                return Ok(tagOnly("SAVEPOINT"))
            }
            var i = len(s.saves) - 1
            while i >= 0 && s.saves[i].name != stmt.table { i -= 1 }
            if i < 0 {
                s.failed = true
                return Err(e("3B001", &("savepoint \"" + stmt.table + "\" does not exist")))
            }
            if stmt.kind == lexdb_sql.S_RELEASE {
                while len(s.saves) > i { let x = pop(mut &s.saves) }
                return Ok(tagOnly("RELEASE"))
            }
            // ROLLBACK TO: its writes since, and the error if any, gone; it stays
            s.txn[0].undoTo(s.saves[i].mark)
            if s.txn[0].tmpDdl { tmpChanged(&s.st, s.id) }          // (temporary objects' DDL may be gone, 9.96)
            while len(s.saves) > i + 1 { let x = pop(mut &s.saves) }
            s.failed = false
            s.fresh = s.saves[i].fresh
            return Ok(tagOnly("ROLLBACK"))
        }
        else {}
    }
    if len(s.txn) > 0 {
        if s.failed {
            return Err(e("25P02", "current transaction is aborted, commands ignored until end of transaction block"))
        }
        if stmt.waitFor {
            let r = s.waitForRun(stmt, params, ptypes, pc)
            s.fresh = false
            if r.isErr() { s.failed = true }
            return r
        }
        if s.readOnly && (isWrite(stmt.kind) || (stmt.kind == lexdb_sql.S_COPY && stmt.copy.from)) && !s.tempWrite(stmt) {
            s.failed = true
            return Err(e("25006", &("cannot execute " + stmtName(stmt.kind) + " in a read-only transaction")))
        }
        if s.readOnly && stmt.kind == lexdb_sql.S_SELECT && stmt.lockMode > 0 {
            s.failed = true
            return Err(e("25006", &("cannot execute SELECT " + lexdb_sql.lockName(stmt.lockMode) + " in a read-only transaction")))
        }
        let st = &s.st
        // UPDATE and DELETE read the live tree: the rows they change are
        // checked at COMMIT either way, and the latest is less often stale
        s.txn[0].live = stmt.kind == lexdb_sql.S_UPDATE || stmt.kind == lexdb_sql.S_DELETE || stmt.kind == lexdb_sql.S_INSERT || stmt.kind == lexdb_sql.S_MERGE ||
                        (stmt.kind == lexdb_sql.S_COPY && stmt.copy.from) || (stmt.kind == lexdb_sql.S_SELECT && stmt.lockMode > 0)
        if s.readOnly { s.txn[0].live = false }       // (a temporary table's writes: its snapshot is the session's own, 9.96)
        let r = execIn(&st, mut &s.txn[0], stmt, params, ptypes, s.limits(), pc, input, out, pull, sink)
        s.txn[0].live = false
        if len(s.tmp) == 0 && len(s.txn[0].tmp) > 0 { s.tmp = s.txn[0].tmp.clone() }
        if r.isErr() {
            s.failed = true
            return r
        }
        return r
    }
    if stmt.waitFor { return s.waitForRun(stmt, params, ptypes, pc) }
    var tries = 0
    let noticesWere = s.st.memo.get(&noticeKey(s.id)).unwrapOr("")
    let lim = s.limits()                    // retries share the statement's time
    while true {
        // A SELECT runs on a snapshot: it sees one state and never conflicts.
        // It may be long, letting other sessions run (Run.tick) and commit
        // meanwhile; run optimistically, it would conflict with them and
        // run again (design/lexdb.md 9.15). A snapshot whose old versions
        // went over their budget (72000) is tried again on a new one.
        // (a SELECT that locks reads the latest, as UPDATE does). EXPLAIN
        // too (optimizer 19): EXPLAIN ANALYZE runs only a SELECT, and on the same
        // kind of transaction as the SELECT it shows, so that it shows what
        // the SELECT does (the index-to-scan switch is off where reads are
        // noted); EXPLAIN alone writes nothing
        let explained = stmt.kind == lexdb_sql.S_EXPLAIN && len(stmt.inner) > 0 && stmt.inner[0].lockMode == 0
        let snap = (stmt.kind == lexdb_sql.S_SELECT && stmt.lockMode == 0) || explained || (stmt.kind == lexdb_sql.S_COPY && !stmt.copy.from)
        var t = if snap { try s.st.beginSnapshot() } else { lexdb_store.begin() }
        s.setUp(mut &t)
        lexdb_stats.chgEnd(&s.st, s.id, false)          // (a try before that failed: its counts go, optimizer 44)
        // (and its notices: those of the statements before kept)
        if len(noticesWere) > 0 { s.st.memo.put(&noticeKey(s.id), &noticesWere) } else { s.st.memo.del(&noticeKey(s.id)) }
        var sent = false
        let ran = execIn(&s.st, mut &t, stmt, params, ptypes, lim, pc, input, out, pull, fn(c: &[]OutCol, r: &[]Val, ob: &OutBatch, start: bool): bool {
            let ok = sink(c, r, ob, start)
            if ok { sent = true }
            return ok
        })
        match move(ran) {
            Ok(r) {
                s.adopt(&t)
                // its temporary tables' ON COMMIT (9.96)
                var kept = collections.copyOf(&s.onCommit)
                if (len(s.onCommit) > 0 && t.hasWrites()) || len(t.onCommit) > 0 {
                    match onCommitDo(&s.st, mut &t, &kept) {
                        Ok(k) { kept = k }
                        Err(x) {
                            s.tmpUndo(&t)
                            s.st.abort(t)
                            return Err(x)
                        }
                    }
                }
                let ddl = t.tmpDdl
                match s.st.commit(t) {
                    Ok(_) {
                        s.onCommit = kept
                        lexdb_stats.chgEnd(&s.st, s.id, s.auto)
                        return Ok(r)
                    }
                    Err(x) {
                        if ddl { tmpChanged(&s.st, s.id) }
                        tries += 1
                        // (a COPY whose data was read as it came, or that committed
                        // batches, cannot run again)
                        if x.state != lexdb_base.S_CONFLICT || tries >= 10 || input.pull || stmt.copy.batchRows > 0 { return Err(x) }
                    }
                }
            }
            Err(x) {
                s.adopt(&t)
                s.tmpUndo(&t)
                s.st.abort(t)
                tries += 1
                // (a COPY TO sent as it ran is not run again, nor a SELECT whose rows went out).
                // A conflict found as it ran (it read the live tree: execIn's
                // stale reads, 9.120) is run again, as one its commit finds is
                let again = (snap && x.state == "72000") ||
                            (!snap && x.state == lexdb_base.S_CONFLICT && !input.pull && stmt.copy.batchRows == 0)
                if !again || tries >= 10 || input.stream || sent { return Err(x) }
            }
        }
    }
    return Err(e("XX000", "unreachable"))
}

// ---- WAITFOR (SELECT ...) [, TIMEOUT ms] (design/lexdb-events.md)
//
// An event stream is a table; a consumer reads the rows after its cursor
// with a SELECT that waits for them. The SELECT runs on a snapshot; given
// no rows, the snapshot is let go and the session waits for a flush past
// it (Store.waitDurable), then runs it again on a new one, until it gives
// rows or its time is up (one last run then, its rows or none).
// - Woken after the flush, as snapshots read: it shows only durable rows.
// - In a block it must be the first statement: the block's snapshot is
//   taken again for each run, so the block begins when the wait ends. Its
//   reads are not noted (as a locking SELECT's, 9.86): else a consumer that
//   read to the stream's end would fail its commit (40001) at every
//   producer's commit. That is sound for its one shape (waitShape): rows
//   after a cursor, in order, which producers only add to.
// - TIMEOUT is capped (WAITFOR_CAP_MS), and none means the cap: the
//   connection is not read while it waits, so a client gone or a cancel
//   is seen only when it ends. statement_timeout ends it first (57014).

pub const WAITFOR_CAP_MS = 60000

fn waitRefused(m: &str): DbErr { return e("0A000", &("lexdb: WAITFOR " + m)) }

// The column of table t an expression names (bare, or qualified by the
// FROM item's alias or the table's name); -1 none.
fn waitCol(x: &Expr, t: &Table, alias: &str): int {
    match x {
        Expr.Col(n, _) {
            let d = strings.indexOf(&n, ".", 0)
            if d < 0 { return colIndex(&t.cols, &n) }
            let q = n[0..d]
            if q != alias && q != lexdb_sql.baseName(&t.name) { return -1 }
            return colIndex(&t.cols, &n[d + 1..len(n)])
        }
        else { return -1 }
    }
}

// A value the statement is given: a literal or a parameter, cast or not.
fn waitConst(x: &Expr): bool {
    match x {
        Expr.Lit(_) { return true }
        Expr.Param(_) { return true }
        Expr.Cast(a, _) { return waitConst(&a) }
        Expr.Unary(op, a) { return op == "-" && waitConst(&a) }            // seq > -1
        else { return false }
    }
}

// Whether an index begins with some of the equalities' columns (in any
// order, none at all), then the cursor's: its rows after the cursor are
// read in order from one place.
fn waitFits(cols: &[]int, eqs: &[]int, cur: int): bool {
    for i in 0..len(cols) {
        if cols[i] == cur { return true }
        var found = false
        for c in eqs { if cols[i] == c { found = true } }
        if !found { return false }
    }
    return false
}

// The one query WAITFOR runs: from one ordinary table, ORDER BY c, WHERE
// c > v (or >=, v a literal or a parameter), a LIMIT, and an index on (k
// ..., c) whose k are columns WHERE gives with k = v. WHERE's other
// conditions are filters: they read the row alone (one table, no
// subqueries) and change nothing (no nextval or set_config). No grouping,
// aggregates, DISTINCT, windows, OFFSET or locking. Others are refused
// (0A000): their reads could not go unnoted, an aggregate always gives a
// row, and each would run again for every waiter at every flush. A filter
// the index does not hold is cheap only when most rows pass it: the rows
// after the cursor that fail it are read again at every wake.
fn waitShape(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, stmt: &lexdb_sql.Stmt): Result[Unit, DbErr] {
    if st.follower().isSome() { return Err(waitRefused("is not supported on a replica")) }
    if stmt.lockMode > 0 { return Err(waitRefused("cannot be used with FOR UPDATE, FOR SHARE and the like")) }
    if stmt.setop != 0 || len(stmt.from) != 1 || stmt.from[0].sub >= 0 {
        return Err(waitRefused("needs a SELECT from one ordinary table"))
    }
    // (AS e(a, b) would rename the columns the rules below name)
    if len(stmt.from[0].cols) > 0 { return Err(waitRefused("cannot rename its table's columns (AS t(a, b, ...))")) }
    if len(stmt.subs) > 0 { return Err(waitRefused("cannot have subqueries")) }
    var gathers = len(stmt.group) > 0 || stmt.having.isSome() || stmt.distinct || len(stmt.distinctOn) > 0 || len(stmt.wins) > 0
    for it in stmt.items {
        match it.expr {
            Some(x) { if hasAgg(&x) { gathers = true } }
            None {}
        }
    }
    if gathers { return Err(waitRefused("cannot have aggregates, GROUP BY, DISTINCT or windows")) }
    if stmt.offset.isSome() || stmt.withTies || stmt.topMode != 0 { return Err(waitRefused("cannot have OFFSET, WITH TIES or TOP's options")) }
    if stmt.limit.isNone() { return Err(waitRefused("needs a LIMIT (or TOP)")) }
    let f = &stmt.from[0]
    let found = try findTable(st, txn, &f.table)
    if found.isNone() {
        let n = lexdb_sql.shown(&f.table)
        if len(lexdb_pgcat.relOf(&lexdb_sql.schemaOf(&f.table), &lexdb_sql.baseName(&f.table))) > 0 {
            return Err(waitRefused(&("reads an ordinary table: \"" + n + "\" is a catalog relation")))
        }
        return Err(e("42P01", &("relation \"" + n + "\" does not exist")))
    }
    let t = found.unwrap()
    let tn = lexdb_sql.shown(&t.name)
    if len(t.view) > 0 { return Err(waitRefused(&("reads an ordinary table: \"" + tn + "\" is a view"))) }
    if lexdb_catalog.tempRel(&t.name) { return Err(waitRefused("cannot read a temporary table: no other session can add to it")) }
    let alias = if len(f.alias) > 0 { f.alias.toStr() } else { lexdb_sql.baseName(&t.name) }
    let shape = "needs ORDER BY c, WHERE c > v and an index on (k ..., c), its k from WHERE's k = v"
    // the cursor: ORDER BY's column, ascending
    if len(stmt.order) != 1 || stmt.order[0].desc { return Err(waitRefused(&shape)) }
    let cur = waitCol(&stmt.order[0].expr, &t, &alias)
    if cur < 0 { return Err(waitRefused(&shape)) }
    // its bound (c > v or >=, or written the other way round); the
    // equalities an index may begin with; every other condition a filter
    var conj: []Expr = []
    match stmt.where {
        Some(w) { conjuncts(&w, mut &conj) }
        None {}
    }
    var eqs: []int = []
    var bound = false
    for c in conj {
        if hasAgg(&c) { return Err(waitRefused("cannot have aggregates, GROUP BY, DISTINCT or windows")) }
        match c {
            Expr.Bin(op, a, b) {
                let ca = waitCol(&a, &t, &alias)
                let cb = waitCol(&b, &t, &alias)
                if !bound && ca == cur && (op == ">" || op == ">=") && waitConst(&b) { bound = true }
                else if !bound && cb == cur && (op == "<" || op == "<=") && waitConst(&a) { bound = true }
                else if op == "=" {
                    var eq = -1
                    if ca >= 0 && waitConst(&b) { eq = ca }
                    if cb >= 0 && waitConst(&a) { eq = cb }
                    if eq >= 0 && eq != cur {
                        var have = false
                        for k in eqs { if k == eq { have = true } }
                        if !have { append(mut &eqs, eq) }
                    }
                }
            }
            else {}
        }
    }
    if !bound { return Err(waitRefused(&shape)) }
    // nextval, setval and set_config change things; current_setting is
    // marked with them (SET_MARK)
    if len(stmt.seqNames) > 0 { return Err(waitRefused("cannot call nextval, setval, currval, set_config or current_setting")) }
    var indexed = waitFits(&t.pk, &eqs, cur)
    for ix in t.indexes {
        if ix.pred.isNone() && waitFits(&ix.cols, &eqs, cur) { indexed = true }
    }
    if !indexed { return Err(waitRefused(&(shape + ": \"" + tn + "\" has no such index"))) }
    return Ok(Unit{})
}

// Runs a WAITFOR: in the open block (its first statement), or on its own.
// The block's transaction keeps a snapshot on every way out: it is let go
// only for the wait itself, and taken again before anything else.
fn (s: mut &Session) waitForRun(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &PlanCache): Result[Res, DbErr] {
    let inBlock = len(s.txn) > 0
    if inBlock && !s.fresh { return Err(waitRefused("must be the first statement of its transaction block")) }
    var nolk: []Look = []
    var ms = try evalInt(&stmt.waitMs, params, "WAIT", mut &nolk)
    if ms < 0 || ms > WAITFOR_CAP_MS / stmt.waitMul { ms = WAITFOR_CAP_MS } else { ms = ms * stmt.waitMul }
    let lim = s.limits()
    let until = time.monotonicNs() + ms * 1000000
    if inBlock { try s.st.renewSnapshot(mut &s.txn[0]) }      // BEGIN's snapshot: the block begins with the wait's end
    var last = false
    var tries = 0
    while true {
        let now = time.monotonicNs()
        if lim.deadline != 0 && now > lim.deadline { return Err(e("57014", "canceling statement due to statement timeout")) }
        if now >= until { last = true }
        var seq = 0
        if inBlock {
            // its shape on the snapshot it runs on (the table may have changed while it waited)
            try waitShape(&s.st, mut &s.txn[0], stmt)
            seq = s.txn[0].snapshotSeq()
            // its reads noted, but not past the last key each read reached
            // (Txn.openEnd): rows producers add after them do not fail the commit
            s.txn[0].openEnd = true
            let r = execIn(&s.st, mut &s.txn[0], stmt, params, ptypes, lim, pc, &noInput(), noOut, noPull, noSink)
            s.txn[0].openEnd = false
            let res = try r
            if len(res.rows) > 0 || last { return Ok(res) }
        } else {
            var t = try s.st.beginSnapshot()
            s.setUp(mut &t)
            seq = t.snapshotSeq()
            var r = waitShape(&s.st, mut &t, stmt)
            var out = tagOnly("")
            if r.isOk() {
                match execIn(&s.st, mut &t, stmt, params, ptypes, lim, pc, &noInput(), noOut, noPull, noSink) {
                    Ok(x) { out = x }
                    Err(x) { r = Err(x) }
                }
            }
            s.adopt(&t)
            if r.isErr() {
                s.st.abort(t)
                let x = r.unwrapErr()
                tries += 1
                // a snapshot too old (72000) is tried again on a new one, as a SELECT's
                if x.state == "72000" && tries < 10 { continue }
                return Err(x)
            }
            if len(out.rows) > 0 || last {
                try s.st.commit(t)
                return Ok(out)
            }
            s.st.abort(t)
        }
        // no rows: wait for a flush past what it read, to its time's end
        let end = if lim.deadline != 0 && lim.deadline < until { lim.deadline } else { until }
        let left = (end - time.monotonicNs() + 999999) / 1000000
        if left > 0 {
            if inBlock { s.st.releaseSnapshot(mut &s.txn[0]) }
            let woken = s.st.waitDurable(seq, left)
            if inBlock { try s.st.renewSnapshot(mut &s.txn[0]) }
            if !woken {
                if task.cancelled() { return Err(e("57014", "canceling statement: its session has ended")) }
                if end != until && time.monotonicNs() >= end { return Err(e("57014", "canceling statement due to statement timeout")) }
                last = true                 // its time is up, or the store is closing: one last run
            }
        } else if inBlock {
            try s.st.renewSnapshot(mut &s.txn[0])
        }
    }
    return Err(e("XX000", "unreachable"))
}

// Parses and runs SQL text with no parameters (for the tests and tools).
pub fn (s: mut &Session) exec(sql: &str): Result[[]Res, DbErr] {
    let stmts = try lexdb_parse.parse(sql)
    var out: []Res = []
    let none: []Val = []
    let nt: []int = []
    for st in stmts { append(mut &out, try s.run(&st, &none, &nt)) }
    return Ok(out)
}

// ---- foreign keys (9.41)
//
// A foreign key is kept in its table's catalog row (Table.fks), and the
// table it references names it back (Table.refBy), so that a statement on
// either finds the other. Columns are kept by name.
//
// MATCH SIMPLE: a row with a NULL in the key's columns references nothing.
// A row's key is looked up in the referenced table as it is written; one
// not there (it may come later in the statement: a table referencing
// itself) is looked up again at the statement's end. What a referenced key
// deleted or changed does waits for the statement's end too, as
// PostgreSQL's triggers do: the rows referencing it deleted or set
// (CASCADE, SET NULL, SET DEFAULT), or none may be left referencing it (NO
// ACTION, unless the key is back by then; RESTRICT).

// Table k from the catalog (k a catalog key, not a name to look up).
fn byKeyOpt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[Option[Table], DbErr] {
    match try st.get(txn, lexdb_catalog.CATALOG, k) {
        Some(v) { return Ok(Some(try decTable(k, &v))) }
        None { return Ok(None) }
    }
}

fn byKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[Table, DbErr] {
    match try byKeyOpt(st, txn, k) {
        Some(t) { return Ok(t) }
        None { return Err(lexdb_base.corrupt(&("table \"" + lexdb_sql.shown(k) + "\", which a foreign key names"))) }
    }
}

fn putTable(txn: mut &lexdb_store.Txn, t: &Table): Result[Unit, DbErr] {
    try txn.put(lexdb_catalog.CATALOG, &t.name, &(lexdb_catalog.encTable(t)))
    return Ok(Unit{})
}

fn addKey(xs: mut &[]str, k: &str) {
    for i in 0..len(xs) { if xs[i] == k { return } }
    append(xs, k.clone())
}

fn dropKey(xs: mut &[]str, k: &str) {
    var i = 0
    while i < len(xs) {
        if xs[i] == k { let gone = collections.removeAt(xs, i) } else { i += 1 }
    }
}

fn colsOf(t: &Table, names: &[]str): []int {
    var out: []int = []
    for n in names { append(mut &out, colIndex(&t.cols, &n)) }
    return out
}

// Whether the first n of xs are cols, in any order.
fn prefixSame(xs: &[]int, n: int, cols: &[]int): bool {
    if len(xs) < n || len(cols) != n { return false }
    for j in 0..n {
        var found = false
        for c in cols { if c == xs[j] { found = true } }
        if !found { return false }
    }
    return true
}

// Which of table p's unique keys is cols, in any order: -1 its primary key,
// else an index of p's (unique and not filtered), other than except; -2
// none.
fn keyIndex(p: &Table, cols: &[]int, except: int): int {
    if len(p.pk) == len(cols) && prefixSame(&p.pk, len(cols), cols) { return -1 }
    for k in 0..len(p.indexes) {
        let ix = &p.indexes[k]
        if k != except && ix.unique && ix.pred.isNone() && len(ix.cols) == len(cols) && prefixSame(&ix.cols, len(cols), cols) { return k }
    }
    return -2
}

// A foreign key's columns as numbers: its table's, the referenced table's,
// and the referenced table's key holding them (keyIndex).
type FkCols = record { cols: []int; refCols: []int; via: int }

fn fkCols(c: &Table, f: &ForeignKey, p: &Table): FkCols {
    let rc = colsOf(p, &f.refCols)
    let via = keyIndex(p, &rc, -1)
    return FkCols{cols: colsOf(c, &f.cols), refCols: rc, via: via}
}

fn valsAt(row: &[]Val, cols: &[]int): []Val {
    var out: []Val = []
    for c in cols { append(mut &out, row[c].clone()) }
    return out
}

fn hasNullAt(row: &[]Val, cols: &[]int): bool {
    for c in cols { if lexdb_ops.isNull(&row[c]) { return true } }
    return false
}

// Values as a key: equal values (1.5 and 1.50) the same.
fn encVals(vs: &[]Val): str {
    var b = ""
    for v in vs { lexdb_access.encIdxPart(mut &b, &v) }
    return b
}

// Whether table p has a row with key vals (in fc.refCols' order).
fn parentHas(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, p: &Table, fc: &FkCols, vals: &[]Val): Result[bool, DbErr] {
    var prow = array(len(p.cols), Val.Null)
    for k in 0..len(vals) { prow[fc.refCols[k]] = vals[k].clone() }
    if fc.via < -1 { return Ok(false) }
    return lexdb_access.hasKey(st, txn, &lexdb_catalog.relOf(p), fc.via, &prow,
                               fn(xi: &Index, k: int, r: &[]Val): Result[Val, DbErr] { return idxVal(p, xi, k, r) })
}

// Whether a row of table c has vals in its columns cols.
fn referenced(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, c: &Table, cols: &[]int, vals: &[]Val): Result[bool, DbErr] {
    let rows = try refRows(st, txn, c, cols, vals, true)
    return Ok(len(rows) > 0)
}

// The rows of table c with vals in its columns cols (the first only, with
// one): through its primary key or an index starting with them, else read
// whole (as PostgreSQL, lexdb makes no index for a foreign key).
fn refRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, c: &Table, cols: &[]int, vals: &[]Val, one: bool): Result[[][]Val, DbErr] {
    let n = len(cols)
    var crow = array(len(c.cols), Val.Null)
    for j in 0..n { crow[cols[j]] = vals[j].clone() }
    var path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
    var sc = lexdb_access.allScan()
    if prefixSame(&c.pk, n, cols) {
        sc = lexdb_access.prefixScan(&lexdb_catalog.relOf(c), -1, &crow, n)
    } else {
        for k in 0..len(c.indexes) {
            if path.index < 0 && c.indexes[k].pred.isNone() && prefixSame(&c.indexes[k].cols, n, cols) {
                path.index = k
                sc = lexdb_access.prefixScan(&lexdb_catalog.relOf(c), k, &crow, n)
            }
        }
    }
    let want = encVals(vals)
    let all: []bool = []
    var out: [][]Val = []
    var cur = lexdb_access.newCursor()
    while !cur.done {
        var batch: [][]Val = []
        try fetch(st, txn, c, &path, &sc, &all, mut &cur, mut &batch)
        for r in batch {
            if encVals(&valsAt(&r, cols)) == want {
                append(mut &out, collections.copyOf(&r))
                if one { return Ok(out) }
            }
        }
    }
    return Ok(out)
}

fn keyText(names: &[]str, vals: &[]Val): str {
    var vs: []str = []
    for v in vals { append(mut &vs, lexdb_sql.text(&v)) }
    return "Key (" + strings.join(names, ", ") + ")=(" + strings.join(&vs, ", ") + ")"
}

fn notPresent(c: &Table, f: &ForeignKey, p: &Table, vals: &[]Val): DbErr {
    return lexdb_base.errDetail("23503", &("insert or update on table \"" + lexdb_sql.baseName(&c.name) + "\" violates foreign key constraint \"" + f.name + "\""),
                                &(keyText(&f.cols, vals) + " is not present in table \"" + lexdb_sql.baseName(&p.name) + "\"."), "")
}

fn stillRef(p: &Table, c: &Table, f: &ForeignKey, vals: &[]Val): DbErr {
    return lexdb_base.errDetail("23503", &("update or delete on table \"" + lexdb_sql.baseName(&p.name) + "\" violates foreign key constraint \"" + f.name +
                                "\" on table \"" + lexdb_sql.baseName(&c.name) + "\""),
                                &(keyText(&f.refCols, vals) + " is still referenced from table \"" + lexdb_sql.baseName(&c.name) + "\"."), "")
}

// What a statement does at its end, in order (each may add more):
const FK_MISSING = 0    // a row's key was not in the table it references: look again
const FK_GONE = 1       // a referenced key gone (NO ACTION, RESTRICT): no row may still reference it
const FK_DELETE = 2     // ON DELETE CASCADE: the rows referencing it deleted
const FK_SET = 3        // ON ... SET NULL, SET DEFAULT, ON UPDATE CASCADE: their key's columns set

// child is the referencing table, fk its foreign key's number, vals the key
// (in the foreign key's column order); act the action (FK_GONE, FK_SET);
// to the new key (ON UPDATE CASCADE).
type FkLater = record { kind: int; child: str; fk: int; vals: []Val; act: int; to: []Val }

fn fkLater(kind: int, child: &str, fk: int, vals: []Val, act: int, to: []Val): FkLater {
    return FkLater{kind: kind, child: child.clone(), fk: fk, vals: vals, act: act, to: to}
}

// The tables a statement on t needs for its foreign keys, t itself among
// them: those it references (parents); those referencing it (children),
// and when an action writes their rows, the tables those need in turn.
// None when t has no foreign key either way.
fn fkTables(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, parents: bool, children: bool): Result[[]Table, DbErr] {
    var out: []Table = []
    if len(t.fks) == 0 && len(t.refBy) == 0 { return Ok(out) }
    let ti = try loadTab(st, txn, mut &out, &t.name)
    if parents { for f in t.fks { let pi = try loadTab(st, txn, mut &out, &f.ref) } }
    if !children { return Ok(out) }
    var written = [t.name.clone()]
    var w = 0
    while w < len(written) {
        let wn = written[w].clone()
        w += 1
        let wi = try loadTab(st, txn, mut &out, &wn)
        var kids: []str = []
        for k in out[wi].refBy { append(mut &kids, k.clone()) }
        for ck in kids {
            let ci = try loadTab(st, txn, mut &out, &ck)
            var acts = false
            var refs: []str = []
            for f in out[ci].fks {
                if f.ref == wn && (f.onDelete >= lexdb_sql.FK_CASCADE || f.onUpdate >= lexdb_sql.FK_CASCADE) { acts = true }
                append(mut &refs, f.ref.clone())
            }
            var seen = false
            for x in written { if x == ck { seen = true } }
            if acts && !seen {
                append(mut &written, ck.clone())
                for r in refs { let ri = try loadTab(st, txn, mut &out, &r) }
            }
        }
    }
    return Ok(out)
}

// The probes of a statement writing rows of t with values for targets
// (lexdb_fkprobe): one per foreign key, its key's columns found once. A key
// column the rows give no value for, or an identity column (it may take its
// default), has no place in them.
fn fkProbes(t: &Table, fw: &[]Table, targets: &[]int): lexdb_fkprobe.Probes {
    var pr = lexdb_fkprobe.none()
    for k in 0..len(t.fks) {
        let pi = findTab(fw, &t.fks[k].ref)
        let fc = fkCols(t, &t.fks[k], &fw[pi])
        var at: []int = []
        for c in fc.cols {
            var j = -1
            for x in 0..len(targets) { if targets[x] == c && t.cols[c].identity == lexdb_sql.ID_NONE { j = x } }
            append(mut &at, j)
        }
        pr.add(lexdb_fkprobe.ref(collections.copyOf(&fc.cols), collections.copyOf(&fc.refCols), fc.via, pi, at, len(fw[pi].cols)))
    }
    return pr
}

// A chunk of rows about to be written, their values in targets' order: the
// statement's probes made (for two rows or more), and the parents of their
// keys looked up together. Not under ON CONFLICT DO UPDATE (it may change a
// key other rows refer to).
fn fkAhead(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, fw: &[]Table, targets: &[]int, up: mut &Upsert,
           rows: &[][]Val): Result[Unit, DbErr] {
    if len(t.fks) == 0 || up.mode == lexdb_sql.CONFLICT_UPDATE { return Ok(Unit{}) }
    if len(up.fk.fks) == 0 {
        if len(rows) < 2 { return Ok(Unit{}) }
        up.fk = fkProbes(t, fw, targets)
    }
    return up.fk.ahead(st, txn, t, fw, rows)
}

// Whether an INSERT ... SELECT's rows may be read ahead of their writes: no
// column's value comes from a sequence or a function the query's own calls
// could interleave with (rows read ahead call theirs first).
fn plainDefaults(t: &Table, targets: &[]int, defs: &Defs): bool {
    for i in 0..len(t.cols) {
        var given = false
        for c in targets { if c == i { given = true } }
        if given {
            if t.cols[i].identity != lexdb_sql.ID_NONE { return false }
        } else if (len(defs.seqs[i].key) > 0 && t.cols[i].name != lexdb_catalog.ROWID) || defs.exprs[i].isSome() {
            return false
        }
    }
    return true
}

fn loadTab(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, out: mut &[]Table, k: &str): Result[int, DbErr] {
    for i in 0..len(out) { if out[i].name == k { return Ok(i) } }
    append(out, try byKey(st, txn, k))
    return Ok(len(out) - 1)
}

fn findTab(fw: &[]Table, k: &str): int {
    for i in 0..len(fw) { if fw[i].name == k { return i } }
    return -1
}

// Row old of table t changed to row: checked, written, its indexes, and
// its foreign keys either way.
fn updRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, old: &[]Val, row: &[]Val, fw: &[]Table,
          later: mut &[]FkLater): Result[Unit, DbErr] {
    try checkRow(t, row)
    try checkChecks(t, row)
    try checkEnums(st, txn, t, row)
    let c = try lexdb_access.updateRow(st, txn, &lexdb_catalog.relOf(t), old, row,
                                       fn(xi: &Index, r: &[]Val): Result[bool, DbErr] { return inIndex(t, xi, r) },
                                       fn(xi: &Index, k: int, r: &[]Val): Result[Val, DbErr] { return idxVal(t, xi, k, r) },
                                       fn(tx: &lexdb_store.Txn) { lexdb_stats.noteChg(st, tx.sql.sess, t, 1) })
    if c == lexdb_access.PK_CONFLICT { return Err(dupKey(t, row)) }
    if c >= 0 { return Err(try uniqueErr(t, &t.indexes[c], row)) }
    if len(t.fks) > 0 {
        var np = lexdb_fkprobe.none()
        try childSide(st, txn, t, fw, row, old, later, mut &np)
    }
    if len(t.refBy) > 0 { try parentSide(st, txn, t, fw, old, row, true, later) }
    return Ok(Unit{})
}

// Row of table t deleted, its index entries, and what references it.
fn delRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, row: &[]Val, fw: &[]Table,
          later: mut &[]FkLater): Result[Unit, DbErr] {
    try lexdb_access.deleteRow(st, txn, &lexdb_catalog.relOf(t), row,
                               fn(xi: &Index, r: &[]Val): Result[bool, DbErr] { return inIndex(t, xi, r) },
                               fn(xi: &Index, k: int, r: &[]Val): Result[Val, DbErr] { return idxVal(t, xi, k, r) },
                               fn(tx: &lexdb_store.Txn) { lexdb_stats.noteChg(st, tx.sql.sess, t, 2) })
    if len(t.refBy) > 0 {
        let none: []Val = []
        try parentSide(st, txn, t, fw, row, &none, false, later)
    }
    return Ok(Unit{})
}

// Row of table t written (old the row it was, [] for an INSERT): its keys
// in the tables it references.
fn childSide(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, fw: &[]Table, row: &[]Val, old: &[]Val,
             later: mut &[]FkLater, pr: mut &lexdb_fkprobe.Probes): Result[Unit, DbErr] {
    for k in 0..len(t.fks) {
        let f = &t.fks[k]
        let pi = findTab(fw, &f.ref)
        if pr.active(k) {
            // an INSERT's, with the statement's probes: the key's columns worked out once, and a parent known
            // to be there (looked up before, or by a chunk's probe) not looked up again
            if hasNullAt(row, &pr.fks[k].cols) { continue }
            let key = pr.keyOfRow(k, &fw[pi], row)
            if pr.known(k, &key) { continue }
            let vals = valsAt(row, &pr.fks[k].cols)
            let fc = FkCols{cols: collections.copyOf(&pr.fks[k].cols), refCols: collections.copyOf(&pr.fks[k].refCols), via: pr.fks[k].via}
            if try parentHas(st, txn, &fw[pi], &fc, &vals) {
                pr.found(k, key)
            } else {
                let none: []Val = []
                append(later, fkLater(FK_MISSING, &t.name, k, vals, 0, none))
            }
            continue
        }
        let fc = fkCols(t, f, &fw[pi])
        if hasNullAt(row, &fc.cols) { continue }
        let vals = valsAt(row, &fc.cols)
        if len(old) > 0 && encVals(&valsAt(old, &fc.cols)) == encVals(&vals) { continue }
        let has = try parentHas(st, txn, &fw[pi], &fc, &vals)
        let none: []Val = []
        if !has { append(later, fkLater(FK_MISSING, &t.name, k, vals, 0, none)) }
    }
    return Ok(Unit{})
}

// Row old of table t deleted, or changed to row (upd): what its keys going
// does to the rows referencing them, at the statement's end.
fn parentSide(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, fw: &[]Table, old: &[]Val, row: &[]Val, upd: bool,
              later: mut &[]FkLater): Result[Unit, DbErr] {
    for ck in t.refBy {
        let c = &fw[findTab(fw, &ck)]
        for k in 0..len(c.fks) {
            if c.fks[k].ref != t.name { continue }
            let fc = fkCols(c, &c.fks[k], t)
            if hasNullAt(old, &fc.refCols) { continue }
            let vals = valsAt(old, &fc.refCols)
            if upd && encVals(&valsAt(row, &fc.refCols)) == encVals(&vals) { continue }
            let act = if upd { c.fks[k].onUpdate } else { c.fks[k].onDelete }
            let none: []Val = []
            if act == lexdb_sql.FK_CASCADE && !upd {
                append(later, fkLater(FK_DELETE, &ck, k, vals, act, none))
            } else if act == lexdb_sql.FK_CASCADE {
                append(later, fkLater(FK_SET, &ck, k, vals, act, valsAt(row, &fc.refCols)))
            } else if act >= lexdb_sql.FK_SET_NULL {
                append(later, fkLater(FK_SET, &ck, k, vals, act, none))
            } else {
                // NO ACTION, RESTRICT: nothing to do while no row references it
                let refd = try referenced(st, txn, c, &fc.cols, &vals)
                if refd { append(later, fkLater(FK_GONE, &ck, k, vals, act, none)) }
            }
        }
    }
    return Ok(Unit{})
}

// ---- deferred foreign key checks (9.85)
//
// In a transaction block, a DEFERRABLE foreign key's checks, deferred by
// INITIALLY DEFERRED or SET CONSTRAINTS, wait in Txn.pending until COMMIT
// (or SET CONSTRAINTS ... IMMEDIATE). A check is done again then from the
// key alone: the key is still missing from the parent, and some row still
// references it. So a row deleted since, or written and then undone by
// ROLLBACK TO, leaves nothing to fail.

fn deferredNow(txn: &lexdb_store.Txn, c: &Table, f: &ForeignKey): bool {
    if !f.deferrable { return false }
    var d = f.deferred
    if txn.sql.consAll == 1 { d = true } else if txn.sql.consAll == 2 { d = false }
    for i in 0..len(txn.sql.consNames) { if consNamed(&txn.sql.consNames[i], c, &f.name) { d = txn.sql.consDeferred[i] } }
    return d
}

// Whether SET CONSTRAINTS' name n (schema-qualified or not) is foreign key
// fname of table c.
fn consNamed(n: &str, c: &Table, fname: &str): bool {
    if lexdb_sql.baseName(n) != fname { return false }
    return lexdb_sql.baseName(n) == n || lexdb_sql.schemaOf(n) == lexdb_sql.schemaOf(&c.name)
}

// A check kept: its kind, the child table's key, the constraint, the key.
fn pendingCheck(kind: int, child: &str, fname: &str, vals: &[]Val): str {
    var b = ""
    b.addByte(byte(kind))
    lexdb_catalog.addStr(mut &b, child)
    lexdb_catalog.addStr(mut &b, fname)
    binary.addU32LE(mut &b, len(vals))
    b += &(lexdb_rows.encodeRow(vals))
    return b
}

// Does the pending checks of txn (those of constraints which says, all
// when which is None) and forgets them.
fn checkPending(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, which: &Option[[]str]): Result[Unit, DbErr] {
    let all = replace(mut &txn.sql.pending, [])
    var keep: []str = []
    var err: Option[DbErr] = None
    let live = txn.live
    txn.live = true                     // as UPDATE's reads: the latest, checked at COMMIT either way
    for pc in all {
        if err.isSome() {
            append(mut &keep, pc.clone())
            continue
        }
        let kind = int(pc[0])
        let child = lexdb_catalog.strAt(&pc, 1)
        let fname = lexdb_catalog.strAt(&pc, 5 + len(child))
        let at = 9 + len(child) + len(fname)
        let n = binary.readU32LEStr(&pc, at)
        let vals = try decRow(&pc[at + 4..len(pc)], n)
        match try byKeyOpt(st, txn, &child) {
            None {}                     // the table dropped since
            Some(c) {
                var fi = -1
                for k in 0..len(c.fks) { if c.fks[k].name == fname { fi = k } }
                if fi < 0 { continue }  // the constraint dropped
                let f = &c.fks[fi]
                match which {
                    Some(names) {
                        var named = false
                        for nm in names { if consNamed(&nm, &c, &fname) { named = true } }
                        if !named {
                            append(mut &keep, pc.clone())
                            continue
                        }
                    }
                    None {}
                }
                let p = try byKey(st, txn, &f.ref)
                let fc = fkCols(&c, f, &p)
                if !(try parentHas(st, txn, &p, &fc, &vals)) && (try referenced(st, txn, &c, &fc.cols, &vals)) {
                    err = Some(if kind == FK_MISSING { notPresent(&c, f, &p, &vals) } else { stillRef(&p, &c, f, &vals) })
                }
            }
        }
    }
    txn.live = live
    txn.sql.pending = keep
    match err {
        Some(x) { return Err(x) }
        None { return Ok(Unit{}) }
    }
}

// SET CONSTRAINTS ALL | names DEFERRED | IMMEDIATE, in a block: the names
// must be deferrable foreign keys; IMMEDIATE does their waiting checks now.
fn setConstraints(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, stmt: &lexdb_sql.Stmt): Result[Unit, DbErr] {
    let deferred = stmt.table == "constraints:deferred"
    if len(stmt.names) == 0 {
        txn.sql.consAll = if deferred { 1 } else { 2 }
        txn.sql.consNames = []
        txn.sql.consDeferred = []
        if !deferred {
            let all: Option[[]str] = None
            try checkPending(st, txn, &all)
        }
        return Ok(Unit{})
    }
    for n in stmt.names {
        var found = false
        var deferrable = true
        for t in try allTables(st, txn) {
            for f in t.fks {
                if consNamed(&n, &t, &f.name) {
                    found = true
                    if !f.deferrable { deferrable = false }
                }
            }
        }
        if !found {
            var other = false
            for t in try allTables(st, txn) { if hasConName(&t, &lexdb_sql.baseName(&n)) { other = true } }
            if !other { return Err(e("42704", &("constraint \"" + lexdb_sql.baseName(&n) + "\" does not exist"))) }
        }
        if !found || !deferrable { return Err(e("42809", &("constraint \"" + lexdb_sql.baseName(&n) + "\" is not deferrable"))) }
        append(mut &txn.sql.consNames, n.clone())
        append(mut &txn.sql.consDeferred, deferred)
    }
    if !deferred { try checkPending(st, txn, &Some(collections.copyOf(&stmt.names))) }
    return Ok(Unit{})
}

// A statement's end: what it left, in order; deleting and setting rows
// may add more.
fn fkFinish(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, fw: &[]Table, later: mut &[]FkLater): Result[Unit, DbErr] {
    var i = 0
    while i < len(later) {
        let kind = later[i].kind
        let child = &later[i].child
        let k = later[i].fk
        let act = later[i].act
        let vals = collections.copyOf(&later[i].vals)
        let to = collections.copyOf(&later[i].to)
        i += 1
        let c = &fw[findTab(fw, &child)]
        let f = &c.fks[k]
        let p = &fw[findTab(fw, &f.ref)]
        let fc = fkCols(c, f, p)
        // a check a deferred constraint waits for the block's COMMIT with
        // (RESTRICT never waits: PostgreSQL's is not deferrable)
        if (kind == FK_MISSING || (kind == FK_GONE && act != lexdb_sql.FK_RESTRICT)) && txn.inBlock() && deferredNow(txn, c, f) {
            append(mut &txn.sql.pending, pendingCheck(kind, &child, &f.name, &vals))
            continue
        }
        if kind == FK_MISSING {
            let has = try parentHas(st, txn, p, &fc, &vals)
            if !has { return Err(notPresent(c, f, p, &vals)) }
        } else if kind == FK_GONE {
            // NO ACTION lets a key back by now be
            let back = act != lexdb_sql.FK_RESTRICT && try parentHas(st, txn, p, &fc, &vals)
            if !back {
                let refd = try referenced(st, txn, c, &fc.cols, &vals)
                if refd { return Err(stillRef(p, c, f, &vals)) }
            }
        } else {
            let rows = try refRows(st, txn, c, &fc.cols, &vals, false)
            if kind == FK_DELETE {
                for r in rows { try delRow(st, txn, c, &r, fw, later) }
            } else {
                let defs = try defaultsOf(st, txn, c)
                for r in rows {
                    var nr = collections.copyOf(&r)
                    for j in 0..len(fc.cols) {
                        let col = fc.cols[j]
                        if act == lexdb_sql.FK_CASCADE { nr[col] = to[j].clone() }
                        else if act == lexdb_sql.FK_SET_NULL { nr[col] = Val.Null }
                        else { nr[col] = try defAt(st, txn, &defs, c, col) }
                    }
                    try updRow(st, txn, c, &r, &nr, fw, later)
                }
            }
        }
    }
    return Ok(Unit{})
}

// ---- foreign keys made, dropped, renamed

// Adds foreign key c to table t, the table it references naming t back.
fn addForeign(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, c: &lexdb_sql.Constraint, later: bool): Result[Unit, DbErr] {
    let refKey = try catKey(st, txn, &c.refTable, false)
    if later { append(mut &t.invalid, try fkName(st, txn, t, c)) }
    if refKey == t.name {
        let f = try makeFk(st, txn, t, t, c, &refKey)
        append(mut &t.fks, f)
        addKey(mut &t.refBy, &t.name)
        return Ok(Unit{})
    }
    match try byKeyOpt(st, txn, &refKey) {
        Some(p) {
            // temporary to temporary only, permanent to permanent (9.96)
            if lexdb_catalog.tempRel(&t.name) != lexdb_catalog.tempRel(&p.name) {
                return Err(e("42P16", &("constraints on " + (if lexdb_catalog.tempRel(&t.name) { "temporary" } else { "permanent" }) + " tables may reference only " +
                             (if lexdb_catalog.tempRel(&t.name) { "temporary" } else { "permanent" }) + " tables")))
            }
            let f = try makeFk(st, txn, t, &p, c, &refKey)
            append(mut &t.fks, f)
            var pm = p
            addKey(mut &pm.refBy, &t.name)
            return putTable(txn, &pm)
        }
        None { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&c.refTable) + "\" does not exist"))) }
    }
}

// Foreign key c of table t to table p, checked, and the rows of t there
// checked against p.
fn makeFk(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, p: &Table, c: &lexdb_sql.Constraint, refKey: &str): Result[ForeignKey, DbErr] {
    var refCols: []str = []
    if len(c.refCols) == 0 && lexdb_catalog.rowidKeyed(p) {
        return Err(e("42704", &("there is no primary key for referenced table \"" + lexdb_sql.baseName(&p.name) + "\"")))
    }
    if len(c.refCols) == 0 { for i in p.pk { append(mut &refCols, p.cols[i].name.clone()) } }
    else { for n in c.refCols { append(mut &refCols, n.clone()) } }
    if len(refCols) != len(c.cols) {
        return Err(e("42830", "number of referencing and referenced columns for foreign key disagree"))
    }
    var cols: []int = []
    for n in c.cols {
        let i = colIndex(&t.cols, &n)
        if i < 0 { return Err(e("42703", &("column \"" + n + "\" referenced in foreign key constraint does not exist"))) }
        for k in cols { if k == i { return Err(e("42701", &("column \"" + n + "\" appears twice in foreign key constraint"))) } }
        append(mut &cols, i)
    }
    var rc: []int = []
    for n in refCols {
        let i = colIndex(&p.cols, &n)
        if i < 0 { return Err(e("42703", &("column \"" + n + "\" referenced in foreign key constraint does not exist"))) }
        for k in rc { if k == i { return Err(e("42701", &("column \"" + n + "\" appears twice in foreign key constraint"))) } }
        append(mut &rc, i)
    }
    let via = keyIndex(p, &rc, -1)
    if via == -2 {
        return Err(e("42830", &("there is no unique constraint matching given keys for referenced table \"" + lexdb_sql.baseName(&p.name) + "\"")))
    }
    let name = try fkName(st, txn, t, c)
    if hasConName(t, &name) { return Err(e("42710", &("constraint \"" + name + "\" for relation \"" + lexdb_sql.baseName(&t.name) + "\" already exists"))) }
    for j in 0..len(cols) {
        let a = &t.cols[cols[j]]
        let b = &p.cols[rc[j]]
        if a.typ.kind != b.typ.kind {
            return Err(e("42804", &("foreign key constraint \"" + name + "\" cannot be implemented: Key columns \"" + a.name + "\" and \"" + b.name +
                         "\" are of incompatible types: " + lexdb_sql.typeText(&a.typ) + " and " + lexdb_sql.typeText(&b.typ) + ".")))
        }
    }
    var own: []str = []
    for n in c.cols { append(mut &own, n.clone()) }
    let f = ForeignKey{name: name.clone(), cols: own, ref: refKey.clone(), refCols: refCols, onDelete: c.onDelete, onUpdate: c.onUpdate,
                       deferrable: c.deferrable, deferred: c.deferred}
    // the rows there (NOT VALID: when validated)
    if !lexdb_base.hasStr(&t.invalid, &name) { try fkRows(st, txn, t, &f, p) }
    return Ok(f)
}

// A foreign key's name: given, or made as PostgreSQL makes it.
fn fkName(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, c: &lexdb_sql.Constraint): Result[str, DbErr] {
    if len(c.name) > 0 { return Ok(c.name.clone()) }
    return makeName(st, txn, t, &c.cols, &"fkey", false)
}

// The rows of t against its foreign key f to table p (23503).
fn fkRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, f: &ForeignKey, p: &Table): Result[Unit, DbErr] {
    let fc = fkCols(t, f, p)
    let path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0}
    let sc = lexdb_access.allScan()
    var cur = lexdb_access.newCursor()
    while !cur.done {
        var batch: [][]Val = []
        let all: []bool = []
        try fetch(st, txn, t, &path, &sc, &all, mut &cur, mut &batch)
        for r in batch {
            if hasNullAt(&r, &fc.cols) { continue }
            let vals = valsAt(&r, &fc.cols)
            let has = try parentHas(st, txn, p, &fc, &vals)
            if !has { return Err(notPresent(t, f, p, &vals)) }
        }
    }
    return Ok(Unit{})
}

// Drops table t's foreign key k; the table it references no longer names t
// when no other does.
fn dropOwnFk(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, k: int): Result[Unit, DbErr] {
    let f = collections.removeAt(mut &t.fks, k)
    for g in t.fks { if g.ref == f.ref { return Ok(Unit{}) } }
    if f.ref == t.name {
        dropKey(mut &t.refBy, &f.ref)
        return Ok(Unit{})
    }
    var p = try byKey(st, txn, &f.ref)
    dropKey(mut &p.refBy, &t.name)
    return putTable(txn, &p)
}

fn depends(what: &str): DbErr {
    return e("2BP01", &("cannot drop " + what + " because other objects depend on it (with CASCADE the foreign keys on it are dropped)"))
}

// The foreign keys referencing table t (its own among them) that hit says
// depend on what is dropped: refused, or with cascade dropped.
fn dropReferencing(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, cascade: bool, what: &str,
                   hit: &fn(&ForeignKey, &Table): bool): Result[Unit, DbErr] {
    var kids: []str = []
    for k in t.refBy { append(mut &kids, k.clone()) }
    for ck in kids {
        if ck == t.name {
            var k = 0
            while k < len(t.fks) {
                let h = t.fks[k].ref == t.name && hit(&t.fks[k], t)
                if h {
                    if !cascade { return Err(depends(what)) }
                    try dropOwnFk(st, txn, t, k)
                } else {
                    k += 1
                }
            }
        } else {
            var c = try byKey(st, txn, &ck)
            var changed = false
            var k = 0
            while k < len(c.fks) {
                let h = c.fks[k].ref == t.name && hit(&c.fks[k], t)
                if h {
                    if !cascade { return Err(depends(what)) }
                    let gone = collections.removeAt(mut &c.fks, k)
                    changed = true
                } else {
                    k += 1
                }
            }
            if changed {
                var still = false
                for f in c.fks { if f.ref == t.name { still = true } }
                if !still { dropKey(mut &t.refBy, &ck) }
                try putTable(txn, &c)
            }
        }
    }
    return Ok(Unit{})
}

// Index ix of table t to be dropped: the foreign keys referencing t through
// it, with no other unique key of the same columns.
fn dropNeeded(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, ix: int, cascade: bool, what: &str): Result[Unit, DbErr] {
    return dropReferencing(st, txn, t, cascade, what, fn(f: &ForeignKey, p: &Table): bool {
        return keyIndex(p, &colsOf(p, &f.refCols), ix) == -2
    })
}

// Table t to be dropped: the tables referencing it (refused, or with
// cascade their foreign keys dropped), and those it references no longer
// naming it.
fn unlinkTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, cascade: bool): Result[Unit, DbErr] {
    var k = 0
    while k < len(t.fks) {
        if t.fks[k].ref == t.name { try dropOwnFk(st, txn, t, k) } else { k += 1 }
    }
    try dropReferencing(st, txn, t, cascade, &("table " + lexdb_sql.baseName(&t.name)), fn(f: &ForeignKey, p: &Table): bool { return true })
    var parents: []str = []
    for f in t.fks { addKey(mut &parents, &f.ref) }
    for pn in parents {
        var p = try byKey(st, txn, &pn)
        dropKey(mut &p.refBy, &t.name)
        try putTable(txn, &p)
    }
    return Ok(Unit{})
}

// Column name of table t to be dropped: its foreign keys on it go (as
// PostgreSQL's do); those of other tables referencing it are refused, or
// with cascade dropped.
fn fkDropColumn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, name: &str, cascade: bool): Result[Unit, DbErr] {
    var k = 0
    while k < len(t.fks) {
        var uses = false
        for n in t.fks[k].cols { if n == name { uses = true } }
        if uses { try dropOwnFk(st, txn, t, k) } else { k += 1 }
    }
    let col = name + ""
    return dropReferencing(st, txn, t, cascade, &("column " + name + " of table " + lexdb_sql.baseName(&t.name)),
                           fn(f: &ForeignKey, p: &Table): bool {
        for n in f.refCols { if n == col { return true } }
        return false
    })
}

// Whether column name of table t is in a foreign key, either way.
fn fkUses(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, name: &str): Result[bool, DbErr] {
    for f in t.fks { for n in f.cols { if n == name { return Ok(true) } } }
    for ck in t.refBy {
        if ck == t.name {
            for f in t.fks { if f.ref == t.name { for n in f.refCols { if n == name { return Ok(true) } } } }
        } else {
            let c = try byKey(st, txn, &ck)
            for f in c.fks { if f.ref == t.name { for n in f.refCols { if n == name { return Ok(true) } } } }
        }
    }
    return Ok(false)
}

// Column from of table t renamed to: in its foreign keys, and in those
// referencing it.
fn renameFkCol(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, from: &str, to: &str): Result[Unit, DbErr] {
    for k in 0..len(t.fks) {
        for j in 0..len(t.fks[k].cols) { if t.fks[k].cols[j] == from { t.fks[k].cols[j] = to.clone() } }
    }
    var kids: []str = []
    for k in t.refBy { append(mut &kids, k.clone()) }
    for ck in kids {
        if ck == t.name {
            for k in 0..len(t.fks) {
                if t.fks[k].ref == t.name {
                    for j in 0..len(t.fks[k].refCols) { if t.fks[k].refCols[j] == from { t.fks[k].refCols[j] = to.clone() } }
                }
            }
        } else {
            var c = try byKey(st, txn, &ck)
            for k in 0..len(c.fks) {
                if c.fks[k].ref == t.name {
                    for j in 0..len(c.fks[k].refCols) { if c.fks[k].refCols[j] == from { c.fks[k].refCols[j] = to.clone() } }
                }
            }
            try putTable(txn, &c)
        }
    }
    return Ok(Unit{})
}

// Table t's catalog key changed from old (a rename, another schema): the
// tables it references and those referencing it name the new one.
fn relink(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, old: &str): Result[Unit, DbErr] {
    let now = &t.name
    for k in 0..len(t.fks) { if t.fks[k].ref == old { t.fks[k].ref = now.clone() } }
    for k in 0..len(t.refBy) { if t.refBy[k] == old { t.refBy[k] = now.clone() } }
    var parents: []str = []
    for f in t.fks { if f.ref != now { addKey(mut &parents, &f.ref) } }
    for pn in parents {
        var p = try byKey(st, txn, &pn)
        for k in 0..len(p.refBy) { if p.refBy[k] == old { p.refBy[k] = now.clone() } }
        try putTable(txn, &p)
    }
    var kids: []str = []
    for ck in t.refBy { if ck != now { addKey(mut &kids, &ck) } }
    for ck in kids {
        var c = try byKey(st, txn, &ck)
        for k in 0..len(c.fks) { if c.fks[k].ref == old { c.fks[k].ref = now.clone() } }
        try putTable(txn, &c)
    }
    return Ok(Unit{})
}

// ---- sequences (9.43)
//
// A sequence is a catalog row of its own, seqRow(key), in the relations'
// namespace (a table, an index or a sequence may not share a name): its
// definition (Seq), changed only by DDL, in the DDL's transaction.
//
// Its values are outside any transaction, as PostgreSQL's: nextval in a
// transaction rolled back is not given again, and two transactions taking
// values never conflict. They are handed out from the session memo
// (Store.memo, lexdb_memo), a block at a time: before a block's first value is given,
// its last is written, in a transaction of its own, to the sequences' tree
// (SEQ_TREE, not the catalog, whose writes make the wire describe
// statements again). After a crash the sequence goes on after the last
// block written, skipping what was left of it (as PostgreSQL skips what it
// logged ahead).

// The catalog key holding the id of the sequences' tree.
const SEQ_TREE: str = "\x02seqs"

// What a session's evaluation needs for nextval and its kind (Env.seq).
pub type SeqEnv = value record { st: lexdb_store.Store; sess: int; now: int; zone: lexdb_time.Zone }

// Another environment on the same store (it holds a store handle: clone, a copy, does not apply).
pub fn (e: &SeqEnv) share(): SeqEnv { return SeqEnv{st: e.st.share(), sess: e.sess, now: e.now, zone: e.zone.clone()} }

fn seqEnv(st: &lexdb_store.Store, txn: &lexdb_store.Txn): Option[SeqEnv] {
    return Some(SeqEnv{st: st.handle(), sess: txn.sql.sess, now: txn.now, zone: txn.sql.zone.clone()})
}

fn typMax(oid: int): int {
    if oid == lexdb_sql.OID_INT2 { return 32767 }
    if oid == lexdb_sql.OID_INT4 { return 2147483647 }
    return 9223372036854775807
}

fn typMin(oid: int): int {
    if oid == lexdb_sql.OID_INT2 { return -32768 }
    if oid == lexdb_sql.OID_INT4 { return -2147483648 }
    return -9223372036854775807 - 1
}

// A sequence's name in a string, as nextval('...') takes it: schema.name
// qualified, "quoted" parts unquoted. Every part is lower-cased, quoted or
// not: lexdb matches names folded (design/lexdb-tds.md L6), so 'app."Mixed"'
// names what CREATE SEQUENCE app."Mixed" made (9.117).
fn nameOfText(t: &str): str {
    var parts: []str = []
    var cur = ""
    var quoted = false
    var i = 0
    while i < len(t) {
        let c = t[i]
        if quoted {
            if c == '"' {
                if i + 1 < len(t) && t[i + 1] == '"' {
                    cur.addByte('"')
                    i += 1
                } else {
                    quoted = false
                }
            } else if c >= 'A' && c <= 'Z' {
                cur.addByte(byte(c + 32))
            } else {
                cur.addByte(c)
            }
        } else if c == '"' {
            quoted = true
        } else if c == '.' {
            append(mut &parts, cur)
            cur = ""
        } else if c >= 'A' && c <= 'Z' {
            cur.addByte(byte(c + 32))
        } else {
            cur.addByte(c)
        }
        i += 1
    }
    append(mut &parts, cur)
    let n = len(parts)
    if n >= 2 { return lexdb_sql.qual(&parts[n - 2], &parts[n - 1]) }
    return parts[0].clone()
}

// The sequence named n (a name as written: along the search path), or none.
fn findSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[Option[Seq], DbErr] {
    var keys: []str = []
    if lexdb_sql.isQual(n) {
        append(mut &keys, if n[0] == 'p' { try tmpQual(st, txn, n) } else { n.toStr() })
    } else if len(txn.sql.path) == 0 {
        append(mut &keys, n.clone())
    } else {
        for sc in txn.sql.path { append(mut &keys, lexdb_sql.qual(&sc, n)) }
    }
    for k in keys {
        match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&k))) {
            Some(v) { return Ok(Some(lexdb_catalog.decSeq(&v))) }
            None {}
        }
    }
    return Ok(None)
}

fn needSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, n: &str): Result[Seq, DbErr] {
    match try findSeq(st, txn, n) {
        Some(d) { return Ok(d) }
        None { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(n) + "\" does not exist"))) }
    }
}

// The id of the sequences' tree (made by bootstrap).
fn seqTree(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[int, DbErr] {
    match try st.get(txn, lexdb_catalog.CATALOG, SEQ_TREE) {
        Some(v) { return Ok(lexdb_base.num(&v)) }
        None { return Err(lexdb_base.corrupt("the sequences' tree")) }
    }
}

// A sequence's definition from its options: those not given as d has them
// (CREATE: d the defaults for its type).
fn seqFrom(o: &lexdb_sql.SeqOpts, d: &Seq, creating: bool): Result[Seq, DbErr] {
    var r = lexdb_catalog.seqCopy(d)
    if o.typ != 0 { r.typ = o.typ }
    if o.hasInc { r.inc = o.inc }
    if r.inc == 0 { return Err(e("22023", "INCREMENT must not be zero")) }
    let tn = lexdb_sql.typeText(&lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: r.typ, prec: 0, scale: 0, len: 0})
    if o.hasMax == 1 { r.max = o.max } else if o.hasMax == 2 || creating || o.typ != 0 { r.max = if r.inc > 0 { typMax(r.typ) } else { -1 } }
    if o.hasMin == 1 { r.min = o.min } else if o.hasMin == 2 || creating || o.typ != 0 { r.min = if r.inc > 0 { 1 } else { typMin(r.typ) } }
    if r.max > typMax(r.typ) || r.max < typMin(r.typ) {
        return Err(e("22023", &("MAXVALUE (" + r.max.toStr() + ") is out of range for sequence data type " + tn)))
    }
    if r.min > typMax(r.typ) || r.min < typMin(r.typ) {
        return Err(e("22023", &("MINVALUE (" + r.min.toStr() + ") is out of range for sequence data type " + tn)))
    }
    if r.min >= r.max { return Err(e("22023", &("MINVALUE (" + r.min.toStr() + ") must be less than MAXVALUE (" + r.max.toStr() + ")"))) }
    if o.hasStart { r.start = o.start } else if creating { r.start = if r.inc > 0 { r.min } else { r.max } }
    if r.start < r.min { return Err(e("22023", &("START value (" + r.start.toStr() + ") cannot be less than MINVALUE (" + r.min.toStr() + ")"))) }
    if r.start > r.max { return Err(e("22023", &("START value (" + r.start.toStr() + ") cannot be greater than MAXVALUE (" + r.max.toStr() + ")"))) }
    if o.cache > 0 { r.cache = o.cache }
    if o.cycle != 0 { r.cycle = o.cycle == 1 }
    return Ok(r)
}

// A new sequence key, its definition from o (typ its type unless o says).
fn newSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str, typ: int, o: &lexdb_sql.SeqOpts): Result[Seq, DbErr] {
    var d = lexdb_catalog.noSeq()
    d.key = key.clone()
    d.typ = typ
    // unique: the catalog's version (one per DDL statement) and the time
    // (a temporary one's not: its DDL reads nothing others write, 9.96)
    d.id = (if lexdb_catalog.tempRel(key) { "t" + txn.sql.sess.toStr() } else { try catVersion(st, txn) }) + "." + time.unixMillis().toStr() + "." +
           time.monotonicNs().toStr()
    let r = try seqFrom(o, &d, true)
    try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(key)), &(lexdb_catalog.encSeq(&r)))
    return Ok(r)
}

// ---- a sequence's values (nextval, setval)

// Its memo: "sn:" the next value to give ("e" none left), "sl:" the last
// value of the block written ("" none), "sb:" a block being written, "sg:"
// the last value given.
fn memoGiven(d: &Seq): str { return "sg:" + d.id }
fn memoNext(d: &Seq): str { return "sn:" + d.id }
fn memoLast(d: &Seq): str { return "sl:" + d.id }
fn memoBusy(d: &Seq): str { return "sb:" + d.id }

// What follows n ("e" past its bounds). No sum overflows (an overflow
// stops the server, 9.116): n + inc is made only once it is known to be
// within the bounds (9.117).
fn seqAfter(d: &Seq, n: int): str {
    if d.inc > 0 && (n > d.max || span(d.max, n) < d.inc) { return "e" }
    if d.inc < 0 && (n < d.min || d.inc == INT_MIN || span(n, d.min) < 0 - d.inc) { return "e" }
    return (n + d.inc).toStr()
}

const INT_MAX: int = 9223372036854775807
const INT_MIN: int = -9223372036854775807 - 1

// hi - lo, for hi >= lo, at most the largest integer: it overflows only when
// they are of opposite signs and more than that apart.
fn span(hi: int, lo: int): int {
    if (hi >= 0) == (lo >= 0) { return hi - lo }
    if hi - INT_MAX > lo { return INT_MAX }
    return hi - lo
}

// Waits while a block of sequence d is being written, then marks one.
fn seqLock(st: &lexdb_store.Store, d: &Seq) {
    while st.memo.get(&memoBusy(d)).isSome() { let y = task.yield() }
    st.memo.put(&memoBusy(d), &"1")
}

// Writes v as sequence d's last durable value, in a transaction of its own,
// not waiting for the disk: a commit using its values waits for it too.
fn seqWrite(st: &lexdb_store.Store, d: &Seq, v: int): Result[Unit, DbErr] {
    var t = lexdb_store.begin()
    let tree = try seqTree(st, mut &t)
    try t.put(tree, &d.id, &(v.toStr()))
    // durable before any transaction using the block's values is
    return st.commitAhead(t)
}

// The sequence's next value.
fn nextVal(st: &lexdb_store.Store, d: &Seq): Result[int, DbErr] { return Ok((try nextRun(st, d, 1)).first) }

// Values given out together: first, then each inc after it, count of them.
type SeqRun = value record { first: int; count: int }

// The next values of d: up to want of them in a run, as many as its block
// holds (at least 1); a new block, when one is needed, holds at least want
// (9.119: a bulk load's hidden keys, a run at a time).
fn nextRun(st: &lexdb_store.Store, d: &Seq, want: int): Result[SeqRun, DbErr] {
    let kn = memoNext(d)
    let kl = memoLast(d)
    while true {
        if st.memo.get(&kn).isNone() {
            // first used since the store opened: after its last value written
            seqLock(st, d)
            if st.memo.get(&kn).isNone() {
                var t = lexdb_store.begin()
                let tree = seqTree(st, mut &t)
                match tree {
                    Ok(tr) {
                        match st.get(mut &t, tr, &d.id) {
                            Ok(got) {
                                match got {
                                    Some(v) {
                                        st.memo.put(&kn, &seqAfter(d, lexdb_base.num(&v)))
                                        st.memo.put(&kl, &v)
                                    }
                                    None {
                                        st.memo.put(&kn, &d.start.toStr())
                                        st.memo.put(&kl, &"")
                                    }
                                }
                            }
                            Err(x) {
                                st.abort(t)
                                st.memo.del(&memoBusy(d))
                                return Err(x)
                            }
                        }
                    }
                    Err(x) {
                        st.abort(t)
                        st.memo.del(&memoBusy(d))
                        return Err(x)
                    }
                }
                st.abort(t)
            }
            st.memo.del(&memoBusy(d))
            continue
        }
        let nv = st.memo.get(&kn).unwrap()
        if nv == "e" {
            if !d.cycle {
                let edge = if d.inc > 0 { "maximum value of sequence \"" + lexdb_sql.baseName(&d.key) + "\" (" + d.max.toStr() + ")" }
                           else { "minimum value of sequence \"" + lexdb_sql.baseName(&d.key) + "\" (" + d.min.toStr() + ")" }
                return Err(e("2200H", &("nextval: reached " + edge)))
            }
            st.memo.put(&kn, &(if d.inc > 0 { d.min } else { d.max }).toStr())
            st.memo.put(&kl, &"")
            continue
        }
        let n = lexdb_base.num(&nv)
        let lv = st.memo.get(&kl).unwrapOr("")
        let held = len(lv) > 0 && (if d.inc > 0 { n <= lexdb_base.num(&lv) } else { n >= lexdb_base.num(&lv) })
        if held {
            var c = 1
            if want > 1 && d.inc != INT_MIN {
                let ln = lexdb_base.num(&lv)
                let avail = (if d.inc > 0 { span(ln, n) / d.inc } else { span(n, ln) / (0 - d.inc) }) + 1
                c = if avail < want { avail } else { want }
            }
            let last = n + (c - 1) * d.inc
            st.memo.put(&kn, &seqAfter(d, last))
            st.memo.put(&memoGiven(d), &last.toStr())
            return Ok(SeqRun{first: n, count: c})
        }
        // the next block: its last value written before its first is given
        if st.memo.get(&memoBusy(d)).isSome() {
            let y = task.yield()
            continue
        }
        st.memo.put(&memoBusy(d), &"1")
        let base = if d.cache > 32 { d.cache } else { 32 }
        let steps = (if want > base { want } else { base }) - 1
        // the steps left before the bound: n's distance to it over the
        // increment, each by span (the guards' own sums overflowed when
        // max < 0 or min > 0, 9.116; a distance over the largest integer,
        // or an increment of the smallest, 9.117). inc times them stays
        // within the distance, so no product or sum overflows
        var room = 0
        if d.inc > 0 { room = span(d.max, n) / d.inc } else if d.inc != INT_MIN { room = span(n, d.min) / (0 - d.inc) }
        let hi = n + d.inc * (if room < steps { room } else { steps })
        let w = seqWrite(st, d, hi)
        st.memo.del(&memoBusy(d))
        match w {
            Ok(_) { st.memo.put(&kl, &hi.toStr()) }
            Err(x) { return Err(x) }
        }
    }
    return Ok(SeqRun{first: 0, count: 1})
}

// setval(d, v, called): the next value v + inc (called) or v; written at
// once.
fn setVal(st: &lexdb_store.Store, d: &Seq, v: int, called: bool): Result[Unit, DbErr] {
    if v < d.min || v > d.max {
        return Err(e("22003", &("setval: value " + v.toStr() + " is out of bounds for sequence \"" + lexdb_sql.baseName(&d.key) +
                     "\" (" + d.min.toStr() + ".." + d.max.toStr() + ")")))
    }
    seqLock(st, d)
    // the last value given: v, or (not called) the one before it
    var last = v
    var next = seqAfter(d, v)
    if !called {
        next = v.toStr()
        // (v itself where v - inc would be past the integers, 9.117)
        last = v
        if d.inc > 0 && span(v, INT_MIN) >= d.inc { last = v - d.inc }
        if d.inc < 0 && d.inc != INT_MIN && span(INT_MAX, v) >= 0 - d.inc { last = v - d.inc }
        if (d.inc > 0 && v == typMin(d.typ)) || (d.inc < 0 && v == typMax(d.typ)) { last = v }
    }
    let w = seqWrite(st, d, last)
    match w {
        Ok(_) {
            st.memo.put(&memoNext(d), &next)
            st.memo.put(&memoLast(d), &(if called { last.toStr() } else { "" }))
            if called { st.memo.put(&memoGiven(d), &v.toStr()) } else { st.memo.del(&memoGiven(d)) }
        }
        Err(_) {}
    }
    st.memo.del(&memoBusy(d))
    return w
}

// Sequence d's definition changed: its next value follows the last given,
// by its new increment, in a block written anew (or, none given since the
// store opened, the last written).
fn seqForget(st: &lexdb_store.Store, d: &Seq) {
    match st.memo.get(&memoGiven(d)) {
        Some(g) {
            let gv = lexdb_base.num(&g)
            var nx = seqAfter(d, gv)
            if nx != "e" && (lexdb_base.num(&nx) < d.min || lexdb_base.num(&nx) > d.max) { nx = "e" }
            st.memo.put(&memoNext(d), &nx)
        }
        None { st.memo.del(&memoNext(d)) }
    }
    st.memo.put(&memoLast(d), &"")
}

// ---- a sequence read as a relation (9.117): SELECT last_value, log_cnt,
// is_called FROM s, as PostgreSQL's one row.

// The mark of a sequence's view (Table.view): then its catalog key.
const SEQ_REL: str = "\x00seq:"

// A table standing for sequence d in FROM: a view whose query is its row.
fn seqRelation(d: &Seq): Table {
    var t = lexdb_catalog.emptyTable(&d.key)
    t.tree = -1
    t.view = SEQ_REL + d.key
    let i8 = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
    append(mut &t.cols, lexdb_sql.colDef("last_value", i8, true))
    append(mut &t.cols, lexdb_sql.colDef("log_cnt", i8, true))
    append(mut &t.cols, lexdb_sql.colDef("is_called", lexdb_sql.TypeName{kind: lexdb_sql.K_BOOL, oid: lexdb_sql.OID_BOOL, prec: 0, scale: 0, len: 0}, true))
    return t
}

// Sequence d's row: its last value given (by any session) and is_called;
// after setval(..., false) or RESTART the next, not called; not used since
// the store opened, the last value written (as PostgreSQL's after a
// restart), or its start. log_cnt: the values left of the block written
// ahead (PostgreSQL's values logged ahead; the same for its first 32
// values from its start, it differs after).
fn seqState(st: &lexdb_store.Store, d: &Seq): Result[[]Val, DbErr] {
    let gv = st.memo.get(&memoGiven(d)).unwrapOr("")
    let nv = st.memo.get(&memoNext(d)).unwrapOr("")
    let lv = st.memo.get(&memoLast(d)).unwrapOr("")
    if len(gv) > 0 && len(nv) > 0 {
        let g = lexdb_base.num(&gv)
        var left = 0
        if len(lv) > 0 && d.inc != 0 {
            let l = lexdb_base.num(&lv)
            // (no overflow: both of one sign, or each within half the range)
            if (l >= 0) == (g >= 0) || (l < 4611686018427387904 && l > -4611686018427387904 && g < 4611686018427387904 && g > -4611686018427387904) {
                left = (l - g) / d.inc + 1
            }
        }
        if left < 0 { left = 0 }
        return Ok([Val.Int(g), Val.Int(left), Val.Bool(true)])
    }
    if len(nv) > 0 && nv != "e" { return Ok([Val.Int(lexdb_base.num(&nv)), Val.Int(0), Val.Bool(false)]) }
    var t = lexdb_store.begin()
    let tree = seqTree(st, mut &t)
    var got: Option[str] = None
    match tree {
        Ok(tr) {
            match st.get(mut &t, tr, &d.id) {
                Ok(x) { got = x }
                Err(x) {
                    st.abort(t)
                    return Err(x)
                }
            }
        }
        Err(x) {
            st.abort(t)
            return Err(x)
        }
    }
    st.abort(t)
    match got {
        Some(v) { return Ok([Val.Int(lexdb_base.num(&v)), Val.Int(0), Val.Bool(true)]) }
        None { return Ok([Val.Int(d.start), Val.Int(0), Val.Bool(false)]) }
    }
}

// ---- the session's side: currval, lastval, and the names its statement binds

fn curKey(sess: int, d: &Seq): str { return "cv:" + sess.toStr() + ":" + d.id }
fn lastKey(sess: int): str { return "lv:" + sess.toStr() }
fn bindKey(sess: int, name: &str): str { return "bd:" + sess.toStr() + ":" + name }
fn stmtKey(sess: int): str { return "bs:" + sess.toStr() }

// nextval for session sess: its currval and lastval too.
fn nextFor(st: &lexdb_store.Store, sess: int, d: &Seq): Result[int, DbErr] {
    let v = try nextVal(st, d)
    st.memo.put(&curKey(sess, d), &v.toStr())
    st.memo.put(&lastKey(sess), &v.toStr())
    return Ok(v)
}

// A statement's start: the sequences its calls name, looked up in its
// transaction (a sequence made earlier in it is seen) and kept for its
// evaluation, under a number of this statement's.
fn bindSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, names: &[]str): Result[Unit, DbErr] {
    if len(names) == 0 { return Ok(Unit{}) }
    let no = lexdb_base.num(&st.memo.get(&stmtKey(txn.sql.sess)).unwrapOr("0")) + 1
    st.memo.put(&stmtKey(txn.sql.sess), &no.toStr())
    for n in names {
        if n == lexdb_sql.CAT_MARK {
            try bindCatalog(st, txn)
            continue
        }
        if n == lexdb_sql.SET_MARK { continue }
        if strings.startsWith(&n, lexdb_sql.SERIAL_MARK) {
            // pg_get_serial_sequence('t', 'c'): bound as the name it gives
            let tc = n[len(lexdb_sql.SERIAL_MARK)..len(n)]
            let z = strings.indexOf(&tc, "\x00", 0)
            let found = try findTable(st, txn, &nameOfText(&tc[0..z]))
            if found.isNone() { continue }
            let t = found.unwrap()
            let ci = colIndex(&t.cols, &strings.toLowerAscii(&(tc[z + 1..len(tc)].toStr())))
            if ci < 0 || len(t.cols[ci].seq) == 0 { continue }
            match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&t.cols[ci].seq))) {
                Some(v) { st.memo.put(&bindKey(txn.sql.sess, &seqShown(&t.cols[ci].seq)), &(no.toStr() + "\n" + v)) }
                None {}
            }
            continue
        }
        if strings.startsWith(&n, lexdb_sql.TYPE_MARK) {
            // a type of the user's the statement names (9.90)
            let key = n[len(lexdb_sql.TYPE_MARK)..len(n)]
            if (try lexdb_catalog.readEnum(st, txn, lexdb_sql.nameOid(&"T", &key))).isNone() {
                return Err(e("42704", &("type \"" + lexdb_sql.baseName(&key) + "\" does not exist")))
            }
            continue
        }
        let d = try needSeq(st, txn, &nameOfText(&n))
        // nextval, setval: USAGE or UPDATE; currval: USAGE or SELECT (9.83: checked
        // for the sequences a statement names, not a column's own)
        let w = try whoNow(st, txn)
        if !w.super {
            let a = try readAcl(st, txn, &lexdb_catalog.relObj(&d.key))
            if !allows(&w, &a, &"U") && !allows(&w, &a, &"w") && !allows(&w, &a, &"r") { return Err(denied(&"sequence", &d.key)) }
        }
        st.memo.put(&bindKey(txn.sql.sess, &n), &(no.toStr() + "\n" + lexdb_catalog.encSeq(&d)))
    }
    return Ok(Unit{})
}

// A sequence's key as pg_get_serial_sequence gives it: schema.name, each
// quoted where need be.
fn seqShown(k: &str): str { return lexdb_pg.quoteIfNeeded(&lexdb_sql.schemaOf(k)) + "." + lexdb_pg.quoteIfNeeded(&lexdb_sql.baseName(k)) }

// The sequence a call names, as its statement bound it.
fn boundSeq(q: &SeqEnv, name: &str, f: &str): Result[Seq, DbErr] {
    let no = q.st.memo.get(&stmtKey(q.sess)).unwrapOr("")
    match q.st.memo.get(&bindKey(q.sess, name)) {
        Some(v) {
            let i = strings.indexOf(&v, "\n", 0)
            if i > 0 && v[0..i] == no { return Ok(lexdb_catalog.decSeq(&v[i + 1..len(v)])) }
        }
        None {}
    }
    return Err(e("0A000", &("lexdb: " + f + " takes its sequence's name as a literal ('name')")))
}

// ---- advisory locks (9.86)
//
// pg_advisory_lock and the rest, on the store's lock table (row locks'):
// key "adv:" and the bigint, or "adv:" a "," b for two ints. The owner is
// the session (-its id), so a lock outlives its transaction; the session
// counts its holds (memo "\x00adv\x00" + id: a line each, "s" or "x" for
// session or transaction, "e" or "s" exclusive or shared, the key) and
// the store's lock goes with the last. A transaction's are released at its
// end (Session.advEnd), all of them at the session's.

fn advMemo(sess: int): str { return "\x00adv\x00" + sess.toStr() }

fn advCall(name: &str, vs: &[]Val, env: &Env): Result[Val, DbErr] {
    let known = name == "pg_advisory_lock" || name == "pg_advisory_lock_shared" || name == "pg_try_advisory_lock" ||
                name == "pg_try_advisory_lock_shared" || name == "pg_advisory_xact_lock" || name == "pg_advisory_xact_lock_shared" ||
                name == "pg_try_advisory_xact_lock" || name == "pg_try_advisory_xact_lock_shared" || name == "pg_advisory_unlock" ||
                name == "pg_advisory_unlock_shared" || name == "pg_advisory_unlock_all"
    if !known { return Err(e("42883", &("function " + name + " does not exist"))) }
    match env.seq {
        None { return Err(e("0A000", &("lexdb: " + name + " is not allowed here"))) }
        Some(q) {
            let me = 0 - q.sess
            if name == "pg_advisory_unlock_all" {
                advRelease(&q.st, q.sess, true)
                return Ok(Val.Text(""))
            }
            if len(vs) != 1 && len(vs) != 2 { return Err(e("42883", &("function " + name + " takes one bigint or two integers"))) }
            for v in vs { if lexdb_ops.isNull(&v) { return Ok(Val.Null) } }
            var k = "adv:"
            let i8 = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
            for i in 0..len(vs) {
                let iv = try lexdb_ops.coerce(vs[i].clone(), &i8)
                k = k + (if i > 0 { "," } else { "" }) + lexdb_sql.text(&iv)
            }
            let shared = strings.endsWith(&name, "_shared")
            let line = (if strings.contains(&name, "_xact_") { "x" } else { "s" }) + (if shared { "s" } else { "e" }) + k
            var lines: []str = []
            match q.st.memo.get(&advMemo(q.sess)) {
                Some(m) { for l in strings.split(&m, "\n") { if len(l) > 0 { append(mut &lines, l.toStr()) } } }
                None {}
            }
            if strings.contains(&name, "unlock") {
                // one session hold of this mode, if there is one
                var at = -1
                for i in 0..len(lines) { if at < 0 && lines[i][0] == 's' && lines[i][1..len(lines[i])] == line[1..len(line)] { at = i } }
                if at < 0 { return Ok(Val.Bool(false)) }
                var keep: []str = []
                var still = false
                for i in 0..len(lines) {
                    if i == at { continue }
                    append(mut &keep, lines[i].clone())
                    if lines[i][2..len(lines[i])] == k { still = true }
                }
                q.st.memo.put(&advMemo(q.sess), &strings.join(&keep, "\n"))
                if !still { q.st.locks.release(me, &[k]) }
                return Ok(Val.Bool(true))
            }
            let tryIt = strings.startsWith(&name, "pg_try_")
            var added = false
            let got = try q.st.locks.lockAs(me, &k, if shared { lexdb_sql.LOCK_SHARE } else { lexdb_sql.LOCK_UPDATE },
                                     if tryIt { lexdb_sql.WAIT_SKIP } else { lexdb_sql.WAIT_BLOCK }, true, mut &added)
            if got == lexdb_locks.LOCK_SKIPPED { return Ok(Val.Bool(false)) }
            append(mut &lines, line)
            q.st.memo.put(&advMemo(q.sess), &strings.join(&lines, "\n"))
            return Ok(if tryIt { Val.Bool(true) } else { Val.Text("") })
        }
    }
}

// Releases a session's transaction-level advisory locks (all: every one).
fn advRelease(st: &lexdb_store.Store, sess: int, all: bool) {
    let m = st.memo.get(&advMemo(sess)).unwrapOr("")
    if len(m) == 0 { return }
    var keep: []str = []
    var gone: []str = []
    for l in strings.split(&m, "\n") {
        if len(l) == 0 { continue }
        if all || l[0] == 'x' { append(mut &gone, l[2..len(l)].toStr()) } else { append(mut &keep, l.toStr()) }
    }
    st.memo.put(&advMemo(sess), &strings.join(&keep, "\n"))
    var free: []str = []
    for k in gone {
        var still = false
        for l in keep { if l[2..len(l)] == k { still = true } }
        if !still { append(mut &free, k.clone()) }
    }
    if len(free) > 0 { st.locks.release(0 - sess, &free) }
}

// nextval, currval, setval, lastval.
fn seqCall(name: &str, vs: &[]Val, env: &Env): Result[Val, DbErr] {
    match env.seq {
        None { return Err(e("0A000", &("lexdb: " + name + " is not allowed here"))) }
        Some(q) {
            if name == "scope_identity" {
                // T-SQL's SCOPE_IDENTITY(): the session's last identity (or
                // sequence) value, NULL before one (design/lexdb-tds.md S3)
                match q.st.memo.get(&lastKey(q.sess)) {
                    Some(v) { return Ok(Val.Num(Decimal.fromInt(lexdb_base.num(&v)))) }
                    None { return Ok(Val.Null) }
                }
            }
            if name == "lastval" {
                if len(vs) != 0 { return Err(e("42883", "function lastval takes no arguments")) }
                match q.st.memo.get(&lastKey(q.sess)) {
                    Some(v) { return Ok(Val.Int(lexdb_base.num(&v))) }
                    None { return Err(e("55000", "lastval is not yet defined in this session")) }
                }
            }
            if len(vs) == 0 || lexdb_ops.isNull(&vs[0]) { return Ok(Val.Null) }
            let d = try boundSeq(&q, &lexdb_sql.text(&vs[0]), name)
            if name == "nextval" {
                if len(vs) != 1 { return Err(e("42883", "function nextval takes one argument")) }
                return Ok(Val.Int(try nextFor(&q.st, q.sess, &d)))
            }
            if name == "currval" {
                if len(vs) != 1 { return Err(e("42883", "function currval takes one argument")) }
                match q.st.memo.get(&curKey(q.sess, &d)) {
                    Some(v) { return Ok(Val.Int(lexdb_base.num(&v))) }
                    None { return Err(e("55000", &("currval of sequence \"" + lexdb_sql.baseName(&d.key) + "\" is not yet defined in this session"))) }
                }
            }
            // setval(name, v [, called])
            if len(vs) < 2 || len(vs) > 3 { return Err(e("42883", "function setval takes two or three arguments")) }
            if lexdb_ops.isNull(&vs[1]) { return Ok(Val.Null) }
            let v = match vs[1] { Val.Int(n) { n } else { 0 } }
            match vs[1] {
                Val.Int(_) {}
                else { return Err(e("42804", "setval takes a bigint")) }
            }
            var called = true
            if len(vs) == 3 {
                match vs[2] {
                    Val.Bool(b) { called = b }
                    else { return Err(e("42804", "setval's third argument is a boolean")) }
                }
            }
            try setVal(&q.st, &d, v, called)
            return Ok(Val.Int(v))
        }
    }
}

// Whether x calls a sequence function (evaluated per row, never once).
fn isVolatile(x: &Expr): bool {
    match x {
        Expr.Call(n, args, _) {
            // (and those whose every call differs: a default of one is made
            // per row, 9.117)
            if lexdb_bind.isSeqFn(&n) || lexdb_bind.isAdvFn(&n) || n == "gen_random_uuid" || n == "random" || n == "clock_timestamp" { return true }
            for a in args { if isVolatile(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return isVolatile(&a) }
        Expr.Bin(_, a, b) { return isVolatile(&a) || isVolatile(&b) }
        Expr.IsNull(a, _) { return isVolatile(&a) }
        Expr.Cast(a, _) { return isVolatile(&a) }
        else { return false }
    }
}

// The sequence names x's calls give as literals.
fn seqNamesOf(x: &Expr, out: mut &[]str) {
    match x {
        Expr.Call(n, args, _) {
            if (n == "nextval" || n == "currval" || n == "setval") && len(args) > 0 {
                match lexdb_sql.litText(&args[0]) {
                    Some(t) { append(out, t) }
                    None {}
                }
            }
            for a in args { seqNamesOf(&a, out) }
        }
        Expr.Unary(_, a) { seqNamesOf(&a, out) }
        Expr.Bin(_, a, b) {
            seqNamesOf(&a, out)
            seqNamesOf(&b, out)
        }
        Expr.IsNull(a, _) { seqNamesOf(&a, out) }
        Expr.Cast(a, _) { seqNamesOf(&a, out) }
        else {}
    }
}

// ---- defaults with sequences: a statement's (9.38's defaultsOf, per row
// where a column's default is its sequence's nextval or calls one)

type Defs = record {
    vals: []Val             // the defaults that are values
    seqs: []Seq             // a column's own sequence (key "" none)
    exprs: []Option[Expr]   // a default calling a sequence function: evaluated per row
}

fn defaultsOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table): Result[Defs, DbErr] {
    var d = Defs{vals: [], seqs: [], exprs: []}
    var names: []str = []
    for c in t.cols {
        var v = Val.Null
        var sq = lexdb_catalog.noSeq()
        var x: Option[Expr] = None
        if len(c.seq) > 0 {
            match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&c.seq))) {
                Some(r) { sq = lexdb_catalog.decSeq(&r) }
                None { return Err(lexdb_base.corrupt(&("the sequence of column \"" + c.name + "\""))) }
            }
        } else {
            match c.def {
                Some(dx) {
                    if isVolatile(&dx) {
                        seqNamesOf(&dx, mut &names)
                        x = Some(lexdb_sql.cloneExpr(&dx))
                    } else {
                        v = try defaultValue(&dx, &c, seqEnv(st, txn))
                    }
                }
                None {}
            }
        }
        append(mut &d.vals, v)
        append(mut &d.seqs, sq)
        append(mut &d.exprs, x)
    }
    if len(names) > 0 { try bindSeqs(st, txn, &names) }
    return Ok(d)
}

// Column i's default for a row.
fn defAt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, d: &Defs, t: &Table, i: int): Result[Val, DbErr] {
    let sqe = seqEnv(st, txn)
    if len(d.seqs[i].key) > 0 { return Ok(Val.Int(try nextFor(st, txn.sql.sess, &d.seqs[i]))) }
    match d.exprs[i] {
        Some(x) {
            let none: []Val = []
            let noCols: []lexdb_sql.ColDef = []
            let noSubs: []SubRes = []
            let env = Env{cols: &noCols, row: &none, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: &sqe}
            return lexdb_ops.coerceZ(try eval(&x, &env), &t.cols[i].typ, &txn.sql.zone)
        }
        None { return Ok(d.vals[i].clone()) }
    }
}

// ---- sequences made, changed, dropped

// CREATE SEQUENCE.
fn createSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let key = try createKey(st, txn, &s.table, s.temp)
    if try relExists(st, txn, &key) {
        if s.ifFlag {
            notice(st, txn, &"42P07", &("relation \"" + lexdb_sql.baseName(&key) + "\" already exists, skipping"), &"")
            return Ok(tagOnly("CREATE SEQUENCE"))
        }
        return Err(e("42P07", &("relation \"" + lexdb_sql.baseName(&key) + "\" already exists")))
    }
    try needCreate(st, txn, &key)
    try ownNew(st, txn, &lexdb_catalog.relObj(&key))
    var d = try newSeq(st, txn, &key, lexdb_sql.OID_INT8, &s.seq)
    if len(s.seq.owned) == 2 && len(s.seq.owned[0]) > 0 {
        try ownSeq(st, txn, mut &d, &s.seq.owned)
        try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&key)), &(lexdb_catalog.encSeq(&d)))
    }
    try bumpFor(st, txn, &key)
    return Ok(tagOnly("CREATE SEQUENCE"))
}

// OWNED BY table.column: in the sequence's schema, as PostgreSQL has it.
fn ownSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, d: mut &Seq, owned: &[]str): Result[Unit, DbErr] {
    if len(owned[0]) == 0 {
        d.ownerT = ""
        d.ownerC = ""
        return Ok(Unit{})
    }
    let t = try needTable(st, txn, &owned[0])
    if colIndex(&t.cols, &owned[1]) < 0 {
        return Err(e("42703", &("column \"" + owned[1] + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist")))
    }
    if lexdb_sql.schemaOf(&t.name) != lexdb_sql.schemaOf(&d.key) {
        return Err(e("55000", "sequence must be in same schema as table it is linked to"))
    }
    d.ownerT = t.name.clone()
    d.ownerC = owned[1].clone()
    return Ok(Unit{})
}

// ALTER SEQUENCE: its options; RESTART at once (as setval).
fn alterSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let found = try findSeq(st, txn, &s.table)
    if found.isNone() {
        if s.ifFlag {
            notice(st, txn, &"00000", &("relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist, skipping"), &"")
            return Ok(tagOnly("ALTER SEQUENCE"))
        }
        return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist")))
    }
    let old = found.unwrap()
    try needRelOwner(st, txn, &old.key, &"sequence")
    if len(s.alters) > 0 { return moveSeq(st, txn, &old, &s.alters[0]) }
    var d = try seqFrom(&s.seq, &old, false)
    if len(s.seq.owned) == 2 { try ownSeq(st, txn, mut &d, &s.seq.owned) }
    try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&d.key)), &(lexdb_catalog.encSeq(&d)))
    seqForget(st, &d)
    if s.seq.restart > 0 { try restartSeq(st, &d, if s.seq.restart == 2 { s.seq.restartWith } else { d.start }) }
    try bumpFor(st, txn, &d.key)
    return Ok(tagOnly("ALTER SEQUENCE"))
}

// ALTER SEQUENCE ... RENAME TO name or SET SCHEMA name (9.117): its catalog
// row under its new key (its id, so its values, kept), its owner column's
// default, and the defaults naming it in their text (PostgreSQL binds them
// by OID, so they follow it).
fn moveSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, old: &Seq, a: &lexdb_sql.Alter): Result[Res, DbErr] {
    let base = lexdb_sql.baseName(&old.key)
    var key = lexdb_sql.qual(&lexdb_sql.schemaOf(&old.key), &a.name)
    if a.kind == lexdb_sql.A_SET_SCHEMA {
        if lexdb_catalog.tempRel(&old.key) || a.name == "pg_temp" || lexdb_base.isTempSchema(&a.name) { return Err(e("0A000", "cannot move objects into or out of temporary schemas")) }
        if !(try schemaExists(st, txn, &a.name)) { return Err(e("3F000", &("schema \"" + a.name + "\" does not exist"))) }
        key = lexdb_sql.qual(&a.name, &base)
        if key != old.key && len(old.ownerT) > 0 {
            return Err(lexdb_base.errDetail("0A000", "cannot move an owned sequence into another schema",
                                            &("Sequence \"" + base + "\" is linked to table \"" + lexdb_sql.baseName(&old.ownerT) + "\"."), ""))
        }
    }
    if key == old.key { return Ok(tagOnly("ALTER SEQUENCE")) }
    if try relExists(st, txn, &key) {
        if a.kind == lexdb_sql.A_SET_SCHEMA { return Err(e("42P07", &("relation \"" + base + "\" already exists in schema \"" + a.name + "\""))) }
        return Err(e("42P07", &("relation \"" + a.name + "\" already exists")))
    }
    var d = lexdb_catalog.seqCopy(old)
    txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&old.key)))
    try moveAcl(st, txn, &lexdb_catalog.relObj(&old.key), &lexdb_catalog.relObj(&key))
    d.key = key.clone()
    try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&key)), &(lexdb_catalog.encSeq(&d)))
    // the tables whose columns take it: their own (serial, identity) or a
    // default naming it
    var tabs = try seenTables(st, txn)
    while len(tabs) > 0 {
        var t = pop(mut &tabs)
        var changed = false
        for i in 0..len(t.cols) {
            if t.cols[i].seq == old.key {
                t.cols[i].seq = key.clone()
                changed = true
            }
            var nd: Option[Expr] = None
            match t.cols[i].def {
                Some(x) { if namesSeq(&x, &old.key) { nd = Some(seqRenamed(&x, &old.key, &key)) } }
                None {}
            }
            if nd.isSome() {
                t.cols[i].def = nd
                changed = true
            }
        }
        if changed { try putTable(txn, &t) }
    }
    try bumpFor(st, txn, &key)
    return Ok(tagOnly("ALTER SEQUENCE"))
}

// Whether x calls a sequence function on the sequence of key k (its name
// as a literal).
fn namesSeq(x: &Expr, k: &str): bool {
    var ns: []str = []
    seqNamesOf(x, mut &ns)
    for n in ns { if nameOfText(&n) == k { return true } }
    return false
}

// x with its sequence functions' literal names of sequence from naming to.
fn seqRenamed(x: &Expr, from: &str, to: &str): Expr {
    match x {
        Expr.Call(f, args, star) {
            var xs: []Expr = []
            for k in 0..len(args) {
                var done = false
                if k == 0 && (f == "nextval" || f == "currval" || f == "setval") {
                    match lexdb_sql.litText(&args[0]) {
                        Some(n) {
                            if nameOfText(&n) == from {
                                append(mut &xs, Expr.Lit(Val.Text(seqText(to))))
                                done = true
                            }
                        }
                        None {}
                    }
                }
                if !done { append(mut &xs, seqRenamed(&args[k], from, to)) }
            }
            return Expr.Call(f.clone(), xs, star)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), seqRenamed(&a, from, to)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), seqRenamed(&a, from, to), seqRenamed(&b, from, to)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(seqRenamed(&a, from, to), neg) }
        Expr.Cast(a, ty) { return Expr.Cast(seqRenamed(&a, from, to), ty) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// A sequence's key as nextval's text names it: schema.name, quoted where
// need be (public's unqualified).
fn seqText(k: &str): str {
    let b = lexdb_pg.quoteIfNeeded(&lexdb_sql.baseName(k))
    if !lexdb_sql.isQual(k) { return b }
    return lexdb_pg.quoteIfNeeded(&lexdb_sql.schemaOf(k)) + "." + b
}

// Sequence d's rows deleted (its definition and last value).
fn dropSeqRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, d: &Seq): Result[Unit, DbErr] {
    txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&d.key)))
    dropAcl(txn, &lexdb_catalog.relObj(&d.key))
    txn.del(try seqTree(st, txn), &d.id)
    return Ok(Unit{})
}

// DROP SEQUENCE: refused while it is a column's (its default), unless
// CASCADE, which takes the column's default away.
fn dropSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    // DROP SEQUENCE a, b, ...: each in turn (9.117)
    var all = [s.table.clone()]
    for n in s.names { append(mut &all, n.clone()) }
    for n in all { try dropOneSeq(st, txn, s, &n) }
    return Ok(tagOnly("DROP SEQUENCE"))
}

fn dropOneSeq(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, name: &str): Result[Res, DbErr] {
    let found = try findSeq(st, txn, name)
    if found.isNone() {
        if s.ifFlag {
            notice(st, txn, &"00000", &("sequence \"" + lexdb_sql.shown(name) + "\" does not exist, skipping"), &"")
            return Ok(tagOnly("DROP SEQUENCE"))
        }
        return Err(e("42P01", &("sequence \"" + lexdb_sql.shown(name) + "\" does not exist")))
    }
    let d = found.unwrap()
    try needRelOwner(st, txn, &d.key, &"sequence")
    if len(d.ownerT) > 0 {
        match try byKeyOpt(st, txn, &d.ownerT) {
            Some(t) {
                var u = t
                var used = false
                for i in 0..len(u.cols) {
                    if u.cols[i].seq == d.key {
                        used = true
                        if !s.cascade {
                            return Err(e("2BP01", &("cannot drop sequence " + lexdb_sql.baseName(&d.key) + " because column " + u.cols[i].name +
                                         " of table " + lexdb_sql.baseName(&u.name) + " requires it (with CASCADE its default is dropped)")))
                        }
                        u.cols[i].seq = ""
                        u.cols[i].identity = lexdb_sql.ID_NONE
                    }
                }
                if used { try putTable(txn, &u) }
            }
            None {}
        }
    }
    try dropSeqRows(st, txn, &d)
    try bumpFor(st, txn, &d.key)
    return Ok(tagOnly("DROP SEQUENCE"))
}

// The sequences in the catalog: in schema sc ("" all).

// Table t's columns' sequences (SERIAL, identity) made: named table_column_seq
// as PostgreSQL names them, owned by their columns. Its own options from
// ids (an identity column's).
fn makeColSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, only: int, ids: &[]lexdb_sql.IdOpts): Result[Unit, DbErr] {
    for i in 0..len(t.cols) {
        if (only >= 0 && i != only) || t.cols[i].identity == lexdb_sql.ID_NONE || len(t.cols[i].seq) > 0 { continue }
        let cname = &t.cols[i].name
        let ctyp = t.cols[i].typ
        let cid = t.cols[i].identity
        let cdef = t.cols[i].def.isSome()
        if ctyp.kind != lexdb_sql.K_INT { return Err(e("22023", "identity column type must be smallint, integer, or bigint")) }
        if cdef {
            if cid == lexdb_sql.ID_SERIAL {
                return Err(e("42601", &("multiple default values specified for column \"" + cname + "\" of table \"" + lexdb_sql.baseName(&t.name) + "\"")))
            }
            return Err(e("42601", &("both default and identity specified for column \"" + cname + "\" of table \"" + lexdb_sql.baseName(&t.name) + "\"")))
        }
        var oi = -1
        for k in 0..len(ids) { if ids[k].col == cname { oi = k } }
        let none = lexdb_sql.noSeqOpts()
        let o = if oi >= 0 { &ids[oi].opts } else { &none }
        if len(o.owned) > 0 { return Err(e("42601", "lexdb: an identity column's sequence is owned by it (no OWNED BY)")) }
        let name = try makeName(st, txn, t, &[cname.clone()], &"seq", true)
        let key = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &name)
        var d = try newSeq(st, txn, &key, ctyp.oid, o)
        d.ownerT = t.name.clone()
        d.ownerC = cname.clone()
        try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&key)), &(lexdb_catalog.encSeq(&d)))
        t.cols[i].seq = key
    }
    return Ok(Unit{})
}

// The sequences owned by table t (its column col; "" any) dropped.
fn dropOwnedSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, col: &str): Result[Unit, DbErr] {
    // (a temporary table's are in its schema: 9.96)
    for d in try lexdb_catalog.allSeqs(st, txn, &(if lexdb_catalog.tempRel(&t.name) { lexdb_sql.schemaOf(&t.name) } else { "" })) {
        if d.ownerT == t.name && (len(col) == 0 || d.ownerC == col) { try dropSeqRows(st, txn, &d) }
    }
    return Ok(Unit{})
}

// Table t renamed from old (a key), or its column from renamed to: its
// sequences' owner. Moved to schema sc ("" not moved): its sequences with it,
// unless a name is taken there.
fn ownerMoved(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: mut &Table, old: &str, from: &str, to: &str, sc: &str): Result[Unit, DbErr] {
    for d in try lexdb_catalog.allSeqs(st, txn, &"") {
        if d.ownerT != old { continue }
        var m = lexdb_catalog.seqCopy(&d)
        m.ownerT = t.name.clone()
        if len(from) > 0 && m.ownerC == from { m.ownerC = to.clone() }
        if len(sc) > 0 && lexdb_sql.schemaOf(&m.key) != sc {
            let nk = lexdb_sql.qual(sc, &lexdb_sql.baseName(&m.key))
            if try relExists(st, txn, &nk) {
                return Err(e("42P07", &("relation \"" + lexdb_sql.baseName(&m.key) + "\" already exists in schema \"" + sc + "\"")))
            }
            txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&m.key)))
            for i in 0..len(t.cols) { if t.cols[i].seq == m.key { t.cols[i].seq = nk.clone() } }
            m.key = nk
        }
        try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.seqRow(&m.key)), &(lexdb_catalog.encSeq(&m)))
    }
    return Ok(Unit{})
}

// ---- COPY (9.45): rows in and out as text or CSV, the client's input
// whole (the wire collects it) so that a COPY is one statement, run again
// on a conflict as any.

pub const COPY_NONE = 0
pub const COPY_IN = 1
pub const COPY_OUT = 2

// What the client sent for COPY FROM STDIN: its data, or its CopyFail's
// message (proto: a message not of COPY's, the wire's own error).
// stream: COPY TO's lines go to the caller's out as they are made (runOut).
// pull: COPY FROM's data comes from the caller's pull as it arrives
// (copyInFrom), not in data.
pub type CopyInput = record { pub have: bool; pub data: str; pub fail: str; pub proto: bool; pub stream: bool; pub pull: bool }

fn noInput(): CopyInput { return CopyInput{have: false, data: "", fail: "", proto: false, stream: false, pull: false} }

// A part of COPY FROM's data as the client sent it: end, the last (its
// CopyDone, or CopyFail's message in fail; proto: not a COPY message).
// INSERT BULK's parts (copy.bulk) carry rows instead of data: a value per
// target column, of the type the client sent; their fail is an error's
// SQLSTATE, a colon, then its message.
pub type CopyPart = record { pub rows: [][]Val; pub data: str; pub end: bool; pub fail: str; pub proto: bool }

fn noPull(): CopyPart { return CopyPart{rows: [], data: "", end: true, fail: "", proto: false} }

fn copyStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
            lim: Limits, pc: mut &PlanCache, input: &CopyInput, out: &fn(int, &[]byte): bool, pull: &fn(): CopyPart): Result[Res, DbErr] {
    if !s.copy.from {
        if s.copy.batchRows > 0 { return Err(e("0A000", "lexdb: COPY's batch_rows only available using COPY FROM")) }
        if input.stream { return copyStream(st, txn, s, params, ptypes, lim, out) }
        return copyOut(st, txn, s, params, ptypes, lim, pc)
    }
    if s.copy.bulk { return bulkStmt(st, txn, s, pull) }
    let t = try needTable(st, txn, &s.table)
    try needRel(st, txn, &(try whoNow(st, txn)), &t.name, &"a", &"table")
    var targets: []int = []
    var names: []str = []
    if len(s.names) == 0 {
        for i in 0..len(t.cols) { if t.cols[i].name != lexdb_catalog.ROWID { append(mut &targets, i) } }
    } else {
        for n in s.names {
            let i = colIndex(&t.cols, &n)
            if i < 0 { return Err(e("42703", &("column \"" + n + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist"))) }
            for k in targets { if k == i { return Err(e("42701", &("column \"" + n + "\" specified more than once"))) } }
            append(mut &targets, i)
        }
    }
    var cols: []OutCol = []
    for i in targets {
        append(mut &cols, OutCol{name: t.cols[i].name.clone(), oid: t.cols[i].typ.oid, spell: t.cols[i].spell.clone(), coll: t.cols[i].coll.clone(), scale: -1})
        append(mut &names, t.cols[i].name.clone())
    }
    if !input.have { return Ok(Res{cols: cols, rows: [], tag: "", hasRows: false, copy: COPY_IN}) }
    // WITH (batch_rows n): a commit each n rows (9.87), so a large load
    // holds no more than n rows' writes; not inside a block, which commits
    // once
    let batch = s.copy.batchRows
    if batch > 0 && txn.inBlock() {
        return Err(e("25001", "lexdb: COPY with batch_rows cannot run inside a transaction block"))
    }
    // its identity columns take the values given (as OVERRIDING SYSTEM VALUE)
    let defs = try defaultsOf(st, txn, &t)
    let fw = try fkTables(st, txn, &t, true, false)
    var later: []FkLater = []
    // The bulk-load fast path (design/par-db-perf.md): the common COPY of a
    // table whose every column is a simple scalar, with one integer primary
    // key, no indexes, checks or foreign keys, in the text format with its
    // default NULL. It parses straight into the stored row, without Val rows.
    match fastCopyPlan(&t, &targets, s) {
        Some(plan) {
            // putRowLoad writes no own-writes map: the table must start empty
            // (a fresh load), and no later statement of the same transaction
            // may read the load; otherwise the generic path checks every key
            // and serves reads.
            if !txn.inBlock() && (try lexdb_access.rowCount(st, txn, &lexdb_catalog.relOf(&t))) == 0 {
                return fastCopyRun(st, txn, &t, s, &plan, &input, pull)
            }
        }
        None {}
    }
    var rd = CopyRd{at: 0, line: 0, start: 0, stops: s.copy.delim[0..1] + "\n\r\\", notNull: try forced(&s.copy.forceNotNull, &names, &"FORCE_NOT_NULL"),
                    forceNull: try forced(&s.copy.forceNull, &names, &"FORCE_NULL")}
    var vs: []Val = []
    var count = 0
    let where = "COPY " + lexdb_sql.baseName(&s.table) + ", line "
    var noUp = noUpsert()                   // COPY has no ON CONFLICT
    let noCols: []lexdb_sql.ColDef = []
    let none: []Val = []
    let noSubs: []SubRes = []
    let noSeq: Option[SeqEnv] = None
    let noEnv = Env{cols: &noCols, row: &none, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: &noSeq}
    // The input as it comes (9.87): the client's parts, from pull, or
    // input.data whole (Session.copyIn). buf holds what is not yet read:
    // the record being read and what follows; a record that runs off its
    // end waits for the next part.
    var buf = ""
    var ended = false
    var given = false
    let next = fn(): CopyPart {
        if input.pull { return pull() }
        if given { return CopyPart{rows: [], data: "", end: true, fail: "", proto: false} }
        given = true
        return CopyPart{rows: [], data: input.data.clone(), end: true, fail: input.fail.clone(), proto: input.proto}
    }
    var header = s.copy.header
    // With foreign keys, the records after the one being read, those the buffer
    // holds whole and well formed, are parsed ahead in chunks (32, doubling to
    // BROWS) and their parents looked up together (fkAhead); the loop then takes
    // each as it reaches it, with the reader's place after it as it would be
    // had it parsed the record itself. What is not plain is left to the loop.
    var pre: [][]Val = []
    var preAt: []int = []                   // per record: rd.at, rd.line, rd.start after it
    var preNext = 0
    var want = 32
    while true {
        let at0 = rd.at
        let line0 = rd.line
        let start0 = rd.start
        if preNext * 3 >= len(preAt) && len(t.fks) > 0 && !header {
            pre = []
            preAt = []
            preNext = 0
            while len(pre) < want {
                var one: []Val = []
                let more = match copyRecord(&buf, &s.copy, mut &rd, mut &one) { Ok(m) { m } Err(_) { false } }
                if !more || len(one) != len(targets) || (!ended && rd.at >= len(buf) && buf[len(buf) - 1] != '\n') { break }
                append(mut &pre, one)
                append(mut &preAt, rd.at)
                append(mut &preAt, rd.line)
                append(mut &preAt, rd.start)
            }
            rd.at = at0
            rd.line = line0
            rd.start = start0
            want = min(want * 2, lexdb_rows.BROWS)
            if len(pre) > 1 { try fkAhead(st, txn, &t, &fw, &targets, mut &noUp, &pre) }
        }
        var taken = false
        if preNext * 3 < len(preAt) {
            vs = replace(mut &pre[preNext], [])
            rd.at = preAt[preNext * 3]
            rd.line = preAt[preNext * 3 + 1]
            rd.start = preAt[preNext * 3 + 2]
            preNext += 1
            taken = true
        }
        var res: Result[bool, DbErr] = Ok(true)
        if !taken { res = copyRecord(&buf, &s.copy, mut &rd, mut &vs) }
        if !ended && !taken {
            // ran off the end of what has come: wait for more
            var short = false
            match res {
                Ok(more) { short = if more { rd.at >= len(buf) && buf[len(buf) - 1] != '\n' } else { at0 >= len(buf) } }
                Err(_) { short = true }     // CSV's only error, an unterminated quote: the rest may yet come
            }
            if short {
                rd.at = at0
                rd.line = line0
                let part = next()
                if part.fail != "" {
                    if part.proto { return Err(e("08P01", &part.fail)) }
                    return Err(e("57014", &("COPY from stdin failed: " + part.fail)))
                }
                buf = buf[at0..len(buf)] + part.data
                rd.at = 0
                rd.start = 0
                if part.end { ended = true }
                continue
            }
        }
        match res {
            Ok(more) { if !more { break } }
            Err(x) { return Err(within(x, &(where + rd.line.toStr() + ": " + quoted(&recordText(&buf, &rd))))) }
        }
        if header {
            header = false
            continue
        }
        if len(vs) < len(targets) {
            return Err(within(e("22P04", &("missing data for column \"" + names[len(vs)] + "\"")), &(where + rd.line.toStr() + ": " + quoted(&recordText(&buf, &rd)))))
        }
        if len(vs) > len(targets) {
            return Err(within(e("22P04", "extra data after last expected column"), &(where + rd.line.toStr() + ": " + quoted(&recordText(&buf, &rd)))))
        }
        match insertOne(st, txn, &t, &targets, &vs, &defs, &fw, mut &later, mut &noUp, &noEnv) {
            Ok(_) {}
            Err(x) {
                // a value not of its column's type (insertOne turns them
                // first, in order): which column, said as PostgreSQL does
                for k in 0..len(vs) {
                    match lexdb_ops.coerceZ(vs[k].clone(), &t.cols[targets[k]].typ, &txn.sql.zone) {
                        Ok(_) {}
                        Err(y) { return Err(within(y, &(where + rd.line.toStr() + ", column " + names[k] + ": " + quoted(&lexdb_sql.text(&vs[k]))))) }
                    }
                }
                return Err(within(x, &(where + rd.line.toStr())))
            }
        }
        count += 1
        if batch > 0 && count % batch == 0 {
            // a batch's end: its foreign keys checked, then it commits; the
            // rows after it go into a new transaction
            try fkFinish(st, txn, &fw, mut &later)
            later = []
            noUp.fk.forget()
            let done = replace(txn, freshTxn(txn))
            match st.commit(done) {
                Ok(_) {}
                Err(x) { return Err(within(x, &(where + rd.line.toStr() + " (" + (count - batch).toStr() + " rows committed before)"))) }
            }
        }
    }
    // what follows an end marker (\.) is not read; the wire drops it
    try fkFinish(st, txn, &fw, mut &later)
    return Ok(Res{cols: [], rows: [], tag: "COPY " + count.toStr(), hasRows: false, copy: COPY_NONE})
}

// ---- COPY's fast path (design/par-db-perf.md)
//
// The common bulk load: every column a simple scalar, one integer primary
// key, no secondary indexes, checks or foreign keys, no defaults or
// identities, in the text format with its default NULL. It parses each
// field straight into the stored fixed row: no Val row, no coerce dispatch,
// no encFixed walk. Keys that ascend (the common load) take the fastest
// route; an out-of-order key switches to the own-writes map. The table must
// start empty, and the load is its own statement; otherwise the generic path
// runs.
type FastCopyPlan = record {
    kinds: []byte
    off: []int
    v0: int
    lay: int
    n: int
    pk: int
}

fn fastCopyPlan(t: &Table, targets: &[]int, s: &lexdb_sql.Stmt): Option[FastCopyPlan] {
    if s.copy.csv || s.copy.header || s.copy.bulk || s.copy.batchRows > 0 { return None }
    if s.copy.delim != "\t" || s.copy.null != "\\N" { return None }
    if len(s.copy.forceNotNull) > 0 || len(s.copy.forceNull) > 0 || len(s.copy.forceQuote) > 0 || s.copy.quoteAll { return None }
    if len(t.view) > 0 || len(t.slots) != 0 || len(t.indexes) != 0 || len(t.checks) != 0 || len(t.fks) != 0 { return None }
    if len(t.pk) != 1 { return None }
    if len(targets) != len(t.cols) { return None }
    for i in 0..len(targets) { if targets[i] != i { return None } }
    let nl = len(t.layouts)
    if nl == 0 || nl > 65536 { return None }
    let kinds0 = &t.layouts[nl - 1]
    if len(kinds0) != len(t.cols) || len(kinds0) > 255 { return None }
    if !kindsFit(t, kinds0) { return None }
    let pk = t.pk[0]
    if t.cols[pk].name == lexdb_catalog.ROWID { return None }
    let pkk = kinds0[pk]
    if pkk != lexdb_rows.PK_INT && pkk != lexdb_rows.PK_INT4 && pkk != lexdb_rows.PK_INT2 { return None }
    for i in 0..len(t.cols) {
        let c = &t.cols[i]
        if c.def.isSome() || c.identity != lexdb_sql.ID_NONE || len(c.seq) > 0 || len(c.coll) > 0 { return None }
        let k = kinds0[i]
        if k == lexdb_rows.PK_INT { if c.typ.oid != lexdb_sql.OID_INT8 { return None } }
        else if k == lexdb_rows.PK_INT4 { if c.typ.oid != lexdb_sql.OID_INT4 { return None } }
        else if k == lexdb_rows.PK_INT2 { if c.typ.oid != lexdb_sql.OID_INT2 { return None } }
        else if k == lexdb_rows.PK_NUM { if c.typ.kind != lexdb_sql.K_NUM { return None } }
        else if k == lexdb_rows.PK_BOOL { if c.typ.kind != lexdb_sql.K_BOOL { return None } }
        else if k == lexdb_rows.PK_F8 { if c.typ.oid != lexdb_sql.OID_FLOAT8 { return None } }
        else if k == lexdb_rows.PK_F4 { if c.typ.oid != lexdb_sql.OID_FLOAT4 { return None } }
        else if k == lexdb_rows.PK_DATE { if c.typ.kind != lexdb_sql.K_DATE { return None } }
        else if k == lexdb_rows.PK_TIME { if c.typ.kind != lexdb_sql.K_TIME { return None } }
        else if k == lexdb_rows.PK_TS { if c.typ.kind != lexdb_sql.K_TS { return None } }
        else if k == lexdb_rows.PK_TSTZ { if c.typ.kind != lexdb_sql.K_TSTZ { return None } }
        else if k == lexdb_rows.PK_UUID { if c.typ.kind != lexdb_sql.K_UUID { return None } }
        else if k == lexdb_rows.PK_TEXT {
            let o = c.typ.oid
            if o != lexdb_sql.OID_TEXT && o != lexdb_sql.OID_VARCHAR { return None }
        } else { return None }
    }
    var off: []int = array(len(t.cols), 0)
    var fixed = 3 + (len(t.cols) + 7) / 8
    for p in 0..len(t.cols) {
        off[p] = fixed
        let k = kinds0[p]
        if lexdb_rows.isWordKind(k) { fixed += lexdb_rows.fixedSize(k) }
        else if k == lexdb_rows.PK_BOOL { fixed += 1 }
        else if lexdb_rows.isVarKind(k) { fixed += 2 }
        else { return None }
    }
    var ks: []byte = withCapacity(len(t.cols))
    for k in kinds0 { append(mut &ks, k) }
    return Some(FastCopyPlan{kinds: ks, off: off, v0: fixed, lay: nl - 1, n: len(t.cols), pk: pk})
}

// A 4-byte little-endian fixed value.
fn fastSetU32(b: mut &[]byte, at: int, v: int) {
    b[at] = byte(v & 0xFF)
    b[at + 1] = byte((v >> 8) & 0xFF)
    b[at + 2] = byte((v >> 16) & 0xFF)
    b[at + 3] = byte((v >> 24) & 0xFF)
}

fn fastCopyBad(t: &Table, p: int, s: &str): DbErr {
    return within(lexdb_ops.badInput(&t.cols[p].typ, s), &("column " + t.cols[p].name + ": \"" + s + "\""))
}

fn fastCopyAt(x: DbErr, where: &str, line: int): DbErr {
    var y = x
    y.context = where + line.toStr() + (if len(y.context) > 0 { ", " + y.context } else { "" })
    return y
}

fn fastCopyInt(t: &Table, p: int, s: &str): Result[int, DbErr] {
    var a = 0
    var b = len(s)
    while a < b && strings.isSpace(s[a]) { a += 1 }
    while b > a && strings.isSpace(s[b - 1]) { b -= 1 }
    var neg = false
    if a < b && (s[a] == '-' || s[a] == '+') {
        neg = s[a] == '-'
        a += 1
    }
    if a >= b || b - a > 18 {
        match strings.parseIntOpt(&(strings.trim(s))) {
            Some(v) { return Ok(v) }
            None { return Err(fastCopyBad(t, p, s)) }
        }
    }
    var v = 0
    var i = a
    while i < b {
        let c = s[i]
        if c < '0' || c > '9' { return Err(fastCopyBad(t, p, s)) }
        v = v * 10 + int(c) - 48
        i += 1
    }
    return Ok(if neg { -v } else { v })
}

fn fastCopyFloat(t: &Table, p: int, s: &str, real: bool): Result[float, DbErr] {
    let x = strings.trim(s)
    var v = 0.0f
    if !parseFloat(x, mut &v) || v.isNaN() || v.isInf() || v == 0.0f {
        match lexdb_float.parse(s, real) {
            Ok(y) { return Ok(y) }
            Err(_) { return Err(fastCopyBad(t, p, s)) }
        }
    }
    if real {
        v = lexdb_float.round4(v)
        if v.isInf() || v == 0.0f {
            match lexdb_float.parse(s, real) {
                Ok(y) { return Ok(y) }
                Err(_) { return Err(fastCopyBad(t, p, s)) }
            }
        }
    }
    return Ok(v)
}

fn fastCopyBool(s: &str): Option[bool] {
    if s == "1" { return Some(true) }
    if s == "0" { return Some(false) }
    return lexdb_ops.parseBool(s)
}

// A text-format field's escapes undone (textRecord's rules).
fn fastCopyUnescape(s: &str): str {
    var b = ""
    var i = 0
    while i < len(s) {
        if s[i] == '\\' && i + 1 < len(s) {
            i = lexdb_sql.unescape(s, i + 1, mut &b)
        } else {
            b.addByte(s[i])
            i += 1
        }
    }
    return b
}

fn fastCopyPrec(t: &lexdb_sql.TypeName): int {
    if t.prec >= 1 && lexdb_parse.tsqlCode(t) == 0 { return t.scale }
    if t.prec >= 1 { return min(t.scale, 6) }
    return 6
}

fn fastCopyNum(t: &Table, p: int, s: &str): Result[Decimal, DbErr] {
    var d = Decimal.zero()
    match Decimal.parse(s) {
        Ok(x) { d = x }
        Err(_) { return Err(fastCopyBad(t, p, s)) }
    }
    if t.cols[p].typ.prec > 0 {
        match d.quantize(t.cols[p].typ.scale, Rounding.HALF_AWAY) {
            Ok(q) { d = q }
            Err(_) { return Err(e("22003", "numeric field overflow")) }
        }
        if lexdb_ops.intDigits(&d) > t.cols[p].typ.prec - t.cols[p].typ.scale {
            return Err(e("22003", "numeric field overflow"))
        }
    }
    return Ok(d)
}

// One non-NULL field into the stored row; the word of an integer key, else 0.
fn fastCopyField(t: &Table, zone: &lexdb_time.Zone, plan: &FastCopyPlan, p: int, s: &str,
                 b: mut &[]byte): Result[int, DbErr] {
    let k = plan.kinds[p]
    if lexdb_rows.isWordKind(k) {
        var v = 0
        if k == lexdb_rows.PK_INT { v = try fastCopyInt(t, p, s) }
        else if k == lexdb_rows.PK_INT4 {
            v = try fastCopyInt(t, p, s)
            if v < -2147483648 || v > 2147483647 { return Err(e("22003", "integer out of range")) }
        } else if k == lexdb_rows.PK_INT2 {
            v = try fastCopyInt(t, p, s)
            if v < -32768 || v > 32767 { return Err(e("22003", "smallint out of range")) }
        } else if k == lexdb_rows.PK_F8 { v = math.bitsOf(try fastCopyFloat(t, p, s, false)) }
        else if k == lexdb_rows.PK_F4 { v = math.bitsOf32Int(try fastCopyFloat(t, p, s, true)) }
        else if k == lexdb_rows.PK_DATE { v = try lexdb_time.parseDate(s, zone) }
        else if k == lexdb_rows.PK_TIME { v = lexdb_time.roundUs(try lexdb_time.parseTime(s), fastCopyPrec(&t.cols[p].typ)) }
        else if k == lexdb_rows.PK_TS { v = lexdb_time.roundUs(try lexdb_time.parseTs(s, zone), fastCopyPrec(&t.cols[p].typ)) }
        else if k == lexdb_rows.PK_TSTZ { v = lexdb_time.roundUs(try lexdb_time.parseTstz(s, zone), fastCopyPrec(&t.cols[p].typ)) }
        else { return Err(e("0A000", "lexdb: COPY fast path: unsupported fixed kind")) }
        let w = lexdb_rows.fixedSize(k)
        if w == 8 { binary.setU64LE(mut &b, plan.off[p], v) }
        else if w == 4 { fastSetU32(mut &b, plan.off[p], v) }
        else { binary.setU16LE(mut &b, plan.off[p], v & 0xFFFF) }
        return Ok(v)
    }
    if k == lexdb_rows.PK_BOOL {
        let x = match fastCopyBool(s) {
            Some(x) { x }
            None { return Err(fastCopyBad(t, p, s)) }
        }
        b[plan.off[p]] = if x { byte(1) } else { byte(0) }
        return Ok(0)
    }
    if k == lexdb_rows.PK_NUM {
        let spaces = len(s) > 0 && (strings.isSpace(s[0]) || strings.isSpace(s[len(s) - 1]))
        let d = if spaces { try fastCopyNum(t, p, &(strings.trim(s))) } else { try fastCopyNum(t, p, s) }
        let x = d.toBin()
        if len(x) >= lexdb_rows.LONG { return Err(e("0A000", "lexdb: COPY fast path: numeric too long")) }
        appendStr(mut &b, x)
        binary.setU16LE(mut &b, plan.off[p], len(b) - plan.v0)
        return Ok(0)
    }
    if k == lexdb_rows.PK_TEXT {
        if len(s) >= lexdb_rows.LONG { return Err(e("0A000", "lexdb: COPY fast path: text too long")) }
        if t.cols[p].typ.oid == lexdb_sql.OID_VARCHAR && t.cols[p].typ.len > 0 && len(s) > t.cols[p].typ.len &&
           strings.runeCount(s) > t.cols[p].typ.len {
            return Err(e("22001", &("value too long for type character varying(" + t.cols[p].typ.len.toStr() + ")")))
        }
        appendStr(mut &b, s)
        binary.setU16LE(mut &b, plan.off[p], len(b) - plan.v0)
        return Ok(0)
    }
    if k == lexdb_rows.PK_UUID {
        let u = try lexdb_ops.parseUuid(s)
        let raw = lexdb_rows.uuidBytes(&u)
        appendStr(mut &b, raw)
        binary.setU16LE(mut &b, plan.off[p], len(b) - plan.v0)
        return Ok(0)
    }
    return Err(e("0A000", "lexdb: COPY fast path: unsupported variable kind"))
}

// One field: NULL, an escaped value, or plain.
fn fastCopyOne(t: &Table, txn: &lexdb_store.Txn, plan: &FastCopyPlan, p: int, raw: &str, anyEsc: bool,
               b: mut &[]byte): Result[int, DbErr] {
    let k = plan.kinds[p]
    if raw == "\\N" {
        if t.cols[p].notNull {
            return Err(e("23502", &("null value in column \"" + t.cols[p].name + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" violates not-null constraint")))
        }
        b[3 + p / 8] = b[3 + p / 8] | byte(1 << (p % 8))
        if lexdb_rows.isVarKind(k) { binary.setU16LE(mut &b, plan.off[p], len(b) - plan.v0) }
        return Ok(0)
    }
    if anyEsc && strings.indexOfByte(raw, '\\', 0) >= 0 {
        let un = fastCopyUnescape(raw)
        return fastCopyField(t, &txn.sql.zone, plan, p, &un, mut &b)
    }
    return fastCopyField(t, &txn.sql.zone, plan, p, raw, mut &b)
}

// One record: fields to the stored row, the key, and putRowLoad.
fn fastCopyRow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, rel: &lexdb_access.Rel, plan: &FastCopyPlan, line: &str,
               state: mut &lexdb_access.Load): Result[Unit, DbErr] {
    var b: []byte = withCapacity(plan.v0 + len(line))
    for i in 0..plan.v0 { append(mut &b, 0) }
    b[0] = lexdb_rows.FIXED
    binary.setU16LE(mut &b, 1, plan.lay)
    var id = 0
    var haveId = false
    let anyEsc = strings.indexOfByte(line, '\\', 0) >= 0
    var p = 0
    var start = 0
    while true {
        let i = strings.indexOfByte(line, '\t', start)
        let end = if i < 0 { len(line) } else { i }
        if p >= plan.n { return Err(e("22P04", "extra data after last expected column")) }
        let raw = line[start..end]
        let v = try fastCopyOne(t, txn, plan, p, &raw, anyEsc, mut &b)
        if p == plan.pk { id = v; haveId = true }
        p += 1
        if i < 0 { break }
        start = i + 1
    }
    if p < plan.n {
        return Err(e("22P04", &("missing data for column \"" + t.cols[p].name + "\"")))
    }
    if !haveId { return Err(e("XX000", "lexdb: COPY fast path: no primary key value")) }
    let row = strFromBytes(&b)
    if !(try lexdb_access.loadRow(st, txn, rel, id, &row, state)) {
        return Err(e("23505", "duplicate key value violates unique constraint"))
    }
    lexdb_stats.noteChg(st, txn.sql.sess, t, 0)
    return Ok(Unit{})
}

fn fastCopyRun(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, s: &lexdb_sql.Stmt,
               plan: &FastCopyPlan, input: &CopyInput, pull: &fn(): CopyPart): Result[Res, DbErr] {
    var buf = ""
    var given = false
    var ended = false
    var count = 0
    var lineNo = 0
    var state = lexdb_access.newLoad()
    let rel = lexdb_catalog.relOf(t)
    let where = "COPY " + lexdb_sql.baseName(&s.table) + ", line "
    let next = fn(): CopyPart {
        if input.pull { return pull() }
        if given { return CopyPart{rows: [], data: "", end: true, fail: "", proto: false} }
        given = true
        return CopyPart{rows: [], data: input.data.clone(), end: true, fail: input.fail.clone(), proto: input.proto}
    }
    while true {
        let part = next()
        if part.fail != "" {
            if part.proto { return Err(e("08P01", &part.fail)) }
            return Err(e("57014", &("COPY from stdin failed: " + part.fail)))
        }
        if len(buf) == 0 { buf = part.data.clone() } else { buf = buf + part.data }
        var start = 0
        while true {
            let nl = strings.indexOfByte(&buf, '\n', start)
            if nl < 0 { break }
            var line = buf[start..nl]
            if len(line) > 0 && line[len(line) - 1] == '\r' { line = line[0..len(line) - 1] }
            if line == "\\." { ended = true; start = nl + 1; break }
            lineNo += 1
            match fastCopyRow(st, txn, t, &rel, plan, &line, mut &state) {
                Ok(_) {}
                Err(x) { return Err(fastCopyAt(x, &where, lineNo)) }
            }
            count += 1
            start = nl + 1
        }
        if ended { break }
        if start < len(buf) { buf = buf[start..len(buf)].clone() } else { buf = "" }
        if part.end { break }
    }
    if !ended && len(buf) > 0 {
        var line = buf
        if len(line) > 0 && line[len(line) - 1] == '\r' { line = line[0..len(line) - 1].clone() }
        if line != "\\." {
            lineNo += 1
            match fastCopyRow(st, txn, t, &rel, plan, &line, mut &state) {
                Ok(_) {}
                Err(x) { return Err(fastCopyAt(x, &where, lineNo)) }
            }
            count += 1
        }
    }
    return Ok(Res{cols: [], rows: [], tag: "COPY " + count.toStr(), hasRows: false, copy: COPY_NONE})
}

// T-SQL's bulk load (INSERT BULK and the rows after it, lexdb_tds; design/
// lexdb-tds.md section 14): the client's rows from pull as they arrive, a
// value per column of s.names in the type the client sent, inserted as
// COPY's are (insertOne: each value made its column's type as an INSERT's,
// the rest of the columns their defaults, the table's keys and checks).
// Without KEEP_NULLS a NULL for a column with a DEFAULT (or an identity)
// takes that, as SQL Server's. An identity column given values keeps them,
// and goes on past the largest (as SET IDENTITY_INSERT). The tag: COPY n.
fn bulkStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, pull: &fn(): CopyPart): Result[Res, DbErr] {
    let t = try needTable(st, txn, &s.table)
    try needRel(st, txn, &(try whoNow(st, txn)), &t.name, &"a", &"table")
    var targets: []int = []
    for n in s.names {
        let i = colIndex(&t.cols, &n)
        if i < 0 || t.cols[i].name == lexdb_catalog.ROWID { return Err(e("42703", &("column \"" + n + "\" of relation \"" + lexdb_sql.baseName(&t.name) + "\" does not exist"))) }
        append(mut &targets, i)
    }
    let defs = try defaultsOf(st, txn, &t)
    let fw = try fkTables(st, txn, &t, true, false)
    var later: []FkLater = []
    var up = noUpsert()
    up.idBump = true
    // the columns whose NULL takes the default; a bit sent for a column not boolean
    var dflt: []bool = []
    var notBool: []bool = []
    for i in targets {
        append(mut &dflt, !s.copy.keepNulls && (t.cols[i].def.isSome() || len(t.cols[i].seq) > 0))
        append(mut &notBool, t.cols[i].typ.kind != lexdb_sql.K_BOOL)
    }
    let noCols: []lexdb_sql.ColDef = []
    let none: []Val = []
    let noSubs: []SubRes = []
    let noSeq: Option[SeqEnv] = None
    let noEnv = Env{cols: &noCols, row: &none, aggs: &none, params: &none, subs: &noSubs, cur: &none, seq: &noSeq}
    var count = 0
    while true {
        var part = pull()
        if part.fail != "" {
            let colon = strings.indexOf(&part.fail, ":", 0)
            if colon >= 5 && colon <= 8 { return Err(e(&(part.fail[0..colon].toStr()), &(part.fail[colon + 1..len(part.fail)].toStr()))) }
            return Err(e("08P01", &part.fail))
        }
        for r in 0..len(part.rows) {
            var vs = replace(mut &part.rows[r], [])
            if len(vs) != len(targets) { return Err(e("08P01", &("a bulk load's row of " + len(vs).toStr() + " values for " + len(targets).toStr() + " columns"))) }
            for k in 0..len(vs) {
                match vs[k] {
                    Val.Null { if dflt[k] { vs[k] = try defAt(st, txn, &defs, &t, targets[k]) } }
                    // SQL Server's bit into a number or a string: 1 or 0
                    Val.Bool(b) { if notBool[k] { vs[k] = Val.Int(if b { 1 } else { 0 }) } }
                    else {}
                }
            }
            match insertOne(st, txn, &t, &targets, &vs, &defs, &fw, mut &later, mut &up, &noEnv) {
                Ok(_) {}
                Err(x) { return Err(within(x, &("bulk load of " + lexdb_sql.baseName(&s.table) + ", row " + (count + 1).toStr()))) }
            }
            count += 1
        }
        if part.end { break }
    }
    try fkFinish(st, txn, &fw, mut &later)
    for j in 0..len(up.idCols) {
        let d = try needSeq(st, txn, &t.cols[up.idCols[j]].seq)
        let v = up.idMax[j]
        let next = try seqPeek(st, txn, &d)
        if (d.inc > 0 && v >= next) || (d.inc < 0 && v <= next) { try setVal(st, &d, v, true) }
    }
    return Ok(Res{cols: [], rows: [], tag: "COPY " + count.toStr(), hasRows: false, copy: COPY_NONE})
}

// An error with where it happened (PostgreSQL's CONTEXT).
fn within(x: DbErr, context: &str): DbErr {
    var r = x
    r.context = context.clone()
    return r
}

fn quoted(s: &str): str { return "\"" + s + "\"" }

// Where COPY's reading of its input is: the byte, the line of the record
// read last (from 1), and where that record began.
type CopyRd = record {
    at: int
    line: int
    start: int
    stops: str                  // the text format's bytes that end a run of data: the delimiter, \n, \r, \\
    notNull: []bool             // per field: FORCE_NOT_NULL
    forceNull: []bool           // per field: FORCE_NULL
}

// Which of names a FORCE option lists (each it lists must be one).
fn forced(list: &[]str, names: &[]str, opt: &str): Result[[]bool, DbErr] {
    var r: []bool = []
    for n in names { append(mut &r, false) }
    for x in list {
        var found = false
        for k in 0..len(names) {
            if names[k] == x {
                r[k] = true
                found = true
            }
        }
        if !found { return Err(e("42703", &(opt + " column \"" + x + "\" not referenced by COPY"))) }
    }
    return Ok(r)
}

// The text of the record read last, without its line's end (one not read
// to its end, an unterminated CSV field: the rest of the data).
fn recordText(data: &str, rd: &CopyRd): str {
    if rd.at <= rd.start { return data[rd.start..len(data)].clone() }
    var end = rd.at
    if end > rd.start && data[end - 1] == '\n' { end -= 1 }
    if end > rd.start && data[end - 1] == '\r' { end -= 1 }
    return data[rd.start..end].clone()
}

// The next record of data into vs (NULL or text per field); false at its
// end (the data's, or a line \. ).
fn copyRecord(data: &str, o: &lexdb_sql.CopyOpts, rd: mut &CopyRd, vs: mut &[]Val): Result[bool, DbErr] {
    let n = len(data)
    if rd.at >= n { return Ok(false) }
    // the end marker: a line \. alone
    if rd.at + 1 < n && data[rd.at] == '\\' && data[rd.at + 1] == '.' {
        let k = rd.at + 2
        if k == n || data[k] == '\n' || (data[k] == '\r' && (k + 1 == n || data[k + 1] == '\n')) { return Ok(false) }
    }
    rd.line += 1
    rd.start = rd.at
    replace(vs, [])
    if !o.csv {
        rd.at = textRecord(data, o, rd.at, &rd.stops, vs)
        return Ok(true)
    }
    let first = rd.line
    match csvRecord(data, o, rd.at, mut &rd.line, &rd.notNull, &rd.forceNull, vs) {
        Ok(next) { rd.at = next }
        Err(x) {
            rd.line = first                 // the line it began on, as PostgreSQL says
            return Err(x)
        }
    }
    return Ok(true)
}

// The text format: fields split by the delimiter, backslash escapes, NULL
// written as o.null (compared before the escapes are undone). The index
// after the record's line.
fn textRecord(data: &str, o: &lexdb_sql.CopyOpts, at: int, stops: &str, vs: mut &[]Val): int {
    let n = len(data)
    let d = o.delim[0]
    var b = ""
    var esc = false                     // the field has an escape: b holds it, else it is data[raw..i]
    var raw = at
    var i = at
    while true {
        // the next byte that matters (9.119: found 16 at a time)
        var j = strings.indexOfAny(data, stops, i)
        if j < 0 { j = n }
        if esc && j > i { b += &(data[i..j]) }
        i = j
        let end = i >= n || data[i] == '\n' || (data[i] == '\r' && i + 1 < n && data[i + 1] == '\n')
        if end || data[i] == d {
            if data[raw..i] == o.null { append(vs, Val.Null) }
            else if esc { append(vs, Val.Text(b.toStr())) }
            else { append(vs, Val.Text(data[raw..i].clone())) }
            if esc { b.clear() }
            esc = false
            if end {
                if i < n && data[i] == '\r' { i += 1 }
                return if i < n { i + 1 } else { n }
            }
            i += 1
            raw = i
            continue
        }
        if data[i] == '\\' && i + 1 < n {
            if !esc {
                b += &(data[raw..i])
                esc = true
            }
            i = lexdb_sql.unescape(data, i + 1, mut &b)
            continue
        }
        // a lone \r, or a backslash ending the data: the byte itself
        if esc { b.addByte(data[i]) }
        i += 1
    }
    return n
}

// CSV: fields split by the delimiter, quoted with o.quote (in which a
// quote is written after o.escape, and newlines are data); an unquoted
// field equal to o.null is NULL. Lines counted in line (a quoted field may
// hold some). The index after the record.
fn csvRecord(data: &str, o: &lexdb_sql.CopyOpts, at: int, line: mut &int, notNull: &[]bool, forceNull: &[]bool,
             vs: mut &[]Val): Result[int, DbErr] {
    let n = len(data)
    let d = o.delim[0]
    let q = o.quote[0]
    let esc = o.escape[0]
    var b = ""
    var i = at
    while true {
        let raw = i
        var quoted = false
        while i < n {
            let c = data[i]
            if c == q {
                quoted = true
                i += 1
                while true {
                    if i >= n { return Err(e("22P04", "unterminated CSV quoted field")) }
                    let c2 = data[i]
                    if c2 == esc && i + 1 < n && (data[i + 1] == q || data[i + 1] == esc) {
                        b.addByte(data[i + 1])
                        i += 2
                        continue
                    }
                    if c2 == q {
                        i += 1
                        break
                    }
                    if c2 == '\n' { line += 1 }
                    b.addByte(c2)
                    i += 1
                }
                continue
            }
            if c == d || c == '\n' || (c == '\r' && i + 1 < n && data[i + 1] == '\n') { break }
            b.addByte(c)
            i += 1
        }
        let k = len(vs)
        let v = b.toStr()
        let isNull = if quoted { k < len(forceNull) && forceNull[k] && v == o.null }
                     else { data[raw..i] == o.null && !(k < len(notNull) && notNull[k]) }
        if isNull { append(vs, Val.Null) } else { append(vs, Val.Text(v)) }
        b.clear()
        if i < n && data[i] == d {
            i += 1
            continue
        }
        if i < n && data[i] == '\r' { i += 1 }
        return Ok(if i < n { i + 1 } else { n })
    }
    return Ok(n)
}

// COPY ... TO STDOUT: its query's rows, a line each (the header first).
fn copyOut(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
           lim: Limits, pc: mut &PlanCache): Result[Res, DbErr] {
    var res = try select(st, txn, &s.inner[0], params, ptypes, lim, pc, noSink)
    var names: []str = []
    for c in res.cols { append(mut &names, c.name.clone()) }
    var fq = try forced(&s.copy.forceQuote, &names, &"FORCE_QUOTE")
    if s.copy.quoteAll { for k in 0..len(fq) { fq[k] = true } }
    var lines: [][]Val = []
    var b: []byte = []
    if s.copy.header {
        copyHeader(&res.cols, &s.copy, mut &b)
        append(mut &lines, [Val.Text(strFromBytes(&b))])
    }
    let zone = txn.sql.zone.clone()
    for r in res.rows {
        replace(mut &b, [])
        copyLine(&r, &s.copy, &fq, &res.cols, &zone, mut &b)
        append(mut &lines, [Val.Text(strFromBytes(&b))])
    }
    let n = len(res.rows)
    return Ok(Res{cols: replace(mut &res.cols, []), rows: lines, tag: "COPY " + n.toStr(), hasRows: false, copy: COPY_OUT})
}

// COPY TO STDOUT as its query runs (runOut): CopyData messages, a line
// each, given to out in parts of about 64 kB; the rows are not kept.
fn copyStream(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int,
              lim: Limits, out: &fn(int, &[]byte): bool): Result[Res, DbErr] {
    var sc = newScopeIn(st, txn, params, ptypes)
    var sel = try planSelect(st, txn, &s.inner[0], params, mut &sc)
    bindSel(mut &sel)
    pipeSelIn(mut &sel, false)
    let n = len(sel.outs)
    var names: []str = []
    for c in sel.outs { append(mut &names, c.name.clone()) }
    var fq = try forced(&s.copy.forceQuote, &names, &"FORCE_QUOTE")
    if s.copy.quoteAll { for k in 0..len(fq) { fq[k] = true } }
    var b: []byte = withCapacity(COPY_PART * 2)
    if s.copy.header {
        let at = copyMsgStart(mut &b)
        copyHeader(&sel.outs, &s.copy, mut &b)
        copyMsgEnd(mut &b, at)
    }
    var count = 0
    let zone = txn.sql.zone.clone()
    try eachRow(st, txn, &sel, params, lim, fn(tx: mut &lexdb_store.Txn, r: &[]Val): Result[bool, DbErr] {
        let at = copyMsgStart(mut &b)
        copyLine(r, &s.copy, &fq, &sel.outs, &zone, mut &b)
        copyMsgEnd(mut &b, at)
        count += 1
        if len(b) >= COPY_PART {
            if !out(n, &b) { return Err(e("08006", "lexdb: the connection was lost during COPY")) }
            b = withCapacity(COPY_PART * 2)
        }
        return Ok(true)
    })
    if !out(n, &b) { return Err(e("08006", "lexdb: the connection was lost during COPY")) }
    return Ok(Res{cols: [], rows: [], tag: "COPY " + count.toStr(), hasRows: false, copy: COPY_NONE})
}

const COPY_PART = 65536

// A CopyData message begun in b: its type and room for its length.
fn copyMsgStart(b: mut &[]byte): int {
    let at = len(b)
    append(b, 'd')
    for i in 0..4 { append(b, byte(0)) }
    return at
}

fn copyMsgEnd(b: mut &[]byte, at: int) { binary.setU32BE(b, at + 1, len(b) - at - 1) }

// The column names as COPY's HEADER line.
fn copyHeader(cols: &[]OutCol, o: &lexdb_sql.CopyOpts, b: mut &[]byte) {
    for k in 0..len(cols) {
        if k > 0 { appendStr(b, o.delim) }
        copyField(&Val.Text(cols[k].name.clone()), o, len(cols) == 1, false, lexdb_sql.OID_TEXT, lexdb_time.utc(), b)
    }
    append(b, '\n')
}

// A row as COPY's line (fq: the columns FORCE_QUOTE names; cols their
// types; z the session's zone, 9.95).
fn copyLine(r: &[]Val, o: &lexdb_sql.CopyOpts, fq: &[]bool, cols: &[]OutCol, z: &lexdb_time.Zone, b: mut &[]byte) {
    for k in 0..len(r) {
        if k > 0 { appendStr(b, o.delim) }
        copyField(&r[k], o, len(r) == 1, k < len(fq) && fq[k], if k < len(cols) { cols[k].oid } else { lexdb_sql.OID_TEXT }, z, b)
    }
    append(b, '\n')
}

// A value as COPY writes it: in the text format escaped, in CSV quoted
// where it must be.
fn copyField(v: &Val, o: &lexdb_sql.CopyOpts, single: bool, force: bool, oid: int, z: &lexdb_time.Zone, b: mut &[]byte) {
    if lexdb_ops.isNull(v) {
        appendStr(b, o.null)
        return
    }
    let t = lexdb_ops.textOut(v, oid, z)
    let d = o.delim[0]
    if !o.csv {
        // most values have nothing to escape: added whole
        var plain = true
        for k in 0..len(t) {
            let c = t[k]
            if c == '\\' || c < byte(14) || c == d {
                plain = false
                break
            }
        }
        if plain {
            appendStr(b, t)
            return
        }
        for k in 0..len(t) {
            let c = t[k]
            if c == '\\' { appendStr(b, "\\\\") }
            else if c == '\n' { appendStr(b, "\\n") }
            else if c == '\r' { appendStr(b, "\\r") }
            else if c == '\t' { appendStr(b, "\\t") }
            else if c == byte(8) { appendStr(b, "\\b") }
            else if c == byte(12) { appendStr(b, "\\f") }
            else if c == byte(11) { appendStr(b, "\\v") }
            else if c == d {
                append(b, '\\')
                append(b, c)
            } else { append(b, c) }
        }
        return
    }
    let q = o.quote[0]
    let esc = o.escape[0]
    // \. alone on a line would end the data
    var must = force || t == o.null || (single && t == "\\.")
    for k in 0..len(t) {
        let c = t[k]
        if c == d || c == q || c == '\n' || c == '\r' { must = true }
    }
    if !must {
        appendStr(b, t)
        return
    }
    append(b, q)
    for k in 0..len(t) {
        let c = t[k]
        if c == q || c == esc { append(b, esc) }
        append(b, c)
    }
    append(b, q)
}

// ---- window functions (9.46)
//
// f(args) OVER (PARTITION BY ... ORDER BY ... frame): after the rows are
// found, grouped and HAVING has chosen, before DISTINCT, ORDER BY and
// LIMIT. The rows (a grouped query's groups, with their aggregates) are
// kept (WinRow); per window call, they are sorted by partition and order,
// and each gets the call's value, which the select list and ORDER BY read
// from a slot after the aggregates' (#agg nAggs + i).

// A row a window call ranges over, and a window call planned (lexdb_window).
type WinRow = lexdb_window.WinRow
type WinPlan = lexdb_window.WinPlan

fn hasWin(x: &Expr): bool {
    match x {
        Expr.Call(name, args, _) {
            if name == "#win" || name == "#wmark" { return true }
            for a in args { if hasWin(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return hasWin(&a) }
        Expr.Bin(_, a, b) { return hasWin(&a) || hasWin(&b) }
        Expr.IsNull(a, _) { return hasWin(&a) }
        Expr.Cast(a, _) { return hasWin(&a) }
        else { return false }
    }
}

fn hasWinOpt(x: &Option[Expr]): bool {
    match x {
        Some(v) { return hasWin(&v) }
        None { return false }
    }
}

// Whether a window's arguments, partitions or order use aggregates (the
// query is then grouped; a window aggregate itself does not make it so).
fn winHasAgg(d: &lexdb_sql.WinDef): bool {
    match d.call {
        Expr.Call(_, args, _) { for a in args { if hasAgg(&a) { return true } } }
        else {}
    }
    for x in d.part { if hasAgg(&x) { return true } }
    for o in d.order { if hasAgg(&o.expr) { return true } }
    return false
}

fn winNames(d: &lexdb_sql.WinDef, out: mut &[]str) {
    lexdb_sql.colNames(&d.call, out)
    for x in d.part { lexdb_sql.colNames(&x, out) }
    for o in d.order { lexdb_sql.colNames(&o.expr, out) }
}

// x with its window calls (#win i, the call inside) marked (#wmark i), so
// that a window aggregate is not taken for the query's.
fn winMarks(x: &Expr): Expr {
    match x {
        Expr.Call(name, args, star) {
            if name == "#win" { return Expr.Call("#wmark", [lexdb_sql.cloneExpr(&args[0])], false) }
            var out: []Expr = []
            for a in args { append(mut &out, winMarks(&a)) }
            return Expr.Call(name.clone(), out, star)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), winMarks(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), winMarks(&a), winMarks(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(winMarks(&a), neg) }
        Expr.Cast(a, t) { return Expr.Cast(winMarks(&a), t) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// x with each mark read from its slot, after the aggregates' (base).
fn winSlots(x: &Expr, base: int): Expr {
    match x {
        Expr.Call(name, args, star) {
            if name == "#wmark" { return slotRef(base + lexdb_sql.litInt(&args[0])) }
            var out: []Expr = []
            for a in args { append(mut &out, winSlots(&a, base)) }
            return Expr.Call(name.clone(), out, star)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), winSlots(&a, base)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), winSlots(&a, base), winSlots(&b, base)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(winSlots(&a, base), neg) }
        Expr.Cast(a, t) { return Expr.Cast(winSlots(&a, base), t) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

fn optClone(x: &Option[Expr]): Option[Expr] {
    match x {
        Some(v) { return Some(lexdb_sql.cloneExpr(&v)) }
        None { return None }
    }
}

fn cloneFrame(f: &lexdb_sql.Frame): lexdb_sql.Frame {
    return lexdb_sql.Frame{mode: f.mode, start: f.start, startOff: optClone(&f.startOff), end: f.end, endOff: optClone(&f.endOff),
                           exclude: f.exclude}
}

fn cloneWin(d: &lexdb_sql.WinDef): lexdb_sql.WinDef {
    var order: []lexdb_sql.WinOrder = []
    for o in d.order { append(mut &order, lexdb_sql.WinOrder{expr: lexdb_sql.cloneExpr(&o.expr), desc: o.desc, nullsFirst: o.nullsFirst}) }
    return lexdb_sql.WinDef{call: lexdb_sql.cloneExpr(&d.call), ref: d.ref.clone(), bare: d.bare, part: lexdb_sql.cloneAllExpr(&d.part), order: order,
                            frame: cloneFrame(&d.frame)}
}

// A window call's definition with the named window it names merged in,
// by PostgreSQL's rules: OVER w is w as it is; OVER (w ...) takes w's
// partitions and order, and may add an order (if w has none) and a frame
// (w may not have one).
fn mergeWin(d: &lexdb_sql.WinDef, named: &[]lexdb_sql.NamedWin, depth: int): Result[lexdb_sql.WinDef, DbErr] {
    if d.ref == "" { return Ok(cloneWin(d)) }
    var k = -1
    for i in 0..len(named) { if named[i].name == d.ref { k = i } }
    if k < 0 || depth > len(named) { return Err(e("42704", &("window \"" + d.ref + "\" does not exist"))) }
    var b = try mergeWin(&named[k].def, named, depth + 1)
    b.call = lexdb_sql.cloneExpr(&d.call)
    b.ref = ""
    b.bare = false
    if d.bare { return Ok(b) }
    if len(d.part) > 0 { return Err(e("42P20", &("cannot override PARTITION BY clause of window \"" + d.ref + "\""))) }
    if len(b.order) > 0 && len(d.order) > 0 { return Err(e("42P20", &("cannot override ORDER BY clause of window \"" + d.ref + "\""))) }
    if b.frame.mode != lexdb_sql.FR_NONE { return Err(e("42P20", &("cannot copy window \"" + d.ref + "\" because it has a frame clause"))) }
    if len(d.order) > 0 {
        var order: []lexdb_sql.WinOrder = []
        for o in d.order { append(mut &order, lexdb_sql.WinOrder{expr: lexdb_sql.cloneExpr(&o.expr), desc: o.desc, nullsFirst: o.nullsFirst}) }
        b.order = order
    }
    b.frame = cloneFrame(&d.frame)
    return Ok(b)
}

fn noSpec(): AggSpec {
    return lexdb_agg.spec("", [], false, false, None, [], "", "", lexdb_sql.COLL_EXACT)
}

fn modeName(m: int): str {
    return if m == lexdb_sql.FR_ROWS { "ROWS" } else if m == lexdb_sql.FR_GROUPS { "GROUPS" } else { "RANGE" }
}

// A window call planned: its function checked, its frame made whole (the
// default: RANGE UNBOUNDED PRECEDING to CURRENT ROW, which without ORDER BY
// is the whole partition: every row a peer).
fn winPlan(d: &lexdb_sql.WinDef): Result[WinPlan, DbErr] {
    var name = ""
    var args: []Expr = []
    var star = false
    match d.call {
        Expr.Call(n, a, st) {
            name = n.clone()
            args = lexdb_sql.cloneAllExpr(&a)
            star = st
        }
        else {}
    }
    let base = lexdb_sql.aggBase(&name)
    var w = WinPlan{fname: base.clone(), agg: false, spec: noSpec(), args: [], part: lexdb_sql.cloneAllExpr(&d.part), order: [], desc: [], nullsFirst: [],
                    mode: d.frame.mode, start: d.frame.start, startOff: optClone(&d.frame.startOff), end: d.frame.end,
                    endOff: optClone(&d.frame.endOff), exclude: d.frame.exclude}
    for o in d.order {
        append(mut &w.order, lexdb_sql.cloneExpr(&o.expr))
        append(mut &w.desc, o.desc)
        append(mut &w.nullsFirst, o.nullsFirst)
    }
    if lexdb_pct.isPct(&base) {
        // an ordered-set aggregate's window is the partition: no ORDER BY, no frame (SQL Server 10758 and 10752;
        // Oracle's grammar allows the partition clause alone)
        match lexdb_pct.windowErr(lexdb_pct.dialectOf(&name), &base, len(w.order) > 0, w.mode != lexdb_sql.FR_NONE) {
            Some(pe) { return Err(pe) }
            None {}
        }
    }
    if w.mode == lexdb_sql.FR_NONE {
        w.mode = lexdb_sql.FR_RANGE
        w.start = lexdb_sql.B_UNBOUNDED_PRECEDING
        w.end = lexdb_sql.B_CURRENT
    }
    if strings.contains(&name, " distinct") { return Err(e("0A000", "DISTINCT is not implemented for window functions")) }
    if lexdb_bind.isAgg(&name) {
        if strings.contains(&name, " order:") && !lexdb_pct.isPct(&base) { return Err(e("0A000", "aggregate ORDER BY is not implemented for window functions")) }
        var specs: []AggSpec = []
        let r = try collectAggs(&d.call, mut &specs)
        w.agg = true
        w.spec = pop(mut &specs)
    } else if lexdb_bind.isWinFn(&base) {
        if strings.contains(&name, " filter") { return Err(e("0A000", "FILTER is not implemented for non-aggregate window functions")) }
        let n = len(args)
        let none = base == "row_number" || base == "rank" || base == "dense_rank" || base == "percent_rank" || base == "cume_dist"
        let ok = (none && n == 0) || (base == "ntile" && n == 1) || ((base == "lag" || base == "lead") && n >= 1 && n <= 3) ||
                 ((base == "first_value" || base == "last_value") && n == 1) || (base == "nth_value" && n == 2)
        if !ok || star { return Err(e("42883", &("function " + base + " with " + n.toStr() + " argument" + (if n == 1 { "" } else { "s" }) + " does not exist"))) }
        w.args = args
    } else {
        return Err(e("42809", &("OVER specified, but " + base + " is not a window function nor an aggregate function")))
    }
    let offs = w.start == lexdb_sql.B_PRECEDING || w.start == lexdb_sql.B_FOLLOWING || w.end == lexdb_sql.B_PRECEDING ||
               w.end == lexdb_sql.B_FOLLOWING
    if w.mode == lexdb_sql.FR_RANGE && offs && len(w.order) != 1 {
        return Err(e("42P20", "RANGE with offset PRECEDING/FOLLOWING requires exactly one ORDER BY column"))
    }
    if w.mode == lexdb_sql.FR_GROUPS && len(w.order) == 0 { return Err(e("42P20", "GROUPS mode requires an ORDER BY clause")) }
    var ns: []str = []
    match w.startOff { Some(x) { lexdb_sql.colNames(&x, mut &ns) } None {} }
    match w.endOff { Some(x) { lexdb_sql.colNames(&x, mut &ns) } None {} }
    if len(ns) > 0 { return Err(e("42P10", &("argument of " + modeName(w.mode) + " must not contain variables"))) }
    return Ok(w)
}

// A frame's offset: evaluated once, not NULL, not negative (ROWS and
// GROUPS: a whole number).
fn frameOff(x: &Option[Expr], w: &WinPlan, start: bool, params: &[]Val): Result[Val, DbErr] {
    let which = if start { "starting" } else { "ending" }
    match x {
        Some(v) {
            let noCols: []lexdb_sql.ColDef = []
            let none: []Val = []
            let noSubs: []SubRes = []
            let noSeq: Option[SeqEnv] = None
            let env = Env{cols: &noCols, row: &none, aggs: &none, params: params, subs: &noSubs, cur: &none, seq: &noSeq}
            let r = try eval(&v, &env)
            if lexdb_ops.isNull(&r) { return Err(e("22004", &("frame " + which + " offset must not be null"))) }
            if w.mode != lexdb_sql.FR_RANGE {
                let t = lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}
                let n = try lexdb_ops.coerce(r, &t)
                match n {
                    Val.Int(i) { if i < 0 { return Err(e("22013", &("frame " + which + " offset must not be negative"))) } }
                    else {}
                }
                return Ok(n)
            }
            // (an interval offset is compared with a zero interval: a date-time key's)
            var zero = Val.Int(0)
            match r { Val.Ival(_) { zero = Val.Ival(lexdb_time.Ival{months: 0, days: 0, us: 0}) } else {} }
            if try lexdb_ops.compare(&r, &zero) < 0 { return Err(e("22013", "invalid preceding or following size in window function")) }
            return Ok(r)
        }
        None { return Ok(Val.Int(0)) }
    }
}

// The values of a query's window calls for each of its rows: per call a column
// (lexdb_window), by the batches' path (batches on: over typed key columns,
// every call) or by the row path (lexdb_batch off: the tests' reference);
// the engine evaluates what needs its scope, through a hook.
fn winValues(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sel: &Sel, rows: &[]WinRow, m: &Mats, params: &[]Val,
             rs: mut &Run): Result[[][]Val, DbErr] {
    let sqe = seqEnv(st, txn)
    let q = &sel.q
    let n = len(rows)
    let fast = rs.batch
    var cols: [][]Val = []
    for w in sel.wins { append(mut &cols, array(n, Val.Null)) }
    let noAggs: []Val = []
    // windows of one partitioning and order share their sort (as PostgreSQL's)
    var specs: []str = []
    for w in sel.wins { append(mut &specs, lexdb_window.winSpecText(&w)) }
    var done: []bool = array(len(sel.wins), false)
    for wi in 0..len(sel.wins) {
        if done[wi] { continue }
        let w = &sel.wins[wi]
        let np = len(w.part)
        let nob = len(w.order)
        // each row's partition and order values, a column per expression;
        // an expression that is a column read at its place, found once, not
        // by its name per row (9.105)
        var xs: []Expr = []
        for x in w.part { append(mut &xs, lexdb_sql.cloneExpr(&x)) }
        for x in w.order { append(mut &xs, lexdb_sql.cloneExpr(&x)) }
        var at: []int = []
        var plain = true
        for x in xs {
            var c = -1
            match x {
                Expr.Col(name, sl) { c = lexdb_bind.colSlot(&q.cols, &name, sl) }
                else {}
            }
            append(mut &at, c)
            if c < 0 { plain = false }
        }
        var vcols: [][]Val = []
        var srt = lexdb_window.noSorted()
        var okey = lexdb_window.KeyCol{slot: -1, vals: []}
        var sorted = false
        if fast {
            // a column read at its place stays in the rows; the others' values made
            var kcols: []lexdb_window.KeyCol = []
            for i in 0..len(xs) { append(mut &kcols, lexdb_window.KeyCol{slot: at[i], vals: if at[i] >= 0 { [] } else { withCapacity(n) }}) }
            if !plain {
                for b in 0..n {
                    let r = &rows[b].row
                    let env = Env{cols: &q.cols, row: r, aggs: &rows[b].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
                    for i in 0..len(xs) { if at[i] < 0 { append(mut &kcols[i].vals, try evalX(st, txn, q, &xs[i], &env, rs)) } }
                }
            }
            if lexdb_window.sortRows(rows, mut &kcols, np, w, mut &srt) {
                sorted = true
                if nob > 0 { okey = lexdb_window.KeyCol{slot: kcols[np].slot, vals: replace(mut &kcols[np].vals, [])} }
            } else {
                // an order key of mixed kinds: every column's values are made, and sorted by value
                for i in 0..len(xs) { append(mut &vcols, replace(mut &kcols[i].vals, [])) }
            }
        } else {
            for i in 0..len(xs) { append(mut &vcols, withCapacity(n)) }
            for b in 0..n {
                let r = &rows[b].row
                if plain {
                    for i in 0..len(xs) { append(mut &vcols[i], if at[i] < len(r) { r[at[i]].clone() } else { Val.Null }) }
                    continue
                }
                let env = Env{cols: &q.cols, row: r, aggs: &rows[b].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
                for i in 0..len(xs) {
                    if at[i] >= 0 && at[i] < len(r) { append(mut &vcols[i], r[at[i]].clone()) }
                    else { append(mut &vcols[i], try evalX(st, txn, q, &xs[i], &env, rs)) }
                }
            }
        }
        // the rows in partition order, then the window's (peers keep the
        // rows' order); where a partition and a peer group start
        if !sorted {
            lexdb_window.sortVals(&vcols, np, n, w, mut &srt)
            if nob > 0 { okey = lexdb_window.KeyCol{slot: -1, vals: replace(mut &vcols[np], [])} }
        }
        for wj in wi..len(sel.wins) {
            if done[wj] || specs[wj] != specs[wi] { continue }
            done[wj] = true
            let wv = &sel.wins[wj]
            let so = try frameOff(&wv.startOff, wv, true, params)
            let eo = try frameOff(&wv.endOff, wv, false, params)
            let wargs = lexdb_window.argsOf(wv)
            let srcs = lexdb_window.argSrcs(&wargs, params, fn(name: &str, sl: int): int { return lexdb_bind.colSlot(&q.cols, name, sl) })
            // (an aggregate's arguments and FILTER are evaluated plainly, as accumulate does)
            try lexdb_window.compute(fast, rows, wv, &srcs, &srt, &okey, &so, &eo, fn(ai: int, r: int): Result[Val, DbErr] {
                let env = Env{cols: &q.cols, row: &rows[r].row, aggs: &rows[r].aggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe}
                if wv.agg { return eval(&wargs[ai], &env) }
                return evalX(st, txn, q, &wargs[ai], &env, rs)
            }, mut &cols[wj])
        }
    }
    // the calls' columns, put in the rows' values
    var out: [][]Val = []
    for b in 0..n {
        var vs: []Val = withCapacity(len(sel.wins))
        for wj in 0..len(sel.wins) { append(mut &vs, replace(mut &cols[wj][b], Val.Null)) }
        append(mut &out, vs)
    }
    return Ok(out)
}

// ---- Batches (design/lexdb.md 9.47, a prototype; the kernels are lexdb_pipe's)
//
// An aggregate query over one table, read in primary key order, runs over
// batches of rows: each batch's columns used are decoded into arrays (an
// integer or boolean column as ints and NULL flags, any other as values),
// the WHERE narrows a list of the rows chosen (one loop per condition, not
// one tree walk per row), and each aggregate adds a column's values into
// plain accumulators per group. The groups end as the row path leaves
// them (Groups), so HAVING, the output and ORDER BY run as before. A query
// of another shape, or a stored value of an unexpected kind, gives false:
// the row path runs instead.

pub const BK_INT: int = lexdb_rows.BK_INT    // a column's kind in a batch: an integer ...
pub const BK_BOOL: int = lexdb_rows.BK_BOOL  // ... a boolean (0, 1) ...
pub const BK_VAL: int = lexdb_rows.BK_VAL    // ... or any other, as values
// Grouped queries run over batches with numerics as units, and those that
// gave way to the row path (a result past its units), for the tests.

// Window calls whose values lexdb_window made by columns (the batches' path), and
// by the row path (lexdb_batch off), for the tests.
pub fn winRuns(): int { return lexdb_window.runCount() }
pub fn winRowRuns(): int { return lexdb_window.rowRunCount() }

pub fn decCounts(): []int {
    let pc = lexdb_pipe.aggCounts()
    return [pc[0], pc[1], pc[2]]
}

// A column of a batch, or an expression's values for the rows chosen.
type BVec = lexdb_rows.BVec

// A batch of a streamed SELECT's output rows (9.101).
type OutBatch = lexdb_rows.OutBatch

fn noBatch(): OutBatch { return lexdb_rows.noOutBatch() }

type Batch = lexdb_rows.Batch
type BX = lexdb_bind.BX
type BNode = lexdb_pipe.BNode
type BGen = lexdb_pipe.BGen
type LikePat = lexdb_pipe.LikePat
type BComp = lexdb_pipe.BComp
type BSpec = lexdb_pipe.BSpec
type ONode = lexdb_pipe.ONode

// Whether x has no column (its value is the same for every row).
fn bConst(x: &Expr): bool {
    match x {
        Expr.Lit(_) { return true }
        Expr.Param(_) { return true }
        Expr.Col(_, _) { return false }
        Expr.Unary(_, a) { return bConst(&a) }
        Expr.Bin(_, a, b) { return bConst(&a) && bConst(&b) }
        Expr.IsNull(a, _) { return bConst(&a) }
        Expr.Cast(a, _) { return bConst(&a) }
        // a char(n) constant's padding (#bppad, the parser's for 'F' compared
        // with a char(1) column: q21's o_orderstatus = 'F'): of constants, a
        // constant
        Expr.Call(n, args, star) {
            if n != "#bppad" || star || len(args) != 2 { return false }
            return bConst(&args[0]) && bConst(&args[1])
        }
    }
}

// x bound for bCompile and bGenOf (lexdb_pipe) where the plan holds no binding (join,
// group and ORDER BY keys, aggregate arguments): over q's columns by
// place, its parameters as slots (BX.Param: the run's, in Mats.ce). None: only eval
// evaluates it.
fn bxOf(x: &Expr, q: &Query): Option[BX] {
    let none: []Val = []
    return lexdb_bind.bindExpr(x, &q.cols, &none, false, &typing())
}



// Where a batch reads the columns used (lexdb_rows.Projection).
type BPlan = lexdb_rows.Projection

// ---- Decoding in two steps (9.108)
//
// A batch of the first level is decoded as PostgreSQL decodes a row for
// its quals (lexdb-engines.md, item 4): the places its conditions read
// first, for every row of a run in one layout; the conditions run over
// the run; the other places are decoded for the rows they keep only. A
// top-N's first key, an integer column, is read first too (Bar): a row
// it sorts after the heap's last kept is dropped before its outputs are
// decoded. Rows not in the fixed layout (tagged, stored apart, read
// merged with the transaction's writes) are decoded whole, as before.

// ---- Column leaves (9.112)
//
// A table leaf a checkpoint wrote as columns (lexdb_page T_CLEAF,
// lexdb_rows) is decoded into a batch a column at a time from its
// columns, only the places used: an integer unpacked from its frame of
// reference, a text a slice of the leaf, a dictionary's entries made once.
// Two steps as for rows (9.108): the places the conditions read, then the
// others for the rows kept. A leaf whose layout's kinds are not its
// table's (lexdb_store.setColSpec was given others) is read row by row,
// its rows rebuilt.

// The first level of q scanned in batches (batchLevel): its
// conditions the batches evaluate (all: every one), its scans, where its
// batches read the columns used, the query's columns' kinds (BK_NONE those
// of the other tables), whether a scan is of a range (not key lookups).
type LPlan = record {
    conds: []BNode
    all: bool
    scans: []Scan
    bp: BPlan
    part: bool
    qkinds: []int
    ranges: bool
    rd: IxRead              // through an index (9.107): how (fillLevel)
    lazy: Lazy              // the conditions' columns decoded first (9.108)
}

// q's first level's plan for batches; None: not a level they scan. An
// index's range is switched to a scan here, as the row path would
// (firstSwitch).
fn bLevelPlan(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, params: &[]Val, rs: mut &Run): Result[Option[LPlan], DbErr] {
    if len(q.levels) == 0 { return Ok(None) }
    let lv = &q.levels[0]
    if !lv.perRow || lv.lateral || lv.virt() || (q.corr && pathCorr(&lv.path)) { return Ok(None) }
    let p = &lv.path
    // an index read alone, or its entries' rows (where reading may stop
    // early, a LIMIT, in batches that start small: rd.small); not a primary
    // key's point: a row, not a batch's (no plan made: every caller wants a
    // range)
    let only = ixCovers(lv, p.index)
    if !lexdb_plan.scanBatches(p, len(lv.t.pk), only, lv.stops, false) { return Ok(None) }
    let t = &lv.t
    var kinds: []int = []
    for c in t.cols { append(mut &kinds, lexdb_rows.colKind(&c)) }
    var qkinds: []int = array(len(q.cols), lexdb_pipe.BK_NONE)
    // its columns where they are in the joined row (the first table may
    // not be FROM's first: join order, optimizer 25)
    for i in 0..len(t.cols) { qkinds[lv.first + i] = kinds[i] }
    let noAggs: []Val = []
    let nullRow: []Val = array(len(q.cols), Val.Null)
    // (its session: the time zone its scans' bounds are read in, 9.95)
    let sqe1 = seqEnv(st, txn)
    let env = Env{cols: &q.cols, row: &nullRow, aggs: &noAggs, params: params, subs: &m.subs, cur: &noAggs, seq: &sqe1}
    // the conditions batches evaluate. Any of them, in any order: tryRow
    // checks every condition on the rows they keep, and a batch on one of
    // whose rows one gives an error goes to the row path, which tries them
    // in order (an error the row path would not reach is not given).
    var needCol: []bool = []
    for i in 0..len(t.cols) { append(mut &needCol, len(lv.need) == 0 || lv.need[i]) }
    var conds: []BNode = []
    var vol: []bool = []
    for ci in 0..len(lv.cond) {
        match bCondNode(q, m, 0, ci, false, &qkinds, lv.first, &needCol) {
            Some(n) {
                append(mut &conds, n)
                append(mut &vol, isVolatile(&lv.cond[ci]))
            }
            None {}
        }
    }
    let all = len(conds) == len(lv.cond)
    if !all {
        // the row path checks every condition again (tryRow): a volatile one
        // (random()) is left to it alone, evaluated once per row
        // (design/lexdb-layers.md 4.9, rule 1)
        var kept: []BNode = []
        for i in 0..len(conds) { if !vol[i] { append(mut &kept, replace(mut &conds[i], BNode.Const(0, false))) } }
        conds = kept
    }
    var scans = try pathScans(t, p, &env)
    // a batched DELETE or UPDATE's next batch (stage 8): the primary key scan goes on after the last key done
    if len(rs.after) > 0 && p.index < 0 { scans = lexdb_access.afterScans(&scans, &rs.after) }
    var rd = lexdb_access.noIxRead()
    if p.index >= 0 {
        rd.ix = p.index
        rd.desc = p.desc
        rd.small = lv.stops
        if only {
            rd.only = true
            match idxDecOf(t, p.index, &needCol) {
                Some(d) { rd.dec = d }
                None { return Ok(None) }
            }
        } else {
            var keys: []str = []
            let how = try firstSwitch(st, txn, q, &scans, rs, mut &keys)
            if how == 1 { scans = [lexdb_access.wholeScan()] }
            // its range's keys, counted (at most a batch): read once
            if how == 0 && len(keys) <= lexdb_rows.BROWS && !p.desc {
                rd.byKeys = true
                rd.keys = keys
            }
        }
    }
    let part = len(lv.need) > 0
    var needList: []bool = []
    for x in lv.need { append(mut &needList, x) }
    var bp = lexdb_rows.projectionOf(kinds, needCol, &t.slots, rowWidth(t), placesMissing(t), placesNeeded(t, &needList))
    bp.ranges = lexdb_pipe.cRanges(&conds, &bp.kinds, t)
    // key lookups: a row each, not worth a batch
    var ranges = false
    for sc in scans { if !sc.point && !sc.empty { ranges = true } }
    let lazy = lexdb_pipe.lazyOf(&bp, t, &conds, -1)
    return Ok(Some(LPlan{conds: conds, all: all, scans: scans, bp: bp, part: part, qkinds: qkinds, ranges: ranges, rd: rd, lazy: lazy}))
}


// ---- Join paths the pipeline's joins read (slice P2; the batch join driver was deleted with it)

// Joins run in batches (the pipeline's: lexdb_pipe.joinCounts), and those
// with a range per row, for the tests.
pub fn joinPlans(): int { return lexdb_pipe.joinCounts()[0] }

pub fn rangeJoins(): int { return lexdb_pipe.rangeJoins() }

// Level k's condition i (post: of its WHERE conjuncts after it) over a
// batch (kinds: per column of the query, base: the batch's first, need:
// per column of the batch), bound as bCompileCond reads it: compiled for
// batches, else compiled (9.108) and run per row there (bGenOf: the same
// bound tree re-slotted), so one the batches do not type (q7's OR across
// tables, a char(n) compared, q22's substring IN a list) does not send
// the whole query to the row path. None: neither (a subquery, a column
// not read). A row on which it gives an error sends its batch to the row
// path, as a compiled one's does.
fn bCondNode(q: &Query, m: &Mats, k: int, i: int, post: bool, kinds: &[]int, base: int, need: &[]bool): Option[BNode] {
    let xs = if post { &q.levels[k].post } else { &q.levels[k].cond }
    let cs = if post { if len(m.cp) > 0 { &m.cp } else { &q.cp } } else { if len(m.cc) > 0 { &m.cc } else { &q.cc } }
    if k < len(cs) && len(cs[k]) == len(xs) {
        match cs[k][i] {
            Some(b) { return lexdb_pipe.condNode(&b, &q.cols, kinds, &m.ce, base, need) }
            None { return bSubNode(q, m, &xs[i], post, k, kinds, base, need) }
        }
    }
    match bxOf(&xs[i], q) {
        Some(b) { return lexdb_pipe.condNode(&b, &q.cols, kinds, &m.ce, base, need) }
        None { return bSubNode(q, m, &xs[i], post, k, kinds, base, need) }
    }
}

// bCondNode's for x holding a subquery run once (E31, E35, E37): its value,
// or IN's set, read from the run's context (prepareIn: condSubVals), as the
// pipeline's (lexdb_bind.bindSubs). None: not one.
fn bSubNode(q: &Query, m: &Mats, x: &Expr, post: bool, k: int, kinds: &[]int, base: int, need: &[]bool): Option[BNode] {
    if post || k != 0 || len(m.ce.subs) == 0 || (q.corr && hasCorr(x)) { return None }
    var used: []int = []
    subCalls(x, mut &used)
    if len(used) == 0 { return None }
    for u in used { if !subOnce(q, u) || u >= len(m.ce.subs) { return None } }
    let none: []Val = []
    match lexdb_bind.bindSubs(x, &q.cols, &none, &typing()) {
        Some(b) {
            let n = lexdb_pipe.condNode(&b, &q.cols, kinds, &m.ce, base, need)
            if n.isSome() { SUB_CONDS += 1 }
            return n
        }
        None { return None }
    }
}

// The conditions with a subquery that batches evaluated (bSubNode), for the tests.
var SUB_CONDS: int = 0

pub fn subConds(): int { return SUB_CONDS }

// Whether x is the equality of level lv's one hash column with its value
// (hashVals[0]): col = x or x = col, under no collation.
fn isKeyEq(x: &Expr, q: &Query, lv: &Level): bool {
    match x {
        Expr.Bin(op, a, b) {
            if op != "=" { return false }
            let want = lv.first + lv.hashCols[0]
            match a {
                Expr.Col(n, sl) { if lexdb_bind.colSlot(&q.cols, &n, sl) == want && sameExpr(&b, &lv.hashVals[0]) { return true } }
                else {}
            }
            match b {
                Expr.Col(n, sl) { if lexdb_bind.colSlot(&q.cols, &n, sl) == want && sameExpr(&a, &lv.hashVals[0]) { return true } }
                else {}
            }
            return false
        }
        else { return false }
    }
}

// Whether level lv is looked up per row by its whole primary key, its
// values from the tables before it (a point: pathScan), as the batches
// look it up (bLookup): not an index's, a range's, an IN list's, a
// correlated value's.
fn lookupPath(q: &Query, lv: &Level): bool {
    let p = &lv.path
    if lv.virt() || lv.lateral || p.index >= 0 || p.desc || len(p.rng) > 0 || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 { return false }
    if q.corr && pathCorr(p) { return false }
    return len(p.eqs) > 0 && len(p.eqs) == len(keyCols(&lv.t, -1))
}

// Whether a semi/anti level looked up per row (semiLook) reads a range
// the batches read (bRange): its path's leading equalities only.
fn rangePath(q: &Query, lv: &Level): bool {
    let p = &lv.path
    if lv.virt() || lv.lateral || p.desc || len(p.eqs) == 0 || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 { return false }
    // bounds on the next column: constants only (made once: rangeBounds)
    for b in p.rng { if !bConst(&b.val) { return false } }
    if q.corr && pathCorr(p) { return false }
    return true
}

// ---- Indexes read in batches (9.107)
//
// The first table read through an index, in batches:
// - read alone (index-only), when the index's entries hold every column
//   the level uses (its own columns, then the primary key's, which every
//   entry ends with): each entry's key is decoded into the batch's
//   columns, and no row is read. Its reads are the index's range, as the
//   row path's (fetch reads such an index alone too). Entries are
//   versioned with the store, so what the index holds is what the rows
//   hold, as of the read.
// - else its entries' primary keys a batch at a time, the rows read in
//   key order (getMany: from the leaf of the key before, not from the root)
//   and each put at its entry's place, so the batch is in the index's
//   order (a bitmap heap scan's effect, the rows' order kept). In a
//   transaction whose reads are noted the rows are read in the index's
//   order, as the row path reads them, so the reads are noted the same.

// Whether level lv's index (its path's) holds every column it uses: a
// SELECT's (its columns narrowed, 9.31), not locking its rows.
fn ixCovers(lv: &Level, ix: int): bool {
    if ix < 0 || lv.lock != 0 || len(lv.need) == 0 || lv.virt() { return false }
    return idxDecOf(&lv.t, ix, &lv.need).isSome()
}

// Scans the first level's table in batches (9.52): the level's
// conditions that batches can evaluate pick the rows, and only those are
// made into rows and go on as the row path's would (tryRow, which checks
// all the level's conditions). -1: not a level the batches scan (nothing
// done); 0 done; 1 done, emit asked to stop. matched: whether a row went
// on. A batch with a value its column's batch cannot hold, or whose
// conditions give an error on one of its rows, ends the batches: the row
// path reads the rest of that scan from the batch's start (and gives the
// error only if it gets to that row).
fn batchLevel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, m: &Mats, row: mut &[]Val,
              params: &[]Val, emit: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr], rs: mut &Run, matched: mut &bool): Result[int, DbErr] {
    if !rs.batch { return Ok(-1) }
    let got0 = try bLevelPlan(st, txn, q, m, params, rs)
    if got0.isNone() { return Ok(-1) }
    let lp = got0.unwrap()
    let lv = &q.levels[0]
    let t = &lv.t
    let p = &lv.path
    // The query's only level, every condition evaluated by the batches
    // (none at all too): its rows go to emit straight from the batch, not
    // through tryRow, which would check them again, and runLevel (9.100).
    // (A query's joins in batches are the pipeline's: Query.jp, runQuery.)
    let direct = len(q.levels) == 1 && len(lv.post) == 0 && lp.all
    if len(lp.conds) == 0 && !direct { return Ok(-1) }
    if !lp.ranges { return Ok(-1) }
    let bp = &lp.bp
    let zone = txn.sql.zone.clone()
    try warmPoints(st, txn, t, &lp.scans)
    for sc in lp.scans {
        var cur = lexdb_access.newCursor()
        var rowPath = false
        var spare = lexdb_rows.noRows()            // the last batch, used again (bReuse)
        while !cur.done {
            let saved = cur.copy()
            // (decoded in two steps: 9.108)
            let got = try fillPickIn(st, txn, t, &sc, lp.part, mut &cur, bp, &lp.rd, &lp.lazy, &lp.conds, &lexdb_access.noBar(), mut &spare)
            if got.isNone() {
                // a value a batch cannot hold, or an error on some row of
                // the batch: the row path reads it, and gives the error
                // only if it gets to that row (a LIMIT may stop it first)
                cur = saved
                rowPath = true
                break
            }
            var pk = got.unwrap()
            let b = replace(mut &pk.b, lexdb_rows.noRows())
            let idx = replace(mut &pk.idx, [])
            let nr = b.n
            if nr == 0 {
                spare = b
                continue
            }
            rs.cnt[0].batches += 1
            if direct {
                // counted as the row path counts them: the rows dropped as
                // read, each kept row as it goes on (a LIMIT may stop it)
                // (counted and ticked once a batch, for the rows that went on)
                var went = 0
                var stopped = false
                for j in idx {
                    for i in 0..len(bp.kinds) {
                        var v = Val.Null
                        if bp.needCol[i] && !b.cols[i].nul[j] {
                            let k = bp.kinds[i]
                            v = if k == BK_INT { Val.Int(b.cols[i].v[j]) } else if k == BK_BOOL { Val.Bool(b.cols[i].v[j] == 1) } else { b.vals[i][j].clone() }
                        }
                        row[lv.first + i] = v
                    }
                    matched = true
                    went += 1
                    if !(try emit(txn, row)) {
                        stopped = true
                        break
                    }
                }
                rs.cnt[0].read += nr - len(idx) + went
                rs.cnt[0].joined += went
                try rs.bud.tickN(nr - len(idx) + went)
                if stopped { return Ok(1) }
                spare = b
                continue
            }
            // the rows dropped count as read, as the row path counts them
            try rs.bud.tickN(nr - len(idx))
            rs.cnt[0].read += nr - len(idx)
            for j in idx {
                let r = lexdb_pipe.bRow(&b, j, &bp.kinds, &bp.needCol)
                let got2 = try tryRow(st, txn, q, m, 0, &r, -1, row, params, emit, rs)
                if got2 < 0 { return Ok(1) }
                if got2 > 0 { matched = true }
            }
            spare = b
        }
        while rowPath && !cur.done {
            var batch: [][]Val = []
            try fetch(st, txn, t, p, &sc, &lv.need, mut &cur, mut &batch)
            for r in batch {
                let got2 = try tryRow(st, txn, q, m, 0, &r, -1, row, params, emit, rs)
                if got2 < 0 { return Ok(1) }
                if got2 > 0 { matched = true }
            }
        }
    }
    return Ok(0)
}

// The query's columns a grouped select reads after grouping: those its
// outputs, HAVING and ORDER BY (with DISTINCT ON's keys) name.
fn afterCols(sel: &Sel, q: &Query): []int {
    var names: []str = []
    for x in sel.exprs { lexdb_sql.colNames(&x, mut &names) }
    match sel.having {
        Some(h) { lexdb_sql.colNames(&h, mut &names) }
        None {}
    }
    for x in sel.order { lexdb_sql.colNames(&x, mut &names) }
    var out: []int = []
    for n in names {
        let ci = colIndex(&q.cols, &n)
        if ci >= 0 { append(mut &out, ci) }
    }
    return out
}


// ---- The row layout (design/lexdb.md 9.48, 9.50)
//
// A row: FIXED; its layout's number in its table's (Table.layouts), 2
// bytes; a NULL bitmap (bit p%8 of byte p/8); the fixed part, per place in
// order: 8, 4 or 2 bytes an integer (its column's type's width), 1 a
// boolean, 2 a variable-length value's end (from the start of the variable
// part), none a dropped place; then the variable part: texts, and numerics
// in their binary form (Decimal.toBin). Each place is at an offset its
// layout gives, so reading one is a load, not a walk over the places before
// it. A row this cannot hold is in the tagged form (encRow): one with a
// long text (LONG, lexdb_rows.encodeLong), over 255 places, a value not of its place's
// kind, or written with the test hook setFixedRows(false).
//
// Since 9.113 a date, a time, a timestamp and a timestamptz are words in
// the fixed part too (4 bytes the date's days; 8 the others' microseconds),
// as are a double's and a real's bits (8, 4); a uuid (its 16 bytes) and a
// bytea are variable-length values, as texts are. Before, their places
// were text places (PK_TEXT) and a row with such a value was in the tagged
// form; a table keeps such a layout as its current one until its catalog
// row is written again (encFixed: compatible).

// How many of table name's stored rows are in the fixed layout (a test's
// look at the bytes).
pub fn countFixedRows(st: &lexdb_store.Store, name: &str): int {
    var txn = lexdb_store.begin()
    var n = 0
    let found = findTable(st, mut &txn, name).unwrapOr(None)
    match found {
        Some(t) {
            n = lexdb_access.fixedRows(st, mut &txn, &lexdb_catalog.relOf(&t))
        }
        None {}
    }
    st.abort(txn)
    return n
}

// Table name's rows by layout ("0:200 3:150", by layout number; "tagged:N"
// for rows in the tagged form) and its layouts' count: a test's look at
// the bytes.
pub fn rowLayouts(st: &lexdb_store.Store, name: &str): str {
    var txn = lexdb_store.begin()
    var counts: []int = []
    var tagged = 0
    var nl = 0
    let found = findTable(st, mut &txn, name).unwrapOr(None)
    match found {
        Some(t) {
            nl = len(t.layouts)
            counts = lexdb_access.layoutRows(st, mut &txn, &lexdb_catalog.relOf(&t))
            tagged = pop(mut &counts)
        }
        None {}
    }
    st.abort(txn)
    var out: []str = []
    for i in 0..len(counts) { if counts[i] > 0 { append(mut &out, i.toStr() + ":" + counts[i].toStr()) } }
    if tagged > 0 { append(mut &out, "tagged:" + tagged.toStr()) }
    return strings.join(&out, " ") + " of " + nl.toStr() + " layouts"
}

// Table name's leaves: "C cols R rows" (column leaves, leaves of rows; a
// test's look, 9.114).
pub fn leafKinds(st: &lexdb_store.Store, name: &str): str {
    var txn = lexdb_store.begin()
    var out = "no table"
    let found = findTable(st, mut &txn, name).unwrapOr(None)
    st.abort(txn)
    match found {
        Some(t) {
            match lexdb_access.leafKinds(st, &lexdb_catalog.relOf(&t)) {
                Ok(k) { out = k[0].toStr() + " cols " + k[1].toStr() + " rows " + k[2].toStr() + " whole" }
                Err(x) { out = x.toStr() }
            }
        }
        None {}
    }
    return out
}

// Table name's trees as text, "name entries hash" per line, the table's
// first and then each index's: every entry's key and value (a test's
// comparison of what two ways of deleting left in the indexes).
pub fn treeDump(st: &lexdb_store.Store, name: &str): str {
    var txn = lexdb_store.begin()
    var out: []str = []
    let found = findTable(st, mut &txn, name).unwrapOr(None)
    match found {
        Some(t) {
            out = lexdb_access.treeDump(st, mut &txn, &lexdb_catalog.relOf(&t))
        }
        None { append(mut &out, "no table") }
    }
    st.abort(txn)
    return strings.join(&out, "; ")
}

// ---- lexdb_access: a relation's layout, keys and ranges

type Scan = lexdb_access.Scan
type Cursor = lexdb_access.Cursor

// A row's key: its identity in its table (locks, rows already changed).
fn keyOf(t: &Table, row: &[]Val): str { return lexdb_access.keyOf(&lexdb_catalog.relOf(t), row) }

// Rows and index entries read (lexdb_access), for a Table and a Path.
type IdxDec = lexdb_access.IdxDec
type IxRead = lexdb_access.IxRead
type Lazy = lexdb_access.Lazy
type Bar = lexdb_access.Bar
type Picked = lexdb_access.Picked

fn rowOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, key: &str, v: &str, n: int,
         need: &[]bool, missing: &[]Val): Result[[]Val, DbErr] {
    return lexdb_access.rowOf(st, txn, &lexdb_catalog.relOf(t), key, v, n, need, missing)
}

fn placesMissing(t: &Table): []Val { return lexdb_access.placesMissing(&lexdb_catalog.relOf(t)) }
fn placesNeeded(t: &Table, need: &[]bool): []bool { return lexdb_access.placesNeeded(&lexdb_catalog.relOf(t), need) }

fn fetch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, p: &Path, sc: &Scan, need: &[]bool, cur: mut &Cursor,
         out: mut &[][]Val): Result[Unit, DbErr] {
    return lexdb_access.fetch(st, txn, &lexdb_catalog.relOf(t), p.index, p.desc, sc, need, cur, out)
}

fn idxDecOf(t: &Table, ix: int, needCol: &[]bool): Option[IdxDec] { return lexdb_access.idxDecOf(&lexdb_catalog.relOf(t), ix, needCol) }

fn fillLevel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, rd: &IxRead, sc: &Scan, part: bool, cur: mut &Cursor,
             bp: &BPlan, spare: mut &Batch): Result[Option[Batch], DbErr] {
    return lexdb_access.fillLevel(st, txn, &lexdb_catalog.relOf(t), rd, sc, part, cur, bp, spare)
}

// A level's next batch with its rows chosen by conds (lexdb_access.fillPickIn).
fn fillPick(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, sc: &Scan, part: bool, cur: mut &Cursor,
            bp: &BPlan, rd: &IxRead, lz: &Lazy, conds: &[]BNode, bar: &Bar): Result[Option[Picked], DbErr] {
    var none = lexdb_rows.noRows()
    return fillPickIn(st, txn, t, sc, part, cur, bp, rd, lz, conds, bar, mut &none)
}

fn fillPickIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, sc: &Scan, part: bool, cur: mut &Cursor,
              bp: &BPlan, rd: &IxRead, lz: &Lazy, conds: &[]BNode, bar: &Bar, spare: mut &Batch): Result[Option[Picked], DbErr] {
    return lexdb_access.fillPickIn(st, txn, &lexdb_catalog.relOf(t), sc, part, cur, bp, rd, lz,
                                   fn(skip: &[]bool, b: &Batch, idx: []int): Option[[]int] { return lexdb_pipe.bNarrow(conds, skip, b, idx) }, bar, spare)
}

fn countRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, most: int): Result[int, DbErr] {
    return lexdb_access.countRows(st, txn, &lexdb_catalog.relOf(t), most)
}

fn warmPoints(st: &lexdb_store.Store, txn: &lexdb_store.Txn, t: &Table, scans: &[]Scan): Result[Unit, DbErr] {
    return lexdb_access.warmPoints(st, txn, &lexdb_catalog.relOf(t), scans)
}

// The order-preserving value encoding (lexdb_access), for keys held in
// memory: groups, hashes, partitions, statistics.

fn rowsFor(t: &Table): lexdb_rows.Rows {
    return lexdb_rows.Rows{layouts: &t.layouts, cols: &t.cols, slots: &t.slots, width: rowWidth(t), lays: &t.lays}
}

fn placeKinds(t: &Table): []byte { let r = rowsFor(t); return lexdb_rows.placeKinds(&r) }
fn kindsFit(t: &Table, kinds: &[]byte): bool { let r = rowsFor(t); return lexdb_rows.kindsFit(&r, kinds) }
type FixedLay = lexdb_rows.FixedLay

// ---- pg_catalog and information_schema (9.80)
//
// The catalog relations are functions in FROM ("#pg_class", ...) whose
// rows are made here from lexdb's own catalog when a statement runs. OIDs
// are made from names (catOid), so a relation keeps its OID while it keeps
// its name. The catalog functions (pg_get_constraintdef, regclass, ...)
// read the catalog as the statement bound it (bindCatalog): a summary in the
// store's memo, keyed by the session, as nextval's sequences are bound.

fn cloneOptE(x: &Option[Expr]): Option[Expr] {
    match x {
        Some(e) { return Some(lexdb_sql.cloneExpr(&e)) }
        None { return None }
    }
}

fn catMemoKey(sess: int): str { return "\x00cat\x00" + sess.toStr() }

fn sysUserKey(sess: int): str { return "\x00sysuser\x00" + sess.toStr() }

// PostgreSQL's SYSTEM_USER of the session: how the login was authenticated and as whom ("scram-sha-256:name").
pub fn (s: &Session) setSystemUser(u: &str) { s.st.memo.put(&sysUserKey(s.id), u) }

// The session's user, from its startup message.
pub fn (s: &Session) setUser(u: &str) { s.st.memo.put(&lexdb_catalog.userKey(s.id), u) }

// The session's number (its catalog memos' key; T-SQL's @@SPID).
pub fn (s: &Session) number(): int { return s.id }

// The session's user, from its startup message.
pub fn (s: &Session) user(): str { return s.st.memo.get(&lexdb_catalog.userKey(s.id)).unwrapOr("lexdb") }

// The catalog as the transaction sees it.

// What the catalog functions look up, in the memo: one line a fact.
fn bindCatalog(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[Unit, DbErr] {
    let snap = try catSnap(st, txn)
    var b = ""
    b += &("u\t" + currentRole(st, txn.sql.sess) + "\n")
    b += &("U\t" + sessionUser(st, txn.sql.sess) + "\n")
    // the roles: OID, name, superuser, the roles each acts as; and every owner and grant (9.83)
    for r in try rolesIn(st, txn) {
        let w = try whoIs(st, txn, &r.name)
        b += &("R\t" + lexdb_pg.catOid(&"a", &r.name).toStr() + "\t" + r.name + "\t" + (if w.super { "1" } else { "0" }) + "\t" +
              strings.join(&w.roles, "\x1e") + "\n")
    }
    var aks: []str = []
    var avs: []str = []
    try catScan(st, txn, &lexdb_catalog.ACL_PRE, &(lexdb_catalog.ACL_PRE + "\xff"), &(lexdb_catalog.ACL_PRE + "r:"), fn(en: &lexdb_store.Entry): bool {
        append(mut &aks, en.key[len(lexdb_catalog.ACL_PRE)..len(en.key)].toStr())
        append(mut &avs, strings.replaceAll(&(strings.replaceAll(&en.val, "\n", "\x1e")), "\t", "\x1d"))
        return true
    })
    for i in 0..len(aks) { b += &("A\t" + aks[i] + "\t" + avs[i] + "\n") }
    var cur = "public"
    for x in snap.path {
        if x != txn.tmp {
            cur = x.clone()
            break
        }
    }
    b += &("p\t" + cur + "\n")
    if len(txn.tmp) > 0 { b += &("T\t" + txn.tmp + "\n") }       // the session's temporary schema (9.96)
    for ct in snap.tabs {
        b += &("r\t" + ct.oid.toStr() + "\t" + ct.shown + "\t" + ct.schema + "\t" + ct.name + "\n")
        // the trees, for the size functions: the table's, then its indexes'
        var trees: []str = [ct.t.tree.toStr()]
        for x in ct.t.indexes { append(mut &trees, x.tree.toStr()) }
        b += &("z\t" + ct.oid.toStr() + "\tt\t" + strings.join(&trees, ",") + "\n")
        for ix in ct.idxs {
            // a primary key is the table's own tree in lexdb: no pages of its own
            for x in ct.t.indexes { if lexdb_sql.baseName(&x.name) == ix.name { b += &("z\t" + ix.oid.toStr() + "\ti\t" + x.tree.toStr() + "\n") } }
        }
        for ix in ct.idxs {
            b += &("r\t" + ix.oid.toStr() + "\t" + lexdb_pg.shownIn(&snap.path, &ct.schema, &ix.name) + "\t" + ct.schema + "\t" + ix.name + "\n")
            var cols: []str = []
            for c in ix.cols { append(mut &cols, if c >= 1 && c <= len(ct.t.cols) { ct.t.cols[c - 1].name.clone() } else { "" }) }
            b += &("x\t" + ix.oid.toStr() + "\t" + lexdb_pg.clean(&lexdb_pg.idxDef(&ct, &ix)) + "\t" + strings.join(&cols, "\x1e") + "\t" + lexdb_pg.clean(&lexdb_pg.idxDefOn(&ct, &ix, &ct.shown, true)) + "\n")
        }
        for c in ct.t.cols {
            if len(c.seq) > 0 && c.name != lexdb_catalog.ROWID {
                b += &("s\t" + ct.oid.toStr() + "\t" + c.name + "\t" + lexdb_pg.quoteIfNeeded(&lexdb_sql.schemaOf(&c.seq)) + "." +
                      lexdb_pg.quoteIfNeeded(&lexdb_sql.baseName(&c.seq)) + "\n")
            }
        }
    }
    for v in snap.views {
        b += &("r\t" + v.oid.toStr() + "\t" + v.shown + "\t" + v.schema + "\t" + v.name + "\n")
        b += &("w\t" + v.oid.toStr() + "\t" + lexdb_pg.clean(&lexdb_sql.viewShown(&v.t.view)) + "\n")
    }
    for en in snap.enums {
        let sc = lexdb_sql.schemaOf(&en.key)
        let nm = lexdb_sql.baseName(&en.key)
        b += &("e\t" + en.oid.toStr() + "\t" + lexdb_pg.shownIn(&snap.path, &sc, &nm) + "\n")
    }
    for d in snap.seqs {
        let sc = lexdb_sql.schemaOf(&d.key)
        let nm = lexdb_sql.baseName(&d.key)
        b += &("z\t" + lexdb_catalog.seqOid(&d).toStr() + "\tS\t\n")
        b += &("r\t" + lexdb_catalog.seqOid(&d).toStr() + "\t" + lexdb_pg.shownIn(&snap.path, &sc, &nm) + "\t" + sc + "\t" + nm + "\n")
    }
    for r in lexdb_pgcat.relNames() {
        let dot = strings.indexOf(&r, ".", 0)
        let sc = if dot < 0 { "pg_catalog" } else { r[0..dot].clone() }
        let nm = if dot < 0 { r.clone() } else { r[dot + 1..len(r)].clone() }
        b += &("r\t" + (if dot < 0 { lexdb_pg.sysRelOid(&r) } else { lexdb_pg.catOid(&"r", &(sc + "\x1f" + nm)) }).toStr() + "\t" +
              lexdb_pg.shownIn(&snap.path, &sc, &nm) + "\t" + sc + "\t" + nm + "\n")
    }
    for c in snap.cons { b += &("c\t" + c.oid.toStr() + "\t" + lexdb_pg.clean(&c.def) + "\n") }
    lexdb_syscat.bind(&snap, mut &b)
    for s in snap.schemas { b += &("n\t" + lexdb_pg.nspOid(&s).toStr() + "\t" + s + "\n") }
    b += "n\t11\tpg_catalog\nn\t13000\tinformation_schema\n"
    st.memo.put(&catMemoKey(txn.sql.sess), &b)
    return Ok(Unit{})
}

// The bound catalog's lines of a kind, split at tabs.
fn catLines(se: &SeqEnv, kind: &str): [][]str {
    let all = se.st.memo.get(&catMemoKey(se.sess)).unwrapOr("")
    var out: [][]str = []
    for l in strings.split(&all, "\n") {
        if len(l) > 2 && l[0..1] == kind && l[1] == '\t' {
            var fs: []str = []
            for f in strings.split(&l[2..len(l)], "\t") { append(mut &fs, f.toStr()) }
            append(mut &out, fs)
        }
    }
    return out
}

fn catUser(se: &SeqEnv): str {
    for l in catLines(se, &"u") { return l[0].clone() }
    return se.st.memo.get(&lexdb_catalog.userKey(se.sess)).unwrapOr("lexdb")
}

// A relation's OID by its name as written (schema.name, or a name on the
// path; quoted parts as they are), 0 if none.
fn relOidOf(se: &SeqEnv, s: &str): int {
    var sc = ""
    var nm = strings.trim(&s)
    var parts: []str = []
    var cur = ""
    var q = false
    for i in 0..len(nm) {
        let c = nm[i]
        if c == '"' { q = !q }
        else if c == '.' && !q {
            append(mut &parts, cur)
            cur = ""
        } else { cur.addByte(if c >= 'A' && c <= 'Z' { c + 32 } else { c }) }     // quoted or not: names match folded (L6)
    }
    append(mut &parts, cur)
    if len(parts) == 2 { sc = parts[0].clone() }
    if sc == "pg_temp" {
        sc = "pg_temp_"            // the session's temporary schema (9.96); none: no name matches
        for l in catLines(se, &"T") { sc = l[0].clone() }
    }
    let name = parts[len(parts) - 1].clone()
    for l in catLines(se, &"r") {
        if l[3] != name { continue }
        if len(sc) > 0 && l[2] != sc { continue }
        if len(sc) == 0 && strings.indexOf(&l[1], ".", 0) >= 0 && l[1] != lexdb_pg.quoteIfNeeded(&name) { continue }
        return strings.parseIntOpt(&l[0]).unwrapOr(0)
    }
    return 0
}

// The size functions (9.97) of relation oid in bytes: a table's tree (its
// rows, with its primary key) and its indexes' trees, counted by
// lexdb_store.treePages; a sequence one PostgreSQL page; a view or catalog
// relation 0; NULL for no relation.
fn relSize(se: &SeqEnv, name: &str, oid: int): Result[Val, DbErr] {
    let k = oid.toStr()
    for l in catLines(se, &"z") {
        if l[0] != k { continue }
        if l[1] == "S" { return Ok(Val.Int(if name == "pg_indexes_size" { 0 } else { 8192 })) }
        let trees = strings.split(&l[2], ",")
        var pages = 0
        for i in 0..len(trees) {
            let tr = strings.parseIntOpt(&trees[i]).unwrapOr(-1)
            if tr < 0 { continue }
            let mine = i == 0
            let take = if l[1] == "i" { name != "pg_indexes_size" } else if name == "pg_indexes_size" { !mine } else if name == "pg_total_relation_size" { true } else { mine }
            if take { pages += try se.st.treePages(tr) }
        }
        return Ok(Val.Int(pages * lexdb_rows.PAGE))
    }
    if relShown(se, oid).isSome() { return Ok(Val.Int(0)) }
    return Ok(Val.Null)
}

// PostgreSQL's pg_size_pretty: bytes below 10 kB, then kB, MB, GB, TB and PB,
// each kept below 20480 of itself, rounded half away from zero.
fn relShown(se: &SeqEnv, oid: int): Option[str] {
    let k = oid.toStr()
    for l in catLines(se, &"r") { if l[0] == k { return Some(l[1].clone()) } }
    return None
}

// A value cast to a reg type: a name looked up, an OID shown by its name.
fn regCast(v: &Val, oid: int, se: &Option[SeqEnv]): Result[Val, DbErr] {
    if lexdb_ops.isNull(v) { return Ok(Val.Null) }
    let num = lexdb_ops.oidArg(v)
    let name: &str = match v {
        Val.Text(s) { s }
        else { "" }
    }
    if oid == lexdb_sql.OID_REGTYPE {
        match num {
            Some(n) { return Ok(Val.Reg(n, if lexdb_pgcat.typeOf(n).isSome() { lexdb_pgcat.formatType(n, -1) } else { n.toStr() })) }
            None {}
        }
        let t = lexdb_pgcat.typeByName(name)
        if t == 0 { return Err(e("42704", &("type \"" + name + "\" does not exist"))) }
        return Ok(Val.Reg(t, lexdb_pgcat.formatType(t, -1)))
    }
    let q: &SeqEnv = match se {
        Some(x) { x }
        None { return Err(e("0A000", "lexdb: a reg type is not allowed here")) }
    }
    if oid == lexdb_sql.OID_REGNAMESPACE {
        for l in catLines(&q, &"n") {
            match num {
                Some(n) { if l[0] == n.toStr() { return Ok(Val.Reg(n, lexdb_pg.quoteIfNeeded(&l[1]))) } }
                None { if l[1] == name { return Ok(Val.Reg(strings.parseIntOpt(&l[0]).unwrapOr(0), lexdb_pg.quoteIfNeeded(&l[1]))) } }
            }
        }
        match num {
            Some(n) { return Ok(Val.Reg(n, n.toStr())) }
            None { return Err(e("3F000", &("schema \"" + name + "\" does not exist"))) }
        }
    }
    match num {
        Some(n) { return Ok(Val.Reg(n, relShown(&q, n).unwrapOr(n.toStr()))) }
        None {}
    }
    let o = relOidOf(&q, name)
    if o == 0 {
        if oid == lexdb_sql.OID_REGCLASS { return Err(e("42P01", &("relation \"" + name + "\" does not exist"))) }
        return Err(e("42883", &("function \"" + name + "\" does not exist")))
    }
    return Ok(Val.Reg(o, relShown(&q, o).unwrapOr(name.toStr())))
}

// Whether a select list calls a set-returning function: only then are its
// rows looked through for marked values.
fn hasSrfCall(xs: &[]Expr): bool {
    for x in xs { if srfIn(&x) { return true } }
    return false
}

fn srfIn(x: &Expr): bool {
    match x {
        Expr.Call(n, args, _) {
            if n == "unnest" || n == "generate_subscripts" || n == "pg_partition_ancestors" || n == "regexp_matches" ||
               n == "regexp_split_to_table" || n == "string_to_table" { return true }
            for a in args { if srfIn(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return srfIn(&a) }
        Expr.Bin(_, a, b) { return srfIn(&a) || srfIn(&b) }
        Expr.IsNull(a, _) { return srfIn(&a) }
        Expr.Cast(a, _) { return srfIn(&a) }
        else { return false }
    }
}

fn srfParts(v: &Val): Option[[]Option[str]] {
    match v {
        Val.Text(s) {
            if strings.startsWith(&s, lexdb_lib.SRF_MARK) {
                match lexdb_ops.arrayParts(&s[len(lexdb_lib.SRF_MARK)..len(s)]) {
                    Ok(p) { return Some(p) }
                    Err(_) {}
                }
            }
        }
        else {}
    }
    return None
}

// Each row with set-returning values made into as many rows as the longest
// has values (the others NULL past their end), as PostgreSQL 10 on does;
// none if every one is empty.
fn expandSrfs(rows: mut &[]OutRow, outs: &[]OutCol): Result[Unit, DbErr] {
    var any = false
    for r in rows { for v in r.vals { if srfParts(&v).isSome() { any = true } } }
    if !any { return Ok(Unit{}) }
    var out: []OutRow = []
    for ri in 0..len(rows) {
        let r = replace(mut &rows[ri], OutRow{vals: [], ord: []})
        var parts: []Option[[]Option[str]] = []
        var n = -1
        for v in r.vals {
            let p = srfParts(&v)
            match p {
                Some(ps) { if len(ps) > n { n = len(ps) } }
                None {}
            }
            append(mut &parts, p)
        }
        if n < 0 {
            append(mut &out, r)
            continue
        }
        for k in 0..n {
            var vals: []Val = []
            for c in 0..len(r.vals) {
                match parts[c] {
                    Some(ps) {
                        if k < len(ps) {
                            match ps[k] {
                                Some(t) {
                                    let ty = lexdb_sql.oidType(if c < len(outs) { outs[c].oid } else { lexdb_sql.OID_TEXT })
                                    append(mut &vals, if ty.kind == lexdb_sql.K_REG { Val.Reg(strings.parseIntOpt(&t).unwrapOr(0), t.clone()) } else { try lexdb_ops.coerce(Val.Text(t.clone()), &ty) })
                                }
                                None { append(mut &vals, Val.Null) }
                            }
                        } else {
                            append(mut &vals, Val.Null)
                        }
                    }
                    None { append(mut &vals, r.vals[c].clone()) }
                }
            }
            append(mut &out, OutRow{vals: vals, ord: collections.copyOf(&r.ord)})
        }
    }
    let gone = replace(rows, out)
    return Ok(Unit{})
}

// ---- the functions of 9.92 (lexdb_func): strings, regular expressions,
// math and arrays

// a || b with an array on either side (9.92): lexdb_bind's.
fn arrayConcat(a: &Expr, b: &Expr, cols: &[]lexdb_sql.ColDef, pt: &[]int): str { return lexdb_bind.arrayConcat(a, b, cols, pt, &typing()) }

// The functions that need the session (9.92).
fn isSessFn(n: &str): bool {
    return n == "current_setting" || n == "set_config" || n == "pg_backend_pid" || n == "txid_current" || n == "pg_current_xact_id" ||
           n == "pg_my_temp_schema" || n == "pg_is_other_temp_schema"
}

fn sessCall(name: &str, vs: &[]Val, env: &Env): Result[Val, DbErr] {
    let se: &SeqEnv = match env.seq {
        Some(x) { x }
        None { return Err(e("0A000", &("lexdb: " + name + " is not allowed here"))) }
    }
    let n = len(vs)
    if name == "pg_backend_pid" && n == 0 { return Ok(Val.Int(se.sess)) }
    // the session's temporary schema's OID, 0 none; whether an OID is
    // another session's (9.96: they are not in lexdb's pg_namespace, so
    // no OID of one is known)
    if name == "pg_my_temp_schema" && n == 0 {
        match se.st.memo.get(&tmpMemo(se.sess)) {
            Some(t) { return Ok(Val.Int(lexdb_pg.nspOid(&t))) }
            None { return Ok(Val.Int(0)) }
        }
    }
    if name == "pg_is_other_temp_schema" && n == 1 { return Ok(if lexdb_ops.isNull(&vs[0]) { Val.Null } else { Val.Bool(false) }) }
    if (name == "txid_current" || name == "pg_current_xact_id") && n == 0 {
        // a number per transaction: the next of the store's count the first time
        // a transaction asks, the same after
        let key = "\x00xid\x00" + se.sess.toStr()
        let mine = se.st.memo.get(&key).unwrapOr("")
        let nl = strings.indexOf(&mine, "\n", 0)
        if nl > 0 && mine[0..nl] == se.now.toStr() { return Ok(Val.Int(lexdb_base.num(&mine[nl + 1..len(mine)]))) }
        let x = lexdb_base.num(&se.st.memo.get(&"xids").unwrapOr("1000")) + 1
        se.st.memo.put(&"xids", &x.toStr())
        se.st.memo.put(&key, &(se.now.toStr() + "\n" + x.toStr()))
        return Ok(Val.Int(x))
    }
    let lines = se.st.memo.get(&settingsKey(se.sess)).unwrapOr("")
    if name == "current_setting" && (n == 1 || n == 2) {
        if lexdb_ops.isNull(&vs[0]) || (n == 2 && lexdb_ops.isNull(&vs[1])) { return Ok(Val.Null) }
        let k = strings.toLowerAscii(&(lexdb_sql.text(&vs[0])))
        for l in strings.split(&lines, "\n") {
            let t = strings.indexOf(&l, "\t", 0)
            if t > 0 && l[0..t] == k { return Ok(Val.Text(l[t + 1..len(l)].toStr())) }
        }
        if n == 2 && lexdb_ops.truth(&vs[1]) == Some(true) { return Ok(Val.Null) }
        return Err(e("42704", &("unrecognized configuration parameter \"" + lexdb_sql.text(&vs[0]) + "\"")))
    }
    if name == "set_config" && n == 3 {
        if lexdb_ops.isNull(&vs[0]) { return Err(e("22004", "SET requires parameter name")) }
        let k = strings.toLowerAscii(&(lexdb_sql.text(&vs[0])))
        var known = strings.contains(&k, ".")
        for x in SHOWN { if x == k { known = true } }
        if !known { return Err(e("42704", &("unrecognized configuration parameter \"" + lexdb_sql.text(&vs[0]) + "\""))) }
        var v = if lexdb_ops.isNull(&vs[1]) { "" } else { lexdb_sql.text(&vs[1]) }
        if k == "timezone" { v = (try lexdb_time.settingZone(&v)).name }    // as SHOW will give it (9.95)
        if strings.contains(&v, "\n") || strings.contains(&v, "\t") { return Err(e("0A000", "lexdb: a setting's value may not hold a newline or a tab")) }
        if k == "max_recursion" || k == "max_match_steps" || k == "statement_timeout" || k == "max_statement_mem" { let ok = try settingValue(&k, &Val.Text(v.clone())) }
        let local = lexdb_ops.truth(&vs[2]) == Some(true)
        let pend = se.st.memo.get(&setCfgKey(se.sess)).unwrapOr("")
        se.st.memo.put(&setCfgKey(se.sess), &(pend + k + "\t" + v + "\t" + (if local { "1" } else { "0" }) + "\n"))
        // seen by current_setting later in the statement
        var out = ""
        for l in strings.split(&lines, "\n") {
            if len(l) == 0 || strings.startsWith(&l, &(k + "\t")) { continue }
            out += &l.toStr()
            out.addByte('\n')
        }
        out += &(k + "\t" + v + "\n")
        se.st.memo.put(&settingsKey(se.sess), &out)
        return Ok(Val.Text(v))
    }
    return Err(e("42883", &("function " + name + " with " + n.toStr() + " arguments does not exist")))
}

// The functions that read the bound catalog: None if name is none of them.
fn callCat(name: &str, vs: &[]Val, se: &SeqEnv): Result[Option[Val], DbErr] {
    let n = len(vs)
    if name == "#object_id" {
        // T-SQL's OBJECT_ID(name): a relation's id, NULL if there is none
        // ([brackets], dbo., a database's name and #temporary names read)
        if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
        let full = strings.replaceAll(&(strings.replaceAll(&(lexdb_sql.text(&vs[0])), "[", "")), "]", "")
        let parts = strings.split(&full, ".")
        let nm = parts[len(parts) - 1].toStr()
        let sc = if len(parts) >= 2 { strings.toLowerAscii(&parts[len(parts) - 2]) } else { "" }
        var look = "\"" + strings.replaceAll(&(strings.toLowerAscii(&nm)), "\"", "\"\"") + "\""
        if isTempName(&strings.toLowerAscii(&nm)) { look = "\"" + tempSchema(se.sess) + "\"." + look }
        else if sc != "" && sc != "dbo" { look = "\"" + sc + "\"." + look }
        let o = relOidOf(se, &look)
        var found = if o == 0 { Val.Null } else { Val.Int(o) }
        if o == 0 && !isTempName(&strings.toLowerAscii(&nm)) {
            // a sys view's, a constraint's, a default's (design/lexdb-tds.md, section 13)
            match try sysCall(name, vs, se) {
                Some(v) { found = v }
                None {}
            }
        }
        // OBJECT_ID(name, type): only an object of that type (U, V, P, PK, ...)
        if n >= 2 && !lexdb_ops.isNull(&vs[1]) {
            match found {
                Val.Int(id) {
                    let l = sysObjLine(se, id)
                    let have = if len(l) > 0 { strings.trim(&l[3]) } else { "V" }
                    if have != strings.trim(&strings.toUpperAscii(&lexdb_sql.text(&vs[1]))) { found = Val.Null }
                }
                else {}
            }
        }
        return Ok(Some(found))
    }
    if strings.startsWith(&name, "#") {
        match try sysCall(name, vs, se) {
            Some(v) { return Ok(Some(v)) }
            None {}
        }
    }
    if name == "current_user" { return Ok(Some(Val.Text(catUser(se)))) }
    // PostgreSQL's SYSTEM_USER: "method:identity" of an authenticated login, NULL of a trusted one
    if name == "system_user" {
        match se.st.memo.get(&sysUserKey(se.sess)) {
            Some(u) { return Ok(Some(Val.Text(u))) }
            None { return Ok(Some(Val.Null)) }
        }
    }
    if name == "session_user" {
        for l in catLines(se, &"U") { return Ok(Some(Val.Text(l[0].clone()))) }
        return Ok(Some(Val.Text(catUser(se))))
    }
    if name == "current_schema" && n == 0 {
        for l in catLines(se, &"p") { return Ok(Some(Val.Text(l[0].clone()))) }
        return Ok(Some(Val.Text("public")))
    }
    if name == "pg_get_userbyid" && n == 1 {
        if lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
        let o = lexdb_ops.oidArg(&vs[0]).unwrapOr(0).toStr()
        for l in catLines(se, &"R") { if l[0] == o { return Ok(Some(Val.Text(l[1].clone()))) } }
        for l in catLines(se, &"U") { return Ok(Some(Val.Text(l[0].clone()))) }
        return Ok(Some(Val.Text(catUser(se))))
    }
    if name == "has_database_privilege" { return Ok(Some(Val.Bool(true))) }
    if name == "has_table_privilege" || name == "has_schema_privilege" || name == "has_sequence_privilege" || name == "has_any_column_privilege" {
        for v in vs { if lexdb_ops.isNull(&v) { return Ok(Some(Val.Null)) } }
        return Ok(Some(try hasPrivFn(se, name, vs)))
    }
    if name == "pg_relation_is_publishable" { return Ok(Some(Val.Bool(false))) }
    if name == "format_type" && n == 2 {
        // an enum type's name (9.90); the built-in types' as before
        if lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
        let fo = lexdb_ops.oidArg(&vs[0]).unwrapOr(0)
        for l in catLines(se, &"e") { if l[0] == fo.toStr() { return Ok(Some(Val.Text(l[1].clone()))) } }
        let m = if lexdb_ops.isNull(&vs[1]) { -1 } else { lexdb_ops.oidArg(&vs[1]).unwrapOr(-1) }
        return Ok(Some(Val.Text(lexdb_pgcat.formatType(fo, m))))
    }
    if (name == "pg_relation_size" || name == "pg_total_relation_size" || name == "pg_table_size" || name == "pg_indexes_size") && n >= 1 {
        if lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
        if name == "pg_relation_size" && n == 2 && lexdb_sql.text(&vs[1]) != "main" { return Ok(Some(Val.Int(0))) }
        // a name as text is read as a regclass, as PostgreSQL types the argument
        var oid = lexdb_ops.oidArg(&vs[0]).unwrapOr(0)
        match vs[0] {
            Val.Text(t) {
                oid = relOidOf(se, &t)
                if oid == 0 { return Err(e("42P01", &("relation \"" + t + "\" does not exist"))) }
            }
            else {}
        }
        return Ok(Some(try relSize(se, name, oid)))
    }
    if name == "pg_database_size" && n == 1 {
        if lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
        let db = "lexdb"
        let named = match vs[0] {
            Val.Text(t) { t == db }
            else { lexdb_ops.oidArg(&vs[0]) == Some(16384) }
        }
        if !named { return Err(e("3D000", &("database \"" + lexdb_sql.text(&vs[0]) + "\" does not exist"))) }
        // every tree's pages, as the size functions count them (the data
        // file may hold freed pages, and rows still only in the log)
        var pages = 0
        for tr in se.st.trees() { if tr < lexdb_store.OVF { pages += try se.st.treePages(tr) } }
        return Ok(Some(Val.Int(pages * lexdb_rows.PAGE)))
    }
    if n >= 1 && lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
    if name == "pg_table_is_visible" && n == 1 {
        match relShown(se, lexdb_ops.oidArg(&vs[0]).unwrapOr(0)) {
            Some(s) { return Ok(Some(Val.Bool(strings.indexOf(&s, ".", 0) < 0 || strings.startsWith(&s, "\"")))) }
            None { return Ok(Some(Val.Null)) }
        }
    }
    if name == "pg_get_constraintdef" && (n == 1 || n == 2) {
        let k = lexdb_ops.oidArg(&vs[0]).unwrapOr(0).toStr()
        let pretty = n == 2 && lexdb_ops.truth(&vs[1]) == Some(true)
        for l in catLines(se, &"c") {
            if l[0] != k { continue }
            // pretty: CHECK (x), not CHECK ((x)) (and NOT VALID after it, 9.117)
            let nv = strings.endsWith(&l[1], " NOT VALID")
            let d: &str = if nv { &l[1][0..len(l[1]) - 10] } else { &l[1] }
            if pretty && strings.startsWith(&d, "CHECK (") && strings.endsWith(&d, ")") {
                return Ok(Some(Val.Text("CHECK (" + lexdb_sql.unwrapParens(&d[7..len(d) - 1]) + ")" + (if nv { " NOT VALID" } else { "" }))))
            }
            return Ok(Some(Val.Text(l[1].clone())))
        }
        return Ok(Some(Val.Null))
    }
    if name == "pg_get_indexdef" && (n == 1 || n == 3) {
        let k = lexdb_ops.oidArg(&vs[0]).unwrapOr(0).toStr()
        let col = if n == 3 { lexdb_ops.oidArg(&vs[1]).unwrapOr(0) } else { 0 }
        let pretty = n == 3 && lexdb_ops.truth(&vs[2]) == Some(true)
        for l in catLines(se, &"x") {
            if l[0] != k { continue }
            if col == 0 { return Ok(Some(Val.Text(if pretty && len(l) > 3 { l[3].clone() } else { l[1].clone() }))) }
            let cs = strings.split(&l[2], "\x1e")
            if col <= len(cs) { return Ok(Some(Val.Text(lexdb_pg.quoteIfNeeded(&cs[col - 1])))) }
            return Ok(Some(Val.Text("")))
        }
        return Ok(Some(Val.Null))
    }
    if name == "pg_get_serial_sequence" && n == 2 {
        let rel = relOidOf(se, &lexdb_sql.text(&vs[0]))
        if rel == 0 { return Err(e("42P01", &("relation \"" + lexdb_sql.text(&vs[0]) + "\" does not exist"))) }
        let col = lexdb_sql.text(&vs[1])
        for l in catLines(se, &"s") { if l[0] == rel.toStr() && l[1] == col { return Ok(Some(Val.Text(l[2].clone()))) } }
        return Ok(Some(Val.Null))
    }
    if (name == "to_regclass" || name == "to_regtype" || name == "to_regnamespace") && n == 1 {
        let o = if name == "to_regclass" { lexdb_sql.OID_REGCLASS } else if name == "to_regtype" { lexdb_sql.OID_REGTYPE } else { lexdb_sql.OID_REGNAMESPACE }
        match regCast(&Val.Text(lexdb_sql.text(&vs[0])), o, &Some(se.share())) {
            Ok(v) { return Ok(Some(v)) }
            Err(_) { return Ok(Some(Val.Null)) }
        }
    }
    if name == "pg_get_viewdef" && (n == 1 || n == 2) {
        // by OID, or by name; the text as it was written, with PostgreSQL's ;
        var o = lexdb_ops.oidArg(&vs[0]).unwrapOr(0)
        if o == 0 { o = relOidOf(se, &lexdb_sql.text(&vs[0])) }
        for l in catLines(se, &"w") { if l[0] == o.toStr() { return Ok(Some(Val.Text(l[1] + ";"))) } }
        return Ok(Some(Val.Null))
    }
    if name == "pg_partition_ancestors" && n == 1 {
        let o = lexdb_ops.oidArg(&vs[0]).unwrapOr(0)
        return Ok(Some(lexdb_lib.srfMark(&[Val.Int(o)])))
    }
    return Ok(None)
}

// ---- the catalog relations' rows

// The rows of catalog relation rel.
// pg_class.relpersistence: t for a temporary relation (9.96), else p.
fn catRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, rel: &str): Result[[][]Val, DbErr] {
    let snap = try catSnap(st, txn)
    let roles = try rolesIn(st, txn)
    var mems: []str = []
    if rel == "pg_auth_members" {
        try st.scan(txn, lexdb_catalog.CATALOG, MEM_PRE, &(MEM_PRE + "\xff"), fn(en: &lexdb_store.Entry): bool {
            append(mut &mems, en.key[len(MEM_PRE)..len(en.key)].toStr())
            return true
        })
    }
    var used: Map[str, int] = newMap()
    var cur: Map[str, int] = newMap()
    if rel == "pg_sequences" || rel == "sys.sequences" || rel == "sys.identity_columns" {
        for d in snap.seqs {
            let sv = try seqState(st, &d)
            match sv[0] {
                Val.Int(n) { cur.put(d.key.clone(), n) }
                else {}
            }
            match sv[2] {
                Val.Bool(called) {
                    if called {
                        match sv[0] {
                            Val.Int(n) { used.put(d.key.clone(), n) }
                            else {}
                        }
                    }
                }
                else {}
            }
        }
    }
    var who: []str = []
    var whoSuper = false
    if rel == "information_schema.table_privileges" || rel == "information_schema.role_table_grants" || rel == "sys.database_permissions" || strings.endsWith(rel, "_TAB_PRIVS") {
        let w = try whoNow(st, txn)
        who = w.roles.clone()
        whoSuper = w.super
    }
    var dbopts = ""
    if rel == "sys.databases" { dbopts = (try st.get(txn, lexdb_catalog.CATALOG, &lexdb_dbopt.KEY)).unwrapOr("") }
    var cq = CatView{snap: snap, roles: roles, sess: txn.sql.sess, mems: mems, used: used, cur: cur, who: who, whoSuper: whoSuper, dbopts: dbopts}
    if strings.startsWith(rel, "sys.") { return lexdb_syscat.viewRows(&cq, &rel[4..len(rel)]) }
    if strings.startsWith(rel, "ora.") { return lexdb_oracat.viewRows(&cq, &rel[4..len(rel)]) }
    var stats: Map[int, TabStat] = newMap()
    if rel == "pg_stat_user_tables" {
        for ct in cq.snap.tabs {
            stats.put(ct.t.tree, try lexdb_stats.tabStat(st, txn, &ct.t))
        }
    }
    return lexdb_pg.viewRows(&cq, &stats, rel)
}

// A column as SQL Server describes it (lexdb_tds: SET FMTONLY ON, sp_prepare's
// metadata, sp_describe_first_result_set, sp_tablecollations_100 and INSERT
// BULK; design/lexdb-tds.md section 14): its label, SQL Server's type for it
// (sqlTypeOf: name, system_type_id, max_length (-1 for max), precision, scale,
// collation name, "" none), whether it takes NULL, whether it is an identity,
// whether it has a default, and its lexdb type.
pub type DeclCol = record {
    pub name: str
    pub typ: str
    pub sys: int
    pub maxLen: int
    pub prec: int
    pub scale: int
    pub coll: str
    pub nullable: bool
    pub identity: bool
    pub hasDefault: bool
    pub oid: int
}

fn declOf(name: &str, t: &lexdb_sql.TypeName, coll: &str, nullable: bool, identity: bool, hasDefault: bool): DeclCol {
    let q = lexdb_syscat.sqlTypeOf(t, coll)
    return DeclCol{name: name.toStr(), typ: q.name.clone(), sys: q.sys, maxLen: q.maxLen, prec: q.prec, scale: q.scale, coll: q.coll.clone(),
                   nullable: nullable, identity: identity, hasDefault: hasDefault, oid: t.oid}
}

// A table's columns (the hidden key not), as SQL Server describes them; a
// primary key's are not NULL.
fn tableDecls(t: &Table): []DeclCol {
    var out: []DeclCol = []
    for i in 0..len(t.cols) {
        let c = &t.cols[i]
        if c.name == lexdb_catalog.ROWID { continue }
        var inPk = false
        for k in t.pk { if k == i { inPk = true } }
        append(mut &out, declOf(if len(c.spell) > 0 { &c.spell } else { &c.name }, &c.typ, &c.coll, !c.notNull && !inPk,
                                c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT, c.def.isSome() || len(c.seq) > 0))
    }
    return out
}

// A table by its name, read in the session's transaction block (a table it
// made is there), else in a transaction of its own.
fn (s: mut &Session) tableNamed(name: &str): Result[Table, DbErr] {
    if len(s.txn) > 0 {
        let st = &s.st
        return needTable(st, mut &s.txn[0], name)
    }
    var t = lexdb_store.begin()
    s.setUp(mut &t)
    let r = needTable(&s.st, mut &t, name)
    s.st.abort(t)
    return r
}

// A table's columns as SQL Server describes them (INSERT BULK,
// sp_tablecollations_100); 42P01 when there is none of the name.
pub fn (s: mut &Session) tableDecl(name: &str): Result[[]DeclCol, DbErr] {
    let t = try s.tableNamed(name)
    return Ok(tableDecls(&t))
}

// The columns stmt returns as SQL Server describes them: describe's, each
// as its lexdb type (and SQL Server's, where it carries one) says; but a
// query of one table gives a column of that table, by name and type, the
// table's declaration (varchar(100), decimal(12,2), NOT NULL, IDENTITY), as
// SQL Server describes a query's columns from where they come.
pub fn (s: mut &Session) describeDecl(stmt: &lexdb_sql.Stmt): Result[[]DeclCol, DbErr] {
    let none: []int = []
    let outs = try s.describe(stmt, &none)
    var tab: []DeclCol = []
    var tabNames: []str = []
    var tabOids: []int = []
    if stmt.kind == lexdb_sql.S_SELECT && len(stmt.from) == 1 && stmt.from[0].sub < 0 && len(stmt.srf) == 0 && stmt.setop == 0 {
        match s.tableNamed(&stmt.from[0].table) {
            Ok(t) {
                tab = tableDecls(&t)
                for c in t.cols {
                    if c.name != lexdb_catalog.ROWID {
                        append(mut &tabNames, c.name.clone())
                        append(mut &tabOids, c.typ.oid)
                    }
                }
            }
            Err(_) {}
        }
    }
    var out: []DeclCol = []
    for o in outs {
        var found = -1
        for k in 0..len(tabNames) {
            if tabNames[k] == o.name && tabOids[k] == o.oid { found = k }
        }
        if found >= 0 {
            let d = &tab[found]
            append(mut &out, DeclCol{name: o.label(), typ: d.typ.clone(), sys: d.sys, maxLen: d.maxLen, prec: d.prec, scale: d.scale, coll: d.coll.clone(),
                                     nullable: d.nullable, identity: d.identity, hasDefault: d.hasDefault, oid: d.oid})
        } else {
            append(mut &out, declOf(&o.label(), &outType(&o), &o.coll, true, false, false))
        }
    }
    return Ok(out)
}

fn sysInt(v: &Val): Option[int] {
    match v {
        Val.Int(n) { return Some(n) }
        Val.Num(d) {
            match d.toInt(Rounding.TOWARD_ZERO) {
                Ok(n) { return Some(n) }
                Err(_) { return None }
            }
        }
        Val.Text(t) { return strings.parseIntOpt(&(strings.trim(&t))) }
        else { return None }
    }
}

// An object's line (O): id, schema_id, name, type, parent; [] if none.
fn sysObjLine(se: &SeqEnv, id: int): []str {
    let k = id.toStr()
    for l in catLines(se, &"O") { if l[0] == k { return collections.copyOf(&l) } }
    return []
}

// A name as SQL Server reads it: [brackets] and "quotes" off, parts split.
fn sysNameParts(s: &str): []str {
    var out: []str = []
    var cur = ""
    var i = 0
    var q: byte = 0
    while i < len(s) {
        let c = s[i]
        if q != 0 {
            if c == q {
                if i + 1 < len(s) && s[i + 1] == q {
                    cur.addByte(c)
                    i += 2
                    continue
                }
                q = 0
            } else { cur.addByte(c) }
        } else if c == '[' {
            q = ']'
        } else if c == '"' {
            q = '"'
        } else if c == '.' {
            append(mut &out, cur)
            cur = ""
        } else {
            cur.addByte(c)
        }
        i += 1
    }
    append(mut &out, cur)
    return out
}

fn sysSchemaIdOf(se: &SeqEnv, n: &str): int {
    let l = strings.toLowerAscii(&n)
    if l == "dbo" || l == "public" { return 1 }
    let fixed = lexdb_syscat.schemaIdOf(n)
    if fixed > 0 { return fixed }
    for x in catLines(se, &"n") { if x[1] == l { return lexdb_pg.nspOid(&x[1]) } }
    return 0
}

fn sysSchemaNameOf(se: &SeqEnv, id: int): str {
    if id == 1 { return "dbo" }
    let fixed = lexdb_syscat.schemaName(id)
    if len(fixed) > 0 { return fixed }
    for x in catLines(se, &"n") { if x[1] != "public" && lexdb_pg.nspOid(&x[1]) == id { return x[1].clone() } }
    return ""
}

// Whether the session's role is a superuser.
fn sysSuper(se: &SeqEnv): bool {
    let u = catUser(se)
    for l in catLines(se, &"R") { if l[1] == u { return l[2] == "1" } }
    return false
}

// SQL Server's catalog functions: OBJECT_NAME, OBJECTPROPERTY,
// COLUMNPROPERTY, SCHEMA_NAME, ... (lexdb_parse.tsqlCatCall).
fn sysCall(name: &str, vs: &[]Val, se: &SeqEnv): Result[Option[Val], DbErr] {
    let n = len(vs)
    let none: Option[Val] = None
    match name.toStr() {
        "#db_id" {
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let id = lexdb_syscat.dbId(&lexdb_sql.text(&vs[0]), &lexdb_syscat.SYS_DB_NAME)
            return Ok(Some(if id == 0 { Val.Null } else { Val.Int(id) }))
        }
        "#db_name" {
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let nm = lexdb_syscat.dbName(sysInt(&vs[0]).unwrapOr(0), &lexdb_syscat.SYS_DB_NAME)
            return Ok(Some(if len(nm) == 0 { Val.Null } else { Val.Text(nm) }))
        }
        "#has_dbaccess" {
            // lexdb's own database; SQL Server's system ones are listed, not opened
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let id = lexdb_syscat.dbId(&lexdb_sql.text(&vs[0]), &lexdb_syscat.SYS_DB_NAME)
            return Ok(Some(if id == 0 { Val.Null } else { Val.Int(if id == lexdb_syscat.SYS_DB_ID { 1 } else { 0 }) }))
        }
        "#serverproperty", "#fulltextserviceproperty" {
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let pr = lexdb_syscat.prop(if name == "#serverproperty" { "server" } else { "fulltext" }, &lexdb_sql.text(&vs[0]))
            if !pr.found || pr.val == "\x00" { return Ok(Some(Val.Null)) }
            if pr.typ == "int" || pr.typ == "tinyint" || pr.typ == "smallint" || pr.typ == "bigint" { return Ok(Some(Val.Int(strings.parseIntOpt(&pr.val).unwrapOr(0)))) }
            return Ok(Some(Val.Text(pr.val.clone())))
        }
        "#schema_name" {
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let nm = sysSchemaNameOf(se, sysInt(&vs[0]).unwrapOr(0))
            return Ok(Some(if len(nm) == 0 { Val.Null } else { Val.Text(nm) }))
        }
        "#schema_id" {
            if n < 1 { return Ok(Some(Val.Int(1))) }
            if lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let id = sysSchemaIdOf(se, &lexdb_sql.text(&vs[0]))
            return Ok(Some(if id == 0 { Val.Null } else { Val.Int(id) }))
        }
        "#type_name" {
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let tid = sysInt(&vs[0]).unwrapOr(0)
            let t = lexdb_syscat.typeName(tid)
            if len(t) == 0 {
                for l in catLines(se, &"Y") { if l[0] == tid.toStr() { return Ok(Some(Val.Text(l[2].clone()))) } }
            }
            return Ok(Some(if len(t) == 0 { Val.Null } else { Val.Text(t) }))
        }
        "#type_id" {
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let ps = sysNameParts(&lexdb_sql.text(&vs[0]))
            let id = lexdb_syscat.typeIdOf(&ps[len(ps) - 1])
            if id == 0 {
                // a table type: by its name, in its schema (dbo when none is given)
                let want = strings.toLowerAscii(&ps[len(ps) - 1])
                let sid = if len(ps) >= 2 { sysSchemaIdOf(se, &ps[len(ps) - 2]) } else { 1 }
                for l in catLines(se, &"Y") {
                    if strings.toLowerAscii(&l[2]) == want && l[1] == sid.toStr() { return Ok(Some(Val.Int(strings.parseIntOpt(&l[0]).unwrapOr(0)))) }
                }
            }
            return Ok(Some(if id == 0 { Val.Null } else { Val.Int(id) }))
        }
        "#object_name", "#object_schema_name" {
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            if n >= 2 && !lexdb_ops.isNull(&vs[1]) && sysInt(&vs[1]).unwrapOr(0) != lexdb_syscat.SYS_DB_ID { return Ok(Some(Val.Null)) }
            let id = sysInt(&vs[0]).unwrapOr(0)
            let v = lexdb_syscat.viewOf(id)
            if len(v) > 0 { return Ok(Some(Val.Text(if name == "#object_name" { v } else { "sys" }))) }
            let l = sysObjLine(se, id)
            if len(l) == 0 { return Ok(Some(Val.Null)) }
            if name == "#object_name" { return Ok(Some(Val.Text(l[2].clone()))) }
            return Ok(Some(Val.Text(sysSchemaNameOf(se, strings.parseIntOpt(&l[1]).unwrapOr(0)))))
        }
        "#object_definition" {
            // a view's text as created (the bound catalog's D lines: lexdb_syscat.bind); NULL for the rest
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let id = sysInt(&vs[0]).unwrapOr(0)
            for l in catLines(se, &"D") {
                if l[0] == id.toStr() && len(l) > 1 { return Ok(Some(Val.Text(lexdb_syscat.unescDef(&l[1])))) }
            }
            return Ok(Some(Val.Null))
        }
        "#object_id" {
            // a sys view's, a constraint's or a default's (a relation's is callCat's)
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let ps = sysNameParts(&lexdb_sql.text(&vs[0]))
            let nm = strings.toLowerAscii(&ps[len(ps) - 1])
            let sc = if len(ps) >= 2 { strings.toLowerAscii(&ps[len(ps) - 2]) } else { "" }
            if sc == "sys" {
                let id = lexdb_syscat.viewId(&nm)
                return Ok(Some(if id == 0 { Val.Null } else { Val.Int(id) }))
            }
            let sid = if sc == "" { 1 } else { sysSchemaIdOf(se, &sc) }
            for l in catLines(se, &"O") {
                if strings.toLowerAscii(&l[2]) == nm && l[1] == sid.toStr() && l[3] != "U" && l[3] != "V" {
                    return Ok(Some(Val.Int(strings.parseIntOpt(&l[0]).unwrapOr(0))))
                }
            }
            return Ok(none)
        }
        "#objectproperty", "#objectpropertyex" {
            if n < 2 || lexdb_ops.isNull(&vs[0]) || lexdb_ops.isNull(&vs[1]) { return Ok(Some(Val.Null)) }
            let id = sysInt(&vs[0]).unwrapOr(0)
            let p = strings.toLowerAscii(&lexdb_sql.text(&vs[1]))
            var typ = ""
            var shipped = false
            if len(lexdb_syscat.viewOf(id)) > 0 {
                typ = "V"
                shipped = true
            } else {
                let l = sysObjLine(se, id)
                if len(l) == 0 { return Ok(Some(Val.Null)) }
                typ = l[3].clone()
            }
            let isMod = typ == "V"
            let flag = fn(b: bool): Option[Val] { return Some(Val.Int(if b { 1 } else { 0 })) }
            match p.toStr() {
                "basetype" { return Ok(Some(Val.Text(typ))) }
                "ismsshipped", "issystemtable" { return Ok(flag(shipped && p == "ismsshipped")) }
                "istable", "isusertable" { return Ok(flag(typ == "U")) }
                "isview" { return Ok(flag(typ == "V")) }
                "isprimarykey" { return Ok(flag(typ == "PK")) }
                "isforeignkey" { return Ok(flag(typ == "F")) }
                "ischeckcnst" { return Ok(flag(typ == "C")) }
                "isdefaultcnst" { return Ok(flag(typ == "D")) }
                "isuniquecnst" { return Ok(flag(typ == "UQ")) }
                "isconstraint" { return Ok(flag(typ == "PK" || typ == "UQ" || typ == "F" || typ == "C" || typ == "D")) }
                "isprocedure" { return Ok(flag(typ == "P")) }
                "isscalarfunction", "istablefunction", "isinlinefunction", "istrigger", "isextendedproc",
                "isencrypted", "isschemabound", "isreplproc", "isqueue", "isrule", "isdefault" { return Ok(flag(false)) }
                "ownerid", "schemaid" {
                    if p == "ownerid" { return Ok(Some(Val.Int(1))) }
                    let l = sysObjLine(se, id)
                    return Ok(Some(if len(l) > 0 { Val.Int(strings.parseIntOpt(&l[1]).unwrapOr(1)) } else { Val.Int(4) }))
                }
                "execisansinullson", "execisquotedidenton", "isansinullson", "isquotedidenton" { return Ok(if isMod || typ == "U" { flag(true) } else { Some(Val.Null) }) }
                "tablehasprimarykey", "tablehasindex", "tablehasclustindex" {
                    if typ != "U" { return Ok(Some(Val.Null)) }
                    var has = false
                    for l in catLines(se, &"I") { if l[0] == id.toStr() && (p == "tablehasindex" || l[3] == "1") { has = true } }
                    return Ok(flag(has))
                }
                else { return Ok(Some(Val.Null)) }
            }
        }
        "#columnproperty" {
            if n < 3 || lexdb_ops.isNull(&vs[0]) || lexdb_ops.isNull(&vs[1]) || lexdb_ops.isNull(&vs[2]) { return Ok(Some(Val.Null)) }
            let id = sysInt(&vs[0]).unwrapOr(0).toStr()
            let cn = strings.toLowerAscii(&lexdb_sql.text(&vs[1]))
            let p = strings.toLowerAscii(&lexdb_sql.text(&vs[2]))
            var col: []str = []
            for l in catLines(se, &"K") { if l[0] == id && strings.toLowerAscii(&l[1]) == cn { col = collections.copyOf(&l) } }
            if len(col) == 0 { return Ok(Some(Val.Null)) }
            match p.toStr() {
                "columnid" { return Ok(Some(Val.Int(strings.parseIntOpt(&col[2]).unwrapOr(0)))) }
                "allowsnull" { return Ok(Some(Val.Int(if col[3] == "1" { 1 } else { 0 }))) }
                "isidentity" { return Ok(Some(Val.Int(if col[4] == "1" { 1 } else { 0 }))) }
                "iscomputed", "isfulltextindexed", "statisticalsemantics", "isrowguidcol", "issparse", "iscolumnset", "ishidden",
                "isidnotforrepl", "isxmlindexable", "isdeterministic_" { return Ok(Some(Val.Int(0))) }
                else { return Ok(Some(Val.Null)) }      // IsDeterministic, IsPrecise: a computed column's
            }
        }
        "#indexproperty" {
            if n < 3 || lexdb_ops.isNull(&vs[0]) || lexdb_ops.isNull(&vs[1]) || lexdb_ops.isNull(&vs[2]) { return Ok(Some(Val.Null)) }
            let id = sysInt(&vs[0]).unwrapOr(0).toStr()
            let xn = strings.toLowerAscii(&lexdb_sql.text(&vs[1]))
            let p = strings.toLowerAscii(&lexdb_sql.text(&vs[2]))
            var ix: []str = []
            for l in catLines(se, &"I") { if l[0] == id && strings.toLowerAscii(&l[1]) == xn { ix = collections.copyOf(&l) } }
            if len(ix) == 0 { return Ok(Some(Val.Null)) }
            match p.toStr() {
                "indexid" { return Ok(Some(Val.Int(strings.parseIntOpt(&ix[2]).unwrapOr(0)))) }
                "isclustered" { return Ok(Some(Val.Int(if ix[3] == "1" { 1 } else { 0 }))) }
                "isunique" { return Ok(Some(Val.Int(if ix[4] == "1" { 1 } else { 0 }))) }
                "indexfillfactor", "ispadindex", "isfulltextkey", "isoptimizedforsequentialkey", "isdisabled", "ishypothetical",
                "isstatistics", "isautostatistics", "isrowlockdisallowed", "ispagelockdisallowed", "isfulltextindexed",
                "iscolumnstore" { return Ok(Some(Val.Int(0))) }
                else { return Ok(Some(Val.Null)) }
            }
        }
        "#suser_sname" {
            if n < 1 { return Ok(Some(Val.Text(catUser(se)))) }
            if lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let sid: &str = match vs[0] {
                Val.Bytes(b) { b }
                else { "" }
            }
            var owner = ""
            for l in catLines(se, &"R") {
                if lexdb_catalog.sysSid(&l[1]) == sid { return Ok(Some(Val.Text(l[1].clone()))) }
                if l[2] == "1" && (len(owner) == 0 || l[1] < owner) { owner = l[1].clone() }
            }
            // 0x01: the database's owner (dbo's login): lexdb's first superuser
            // (none made: the session's user)
            if sid == "\x01" { return Ok(Some(Val.Text(if len(owner) > 0 { owner } else { catUser(se) }))) }
            return Ok(Some(Val.Null))
        }
        "#suser_sid" {
            let who = if n < 1 || lexdb_ops.isNull(&vs[0]) { catUser(se) } else { lexdb_sql.text(&vs[0]) }
            for l in catLines(se, &"R") { if l[1] == who { return Ok(Some(Val.Bytes(lexdb_catalog.sysSid(&who)))) } }
            return Ok(Some(Val.Null))
        }
        "#sid_binary" { return Ok(Some(Val.Null)) }
        "#is_srvrolemember", "#is_member" {
            if n < 1 || lexdb_ops.isNull(&vs[0]) { return Ok(Some(Val.Null)) }
            let r = strings.toLowerAscii(&lexdb_sql.text(&vs[0]))
            if r == "public" { return Ok(Some(Val.Int(1))) }
            if name == "#is_srvrolemember" {
                var fixed = false
                for x in lexdb_syscat.rows(&"server_principals", &"full") { if strings.toLowerAscii(&x[0]) == r { fixed = true } }
                if !fixed { return Ok(Some(Val.Null)) }
            } else if !strings.startsWith(&r, "db_") {
                return Ok(Some(Val.Int(0)))
            }
            return Ok(Some(Val.Int(if sysSuper(se) && r != "db_denydatareader" && r != "db_denydatawriter" { 1 } else { 0 })))
        }
        "#has_perms_by_name" {
            // HAS_PERMS_BY_NAME('schema.table', 'OBJECT', 'SELECT'): the session's privilege on a table or view (NULL where
            // it is none, as SQL Server's for a name it cannot find); the other classes and permissions are not modelled
            if n >= 3 && !lexdb_ops.isNull(&vs[0]) && strings.toLowerAscii(&lexdb_sql.text(&vs[1])) == "object" {
                let perm = strings.toLowerAscii(&lexdb_sql.text(&vs[2]))
                if perm == "select" || perm == "insert" || perm == "update" || perm == "delete" || perm == "references" {
                    var nm = strings.replaceAll(&(strings.replaceAll(&lexdb_sql.text(&vs[0]), "[", "")), "]", "")
                    if strings.startsWith(&strings.toLowerAscii(&nm), "dbo.") { nm = "public." + nm[4..len(nm)] }
                    match hasPrivFn(se, "has_table_privilege", &[Val.Text(nm), Val.Text(perm)]) {
                        Ok(v) {
                            match v {
                                Val.Bool(b) { return Ok(Some(Val.Int(if b { 1 } else { 0 }))) }
                                else { return Ok(Some(Val.Null)) }
                            }
                        }
                        Err(_) { return Ok(Some(Val.Null)) }
                    }
                }
            }
            return Ok(Some(Val.Int(1)))
        }
        else { return Ok(none) }
    }
}

// ---- roles (9.81)
//
// A role is a catalog row of its own, roleKey(name): whether it may log in,
// whether it is a superuser, and its password's SCRAM verifier ("" none).
// Roles matter to SCRAM authentication (lexdb_wire); a session that came in
// by trust is not checked against them.

fn roleKey(n: &str): str { return "\x05" + n }

fn encRole(r: &Role): str { return (if r.login { "1" } else { "0" }) + "\t" + (if r.superuser { "1" } else { "0" }) + "\t" + r.verifier + "\t" + r.oraVerifier }

fn decRole(name: &str, v: &str): Role {
    let f = strings.split(&v, "\t")
    return Role{name: name.toStr(), login: len(f) > 0 && f[0] == "1", superuser: len(f) > 1 && f[1] == "1",
                verifier: if len(f) > 2 { f[2].toStr() } else { "" },
                oraVerifier: if len(f) > 3 { f[3].toStr() } else { "" }}
}

fn rolesIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]Role, DbErr] {
    var out: []Role = []
    try st.scan(txn, lexdb_catalog.CATALOG, "\x05", "\x06", fn(en: &lexdb_store.Entry): bool {
        append(mut &out, decRole(&en.key[1..len(en.key)], &en.val))
        return true
    })
    return Ok(out)
}

// The roles as committed (the wire's authentication reads them).
pub fn roles(st: &lexdb_store.Store): Result[[]Role, DbErr] {
    var t = try st.beginSnapshot()
    let r = rolesIn(st, mut &t)
    st.abort(t)
    return r
}

// A role's options applied: LOGIN, SUPERUSER, PASSWORD and their NOs.
fn applyRoleOpts(r: mut &Role, opts: &[]str): Result[Unit, DbErr] {
    for o in opts {
        if o == "login" { r.login = true }
        else if o == "nologin" { r.login = false }
        else if o == "superuser" { r.superuser = true }
        else if o == "nosuperuser" { r.superuser = false }
        else if o == "password-null" {
            r.verifier = ""
            r.oraVerifier = ""
        }
        else if strings.startsWith(&o, "password:") {
            let pw = o[9..len(o)]
            if lexdb_auth.parseVerifier(&pw).isSome() {
                r.verifier = pw.toStr()                 // a verifier given (pg_dump writes them): kept
                r.oraVerifier = ""                      // (the Oracle one was of the password before)
            } else if lexdb_auth.parseOraVerifier(&pw).isSome() {
                r.oraVerifier = pw.toStr()              // Oracle's 12c verifier given: kept; the SCRAM one is of the old password: gone
                r.verifier = ""
            } else if len(pw) == 35 && strings.startsWith(&pw, "md5") {
                return Err(e("0A000", "lexdb: MD5 passwords are not supported; give the password, or a SCRAM-SHA-256 verifier"))
            } else if len(pw) == 0 {
                r.verifier = ""                         // as PostgreSQL: an empty password is none
                r.oraVerifier = ""
            } else {
                r.verifier = try lexdb_auth.makeVerifier(&pw)
                r.oraVerifier = try lexdb_auth.makeOraVerifier(&pw)
            }
        }
    }
    return Ok(Unit{})
}

// CREATE ROLE, ALTER ROLE, DROP ROLE. Who may: a superuser role, or a
// session that is no role (trust); a role may change its own password.
fn roleStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let me = currentRole(st, txn.sql.sess)
    let all = try rolesIn(st, txn)
    var mine = false
    var su = true
    for r in all {
        if r.name == me {
            mine = true
            su = r.superuser
        }
    }
    let ownPassword = s.kind == lexdb_sql.S_ALTER_ROLE && s.table == me && mine && len(s.names) > 0 &&
                      (strings.startsWith(&s.names[0], "password") && len(s.names) == 1)
    if !su && !ownPassword { return Err(e("42501", &("permission denied to " + (if s.kind == lexdb_sql.S_CREATE_ROLE { "create" } else if s.kind == lexdb_sql.S_DROP_ROLE { "drop" } else { "alter" }) + " role"))) }
    try bumpCatalog(st, txn)
    if s.kind == lexdb_sql.S_DROP_ROLE {
        for c in s.cols {
            let had = (try st.get(txn, lexdb_catalog.CATALOG, &(roleKey(&c.name)))).isSome()
            if !had {
                if s.ifFlag {
                    notice(st, txn, &"00000", &("role \"" + c.name + "\" does not exist, skipping"), &"")
                    continue
                }
                return Err(e("42704", &("role \"" + c.name + "\" does not exist")))
            }
            if c.name == me { return Err(e("55006", "current user cannot be dropped")) }
            // what it owns stays: refused; its grants and memberships go with it
            let owned = try renameInAcls(st, txn, &c.name, &"", true)
            if len(owned) > 0 {
                return Err(e("2BP01", &("role \"" + c.name + "\" cannot be dropped because some objects depend on it (it owns " + owned + ")")))
            }
            let x = try renameInAcls(st, txn, &c.name, &"", false)
            txn.del(lexdb_catalog.CATALOG, &(roleKey(&c.name)))
        }
        return Ok(tagOnly("DROP ROLE"))
    }
    let k = roleKey(&s.table)
    let have = try st.get(txn, lexdb_catalog.CATALOG, &k)
    if s.kind == lexdb_sql.S_CREATE_ROLE {
        if have.isSome() { return Err(e("42710", &("role \"" + s.table + "\" already exists"))) }
        if strings.startsWith(&s.table, "pg_") { return Err(e("42939", &("role name \"" + s.table + "\" is reserved"))) }
        var r = Role{name: s.table.clone(), login: false, superuser: false, verifier: "", oraVerifier: ""}
        try applyRoleOpts(mut &r, &s.names)
        try txn.put(lexdb_catalog.CATALOG, &k, &(encRole(&r)))
        return Ok(tagOnly("CREATE ROLE"))
    }
    var r = match have {
        Some(v) { decRole(&s.table, &v) }
        None { return Err(e("42704", &("role \"" + s.table + "\" does not exist"))) }
    }
    if len(s.names) == 1 && strings.startsWith(&s.names[0], "rename:") {
        let to = s.names[0][7..len(s.names[0])]
        if s.table == me { return Err(e("0A000", "session user cannot be renamed")) }
        if (try st.get(txn, lexdb_catalog.CATALOG, &(roleKey(&to)))).isSome() { return Err(e("42710", &("role \"" + to + "\" already exists"))) }
        txn.del(lexdb_catalog.CATALOG, &k)
        r.name = to.toStr()
        try txn.put(lexdb_catalog.CATALOG, &(roleKey(&to)), &(encRole(&r)))
        let x = try renameInAcls(st, txn, &s.table, &to, false)
        return Ok(tagOnly("ALTER ROLE"))
    }
    try applyRoleOpts(mut &r, &s.names)
    try txn.put(lexdb_catalog.CATALOG, &k, &(encRole(&r)))
    return Ok(tagOnly("ALTER ROLE"))
}

// ---- views (9.82)
//
// A view is a catalog row under its name, as a table is (the two share
// names): VIEW_MARK, then its columns (name and type), its query's text, and
// the catalog keys of the relations that query reads. Where it is named in
// FROM, the text is parsed and planned as a subquery (buildQuery). Its text
// names relations by name, so a relation it reads is not renamed, dropped,
// or changed in a column under it (dependentViews).

// A column's type from its OID and typmod (varchar's length, numeric's
// precision and scale), as a view keeps it.

// A view's query, parsed to be planned where the view is used.
fn viewQuery(t: &Table): Result[lexdb_sql.Stmt, DbErr] {
    if strings.startsWith(&t.view, SEQ_REL) {
        // a sequence's row: made by the executor, as a catalog relation's
        var q = lexdb_sql.newStmt(lexdb_sql.S_SELECT)
        q.srf = "#" + t.view
        q.use = lexdb_sql.SUB_FROM
        return Ok(q)
    }
    var ss = try lexdb_parse.parseView(&t.view)
    if len(ss) != 1 || ss[0].kind != lexdb_sql.S_SELECT { return Err(lexdb_base.corrupt(&("the query of view \"" + t.name + "\""))) }
    var q = pop(mut &ss)
    q.use = lexdb_sql.SUB_FROM
    return Ok(q)
}

// INSERT, UPDATE and DELETE on a view: refused (no updatable views yet).
fn notView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str, what: &str): Result[Unit, DbErr] {
    match try findTable(st, txn, name) {
        Some(t) {
            if len(t.view) > 0 {
                return Err(e("0A000", &("cannot " + what + " view \"" + lexdb_sql.shown(name) + "\" (lexdb's views are read-only)")))
            }
        }
        None {
            // a sequence (9.117)
            if (try findSeq(st, txn, name)).isSome() { return Err(e("42809", &("cannot change sequence \"" + lexdb_sql.shown(name) + "\""))) }
        }
    }
    return Ok(Unit{})
}

// The catalog keys of the relations a statement reads by name, its
// subqueries' and set operations' too (CTEs are among its subqueries).
fn readsOf(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, out: mut &[]str): Result[Unit, DbErr] {
    for f in s.from {
        if f.sub >= 0 || f.work >= 0 || len(f.table) == 0 { continue }
        let k = try catKey(st, txn, &f.table, false)
        if (try st.get(txn, lexdb_catalog.CATALOG, &k)).isSome() {
            var have = false
            for x in out { if x == k { have = true } }
            if !have { append(out, k) }
        }
    }
    for q in s.subs { try readsOf(st, txn, &q, out) }
    for q in s.inner { try readsOf(st, txn, &q, out) }
    return Ok(Unit{})
}

// Every view, by catalog key.

// The views with keys in [lo, hi).

// Every table (not views), from the catalog.

// The views that read relation k, directly or through other views.

// Before relation k is dropped: the views on it dropped (CASCADE), or 2BP01.
fn dropDependentViews(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str, cascade: bool, kind: &str): Result[Unit, DbErr] {
    let deps = try lexdb_catalog.dependentViews(st, txn, k)
    if len(deps) == 0 { return Ok(Unit{}) }
    if !cascade {
        return Err(e("2BP01", &("cannot drop " + kind + " " + lexdb_sql.shown(k) + " because other objects depend on it")))
    }
    for d in deps {
        txn.del(lexdb_catalog.CATALOG, &d)
        dropAcl(txn, &lexdb_catalog.relObj(&d))
    }
    return Ok(Unit{})
}

fn createView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var key = s.table.clone()
    if s.temp || (lexdb_sql.isQual(&s.table) && lexdb_sql.schemaOf(&s.table) == "pg_temp") {
        key = try createKey(st, txn, &s.table, true)
    } else if lexdb_sql.isQual(&s.table) {
        key = try createKey(st, txn, &s.table, false)
    } else {
        let sn = try createSchema(st, txn)
        if len(sn) == 0 { return Err(e("3F000", "no schema has been selected to create in")) }
        key = try catKey(st, txn, &s.table, false)
        if !(try relExists(st, txn, &key)) || lexdb_catalog.tempRel(&key) { key = lexdb_sql.qual(&sn, &s.table) }
    }
    let base = lexdb_sql.baseName(&key)
    var old = try viewOld(st, txn, &key, s)
    // the query planned: its columns, and the relations it reads
    var q = try viewQuery(&lexdb_catalog.decView(&key, &lexdb_catalog.encView(&[], &s.index, &[], &"")))
    q.use = lexdb_sql.SUB_SCALAR - lexdb_sql.SUB_SCALAR     // a statement of its own
    var sc = newScopeIn(st, txn, &[], &[])
    let sel = try planSelect(st, txn, &q, &[], mut &sc)
    if len(s.names) > len(sel.outs) { return Err(e("42601", "CREATE VIEW specifies more column names than columns")) }
    var cols: []lexdb_sql.ColDef = []
    for i in 0..len(sel.outs) {
        let n: &str = if i < len(s.names) { &s.names[i] } else { &sel.outs[i].name }
        for c in cols { if c.name == n { return Err(e("42701", &("column \"" + n + "\" specified more than once"))) } }
        var col = lexdb_sql.colDef(n, lexdb_sql.oidType(sel.outs[i].oid), false)
        col.spell = if i < len(s.names) { if i < len(s.spells) { s.spells[i].clone() } else { "" } } else { sel.outs[i].spell.clone() }
        append(mut &cols, col)
    }
    // a column's typmod, where the query's column is a table's
    var deps: []str = []
    try readsOf(st, txn, &q, mut &deps)
    // a view reading a temporary relation is temporary (PostgreSQL says so
    // in a NOTICE; lexdb has none), and may not be made elsewhere (9.96)
    if !lexdb_catalog.tempRel(&key) {
        var reads = false
        for d in deps { if lexdb_catalog.tempRel(&d) { reads = true } }
        if reads {
            if lexdb_sql.isQual(&s.table) { return Err(e("42P16", "cannot create temporary relation in non-temporary schema")) }
            key = try createKey(st, txn, &s.table, true)
            old = try viewOld(st, txn, &key, s)
        }
    }
    for d in deps { if d == key { return Err(e("42P17", &("infinite recursion detected in rules for relation \"" + base + "\""))) } }
    match old {
        Some(o) {
            // CREATE OR ALTER (SQL Server) and CREATE OR REPLACE (Oracle) give the view any new
            // definition; only PostgreSQL's OR REPLACE keeps the old columns
            // OR REPLACE: the old columns kept, in order, with their names and types; new ones after
            if s.mdialect == lexdb_sql.MD_PG && len(cols) < len(o.cols) { return Err(e("42P16", "cannot drop columns from view")) }
            for i in 0..(if s.mdialect == lexdb_sql.MD_PG { len(o.cols) } else { 0 }) {
                if cols[i].name != o.cols[i].name {
                    return Err(e("42P16", &("cannot change name of view column \"" + o.cols[i].name + "\" to \"" + cols[i].name + "\"")))
                }
                if cols[i].typ.oid != o.cols[i].typ.oid {
                    return Err(e("42P16", &("cannot change data type of view column \"" + o.cols[i].name + "\" from " +
                                 lexdb_pgcat.formatType(o.cols[i].typ.oid, -1) + " to " + lexdb_pgcat.formatType(cols[i].typ.oid, -1))))
                }
                cols[i].typ = o.cols[i].typ
            }
        }
        None {}
    }
    try txn.put(lexdb_catalog.CATALOG, &key, &(lexdb_catalog.encView(&cols, &s.index, &deps, &s.spell)))
    if old.isNone() { try ownNew(st, txn, &lexdb_catalog.relObj(&key)) }
    try bumpFor(st, txn, &key)
    return Ok(tagOnly("CREATE VIEW"))
}

// CREATE [OR REPLACE] VIEW's view key there already (OR REPLACE), or none
// (CREATE is then checked); errors if it may not be made there.
fn viewOld(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str, s: &lexdb_sql.Stmt): Result[Option[Table], DbErr] {
    let base = lexdb_sql.baseName(key)
    if try relExists(st, txn, key) {
        let have = try st.get(txn, lexdb_catalog.CATALOG, key)
        let isView = match have {
            Some(v) { strings.startsWith(&v, lexdb_catalog.VIEW_MARK) }
            None { false }
        }
        if !isView {
            if s.ifFlag && s.mdialect == lexdb_sql.MD_TSQL { return Err(e("TS2010", &("Cannot perform alter on '" + base + "' because it is an incompatible object type."))) }
            if s.ifFlag && s.mdialect == lexdb_sql.MD_PG { return Err(e("42809", &("\"" + base + "\" is not a view"))) }
            return Err(e("42P07", &("relation \"" + base + "\" already exists")))
        }
        if !s.ifFlag { return Err(e("42P07", &("relation \"" + base + "\" already exists"))) }
        try needRelOwner(st, txn, key, &"view")
        return Ok(Some(lexdb_catalog.decView(key, &have.unwrap())))
    }
    // ALTER VIEW (T-SQL) changes a view that is there
    if s.alter { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(key) + "\" does not exist"))) }
    try needCreate(st, txn, key)
    return Ok(None)
}

fn dropView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    var keys: []str = []
    for c in s.cols {
        match try findTable(st, txn, &c.name) {
            Some(t) {
                if len(t.view) == 0 { return Err(e("42809", &("\"" + lexdb_sql.shown(&c.name) + "\" is not a view (use DROP TABLE)"))) }
                try needRelOwner(st, txn, &t.name, &"view")
                try dropDependentViews(st, txn, &t.name, s.cascade, &"view")
                txn.del(lexdb_catalog.CATALOG, &t.name)
                dropAcl(txn, &lexdb_catalog.relObj(&t.name))
                append(mut &keys, t.name.clone())
            }
            None {
                if !s.ifFlag { return Err(e("42P01", &("view \"" + lexdb_sql.shown(&c.name) + "\" does not exist"))) }
                notice(st, txn, &"00000", &("view \"" + lexdb_sql.shown(&c.name) + "\" does not exist, skipping"), &"")
            }
        }
    }
    if len(keys) == 0 { append(mut &keys, "") }
    try bumpKeys(st, txn, &keys)
    return Ok(tagOnly("DROP VIEW"))
}

// ---- T-SQL's sp_rename (design/lexdb-dialect-gaps.md, package B, S10)

// A name as sp_rename takes it, [db.][schema.]object[.column]: its parts, each with its brackets or quotes off and
// folded to lower case.
fn nameParts(t: &str): []str {
    var parts: []str = []
    var cur = ""
    var i = 0
    while i < len(t) {
        let c = t[i]
        if c == '[' || c == '"' {
            let close: byte = if c == '[' { ']' } else { '"' }
            i += 1
            while i < len(t) {
                if t[i] == close {
                    if i + 1 < len(t) && t[i + 1] == close {
                        cur.addByte(close)
                        i += 2
                        continue
                    }
                    break
                }
                cur.addByte(t[i])
                i += 1
            }
        } else if c == '.' {
            append(mut &parts, strings.toLowerAscii(&cur))
            cur = ""
        } else {
            cur.addByte(c)
        }
        i += 1
    }
    append(mut &parts, strings.toLowerAscii(&cur))
    return parts
}

fn tsE(n: int, msg: &str): DbErr { return e("TS" + n.toStr(), msg) }

// The catalog key of the relation named by parts[0..n] (schema.name or name; dbo is public).
fn spKey(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, parts: &[]str, n: int): Result[str, DbErr] {
    if n >= 2 {
        let sc = if parts[n - 2] == "dbo" { "public" } else { parts[n - 2].toStr() }
        return Ok(lexdb_sql.qual(&sc, &parts[n - 1]))
    }
    return catKey(st, txn, &parts[0], false)
}

// The name a rename gives: its key's name (folded) and its spelling.
fn spNewName(name: &str): lexdb_sql.Alter {
    let low = strings.toLowerAscii(name)
    var a = lexdb_sql.alterOf(lexdb_sql.A_RENAME, &low)
    a.col.spell = if low == name { "" } else { name.toStr() }
    return a
}

// A column of a table renamed (sp_rename 'table.column', 'new' [, 'COLUMN']): None when there is no such table or column.
fn spColumn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, parts: &[]str, lim: Limits): Result[Option[Res], DbErr] {
    let n = len(parts)
    if n < 2 || n > 4 { return Ok(None) }
    let tkey = try spKey(st, txn, parts, n - 1)
    let found = try findTable(st, txn, &tkey)
    if found.isNone() { return Ok(None) }
    let t = found.unwrap()
    if len(t.view) > 0 { return Ok(None) }
    let from = parts[n - 1].clone()
    if colIndex(&t.cols, &from) < 0 { return Ok(None) }
    let newName = s.index.clone()
    let to = strings.toLowerAscii(&newName)
    if colIndex(&t.cols, &to) >= 0 && to != from {
        return Err(tsE(15335, "Error: The new name '" + newName + "' is already in use as a COLUMN name and would cause a duplicate that is not permitted."))
    }
    // a column a CHECK constraint names cannot be renamed: SQL Server binds the constraint's text to it
    for c in t.checks {
        var ns: []str = []
        lexdb_sql.colNames(&c.expr, mut &ns)
        for x in ns { if x == from { return Err(tsE(15336, "Object '" + s.table + "' cannot be renamed because the object participates in enforced dependencies.")) } }
    }
    var rs = lexdb_sql.newStmt(lexdb_sql.S_ALTER)
    rs.table = tkey
    rs.mdialect = lexdb_sql.MD_TSQL
    var a = lexdb_sql.alterOf(lexdb_sql.A_RENAME_COL, &from)
    a.to = to.clone()
    a.col.spell = if to == newName { "" } else { newName.toStr() }
    append(mut &rs.alters, a)
    let r = try alterTable(st, txn, &rs, lim)
    return Ok(Some(tagOnly("ALTER TABLE")))
}

// An index of a table renamed (sp_rename 'table.index', 'new' [, 'INDEX']): None when there is no such table or index.
fn spIndex(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, parts: &[]str): Result[Option[Res], DbErr] {
    let n = len(parts)
    if n < 2 || n > 4 { return Ok(None) }
    let tkey = try spKey(st, txn, parts, n - 1)
    let found = try findTable(st, txn, &tkey)
    if found.isNone() { return Ok(None) }
    let t = found.unwrap()
    let ixKey = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &parts[n - 1])
    var has = false
    for ix in t.indexes { if ix.name == ixKey { has = true } }
    if !has && !(lexdb_catalog.hasPk(&t) && lexdb_catalog.pkConName(&t) == parts[n - 1]) { return Ok(None) }
    let na = spNewName(&s.index)
    if na.name == parts[n - 1] { return Ok(Some(tagOnly("ALTER INDEX"))) }
    if try relExists(st, txn, &lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &na.name)) {
        return Err(tsE(15335, "Error: The new name '" + s.index + "' is already in use as a INDEX name and would cause a duplicate that is not permitted."))
    }
    var rs = lexdb_sql.newStmt(lexdb_sql.S_ALTER_INDEX)
    rs.index = ixKey
    rs.mdialect = lexdb_sql.MD_TSQL
    append(mut &rs.alters, na)
    let r = try alterIndex(st, txn, &rs)
    return Ok(Some(tagOnly("ALTER INDEX")))
}

// sp_rename 'name', 'new' [, 'COLUMN' | 'INDEX' | 'OBJECT']: s.table the name, s.index the new name, s.alias the type ("" none).
fn spRename(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, lim: Limits): Result[Res, DbErr] {
    let parts = nameParts(&s.table)
    let n = len(parts)
    let newName = s.index.clone()
    let lowName = strings.toLowerAscii(&newName)
    let kind = s.alias.clone()
    let typeName = if len(kind) == 0 { "(null)" } else { strings.toUpperAscii(&kind) }
    let notFound = tsE(15225, "No item by the name '" + s.table + "' could be found in the current database '" + lexdb_syscat.SYS_DB_NAME +
                       "', given that @itemtype was input as '" + typeName + "'.")
    let wrongType = tsE(15248, "Either the parameter @objname is ambiguous or the claimed @objtype (" + (if len(kind) == 0 { "OBJECT" } else { typeName }) + ") is wrong.")
    if kind == "database" { return Err(e("0A000", "lexdb: sp_rename of a database is not supported yet")) }
    if kind == "userdatatype" || kind == "statistics" { return Err(wrongType) }
    if kind == "column" {
        match try spColumn(st, txn, s, &parts, lim) {
            Some(r) { return Ok(r) }
            None { return Err(wrongType) }
        }
    }
    if kind == "index" {
        match try spIndex(st, txn, s, &parts) {
            Some(r) { return Ok(r) }
            None { return Err(wrongType) }
        }
    }
    // an object: a table, a view, a constraint
    if n <= 2 || (n == 3 && parts[0] == lexdb_syscat.SYS_DB_NAME) {
        let key = try spKey(st, txn, &parts, n)
        match try findTable(st, txn, &key) {
            Some(t) {
                if (try relExists(st, txn, &lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), &lowName))) && lowName != lexdb_sql.baseName(&t.name) {
                    return Err(tsE(15335, "Error: The new name '" + newName + "' is already in use as a OBJECT name and would cause a duplicate that is not permitted."))
                }
                if len(t.view) > 0 {
                    let na = spNewName(&newName)
                    return renameView(st, txn, &t, &na.name, &na.col.spell, false, "ALTER VIEW")
                }
                var rs = lexdb_sql.newStmt(lexdb_sql.S_ALTER)
                rs.table = t.name.clone()
                rs.mdialect = lexdb_sql.MD_TSQL
                append(mut &rs.alters, spNewName(&newName))
                let r = try alterTable(st, txn, &rs, lim)
                return Ok(tagOnly("ALTER TABLE"))
            }
            None {}
        }
        // a constraint of that name (in the schema's tables)
        let sc = lexdb_sql.schemaOf(&key)
        let cn = lexdb_sql.baseName(&key)
        for t in try allTables(st, txn) {
            if lexdb_sql.schemaOf(&t.name) != sc || !conTaken(&t, &cn) { continue }
            if conTaken(&t, &lowName) && lowName != cn {
                return Err(tsE(15335, "Error: The new name '" + newName + "' is already in use as a OBJECT name and would cause a duplicate that is not permitted."))
            }
            var rs = lexdb_sql.newStmt(lexdb_sql.S_ALTER)
            rs.table = t.name.clone()
            rs.mdialect = lexdb_sql.MD_TSQL
            var a = lexdb_sql.alterOf(lexdb_sql.A_RENAME_CON, &cn)
            a.to = lowName.clone()
            append(mut &rs.alters, a)
            let r = try alterTable(st, txn, &rs, lim)
            return Ok(tagOnly("ALTER TABLE"))
        }
    }
    // without a type, table.column and table.index are names too
    if len(kind) == 0 {
        match try spColumn(st, txn, s, &parts, lim) {
            Some(r) { return Ok(r) }
            None {}
        }
        match try spIndex(st, txn, s, &parts) {
            Some(r) { return Ok(r) }
            None {}
        }
        return Err(notFound)
    }
    return Err(wrongType)
}

// T-SQL's ALTER DATABASE ... SET: the settings kept in a catalog row (lexdb_dbopt), shown by sys.databases.
// lexdb has the one database, which CURRENT and its own name mean.
fn alterDatabase(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if len(s.table) > 0 && strings.toLowerAscii(&s.table) != lexdb_syscat.SYS_DB_NAME {
        return Err(e("TS5011", &("User does not have permission to alter database '" + s.table +
                     "', the database does not exist, or the database is not in a state that allows access checks.")))
    }
    let cur = (try st.get(txn, lexdb_catalog.CATALOG, &lexdb_dbopt.KEY)).unwrapOr("")
    let now = try lexdb_dbopt.apply(&cur, &s.names)
    try txn.put(lexdb_catalog.CATALOG, &lexdb_dbopt.KEY, &now)
    return Ok(tagOnly("ALTER DATABASE"))
}

// ---- renames and the views that read what is renamed (design/lexdb-dialect-gaps.md, package B)
//
// PostgreSQL's views follow ALTER TABLE ... RENAME and ALTER VIEW ... RENAME TO, and a column's
// RENAME COLUMN: a view keeps working, and its output columns keep their names. lexdb keeps a
// view's query as text, so the view records what was renamed (Table.rn: the table a name in its
// text means now, the column a name in its text means now) and its query is planned with those
// names (Scope.rn). SQL Server's and Oracle's views are not followed: they keep their text and
// stop working (T-SQL: 208, 207; Oracle: ORA-04063) until the names are back.

// A view that reads a relation about to be renamed: the names its text gives that relation.
type Follow = record { view: str; names: []str }

// The tables a statement's FROM items name (its subqueries' too) that are relation old (by a name
// in the text of a view with renames rn).
fn viewTables(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, rn: &[]str, old: &str, out: mut &[]str): Result[Unit, DbErr] {
    for f in s.from {
        if f.sub >= 0 || f.work >= 0 || len(f.table) == 0 { continue }
        var eff = ""
        for r in rn {
            let rp = strings.split(&r, lexdb_catalog.RN_SEP)
            if len(rp) == 3 && rp[0] == "t" && rp[1] == f.table { eff = rp[2].toStr() }
        }
        if len(eff) == 0 { eff = try catKey(st, txn, &f.table, false) }
        if eff == old && !lexdb_base.hasStr(out, &f.table) { append(out, f.table.clone()) }
    }
    for q in s.subs { try viewTables(st, txn, &q, rn, old, out) }
    for q in s.inner { try viewTables(st, txn, &q, rn, old, out) }
    return Ok(Unit{})
}

// The views reading relation old, directly, with the names of their text for it (before it is renamed).
fn followPlan(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, old: &str): Result[[]Follow, DbErr] {
    var out: []Follow = []
    for v in try lexdb_catalog.allViews(st, txn) {
        if !lexdb_base.hasStr(&v.deps, old) { continue }
        var names: []str = []
        let ss = try lexdb_parse.parseView(&v.view)
        for q in ss { try viewTables(st, txn, &q, &v.rn, old, mut &names) }
        append(mut &out, Follow{view: v.name.clone(), names: names})
    }
    return Ok(out)
}

fn putView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, v: &Table, deps: &[]str, rn: &[]str): Result[Unit, DbErr] {
    try txn.put(lexdb_catalog.CATALOG, &v.name, &(lexdb_catalog.encViewRn(&v.cols, &v.view, deps, &v.spell, rn)))
    try bumpFor(st, txn, &v.name)
    return Ok(Unit{})
}

// Relation old is now new: its views follow.
fn followApply(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, plan: &[]Follow, old: &str, new: &str): Result[Unit, DbErr] {
    for p in plan {
        let raw = (try st.get(txn, lexdb_catalog.CATALOG, &p.view)).unwrap()
        let v = lexdb_catalog.decView(&p.view, &raw)
        var deps: []str = []
        for d in v.deps { append(mut &deps, if d == old { new.toStr() } else { d.clone() }) }
        var rn: []str = []
        for r in v.rn {
            var rp = strings.split(&r, lexdb_catalog.RN_SEP)
            if len(rp) == 3 && rp[0] == "t" && rp[2] == old { append(mut &rn, "t" + lexdb_catalog.RN_SEP + rp[1] + lexdb_catalog.RN_SEP + new) }
            else if len(rp) == 4 && rp[0] == "c" && rp[1] == old { append(mut &rn, "c" + lexdb_catalog.RN_SEP + new + lexdb_catalog.RN_SEP + rp[2] + lexdb_catalog.RN_SEP + rp[3]) }
            else { append(mut &rn, r.clone()) }
        }
        for n in p.names {
            var have = false
            for r in rn {
                let rp = strings.split(&r, lexdb_catalog.RN_SEP)
                if len(rp) == 3 && rp[0] == "t" && rp[1] == n { have = true }
            }
            if !have { append(mut &rn, "t" + lexdb_catalog.RN_SEP + n + lexdb_catalog.RN_SEP + new) }
        }
        try putView(st, txn, &v, &deps, &rn)
    }
    return Ok(Unit{})
}

// Column from of table key is now to: the views reading the table follow.
fn followColumn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str, from: &str, to: &str): Result[Unit, DbErr] {
    for v in try lexdb_catalog.allViews(st, txn) {
        if !lexdb_base.hasStr(&v.deps, key) { continue }
        var rn: []str = []
        var found = false
        for r in v.rn {
            let rp = strings.split(&r, lexdb_catalog.RN_SEP)
            if len(rp) == 4 && rp[0] == "c" && rp[1] == key && rp[2] == from {
                append(mut &rn, "c" + lexdb_catalog.RN_SEP + key + lexdb_catalog.RN_SEP + to + lexdb_catalog.RN_SEP + rp[3])
                found = true
            } else {
                append(mut &rn, r.clone())
            }
        }
        if !found { append(mut &rn, "c" + lexdb_catalog.RN_SEP + key + lexdb_catalog.RN_SEP + to + lexdb_catalog.RN_SEP + from) }
        try putView(st, txn, &v, &v.deps, &rn)
    }
    return Ok(Unit{})
}

// Whether a statement's query names column col (by itself or as any qualifier's), or takes every column (*).
fn queryUses(s: &lexdb_sql.Stmt, col: &str): bool {
    var names: []str = []
    for it in s.items {
        if it.star { return true }
        match it.expr {
            Some(x) { lexdb_sql.colNames(&x, mut &names) }
            None {}
        }
    }
    match s.where { Some(x) { lexdb_sql.colNames(&x, mut &names) } None {} }
    match s.having { Some(x) { lexdb_sql.colNames(&x, mut &names) } None {} }
    for x in s.group { lexdb_sql.colNames(&x, mut &names) }
    for o in s.order { lexdb_sql.colNames(&o.expr, mut &names) }
    for f in s.from {
        match f.on { Some(x) { lexdb_sql.colNames(&x, mut &names) } None {} }
        for u in f.using { append(mut &names, u.clone()) }
        if f.natural { return true }
    }
    for n in names { if n == col || strings.endsWith(&n, &("." + col)) { return true } }
    for q in s.subs { if queryUses(&q, col) { return true } }
    for q in s.inner { if queryUses(&q, col) { return true } }
    return false
}

// A view reading table key that uses its column col (PostgreSQL refuses a retyped or dropped column then): its name, or "".
fn viewUsing(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str, col: &str): Result[str, DbErr] {
    for v in try lexdb_catalog.allViews(st, txn) {
        if !lexdb_base.hasStr(&v.deps, key) { continue }
        let ss = try lexdb_parse.parseView(&v.view)
        for q in ss { if queryUses(&q, col) { return Ok(v.name.clone()) } }
    }
    return Ok("")
}

// A view renamed: its row moves to the new key, and (PostgreSQL's) the views reading it follow.
fn renameView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table, name: &str, spell: &str, follow: bool, tag: &str): Result[Res, DbErr] {
    try needRelOwner(st, txn, &t.name, &"view")
    let to = lexdb_sql.qual(&lexdb_sql.schemaOf(&t.name), name)
    if to == t.name { return Ok(tagOnly(tag)) }
    if try relExists(st, txn, &to) { return Err(e("42P07", &("relation \"" + name + "\" already exists"))) }
    var plan: []Follow = []
    if follow { plan = try followPlan(st, txn, &t.name) }
    let raw = (try st.get(txn, lexdb_catalog.CATALOG, &t.name)).unwrap()
    let v = lexdb_catalog.decView(&t.name, &raw)
    txn.del(lexdb_catalog.CATALOG, &t.name)
    try txn.put(lexdb_catalog.CATALOG, &to, &(lexdb_catalog.encViewRn(&v.cols, &v.view, &v.deps, spell, &v.rn)))
    try moveAcl(st, txn, &lexdb_catalog.relObj(&t.name), &lexdb_catalog.relObj(&to))
    try followApply(st, txn, &plan, &t.name, &to)
    try bumpFor(st, txn, &to)
    return Ok(tagOnly(tag))
}

// ALTER VIEW name RENAME TO new: the views reading it follow.
fn alterView(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let found = try findTable(st, txn, &s.table)
    if found.isNone() {
        if s.ifFlag {
            notice(st, txn, &"00000", &("relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist, skipping"), &"")
            return Ok(tagOnly("ALTER VIEW"))
        }
        return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist")))
    }
    let t = found.unwrap()
    if len(t.view) == 0 { return Err(e("42809", &("\"" + lexdb_sql.shown(&s.table) + "\" is not a view"))) }
    return renameView(st, txn, &t, &s.index, &"", true, "ALTER VIEW")
}

// ---- privileges (9.83)
//
// Owners and privileges as PostgreSQL's: an object's owner may do anything
// with it; others what was granted to them, to a role they are a member of
// (transitively), or to PUBLIC. A role that is a superuser, and a session
// whose user is no role (it came in by trust), are not checked. The facts
// are catalog rows of their own: ACL_PRE and an object ("r:" a relation's
// catalog key, "n:" a schema) holds its owner and grants; MEM_PRE, a role
// and a member, a membership. Privileges are letters, as in PostgreSQL's
// aclitem: r SELECT, a INSERT, w UPDATE, d DELETE, x REFERENCES, t TRIGGER,
// U USAGE, C CREATE.

const MEM_PRE: str = "\x02mem\x00"

fn encAcl(a: &Acl): str {
    var b = ""
    b += &a.owner
    b += if a.set { "\n1" } else { "\n0" }
    for g in a.grants {
        b.addByte('\n')
        b += &g.to
        b.addByte('\t')
        b += &g.privs
    }
    return b
}

fn readAcl(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, obj: &str): Result[Acl, DbErr] {
    match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.ACL_PRE + obj)) {
        Some(v) { return Ok(lexdb_catalog.decAcl(obj, &v)) }
        None { return Ok(Acl{owner: "", grants: lexdb_catalog.defaultGrants(obj), set: false}) }
    }
}

fn writeAcl(txn: mut &lexdb_store.Txn, obj: &str, a: &Acl): Result[Unit, DbErr] {
    try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.ACL_PRE + obj), &(encAcl(a)))
    return Ok(Unit{})
}

fn dropAcl(txn: mut &lexdb_store.Txn, obj: &str) { txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.ACL_PRE + obj)) }

fn moveAcl(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, from: &str, to: &str): Result[Unit, DbErr] {
    match try st.get(txn, lexdb_catalog.CATALOG, &(lexdb_catalog.ACL_PRE + from)) {
        Some(v) {
            txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.ACL_PRE + from))
            try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.ACL_PRE + to), &v)
        }
        None {}
    }
    return Ok(Unit{})
}

// A new object's owner: the session's current role.
fn ownNew(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, obj: &str): Result[Unit, DbErr] {
    return writeAcl(txn, obj, &Acl{owner: currentRole(st, txn.sql.sess), grants: [], set: false})
}

fn roleKeyOf(sess: int): str { return "\x00role\x00" + sess.toStr() }
fn sessAuthKey(sess: int): str { return "\x00sessauth\x00" + sess.toStr() }

// The session's user as SET SESSION AUTHORIZATION made it, else its login's.
fn sessionUser(st: &lexdb_store.Store, sess: int): str {
    match st.memo.get(&sessAuthKey(sess)) {
        Some(u) { if len(u) > 0 { return u } }
        None {}
    }
    return st.memo.get(&lexdb_catalog.userKey(sess)).unwrapOr("lexdb")
}

// The role privileges are checked as: SET ROLE's, else the session user.
fn currentRole(st: &lexdb_store.Store, sess: int): str {
    match st.memo.get(&roleKeyOf(sess)) {
        Some(r) { if len(r) > 0 { return r } }
        None {}
    }
    return sessionUser(st, sess)
}

// Who a role is, for checks: whether it is a superuser (or no role: a
// trusted session's user), and the roles it acts as: itself, the roles it is
// a member of, PUBLIC ("").
pub type Who = record { name: str; super: bool; roles: []str }

fn whoIs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, name: &str): Result[Who, DbErr] {
    match try st.get(txn, lexdb_catalog.CATALOG, &(roleKey(name))) {
        Some(v) {
            let r = decRole(name, &v)
            var w = Who{name: name.toStr(), super: r.superuser, roles: [name.toStr(), ""]}
            if w.super { return Ok(w) }
            // memberships: role, member pairs, followed from name up
            var pairs: []str = []
            try st.scan(txn, lexdb_catalog.CATALOG, MEM_PRE, &(MEM_PRE + "\xff"), fn(en: &lexdb_store.Entry): bool {
                append(mut &pairs, en.key[len(MEM_PRE)..len(en.key)].toStr())
                return true
            })
            var todo: []str = [name.toStr()]
            while len(todo) > 0 {
                let m = pop(mut &todo)
                for pr in pairs {
                    let z = strings.indexOf(&pr, "\x00", 0)
                    let role = pr[0..z].toStr()
                    if pr[z + 1..len(pr)] == m && !lexdb_base.hasStr(&w.roles, &role) {
                        append(mut &w.roles, role.clone())
                        append(mut &todo, role)
                    }
                }
            }
            return Ok(w)
        }
        None { return Ok(Who{name: name.toStr(), super: true, roles: [name.toStr(), ""]}) }
    }
}

fn whoNow(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[Who, DbErr] { return whoIs(st, txn, &currentRole(st, txn.sql.sess)) }

fn allows(w: &Who, a: &Acl, letter: &str): bool {
    if w.super { return true }
    if len(a.owner) > 0 && lexdb_base.hasStr(&w.roles, &a.owner) { return true }
    for g in a.grants { if lexdb_base.hasStr(&w.roles, &g.to) && strings.contains(&g.privs, letter) { return true } }
    return false
}

fn may(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, w: &Who, obj: &str, letter: &str): Result[bool, DbErr] {
    if w.super { return Ok(true) }
    return Ok(allows(w, &(try readAcl(st, txn, obj)), letter))
}

fn denied(kind: &str, name: &str): DbErr { return e("42501", &("permission denied for " + kind + " " + lexdb_sql.baseName(name))) }

// The door a session came in by, kept in the store's memo (lexdb_tds and lexdb_tns set it): "tds" (SQL Server's), "tns"
// (Oracle's), "" the PostgreSQL wire and in-process sessions. Neither SQL Server nor Oracle has a schema privilege to
// read an object through (an object's own GRANT is all a user needs of it), as PostgreSQL's USAGE on a schema is.
fn doorKey(sess: int): str { return "\x00door\x00" + sess.toStr() }
fn doorOf(st: &lexdb_store.Store, sess: int): str { return st.memo.get(&doorKey(sess)).unwrapOr("") }

// The session's door (lexdb_tds, lexdb_tns).
pub fn (s: &Session) setDoor(d: &str) { s.st.memo.put(&doorKey(s.id), d) }

// A privilege letter's name as SQL Server's messages say it.
fn tsqlPriv(letter: &str): str {
    return match letter { "r" { "SELECT" } "a" { "INSERT" } "w" { "UPDATE" } "d" { "DELETE" } "x" { "REFERENCES" } "D" { "ALTER" } else { "EXECUTE" } }
}

// SQL Server's 229 for a table: "The SELECT permission was denied on the object 't', database 'lexdb', schema 'dbo'."
fn deniedTsql(letter: &str, key: &str): DbErr {
    let sc = lexdb_sql.schemaOf(key)
    return e("TS229", &("The " + tsqlPriv(letter) + " permission was denied on the object '" + lexdb_sql.baseName(key) + "', database 'lexdb', schema '" +
                        (if sc == "public" { "dbo" } else { sc }) + "'."))
}

// A relation's privilege (and its schema's USAGE, for the PostgreSQL door): 42501 without them.
fn needRel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, w: &Who, key: &str, letter: &str, kind: &str): Result[Unit, DbErr] {
    if w.super { return Ok(Unit{}) }
    let sc = lexdb_sql.schemaOf(key)
    var door = ""
    if !(try may(st, txn, w, &lexdb_catalog.nspObj(&sc), &"U")) {
        door = doorOf(st, txn.sql.sess)
        if len(door) == 0 { return Err(denied(&"schema", &sc)) }
    }
    if !(try may(st, txn, w, &lexdb_catalog.relObj(key), letter)) {
        if len(door) == 0 { door = doorOf(st, txn.sql.sess) }
        if door == "tds" { return Err(deniedTsql(letter, key)) }
        // Oracle: a table the user cannot read is ORA-00942 (it is not there for it), one it can read but not use so is ORA-01031
        if door == "tns" {
            if letter == "r" || !(try may(st, txn, w, &lexdb_catalog.relObj(key), &"r")) { return Err(e("ORA00942", "table or view does not exist")) }
            return Err(e("ORA01031", "insufficient privileges"))
        }
        return Err(denied(kind, key))
    }
    return Ok(Unit{})
}

fn needOwner(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, w: &Who, obj: &str, kind: &str, name: &str): Result[Unit, DbErr] {
    if w.super { return Ok(Unit{}) }
    let a = try readAcl(st, txn, obj)
    if len(a.owner) > 0 && lexdb_base.hasStr(&w.roles, &a.owner) { return Ok(Unit{}) }
    return Err(e("42501", &("must be owner of " + kind + " " + lexdb_sql.baseName(name))))
}

// CREATE in a schema.
fn needCreate(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str): Result[Unit, DbErr] {
    let sc = lexdb_sql.schemaOf(key)
    if sc == tempSchema(txn.sql.sess) { return Ok(Unit{}) }        // a session's temporary tables
    let w = try whoNow(st, txn)
    if !(try may(st, txn, &w, &lexdb_catalog.nspObj(&sc), &"C")) { return Err(denied(&"schema", &sc)) }
    return Ok(Unit{})
}

// The owner check for a relation's DDL (ALTER, DROP, CREATE INDEX on it).
fn needRelOwner(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str, kind: &str): Result[Unit, DbErr] {
    let w = try whoNow(st, txn)
    return needOwner(st, txn, &w, &lexdb_catalog.relObj(key), kind, key)
}

// The letters a privilege name stands for on an object of a kind
// (table, sequence, schema); "" if it is not one of them.
fn privLetters(name: &str, kind: &str): str {
    if kind == "schema" {
        return match name { "usage" { "U" } "create" { "C" } "all" { "UC" } else { "" } }
    }
    if kind == "sequence" {
        return match name { "select" { "r" } "update" { "w" } "usage" { "U" } "all" { "rwU" } else { "" } }
    }
    return match name {
        "select" { "r" }
        "insert" { "a" }
        "update" { "w" }
        "delete" { "d" }
        "references" { "x" }
        "trigger" { "t" }
        "truncate" { "D" }
        "maintain" { "" }
        "all" { "arwdDxt" }
        else { "" }
    }
}

fn addLetters(have: &str, more: &str): str {
    var out = have.toStr()
    for i in 0..len(more) { if !strings.contains(&out, &more[i..i + 1]) { out = out + more[i..i + 1] } }
    // in PostgreSQL's order
    var sorted = ""
    for c in ["a", "r", "w", "d", "D", "x", "t", "U", "C"] { if strings.contains(&out, &c) { sorted = sorted + c } }
    return sorted
}

fn dropLetters(have: &str, gone: &str): str {
    var out = ""
    for i in 0..len(have) { if !strings.contains(&gone, &have[i..i + 1]) { out = out + have[i..i + 1] } }
    return out
}

// A role spec's name: CURRENT_USER and SESSION_USER resolved.
fn roleName(st: &lexdb_store.Store, txn: &lexdb_store.Txn, r: &str): str {
    if r == "#current_user" { return currentRole(st, txn.sql.sess) }
    if r == "#session_user" { return sessionUser(st, txn.sql.sess) }
    return r.toStr()
}

fn roleExists(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, r: &str): Result[bool, DbErr] {
    return Ok((try st.get(txn, lexdb_catalog.CATALOG, &(roleKey(r)))).isSome())
}

// The objects a GRANT or REVOKE names: (object, kind word, name) for each.
type Target = record { obj: str; kind: str; name: str }

fn grantTargets(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[[]Target, DbErr] {
    var out: []Target = []
    for c in s.cols {
        if s.index == "schema" {
            if !(try schemaExists(st, txn, &c.name)) { return Err(e("3F000", &("schema \"" + c.name + "\" does not exist"))) }
            append(mut &out, Target{obj: lexdb_catalog.nspObj(&c.name), kind: "schema", name: c.name.clone()})
        } else if s.index == "all tables" || s.index == "all sequences" {
            if !(try schemaExists(st, txn, &c.name)) { return Err(e("3F000", &("schema \"" + c.name + "\" does not exist"))) }
            if s.index == "all tables" {
                // its tables and views, as they are now
                let from = lexdb_sql.qual(&c.name, &"")
                var keys: []str = []
                try st.scan(txn, lexdb_catalog.CATALOG, if c.name == "public" { "\x06" } else { &from }, &(if c.name == "public" { "" } else { from + "\xff" }),
                            fn(en: &lexdb_store.Entry): bool {
                    if lexdb_sql.schemaOf(&en.key) == c.name { append(mut &keys, en.key.clone()) }
                    return true
                })
                for k in keys { append(mut &out, Target{obj: lexdb_catalog.relObj(&k), kind: "table", name: k.clone()}) }
            } else {
                for d in try lexdb_catalog.allSeqs(st, txn, if c.name == "public" { "" } else { &c.name }) {
                    if lexdb_sql.schemaOf(&d.key) == c.name { append(mut &out, Target{obj: lexdb_catalog.relObj(&d.key), kind: "sequence", name: d.key.clone()}) }
                }
            }
        } else if s.index == "sequence" {
            match try findSeq(st, txn, &c.name) {
                Some(d) { append(mut &out, Target{obj: lexdb_catalog.relObj(&d.key), kind: "sequence", name: d.key.clone()}) }
                None { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&c.name) + "\" does not exist"))) }
            }
        } else {
            // a table or a view; a sequence named as a table is one too, as in PostgreSQL
            match try findTable(st, txn, &c.name) {
                Some(t) { append(mut &out, Target{obj: lexdb_catalog.relObj(&t.name), kind: if len(t.view) > 0 { "view" } else { "table" }, name: t.name.clone()}) }
                None {
                    match try findSeq(st, txn, &c.name) {
                        Some(d) { append(mut &out, Target{obj: lexdb_catalog.relObj(&d.key), kind: "sequence", name: d.key.clone()}) }
                        None { return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&c.name) + "\" does not exist"))) }
                    }
                }
            }
        }
    }
    return Ok(out)
}

// Who may GRANT or REVOKE letters on an object: its owner, a role it is a member of, a superuser. The other doors say
// no as their own systems do: SQL Server's 4613, Oracle's 1720 for a user that holds the privilege without a grant
// option (lexdb has none), else 1031 (the 42501).
fn needGrantor(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, w: &Who, tg: &Target, letters: &str, door: &str): Result[Unit, DbErr] {
    if w.super { return Ok(Unit{}) }
    let a = try readAcl(st, txn, &tg.obj)
    if len(a.owner) > 0 && lexdb_base.hasStr(&w.roles, &a.owner) { return Ok(Unit{}) }
    if door == "tds" { return Err(e("TS4613", "Grantor does not have GRANT permission.")) }
    if door == "tns" && (tg.kind == "table" || tg.kind == "view") {
        for k in 0..len(letters) {
            if allows(w, &a, &letters[k..k + 1]) {
                return Err(e("ORA01720", &("grant option does not exist for '" + strings.toUpperAscii(&lexdb_sql.schemaOf(&tg.name)) + "." + strings.toUpperAscii(&lexdb_sql.baseName(&tg.name)) + "'")))
            }
        }
    }
    return needOwner(st, txn, w, &tg.obj, &tg.kind, &tg.name)
}

fn grantStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let grant = s.kind == lexdb_sql.S_GRANT
    let tag = if grant { "GRANT" } else { "REVOKE" }
    if s.index == "database" { return Ok(tagOnly(&tag)) }       // lexdb has no database privileges: CONNECT and the rest hold
    let w = try whoNow(st, txn)
    let door = doorOf(st, txn.sql.sess)
    var grantees: []str = []
    for g in s.pk {
        let r = roleName(st, txn, &g)
        if len(r) > 0 && !(try roleExists(st, txn, &r)) {
            if door == "tds" { return Err(e("TS15151", &("Cannot find the user '" + r + "', because it does not exist or you do not have permission."))) }
            return Err(e("42704", &("role \"" + r + "\" does not exist")))
        }
        append(mut &grantees, r)
    }
    if s.index == "role" {
        // memberships: a superuser's to give
        if !w.super { return Err(e("42501", "permission denied to grant role")) }
        for c in s.cols {
            if !(try roleExists(st, txn, &c.name)) { return Err(e("42704", &("role \"" + c.name + "\" does not exist"))) }
            for m in grantees {
                if len(m) == 0 { return Err(e("0LP01", "role \"public\" cannot be a member of a role")) }
                if m == c.name { return Err(e("0LP01", &("role \"" + m + "\" is a member of role \"" + c.name + "\""))) }
                if grant {
                    // no cycles: c may not already be a member of m
                    let up = try whoIs(st, txn, &c.name)
                    if lexdb_base.hasStr(&up.roles, &m) { return Err(e("0LP01", &("role \"" + c.name + "\" is a member of role \"" + m + "\""))) }
                    try txn.put(lexdb_catalog.CATALOG, &(MEM_PRE + c.name + "\x00" + m), "")
                } else {
                    txn.del(lexdb_catalog.CATALOG, &(MEM_PRE + c.name + "\x00" + m))
                }
            }
        }
        try bumpCatalog(st, txn)
        return Ok(tagOnly(&(tag + " ROLE")))
    }
    var targets: []Target = []
    match grantTargets(st, txn, s) {
        Ok(ts) { targets = ts }
        Err(x) {
            if door == "tds" && x.state == "42P01" && len(s.cols) > 0 {
                return Err(e("TS15151", &("Cannot find the object '" + lexdb_sql.baseName(&s.cols[0].name) + "', because it does not exist or you do not have permission.")))
            }
            return Err(x)
        }
    }
    for tg in targets {
        var letters = ""
        for pn in s.names {
            var l = privLetters(&pn, if tg.kind == "view" { "table" } else { &tg.kind })
            // ALL on a table is the five privileges SQL Server and Oracle have (neither has TRUNCATE or TRIGGER)
            if pn == "all" && len(door) > 0 && (tg.kind == "table" || tg.kind == "view") { l = "arwdx" }
            if len(l) == 0 && pn != "maintain" {
                return Err(e("0LP01", &("invalid privilege type " + strings.toUpperAscii(&pn) + " for " + tg.kind)))
            }
            letters = addLetters(&letters, &l)
        }
        try needGrantor(st, txn, &w, &tg, &letters, &door)
        var a = try readAcl(st, txn, &tg.obj)
        if !a.set { a.set = true }
        for g in grantees {
            var found = -1
            for i in 0..len(a.grants) { if a.grants[i].to == g { found = i } }
            if grant {
                if found < 0 { append(mut &a.grants, Grant{to: g.clone(), privs: addLetters(&"", &letters)}) }
                else { a.grants[found].privs = addLetters(&a.grants[found].privs, &letters) }
            } else if found >= 0 {
                a.grants[found].privs = dropLetters(&a.grants[found].privs, &letters)
            }
        }
        var kept: []Grant = []
        for g in a.grants { if len(g.privs) > 0 { append(mut &kept, Grant{to: g.to.clone(), privs: g.privs.clone()}) } }
        a.grants = kept
        try writeAcl(txn, &tg.obj, &a)
    }
    try bumpCatalog(st, txn)
    return Ok(tagOnly(&tag))
}

// ALTER TABLE | VIEW | SEQUENCE | SCHEMA name OWNER TO role: a superuser's,
// or the owner's when it is a member of the new owner (PostgreSQL's rule).
fn ownerStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let tag = "ALTER " + strings.toUpperAscii(&s.index)
    let to = roleName(st, txn, &s.names[0])
    if len(to) == 0 || !(try roleExists(st, txn, &to)) { return Err(e("42704", &("role \"" + (if len(to) == 0 { "public" } else { to }) + "\" does not exist"))) }
    var obj = ""
    var name = s.table.clone()
    if s.index == "schema" {
        if !(try schemaExists(st, txn, &s.table)) { return Err(e("3F000", &("schema \"" + s.table + "\" does not exist"))) }
        obj = lexdb_catalog.nspObj(&s.table)
    } else if s.index == "sequence" {
        match try findSeq(st, txn, &s.table) {
            Some(d) {
                obj = lexdb_catalog.relObj(&d.key)
                name = d.key.clone()
            }
            None {}
        }
    } else {
        match try findTable(st, txn, &s.table) {
            Some(t) {
                if (s.index == "view") != (len(t.view) > 0) {
                    return Err(e("42809", &("\"" + lexdb_sql.shown(&s.table) + "\" is not a " + s.index)))
                }
                obj = lexdb_catalog.relObj(&t.name)
                name = t.name.clone()
            }
            None {}
        }
    }
    if len(obj) == 0 {
        if s.ifFlag { return Ok(tagOnly(&tag)) }
        return Err(e("42P01", &("relation \"" + lexdb_sql.shown(&s.table) + "\" does not exist")))
    }
    let w = try whoNow(st, txn)
    try needOwner(st, txn, &w, &obj, &s.index, &name)
    if !w.super && !lexdb_base.hasStr(&w.roles, &to) { return Err(e("42501", &("must be able to SET ROLE \"" + to + "\""))) }
    var a = try readAcl(st, txn, &obj)
    a.owner = to
    try writeAcl(txn, &obj, &a)
    try bumpCatalog(st, txn)
    return Ok(tagOnly(&tag))
}

// INSERT, UPDATE, DELETE: the privilege (letter) on the target; and SELECT
// where the statement reads its rows: a WHERE, RETURNING, a SET reading a
// column, ON CONFLICT DO UPDATE (which needs UPDATE too).
fn dmlCheck(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, letter: &str): Result[Unit, DbErr] {
    let w = try whoNow(st, txn)
    if w.super { return Ok(Unit{}) }
    let key = try catKey(st, txn, &s.table, false)
    if !(try relExists(st, txn, &key)) { return Ok(Unit{}) }      // the statement says it does not exist
    try needRel(st, txn, &w, &key, letter, &"table")
    var reads = s.where.isSome() || len(s.items) > 0
    if letter == "w" { for set in s.sets { if colsIn(&set.expr) { reads = true } } }
    if letter == "a" && s.conflict == lexdb_sql.CONFLICT_UPDATE {
        try needRel(st, txn, &w, &key, &"w", &"table")
        reads = true
    }
    if reads { try needRel(st, txn, &w, &key, &"r", &"table") }
    return Ok(Unit{})
}

fn colsIn(x: &Expr): bool {
    match x {
        Expr.Col(_, _) { return true }
        Expr.Unary(_, a) { return colsIn(&a) }
        Expr.Bin(_, a, b) { return colsIn(&a) || colsIn(&b) }
        Expr.IsNull(a, _) { return colsIn(&a) }
        Expr.Cast(a, _) { return colsIn(&a) }
        Expr.Call(_, args, _) {
            for a in args { if colsIn(&a) { return true } }
            return false
        }
        else { return false }
    }
}

// SET ROLE name | NONE, RESET ROLE: privileges checked as the role, which
// the session's user must be a member of (or a superuser). SET SESSION
// AUTHORIZATION name | DEFAULT: the session's user, for a superuser's login
// only; it ends SET ROLE.
fn (s: mut &Session) setRole(stmt: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let name: &str = if len(stmt.names) > 0 && !stmt.ifFlag { &stmt.names[0] } else { "" }
    let tag = if stmt.ifFlag { "RESET" } else { "SET" }
    var t = try s.st.beginSnapshot()
    let st = &s.st
    let r = setRoleIn(st, mut &t, s.id, &stmt.table, name)
    st.abort(t)
    try r
    return Ok(tagOnly(&tag))
}

fn setRoleIn(st: &lexdb_store.Store, t: mut &lexdb_store.Txn, id: int, what: &str, name: &str): Result[Unit, DbErr] {
    if len(name) > 0 && !(try roleExists(st, t, name)) { return Err(e("22023", &("role \"" + name + "\" does not exist"))) }
    if what == "session_authorization" {
        let login = st.memo.get(&lexdb_catalog.userKey(id)).unwrapOr("lexdb")
        if !(try whoIs(st, t, &login)).super && name != login {
            return Err(e("42501", "permission denied to set session authorization"))
        }
        st.memo.put(&sessAuthKey(id), name)
        st.memo.put(&roleKeyOf(id), &"")
        return Ok(Unit{})
    }
    if len(name) > 0 {
        let w = try whoIs(st, t, &sessionUser(st, id))
        if !w.super && !lexdb_base.hasStr(&w.roles, name) { return Err(e("42501", &("permission denied to set role \"" + name + "\""))) }
    }
    st.memo.put(&roleKeyOf(id), name)
    return Ok(Unit{})
}

// A role's name in the owners, grants and memberships: renamed to to, or
// ("" ) taken out of grants and memberships. With check, nothing changes:
// the first object it owns, "" if none.
fn renameInAcls(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, from: &str, to: &str, check: bool): Result[str, DbErr] {
    var keys: []str = []
    var vals: []str = []
    try st.scan(txn, lexdb_catalog.CATALOG, lexdb_catalog.ACL_PRE, &(lexdb_catalog.ACL_PRE + "\xff"), fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key.clone())
        append(mut &vals, en.val.clone())
        return true
    })
    for i in 0..len(keys) {
        let obj = keys[i][len(lexdb_catalog.ACL_PRE)..len(keys[i])].toStr()
        var a = try readAcl(st, txn, &obj)
        if check {
            if a.owner == from { return Ok(if strings.startsWith(&obj, "n:") { "schema " + obj[2..len(obj)] } else { lexdb_sql.shown(&obj[2..len(obj)]) }) }
            continue
        }
        if a.owner == from { a.owner = to.toStr() }
        var kept: []Grant = []
        for g in a.grants {
            if g.to == from { if len(to) > 0 { append(mut &kept, Grant{to: to.toStr(), privs: g.privs.clone()}) } }
            else { append(mut &kept, Grant{to: g.to.clone(), privs: g.privs.clone()}) }
        }
        a.grants = kept
        try writeAcl(txn, &obj, &a)
    }
    if check { return Ok("") }
    var mems: []str = []
    try st.scan(txn, lexdb_catalog.CATALOG, MEM_PRE, &(MEM_PRE + "\xff"), fn(en: &lexdb_store.Entry): bool {
        append(mut &mems, en.key[len(MEM_PRE)..len(en.key)].toStr())
        return true
    })
    for pr in mems {
        let z = strings.indexOf(&pr, "\x00", 0)
        let role = pr[0..z].toStr()
        let member = pr[z + 1..len(pr)].toStr()
        if role != from && member != from { continue }
        txn.del(lexdb_catalog.CATALOG, &(MEM_PRE + pr))
        if len(to) > 0 {
            try txn.put(lexdb_catalog.CATALOG, &(MEM_PRE + (if role == from { to.toStr() } else { role }) + "\x00" + (if member == from { to.toStr() } else { member })), "")
        }
    }
    return Ok("")
}

// The catalog's view of owners and grants (9.83).

// has_table_privilege([role,] relation, 'SELECT, INSERT'), and the schema's
// and sequence's: true if the role holds any of the privileges named, by
// the bound catalog's roles and grants.
fn hasPrivFn(se: &SeqEnv, name: &str, vs: &[]Val): Result[Val, DbErr] {
    let n = len(vs)
    if n != 2 && n != 3 { return Err(e("42883", &("function " + name + " with " + n.toStr() + " arguments does not exist"))) }
    // the role: a name or an OID; the session's current role by default
    var role = catUser(se)
    if n == 3 {
        match vs[0] {
            Val.Text(t) { role = t.clone() }
            else {
                let o = lexdb_ops.oidArg(&vs[0]).unwrapOr(0).toStr()
                for l in catLines(se, &"R") { if l[0] == o { role = l[1].clone() } }
            }
        }
    }
    var w = Who{name: role.clone(), super: true, roles: [role.clone(), ""]}
    var known = false
    for l in catLines(se, &"R") {
        if l[1] == role {
            known = true
            w.super = l[2] == "1"
            w.roles = []
            for r in strings.split(&l[3], "\x1e") { append(mut &w.roles, r.toStr()) }
        }
    }
    if !known && n == 3 && len(catLines(se, &"R")) > 0 && role != catUser(se) {
        let sess = catLines(se, &"U")
        if len(sess) == 0 || sess[0][0] != role { return Err(e("42704", &("role \"" + role + "\" does not exist"))) }
    }
    let target = &vs[n - 2]
    let kind = if name == "has_schema_privilege" { "schema" } else if name == "has_sequence_privilege" { "sequence" } else { "table" }
    var obj = ""
    if kind == "schema" {
        let sn = lexdb_sql.text(target)
        for l in catLines(se, &"n") { if l[1] == sn || l[0] == sn { obj = lexdb_catalog.nspObj(&l[1]) } }
        if len(obj) == 0 { return Err(e("3F000", &("schema \"" + sn + "\" does not exist"))) }
    } else {
        var o = lexdb_ops.oidArg(target).unwrapOr(0)
        if o == 0 { o = relOidOf(se, &lexdb_sql.text(target)) }
        for l in catLines(se, &"r") { if l[0] == o.toStr() { obj = lexdb_catalog.relObj(&lexdb_sql.qual(&l[2], &l[3])) } }
        if len(obj) == 0 { return Err(e("42P01", &("relation \"" + lexdb_sql.text(target) + "\" does not exist"))) }
    }
    var a = Acl{owner: "", grants: lexdb_catalog.defaultGrants(&obj), set: false}
    for l in catLines(se, &"A") { if l[0] == obj { a = lexdb_catalog.decAcl(&obj, &strings.replaceAll(&(strings.replaceAll(&l[1], "\x1e", "\n")), "\x1d", "\t")) } }
    for part in strings.split(&lexdb_sql.text(&vs[n - 1]), ",") {
        var p = strings.toLowerAscii(&(strings.trim(&part)))
        let grantOpt = strings.endsWith(&p, " with grant option")
        if grantOpt { p = strings.trim(&p[0..len(p) - 18]) }
        let letters = privLetters(&p, &kind)
        if len(letters) == 0 { return Err(e("22023", &("unrecognized privilege type: \"" + strings.trim(&part) + "\""))) }
        if grantOpt {
            // the owner's and a superuser's only: lexdb gives no grant options
            if w.super || (len(a.owner) > 0 && lexdb_base.hasStr(&w.roles, &a.owner)) { return Ok(Val.Bool(true)) }
            continue
        }
        for k in 0..len(letters) { if allows(&w, &a, &letters[k..k + 1]) { return Ok(Val.Bool(true)) } }
    }
    return Ok(Val.Bool(false))
}

// ---- MATCH_RECOGNIZE (design/lexdb-match-recognize.md 4.3 and 6): the wrapper subquery's plan and its
// execution. The input is planned and run as an ordinary SELECT *; execMatch then sorts and partitions
// its rows, searches each partition with lexdb_match, and makes the output rows.

pub const NV_LAST = 1         // MrNav.kind: LAST(x, off), and a plain column
pub const NV_FIRST = 2
pub const NV_AGG = 3
pub const NV_CLS = 4
pub const NV_MNO = 5

type MrNav = record {
    kind: int
    set: []bool               // the variables it reads; [] the universal variable
    off: int                  // FIRST/LAST offset
    phys: int                 // then PREV (-n) or NEXT (+n); 0 none
    final: bool               // FINAL
    arg: Expr                 // evaluated on the target row, against inCols (resolved)
    col: int                  // arg is a bare column: its index (a fast path); -1
    spec: AggSpec             // NV_AGG
    wrap: Option[Expr]        // NV_AGG: what is around the aggregate (its slot is #agg 0): T-SQL's AVG
}

type MrPlan = record {
    inCols: []lexdb_sql.ColDef    // the input's columns, bare names
    keyX: []Expr                  // PARTITION BY then ORDER BY, resolved against inCols
    keyAt: []int                  // per key: its input column, -1 an expression
    np: int
    desc: []bool                  // per ORDER BY item
    nullsFirst: []bool
    prog: lexdb_match.Prog
    shown: []str                  // per variable, CLASSIFIER's text
    navs: []MrNav                 // slot k of every rewritten expression
    defs: []Option[Expr]          // per variable: its DEFINE, rewritten (slots); None always true
    defNavs: [][]int              // ... the slots each uses
    meas: []Expr                  // MEASURES, rewritten
    measNavs: [][]int
    local: bool                   // every DEFINE local: the matcher's memo
    rows: int
    skip: int
    skipSet: []bool               // TO FIRST/LAST: the variables named
    outs: []OutCol                // the output columns
    outFrom: []int                // per output column: input column j (j >= 0) or measure -1 - i
    dialect: int
    text: str                     // the clause as one line (EXPLAIN)
}

fn mrNavOf(kind: int, set: []bool, arg: Expr): MrNav {
    return MrNav{kind: kind, set: set, off: 0, phys: 0, final: false, arg: arg, col: -1, spec: noSpec(), wrap: None}
}

fn mrErr(d: int, ora: int, oraText: &str, pg: &str, ts: int, msg: &str): DbErr {
    if d == lexdb_sql.MD_ORA { return e(&("ORA" + strings.padLeft(&(ora.toStr()), 5, '0')), oraText) }
    if d == lexdb_sql.MD_TSQL && ts > 0 { return e(&("TS" + ts.toStr()), msg) }
    return e(pg, msg)
}

type MrRw = record {
    vars: []str
    subsets: []lexdb_sql.MrSubset
    inCols: []lexdb_sql.ColDef
    navs: []MrNav
    d: int
    inDefine: bool
    curVar: int
}

type MrQual = record { seen: bool; q: str }

fn mrTextType(): lexdb_sql.TypeName { return lexdb_sql.TypeName{kind: lexdb_sql.K_TEXT, oid: lexdb_sql.OID_TEXT, prec: 0, scale: 0, len: 0} }
fn mrIntType(): lexdb_sql.TypeName { return lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0} }

fn (rw: &MrRw) unknownCol(c: &str): DbErr {
    return mrErr(rw.d, 904, &("\"" + strings.toUpperAscii(c) + "\": invalid identifier"), "42703", 207, &("column \"" + c + "\" does not exist"))
}

fn (rw: &MrRw) badVar(q: &str, what: &str): DbErr {
    return mrErr(rw.d, 62504, "illegal variable reference", "42P01", 4104,
                 &(if rw.d == lexdb_sql.MD_TSQL { "The multi-part identifier \"" + what + "\" could not be bound." } else { "missing FROM-clause entry for table \"" + q + "\"" }))
}

// The variables a qualifier names: [] for none (the universal variable), a variable, or a subset.
fn (rw: &MrRw) setOf(q: &str): Result[[]bool, DbErr] {
    if len(q) == 0 { return Ok([]) }
    var set: []bool = array(len(rw.vars), false)
    let k = mrVarIndexE(&rw.vars, q)
    if k >= 0 {
        set[k] = true
        return Ok(set)
    }
    for s in rw.subsets {
        if s.name == q {
            for v in s.vars { set[v] = true }
            return Ok(set)
        }
    }
    return Err(rw.badVar(q, q))
}

fn mrVarIndexE(vars: &[]str, n: &str): int {
    for i in 0..len(vars) { if vars[i] == n { return i } }
    return -1
}

fn mrNavName(n: &str): bool { return n == "prev" || n == "next" || n == "first" || n == "last" }

// An argument of a navigation or aggregate: its columns' qualifiers must agree (62508) and name a variable
// (62504), its columns must exist; nothing in it navigates or aggregates (62506, 62507, 62509). Returns
// it with the qualifiers taken off.
fn mrStrip(x: &Expr, rw: &MrRw, qual: mut &MrQual): Result[Expr, DbErr] {
    match x {
        Expr.Col(n, _) {
            let d = strings.indexOf(&n, ".", 0)
            let q = if d < 0 { "" } else { n[0..d].toStr() }
            let c = if d < 0 { n.toStr() } else { n[d + 1..len(n)].toStr() }
            if len(q) > 0 && mrVarIndexE(&rw.vars, &q) < 0 {
                var isSub = false
                for s in rw.subsets { if s.name == q { isSub = true } }
                if !isSub { return Err(rw.badVar(&q, &n)) }
            }
            if colIndex(&rw.inCols, &c) < 0 { return Err(rw.unknownCol(&c)) }
            if qual.seen && qual.q != q {
                return Err(mrErr(rw.d, 62508, "illegal use of aggregates or navigation operators in MATCH_RECOGNIZE clause", "42601", 0,
                                 "an argument of a navigation or aggregate names more than one variable"))
            }
            qual.seen = true
            qual.q = q
            return Ok(Expr.Col(c, -1))
        }
        Expr.Unary(op, a) { return Ok(Expr.Unary(op.clone(), try mrStrip(&a, rw, qual))) }
        Expr.Bin(op, a, b) {
            let l = try mrStrip(&a, rw, qual)
            let r = try mrStrip(&b, rw, qual)
            return Ok(Expr.Bin(op.clone(), l, r))
        }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try mrStrip(&a, rw, qual), neg)) }
        Expr.Cast(a, t) { return Ok(Expr.Cast(try mrStrip(&a, rw, qual), t)) }
        Expr.Call(name, args, star) {
            if mrNavName(&name) || lexdb_bind.isAgg(&name) {
                return Err(mrErr(rw.d, 62506, "illegal nesting of operators in MATCH_RECOGNIZE clause", "42601", 0,
                                 "illegal nesting of navigation or aggregate operators in MATCH_RECOGNIZE"))
            }
            if name == "classifier" || name == "match_number" {
                return Err(mrErr(rw.d, 62507, "illegal use of MATCH_NUMBER or CLASSIFIER in MATCH_RECOGNIZE clause", "42601", 0,
                                 "CLASSIFIER and MATCH_NUMBER cannot be used inside a navigation or aggregate"))
            }
            if name == "#running" || name == "#final" { return Err(rw.badRunning()) }
            if lexdb_sql.isSubCall(&name) { return Err(rw.noSub()) }
            var out: []Expr = []
            for a in args { append(mut &out, try mrStrip(&a, rw, qual)) }
            return Ok(Expr.Call(name.clone(), out, star))
        }
        else { return Ok(lexdb_sql.cloneExpr(x)) }
    }
}

fn (rw: &MrRw) badRunning(): DbErr {
    return mrErr(rw.d, 62509, "illegal use of RUNNING or FINAL in MATCH_RECOGNIZE clause", "42601", 0, "illegal use of RUNNING or FINAL in MATCH_RECOGNIZE")
}

fn (rw: &MrRw) noSub(): DbErr {
    return mrErr(rw.d, 3001, "intended feature is not enabled", "0A000", 0, "lexdb: a subquery in a MATCH_RECOGNIZE clause is not supported")
}

// The marker for navigation nav, its resolved stand-in (its type) the argument.
fn (rw: mut &MrRw) mark(nav: MrNav, standin: Expr): Expr {
    append(mut &rw.navs, nav)
    return Expr.Call("#mrnav", [Expr.Lit(Val.Int(len(rw.navs) - 1)), standin], false)
}

fn mrMarkId(x: &Expr): int {
    match x {
        Expr.Call(n, args, _) {
            if n == "#mrnav" && len(args) == 2 { return lexdb_sql.litInt(&args[0]) }
            return -1
        }
        else { return -1 }
    }
}

// A navigation offset: a non-negative integer literal (62520).
fn (rw: &MrRw) offsetOf(args: &[]Expr, at: int, dflt: int): Result[int, DbErr] {
    if len(args) <= at { return Ok(dflt) }
    match args[at] {
        Expr.Lit(v) {
            match v {
                // (past 2^50 rows nothing is there: kept small so the arithmetic on it cannot overflow)
                Val.Int(n) { if n >= 0 { return Ok(if n > 1125899906842624 { 1125899906842624 } else { n }) } }
                else {}
            }
        }
        else {}
    }
    return Err(mrErr(rw.d, 62520, "illegal offset for MATCH_RECOGNIZE navigation operators", "42601", 0, "illegal offset for MATCH_RECOGNIZE navigation operators"))
}

// FIRST(x [, n]) and LAST(x [, n]): a marker.
fn mrFirstLast(name: &str, args: &[]Expr, rw: mut &MrRw, final: int): Result[Expr, DbErr] {
    if len(args) < 1 || len(args) > 2 { return Err(e("42883", &("function " + name + " takes one or two arguments"))) }
    let off = try rw.offsetOf(args, 1, 0)
    var qual = MrQual{seen: false, q: ""}
    let arg = try mrStrip(&args[0], rw, mut &qual)
    var nav = mrNavOf(if name == "first" { NV_FIRST } else { NV_LAST }, try rw.setOf(&qual.q), lexdb_sql.cloneExpr(&arg))
    nav.off = off
    nav.final = final == 2
    return Ok(rw.mark(nav, arg))
}

fn mrRewrite(x: &Expr, rw: mut &MrRw, final: int): Result[Expr, DbErr] {
    match x {
        Expr.Col(n, _) {
            var qual = MrQual{seen: false, q: ""}
            let arg = try mrStrip(x, rw, mut &qual)
            return Ok(rw.mark(mrNavOf(NV_LAST, try rw.setOf(&qual.q), lexdb_sql.cloneExpr(&arg)), arg))
        }
        Expr.Unary(op, a) { return Ok(Expr.Unary(op.clone(), try mrRewrite(&a, rw, 0))) }
        Expr.Bin(op, a, b) {
            let l = try mrRewrite(&a, rw, 0)
            let r = try mrRewrite(&b, rw, 0)
            return Ok(Expr.Bin(op.clone(), l, r))
        }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try mrRewrite(&a, rw, 0), neg)) }
        Expr.Cast(a, t) { return Ok(Expr.Cast(try mrRewrite(&a, rw, 0), t)) }
        Expr.Call(name, args, star) {
            if name == "#running" || name == "#final" {
                if name == "#final" && rw.inDefine { return Err(rw.badRunning()) }
                var ok = false
                match args[0] {
                    Expr.Call(inner, _, _) { ok = lexdb_bind.isAgg(&inner) || inner == "first" || inner == "last" }
                    else {}
                }
                if !ok { return Err(rw.badRunning()) }
                return mrRewrite(&args[0], rw, if name == "#final" { 2 } else { 1 })
            }
            if name == "first" || name == "last" { return mrFirstLast(&name, &args, rw, final) }
            if name == "prev" || name == "next" {
                if len(args) < 1 || len(args) > 2 { return Err(e("42883", &("function " + name + " takes one or two arguments"))) }
                let n = try rw.offsetOf(&args, 1, 1)
                let phys = if name == "prev" { -n } else { n }
                var inner = false
                match args[0] {
                    Expr.Call(f, _, _) { inner = f == "first" || f == "last" }
                    else {}
                }
                if inner {
                    var fa: []Expr = []
                    var fname = ""
                    match args[0] {
                        Expr.Call(f, a2, _) {
                            fname = f.toStr()
                            for a in a2 { append(mut &fa, lexdb_sql.cloneExpr(&a)) }
                        }
                        else {}
                    }
                    let mk = try mrFirstLast(&fname, &fa, rw, 0)
                    rw.navs[mrMarkId(&mk)].phys = phys
                    return Ok(mk)
                }
                var qual = MrQual{seen: false, q: ""}
                let arg = try mrStrip(&args[0], rw, mut &qual)
                var nav = mrNavOf(NV_LAST, try rw.setOf(&qual.q), lexdb_sql.cloneExpr(&arg))
                nav.phys = phys
                return Ok(rw.mark(nav, arg))
            }
            if name == "classifier" || name == "match_number" {
                if final != 0 { return Err(rw.badRunning()) }
                if name == "classifier" { return Ok(rw.mark(mrNavOf(NV_CLS, [], Expr.Cast(Expr.Lit(Val.Text("")), mrTextType())), Expr.Cast(Expr.Lit(Val.Text("")), mrTextType()))) }
                return Ok(rw.mark(mrNavOf(NV_MNO, [], Expr.Cast(Expr.Lit(Val.Int(0)), mrIntType())), Expr.Cast(Expr.Lit(Val.Int(0)), mrIntType())))
            }
            if lexdb_bind.isAgg(&name) {
                let base = lexdb_sql.aggBase(&name)
                if name != base || !(base == "count" || base == "sum" || base == "avg" || base == "min" || base == "max") {
                    return Err(mrErr(rw.d, 62512, "This aggregate is not yet supported in MATCH_RECOGNIZE clause.", "0A000", 0,
                                     "lexdb: this aggregate is not supported in MATCH_RECOGNIZE"))
                }
                var qual = MrQual{seen: false, q: ""}
                var standin = Expr.Lit(Val.Null)
                var set: []bool = []
                if star {
                    if len(args) == 1 {
                        match args[0] {
                            Expr.Lit(v) { set = try rw.setOf(&lexdb_sql.text(&v)) }
                            else {}
                        }
                    }
                    standin = Expr.Call("count", [], true)
                } else {
                    if len(args) != 1 { return Err(e("42883", &("function " + base + " takes 1 argument"))) }
                    let a = try mrStrip(&args[0], rw, mut &qual)
                    set = try rw.setOf(&qual.q)
                    standin = Expr.Call(name.toStr(), [a], false)
                }
                var nav = mrNavOf(NV_AGG, set, lexdb_sql.cloneExpr(&standin))
                nav.final = final == 2
                return Ok(rw.mark(nav, standin))
            }
            if lexdb_sql.isSubCall(&name) { return Err(rw.noSub()) }
            var out: []Expr = []
            for a in args { append(mut &out, try mrRewrite(&a, rw, 0)) }
            return Ok(Expr.Call(name.clone(), out, star))
        }
        else { return Ok(lexdb_sql.cloneExpr(x)) }
    }
}

// x, resolved, with its markers replaced by their slots; the navigations take their resolved arguments.
fn mrSlots(x: &Expr, rw: mut &MrRw): Result[Expr, DbErr] {
    match x {
        Expr.Unary(op, a) { return Ok(Expr.Unary(op.clone(), try mrSlots(&a, rw))) }
        Expr.Bin(op, a, b) {
            let l = try mrSlots(&a, rw)
            let r = try mrSlots(&b, rw)
            return Ok(Expr.Bin(op.clone(), l, r))
        }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try mrSlots(&a, rw), neg)) }
        Expr.Cast(a, t) { return Ok(Expr.Cast(try mrSlots(&a, rw), t)) }
        Expr.Call(name, args, star) {
            if name == "#mrnav" && len(args) == 2 {
                let k = lexdb_sql.litInt(&args[0])
                let standin = &args[1]
                if rw.navs[k].kind == NV_LAST || rw.navs[k].kind == NV_FIRST {
                    rw.navs[k].arg = lexdb_sql.cloneExpr(standin)
                    match standin {
                        Expr.Col(cn, sl) { rw.navs[k].col = lexdb_bind.colSlot(&rw.inCols, &cn, sl) }
                        else {}
                    }
                } else if rw.navs[k].kind == NV_AGG {
                    var specs: []AggSpec = []
                    let wrapped = try collectAggs(standin, mut &specs)
                    if len(specs) != 1 { return Err(e("XX000", "lexdb: MATCH_RECOGNIZE: an aggregate was not found")) }
                    rw.navs[k].spec = pop(mut &specs)
                    rw.navs[k].arg = lexdb_sql.cloneExpr(standin)
                    match standin {
                        Expr.Call(f, _, _) { if !lexdb_bind.isAgg(&f) { rw.navs[k].wrap = Some(wrapped) } }
                        else {}
                    }
                }
                return Ok(slotRef(k))
            }
            var out: []Expr = []
            for a in args { append(mut &out, try mrSlots(&a, rw)) }
            return Ok(Expr.Call(name.clone(), out, star))
        }
        else { return Ok(lexdb_sql.cloneExpr(x)) }
    }
}

// x with its markers replaced by their stand-ins: an ordinary expression, for its type and collation.
fn mrUnmark(x: &Expr): Expr {
    match x {
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), mrUnmark(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), mrUnmark(&a), mrUnmark(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(mrUnmark(&a), neg) }
        Expr.Cast(a, t) { return Expr.Cast(mrUnmark(&a), t) }
        Expr.Call(name, args, star) {
            if name == "#mrnav" && len(args) == 2 { return lexdb_sql.cloneExpr(&args[1]) }
            var out: []Expr = []
            for a in args { append(mut &out, mrUnmark(&a)) }
            return Expr.Call(name.clone(), out, star)
        }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// Whether DEFINE of variable v reads only its own row (the matcher's memo applies): every navigation is a
// plain LAST (offset 0) over the universal variable or one holding v, or CLASSIFIER.
fn mrLocal(navs: &[]MrNav, ids: &[]int, v: int): bool {
    for k in ids {
        let nv = &navs[k]
        if nv.kind == NV_CLS { continue }
        if nv.kind != NV_LAST || nv.off != 0 { return false }
        if len(nv.set) > 0 && !nv.set[v] { return false }
    }
    return true
}

fn planMatch(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, m: &lexdb_sql.MatchRec, sel: mut &Sel, params: &[]Val,
             sc: mut &Scope): Result[Unit, DbErr] {
    let d = m.dialect
    var inCols: []lexdb_sql.ColDef = []
    for o in sel.outs {
        var c = lexdb_sql.colDef(&o.name, outType(&o), false)
        c.spell = o.spell.clone()
        c.coll = o.coll.clone()
        append(mut &inCols, c)
    }
    let nIn = len(inCols)
    var rvars: []str = []
    for v in m.vars { append(mut &rvars, v.clone()) }
    var rsubs: []lexdb_sql.MrSubset = []
    for sb in m.subsets { append(mut &rsubs, lexdb_sql.MrSubset{name: sb.name.clone(), spell: sb.spell.clone(), vars: collections.copyOf(&sb.vars)}) }
    var rw = MrRw{vars: rvars, subsets: rsubs, inCols: inCols, navs: [], d: d, inDefine: false, curVar: -1}
    let unknown = fn(c: &str): DbErr {
        return mrErr(d, 904, &("\"" + strings.toUpperAscii(&(c.toStr())) + "\": invalid identifier"), "42703", 207, &("column \"" + c + "\" does not exist"))
    }
    // keys: PARTITION BY, then ORDER BY (the plan's, lpOrder: as resolved;
    // the planner's, keyX: collation keys)
    var lpOrder: []Expr = []
    var keyX: []Expr = []
    var keyAt: []int = []
    var desc: []bool = []
    var nullsFirst: []bool = []
    var partCols: []int = []
    var ordCols: []int = []
    for pn in m.part {
        let at = colIndex(&rw.inCols, &pn)
        if at < 0 { return Err(unknown(&pn)) }
        append(mut &partCols, at)
        let r = try lexdb_bind.resolve(&Expr.Col(pn.toStr(), -1), &rw.inCols, nIn, mut &sc.names)
        let k = lexdb_bind.exprKind(&r, &rw.inCols, &sc.names)
        append(mut &keyAt, if k == lexdb_sql.COLL_EXACT { colAtOf(&r, &rw.inCols) } else { -1 })
        append(mut &keyX, lexdb_bind.collKeyOf(k, r))
    }
    for o in m.order {
        let r = try lexdb_bind.resolve(&o.expr, &rw.inCols, nIn, mut &sc.names)
        let k = lexdb_bind.exprKind(&r, &rw.inCols, &sc.names)
        append(mut &keyAt, if k == lexdb_sql.COLL_EXACT { colAtOf(&r, &rw.inCols) } else { -1 })
        append(mut &keyX, lexdb_bind.collKeyOf(k, lexdb_sql.cloneExpr(&r)))
        append(mut &lpOrder, r)
        append(mut &desc, o.desc)
        append(mut &nullsFirst, o.nullsFirst)
        match o.expr {
            Expr.Col(cn, _) {
                let at = colIndex(&rw.inCols, &cn)
                if at >= 0 { append(mut &ordCols, at) }
            }
            else {}
        }
    }
    // the pattern
    let cr = lexdb_match.compile(&m.pattern, len(m.vars))
    if cr.isErr() {
        if cr.unwrapErr() == lexdb_match.CE_EMPTY_LOOP {
            return Err(mrErr(d, 62513, "Quantified subpatterns that can have empty matches are not yet supported.", "0A000", 0,
                             "quantified subpatterns that can have empty matches are not supported"))
        }
        return Err(mrErr(d, 62518, "MATCH_RECOGNIZE pattern is too large.", "54001", 0, "MATCH_RECOGNIZE pattern is too large"))
    }
    let prog = cr.unwrap()
    // DEFINE (the plan's, lpDefs: as resolved, navigations marked; the
    // planner's, defs: the marks as slots)
    var lpDefs: []Option[Expr] = []
    var defs: []Option[Expr] = []
    var defNavs: [][]int = []
    var local = true
    for v in 0..len(m.vars) {
        var found = -1
        for i in 0..len(m.defines) { if m.defines[i].v == v { found = i } }
        if found < 0 {
            append(mut &defs, None)
            append(mut &lpDefs, None)
            append(mut &defNavs, [])
            continue
        }
        rw.inDefine = true
        rw.curVar = v
        let n0 = len(rw.navs)
        let e1 = try mrRewrite(&m.defines[found].cond, mut &rw, 0)
        let e2 = try lexdb_bind.resolve(&e1, &rw.inCols, nIn, mut &sc.names)
        let e3 = try mrSlots(&e2, mut &rw)
        var ids: []int = []
        for k in n0..len(rw.navs) { append(mut &ids, k) }
        if !mrLocal(&rw.navs, &ids, v) { local = false }
        append(mut &defs, Some(e3))
        append(mut &lpDefs, Some(e2))
        append(mut &defNavs, ids)
    }
    rw.inDefine = false
    // MEASURES (lpMeas and meas as DEFINE's)
    var lpMeas: []Expr = []
    var meas: []Expr = []
    var measNavs: [][]int = []
    var measOuts: []OutCol = []
    for it in m.measures {
        let n0 = len(rw.navs)
        let x = match it.expr { Some(y) { lexdb_sql.cloneExpr(&y) } None { Expr.Lit(Val.Null) } }
        let e1 = try mrRewrite(&x, mut &rw, 0)
        let e2 = try lexdb_bind.resolve(&e1, &rw.inCols, nIn, mut &sc.names)
        let plain = mrUnmark(&e2)
        let e3 = try mrSlots(&e2, mut &rw)
        var ids: []int = []
        for k in n0..len(rw.navs) { append(mut &ids, k) }
        let pt = lexdb_bind.ptypesOf(&sc.names)
        var oid = exprOid(&plain, &rw.inCols, &pt)
        var sc2 = exprScale(&plain, &rw.inCols)
        var cname = lexdb_bind.exprColl(&plain, &rw.inCols, &sc.names).name
        // CLASSIFIER is text in every door, MATCH_NUMBER and COUNT are int8
        var isCls = false
        var isMno = false
        match e1 {
            Expr.Call(f, _, _) {
                if f == "#mrnav" {
                    let k = mrMarkId(&e1)
                    if rw.navs[k].kind == NV_CLS { isCls = true }
                    if rw.navs[k].kind == NV_MNO { isMno = true }
                }
            }
            else {}
        }
        if isCls { oid = lexdb_sql.OID_TEXT }
        if isMno { oid = lexdb_sql.OID_INT8 }
        append(mut &meas, e3)
        append(mut &lpMeas, e2)
        append(mut &measNavs, ids)
        append(mut &measOuts, OutCol{name: it.alias.clone(), oid: oid, spell: it.spell.clone(), coll: if isCls || isMno { "" } else { cname }, scale: sc2})
    }
    // the output columns
    var outs: []OutCol = []
    var outFrom: []int = []
    for j in partCols {
        append(mut &outs, sel.outs[j].clone())
        append(mut &outFrom, j)
    }
    if m.rows != lexdb_sql.MR_ONE {
        for j in ordCols {
            append(mut &outs, sel.outs[j].clone())
            append(mut &outFrom, j)
        }
    }
    for i in 0..len(measOuts) {
        append(mut &outs, measOuts[i].clone())
        append(mut &outFrom, -1 - i)
    }
    if m.rows != lexdb_sql.MR_ONE {
        for j in 0..nIn {
            if hasIdx(&partCols, j) || hasIdx(&ordCols, j) { continue }
            append(mut &outs, sel.outs[j].clone())
            append(mut &outFrom, j)
        }
    }
    if len(outs) == 0 {
        return Err(mrErr(d, 30732, "table contains no user-visible columns", "42601", 0, "MATCH_RECOGNIZE has no output columns"))
    }
    for i in 0..len(outs) {
        for j in 0..i {
            if outs[i].name == outs[j].name {
                let nm = &outs[i].name
                return Err(mrErr(d, 918, &(strings.toUpperAscii(&(nm.toStr())) + ": column ambiguously specified - appears in  and "), "42701", 8156,
                                 &(if d == lexdb_sql.MD_TSQL { "The column '" + nm + "' was specified multiple times for '" + m.alias + "'." }
                                 else { "column \"" + nm + "\" specified more than once" })))
            }
        }
    }
    // AFTER MATCH SKIP TO: the variables named
    var skipSet: []bool = array(len(m.vars), false)
    if len(m.skipTo) > 0 {
        let k = mrVarIndexE(&m.vars, &m.skipTo)
        if k >= 0 { skipSet[k] = true } else {
            for s in m.subsets { if s.name == m.skipTo { for v in s.vars { skipSet[v] = true } } }
        }
    }
    // the logical plan: Match over the Sel's, with the clauses as resolved
    let mdef = lexdb_bind.MatchDef{part: collections.copyOf(&partCols), order: lpOrder, desc: collections.copyOf(&desc), nullsFirst: collections.copyOf(&nullsFirst),
                                   defs: lpDefs, meas: lpMeas}
    sel.lp = lexdb_bind.LPlan.Match(replace(mut &sel.lp, lexdb_bind.noPlan()), mdef, outBCols(&outs))
    let pl = MrPlan{inCols: replace(mut &rw.inCols, []), keyX: keyX, keyAt: keyAt, np: len(m.part), desc: desc, nullsFirst: nullsFirst,
                    prog: prog, shown: collections.copyOf(&m.shown), navs: replace(mut &rw.navs, []), defs: defs, defNavs: defNavs, meas: meas,
                    measNavs: measNavs, local: local, rows: m.rows, skip: m.skip, skipSet: skipSet, outs: outs, outFrom: outFrom,
                    dialect: d, text: lexdb_sql.mrText(m)}
    append(mut &sel.mr, pl)
    return Ok(Unit{})
}

// The input column an expression is, -1 for any other.
fn colAtOf(x: &Expr, cols: &[]lexdb_sql.ColDef): int {
    match x {
        Expr.Col(n, sl) { return lexdb_bind.colSlot(cols, &n, sl) }
        else { return -1 }
    }
}

// ---- running a MATCH_RECOGNIZE

// What one partition's search reads.
type MrIn = value record {
    pl: &MrPlan
    rows: &[][]Val
    idx: &[]int
    params: &[]Val
    lo: int
    hi: int
}

// What is kept for the match being measured (or the one DEFINE tests): per navigation its set's positions
// (relative to the match's start), running aggregate and FINAL value. single: a DEFINE's test, which looks
// at each navigation once (FIRST and LAST scan the labels, no list is made).
type MrMatch = record {
    s: int
    single: bool
    lists: [][]int
    built: []bool
    accAt: []int
    accs: []Acc
    fed: []int
}

fn newMrMatch(s: int, navs: &[]MrNav, ids: &[]int, single: bool): MrMatch {
    let nn = len(navs)
    var accAt: []int = array(nn, -1)
    var na = 0
    for k in ids {
        if navs[k].kind == NV_AGG && accAt[k] < 0 {
            accAt[k] = na
            na += 1
        }
    }
    var lists: [][]int = []
    for k in 0..nn { append(mut &lists, []) }
    return MrMatch{s: s, single: single, lists: lists, built: array(nn, false), accAt: accAt, accs: lexdb_agg.newAccs(na), fed: array(nn, 0)}
}

// How many rows of nav's set are at or before relative row limit.
fn mrCount(nav: &MrNav, list: &[]int, limit: int): int {
    if limit < 0 { return 0 }
    if len(nav.set) == 0 { return limit + 1 }
    var a = 0
    var b = len(list)
    while a < b {
        let mid = (a + b) / 2
        if list[mid] <= limit { a = mid + 1 } else { b = mid }
    }
    return a
}

fn mrAt(nav: &MrNav, list: &[]int, j: int): int {
    if len(nav.set) == 0 { return j }
    return list[j]
}

// The label of relative row i: lab's, or extra for the one row after them.
fn mrLabAt(lab: &[]int, extra: int, i: int): int { return if i < len(lab) { lab[i] } else { extra } }

// A navigation's argument on one row.
fn mrArgOn(pl: &MrPlan, nav: &MrNav, row: &[]Val, params: &[]Val): Result[Val, DbErr] {
    if nav.col >= 0 { return Ok(row[nav.col].clone()) }
    let noAggs: []Val = []
    let noSubs: []SubRes = []
    let noSeq: Option[SeqEnv] = None
    let env = Env{cols: &pl.inCols, row: row, aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs, seq: &noSeq}
    return eval(&nav.arg, &env)
}

// The value of navigation k in the match whose rows are labelled lab (and extra, if >= 0, for one row more),
// seen up to relative row limit0 (nav.final: the match's last row).
fn mrNavVal(mi: &MrIn, k: int, mm: mut &MrMatch, lab: &[]int, extra: int, limit0: int, mno: int): Result[Val, DbErr] {
    let pl = mi.pl
    let nav = &pl.navs[k]
    let n = len(lab) + (if extra >= 0 { 1 } else { 0 })
    let limit = if nav.final { n - 1 } else { limit0 }
    if nav.kind == NV_MNO { return Ok(Val.Int(mno)) }
    if nav.kind == NV_CLS {
        if limit < 0 || limit >= n { return Ok(Val.Null) }
        return Ok(Val.Text(pl.shown[mrLabAt(lab, extra, limit)].clone()))
    }
    var rel = -1
    if mm.single && nav.kind != NV_AGG {
        // looked at once: scan the labels
        if len(nav.set) == 0 {
            if nav.kind == NV_LAST {
                if limit - nav.off >= 0 { rel = limit - nav.off }
            } else if nav.off <= limit {
                rel = nav.off
            }
        } else if nav.kind == NV_LAST {
            var cnt = 0
            var i = limit
            while i >= 0 {
                if nav.set[mrLabAt(lab, extra, i)] {
                    if cnt == nav.off {
                        rel = i
                        break
                    }
                    cnt += 1
                }
                i -= 1
            }
        } else {
            var cnt = 0
            var i = 0
            while i <= limit {
                if nav.set[mrLabAt(lab, extra, i)] {
                    if cnt == nav.off {
                        rel = i
                        break
                    }
                    cnt += 1
                }
                i += 1
            }
        }
        if rel < 0 { return Ok(Val.Null) }
        let t = mm.s + rel + nav.phys
        if t < mi.lo || t >= mi.hi { return Ok(Val.Null) }
        return mrArgOn(pl, nav, &mi.rows[mi.idx[t]], mi.params)
    }
    if len(nav.set) > 0 && !mm.built[k] {
        var list: []int = []
        for i in 0..n { if nav.set[mrLabAt(lab, extra, i)] { append(mut &list, i) } }
        mm.lists[k] = list
        mm.built[k] = true
    }
    let c = mrCount(nav, &mm.lists[k], limit)
    if nav.kind == NV_AGG {
        let a = mm.accAt[k]
        if mm.fed[k] > c {
            var fresh = lexdb_agg.newAccs(1)
            mm.accs[a] = pop(mut &fresh)
            mm.fed[k] = 0
        }
        let noAggs: []Val = []
        let noSubs: []SubRes = []
        while mm.fed[k] < c {
            let r = mrAt(nav, &mm.lists[k], mm.fed[k])
            let noSeq: Option[SeqEnv] = None
            let env = Env{cols: &pl.inCols, row: &mi.rows[mi.idx[mm.s + r]], aggs: &noAggs, params: mi.params, subs: &noSubs, cur: &noAggs, seq: &noSeq}
            try accumulate(&nav.spec, mut &mm.accs[a], &env)
            mm.fed[k] += 1
        }
        let v = try lexdb_agg.finish(&nav.spec, &mm.accs[a])
        match nav.wrap {
            Some(w) {
                let one: []Val = [v]
                let noSeq: Option[SeqEnv] = None
                let env = Env{cols: &pl.inCols, row: &noAggs, aggs: &one, params: mi.params, subs: &noSubs, cur: &noAggs, seq: &noSeq}
                return eval(&w, &env)
            }
            None { return Ok(v) }
        }
    }
    if nav.kind == NV_LAST {
        let j = c - 1 - nav.off
        if j >= 0 { rel = mrAt(nav, &mm.lists[k], j) }
    } else if nav.off < c {
        rel = mrAt(nav, &mm.lists[k], nav.off)
    }
    if rel < 0 { return Ok(Val.Null) }
    let t = mm.s + rel + nav.phys
    if t < mi.lo || t >= mi.hi { return Ok(Val.Null) }
    return mrArgOn(pl, nav, &mi.rows[mi.idx[t]], mi.params)
}

fn mrEvalSlots(mi: &MrIn, x: &Expr, ids: &[]int, mm: mut &MrMatch, lab: &[]int, extra: int, limit: int, mno: int,
               slots: mut &[]Val): Result[Val, DbErr] {
    for k in ids { slots[k] = try mrNavVal(mi, k, mm, lab, extra, limit, mno) }
    let noRow: []Val = []
    let noSubs: []SubRes = []
    let noSeq: Option[SeqEnv] = None
    let env = Env{cols: &mi.pl.inCols, row: &noRow, aggs: slots, params: mi.params, subs: &noSubs, cur: &noRow, seq: &noSeq}
    return eval(x, &env)
}

// Whether variable v's DEFINE holds on row pos, rows s .. pos-1 labelled lab and pos labelled v.
fn mrHolds(mi: &MrIn, v: int, pos: int, lab: &[]int, s: int, mno: int, slots: mut &[]Val): Result[bool, DbErr] {
    let pl = mi.pl
    match pl.defs[v] {
        None { return Ok(true) }
        Some(cond) {
            let ids = &pl.defNavs[v]
            var r = Val.Null
            if pl.local {
                // every navigation reads the row being tested (or one near it)
                for k in ids {
                    let nv = &pl.navs[k]
                    if nv.kind == NV_CLS {
                        slots[k] = Val.Text(pl.shown[v].clone())
                        continue
                    }
                    let t = pos + nv.phys
                    slots[k] = if t < mi.lo || t >= mi.hi { Val.Null } else { try mrArgOn(pl, nv, &mi.rows[mi.idx[t]], mi.params) }
                }
                let noRow: []Val = []
                let noSubs: []SubRes = []
                let noSeq: Option[SeqEnv] = None
                let env = Env{cols: &pl.inCols, row: &noRow, aggs: slots, params: mi.params, subs: &noSubs, cur: &noRow, seq: &noSeq}
                r = try eval(&cond, &env)
            } else {
                var mm = newMrMatch(s, &pl.navs, ids, true)
                r = try mrEvalSlots(mi, &cond, ids, mut &mm, lab, v, pos - s, mno + 1, slots)
            }
            return Ok(lexdb_ops.truth(&r) == Some(true))
        }
    }
}

fn mrAttempt(mi: &MrIn, m: mut &lexdb_match.Matcher, s: int, mno: int, rs: mut &Run, slots: mut &[]Val): Result[lexdb_match.Found, DbErr] {
    let maxSteps = rs.maxSteps
    let holds = fn(v: int, pos: int, lab: &[]int): Result[bool, DbErr] { return mrHolds(mi, v, pos, lab, s, mno, mut &slots) }
    let tick = fn(): Result[Unit, DbErr] { return rs.bud.tick() }
    return m.attempt(&mi.pl.prog, mi.lo, mi.hi, s, mi.pl.local, maxSteps, holds, tick)
}

// One output row: the input row's columns and the measures' values.
fn mrPush(mi: &MrIn, row: &[]Val, mv: &[]Val, out: mut &[][]Val, rs: mut &Run): Result[Unit, DbErr] {
    try rs.bud.tick()
    var o: []Val = withCapacity(len(mi.pl.outFrom))
    for f in mi.pl.outFrom { append(mut &o, if f >= 0 { row[f].clone() } else if len(mv) > 0 { mv[-1 - f].clone() } else { Val.Null }) }
    try rs.bud.hold(lexdb_pipe.rowBytes(&o))
    append(out, o)
    return Ok(Unit{})
}

fn mrMeasures(mi: &MrIn, mm: mut &MrMatch, lab: &[]int, limit: int, mno: int, slots: mut &[]Val): Result[[]Val, DbErr] {
    var mv: []Val = []
    for i in 0..len(mi.pl.meas) { append(mut &mv, try mrEvalSlots(mi, &mi.pl.meas[i], &mi.pl.measNavs[i], mm, lab, -1, limit, mno, slots)) }
    return Ok(mv)
}

fn mrSteps(pl: &MrPlan, rs: &Run): DbErr {
    return mrErr(pl.dialect, 20000, &("MATCH_RECOGNIZE: the search from one row took more than max_match_steps (" + rs.maxSteps.toStr() +
                 ") steps; SET max_match_steps = n to allow more, 0 for no limit"), "54001", 0,
                 &("MATCH_RECOGNIZE: the search from one row took more than max_match_steps (" + rs.maxSteps.toStr() +
                 ") steps; SET max_match_steps = n to allow more, 0 for no limit"))
}

// One partition, rows lo .. hi-1 of the sorted rows.
fn mrPartition(mi: &MrIn, rs: mut &Run, out: mut &[][]Val, heldM: mut &int): Result[Unit, DbErr] {
    let pl = mi.pl
    let lo = mi.lo
    let hi = mi.hi
    var m = lexdb_match.newMatcher()
    var slots: []Val = array(len(pl.navs), Val.Null)
    var allIds: []int = []
    for ids in pl.measNavs { for k in ids { append(mut &allIds, k) } }
    var mno = 0
    var s = lo
    var covered = lo
    m.reset(s)
    let none: []Val = []
    while s < hi {
        let f = try mrAttempt(mi, mut &m, s, mno, rs, mut &slots)
        let b = m.bytes()
        if b > heldM {
            try rs.bud.hold(b - heldM)
            heldM = b
        }
        if f.over { return Err(mrSteps(pl, rs)) }
        if !f.ok {
            if pl.rows == lexdb_sql.MR_UNMATCHED && s >= covered { try mrPush(mi, &mi.rows[mi.idx[s]], &none, out, rs) }
            s += 1
            continue
        }
        mno += 1
        let n = len(f.lab)
        let e = s + n
        var mm = newMrMatch(s, &pl.navs, &allIds, false)
        if pl.rows == lexdb_sql.MR_ONE {
            let mv = try mrMeasures(mi, mut &mm, &f.lab, n - 1, mno, mut &slots)
            try mrPush(mi, &mi.rows[mi.idx[s]], &mv, out, rs)
        } else if n == 0 {
            if pl.rows != lexdb_sql.MR_OMIT {
                let mv = try mrMeasures(mi, mut &mm, &f.lab, -1, mno, mut &slots)
                try mrPush(mi, &mi.rows[mi.idx[s]], &mv, out, rs)
            }
        } else {
            for r in 0..n {
                if f.exc[r] { continue }
                let mv = try mrMeasures(mi, mut &mm, &f.lab, r, mno, mut &slots)
                try mrPush(mi, &mi.rows[mi.idx[s + r]], &mv, out, rs)
            }
        }
        if e > covered { covered = e }
        var next = s + 1
        if pl.skip == lexdb_sql.SKIP_PAST {
            next = if n > 0 { e } else { s + 1 }
        } else if (pl.skip == lexdb_sql.SKIP_FIRST || pl.skip == lexdb_sql.SKIP_LAST) && n > 0 {
            // (an empty match has no rows to skip to: the next row, as Oracle)
            var at = -1
            for r in 0..n {
                if pl.skipSet[f.lab[r]] {
                    if at < 0 || pl.skip == lexdb_sql.SKIP_LAST { at = r }
                }
            }
            if at < 0 {
                return Err(mrErr(pl.dialect, 62514, "AFTER MATCH SKIP TO variable is not bounded in the match found.", "22000", 0,
                                 "AFTER MATCH SKIP TO variable is not bounded in the match found"))
            }
            if at == 0 {
                return Err(mrErr(pl.dialect, 62517, "Next match starts at the same point last match started.", "22000", 0,
                                 "next match starts at the same point the last match started"))
            }
            next = s + at
        }
        s = next
        m.reset(s)
    }
    return Ok(Unit{})
}

fn execMatch(pl: &MrPlan, r: &Res, params: &[]Val, rs: mut &Run): Result[Res, DbErr] {
    let rows = &r.rows
    let n = len(rows)
    let nk = len(pl.keyX)
    let noAggs: []Val = []
    let noSubs: []SubRes = []
    var kv: [][]Val = []
    for j in 0..nk {
        var col: []Val = withCapacity(n)
        for i in 0..n {
            try rs.bud.tick()
            if pl.keyAt[j] >= 0 {
                append(mut &col, rows[i][pl.keyAt[j]].clone())
            } else {
                let noSeq: Option[SeqEnv] = None
                let env = Env{cols: &pl.inCols, row: &rows[i], aggs: &noAggs, params: params, subs: &noSubs, cur: &noAggs, seq: &noSeq}
                append(mut &col, try eval(&pl.keyX[j], &env))
            }
        }
        append(mut &kv, col)
    }
    var idx: []int = withCapacity(n)
    for i in 0..n { append(mut &idx, i) }
    if nk > 0 {
        let np = pl.np
        collections.sortBy(mut &idx, fn(a: &int, b: &int): int {
            for j in 0..nk {
                let x = &kv[j][a]
                let y = &kv[j][b]
                var c = 0
                if j < np {
                    c = lexdb_sort.sortCmp(x, y)
                } else {
                    let nx = lexdb_ops.isNull(x)
                    let ny = lexdb_ops.isNull(y)
                    if nx && ny { continue }
                    if nx { return if pl.nullsFirst[j - np] { -1 } else { 1 } }
                    if ny { return if pl.nullsFirst[j - np] { 1 } else { -1 } }
                    c = lexdb_sort.sortCmp(x, y)
                    if pl.desc[j - np] { c = -c }
                }
                if c != 0 { return c }
            }
            return a - b
        })
    }
    var out: [][]Val = []
    var heldM = 0
    var lo = 0
    while lo < n {
        var hi = lo + 1
        while hi < n {
            var brk = false
            for j in 0..pl.np { if lexdb_sort.sortCmp(&kv[j][idx[hi - 1]], &kv[j][idx[hi]]) != 0 { brk = true } }
            if brk { break }
            hi += 1
        }
        let mi = MrIn{pl: pl, rows: rows, idx: &idx, params: params, lo: lo, hi: hi}
        try mrPartition(&mi, rs, mut &out, mut &heldM)
        lo = hi
    }
    return Ok(Res{cols: copyOuts(&pl.outs), rows: out, tag: "", hasRows: true, copy: COPY_NONE})
}

fn copyOuts(os: &[]OutCol): []OutCol {
    var out: []OutCol = []
    for o in os { append(mut &out, o.clone()) }
    return out
}

// The columns a FROM subquery presents: a MATCH_RECOGNIZE's output, else its select list.
fn fromCols(sel: &Sel): &[]OutCol {
    if len(sel.mr) > 0 { return &sel.mr[0].outs }
    return &sel.outs
}

// The expression and type helpers now in the language model.

// ---- the catalog: its encoding and readers are lexdb_catalog's (4a)

fn decTable(name: &str, s: &str): Result[Table, DbErr] { return lexdb_catalog.decTable(name, s, lexdb_parse.parseExpr) }
fn catScan(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, lo: &str, hi: &str, pre: &str,
           f: &fn(&lexdb_store.Entry): bool): Result[Unit, DbErr] { return lexdb_catalog.catScan(st, txn, lo, hi, pre, f) }
fn seenTables(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]Table, DbErr] {
    return lexdb_catalog.seenTables(st, txn, lexdb_parse.parseExpr)
}
fn allTables(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]Table, DbErr] { return lexdb_catalog.allTables(st, txn, lexdb_parse.parseExpr) }
fn catSnap(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[CatSnap, DbErr] {
    let naming = lexdb_pg.naming()
    return lexdb_catalog.catSnap(st, txn, lexdb_parse.parseExpr, &naming)
}

// ---- the planner's vocabulary (lexdb_plan; the search moves there next)

type Path = lexdb_plan.Path
type Bound = lexdb_plan.Bound
type Look = lexdb_plan.Look
type Cmp = lexdb_plan.Cmp
type EqClass = lexdb_plan.EqClass
type BindCol = lexdb_plan.BindCol
type WayCand = lexdb_plan.WayCand
type Way = lexdb_plan.Way
type Est = lexdb_stats.Est
type Fig = lexdb_plan.Fig


// ---- stored procedures and functions (design/lexdb-dialect-gaps.md, package F). lexdb_routine keeps them in the catalog and
// writes PostgreSQL's SQL functions into the queries that call them; here a statement makes, drops and calls them, in the
// session's transaction. T-SQL's procedures are run by lexdb_tsql, which finds them with Session.routines.

type Routine = lexdb_sql.Routine

// The routines of a dialect that a name means: qualified, in its schema; else in the first schema of the search path that
// has one.
fn routinesIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, dialect: int, name: &str): Result[[]Routine, DbErr] {
    if lexdb_sql.isQual(name) || dialect == lexdb_sql.RD_TSQL { return lexdb_routine.find(st, txn, dialect, name) }
    let path: []str = if len(txn.sql.path) == 0 { ["public"] } else { txn.sql.path.clone() }
    for sc in path {
        let found = try lexdb_routine.find(st, txn, dialect, &lexdb_sql.qual(&sc, name))
        if len(found) > 0 { return Ok(found) }
    }
    return Ok([])
}

pub fn (s: mut &Session) routines(dialect: int, name: &str): Result[[]Routine, DbErr] {
    if len(s.txn) > 0 { return routinesIn(&s.st, mut &s.txn[0], dialect, name) }
    var t = try s.st.beginSnapshot()
    s.setUp(mut &t)
    let r = routinesIn(&s.st, mut &t, dialect, name)
    s.st.abort(t)
    return r
}

// Every routine of a dialect.
pub fn (s: mut &Session) allRoutines(dialect: int): Result[[]Routine, DbErr] {
    if len(s.txn) > 0 { return lexdb_routine.ofDialect(&s.st, mut &s.txn[0], dialect) }
    var t = try s.st.beginSnapshot()
    s.setUp(mut &t)
    let r = lexdb_routine.ofDialect(&s.st, mut &t, dialect)
    s.st.abort(t)
    return r
}

fn createRoutine(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    if len(s.rtn) == 0 { return Err(e("XX000", "no routine")) }
    var r = s.rtn[0].clone()
    let proc = r.kind == lexdb_sql.RK_PROC
    if r.dialect == lexdb_sql.RD_PG {
        if r.lang != "sql" { return Err(e("42704", &("language \"" + r.lang + "\" does not exist"))) }
        // the body's syntax (PostgreSQL also resolves its names: lexdb reads them where it runs)
        let stmts = try lexdb_parse.parse(&r.body)
        if !proc && r.ret.oid != 2278 {
            var ok = len(stmts) > 0
            if ok {
                let l = &stmts[len(stmts) - 1]
                ok = l.kind == lexdb_sql.S_SELECT || ((l.kind == lexdb_sql.S_INSERT || l.kind == lexdb_sql.S_UPDATE || l.kind == lexdb_sql.S_DELETE) && len(l.items) > 0)
            }
            if !ok {
                var d = e("42P13", &("return type mismatch in function declared to return " + lexdb_pgcat.formatType(r.ret.oid, -1)))
                d.detail = "Function's final statement must be SELECT or INSERT/UPDATE/DELETE RETURNING."
                return Err(d)
            }
        }
    }
    r.key = try createKey(st, txn, &r.key, false)
    try needCreate(st, txn, &r.key)
    r.owner = currentRole(st, txn.sql.sess)
    let taken = r.dialect == lexdb_sql.RD_TSQL && (try relExists(st, txn, &r.key))
    if r.dialect == lexdb_sql.RD_TSQL && taken && s.ifFlag {
        // ALTER, OR ALTER of a table or a view
        return Err(e("TS2010", &("Cannot perform alter on '" + lexdb_sql.baseName(&r.key) + "' because it is an incompatible object type.")))
    }
    if s.alias == "alter" && len(try lexdb_routine.find(st, txn, r.dialect, &r.key)) == 0 {
        return Err(e("TS208", &("Invalid object name '" + lexdb_sql.baseName(&r.key) + "'.")))
    }
    try lexdb_routine.create(st, txn, &r, s.ifFlag, taken)
    if r.dialect == lexdb_sql.RD_PG { lexdb_routine.noteFunction(st, &lexdb_sql.baseName(&r.key)) }
    try bumpCatalog(st, txn)
    return Ok(tagOnly(if proc { "CREATE PROCEDURE" } else { "CREATE FUNCTION" }))
}

fn dropRoutine(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[Res, DbErr] {
    let w = try whoNow(st, txn)
    let dialect = if s.mdialect == lexdb_sql.MD_TSQL { lexdb_sql.RD_TSQL } else { lexdb_sql.RD_PG }
    for i in 0..len(s.names) {
        let parts = strings.split(&s.names[i], "\x00")
        var key = parts[0].toStr()
        // a bare name: in the first schema of the path that has one
        if dialect == lexdb_sql.RD_PG && !lexdb_sql.isQual(&key) {
            let have = try routinesIn(st, txn, dialect, &key)
            if len(have) > 0 { key = have[0].key.clone() }
        }
        if dialect == lexdb_sql.RD_TSQL && (try relExists(st, txn, &key)) && len(try lexdb_routine.find(st, txn, dialect, &key)) == 0 {
            // a table or view under DROP PROCEDURE's name
            var isView = false
            match try findTable(st, txn, &key) {
                Some(t) { isView = len(t.view) > 0 }
                None {}
            }
            let nm = lexdb_sql.baseName(&key)
            let what = if isView { "view. Use DROP VIEW." } else { "table. Use DROP TABLE." }
            return Err(e("TS3705", &("Cannot use DROP " + strings.toUpperAscii(&s.index) + " with '" + nm + "' because '" + nm + "' is a " + what)))
        }
        let d = try lexdb_routine.dropOne(st, txn, dialect, &key, &parts[1], &s.index, &s.spells[i], s.ifFlag, fn(o: int): str { return lexdb_pgcat.formatType(o, -1) }, &w.roles, w.super)
        if len(d.notice) > 0 { notice(st, txn, &"00000", &d.notice, &"") }
    }
    try bumpCatalog(st, txn)
    return Ok(tagOnly(if s.index == "procedure" { "DROP PROCEDURE" } else if s.index == "function" { "DROP FUNCTION" } else { "DROP ROUTINE" }))
}

// The text PostgreSQL gives an argument's type in "procedure p(integer) does not exist": what the value shows of it.
fn argTypeName(v: &Val): str {
    match v {
        Val.Int(n) { return if n >= -2147483648 && n <= 2147483647 { "integer" } else { "bigint" } }
        Val.Bool(_) { return "boolean" }
        Val.Num(_) { return "numeric" }
        else { return "unknown" }
    }
}

// One row of values of the expressions xs, run as SELECT in the call's own parameters.
fn (s: mut &Session) valuesOf(xs: &[]Expr, call: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int): Result[[]Val, DbErr] {
    if len(xs) == 0 { return Ok([]) }
    var sel = lexdb_sql.newStmt(lexdb_sql.S_SELECT)
    for x in xs { append(mut &sel.items, lexdb_sql.SelItem{star: false, qual: "", expr: Some(lexdb_sql.cloneExpr(&x)), alias: "", spell: ""}) }
    sel.subs = call.subs.clone()
    sel.wins = call.wins.clone()
    sel.params = call.params
    sel.seqNames = call.seqNames.clone()
    var r = try s.run(&sel, params, ptypes)
    if len(r.rows) == 0 { return Ok([]) }
    return Ok(replace(mut &r.rows[0], []))
}

// The tables a body's statements read or write (their subqueries' too).
fn bodyTables(stmts: &[]lexdb_sql.Stmt, out: mut &[]str) {
    for st in stmts {
        if (st.kind == lexdb_sql.S_INSERT || st.kind == lexdb_sql.S_UPDATE || st.kind == lexdb_sql.S_DELETE) && len(st.table) > 0 { append(out, st.table.clone()) }
        for f in st.from { if f.sub < 0 && len(f.table) > 0 { append(out, f.table.clone()) } }
        bodyTables(&st.subs, out)
        bodyTables(&st.inner, out)
    }
}

// CALL name(arguments): PostgreSQL's procedure, its SQL body run in the transaction the call is in (or one of its own: all of
// it or none), the values of its OUT and INOUT parameters its result row.
fn (s: mut &Session) callRoutine(stmt: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int): Result[Res, DbErr] {
    let none: []Val = []
    let nt: []int = []
    let args: []Expr = if len(stmt.rows) > 0 { stmt.rows[0].clone() } else { [] }
    let cands = try s.routines(lexdb_sql.RD_PG, &stmt.table)
    let vals = try s.valuesOf(&args, stmt, params, ptypes)
    var best = -1
    var bestScore = -1
    var isFunc = ""
    for ci in 0..len(cands) {
        let c = &cands[ci]
        let sl = lexdb_routine.slots(c, len(args), &stmt.names)
        if sl.isNone() { continue }
        if c.kind != lexdb_sql.RK_PROC {
            isFunc = c.key.clone()
            continue
        }
        var score = 0
        let sx = sl.unwrap()
        for i in 0..len(c.params) { if sx[i] >= 0 && lexdb_routine.kindFits(&vals[sx[i]], &c.params[i].typ) { score += 1 } }
        if score > bestScore {
            best = ci
            bestScore = score
        }
    }
    let base = if len(stmt.spell) > 0 { stmt.spell.clone() } else { lexdb_sql.baseName(&stmt.table) }
    if best < 0 {
        var ts: []str = []
        for v in vals { append(mut &ts, argTypeName(&v)) }
        if len(isFunc) > 0 { return Err(e("42809", &(base + "(" + strings.join(&ts, ", ") + ") is not a procedure"))) }
        var d = e("42883", &("procedure " + base + "(" + strings.join(&ts, ", ") + ") does not exist"))
        d.hint = "No procedure matches the given name and argument types. You might need to add explicit type casts."
        return Err(d)
    }
    let r = cands[best].clone()
    let sl = lexdb_routine.slots(&r, len(args), &stmt.names).unwrap()
    var ins: []Val = []
    var inTypes: []int = []
    for i in 0..len(r.params) {
        let p = &r.params[i]
        if p.mode == "out" { continue }
        var v = Val.Null
        if sl[i] >= 0 {
            v = vals[sl[i]].clone()
        } else if p.has {
            let de = try lexdb_parse.parseExpr(&p.dflt)
            let dv = try s.valuesOf(&[de], &lexdb_sql.newStmt(lexdb_sql.S_SELECT), &none, &nt)
            if len(dv) > 0 { v = dv[0].clone() }
        }
        append(mut &ins, try lexdb_ops.coerce(v, &p.typ))
        append(mut &inTypes, p.typ.oid)
    }
    // the body, its parameters named as $n unless a column of a table it reads has the name
    let first = try lexdb_parse.parse(&r.body)
    var tabs: []str = []
    bodyTables(&first, mut &tabs)
    var skip: []str = []
    for t in tabs {
        match s.tableColumns(&t) {
            Ok(cols) { for c in cols { append(mut &skip, c.name.clone()) } }
            Err(_) {}
        }
    }
    let text = try lexdb_routine.bindNames(&r.body, &lexdb_sql.baseName(&r.key), &r, &skip)
    let body = try lexdb_parse.parse(&text)
    let own = len(s.txn) == 0
    if own { let b = try s.run(&lexdb_sql.newStmt(lexdb_sql.S_BEGIN), &none, &nt) }
    var last: Option[Res] = None
    for b in body {
        match s.run(&b, &ins, &inTypes) {
            Ok(res) { last = Some(res) }
            Err(x) {
                if own { let rb = s.run(&lexdb_sql.newStmt(lexdb_sql.S_ROLLBACK), &none, &nt) }
                return Err(x)
            }
        }
    }
    if own { let c = try s.run(&lexdb_sql.newStmt(lexdb_sql.S_COMMIT), &none, &nt) }
    var outs: []int = []
    for i in 0..len(r.params) { if r.params[i].mode == "out" || r.params[i].mode == "inout" { append(mut &outs, i) } }
    if len(outs) == 0 { return Ok(tagOnly("CALL")) }
    var cols: []OutCol = []
    var row: []Val = []
    var got: []Val = []
    match last {
        Some(res) { if len(res.rows) > 0 { got = res.rows[0].clone() } }
        None {}
    }
    for k in 0..len(outs) {
        let p = &r.params[outs[k]]
        append(mut &cols, OutCol{name: p.name.clone(), oid: p.typ.oid, spell: "", coll: "", scale: 0})
        append(mut &row, if k < len(got) { got[k].clone() } else { Val.Null })
    }
    return Ok(Res{cols: cols, rows: [row], tag: "CALL", hasRows: true, copy: COPY_NONE})
}

// The names of PostgreSQL's SQL functions (lexdb_routine keeps the list once known: a function made adds to it),
// cached in the session until lexdb_routine's generation moves.
fn (s: mut &Session) functionNames(): Result[[]str, DbErr] {
    if s.fnGen == lexdb_routine.namesGen() { return Ok(s.fnNames.clone()) }
    match lexdb_routine.knownNames(&s.st) {
        Some(ns) {
            s.fnNames = ns.clone()
            s.fnGen = lexdb_routine.namesGen()
            return Ok(ns)
        }
        None {}
    }
    // (the catalog as this session sees it, then the names made meanwhile that it cannot see yet: loadNames)
    var cat: []str = []
    for r in try s.allRoutines(lexdb_sql.RD_PG) { append(mut &cat, lexdb_sql.baseName(&r.key)) }
    let ns = lexdb_routine.loadNames(&s.st, cat)
    s.fnNames = ns.clone()
    s.fnGen = lexdb_routine.namesGen()
    return Ok(ns)
}

// The columns CALL gives: the OUT and INOUT parameters of its procedure (none: a command, no rows).
fn (s: mut &Session) callCols(stmt: &lexdb_sql.Stmt): Result[[]OutCol, DbErr] {
    let nargs = if len(stmt.rows) > 0 { len(stmt.rows[0]) } else { 0 }
    let cands = try s.routines(lexdb_sql.RD_PG, &stmt.table)
    for c in cands {
        if c.kind != lexdb_sql.RK_PROC || lexdb_routine.slots(&c, nargs, &stmt.names).isNone() { continue }
        var cols: []OutCol = []
        for p in c.params {
            if p.mode == "out" || p.mode == "inout" { append(mut &cols, OutCol{name: p.name.clone(), oid: p.typ.oid, spell: "", coll: "", scale: 0}) }
        }
        return Ok(cols)
    }
    var ts: []str = []
    for i in 0..nargs { append(mut &ts, "unknown") }
    let base = if len(stmt.spell) > 0 { stmt.spell.clone() } else { lexdb_sql.baseName(&stmt.table) }
    return Err(e("42883", &("procedure " + base + "(" + strings.join(&ts, ", ") + ") does not exist")))
}

// The statement with PostgreSQL's SQL functions it calls written as their bodies; None when it calls none.
fn (s: mut &Session) inlineFunctions(stmt: &lexdb_sql.Stmt): Result[Option[lexdb_sql.Stmt], DbErr] {
    // (no function known, as of the generation the session saw: nothing to look at; the usual case, a point select's)
    if s.fnGen == lexdb_routine.namesGen() && len(s.fnNames) == 0 { return Ok(None) }
    let names = try s.functionNames()
    if len(names) == 0 || !lexdb_routine.callsAny(stmt, &names) { return Ok(None) }
    let fns = try s.allRoutines(lexdb_sql.RD_PG)
    let path: []str = if len(s.path) == 0 { ["public"] } else { s.path.clone() }
    return lexdb_routine.inlineCalls(stmt, &fns, &path)
}
