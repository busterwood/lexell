// lexdb_tsqlparse: a T-SQL batch's own statements (design/lexdb-tds.md).
//
// DECLARE, SET @v = ..., SET options, and transaction control (BEGIN TRAN,
// COMMIT, ROLLBACK, SAVE TRAN) are read here; every other statement, and
// every expression and type name in these, is lexdb's grammar, read by
// lexdb_sql in T-SQL mode (@variables, [names], N'...', SQL Server's type
// names) through its Parser. The control of flow S4 adds (IF, WHILE,
// TRY ... CATCH, procedures) belongs here too.
//
// A batch is parsed whole before any of it runs, as SQL Server compiles
// one: a syntax error anywhere runs none of it. lexdb_tsql runs what this
// gives.

import "strings"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_parse"
import "./lexdb_udf"
import "./lexdb_routine"

type DbErr = lexdb_base.DbErr
type TypeName = lexdb_sql.TypeName
type Stmt = lexdb_sql.Stmt
type Expr = lexdb_sql.Expr
type Parser = lexdb_parse.Parser

pub const TS_SQL = 1        // a statement of lexdb's parser: stmt[0]
pub const TS_DECLARE = 2    // DECLARE: names and types; stmt: the initialisers, as SELECT @v = expr
pub const TS_SETOPT = 3     // SET options value: names (lower case) and value
pub const TS_BEGIN = 4      // BEGIN TRAN[SACTION] [name]
pub const TS_COMMIT = 5     // COMMIT [TRAN[SACTION] | WORK] [name]
pub const TS_ROLLBACK = 6   // ROLLBACK [TRAN[SACTION] | WORK] [name]: names[0] the name, if any
pub const TS_SAVE = 7       // SAVE TRAN[SACTION] name: names[0]
// control of flow (S4)
pub const TS_IF = 8         // IF: stmt[0] the condition (SELECT 1 or 0); body, else els
pub const TS_WHILE = 9      // WHILE: stmt[0] the condition; body
pub const TS_BLOCK = 10     // BEGIN ... END: body
pub const TS_TRY = 11       // BEGIN TRY body END TRY BEGIN CATCH els END CATCH
pub const TS_BREAK = 12
pub const TS_CONTINUE = 13
pub const TS_RETURN = 14
pub const TS_PRINT = 15     // stmt[0]: SELECT the message
pub const TS_RAISERROR = 16 // stmt[0]: SELECT message, severity, state, arguments ...
pub const TS_THROW = 17     // stmt[0]: SELECT number, message, state; none: the error being handled again
pub const TS_TABLEVAR = 18  // DECLARE @t TABLE (...): names[0] @t; stmt[0] its CREATE TABLE (of #@t)
// (design/lexdb-tds.md, section 13)
pub const TS_USE = 19       // USE database: names[0]
pub const TS_EXECSTR = 20   // EXEC (string): stmt[0] SELECT the string
pub const TS_EXEC = 21      // EXEC [@r =] procedure args: names[0] the procedure (its last part); stmt[0] SELECT the
                            // arguments; names[1 + i] argument i's parameter name ("" positional); value: per
                            // argument, the variable an OUTPUT one sets ("" none), \x1f between them; key: the
                            // procedure's catalog key (dbo as public); ret: the variable @r takes its return code
                            // ("" none); flags: the places of the arguments that are DEFAULT
pub const TS_INSERTEXEC = 22 // INSERT [INTO] t [(columns)] EXEC ...: names[0] the table, names[1..] its columns; body[0] the EXEC
// (design/lexdb-tds.md, section 14)
pub const TS_INSERTBULK = 23 // INSERT BULK t (column type, ...) [WITH (...)]: names[0] the table, names[1..] the columns (folded),
                             // types theirs; value: the options kept (keep_nulls, tablock, check_constraints, fire_triggers),
                             // a space between

pub type TStmt = record {
    pub kind: int
    pub stmt: []Stmt
    pub names: []str
    pub types: []TypeName
    pub value: str          // TS_SETOPT: the value
    pub body: []TStmt       // TS_IF, TS_WHILE, TS_BLOCK, TS_TRY: the statements run
    pub els: []TStmt        // TS_IF's ELSE, TS_TRY's CATCH
    pub key: str            // TS_EXEC: the procedure's catalog key
    pub ret: str            // TS_EXEC: the variable of EXEC @r = ...
    pub flags: []int        // TS_EXEC: the arguments that are DEFAULT
    pub line: int           // the line of the batch (from 1) it starts on, SQL Server's line of its errors; 0 not known
}

// A parsed batch: its statements, and its variables (those given, then
// those it declares, in order) with the declared ones' types.
pub type TBatch = record {
    pub stmts: []TStmt
    pub vars: []str
    pub types: []TypeName
}

// The SET options T-SQL has (and lexdb_dialect, lexdb's own).
const SET_OPTIONS: []str = ["quoted_identifier", "ansi_nulls", "ansi_padding", "ansi_warnings", "arithabort",
    "arithignore", "concat_null_yields_null", "numeric_roundabort", "ansi_null_dflt_on", "ansi_null_dflt_off",
    "cursor_close_on_commit", "implicit_transactions", "textsize", "nocount", "xact_abort", "lock_timeout",
    "deadlock_priority", "language", "dateformat", "datefirst", "rowcount", "no_browsetable", "fmtonly",
    "query_governor_cost_limit", "ansi_defaults", "forceplan", "statistics", "showplan_text", "showplan_all",
    "showplan_xml", "parseonly", "noexec", "context_info", "lexdb_dialect"]

fn isSetOption(w: &str): bool {
    for o in SET_OPTIONS { if o == w { return true } }
    return false
}

fn tstmt(kind: int): TStmt { return TStmt{kind: kind, stmt: [], names: [], types: [], value: "", body: [], els: [], key: "", ret: "", flags: [], line: 0} }

// Statements to the END that closes their block (not read).
fn block(q: mut &Parser, types: mut &[]TypeName): Result[[]TStmt, DbErr] {
    var out: []TStmt = []
    while true {
        while q.acceptKw(";") {}
        if q.isKw("end") { break }
        if q.peek().kind == lexdb_parse.T_EOF { return Err(lexdb_base.err("42601", "syntax error at end of input")) }
        append(mut &out, try tsqlStmt(q, types))
    }
    return Ok(out)
}

// One statement where IF, ELSE and WHILE take one.
fn single(q: mut &Parser, types: mut &[]TypeName): Result[TStmt, DbErr] {
    while q.acceptKw(";") {}
    return tsqlStmt(q, types)
}

// Whether the next token ends a statement with nothing after it (THROW, RETURN).
fn atEnd(q: &Parser): bool {
    let t = q.peek().clone()
    return t.kind == lexdb_parse.T_EOF || (t.kind == lexdb_parse.T_OP && t.text == ";") || (t.kind == lexdb_parse.T_IDENT && (t.text == "end" || t.text == "else"))
}

// An optional transaction or savepoint name after BEGIN TRAN, COMMIT, ROLLBACK.
fn tranName(q: mut &Parser, names: mut &[]str) {
    let t = q.peek().clone()
    // (a statement's keyword after BEGIN TRAN is the next statement, not the transaction's name: mssql-jdbc's
    // "BEGIN TRAN IF @@TRANCOUNT = 2 COMMIT TRAN")
    if t.kind == lexdb_parse.T_IDENT && (t.text == "if" || t.text == "begin" || t.text == "end" || t.text == "commit" || t.text == "rollback" ||
       t.text == "save" || t.text == "set" || t.text == "declare" || t.text == "while" || t.text == "print" || t.text == "exec" || t.text == "execute" ||
       t.text == "return" || t.text == "merge" || t.text == "use" || t.text == "throw" || t.text == "raiserror" || t.text == "goto" || t.text == "else") {
        return
    }
    if t.kind == lexdb_parse.T_IDENT && !lexdb_sql.isReservedWord(&t.text) || t.kind == lexdb_parse.T_QIDENT || t.kind == lexdb_parse.T_VAR {
        q.skip(1)
        append(names, t.text.clone())
    }
}

// DECLARE @v [AS] type [= expr], ..., after DECLARE.
fn declare(q: mut &Parser, types: mut &[]TypeName): Result[TStmt, DbErr] {
    var ts = tstmt(TS_DECLARE)
    while true {
        let t = q.peek().clone()
        if t.kind != lexdb_parse.T_VAR || strings.startsWith(&t.text, "@@") { return Err(q.unexpected()) }
        q.skip(1)
        let a = q.acceptKw("as")
        if q.isKw("table") || q.isKw("cursor") { return Err(lexdb_base.err("0A000", "DECLARE of a table or cursor variable is not supported yet")) }
        let ty = try q.typeName()
        q.fresh()
        var init: Option[Expr] = None
        if q.acceptKw("=") { init = Some(try q.expr()) }
        if q.hasVar(&t.text) {
            return Err(lexdb_base.err("TS134", &("The variable name '" + t.text + "' has already been declared. Variable names must be unique within a query batch or stored procedure.")))
        }
        q.declare(&t.text)
        append(types, ty)
        append(mut &ts.names, t.text.clone())
        append(mut &ts.types, ty)
        match replace(mut &init, None) {
            Some(e) { append(mut &ts.stmt, q.assign(&t.text, e)) }
            None {}
        }
        if !q.acceptKw(",") { break }
    }
    return Ok(ts)
}

// SET option[, option ...] value, after SET; TRANSACTION ISOLATION LEVEL ... too.
fn setOption(q: mut &Parser): Result[TStmt, DbErr] {
    var ts = tstmt(TS_SETOPT)
    if q.acceptKw("transaction") {
        try q.expectKw("isolation")
        try q.expectKw("level")
        append(mut &ts.names, "transaction isolation level")
        var v = q.next().text
        if v == "read" || v == "repeatable" { v = v + " " + q.next().text }
        ts.value = v
        return Ok(ts)
    }
    while true {
        let t = q.next()
        append(mut &ts.names, t.text.clone())
        if !q.acceptKw(",") { break }
    }
    let v = q.next()
    if v.kind == lexdb_parse.T_EOF { return Err(lexdb_base.err("42601", "syntax error at end of input")) }
    ts.value = if v.kind == lexdb_parse.T_IDENT { v.text.clone() } else { strings.toLowerAscii(&v.text) }
    if v.kind == lexdb_parse.T_OP && v.text == "-" { ts.value = "-" + q.next().text }
    return Ok(ts)
}

// A name of up to four parts ([server.][db.][schema.]name): its parts.
fn multiName(q: mut &Parser): Result[[]str, DbErr] {
    var parts: []str = []
    while true {
        let t = q.peek().clone()
        if t.kind == lexdb_parse.T_IDENT || t.kind == lexdb_parse.T_QIDENT {
            q.skip(1)
            append(mut &parts, if len(t.spell) > 0 { t.spell.clone() } else { t.text.clone() })
        } else if q.isKw(".") {
            append(mut &parts, "")
        } else {
            return Err(q.unexpected())
        }
        if !q.acceptKw(".") { break }
    }
    return Ok(parts)
}

// EXEC|EXECUTE, after it: (string), or [@r =] procedure [arguments].
fn execStmt(q: mut &Parser): Result[TStmt, DbErr] {
    q.fresh()
    if q.acceptKw("(") {
        var e = try q.expr()
        try q.expectKw(")")
        var ts = tstmt(TS_EXECSTR)
        append(mut &ts.stmt, q.values([e]))
        return Ok(ts)
    }
    var ts = tstmt(TS_EXEC)
    let r = q.peek().clone()
    if r.kind == lexdb_parse.T_VAR && q.peekAt(1).kind == lexdb_parse.T_OP && q.peekAt(1).text == "=" {
        ts.ret = r.text.clone()
        q.skip(2)
    }
    let parts = try multiName(q)
    append(mut &ts.names, strings.toLowerAscii(&parts[len(parts) - 1]))
    let sch = if len(parts) >= 2 { strings.toLowerAscii(&parts[len(parts) - 2]) } else { "" }
    ts.key = if sch == "" || sch == "dbo" { strings.toLowerAscii(&parts[len(parts) - 1]) } else { lexdb_sql.qual(&sch, &strings.toLowerAscii(&parts[len(parts) - 1])) }
    var seenNamed = false
    var args: []Expr = []
    var outs: []str = []
    while !atEnd(q) && !(q.peek().kind == lexdb_parse.T_IDENT && lexdb_parse.isTsqlStart(&q.peek().text)) {
        let t = q.peek().clone()
        var pname = ""
        if t.kind == lexdb_parse.T_VAR && q.peekAt(1).kind == lexdb_parse.T_OP && q.peekAt(1).text == "=" {
            pname = t.text.clone()
            q.skip(2)
        }
        var out = ""
        let v = q.peek().clone()
        if len(pname) > 0 { seenNamed = true }
        else if seenNamed {
            return Err(lexdb_base.err("TS119", &("Must pass parameter number " + (len(args) + 1).toStr() + " and subsequent parameters as '@name = value'. After the form '@name = value' has been used, all subsequent parameters must be passed in the form '@name = value'.")))
        }
        if q.acceptKw("default") {
            append(mut &ts.flags, len(args))
            append(mut &args, Expr.Lit(lexdb_sql.Val.Null))
        } else {
            append(mut &args, try q.expr())
            if q.acceptKw("output") || q.acceptKw("out") {
                if v.kind != lexdb_parse.T_VAR {
                    return Err(lexdb_base.err("TS179", "Cannot use the OUTPUT option when passing a constant to a stored procedure."))
                }
                out = v.text.clone()
            }
        }
        append(mut &ts.names, pname)
        append(mut &outs, out)
        if !q.acceptKw(",") { break }
    }
    ts.value = strings.join(&outs, "\x1f")
    // EXEC p ... WITH RECOMPILE
    if q.isKw("with") && q.peekAt(1).kind == lexdb_parse.T_IDENT && q.peekAt(1).text == "recompile" { q.skip(2) }
    append(mut &ts.stmt, q.values(args))
    return Ok(ts)
}

// The hints SQL Server's OPTION (...) takes, by their first word (a word lexdb does not know is SQL Server's 102).
const HINTS: []str = ["maxrecursion", "maxdop", "recompile", "hash", "order", "merge", "concat", "loop", "fast", "force", "keep", "keepfixed",
    "optimize", "use", "querytraceon", "no_performance_spool", "robust", "expand", "ignore_nonclustered_columnstore_index",
    "max_grant_percent", "min_grant_percent", "label", "parameterization", "table", "disable_optimized_plan_forcing", "for"]

// OPTION ( hint, ... ) after a statement, at OPTION: MAXRECURSION n (0 to 32767: 310 past it, 1042 given twice), the
// rest read and taken as they do not change a statement's rows. The MAXRECURSION given, -1 none.
fn optionClause(q: mut &Parser): Result[int, DbErr] {
    q.skip(2)
    var maxrec = -1
    while true {
        let t = q.peek().clone()
        if t.kind != lexdb_parse.T_IDENT { return Err(q.unexpected()) }
        var known = false
        for h in HINTS { if h == t.text { known = true } }
        if !known { return Err(lexdb_base.err("TS102", &("Incorrect syntax near '" + (if len(t.spell) > 0 { t.spell.clone() } else { t.text.clone() }) + "'."))) }
        q.skip(1)
        if t.text == "maxrecursion" {
            let n = q.peek().clone()
            if n.kind != lexdb_parse.T_NUM { return Err(q.unexpected()) }
            q.skip(1)
            let v = strings.parseIntOpt(&n.text).unwrapOr(-1)
            if v < 0 { return Err(lexdb_base.err("TS102", &("Incorrect syntax near '" + n.text + "'."))) }
            if v > 32767 { return Err(lexdb_base.err("TS310", &("The value " + n.text + " specified for the MAXRECURSION option exceeds the allowed maximum of 32767."))) }
            if maxrec >= 0 { return Err(lexdb_base.err("TS1042", "Conflicting maxrecursion optimizer hints specified.")) }
            maxrec = v
        } else {
            // the rest of the hint: words, numbers, = value, (...) lists, up to "," or ")"
            var depth = 0
            while true {
                let x = q.peek().clone()
                if x.kind == lexdb_parse.T_EOF { return Err(q.unexpected()) }
                if depth == 0 && x.kind == lexdb_parse.T_OP && (x.text == "," || x.text == ")") { break }
                if x.kind == lexdb_parse.T_OP && x.text == "(" { depth += 1 }
                if x.kind == lexdb_parse.T_OP && x.text == ")" { depth -= 1 }
                q.skip(1)
            }
        }
        if q.acceptKw(",") { continue }
        try q.expectKw(")")
        break
    }
    return Ok(maxrec)
}

// Whether INSERT [INTO] name [(columns)] EXEC follows.
fn insertExec(q: &Parser): bool {
    var k = 1
    if q.peekAt(k).kind == lexdb_parse.T_IDENT && q.peekAt(k).text == "into" { k += 1 }
    while true {
        let t = q.peekAt(k).clone()
        if !(t.kind == lexdb_parse.T_IDENT || t.kind == lexdb_parse.T_QIDENT) { return false }
        k += 1
        let d = q.peekAt(k).clone()
        if !(d.kind == lexdb_parse.T_OP && d.text == ".") { break }
        k += 1
    }
    if q.peekAt(k).kind == lexdb_parse.T_OP && q.peekAt(k).text == "(" {
        while true {
            k += 1
            let t = q.peekAt(k).clone()
            if t.kind == lexdb_parse.T_EOF { return false }
            if t.kind == lexdb_parse.T_OP && t.text == ")" { break }
        }
        k += 1
    }
    let w = q.peekAt(k).clone()
    return w.kind == lexdb_parse.T_IDENT && (w.text == "exec" || w.text == "execute")
}

// INSERT BULK, after it: the table, its columns as the client will send
// them (name type [COLLATE c] [NULL | NOT NULL]), and WITH's options:
// CHECK_CONSTRAINTS, FIRE_TRIGGERS, KEEP_NULLS, TABLOCK, ROWS_PER_BATCH = n,
// KILOBYTES_PER_BATCH = n, ORDER (column [ASC | DESC], ...). A column named
// twice is SQL Server's 264.
fn insertBulk(q: mut &Parser): Result[TStmt, DbErr] {
    var ts = tstmt(TS_INSERTBULK)
    append(mut &ts.names, try q.tableName())
    try q.expectKw("(")
    while true {
        let c = q.next()
        if c.kind != lexdb_parse.T_IDENT && c.kind != lexdb_parse.T_QIDENT { return Err(lexdb_base.err("42601", &("syntax error at or near \"" + c.text + "\""))) }
        for k in 1..len(ts.names) {
            if ts.names[k] == c.text {
                return Err(lexdb_base.err("TS264", &("The column name '" + (if len(c.spell) > 0 { c.spell.clone() } else { c.text.clone() }) +
                                          "' is specified more than once in the SET clause or column list of an INSERT. A column cannot be assigned more than one value in the same clause. Modify the clause to make sure that a column is updated only once. If this statement updates or inserts columns into a view, column aliasing can conceal the duplication in your code.")))
            }
        }
        append(mut &ts.names, c.text.clone())
        append(mut &ts.types, try q.typeName())
        if q.acceptKw("collate") { let coll = q.next() }
        if q.acceptKw("not") { try q.expectKw("null") } else { let n = q.acceptKw("null") }
        if !q.acceptKw(",") { break }
    }
    try q.expectKw(")")
    var opts: []str = []
    if q.acceptKw("with") {
        try q.expectKw("(")
        while true {
            let o = q.peek().clone()
            if o.kind != lexdb_parse.T_IDENT { return Err(q.unexpected()) }
            if o.text == "check_constraints" || o.text == "fire_triggers" || o.text == "keep_nulls" || o.text == "tablock" {
                q.skip(1)
                append(mut &opts, o.text.clone())
            } else if o.text == "rows_per_batch" || o.text == "kilobytes_per_batch" {
                q.skip(1)
                try q.expectKw("=")
                let n = q.next()
                if n.kind != lexdb_parse.T_NUM { return Err(lexdb_base.err("42601", &("syntax error at or near \"" + n.text + "\""))) }
            } else if o.text == "order" {
                q.skip(1)
                try q.expectKw("(")
                while true {
                    let c = q.next()
                    if c.kind != lexdb_parse.T_IDENT && c.kind != lexdb_parse.T_QIDENT { return Err(lexdb_base.err("42601", &("syntax error at or near \"" + c.text + "\""))) }
                    if !q.acceptKw("asc") { let d = q.acceptKw("desc") }
                    if !q.acceptKw(",") { break }
                }
                try q.expectKw(")")
            } else {
                return Err(q.unexpected())
            }
            if !q.acceptKw(",") { break }
        }
        try q.expectKw(")")
    }
    ts.value = strings.join(&opts, " ")
    if q.peek().kind != lexdb_parse.T_EOF && !q.isKw(";") { return Err(q.unexpected()) }
    return Ok(ts)
}

// One of the batch's statements, at a statement's start.
// A statement, with the line it starts on.
fn tsqlStmt(q: mut &Parser, types: mut &[]TypeName): Result[TStmt, DbErr] {
    let line = q.lineOf(q.peek().at)
    var t = try tsqlStmt0(q, types)
    t.line = line
    return Ok(t)
}

fn tsqlStmt0(q: mut &Parser, types: mut &[]TypeName): Result[TStmt, DbErr] {
    q.fresh()
    let t = q.peek().clone()
    if t.kind == lexdb_parse.T_IDENT {
        let w1 = q.peekAt(1).clone()
        if t.text == "use" {
            q.skip(1)
            let n = q.next()
            if n.kind != lexdb_parse.T_IDENT && n.kind != lexdb_parse.T_QIDENT { return Err(q.unexpected()) }
            var ts = tstmt(TS_USE)
            append(mut &ts.names, if len(n.spell) > 0 { n.spell.clone() } else { n.text.clone() })
            return Ok(ts)
        }
        if t.text == "exec" || t.text == "execute" {
            q.skip(1)
            return execStmt(q)
        }
        // a batch that begins with a system procedure's name executes it (mssql-jdbc's "sp_executesql N'SET FMTONLY ON ...'")
        if (strings.startsWith(&t.text, "sp_") || strings.startsWith(&t.text, "xp_")) && !(w1.kind == lexdb_parse.T_OP && (w1.text == "=" || w1.text == ".")) {
            return execStmt(q)
        }
        if t.text == "insert" && w1.kind == lexdb_parse.T_IDENT && w1.text == "bulk" {
            q.skip(2)
            return insertBulk(q)
        }
        if t.text == "insert" && insertExec(q) {
            q.skip(1)
            let into = q.acceptKw("into")
            var ts = tstmt(TS_INSERTEXEC)
            let parts = try multiName(q)
            append(mut &ts.names, parts[len(parts) - 1].clone())
            if q.acceptKw("(") {
                while true {
                    let c = q.next()
                    append(mut &ts.names, c.text.clone())
                    if !q.acceptKw(",") { break }
                }
                try q.expectKw(")")
            }
            q.skip(1)
            append(mut &ts.body, try execStmt(q))
            return Ok(ts)
        }
        if t.text == "declare" && w1.kind == lexdb_parse.T_VAR && q.peekAt(2).kind == lexdb_parse.T_IDENT && q.peekAt(2).text == "table" {
            // DECLARE @t TABLE (...): a table for the batch, #@t
            q.skip(3)
            var ts = tstmt(TS_TABLEVAR)
            append(mut &ts.names, w1.text.clone())
            append(mut &ts.stmt, try q.tableDef(&("#" + w1.text)))
            return Ok(ts)
        }
        if t.text == "declare" {
            q.skip(1)
            return declare(q, types)
        }
        if t.text == "set" && w1.kind == lexdb_parse.T_VAR {
            q.skip(2)
            let target = try q.variable(&w1)
            // SET @v = e, and SET @v += e and the like (||= SQL Server 2025's)
            let op = q.compound()
            if len(op) == 0 { try q.expectKw("=") }
            var e = try q.expr()
            if len(op) > 0 { e = lexdb_parse.tsqlAssign(&op, target, e) }
            var ts = tstmt(TS_SQL)
            append(mut &ts.stmt, q.assign(&w1.text, e))
            return Ok(ts)
        }
        if t.text == "if" {
            q.skip(1)
            var ts = tstmt(TS_IF)
            append(mut &ts.stmt, try q.condition())
            append(mut &ts.body, try single(q, types))
            if q.isKw(";") && q.peekAt(1).kind == lexdb_parse.T_IDENT && q.peekAt(1).text == "else" { q.skip(1) }
            if q.acceptKw("else") { append(mut &ts.els, try single(q, types)) }
            return Ok(ts)
        }
        if t.text == "while" {
            q.skip(1)
            var ts = tstmt(TS_WHILE)
            append(mut &ts.stmt, try q.condition())
            append(mut &ts.body, try single(q, types))
            return Ok(ts)
        }
        if t.text == "break" || t.text == "continue" {
            q.skip(1)
            return Ok(tstmt(if t.text == "break" { TS_BREAK } else { TS_CONTINUE }))
        }
        if t.text == "return" {
            q.skip(1)
            var ts = tstmt(TS_RETURN)
            // (a value: what is not the next statement's start; a function's RETURN may give any expression)
            if !atEnd(q) && !(q.peek().kind == lexdb_parse.T_IDENT && lexdb_parse.isTsqlStart(&q.peek().text)) {
                q.fresh()
                let x = try q.expr()
                append(mut &ts.stmt, q.values([x]))
            }
            return Ok(ts)
        }
        if t.text == "print" {
            q.skip(1)
            q.fresh()
            let e = try q.expr()
            var ts = tstmt(TS_PRINT)
            append(mut &ts.stmt, q.values([e]))
            return Ok(ts)
        }
        if t.text == "raiserror" {
            // RAISERROR (message, severity, state [, argument ...]) [WITH option, ...]
            q.skip(1)
            try q.expectKw("(")
            q.fresh()
            var args: []Expr = [try q.expr()]
            while q.acceptKw(",") { append(mut &args, try q.expr()) }
            try q.expectKw(")")
            // WITH LOG, NOWAIT, SETERROR: kept in names
            var opts: []str = []
            if q.acceptKw("with") {
                let o = q.next()
                append(mut &opts, strings.toLowerAscii(&o.text))
                while q.acceptKw(",") {
                    let o2 = q.next()
                    append(mut &opts, strings.toLowerAscii(&o2.text))
                }
            }
            if len(args) < 3 { return Err(lexdb_base.err("42601", "RAISERROR takes a message, a severity and a state")) }
            var ts = tstmt(TS_RAISERROR)
            append(mut &ts.stmt, q.values(args))
            ts.names = opts
            return Ok(ts)
        }
        if t.text == "throw" {
            // THROW number, message, state; THROW alone in a CATCH block
            q.skip(1)
            var ts = tstmt(TS_THROW)
            if !atEnd(q) {
                q.fresh()
                var args: []Expr = [try q.expr()]
                try q.expectKw(",")
                append(mut &args, try q.expr())
                try q.expectKw(",")
                append(mut &args, try q.expr())
                append(mut &ts.stmt, q.values(args))
            }
            return Ok(ts)
        }
        if t.text == "set" && w1.kind == lexdb_parse.T_IDENT && w1.text == "identity_insert" {
            // SET IDENTITY_INSERT [schema.]table ON | OFF: names the option and the table
            q.skip(2)
            var ts = tstmt(TS_SETOPT)
            append(mut &ts.names, "identity_insert")
            var n = q.next()
            while q.acceptKw(".") { n = q.next() }
            if n.kind != lexdb_parse.T_IDENT && n.kind != lexdb_parse.T_QIDENT { return Err(q.unexpected()) }
            append(mut &ts.names, n.text.clone())
            let v = q.next()
            if v.text != "on" && v.text != "off" { return Err(q.unexpected()) }
            ts.value = v.text.clone()
            return Ok(ts)
        }
        if t.text == "set" && w1.kind == lexdb_parse.T_IDENT && (isSetOption(&w1.text) || w1.text == "transaction") {
            q.skip(1)
            return setOption(q)
        }
        if t.text == "begin" {
            if w1.kind == lexdb_parse.T_IDENT && (w1.text == "tran" || w1.text == "transaction") {
                q.skip(2)
                var ts = tstmt(TS_BEGIN)
                tranName(q, mut &ts.names)
                return Ok(ts)
            }
            if w1.kind == lexdb_parse.T_IDENT && w1.text == "try" {
                q.skip(2)
                var ts = tstmt(TS_TRY)
                ts.body = try block(q, types)
                try q.expectKw("end")
                try q.expectKw("try")
                while q.acceptKw(";") {}
                try q.expectKw("begin")
                try q.expectKw("catch")
                ts.els = try block(q, types)
                try q.expectKw("end")
                try q.expectKw("catch")
                return Ok(ts)
            }
            q.skip(1)
            var ts = tstmt(TS_BLOCK)
            ts.body = try block(q, types)
            try q.expectKw("end")
            return Ok(ts)
        }
        if t.text == "commit" || t.text == "rollback" {
            q.skip(1)
            var ts = tstmt(if t.text == "commit" { TS_COMMIT } else { TS_ROLLBACK })
            let kw = q.acceptKw("tran") || q.acceptKw("transaction") || q.acceptKw("work")
            tranName(q, mut &ts.names)
            return Ok(ts)
        }
        if t.text == "save" {
            q.skip(1)
            if !q.acceptKw("tran") { try q.expectKw("transaction") }
            var ts = tstmt(TS_SAVE)
            tranName(q, mut &ts.names)
            if len(ts.names) == 0 { return Err(q.unexpected()) }
            return Ok(ts)
        }
    }
    var ts = tstmt(TS_SQL)
    let one = try q.statement()
    // OPTION (query hints): MAXRECURSION n kept (TS_SQL's flags: [n]); the others read and left to the planner
    if q.isKw("option") && q.peekAt(1).kind == lexdb_parse.T_OP && q.peekAt(1).text == "(" {
        let m = try optionClause(q)
        if m >= 0 { append(mut &ts.flags, m) }
    }
    // a function of the user's in what is kept as text and read again by the other parser (a default, a CHECK, a view): later
    // (a schema-bound view's: SQL Server's 4513, the function not being schema-bound)
    if one.udf && one.kind == lexdb_sql.S_CREATE_VIEW && lexdb_sql.viewBound(&one.index) {
        let vn = if len(one.spell) > 0 { one.spell.clone() } else { lexdb_sql.baseName(&one.table) }
        return Err(lexdb_base.err("TS4513", &("Cannot schema bind view '" + vn + "'. '" + udfIn(&lexdb_sql.viewKept(&one.index)) + "' is not schema bound.")))
    }
    if one.udf && (one.kind == lexdb_sql.S_CREATE || one.kind == lexdb_sql.S_ALTER || one.kind == lexdb_sql.S_CREATE_VIEW || one.kind == lexdb_sql.S_CREATE_INDEX) {
        return Err(lexdb_base.err("0A000", "lexdb: a function of the user's in a column default, a CHECK constraint, a computed column, an index or a view is not supported yet"))
    }
    append(mut &ts.stmt, one)
    return Ok(ts)
}

// The first schema.name( of text: a function of the user's called in it, as written ("" none).
fn udfIn(text: &str): str {
    var i = 0
    let n = len(text)
    while i < n {
        if text[i] == '(' {
            var j = i
            while j > 0 && (isNameByte(text[j - 1]) || text[j - 1] == '.' || text[j - 1] == '[' || text[j - 1] == ']') { j -= 1 }
            let w = text[j..i].toStr()
            if strings.contains(&w, ".") { return strings.replaceAll(&strings.replaceAll(&w, "[", ""), "]", "") }
        }
        i += 1
    }
    return ""
}

fn isNameByte(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '@' || c == '#' || c >= 128 }

// DECLARE @t TABLE (...) as a temporary table of the session: "DROP TABLE IF EXISTS #tv_t; CREATE TABLE #tv_t (...)", every other
// @t of the batch the table's name (mssql-jdbc's DatabaseMetaData collects its catalog procedures' rows in table variables:
// DECLARE @jdbc_temp_fkeys_result table (...); INSERT INTO @jdbc_temp_fkeys_result EXEC sp_fkeys ...; SELECT ... FROM @jdbc_temp_fkeys_result).
// Strings, quoted names and comments are left alone. A table variable the batch does not see again (it is gone with it in SQL
// Server) stays until its name is declared again.
fn tableVariables(sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if !strings.contains(&low, "table") || !strings.contains(&low, "declare") { return sql.toStr() }
    // the names declared as tables: DECLARE @name TABLE
    var names: []str = []
    var i = 0
    let n = len(sql)
    while i < n {
        let c = sql[i]
        if c == '\'' {
            i += 1
            while i < n && !(sql[i] == '\'' && !(i + 1 < n && sql[i + 1] == '\'')) { if sql[i] == '\'' { i += 1 }; i += 1 }
            i += 1
        } else if c == '-' && i + 1 < n && sql[i + 1] == '-' {
            while i < n && sql[i] != '\n' { i += 1 }
        } else if c == 'd' || c == 'D' {
            if i + 7 < n && low[i..i + 7] == "declare" && (i == 0 || !isWordByte(sql[i - 1])) && !isWordByte(sql[i + 7]) {
                var j = i + 7
                while j < n && (sql[j] == ' ' || sql[j] == '\t' || sql[j] == '\n' || sql[j] == '\r') { j += 1 }
                if j < n && sql[j] == '@' {
                    var k = j + 1
                    while k < n && isWordByte(sql[k]) { k += 1 }
                    var m = k
                    while m < n && (sql[m] == ' ' || sql[m] == '\t' || sql[m] == '\n' || sql[m] == '\r') { m += 1 }
                    if m + 5 <= n && low[m..m + 5] == "table" && !(m + 5 < n && isWordByte(sql[m + 5])) { append(mut &names, low[j..k].toStr()) }
                }
            }
            i += 1
        } else {
            i += 1
        }
    }
    if len(names) == 0 { return sql.toStr() }
    var out: []byte = []
    i = 0
    while i < n {
        let c = sql[i]
        if c == '\'' {
            let a = i
            i += 1
            while i < n && !(sql[i] == '\'' && !(i + 1 < n && sql[i + 1] == '\'')) { if sql[i] == '\'' { i += 1 }; i += 1 }
            i += 1
            appendStr(mut &out, sql[a..min(i, n)])
        } else if c == '-' && i + 1 < n && sql[i + 1] == '-' {
            let a = i
            while i < n && sql[i] != '\n' { i += 1 }
            appendStr(mut &out, sql[a..i])
        } else if c == '@' && (i == 0 || !isWordByte(sql[i - 1])) {
            var k = i + 1
            while k < n && isWordByte(sql[k]) { k += 1 }
            let nm = low[i..k].toStr()
            var hit = false
            for t in names { if t == nm { hit = true } }
            if hit { appendStr(mut &out, "#tv_" + nm[1..len(nm)].toStr()) } else { appendStr(mut &out, sql[i..k]) }
            i = k
        } else {
            append(mut &out, c)
            i += 1
        }
    }
    var text = strFromBytes(&out)
    // each declaration: DECLARE #tv_t TABLE (...) becomes DROP TABLE IF EXISTS #tv_t; CREATE TABLE #tv_t (...)
    for t in names {
        let nm = "#tv_" + t[1..len(t)].toStr()
        text = replaceDeclare(&text, &nm)
    }
    return text
}

// DECLARE @x [AS] name, a variable of a type of the user's (name not one
// T-SQL knows): where [AS] name is in sql (at, end) and its catalog key (dbo,
// or no schema, as public; brackets off; lower case). lexdb_tsql makes one
// that is a table type a table variable (DECLARE @x TABLE (its definition)).
pub type TypeRef = record { pub at: int; pub end: int; pub key: str }

pub fn userTypeDecls(sql: &str): []TypeRef {
    var out: []TypeRef = []
    let low = strings.toLowerAscii(sql)
    if !strings.contains(&low, "declare") { return out }
    let n = len(sql)
    var i = 0
    while i < n {
        let c = sql[i]
        if c == '\'' {
            i += 1
            while i < n && !(sql[i] == '\'' && !(i + 1 < n && sql[i + 1] == '\'')) { if sql[i] == '\'' { i += 1 }; i += 1 }
            i += 1
        } else if c == '-' && i + 1 < n && sql[i + 1] == '-' {
            while i < n && sql[i] != '\n' { i += 1 }
        } else if c == '/' && i + 1 < n && sql[i + 1] == '*' {
            i += 2
            while i + 1 < n && !(sql[i] == '*' && sql[i + 1] == '/') { i += 1 }
            i += 2
        } else if (c == 'd' || c == 'D') && i + 7 < n && low[i..i + 7] == "declare" && (i == 0 || !isWordByte(sql[i - 1])) && !isWordByte(sql[i + 7]) {
            var j = skipSpace(sql, i + 7)
            i += 7
            if j >= n || sql[j] != '@' { continue }
            var k = j + 1
            while k < n && isWordByte(sql[k]) { k += 1 }
            k = skipSpace(sql, k)
            let at = k                          // (AS too: DECLARE @x TABLE has none)
            if k + 2 < n && low[k..k + 2] == "as" && !isWordByte(sql[k + 2]) { k = skipSpace(sql, k + 2) }
            // the type's name: one to three parts, plain or [quoted]
            var parts: []str = []
            while k < n {
                if sql[k] == '[' {
                    var m = k + 1
                    while m < n && sql[m] != ']' { m += 1 }
                    if m >= n { break }
                    append(mut &parts, strings.toLowerAscii(&sql[k + 1..m]))
                    k = m + 1
                } else if isWordByte(sql[k]) && sql[k] != '#' && sql[k] != '$' {
                    var m = k
                    while m < n && isWordByte(sql[m]) { m += 1 }
                    append(mut &parts, low[k..m].toStr())
                    k = m
                } else {
                    break
                }
                if k < n && sql[k] == '.' { k += 1 } else { break }
            }
            if len(parts) == 0 || len(parts) > 3 { continue }
            let last = parts[len(parts) - 1].clone()
            if len(parts) == 1 && (last == "table" || lexdb_sql.isReservedWord(&last) || builtinType(&last)) { continue }
            // a declaration of one variable, without a value: what follows is not ( , = or another part
            let after = skipSpace(sql, k)
            if after < n && (sql[after] == '(' || sql[after] == ',' || sql[after] == '=') { continue }
            let sc = if len(parts) >= 2 { parts[len(parts) - 2].clone() } else { "" }
            let key = if sc == "" || sc == "dbo" { last } else { lexdb_sql.qual(&sc, &last) }
            append(mut &out, TypeRef{at: at, end: k, key: key})
            i = k
        } else {
            i += 1
        }
    }
    return out
}

const BUILTIN_TYPES: []str = ["int", "bigint", "smallint", "tinyint", "bit", "decimal", "numeric", "money", "smallmoney", "float", "real", "date",
                               "time", "datetime", "datetime2", "smalldatetime", "datetimeoffset", "char", "varchar", "nchar", "nvarchar", "text",
                               "ntext", "binary", "varbinary", "image", "uniqueidentifier", "xml", "sql_variant", "sysname", "cursor",
                               "hierarchyid", "geography", "geometry", "rowversion", "timestamp", "integer", "dec", "character"]

fn builtinType(w: &str): bool {
    for t in BUILTIN_TYPES { if t == w { return true } }
    return false
}

fn skipSpace(s: &str, at: int): int {
    var i = at
    while i < len(s) && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') { i += 1 }
    return i
}

// sql with each variable names[i] (lower case, its @ too) outside strings,
// quoted names and comments made the table name tables[i]: a table-valued
// parameter's temporary table (lexdb_tds; design/lexdb-tds.md, "As built:
// table-valued parameters").
pub fn renameVars(sql: &str, names: &[]str, tables: &[]str): str {
    if len(names) == 0 { return sql.toStr() }
    let low = strings.toLowerAscii(sql)
    let n = len(sql)
    var out: []byte = []
    var i = 0
    while i < n {
        let c = sql[i]
        let a = i
        if c == '\'' {
            i += 1
            while i < n && !(sql[i] == '\'' && !(i + 1 < n && sql[i + 1] == '\'')) { if sql[i] == '\'' { i += 1 }; i += 1 }
            i = min(i + 1, n)
            appendStr(mut &out, sql[a..i])
        } else if c == '[' || c == '"' {
            let close: byte = if c == '[' { ']' } else { '"' }
            i += 1
            while i < n && !(sql[i] == close && !(i + 1 < n && sql[i + 1] == close)) { if sql[i] == close { i += 1 }; i += 1 }
            i = min(i + 1, n)
            appendStr(mut &out, sql[a..i])
        } else if c == '-' && i + 1 < n && sql[i + 1] == '-' {
            while i < n && sql[i] != '\n' { i += 1 }
            appendStr(mut &out, sql[a..i])
        } else if c == '/' && i + 1 < n && sql[i + 1] == '*' {
            i += 2
            while i < n && !(sql[i] == '*' && i + 1 < n && sql[i + 1] == '/') { i += 1 }
            i = min(i + 2, n)
            appendStr(mut &out, sql[a..i])
        } else if c == '@' && (i == 0 || !isWordByte(sql[i - 1])) {
            var k = i + 1
            while k < n && (isWordByte(sql[k]) || sql[k] == '@') { k += 1 }
            let nm = low[i..k]
            var hit = -1
            for j in 0..len(names) { if names[j] == nm { hit = j } }
            if hit >= 0 { appendStr(mut &out, tables[hit]) } else { appendStr(mut &out, sql[i..k]) }
            i = k
        } else {
            append(mut &out, c)
            i += 1
        }
    }
    return strFromBytes(&out)
}

fn isWordByte(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '#' || c == '$' || c >= 0x80 }

// "DECLARE <nm> TABLE" (any case) -> "DROP TABLE IF EXISTS <nm>; CREATE TABLE <nm>"
fn replaceDeclare(text: &str, nm: &str): str {
    let low = strings.toLowerAscii(text)
    let pat = "declare"
    var out: []byte = []
    var i = 0
    let n = len(text)
    while i < n {
        if i + 7 <= n && low[i..i + 7] == pat && (i == 0 || !isWordByte(text[i - 1])) {
            var j = i + 7
            while j < n && (text[j] == ' ' || text[j] == '\t' || text[j] == '\n' || text[j] == '\r') { j += 1 }
            if j + len(nm) <= n && low[j..j + len(nm)] == strings.toLowerAscii(nm) {
                var m = j + len(nm)
                while m < n && (text[m] == ' ' || text[m] == '\t' || text[m] == '\n' || text[m] == '\r') { m += 1 }
                if m + 5 <= n && low[m..m + 5] == "table" {
                    appendStr(mut &out, "DROP TABLE IF EXISTS " + nm + "; CREATE TABLE " + nm)
                    i = m + 5
                    continue
                }
            }
        }
        append(mut &out, text[i])
        i += 1
    }
    return strFromBytes(&out)
}

// A batch of T-SQL. vars: the variables it starts with ($1, $2, ... in that order). A batch that is CREATE [OR ALTER] PROCEDURE
// or ALTER PROCEDURE is that statement alone: its header is read here, the rest of the batch is the procedure's body (read
// as a batch of its own, to check it, and kept as its text).
// The line of the last batch's error that parseBatch found (SQL Server's line of a compile error); 1 not known.
var ERR_LINE: int = 1

pub fn errLine(): int { return ERR_LINE }

// A parse error at the parser's place: its line kept (errLine); "at end of input" as SQL Server says it, near the last
// token (102).
fn atLine(q: mut &Parser, e: DbErr): DbErr {
    if e.state == "42601" && e.msg == "syntax error at end of input" && len(q.lastText()) > 0 {
        ERR_LINE = q.lineOf(q.lastAt())
        return tsErr(102, &("Incorrect syntax near '" + q.lastText() + "'."))
    }
    ERR_LINE = q.lineOf(q.peek().at)
    // the token as written (SQL Server's "near the keyword 'FROM'")
    if e.state == "42601" && strings.startsWith(&e.msg, "syntax error at or near \"") && e.msg == "syntax error at or near \"" + q.peek().text + "\"" {
        var x = e
        x.msg = "syntax error at or near \"" + q.spelled(q.peek()) + "\""
        return x
    }
    return e
}

pub fn parseBatch(sql0: &str, d: lexdb_parse.Dialect, vars: &[]str): Result[TBatch, DbErr] {
    ERR_LINE = 1
    match try procBatch(sql0, d, vars) {
        Some(b) { return Ok(b) }
        None {}
    }
    match try funcBatch(sql0, d) {
        Some(b) { return Ok(b) }
        None {}
    }
    return parseStmts(sql0, d, vars)
}

fn tsErr(n: int, msg: &str): DbErr { return lexdb_base.err(&("TS" + n.toStr()), msg) }

fn sideEffect(what: &str): DbErr { return tsErr(443, &("Invalid use of a side-effecting operator '" + what + "' within a function.")) }

// A function body's statements as SQL Server compiles them: what a function may not do (443 side effects, 444 a SELECT that
// gives rows, 2772 #temporary tables, 154 USE), and a RETURN's value (1075 for a scalar function's without one, 178 for a
// table-valued function's with one). Writes to table variables (#tv_...) are allowed. multi: a multi-statement table-valued
// function's.
fn checkBody(ts: &[]TStmt, multi: bool): Result[Unit, DbErr] {
    for t in ts {
        let k = t.kind
        if k == TS_BLOCK { try checkBody(&t.body, multi) }
        else if k == TS_IF || k == TS_WHILE {
            try checkBody(&t.body, multi)
            try checkBody(&t.els, multi)
        }
        else if k == TS_TRY { return Err(sideEffect("BEGIN TRY")) }
        else if k == TS_PRINT { return Err(sideEffect("PRINT")) }
        else if k == TS_RAISERROR { return Err(sideEffect("RAISERROR")) }
        else if k == TS_THROW { return Err(sideEffect("THROW")) }
        else if k == TS_BEGIN { return Err(sideEffect("BEGIN TRANSACTION")) }
        else if k == TS_COMMIT { return Err(sideEffect("COMMIT TRANSACTION")) }
        else if k == TS_ROLLBACK { return Err(sideEffect("ROLLBACK TRANSACTION")) }
        else if k == TS_SAVE { return Err(sideEffect("SAVEPOINT")) }
        else if k == TS_EXECSTR { return Err(sideEffect("EXECUTE STRING")) }
        else if k == TS_INSERTBULK { return Err(sideEffect("INSERT BULK")) }
        else if k == TS_INSERTEXEC { return Err(sideEffect("INSERT")) }
        else if k == TS_SETOPT {
            if len(t.names) > 0 && t.names[0] == "identity_insert" { return Err(sideEffect("SET IDENTITY_INSERT " + strings.toUpperAscii(&t.value))) }
            return Err(sideEffect("SET OPTION " + (if t.value == "off" { "OFF" } else { "ON" })))
        }
        else if k == TS_USE { return Err(tsErr(154, "a USE database statement is not allowed in a procedure, function or trigger.")) }
        else if k == TS_RETURN {
            if len(t.stmt) == 0 && !multi { return Err(tsErr(1075, "RETURN statements in scalar valued functions must include an argument.")) }
            if len(t.stmt) > 0 && multi { return Err(tsErr(178, "A RETURN statement with a return value cannot be used in this context.")) }
        }
        else if k == TS_SQL {
            let s = &t.stmt[0]
            for w in s.wctes {
                if !strings.startsWith(&w.stmt.table, "#tv_") {
                    let v = if w.stmt.kind == lexdb_sql.S_INSERT { "INSERT" } else if w.stmt.kind == lexdb_sql.S_UPDATE { "UPDATE" } else if w.stmt.kind == lexdb_sql.S_DELETE { "DELETE" } else { "MERGE" }
                    return Err(sideEffect(v))
                }
            }
            let tv = strings.startsWith(&s.table, "#tv_")
            if s.kind == lexdb_sql.S_SELECT {
                if len(s.into) > 0 { return Err(tsErr(2772, "Cannot access temporary tables from within a function.")) }
                if len(s.assign) == 0 { return Err(tsErr(444, "Select statements included within a function cannot return data to a client.")) }
            }
            else if s.kind == lexdb_sql.S_INSERT && !tv { return Err(sideEffect("INSERT")) }
            else if s.kind == lexdb_sql.S_UPDATE && !tv { return Err(sideEffect("UPDATE")) }
            else if s.kind == lexdb_sql.S_DELETE && !tv { return Err(sideEffect("DELETE")) }
            else if s.kind == lexdb_sql.S_MERGE && !tv { return Err(sideEffect("MERGE")) }
            else if s.kind == lexdb_sql.S_CREATE && !tv && strings.startsWith(&s.table, "#") { return Err(tsErr(2772, "Cannot access temporary tables from within a function.")) }
            else if s.kind == lexdb_sql.S_DROP && !tv { return Err(sideEffect("DROP OBJECT")) }
            else if s.kind == lexdb_sql.S_TRUNCATE { return Err(sideEffect("TRUNCATE TABLE")) }
            else if s.kind != lexdb_sql.S_INSERT && s.kind != lexdb_sql.S_UPDATE && s.kind != lexdb_sql.S_DELETE && s.kind != lexdb_sql.S_MERGE &&
                    s.kind != lexdb_sql.S_CREATE && s.kind != lexdb_sql.S_DROP && s.kind != lexdb_sql.S_EMPTY { return Err(sideEffect("DDL")) }
        }
    }
    return Ok(Unit{})
}

// ---- a scalar function's body, compiled (lexdb_udf)

type Gen = record { ops: []lexdb_udf.Op; vars: []str; reads: bool }

fn varAt(g: &Gen, name: &str): int {
    for i in 0..len(g.vars) { if g.vars[i] == name { return i } }
    return -1
}

fn emit(g: mut &Gen, code: int, k: int, l: int, text: &str): int {
    append(mut &g.ops, lexdb_udf.Op{code: code, k: k, l: l, text: text.toStr()})
    return len(g.ops) - 1
}

// A statement that reads tables or has subqueries: the evaluator cannot run it per call (a later slice does).
fn readsTables(s: &Stmt): bool { return len(s.from) > 0 || len(s.subs) > 0 || len(s.inner) > 0 || len(s.wins) > 0 }

fn firstExpr(s: &Stmt): Expr {
    if len(s.items) > 0 {
        match s.items[0].expr {
            Some(x) { return lexdb_sql.cloneExpr(&x) }
            None {}
        }
    }
    return Expr.Lit(lexdb_sql.Val.Null)
}

// IF's and WHILE's condition: the expression inside the SELECT CASE WHEN cond THEN 1 ELSE 0 the parser made of it.
fn condOf(s: &Stmt): Expr {
    let x = firstExpr(s)
    match x {
        Expr.Call(n, args, _) {
            if n == "case else" && len(args) == 3 { return lexdb_sql.cloneExpr(&args[0]) }
        }
        else {}
    }
    return x
}

fn genRaise(g: mut &Gen, n: int, msg: &str) { let k = emit(g, lexdb_udf.OP_ERR, n, 0, msg) }

fn genReads(g: mut &Gen) {
    g.reads = true
    genRaise(g, 0, "lexdb: a function that reads tables is not supported yet in this place (only a call with constant arguments, in a statement of its own, reads them)")
}

fn genStmts(g: mut &Gen, ts: &[]TStmt, inLoop: bool, top: int, brk: mut &[]int): Result[Unit, DbErr] {
    for t in ts {
        let k = t.kind
        if k == TS_BLOCK {
            try genStmts(g, &t.body, inLoop, top, brk)
        } else if k == TS_DECLARE {
            for i in 0..len(t.names) {
                let idx = varAt(g, &t.names[i])
                var done = false
                for s in t.stmt {
                    if len(s.assign) > 0 && s.assign[0] == t.names[i] {
                        done = true
                        if readsTables(&s) { genReads(g) } else { let o = emit(g, lexdb_udf.OP_SET, idx, 0, &lexdb_udf.exprOut(&firstExpr(&s))) }
                    }
                }
                if !done { let o = emit(g, lexdb_udf.OP_SET, idx, 0, "null") }
            }
        } else if k == TS_SQL {
            let s = &t.stmt[0]
            if s.kind == lexdb_sql.S_SELECT && len(s.assign) > 0 {
                if readsTables(s) { genReads(g) } else {
                    for i in 0..len(s.assign) {
                        if len(s.assign[i]) == 0 || i >= len(s.items) { continue }
                        match s.items[i].expr {
                            Some(x) { let o = emit(g, lexdb_udf.OP_SET, varAt(g, &s.assign[i]), 0, &lexdb_udf.exprOut(&x)) }
                            None {}
                        }
                    }
                }
            } else {
                genRaise(g, 0, "lexdb: this statement is not supported in a function yet")
            }
        } else if k == TS_IF {
            let c = &t.stmt[0]
            if readsTables(c) { genReads(g) } else {
                let jf = emit(g, lexdb_udf.OP_JF, 0, 0, &lexdb_udf.exprOut(&condOf(c)))
                try genStmts(g, &t.body, inLoop, top, brk)
                if len(t.els) > 0 {
                    let j = emit(g, lexdb_udf.OP_JMP, 0, 0, "")
                    g.ops[jf].l = len(g.ops)
                    try genStmts(g, &t.els, inLoop, top, brk)
                    g.ops[j].l = len(g.ops)
                } else {
                    g.ops[jf].l = len(g.ops)
                }
            }
        } else if k == TS_WHILE {
            let c = &t.stmt[0]
            if readsTables(c) { genReads(g) } else {
                let top2 = len(g.ops)
                let jf = emit(g, lexdb_udf.OP_JF, 0, 0, &lexdb_udf.exprOut(&condOf(c)))
                var brk2: []int = []
                try genStmts(g, &t.body, true, top2, mut &brk2)
                let back = emit(g, lexdb_udf.OP_JMP, 0, top2, "")
                g.ops[jf].l = len(g.ops)
                for b in brk2 { g.ops[b].l = len(g.ops) }
            }
        } else if k == TS_BREAK {
            if !inLoop { return Err(tsErr(135, "Cannot use a BREAK statement outside the scope of a WHILE statement.")) }
            append(brk, emit(g, lexdb_udf.OP_JMP, 0, 0, ""))
        } else if k == TS_CONTINUE {
            if !inLoop { return Err(tsErr(136, "Cannot use a CONTINUE statement outside the scope of a WHILE statement.")) }
            let j = emit(g, lexdb_udf.OP_JMP, 0, top, "")
        } else if k == TS_RETURN {
            if len(t.stmt) > 0 {
                if readsTables(&t.stmt[0]) { genReads(g) } else { let o = emit(g, lexdb_udf.OP_RET, 0, 0, &lexdb_udf.exprOut(&firstExpr(&t.stmt[0]))) }
            }
        } else if k == TS_EXEC {
            genRaise(g, 557, "Only functions and some extended stored procedures can be executed from within a function.")
        } else {
            genRaise(g, 0, "lexdb: this statement is not supported in a function yet")
        }
    }
    return Ok(Unit{})
}

// Whether a body calls a function of the user's (a schema-qualified call: Call "schema.f").
fn callsUdf(ts: &[]TStmt, out: mut &[]str) {
    for t in ts {
        callsUdf(&t.body, out)
        callsUdf(&t.els, out)
        for s in t.stmt {
            if !s.udf { continue }
            let x = lexdb_routine.mapStmt(&s, fn(y: &Expr): Option[Expr] {
                match y {
                    Expr.Call(n, args, star) {
                        if strings.contains(&n, ".") || strings.contains(&n, lexdb_sql.QSEP) {
                            let k = lexdb_routine.tsqlKey(&n)
                            if !lexdb_base.hasStr(out, &k) { append(out, k) }
                        }
                    }
                    else {}
                }
                return None
            })
        }
    }
}

// The program of a scalar function whose body is b (parsed with its parameters r.params as its first variables).
fn genFunc(r: &lexdb_sql.Routine, b: &TBatch, reads: mut &bool): Result[lexdb_udf.Prog, DbErr] {
    var g = Gen{ops: [], vars: b.vars.clone(), reads: false}
    var brk: []int = []
    try genStmts(mut &g, &b.stmts, false, 0, mut &brk)
    reads = g.reads
    var types: []TypeName = []
    for p in r.params { append(mut &types, p.typ) }
    for t in b.types { append(mut &types, t) }
    while len(types) < len(g.vars) { append(mut &types, TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}) }
    return Ok(lexdb_udf.Prog{types: types, ops: g.ops})
}

// CREATE [OR ALTER] FUNCTION name (parameters) RETURNS ... AS body, or ALTER FUNCTION: the batch it is, else None. A scalar
// or multi-statement function's body is BEGIN ... END, an inline table-valued function's RETURN [(] SELECT ... [)] (kept
// without its parentheses). The body is read here to check it (a syntax error or a statement a function may not have makes
// nothing: 102/156, 443, 444, 455 ...) and kept as text.
fn funcBatch(sql: &str, d: lexdb_parse.Dialect): Result[Option[TBatch], DbErr] {
    let low = strings.toLowerAscii(sql)
    if !strings.contains(&low, "function") { return Ok(None) }
    let none: []str = []
    var q = match lexdb_parse.tsqlParser(sql, d, &none) {
        Ok(x) { x }
        Err(_) { return Ok(None) }
    }
    let first = q.peek().clone()
    if first.kind != lexdb_parse.T_IDENT || (first.text != "create" && first.text != "alter") { return Ok(None) }
    let create = first.text == "create"
    var k = 1
    var orAt = -1
    var alterAt = -1
    if create && q.peekAt(1).kind == lexdb_parse.T_IDENT && q.peekAt(1).text == "or" && q.peekAt(2).kind == lexdb_parse.T_IDENT && q.peekAt(2).text == "alter" {
        orAt = q.peekAt(1).at
        alterAt = q.peekAt(2).at
        k = 3
    }
    let w = q.peekAt(k).clone()
    if w.kind != lexdb_parse.T_IDENT || w.text != "function" { return Ok(None) }
    q.skip(k + 1)
    var r = try q.funcHeader()
    let at = q.here()
    let src = q.source()
    let body0 = src[at..len(src)]
    let inline = strings.contains(&r.attrs, "inline")
    if inline {
        // RETURN [(] SELECT ... [)]
        let t = q.peek().clone()
        if t.kind != lexdb_parse.T_IDENT || t.text != "return" { return Err(q.unexpected()) }
        var text = strings.trim(&src[t.at + 6..len(src)])
        while len(text) > 0 && text[len(text) - 1] == ';' { text = strings.trim(&text[0..len(text) - 1]) }
        // the outer parentheses, when the first closes at the end
        if len(text) > 0 && text[0] == '(' {
            var depth = 0
            var closeAt = -1
            var i = 0
            var inStr = false
            while i < len(text) {
                let c = text[i]
                if c == '\'' { inStr = !inStr }
                else if !inStr && c == '(' { depth += 1 }
                else if !inStr && c == ')' {
                    depth -= 1
                    if depth == 0 { closeAt = i; break }
                }
                i += 1
            }
            if closeAt == len(text) - 1 { text = strings.trim(&text[1..closeAt]) }
        }
        r.body = text.toStr()
    } else {
        let t = q.peek().clone()
        if t.kind != lexdb_parse.T_IDENT || t.text != "begin" { return Err(q.unexpected()) }
        r.body = body0.toStr()
    }
    r.def = if orAt >= 0 { src[first.at..orAt].toStr() + src[orAt + 2..alterAt].toStr() + src[alterAt + 5..len(src)].toStr() }
            else if !create { "CREATE" + src[first.at + 5..len(src)].toStr() } else { src[first.at..len(src)].toStr() }
    // the body, as a batch of its own, to be sure it is one (the parameters its variables)
    var names: []str = []
    for p in r.params { append(mut &names, p.name.clone()) }
    // (a multi-statement function's result table, RETURNS @t TABLE (...), is a table variable its body declares first)
    let multiBody = strings.contains(&r.attrs, "multi")
    let checked: str = if multiBody && len(r.body) >= 5 { r.body[0..5].toStr() + " declare " + r.retSpell + ";" + r.body[5..len(r.body)].toStr() } else { r.body.clone() }
    let b = try parseStmts(&checked, d, &names)
    if inline {
        if len(b.stmts) != 1 || b.stmts[0].kind != TS_SQL || (b.stmts[0].stmt[0].kind != lexdb_sql.S_SELECT || len(b.stmts[0].stmt[0].assign) > 0) {
            return Err(tsErr(156, "Incorrect syntax near the keyword 'RETURN'."))
        }
    } else {
        if len(b.stmts) != 1 || b.stmts[0].kind != TS_BLOCK { return Err(tsErr(156, "Incorrect syntax near the keyword 'select'.")) }
        let multi = strings.contains(&r.attrs, "multi")
        try checkBody(&b.stmts, multi)
        let body = &b.stmts[0].body
        if len(body) == 0 || body[len(body) - 1].kind != TS_RETURN {
            return Err(tsErr(455, "The last statement included within a function must be a return statement."))
        }
        if !multi {
            var reads = false
            let prog = try genFunc(&r, &b, mut &reads)
            r.code = lexdb_udf.encode(&prog)
            if reads { r.attrs += " reads" }
            var called: []str = []
            callsUdf(&b.stmts, mut &called)
            for ck in called { r.attrs += " calls:" + ck }
        }
    }
    var s = lexdb_sql.newStmt(lexdb_sql.S_CREATE_ROUTINE)
    s.table = r.key.clone()
    s.ifFlag = orAt >= 0 || !create
    if !create { s.alias = "alter" }
    append(mut &s.rtn, r)
    var ts = tstmt(TS_SQL)
    append(mut &ts.stmt, s)
    return Ok(Some(TBatch{stmts: [ts], vars: [], types: []}))
}

// CREATE [OR ALTER] PROC[EDURE] name [parameters] AS body, or ALTER PROC[EDURE]: the batch it is, else None.
fn procBatch(sql: &str, d: lexdb_parse.Dialect, vars: &[]str): Result[Option[TBatch], DbErr] {
    let low = strings.toLowerAscii(sql)
    if !strings.contains(&low, "proc") { return Ok(None) }
    var q = match lexdb_parse.tsqlParser(sql, d, vars) {
        Ok(x) { x }
        Err(_) { return Ok(None) }
    }
    let first = q.peek().clone()
    if first.kind != lexdb_parse.T_IDENT || (first.text != "create" && first.text != "alter") { return Ok(None) }
    let create = first.text == "create"
    var k = 1
    var orAt = -1
    var alterAt = -1
    if create && q.peekAt(1).kind == lexdb_parse.T_IDENT && q.peekAt(1).text == "or" && q.peekAt(2).kind == lexdb_parse.T_IDENT && q.peekAt(2).text == "alter" {
        orAt = q.peekAt(1).at
        alterAt = q.peekAt(2).at
        k = 3
    }
    let w = q.peekAt(k).clone()
    if w.kind != lexdb_parse.T_IDENT || (w.text != "proc" && w.text != "procedure") { return Ok(None) }
    q.skip(k + 1)
    var r = try q.procHeader()
    try q.expectKw("as")
    let at = q.here()
    let src = q.source()
    r.body = src[at..len(src)].toStr()
    // the text as SQL Server keeps it: from CREATE, OR ALTER left out (its words gone, the blanks between them kept)
    // (ALTER is kept as CREATE, in capitals whatever it was written)
    r.def = if orAt >= 0 { src[first.at..orAt].toStr() + src[orAt + 2..alterAt].toStr() + src[alterAt + 5..len(src)].toStr() }
            else if !create { "CREATE" + src[first.at + 5..len(src)].toStr() } else { src[first.at..len(src)].toStr() }
    r.lang = "tsql"
    // the body, as a batch of its own, to be sure it is one (a procedure's parameters its variables)
    var names: []str = []
    for p in r.params { append(mut &names, p.name.clone()) }
    var all: []str = []
    for v in vars { append(mut &all, v.clone()) }
    for n in names { append(mut &all, n.clone()) }
    let b = try parseStmts(&r.body, d, &all)
    var s = lexdb_sql.newStmt(lexdb_sql.S_CREATE_ROUTINE)
    s.table = r.key.clone()
    s.ifFlag = orAt >= 0 || !create
    if !create { s.alias = "alter" }
    append(mut &s.rtn, r)
    var ts = tstmt(TS_SQL)
    append(mut &ts.stmt, s)
    return Ok(Some(TBatch{stmts: [ts], vars: [], types: []}))
}

fn parseStmts(sql0: &str, d: lexdb_parse.Dialect, vars: &[]str): Result[TBatch, DbErr] {
    let sql = tableVariables(sql0)
    var q = try lexdb_parse.tsqlParser(&sql, d, vars)
    var out: []TStmt = []
    var types: []TypeName = []
    while true {
        while q.acceptKw(";") {}
        if q.peek().kind == lexdb_parse.T_EOF { break }
        if len(out) == 0 && (q.peek().kind == lexdb_parse.T_IDENT || q.peek().kind == lexdb_parse.T_QIDENT) && q.peek().text != "call" &&
           !(q.peek().kind == lexdb_parse.T_IDENT && (lexdb_sql.isReservedWord(&q.peek().text) || lexdb_parse.isTsqlStart(&q.peek().text))) {
            // a procedure's name where a statement starts, EXEC left out: allowed for the first statement of a batch
            let m = q.mark()
            match tsqlStmt(mut &q, mut &types) {
                Ok(t) { append(mut &out, t) }
                Err(e) {
                    q.reset(m)
                    match execStmt(mut &q) {
                        Ok(t) { append(mut &out, t) }
                        Err(_) {
                            q.reset(m)
                            match tsqlStmt(mut &q, mut &types) {
                                Ok(t) { append(mut &out, t) }
                                Err(e2) { return Err(atLine(mut &q, e2)) }
                            }
                        }
                    }
                }
            }
            continue
        }
        match tsqlStmt(mut &q, mut &types) {
            Ok(t) { append(mut &out, t) }
            Err(e) { return Err(atLine(mut &q, e)) }
        }
    }
    return Ok(TBatch{stmts: out, vars: q.takeVars(), types: types})
}

// A parameter of sp_executesql's or sp_prepare's @params: "@p1 int, @p2
// nvarchar(50) OUTPUT".
// tableType: a table type's catalog key (a table-valued parameter), "" for
// another type; typeText: that type's name as written; readonly: READONLY.
pub type ParamDecl = record { pub name: str; pub typ: TypeName; pub output: bool; pub tableType: str; pub typeText: str; pub readonly: bool }

pub fn parseParamDecls(text: &str): Result[[]ParamDecl, DbErr] {
    let none: []str = []
    var q = try lexdb_parse.tsqlParser(text, lexdb_parse.Dialect{tsql: true, quotedIdent: true}, &none)
    var out: []ParamDecl = []
    while q.peek().kind != lexdb_parse.T_EOF {
        let t = q.next()
        if t.kind != lexdb_parse.T_VAR { return Err(lexdb_base.err("42601", &("syntax error at or near \"" + t.text + "\""))) }
        let a = q.acceptKw("as")
        let pt = try q.paramType()
        if q.acceptKw("=") { let dflt = try q.expr() }
        let output = q.acceptKw("output") || q.acceptKw("out")
        let ro = q.acceptKw("readonly")
        append(mut &out, ParamDecl{name: t.text.clone(), typ: pt.typ.clone(), output: output, tableType: pt.key.clone(), typeText: pt.written.clone(), readonly: ro})
        if !q.acceptKw(",") { break }
    }
    if q.peek().kind != lexdb_parse.T_EOF { return Err(q.unexpected()) }
    return Ok(out)
}
