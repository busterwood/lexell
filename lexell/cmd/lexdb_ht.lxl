// lexdb_ht: ClickHouse-style Adaptive Two-Level Hash Tables & Bump-Arena String/Bytes Hash Table
// for single-core high-cardinality GROUP BY aggregation (lexdb_pipe).
//
// Design:
// 1. Small cardinalities (< TWO_LEVEL_THRESH = 16,384 groups):
//    Single flat open-addressing table (L1/L2 cache-resident, zero two-level dispatch overhead).
// 2. High cardinalities (>= 16,384 groups, e.g. ClickBench q18/q32/q33/q34/q36/q37/q39):
//    Transparently promotes ONCE into 256 independent L1/L2-cache-resident sub-tables indexed
//    by the top 8 bits of the 64-bit hash ((h >> 56) & 255):
//    - Eliminates multi-megabyte full-table DRAM rehashes (each bucket grows independently in L1/L2).
//    - Batch-grouped probing (probeBatch) radix-scatters a 2,048-row batch into 256 bucket runs so
//      all probes to each sub-table execute consecutively while hot in L1/L2 cache, while miss
//      inserts still run in input row order to preserve 100% deterministic group IDs.
// 3. Bump-Arena String / Composite Bytes storage (TwoLevelArena):
//    All distinct keys append sequentially into contiguous `str` arenas (zero per-key malloc/free!).
//    Probes check flat 64-bit hash + length arrays first (rejecting >99.9999% of collisions without
//    touching key bytes) and only call native memcmp (`&arena[off..off+n] == s`) on exact match.
//    keyAt(gid) reconstructs key text on demand only for groups that survive Top-N pruning.
import "collections"

pub const TWO_LEVEL_THRESH = 16384
pub const NBUCKETS = 256
const BKT_MASK = 255

fn bucketOf(h: u64): int {
    return int((h >> 56) & u64(BKT_MASK))
}

fn slotMask(h: u64, mask: int): int {
    return int(h & u64(mask))
}

pub fn hashInt(k: int): u64 {
    let h = k.hash()
    let z = h ^ (h >> 30)
    return z ^ (z << 13) ^ (z >> 17)
}

pub fn hashTwoInt(k0: int, k1: int, nu: byte): u64 {
    let h0 = k0.hash()
    let h1 = k1.hash()
    let x = h0 ^ (h1 << 1) ^ (h1 >> 7) ^ (u64(nu) << 29)
    let z = x ^ (x >> 30)
    return z ^ (z << 13) ^ (z >> 17)
}

pub fn hashStr(s: &str): u64 {
    var h = collections.fxHashStr(s)
    h = (h ^ (h >> 33)) *% u64(0x5851f42d4c957f2d)
    return h ^ (h >> 33)
}

// ============================================================================
// 0. FastIntCount: Flat power-of-2 open-addressed int -> count hash table
//    with cache-line-packed [k, v] slots and an optional L3-resident
//    register-blocked Bloom pre-filter for large high-miss joins.
// ============================================================================

fn bloomWords(nKeys: int, room: int): int {
    if nKeys < 16384 { return 0 }
    var words = 4096
    // Target ~16-32 bits/key, capped at 1,048,576 words (8 MB) so it stays L3-resident.
    while words < 1048576 && words * 4 < nKeys { words = words * 2 }
    if room >= 0 {
        while words >= 4096 && words * 8 > room { words = words / 2 }
        if words < 4096 || words * 8 > room { return 0 }
    }
    return words
}

pub type FastIntCount = record {
    pub slots: []int    // interleaved [k, v] per slot (v == 0 means empty)
    mask: int
    len: int
    bf: []u64           // optional register-blocked Bloom filter
    bfMask: int         // len(bf) - 1, or -1 if disabled
}

pub fn newFastIntCount(): FastIntCount {
    return FastIntCount{slots: [], mask: 0, len: 0, bf: [], bfMask: -1}
}

pub fn (t: &FastIntCount) size(): int { return t.len }

fn (t: mut &FastIntCount) grow() {
    let cap = if len(t.slots) == 0 { 1024 } else { len(t.slots) } // len(slots) == oldCap * 2
    let mask = cap - 1
    var ns: []int = array(cap * 2, 0)
    var i = 0
    let nOld = len(t.slots)
    while i < nOld {
        let v = t.slots[i + 1]
        if v != 0 {
            let k = t.slots[i]
            var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
            h = h ^ (h >> 27)
            var sl = h & mask
            while ns[sl * 2 + 1] != 0 { sl = (sl + 1) & mask }
            ns[sl * 2] = k
            ns[sl * 2 + 1] = v
        }
        i += 2
    }
    t.slots = ns
    t.mask = mask
}

// Increments count for key k; returns true if k was newly inserted.
pub fn (t: mut &FastIntCount) inc(k: int): bool {
    return t.addW(k, 1)
}

pub fn (t: mut &FastIntCount) addW(k: int, w: int): bool {
    if w == 0 { return false }
    let cap = len(t.slots) / 2
    if cap == 0 || (t.len + 1) * 10 >= cap * 6 {
        t.grow()
    }
    let mask = t.mask
    var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
    h = h ^ (h >> 27)
    var sl = h & mask
    while true {
        let base = sl * 2
        let v = t.slots[base + 1]
        if v == 0 {
            t.slots[base] = k
            t.slots[base + 1] = w
            t.len += 1
            return true
        }
        if t.slots[base] == k {
            t.slots[base + 1] = v + w
            return false
        }
        sl = (sl + 1) & mask
    }
    return false
}

pub fn (t: mut &FastIntCount) buildFilter(room: int) {
    let words = bloomWords(t.len, room)
    if words == 0 { return }
    let bm = words - 1
    var bf: []u64 = array(words, u64(0))
    var i = 0
    let n = len(t.slots)
    while i < n {
        if t.slots[i + 1] != 0 {
            let k = t.slots[i]
            var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
            h = h ^ (h >> 27)
            let wi = h & bm
            let b = (u64(1) << ((h >> 24) & 63)) |
                    (u64(1) << ((h >> 30) & 63)) |
                    (u64(1) << ((h >> 36) & 63))
            bf[wi] = bf[wi] | b
        }
        i += 2
    }
    t.bf = bf
    t.bfMask = bm
}

pub fn (t: &FastIntCount) get(k: int): int {
    if t.len == 0 { return 0 }
    var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
    h = h ^ (h >> 27)
    if t.bfMask >= 0 {
        let b = (u64(1) << ((h >> 24) & 63)) |
                (u64(1) << ((h >> 30) & 63)) |
                (u64(1) << ((h >> 36) & 63))
        if (t.bf[h & t.bfMask] & b) != b { return 0 }
    }
    let mask = t.mask
    var sl = h & mask
    while true {
        let base = sl * 2
        let v = t.slots[base + 1]
        if v == 0 { return 0 }
        if t.slots[base] == k { return v }
        sl = (sl + 1) & mask
    }
    return 0
}

// Vectorized batch weight-multiplication for an intermediate JK_INT countOnly level.
// Writes w2[r] (0 for dropped rows) and returns the number of kept rows (w2[r] > 0).
pub fn (t: &FastIntCount) mulWeights(at0: &[]int, kv: &[]int, knul: &[]bool, ws: &[]int, n: int,
                                     left: bool, anti: bool, antiNull: bool,
                                     w2: mut &[]int, matched: mut &int, nulls: mut &int): int {
    let tLen = t.len
    let mask = t.mask
    let bfMask = t.bfMask
    let hasBf = bfMask >= 0
    var kept = 0
    var mat = 0
    var nul = 0
    if !left && !anti {
        if tLen == 0 { return 0 }
        for r in 0..n {
            let wr = ws[r]
            if wr == 0 { continue }
            let sr = at0[r]
            if sr < 0 || knul[sr] { continue }
            let k = kv[sr]
            var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
            h = h ^ (h >> 27)
            if hasBf {
                let b = (u64(1) << ((h >> 24) & 63)) |
                        (u64(1) << ((h >> 30) & 63)) |
                        (u64(1) << ((h >> 36) & 63))
                if (t.bf[h & bfMask] & b) != b { continue }
            }
            var sl = h & mask
            while true {
                let base = sl * 2
                let v = t.slots[base + 1]
                if v == 0 { break }
                if t.slots[base] == k {
                    let nw = wr * v
                    w2[r] = nw
                    mat += nw
                    kept += 1
                    break
                }
                sl = (sl + 1) & mask
            }
        }
        matched += mat
        return kept
    }
    for r in 0..n {
        let wr = ws[r]
        if wr == 0 { continue }
        let sr = at0[r]
        var m = 0
        if tLen > 0 && sr >= 0 && !knul[sr] {
            let k = kv[sr]
            var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
            h = h ^ (h >> 27)
            var ok = true
            if hasBf {
                let b = (u64(1) << ((h >> 24) & 63)) |
                        (u64(1) << ((h >> 30) & 63)) |
                        (u64(1) << ((h >> 36) & 63))
                if (t.bf[h & bfMask] & b) != b { ok = false }
            }
            if ok {
                var sl = h & mask
                while true {
                    let base = sl * 2
                    let v = t.slots[base + 1]
                    if v == 0 { break }
                    if t.slots[base] == k { m = v; break }
                    sl = (sl + 1) & mask
                }
            }
        }
        if anti {
            if m == 0 { w2[r] = wr; kept += 1; if antiNull { nul += wr } }
            else { mat += wr * (if antiNull { m } else { 1 }) }
        } else {
            kept += 1
            if m > 0 { let nw = wr * m; w2[r] = nw; mat += nw } else { w2[r] = wr; nul += wr }
        }
    }
    matched += mat
    nulls += nul
    return kept
}

// Vectorized batch terminal count probe for JK_INT (isLast).
pub fn (t: &FastIntCount) sumLast1W(at0: &[]int, kv: &[]int, knul: &[]bool, ws: &[]int, n: int,
                                    left: bool, anti: bool, antiNull: bool,
                                    acc: mut &int, matched: mut &int, nulls: mut &int) {
    let tLen = t.len
    let mask = t.mask
    let bfMask = t.bfMask
    let hasBf = bfMask >= 0
    var a = 0
    var mat = 0
    var nul = 0
    if !left && !anti {
        if tLen == 0 { return }
        for r in 0..n {
            let wr = ws[r]
            if wr == 0 { continue }
            let sr = at0[r]
            if sr < 0 || knul[sr] { continue }
            let k = kv[sr]
            var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
            h = h ^ (h >> 27)
            if hasBf {
                let b = (u64(1) << ((h >> 24) & 63)) |
                        (u64(1) << ((h >> 30) & 63)) |
                        (u64(1) << ((h >> 36) & 63))
                if (t.bf[h & bfMask] & b) != b { continue }
            }
            var sl = h & mask
            while true {
                let base = sl * 2
                let v = t.slots[base + 1]
                if v == 0 { break }
                if t.slots[base] == k { a += wr * v; break }
                sl = (sl + 1) & mask
            }
        }
        acc += a
        matched += a
        return
    }
    for r in 0..n {
        let wr = ws[r]
        if wr == 0 { continue }
        let sr = at0[r]
        var m = 0
        if tLen > 0 && sr >= 0 && !knul[sr] {
            let k = kv[sr]
            var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
            h = h ^ (h >> 27)
            var ok = true
            if hasBf {
                let b = (u64(1) << ((h >> 24) & 63)) |
                        (u64(1) << ((h >> 30) & 63)) |
                        (u64(1) << ((h >> 36) & 63))
                if (t.bf[h & bfMask] & b) != b { ok = false }
            }
            if ok {
                var sl = h & mask
                while true {
                    let base = sl * 2
                    let v = t.slots[base + 1]
                    if v == 0 { break }
                    if t.slots[base] == k { m = v; break }
                    sl = (sl + 1) & mask
                }
            }
        }
        if anti {
            if m == 0 { a += wr; if antiNull { nul += wr } }
            else { mat += wr * (if antiNull { m } else { 1 }) }
        } else {
            if m > 0 { let nw = wr * m; a += nw; mat += nw } else { a += wr; nul += wr }
        }
    }
    acc += a
    matched += mat
    nulls += nul
}

// Vectorized batch terminal count probe for packed 2x32-bit JK_INT2 (isLast).
pub fn (t: &FastIntCount) sumLast2W(at0: &[]int, at1: &[]int, kv0: &[]int, nul0: &[]bool,
                                    kv1: &[]int, nul1: &[]bool, ws: &[]int, n: int,
                                    left: bool, anti: bool, antiNull: bool,
                                    acc: mut &int, matched: mut &int, nulls: mut &int) {
    let tLen = t.len
    let mask = t.mask
    let bfMask = t.bfMask
    let hasBf = bfMask >= 0
    var a = 0
    var mat = 0
    var nul = 0
    if !left && !anti {
        if tLen == 0 { return }
        for r in 0..n {
            let wr = ws[r]
            if wr == 0 { continue }
            let sr0 = at0[r]
            let sr1 = at1[r]
            if sr0 < 0 || sr1 < 0 || nul0[sr0] || nul1[sr1] { continue }
            let v0 = kv0[sr0]
            let v1 = kv1[sr1]
            if v0 < -2147483648 || v0 > 2147483647 || v1 < -2147483648 || v1 > 2147483647 { continue }
            let k = (v0 << 32) | (v1 & 0xFFFFFFFF)
            var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
            h = h ^ (h >> 27)
            if hasBf {
                let b = (u64(1) << ((h >> 24) & 63)) |
                        (u64(1) << ((h >> 30) & 63)) |
                        (u64(1) << ((h >> 36) & 63))
                if (t.bf[h & bfMask] & b) != b { continue }
            }
            var sl = h & mask
            while true {
                let base = sl * 2
                let v = t.slots[base + 1]
                if v == 0 { break }
                if t.slots[base] == k { a += wr * v; break }
                sl = (sl + 1) & mask
            }
        }
        acc += a
        matched += a
        return
    }
    for r in 0..n {
        let wr = ws[r]
        if wr == 0 { continue }
        let sr0 = at0[r]
        let sr1 = at1[r]
        var m = 0
        if tLen > 0 && sr0 >= 0 && sr1 >= 0 && !nul0[sr0] && !nul1[sr1] {
            let v0 = kv0[sr0]
            let v1 = kv1[sr1]
            if v0 >= -2147483648 && v0 <= 2147483647 && v1 >= -2147483648 && v1 <= 2147483647 {
                let k = (v0 << 32) | (v1 & 0xFFFFFFFF)
                var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
                h = h ^ (h >> 27)
                var ok = true
                if hasBf {
                    let b = (u64(1) << ((h >> 24) & 63)) |
                            (u64(1) << ((h >> 30) & 63)) |
                            (u64(1) << ((h >> 36) & 63))
                    if (t.bf[h & bfMask] & b) != b { ok = false }
                }
                if ok {
                    var sl = h & mask
                    while true {
                        let base = sl * 2
                        let v = t.slots[base + 1]
                        if v == 0 { break }
                        if t.slots[base] == k { m = v; break }
                        sl = (sl + 1) & mask
                    }
                }
            }
        }
        if anti {
            if m == 0 { a += wr; if antiNull { nul += wr } }
            else { mat += wr * (if antiNull { m } else { 1 }) }
        } else {
            if m > 0 { let nw = wr * m; a += nw; mat += nw } else { a += wr; nul += wr }
        }
    }
    acc += a
    matched += mat
    nulls += nul
}

// ============================================================================
// 0a. FastIntMap: Flat power-of-2 open-addressed int -> bucket hash table
//     with cache-line-packed [k, bucket + 1] slots and L3 Bloom pre-filter.
// ============================================================================

pub type FastIntMap = record {
    pub slots: []int    // interleaved [k, bucket + 1] per slot (0 = empty)
    mask: int
    len: int
    bf: []u64
    bfMask: int
}

pub fn newFastIntMap(): FastIntMap {
    return FastIntMap{slots: [], mask: 0, len: 0, bf: [], bfMask: -1}
}

pub fn (t: &FastIntMap) size(): int { return t.len }

// Zero-rehash O(cap) conversion of FastIntMap (key -> bucket+1) into FastIntCount (key -> bucketW[bucket])
// when every bucket has weight > 0. Moves slots and Bloom filter directly (0 allocs, 0 hashes).
pub fn (t: mut &FastIntMap) intoWeightedCount(bucketW: &[]int): FastIntCount {
    var slots = replace(mut &t.slots, [])
    var bf = replace(mut &t.bf, [])
    let mask = t.mask
    let n = t.len
    let bfMask = t.bfMask
    t.mask = 0
    t.len = 0
    t.bfMask = -1
    var i = 0
    let sl = len(slots)
    while i < sl {
        let v = slots[i + 1]
        if v != 0 { slots[i + 1] = bucketW[v - 1] }
        i += 2
    }
    return FastIntCount{slots: slots, mask: mask, len: n, bf: bf, bfMask: bfMask}
}

fn (t: mut &FastIntMap) grow() {
    let cap = if len(t.slots) == 0 { 1024 } else { len(t.slots) } // len(slots) == oldCap * 2
    let mask = cap - 1
    var ns: []int = array(cap * 2, 0)
    var i = 0
    let nOld = len(t.slots)
    while i < nOld {
        let v = t.slots[i + 1]
        if v != 0 {
            let k = t.slots[i]
            var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
            h = h ^ (h >> 27)
            var sl = h & mask
            while ns[sl * 2 + 1] != 0 { sl = (sl + 1) & mask }
            ns[sl * 2] = k
            ns[sl * 2 + 1] = v
        }
        i += 2
    }
    t.slots = ns
    t.mask = mask
}

// Returns existing bucket (>= 0) or inserts nextBk and returns nextBk.
pub fn (t: mut &FastIntMap) getOrPut(k: int, nextBk: int): int {
    let cap = len(t.slots) / 2
    if cap == 0 || (t.len + 1) * 10 >= cap * 6 {
        t.grow()
    }
    let mask = t.mask
    var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
    h = h ^ (h >> 27)
    var sl = h & mask
    while true {
        let base = sl * 2
        let v = t.slots[base + 1]
        if v == 0 {
            t.slots[base] = k
            t.slots[base + 1] = nextBk + 1
            t.len += 1
            return nextBk
        }
        if t.slots[base] == k {
            return v - 1
        }
        sl = (sl + 1) & mask
    }
    return nextBk
}

pub fn (t: mut &FastIntMap) buildFilter(room: int) {
    let words = bloomWords(t.len, room)
    if words == 0 { return }
    let bm = words - 1
    var bf: []u64 = array(words, u64(0))
    var i = 0
    let n = len(t.slots)
    while i < n {
        if t.slots[i + 1] != 0 {
            let k = t.slots[i]
            var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
            h = h ^ (h >> 27)
            let wi = h & bm
            let b = (u64(1) << ((h >> 24) & 63)) |
                    (u64(1) << ((h >> 30) & 63)) |
                    (u64(1) << ((h >> 36) & 63))
            bf[wi] = bf[wi] | b
        }
        i += 2
    }
    t.bf = bf
    t.bfMask = bm
}

pub fn (t: &FastIntMap) get(k: int): int {
    if t.len == 0 { return -1 }
    var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
    h = h ^ (h >> 27)
    if t.bfMask >= 0 {
        let b = (u64(1) << ((h >> 24) & 63)) |
                (u64(1) << ((h >> 30) & 63)) |
                (u64(1) << ((h >> 36) & 63))
        if (t.bf[h & t.bfMask] & b) != b { return -1 }
    }
    let mask = t.mask
    var sl = h & mask
    while true {
        let base = sl * 2
        let v = t.slots[base + 1]
        if v == 0 { return -1 }
        if t.slots[base] == k { return v - 1 }
        sl = (sl + 1) & mask
    }
    return -1
}

// Vectorized batch probe for neqCountOnly JK_INT joins (outer_col <> inner_col with no cols read above).
// neqMeta holds 3 ints per bucket: [totRows, tagOrOff, valOrCnt] (tagOrOff == -1 => single non-null value in valOrCnt).
// If isLast, accumulates directly into acc; otherwise writes w2[r] = ws[r] * hits (0 for dropped rows) and returns kept count.
pub fn (t: &FastIntMap) neqCountW(at0: &[]int, kv: &[]int, knul: &[]bool,
                                  nat: &[]int, nkv: &[]int, nknul: &[]bool,
                                  neqMeta: &[]int, neqVals: &[]int,
                                  ws: &[]int, n: int, isLast: bool,
                                  w2: mut &[]int, acc: mut &int, totRead: mut &int, sumW: mut &int): int {
    let tLen = t.len
    let mask = t.mask
    let bfMask = t.bfMask
    let hasBf = bfMask >= 0
    var a = 0
    var tr = 0
    var sw = 0
    var kept = 0
    for r in 0..n {
        let wr = ws[r]
        if wr == 0 { continue }
        sw += wr
        if tLen == 0 { continue }
        let sr = at0[r]
        let nsr = nat[r]
        if sr < 0 || nsr < 0 || knul[sr] || nknul[nsr] { continue }
        let k = kv[sr]
        var h = (k ^ (k >> 30)) *% 0x2545f4914f6cdd1d
        h = h ^ (h >> 27)
        if hasBf {
            let b = (u64(1) << ((h >> 24) & 63)) |
                    (u64(1) << ((h >> 30) & 63)) |
                    (u64(1) << ((h >> 36) & 63))
            if (t.bf[h & bfMask] & b) != b { continue }
        }
        var sl = h & mask
        var bk = -1
        while true {
            let base = sl * 2
            let v = t.slots[base + 1]
            if v == 0 { break }
            if t.slots[base] == k { bk = v - 1; break }
            sl = (sl + 1) & mask
        }
        if bk >= 0 {
            let mb = bk * 3
            let seen = neqMeta[mb]
            let tag = neqMeta[mb + 1]
            let ov = nkv[nsr]
            var hits = 0
            if tag == -1 {
                if neqMeta[mb + 2] != ov { hits = 1 }
            } else if tag >= 0 {
                let end = tag + neqMeta[mb + 2]
                for p in tag..end {
                    if neqVals[p] != ov { hits += 1 }
                }
            }
            tr += wr * seen
            if hits > 0 {
                let nw = wr * hits
                a += nw
                if !isLast {
                    w2[r] = nw
                    kept += 1
                }
            }
        }
    }
    acc += a
    totRead += tr
    sumW += sw
    return kept
}

// ============================================================================
// 0b. FastInt2Count & FastInt2Map: Flat open-addressed (int64, int64) tables
//     with cache-line-packed [k0, k1, v] slots and L3 Bloom pre-filters.
// ============================================================================

pub type FastInt2Count = record {
    slots: []int        // interleaved [k0, k1, v] per slot (v == 0 means empty)
    mask: int
    len: int
    bf: []u64
    bfMask: int
}

// 16-byte/slot [k0, k1] set for MK_ANTI JK_INT2_64 joins (33% smaller than FastInt2Count; fits closer to L3!).
const SET2_EMPTY = -9223372036854775807 - 1

pub type FastInt2Set = record {
    slots: []int        // interleaved [k0, k1] per slot (k0 == SET2_EMPTY means empty)
    mask: int
    len: int
    minK1: []int        // overflow for rare k0 == SET2_EMPTY keys
    bf: []u64
    bfMask: int
}

pub fn newFastInt2Set(): FastInt2Set {
    return FastInt2Set{slots: [], mask: 0, len: 0, minK1: [], bf: [], bfMask: -1}
}

pub fn (t: &FastInt2Set) size(): int { return t.len }

fn (t: mut &FastInt2Set) grow() {
    let cap = if len(t.slots) == 0 { 1024 } else { len(t.slots) }
    let mask = cap - 1
    var ns: []int = array(cap * 2, SET2_EMPTY)
    var i = 0
    let nOld = len(t.slots)
    while i < nOld {
        let k0 = t.slots[i]
        if k0 != SET2_EMPTY {
            let k1 = t.slots[i + 1]
            var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
            h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
            h = h ^ (h >> 31)
            var sl = h & mask
            while ns[sl * 2] != SET2_EMPTY { sl = (sl + 1) & mask }
            let base = sl * 2
            ns[base] = k0
            ns[base + 1] = k1
        }
        i += 2
    }
    t.slots = ns
    t.mask = mask
}

pub fn (t: mut &FastInt2Set) add(k0: int, k1: int): bool {
    if k0 == SET2_EMPTY {
        for x in t.minK1 { if x == k1 { return false } }
        append(mut &t.minK1, k1)
        t.len += 1
        return true
    }
    let cap = len(t.slots) / 2
    if cap == 0 || (t.len + 1) * 10 >= cap * 6 {
        t.grow()
    }
    let mask = t.mask
    var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
    h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
    h = h ^ (h >> 31)
    var sl = h & mask
    while true {
        let base = sl * 2
        let s0 = t.slots[base]
        if s0 == SET2_EMPTY {
            t.slots[base] = k0
            t.slots[base + 1] = k1
            t.len += 1
            return true
        }
        if s0 == k0 && t.slots[base + 1] == k1 { return false }
        sl = (sl + 1) & mask
    }
    return false
}

pub fn (t: mut &FastInt2Set) buildFilter(room: int) {
    let words = bloomWords(t.len, room)
    if words == 0 { return }
    let bm = words - 1
    var bf: []u64 = array(words, u64(0))
    var i = 0
    let n = len(t.slots)
    while i < n {
        let k0 = t.slots[i]
        if k0 != SET2_EMPTY {
            var h = (k0 *% 0x517cc1b727220a95) ^ (t.slots[i + 1] *% 0x2545f4914f6cdd1d)
            h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
            h = h ^ (h >> 31)
            let wi = h & bm
            let b = (u64(1) << ((h >> 24) & 63)) |
                    (u64(1) << ((h >> 30) & 63)) |
                    (u64(1) << ((h >> 36) & 63))
            bf[wi] = bf[wi] | b
        }
        i += 2
    }
    for k1 in t.minK1 {
        var h = (SET2_EMPTY *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
        h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
        h = h ^ (h >> 31)
        let wi = h & bm
        let b = (u64(1) << ((h >> 24) & 63)) |
                (u64(1) << ((h >> 30) & 63)) |
                (u64(1) << ((h >> 36) & 63))
        bf[wi] = bf[wi] | b
    }
    t.bf = bf
    t.bfMask = bm
}

pub fn (t: &FastInt2Set) has(k0: int, k1: int): bool {
    if t.len == 0 { return false }
    if k0 == SET2_EMPTY {
        for x in t.minK1 { if x == k1 { return true } }
        return false
    }
    var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
    h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
    h = h ^ (h >> 31)
    if t.bfMask >= 0 {
        let b = (u64(1) << ((h >> 24) & 63)) |
                (u64(1) << ((h >> 30) & 63)) |
                (u64(1) << ((h >> 36) & 63))
        if (t.bf[h & t.bfMask] & b) != b { return false }
    }
    let mask = t.mask
    var sl = h & mask
    while true {
        let base = sl * 2
        let s0 = t.slots[base]
        if s0 == SET2_EMPTY { return false }
        if s0 == k0 && t.slots[base + 1] == k1 { return true }
        sl = (sl + 1) & mask
    }
    return false
}

// Vectorized batch terminal anti-join probe for JK_INT2_64 using compact 16B/slot FastInt2Set.
pub fn (t: &FastInt2Set) sumLastAntiW(at0: &[]int, at1: &[]int, kv0: &[]int, nul0: &[]bool,
                                      kv1: &[]int, nul1: &[]bool, ws: &[]int, n: int,
                                      antiNull: bool, acc: mut &int, matched: mut &int, nulls: mut &int) {
    let tLen = t.len
    let mask = t.mask
    let bfMask = t.bfMask
    let hasBf = bfMask >= 0
    var a = 0
    var mat = 0
    for r in 0..n {
        let wr = ws[r]
        if wr == 0 { continue }
        let sr0 = at0[r]
        let sr1 = at1[r]
        var hit = false
        if tLen > 0 && sr0 >= 0 && sr1 >= 0 && !nul0[sr0] && !nul1[sr1] {
            let k0 = kv0[sr0]
            let k1 = kv1[sr1]
            if k0 == SET2_EMPTY {
                for x in t.minK1 { if x == k1 { hit = true; break } }
            } else {
                var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
                h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
                h = h ^ (h >> 31)
                var ok = true
                if hasBf {
                    let b = (u64(1) << ((h >> 24) & 63)) |
                            (u64(1) << ((h >> 30) & 63)) |
                            (u64(1) << ((h >> 36) & 63))
                    if (t.bf[h & bfMask] & b) != b { ok = false }
                }
                if ok {
                    var sl = h & mask
                    while true {
                        let base = sl * 2
                        let s0 = t.slots[base]
                        if s0 == SET2_EMPTY { break }
                        if s0 == k0 && t.slots[base + 1] == k1 { hit = true; break }
                        sl = (sl + 1) & mask
                    }
                }
            }
        }
        if !hit { a += wr } else { mat += wr }
    }
    acc += a
    matched += mat
    if antiNull { nulls += a }
}

pub fn newFastInt2Count(): FastInt2Count {
    return FastInt2Count{slots: [], mask: 0, len: 0, bf: [], bfMask: -1}
}

pub fn (t: &FastInt2Count) size(): int { return t.len }

fn (t: mut &FastInt2Count) grow() {
    let cap = if len(t.slots) == 0 { 1024 } else { (len(t.slots) / 3) * 2 }
    let mask = cap - 1
    var ns: []int = array(cap * 3, 0)
    var i = 0
    let nOld = len(t.slots)
    while i < nOld {
        let v = t.slots[i + 2]
        if v != 0 {
            let k0 = t.slots[i]
            let k1 = t.slots[i + 1]
            var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
            h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
            h = h ^ (h >> 31)
            var sl = h & mask
            while ns[sl * 3 + 2] != 0 { sl = (sl + 1) & mask }
            let base = sl * 3
            ns[base] = k0
            ns[base + 1] = k1
            ns[base + 2] = v
        }
        i += 3
    }
    t.slots = ns
    t.mask = mask
}

pub fn (t: mut &FastInt2Count) inc(k0: int, k1: int): bool {
    let cap = len(t.slots) / 3
    if cap == 0 || (t.len + 1) * 10 >= cap * 6 {
        t.grow()
    }
    let mask = t.mask
    var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
    h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
    h = h ^ (h >> 31)
    var sl = h & mask
    while true {
        let base = sl * 3
        let v = t.slots[base + 2]
        if v == 0 {
            t.slots[base] = k0
            t.slots[base + 1] = k1
            t.slots[base + 2] = 1
            t.len += 1
            return true
        }
        if t.slots[base] == k0 && t.slots[base + 1] == k1 {
            t.slots[base + 2] = v + 1
            return false
        }
        sl = (sl + 1) & mask
    }
    return false
}

pub fn (t: mut &FastInt2Count) buildFilter(room: int) {
    let words = bloomWords(t.len, room)
    if words == 0 { return }
    let bm = words - 1
    var bf: []u64 = array(words, u64(0))
    var i = 0
    let n = len(t.slots)
    while i < n {
        if t.slots[i + 2] != 0 {
            var h = (t.slots[i] *% 0x517cc1b727220a95) ^ (t.slots[i + 1] *% 0x2545f4914f6cdd1d)
            h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
            h = h ^ (h >> 31)
            let wi = h & bm
            let b = (u64(1) << ((h >> 24) & 63)) |
                    (u64(1) << ((h >> 30) & 63)) |
                    (u64(1) << ((h >> 36) & 63))
            bf[wi] = bf[wi] | b
        }
        i += 3
    }
    t.bf = bf
    t.bfMask = bm
}

pub fn (t: &FastInt2Count) get(k0: int, k1: int): int {
    if t.len == 0 { return 0 }
    var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
    h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
    h = h ^ (h >> 31)
    if t.bfMask >= 0 {
        let b = (u64(1) << ((h >> 24) & 63)) |
                (u64(1) << ((h >> 30) & 63)) |
                (u64(1) << ((h >> 36) & 63))
        if (t.bf[h & t.bfMask] & b) != b { return 0 }
    }
    let mask = t.mask
    var sl = h & mask
    while true {
        let base = sl * 3
        let v = t.slots[base + 2]
        if v == 0 { return 0 }
        if t.slots[base] == k0 && t.slots[base + 1] == k1 { return v }
        sl = (sl + 1) & mask
    }
    return 0
}

// Vectorized batch terminal count probe for JK_INT2_64 (isLast): zero per-row calls.
pub fn (t: &FastInt2Count) sumLastW(at0: &[]int, at1: &[]int, kv0: &[]int, nul0: &[]bool,
                                    kv1: &[]int, nul1: &[]bool, ws: &[]int, n: int,
                                    left: bool, anti: bool, antiNull: bool,
                                    acc: mut &int, matched: mut &int, nulls: mut &int) {
    let tLen = t.len
    let mask = t.mask
    let bfMask = t.bfMask
    let hasBf = bfMask >= 0
    var a = 0
    var mat = 0
    var nul = 0
    if anti {
        for r in 0..n {
            let wr = ws[r]
            if wr == 0 { continue }
            let sr0 = at0[r]
            let sr1 = at1[r]
            var m = 0
            if tLen > 0 && sr0 >= 0 && sr1 >= 0 && !nul0[sr0] && !nul1[sr1] {
                let k0 = kv0[sr0]
                let k1 = kv1[sr1]
                var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
                h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
                h = h ^ (h >> 31)
                var ok = true
                if hasBf {
                    let b = (u64(1) << ((h >> 24) & 63)) |
                            (u64(1) << ((h >> 30) & 63)) |
                            (u64(1) << ((h >> 36) & 63))
                    if (t.bf[h & bfMask] & b) != b { ok = false }
                }
                if ok {
                    var sl = h & mask
                    while true {
                        let base = sl * 3
                        let v = t.slots[base + 2]
                        if v == 0 { break }
                        if t.slots[base] == k0 && t.slots[base + 1] == k1 { m = v; break }
                        sl = (sl + 1) & mask
                    }
                }
            }
            if m == 0 { a += wr; if antiNull { nul += wr } }
            else { mat += wr * (if antiNull { m } else { 1 }) }
        }
        acc += a
        matched += mat
        nulls += nul
        return
    }
    if !left {
        if tLen == 0 { return }
        for r in 0..n {
            let wr = ws[r]
            if wr == 0 { continue }
            let sr0 = at0[r]
            let sr1 = at1[r]
            if sr0 < 0 || sr1 < 0 || nul0[sr0] || nul1[sr1] { continue }
            let k0 = kv0[sr0]
            let k1 = kv1[sr1]
            var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
            h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
            h = h ^ (h >> 31)
            if hasBf {
                let b = (u64(1) << ((h >> 24) & 63)) |
                        (u64(1) << ((h >> 30) & 63)) |
                        (u64(1) << ((h >> 36) & 63))
                if (t.bf[h & bfMask] & b) != b { continue }
            }
            var sl = h & mask
            while true {
                let base = sl * 3
                let v = t.slots[base + 2]
                if v == 0 { break }
                if t.slots[base] == k0 && t.slots[base + 1] == k1 { a += wr * v; break }
                sl = (sl + 1) & mask
            }
        }
        acc += a
        matched += a
        return
    }
    for r in 0..n {
        let wr = ws[r]
        if wr == 0 { continue }
        let sr0 = at0[r]
        let sr1 = at1[r]
        var m = 0
        if tLen > 0 && sr0 >= 0 && sr1 >= 0 && !nul0[sr0] && !nul1[sr1] {
            let k0 = kv0[sr0]
            let k1 = kv1[sr1]
            var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
            h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
            h = h ^ (h >> 31)
            var ok = true
            if hasBf {
                let b = (u64(1) << ((h >> 24) & 63)) |
                        (u64(1) << ((h >> 30) & 63)) |
                        (u64(1) << ((h >> 36) & 63))
                if (t.bf[h & bfMask] & b) != b { ok = false }
            }
            if ok {
                var sl = h & mask
                while true {
                    let base = sl * 3
                    let v = t.slots[base + 2]
                    if v == 0 { break }
                    if t.slots[base] == k0 && t.slots[base + 1] == k1 { m = v; break }
                    sl = (sl + 1) & mask
                }
            }
        }
        if m > 0 { let nw = wr * m; a += nw; mat += nw } else { a += wr; nul += wr }
    }
    acc += a
    matched += mat
    nulls += nul
}

pub type FastInt2Map = record {
    slots: []int        // interleaved [k0, k1, bucket + 1] per slot (0 = empty)
    mask: int
    len: int
    bf: []u64
    bfMask: int
}

pub fn newFastInt2Map(): FastInt2Map {
    return FastInt2Map{slots: [], mask: 0, len: 0, bf: [], bfMask: -1}
}

pub fn (t: &FastInt2Map) size(): int { return t.len }

fn (t: mut &FastInt2Map) grow() {
    let cap = if len(t.slots) == 0 { 1024 } else { (len(t.slots) / 3) * 2 }
    let mask = cap - 1
    var ns: []int = array(cap * 3, 0)
    var i = 0
    let nOld = len(t.slots)
    while i < nOld {
        let v = t.slots[i + 2]
        if v != 0 {
            let k0 = t.slots[i]
            let k1 = t.slots[i + 1]
            var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
            h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
            h = h ^ (h >> 31)
            var sl = h & mask
            while ns[sl * 3 + 2] != 0 { sl = (sl + 1) & mask }
            let base = sl * 3
            ns[base] = k0
            ns[base + 1] = k1
            ns[base + 2] = v
        }
        i += 3
    }
    t.slots = ns
    t.mask = mask
}

// Returns existing bucket (>= 0) or inserts nextBk and returns nextBk.
pub fn (t: mut &FastInt2Map) getOrPut(k0: int, k1: int, nextBk: int): int {
    let cap = len(t.slots) / 3
    if cap == 0 || (t.len + 1) * 10 >= cap * 6 {
        t.grow()
    }
    let mask = t.mask
    var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
    h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
    h = h ^ (h >> 31)
    var sl = h & mask
    while true {
        let base = sl * 3
        let v = t.slots[base + 2]
        if v == 0 {
            t.slots[base] = k0
            t.slots[base + 1] = k1
            t.slots[base + 2] = nextBk + 1
            t.len += 1
            return nextBk
        }
        if t.slots[base] == k0 && t.slots[base + 1] == k1 {
            return v - 1
        }
        sl = (sl + 1) & mask
    }
    return nextBk
}

pub fn (t: mut &FastInt2Map) buildFilter(room: int) {
    let words = bloomWords(t.len, room)
    if words == 0 { return }
    let bm = words - 1
    var bf: []u64 = array(words, u64(0))
    var i = 0
    let n = len(t.slots)
    while i < n {
        if t.slots[i + 2] != 0 {
            var h = (t.slots[i] *% 0x517cc1b727220a95) ^ (t.slots[i + 1] *% 0x2545f4914f6cdd1d)
            h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
            h = h ^ (h >> 31)
            let wi = h & bm
            let b = (u64(1) << ((h >> 24) & 63)) |
                    (u64(1) << ((h >> 30) & 63)) |
                    (u64(1) << ((h >> 36) & 63))
            bf[wi] = bf[wi] | b
        }
        i += 3
    }
    t.bf = bf
    t.bfMask = bm
}

pub fn (t: &FastInt2Map) get(k0: int, k1: int): int {
    if t.len == 0 { return -1 }
    var h = (k0 *% 0x517cc1b727220a95) ^ (k1 *% 0x2545f4914f6cdd1d)
    h = (h ^ (h >> 30)) *% 0x3c79ac492ba7b653
    h = h ^ (h >> 31)
    if t.bfMask >= 0 {
        let b = (u64(1) << ((h >> 24) & 63)) |
                (u64(1) << ((h >> 30) & 63)) |
                (u64(1) << ((h >> 36) & 63))
        if (t.bf[h & t.bfMask] & b) != b { return -1 }
    }
    let mask = t.mask
    var sl = h & mask
    while true {
        let base = sl * 3
        let v = t.slots[base + 2]
        if v == 0 { return -1 }
        if t.slots[base] == k0 && t.slots[base + 1] == k1 { return v - 1 }
        sl = (sl + 1) & mask
    }
    return -1
}

// ============================================================================
// 1. TwoLevelInt: Adaptive two-level flat hash table for 1-int/bool GROUP BY
// ============================================================================

type IntBucket = record {
    ht: []int           // slot -> local index + 1 (0 = empty)
    ks: []int           // local index -> key
    gids: []int         // local index -> global group id
}

fn newIntBucket(): IntBucket { return IntBucket{ht: [], ks: [], gids: []} }

fn (bk: mut &IntBucket) grow() {
    let cap = if len(bk.ht) == 0 { 128 } else { len(bk.ht) * 2 }
    let mask = cap - 1
    var nht: []int = array(cap, 0)
    for i in 0..len(bk.ks) {
        var sl = slotMask(hashInt(bk.ks[i]), mask)
        while nht[sl] != 0 { sl = (sl + 1) & mask }
        nht[sl] = i + 1
    }
    bk.ht = nht
}

fn (bk: &IntBucket) find(k: int, h: u64): int {
    let cap = len(bk.ht)
    if cap == 0 { return -1 }
    let mask = cap - 1
    var sl = slotMask(h, mask)
    while true {
        let e = bk.ht[sl]
        if e == 0 { return -1 }
        let loc = e - 1
        if bk.ks[loc] == k { return bk.gids[loc] }
        sl = (sl + 1) & mask
    }
    return -1
}

fn (bk: mut &IntBucket) insert(k: int, h: u64, gid: int) {
    let loc = len(bk.ks)
    append(mut &bk.ks, k)
    append(mut &bk.gids, gid)
    if len(bk.ht) == 0 || (loc + 1) * 10 >= len(bk.ht) * 7 {
        bk.grow()
    } else {
        let mask = len(bk.ht) - 1
        var sl = slotMask(h, mask)
        while bk.ht[sl] != 0 { sl = (sl + 1) & mask }
        bk.ht[sl] = loc + 1
    }
}

pub type TwoLevelInt = record {
    pub twoLevel: bool
    ht: []int               // Level 1: slot -> local idx + 1
    ks: []int               // Level 1: local idx -> key
    gids: []int             // Level 1: local idx -> gid
    bkts: []IntBucket       // Level 2: 256 buckets
    pub keyByGid: []int     // gid -> key (for zero-copy fv elision; populated only if trackKeys)
    pub trackKeys: bool
}

pub fn newTwoLevelInt(trackKeys: bool): TwoLevelInt {
    return TwoLevelInt{twoLevel: false, ht: [], ks: [], gids: [], bkts: [], keyByGid: [], trackKeys: trackKeys}
}

fn (t: mut &TwoLevelInt) growL1() {
    let cap = if len(t.ht) == 0 { 1024 } else { len(t.ht) * 2 }
    let mask = cap - 1
    var nht: []int = array(cap, 0)
    for i in 0..len(t.ks) {
        var sl = slotMask(hashInt(t.ks[i]), mask)
        while nht[sl] != 0 { sl = (sl + 1) & mask }
        nht[sl] = i + 1
    }
    t.ht = nht
}

fn (t: mut &TwoLevelInt) promote() {
    var bkts: []IntBucket = withCapacity(NBUCKETS)
    for _ in 0..NBUCKETS { append(mut &bkts, newIntBucket()) }
    for i in 0..len(t.ks) {
        let k = t.ks[i]
        let h = hashInt(k)
        let b = bucketOf(h)
        bkts[b].insert(k, h, t.gids[i])
    }
    t.bkts = bkts
    t.ht = []
    t.ks = []
    t.gids = []
    t.twoLevel = true
}

pub fn (t: &TwoLevelInt) get(k: int): int {
    let h = hashInt(k)
    if t.twoLevel { return t.bkts[bucketOf(h)].find(k, h) }
    let cap = len(t.ht)
    if cap == 0 { return -1 }
    let mask = cap - 1
    var sl = slotMask(h, mask)
    while true {
        let e = t.ht[sl]
        if e == 0 { return -1 }
        let loc = e - 1
        if t.ks[loc] == k { return t.gids[loc] }
        sl = (sl + 1) & mask
    }
    return -1
}

pub fn (t: mut &TwoLevelInt) put(k: int, gid: int) {
    if t.trackKeys {
        while len(t.keyByGid) <= gid { append(mut &t.keyByGid, 0) }
        t.keyByGid[gid] = k
    }
    if !t.twoLevel && len(t.ks) >= TWO_LEVEL_THRESH { t.promote() }
    let h = hashInt(k)
    if t.twoLevel {
        t.bkts[bucketOf(h)].insert(k, h, gid)
        return
    }
    let loc = len(t.ks)
    append(mut &t.ks, k)
    append(mut &t.gids, gid)
    if len(t.ht) == 0 || (loc + 1) * 10 >= len(t.ht) * 7 {
        t.growL1()
    } else {
        let mask = len(t.ht) - 1
        var sl = slotMask(h, mask)
        while t.ht[sl] != 0 { sl = (sl + 1) & mask }
        t.ht[sl] = loc + 1
    }
}

pub fn (t: &TwoLevelInt) keyAt(gid: int): int { return t.keyByGid[gid] }

pub fn (t: &TwoLevelInt) bktLen(b: int): int { return len(t.bkts[b].ks) }
pub fn (t: &TwoLevelInt) bktKey(b: int, i: int): int { return t.bkts[b].ks[i] }
pub fn (t: &TwoLevelInt) bktGid(b: int, i: int): int { return t.bkts[b].gids[i] }

pub fn (t: mut &TwoLevelInt) prePromote() {
    if t.twoLevel { return }
    var bkts: []IntBucket = withCapacity(NBUCKETS)
    for _ in 0..NBUCKETS { append(mut &bkts, newIntBucket()) }
    t.bkts = bkts
    t.twoLevel = true
}

pub fn (t: mut &TwoLevelInt) getOrPut(k: int, nextGid: int): int {
    let h = hashInt(k)
    if t.twoLevel {
        let bk = mut &t.bkts[bucketOf(h)]
        let got = bk.find(k, h)
        if got >= 0 { return got }
        bk.insert(k, h, nextGid)
        if t.trackKeys {
            while len(t.keyByGid) <= nextGid { append(mut &t.keyByGid, 0) }
            t.keyByGid[nextGid] = k
        }
        return nextGid
    }
    let cap = len(t.ht)
    if cap > 0 {
        let mask = cap - 1
        var sl = slotMask(h, mask)
        while true {
            let e = t.ht[sl]
            if e == 0 { break }
            let loc = e - 1
            if t.ks[loc] == k { return t.gids[loc] }
            sl = (sl + 1) & mask
        }
    }
    t.put(k, nextGid)
    return nextGid
}

// Batch-grouped cache-friendly probe for Level 2: fills outGid[j] with existing gid or -1.
pub fn (t: &TwoLevelInt) probeBatch(ks: &[]int, nul: &[]bool, nc: int, outGid: mut &[]int) {
    if !t.twoLevel {
        let cap = len(t.ht)
        if cap == 0 {
            for j in 0..nc { outGid[j] = -1 }
            return
        }
        let mask = cap - 1
        for j in 0..nc {
            if nul[j] { outGid[j] = -1; continue }
            let k = ks[j]
            var sl = slotMask(hashInt(k), mask)
            var found = -1
            while true {
                let e = t.ht[sl]
                if e == 0 { break }
                let loc = e - 1
                if t.ks[loc] == k { found = t.gids[loc]; break }
                sl = (sl + 1) & mask
            }
            outGid[j] = found
        }
        return
    }
    // Level 2: hash batch, radix-scatter by 256 buckets, probe each bucket consecutively in L1/L2!
    var hs: []u64 = array(nc, u64(0))
    var cnt: []int = array(NBUCKETS, 0)
    for j in 0..nc {
        if nul[j] { outGid[j] = -1; continue }
        let h = hashInt(ks[j])
        hs[j] = h
        cnt[bucketOf(h)] += 1
    }
    var off: []int = array(NBUCKETS, 0)
    var total = 0
    for b in 0..NBUCKETS { off[b] = total; total += cnt[b] }
    if total == 0 { return }
    var pos = collections.copyOf(&off)
    var ord: []int = array(total, 0)
    for j in 0..nc {
        if nul[j] { continue }
        let b = bucketOf(hs[j])
        ord[pos[b]] = j
        pos[b] += 1
    }
    for b in 0..NBUCKETS {
        let n = cnt[b]
        if n == 0 { continue }
        let st = off[b]
        let bk = &t.bkts[b]
        let cap = len(bk.ht)
        if cap == 0 {
            for p in st..(st + n) { outGid[ord[p]] = -1 }
            continue
        }
        let mask = cap - 1
        for p in st..(st + n) {
            let j = ord[p]
            let k = ks[j]
            var sl = slotMask(hs[j], mask)
            var found = -1
            while true {
                let e = bk.ht[sl]
                if e == 0 { break }
                let loc = e - 1
                if bk.ks[loc] == k { found = bk.gids[loc]; break }
                sl = (sl + 1) & mask
            }
            outGid[j] = found
        }
    }
}

// ============================================================================
// 2. TwoLevelTwoInt: Adaptive two-level flat hash table for 2-int/bool GROUP BY
// ============================================================================

type TwoIntBucket = record {
    ht: []int
    k0: []int
    k1: []int
    nu: []byte
    gids: []int
}

fn newTwoIntBucket(): TwoIntBucket { return TwoIntBucket{ht: [], k0: [], k1: [], nu: [], gids: []} }

fn (bk: mut &TwoIntBucket) grow() {
    let cap = if len(bk.ht) == 0 { 128 } else { len(bk.ht) * 2 }
    let mask = cap - 1
    var nht: []int = array(cap, 0)
    for i in 0..len(bk.k0) {
        var sl = slotMask(hashTwoInt(bk.k0[i], bk.k1[i], bk.nu[i]), mask)
        while nht[sl] != 0 { sl = (sl + 1) & mask }
        nht[sl] = i + 1
    }
    bk.ht = nht
}

fn (bk: &TwoIntBucket) find(a: int, b: int, nu: byte, h: u64): int {
    let cap = len(bk.ht)
    if cap == 0 { return -1 }
    let mask = cap - 1
    var sl = slotMask(h, mask)
    while true {
        let e = bk.ht[sl]
        if e == 0 { return -1 }
        let loc = e - 1
        if bk.k0[loc] == a && bk.k1[loc] == b && bk.nu[loc] == nu { return bk.gids[loc] }
        sl = (sl + 1) & mask
    }
    return -1
}

fn (bk: mut &TwoIntBucket) insert(a: int, b: int, nu: byte, h: u64, gid: int): int {
    let loc = len(bk.k0)
    append(mut &bk.k0, a)
    append(mut &bk.k1, b)
    append(mut &bk.nu, nu)
    append(mut &bk.gids, gid)
    if len(bk.ht) == 0 || (loc + 1) * 10 >= len(bk.ht) * 7 {
        bk.grow()
    } else {
        let mask = len(bk.ht) - 1
        var sl = slotMask(h, mask)
        while bk.ht[sl] != 0 { sl = (sl + 1) & mask }
        bk.ht[sl] = loc + 1
    }
    return loc
}

pub type TwoLevelTwoInt = record {
    pub twoLevel: bool
    ht: []int
    k0: []int
    k1: []int
    nu: []byte
    bkts: []TwoIntBucket
    // Compact gid -> (bucket, localIdx) for zero-copy key reconstruction at finish()
    gidBkt: []byte
    gidLoc: []int
}

pub fn newTwoLevelTwoInt(): TwoLevelTwoInt {
    return TwoLevelTwoInt{twoLevel: false, ht: [], k0: [], k1: [], nu: [], bkts: [], gidBkt: [], gidLoc: []}
}

fn (t: mut &TwoLevelTwoInt) growL1() {
    let cap = if len(t.ht) == 0 { 1024 } else { len(t.ht) * 2 }
    let mask = cap - 1
    var nht: []int = array(cap, 0)
    for g in 0..len(t.k0) {
        var sl = slotMask(hashTwoInt(t.k0[g], t.k1[g], t.nu[g]), mask)
        while nht[sl] != 0 { sl = (sl + 1) & mask }
        nht[sl] = g + 1
    }
    t.ht = nht
}

fn (t: mut &TwoLevelTwoInt) promote() {
    let n = len(t.k0)
    var bkts: []TwoIntBucket = withCapacity(NBUCKETS)
    for _ in 0..NBUCKETS { append(mut &bkts, newTwoIntBucket()) }
    var gb: []byte = array(n, byte(0))
    var gl: []int = array(n, 0)
    for g in 0..n {
        let h = hashTwoInt(t.k0[g], t.k1[g], t.nu[g])
        let b = bucketOf(h)
        let loc = bkts[b].insert(t.k0[g], t.k1[g], t.nu[g], h, g)
        gb[g] = byte(b)
        gl[g] = loc
    }
    t.bkts = bkts
    t.gidBkt = gb
    t.gidLoc = gl
    t.ht = []
    t.k0 = []
    t.k1 = []
    t.nu = []
    t.twoLevel = true
}

pub fn (t: &TwoLevelTwoInt) get(a: int, b: int, nu: byte): int {
    let h = hashTwoInt(a, b, nu)
    if t.twoLevel { return t.bkts[bucketOf(h)].find(a, b, nu, h) }
    let cap = len(t.ht)
    if cap == 0 { return -1 }
    let mask = cap - 1
    var sl = slotMask(h, mask)
    while true {
        let e = t.ht[sl]
        if e == 0 { return -1 }
        let g = e - 1
        if t.k0[g] == a && t.k1[g] == b && t.nu[g] == nu { return g }
        sl = (sl + 1) & mask
    }
    return -1
}

pub fn (t: mut &TwoLevelTwoInt) put(a: int, b: int, nu: byte, gid: int) {
    if !t.twoLevel && len(t.k0) >= TWO_LEVEL_THRESH { t.promote() }
    let h = hashTwoInt(a, b, nu)
    if t.twoLevel {
        let bi = bucketOf(h)
        let loc = t.bkts[bi].insert(a, b, nu, h, gid)
        append(mut &t.gidBkt, byte(bi))
        append(mut &t.gidLoc, loc)
        return
    }
    append(mut &t.k0, a)
    append(mut &t.k1, b)
    append(mut &t.nu, nu)
    if len(t.ht) == 0 || len(t.k0) * 10 >= len(t.ht) * 7 {
        t.growL1()
    } else {
        let mask = len(t.ht) - 1
        var sl = slotMask(h, mask)
        while t.ht[sl] != 0 { sl = (sl + 1) & mask }
        t.ht[sl] = gid + 1
    }
}

pub fn (t: &TwoLevelTwoInt) key0At(gid: int): int {
    if !t.twoLevel { return t.k0[gid] }
    return t.bkts[int(t.gidBkt[gid])].k0[t.gidLoc[gid]]
}

pub fn (t: &TwoLevelTwoInt) key1At(gid: int): int {
    if !t.twoLevel { return t.k1[gid] }
    return t.bkts[int(t.gidBkt[gid])].k1[t.gidLoc[gid]]
}

pub fn (t: &TwoLevelTwoInt) nuAt(gid: int): byte {
    if !t.twoLevel { return t.nu[gid] }
    return t.bkts[int(t.gidBkt[gid])].nu[t.gidLoc[gid]]
}

pub fn (t: &TwoLevelTwoInt) bktLen(b: int): int { return len(t.bkts[b].k0) }
pub fn (t: &TwoLevelTwoInt) bktK0(b: int, i: int): int { return t.bkts[b].k0[i] }
pub fn (t: &TwoLevelTwoInt) bktK1(b: int, i: int): int { return t.bkts[b].k1[i] }
pub fn (t: &TwoLevelTwoInt) bktNu(b: int, i: int): byte { return t.bkts[b].nu[i] }
pub fn (t: &TwoLevelTwoInt) bktGid(b: int, i: int): int { return t.bkts[b].gids[i] }

pub fn (t: mut &TwoLevelTwoInt) prePromote(estCap: int) {
    if t.twoLevel { return }
    var bkts: []TwoIntBucket = withCapacity(NBUCKETS)
    for _ in 0..NBUCKETS { append(mut &bkts, newTwoIntBucket()) }
    t.bkts = bkts
    if estCap > 0 {
        t.gidBkt = withCapacity(estCap)
        t.gidLoc = withCapacity(estCap)
    }
    t.twoLevel = true
}

pub fn (t: mut &TwoLevelTwoInt) getOrPut(a: int, b: int, nu: byte, nextGid: int): int {
    let h = hashTwoInt(a, b, nu)
    if t.twoLevel {
        let bi = bucketOf(h)
        let bk = mut &t.bkts[bi]
        let got = bk.find(a, b, nu, h)
        if got >= 0 { return got }
        let loc = bk.insert(a, b, nu, h, nextGid)
        append(mut &t.gidBkt, byte(bi))
        append(mut &t.gidLoc, loc)
        return nextGid
    }
    let cap = len(t.ht)
    if cap > 0 {
        let mask = cap - 1
        var sl = slotMask(h, mask)
        while true {
            let e = t.ht[sl]
            if e == 0 { break }
            let g = e - 1
            if t.k0[g] == a && t.k1[g] == b && t.nu[g] == nu { return g }
            sl = (sl + 1) & mask
        }
    }
    t.put(a, b, nu, nextGid)
    return nextGid
}

// Batch-grouped cache-friendly probe for TwoLevelTwoInt.
pub fn (t: &TwoLevelTwoInt) probeBatch(v0: &[]int, nul0: &[]bool, v1: &[]int, nul1: &[]bool, nc: int, outGid: mut &[]int) {
    if !t.twoLevel {
        let cap = len(t.ht)
        if cap == 0 {
            for j in 0..nc { outGid[j] = -1 }
            return
        }
        let mask = cap - 1
        for j in 0..nc {
            let n0 = nul0[j]
            let n1 = nul1[j]
            let a = if n0 { 0 } else { v0[j] }
            let b = if n1 { 0 } else { v1[j] }
            let nu = byte((if n0 { 1 } else { 0 }) | (if n1 { 2 } else { 0 }))
            var sl = slotMask(hashTwoInt(a, b, nu), mask)
            var found = -1
            while true {
                let e = t.ht[sl]
                if e == 0 { break }
                let g = e - 1
                if t.k0[g] == a && t.k1[g] == b && t.nu[g] == nu { found = g; break }
                sl = (sl + 1) & mask
            }
            outGid[j] = found
        }
        return
    }
    var hs: []u64 = array(nc, u64(0))
    var cnt: []int = array(NBUCKETS, 0)
    for j in 0..nc {
        let n0 = nul0[j]
        let n1 = nul1[j]
        let a = if n0 { 0 } else { v0[j] }
        let b = if n1 { 0 } else { v1[j] }
        let nu = byte((if n0 { 1 } else { 0 }) | (if n1 { 2 } else { 0 }))
        let h = hashTwoInt(a, b, nu)
        hs[j] = h
        cnt[bucketOf(h)] += 1
    }
    var off: []int = array(NBUCKETS, 0)
    var total = 0
    for b in 0..NBUCKETS { off[b] = total; total += cnt[b] }
    var pos = collections.copyOf(&off)
    var ord: []int = array(nc, 0)
    for j in 0..nc {
        let b = bucketOf(hs[j])
        ord[pos[b]] = j
        pos[b] += 1
    }
    for b in 0..NBUCKETS {
        let n = cnt[b]
        if n == 0 { continue }
        let st = off[b]
        let bk = &t.bkts[b]
        let cap = len(bk.ht)
        if cap == 0 {
            for p in st..(st + n) { outGid[ord[p]] = -1 }
            continue
        }
        let mask = cap - 1
        for p in st..(st + n) {
            let j = ord[p]
            let n0 = nul0[j]
            let n1 = nul1[j]
            let a = if n0 { 0 } else { v0[j] }
            let bb = if n1 { 0 } else { v1[j] }
            let nu = byte((if n0 { 1 } else { 0 }) | (if n1 { 2 } else { 0 }))
            var sl = slotMask(hs[j], mask)
            var found = -1
            while true {
                let e = bk.ht[sl]
                if e == 0 { break }
                let loc = e - 1
                if bk.k0[loc] == a && bk.k1[loc] == bb && bk.nu[loc] == nu { found = bk.gids[loc]; break }
                sl = (sl + 1) & mask
            }
            outGid[j] = found
        }
    }
}

// ============================================================================
// 3. TwoLevelArena: Adaptive Two-Level Bump-Arena String / Bytes Hash Table
//    (zero per-key malloc; 32-bit hash tag in ht + packed 24B ArenaEnt -> 2 cache lines!)
// ============================================================================

type ArenaEnt = value record {
    off: int
    len: int
    gid: int
    hash: u64
}

type ArenaBucket = record {
    arena: str          // contiguous bump-allocated bytes of all distinct keys in this bucket
    ht: []u64           // 0 = empty; else ((h & 0xffffffff00000000) | u64(loc + 1))
    ents: []ArenaEnt    // packed metadata in one contiguous cache-friendly array
}

fn newArenaBucket(): ArenaBucket {
    return ArenaBucket{arena: "", ht: [], ents: []}
}

fn (bk: mut &ArenaBucket) grow() {
    let cap = if len(bk.ht) == 0 { 128 } else { len(bk.ht) * 2 }
    let mask = cap - 1
    var nht: []u64 = array(cap, u64(0))
    for i in 0..len(bk.ents) {
        let h = bk.ents[i].hash
        var sl = slotMask(h, mask)
        while nht[sl] != u64(0) { sl = (sl + 1) & mask }
        nht[sl] = ((h >> 32) << 32) | u64(i + 1)
    }
    bk.ht = nht
}

fn (bk: &ArenaBucket) find(s: &str, h: u64): int {
    let cap = len(bk.ht)
    if cap == 0 { return -1 }
    let mask = cap - 1
    let slen = len(s)
    let tag = h >> 32
    var sl = slotMask(h, mask)
    while true {
        let e = bk.ht[sl]
        if e == u64(0) { return -1 }
        if (e >> 32) == tag {
            let loc = int(e & u64(0xffffffff)) - 1
            let ent = bk.ents[loc]
            if ent.len == slen && ent.hash == h && &bk.arena[ent.off..ent.off + slen] == s {
                return ent.gid
            }
        }
        sl = (sl + 1) & mask
    }
    return -1
}

fn (bk: mut &ArenaBucket) insert(s: &str, h: u64, gid: int): int {
    let loc = len(bk.ents)
    let o = len(bk.arena)
    bk.arena += s
    append(mut &bk.ents, ArenaEnt{off: o, len: len(s), gid: gid, hash: h})
    if len(bk.ht) == 0 || (loc + 1) * 10 >= len(bk.ht) * 7 {
        bk.grow()
    } else {
        let mask = len(bk.ht) - 1
        var sl = slotMask(h, mask)
        while bk.ht[sl] != u64(0) { sl = (sl + 1) & mask }
        bk.ht[sl] = ((h >> 32) << 32) | u64(loc + 1)
    }
    return loc
}

pub type TwoLevelArena = record {
    pub twoLevel: bool
    l1: ArenaBucket         // Level 1: single bump-arena (< TWO_LEVEL_THRESH)
    bkts: []ArenaBucket     // Level 2: 256 L2-resident sub-arenas
    // Optional gid -> (bucket, localIdx) tracking for zero-copy text key reconstruction
    pub trackKeys: bool
    gidBkt: []byte
    gidLoc: []int
}

pub fn newTwoLevelArena(trackKeys: bool): TwoLevelArena {
    return TwoLevelArena{twoLevel: false, l1: newArenaBucket(), bkts: [], trackKeys: trackKeys, gidBkt: [], gidLoc: []}
}

fn (t: mut &TwoLevelArena) promote() {
    var bkts: []ArenaBucket = withCapacity(NBUCKETS)
    for _ in 0..NBUCKETS { append(mut &bkts, newArenaBucket()) }
    let n = len(t.l1.ents)
    for i in 0..n {
        let ent = t.l1.ents[i]
        let b = bucketOf(ent.hash)
        let loc = bkts[b].insert(&t.l1.arena[ent.off..ent.off + ent.len], ent.hash, ent.gid)
        if t.trackKeys {
            while len(t.gidBkt) <= ent.gid { append(mut &t.gidBkt, byte(0)); append(mut &t.gidLoc, -1) }
            t.gidBkt[ent.gid] = byte(b)
            t.gidLoc[ent.gid] = loc
        }
    }
    t.bkts = bkts
    t.l1 = newArenaBucket()
    t.twoLevel = true
}

pub fn (t: &TwoLevelArena) getHash(s: &str, h: u64): int {
    if t.twoLevel { return t.bkts[bucketOf(h)].find(s, h) }
    return t.l1.find(s, h)
}

pub fn (t: &TwoLevelArena) get(s: &str): int {
    return t.getHash(s, hashStr(s))
}

pub fn (t: mut &TwoLevelArena) putHash(s: &str, h: u64, gid: int) {
    if !t.twoLevel && len(t.l1.ents) >= TWO_LEVEL_THRESH { t.promote() }
    if t.twoLevel {
        let b = bucketOf(h)
        let loc = t.bkts[b].insert(s, h, gid)
        if t.trackKeys {
            while len(t.gidBkt) <= gid { append(mut &t.gidBkt, byte(0)); append(mut &t.gidLoc, -1) }
            t.gidBkt[gid] = byte(b)
            t.gidLoc[gid] = loc
        }
        return
    }
    let loc = t.l1.insert(s, h, gid)
    if t.trackKeys {
        while len(t.gidBkt) <= gid { append(mut &t.gidBkt, byte(0)); append(mut &t.gidLoc, -1) }
        t.gidBkt[gid] = byte(0)
        t.gidLoc[gid] = loc
    }
}

pub fn (t: mut &TwoLevelArena) put(s: &str, gid: int) {
    t.putHash(s, hashStr(s), gid)
}

// Batch-grouped cache-friendly probe for BK_TEXT column (radix-scatters 1024-row batch into 256 L2 buckets).
// Exploits T_CLEAF C_DICT encoding where repeated dictionary entries share identical `words[r]`
// ((offset << 24) | len): a tiny per-batch direct-mapped word cache skips hashStr + probe + memcmp!
// Writes precomputed hashes into outHash[j] and found group ID (or -1 on miss/null) into outGid[j].
pub fn (t: &TwoLevelArena) probeTextBatch(buf: &str, words: &[]int, nul: &[]bool, idx: &[]int, nc: int,
                                          outHash: mut &[]u64, outGid: mut &[]int) {
    // Direct-mapped 64-slot per-batch C_DICT word cache (word -> gid when hit >= 0)
    var wcW: []int = array(64, -1)
    var wcG: []int = array(64, -1)
    var prevW = -1
    var prevG = -1
    if !t.twoLevel {
        for j in 0..nc {
            let r = idx[j]
            if nul[r] {
                outGid[j] = -1
                continue
            }
            let w = words[r]
            if w == prevW && prevG >= 0 {
                outGid[j] = prevG
                continue
            }
            let wi = ((w >> 24) ^ w) & 63
            if wcW[wi] == w && wcG[wi] >= 0 {
                let g = wcG[wi]
                outGid[j] = g
                prevW = w
                prevG = g
                continue
            }
            let a = w >> 24
            let sl = &buf[a..a + (w & 0xffffff)]
            let h = hashStr(sl)
            outHash[j] = h
            let g = t.l1.find(sl, h)
            outGid[j] = g
            if g >= 0 {
                wcW[wi] = w
                wcG[wi] = g
                prevW = w
                prevG = g
            }
        }
        return
    }
    var cnt: []int = array(NBUCKETS, 0)
    var dupOf: []int = array(nc, -1)
    var wcJ: []int = array(64, -1)
    var prevJ = -1
    var nUnique = 0
    for j in 0..nc {
        let r = idx[j]
        if nul[r] {
            outGid[j] = -1
            continue
        }
        let w = words[r]
        if w == prevW && prevJ >= 0 {
            dupOf[j] = prevJ
            continue
        }
        let wi = ((w >> 24) ^ w) & 63
        if wcW[wi] == w && wcJ[wi] >= 0 {
            let dj = wcJ[wi]
            dupOf[j] = dj
            prevW = w
            prevJ = dj
            continue
        }
        let a = w >> 24
        let h = hashStr(&buf[a..a + (w & 0xffffff)])
        outHash[j] = h
        cnt[bucketOf(h)] += 1
        wcW[wi] = w
        wcJ[wi] = j
        prevW = w
        prevJ = j
        nUnique += 1
    }
    var off: []int = array(NBUCKETS, 0)
    var total = 0
    for b in 0..NBUCKETS { off[b] = total; total += cnt[b] }
    var pos = collections.copyOf(&off)
    var ord: []int = array(total, 0)
    for j in 0..nc {
        if nul[idx[j]] || dupOf[j] >= 0 { continue }
        let b = bucketOf(outHash[j])
        ord[pos[b]] = j
        pos[b] += 1
    }
    for b in 0..NBUCKETS {
        let n = cnt[b]
        if n == 0 { continue }
        let st = off[b]
        let bk = &t.bkts[b]
        let cap = len(bk.ht)
        if cap == 0 {
            for p in st..(st + n) { outGid[ord[p]] = -1 }
            continue
        }
        for p in st..(st + n) {
            let j = ord[p]
            let r = idx[j]
            let w = words[r]
            let a = w >> 24
            outGid[j] = bk.find(&buf[a..a + (w & 0xffffff)], outHash[j])
        }
    }
    if nUnique < nc {
        for j in 0..nc {
            let dj = dupOf[j]
            if dj >= 0 {
                outGid[j] = outGid[dj]
                outHash[j] = outHash[dj]
            }
        }
    }
}

// Batch-grouped cache-friendly probe for encoded composite keys packed in a single flat buffer `buf`
// (entry j is buf[off[j] .. off[j] + slen[j]]). Radix-scatters across 256 L2 buckets when two-level.
pub fn (t: &TwoLevelArena) probeBufBatch(buf: &str, off: &[]int, slen: &[]int, nc: int,
                                         outHash: mut &[]u64, outGid: mut &[]int) {
    if !t.twoLevel {
        for j in 0..nc {
            let a = off[j]
            let sl = &buf[a..a + slen[j]]
            let h = hashStr(sl)
            outHash[j] = h
            outGid[j] = t.l1.find(sl, h)
        }
        return
    }
    if (t.trackKeys && len(t.gidLoc) < 32768) || nc < 256 {
        for j in 0..nc {
            let a = off[j]
            let sl = &buf[a..a + slen[j]]
            let h = hashStr(sl)
            outHash[j] = h
            let bk = &t.bkts[bucketOf(h)]
            outGid[j] = if len(bk.ht) == 0 { -1 } else { bk.find(sl, h) }
        }
        return
    }
    var cnt: []int = array(NBUCKETS, 0)
    for j in 0..nc {
        let a = off[j]
        let h = hashStr(&buf[a..a + slen[j]])
        outHash[j] = h
        cnt[bucketOf(h)] += 1
    }
    var boff: []int = array(NBUCKETS, 0)
    var total = 0
    for b in 0..NBUCKETS { boff[b] = total; total += cnt[b] }
    var pos = collections.copyOf(&boff)
    var ord: []int = array(total, 0)
    for j in 0..nc {
        let b = bucketOf(outHash[j])
        ord[pos[b]] = j
        pos[b] += 1
    }
    for b in 0..NBUCKETS {
        let n = cnt[b]
        if n == 0 { continue }
        let st = boff[b]
        let bk = &t.bkts[b]
        let cap = len(bk.ht)
        if cap == 0 {
            for p in st..(st + n) { outGid[ord[p]] = -1 }
            continue
        }
        for p in st..(st + n) {
            let j = ord[p]
            let a = off[j]
            outGid[j] = bk.find(&buf[a..a + slen[j]], outHash[j])
        }
    }
}

// ============================================================================
// 3b. StrGidMemo: Direct-Mapped Input-String -> GroupID Memoization Cache
//     (speeds up expensive pure unary text transforms like REGEXP_REPLACE in GROUP BY!)
// ============================================================================

const MEMO_SLOTS = 16384
const MEMO_MASK = 16383
const MEMO_ARENA_MAX = 4 * 1024 * 1024   // cap arena at 4 MB; resets cleanly when full

pub type StrGidMemo = record {
    arena: str
    hash: []u64
    off: []int
    slen: []int
    gid: []int
    ready: bool
}

pub fn newStrGidMemo(): StrGidMemo {
    return StrGidMemo{arena: "", hash: [], off: [], slen: [], gid: [], ready: false}
}

pub fn (m: mut &StrGidMemo) init() {
    if m.ready { return }
    m.hash = array(MEMO_SLOTS, u64(0))
    m.off = array(MEMO_SLOTS, -1)
    m.slen = array(MEMO_SLOTS, 0)
    m.gid = array(MEMO_SLOTS, -1)
    m.ready = true
}

pub fn (m: &StrGidMemo) get(s: &str, h: u64): int {
    if !m.ready { return -1 }
    let sl = int(h & u64(MEMO_MASK))
    let o = m.off[sl]
    if o >= 0 && m.hash[sl] == h && m.slen[sl] == len(s) && &m.arena[o..o + len(s)] == s {
        return m.gid[sl]
    }
    return -1
}

pub fn (m: mut &StrGidMemo) put(s: &str, h: u64, g: int) {
    if !m.ready { m.init() }
    if len(m.arena) + len(s) > MEMO_ARENA_MAX {
        m.arena = ""
        for i in 0..MEMO_SLOTS { m.off[i] = -1 }
    }
    let sl = int(h & u64(MEMO_MASK))
    let o = len(m.arena)
    m.arena += s
    m.hash[sl] = h
    m.off[sl] = o
    m.slen[sl] = len(s)
    m.gid[sl] = g
}

// Reconstructs key text for global group id (only called for surviving groups at finish()!).
pub fn (t: &TwoLevelArena) keyAt(gid: int): str {
    let loc = t.gidLoc[gid]
    if loc < 0 { return "" }
    if !t.twoLevel {
        let ent = t.l1.ents[loc]
        return t.l1.arena[ent.off..ent.off + ent.len].toStr()
    }
    let bk = &t.bkts[int(t.gidBkt[gid])]
    let ent = bk.ents[loc]
    return bk.arena[ent.off..ent.off + ent.len].toStr()
}

// Zero-copy borrowed key slice and precomputed 64-bit hash for global group id (used by parallel AggSt merge).
pub fn (t: &TwoLevelArena) keySliceAt(gid: int): &str {
    let loc = t.gidLoc[gid]
    if loc < 0 { return "" }
    if !t.twoLevel {
        let ent = t.l1.ents[loc]
        return &t.l1.arena[ent.off..ent.off + ent.len]
    }
    let bk = &t.bkts[int(t.gidBkt[gid])]
    let ent = bk.ents[loc]
    return &bk.arena[ent.off..ent.off + ent.len]
}

pub fn (t: &TwoLevelArena) hashAt(gid: int): u64 {
    let loc = t.gidLoc[gid]
    if loc < 0 { return u64(0) }
    if !t.twoLevel { return t.l1.ents[loc].hash }
    return t.bkts[int(t.gidBkt[gid])].ents[loc].hash
}

pub fn (t: &TwoLevelArena) bktLen(b: int): int { return len(t.bkts[b].ents) }
pub fn (t: &TwoLevelArena) bktSlice(b: int, i: int): &str {
    let bk = &t.bkts[b]
    let ent = bk.ents[i]
    return &bk.arena[ent.off..ent.off + ent.len]
}
pub fn (t: &TwoLevelArena) bktHash(b: int, i: int): u64 { return t.bkts[b].ents[i].hash }
pub fn (t: &TwoLevelArena) bktGid(b: int, i: int): int { return t.bkts[b].ents[i].gid }

pub fn (t: mut &TwoLevelArena) prePromote(estCap: int) {
    if t.twoLevel { return }
    var bkts: []ArenaBucket = withCapacity(NBUCKETS)
    for _ in 0..NBUCKETS { append(mut &bkts, newArenaBucket()) }
    t.bkts = bkts
    if t.trackKeys && estCap > 0 {
        t.gidBkt = withCapacity(estCap)
        t.gidLoc = withCapacity(estCap)
    }
    t.twoLevel = true
}

pub fn (t: mut &TwoLevelArena) getOrPutHash(s: &str, h: u64, nextGid: int): int {
    if t.twoLevel {
        let b = bucketOf(h)
        let bk = mut &t.bkts[b]
        let got = bk.find(s, h)
        if got >= 0 { return got }
        let loc = bk.insert(s, h, nextGid)
        if t.trackKeys {
            while len(t.gidBkt) <= nextGid { append(mut &t.gidBkt, byte(0)); append(mut &t.gidLoc, -1) }
            t.gidBkt[nextGid] = byte(b)
            t.gidLoc[nextGid] = loc
        }
        return nextGid
    }
    let got = t.l1.find(s, h)
    if got >= 0 { return got }
    t.putHash(s, h, nextGid)
    return nextGid
}

pub fn (t: &TwoLevelArena) size(): int {
    if !t.twoLevel { return len(t.l1.ents) }
    var tot = 0
    for b in t.bkts { tot += len(b.ents) }
    return tot
}

pub fn (t: mut &TwoLevelArena) addDistinct(s: &str) {
    let _ = t.getOrPutHash(s, hashStr(s), 0)
}

pub fn (dst: mut &TwoLevelArena) mergeDistinctFrom(src: &TwoLevelArena) {
    if src.twoLevel {
        for b in 0..NBUCKETS {
            let bl = len(src.bkts[b].ents)
            for i in 0..bl {
                let ent = src.bkts[b].ents[i]
                let _ = dst.getOrPutHash(&src.bkts[b].arena[ent.off..ent.off + ent.len], ent.hash, 0)
            }
        }
    } else {
        let n = len(src.l1.ents)
        for i in 0..n {
            let ent = src.l1.ents[i]
            let _ = dst.getOrPutHash(&src.l1.arena[ent.off..ent.off + ent.len], ent.hash, 0)
        }
    }
}

pub fn (dst: mut &TwoLevelArena) mergeDistinctPart(src: &TwoLevelArena, partIdx: int, nParts: int) {
    let pMask = u64(nParts - 1)
    if src.twoLevel {
        var b = partIdx
        while b < NBUCKETS {
            let bl = len(src.bkts[b].ents)
            for i in 0..bl {
                let ent = src.bkts[b].ents[i]
                let _ = dst.getOrPutHash(&src.bkts[b].arena[ent.off..ent.off + ent.len], ent.hash, 0)
            }
            b += nParts
        }
    } else {
        let n = len(src.l1.ents)
        for i in 0..n {
            let ent = src.l1.ents[i]
            if int((ent.hash >> 56) & pMask) != partIdx { continue }
            let _ = dst.getOrPutHash(&src.l1.arena[ent.off..ent.off + ent.len], ent.hash, 0)
        }
    }
}

// ============================================================================
// 4. Direct Top-N Integer Group Selector (prunes 99.9%+ groups BEFORE Val/Acc alloc!)
// ============================================================================

// Returns the list of group IDs in [0, n) that can possibly rank in the top `topN`
// when ordered by `vals[g]` (desc=true: largest first; desc=false: smallest first).
// - When oneOrd=true (single ORDER BY key), returns at most `topN` exact winners.
// - When oneOrd=false (multi-key ORDER BY), returns all groups with value >= bar (desc)
//   or <= bar (asc) so secondary tie-breaking is 100% preserved!
pub fn selectTopIntGroups(vals: &[]int, n: int, topN: int, desc: bool, oneOrd: bool): []int {
    if n <= topN || topN <= 0 {
        var all: []int = withCapacity(n)
        for g in 0..n { append(mut &all, g) }
        return all
    }
    // Maintain a min-heap (for desc) or max-heap (for asc) of size topN holding the threshold values!
    var heap: []int = withCapacity(topN)
    for g in 0..topN { append(mut &heap, vals[g]) }
    // Heapify (root heap[0] is the worst element among the topN seen so far)
    var i = topN / 2 - 1
    while i >= 0 {
        siftDown(mut &heap, i, topN, desc)
        i -= 1
    }
    for g in topN..n {
        let v = vals[g]
        if (desc && v > heap[0]) || (!desc && v < heap[0]) {
            heap[0] = v
            siftDown(mut &heap, 0, topN, desc)
        }
    }
    let bar = heap[0]
    var out: []int = withCapacity(if oneOrd { topN } else { topN * 2 })
    if oneOrd {
        // First collect strictly better than bar, then fill remaining slots up to topN with ties == bar
        var ties: []int = []
        for g in 0..n {
            let v = vals[g]
            if (desc && v > bar) || (!desc && v < bar) {
                append(mut &out, g)
            } else if v == bar && len(ties) < topN {
                append(mut &ties, g)
            }
        }
        var ti = 0
        while len(out) < topN && ti < len(ties) {
            append(mut &out, ties[ti])
            ti += 1
        }
        return out
    }
    // Multi-key ORDER BY: include all groups >= bar (desc) or <= bar (asc) for exact tie-breaking!
    for g in 0..n {
        let v = vals[g]
        if (desc && v >= bar) || (!desc && v <= bar) { append(mut &out, g) }
    }
    return out
}

fn siftDown(h: mut &[]int, start: int, n: int, minHeap: bool) {
    var i = start
    while true {
        let l = i * 2 + 1
        if l >= n { break }
        let r = l + 1
        var best = l
        if r < n && ((minHeap && h[r] < h[l]) || (!minHeap && h[r] > h[l])) { best = r }
        if (minHeap && h[best] < h[i]) || (!minHeap && h[best] > h[i]) {
            let tmp = h[i]
            h[i] = h[best]
            h[best] = tmp
            i = best
        } else {
            break
        }
    }
}

pub fn selectTopDecGroups(vals: &[]i128, cnts: &[]int, n: int, topN: int, desc: bool, oneOrd: bool): []int {
    if n <= topN || topN <= 0 {
        var all: []int = withCapacity(n)
        for g in 0..n { append(mut &all, g) }
        return all
    }
    // Bail to all groups if any group has a NULL sum (cnt == 0) so NULL ordering stays exact.
    for g in 0..n {
        if cnts[g] == 0 {
            var all: []int = withCapacity(n)
            for k in 0..n { append(mut &all, k) }
            return all
        }
    }
    var heap: []i128 = withCapacity(topN)
    for g in 0..topN { append(mut &heap, vals[g]) }
    var i = topN / 2 - 1
    while i >= 0 {
        siftDownDec(mut &heap, i, topN, desc)
        i -= 1
    }
    for g in topN..n {
        let v = vals[g]
        if (desc && v > heap[0]) || (!desc && v < heap[0]) {
            heap[0] = v
            siftDownDec(mut &heap, 0, topN, desc)
        }
    }
    let bar = heap[0]
    var out: []int = withCapacity(if oneOrd { topN } else { topN * 2 })
    if oneOrd {
        var ties: []int = []
        for g in 0..n {
            let v = vals[g]
            if (desc && v > bar) || (!desc && v < bar) {
                append(mut &out, g)
            } else if v == bar && len(ties) < topN {
                append(mut &ties, g)
            }
        }
        var ti = 0
        while len(out) < topN && ti < len(ties) {
            append(mut &out, ties[ti])
            ti += 1
        }
        return out
    }
    for g in 0..n {
        let v = vals[g]
        if (desc && v >= bar) || (!desc && v <= bar) { append(mut &out, g) }
    }
    return out
}

fn siftDownDec(h: mut &[]i128, start: int, n: int, minHeap: bool) {
    var i = start
    while true {
        let l = i * 2 + 1
        if l >= n { break }
        let r = l + 1
        var best = l
        if r < n && ((minHeap && h[r] < h[l]) || (!minHeap && h[r] > h[l])) { best = r }
        if (minHeap && h[best] < h[i]) || (!minHeap && h[best] > h[i]) {
            let tmp = h[i]
            h[i] = h[best]
            h[best] = tmp
            i = best
        } else {
            break
        }
    }
}

// Compact distinct-int set for BA_CNTD: avoids Map allocation for <= 16 distinct values per group (TPC-H q16!).
pub type IntSet = record {
    pub small: []int
    pub useBig: bool
    pub big: Map[int, int]
}

pub fn newIntSet(): IntSet {
    return IntSet{small: [], useBig: false, big: newMap()}
}

pub fn (s: mut &IntSet) add(v: int) {
    if s.useBig {
        s.big.put(v, 1)
        return
    }
    for x in s.small { if x == v { return } }
    if len(s.small) < 16 {
        append(mut &s.small, v)
        return
    }
    for x in s.small { s.big.put(x, 1) }
    s.big.put(v, 1)
    s.small = []
    s.useBig = true
}

pub fn (s: &IntSet) size(): int {
    return if s.useBig { s.big.size() } else { len(s.small) }
}

pub fn (dst: mut &IntSet) mergeFrom(src: &IntSet) {
    if src.useBig {
        for k in src.big.keys() { dst.add(k) }
    } else {
        for x in src.small { dst.add(x) }
    }
}

pub fn (src: &IntSet) addPartKeys(partIdx: int, mask: u64, dst: mut &Map[int, int]) {
    if src.useBig {
        for k in src.big.keys() {
            if int(k.hash() & mask) == partIdx { dst.put(k, 1) }
        }
    } else {
        for k in src.small {
            if int(k.hash() & mask) == partIdx { dst.put(k, 1) }
        }
    }
}
