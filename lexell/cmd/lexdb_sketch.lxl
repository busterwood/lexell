// lexdb_sketch: ClickHouse-style mergeable probabilistic sketch states for
// approximate distinct counts (HyperLogLog++) and approximate quantiles
// (Dunning merging t-digest). Both sketches form associative, commutative
// monoids with compact binary serialization (stored in BYTEA columns and
// hidden materialized view state columns).

import "binary"
import "collections"
import "math"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_access"

type Val = lexdb_sql.Val
type DbErr = lexdb_base.DbErr

fn e(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

// Binary wire tags for serialized sketches.
pub const TAG_HLL_SPARSE = 1
pub const TAG_HLL_DENSE = 2
pub const TAG_TDIGEST = 3

// ---- 64-bit deterministic value hash (FNV-1a + SplitMix64 avalanche)

fn rotl64(x: u64, k: int): u64 { return (x << k) | (x >> (64 - k)) }

fn mix64(x: u64): u64 {
    // 4-round 32-bit-lane ARX mixer (non-linear carry diffusion across all 64 bits; cannot overflow u64).
    let m32 = u64(0xffffffff)
    var lo = (x & m32) ^ u64(0x27220a95)
    var hi = ((x >> 32) & m32) ^ u64(0x517cc1b7)
    for _ in 0..4 {
        lo = (lo + hi + u64(0x9e3779b9)) & m32
        hi = (((hi << 13) | (hi >> 19)) & m32) ^ lo
        lo = ((lo << 7) | (lo >> 25)) & m32
        hi = (hi + lo + u64(0x85ebca6b)) & m32
        lo = (((lo << 17) | (lo >> 15)) & m32) ^ hi
        hi = ((hi << 11) | (hi >> 21)) & m32
    }
    return (hi << 32) | lo
}

fn hashBytes64(s: &str): u64 {
    // 64-bit string hash + 4-round shift/rotate avalanche (uses only bitwise ops; cannot overflow).
    return mix64(s.hash() ^ u64(len(s)))
}

pub fn hashVal(v: &Val): u64 {
    // Zero-allocation fast paths for Int and Text (the dominant distinct-count column types).
    match v {
        Val.Int(n) { return mix64(u64(n) ^ u64(0x1e3779b97f4a7c15)) }
        Val.Text(s) { return mix64(s.hash() ^ u64(len(s)) ^ u64(0x243f6a8885a308d3)) }
        else {
            var kb = ""
            lexdb_access.encIdxPart(mut &kb, v)
            return hashBytes64(&kb)
        }
    }
}

// ---- HyperLogLog++ (p = 12, M = 4096 registers, sparse <= 256 exact)

const HLL_P = 12
const HLL_M = 4096
const HLL_SPARSE_MAX = 256
const HLL_ALPHA = 0.7211100531f          // 0.7213 / (1 + 1.079 / 4096)

pub type Hll = record {
    pub dense: []byte       // empty when sparse/empty; length HLL_M when dense
    pub sparse: []u64       // sorted unique 64-bit hashes when sparse
}

pub fn newHll(): Hll {
    return Hll{dense: [], sparse: []}
}

pub fn (h: &Hll) isEmpty(): bool {
    return len(h.dense) == 0 && len(h.sparse) == 0
}

// Counts leading zeros in the lower 52 bits of hash (shifted to MSB), returning rho in [1, 53].
fn hllRho(hash: u64): byte {
    let w = (hash << 12) | (u64(1) << 11)
    var rho = 1
    var mask = u64(1) << 63
    while (w & mask) == u64(0) && rho <= 52 {
        rho += 1
        mask = mask >> 1
    }
    return byte(rho)
}

fn hllAddDense(dense: mut &[]byte, hash: u64) {
    let idx = int(hash >> 52)
    let rho = hllRho(hash)
    if rho > dense[idx] { dense[idx] = rho }
}

fn (h: mut &Hll) promoteDense() {
    if len(h.dense) == HLL_M { return }
    var d = array(HLL_M, byte(0))
    for x in h.sparse { hllAddDense(mut &d, x) }
    h.dense = d
    h.sparse = []
}

// Binary search in sorted []u64: returns index if present, or -(insertPos + 1) if absent.
fn findU64(xs: &[]u64, target: u64): int {
    var lo = 0
    var hi = len(xs)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if xs[mid] == target { return mid }
        if xs[mid] < target { lo = mid + 1 } else { hi = mid }
    }
    return -(lo + 1)
}

pub fn (h: mut &Hll) addHash(hash: u64) {
    if len(h.dense) == HLL_M {
        hllAddDense(mut &h.dense, hash)
        return
    }
    let pos = findU64(&h.sparse, hash)
    if pos >= 0 { return }
    let ins = -(pos + 1)
    if len(h.sparse) >= HLL_SPARSE_MAX {
        h.promoteDense()
        hllAddDense(mut &h.dense, hash)
        return
    }
    // Insert at ins keeping h.sparse sorted.
    append(mut &h.sparse, u64(0))
    var i = len(h.sparse) - 1
    while i > ins {
        h.sparse[i] = h.sparse[i - 1]
        i -= 1
    }
    h.sparse[ins] = hash
}

pub fn (h: mut &Hll) addVal(v: &Val) {
    h.addHash(hashVal(v))
}

pub fn (h: mut &Hll) merge(other: &Hll) {
    if other.isEmpty() { return }
    if h.isEmpty() {
        h.dense = collections.copyOf(&other.dense)
        h.sparse = collections.copyOf(&other.sparse)
        return
    }
    if len(h.dense) == HLL_M && len(other.dense) == HLL_M {
        for i in 0..HLL_M {
            if other.dense[i] > h.dense[i] { h.dense[i] = other.dense[i] }
        }
        return
    }
    if len(h.dense) == HLL_M {
        for x in other.sparse { hllAddDense(mut &h.dense, x) }
        return
    }
    if len(other.dense) == HLL_M {
        var d = collections.copyOf(&other.dense)
        for x in h.sparse { hllAddDense(mut &d, x) }
        h.dense = d
        h.sparse = []
        return
    }
    // Both sparse: sorted two-pointer merge; promote to dense if union exceeds HLL_SPARSE_MAX.
    var merged: []u64 = withCapacity(min(len(h.sparse) + len(other.sparse), HLL_SPARSE_MAX + 1))
    var i = 0
    var j = 0
    let na = len(h.sparse)
    let nb = len(other.sparse)
    while i < na || j < nb {
        var next = u64(0)
        if j >= nb || (i < na && h.sparse[i] < other.sparse[j]) {
            next = h.sparse[i]
            i += 1
        } else if i >= na || other.sparse[j] < h.sparse[i] {
            next = other.sparse[j]
            j += 1
        } else {
            next = h.sparse[i]
            i += 1
            j += 1
        }
        append(mut &merged, next)
        if len(merged) > HLL_SPARSE_MAX {
            var d = array(HLL_M, byte(0))
            for x in merged { hllAddDense(mut &d, x) }
            while i < na { hllAddDense(mut &d, h.sparse[i]); i += 1 }
            while j < nb { hllAddDense(mut &d, other.sparse[j]); j += 1 }
            h.dense = d
            h.sparse = []
            return
        }
    }
    h.sparse = merged
}

fn pow2Neg(r: int): float {
    // Exact IEEE-754 2^(-r) for r in [0, 53] in one instruction.
    return math.fromBits((1023 - r) << 52)
}

pub fn (h: &Hll) estimate(): int {
    if h.isEmpty() { return 0 }
    if len(h.dense) == 0 { return len(h.sparse) }
    var sum = 0.0f
    var zeros = 0
    for i in 0..HLL_M {
        let r = int(h.dense[i])
        if r == 0 { zeros += 1 }
        sum += pow2Neg(r)
    }
    let m = float(HLL_M)
    var est = HLL_ALPHA * m * m / sum
    if est <= 2.5f * m && zeros > 0 {
        est = m * (m / float(zeros)).ln()
    }
    return int((est + 0.5f).floor())
}

pub fn (h: &Hll) toBytes(): str {
    if h.isEmpty() { return "" }
    if len(h.dense) == HLL_M {
        var b: []byte = withCapacity(1 + HLL_M)
        append(mut &b, byte(TAG_HLL_DENSE))
        for i in 0..HLL_M { append(mut &b, h.dense[i]) }
        return strFromBytes(&b)
    }
    var b: []byte = withCapacity(5 + len(h.sparse) * 8)
    append(mut &b, byte(TAG_HLL_SPARSE))
    binary.appendU32LE(mut &b, len(h.sparse))
    for x in h.sparse {
        binary.appendU32LE(mut &b, int(x & u64(0xffffffff)))
        binary.appendU32LE(mut &b, int(x >> 32))
    }
    return strFromBytes(&b)
}

pub fn hllFromBytes(s: &str): Result[Hll, DbErr] {
    if len(s) == 0 { return Ok(newHll()) }
    let tag = int(s[0])
    if tag == TAG_HLL_SPARSE {
        if len(s) < 5 { return Err(e("22023", "invalid APPROX_COUNT_DISTINCT sketch data")) }
        let n = binary.readU32LEStr(s, 1)
        if len(s) != 5 + n * 8 { return Err(e("22023", "corrupt APPROX_COUNT_DISTINCT sparse sketch")) }
        var sp: []u64 = withCapacity(n)
        for i in 0..n {
            let off = 5 + i * 8
            let lo = u64(binary.readU32LEStr(s, off))
            let hi = u64(binary.readU32LEStr(s, off + 4))
            append(mut &sp, lo | (hi << 32))
        }
        return Ok(Hll{dense: [], sparse: sp})
    }
    if tag == TAG_HLL_DENSE {
        if len(s) != 1 + HLL_M { return Err(e("22023", "corrupt APPROX_COUNT_DISTINCT dense sketch")) }
        var d: []byte = withCapacity(HLL_M)
        for i in 0..HLL_M { append(mut &d, s[1 + i]) }
        return Ok(Hll{dense: d, sparse: []})
    }
    return Err(e("22023", "invalid APPROX_COUNT_DISTINCT sketch tag"))
}

// Fast-path merge of sparse bytes into dense bytes without decoding/allocating when no register improves.
fn mergeSparseIntoDense(denseStr: &str, sparseStr: &str): Result[str, DbErr] {
    if len(denseStr) != 1 + HLL_M { return Err(e("22023", "corrupt APPROX_COUNT_DISTINCT dense sketch")) }
    if len(sparseStr) < 5 { return Err(e("22023", "invalid APPROX_COUNT_DISTINCT sketch data")) }
    let n = binary.readU32LEStr(sparseStr, 1)
    if len(sparseStr) != 5 + n * 8 { return Err(e("22023", "corrupt APPROX_COUNT_DISTINCT sparse sketch")) }
    var changed = false
    for i in 0..n {
        let off = 5 + i * 8
        let lo = u64(binary.readU32LEStr(sparseStr, off))
        let hi = u64(binary.readU32LEStr(sparseStr, off + 4))
        let h = lo | (hi << 32)
        let idx = int(h >> 52)
        if hllRho(h) > denseStr[1 + idx] { changed = true; break }
    }
    if !changed { return Ok(denseStr.toStr()) }
    var out: []byte = withCapacity(1 + HLL_M)
    appendStr(mut &out, denseStr)
    for i in 0..n {
        let off = 5 + i * 8
        let lo = u64(binary.readU32LEStr(sparseStr, off))
        let hi = u64(binary.readU32LEStr(sparseStr, off + 4))
        let h = lo | (hi << 32)
        let idx = int(h >> 52)
        let rho = hllRho(h)
        if rho > out[1 + idx] { out[1 + idx] = rho }
    }
    return Ok(strFromBytes(&out))
}

pub fn hllMergeBytes(a: &str, b: &str): Result[str, DbErr] {
    if len(a) == 0 { return Ok(b.toStr()) }
    if len(b) == 0 { return Ok(a.toStr()) }
    let ta = int(a[0])
    let tb = int(b[0])
    if ta == TAG_HLL_DENSE && tb == TAG_HLL_SPARSE { return mergeSparseIntoDense(a, b) }
    if ta == TAG_HLL_SPARSE && tb == TAG_HLL_DENSE { return mergeSparseIntoDense(b, a) }
    if ta == TAG_HLL_DENSE && tb == TAG_HLL_DENSE {
        if len(a) != 1 + HLL_M || len(b) != 1 + HLL_M {
            return Err(e("22023", "corrupt APPROX_COUNT_DISTINCT dense sketch"))
        }
        var out: []byte = withCapacity(1 + HLL_M)
        append(mut &out, byte(TAG_HLL_DENSE))
        for i in 0..HLL_M {
            let va = a[1 + i]
            let vb = b[1 + i]
            append(mut &out, if vb > va { vb } else { va })
        }
        return Ok(strFromBytes(&out))
    }
    var ha = try hllFromBytes(a)
    let hb = try hllFromBytes(b)
    ha.merge(&hb)
    return Ok(ha.toBytes())
}

pub fn hllEstimateBytes(s: &str): Result[int, DbErr] {
    if len(s) == 0 { return Ok(0) }
    let tag = int(s[0])
    if tag == TAG_HLL_SPARSE {
        if len(s) < 5 { return Err(e("22023", "invalid APPROX_COUNT_DISTINCT sketch data")) }
        let n = binary.readU32LEStr(s, 1)
        if len(s) != 5 + n * 8 { return Err(e("22023", "corrupt APPROX_COUNT_DISTINCT sparse sketch")) }
        return Ok(n)
    }
    if tag == TAG_HLL_DENSE {
        if len(s) != 1 + HLL_M { return Err(e("22023", "corrupt APPROX_COUNT_DISTINCT dense sketch")) }
        var sum = 0.0f
        var zeros = 0
        for i in 0..HLL_M {
            let r = int(s[1 + i])
            if r == 0 { zeros += 1 }
            sum += pow2Neg(r)
        }
        let m = float(HLL_M)
        var est = HLL_ALPHA * m * m / sum
        if est <= 2.5f * m && zeros > 0 {
            est = m * (m / float(zeros)).ln()
        }
        return Ok(int((est + 0.5f).floor()))
    }
    return Err(e("22023", "invalid APPROX_COUNT_DISTINCT sketch tag"))
}

// ---- Dunning Merging t-digest (delta = 100, exact extremes, <0.5% quantile error)

const TD_DELTA = 100.0f
const TD_BUF_MAX = 1024

pub type TDigest = record {
    pub means: []float
    pub weights: []float
    pub totalW: float
    pub dirty: bool
}

pub fn newTDigest(): TDigest {
    return TDigest{means: [], weights: [], totalW: 0.0f, dirty: false}
}

pub fn (td: &TDigest) isEmpty(): bool {
    return td.totalW <= 0.0f || len(td.means) == 0
}

pub fn (td: mut &TDigest) compress() {
    let n = len(td.means)
    if n <= 1 || td.totalW <= 0.0f {
        td.dirty = false
        return
    }
    // Sort centroid indices ascending by mean.
    var idx: []int = withCapacity(n)
    for i in 0..n { append(mut &idx, i) }
    collections.sortBy(mut &idx, fn(a: &int, b: &int): int {
        let ma = td.means[a]
        let mb = td.means[b]
        if ma < mb { return -1 }
        if ma > mb { return 1 }
        return a - b
    })

    var outM: []float = withCapacity(min(n, 160))
    var outW: []float = withCapacity(min(n, 160))
    var weightSoFar = 0.0f
    var curM = td.means[idx[0]]
    var curW = td.weights[idx[0]]
    let invTotal = 1.0f / td.totalW
    let scaleK = 4.0f * td.totalW / TD_DELTA

    for j in 1..n {
        let m = td.means[idx[j]]
        let w = td.weights[idx[j]]
        let propW = curW + w
        let q = (weightSoFar + propW * 0.5f) * invTotal
        let maxW = scaleK * q * (1.0f - q)
        // Merge if within quadratic Dunning weight budget (or identical mean), keeping singleton extremes sharp.
        if m == curM || (propW <= maxW && !(j == 1 && curW == 1.0f && m > curM) && !(j == n - 1 && w == 1.0f && m > curM)) {
            curM = (curM * curW + m * w) / propW
            curW = propW
        } else {
            append(mut &outM, curM)
            append(mut &outW, curW)
            weightSoFar += curW
            curM = m
            curW = w
        }
    }
    append(mut &outM, curM)
    append(mut &outW, curW)

    td.means = outM
    td.weights = outW
    td.dirty = false
}

pub fn (td: mut &TDigest) addFloat(x: float) {
    if x.isNaN() { return }
    append(mut &td.means, x)
    append(mut &td.weights, 1.0f)
    td.totalW += 1.0f
    td.dirty = true
    if len(td.means) >= TD_BUF_MAX { td.compress() }
}

pub fn (td: mut &TDigest) merge(other: &TDigest) {
    if other.isEmpty() { return }
    for i in 0..len(other.means) {
        append(mut &td.means, other.means[i])
        append(mut &td.weights, other.weights[i])
    }
    td.totalW += other.totalW
    td.dirty = true
    if len(td.means) >= TD_BUF_MAX { td.compress() }
}

pub fn (td: mut &TDigest) quantile(p: float): Result[Option[float], DbErr] {
    if p.isNaN() || p < 0.0f || p > 1.0f {
        return Err(e("22023", "percentile value must be between 0 and 1"))
    }
    if td.isEmpty() { return Ok(None) }
    if td.dirty { td.compress() }
    let n = len(td.means)
    if n == 1 { return Ok(Some(td.means[0])) }
    if p == 0.0f { return Ok(Some(td.means[0])) }
    if p == 1.0f { return Ok(Some(td.means[n - 1])) }

    let target = p * td.totalW
    if target <= td.weights[0] * 0.5f { return Ok(Some(td.means[0])) }
    if target >= td.totalW - td.weights[n - 1] * 0.5f { return Ok(Some(td.means[n - 1])) }

    var cum = td.weights[0] * 0.5f
    for i in 0..(n - 1) {
        let dw = (td.weights[i] + td.weights[i + 1]) * 0.5f
        if cum + dw >= target {
            let frac = if dw > 0.0f { (target - cum) / dw } else { 0.5f }
            return Ok(Some(td.means[i] + (td.means[i + 1] - td.means[i]) * frac))
        }
        cum += dw
    }
    return Ok(Some(td.means[n - 1]))
}

pub fn (td: mut &TDigest) toBytes(): str {
    if td.isEmpty() { return "" }
    if td.dirty { td.compress() }
    let n = len(td.means)
    var b: []byte = withCapacity(13 + n * 16)
    append(mut &b, byte(TAG_TDIGEST))
    binary.appendU32LE(mut &b, n)
    binary.appendU64LE(mut &b, math.bitsOf(td.totalW))
    for i in 0..n {
        binary.appendU64LE(mut &b, math.bitsOf(td.means[i]))
        binary.appendU64LE(mut &b, math.bitsOf(td.weights[i]))
    }
    return strFromBytes(&b)
}

pub fn tdFromBytes(s: &str): Result[TDigest, DbErr] {
    if len(s) == 0 { return Ok(newTDigest()) }
    if int(s[0]) != TAG_TDIGEST || len(s) < 13 {
        return Err(e("22023", "invalid APPROX_PERCENTILE sketch data"))
    }
    let n = binary.readU32LEStr(s, 1)
    if len(s) != 13 + n * 16 {
        return Err(e("22023", "corrupt APPROX_PERCENTILE sketch"))
    }
    let tw = math.fromBits(binary.readI64LEStr(s, 5))
    var ms: []float = withCapacity(n)
    var ws: []float = withCapacity(n)
    for i in 0..n {
        let off = 13 + i * 16
        append(mut &ms, math.fromBits(binary.readI64LEStr(s, off)))
        append(mut &ws, math.fromBits(binary.readI64LEStr(s, off + 8)))
    }
    return Ok(TDigest{means: ms, weights: ws, totalW: tw, dirty: false})
}

pub fn tdMergeBytes(a: &str, b: &str): Result[str, DbErr] {
    if len(a) == 0 { return Ok(b.toStr()) }
    if len(b) == 0 { return Ok(a.toStr()) }
    var ta = try tdFromBytes(a)
    let tb = try tdFromBytes(b)
    ta.merge(&tb)
    return Ok(ta.toBytes())
}

pub fn tdQuantileBytes(s: &str, p: float): Result[Option[float], DbErr] {
    if p.isNaN() || p < 0.0f || p > 1.0f {
        return Err(e("22023", "percentile value must be between 0 and 1"))
    }
    if len(s) == 0 { return Ok(None) }
    var td = try tdFromBytes(s)
    return td.quantile(p)
}
