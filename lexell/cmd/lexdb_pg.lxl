// lexdb_pg: PostgreSQL's view of a statement and a catalog: identifier
// quoting, the deparser pg_get_expr/pg_get_indexdef show, and (as the
// module grows) the rest of PostgreSQL's own names and text.
import "strings"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_pgcat"
import "./lexdb_catalog"

type Val = lexdb_sql.Val
type Table = lexdb_catalog.Table
type CatIdx = lexdb_catalog.CatIdx
type CatTab = lexdb_catalog.CatTab
type CatSnap = lexdb_catalog.CatSnap

// quote_ident: the name as is when it needs no quotes. PostgreSQL's rule:
// a lower-case letter or _ first, then lower-case letters, digits and _.
pub fn quoteIfNeeded(n: &str): str {
    var plain = len(n) > 0 && ((n[0] >= 'a' && n[0] <= 'z') || n[0] == '_')
    for i in 0..len(n) {
        let c = n[i]
        if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') { plain = false }
    }
    if plain && lexdb_sql.isReservedWord(n) { plain = false }
    return if plain { n.toStr() } else { "\"" + strings.replaceAll(&n, "\"", "\"\"") + "\"" }
}

// An expression as PostgreSQL's deparser writes it (near enough): names
// bare where they can be, constants typed, AND and OR in capitals.
pub fn exprText(x: &lexdb_sql.Expr, typ: &Option[lexdb_sql.TypeName]): str {
    match x {
        lexdb_sql.Expr.Lit(v) {
            let tn = match typ {
                Some(t) { lexdb_pgcat.formatType(t.oid, -1) }
                None { "" }
            }
            match v {
                lexdb_sql.Val.Null { return if len(tn) > 0 { "NULL::" + tn } else { "NULL" } }
                lexdb_sql.Val.Int(n) {
                    if n >= 0 { return n.toStr() }
                    return "'" + n.toStr() + "'::" + (if n < -2147483648 { "bigint" } else { "integer" })
                }
                lexdb_sql.Val.Num(d) { return if d.isNeg() { "'" + d.toStr() + "'::numeric" } else { d.toStr() } }
                lexdb_sql.Val.Bool(b) { return if b { "true" } else { "false" } }
                lexdb_sql.Val.Text(s) { return "'" + strings.replaceAll(&s, "'", "''") + "'::" + (if len(tn) > 0 { tn } else { "text" }) }
                else { return lexdb_sql.exprText(x) }
            }
        }
        lexdb_sql.Expr.Col(n) {
            let d = strings.indexOf(&n, ".", 0)
            return quoteIfNeeded(&(if d < 0 { n } else { n[d + 1..len(n)] }))
        }
        lexdb_sql.Expr.Bin(op, a, b) {
            let o = if op == "and" { "AND" } else if op == "or" { "OR" } else { op }
            let none: Option[lexdb_sql.TypeName] = None
            return "(" + exprText(&a, &none) + " " + o + " " + exprText(&b, &none) + ")"
        }
        lexdb_sql.Expr.Unary(op, a) {
            let none: Option[lexdb_sql.TypeName] = None
            if op == "-" {
                // a negative constant: as PostgreSQL folds it, '-1'::integer
                match a {
                    lexdb_sql.Expr.Lit(v) {
                        match v {
                            lexdb_sql.Val.Int(n) { return exprText(&lexdb_sql.Expr.Lit(lexdb_sql.Val.Int(-n)), &none) }
                            lexdb_sql.Val.Num(d) { return exprText(&lexdb_sql.Expr.Lit(lexdb_sql.Val.Num(d.neg())), &none) }
                            else {}
                        }
                    }
                    else {}
                }
            }
            return if op == "not" { "(NOT " + exprText(&a, &none) + ")" } else { "(- " + exprText(&a, &none) + ")" }
        }
        lexdb_sql.Expr.IsNull(a, neg) {
            let none: Option[lexdb_sql.TypeName] = None
            return "(" + exprText(&a, &none) + (if neg { " IS NOT NULL)" } else { " IS NULL)" })
        }
        lexdb_sql.Expr.Cast(a, t) {
            match a {
                lexdb_sql.Expr.Lit(v) {
                    match v {
                        lexdb_sql.Val.Text(s) { return "'" + strings.replaceAll(&s, "'", "''") + "'::" + lexdb_pgcat.formatType(t.oid, -1) }
                        else {}
                    }
                }
                else {}
            }
            let none: Option[lexdb_sql.TypeName] = None
            return "(" + exprText(&a, &none) + ")::" + lexdb_pgcat.formatType(t.oid, -1)
        }
        lexdb_sql.Expr.Call(n, args, _) {
            if len(args) == 0 {
                if n == "current_timestamp" || n == "current_date" || n == "current_time" || n == "localtimestamp" || n == "localtime" {
                    return strings.toUpperAscii(&n)
                }
                return n + "()"
            }
            // as PostgreSQL's deparser: arguments as expressions (columns
            // bare, constants typed), its special forms (9.89)
            let none: Option[lexdb_sql.TypeName] = None
            if n == "date_part" && len(args) == 2 {
                match args[0] {
                    lexdb_sql.Expr.Lit(v) {
                        match v {
                            lexdb_sql.Val.Text(f) { return "EXTRACT(" + f + " FROM " + exprText(&args[1], &none) + ")" }
                            else {}
                        }
                    }
                    else {}
                }
            }
            if strings.contains(&n, " ") || strings.startsWith(&n, "#") || strings.startsWith(&n, "case") { return lexdb_sql.exprText(x) }
            var parts: []str = []
            for a in args { append(mut &parts, exprText(&a, &none)) }
            // a sequence function's name: a regclass, as PostgreSQL keeps it (9.117)
            if n == "nextval" || n == "currval" || n == "setval" {
                match lexdb_sql.litText(&args[0]) {
                    Some(t) { parts[0] = "'" + strings.replaceAll(&t, "'", "''") + "'::regclass" }
                    None {}
                }
            }
            let shownName = if n == "coalesce" || n == "nullif" || n == "greatest" || n == "least" { strings.toUpperAscii(&n) } else { n }
            return shownName + "(" + strings.join(&parts, ", ") + ")"
        }
        else { return lexdb_sql.exprText(x) }
    }
}

pub fn visibleIn(path: &[]str, schema: &str): bool {
    if schema == "pg_catalog" { return true }
    if len(path) == 0 { return schema == "public" }
    for p in path { if p == schema { return true } }
    return false
}

pub fn shownIn(path: &[]str, schema: &str, name: &str): str {
    if visibleIn(path, schema) { return quoteIfNeeded(name) }
    return quoteIfNeeded(schema) + "." + quoteIfNeeded(name)
}

// shownIn, a name a temporary relation hides (tnames, 9.96) qualified;
// spelt, the name as written (L6).
pub fn shownBy(path: &[]str, tnames: &[]str, schema: &str, name: &str, spelt: &str): str {
    if len(tnames) > 0 && !lexdb_base.isTempSchema(schema) && hasStr(tnames, name) { return quoteIfNeeded(schema) + "." + quoteIfNeeded(spelt) }
    return shownIn(path, schema, spelt)
}

fn hasStr(xs: &[]str, x: &str): bool {
    for y in xs { if y == x { return true } }
    return false
}

// PostgreSQL's own OIDs for the schemas, the owner, and the relations
// clients name (as classoid).
pub const OID_PUBLIC: int = 2200
pub const OID_PG_CATALOG: int = 11
pub const OID_INFO_SCHEMA: int = 13000
pub const OID_OWNER: int = 10

pub fn catOid(kind: &str, key: &str): int { return lexdb_sql.nameOid(kind, key) }

pub fn nspOid(n: &str): int {
    if n == "public" { return OID_PUBLIC }
    if n == "pg_catalog" { return OID_PG_CATALOG }
    if n == "information_schema" { return OID_INFO_SCHEMA }
    return catOid(&"n", n)
}

pub fn sysRelOid(rel: &str): int {
    match rel {
        "pg_class" { return 1259 }
        "pg_type" { return 1247 }
        "pg_attribute" { return 1249 }
        "pg_proc" { return 1255 }
        "pg_namespace" { return 2615 }
        "pg_constraint" { return 2606 }
        "pg_index" { return 2610 }
        "pg_description" { return 2609 }
        "pg_attrdef" { return 2604 }
        "pg_database" { return 1262 }
        else { return catOid(&"r", &("pg_catalog\x1f" + rel)) }
    }
}

pub fn fkAction(a: int): str {
    if a == lexdb_sql.FK_RESTRICT { return "r" }
    if a == lexdb_sql.FK_CASCADE { return "c" }
    if a == lexdb_sql.FK_SET_NULL { return "n" }
    if a == lexdb_sql.FK_SET_DEFAULT { return "d" }
    return "a"
}

pub fn fkActionText(a: &str): str {
    if a == "r" { return "RESTRICT" }
    if a == "c" { return "CASCADE" }
    if a == "n" { return "SET NULL" }
    if a == "d" { return "SET DEFAULT" }
    return "NO ACTION"
}



pub fn typLenOf(oid: int): int {
    match lexdb_pgcat.typeOf(oid) {
        Some(t) { return t.len }
        None { return -1 }
    }
}

// A column's typmod: varchar's length + 4, numeric's precision << 16 |
// scale + 4, a time type's precision; -1 none.
pub fn typmodOf(t: &lexdb_sql.TypeName): int {
    if (t.oid == lexdb_sql.OID_VARCHAR || t.oid == lexdb_sql.OID_BPCHAR) && t.len > 0 { return t.len + 4 }
    if t.kind == lexdb_sql.K_NUM && t.prec > 0 { return ((t.prec << 16) | t.scale) + 4 }
    if lexdb_sql.isTimeKind(t.kind) && t.prec > 0 { return t.scale }
    return -1
}

pub fn collOf(oid: int): int {
    return if oid == lexdb_sql.OID_TEXT || oid == lexdb_sql.OID_VARCHAR || oid == lexdb_sql.OID_BPCHAR || oid == lexdb_sql.OID_NAME || oid == 1009 || oid == 1015 ||
              oid == 1014 { 100 } else { 0 }
}

pub fn attRow(rel: int, name: &str, typ: int, mod: int, num: int, notNull: bool, hasDef: bool, ident: &str): []lexdb_sql.Val {
    let ty = lexdb_pgcat.typeOf(typ)
    let byval = match ty {
        Some(t) { t.byval }
        None { false }
    }
    let align = match lexdb_pgcat.typeOf(typ) {
        Some(t) { t.align }
        None { "i" }
    }
    let isArr = lexdb_sql.elemOid(typ) > 0 && typ != 22 && typ != 30
    return [lexdb_sql.Val.Int(rel), lexdb_sql.Val.Text(name.toStr()), lexdb_sql.Val.Int(typ), lexdb_sql.Val.Int(typLenOf(typ)),
            lexdb_sql.Val.Int(num), lexdb_sql.Val.Int(-1), lexdb_sql.Val.Int(mod), lexdb_sql.Val.Int(if isArr { 1 } else { 0 }),
            lexdb_sql.Val.Bool(byval), lexdb_sql.Val.Text(align), lexdb_sql.Val.Text(if byval { "p" } else { "x" }),
            lexdb_sql.Val.Text(""), lexdb_sql.Val.Bool(notNull), lexdb_sql.Val.Bool(hasDef), lexdb_sql.Val.Bool(false),
            lexdb_sql.Val.Text(ident.toStr()), lexdb_sql.Val.Text(""), lexdb_sql.Val.Bool(false), lexdb_sql.Val.Bool(true),
            lexdb_sql.Val.Int(0), lexdb_sql.Val.Int(-1), lexdb_sql.Val.Int(collOf(typ)), lexdb_sql.Val.Null,
            lexdb_sql.Val.Null, lexdb_sql.Val.Null, lexdb_sql.Val.Null]
}

pub fn identOf(c: &lexdb_sql.ColDef): str {
    if c.identity == lexdb_sql.ID_ALWAYS { return "a" }
    if c.identity == lexdb_sql.ID_BY_DEFAULT { return "d" }
    return ""
}

pub fn infoType(t: &lexdb_sql.TypeName): str {
    if t.kind == lexdb_sql.K_ARRAY { return "ARRAY" }
    if t.oid == lexdb_sql.OID_BPCHAR { return "character" }
    let f = lexdb_pgcat.formatType(t.oid, -1)
    return f
}



pub fn sizePretty(v: int): str {
    let names = ["bytes", "kB", "MB", "GB", "TB", "PB"]
    var size = v
    for i in 0..len(names) {
        let lim = if i == 0 { 10 * 1024 } else { 20 * 1024 - 1 }
        let abs = if size < 0 { -size } else { size }
        if i == len(names) - 1 || abs < lim {
            if i > 0 { size = (size + (if size < 0 { -1 } else { 1 })) / 2 }
            return size.toStr() + " " + names[i]
        }
        // to the next unit: 10 bits, one fewer into a rounded one, one more out of one
        let bits = 10 - 1 + (if i > 0 { 1 } else { 0 })
        size = size / (1 << bits)
    }
    return size.toStr()
}



pub fn seqOid(key: &str): int { return catOid(&"S", key) }



pub fn clean(s: &str): str { return strings.replaceAll(&(strings.replaceAll(&s, "\t", " ")), "\n", " ") }

pub fn persistOf(schema: &str): str { return if lexdb_base.isTempSchema(schema) { "t" } else { "p" } }

// An index's columns with their options, as pg_get_indexdef shows them.
pub fn colOpts(t: &Table, ix: &CatIdx): str {
    var parts: []str = []
    for k in 0..len(ix.cols) {
        let n = ix.cols[k]
        var p = ""
        if n == 0 && k < len(ix.exprs) {
            // an expression: a function's call as it is, any other in parentheses
            let x = ix.exprs[k]
            let call = len(x) > 0 && x[len(x) - 1] == ')' && x[0] != '('
            p = if call { x } else { "(" + x + ")" }
        } else {
            if n < 1 || n > len(t.cols) { continue }
            p = quoteIfNeeded(&lexdb_sql.colShown(&t.cols[n - 1]))
        }
        if k < len(ix.opts) && len(ix.opts[k]) > 0 { p = p + " " + ix.opts[k] }
        append(mut &parts, p)
    }
    return strings.join(&parts, ", ")
}

// pg_index.indoption: per column, 1 DESC, 2 NULLS FIRST.
pub fn indOptions(ix: &CatIdx): Val {
    var ns: []int = []
    for k in 0..len(ix.cols) {
        let o = if k < len(ix.opts) { ix.opts[k] } else { "" }
        let desc = strings.contains(&o, "DESC")
        let first = if desc { !strings.contains(&o, "NULLS LAST") } else { strings.contains(&o, "NULLS FIRST") }
        append(mut &ns, (if desc { 1 } else { 0 }) + (if first { 2 } else { 0 }))
    }
    var parts: []str = []
    for x in ns { append(mut &parts, x.toStr()) }
    return Val.Text(strings.join(&parts, " "))
}

pub fn colList(t: &Table, nums: &[]int): str {
    var parts: []str = []
    for n in nums { if n >= 1 && n <= len(t.cols) { append(mut &parts, quoteIfNeeded(&lexdb_sql.colShown(&t.cols[n - 1]))) } }
    return strings.join(&parts, ", ")
}

// A column's DEFAULT as pg_attrdef shows it; None for none (an identity
// column has none: its sequence is its own).
pub fn defaultText(snap: &CatSnap, c: &lexdb_sql.ColDef): Option[str] {
    if c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT { return None }
    if c.identity == lexdb_sql.ID_SERIAL && len(c.seq) > 0 {
        return Some("nextval('" + shownIn(&snap.path, &lexdb_sql.schemaOf(&c.seq), &lexdb_sql.baseName(&c.seq)) + "'::regclass)")
    }
    match c.def {
        Some(d) { return Some(exprText(&d, &Some(c.typ))) }
        None { return None }
    }
}

pub fn idxDef(ct: &CatTab, ix: &CatIdx): str { return idxDefOn(ct, ix, &(quoteIfNeeded(&ct.schema) + "." + quoteIfNeeded(&ct.name)), false) }

// The index's definition on table on as written; pretty, pg_get_indexdef's
// pretty form (the table as the path shows it, its predicate's outer
// parentheses dropped: 9.117).
pub fn idxDefOn(ct: &CatTab, ix: &CatIdx, on: &str, pretty: bool): str {
    var d = "CREATE " + (if ix.unique { "UNIQUE " } else { "" }) + "INDEX " + quoteIfNeeded(&ix.name) + " ON " +
            on + " USING btree (" + colOpts(&ct.t, ix) + ")"
    match ix.pred {
        Some(p) {
            let none: Option[lexdb_sql.TypeName] = None
            let x = exprText(&p, &none)
            d = d + " WHERE " + (if pretty { lexdb_sql.unwrapParens(&x) } else if strings.startsWith(&x, "(") { x } else { "(" + x + ")" })
        }
        None {}
    }
    return d
}
