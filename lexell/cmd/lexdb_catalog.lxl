// lexdb_catalog: the metadata types shared by the store, the planner, the
// executor and the dialects: a table and its indexes and constraints, the
// catalog snapshot the catalog relations are made from, sequences, enums
// and table types. Behavior stays in the modules that own it; this module
// is the vocabulary they pass.
import "binary"
import "task"
import "strings"
import "time"
import "./lexdb_base"
import "./lexdb_store"
import "./lexdb_rows"
import "./lexdb_access"
import "./lexdb_sql"

type Expr = lexdb_sql.Expr
type Val = lexdb_sql.Val
type TypeName = lexdb_sql.TypeName
type FixedLay = lexdb_rows.FixedLay

// The hidden rowid column a table without a primary key has.
pub const ROWID: str = lexdb_access.ROWID

// A secondary index (lexdb_access: its tree and parts are its layout).
pub type Index = lexdb_access.Index

pub type Table = record {
    pub name: str
    pub tree: int
    pub cols: []lexdb_sql.ColDef
    pub pk: []int
    pub indexes: []Index
    // Where each column is in a stored row, once a column has been dropped
    // (9.35): a column keeps its place, and a dropped one's is skipped.
    // [] when none has been: column i is at i.
    pub slots: []int
    pub width: int              // the places a row has (with slots)
    pub checks: []Check         // CHECK constraints (9.40)
    pub fks: []ForeignKey       // its foreign keys (9.41)
    pub refBy: []str            // the tables with foreign keys to it (itself among them if so)
    // The row layouts its rows may have (9.50): each place's kind (PK_*),
    // the last one the current. A row names its own; one is added when a
    // column is added, dropped or retyped, and rows are not rewritten.
    pub layouts: [][]byte
    pub lays: []FixedLay            // where each layout's places are (layOfKinds), not stored
    // A view (9.82): its query's text ("" a table), and the catalog keys of
    // the relations it reads; its cols are its output columns.
    pub view: str
    pub deps: []str
    // A view's renames since it was made (PostgreSQL's views follow ALTER TABLE ... RENAME): "t" + SEP + name as its text has the
    // table + SEP + the table's key now; "c" + SEP + the table's key now + SEP + the column's name now + SEP + its name in the text
    pub rn: []str
    // A temporary table's ON COMMIT (lexdb_sql.ONC_*, 9.96): kept for
    // DELETE ROWS and DROP
    pub onCommit: int
    // Its name as written, where that differs from its catalog key's base
    // name (design/lexdb-tds.md L6: names are matched folded, shown as
    // written); "" else. Its columns' are their ColDef.spell.
    pub spell: str
    // Its primary key constraint's name (and its index's, as the catalog
    // shows it), "" the default: its name's and _pkey (pkConName). Kept
    // once it differs: ADD CONSTRAINT name PRIMARY KEY, RENAME CONSTRAINT,
    // RENAME TO (as PostgreSQL's index keeps its name). 9.117
    pub pkName: str
    // Its CHECK and foreign key constraints added NOT VALID and not
    // validated since, by name (9.117)
    pub invalid: []str
}

pub type ForeignKey = record {
    pub name: str
    pub cols: []str
    pub ref: str                // the table's catalog key
    pub refCols: []str
    pub onDelete: int           // lexdb_sql.FK_*
    pub onUpdate: int
    pub deferrable: bool        // DEFERRABLE, INITIALLY DEFERRED (9.85)
    pub deferred: bool
}

pub fn emptyTable(name: &str): Table {
    return Table{name: name.toStr(), tree: 0, cols: [], pk: [], indexes: [], slots: [], width: 0, checks: [], fks: [], refBy: [], layouts: [], lays: [],
                 view: "", deps: [], rn: [], onCommit: 0, spell: "", pkName: "", invalid: []}
}

// t's layout, lent to lexdb_access.
pub fn relOf(t: &Table): lexdb_access.Rel {
    return lexdb_access.Rel{name: &t.name, tree: t.tree, cols: &t.cols, pk: &t.pk, indexes: &t.indexes, slots: &t.slots, width: t.width,
                            layouts: &t.layouts, lays: &t.lays}
}

// A CHECK constraint: a row may not make expr false (column names bare).
pub type Check = record { pub name: str; pub expr: Expr }

pub type CatIdx = record {
    pub name: str
    pub oid: int
    pub cols: []int             // attnums
    pub unique: bool
    pub primary: bool
    pub con: bool               // a constraint's (primary key, UNIQUE)
    pub pred: Option[Expr]
    pub opts: []str             // per column: opclass, DESC, NULLS ... as shown; [] none
    pub exprs: []str            // per column: an expression's text as PostgreSQL shows it ("" a column's; cols 0); [] none
}

pub type CatTab = record {
    pub key: str
    pub t: Table
    pub oid: int
    pub schema: str
    pub name: str
    pub shown: str              // as regclass shows it: qualified unless on the path
    pub idxs: []CatIdx
}

pub type CatCon = record {
    pub oid: int
    pub name: str
    pub typ: str                // p u f c
    pub rel: int                // its table's OID
    pub schema: str
    pub cols: []int
    pub refRel: int
    pub refCols: []int
    pub idx: int                // conindid
    pub def: str
    pub upd: str
    pub del: str
    pub check: str              // a CHECK's expression, as PostgreSQL shows it
    pub deferrable: bool
    pub deferred: bool
    pub valid: bool             // convalidated: false for a CHECK or foreign key added NOT VALID (9.117)
}

pub type CatSnap = record {
    pub acls: Map[str, str]     // owners and grants, by object, encoded (9.83)
    pub tabs: []CatTab
    pub views: []CatTab         // views (9.82): t.view their text, t.cols their columns
    pub cons: []CatCon
    pub seqs: []Seq
    pub schemas: []str          // public and those made
    pub path: []str
    pub user: str
    pub enums: []EnumType       // enum types (9.90)
    pub procs: []ProcSrc        // stored PL/SQL procedures and functions (O6)
    pub ttypes: []TabType       // T-SQL table types
    pub routines: []Routine     // stored procedures and functions (package F)
}

// A stored procedure or function: its owner, kind (PROCEDURE or FUNCTION), name and source (lexdb_plsql keeps them in the
// catalog under "\x02src\x00" and the three).
pub type ProcSrc = record { pub owner: str; pub kind: str; pub name: str; pub src: str }
// A role (9.81): a catalog row of its own, roleKey(name). Whether it may
// log in, whether it is a superuser, and its password's SCRAM verifier (""
// none). Roles matter to SCRAM authentication (lexdb_wire); a session that
// came in by trust is not checked against them.
pub type Role = record {
    pub name: str
    pub login: bool
    pub superuser: bool
    pub verifier: str
    pub oraVerifier: str    // Oracle's 12c verifier (lexdb_auth.makeOraVerifier), "" none: TNS logins need it
}

// A catalog as one statement's dialect reads it: the metadata snapshot, the
// roles, and the session (Oracle's V$SESSION shows its id).
pub type CatView = record {
    pub snap: CatSnap
    pub roles: []Role
    pub sess: int
    pub mems: []str              // role memberships, as pg_auth_members reads them
    pub used: Map[str, int]      // a sequence's last value given, by its key: those used (pg_sequences, sys.sequences, sys.identity_columns)
    pub cur: Map[str, int]       // a sequence's current value: that last given, or the next one to give while none is (sys.sequences' current_value)
    pub who: []str               // the privilege views: the roles the session acts as (its role, those it is a member of, PUBLIC "")
    pub whoSuper: bool           // ... and whether it is a superuser (it sees every grant)
    pub dbopts: str              // sys.databases: the settings ALTER DATABASE made (lexdb_dbopt)
    pub replica: bool            // the store is a read-only replica's (sys.databases, v$database: lexdb.md 9.137)
}

// Whether the privilege views show a grant to the session: it holds the grantee's role or the owner's (the grantor), or
// the grantee is PUBLIC and the view lists those too; a superuser sees all.
pub fn privSeen(cq: &CatView, owner: &str, to: &str, publicToo: bool): bool {
    if cq.whoSuper { return true }
    if len(to) == 0 { return publicToo || lexdb_base.hasStr(&cq.who, owner) }
    return lexdb_base.hasStr(&cq.who, owner) || lexdb_base.hasStr(&cq.who, to)
}

// A hex digit's value, -1 not one.
pub fn hexVal(c: byte): int {
    if c >= '0' && c <= '9' { return int(c - '0') }
    if c >= 'a' && c <= 'f' { return int(c - 'a') + 10 }
    if c >= 'A' && c <= 'F' { return int(c - 'A') + 10 }
    return -1
}

// A hex text as bytes ("" when a digit is not one).
pub fn fromHex(s: &str): str {
    var b = ""
    var i = 0
    while i + 1 < len(s) {
        let hi = hexVal(s[i])
        let lo = hexVal(s[i + 1])
        if hi < 0 || lo < 0 { return "" }
        b.addByte(byte(hi * 16 + lo))
        i += 2
    }
    return b
}

// A column's number (1 on) in a table, 0 none.
pub fn colNum(t: &Table, name: &str): int {
    for i in 0..len(t.cols) { if t.cols[i].name == name { return i + 1 } }
    return 0
}

// Whether a table's primary key is lexdb's hidden rowid.
pub fn rowidKeyed(t: &Table): bool { return len(t.pk) == 1 && t.pk[0] < len(t.cols) && t.cols[t.pk[0]].name == ROWID }

// Copies of an array (the catalog keeps its own).
pub fn copyInts(xs: &[]int): []int {
    var out: []int = []
    for x in xs { append(mut &out, x) }
    return out
}

pub fn copyStrs(xs: &[]str): []str {
    var out: []str = []
    for x in xs { append(mut &out, x.toStr()) }
    return out
}

// A privilege letter's name, "" none.
pub fn privName(l: &str): str {
    return match l {
        "r" { "SELECT" } "a" { "INSERT" } "w" { "UPDATE" } "d" { "DELETE" } "D" { "TRUNCATE" } "x" { "REFERENCES" }
        "t" { "TRIGGER" } "U" { "USAGE" } "C" { "CREATE" } "X" { "EXECUTE" } else { "" }
    }
}

// An owner's grants on an object (9.83): the ACL as the catalog stores it.
pub type Grant = record { pub to: str; pub privs: str }

pub type Acl = record {
    pub owner: str              // "" unknown: made before privileges, or by no role
    pub grants: []Grant         // "" PUBLIC
    pub set: bool               // grants were given: relacl is not NULL
}

// The privileges an object has without a GRANT: the schema public's USAGE
// for PUBLIC (PostgreSQL 15 on: not CREATE).
pub fn defaultGrants(obj: &str): []Grant {
    if obj == "n:public" { return [Grant{to: "", privs: "U"}] }
    // a PostgreSQL function or procedure: EXECUTE for PUBLIC (SQL Server's and Oracle's routines have none for anyone but the owner)
    if strings.startsWith(obj, "f:0\x00") { return [Grant{to: "", privs: "X"}] }
    // a session's temporary schema (9.96): its own, to use and make in
    if len(obj) > 2 && obj[0] == 'n' && lexdb_base.isTempSchema(&obj[2..len(obj)]) { return [Grant{to: "", privs: "UC"}] }
    return []
}

pub fn decAcl(obj: &str, v: &str): Acl {
    let ls = strings.split(&v, "\n")
    var a = Acl{owner: ls[0].toStr(), grants: [], set: len(ls) > 1 && ls[1] == "1"}
    for i in 2..len(ls) {
        let tb = strings.indexOf(&ls[i], "\t", 0)
        if tb >= 0 { append(mut &a.grants, Grant{to: ls[i][0..tb].toStr(), privs: ls[i][tb + 1..len(ls[i])].toStr()}) }
    }
    if !a.set { a.grants = defaultGrants(obj) }
    return a
}

// One privilege granted on a relation, as the three dialects' privilege views list it (information_schema.table_privileges,
// *_TAB_PRIVS, sys.database_permissions): the relation, its owner, who holds the privilege (to "" PUBLIC) and its letter.
pub type PrivRow = record {
    pub key: str            // the relation's catalog key
    pub kind: str           // "table", "view" or "sequence"
    pub oid: int            // 0 for a sequence
    pub schema: str
    pub name: str           // its name as lexdb folds it
    pub spell: str          // as it was written ("" where it was not kept)
    pub owner: str          // the owning role (the session's user where none is known)
    pub to: str
    pub letter: str         // r a w d D x t (U for a sequence; X for a routine)
    pub dialect: int        // -1 a relation; a routine's: lexdb_sql.RD_TSQL (a procedure or function) or RD_ORA (a stored unit)
}

// The grants made on tables, views and sequences (the owner's own are not among them), in the catalog's order.
pub fn privRows(snap: &CatSnap): []PrivRow {
    var out: []PrivRow = []
    for which in 0..3 {
        let n = if which == 0 { len(snap.tabs) } else if which == 1 { len(snap.views) } else { len(snap.seqs) }
        for i in 0..n {
            var key = ""
            var oid = 0
            var name = ""
            var spell = ""
            var kind = "table"
            if which == 2 {
                key = snap.seqs[i].key.clone()
                name = lexdb_sql.baseName(&key)
                kind = "sequence"
            } else {
                let ct = if which == 0 { &snap.tabs[i] } else { &snap.views[i] }
                key = ct.key.clone()
                oid = ct.oid
                name = ct.name.clone()
                spell = ct.t.spell.clone()
                if which == 1 { kind = "view" }
            }
            let schema = lexdb_sql.schemaOf(&key)
            if lexdb_base.isTempSchema(&schema) { continue }
            let obj = relObj(&key)
            let raw = snap.acls.get(&obj)
            if raw.isNone() { continue }
            let a = decAcl(&obj, &raw.unwrap())
            if !a.set { continue }
            let owner = if len(a.owner) > 0 { a.owner.clone() } else { snap.user.clone() }
            for g in a.grants {
                if g.to == owner { continue }
                for k in 0..len(g.privs) {
                    append(mut &out, PrivRow{key: key.clone(), kind: kind.clone(), oid: oid, schema: schema.clone(), name: name.clone(), spell: spell.clone(), owner: owner.clone(), to: g.to.clone(), letter: g.privs[k..k + 1].toStr(), dialect: -1})
                }
            }
        }
    }
    // the routines of SQL Server and Oracle (PostgreSQL's are read by its own views: its owner's and PUBLIC's rows are listed too)
    for r in snap.routines {
        if r.dialect != lexdb_sql.RD_TSQL { continue }
        let a = routineAcl(snap, &r)
        for g in a.grants {
            if g.to == a.owner { continue }
            for k in 0..len(g.privs) {
                append(mut &out, PrivRow{key: r.key.clone(), kind: if r.kind == lexdb_sql.RK_PROC { "procedure" } else { "function" }, oid: lexdb_sql.nameOid(&"R", &r.key),
                                         schema: lexdb_sql.schemaOf(&r.key), name: lexdb_sql.baseName(&r.key), spell: lexdb_sql.baseName(&r.key), owner: a.owner.clone(), to: g.to.clone(),
                                         letter: g.privs[k..k + 1].toStr(), dialect: lexdb_sql.RD_TSQL})
            }
        }
    }
    for u in snap.procs {
        if u.kind != "PROCEDURE" && u.kind != "FUNCTION" { continue }
        let obj = unitObj(&u.owner, &u.name)
        let raw = snap.acls.get(&obj)
        if raw.isNone() { continue }
        let a = decAcl(&obj, &raw.unwrap())
        let owner = if len(a.owner) > 0 { a.owner.clone() } else { strings.toLowerAscii(&u.owner) }
        for g in a.grants {
            if g.to == owner { continue }
            for k in 0..len(g.privs) {
                append(mut &out, PrivRow{key: strings.toLowerAscii(&u.owner) + "." + strings.toLowerAscii(&u.name), kind: strings.toLowerAscii(&u.kind), oid: 0, schema: strings.toLowerAscii(&u.owner),
                                         name: strings.toLowerAscii(&u.name), spell: u.name.clone(), owner: owner.clone(), to: g.to.clone(), letter: g.privs[k..k + 1].toStr(), dialect: lexdb_sql.RD_ORA})
            }
        }
    }
    return out
}

// The catalog's object a privilege on a routine is on: its dialect, name's key and signature (PostgreSQL's identity argument
// types; "" for T-SQL's). An Oracle stored unit (lexdb_plsql's, kept as source text) is dialect RD_ORA, named by its owner's
// and its own name in lower case.
pub fn routineObj(dialect: int, key: &str, sig: &str): str { return "f:" + dialect.toStr() + "\x00" + key + "\x00" + sig }
pub fn unitObj(owner: &str, name: &str): str { return routineObj(lexdb_sql.RD_ORA, &(strings.toLowerAscii(owner) + "." + strings.toLowerAscii(name)), "") }

// A PostgreSQL routine's identity: the types of the arguments it is called with (comma-separated oids); T-SQL's has none.
pub fn sigKey(r: &Routine): str {
    if r.dialect == lexdb_sql.RD_TSQL { return "" }
    var o: []str = []
    for p in r.params { if p.mode != "out" { append(mut &o, p.typ.oid.toStr()) } }
    return strings.join(&o, ",")
}

pub fn routineObjOf(r: &Routine): str { return routineObj(r.dialect, &r.key, &sigKey(r)) }

// The privileges on a routine: its row, else the default (PostgreSQL's PUBLIC EXECUTE) with the owner the routine records.
pub fn routineAcl(snap: &CatSnap, r: &Routine): Acl {
    let obj = routineObjOf(r)
    let raw = snap.acls.get(&obj)
    if raw.isNone() { return Acl{owner: r.owner.clone(), grants: defaultGrants(&obj), set: false} }
    var a = decAcl(&obj, &raw.unwrap())
    if len(a.owner) == 0 { a.owner = r.owner.clone() }
    return a
}

// The catalog key of an object a privilege is on: a relation's or a schema's.
pub fn relObj(k: &str): str { return "r:" + k }
pub fn nspObj(n: &str): str { return "n:" + n }

// A table's name by OID, "" none.
pub fn catTabOf(snap: &CatSnap, oid: int): str {
    let i = catTabIdx(snap, oid)
    return if i < 0 { "" } else { snap.tabs[i].name.clone() }
}

// The columns a CHECK names.
pub fn checkCols(t: &Table, c: &CatCon): []int {
    var out: []int = []
    for i in 0..len(t.cols) {
        if strings.contains(&c.check, &t.cols[i].name) { append(mut &out, i + 1) }
    }
    return out
}

// A table's statistics as pg_stat_user_tables shows them: the automatic
// analysis state and the row count at the last ANALYZE.
pub type TabStat = value record {
    pub c0: int                 // changes since the last analysis: inserts, updates, deletes, ...
    pub c1: int
    pub c2: int
    pub c3: int
    pub c4: int
    pub base: int
    pub last: int
    pub lastAuto: int
    pub n: int
    pub nAuto: int
    pub ns: int
    pub nsAuto: int
    pub rows: int
}

// A text as one line: tabs and newlines as spaces (catalog definitions).
pub fn clean(s: &str): str { return strings.replaceAll(&(strings.replaceAll(s, "\t", " ")), "\n", " ") }

// A bytea's hex text ("0x..." or bare) as bytes.
pub fn hexBytes(s: &str): str {
    let h = if strings.startsWith(s, "0x") { s[2..len(s)].clone() } else { s.toStr() }
    return fromHex(&strings.toLowerAscii(&h))
}

// A login's sid: 0x4C58 ("LX") and its role's OID, big-endian.
pub fn sysSid(role: &str): str {
    let o = lexdb_sql.nameOid("a", role)
    var b = ""
    b.addByte(0x4C)
    b.addByte(0x58)
    for k in 0..4 { b.addByte(byte((o >> (8 * (3 - k))) & 0xFF)) }
    return b
}

// Whether a constraint's name is the one lexdb makes when none is given.
pub fn sysNamed(c: &CatCon, tname: &str): bool {
    if c.typ == "p" { return c.name != tname + "_pkey" }
    if c.typ == "u" || c.typ == "f" || c.typ == "c" {
        let suffix = if c.typ == "u" { "_key" } else if c.typ == "f" { "_fkey" } else { "_check" }
        return !(strings.startsWith(&c.name, &(tname + "_")) && strings.endsWith(&c.name, &suffix))
    }
    return true
}

// A table type's object id and columns, from its definition (T-SQL's
// CREATE TABLE): the primary key's NOT NULL.
pub fn tabTypeObj(key: &str): int { return lexdb_sql.nameOid("tt", key) }

pub fn tabTypeCols(t: &TabType): &[]lexdb_sql.ColDef { return &t.cols }

// A sequence copied (the catalog keeps its own).
pub fn seqCopy(d: &Seq): Seq {
    return Seq{key: d.key.clone(), id: d.id.clone(), typ: d.typ, inc: d.inc, min: d.min, max: d.max, start: d.start, cache: d.cache,
               cycle: d.cycle, ownerT: d.ownerT.clone(), ownerC: d.ownerC.clone()}
}

pub fn noSeq(): Seq {
    return Seq{key: "", id: "", typ: 0, inc: 1, min: 1, max: 1, start: 1, cache: 1, cycle: false, ownerT: "", ownerC: ""}
}

// A sequence's OID: its catalog key's, as nameOid makes it.
pub fn seqOid(d: &Seq): int { return lexdb_sql.nameOid("S", &d.key) }

// The index in snap.tabs of the table with OID oid, -1 none.
pub fn catTabIdx(snap: &CatSnap, oid: int): int {
    for i in 0..len(snap.tabs) { if snap.tabs[i].oid == oid { return i } }
    return -1
}


pub type Seq = record {
    pub key: str            // its catalog key
    pub id: str             // made when it was: its values' memo and durable row
    pub typ: int            // OID_INT2, OID_INT4, OID_INT8
    pub inc: int
    pub min: int
    pub max: int
    pub start: int
    pub cache: int
    pub cycle: bool
    pub ownerT: str         // OWNED BY: a table's catalog key and column; "" none
    pub ownerC: str
}

pub type EnumType = record { pub key: str; pub oid: int; pub labels: []str }
pub type TabType = record {
    pub key: str
    pub spell: str
    pub body: str               // its column list as CREATE TABLE wrote it
    pub cols: []lexdb_sql.ColDef // body's columns, parsed where the record is read
}

type Routine = lexdb_sql.Routine
type RParam = lexdb_sql.RParam

// ---- the catalog tree: keys, encoding, readers, snapshot

pub const CATALOG: int = 1
pub const ACL_PRE: str = "\x02acl\x00"
pub const VIEW_MARK: str = "\xff\xff\xff\xffview"

// Whether relation key k is a temporary one (9.96).
pub fn tempRel(k: &str): bool {
    if len(k) == 0 || k[0] != 'p' { return false }
    return lexdb_base.isTempSchema(&lexdb_sql.schemaOf(k))
}

// Bumps made in this process: with the number, a version a bump gives is
// unique, so a bump in a block that rolls back cannot give the version a
// later bump commits (a plan kept under the first would be taken for the
// second: optimizer 20).
var VERSION_BUMPS: int = 0

// The version after v (the catalog's, the statistics'): its count plus
// one, and a token unique in this process.
pub fn nextVersion(v: &str): str {
    let dot = strings.indexOf(&v, ".", 0)
    let nv: str = if dot < 0 { v.toStr() } else { v[0..dot].clone() }
    let n = strings.parseIntOpt(&nv).unwrapOr(0)
    VERSION_BUMPS += 1
    return (n + 1).toStr() + "." + VERSION_BUMPS.toStr() + "." + time.monotonicNs().toStr()
}

// What a snapshot builder needs from the dialect that names its objects.
pub type Naming = value record {
    pub exprText: fn(&lexdb_sql.Expr, &Option[lexdb_sql.TypeName]): str
}

fn cerr(state: &str, msg: &str): lexdb_base.DbErr { return lexdb_base.err(state, msg) }

fn isNullVal(v: &Val): bool { match v { Val.Null { return true } else { return false } } }

pub fn rowsFor(t: &Table): lexdb_rows.Rows {
    return lexdb_rows.Rows{layouts: &t.layouts, cols: &t.cols, slots: &t.slots, width: rowWidth(t), lays: &t.lays}
}

pub fn rowWidth(t: &Table): int { return if len(t.slots) == 0 { len(t.cols) } else { t.width } }

fn placeKinds(t: &Table): []byte { let r = rowsFor(t); return lexdb_rows.placeKinds(&r) }

fn decRow(s: &str, n: int): Result[[]Val, lexdb_base.DbErr] {
    let all: []bool = []
    let none: []Val = []
    let lays: []FixedLay = []
    return lexdb_rows.decodeRowNeed(s, n, &all, &none, &lays)
}

fn cloneOptE(x: &Option[Expr]): Option[Expr] {
    match x {
        Some(e) { return Some(lexdb_sql.cloneExpr(&e)) }
        None { return None }
    }
}

pub fn encTable(t: &Table): str {
    var b = ""
    binary.addU32LE(mut &b, t.tree)
    binary.addU32LE(mut &b, len(t.cols))
    for c in t.cols {
        // as written (L6): decTable folds it for the name
        let cn = lexdb_sql.colShown(&c)
        binary.addU32LE(mut &b, len(cn))
        b += &cn
        binary.addU32LE(mut &b, c.typ.kind)
        binary.addU32LE(mut &b, c.typ.oid)
        binary.addU32LE(mut &b, c.typ.prec)
        binary.addU32LE(mut &b, c.typ.scale)
        binary.addU32LE(mut &b, c.typ.len)
        b.addByte(if c.notNull { 1 } else { 0 })
    }
    binary.addU32LE(mut &b, len(t.pk))
    for i in t.pk { binary.addU32LE(mut &b, i) }
    binary.addU32LE(mut &b, len(t.indexes))
    for ix in t.indexes {
        binary.addU32LE(mut &b, len(ix.name))
        b += &ix.name
        binary.addU32LE(mut &b, ix.tree)
        let filtered = ix.pred.isSome()
        var shown = false
        for o in ix.opts { if len(o) > 0 { shown = true } }
        let exprd = len(ix.exprs) > 0
        b.addByte((if ix.unique { 1 } else { 0 }) + (if filtered { 2 } else { 0 }) + (if ix.con { 4 } else { 0 }) + (if shown { 8 } else { 0 }) +
                  (if exprd { 16 } else { 0 }))
        binary.addU32LE(mut &b, len(ix.cols))
        for c in ix.cols { binary.addU32LE(mut &b, c & 0xFFFFFFFF) }
        match ix.pred {
            Some(x) {
                let text = lexdb_sql.exprText(&x)
                binary.addU32LE(mut &b, len(text))
                b += &text
            }
            None {}
        }
        if shown { addStrs(mut &b, &ix.opts) }
        if exprd {
            var texts: []str = []
            for k in 0..len(ix.cols) { append(mut &texts, if ix.cols[k] < 0 { lexdb_sql.exprText(&ix.exprs[k]) } else { "" }) }
            addStrs(mut &b, &texts)
        }
    }
    // then defaults, after the places (written, with none, when there are
    // defaults)
    // (all written: the layouts come last)
    let defs = true
    let fkx = true
    let checks = true
    if len(t.slots) > 0 || defs || checks {
        binary.addU32LE(mut &b, t.width)
        binary.addU32LE(mut &b, len(t.slots))
        for k in t.slots { binary.addU32LE(mut &b, k) }
    }
    if defs || checks {
        for c in t.cols {
            let missing = !isNullVal(&c.missing)
            b.addByte((if c.def.isSome() { 1 } else { 0 }) + (if missing { 2 } else { 0 }) + (if len(c.seq) > 0 { 4 } else { 0 }) +
                      (if len(c.coll) > 0 { 8 } else { 0 }) + (if c.genKind != lexdb_sql.GEN_NONE { 16 } else { 0 }))
            match c.def {
                Some(x) {
                    let text = lexdb_sql.exprText(&x)
                    binary.addU32LE(mut &b, len(text))
                    b += &text
                }
                None {}
            }
            if missing {
                let v = lexdb_rows.encodeRow(&[c.missing.clone()])
                binary.addU32LE(mut &b, len(v))
                b += &v
            }
            if len(c.seq) > 0 {
                b.addByte(byte(c.identity))
                addStr(mut &b, &c.seq)
            }
            if len(c.coll) > 0 { addStr(mut &b, &c.coll) }      // its collation (L2)
            if c.genKind != lexdb_sql.GEN_NONE {
                // a generated column: its kind, its expression's text
                b.addByte(byte(c.genKind))
                match c.gen {
                    Some(x) { addStr(mut &b, &lexdb_sql.exprText(&x)) }
                    None { addStr(mut &b, "") }
                }
            }
        }
    }
    // then the checks
    if checks {
        binary.addU32LE(mut &b, len(t.checks))
        for c in t.checks {
            binary.addU32LE(mut &b, len(c.name))
            b += &c.name
            let text = lexdb_sql.exprText(&c.expr)
            binary.addU32LE(mut &b, len(text))
            b += &text
        }
    }
    // then the foreign keys, and the tables referencing it
    if fkx {
        binary.addU32LE(mut &b, len(t.fks))
        for f in t.fks {
            addStr(mut &b, &f.name)
            addStrs(mut &b, &f.cols)
            addStr(mut &b, &f.ref)
            addStrs(mut &b, &f.refCols)
            b.addByte(byte(f.onDelete))
            // DEFERRABLE and INITIALLY DEFERRED in the high bits (9.85: a
            // row written before has none)
            b.addByte(byte(f.onUpdate | (if f.deferrable { 16 } else { 0 }) | (if f.deferred { 32 } else { 0 })))
        }
        addStrs(mut &b, &t.refBy)
    }
    // then the row layouts, the current one last
    let cur = placeKinds(t)
    let n = len(t.layouts)
    let add = n == 0 || !sameKinds(&t.layouts[n - 1], &cur)
    binary.addU32LE(mut &b, n + (if add { 1 } else { 0 }))
    for l in t.layouts { addKinds(mut &b, &l) }
    if add { addKinds(mut &b, &cur) }
    // then a temporary table's ON COMMIT, when it is DELETE ROWS or DROP
    // (9.96), or when a spelling follows
    let more = len(t.pkName) > 0 || len(t.invalid) > 0
    if t.onCommit > lexdb_sql.ONC_PRESERVE || len(t.spell) > 0 || more { b.addByte(byte(t.onCommit)) }
    // then its name as written, if that is not its key's (L6)
    if len(t.spell) > 0 || more { addStr(mut &b, &t.spell) }
    // then its primary key's name and its constraints NOT VALID (9.117)
    if more {
        addStr(mut &b, &t.pkName)
        addStrs(mut &b, &t.invalid)
    }
    return b
}

// The name of table t's primary key constraint (and its index).
pub fn pkConName(t: &Table): str { return if len(t.pkName) > 0 { t.pkName.clone() } else { lexdb_sql.baseName(&t.name) + "_pkey" } }

// Whether t has a primary key of its own (not the hidden one, 9.88).
pub fn hasPk(t: &Table): bool { return len(t.pk) > 0 && !rowidKeyed(t) }

// A name as stored (its spelling, L6) made a column: its name folded, its
// spelling kept if that differs.
pub fn spelledCol(stored: &str, ty: lexdb_sql.TypeName, notNull: bool): lexdb_sql.ColDef {
    let f = strings.toLowerAscii(&stored)
    var c = lexdb_sql.colDef(&f, ty, notNull)
    if f != stored { c.spell = stored.toStr() }
    return c
}

fn foldAll(xs: &[]str): []str {
    var out: []str = []
    for x in xs { append(mut &out, strings.toLowerAscii(&x)) }
    return out
}

fn addKinds(b: mut &str, ks: &[]byte) {
    binary.addU32LE(b, len(ks))
    for k in ks { b.addByte(k) }
}

fn sameKinds(a: &[]byte, b: &[]byte): bool {
    if len(a) != len(b) { return false }
    for i in 0..len(a) { if a[i] != b[i] { return false } }
    return true
}

// Makes the table's current layout (placeKinds) its last, as encTable
// will store it: for rows written before the catalog row is.
pub fn syncLayouts(t: mut &Table) {
    let cur = placeKinds(t)
    let n = len(t.layouts)
    if n > 0 && sameKinds(&t.layouts[n - 1], &cur) { return }
    append(mut &t.lays, lexdb_rows.layOfKinds(&cur))
    append(mut &t.layouts, cur)
}

pub fn addStr(b: mut &str, x: &str) {
    binary.addU32LE(b, len(x))
    b += &x
}

pub fn addStrs(b: mut &str, xs: &[]str) {
    binary.addU32LE(b, len(xs))
    for x in xs { addStr(b, &x) }
}

// A string addStr wrote at at (it takes 4 + its length).
pub fn strAt(s: &str, at: int): str {
    let l = binary.readU32LEStr(s, at)
    return s[at + 4..at + 4 + l].clone()
}

// The strings addStrs wrote at at.
pub fn strsAt(s: &str, at: int): []str {
    let n = binary.readU32LEStr(s, at)
    var p = at + 4
    var out: []str = []
    for i in 0..n {
        let x = strAt(s, p)
        p += 4 + len(x)
        append(mut &out, x)
    }
    return out
}

pub fn strsLen(xs: &[]str): int {
    var n = 4
    for x in xs { n += 4 + len(x) }
    return n
}

// Tables decoded, by catalog key, with the bytes each was decoded from:
// decTableCached gives a copy when a read of the key gives the same bytes
// (the same bytes decode to the same table, whatever store, snapshot or
// transaction read them), so a statement does not decode its tables
// again. At most TAB_CACHE entries (all dropped when full).
type TabCache = record { m: Map[str, TabEnt] }
type TabEnt = record { bytes: str; t: rc Table }
const TAB_CACHE = 1024
var TABS: once task.Shared[TabCache]

fn tabCache(): task.Shared[TabCache] {
    if !TABS.isSet() { TABS.set(task.shared(TabCache{m: newMap()})) }
    return TABS.get().share()
}

// decTable, through the cache of tables decoded (TabCache): a handle
// shared with the cache (unshare it to change it).
pub fn decTableCached(name: &str, s: &str, parseExpr: &fn(&str): Result[Expr, lexdb_base.DbErr]): Result[rc Table, lexdb_base.DbErr] {
    let c = tabCache()
    var hit: Option[rc Table] = None
    c.with(fn(tc: mut &TabCache) {
        // (find: the entry borrowed, not copied with its bytes)
        match tc.m.find(name) {
            Some(en) { if en.bytes == s { hit = Some(en.t.share()) } }
            None {}
        }
    })
    match hit {
        Some(t) { return Ok(t) }
        None {}
    }
    let t = rc(try decTable(name, s, parseExpr))
    c.with(fn(tc: mut &TabCache) {
        if tc.m.size() >= TAB_CACHE { tc.m = newMap() }
        tc.m.put(name.clone(), TabEnt{bytes: s.clone(), t: t.share()})
    })
    return Ok(t)
}

pub fn decTable(name: &str, s: &str, parseExpr: &fn(&str): Result[Expr, lexdb_base.DbErr]): Result[Table, lexdb_base.DbErr] {
    if strings.startsWith(&s, VIEW_MARK) { return Ok(decView(name, s)) }
    var t = emptyTable(name)
    t.tree = binary.readU32LEStr(s, 0)
    let n = binary.readU32LEStr(s, 4)
    var at = 8
    for i in 0..n {
        let l = binary.readU32LEStr(s, at)
        let cn = s[at + 4..at + 4 + l]
        at += 4 + l
        let ty = lexdb_sql.TypeName{kind: binary.readU32LEStr(s, at), oid: binary.readU32LEStr(s, at + 4),
                                    prec: binary.readU32LEStr(s, at + 8), scale: binary.readU32LEStr(s, at + 12),
                                    len: binary.readU32LEStr(s, at + 16)}
        at += 20
        append(mut &t.cols, spelledCol(&cn, ty, s[at] == 1))
        at += 1
    }
    let k = binary.readU32LEStr(s, at)
    at += 4
    for i in 0..k {
        append(mut &t.pk, binary.readU32LEStr(s, at))
        at += 4
    }
    if at >= len(s) { return Ok(t) }
    let ni = binary.readU32LEStr(s, at)
    at += 4
    for i in 0..ni {
        let l = binary.readU32LEStr(s, at)
        var ix = Index{name: s[at + 4..at + 4 + l].clone(), tree: 0, cols: [], unique: false, pred: None, con: false, opts: [], exprs: []}
        at += 4 + l
        ix.tree = binary.readU32LEStr(s, at)
        let flags = s[at + 4]
        ix.unique = flags & 1 != 0
        ix.con = flags & 4 != 0
        let nc = binary.readU32LEStr(s, at + 5)
        at += 9
        for j in 0..nc {
            let c = binary.readU32LEStr(s, at)
            append(mut &ix.cols, if c == 0xFFFFFFFF { -1 } else { c })
            at += 4
        }
        if flags & 2 != 0 {
            let pl = binary.readU32LEStr(s, at)
            match parseExpr(&s[at + 4..at + 4 + pl]) {
                Ok(x) { ix.pred = Some(x) }
                Err(_) { return Err(lexdb_base.corrupt(&("the predicate of index \"" + ix.name + "\""))) }
            }
            at += 4 + pl
        }
        if flags & 8 != 0 {
            ix.opts = strsAt(s, at)
            at += strsLen(&ix.opts)
        }
        if flags & 16 != 0 {
            let texts = strsAt(s, at)
            at += strsLen(&texts)
            for x in texts {
                if len(x) == 0 {
                    append(mut &ix.exprs, Expr.Lit(Val.Null))
                    continue
                }
                match parseExpr(&x) {
                    Ok(e1) { append(mut &ix.exprs, e1) }
                    Err(_) { return Err(lexdb_base.corrupt(&("an expression of index \"" + ix.name + "\""))) }
                }
            }
        }
        append(mut &t.indexes, ix)
    }
    if at + 8 <= len(s) {
        t.width = binary.readU32LEStr(s, at)
        let ns = binary.readU32LEStr(s, at + 4)
        at += 8
        for i in 0..ns {
            append(mut &t.slots, binary.readU32LEStr(s, at))
            at += 4
        }
    }
    if at < len(s) {
        for i in 0..len(t.cols) {
            let flags = s[at]
            at += 1
            if flags & 1 != 0 {
                let l = binary.readU32LEStr(s, at)
                match parseExpr(&s[at + 4..at + 4 + l]) {
                    Ok(x) { t.cols[i].def = Some(x) }
                    Err(_) { return Err(lexdb_base.corrupt(&("the default of column \"" + t.cols[i].name + "\""))) }
                }
                at += 4 + l
            }
            if flags & 2 != 0 {
                let l = binary.readU32LEStr(s, at)
                let vs = try decRow(&s[at + 4..at + 4 + l], 1)
                t.cols[i].missing = vs[0].clone()
                at += 4 + l
            }
            if flags & 4 != 0 {
                t.cols[i].identity = int(s[at])
                t.cols[i].seq = strAt(s, at + 1)
                at += 5 + len(t.cols[i].seq)
            }
            if flags & 8 != 0 {
                t.cols[i].coll = strAt(s, at)
                at += 4 + len(t.cols[i].coll)
            }
            if flags & 16 != 0 {
                t.cols[i].genKind = int(s[at])
                let gt = strAt(s, at + 1)
                at += 5 + len(gt)
                match parseExpr(&gt) {
                    Ok(x) { t.cols[i].gen = Some(x) }
                    Err(_) { return Err(lexdb_base.corrupt(&("the expression of generated column \"" + t.cols[i].name + "\""))) }
                }
            }
        }
    }
    if at + 4 <= len(s) {
        let nc = binary.readU32LEStr(s, at)
        at += 4
        for i in 0..nc {
            let l = binary.readU32LEStr(s, at)
            let cn = s[at + 4..at + 4 + l]
            at += 4 + l
            let xl = binary.readU32LEStr(s, at)
            match parseExpr(&s[at + 4..at + 4 + xl]) {
                Ok(x) { append(mut &t.checks, Check{name: cn.clone(), expr: x}) }
                Err(_) { return Err(lexdb_base.corrupt(&("check constraint \"" + cn + "\""))) }
            }
            at += 4 + xl
        }
    }
    if at + 4 <= len(s) {
        let nf = binary.readU32LEStr(s, at)
        at += 4
        for i in 0..nf {
            let fname = strAt(s, at)
            at += 4 + len(fname)
            let fcols = strsAt(s, at)
            at += strsLen(&fcols)
            let fref = strAt(s, at)
            at += 4 + len(fref)
            let frefCols = strsAt(s, at)
            at += strsLen(&frefCols)
            let ub = int(s[at + 1])
            append(mut &t.fks, ForeignKey{name: fname, cols: foldAll(fcols), ref: fref, refCols: foldAll(frefCols), onDelete: int(s[at]), onUpdate: ub & 15,
                                          deferrable: ub & 16 != 0, deferred: ub & 32 != 0})
            at += 2
        }
        t.refBy = strsAt(s, at)
        at += strsLen(&t.refBy)
    }
    if at + 4 <= len(s) {
        let nl = binary.readU32LEStr(s, at)
        at += 4
        for i in 0..nl {
            let np = binary.readU32LEStr(s, at)
            at += 4
            if at + np > len(s) { return Err(lexdb_base.corrupt(&("the row layouts of table \"" + t.name + "\""))) }
            var ks: []byte = []
            for j in 0..np { append(mut &ks, s[at + j]) }
            at += np
            append(mut &t.lays, lexdb_rows.layOfKinds(&ks))
            append(mut &t.layouts, ks)
        }
    }
    if at < len(s) {
        t.onCommit = int(s[at])
        at += 1
    }
    if at + 4 <= len(s) {
        t.spell = strAt(s, at)
        at += 4 + len(t.spell)
    }
    if at + 4 <= len(s) {
        t.pkName = strAt(s, at)
        at += 4 + len(t.pkName)
        t.invalid = strsAt(s, at)
        at += strsLen(&t.invalid)
    }
    slotExprs(mut &t)
    return Ok(t)
}

// Its CHECKs and its indexes' expressions and predicates with each column at
// its place in the row (lexdb_sql.slotted), as eval reads them.
pub fn slotExprs(t: mut &Table) {
    for i in 0..len(t.cols) {
        match t.cols[i].gen {
            Some(x) { t.cols[i].gen = Some(lexdb_sql.slotted(&x, &t.cols)) }
            None {}
        }
    }
    for k in 0..len(t.checks) {
        let x = lexdb_sql.slotted(&t.checks[k].expr, &t.cols)
        t.checks[k].expr = x
    }
    for k in 0..len(t.indexes) {
        for j in 0..len(t.indexes[k].exprs) {
            let x = lexdb_sql.slotted(&t.indexes[k].exprs[j], &t.cols)
            t.indexes[k].exprs[j] = x
        }
        var p: Option[Expr] = None
        match t.indexes[k].pred {
            Some(w) { p = Some(lexdb_sql.slotted(&w, &t.cols)) }
            None {}
        }
        if p.isSome() { t.indexes[k].pred = p }
    }
}

// temporary objects: keys pre + "pg_temp_..." (pre "" a relation's, "\x01"
// an index's, "\x04" a sequence's, ACL_PRE + "r:" an owner's), whose range
// is read quietly, so their DDL never conflicts with this transaction.
pub fn catScan(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, lo: &str, hi: &str, pre: &str, f: &fn(&lexdb_store.Entry): bool): Result[Unit, lexdb_base.DbErr] {
    let tlo = pre + "pg_temp_"
    let thi = pre + "pg_temp`"
    var going = true
    // below the temporary range
    if lo < tlo {
        let to = if len(hi) == 0 || hi > tlo { tlo.clone() } else { hi.toStr() }
        try st.scan(txn, CATALOG, lo, &to, fn(en: &lexdb_store.Entry): bool {
            going = f(en)
            return going
        })
    }
    if !going || (len(hi) > 0 && hi <= tlo) { return Ok(Unit{}) }
    // in it: the session's own, and keys there of no temporary schema
    let a = if lo > tlo { lo.toStr() } else { tlo }
    let b = if len(hi) > 0 && hi < thi { hi.toStr() } else { thi.clone() }
    if a < b {
        let mine = txn.tmp.clone()
        let quiet = txn.quiet
        txn.quiet = true
        let r = st.scan(txn, CATALOG, &a, &b, fn(en: &lexdb_store.Entry): bool {
            let k = &en.key[len(pre)..len(en.key)]
            let sc = lexdb_sql.schemaOf(k)
            if lexdb_base.isTempSchema(&sc) && lexdb_sql.isQual(k) && sc != mine { return true }
            going = f(en)
            return going
        })
        txn.quiet = quiet
        try r
    }
    if !going || (len(hi) > 0 && hi <= thi) { return Ok(Unit{}) }
    // above it
    if lo > thi { return st.scan(txn, CATALOG, lo, hi, f) }
    return st.scan(txn, CATALOG, &thi, hi, f)
}

// Every table (not a view, nor another session's temporary table).
pub fn seenTables(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, parseExpr: &fn(&str): Result[Expr, lexdb_base.DbErr]): Result[[]Table, lexdb_base.DbErr] {
    var keys: []str = []
    var raw: []str = []
    try catScan(st, txn, &"\x06", &"", &"", fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key.clone())
        append(mut &raw, en.val.clone())
        return true
    })
    var tabs: []Table = []
    for i in 0..len(keys) {
        let t = try decTable(&keys[i], &raw[i], parseExpr)
        if len(t.view) == 0 { append(mut &tabs, t) }
    }
    return Ok(tabs)
}

pub fn enumKey(oid: int): str { return "\x02enum\x00" + oid.toStr() }

pub fn encEnum(en: &EnumType): str {
    var all: []str = [en.key.clone()]
    for l in en.labels { append(mut &all, l.toStr()) }
    var b = ""
    addStrs(mut &b, &all)
    return b
}

pub fn decEnum(oid: int, v: &str): EnumType {
    let all = strsAt(v, 0)
    var labels: []str = []
    for i in 1..len(all) { append(mut &labels, all[i].clone()) }
    return EnumType{key: all[0].clone(), oid: oid, labels: labels}
}

pub fn readEnum(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, oid: int): Result[Option[EnumType], lexdb_base.DbErr] {
    match try st.get(txn, CATALOG, &(enumKey(oid))) {
        Some(v) { return Ok(Some(decEnum(oid, &v))) }
        None { return Ok(None) }
    }
}

pub fn allEnums(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]EnumType, lexdb_base.DbErr] {
    var keys: []str = []
    var vals: []str = []
    try st.scan(txn, CATALOG, "\x02enum\x00", "\x02enum\x01", fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key.clone())
        append(mut &vals, en.val.clone())
        return true
    })
    var out: []EnumType = []
    for i in 0..len(keys) { append(mut &out, decEnum(lexdb_base.num(&keys[i][6..len(keys[i])]), &vals[i])) }
    return Ok(out)
}

pub fn tabTypeKey(key: &str): str { return "\x02ttype\x00" + key }

pub fn encTabType(t: &TabType): str {
    var b = ""
    addStrs(mut &b, &[t.key.clone(), t.spell.clone(), t.body.clone()])
    binary.addU32LE(mut &b, len(t.cols))
    for c in t.cols {
        let cn = lexdb_sql.colShown(&c)
        binary.addU32LE(mut &b, len(cn))
        b += &cn
        binary.addU32LE(mut &b, c.typ.kind)
        binary.addU32LE(mut &b, c.typ.oid)
        binary.addU32LE(mut &b, c.typ.prec)
        binary.addU32LE(mut &b, c.typ.scale)
        binary.addU32LE(mut &b, c.typ.len)
        b.addByte(if c.notNull { 1 } else { 0 })
        binary.addU32LE(mut &b, c.identity)
        addStr(mut &b, &c.coll)
        addStr(mut &b, &c.spell)
    }
    return b
}

pub fn decTabType(v: &str): TabType {
    let all = strsAt(v, 0)
    if len(all) < 3 { return TabType{key: "", spell: "", body: "()", cols: []} }
    var at = strsLen(&[all[0].clone(), all[1].clone(), all[2].clone()])
    var cols: []lexdb_sql.ColDef = []
    if at + 4 <= len(v) {
        let n = binary.readU32LEStr(v, at)
        at += 4
        for k in 0..n {
            let l = binary.readU32LEStr(v, at)
            let cn = v[at + 4..at + 4 + l]
            at += 4 + l
            let ty = lexdb_sql.TypeName{kind: binary.readU32LEStr(v, at), oid: binary.readU32LEStr(v, at + 4),
                                        prec: binary.readU32LEStr(v, at + 8), scale: binary.readU32LEStr(v, at + 12),
                                        len: binary.readU32LEStr(v, at + 16)}
            at += 20
            var c = spelledCol(&cn, ty, v[at] == 1)
            at += 1
            c.identity = binary.readU32LEStr(v, at)
            at += 4
            c.coll = strAt(v, at)
            at += 4 + len(c.coll)
            c.spell = strAt(v, at)
            at += 4 + len(c.spell)
            append(mut &cols, c)
        }
    }
    return TabType{key: all[0].clone(), spell: all[1].clone(), body: all[2].clone(), cols: cols}
}

pub fn readTabType(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, key: &str): Result[Option[TabType], lexdb_base.DbErr] {
    match try st.get(txn, CATALOG, &(tabTypeKey(key))) {
        Some(v) { return Ok(Some(decTabType(&v))) }
        None { return Ok(None) }
    }
}

pub fn allTabTypes(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]TabType, lexdb_base.DbErr] {
    var out: []TabType = []
    try st.scan(txn, CATALOG, "\x02ttype\x00", "\x02ttype\x01", fn(en: &lexdb_store.Entry): bool {
        append(mut &out, decTabType(&en.val))
        return true
    })
    return Ok(out)
}

pub const RTN_PRE: str = "\x02rtn\x00"

// A routine's catalog key: dialect, name's key and signature (PostgreSQL's identity argument types, so that functions of
// one name overload; "" for T-SQL's).
pub fn routineKey(dialect: int, key: &str, sig: &str): str { return RTN_PRE + dialect.toStr() + "\x00" + key + "\x00" + sig }

pub fn typeStr(t: &TypeName): str { return t.kind.toStr() + "," + t.oid.toStr() + "," + t.prec.toStr() + "," + t.scale.toStr() + "," + t.len.toStr() }

pub fn strType(s: &str): TypeName {
    let f = strings.split(s, ",")
    if len(f) < 5 { return TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0} }
    return TypeName{kind: lexdb_base.num(&f[0]), oid: lexdb_base.num(&f[1]), prec: lexdb_base.num(&f[2]), scale: lexdb_base.num(&f[3]), len: lexdb_base.num(&f[4])}
}

pub fn encRoutine(r: &Routine): str {
    var b = ""
    addStrs(mut &b, &[r.key.clone(), r.spell.clone(), r.kind.toStr(), r.dialect.toStr(), typeStr(&r.ret), r.retSpell.clone(),
                      if r.retSet { "1" } else { "0" }, r.lang.clone(), r.body.clone(), r.def.clone(), r.owner.clone(), if r.atomic { "1" } else { "0" }, r.attrs.clone(), r.code.clone()])
    binary.addU32LE(mut &b, len(r.params))
    for p in r.params {
        addStrs(mut &b, &[p.name.clone(), typeStr(&p.typ), p.spell.clone(), p.mode.clone(), if p.has { "1" } else { "0" }, p.dflt.clone(),
                          if p.readonly { "1" } else { "0" }])
    }
    return b
}

pub fn decRoutine(v: &str): Routine {
    let f = strsAt(v, 0)
    var at = strsLen(&f)
    let n = binary.readU32LEStr(v, at)
    at += 4
    var ps: []RParam = []
    for i in 0..n {
        let g = strsAt(v, at)
        at += strsLen(&g)
        append(mut &ps, RParam{name: g[0].clone(), typ: strType(&g[1]), spell: g[2].clone(), mode: g[3].clone(), has: g[4] == "1", dflt: g[5].clone(), readonly: g[6] == "1"})
    }
    return Routine{key: f[0].clone(), spell: f[1].clone(), kind: lexdb_base.num(&f[2]), dialect: lexdb_base.num(&f[3]), params: ps, ret: strType(&f[4]),
                   retSpell: f[5].clone(), retSet: f[6] == "1", lang: f[7].clone(), attrs: f[12].clone(), body: f[8].clone(), def: f[9].clone(), owner: f[10].clone(),
                   atomic: f[11] == "1", code: if len(f) > 13 { f[13].clone() } else { "" }, denied: ""}
}

// The routines of the catalog, in key order.
pub fn allRoutines(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]Routine, lexdb_base.DbErr] {
    var out: []Routine = []
    try st.scan(txn, CATALOG, RTN_PRE, &(RTN_PRE + "\xff"), fn(en: &lexdb_store.Entry): bool {
        append(mut &out, decRoutine(&en.val))
        return true
    })
    return Ok(out)
}

// The stored PL/SQL units (lexdb_plsql's rows: owner, kind, name, source).
pub fn units(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]ProcSrc, lexdb_base.DbErr] {
    var procs: []ProcSrc = []
    let srcPre = "\x02src\x00"
    try st.scan(txn, CATALOG, &srcPre, &(srcPre + "\xff"), fn(en: &lexdb_store.Entry): bool {
        let f = strings.split(&en.key[len(srcPre)..len(en.key)], "\x00")
        if len(f) == 3 { append(mut &procs, ProcSrc{owner: f[0].toStr(), kind: f[1].toStr(), name: f[2].toStr(), src: en.val.clone()}) }
        return true
    })
    return Ok(procs)
}

// The store's memo key lexdb_plsql keeps its version of the units in (a change to a unit or to who may run one moves it).
pub const PLSQL_VER: str = "plsql.ver"

pub fn seqRow(k: &str): str { return "\x04" + k }

pub fn encSeq(d: &Seq): str {
    var b = ""
    addStrs(mut &b, &[d.key.clone(), d.id.clone(), d.typ.toStr(), d.inc.toStr(), d.min.toStr(), d.max.toStr(), d.start.toStr(), d.cache.toStr(),
                     if d.cycle { "1" } else { "0" }, d.ownerT.clone(), d.ownerC.clone()])
    return b
}

pub fn decSeq(s: &str): Seq {
    let f = strsAt(s, 0)
    return Seq{key: f[0].clone(), id: f[1].clone(), typ: lexdb_base.num(&f[2]), inc: lexdb_base.num(&f[3]), min: lexdb_base.num(&f[4]), max: lexdb_base.num(&f[5]), start: lexdb_base.num(&f[6]),
               cache: lexdb_base.num(&f[7]), cycle: f[8] == "1", ownerT: f[9].clone(), ownerC: f[10].clone()}
}

// The sequences in the catalog: in schema sc ("" all).
pub fn allSeqs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: &str): Result[[]Seq, lexdb_base.DbErr] {
    let from = if len(sc) > 0 { seqRow(&lexdb_sql.qual(sc, &"")) } else { "\x04" }
    let to = if len(sc) > 0 { from + "\xff" } else { "\x05" }
    var out: []Seq = []
    // (all of them: not other sessions' temporary ones, 9.96)
    if len(sc) == 0 {
        try catScan(st, txn, &from, &to, &"\x04", fn(en: &lexdb_store.Entry): bool {
            append(mut &out, decSeq(&en.val))
            return true
        })
    } else {
        try st.scan(txn, CATALOG, &from, &to, fn(en: &lexdb_store.Entry): bool {
            append(mut &out, decSeq(&en.val))
            return true
        })
    }
    return Ok(out)
}

pub const RN_SEP: str = "\x1e"

pub fn encView(cols: &[]lexdb_sql.ColDef, text: &str, deps: &[]str, spell: &str): str { return encViewRn(cols, text, deps, spell, &[]) }

pub fn encViewRn(cols: &[]lexdb_sql.ColDef, text: &str, deps: &[]str, spell: &str, rn: &[]str): str {
    var b = ""
    b += &VIEW_MARK
    var names: []str = []
    var oids: []str = []
    var mods: []str = []
    for c in cols {
        append(mut &names, lexdb_sql.colShown(&c))
        append(mut &oids, c.typ.oid.toStr())
        append(mut &mods, typmodOf(&c.typ).toStr())
    }
    addStrs(mut &b, &names)
    addStrs(mut &b, &oids)
    addStrs(mut &b, &mods)
    addStrs(mut &b, &[text.toStr()])
    addStrs(mut &b, deps)
    // then its name as written, if that is not its key's (L6); its renames after it
    if len(spell) > 0 || len(rn) > 0 { addStr(mut &b, spell) }
    if len(rn) > 0 { addStrs(mut &b, rn) }
    return b
}

// A column's type from its OID and typmod (varchar's length, numeric's
// precision and scale), as a view keeps it.
pub fn typeOfMod(oid: int, mod: int): lexdb_sql.TypeName {
    var t = lexdb_sql.oidType(oid)
    if mod >= 4 && (t.oid == lexdb_sql.OID_VARCHAR || t.oid == lexdb_sql.OID_BPCHAR) { t.len = mod - 4 }
    if mod >= 4 && t.kind == lexdb_sql.K_NUM {
        t.prec = (mod - 4) >> 16
        t.scale = (mod - 4) & 0xFFFF
    }
    if mod >= 0 && lexdb_sql.isTimeKind(t.kind) && t.oid != lexdb_sql.OID_DATE {
        t.prec = 1
        t.scale = mod
    }
    return t
}

pub fn decView(name: &str, s: &str): Table {
    var t = emptyTable(name)
    var at = len(VIEW_MARK)
    let names = strsAt(s, at)
    at += strsLen(&names)
    let oids = strsAt(s, at)
    at += strsLen(&oids)
    let mods = strsAt(s, at)
    at += strsLen(&mods)
    let text = strsAt(s, at)
    at += strsLen(&text)
    t.deps = strsAt(s, at)
    at += strsLen(&t.deps)
    if at + 4 <= len(s) {
        t.spell = strAt(s, at)
        at += 4 + len(t.spell)
        if at + 4 <= len(s) { t.rn = strsAt(s, at) }
    }
    t.tree = -1
    t.view = if len(text) > 0 { text[0].clone() } else { "select" }
    for i in 0..len(names) {
        let o = strings.parseIntOpt(&oids[i]).unwrapOr(lexdb_sql.OID_TEXT)
        let m = if i < len(mods) { strings.parseIntOpt(&mods[i]).unwrapOr(-1) } else { -1 }
        append(mut &t.cols, spelledCol(&names[i], typeOfMod(o, m), false))
    }
    return t
}

// Every view, by catalog key.
pub fn allViews(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn): Result[[]Table, lexdb_base.DbErr] { return viewsIn(st, txn, &"\x06", &"") }

// The views with keys in [lo, hi).
pub fn viewsIn(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, lo: &str, hi: &str): Result[[]Table, lexdb_base.DbErr] {
    var out: []Table = []
    var keys: []str = []
    var vals: []str = []
    try st.scan(txn, CATALOG, lo, hi, fn(en: &lexdb_store.Entry): bool {
        if strings.startsWith(&en.val, VIEW_MARK) {
            append(mut &keys, en.key.clone())
            append(mut &vals, en.val.clone())
        }
        return true
    })
    for i in 0..len(keys) { append(mut &out, decView(&keys[i], &vals[i])) }
    return Ok(out)
}

// Every table (not views), from the catalog.
pub fn allTables(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, parseExpr: &fn(&str): Result[Expr, lexdb_base.DbErr]): Result[[]Table, lexdb_base.DbErr] {
    var keys: []str = []
    var vals: []str = []
    try st.scan(txn, CATALOG, "\x06", "", fn(en: &lexdb_store.Entry): bool {
        if !strings.startsWith(&en.val, VIEW_MARK) {
            append(mut &keys, en.key.clone())
            append(mut &vals, en.val.clone())
        }
        return true
    })
    var out: []Table = []
    for i in 0..len(keys) { append(mut &out, try decTable(&keys[i], &vals[i], parseExpr)) }
    return Ok(out)
}

// The views that read relation k, directly or through other views.
pub fn dependentViews(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, k: &str): Result[[]str, lexdb_base.DbErr] {
    // a temporary relation's: its schema's views only (a view reading it is
    // temporary, and no other session's can), 9.96
    let sc = lexdb_sql.schemaOf(k)
    let tmp = tempRel(k)
    let vs = if tmp { try viewsIn(st, txn, &(sc + "\x1f"), &(sc + "\x20")) } else { try allViews(st, txn) }
    var out: []str = []
    var todo: []str = [k.toStr()]
    while len(todo) > 0 {
        let cur = pop(mut &todo)
        for v in vs {
            var reads = false
            for d in v.deps { if d == cur { reads = true } }
            var seen = false
            for x in out { if x == v.name { seen = true } }
            if reads && !seen {
                append(mut &out, v.name.clone())
                append(mut &todo, v.name.clone())
            }
        }
    }
    return Ok(out)
}

// A name of the hidden column (a table's, a query's "alias.column", its
// sequence's).
pub fn hiddenName(n: &str): bool { return strings.contains(&n, "\x00rowid") }

// The catalog as the transaction sees it.
pub fn catSnap(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, parseExpr: &fn(&str): Result[Expr, lexdb_base.DbErr], naming: &Naming): Result[CatSnap, lexdb_base.DbErr] {
    var keys: []str = []
    var schemas: []str = ["public"]
    try st.scan(txn, CATALOG, "\x03", "\x04", fn(en: &lexdb_store.Entry): bool {
        append(mut &schemas, en.key[1..len(en.key)].clone())
        return true
    })
    if len(txn.tmp) > 0 { append(mut &schemas, txn.tmp.clone()) }      // the session's temporary schema (9.96)
    var raw: []str = []
    try catScan(st, txn, &"\x06", &"", &"", fn(en: &lexdb_store.Entry): bool {
        append(mut &keys, en.key.clone())
        append(mut &raw, en.val.clone())
        return true
    })
    var seqs: []Seq = []
    for d in try allSeqs(st, txn, &"") { if !hiddenName(&d.key) { append(mut &seqs, seqCopy(&d)) } }
    let procs = try units(st, txn)
    var snap = CatSnap{acls: newMap(), tabs: [], views: [], cons: [], seqs: seqs, schemas: schemas, path: copyStrs(&txn.sql.path),
                       user: st.memo.get(&userKey(txn.sql.sess)).unwrapOr("lexdb"), enums: try allEnums(st, txn), procs: procs,
                       ttypes: try allTabTypes(st, txn), routines: try allRoutines(st, txn)}
    var aclKeys: []str = []
    var aclVals: []str = []
    try catScan(st, txn, &ACL_PRE, &(ACL_PRE + "\xff"), &(ACL_PRE + "r:"), fn(en: &lexdb_store.Entry): bool {
        append(mut &aclKeys, en.key[len(ACL_PRE)..len(en.key)].toStr())
        append(mut &aclVals, en.val.clone())
        return true
    })
    for i in 0..len(aclKeys) { snap.acls.put(aclKeys[i].clone(), aclVals[i].clone()) }
    // the session's temporary relations' names: a permanent one of the same
    // name is hidden by it (9.96)
    var tnames: []str = []
    if len(txn.tmp) > 0 { for k in keys { if lexdb_sql.schemaOf(&k) == txn.tmp { append(mut &tnames, lexdb_sql.baseName(&k)) } } }
    for i in 0..len(keys) {
        let t = try decTable(&keys[i], &raw[i], parseExpr)
        let schema = lexdb_sql.schemaOf(&keys[i])
        let name = lexdb_sql.baseName(&keys[i])
        let spelt = if len(t.spell) > 0 { t.spell.clone() } else { name.clone() }      // as written (L6)
        if len(t.view) > 0 {
            append(mut &snap.views, CatTab{key: keys[i].clone(), t: t, oid: catOid(&"r", &keys[i]), schema: schema, name: name.clone(),
                                           shown: shownBy(&txn.sql.path, &tnames, &schema, &name, &spelt), idxs: []})
            continue
        }
        var idxs: []CatIdx = []
        if len(t.pk) > 0 && !rowidKeyed(&t) {
            var cs: []int = []
            for p in t.pk { append(mut &cs, p + 1) }
            let pn = pkConName(&t)
            append(mut &idxs, CatIdx{name: pn, oid: catOid(&"i", &lexdb_sql.qual(&schema, &pn)), cols: cs, unique: true, primary: true,
                                     con: true, pred: None, opts: [], exprs: []})
        }
        for ix in t.indexes {
            var cs: []int = []
            for c in ix.cols { append(mut &cs, if c < 0 { 0 } else { c + 1 }) }
            var xs: []str = []
            for k in 0..len(ix.exprs) {
                let none: Option[lexdb_sql.TypeName] = None
                append(mut &xs, if ix.cols[k] < 0 { naming.exprText(&ix.exprs[k], &none) } else { "" })
            }
            let iname = lexdb_sql.baseName(&ix.name)
            append(mut &idxs, CatIdx{name: iname, oid: catOid(&"i", &lexdb_sql.qual(&schema, &iname)), cols: cs, unique: ix.unique,
                                     primary: false, con: ix.con, pred: cloneOptE(&ix.pred), opts: copyStrs(&ix.opts), exprs: xs})
        }
        append(mut &snap.tabs, CatTab{key: keys[i].clone(), t: t, oid: catOid(&"r", &keys[i]), schema: schema, name: name,
                                      shown: shownBy(&txn.sql.path, &tnames, &schema, &name, &spelt), idxs: idxs})
    }
    // the constraints, now that every table's OID is known
    var cons: []CatCon = []
    for ti in 0..len(snap.tabs) {
        let ct = &snap.tabs[ti]
        for ix in ct.idxs {
            if !ix.con { continue }
            let ty = if ix.primary { "p" } else { "u" }
            let def = (if ix.primary { "PRIMARY KEY (" } else { "UNIQUE (" }) + colList(&ct.t, &ix.cols) + ")"
            append(mut &cons, CatCon{oid: catOid(&"c", &(ct.key.clone() + "\x00" + ix.name)), name: ix.name.clone(), typ: ty, rel: ct.oid,
                                          schema: ct.schema.clone(), cols: copyInts(&ix.cols), refRel: 0, refCols: [], idx: ix.oid, def: def,
                                          upd: " ", del: " ", check: "", deferrable: false, deferred: false, valid: true})
        }
        for fk in ct.t.fks {
            var cs: []int = []
            for c in fk.cols { append(mut &cs, colNum(&ct.t, &c)) }
            var refRel = 0
            var refCols: []int = []
            var refIdx = 0
            var refShown = lexdb_sql.shown(&fk.ref)
            for rt in snap.tabs {
                if rt.key != fk.ref { continue }
                refRel = rt.oid
                refShown = rt.shown.clone()
                for c in fk.refCols { append(mut &refCols, colNum(&rt.t, &c)) }
                for ix in rt.idxs {
                    if ix.unique && len(ix.cols) == len(refCols) {
                        var same = true
                        for c in refCols {
                            var has = false
                            for d in ix.cols { if d == c { has = true } }
                            if !has { same = false }
                        }
                        if same && refIdx == 0 { refIdx = ix.oid }
                    }
                }
            }
            var refNames: []str = []
            for c in fk.refCols { append(mut &refNames, quoteIfNeeded(&c)) }
            var fcols: []str = []
            for c in fk.cols { append(mut &fcols, quoteIfNeeded(&c)) }
            let upd = fkAction(fk.onUpdate)
            let del = fkAction(fk.onDelete)
            var def = "FOREIGN KEY (" + strings.join(&fcols, ", ") + ") REFERENCES " + refShown + "(" + strings.join(&refNames, ", ") + ")"
            if upd != "a" { def = def + " ON UPDATE " + fkActionText(&upd) }
            if del != "a" { def = def + " ON DELETE " + fkActionText(&del) }
            if fk.deferrable { def = def + " DEFERRABLE" }
            if fk.deferred { def = def + " INITIALLY DEFERRED" }
            let fvalid = !lexdb_base.hasStr(&ct.t.invalid, &fk.name)
            if !fvalid { def = def + " NOT VALID" }
            append(mut &cons, CatCon{oid: catOid(&"c", &(ct.key.clone() + "\x00" + fk.name)), name: fk.name.clone(), typ: "f", rel: ct.oid,
                                          schema: ct.schema.clone(), cols: cs, refRel: refRel, refCols: refCols, idx: refIdx, def: def,
                                          upd: upd, del: del, check: "", deferrable: fk.deferrable, deferred: fk.deferred, valid: fvalid})
        }
        for ck in ct.t.checks {
            let none: Option[lexdb_sql.TypeName] = None
            let x = naming.exprText(&ck.expr, &none)
            let body = if strings.startsWith(&x, "(") { x } else { "(" + x + ")" }
            // conkey: the columns it uses, in the table's order
            var used: []str = []
            lexdb_sql.colNames(&ck.expr, mut &used)
            var ccols: []int = []
            for i in 0..len(ct.t.cols) {
                var uses = false
                for n in used { if n == ct.t.cols[i].name { uses = true } }
                if uses { append(mut &ccols, colNum(&ct.t, &ct.t.cols[i].name)) }
            }
            let cvalid = !lexdb_base.hasStr(&ct.t.invalid, &ck.name)
            append(mut &cons, CatCon{oid: catOid(&"c", &(ct.key.clone() + "\x00" + ck.name)), name: ck.name.clone(), typ: "c", rel: ct.oid,
                                          schema: ct.schema.clone(), cols: ccols, refRel: 0, refCols: [], idx: 0,
                                          def: "CHECK (" + body + ")" + (if cvalid { "" } else { " NOT VALID" }),
                                          upd: " ", del: " ", check: body, deferrable: false, deferred: false, valid: cvalid})
        }
    }
    snap.cons = cons
    return Ok(snap)
}

pub fn userKey(sess: int): str { return "\x00user\x00" + sess.toStr() }

// ---- naming: PostgreSQL's rules, shared by the snapshot and the dialects

pub const OID_PUBLIC: int = 2200
pub const OID_PG_CATALOG: int = 11
pub const OID_INFO_SCHEMA: int = 13000
pub const OID_OWNER: int = 10

// PostgreSQL 18's keywords that are not unreserved (pg_get_keywords(): catcode R, T and C), sorted: quote_ident quotes them.
const PG_KEYWORDS: []str = [
    "all", "analyse", "analyze", "and", "any", "array", "as", "asc", "asymmetric", "authorization", "between", "bigint", "binary", "bit",
    "boolean", "both", "case", "cast", "char", "character", "check", "coalesce", "collate", "collation", "column", "concurrently",
    "constraint", "create", "cross", "current_catalog", "current_date", "current_role", "current_schema", "current_time",
    "current_timestamp", "current_user", "dec", "decimal", "default", "deferrable", "desc", "distinct", "do", "else", "end", "except",
    "exists", "extract", "false", "fetch", "float", "for", "foreign", "freeze", "from", "full", "grant", "greatest", "group", "grouping",
    "having", "ilike", "in", "initially", "inner", "inout", "int", "integer", "intersect", "interval", "into", "is", "isnull", "join",
    "json", "json_array", "json_arrayagg", "json_exists", "json_object", "json_objectagg", "json_query", "json_scalar", "json_serialize",
    "json_table", "json_value", "lateral", "leading", "least", "left", "like", "limit", "localtime", "localtimestamp", "merge_action",
    "national", "natural", "nchar", "none", "normalize", "not", "notnull", "null", "nullif", "numeric", "offset", "on", "only", "or",
    "order", "out", "outer", "overlaps", "overlay", "placing", "position", "precision", "primary", "real", "references", "returning",
    "right", "row", "select", "session_user", "setof", "similar", "smallint", "some", "substring", "symmetric", "system_user", "table",
    "tablesample", "then", "time", "timestamp", "to", "trailing", "treat", "trim", "true", "union", "unique", "user", "using", "values",
    "varchar", "variadic", "verbose", "when", "where", "window", "with", "xmlattributes", "xmlconcat", "xmlelement", "xmlexists",
    "xmlforest", "xmlnamespaces", "xmlparse", "xmlpi", "xmlroot", "xmlserialize", "xmltable"
]

fn isPgKeyword(n: &str): bool {
    var lo = 0
    var hi = len(PG_KEYWORDS)
    while lo < hi {
        let mid = (lo + hi) / 2
        if PG_KEYWORDS[mid] == n { return true }
        if PG_KEYWORDS[mid] < n { lo = mid + 1 } else { hi = mid }
    }
    return false
}

// quote_ident: the name as is when it needs no quotes. PostgreSQL's rule:
// a lower-case letter or _ first, then lower-case letters, digits and _,
// and not a keyword that is reserved (in any of PostgreSQL's three senses).
pub fn quoteIfNeeded(n: &str): str {
    var plain = len(n) > 0 && ((n[0] >= 'a' && n[0] <= 'z') || n[0] == '_')
    for i in 0..len(n) {
        let c = n[i]
        if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') { plain = false }
    }
    if plain && isPgKeyword(n) { plain = false }
    return if plain { n.toStr() } else { "\"" + strings.replaceAll(&n, "\"", "\"\"") + "\"" }
}

pub fn visibleIn(path: &[]str, schema: &str): bool {
    if schema == "pg_catalog" { return true }
    if len(path) == 0 { return schema == "public" }
    for p in path { if p == schema { return true } }
    return false
}

pub fn shownIn(path: &[]str, schema: &str, name: &str): str {
    if visibleIn(path, schema) { return quoteIfNeeded(name) }
    return quoteIfNeeded(schema) + "." + quoteIfNeeded(name)
}

// shownIn, a name a temporary relation hides (tnames, 9.96) qualified;
// spelt, the name as written (L6).
pub fn shownBy(path: &[]str, tnames: &[]str, schema: &str, name: &str, spelt: &str): str {
    if len(tnames) > 0 && !lexdb_base.isTempSchema(schema) && lexdb_base.hasStr(tnames, name) { return quoteIfNeeded(schema) + "." + quoteIfNeeded(spelt) }
    return shownIn(path, schema, spelt)
}

pub fn catOid(kind: &str, key: &str): int { return lexdb_sql.nameOid(kind, key) }

pub fn nspOid(n: &str): int {
    if n == "public" { return OID_PUBLIC }
    if n == "pg_catalog" { return OID_PG_CATALOG }
    if n == "information_schema" { return OID_INFO_SCHEMA }
    return catOid(&"n", n)
}

pub fn fkAction(a: int): str {
    if a == lexdb_sql.FK_RESTRICT { return "r" }
    if a == lexdb_sql.FK_CASCADE { return "c" }
    if a == lexdb_sql.FK_SET_NULL { return "n" }
    if a == lexdb_sql.FK_SET_DEFAULT { return "d" }
    return "a"
}

pub fn fkActionText(a: &str): str {
    if a == "r" { return "RESTRICT" }
    if a == "c" { return "CASCADE" }
    if a == "n" { return "SET NULL" }
    if a == "d" { return "SET DEFAULT" }
    return "NO ACTION"
}

// A column's typmod: varchar's length + 4, numeric's precision << 16 |
// scale + 4, a time type's precision; -1 none.
pub fn typmodOf(t: &lexdb_sql.TypeName): int {
    if (t.oid == lexdb_sql.OID_VARCHAR || t.oid == lexdb_sql.OID_BPCHAR) && t.len > 0 { return t.len + 4 }
    if t.kind == lexdb_sql.K_NUM && t.prec > 0 { return ((t.prec << 16) | t.scale) + 4 }
    if lexdb_sql.isTimeKind(t.kind) && t.prec > 0 { return t.scale }
    return -1
}

pub fn colList(t: &Table, nums: &[]int): str {
    var parts: []str = []
    for n in nums { if n >= 1 && n <= len(t.cols) { append(mut &parts, quoteIfNeeded(&lexdb_sql.colShown(&t.cols[n - 1]))) } }
    return strings.join(&parts, ", ")
}

// Who a role is, for checks: whether it is a superuser (or no role: a
// trusted session's user), and the roles it acts as: itself, the roles it is
// a member of, PUBLIC ("").
pub type Who = record { pub name: str; pub super: bool; pub roles: []str }

pub fn tmpName(sess: int): str { return "pg_temp_" + sess.toStr() }
