// lexdb_pipe: how a physical plan runs (design/lexdb-layers.md 6.2.3).
// Its secret, when step 4 is done: push pipelines of operators over
// chunks. It holds the scalar evaluator of bound expressions
// (lexdb_bind.BX), the batch kernels (BNode: expressions over a batch's
// columns, aggregates' accumulation), and a run's budget (Budget: the
// rows it holds, its deadline and its turns) and counts.
//
// A run reads its session only through its context (Ctx): the
// transaction's start and time zone, the parameters, and the hooks (Up)
// for the functions it does not own, which its caller supplies. It never
// imports lexdb_exec; from the store it takes the Store and Txn handles
// only, never a transaction's SQL state.
import "time"
import "task"
import "strings"
import "collections"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_time"
import "./lexdb_ops"
import "./lexdb_lib"
import "./lexdb_like"
import "./lexdb_rows"
import "./lexdb_vec"
import "./lexdb_sort"
import "./lexdb_catalog"
import "./lexdb_bind"
import "./lexdb_plan"
import "./lexdb_access"
import "./lexdb_store"

type Val = lexdb_sql.Val
type DbErr = lexdb_base.DbErr
type BX = lexdb_bind.BX
type Batch = lexdb_rows.Batch
type BVec = lexdb_rows.BVec
type BPlan = lexdb_rows.Projection     // where a batch reads the columns used
type Lazy = lexdb_access.Lazy

const BK_INT: int = lexdb_rows.BK_INT    // a column's kind in a batch: an integer ...
const BK_BOOL: int = lexdb_rows.BK_BOOL  // ... a boolean (0, 1) ...
const BK_VAL: int = lexdb_rows.BK_VAL    // ... or any other, as values

fn e(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

// ---- the context

// What a bound expression is evaluated in: the transaction's start and
// time zone (as the row evaluator gives callAt), the run's parameters, the
// values of the subqueries run once before it, and the calls up into the
// functions its owner supplies.
pub type Ctx = record {
    pub now: int
    pub zone: lexdb_time.Zone
    pub params: []Val           // the run's parameters, for a plan's bound slots (BX.Param); [] where they are bound as constants
    pub up: Up
    pub subs: []SubVal          // per subquery of the query, by number: the value BX.Sub reads (one run once; [] none)
}

// name's entry of n arguments where it is not lexdb_lib's; None: lexdb_lib's.
pub type EntryFn = fn(&str, int): Option[lexdb_lib.LibFn]

// A T-SQL or Oracle function's call in a time zone; None: lexdb's own.
pub type DialectFn = fn(&str, &[]Val, &lexdb_time.Zone): Result[Option[Val], DbErr]

// The functions an evaluation calls that are not lexdb_lib's: they read a
// dialect or the catalog, so the evaluation's owner supplies them
// (lexdb_exec: execUp).
pub type Up = value record {
    pub entry: EntryFn          // the catalog functions that read a dialect (format_type, pg_size_pretty)
    pub dialect: DialectFn      // FnRef.dialect's call
}

// ---- the scalar evaluator (design/lexdb.md 9.108; design/lexdb-layers.md 4.4.1)
//
// bxEval gives exactly what lexdb_exec's eval gives for an expression the
// binder bound (lexdb_bind.bindExpr): it runs eval's own operations
// (lexdb_ops' unaryVal, binOp, castTo; callAt and the bound entries of
// lexdb_lib). What eval alone evaluates does not bind.

// A unary operator's text (lexdb_ops.UN_*), as unaryVal takes it.
fn unName(u: int): &str {
    if u == lexdb_ops.UN_NEG { return "-" }
    if u == lexdb_ops.UN_BITNOT { return "~" }
    return "not"
}

// x's value for row (aggs: #agg's slots), as eval gives it.
pub fn bxEval(x: &lexdb_bind.BX, row: &[]Val, aggs: &[]Val, ce: &Ctx): Result[Val, DbErr] {
    match x {
        lexdb_bind.BX.Const(v) { return Ok(v.clone()) }
        lexdb_bind.BX.Param(i) {
            if i >= len(ce.params) { return Err(e("08P01", &("there is no parameter $" + (i + 1).toStr()))) }
            return Ok(ce.params[i].clone())
        }
        lexdb_bind.BX.Col(i) {
            if len(row) == 0 { return Ok(Val.Null) }
            return Ok(row[i].clone())
        }
        lexdb_bind.BX.Agg(i) { return Ok(aggs[i].clone()) }
        lexdb_bind.BX.Un(u, a) { return lexdb_ops.unaryVal(unName(u), try bxEval(&a, row, aggs, ce)) }
        lexdb_bind.BX.And(a, b) {
            let l = lexdb_ops.truth(&(try bxEval(&a, row, aggs, ce)))
            if l == Some(false) { return Ok(Val.Bool(false)) }
            let r = lexdb_ops.truth(&(try bxEval(&b, row, aggs, ce)))
            if r == Some(false) { return Ok(Val.Bool(false)) }
            if l.isNone() || r.isNone() { return Ok(Val.Null) }
            return Ok(Val.Bool(true))
        }
        lexdb_bind.BX.Or(a, b) {
            let l = lexdb_ops.truth(&(try bxEval(&a, row, aggs, ce)))
            if l == Some(true) { return Ok(Val.Bool(true)) }
            let r = lexdb_ops.truth(&(try bxEval(&b, row, aggs, ce)))
            if r == Some(true) { return Ok(Val.Bool(true)) }
            if l.isNone() || r.isNone() { return Ok(Val.Null) }
            return Ok(Val.Bool(false))
        }
        lexdb_bind.BX.Op(op, a, b) {
            let l = try bxEval(&a, row, aggs, ce)
            let r = try bxEval(&b, row, aggs, ce)
            return lexdb_ops.binOp(op, l, r, fn(): lexdb_time.Zone { return ce.zone.clone() })
        }
        lexdb_bind.BX.Cat(a, b, f) {
            let l = try bxEval(&a, row, aggs, ce)
            let r = try bxEval(&b, row, aggs, ce)
            if len(f) > 0 && (looksArray(&l) || looksArray(&r)) { return callAt(&f, &[l, r], 0, lexdb_time.utc(), ce.up.entry) }
            return lexdb_ops.binOp(lexdb_ops.OP_CAT, l, r, fn(): lexdb_time.Zone { return ce.zone.clone() })
        }
        lexdb_bind.BX.IsNull(a, neg) {
            let v = try bxEval(&a, row, aggs, ce)
            return Ok(Val.Bool(lexdb_ops.isNull(&v) != neg))
        }
        lexdb_bind.BX.Cast(a, t) { return lexdb_ops.castTo(try bxEval(&a, row, aggs, ce), &t, fn(): lexdb_time.Zone { return ce.zone.clone() }) }
        lexdb_bind.BX.Case(cs, hasElse) {
            // only the branch taken is evaluated
            let pairs = if hasElse { (len(cs) - 1) / 2 } else { len(cs) / 2 }
            for k in 0..pairs { if lexdb_ops.truth(&(try bxEval(&cs[2 * k], row, aggs, ce))) == Some(true) { return bxEval(&cs[2 * k + 1], row, aggs, ce) } }
            if hasElse { return bxEval(&cs[len(cs) - 1], row, aggs, ce) }
            return Ok(Val.Null)
        }
        lexdb_bind.BX.Try(a) {
            match bxEval(&a, row, aggs, ce) {
                Ok(v) { return Ok(v) }
                Err(_) { return Ok(Val.Null) }
            }
        }
        lexdb_bind.BX.Call(fb, cs) {
            var vs: []Val = withCapacity(len(cs))
            for c in cs { append(mut &vs, try bxEval(&c, row, aggs, ce)) }
            return callRef(&fb, &vs, ce)
        }
        lexdb_bind.BX.Sub(u, i, xs) {
            if i >= len(ce.subs) { return Err(e("0A000", "a subquery is not supported here")) }
            if u == lexdb_sql.SUB_IN { return Ok(inProbe(&ce.subs[i], &(try bxEval(&xs[0], row, aggs, ce)), &ce.zone)) }
            if u == lexdb_sql.SUB_EXISTS { return Ok(Val.Bool(ce.subs[i].rows > 0)) }
            return Ok(ce.subs[i].val.clone())
        }
    }
}

// A bound call's value for its arguments vs, as eval's call gives it.
fn callRef(fb: &lexdb_bind.FnRef, vs: &[]Val, ce: &Ctx): Result[Val, DbErr] {
    if fb.dialect {
        match try ce.up.dialect(&fb.name, vs, &ce.zone) {
            Some(v) { return Ok(v) }
            None {}
        }
    }
    if fb.way == lexdb_bind.FN_ONE {
        if lexdb_ops.isNull(&vs[0]) { return Ok(Val.Null) }
        return fb.f1(&fb.name, &vs[0])
    }
    return fb.f(&fb.name, vs, ce.now, &ce.zone)
}

// name's call, with now the transaction's start (microseconds since 2000;
// 0: the clock). z: the session's time zone (9.95); up: the entries that
// are not lexdb_lib's. The entry is found per call (a bound call finds it
// once: lexdb_exec.fnRefOf).
pub fn callAt(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone, up: EntryFn): Result[Val, DbErr] {
    if len(vs) == 1 {
        match lexdb_lib.entry1Of(name) {
            Some(f) {
                if lexdb_ops.isNull(&vs[0]) { return Ok(Val.Null) }
                return f(name, &vs[0])
            }
            None {}
        }
    }
    let f = entryAt(name, len(vs), up)
    return f(name, vs, now, z)
}

// name's entry of n arguments: up's, else lexdb_lib's.
pub fn entryAt(name: &str, n: int, up: EntryFn): lexdb_lib.LibFn {
    match up(name, n) {
        Some(f) { return f }
        None {}
    }
    return lexdb_lib.entryOf(name, n)
}

// Whether a value may be an array's text (a {...} text): || then takes
// it as an array (design/lexdb.md 9.92).
pub fn looksArray(v: &Val): bool {
    match v {
        Val.Text(t) { return len(t) >= 2 && t[0] == '{' }
        else { return false }
    }
}

// ---- the budget: what a run holds, its deadline and its turns

// A statement's budget, kept by its run (and passed on to the runs inside
// it): about the bytes of rows it holds against max_statement_mem, and
// its clock against statement_timeout and its turn.
pub type Budget = value record {
    pub held: int               // about the bytes of rows the statement holds (its runs inside: their own and this)
    pub aside: int              // ... and those a batch consumer (groups, a sort) holds in its own count while a batch is joined (bRange)
    pub maxHeld: int            // max_statement_mem; 0 no limit
    pub deadline: int           // statement_timeout: the monotonic clock's ns to stop at; 0 none
    pub ticks: int
    pub turnEnd: int            // the monotonic clock's ns after which the statement lets other sessions run
}

// A budget with no limits, nothing held, its turn not begun.
pub fn newBudget(): Budget { return Budget{held: 0, aside: 0, maxHeld: 0, deadline: 0, ticks: 0, turnEnd: 0} }

// Rows of about n bytes now held until the statement ends (or its run
// inside another does).
pub fn (b: mut &Budget) hold(n: int): Result[Unit, DbErr] {
    b.held += n
    if b.maxHeld > 0 && b.held > b.maxHeld { return Err(memErr(b.maxHeld)) }
    return Ok(Unit{})
}

// The bytes a run may still hold (-1: no limit), for code that cannot reach
// the run (a row callback): it counts and checks itself, then holds.
pub fn (b: &Budget) room(): int { return if b.maxHeld > 0 { b.maxHeld - b.held } else { -1 } }

// The error of a statement past max_statement_mem (max bytes).
pub fn memErr(max: int): DbErr {
    return e("53200", &("statement holds more than max_statement_mem (" + (max / 1024).toStr() +
             " kB) of rows; SET max_statement_mem to allow more, 0 for no limit"))
}

// Per row looked at: every 256th, the clock. Past statement_timeout: an
// error. After a turn of lexdb_base.TURN_NS: the other sessions run, then this again.
pub fn (b: mut &Budget) tick(): Result[Unit, DbErr] {
    b.ticks += 1
    if b.ticks % 256 != 0 { return Ok(Unit{}) }
    return b.checkTime()
}

// tick for n rows at once (a batch: 9.47).
pub fn (b: mut &Budget) tickN(n: int): Result[Unit, DbErr] {
    b.ticks += n
    return b.checkTime()
}

fn (b: mut &Budget) checkTime(): Result[Unit, DbErr] {
    let now = time.monotonicNs()
    if b.deadline != 0 && now > b.deadline { return Err(e("57014", "canceling statement due to statement timeout")) }
    if b.turnEnd == 0 {
        b.turnEnd = now + lexdb_base.TURN_NS
    } else if now > b.turnEnd {
        // a yield looks at the sockets: a session whose query has arrived runs
        match task.yield() {
            Ok(_) {}
            Err(_) { return Err(e("57014", "canceling statement: its session has ended")) }
        }
        b.turnEnd = time.monotonicNs() + lexdb_base.TURN_NS
    }
    return Ok(Unit{})
}

// About the memory a row takes: its array, and per value its tag and
// payload (text and numbers their bytes).
pub fn rowBytes(r: &[]Val): int {
    var n = 32
    for v in r {
        n += 24
        match v {
            Val.Text(t) { n += len(t) }
            Val.Num(_) { n += 32 }
            Val.Ival(_) { n += 24 }
            else {}
        }
    }
    return n
}

pub fn rowsBytes(rows: &[][]Val): int {
    var n = 24
    for r in rows { n += rowBytes(&r) }
    return n
}

// ---- counts (EXPLAIN ANALYZE)

// What one table of a query did.
pub type Counts = value record {
    pub starts: int         // scans or lookups begun (per row: one per row of the tables before); hash: probes
    pub read: int           // candidate rows tried
    pub joined: int         // rows that met the join's conditions
    pub nulls: int          // LEFT JOIN rows made with NULLs
    pub built: int          // hash: rows read to build it, and kept
    pub kept: int
    pub unmatched: int      // RIGHT and FULL JOIN: its rows that joined nothing
    pub batches: int        // the batches its rows were read and aggregated in (9.47)
    pub switched: int       // when an index range was run as a scan (optimizer 19): 1 by the rules mode's rule, 2 by the measured costs (optimizer 38)
}

pub fn noCounts(): Counts { return Counts{starts: 0, read: 0, joined: 0, nulls: 0, built: 0, kept: 0, unmatched: 0, batches: 0, switched: 0} }

// ---- the batch kernels (design/lexdb.md 9.47, 9.105, 9.108, 9.112)
//
// A batch (lexdb_rows.Batch) holds a table's columns used, decoded into
// arrays: an integer or boolean column as ints and NULL flags, a numeric
// as its units where asked (BK_DEC), any other as values. An expression
// the binder bound (BX, over the query's columns by place) is compiled to
// a BNode over the batch (bCompile: kinds per column of the query, base
// the query's column of the batch's first); bEval runs it over a list of
// the batch's rows, one loop per operator. What the kernels cannot run is
// a Gen node: the scalar evaluator (bxEval) per row.

pub const BK_NONE: int = lexdb_rows.BK_NONE      // a query's column not in the batch (of another table)
pub const BT_INT = 0        // an expression's type in a batch
pub const BT_BOOL = 1
pub const BT_NULL = 2       // a NULL constant: any type
pub const BT_OTHER = 3      // a column of another type: IS NULL and count only

// a numeric as its units at a scale (lexdb_rows.BK_DEC): BT_DEC + the
// scale; only where the operator asked for them (bCompileD's dec)
pub const BT_DEC = 16

pub fn isDecT(t: int): bool { return t >= BT_DEC }

// an operand of a numeric operation: its scale (an integer's 0)
pub fn decSc(t: int): int { return if t >= BT_DEC { t - BT_DEC } else { 0 } }

// A batch's numeric result past its units (lexdb_vec's false): the
// operator gives way to the row path, which computes it in Decimal. Never
// a client's error.
pub fn decSpill(): DbErr { return e("XXDEC", "a numeric past a batch's units") }

pub fn isSpill(x: &DbErr): bool { return x.state == "XXDEC" }

pub const BA_STAR = 0       // count(*)
pub const BA_COUNT = 1
pub const BA_SUM = 2
pub const BA_AVG = 3
pub const BA_MIN = 4
pub const BA_MAX = 5

// An expression over a batch. Operators: + - * / % as 0 to 4; = <> < <=
// > >= as 0 to 5.
pub type BNode = closed {
    Const(int, bool)        // the value, NULL
    Col(int)
    Arith(int, BNode, BNode)
    Neg(BNode)
    Cmp(int, BNode, BNode)
    And(BNode, BNode)
    Or(BNode, BNode)
    Not(BNode)
    IsNull(BNode, bool)     // true: IS NOT NULL
    // a column of values (BK_VAL) or texts (BK_TEXT: the last true)
    // compared with a constant, as eval compares them (compare); true: the
    // constant on the left
    ValCmp(int, int, Val, bool, bool)
    Like(int, LikePat)      // a column of values LIKE (ILIKE) a constant pattern
    // a column IN a constant list too long for the OR chain: its values
    // sorted, and whether the list had a NULL (a no-match row is NULL)
    InVals(int, []Val, bool, bool)    // ... the last true: a BK_TEXT column
    InInts(int, []int, bool)
    // a compiled expression's values IN a constant list: the list's values
    // not NULL sorted (one kind, kindOf: the last int), the list as written
    // (a value of another kind is compared with it in order, as the row
    // path's in), whether it had a NULL (q22's substring(c_phone ...) IN)
    InGen(BGen, []Val, []Val, bool, int)
    // two columns compared, one at least of values, as eval compares them
    // (bCmpKinds): op, the columns, their kinds (BK_*)
    VCmp(int, int, int, int, int)
    // a compiled expression (9.108): a condition, true where its value is
    // true (eval's truth), as the row path checks one; or an output's or a
    // key's values (OutPlan's src -2: bGenVals)
    Gen(BGen)
    // numerics as units (lexdb_vec): + - * as 0 to 2 of a at scale sa and
    // b at sb (DArith(op, a, sa, b, sb)); = <> < <= > >= as 0 to 5
    DArith(int, BNode, int, BNode, int)
    DCmp(int, BNode, int, BNode, int)
}

// A compiled expression over a batch (9.108): per row, the columns it
// reads put in a row of its own (its places), then cEval, in the
// statement's session (ce).
pub type BGen = record {
    pub cx: lexdb_bind.BX
    pub cols: []int             // per place of its row: the batch's column
    pub kinds: []int            // ... and its kind (BK_*)
    pub ce: Ctx
}

pub type LikePat = record {
    pub pat: str
    pub esc: str
    pub fold: bool              // ILIKE
    pub simple: bool            // literal text and % only (likeSimple): pieces
    pub pieces: []str
    pub txt: bool               // the column BK_TEXT (its bytes), else values
}

pub type BComp = record {
    pub n: BNode
    pub typ: int
}

pub type BSpec = record {
    pub kind: int
    pub arg: Option[BNode]
    pub filter: Option[BNode]
    // a column of values (BK_VAL) whose min, max, or numeric sum or avg
    // this is (9.52): its values kept per group as the row path keeps
    // them (bAccVal); -1 an integer aggregate
    pub vcol: int
    // the scale of a numeric argument as units (BT_DEC): its sums in 128
    // bits (lexdb_vec.sum), its minima and maxima as units; -1 none
    pub dsc: int
}

// c's node (c given up).
pub fn takeN(c: BComp): BNode {
    var x = c
    return replace(mut &x.n, BNode.Const(0, false))
}

pub fn intLike(t: int): bool { return t == BT_INT || t == BT_NULL }

pub fn boolLike(t: int): bool { return t == BT_BOOL || t == BT_NULL }

// x over a batch; None: not one the batches evaluate (the row path does).
// x is bound over q's columns by place (lexdb_bind.BX: bxOf, or as the
// plan or prepare bound it: bCompileCond, bCondNode, outNodeOut); its
// constants are evaluated once, in ce (the run's parameters and session:
// the zone they are read in, 9.95).
pub fn bCompile(x: &BX, cols: &[]lexdb_sql.ColDef, kinds: &[]int, ce: &Ctx, base: int): Option[BComp] { return bCompileD(x, cols, kinds, ce, base, false) }

// Whether x has no column (its value is the same for every row): of
// literals and parameters, by operators, casts and char(n)'s padding (#bppad,
// the parser's for 'F' compared with a char(1) column: q21's o_orderstatus
// = 'F'), not by other functions.
pub fn bxConst(x: &BX): bool {
    match x {
        BX.Const(_) { return true }
        BX.Param(_) { return true }
        BX.Un(_, a) { return bxConst(&a) }
        BX.And(a, b) { return bxConst(&a) && bxConst(&b) }
        BX.Or(a, b) { return bxConst(&a) && bxConst(&b) }
        BX.Op(_, a, b) { return bxConst(&a) && bxConst(&b) }
        BX.Cat(a, b, _) { return bxConst(&a) && bxConst(&b) }
        BX.IsNull(a, _) { return bxConst(&a) }
        BX.Cast(a, _) { return bxConst(&a) }
        BX.Call(fr, cs) { return fr.name == "#bppad" && len(cs) == 2 && bxConst(&cs[0]) && bxConst(&cs[1]) }
        BX.Sub(_, _, xs) {
            for c in xs { if !bxConst(&c) { return false } }
            return true
        }
        else { return false }
    }
}

// Whether x reads no column and calls no function whose value may change
// within a statement (immutable's, for a bound expression).
pub fn bxFixed(x: &BX): bool {
    match x {
        BX.Const(_) { return true }
        BX.Param(_) { return true }
        BX.Col(_) { return false }
        BX.Agg(_) { return false }
        BX.Un(_, a) { return bxFixed(&a) }
        BX.And(a, b) { return bxFixed(&a) && bxFixed(&b) }
        BX.Or(a, b) { return bxFixed(&a) && bxFixed(&b) }
        BX.Op(_, a, b) { return bxFixed(&a) && bxFixed(&b) }
        BX.Cat(a, b, _) { return bxFixed(&a) && bxFixed(&b) }
        BX.IsNull(a, _) { return bxFixed(&a) }
        BX.Cast(a, _) { return bxFixed(&a) }
        BX.Case(cs, _) {
            for c in cs { if !bxFixed(&c) { return false } }
            return true
        }
        BX.Try(a) { return bxFixed(&a) }
        BX.Call(fr, cs) {
            if !lexdb_bind.immutableName(&fr.name) { return false }
            for c in cs { if !bxFixed(&c) { return false } }
            return true
        }
        BX.Sub(_, _, xs) {
            for c in xs { if !bxFixed(&c) { return false } }
            return true
        }
    }
}

// A comparison's code as BNode's (= <> < <= > >= as 0 to 5), -1 another
// operator.
pub fn cmpOf(code: int): int { return if code >= lexdb_ops.OP_EQ && code <= lexdb_ops.OP_GE { code - lexdb_ops.OP_EQ } else { -1 } }

// An arithmetic operator's code as BNode's (+ - * / % as 0 to 4), -1
// another.
pub fn arithOf(code: int): int { return if code >= lexdb_ops.OP_ADD && code <= lexdb_ops.OP_MOD { code } else { -1 } }

// bCompile; dec: numerics as units (kinds may hold BK_DEC columns, and a
// numeric constant is one), else a numeric is a value as any other.
pub fn bCompileD(x: &BX, cols: &[]lexdb_sql.ColDef, kinds: &[]int, ce: &Ctx, base: int, dec: bool): Option[BComp] {
    if bxConst(x) {
        // its value once; an error is left for the row path to give
        let none: []Val = []
        match bxEval(x, &none, &none, ce) {
            Ok(v) {
                match v {
                    Val.Int(i) { return Some(BComp{n: BNode.Const(i, false), typ: BT_INT}) }
                    Val.Bool(b) { return Some(BComp{n: BNode.Const(if b { 1 } else { 0 }, false), typ: BT_BOOL}) }
                    Val.Null { return Some(BComp{n: BNode.Const(0, true), typ: BT_NULL}) }
                    Val.Num(d) {
                        if !dec || d.scale() > lexdb_vec.MAX_SCALE { return None }
                        match lexdb_rows.decUnits(&d, d.scale()) {
                            Some(u) { return Some(BComp{n: BNode.Const(u, false), typ: BT_DEC + d.scale()}) }
                            None { return None }
                        }
                    }
                    else { return None }
                }
            }
            Err(_) { return None }
        }
    }
    match x {
        BX.Col(i) {
            // (a column of another table than the one batched: BK_NONE)
            if i >= len(kinds) || kinds[i] == BK_NONE { return None }
            let k = kinds[i]
            // its place in the batch: base the query's column of the
            // batch's first (the first table's own columns: optimizer 33,
            // it may not be FROM's first; a joined batch's: all, 0)
            let at = i - base
            if lexdb_rows.isDecKind(k) { return Some(BComp{n: BNode.Col(at), typ: BT_DEC + lexdb_rows.decScale(k)}) }
            return Some(BComp{n: BNode.Col(at), typ: if k == BK_INT { BT_INT } else if k == BK_BOOL { BT_BOOL } else { BT_OTHER }})
        }
        BX.Un(u, a) {
            let ca = bCompileD(&a, cols, kinds, ce, base, dec)
            if ca.isNone() { return None }
            let c = ca.unwrap()
            let ty = c.typ
            if u == lexdb_ops.UN_NOT && boolLike(ty) { return Some(BComp{n: BNode.Not(takeN(c)), typ: BT_BOOL}) }
            if u == lexdb_ops.UN_NEG && intLike(ty) { return Some(BComp{n: BNode.Neg(takeN(c)), typ: BT_INT}) }
            // a numeric's negation keeps its scale: 0 - x
            if u == lexdb_ops.UN_NEG && isDecT(ty) { return Some(BComp{n: BNode.DArith(1, BNode.Const(0, false), 0, takeN(c), decSc(ty)), typ: ty}) }
            return None
        }
        BX.And(a, b) { return bAndOr(true, &a, &b, cols, kinds, ce, base, dec) }
        BX.Or(a, b) { return bAndOr(false, &a, &b, cols, kinds, ce, base, dec) }
        BX.Op(code, a, b) {
            let cc = cmpOf(code)
            if cc >= 0 {
                // a column of values (BK_VAL) compared with a column or a
                // constant: as values (VCmp, ValCmp), when the batch's
                // comparison is the row path's for their types (bCmpKinds)
                let ia = colOf(&a, kinds)
                let ib = colOf(&b, kinds)
                if ia >= 0 && ib >= 0 && (isValK(kinds[ia]) || isValK(kinds[ib])) {
                    let ka = cols[ia].typ.kind
                    let kb = cols[ib].typ.kind
                    if !bCmpKinds(ka, kb, ce) || !bCmpKinds(kb, ka, ce) { return None }
                    return Some(BComp{n: BNode.VCmp(cc, ia - base, ib - base, kinds[ia], kinds[ib]), typ: BT_BOOL})
                }
                let va = bValCol(&a, kinds, base)
                let vb = if va >= 0 { -1 } else { bValCol(&b, kinds, base) }
                if va >= 0 || vb >= 0 {
                    let k = if va >= 0 { &b } else { &a }
                    if !bxConst(k) { return None }
                    let none: []Val = []
                    match bxEval(k, &none, &none, ce) {
                        Ok(v) {
                            let c = if va >= 0 { va } else { vb }
                            if !lexdb_ops.isNull(&v) && !bCmpKinds(cols[c + base].typ.kind, lexdb_ops.kindOf(&v), ce) { return None }
                            return Some(BComp{n: BNode.ValCmp(cc, c, v, vb >= 0, kinds[c + base] == BK_TEXT), typ: BT_BOOL})
                        }
                        Err(_) { return None }
                    }
                }
            }
            let ca = bCompileD(&a, cols, kinds, ce, base, dec)
            if ca.isNone() { return None }
            let cb = bCompileD(&b, cols, kinds, ce, base, dec)
            if cb.isNone() { return None }
            let lc = ca.unwrap()
            let rc = cb.unwrap()
            let lt = lc.typ
            let rt = rc.typ
            let l = takeN(lc)
            let r = takeN(rc)
            let ac = arithOf(code)
            if (isDecT(lt) || isDecT(rt)) && (isDecT(lt) || intLike(lt)) && (isDecT(rt) || intLike(rt)) {
                // a numeric with a numeric or an integer (read as a
                // numeric of scale 0, as arith reads it): by value; + and
                // - at the larger scale, * at the sum of the two (Decimal's
                // display scales)
                let sa = decSc(lt)
                let sb = decSc(rt)
                if cc >= 0 { return Some(BComp{n: BNode.DCmp(cc, l, sa, r, sb), typ: BT_BOOL}) }
                if ac == 0 || ac == 1 { return Some(BComp{n: BNode.DArith(ac, l, sa, r, sb), typ: BT_DEC + max(sa, sb)}) }
                if ac == 2 && sa + sb <= lexdb_vec.MAX_SCALE { return Some(BComp{n: BNode.DArith(2, l, sa, r, sb), typ: BT_DEC + sa + sb}) }
                return None
            }
            if cc >= 0 {
                let ok = (intLike(lt) && intLike(rt)) || (boolLike(lt) && boolLike(rt))
                if !ok { return None }
                return Some(BComp{n: BNode.Cmp(cc, l, r), typ: BT_BOOL})
            }
            if ac >= 0 && intLike(lt) && intLike(rt) { return Some(BComp{n: BNode.Arith(ac, l, r), typ: BT_INT}) }
            return None
        }
        BX.IsNull(a, neg) {
            let ca = bCompileD(&a, cols, kinds, ce, base, dec)
            if ca.isNone() { return None }
            return Some(BComp{n: BNode.IsNull(takeN(ca.unwrap()), neg), typ: BT_BOOL})
        }
        BX.Call(fr, args) {
            // x IN (a, b, ...): x = a OR x = b ..., or'd with SQL's NULL
            // for a NULL (or NULL x): one batch test per value, not a
            // function call per row (q12's l_shipmode).
            if fr.name == "in" && len(args) >= 2 {
                var col = -1
                match args[0] {
                    BX.Col(i) { col = i }
                    else {}
                }
                if col >= 0 && col < len(kinds) {
                    let k = kinds[col]
                    if k == BK_INT || k == BK_BOOL || isValK(k) {
                        // the list once: a literal, a parameter, or a call
                        // like char(n)'s padding of one
                        var vs: []Val = []
                        var all = true
                        let none: []Val = []
                        for i in 1..len(args) {
                            if !bxFixed(&args[i]) { all = false; break }
                            match bxEval(&args[i], &none, &none, ce) {
                                Ok(v) { append(mut &vs, v) }
                                Err(_) { all = false }
                            }
                        }
                        if all {
                            var hasNull = false
                            var keep: []Val = []
                            for v in move(vs) {
                                if lexdb_ops.isNull(&v) { hasNull = true; continue }
                                // compared as the row path compares them, one
                                // order for the sorted set (bCmpKinds)
                                if isValK(k) && !bCmpKinds(cols[col].typ.kind, lexdb_ops.kindOf(&v), ce) { return None }
                                append(mut &keep, v)
                            }
                            // A short list is a chain of equality tests; a
                            // long one a sorted set searched by halves (a
                            // 200-value chain read 1.2B values on q12's 6M
                            // rows).
                            if len(keep) <= IN_CHAIN_MAX {
                                var acc = BNode.Const(0, true)
                                var any = false
                                for v in keep {
                                    var n = BNode.Const(0, true)
                                    if isValK(k) {
                                        n = BNode.ValCmp(0, col - base, v.clone(), false, k == BK_TEXT)
                                    } else if k == BK_INT {
                                        match v {
                                            Val.Int(iv) { n = BNode.Cmp(0, BNode.Col(col - base), BNode.Const(iv, false)) }
                                            else { return None }
                                        }
                                    } else {
                                        match v {
                                            Val.Bool(bv) { n = BNode.Cmp(0, BNode.Col(col - base), BNode.Const(if bv { 1 } else { 0 }, false)) }
                                            else { return None }
                                        }
                                    }
                                    if any { acc = BNode.Or(acc, n) } else { acc = n }
                                    any = true
                                }
                                if hasNull {
                                    let nul = BNode.Const(0, true)
                                    acc = if any { BNode.Or(acc, nul) } else { nul }
                                    any = true
                                }
                                if !any { return Some(BComp{n: BNode.Const(0, true), typ: BT_BOOL}) }
                                return Some(BComp{n: acc, typ: BT_BOOL})
                            }
                            var sorted = keep
                            collections.sortBy(mut &sorted, fn(a: &Val, b: &Val): int { return lexdb_sort.sortCmp(a, b) })
                            var uniq: []Val = []
                            for v in move(sorted) {
                                var dup = false
                                if len(uniq) > 0 {
                                    match lexdb_ops.compare(&uniq[len(uniq) - 1], &v) {
                                        Ok(c) { if c == 0 { dup = true } }
                                        Err(_) { return None }
                                    }
                                }
                                if !dup { append(mut &uniq, v) }
                            }
                            if isValK(k) {
                                return Some(BComp{n: BNode.InVals(col - base, uniq, hasNull, k == BK_TEXT), typ: BT_BOOL})
                            }
                            var ints: []int = []
                            for v in uniq {
                                if k == BK_INT {
                                    match v {
                                        Val.Int(iv) { append(mut &ints, iv) }
                                        else { return None }
                                    }
                                } else {
                                    match v {
                                        Val.Bool(bv) { append(mut &ints, if bv { 1 } else { 0 }) }
                                        else { return None }
                                    }
                                }
                            }
                            collections.sortBy(mut &ints, fn(a: &int, b: &int): int { return a.cmp(b) })
                            return Some(BComp{n: BNode.InInts(col - base, ints, hasNull), typ: BT_BOOL})
                        }
                    }
                }
                return None
            }
            if (fr.name != "like" && fr.name != "ilike") || len(args) < 2 || len(args) > 3 { return None }
            let c = bValCol(&args[0], kinds, base)
            if c < 0 { return None }
            var cs: []Val = []
            let none: []Val = []
            for i in 1..len(args) {
                if !bxConst(&args[i]) { return None }
                match bxEval(&args[i], &none, &none, ce) {
                    Ok(v) { append(mut &cs, v) }
                    Err(_) { return None }
                }
            }
            for v in cs { if lexdb_ops.isNull(&v) { return Some(BComp{n: BNode.Const(0, true), typ: BT_NULL}) } }
            let pat = lexdb_sql.text(&cs[0])
            let esc = if len(cs) > 1 { lexdb_sql.text(&cs[1]) } else { "\\" }
            let fold = fr.name == "ilike"
            let simple = !fold && lexdb_like.likeSimple(&pat, &esc) && len(strings.runes(&esc)) <= 1
            let pieces = if simple { lexdb_like.likeSplit(&pat) } else { [] }
            return Some(BComp{n: BNode.Like(c, LikePat{pat: pat, esc: esc, fold: fold, simple: simple, pieces: pieces,
                                                       txt: kinds[c + base] == BK_TEXT}), typ: BT_BOOL})
        }
        else { return None }
    }
}

// a AND b (and), a OR b over a batch: both booleans.
pub fn bAndOr(and: bool, a: &BX, b: &BX, cols: &[]lexdb_sql.ColDef, kinds: &[]int, ce: &Ctx, base: int, dec: bool): Option[BComp] {
    let ca = bCompileD(a, cols, kinds, ce, base, dec)
    if ca.isNone() { return None }
    let cb = bCompileD(b, cols, kinds, ce, base, dec)
    if cb.isNone() { return None }
    let lc = ca.unwrap()
    let rc = cb.unwrap()
    if !boolLike(lc.typ) || !boolLike(rc.typ) { return None }
    let l = takeN(lc)
    let r = takeN(rc)
    return Some(BComp{n: if and { BNode.And(l, r) } else { BNode.Or(l, r) }, typ: BT_BOOL})
}

// An IN list up to this many values is an OR chain in a batch; longer
// lists are a sorted set (search by halves).
pub const IN_CHAIN_MAX = 8

// Whether a column of kind k holds values or texts (BK_VAL, BK_TEXT).
pub fn isValK(k: int): bool { return k == BK_VAL || k == lexdb_rows.BK_TEXT }

const BK_TEXT: int = lexdb_rows.BK_TEXT

// The batch column of x when it is a column of values or texts (isValK),
// else -1.
pub fn bValCol(x: &BX, kinds: &[]int, base: int): int {
    match x {
        BX.Col(i) {
            if i >= len(kinds) || !isValK(kinds[i]) { return -1 }
            return i - base
        }
        else { return -1 }
    }
}

// The query's column x is, if the batch holds it, else -1.
pub fn colOf(x: &BX, kinds: &[]int): int {
    match x {
        BX.Col(i) {
            if i >= len(kinds) || kinds[i] == BK_NONE { return -1 }
            return i
        }
        else { return -1 }
    }
}

// Whether a batch compares a value of kind vk (lexdb_sql.K_*) with a
// column of type kind ck as the row path compares them. ValCmp, VCmp and
// InVals compare in UTC (lexdb_ops.compare), the row path in the session's
// zone (compareZ): they differ only where a date or time kind meets
// another kind outside UTC. A text beside a date or time column is
// declined in any zone: resolve casts an untyped one to the column's type
// (timeLitOid), and InVals' sorted set must be of the column's order.
pub fn bCmpKinds(ck: int, vk: int, ce: &Ctx): bool {
    if ck == vk { return true }
    let tc = lexdb_sql.isTimeKind(ck)
    if !tc && !lexdb_sql.isTimeKind(vk) { return true }
    if tc && vk == lexdb_sql.K_TEXT { return false }
    return ce.zone.isUtc()
}

// n's values for the rows idx of b.
pub fn bEval(n: &BNode, b: &Batch, idx: &[]int): Result[BVec, DbErr] {
    let m = len(idx)
    match n {
        BNode.Const(v, nul) { return Ok(BVec{v: array(m, v), nul: array(m, nul)}) }
        BNode.Col(c) {
            var out = lexdb_rows.bvec(m)
            let src = &b.cols[c]
            for j in 0..m {
                let r = idx[j]
                out.v[j] = src.v[r]
                out.nul[j] = src.nul[r]
            }
            return Ok(out)
        }
        BNode.Arith(op, x, y) {
            var a = try bEval(&x, b, idx)
            let c = try bEval(&y, b, idx)
            for j in 0..m { if c.nul[j] { a.nul[j] = true } }
            if op == 0 {
                for j in 0..m {
                    if a.nul[j] { continue }
                    match a.v[j].checkedAdd(c.v[j]) {
                        Some(r) { a.v[j] = r }
                        None { return Err(e("22003", "bigint out of range")) }
                    }
                }
            } else if op == 1 {
                for j in 0..m {
                    if a.nul[j] { continue }
                    match a.v[j].checkedSub(c.v[j]) {
                        Some(r) { a.v[j] = r }
                        None { return Err(e("22003", "bigint out of range")) }
                    }
                }
            } else if op == 2 {
                for j in 0..m {
                    if a.nul[j] { continue }
                    match a.v[j].checkedMul(c.v[j]) {
                        Some(r) { a.v[j] = r }
                        None { return Err(e("22003", "bigint out of range")) }
                    }
                }
            } else {
                for j in 0..m {
                    if a.nul[j] { continue }
                    if c.v[j] == 0 { return Err(e("22012", "division by zero")) }
                    let r = if op == 3 { a.v[j].checkedDiv(c.v[j]) } else { a.v[j].checkedRem(c.v[j]) }
                    match r {
                        Some(w) { a.v[j] = w }
                        None { return Err(e("22003", "bigint out of range")) }
                    }
                }
            }
            return Ok(a)
        }
        BNode.Neg(x) {
            var a = try bEval(&x, b, idx)
            for j in 0..m {
                if a.nul[j] { continue }
                match (0).checkedSub(a.v[j]) {
                    Some(r) { a.v[j] = r }
                    None { return Err(e("22003", "bigint out of range")) }
                }
            }
            return Ok(a)
        }
        BNode.ValCmp(op, c, k, left, txt) {
            var out = lexdb_rows.bvec(m)
            let kn = lexdb_ops.isNull(&k)
            if txt {
                // (a loop of its own: the kind is the node's, not the row's)
                for j in 0..m {
                    let r = idx[j]
                    if kn || b.cols[c].nul[r] {
                        out.nul[j] = true
                        continue
                    }
                    let y = try textCmp(lexdb_rows.textAt(b, c, r), &k)
                    let x = if left { -y } else { y }
                    let t = if op == 0 { x == 0 } else if op == 1 { x != 0 } else if op == 2 { x < 0 } else if op == 3 { x <= 0 }
                            else if op == 4 { x > 0 } else { x >= 0 }
                    out.v[j] = if t { 1 } else { 0 }
                }
                return Ok(out)
            }
            for j in 0..m {
                let r = idx[j]
                if kn || b.cols[c].nul[r] {
                    out.nul[j] = true
                    continue
                }
                let x = if left { try lexdb_ops.compare(&k, &b.vals[c][r]) } else { try lexdb_ops.compare(&b.vals[c][r], &k) }
                let t = if op == 0 { x == 0 } else if op == 1 { x != 0 } else if op == 2 { x < 0 } else if op == 3 { x <= 0 }
                        else if op == 4 { x > 0 } else { x >= 0 }
                out.v[j] = if t { 1 } else { 0 }
            }
            return Ok(out)
        }
        BNode.InVals(c, vs, hasNull, txt) {
            var out = lexdb_rows.bvec(m)
            for j in 0..m {
                let r = idx[j]
                if b.cols[c].nul[r] { out.nul[j] = true; continue }
                var lo = 0
                var hi = len(vs)
                var hit = false
                while lo < hi {
                    let mid = (lo + hi) / 2
                    let cm = if txt { try textCmp(lexdb_rows.textAt(b, c, r), &vs[mid]) } else { try lexdb_ops.compare(&b.vals[c][r], &vs[mid]) }
                    if cm == 0 { hit = true; break }
                    if cm < 0 { hi = mid } else { lo = mid + 1 }
                }
                if hit { out.v[j] = 1 } else if hasNull { out.nul[j] = true }
            }
            return Ok(out)
        }
        BNode.InInts(c, vs, hasNull) {
            var out = lexdb_rows.bvec(m)
            for j in 0..m {
                let r = idx[j]
                if b.cols[c].nul[r] { out.nul[j] = true; continue }
                let x = b.cols[c].v[r]
                var lo = 0
                var hi = len(vs)
                var hit = false
                while lo < hi {
                    let mid = (lo + hi) / 2
                    if x == vs[mid] { hit = true; break }
                    if x < vs[mid] { hi = mid } else { lo = mid + 1 }
                }
                if hit { out.v[j] = 1 } else if hasNull { out.nul[j] = true }
            }
            return Ok(out)
        }
        BNode.VCmp(op, ca, cb, ka, kb) {
            var out = lexdb_rows.bvec(m)
            for j in 0..m {
                let r = idx[j]
                if b.cols[ca].nul[r] || b.cols[cb].nul[r] {
                    out.nul[j] = true
                    continue
                }
                let x = try bCmpCols(b, ca, ka, cb, kb, r)
                let t = if op == 0 { x == 0 } else if op == 1 { x != 0 } else if op == 2 { x < 0 } else if op == 3 { x <= 0 }
                        else if op == 4 { x > 0 } else { x >= 0 }
                out.v[j] = if t { 1 } else { 0 }
            }
            return Ok(out)
        }
        BNode.Like(c, lp) {
            var out = lexdb_rows.bvec(m)
            for j in 0..m {
                let r = idx[j]
                if b.cols[c].nul[r] {
                    out.nul[j] = true
                    continue
                }
                let hit = if lp.txt {
                    if lp.simple { lexdb_like.likePieces(lexdb_rows.textAt(b, c, r), &lp.pieces) }
                    else { try lexdb_lib.likeMatch(lexdb_rows.textAt(b, c, r), &lp.pat, &lp.esc, lp.fold) }
                } else if lp.simple {
                    match b.vals[c][r] {
                        Val.Text(x) { lexdb_like.likePieces(&x, &lp.pieces) }
                        else { lexdb_like.likePieces(&lexdb_sql.text(&b.vals[c][r]), &lp.pieces) }
                    }
                } else {
                    try lexdb_lib.likeMatch(&(lexdb_sql.text(&b.vals[c][r])), &lp.pat, &lp.esc, lp.fold)
                }
                out.v[j] = if hit { 1 } else { 0 }
            }
            return Ok(out)
        }
        BNode.Cmp(op, x, y) {
            var a = try bEval(&x, b, idx)
            match y {
                BNode.Const(k, kn) {
                    // against a constant: one loop with it in a register
                    if kn {
                        for j in 0..m { a.nul[j] = true }
                        return Ok(a)
                    }
                    cmpConst(op, mut &a, k)
                    return Ok(a)
                }
                else {}
            }
            let c = try bEval(&y, b, idx)
            for j in 0..m { if c.nul[j] { a.nul[j] = true } }
            if op == 0 { for j in 0..m { a.v[j] = if a.v[j] == c.v[j] { 1 } else { 0 } } }
            else if op == 1 { for j in 0..m { a.v[j] = if a.v[j] != c.v[j] { 1 } else { 0 } } }
            else if op == 2 { for j in 0..m { a.v[j] = if a.v[j] < c.v[j] { 1 } else { 0 } } }
            else if op == 3 { for j in 0..m { a.v[j] = if a.v[j] <= c.v[j] { 1 } else { 0 } } }
            else if op == 4 { for j in 0..m { a.v[j] = if a.v[j] > c.v[j] { 1 } else { 0 } } }
            else { for j in 0..m { a.v[j] = if a.v[j] >= c.v[j] { 1 } else { 0 } } }
            return Ok(a)
        }
        BNode.And(x, y) {
            // y only for the rows x leaves open (true or NULL), as eval
            var a = try bEval(&x, b, idx)
            var sub: []int = []
            for j in 0..m { if a.nul[j] || a.v[j] != 0 { append(mut &sub, idx[j]) } }
            if len(sub) == 0 { return Ok(a) }
            let c = try bEval(&y, b, &sub)
            var k = 0
            for j in 0..m {
                if !a.nul[j] && a.v[j] == 0 { continue }
                if !c.nul[k] && c.v[k] == 0 {
                    a.v[j] = 0
                    a.nul[j] = false
                } else if a.nul[j] || c.nul[k] {
                    a.nul[j] = true
                } else {
                    a.v[j] = 1
                }
                k += 1
            }
            return Ok(a)
        }
        BNode.Or(x, y) {
            var a = try bEval(&x, b, idx)
            var sub: []int = []
            for j in 0..m { if a.nul[j] || a.v[j] == 0 { append(mut &sub, idx[j]) } }
            if len(sub) == 0 { return Ok(a) }
            let c = try bEval(&y, b, &sub)
            var k = 0
            for j in 0..m {
                if !a.nul[j] && a.v[j] != 0 { continue }
                if !c.nul[k] && c.v[k] != 0 {
                    a.v[j] = 1
                    a.nul[j] = false
                } else if a.nul[j] || c.nul[k] {
                    a.nul[j] = true
                } else {
                    a.v[j] = 0
                }
                k += 1
            }
            return Ok(a)
        }
        BNode.Not(x) {
            var a = try bEval(&x, b, idx)
            for j in 0..m { a.v[j] = 1 - a.v[j] }
            return Ok(a)
        }
        BNode.IsNull(x, neg) {
            var a = try bEval(&x, b, idx)
            for j in 0..m {
                a.v[j] = if a.nul[j] != neg { 1 } else { 0 }
                a.nul[j] = false
            }
            return Ok(a)
        }
        BNode.InGen(g, vs, orig, hasNull, kc) {
            let xs = try bGenVals(&g, b, idx)
            var out = lexdb_rows.bvec(m)
            for j in 0..m {
                let x = &xs[j]
                if lexdb_ops.isNull(x) { out.nul[j] = true; continue }
                if lexdb_ops.kindOf(x) != kc {
                    // as the row path's in (lexdb_lib.inFn): the list in order
                    var hit = false
                    var sawNull = false
                    for v in orig {
                        if lexdb_ops.isNull(&v) { sawNull = true; continue }
                        if (try lexdb_ops.compareZ(x, &v, &g.ce.zone)) == 0 { hit = true; break }
                    }
                    if hit { out.v[j] = 1 } else if sawNull { out.nul[j] = true }
                    continue
                }
                var lo = 0
                var hi = len(vs)
                var hit = false
                while lo < hi {
                    let mid = (lo + hi) / 2
                    let cm = try lexdb_ops.compareZ(x, &vs[mid], &g.ce.zone)
                    if cm == 0 { hit = true; break }
                    if cm < 0 { hi = mid } else { lo = mid + 1 }
                }
                if hit { out.v[j] = 1 } else if hasNull { out.nul[j] = true }
            }
            return Ok(out)
        }
        BNode.Gen(g) {
            // a condition: 1 where it holds (its value true), as the row path checks it
            let vs = try bGenVals(&g, b, idx)
            var out = lexdb_rows.bvec(m)
            for j in 0..m { if lexdb_ops.truth(&vs[j]) == Some(true) { out.v[j] = 1 } }
            return Ok(out)
        }
        BNode.DArith(op, x, sa, y, sb) {
            var a = try bEval(&x, b, idx)
            let c = try bEval(&y, b, idx)
            if !lexdb_vec.arith(op, mut &a, sa, &c, sb) { return Err(decSpill()) }
            return Ok(a)
        }
        BNode.DCmp(op, x, sa, y, sb) {
            var a = try bEval(&x, b, idx)
            let c = try bEval(&y, b, idx)
            lexdb_vec.cmp(op, mut &a, sa, &c, sb)
            return Ok(a)
        }
    }
}

// g's values for the rows idx of b.
pub fn bGenVals(g: &BGen, b: &Batch, idx: &[]int): Result[[]Val, DbErr] {
    let m = len(idx)
    let ns = len(g.cols)
    // two shapes run without a row or a walk, as cEval would run them: a
    // function of one argument bound to its entry (FnRef.f1), of a column; an operator
    // of a column and a constant
    if ns == 1 {
        let c = g.cols[0]
        let k = g.kinds[0]
        match g.cx {
            lexdb_bind.BX.Call(fb, cs) {
                if fb.way == lexdb_bind.FN_ONE && !fb.dialect && len(cs) == 1 && cxCol0(&cs[0]) {
                    var out: []Val = withCapacity(m)
                    for j in 0..m {
                        let r = idx[j]
                        if b.cols[c].nul[r] {
                            append(mut &out, Val.Null)
                            continue
                        }
                        append(mut &out, if k == BK_VAL { try fb.f1(&fb.name, &b.vals[c][r]) } else { try fb.f1(&fb.name, &bValAt(b, c, k, r)) })
                    }
                    return Ok(out)
                }
            }
            lexdb_bind.BX.Op(code, x, y) {
                let lc = cxCol0(&x)
                let rc = cxCol0(&y)
                var kv = Val.Null
                let lit = if lc { cxLit(&y, &g.ce, mut &kv) } else { cxLit(&x, &g.ce, mut &kv) }
                if (lc || rc) && !(lc && rc) && lit {
                    var out: []Val = withCapacity(m)
                    for j in 0..m {
                        let r = idx[j]
                        let v = if b.cols[c].nul[r] { Val.Null } else { bValAt(b, c, k, r) }
                        append(mut &out, if lc { try lexdb_ops.binOp(code, v, kv.clone(), fn(): lexdb_time.Zone { return g.ce.zone.clone() }) } else { try lexdb_ops.binOp(code, kv.clone(), v, fn(): lexdb_time.Zone { return g.ce.zone.clone() }) })
                    }
                    return Ok(out)
                }
            }
            else {}
        }
    }
    var row: []Val = array(ns, Val.Null)
    let none: []Val = []
    var out: []Val = withCapacity(m)
    for j in 0..m {
        let r = idx[j]
        for p in 0..ns {
            let c = g.cols[p]
            row[p] = if b.cols[c].nul[r] { Val.Null } else { bValAt(b, c, g.kinds[p], r) }
        }
        append(mut &out, try bxEval(&g.cx, &row, &none, &g.ce))
    }
    return Ok(out)
}

// Whether x is a constant: a literal, or a parameter slot given in ce
// (its value in v).
pub fn cxLit(x: &lexdb_bind.BX, ce: &Ctx, v: mut &Val): bool {
    match x {
        lexdb_bind.BX.Const(k) {
            v = k.clone()
            return true
        }
        lexdb_bind.BX.Param(i) {
            if i >= len(ce.params) { return false }
            v = ce.params[i].clone()
            return true
        }
        else { return false }
    }
}

// Whether x is the column of a one-column row (cEval: its place 0).
pub fn cxCol0(x: &lexdb_bind.BX): bool {
    match x {
        lexdb_bind.BX.Col(i) { return i == 0 }
        else { return false }
    }
}

// x, bound over the query's columns by place (the plan's binding, or
// bxOf), compiled to run over a batch (BGen): re-slotted (lexdb_bind.reslot)
// to a row of the columns it reads, the query's column i the batch's
// i - base; kinds per column of the query (BK_NONE: not in the batch),
// need per column of the batch (decoded); evaluated in ce (the run's:
// Mats.ce), its parameters with it when x reads one. None: x reads a
// column the batch does not hold.
pub fn bGenOf(x: &BX, kinds: &[]int, base: int, need: &[]bool, ce: &Ctx): Option[BGen] {
    var slots: []int = []
    var par = false
    let c = lexdb_bind.reslot(x, mut &slots, mut &par)
    var cols: []int = []
    var ks: []int = []
    for i in slots {
        if i >= len(kinds) || kinds[i] == BK_NONE || i - base < 0 || i - base >= len(need) || !need[i - base] { return None }
        append(mut &cols, i - base)
        append(mut &ks, kinds[i])
    }
    let gce = Ctx{now: ce.now, zone: ce.zone.clone(), params: if par { collections.copyOf(&ce.params) } else { [] }, up: ce.up,
                  subs: if par && lexdb_bind.hasSub(x) { copySubs(&ce.subs) } else { [] }}
    return Some(BGen{cx: c, cols: cols, kinds: ks, ce: gce})
}

// vals, of b's rows idx, added to b as a column of values (BK_VAL): its place.
pub fn bAddVals(b: mut &Batch, idx: &[]int, vals: []Val): int {
    let c = len(b.cols)
    append(mut &b.txt, "")
    var col = BVec{v: [], nul: array(b.n, true)}
    var vs = vals
    if len(idx) == b.n {
        // every row of b (idx is 0, 1, ...): the values are the column
        for j in 0..b.n { if !lexdb_ops.isNull(&vs[j]) { col.nul[j] = false } }
    } else {
        var all: []Val = array(b.n, Val.Null)
        for j in 0..len(idx) {
            let r = idx[j]
            if !lexdb_ops.isNull(&vs[j]) {
                col.nul[r] = false
                all[r] = replace(mut &vs[j], Val.Null)
            }
        }
        vs = all
    }
    append(mut &b.cols, col)
    append(mut &b.vals, vs)
    return c
}

pub fn cmpConst(op: int, a: mut &BVec, k: int) {
    let m = len(a.v)
    if op == 0 { for j in 0..m { a.v[j] = if a.v[j] == k { 1 } else { 0 } } }
    else if op == 1 { for j in 0..m { a.v[j] = if a.v[j] != k { 1 } else { 0 } } }
    else if op == 2 { for j in 0..m { a.v[j] = if a.v[j] < k { 1 } else { 0 } } }
    else if op == 3 { for j in 0..m { a.v[j] = if a.v[j] <= k { 1 } else { 0 } } }
    else if op == 4 { for j in 0..m { a.v[j] = if a.v[j] > k { 1 } else { 0 } } }
    else { for j in 0..m { a.v[j] = if a.v[j] >= k { 1 } else { 0 } } }
}

// The positions j of idx whose row n holds for (true, not NULL).
pub fn bTrue(n: &BNode, b: &Batch, idx: &[]int): Result[[]int, DbErr] {
    let t = try bEval(n, b, idx)
    var out: []int = []
    for j in 0..len(idx) { if t.v[j] == 1 && !t.nul[j] { append(mut &out, j) } }
    return Ok(out)
}

// The two steps for a batch plan with these conditions: a simple LIKE on
// a column no other condition reads on the rows' bytes; then the places
// of the columns the others read (and extra's, a bar's: -1 none); then
// the rest. Off when nothing is read first, or nothing after.
pub fn lazyOf(bp: &BPlan, t: &lexdb_catalog.Table, conds: &[]BNode, extra: int): Lazy {
    let nc = len(bp.kinds)
    var used: []bool = array(nc, false)
    var likeOn: []int = array(len(conds), -1)
    for ci in 0..len(conds) {
        match conds[ci] {
            BNode.Like(c, lp) { if lp.simple { likeOn[ci] = c } }
            else {}
        }
        if likeOn[ci] < 0 { bColsOf(&conds[ci], mut &used) }
    }
    var raw: []int = []
    var rawPl: []int = []
    var pieces: [][]str = []
    var skip: []bool = array(len(conds), false)
    for ci in 0..len(conds) {
        let c = likeOn[ci]
        if c < 0 { continue }
        if used[c] { continue }
        append(mut &raw, ci)
        append(mut &rawPl, if len(t.slots) == 0 { c } else { t.slots[c] })
        match conds[ci] {
            BNode.Like(_, lp) {
                var ps: []str = []
                for x in lp.pieces { append(mut &ps, x.clone()) }
                append(mut &pieces, ps)
            }
            else { append(mut &pieces, []) }
        }
        skip[ci] = true
    }
    // (a column two raw conditions read: both raw)
    for ci in 0..len(conds) { if likeOn[ci] >= 0 && !skip[ci] { used[likeOn[ci]] = true } }
    if extra >= 0 { used[extra] = true }
    var first: []int = []
    var rest: []int = []
    for pl in bp.usedP {
        let c = bp.placeCol[pl]
        if used[c] { append(mut &first, pl) } else { append(mut &rest, pl) }
    }
    var bf = placesOnly(bp, &first)
    for pl in rawPl { bf.placeCol[pl] = bp.placeCol[pl] }
    bf.stopAt = 0
    for pl in 0..len(bf.placeCol) { if bf.placeCol[pl] >= 0 { bf.stopAt = pl + 1 } }
    let br = placesOnly(bp, &rest)
    return Lazy{on: (len(first) > 0 || len(raw) > 0) && len(rest) > 0, first: first, rest: rest, raw: raw, rawPl: rawPl, pieces: pieces, skip: skip,
                bf: bf, br: br}
}

// bp reading places ps only, as a tagged row is read (decodeRow): its
// placeCol those places' (-1 the others), stopAt the last one's end.
pub fn placesOnly(bp: &BPlan, ps: &[]int): BPlan {
    var pc: []int = array(len(bp.placeCol), -1)
    var stop = 0
    for pl in ps {
        pc[pl] = bp.placeCol[pl]
        if pl + 1 > stop { stop = pl + 1 }
    }
    var need: []bool = []
    for x in bp.needCol { append(mut &need, x) }
    var np: []bool = []
    for x in bp.needP { append(mut &np, x) }
    return BPlan{kinds: collections.copyOf(&bp.kinds), needCol: need, placeCol: pc, usedP: collections.copyOf(ps), stopAt: stop,
                 missing: collections.copyOf(&bp.missing), needP: np, width: bp.width, ranges: []}
}

// idx0 narrowed to the rows of b every one of conds (not marked in skip)
// holds for, in order; None: one gives an error on one of them.
pub fn bNarrow(conds: &[]BNode, skip: &[]bool, b: &Batch, idx0: []int): Option[[]int] {
    var idx = idx0
    for ci in 0..len(conds) {
        if len(idx) == 0 { break }
        if ci < len(skip) && skip[ci] { continue }
        match bTrue(&conds[ci], b, &idx) {
            Ok(pos) {
                var next: []int = withCapacity(len(pos))
                for j in pos { append(mut &next, idx[j]) }
                idx = next
            }
            Err(_) { return None }
        }
    }
    return Some(idx)
}

// The ranges conds (each must hold for a row to be kept) put on places
// (BPlan.ranges): per condition of a column of integers (kinds: BK_INT)
// compared with an integer constant, or of a date or time column with a
// value of its own type (9.113), or an AND of them.
pub fn cRanges(conds: &[]BNode, kinds: &[]int, t: &lexdb_catalog.Table): []int {
    var out: []int = []
    for c in conds { cRangesOf(&c, kinds, t, mut &out) }
    return out
}

pub fn cRangesOf(n: &BNode, kinds: &[]int, t: &lexdb_catalog.Table, out: mut &[]int) {
    match n {
        BNode.And(a, b) {
            cRangesOf(&a, kinds, t, out)
            cRangesOf(&b, kinds, t, out)
        }
        BNode.Cmp(op, a, b) {
            var col = -1
            var v = 0
            var o = op
            match a {
                BNode.Col(c) {
                    match b {
                        BNode.Const(x, nul) { if !nul { col = c; v = x } }
                        else {}
                    }
                }
                BNode.Const(x, nul) {
                    match b {
                        BNode.Col(c) {
                            if !nul {
                                col = c
                                v = x
                                // the constant on the left: the comparison turned round
                                o = if op == 2 { 4 } else if op == 3 { 5 } else if op == 4 { 2 } else if op == 5 { 3 } else { op }
                            }
                        }
                        else {}
                    }
                }
                else {}
            }
            if col < 0 || col >= len(kinds) || kinds[col] != BK_INT || o == 1 { return }
            cRangeAdd(o, v, col, 0, t, out)
        }
        BNode.ValCmp(op, c, k, left, _) {
            // a date or time column compared with a value of its own kind
            // (9.113): as the words its places hold (compare orders them so)
            if op == 1 || c >= len(t.cols) { return }
            let pk = timeKindOf(t.cols[c].typ.oid)
            if pk == lexdb_rows.PK_NONE { return }
            var v = 0
            match k {
                Val.Date(x) { if pk == lexdb_rows.PK_DATE { v = x } else { return } }
                Val.Time(x) { if pk == lexdb_rows.PK_TIME { v = x } else { return } }
                Val.Ts(x) { if pk == lexdb_rows.PK_TS { v = x } else { return } }
                Val.Tstz(x) { if pk == lexdb_rows.PK_TSTZ { v = x } else { return } }
                else { return }
            }
            let o = if !left { op } else if op == 2 { 4 } else if op == 3 { 5 } else if op == 4 { 2 } else if op == 5 { 3 } else { op }
            cRangeAdd(o, v, c, int(pk), t, out)
        }
        else {}
    }
}

// A date or time type's place kind (9.113); PK_NONE another type.
pub fn timeKindOf(oid: int): byte {
    if oid == lexdb_sql.OID_DATE { return lexdb_rows.PK_DATE }
    if oid == lexdb_sql.OID_TIME { return lexdb_rows.PK_TIME }
    if oid == lexdb_sql.OID_TS { return lexdb_rows.PK_TS }
    if oid == lexdb_sql.OID_TSTZ { return lexdb_rows.PK_TSTZ }
    return lexdb_rows.PK_NONE
}

// Adds to out the range "column col (the table's) op v" keeps: (place, the
// place kind it holds for: 0 any integer's, least, greatest).
pub fn cRangeAdd(o: int, v: int, col: int, kind: int, t: &lexdb_catalog.Table, out: mut &[]int) {
    let MIN = -9223372036854775807 - 1
    let MAX = 9223372036854775807
    var lo = MIN
    var hi = MAX
    if o == 0 {
        lo = v
        hi = v
    } else if o == 2 {
        if v == MIN { lo = 1; hi = 0 } else { hi = v - 1 }
    } else if o == 3 { hi = v }
    else if o == 4 {
        if v == MAX { lo = 1; hi = 0 } else { lo = v + 1 }
    } else if o == 5 { lo = v }
    append(out, if len(t.slots) == 0 { col } else { t.slots[col] })
    append(out, kind)
    append(out, lo)
    append(out, hi)
}

// The columns cols of row r of a batch, appended to out; the bytes a group
// holds for its first row (as rowBytes counts a row of len(kinds) values).
pub fn bFirstVals(b: &Batch, r: int, kinds: &[]int, cols: &[]int, out: mut &[]Val): int {
    var n = 32 + 24 * len(kinds)
    for i in cols {
        var v = Val.Null
        if len(b.cols[i].nul) > 0 && !b.cols[i].nul[r] {
            let k = kinds[i]
            // (as bRow: a numeric(p, s) column's units are its value)
            v = if k == BK_INT { Val.Int(b.cols[i].v[r]) } else if k == BK_BOOL { Val.Bool(b.cols[i].v[r] == 1) }
                else if lexdb_rows.isDecKind(k) { lexdb_rows.decVal(b.cols[i].v[r], lexdb_rows.decScale(k)) }
                else if k == BK_TEXT { Val.Text(lexdb_rows.textAt(b, i, r).clone()) } else { b.vals[i][r].clone() }
        }
        n += valExtra(&v)
        append(out, v)
    }
    return n
}

// Row r of a batch as the row path gives it: its columns used, NULL for
// the others.
pub fn bRow(b: &Batch, r: int, kinds: &[]int, needCol: &[]bool): []Val {
    var out: []Val = array(len(kinds), Val.Null)
    for i in 0..len(kinds) {
        if !needCol[i] || len(b.cols[i].nul) == 0 || b.cols[i].nul[r] { continue }
        let k = kinds[i]
        out[i] = if k == BK_INT { Val.Int(b.cols[i].v[r]) } else if k == BK_BOOL { Val.Bool(b.cols[i].v[r] == 1) }
                 else if lexdb_rows.isDecKind(k) { lexdb_rows.decVal(b.cols[i].v[r], lexdb_rows.decScale(k)) }
                 else if k == BK_TEXT { Val.Text(lexdb_rows.textAt(b, i, r).clone()) } else { b.vals[i][r].clone() }
    }
    return out
}

// A group key's value at row r: an expression's (BVec at position j) or a
// column's of another type.
pub fn bKeyVal(c: &BComp, kv: &BVec, j: int, b: &Batch, r: int): Val {
    if c.typ == BT_OTHER {
        match c.n {
            BNode.Col(i) {
                if b.cols[i].nul[r] { return Val.Null }
                if lexdb_rows.isTextCol(b, i) { return Val.Text(lexdb_rows.textAt(b, i, r).clone()) }
                return b.vals[i][r].clone()
            }
            else { return Val.Null }
        }
    }
    if kv.nul[j] { return Val.Null }
    if c.typ == BT_BOOL { return Val.Bool(kv.v[j] == 1) }
    if isDecT(c.typ) { return lexdb_rows.decVal(kv.v[j], decSc(c.typ)) }
    return Val.Int(kv.v[j])
}

// Per key, whether it is a BK_TEXT column of b (bKeyEnc's txt).
fn keyTexts(keys: &[]BComp, b: &Batch): []bool {
    var out: []bool = []
    for k in keys {
        var t = false
        if k.typ == BT_OTHER {
            match k.n {
                BNode.Col(i) { t = lexdb_rows.isTextCol(b, i) }
                else {}
            }
        }
        append(mut &out, t)
    }
    return out
}

// encIdxPart of bKeyVal, a column's value encoded in place rather than
// copied; txt: the key a BK_TEXT column (keyTexts', once per batch).
fn bKeyEnc(kb: mut &str, c: &BComp, kv: &BVec, j: int, b: &Batch, r: int, txt: bool) {
    if c.typ == BT_OTHER {
        match c.n {
            BNode.Col(i) {
                if txt {
                    if b.cols[i].nul[r] { kb.addByte(2) } else { lexdb_access.encIdxText(kb, lexdb_rows.textAt(b, i, r)) }
                } else {
                    lexdb_access.encIdxPart(kb, &b.vals[i][r])
                }
                return
            }
            else {}
        }
    }
    lexdb_access.encIdxPart(kb, &bKeyVal(c, kv, j, b, r))
}

// Marks the columns n reads.
pub fn bColsOf(n: &BNode, used: mut &[]bool) {
    match n {
        BNode.Const(_, _) {}
        BNode.Col(c) { used[c] = true }
        BNode.Arith(_, a, b) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
        BNode.Neg(a) { bColsOf(&a, used) }
        BNode.Cmp(_, a, b) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
        BNode.And(a, b) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
        BNode.Or(a, b) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
        BNode.Not(a) { bColsOf(&a, used) }
        BNode.IsNull(a, _) { bColsOf(&a, used) }
        BNode.ValCmp(_, c, _, _, _) { used[c] = true }
        BNode.Like(c, _) { used[c] = true }
        BNode.InVals(c, _, _, _) { used[c] = true }
        BNode.InInts(c, _, _) { used[c] = true }
        BNode.VCmp(_, a, b, _, _) {
            used[a] = true
            used[b] = true
        }
        BNode.Gen(g) { for c in g.cols { used[c] = true } }
        BNode.InGen(g, _, _, _, _) { for c in g.cols { used[c] = true } }
        BNode.DArith(_, a, _, b, _) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
        BNode.DCmp(_, a, _, b, _) {
            bColsOf(&a, used)
            bColsOf(&b, used)
        }
    }
}

// Column c (of kind k) of b at row r, not NULL, as a value.
// Whether bValAt of kind k reads a value column (b.vals) rather than making a Val.
fn isValKind(k: int): bool { return k != BK_INT && k != BK_BOOL && !lexdb_rows.isDecKind(k) }

// compare of columns ca and cb at row r (kinds ka, kb), a value column's
// value read in place rather than copied.
fn bCmpCols(b: &Batch, ca: int, ka: int, cb: int, kb: int, r: int): Result[int, DbErr] {
    // texts by their bytes; a text and a value as compare compares them
    if ka == BK_TEXT && kb == BK_TEXT { return Ok(lexdb_rows.textAt(b, ca, r).cmp(lexdb_rows.textAt(b, cb, r))) }
    if ka == BK_TEXT && kb == BK_VAL { return textCmp(lexdb_rows.textAt(b, ca, r), &b.vals[cb][r]) }
    if ka == BK_VAL && kb == BK_TEXT { return Ok(-(try textCmp(lexdb_rows.textAt(b, cb, r), &b.vals[ca][r]))) }
    let va = ka == BK_VAL
    let vb = kb == BK_VAL
    if va && vb { return lexdb_ops.compare(&b.vals[ca][r], &b.vals[cb][r]) }
    if va { return lexdb_ops.compare(&b.vals[ca][r], &bValAt(b, cb, kb, r)) }
    if vb { return lexdb_ops.compare(&bValAt(b, ca, ka, r), &b.vals[cb][r]) }
    return lexdb_ops.compare(&bValAt(b, ca, ka, r), &bValAt(b, cb, kb, r))
}

// A text t compared with value k as compare compares a text with it:
// another text by its bytes, any other kind through the value.
pub fn textCmp(t: &str, k: &Val): Result[int, DbErr] {
    match k {
        Val.Text(y) { return Ok(t.cmp(&y)) }
        else { return lexdb_ops.compare(&Val.Text(t.clone()), k) }
    }
}

pub fn bValAt(b: &Batch, c: int, k: int, r: int): Val {
    if k == BK_INT { return Val.Int(b.cols[c].v[r]) }
    if k == BK_BOOL { return Val.Bool(b.cols[c].v[r] == 1) }
    if lexdb_rows.isDecKind(k) { return lexdb_rows.decVal(b.cols[c].v[r], lexdb_rows.decScale(k)) }
    if k == BK_TEXT { return Val.Text(lexdb_rows.textAt(b, c, r).clone()) }
    return b.vals[c][r].clone()
}

// Adds the rows (gids: their groups) of a batch to a value aggregate's
// counts and values (sp.vcol): row by row, in order, with eval's arith and
// compare, as accumulate does (the last of equal values kept).
pub fn bAccVal(sp: &BSpec, b: &Batch, rows: &[]int, gids: &[]int, cn: mut &[]int, av: mut &[]Val): Result[Unit, DbErr] {
    let c = sp.vcol
    let summing = sp.kind == BA_SUM || sp.kind == BA_AVG
    let mx = sp.kind == BA_MAX
    if lexdb_rows.isTextCol(b, c) {
        // a text column's min or max (a text's sum errs as the row path's)
        for j in 0..len(rows) {
            let r = rows[j]
            if b.cols[c].nul[r] { continue }
            let g = gids[j]
            let t = lexdb_rows.textAt(b, c, r)
            if lexdb_ops.isNull(&av[g]) {
                av[g] = Val.Text(t.clone())
            } else if summing {
                av[g] = try lexdb_ops.arith(lexdb_ops.OP_ADD, &av[g], &Val.Text(t.clone()))
            } else {
                let x = try textCmp(t, &av[g])
                if (mx && x >= 0) || (!mx && x <= 0) { av[g] = Val.Text(t.clone()) }
            }
            cn[g] += 1
        }
        return Ok(Unit{})
    }
    for j in 0..len(rows) {
        let r = rows[j]
        if b.cols[c].nul[r] { continue }
        let g = gids[j]
        if lexdb_ops.isNull(&av[g]) {
            av[g] = b.vals[c][r].clone()
        } else if summing {
            av[g] = try lexdb_ops.arith(lexdb_ops.OP_ADD, &av[g], &b.vals[c][r])
        } else {
            let x = try lexdb_ops.compare(&b.vals[c][r], &av[g])
            if (mx && x >= 0) || (!mx && x <= 0) { av[g] = b.vals[c][r].clone() }
        }
        cn[g] += 1
    }
    return Ok(Unit{})
}

// Adds the rows (gids: their groups) of a batch to a numeric aggregate's
// counts and sums as units (sp.dsc), in 128 bits.
pub fn bAccDec(sp: &BSpec, b: &Batch, rows: &[]int, gids: &[]int, one: bool, cn: mut &[]int, su: mut &[]i128): Result[Unit, DbErr] {
    let a = match sp.arg {
        Some(x) { try bEval(&x, b, rows) }
        None { lexdb_rows.bvec(0) }
    }
    lexdb_vec.sum(&a, gids, one, cn, su)
    return Ok(Unit{})
}

// Adds the rows (gids: their groups) of a batch to an aggregate's counts,
// sums and minima or maxima per group; one: a single group (its values
// kept in registers through the loop).
pub fn bAccum(sp: &BSpec, b: &Batch, rows: &[]int, gids: &[]int, one: bool, cn: mut &[]int, su: mut &[]int,
          mm: mut &[]int): Result[Unit, DbErr] {
    let k = len(rows)
    if sp.kind == BA_STAR {
        if one { cn[0] += k } else { for j in 0..k { cn[gids[j]] += 1 } }
        return Ok(Unit{})
    }
    let a = match sp.arg {
        Some(x) { try bEval(&x, b, rows) }
        None { lexdb_rows.bvec(0) }
    }
    if sp.kind == BA_COUNT {
        if one {
            var c = cn[0]
            for j in 0..k { if !a.nul[j] { c += 1 } }
            cn[0] = c
        } else {
            for j in 0..k { if !a.nul[j] { cn[gids[j]] += 1 } }
        }
        return Ok(Unit{})
    }
    if sp.kind == BA_SUM || sp.kind == BA_AVG {
        if one {
            var s = su[0]
            var c = cn[0]
            for j in 0..k {
                if a.nul[j] { continue }
                match s.checkedAdd(a.v[j]) {
                    Some(w) { s = w }
                    None { return Err(e("22003", "bigint out of range")) }
                }
                c += 1
            }
            su[0] = s
            cn[0] = c
        } else {
            for j in 0..k {
                if a.nul[j] { continue }
                let g = gids[j]
                match su[g].checkedAdd(a.v[j]) {
                    Some(w) { su[g] = w }
                    None { return Err(e("22003", "bigint out of range")) }
                }
                cn[g] += 1
            }
        }
        return Ok(Unit{})
    }
    let mx = sp.kind == BA_MAX
    for j in 0..k {
        if a.nul[j] { continue }
        let g = if one { 0 } else { gids[j] }
        let v = a.v[j]
        if cn[g] == 0 || (if mx { v > mm[g] } else { v < mm[g] }) { mm[g] = v }
        cn[g] += 1
    }
    return Ok(Unit{})
}

// rowBytes' count for a value past its 24 bytes.
pub fn valExtra(v: &Val): int {
    match v {
        Val.Text(t) { return len(t) }
        Val.Num(_) { return 32 }
        Val.Ival(_) { return 24 }
        else { return 0 }
    }
}

// An output or ORDER BY key over a batch: its node, its kind (BK_*) and
// its source (bOutVal's).
pub type ONode = record {
    pub n: BNode
    pub kind: int
    pub src: int
}

pub fn takeON(c: ONode): BNode {
    var x = c
    return replace(mut &x.n, BNode.Const(0, false))
}

// x, bound (as bCompile takes it), as an output or key over the batch: a
// column of it (src its column), an integer or boolean expression (src
// -1), or a compiled expression of any type (9.108: src -2, its values
// BK_VAL; bGenOf). kinds: per column of the query (base: the batch's
// first), need: per column of the batch, decoded. None: not one the
// batches evaluate.
pub fn outNode(x: &BX, cols: &[]lexdb_sql.ColDef, kinds: &[]int, ce: &Ctx, base: int, need: &[]bool): Option[ONode] {
    let c = bCompile(x, cols, kinds, ce, base)
    if c.isSome() {
        let cc = c.unwrap()
        var col = -1
        match cc.n {
            BNode.Col(i) { col = i }
            else {}
        }
        if col >= 0 {
            if col >= len(need) || !need[col] { return None }
            return Some(ONode{n: BNode.Col(col), kind: kinds[col + base], src: col})
        }
        if cc.typ != BT_OTHER { return Some(ONode{kind: if cc.typ == BT_BOOL { BK_BOOL } else { BK_INT }, src: -1, n: takeN(cc)}) }
    }
    match bGenOf(x, kinds, base, need, ce) {
        Some(g) { return Some(ONode{n: BNode.Gen(g), kind: BK_VAL, src: -2}) }
        None { return None }
    }
}

// An output's or key's values (node, src as OutPlan has them) for b's rows
// idx: an integer or boolean expression's into ex (src -1); a compiled
// one's (-2) added to b as a column of values, its place in srcs (as a
// column's own: src >= 0). Err: an expression's error on one of the rows.
pub fn bOutVal(n: &BNode, src: int, b: mut &Batch, idx: &[]int, ex: mut &[]BVec, srcs: mut &[]int): Result[Unit, DbErr] {
    if src >= 0 {
        append(ex, lexdb_rows.bvec(0))
        append(srcs, src)
        return Ok(Unit{})
    }
    if src == -1 {
        append(ex, try bEval(n, b, idx))
        append(srcs, -1)
        return Ok(Unit{})
    }
    var vs: []Val = []
    match n {
        BNode.Gen(g) { vs = try bGenVals(&g, b, idx) }
        else { return Err(e("XX000", "an output's node")) }
    }
    append(srcs, bAddVals(b, idx, vs))
    append(ex, lexdb_rows.bvec(0))
    return Ok(Unit{})
}

// x, bound, as a condition over the batch: an integer or boolean kernel,
// else a compiled expression (Gen: true where its value is true). None: x
// reads a column the batch does not hold.
pub fn condNode(x: &BX, cols: &[]lexdb_sql.ColDef, kinds: &[]int, ce: &Ctx, base: int, need: &[]bool): Option[BNode] {
    let c = bCompile(x, cols, kinds, ce, base)
    if c.isSome() {
        let cc = c.unwrap()
        if boolLike(cc.typ) { return Some(takeN(cc)) }
    }
    match inGenOf(x, kinds, ce, base, need) {
        Some(n) { return Some(n) }
        None {}
    }
    match bGenOf(x, kinds, base, need, ce) {
        Some(g) { return Some(BNode.Gen(g)) }
        None { return None }
    }
}

// x IN (a, b, ...) whose x is not a column (the IN kernels') but a
// compiled expression, the list constants of one kind: InGen, its values
// made once per row and looked up in the list sorted. None: not one.
fn inGenOf(x: &BX, kinds: &[]int, ce: &Ctx, base: int, need: &[]bool): Option[BNode] {
    match x {
        BX.Call(fr, args) {
            if fr.name != "in" || len(args) < 2 { return None }
            match args[0] {
                BX.Col(_) { return None }
                else {}
            }
            let none: []Val = []
            var orig: []Val = []
            var keep: []Val = []
            var hasNull = false
            var kc = -1
            for i in 1..len(args) {
                if !bxFixed(&args[i]) { return None }
                let v = match bxEval(&args[i], &none, &none, ce) {
                    Ok(v) { v }
                    Err(_) { return None }
                }
                if lexdb_ops.isNull(&v) {
                    hasNull = true
                } else {
                    let k = lexdb_ops.kindOf(&v)
                    if kc < 0 { kc = k } else if k != kc { return None }
                    append(mut &keep, v.clone())
                }
                append(mut &orig, v)
            }
            if kc < 0 { return None }
            collections.sortBy(mut &keep, fn(a: &Val, b: &Val): int { return lexdb_sort.sortCmp(a, b) })
            var uniq: []Val = []
            for v in move(keep) {
                if len(uniq) > 0 {
                    match lexdb_ops.compare(&uniq[len(uniq) - 1], &v) {
                        Ok(c) { if c == 0 { continue } }
                        Err(_) { return None }
                    }
                }
                append(mut &uniq, v)
            }
            match bGenOf(&args[0], kinds, base, need, ce) {
                Some(g) { return Some(BNode.InGen(g, uniq, orig, hasNull, kc)) }
                None { return None }
            }
        }
        else { return None }
    }
}

// ---- programs: the plans the pipeline runs (design/lexdb-layers.md 6.2.3)
//
// compile is the support check: it takes a plan whose arms hold their
// details (lexdb_plan.PPlan: Scan, Filter, Project, Limit) and keeps it
// when the pipeline runs every operator and expression in it. run runs
// it. Slice P1a: one table scanned, its rows filtered by its conditions,
// the outputs made, at most a limit of them given:
//
//   Limit? (Sort? (Project (Filter? (Scan))))
//
// where the Sort is the scan's order (an ORDER BY its path gives); and,
// slice P1b, an aggregate over the same scan and filter (runAgg, below):
//
//   [views] (Agg (Filter? (Scan)))
//
// the views (HAVING, the select list, DISTINCT, ORDER BY, LIMIT) the
// caller's, over the groups.
// A scan whose ranges are read in batches gives chunks (a batch and the
// rows its conditions chose); the outputs are made over the chunk and go
// to the caller as an OutBatch. A scan of key lookups, or one the plan
// reads row by row, gives chunks of one row, evaluated by the scalar
// evaluator (bxEval). A chunk the kernels cannot evaluate (a value its
// batch cannot hold, an expression's error on one of its rows) is read
// again row by row from its start, with the rest of its scan, so an
// error is the one the first failing row gives, its conditions in order
// before its outputs, as the row engine gives it.

// Runs of a program, and of those the ones whose scan read batches (the
// tests' look).
var runs: int = 0
var batchRuns: int = 0

var sortRuns: int = 0

pub fn runCounts(): []int { return [runs, batchRuns, sortRuns] }

// A plan the pipeline runs.
pub type Prog = record {
    pub plan: lexdb_plan.PPlan      // its operators, their details in their arms
    pub ops: int                    // its operators (run's counts: one each, bottom up)
    // its top is an aggregate (under the caller's views): its groups go to
    // the caller (runAgg), which makes HAVING, the outputs, DISTINCT,
    // ORDER BY and LIMIT of them; else its rows (run)
    pub groups: bool
    pub joins: bool                 // it joins tables (runJ, runAggJ: its tables and their reads per level)
    // its top is a Sort or Distinct (slice P3): the rows are held, then
    // given as one OutBatch (the run holds their bytes in its budget)
    pub sorts: bool
}

// p's program; Err(p): an operator or an expression the pipeline does
// not run (the caller keeps its details: the plan is given back).
pub fn compile(p0: lexdb_plan.PPlan, cols: &[]lexdb_sql.ColDef): Result[Prog, lexdb_plan.PPlan] {
    var p = p0
    let n = opsOf(&p, cols)
    if n < 0 { return Err(p) }
    let g = match underViews(&p) {
        lexdb_plan.PPlan.Agg(_, _, _) { true }
        else { false }
    }
    let j = hasJoin(&p)
    if j { p = lexdb_plan.needs(p, len(cols)) }
    let so = !g && sortArm(&p)
    return Ok(Prog{plan: p, ops: n, groups: g, joins: j, sorts: so})
}

// p under the operators its caller runs over an aggregate's groups (the
// views: HAVING, the select list's, DISTINCT, ORDER BY, a LIMIT that does
// not stop the scan, MATCH_RECOGNIZE over the result); p if none.
fn underViews(p: &lexdb_plan.PPlan): &lexdb_plan.PPlan {
    match p {
        lexdb_plan.PPlan.Limit(i, stops, _, _) { if !stops { return underViews(&i) } }
        lexdb_plan.PPlan.Sort(i, _, _) { return underViews(&i) }
        lexdb_plan.PPlan.Distinct(i, _, _) { return underViews(&i) }
        lexdb_plan.PPlan.Project(i, xs) { if len(xs) == 0 { return underViews(&i) } }
        lexdb_plan.PPlan.Having(i) { return underViews(&i) }
        lexdb_plan.PPlan.Match(i) { return underViews(&i) }
        else {}
    }
    return p
}

// The operators of p if the pipeline runs it, else -1.
fn opsOf(p: &lexdb_plan.PPlan, cols: &[]lexdb_sql.ColDef): int {
    match underViews(p) {
        lexdb_plan.PPlan.Agg(i, sets, pa) {
            // the plain or hash aggregate over one table's rows (its views
            // the caller's)
            if sets { return -1 }
            match pa {
                Some(a) { return aggOps(&i, &a, cols) }
                None { return -1 }
            }
        }
        else {}
    }
    match p {
        lexdb_plan.PPlan.Limit(i, stops, n, off) {
            // over a Sort or Distinct (slice P3): its count and offset theirs
            if sortArm(&i) {
                let k = opsOf(&i, cols)
                return if k < 0 { -1 } else { k + 1 }
            }
            // a count, no offset (an OFFSET is not streamed: the row engine's)
            if !stops || n < 0 || off > 0 { return -1 }
            let k = opsOf(&i, cols)
            return if k < 0 { -1 } else { k + 1 }
        }
        lexdb_plan.PPlan.Sort(i, sorted, ps) {
            // sorted (slice P3): by its keys, the Project's columns; else the
            // scan's order, nothing to do
            if sorted {
                match ps {
                    Some(k) {
                        let w = projLen(projUnder(&i))
                        for c in k.out { if c < 0 || c >= w { return -1 } }
                        if k.shown < 1 || k.shown > w { return -1 }
                    }
                    None { return -1 }
                }
            }
            let k = opsOf(&i, cols)
            return if k < 0 { -1 } else { k + 1 }
        }
        lexdb_plan.PPlan.Distinct(i, on, ks) {
            // over the Project (slice P3); not DISTINCT ON
            if on || len(ks) == 0 { return -1 }
            match i {
                lexdb_plan.PPlan.Project(_, _) {}
                else { return -1 }
            }
            let k = opsOf(&i, cols)
            return if k < 0 { -1 } else { k + 1 }
        }
        lexdb_plan.PPlan.Project(i, xs) {
            if len(xs) == 0 { return -1 }
            match i {
                lexdb_plan.PPlan.Join(_, _) {
                    // the joins (slice P2): the rows of every level, then the outputs
                    var avail: []bool = array(len(cols), false)
                    let k = joinOps(&i, cols, mut &avail)
                    if k < 0 || !allIn(&xs, &avail) { return -1 }
                    return k + 1
                }
                lexdb_plan.PPlan.Filter(j, cs) {
                    match j {
                        lexdb_plan.PPlan.Scan(sc, subs) {
                            if !scanRuns(&sc, &subs, cols) || !allRead(&cs, &sc) || !allRead(&xs, &sc) { return -1 }
                            return 3
                        }
                        else { return -1 }
                    }
                }
                lexdb_plan.PPlan.Scan(sc, subs) {
                    if !scanRuns(&sc, &subs, cols) || !allRead(&xs, &sc) { return -1 }
                    return 2
                }
                else { return -1 }
            }
        }
        else { return -1 }
    }
}

// The operators of an aggregate a over i if the pipeline runs it (its
// calls ones it accumulates, every key, argument and FILTER reading the
// table's decoded columns; the table the query's only columns), else -1.
fn aggOps(i: &lexdb_plan.PPlan, a: &lexdb_plan.PAgg, cols: &[]lexdb_sql.ColDef): int {
    for c in a.calls {
        let f = &c.fname
        if !(f == "count" || f == "sum" || f == "avg" || f == "min" || f == "max") || (c.star != c.arg.isNone()) || (c.star && f != "count") { return -1 }
    }
    match i {
        lexdb_plan.PPlan.Join(_, _) {
            // over joins (slice P2): every level's rows, then the groups
            var avail: []bool = array(len(cols), false)
            let k = joinOps(i, cols, mut &avail)
            if k < 0 || !allIn(&a.keys, &avail) { return -1 }
            for c in a.calls {
                match c.arg {
                    Some(x) { if !allIn1(&x, &avail) { return -1 } }
                    None {}
                }
                match c.filter {
                    Some(x) { if !allIn1(&x, &avail) { return -1 } }
                    None {}
                }
            }
            return k + 1
        }
        lexdb_plan.PPlan.Filter(j, cs) {
            match j {
                lexdb_plan.PPlan.Scan(sc, subs) {
                    if !scanRuns(&sc, &subs, cols) || !allRead(&cs, &sc) || !aggRead(a, &sc) || sc.first != 0 || len(sc.need) != len(cols) { return -1 }
                    return 3
                }
                else { return -1 }
            }
        }
        lexdb_plan.PPlan.Scan(sc, subs) {
            if !scanRuns(&sc, &subs, cols) || !aggRead(a, &sc) || sc.first != 0 || len(sc.need) != len(cols) { return -1 }
            return 2
        }
        else { return -1 }
    }
}

fn aggRead(a: &lexdb_plan.PAgg, sc: &lexdb_plan.PScan): bool {
    if !allRead(&a.keys, sc) { return false }
    for c in a.calls {
        match c.arg {
            Some(x) { if !reads(&x, sc) { return false } }
            None {}
        }
        match c.filter {
            Some(x) { if !reads(&x, sc) { return false } }
            None {}
        }
    }
    return true
}

// Whether a scan's arm is one run runs: a table's (its query's columns'
// kinds and the table's need agree), its subqueries each run once before
// it, their values in the run's context (Ctx.subs; not in FROM).
fn scanRuns(sc: &lexdb_plan.PScan, subs: &[]lexdb_plan.PSub, cols: &[]lexdb_sql.ColDef): bool {
    for s in subs { if s.run != lexdb_plan.RUN_ONCE || s.use == lexdb_sql.SUB_FROM { return false } }
    return len(sc.kinds) == len(cols) && sc.first >= 0 && sc.first + len(sc.need) <= len(cols)
}

// Whether every expression of xs reads only the scan's columns it decodes.
fn allRead(xs: &[]BX, sc: &lexdb_plan.PScan): bool {
    for x in xs { if !reads(&x, sc) { return false } }
    return true
}

fn reads(x: &BX, sc: &lexdb_plan.PScan): bool {
    match x {
        BX.Const(_) { return true }
        BX.Param(_) { return true }
        BX.Col(i) {
            let c = i - sc.first
            return i < len(sc.kinds) && sc.kinds[i] != BK_NONE && c >= 0 && c < len(sc.need) && sc.need[c]
        }
        BX.Agg(_) { return false }
        BX.Un(_, a) { return reads(&a, sc) }
        BX.And(a, b) { return reads(&a, sc) && reads(&b, sc) }
        BX.Or(a, b) { return reads(&a, sc) && reads(&b, sc) }
        BX.Op(_, a, b) { return reads(&a, sc) && reads(&b, sc) }
        BX.Cat(a, b, _) { return reads(&a, sc) && reads(&b, sc) }
        BX.IsNull(a, _) { return reads(&a, sc) }
        BX.Cast(a, _) { return reads(&a, sc) }
        BX.Case(cs, _) {
            for c in cs { if !reads(&c, sc) { return false } }
            return true
        }
        BX.Try(a) { return reads(&a, sc) }
        BX.Call(_, cs) {
            for c in cs { if !reads(&c, sc) { return false } }
            return true
        }
        BX.Sub(_, _, xs) {
            for c in xs { if !reads(&c, sc) { return false } }
            return true
        }
    }
}

// Where a run's scan reads, as its caller found it for the run's
// parameters: the scans (lexdb_access's: the pipeline passes their keys
// on, never reads them) and how its index is read.
pub type Src = record {
    pub batch: bool                 // in batches: the plan's scan reads batches, and a scan is a range
    pub scans: []lexdb_access.Scan
    pub rd: lexdb_access.IxRead     // in batches: how an index is read (9.107)
    pub index: int                  // the path's index (-1 the primary key) and direction (row by row)
    pub desc: bool
    pub keys: []str                 // row by row: a range's primary keys, already read (optimizer 19); [] none
}

// Where a run of pg reads its table t, from what its caller found for the
// run's parameters: the path's scans, its index (-1 the primary key) and
// direction, whether the index holds every column used (covers: read
// alone), optimizer 19's switch (how: 1 the whole table, 0 the range's
// primary keys, read, in keys; -1 none). In batches when the plan's scan
// reads batches and a scan is a range (an aggregate's points too), the
// index read as the batch engine read it (9.107); else row by row.
pub fn srcOf(pg: &Prog, t: &lexdb_catalog.Table, scans: []lexdb_access.Scan, index: int, desc: bool, covers: bool, how: int,
             keys: []str): Result[Src, DbErr] {
    match lexdb_plan.pLeaf(&pg.plan) {
        lexdb_plan.PPlan.Scan(ps, _) { return srcFor(&ps, pg.groups, t, scans, index, desc, covers, how, keys) }
        else { return Err(e("XX000", "a pipeline plan without its scan")) }
    }
}

// srcOf for a joined table's arm (level k's: a hash's, read once; its
// points read as a batch).
pub fn srcAt(pg: &Prog, k: int, t: &lexdb_catalog.Table, scans: []lexdb_access.Scan, index: int, desc: bool, covers: bool): Result[Src, DbErr] {
    return joinSrc(&pg.plan, k, t, scans, index, desc, covers)
}

fn joinSrc(p: &lexdb_plan.PPlan, k: int, t: &lexdb_catalog.Table, scans: []lexdb_access.Scan, index: int, desc: bool, covers: bool): Result[Src, DbErr] {
    match p {
        lexdb_plan.PPlan.Join(i, j) {
            if j.scan.level == k { return srcFor(&j.scan, true, t, scans, index, desc, covers, -1, []) }
            return joinSrc(&i, k, t, scans, index, desc, covers)
        }
        lexdb_plan.PPlan.Filter(i, _) { return joinSrc(&i, k, t, scans, index, desc, covers) }
        lexdb_plan.PPlan.Agg(i, _, _) { return joinSrc(&i, k, t, scans, index, desc, covers) }
        lexdb_plan.PPlan.Project(i, _) { return joinSrc(&i, k, t, scans, index, desc, covers) }
        lexdb_plan.PPlan.Limit(i, _, _, _) { return joinSrc(&i, k, t, scans, index, desc, covers) }
        lexdb_plan.PPlan.Sort(i, _, _) { return joinSrc(&i, k, t, scans, index, desc, covers) }
        lexdb_plan.PPlan.Having(i) { return joinSrc(&i, k, t, scans, index, desc, covers) }
        lexdb_plan.PPlan.Distinct(i, _, _) { return joinSrc(&i, k, t, scans, index, desc, covers) }
        lexdb_plan.PPlan.Match(i) { return joinSrc(&i, k, t, scans, index, desc, covers) }
        else { return Ok(noSrc()) }
    }
}

// A Src that reads nothing (a table looked up per row).
pub fn noSrc(): Src { return Src{batch: false, scans: [], rd: lexdb_access.noIxRead(), index: -1, desc: false, keys: []} }

fn srcFor(ps: &lexdb_plan.PScan, groups: bool, t: &lexdb_catalog.Table, scans: []lexdb_access.Scan, index: int, desc: bool, covers: bool, how: int,
          keys: []str): Result[Src, DbErr] {
    var src = Src{batch: false, scans: [], rd: lexdb_access.noIxRead(), index: index, desc: desc, keys: []}
    var ranges = false
    for s in scans { if !s.point && !s.empty { ranges = true } }
    src.scans = if how == 1 { [lexdb_access.wholeScan()] } else { scans }
    if !ps.batch || !(ranges || groups) {
        if how == 0 { src.keys = keys }
        return Ok(src)
    }
    src.batch = true
    if index < 0 { return Ok(src) }
    src.rd.ix = index
    src.rd.desc = desc
    if covers {
        match lexdb_access.idxDecOf(&lexdb_catalog.relOf(t), index, &ps.need) {
            Some(d) {
                src.rd.only = true
                src.rd.dec = d
            }
            None { return Err(e("XX000", "an index read alone without its decoding")) }
        }
    } else if how == 0 && len(keys) <= lexdb_rows.BROWS && !desc {
        // its range's keys, counted (at most a batch): read once
        src.rd.byKeys = true
        src.rd.keys = keys
    }
    return Ok(src)
}

// Runs pg over table t (the plan's Scan's), read as src says, in the
// context cx, at most cap rows (-1 no cap) and the plan's limit; the
// rows' bytes and the clock in bud. The rows go to give: a chunk as an
// OutBatch (its n > 0), or a row read one by one (the OutBatch empty; the
// row's array used again for the next); it gives false to stop. cnt: per
// operator, bottom up,
// its counts (the scan's as EXPLAIN ANALYZE prints a table's). The rows
// given.
pub fn run(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, pg: &Prog, cols: &[]lexdb_sql.ColDef, t: &lexdb_catalog.Table,
           src: &Src, cx: &Ctx, cap: int, bud: mut &Budget, cnt: mut &[]Counts,
           give: &fn(mut &lexdb_store.Txn, &lexdb_rows.OutBatch, &[]Val): Result[bool, DbErr]): Result[int, DbErr] {
    runs += 1
    if src.batch { batchRuns += 1 }
    while len(cnt) < pg.ops { append(cnt, noCounts()) }
    if pg.sorts {
        // its rows held by the Sort or Distinct, then given (slice P3)
        var sr = SortRun{st: [sortRun(&pg.plan, cap, bud)]}
        let got = try runOp(st, txn, projUnder(&pg.plan), cols, t, src, cx, -1, bud, cnt, mut &sr, give)
        sortRuns += 1
        return sr.st[0].finish(txn, bud, give)
    }
    var none = noSortRun()
    return runOp(st, txn, &pg.plan, cols, t, src, cx, cap, bud, cnt, mut &none, give)
}

// Runs p (Limit, the scan's Sort, Project): at most lim rows (-1 no limit).
fn runOp(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, p: &lexdb_plan.PPlan, cols: &[]lexdb_sql.ColDef, t: &lexdb_catalog.Table,
         src: &Src, cx: &Ctx, lim: int, bud: mut &Budget, cnt: mut &[]Counts, srt: mut &SortRun,
         give: &fn(mut &lexdb_store.Txn, &lexdb_rows.OutBatch, &[]Val): Result[bool, DbErr]): Result[int, DbErr] {
    let none: []BX = []
    match p {
        lexdb_plan.PPlan.Limit(i, _, n, _) { return runOp(st, txn, &i, cols, t, src, cx, if lim >= 0 && lim < n { lim } else { n }, bud, cnt, srt, give) }
        lexdb_plan.PPlan.Sort(i, _, _) { return runOp(st, txn, &i, cols, t, src, cx, lim, bud, cnt, srt, give) }
        lexdb_plan.PPlan.Project(j, xs) {
            match j {
                lexdb_plan.PPlan.Filter(k, cs) {
                    match k {
                        lexdb_plan.PPlan.Scan(sc, _) { return runScan(st, txn, &sc, &cs, &xs, cols, t, src, cx, lim, bud, cnt, srt, give) }
                        else {}
                    }
                }
                lexdb_plan.PPlan.Scan(sc, _) { return runScan(st, txn, &sc, &none, &xs, cols, t, src, cx, lim, bud, cnt, srt, give) }
                else {}
            }
        }
        else {}
    }
    return Err(e("XX000", "the pipeline was given a plan it does not run"))
}

// The scan, its filter (conds) and the outputs xs, at most lim rows (-1
// no limit). cnt[0]: the scan's counts (its filter's rows as joined);
// the last: the rows given.
fn runScan(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: &lexdb_plan.PScan, conds: &[]BX, xs: &[]BX,
           cols: &[]lexdb_sql.ColDef, t: &lexdb_catalog.Table, src: &Src, cx: &Ctx, lim: int, bud: mut &Budget, cnt: mut &[]Counts,
           srt: mut &SortRun, give: &fn(mut &lexdb_store.Txn, &lexdb_rows.OutBatch, &[]Val): Result[bool, DbErr]): Result[int, DbErr] {
    let rel = lexdb_catalog.relOf(t)
    let last = len(cnt) - 1
    cnt[0].starts += 1
    if lim == 0 { return Ok(0) }
    // the table's columns read (fetch's, getRow's): [] all
    var need: []bool = []
    if sc.part { for x in sc.need { append(mut &need, x) } }
    var sr = Scalar{row: array(len(cols), Val.Null), vals: [], none: lexdb_rows.noOutBatch(), n: 0, stop: false}
    // (an aggregate's scan of points only, given way: row by row)
    var ranges = false
    for s in src.scans { if !s.point && !s.empty { ranges = true } }
    if !src.batch || !ranges {
        if len(src.keys) > 0 {
            // the range's primary keys, already read: its rows, one by one
            let rr = lexdb_access.rowRead(&rel, &need)
            for i in 0..len(src.keys) {
                match try lexdb_access.getRow(st, txn, &rel, &rr, &src.keys[i]) {
                    Some(r0) {
                        var r = r0
                        try oneRow(txn, mut &r, sc, conds, xs, cx, lim, bud, cnt, srt, give, mut &sr)
                        if sr.stop { return Ok(sr.n) }
                    }
                    None { return Err(lexdb_base.corrupt(&("an index entry of \"" + t.name + "\" without its row"))) }
                }
            }
            return Ok(sr.n)
        }
        try lexdb_access.warmPoints(st, txn, &rel, &src.scans)
        for s in src.scans {
            var cur = lexdb_access.newCursor()
            try rowsFrom(st, txn, &rel, src, &s, &need, mut &cur, sc, conds, xs, cx, lim, bud, cnt, srt, give, mut &sr)
            if sr.stop { return Ok(sr.n) }
        }
        return Ok(sr.n)
    }
    // in batches: the table's columns' kinds, the conditions and outputs
    // compiled over them (constants in cx: the run's parameters)
    let base = sc.first
    var kinds: []int = []
    for c in t.cols { append(mut &kinds, lexdb_rows.pipeKind(&c, false)) }
    var cn: []BNode = []
    for c in conds {
        match condNode(&c, cols, &sc.kinds, cx, base, &sc.need) {
            Some(n) { append(mut &cn, n) }
            None { return Err(e("XX000", "a filter the pipeline does not compile")) }
        }
    }
    var nodes: []BNode = []
    var okinds: []int = []
    var osrc: []int = []
    for x in xs {
        match outNode(&x, cols, &sc.kinds, cx, base, &sc.need) {
            Some(on) {
                append(mut &okinds, on.kind)
                append(mut &osrc, on.src)
                append(mut &nodes, takeON(on))
            }
            None { return Err(e("XX000", "an output the pipeline does not compile")) }
        }
    }
    let needP = lexdb_access.placesNeeded(&rel, &need)
    var bp = lexdb_rows.projectionOf(kinds, collections.copyOf(&sc.need), &t.slots, lexdb_catalog.rowWidth(t), lexdb_access.placesMissing(&rel), needP)
    bp.ranges = cRanges(&cn, &bp.kinds, t)
    // a top-N's first key an integer column of the table: that column
    // decoded first, with the conditions', and a row it puts after the
    // heap's last dropped before the rest are decoded (9.108)
    var barCol = -1
    if len(srt.st) > 0 && srt.st[0].topK > 0 && len(srt.st[0].keyCol) > 0 {
        let kc = srt.st[0].keyCol[0]
        if isIntKind(okinds[kc]) && osrc[kc] >= 0 { barCol = osrc[kc] }
    }
    let lazy = lazyOf(&bp, t, &cn, barCol)
    let no = len(nodes)
    try lexdb_access.warmPoints(st, txn, &rel, &src.scans)
    for s in src.scans {
        var cur = lexdb_access.newCursor()
        var rowPath = false
        var spare = lexdb_rows.noRows()            // the last batch, used again (bReuse)
        while !cur.done {
            let saved = cur.copy()
            let bar = if barCol >= 0 { srt.st[0].bar(barCol) } else { lexdb_access.noBar() }
            let got = try lexdb_access.fillPickIn(st, txn, &rel, &s, sc.part, mut &cur, &bp, &src.rd, &lazy,
                                                  fn(skip: &[]bool, b: &Batch, idx: []int): Option[[]int] { return bNarrow(&cn, skip, b, idx) },
                                                  &bar, mut &spare)
            if got.isNone() {
                // a value a batch cannot hold, or a condition's error on one
                // of its rows: row by row from its start
                cur = saved
                rowPath = true
                break
            }
            var pk = got.unwrap()
            var b = replace(mut &pk.b, lexdb_rows.noRows())
            let idx = replace(mut &pk.idx, [])
            let nr = b.n
            // the rows the bar dropped: counted as kept, as the row path counts them
            cnt[0].joined += pk.kept - len(idx)
            if nr == 0 {
                spare = b
                continue
            }
            // the outputs' values, before any row of the chunk is given
            var ex: []BVec = []
            var srcs: []int = []
            var failed = false
            for o in 0..no {
                match bOutVal(&nodes[o], osrc[o], mut &b, &idx, mut &ex, mut &srcs) {
                    Ok(_) {}
                    Err(_) {
                        failed = true
                        break
                    }
                }
            }
            if failed {
                cur = saved
                rowPath = true
                break
            }
            cnt[0].batches += 1
            var take = len(idx)
            if lim >= 0 && sr.n + take > lim { take = lim - sr.n }
            // counted as row by row: the rows dropped as read, each kept row as it goes on
            cnt[0].read += nr - len(idx) + take
            cnt[0].joined += take
            try bud.tickN(nr - len(idx) + take)
            if take > 0 {
                var ob = lexdb_rows.OutBatch{n: take, kinds: collections.copyOf(&okinds), src: srcs, idx: idx,
                                            cols: replace(mut &b.cols, []), vals: replace(mut &b.vals, []), txt: replace(mut &b.txt, []), ex: ex}
                sr.n += take
                cnt[last].joined += take
                let noRow: []Val = []
                if !(try emitTo(txn, srt, give, &ob, &noRow)) { return Ok(sr.n) }
                // the table's columns back, the outputs' added ones dropped
                b.cols = replace(mut &ob.cols, [])
                b.vals = replace(mut &ob.vals, [])
                b.txt = replace(mut &ob.txt, [])
                while len(b.cols) > len(bp.kinds) { let gone = pop(mut &b.cols) }
                while len(b.vals) > len(bp.kinds) { let gone2 = pop(mut &b.vals) }
                while len(b.txt) > len(bp.kinds) { let gone3 = pop(mut &b.txt) }
            }
            spare = b
            if lim >= 0 && sr.n >= lim { return Ok(sr.n) }
        }
        if rowPath {
            try rowsFrom(st, txn, &rel, src, &s, &need, mut &cur, sc, conds, xs, cx, lim, bud, cnt, srt, give, mut &sr)
            if sr.stop { return Ok(sr.n) }
        }
    }
    return Ok(sr.n)
}

// A scan's rows read one by one: the row it is building (the query's
// columns), the outputs' array given, the rows given, whether to stop.
type Scalar = record {
    row: []Val
    vals: []Val
    none: lexdb_rows.OutBatch
    n: int
    stop: bool
}

// The rest of scan s from cur, row by row.
fn rowsFrom(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, rel: &lexdb_access.Rel, src: &Src, s: &lexdb_access.Scan, need: &[]bool,
            cur: mut &lexdb_access.Cursor, sc: &lexdb_plan.PScan, conds: &[]BX, xs: &[]BX, cx: &Ctx, lim: int, bud: mut &Budget,
            cnt: mut &[]Counts, srt: mut &SortRun, give: &fn(mut &lexdb_store.Txn, &lexdb_rows.OutBatch, &[]Val): Result[bool, DbErr], sr: mut &Scalar): Result[Unit, DbErr] {
    while !cur.done {
        var rows: [][]Val = []
        try lexdb_access.fetch(st, txn, rel, src.index, src.desc, s, need, cur, mut &rows)
        for k in 0..len(rows) {
            try oneRow(txn, mut &rows[k], sc, conds, xs, cx, lim, bud, cnt, srt, give, sr)
            if sr.stop { return Ok(Unit{}) }
        }
    }
    return Ok(Unit{})
}

// A row of the table (r, its values moved out) through the filter and
// the outputs, by the scalar evaluator, as the row engine runs it: counted
// read, its conditions in order, counted joined, its outputs, given.
fn oneRow(txn: mut &lexdb_store.Txn, r: mut &[]Val, sc: &lexdb_plan.PScan, conds: &[]BX, xs: &[]BX, cx: &Ctx, lim: int, bud: mut &Budget,
          cnt: mut &[]Counts, srt: mut &SortRun, give: &fn(mut &lexdb_store.Txn, &lexdb_rows.OutBatch, &[]Val): Result[bool, DbErr], sr: mut &Scalar): Result[Unit, DbErr] {
    try bud.tick()
    for i in 0..len(r) { sr.row[sc.first + i] = replace(mut &r[i], Val.Null) }
    cnt[0].read += 1
    let noAggs: []Val = []
    for c in conds { if lexdb_ops.truth(&(try bxEval(&c, &sr.row, &noAggs, cx))) != Some(true) { return Ok(Unit{}) } }
    cnt[0].joined += 1
    while len(sr.vals) > 0 { let x = pop(mut &sr.vals) }
    for x in xs {
        match x {
            BX.Col(i) { append(mut &sr.vals, sr.row[i].clone()) }
            else { append(mut &sr.vals, try bxEval(&x, &sr.row, &noAggs, cx)) }
        }
    }
    cnt[len(cnt) - 1].joined += 1
    if !(try emitTo(txn, srt, give, &sr.none, &sr.vals)) {
        sr.stop = true
        return Ok(Unit{})
    }
    sr.n += 1
    if lim >= 0 && sr.n >= lim { sr.stop = true }
    return Ok(Unit{})
}

// ---- the aggregate (slice P1b): one table's rows grouped, its calls accumulated
//
// Agg (Filter? (Scan)): the plain aggregate (no keys: one group) and the
// hash aggregate. Its groups go to the caller (runAgg's give), which makes
// HAVING, the outputs, DISTINCT, ORDER BY and LIMIT of them. Over batches
// first, numerics as units (BK_DEC, sums in 128 bits); where that gives
// way (a numeric past its units, an expression the units do not compile)
// again with numerics as values; where batches give way (a value a batch
// cannot hold, an expression the kernels do not compile, a text key not
// a text), row by row with the scalar evaluator, as the row engine
// groups. Each from the start: the groups are given at the end, none yet.
// An expression's error in a batch is raised from the batch (its lowest
// row of the first failing step, design/lexdb-layers.md 4.4.1).

// Grouped runs over batches, those that read numerics as units, and the
// unit runs that gave way to values (the tests' look).
var groupRuns: int = 0
var decRuns: int = 0
var decSpills: int = 0

pub fn aggCounts(): []int { return [decRuns, decSpills, groupRuns] }

// A call's state in a group, as the row engine's accumulator holds it:
// the values counted, their sum (sum, avg), their minimum or maximum.
pub type PAcc = record {
    pub n: int
    pub sum: Val
    pub val: Val
}

fn noAcc(): PAcc { return PAcc{n: 0, sum: Val.Null, val: Val.Null} }

// Runs an aggregate program (pg.groups) over table t, read as src says,
// in the context cx. Each group goes to give after the last row is read:
// its first row (the query's columns; those not read after grouping
// NULL, in batches) and its calls' states. room: the bytes the groups may
// hold (-1 no limit), counted as the row engine and the batch driver
// counted them; past it max_statement_mem's error. The bytes counted.
pub fn runAgg(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, pg: &Prog, cols: &[]lexdb_sql.ColDef, t: &lexdb_catalog.Table,
              src: &Src, cx: &Ctx, room: int, bud: mut &Budget, cnt: mut &[]Counts,
              give: &fn(&[]Val, &[]PAcc): Result[Unit, DbErr]): Result[int, DbErr] {
    runs += 1
    while len(cnt) < pg.ops { append(cnt, noCounts()) }
    let none: []BX = []
    match underViews(&pg.plan) {
        lexdb_plan.PPlan.Agg(i, _, pa) {
            match pa {
                Some(a) {
                    match i {
                        lexdb_plan.PPlan.Filter(j, cs) {
                            match j {
                                lexdb_plan.PPlan.Scan(sc, _) { return aggRun(st, txn, &sc, &cs, &a, cols, t, src, cx, room, bud, cnt, give) }
                                else {}
                            }
                        }
                        lexdb_plan.PPlan.Scan(sc, _) { return aggRun(st, txn, &sc, &none, &a, cols, t, src, cx, room, bud, cnt, give) }
                        else {}
                    }
                }
                None {}
            }
        }
        else {}
    }
    return Err(e("XX000", "the pipeline was given a plan it does not run"))
}

// The aggregate a over scan sc filtered by conds: units, values, rows.
fn aggRun(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: &lexdb_plan.PScan, conds: &[]BX, a: &lexdb_plan.PAgg,
          cols: &[]lexdb_sql.ColDef, t: &lexdb_catalog.Table, src: &Src, cx: &Ctx, room: int, bud: mut &Budget, cnt: mut &[]Counts,
          give: &fn(&[]Val, &[]PAcc): Result[Unit, DbErr]): Result[int, DbErr] {
    // the counts so far: each try counts from the start again
    let c0 = cnt[0]
    if src.batch {
        batchRuns += 1
        var usedDec = false
        var values = false
        match aggBatches(st, txn, sc, conds, a, cols, t, src, cx, room, bud, cnt, give, true, mut &usedDec) {
            Ok(x) {
                match x {
                    Some(n) { return Ok(n) }
                    None {}
                }
                cnt[0] = c0
                // (no numeric read as units: the values' try is the same)
                values = usedDec
            }
            Err(x) {
                if !isSpill(&x) { return Err(x) }
                cnt[0] = c0
                decSpills += 1
                values = true
            }
        }
        if values {
            var none = false
            match try aggBatches(st, txn, sc, conds, a, cols, t, src, cx, room, bud, cnt, give, false, mut &none) {
                Some(n) { return Ok(n) }
                None { cnt[0] = c0 }
            }
        }
    }
    return aggRows(st, txn, sc, conds, a, cols, t, src, cx, room, bud, cnt, give)
}

// The aggregate over the scan's batches; dec: numeric(p, s) columns as
// units (usedDec set when one is read so). None: the batches give way
// (nothing given).
fn aggBatches(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: &lexdb_plan.PScan, conds: &[]BX, a: &lexdb_plan.PAgg,
              cols: &[]lexdb_sql.ColDef, t: &lexdb_catalog.Table, src: &Src, cx: &Ctx, room: int, bud: mut &Budget, cnt: mut &[]Counts,
              give: &fn(&[]Val, &[]PAcc): Result[Unit, DbErr], dec: bool, usedDec: mut &bool): Result[Option[int], DbErr] {
    let rel = lexdb_catalog.relOf(t)
    // the table's columns' kinds (the query's: they are its only ones)
    var kinds: []int = []
    for c in t.cols { append(mut &kinds, lexdb_rows.pipeKind(&c, dec)) }
    let needCol = collections.copyOf(&sc.need)
    if dec { for i in 0..len(kinds) { if needCol[i] && lexdb_rows.isDecKind(kinds[i]) { usedDec = true } } }
    // the conditions, the group keys and the calls over batches
    var bconds: []BNode = []
    for c in conds {
        let got = bCompileD(&c, cols, &kinds, cx, 0, dec)
        if got.isNone() { return Ok(None) }
        let cc = got.unwrap()
        if !boolLike(cc.typ) { return Ok(None) }
        append(mut &bconds, takeN(cc))
    }
    var ag = match aggState(a, cols, &kinds, &needCol, cx, dec, room, bud.maxHeld) {
        Some(x) { x }
        None { return Ok(None) }
    }
    // where each column used is in a stored row
    let needP = lexdb_access.placesNeeded(&rel, &needCol)
    var bp = lexdb_rows.projectionOf(collections.copyOf(&kinds), collections.copyOf(&needCol), &t.slots, lexdb_catalog.rowWidth(t),
                                     lexdb_access.placesMissing(&rel), needP)
    bp.ranges = cRanges(&bconds, &bp.kinds, t)
    // The table read in primary key order, grouped by the key's first
    // column: each group's rows come together (PostgreSQL's GroupAggregate
    // over presorted input, nodeAgg.c), so a row is in the group before it
    // or starts one; no map of the groups. (q18's subquery: lineitem by
    // l_orderkey.)
    if ag.oneKey && src.index < 0 && !src.desc && len(src.scans) == 1 && len(t.pk) > 0 {
        match ag.keys[0].n {
            BNode.Col(c) { ag.sorted = c == t.pk[0] }
            else {}
        }
    }
    var nRead = 0
    var nJoined = 0
    var nBatches = 0
    for sj in 0..len(src.scans) {
        var cur = lexdb_access.newCursor()
        var spare = lexdb_rows.noRows()            // the last batch read, used again (lexdb_rows.reuse)
        while !cur.done {
            let got = try lexdb_access.fillLevel(st, txn, &rel, &src.rd, &src.scans[sj], sc.part, mut &cur, &bp, mut &spare)
            if got.isNone() { return Ok(None) }
            var b = got.unwrap()
            let nr = b.n
            if nr == 0 { continue }
            try bud.tickN(nr)
            nRead += nr
            nBatches += 1
            // WHERE: the rows chosen, narrowed condition by condition
            var idx: []int = withCapacity(nr)
            for r in 0..nr { append(mut &idx, r) }
            for c in bconds {
                if len(idx) == 0 { break }
                let pos = try bTrue(&c, &b, &idx)
                var next: []int = []
                for j in pos { append(mut &next, idx[j]) }
                idx = next
            }
            nJoined += len(idx)
            if len(idx) == 0 {
                spare = b
                continue
            }
            if !(try ag.eat(mut &b, &idx)) { return Ok(None) }
            // (the columns the calls' generic steps added dropped)
            while len(b.cols) > len(bp.kinds) { let gone = pop(mut &b.cols) }
            while len(b.vals) > len(bp.kinds) { let gone2 = pop(mut &b.vals) }
            while len(b.txt) > len(bp.kinds) { let gone3 = pop(mut &b.txt) }
            spare = b
        }
    }
    if dec && ag.anyDec(&bp.kinds, &bp.needCol) { decRuns += 1 }
    groupRuns += 1
    cnt[0].starts += 1
    cnt[0].read += nRead
    cnt[0].joined += nJoined
    cnt[0].batches += nBatches
    cnt[len(cnt) - 1].joined += ag.ngroups
    try ag.finish(len(cols), give)
    return Ok(Some(ag.added))
}

// An aggregate's state over batches: its keys and calls compiled, per
// call and group its count, sum and minimum or maximum (integers or
// units), its value (vcol), its sum as units in 128 bits (dsc); the groups
// by their key; each group's first row's kept columns.
type AggSt = record {
    keys: []BComp
    specs: []BSpec
    gens: []Option[BGen]    // per call: its argument by the generic step (its values a column added per batch: vcol)
    kinds: []int            // per column of the batches eaten
    fcols: []int            // a group's first row's columns kept
    fv: []Val
    ngroups: int
    an: [][]int
    asum: [][]int
    amm: [][]int
    aval: [][]Val
    adec: [][]i128
    byInt: Map[int, int]
    byKey: Map[str, int]
    byText: Map[str, int]
    nullGroup: int
    oneKey: bool
    sorted: bool            // grouped by the scan's order (one key, the primary key's first column)
    lastKey: int
    lastG: int
    textCol: int            // one key a text or varchar column: grouped by its text
    added: int
    room: int
    maxHeld: int
}

// a's state over batches of the columns kinds (need: those decoded);
// None: a key or call the batches do not evaluate.
fn aggState(a: &lexdb_plan.PAgg, cols: &[]lexdb_sql.ColDef, kinds: &[]int, need: &[]bool, cx: &Ctx, dec: bool, room: int,
            maxHeld: int): Option[AggSt] {
    var keys: []BComp = []
    for x in a.keys {
        let got = bCompileD(&x, cols, kinds, cx, 0, dec)
        if got.isNone() { return None }
        let cc = got.unwrap()
        if cc.typ == BT_OTHER {
            match cc.n {
                BNode.Col(_) {}
                else { return None }
            }
        }
        append(mut &keys, cc)
    }
    var specs: []BSpec = []
    var gens: []Option[BGen] = []
    for c in a.calls {
        let f = &c.fname
        let kind = if c.star { BA_STAR } else if f == "count" { BA_COUNT } else if f == "sum" { BA_SUM } else if f == "avg" { BA_AVG }
                   else if f == "min" { BA_MIN } else { BA_MAX }
        var arg: Option[BNode] = None
        var vcol = -1
        var dsc = -1
        var gen: Option[BGen] = None
        match c.arg {
            Some(bx) {
                let got = bCompileD(&bx, cols, kinds, cx, 0, dec)
                let other = match got {
                    Some(cc) { kind != BA_COUNT && !isDecT(cc.typ) && cc.typ != BT_INT && bValCol(&bx, kinds, 0) < 0 }
                    None { true }
                }
                if other && (kind == BA_SUM || kind == BA_MIN || kind == BA_MAX) {
                    // an argument the kernels do not evaluate (q14's CASE of a
                    // LIKE): its values by the generic step, added as the
                    // row engine's accumulate adds them
                    match bGenOf(&bx, kinds, 0, need, cx) {
                        Some(g) { gen = Some(g) }
                        None { return None }
                    }
                }
            }
            None {}
        }
        if gen.isSome() {
            var filt: Option[BNode] = None
            match c.filter {
                Some(fx) {
                    let got = bCompileD(&fx, cols, kinds, cx, 0, dec)
                    if got.isNone() { return None }
                    let cc = got.unwrap()
                    if !boolLike(cc.typ) { return None }
                    filt = Some(takeN(cc))
                }
                None {}
            }
            append(mut &specs, BSpec{kind: kind, arg: None, filter: filt, vcol: -2, dsc: -1})
            append(mut &gens, gen)
            continue
        }
        append(mut &gens, None)
        match c.arg {
            Some(bx) {
                let got = bCompileD(&bx, cols, kinds, cx, 0, dec)
                if got.isNone() { return None }
                let cc = got.unwrap()
                if kind != BA_COUNT && isDecT(cc.typ) {
                    // a numeric as units: its sum in 128 bits, its min or max as units
                    dsc = decSc(cc.typ)
                } else if kind != BA_COUNT && cc.typ != BT_INT {
                    // min or max of a column of values, sum or avg of a numeric one
                    let vc = bValCol(&bx, kinds, 0)
                    if vc < 0 { return None }
                    let numeric = cols[vc].typ.oid == lexdb_sql.OID_NUMERIC
                    if !(kind == BA_MIN || kind == BA_MAX || ((kind == BA_SUM || kind == BA_AVG) && numeric)) { return None }
                    vcol = vc
                }
                arg = Some(takeN(cc))
            }
            None {}
        }
        var filt: Option[BNode] = None
        match c.filter {
            Some(fx) {
                let got = bCompileD(&fx, cols, kinds, cx, 0, dec)
                if got.isNone() { return None }
                let cc = got.unwrap()
                if !boolLike(cc.typ) { return None }
                filt = Some(takeN(cc))
            }
            None {}
        }
        append(mut &specs, BSpec{kind: kind, arg: arg, filter: filt, vcol: vcol, dsc: dsc})
    }
    // A group's first row keeps only the columns read after grouping (its
    // outputs, HAVING, ORDER BY): the others, an aggregate's argument among
    // them, are not copied for each group (q18's 1.5M groups).
    var fcols: []int = []
    for i in 0..len(need) { if need[i] && i < len(a.keep) && a.keep[i] { append(mut &fcols, i) } }
    let ns = len(specs)
    var ag = AggSt{keys: keys, specs: specs, gens: gens, kinds: collections.copyOf(kinds), fcols: fcols, fv: [], ngroups: 0,
                   an: [], asum: [], amm: [], aval: [], adec: [], byInt: newMap(), byKey: newMap(), byText: newMap(), nullGroup: -1,
                   oneKey: false, sorted: false, lastKey: 0, lastG: -1, textCol: -1, added: 0, room: room, maxHeld: maxHeld}
    for i in 0..ns {
        append(mut &ag.an, [])
        append(mut &ag.asum, [])
        append(mut &ag.amm, [])
        append(mut &ag.aval, [])
        append(mut &ag.adec, [])
    }
    ag.oneKey = len(ag.keys) == 1 && ag.keys[0].typ != BT_OTHER
    if len(ag.keys) == 1 && ag.keys[0].typ == BT_OTHER {
        match ag.keys[0].n {
            BNode.Col(c) {
                let o = cols[c].typ.oid
                if o == lexdb_sql.OID_TEXT || o == lexdb_sql.OID_VARCHAR { ag.textCol = c }
            }
            else {}
        }
    }
    return Some(ag)
}

// Whether the aggregate read a numeric as units (its calls, or the columns kinds/need).
fn (ag: &AggSt) anyDec(kinds: &[]int, need: &[]bool): bool {
    for sp in ag.specs { if sp.dsc >= 0 { return true } }
    for i in 0..len(kinds) { if need[i] && lexdb_rows.isDecKind(kinds[i]) { return true } }
    return false
}

// A new group's states.
fn (ag: mut &AggSt) newGroup() {
    for i in 0..len(ag.specs) {
        append(mut &ag.an[i], 0)
        append(mut &ag.asum[i], 0)
        append(mut &ag.amm[i], 0)
        append(mut &ag.aval[i], Val.Null)
        append(mut &ag.adec[i], i128(0))
    }
}

// b's rows idx into their groups (new groups made in the rows' order),
// each call's state added to. false: the batches give way (a text key not
// a text).
fn (ag: mut &AggSt) eat(b: mut &Batch, idx: &[]int): Result[bool, DbErr] {
    let nc = len(idx)
    let ns = len(ag.specs)
    var gid: []int = array(nc, 0)
    if len(ag.keys) == 0 {
        if ag.ngroups == 0 {
            let cost = bFirstVals(b, idx[0], &ag.kinds, &ag.fcols, mut &ag.fv) + 64 * (ns + 1)
            ag.ngroups += 1
            ag.added += cost
            if ag.room >= 0 && ag.added > ag.room { return Err(memErr(ag.maxHeld)) }
            ag.newGroup()
        }
    } else {
        // (per batch: which keys are texts, the text key's column a text one)
        let ktxt = keyTexts(&ag.keys, b)
        let tcol = ag.textCol >= 0 && lexdb_rows.isTextCol(b, ag.textCol)
        var kvs: []BVec = []
        for k in ag.keys { append(mut &kvs, try bEval(&k.n, b, idx)) }
        // a composite key built in one reused string; copied only for a new group
        var kb = ""
        for j in 0..nc {
            var g = -1
            var klen = 9
            if ag.oneKey {
                if kvs[0].nul[j] {
                    g = ag.nullGroup
                } else if ag.sorted {
                    if ag.lastG >= 0 && kvs[0].v[j] == ag.lastKey { g = ag.lastG }
                } else {
                    match ag.byInt.get(&kvs[0].v[j]) {
                        Some(x) { g = x }
                        None {}
                    }
                }
            }
            if ag.textCol >= 0 {
                let r = idx[j]
                if b.cols[ag.textCol].nul[r] {
                    g = ag.nullGroup
                } else if tcol {
                    // looked up by the batch's bytes; copied only for a new group
                    let x = lexdb_rows.textAt(b, ag.textCol, r)
                    klen = len(x)
                    match ag.byText.get(x) {
                        Some(y) { g = y }
                        None {}
                    }
                } else {
                    // looked up by the batch's own text; copied only for a new group
                    match b.vals[ag.textCol][r] {
                        Val.Text(x) {
                            klen = len(x)
                            match ag.byText.get(x) {
                                Some(y) { g = y }
                                None {}
                            }
                        }
                        else { return Ok(false) }
                    }
                }
            } else if !ag.oneKey {
                kb.clear()
                for ki in 0..len(ag.keys) { bKeyEnc(mut &kb, &ag.keys[ki], &kvs[ki], j, b, idx[j], ktxt[ki]) }
                klen = len(kb)
                match ag.byKey.get(&kb) {
                    Some(x) { g = x }
                    None {}
                }
            }
            if g < 0 {
                g = ag.ngroups
                ag.ngroups += 1
                let cost = bFirstVals(b, idx[j], &ag.kinds, &ag.fcols, mut &ag.fv) + 64 * (ns + 1) + klen
                ag.added += cost
                if ag.room >= 0 && ag.added > ag.room { return Err(memErr(ag.maxHeld)) }
                ag.newGroup()
                if ag.textCol >= 0 {
                    if b.cols[ag.textCol].nul[idx[j]] {
                        ag.nullGroup = g
                    } else if tcol {
                        ag.byText.put(lexdb_rows.textAt(b, ag.textCol, idx[j]).clone(), g)
                    } else {
                        match b.vals[ag.textCol][idx[j]] {
                            Val.Text(x) { ag.byText.put(x.clone(), g) }
                            else {}
                        }
                    }
                } else if ag.oneKey {
                    if kvs[0].nul[j] {
                        ag.nullGroup = g
                    } else if ag.sorted {
                        ag.lastKey = kvs[0].v[j]
                        ag.lastG = g
                    } else {
                        ag.byInt.put(kvs[0].v[j], g)
                    }
                } else {
                    ag.byKey.put(kb.clone(), g)
                }
            }
            gid[j] = g
        }
    }
    // the calls: per call its rows (FILTER), its argument's values, one loop
    let one = len(ag.keys) == 0
    var specs = replace(mut &ag.specs, [])
    for si in 0..len(specs) {
        match ag.gens[si] {
            Some(g) {
                match bGenVals(&g, b, idx) {
                    Ok(vs) { specs[si].vcol = bAddVals(b, idx, vs) }
                    Err(x) {
                        ag.specs = specs
                        return Err(x)
                    }
                }
            }
            None {}
        }
    }
    let got = ag.accum(&specs, b, idx, &gid, one)
    ag.specs = specs
    try got
    return Ok(true)
}

// Each call's state added to for b's rows idx (gid: their groups).
fn (ag: mut &AggSt) accum(specs: &[]BSpec, b: &Batch, idx: &[]int, gid: &[]int, one: bool): Result[Unit, DbErr] {
    for si in 0..len(specs) {
        let sp = &specs[si]
        match sp.filter {
            Some(fx) {
                let pos = try bTrue(&fx, b, idx)
                var r2: []int = []
                var g2: []int = []
                for j in pos {
                    append(mut &r2, idx[j])
                    append(mut &g2, gid[j])
                }
                if sp.vcol >= 0 { try bAccVal(sp, b, &r2, &g2, mut &ag.an[si], mut &ag.aval[si]) }
                else if sp.dsc >= 0 && (sp.kind == BA_SUM || sp.kind == BA_AVG) { try bAccDec(sp, b, &r2, &g2, one, mut &ag.an[si], mut &ag.adec[si]) }
                else { try bAccum(sp, b, &r2, &g2, one, mut &ag.an[si], mut &ag.asum[si], mut &ag.amm[si]) }
            }
            None {
                if sp.vcol >= 0 { try bAccVal(sp, b, idx, gid, mut &ag.an[si], mut &ag.aval[si]) }
                else if sp.dsc >= 0 && (sp.kind == BA_SUM || sp.kind == BA_AVG) { try bAccDec(sp, b, idx, gid, one, mut &ag.an[si], mut &ag.adec[si]) }
                else { try bAccum(sp, b, idx, gid, one, mut &ag.an[si], mut &ag.asum[si], mut &ag.amm[si]) }
            }
        }
    }
    return Ok(Unit{})
}

// The groups to give, their states as the row engine's accumulators hold
// them (nq: the query's columns).
fn (ag: &AggSt) finish(nq: int, give: &fn(&[]Val, &[]PAcc): Result[Unit, DbErr]): Result[Unit, DbErr] {
    let nf = len(ag.fcols)
    let ns = len(ag.specs)
    var first: []Val = array(nq, Val.Null)
    var accs: []PAcc = []
    for si in 0..ns { append(mut &accs, noAcc()) }
    for g in 0..ag.ngroups {
        for fi in 0..nf { first[ag.fcols[fi]] = ag.fv[g * nf + fi].clone() }
        for si in 0..ns {
            let kd = ag.specs[si].kind
            let acc = mut &accs[si]
            acc.n = ag.an[si][g]
            acc.sum = Val.Null
            acc.val = Val.Null
            if ag.an[si][g] > 0 && ag.specs[si].vcol >= 0 {
                if kd == BA_SUM || kd == BA_AVG { acc.sum = ag.aval[si][g].clone() }
                if kd == BA_MIN || kd == BA_MAX { acc.val = ag.aval[si][g].clone() }
            } else if ag.an[si][g] > 0 && ag.specs[si].dsc >= 0 {
                // as the row engine's Decimal sum of the same values (display scale dsc)
                let ds = ag.specs[si].dsc
                if kd == BA_SUM || kd == BA_AVG {
                    match lexdb_vec.sumVal(ag.adec[si][g], ds) {
                        Some(v) { acc.sum = v }
                        None { return Err(lexdb_ops.decErr()) }
                    }
                }
                if kd == BA_MIN || kd == BA_MAX { acc.val = lexdb_rows.decVal(ag.amm[si][g], ds) }
            } else if ag.an[si][g] > 0 {
                if kd == BA_SUM || kd == BA_AVG { acc.sum = Val.Int(ag.asum[si][g]) }
                if kd == BA_MIN || kd == BA_MAX { acc.val = Val.Int(ag.amm[si][g]) }
            }
        }
        try give(&first, &accs)
    }
    return Ok(Unit{})
}

// A row-by-row aggregate's state: the query's row, the groups by their
// keys' encoding, each one's first row, and its calls' states (ns a
// group); the bytes counted.
type RowGroups = record {
    row: []Val
    index: Map[str, int]
    firsts: [][]Val
    accs: []PAcc
    added: int
    kb: str    // the key being looked up, reused row to row
}

// The aggregate over the scan's rows evaluated one by one, as the row
// engine groups them (addToGroup, accumulate): the scan and its filter
// read as runScan reads them (in batches where it can, its conditions
// over the batch, as the row engine's first level reads them:
// batchLevel), each row it keeps grouped and accumulated by the scalar
// evaluator.
fn aggRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sc: &lexdb_plan.PScan, conds: &[]BX, a: &lexdb_plan.PAgg,
           cols: &[]lexdb_sql.ColDef, t: &lexdb_catalog.Table, src: &Src, cx: &Ctx, room: int, bud: mut &Budget, cnt: mut &[]Counts,
           give: &fn(&[]Val, &[]PAcc): Result[Unit, DbErr]): Result[int, DbErr] {
    // the scan's outputs: its columns decoded, at their slots
    var xs: []BX = []
    var slots: []int = []
    for i in 0..len(sc.need) {
        if sc.need[i] {
            append(mut &xs, BX.Col(sc.first + i))
            append(mut &slots, sc.first + i)
        }
    }
    var rg = RowGroups{row: array(len(cols), Val.Null), index: newMap(), firsts: [], accs: [], added: 0, kb: ""}
    let maxHeld = bud.maxHeld
    var vals: []Val = []
    var noSort = noSortRun()
    let n = try runScan(st, txn, sc, conds, &xs, cols, t, src, cx, -1, bud, cnt, mut &noSort, fn(tx: mut &lexdb_store.Txn, ob: &lexdb_rows.OutBatch, r: &[]Val): Result[bool, DbErr] {
        if ob.n == 0 {
            for k in 0..len(slots) { rg.row[slots[k]] = r[k].clone() }
            try groupRow(mut &rg, a, cx, room, maxHeld)
            return Ok(true)
        }
        for j in 0..ob.n {
            obRow(ob, j, mut &vals)
            for k in 0..len(slots) { rg.row[slots[k]] = replace(mut &vals[k], Val.Null) }
            try groupRow(mut &rg, a, cx, room, maxHeld)
        }
        return Ok(true)
    })
    let ns = len(a.calls)
    let ng = len(rg.firsts)
    var accs: []PAcc = []
    for g in 0..ng {
        while len(accs) > 0 { let gone = pop(mut &accs) }
        for i in 0..ns { append(mut &accs, replace(mut &rg.accs[g * ns + i], noAcc())) }
        try give(&rg.firsts[g], &accs)
    }
    return Ok(rg.added)
}

// The row (rg.row) into its group, by its keys' values (a new group's
// bytes counted as the row engine counts them; past room
// max_statement_mem's error), then each call's state.
fn groupRow(rg: mut &RowGroups, a: &lexdb_plan.PAgg, cx: &Ctx, room: int, maxHeld: int): Result[Unit, DbErr] {
    let noAggs: []Val = []
    let ns = len(a.calls)
    var g = 0
    if len(a.keys) > 0 {
        rg.kb.clear()
        for k in a.keys { lexdb_access.encIdxPart(mut &rg.kb, &(try bxEval(&k, &rg.row, &noAggs, cx))) }
        match rg.index.get(&rg.kb) {
            Some(x) { g = x }
            None {
                g = len(rg.firsts)
                rg.added += rowBytes(&rg.row) + 64 * (ns + 1) + len(rg.kb)
                if room >= 0 && rg.added > room { return Err(memErr(maxHeld)) }
                rg.index.put(rg.kb.clone(), g)
                append(mut &rg.firsts, collections.copyOf(&rg.row))
                for i in 0..ns { append(mut &rg.accs, noAcc()) }
            }
        }
    } else if len(rg.firsts) == 0 {
        append(mut &rg.firsts, collections.copyOf(&rg.row))
        for i in 0..ns { append(mut &rg.accs, noAcc()) }
    }
    for i in 0..ns { try accOne(&a.calls[i], mut &rg.accs[g * ns + i], &rg.row, cx) }
    return Ok(Unit{})
}

// Adds a row to a call's state, as the row engine's accumulate: its
// FILTER, then its argument's value (a NULL not counted); a sum by its
// type's addition (avg of reals in double precision, squared to overflow
// where PostgreSQL's float8_accum does); of equal values the last kept as
// the minimum or maximum (PostgreSQL's numeric_smaller).
fn accOne(c: &lexdb_plan.PCall, acc: mut &PAcc, row: &[]Val, cx: &Ctx): Result[Unit, DbErr] {
    let noAggs: []Val = []
    match c.filter {
        Some(f) { if lexdb_ops.truth(&(try bxEval(&f, row, &noAggs, cx))) != Some(true) { return Ok(Unit{}) } }
        None {}
    }
    if c.star {
        acc.n += 1
        return Ok(Unit{})
    }
    let v = match c.arg {
        Some(x) { try bxEval(&x, row, &noAggs, cx) }
        None { Val.Null }
    }
    if lexdb_ops.isNull(&v) { return Ok(Unit{}) }
    let f = &c.fname
    if f == "sum" || f == "avg" {
        let w = if f == "avg" && lexdb_ops.isReal(&v) { Val.Float(lexdb_ops.asFloat(&v).unwrap()) } else { v }
        if f == "avg" && lexdb_ops.isFloat(&w) { let sq = try lexdb_ops.arith(lexdb_ops.OP_MUL, &w, &w) }
        acc.sum = if lexdb_ops.isNull(&acc.sum) { w } else { try lexdb_ops.arith(lexdb_ops.OP_ADD, &acc.sum, &w) }
    } else if f == "min" {
        if lexdb_ops.isNull(&acc.val) || (try lexdb_ops.compare(&v, &acc.val)) <= 0 { acc.val = v }
    } else if f == "max" {
        if lexdb_ops.isNull(&acc.val) || (try lexdb_ops.compare(&v, &acc.val)) >= 0 { acc.val = v }
    }
    acc.n += 1
    return Ok(Unit{})
}

// Row j of an OutBatch, into out.
pub fn obRow(ob: &lexdb_rows.OutBatch, j: int, out: mut &[]Val) {
    while len(out) > 0 { let x = pop(out) }
    let r = ob.idx[j]
    for o in 0..len(ob.kinds) {
        let k = ob.kinds[o]
        let c = ob.src[o]
        if c < 0 {
            let x = &ob.ex[o]
            append(out, if x.nul[j] { Val.Null } else if k == BK_BOOL { Val.Bool(x.v[j] == 1) } else { Val.Int(x.v[j]) })
        } else if ob.cols[c].nul[r] {
            append(out, Val.Null)
        } else {
            append(out, if k == lexdb_rows.BK_INT { Val.Int(ob.cols[c].v[r]) } else if k == BK_BOOL { Val.Bool(ob.cols[c].v[r] == 1) }
                        else if k == lexdb_rows.BK_TEXT { Val.Text(lexdb_rows.obText(ob, o, j).clone()) } else { ob.vals[c][r].clone() })
        }
    }
}
// ---- subqueries' values, IN's sets and hash keys
//
// A subquery run once (lexdb_plan.RUN_ONCE) is a value to the plans that
// read it: a scalar's value, EXISTS's rows, IN's set of its values' keys,
// keyed (inValKeys) so that a probe (inProbe) finds a value exactly when =
// would give true. A hash's key parts (keyPart) are made the same way for
// joins and the hashed subqueries.

// A subquery's value (its caller runs it): its rows, a scalar's value,
// IN's set (inValKeys' keys; hashed: each after its key's, keyPart), and
// whether its values are numbers (keyed as numbers) and any is NULL.
pub type SubVal = record {
    pub rows: int
    pub val: Val
    pub set: Map[str, int]
    pub numeric: bool
    pub hasNull: bool
}

pub fn noSubVal(): SubVal { return SubVal{rows: 0, val: Val.Null, set: newMap(), numeric: false, hasNull: false} }

// A copy of subs (a compiled expression's own: BGen's context).
pub fn copySub(s: &SubVal): SubVal {
    var set: Map[str, int] = newMap()
    for i in 0..s.set.size() { set.put(s.set.keyAt(i).toStr(), s.set.valAt(i)) }
    return SubVal{rows: s.rows, val: s.val.clone(), set: set, numeric: s.numeric, hasNull: s.hasNull}
}

pub fn copySubs(subs: &[]SubVal): []SubVal {
    var out: []SubVal = []
    for s in subs {
        var set: Map[str, int] = newMap()
        for i in 0..s.set.size() { set.put(s.set.keyAt(i).toStr(), s.set.valAt(i)) }
        append(mut &out, SubVal{rows: s.rows, val: s.val.clone(), set: set, numeric: s.numeric, hasNull: s.hasNull})
    }
    return out
}

// A hash key's part: numbers by value (2 = 2.0), else as the value.
pub fn keyPart(b: mut &str, v: &Val) {
    match v {
        Val.Int(_) {}
        Val.Num(_) {}
        else {
            lexdb_access.encIdxPart(b, v)
            return
        }
    }
    match lexdb_ops.asNum(v) {
        Some(d) {
            b.addByte(3)
            lexdb_access.encNum(b, &d)
        }
        None { lexdb_access.encIdxPart(b, v) }
    }
}

// An IN set's key: numbers by value (1 = 1.0), else as the value.
pub fn setKey(v: &Val, numeric: bool): Option[str] {
    var kb = ""
    if numeric {
        match lexdb_ops.asNum(v) {
            Some(d) {
                lexdb_access.encNum(mut &kb, &d)
                return Some(kb)
            }
            None { return None }
        }
    }
    lexdb_access.encIdxPart(mut &kb, v)
    return Some(kb)
}

// A value's class for an IN set's keys: 1 an integer or numeric, 2 a
// float8 or float4, 10 + its kind a date or time value, 0 the others.
pub fn inClass(v: &Val): int {
    match v {
        Val.Int(_) { return 1 }
        Val.Num(_) { return 1 }
        Val.Float(_) { return 2 }
        Val.Real(_) { return 2 }
        else {}
    }
    let k = lexdb_ops.kindOf(v)
    if lexdb_sql.isTimeKind(k) { return 10 + k }
    return 0
}

// A column type's class (inClass) for its values.
pub fn typeClass(t: &lexdb_sql.TypeName): int {
    if t.kind == lexdb_sql.K_INT || t.kind == lexdb_sql.K_NUM { return 1 }
    if t.kind == lexdb_sql.K_FLOAT { return 2 }
    if lexdb_sql.isTimeKind(t.kind) { return 10 + t.kind }
    return 0
}

// A float compared as = compares one (a float8: -0 as 0, NaN equal to NaN): its key.
pub fn fKey(f: float): str {
    if f != f { return "n" }
    let g = if f == 0.0f { 0.0f } else { f }
    var b = ""
    lexdb_access.encIdxPart(mut &b, &Val.Float(g))
    return b
}

// 2^53: every integer up to it is a float8 exactly, and no other float8
// equals it
pub const FLOAT_EXACT: float = 9007199254740992.0f

// A float8 that is a whole number within FLOAT_EXACT.
pub fn wholeF(f: float): bool { return f >= -FLOAT_EXACT && f <= FLOAT_EXACT && float(int(f)) == f }

// An integer, or a numeric of a whole value, within FLOAT_EXACT: a float8
// equals it exactly when it is that whole number.
pub fn exactInt(v: &Val): bool {
    match v {
        Val.Int(n) { return n >= -9007199254740992 && n <= 9007199254740992 }
        Val.Num(d) {
            match lexdb_ops.asFloat(v) {
                Some(f) {
                    if !wholeF(f) { return false }
                    match lexdb_ops.asNum(&Val.Int(int(f))) {
                        Some(e) { return e.cmp(&d) == 0 }
                        None { return false }
                    }
                }
                None { return false }
            }
        }
        else { return false }
    }
}

pub fn isInstantClass(c: int): bool { return c == 10 + lexdb_sql.K_DATE || c == 10 + lexdb_sql.K_TS || c == 10 + lexdb_sql.K_TSTZ }

// An IN set's keys for its value v, each tagged by what it is equal to,
// so that a probe (inProbeKeys) finds v exactly when = would give true
// (compare, compareTime in zone z):
// - X: the key a value always had (old: an integer or numeric by value
//   when the set has any, numeric; else as the value; hashed: keyPart),
//   for integers, numerics and the other values;
// - a / F / t: a float8, an integer or numeric's (compared with a float),
//   a float's, a text's that reads as one: = compares as float8 when
//   either side is a float;
// - K: a date or time value of its own kind; I: a date, timestamp or
//   timestamptz's instant in zone z, which = compares across those kinds.
pub fn inValKeys(v: &Val, numeric: bool, hashed: bool, z: &lexdb_time.Zone, out: mut &[]str) {
    let c = inClass(v)
    if c == 2 {
        match lexdb_ops.asFloat(v) {
            Some(f) { append(out, "F" + fKey(f)) }
            None {}
        }
        return
    }
    if c >= 10 {
        var b = ""
        lexdb_access.encIdxPart(mut &b, v)
        append(out, "K" + c.toStr() + ":" + b)
        if isInstantClass(c) {
            match lexdb_ops.asTstz(v, z) {
                Some(u) { append(out, "I" + c.toStr() + ":" + u.toStr()) }
                None {}
            }
        }
        return
    }
    if hashed {
        var b = ""
        keyPart(mut &b, v)
        append(out, "X" + b)
    } else {
        match setKey(v, numeric) {
            Some(k) { append(out, "X" + k) }
            None {}
        }
    }
    if c == 1 {
        // (an integer a float8 holds exactly has none: a float probe
        // finds it by its own X key, intProbe)
        if !exactInt(v) {
            match lexdb_ops.asFloat(v) {
                Some(f) { append(out, "a" + fKey(f)) }
                None {}
            }
        }
    } else {
        match v {
            Val.Text(_) {
                match lexdb_ops.asFloat(v) {
                    Some(f) { append(out, "t" + fKey(f)) }
                    None {}
                }
            }
            else {}
        }
    }
}

// The keys an IN probe x looks for (inValKeys).
pub fn inProbeKeys(x: &Val, numeric: bool, hashed: bool, z: &lexdb_time.Zone, out: mut &[]str) {
    let c = inClass(x)
    if c == 2 {
        match lexdb_ops.asFloat(x) {
            Some(f) {
                let k = fKey(f)
                append(out, "F" + k)
                append(out, "a" + k)
                append(out, "t" + k)
                // the integers it equals as a float8: itself, when it is
                // a whole number a float8 holds exactly (exactInt)
                if wholeF(f) {
                    let iv = Val.Int(int(f))
                    if hashed {
                        var b = ""
                        keyPart(mut &b, &iv)
                        append(out, "X" + b)
                    } else {
                        match setKey(&iv, numeric) {
                            Some(kk) { append(out, "X" + kk) }
                            None {}
                        }
                    }
                }
            }
            None {}
        }
        return
    }
    if c >= 10 {
        var b = ""
        lexdb_access.encIdxPart(mut &b, x)
        append(out, "K" + c.toStr() + ":" + b)
        if isInstantClass(c) {
            match lexdb_ops.asTstz(x, z) {
                Some(u) {
                    for k in [lexdb_sql.K_DATE, lexdb_sql.K_TS, lexdb_sql.K_TSTZ] {
                        if 10 + k != c { append(out, "I" + (10 + k).toStr() + ":" + u.toStr()) }
                    }
                }
                None {}
            }
        }
        return
    }
    if hashed {
        var b = ""
        keyPart(mut &b, x)
        append(out, "X" + b)
    } else {
        match setKey(x, numeric) {
            Some(k) { append(out, "X" + k) }
            None {}
        }
    }
    // an integer or numeric, or a text read as a float8, against floats
    match x {
        Val.Int(_) {}
        Val.Num(_) {}
        Val.Text(_) {}
        else { return }
    }
    match lexdb_ops.asFloat(x) {
        Some(f) { append(out, "F" + fKey(f)) }
        None {}
    }
}

// x IN (subquery): true if one equals x, as = compares them; else NULL if
// x or one is NULL. Each of x's keys (inProbeKeys) looked up: one lookup or
// a few, whatever the types.
pub fn inProbe(r: &SubVal, x: &Val, z: &lexdb_time.Zone): Val {
    if r.rows == 0 { return Val.Bool(false) }
    if lexdb_ops.isNull(x) { return Val.Null }
    var ks: []str = []
    inProbeKeys(x, r.numeric, false, z, mut &ks)
    for k in ks { if r.set.get(&k).isSome() { return Val.Bool(true) } }
    return if r.hasNull { Val.Null } else { Val.Bool(false) }
}

// A subquery's value where call n ("#sub", "#exists", "#in", lexdb_sql's
// names) reads it; x: IN's value.
pub fn subValue(n: &str, r: &SubVal, x: &Val, z: &lexdb_time.Zone): Val {
    if n == "#exists" { return Val.Bool(r.rows > 0) }
    if n == "#in" { return inProbe(r, x, z) }
    return r.val.clone()
}

// ---- joins (slice P2; design/lexdb-layers.md 6.2.3)
//
// Join (... Join (Filter? (Scan), j1) ..., jn): the first table scanned in
// chunks, each table after it joined to a chunk's rows: a hash of its rows
// read once (read in batches, its own conditions applied as they are
// read), a lookup per row by its primary key, or a range per row. Only row
// numbers go from level to level (per table, its row in that table's rows
// for the chunk: the scan's batch, the hash's rows, a lookup's rows read;
// -1 a LEFT JOIN's NULL row), and an operator gathers the columns it reads
// when it runs: a join's keys, its conditions, then the consumer's columns,
// once each (late materialisation; the required columns are the plan's,
// lexdb_plan.needs). With a first hash join of one integer key from the
// scanned table, the scan drops the rows whose key the hash does not hold
// before it decodes their other columns. The joined rows are in the row
// engine's order (by the first table's row, then each table's matches in
// the order read), counted as it counts them. An expression's error is
// raised from its chunk (its lowest row of the first failing step, 4.4.1);
// a value a batch cannot hold gives batErr, before any row is given where
// the caller holds them (pipeHeld, an aggregate's groups) and the caller
// runs the query another way.

// How a hash join's key is looked up.
const JK_GEN = 0        // the keys' values made as the row engine makes them (keyVal), encoded (encIdxPart)
const JK_INT = 1        // one integer key of an integer column: by its value
const JK_TEXT = 2       // one text key of a text column, no collation: by its text

// A value a batch cannot hold in a join's run (a chunk's, a lookup's): the
// caller runs the query another way.
pub fn batErr(): DbErr { return e("XXBAT", "a value a join's batch cannot hold") }

pub fn isBat(x: &DbErr): bool { return x.state == "XXBAT" }

// Joined chunks given, of plans with joins (the tests' look): chunks,
// hash joins built, rows the scan dropped by the first hash's keys.
var joinChunks: int = 0
var hashBuilds: int = 0
var pushDrops: int = 0

var joinRuns: int = 0

pub fn joinCounts(): []int { return [joinRuns, joinChunks, hashBuilds, pushDrops] }

// A level of a join's run: the first table (how -1) or a table joined.
type JL = record {
    how: int
    left: bool
    level: int
    first: int
    ncol: int
    rkinds: []int           // its columns' kinds in its rows
    key: []BNode            // per key column: its value over the rows before (gathered)
    keyTyp: []int
    keyCol: []int           // ... a column of values' (BT_OTHER) place
    kreads: []int           // the query's columns the keys read
    mode: int
    ints: Map[int, int]     // JK_INT: key -> bucket
    txts: Map[str, int]     // JK_TEXT
    gens: Map[str, int]     // JK_GEN
    head: []int             // per bucket: its first row
    next: []int             // per row of a hash: the next of its bucket (-1)
    rows: Batch             // a hash's rows (by its table's column)
    conds: []BNode
    creads: []int
    post: []BNode
    preads: []int
    ktypes: []lexdb_sql.TypeName
    tail: lexdb_access.Tail // a range's bounds after its equalities
    noRange: bool           // ... one of them NULL: no row
    index: int
    bp: BPlan               // a lookup's or range's columns read
    perRow: int             // a range's rows' bytes each, held while joined
    mark: int               // lexdb_plan.MK_*
    los: []Val              // a range's bounds after its equalities, as values (rangeOne)
    his: []Val
    noNulls: bool
    right: bool             // a RIGHT JOIN's: its rows that joined are noted (JState.seen)
    raw: bool               // a subquery's rows: keys by their values' own encoding (keyPart), not coerced
    resCol: int             // a "<>" summary's column (-1 none): mixed, single per bucket; res its outer value
    mixed: []bool
    single: []Val
    res: BNode
    resTyp: int
    // cut by the next level's hash (reduceHashes): per bucket, the rows
    // cut (a bucket left empty keeps its key), counted as read and joined
    // here and probed there (the next level's place in jls), as the row
    // engine counts them; -1 not cut
    cutB: []int
    cutTo: int
}

fn newJL(how: int, level: int, first: int, ncol: int): JL {
    return JL{how: how, left: false, level: level, first: first, ncol: ncol, rkinds: [], key: [], keyTyp: [], keyCol: [], kreads: [],
              mode: JK_GEN, ints: newMap(), txts: newMap(), gens: newMap(), head: [], next: [], rows: lexdb_rows.noRows(),
              conds: [], creads: [], post: [], preads: [], ktypes: [], tail: lexdb_access.noTail(), noRange: false, index: -1,
              bp: BPlan{kinds: [], needCol: [], placeCol: [], usedP: [], stopAt: 0, missing: [], needP: [], width: 0, ranges: []},
              perRow: 0, mark: 0, los: [], his: [], noNulls: false, right: false, raw: false, resCol: -1, mixed: [], single: [], res: BNode.Const(0, true), resTyp: BT_INT,
              cutB: [], cutTo: -1}
}

// A join's run: its levels, the query's columns' kinds (all tables'),
// which level holds each column (-1 none), the columns the consumer reads.
type JRun = record {
    jls: []JL
    kinds: []int
    owner: []int
    want: []bool
    wantList: []int
    nq: int
    zone: lexdb_time.Zone
}

// The query's columns x reads, in order of first read.
fn readsOf(xs: &[]BX, out: mut &[]int) {
    for x in xs { readsOf1(&x, out) }
}

fn readsOf1(x: &BX, out: mut &[]int) {
    var slots: []int = []
    var par = false
    let r = lexdb_bind.reslot(x, mut &slots, mut &par)
    for s in slots {
        var have = false
        for o in out { if o == s { have = true } }
        if !have { append(out, s) }
    }
}

// x, bound, as a condition over a batch (condNode), numerics as units with dec.
fn condNodeD(x: &BX, cols: &[]lexdb_sql.ColDef, kinds: &[]int, ce: &Ctx, base: int, need: &[]bool, dec: bool): Option[BNode] {
    let c = bCompileD(x, cols, kinds, ce, base, dec)
    if c.isSome() {
        let cc = c.unwrap()
        if boolLike(cc.typ) { return Some(takeN(cc)) }
    }
    match inGenOf(x, kinds, ce, base, need) {
        Some(n) { return Some(n) }
        None {}
    }
    match bGenOf(x, kinds, base, need, ce) {
        Some(g) { return Some(BNode.Gen(g)) }
        None { return None }
    }
}

// p's arms under its joins: Filter? (Scan).
fn joinBottom(p: &lexdb_plan.PPlan): &lexdb_plan.PPlan {
    match p {
        lexdb_plan.PPlan.Join(i, _) { return joinBottom(&i) }
        else { return p }
    }
}

// Whether p (under the consumer) has a join.
pub fn hasJoin(p: &lexdb_plan.PPlan): bool {
    match p {
        lexdb_plan.PPlan.Join(_, _) { return true }
        lexdb_plan.PPlan.Filter(i, _) { return hasJoin(&i) }
        lexdb_plan.PPlan.Agg(i, _, _) { return hasJoin(&i) }
        lexdb_plan.PPlan.Project(i, _) { return hasJoin(&i) }
        lexdb_plan.PPlan.Limit(i, _, _, _) { return hasJoin(&i) }
        lexdb_plan.PPlan.Sort(i, _, _) { return hasJoin(&i) }
        lexdb_plan.PPlan.Having(i) { return hasJoin(&i) }
        lexdb_plan.PPlan.Distinct(i, _, _) { return hasJoin(&i) }
        lexdb_plan.PPlan.Match(i) { return hasJoin(&i) }
        else { return false }
    }
}

// The operators of a join tree p if the pipeline runs it (each table's
// arm one it reads, each expression reading only the columns decoded by
// the tables it may read), else -1. avail: per column of the query, made
// by the tables below (set for p's).
fn joinOps(p: &lexdb_plan.PPlan, cols: &[]lexdb_sql.ColDef, avail: mut &[]bool): int {
    match p {
        lexdb_plan.PPlan.Join(i, j) {
            let k = joinOps(&i, cols, avail)
            if k < 0 { return -1 }
            let sc = &j.scan
            if len(sc.kinds) != len(cols) || sc.first < 0 || sc.first + len(sc.need) > len(cols) { return -1 }
            if j.kind != lexdb_sql.J_INNER && j.kind != lexdb_sql.J_LEFT && j.kind != lexdb_sql.J_RIGHT { return -1 }
            let hash = j.how == lexdb_plan.JH_HASH || j.how == lexdb_plan.JH_ROWS
            if j.kind == lexdb_sql.J_RIGHT && (!hash || j.mark != lexdb_plan.MK_JOIN) { return -1 }
            if j.mark != lexdb_plan.MK_JOIN && j.kind != lexdb_sql.J_INNER { return -1 }
            if j.resCol >= 0 && (!hash || len(j.res) != 1 || !allIn(&j.res, avail)) { return -1 }
            if hash {
                if len(j.hcols) == 0 || len(j.hcols) != len(j.keys) || len(j.ktypes) != len(j.keys) || !j.exact { return -1 }
                for c in j.hcols { if c < 0 || c >= len(sc.need) || !sc.need[c] { return -1 } }
                // its own conditions read its own columns only
                var own: []bool = array(len(cols), false)
                for c in 0..len(sc.need) { own[sc.first + c] = sc.need[c] }
                if !allIn(&j.build, &own) { return -1 }
            } else if j.how == lexdb_plan.JH_LOOK || j.how == lexdb_plan.JH_RANGE {
                if len(j.keys) == 0 || len(j.ktypes) < len(j.keys) { return -1 }
                if j.how == lexdb_plan.JH_RANGE && len(j.rng) > 0 && len(j.ktypes) != len(j.keys) + 1 { return -1 }
                if len(j.build) > 0 { return -1 }
            } else {
                return -1
            }
            if !allIn(&j.keys, avail) { return -1 }
            for c in 0..len(sc.need) { avail[sc.first + c] = sc.need[c] }
            if !allIn(&j.conds, avail) || !allIn(&j.post, avail) { return -1 }
            return k + 1
        }
        lexdb_plan.PPlan.Filter(i, cs) {
            match i {
                lexdb_plan.PPlan.Scan(sc, subs) {
                    if !joinRuns1(&sc, &subs, cols) || !sc.batch { return -1 }
                    for c in 0..len(sc.need) { avail[sc.first + c] = sc.need[c] }
                    if !allIn(&cs, avail) { return -1 }
                    return 1
                }
                else { return -1 }
            }
        }
        lexdb_plan.PPlan.Scan(sc, subs) {
            if !joinRuns1(&sc, &subs, cols) || !sc.batch { return -1 }
            for c in 0..len(sc.need) { avail[sc.first + c] = sc.need[c] }
            return 1
        }
        else { return -1 }
    }
}

fn allIn1(x: &BX, avail: &[]bool): bool {
    var rs: []int = []
    readsOf1(x, mut &rs)
    for c in rs { if c < 0 || c >= len(avail) || !avail[c] { return false } }
    return true
}

// scanRuns for a join plan's first table: its subqueries run once (their
// values in the run's context), or a semi or anti join's (run once, its
// rows a level's: RUN_SEMI; or not run: RUN_LOOKED), or in FROM (its
// rows a level's).
fn joinRuns1(sc: &lexdb_plan.PScan, subs: &[]lexdb_plan.PSub, cols: &[]lexdb_sql.ColDef): bool {
    for s in subs {
        let ok = s.run == lexdb_plan.RUN_SEMI || s.run == lexdb_plan.RUN_LOOKED || (s.run == lexdb_plan.RUN_ONCE)
        if !ok { return false }
    }
    return len(sc.kinds) == len(cols) && sc.first >= 0 && sc.first + len(sc.need) <= len(cols)
}

// Whether every expression of xs reads only columns avail holds.
fn allIn(xs: &[]BX, avail: &[]bool): bool {
    var rs: []int = []
    readsOf(xs, mut &rs)
    for c in rs { if c < 0 || c >= len(avail) || !avail[c] { return false } }
    return true
}

// The levels of a join plan (ops - 1 of them: the query's levels each
// counted at its own place).
fn levelsOf(p: &lexdb_plan.PPlan): int {
    match p {
        lexdb_plan.PPlan.Join(i, _) { return levelsOf(&i) + 1 }
        else { return 1 }
    }
}

// The kinds of the query's columns read by a join plan's tables (numerics
// as units with dec), and which level holds each.
fn joinKinds(p: &lexdb_plan.PPlan, tabs: &[]&lexdb_catalog.Table, dec: bool, kinds: mut &[]int, owner: mut &[]int, lvl: mut &int) {
    match p {
        lexdb_plan.PPlan.Join(i, j) {
            joinKinds(&i, tabs, dec, kinds, owner, lvl)
            setKinds(&j.scan, tabs[j.scan.level], dec, kinds, owner, lvl)
            lvl += 1
        }
        lexdb_plan.PPlan.Filter(i, _) { joinKinds(&i, tabs, dec, kinds, owner, lvl) }
        lexdb_plan.PPlan.Scan(sc, _) {
            setKinds(&sc, tabs[sc.level], dec, kinds, owner, lvl)
            lvl += 1
        }
        else {}
    }
}

fn setKinds(sc: &lexdb_plan.PScan, t: &lexdb_catalog.Table, dec: bool, kinds: mut &[]int, owner: mut &[]int, lvl: int) {
    for i in 0..len(t.cols) {
        if sc.first + i >= len(kinds) { break }
        kinds[sc.first + i] = lexdb_rows.pipeKind(&t.cols[i], dec)
        owner[sc.first + i] = lvl
    }
}

// The projection a table's batches are read by: its columns' kinds (as
// the run's), those decoded.
fn projOf(t: &lexdb_catalog.Table, sc: &lexdb_plan.PScan, kinds: &[]int): BPlan {
    let rel = lexdb_catalog.relOf(t)
    var ks: []int = []
    for i in 0..len(t.cols) { append(mut &ks, kinds[sc.first + i]) }
    let needP = lexdb_access.placesNeeded(&rel, &sc.need)
    return lexdb_rows.projectionOf(ks, collections.copyOf(&sc.need), &t.slots, lexdb_catalog.rowWidth(t), lexdb_access.placesMissing(&rel), needP)
}

// What reading a table did: rows read, those its conditions kept, its
// batches, and the rows the first hash's keys dropped after them.
type RC = record { read: int; kept: int; batches: int; pushed: int; cut: int }

// Reads table t's rows as src says (the plan's arm sc), in chunks: each
// batch (by the table's columns, bp) and the rows its conditions conds
// keep, to each; false from each stops. With pushCol >= 0 (a column of
// the batch), a row whose value there is NULL or not in push is dropped
// too, before the batch's other columns are decoded. An error of a
// condition: raised. A value a batch cannot hold: batErr. Whether each
// stopped it.
fn readRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &lexdb_catalog.Table, sc: &lexdb_plan.PScan, src: &Src, bp: &BPlan,
            conds: &[]BNode, pushCol: int, ph: &PushH, rawOnErr: bool, rc: mut &RC,
            each: &fn(mut &lexdb_store.Txn, mut &Batch, []int, bool): Result[bool, DbErr]): Result[bool, DbErr] {
    let rel = lexdb_catalog.relOf(t)
    var ranges = false
    for s in src.scans { if !s.point && !s.empty { ranges = true } }
    if !src.batch || !ranges {
        // row by row (points, a range's keys read, IN lists): a batch of them at a time
        var need: []bool = []
        if sc.part { for x in sc.need { append(mut &need, x) } }
        var rows: [][]Val = []
        if len(src.keys) > 0 {
            let rr = lexdb_access.rowRead(&rel, &need)
            for i in 0..len(src.keys) {
                match try lexdb_access.getRow(st, txn, &rel, &rr, &src.keys[i]) {
                    Some(r0) { append(mut &rows, r0) }
                    None { return Err(lexdb_base.corrupt(&("an index entry of \"" + t.name + "\" without its row"))) }
                }
            }
        } else {
            try lexdb_access.warmPoints(st, txn, &rel, &src.scans)
            for s in src.scans {
                var cur = lexdb_access.newCursor()
                while !cur.done { try lexdb_access.fetch(st, txn, &rel, src.index, src.desc, &s, &need, mut &cur, mut &rows) }
            }
        }
        var at = 0
        while at < len(rows) {
            var b = lexdb_rows.newBatch(bp, lexdb_rows.BROWS)
            b.n = 0
            while at < len(rows) && b.n < lexdb_rows.BROWS {
                for c in 0..len(bp.kinds) {
                    if !bp.needCol[c] { continue }
                    let v = if c < len(rows[at]) { replace(mut &rows[at][c], Val.Null) } else { Val.Null }
                    if !lexdb_rows.put(mut &b, c, b.n, v, bp.kinds[c]) { return Err(batErr()) }
                }
                b.n += 1
                at += 1
            }
            var idx: []int = withCapacity(b.n)
            for r in 0..b.n { append(mut &idx, r) }
            // (counted as read row by row: no batch)
            rc.read += b.n
            match pick(conds, &b, collections.copyOf(&idx)) {
                Ok(kept) {
                    rc.kept += len(kept)
                    let fin = pushed(&b, kept, pushCol, ph, rc)
                    if !(try each(txn, mut &b, fin, false)) { return Ok(true) }
                }
                Err(x) {
                    // the caller's, row by row (an error past a LIMIT is not reached)
                    if !rawOnErr { return Err(x) }
                    if !(try each(txn, mut &b, idx, true)) { return Ok(true) }
                }
            }
        }
        return Ok(false)
    }
    let lazy = lazyOf(bp, t, conds, pushCol)
    let hasCut = len(ph.cutB) > 0
    try lexdb_access.warmPoints(st, txn, &rel, &src.scans)
    for s in src.scans {
        var cur = lexdb_access.newCursor()
        var spare = lexdb_rows.noRows()
        while !cur.done {
            let saved = cur.copy()
            var bad: []DbErr = []
            var keptN = 0
            var dropped = 0
            var cutRows = 0
            let got = try lexdb_access.fillPickIn(st, txn, &rel, &s, sc.part, mut &cur, bp, &src.rd, &lazy,
                                                  fn(skip: &[]bool, b: &Batch, idx: []int): Option[[]int] {
                var cur2 = idx
                for ci in 0..len(conds) {
                    if len(cur2) == 0 { break }
                    if ci < len(skip) && skip[ci] { continue }
                    match bTrue(&conds[ci], b, &cur2) {
                        Ok(pos) {
                            var nx: []int = withCapacity(len(pos))
                            for j in pos { append(mut &nx, cur2[j]) }
                            cur2 = nx
                        }
                        Err(x) {
                            append(mut &bad, x)
                            return None
                        }
                    }
                }
                keptN += len(cur2)
                if pushCol < 0 { return Some(cur2) }
                var fin: []int = withCapacity(len(cur2))
                let kc = &b.cols[pushCol]
                // (holds, inline: the scan's every row)
                for r in cur2 {
                    if kc.nul[r] {
                        dropped += 1
                        continue
                    }
                    match ph.keys.get(&kc.v[r]) {
                        Some(bk) {
                            if ph.head[bk] >= 0 { append(mut &fin, r) } else {
                                dropped += 1
                                if hasCut { cutRows += ph.cutB[bk] }
                            }
                        }
                        None { dropped += 1 }
                    }
                }
                return Some(fin)
            }, &lexdb_access.noBar(), mut &spare)
            if got.isNone() {
                if len(bad) == 0 || !rawOnErr {
                    if len(bad) > 0 { return Err(replace(mut &bad[0], lexdb_base.err("XX000", ""))) }
                    return Err(batErr())
                }
                // a condition's error on one of its rows: the batch again,
                // whole, to the caller, which evaluates it row by row (an
                // error past a LIMIT is not reached)
                cur = saved
                let g2 = try lexdb_access.fillLevel(st, txn, &rel, &src.rd, &s, sc.part, mut &cur, bp, mut &spare)
                if g2.isNone() { return Err(batErr()) }
                var b2 = g2.unwrap()
                var all: []int = withCapacity(b2.n)
                for r in 0..b2.n { append(mut &all, r) }
                rc.read += b2.n
                rc.batches += 1
                if !(try each(txn, mut &b2, all, true)) { return Ok(true) }
                spare = b2
                continue
            }
            var pk = got.unwrap()
            var b = replace(mut &pk.b, lexdb_rows.noRows())
            let idx = replace(mut &pk.idx, [])
            let nr = b.n
            if nr == 0 {
                spare = b
                continue
            }
            rc.read += nr
            rc.kept += keptN
            rc.pushed += dropped
            rc.cut += cutRows
            rc.batches += 1
            if !(try each(txn, mut &b, idx, false)) { return Ok(true) }
            // (the batch back from its consumer, used again: lexdb_rows.reuse)
            spare = b
        }
    }
    return Ok(false)
}

// idx narrowed to the rows of b every one of conds holds for, in order;
// an error of one: raised.
fn pick(conds: &[]BNode, b: &Batch, idx0: []int): Result[[]int, DbErr] {
    var idx = idx0
    for c in conds {
        if len(idx) == 0 { break }
        let pos = try bTrue(&c, b, &idx)
        var nx: []int = withCapacity(len(pos))
        for j in pos { append(mut &nx, idx[j]) }
        idx = nx
    }
    return Ok(idx)
}

// rows narrowed by the first hash's keys (readRows' push), the dropped counted.
fn pushed(b: &Batch, rows: []int, pushCol: int, ph: &PushH, rc: mut &RC): []int {
    if pushCol < 0 { return rows }
    var fin: []int = withCapacity(len(rows))
    let kc = &b.cols[pushCol]
    for r in rows {
        if ph.holds(kc, r, mut &rc.cut) { append(mut &fin, r) } else { rc.pushed += 1 }
    }
    return fin
}

// The first hash's keys as the scan narrows by them: its key map, its
// buckets' first rows, and (reduceHashes) its rows cut per bucket.
type PushH = record { keys: &Map[int, int]; head: &[]int; cutB: &[]int }

// Whether row r's key (column kc) has rows in the hash; the rows a cut
// took from its bucket added to cut.
fn (ph: &PushH) holds(kc: &BVec, r: int, cut: mut &int): bool {
    if kc.nul[r] { return false }
    match ph.keys.get(&kc.v[r]) {
        Some(bk) {
            if ph.head[bk] >= 0 { return true }
            if len(ph.cutB) > 0 { cut += ph.cutB[bk] }
            return false
        }
        None { return false }
    }
}

// Column c's rows at (its rows' places in src; -1 NULL) into out's column oc.
pub fn bGather(src: &Batch, c: int, kind: int, at: &[]int, out: mut &Batch, oc: int) {
    let n = len(at)
    var col = lexdb_rows.bvec(n)
    let s = &src.cols[c]
    for p in 0..n {
        let r = at[p]
        if r < 0 { col.nul[p] = true } else {
            col.v[p] = s.v[r]
            col.nul[p] = s.nul[r]
        }
    }
    if kind == BK_TEXT {
        // the texts' bytes, each row's place moved to the new buffer
        var buf = replace(mut &out.txt[oc], "")
        buf.clear()
        for p in 0..n {
            if col.nul[p] { continue }
            let t = lexdb_rows.textAt(src, c, at[p])
            col.v[p] = (len(buf) << 24) | len(t)
            buf += t
        }
        out.txt[oc] = buf
    }
    out.cols[oc] = col
    if kind == BK_VAL {
        var vs: []Val = array(n, Val.Null)
        let sv = &src.vals[c]
        for p in 0..n {
            let r = at[p]
            if r >= 0 { vs[p] = sv[r].clone() }
        }
        out.vals[oc] = vs
    }
}

// An empty batch of nq columns, n rows.
pub fn bJoined(nq: int, n: int): Batch {
    var b = Batch{cols: [], vals: [], txt: [], n: n}
    for i in 0..nq {
        append(mut &b.cols, lexdb_rows.bvec(0))
        append(mut &b.vals, [])
        append(mut &b.txt, "")
    }
    return b
}

// The query's columns reads of the joined rows at (per level so far, its
// rows' places), gathered from their levels' rows into a batch of the
// query's columns.
fn gatherAt(jr: &JRun, cur: &[]Batch, at: &[][]int, n: int, reads: &[]int): Batch {
    var w = bJoined(jr.nq, n)
    for c in reads {
        let o = jr.owner[c]
        if o < 0 || o >= len(at) { continue }
        let jl = &jr.jls[o]
        let src = if hashed(jl) { &jl.rows } else { &cur[o] }
        if c - jl.first >= len(src.cols) {
            // (no rows of it: a RIGHT JOIN's unmatched rows' tables before it)
            var col = lexdb_rows.bvec(n)
            for p in 0..n { col.nul[p] = true }
            w.cols[c] = col
            if jr.kinds[c] == BK_VAL { w.vals[c] = array(n, Val.Null) }
            continue
        }
        bGather(src, c - jl.first, jr.kinds[c], &at[o], mut &w, c)
    }
    return w
}

// Whether a level's rows are its hash's (read once), not the chunk's.
fn hashed(jl: &JL): bool { return jl.how == lexdb_plan.JH_HASH || jl.how == lexdb_plan.JH_ROWS }

// at's rows sel (per level, its rows at sel's places).
fn compose(at: &[][]int, sel: &[]int): [][]int {
    var out: [][]int = withCapacity(len(at) + 1)
    for a in at {
        var x: []int = withCapacity(len(sel))
        for s in sel { append(mut &x, a[s]) }
        append(mut &out, x)
    }
    return out
}

// The keys of a level over w's rows: per key its vector (BT_OTHER: empty).
fn keyVecs(jl: &JL, w: &Batch): Result[[]BVec, DbErr] {
    var all: []int = withCapacity(w.n)
    for r in 0..w.n { append(mut &all, r) }
    var kv: []BVec = []
    for i in 0..len(jl.key) {
        if jl.keyTyp[i] == BT_OTHER {
            append(mut &kv, lexdb_rows.bvec(0))
            continue
        }
        append(mut &kv, try bEval(&jl.key[i], w, &all))
    }
    return Ok(kv)
}

// Key i's value of row r (w the gathered rows, kv the keys' vectors).
fn keyAt(jl: &JL, kv: &[]BVec, w: &Batch, i: int, r: int): Val {
    let t = jl.keyTyp[i]
    if t == BT_OTHER {
        let c = jl.keyCol[i]
        if w.cols[c].nul[r] { return Val.Null }
        if lexdb_rows.isTextCol(w, c) { return Val.Text(lexdb_rows.textAt(w, c, r).clone()) }
        return w.vals[c][r].clone()
    }
    if kv[i].nul[r] { return Val.Null }
    if t == BT_BOOL { return Val.Bool(kv[i].v[r] == 1) }
    if isDecT(t) { return lexdb_rows.decVal(kv[i].v[r], decSc(t)) }
    return Val.Int(kv[i].v[r])
}

// Row 0's keys as values (its range's equalities; it has them: rows
// without are not read).
fn rowKeys(jl: &JL, kv: &[]BVec, w: &Batch, z: &lexdb_time.Zone): Result[[]Val, DbErr] {
    var out: []Val = []
    for i in 0..len(jl.key) {
        match try keyOf(keyAt(jl, kv, w, i, 0), &jl.ktypes[i], z) {
            Some(x) { append(mut &out, x) }
            None { return Ok(out) }
        }
    }
    return Ok(out)
}

// v made a key of type typ as the row engine makes it (keyVal): None, out
// of the type's range (no row has it).
fn keyOf(v: Val, typ: &lexdb_sql.TypeName, z: &lexdb_time.Zone): Result[Option[Val], DbErr] {
    match lexdb_ops.coerceZ(v, typ, z) {
        Ok(x) { return Ok(Some(x)) }
        Err(x) {
            if x.state == "22003" { return Ok(None) }
            return Err(x)
        }
    }
}

// Sets up a join plan's levels for a run: the keys, conditions and WHERE
// conjuncts compiled over the query's columns, each hash built (its table
// read in batches, its own conditions applied), a lookup's or range's
// columns and bounds.
fn joinSetup(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, p: &lexdb_plan.PPlan, cols: &[]lexdb_sql.ColDef,
             tabs: &[]&lexdb_catalog.Table, srcs: &[]Src, vrows: &[][][]Val, cx: &Ctx, jr: mut &JRun, dec: bool, bud: mut &Budget,
             cnt: mut &[]Counts): Result[Unit, DbErr] {
    match p {
        lexdb_plan.PPlan.Join(i, j) {
            try joinSetup(st, txn, &i, cols, tabs, srcs, vrows, cx, jr, dec, bud, cnt)
            let sc = &j.scan
            let t = tabs[sc.level]
            var jl = newJL(j.how, sc.level, sc.first, len(t.cols))
            jl.left = j.kind == lexdb_sql.J_LEFT
            jl.right = j.kind == lexdb_sql.J_RIGHT
            jl.mark = j.mark
            jl.raw = j.how == lexdb_plan.JH_ROWS
            jl.resCol = j.resCol
            for k in 0..len(t.cols) { append(mut &jl.rkinds, jr.kinds[sc.first + k]) }
            var avail: []bool = array(jr.nq, false)
            for c in 0..jr.nq { avail[c] = jr.owner[c] >= 0 && jr.owner[c] < len(jr.jls) }
            for x in j.keys {
                let got = bCompileD(&x, cols, &jr.kinds, cx, 0, dec)
                if got.isNone() { return Err(batErr()) }
                let cc = got.unwrap()
                var col = -1
                match cc.n {
                    BNode.Col(c) { col = c }
                    else {}
                }
                if cc.typ == BT_OTHER && col < 0 { return Err(batErr()) }
                append(mut &jl.keyTyp, cc.typ)
                append(mut &jl.keyCol, col)
                append(mut &jl.key, takeN(cc))
            }
            readsOf(&j.keys, mut &jl.kreads)
            for c in 0..len(sc.need) { avail[sc.first + c] = sc.need[c] }
            for x in j.ktypes { append(mut &jl.ktypes, x) }
            let lvl = len(jr.jls)
            if len(j.res) > 0 {
                // a "<>" summary's outer value
                let got = bCompileD(&j.res[0], cols, &jr.kinds, cx, 0, dec)
                if got.isNone() { return Err(batErr()) }
                let cc = got.unwrap()
                if cc.typ != BT_INT && cc.typ != BT_BOOL { return Err(batErr()) }
                jl.resTyp = cc.typ
                jl.res = takeN(cc)
                readsOf(&j.res, mut &jl.kreads)
            }
            if j.how == lexdb_plan.JH_HASH || j.how == lexdb_plan.JH_ROWS {
                // one integer key of an integer column, no collation: by value; one text key of texts: by its text
                let hc = j.hcols[0]
                if len(j.keys) == 1 && jl.keyTyp[0] == BT_INT && jl.rkinds[hc] == BK_INT {
                    jl.mode = JK_INT
                } else if len(j.keys) == 1 && jl.keyTyp[0] == BT_OTHER && jl.keyCol[0] >= 0 {
                    let ho = t.cols[hc].typ.oid
                    let ko = cols[jl.keyCol[0]].typ.oid
                    if (ho == lexdb_sql.OID_TEXT || ho == lexdb_sql.OID_VARCHAR) && (ko == lexdb_sql.OID_TEXT || ko == lexdb_sql.OID_VARCHAR) { jl.mode = JK_TEXT }
                }
                try hashBuild(st, txn, t, &j, &srcs[sc.level], &vrows[sc.level], cols, cx, mut &jl, jr, dec, bud, mut &cnt[sc.level])
            } else {
                jl.bp = projOf(t, sc, &jr.kinds)
                var nNeed = 0
                for c in 0..len(sc.need) { if sc.need[c] { nNeed += 1 } }
                jl.perRow = 32 + 24 * nNeed
                jl.index = j.index
                jl.noNulls = j.noNulls
                if j.how == lexdb_plan.JH_RANGE {
                    var los: []Val = []
                    var his: []Val = []
                    let noAggs: []Val = []
                    let noRow: []Val = []
                    for b in j.rng {
                        let v0 = try bxEval(&b.val, &noRow, &noAggs, cx)
                        let v = try lexdb_ops.coerceZ(v0, &j.ktypes[len(j.keys)], &cx.zone)
                        if lexdb_ops.isNull(&v) {
                            jl.noRange = true
                            continue
                        }
                        if b.op == ">" || b.op == ">=" { append(mut &los, v) } else { append(mut &his, v) }
                    }
                    jl.tail = lexdb_access.tailOf(j.index, &los, &his, j.capNulls)
                    jl.los = los
                    jl.his = his
                }
            }
            for k in 0..len(j.conds) {
                // (the key's equality, when the hash compares by value: applied by the probe)
                if k == j.keq && jl.mode != JK_GEN { continue }
                match condNodeD(&j.conds[k], cols, &jr.kinds, cx, 0, &avail, dec) {
                    Some(n) { append(mut &jl.conds, n) }
                    None { return Err(batErr()) }
                }
            }
            for k in 0..len(j.conds) {
                if k == j.keq && jl.mode != JK_GEN { continue }
                readsOf1(&j.conds[k], mut &jl.creads)
            }
            for k in 0..len(j.post) {
                match condNodeD(&j.post[k], cols, &jr.kinds, cx, 0, &avail, dec) {
                    Some(n) { append(mut &jl.post, n) }
                    None { return Err(batErr()) }
                }
            }
            readsOf(&j.post, mut &jl.preads)
            append(mut &jr.jls, jl)
            return Ok(Unit{})
        }
        lexdb_plan.PPlan.Filter(i, _) { return joinSetup(st, txn, &i, cols, tabs, srcs, vrows, cx, jr, dec, bud, cnt) }
        lexdb_plan.PPlan.Scan(sc, _) {
            let t = tabs[sc.level]
            var jl = newJL(-1, sc.level, sc.first, len(t.cols))
            for k in 0..len(t.cols) { append(mut &jl.rkinds, jr.kinds[sc.first + k]) }
            append(mut &jr.jls, jl)
            return Ok(Unit{})
        }
        else { return Err(e("XX000", "a join plan the pipeline does not run")) }
    }
}

// Hashes reduced by the hashes after them (q7's and q21's supplier by
// their nation): where a later inner hash join's one integer key is a
// column of an earlier hash's table, the earlier hash's rows whose column
// that later hash does not hold can join nothing (every row the join
// gives passes the later level), so they are unlinked from their buckets
// (the first hash's keys also narrow the scan, joinRows' pushCol: a key
// whose bucket is empty drops its rows there). The levels from the earlier one to
// the later one must join by columns only, with no condition per
// candidate: a row dropped early must not be one whose condition would
// have raised an error (exactness).
var hashCuts: int = 0

fn reduceHashes(jr: mut &JRun) {
    // the last first: a hash cut by a later one cuts the earlier ones by what it keeps
    var j = len(jr.jls)
    while j > 2 {
        j -= 1
        let jh = jr.jls[j].how
        if !(jh == lexdb_plan.JH_HASH || jh == lexdb_plan.JH_ROWS) || jr.jls[j].mode != JK_INT || jr.jls[j].left || jr.jls[j].right ||
           jr.jls[j].mark == lexdb_plan.MK_ANTI || len(jr.jls[j].key) != 1 { continue }
        var c = -1
        match jr.jls[j].key[0] {
            BNode.Col(x) { c = x }
            else {}
        }
        if c < 0 { continue }
        // the level just before (the counts of the rows cut are then the
        // two levels'), keyed by one integer, a plain join
        let k = jr.owner[c]
        if k != j - 1 || k < 1 { continue }
        let kh = jr.jls[k].how
        if !(kh == lexdb_plan.JH_HASH || kh == lexdb_plan.JH_ROWS) || jr.jls[k].left || jr.jls[k].right || jr.jls[k].mode != JK_INT ||
           jr.jls[k].mark != lexdb_plan.MK_JOIN || jr.jls[k].resCol >= 0 { continue }
        var plain = true
        for m in k..j {
            let ml = &jr.jls[m]
            if len(ml.conds) > 0 || len(ml.post) > 0 || ml.resCol >= 0 { plain = false }
            for x in ml.key {
                match x {
                    BNode.Col(_) {}
                    else { plain = false }
                }
            }
        }
        if !plain { continue }
        let kc = c - jr.jls[k].first
        if kc < 0 || kc >= len(jr.jls[k].rows.cols) || jr.jls[k].rkinds[kc] != BK_INT { continue }
        // the earlier hash's rows the later one holds a key for, per row
        var live: []bool = array(jr.jls[k].rows.n, false)
        {
            let rows = &jr.jls[k].rows
            let held = &jr.jls[j].ints
            for r in 0..rows.n { live[r] = !rows.cols[kc].nul[r] && held.get(&rows.cols[kc].v[r]).isSome() }
        }
        hashCuts += cutRows(mut &jr.jls[k], &live, j)
    }
}

// jl's rows not live unlinked from their buckets (each bucket's order
// kept; a bucket left empty keeps its key). The rows cut.
fn cutRows(jl: mut &JL, live: &[]bool, to: int): int {
    var cut = 0
    var perB: []int = array(len(jl.head), 0)
    for b in 0..len(jl.head) {
        var r = jl.head[b]
        var first = -1
        var prev = -1
        while r >= 0 {
            let nx = jl.next[r]
            if live[r] {
                if prev < 0 { first = r } else { jl.next[prev] = r }
                prev = r
            } else {
                cut += 1
                perB[b] += 1
            }
            r = nx
        }
        if prev >= 0 { jl.next[prev] = -1 }
        jl.head[b] = first
    }
    if cut == 0 { return 0 }
    jl.cutTo = to
    jl.cutB = perB
    return cut
}

// A hash being built: its rows (by its table's columns), its buckets
// (per bucket its first and last row, per row the next of its bucket),
// and a "<>" summary's per bucket (more than one value, or its one value).
type Builder = record {
    rows: Batch
    head: []int
    tail: []int
    next: []int
    ints: Map[int, int]
    txts: Map[str, int]
    gens: Map[str, int]
    mixed: []bool
    single: []Val
    held: int
    kept: int
}

// Adds b's rows idx to a hash (its columns read by bp; its key columns
// hc, looked up as mode says, raw: by their values' own encoding, a
// subquery's rows); a NULL key's row joins nothing (kept, out of every
// bucket, for a RIGHT JOIN: keepAll). resCol >= 0: a "<>" summary,
// no row kept. room: past it max_statement_mem's error.
fn (bd: mut &Builder) add(b: &Batch, idx: &[]int, bp: &BPlan, hc: &[]int, mode: int, raw: bool, keepAll: bool, resCol: int,
                          room: int, maxHeld: int): Result[Unit, DbErr] {
    let ncol = len(bp.kinds)
    var kb = ""
    for r in idx {
        var bk = -1
        var nul = false
        if mode == JK_INT {
            let kc = &b.cols[hc[0]]
            if kc.nul[r] { nul = true } else {
                match bd.ints.get(&kc.v[r]) {
                    Some(x) { bk = x }
                    None {
                        bk = len(bd.head)
                        bd.ints.put(kc.v[r], bk)
                    }
                }
            }
        } else if mode == JK_TEXT && bp.kinds[hc[0]] == BK_TEXT {
            if b.cols[hc[0]].nul[r] { nul = true } else {
                let x = lexdb_rows.textAt(b, hc[0], r)
                match bd.txts.get(x) {
                    Some(y) { bk = y }
                    None {
                        bk = len(bd.head)
                        bd.txts.put(x.clone(), bk)
                    }
                }
            }
        } else if mode == JK_TEXT {
            if b.cols[hc[0]].nul[r] { nul = true } else {
                match b.vals[hc[0]][r] {
                    Val.Text(x) {
                        match bd.txts.get(&x) {
                            Some(y) { bk = y }
                            None {
                                bk = len(bd.head)
                                bd.txts.put(x.clone(), bk)
                            }
                        }
                    }
                    else { return Err(batErr()) }
                }
            }
        } else {
            kb.clear()
            for k in 0..len(hc) {
                let v = if b.cols[hc[k]].nul[r] { Val.Null } else { bValAt(b, hc[k], bp.kinds[hc[k]], r) }
                if lexdb_ops.isNull(&v) { nul = true }
                if raw { keyPart(mut &kb, &v) } else { lexdb_access.encIdxPart(mut &kb, &v) }
            }
            if !nul {
                match bd.gens.get(&kb) {
                    Some(x) { bk = x }
                    None {
                        bk = len(bd.head)
                        bd.gens.put(kb.clone(), bk)
                    }
                }
            }
        }
        if nul && !keepAll { continue }
        if bk == len(bd.head) {
            append(mut &bd.head, -1)
            append(mut &bd.tail, -1)
            append(mut &bd.mixed, false)
            append(mut &bd.single, Val.Null)
        }
        bd.kept += 1
        if resCol >= 0 {
            // a summary is all a probe reads: no row kept (q21's shape)
            if bk >= 0 && !b.cols[resCol].nul[r] {
                let rv = bValAt(b, resCol, bp.kinds[resCol], r)
                if lexdb_ops.isNull(&bd.single[bk]) {
                    bd.single[bk] = rv
                } else {
                    match lexdb_ops.compare(&bd.single[bk], &rv) {
                        Ok(c) { if c != 0 { bd.mixed[bk] = true } }
                        Err(_) {}
                    }
                }
            }
            continue
        }
        // the row, at the end of its bucket
        let at = bd.rows.n
        for ci in 0..ncol {
            if !bp.needCol[ci] { continue }
            if bp.kinds[ci] == BK_TEXT {
                // the text's bytes into the hash's buffer, its place there
                var w = 0
                if !b.cols[ci].nul[r] {
                    let t = lexdb_rows.textAt(b, ci, r)
                    w = (len(bd.rows.txt[ci]) << 24) | len(t)
                    bd.rows.txt[ci] += t
                    bd.held += len(t)
                }
                append(mut &bd.rows.cols[ci].v, w)
                append(mut &bd.rows.cols[ci].nul, b.cols[ci].nul[r])
                continue
            }
            append(mut &bd.rows.cols[ci].v, b.cols[ci].v[r])
            append(mut &bd.rows.cols[ci].nul, b.cols[ci].nul[r])
            if bp.kinds[ci] == BK_VAL {
                append(mut &bd.rows.vals[ci], b.vals[ci][r].clone())
                match b.vals[ci][r] {
                    Val.Text(x) { bd.held += len(x) }
                    else {}
                }
            }
        }
        bd.held += 32 + 24 * ncol
        if room >= 0 && bd.held > room { return Err(memErr(maxHeld)) }
        bd.rows.n += 1
        append(mut &bd.next, -1)
        if bk >= 0 {
            if bd.tail[bk] >= 0 { bd.next[bd.tail[bk]] = at } else { bd.head[bk] = at }
            bd.tail[bk] = at
        }
    }
    return Ok(Unit{})
}

// Builds a hash join's table (j over table t, read as src says; JH_ROWS:
// the rows vrows of its subquery): its rows its own conditions keep, by
// their key, NULL keys left out (a RIGHT JOIN's kept), as materialize
// keeps them (built: rows read; kept: rows hashed).
fn hashBuild(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &lexdb_catalog.Table, j: &lexdb_plan.PJoin, src: &Src,
             vrows: &[][]Val, cols: &[]lexdb_sql.ColDef, cx: &Ctx, jl: mut &JL, jr: &JRun, dec: bool, bud: mut &Budget,
             c: mut &Counts): Result[Unit, DbErr] {
    hashBuilds += 1
    let sc = &j.scan
    let bp = projOf(t, sc, &jr.kinds)
    var conds: []BNode = []
    for x in j.build {
        match condNodeD(&x, cols, &jr.kinds, cx, sc.first, &sc.need, dec) {
            Some(n) { append(mut &conds, n) }
            None { return Err(batErr()) }
        }
    }
    var rows0 = lexdb_rows.newBatch(&bp, 0)
    rows0.n = 0
    var bd = Builder{rows: rows0, head: [], tail: [], next: [], ints: newMap(), txts: newMap(), gens: newMap(), mixed: [], single: [],
                     held: 0, kept: 0}
    let mode = jl.mode
    let raw = j.how == lexdb_plan.JH_ROWS
    let keepAll = jl.right
    let room = bud.room()
    let maxHeld = bud.maxHeld
    var nread = 0
    if raw {
        // a subquery's rows (Val), a batch of them at a time
        var at = 0
        while at < len(vrows) {
            var b = lexdb_rows.newBatch(&bp, lexdb_rows.BROWS)
            b.n = 0
            while at < len(vrows) && b.n < lexdb_rows.BROWS {
                for ci in 0..len(bp.kinds) {
                    if !bp.needCol[ci] { continue }
                    let v = if ci < len(vrows[at]) { vrows[at][ci].clone() } else { Val.Null }
                    if !lexdb_rows.put(mut &b, ci, b.n, v, bp.kinds[ci]) { return Err(batErr()) }
                }
                b.n += 1
                at += 1
            }
            var idx: []int = withCapacity(b.n)
            for r in 0..b.n { append(mut &idx, r) }
            nread += b.n
            let kept = try pick(&conds, &b, idx)
            try bd.add(&b, &kept, &bp, &j.hcols, mode, true, keepAll, j.resCol, room, maxHeld)
        }
    } else {
        let none: Map[int, int] = newMap()
        let noInts: []int = []
        let ph = PushH{keys: &none, head: &noInts, cutB: &noInts}
        var rc = RC{read: 0, kept: 0, batches: 0, pushed: 0, cut: 0}
        let stop = try readRows(st, txn, t, sc, src, &bp, &conds, -1, &ph, false, mut &rc,
                                fn(tx: mut &lexdb_store.Txn, b: mut &Batch, idx: []int, raw2: bool): Result[bool, DbErr] {
            try bd.add(b, &idx, &bp, &j.hcols, mode, false, keepAll, j.resCol, room, maxHeld)
            return Ok(true)
        })
        nread = rc.read
    }
    try bud.tickN(nread)
    try bud.hold(bd.held)
    c.built += nread
    c.kept += bd.kept
    jl.rows = replace(mut &bd.rows, lexdb_rows.noRows())
    jl.head = replace(mut &bd.head, [])
    jl.next = replace(mut &bd.next, [])
    jl.ints = replace(mut &bd.ints, newMap())
    jl.txts = replace(mut &bd.txts, newMap())
    jl.gens = replace(mut &bd.gens, newMap())
    jl.mixed = replace(mut &bd.mixed, [])
    jl.single = replace(mut &bd.single, [])
    return Ok(Unit{})
}

// The rest of a chunk's join from level j: at, per level before it, its
// rows' places (n rows). At the end the consumer's columns are gathered
// and the joined rows given to out. false: stop.
fn joinFrom(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, jr: &JRun, js: mut &JState, tabs: &[]&lexdb_catalog.Table, j: int,
            at: &[][]int, n: int, cx: &Ctx, bud: mut &Budget, cnt: mut &[]Counts, one: bool,
            out: &fn(mut &lexdb_store.Txn, mut &Batch): Result[bool, DbErr]): Result[bool, DbErr] {
    if n == 0 { return Ok(true) }
    if j == len(jr.jls) {
        // (a chunk joined again row by row: the rows already given skipped)
        if js.sk.skip >= n {
            js.sk.skip -= n
            return Ok(true)
        }
        var f = gatherAt(jr, &js.cur, &at, n, &jr.wantList)
        let go = try out(txn, mut &f)
        js.sk.given += n
        return Ok(go)
    }
    if one && n > 1 {
        // row by row: each row's joins and its consumer's before the next row's
        for r in 0..n {
            let one1: []int = [r]
            if !(try joinFrom(st, txn, jr, js, tabs, j, compose(&at, &one1), 1, cx, bud, cnt, one, out)) { return Ok(false) }
        }
        return Ok(true)
    }
    let jl = &jr.jls[j]
    let lv = jl.level
    let w = gatherAt(jr, &js.cur, &at, n, &jl.kreads)
    let kv = try keyVecs(jl, &w)
    var pj: []int = withCapacity(n)
    var pi: []int = withCapacity(n)
    var held = 0
    if hashed(jl) {
        // a "<>" summary's outer value
        var rv = lexdb_rows.bvec(0)
        if jl.resCol >= 0 {
            var all: []int = withCapacity(n)
            for r in 0..n { append(mut &all, r) }
            rv = try bEval(&jl.res, &w, &all)
        }
        // a semi join with no condition: its first match only
        let first = jl.mark == lexdb_plan.MK_SEMI && len(jl.conds) == 0
        // (per chunk: a text key's column BK_TEXT)
        let wtxt = jl.mode == JK_TEXT && lexdb_rows.isTextCol(&w, jl.keyCol[0])
        var kb = ""
        for r in 0..n {
            var bk = -1
            if jl.mode == JK_INT {
                if !kv[0].nul[r] {
                    match jl.ints.get(&kv[0].v[r]) {
                        Some(x) { bk = x }
                        None {}
                    }
                    if bk >= 0 && jl.cutTo >= 0 {
                        // the rows the next level's hash cut: as if read, joined and probed there
                        let m = jl.cutB[bk]
                        cnt[lv].read += m
                        cnt[lv].joined += m
                        cnt[jr.jls[jl.cutTo].level].starts += m
                    }
                }
            } else if jl.mode == JK_TEXT {
                let c = jl.keyCol[0]
                if !w.cols[c].nul[r] && wtxt {
                    match jl.txts.get(lexdb_rows.textAt(&w, c, r)) {
                        Some(y) { bk = y }
                        None {}
                    }
                } else if !w.cols[c].nul[r] {
                    match w.vals[c][r] {
                        Val.Text(x) {
                            match jl.txts.get(&x) {
                                Some(y) { bk = y }
                                None {}
                            }
                        }
                        else { return Err(batErr()) }
                    }
                }
            } else {
                kb.clear()
                var nul = false
                for i in 0..len(jl.key) {
                    if jl.raw {
                        // a subquery's rows: by the value's own encoding (keyPart)
                        let v = keyAt(jl, &kv, &w, i, r)
                        if lexdb_ops.isNull(&v) { nul = true }
                        keyPart(mut &kb, &v)
                        continue
                    }
                    match try keyOf(keyAt(jl, &kv, &w, i, r), &jl.ktypes[i], &jr.zone) {
                        Some(x) {
                            if lexdb_ops.isNull(&x) { nul = true }
                            lexdb_access.encIdxPart(mut &kb, &x)
                        }
                        None { nul = true }
                    }
                }
                if !nul {
                    match jl.gens.get(&kb) {
                        Some(x) { bk = x }
                        None {}
                    }
                }
            }
            if jl.resCol >= 0 {
                // a NULL outer value is "<>" no value: never a match (as the
                // row engine); a hit is a candidate without a row
                if bk >= 0 && !rv.nul[r] {
                    var hit = jl.mixed[bk]
                    if !hit {
                        let sm = &jl.single[bk]
                        if !lexdb_ops.isNull(sm) {
                            let ov = if jl.resTyp == BT_BOOL { Val.Bool(rv.v[r] != 0) } else { Val.Int(rv.v[r]) }
                            if (try lexdb_ops.compare(sm, &ov)) != 0 { hit = true }
                        }
                    }
                    if hit {
                        append(mut &pj, r)
                        append(mut &pi, -1)
                    }
                }
                // (each row probed is read once, as the row engine reads a summary)
                if !(bk >= 0 && !rv.nul[r] && len(pj) > 0 && pj[len(pj) - 1] == r) { cnt[lv].read += 1 }
                continue
            }
            if bk >= 0 {
                var x = jl.head[bk]
                while x >= 0 {
                    append(mut &pj, r)
                    append(mut &pi, x)
                    x = if first { -1 } else { jl.next[x] }
                }
            }
        }
        cnt[lv].starts += n
    } else {
        // a lookup or a range per row: each row's key made as the row
        // engine makes it (keyVal, encPart), the keys read at once
        let t = tabs[lv]
        let rel = lexdb_catalog.relOf(t)
        let look = jl.how == lexdb_plan.JH_LOOK
        var pr = lexdb_access.probes(if look { -1 } else { jl.index }, n)
        var of: []int = withCapacity(n)
        let o0 = if len(jl.ktypes) > 0 { jl.ktypes[0].oid } else { 0 }
        let intKey = look && len(jl.key) == 1 && jl.keyTyp[0] == BT_INT && jl.ktypes[0].kind == lexdb_sql.K_INT &&
                     (o0 == lexdb_sql.OID_INT2 || o0 == lexdb_sql.OID_INT4 || o0 == lexdb_sql.OID_INT8)
        let kmin = if o0 == lexdb_sql.OID_INT2 { -32768 } else if o0 == lexdb_sql.OID_INT4 { -2147483648 } else { -9223372036854775807 - 1 }
        let kmax = if o0 == lexdb_sql.OID_INT2 { 32767 } else if o0 == lexdb_sql.OID_INT4 { 2147483647 } else { 9223372036854775807 }
        var prev = 0
        for r in 0..n {
            if intKey {
                if kv[0].nul[r] { continue }
                let x = kv[0].v[r]
                if x < kmin || x > kmax { continue }
                if pr.count() > 0 && x == prev { pr.again() } else {
                    pr.intKey(x)
                    prev = x
                }
                append(mut &of, r)
                continue
            }
            var none = false
            for i in 0..len(jl.key) {
                match try keyOf(keyAt(jl, &kv, &w, i, r), &jl.ktypes[i], &jr.zone) {
                    Some(x) { if lexdb_ops.isNull(&x) { none = true } else { pr.part(&x) } }
                    None { none = true }
                }
                if none { break }
            }
            if none {
                pr.clear()
                continue
            }
            pr.end()
            append(mut &of, r)
        }
        let nk = pr.count()
        if look {
            let fetched = match try lexdb_access.fetchMany(st, txn, &rel, &pr, true, &jl.bp) {
                Some(f) { f }
                None { return Err(batErr()) }
            }
            var f2 = fetched
            js.cur[j] = replace(mut &f2.rows, lexdb_rows.noRows())
            for i in 0..nk {
                let ri = f2.at[i]
                if ri < 0 { continue }
                append(mut &pj, of[i])
                append(mut &pi, ri)
            }
        } else {
            // the rows read are held while the chunk is joined, against
            // max_statement_mem: past it the chunk is joined in halves
            let room0 = if bud.maxHeld > 0 { bud.maxHeld - bud.held - bud.aside } else { -1 }
            // (a semi or anti join with no condition: a range's first row only)
            let one1 = jl.mark != lexdb_plan.MK_JOIN && len(jl.conds) == 0
            let got = try lexdb_access.rangeMany(st, txn, &rel, jl.index, &pr, &jl.tail, jl.noRange, one1, &jl.bp, true, room0, jl.perRow)
            if got.isNone() {
                if n == 1 {
                    if room0 < 0 { return Err(batErr()) }
                    // its one range read in pieces, as the row engine reads it
                    return rangeOne(st, txn, jr, js, tabs, j, &at, &(try rowKeys(jl, &kv, &w, &jr.zone)), cx, bud, cnt, out)
                }
                var lo: []int = []
                var hi: []int = []
                for r in 0..n { if r < n / 2 { append(mut &lo, r) } else { append(mut &hi, r) } }
                if !(try joinFrom(st, txn, jr, js, tabs, j, compose(&at, &lo), len(lo), cx, bud, cnt, one, out)) { return Ok(false) }
                return joinFrom(st, txn, jr, js, tabs, j, compose(&at, &hi), len(hi), cx, bud, cnt, one, out)
            }
            var rg = got.unwrap()
            let rows = replace(mut &rg.rows, lexdb_rows.noRows())
            held = (rows.n + rg.pks) * jl.perRow
            for c in 0..len(jl.bp.needCol) {
                if jl.bp.needCol[c] && jl.bp.kinds[c] == BK_TEXT { held += len(rows.txt[c]) }
                if !jl.bp.needCol[c] || jl.bp.kinds[c] != BK_VAL { continue }
                for r in 0..rows.n {
                    match rows.vals[c][r] {
                        Val.Text(tx) { held += len(tx) }
                        else {}
                    }
                }
            }
            if room0 >= 0 && held > room0 {
                if n == 1 { return rangeOne(st, txn, jr, js, tabs, j, &at, &(try rowKeys(jl, &kv, &w, &jr.zone)), cx, bud, cnt, out) }
                var lo: []int = []
                var hi: []int = []
                for r in 0..n { if r < n / 2 { append(mut &lo, r) } else { append(mut &hi, r) } }
                if !(try joinFrom(st, txn, jr, js, tabs, j, compose(&at, &lo), len(lo), cx, bud, cnt, one, out)) { return Ok(false) }
                return joinFrom(st, txn, jr, js, tabs, j, compose(&at, &hi), len(hi), cx, bud, cnt, one, out)
            }
            try bud.tickN(rows.n)
            for i in 0..nk {
                for x in rg.lo[i]..rg.hi[i] {
                    append(mut &pj, of[i])
                    append(mut &pi, x)
                }
            }
            js.cur[j] = rows
            if jl.mark == lexdb_plan.MK_JOIN { rangeJoinChunks += 1 }
        }
        cnt[lv].starts += n
    }
    bud.held += held
    if one {
        // n is 1: its candidates in order, each joined on before the next
        // (its conditions evaluated only for the candidates reached)
        let go = tailOne(st, txn, jr, js, tabs, j, &at, &pj, &pi, cx, bud, cnt, out)
        bud.held -= held
        return go
    }
    let next = joinTail(jr, js, j, &at, n, &pj, pi, bud, cnt)
    if next.isErr() { bud.held -= held }
    let at2 = try next
    let n2 = len(at2[0])
    let go = joinFrom(st, txn, jr, js, tabs, j + 1, at2, n2, cx, bud, cnt, false, out)
    bud.held -= held
    return go
}

// What a chunk's join gave its consumer (given rows), and how many of
// them a second, row-by-row join of the chunk skips (skip).
type Skip = record { skip: int; given: int }

// A join run's state: per level its rows for the chunk (the scan's batch,
// a lookup's or range's rows), a RIGHT JOIN's rows that joined, the skip.
type JState = record { cur: []Batch; seen: []bool; sk: Skip }

// One row's candidates at level j (pj all 0, pi their rows), as the row
// engine tries them: each one's conditions, then the levels after it for
// it, before the next; a LEFT JOIN's NULL row after them if none joined;
// the WHERE conjuncts after it on each row it gives.
fn tailOne(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, jr: &JRun, js: mut &JState, tabs: &[]&lexdb_catalog.Table, j: int,
           at: &[][]int, pj: &[]int, pi: &[]int, cx: &Ctx, bud: mut &Budget, cnt: mut &[]Counts,
           out: &fn(mut &lexdb_store.Txn, mut &Batch): Result[bool, DbErr]): Result[bool, DbErr] {
    var any = false
    var done = false
    if !(try tailCands(st, txn, jr, js, tabs, j, at, pi, cx, bud, cnt, mut &any, mut &done, out)) { return Ok(false) }
    if done { return Ok(true) }
    return tailEnd(st, txn, jr, js, tabs, j, at, any, cx, bud, cnt, out)
}

// The candidates pi of one row (at) in order, each joined on before the
// next; any: one joined; done: a semi or anti join decided.
fn tailCands(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, jr: &JRun, js: mut &JState, tabs: &[]&lexdb_catalog.Table, j: int,
             at: &[][]int, pi: &[]int, cx: &Ctx, bud: mut &Budget, cnt: mut &[]Counts, any: mut &bool, done: mut &bool,
             out: &fn(mut &lexdb_store.Txn, mut &Batch): Result[bool, DbErr]): Result[bool, DbErr] {
    let jl = &jr.jls[j]
    let lv = jl.level
    let zero: []int = [0]
    for c in 0..len(pi) {
        cnt[lv].read += 1
        try bud.tick()
        var atc = compose(at, &zero)
        append(mut &atc, [pi[c]])
        if len(jl.conds) > 0 {
            let w = gatherAt(jr, &js.cur, &atc, 1, &jl.creads)
            if len(try pick(&jl.conds, &w, [0])) == 0 { continue }
        }
        if jl.right && pi[c] >= 0 { js.seen[pi[c]] = true }
        cnt[lv].joined += 1
        any = true
        // an anti join drops the row; a semi join gives it once
        if jl.mark == lexdb_plan.MK_ANTI {
            done = true
            return Ok(true)
        }
        if !(try postOne(st, txn, jr, js, tabs, j, atc, cx, bud, cnt, out)) { return Ok(false) }
        if jl.mark == lexdb_plan.MK_SEMI {
            done = true
            return Ok(true)
        }
    }
    return Ok(true)
}

// After one row's candidates: an anti join's row if none joined, a LEFT
// JOIN's NULL row.
fn tailEnd(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, jr: &JRun, js: mut &JState, tabs: &[]&lexdb_catalog.Table, j: int,
           at: &[][]int, any: bool, cx: &Ctx, bud: mut &Budget, cnt: mut &[]Counts,
           out: &fn(mut &lexdb_store.Txn, mut &Batch): Result[bool, DbErr]): Result[bool, DbErr] {
    let jl = &jr.jls[j]
    let zero: []int = [0]
    if any { return Ok(true) }
    if jl.mark == lexdb_plan.MK_ANTI || jl.left {
        if jl.left { cnt[jl.level].nulls += 1 }
        var atn = compose(at, &zero)
        append(mut &atn, [-1])
        return postOne(st, txn, jr, js, tabs, j, atn, cx, bud, cnt, out)
    }
    return Ok(true)
}

// One row's range (eqs, then the level's bounds) read in pieces (fetch)
// where its rows are past the statement's memory as one batch: each
// piece's rows its candidates in order, as the row engine reads a range.
fn rangeOne(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, jr: &JRun, js: mut &JState, tabs: &[]&lexdb_catalog.Table, j: int,
            at: &[][]int, eqs: &[]Val, cx: &Ctx, bud: mut &Budget, cnt: mut &[]Counts,
            out: &fn(mut &lexdb_store.Txn, mut &Batch): Result[bool, DbErr]): Result[bool, DbErr] {
    let jl = &jr.jls[j]
    let rel = lexdb_catalog.relOf(tabs[jl.level])
    cnt[jl.level].starts += 1
    let sc = lexdb_access.rangeScan(&rel, jl.index, eqs, &jl.los, &jl.his, jl.noNulls)
    var cur = lexdb_access.newCursor()
    var any = false
    var done = false
    while !cur.done && !done {
        var rows: [][]Val = []
        try lexdb_access.fetch(st, txn, &rel, jl.index, false, &sc, &jl.bp.needCol, mut &cur, mut &rows)
        var b = lexdb_rows.newBatch(&jl.bp, len(rows))
        b.n = len(rows)
        for r in 0..len(rows) {
            for c in 0..len(jl.bp.kinds) {
                if !jl.bp.needCol[c] { continue }
                let v = if c < len(rows[r]) { replace(mut &rows[r][c], Val.Null) } else { Val.Null }
                if !lexdb_rows.put(mut &b, c, r, v, jl.bp.kinds[c]) { return Err(batErr()) }
            }
        }
        var pi: []int = withCapacity(b.n)
        for r in 0..b.n { append(mut &pi, r) }
        js.cur[j] = b
        if !(try tailCands(st, txn, jr, js, tabs, j, at, &pi, cx, bud, cnt, mut &any, mut &done, out)) { return Ok(false) }
    }
    if done { return Ok(true) }
    return tailEnd(st, txn, jr, js, tabs, j, at, any, cx, bud, cnt, out)
}

// One joined row of level j: its WHERE conjuncts after it, then on.
fn postOne(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, jr: &JRun, js: mut &JState, tabs: &[]&lexdb_catalog.Table, j: int,
           at: [][]int, cx: &Ctx, bud: mut &Budget, cnt: mut &[]Counts,
           out: &fn(mut &lexdb_store.Txn, mut &Batch): Result[bool, DbErr]): Result[bool, DbErr] {
    let jl = &jr.jls[j]
    if len(jl.post) > 0 {
        let w = gatherAt(jr, &js.cur, &at, 1, &jl.preads)
        if len(try pick(&jl.post, &w, [0])) == 0 { return Ok(true) }
    }
    return joinFrom(st, txn, jr, js, tabs, j + 1, at, 1, cx, bud, cnt, true, out)
}

// Chunks joined to a range per row (the tests' look).
var rangeJoinChunks: int = 0

pub fn hashCutRows(): int { return hashCuts }

pub fn rangeJoins(): int { return rangeJoinChunks }

// A level's candidates (per candidate, its row before pj and its row of
// the level's pi) as the rows it gives: its conditions over them, a LEFT
// JOIN's NULL rows, its WHERE conjuncts. The rows' places per level.
fn joinTail(jr: &JRun, js: mut &JState, j: int, at: &[][]int, n: int, pj: &[]int, pi: []int, bud: mut &Budget,
            cnt: mut &[]Counts): Result[[][]int, DbErr] {
    let jl = &jr.jls[j]
    let lv = jl.level
    let nc = len(pj)
    try bud.tickN(nc)
    var cat = compose(at, pj)
    append(mut &cat, pi)
    var keep: []int = withCapacity(nc)
    for x in 0..nc { append(mut &keep, x) }
    if len(jl.conds) > 0 {
        let w = gatherAt(jr, &js.cur, &cat, nc, &jl.creads)
        keep = try pick(&jl.conds, &w, keep)
    }
    if jl.mark == lexdb_plan.MK_JOIN {
        cnt[lv].read += nc
    } else {
        // a semi or anti join's: as the row engine reads them, up to each
        // row's first passing candidate
        var ki = 0
        var doneRow = -1
        for x in 0..nc {
            if pj[x] == doneRow { continue }
            cnt[lv].read += 1
            while ki < len(keep) && keep[ki] < x { ki += 1 }
            if ki < len(keep) && keep[ki] == x { doneRow = pj[x] }
        }
    }
    // a RIGHT JOIN's rows that joined
    if jl.right { for x in keep { if cat[j][x] >= 0 { js.seen[cat[j][x]] = true } } }
    var outAt: [][]int = []
    if jl.mark == lexdb_plan.MK_ANTI {
        // the outer rows with no passing candidate, once; joined: those
        // with one (dropped)
        var have: []bool = array(n, false)
        for x in keep {
            if !have[pj[x]] { cnt[lv].joined += 1 }
            have[pj[x]] = true
        }
        var aj: []int = []
        for r in 0..n { if !have[r] { append(mut &aj, r) } }
        outAt = compose(at, &aj)
        append(mut &outAt, array(len(aj), -1))
    } else if jl.mark == lexdb_plan.MK_SEMI {
        // its first passing candidate per outer row, as the row engine stops
        var fst: []int = []
        var prev = -1
        for x in keep {
            if pj[x] != prev {
                append(mut &fst, x)
                prev = pj[x]
            }
        }
        cnt[lv].joined += len(fst)
        outAt = compose(&cat, &fst)
    } else if jl.left {
        cnt[lv].joined += len(keep)
        var outJ: []int = withCapacity(n)
        var outI: []int = withCapacity(n)
        var k = 0
        for r in 0..n {
            var any = false
            while k < len(keep) && pj[keep[k]] == r {
                append(mut &outJ, r)
                append(mut &outI, cat[j][keep[k]])
                any = true
                k += 1
            }
            if !any {
                append(mut &outJ, r)
                append(mut &outI, -1)
                cnt[lv].nulls += 1
            }
        }
        outAt = compose(at, &outJ)
        append(mut &outAt, outI)
    } else if len(keep) == nc {
        cnt[lv].joined += len(keep)
        outAt = cat
    } else {
        cnt[lv].joined += len(keep)
        outAt = compose(&cat, &keep)
    }
    if len(jl.post) > 0 {
        let m = len(outAt[0])
        let w = gatherAt(jr, &js.cur, &outAt, m, &jl.preads)
        var all: []int = withCapacity(m)
        for x in 0..m { append(mut &all, x) }
        let k2 = try pick(&jl.post, &w, all)
        if len(k2) < m { outAt = compose(&outAt, &k2) }
    }
    return Ok(outAt)
}

// Runs a join plan's tables (top: the Join arms over Filter? (Scan)) in
// chunks, the joined rows given to out as batches of the query's columns
// (kinds; owner: per column the level holding it), want's columns
// gathered. dec: numerics as units.
fn joinRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, top: &lexdb_plan.PPlan, cols: &[]lexdb_sql.ColDef,
            tabs: &[]&lexdb_catalog.Table, srcs: &[]Src, vrows: &[][][]Val, cx: &Ctx, dec: bool, kinds: []int, owner: []int, want: []bool, exact: bool,
            bud: mut &Budget, cnt: mut &[]Counts, out: &fn(mut &lexdb_store.Txn, mut &Batch): Result[bool, DbErr]): Result[Unit, DbErr] {
    let nq = len(cols)
    var wl: []int = []
    for c in 0..len(want) { if want[c] { append(mut &wl, c) } }
    var jr = JRun{jls: [], kinds: kinds, owner: owner, want: want, wantList: wl, nq: nq, zone: cx.zone.clone()}
    try joinSetup(st, txn, top, cols, tabs, srcs, vrows, cx, mut &jr, dec, bud, cnt)
    reduceHashes(mut &jr)
    let bottom = joinBottom(top)
    let none: []BX = []
    let conds = match bottom {
        lexdb_plan.PPlan.Filter(_, cs) { &cs }
        else { &none }
    }
    let sc = match bottom {
        lexdb_plan.PPlan.Filter(i, _) {
            match i {
                lexdb_plan.PPlan.Scan(s, _) { &s }
                else { return Err(e("XX000", "a join plan without its scan")) }
            }
        }
        lexdb_plan.PPlan.Scan(s, _) { &s }
        else { return Err(e("XX000", "a join plan without its scan")) }
    }
    let t = tabs[sc.level]
    let bp = projOf(t, sc, &jr.kinds)
    var cn: []BNode = []
    for x in conds {
        match condNodeD(&x, cols, &jr.kinds, cx, sc.first, &sc.need, dec) {
            Some(n) { append(mut &cn, n) }
            None { return Err(batErr()) }
        }
    }
    // the first hash join's one integer key, a column of the scan: its
    // rows not in the hash are dropped as the scan reads them
    var pushCol = -1
    if len(jr.jls) > 1 && jr.jls[1].how == lexdb_plan.JH_HASH && jr.jls[1].mode == JK_INT && !jr.jls[1].left {
        match jr.jls[1].key[0] {
            BNode.Col(c) { if jr.owner[c] == 0 { pushCol = c - sc.first } }
            else {}
        }
    }
    cnt[sc.level].starts += 1
    var js = JState{cur: [], seen: [], sk: Skip{skip: 0, given: 0}}
    for i in 0..len(jr.jls) { append(mut &js.cur, lexdb_rows.noRows()) }
    // a RIGHT JOIN's rows that joined (at most one)
    var rightAt = -1
    for i in 0..len(jr.jls) {
        if jr.jls[i].right {
            rightAt = i
            js.seen = array(jr.jls[i].rows.n, false)
        }
    }
    var rc = RC{read: 0, kept: 0, batches: 0, pushed: 0, cut: 0}
    let pl = &jr.jls[if pushCol >= 0 { 1 } else { 0 }]
    let ph = PushH{keys: &pl.ints, head: &pl.head, cutB: &pl.cutB}
    var rawKept = 0
    let stopped = try readRows(st, txn, t, sc, &srcs[sc.level], &bp, &cn, pushCol, &ph, exact, mut &rc,
                               fn(tx: mut &lexdb_store.Txn, b: mut &Batch, idx: []int, raw: bool): Result[bool, DbErr] {
        joinChunks += 1
        try bud.tickN(b.n)
        js.cur[0] = replace(b, lexdb_rows.noRows())
        let got = joinChunk(st, tx, &jr, mut &js, tabs, &cn, idx, raw, exact, cx, bud, cnt, mut &rawKept, out)
        // (the batch back to the scan, used again)
        b = replace(mut &js.cur[0], lexdb_rows.noRows())
        return got
    })
    cnt[sc.level].joined += rawKept
    if rightAt >= 0 && !stopped {
        // a RIGHT JOIN's rows that joined nothing, with NULLs for the
        // tables before it, its WHERE conjuncts after it, then joined with
        // the tables after it (as runQuery adds them)
        let jl = &jr.jls[rightAt]
        let total = len(js.seen)
        var x = 0
        while x < total {
            var idx: []int = []
            while x < total && len(idx) < lexdb_rows.BROWS {
                if !js.seen[x] { append(mut &idx, x) }
                x += 1
            }
            let n = len(idx)
            if n == 0 { continue }
            cnt[jl.level].unmatched += n
            try bud.tickN(n)
            var at: [][]int = []
            for l in 0..rightAt { append(mut &at, array(n, -1)) }
            append(mut &at, idx)
            if len(jl.post) > 0 {
                let w = gatherAt(&jr, &js.cur, &at, n, &jl.preads)
                var all: []int = withCapacity(n)
                for r in 0..n { append(mut &all, r) }
                let k2 = try pick(&jl.post, &w, all)
                if len(k2) < n { at = compose(&at, &k2) }
            }
            let m = len(at[0])
            js.sk.skip = 0
            if !(try joinFrom(st, txn, &jr, mut &js, tabs, rightAt + 1, at, m, cx, bud, cnt, false, out)) { break }
        }
    }
    cnt[sc.level].read += rc.read
    cnt[sc.level].joined += rc.kept
    cnt[sc.level].batches += rc.batches
    if pushCol >= 0 {
        cnt[jr.jls[1].level].starts += rc.pushed
        pushDrops += rc.pushed
        if rc.cut > 0 {
            // the rows the next hash cut from the first (reduceHashes)
            cnt[jr.jls[1].level].read += rc.cut
            cnt[jr.jls[1].level].joined += rc.cut
            cnt[jr.jls[jr.jls[1].cutTo].level].starts += rc.cut
        }
    }
    return Ok(Unit{})
}

// One chunk of the first table (its rows idx in js.cur[0]; raw: its
// conditions not yet applied, an error among them) joined on: an
// expression's error joins it again row by row where exact.
fn joinChunk(st: &lexdb_store.Store, tx: mut &lexdb_store.Txn, jr: &JRun, js: mut &JState, tabs: &[]&lexdb_catalog.Table, cn: &[]BNode,
             idx: []int, raw: bool, exact: bool, cx: &Ctx, bud: mut &Budget, cnt: mut &[]Counts, rawKept: mut &int,
             out: &fn(mut &lexdb_store.Txn, mut &Batch): Result[bool, DbErr]): Result[bool, DbErr] {

        js.sk.skip = 0
        js.sk.given = 0
        if raw {
            // its conditions gave an error on one of its rows: row by row
            for r in 0..js.cur[0].n {
                let k = try pick(cn, &js.cur[0], [r])
                if len(k) == 0 { continue }
                rawKept += 1
                var at1: [][]int = []
                append(mut &at1, [r])
                if !(try joinFrom(st, tx, jr, js, tabs, 1, at1, 1, cx, bud, cnt, true, out)) { return Ok(false) }
            }
            return Ok(true)
        }
        let n = len(idx)
        var at: [][]int = []
        append(mut &at, collections.copyOf(&idx))
        if !exact { return joinFrom(st, tx, jr, js, tabs, 1, at, n, cx, bud, cnt, false, out) }
        let c0 = collections.copyOf(cnt)
        let h0 = bud.held
        match joinFrom(st, tx, jr, js, tabs, 1, at, n, cx, bud, cnt, false, out) {
            Ok(go) { return Ok(go) }
            Err(x) {
                if isBat(&x) || x.state == "53200" || x.state == "57014" || isSpill(&x) { return Err(x) }
                // an expression's error: the chunk again row by row, as the
                // row engine joins (the rows given skipped; one past a LIMIT
                // not reached)
                for i in 0..len(c0) { cnt[i] = c0[i] }
                bud.held = h0
                js.sk.skip = js.sk.given
                js.sk.given = 0
                var at2: [][]int = []
                append(mut &at2, idx)
                return joinFrom(st, tx, jr, js, tabs, 1, at2, n, cx, bud, cnt, true, out)
            }
        }
}

// The query's kinds and owners for a join plan (joinKinds), fresh.
fn kindsFor(top: &lexdb_plan.PPlan, tabs: &[]&lexdb_catalog.Table, nq: int, dec: bool, kinds: mut &[]int, owner: mut &[]int) {
    kinds = array(nq, BK_NONE)
    owner = array(nq, -1)
    var lvl = 0
    joinKinds(top, tabs, dec, kinds, owner, mut &lvl)
}

// Runs a join program of rows (Limit? (Sort? (Project (joins)))): as run,
// its tables tabs and where each is read srcs, by level. cnt: per level
// its counts (EXPLAIN ANALYZE's), then the rows given.
pub fn runJ(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, pg: &Prog, cols: &[]lexdb_sql.ColDef, tabs: &[]&lexdb_catalog.Table,
            srcs: &[]Src, vrows: &[][][]Val, cx: &Ctx, cap: int, bud: mut &Budget, cnt: mut &[]Counts,
            give: &fn(mut &lexdb_store.Txn, &lexdb_rows.OutBatch, &[]Val): Result[bool, DbErr]): Result[int, DbErr] {
    runs += 1
    joinRuns += 1
    batchRuns += 1
    while len(cnt) < pg.ops { append(cnt, noCounts()) }
    if pg.sorts {
        // its rows held by the Sort or Distinct, then given (slice P3)
        var sr = sortRun(&pg.plan, cap, bud)
        let got = try runJProj(st, txn, pg, projUnder(&pg.plan), cols, tabs, srcs, vrows, cx, -1, bud, cnt,
                               fn(tx: mut &lexdb_store.Txn, ob: &lexdb_rows.OutBatch, r: &[]Val): Result[bool, DbErr] { return sr.eat(ob, r) })
        sortRuns += 1
        return sr.finish(txn, bud, give)
    }
    var lim = cap
    limitOf(&pg.plan, mut &lim)
    return runJProj(st, txn, pg, projOf2(&pg.plan), cols, tabs, srcs, vrows, cx, lim, bud, cnt, give)
}

// runJ's Project pr over the joins: at most lim rows (-1 no limit).
fn runJProj(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, pg: &Prog, pr: &lexdb_plan.PPlan, cols: &[]lexdb_sql.ColDef,
            tabs: &[]&lexdb_catalog.Table, srcs: &[]Src, vrows: &[][][]Val, cx: &Ctx, lim: int, bud: mut &Budget, cnt: mut &[]Counts,
            give: &fn(mut &lexdb_store.Txn, &lexdb_rows.OutBatch, &[]Val): Result[bool, DbErr]): Result[int, DbErr] {
    match pr {
        lexdb_plan.PPlan.Project(top, xs) {
            let nq = len(cols)
            var kinds: []int = []
            var owner: []int = []
            kindsFor(&top, tabs, nq, false, mut &kinds, mut &owner)
            var want: []bool = array(nq, false)
            var rd: []int = []
            readsOf(&xs, mut &rd)
            for c in rd { want[c] = true }
            var nodes: []BNode = []
            var okinds: []int = []
            var osrc: []int = []
            for x in xs {
                match outNode(&x, cols, &kinds, cx, 0, &want) {
                    Some(on) {
                        append(mut &okinds, on.kind)
                        append(mut &osrc, on.src)
                        append(mut &nodes, takeON(on))
                    }
                    None { return Err(batErr()) }
                }
            }
            if lim == 0 { return Ok(0) }
            var given = 0
            let no = len(nodes)
            try joinRows(st, txn, &top, cols, tabs, srcs, vrows, cx, false, kinds, owner, want, true, bud, cnt,
                         fn(tx: mut &lexdb_store.Txn, f: mut &Batch): Result[bool, DbErr] {
                var all: []int = withCapacity(f.n)
                for r in 0..f.n { append(mut &all, r) }
                var ex: []BVec = []
                var srcs2: []int = []
                for o in 0..no { try bOutVal(&nodes[o], osrc[o], f, &all, mut &ex, mut &srcs2) }
                var take = f.n
                if lim >= 0 && given + take > lim { take = lim - given }
                if take <= 0 { return Ok(false) }
                let ob = lexdb_rows.OutBatch{n: take, kinds: collections.copyOf(&okinds), src: srcs2, idx: all,
                                             cols: replace(mut &f.cols, []), vals: replace(mut &f.vals, []), txt: replace(mut &f.txt, []), ex: ex}
                given += take
                let noRow: []Val = []
                if !(try give(tx, &ob, &noRow)) { return Ok(false) }
                return Ok(lim < 0 || given < lim)
            })
            cnt[pg.ops - 1].joined += given
            return Ok(given)
        }
        else { return Err(e("XX000", "the pipeline was given a plan it does not run")) }
    }
}

// The Project under a rows program's Limit and scan-order Sort.
fn projOf2(p: &lexdb_plan.PPlan): &lexdb_plan.PPlan {
    match p {
        lexdb_plan.PPlan.Limit(i, _, _, _) { return projOf2(&i) }
        lexdb_plan.PPlan.Sort(i, _, _) { return projOf2(&i) }
        else { return p }
    }
}

// lim lowered to a rows program's Limit's count.
fn limitOf(p: &lexdb_plan.PPlan, lim: mut &int) {
    match p {
        lexdb_plan.PPlan.Limit(i, _, n, _) {
            if lim < 0 || n < lim { lim = n }
            limitOf(&i, lim)
        }
        lexdb_plan.PPlan.Sort(i, _, _) { limitOf(&i, lim) }
        else {}
    }
}

// runAgg, or runAggJ for a plan with joins (its tables tabs, where each
// is read srcs; t and src the first's).
pub fn runAggAny(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, pg: &Prog, cols: &[]lexdb_sql.ColDef, t: &lexdb_catalog.Table,
                 src: &Src, tabs: &[]&lexdb_catalog.Table, srcs: &[]Src, vrows: &[][][]Val, cx: &Ctx, room: int, bud: mut &Budget, cnt: mut &[]Counts,
                 give: &fn(&[]Val, &[]PAcc): Result[Unit, DbErr]): Result[int, DbErr] {
    if pg.joins { return runAggJ(st, txn, pg, cols, tabs, srcs, vrows, cx, room, bud, cnt, give) }
    return runAgg(st, txn, pg, cols, t, src, cx, room, bud, cnt, give)
}

// Runs an aggregate over joins (pg.groups, pg.joins: Agg (joins) under
// the caller's views), as runAgg: its tables tabs and where each is read
// srcs, by level; cnt per level, then the groups. Over the joined chunks
// with numerics as units, then as values, then each joined row grouped by
// the scalar evaluator; each from the start (the groups are given at the
// end). A value a batch cannot hold: batErr (nothing given).
pub fn runAggJ(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, pg: &Prog, cols: &[]lexdb_sql.ColDef, tabs: &[]&lexdb_catalog.Table,
               srcs: &[]Src, vrows: &[][][]Val, cx: &Ctx, room: int, bud: mut &Budget, cnt: mut &[]Counts,
               give: &fn(&[]Val, &[]PAcc): Result[Unit, DbErr]): Result[int, DbErr] {
    runs += 1
    joinRuns += 1
    batchRuns += 1
    while len(cnt) < pg.ops { append(cnt, noCounts()) }
    match underViews(&pg.plan) {
        lexdb_plan.PPlan.Agg(i, _, pa) {
            match pa {
                Some(a) { return aggJoin(st, txn, &i, &a, cols, tabs, srcs, vrows, cx, room, bud, cnt, give) }
                None {}
            }
        }
        else {}
    }
    return Err(e("XX000", "the pipeline was given a plan it does not run"))
}

// The query's columns an aggregate reads: its keys', calls' and FILTERs',
// and those a group keeps.
fn aggWant(a: &lexdb_plan.PAgg, nq: int): []bool {
    var want: []bool = array(nq, false)
    var rd: []int = []
    readsOf(&a.keys, mut &rd)
    for c in a.calls {
        match c.arg {
            Some(x) { readsOf1(&x, mut &rd) }
            None {}
        }
        match c.filter {
            Some(x) { readsOf1(&x, mut &rd) }
            None {}
        }
    }
    for c in rd { if c >= 0 && c < nq { want[c] = true } }
    for c in 0..len(a.keep) { if a.keep[c] && c < nq { want[c] = true } }
    return want
}

fn aggJoin(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, top: &lexdb_plan.PPlan, a: &lexdb_plan.PAgg, cols: &[]lexdb_sql.ColDef,
           tabs: &[]&lexdb_catalog.Table, srcs: &[]Src, vrows: &[][][]Val, cx: &Ctx, room: int, bud: mut &Budget, cnt: mut &[]Counts,
           give: &fn(&[]Val, &[]PAcc): Result[Unit, DbErr]): Result[int, DbErr] {
    let nq = len(cols)
    let c0 = collections.copyOf(cnt)
    let h0 = bud.held
    let maxHeld = bud.maxHeld
    let last = len(cnt) - 1
    // a group's first row's columns and the keys' and calls': decoded where kept
    var avail: []bool = array(nq, false)
    for pass in 0..2 {
        let dec = pass == 0
        var kinds: []int = []
        var owner: []int = []
        kindsFor(top, tabs, nq, dec, mut &kinds, mut &owner)
        let want = aggWant(a, nq)
        for c in 0..nq { avail[c] = want[c] && owner[c] >= 0 }
        let got = aggState(a, cols, &kinds, &avail, cx, dec, room, maxHeld)
        if got.isNone() {
            if dec { continue }
            break
        }
        var ag = got.unwrap()
        // (no numeric read as units: the values' pass is the same)
        let usedDec = dec && ag.anyDec(&kinds, &avail)
        if dec && !usedDec { continue }
        var gaveWay = false
        let r = joinRows(st, txn, top, cols, tabs, srcs, vrows, cx, dec, kinds, owner, want, false, bud, cnt,
                         fn(tx: mut &lexdb_store.Txn, f: mut &Batch): Result[bool, DbErr] {
            var all: []int = withCapacity(f.n)
            for x in 0..f.n { append(mut &all, x) }
            if !(try ag.eat(f, &all)) {
                gaveWay = true
                return Ok(false)
            }
            return Ok(true)
        })
        var again = gaveWay
        match r {
            Ok(_) {}
            Err(x) {
                if dec && (isSpill(&x) || isBat(&x)) {
                    if isSpill(&x) { decSpills += 1 }
                    again = true
                } else if !isBat(&x) { return Err(x) }
                else { again = true }
            }
        }
        if !again {
            if usedDec { decRuns += 1 }
            groupRuns += 1
            cnt[last].joined += ag.ngroups
            try ag.finish(nq, give)
            return Ok(ag.added)
        }
        for k in 0..len(c0) { cnt[k] = c0[k] }
        bud.held = h0
    }
    // each joined row grouped by the scalar evaluator
    var kinds: []int = []
    var owner: []int = []
    kindsFor(top, tabs, nq, false, mut &kinds, mut &owner)
    let want = aggWant(a, nq)
    var wl: []int = []
    for c in 0..nq { if want[c] { append(mut &wl, c) } }
    var rg = RowGroups{row: array(nq, Val.Null), index: newMap(), firsts: [], accs: [], added: 0, kb: ""}
    let ks = collections.copyOf(&kinds)
    try joinRows(st, txn, top, cols, tabs, srcs, vrows, cx, false, kinds, owner, collections.copyOf(&want), false, bud, cnt,
                 fn(tx: mut &lexdb_store.Txn, f: mut &Batch): Result[bool, DbErr] {
        for r in 0..f.n {
            for c in wl { rg.row[c] = if f.cols[c].nul[r] { Val.Null } else { bValAt(f, c, ks[c], r) } }
            try groupRow(mut &rg, a, cx, room, maxHeld)
        }
        return Ok(true)
    })
    let ns = len(a.calls)
    let ng = len(rg.firsts)
    cnt[last].joined += ng
    var accs: []PAcc = []
    for g in 0..ng {
        while len(accs) > 0 { let gone = pop(mut &accs) }
        for i in 0..ns { append(mut &accs, replace(mut &rg.accs[g * ns + i], noAcc())) }
        try give(&rg.firsts[g], &accs)
    }
    return Ok(rg.added)
}

// ---- ORDER BY, top-N and DISTINCT over chunks (slice P3; design/lexdb.md 9.105)
//
// A Sort the plan sorts by (Sort(_, true, Some(keys))), or a Distinct,
// over the Project of one table's scan or of joins: the Project's chunks
// (its outputs, then the ORDER BY keys that are not outputs) are held here,
// not given, and the rows kept go on at the end as one OutBatch.
// - each chunk's rows' outputs and keys go into columns (SortSet),
//   integers as integers: no row and no value made per row;
// - DISTINCT keeps a row whose outputs were not seen (by the integer or
//   text itself when there is one output, else by their encoding under
//   their collations);
// - ORDER BY with LIMIT keeps the first LIMIT + OFFSET in a bounded heap,
//   its root the last of them: a row it beats costs its keys' copy and one
//   comparison, and its outputs are not taken;
// - DISTINCT with LIMIT and no ORDER BY stops the scan at the rows wanted;
// - the rows kept are sorted by their typed keys (lexdb_sort.skSort; ties
//   in the scan's order), then cut by OFFSET and LIMIT.
// A column's kind is its first chunk's (a row read one by one: values).
// Keys of values of mixed kinds, or a DISTINCT text output that is not a
// text, are not sorted here: the run ends in batErr before any row is
// given, and the caller runs the row engine.

type SortSet = record {
    outs: []BVec            // per output: its integers (BK_INT, BK_BOOL) and NULL flags (all)
    ovals: [][]Val          // per output of values: its values
    keys: []lexdb_sort.SKey // per ORDER BY key: SK_INT, or SK_VAL (values under its collation)
    vk: []int               // per key of values: their kind (kindOf), 0 none yet
    seq: []int              // per row kept: its place in the input
    bytes: []int            // ... and its bytes (outputs and keys, as rowBytes counts)
    n: int
}

fn putI(xs: mut &[]int, s: int, v: int) { if s < len(xs) { xs[s] = v } else { append(xs, v) } }
fn putF(xs: mut &[]bool, s: int, v: bool) { if s < len(xs) { xs[s] = v } else { append(xs, v) } }
fn putV(xs: mut &[]Val, s: int, v: Val) { if s < len(xs) { xs[s] = v } else { append(xs, v) } }

fn isIntKind(k: int): bool { return k == lexdb_rows.BK_INT || k == BK_BOOL }

// A DISTINCT's outputs seen: by the integer, the text, or the encoding.
type DistSet = record {
    ints: Map[int, int]
    keys: Map[str, int]
    nul: bool
    kb: str                 // a key, built in one string
}

// A one-table run's Sort, if any: st holds its state (one), or nothing
// (the rows stream to the caller; a run that does not sort makes nothing).
type SortRun = record { st: []SortSt }

// A Sort's (or Distinct's) run: what it holds, and how.
type SortSt = record {
    sorting: bool
    distinct: bool
    shown: int              // the outputs given (the Project's columns after them: keys only)
    keyCol: []int           // per key: the Project's column it is
    desc: []bool
    nf: []bool
    coll: []int             // per key: its collation's kind
    dcoll: []int            // DISTINCT: per output its collation's kind
    kinds: []int            // per column of the Project: its kind here ([] before the first chunk)
    limit: int              // the rows given (-1 all) after offset
    offset: int
    topK: int               // ORDER BY with LIMIT: the rows kept (-1 all)
    early: bool             // DISTINCT with LIMIT, not sorted: stops at limit + offset rows
    dmode: int              // DISTINCT: 1 one integer output, 2 one text output, 3 the outputs' encoding
    ds: []DistSet           // DISTINCT: its outputs seen (one; none else: a run that does not sort makes no map)
    set: SortSet
    heap: []int
    scr: int                // top-N: the slot a row is tried in
    seq: int
    held: int
    room: int
    maxHeld: int
    bad: bool               // a value not sorted here: the row engine's
    row: []Val              // a row read one by one, as values
}

// Whether p (under its Limit) is a Sort or Distinct that holds its rows
// (false: they stream).
fn sortArm(p: &lexdb_plan.PPlan): bool {
    match p {
        lexdb_plan.PPlan.Limit(i, _, _, _) { return sortArm(&i) }
        lexdb_plan.PPlan.Sort(i, sorted, _) { return sorted || sortArm(&i) }
        lexdb_plan.PPlan.Distinct(_, _, _) { return true }
        else { return false }
    }
}

// The Project under p's Limit, Sort and Distinct.
fn projUnder(p: &lexdb_plan.PPlan): &lexdb_plan.PPlan {
    match p {
        lexdb_plan.PPlan.Limit(i, _, _, _) { return projUnder(&i) }
        lexdb_plan.PPlan.Sort(i, _, _) { return projUnder(&i) }
        lexdb_plan.PPlan.Distinct(i, _, _) { return projUnder(&i) }
        else { return p }
    }
}

// The run of p's Sort or Distinct, at most cap rows (-1 no cap: a
// subquery's; 1 any one row, unsorted); room: the bytes it may hold.
fn sortRun(p: &lexdb_plan.PPlan, cap: int, bud: &Budget): SortSt {
    var sr = SortSt{sorting: false, distinct: false, shown: 0, keyCol: [], desc: [], nf: [], coll: [], dcoll: [], kinds: [],
                     limit: -1, offset: 0, topK: -1, early: false, dmode: 0, ds: [], set: SortSet{outs: [], ovals: [], keys: [], vk: [], seq: [], bytes: [], n: 0}, heap: [], scr: -1,
                     seq: 0, held: 0, room: bud.room(), maxHeld: bud.maxHeld, bad: false, row: []}
    sr.shown = projLen(projUnder(p))
    sortArmOf(p, mut &sr)
    if cap >= 0 && (sr.limit < 0 || cap < sr.limit) { sr.limit = cap }
    if cap == 1 { sr.sorting = false }
    if !sr.sorting {
        sr.keyCol = []
        sr.desc = []
        sr.nf = []
        sr.coll = []
    }
    sr.topK = if sr.sorting && sr.limit >= 0 && !sr.distinct { sr.limit + max(sr.offset, 0) } else { -1 }
    sr.early = !sr.sorting && sr.limit >= 0
    if sr.distinct { append(mut &sr.ds, DistSet{ints: newMap(), keys: newMap(), nul: false, kb: ""}) }
    return sr
}

// No Sort: the rows go to the caller as they are made.
fn noSortRun(): SortRun { return SortRun{st: []} }

// What a run made (a chunk ob, or the row r when ob.n is 0) to srt when it
// holds the rows, else to give.
fn emitTo(txn: mut &lexdb_store.Txn, srt: mut &SortRun, give: &fn(mut &lexdb_store.Txn, &lexdb_rows.OutBatch, &[]Val): Result[bool, DbErr],
          ob: &lexdb_rows.OutBatch, r: &[]Val): Result[bool, DbErr] {
    if len(srt.st) > 0 { return srt.st[0].eat(ob, r) }
    return give(txn, ob, r)
}

// A top-N's bar for the scan (batch column col, its first key's): the
// heap's last row's first key once the heap is full, else none.
fn (sr: &SortSt) bar(col: int): lexdb_access.Bar {
    if len(sr.heap) < sr.topK || len(sr.set.keys) == 0 || sr.set.keys[0].kind != lexdb_sort.SK_INT { return lexdb_access.noBar() }
    let root = sr.heap[0]
    let k = &sr.set.keys[0]
    return lexdb_access.Bar{on: true, col: col, v: k.ints[root], nul: k.nul[root], desc: k.desc, nf: k.nf}
}

// The columns a Project makes.
fn projLen(p: &lexdb_plan.PPlan): int {
    match p {
        lexdb_plan.PPlan.Project(_, xs) { return len(xs) }
        else { return 0 }
    }
}

fn sortArmOf(p: &lexdb_plan.PPlan, sr: mut &SortSt) {
    match p {
        lexdb_plan.PPlan.Limit(i, _, n, off) {
            sr.limit = n
            sr.offset = off
            sortArmOf(&i, sr)
        }
        lexdb_plan.PPlan.Sort(i, sorted, ps) {
            match ps {
                Some(k) {
                    if sorted {
                        sr.sorting = true
                        sr.shown = k.shown
                        for x in k.out { append(mut &sr.keyCol, x) }
                        for x in k.desc { append(mut &sr.desc, x) }
                        for x in k.nf { append(mut &sr.nf, x) }
                        for x in k.coll { append(mut &sr.coll, x) }
                    }
                }
                None {}
            }
            sortArmOf(&i, sr)
        }
        lexdb_plan.PPlan.Distinct(_, _, ks) {
            sr.distinct = true
            for x in ks { append(mut &sr.dcoll, x) }
        }
        else {}
    }
}

// The kinds of the Project's columns, from the first input: a chunk's, or
// values (a row read one by one); the set's columns and keys made.
fn (sr: mut &SortSt) begin(ob: &lexdb_rows.OutBatch, ncol: int) {
    sr.kinds = []
    for c in 0..ncol { append(mut &sr.kinds, if ob.n > 0 && isIntKind(ob.kinds[c]) { ob.kinds[c] } else { BK_VAL }) }
    for o in 0..sr.shown {
        append(mut &sr.set.outs, lexdb_rows.bvec(0))
        append(mut &sr.set.ovals, [])
    }
    for k in 0..len(sr.keyCol) {
        let kind = sr.kinds[sr.keyCol[k]]
        append(mut &sr.set.keys, lexdb_sort.newSKey(if kind == BK_VAL { lexdb_sort.SK_VAL } else { lexdb_sort.SK_INT }, sr.desc[k], sr.nf[k]))
        append(mut &sr.set.vk, 0)
    }
    if sr.distinct {
        sr.dmode = if sr.shown == 1 && sr.kinds[0] != BK_VAL { 1 } else if sr.shown == 1 { 2 } else { 3 }
    }
}

// Column c of row j of what the run gave (ob, or the row r when ob.n is
// 0) as a column of kind holds it: its integer in iv (an integer kind),
// its value in vv. True: NULL. A value an integer column cannot hold: bad.
fn (sr: mut &SortSt) cell(kind: int, ob: &lexdb_rows.OutBatch, r: &[]Val, j: int, c: int, iv: mut &int, vv: mut &Val): bool {
    if ob.n == 0 {
        if lexdb_ops.isNull(&r[c]) { return true }
        if kind == BK_VAL {
            vv = r[c].clone()
            return false
        }
        match r[c] {
            Val.Int(x) {
                if kind == lexdb_rows.BK_INT {
                    iv = x
                    return false
                }
            }
            Val.Bool(x) {
                if kind == BK_BOOL {
                    iv = if x { 1 } else { 0 }
                    return false
                }
            }
            else {}
        }
        sr.bad = true
        return true
    }
    let ok = ob.kinds[c]
    let src = ob.src[c]
    var x = 0
    if src < 0 {
        if ob.ex[c].nul[j] { return true }
        x = ob.ex[c].v[j]
    } else {
        let rr = ob.idx[j]
        if ob.cols[src].nul[rr] { return true }
        if ok == lexdb_rows.BK_TEXT {
            if kind != BK_VAL {
                sr.bad = true
                return true
            }
            vv = Val.Text(lexdb_rows.obText(ob, c, j).clone())
            return false
        }
        if !isIntKind(ok) {
            if kind != BK_VAL {
                sr.bad = true
                return true
            }
            vv = ob.vals[src][rr].clone()
            return false
        }
        x = ob.cols[src].v[rr]
    }
    if kind == BK_VAL {
        vv = if ok == BK_BOOL { Val.Bool(x == 1) } else { Val.Int(x) }
        return false
    }
    if kind != ok {
        sr.bad = true
        return true
    }
    iv = x
    return false
}

// Row j's ORDER BY keys into slot s; their bytes in bytes. False: not
// sorted here (bad).
fn (sr: mut &SortSt) keysAt(s: int, ob: &lexdb_rows.OutBatch, r: &[]Val, j: int, bytes: mut &int): bool {
    var n = 32
    for k in 0..len(sr.keyCol) {
        n += 24
        let c = sr.keyCol[k]
        let kind = sr.kinds[c]
        var iv = 0
        var vv = Val.Null
        let nul = sr.cell(kind, ob, r, j, c, mut &iv, mut &vv)
        if sr.bad { return false }
        if kind == BK_VAL {
            let v = if nul { Val.Null } else { lexdb_sort.collVal(sr.coll[k], &vv) }
            if !nul {
                let vk = lexdb_ops.kindOf(&v)
                if sr.set.vk[k] == 0 { sr.set.vk[k] = vk } else if sr.set.vk[k] != vk {
                    sr.bad = true
                    return false
                }
                n += valExtra(&v)
            }
            putV(mut &sr.set.keys[k].vals, s, v)
        } else {
            putI(mut &sr.set.keys[k].ints, s, iv)
            putF(mut &sr.set.keys[k].nul, s, nul)
        }
    }
    bytes = n
    return true
}

// Row j's outputs into slot s. Their bytes (bad: not held here).
fn (sr: mut &SortSt) outsAt(s: int, ob: &lexdb_rows.OutBatch, r: &[]Val, j: int): int {
    var n = 32
    for o in 0..sr.shown {
        n += 24
        let kind = sr.kinds[o]
        var iv = 0
        var vv = Val.Null
        let nul = sr.cell(kind, ob, r, j, o, mut &iv, mut &vv)
        putF(mut &sr.set.outs[o].nul, s, nul)
        if kind == BK_VAL {
            if !nul { n += valExtra(&vv) }
            putV(mut &sr.set.ovals[o], s, vv)
        } else {
            putI(mut &sr.set.outs[o].v, s, iv)
        }
    }
    return n
}

// Whether row j's outputs were seen (DISTINCT); if not, they are now.
fn (sr: mut &SortSt) seen(ob: &lexdb_rows.OutBatch, r: &[]Val, j: int): bool {
    var iv = 0
    var vv = Val.Null
    if sr.dmode == 1 {
        if sr.cell(sr.kinds[0], ob, r, j, 0, mut &iv, mut &vv) {
            if sr.ds[0].nul { return true }
            sr.ds[0].nul = true
            return false
        }
        if sr.ds[0].ints.get(&iv).isSome() { return true }
        sr.ds[0].ints.put(iv, 1)
        return false
    }
    if sr.dmode == 2 {
        if sr.cell(BK_VAL, ob, r, j, 0, mut &iv, mut &vv) {
            if sr.ds[0].nul { return true }
            sr.ds[0].nul = true
            return false
        }
        let k0 = if len(sr.dcoll) > 0 { sr.dcoll[0] } else { lexdb_sql.COLL_EXACT }
        match replace(mut &vv, Val.Null) {
            Val.Text(x) {
                let tk = if k0 == lexdb_sql.COLL_EXACT { x } else if k0 == lexdb_sql.COLL_CI { lexdb_access.ciKey(&x) } else { lexdb_access.padKey(&x) }
                if sr.ds[0].keys.get(&tk).isSome() { return true }
                sr.ds[0].keys.put(tk, 1)
                return false
            }
            else {
                sr.bad = true
                return true
            }
        }
    }
    sr.ds[0].kb.clear()
    for o in 0..sr.shown {
        let kind = sr.kinds[o]
        let nul = sr.cell(kind, ob, r, j, o, mut &iv, mut &vv)
        let v = if nul { Val.Null } else if kind == lexdb_rows.BK_INT { Val.Int(iv) } else if kind == BK_BOOL { Val.Bool(iv == 1) } else { replace(mut &vv, Val.Null) }
        lexdb_access.encIdxPart(mut &sr.ds[0].kb, &(if o < len(sr.dcoll) { lexdb_sort.collVal(sr.dcoll[o], &v) } else { v }))
    }
    if sr.ds[0].keys.get(&sr.ds[0].kb).isSome() { return true }
    sr.ds[0].keys.put(sr.ds[0].kb.clone(), 1)
    return false
}

// The heap's order: by the keys, then the input's (a later row tied with
// an earlier one sorts after it).
fn hCmp(set: &SortSet, a: int, b: int): int {
    let c = lexdb_sort.skCmp(&set.keys, 0, len(set.keys), a, b)
    if c != 0 { return c }
    return set.seq[a] - set.seq[b]
}

// The heap (its root the last row in the order) after heap[i] rose.
fn hUp(set: &SortSet, heap: mut &[]int, i: int) {
    var c = i
    while c > 0 {
        let p = (c - 1) / 2
        if hCmp(set, heap[c], heap[p]) <= 0 { break }
        let x = heap[c]
        heap[c] = heap[p]
        heap[p] = x
        c = p
    }
}

// ... after heap[i] fell.
fn hDown(set: &SortSet, heap: mut &[]int, i: int) {
    let n = len(heap)
    var c = i
    while true {
        let l = 2 * c + 1
        if l >= n { break }
        var big = l
        if l + 1 < n && hCmp(set, heap[l + 1], heap[l]) > 0 { big = l + 1 }
        if hCmp(set, heap[big], heap[c]) <= 0 { break }
        let x = heap[c]
        heap[c] = heap[big]
        heap[big] = x
        c = big
    }
}

// What a run gave (a chunk ob, or the row r when ob.n is 0) taken in;
// false: no more is wanted (the rows a DISTINCT's LIMIT wants, or a value
// not sorted here).
fn (sr: mut &SortSt) eat(ob: &lexdb_rows.OutBatch, r: &[]Val): Result[bool, DbErr] {
    let ncol = if ob.n > 0 { len(ob.kinds) } else { len(r) }
    if len(sr.kinds) == 0 { sr.begin(ob, ncol) }
    let m = if ob.n > 0 { ob.n } else { 1 }
    for j in 0..m {
        sr.seq += 1
        if sr.distinct {
            if sr.seen(ob, r, j) { if sr.bad { return Ok(false) } else { continue } }
        }
        var kb2 = 0
        if sr.topK >= 0 {
            if sr.topK == 0 { continue }
            if len(sr.heap) < sr.topK {
                let s = sr.set.n
                if !sr.keysAt(s, ob, r, j, mut &kb2) { return Ok(false) }
                let obytes = sr.outsAt(s, ob, r, j)
                if sr.bad { return Ok(false) }
                putI(mut &sr.set.seq, s, sr.seq)
                putI(mut &sr.set.bytes, s, kb2 + obytes)
                sr.set.n += 1
                sr.held += kb2 + obytes
                append(mut &sr.heap, s)
                hUp(&sr.set, mut &sr.heap, len(sr.heap) - 1)
            } else {
                if sr.scr < 0 {
                    sr.scr = sr.set.n
                    sr.set.n += 1
                }
                let s = sr.scr
                if !sr.keysAt(s, ob, r, j, mut &kb2) { return Ok(false) }
                putI(mut &sr.set.seq, s, sr.seq)
                // the last kept beats it (or ties: it came first)
                if hCmp(&sr.set, s, sr.heap[0]) >= 0 { continue }
                let obytes = sr.outsAt(s, ob, r, j)
                if sr.bad { return Ok(false) }
                putI(mut &sr.set.bytes, s, kb2 + obytes)
                sr.held += kb2 + obytes - sr.set.bytes[sr.heap[0]]
                let gone = sr.heap[0]
                sr.heap[0] = s
                sr.scr = gone
                hDown(&sr.set, mut &sr.heap, 0)
            }
        } else {
            let s = sr.set.n
            if !sr.keysAt(s, ob, r, j, mut &kb2) { return Ok(false) }
            let obytes = sr.outsAt(s, ob, r, j)
            if sr.bad { return Ok(false) }
            putI(mut &sr.set.seq, s, sr.seq)
            putI(mut &sr.set.bytes, s, kb2 + obytes)
            sr.set.n += 1
            sr.held += kb2 + obytes
        }
        if sr.room >= 0 && sr.held > sr.room { return Err(memErr(sr.maxHeld)) }
        if sr.early && sr.set.n >= sr.limit + max(sr.offset, 0) { return Ok(false) }
    }
    return Ok(true)
}

// The rows kept, in order, cut by OFFSET and LIMIT, given to give as one
// OutBatch (none when there are none); their bytes held in bud. The rows
// given. batErr: a value not sorted here (nothing given).
fn (sr: mut &SortSt) finish(txn: mut &lexdb_store.Txn, bud: mut &Budget,
                             give: &fn(mut &lexdb_store.Txn, &lexdb_rows.OutBatch, &[]Val): Result[bool, DbErr]): Result[int, DbErr] {
    if sr.bad { return Err(batErr()) }
    var perm: []int = []
    let nk = len(sr.keyCol)
    if sr.topK >= 0 {
        // the heap's rows in the input's order, then sorted by their keys (stable)
        var hs: []int = []
        for x in sr.heap { append(mut &hs, x) }
        let seqs = &sr.set.seq
        collections.sortBy(mut &hs, fn(a: &int, b: &int): int { return seqs[a] - seqs[b] })
        var tmp: []int = array(len(hs), 0)
        lexdb_sort.skMerge(&sr.set.keys, 0, nk, mut &hs, 0, len(hs), mut &tmp)
        perm = hs
    } else if sr.sorting && sr.set.n > 0 {
        for k in 0..nk {
            if sr.set.keys[k].kind != lexdb_sort.SK_VAL { continue }
            let vs = replace(mut &sr.set.keys[k].vals, [])
            var key = lexdb_sort.newSKey(lexdb_sort.SK_VAL, sr.desc[k], sr.nf[k])
            if !lexdb_sort.skOfVals(vs, sr.desc[k], sr.nf[k], mut &key) { return Err(batErr()) }
            sr.set.keys[k] = key
        }
        perm = lexdb_sort.skSort(mut &sr.set.keys, sr.set.n)
    } else {
        for i in 0..sr.set.n { append(mut &perm, i) }
    }
    try bud.hold(sr.held)
    let from = min(max(sr.offset, 0), len(perm))
    var to = len(perm)
    if sr.limit >= 0 && from + sr.limit < to { to = from + sr.limit }
    if to <= from { return Ok(0) }
    // one OutBatch, its places the sorted rows': less work than pieces
    // (gathered in order, or each its places), measured (9.105)
    var oidx: []int = withCapacity(to - from)
    for i in from..to { append(mut &oidx, perm[i]) }
    var srcs: []int = []
    var kinds: []int = []
    for o in 0..sr.shown {
        append(mut &srcs, o)
        append(mut &kinds, sr.kinds[o])
    }
    let ob = lexdb_rows.OutBatch{n: to - from, kinds: kinds, src: srcs, idx: oidx, cols: replace(mut &sr.set.outs, []),
                                 vals: replace(mut &sr.set.ovals, []), txt: [], ex: []}
    let noRow: []Val = []
    let more = try give(txn, &ob, &noRow)
    return Ok(to - from)
}

// ---- the row engine's joined rows (slice P2c)
//
// A query the pipeline does not run whole (its rows sorted, DISTINCT,
// windowed, a set's part, a statement's query, an aggregate it does not
// accumulate) has its joins run by it: a program of its join arms only
// (compileLevels), whose joined rows, every column its tables decode, go
// one by one to the row engine's emit (runLevels), as the batch driver's
// first level gave them.

// The program of a join tree p (Join arms over Filter? (Scan)) run for
// the row engine; Err(p): not one the pipeline joins. Its tables decode
// the columns their arms say (the statement's names: the row engine reads
// the rows whole).
pub fn compileLevels(p: lexdb_plan.PPlan, cols: &[]lexdb_sql.ColDef): Result[Prog, lexdb_plan.PPlan] {
    match p {
        lexdb_plan.PPlan.Join(_, _) {}
        else { return Err(p) }
    }
    var avail: []bool = array(len(cols), false)
    let n = joinOps(&p, cols, mut &avail)
    if n < 0 { return Err(p) }
    return Ok(Prog{plan: p, ops: n + 1, groups: false, joins: true, sorts: false})
}

// Runs a levels program (compileLevels): each joined row (the query's
// columns its tables decode, the others NULL) to each, in the row
// engine's order; false from each stops. An error of each is given as is
// (the rows before it given); one of the joins' is the row engine's
// (the chunk joined again row by row).
pub fn runLevels(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, pg: &Prog, cols: &[]lexdb_sql.ColDef, tabs: &[]&lexdb_catalog.Table,
                 srcs: &[]Src, vrows: &[][][]Val, cx: &Ctx, bud: mut &Budget, cnt: mut &[]Counts,
                 each: &fn(mut &lexdb_store.Txn, &[]Val): Result[bool, DbErr]): Result[Unit, DbErr] {
    runs += 1
    joinRuns += 1
    batchRuns += 1
    while len(cnt) < pg.ops { append(cnt, noCounts()) }
    let nq = len(cols)
    var kinds: []int = []
    var owner: []int = []
    kindsFor(&pg.plan, tabs, nq, false, mut &kinds, mut &owner)
    var want: []bool = array(nq, false)
    decoded(&pg.plan, mut &want)
    var wl: []int = []
    for c in 0..nq { if want[c] { append(mut &wl, c) } }
    let ks = collections.copyOf(&kinds)
    var row: []Val = array(nq, Val.Null)
    var bad: []DbErr = []
    try joinRows(st, txn, &pg.plan, cols, tabs, srcs, vrows, cx, false, kinds, owner, want, true, bud, cnt,
                 fn(tx: mut &lexdb_store.Txn, f: mut &Batch): Result[bool, DbErr] {
        for r in 0..f.n {
            for c in wl { row[c] = if f.cols[c].nul[r] { Val.Null } else { bValAt(f, c, ks[c], r) } }
            match each(tx, &row) {
                Ok(go) { if !go { return Ok(false) } }
                Err(x) {
                    // (the consumer's: not a join's to read again)
                    append(mut &bad, x)
                    return Ok(false)
                }
            }
        }
        return Ok(true)
    })
    if len(bad) > 0 { return Err(replace(mut &bad[0], e("XX000", ""))) }
    return Ok(Unit{})
}

// The query's columns a join plan's tables decode, set in want.
fn decoded(p: &lexdb_plan.PPlan, want: mut &[]bool) {
    match p {
        lexdb_plan.PPlan.Join(i, j) {
            decoded(&i, want)
            for c in 0..len(j.scan.need) { if j.scan.need[c] && j.mark == lexdb_plan.MK_JOIN { want[j.scan.first + c] = true } }
        }
        lexdb_plan.PPlan.Filter(i, _) { decoded(&i, want) }
        lexdb_plan.PPlan.Scan(sc, _) { for c in 0..len(sc.need) { if sc.need[c] { want[sc.first + c] = true } } }
        else {}
    }
}
