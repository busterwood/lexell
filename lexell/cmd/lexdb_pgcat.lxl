// lexdb_pgcat: the fixed parts of the pg_catalog and information_schema
// relations (9.80): their columns, PostgreSQL's built-in types (pg_type's
// rows), and format_type. The rows that describe the database's own tables
// are made by lexdb_exec from its catalog.

import "strings"

// A catalog relation's column.
pub type CatCol = record {
    pub name: str
    pub oid: int
}

// Column types by letter: o oid, n name, t text, b bool, s int2, i int4,
// l int8, f float4, c "char", v int2vector, w oidvector, T text[], O oid[],
// C "char"[], S int2[], x pg_node_tree (text), a aclitem[] (text[]), r
// regproc, R regtype, z timestamptz, y bytea, k information_schema's
// cardinal_number (int4), h its character_data (text).
fn letterOid(c: byte): int {
    match c {
        'o' { return 26 }
        'n' { return 19 }
        'b' { return 16 }
        's' { return 21 }
        'i', 'k' { return 23 }
        'l' { return 20 }
        'f' { return 700 }
        'c' { return 18 }
        'v' { return 22 }
        'w' { return 30 }
        'T', 'a' { return 1009 }
        'O' { return 1028 }
        'C' { return 1002 }
        'S' { return 1005 }
        'r' { return 24 }
        'R' { return 2206 }
        'z' { return 1184 }
        'y' { return 17 }
        else { return 25 }
    }
}

