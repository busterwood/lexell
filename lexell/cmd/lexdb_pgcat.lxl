// Every catalog relation's name.
pub fn relNames(): []str {
    var out: []str = []
    for r in RELS {
        let sp = strings.indexOf(&r, " ", 0)
        append(mut &out, r[0..sp].toStr())
    }
    return out
}

fn relSpec(rel: &str): str {
    for r in RELS {
        let sp = strings.indexOf(&r, " ", 0)
        if r[0..sp] == rel { return r[sp + 1..len(r)] }
    }
    return ""
}

// Whether rel ("pg_class", "information_schema.tables") is a catalog relation.
pub fn isRel(rel: &str): bool { return len(relSpec(rel)) > 0 }

// The catalog relation a FROM item names: pg_catalog's by its name or
// qualified (pg_catalog QSEP name), information_schema's qualified; "" if
// none.
pub fn relOf(schema: &str, name: &str): str {
    if schema == "information_schema" {
        let r = "information_schema." + name
        return if isRel(&r) { r } else { "" }
    }
    if (schema == "" || schema == "pg_catalog") && isRel(name) { return name }
    return ""
}

pub fn relCols(rel: &str): []CatCol {
    var out: []CatCol = []
    let spec = relSpec(rel)
    for part in strings.split(&spec, " ") {
        let c = strings.indexOf(&part, ":", 0)
        append(mut &out, CatCol{name: part[0..c], oid: letterOid(part[c + 1])})
    }
    return out
}

// ---- the built-in types (pg_type's rows)

// A type: OID, name, length, by value, category, element, array, alignment,
// collation, preferred.
pub type PgType = record {
    pub oid: int
    pub name: str
    pub len: int
    pub byval: bool
    pub cat: str
    pub elem: int
    pub array: int
    pub align: str
    pub coll: int
    pub pref: bool
}

const TYPES: []str = [
    "16 bool 1 t B 0 1000 c 0 t", "17 bytea -1 f U 0 1001 i 0 f", "18 char 1 t Z 0 1002 c 0 f",
    "19 name 64 f S 0 1003 c 950 f", "20 int8 8 t N 0 1016 d 0 f", "21 int2 2 t N 0 1005 s 0 f",
    "22 int2vector -1 f A 21 1006 i 0 f", "23 int4 4 t N 0 1007 i 0 f", "24 regproc 4 t N 0 1008 i 0 f",
    "25 text -1 f S 0 1009 i 100 t", "26 oid 4 t N 0 1028 i 0 t", "30 oidvector -1 f A 26 1013 i 0 f",
    "114 json -1 f U 0 199 i 0 f", "700 float4 4 t N 0 1021 i 0 f", "701 float8 8 t N 0 1022 d 0 t",
    "1042 bpchar -1 f S 0 1014 i 100 f", "1043 varchar -1 f S 0 1015 i 100 f", "1082 date 4 t D 0 1182 i 0 f", "1083 time 8 t D 0 1183 d 0 f",
    "1114 timestamp 8 t D 0 1115 d 0 f", "1184 timestamptz 8 t D 0 1185 d 0 t", "1186 interval 16 f T 0 1187 d 0 t",
    "1700 numeric -1 f N 0 1231 i 0 f", "2205 regclass 4 t N 0 2210 i 0 f", "2206 regtype 4 t N 0 2211 i 0 f",
    "2950 uuid 16 f U 0 2951 c 0 f", "3802 jsonb -1 f U 0 3807 i 0 f", "4089 regnamespace 4 t N 0 4090 i 0 f",
    "1000 _bool -1 f A 16 0 i 0 f", "1001 _bytea -1 f A 17 0 i 0 f", "1002 _char -1 f A 18 0 i 0 f",
    "1003 _name -1 f A 19 0 i 950 f", "1005 _int2 -1 f A 21 0 i 0 f", "1006 _int2vector -1 f A 22 0 i 0 f",
    "1007 _int4 -1 f A 23 0 i 0 f", "1008 _regproc -1 f A 24 0 i 0 f", "1009 _text -1 f A 25 0 i 100 f",
    "1013 _oidvector -1 f A 30 0 i 0 f", "1014 _bpchar -1 f A 1042 0 i 100 f", "1015 _varchar -1 f A 1043 0 i 100 f", "1016 _int8 -1 f A 20 0 d 0 f",
    "1021 _float4 -1 f A 700 0 i 0 f", "1022 _float8 -1 f A 701 0 d 0 f", "1028 _oid -1 f A 26 0 i 0 f",
    "1115 _timestamp -1 f A 1114 0 d 0 f", "1182 _date -1 f A 1082 0 i 0 f", "1183 _time -1 f A 1083 0 d 0 f",
    "1185 _timestamptz -1 f A 1184 0 d 0 f", "1187 _interval -1 f A 1186 0 d 0 f", "1231 _numeric -1 f A 1700 0 i 0 f",
    "199 _json -1 f A 114 0 i 0 f", "2210 _regclass -1 f A 2205 0 i 0 f", "2211 _regtype -1 f A 2206 0 i 0 f",
    "2951 _uuid -1 f A 2950 0 i 0 f", "3807 _jsonb -1 f A 3802 0 i 0 f", "4090 _regnamespace -1 f A 4089 0 i 0 f",
]

pub fn types(): []PgType {
    var out: []PgType = []
    for t in TYPES {
        let f = strings.split(&t, " ")
        append(mut &out, PgType{oid: strings.parseIntOpt(f[0]).unwrapOr(0), name: f[1], len: strings.parseIntOpt(f[2]).unwrapOr(0),
                                byval: f[3] == "t", cat: f[4], elem: strings.parseIntOpt(f[5]).unwrapOr(0),
                                array: strings.parseIntOpt(f[6]).unwrapOr(0), align: f[7],
                                coll: strings.parseIntOpt(f[8]).unwrapOr(0), pref: f[9] == "t"})
    }
    return out
}

pub fn typeOf(oid: int): Option[PgType] {
    var ts = types()
    for i in 0..len(ts) { if ts[i].oid == oid { return Some(replace(mut &ts[i], noType())) } }
    return None
}

fn noType(): PgType { return PgType{oid: 0, name: "", len: 0, byval: false, cat: "", elem: 0, array: 0, align: "", coll: 0, pref: false} }

// A type's OID by its name (pg_type's, or as SQL writes it: integer,
// character varying), 0 if none.
pub fn typeByName(n: &str): int {
    let l = strings.toLowerAscii(strings.trim(n))
    for t in types() { if t.name == l { return t.oid } }
    for t in types() { if formatType(t.oid, -1) == l { return t.oid } }
    match l {
        "int" { return 23 }
        "decimal" { return 1700 }
        "float" { return 701 }
        "character varying" { return 1043 }
        "character", "char" { return 1042 }
        else { return 0 }
    }
}

// format_type(oid, typmod): the type as SQL writes it, with its modifier
// (varchar's length + 4, numeric's precision << 16 | scale + 4, a time
// type's precision); -1 none.
pub fn formatType(oid: int, mod: int): str {
    match typeOf(oid) {
        Some(t) {
            if t.elem > 0 && t.cat == "A" && oid != 22 && oid != 30 { return formatType(t.elem, mod) + "[]" }
        }
        None { return "???" }
    }
    let base = match oid {
        16 { "boolean" }
        18 { "\"char\"" }
        20 { "bigint" }
        21 { "smallint" }
        23 { "integer" }
        700 { "real" }
        701 { "double precision" }
        1043 { "character varying" }
        1042 { if mod >= 4 { "character" } else { "bpchar" } }
        1114 { "timestamp" }
        1184 { "timestamp" }
        1083 { "time" }
        else { typeOf(oid).unwrap().name }
    }
    var m = ""
    if mod >= 0 {
        if (oid == 1043 || oid == 1042) && mod >= 4 { m = "(" + (mod - 4).toStr() + ")" }
        if oid == 1700 && mod >= 4 { m = "(" + ((mod - 4) >> 16).toStr() + "," + ((mod - 4) & 0xFFFF).toStr() + ")" }
        if oid == 1083 || oid == 1114 || oid == 1184 || oid == 1186 { m = "(" + mod.toStr() + ")" }
    }
    if oid == 1114 || oid == 1083 { return base + m + " without time zone" }
    if oid == 1184 { return base + m + " with time zone" }
    return base + m
}
