// lexdb: the PostgreSQL wire protocol, version 3.0, server side
// (design/lexdb.md 4.7). One task per connection.
//
// Startup: an SSLRequest or GSSENCRequest is answered 'N' (or 'S' with TLS),
// a CancelRequest with a session's BackendKeyData stops the statement it
// runs (57014, 9.138), and a StartupMessage is accepted as configure set
// the authentication (trust or SCRAM). Then
// the simple query protocol (several statements in one Query), and the
// extended one: Parse, Bind, Describe, Execute, Close, Sync and Flush.
// After an error in the extended protocol the messages up to Sync are
// skipped, as PostgreSQL does. Results are text, or binary for the columns a
// Bind asks for; parameters text or binary (lexdb_pgbin: PostgreSQL's
// binary formats, kept out of the text path's functions).
import "net"
import "fs"
import "task"
import "io"
import "binary"
import "collections"
import "strings"
import "math"
import "./lexdb_base"
import "./lexdb_store"
import "./lexdb_sql"
import "./lexdb_exec"
import "./lexdb_priv"
import "./lexdb_rows"
import "./lexdb_bind"
import "./lexdb_ops"
import "./lexdb_float"
import "./lexdb_time"
import "./lexdb_auth"
import "tls"
import "crypto"
import "./lexdb_parse"
import "./lexdb_census"
import "./lexdb_standby"
import "./lexdb_pgbin"

type Val = lexdb_sql.Val

const SSL_REQUEST = 80877103
const GSS_REQUEST = 80877104
const CANCEL_REQUEST = 80877102
const PROTOCOL_3 = 196608
const MAX_MESSAGE = 64 * 1024 * 1024

pub type ConnArg = record { pub conn: net.Conn; pub st: lexdb_store.Store; pub id: int; ctx: []tls.Context }

type Prepared = record {
    stmts: []lexdb_sql.Stmt     // none (an empty query) or one
    ptypes: []int
    cols: []lexdb_bind.OutCol   // its result's columns, as Describe found them
    rowDescMsg: str             // pre-framed text-mode 'T' RowDescription message bytes
    colsAt: int                 // the catalog's changes then (Store.changes), -1 not yet
    pathAt: int                 // the session's search path then (Session.pathVersion)
    plan: lexdb_exec.PlanCache  // its SELECT's plan, kept between executions
}

type Portal = record {
    stmt: str
    params: []Val
    fmts: []int                 // its result columns' format codes when one is binary (lexdb_pgbin); [] all text
}

type Wire = record {
    c: net.Conn
    eng: []tls.Engine           // after an SSLRequest answered S: the connection's TLS (9.81); [] plain
    raw: []byte                 // with TLS: what is read from the socket, before it is decrypted
    bind: str                   // with TLS: the channel binding data (our certificate's hash); "" none
    inBuf: []byte               // read into directly; [inPos, inEnd) not yet taken
    inPos: int
    inEnd: int
    out: str
    sess: lexdb_exec.Session
    parked: []lexdb_exec.Session // pre-allocated parked session popped/pushed during runStreamed
    st: lexdb_store.Store
    skipping: bool
    tzShown: str                // the TimeZone the client was last told (ParameterStatus, 9.95)
    streamed: bool              // the last runStreamed sent its rows as they came (its RowDescription too, if asked)
    texts: []str                // dataRow's values' texts, the array used again for each row
}

// Cached auto-parameterized simple-query SELECT template (e.g. "select * from w where id = $1;")
type AutoEntry = record {
    stmt: lexdb_sql.Stmt
    ptypes: []int
    catAt: int
    pathAt: int
    plan: lexdb_exec.PlanCache
}

// The prepared statements, portals, and auto-parameterized simple-query templates of a connection.
type Ps = record {
    stmts: Map[str, Prepared]
    portals: Map[str, Portal]
    hasUnnamed: bool
    unnamed: Portal
    autos: Map[str, AutoEntry]
}

fn (ps: &Ps) hasPortal(name: &str): bool {
    if len(name) == 0 { return ps.hasUnnamed }
    return ps.portals.has(name)
}

fn (ps: &Ps) portalAt(name: &str): &Portal {
    if len(name) == 0 { return &ps.unnamed }
    return ps.portals.at(name)
}

fn (ps: mut &Ps) putPortal(name: str, po: Portal) {
    if len(name) == 0 {
        ps.unnamed = po
        ps.hasUnnamed = true
        return
    }
    ps.portals.put(name, po)
}

fn (ps: mut &Ps) dropPortal(name: &str) {
    if len(name) == 0 {
        ps.hasUnnamed = false
        ps.unnamed = Portal{stmt: "", params: [], fmts: []}
        return
    }
    let gone = ps.portals.remove(name)
}

// ---- reading

type VB = vector[byte]

fn shiftLeftSimd(b: mut &[]byte, src: int, have: int) {
    var i = 0
    while i + 32 <= have {
        VB.load(b, src + i).store(b, i)
        i += 32
    }
    while i < have {
        b[i] = b[src + i]
        i += 1
    }
}

fn copySliceSimd(dst: mut &[]byte, src: &[byte], off: int, have: int) {
    var i = 0
    while i + 32 <= have {
        VB.load(src, off + i).store(dst, i)
        i += 32
    }
    while i < have {
        dst[i] = src[off + i]
        i += 1
    }
}

fn (w: mut &Wire) fill(n: int): Result[bool, io.IoError] {
    while w.inEnd - w.inPos < n {
        // room for n from inPos: move what is left to the front, or grow
        if w.inPos + n > len(w.inBuf) {
            let have = w.inEnd - w.inPos
            if n > len(w.inBuf) {
                var nb = array(if n > 2 * len(w.inBuf) { n } else { 2 * len(w.inBuf) }, byte(0))
                if have >= 32 { copySliceSimd(mut &nb, &w.inBuf, w.inPos, have) }
                else { for i in 0..have { nb[i] = w.inBuf[w.inPos + i] } }
                w.inBuf = nb
            } else {
                if have >= 32 { shiftLeftSimd(mut &w.inBuf, w.inPos, have) }
                else { for i in 0..have { w.inBuf[i] = w.inBuf[w.inPos + i] } }
            }
            w.inPos = 0
            w.inEnd = have
        }
        var got = 0
        if len(w.eng) == 0 {
            got = try w.c.read(mut &w.inBuf[w.inEnd..len(w.inBuf)])
        } else {
            got = try tlsRead(mut &w.eng[0], &w.c, mut &w.raw, mut &w.inBuf[w.inEnd..len(w.inBuf)])
        }
        if got == 0 { return Ok(false) }
        w.inEnd += got
    }
    return Ok(true)
}

// ---- TLS (9.81): lib/tls's engine between the socket and the messages

fn tlsErr(x: &tls.Error): io.IoError { return io.ioError(71, &("tls: " + x.toStr()), "") }

// What the engine has to send (handshake records, alerts, tickets), sent.
fn tlsSend(e: mut &tls.Engine, c: &net.Conn): Result[Unit, io.IoError] {
    if e.pending() > 0 {
        let out = e.takeOutput()
        try c.write(&out)
    }
    return Ok(Unit{})
}

// Plaintext into buf: as many bytes as are there, reading the socket for
// more when the engine needs it; 0 at the end (close_notify, or the socket's).
fn tlsRead(e: mut &tls.Engine, c: &net.Conn, raw: mut &[]byte, buf: mut &[byte]): Result[int, io.IoError] {
    while true {
        let n = match e.read(buf) {
            Ok(k) { k }
            Err(x) { return Err(tlsErr(&x)) }
        }
        try tlsSend(e, c)
        if n != tls.WANT_INPUT { return Ok(n) }
        let got = try c.read(mut &raw[0..len(raw)])
        if got == 0 { return Ok(0) }
        e.feed(&raw[0..got])
    }
    return Ok(0)
}

// The handshake, after S was sent: Ok(false) if it failed or the client went.
fn (w: mut &Wire) tlsAccept(ctx: &tls.Context): Result[bool, io.IoError] {
    var e = match ctx.engine("") {
        Ok(x) { x }
        Err(_) { return Ok(false) }
    }
    var raw = array(16384, byte(0))
    while true {
        let r = e.handshake()
        try tlsSend(mut &e, &w.c)
        match r {
            Ok(done) { if done { break } }
            Err(_) { return Ok(false) }
        }
        let got = try w.c.read(mut &raw)
        if got == 0 { return Ok(false) }
        e.feed(&raw[0..got])
    }
    w.bind = e.ownEndPoint().unwrapOr("")
    w.raw = raw
    w.eng = [e]
    return Ok(true)
}

fn (w: mut &Wire) take(n: int): str {
    if n == 0 { return "" }
    let s = strFromBytes(&w.inBuf[w.inPos..w.inPos + n])
    w.inPos += n
    if w.inPos == w.inEnd {
        w.inPos = 0
        w.inEnd = 0
    }
    return s
}

fn (w: mut &Wire) advance(n: int) {
    w.inPos += n
    if w.inPos == w.inEnd {
        w.inPos = 0
        w.inEnd = 0
    }
}

// A message: its type byte (0 for the startup packet, which has none) and
// its body. None at the end of the stream.
type Msg = value record { typ: byte; body: str }

fn (w: mut &Wire) readMsg(startup: bool): Result[Option[Msg], io.IoError] {
    var typ: byte = 0
    if !startup {
        if !(try w.fill(1)) { return Ok(None) }
        typ = w.inBuf[w.inPos]
        w.advance(1)
    }
    if !(try w.fill(4)) { return Ok(None) }
    let p = w.inPos
    let n = (int(w.inBuf[p]) << 24) | (int(w.inBuf[p + 1]) << 16) | (int(w.inBuf[p + 2]) << 8) | int(w.inBuf[p + 3])
    w.advance(4)
    if n < 4 || n > MAX_MESSAGE { return Ok(None) }
    if !(try w.fill(n - 4)) { return Ok(None) }
    return Ok(Some(Msg{typ: typ, body: w.take(n - 4)}))
}

// A zero-copy cursor over a borrowed message body.
type Rd = value record { at: int; bad: bool }

fn (r: mut &Rd) i16(s: &str): int {
    if r.at + 2 > len(s) {
        r.bad = true
        return 0
    }
    let v = binary.readI16BEStr(s, r.at)
    r.at += 2
    return v
}

fn (r: mut &Rd) i32(s: &str): int {
    if r.at + 4 > len(s) {
        r.bad = true
        return 0
    }
    let v = binary.readI32BEStr(s, r.at)
    r.at += 4
    return v
}

fn (r: mut &Rd) cstr(s: &str): str {
    let i = strFindByte(s, r.at, byte(0))
    if i < 0 {
        r.bad = true
        return ""
    }
    let st = r.at
    r.at = i + 1
    if i == st { return "" }
    return s[st..i].clone()
}

fn (r: mut &Rd) cstrEnd(s: &str): int {
    let i = strFindByte(s, r.at, byte(0))
    if i < 0 {
        r.bad = true
        return -1
    }
    r.at = i + 1
    return i
}

fn (r: mut &Rd) bytes(s: &str, n: int): str {
    if n < 0 || r.at + n > len(s) {
        r.bad = true
        return ""
    }
    let st = r.at
    r.at += n
    if n == 0 { return "" }
    return s[st..st + n].clone()
}

// ---- writing

fn (w: mut &Wire) msg(typ: byte, body: &str) {
    w.out.addByte(typ)
    binary.addU32BE(mut &w.out, len(body) + 4)
    w.out += &(body)
}

fn (w: mut &Wire) empty(typ: byte) {
    w.out.addByte(typ)
    binary.addU32BE(mut &w.out, 4)
}

fn (w: mut &Wire) flush(): Result[Unit, io.IoError] {
    if len(w.out) == 0 { return Ok(Unit{}) }
    let r = sendTo(&w.c, mut &w.eng, w.out.bytes())
    w.out.clear()
    return r
}

// Bytes to the client, through TLS if the connection has it.
fn sendTo(c: &net.Conn, eng: mut &[]tls.Engine, b: &[byte]): Result[Unit, io.IoError] {
    if len(b) == 0 { return Ok(Unit{}) }
    if len(eng) > 0 {
        match eng[0].write(b) {
            Ok(_) {}
            Err(x) { return Err(tlsErr(&x)) }
        }
        return tlsSend(mut &eng[0], c)
    }
    return c.write(b)
}

// A FATAL error, sent now: the connection ends after it.
fn (w: mut &Wire) fatal(state: &str, msg: &str): Result[bool, io.IoError] {
    var b = ""
    b.addByte('S')
    addC(mut &b, &"FATAL")
    b.addByte('V')
    addC(mut &b, &"FATAL")
    b.addByte('C')
    addC(mut &b, state)
    b.addByte('M')
    addC(mut &b, msg)
    b.addByte(0)
    w.msg('E', &b)
    try w.flush()
    return Ok(false)
}

fn addC(b: mut &str, s: &str) {
    b += s
    b.addByte(0)
}

fn (w: mut &Wire) paramStatus(name: &str, value: &str) {
    var b = ""
    addC(mut &b, &name)
    addC(mut &b, &value)
    w.msg('S', &b)
}

fn (w: mut &Wire) error(e: &lexdb_base.DbErr) {
    var b = ""
    let sev = if e.state == "57P01" { "FATAL" } else { "ERROR" }
    b.addByte('S')
    addC(mut &b, &sev)
    b.addByte('V')
    addC(mut &b, &sev)
    b.addByte('C')
    addC(mut &b, &e.state)
    b.addByte('M')
    addC(mut &b, &e.msg)
    if e.detail != "" {
        b.addByte('D')
        addC(mut &b, &e.detail)
    }
    if e.hint != "" {
        b.addByte('H')
        addC(mut &b, &e.hint)
    }
    if e.context != "" {
        b.addByte('W')
        addC(mut &b, &e.context)
    }
    b.addByte(0)
    w.sendNotices()
    w.msg('E', &b)
}

// The statement's notices (lexdb_exec notice: IF EXISTS's "skipping" and
// the like, 9.117), as NoticeResponse messages, before its end.
fn (w: mut &Wire) sendNotices() {
    for n in w.sess.takeNotices() {
        var b = ""
        b.addByte('S')
        addC(mut &b, &"NOTICE")
        b.addByte('V')
        addC(mut &b, &"NOTICE")
        b.addByte('C')
        addC(mut &b, &n.state)
        b.addByte('M')
        addC(mut &b, &n.msg)
        if n.detail != "" {
            b.addByte('D')
            addC(mut &b, &n.detail)
        }
        b.addByte(0)
        w.msg('N', &b)
    }
}

fn (w: mut &Wire) ready() {
    // TimeZone changed (SET, set_config, a block's end): the client is told
    // before ReadyForQuery, as PostgreSQL reports a GUC_REPORT setting (9.95)
    let tz = w.sess.zoneName()
    if tz != &w.tzShown {
        let tzc = tz.clone()
        w.paramStatus("TimeZone", &tzc)
        w.tzShown = tzc
    }
    w.out.addByte('Z')
    binary.addU32BE(mut &w.out, 5)
    w.out.addByte(w.sess.status())
}

fn typLen(oid: int): int {
    if oid == lexdb_sql.OID_INT8 { return 8 }
    if oid == lexdb_sql.OID_INT4 { return 4 }
    if oid == lexdb_sql.OID_INT2 { return 2 }
    if oid == lexdb_sql.OID_BOOL { return 1 }
    if oid == lexdb_sql.OID_FLOAT8 { return 8 }
    if oid == lexdb_sql.OID_FLOAT4 { return 4 }
    if oid == lexdb_sql.OID_OID { return 4 }
    return -1
}

fn rowDescFramed(cols: &[]lexdb_bind.OutCol): str {
    var b = ""
    binary.addU16BE(mut &b, len(cols))
    for c in cols {
        addC(mut &b, &c.label())
        binary.addU32BE(mut &b, 0)          // table OID
        binary.addU16BE(mut &b, 0)          // column number
        binary.addU32BE(mut &b, c.oid)
        binary.addU16BE(mut &b, typLen(c.oid) & 0xFFFF)
        binary.addU32BE(mut &b, 0xFFFFFFFF) // typmod -1
        binary.addU16BE(mut &b, 0)          // text
    }
    var m = ""
    m.addByte('T')
    binary.addU32BE(mut &m, len(b) + 4)
    m += &b
    return m
}

fn (w: mut &Wire) rowDesc(cols: &[]lexdb_bind.OutCol) {
    w.out += &rowDescFramed(cols)
}

// DataRows, written straight into the output (each value's text made once;
// a timestamptz's in the session's zone: 9.95).
fn (w: mut &Wire) dataRows(rows: &[][]Val, cols: &[]lexdb_bind.OutCol) {
    let zone = w.sess.zone()
    for r in rows { w.dataRow(r, cols, &zone) }
}

fn (w: mut &Wire) dataRow(r: &[]Val, cols: &[]lexdb_bind.OutCol, zone: &lexdb_time.Zone) {
    let utc = zone.isUtc()
    let nc = len(r)
    var buf: []byte = withCapacity(64 + 16 * nc)
    let at0 = bytesGrow(mut &buf, 7)
    buf[at0] = 'D'
    buf[at0 + 5] = byte((nc >> 8) & 0xff)
    buf[at0 + 6] = byte(nc & 0xff)
    for k in 0..nc {
        let oid = if k < len(cols) { cols[k].oid } else { 0 }
        match r[k] {
            Val.Null { putU32(mut &buf, 0xFFFFFFFF) }
            Val.Int(n) { putInt(mut &buf, n) }
            Val.Bool(v) { putBool(mut &buf, v) }
            Val.Text(t) {
                if plainText(oid, utc) {
                    putU32(mut &buf, len(t))
                    appendStr(mut &buf, &t)
                } else {
                    let x = lexdb_ops.textOut(&r[k], oid, zone)
                    putU32(mut &buf, len(x))
                    appendStr(mut &buf, &x)
                }
            }
            else {
                let x = lexdb_ops.textOut(&r[k], oid, zone)
                putU32(mut &buf, len(x))
                appendStr(mut &buf, &x)
            }
        }
    }
    let size = len(buf) - at0 - 1
    buf[at0 + 1] = byte((size >> 24) & 0xff)
    buf[at0 + 2] = byte((size >> 16) & 0xff)
    buf[at0 + 3] = byte((size >> 8) & 0xff)
    buf[at0 + 4] = byte(size & 0xff)
    w.out += strView(mut &buf)
}

// A batch of rows' DataRows (9.101), written from the batch's columns:
// no row, and no value per integer or boolean, made. Into a buffer of
// bytes, added to the output once: a message's length is written when it
// is done, at its start.
fn (w: mut &Wire) dataBatch(ob: &lexdb_rows.OutBatch, cols: &[]lexdb_bind.OutCol, zone: &lexdb_time.Zone) {
    let utc = zone.isUtc()
    let nc = len(ob.kinds)
    var buf: []byte = withCapacity(ob.n * (7 + 12 * nc))
    for j in 0..ob.n {
        let at0 = bytesGrow(mut &buf, 7)
        buf[at0] = 'D'
        buf[at0 + 5] = byte((nc >> 8) & 0xff)
        buf[at0 + 6] = byte(nc & 0xff)
        for o in 0..nc {
            let c = ob.src[o]
            let k = ob.kinds[o]
            if c < 0 {
                let x = &ob.ex[o]
                if x.nul[j] { putU32(mut &buf, 0xFFFFFFFF) }
                else if k == lexdb_exec.BK_BOOL { putBool(mut &buf, x.v[j] == 1) }
                else { putInt(mut &buf, x.v[j]) }
                continue
            }
            let r = ob.idx[j]
            if ob.cols[c].nul[r] {
                putU32(mut &buf, 0xFFFFFFFF)
            } else if k == lexdb_exec.BK_INT {
                putInt(mut &buf, ob.cols[c].v[r])
            } else if k == lexdb_exec.BK_BOOL {
                putBool(mut &buf, ob.cols[c].v[r] == 1)
            } else if k == lexdb_rows.BK_TEXT {
                // a text from the batch's bytes (no value made)
                let oid = if o < len(cols) { cols[o].oid } else { 0 }
                let t = lexdb_rows.obText(ob, o, j)
                if plainText(oid, utc) {
                    putU32(mut &buf, len(t))
                    appendStr(mut &buf, t)
                } else {
                    let x = lexdb_ops.textOut(&Val.Text(t.clone()), oid, zone)
                    putU32(mut &buf, len(x))
                    appendStr(mut &buf, x)
                }
            } else {
                let oid = if o < len(cols) { cols[o].oid } else { 0 }
                match ob.vals[c][r] {
                    Val.Text(t) {
                        if plainText(oid, utc) {
                            putU32(mut &buf, len(t))
                            appendStr(mut &buf, t)
                        } else {
                            let x = lexdb_ops.textOut(&ob.vals[c][r], oid, zone)
                            putU32(mut &buf, len(x))
                            appendStr(mut &buf, x)
                        }
                    }
                    Val.Int(n) { putInt(mut &buf, n) }
                    Val.Null { putU32(mut &buf, 0xFFFFFFFF) }
                    else {
                        let x = lexdb_ops.textOut(&ob.vals[c][r], oid, zone)
                        putU32(mut &buf, len(x))
                        appendStr(mut &buf, x)
                    }
                }
            }
        }
        let size = len(buf) - at0 - 1
        buf[at0 + 1] = byte((size >> 24) & 0xff)
        buf[at0 + 2] = byte((size >> 16) & 0xff)
        buf[at0 + 3] = byte((size >> 8) & 0xff)
        buf[at0 + 4] = byte(size & 0xff)
    }
    w.out += strView(mut &buf)
}

// (Each value's bytes are added at once, bytesGrow, and written by index.)
fn putU32(out: mut &[]byte, n: int) {
    binary.setU32BE(out, bytesGrow(out, 4), n)
}

fn putBool(out: mut &[]byte, v: bool) {
    let at = bytesGrow(out, 5)
    out[at + 3] = 1
    out[at + 4] = if v { 't' } else { 'f' }
}

const PAIRS: str = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"

// An integer's text, its length first: its digits written from the end,
// two at a time (handles both non-negative and negative values without allocating).
fn putInt(out: mut &[]byte, n: int) {
    if n == -9223372036854775807 - 1 {
        let at = bytesGrow(out, 24)
        out[at + 3] = 20
        let minS = "-9223372036854775808"
        for i in 0..20 { out[at + 4 + i] = minS[i] }
        return
    }
    var neg = false
    var v = n
    if v < 0 {
        neg = true
        v = -v
    }
    var nd = 1
    var p = 10
    while nd < 19 && v >= p {
        nd += 1
        if nd < 19 { p = p * 10 }
    }
    let extra = if neg { 1 } else { 0 }
    let tot = extra + nd
    let at = bytesGrow(out, 4 + tot)
    out[at + 3] = byte(tot)
    if neg { out[at + 4] = '-' }
    var k = at + 4 + tot - 1
    while v >= 100 {
        let r = (v % 100) * 2
        v = v / 100
        out[k] = PAIRS[r + 1]
        out[k - 1] = PAIRS[r]
        k -= 2
    }
    if v >= 10 {
        out[k] = PAIRS[v * 2 + 1]
        out[k - 1] = PAIRS[v * 2]
    } else {
        out[k] = byte(48 + v)
    }
}

// Whether a text value is sent as it is (textOut gives it unchanged): all
// but a timestamptz held as text, or an array of them, outside UTC.
fn plainText(oid: int, utc: bool): bool {
    return utc || (oid != lexdb_sql.OID_TSTZ && (oid <= 0 || lexdb_sql.elemOid(oid) != lexdb_sql.OID_TSTZ))
}

// A statement run with a SELECT's rows sent as they are made
// (Session.runRows), the output flushed each 64 kB, so a large result is
// never held whole: in the session, nor here. desc: send RowDescription
// first (the simple protocol; the extended one's comes from Describe).
// check: the columns Describe gave, which a streamed result must match
// (else its rows are held, and executeMsg refuses them). The session is out
// of w while it runs, so that the closure can use w's connection.
fn (w: mut &Wire) runStreamed(s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &lexdb_exec.PlanCache,
                              desc: bool, hasCheck: bool, checkCols: &[]lexdb_bind.OutCol): Result[lexdb_exec.Res, lexdb_base.DbErr] {
    let zone = w.sess.zone()
    w.streamed = false
    var sess = replace(mut &w.sess, pop(mut &w.parked))
    let r = sess.runRows(s, params, ptypes, pc, fn(cols: &[]lexdb_bind.OutCol, row: &[]Val, ob: &lexdb_rows.OutBatch, start: bool): bool {
        if start {
            if hasCheck && !sameCols(cols, checkCols) { return false }
            if desc { w.rowDesc(cols) }
            w.streamed = true
            return true
        }
        if ob.n > 0 { w.dataBatch(ob, cols, &zone) } else { w.dataRow(row, cols, &zone) }
        if len(w.out) > 65536 { return w.flush().isOk() }
        return true
    })
    append(mut &w.parked, replace(mut &w.sess, sess))
    return r
}

fn (w: mut &Wire) complete(tag: &str) {
    w.sendNotices()
    var b = ""
    addC(mut &b, tag)
    w.msg('C', &b)
}

fn protoErr(msg: &str): lexdb_base.DbErr { return lexdb_base.err("08P01", msg) }

// ---- COPY (9.45)

// CopyInResponse ('G') or CopyOutResponse ('H'): text, n columns.
fn (w: mut &Wire) copyResponse(typ: byte, n: int) {
    var b = ""
    b.addByte(byte(0))
    binary.addU16BE(mut &b, n)
    for i in 0..n { binary.addU16BE(mut &b, 0) }
    w.msg(typ, &b)
}

// COPY TO STDOUT: its lines, a CopyData each, then CopyDone.
fn (w: mut &Wire) copyOut(r: &lexdb_exec.Res) {
    w.copyResponse('H', len(r.cols))
    for row in r.rows {
        let l = lexdb_sql.text(&row[0])
        w.out.addByte('d')
        binary.addU32BE(mut &w.out, len(l) + 4)
        w.out += &l
        if len(w.out) > 65536 { let f = w.flush() }
    }
    w.empty('c')
}

fn isCopyTo(s: &lexdb_sql.Stmt): bool { return s.kind == lexdb_sql.S_COPY && !s.copy.from }

// COPY ... TO STDOUT, its lines sent as they are made (Session.runOut):
// CopyOutResponse before the first, CopyDone after the last. The session
// is out of w while it runs, so that the closure sending the lines can use
// w's connection.
fn (w: mut &Wire) copyTo(s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &lexdb_exec.PlanCache): Result[lexdb_exec.Res, lexdb_base.DbErr] {
    var sess = replace(mut &w.sess, lexdb_exec.parkedSession(w.st.share()))
    var started = false
    let r = sess.runOut(s, params, ptypes, pc, fn(n: int, b: &[]byte): bool {
        if !started {
            w.copyResponse('H', n)
            started = true
        }
        if w.flush().isErr() { return false }
        return sendTo(&w.c, mut &w.eng, b).isOk()
    })
    let parked = replace(mut &w.sess, sess)
    if started && r.isOk() { w.empty('c') }
    return r
}

// COPY FROM STDIN: asks for the data (n columns), and the session reads it
// as it comes (Session.copyInFrom, 9.87): a part is the CopyData messages
// here, up to about 64 kB, the last at CopyDone or CopyFail. Flush and Sync
// are ignored meanwhile, as PostgreSQL does; another message ends it with
// an error. The session is out of w while it runs, so that the closure can
// read w's connection. CopyData after the statement ends (an error part
// way) is dropped by step.
fn (w: mut &Wire) copyFrom(s: &lexdb_sql.Stmt, cols: &[]lexdb_bind.OutCol): Result[lexdb_exec.Res, lexdb_base.DbErr] {
    w.copyResponse('G', len(cols))
    if w.flush().isErr() { return Err(protoErr("the connection was lost during COPY")) }
    var sess = replace(mut &w.sess, lexdb_exec.parkedSession(w.st.share()))
    let r = sess.copyInFrom(s, fn(): lexdb_exec.CopyPart {
        var b = ""
        while true {
            let got = match w.readMsg(false) {
                Ok(m) { m }
                Err(_) { None }
            }
            match got {
                None { return lexdb_exec.CopyPart{rows: [], data: b, end: true, fail: "the connection was lost during COPY", proto: true} }
                Some(m) {
                    if m.typ == 'd' {
                        b += &m.body
                        if len(b) >= 65536 || !w.hasMsg() { return lexdb_exec.CopyPart{rows: [], data: b, end: false, fail: "", proto: false} }
                    } else if m.typ == 'c' {
                        return lexdb_exec.CopyPart{rows: [], data: b, end: true, fail: "", proto: false}
                    } else if m.typ == 'f' {
                        var rd = Rd{at: 0, bad: false}
                        let msg = rd.cstr(&m.body)
                        return lexdb_exec.CopyPart{rows: [], data: "", end: true, fail: if msg == "" { "canceled by the client" } else { msg }, proto: false}
                    } else if m.typ != 'H' && m.typ != 'S' {
                        return lexdb_exec.CopyPart{rows: [], data: "", end: true, proto: true,
                                                   fail: "unexpected message type " + int(m.typ).toStr() + " during COPY from stdin"}
                    }
                }
            }
        }
        return lexdb_exec.CopyPart{rows: [], data: "", end: true, fail: "unreachable", proto: true}
    })
    let parked = replace(mut &w.sess, sess)
    return r
}

// Whether a whole message has been read and waits in the buffer.
fn (w: &Wire) hasMsg(): bool {
    let have = w.inEnd - w.inPos
    if have < 5 { return false }
    return have >= 1 + binary.readI32BE(&w.inBuf, w.inPos + 1)
}

// ---- the simple query protocol

fn isAsciiSpace(b: byte): bool { return b == ' ' || b == '\t' || b == '\n' || b == '\r' }
fn isIdentCh(b: byte): bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_'
}
fn isDigit(b: byte): bool { return b >= '0' && b <= '9' }
fn lowAscii(b: byte): byte { return if b >= 'A' && b <= 'Z' { byte(int(b) + 32) } else { b } }

// Lightweight single-pass auto-parameterizer for simple ad-hoc SELECT ... WHERE ... = <int>
// queries (no quotes, comments, multi-statements, casts, or existing params).
fn autoParamSelect(sql: &str, tmpl: mut &str, params: mut &[]Val): bool {
    let n = len(sql)
    if n < 16 || n > 512 { return false }
    var i = 0
    while i < n && isAsciiSpace(sql[i]) { i += 1 }
    if i + 7 > n { return false }
    if lowAscii(sql[i]) != 's' || lowAscii(sql[i + 1]) != 'e' || lowAscii(sql[i + 2]) != 'l' ||
       lowAscii(sql[i + 3]) != 'e' || lowAscii(sql[i + 4]) != 'c' || lowAscii(sql[i + 5]) != 't' ||
       !isAsciiSpace(sql[i + 6]) { return false }
    tmpl.clear()
    var inWhere = false
    var seenSemi = false
    var p = 0
    while p < n {
        let ch = sql[p]
        if seenSemi {
            if !isAsciiSpace(ch) { return false }
            tmpl.addByte(ch)
            p += 1
            continue
        }
        if ch == '\'' || ch == '"' || ch == '$' || ch == '?' || ch == ':' { return false }
        if ch == '-' && p + 1 < n && sql[p + 1] == '-' { return false }
        if ch == '/' && p + 1 < n && sql[p + 1] == '*' { return false }
        if ch == ';' {
            seenSemi = true
            tmpl.addByte(ch)
            p += 1
            continue
        }
        if !inWhere && (ch == 'w' || ch == 'W') && p + 5 < n &&
           (p == 0 || !isIdentCh(sql[p - 1])) &&
           lowAscii(sql[p + 1]) == 'h' && lowAscii(sql[p + 2]) == 'e' &&
           lowAscii(sql[p + 3]) == 'r' && lowAscii(sql[p + 4]) == 'e' &&
           isAsciiSpace(sql[p + 5]) {
            inWhere = true
        }
        if inWhere && ch == '=' {
            let prevBad = p > 0 && (sql[p - 1] == '=' || sql[p - 1] == '!' || sql[p - 1] == '<' || sql[p - 1] == '>')
            let nextBad = p + 1 < n && sql[p + 1] == '='
            tmpl.addByte(ch)
            p += 1
            if !prevBad && !nextBad && len(params) < 4 {
                while p < n && isAsciiSpace(sql[p]) {
                    tmpl.addByte(sql[p])
                    p += 1
                }
                if p < n && isDigit(sql[p]) {
                    let st = p
                    var v = 0
                    while p < n && isDigit(sql[p]) && p - st < 18 {
                        v = v * 10 + (int(sql[p]) - int('0'))
                        p += 1
                    }
                    let tailOk = p == n || (!isDigit(sql[p]) && sql[p] != '.' && sql[p] != 'e' && sql[p] != 'E' && !isIdentCh(sql[p]))
                    if tailOk {
                        append(mut &params, Val.Int(v))
                        tmpl.addByte('$')
                        tmpl.addByte(byte(int('0') + len(params)))
                        continue
                    }
                    // Not a plain <=18-digit int literal: emit verbatim
                    for q in st..p { tmpl.addByte(sql[q]) }
                    continue
                }
            }
            continue
        }
        tmpl.addByte(ch)
        p += 1
    }
    return len(params) > 0
}

fn autoParamsFit(ptypes: &[]int, params: &[]Val): bool {
    if len(ptypes) != len(params) { return false }
    for i in 0..len(ptypes) {
        let oid = ptypes[i]
        if oid != lexdb_sql.OID_INT2 && oid != lexdb_sql.OID_INT4 && oid != lexdb_sql.OID_INT8 { return false }
        match params[i] {
            Val.Int(v) {
                if oid == lexdb_sql.OID_INT2 && (v < -32768 || v > 32767) { return false }
                if oid == lexdb_sql.OID_INT4 && (v < -2147483648 || v > 2147483647) { return false }
            }
            else { return false }
        }
    }
    return true
}

fn (w: mut &Wire) tryAutoQuery(ps: mut &Ps, sql: &str): Result[bool, io.IoError] {
    var tmpl = ""
    var params: []Val = []
    if !autoParamSelect(sql, mut &tmpl, mut &params) { return Ok(false) }
    let curCat = w.st.changes()
    let curPath = w.sess.pathVersion()
    if !ps.autos.has(&tmpl) {
        match lexdb_parse.parse(&tmpl) {
            Err(_) { return Ok(false) }
            Ok(stmts) {
                if len(stmts) != 1 || stmts[0].kind != lexdb_sql.S_SELECT ||
                   len(stmts[0].wctes) > 0 || len(stmts[0].subs) > 0 ||
                   stmts[0].params != len(params) {
                    return Ok(false)
                }
                let given: []int = array(len(params), 0)
                let ptypes = w.sess.paramTypes(&stmts[0], &given)
                if !autoParamsFit(&ptypes, &params) { return Ok(false) }
                if ps.autos.size() >= 64 { ps.autos = collections.newMapWith(collections.fxHashStr) }
                ps.autos.put(tmpl.clone(), AutoEntry{
                    stmt: stmts[0].clone(),
                    ptypes: ptypes,
                    catAt: curCat,
                    pathAt: curPath,
                    plan: lexdb_exec.newPlanCache(),
                })
            }
        }
    }
    var ent = ps.autos.remove(&tmpl).unwrap()
    if ent.catAt != curCat || ent.pathAt != curPath {
        // Catalog or search_path changed: drop stale entry and fall through cleanly
        return Ok(false)
    }
    if !autoParamsFit(&ent.ptypes, &params) {
        ps.autos.put(tmpl, ent)
        return Ok(false)
    }
    let noCols: []lexdb_bind.OutCol = []
    let r = w.runStreamed(&ent.stmt, &params, &ent.ptypes, mut &ent.plan, true, false, &noCols)
    ps.autos.put(tmpl, ent)
    match r {
        Ok(res) {
            if res.hasRows && !w.streamed {
                w.rowDesc(&res.cols)
                w.dataRows(&res.rows, &res.cols)
            }
            w.complete(&res.tag)
        }
        Err(e) { w.error(&e) }
    }
    if len(w.out) > 65536 { try w.flush() }
    return Ok(true)
}

fn (w: mut &Wire) query(ps: mut &Ps, sql: &str): Result[Unit, io.IoError] {
    // a cancel request that came while the session was idle stops nothing (PostgreSQL's, 9.138)
    if lexdb_base.cancelPending() { let late = lexdb_base.takeCancel(w.sess.number()) }
    // census: lexdb_census.statement(sql)
    if try w.tryAutoQuery(ps, sql) {
        w.ready()
        return w.flush()
    }
    match lexdb_parse.parse(sql) {
        Err(e) { w.error(&e) }
        Ok(stmts) {
            let none: []Val = []
            let nt: []int = []
            if len(stmts) == 1 && stmts[0].kind == lexdb_sql.S_EMPTY {
                w.empty('I')
            } else {
                for s in stmts {
                    var pc1 = lexdb_exec.oneShot()
                    let noCols: []lexdb_bind.OutCol = []
                    var r = if isCopyTo(&s) { w.copyTo(&s, &none, &nt, mut &pc1) }
                            else if s.kind == lexdb_sql.S_SELECT && len(s.wctes) == 0 { w.runStreamed(&s, &none, &nt, mut &pc1, true, false, &noCols) }
                            else { w.sess.run(&s, &none, &nt) }
                    var cols: []lexdb_bind.OutCol = []
                    var copyIn = false
                    match r {
                        Ok(x) {
                            if x.copy == lexdb_exec.COPY_IN {
                                copyIn = true
                                for c in x.cols { append(mut &cols, c.clone()) }
                            }
                        }
                        Err(_) {}
                    }
                    if copyIn { r = w.copyFrom(&s, &cols) }
                    match r {
                        Ok(res) {
                            if res.copy == lexdb_exec.COPY_OUT { w.copyOut(&res) }
                            if res.hasRows && !(s.kind == lexdb_sql.S_SELECT && w.streamed) {
                                w.rowDesc(&res.cols)
                                w.dataRows(&res.rows, &res.cols)
                            }
                            w.complete(&res.tag)
                        }
                        Err(e) {
                            w.error(&e)
                            break
                        }
                    }
                    if len(w.out) > 65536 { try w.flush() }
                }
            }
        }
    }
    w.ready()
    return w.flush()
}

// Fast ASCII integer parser for Bind text parameters (OID_INT4 / OID_INT8).
fn parseFastInt(s: &str, st: int, n: int, oid: int, out: mut &int): bool {
    if n <= 0 || n > 19 { return false }
    var i = st
    let end = st + n
    var neg = false
    if s[i] == '-' {
        neg = true
        i += 1
        if i == end { return false }
    }
    if end - i > 18 { return false }
    var v = 0
    while i < end {
        let c = int(s[i]) - int('0')
        if c < 0 || c > 9 { return false }
        v = v * 10 + c
        i += 1
    }
    if neg { v = -v }
    if oid == lexdb_sql.OID_INT4 && (v < -2147483648 || v > 2147483647) { return false }
    out = v
    return true
}

// ---- the extended query protocol

fn (w: mut &Wire) parseMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{at: 0, bad: false}
    let name = r.cstr(body)
    let sql = r.cstr(body)
    let n = r.i16(body)
    var given: []int = []
    for i in 0..n { append(mut &given, r.i32(body)) }
    if r.bad { return Err(protoErr("invalid Parse message")) }
    var stmts = try lexdb_parse.parse(&sql)
    if len(stmts) > 1 { return Err(lexdb_base.err("42601", "cannot insert multiple commands into a prepared statement")) }
    if len(stmts) == 1 && stmts[0].kind == lexdb_sql.S_EMPTY { stmts = [] }
    var ptypes: []int = []
    if len(stmts) == 1 { ptypes = w.sess.paramTypes(&stmts[0], &given) }
    if name != "" && ps.stmts.has(&name) {
        return Err(lexdb_base.err("42P05", &("prepared statement \"" + name + "\" already exists")))
    }
    ps.stmts.put(name, Prepared{stmts: stmts, ptypes: ptypes, cols: [], rowDescMsg: "", colsAt: -1, pathAt: 0, plan: lexdb_exec.newPlanCache()})
    w.empty('1')
    return Ok(Unit{})
}

fn (w: mut &Wire) bindMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{at: 0, bad: false}
    let pSt = r.at
    let pEnd = r.cstrEnd(body)
    let nSt = r.at
    let nEnd = r.cstrEnd(body)
    let nf = r.i16(body)
    if r.bad { return Err(protoErr("invalid Bind message")) }
    let portal = if pEnd == pSt { "" } else { body[pSt..pEnd].clone() }
    let name = if nEnd == nSt { "" } else { body[nSt..nEnd].clone() }
    // Fast path: all-text parameter formats (nf == 0)
    if nf == 0 {
        let np = r.i16(body)
        if r.bad { return Err(protoErr("invalid Bind message")) }
        if !ps.stmts.has(&name) {
            return Err(lexdb_base.err("26000", &("prepared statement \"" + name + "\" does not exist")))
        }
        let p = ps.stmts.at(&name)
        let need = if len(p.stmts) == 1 { p.stmts[0].params } else { 0 }
        // Parse param slices in place (no intermediate raw array, direct int fast path!)
        var vals: []Val = withCapacity(np)
        var fastOk = true
        let paramAt = r.at
        for i in 0..np {
            let n = r.i32(body)
            if r.bad { return Err(protoErr("invalid Bind message")) }
            if n < 0 {
                append(mut &vals, Val.Null)
                continue
            }
            if r.at + n > len(body) { return Err(protoErr("invalid Bind message")) }
            let st0 = r.at
            r.at += n
            let oid = if i < len(p.ptypes) { p.ptypes[i] } else { lexdb_sql.OID_TEXT }
            if oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT8 {
                var iv = 0
                if parseFastInt(body, st0, n, oid, mut &iv) {
                    append(mut &vals, Val.Int(iv))
                    continue
                }
                fastOk = false
                break
            } else if oid == lexdb_sql.OID_TEXT || oid == lexdb_sql.OID_VARCHAR {
                append(mut &vals, Val.Text(if n == 0 { "" } else { body[st0..st0 + n].clone() }))
                continue
            } else {
                fastOk = false
                break
            }
        }
        if !fastOk {
            r.at = paramAt
            var texts: []Option[str] = withCapacity(np)
            for i in 0..np {
                let n = r.i32(body)
                if n < 0 { append(mut &texts, None) }
                else { append(mut &texts, Some(r.bytes(body, n))) }
            }
            let nr = r.i16(body)
            let fmtAt = r.at
            var anyBin = false
            for i in 0..nr { if r.i16(body) != 0 { anyBin = true } }
            if r.bad { return Err(protoErr("invalid Bind message")) }
            var rfmts: []int = []
            if anyBin { rfmts = try lexdb_pgbin.formats(body, fmtAt, nr) }
            if np != need {
                return Err(protoErr(&("bind message supplies " + np.toStr() + " parameters, but prepared statement \"" + name +
                                    "\" requires " + need.toStr())))
            }
            vals = try w.sess.paramVals(&texts, &p.ptypes)
            ps.putPortal(portal, Portal{stmt: name, params: vals, fmts: rfmts})
            w.empty('2')
            return Ok(Unit{})
        }
        let nr = r.i16(body)
        let fmtAt = r.at
        var anyBin = false
        for i in 0..nr { if r.i16(body) != 0 { anyBin = true } }
        if r.bad { return Err(protoErr("invalid Bind message")) }
        var rfmts: []int = []
        if anyBin { rfmts = try lexdb_pgbin.formats(body, fmtAt, nr) }
        if np != need {
            return Err(protoErr(&("bind message supplies " + np.toStr() + " parameters, but prepared statement \"" + name +
                                "\" requires " + need.toStr())))
        }
        ps.putPortal(portal, Portal{stmt: name, params: vals, fmts: rfmts})
        w.empty('2')
        return Ok(Unit{})
    }
    var fmts: []int = []
    for i in 0..nf { append(mut &fmts, r.i16(body)) }
    let np = r.i16(body)
    var raw: []Option[str] = []
    var isBin: []bool = []
    for i in 0..np {
        let n = r.i32(body)
        if n < 0 {
            append(mut &raw, None)
        } else {
            append(mut &raw, Some(r.bytes(body, n)))
        }
        let f = if nf == 1 { fmts[0] } else if i < nf { fmts[i] } else { 0 }
        append(mut &isBin, f == 1)
    }
    let nr = r.i16(body)
    let fmtAt = r.at
    var anyBin = false
    for i in 0..nr { if r.i16(body) != 0 { anyBin = true } }
    if r.bad { return Err(protoErr("invalid Bind message")) }
    var rfmts: []int = []
    if anyBin { rfmts = try lexdb_pgbin.formats(body, fmtAt, nr) }
    if !ps.stmts.has(&name) {
        return Err(lexdb_base.err("26000", &("prepared statement \"" + name + "\" does not exist")))
    }
    var vals: []Val = []
    {
    let p = ps.stmts.at(&name)
    var texts: []Option[str] = []
    for i in 0..np {
        match raw[i] {
            Some(d) {
                if isBin[i] {
                    let oid = if i < len(p.ptypes) { p.ptypes[i] } else { lexdb_sql.OID_TEXT }
                    append(mut &texts, Some(try lexdb_pgbin.param(&d, oid)))
                } else {
                    append(mut &texts, Some(d.clone()))
                }
            }
            None { append(mut &texts, None) }
        }
    }
    let need = if len(p.stmts) == 1 { p.stmts[0].params } else { 0 }
    if np != need {
        return Err(protoErr(&("bind message supplies " + np.toStr() + " parameters, but prepared statement \"" + name +
                            "\" requires " + need.toStr())))
    }
    vals = try w.sess.paramVals(&texts, &p.ptypes)
    }
    ps.putPortal(portal, Portal{stmt: name, params: vals, fmts: rfmts})
    w.empty('2')
    return Ok(Unit{})
}

fn (w: mut &Wire) describeMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{at: 0, bad: false}
    let kind = r.bytes(body, 1)
    let name = r.cstr(body)
    if r.bad { return Err(protoErr("invalid Describe message")) }
    var stmtName = name.clone()
    var bin = false
    if kind == "P" {
        if !ps.hasPortal(&name) { return Err(lexdb_base.err("34000", &("portal \"" + name + "\" does not exist"))) }
        let po = ps.portalAt(&name)
        stmtName = po.stmt.clone()
        bin = len(po.fmts) > 0
    }
    if !ps.stmts.has(&stmtName) {
        return Err(lexdb_base.err("26000", &("prepared statement \"" + stmtName + "\" does not exist")))
    }
    let p = ps.stmts.at(&stmtName)
    if kind == "S" {
        var b = ""
        binary.addU16BE(mut &b, len(p.ptypes))
        for t in p.ptypes { binary.addU32BE(mut &b, t) }
        w.msg('t', &b)
    }
    if len(p.stmts) == 0 || !lexdb_exec.returnsRows(&p.stmts[0]) {
        w.empty('n')
        return Ok(Unit{})
    }
    // Describing plans the query: libpq describes the portal before every
    // execution, so the columns and pre-framed 'T' bytes are kept while the catalog is unchanged.
    let now = w.st.changes()
    if p.colsAt == now && p.pathAt == w.sess.pathVersion() {
        if bin { w.msg('T', &lexdb_pgbin.rowDesc(&p.cols, &ps.portalAt(&name).fmts)) } else { w.out += &p.rowDescMsg }
        return Ok(Unit{})
    }
    let cols = try w.sess.describe(&p.stmts[0], &p.ptypes)
    // (a CALL with no OUT parameters gives no rows)
    if len(cols) == 0 && p.stmts[0].kind == lexdb_sql.S_CALL {
        w.empty('n')
        return Ok(Unit{})
    }
    let framed = rowDescFramed(&cols)
    if bin { w.msg('T', &lexdb_pgbin.rowDesc(&cols, &ps.portalAt(&name).fmts)) } else { w.out += &framed }
    let m = ps.stmts.atMut(&stmtName)
    m.cols = cols
    m.rowDescMsg = framed
    m.colsAt = now
    m.pathAt = w.sess.pathVersion()
    return Ok(Unit{})
}

fn (w: mut &Wire) executeMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{at: 0, bad: false}
    let portal = r.cstr(body)
    let maxRows = r.i32(body)
    if r.bad { return Err(protoErr("invalid Execute message")) }
    if !ps.hasPortal(&portal) { return Err(lexdb_base.err("34000", &("portal \"" + portal + "\" does not exist"))) }
    if lexdb_base.cancelPending() { let late = lexdb_base.takeCancel(w.sess.number()) }
    let name = ps.portalAt(&portal).stmt.clone()
    if len(ps.stmts.at(&name).stmts) == 0 {
        w.empty('I')
        return Ok(Unit{})
    }
    // the statement's plan, out for the run and back after it
    var plan = replace(mut &ps.stmts.atMut(&name).plan, lexdb_exec.oneShot())
    let ran = w.runPortal(ps, &portal, &name, mut &plan)
    ps.stmts.atMut(&name).plan = plan
    var res = try ran
    if res.copy == lexdb_exec.COPY_IN {
        let cols = replace(mut &res.cols, [])
        res = try w.copyFrom(&ps.stmts.at(&name).stmts[0], &cols)
    }
    if res.copy == lexdb_exec.COPY_OUT {
        w.copyOut(&res)
        w.complete(&res.tag)
        return Ok(Unit{})
    }
    // Rows unlike those Describe gave (an ALTER TABLE since): the client
    // would read them by the old description (PostgreSQL refuses too).
    let p = ps.stmts.at(&name)
    if res.hasRows && p.colsAt >= 0 && !sameCols(&res.cols, &p.cols) {
        return Err(lexdb_base.err("0A000", "cached plan must not change result type"))
    }
    if res.hasRows {
        let fmts = &ps.portalAt(&portal).fmts
        if len(fmts) > 0 { lexdb_pgbin.dataRows(mut &w.out, &res.rows, &res.cols, fmts, &w.sess.zone()) } else { w.dataRows(&res.rows, &res.cols) }
    }
    w.complete(&res.tag)
    return Ok(Unit{})
}

fn sameCols(a: &[]lexdb_bind.OutCol, b: &[]lexdb_bind.OutCol): bool {
    if len(a) != len(b) { return false }
    for i in 0..len(a) { if a[i].name != b[i].name || a[i].oid != b[i].oid { return false } }
    return true
}

fn (w: mut &Wire) runPortal(ps: &Ps, portal: &str, name: &str, plan: mut &lexdb_exec.PlanCache): Result[lexdb_exec.Res, lexdb_base.DbErr] {
    let po = ps.portalAt(portal)
    let p = ps.stmts.at(name)
    if isCopyTo(&p.stmts[0]) { return w.copyTo(&p.stmts[0], &po.params, &p.ptypes, plan) }
    if p.stmts[0].kind == lexdb_sql.S_SELECT && len(p.stmts[0].wctes) == 0 {
        let hasCheck = p.colsAt >= 0
        if len(po.fmts) > 0 { return w.runStreamedBin(&p.stmts[0], &po.params, &p.ptypes, plan, hasCheck, &p.cols, &po.fmts) }
        return w.runStreamed(&p.stmts[0], &po.params, &p.ptypes, plan, false, hasCheck, &p.cols)
    }
    return w.sess.runCached(&p.stmts[0], &po.params, &p.ptypes, plan)
}

fn (w: mut &Wire) closeMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{at: 0, bad: false}
    let kind = r.bytes(body, 1)
    let name = r.cstr(body)
    if kind == "S" {
        let gone = ps.stmts.remove(&name)
    } else {
        ps.dropPortal(&name)
    }
    w.empty('3')
    return Ok(Unit{})
}

// ---- a connection

fn startup(w: mut &Wire, ctx: &[]tls.Context): Result[bool, io.IoError] {
    while true {
        match try w.readMsg(true) {
            None { return Ok(false) }
            Some(m) {
                let code = if len(m.body) >= 4 { binary.readI32BEStr(&m.body, 0) } else { 0 }
                if code == SSL_REQUEST && len(ctx) > 0 && len(w.eng) == 0 {
                    // bytes after the request, before TLS: refused (CVE-2021-23214)
                    if w.inPos < w.inEnd { return w.fatal(&"08P01", &"received unencrypted data after SSL request") }
                    try w.c.writeStr("S")
                    if !(try w.tlsAccept(&ctx[0])) { return Ok(false) }
                    continue
                }
                if code == SSL_REQUEST || code == GSS_REQUEST {
                    try w.c.writeStr("N")
                    continue
                }
                if code == CANCEL_REQUEST {
                    // answered by closing the connection, whether it matched or not (PostgreSQL's)
                    if len(m.body) == 12 { cancelSession(&w.st, binary.readI32BEStr(&m.body, 4), binary.readU32BEStr(&m.body, 8)) }
                    return Ok(false)
                }
                if code != PROTOCOL_3 {
                    w.error(&lexdb_base.err("0A000", &("unsupported frontend protocol " + (code >> 16).toStr() + "." + (code & 0xFFFF).toStr())))
                    try w.flush()
                    return Ok(false)
                }
                // the startup parameters: name, value, ..., then an empty name
                var at = 4
                var user = ""
                var zone = ""
                var iso = ""
                while at < len(m.body) {
                    let ke = strings.indexOf(&m.body, "\x00", at)
                    if ke <= at { break }
                    let ve = strings.indexOf(&m.body, "\x00", ke + 1)
                    if ve < 0 { break }
                    let pname = strings.toLowerAscii(m.body[at..ke])
                    let pval = m.body[ke + 1..ve].toStr()
                    if pname == "user" { user = pval }
                    // TimeZone as a startup parameter (pgJDBC sends it; PGTZ libpq's)
                    else if pname == "timezone" { zone = pval }
                    else if pname == "default_transaction_isolation" { iso = pval }
                    else if pname == "options" {
                        let k = "default_transaction_isolation="
                        let pos = strings.indexOf(&strings.toLowerAscii(&pval), k, 0)
                        if pos >= 0 {
                            var v = strings.trim(&(pval[pos + len(k)..len(pval)].toStr()))
                            if len(v) >= 2 && (v[0] == '\'' || v[0] == '"') {
                                let q = v[0]
                                let e = strings.indexOf(&v, &(v[0..1].toStr()), 1)
                                if e > 0 { v = v[1..e].toStr() }
                            } else {
                                let sp = strings.indexOf(&v, " -", 0)
                                if sp > 0 { v = v[0..sp].toStr() }
                            }
                            iso = strings.replaceAll(&v, "\\ ", " ")
                        }
                    }
                    at = ve + 1
                }
                if len(user) == 0 { return w.fatal(&"28000", &"no PostgreSQL user name specified in startup packet") }
                w.sess.setUser(&user)
                if zone != "" {
                    match w.sess.startupZone(&zone) {
                        Ok(_) {}
                        Err(x) { return w.fatal(&x.state, &x.msg) }
                    }
                }
                if iso != "" {
                    match w.sess.startupIsolation(&iso) {
                        Ok(_) {}
                        Err(x) { return w.fatal(&x.state, &x.msg) }
                    }
                }
                if !(try w.authenticate(&user)) { return Ok(false) }
                let conf = confOf(&w.st)
                if (if w.c.isUnix() { &conf.local } else { &conf.tcp }) == "scram-sha-256" { w.sess.setSystemUser(&("scram-sha-256:" + user)) }
                var b = ""
                binary.addU32BE(mut &b, 0)
                w.msg('R', &b)                       // AuthenticationOk
                w.paramStatus("server_version", "16.0")
                w.paramStatus("server_encoding", "UTF8")
                w.paramStatus("client_encoding", "UTF8")
                w.paramStatus("DateStyle", "ISO, MDY")
                w.paramStatus("integer_datetimes", "on")
                w.paramStatus("standard_conforming_strings", "on")
                // a replica is a hot standby (9.137): libpq's target_session_attrs reads these two
                let ro = lexdb_standby.standbySetting(&w.st)
                w.paramStatus("default_transaction_read_only", &ro)
                w.paramStatus("in_hot_standby", &ro)
                w.tzShown = w.sess.zone().name
                let tzs = w.tzShown.clone()
                w.paramStatus("TimeZone", &tzs)
                w.paramStatus("application_name", "")
                // BackendKeyData: the session's number (pg_backend_pid) and a random secret, kept for a CancelRequest
                let secret = match crypto.randomBytes(4) {
                    Ok(x) { binary.readU32BEStr(&x, 0) }
                    Err(_) { 0 }
                }
                w.st.memo.put(&cancelKey(w.sess.number()), &secret.toStr())
                var k = ""
                binary.addU32BE(mut &k, w.sess.number())
                binary.addU32BE(mut &k, secret)
                w.msg('K', &k)
                w.ready()
                try w.flush()
                return Ok(true)
            }
        }
    }
    return Ok(false)
}

// ---- cancel requests (9.138)

// The memo's key of a session's cancel secret (BackendKeyData).
fn cancelKey(sid: int): str { return "\x00pgcancel\x00" + sid.toStr() }

// A CancelRequest: session pid is asked to stop its statement if secret is
// its own.
fn cancelSession(st: &lexdb_store.Store, pid: int, secret: int) {
    match st.memo.get(&cancelKey(pid)) {
        Some(v) { if v == secret.toStr() { lexdb_base.askCancel(pid) } }
        None {}
    }
}

// ---- authentication (9.81): as configure set it (the store's memo), by
// the connection's kind: trust, or SCRAM-SHA-256 against the role's verifier

pub type AuthConf = record {
    pub tcp: str                // "trust" or "scram-sha-256": TCP connections
    pub local: str              // ... Unix socket ones
    pub cert: str               // TLS: the certificate chain (PEM) and its key; "" no TLS
    pub key: str
    pub requireTls: bool        // a TCP connection must use TLS
}

pub fn noAuth(): AuthConf { return AuthConf{tcp: "trust", local: "trust", cert: "", key: "", requireTls: false} }

const AUTH_KEY = "\x00auth"

fn authOk(m: &str): bool { return m == "trust" || m == "scram-sha-256" }

// The server's authentication, for its accept loops: checked here (its TLS
// files loaded once), then kept in the store's memo.
pub fn configure(st: &lexdb_store.Store, a: &AuthConf): Result[Unit, str] {
    try checkAuth(a)
    st.memo.put(&AUTH_KEY, &(a.tcp + "\n" + a.local + "\n" + a.cert + "\n" + a.key + "\n" + (if a.requireTls { "1" } else { "0" })))
    return Ok(Unit{})
}

// The settings checked: the methods known, the TLS files loadable.
pub fn checkAuth(a: &AuthConf): Result[Unit, str] {
    if !authOk(&a.tcp) { return Err("unknown authentication method \"" + a.tcp + "\" (trust or scram-sha-256)") }
    if !authOk(&a.local) { return Err("unknown authentication method \"" + a.local + "\" (trust or scram-sha-256)") }
    if a.requireTls && len(a.cert) == 0 { return Err("--require-tls needs --tls-cert") }
    if len(a.cert) > 0 {
        match tlsContext(a) {
            Ok(_) {}
            Err(x) { return Err(x.toStr()) }
        }
    }
    return Ok(Unit{})
}

pub fn confOf(st: &lexdb_store.Store): AuthConf {
    match st.memo.get(&AUTH_KEY) {
        Some(v) {
            let f = strings.split(&v, "\n")
            if len(f) == 5 { return AuthConf{tcp: f[0].toStr(), local: f[1].toStr(), cert: f[2].toStr(), key: f[3].toStr(), requireTls: f[4] == "1"} }
        }
        None {}
    }
    return noAuth()
}

fn tlsContext(a: &AuthConf): Result[tls.Context, tls.Error] {
    var o = tls.defaults()
    o.certFile = a.cert.clone()
    o.keyFile = if len(a.key) > 0 { a.key.clone() } else { a.cert.clone() }
    return tls.server(o)
}

fn (w: mut &Wire) authenticate(user: &str): Result[bool, io.IoError] {
    let conf = confOf(&w.st)
    let local = w.c.isUnix()
    if !local && conf.requireTls && len(w.eng) == 0 {
        return w.fatal(&"28000", &"lexdb: a TCP connection must use TLS (sslmode=require)")
    }
    if (if local { &conf.local } else { &conf.tcp }) != "scram-sha-256" { return Ok(true) }
    let rs = match lexdb_priv.roles(&w.st) {
        Ok(x) { x }
        Err(x) { return w.fatal(&x.state, &x.msg) }
    }
    var ver: Option[lexdb_auth.Verifier] = None
    var login = false
    for r in rs {
        if r.name == user {
            ver = lexdb_auth.parseVerifier(&r.verifier)
            login = r.login
        }
    }
    let plus = len(w.eng) > 0 && len(w.bind) > 0
    // AuthenticationSASL: the mechanisms, the bound one first when there is TLS
    var b = ""
    binary.addU32BE(mut &b, 10)
    if plus { addC(mut &b, &lexdb_auth.MECH_PLUS) }
    addC(mut &b, &lexdb_auth.MECH)
    b.addByte(0)
    w.msg('R', &b)
    try w.flush()
    let fail = "password authentication failed for user \"" + user + "\""
    var sc = match lexdb_auth.begin(ver, plus) {
        Ok(x) { x }
        Err(x) { return w.fatal(&x.state, &x.msg) }
    }
    // SASLInitialResponse: the mechanism, then the client-first-message's length and bytes
    let m1 = match try w.readMsg(false) {
        Some(m) { m }
        None { return Ok(false) }
    }
    if m1.typ != 'p' { return w.fatal(&"08P01", &"expected SASL response") }
    var r1 = Rd{at: 0, bad: false}
    let mech = r1.cstr(&m1.body)
    let n1 = r1.i32(&m1.body)
    if r1.bad || n1 < 0 || r1.at + n1 > len(m1.body) { return w.fatal(&"08P01", &"malformed SASL message") }
    let first = match lexdb_auth.serverFirst(mut &sc, &mech, &m1.body[r1.at..r1.at + n1]) {
        Ok(x) { x }
        Err(x) { return w.fatal(&x.state, &x.msg) }
    }
    var c = ""
    binary.addU32BE(mut &c, 11)                 // AuthenticationSASLContinue
    c += &first
    w.msg('R', &c)
    try w.flush()
    let m2 = match try w.readMsg(false) {
        Some(m) { m }
        None { return Ok(false) }
    }
    if m2.typ != 'p' { return w.fatal(&"08P01", &"expected SASL response") }
    let fin = match lexdb_auth.serverFinal(mut &sc, &m2.body, &w.bind) {
        Ok(x) { x }
        Err(x) { return w.fatal(&x.state, &(if x.state == "28P01" { fail } else { x.msg.clone() })) }
    }
    if !login { return w.fatal(&"28000", &("role \"" + user + "\" is not permitted to log in")) }
    var f = ""
    binary.addU32BE(mut &f, 12)                 // AuthenticationSASLFinal
    f += &fin
    w.msg('R', &f)
    return Ok(true)
}

fn (w: mut &Wire) step(ps: mut &Ps, m: &Msg): Result[bool, io.IoError] {
    let t = m.typ
    if t == 'X' { return Ok(false) }
    if t == 'S' {
        w.skipping = false
        w.ready()
        try w.flush()
        return Ok(true)
    }
    if t == 'H' {
        try w.flush()
        return Ok(true)
    }
    if t == 'Q' {
        w.skipping = false
        var r = Rd{at: 0, bad: false}
        let sql = r.cstr(&m.body)
        try w.query(ps, &sql)
        return Ok(true)
    }
    // CopyData, CopyDone and CopyFail outside COPY (one that ended in an
    // error part way): dropped, as PostgreSQL does
    if t == 'd' || t == 'c' || t == 'f' { return Ok(true) }
    if w.skipping { return Ok(true) }
    var res: Result[Unit, lexdb_base.DbErr] = Ok(Unit{})
    if t == 'P' { res = w.parseMsg(ps, &m.body) }
    else if t == 'B' { res = w.bindMsg(ps, &m.body) }
    else if t == 'D' { res = w.describeMsg(ps, &m.body) }
    else if t == 'E' { res = w.executeMsg(ps, &m.body) }
    else if t == 'C' { res = w.closeMsg(ps, &m.body) }
    else { res = Err(protoErr(&("invalid frontend message type " + int(t).toStr()))) }
    match res {
        Ok(_) {}
        Err(e) {
            w.error(&e)
            w.skipping = true
        }
    }
    if len(w.out) > 65536 { try w.flush() }
    return Ok(true)
}

// Serves one client until it says goodbye or goes away.
pub fn serve(a: ConnArg): int {
    let ConnArg{conn: c, st: st, id: _, ctx: ctx} = move(a)
    let nd = c.setNoDelay(true)
    var w = Wire{c: c, eng: [], raw: [], bind: "", inBuf: array(65536, byte(0)), inPos: 0, inEnd: 0, out: "",
                 sess: lexdb_exec.newSession(st.share()), parked: [lexdb_exec.parkedSession(st.share())], st: st,
                 skipping: false, tzShown: "", streamed: false, texts: []}
    var ps = Ps{stmts: collections.newMapWith(collections.fxHashStr), portals: collections.newMapWith(collections.fxHashStr),
                hasUnnamed: false, unnamed: Portal{stmt: "", params: [], fmts: []},
                autos: collections.newMapWith(collections.fxHashStr)}
    if startup(mut &w, &ctx).unwrapOr(false) {
        while true {
            let got = w.readMsg(false)
            if got.isErr() { break }
            match got.unwrap() {
                Some(m) {
                    if !w.step(mut &ps, &m).unwrapOr(false) { break }
                }
                None { break }
            }
        }
    }
    w.st.memo.del(&cancelKey(w.sess.number()))
    if lexdb_base.cancelPending() { let late = lexdb_base.takeCancel(w.sess.number()) }
    w.sess.close()
    return 0
}

pub type AcceptArg = record { pub ln: net.Listener; pub st: lexdb_store.Store }

// Listens on each address (cmd/lexdb.lxl's ADDR, design/lexdb.md 9.54): the TCP ones first,
// so a directory's socket can take the first one's port (its real one when
// it was 0). The Unix socket files made are added to files, on an error too.
pub fn listenAll(addrs: &[]str, files: mut &[]str): Result[[]net.Listener, str] {
    var lns: []net.Listener = []
    var port = "5433"
    for a in addrs {
        if strings.contains(&a, "/") { continue }
        match net.listen(&a) {
            Ok(ln) {
                if len(lns) == 0 {
                    let at = ln.localAddr()
                    let i = strings.lastIndexOf(&at, ":")
                    if i >= 0 { port = at[i + 1..len(at)].clone() }
                }
                append(mut &lns, ln)
            }
            Err(e) { return Err("listen " + a + ": " + e.toStr()) }
        }
    }
    for a in addrs {
        if !strings.contains(&a, "/") { continue }
        let isDir = match fs.stat(&a) { Ok(x) { x.isDir() } Err(_) { false } }
        let path = if !isDir { a.clone() } else if strings.endsWith(&a, "/") { a + ".s.PGSQL." + port } else { a + "/.s.PGSQL." + port }
        try clearStale(&path)
        match net.listenUnix(&path) {
            Ok(ln) {
                append(files, path)
                append(mut &lns, ln)
            }
            Err(e) { return Err("listen " + path + ": " + e.toStr()) }
        }
    }
    return Ok(lns)
}

// Removes a Unix socket file left at path by a server that is gone. A
// socket a server answers on, or a file that is not a socket, is an error:
// neither is replaced.
pub fn clearStale(path: &str): Result[Unit, str] {
    match fs.lstat(path) {
        Ok(x) {
            if x.kind() != fs.Kind.Socket { return Err("listen " + path + ": exists and is not a socket") }
            match net.connectUnixFor(path, 500) {
                Ok(c) { return Err("listen " + path + ": a server is listening on it") }
                Err(_) {
                    match fs.remove(path) {
                        Ok(_) {}
                        Err(e) { return Err("listen " + path + ": removing the stale socket: " + e.toStr()) }
                    }
                }
            }
        }
        Err(_) {}
    }
    return Ok(Unit{})
}

pub type ListenArg = record { pub lns: []net.Listener; pub st: lexdb_store.Store }

// Serves each listener (TCP or a Unix socket, design/lexdb.md 9.54) in an
// accept loop of its own, until the task running it is cancelled.
pub fn acceptAll(a: ListenArg): int {
    var ListenArg{lns: lns, st: st} = move(a)
    task.scope(fn(s: mut &task.Scope) {
        while len(lns) > 0 {
            let ln = pop(mut &lns)
            s.spawn(acceptLoop, AcceptArg{ln: ln, st: st.share()})
        }
    })
    return 0
}

// Accepts connections and serves each in a task of its own, until the task
// running it is cancelled (which cancels the connections' tasks too).
pub fn acceptLoop(a: AcceptArg): int {
    let AcceptArg{ln: ln, st: st} = move(a)
    var id = 0
    // TLS, if configured: one context, shared by the connections
    var ctxs: []tls.Context = []
    let conf = confOf(&st)
    if len(conf.cert) > 0 {
        match tlsContext(&conf) {
            Ok(x) { append(mut &ctxs, x) }
            Err(x) { eprintln("lexdb: tls: " + x.toStr()) }
        }
    }
    task.scope(fn(s: mut &task.Scope) {
        while true {
            match ln.accept() {
                Ok(c) {
                    id += 1
                    var mine: []tls.Context = []
                    if len(ctxs) > 0 { append(mut &mine, ctxs[0].share()) }
                    s.spawn(serve, ConnArg{conn: c, st: st.share(), id: id, ctx: mine})
                }
                Err(e) {
                    if e.isCancelled() || e.isTimeout() { return }
                    eprintln("lexdb: accept: " + e.toStr())
                    let r = task.sleep(100)
                    if r.isErr() { return }
                }
            }
        }
    })
    return 0
}

// ---- binary results (lexdb_pgbin), out of the text path

// runStreamed for a portal with binary columns (fmts, lexdb_pgbin): its rows
// in their formats; its RowDescription comes from Describe.
fn (w: mut &Wire) runStreamedBin(s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &lexdb_exec.PlanCache,
                                 hasCheck: bool, checkCols: &[]lexdb_bind.OutCol, fmts: &[]int): Result[lexdb_exec.Res, lexdb_base.DbErr] {
    let zone = w.sess.zone()
    w.streamed = false
    var sess = replace(mut &w.sess, pop(mut &w.parked))
    let r = sess.runRows(s, params, ptypes, pc, fn(cols: &[]lexdb_bind.OutCol, row: &[]Val, ob: &lexdb_rows.OutBatch, start: bool): bool {
        if start {
            if hasCheck && !sameCols(cols, checkCols) { return false }
            w.streamed = true
            return true
        }
        if ob.n > 0 { lexdb_pgbin.dataBatch(mut &w.out, ob, cols, fmts, &zone) } else { lexdb_pgbin.dataRow(mut &w.out, row, cols, fmts, &zone) }
        if len(w.out) > 65536 { return w.flush().isOk() }
        return true
    })
    append(mut &w.parked, replace(mut &w.sess, sess))
    return r
}
