// lexdb: the PostgreSQL wire protocol, version 3.0, server side
// (design/lexdb.md 4.7). One task per connection.
//
// Startup: an SSLRequest or GSSENCRequest is answered 'N' (no TLS yet), a
// CancelRequest is ignored, and a StartupMessage is accepted without a
// password (trust: listen on loopback until authentication is built). Then
// the simple query protocol (several statements in one Query), and the
// extended one: Parse, Bind, Describe, Execute, Close, Sync and Flush.
// After an error in the extended protocol the messages up to Sync are
// skipped, as PostgreSQL does. Results are text; parameters may be text or
// binary integers, booleans and text.
import "net"
import "fs"
import "task"
import "io"
import "binary"
import "strings"
import "math"
import "./lexdb_base"
import "./lexdb_store"
import "./lexdb_sql"
import "./lexdb_exec"
import "./lexdb_float"
import "./lexdb_time"
import "./lexdb_auth"
import "tls"

type Val = lexdb_sql.Val

const SSL_REQUEST = 80877103
const GSS_REQUEST = 80877104
const CANCEL_REQUEST = 80877102
const PROTOCOL_3 = 196608
const MAX_MESSAGE = 64 * 1024 * 1024

pub type ConnArg = record { pub conn: net.Conn; pub st: lexdb_store.Store; pub id: int; ctx: []tls.Context }

type Prepared = record {
    stmts: []lexdb_sql.Stmt     // none (an empty query) or one
    ptypes: []int
    cols: []lexdb_exec.OutCol   // its result's columns, as Describe found them
    colsAt: int                 // the catalog's changes then (Store.changes), -1 not yet
    pathAt: int                 // the session's search path then (Session.pathVersion)
    plan: lexdb_exec.PlanCache  // its SELECT's plan, kept between executions
}

type Portal = record {
    stmt: str
    params: []Val
}

type Wire = record {
    c: net.Conn
    eng: []tls.Engine           // after an SSLRequest answered S: the connection's TLS (9.81); [] plain
    raw: []byte                 // with TLS: what is read from the socket, before it is decrypted
    bind: str                   // with TLS: the channel binding data (our certificate's hash); "" none
    inBuf: []byte               // read into directly; [inPos, inEnd) not yet taken
    inPos: int
    inEnd: int
    out: StrBuf
    sess: lexdb_exec.Session
    st: lexdb_store.Store
    skipping: bool
    tzShown: str                // the TimeZone the client was last told (ParameterStatus, 9.95)
    streamed: bool              // the last runStreamed sent its rows as they came (its RowDescription too, if asked)
    texts: []str                // dataRow's values' texts, the array used again for each row
}

// The prepared statements and portals of a connection.
type Ps = record {
    stmts: Map[str, Prepared]
    portals: Map[str, Portal]
}

// ---- reading

fn (w: mut &Wire) fill(n: int): Result[bool, io.IoError] {
    while w.inEnd - w.inPos < n {
        // room for n from inPos: move what is left to the front, or grow
        if w.inPos + n > len(w.inBuf) {
            let have = w.inEnd - w.inPos
            if n > len(w.inBuf) {
                var nb = array(if n > 2 * len(w.inBuf) { n } else { 2 * len(w.inBuf) }, byte(0))
                for i in 0..have { nb[i] = w.inBuf[w.inPos + i] }
                w.inBuf = nb
            } else {
                for i in 0..have { w.inBuf[i] = w.inBuf[w.inPos + i] }
            }
            w.inPos = 0
            w.inEnd = have
        }
        var got = 0
        if len(w.eng) == 0 {
            got = try w.c.read(mut &w.inBuf[w.inEnd..len(w.inBuf)])
        } else {
            got = try tlsRead(mut &w.eng[0], &w.c, mut &w.raw, mut &w.inBuf[w.inEnd..len(w.inBuf)])
        }
        if got == 0 { return Ok(false) }
        w.inEnd += got
    }
    return Ok(true)
}

// ---- TLS (9.81): lib/tls's engine between the socket and the messages

fn tlsErr(x: &tls.Error): io.IoError { return io.ioError(71, &("tls: " + x.toStr()), "") }

// What the engine has to send (handshake records, alerts, tickets), sent.
fn tlsSend(e: mut &tls.Engine, c: &net.Conn): Result[Unit, io.IoError] {
    if e.pending() > 0 {
        let out = e.takeOutput()
        try c.write(&out)
    }
    return Ok(Unit{})
}

// Plaintext into buf: as many bytes as are there, reading the socket for
// more when the engine needs it; 0 at the end (close_notify, or the socket's).
fn tlsRead(e: mut &tls.Engine, c: &net.Conn, raw: mut &[]byte, buf: mut &[byte]): Result[int, io.IoError] {
    while true {
        let n = match e.read(buf) {
            Ok(k) { k }
            Err(x) { return Err(tlsErr(&x)) }
        }
        try tlsSend(e, c)
        if n != tls.WANT_INPUT { return Ok(n) }
        let got = try c.read(mut &raw[0..len(raw)])
        if got == 0 { return Ok(0) }
        e.feed(&raw[0..got])
    }
    return Ok(0)
}

// The handshake, after S was sent: Ok(false) if it failed or the client went.
fn (w: mut &Wire) tlsAccept(ctx: &tls.Context): Result[bool, io.IoError] {
    var e = match ctx.engine("") {
        Ok(x) { x }
        Err(_) { return Ok(false) }
    }
    var raw = array(16384, byte(0))
    while true {
        let r = e.handshake()
        try tlsSend(mut &e, &w.c)
        match r {
            Ok(done) { if done { break } }
            Err(_) { return Ok(false) }
        }
        let got = try w.c.read(mut &raw)
        if got == 0 { return Ok(false) }
        e.feed(&raw[0..got])
    }
    w.bind = e.ownEndPoint().unwrapOr("")
    w.raw = raw
    w.eng = [e]
    return Ok(true)
}

fn (w: mut &Wire) take(n: int): str {
    let s = strFromBytes(&w.inBuf[w.inPos..w.inPos + n])
    w.inPos += n
    if w.inPos == w.inEnd {
        w.inPos = 0
        w.inEnd = 0
    }
    return s
}

// A message: its type byte (0 for the startup packet, which has none) and
// its body. None at the end of the stream.
type Msg = value record { typ: byte; body: str }

fn (w: mut &Wire) readMsg(startup: bool): Result[Option[Msg], io.IoError] {
    var typ: byte = 0
    if !startup {
        if !(try w.fill(1)) { return Ok(None) }
        typ = w.take(1)[0]
    }
    if !(try w.fill(4)) { return Ok(None) }
    let n = binary.readI32BEStr(&w.take(4), 0)
    if n < 4 || n > MAX_MESSAGE { return Ok(None) }
    if !(try w.fill(n - 4)) { return Ok(None) }
    return Ok(Some(Msg{typ: typ, body: w.take(n - 4)}))
}

// A cursor over a message body.
type Rd = record { s: str; at: int; bad: bool }

fn (r: mut &Rd) i16(): int {
    if r.at + 2 > len(r.s) {
        r.bad = true
        return 0
    }
    let v = binary.readI16BEStr(&r.s, r.at)
    r.at += 2
    return v
}

fn (r: mut &Rd) i32(): int {
    if r.at + 4 > len(r.s) {
        r.bad = true
        return 0
    }
    let v = binary.readI32BEStr(&r.s, r.at)
    r.at += 4
    return v
}

fn (r: mut &Rd) cstr(): str {
    var i = r.at
    while i < len(r.s) && r.s[i] != 0 { i += 1 }
    if i >= len(r.s) {
        r.bad = true
        return ""
    }
    let v = r.s[r.at..i]
    r.at = i + 1
    return v
}

fn (r: mut &Rd) bytes(n: int): str {
    if n < 0 || r.at + n > len(r.s) {
        r.bad = true
        return ""
    }
    let v = r.s[r.at..r.at + n]
    r.at += n
    return v
}

// ---- writing

fn (w: mut &Wire) msg(typ: byte, body: &StrBuf) {
    w.out.addByte(typ)
    binary.addU32BE(mut &w.out, body.size() + 4)
    w.out.add(&(body.toStr()))
}

fn (w: mut &Wire) empty(typ: byte) {
    w.out.addByte(typ)
    binary.addU32BE(mut &w.out, 4)
}

fn (w: mut &Wire) flush(): Result[Unit, io.IoError] {
    if w.out.size() == 0 { return Ok(Unit{}) }
    let r = sendTo(&w.c, mut &w.eng, w.out.view())
    w.out.clear()
    return r
}

// Bytes to the client, through TLS if the connection has it.
fn sendTo(c: &net.Conn, eng: mut &[]tls.Engine, b: &[]byte): Result[Unit, io.IoError] {
    if len(b) == 0 { return Ok(Unit{}) }
    if len(eng) > 0 {
        match eng[0].write(b) {
            Ok(_) {}
            Err(x) { return Err(tlsErr(&x)) }
        }
        return tlsSend(mut &eng[0], c)
    }
    return c.write(b)
}

// A FATAL error, sent now: the connection ends after it.
fn (w: mut &Wire) fatal(state: &str, msg: &str): Result[bool, io.IoError] {
    var b = newStrBuf()
    b.addByte('S')
    addC(mut &b, &"FATAL")
    b.addByte('V')
    addC(mut &b, &"FATAL")
    b.addByte('C')
    addC(mut &b, state)
    b.addByte('M')
    addC(mut &b, msg)
    b.addByte(0)
    w.msg('E', &b)
    try w.flush()
    return Ok(false)
}

fn addC(b: mut &StrBuf, s: &str) {
    b.add(s)
    b.addByte(0)
}

fn (w: mut &Wire) paramStatus(name: &str, value: &str) {
    var b = newStrBuf()
    addC(mut &b, &name)
    addC(mut &b, &value)
    w.msg('S', &b)
}

fn (w: mut &Wire) error(e: &lexdb_base.DbErr) {
    var b = newStrBuf()
    let sev = if e.state == "57P01" { "FATAL" } else { "ERROR" }
    b.addByte('S')
    addC(mut &b, &sev)
    b.addByte('V')
    addC(mut &b, &sev)
    b.addByte('C')
    addC(mut &b, &e.state)
    b.addByte('M')
    addC(mut &b, &e.msg)
    if e.detail != "" {
        b.addByte('D')
        addC(mut &b, &e.detail)
    }
    if e.hint != "" {
        b.addByte('H')
        addC(mut &b, &e.hint)
    }
    if e.context != "" {
        b.addByte('W')
        addC(mut &b, &e.context)
    }
    b.addByte(0)
    w.sendNotices()
    w.msg('E', &b)
}

// The statement's notices (lexdb_exec notice: IF EXISTS's "skipping" and
// the like, 9.117), as NoticeResponse messages, before its end.
fn (w: mut &Wire) sendNotices() {
    for n in w.sess.takeNotices() {
        var b = newStrBuf()
        b.addByte('S')
        addC(mut &b, &"NOTICE")
        b.addByte('V')
        addC(mut &b, &"NOTICE")
        b.addByte('C')
        addC(mut &b, &n.state)
        b.addByte('M')
        addC(mut &b, &n.msg)
        if n.detail != "" {
            b.addByte('D')
            addC(mut &b, &n.detail)
        }
        b.addByte(0)
        w.msg('N', &b)
    }
}

fn (w: mut &Wire) ready() {
    // TimeZone changed (SET, set_config, a block's end): the client is told
    // before ReadyForQuery, as PostgreSQL reports a GUC_REPORT setting (9.95)
    let tz = w.sess.zone().name
    if tz != w.tzShown {
        w.paramStatus("TimeZone", &tz)
        w.tzShown = tz
    }
    var b = newStrBuf()
    b.addByte(w.sess.status())
    w.msg('Z', &b)
}

fn typLen(oid: int): int {
    if oid == lexdb_sql.OID_INT8 { return 8 }
    if oid == lexdb_sql.OID_INT4 { return 4 }
    if oid == lexdb_sql.OID_INT2 { return 2 }
    if oid == lexdb_sql.OID_BOOL { return 1 }
    if oid == lexdb_sql.OID_FLOAT8 { return 8 }
    if oid == lexdb_sql.OID_FLOAT4 { return 4 }
    return -1
}

fn (w: mut &Wire) rowDesc(cols: &[]lexdb_exec.OutCol) {
    var b = newStrBuf()
    binary.addU16BE(mut &b, len(cols))
    for c in cols {
        addC(mut &b, &c.label())
        binary.addU32BE(mut &b, 0)          // table OID
        binary.addU16BE(mut &b, 0)          // column number
        binary.addU32BE(mut &b, c.oid)
        binary.addU16BE(mut &b, typLen(c.oid) & 0xFFFF)
        binary.addU32BE(mut &b, 0xFFFFFFFF) // typmod -1
        binary.addU16BE(mut &b, 0)          // text
    }
    w.msg('T', &b)
}

// DataRows, written straight into the output (each value's text made once;
// a timestamptz's in the session's zone: 9.95).
fn (w: mut &Wire) dataRows(rows: &[][]Val, cols: &[]lexdb_exec.OutCol) {
    let zone = w.sess.zone()
    for r in rows { w.dataRow(r, cols, &zone) }
}

fn (w: mut &Wire) dataRow(r: &[]Val, cols: &[]lexdb_exec.OutCol, zone: &lexdb_time.Zone) {
    // Written straight into the output (9.99): a text's bytes need no
    // string of their own; any other value's text is made once (an
    // integer's by the runtime's conversion: faster than its digits a byte
    // at a time, 9.100), kept in w.texts (used again for each row) between
    // the pass that sizes the message and the one that writes it.
    let utc = zone.isUtc()
    while len(w.texts) > 0 { let x = pop(mut &w.texts) }
    var size = 4 + 2
    for k in 0..len(r) {
        let oid = if k < len(cols) { cols[k].oid } else { 0 }
        match r[k] {
            Val.Null { size += 4 }
            Val.Int(n) {
                let x = n.toStr()
                size += 4 + len(x)
                append(mut &w.texts, x)
            }
            Val.Text(t) {
                if plainText(oid, utc) { size += 4 + len(t) } else {
                    let x = lexdb_exec.textOut(&r[k], oid, zone)
                    size += 4 + len(x)
                    append(mut &w.texts, x)
                }
            }
            else {
                let x = lexdb_exec.textOut(&r[k], oid, zone)
                size += 4 + len(x)
                append(mut &w.texts, x)
            }
        }
    }
    w.out.addByte('D')
    binary.addU32BE(mut &w.out, size)
    binary.addU16BE(mut &w.out, len(r))
    var j = 0
    for k in 0..len(r) {
        let oid = if k < len(cols) { cols[k].oid } else { 0 }
        match r[k] {
            Val.Null { binary.addU32BE(mut &w.out, 0xFFFFFFFF) }
            Val.Int(n) {
                binary.addU32BE(mut &w.out, len(w.texts[j]))
                w.out.add(&w.texts[j])
                j += 1
            }
            Val.Text(t) {
                if plainText(oid, utc) {
                    binary.addU32BE(mut &w.out, len(t))
                    w.out.add(&t)
                } else {
                    binary.addU32BE(mut &w.out, len(w.texts[j]))
                    w.out.add(&w.texts[j])
                    j += 1
                }
            }
            else {
                binary.addU32BE(mut &w.out, len(w.texts[j]))
                w.out.add(&w.texts[j])
                j += 1
            }
        }
    }
}

// A batch of rows' DataRows (9.101), written from the batch's columns:
// no row, and no value per integer or boolean, made. Into a buffer of
// bytes, added to the output once: a message's length is written when it
// is done, at its start.
fn (w: mut &Wire) dataBatch(ob: &lexdb_exec.OutBatch, cols: &[]lexdb_exec.OutCol, zone: &lexdb_time.Zone) {
    let utc = zone.isUtc()
    let nc = len(ob.kinds)
    var buf: []byte = withCapacity(ob.n * (7 + 12 * nc))
    for j in 0..ob.n {
        let at0 = len(buf)
        append(mut &buf, 'D')
        putU32(mut &buf, 0)
        append(mut &buf, byte((nc >> 8) & 0xff))
        append(mut &buf, byte(nc & 0xff))
        for o in 0..nc {
            let c = ob.src[o]
            let k = ob.kinds[o]
            if c < 0 {
                let x = &ob.ex[o]
                if x.nul[j] { putU32(mut &buf, 0xFFFFFFFF) }
                else if k == lexdb_exec.BK_BOOL { putBool(mut &buf, x.v[j] == 1) }
                else { putInt(mut &buf, x.v[j]) }
                continue
            }
            let r = ob.idx[j]
            if ob.cols[c].nul[r] {
                putU32(mut &buf, 0xFFFFFFFF)
            } else if k == lexdb_exec.BK_INT {
                putInt(mut &buf, ob.cols[c].v[r])
            } else if k == lexdb_exec.BK_BOOL {
                putBool(mut &buf, ob.cols[c].v[r] == 1)
            } else {
                let oid = if o < len(cols) { cols[o].oid } else { 0 }
                match ob.vals[c][r] {
                    Val.Text(t) {
                        if plainText(oid, utc) {
                            putU32(mut &buf, len(t))
                            appendStr(mut &buf, t)
                        } else {
                            let x = lexdb_exec.textOut(&ob.vals[c][r], oid, zone)
                            putU32(mut &buf, len(x))
                            appendStr(mut &buf, x)
                        }
                    }
                    Val.Int(n) { putInt(mut &buf, n) }
                    Val.Null { putU32(mut &buf, 0xFFFFFFFF) }
                    else {
                        let x = lexdb_exec.textOut(&ob.vals[c][r], oid, zone)
                        putU32(mut &buf, len(x))
                        appendStr(mut &buf, x)
                    }
                }
            }
        }
        let size = len(buf) - at0 - 1
        buf[at0 + 1] = byte((size >> 24) & 0xff)
        buf[at0 + 2] = byte((size >> 16) & 0xff)
        buf[at0 + 3] = byte((size >> 8) & 0xff)
        buf[at0 + 4] = byte(size & 0xff)
    }
    w.out.add(&(strFromBytes(&buf)))
}

fn putU32(out: mut &[]byte, n: int) {
    append(out, byte((n >> 24) & 0xff))
    append(out, byte((n >> 16) & 0xff))
    append(out, byte((n >> 8) & 0xff))
    append(out, byte(n & 0xff))
}

fn putBool(out: mut &[]byte, v: bool) {
    putU32(out, 1)
    append(out, if v { 't' } else { 'f' })
}

const PAIRS: str = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"

// An integer's text, its length first: its digits written from the end,
// two at a time.
fn putInt(out: mut &[]byte, n: int) {
    if n < 0 {
        let x = n.toStr()
        putU32(out, len(x))
        appendStr(out, x)
        return
    }
    var nd = 1
    var p = 10
    while nd < 19 && n >= p {
        nd += 1
        if nd < 19 { p = p * 10 }
    }
    putU32(out, nd)
    let at = len(out)
    for i in 0..nd { append(out, '0') }
    var v = n
    var k = at + nd - 1
    while v >= 100 {
        let r = (v % 100) * 2
        v = v / 100
        out[k] = PAIRS[r + 1]
        out[k - 1] = PAIRS[r]
        k -= 2
    }
    if v >= 10 {
        out[k] = PAIRS[v * 2 + 1]
        out[k - 1] = PAIRS[v * 2]
    } else {
        out[k] = byte(48 + v)
    }
}

// Whether a text value is sent as it is (textOut gives it unchanged): all
// but a timestamptz held as text, or an array of them, outside UTC.
fn plainText(oid: int, utc: bool): bool {
    return utc || (oid != lexdb_sql.OID_TSTZ && (oid <= 0 || lexdb_sql.elemOid(oid) != lexdb_sql.OID_TSTZ))
}

// A statement run with a SELECT's rows sent as they are made
// (Session.runRows), the output flushed each 64 kB, so a large result is
// never held whole: in the session, nor here. desc: send RowDescription
// first (the simple protocol; the extended one's comes from Describe).
// check: the columns Describe gave, which a streamed result must match
// (else its rows are held, and executeMsg refuses them). The session is out
// of w while it runs, so that the closure can use w's connection.
fn (w: mut &Wire) runStreamed(s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &lexdb_exec.PlanCache,
                              desc: bool, check: &Option[[]lexdb_exec.OutCol]): Result[lexdb_exec.Res, lexdb_base.DbErr] {
    let zone = w.sess.zone()
    w.streamed = false
    var sess = replace(mut &w.sess, lexdb_exec.parkedSession(w.st))
    let r = sess.runRows(s, params, ptypes, pc, fn(cols: &[]lexdb_exec.OutCol, row: &[]Val, ob: &lexdb_exec.OutBatch, start: bool): bool {
        if start {
            match check {
                Some(want) { if !sameCols(cols, want) { return false } }
                None {}
            }
            if desc { w.rowDesc(cols) }
            w.streamed = true
            return true
        }
        if ob.n > 0 { w.dataBatch(ob, cols, &zone) } else { w.dataRow(row, cols, &zone) }
        if w.out.size() > 65536 { return w.flush().isOk() }
        return true
    })
    let parked = replace(mut &w.sess, sess)
    return r
}

fn (w: mut &Wire) complete(tag: &str) {
    w.sendNotices()
    var b = newStrBuf()
    addC(mut &b, tag)
    w.msg('C', &b)
}

fn protoErr(msg: &str): lexdb_base.DbErr { return lexdb_base.err("08P01", msg) }

// ---- COPY (9.45)

// CopyInResponse ('G') or CopyOutResponse ('H'): text, n columns.
fn (w: mut &Wire) copyResponse(typ: byte, n: int) {
    var b = newStrBuf()
    b.addByte(byte(0))
    binary.addU16BE(mut &b, n)
    for i in 0..n { binary.addU16BE(mut &b, 0) }
    w.msg(typ, &b)
}

// COPY TO STDOUT: its lines, a CopyData each, then CopyDone.
fn (w: mut &Wire) copyOut(r: &lexdb_exec.Res) {
    w.copyResponse('H', len(r.cols))
    for row in r.rows {
        let l = lexdb_exec.text(&row[0])
        w.out.addByte('d')
        binary.addU32BE(mut &w.out, len(l) + 4)
        w.out.add(&l)
        if w.out.size() > 65536 { let f = w.flush() }
    }
    w.empty('c')
}

fn isCopyTo(s: &lexdb_sql.Stmt): bool { return s.kind == lexdb_sql.S_COPY && !s.copy.from }

// COPY ... TO STDOUT, its lines sent as they are made (Session.runOut):
// CopyOutResponse before the first, CopyDone after the last. The session
// is out of w while it runs, so that the closure sending the lines can use
// w's connection.
fn (w: mut &Wire) copyTo(s: &lexdb_sql.Stmt, params: &[]Val, ptypes: &[]int, pc: mut &lexdb_exec.PlanCache): Result[lexdb_exec.Res, lexdb_base.DbErr] {
    var sess = replace(mut &w.sess, lexdb_exec.parkedSession(w.st))
    var started = false
    let r = sess.runOut(s, params, ptypes, pc, fn(n: int, b: &[]byte): bool {
        if !started {
            w.copyResponse('H', n)
            started = true
        }
        if w.flush().isErr() { return false }
        return sendTo(&w.c, mut &w.eng, b).isOk()
    })
    let parked = replace(mut &w.sess, sess)
    if started && r.isOk() { w.empty('c') }
    return r
}

// COPY FROM STDIN: asks for the data (n columns), and the session reads it
// as it comes (Session.copyInFrom, 9.87): a part is the CopyData messages
// here, up to about 64 kB, the last at CopyDone or CopyFail. Flush and Sync
// are ignored meanwhile, as PostgreSQL does; another message ends it with
// an error. The session is out of w while it runs, so that the closure can
// read w's connection. CopyData after the statement ends (an error part
// way) is dropped by step.
fn (w: mut &Wire) copyFrom(s: &lexdb_sql.Stmt, cols: &[]lexdb_exec.OutCol): Result[lexdb_exec.Res, lexdb_base.DbErr] {
    w.copyResponse('G', len(cols))
    if w.flush().isErr() { return Err(protoErr("the connection was lost during COPY")) }
    var sess = replace(mut &w.sess, lexdb_exec.parkedSession(w.st))
    let r = sess.copyInFrom(s, fn(): lexdb_exec.CopyPart {
        var b = newStrBuf()
        while true {
            let got = match w.readMsg(false) {
                Ok(m) { m }
                Err(_) { None }
            }
            match got {
                None { return lexdb_exec.CopyPart{rows: [], data: b.toStr(), end: true, fail: "the connection was lost during COPY", proto: true} }
                Some(m) {
                    if m.typ == 'd' {
                        b.add(&m.body)
                        if b.size() >= 65536 || !w.hasMsg() { return lexdb_exec.CopyPart{rows: [], data: b.toStr(), end: false, fail: "", proto: false} }
                    } else if m.typ == 'c' {
                        return lexdb_exec.CopyPart{rows: [], data: b.toStr(), end: true, fail: "", proto: false}
                    } else if m.typ == 'f' {
                        var rd = Rd{s: m.body, at: 0, bad: false}
                        let msg = rd.cstr()
                        return lexdb_exec.CopyPart{rows: [], data: "", end: true, fail: if msg == "" { "canceled by the client" } else { msg }, proto: false}
                    } else if m.typ != 'H' && m.typ != 'S' {
                        return lexdb_exec.CopyPart{rows: [], data: "", end: true, proto: true,
                                                   fail: "unexpected message type " + int(m.typ).toStr() + " during COPY from stdin"}
                    }
                }
            }
        }
        return lexdb_exec.CopyPart{rows: [], data: "", end: true, fail: "unreachable", proto: true}
    })
    let parked = replace(mut &w.sess, sess)
    return r
}

// Whether a whole message has been read and waits in the buffer.
fn (w: &Wire) hasMsg(): bool {
    let have = w.inEnd - w.inPos
    if have < 5 { return false }
    return have >= 1 + binary.readI32BE(&w.inBuf, w.inPos + 1)
}

// ---- the simple query protocol

fn (w: mut &Wire) query(sql: &str): Result[Unit, io.IoError] {
    match lexdb_sql.parse(sql) {
        Err(e) { w.error(&e) }
        Ok(stmts) {
            let none: []Val = []
            let nt: []int = []
            if len(stmts) == 1 && stmts[0].kind == lexdb_sql.S_EMPTY {
                w.empty('I')
            } else {
                for s in stmts {
                    var pc1 = lexdb_exec.oneShot()
                    let noCheck: Option[[]lexdb_exec.OutCol] = None
                    var r = if isCopyTo(&s) { w.copyTo(&s, &none, &nt, mut &pc1) }
                            else if s.kind == lexdb_sql.S_SELECT { w.runStreamed(&s, &none, &nt, mut &pc1, true, &noCheck) }
                            else { w.sess.run(&s, &none, &nt) }
                    var cols: []lexdb_exec.OutCol = []
                    var copyIn = false
                    match r {
                        Ok(x) {
                            if x.copy == lexdb_exec.COPY_IN {
                                copyIn = true
                                for c in x.cols { append(mut &cols, c) }
                            }
                        }
                        Err(_) {}
                    }
                    if copyIn { r = w.copyFrom(&s, &cols) }
                    match r {
                        Ok(res) {
                            if res.copy == lexdb_exec.COPY_OUT { w.copyOut(&res) }
                            if res.hasRows && !(s.kind == lexdb_sql.S_SELECT && w.streamed) {
                                w.rowDesc(&res.cols)
                                w.dataRows(&res.rows, &res.cols)
                            }
                            w.complete(&res.tag)
                        }
                        Err(e) {
                            w.error(&e)
                            break
                        }
                    }
                    if w.out.size() > 65536 { try w.flush() }
                }
            }
        }
    }
    w.ready()
    return w.flush()
}

// ---- the extended query protocol

fn (w: mut &Wire) parseMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{s: body, at: 0, bad: false}
    let name = r.cstr()
    let sql = r.cstr()
    let n = r.i16()
    var given: []int = []
    for i in 0..n { append(mut &given, r.i32()) }
    if r.bad { return Err(protoErr("invalid Parse message")) }
    var stmts = try lexdb_sql.parse(&sql)
    if len(stmts) > 1 { return Err(lexdb_base.err("42601", "cannot insert multiple commands into a prepared statement")) }
    if len(stmts) == 1 && stmts[0].kind == lexdb_sql.S_EMPTY { stmts = [] }
    var ptypes: []int = []
    if len(stmts) == 1 { ptypes = w.sess.paramTypes(&stmts[0], &given) }
    if name != "" && ps.stmts.has(&name) {
        return Err(lexdb_base.err("42P05", &("prepared statement \"" + name + "\" already exists")))
    }
    ps.stmts.put(name, Prepared{stmts: stmts, ptypes: ptypes, cols: [], colsAt: -1, pathAt: 0, plan: lexdb_exec.newPlanCache()})
    w.empty('1')
    return Ok(Unit{})
}

// A binary array parameter (one dimension, of the types binParam takes) as
// its text form, as the executor holds arrays (9.27).
fn binArray(data: &str, elem: int): Result[str, lexdb_base.DbErr] {
    let bad = lexdb_base.err("22P03", "invalid binary array parameter")
    if len(data) < 12 { return Err(bad) }
    let ndim = binary.readI32BEStr(data, 0)
    if ndim == 0 { return Ok("{}") }
    if ndim != 1 { return Err(lexdb_base.err("0A000", "lexdb: arrays of more than one dimension are not supported")) }
    if len(data) < 20 { return Err(bad) }
    let n = binary.readI32BEStr(data, 12)
    var at = 20
    var vals: []lexdb_sql.Val = []
    for i in 0..n {
        if at + 4 > len(data) { return Err(bad) }
        let l = binary.readI32BEStr(data, at)
        at += 4
        if l < 0 {
            append(mut &vals, lexdb_sql.Val.Null)
            continue
        }
        if at + l > len(data) { return Err(bad) }
        let t = try binParam(&data[at..at + l], elem)
        at += l
        if elem == lexdb_sql.OID_TEXT || elem == lexdb_sql.OID_VARCHAR || elem == lexdb_sql.OID_BPCHAR {
            append(mut &vals, lexdb_sql.Val.Text(t))
        } else if elem == lexdb_sql.OID_BOOL {
            append(mut &vals, lexdb_sql.Val.Bool(t == "t"))
        } else {
            append(mut &vals, lexdb_sql.Val.Int(strings.parseIntOpt(&t).unwrapOr(0)))
        }
    }
    return Ok(lexdb_exec.arrayText(&vals))
}

fn binParam(data: &str, oid: int): Result[str, lexdb_base.DbErr] {
    if oid == lexdb_sql.OID_INT8 && len(data) == 8 { return Ok(binary.readI64BEStr(data, 0).toStr()) }
    if oid == lexdb_sql.OID_INT4 && len(data) == 4 { return Ok(binary.readI32BEStr(data, 0).toStr()) }
    if oid == lexdb_sql.OID_INT2 && len(data) == 2 { return Ok(binary.readI16BEStr(data, 0).toStr()) }
    if oid == lexdb_sql.OID_BOOL && len(data) == 1 { return Ok(if data[0] != 0 { "t" } else { "f" }) }
    if oid == lexdb_sql.OID_FLOAT8 && len(data) == 8 { return Ok(lexdb_float.fmt8(math.fromBits(binary.readI64BEStr(data, 0)))) }
    if oid == lexdb_sql.OID_FLOAT4 && len(data) == 4 { return Ok(lexdb_float.fmt4(math.fromBits32Int(binary.readU32BEStr(data, 0)))) }
    if oid == lexdb_sql.OID_TEXT || oid == lexdb_sql.OID_VARCHAR || oid == lexdb_sql.OID_BPCHAR { return Ok(data) }
    if lexdb_sql.elemOid(oid) > 0 { return binArray(data, lexdb_sql.elemOid(oid)) }
    return Err(lexdb_base.err("0A000", &("lexdb: a binary parameter of type " + oid.toStr() + " is not supported")))
}

fn (w: mut &Wire) bindMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{s: body, at: 0, bad: false}
    let portal = r.cstr()
    let name = r.cstr()
    let nf = r.i16()
    var fmts: []int = []
    for i in 0..nf { append(mut &fmts, r.i16()) }
    let np = r.i16()
    var raw: []Option[str] = []
    var isBin: []bool = []
    for i in 0..np {
        let n = r.i32()
        if n < 0 {
            append(mut &raw, None)
        } else {
            append(mut &raw, Some(r.bytes(n)))
        }
        let f = if nf == 1 { fmts[0] } else if i < nf { fmts[i] } else { 0 }
        append(mut &isBin, f == 1)
    }
    let nr = r.i16()
    for i in 0..nr {
        if r.i16() != 0 { return Err(lexdb_base.err("0A000", "lexdb: results in binary are not supported")) }
    }
    if r.bad { return Err(protoErr("invalid Bind message")) }
    if !ps.stmts.has(&name) {
        return Err(lexdb_base.err("26000", &("prepared statement \"" + name + "\" does not exist")))
    }
    var vals: []Val = []
    {
    let p = ps.stmts.at(name)
    var texts: []Option[str] = []
    for i in 0..np {
        match raw[i] {
            Some(d) {
                if isBin[i] {
                    let oid = if i < len(p.ptypes) { p.ptypes[i] } else { lexdb_sql.OID_TEXT }
                    append(mut &texts, Some(try binParam(&d, oid)))
                } else {
                    append(mut &texts, Some(d))
                }
            }
            None { append(mut &texts, None) }
        }
    }
    let need = if len(p.stmts) == 1 { p.stmts[0].params } else { 0 }
    if np != need {
        return Err(protoErr(&("bind message supplies " + np.toStr() + " parameters, but prepared statement \"" + name +
                            "\" requires " + need.toStr())))
    }
    vals = try w.sess.paramVals(&texts, &p.ptypes)
    }
    ps.portals.put(portal, Portal{stmt: name, params: vals})
    w.empty('2')
    return Ok(Unit{})
}

fn (w: mut &Wire) describeMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{s: body, at: 0, bad: false}
    let kind = r.bytes(1)
    let name = r.cstr()
    if r.bad { return Err(protoErr("invalid Describe message")) }
    var stmtName = name
    if kind == "P" {
        if !ps.portals.has(&name) { return Err(lexdb_base.err("34000", &("portal \"" + name + "\" does not exist"))) }
        stmtName = ps.portals.at(name).stmt
    }
    if !ps.stmts.has(&stmtName) {
        return Err(lexdb_base.err("26000", &("prepared statement \"" + stmtName + "\" does not exist")))
    }
    let p = ps.stmts.at(stmtName)
    if kind == "S" {
        var b = newStrBuf()
        binary.addU16BE(mut &b, len(p.ptypes))
        for t in p.ptypes { binary.addU32BE(mut &b, t) }
        w.msg('t', &b)
    }
    if len(p.stmts) == 0 || !lexdb_exec.returnsRows(&p.stmts[0]) {
        w.empty('n')
        return Ok(Unit{})
    }
    // Describing plans the query: libpq describes the portal before every
    // execution, so the columns are kept while the catalog is unchanged.
    let now = w.st.changes()
    if p.colsAt == now && p.pathAt == w.sess.pathVersion() {
        w.rowDesc(&p.cols)
        return Ok(Unit{})
    }
    let cols = try w.sess.describe(&p.stmts[0], &p.ptypes)
    w.rowDesc(&cols)
    let m = ps.stmts.atMut(stmtName)
    m.cols = cols
    m.colsAt = now
    m.pathAt = w.sess.pathVersion()
    return Ok(Unit{})
}

fn (w: mut &Wire) executeMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{s: body, at: 0, bad: false}
    let portal = r.cstr()
    let maxRows = r.i32()
    if r.bad { return Err(protoErr("invalid Execute message")) }
    if !ps.portals.has(&portal) { return Err(lexdb_base.err("34000", &("portal \"" + portal + "\" does not exist"))) }
    let name = ps.portals.at(portal).stmt
    if len(ps.stmts.at(name).stmts) == 0 {
        w.empty('I')
        return Ok(Unit{})
    }
    // the statement's plan, out for the run and back after it
    var plan = replace(mut &ps.stmts.atMut(name).plan, lexdb_exec.oneShot())
    let ran = w.runPortal(ps, &portal, &name, mut &plan)
    ps.stmts.atMut(name).plan = plan
    var res = try ran
    if res.copy == lexdb_exec.COPY_IN {
        let cols = replace(mut &res.cols, [])
        res = try w.copyFrom(&ps.stmts.at(name).stmts[0], &cols)
    }
    if res.copy == lexdb_exec.COPY_OUT {
        w.copyOut(&res)
        w.complete(&res.tag)
        return Ok(Unit{})
    }
    // Rows unlike those Describe gave (an ALTER TABLE since): the client
    // would read them by the old description (PostgreSQL refuses too).
    let p = ps.stmts.at(name)
    if res.hasRows && p.colsAt >= 0 && !sameCols(&res.cols, &p.cols) {
        return Err(lexdb_base.err("0A000", "cached plan must not change result type"))
    }
    if res.hasRows { w.dataRows(&res.rows, &res.cols) }
    w.complete(&res.tag)
    return Ok(Unit{})
}

fn sameCols(a: &[]lexdb_exec.OutCol, b: &[]lexdb_exec.OutCol): bool {
    if len(a) != len(b) { return false }
    for i in 0..len(a) { if a[i].name != b[i].name || a[i].oid != b[i].oid { return false } }
    return true
}

fn (w: mut &Wire) runPortal(ps: &Ps, portal: &str, name: &str, plan: mut &lexdb_exec.PlanCache): Result[lexdb_exec.Res, lexdb_base.DbErr] {
    let po = ps.portals.at(portal)
    let p = ps.stmts.at(name)
    if isCopyTo(&p.stmts[0]) { return w.copyTo(&p.stmts[0], &po.params, &p.ptypes, plan) }
    if p.stmts[0].kind == lexdb_sql.S_SELECT {
        var check: Option[[]lexdb_exec.OutCol] = None
        if p.colsAt >= 0 {
            var cs: []lexdb_exec.OutCol = []
            for c in p.cols { append(mut &cs, c) }
            check = Some(cs)
        }
        return w.runStreamed(&p.stmts[0], &po.params, &p.ptypes, plan, false, &check)
    }
    return w.sess.runCached(&p.stmts[0], &po.params, &p.ptypes, plan)
}

fn (w: mut &Wire) closeMsg(ps: mut &Ps, body: &str): Result[Unit, lexdb_base.DbErr] {
    var r = Rd{s: body, at: 0, bad: false}
    let kind = r.bytes(1)
    let name = r.cstr()
    if kind == "S" {
        let gone = ps.stmts.remove(&name)
    } else {
        let gone = ps.portals.remove(&name)
    }
    w.empty('3')
    return Ok(Unit{})
}

// ---- a connection

fn startup(w: mut &Wire, ctx: &[]tls.Context): Result[bool, io.IoError] {
    while true {
        match try w.readMsg(true) {
            None { return Ok(false) }
            Some(m) {
                let code = if len(m.body) >= 4 { binary.readI32BEStr(&m.body, 0) } else { 0 }
                if code == SSL_REQUEST && len(ctx) > 0 && len(w.eng) == 0 {
                    // bytes after the request, before TLS: refused (CVE-2021-23214)
                    if w.inPos < w.inEnd { return w.fatal(&"08P01", &"received unencrypted data after SSL request") }
                    try w.c.writeStr("S")
                    if !(try w.tlsAccept(&ctx[0])) { return Ok(false) }
                    continue
                }
                if code == SSL_REQUEST || code == GSS_REQUEST {
                    try w.c.writeStr("N")
                    continue
                }
                if code == CANCEL_REQUEST { return Ok(false) }
                if code != PROTOCOL_3 {
                    w.error(&lexdb_base.err("0A000", &("unsupported frontend protocol " + (code >> 16).toStr() + "." + (code & 0xFFFF).toStr())))
                    try w.flush()
                    return Ok(false)
                }
                // the startup parameters: name, value, ..., then an empty name
                var at = 4
                var user = ""
                var zone = ""
                while at < len(m.body) {
                    let ke = strings.indexOf(&m.body, "\x00", at)
                    if ke <= at { break }
                    let ve = strings.indexOf(&m.body, "\x00", ke + 1)
                    if ve < 0 { break }
                    if m.body[at..ke] == "user" { user = m.body[ke + 1..ve].toStr() }
                    // TimeZone as a startup parameter (pgJDBC sends it; PGTZ libpq's)
                    if strings.toLowerAscii(m.body[at..ke]) == "timezone" { zone = m.body[ke + 1..ve].toStr() }
                    at = ve + 1
                }
                if len(user) == 0 { return w.fatal(&"28000", &"no PostgreSQL user name specified in startup packet") }
                w.sess.setUser(&user)
                if zone != "" {
                    match w.sess.startupZone(&zone) {
                        Ok(_) {}
                        Err(x) { return w.fatal(&x.state, &x.msg) }
                    }
                }
                if !(try w.authenticate(&user)) { return Ok(false) }
                var b = newStrBuf()
                binary.addU32BE(mut &b, 0)
                w.msg('R', &b)                       // AuthenticationOk
                w.paramStatus("server_version", "16.0")
                w.paramStatus("server_encoding", "UTF8")
                w.paramStatus("client_encoding", "UTF8")
                w.paramStatus("DateStyle", "ISO, MDY")
                w.paramStatus("integer_datetimes", "on")
                w.paramStatus("standard_conforming_strings", "on")
                w.tzShown = w.sess.zone().name
                let tzs = w.tzShown
                w.paramStatus("TimeZone", &tzs)
                w.paramStatus("application_name", "")
                var k = newStrBuf()
                binary.addU32BE(mut &k, 1)
                binary.addU32BE(mut &k, 0)
                w.msg('K', &k)
                w.ready()
                try w.flush()
                return Ok(true)
            }
        }
    }
    return Ok(false)
}

// ---- authentication (9.81): as configure set it (the store's memo), by
// the connection's kind: trust, or SCRAM-SHA-256 against the role's verifier

pub type AuthConf = record {
    pub tcp: str                // "trust" or "scram-sha-256": TCP connections
    pub local: str              // ... Unix socket ones
    pub cert: str               // TLS: the certificate chain (PEM) and its key; "" no TLS
    pub key: str
    pub requireTls: bool        // a TCP connection must use TLS
}

pub fn noAuth(): AuthConf { return AuthConf{tcp: "trust", local: "trust", cert: "", key: "", requireTls: false} }

const AUTH_KEY = "\x00auth"

fn authOk(m: &str): bool { return m == "trust" || m == "scram-sha-256" }

// The server's authentication, for its accept loops: checked here (its TLS
// files loaded once), then kept in the store's memo.
pub fn configure(st: &lexdb_store.Store, a: &AuthConf): Result[Unit, str] {
    try checkAuth(a)
    st.memoPut(&AUTH_KEY, &(a.tcp + "\n" + a.local + "\n" + a.cert + "\n" + a.key + "\n" + (if a.requireTls { "1" } else { "0" })))
    return Ok(Unit{})
}

// The settings checked: the methods known, the TLS files loadable.
pub fn checkAuth(a: &AuthConf): Result[Unit, str] {
    if !authOk(&a.tcp) { return Err("unknown authentication method \"" + a.tcp + "\" (trust or scram-sha-256)") }
    if !authOk(&a.local) { return Err("unknown authentication method \"" + a.local + "\" (trust or scram-sha-256)") }
    if a.requireTls && len(a.cert) == 0 { return Err("--require-tls needs --tls-cert") }
    if len(a.cert) > 0 {
        match tlsContext(a) {
            Ok(_) {}
            Err(x) { return Err(x.toStr()) }
        }
    }
    return Ok(Unit{})
}

pub fn confOf(st: &lexdb_store.Store): AuthConf {
    match st.memoGet(&AUTH_KEY) {
        Some(v) {
            let f = strings.split(&v, "\n")
            if len(f) == 5 { return AuthConf{tcp: f[0].toStr(), local: f[1].toStr(), cert: f[2].toStr(), key: f[3].toStr(), requireTls: f[4] == "1"} }
        }
        None {}
    }
    return noAuth()
}

fn tlsContext(a: &AuthConf): Result[tls.Context, tls.Error] {
    var o = tls.defaults()
    o.certFile = a.cert
    o.keyFile = if len(a.key) > 0 { a.key } else { a.cert }
    return tls.server(o)
}

fn (w: mut &Wire) authenticate(user: &str): Result[bool, io.IoError] {
    let conf = confOf(&w.st)
    let local = w.c.isUnix()
    if !local && conf.requireTls && len(w.eng) == 0 {
        return w.fatal(&"28000", &"lexdb: a TCP connection must use TLS (sslmode=require)")
    }
    if (if local { conf.local } else { conf.tcp }) != "scram-sha-256" { return Ok(true) }
    let rs = match lexdb_exec.roles(&w.st) {
        Ok(x) { x }
        Err(x) { return w.fatal(&x.state, &x.msg) }
    }
    var ver: Option[lexdb_auth.Verifier] = None
    var login = false
    for r in rs {
        if r.name == user {
            ver = lexdb_auth.parseVerifier(&r.verifier)
            login = r.login
        }
    }
    let plus = len(w.eng) > 0 && len(w.bind) > 0
    // AuthenticationSASL: the mechanisms, the bound one first when there is TLS
    var b = newStrBuf()
    binary.addU32BE(mut &b, 10)
    if plus { addC(mut &b, &lexdb_auth.MECH_PLUS) }
    addC(mut &b, &lexdb_auth.MECH)
    b.addByte(0)
    w.msg('R', &b)
    try w.flush()
    let fail = "password authentication failed for user \"" + user + "\""
    var sc = match lexdb_auth.begin(ver, plus) {
        Ok(x) { x }
        Err(x) { return w.fatal(&x.state, &x.msg) }
    }
    // SASLInitialResponse: the mechanism, then the client-first-message's length and bytes
    let m1 = match try w.readMsg(false) {
        Some(m) { m }
        None { return Ok(false) }
    }
    if m1.typ != 'p' { return w.fatal(&"08P01", &"expected SASL response") }
    var r1 = Rd{s: m1.body, at: 0, bad: false}
    let mech = r1.cstr()
    let n1 = r1.i32()
    if r1.bad || n1 < 0 || r1.at + n1 > len(m1.body) { return w.fatal(&"08P01", &"malformed SASL message") }
    let first = match lexdb_auth.serverFirst(mut &sc, &mech, &m1.body[r1.at..r1.at + n1]) {
        Ok(x) { x }
        Err(x) { return w.fatal(&x.state, &x.msg) }
    }
    var c = newStrBuf()
    binary.addU32BE(mut &c, 11)                 // AuthenticationSASLContinue
    c.add(&first)
    w.msg('R', &c)
    try w.flush()
    let m2 = match try w.readMsg(false) {
        Some(m) { m }
        None { return Ok(false) }
    }
    if m2.typ != 'p' { return w.fatal(&"08P01", &"expected SASL response") }
    let fin = match lexdb_auth.serverFinal(mut &sc, &m2.body, &w.bind) {
        Ok(x) { x }
        Err(x) { return w.fatal(&x.state, &(if x.state == "28P01" { fail } else { x.msg })) }
    }
    if !login { return w.fatal(&"28000", &("role \"" + user + "\" is not permitted to log in")) }
    var f = newStrBuf()
    binary.addU32BE(mut &f, 12)                 // AuthenticationSASLFinal
    f.add(&fin)
    w.msg('R', &f)
    return Ok(true)
}

fn (w: mut &Wire) step(ps: mut &Ps, m: &Msg): Result[bool, io.IoError] {
    let t = m.typ
    if t == 'X' { return Ok(false) }
    if t == 'S' {
        w.skipping = false
        w.ready()
        try w.flush()
        return Ok(true)
    }
    if t == 'H' {
        try w.flush()
        return Ok(true)
    }
    if t == 'Q' {
        w.skipping = false
        var r = Rd{s: m.body, at: 0, bad: false}
        let sql = r.cstr()
        try w.query(&sql)
        return Ok(true)
    }
    // CopyData, CopyDone and CopyFail outside COPY (one that ended in an
    // error part way): dropped, as PostgreSQL does
    if t == 'd' || t == 'c' || t == 'f' { return Ok(true) }
    if w.skipping { return Ok(true) }
    var res: Result[Unit, lexdb_base.DbErr] = Ok(Unit{})
    if t == 'P' { res = w.parseMsg(ps, &m.body) }
    else if t == 'B' { res = w.bindMsg(ps, &m.body) }
    else if t == 'D' { res = w.describeMsg(ps, &m.body) }
    else if t == 'E' { res = w.executeMsg(ps, &m.body) }
    else if t == 'C' { res = w.closeMsg(ps, &m.body) }
    else { res = Err(protoErr(&("invalid frontend message type " + int(t).toStr()))) }
    match res {
        Ok(_) {}
        Err(e) {
            w.error(&e)
            w.skipping = true
        }
    }
    if w.out.size() > 65536 { try w.flush() }
    return Ok(true)
}

// Serves one client until it says goodbye or goes away.
pub fn serve(a: ConnArg): int {
    let ConnArg{conn: c, st: st, id: _, ctx: ctx} = move(a)
    let nd = c.setNoDelay(true)
    var w = Wire{c: c, eng: [], raw: [], bind: "", inBuf: array(65536, byte(0)), inPos: 0, inEnd: 0, out: newStrBuf(), sess: lexdb_exec.newSession(st), st: st,
                 skipping: false, tzShown: "", streamed: false, texts: []}
    var ps = Ps{stmts: newMap(), portals: newMap()}
    if startup(mut &w, &ctx).unwrapOr(false) {
        while true {
            let got = w.readMsg(false)
            if got.isErr() { break }
            match got.unwrap() {
                Some(m) {
                    if !w.step(mut &ps, &m).unwrapOr(false) { break }
                }
                None { break }
            }
        }
    }
    w.sess.close()
    return 0
}

pub type AcceptArg = record { pub ln: net.Listener; pub st: lexdb_store.Store }

// Listens on each address (cmd/lexdb.lxl's ADDR, design/lexdb.md 9.54): the TCP ones first,
// so a directory's socket can take the first one's port (its real one when
// it was 0). The Unix socket files made are added to files, on an error too.
pub fn listenAll(addrs: &[]str, files: mut &[]str): Result[[]net.Listener, str] {
    var lns: []net.Listener = []
    var port = "5433"
    for a in addrs {
        if strings.contains(&a, "/") { continue }
        match net.listen(&a) {
            Ok(ln) {
                if len(lns) == 0 {
                    let at = ln.localAddr()
                    let i = strings.lastIndexOf(&at, ":")
                    if i >= 0 { port = at[i + 1..len(at)] }
                }
                append(mut &lns, ln)
            }
            Err(e) { return Err("listen " + a + ": " + e.toStr()) }
        }
    }
    for a in addrs {
        if !strings.contains(&a, "/") { continue }
        let isDir = match fs.stat(&a) { Ok(x) { x.isDir() } Err(_) { false } }
        let path = if !isDir { a } else if strings.endsWith(&a, "/") { a + ".s.PGSQL." + port } else { a + "/.s.PGSQL." + port }
        try clearStale(&path)
        match net.listenUnix(&path) {
            Ok(ln) {
                append(files, path)
                append(mut &lns, ln)
            }
            Err(e) { return Err("listen " + path + ": " + e.toStr()) }
        }
    }
    return Ok(lns)
}

// Removes a Unix socket file left at path by a server that is gone. A
// socket a server answers on, or a file that is not a socket, is an error:
// neither is replaced.
pub fn clearStale(path: &str): Result[Unit, str] {
    match fs.lstat(path) {
        Ok(x) {
            if x.kind() != fs.Kind.Socket { return Err("listen " + path + ": exists and is not a socket") }
            match net.connectUnixFor(path, 500) {
                Ok(c) { return Err("listen " + path + ": a server is listening on it") }
                Err(_) {
                    match fs.remove(path) {
                        Ok(_) {}
                        Err(e) { return Err("listen " + path + ": removing the stale socket: " + e.toStr()) }
                    }
                }
            }
        }
        Err(_) {}
    }
    return Ok(Unit{})
}

pub type ListenArg = record { pub lns: []net.Listener; pub st: lexdb_store.Store }

// Serves each listener (TCP or a Unix socket, design/lexdb.md 9.54) in an
// accept loop of its own, until the task running it is cancelled.
pub fn acceptAll(a: ListenArg): int {
    var ListenArg{lns: lns, st: st} = move(a)
    task.scope(fn(s: mut &task.Scope) {
        while len(lns) > 0 {
            let ln = pop(mut &lns)
            s.spawn(acceptLoop, AcceptArg{ln: ln, st: st})
        }
    })
    return 0
}

// Accepts connections and serves each in a task of its own, until the task
// running it is cancelled (which cancels the connections' tasks too).
pub fn acceptLoop(a: AcceptArg): int {
    let AcceptArg{ln: ln, st: st} = move(a)
    var id = 0
    // TLS, if configured: one context, shared by the connections
    var ctxs: []tls.Context = []
    let conf = confOf(&st)
    if len(conf.cert) > 0 {
        match tlsContext(&conf) {
            Ok(x) { append(mut &ctxs, x) }
            Err(x) { eprintln("lexdb: tls: " + x.toStr()) }
        }
    }
    task.scope(fn(s: mut &task.Scope) {
        while true {
            match ln.accept() {
                Ok(c) {
                    id += 1
                    var mine: []tls.Context = []
                    if len(ctxs) > 0 { append(mut &mine, ctxs[0].share()) }
                    s.spawn(serve, ConnArg{conn: c, st: st, id: id, ctx: mine})
                }
                Err(e) {
                    if e.isCancelled() || e.isTimeout() { return }
                    eprintln("lexdb: accept: " + e.toStr())
                    let r = task.sleep(100)
                    if r.isErr() { return }
                }
            }
        }
    })
    return 0
}
