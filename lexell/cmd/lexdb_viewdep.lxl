// lexdb_viewdep: the views a change to a table breaks, found by planning their queries (the fifth bug slice,
// design/lexdb-robust.md). lexdb keeps a view's query as text and plans it where the view is read (lexdb.md 9.82), so a
// view "uses" a column when its query no longer plans without it, or gives fewer columns than the view has (a SELECT *
// over the table: the view's columns are those of its CREATE).
//
// ALTER TABLE ... DROP COLUMN, per door, as each product does: PostgreSQL refuses the drop of a column a view uses (2BP01,
// with the views in its DETAIL), and its CASCADE drops those views (and the views over them); SQL Server drops it unless a
// view made WITH SCHEMABINDING uses it (5074), and a view that used it fails when read (207, or 4502 for SELECT *); Oracle
// drops it, and a view that used it has errors (ORA-04063 when read, INVALID in USER_OBJECTS, its error in USER_ERRORS). The
// check runs after the table's new definition is written in the statement's transaction: a refusal undoes the statement.
//
// Oracle's USER_OBJECTS.STATUS and USER_ERRORS of a view (viewErrs, for lexdb_oracat): a view whose query does not plan now
// is INVALID, with the error planning it gives (Oracle's: ORA-00904 for a column or a function gone, ORA-04063 for a view
// under it with errors, ORA-04045 and its cause for a property graph). Oracle keeps a view INVALID from the DDL until its
// next use; lexdb's says what the view's query does now (VALID as soon as what it needs is back).
import "strings"
import "./lexdb_base"
import "./lexdb_store"
import "./lexdb_sql"
import "./lexdb_catalog"
import "./lexdb_routine"
import "./lexdb_bind"
import "./lexdb_assert"

type DbErr = lexdb_base.DbErr
type Table = lexdb_catalog.Table
type OutCol = lexdb_bind.OutCol

// The executor's planning of a view's query on its own (as reading the view plans it): its columns.
pub type PlanFn = fn(&lexdb_store.Store, mut &lexdb_store.Txn, &Table): Result[[]OutCol, DbErr]
pub type BumpFn = fn(&lexdb_store.Store, mut &lexdb_store.Txn): Result[Unit, DbErr]

fn err(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

// The errors of a view's query that mean something it reads is gone (a table, a column, a graph or what the graph
// names, a view under it with errors, fewer columns than the view has).
fn gone(pe: &DbErr): bool {
    return pe.state == "42P01" || pe.state == "42703" || pe.state == "ORA42421" || pe.state == "ORA04045" || pe.state == "ORA04063" ||
           pe.state == "TS4502"
}

// A view's planning error as reading the view gives it: an Oracle view whose query no longer plans (a table or a column it
// names renamed or dropped, a graph it reads gone or invalid) has errors (ORA-04063). role: the session's (the owner of an
// unqualified view's name).
pub fn planErr(t: &Table, pe: DbErr, role: &str): DbErr {
    if strings.startsWith(&t.view, lexdb_sql.ORA_VIEW) && gone(&pe) {
        let o = if lexdb_sql.isQual(&t.name) { lexdb_sql.schemaOf(&t.name) } else { role.toStr() }
        return err("ORA04063", &("view \"" + lexdb_sql.oraShown(&o) + "." + lexdb_sql.oraShown(&lexdb_sql.baseName(&t.name)) + "\" has errors"))
    }
    return pe
}

// The first of view t's columns its query's columns (outs) do not have ("" all there).
fn missing(t: &Table, outs: &[]OutCol): str {
    for c in t.cols {
        var have = false
        for o in outs { if o.name == c.name { have = true } }
        if !have { return c.name.clone() }
    }
    return ""
}

// A view whose query gives fewer columns (outs) than the view has (a column under its SELECT * dropped): SQL Server's 4502;
// else 42703 for the first of the view's columns gone (Oracle's ORA-00904 in USER_ERRORS; planErr makes it ORA-04063 when
// the view is read). None: as many.
pub fn fewerErr(t: &Table, outs: &[]OutCol): Option[DbErr] {
    if len(outs) >= len(t.cols) { return None }
    let n = lexdb_sql.baseName(&t.name)
    if strings.startsWith(&t.view, lexdb_sql.TSQL_VIEW) { return Some(err("TS4502", &("View or function '" + n + "' has more column names specified than columns defined."))) }
    let m = missing(t, outs)
    if len(m) > 0 { return Some(err("42703", &("column \"" + m + "\" does not exist"))) }
    return Some(err("42703", &("view \"" + n + "\" has more columns than its query gives (a column it read was dropped)")))
}

// An Oracle view's stored function gone (lexdb_routine.viewPlfGone), as Oracle's error for the view: ORA-00904 for its name.
fn plfGone(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, t: &Table): Result[Option[DbErr], DbErr] {
    let m = lexdb_sql.viewPlf(&t.view)
    if len(m) == 0 { return Ok(None) }
    for c in strings.split(&m, "\x02") {
        if (try lexdb_routine.viewPlfGone(st, txn, &(lexdb_sql.PLF_MARK + c))) != "!" { continue }
        let f = strings.split(c, "\x01")
        return Ok(Some(err("42703", &("column \"" + strings.toLowerAscii(&f[0]) + "\" does not exist"))))
    }
    return Ok(None)
}

// Whether view v (its query planned by plan) is broken now: its error (its query's own, not the view's ORA-04063), or None.
fn broken(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, v: &Table, plan: &PlanFn): Result[Option[DbErr], DbErr] {
    match try plfGone(st, txn, v) {
        Some(x) { return Ok(Some(x)) }
        None {}
    }
    match plan(st, txn, v) {
        Ok(outs) { return Ok(fewerErr(v, &outs)) }
        Err(x) { return Ok(if gone(&x) { Some(x) } else { None }) }
    }
}

// After ALTER TABLE wrote table k's new definition: its DROP COLUMN actions checked against the views that read k (see the
// head of the file), in the door's dialect (s.mdialect).
pub fn afterAlter(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, k: &str, plan: &PlanFn, bump: &BumpFn): Result[Unit, DbErr] {
    var col = ""
    var cascade = false
    var cols = false
    for a in s.alters {
        if a.kind == lexdb_sql.A_DROP_COL {
            if len(col) == 0 { col = a.name.clone() }
            if a.cascade { cascade = true }
        }
        if a.kind == lexdb_sql.A_ADD || a.kind == lexdb_sql.A_DROP_COL || a.kind == lexdb_sql.A_TYPE || a.kind == lexdb_sql.A_RENAME_COL { cols = true }
    }
    // (the assertions that read the table: INVALID, as Oracle's)
    if cols { try lexdb_assert.columnsChanged(st, txn, k) }
    // SQL Server: ALTER COLUMN of a column a view WITH SCHEMABINDING names is 5074
    if s.mdialect == lexdb_sql.MD_TSQL {
        for a in s.alters {
            if a.kind != lexdb_sql.A_TYPE { continue }
            for v in try lexdb_catalog.allViews(st, txn) {
                if lexdb_sql.viewBound(&v.view) && lexdb_base.hasStr(&v.deps, k) && wordIn(&lexdb_sql.viewKept(&v.view), &a.name) {
                    return Err(err("TS5074", &("The object '" + lexdb_sql.baseName(&v.name) + "' is dependent on column '" + a.name + "'.")))
                }
            }
        }
    }
    if len(col) == 0 || s.mdialect == lexdb_sql.MD_ORA { return Ok(Unit{}) }
    let deps = try lexdb_catalog.dependentViews(st, txn, k)
    if len(deps) == 0 { return Ok(Unit{}) }
    var views: []Table = []
    for v in try lexdb_catalog.allViews(st, txn) { if lexdb_base.hasStr(&deps, &v.name) { append(mut &views, v) } }
    let rel = lexdb_sql.baseName(k)
    if s.mdialect == lexdb_sql.MD_TSQL {
        // SQL Server: a view WITH SCHEMABINDING that reads the table and uses the column keeps it
        for v in views {
            if !lexdb_sql.viewBound(&v.view) || !lexdb_base.hasStr(&v.deps, k) { continue }
            if (try broken(st, txn, &v, plan)).isSome() { return Err(err("TS5074", &("The object '" + lexdb_sql.baseName(&v.name) + "' is dependent on column '" + col + "'."))) }
        }
        return Ok(Unit{})
    }
    // PostgreSQL: the views that use the column (directly, or through a view that does)
    var bad: []str = []
    var detail: []str = []
    for v in views {
        if (try broken(st, txn, &v, plan)).isNone() { continue }
        append(mut &bad, v.name.clone())
        var under = ""
        for d in v.deps { if len(under) == 0 && d != k && lexdb_base.hasStr(&deps, &d) { under = d.clone() } }
        let on = if lexdb_base.hasStr(&v.deps, k) || len(under) == 0 { "column " + col + " of table " + rel } else { "view " + lexdb_sql.shown(&under) }
        append(mut &detail, "view " + lexdb_sql.shown(&v.name) + " depends on " + on)
    }
    if len(bad) == 0 { return Ok(Unit{}) }
    if !cascade {
        return Err(lexdb_base.errDetail("2BP01", &("cannot drop column " + col + " of table " + rel + " because other objects depend on it"),
                                        &strings.join(&detail, "\n"), "Use DROP ... CASCADE to drop the dependent objects too."))
    }
    // (the views and their grants, as DROP VIEW ... CASCADE drops them)
    for b in bad {
        txn.del(lexdb_catalog.CATALOG, &b)
        txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.ACL_PRE + lexdb_catalog.relObj(&b)))
    }
    return bump(st, txn)
}

// Oracle's USER_OBJECTS, ALL_OBJECTS, DBA_OBJECTS and *_ERRORS (rel "ora." and the view's name): the views of snap whose
// queries do not plan now, by key, with their errors (lexdb_oracat gives them as Oracle's text); empty for any other.
pub fn viewErrs(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, rel: &str, snap: &lexdb_catalog.CatSnap, plan: &PlanFn): Result[Map[str, DbErr], DbErr] {
    var out: Map[str, DbErr] = newMap()
    if !strings.startsWith(rel, "ora.") || !(strings.endsWith(rel, "_OBJECTS") || strings.endsWith(rel, "_ERRORS")) { return Ok(out) }
    for v in snap.views {
        if lexdb_base.isTempSchema(&v.schema) { continue }
        match try broken(st, txn, &v.t, plan) {
            Some(x) { out.put(v.key.clone(), x) }
            None {}
        }
    }
    return Ok(out)
}

// Whether text has name w as a word of its own (no letter, digit, _, @, # or $ beside it), case ignored.
fn wordIn(text: &str, w: &str): bool {
    let t = strings.toLowerAscii(text)
    let x = strings.toLowerAscii(w)
    var at = 0
    while true {
        let i = strings.indexOf(&t, &x, at)
        if i < 0 { return false }
        let j = i + len(x)
        if (i == 0 || !nameByte(t[i - 1])) && (j >= len(t) || !nameByte(t[j])) { return true }
        at = i + 1
    }
    return false
}

fn nameByte(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '@' || c == '#' || c == '$' || c >= 128 }

// T-SQL: a view WITH SCHEMABINDING (s, CREATE VIEW) reads views that are schema-bound too (SQL Server's 4513); deps: the
// relations its query reads.
pub fn boundOver(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, deps: &[]str): Result[Unit, DbErr] {
    if s.mdialect != lexdb_sql.MD_TSQL || !lexdb_sql.viewBound(&s.index) || len(deps) == 0 { return Ok(Unit{}) }
    for v in try lexdb_catalog.allViews(st, txn) {
        if !lexdb_base.hasStr(deps, &v.name) || lexdb_sql.viewBound(&v.view) { continue }
        let vn = if len(s.spell) > 0 { s.spell.clone() } else { lexdb_sql.baseName(&s.table) }
        let on = (if lexdb_sql.isQual(&v.name) { lexdb_sql.schemaOf(&v.name) } else { "dbo" }) + "." + lexdb_sql.baseName(&v.name)
        return Err(err("TS4513", &("Cannot schema bind view '" + vn + "'. '" + on + "' is not schema bound.")))
    }
    return Ok(Unit{})
}

// T-SQL's sp_refreshview (s: its CREATE VIEW, alias REFRESH_VIEW, the name as given in table): the CREATE OR ALTER VIEW that
// makes the view again from its kept text (a SELECT * view takes its table's columns as they are now); 15165 if it is no view.
pub fn refreshStmt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt): Result[lexdb_sql.Stmt, DbErr] {
    var parts: []str = []
    for p in strings.split(&s.table, ".") {
        var x = strings.trim(&p).toStr()
        if len(x) > 1 && ((x[0] == '[' && x[len(x) - 1] == ']') || (x[0] == '"' && x[len(x) - 1] == '"')) { x = x[1..len(x) - 1].toStr() }
        append(mut &parts, strings.toLowerAscii(&x))
    }
    let n = len(parts)
    let sc = if n >= 2 { parts[n - 2].clone() } else { "dbo" }
    let key = if sc == "dbo" || sc == "public" { parts[n - 1].clone() } else { lexdb_sql.qual(&sc, &parts[n - 1]) }
    for v in try lexdb_catalog.allViews(st, txn) {
        if v.name != key || !strings.startsWith(&v.view, lexdb_sql.TSQL_VIEW) { continue }
        var r = lexdb_sql.newStmt(lexdb_sql.S_CREATE_VIEW)
        r.table = key.clone()
        r.index = v.view.clone()
        r.spell = v.spell.clone()
        r.ifFlag = true
        r.alter = true
        r.mdialect = lexdb_sql.MD_TSQL
        return Ok(r)
    }
    return Err(err("TS15165", &("Could not find object '" + s.table + "' or you do not have permission.")))
}

// DROP TABLE k under views (the sixth bug slice), per door, as each product does: PostgreSQL refuses it (2BP01, the views in
// its DETAIL) and its CASCADE drops the views (and the views over them); SQL Server drops the table unless a view made WITH
// SCHEMABINDING reads it (3729), and a view over it fails when read (208); Oracle drops it, and a view over it has errors
// (ORA-04063 when read, INVALID, ORA-00942 in USER_ERRORS). Such a view reads the table again once one of its name is made.
// door: the session's (lexdb_priv.doorOf: "tds", "tns" or the PostgreSQL door's; DROP TABLE's statement does not say).
pub fn dropTable(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, s: &lexdb_sql.Stmt, k: &str, door: &str): Result[Unit, DbErr] {
    let deps = try lexdb_catalog.dependentViews(st, txn, k)
    if len(deps) == 0 || door == "tns" || s.mdialect == lexdb_sql.MD_ORA { return Ok(Unit{}) }
    if door == "tds" || s.mdialect == lexdb_sql.MD_TSQL {
        for v in try lexdb_catalog.allViews(st, txn) {
            if lexdb_base.hasStr(&deps, &v.name) && lexdb_sql.viewBound(&v.view) && lexdb_base.hasStr(&v.deps, k) {
                return Err(err("TS3729", &("Cannot DROP TABLE '" + lexdb_sql.baseName(k) + "' because it is being referenced by object '" + lexdb_sql.baseName(&v.name) + "'.")))
            }
        }
        return Ok(Unit{})
    }
    if s.cascade {
        // (the views and their grants, as DROP VIEW ... CASCADE drops them)
        for b in deps {
            txn.del(lexdb_catalog.CATALOG, &b)
            txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.ACL_PRE + lexdb_catalog.relObj(&b)))
        }
        return Ok(Unit{})
    }
    var detail: []str = []
    for v in try lexdb_catalog.allViews(st, txn) {
        if !lexdb_base.hasStr(&deps, &v.name) { continue }
        var on = ""
        if lexdb_base.hasStr(&v.deps, k) { on = "table " + lexdb_sql.shown(k) } else {
            for d in v.deps { if len(on) == 0 && lexdb_base.hasStr(&deps, &d) { on = "view " + lexdb_sql.shown(&d) } }
        }
        append(mut &detail, "view " + lexdb_sql.shown(&v.name) + " depends on " + on)
    }
    return Err(lexdb_base.errDetail("2BP01", &("cannot drop table " + lexdb_sql.shown(k) + " because other objects depend on it"),
                                    &strings.join(&detail, "\n"), "Use DROP ... CASCADE to drop the dependent objects too."))
}

// information_schema.VIEW_TABLE_USAGE (cols false) and VIEW_COLUMN_USAGE (cols true), in both doors (lexdb_pg.viewRows; the T-SQL
// door's with dbo for public): per view the relations its query reads (its kept dependencies), and of those the columns its text
// names (by name, qualified by the relation or an alias, or all of them for *). Rows: view_catalog, view_schema, view_name,
// table_catalog, table_schema, table_name[, column_name].
pub fn usageRows(snap: &lexdb_catalog.CatSnap, cols: bool, db: &str): [][]lexdb_sql.Val {
    var out: [][]lexdb_sql.Val = []
    for v in snap.views {
        if lexdb_base.isTempSchema(&v.schema) { continue }
        let refs = if cols { refsOf(&lexdb_sql.viewKept(&v.t.view)) } else { [] }
        for d in v.t.deps {
            var dt = -1
            var isView = false
            for i in 0..len(snap.tabs) { if snap.tabs[i].key == d { dt = i } }
            if dt < 0 {
                for i in 0..len(snap.views) {
                    if snap.views[i].key == d {
                        dt = i
                        isView = true
                    }
                }
            }
            if dt < 0 { continue }
            let ct = if isView { &snap.views[dt] } else { &snap.tabs[dt] }
            var used: []str = []
            if cols {
                for c in ct.t.cols {
                    if lexdb_catalog.hiddenName(&c.name) || c.name == lexdb_catalog.ROWID { continue }
                    if usesCol(&refs, &lexdb_sql.baseName(&d), &c.name) { append(mut &used, lexdb_sql.colShown(&c)) }
                }
            } else {
                append(mut &used, "")
            }
            for u in used {
                var r: []lexdb_sql.Val = [tv(db), tv(&v.schema), tv(&(if len(v.t.spell) > 0 { v.t.spell.clone() } else { v.name.clone() })), tv(db), tv(&ct.schema),
                                          tv(&(if len(ct.t.spell) > 0 { ct.t.spell.clone() } else { ct.name.clone() }))]
                if cols { append(mut &r, tv(&u)) }
                append(mut &out, r)
            }
        }
    }
    return out
}

fn tv(s: &str): lexdb_sql.Val { return lexdb_sql.Val.Text(s.toStr()) }

// The names a view's query text refers to: each a name and its qualifier ("" none), lower case; "*" for a star.
type Ref = record { qual: str; name: str }

fn refsOf(text: &str): []Ref {
    var words: []str = []        // the names, and "." and "*" between them
    var i = 0
    let n = len(text)
    while i < n {
        let c = text[i]
        if c == '\'' {
            i += 1
            while i < n && text[i] != '\'' { i += 1 }
            i += 1
            continue
        }
        if c == '-' && i + 1 < n && text[i + 1] == '-' {
            while i < n && text[i] != '\n' { i += 1 }
            continue
        }
        if c == '[' || c == '"' {
            let close: byte = if c == '[' { ']' } else { '"' }
            var j = i + 1
            while j < n && text[j] != close { j += 1 }
            append(mut &words, strings.toLowerAscii(&text[i + 1..min(j, n)]))
            i = j + 1
            continue
        }
        if isNameStart(c) {
            var j = i
            while j < n && (isNameStart(text[j]) || (text[j] >= '0' && text[j] <= '9') || text[j] == '$' || text[j] == '#') { j += 1 }
            append(mut &words, strings.toLowerAscii(&text[i..j]))
            i = j
            continue
        }
        if c == '.' || c == '*' { append(mut &words, text[i..i + 1].toStr()) } else if c != ' ' && c != '\t' && c != '\n' && c != '\r' { append(mut &words, ",") }
        i += 1
    }
    var out: []Ref = []
    var k = 0
    while k < len(words) {
        let w = &words[k]
        if w == "," || w == "." {
            k += 1
            continue
        }
        // a.b.c: the last two
        var parts: []str = [w.clone()]
        while k + 2 < len(words) && words[k + 1] == "." && words[k + 2] != "," && words[k + 2] != "." {
            append(mut &parts, words[k + 2].clone())
            k += 2
        }
        let m = len(parts)
        append(mut &out, Ref{qual: if m >= 2 { parts[m - 2].clone() } else { "" }, name: parts[m - 1].clone()})
        k += 1
    }
    return out
}

fn isNameStart(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '@' || c >= 128 }

// Whether refs name column col of relation rel (qualified by it or by an alias, or not qualified), or take all with *.
fn usesCol(refs: &[]Ref, rel: &str, col: &str): bool {
    let r0 = strings.toLowerAscii(rel)
    let c0 = strings.toLowerAscii(col)
    // the aliases of rel: the name after "rel [as]"
    var quals: []str = [r0.clone()]
    for i in 0..len(refs) {
        if refs[i].name == r0 && i + 1 < len(refs) {
            var j = i + 1
            if refs[j].name == "as" && len(refs[j].qual) == 0 && j + 1 < len(refs) { j += 1 }
            if len(refs[j].qual) == 0 { append(mut &quals, refs[j].name.clone()) }
        }
    }
    for r in refs {
        if r.name == "*" && (len(r.qual) == 0 || lexdb_base.hasStr(&quals, &r.qual)) { return true }
        if r.name == c0 && (len(r.qual) == 0 || lexdb_base.hasStr(&quals, &r.qual)) { return true }
    }
    return false
}
