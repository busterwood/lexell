// lexdb_memo: the SQL layer's scratch values kept while the store is open,
// outside transactions (a session's user and settings, a sequence's block,
// the catalog binding). The store carries the handle; it never reads a
// key. A small lock of its own, so a memo read neither waits for nor holds
// the storage lock.
import "task"
import "collections"

pub type Memo = value record { sh: task.Shared[MemoState] }

// Another handle to the same memo (a handle: clone, a copy, does not apply).
pub fn (m: &Memo) share(): Memo { return Memo{sh: m.sh.share()} }

type MemoState = record { m: Map[str, str]; roleGen: int }

pub fn newMemo(): Memo {
    return Memo{sh: task.shared(MemoState{m: newMap(), roleGen: 0})}
}

fn isRoleKey(k: &str): bool {
    return len(k) >= 6 && k[0] == 0 && (k[1] == 'r' || k[1] == 's')
}

pub fn (m: &Memo) roleGen(): int {
    var g = 0
    m.sh.with(fn(s: mut &MemoState) { g = s.roleGen })
    return g
}

pub fn (m: &Memo) get(k: &str): Option[str] {
    var out: Option[str] = None
    m.sh.with(fn(s: mut &MemoState) { out = s.m.get(k) })
    return out
}

pub fn (m: &Memo) put(k: &str, v: &str) {
    m.sh.with(fn(s: mut &MemoState) {
        s.m.put(k.clone(), v.clone())
        if isRoleKey(k) { s.roleGen += 1 }
    })
}

pub fn (m: &Memo) del(k: &str) {
    m.sh.with(fn(s: mut &MemoState) {
        let gone = s.m.remove(k)
        if isRoleKey(k) { s.roleGen += 1 }
    })
}
