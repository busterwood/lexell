// lexdb_memo: the SQL layer's scratch values kept while the store is open,
// outside transactions (a session's user and settings, a sequence's block,
// the catalog binding). The store carries the handle; it never reads a
// key. A small lock of its own, so a memo read neither waits for nor holds
// the storage lock.
import "task"
import "collections"

pub type Memo = value record { sh: task.Shared[MemoState] }

type MemoState = record { m: Map[str, str] }

pub fn newMemo(): Memo {
    return Memo{sh: task.shared(MemoState{m: newMap()})}
}

pub fn (m: &Memo) get(k: &str): Option[str] {
    var out: Option[str] = None
    m.sh.with(fn(s: mut &MemoState) { out = s.m.get(k) })
    return out
}

pub fn (m: &Memo) put(k: &str, v: &str) {
    m.sh.with(fn(s: mut &MemoState) { s.m.put(k, v) })
}

pub fn (m: &Memo) del(k: &str) {
    m.sh.with(fn(s: mut &MemoState) { let gone = s.m.remove(k) })
}
