// lexdb_syscat: SQL Server's catalog views (sys.tables, sys.all_columns,
// ...) for T-SQL sessions (design/lexdb-tds.md, section 13). Their shapes,
// and the rows lexdb takes from SQL Server as they are (sys.types, the
// system databases, the fixed principals, ...), are SQL Server 2022's,
// recorded by tools/gen_sqlserver_syscat.py in lexdb_sysdata; the rows
// that describe lexdb's own tables this module makes from the catalog
// (viewRows), each from a template row of SQL Server's for such an object.
//
// A view is a catalog relation as pg_catalog's are (lexdb_pgcat): the
// parser, in T-SQL mode, makes sys.x (master.sys.x, db.sys.x) the function
// "#sys.x" in FROM. PostgreSQL sessions never see them.
//
// Types: a column's SQL Server type is kept beside the lexdb type it is
// computed as (lexOid): its system_type_id and length (tdsCode) ride in
// OutCol.scale, so that lexdb_tds sends tinyint, char(2), varchar and
// datetime as SQL Server would.

import "strings"
import "./lexdb_base"
import "./lexdb_catalog"
import "./lexdb_dialect"
import "./lexdb_float"
import "./lexdb_sysdata"
import "./lexdb_sql"
import "./lexdb_time"
import "./lexdb_parse"
import "./lexdb_dbopt"
import "./lexdb_tsqldef"

type Val = lexdb_sql.Val
type DbErr = lexdb_base.DbErr
type Expr = lexdb_sql.Expr
type CatSnap = lexdb_catalog.CatSnap
type CatTab = lexdb_catalog.CatTab
type CatIdx = lexdb_catalog.CatIdx
type CatCon = lexdb_catalog.CatCon
type TabType = lexdb_catalog.TabType
type Table = lexdb_catalog.Table
type Role = lexdb_catalog.Role
const ROWID = lexdb_catalog.ROWID

fn iv(n: int): Val { return Val.Int(n) }
fn tv(s: &str): Val { return Val.Text(s.toStr()) }
fn bv(b: bool): Val { return Val.Bool(b) }

// A view's column: as sys.all_columns describes it.
pub type SysCol = record {
    pub name: str
    pub typ: str            // its type's name: int, sysname, nvarchar, char, ...
    pub maxLen: int         // max_length (bytes; -1 for max)
    pub prec: int
    pub scale: int
    pub nullable: bool
    pub coll: str           // collation_name, "" none
}

// SQL Server's system_type_id of the types lexdb gives as they are.
pub const TS_IMAGE: int = lexdb_dialect.TS_IMAGE
pub const TS_TEXT: int = lexdb_dialect.TS_TEXT
pub const TS_GUID: int = lexdb_dialect.TS_GUID
pub const TS_DATE: int = lexdb_dialect.TS_DATE
pub const TS_TIME: int = lexdb_dialect.TS_TIME
pub const TS_DATETIME2: int = lexdb_dialect.TS_DATETIME2
pub const TS_DTO: int = lexdb_dialect.TS_DTO
pub const TS_TINYINT: int = lexdb_dialect.TS_TINYINT
pub const TS_SMALLINT: int = lexdb_dialect.TS_SMALLINT
pub const TS_INT: int = lexdb_dialect.TS_INT
pub const TS_SMALLDATETIME: int = lexdb_dialect.TS_SMALLDATETIME
pub const TS_REAL: int = lexdb_dialect.TS_REAL
pub const TS_MONEY: int = lexdb_dialect.TS_MONEY
pub const TS_DATETIME: int = lexdb_dialect.TS_DATETIME
pub const TS_FLOAT: int = lexdb_dialect.TS_FLOAT
pub const TS_VARIANT: int = lexdb_dialect.TS_VARIANT
pub const TS_NTEXT: int = lexdb_dialect.TS_NTEXT
pub const TS_BIT: int = lexdb_dialect.TS_BIT
pub const TS_DECIMAL: int = lexdb_dialect.TS_DECIMAL
pub const TS_NUMERIC: int = lexdb_dialect.TS_NUMERIC
pub const TS_SMALLMONEY: int = lexdb_dialect.TS_SMALLMONEY
pub const TS_BIGINT: int = lexdb_dialect.TS_BIGINT
pub const TS_VARBINARY: int = lexdb_dialect.TS_VARBINARY
pub const TS_VARCHAR: int = lexdb_dialect.TS_VARCHAR
pub const TS_BINARY: int = lexdb_dialect.TS_BINARY
pub const TS_CHAR: int = lexdb_dialect.TS_CHAR
pub const TS_TIMESTAMP: int = lexdb_dialect.TS_TIMESTAMP
pub const TS_NVARCHAR: int = lexdb_dialect.TS_NVARCHAR
pub const TS_NCHAR: int = lexdb_dialect.TS_NCHAR
pub const TS_XML: int = lexdb_dialect.TS_XML
pub const TS_SYSNAME: int = lexdb_dialect.TS_SYSNAME


// lexdb's OIDs (as lexdb_sql's; this module is below it)
const O_BOOL = 16
const O_BYTEA = 17
const O_INT8 = 20
const O_INT2 = 21
const O_INT4 = 23
const O_TEXT = 25
const O_FLOAT4 = 700
const O_FLOAT8 = 701
const O_DATE = 1082
const O_TIME = 1083
const O_TS = 1114
const O_TSTZ = 1184
const O_NUMERIC = 1700
const O_UUID = 2950

fn specOf(view: &str): str {
    if strings.startsWith(view, "msdb.") { return lexdb_dialect.msdbSpec(view) }
    for v in lexdb_sysdata.VIEWS {
        let t = strings.indexOf(&v, "\t", 0)
        if v[0..t] == view { return v.toStr() }
    }
    return ""
}

// Whether view (tables, all_columns, ...) is one of sys's.
pub fn isView(view: &str): bool { return len(specOf(view)) > 0 }

// Every view's name.
pub fn viewNames(): []str {
    var out: []str = []
    for v in lexdb_sysdata.VIEWS { append(mut &out, v[0..strings.indexOf(&v, "\t", 0)].toStr()) }
    return out
}

// The catalog relation a T-SQL FROM item names: "sys.tables" for sys.tables
// (any database's: master.sys.tables is lexdb's own); "" if none.
pub fn relOf(schema: &str, name: &str): str { return lexdb_dialect.tsqlRelOf(schema, name) }

// msdb's tables SMO reads, in lexdb_dialect.
pub fn isMsdb(name: &str): bool { return lexdb_dialect.isMsdb(name) }

// A view's object_id (SQL Server's: negative), 0 if it is none.
pub fn viewId(view: &str): int {
    let s = specOf(view)
    if len(s) == 0 { return 0 }
    let f = strings.split(&s, "\t")
    return strings.parseIntOpt(f[1]).unwrapOr(0)
}

// The view whose object_id is id, "" if none.
pub fn viewOf(id: int): str {
    for v in lexdb_sysdata.VIEWS {
        let f = strings.split(&v, "\t")
        if strings.parseIntOpt(f[1]).unwrapOr(0) == id { return f[0].toStr() }
    }
    return ""
}

pub fn cols(view: &str): []SysCol {
    var out: []SysCol = []
    let s = specOf(view)
    if len(s) == 0 { return out }
    let f = strings.split(&s, "\t")
    for i in 2..len(f) {
        let p = strings.split(&f[i], ":")
        append(mut &out, SysCol{name: p[0].toStr(), typ: p[1].toStr(), maxLen: strings.parseIntOpt(p[2]).unwrapOr(0),
                                prec: strings.parseIntOpt(p[3]).unwrapOr(0), scale: strings.parseIntOpt(p[4]).unwrapOr(0),
                                nullable: p[5] == "1", coll: p[6].toStr()})
    }
    return out
}

// A view's rows SQL Server has: kind "full" (every one it has) or
// "template" (one, for lexdb_exec to fill in); values as text, NULL "\x00".
pub fn rows(view: &str, kind: &str): [][]str {
    var out: [][]str = []
    let head = view + "\t" + kind + "\t"
    for r in lexdb_sysdata.ROWS {
        if !strings.startsWith(&r, &head) { continue }
        let body = r[len(head)..len(r)]
        if len(body) == 0 { return out }
        for row in strings.split(&body, "\x1e") {
            var vs: []str = []
            for v in strings.split(&row, "\x1f") { append(mut &vs, v.toStr()) }
            append(mut &out, vs)
        }
    }
    return out
}

// The lexdb type a SQL Server type is computed as.
pub fn lexOid(typ: &str): int {
    match typ.toStr() {
        "tinyint", "smallint" { return O_INT2 }
        "int" { return O_INT4 }
        "bigint" { return O_INT8 }
        "bit" { return O_BOOL }
        "decimal", "numeric", "money", "smallmoney" { return O_NUMERIC }
        "float" { return O_FLOAT8 }
        "real" { return O_FLOAT4 }
        "datetime", "smalldatetime", "datetime2" { return O_TS }
        "datetimeoffset" { return O_TSTZ }
        "date" { return O_DATE }
        "time" { return O_TIME }
        "uniqueidentifier" { return O_UUID }
        "varbinary", "binary", "image", "timestamp" { return O_BYTEA }
        else { return O_TEXT }
    }
}

// A type's system_type_id by its name (sysname: nvarchar's); 0 if unknown.
pub fn typeId(typ: &str): int {
    match typ.toStr() {
        "image" { return TS_IMAGE }
        "text" { return TS_TEXT }
        "uniqueidentifier" { return TS_GUID }
        "date" { return TS_DATE }
        "time" { return TS_TIME }
        "datetime2" { return TS_DATETIME2 }
        "datetimeoffset" { return TS_DTO }
        "tinyint" { return TS_TINYINT }
        "smallint" { return TS_SMALLINT }
        "int" { return TS_INT }
        "smalldatetime" { return TS_SMALLDATETIME }
        "real" { return TS_REAL }
        "money" { return TS_MONEY }
        "datetime" { return TS_DATETIME }
        "float" { return TS_FLOAT }
        "sql_variant" { return TS_VARIANT }
        "ntext" { return TS_NTEXT }
        "bit" { return TS_BIT }
        "decimal" { return TS_DECIMAL }
        "numeric" { return TS_NUMERIC }
        "smallmoney" { return TS_SMALLMONEY }
        "bigint" { return TS_BIGINT }
        "varbinary" { return TS_VARBINARY }
        "varchar" { return TS_VARCHAR }
        "binary" { return TS_BINARY }
        "char" { return TS_CHAR }
        "timestamp" { return TS_TIMESTAMP }
        "nvarchar", "sysname" { return TS_NVARCHAR }
        "nchar" { return TS_NCHAR }
        "xml" { return TS_XML }
        else { return 0 }
    }
}

// What a result column of SQL Server type code (system_type_id) and
// length n (characters or bytes; 0 for max) carries in OutCol.scale for
// lexdb_tds: code + n * 1024. Codes start at 34, above a time type's
// scale (0 to 7), which OutCol.scale otherwise holds.
pub fn hint(code: int, n: int): int { return code + n * 1024 }

// The scale (OutCol.scale) of MIN or MAX of a time value whose scale is a, and of SWITCHOFFSET, TODATETIMEOFFSET and AT TIME
// ZONE of one: MIN and MAX keep a time type's fractional digits (0 to 9: an Oracle DATE stays one) and a datetime's hint; the
// others are a datetimeoffset of the argument's digits (a datetime's 3, a smalldatetime's 0), as SQL Server 2022 types them;
// -1 for another argument (datetimeoffset(7)).
pub fn timeScale(f: &str, a: int): int {
    let code = hintCode(a)
    if f == "min" || f == "max" { return if (a >= 0 && a <= 9) || code == TS_DATETIME || code == TS_SMALLDATETIME { a } else { -1 } }
    if a >= 0 && a <= 7 { return a }
    if code == TS_DATETIME { return 3 }
    if code == TS_SMALLDATETIME { return 0 }
    return -1
}

// The parts of a hint: its code and its length.
pub fn hintCode(h: int): int { return if h >= 34 { h % 1024 } else { 0 } }
pub fn hintLen(h: int): int { return if h >= 34 { h / 1024 } else { 0 } }

// The hint of a view's column, -1 for none (the lexdb type's own TDS type
// is SQL Server's: int, bigint, smallint, bit, nvarchar, ...), or a time
// type's scale.
pub fn colHint(c: &SysCol): int {
    let code = typeId(&c.typ)
    if code == TS_TINYINT || code == TS_DATETIME || code == TS_SMALLDATETIME { return hint(code, 0) }
    if code == TS_CHAR || code == TS_VARCHAR || code == TS_BINARY || code == TS_VARBINARY {
        return hint(code, if c.maxLen > 0 { c.maxLen } else { 0 })
    }
    if code == TS_NCHAR { return hint(code, if c.maxLen > 0 { c.maxLen / 2 } else { 0 }) }
    if code == TS_DATETIME2 || code == TS_TIME || code == TS_DTO { return c.scale }
    if code == TS_VARIANT { return hint(code, 0) }
    return -1
}

// ---- SERVERPROPERTY, DATABASEPROPERTYEX, FULLTEXTSERVICEPROPERTY and the
// constant @@ values, as SQL Server 2022 gives them (lexdb_sysdata.PROPS):
// the machine's and the server's name are this host's.

pub type Prop = lexdb_dialect.Prop

pub fn hostName(): str { return lexdb_dialect.hostName() }

pub fn prop(kind: &str, name: &str): Prop { return lexdb_dialect.prop(kind, name) }

// SQL Server's databases: master 1, tempdb 2, model 3, msdb 4; lexdb's own
// is 5 (name: its name).
pub fn dbId(n: &str, own: &str): int {
    let l = strings.toLowerAscii(&(strings.trim(n)))
    if l == strings.toLowerAscii(own) { return 5 }
    match l {
        "master" { return 1 }
        "tempdb" { return 2 }
        "model" { return 3 }
        "msdb" { return 4 }
        else { return 0 }
    }
}

pub fn dbName(id: int, own: &str): str {
    match id {
        1 { return "master" }
        2 { return "tempdb" }
        3 { return "model" }
        4 { return "msdb" }
        5 { return own.toStr() }
        else { return "" }
    }
}

// A type's name by its user_type_id (sys.types), "" if none; and back.
pub fn typeName(id: int): str {
    for r in rows(&"types", &"full") { if strings.parseIntOpt(&r[2]).unwrapOr(-1) == id { return r[0].clone() } }
    return ""
}

pub fn typeIdOf(n: &str): int {
    let l = strings.toLowerAscii(&(strings.trim(n)))
    for r in rows(&"types", &"full") { if strings.toLowerAscii(&r[0]) == l { return strings.parseIntOpt(&r[2]).unwrapOr(0) } }
    return 0
}

// A fixed schema's name by its id (dbo, guest, INFORMATION_SCHEMA, sys, the
// db_ roles'), "" if none; and back (0 if none).
pub fn schemaName(id: int): str {
    for r in rows(&"schemas", &"full") { if strings.parseIntOpt(&r[1]).unwrapOr(-1) == id { return r[0].clone() } }
    return ""
}

pub fn schemaIdOf(n: &str): int {
    let l = strings.toLowerAscii(&(strings.trim(n)))
    for r in rows(&"schemas", &"full") { if strings.toLowerAscii(&r[0]) == l { return strings.parseIntOpt(&r[1]).unwrapOr(0) } }
    return 0
}

pub type SqlT = record {
    pub name: str
    pub sys: int
    pub user: int
    pub maxLen: int
    pub prec: int
    pub scale: int
    pub coll: str
}

pub fn sqlT(name: &str, maxLen: int, prec: int, scale: int, coll: &str): SqlT {
    let id = typeId(name)
    return SqlT{name: name.toStr(), sys: id, user: if name == "sysname" { TS_SYSNAME } else { id }, maxLen: maxLen, prec: prec,
                scale: scale, coll: coll.toStr()}
}

// SQL Server's precision and length of a time type of scale s.
pub fn timeT(name: &str, s: int): SqlT {
    let frac = if s > 0 { s + 1 } else { 0 }
    let short = if s < 3 { 0 } else if s < 5 { 1 } else { 2 }
    if name == "time" { return sqlT(name, 3 + short, 8 + frac, s, &"") }
    if name == "datetimeoffset" { return sqlT(name, 8 + short, 26 + frac, s, &"") }
    return sqlT(name, 6 + short, 19 + frac, s, &"")
}

// The SQL Server type of a column of lexdb type t: SQL Server's own where
// the column was made with one (TypeName.prec's code: lexdb_sql.tsqlType),
// else the nearest (text is nvarchar(max), a timestamp datetime2, ...).
pub fn sqlTypeOf(t: &lexdb_sql.TypeName, collName: &str): SqlT {
    let code = lexdb_parse.tsqlCode(t)
    let coll = if len(collName) > 0 { collName.toStr() } else { "Latin1_General_BIN2" }
    let k = t.kind
    if k == lexdb_sql.K_INT {
        if code == TS_TINYINT { return sqlT(&"tinyint", 1, 3, 0, &"") }
        if t.oid == lexdb_sql.OID_INT2 { return sqlT(&"smallint", 2, 5, 0, &"") }
        if t.oid == lexdb_sql.OID_INT8 { return sqlT(&"bigint", 8, 19, 0, &"") }
        return sqlT(&"int", 4, 10, 0, &"")
    }
    if k == lexdb_sql.K_BOOL { return sqlT(&"bit", 1, 1, 0, &"") }
    if k == lexdb_sql.K_NUM {
        let p = if t.prec > 0 { t.prec } else { 38 }
        let s = if t.prec > 0 { t.scale } else { 6 }
        return sqlT(&"decimal", if p <= 9 { 5 } else if p <= 19 { 9 } else if p <= 28 { 13 } else { 17 }, p, s, &"")
    }
    if k == lexdb_sql.K_FLOAT {
        if t.oid == lexdb_sql.OID_FLOAT4 { return sqlT(&"real", 4, 24, 0, &"") }
        return sqlT(&"float", 8, 53, 0, &"")
    }
    if k == lexdb_sql.K_DATE { return sqlT(&"date", 3, 10, 0, &"") }
    // an interval (SQL Server has none) is sent as its text: nvarchar(max), as arrays, json and enums
    if t.oid == lexdb_sql.OID_IVAL { return sqlT(&"nvarchar", -1, 0, 0, &coll) }
    if lexdb_sql.isTimeKind(k) {
        if code == TS_DATETIME { return sqlT(&"datetime", 8, 23, 3, &"") }
        if code == TS_SMALLDATETIME { return sqlT(&"smalldatetime", 4, 16, 0, &"") }
        let s = if t.prec >= 1 { min(t.scale, 7) } else { 7 }
        if t.oid == lexdb_sql.OID_TIME { return timeT(&"time", s) }
        if t.oid == lexdb_sql.OID_TSTZ { return timeT(&"datetimeoffset", s) }
        return timeT(&"datetime2", s)
    }
    if k == lexdb_sql.K_UUID { return sqlT(&"uniqueidentifier", 16, 0, 0, &"") }
    if k == lexdb_sql.K_BYTEA {
        if code == TS_BINARY { return sqlT(&"binary", if t.len > 0 { t.len } else { 1 }, 0, 0, &"") }
        if code == TS_IMAGE { return sqlT(&"image", 16, 0, 0, &"") }
        if code == TS_TIMESTAMP { return sqlT(&"timestamp", 8, 0, 0, &"") }
        return sqlT(&"varbinary", if t.len > 0 { t.len } else { -1 }, 0, 0, &"")
    }
    if k == lexdb_sql.K_TEXT {
        let n = t.len
        if code == TS_VARCHAR { return sqlT(&"varchar", if n > 0 { n } else { -1 }, 0, 0, &coll) }
        if code == TS_CHAR { return sqlT(&"char", if n > 0 { n } else { 1 }, 0, 0, &coll) }
        if code == TS_NCHAR { return sqlT(&"nchar", if n > 0 { n * 2 } else { 2 }, 0, 0, &coll) }
        if code == TS_TEXT { return sqlT(&"text", 16, 0, 0, &coll) }
        if code == TS_NTEXT { return sqlT(&"ntext", 16, 0, 0, &coll) }
        if code == TS_XML { return sqlT(&"xml", -1, 0, 0, &"") }
        if t.oid == lexdb_sql.OID_BPCHAR { return sqlT(&"nchar", if n > 0 { n * 2 } else { 2 }, 0, 0, &coll) }
        if n > 0 { return sqlT(&"nvarchar", n * 2, 0, 0, &coll) }
        return sqlT(&"nvarchar", -1, 0, 0, &coll)
    }
    return sqlT(&"nvarchar", -1, 0, 0, &coll)
}

// ---- SQL Server's catalog views, sys.* (design/lexdb-tds.md, section 13)
//
// For T-SQL sessions: "#sys.x" in FROM (lexdb_sql, from lexdb_syscat). The
// views' shapes, and the rows lexdb takes as SQL Server has them, are
// lexdb_syscat's; the rows that describe lexdb's own objects this module
// makes from the catalog (catView), each from SQL Server's template row for such
// an object with the columns that describe it set. Ids: a table's or a
// view's object_id is its OID (catOid), a constraint's its pg_constraint
// OID, a default's its pg_attrdef OID; a sys view's SQL Server's own
// (negative). public is dbo (schema_id 1); another schema's id is its
// OID. lexdb's database is database_id 5, after master, tempdb, model and
// msdb, which are listed (as SQL Server's) but cannot be opened.

pub const SYS_DB_NAME: str = "lexdb"
pub const SYS_DB_ID = 5
const SYS_DATE: str = "2000-01-01 00:00:00"     // create_date and modify_date: lexdb keeps no times

// A row of a sys view being made: its columns and values.
type SysRow = record {
    cols: []SysCol
    vals: []Val
}

// A value as lexdb_syscat holds it ("\x00" NULL), as its column's type.
fn sysVal(c: &SysCol, s: &str): Val {
    if s == "\x00" { return Val.Null }
    let o = lexOid(&c.typ)
    if o == lexdb_sql.OID_INT2 || o == lexdb_sql.OID_INT4 || o == lexdb_sql.OID_INT8 { return Val.Int(strings.parseIntOpt(&s).unwrapOr(0)) }
    if o == lexdb_sql.OID_BOOL { return Val.Bool(s == "1") }
    if o == lexdb_sql.OID_NUMERIC {
        match Decimal.parse(&s) {
            Ok(d) { return Val.Num(d) }
            Err(_) { return Val.Null }
        }
    }
    if o == lexdb_sql.OID_FLOAT8 || o == lexdb_sql.OID_FLOAT4 {
        match lexdb_float.parse(s, o == lexdb_sql.OID_FLOAT4) {
            Ok(x) { return if o == lexdb_sql.OID_FLOAT8 { Val.Float(x) } else { Val.Real(x) } }
            Err(_) { return Val.Null }
        }
    }
    if o == lexdb_sql.OID_TS {
        match lexdb_time.parseTs(s, lexdb_time.utc()) {
            Ok(u) { return Val.Ts(u) }
            Err(_) { return Val.Null }
        }
    }
    if o == lexdb_sql.OID_UUID { return Val.Uuid(strings.toLowerAscii(&s)) }
    if o == lexdb_sql.OID_BYTEA { return Val.Bytes(lexdb_catalog.hexBytes(s)) }
    // sql_variant: a number as a number
    if c.typ == "sql_variant" {
        match strings.parseIntOpt(&s) {
            Some(n) { return Val.Int(n) }
            None {}
        }
    }
    return Val.Text(s.toStr())
}

fn sysVals(cols: &[]SysCol, r: &[]str): []Val {
    var out: []Val = []
    for i in 0..len(cols) { append(mut &out, if i < len(r) { sysVal(&cols[i], &r[i]) } else { Val.Null }) }
    return out
}

// The view's template row (NULLs where it has none).
fn sysTemplate(view: &str): SysRow {
    let cols = cols(view)
    let ts = rows(view, &"template")
    var vals: []Val = []
    if len(ts) > 0 { vals = sysVals(&cols, &ts[0]) } else { for c in cols { append(mut &vals, Val.Null) } }
    return SysRow{cols: cols, vals: vals}
}

// The rows SQL Server has, as they are.
fn sysFull(view: &str): [][]Val {
    let cols = cols(view)
    var out: [][]Val = []
    for r in rows(view, &"full") { append(mut &out, sysVals(&cols, &r)) }
    return out
}

fn (r: mut &SysRow) set(name: &str, v: Val) {
    for i in 0..len(r.cols) {
        if r.cols[i].name == name {
            r.vals[i] = v
            return
        }
    }
}

fn (r: &SysRow) row(): []Val {
    var out: []Val = []
    for v in r.vals { append(mut &out, v.clone()) }
    return out
}

fn sysTs(): Val {
    match lexdb_time.parseTs(&SYS_DATE, lexdb_time.utc()) {
        Ok(u) { return Val.Ts(u) }
        Err(_) { return Val.Null }
    }
}

// A schema's id and name as SQL Server shows them: public is dbo.
pub fn sysSchemaId(s: &str): int { return if s == "public" { 1 } else { lexdb_sql.nameOid("n", s) } }
fn sysSchemaName(s: &str): str { return if s == "public" { "dbo" } else { s.toStr() } }

// A column's SQL Server type: its name, system_type_id, user_type_id,
// max_length, precision, scale, collation ("" none).

// A table's indexes as SQL Server numbers them: the primary key clustered
// (index_id 1; a table without one is a heap, index 0), the rest
// nonclustered from 2.
type SysIdx = record {
    id: int
    name: str
    oid: int
    clustered: bool
    heap: bool
    unique: bool
    pk: bool
    uq: bool                // a UNIQUE constraint's
    cols: []int             // the table's attnums (0: an expression's)
    descs: []bool
    filter: str
}

fn sysIdxs(ct: &CatTab): []SysIdx {
    var out: []SysIdx = []
    var next = 2
    // the clustered one (T-SQL's CLUSTERED: the primary key unless the table says another, or none: lexdb_catalog.clusterLabel)
    let cl = lexdb_catalog.clusteredOf(&ct.t)
    if len(cl) == 0 {
        append(mut &out, SysIdx{id: 0, name: "", oid: 0, clustered: false, heap: true, unique: false, pk: false, uq: false, cols: [], descs: [],
                                filter: ""})
    }
    // (the clustered index first, as its id 1 is; the rest in their order from 2)
    for pass in 0..2 {
        for ix in ct.idxs {
            let isCl = if ix.primary { cl == lexdb_catalog.CL_PK } else { len(cl) > 0 && ix.name == cl }
            if (pass == 0) != isCl { continue }
            var descs: []bool = []
            for k in 0..len(ix.cols) { append(mut &descs, k < len(ix.opts) && strings.contains(&ix.opts[k], "DESC")) }
            let filt = match ix.pred {
                Some(p) { "(" + tsqlText(&p) + ")" }
                None { "" }
            }
            var id = 1
            if !isCl {
                id = next
                next += 1
            }
            append(mut &out, SysIdx{id: id, name: ix.name.clone(), oid: ix.oid, clustered: isCl, heap: false, unique: ix.unique, pk: ix.primary,
                                    uq: ix.con && !ix.primary, cols: lexdb_catalog.copyInts(&ix.cols), descs: descs, filter: filt})
        }
    }
    return out
}

// The column_id of each of a table's columns: its place among those shown
// (0 for lexdb's hidden row id).
fn sysColIds(t: &Table): []int {
    var out: []int = []
    var n = 0
    for c in t.cols {
        if c.name == ROWID {
            append(mut &out, 0)
        } else {
            n += 1
            append(mut &out, n)
        }
    }
    return out
}

fn sysColId(t: &Table, attnum: int): int {
    let ids = sysColIds(t)
    return if attnum >= 1 && attnum <= len(ids) { ids[attnum - 1] } else { 0 }
}

// A default's object (SQL Server's default constraint): its id and name.
fn sysDefOid(ct: &CatTab, c: &lexdb_sql.ColDef): int { return lexdb_sql.nameOid("d", &(ct.key + "\x00" + c.name)) }
fn sysDefName(ct: &CatTab, c: &lexdb_sql.ColDef): str { return "DF_" + ct.name + "_" + c.name }

fn sysHasDefault(c: &lexdb_sql.ColDef): bool {
    return c.def.isSome() && c.identity != lexdb_sql.ID_ALWAYS && c.identity != lexdb_sql.ID_BY_DEFAULT && c.name != ROWID
}

// The catalog the T-SQL door's INFORMATION_SCHEMA reads: no NOT NULL constraints (PostgreSQL 18's, lexdb_nncon), and a CHECK's
// CHECK_CLAUSE as SQL Server writes it (lexdb_tsqldef), not PostgreSQL's text.
pub fn tsqlIs(snap: mut &CatSnap) {
    snap.nns = []
    for i in 0..len(snap.cons) {
        if snap.cons[i].typ != "c" { continue }
        let ti = lexdb_catalog.catTabIdx(snap, snap.cons[i].rel)
        if ti < 0 { continue }
        for ck in snap.tabs[ti].t.checks {
            if ck.name != snap.cons[i].name { continue }
            let off = lexdb_catalog.isOff(&snap.tabs[ti].t, &ck.name)
            snap.cons[i].check = lexdb_tsqldef.checkText(&(if off { lexdb_catalog.offInner(&ck.expr) } else { lexdb_sql.cloneExpr(&ck.expr) }))
        }
    }
}

// An expression as SQL Server shows a definition: [names], (literals),
// operators without spaces ((([amount]>=(0))).
fn tsqlText(x: &Expr): str {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Null { return "NULL" }
                Val.Text(s) { return "'" + strings.replaceAll(&s, "'", "''") + "'" }
                Val.Bool(b) { return if b { "(1)" } else { "(0)" } }
                else { return "(" + lexdb_sql.text(&v) + ")" }
            }
        }
        Expr.Col(n, _) { return "[" + n + "]" }
        Expr.Unary(op, a) {
            let o: &str = if op == "not" { "NOT " } else { op }
            return o + tsqlText(&a)
        }
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" { return tsqlText(&a) + " " + strings.toUpperAscii(&op) + " " + tsqlText(&b) }
            // (T-SQL's + is "t+", and a column or variable in arithmetic is read through #bitint)
            let o: &str = if op == "t+" { "+" } else { op }
            return "(" + tsqlText(&a) + o + tsqlText(&b) + ")"
        }
        Expr.IsNull(a, not) { return tsqlText(&a) + (if not { " IS NOT NULL" } else { " IS NULL" }) }
        Expr.Call(f, args, star) {
            var n = f.toStr()
            if n == "#bitint" && len(args) == 1 { return tsqlText(&args[0]) }
            if n == "#utcnow" { n = "sysutcdatetime" }
            if n == "localtimestamp" { n = "getdate" }
            if n == "gen_random_uuid" { n = "newid" }
            if n == "current_timestamp" || n == "now" { n = "getdate" }
            var parts: []str = []
            for a in args { append(mut &parts, tsqlText(&a)) }
            return n + "(" + (if star { "*" } else { strings.join(&parts, ",") }) + ")"
        }
        Expr.Cast(a, t) { return tsqlText(&a) }
        else { return lexdb_sql.exprText(x) }
    }
}

// A computed column's definition as SQL Server shows it: in one pair of parentheses (an operator's own are that).
fn tsqlOuter(x: &Expr): str {
    let t = tsqlText(x)
    match x {
        Expr.Bin(op, _, _) { if op != "and" && op != "or" { return t } }
        else {}
    }
    return "(" + t + ")"
}

fn sysDefText(c: &lexdb_sql.ColDef): str {
    match c.def {
        Some(d) {
            let t = tsqlText(&d)
            return if strings.startsWith(&t, "(") { "(" + t + ")" } else { "(" + t + ")" }
        }
        None { return "" }
    }
}

fn fkActionCode(a: &str): int { return if a == "c" { 1 } else if a == "n" { 2 } else if a == "d" { 3 } else { 0 } }
fn fkActionDesc(a: &str): str { return if a == "c" { "CASCADE" } else if a == "n" { "SET_NULL" } else if a == "d" { "SET_DEFAULT" } else { "NO_ACTION" } }

// An object row (sys.objects, all_objects): name, id, schema, parent, type.
fn sysObj(name: &str, id: int, schemaId: int, parent: int, typ: &str, desc: &str, shipped: bool): []Val {
    var r = sysTemplate(&"objects")
    r.set(&"name", tv(name))
    r.set(&"object_id", iv(id))
    r.set(&"principal_id", Val.Null)
    r.set(&"schema_id", iv(schemaId))
    r.set(&"parent_object_id", iv(parent))
    r.set(&"type", tv(&(if len(typ) == 1 { typ + " " } else { typ.toStr() })))
    r.set(&"type_desc", tv(desc))
    r.set(&"create_date", sysTs())
    r.set(&"modify_date", sysTs())
    r.set(&"is_ms_shipped", bv(shipped))
    return r.row()
}

// T-SQL's stored procedures (design/lexdb-dialect-gaps.md, package F): those the catalog has, their object ids and names as
// written. (A routine made in another dialect is not one: its body is not T-SQL.)
fn tsqlProcs(snap: &CatSnap): []lexdb_sql.Routine {
    var out: []lexdb_sql.Routine = []
    for r in snap.routines { if r.dialect == lexdb_sql.RD_TSQL && r.kind == lexdb_sql.RK_PROC { append(mut &out, r.clone()) } }
    return out
}

// T-SQL's procedures and functions.
fn tsqlRoutines(snap: &CatSnap): []lexdb_sql.Routine {
    var out: []lexdb_sql.Routine = []
    for r in snap.routines { if r.dialect == lexdb_sql.RD_TSQL { append(mut &out, r.clone()) } }
    return out
}

// A routine's sys.objects type and its description: P, FN (scalar), IF (inline table-valued), TF (multi-statement).
fn routineType(r: &lexdb_sql.Routine): []str {
    if r.kind == lexdb_sql.RK_PROC { return ["P", "SQL_STORED_PROCEDURE"] }
    if strings.contains(&r.attrs, "inline") { return ["IF", "SQL_INLINE_TABLE_VALUED_FUNCTION"] }
    if strings.contains(&r.attrs, "multi") { return ["TF", "SQL_TABLE_VALUED_FUNCTION"] }
    return ["FN", "SQL_SCALAR_FUNCTION"]
}

pub fn procOid(r: &lexdb_sql.Routine): int { return lexdb_sql.nameOid(&"R", &r.key) }

fn procName(r: &lexdb_sql.Routine): str {
    var n = if len(r.spell) > 0 { r.spell.toStr() } else { lexdb_sql.baseName(&r.key) }
    let d = strings.lastIndexOf(&n, ".")
    if d >= 0 { n = n[d + 1..len(n)].toStr() }
    if len(n) > 1 && ((n[0] == '[' && n[len(n) - 1] == ']') || (n[0] == '"' && n[len(n) - 1] == '"')) { n = n[1..len(n) - 1].toStr() }
    return n
}

// The user objects SQL Server lists in sys.objects: tables, views,
// constraints, defaults, sequences, procedures.
fn sysObjects(snap: &CatSnap): [][]Val {
    var rows: [][]Val = []
    for ct in snap.tabs {
        if lexdb_base.isTempSchema(&ct.schema) { continue }
        let sid = sysSchemaId(&ct.schema)
        append(mut &rows, sysObj(&tabShown(&ct), ct.oid, sid, 0, &"U", &"USER_TABLE", false))
        for c in ct.t.cols {
            if sysHasDefault(&c) { append(mut &rows, sysObj(&sysDefName(&ct, &c), sysDefOid(&ct, &c), sid, ct.oid, &"D", &"DEFAULT_CONSTRAINT", false)) }
        }
    }
    for c in snap.cons {
        if lexdb_base.isTempSchema(&c.schema) { continue }
        let ty = if c.typ == "p" { "PK" } else if c.typ == "u" { "UQ" } else if c.typ == "f" { "F" } else { "C" }
        let desc = if c.typ == "p" { "PRIMARY_KEY_CONSTRAINT" } else if c.typ == "u" { "UNIQUE_CONSTRAINT" } else if c.typ == "f" { "FOREIGN_KEY_CONSTRAINT" } else { "CHECK_CONSTRAINT" }
        append(mut &rows, sysObj(&c.name, c.oid, sysSchemaId(&c.schema), c.rel, &ty, &desc, false))
    }
    for v in snap.views {
        if lexdb_base.isTempSchema(&v.schema) { continue }
        append(mut &rows, sysObj(&tabShown(&v), v.oid, sysSchemaId(&v.schema), 0, &"V", &"VIEW", false))
    }
    for d in snap.seqs {
        if len(d.ownerT) > 0 { continue }
        let sc = lexdb_sql.schemaOf(&d.key)
        if lexdb_base.isTempSchema(&sc) { continue }
        append(mut &rows, sysObj(&lexdb_sql.baseName(&d.key), lexdb_catalog.seqOid(&d), sysSchemaId(&sc), 0, &"SO", &"SEQUENCE_OBJECT", false))
    }
    for r in tsqlRoutines(snap) {
        let rt = routineType(&r)
        append(mut &rows, sysObj(&procName(&r), procOid(&r), sysSchemaId(&lexdb_sql.schemaOf(&r.key)), 0, &rt[0], &rt[1], false))
    }
    // a table type's table: TT_name_hex, SQL Server's own
    for t in snap.ttypes {
        let id = lexdb_sql.nameOid("tt", &t.key)
        let hx = strings.padLeft(&(strings.toUpperAscii(&strings.hex(id))), 8, '0')
        append(mut &rows, sysObj(&("TT_" + t.spell + "_" + hx), id, sysSchemaId(&lexdb_sql.schemaOf(&t.key)), 0, &"TT", &"TYPE_TABLE", true))
    }
    return rows
}

// A table type's row of sys.types or sys.table_types.
fn sysTabTypeRow(t: &TabType, view: &str): []Val {
    var r = sysTemplate(view)
    r.set(&"name", tv(&t.spell))
    r.set(&"system_type_id", iv(243))
    r.set(&"user_type_id", iv(lexdb_sql.nameOid("T", &t.key)))
    r.set(&"schema_id", iv(sysSchemaId(&lexdb_sql.schemaOf(&t.key))))
    r.set(&"principal_id", Val.Null)
    r.set(&"max_length", iv(-1))
    r.set(&"precision", iv(0))
    r.set(&"scale", iv(0))
    r.set(&"collation_name", Val.Null)
    r.set(&"is_nullable", bv(false))
    r.set(&"is_user_defined", bv(true))
    r.set(&"is_assembly_type", bv(false))
    r.set(&"default_object_id", iv(0))
    r.set(&"rule_object_id", iv(0))
    r.set(&"is_table_type", bv(true))
    r.set(&"type_table_object_id", iv(lexdb_sql.nameOid("tt", &t.key)))
    r.set(&"is_memory_optimized", bv(false))
    return r.row()
}

// The columns of the table types' tables (sys.columns).
fn sysTabTypeColumns(snap: &CatSnap): [][]Val {
    var rows: [][]Val = []
    for t in snap.ttypes {
        let cols = lexdb_catalog.tabTypeCols(&t)
        for i in 0..len(cols) {
            let c = &cols[i]
            let ty = sqlTypeOf(&c.typ, &c.coll)
            let ident = c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT || c.identity == lexdb_sql.ID_SERIAL
            let shown: &str = if len(c.spell) > 0 { &c.spell } else { &c.name }
            append(mut &rows, sysColumn(lexdb_sql.nameOid("tt", &t.key), shown, i + 1, &ty, !c.notNull, ident, 0, false))
        }
    }
    return rows
}

// The sys views themselves, as system objects.
fn sysSysObjects(): [][]Val {
    var rows: [][]Val = []
    for v in viewNames() { append(mut &rows, sysObj(&v, viewId(&v), 4, 0, &"V", &"VIEW", true)) }
    return rows
}

fn tabShown(ct: &CatTab): str { return if len(ct.t.spell) > 0 { ct.t.spell.clone() } else { ct.name.clone() } }

// A column row (sys.columns, all_columns) of a column of type ty.
fn sysColumn(objId: int, name: &str, colId: int, ty: &SqlT, nullable: bool, identity: bool, defId: int, computed: bool): []Val {
    var r = sysTemplate(&"columns")
    r.set(&"object_id", iv(objId))
    r.set(&"name", tv(name))
    r.set(&"column_id", iv(colId))
    r.set(&"system_type_id", iv(ty.sys))
    r.set(&"user_type_id", iv(ty.user))
    r.set(&"max_length", iv(ty.maxLen))
    r.set(&"precision", iv(ty.prec))
    r.set(&"scale", iv(ty.scale))
    r.set(&"collation_name", if len(ty.coll) > 0 { tv(&ty.coll) } else { Val.Null })
    r.set(&"is_nullable", bv(nullable))
    let padded = ty.name == "char" || ty.name == "varchar" || ty.name == "nchar" || ty.name == "nvarchar" || ty.name == "sysname" ||
                 ty.name == "binary" || ty.name == "varbinary"
    r.set(&"is_ansi_padded", bv(padded))
    r.set(&"is_identity", bv(identity))
    r.set(&"is_computed", bv(computed))
    r.set(&"default_object_id", iv(defId))
    return r.row()
}

fn sysUserColumns(snap: &CatSnap): [][]Val {
    var rows: [][]Val = []
    for ct in snap.tabs {
        if lexdb_base.isTempSchema(&ct.schema) { continue }
        let ids = sysColIds(&ct.t)
        for i in 0..len(ct.t.cols) {
            let c = &ct.t.cols[i]
            if ids[i] == 0 { continue }
            var nn = c.notNull
            for p in ct.t.pk { if p == i { nn = true } }
            let ty = sqlTypeOf(&c.typ, &c.coll)
            let ident = c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT || c.identity == lexdb_sql.ID_SERIAL
            append(mut &rows, sysColumn(ct.oid, &lexdb_sql.colShown(c), ids[i], &ty, !nn, ident, if sysHasDefault(c) { sysDefOid(&ct, c) } else { 0 }, c.genKind != lexdb_sql.GEN_NONE))
        }
    }
    for v in snap.views {
        if lexdb_base.isTempSchema(&v.schema) { continue }
        for i in 0..len(v.t.cols) {
            let c = &v.t.cols[i]
            // a column of the one table it reads that has its name and type:
            // that column's type and nullability (as SQL Server derives them)
            var ty = sqlTypeOf(&c.typ, &c.coll)
            var nullable = true
            var found = 0
            for d in v.t.deps {
                for ct in snap.tabs {
                    if ct.key != d { continue }
                    for k in 0..len(ct.t.cols) {
                        let b = &ct.t.cols[k]
                        if b.name != c.name || b.typ.oid != c.typ.oid { continue }
                        found += 1
                        ty = sqlTypeOf(&b.typ, &b.coll)
                        var nn = b.notNull
                        for p in ct.t.pk { if p == k { nn = true } }
                        nullable = !nn
                    }
                }
            }
            if found != 1 {
                ty = sqlTypeOf(&c.typ, &c.coll)
                nullable = true
            }
            append(mut &rows, sysColumn(v.oid, &lexdb_sql.colShown(c), i + 1, &ty, nullable, false, 0, false))
        }
    }
    return rows
}

fn sysSysColumns(): [][]Val {
    var rows: [][]Val = []
    for v in viewNames() {
        let id = viewId(&v)
        let cs = cols(&v)
        for k in 0..len(cs) {
            let c = &cs[k]
            let ty = sqlT(&c.typ, c.maxLen, c.prec, c.scale, &c.coll)
            append(mut &rows, sysColumn(id, &c.name, k + 1, &ty, c.nullable, false, 0, false))
        }
    }
    return rows
}

fn sysTableRow(ct: &CatTab, view: &str): []Val {
    var r = sysTemplate(view)
    r.set(&"name", tv(&tabShown(ct)))
    r.set(&"object_id", iv(ct.oid))
    r.set(&"schema_id", iv(sysSchemaId(&ct.schema)))
    r.set(&"create_date", sysTs())
    r.set(&"modify_date", sysTs())
    r.set(&"is_ms_shipped", bv(false))
    var lob = false
    for c in ct.t.cols {
        let ty = sqlTypeOf(&c.typ, &c.coll)
        if ty.maxLen == -1 { lob = true }
    }
    r.set(&"lob_data_space_id", iv(if lob { 1 } else { 0 }))
    r.set(&"max_column_id_used", iv(len(ct.t.cols) - (if lexdb_catalog.rowidKeyed(&ct.t) { 1 } else { 0 })))
    return r.row()
}

fn sysViewRow(v: &CatTab, view: &str): []Val {
    var r = sysTemplate(view)
    r.set(&"name", tv(&tabShown(v)))
    r.set(&"object_id", iv(v.oid))
    r.set(&"schema_id", iv(sysSchemaId(&v.schema)))
    r.set(&"create_date", sysTs())
    r.set(&"modify_date", sysTs())
    r.set(&"is_ms_shipped", bv(false))
    return r.row()
}

fn sysSysViewRows(view: &str): [][]Val {
    var rows: [][]Val = []
    for v in viewNames() {
        var r = sysTemplate(view)
        r.set(&"name", tv(&v))
        r.set(&"object_id", iv(viewId(&v)))
        r.set(&"schema_id", iv(4))
        r.set(&"is_ms_shipped", bv(true))
        append(mut &rows, r.row())
    }
    return rows
}

fn sysDbRow(snap: &CatSnap, dbopts: &str, replica: bool): []Val {
    var r = sysTemplate(&"databases")
    var names: []str = []
    var vals: []Val = []
    lexdb_dbopt.columns(dbopts, mut &names, mut &vals)
    for i in 0..len(names) { r.set(&names[i], vals[i].clone()) }
    if replica { r.set(&"is_read_only", bv(true)) }       // a replica's database is read-only (9.137)
    r.set(&"name", tv(&SYS_DB_NAME))
    r.set(&"database_id", iv(SYS_DB_ID))
    r.set(&"source_database_id", Val.Null)
    r.set(&"owner_sid", Val.Bytes("\x01"))
    r.set(&"create_date", sysTs())
    return r.row()
}

// A string literal of nothing but spaces (T-SQL converts it to 0).
pub fn tsqlBlank(x: &Expr): bool {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Text(t) { return len(strings.trim(&t)) == 0 }
                else { return false }
            }
        }
        else { return false }
    }
}

fn appendRows(rows: mut &[][]Val, more: [][]Val) {
    var m = more
    for i in 0..len(m) { append(rows, replace(mut &m[i], [])) }
}

// A role's principal_id in sys.database_principals: public 0, a superuser (or a name no role has: a trusted login) dbo 1,
// else 5 and on over the other roles in their order.
fn sysPrincipalId(roles: &[]lexdb_catalog.Role, name: &str): int {
    if len(name) == 0 { return 0 }
    var n = 0
    for role in roles {
        if role.superuser { continue }
        if role.name == name { return 5 + n }
        n += 1
    }
    return 1
}

pub fn viewRows(cq: &lexdb_catalog.CatView, view: &str): Result[[][]Val, DbErr] {
    let snap = &cq.snap
    let roles = &cq.roles
    let sess = cq.sess
    var rows: [][]Val = []
    match view.toStr() {
        "objects" { rows = sysObjects(&snap) }
        "all_objects" {
            rows = sysObjects(&snap)
            appendRows(mut &rows, sysSysObjects())
        }
        "system_objects" { rows = sysSysObjects() }
        "tables" {
            for ct in snap.tabs { if !lexdb_base.isTempSchema(&ct.schema) { append(mut &rows, sysTableRow(&ct, &"tables")) } }
        }
        "views", "all_views" {
            for v in snap.views { if !lexdb_base.isTempSchema(&v.schema) { append(mut &rows, sysViewRow(&v, view)) } }
            if view == "all_views" { appendRows(mut &rows, sysSysViewRows(&"all_views")) }
        }
        "system_views" { rows = sysSysViewRows(&"system_views") }
        "columns" {
            rows = sysUserColumns(&snap)
            appendRows(mut &rows, sysTabTypeColumns(&snap))
        }
        "all_columns" {
            rows = sysUserColumns(&snap)
            appendRows(mut &rows, sysTabTypeColumns(&snap))
            appendRows(mut &rows, sysSysColumns())
        }
        "types" {
            rows = sysFull(&"types")
            for t in snap.ttypes { append(mut &rows, sysTabTypeRow(&t, &"types")) }
        }
        "table_types" { for t in snap.ttypes { append(mut &rows, sysTabTypeRow(&t, &"table_types")) } }
        "system_columns" { rows = sysSysColumns() }
        "schemas" {
            rows = sysFull(&"schemas")
            for s in snap.schemas {
                if s == "public" || lexdb_base.isTempSchema(&s) { continue }
                append(mut &rows, [tv(&s), iv(lexdb_sql.nameOid("n", &s)), iv(1)])
            }
        }
        "configurations", "syslanguages", "fulltext_languages", "database_scoped_configurations", "data_spaces",
        "database_files", "dm_os_host_info" { rows = sysFull(view) }
        "database_permissions" {
            // SQL Server's own, then each GRANT on a table or view: class 1 (an object), its object_id, the grantee and the
            // grantor (the owner) by their principal ids, one row a permission (a table's five; lexdb's TRUNCATE and
            // TRIGGER are no permission of SQL Server's)
            rows = sysFull(&"database_permissions")
            for r in lexdb_catalog.privRows(snap) {
                if r.kind == "sequence" || r.dialect == lexdb_sql.RD_ORA { continue }
                var type_ = ""
                var pname = ""
                if r.letter == "X" { type_ = "EX  "; pname = "EXECUTE" }
                else if r.letter == "r" { type_ = "SL  "; pname = "SELECT" }
                else if r.letter == "a" { type_ = "IN  "; pname = "INSERT" }
                else if r.letter == "w" { type_ = "UP  "; pname = "UPDATE" }
                else if r.letter == "d" { type_ = "DL  "; pname = "DELETE" }
                else if r.letter == "x" { type_ = "RF  "; pname = "REFERENCES" }
                else { continue }
                if !lexdb_catalog.privSeen(cq, &r.owner, &r.to, true) { continue }
                var p = sysTemplate(&"database_permissions")
                p.set(&"class", iv(1))
                p.set(&"class_desc", tv(&"OBJECT_OR_COLUMN"))
                p.set(&"major_id", iv(r.oid))
                p.set(&"minor_id", iv(0))
                p.set(&"grantee_principal_id", iv(sysPrincipalId(roles, &r.to)))
                p.set(&"grantor_principal_id", iv(sysPrincipalId(roles, &r.owner)))
                p.set(&"type", tv(&type_))
                p.set(&"permission_name", tv(&pname))
                p.set(&"state", tv(&"G"))
                p.set(&"state_desc", tv(&"GRANT"))
                append(mut &rows, p.row())
            }
        }
        "databases" {
            rows = sysFull(&"databases")
            append(mut &rows, sysDbRow(&snap, &cq.dbopts, cq.replica))
        }
        "database_recovery_status", "database_filestream_options" {
            rows = sysFull(view)
            var r = sysTemplate(view)
            r.set(&"database_id", iv(SYS_DB_ID))
            append(mut &rows, r.row())
        }
        "server_principals" {
            rows = sysFull(&"server_principals")
            var n = 0
            for role in roles {
                if !role.login { continue }
                var r = sysTemplate(&"server_principals")
                r.set(&"name", tv(&role.name))
                r.set(&"principal_id", iv(300 + n))
                r.set(&"sid", Val.Bytes(lexdb_catalog.sysSid(&role.name)))
                r.set(&"create_date", sysTs())
                r.set(&"modify_date", sysTs())
                append(mut &rows, r.row())
                n += 1
            }
        }
        "database_principals" {
            // superusers are dbo; another role that logs in is a user of its name, one that does not a database role
            // (their ids are sysPrincipalId's: sys.database_permissions names them)
            rows = sysFull(&"database_principals")
            var n = 0
            for role in roles {
                if role.superuser { continue }
                var r = sysTemplate(&"database_principals")
                r.set(&"name", tv(&role.name))
                if !role.login {
                    r.set(&"type", tv(&"R"))
                    r.set(&"type_desc", tv(&"DATABASE_ROLE"))
                    r.set(&"default_schema_name", Val.Null)
                    r.set(&"authentication_type", iv(0))
                    r.set(&"authentication_type_desc", tv(&"NONE"))
                }
                r.set(&"principal_id", iv(5 + n))
                r.set(&"sid", Val.Bytes(lexdb_catalog.sysSid(&role.name)))
                r.set(&"create_date", sysTs())
                r.set(&"modify_date", sysTs())
                append(mut &rows, r.row())
                n += 1
            }
        }
        "dm_exec_sessions" {
            var r = sysTemplate(&"dm_exec_sessions")
            r.set(&"session_id", iv(sess))
            r.set(&"login_name", tv(&snap.user))
            r.set(&"original_login_name", tv(&snap.user))
            r.set(&"nt_user_name", tv(&""))
            r.set(&"database_id", iv(SYS_DB_ID))
            r.set(&"authenticating_database_id", iv(1))
            append(mut &rows, r.row())
        }
        "indexes" {
            for ct in snap.tabs {
                if lexdb_base.isTempSchema(&ct.schema) { continue }
                for x in sysIdxs(&ct) {
                    var r = sysTemplate(&"indexes")
                    r.set(&"object_id", iv(ct.oid))
                    r.set(&"name", if x.heap { Val.Null } else { tv(&x.name) })
                    r.set(&"index_id", iv(x.id))
                    r.set(&"type", iv(if x.heap { 0 } else if x.clustered { 1 } else { 2 }))
                    r.set(&"type_desc", tv(&(if x.heap { "HEAP" } else if x.clustered { "CLUSTERED" } else { "NONCLUSTERED" })))
                    r.set(&"is_unique", bv(x.unique))
                    r.set(&"is_primary_key", bv(x.pk))
                    r.set(&"is_unique_constraint", bv(x.uq))
                    r.set(&"has_filter", bv(len(x.filter) > 0))
                    r.set(&"filter_definition", if len(x.filter) > 0 { tv(&x.filter) } else { Val.Null })
                    append(mut &rows, r.row())
                }
            }
        }
        "index_columns" {
            for ct in snap.tabs {
                if lexdb_base.isTempSchema(&ct.schema) { continue }
                for x in sysIdxs(&ct) {
                    var k = 0
                    for j in 0..len(x.cols) {
                        let cid = sysColId(&ct.t, x.cols[j])
                        if cid == 0 { continue }
                        k += 1
                        var r = sysTemplate(&"index_columns")
                        r.set(&"object_id", iv(ct.oid))
                        r.set(&"index_id", iv(x.id))
                        r.set(&"index_column_id", iv(k))
                        r.set(&"column_id", iv(cid))
                        r.set(&"key_ordinal", iv(k))
                        r.set(&"is_descending_key", bv(j < len(x.descs) && x.descs[j]))
                        r.set(&"is_included_column", bv(false))
                        append(mut &rows, r.row())
                    }
                }
            }
        }
        "stats" {
            for ct in snap.tabs {
                if lexdb_base.isTempSchema(&ct.schema) { continue }
                for x in sysIdxs(&ct) {
                    if x.heap { continue }
                    var r = sysTemplate(&"stats")
                    r.set(&"object_id", iv(ct.oid))
                    r.set(&"name", tv(&x.name))
                    r.set(&"stats_id", iv(x.id))
                    r.set(&"has_filter", bv(len(x.filter) > 0))
                    r.set(&"filter_definition", if len(x.filter) > 0 { tv(&x.filter) } else { Val.Null })
                    append(mut &rows, r.row())
                }
            }
        }
        "key_constraints" {
            for c in snap.cons {
                if c.typ != "p" && c.typ != "u" { continue }
                let ti = lexdb_catalog.catTabIdx(&snap, c.rel)
                if ti < 0 || lexdb_base.isTempSchema(&c.schema) { continue }
                var idx = 0
                for x in sysIdxs(&snap.tabs[ti]) { if x.oid == c.idx { idx = x.id } }
                var r = sysTemplate(&"key_constraints")
                r.set(&"name", tv(&c.name))
                r.set(&"object_id", iv(c.oid))
                r.set(&"schema_id", iv(sysSchemaId(&c.schema)))
                r.set(&"parent_object_id", iv(c.rel))
                r.set(&"type", tv(&(if c.typ == "p" { "PK" } else { "UQ" })))
                r.set(&"type_desc", tv(&(if c.typ == "p" { "PRIMARY_KEY_CONSTRAINT" } else { "UNIQUE_CONSTRAINT" })))
                r.set(&"create_date", sysTs())
                r.set(&"modify_date", sysTs())
                r.set(&"unique_index_id", iv(idx))
                r.set(&"is_system_named", bv(!lexdb_catalog.sysNamed(&c, &snap.tabs[ti].name)))
                append(mut &rows, r.row())
            }
        }
        "foreign_keys" {
            for c in snap.cons {
                if c.typ != "f" || lexdb_base.isTempSchema(&c.schema) { continue }
                let ti = lexdb_catalog.catTabIdx(&snap, c.rel)
                let ri = lexdb_catalog.catTabIdx(&snap, c.refRel)
                if ti < 0 { continue }
                var keyIdx = 0
                if ri >= 0 { for x in sysIdxs(&snap.tabs[ri]) { if x.oid == c.idx { keyIdx = x.id } } }
                var r = sysTemplate(&"foreign_keys")
                r.set(&"name", tv(&c.name))
                r.set(&"object_id", iv(c.oid))
                r.set(&"schema_id", iv(sysSchemaId(&c.schema)))
                r.set(&"parent_object_id", iv(c.rel))
                r.set(&"create_date", sysTs())
                r.set(&"modify_date", sysTs())
                r.set(&"referenced_object_id", iv(c.refRel))
                r.set(&"key_index_id", iv(keyIdx))
                r.set(&"is_disabled", bv(!c.enforced))
                r.set(&"is_not_trusted", bv(!c.valid))
                r.set(&"delete_referential_action", iv(fkActionCode(&c.del)))
                r.set(&"delete_referential_action_desc", tv(&fkActionDesc(&c.del)))
                r.set(&"update_referential_action", iv(fkActionCode(&c.upd)))
                r.set(&"update_referential_action_desc", tv(&fkActionDesc(&c.upd)))
                r.set(&"is_system_named", bv(!lexdb_catalog.sysNamed(&c, &snap.tabs[ti].name)))
                append(mut &rows, r.row())
            }
        }
        "foreign_key_columns" {
            for c in snap.cons {
                if c.typ != "f" || lexdb_base.isTempSchema(&c.schema) { continue }
                let ti = lexdb_catalog.catTabIdx(&snap, c.rel)
                let ri = lexdb_catalog.catTabIdx(&snap, c.refRel)
                if ti < 0 || ri < 0 { continue }
                for k in 0..len(c.cols) {
                    var r = sysTemplate(&"foreign_key_columns")
                    r.set(&"constraint_object_id", iv(c.oid))
                    r.set(&"constraint_column_id", iv(k + 1))
                    r.set(&"parent_object_id", iv(c.rel))
                    r.set(&"parent_column_id", iv(sysColId(&snap.tabs[ti].t, c.cols[k])))
                    r.set(&"referenced_object_id", iv(c.refRel))
                    r.set(&"referenced_column_id", iv(if k < len(c.refCols) { sysColId(&snap.tabs[ri].t, c.refCols[k]) } else { 0 }))
                    append(mut &rows, r.row())
                }
            }
        }
        "check_constraints" {
            for ti in 0..len(snap.tabs) {
                let ct = &snap.tabs[ti]
                if lexdb_base.isTempSchema(&ct.schema) { continue }
                for ck in ct.t.checks {
                    let oid = lexdb_sql.nameOid("c", &(ct.key + "\x00" + ck.name))
                    var r = sysTemplate(&"check_constraints")
                    r.set(&"name", tv(&ck.name))
                    r.set(&"object_id", iv(oid))
                    r.set(&"schema_id", iv(sysSchemaId(&ct.schema)))
                    r.set(&"parent_object_id", iv(ct.oid))
                    r.set(&"create_date", sysTs())
                    r.set(&"modify_date", sysTs())
                    // (not enforced: kept as true OR the condition: the condition shown)
                    let coff = lexdb_catalog.isOff(&ct.t, &ck.name)
                    let cx = if coff { lexdb_catalog.offInner(&ck.expr) } else { lexdb_sql.cloneExpr(&ck.expr) }
                    r.set(&"is_disabled", bv(coff))
                    r.set(&"is_not_trusted", bv(lexdb_base.hasStr(&ct.t.invalid, &ck.name)))
                    var used: []str = []
                    lexdb_sql.colNames(&cx, mut &used)
                    var pc = 0
                    if len(used) == 1 { pc = sysColId(&ct.t, lexdb_catalog.colNum(&ct.t, &used[0])) }
                    r.set(&"parent_column_id", iv(pc))
                    r.set(&"definition", tv(&lexdb_tsqldef.checkText(&cx)))
                    let auto = strings.startsWith(&ck.name, &(ct.name + "_")) && strings.endsWith(&ck.name, "_check")
                    r.set(&"is_system_named", bv(auto))
                    append(mut &rows, r.row())
                }
            }
        }
        "default_constraints" {
            for ct in snap.tabs {
                if lexdb_base.isTempSchema(&ct.schema) { continue }
                let ids = sysColIds(&ct.t)
                for i in 0..len(ct.t.cols) {
                    let c = &ct.t.cols[i]
                    if !sysHasDefault(c) { continue }
                    var r = sysTemplate(&"default_constraints")
                    r.set(&"name", tv(&sysDefName(&ct, c)))
                    r.set(&"object_id", iv(sysDefOid(&ct, c)))
                    r.set(&"schema_id", iv(sysSchemaId(&ct.schema)))
                    r.set(&"parent_object_id", iv(ct.oid))
                    r.set(&"create_date", sysTs())
                    r.set(&"modify_date", sysTs())
                    r.set(&"parent_column_id", iv(ids[i]))
                    r.set(&"definition", tv(&sysDefText(c)))
                    r.set(&"is_system_named", bv(true))
                    append(mut &rows, r.row())
                }
            }
        }
        "computed_columns" {
            // the generated columns: PERSISTED ones are stored, the others not (lexdb keeps both in the row; the catalog says which)
            for ct in snap.tabs {
                if lexdb_base.isTempSchema(&ct.schema) { continue }
                let ids = sysColIds(&ct.t)
                for i in 0..len(ct.t.cols) {
                    let c = &ct.t.cols[i]
                    if ids[i] == 0 || c.genKind == lexdb_sql.GEN_NONE { continue }
                    let ty = sqlTypeOf(&c.typ, &c.coll)
                    var r = sysTemplate(&"computed_columns")
                    var cr = sysColumn(ct.oid, &lexdb_sql.colShown(c), ids[i], &ty, !c.notNull, false, 0, true)
                    let ccols = cols(&"columns")
                    for k in 0..len(ccols) { if k < len(cr) { r.set(&ccols[k].name, replace(mut &cr[k], Val.Null)) } }
                    r.set(&"definition", tv(&(match c.gen { Some(x) { tsqlOuter(&x) } None { "" } })))
                    r.set(&"is_persisted", bv(c.genKind == lexdb_sql.GEN_STORED))
                    r.set(&"uses_database_collation", bv(false))
                    append(mut &rows, r.row())
                }
            }
        }
        "identity_columns" {
            for ct in snap.tabs {
                if lexdb_base.isTempSchema(&ct.schema) { continue }
                let ids = sysColIds(&ct.t)
                for i in 0..len(ct.t.cols) {
                    let c = &ct.t.cols[i]
                    if ids[i] == 0 || !(c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT || c.identity == lexdb_sql.ID_SERIAL) { continue }
                    var sq = lexdb_catalog.noSeq()
                    for d in snap.seqs { if d.key == c.seq { sq = lexdb_catalog.seqCopy(&d) } }
                    let ty = sqlTypeOf(&c.typ, &c.coll)
                    var nn = c.notNull
                    for p in ct.t.pk { if p == i { nn = true } }
                    var r = sysTemplate(&"identity_columns")
                    var cr = sysColumn(ct.oid, &lexdb_sql.colShown(c), ids[i], &ty, !nn, true, 0, false)
                    let ccols = cols(&"columns")
                    for k in 0..len(ccols) { if k < len(cr) { r.set(&ccols[k].name, replace(mut &cr[k], Val.Null)) } }
                    r.set(&"seed_value", iv(sq.start))
                    r.set(&"increment_value", iv(sq.inc))
                    r.set(&"last_value", if cq.used.has(&c.seq) { iv(cq.used.getOr(&c.seq, 0)) } else { Val.Null })
                    append(mut &rows, r.row())
                }
            }
        }
        "procedures" {
            for r in tsqlProcs(&snap) {
                var x = sysTemplate(&"procedures")
                x.set(&"name", tv(&procName(&r)))
                x.set(&"object_id", iv(procOid(&r)))
                x.set(&"principal_id", Val.Null)
                x.set(&"schema_id", iv(sysSchemaId(&lexdb_sql.schemaOf(&r.key))))
                x.set(&"parent_object_id", iv(0))
                x.set(&"type", tv(&"P "))
                x.set(&"type_desc", tv(&"SQL_STORED_PROCEDURE"))
                x.set(&"create_date", sysTs())
                x.set(&"modify_date", sysTs())
                x.set(&"is_ms_shipped", bv(false))
                append(mut &rows, x.row())
            }
        }
        "parameters" {
            for r in tsqlRoutines(&snap) {
                // a scalar function's result is its parameter 0, unnamed
                if r.kind == lexdb_sql.RK_FUNC && !r.retSet {
                    let ty = sqlTypeOf(&r.ret, &"")
                    var x = sysTemplate(&"parameters")
                    x.set(&"object_id", iv(procOid(&r)))
                    x.set(&"name", tv(&""))
                    x.set(&"parameter_id", iv(0))
                    x.set(&"system_type_id", iv(ty.sys))
                    x.set(&"user_type_id", iv(ty.user))
                    x.set(&"max_length", iv(ty.maxLen))
                    x.set(&"precision", iv(ty.prec))
                    x.set(&"scale", iv(ty.scale))
                    x.set(&"is_output", bv(true))
                    x.set(&"is_cursor_ref", bv(false))
                    x.set(&"has_default_value", bv(false))
                    x.set(&"is_xml_document", bv(false))
                    x.set(&"xml_collection_id", iv(0))
                    x.set(&"is_readonly", bv(false))
                    x.set(&"is_nullable", bv(true))
                    append(mut &rows, x.row())
                }
                for i in 0..len(r.params) {
                    let p = &r.params[i]
                    let ty = sqlTypeOf(&p.typ, &"")
                    var x = sysTemplate(&"parameters")
                    x.set(&"object_id", iv(procOid(&r)))
                    x.set(&"name", tv(&p.name))
                    x.set(&"parameter_id", iv(i + 1))
                    x.set(&"system_type_id", iv(ty.sys))
                    x.set(&"user_type_id", iv(ty.user))
                    x.set(&"max_length", iv(ty.maxLen))
                    x.set(&"precision", iv(ty.prec))
                    x.set(&"scale", iv(ty.scale))
                    x.set(&"is_output", bv(p.mode == "out"))
                    x.set(&"is_cursor_ref", bv(false))
                    x.set(&"has_default_value", bv(false))
                    x.set(&"is_xml_document", bv(false))
                    x.set(&"xml_collection_id", iv(0))
                    x.set(&"is_readonly", bv(p.readonly))
                    x.set(&"is_nullable", bv(true))
                    append(mut &rows, x.row())
                }
            }
        }
        "sql_modules" {
            for r in tsqlRoutines(&snap) {
                var x = sysTemplate(&"sql_modules")
                x.set(&"object_id", iv(procOid(&r)))
                x.set(&"definition", tv(&r.def))
                append(mut &rows, x.row())
            }
            for v in snap.views {
                if lexdb_base.isTempSchema(&v.schema) { continue }
                var r = sysTemplate(&"sql_modules")
                r.set(&"object_id", iv(v.oid))
                let made = viewDef(&v)
                r.set(&"definition", tv(&(if len(made) > 0 { made } else { "CREATE VIEW " + sysSchemaName(&v.schema) + "." + tabShown(&v) + " AS " + lexdb_sql.viewShown(&v.t.view) })))
                append(mut &rows, r.row())
            }
        }
        "sequences" {
            for d in snap.seqs {
                if len(d.ownerT) > 0 { continue }
                let sc = lexdb_sql.schemaOf(&d.key)
                if lexdb_base.isTempSchema(&sc) { continue }
                var r = sysTemplate(&"sequences")
                r.set(&"name", tv(&lexdb_sql.baseName(&d.key)))
                r.set(&"object_id", iv(lexdb_catalog.seqOid(&d)))
                r.set(&"schema_id", iv(sysSchemaId(&sc)))
                r.set(&"create_date", sysTs())
                r.set(&"modify_date", sysTs())
                r.set(&"start_value", iv(d.start))
                r.set(&"increment", iv(d.inc))
                r.set(&"minimum_value", iv(d.min))
                r.set(&"maximum_value", iv(d.max))
                r.set(&"is_cycling", bv(d.cycle))
                r.set(&"cache_size", iv(d.cache))
                // current_value: the last value given, the start before any; last_used_value: NULL until one is
                r.set(&"current_value", iv(cq.cur.getOr(&d.key, d.start)))
                r.set(&"last_used_value", if cq.used.has(&d.key) { iv(cq.used.getOr(&d.key, 0)) } else { Val.Null })
                append(mut &rows, r.row())
            }
        }
        else {}     // the rest have no rows: triggers, extended properties, xml and spatial indexes, ...
    }
    return Ok(rows)
}


// What SQL Server's catalog functions look up, in the bound catalog
// (bindCatalog): O objects (id, schema, name, type, parent), K columns
// (table, name, column_id, nullable, identity), I indexes (table, name,
// index_id, clustered, unique).

// A definition's text as one line of the bound catalog (a tab, a line end, a backslash each as a backslash and a letter), and back.
pub fn escDef(s: &str): str {
    return strings.replaceAll(&strings.replaceAll(&strings.replaceAll(&strings.replaceAll(s, "\\", "\\\\"), "\t", "\\t"), "\n", "\\n"), "\r", "\\r")
}

pub fn unescDef(s: &str): str {
    var out = ""
    var i = 0
    while i < len(s) {
        if s[i] == '\\' && i + 1 < len(s) {
            let c = s[i + 1]
            if c == 't' { out.addByte('\t') } else if c == 'n' { out.addByte('\n') } else if c == 'r' { out.addByte('\r') } else { out.addByte(c) }
            i += 2
        } else {
            out.addByte(s[i])
            i += 1
        }
    }
    return out
}

// The definition text of an object as created: a view's, kept by lexdb_sql.DEF_MARK (the one entry
// every dialect's lookup uses: OBJECT_DEFINITION, sys.sql_modules; a procedure's is added here by its package).
pub fn viewDef(v: &lexdb_catalog.CatTab): str { return lexdb_sql.viewDefinition(&v.t.view) }

pub fn bind(snap: &CatSnap, b: mut &str) {
    // D object_id, definition
    for v in snap.views {
        if lexdb_base.isTempSchema(&v.schema) { continue }
        let d = viewDef(&v)
        if len(d) > 0 { b += &("D\t" + v.oid.toStr() + "\t" + escDef(&d) + "\n") }
    }
    for r in tsqlRoutines(snap) { b += &("D\t" + procOid(&r).toStr() + "\t" + escDef(&r.def) + "\n") }
    // Y table types (user_type_id, schema_id, name)
    for t in snap.ttypes { b += &("Y\t" + lexdb_sql.nameOid("T", &t.key).toStr() + "\t" + sysSchemaId(&lexdb_sql.schemaOf(&t.key)).toStr() + "\t" + lexdb_catalog.clean(&t.spell) + "\n") }
    for r in sysObjects(snap) {
        // name 0, object_id 1, principal_id 2, schema_id 3, parent 4, type 5
        b += &("O\t" + lexdb_sql.text(&r[1]) + "\t" + lexdb_sql.text(&r[3]) + "\t" + lexdb_catalog.clean(&lexdb_sql.text(&r[0])) + "\t" + strings.trim(&lexdb_sql.text(&r[5])) + "\t" + lexdb_sql.text(&r[4]) + "\n")
    }
    for ct in snap.tabs {
        if lexdb_base.isTempSchema(&ct.schema) { continue }
        let ids = sysColIds(&ct.t)
        for i in 0..len(ct.t.cols) {
            let c = &ct.t.cols[i]
            if ids[i] == 0 { continue }
            var nn = c.notNull
            for p in ct.t.pk { if p == i { nn = true } }
            let ident = c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT || c.identity == lexdb_sql.ID_SERIAL
            b += &("K\t" + ct.oid.toStr() + "\t" + lexdb_sql.colShown(c) + "\t" + ids[i].toStr() + "\t" + (if nn { "0" } else { "1" }) + "\t" +
                  (if ident { "1" } else { "0" }) + "\t" + (if c.genKind != lexdb_sql.GEN_NONE { "1" } else { "0" }) + "\n")
        }
        for x in sysIdxs(&ct) {
            if x.heap { continue }
            b += &("I\t" + ct.oid.toStr() + "\t" + x.name + "\t" + x.id.toStr() + "\t" + (if x.clustered { "1" } else { "0" }) + "\t" +
                  (if x.unique { "1" } else { "0" }) + "\t" + (if x.pk { "1" } else { "0" }) + "\t" + (if x.uq { "1" } else { "0" }) + "\n")
        }
    }
    for v in snap.views {
        if lexdb_base.isTempSchema(&v.schema) { continue }
        for i in 0..len(v.t.cols) { b += &("K\t" + v.oid.toStr() + "\t" + lexdb_sql.colShown(&v.t.cols[i]) + "\t" + (i + 1).toStr() + "\t1\t0\n") }
    }
}
