// lexdb: the replication link between a master and its read-only replica,
// two processes on one machine sharing the data directory (design/lexdb.md
// 9.68, 9.72). A Unix socket in the data directory (SOCK) carries lines:
//
//   replica -> master   N              the handshake: hold what I will read
//   master -> replica   C <ckpt>       held from this checkpoint on
//   master -> replica   D <batch> <ckpt>   the log holds batches to <batch>;
//                                      the last checkpoint is <ckpt>
//   master -> replica   F <batch> <seg> <off> <len>, then <len> bytes:
//                                      batch's frame, durable, as written at
//                                      <off> of log segment <seg> (9.135)
//   replica -> master   H <ckpt> <seg> keep checkpoints from <ckpt> on and
//                                      log segments from <seg> on (Store.hold)
//
// After each flush the master pushes the durable batches' frames (F), from
// the frames it keeps (Store.framesAfter); the replica applies them from
// memory. When a replica is too far behind for those, or at the start, the
// master sends D instead, and the replica reads the batches from the log
// itself; D also tells it of a new checkpoint. Pages come from the page
// file: nothing else crosses. When the replica goes, the master lets go of its hold; when
// the master goes, the replica stops (a master that starts again may reuse
// pages the replica reads). Any number of replicas: each has its hold, and
// the master keeps what the oldest needs (9.73).
import "task"
import "net"
import "strings"
import "time"
import "./lexdb_base"
import "./lexdb_disk"
import "./lexdb_store"

pub const SOCK = "repl.sock"

// Lines from a connection's read side.
type Lines = record { buf: []byte; at: int; end: int }

fn newLines(): Lines { return Lines{buf: array(65536, byte(0)), at: 0, end: 0} }

// The next n bytes of the stream (a pushed frame), after a line.
fn (l: mut &Lines) take(r: &net.ReadHalf, n: int): Result[[]byte, lexdb_base.DbErr] {
    var out: []byte = withCapacity(n)
    while len(out) < n && l.at < l.end {
        append(mut &out, l.buf[l.at])
        l.at += 1
    }
    while len(out) < n {
        let want = min(n - len(out), len(l.buf))
        match r.read(mut &l.buf[0..want]) {
            Ok(k) {
                if k == 0 { return Err(lexdb_base.ioErr("replication: the master closed the link in a frame", 104)) }
                for i in 0..k { append(mut &out, l.buf[i]) }
            }
            Err(e) { return Err(lexdb_base.ioErr("replication: read", 5)) }
        }
    }
    if l.at == l.end {
        l.at = 0
        l.end = 0
    }
    return Ok(out)
}

// The next line (without its newline), or None at the end of the stream.
fn (l: mut &Lines) next(r: &net.ReadHalf): Result[Option[str], lexdb_base.DbErr] {
    while true {
        var i = l.at
        while i < l.end {
            if l.buf[i] == '\n' {
                let line = strFromBytes(&l.buf[l.at..i])
                l.at = i + 1
                return Ok(Some(line))
            }
            i += 1
        }
        // keep what is left of a line at the start
        let rest = l.end - l.at
        for j in 0..rest { l.buf[j] = l.buf[l.at + j] }
        l.at = 0
        l.end = rest
        if l.end == len(l.buf) { return Err(lexdb_base.corrupt("replication: a line too long")) }
        match r.read(mut &l.buf[l.end..len(l.buf)]) {
            Ok(n) {
                if n == 0 { return Ok(None) }
                l.end += n
            }
            Err(e) { return Err(lexdb_base.ioErr("replication: read", 5)) }
        }
    }
    return Ok(None)
}

// A line just read, if one is whole in the buffer: what is ready now,
// without waiting.
fn (l: mut &Lines) ready(): Option[str] {
    var i = l.at
    while i < l.end {
        if l.buf[i] == '\n' {
            let line = strFromBytes(&l.buf[l.at..i])
            l.at = i + 1
            return Some(line)
        }
        i += 1
    }
    return None
}

// A line read, or "" at the end of the stream or on an error (no line the
// link sends is empty).
fn lineOr(r: Result[Option[str], lexdb_base.DbErr]): str {
    if r.isErr() { return "" }
    return r.unwrap().unwrapOr("")
}

fn ints(line: &str): []int {
    var out: []int = []
    let f = strings.fields(line)
    for i in 1..len(f) { append(mut &out, strings.parseIntOpt(f[i]).unwrapOr(-1)) }
    return out
}

// ---- the master's side

pub type Serve = record { pub st: lexdb_store.Store; pub dir: str }

// Serves replicas on the data directory dir's socket until it is cancelled
// (run as a task beside the writer). A replica's hold lasts while it is
// connected.
pub fn serve(x: Serve): int {
    let Serve{st: st, dir: dir} = move(x)
    let path = dir + "/" + SOCK
    let gone = lexdb_disk.real(&dir).remove(SOCK)       // one left by a crash
    let lr = net.listenUnix(&path)
    if lr.isErr() {
        eprintln("lexdb: replication socket " + path + ": " + lr.unwrapErr().toStr())
        return 1
    }
    var ln = lr.unwrap()
    var next = 1                                       // each replica's hold by id (0 is this process's)
    task.scope(fn(s: mut &task.Scope) {
        while true {
            match ln.accept() {
                Ok(c) {
                    s.spawn(serveOne, Peer{st: st.share(), c: c, id: next})
                    next += 1
                }
                Err(e) { break }
            }
        }
    })
    return 0
}

type Peer = record { st: lexdb_store.Store; c: net.Conn; id: int }

fn serveOne(p: Peer): int {
    let Peer{st: st, c: c, id: id} = move(p)
    let net.Halves{read: r, write: w} = c.split()
    var lines = newLines()
    // the handshake
    let first = lineOr(lines.next(&r))
    if first == "N" {
        // a new store has no checkpoint, and one from before covers was
        // kept cannot be read: one now (or the one running: checkpoint
        // returns at once when one is)
        var tries = 0
        while !st.checkpointCovers() && tries < 100 {
            match st.checkpoint() {
                Ok(_) {}
                Err(e) { eprintln("lexdb: replication: a checkpoint for the replica: " + e.toStr()) }
            }
            if !st.checkpointCovers() && !st.waitChange() { break }
            tries += 1
        }
        let held = st.holdNowFor(id)
        if w.writeStr(&("C " + held.toStr() + "\n")).isOk() {
            var ws = [w]
            task.scope(fn(s: mut &task.Scope) {
                let sender = s.start(sendChanges, Changes{st: st.share(), w: pop(mut &ws)})
                // the replica's holds, and the doors it serves (9.137), until it goes
                var doors: []str = []
                while true {
                    let l = lineOr(lines.next(&r))
                    if len(l) == 0 { break }
                    if strings.startsWith(&l, "H ") {
                        let v = ints(&l)
                        if len(v) == 2 { st.holdFor(id, v[0], v[1]) }
                    } else if strings.startsWith(&l, "A ") {
                        append(mut &doors, l[2..len(l)].toStr())
                        setRoutes(&st, id, &doors)
                    }
                }
                { let stop = sender }
            })
        }
    }
    let none: []str = []
    setRoutes(&st, id, &none)
    st.holdFor(id, -1, -1)
    return 0
}

type Changes = record { st: lexdb_store.Store; w: net.WriteHalf }

// After each change: the durable batches' frames (F, one write for all of
// them), or a D line when they are not kept (at the start, or a replica
// that fell behind) and when the checkpoint has moved.
fn sendChanges(x: Changes): int {
    var lastB = -1
    var lastC = -1
    while true {
        let b = x.st.durableBatch()
        let c = x.st.durableCheckpoint()
        if lastB >= 0 && b > lastB {
            var fs: []lexdb_store.PushFrame = []
            if x.st.framesAfter(lastB, b, mut &fs) {
                var out: []byte = []
                var top = lastB
                for f in fs {
                    let h = "F " + f.batch.toStr() + " " + f.seg.toStr() + " " + f.off.toStr() + " " + len(f.data).toStr() + "\n"
                    for i in 0..len(h) { append(mut &out, strByte(h, i)) }
                    for v in f.data { append(mut &out, v) }
                    top = f.batch
                }
                if x.w.write(&out).isErr() { return 1 }
                lastB = top
            }
        }
        if b != lastB || c != lastC {
            if x.w.writeStr(&("D " + b.toStr() + " " + c.toStr() + "\n")).isErr() { return 1 }
            if b > lastB { lastB = b }
            lastC = c
        }
        if !x.st.waitChange() { return 0 }
    }
    return 0
}

// ---- the replica's side

// A replica's link to its master: the store that reads through it, and
// the connection.
pub type Replica = record { pub st: lexdb_store.Store; c: net.Conn; ob: task.Shared[lexdb_store.Outbox]; ckpt: int }

// Connects to the master of the data directory dir (waiting up to waitMs
// for its socket), and opens a replica store on it, ready (applied up to
// its first checkpoint's covers batch) when this returns.
pub fn connect(dir: &str, logFs: Option[lexdb_disk.Fs], opts: lexdb_store.Options, waitMs: int): Result[Replica, lexdb_base.DbErr] {
    // tried again until waitMs has passed: the master may not be up yet
    let end = time.monotonicNs() + waitMs * 1000000
    var last = lexdb_base.ioErr("replication: no master", 111)
    while true {
        var cs: []net.Conn = []
        var held = -1
        match handshake(dir, maxInt(end - time.monotonicNs(), 0) / 1000000, mut &cs) {
            Ok(h) { held = h }
            Err(e) { last = e }
        }
        if held >= 0 {
            let ob = lexdb_store.newOutbox(held)
            let st = try match logFs {
                Some(l) { lexdb_store.openReplicaSplit(lexdb_disk.real(dir), l.share(), opts, lexdb_store.Link.Remote(ob.share())) }
                None { lexdb_store.openReplica(lexdb_disk.real(dir), opts, lexdb_store.Link.Remote(ob.share())) }
            }
            return Ok(Replica{st: st, c: pop(mut &cs), ob: ob, ckpt: held})
        }
        if time.monotonicNs() >= end { return Err(last) }
        // the wait is cut short by SIGTERM or SIGINT (a supervisor stopping its workers)
        let sig = task.within(100, fn(): Result[int, task.Cancelled] { return task.terminated() })
        if sig.isOk() { return Err(lexdb_base.ioErr("replication: stopped while waiting for the master", 4)) }
    }
    return Err(last)
}

fn maxInt(a: int, b: int): int { return if a > b { a } else { b } }

// Connects and asks for a hold: the checkpoint held from, the connection
// left in out.
fn handshake(dir: &str, waitMs: int, out: mut &[]net.Conn): Result[int, lexdb_base.DbErr] {
    let path = dir + "/" + SOCK
    let cr = net.connectUnixFor(&path, maxInt(waitMs, 1))
    if cr.isErr() { return Err(lexdb_base.ioErr(&("connect " + path + ": " + cr.unwrapErr().toStr()), 111)) }
    var c = cr.unwrap()
    if c.writeStr("N\n").isErr() { return Err(lexdb_base.ioErr("replication: handshake", 5)) }
    // the reply, read a byte at a time: what follows is the link task's
    var line: []byte = []
    var one = array(1, byte(0))
    while true {
        match c.read(mut &one) {
            Ok(n) {
                if n == 0 { return Err(lexdb_base.ioErr("replication: the master closed the link", 104)) }
                if one[0] == '\n' { break }
                append(mut &line, one[0])
            }
            Err(e) { return Err(lexdb_base.ioErr("replication: handshake", 5)) }
        }
    }
    let reply = strFromBytes(&line)
    if !strings.startsWith(&reply, "C ") { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, &("replication: the master says " + reply))) }
    append(out, c)
    return Ok(ints(&reply)[0])
}

// Follows the master until the link ends (run as a task): applies the
// batches each D line names, reads a newer checkpoint when one is named,
// and sends the follower's holds. ready is completed once the replica can
// serve (its first checkpoint taken up). Gives 0 when the master closed
// the link, 1 on an error.
pub type Follow = record { pub rp: Replica; pub ready: task.Promise[Unit] }

pub fn follow(x: Follow): int {
    let Follow{rp: rp, ready: ready} = move(x)
    let Replica{st: st, c: c, ob: ob, ckpt: ckpt0} = move(rp)
    let fo = st.follower().unwrap()
    let net.Halves{read: r, write: w} = c.split()
    var code = 0
    var waiting = [ready]
    var ws = [w]
    task.scope(fn(s: mut &task.Scope) {
        let sender = s.start(sendHolds, Holds{ob: ob.share(), w: pop(mut &ws)})
        var lines = newLines()
        var lastC = ckpt0
        while true {
            let got = lines.next(&r)
            if got.isErr() {
                code = 1
                break
            }
            match got.unwrap() {
                Some(l) {
                    if strings.startsWith(&l, "F ") {
                        // a pushed frame: applied from memory (9.135)
                        let v = ints(&l)
                        if len(v) != 4 {
                            code = 1
                            break
                        }
                        let data = lines.take(&r, v[3])
                        if data.isErr() {
                            code = 1
                            break
                        }
                        match fo.pushed(v[0], v[1], v[2], &data.unwrap()) {
                            Ok(_) {}
                            Err(e) {
                                eprintln("lexdb: replica: " + e.toStr())
                                code = 1
                                break
                            }
                        }
                        if len(waiting) > 0 && fo.ready() { pop(mut &waiting).complete(Unit{}) }
                        continue
                    }
                    let cur = l
                    if !strings.startsWith(&cur, "D ") { continue }
                    let v = ints(&cur)
                    if len(v) != 2 { continue }
                    if v[1] > lastC {
                        fo.checkpointed()
                        lastC = v[1]
                    }
                    match fo.poll(v[0]) {
                        Ok(_) {}
                        Err(e) {
                            eprintln("lexdb: replica: " + e.toStr())
                            code = 1
                            break
                        }
                    }
                    if len(waiting) > 0 && fo.ready() { pop(mut &waiting).complete(Unit{}) }
                }
                None { break }
            }
        }
        { let stop = sender }
    })
    return code                 // ready, if never completed, is dropped: its waiter gets an error
}

type Holds = record { ob: task.Shared[lexdb_store.Outbox]; w: net.WriteHalf }

// H lines: the follower's hold, each time it moves; A lines: the doors the
// replica serves, once it listens (9.137).
fn sendHolds(x: Holds): int {
    var lastC = -2
    var lastS = -2
    var lastD = 0
    while true {
        var ck = -1
        var sg = -1
        var da = 0
        var doors: []str = []
        var fut: []task.Future[Unit] = []
        x.ob.with(fn(o: mut &lexdb_store.Outbox) {
            ck = o.ckpt
            sg = o.seg
            da = o.doorsAt
            if da != lastD { doors = o.doors.clone() }
            if ck == lastC && sg == lastS && da == lastD {
                let task.Handoff{promise: p, future: f} = task.promise[Unit]()
                append(mut &o.wake, p)
                append(mut &fut, f)
            }
        })
        if len(fut) > 0 {
            if pop(mut &fut).wait().isErr() { return 0 }
            continue
        }
        if da != lastD {
            var b = ""
            for d in doors { b += "A " + d + "\n" }
            if len(b) > 0 && x.w.writeStr(&b).isErr() { return 1 }
            lastD = da
        }
        if (ck != lastC || sg != lastS) && ck >= 0 && x.w.writeStr(&("H " + ck.toStr() + " " + sg.toStr() + "\n")).isErr() { return 1 }
        lastC = ck
        lastS = sg
    }
    return 0
}

// ---- routing read-only clients to the replicas (lexdb.md 9.137)

// The link's outbox of a replica, kept before follow takes the replica:
// announce writes to it.
pub fn outboxOf(rp: &Replica): task.Shared[lexdb_store.Outbox] { return rp.ob.share() }

// Tells the master the doors this replica serves ("tds HOST:PORT", "tns
// ...", "tcps ..."), sent as A lines by the link's task.
pub fn announce(ob: &task.Shared[lexdb_store.Outbox], doors: &[]str) {
    var wake: []task.Promise[Unit] = []
    ob.with(fn(o: mut &lexdb_store.Outbox) {
        o.doors = doors.clone()
        o.doorsAt += 1
        while len(o.wake) > 0 { append(mut &wake, pop(mut &o.wake)) }
    })
    while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
}

// The memo key of a door's replicas, on the master: lines "id HOST:PORT",
// one per replica listener announced, while its link lasts.
fn routesKey(door: &str): str { return "\x00routes\x00" + door }

// Replica id's announced doors (A lines: "door HOST:PORT" each, all at
// once) in place of its earlier ones; none when its link ends. (Public for
// the tests, whose replica is in the same process: tests/lexdb/run/replica_doors.)
pub fn setRoutes(st: &lexdb_store.Store, id: int, doors: &[]str) {
    let mine = id.toStr() + " "
    for door in ["tds", "tns", "tcps"] {
        var keep = ""
        for l in strings.split(&(st.memo.get(&routesKey(&door)).unwrapOr("")), "\n") {
            if len(l) > 0 && !strings.startsWith(&l, &mine) { keep += l + "\n" }
        }
        for d in doors {
            let sp = strings.indexOf(&d, " ", 0)
            if sp > 0 && d[0..sp] == door { keep += mine + d[sp + 1..len(d)] + "\n" }
        }
        st.memo.put(&routesKey(&door), &keep)
    }
}

// A replica's address for a client of door ("tds", "tns", "tcps") the
// master routes there (the n-th of those up, round robin by n), None when
// no replica serves that door now.
pub fn routeOf(st: &lexdb_store.Store, door: &str, n: int): Option[str] {
    var addrs: []str = []
    for l in strings.split(&(st.memo.get(&routesKey(door)).unwrapOr("")), "\n") {
        let sp = strings.indexOf(&l, " ", 0)
        if sp > 0 { append(mut &addrs, l[sp + 1..len(l)].toStr()) }
    }
    if len(addrs) == 0 { return None }
    return Some(addrs[(if n < 0 { -n } else { n }) % len(addrs)].clone())
}
