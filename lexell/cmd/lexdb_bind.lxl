// lexdb_bind: what a query means (design/lexdb-layers.md 4.4, layer 4):
// the types of expressions, decided before a query runs. It sits above
// lexdb_sql (the parse tree and values) and below lexdb_plan and
// lexdb_exec; a dialect supplies its typing as data (Typing).
//
// Step 2's first slice: the expression types the executor labels columns
// with and casts by (exprOid, moved from lexdb_exec). Then the typed
// expression IR (BX, bindExpr) and, in 2d, name resolution: resolve and the
// select list, ORDER BY and GROUP BY over a query's columns, with the
// naming part of the executor's Scope (Names). The planner's hints stay in
// lexdb_exec (lexdb-layers.md 4.4.1).

import "strings"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_catalog"
import "./lexdb_dialect"
import "./lexdb_ops"
import "./lexdb_lib"

type Expr = lexdb_sql.Expr
type Val = lexdb_sql.Val

// What a dialect supplies the binder for typing: which typing facts
// (lexdb_dialect.TYPE_FACTS and IMPLICIT_CASTS: RULES_PG), and its
// functions' result types (Oracle's lexdb_orafn.resultOid; a text when it
// does not know the name).
pub type Typing = value record {
    pub rules: int
    pub fnOid: fn(&str, &[]int): int
    pub fnBind: fn(&str, int): FnRef  // a function's call bound (bindExpr): the executor's way for it, FN_NONE eval's alone
}

// ---- columns (design/lexdb-layers.md 4.4.1, step 2d)

// A column's or an expression's type, as the binder gives it.
pub type Ty = value record {
    pub oid: int                // the type (lexdb_sql.OID_*, an enum's OID, an array's)
    pub mod: int                // numeric p << 16 | s, varchar/char n, a time type's precision; -1 none
    pub coll: str               // a text's collation, its name as written ("" exact, lexdb's default)
    pub collLevel: int          // CL_*: the collation's strength
    pub notNull: bool
}

// A collation's strength (Ty.collLevel): SQL Server's precedence, COLLATE
// (explicit) over a column's (implicit) over a literal's, a variable's or a
// parameter's (the session's default); CL_NONE: not a text.
pub const CL_NONE = 0
pub const CL_DEFAULT = 1
pub const CL_IMPLICIT = 2
pub const CL_EXPLICIT = 3

// A query level's column: its slot (its place in the joined row), its name
// as expressions name it (alias.column, lexdb_exec's DUPSEP for a name
// repeated in one FROM item), its name as written where that differs
// (spell; "" else) and its type.
pub type BCol = record {
    pub slot: int
    pub name: str
    pub spell: str
    pub ty: Ty
}

// The type of a column of type t, collation coll ("" none).
pub fn tyOf(t: &lexdb_sql.TypeName, coll: &str, notNull: bool): Ty {
    var m = -1
    if (t.oid == lexdb_sql.OID_VARCHAR || t.oid == lexdb_sql.OID_BPCHAR) && t.len > 0 {
        m = t.len
    } else if t.kind == lexdb_sql.K_NUM && t.prec > 0 {
        m = (t.prec << 16) | t.scale
    } else if lexdb_sql.isTimeKind(t.kind) && t.prec > 0 {
        m = t.scale
    }
    let text = t.kind == lexdb_sql.K_TEXT
    return Ty{oid: t.oid, mod: m, coll: if text { coll.toStr() } else { "" }, collLevel: if text { CL_IMPLICIT } else { CL_NONE }, notNull: notNull}
}

// Column c of a query level at slot.
pub fn bcolOf(slot: int, c: &lexdb_sql.ColDef): BCol {
    return BCol{slot: slot, name: c.name, spell: c.spell, ty: tyOf(&c.typ, &c.coll, c.notNull)}
}

// Output column o of a SELECT at slot: its name, spell and type as the
// output gives them; mod: its typmod as a query reading it sees it (the
// dialects' wire hints in o.scale: lexdb_exec's outType), -1 none.
pub fn outBCol(slot: int, o: &OutCol, mod: int): BCol {
    let text = isTextOid(o.oid)
    return BCol{slot: slot, name: o.name, spell: o.spell,
                ty: Ty{oid: o.oid, mod: mod, coll: if text { o.coll.toStr() } else { "" }, collLevel: if text { CL_IMPLICIT } else { CL_NONE }, notNull: false}}
}

pub fn copyBCols(cs: &[]BCol): []BCol {
    var out: []BCol = withCapacity(len(cs))
    for c in cs { append(mut &out, BCol{slot: c.slot, name: c.name, spell: c.spell, ty: c.ty}) }
    return out
}

// ---- the logical plan (design/lexdb-layers.md 4.4.1, step 2e)

// A query as the binder gives it: a tree of logical operators, each with
// its output columns last ([] in a pass-through operator, whose columns
// are its input's: lpColumns gives every operator's). Expressions are as
// resolve gives them (names resolved, Expr.Col carrying its slot in its
// operator's input row); the planner's rewrites (aggregates to #agg
// slots, semi-joins, pushed-down conjuncts, the join order) are not in
// it. It holds nothing of a run: a Sel keeps it, and the plan cache keeps
// the Sel.
//
// Built beside the executor's structures (slice 1: read by nothing):
// lexdb_exec's buildQuery makes the FROM and WHERE part (Query.lp),
// planSelect, planSet and planSub the rest (Sel.lp).
pub type LPlan = closed {
    One([]BCol)                                     // no FROM: one row of no columns
    Get(str, str, []BCol)                           // a table, a sequence's row: its name, its alias; columns at their row slots
    Values(int, []Expr, []BCol)                     // VALUES: its width, its values row by row; columns at 0..
    Func(str, bool, []Expr, []BCol)                 // a function in FROM: its name, WITH ORDINALITY, its arguments; columns at 0..
    CteRef(int, bool, []BCol)                       // a CTE's use: its number, true for the recursive term's working table; columns at 0..
    Sub(str, int, LPlan, []BCol)                    // a FROM item that is a query (a subquery, a view, a CTE's use, a function, VALUES,
                                                    // a working table): a view's name ("" else), its plan's number in Query.subs (-1 none),
                                                    // its plan; its columns renamed (alias.column) at their row slots
    Join(int, bool, LPlan, LPlan, []Expr, []BCol)   // lexdb_sql.J_*, LATERAL, left, right, ON (USING's and NATURAL's made); the left's
                                                    // columns then the right's
    Filter(LPlan, []Expr, []BCol)                   // WHERE (after pullCommonOr) or HAVING; [] (its input's columns: lpColumns)
    Agg(LPlan, []Expr, [][]int, int, []BCol)        // GROUP BY's keys (before the planner drops redundant ones), the grouping sets
                                                    // ([] plain), the aggregates' number; [] (its input's columns: a group's row;
                                                    // the aggregates are read by #agg slot, as BX.Agg)
    Window(LPlan, []lexdb_sql.WinDef, []BCol)       // the window calls (named windows merged); [] (its input's columns: the values
                                                    // at #agg slots after the aggregates')
    Project(LPlan, []Expr, []BCol)                  // the select list, * expanded ([] where the Sel has it: lpLentExprs); the
                                                    // outputs at 0..
    Distinct(LPlan, []Expr, []BCol)                 // DISTINCT ON's expressions, [] plain DISTINCT; [] (its input's columns)
    Sort(LPlan, []Expr, []bool, []bool, []BCol)     // ORDER BY's keys (DISTINCT ON's added; [] where the Sel has them:
                                                    // lpLentOrder), descending, NULLs first; read over the Project's
                                                    // input and outputs (orderValue); [] (its input's columns)
    Limit(LPlan, Option[Expr], Option[Expr], bool, int, []BCol)  // LIMIT/FETCH/TOP's count, OFFSET, WITH TIES, lexdb_sql.TOP_*;
                                                                 // [] (its input's columns)
    SetOp(int, bool, LPlan, LPlan, []BCol)          // lexdb_sql.SET_*, ALL, left, right; the common types
    Recursive(int, LPlan, LPlan, []BCol)            // a recursive CTE: its number, the anchor, the recursive term
    Match(LPlan, []BCol)                            // MATCH_RECOGNIZE over its input (the plan's MrPlan has the rest)
}

pub fn noPlan(): LPlan { return LPlan.One([]) }

// p's output columns. A pass-through operator (Filter, Agg, Window,
// Distinct, Sort, Limit), whose columns are its input's, holds no list of
// its own ([]): its input's are its. (One that holds a list gives it.)
pub fn lpColumns(p: &LPlan): &[]BCol {
    match p {
        LPlan.One(c) { return &c }
        LPlan.Get(_, _, c) { return &c }
        LPlan.Values(_, _, c) { return &c }
        LPlan.Func(_, _, _, c) { return &c }
        LPlan.CteRef(_, _, c) { return &c }
        LPlan.Sub(_, _, _, c) { return &c }
        LPlan.Join(_, _, _, _, _, c) { return &c }
        LPlan.Filter(i, _, c) { if len(c) > 0 { return &c } return lpColumns(&i) }
        LPlan.Agg(i, _, _, _, c) { if len(c) > 0 { return &c } return lpColumns(&i) }
        LPlan.Window(i, _, c) { if len(c) > 0 { return &c } return lpColumns(&i) }
        LPlan.Project(_, _, c) { return &c }
        LPlan.Distinct(i, _, c) { if len(c) > 0 { return &c } return lpColumns(&i) }
        LPlan.Sort(i, _, _, _, c) { if len(c) > 0 { return &c } return lpColumns(&i) }
        LPlan.Limit(i, _, _, _, _, c) { if len(c) > 0 { return &c } return lpColumns(&i) }
        LPlan.SetOp(_, _, _, _, c) { return &c }
        LPlan.Recursive(_, _, _, c) { return &c }
        LPlan.Match(_, c) { return &c }
    }
}

// p's output columns, copied.
pub fn lpCols(p: &LPlan): []BCol { return copyBCols(lpColumns(p)) }

// The lists a SELECT's plan lends its Sel (lexdb_exec's planSelect): where
// the planner rewrote no part of the select list, the list is the Sel's
// (Sel.exprs, its first n: the Project's columns') and the Project's is [];
// where it rewrote no ORDER BY key, the keys are the Sel's (Sel.order) and
// the Sort's are [] (its desc says how many). Both under the Sel's own
// operators (Match, Limit, Sort, Distinct, Project).

// The Project's n where it lends its list, -1 where it has its own or there
// is no Project.
pub fn lpLentExprs(p: &LPlan): int {
    match p {
        LPlan.Match(i, _) { return lpLentExprs(&i) }
        LPlan.Limit(i, _, _, _, _, _) { return lpLentExprs(&i) }
        LPlan.Sort(i, _, _, _, _) { return lpLentExprs(&i) }
        LPlan.Distinct(i, _, _) { return lpLentExprs(&i) }
        LPlan.Project(_, xs, c) { return if len(xs) == 0 && len(c) > 0 { len(c) } else { -1 } }
        else { return -1 }
    }
}

// Whether the Sort lends its keys.
pub fn lpLentOrder(p: &LPlan): bool {
    match p {
        LPlan.Match(i, _) { return lpLentOrder(&i) }
        LPlan.Limit(i, _, _, _, _, _) { return lpLentOrder(&i) }
        LPlan.Sort(_, k, d, _, _) { return len(k) == 0 && len(d) > 0 }
        else { return false }
    }
}

// p with the lists it lends: the Project's xs, the Sort's order.
pub fn lpRestore(p: LPlan, xs: []Expr, order: []Expr): LPlan {
    match move(p) {
        LPlan.Match(i, c) { return LPlan.Match(lpRestore(i, xs, order), c) }
        LPlan.Limit(i, n, o, t, m, c) { return LPlan.Limit(lpRestore(i, xs, order), n, o, t, m, c) }
        LPlan.Sort(i, k, d, nf, c) {
            let lent = len(k) == 0 && len(d) > 0
            return LPlan.Sort(lpRestore(i, xs, []), if lent { order } else { k }, d, nf, c)
        }
        LPlan.Distinct(i, on, c) { return LPlan.Distinct(lpRestore(i, xs, order), on, c) }
        LPlan.Project(i, px, c) { return LPlan.Project(i, if len(px) == 0 && len(c) > 0 { xs } else { px }, c) }
        else { panic("lpRestore: no Project") }
    }
}

// ---- common types (PostgreSQL's parse_coerce.c select_common_type)

// No type yet: an untyped literal or parameter (705), or none (0).
pub fn isUnknownOid(o: int): bool { return o == 0 || o == lexdb_sql.OID_UNKNOWN }

// A type's facts: its category ('A' an array; a type the facts do not
// name, as an enum, its own category 'U') and whether it is preferred.
fn factOf(ty: &Typing, oid: int): lexdb_dialect.TypeFact {
    for f in lexdb_dialect.TYPE_FACTS { if f.rules == ty.rules && f.oid == oid { return f } }
    let cat: byte = if lexdb_sql.elemOid(oid) > 0 { 'A' } else { 'U' }
    return lexdb_dialect.TypeFact{rules: ty.rules, oid: oid, cat: cat, pref: false}
}

// Whether a value of type from becomes a to without being asked (an
// implicit cast; a type is its own).
pub fn implicitCast(ty: &Typing, from: int, to: int): bool {
    if from == to { return true }
    for c in lexdb_dialect.IMPLICIT_CASTS { if c.rules == ty.rules && c.from == from && c.to == to { return true } }
    return false
}

// The type values of these types are made together (a UNION's column,
// CASE's and COALESCE's values, a VALUES column): the first known type,
// giving way to a later one of its category when it is not preferred and
// casts to the later one implicitly but not back. Unknowns take the
// others' type, a text when all are. 0 when two are of different
// categories (PostgreSQL's 42804): the caller keeps its own rule.
pub fn commonOid(ty: &Typing, oids: &[]int): int {
    var p = 0
    for o in oids {
        if isUnknownOid(o) || o == p { continue }
        if p == 0 {
            p = o
            continue
        }
        let pf = factOf(ty, p)
        let nf = factOf(ty, o)
        if pf.cat != nf.cat { return 0 }
        if !pf.pref && implicitCast(ty, p, o) && !implicitCast(ty, o, p) { p = o }
    }
    return if p == 0 { lexdb_sql.OID_TEXT } else { p }
}

fn plainNum(o: int): bool {
    return o == lexdb_sql.OID_INT2 || o == lexdb_sql.OID_INT4 || o == lexdb_sql.OID_INT8 || o == lexdb_sql.OID_NUMERIC ||
           o == lexdb_sql.OID_FLOAT4 || o == lexdb_sql.OID_FLOAT8
}

fn plainTime(o: int): bool {
    return o == lexdb_sql.OID_DATE || o == lexdb_sql.OID_TIME || o == lexdb_sql.OID_TS || o == lexdb_sql.OID_TSTZ ||
           o == lexdb_sql.OID_IVAL
}

// Whether a value of type from must be converted to be one of the common
// type to: a number or a date or time along an implicit cast (1 as a
// numeric, a date as a timestamp), or an untyped literal read as a type
// other than a text's. Texts of other text types are the same values.
pub fn converts(ty: &Typing, from: int, to: int): bool {
    if from == to || isUnknownOid(to) || isTextOid(to) { return false }
    if isUnknownOid(from) { return true }
    if !implicitCast(ty, from, to) { return false }
    return (plainNum(from) && plainNum(to)) || (plainTime(from) && plainTime(to))
}

// An expression's type for a common type: 705 for an untyped literal
// ('x', NULL) or parameter, else exprOid's.
pub fn argOid(x: &Expr, cols: &[]lexdb_sql.ColDef, ptypes: &[]int, ty: &Typing): int {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Text(_) { return lexdb_sql.OID_UNKNOWN }
                Val.Null { return lexdb_sql.OID_UNKNOWN }
                else {}
            }
        }
        Expr.Param(n) { if n > len(ptypes) || ptypes[n - 1] == 0 { return lexdb_sql.OID_UNKNOWN } }
        else {}
    }
    return exprOid(x, cols, ptypes, ty)
}

// The places of a call's arguments that are its values, made of one type:
// CASE's THENs and ELSE ("case else": the last), COALESCE's, GREATEST's and
// LEAST's arguments; [] another call.
pub fn valueArgs(name: &str, n: int): []int {
    var out: []int = []
    if name == "case" || name == "case else" {
        let pairs = if name == "case else" { (n - 1) / 2 } else { n / 2 }
        for k in 0..pairs { append(mut &out, 2 * k + 1) }
        if name == "case else" && n > 0 { append(mut &out, n - 1) }
    } else if name == "coalesce" || name == "greatest" || name == "least" {
        for i in 0..n { append(mut &out, i) }
    }
    return out
}

// The common type of a call's values (valueArgs); 0 as commonOid.
pub fn valuesOid(name: &str, args: &[]Expr, cols: &[]lexdb_sql.ColDef, ptypes: &[]int, ty: &Typing): int {
    var os: []int = []
    for i in valueArgs(name, len(args)) { append(mut &os, argOid(&args[i], cols, ptypes, ty)) }
    return commonOid(ty, &os)
}

// A text type: its collation counts as a text's (L2); char(n) too.
pub fn isTextOid(o: int): bool {
    // (char(n) too: its collation counts as a text's, L2)
    return o == lexdb_sql.OID_TEXT || o == lexdb_sql.OID_VARCHAR || o == lexdb_sql.OID_NAME || o == lexdb_sql.OID_CHAR || o == 705 ||
           o == lexdb_sql.OID_BPCHAR
}

// Column name's place in cols: its slot as resolve gave it (Expr.Col's
// second field) when that is the column of that name, else found by the
// name (a column the planner made, slot -1, or an expression over other
// columns than those it was resolved over).
pub fn colSlot(cols: &[]lexdb_sql.ColDef, name: &str, slot: int): int {
    if slot >= 0 && slot < len(cols) && cols[slot].name == name { return slot }
    for i in 0..len(cols) { if cols[i].name == name { return i } }
    return -1
}

fn nullLit(v: &Val): bool {
    match v {
        Val.Null { return true }
        else { return false }
    }
}

// The result type of a date or time operator (0: not one).
pub fn timeOpOid(op: &str, l: int, r: int): int {
    let tl = lexdb_sql.timeKind(l)
    let tr = lexdb_sql.timeKind(r)
    if tl == 0 && tr == 0 { return 0 }
    let D = lexdb_sql.OID_DATE
    let T = lexdb_sql.OID_TIME
    let TS = lexdb_sql.OID_TS
    let TZ = lexdb_sql.OID_TSTZ
    let IV = lexdb_sql.OID_IVAL
    if op == "*" || op == "/" { return IV }
    if l == D && r == D { return if op == "-" { lexdb_sql.OID_INT4 } else { 0 } }
    if l == D && r == IV || l == IV && r == D { return TS }
    if l == D && r == T || l == T && r == D { return TS }
    if l == D { return D }                              // a date and days
    if r == D && op == "+" { return D }
    if (l == TS && r == TS) || (l == TZ && r == TZ) || (l == T && r == T) { return if op == "-" { IV } else { 0 } }
    if l == TS || r == TS { return TS }
    if l == TZ || r == TZ { return TZ }
    if l == T || r == T { return T }
    return IV
}

// The type OID of an expression, as far as it can be told before running.
pub fn isFloatOid(o: int): bool { return o == lexdb_sql.OID_FLOAT4 || o == lexdb_sql.OID_FLOAT8 }

// x ^ y's and power's type: numeric when either is and neither is a float.
pub fn numOrFloat(a: int, b: int): int {
    if isFloatOid(a) || isFloatOid(b) { return lexdb_sql.OID_FLOAT8 }
    return if a == lexdb_sql.OID_NUMERIC || b == lexdb_sql.OID_NUMERIC { lexdb_sql.OID_NUMERIC } else { lexdb_sql.OID_FLOAT8 }
}

pub fn exprOid(x: &Expr, cols: &[]lexdb_sql.ColDef, ptypes: &[]int, ty: &Typing): int {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Int(n) { return if n >= -2147483648 && n <= 2147483647 { lexdb_sql.OID_INT4 } else { lexdb_sql.OID_INT8 } }
                Val.Bool(_) { return lexdb_sql.OID_BOOL }
                Val.Num(_) { return lexdb_sql.OID_NUMERIC }
                Val.Date(_) { return lexdb_sql.OID_DATE }
                Val.Time(_) { return lexdb_sql.OID_TIME }
                Val.Ts(_) { return lexdb_sql.OID_TS }
                Val.Tstz(_) { return lexdb_sql.OID_TSTZ }
                Val.Ival(_) { return lexdb_sql.OID_IVAL }
                Val.Uuid(_) { return lexdb_sql.OID_UUID }
                Val.Bytes(_) { return lexdb_sql.OID_BYTEA }
        Val.Float(_) { return lexdb_sql.OID_FLOAT8 }
        Val.Real(_) { return lexdb_sql.OID_FLOAT4 }
        Val.Reg(_, _) { return lexdb_sql.OID_REGCLASS }
                else { return lexdb_sql.OID_TEXT }
            }
        }
        Expr.Param(n) {
            if n <= len(ptypes) && ptypes[n - 1] != 0 { return ptypes[n - 1] }
            return lexdb_sql.OID_TEXT
        }
        Expr.Col(n, s) {
            let i = colSlot(cols, &n, s)
            return if i >= 0 { cols[i].typ.oid } else { lexdb_sql.OID_TEXT }
        }
        Expr.Unary(op, a) { return if op == "not" { lexdb_sql.OID_BOOL } else { exprOid(&a, cols, ptypes, ty) } }
        Expr.Bin(op, a, b) {
            if op == "||" {
                let l = exprOid(&a, cols, ptypes, ty)
                let r = exprOid(&b, cols, ptypes, ty)
                let f = arrayConcat(&a, &b, cols, ptypes, ty)
                if len(f) > 0 { return concatOid(&f, l, r) }
                return if l == lexdb_sql.OID_BYTEA || r == lexdb_sql.OID_BYTEA { lexdb_sql.OID_BYTEA } else { lexdb_sql.OID_TEXT }
            }
            if op == "^" { return numOrFloat(exprOid(&a, cols, ptypes, ty), exprOid(&b, cols, ptypes, ty)) }
            if op == "t+" {
                // T-SQL's +: text when both are, else the other's type
                let l = exprOid(&a, cols, ptypes, ty)
                let r = exprOid(&b, cols, ptypes, ty)
                let lt = isTextOid(l) || l == 0
                let rt = isTextOid(r) || r == 0
                if lt && rt { return lexdb_sql.OID_TEXT }
                if lt { return r }
                if rt { return l }
                return exprOid(&Expr.Bin("+", lexdb_sql.cloneExpr(&a), lexdb_sql.cloneExpr(&b)), cols, ptypes, ty)
            }
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "#" || op == "<<" || op == ">>" {
                let l = exprOid(&a, cols, ptypes, ty)
                let r = exprOid(&b, cols, ptypes, ty)
                let to = timeOpOid(&op, l, r)
                if to > 0 { return to }
                if l == lexdb_sql.OID_FLOAT4 && r == lexdb_sql.OID_FLOAT4 { return lexdb_sql.OID_FLOAT4 }
                if isFloatOid(l) || isFloatOid(r) { return lexdb_sql.OID_FLOAT8 }
                if l == lexdb_sql.OID_NUMERIC || r == lexdb_sql.OID_NUMERIC { return lexdb_sql.OID_NUMERIC }
                if l == lexdb_sql.OID_INT8 || r == lexdb_sql.OID_INT8 { return lexdb_sql.OID_INT8 }
                return lexdb_sql.OID_INT4
            }
            return lexdb_sql.OID_BOOL
        }
        Expr.IsNull(_, _) { return lexdb_sql.OID_BOOL }
        Expr.Cast(_, t) { return t.oid }
        Expr.Call(n, args, _) {
            if n == "#bptrim" { return lexdb_sql.OID_TEXT }
            if n == "#bppad" { return lexdb_sql.OID_BPCHAR }
            if n == "grouping" { return lexdb_sql.OID_INT4 }
            if n == "#mrnav" && len(args) == 2 { return exprOid(&args[1], cols, ptypes, ty) }
            if n == "#win" && len(args) == 2 {
                // a window call: its function's type (9.46)
                match args[1] {
                    Expr.Call(f, fa, _) {
                        let b = lexdb_sql.aggBase(&f)
                        if b == "row_number" || b == "rank" || b == "dense_rank" || b == "ntile" { return lexdb_sql.OID_INT8 }
                        if b == "percent_rank" || b == "cume_dist" { return lexdb_sql.OID_FLOAT8 }
                        if b == "lag" || b == "lead" || b == "first_value" || b == "last_value" || b == "nth_value" {
                            return if len(fa) > 0 { exprOid(&fa[0], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT }
                        }
                    }
                    else {}
                }
                return exprOid(&args[1], cols, ptypes, ty)
            }
            if lexdb_sql.isSubCall(&n) {
                if n != "#sub" { return lexdb_sql.OID_BOOL }
                let oid = if len(args) >= 2 { lexdb_sql.litInt(&args[1]) } else { -1 }
                return if oid > 0 { oid } else { lexdb_sql.OID_TEXT }
            }
            match lexdb_sql.aggBase(&n) {
                "count" { return lexdb_sql.OID_INT8 }
                "bool_and", "bool_or", "every" { return lexdb_sql.OID_BOOL }
                "string_agg" { return lexdb_sql.OID_TEXT }
                "array_agg" {
                    let el = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT }
                    let ao = lexdb_sql.arrayOid(if el == lexdb_sql.OID_UNKNOWN { lexdb_sql.OID_TEXT } else { el })
                    return if ao > 0 { ao } else { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                }
                "like", "ilike", "similar", "in", "distinct", "any", "all" { return lexdb_sql.OID_BOOL }
                "case", "greatest", "least" {
                    // the common type of its values; of different categories, its first value's
                    let c = valuesOid(&n, &args, cols, ptypes, ty)
                    if c != 0 { return c }
                    let first = if lexdb_sql.aggBase(&n) == "case" { 1 } else { 0 }
                    return if len(args) > first { exprOid(&args[first], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT }
                }
                "nullif" { return if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT } }
                "strpos" { return lexdb_sql.OID_INT4 }
                "regexp_split_to_table", "string_to_table" { return lexdb_sql.OID_TEXT }
                "array" {
                    var el = lexdb_sql.OID_TEXT
                    for a in args { el = widerOid(el, exprOid(&a, cols, ptypes, ty)) }
                    let ao = lexdb_sql.arrayOid(el)
                    return if ao > 0 { ao } else { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                }
                "stddev", "stddev_samp", "stddev_pop", "variance", "var_samp", "var_pop", "avg" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_INT8 }
                    return if isFloatOid(a) { lexdb_sql.OID_FLOAT8 } else { lexdb_sql.OID_NUMERIC }
                }
                "sum" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_INT8 }
                    return if a == lexdb_sql.OID_NUMERIC || isFloatOid(a) { a } else { lexdb_sql.OID_INT8 }
                }
                "floor", "ceil", "ceiling", "trunc" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_FLOAT8 }
                    return if a == lexdb_sql.OID_NUMERIC { a } else { lexdb_sql.OID_FLOAT8 }
                }
                "sign" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_FLOAT8 }
                    return if isFloatOid(a) { lexdb_sql.OID_FLOAT8 } else { lexdb_sql.OID_NUMERIC }
                }
                "cbrt", "random", "pi", "sin", "cos", "tan", "cot", "asin", "acos", "atan", "atan2", "sinh", "cosh", "tanh", "asinh",
                "acosh", "atanh", "sind", "cosd", "tand", "cotd", "asind", "acosd", "atand", "atan2d", "degrees", "radians" {
                    return lexdb_sql.OID_FLOAT8
                }
                "sqrt", "exp", "ln", "log10", "log" {
                    // numeric's own, else double precision (9.92); log(b, x) numeric only
                    if n == "log" && len(args) == 2 { return lexdb_sql.OID_NUMERIC }
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_FLOAT8 }
                    return if a == lexdb_sql.OID_NUMERIC { a } else { lexdb_sql.OID_FLOAT8 }
                }
                "power", "pow" {
                    if len(args) < 2 { return lexdb_sql.OID_FLOAT8 }
                    return numOrFloat(exprOid(&args[0], cols, ptypes, ty), exprOid(&args[1], cols, ptypes, ty))
                }
                "mod", "gcd", "lcm" {
                    if len(args) < 2 { return lexdb_sql.OID_NUMERIC }
                    let a = exprOid(&args[0], cols, ptypes, ty)
                    let b = exprOid(&args[1], cols, ptypes, ty)
                    if a == lexdb_sql.OID_NUMERIC || b == lexdb_sql.OID_NUMERIC || isFloatOid(a) || isFloatOid(b) { return lexdb_sql.OID_NUMERIC }
                    if a == lexdb_sql.OID_INT8 || b == lexdb_sql.OID_INT8 { return lexdb_sql.OID_INT8 }
                    if a == lexdb_sql.OID_INT2 && b == lexdb_sql.OID_INT2 { return lexdb_sql.OID_INT2 }
                    return lexdb_sql.OID_INT4
                }
                "div", "to_number" { return lexdb_sql.OID_NUMERIC }
                "to_char" { return lexdb_sql.OID_TEXT }
                "to_date" { return lexdb_sql.OID_DATE }
                "width_bucket", "position", "ascii", "regexp_count", "regexp_instr", "array_position", "array_ndims" { return lexdb_sql.OID_INT4 }
                "starts_with", "regexp_like", "@>", "<@", "&&" { return lexdb_sql.OID_BOOL }
                "regexp_match", "regexp_matches", "regexp_split_to_array", "string_to_array" { return lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                "array_positions" { return lexdb_sql.arrayOid(lexdb_sql.OID_INT4) }
                "#acat", "#aappend", "#aprepend" {
                    if len(args) < 2 { return lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                    return concatOid(&n, exprOid(&args[0], cols, ptypes, ty), exprOid(&args[1], cols, ptypes, ty))
                }
                "array_append", "array_cat", "array_remove", "array_replace" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT }
                    if n == "array_cat" && lexdb_sql.elemOid(a) == 0 && len(args) > 1 { return exprOid(&args[1], cols, ptypes, ty) }
                    if n == "array_append" && lexdb_sql.elemOid(a) == 0 && len(args) > 1 {
                        let el = exprOid(&args[1], cols, ptypes, ty)
                        let ao = lexdb_sql.arrayOid(el)
                        return if ao > 0 { ao } else { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                    }
                    return if lexdb_sql.elemOid(a) > 0 { a } else { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                }
                "array_prepend" {
                    let a = if len(args) > 1 { exprOid(&args[1], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT }
                    if lexdb_sql.elemOid(a) > 0 { return a }
                    let el = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT }
                    let ao = lexdb_sql.arrayOid(el)
                    return if ao > 0 { ao } else { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
                }
                "pg_backend_pid" { return lexdb_sql.OID_INT4 }
                "pg_my_temp_schema" { return lexdb_sql.OID_OID }
                "pg_is_other_temp_schema" { return lexdb_sql.OID_BOOL }
                "txid_current", "pg_current_xact_id" { return lexdb_sql.OID_INT8 }
                "format_type", "pg_get_expr", "pg_get_constraintdef", "pg_get_indexdef", "pg_get_serial_sequence", "quote_ident",
                "array_to_string", "obj_description", "col_description", "shobj_description", "pg_get_viewdef", "json_build_object",
                "jsonb_build_object", "pg_get_userbyid", "repeat", "pg_get_triggerdef", "pg_get_ruledef", "pg_get_statisticsobjdef_columns",
                "pg_get_function_result", "pg_get_function_arguments", "pg_size_pretty" {
                    return lexdb_sql.OID_TEXT
                }
                "current_user", "session_user", "current_schema", "pg_encoding_to_char" { return lexdb_sql.OID_NAME }
                "has_sequence_privilege", "has_any_column_privilege", "pg_try_advisory_lock", "pg_try_advisory_lock_shared",
                "pg_try_advisory_xact_lock", "pg_try_advisory_xact_lock_shared", "pg_advisory_unlock", "pg_advisory_unlock_shared" { return lexdb_sql.OID_BOOL }
                "pg_table_is_visible", "pg_type_is_visible", "pg_function_is_visible", "pg_collation_is_visible", "~", "!~", "~*",
                "!~*", "has_table_privilege", "has_schema_privilege", "has_database_privilege", "pg_relation_is_publishable" {
                    return lexdb_sql.OID_BOOL
                }
                "array_length", "array_upper", "array_lower", "cardinality", "generate_subscripts" { return lexdb_sql.OID_INT4 }
                "pg_relation_size", "pg_total_relation_size", "pg_table_size", "pg_indexes_size", "pg_database_size" { return lexdb_sql.OID_INT8 }
                "to_regclass", "pg_partition_ancestors" { return lexdb_sql.OID_REGCLASS }
                "to_regtype" { return lexdb_sql.OID_REGTYPE }
                "to_regnamespace" { return lexdb_sql.OID_REGNAMESPACE }
                "unnest", "#elem" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT }
                    let el = lexdb_sql.elemOid(a)
                    return if el > 0 { el } else { lexdb_sql.OID_TEXT }
                }
                "coalesce" {
                    // the common type of its arguments; of different
                    // categories, the first argument's whose type is known
                    let c = valuesOid(&n, &args, cols, ptypes, ty)
                    if c != 0 { return c }
                    for a in args {
                        match a { Expr.Lit(v) { if nullLit(&v) { continue } } else {} }
                        let o = exprOid(&a, cols, ptypes, ty)
                        if o != 0 && o != 705 { return o }
                    }
                    return lexdb_sql.OID_TEXT
                }
                "min", "max", "abs" {
                    return if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT }
                }
                "length", "char_length", "octet_length" { return lexdb_sql.OID_INT4 }
                "gen_random_uuid" { return lexdb_sql.OID_UUID }
                "encode" { return lexdb_sql.OID_TEXT }
                "decode" { return lexdb_sql.OID_BYTEA }
                "now", "current_timestamp", "transaction_timestamp", "statement_timestamp", "clock_timestamp", "to_timestamp" {
                    return lexdb_sql.OID_TSTZ
                }
                "localtimestamp", "make_timestamp" { return lexdb_sql.OID_TS }
                "make_timestamptz" { return lexdb_sql.OID_TSTZ }
                "timezone" {
                    // AT TIME ZONE (9.95): a timestamp made a timestamptz, the rest a timestamp
                    let a = if len(args) > 0 { exprOid(&args[len(args) - 1], cols, ptypes, ty) } else { lexdb_sql.OID_TSTZ }
                    return if a == lexdb_sql.OID_TS { lexdb_sql.OID_TSTZ } else { lexdb_sql.OID_TS }
                }
                "current_date", "make_date" { return lexdb_sql.OID_DATE }
                "current_time", "localtime" { return lexdb_sql.OID_TIME }
                "date_part" { return lexdb_sql.OID_NUMERIC }
                "age" { return lexdb_sql.OID_IVAL }
                "isfinite" { return lexdb_sql.OID_BOOL }
                "date_trunc" {
                    let a = if len(args) > 1 { exprOid(&args[1], cols, ptypes, ty) } else { lexdb_sql.OID_TSTZ }
                    return if a == lexdb_sql.OID_TS || a == lexdb_sql.OID_IVAL { a } else { lexdb_sql.OID_TSTZ }
                }
                "nextval", "currval", "setval", "lastval" { return lexdb_sql.OID_INT8 }
                "scope_identity" { return lexdb_sql.OID_NUMERIC }
                // T-SQL's (lexdb_tsqlfn)
                "#len", "#datalength", "charindex", "patindex", "#datediff", "#datepart" { return lexdb_sql.OID_INT4 }
                // SQL Server's catalog functions (callCat)
                "#object_id", "#schema_id", "#db_id", "#type_id", "#has_dbaccess", "#is_srvrolemember", "#is_member",
                "#has_perms_by_name", "#objectproperty", "#columnproperty", "#indexproperty" { return lexdb_sql.OID_INT4 }
                "#object_name", "#object_schema_name", "#schema_name", "#type_name", "#suser_sname", "#db_name" { return lexdb_sql.OID_TEXT }
                "#suser_sid", "#sid_binary" { return lexdb_sql.OID_BYTEA }
                "#replaceci", "#stuff", "#datename", "#datestyle", "#reverse", "#concat_ws" { return lexdb_sql.OID_TEXT }
                "#tlike" { return lexdb_sql.OID_BOOL }
                "#utcnow" { return lexdb_sql.OID_TS }
                "#eomonth" { return lexdb_sql.OID_DATE }
                "#tdiv" { return lexdb_sql.OID_NUMERIC }
                "#tavg" {
                    let m = if len(args) > 1 { lexdb_sql.litInt(&args[1]) } else { 0 }
                    return if m == -1 { lexdb_sql.OID_INT8 } else { lexdb_sql.OID_NUMERIC }
                }
                // x COLLATE c: x's type (a char(n) keeps its padding rules, L2)
                "#collate", "#coll" { return if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_TEXT } }
                "#old", "#round", "#power", "#try", "#tint", "#bitnot" { return if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_NUMERIC } }
                "#bitint" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_INT4 }
                    return if a == lexdb_sql.OID_BOOL { lexdb_sql.OID_INT4 } else { a }
                }
                "#dateadd" {
                    let o = if len(args) > 2 { exprOid(&args[2], cols, ptypes, ty) } else { 0 }
                    return if o == lexdb_sql.OID_DATE || o == lexdb_sql.OID_TS || o == lexdb_sql.OID_TSTZ { o } else { lexdb_sql.OID_TS }
                }
                "round" {
                    let a = if len(args) > 0 { exprOid(&args[0], cols, ptypes, ty) } else { lexdb_sql.OID_NUMERIC }
                    return if isFloatOid(a) && len(args) == 1 { lexdb_sql.OID_FLOAT8 } else { lexdb_sql.OID_NUMERIC }
                }
                else {
                    // a dialect's own (Oracle's: lexdb_orafn), else a text
                    var os: []int = []
                    for a in args { append(mut &os, exprOid(&a, cols, ptypes, ty)) }
                    return ty.fnOid(&n, &os)
                }
            }
        }
    }
}

pub fn isUnknownLit(x: &Expr): bool {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Text(_) { return true }
                Val.Null { return true }
                else { return false }
            }
        }
        else { return false }
    }
}

// a || b with an array on either side (9.92): the function it is (#acat,
// #aappend or #aprepend), "" for text's ||. A literal text or NULL beside an
// array is read as an array, as PostgreSQL reads an unknown literal.
pub fn arrayConcat(a: &Expr, b: &Expr, cols: &[]lexdb_sql.ColDef, pt: &[]int, ty: &Typing): str {
    let la = lexdb_sql.elemOid(exprOid(a, cols, pt, ty)) > 0
    let ra = lexdb_sql.elemOid(exprOid(b, cols, pt, ty)) > 0
    if !la && !ra { return "" }
    if la && ra { return "#acat" }
    if la { return if isUnknownLit(b) { "#acat" } else { "#aappend" } }
    return if isUnknownLit(a) { "#acat" } else { "#aprepend" }
}

// The array type of a || (#acat, #aappend, #aprepend), from its sides' types.
pub fn concatOid(f: &str, l: int, r: int): int {
    let le = lexdb_sql.elemOid(l)
    let re = lexdb_sql.elemOid(r)
    var el = 0
    if f == "#acat" { el = if le > 0 && re > 0 { widerOid(le, re) } else if le > 0 { le } else { re } }
    else if f == "#aappend" { el = if le > 0 { widerOid(le, r) } else { r } }
    else { el = if re > 0 { widerOid(l, re) } else { l } }
    let ao = lexdb_sql.arrayOid(el)
    return if ao > 0 { ao } else { lexdb_sql.arrayOid(lexdb_sql.OID_TEXT) }
}

// Of two element types, the one both become (numbers widen; else the first,
// an unknown text giving way to the other).
pub fn widerOid(a: int, b: int): int {
    if a == b { return a }
    if a == lexdb_sql.OID_TEXT || a == lexdb_sql.OID_UNKNOWN { return b }
    if b == lexdb_sql.OID_TEXT || b == lexdb_sql.OID_UNKNOWN { return a }
    let nums = [lexdb_sql.OID_INT2, lexdb_sql.OID_INT4, lexdb_sql.OID_INT8, lexdb_sql.OID_NUMERIC, lexdb_sql.OID_FLOAT4, lexdb_sql.OID_FLOAT8]
    var ia = -1
    var ib = -1
    for i in 0..len(nums) {
        if nums[i] == a { ia = i }
        if nums[i] == b { ib = i }
    }
    if ia >= 0 && ib >= 0 { return if ia > ib { a } else { b } }
    return a
}

// IN and = ANY over a subquery compare as = does (design/lexdb-layers.md
// 4.4): where one side is untyped (an untyped literal or parameter) or a
// text and the other a typed value, the text side is read as the other's
// type. inReadOid(text side, typed side): the type the first side's values
// are read as (a number as a numeric, a float as a float8, as = compares
// numbers; a boolean, date or time as its type); 0 when they are compared
// as they are.
pub fn inReadOid(side: int, other: int): int {
    if !(isUnknownOid(side) || isTextOid(side)) || isUnknownOid(other) || isTextOid(other) { return 0 }
    if other == lexdb_sql.OID_FLOAT4 || other == lexdb_sql.OID_FLOAT8 { return lexdb_sql.OID_FLOAT8 }
    if plainNum(other) { return lexdb_sql.OID_NUMERIC }
    if other == lexdb_sql.OID_BOOL || plainTime(other) { return other }
    return 0
}

// ---- The typed expression IR (design/lexdb-layers.md 4.4.1, slice 2b)
//
// An expression bound once for a statement's run: its columns by their
// places in the row (not found by their names per row, as eval finds
// them), its parameters as their values, each operator decoded to its
// code (lexdb_ops.OPS) and each function bound once (FnRef: its entry in the
// function library, lexdb_lib, not a check of its name on every call). lexdb_exec evaluates it
// (bxEval, and per batch bGenVals) with eval's own operations, so it gives
// exactly what eval gives. What only eval evaluates (a subquery, an
// aggregate, a window call, a sequence, session, lock or catalog function,
// a reg cast, T-SQL's typed division and AVG) does not bind
// (Typing.fnBind's way FN_NONE): eval runs it.

pub type BX = closed {
    Const(Val)
    Param(int)                  // the run's parameter at this place ($1 is 0): bound once per plan
    Col(int)                    // the row's value at this place
    Agg(int)                    // an aggregate's or window's value (#agg's slot)
    Un(int, BX)                 // lexdb_ops.UN_*
    And(BX, BX)
    Or(BX, BX)
    Op(int, BX, BX)             // a binary operator (lexdb_ops.OP_*)
    Cat(BX, BX, str)            // ||, with its function for arrays (arrayConcat; "" none)
    IsNull(BX, bool)
    Cast(BX, lexdb_sql.TypeName)
    Case([]BX, bool)            // CASE's conditions and values in turn; true: an ELSE last
    Try(BX)                     // T-SQL's TRY_CAST: NULL for an error
    Call(FnRef, []BX)           // a bound function and its arguments
}

// How a bound function is evaluated (FnRef.way): FN_NONE, it does not
// bind (eval evaluates it); the others are the executor's ways.
pub const FN_NONE = -1
pub const FN_GEN = 0            // its entry f (after its dialect's, dialect)
pub const FN_ONE = 1            // one argument: its entry f1 (lexdb_lib.entry1Of), NULL for NULL

// A function call bound once: the way the executor gives it, found from
// its name and number of arguments when bound (Typing.fnBind).
pub type FnRef = record {
    pub name: str
    pub way: int
    pub f: lexdb_lib.LibFn      // the function's entry for its arguments (lexdb_lib.entryOf; restFn for FN_NONE)
    pub f1: lexdb_lib.Lib1      // FN_ONE: the function's entry for one argument (lexdb_lib.no1 else)
    pub dialect: bool           // a T-SQL or Oracle function's name: its dialect's call first, as eval
}

// x bound; None: eval evaluates it. cols: the row's columns (a column is
// Col(i), its place in the row: the slot resolve gave it); params: the
// statement's, bound as constants ([]: each $n a slot, BX.Param, for a plan
// bound once and run with other values). aggs: #agg's slots are given.
// (lexdb_exec's bGenOf re-slots a bound tree for a batch's row: reslot.)
pub fn bindExpr(x: &Expr, cols: &[]lexdb_sql.ColDef, params: &[]Val, aggs: bool, ty: &Typing): Option[BX] {
    match x {
        Expr.Lit(v) { return Some(BX.Const(v)) }
        Expr.Param(n) {
            // a value given: a constant; else a slot, read per run
            if n < 1 { return None }
            if n <= len(params) { return Some(BX.Const(params[n - 1])) }
            return Some(BX.Param(n - 1))
        }
        Expr.Col(name, slot) {
            let i = colSlot(cols, &name, slot)
            if i < 0 { return None }
            return Some(BX.Col(i))
        }
        Expr.Unary(op, a) {
            let ba = bindExpr(&a, cols, params, aggs, ty)
            if ba.isNone() { return None }
            let u = lexdb_ops.unCode(&op)
            return Some(BX.Un(u, ba.unwrap()))
        }
        Expr.Bin(op, a, b) {
            let ba = bindExpr(&a, cols, params, aggs, ty)
            if ba.isNone() { return None }
            let bb = bindExpr(&b, cols, params, aggs, ty)
            if bb.isNone() { return None }
            if op == "and" { return Some(BX.And(ba.unwrap(), bb.unwrap())) }
            if op == "or" { return Some(BX.Or(ba.unwrap(), bb.unwrap())) }
            if op == "||" {
                let noCols: []lexdb_sql.ColDef = []
                let noTypes: []int = []
                return Some(BX.Cat(ba.unwrap(), bb.unwrap(), arrayConcat(&a, &b, &noCols, &noTypes, ty)))
            }
            let code = lexdb_ops.opCode(&op)
            if code < 0 { return None }
            return Some(BX.Op(code, ba.unwrap(), bb.unwrap()))
        }
        Expr.IsNull(a, neg) {
            let ba = bindExpr(&a, cols, params, aggs, ty)
            if ba.isNone() { return None }
            return Some(BX.IsNull(ba.unwrap(), neg))
        }
        Expr.Cast(a, t) {
            if t.kind == lexdb_sql.K_REG { return None }
            let ba = bindExpr(&a, cols, params, aggs, ty)
            if ba.isNone() { return None }
            return Some(BX.Cast(ba.unwrap(), t))
        }
        Expr.Call(name, args, star) {
            if lexdb_sql.isSubCall(&name) { return None }
            if name == "#agg" {
                if !aggs || len(args) != 1 { return None }
                let i = lexdb_sql.litInt(&args[0])
                if i < 0 { return None }
                return Some(BX.Agg(i))
            }
            let special = name == "case" || name == "case else" || name == "#try"
            let fr = if special { FnRef{name: "", way: FN_NONE, f: lexdb_lib.restFn, f1: lexdb_lib.no1, dialect: false} } else { ty.fnBind(&name, len(args)) }
            if !special && fr.way == FN_NONE { return None }
            var bs: []BX = []
            for a in args {
                let c = bindExpr(&a, cols, params, aggs, ty)
                if c.isNone() { return None }
                append(mut &bs, c.unwrap())
            }
            if name == "case" || name == "case else" { return Some(BX.Case(bs, name == "case else")) }
            if name == "#try" {
                if len(bs) == 1 { return Some(BX.Try(pop(mut &bs))) }
                let tr = ty.fnBind(&name, len(bs))
                if tr.way == FN_NONE { return None }
                return Some(BX.Call(tr, bs))
            }
            return Some(BX.Call(fr, bs))
        }
    }
}

// Whether x reads a parameter slot (BX.Param): a run of its plan must
// give it the run's parameters.
pub fn hasParam(x: &BX): bool {
    match x {
        BX.Param(_) { return true }
        BX.Const(_) { return false }
        BX.Col(_) { return false }
        BX.Agg(_) { return false }
        BX.Un(_, a) { return hasParam(&a) }
        BX.And(a, b) { return hasParam(&a) || hasParam(&b) }
        BX.Or(a, b) { return hasParam(&a) || hasParam(&b) }
        BX.Op(_, a, b) { return hasParam(&a) || hasParam(&b) }
        BX.Cat(a, b, _) { return hasParam(&a) || hasParam(&b) }
        BX.IsNull(a, _) { return hasParam(&a) }
        BX.Cast(a, _) { return hasParam(&a) }
        BX.Case(cs, _) {
            for c in cs { if hasParam(&c) { return true } }
            return false
        }
        BX.Try(a) { return hasParam(&a) }
        BX.Call(_, cs) {
            for c in cs { if hasParam(&c) { return true } }
            return false
        }
    }
}

// x, bound over a row of cols by place, re-slotted for a row of the
// columns slots lists: Col(i) becomes Col(s), slots[s] == i (i added to slots when first read). par:
// set when x reads a parameter slot (BX.Param). A plan's bound tree run
// over a batch's row (lexdb_exec's bGenOf), not bound again per run.
pub fn reslot(x: &BX, slots: mut &[]int, par: mut &bool): BX {
    match x {
        BX.Const(v) { return BX.Const(v) }
        BX.Param(i) {
            par = true
            return BX.Param(i)
        }
        BX.Col(i) {
            for s in 0..len(slots) { if slots[s] == i { return BX.Col(s) } }
            append(slots, i)
            return BX.Col(len(slots) - 1)
        }
        BX.Agg(i) { return BX.Agg(i) }
        BX.Un(u, a) { return BX.Un(u, reslot(&a, slots, par)) }
        BX.And(a, b) {
            let ra = reslot(&a, slots, par)
            return BX.And(ra, reslot(&b, slots, par))
        }
        BX.Or(a, b) {
            let ra = reslot(&a, slots, par)
            return BX.Or(ra, reslot(&b, slots, par))
        }
        BX.Op(op, a, b) {
            let ra = reslot(&a, slots, par)
            return BX.Op(op, ra, reslot(&b, slots, par))
        }
        BX.Cat(a, b, f) {
            let ra = reslot(&a, slots, par)
            return BX.Cat(ra, reslot(&b, slots, par), f)
        }
        BX.IsNull(a, neg) { return BX.IsNull(reslot(&a, slots, par), neg) }
        BX.Cast(a, t) { return BX.Cast(reslot(&a, slots, par), t) }
        BX.Case(cs, hasElse) {
            var bs: []BX = withCapacity(len(cs))
            for c in cs { append(mut &bs, reslot(&c, slots, par)) }
            return BX.Case(bs, hasElse)
        }
        BX.Try(a) { return BX.Try(reslot(&a, slots, par)) }
        BX.Call(fr, cs) {
            var bs: []BX = withCapacity(len(cs))
            for c in cs { append(mut &bs, reslot(&c, slots, par)) }
            return BX.Call(FnRef{name: fr.name, way: fr.way, f: fr.f, f1: fr.f1, dialect: fr.dialect}, bs)
        }
    }
}

// ---- names (design/lexdb-layers.md 4.4.1, step 2d): what a name in a
// query means, as resolve finds it

type DbErr = lexdb_base.DbErr

fn e(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

fn clone(x: &Expr): Expr { return lexdb_sql.cloneExpr(x) }

// The first column named name, -1 none (lexdb_exec's colIndex).
fn colIndex(cols: &[]lexdb_sql.ColDef, name: &str): int {
    for i in 0..len(cols) { if cols[i].name == name { return i } }
    return -1
}

pub fn dotAt(s: &str): int {
    for i in 0..len(s) { if s[i] == '.' { return i } }
    return -1
}

// The column part of alias.column (a repeated name's mark taken off).
pub fn colPart(q: &str): str {
    let i = dotAt(q)
    let c = if i < 0 { q } else { q[i + 1..len(q)] }
    let d = strings.indexOf(&c, DUPSEP, 0)
    return if d < 0 { c } else { c[0..d] }
}

// Marks a column name repeated in one FROM item: name DUPSEP position.
pub const DUPSEP: str = "\x1e"

// The column a name refers to among the first n columns: alias.column, or a
// column name only one table has. Its place (its slot); cols[i].name is its
// name as resolved (alias.column).
pub fn resolveName(cols: &[]lexdb_sql.ColDef, n: int, name: &str): Result[int, DbErr] {
    let d = dotAt(name)
    if d >= 0 {
        for i in 0..n {
            if cols[i].name == name {
                let again = name + DUPSEP
                for j in 0..n { if strings.startsWith(&cols[j].name, &again) { return Err(e("42702", &("column reference \"" + name + "\" is ambiguous"))) } }
                return Ok(i)
            }
        }
        let alias = name[0..d]
        var known = false
        for i in 0..n {
            let cd = dotAt(&cols[i].name)
            if cols[i].name[0..cd] == alias { known = true }
        }
        if !known { return Err(e("42P01", &("missing FROM-clause entry for table \"" + alias + "\""))) }
        return Err(e("42703", &("column " + name + " does not exist")))
    }
    var found = -1
    for i in 0..n {
        if colPart(&cols[i].name) == name && cols[i].using != lexdb_sql.USING_HIDDEN {
            if found >= 0 { return Err(e("42702", &("column reference \"" + name + "\" is ambiguous"))) }
            found = i
        }
    }
    if found < 0 { return Err(e("42703", &("column \"" + name + "\" does not exist"))) }
    return Ok(found)
}

// Column i (as resolveName gives it) as an expression: the column, or
// after a FULL JOIN ... USING the COALESCE of the pair's sides (9.93).
pub fn colExpr(cols: &[]lexdb_sql.ColDef, i: int): Expr {
    if len(cols[i].using) == 0 || cols[i].using == lexdb_sql.USING_HIDDEN { return Expr.Col(cols[i].name, i) }
    var args: []Expr = [Expr.Col(cols[i].name, i)]
    for o in strings.split(&cols[i].using, "\x1f") { append(mut &args, Expr.Col(o, colIndex(cols, &o))) }
    return Expr.Call("coalesce", args, false)
}

// JOIN ... USING's column name among cols[lo..hi] (one side of the join):
// the one a bare name there means, or 42703 / 42702 (9.93).
pub fn usingSide(cols: &[]lexdb_sql.ColDef, lo: int, hi: int, name: &str, side: &str): Result[int, DbErr] {
    var found = -1
    for i in lo..hi {
        if colPart(&cols[i].name) != name || lexdb_catalog.hiddenName(&cols[i].name) || cols[i].using == lexdb_sql.USING_HIDDEN { continue }
        if found >= 0 { return Err(e("42702", &("common column name \"" + name + "\" appears more than once in " + side + " table"))) }
        found = i
    }
    if found < 0 { return Err(e("42703", &("column \"" + name + "\" specified in USING clause does not exist in " + side + " table"))) }
    return Ok(found)
}

// The queries being planned, outermost first.
pub type Frame = record {
    pub cols: []lexdb_sql.ColDef
    pub exact: []bool               // per column: a table's, its values of exactly its type (outerRef types its parameter)
    pub refs: []Expr                // the outer values it uses, in the terms of the query around it
    pub refOids: []int
    pub subRefs: [][]Expr           // per subquery of it: the subquery's refs, in its terms
    pub subOids: []int
    pub subNames: []str
    pub subColls: []str             // per subquery of it: its column's collation (L2)
    pub subKinds: []int             // ... IN's: the kind its values are compared under, as resolve finds it
    pub subReads: []int             // ... IN's: the type its values are read as (lexdb_bind.inReadOid), 0 as they are
    pub hidden: bool                // its columns are not in scope (a FROM subquery that is not LATERAL)
}

// What names mean in the query being planned (the binder's part of a
// Scope, design/lexdb-layers.md 4.4.1, 2d): the query levels' frames, the
// statement's parameters and their types, the session's collation.
pub type Names = record {
    pub frames: []Frame
    pub base: int                   // the statement's parameters
    pub ptypes: []int
    pub coll: str                   // the session's default collation (L2): a literal's, a parameter's; "" exact
    pub ty: Typing                  // the dialects' typing
    pub blank: fn(&Expr): bool      // T-SQL's '' read as 0 (lexdb_syscat.tsqlBlank), under a session collation
    pub constCast: fn(Val, &lexdb_sql.TypeName): Result[Val, DbErr]  // a constant cast when resolved (castConst)
    pub colScale: fn(&lexdb_sql.TypeName): int  // a column's OutCol.scale (lexdb_exec.typScale: the dialects' wire types)
    pub outScale: fn(&Expr, &[]lexdb_sql.ColDef): int  // an expression's (lexdb_exec.exprScale)
}

pub fn isIntOid(o: int): bool { return o == lexdb_sql.OID_INT2 || o == lexdb_sql.OID_INT4 || o == lexdb_sql.OID_INT8 }

// The parameter types of the query being planned: the statement's, then
// its refs'.
pub fn ptypesOf(nm: &Names): []int {
    var out: []int = []
    for t in nm.ptypes { append(mut &out, t) }
    if len(nm.frames) > 0 { for t in nm.frames[len(nm.frames) - 1].refOids { append(mut &out, t) } }
    return out
}

// A name of a query around the one being planned, as a parameter of it.
pub fn outerRef(nm: mut &Names, name: &str): Result[Option[Expr], DbErr] {
    let top = len(nm.frames) - 1
    var f = top - 1
    var found = ""
    var slot = -1
    var oid = 0
    var coll = ""
    var bp: Option[lexdb_sql.TypeName] = None
    while f >= 0 && found == "" {
        if nm.frames[f].hidden {
            f -= 1
            continue
        }
        match resolveName(&nm.frames[f].cols, len(nm.frames[f].cols), name) {
            Ok(ci) {
                let fc = &nm.frames[f].cols[ci]
                oid = fc.typ.oid
                let exact = ci < len(nm.frames[f].exact) && nm.frames[f].exact[ci] && (len(fc.using) == 0 || fc.using == lexdb_sql.USING_HIDDEN)
                if exact && refTyped(oid) { bp = Some(lexdb_sql.TypeName{kind: fc.typ.kind, oid: fc.typ.oid, prec: fc.typ.prec, scale: fc.typ.scale, len: fc.typ.len}) }
                if fc.typ.kind == lexdb_sql.K_TEXT { coll = fc.coll }
                found = fc.name
                slot = ci
            }
            Err(x) {
                // ambiguous there, or its table is there and the column is not
                if x.state == "42702" || (x.state == "42703" && dotAt(name) >= 0) { return Err(x) }
            }
        }
        if found == "" { f -= 1 }
    }
    if found == "" { return Ok(None) }
    // (in the terms of frame f's query: its frame's columns are its own, in order)
    var x = Expr.Col(found, slot)
    for g in f + 1..top + 1 {
        let t = lexdb_sql.exprText(&x)
        var at = -1
        for i in 0..len(nm.frames[g].refs) { if lexdb_sql.exprText(&nm.frames[g].refs[i]) == t { at = i } }
        if at < 0 {
            at = len(nm.frames[g].refs)
            append(mut &nm.frames[g].refs, clone(&x))
            append(mut &nm.frames[g].refOids, oid)
        }
        x = Expr.Param(nm.base + at + 1)
    }
    // the column keeps its type: a parameter is untyped, which a
    // comparison reads as the other side's type (a char(n) column's 'k1'
    // with 'k1   ' as texts; a text 'x ' padded as the inner char(3)'s
    // 'x'; a date as the inner timestamp's text), where the join compares
    // the column as it is. As a cast to its type (refParam) it is compared
    // as in the query it comes from; the cast keeps the value as it is.
    match bp {
        Some(t) { x = Expr.Cast(x, t) }
        None {}
    }
    // a collated column keeps its collation (L2): #coll(x, name), implicit
    if len(coll) > 0 { x = Expr.Call("#coll", [x, Expr.Lit(Val.Text(coll))], false) }
    return Ok(Some(x))
}

// Whether an outer column of type oid is given as a cast to its type
// (outerRef): the scalar types a cast keeps as they are.
pub fn refTyped(oid: int): bool {
    return isIntOid(oid) || oid == lexdb_sql.OID_NUMERIC || oid == lexdb_sql.OID_FLOAT4 || oid == lexdb_sql.OID_FLOAT8 ||
           oid == lexdb_sql.OID_TEXT || oid == lexdb_sql.OID_VARCHAR || oid == lexdb_sql.OID_BPCHAR || oid == lexdb_sql.OID_BOOL ||
           oid == lexdb_sql.OID_DATE || oid == lexdb_sql.OID_TIME || oid == lexdb_sql.OID_TS || oid == lexdb_sql.OID_TSTZ ||
           oid == lexdb_sql.OID_UUID
}

// A parameter, bare or as outerRef types an outer column: a cast of one.
pub fn refParam(x: &Expr): bool {
    match x {
        Expr.Param(_) { return true }
        Expr.Cast(a, _) {
            match a {
                Expr.Param(_) { return true }
                else { return false }
            }
        }
        else { return false }
    }
}

// ---- resolve: a query's expressions over its columns, with the binder's casts

pub fn isBp(x: &Expr, cols: &[]lexdb_sql.ColDef, ty: &Typing): bool { return exprOid(x, cols, &[], ty) == lexdb_sql.OID_BPCHAR }

// A char expression's n, when it has one.
pub fn bpLen(x: &Expr, cols: &[]lexdb_sql.ColDef): int {
    match x {
        Expr.Col(n, _) {
            let i = colIndex(cols, &n)
            if i >= 0 && cols[i].typ.oid == lexdb_sql.OID_BPCHAR { return cols[i].typ.len }
        }
        Expr.Cast(_, t) { if t.oid == lexdb_sql.OID_BPCHAR { return t.len } }
        Expr.Call(n, args, _) { if n == "#bppad" && len(args) == 2 { return lexdb_sql.litInt(&args[1]) } }
        else {}
    }
    return 0
}

// A value whose type the other side gives: a text literal, a parameter.
fn untyped(x: &Expr): bool {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Text(_) { return true }
                Val.Null { return true }
                else { return false }
            }
        }
        Expr.Param(_) { return true }
        else { return false }
    }
}

// x compared with other, a column of a date or time type, when x
// has no type of its own: a text literal, or a parameter of no type or a
// text's (its value a text). The column's type then (its OID), as
// PostgreSQL types an untyped literal from the other side; else 0. resolve
// casts x to it (lexdb_sql.timeType: no precision, as compareTime reads a
// text), so it is read once, in the session's zone where it is evaluated,
// and a batch compares the column with a value of its own kind
// (bCmpKinds). design/lexdb-layers.md 4.4.1, 2-iii.
fn timeLitOid(x: &Expr, other: &Expr, cols: &[]lexdb_sql.ColDef, ns: &Names): int {
    var pn = 0
    match x {
        Expr.Lit(v) {
            match v {
                Val.Text(_) {}
                else { return 0 }
            }
        }
        Expr.Param(n) {
            if n < 1 { return 0 }
            pn = n
        }
        else { return 0 }
    }
    var o = 0
    match other {
        Expr.Col(n, _) {
            let i = colIndex(cols, &n)
            if i < 0 || lexdb_sql.timeKind(cols[i].typ.oid) == 0 { return 0 }
            o = cols[i].typ.oid
        }
        else { return 0 }
    }
    if pn == 0 { return o }
    let pt = ptypesOf(ns)
    if pn > len(pt) { return 0 }
    let p = pt[pn - 1]
    return if p == 0 || p == lexdb_sql.OID_UNKNOWN || p == lexdb_sql.OID_TEXT || p == lexdb_sql.OID_VARCHAR { o } else { 0 }
}

pub fn trimmed(x: Expr): Expr { return Expr.Call("#bptrim", [x], false) }

// Whether a side compared with a char is read as a char too: a char, a
// literal, a parameter, a varchar (PostgreSQL casts varchar to bpchar, and
// bpchar to text).
fn bpSide(x: &Expr, cols: &[]lexdb_sql.ColDef, ty: &Typing): bool {
    if untyped(x) { return true }
    let o = exprOid(x, cols, &[], ty)
    return o == lexdb_sql.OID_BPCHAR || o == lexdb_sql.OID_VARCHAR
}

// l op r, op a comparison, with a char on a side: as PostgreSQL compares.
pub fn bpCmp(op: &str, l: Expr, r: Expr, cols: &[]lexdb_sql.ColDef, ty: &Typing): Expr {
    let lb = isBp(&l, cols, ty)
    let rb = isBp(&r, cols, ty)
    if !lb && !rb { return Expr.Bin(op.toStr(), l, r) }
    let lo = exprOid(&l, cols, &[], ty)
    let ro = exprOid(&r, cols, &[], ty)
    let texty = fn(o: int): bool { return o == lexdb_sql.OID_TEXT || o == lexdb_sql.OID_NAME || o == lexdb_sql.OID_VARCHAR || o == lexdb_sql.OID_BPCHAR }
    if !texty(lo) || !texty(ro) { return Expr.Bin(op.toStr(), l, r) }
    if bpSide(&l, cols, ty) && bpSide(&r, cols, ty) {
        // both chars: equal to a column of n when padded to n
        if op == "=" {
            let ln = bpLen(&l, cols)
            let rn = bpLen(&r, cols)
            let lc = match l { Expr.Col(_, _) { true } else { false } }
            let rc = match r { Expr.Col(_, _) { true } else { false } }
            if lc && ln > 0 && (untyped(&r) || (rb && rn != ln)) { return Expr.Bin("=", l, Expr.Call("#bppad", [r, Expr.Lit(Val.Int(ln))], false)) }
            if rc && rn > 0 && (untyped(&l) || (lb && ln != rn)) { return Expr.Bin("=", Expr.Call("#bppad", [l, Expr.Lit(Val.Int(rn))], false), r) }
            if lb && rb && ln > 0 && ln == rn { return Expr.Bin("=", l, r) }
        }
        return Expr.Bin(op.toStr(), trimmed(l), trimmed(r))
    }
    // with a text: the char as a text
    return Expr.Bin(op.toStr(), if lb { trimmed(l) } else { l }, if rb { trimmed(r) } else { r })
}

// The calls that see a char as it is, blanks and all; any other is given
// it as a text (bpTrim), as PostgreSQL's functions on text are.
fn bpKeeps(nm: &str): bool {
    if strings.startsWith(&nm, "#") || lexdb_sql.isQuant(nm) || isWinFn(nm) { return true }
    let b = lexdb_sql.aggBase(nm)
    if isAgg(nm) && b != "string_agg" { return true }
    match b {
        "concat", "concat_ws", "format", "octet_length", "like", "ilike", "similar", "~", "!~", "~*", "!~*", "coalesce", "case",
        "greatest", "least", "pg_typeof", "row", "array", "in", "distinct", "nullif", "grouping" { return true }
        else { return false }
    }
}

// A call's arguments resolved, with a char among them (9.94).
pub fn bpCall(nm: &str, args: []Expr, star: bool, cols: &[]lexdb_sql.ColDef, ty: &Typing): Expr {
    var any = false
    for a in args { if isBp(&a, cols, ty) { any = true } }
    if !any { return Expr.Call(nm.toStr(), args, star) }
    var xs = args
    if nm == "in" && len(xs) > 1 && isBp(&xs[0], cols, ty) {
        // x IN (a, b): as x = a OR x = b; padded to x's n when all are values
        let n = bpLen(&xs[0], cols)
        let col = match xs[0] { Expr.Col(_, _) { true } else { false } }
        var allUntyped = true
        for i in 1..len(xs) { if !untyped(&xs[i]) { allUntyped = false } }
        var out: []Expr = []
        if col && n > 0 && allUntyped {
            append(mut &out, clone(&xs[0]))
            for i in 1..len(xs) { append(mut &out, Expr.Call("#bppad", [clone(&xs[i]), Expr.Lit(Val.Int(n))], false)) }
            return Expr.Call("in", out, star)
        }
        var allBp = true
        for i in 1..len(xs) { if !bpSide(&xs[i], cols, ty) { allBp = false } }
        append(mut &out, trimmed(clone(&xs[0])))
        for i in 1..len(xs) { append(mut &out, if allBp || isBp(&xs[i], cols, ty) { trimmed(clone(&xs[i])) } else { clone(&xs[i]) }) }
        return Expr.Call("in", out, star)
    }
    if (nm == "distinct from" || nm == "nullif") && len(xs) == 2 {
        let both = bpSide(&xs[0], cols, ty) && bpSide(&xs[1], cols, ty)
        let a = if both || isBp(&xs[0], cols, ty) { trimmed(clone(&xs[0])) } else { clone(&xs[0]) }
        let b = if both || isBp(&xs[1], cols, ty) { trimmed(clone(&xs[1])) } else { clone(&xs[1]) }
        if nm == "distinct from" { return Expr.Call("distinct from", [a, b], false) }
        // nullif(x, y): NULL when equal so, else x as it is
        return Expr.Call("case else", [Expr.Bin("=", a, b), Expr.Lit(Val.Null), clone(&xs[0])], false)
    }
    if lexdb_sql.isQuant(nm) && !strings.endsWith(&nm, "like") && len(xs) == 2 {
        return Expr.Call(nm.toStr(), [trimmed(clone(&xs[0])), clone(&xs[1])], star)
    }
    if bpKeeps(nm) { return Expr.Call(nm.toStr(), xs, star) }
    var out: []Expr = []
    for a in xs { append(mut &out, if isBp(&a, cols, ty) { trimmed(clone(&a)) } else { clone(&a) }) }
    return Expr.Call(nm.toStr(), out, star)
}

// A value for a column of type t: a char given to a text one without its
// blanks, as PostgreSQL's assignment cast.
pub fn bpAssign(x: Expr, t: &lexdb_sql.TypeName, cols: &[]lexdb_sql.ColDef, ty: &Typing): Expr {
    if t.kind == lexdb_sql.K_TEXT && t.oid != lexdb_sql.OID_BPCHAR && isBp(&x, cols, ty) { return trimmed(x) }
    return x
}

const AGGS: []str = ["count", "sum", "avg", "min", "max", "string_agg", "array_agg", "bool_and", "bool_or", "every", "stddev",
                     "stddev_samp", "stddev_pop", "variance", "var_samp", "var_pop"]

pub fn isAgg(name: &str): bool {
    let b = lexdb_sql.aggBase(name)
    for a in AGGS { if a == b { return true } }
    return false
}

// An expression with its column names made alias.column.
// A name not among a query's columns may be one of a query around it
// (a correlated subquery): then it is a parameter.
pub fn resolve(x: &Expr, cols: &[]lexdb_sql.ColDef, n: int, ns: mut &Names): Result[Expr, DbErr] {
    match x {
        Expr.Col(name, _) {
            match resolveName(cols, n, &name) {
                Ok(r) { return Ok(if dotAt(&name) < 0 { colExpr(cols, r) } else { Expr.Col(cols[r].name, r) }) }
                Err(err) {
                    var mine = false
                    match resolveName(cols, len(cols), &name) {
                        Ok(_) { mine = true }
                        Err(x2) { mine = x2.state == "42702" }
                    }
                    if !mine && len(ns.frames) > 1 {
                        match try outerRef(ns, &name) {
                            Some(r) { return Ok(r) }
                            None {}
                        }
                    }
                    return Err(err)
                }
            }
        }
        Expr.Unary(op, a) { return Ok(Expr.Unary(op, try resolve(&a, cols, n, ns))) }
        Expr.Bin(op, a, b) {
            let l = try resolve(&a, cols, n, ns)
            let r = try resolve(&b, cols, n, ns)
            if op == "||" {
                // with an array: array_cat, array_append or array_prepend (9.92)
                let f = arrayConcat(&l, &r, cols, &[], &ns.ty)
                if len(f) > 0 { return Ok(Expr.Call(f, [l, r], false)) }
                // a char as a text (9.94)
                let lt = if isBp(&l, cols, &ns.ty) { trimmed(l) } else { l }
                let rt = if isBp(&r, cols, &ns.ty) { trimmed(r) } else { r }
                return Ok(Expr.Bin(op, lt, rt))
            }
            if op == "/" && len(ns.coll) > 0 {
                // T-SQL's decimal division: its scale SQL Server's (design/lexdb-tds.md S3)
                let pa = numPS(&l, cols, ns)
                let pb = numPS(&r, cols, ns)
                if pa.p > 0 && pb.p > 0 && (pa.s > 0 || pb.s > 0 || pa.dec || pb.dec) {
                    let ip = pa.p - pa.s + pb.s
                    var scale = max(6, pa.s + pb.p + 1)
                    if ip + scale > 38 { scale = max(min(scale, 38 - ip), 6) }
                    return Ok(Expr.Call("#tdiv", [l, r, Expr.Lit(Val.Int(scale))], false))
                }
            }
            if isCmp(&op) {
                var lx = l
                var rx = r
                // an untyped value beside a date or time column: of its type (timeLitOid)
                let tl = timeLitOid(&lx, &rx, cols, ns)
                let tr = timeLitOid(&rx, &lx, cols, ns)
                if tl > 0 { lx = Expr.Cast(replace(mut &lx, Expr.Lit(Val.Null)), lexdb_sql.timeType(tl)) }
                if tr > 0 { rx = Expr.Cast(replace(mut &rx, Expr.Lit(Val.Null)), lexdb_sql.timeType(tr)) }
                if len(ns.coll) > 0 {
                    // T-SQL has no booleans: a bit compared with a number (active = 1)
                    let pt = ptypesOf(ns)
                    let lo = exprOid(&lx, cols, &pt, &ns.ty)
                    let ro = exprOid(&rx, cols, &pt, &ns.ty)
                    let bit = lexdb_sql.TypeName{kind: lexdb_sql.K_BOOL, oid: lexdb_sql.OID_BOOL, prec: 0, scale: 0, len: 1}
                    if lo == lexdb_sql.OID_BOOL && isIntOid(ro) {
                        rx = Expr.Cast(replace(mut &rx, Expr.Lit(Val.Null)), bit)
                    } else if ro == lexdb_sql.OID_BOOL && isIntOid(lo) {
                        lx = Expr.Cast(replace(mut &lx, Expr.Lit(Val.Null)), bit)
                    }
                }
                // under a collation's keys (L2), else as PostgreSQL compares a char
                let k = try cmpKind(&op, &lx, &rx, cols, ns)
                if k == lexdb_sql.COLL_EXACT { return Ok(bpCmp(&op, lx, rx, cols, &ns.ty)) }
                // a char(n) side without its blanks (or both padded alike) first,
                // as bpCmp makes it, then its key: 'AB   ' is 'ab' case-insensitively
                match bpCmp(&op, lx, rx, cols, &ns.ty) {
                    Expr.Bin(o2, l2, r2) { return Ok(Expr.Bin(o2, collKeyOf(k, l2), collKeyOf(k, r2))) }
                    else { return Err(e("XX000", "a comparison resolved to no comparison")) }
                }
            }
            return Ok(Expr.Bin(op, l, r))
        }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try resolve(&a, cols, n, ns), neg)) }
        Expr.Cast(a, t) {
            let cx = try resolve(&a, cols, n, ns)
            // T-SQL: '' as an integer, a float or a bit is 0 (design/lexdb-tds.md, section 13)
            if len(ns.coll) > 0 && ns.blank(&cx) && (t.kind == lexdb_sql.K_INT || t.kind == lexdb_sql.K_FLOAT || t.kind == lexdb_sql.K_BOOL) {
                return Ok(Expr.Cast(Expr.Lit(Val.Int(0)), t))
            }
            // a char cast to a text: without its blanks (9.94)
            if t.kind == lexdb_sql.K_TEXT && t.oid != lexdb_sql.OID_BPCHAR && isBp(&cx, cols, &ns.ty) { return Ok(Expr.Cast(trimmed(cx), t)) }
            return Ok(Expr.Cast(cx, t))
        }
        Expr.Call(nm, args, star) {
            var out: []Expr = []
            if nm == "#bitint" && len(args) == 1 {
                // T-SQL: a bit in arithmetic as 0 or 1; anything else as it is
                let a = try resolve(&args[0], cols, n, ns)
                let pt = ptypesOf(ns)
                if exprOid(&a, cols, &pt, &ns.ty) != lexdb_sql.OID_BOOL { return Ok(a) }
                return Ok(Expr.Call("#bitint", [a], false))
            }
            if lexdb_sql.isSubCall(&nm) && len(args) < subFixed(&nm) {
                // a subquery: its number, type and name, (IN: the value), then the outer values it needs
                let i = lexdb_sql.litInt(&args[0])
                var xs: []Expr = []
                if nm == "#in" {
                    // x IN (subquery) under its collation (L2): x's and the
                    // subquery's column's; the set is keyed so (endScope)
                    var v = try resolve(&args[1], cols, n, ns)
                    let top = len(ns.frames) - 1
                    // compared as = compares (inReadOid): an untyped or
                    // text value read as the set's type, or the set's texts as
                    // the value's
                    let pt0 = ptypesOf(ns)
                    let ty0 = ns.ty
                    let po = argOid(&v, cols, &pt0, &ty0)
                    let so = ns.frames[top].subOids[i]
                    let ro = inReadOid(po, so)
                    if ro != 0 { v = Expr.Cast(replace(mut &v, Expr.Lit(Val.Null)), lexdb_sql.oidType(ro)) }
                    ns.frames[top].subReads[i] = inReadOid(so, po)
                    let sn = ns.frames[top].subColls[i]
                    let c2 = if len(sn) > 0 { Coll{name: sn, level: CL_IMPLICIT} } else { Coll{name: ns.coll, level: CL_DEFAULT} }
                    let c = try cmpColl(exprColl(&v, cols, ns), c2, &"=")
                    let k = if c.level == CL_NONE || !(isTextExpr(&v, cols, ns) || isTextOid(ns.frames[top].subOids[i])) { lexdb_sql.COLL_EXACT } else { lexdb_sql.collKind(&c.name) }
                    ns.frames[top].subKinds[i] = k
                    append(mut &xs, collKeyOf(k, v))
                }
                let f = &ns.frames[len(ns.frames) - 1]
                append(mut &out, Expr.Lit(Val.Int(i)))
                append(mut &out, Expr.Lit(Val.Int(f.subOids[i])))
                append(mut &out, Expr.Lit(Val.Text(f.subNames[i])))
                if len(xs) > 0 {
                    // a char IN a subquery of texts: as a text (9.94)
                    let ix = pop(mut &xs)
                    append(mut &out, if isBp(&ix, cols, &ns.ty) { trimmed(ix) } else { ix })
                }
                for r in f.subRefs[i] { append(mut &out, clone(&r)) }
                return Ok(Expr.Call(nm, out, star))
            }
            for a in args { append(mut &out, try resolve(&a, cols, n, ns)) }
            if nm == "in" && !star {
                // x IN (a, b) beside a date or time column x: as x = a OR x = b
                for i in 1..len(out) {
                    let o = timeLitOid(&out[i], &out[0], cols, ns)
                    if o > 0 { out[i] = Expr.Cast(replace(mut &out[i], Expr.Lit(Val.Null)), lexdb_sql.timeType(o)) }
                }
            }
            if isTypedFn(&nm) && (len(out) == 0 || !isHint(&out[len(out) - 1])) {
                // the arguments' types, for the call to see (9.92)
                var os: []str = []
                for ox in out { append(mut &os, exprOid(&ox, cols, &[], &ns.ty).toStr()) }
                append(mut &out, Expr.Lit(Val.Text(lexdb_lib.HINT + strings.join(&os, ","))))
            }
            if nm == "in" || nm == "like" || nm == "ilike" || nm == "#tlike" || nm == "distinct from" || nm == "charindex" || nm == "patindex" {
                out = try collateCall(&nm, out, cols, ns)
            }
            if lexdb_sql.isQuant(&nm) && len(out) == 2 && !star {
                // x op ANY (ARRAY[a, b]) under a collation's keys (L2), each element's as IN's
                match out[1] {
                    Expr.Call(an, elems, s2) {
                        if an == "array" && !s2 && len(elems) > 0 {
                            var xs: []Expr = [clone(&out[0])]
                            for el in elems { append(mut &xs, clone(&el)) }
                            var ks = try collateCall(&"in", xs, cols, ns)
                            var rest: []Expr = []
                            for k in 1..len(ks) { append(mut &rest, replace(mut &ks[k], Expr.Lit(Val.Null))) }
                            out = [replace(mut &ks[0], Expr.Lit(Val.Null)), Expr.Call("array", rest, false)]
                        }
                    }
                    else {}
                }
            }
            if !star && (((nm == "coalesce" || nm == "greatest" || nm == "least") && len(out) > 1) || nm == "case" || nm == "case else") {
                // its values made of one type (commonOid), as
                // PostgreSQL's: an untyped one ('1900-01-01' after a
                // timestamp) read as it, a number or a date of another type
                // converted (1 as a numeric beside 2.5)
                out = unifyVals(&nm, out, cols, ns)
            }
            if nm == "avg" && !star && len(out) == 1 && len(ns.coll) > 0 {
                // T-SQL's AVG: of integers an integer, of decimal(p, s) scale max(s, 6)
                let ps = numPS(&out[0], cols, ns)
                let pt = ptypesOf(ns)
                let o = exprOid(&out[0], cols, &pt, &ns.ty)
                let mode = if isIntOid(o) { -1 } else if ps.p > 0 && ps.dec { max(ps.s, 6) } else { -2 }
                if mode != -2 { return Ok(Expr.Call("#tavg", [Expr.Call(nm, out, star), Expr.Lit(Val.Int(mode))], false)) }
            }
            if nm == "replace" && len(out) == 3 {
                // REPLACE under a case-insensitive collation matches as it folds
                let c = try cmpColl(exprColl(&out[0], cols, ns), exprColl(&out[1], cols, ns), &"replace")
                if c.level != CL_NONE && lexdb_sql.collKind(&c.name) == lexdb_sql.COLL_CI { return Ok(Expr.Call("#replaceci", out, star)) }
            }
            if nm == "nullif" && len(out) == 2 && !star {
                // NULLIF(a, b) under a collation's keys (L2): CASE WHEN a = b THEN NULL ELSE a END
                let k = try cmpKind(&"=", &out[0], &out[1], cols, ns)
                if k != lexdb_sql.COLL_EXACT {
                    let a0 = clone(&out[0])
                    let eq = Expr.Bin("=", collKeyOf(k, clone(&out[0])), collKeyOf(k, clone(&out[1])))
                    return Ok(Expr.Call("case else", [eq, Expr.Lit(Val.Null), a0], false))
                }
            }
            if nm == "pg_typeof" && len(out) == 1 && !star {
                // its argument's type, known now: a text (PostgreSQL's regtype, shown by name)
                let o = exprOid(&out[0], cols, &[], &ns.ty)
                if o == lexdb_sql.OID_BPCHAR { return Ok(Expr.Lit(Val.Text("character"))) }
                return Ok(Expr.Lit(Val.Text(lexdb_sql.typeText(&lexdb_sql.oidType(o)))))
            }
            return Ok(bpCall(&nm, out, star, cols, &ns.ty))
        }
        else { return Ok(clone(x)) }
    }
}

// A call's values (valueArgs) made of their common type: each
// one of another type cast to it, a constant converted now (but for a
// timestamptz, whose value is the session's zone's). Of different
// categories, as they are.
fn unifyVals(nm: &str, out: []Expr, cols: &[]lexdb_sql.ColDef, ns: &Names): []Expr {
    let pt = ptypesOf(ns)
    let ty = ns.ty
    let idx = valueArgs(nm, len(out))
    var os: []int = []
    for i in idx { append(mut &os, argOid(&out[i], cols, &pt, &ty)) }
    let o = commonOid(&ty, &os)
    if o == 0 { return out }
    var xs = out
    for k in 0..len(idx) {
        let i = idx[k]
        // (T-SQL: '' as a number is 0)
        if len(ns.coll) > 0 && ns.blank(&xs[i]) && (isIntOid(o) || isFloatOid(o) || o == lexdb_sql.OID_BOOL) {
            xs[i] = Expr.Cast(Expr.Lit(Val.Int(0)), lexdb_sql.oidType(o))
            continue
        }
        if !converts(&ty, os[k], o) { continue }
        let x = replace(mut &xs[i], Expr.Lit(Val.Null))
        xs[i] = castConst(x, o, ns)
    }
    return xs
}

// x cast to the type oid: a constant's value converted now (an error left
// for the run), but a timestamptz's.
fn castConst(x: Expr, oid: int, ns: &Names): Expr {
    let t = lexdb_sql.oidType(oid)
    match x {
        Expr.Lit(v) {
            if lexdb_ops.isNull(&v) { return Expr.Lit(Val.Null) }
            if oid != lexdb_sql.OID_TSTZ {
                match ns.constCast(v, &t) {
                    Ok(c) { return Expr.Lit(c) }
                    Err(_) {}
                }
            }
        }
        else {}
    }
    return Expr.Cast(x, t)
}

pub fn isCmp(op: &str): bool { return op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">=" }

// A numeric expression's precision and scale as SQL Server types it (an
// integer literal its digits, an int column 10, decimal(p, s) its p and s);
// p 0: not known. dec: a decimal.
type PS = value record { p: int; s: int; dec: bool }

fn digitsOf(n: int): int {
    var d = 1
    var x = if n < 0 { 0 - n } else { n }
    while x >= 10 {
        x = x / 10
        d += 1
    }
    return d
}

fn numPS(x: &Expr, cols: &[]lexdb_sql.ColDef, ns: &Names): PS {
    let none = PS{p: 0, s: 0, dec: false}
    match x {
        Expr.Lit(v) {
            match v {
                Val.Int(n) { return PS{p: digitsOf(n), s: 0, dec: false} }
                Val.Num(d) {
                    let sc0 = max(d.scale(), 0)
                    let c = d.coefficient()
                    var digits = 1
                    var m = if c < 0 { 0 - c } else { c }
                    while m >= 10 {
                        m = m / 10
                        digits += 1
                    }
                    return PS{p: max(digits, sc0), s: sc0, dec: true}
                }
                else { return none }
            }
        }
        Expr.Col(n, _) {
            for c in cols { if c.name == n { return typPS(&c.typ) } }
            return none
        }
        Expr.Cast(_, t) { return typPS(&t) }
        Expr.Unary(op, a) { return if op == "-" { numPS(&a, cols, ns) } else { none } }
        Expr.Param(k) {
            let pt = ptypesOf(ns)
            let o = if k >= 1 && k <= len(pt) { pt[k - 1] } else { 0 }
            return typPS(&lexdb_sql.oidType(o))
        }
        else { return none }
    }
}

fn typPS(t: &lexdb_sql.TypeName): PS {
    if t.oid == lexdb_sql.OID_INT4 { return PS{p: 10, s: 0, dec: false} }
    if t.oid == lexdb_sql.OID_INT8 { return PS{p: 19, s: 0, dec: false} }
    if t.oid == lexdb_sql.OID_INT2 { return PS{p: 5, s: 0, dec: false} }
    if t.kind == lexdb_sql.K_NUM && t.prec > 0 { return PS{p: t.prec, s: t.scale, dec: true} }
    return PS{p: 0, s: 0, dec: false}
}

// An expression's collation (L2): its name ("" exact) and its strength,
// SQL Server's precedence: COLLATE (explicit) over a column's (implicit)
// over a literal's, a variable's or a parameter's (the session's default);
// CL_NONE: not text.
pub type Coll = value record { pub name: str; pub level: int }

fn noColl(): Coll { return Coll{name: "", level: CL_NONE} }

pub fn exprColl(x: &Expr, cols: &[]lexdb_sql.ColDef, ns: &Names): Coll {
    match x {
        Expr.Col(n, _) {
            for c in cols {
                if c.name == n { return if c.typ.kind == lexdb_sql.K_TEXT { Coll{name: c.coll, level: CL_IMPLICIT} } else { noColl() } }
            }
            return noColl()
        }
        Expr.Lit(v) {
            match v {
                Val.Text(_) { return Coll{name: ns.coll, level: CL_DEFAULT} }
                else { return noColl() }
            }
        }
        Expr.Param(k) {
            let pt = ptypesOf(ns)
            let o = if k >= 1 && k <= len(pt) { pt[k - 1] } else { 0 }
            return if isTextOid(o) || o == 0 { Coll{name: ns.coll, level: CL_DEFAULT} } else { noColl() }
        }
        Expr.Cast(a, t) {
            if t.kind != lexdb_sql.K_TEXT { return noColl() }
            let c = exprColl(&a, cols, ns)
            return if c.level >= CL_IMPLICIT { c } else { Coll{name: ns.coll, level: CL_DEFAULT} }
        }
        Expr.Bin(op, a, b) {
            if op != "||" && op != "+" { return noColl() }
            return strongerColl(exprColl(&a, cols, ns), exprColl(&b, cols, ns))
        }
        Expr.Call(n, args, _) {
            if (n == "#collate" || n == "#coll") && len(args) == 2 {
                match args[1] {
                    Expr.Lit(v) { return Coll{name: lexdb_sql.text(&v), level: if n == "#coll" { CL_IMPLICIT } else { CL_EXPLICIT }} }
                    else {}
                }
            }
            let pt = ptypesOf(ns)
            if !isTextOid(exprOid(x, cols, &pt, &ns.ty)) { return noColl() }
            var c = Coll{name: ns.coll, level: CL_DEFAULT}
            for a in args { c = strongerColl(c, exprColl(&a, cols, ns)) }
            return c
        }
        else { return noColl() }
    }
}

fn strongerColl(a: Coll, b: Coll): Coll { return if b.level > a.level { b } else { a } }

fn collOpName(op: &str): str {
    return match op {
        "=" { "equal to" }
        "<>" { "not equal to" }
        "<" { "less than" }
        "<=" { "less than or equal to" }
        ">" { "greater than" }
        ">=" { "greater than or equal to" }
        else { op.toStr() }
    }
}

// The collation a comparison of a and b is made under: the stronger; two
// of one strength that compare differently are a conflict (SQL Server's
// 468).
fn cmpColl(a: Coll, b: Coll, op: &str): Result[Coll, DbErr] {
    if a.level == b.level && a.level >= CL_IMPLICIT && lexdb_sql.collKind(&a.name) != lexdb_sql.collKind(&b.name) {
        // (SQL Server names the right one first)
        return Err(e("42P21", &("Cannot resolve the collation conflict between \"" + collShown(&b.name) + "\" and \"" +
                     collShown(&a.name) + "\" in the " + collOpName(op) + " operation.")))
    }
    return Ok(strongerColl(a, b))
}

fn collShown(n: &str): str { return if len(n) > 0 { n.toStr() } else { "default" } }

// x's key under a collation of kind k (lexdb_sql.COLL_*): #ci(x) folded,
// #pad(x) its trailing spaces dropped; x itself under an exact one.
pub fn collKeyOf(k: int, x: Expr): Expr {
    if k == lexdb_sql.COLL_CI { return Expr.Call("#ci", [x], false) }
    if k == lexdb_sql.COLL_PAD { return Expr.Call("#pad", [x], false) }
    return x
}

// Whether an expression is text or of a type not known (a parameter, NULL).
fn textOrUnknown(x: &Expr, cols: &[]lexdb_sql.ColDef, ns: &Names): bool {
    let pt = ptypesOf(ns)
    let o = exprOid(x, cols, &pt, &ns.ty)
    return o == 0 || isTextOid(o)
}

// Whether an expression is text (its type known as one).
fn isTextExpr(x: &Expr, cols: &[]lexdb_sql.ColDef, ns: &Names): bool {
    let pt = ptypesOf(ns)
    return isTextOid(exprOid(x, cols, &pt, &ns.ty))
}

// The collation a comparison of l and r is made under (L2), as the kind of
// its keys (lexdb_sql.COLL_*): COLL_EXACT when they are compared as they
// are.
fn cmpKind(op: &str, l: &Expr, r: &Expr, cols: &[]lexdb_sql.ColDef, ns: &Names): Result[int, DbErr] {
    let c = try cmpColl(exprColl(l, cols, ns), exprColl(r, cols, ns), op)
    let k = lexdb_sql.collKind(&c.name)
    if c.level == CL_NONE || k == lexdb_sql.COLL_EXACT { return Ok(lexdb_sql.COLL_EXACT) }
    // keys when both sides are text (or one is, the other's type unknown):
    // a date compared with '2024-01-01' compares dates
    if !(isTextExpr(l, cols, ns) || isTextExpr(r, cols, ns)) || !textOrUnknown(l, cols, ns) || !textOrUnknown(r, cols, ns) {
        return Ok(lexdb_sql.COLL_EXACT)
    }
    return Ok(k)
}

// x [NOT] IN (a, b, ...), x LIKE p, x IS DISTINCT FROM y, resolved, under
// their collation (L2): IN and IS DISTINCT FROM compare keys; LIKE folds
// case (its spaces kept).
fn collateCall(nm: &str, args: []Expr, cols: &[]lexdb_sql.ColDef, ns: &Names): Result[[]Expr, DbErr] {
    let foldOnly = nm == "like" || nm == "ilike" || nm == "#tlike" || nm == "charindex" || nm == "patindex"
    let n = if foldOnly { 2 } else { len(args) }
    if n < 2 { return Ok(args) }
    var c = exprColl(&args[0], cols, ns)
    var text = isTextExpr(&args[0], cols, ns)
    var mixed = !textOrUnknown(&args[0], cols, ns)
    for i in 1..n {
        c = try cmpColl(c, exprColl(&args[i], cols, ns), &(if nm == "in" { "=" } else { nm }))
        if isTextExpr(&args[i], cols, ns) { text = true }
        if !textOrUnknown(&args[i], cols, ns) { mixed = true }
    }
    if mixed { return Ok(args) }
    let k = lexdb_sql.collKind(&c.name)
    if c.level == CL_NONE || k == lexdb_sql.COLL_EXACT || !text { return Ok(args) }
    let like = foldOnly
    if like && k != lexdb_sql.COLL_CI { return Ok(args) }        // LIKE keeps spaces
    var out: []Expr = []
    for i in 0..len(args) {
        let a = clone(&args[i])
        if i < n { append(mut &out, if like { Expr.Call("#cifold", [a], false) } else { collKeyOf(k, a) }) } else { append(mut &out, a) }
    }
    return Ok(out)
}

// A resolved subquery call's arguments before its refs: number, type, name
// (and IN's value).
pub fn subFixed(n: &str): int { return if n == "#in" { 4 } else { 3 } }

const WIN_FNS: []str = ["row_number", "rank", "dense_rank", "percent_rank", "cume_dist", "ntile", "lag", "lead",
                        "first_value", "last_value", "nth_value"]

pub fn isWinFn(name: &str): bool {
    for w in WIN_FNS { if w == name { return true } }
    return false
}

// The functions whose answer depends on their arguments' types: resolve
// gives them a hint of those (lexdb_lib.HINT), a last argument of text no
// SQL text can hold, "\x00types:" and the OIDs.
const TYPED_FNS: []str = ["to_hex", "array_remove", "array_replace", "array_position", "array_positions", "@>", "<@", "&&"]

fn isTypedFn(n: &str): bool {
    for f in TYPED_FNS { if f == n { return true } }
    return false
}

fn isHint(x: &Expr): bool {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Text(s) { return strings.startsWith(&s, lexdb_lib.HINT) }
                else { return false }
            }
        }
        else { return false }
    }
}
// An expression's collation kind, a text one's (COLL_EXACT else).
pub fn exprKind(x: &Expr, cols: &[]lexdb_sql.ColDef, ns: &Names): int {
    let c = exprColl(x, cols, ns)
    if c.level == CL_NONE || !isTextExpr(x, cols, ns) { return lexdb_sql.COLL_EXACT }
    return lexdb_sql.collKind(&c.name)
}

// ---- the select list, ORDER BY and GROUP BY

// A result column: its name and type OID.
// spell: its name as written where that differs (L6), "" else; a client is
// shown label(), lexdb matches name.
// coll: a text column's collation (L2), "" exact.
// scale: a time type's fractional seconds where its type says (datetime's
// 3), -1 else (design/lexdb-tds.md S3: TDS sends datetime2(scale)).
pub type OutCol = value record { pub name: str; pub oid: int; pub spell: str; pub coll: str; pub scale: int }

pub fn (o: &OutCol) label(): str {
    if o.spell == lexdb_sql.ANON { return "" }         // T-SQL's unnamed column
    return if len(o.spell) > 0 { o.spell } else { o.name }
}

fn exprName(x: &Expr): str {
    match x {
        Expr.Col(n, _) { return colPart(&n) }
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) && len(args) >= 3 {
                match args[2] { Expr.Lit(v) { return lexdb_sql.text(&v) } else {} }
            }
            if n == "#win" && len(args) == 2 { return exprName(&args[1]) }
            if n == "#old" && len(args) == 1 { return exprName(&args[0]) }
            if n == "#acat" || n == "#aappend" || n == "#aprepend" || n == "@>" || n == "<@" || n == "&&" || n == "~" ||
               n == "!~" || n == "~*" || n == "!~*" { return "?column?" }
            return lexdb_sql.aggBase(&n)
        }
        Expr.Cast(a, t) {
            let inner = exprName(&a)
            return if inner == "?column?" { lexdb_ops.kindName(&t) } else { inner }
        }
        else { return "?column?" }
    }
}

// The output columns of a SELECT: (name, OID), and the expressions behind
// them (* expanded).
pub fn selectCols(s: &lexdb_sql.Stmt, cols: &[]lexdb_sql.ColDef, ns: mut &Names, exprs: mut &[]Expr): Result[[]OutCol, DbErr] {
    return itemCols(&s.items, len(s.from) > 0, cols, ns, exprs)
}

// An item list's output columns (a SELECT's or RETURNING's), over cols.
pub fn itemCols(items: &[]lexdb_sql.SelItem, from: bool, cols: &[]lexdb_sql.ColDef, ns: mut &Names,
            exprs: mut &[]Expr): Result[[]OutCol, DbErr] {
    var out: []OutCol = []
    for it in items {
        if it.star {
            if !from { return Err(e("42601", "SELECT * with no tables specified is not valid")) }
            var any = false
            var placed = false
            for c in cols { if c.pos >= 0 { placed = true } }
            if placed && it.qual == "" {
                // after JOIN ... USING: the merged columns, then the rest (9.93)
                for p in 0..len(cols) {
                    for i in 0..len(cols) {
                        let c = &cols[i]
                        if c.pos != p || lexdb_catalog.hiddenName(&c.name) { continue }
                        any = true
                        append(mut &out, OutCol{name: colPart(&c.name), oid: c.typ.oid, spell: "", coll: "", scale: -1})
                        append(exprs, colExpr(cols, i))
                    }
                }
                if !any { return Err(e("42601", "SELECT * with no columns")) }
                continue
            }
            for i in 0..len(cols) {
                let c = &cols[i]
                if it.qual != "" && c.name[0..dotAt(&c.name)] != it.qual { continue }
                any = true
                if lexdb_catalog.hiddenName(&c.name) { continue }
                append(mut &out, OutCol{name: colPart(&c.name), oid: c.typ.oid, spell: c.spell, coll: c.coll, scale: ns.colScale(&c.typ)})
                append(exprs, Expr.Col(c.name, i))
            }
            if !any { return Err(e("42P01", &("missing FROM-clause entry for table \"" + it.qual + "\""))) }
            continue
        }
        match it.expr {
            Some(x) {
                let r = try resolve(&x, cols, len(cols), ns)
                let name = if it.alias != "" { it.alias } else { exprName(&r) }
                let pt = ptypesOf(ns)
                // (its scale or SQL Server type as written, where resolving folded a cast away)
                let rs = ns.outScale(&r, cols)
                append(mut &out, OutCol{name: name, oid: exprOid(&r, cols, &pt, &ns.ty), spell: it.spell, coll: exprColl(&r, cols, ns).name,
                                        scale: if rs != -1 { rs } else { ns.outScale(&x, cols) }})
                append(exprs, r)
            }
            None {}
        }
    }
    return Ok(out)
}

// ORDER BY: an output column's name, if no input column has it, else an
// expression over the input.
pub fn resolveOrder(o: &Expr, cols: &[]lexdb_sql.ColDef, outs: &[]OutCol, ns: mut &Names): Result[Expr, DbErr] {
    match o {
        Expr.Col(n, _) {
            match resolveName(cols, len(cols), &n) {
                Ok(r) { return Ok(if dotAt(&n) < 0 { colExpr(cols, r) } else { Expr.Col(cols[r].name, r) }) }
                Err(x) {
                    for oc in outs { if oc.name == n { return Ok(Expr.Col(n, -1)) } }
                    return Err(x)
                }
            }
        }
        else {}
    }
    return resolve(o, cols, len(cols), ns)
}

// The output an ORDER BY item names (orderValue's): by position or by its
// alias; -1 none (an expression over the row); -2 a position not in the
// list (orderValue's error).
pub fn orderOut(o: &Expr, cols: &[]lexdb_sql.ColDef, outs: &[]OutCol, n: int): int {
    match o {
        Expr.Lit(v) {
            match v {
                Val.Int(i) { return if i < 1 || i > n { -2 } else { i - 1 } }
                else {}
            }
        }
        Expr.Col(name, _) {
            if colIndex(cols, &name) < 0 {
                for i in 0..len(outs) { if outs[i].name == name { return i } }
            }
        }
        else {}
    }
    return -1
}

// GROUP BY: an input column or expression; else an output column's
// position or name, meaning its expression.
pub fn resolveGroup(g: &Expr, cols: &[]lexdb_sql.ColDef, outs: &[]OutCol, exprs: &[]Expr, ns: mut &Names): Result[Expr, DbErr] {
    match g {
        Expr.Lit(v) {
            match v {
                Val.Int(n) {
                    if n < 1 || n > len(exprs) { return Err(e("42P10", &("GROUP BY position " + n.toStr() + " is not in select list"))) }
                    return Ok(clone(&exprs[n - 1]))
                }
                else {}
            }
        }
        Expr.Col(n, _) {
            match resolveName(cols, len(cols), &n) {
                Ok(r) { return Ok(if dotAt(&n) < 0 { colExpr(cols, r) } else { Expr.Col(cols[r].name, r) }) }
                Err(x) {
                    for i in 0..len(outs) { if outs[i].name == n { return Ok(clone(&exprs[i])) } }
                    return Err(x)
                }
            }
        }
        else {}
    }
    return resolve(g, cols, len(cols), ns)
}
