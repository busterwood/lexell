// lexdb_newfn: the scalar functions the newest releases added (design/lexdb-new-features.md 6.1 item 6), in each door
// that has them, under its own name, types and errors. One kernel where the products agree (the buckets of a date-time,
// the edit distances, UNISTR's escapes), each door's spelling around it:
//
// - PostgreSQL: date_bin (14), unistr (14), uuidv4 / uuidv7 (18), uuid_extract_version / uuid_extract_timestamp (17), by
//   their own names;
// - T-SQL (lexdb_parse.tsqlCall names them #n_t...): DATE_BUCKET and DATETRUNC (2022), BASE64_ENCODE / BASE64_DECODE,
//   UNISTR, EDIT_DISTANCE, EDIT_DISTANCE_SIMILARITY, JARO_WINKLER_DISTANCE, JARO_WINKLER_SIMILARITY (2025);
// - Oracle (lexdb_parse.oraCall names them #n_o...): TIME_BUCKET (23ai), UUID, IS_UUID, RAW_TO_UUID, UUID_TO_RAW (26ai),
//   UNISTR, TO_BOOLEAN (23ai), UTL_MATCH's EDIT_DISTANCE, EDIT_DISTANCE_SIMILARITY, JARO_WINKLER, JARO_WINKLER_SIMILARITY.
//
// lexdb_lib.entryOf finds them here after its own (entryOf below), the binder their types (resultOid). A T-SQL call is
// given its arguments' types after them (the binder's hint, typesHint: each "oid.prec.scale"), for SQL Server's errors
// by type (8116, 9810) and DATETRUNC's precision.

import "strings"
import "unicode"
import "base64"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_time"
import "./lexdb_ops"
import "./lexdb_rows"

type Val = lexdb_sql.Val
type DbErr = lexdb_base.DbErr
type Fn = fn(&str, &[]Val, int, &lexdb_time.Zone): Result[Val, DbErr]

fn e(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

fn ora(num: int, msg: &str): DbErr { return lexdb_base.err(&("ORA" + strings.padLeft(&(num.toStr()), 5, '0')), msg) }

// name's function of n arguments here; None: not one of these.
pub fn entryOf(name: &str, n: int): Option[Fn] {
    match name {
        "date_bin" { if n == 3 { return Some(dateBinFn) } }
        "uuidv4" { if n == 0 { return Some(uuid4Fn) } }
        "uuidv7" { if n <= 1 { return Some(uuid7Fn) } }
        "uuid_extract_version" { if n == 1 { return Some(uuidVersionFn) } }
        "uuid_extract_timestamp" { if n == 1 { return Some(uuidStampFn) } }
        "unistr" { if n == 1 { return Some(pgUnistrFn) } }
        "error_on_null" { if n == 1 { return Some(errorOnNullFn) } }
        "to_bin", "to_oct" { return Some(toBaseFn) }               // (typed: a hint after the arguments)
        "bit_count" { if n == 1 { return Some(bitCountFn) } }
        "erf", "erfc", "gamma", "lgamma" { if n == 1 { return Some(mathFn) } }
        "crc32", "crc32c" { if n == 1 { return Some(crcFn) } }
        "date_add", "date_subtract" { if n == 2 || n == 3 { return Some(dateAddFn) } }
        "casefold" { if n == 1 { return Some(casefoldFn) } }
        "trim_array" { if n == 2 { return Some(trimArrayFn) } }
        "array_reverse", "array_shuffle" { if n == 1 { return Some(arrayOrderFn) } }
        "array_sample" { if n == 2 { return Some(arraySampleFn) } }
        "random" { if n == 2 { return Some(randomRangeFn) } }
        "#n_tbucket" { return Some(tBucketFn) }
        "#n_intbytes" { return Some(intBytesFn) }
        "#n_bytes2", "#n_bytes4", "#n_bytes8" { return Some(bytesIntFn) }
        "#n_ttrunc" { return Some(tTruncFn) }
        "#n_tb64e" { return Some(tB64EncFn) }
        "#n_tb64d" { return Some(tB64DecFn) }
        "#n_tunistr" { return Some(tUnistrFn) }
        "#n_tedit", "#n_teditsim", "#n_tjwd", "#n_tjws" { return Some(tFuzzyFn) }
        "#n_obucket" { return Some(oBucketFn) }
        "#n_ouuid" { return Some(oUuidFn) }
        "#n_oisuuid" { return Some(oIsUuidFn) }
        "#n_orawuuid" { return Some(oRawToUuidFn) }
        "#n_ouuidraw" { return Some(oUuidToRawFn) }
        "#n_ounistr" { return Some(oUnistrFn) }
        "#n_oceil", "#n_ofloor", "#n_oround" { return Some(oRoundFn) }
        "#n_otobool" { return Some(oToBoolFn) }
        "#n_oedit", "#n_oeditsim", "#n_ojw", "#n_ojws" { return Some(oFuzzyFn) }
        else {}
    }
    return None
}

// Whether name is one of these whose value changes from call to call (not folded, not shared).
pub fn isVolatile(name: &str): bool {
    return name == "uuidv4" || name == "uuidv7" || name == "#n_ouuid" || name == "array_shuffle" || name == "array_sample"
}

// The type of name's result for arguments of these types; 0: not one of these.
pub fn resultOid(name: &str, os: &[]int): int {
    let a = if len(os) > 0 { os[0] } else { 0 }
    match name {
        "date_bin" {
            // (an untyped source is a timestamptz, as PostgreSQL resolves it)
            let s = if len(os) > 1 { os[1] } else { lexdb_sql.OID_TS }
            return if s == lexdb_sql.OID_TS || s == lexdb_sql.OID_DATE { lexdb_sql.OID_TS } else { lexdb_sql.OID_TSTZ }
        }
        "uuidv4", "uuidv7" { return lexdb_sql.OID_UUID }
        "#n_bytes2" { return lexdb_sql.OID_INT2 }
        "#n_bytes4" { return lexdb_sql.OID_INT4 }
        "#n_bytes8" { return lexdb_sql.OID_INT8 }
        "error_on_null", "trim_array", "array_reverse", "array_shuffle", "array_sample" { return a }
        "to_bin", "to_oct", "casefold" { return lexdb_sql.OID_TEXT }
        "bit_count", "crc32", "crc32c" { return lexdb_sql.OID_INT8 }
        "erf", "erfc", "gamma", "lgamma" { return lexdb_sql.OID_FLOAT8 }
        "date_add", "date_subtract" { return lexdb_sql.OID_TSTZ }
        "uuid_extract_version" { return lexdb_sql.OID_INT2 }
        "uuid_extract_timestamp" { return lexdb_sql.OID_TSTZ }
        "unistr", "#n_tunistr", "#n_ounistr", "#n_tb64e", "#n_orawuuid" { return lexdb_sql.OID_TEXT }
        "#n_tbucket" {
            let d = if len(os) > 2 { os[2] } else { lexdb_sql.OID_TS }
            return if d == lexdb_sql.OID_DATE || d == lexdb_sql.OID_TIME || d == lexdb_sql.OID_TSTZ { d } else { lexdb_sql.OID_TS }
        }
        "#n_ttrunc" {
            let d = if len(os) > 1 { os[1] } else { lexdb_sql.OID_TS }
            return if d == lexdb_sql.OID_DATE || d == lexdb_sql.OID_TIME || d == lexdb_sql.OID_TSTZ { d } else { lexdb_sql.OID_TS }
        }
        "#n_obucket" { return if a == lexdb_sql.OID_TSTZ { a } else { lexdb_sql.OID_TS } }
        "#n_oceil", "#n_ofloor", "#n_oround" { return if a == lexdb_sql.OID_IVAL { a } else { lexdb_sql.OID_TS } }
        "#n_tb64d", "#n_ouuid", "#n_ouuidraw", "#n_intbytes" { return lexdb_sql.OID_BYTEA }
        "#n_tedit", "#n_teditsim", "#n_tjws" { return lexdb_sql.OID_INT4 }
        "#n_tjwd", "#n_ojw" { return lexdb_sql.OID_FLOAT8 }
        "#n_oedit", "#n_oeditsim", "#n_ojws" { return lexdb_sql.OID_NUMERIC }
        "#n_oisuuid", "#n_otobool" { return lexdb_sql.OID_BOOL }
        else {}
    }
    if !strings.contains(name, "#") && !strings.contains(name, "_") { return 0 }
    // the newer aggregates (lexdb_agg), their names perhaps marked
    match lexdb_sql.aggBase(name) {
        "#product", "any_value" { return a }
        "#product4" { return lexdb_sql.OID_INT4 }
        "#product6" { return lexdb_sql.OID_NUMERIC }
        "bit_and", "bit_or", "bit_xor" { return if strings.contains(name, " dia:o") { lexdb_sql.OID_NUMERIC } else { a } }
        "#kurtosis_pop", "#kurtosis_samp", "#skewness_pop", "#skewness_samp" { return lexdb_sql.OID_NUMERIC }
        else { return 0 }
    }
}

// ---- the arguments' types (the binder's hint after a T-SQL call's arguments)

pub const HINT: str = "\x00types:"

// The hint of these types.
pub fn typesHint(ts: &[]lexdb_sql.TypeName): str {
    var parts: []str = []
    for t in ts { append(mut &parts, t.oid.toStr() + "." + t.prec.toStr() + "." + t.scale.toStr()) }
    return HINT + strings.join(&parts, ",")
}

// A call's arguments without the hint, and the hint's types (oid 0 where none).
type Args = record {
    n: int                      // the arguments before the hint
    oids: []int
    precs: []int
    scales: []int
}

fn argsOf(vs: &[]Val): Args {
    var a = Args{n: len(vs), oids: [], precs: [], scales: []}
    if len(vs) > 0 {
        match vs[len(vs) - 1] {
            Val.Text(s) {
                if strings.startsWith(&s, HINT) {
                    a.n = len(vs) - 1
                    for p in strings.split(&s[len(HINT)..len(s)], ",") {
                        let ps = p.toStr()
                        let f = strings.split(&ps, ".")
                        append(mut &a.oids, if len(f) > 0 { strings.parseIntOpt(&(f[0].toStr())).unwrapOr(0) } else { 0 })
                        append(mut &a.precs, if len(f) > 1 { strings.parseIntOpt(&(f[1].toStr())).unwrapOr(0) } else { 0 })
                        append(mut &a.scales, if len(f) > 2 { strings.parseIntOpt(&(f[2].toStr())).unwrapOr(0) } else { 0 })
                    }
                }
            }
            else {}
        }
    }
    while len(a.oids) < a.n {
        append(mut &a.oids, 0)
        append(mut &a.precs, 0)
        append(mut &a.scales, 0)
    }
    return a
}

fn isNull(v: &Val): bool { return lexdb_ops.isNull(v) }

// SQL Server's name of a type (an argument's, for 8116 and 9810).
fn tsName(oid: int, prec: int): str {
    if oid == lexdb_sql.OID_DATE { return "date" }
    if oid == lexdb_sql.OID_TIME { return "time" }
    if oid == lexdb_sql.OID_TSTZ { return "datetimeoffset" }
    if oid == lexdb_sql.OID_TS { return if prec == 61 { "datetime" } else if prec == 58 { "smalldatetime" } else { "datetime2" } }
    if oid == lexdb_sql.OID_INT2 { return "smallint" }
    if oid == lexdb_sql.OID_INT4 { return "int" }
    if oid == lexdb_sql.OID_INT8 { return "bigint" }
    if oid == lexdb_sql.OID_NUMERIC { return "numeric" }
    if oid == lexdb_sql.OID_FLOAT8 || oid == lexdb_sql.OID_FLOAT4 { return "float" }
    if oid == lexdb_sql.OID_BOOL { return "bit" }
    if oid == lexdb_sql.OID_BYTEA { return "varbinary" }
    if oid == lexdb_sql.OID_UUID { return "uniqueidentifier" }
    return if prec == 167 || prec == 175 { "varchar" } else { "nvarchar" }
}

// A value's SQL Server type where the hint has none (a variable's).
fn valName(v: &Val): str {
    match v {
        Val.Int(_) { return "int" }
        Val.Num(_) { return "numeric" }
        Val.Float(_) { return "float" }
        Val.Real(_) { return "real" }
        Val.Bool(_) { return "bit" }
        Val.Text(_) { return "varchar" }
        Val.Bytes(_) { return "varbinary" }
        Val.Date(_) { return "date" }
        Val.Time(_) { return "time" }
        Val.Ts(_) { return "datetime2" }
        Val.Tstz(_) { return "datetimeoffset" }
        Val.Uuid(_) { return "uniqueidentifier" }
        else { return "sql_variant" }
    }
}

fn argName(a: &Args, vs: &[]Val, k: int): str { return if a.oids[k] != 0 { tsName(a.oids[k], a.precs[k]) } else { valName(&vs[k]) } }

fn badArg(a: &Args, vs: &[]Val, k: int, fname: &str): DbErr {
    return e("TS8116", &("Argument data type " + argName(a, vs, k) + " is invalid for argument " + (k + 1).toStr() + " of " + fname + " function."))
}

// ---- dates and times: the buckets (DATE_BUCKET, TIME_BUCKET, date_bin) and DATETRUNC

fn floorDiv(a: int, b: int): int {
    let q = a / b
    return if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floorMod(a: int, b: int): int { return a - floorDiv(a, b) * b }

fn monthsOf(us: int): int {
    let l = lexdb_time.localOf(us)
    return l.date.year * 12 + l.date.month - 1
}

fn addMonths(us: int, m: int): Result[int, DbErr] { return lexdb_time.tsPlus(us, &lexdb_time.Ival{months: m, days: 0, us: 0}) }

// The start of the bucket of local time us: buckets of months months (when above 0) or of width microseconds, from
// origin; with end, the bucket's end.
pub fn bucketOf(us: int, months: int, width: int, origin: int, end: bool): Result[int, DbErr] {
    if months > 0 {
        // the whole months from the origin to us (the origin's day and time counted), as SQL Server's DATE_BUCKET
        var m = monthsOf(us) - monthsOf(origin)
        if (try addMonths(origin, m)) > us { m -= 1 }
        let k = floorDiv(m, months) * months
        return addMonths(origin, if end { k + months } else { k })
    }
    let k = floorDiv(us - origin, width)
    let at = origin + k * width
    return Ok(if end { at + width } else { at })
}

// 1900-01-01 00:00, SQL Server's origin
fn origin1900(): int { return lexdb_time.dateToTs(lexdb_time.makeDate(1900, 1, 1).unwrap()) }

// T-SQL DATE_BUCKET(part, number, date [, origin]): the part as lexdb_parse.datePart gives it.
fn tBucketFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    let a = argsOf(vs)
    let fname = "Date_Bucket"
    if a.n < 3 { return Err(e("TS174", "The date_bucket function requires 3 to 4 arguments.")) }
    let part = lexdb_sql.text(&vs[0])
    // the date's type and the number's (an integer or a number; a string is not)
    let doid = if a.oids[2] != 0 { a.oids[2] } else { oidOfVal(&vs[2]) }
    if !(doid == lexdb_sql.OID_DATE || doid == lexdb_sql.OID_TIME || doid == lexdb_sql.OID_TS || doid == lexdb_sql.OID_TSTZ) {
        return Err(badArg(&a, vs, 2, &fname))
    }
    let noid = if a.oids[1] != 0 { a.oids[1] } else { oidOfVal(&vs[1]) }
    if !(noid == lexdb_sql.OID_INT2 || noid == lexdb_sql.OID_INT4 || noid == lexdb_sql.OID_INT8 || noid == lexdb_sql.OID_NUMERIC ||
         noid == lexdb_sql.OID_FLOAT8 || noid == lexdb_sql.OID_FLOAT4 || noid == lexdb_sql.OID_BOOL) {
        return Err(badArg(&a, vs, 1, &fname))
    }
    if a.n > 3 {
        let ooid = if a.oids[3] != 0 { a.oids[3] } else { oidOfVal(&vs[3]) }
        if ooid != 0 && (ooid != doid || (doid == lexdb_sql.OID_TS && a.precs[3] != a.precs[2] && a.oids[3] != 0 && a.oids[2] != 0)) {
            return Err(badArg(&a, vs, 3, &fname))
        }
    }
    let dname = tsName(doid, a.precs[2])
    var months = 0
    var width = 0
    match part.toStr() {
        "year" { months = 12 }
        "quarter" { months = 3 }
        "month" { months = 1 }
        "week" { width = 7 * lexdb_time.DAY_US }
        "day" { width = lexdb_time.DAY_US }
        "hour" { width = 3600000000 }
        "minute" { width = 60000000 }
        "second" { width = 1000000 }
        "millisecond" { width = 1000 }
        else { return Err(e("TS9810", &("The datepart " + part + " is not supported by date function " + fname + " for data type " + dname + "."))) }
    }
    if (doid == lexdb_sql.OID_DATE && width > 0 && width < lexdb_time.DAY_US) || (doid == lexdb_sql.OID_TIME && (months > 0 || width >= lexdb_time.DAY_US)) {
        return Err(e("TS9810", &("The datepart " + part + " is not supported by date function " + fname + " for data type " + dname + ".")))
    }
    if isNull(&vs[1]) || isNull(&vs[2]) { return Ok(Val.Null) }
    let n = match lexdb_ops.asNum(&vs[1]) {
        Some(d) { d.toInt(Rounding.TOWARD_ZERO).unwrapOr(0) }
        None { 0 }
    }
    if n <= 0 { return Err(e("TS9834", "Invalid bucket width value passed to date_bucket function. Only positive values are allowed.")) }
    var org = if doid == lexdb_sql.OID_TIME { 0 } else { origin1900() }
    if a.n > 3 && !isNull(&vs[3]) { org = try localUs(&vs[3], z) }
    if doid == lexdb_sql.OID_TIME {
        let t = match vs[2] { Val.Time(u) { u } else { 0 } }
        return Ok(Val.Time(floorMod(try bucketOf(t, 0, n * width, org, false), lexdb_time.DAY_US)))
    }
    let us = try localUs(&vs[2], z)
    let r = match bucketOf(us, n * months, n * width, org, false) {
        Ok(x) { x }
        Err(_) { return Err(e("TS517", "Adding a value to a 'date' column caused an overflow.")) }
    }
    return Ok(sameKind(&vs[2], r, z))
}

fn oidOfVal(v: &Val): int {
    match v {
        Val.Date(_) { return lexdb_sql.OID_DATE }
        Val.Time(_) { return lexdb_sql.OID_TIME }
        Val.Ts(_) { return lexdb_sql.OID_TS }
        Val.Tstz(_) { return lexdb_sql.OID_TSTZ }
        Val.Int(_) { return lexdb_sql.OID_INT4 }
        Val.Num(_) { return lexdb_sql.OID_NUMERIC }
        Val.Float(_) { return lexdb_sql.OID_FLOAT8 }
        Val.Real(_) { return lexdb_sql.OID_FLOAT4 }
        Val.Bool(_) { return lexdb_sql.OID_BOOL }
        Val.Text(_) { return lexdb_sql.OID_TEXT }
        Val.Bytes(_) { return lexdb_sql.OID_BYTEA }
        else { return 0 }
    }
}

// A date-time as local microseconds since 2000 (a timestamptz in the session's zone).
fn localUs(v: &Val, z: &lexdb_time.Zone): Result[int, DbErr] {
    match v {
        Val.Date(d) { return Ok(lexdb_time.dateToTs(d)) }
        Val.Ts(u) { return Ok(u) }
        Val.Tstz(u) { return Ok(lexdb_time.tstzToTs(u, z)) }
        Val.Time(u) { return Ok(u) }
        Val.Text(s) {
            match lexdb_time.parseTs(&strings.trim(s), z) {
                Ok(u) { return Ok(u) }
                Err(_) { return Err(e("TS241", "Conversion failed when converting date and/or time from character string.")) }
            }
        }
        else { return Err(e("TS8116", "Argument data type is invalid for a date function.")) }
    }
}

// Local time us as a value of v's kind.
fn sameKind(v: &Val, us: int, z: &lexdb_time.Zone): Val {
    match v {
        Val.Date(_) { return Val.Date(lexdb_time.tsToDate(us)) }
        Val.Tstz(_) { return Val.Tstz(lexdb_time.tsToTstz(us, z)) }
        Val.Time(_) { return Val.Time(floorMod(us, lexdb_time.DAY_US)) }
        else { return Val.Ts(us) }
    }
}

// T-SQL DATETRUNC(part, date): the part as tsqlCall gives it (iso_week its own); the date's type kept.
fn tTruncFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    let a = argsOf(vs)
    let fname = "datetrunc"
    if a.n != 2 { return Err(e("TS174", "The datetrunc function requires 2 argument(s).")) }
    let part = lexdb_sql.text(&vs[0])
    let doid = if a.oids[1] != 0 { a.oids[1] } else { oidOfVal(&vs[1]) }
    if !(doid == lexdb_sql.OID_DATE || doid == lexdb_sql.OID_TIME || doid == lexdb_sql.OID_TS || doid == lexdb_sql.OID_TSTZ ||
         doid == lexdb_sql.OID_TEXT || doid == lexdb_sql.OID_VARCHAR || doid == lexdb_sql.OID_UNKNOWN) {
        return Err(badArg(&a, vs, 1, &fname))
    }
    let txt = !(doid == lexdb_sql.OID_DATE || doid == lexdb_sql.OID_TIME || doid == lexdb_sql.OID_TS || doid == lexdb_sql.OID_TSTZ)
    // the type's fractional digits: datetime 3, smalldatetime 0, datetime2 and time their scale (7 without one)
    let prec = a.precs[1]
    let scale = if prec == 61 { 3 } else if prec == 58 { 0 } else if prec == 1 { a.scales[1] } else { 7 }
    let dname = if txt { "datetime2" } else { tsName(doid, prec) }
    let rank = match part.toStr() {
        "year" { 1 }
        "quarter" { 2 }
        "month" { 3 }
        "dayofyear", "day" { 4 }
        "week", "iso_week" { 5 }
        "hour" { 6 }
        "minute" { 7 }
        "second" { 8 }
        "millisecond" { 9 }
        "microsecond" { 10 }
        else { 0 }
    }
    let unsupported = rank == 0 || (doid == lexdb_sql.OID_DATE && rank >= 6) || (doid == lexdb_sql.OID_TIME && rank <= 5) ||
                      (rank == 9 && scale < 3) || (rank == 10 && scale < 6)
    if unsupported { return Err(e("TS9810", &("The datepart " + part + " is not supported by date function " + fname + " for data type " + dname + "."))) }
    if isNull(&vs[1]) { return Ok(Val.Null) }
    let us = try localUs(&vs[1], z)
    var r = us
    if rank <= 5 {
        let l = lexdb_time.localOf(us)
        let day = floorDiv(us, lexdb_time.DAY_US)
        var d = day
        if rank == 1 { d = lexdb_time.makeDate(l.date.year, 1, 1).unwrap() }
        else if rank == 2 { d = lexdb_time.makeDate(l.date.year, ((l.date.month - 1) / 3) * 3 + 1, 1).unwrap() }
        else if rank == 3 { d = lexdb_time.makeDate(l.date.year, l.date.month, 1).unwrap() }
        else if rank == 5 {
            // 2000-01-01 was a Saturday: Sunday-based weeks (DATEFIRST 7), iso_week's from Monday
            let dow = floorMod(day + 6, 7)          // 0 Sunday
            d = if part == "iso_week" { day - floorMod(dow + 6, 7) } else { day - dow }
        }
        r = lexdb_time.dateToTs(d)
    } else {
        let w = if rank == 6 { 3600000000 } else if rank == 7 { 60000000 } else if rank == 8 { 1000000 } else if rank == 9 { 1000 } else { 1 }
        r = floorDiv(us, w) * w
    }
    if txt { return Ok(Val.Ts(r)) }
    return Ok(sameKind(&vs[1], r, z))
}

// PostgreSQL's date_bin(stride, source, origin): source's bucket of stride (no months), from origin.
fn dateBinFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) || isNull(&vs[1]) || isNull(&vs[2]) { return Ok(Val.Null) }
    let iv = match lexdb_ops.coerce(vs[0].clone(), &lexdb_sql.oidType(lexdb_sql.OID_IVAL)) {
        Ok(x) { match x { Val.Ival(v) { v } else { return Err(e("42883", "function date_bin needs an interval")) } } }
        Err(x) { return Err(x) }
    }
    if iv.months != 0 { return Err(e("0A000", "timestamps cannot be binned into intervals containing months or years")) }
    let width = iv.days * lexdb_time.DAY_US + iv.us
    if width <= 0 { return Err(e("22008", "stride must be greater than zero")) }
    // a timestamptz binned as instants; the rest as timestamps
    var tz = false
    match vs[1] {
        Val.Tstz(_) { tz = true }
        Val.Text(_) { tz = true }
        else {}
    }
    let tgt = if tz { lexdb_sql.oidType(lexdb_sql.OID_TSTZ) } else { lexdb_sql.oidType(lexdb_sql.OID_TS) }
    let src = try lexdb_ops.coerce(vs[1].clone(), &tgt)
    let org = try lexdb_ops.coerce(vs[2].clone(), &tgt)
    let s = match src { Val.Ts(u) { u } Val.Tstz(u) { u } else { 0 } }
    let o = match org { Val.Ts(u) { u } Val.Tstz(u) { u } else { 0 } }
    if s == lexdb_time.INF || s == lexdb_time.NINF { return Ok(src) }
    if o == lexdb_time.INF || o == lexdb_time.NINF { return Err(e("22008", "origin out of range")) }
    // (PostgreSQL's: the difference must fit, and the result)
    match s.checkedSub(o) {
        Some(_) {}
        None { return Err(e("22008", "interval out of range")) }
    }
    let r = try bucketOf(s, 0, width, o, false)
    return Ok(if tz { Val.Tstz(r) } else { Val.Ts(r) })
}

// Oracle's TIME_BUCKET(datetime, stride, origin [, START | END]): the stride an interval or an ISO 8601 duration's text,
// the origin of the datetime's type; END (the parser's 1 after them) the bucket's end.
fn oBucketFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    let n = len(vs)
    if n < 3 { return Err(ora(909, "invalid number of arguments")) }
    let end = n > 3 && lexdb_ops.intOf(&vs[3]).unwrapOr(0) == 1
    // the origin of the datetime's own type (a DATE and a TIMESTAMP are told apart by the parser's mark: 0 / 1 after END)
    let dk = if n > 5 { lexdb_ops.intOf(&vs[4]).unwrapOr(-1) } else { -1 }
    let ok = if n > 5 { lexdb_ops.intOf(&vs[5]).unwrapOr(-1) } else { -1 }
    if dk >= 0 && ok >= 0 && dk != ok {
        return Err(ora(3403, "For TIME_BUCKET function, the origin should have the same data type as specified datetime."))
    }
    if oidOfVal(&vs[2]) != 0 && oidOfVal(&vs[0]) != 0 && oidOfVal(&vs[2]) != oidOfVal(&vs[0]) && !isNull(&vs[0]) {
        return Err(ora(3403, "For TIME_BUCKET function, the origin should have the same data type as specified datetime."))
    }
    if isNull(&vs[0]) || isNull(&vs[1]) || isNull(&vs[2]) { return Ok(Val.Null) }
    let iv = match vs[1] {
        Val.Ival(v) { v }
        Val.Text(s) {
            match isoDuration(&s) {
                Some(v) { v }
                None { return Err(ora(1867, "the interval is invalid")) }
            }
        }
        else { return Err(ora(932, "inconsistent datatypes: expected INTERVAL got NUMBER")) }
    }
    let months = iv.months
    let width = iv.days * lexdb_time.DAY_US + iv.us
    if months < 0 || width < 0 || (months == 0 && width == 0) || (months > 0 && width > 0) { return Err(ora(1867, "the interval is invalid")) }
    if months == 0 && width < 1000000 {
        return Err(ora(3404, "For TIME_BUCKET function, fractional second is supported only if the specified datetime and the origin are Epoch Time, BINARY_FLOAT or BINARY_DOUBLE."))
    }
    let us = try localUs(&vs[0], z)
    let org = try localUs(&vs[2], z)
    let r = try bucketOf(us, months, width, org, end)
    return Ok(sameKind(&vs[0], r, z))
}

// An ISO 8601 duration (P1Y2M, P3DT4H5M6.5S, PT15M) as an interval; None for another text.
fn isoDuration(s0: &str): Option[lexdb_time.Ival] {
    let s = strings.toUpperAscii(&strings.trim(s0))
    if len(s) < 2 || s[0] != 'P' { return None }
    var iv = lexdb_time.Ival{months: 0, days: 0, us: 0}
    var i = 1
    var inTime = false
    var any = false
    while i < len(s) {
        if s[i] == 'T' {
            inTime = true
            i += 1
            continue
        }
        var j = i
        while j < len(s) && ((s[j] >= '0' && s[j] <= '9') || s[j] == '.') { j += 1 }
        if j == i || j >= len(s) { return None }
        let num = match Decimal.parse(&(s[i..j].toStr())) {
            Ok(d) { d }
            Err(_) { return None }
        }
        let whole = num.toInt(Rounding.TOWARD_ZERO).unwrapOr(0)
        let u = s[j]
        if !inTime && u == 'Y' { iv.months += 12 * whole }
        else if !inTime && u == 'M' { iv.months += whole }
        else if !inTime && u == 'W' { iv.days += 7 * whole }
        else if !inTime && u == 'D' { iv.days += whole }
        else if inTime && u == 'H' { iv.us += whole * 3600000000 }
        else if inTime && u == 'M' { iv.us += whole * 60000000 }
        else if inTime && u == 'S' {
            match num.mulExact(Decimal.fromInt(1000000)) {
                Ok(x) { iv.us += x.toInt(Rounding.TOWARD_ZERO).unwrapOr(0) }
                Err(_) { return None }
            }
        } else { return None }
        any = true
        i = j + 1
    }
    return if any { Some(iv) } else { None }
}

// ---- UUIDs

const UNIX_US = 946684800000000            // microseconds from 1970 to 2000

extern "c" fn getrandom(buf: mut &[byte], n: int, flags: u32): int

fn randomBytes(n: int): Result[[]byte, DbErr] {
    var b = array(n, byte(0))
    if getrandom(mut &b, n, u32(0)) != n { return Err(e("58000", "could not generate random values")) }
    return Ok(b)
}

fn uuid4Bytes(): Result[[]byte, DbErr] {
    var b = try randomBytes(16)
    b[6] = byte((int(b[6]) & 0x0f) | 0x40)
    b[8] = byte((int(b[8]) & 0x3f) | 0x80)
    return Ok(b)
}

fn uuid4Fn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    return Ok(Val.Uuid(lexdb_rows.uuidText(&strFromBytes(&(try uuid4Bytes())))))
}

// uuidv7([shift]): version 7, the clock's milliseconds (moved by shift) and, as PostgreSQL's, the sub-millisecond part in
// the next 12 bits (rand_a), the rest random.
fn uuid7Fn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    var us = lexdb_time.nowTstz()
    if len(vs) == 1 {
        if isNull(&vs[0]) { return Ok(Val.Null) }
        match vs[0] {
            Val.Ival(iv) { us = try lexdb_time.tstzPlus(us, &iv, z) }
            else { return Err(e("42883", "function uuidv7 needs an interval")) }
        }
    }
    let unixUs = us + UNIX_US
    // its 48 + 12 bits of time above the last one made (several in a microsecond, a clock gone back)
    var at = floorDiv(unixUs, 1000) * 4096 + (floorMod(unixUs, 1000) * 4096) / 1000
    if len(vs) == 0 {
        if at <= LAST_V7 { at = LAST_V7 + 1 }
        LAST_V7 = at
    }
    let ms = at >> 12
    let sub = at & 4095
    var b = try randomBytes(16)
    for k in 0..6 { b[k] = byte((ms >> (8 * (5 - k))) & 255) }
    b[6] = byte(0x70 | ((sub >> 8) & 0x0f))
    b[7] = byte(sub & 255)
    b[8] = byte((int(b[8]) & 0x3f) | 0x80)
    return Ok(Val.Uuid(lexdb_rows.uuidText(&strFromBytes(&b))))
}

// The time bits (48 + 12) of the last uuidv7() made.
var LAST_V7: int = 0

fn uuidRaw(v: &Val): Option[str] {
    match v {
        Val.Uuid(u) { return Some(lexdb_rows.uuidBytes(&u)) }
        else {
            match lexdb_ops.coerce(v.clone(), &lexdb_sql.oidType(lexdb_sql.OID_UUID)) {
                Ok(x) { match x { Val.Uuid(u) { return Some(lexdb_rows.uuidBytes(&u)) } else { return None } } }
                Err(_) { return None }
            }
        }
    }
}

// The version of an RFC 9562 UUID (variant 10), NULL else.
fn uuidVersionFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    let b = try uuidOf(&vs[0])
    if (int(b[8]) & 0xc0) != 0x80 { return Ok(Val.Null) }
    return Ok(Val.Int((int(b[6]) >> 4) & 15))
}

fn uuidOf(v: &Val): Result[str, DbErr] {
    match uuidRaw(v) {
        Some(b) { return Ok(b) }
        None { return Err(e("42883", "function needs a uuid")) }
    }
}

// The time of a version 1 or 7 UUID, NULL for another.
fn uuidStampFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    let b = try uuidOf(&vs[0])
    if (int(b[8]) & 0xc0) != 0x80 { return Ok(Val.Null) }
    let ver = (int(b[6]) >> 4) & 15
    if ver == 7 {
        var ms = 0
        for k in 0..6 { ms = (ms << 8) | int(b[k]) }
        return Ok(Val.Tstz(ms * 1000 - UNIX_US))
    }
    if ver == 1 {
        // 100 ns ticks since 1582-10-15: time_low, time_mid, time_hi
        var lo = 0
        for k in 0..4 { lo = (lo << 8) | int(b[k]) }
        let mid = (int(b[4]) << 8) | int(b[5])
        let hi = ((int(b[6]) & 0x0f) << 8) | int(b[7])
        let ticks = (hi << 48) | (mid << 32) | lo
        let unixUs = ticks / 10 - 12219292800000000
        return Ok(Val.Tstz(unixUs - UNIX_US))
    }
    return Ok(Val.Null)
}

// Oracle's UUID(): a version 4 UUID's 16 bytes (RAW).
fn oUuidFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if len(vs) > 0 { return Err(ora(909, "invalid number of arguments")) }
    return Ok(Val.Bytes(strFromBytes(&(try uuid4Bytes()))))
}

fn hexVal(c: byte): int {
    if c >= '0' && c <= '9' { return int(c - '0') }
    if c >= 'a' && c <= 'f' { return int(c - 'a') + 10 }
    if c >= 'A' && c <= 'F' { return int(c - 'A') + 10 }
    return -1
}

// A UUID's text as Oracle reads one: 32 hex digits, or 36 with the four hyphens; its 16 bytes. Loose (UUID_TO_RAW's):
// the hyphens anywhere, fewer digits read as the low ones.
fn oUuidText(s: &str, loose: bool): Option[str] {
    var hex = ""
    if loose {
        for i in 0..len(s) { if s[i] != '-' { hex.addByte(s[i]) } }
        if len(hex) == 0 || len(hex) > 32 { return None }
        while len(hex) < 32 { hex = "0" + hex }
    } else if len(s) == 36 {
        for i in 0..36 {
            if i == 8 || i == 13 || i == 18 || i == 23 {
                if s[i] != '-' { return None }
            } else { hex.addByte(s[i]) }
        }
    } else if len(s) == 32 { hex = s.clone() } else { return None }
    var out: []byte = []
    var i = 0
    while i < 32 {
        let h = hexVal(hex[i])
        let l = hexVal(hex[i + 1])
        if h < 0 || l < 0 { return None }
        append(mut &out, byte(h * 16 + l))
        i += 2
    }
    return Some(strFromBytes(&out))
}

fn oIsUuidFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    return Ok(Val.Bool(oUuidText(&lexdb_sql.text(&vs[0]), false).isSome()))
}

// RAW_TO_UUID(raw): its 36-character text; UUID_TO_RAW(text): its 16 bytes.
fn oRawToUuidFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    match vs[0] {
        Val.Bytes(b) {
            if len(b) != 16 { return Err(ora(62432, " is not a valid UUID value.")) }
            return Ok(Val.Text(lexdb_rows.uuidText(&b)))
        }
        else { return Err(ora(62432, " is not a valid UUID value.")) }
    }
}

fn oUuidToRawFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    let t = lexdb_sql.text(&vs[0])
    match oUuidText(&t, true) {
        Some(b) { return Ok(Val.Bytes(b)) }
        None { return Err(ora(62432, &(t + " is not a valid UUID value."))) }
    }
}

// ---- BASE64 (SQL Server 2025)

const B64URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// Base64 of b, url-safe (- and _, no padding) or standard.
pub fn b64(b: &str, url: bool): str {
    let std = base64.encode(b)
    if !url { return std }
    var out = ""
    for i in 0..len(std) {
        let c = std[i]
        if c == '=' { break }
        out.addByte(if c == '+' { '-' } else if c == '/' { '_' } else { c })
    }
    return out
}

fn b64Val(c: byte): int {
    if c >= 'A' && c <= 'Z' { return int(c - 'A') }
    if c >= 'a' && c <= 'z' { return int(c - 'a') + 26 }
    if c >= '0' && c <= '9' { return int(c - '0') + 52 }
    if c == '+' || c == '-' { return 62 }
    if c == '/' || c == '_' { return 63 }
    return -1
}

// SQL Server's BASE64_DECODE: either alphabet, white space skipped, the padding optional but whole when given; None for
// text it refuses.
fn b64Lenient(s: &str): Option[str] {
    var vals: []int = []
    var pad = 0
    for i in 0..len(s) {
        let c = s[i]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' { continue }
        if c == '=' {
            pad += 1
            continue
        }
        if pad > 0 { return None }
        let v = b64Val(c)
        if v < 0 { return None }
        append(mut &vals, v)
    }
    let rem = len(vals) % 4
    if rem == 1 { return None }
    if pad > 2 || (pad > 0 && rem == 0) { return None }
    var out: []byte = []
    var acc = 0
    var bits = 0
    for v in vals {
        acc = ((acc << 6) | v) & 0xffffff
        bits += 6
        if bits >= 8 {
            bits -= 8
            append(mut &out, byte((acc >> bits) & 255))
        }
    }
    return Some(strFromBytes(&out))
}

fn tB64EncFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    let a = argsOf(vs)
    let fname = "base64_encode"
    if a.n < 1 || a.n > 2 { return Err(e("TS174", "The base64_encode function requires 1 to 2 arguments.")) }
    let o = if a.oids[0] != 0 { a.oids[0] } else { oidOfVal(&vs[0]) }
    if o != lexdb_sql.OID_BYTEA && !(o == 0 || o == lexdb_sql.OID_UNKNOWN) { return Err(badArg(&a, vs, 0, &fname)) }
    if isNull(&vs[0]) { return Ok(Val.Null) }
    var url = false
    if a.n > 1 && !isNull(&vs[1]) { url = lexdb_ops.intOf(&vs[1]).unwrapOr(0) != 0 }
    match vs[0] {
        Val.Bytes(b) { return Ok(Val.Text(b64(&b, url))) }
        else { return Err(badArg(&a, vs, 0, &fname)) }
    }
}

fn tB64DecFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    let a = argsOf(vs)
    let fname = "base64_decode"
    if a.n != 1 { return Err(e("TS174", "The base64_decode function requires 1 argument(s).")) }
    let o = if a.oids[0] != 0 { a.oids[0] } else { oidOfVal(&vs[0]) }
    if !(o == lexdb_sql.OID_TEXT || o == lexdb_sql.OID_VARCHAR || o == lexdb_sql.OID_BPCHAR || o == lexdb_sql.OID_UNKNOWN || o == 0) {
        return Err(badArg(&a, vs, 0, &fname))
    }
    if isNull(&vs[0]) { return Ok(Val.Null) }
    match b64Lenient(&lexdb_sql.text(&vs[0])) {
        Some(b) { return Ok(Val.Bytes(b)) }
        None { return Err(e("TS9803", "Invalid data for type \"Base64Decode\".")) }
    }
}

// PostgreSQL 19's decode(t, 'base64url'): either alphabet, white space skipped, no padding.
pub fn unb64url(t: &str): Result[str, DbErr] {
    var out: []byte = []
    var acc = 0
    var bits = 0
    var n = 0
    for i in 0..len(t) {
        let c = t[i]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' { continue }
        if c == '=' { return Err(e("22023", "unexpected \"=\" while decoding base64url sequence")) }
        let v = b64Val(c)
        if v < 0 { return Err(e("22023", &("invalid symbol \"" + t[i..i + 1] + "\" found while decoding base64url sequence"))) }
        acc = ((acc << 6) | v) & 0xffffff
        bits += 6
        n += 1
        if bits >= 8 {
            bits -= 8
            append(mut &out, byte((acc >> bits) & 255))
        }
    }
    if n % 4 == 1 { return Err(e("22023", "invalid base64url end sequence")) }
    return Ok(strFromBytes(&out))
}

const B32HEX = "0123456789ABCDEFGHIJKLMNOPQRSTUV"

// encode(b, 'base32hex'): RFC 4648's extended hex alphabet, padded with "=".
pub fn b32hex(b: &str): str {
    var out = ""
    var acc = 0
    var bits = 0
    for i in 0..len(b) {
        acc = ((acc << 8) | int(b[i])) & 0xffff
        bits += 8
        while bits >= 5 {
            bits -= 5
            out.addByte(B32HEX[(acc >> bits) & 31])
        }
    }
    if bits > 0 { out.addByte(B32HEX[(acc << (5 - bits)) & 31]) }
    while len(out) % 8 != 0 { out.addByte('=') }
    return out
}

// decode(t, 'base32hex'): either case, the padding optional, the bits left over dropped.
pub fn unb32hex(t: &str): Result[str, DbErr] {
    var out: []byte = []
    var acc = 0
    var bits = 0
    var pad = false
    for i in 0..len(t) {
        let c = t[i]
        if c == '=' {
            pad = true
            continue
        }
        var v = -1
        if c >= '0' && c <= '9' { v = int(c - '0') }
        else if c >= 'A' && c <= 'V' { v = int(c - 'A') + 10 }
        else if c >= 'a' && c <= 'v' { v = int(c - 'a') + 10 }
        if v < 0 || pad { return Err(e("22023", &("invalid symbol \"" + t[i..i + 1] + "\" found while decoding base32hex sequence"))) }
        acc = ((acc << 5) | v) & 0xffff
        bits += 5
        if bits >= 8 {
            bits -= 8
            append(mut &out, byte((acc >> bits) & 255))
        }
    }
    return Ok(strFromBytes(&out))
}

// ---- UNISTR: a text's Unicode escapes (each door's own rules)

pub const UNI_PG = 0
pub const UNI_TSQL = 1
pub const UNI_ORA = 2

fn hexRun(rs: &[]int, at: int, n: int): int {
    if at + n > len(rs) { return -1 }
    var v = 0
    for k in 0..n {
        let r = rs[at + k]
        if r > 127 { return -1 }
        let h = hexVal(byte(r))
        if h < 0 { return -1 }
        v = v * 16 + h
    }
    return v
}

// s with its escapes made characters: \XXXX and \\ everywhere; \+XXXXXX in PostgreSQL and T-SQL; \uXXXX and \UXXXXXXXX in
// PostgreSQL; a surrogate pair one character. None: an escape the door refuses (the caller's error).
fn unistr(s: &str, esc: int, dia: int): Option[str] {
    let rs = strings.runes(s)
    var out: []int = []
    var i = 0
    while i < len(rs) {
        let r = rs[i]
        if r != esc {
            append(mut &out, r)
            i += 1
            continue
        }
        if i + 1 < len(rs) && rs[i + 1] == esc {
            append(mut &out, esc)
            i += 2
            continue
        }
        var cp = -1
        var used = 0
        if i + 1 < len(rs) && rs[i + 1] == int('+') && dia != UNI_ORA {
            cp = hexRun(&rs, i + 2, 6)
            used = 8
        } else if dia == UNI_PG && i + 1 < len(rs) && rs[i + 1] == int('u') {
            cp = hexRun(&rs, i + 2, 4)
            used = 6
        } else if dia == UNI_PG && i + 1 < len(rs) && rs[i + 1] == int('U') {
            cp = hexRun(&rs, i + 2, 8)
            used = 10
        } else {
            cp = hexRun(&rs, i + 1, 4)
            used = 5
        }
        if cp < 0 || cp > 0x10ffff { return None }
        if cp >= 0xd800 && cp <= 0xdbff {
            // a high surrogate: its low one must follow, escaped
            let j = i + used
            if j + 4 < len(rs) + 0 && rs[j] == esc {
                let lo = hexRun(&rs, j + 1, 4)
                if lo >= 0xdc00 && lo <= 0xdfff {
                    append(mut &out, 0x10000 + ((cp - 0xd800) << 10) + (lo - 0xdc00))
                    i = j + 5
                    continue
                }
            }
            return None
        }
        if cp >= 0xdc00 && cp <= 0xdfff { return None }
        append(mut &out, cp)
        i += used
    }
    return Some(strings.fromRunes(&out))
}

// PostgreSQL's unistr: a bad or incomplete escape, or a surrogate alone, 42601; a code point past U+10FFFF 22023.
fn pgUnistrFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    let s = lexdb_sql.text(&vs[0])
    match unistr(&s, int('\\'), UNI_PG) {
        Some(r) { return Ok(Val.Text(r)) }
        None {
            // (past U+10FFFF: a well-formed escape of a code point too big)
            if tooBig(&s) {
                return Err(e("22023", "invalid Unicode code point"))
            }
            return Err(e("42601", "invalid Unicode escape"))
        }
    }
}

// Whether s has a well-formed \+XXXXXX or \UXXXXXXXX escape of a code point past U+10FFFF.
fn tooBig(s: &str): bool {
    let rs = strings.runes(s)
    for i in 0..len(rs) {
        if rs[i] == int('\\') && i + 1 < len(rs) {
            if rs[i + 1] == int('+') && hexRun(&rs, i + 2, 6) > 0x10ffff { return true }
            if rs[i + 1] == int('U') && hexRun(&rs, i + 2, 8) > 0x10ffff { return true }
        }
    }
    return false
}

// T-SQL UNISTR(s [, escape]).
fn tUnistrFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    let a = argsOf(vs)
    let fname = "unistr"
    if a.n < 1 || a.n > 2 { return Err(e("TS174", "The unistr function requires 1 to 2 arguments.")) }
    for k in 0..a.n {
        let o = if a.oids[k] != 0 { a.oids[k] } else { oidOfVal(&vs[k]) }
        if !(o == lexdb_sql.OID_TEXT || o == lexdb_sql.OID_VARCHAR || o == lexdb_sql.OID_BPCHAR || o == lexdb_sql.OID_UNKNOWN || o == 0) {
            return Err(badArg(&a, vs, k, &fname))
        }
    }
    var esc = int('\\')
    if a.n > 1 {
        if isNull(&vs[1]) { return Ok(Val.Null) }
        let er = strings.runes(&lexdb_sql.text(&vs[1]))
        if len(er) != 1 || er[0] < 0x20 || er[0] > 0x7e {
            return Err(e("TS9843", &("Unicode escape character '" + lexdb_sql.text(&vs[1]) + "' is invalid. Unicode escape character should be of 1 character length and a code point ranging from U+0020 up to U+007E.")))
        }
        let c = er[0]
        if c == int('+') || c == int('\'') || c == int('"') || c == int(' ') || hexVal(byte(c)) >= 0 {
            return Err(e("TS9842", "Invalid Unicode escape character was provided. The <UESCAPE character> cannot be <plus sign> <single quote> <double quotes> <space> <hexit>."))
        }
        esc = c
    }
    if isNull(&vs[0]) { return Ok(Val.Null) }
    match unistr(&lexdb_sql.text(&vs[0]), esc, UNI_TSQL) {
        Some(s) { return Ok(Val.Text(s)) }
        None { return Err(e("TS9841", "An invalid Unicode escape sequence was specified in the input. Unicode escape sequences should be specified as <UESCAPE character>XXXX or <UESCAPE character>+XXXXXX where X is a <hexit>.")) }
    }
}

fn oUnistrFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if len(vs) != 1 { return Err(ora(909, "invalid number of arguments")) }
    if isNull(&vs[0]) { return Ok(Val.Null) }
    match unistr(&lexdb_sql.text(&vs[0]), int('\\'), UNI_ORA) {
        Some(s) { return Ok(if len(s) == 0 { Val.Null } else { Val.Text(s) }) }
        None { return Err(ora(30186, "'\\' must be followed by four hexdecimal characters or another '\\'")) }
    }
}

// ---- Oracle's TO_BOOLEAN (23ai)

fn oToBoolFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if len(vs) != 1 { return Err(ora(909, "invalid number of arguments")) }
    match vs[0] {
        Val.Null { return Ok(Val.Null) }
        Val.Bool(b) { return Ok(Val.Bool(b)) }
        Val.Int(x) { return Ok(Val.Bool(x != 0)) }
        Val.Num(d) { return Ok(Val.Bool(!d.isZero())) }
        Val.Float(f) { return Ok(Val.Bool(f != 0.0f)) }
        Val.Real(f) { return Ok(Val.Bool(f != 0.0f)) }
        Val.Text(s) {
            let w = strings.toLowerAscii(&strings.trim(&s))
            if w == "true" || w == "yes" || w == "on" || w == "t" || w == "y" || w == "1" { return Ok(Val.Bool(true)) }
            if w == "false" || w == "no" || w == "off" || w == "f" || w == "n" || w == "0" { return Ok(Val.Bool(false)) }
            return Err(ora(61800, &("invalid boolean literal: " + s)))
        }
        else { return Err(ora(932, "inconsistent datatypes: expected CHAR got DATE")) }
    }
}

// ---- edit distance and Jaro-Winkler (SQL Server 2025's fuzzy matching, Oracle's UTL_MATCH)

// The edit distance of a and b (characters): Levenshtein's (Oracle's), or with swap the optimal string alignment distance,
// two adjacent characters swapped one edit (SQL Server's: martha, marhta 1); max the most it counts to (-1: no limit):
// max + 1 past it.
pub fn editDistance(a: &[]int, b: &[]int, max: int, swap: bool): int {
    let n = len(a)
    let m = len(b)
    if n == 0 { return if max >= 0 && m > max { max + 1 } else { m } }
    if m == 0 { return if max >= 0 && n > max { max + 1 } else { n } }
    var pp = array(m + 1, 0)
    var prev = array(m + 1, 0)
    var cur = array(m + 1, 0)
    for j in 0..m + 1 { prev[j] = j }
    for i in 1..n + 1 {
        cur[0] = i
        for j in 1..m + 1 {
            let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            var v = prev[j - 1] + cost
            if prev[j] + 1 < v { v = prev[j] + 1 }
            if cur[j - 1] + 1 < v { v = cur[j - 1] + 1 }
            if swap && i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] && pp[j - 2] + 1 < v { v = pp[j - 2] + 1 }
            cur[j] = v
        }
        for j in 0..m + 1 {
            pp[j] = prev[j]
            prev[j] = cur[j]
        }
    }
    let d = prev[m]
    return if max >= 0 && d > max { max + 1 } else { d }
}

// The Jaro-Winkler similarity of a and b (0 to 1): Jaro's matches within half the longer length less one, half the
// transpositions, then the common prefix of up to 4 characters at 0.1.
pub fn jaroWinkler(a: &[]int, b: &[]int, third: bool): float {
    let n = len(a)
    let m = len(b)
    if n == 0 && m == 0 { return 1.0f }
    if n == 0 || m == 0 { return 0.0f }
    var w = (if n > m { n } else { m }) / 2 - 1
    if w < 0 { w = 0 }
    var am = array(n, false)
    var bm = array(m, false)
    var matches = 0
    for i in 0..n {
        let lo = if i - w > 0 { i - w } else { 0 }
        let hi = if i + w + 1 < m { i + w + 1 } else { m }
        for j in lo..hi {
            if !bm[j] && a[i] == b[j] {
                am[i] = true
                bm[j] = true
                matches += 1
                break
            }
        }
    }
    if matches == 0 { return 0.0f }
    var t = 0
    var k = 0
    for i in 0..n {
        if am[i] {
            while !bm[k] { k += 1 }
            if a[i] != b[k] { t += 1 }
            k += 1
        }
    }
    let mf = float(matches)
    let sum = mf / float(n) + mf / float(m) + (mf - float(t / 2)) / mf
    // (SQL Server's the sum over 3, Oracle's the sum times a third: their last digits)
    let jaro = if third { (1.0f / 3.0f) * sum } else { sum / 3.0f }
    var l = 0
    while l < 4 && l < n && l < m && a[l] == b[l] { l += 1 }
    return jaro + float(l) * 0.1f * (1.0f - jaro)
}

fn maxLen(a: &[]int, b: &[]int): int { return if len(a) > len(b) { len(a) } else { len(b) } }

// T-SQL's four: their arguments strings (a case-insensitive collation's folded by the binder), EDIT_DISTANCE's maximum.
fn tFuzzyFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    let a = argsOf(vs)
    let fname = if name == "#n_tedit" { "edit_distance" } else if name == "#n_teditsim" { "edit_distance_similarity" }
                else if name == "#n_tjwd" { "jaro_winkler_distance" } else { "jaro_winkler_similarity" }
    for k in 0..2 {
        if k < a.n {
            let o = if a.oids[k] != 0 { a.oids[k] } else { oidOfVal(&vs[k]) }
            if !(o == lexdb_sql.OID_TEXT || o == lexdb_sql.OID_VARCHAR || o == lexdb_sql.OID_BPCHAR || o == lexdb_sql.OID_UNKNOWN || o == 0) {
                return Err(badArg(&a, vs, k, &fname))
            }
        }
    }
    for k in 0..a.n { if isNull(&vs[k]) { return Ok(Val.Null) } }
    let x = strings.runes(&lexdb_sql.text(&vs[0]))
    let y = strings.runes(&lexdb_sql.text(&vs[1]))
    if name == "#n_tedit" {
        let max = if a.n > 2 { lexdb_ops.intOf(&vs[2]).unwrapOr(-1) } else { -1 }
        return Ok(Val.Int(editDistance(&x, &y, max, true)))
    }
    if name == "#n_teditsim" {
        let ml = maxLen(&x, &y)
        if ml == 0 { return Ok(Val.Int(100)) }
        let d = editDistance(&x, &y, -1, true)
        return Ok(Val.Int(roundHalf(100.0f * (1.0f - float(d) / float(ml)))))
    }
    let jw = jaroWinkler(&x, &y, false)
    if name == "#n_tjwd" { return Ok(Val.Float(1.0f - jw)) }
    return Ok(Val.Int(roundHalf(jw * 100.0f)))
}

fn roundHalf(f: float): int { return int((f + 0.5f).floor()) }

// Oracle's UTL_MATCH: EDIT_DISTANCE (Levenshtein's; -1 when either is NULL, which '' is), EDIT_DISTANCE_SIMILARITY (100
// less the distance's share of the longer, cut; 100 for two NULLs), JARO_WINKLER (a BINARY_DOUBLE; 0 with a NULL) and
// JARO_WINKLER_SIMILARITY (its hundredths, cut); case-sensitive.
fn oFuzzyFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if len(vs) != 2 { return Err(ora(6553, "PLS-306: wrong number or types of arguments in call")) }
    let none: []int = []
    let x = if isNull(&vs[0]) { none.clone() } else { strings.runes(&lexdb_sql.text(&vs[0])) }
    let y = if isNull(&vs[1]) { none.clone() } else { strings.runes(&lexdb_sql.text(&vs[1])) }
    if name == "#n_oedit" {
        if len(x) == 0 || len(y) == 0 { return Ok(Val.Num(Decimal.fromInt(-1))) }
        return Ok(Val.Num(Decimal.fromInt(editDistance(&x, &y, -1, false))))
    }
    if name == "#n_oeditsim" {
        let ml = maxLen(&x, &y)
        if ml == 0 { return Ok(Val.Num(Decimal.fromInt(100))) }
        let d = editDistance(&x, &y, -1, false)
        return Ok(Val.Num(Decimal.fromInt(100 - (d * 100) / ml)))
    }
    let jw = if len(x) == 0 || len(y) == 0 { 0.0f } else { jaroWinkler(&x, &y, true) }
    if name == "#n_ojw" { return Ok(Val.Float(jw)) }
    return Ok(Val.Num(Decimal.fromInt(int((jw * 100.0f).floor()))))
}

// ---- PostgreSQL's smaller ones (16 to 19: P9, P14, P23)

// error_on_null(x): x, or 22004 for a NULL (19).
fn errorOnNullFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Err(e("22004", "null value not allowed")) }
    return Ok(vs[0].clone())
}

// to_bin(n), to_oct(n) (17): an integer's digits, a negative one's two's complement as wide as its type (the hint).
fn toBaseFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    let a = argsOf(vs)
    if a.n != 1 { return Err(e("42883", &("function " + name + " with " + a.n.toStr() + " arguments does not exist"))) }
    if isNull(&vs[0]) { return Ok(Val.Null) }
    let x = match lexdb_ops.intOf(&vs[0]) {
        Some(i) { i }
        None { return Err(e("42883", &("function " + name + " needs an integer"))) }
    }
    let bits = if a.oids[0] == lexdb_sql.OID_INT8 || (a.oids[0] == 0 && (x < -2147483648 || x > 2147483647)) { 64 } else { 32 }
    let shift = if name == "to_bin" { 1 } else { 3 }
    // the value's bits as an unsigned number of that width, most significant digit first (a 32-bit one's high bits cut)
    let v = if bits == 32 { x & 0xffffffff } else { x }
    var out = ""
    var k = (bits + shift - 1) / shift - 1
    var lead = true
    while k >= 0 {
        let at = k * shift
        let take = if bits - at < shift { bits - at } else { shift }
        let d = (v >> at) & ((1 << take) - 1)
        if d != 0 || !lead || k == 0 {
            out.addByte(byte(int('0') + d))
            lead = false
        }
        k -= 1
    }
    return Ok(Val.Text(out))
}

// bit_count(bytea) (14): its bits set.
fn bitCountFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    match vs[0] {
        Val.Bytes(b) {
            var c = 0
            for i in 0..len(b) {
                var x = int(b[i])
                while x > 0 {
                    c += x & 1
                    x = x >> 1
                }
            }
            return Ok(Val.Int(c))
        }
        else { return Err(e("42883", "function bit_count needs a bytea")) }
    }
}

extern "c" fn erf(x: float): float
extern "c" fn erfc(x: float): float
extern "c" fn tgamma(x: float): float
extern "c" fn lgamma(x: float): float

// erf, erfc (16), gamma, lgamma (18): the C library's; an infinite or NaN result of a finite argument 22003.
fn mathFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    let x = match lexdb_ops.asFloat(&vs[0]) {
        Some(f) { f }
        None { return Err(e("42883", &("function " + name + " needs a number"))) }
    }
    let r = if name == "erf" { erf(x) } else if name == "erfc" { erfc(x) } else if name == "gamma" { tgamma(x) } else { lgamma(x) }
    let finite = x == x && x - x == 0.0f
    if finite && (r != r || r - r != 0.0f) { return Err(e("22003", "value out of range: overflow")) }
    if finite && r == 0.0f && name == "gamma" { return Err(e("22003", "value out of range: underflow")) }
    return Ok(Val.Float(r))
}

// crc32(bytea), crc32c(bytea) (18): the CRC-32 (IEEE) and CRC-32C of its bytes.
fn crcFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    let b = match vs[0] {
        Val.Bytes(x) { x.clone() }
        Val.Text(t) { try lexdb_ops.parseBytea(&t) }
        else { return Err(e("42883", &("function " + name + " needs a bytea"))) }
    }
    let poly = if name == "crc32" { 0xedb88320 } else { 0x82f63b78 }
    var c = 0xffffffff
    for i in 0..len(b) {
        c = c ^ int(b[i])
        for k in 0..8 { c = if (c & 1) == 1 { (c >> 1) ^ poly } else { c >> 1 } }
    }
    return Ok(Val.Int(c ^ 0xffffffff))
}

// date_add(t, interval [, zone]), date_subtract (16): the timestamptz moved by the interval in the zone (the session's).
fn dateAddFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    for v in vs { if isNull(&v) { return Ok(Val.Null) } }
    let t = match try lexdb_ops.coerce(vs[0].clone(), &lexdb_sql.oidType(lexdb_sql.OID_TSTZ)) { Val.Tstz(u) { u } else { 0 } }
    var iv = match try lexdb_ops.coerce(vs[1].clone(), &lexdb_sql.oidType(lexdb_sql.OID_IVAL)) {
        Val.Ival(v) { v }
        else { return Err(e("42883", &("function " + name + " needs an interval"))) }
    }
    if name == "date_subtract" { iv = lexdb_time.ivalNeg(&iv) }
    if len(vs) == 3 {
        let zone = try lexdb_time.atZone(&lexdb_sql.text(&vs[2]))
        return Ok(Val.Tstz(try lexdb_time.tstzPlus(t, &iv, &zone)))
    }
    return Ok(Val.Tstz(try lexdb_time.tstzPlus(t, &iv, z)))
}

// casefold(text) (18): as lower() under the default collation (PostgreSQL's for a libc collation).
fn casefoldFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    var out = ""
    for r in strings.runes(&lexdb_sql.text(&vs[0])) { strings.addRune(mut &out, unicode.lower(r)) }
    return Ok(Val.Text(out))
}

fn arrayVals(v: &Val): Result[[]Val, DbErr] {
    var out: []Val = []
    for p in try lexdb_ops.arrayParts(&lexdb_sql.text(v)) {
        match p {
            Some(t) { append(mut &out, Val.Text(t.toStr())) }
            None { append(mut &out, Val.Null) }
        }
    }
    return Ok(out)
}

// trim_array(a, n) (14): a without its last n elements (0 to its length; 2202E else).
fn trimArrayFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Val.Null) }
    let xs = try arrayVals(&vs[0])
    let n = lexdb_ops.intOf(&vs[1]).unwrapOr(-1)
    if n < 0 || n > len(xs) { return Err(e("2202E", &("number of elements to trim must be between 0 and " + len(xs).toStr()))) }
    var out: []Val = []
    for i in 0..len(xs) - n { append(mut &out, xs[i].clone()) }
    return Ok(Val.Text(lexdb_ops.arrayText(&out)))
}

fn randomBelow(n: int): Result[int, DbErr] {
    let b = try randomBytes(8)
    var x = 0
    for i in 0..7 { x = x * 256 + int(b[i]) }
    return Ok(x % n)
}

// array_reverse(a) (18), array_shuffle(a) (16): its elements reversed, shuffled.
fn arrayOrderFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    var xs = try arrayVals(&vs[0])
    let n = len(xs)
    if name == "array_reverse" {
        var out: []Val = []
        var i = n - 1
        while i >= 0 {
            append(mut &out, xs[i].clone())
            i -= 1
        }
        return Ok(Val.Text(lexdb_ops.arrayText(&out)))
    }
    var i = n - 1
    while i > 0 {
        let j = try randomBelow(i + 1)
        let t = xs[i].clone()
        xs[i] = xs[j].clone()
        xs[j] = t
        i -= 1
    }
    return Ok(Val.Text(lexdb_ops.arrayText(&xs)))
}

// array_sample(a, n) (16): n of its elements, chosen at random (0 to its length; 22023 else).
fn arraySampleFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Val.Null) }
    var xs = try arrayVals(&vs[0])
    let k = lexdb_ops.intOf(&vs[1]).unwrapOr(-1)
    if k < 0 || k > len(xs) { return Err(e("22023", "sample size must be between 0 and " + len(xs).toStr())) }
    for i in 0..k {
        let j = i + (try randomBelow(len(xs) - i))
        let t = xs[i].clone()
        xs[i] = xs[j].clone()
        xs[j] = t
    }
    var out: []Val = []
    for i in 0..k { append(mut &out, xs[i].clone()) }
    return Ok(Val.Text(lexdb_ops.arrayText(&out)))
}

// random(min, max) (17): an integer or a numeric (the larger scale of the two) from min to max (22023 when min > max).
fn randomRangeFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) || isNull(&vs[1]) { return Ok(Val.Null) }
    match vs[0] {
        Val.Int(lo) {
            match vs[1] {
                Val.Int(hi) {
                    if lo > hi { return Err(e("22023", "lower bound must be less than or equal to upper bound")) }
                    let span = hi - lo + 1
                    if span <= 0 { return Ok(Val.Int(lo + (try randomBelow(0x7fffffffffffffff)))) }
                    return Ok(Val.Int(lo + (try randomBelow(span))))
                }
                else {}
            }
        }
        else {}
    }
    let a = lexdb_ops.asNum(&vs[0]).unwrapOr(Decimal.zero())
    let b = lexdb_ops.asNum(&vs[1]).unwrapOr(Decimal.zero())
    if a.cmp(&b) > 0 { return Err(e("22023", "lower bound must be less than or equal to upper bound")) }
    let sc = if a.scale() > b.scale() { a.scale() } else { b.scale() }
    // (the bounds as whole units of that scale)
    let unit = Decimal.fromUnits(1, sc)
    let la = a.div(unit, 0, Rounding.HALF_EVEN).unwrapOr(Decimal.zero()).toInt(Rounding.TOWARD_ZERO).unwrapOr(0)
    let lb = b.div(unit, 0, Rounding.HALF_EVEN).unwrapOr(Decimal.zero()).toInt(Rounding.TOWARD_ZERO).unwrapOr(0)
    let pick = la + (try randomBelow(lb - la + 1))
    return Ok(Val.Num(Decimal.fromUnits(pick, sc)))
}

// int::bytea (18): its bytes big-endian, as many as its type's width (the binder's second argument).
fn intBytesFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    let x = lexdb_ops.intOf(&vs[0]).unwrapOr(0)
    let w = lexdb_ops.intOf(&vs[1]).unwrapOr(8)
    var out: []byte = []
    var k = w - 1
    while k >= 0 {
        append(mut &out, byte((x >> (8 * k)) & 255))
        k -= 1
    }
    return Ok(Val.Bytes(strFromBytes(&out)))
}

// ---- Oracle 23ai's CEIL, FLOOR and ROUND of a DATE, a TIMESTAMP (made a DATE first) and an INTERVAL

const OR_CEIL = 0
const OR_FLOOR = 1
const OR_ROUND = 2

fn oRoundFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if len(vs) < 1 || len(vs) > 2 { return Err(ora(909, "invalid number of arguments")) }
    for v in vs { if isNull(&v) { return Ok(Val.Null) } }
    let how = if name == "#n_oceil" { OR_CEIL } else if name == "#n_ofloor" { OR_FLOOR } else { OR_ROUND }
    match vs[0] {
        // (a number's, where no binder chose lexdb's own: PL/SQL's expressions)
        Val.Int(x) { return Ok(Val.Int(x)) }
        Val.Num(d) {
            let places = if len(vs) > 1 && how == OR_ROUND { lexdb_ops.intOf(&vs[1]).unwrapOr(0) } else { 0 }
            let mode = if how == OR_CEIL { Rounding.CEILING } else if how == OR_FLOOR { Rounding.FLOOR } else { Rounding.HALF_AWAY }
            match d.quantize(places, mode) {
                Ok(q) { return Ok(Val.Num(q)) }
                Err(_) { return Err(ora(1426, "numeric overflow")) }
            }
        }
        Val.Float(f) { return Ok(Val.Float(if how == OR_CEIL { f.ceil() } else if how == OR_FLOOR { f.floor() } else { (f + (if f < 0.0f { -0.5f } else { 0.5f })).trunc() })) }
        Val.Ival(iv) {
            let fmt = if len(vs) > 1 { strings.toUpperAscii(&strings.trim(&lexdb_sql.text(&vs[1]))) } else if iv.months != 0 { "YEAR" } else { "DD" }
            return Ok(Val.Ival(try ivalRound(&iv, &fmt, how)))
        }
        else {}
    }
    // (to the second: a DATE)
    let us = floorDiv(try localUs(&vs[0], z), 1000000) * 1000000
    let fmt = if len(vs) > 1 { strings.toUpperAscii(&strings.trim(&lexdb_sql.text(&vs[1]))) } else { "DD" }
    // (ROUND's error for a format it does not take is ORA-01899, CEIL's and FLOOR's ORA-01821)
    let lo = match oTrunc(us, &fmt) {
        Ok(x) { x }
        Err(x) { return Err(if how == OR_ROUND { ora(1899, "bad precision specifier") } else { x }) }
    }
    if how == OR_FLOOR || lo == us { return Ok(Val.Ts(lo)) }
    let hi = try oNext(lo, &fmt)
    if how == OR_CEIL { return Ok(Val.Ts(hi)) }
    let l = lexdb_time.localOf(us)
    var up = false
    match fmt.toStr() {
        "Y", "YY", "YYY", "YYYY", "YEAR", "SYEAR", "SYYYY" { up = l.date.month >= 7 }
        "Q" {
            let inq = (l.date.month - 1) % 3
            up = inq == 2 || (inq == 1 && l.date.day >= 16)
        }
        "MM", "MON", "MONTH", "RM" { up = l.date.day >= 16 }
        else { up = (us - lo) * 2 >= hi - lo }
    }
    return Ok(Val.Ts(if up { hi } else { lo }))
}

// The start of the format's unit of local time us (Oracle's TRUNC); ORA-01821 for another format.
fn oTrunc(us: int, fmt: &str): Result[int, DbErr] {
    let l = lexdb_time.localOf(us)
    let day = floorDiv(us, lexdb_time.DAY_US)
    let jan1 = lexdb_time.makeDate(l.date.year, 1, 1).unwrap()
    let dow = floorMod(day + 6, 7)          // 0 Sunday (2000-01-01 was a Saturday)
    match fmt {
        "Y", "YY", "YYY", "YYYY", "YEAR", "SYEAR", "SYYYY" { return Ok(lexdb_time.dateToTs(jan1)) }
        "Q" { return Ok(lexdb_time.dateToTs(lexdb_time.makeDate(l.date.year, ((l.date.month - 1) / 3) * 3 + 1, 1).unwrap())) }
        "MM", "MON", "MONTH", "RM" { return Ok(lexdb_time.dateToTs(lexdb_time.makeDate(l.date.year, l.date.month, 1).unwrap())) }
        "IW" { return Ok(lexdb_time.dateToTs(day - floorMod(dow + 6, 7))) }
        "WW" { return Ok(lexdb_time.dateToTs(day - floorMod(day - jan1, 7))) }
        "W" { return Ok(lexdb_time.dateToTs(day - (l.date.day - 1) % 7)) }
        "D", "DAY", "DY" { return Ok(lexdb_time.dateToTs(day - dow)) }
        "DD", "DDD", "J" { return Ok(lexdb_time.dateToTs(day)) }
        "HH", "HH12", "HH24" { return Ok(floorDiv(us, 3600000000) * 3600000000) }
        "MI" { return Ok(floorDiv(us, 60000000) * 60000000) }
        else { return Err(ora(1821, "date format not recognized")) }
    }
}

// The start of the next unit after lo (a unit's start).
fn oNext(lo: int, fmt: &str): Result[int, DbErr] {
    match fmt {
        "Y", "YY", "YYY", "YYYY", "YEAR", "SYEAR", "SYYYY" { return addMonths(lo, 12) }
        "Q" { return addMonths(lo, 3) }
        "MM", "MON", "MONTH", "RM" { return addMonths(lo, 1) }
        "IW", "WW", "W", "D", "DAY", "DY" { return Ok(lo + 7 * lexdb_time.DAY_US) }
        "DD", "DDD", "J" { return Ok(lo + lexdb_time.DAY_US) }
        "HH", "HH12", "HH24" { return Ok(lo + 3600000000) }
        else { return Ok(lo + 60000000) }
    }
}

// An interval to whole units of the format: YEAR (a YEAR TO MONTH's), DD, HH, MI (a DAY TO SECOND's); ORA-01899 for
// another. ROUND's halves away from zero.
fn ivalRound(iv: &lexdb_time.Ival, fmt: &str, how: int): Result[lexdb_time.Ival, DbErr] {
    if iv.months != 0 || ((fmt == "YEAR" || fmt == "YYYY" || fmt == "Y" || fmt == "YY" || fmt == "YYY") && iv.days == 0 && iv.us == 0) {
        if !(fmt == "YEAR" || fmt == "YYYY" || fmt == "Y" || fmt == "YY" || fmt == "YYY") { return Err(ora(1899, "bad precision specifier")) }
        return Ok(lexdb_time.Ival{months: 12 * roundUnits(iv.months, 12, how), days: 0, us: 0})
    }
    let unit = match fmt {
        "DD", "DDD", "J" { lexdb_time.DAY_US }
        "HH", "HH12", "HH24" { 3600000000 }
        "MI" { 60000000 }
        else { return Err(ora(1899, "bad precision specifier")) }
    }
    let total = iv.days * lexdb_time.DAY_US + iv.us
    let r = roundUnits(total, unit, how) * unit
    return Ok(lexdb_time.Ival{months: 0, days: r / lexdb_time.DAY_US, us: r % lexdb_time.DAY_US})
}

// x in whole units of u: up (CEIL), down (FLOOR), or the nearer, a half away from zero (ROUND).
fn roundUnits(x: int, u: int, how: int): int {
    let f = floorDiv(x, u)
    if how == OR_FLOOR || f * u == x { return f }
    if how == OR_CEIL { return f + 1 }
    let rem = x - f * u
    if rem * 2 > u { return f + 1 }
    if rem * 2 < u { return f }
    return if x > 0 { f + 1 } else { f }
}

// bytea::int (18): its bytes big-endian as an integer of the type (its width the name's), as many as its width at most
// (22003 past them), one of the whole width keeping its sign.
fn bytesIntFn(name: &str, vs: &[]Val, now: int, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if isNull(&vs[0]) { return Ok(Val.Null) }
    let w = if name == "#n_bytes2" { 2 } else if name == "#n_bytes4" { 4 } else { 8 }
    let b = match vs[0] {
        Val.Bytes(x) { x.clone() }
        else { return Err(e("42846", "cannot cast this value to an integer")) }
    }
    if len(b) > w { return Err(e("22003", &((if w == 2 { "smallint" } else if w == 4 { "integer" } else { "bigint" }) + " out of range"))) }
    var x = 0
    for i in 0..len(b) { x = (x << 8) | int(b[i]) }
    if len(b) == w && w < 8 && (int(b[0]) & 0x80) != 0 { x = x - (1 << (8 * w)) }
    return Ok(Val.Int(x))
}
