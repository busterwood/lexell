// lexdb_parse: SQL text to statements (design/lexdb.md 4.8): a lexer and a
// recursive-descent parser for the subset lexdb runs. The representation it
// builds and the text helpers it uses are lexdb_sql; the dialect facts are
// lexdb_dialect. The storage stack never imports this module.

import "strings"
import "./lexdb_base"
import "./lexdb_time"
import "./lexdb_float"
import "./lexdb_sql"
import "./lexdb_litint"
import "./lexdb_dialect"
import "./lexdb_dbopt"
import "./lexdb_match"
import "./lexdb_recur"
import "./lexdb_oldnew"
import "./lexdb_annot"

