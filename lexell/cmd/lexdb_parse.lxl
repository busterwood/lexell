pub const T_EOF = 0
pub const T_IDENT = 1        // folded to lower case
pub const T_QIDENT = 2       // "quoted"
pub const T_NUM = 3
pub const T_STR = 4
pub const T_PARAM = 5
pub const T_OP = 6
pub const T_VAR = 7          // T-SQL: @name or @@name, folded to lower case

// How SQL text is read (design/lexdb-tds.md): lexdb's own dialect, or
// T-SQL's (@variables, [quoted] names, N'...' strings, SQL Server's type
// names; with QUOTED_IDENTIFIER OFF, "..." is a string).
pub type Dialect = value record { pub tsql: bool; pub quotedIdent: bool }

pub fn pgDialect(): Dialect { return Dialect{tsql: false, quotedIdent: true} }

// A token. A name's text is folded (lexdb_sql matches names without regard
// to case, design/lexdb-tds.md L6); spell is its spelling where that differs
// from text: a quoted name's, and in T-SQL a bare name's ("" else).
pub type Tok = value record { pub kind: int; pub text: str; pub at: int; pub spell: str }

// A name's token: its text folded, its spelling kept if that differs.
fn nameTok(kind: int, raw: &str, at: int): Tok {
    let f = strings.toLowerAscii(&raw)
    return Tok{kind: kind, text: f, at: at, spell: if f == raw { "" } else { raw.clone() }}
}

fn syntax(msg: &str): lexdb_base.DbErr { return lexdb_base.err("42601", msg) }

fn isIdentStart(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c >= 128 }
fn isIdentChar(c: byte): bool { return isIdentStart(c) || (c >= '0' && c <= '9') || c == '$' }
fn isDigit(c: byte): bool { return c >= '0' && c <= '9' }

fn lex(s: &str): Result[[]Tok, lexdb_base.DbErr] { return lexIn(s, pgDialect()) }

// PostgreSQL 16's numeric literals at s[start] (scan.l): a decimal integer is digits with single _ between them; 0x, 0o
// and 0b integers (_ before any digit); a decimal and an exponent of such integers. Its text as the parser reads a
// number (decimal, no _) in text, where it ends in at; a name right after it is "trailing junk" (42601).
fn pgNumber(s: &str, start: int): Result[Tok, lexdb_base.DbErr] {
    let n = len(s)
    var i = start
    var b = ""
    if s[i] == '0' && i + 1 < n && (s[i + 1] == 'x' || s[i + 1] == 'X' || s[i + 1] == 'o' || s[i + 1] == 'O' || s[i + 1] == 'b' || s[i + 1] == 'B') {
        let x = s[i + 1]
        let base = if x == 'x' || x == 'X' { 16 } else if x == 'o' || x == 'O' { 8 } else { 2 }
        i += 2
        var ds: []int = []
        while i < n {
            var j = i
            if s[j] == '_' { j += 1 }
            if j >= n || !isHexDigit(s[j]) || hexDigit(s[j]) >= base { break }
            append(mut &ds, hexDigit(s[j]))
            i = j + 1
        }
        let what = if base == 16 { "hexadecimal" } else if base == 8 { "octal" } else { "binary" }
        if len(ds) == 0 { return Err(syntax(&("invalid " + what + " integer at or near \"" + s[start..min(i, n)] + "\""))) }
        if i < n && isIdentChar(s[i]) { return Err(syntax(&("trailing junk after numeric literal at or near \"" + s[start..i + 1] + "\""))) }
        return Ok(Tok{kind: T_NUM, text: digitsIn(&ds, base), at: i, spell: ""})
    }
    i = pgDigits(s, i, mut &b)
    if i < n && s[i] == '.' {
        b.addByte('.')
        i = pgDigits(s, i + 1, mut &b)
    }
    if i < n && (s[i] == 'e' || s[i] == 'E') {
        var j = i + 1
        var sign = ""
        if j < n && (s[j] == '+' || s[j] == '-') {
            sign = s[j..j + 1].toStr()
            j += 1
        }
        if j < n && isDigit(s[j]) {
            b += "e" + sign
            i = pgDigits(s, j, mut &b)
        }
    }
    if i < n && isIdentChar(s[i]) { return Err(syntax(&("trailing junk after numeric literal at or near \"" + s[start..i + 1] + "\""))) }
    return Ok(Tok{kind: T_NUM, text: b, at: i, spell: ""})
}

// Digits from s[i] with single _ between them, added to b (without the _); where they end.
fn pgDigits(s: &str, i0: int, b: mut &str): int {
    let n = len(s)
    var i = i0
    while i < n && isDigit(s[i]) {
        b.addByte(s[i])
        i += 1
        if i + 1 < n && s[i] == '_' && isDigit(s[i + 1]) { i += 1 }
    }
    return i
}

// Digits of a base (most significant first) as a decimal number's text, of any length.
fn digitsIn(ds: &[]int, base: int): str {
    var dec: []int = [0]          // least significant first
    for d in ds {
        var carry = d
        for k in 0..len(dec) {
            let v = dec[k] * base + carry
            dec[k] = v % 10
            carry = v / 10
        }
        while carry > 0 {
            append(mut &dec, carry % 10)
            carry = carry / 10
        }
    }
    var out = ""
    var k = len(dec) - 1
    while k > 0 && dec[k] == 0 { k -= 1 }
    while k >= 0 {
        out.addByte(byte(48 + dec[k]))
        k -= 1
    }
    return out
}

// PostgreSQL 16's integer input (and numeric's) takes what its literals take: a text cast of one written as such is read
// so (' 0x1F '::int, '1_000'::bigint); None for any other.
fn pgIntText(s: &str): Option[str] {
    let t = strings.trim(s)
    if !strings.contains(&t, "_") && !(len(t) > 1 && (t[1] == 'x' || t[1] == 'X' || t[1] == 'o' || t[1] == 'O' || t[1] == 'b' || t[1] == 'B')) &&
       !(len(t) > 2 && (t[0] == '-' || t[0] == '+') && (t[2] == 'x' || t[2] == 'X' || t[2] == 'o' || t[2] == 'O' || t[2] == 'b' || t[2] == 'B')) { return None }
    var sign = ""
    var body = t.toStr()
    if len(body) > 0 && (body[0] == '-' || body[0] == '+') {
        sign = if body[0] == '-' { "-" } else { "" }
        body = body[1..len(body)].toStr()
    }
    if len(body) == 0 || !isDigit(body[0]) { return None }
    match pgNumber(&body, 0) {
        Ok(tok) { if tok.at == len(body) { return Some(sign + tok.text) } }
        Err(_) {}
    }
    return None
}

// PostgreSQL's cast of a text constant to an integer or numeric type: its 16's forms read (pgIntText).
fn pgCast(e: Expr, t: TypeName): Expr {
    if t.kind == K_INT || t.kind == K_NUM {
        match e {
            Expr.Lit(v) {
                match v {
                    Val.Text(s) {
                        match pgIntText(&s) {
                            Some(d) { return Expr.Cast(Expr.Lit(Val.Text(d)), t) }
                            None {}
                        }
                    }
                    else {}
                }
            }
            else {}
        }
    }
    return Expr.Cast(e, t)
}

// A quoted string or name, s[i] its opening quote, closed by q (doubled
// inside: itself); the index after it.
fn quoted(s: &str, i: int, q: byte, b: mut &str): Result[int, lexdb_base.DbErr] {
    var j = i + 1
    while true {
        if j >= len(s) { return Err(syntax(if q == '\'' { "unterminated quoted string" } else { "unterminated quoted identifier" })) }
        if s[j] == q {
            if j + 1 < len(s) && s[j + 1] == q {
                b.addByte(q)
                j += 2
                continue
            }
            return Ok(j + 1)
        }
        b.addByte(s[j])
        j += 1
    }
    return Ok(j)
}

fn lexIn(s: &str, dialect: Dialect): Result[[]Tok, lexdb_base.DbErr] { return lexInGt(s, dialect, false, 0) }
fn lexOra(s: &str, dialect: Dialect, ora: bool): Result[[]Tok, lexdb_base.DbErr] { return lexInGt(s, dialect, ora, 0) }

// A name as Oracle folds a bare one: upper case in its spelling (the text
// stays folded for lexdb's matching, as T-SQL's, L6).
fn oraName(raw: &str, at: int): Tok {
    let f = strings.toLowerAscii(raw)
    let up = strings.toUpperAscii(raw)
    // MINUS is EXCEPT
    if f == "minus" { return Tok{kind: T_IDENT, text: "except", at: at, spell: ""} }
    return Tok{kind: T_IDENT, text: f, at: at, spell: if up == f { "" } else { up }}
}

// Oracle's quoted name: exact (lexdb_sql.oraQuoted), spelled as written.
fn oraQTok(raw: &str, at: int): Tok {
    let k = lexdb_sql.oraQuoted(raw)
    return Tok{kind: T_QIDENT, text: k.clone(), at: at, spell: if k == raw { "" } else { raw.toStr() }}
}

fn lexInGt(s: &str, dialect: Dialect, ora: bool, initGt: int): Result[[]Tok, lexdb_base.DbErr] {
    var out: []Tok = []
    var bindNames: []str = []
    var gtDepth = initGt
    var gtMatch = false
    var gtWhere = false
    var gtWhereDepth = 0
    var gtWhereBrack = false
    var edgeBrack = false
    var i = 0
    let n = len(s)
    while i < n {
        let c = s[i]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 12 {
            i += 1
            continue
        }
        if c == '-' && i + 1 < n && s[i + 1] == '-' {
            while i < n && s[i] != '\n' { i += 1 }
            continue
        }
        if c == '/' && i + 1 < n && s[i + 1] == '*' {
            i += 2
            while i + 1 < n && !(s[i] == '*' && s[i + 1] == '/') { i += 1 }
            i += 2
            continue
        }
        let start = i
        if dialect.tsql {
            // @name and @@name; [name]; N'...'; "..." a string when QUOTED_IDENTIFIER is OFF
            if c == '@' && i + 1 < n && (isIdentStart(s[i + 1]) || s[i + 1] == '@') {
                i += if s[i + 1] == '@' { 2 } else { 1 }
                while i < n && (isIdentChar(s[i]) || s[i] == '@' || s[i] == '#') { i += 1 }
                append(mut &out, Tok{kind: T_VAR, text: strings.toLowerAscii(s[start..i]), at: start, spell: ""})
                continue
            }
            // ^: XOR, lexdb's # (PostgreSQL's ^ is a power)
            if c == '^' {
                i += 1
                append(mut &out, Tok{kind: T_OP, text: "#", at: start, spell: "^"})
                continue
            }
            // $action: MERGE ... OUTPUT's
            if c == '$' && i + 7 <= n && strings.toLowerAscii(s[i + 1..i + 7]) == "action" && (i + 7 == n || !isIdentChar(s[i + 7])) {
                i += 7
                append(mut &out, Tok{kind: T_IDENT, text: "$action", at: start, spell: ""})
                continue
            }
            // Inside GRAPH_TABLE's MATCH pattern, -[ ... ]- uses [ ] as edge pattern brackets (not T-SQL quoted identifiers)
            if c == '[' && gtDepth > 0 && gtMatch && !gtWhere && !edgeBrack && len(out) > 0 && out[len(out) - 1].kind == T_OP && out[len(out) - 1].text == "-" {
                edgeBrack = true
                i += 1
                append(mut &out, Tok{kind: T_OP, text: "[", at: start, spell: ""})
                continue
            }
            if c == ']' && edgeBrack {
                edgeBrack = false
                if gtWhere && gtWhereBrack {
                    gtWhere = false
                    gtWhereBrack = false
                }
                i += 1
                append(mut &out, Tok{kind: T_OP, text: "]", at: start, spell: ""})
                continue
            }
            if c == '[' || (c == '"' && dialect.quotedIdent) {
                var b = ""
                i = try quoted(s, i, if c == '[' { ']' } else { '"' }, mut &b)
                append(mut &out, nameTok(T_QIDENT, &(b), start))
                continue
            }
            // #name, ##name: a temporary table's name (design/lexdb-tds.md S4)
            if c == '#' && i + 1 < n && (isIdentStart(s[i + 1]) || s[i + 1] == '#') {
                i += 1
                while i < n && s[i] == '#' { i += 1 }
                while i < n && isIdentChar(s[i]) { i += 1 }
                append(mut &out, nameTok(T_IDENT, &(s[start..i].toStr()), start))
                continue
            }
            if (c == 'n' || c == 'N') && i + 1 < n && s[i + 1] == '\'' {
                var b = ""
                i = try quoted(s, i + 1, '\'', mut &b)
                append(mut &out, Tok{kind: T_STR, text: b, at: start, spell: ""})
                continue
            }
            if c == '"' && !dialect.quotedIdent {
                var b = ""
                i = try quoted(s, i, '"', mut &b)
                append(mut &out, Tok{kind: T_STR, text: b, at: start, spell: ""})
                continue
            }
        }
        if ora {
            // q'[...]' and N'...' strings; :1 and :name binds
            if (c == 'q' || c == 'Q') && i + 2 < n && s[i + 1] == '\'' && s[i + 2] != ' ' && s[i + 2] != '\'' {
                let open = s[i + 2]
                let close = if open == '[' { ']' } else if open == '(' { ')' } else if open == '{' { '}' } else if open == '<' { '>' } else { open }
                var j = i + 3
                var b = ""
                while true {
                    if j + 1 >= n { return Err(syntax("unterminated quoted string")) }
                    if s[j] == close && s[j + 1] == '\'' { break }
                    b.addByte(s[j])
                    j += 1
                }
                i = j + 2
                append(mut &out, Tok{kind: T_STR, text: b, at: start, spell: ""})
                continue
            }
            if (c == 'n' || c == 'N') && i + 1 < n && s[i + 1] == '\'' {
                var b = ""
                i = try quoted(s, i + 1, '\'', mut &b)
                append(mut &out, Tok{kind: T_STR, text: b, at: start, spell: ""})
                continue
            }
            if c == ':' && i + 1 < n && (isDigit(s[i + 1]) || isIdentStart(s[i + 1])) {
                i += 1
                while i < n && (isIdentChar(s[i]) || s[i] == '#') { i += 1 }
                let nm = s[start + 1..i].toStr()
                if isDigit(nm[0]) {
                    append(mut &out, Tok{kind: T_PARAM, text: nm, at: start, spell: ""})
                } else {
                    let key = strings.toLowerAscii(&nm)
                    var k = -1
                    for q in 0..len(bindNames) { if bindNames[q] == key { k = q } }
                    if k < 0 {
                        append(mut &bindNames, key)
                        k = len(bindNames) - 1
                    }
                    append(mut &out, Tok{kind: T_PARAM, text: (k + 1).toStr(), at: start, spell: ""})
                }
                continue
            }
        }
        if !dialect.tsql && !ora && (c == 'e' || c == 'E') && i + 1 < n && s[i + 1] == '\'' {
            // E'...': an escape string (\n, \t, \\, \', octal, \xhh, ...)
            var b = ""
            i += 2
            while true {
                if i >= n { return Err(syntax("unterminated quoted string")) }
                let d = s[i]
                if d == '\'' {
                    if i + 1 < n && s[i + 1] == '\'' {
                        b.addByte('\'')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                if d == '\\' && i + 1 < n {
                    i += 1
                    i = lexdb_sql.unescape(s, i, mut &b)
                    continue
                }
                b.addByte(d)
                i += 1
            }
            append(mut &out, Tok{kind: T_STR, text: b, at: start, spell: ""})
            continue
        }
        if isIdentStart(c) {
            while i < n && isIdentChar(s[i]) { i += 1 }
            // a bare name: in T-SQL spelled as written, in PostgreSQL folded
            if ora { append(mut &out, oraName(&s[start..i], start)) }
            else if dialect.tsql {
                let tok = nameTok(T_IDENT, &(s[start..i].toStr()), start)
                if gtDepth > 0 {
                    if gtDepth == 1 && !edgeBrack {
                        if tok.text == "match" { gtMatch = true; gtWhere = false }
                        else if tok.text == "where" || tok.text == "columns" || tok.text == "one" { gtMatch = false; gtWhere = false }
                    } else if gtMatch && !gtWhere && tok.text == "where" {
                        gtWhere = true
                        gtWhereDepth = gtDepth
                        gtWhereBrack = edgeBrack
                    }
                }
                append(mut &out, tok)
            }
            else { append(mut &out, Tok{kind: T_IDENT, text: strings.toLowerAscii(s[start..i]), at: start, spell: ""}) }
            continue
        }
        if c == '"' {
            var b = ""
            i += 1
            while true {
                if i >= n { return Err(syntax("unterminated quoted identifier")) }
                if s[i] == '"' {
                    if i + 1 < n && s[i + 1] == '"' {
                        b.addByte('"')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                b.addByte(s[i])
                i += 1
            }
            append(mut &out, if ora { oraQTok(&b, start) } else { nameTok(T_QIDENT, &(b), start) })
            continue
        }
        if dialect.tsql && c == '0' && i + 1 < n && (s[i + 1] == 'x' || s[i + 1] == 'X') {
            // T-SQL's binary literal, 0x01ff (design/lexdb-tds.md, section 13)
            i += 2
            while i < n && isHexDigit(s[i]) { i += 1 }
            append(mut &out, Tok{kind: T_NUM, text: strings.toLowerAscii(s[start..i]), at: start, spell: ""})
            continue
        }
        if isDigit(c) || (c == '.' && i + 1 < n && isDigit(s[i + 1])) {
            while i < n && (isDigit(s[i]) || s[i] == '.') { i += 1 }
            if i < n && (s[i] == 'e' || s[i] == 'E') {
                i += 1
                if i < n && (s[i] == '+' || s[i] == '-') { i += 1 }
                if !(i < n && isDigit(s[i])) && !dialect.tsql && !ora {
                    // an e with no digits after it: PostgreSQL's trailing junk (pgNumber)
                    let t = try pgNumber(s, start)
                    append(mut &out, Tok{kind: T_NUM, text: t.text.clone(), at: start, spell: ""})
                    i = t.at
                    continue
                }
                while i < n && isDigit(s[i]) { i += 1 }
            }
            if i < n && isIdentStart(s[i]) && !dialect.tsql {
                // a number running into a letter or _: PostgreSQL 16's 0x1F, 0o17, 0b101 and 1_000 (pgNumber), else an
                // error ("trailing junk"); Oracle's _ there is ORA-00911 (its 1abc is 1 and an alias, as before)
                if !ora {
                    let t = try pgNumber(s, start)
                    append(mut &out, Tok{kind: T_NUM, text: t.text.clone(), at: start, spell: ""})
                    i = t.at
                    continue
                }
                if s[i] == '_' { return Err(lexdb_base.err("ORA00911", "_: invalid character after <number>")) }
            }
            append(mut &out, Tok{kind: T_NUM, text: s[start..i].clone(), at: start, spell: ""})
            continue
        }
        if c == '\'' {
            var b = ""
            i += 1
            while true {
                if i >= n { return Err(syntax("unterminated quoted string")) }
                if s[i] == '\'' {
                    if i + 1 < n && s[i + 1] == '\'' {
                        b.addByte('\'')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                b.addByte(s[i])
                i += 1
            }
            append(mut &out, Tok{kind: T_STR, text: b, at: start, spell: ""})
            continue
        }
        if c == '$' && !dialect.tsql && !ora {
            // a dollar-quoted string, $tag$ ... $tag$ (tag: a name or nothing): its text as it is (a function's body)
            var j = i + 1
            if j < n && isIdentStart(s[j]) { while j < n && isIdentChar(s[j]) && s[j] != '$' { j += 1 } }
            if j < n && s[j] == '$' {
                let tag = s[i..j + 1].toStr()
                let close = strings.indexOf(s, &tag, j + 1)
                if close < 0 { return Err(syntax("unterminated dollar-quoted string")) }
                append(mut &out, Tok{kind: T_STR, text: s[j + 1..close].toStr(), at: start, spell: ""})
                i = close + len(tag)
                continue
            }
        }
        if c == '$' && i + 1 < n && isDigit(s[i + 1]) {
            i += 1
            while i < n && isDigit(s[i]) { i += 1 }
            append(mut &out, Tok{kind: T_PARAM, text: s[start + 1..i].clone(), at: start, spell: ""})
            continue
        }
        // operators
        var op = s[i..i + 1].clone()
        if i + 1 < n {
            let two = s[i..i + 2]
            if two == "<=" || two == ">=" || two == "<>" || two == "!=" || two == "||" || two == "::" || two == "!~" || two == "~*" ||
               two == "<<" || two == ">>" || two == "@>" || two == "<@" || two == "&&" { op = two.clone() }
            if two == "!~" && i + 2 < n && s[i + 2] == '*' { op = "!~*" }
            // PostgreSQL's JSON operators: their first characters' look first, so other operators pay one
            let c0 = s[i]
            if (c0 == '-' || c0 == '#' || c0 == '?' || c0 == '@') && !ora && !dialect.tsql {
                if two == "->" { op = if i + 2 < n && s[i + 2] == '>' { "->>" } else { "->" } }
                else if two == "#>" { op = if i + 2 < n && s[i + 2] == '>' { "#>>" } else { "#>" } }
                else if two == "?|" || two == "?&" || two == "@?" || two == "@@" || two == "#-" { op = two.clone() }
            }
        }
        if !strings.contains(&"(),;.*+-/%=<>|:![]~&#^@{}?$", &op[0..1]) {
            return Err(syntax(&("syntax error at or near \"" + op + "\"")))
        }
        i += len(op)
        if dialect.tsql {
            if op == "(" {
                if gtDepth > 0 { gtDepth += 1 }
                else if len(out) > 0 && out[len(out) - 1].kind == T_IDENT && out[len(out) - 1].text == "graph_table" {
                    gtDepth = 1
                    gtMatch = false
                    gtWhere = false
                    edgeBrack = false
                }
            } else if op == ")" && gtDepth > 0 {
                gtDepth -= 1
                if gtWhere && !gtWhereBrack && gtDepth < gtWhereDepth { gtWhere = false }
                if gtDepth == 0 {
                    gtMatch = false
                    gtWhere = false
                    edgeBrack = false
                }
            }
        }
        append(mut &out, Tok{kind: T_OP, text: op, at: start, spell: ""})
    }
    append(mut &out, Tok{kind: T_EOF, text: "", at: n, spell: ""})
    return Ok(out)
}

// ---- the parser

type P = record {
    toks: []Tok
    pos: int
    params: int
    subs: []Stmt        // the subqueries of the statement being parsed
    ctes: []Cte         // the CTEs in scope, innermost last
    nextCte: int        // the statement's CTEs are numbered
    inCte: []InCte      // the recursive CTEs whose bodies are being parsed
    depth: int          // subqueries deep
    seqs: []str         // the sequences named by nextval, currval and setval so far
    wins: []WinDef      // the window calls of the query being parsed (9.46)
    src: str            // the SQL text (a view keeps its query's, 9.82)
    tsql: bool          // T-SQL (design/lexdb-tds.md): its type names, SELECT @v = ...
    vars: []str         // T-SQL: the variables in scope, @name is $k for vars[k - 1]
    spelled: str        // the spelling of the name name() read last, "" its text (L6)
    rnLimit: int        // Oracle: the count of a WHERE ... ROWNUM <= n taken out of selectCore's WHERE; -1 none
    nls: []str          // Oracle: the session's NLS_DATE_FORMAT, NLS_TIMESTAMP_FORMAT, NLS_TIMESTAMP_TZ_FORMAT as set; [] none (O5)
    ora: bool           // Oracle (design/lexdb-oracle.md O3): its names, types, functions, ROWNUM, DUAL, ...
    mr: int             // inside a MATCH_RECOGNIZE clause (how deep): PREV, FIRST, RUNNING, CLASSIFIER, ... are read
    udf: bool           // T-SQL: a schema-qualified function call or a function in FROM was read (Stmt.udf)
}

// (No field of P for what one of its functions hands to another only in a rare form: a field costs every statement's
// parse its making, two empty arrays a point select's 120 instructions. T-SQL's GROUP BY ALL's WHERE goes from
// selectCore to select in the SELECT's sets, GALL_SET; a column list's spellings back from aliasOf after SPELL_MARK.)
const GALL_SET = "\x00gall"
const SPELL_MARK = "\x00spell"


// A CTE: kept as its text (where its tokens start), parsed again as a
// subquery in FROM wherever it is used, seeing the CTEs before it (and a
// recursive one itself).
type Cte = record { name: str; cols: []str; start: int; id: int; rec: bool; spell: str; spec: str; spells: []str }

// A recursive CTE whose body is being read: its number, how deep its body is, its references read so far, and how many
// subqueries of an expression (not FROM's) are open around where the reader is: a reference there is refused (one in a
// derived table is taken, as PostgreSQL and SQL Server take it; Oracle refuses both).
type InCte = record { id: int; depth: int; refs: int; sub: int }

fn (p: &P) peek(): &Tok { return &p.toks[p.pos] }
fn (p: &P) peekAt(k: int): &Tok {
    let i = if p.pos + k < len(p.toks) { p.pos + k } else { len(p.toks) - 1 }
    return &p.toks[i]
}
fn (p: mut &P) next(): Tok {
    let t = p.toks[p.pos].clone()
    if t.kind != T_EOF { p.pos += 1 }
    return t
}

fn near(t: &Tok): lexdb_base.DbErr {
    if t.kind == T_EOF { return syntax("syntax error at end of input") }
    return syntax(&("syntax error at or near \"" + t.text + "\""))
}

// Is the next token the keyword (or operator) w?
fn (p: &P) isKw(w: &str): bool {
    // the token read in place, not copied (asked many times per token)
    let k = p.toks[p.pos].kind
    return (k == T_IDENT || k == T_OP) && p.toks[p.pos].text == w
}

fn (p: mut &P) acceptKw(w: &str): bool {
    if p.isKw(w) {
        p.pos += 1
        return true
    }
    return false
}

fn (p: mut &P) expectKw(w: &str): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw(w) { return Ok(Unit{}) }
    return Err(near(&p.peek()))
}


// T-SQL: a word that starts a batch's next statement, not an alias
// (SELECT ... FROM t IF @x = 1 ...: statements need no ;).
pub fn isTsqlStart(w: &str): bool { return tsqlStarts(w) || w == "select" || w == "insert" || w == "update" || w == "delete" || w == "set" ||
                                           w == "create" || w == "with" }

fn tsqlStarts(w: &str): bool {
    match w {
        "if", "else", "begin", "while", "declare", "exec", "execute", "print", "return", "use", "raiserror", "throw", "commit",
        "rollback", "save", "break", "continue", "drop", "alter", "truncate", "merge", "go", "waitfor", "goto", "grant",
        "revoke", "deny", "open", "close", "fetch", "deallocate", "bulk", "dbcc", "checkpoint", "kill", "reconfigure",
        "shutdown", "readtext", "writetext", "updatetext", "setuser", "backup", "restore" { return true }
        else { return false }
    }
}

fn tableHintErr(t: &Tok): lexdb_base.DbErr {
    let w = if len(t.spell) > 0 { t.spell.clone() } else { strings.toUpperAscii(&t.text) }
    return lexdb_base.err("TS1018", &("Incorrect syntax near '" + w + "'. If this is intended as a part of a table hint, A WITH keyword and parenthesis are now required. See SQL Server Books Online for proper syntax."))
}

// T-SQL: a statement that cannot start with the reserved word it starts with (SELECT 1 rule: rule after the SELECT, a statement
// of its own) is SQL Server's 156 at the word, not 102 (e: the parser's error, at: where the statement starts).
fn (p: &P) startErr(at: int, e: lexdb_base.DbErr): lexdb_base.DbErr {
    // (the parser stopped at the statement's first word, not at one like it further on)
    if !p.tsql || e.state != "42601" || at >= len(p.toks) || p.pos > at + 1 { return e }
    let t = &p.toks[at]
    if t.kind != T_IDENT || !lexdb_sql.tsqlReserved(&t.text) || tsqlStarts(&t.text) || e.msg != near(t).msg { return e }
    // (after a table, HOLDLOCK is a table hint without WITH: 1018)
    if t.text == "holdlock" { return tableHintErr(t) }
    return lexdb_base.err("TS156", &("Incorrect syntax near the keyword '" + (if len(t.spell) > 0 { t.spell.clone() } else { t.text.clone() }) + "'."))
}

fn (p: mut &P) name(): Result[str, lexdb_base.DbErr] {
    let t = p.peek().clone()
    if t.kind == T_QIDENT || (t.kind == T_IDENT && !lexdb_sql.isReserved(&t.text)) {
        p.pos += 1
        p.spelled = t.spell.clone()
        return Ok(t.text.clone())
    }
    return Err(near(&t))
}

// T-SQL: the name token at i is not one of SQL Server's reserved words written bare (lexdb_sql.tsqlReserved: 156, as SQL Server's).
fn (p: &P) notTsqlReserved(i: int): Result[Unit, lexdb_base.DbErr] {
    // (IF NOT EXISTS, which SQL Server does not have: its error is at NOT)
    let ifNot = p.toks[i].text == "if" && i + 1 < len(p.toks) && p.toks[i + 1].kind == T_IDENT && p.toks[i + 1].text == "not"
    if i >= 0 && p.toks[i].kind == T_IDENT && lexdb_sql.tsqlReserved(&p.toks[i].text) && !ifNot {
        // (156 itself: whether SQL Server says 156 or 102 for a word depends on where it is, so lexdb_tsql's mapping of a syntax error does not decide it)
        let w = if len(p.toks[i].spell) > 0 { p.toks[i].spell.clone() } else { p.toks[i].text.clone() }
        return Err(lexdb_base.err("TS156", &("Incorrect syntax near the keyword '" + w + "'.")))
    }
    return Ok(Unit{})
}

// A table's (or an index's) name: name or schema.name (qual).
fn (p: mut &P) qname(): Result[str, lexdb_base.DbErr] {
    // T-SQL: @t, a table variable: the temporary table #@t
    if p.tsql && p.peek().kind == T_VAR && !strings.startsWith(&(p.peek().text), "@@") {
        let t = p.next()
        p.spelled = ""
        return Ok("#" + t.text)
    }
    let first = try p.name()
    if p.tsql {
        // T-SQL: [db.][schema.]name, db..name; dbo is public (design/lexdb-tds.md L3); a reserved word only quoted (156)
        try p.notTsqlReserved(p.pos - 1)
        var parts: []str = [first]
        var spell = p.spelled.clone()
        while p.acceptKw(".") {
            if p.isKw(".") {
                append(mut &parts, "")
                continue
            }
            append(mut &parts, try p.name())
            try p.notTsqlReserved(p.pos - 1)
            spell = p.spelled.clone()
        }
        p.spelled = spell
        let n = len(parts)
        // msdb's objects lexdb_syscat has (msdb.dbo.x: msdb.x)
        if n >= 3 && parts[n - 3] == "msdb" && lexdb_dialect.isMsdb(&parts[n - 1]) { return Ok(lexdb_sql.qual(&"msdb", &parts[n - 1])) }
        let sc: &str = if n >= 2 { &parts[n - 2] } else { "" }
        if n == 1 || sc == "" || sc == "dbo" { return Ok(parts[n - 1].clone()) }
        return Ok(lexdb_sql.qual(&sc, &parts[n - 1]))
    }
    if p.acceptKw(".") { return Ok(lexdb_sql.qual(&first, &(try p.name()))) }
    return Ok(first)
}

// A relation's name where a statement reads or writes it: qname, but
// public.name kept so (PUBLIC_Q), not made name: a temporary relation of
// the name, found first along the path, must not hide it (9.96). The
// executor's lookups (lexdb_exec.catKey) make it name.
fn (p: mut &P) rname(): Result[str, lexdb_base.DbErr] {
    if p.tsql { return p.qname() }          // T-SQL's names: dbo is public (L3)
    let first = try p.name()
    if p.acceptKw(".") {
        let n = try p.name()
        if first == "public" { return Ok(PUBLIC_Q + n) }
        return Ok(lexdb_sql.qual(&first, &n))
    }
    return Ok(first)
}

// "public" and QSEP: an explicitly public name (rname).
pub const PUBLIC_Q: str = "public\x1f"

fn (p: mut &P) typeName(): Result[TypeName, lexdb_base.DbErr] {
    // pg_catalog.type: the type
    if p.peek().kind == T_IDENT && p.peek().text == "pg_catalog" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." { p.pos += 2 }
    let quoted = p.peek().kind == T_QIDENT
    let w = try p.name()
    var t = TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}
    if p.tsql {
        match try p.tsqlType(&w) {
            Some(x) { return Ok(x) }
            None {}
        }
    }
    if p.ora && !quoted {
        match try p.oraType(&w) {
            Some(x) { return Ok(x) }
            None {}
        }
    }
    if quoted && w == "char" { return p.arraySuffix(TypeName{kind: K_TEXT, oid: OID_CHAR, prec: 0, scale: 0, len: 0}) }
    match w {
        "oid" { t = TypeName{kind: K_INT, oid: OID_OID, prec: 0, scale: 0, len: 0} }
        "name" { t = TypeName{kind: K_TEXT, oid: OID_NAME, prec: 0, scale: 0, len: 0} }
        "regclass", "regtype", "regnamespace", "regproc", "regprocedure", "regrole" {
            // catalog lookups: the statement binds the catalog (9.80)
            append(mut &p.seqs, CAT_MARK)
            let o = if w == "regclass" { OID_REGCLASS } else if w == "regtype" { OID_REGTYPE } else if w == "regnamespace" { OID_REGNAMESPACE } else { OID_REGPROC }
            t = TypeName{kind: K_REG, oid: o, prec: 0, scale: 0, len: 0}
        }
        "int2vector" { return Ok(TypeName{kind: K_ARRAY, oid: 22, prec: 0, scale: 0, len: 0}) }
        "oidvector" { return Ok(TypeName{kind: K_ARRAY, oid: 30, prec: 0, scale: 0, len: 0}) }
        "int", "integer", "int4" { t = TypeName{kind: K_INT, oid: OID_INT4, prec: 0, scale: 0, len: 0} }
        "bigint", "int8" { t = TypeName{kind: K_INT, oid: OID_INT8, prec: 0, scale: 0, len: 0} }
        "smallint", "int2" { t = TypeName{kind: K_INT, oid: OID_INT2, prec: 0, scale: 0, len: 0} }
        "boolean", "bool" { t = TypeName{kind: K_BOOL, oid: OID_BOOL, prec: 0, scale: 0, len: 0} }
        // T-SQL's numeric, apart from decimal, in len (lexdb_tds sends it as numeric)
        "numeric", "decimal" { t = TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 0, scale: 0, len: if p.tsql && w == "numeric" { lexdb_dialect.TS_NUMERIC } else { 0 }} }
        "text" { t = TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0} }
        "varchar" { t = TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: 0} }
        "date" { t = lexdb_sql.timeType(OID_DATE) }
        "uuid" { t = TypeName{kind: K_UUID, oid: OID_UUID, prec: 0, scale: 0, len: 0} }
        "real", "float4" { t = lexdb_sql.floatType(OID_FLOAT4) }
        "float8" { t = lexdb_sql.floatType(OID_FLOAT8) }
        "double" {
            try p.expectKw("precision")
            t = lexdb_sql.floatType(OID_FLOAT8)
        }
        "float" {
            // float(p): real to 24 bits, double precision to 53
            var oid = OID_FLOAT8
            if p.acceptKw("(") {
                let n = try p.intLit()
                if n < 1 { return Err(lexdb_base.err("22023", "precision for type float must be at least 1 bit")) }
                if n > 53 { return Err(lexdb_base.err("22023", "precision for type float must be less than 54 bits")) }
                if n <= 24 { oid = OID_FLOAT4 }
                try p.expectKw(")")
            }
            return Ok(try p.arraySuffix(lexdb_sql.floatType(oid)))
        }
        "bytea" { t = TypeName{kind: K_BYTEA, oid: OID_BYTEA, prec: 0, scale: 0, len: 0} }
        "json" { t = TypeName{kind: K_JSON, oid: OID_JSON, prec: 0, scale: 0, len: 0} }
        "jsonb" { t = TypeName{kind: K_JSON, oid: OID_JSONB, prec: 0, scale: 0, len: 0} }
        "time", "timestamp", "timestamptz", "timetz", "interval" {
            var oid = if w == "time" { OID_TIME } else if w == "interval" { OID_IVAL } else if w == "timestamptz" { OID_TSTZ } else if w == "timetz" { 0 } else { OID_TS }
            t = lexdb_sql.timeType(oid)
            if p.acceptKw("(") {
                let n = try p.intLit()
                if n < 0 || n > 6 { return Err(lexdb_base.err("22023", &("precision " + n.toStr() + " must be between 0 and 6"))) }
                t.prec = 1
                t.scale = n
                try p.expectKw(")")
            }
            if (w == "time" || w == "timestamp") && (p.isKw("with") || p.isKw("without")) {
                let with = p.acceptKw("with")
                if !with { try p.expectKw("without") }
                try p.expectKw("time")
                try p.expectKw("zone")
                if with { oid = if w == "time" { 0 } else { OID_TSTZ } }
            }
            if oid == 0 { return Err(lexdb_base.err("0A000", "lexdb: time with time zone is not supported (use timestamptz)")) }
            t.kind = lexdb_sql.timeKind(oid)
            t.oid = oid
            if w == "interval" {
                // INTERVAL(p) is the precision alone (PostgreSQL: no fields after it); INTERVAL fields [(p)] else
                let precOnly = t.prec == 1 && !p.tsql && !p.ora
                if !precOnly { t.prec = 0 }
                if !p.tsql && !p.ora && !precOnly { try p.ivalFields(mut &t) }
            }
            return Ok(try p.arraySuffix(t))
        }
        "character", "char", "bpchar", "nchar" {
            if w != "bpchar" && p.acceptKw("varying") {
                t = TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: 0}
            } else {
                // char(n) (9.94): char alone is char(1), bpchar has no length
                t = TypeName{kind: K_TEXT, oid: OID_BPCHAR, prec: 0, scale: 0, len: if w == "bpchar" { 0 } else { 1 }}
                if p.acceptKw("(") {
                    t.len = try p.intLit()
                    if t.len < 1 { return Err(lexdb_base.err("22023", &("length for type " + (if w == "bpchar" { "bpchar" } else { "char" }) + " must be at least 1"))) }
                    if t.len > 10485760 { return Err(lexdb_base.err("22023", &("length for type " + (if w == "bpchar" { "bpchar" } else { "char" }) + " cannot exceed 10485760"))) }
                    try p.expectKw(")")
                }
                return p.arraySuffix(t)
            }
        }
        else {
            // a type of the user's (9.90): an enum, found when the statement runs
            var key = w.clone()
            if p.isKw(".") && (p.peekAt(1).kind == T_IDENT || p.peekAt(1).kind == T_QIDENT) {
                p.pos += 1
                key = lexdb_sql.qual(&w, &(try p.name()))
            }
            if p.isKw("[") { return Err(lexdb_base.err("0A000", "lexdb: arrays of enum types are not supported")) }
            append(mut &p.seqs, TYPE_MARK + key)
            return Ok(TypeName{kind: K_ENUM, oid: lexdb_sql.nameOid(&"T", &key), prec: 0, scale: 0, len: 0})
        }
    }
    if p.acceptKw("(") {
        let a = try p.intLit()
        if t.kind == K_NUM {
            t.prec = a
            if p.acceptKw(",") { t.scale = try p.intLit() }
            if t.prec < 1 || t.prec > 38 {
                return Err(lexdb_base.err("22023", &("NUMERIC precision " + t.prec.toStr() + " must be between 1 and 38")))
            }
            if t.scale < 0 || t.scale > t.prec {
                return Err(lexdb_base.err("22023", &("NUMERIC scale " + t.scale.toStr() + " must be between 0 and precision " + t.prec.toStr())))
            }
        } else if t.kind == K_TEXT {
            t.len = a
        } else {
            return Err(near(&p.toks[p.pos - 1]))
        }
        try p.expectKw(")")
    }
    return p.arraySuffix(t)
}

// T[]: an array of T (its length, if given, is not kept: PostgreSQL does
// not check it either); else t.
// The SQL standard's fields of an interval type, after INTERVAL or after its literal: YEAR, MONTH, DAY, HOUR, MINUTE, SECOND,
// or one TO a lower one, and a SECOND's (precision): kept in the type's len as lexdb_time's IF_ mask, the precision as the
// time types' (prec 1, scale n). None given: the type as it is.
fn (p: &P) ivalField(): int {
    let t = p.peek()
    if t.kind != T_IDENT { return 0 }
    if t.text == "year" { return lexdb_time.IF_YEAR }
    if t.text == "month" { return lexdb_time.IF_MONTH }
    if t.text == "day" { return lexdb_time.IF_DAY }
    if t.text == "hour" { return lexdb_time.IF_HOUR }
    if t.text == "minute" { return lexdb_time.IF_MINUTE }
    if t.text == "second" { return lexdb_time.IF_SECOND }
    return 0
}

fn (p: mut &P) ivalFields(t: mut &TypeName): Result[Unit, lexdb_base.DbErr] {
    let first = p.ivalField()
    if first == 0 { return Ok(Unit{}) }
    p.pos += 1
    var mask = first
    var last = first
    if p.isKw("to") {
        p.pos += 1
        last = p.ivalField()
        if last == 0 || last <= first || first == lexdb_time.IF_MONTH || first == lexdb_time.IF_SECOND { return Err(near(p.peek())) }
        p.pos += 1
        mask = 0
        var b = first
        while b <= last {
            mask = mask | b
            b = b * 2
        }
    }
    if last == lexdb_time.IF_SECOND && p.isKw("(") {
        p.pos += 1
        let n = try p.intLit()
        if n < 0 || n > 6 { return Err(lexdb_base.err("22023", &("INTERVAL(" + n.toStr() + ") precision must be between 0 and 6"))) }
        try p.expectKw(")")
        t.prec = 1
        t.scale = n
    }
    t.len = mask
    return Ok(Unit{})
}

fn (p: mut &P) arraySuffix(t: TypeName): Result[TypeName, lexdb_base.DbErr] {
    if p.acceptKw("[") {
        if p.peek().kind == T_NUM { let n = try p.intLit() }
        try p.expectKw("]")
        return Ok(TypeName{kind: K_ARRAY, oid: lexdb_sql.arrayOid(t.oid), prec: 0, scale: 0, len: 0})
    }
    return Ok(t)
}

fn (p: mut &P) intLit(): Result[int, lexdb_base.DbErr] {
    let t = p.next()
    if t.kind != T_NUM { return Err(near(&t)) }
    match strings.parseIntOpt(&t.text) {
        Some(n) { return Ok(n) }
        None { return Err(near(&t)) }
    }
}

// ---- expressions, by precedence: OR, AND, NOT, comparison and IS, ||,
// + -, * / %, unary -, ::.

fn (p: mut &P) expr(): Result[Expr, lexdb_base.DbErr] { return p.orExpr() }

fn (p: mut &P) orExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.andExpr()
    while p.acceptKw("or") {
        let r = try p.andExpr()
        e = Expr.Bin("or", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) andExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.notExpr()
    while p.acceptKw("and") {
        let r = try p.notExpr()
        e = Expr.Bin("and", e, r)
    }
    return Ok(e)
}

fn (p: mut &P) notExpr(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("not") {
        let e = try p.notExpr()
        return Ok(Expr.Unary("not", e))
    }
    return p.cmpExpr()
}

// A comparison, IN, LIKE or BETWEEN, then any IS tests of it: IS binds
// more loosely than those, as PostgreSQL's grammar has it (x = y IS TRUE is
// (x = y) IS TRUE; x IN (...) IS NOT FALSE too).
fn (p: mut &P) cmpExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.cmpExpr0()
    while p.isKw("is") { e = try p.isTail(e) }
    return Ok(e)
}

fn (p: mut &P) cmpExpr0(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.catExpr()
    let t = p.peek().clone()
    if t.kind == T_OP && (t.text == "=" || t.text == "<>" || t.text == "!=" || t.text == "<" || t.text == "<=" ||
                          t.text == ">" || t.text == ">=") {
        p.pos += 1
        let op = if t.text == "!=" { "<>" } else { t.text.clone() }
        let q = p.peek().clone()
        if q.kind == T_IDENT && (q.text == "any" || q.text == "some" || q.text == "all") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
            // x op ANY (array), x op ALL (array): the call "any op" or "all op"
            // (9.28); with a subquery, = ANY is IN and <> ALL is NOT IN
            let all = q.text == "all"
            p.pos += 2
            if isRow(&e) {
                // (a, b) = ANY (subquery) is IN, <> ALL NOT IN (9.94)
                if (p.isKw("select") || p.isKw("with") || p.parenQuery()) && ((op == "=" && !all) || (op == "<>" && all)) {
                    return Ok(negate(all, try p.rowSub(&"in", &e)))
                }
                return Err(lexdb_base.err("0A000", "lexdb: a row before ANY or ALL is supported with = ANY (subquery) and <> ALL (subquery) only"))
            }
            if p.isKw("select") || p.isKw("with") || p.parenQuery() {
                if (op == "=" && !all) || (op == "<>" && all) {
                    let i = try p.subquery(SUB_IN)
                    return Ok(negate(all, Expr.Call("#in", [Expr.Lit(Val.Int(i)), e], false)))
                }
                // another op: over the array of the subquery's values (9.94)
                let arr = try p.arrayOfSub()
                return Ok(Expr.Call((if all { "all " } else { "any " }) + op, [e, arr], false))
            }
            let arr = try p.expr()
            try p.expectKw(")")
            return Ok(Expr.Call((if all { "all " } else { "any " }) + op, [e, arr], false))
        }
        if isRow(&e) && p.isKw("(") && (p.peekAt(1).text == "select" || p.peekAt(1).text == "with") {
            // (a, b) op (subquery) (9.94)
            p.pos += 1
            return p.rowSub(&op, &e)
        }
        let r = try p.catExpr()
        if isRow(&e) || isRow(&r) { return rowCmp(&op, &e, &r) }
        return Ok(Expr.Bin(op, e, r))
    }
    // x ~ pattern, !~, ~*, !~*; OPERATOR(pg_catalog.op) as op (9.80)
    var rop = ""
    if t.kind == T_OP && (t.text == "~" || t.text == "!~" || t.text == "~*" || t.text == "!~*") {
        p.pos += 1
        rop = t.text.clone()
    } else if t.kind == T_IDENT && t.text == "operator" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
        p.pos += 2
        if p.peek().kind == T_IDENT && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." { p.pos += 2 }
        let o = p.next()
        if o.kind != T_OP { return Err(near(&o)) }
        try p.expectKw(")")
        rop = if o.text == "!=" { "<>" } else { o.text.clone() }
        if rop == "=" || rop == "<>" || rop == "<" || rop == "<=" || rop == ">" || rop == ">=" {
            let r = try p.catExpr()
            return Ok(Expr.Bin(rop, e, r))
        }
        if rop != "~" && rop != "!~" && rop != "~*" && rop != "!~*" { return Err(lexdb_base.err("42883", &("operator does not exist: " + rop))) }
    }
    if len(rop) > 0 {
        let r = try p.catExpr()
        return Ok(Expr.Call(rop, [e, r], false))
    }
    // [NOT] LIKE, ILIKE, SIMILAR TO, IN, BETWEEN
    var neg = false
    let nt = p.peekAt(1).clone()
    if p.isKw("not") && nt.kind == T_IDENT && (nt.text == "like" || nt.text == "ilike" || nt.text == "in" || nt.text == "between" ||
                                               nt.text == "similar") {
        p.pos += 1
        neg = true
    }
    if p.isKw("like") || p.isKw("ilike") {
        var kw = p.next().text
        let q = p.peek().clone()
        if q.kind == T_IDENT && (q.text == "any" || q.text == "some" || q.text == "all") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
            // x [NOT] LIKE ANY | ALL (array or subquery) (9.94): the call "any like",
            // "all not like" and the like; NOT is the element's, as PostgreSQL's
            let all = q.text == "all"
            p.pos += 2
            var arr = Expr.Lit(Val.Null)
            if p.isKw("select") || p.isKw("with") || p.parenQuery() {
                arr = try p.arrayOfSub()
            } else {
                arr = try p.expr()
                try p.expectKw(")")
            }
            return Ok(Expr.Call((if all { "all " } else { "any " }) + (if neg { "not " } else { "" }) + kw, [e, arr], false))
        }
        if p.tsql && kw == "like" { kw = "#tlike" }        // T-SQL's [sets] (lexdb_tsqlfn)
        var args: []Expr = [e]
        append(mut &args, try p.catExpr())
        if p.acceptKw("escape") { append(mut &args, try p.catExpr()) }
        return Ok(negate(neg, Expr.Call(kw, args, false)))
    }
    if p.isKw("similar") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "to" {
        // x SIMILAR TO pattern [ESCAPE e] (9.94): the call "similar"
        p.pos += 2
        var args: []Expr = [e]
        append(mut &args, try p.catExpr())
        if p.acceptKw("escape") { append(mut &args, try p.catExpr()) }
        return Ok(negate(neg, Expr.Call("similar", args, false)))
    }
    if p.acceptKw("in") {
        try p.expectKw("(")
        if isRow(&e) {
            // (a, b) IN ((1, 2), (3, 4)): row equalities ORed; IN (subquery) (9.94)
            if p.isKw("select") || p.isKw("with") || p.parenQuery() { return Ok(negate(neg, try p.rowSub(&"in", &e))) }
            var any = try rowCmp(&"=", &e, &(try p.expr()))
            while p.acceptKw(",") { any = Expr.Bin("or", any, try rowCmp(&"=", &e, &(try p.expr()))) }
            try p.expectKw(")")
            return Ok(negate(neg, any))
        }
        if p.isKw("select") || p.isKw("with") || p.parenQuery() {
            let i = try p.subquery(SUB_IN)
            return Ok(negate(neg, Expr.Call("#in", [Expr.Lit(Val.Int(i)), e], false)))
        }
        var args: []Expr = [e]
        append(mut &args, try p.expr())
        while p.acceptKw(",") { append(mut &args, try p.expr()) }
        try p.expectKw(")")
        return Ok(negate(neg, Expr.Call("in", args, false)))
    }
    if p.acceptKw("between") {
        // a BETWEEN b AND c is a >= b AND a <= c: the planner knows those.
        // SYMMETRIC (9.94): either way round, (a >= b AND a <= c) OR (a >= c
        // AND a <= b), as PostgreSQL rewrites it
        let sym = p.acceptKw("symmetric")
        if !sym { let asym = p.acceptKw("asymmetric") }
        let lo = try p.catExpr()
        try p.expectKw("and")
        let hi = try p.catExpr()
        let x = Expr.Bin("and", try cmpOf(&">=", &e, &lo), try cmpOf(&"<=", &e, &hi))
        if sym {
            let other = Expr.Bin("and", try cmpOf(&">=", &e, &hi), try cmpOf(&"<=", &e, &lo))
            return Ok(negate(neg, Expr.Bin("or", x, other)))
        }
        return Ok(negate(neg, x))
    }
    if neg { return Err(near(&p.peek())) }
    return Ok(e)
}

// e IS [NOT] NULL, TRUE, FALSE, UNKNOWN, DISTINCT FROM x. IS TRUE and IS
// FALSE are never NULL: e IS TRUE is e IS NOT DISTINCT FROM true (a NULL
// e is not true: false); IS NOT TRUE its opposite (a NULL e: true).
fn (p: mut &P) isTail(e: Expr): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("is") {
        let isNot = p.acceptKw("not")
        if p.acceptKw("distinct") {
            try p.expectKw("from")
            let r = try p.catExpr()
            if isRow(&e) || isRow(&r) {
                // rows (9.94): distinct when a pair of fields is
                let ls = try rowItems(&e)
                let rs = try rowItems(&r)
                if len(ls) != len(rs) { return Err(lexdb_base.err("42601", "unequal number of entries in row expressions")) }
                var d = Expr.Call("distinct from", [cloneE(&ls[0]), cloneE(&rs[0])], false)
                for i in 1..len(ls) { d = Expr.Bin("or", d, Expr.Call("distinct from", [cloneE(&ls[i]), cloneE(&rs[i])], false)) }
                return Ok(if isNot { Expr.Unary("not", d) } else { d })
            }
            let d = Expr.Call("distinct from", [e, r], false)
            return Ok(if isNot { Expr.Unary("not", d) } else { d })
        }
        if p.acceptKw("null") {
            if isRow(&e) {
                // a row IS NULL: each field is; IS NOT NULL: none is (9.94)
                let xs = try rowItems(&e)
                var all = Expr.IsNull(cloneE(&xs[0]), isNot)
                for i in 1..len(xs) { all = Expr.Bin("and", all, Expr.IsNull(cloneE(&xs[i]), isNot)) }
                return Ok(all)
            }
            return Ok(Expr.IsNull(e, isNot))
        }
        if p.acceptKw("true") || p.acceptKw("false") {
            let b = p.toks[p.pos - 1].text == "true"
            let d = Expr.Call("distinct from", [e, Expr.Lit(Val.Bool(b))], false)
            return Ok(if isNot { d } else { Expr.Unary("not", d) })
        }
        if p.peek().kind == T_IDENT && p.peek().text == "unknown" {
            p.pos += 1
            return Ok(Expr.IsNull(e, isNot))
        }
        if p.acceptKw("json") {
            var kind = ""
            if p.acceptKw("value") { kind = "value" }
            else if p.acceptKw("scalar") { kind = "scalar" }
            else if p.acceptKw("array") { kind = "array" }
            else if p.acceptKw("object") { kind = "object" }
            var uniq = 0
            if p.acceptKw("with") {
                try p.expectKw("unique")
                let _k = p.acceptKw("keys")
                uniq = 1
            } else if p.acceptKw("without") {
                try p.expectKw("unique")
                let _k = p.acceptKw("keys")
            }
            let call = Expr.Call("#is_json", [e, Expr.Lit(Val.Text(kind)), Expr.Lit(Val.Int(uniq))], false)
            return Ok(if isNot { Expr.Unary("not", call) } else { call })
        }
        return Err(near(&p.peek()))
    }
    return Ok(e)
}

// Is the token one of catExpr's operators? One look at the token: an
// operand's end asks it, so it must cost no more as operators are added
// (PostgreSQL's JSON operators: only the PostgreSQL door's).
fn (p: &P) catOp(): bool {
    if p.toks[p.pos].kind != T_OP { return false }
    match p.toks[p.pos].text {
        "||", "&", "|", "#", "<<", ">>", "@>", "<@", "&&" { return true }
        "->", "->>", "#>", "#>>", "?", "?|", "?&", "@?", "@@", "#-" { return !p.ora && !p.tsql }
        else { return false }
    }
}

// ||, and the bitwise & | # << >> (9.85): PostgreSQL's "any other
// operator", between + - and the comparisons, left to right.
fn (p: mut &P) catExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.addExpr()
    while p.catOp() {
        let op = p.next().text
        let r = try p.addExpr()
        // the array operators (9.92) are calls; T-SQL's ^ is # (XOR: its lexer)
        if p.tsql && (op == "&" || op == "|" || op == "#" || op == "<<" || op == ">>") {
            e = tsqlBitOp(&op, e, r)
        } else if op == "->" { e = Expr.Call("#json_arrow", [e, r], false) }
        else if op == "->>" { e = Expr.Call("#json_arrow_text", [e, r], false) }
        else if op == "#>" { e = Expr.Call("#json_hash", [e, r], false) }
        else if op == "#>>" { e = Expr.Call("#json_hash_text", [e, r], false) }
        else if op == "?" { e = Expr.Call("#jsonb_has", [e, r], false) }
        else if op == "?|" { e = Expr.Call("#jsonb_has_any", [e, r], false) }
        else if op == "?&" { e = Expr.Call("#jsonb_has_all", [e, r], false) }
        else if op == "@?" { e = Expr.Call("#jsonb_path_exists_op", [e, r], false) }
        else if op == "@@" { e = Expr.Call("#jsonb_path_match_op", [e, r], false) }
        else if op == "#-" { e = Expr.Call("#jsonb_del_path", [e, r], false) }
        else {
            e = if op == "@>" || op == "<@" || op == "&&" { Expr.Call(op, [e, r], false) } else { Expr.Bin(op, e, r) }
        }
    }
    return Ok(e)
}




// T-SQL: a bit in arithmetic is a number. A column's or a variable's value
// may be one: read through #bitint (lexdb_tsqlfn), which makes a bit 0 or
// 1 and leaves the rest.
fn bitInt(x: Expr): Expr {
    match x {
        Expr.Col(_, _) { return Expr.Call("#bitint", [x], false) }
        Expr.Param(_) { return Expr.Call("#bitint", [x], false) }
        else { return x }
    }
}

fn hexDigit(c: byte): int {
    if c >= '0' && c <= '9' { return int(c - '0') }
    if c >= 'a' && c <= 'f' { return int(c - 'a') + 10 }
    if c >= 'A' && c <= 'F' { return int(c - 'A') + 10 }
    return 0
}

fn isHexDigit(c: byte): bool { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') }

// Whether the token is + or - (or T-SQL's t+, as exprText writes it; Oracle's ||).
fn (p: &P) isAddOp(): bool {
    let t = &p.toks[p.pos]
    if t.kind != T_OP { return false }
    if len(t.text) == 1 { return t.text[0] == '+' || t.text[0] == '-' }
    return t.text == "t+" || (p.ora && t.text == "||")
}

fn (p: mut &P) addExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.mulExpr()
    while p.isAddOp() {
        let op = p.next().text
        let r = try p.mulExpr()
        if p.ora {
            e = oraArith(&op, e, r)
            continue
        }
        // T-SQL's +: strings joined too (lexdb_exec: "t+"); a bit a number
        e = if p.tsql { Expr.Bin(if op == "+" { "t+" } else { op }, bitInt(e), bitInt(r)) } else { Expr.Bin(op, e, r) }
    }
    return Ok(e)
}

fn (p: mut &P) mulExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.powExpr()
    while p.isKw("*") || p.isKw("/") || p.isKw("%") {
        let op = p.next().text
        let r = try p.powExpr()
        if p.ora && op == "/" {
            // NUMBER's division: not an integer's (lexdb_orafn)
            e = Expr.Call("#ora_div", [e, r], false)
            continue
        }
        e = if p.tsql { Expr.Bin(op, bitInt(e), bitInt(r)) } else { Expr.Bin(op, e, r) }
    }
    return Ok(e)
}

// x ^ y (9.92): above * and /, below a sign, left to right, as PostgreSQL's.
fn (p: mut &P) powExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.atExpr()
    while p.isKw("^") {
        p.pos += 1
        let r = try p.atExpr()
        e = Expr.Bin("^", e, r)
    }
    return Ok(e)
}

// x AT TIME ZONE zone, x AT LOCAL (9.95): above ^, as PostgreSQL's; the
// calls timezone(zone, x) and timezone(x).
fn (p: mut &P) atExpr(): Result[Expr, lexdb_base.DbErr] {
    var e = try p.unary()
    while p.isKw("at") && p.toks[p.pos + 1].kind == T_IDENT &&
          ((p.toks[p.pos + 1].text == "time" && p.toks[p.pos + 2].kind == T_IDENT && p.toks[p.pos + 2].text == "zone") ||
           p.toks[p.pos + 1].text == "local") {
        p.pos += 1
        if p.acceptKw("local") {
            e = Expr.Call(if p.ora { "#ora_atlocal" } else { "timezone" }, [e], false)
        } else {
            p.pos += 2
            let z = try p.unary()
            e = if p.ora { Expr.Call("#ora_attz", [e, z], false) } else if p.tsql { Expr.Call("#tattz", [e, z], false) } else { Expr.Call("timezone", [z, e], false) }
        }
    }
    return Ok(e)
}

fn (p: mut &P) unary(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("-") {
        let e = try p.unary()
        return Ok(Expr.Unary("-", e))
    }
    if p.acceptKw("~") {
        let e = try p.unary()
        // T-SQL's ~ takes a bit too (lexdb_tsqlfn)
        if p.tsql { return Ok(Expr.Call("#bitnot", [e], false)) }
        return Ok(Expr.Unary("~", e))
    }
    if p.acceptKw("+") { return p.unary() }
    var e = try p.primary()
    while true {
        if p.acceptKw("::") {
            let t = try p.typeName()
            e = pgCast(e, t)
        } else if p.acceptKw("[") {
            // x[i]: an array's element (9.80)
            let i = try p.expr()
            try p.expectKw("]")
            e = Expr.Call("#elem", [e, i], false)
        } else if p.ora && p.isKw("(") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "+" && p.peekAt(2).kind == T_OP && p.peekAt(2).text == ")" {
            // x (+): marked here, and moved into a LEFT JOIN's ON by oraOuterJoins when the WHERE is read
            p.pos += 3
            e = Expr.Call("#outer", [e], false)
        } else if p.acceptKw("collate") {
            // x COLLATE name: the call "#collate" (L2: an explicit collation)
            let c = try p.collName()
            e = Expr.Call("#collate", [e, Expr.Lit(Val.Text(c))], false)
        } else {
            break
        }
    }
    return Ok(e)
}

// At a call's "(": whether its arguments are the SQL standard's words
// (FROM, FOR, PLACING) rather than commas.
fn (p: &P) sqlForm(): bool {
    var depth = 0
    var i = p.pos
    while i < len(p.toks) {
        let t = &p.toks[i]
        if t.kind == T_EOF { return false }
        if t.kind == T_OP && (t.text == "(" || t.text == "[") { depth += 1 }
        if t.kind == T_OP && (t.text == ")" || t.text == "]") {
            depth -= 1
            if depth == 0 { return false }
        }
        if depth == 1 && t.kind == T_OP && t.text == "," { return false }
        if depth == 1 && t.kind == T_IDENT && (t.text == "from" || t.text == "for" || t.text == "placing" || t.text == "similar") { return true }
        i += 1
    }
    return false
}

fn negate(neg: bool, x: Expr): Expr { return if neg { Expr.Unary("not", x) } else { x } }

fn cloneE(x: &Expr): Expr {
    match x {
        Expr.Lit(v) { return Expr.Lit(v.clone()) }
        Expr.Param(n) { return Expr.Param(n) }
        Expr.Col(n, s) { return Expr.Col(n.clone(), s) }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), cloneE(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), cloneE(&a), cloneE(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(cloneE(&a), neg) }
        Expr.Cast(a, t) { return Expr.Cast(cloneE(&a), t) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, cloneE(&a)) }
            return Expr.Call(n.clone(), out, star)
        }
    }
}

// CASE [x] WHEN a THEN b ... [ELSE c] END: a call "case" (or "case else")
// of the WHEN and THEN pairs, then the ELSE; CASE x WHEN a is WHEN x = a.
fn (p: mut &P) caseExpr(): Result[Expr, lexdb_base.DbErr] {
    var operand: []Expr = []
    if !p.isKw("when") { append(mut &operand, try p.expr()) }
    var args: []Expr = []
    while p.acceptKw("when") {
        var w = try p.expr()
        if len(operand) > 0 { w = Expr.Bin("=", cloneE(&operand[0]), w) }
        try p.expectKw("then")
        append(mut &args, w)
        append(mut &args, try p.expr())
    }
    if len(args) == 0 { return Err(near(&p.peek())) }
    var name = "case"
    if p.acceptKw("else") {
        append(mut &args, try p.expr())
        name = "case else"
    }
    try p.expectKw("end")
    return Ok(Expr.Call(name, args, false))
}

// A subquery, after its "(": its own subqueries go with it, and the
// statement it is in gets it, numbered.
fn (p: mut &P) subquery(use: int): Result[int, lexdb_base.DbErr] {
    p.depth += 1
    let blk = len(p.inCte) > 0 && use != SUB_FROM
    if blk { for k in 0..len(p.inCte) { p.inCte[k].sub += 1 } }
    let start = p.pos
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var pushed = 0
    if p.acceptKw("with") { pushed = try p.withList() }
    var sq = lexdb_sql.newStmt(S_SELECT)
    if p.isKw("(") { sq = try p.parenSelect() } else if !p.tsql && use == SUB_FROM && p.isKw("values") {
        // a CTE's body (and PostgreSQL's FROM (VALUES ...) in parentheses again): VALUES as a query (P23, O5)
        p.pos += 1
        sq = try p.valuesQuery()
        if !p.ora { try p.orderLimit(mut &sq) }
    } else {
        try p.expectKw("select")
        sq = try p.select()
    }
    p.popCtes(pushed)
    sq.subs = replace(mut &p.subs, saved)
    sq.wins = replace(mut &p.wins, savedW)
    sq.use = use
    p.depth -= 1
    if blk { for k in 0..len(p.inCte) { p.inCte[k].sub -= 1 } }
    // a scalar subquery written again in the same query is the same one:
    // GROUP BY (subquery) then matches it in the select list, and it runs
    // once per row
    if use == SUB_SCALAR {
        var kb = ""
        for i in start..p.pos {
            kb += &(p.toks[i].kind.toStr())
            kb.addByte(1)
            kb += &p.toks[i].text
            kb.addByte(0)
        }
        sq.src = kb
        for i in 0..len(p.subs) {
            if p.subs[i].use == SUB_SCALAR && p.subs[i].src == sq.src {
                try p.expectKw(")")
                return Ok(i)
            }
        }
    }
    try p.expectKw(")")
    append(mut &p.subs, sq)
    return Ok(len(p.subs) - 1)
}

// WITH's list, after "with": the CTEs go in scope (how many: the result).
// Each is parsed now to check it, and again where it is used.
fn (p: mut &P) withList(): Result[int, lexdb_base.DbErr] {
    let rec = p.acceptKw("recursive")
    // T-SQL and Oracle: a CTE that names itself is recursive, without RECURSIVE (lexdb_recur)
    let selfRec = p.tsql || p.ora
    var n = 0
    while true {
        let name = try p.name()
        let spell = if len(p.spelled) > 0 { p.spelled.clone() } else { name.clone() }
        var cols: []str = []
        var spells: []str = []
        if p.acceptKw("(") {
            append(mut &cols, try p.name())
            append(mut &spells, if len(p.spelled) > 0 { p.spelled.clone() } else { cols[len(cols) - 1].clone() })
            while p.acceptKw(",") {
                append(mut &cols, try p.name())
                append(mut &spells, if len(p.spelled) > 0 { p.spelled.clone() } else { cols[len(cols) - 1].clone() })
            }
            try p.expectKw(")")
        }
        try p.expectKw("as")
        if p.acceptKw("not") { try p.expectKw("materialized") } else { let m = p.acceptKw("materialized") }
        try p.expectKw("(")
        for k in len(p.ctes) - n..len(p.ctes) {
            if p.ctes[k].name == name {
                if p.tsql { return Err(lexdb_base.err("TS239", &("Duplicate common table expression name '" + spell + "' was specified."))) }
                return Err(lexdb_base.err("42712", &("WITH query name \"" + name + "\" specified more than once")))
            }
        }
        let id = p.nextCte
        p.nextCte += 1
        let start = p.pos
        // a recursive one is in scope in its own body
        let r = rec || selfRec
        if r {
            var cs: []str = []
            for c in cols { append(mut &cs, c.clone()) }
            append(mut &p.ctes, Cte{name: name.clone(), cols: cs, start: start, id: id, rec: true, spell: spell.clone(), spec: "", spells: spells.clone()})
        }
        let keep = len(p.subs)
        if r { append(mut &p.inCte, InCte{id: id, depth: p.depth + 1, refs: 0, sub: 0}) }
        let vals = p.ora && p.isKw("values")
        if vals && len(cols) == 0 { return Err(oraErr(63803, "columns must be specified with With Clause")) }
        let i = try p.subquery(SUB_FROM)
        if vals && len(p.subs[i].from) == 1 && p.subs[i].from[0].sub >= 0 {
            // Oracle: VALUES as the body, its width the column list's (ORA-63815)
            let w = p.subs[i].subs[p.subs[i].from[0].sub].srf.clone()
            if w != "#values:" + len(cols).toStr() {
                return Err(oraErr(63815, "The number of column names must match the number of values in the Table Value Constructor."))
            }
        }
        var refs = 0
        if r { refs = pop(mut &p.inCte).refs }
        if (selfRec || rec) && refs > 0 {
            if p.ora && len(cols) == 0 { return Err(lexdb_recur.noColumnList(&name)) }
            try lexdb_recur.check(&p.subs[i], &spell, id, len(cols), p.md())
        }
        while len(p.subs) > keep { let x = pop(mut &p.subs) }
        // SEARCH and CYCLE (PostgreSQL's and Oracle's): the columns they add are the CTE's
        var spec = ""
        if p.isKw("search") || p.isKw("cycle") {
            let sp = try p.searchCycle(&name, &spell, mut &cols, refs > 0)
            spec = lexdb_recur.encode(&sp)
        }
        if r {
            let at = len(p.ctes) - 1
            p.ctes[at].rec = rec || refs > 0
            p.ctes[at].cols = cols
            p.ctes[at].spec = spec
        } else {
            append(mut &p.ctes, Cte{name: name, cols: cols, start: start, id: id, rec: false, spell: spell, spec: spec, spells: spells})
        }
        n += 1
        if !p.acceptKw(",") { break }
    }
    return Ok(n)
}

// SEARCH { DEPTH | BREADTH } FIRST BY col [ASC | DESC] [NULLS FIRST | LAST], ... SET ordcol and CYCLE col, ... SET
// markcol [TO v DEFAULT d] [USING pathcol] after a recursive CTE's body (name, spell: its name): PostgreSQL's (no ASC,
// DESC or NULLS; TO and DEFAULT optional, booleans by default; USING required) and Oracle's (TO and DEFAULT required,
// one-character values; no USING); the columns they add go after the CTE's (cols), and the errors each gives.
fn (p: mut &P) searchCycle(name: &str, spell: &str, cols: mut &[]str, rec: bool): Result[lexdb_recur.Spec, lexdb_base.DbErr] {
    var sp = lexdb_recur.newSpec(p.md())
    let pg = !p.ora && !p.tsql
    if p.tsql { return Err(near(&p.peek())) }
    if !rec {
        if pg { return Err(lexdb_base.err("42601", "WITH query is not recursive")) }
        return Err(near(&p.peek()))
    }
    let base = len(cols)
    if p.acceptKw("search") {
        if p.acceptKw("depth") { sp.search = lexdb_recur.SEARCH_DEPTH } else {
            try p.expectKw("breadth")
            sp.search = lexdb_recur.SEARCH_BREADTH
        }
        try p.expectKw("first")
        try p.expectKw("by")
        while true {
            let c = try p.name()
            var found = false
            for x in cols { if x == c { found = true } }
            if !found && (len(cols) > 0 || !pg) {
                if pg { return Err(lexdb_base.err("42601", &("search column \"" + c + "\" not in WITH query column list"))) }
                return Err(oraErr(32489, "element in sort specification list of SEARCH clause did not appear in the column alias list of the WITH clause element"))
            }
            for x in sp.sCols { if x == c && pg { return Err(lexdb_base.err("42701", &("search column \"" + c + "\" specified more than once"))) } }
            var desc = false
            var nulls = 0
            if !pg {
                if p.acceptKw("desc") { desc = true } else { let a = p.acceptKw("asc") }
                if p.acceptKw("nulls") {
                    if p.acceptKw("first") { nulls = 1 } else {
                        try p.expectKw("last")
                        nulls = 2
                    }
                }
            }
            append(mut &sp.sCols, c)
            append(mut &sp.sDesc, desc)
            append(mut &sp.sNulls, nulls)
            if !p.acceptKw(",") { break }
        }
        try p.expectKw("set")
        sp.sSet = try p.name()
        for x in cols {
            if x == sp.sSet {
                if pg { return Err(lexdb_base.err("42702", &("column reference \"" + x + "\" is ambiguous"))) }
                return Err(oraErr(32046, "sequence column name for SEARCH clause must not be part of the column alias list"))
            }
        }
    }
    if p.acceptKw("cycle") {
        while true {
            let c = try p.name()
            var found = false
            for j in 0..base { if cols[j] == c { found = true } }
            if !found && (base > 0 || !pg) {
                if pg { return Err(lexdb_base.err("42601", &("cycle column \"" + c + "\" not in WITH query column list"))) }
                return Err(oraErr(32489, "element in cycle column list of CYCLE clause did not appear in the column alias list of the WITH clause element"))
            }
            append(mut &sp.cCols, c)
            if !p.acceptKw(",") { break }
        }
        try p.expectKw("set")
        sp.cSet = try p.name()
        for j in 0..base {
            if cols[j] == sp.cSet {
                if pg { return Err(lexdb_base.err("42601", &("cycle mark column name \"" + sp.cSet + "\" already used in WITH query column list"))) }
                return Err(oraErr(32048, "cycle mark column name for CYCLE clause must not be part of the column alias list"))
            }
        }
        if sp.cSet == sp.sSet {
            if pg { return Err(lexdb_base.err("42601", "search sequence column name and cycle mark column name are the same")) }
            return Err(oraErr(32482, "sequence column for SEARCH clause must be different from the cycle mark column for CYCLE clause"))
        }
        sp.cTo = Val.Bool(true)
        sp.cDefault = Val.Bool(false)
        if p.isKw("to") || !pg {
            try p.expectKw("to")
            sp.cTo = try p.markValue()
            try p.expectKw("default")
            sp.cDefault = try p.markValue()
            if !pg {
                var ok = true
                for v in [sp.cTo.clone(), sp.cDefault.clone()] {
                    match v {
                        Val.Text(t) { if len(t) != 1 { ok = false } }
                        Val.Int(k) { if k < 0 || k > 9 { ok = false } }
                        Val.Bool(_) {}
                        else { ok = false }
                    }
                }
                if !ok { return Err(oraErr(32047, "cycle mark value and non-cycle mark value must be one byte character string values or boolean constants")) }
            } else {
                // (PostgreSQL: the two values' common type: an integer and a text that is not one is 22P02)
                let ti = match sp.cTo { Val.Int(_) { true } else { false } }
                let di = match sp.cDefault { Val.Int(_) { true } else { false } }
                let tt = match sp.cTo { Val.Text(_) { true } else { false } }
                let dt = match sp.cDefault { Val.Text(_) { true } else { false } }
                if (ti && dt) || (tt && di) {
                    let t = match sp.cTo { Val.Text(x) { x.clone() } else { match sp.cDefault { Val.Text(x) { x.clone() } else { "" } } } }
                    if strings.parseIntOpt(&t).isNone() { return Err(lexdb_base.err("22P02", &("invalid input syntax for type integer: \"" + t + "\""))) }
                }
            }
        }
        if pg {
            try p.expectKw("using")
            sp.cPath = try p.name()
            if sp.cPath == sp.cSet { return Err(lexdb_base.err("42601", "cycle mark column name and cycle path column name are the same")) }
            if sp.cPath == sp.sSet { return Err(lexdb_base.err("42601", "search sequence column name and cycle path column name are the same")) }
            for j in 0..base { if cols[j] == sp.cPath { return Err(lexdb_base.err("42601", &("cycle path column name \"" + sp.cPath + "\" already used in WITH query column list"))) } }
        }
    }
    return Ok(sp)
}

// A CYCLE clause's TO or DEFAULT value: a literal (a string, a number, TRUE or FALSE).
fn (p: mut &P) markValue(): Result[Val, lexdb_base.DbErr] {
    let t = p.next()
    if t.kind == T_STR { return Ok(Val.Text(t.text.clone())) }
    if t.kind == T_NUM { return Ok(Val.Int(strings.parseIntOpt(&t.text).unwrapOr(0))) }
    if t.kind == T_IDENT && (t.text == "true" || t.text == "false") { return Ok(Val.Bool(t.text == "true")) }
    return Err(near(&t))
}

fn (p: mut &P) popCtes(n: int) { for i in 0..n { let c = pop(mut &p.ctes) } }

// Whether a CTE of this name is in scope.
fn (p: &P) cteNamed(n: &str): bool {
    for c in p.ctes { if c.name == n { return true } }
    return false
}

// A use of CTE ci: its text parsed again, here, with the CTEs before it in
// scope.
fn (p: mut &P) cteRef(ci: int): Result[int, lexdb_base.DbErr] {
    let saved = replace(mut &p.ctes, [])
    let rec = saved[ci].rec
    let id = saved[ci].id
    let upto = if rec { ci + 1 } else { ci }
    for i in 0..upto {
        var cols: []str = []
        for c in saved[i].cols { append(mut &cols, c.clone()) }
        append(mut &p.ctes, Cte{name: saved[i].name.clone(), cols: cols, start: saved[i].start, id: saved[i].id, rec: saved[i].rec,
                                spell: saved[i].spell.clone(), spec: saved[i].spec.clone(), spells: saved[i].spells.clone()})
    }
    let pos = p.pos
    p.pos = saved[ci].start
    if rec { append(mut &p.inCte, InCte{id: id, depth: p.depth + 1, refs: 0, sub: 0}) }
    let r = p.subquery(SUB_FROM)
    var selfRefs = 0
    if rec { selfRefs = pop(mut &p.inCte).refs }
    p.pos = pos
    p.ctes = saved
    let i = try r
    // T-SQL's and Oracle's shapes, SEARCH and CYCLE: as the executor runs them (lexdb_recur.shape)
    if selfRefs > 0 && (p.tsql || p.ora || len(p.ctes[ci].spec) > 0) {
        let body = replace(mut &p.subs[i], lexdb_sql.newStmt(S_SELECT))
        var sp = lexdb_recur.decode(&p.ctes[ci].spec)
        sp.name = p.ctes[ci].spell.clone()
        for c in p.ctes[ci].cols { append(mut &sp.cols, c.clone()) }
        for c in p.ctes[ci].spells { append(mut &sp.spells, c.clone()) }
        p.subs[i] = lexdb_recur.shape(body, id, p.md(), sp)
    }
    p.subs[i].cte = id
    p.subs[i].rec = selfRefs > 0
    return Ok(i)
}

// A CTE's columns where it is used: its column list, then the columns its SEARCH and CYCLE add.
fn cteCols(c: &Cte): []str {
    var out: []str = []
    for x in c.cols { append(mut &out, x.clone()) }
    if len(c.spec) == 0 || len(out) == 0 { return out }
    let sp = lexdb_recur.decode(&c.spec)
    if len(sp.sSet) > 0 { append(mut &out, sp.sSet.clone()) }
    if len(sp.cSet) > 0 { append(mut &out, sp.cSet.clone()) }
    if len(sp.cPath) > 0 { append(mut &out, sp.cPath.clone()) }
    return out
}

fn subRef(name: &str, i: int): Expr { return Expr.Call(name.clone(), [Expr.Lit(Val.Int(i))], false) }

// A row constructor, (a, b) or ROW(a, b) (9.94): the call "row". Rows are
// compared, field by field, and nothing else.
pub fn isRow(x: &Expr): bool {
    match x {
        Expr.Call(n, args, star) { return n == "row" && !star }
        else { return false }
    }
}

// Whether x names one of its statement's subqueries or window calls by
// number (#sub, #win and the like).
fn hasMark(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasMark(&a) }
        Expr.Bin(_, a, b) { return hasMark(&a) || hasMark(&b) }
        Expr.IsNull(a, _) { return hasMark(&a) }
        Expr.Cast(a, _) { return hasMark(&a) }
        Expr.Call(n, args, _) {
            if n == "#sub" || n == "#exists" || n == "#in" || n == "#win" { return true }
            for a in args { if hasMark(&a) { return true } }
            return false
        }
        else { return false }
    }
}

fn rowItems(x: &Expr): Result[[]Expr, lexdb_base.DbErr] {
    match x {
        Expr.Call(n, args, star) {
            if n == "row" {
                var out: []Expr = []
                for a in args { append(mut &out, cloneE(&a)) }
                return Ok(out)
            }
        }
        else {}
    }
    return Err(lexdb_base.err("42883", "operator does not exist: a row compared with a value that is not a row"))
}

// Two rows compared (9.94), as PostgreSQL: = when each pair is equal, <>
// when one is not; <, <=, >, >= by the first pair not equal, NULL when a
// pair before it is NULL: (a, b) < (c, d) is a < c OR (a = c AND b < d).
// The order's comparisons start with a <= c (or a >= c), true whenever the
// whole is, so that an index on a serves as a range.
fn rowCmp(op: &str, l: &Expr, r: &Expr): Result[Expr, lexdb_base.DbErr] {
    let ls = try rowItems(l)
    let rs = try rowItems(r)
    let n = len(ls)
    if n != len(rs) { return Err(lexdb_base.err("42601", "unequal number of entries in row expressions")) }
    if n == 0 { return Err(lexdb_base.err("42601", "cannot compare rows of zero length")) }
    if op == "=" || op == "<>" {
        var x = Expr.Bin(op.toStr(), cloneE(&ls[0]), cloneE(&rs[0]))
        for i in 1..n { x = Expr.Bin(if op == "=" { "and" } else { "or" }, x, Expr.Bin(op.toStr(), cloneE(&ls[i]), cloneE(&rs[i]))) }
        return Ok(x)
    }
    let strict = op[0..1].toStr()
    var x = Expr.Bin(op.toStr(), cloneE(&ls[n - 1]), cloneE(&rs[n - 1]))
    var i = n - 2
    while i >= 0 {
        x = Expr.Bin("or", Expr.Bin(strict.clone(), cloneE(&ls[i]), cloneE(&rs[i])), Expr.Bin("and", Expr.Bin("=", cloneE(&ls[i]), cloneE(&rs[i])), x))
        i -= 1
    }
    if n > 1 { x = Expr.Bin("and", Expr.Bin(strict + "=", cloneE(&ls[0]), cloneE(&rs[0])), x) }
    return Ok(x)
}

// l op r, rows too (rowCmp).
fn cmpOf(op: &str, l: &Expr, r: &Expr): Result[Expr, lexdb_base.DbErr] {
    if isRow(l) || isRow(r) { return rowCmp(op, l, r) }
    return Ok(Expr.Bin(op.toStr(), cloneE(l), cloneE(r)))
}

// A row compared with a subquery's row, after the "(" (9.94): op, or "in"
// (= ANY). A scalar subquery over the subquery, its columns named "#1",
// "#2", ...: (SELECT row op (#1, #2) FROM (subquery) AS "#row"("#1", ...)),
// NULL for no rows and an error for two; for IN, of its rows' answers the
// best: true, else NULL, else false (none).
// A query's number of columns, -1 with a *: a set operation's its first query's.
fn width(s: &Stmt): int {
    if s.setop != 0 && len(s.inner) > 0 { return width(&s.inner[0]) }
    for it in s.items { if it.star { return -1 } }
    return len(s.items)
}

fn (p: mut &P) rowSub(op: &str, row: &Expr): Result[Expr, lexdb_base.DbErr] {
    let xs = try rowItems(row)
    for x in xs {
        if hasMark(&x) { return Err(lexdb_base.err("0A000", "lexdb: a subquery or window call in a row compared with a subquery is not supported")) }
    }
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let inner = try p.subquery(SUB_FROM)
    let k = width(&p.subs[inner])
    let star = k < 0
    if !star && k > len(xs) { return Err(lexdb_base.err("42601", "subquery has too many columns")) }
    if !star && k < len(xs) { return Err(lexdb_base.err("42601", "subquery has too few columns")) }
    var w = lexdb_sql.newStmt(S_SELECT)
    var names: []str = []
    var cols: []Expr = []
    for i in 0..len(xs) {
        append(mut &names, "#" + (i + 1).toStr())
        append(mut &cols, Expr.Col("#row.#" + (i + 1).toStr(), -1))
    }
    append(mut &w.from, FromItem{table: "", alias: "#row", join: J_FIRST, on: None, sub: inner, cols: names, work: -1, lateral: false, using: [], natural: false, comma: false})
    var item = Expr.Lit(Val.Null)
    if op == "in" {
        let c = try rowCmp(&"=", row, &Expr.Call("row", cols, false))
        let rank = Expr.Call("case else", [cloneE(&c), Expr.Lit(Val.Int(2)), Expr.IsNull(c, false), Expr.Lit(Val.Int(1)), Expr.Lit(Val.Int(0))], false)
        let best = Expr.Call("max", [rank], false)
        item = Expr.Call("case else", [Expr.Bin("=", cloneE(&best), Expr.Lit(Val.Int(2))), Expr.Lit(Val.Bool(true)),
                                       Expr.Bin("=", best, Expr.Lit(Val.Int(1))), Expr.Lit(Val.Null), Expr.Lit(Val.Bool(false))], false)
    } else {
        item = try rowCmp(op, row, &Expr.Call("row", cols, false))
    }
    append(mut &w.items, SelItem{star: false, qual: "", expr: Some(item), alias: "?column?", spell: ""})
    w.subs = replace(mut &p.subs, saved)
    w.use = SUB_SCALAR
    p.depth -= 1
    append(mut &p.subs, w)
    return Ok(subRef("#sub", len(p.subs) - 1))
}

// ARRAY(subquery), after its "(": (SELECT array_agg(a) FROM (subquery) AS
// "#arr"(a)), '{}' for no rows. Also op ANY | ALL (subquery) other than = ANY
// and <> ALL (9.94).
fn (p: mut &P) arrayOfSub(): Result[Expr, lexdb_base.DbErr] {
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let inner = try p.subquery(SUB_FROM)
    var w = lexdb_sql.newStmt(S_SELECT)
    append(mut &w.from, FromItem{table: "", alias: "#arr", join: J_FIRST, on: None, sub: inner, cols: ["#a"], work: -1, lateral: false, using: [], natural: false, comma: false})
    let agg = Expr.Call("array_agg", [Expr.Col("#arr.#a", -1)], false)
    append(mut &w.items, SelItem{star: false, qual: "", expr: Some(Expr.Call("coalesce", [agg, Expr.Lit(Val.Text("{}"))], false)), alias: "array", spell: ""})
    w.subs = replace(mut &p.subs, saved)
    w.use = SUB_SCALAR
    p.depth -= 1
    append(mut &p.subs, w)
    return Ok(subRef("#sub", len(p.subs) - 1))
}

// A function call's argument: an expression; of a T-SQL function of the user's, DEFAULT too (#default).
fn (p: mut &P) callArg(udf: bool): Result[Expr, lexdb_base.DbErr] {
    if udf && p.isKw("default") && p.peekAt(1).kind == T_OP && (p.peekAt(1).text == "," || p.peekAt(1).text == ")") {
        p.pos += 1
        return Ok(Expr.Call("#default", [], false))
    }
    let x = try p.expr()
    if p.ora && (p.isKw("ignore") || p.isKw("respect")) { return p.oraNullsIn(x) }
    return Ok(x)
}

// primary's SQL/JSON words (JSON 'text', JSON(...), JSON_VALUE(...), T-SQL's ISJSON(...)): the expression, or
// None when the word is not one of them (or is one without its parenthesis: a name).
fn (p: mut &P) jsonPrimary(w: &str): Result[Option[Expr], lexdb_base.DbErr] {
    match w {
        "json" {
            if p.peek().kind == T_STR {
                let lit = p.next().text
                return Ok(Some(Expr.Cast(Expr.Lit(Val.Text(lit)), TypeName{kind: K_JSON, oid: OID_JSON, prec: 0, scale: 0, len: 0})))
            }
            if p.isKw("(") { return Ok(Some(try p.jsonCtorExpr())) }
        }
        "jsonb" {
            if p.peek().kind == T_STR {
                let lit = p.next().text
                return Ok(Some(Expr.Cast(Expr.Lit(Val.Text(lit)), TypeName{kind: K_JSON, oid: OID_JSONB, prec: 0, scale: 0, len: 0})))
            }
        }
        "json_value" { if p.isKw("(") { return Ok(Some(try p.jsonValueExpr())) } }
        "json_query" { if p.isKw("(") { return Ok(Some(try p.jsonQueryExpr())) } }
        "json_exists" { if p.isKw("(") { return Ok(Some(try p.jsonExistsExpr())) } }
        "json_object" {
            if p.isKw("(") {
                match try p.jsonObjectExpr() {
                    Some(x) { return Ok(Some(x)) }
                    None {}
                }
            }
        }
        "json_array" { if p.isKw("(") { return Ok(Some(try p.jsonArrayExpr())) } }
        "json_scalar" { if p.isKw("(") { return Ok(Some(try p.jsonScalarExpr())) } }
        "json_serialize" { if p.isKw("(") { return Ok(Some(try p.jsonSerializeExpr())) } }
        "json_mergepatch" { if p.isKw("(") { return Ok(Some(try p.jsonMergePatchExpr())) } }
        "json_equal" { if p.isKw("(") { return Ok(Some(try p.jsonEqualExpr())) } }
        "json_transform" { if p.isKw("(") { return Ok(Some(try p.jsonTransformExpr())) } }
        "json_arrayagg" { if p.isKw("(") { return Ok(Some(try p.jsonArrayAggExpr())) } }
        "json_objectagg" { if p.isKw("(") { return Ok(Some(try p.jsonObjectAggExpr())) } }
        "isjson" { if p.tsql && p.isKw("(") { return Ok(Some(try p.tsqlIsJsonExpr())) } }
        else {}
    }
    return Ok(None)
}

fn (p: mut &P) primary(): Result[Expr, lexdb_base.DbErr] {
    // pg_catalog.f(...): f (9.80)
    if p.peek().kind == T_IDENT && p.peek().text == "pg_catalog" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." &&
       p.peekAt(2).kind == T_IDENT && p.peekAt(3).kind == T_OP && p.peekAt(3).text == "(" {
        p.pos += 2
    }
    // Oracle: DBMS_LOB.GETLENGTH(x), DBMS_LOB.SUBSTR(x, n, from): the package's name dropped, the function's made
    // distinct (dbms_lob_getlength, dbms_lob_substr: oraCall)
    if p.ora && p.peek().kind == T_IDENT && p.peek().text == "dbms_lob" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." &&
       p.peekAt(2).kind == T_IDENT && (p.peekAt(2).text == "getlength" || p.peekAt(2).text == "substr") &&
       p.peekAt(3).kind == T_OP && p.peekAt(3).text == "(" {
        p.pos += 2
        p.toks[p.pos].text = "dbms_lob_" + p.toks[p.pos].text
    }
    // UTL_RAW.CAST_TO_NUMBER, CAST_TO_BINARY_*, ...: read the column statistics' raw LOW_VALUE and HIGH_VALUE, which lexdb has
    // none of (NULL); CAST_TO_RAW and CAST_TO_VARCHAR2 are the text's bytes and back. UTL_ENCODE.BASE64_ENCODE and
    // BASE64_DECODE: a RAW in, a RAW out (lexdb_orafn).
    if p.ora && p.peek().kind == T_IDENT && (p.peek().text == "utl_raw" || p.peek().text == "utl_encode" || p.peek().text == "utl_match" ||
                                             (p.peek().text == "sys" && (p.peekAt(2).text == "utl_raw" || p.peekAt(2).text == "utl_encode" ||
                                                                         p.peekAt(2).text == "utl_match"))) {
        let k = if p.peek().text == "sys" { 2 } else { 0 }
        let pkg = p.peekAt(k).text.clone()
        if p.peekAt(k + 1).kind == T_OP && p.peekAt(k + 1).text == "." && p.peekAt(k + 2).kind == T_IDENT && p.peekAt(k + 3).kind == T_OP && p.peekAt(k + 3).text == "(" {
            let f = p.peekAt(k + 2).text.clone()
            if pkg == "utl_raw" && strings.startsWith(&f, "cast_to_") {
                p.pos += k + 2
                p.toks[p.pos].text = if f == "cast_to_raw" || f == "cast_to_varchar2" { "utl_raw_" + f } else { "utl_raw_cast" }
            } else if pkg == "utl_encode" && (f == "base64_encode" || f == "base64_decode") {
                p.pos += k + 2
                p.toks[p.pos].text = "utl_encode_" + f
            } else if pkg == "utl_match" && (f == "edit_distance" || f == "edit_distance_similarity" || f == "jaro_winkler" || f == "jaro_winkler_similarity") {
                p.pos += k + 2
                p.toks[p.pos].text = "utl_match_" + f
            }
        }
    }
    // T-SQL: db.schema.f(...): f (design/lexdb-tds.md, section 13); schema.f(...) is a function of the user's (package F):
    // the call named "schema.f", the statement marked (udf), for lexdb_routine to resolve
    var qual = ""
    if p.tsql && (p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT) && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." {
        var k = 0
        while (p.peekAt(k).kind == T_IDENT || p.peekAt(k).kind == T_QIDENT) && p.peekAt(k + 1).kind == T_OP && p.peekAt(k + 1).text == "." { k += 2 }
        if k >= 2 && p.peekAt(k).kind == T_IDENT && p.peekAt(k + 1).kind == T_OP && p.peekAt(k + 1).text == "(" {
            // msdb's policy check: SQL Server's answer
            if p.peekAt(k).text == "fn_syspolicy_is_automation_enabled" && p.peekAt(k + 2).kind == T_OP && p.peekAt(k + 2).text == ")" {
                p.pos += k + 3
                return Ok(Expr.Lit(Val.Int(1)))
            }
            if k == 4 { p.pos += k }
            if k == 2 {
                qual = strings.toLowerAscii(&p.peek().text)
                p.pos += 2
            }
        }
    }
    let t = p.next()
    // MATCH_RECOGNIZE: RUNNING and FINAL before an aggregate or FIRST/LAST
    if p.mr > 0 && t.kind == T_IDENT && (t.text == "running" || t.text == "final") && p.peek().kind == T_IDENT &&
       p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
        let x = try p.primary()
        return Ok(Expr.Call("#" + t.text, [x], false))
    }
    if p.ora {
        match try p.oraPrimary(&t) {
            Some(x) { return Ok(x) }
            None {}
        }
    }
    if t.kind == T_IDENT && t.text == "case" { return p.caseExpr() }
    if t.kind == T_IDENT && t.text == "substring" && p.isKw("(") && p.sqlForm() {
        // substring(x [FROM a] [FOR b]) (9.92): substring(x, a [, b]), FOR alone
        // from 1; a text a is a pattern (lexdb_exec)
        p.pos += 1
        let x = try p.expr()
        var args: []Expr = [x]
        if p.acceptKw("similar") {
            // substring(x SIMILAR pattern ESCAPE e) (9.94): as FROM pattern FOR e
            append(mut &args, try p.expr())
            try p.expectKw("escape")
            append(mut &args, try p.expr())
        } else if p.acceptKw("from") {
            append(mut &args, try p.expr())
            if p.acceptKw("for") { append(mut &args, try p.expr()) }
        } else {
            try p.expectKw("for")
            append(mut &args, Expr.Lit(Val.Int(1)))
            append(mut &args, try p.expr())
        }
        try p.expectKw(")")
        return Ok(Expr.Call("substring", args, false))
    }
    if t.kind == T_IDENT && t.text == "position" && p.isKw("(") {
        // position(a IN b): b's place of a; a is read above IN's level
        p.pos += 1
        let a = try p.catExpr()
        try p.expectKw("in")
        let b = try p.expr()
        try p.expectKw(")")
        return Ok(Expr.Call("position", [b, a], false))
    }
    if t.kind == T_IDENT && t.text == "overlay" && p.isKw("(") && p.sqlForm() {
        // overlay(x PLACING y FROM n [FOR m])
        p.pos += 1
        var args: []Expr = [try p.expr()]
        try p.expectKw("placing")
        append(mut &args, try p.expr())
        try p.expectKw("from")
        append(mut &args, try p.expr())
        if p.acceptKw("for") { append(mut &args, try p.expr()) }
        try p.expectKw(")")
        return Ok(Expr.Call("overlay", args, false))
    }
    if t.kind == T_IDENT && t.text == "trim" && p.isKw("(") {
        // trim([LEADING | TRAILING | BOTH] [chars] FROM x), or trim(x [, chars]):
        // ltrim, rtrim or btrim of x and chars (9.82)
        p.pos += 1
        var f = "btrim"
        var std = false
        if p.acceptKw("leading") { f = "ltrim"; std = true } else if p.acceptKw("trailing") { f = "rtrim"; std = true } else if p.acceptKw("both") { std = true }
        var chars: []Expr = []
        if !p.isKw("from") {
            let first = try p.expr()
            if p.acceptKw("from") {
                let x = try p.expr()
                try p.expectKw(")")
                return Ok(Expr.Call(f, [x, first], false))
            }
            if std { return Err(near(&p.peek())) }
            // trim(x [, chars])
            var args: []Expr = [first]
            while p.acceptKw(",") { append(mut &args, try p.expr()) }
            try p.expectKw(")")
            return Ok(Expr.Call("btrim", args, false))
        }
        try p.expectKw("from")
        let x = try p.expr()
        try p.expectKw(")")
        return Ok(Expr.Call(f, [x], false))
    }
    // T-SQL: NEXT VALUE FOR [schema.]sequence
    if p.tsql && t.kind == T_IDENT && t.text == "next" && p.isKw("value") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "for" {
        p.pos += 2
        let n = try p.qname()
        append(mut &p.seqs, n.clone())
        return Ok(Expr.Call("nextval", [Expr.Lit(Val.Text(n))], false))
    }
    // SYSTEM_USER (PostgreSQL 16, T-SQL): a keyword, not called (SYSTEM_USER() is a syntax error in both)
    if t.kind == T_IDENT && t.text == "system_user" && !p.ora && !p.isKw(".") {
        if p.isKw("(") { return Err(near(&p.peek().clone())) }
        append(mut &p.seqs, CAT_MARK)
        return Ok(Expr.Call(if p.tsql { "#suser_sname" } else { "system_user" }, [], false))
    }
    if t.kind == T_IDENT && (t.text == "current_user" || t.text == "session_user" || t.text == "user" || t.text == "current_role" ||
                             t.text == "current_schema" || t.text == "current_catalog") && !p.isKw("(") && !p.isKw(".") {
        append(mut &p.seqs, CAT_MARK)
        return Ok(Expr.Call(if t.text == "user" || t.text == "current_role" { "current_user" } else { t.text.clone() }, [], false))
    }
    if t.kind == T_IDENT && t.text == "array" && p.isKw("(") && (p.peekAt(1).text == "select" || p.peekAt(1).text == "with" || p.parenAt(1)) {
        p.pos += 1
        return p.arrayOfSub()
    }
    if t.kind == T_IDENT && t.text == "array" && p.isKw("[") {
        // ARRAY[a, b, ...]: an array of the values
        p.pos += 1
        var xs: []Expr = []
        if !p.isKw("]") {
            append(mut &xs, try p.expr())
            while p.acceptKw(",") { append(mut &xs, try p.expr()) }
        }
        try p.expectKw("]")
        return Ok(Expr.Call("array", xs, false))
    }
    if t.kind == T_IDENT && t.text == "exists" && p.isKw("(") {
        p.pos += 1
        return Ok(subRef("#exists", try p.subquery(SUB_EXISTS)))
    }
    if t.kind == T_NUM && strings.startsWith(&t.text, "0x") {
        // T-SQL's 0x literal: a varbinary (as SQL Server's: lexdb_bind's binary rules read one as a number beside a number)
        let h = t.text[2..len(t.text)]
        var b = ""
        var i = 0
        if len(h) % 2 == 1 {
            b.addByte(byte(hexDigit(h[0])))
            i = 1
        }
        while i + 1 < len(h) {
            b.addByte(byte(hexDigit(h[i]) * 16 + hexDigit(h[i + 1])))
            i += 2
        }
        return Ok(Expr.Lit(Val.Bytes(b)))
    }
    if t.kind == T_NUM {
        if !strings.contains(&t.text, ".") && !strings.contains(&t.text, "e") && !strings.contains(&t.text, "E") {
            match strings.parseIntOpt(&t.text) {
                Some(n) { return Ok(Expr.Lit(Val.Int(n))) }
                None {}
            }
        }
        match Decimal.parse(&t.text) {
            Ok(d) { return Ok(Expr.Lit(Val.Num(d))) }
            Err(_) { return Err(lexdb_base.err("22003", &("numeric literal out of range: " + t.text))) }
        }
    }
    if t.kind == T_STR { return Ok(Expr.Lit(if p.ora && len(t.text) == 0 { Val.Null } else { Val.Text(t.text.clone()) })) }     // Oracle: '' is NULL
    if t.kind == T_VAR { return p.variable(&t) }
    if t.kind == T_PARAM {
        let n = strings.parseIntOpt(&t.text).unwrapOr(0)
        if n < 1 || n > 65535 { return Err(near(&t)) }
        if n > p.params { p.params = n }
        return Ok(Expr.Param(n))
    }
    if t.kind == T_OP && t.text == "(" {
        if p.isKw("select") || p.isKw("with") || p.parenQuery() { return Ok(subRef("#sub", try p.subquery(SUB_SCALAR))) }
        let e = try p.expr()
        if p.isKw(",") {
            // (a, b, ...): a row (9.94), for comparisons
            var xs: []Expr = [e]
            while p.acceptKw(",") { append(mut &xs, try p.expr()) }
            try p.expectKw(")")
            return Ok(Expr.Call("row", xs, false))
        }
        try p.expectKw(")")
        return Ok(e)
    }
    if t.kind == T_IDENT {
        // the SQL/JSON words: asked only of a name that starts as they do, so other names pay one look
        if len(t.text) >= 4 && (t.text[0] == 'j' || t.text[0] == 'i') && t.text[1] == 's' {
            match try p.jsonPrimary(&t.text) {
                Some(x) { return Ok(x) }
                None {}
            }
        }
        match t.text {
            "null" { return Ok(Expr.Lit(Val.Null)) }
            "true" { return Ok(Expr.Lit(Val.Bool(true))) }
            "false" { return Ok(Expr.Lit(Val.Bool(false))) }
            "cast" {
                try p.expectKw("(")
                let e = try p.expr()
                try p.expectKw("as")
                let ty = try p.typeName()
                try p.expectKw(")")
                if p.tsql { return Ok(tsqlCast(e, ty, None)) }
                // Oracle's CAST(x AS BOOLEAN): any number not 0 true, as T-SQL's bit (lexdb_ops.coerce)
                if p.ora && ty.kind == K_BOOL { return Ok(Expr.Cast(e, TypeName{kind: K_BOOL, oid: OID_BOOL, prec: 0, scale: 0, len: 1})) }
                if p.ora { return Ok(p.oraCast(e, ty)) }
                return Ok(pgCast(e, ty))
            }
            // the date and time keywords that are not called (9.76)
            "current_date", "current_timestamp", "localtimestamp", "current_time", "localtime" {
                if p.tsql && t.text == "current_timestamp" { return Ok(Expr.Call("localtimestamp", [], false)) }     // GETDATE()
                if p.ora && t.text == "current_timestamp" {
                    // a TIMESTAMP WITH TIME ZONE at the session zone's offset
                    if p.acceptKw("(") {
                        let n = try p.intLit()
                        try p.expectKw(")")
                        return Ok(Expr.Call("#ora_curts", [Expr.Lit(Val.Int(n))], false))
                    }
                    return Ok(Expr.Call("#ora_curts", [], false))
                }
                if p.acceptKw("(") {
                    let n = try p.intLit()        // a precision: rounded to it
                    try p.expectKw(")")
                    return Ok(Expr.Call(t.text.clone(), [Expr.Lit(Val.Int(n))], false))
                }
                return Ok(Expr.Call(t.text.clone(), [], false))
            }
            "extract" {
                if p.isKw("(") {
                    // EXTRACT(field FROM x): date_part('field', x), named extract (PostgreSQL 14's column name)
                    p.pos += 1
                    let f = p.next()
                    if f.kind != T_IDENT && f.kind != T_STR && f.kind != T_QIDENT { return Err(near(&f)) }
                    try p.expectKw("from")
                    let x = try p.expr()
                    try p.expectKw(")")
                    return Ok(Expr.Call(if p.ora { "#ora_extract" } else { "extract" }, [Expr.Lit(Val.Text(strings.toLowerAscii(&f.text))), x], false))
                }
            }
            "date", "time", "timestamp", "timestamptz", "interval" {
                // a typed literal: date '2026-11-11', timestamp(3) with time zone '...'
                let at = p.pos
                p.pos -= 1
                // (PostgreSQL: INTERVAL '1' YEAR, not INTERVAL YEAR '1')
                if t.text == "interval" && !p.ora && !p.tsql {
                    let f = p.peekAt(1)
                    if f.kind == T_IDENT && (f.text == "year" || f.text == "month" || f.text == "day" || f.text == "hour" || f.text == "minute" || f.text == "second") && p.peekAt(2).kind == T_STR {
                        return Err(near(&f))
                    }
                }
                match p.typeName() {
                    Ok(ty) {
                        if p.peek().kind == T_STR {
                            var lit = p.next().text
                            var ty2 = ty
                            if !p.ora && !p.tsql && t.text == "interval" && ty.prec != 1 { try p.ivalFields(mut &ty2) }
                            if !p.ora && !p.tsql && t.text == "interval" && ty.prec == 1 && ty.len == 0 {
                                // (INTERVAL(p) '...' takes no fields after it)
                                let f = p.peek().clone()
                                if f.kind == T_IDENT && (f.text == "year" || f.text == "month" || f.text == "day" || f.text == "hour" || f.text == "minute" || f.text == "second") { return Err(near(&f)) }
                            }
                            if p.ora && t.text == "interval" {
                                // INTERVAL '1' DAY, INTERVAL '1-2' YEAR TO MONTH, INTERVAL '1 02:03:04' DAY(2) TO SECOND(3)
                                let u = p.peek().clone()
                                if u.kind == T_IDENT && (u.text == "day" || u.text == "month" || u.text == "year" || u.text == "hour" || u.text == "minute" || u.text == "second") {
                                    p.pos += 1
                                    if p.acceptKw("(") {
                                        let k = try p.intLit()
                                        if p.acceptKw(",") { let k2 = try p.intLit() }
                                        try p.expectKw(")")
                                    }
                                    if p.acceptKw("to") {
                                        let dash = strings.indexOf(&lit, "-", 1)
                                        let sp = strings.indexOf(&lit, " ", 0)
                                        let sg = if strings.startsWith(&lit, "-") { "-" } else { "" }
                                        if u.text == "year" && dash > 0 { lit = lit[0..dash].toStr() + " year " + sg + lit[dash + 1..len(lit)].toStr() + " month" }
                                        else if u.text == "day" && sp > 0 { lit = lit[0..sp].toStr() + " day " + sg + lit[sp + 1..len(lit)].toStr() }
                                        // DAY TO HOUR's '1 12' is 12 hours (not seconds); MINUTE TO SECOND's '30:15' minutes and seconds
                                        if p.isKw("hour") && !strings.contains(&lit, ":") { lit = lit + " hour" }
                                        if u.text == "minute" && p.isKw("second") && strings.contains(&lit, ":") { lit = sg + "0:" + (if len(sg) > 0 { lit[1..len(lit)].toStr() } else { lit.clone() }) }
                                        p.pos += 1
                                        if p.acceptKw("(") {
                                            let k = try p.intLit()
                                            try p.expectKw(")")
                                        }
                                    } else {
                                        lit = lit + " " + u.text
                                    }
                                }
                            }
                            if p.ora && t.text == "timestamp" && ty.oid == OID_TS && oraLitZone(&lit) {
                                var tz = lexdb_sql.timeType(OID_TSTZ)
                                tz.prec = 1
                                tz.len = lexdb_sql.TSZ_LEN
                                tz.scale = ty.scale
                                return Ok(p.oraCast(Expr.Lit(Val.Text(lit)), tz))
                            }
                            return Ok(Expr.Cast(Expr.Lit(Val.Text(lit)), ty2))
                        }
                    }
                    Err(_) {}
                }
                p.pos = at
            }
            else {}
        }
        // left( and right( are functions, as in PostgreSQL
        let fn2 = (t.text == "left" || t.text == "right") && p.isKw("(")
        if lexdb_sql.isReserved(&t.text) && !fn2 { return Err(near(&t)) }
    }
    if p.tsql && t.kind == T_IDENT && p.isKw("(") && (t.text == "convert" || t.text == "try_convert" || t.text == "try_cast") {
        p.pos += 1
        var x = Expr.Lit(Val.Null)
        var ty = TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}
        var style: Option[Expr] = None
        if t.text == "try_cast" {
            x = try p.expr()
            try p.expectKw("as")
            ty = try p.typeName()
        } else {
            ty = try p.typeName()
            try p.expectKw(",")
            x = try p.expr()
            if p.acceptKw(",") { style = Some(try p.expr()) }
        }
        try p.expectKw(")")
        let c = tsqlCast(x, ty, style)
        return Ok(if t.text == "convert" { c } else { Expr.Call("#try", [c], false) })
    }
    if t.kind == T_IDENT || t.kind == T_QIDENT {
        if p.isKw("(") && (t.kind == T_IDENT || p.ora) {
            p.pos += 1
            var args: []Expr = []
            var argNames: []str = []        // name => value arguments' names ("" a positional one)
            var star = false
            var fname = t.text.clone()
            if len(qual) > 0 {
                fname = qual + "." + fname
                p.udf = true
            }
            if p.ora && fname == "listagg" { fname = "string_agg" }
            if (p.ora || p.tsql) && (len(fname) > 6 || (p.ora && fname == "avg" && p.mr == 0)) { fname = newAggName(fname, p.ora) }
            if p.mr > 0 && fname == "count" && (p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT) && p.peekAt(1).kind == T_OP &&
               p.peekAt(1).text == "." && p.peekAt(2).kind == T_OP && p.peekAt(2).text == "*" {
                // COUNT(v.*): the rows mapped to v
                let v = p.peek().text.clone()
                p.pos += 3
                try p.expectKw(")")
                return Ok(Expr.Call("count", [Expr.Lit(Val.Text(v))], true))
            }
            if p.acceptKw("*") {
                star = true
            } else if !p.isKw(")") {
                // agg(DISTINCT x): the name carries it, "count distinct"
                if p.acceptKw("distinct") { fname = fname + " distinct" } else { let al = p.acceptKw("all") }
                append(mut &argNames, p.namedArg())
                append(mut &args, try p.callArg(len(qual) > 0))
                while p.acceptKw(",") {
                    if p.ora && (p.isKw("end") || p.isKw("start")) && fname == "time_bucket" {
                        // Oracle's TIME_BUCKET(..., START | END): 0 or 1
                        append(mut &argNames, "")
                        append(mut &args, Expr.Lit(Val.Int(if p.isKw("end") { 1 } else { 0 })))
                        p.pos += 1
                        continue
                    }
                    append(mut &argNames, p.namedArg())
                    append(mut &args, try p.callArg(len(qual) > 0))
                }
                if p.acceptKw("order") {
                    // agg(x ORDER BY k [ASC | DESC] [NULLS FIRST | LAST], ...): the
                    // keys follow the arguments, the name carries their order:
                    // a ascending (NULLs last), A with NULLs first, d
                    // descending (NULLs first), D with NULLs last
                    try p.expectKw("by")
                    var dirs = ""
                    while true {
                        append(mut &args, try p.expr())
                        var desc = false
                        if p.acceptKw("desc") { desc = true } else { let asc = p.acceptKw("asc") }
                        var flip = false
                        if p.acceptKw("nulls") {
                            if p.acceptKw("first") { flip = !desc } else {
                                try p.expectKw("last")
                                flip = desc
                            }
                        }
                        dirs = dirs + (if desc { if flip { "D" } else { "d" } } else { if flip { "A" } else { "a" } })
                        if !p.acceptKw(",") { break }
                    }
                    fname = fname + " order:" + dirs
                }
            }
            try p.expectKw(")")
            if p.ora && len(paramsOf(&fname)) == 0 && anyNamed(&argNames) { args = oraNamed(args, &argNames) }
            else if len(argNames) > 0 || len(paramsOf(&fname)) > len(args) { args = try namedArgs(&fname, args, &argNames) }
            if p.ora && fname == "string_agg" && len(args) == 1 { append(mut &args, Expr.Lit(Val.Text(""))) }     // LISTAGG(x): no separator
            if fname == "approx_percentile" && !star {
                if p.isKw("within") {
                    if len(args) != 1 { return Err(lexdb_base.err("42883", "approx_percentile(p) WITHIN GROUP requires 1 percentile argument")) }
                    p.pos += 1
                    try p.expectKw("group")
                    try p.expectKw("(")
                    try p.expectKw("order")
                    try p.expectKw("by")
                    let key = try p.expr()
                    var desc = false
                    if p.acceptKw("desc") { desc = true } else { let asc = p.acceptKw("asc") }
                    if p.acceptKw("nulls") {
                        if !p.acceptKw("first") { try p.expectKw("last") }
                    }
                    try p.expectKw(")")
                    let fr = replace(mut &args[0], Expr.Lit(Val.Null))
                    args = [key, fr]
                    if desc { fname = "approx_percentile order:d" }
                } else if len(args) != 2 {
                    return Err(lexdb_base.err("42883", "approx_percentile requires 2 arguments (expr, percentile) or WITHIN GROUP (ORDER BY expr)"))
                }
            } else if p.tsql && (fname == "approx_percentile_cont" || fname == "approx_percentile_disc") && !star {
                // SQL Server 2022's APPROX_PERCENTILE_CONT / _DISC (S21): PostgreSQL's ordered-set aggregates (exact; SQL
                // Server's estimate is exact on these sizes), no OVER (4113)
                if !p.isKw("within") { return Err(lexdb_base.err("TS10754", &("The function '" + fname + "' must have a WITHIN GROUP clause."))) }
                if len(args) != 1 { return Err(lexdb_base.err("TS174", &("The " + fname + " function requires 1 argument(s)."))) }
                p.pos += 1
                try p.expectKw("group")
                try p.expectKw("(")
                try p.expectKw("order")
                try p.expectKw("by")
                let key = try p.expr()
                var desc = false
                if p.acceptKw("desc") { desc = true } else { let asc = p.acceptKw("asc") }
                try p.expectKw(")")
                if p.isKw("over") {
                    return Err(lexdb_base.err("TS4113", &("The function '" + fname + "' is not a valid windowing function, and cannot be used with the OVER clause.")))
                }
                let fr = replace(mut &args[0], Expr.Lit(Val.Null))
                args = [key, fr]
                fname = fname[7..len(fname)] + " order:" + (if desc { "d" } else { "a" }) + " dia:t"
            } else if (fname == "percentile_cont" || fname == "percentile_disc") && !star {
                // percentile_cont(f) WITHIN GROUP (ORDER BY x [DESC]) (lexdb_pct): the call's arguments are x, the
                // key, then f; the name carries the direction and, for SQL Server and Oracle, the dialect (" dia:")
                let up = strings.toUpperAscii(&fname)
                if !p.isKw("within") {
                    if p.tsql && !p.isKw("over") { return Err(lexdb_base.err("TS10753", &("The function '" + up + "' must have an OVER clause."))) }
                    if p.tsql { return Err(lexdb_base.err("TS10754", &("The function '" + up + "' must have a WITHIN GROUP clause."))) }
                    return Err(lexdb_base.err("42883", &("function " + fname + " does not exist")))
                }
                if len(args) != 1 {
                    if p.tsql { return Err(lexdb_base.err("TS174", &("The " + fname + " function requires 1 argument(s)."))) }
                    return Err(lexdb_base.err("42883", &("function " + fname + " does not exist")))
                }
                p.pos += 1
                try p.expectKw("group")
                try p.expectKw("(")
                try p.expectKw("order")
                try p.expectKw("by")
                let key = try p.expr()
                var desc = false
                if p.acceptKw("desc") { desc = true } else { let asc = p.acceptKw("asc") }
                if !p.tsql && p.acceptKw("nulls") {
                    if !p.acceptKw("first") { try p.expectKw("last") }
                }
                if p.isKw(",") {
                    if p.tsql { return Err(lexdb_base.err("TS10751", &("The ORDER BY in WITHIN GROUP clause of '" + up + "' function must have exactly one expression."))) }
                    return Err(lexdb_base.err("42883", &("function " + fname + " does not exist")))
                }
                try p.expectKw(")")
                let fr = replace(mut &args[0], Expr.Lit(Val.Null))
                args = [key, fr]
                fname = fname + " order:" + (if desc { "d" } else { "a" }) + (if p.tsql { " dia:t" } else if p.ora { " dia:o" } else { "" })
                if p.isKw("over") {
                    if !p.tsql && !p.ora { return Err(lexdb_base.err("0A000", &("OVER is not supported for ordered-set aggregate " + fname))) }
                } else if p.tsql { return Err(lexdb_base.err("TS10753", &("The function '" + up + "' must have an OVER clause."))) }
            } else if (p.tsql || p.ora) && p.isKw("within") {
                // STRING_AGG(x, sep) WITHIN GROUP (ORDER BY k [ASC | DESC], ...):
                // the keys after the arguments, as agg(... ORDER BY ...); SQL
                // Server's NULLs first going up, last going down
                p.pos += 1
                try p.expectKw("group")
                try p.expectKw("(")
                try p.expectKw("order")
                try p.expectKw("by")
                var dirs = ""
                while true {
                    append(mut &args, try p.expr())
                    var desc = false
                    if p.acceptKw("desc") { desc = true } else { let asc = p.acceptKw("asc") }
                    dirs = dirs + (if p.ora { if desc { "d" } else { "a" } } else { if desc { "D" } else { "A" } })
                    if !p.acceptKw(",") { break }
                }
                try p.expectKw(")")
                fname = fname + " order:" + dirs
            }
            if p.acceptKw("filter") {
                // agg(...) FILTER (WHERE cond): the condition is the last argument
                try p.expectKw("(")
                try p.expectKw("where")
                append(mut &args, try p.expr())
                try p.expectKw(")")
                fname = fname + " filter"
            }
            try p.nullsMark(mut &fname, mut &args)
            if lexdb_sql.isCatFn(&fname) { append(mut &p.seqs, CAT_MARK) }
            if fname == "current_setting" || fname == "set_config" { append(mut &p.seqs, SET_MARK) }
            if (fname == "nextval" || fname == "currval" || fname == "setval") && len(args) > 0 {
                match lexdb_sql.litText(&args[0]) {
                    Some(n) { append(mut &p.seqs, n) }
                    None {
                        match serialArgs(&args[0]) {
                            Some(m) { append(mut &p.seqs, SERIAL_MARK + m) }
                            None {}
                        }
                    }
                }
            }
            if p.mr > 0 {
                if p.isKw("over") {
                    return Err(p.mrErr(30483, "window  functions are not allowed here", "42P20", 4108,
                                       "window functions are not allowed in MATCH_RECOGNIZE"))
                }
                if fname == "prev" || fname == "next" || fname == "first" || fname == "last" || fname == "classifier" || fname == "match_number" {
                    if (fname == "classifier" || fname == "match_number") && len(args) > 0 {
                        return Err(p.mrNear(907, "missing right parenthesis"))
                    }
                    return Ok(Expr.Call(fname, args, false))
                }
            }
            if len(qual) > 0 { return Ok(Expr.Call(fname, args, star)) }
            if p.tsql && !p.isKw("over") { return p.tsqlCall(&fname, args, star) }
            if p.ora && !p.isKw("over") { return p.oraCall(&fname, args, star) }
            if p.acceptKw("over") {
                // a window call (9.46): kept in the query, named here by number
                var d = try p.over()
                var copied: []Expr = []
                for a in args { append(mut &copied, cloneE(&a)) }
                d.call = Expr.Call(fname.clone(), copied, star)
                append(mut &p.wins, d)
                return Ok(Expr.Call("#win", [Expr.Lit(Val.Int(len(p.wins) - 1)), Expr.Call(fname, args, star)], false))
            }
            return Ok(Expr.Call(fname, args, star))
        }
        var name = t.text.clone()
        if p.acceptKw(".") {
            let col = try p.name()
            if p.isKw("(") && !p.tsql && !p.oraOuterMark() {
                // schema.function(arguments): the call of a function of a schema (a function of the user's; Oracle's: owner.function)
                p.pos += 1
                var fargs: []Expr = []
                var fnames: []str = []      // Oracle's name => value arguments' names ("" a positional one)
                if !p.acceptKw(")") {
                    while true {
                        append(mut &fnames, if p.ora { p.namedArg() } else { "" })
                        append(mut &fargs, try p.expr())
                        if !p.acceptKw(",") { break }
                    }
                    try p.expectKw(")")
                }
                if p.ora && anyNamed(&fnames) { fargs = oraNamed(fargs, &fnames) }
                return Ok(Expr.Call(if t.text == "pg_catalog" { col } else { lexdb_sql.qual(&t.text, &col) }, fargs, false))
            }
            name = t.text + "." + col     // qualified: table (or alias) dot column
            if p.acceptKw(".") {
                // schema.table.column: the table's columns are qualified by
                // its name in FROM (lenient: the schema is not checked)
                let c3 = try p.name()
                name = col + "." + c3
            }
        }
        return Ok(Expr.Col(name, -1))
    }
    return Err(near(&t))
}

// T-SQL's OUTPUT list, after OUTPUT: its items in out, and INTO target [(columns)] (a table variable, a #temporary or
// a table) in s.outInto and s.outCols: the rows the statement outputs are inserted there (lexdb_tsql). A second OUTPUT
// after INTO (rows to the client as well) is not supported yet.
fn (p: mut &P) outputList(s: mut &Stmt, out: mut &[]SelItem): Result[Unit, lexdb_base.DbErr] {
    try p.itemList(out)
    for it in out {
        match it.expr {
            Some(x) { if hasSubRef(&x) { return Err(lexdb_base.err("TS10705", "Subqueries are not allowed in the OUTPUT clause.")) } }
            None {}
        }
    }
    if !p.acceptKw("into") { return Ok(Unit{}) }
    let t = p.peek().clone()
    if t.kind == T_VAR { return Err(lexdb_base.err("TS1087", &("Must declare the table variable \"" + t.text + "\"."))) }
    s.outInto = try p.rname()
    if p.isKw("(") && !p.selectNext() {
        p.pos += 1
        append(mut &s.outCols, try p.name())
        while p.acceptKw(",") { append(mut &s.outCols, try p.name()) }
        try p.expectKw(")")
    }
    if p.isKw("output") { return Err(lexdb_base.err("0A000", "lexdb: OUTPUT INTO followed by an OUTPUT clause that returns rows is not supported yet")) }
    return Ok(Unit{})
}

// T-SQL's UPDATE and DELETE (design/lexdb-tds.md S3): a target named in
// FROM (UPDATE p SET ... FROM Posts AS p JOIN ...; UPDATE Posts ... FROM
// Posts JOIN ...) is that FROM item, taken out of the list, its join's
// condition the WHERE's; OUTPUT's items are RETURNING's, INSERTED.c the
// row's c and DELETED.c (an UPDATE's) the old row's (#old).
fn tsqlDml(s: mut &Stmt, out: []SelItem): Result[Unit, lexdb_base.DbErr] {
    var at = -1
    for i in 0..len(s.from) {
        if s.from[i].sub < 0 && (s.from[i].alias == s.table || (s.from[i].table == s.table && s.from[i].alias == lexdb_sql.baseName(&s.from[i].table))) { at = i }
    }
    if at >= 0 {
        var all = replace(mut &s.from, [])
        var keep: []FromItem = []
        for k in 0..len(all) {
            var f = replace(mut &all[k], FromItem{table: "", alias: "", join: 0, on: None, sub: -1, cols: [], work: -1, lateral: false, using: [], natural: false, comma: false})
            if k == at {
                s.table = f.table.clone()
                if f.alias != lexdb_sql.baseName(&f.table) { s.alias = f.alias.clone() }
                match replace(mut &f.on, None) {
                    Some(c) {
                        s.where = match replace(mut &s.where, None) {
                            Some(w) { Some(Expr.Bin("and", c, w)) }
                            None { Some(c) }
                        }
                    }
                    None {}
                }
            } else { append(mut &keep, f) }
        }
        if len(keep) > 0 && keep[0].join == J_FIRST { keep[0].join = J_CROSS }
        s.from = keep
    }
    if len(out) == 0 { return Ok(Unit{}) }
    let q = if len(s.alias) > 0 { s.alias.toStr() } else { lexdb_sql.baseName(&s.table) }
    var items = out
    for i in 0..len(items) {
        if items[i].star {
            if items[i].qual == "inserted" || items[i].qual == "deleted" { items[i].qual = q.clone() }
            continue
        }
        match replace(mut &items[i].expr, None) {
            Some(x) { items[i].expr = Some(outputRefs(&x, &q, s.kind == S_UPDATE)) }
            None {}
        }
    }
    s.items = items
    return Ok(Unit{})
}

fn outputRefs(x: &Expr, q: &str, upd: bool): Expr {
    match x {
        Expr.Col(n, _) {
            if n == "$action" { return Expr.Call("#maction", [], false) }
            let d = strings.indexOf(&n, ".", 0)
            if d < 0 { return Expr.Col(n.toStr(), -1) }
            let t = n[0..d].toStr()
            let c = n[d + 1..len(n)].toStr()
            if t == "inserted" { return Expr.Col(q + "." + c, -1) }
            if t == "deleted" {
                if upd { return Expr.Call("#old", [Expr.Col(q + "." + c, -1)], false) }
                return Expr.Col(q + "." + c, -1)
            }
            return Expr.Col(n.toStr(), -1)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.toStr(), outputRefs(&a, q, upd)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.toStr(), outputRefs(&a, q, upd), outputRefs(&b, q, upd)) }
        Expr.Cast(a, t) { return Expr.Cast(outputRefs(&a, q, upd), t) }
        Expr.IsNull(a, n) { return Expr.IsNull(outputRefs(&a, q, upd), n) }
        Expr.Call(f, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, outputRefs(&a, q, upd)) }
            return Expr.Call(f.toStr(), out, star)
        }
        else { return cloneE(x) }
    }
}

// T-SQL's CAST and CONVERT (design/lexdb-tds.md S3): to a string of n
// characters a longer value is cut (SQL Server's), a date or time with a
// style written so (lexdb_tsqlfn's #datestyle).
fn tsqlCast(x: Expr, ty: TypeName, style: Option[Expr]): Expr {
    var v = x
    var sty = style
    if ty.kind == K_INT { v = Expr.Call("#tint", [v, Expr.Lit(Val.Int(if ty.oid == OID_INT8 { 8 } else if ty.oid == OID_INT4 { 4 } else if ty.prec == lexdb_dialect.TS_TINYINT { 1 } else { 2 }))], false) }
    if ty.kind == K_BYTEA && ty.prec != lexdb_dialect.TS_IMAGE {
        // varbinary(n), binary(n): a string by its bytes (style 1 or 2: its hex digits), a number by its big-endian bytes
        var st = Expr.Lit(Val.Int(0))
        match replace(mut &sty, None) {
            Some(sx) { st = sx }
            None {}
        }
        v = Expr.Call("#tobin", [v, Expr.Lit(Val.Int(ty.len)), Expr.Lit(Val.Int(if ty.prec == lexdb_dialect.TS_BINARY { 1 } else { 0 })), st], false)
    }
    if ty.kind == K_UUID { v = Expr.Call("#bin2uuid", [v], false) }
    if ty.kind == K_TEXT {
        // (a varbinary: its bytes as characters, style 1 or 2 its hex digits)
        var bst = Expr.Lit(Val.Int(0))
        match sty {
            Some(sx) { bst = lexdb_sql.cloneExpr(&sx) }
            None {}
        }
        // a date or time as the style writes it first (any other value passes), then the cast's text of what is left
        match replace(mut &sty, None) {
            Some(st) { v = Expr.Call("#datestyle", [v, st], false) }
            None {}
        }
        v = Expr.Call("#bin2str", if ty.len > 0 { [v, bst, Expr.Lit(Val.Int(ty.len))] } else { [v, bst] }, false)
        if ty.len > 0 {
            let text = TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}
            v = Expr.Call("left", [Expr.Cast(v, text), Expr.Lit(Val.Int(ty.len))], false)
        }
    }
    return Expr.Cast(v, ty)
}

// A date part's name as T-SQL's date functions take it (day, dd, d), canonical.
fn datePart(x: &Expr): Option[Expr] {
    var w = ""
    match x {
        Expr.Col(n, _) { w = n.clone() }
        Expr.Lit(v) { match v { Val.Text(s) { w = strings.toLowerAscii(&s) } else {} } }
        else {}
    }
    let c = match w {
        "year", "yy", "yyyy" { "year" }
        "quarter", "qq", "q" { "quarter" }
        "month", "mm", "m" { "month" }
        "dayofyear", "dy", "y" { "dayofyear" }
        "day", "dd", "d" { "day" }
        "week", "wk", "ww" { "week" }
        "weekday", "dw", "w" { "weekday" }
        "hour", "hh" { "hour" }
        "minute", "mi", "n" { "minute" }
        "second", "ss", "s" { "second" }
        "millisecond", "ms" { "millisecond" }
        "microsecond", "mcs" { "microsecond" }
        "nanosecond", "ns" { "nanosecond" }
        "tzoffset", "tz" { "tzoffset" }
        else { "" }
    }
    if len(c) == 0 { return None }
    return Some(Expr.Lit(Val.Text(c)))
}

// T-SQL's functions on lexdb's (or lexdb_tsqlfn's, named #...) where they
// differ (design/lexdb-tds.md S3); any other call as it is.
fn (p: mut &P) tsqlCall(name: &str, args: []Expr, star: bool): Result[Expr, lexdb_base.DbErr] {
    let n = len(args)
    var a = args
    let float8 = TypeName{kind: K_FLOAT, oid: OID_FLOAT8, prec: 0, scale: 0, len: 0}
    if strings.startsWith(name, "count_big") { return Ok(Expr.Call("count" + name[9..len(name)], a, star)) }
    // SQL Server 2022's bit functions (S21; lexdb_tsqlfn, the value's width from its type: lexdb_bind's hint)
    if (name == "bit_count" && n == 1) || ((name == "left_shift" || name == "right_shift" || name == "get_bit") && n == 2) ||
       (name == "set_bit" && (n == 2 || n == 3)) {
        let f = if name == "bit_count" { "#tbit_count" } else if name == "left_shift" { "#tbit_shl" } else if name == "right_shift" { "#tbit_shr" }
                else if name == "get_bit" { "#tbit_get" } else { "#tbit_set" }
        return Ok(Expr.Call(f.toStr(), a, false))
    }
    if name == "bit_count" || name == "left_shift" || name == "right_shift" || name == "get_bit" || name == "set_bit" {
        return Err(lexdb_base.err("TS174", &("The " + name + " function requires " + (if name == "bit_count" { "1" } else if name == "set_bit" { "2 to 3" } else { "2" }) + " argument(s).")))
    }
    if n == 0 && (name == "error_number" || name == "error_message" || name == "error_severity" || name == "error_state" ||
                  name == "error_line" || name == "error_procedure" || name == "xact_state") {
        // the batch's values for the error a CATCH block handles (lexdb_tsql)
        return p.variable(&Tok{kind: T_VAR, text: "@@" + name, at: 0, spell: ""})
    }
    if name == "object_id" && n >= 1 {
        append(mut &p.seqs, CAT_MARK)
        if n >= 2 { return Ok(Expr.Call("#object_id", [replace(mut &a[0], Expr.Lit(Val.Null)), replace(mut &a[1], Expr.Lit(Val.Null))], false)) }
        return Ok(Expr.Call("#object_id", [replace(mut &a[0], Expr.Lit(Val.Null))], false))
    }
    // SQL Server's catalog functions (design/lexdb-tds.md, section 13)
    match try p.tsqlCatCall(name, mut &a) {
        Some(x) { return Ok(x) }
        None {}
    }
    if name == "scope_identity" && n == 0 {
        // the batch's @@IDENTITY (refreshed before each statement): a value WHERE can read
        return p.variable(&Tok{kind: T_VAR, text: "@@identity", at: 0, spell: ""})
    }
    // SQL Server JSON functions
    if name == "json_modify" && n == 3 { return Ok(Expr.Call("#json_modify", a, false)) }
    if name == "json_path_exists" && n == 2 { return Ok(Expr.Call("#tsql_json_path_exists", a, false)) }
    if name == "json_contains" && (n == 2 || n == 3) { return Ok(Expr.Call("#tsql_json_contains", a, false)) }
    // SQL Server 2025's REGEXP_ functions: lexdb's, their omitted arguments SQL Server's defaults (REGEXP_REPLACE's
    // occurrence 0: every match), their flags read as SQL Server's (lexdb_sql.RE_TSQL)
    if strings.startsWith(name, "regexp_") {
        // the place of the flags, and the defaults of the arguments before it
        var defs: []Expr = []
        var fk = -1
        match name.toStr() {
            "regexp_like" { fk = 2 }
            "regexp_replace" { fk = 5; defs = [Expr.Lit(Val.Int(1)), Expr.Lit(Val.Int(0))] }
            "regexp_substr" { fk = 4; defs = [Expr.Lit(Val.Int(1)), Expr.Lit(Val.Int(1))] }
            "regexp_instr" { fk = 5; defs = [Expr.Lit(Val.Int(1)), Expr.Lit(Val.Int(1)), Expr.Lit(Val.Int(0))] }
            "regexp_count" { fk = 3; defs = [Expr.Lit(Val.Int(1))] }
            else {}
        }
        if fk >= 0 && n >= 2 && n <= fk + 2 {
            // (REGEXP_REPLACE's replacement is optional: the empty string, the matches removed)
            if name == "regexp_replace" && len(a) == 2 { append(mut &a, Expr.Lit(Val.Text(""))) }
            let first = fk - len(defs)
            while len(a) < fk { append(mut &a, cloneE(&defs[len(a) - first])) }
            if len(a) == fk { append(mut &a, Expr.Lit(Val.Text(""))) }
            a[fk] = tsReFlags(replace(mut &a[fk], Expr.Lit(Val.Null)))
            return Ok(Expr.Call(name.toStr(), a, false))
        }
    }
    // a NULL constant where SQL Server wants a string (a typed NULL, CAST(NULL AS varchar), is one)
    if (name == "substring" || name == "format") && n >= 1 && isNullLit(&a[0]) {
        return Err(lexdb_base.err("TS8116", &("Argument data type NULL is invalid for argument 1 of " + name + " function.")))
    }
    match name.toStr() {
        "len" { return Ok(Expr.Call("#len", a, false)) }
        // (a varbinary's SUBSTRING is bytes; its LEFT and RIGHT are characters, as SQL Server's)
        "left", "right" {
            if n == 2 { a[0] = Expr.Call("#bin2str", [replace(mut &a[0], Expr.Lit(Val.Null)), Expr.Lit(Val.Int(0))], false) }
        }
        "substring" {
            if n == 3 {
                let plain = Expr.Call("substring", [cloneE(&a[0]), cloneE(&a[1]), cloneE(&a[2])], false)
                return Ok(Expr.Call("#bsub", [plain, replace(mut &a[0], Expr.Lit(Val.Null)), replace(mut &a[1], Expr.Lit(Val.Null)), replace(mut &a[2], Expr.Lit(Val.Null))], false))
            }
        }
        "datalength" { return Ok(Expr.Call("#datalength", a, false)) }
        "replicate" { return Ok(Expr.Call("repeat", a, false)) }
        "space" { if n == 1 { return Ok(Expr.Call("repeat", [Expr.Lit(Val.Text(" ")), replace(mut &a[0], Expr.Lit(Val.Null))], false)) } }
        "stuff" { return Ok(Expr.Call("#stuff", a, false)) }
        "quotename" {
            if n < 1 || n > 2 { return Err(lexdb_base.err("TS189", "The quotename function requires 1 to 2 argument(s).")) }
            return Ok(Expr.Call("#quotename", a, false))
        }
        // T-SQL's own, not lexdb's: a bit shown as 1 (lexdb_tsqlfn)
        "concat_ws" { return Ok(Expr.Call("#concat_ws", a, false)) }
        "reverse" { return Ok(Expr.Call("#reverse", a, false)) }
        "format" {
            if n == 2 || n == 3 {
                // (a NULL format is refused when compiled; a NULL culture is one SQL Server does not support)
                if isNullLit(&a[1]) { return Err(lexdb_base.err("TS8116", "Argument data type NULL is invalid for argument 2 of format function.")) }
                if n == 3 && isNullLit(&a[2]) { return Err(lexdb_base.err("TS9818", "The culture parameter 'NULL' provided in the function call is not supported.")) }
                if isTextLit(&a[0]) { return Err(lexdb_base.err("TS8116", "Argument data type varchar is invalid for argument 1 of format function.")) }
                return Ok(Expr.Call("#format", a, false))
            }
        }
        // CHAR(n): the character of code n (0 to 255; NULL else), NCHAR(n) of code point n (needed by the REGEXP_ tests' newlines)
        "char", "nchar" {
            if n == 1 {
                let hi = if name == "char" { 255 } else { 1114111 }
                let ok = Expr.Bin("and", Expr.Bin(">=", cloneE(&a[0]), Expr.Lit(Val.Int(1))), Expr.Bin("<=", cloneE(&a[0]), Expr.Lit(Val.Int(hi))))
                return Ok(Expr.Call("case", [ok, Expr.Call("chr", [replace(mut &a[0], Expr.Lit(Val.Null))], false)], false))
            }
        }
        "isnull" { return Ok(Expr.Call("coalesce", a, false)) }
        "iif" { if n == 3 { return Ok(Expr.Call("case else", a, false)) } }
        "choose" {
            if n >= 2 {
                var xs: []Expr = []
                for i in 1..n {
                    append(mut &xs, Expr.Bin("=", cloneE(&a[0]), Expr.Lit(Val.Int(i))))
                    append(mut &xs, replace(mut &a[i], Expr.Lit(Val.Null)))
                }
                return Ok(Expr.Call("case", xs, false))
            }
        }
        "getdate", "sysdatetime" { return Ok(Expr.Call("localtimestamp", [], false)) }
        "sysdatetimeoffset" { return Ok(Expr.Call("#sysdto", [], false)) }
        "switchoffset" { if n == 2 { return Ok(Expr.Call("#switchoffset", a, false)) } }
        "todatetimeoffset" { if n == 2 { return Ok(Expr.Call("#todto", a, false)) } }
        "getutcdate", "sysutcdatetime" { return Ok(Expr.Call("#utcnow", [], false)) }
        "dateadd", "datediff", "datepart", "datename", "datediff_big" {
            if n >= 2 {
                match datePart(&a[0]) {
                    Some(dp) { a[0] = dp }
                    None { return Err(lexdb_base.err("TS155", &("'" + lexdb_sql.exprText(&a[0]) + "' is not a recognized " + name + " option."))) }
                }
                let f = if name == "datediff_big" { "#datediff" } else { "#" + name }
                // a string constant is read as a datetime (SQL Server's DATEADD of one gives a datetime)
                if name == "dateadd" && n == 3 && isTextLit(&a[2]) {
                    var dt = lexdb_sql.timeType(OID_TS)
                    dt.prec = lexdb_dialect.TS_DATETIME
                    dt.scale = 3
                    a[2] = Expr.Cast(replace(mut &a[2], Expr.Lit(Val.Null)), dt)
                }
                return Ok(Expr.Call(f, a, false))
            }
        }
        "year", "month", "day" { if n == 1 { return Ok(Expr.Call("#datepart", [Expr.Lit(Val.Text(name.toStr())), replace(mut &a[0], Expr.Lit(Val.Null))], false)) } }
        "eomonth" { return Ok(Expr.Call("#eomonth", a, false)) }
        "datefromparts" { return Ok(Expr.Call("make_date", a, false)) }
        "round" { return Ok(Expr.Call("#round", a, false)) }
        "power" { return Ok(Expr.Call("#power", a, false)) }
        "ceiling" { return Ok(Expr.Call("ceil", a, false)) }
        "sqrt", "exp", "log10", "square" {
            if n == 1 {
                let x = Expr.Cast(replace(mut &a[0], Expr.Lit(Val.Null)), float8)
                if name == "square" { return Ok(Expr.Bin("*", cloneE(&x), x)) }
                return Ok(Expr.Call(name.toStr(), [x], false))
            }
        }
        "log" {
            if n == 1 { return Ok(Expr.Call("ln", [Expr.Cast(replace(mut &a[0], Expr.Lit(Val.Null)), float8)], false)) }
            // LOG(x, base): lexdb's log takes the base first
            if n == 2 {
                let lx = Expr.Cast(replace(mut &a[0], Expr.Lit(Val.Null)), float8)
                let lb = Expr.Cast(replace(mut &a[1], Expr.Lit(Val.Null)), float8)
                return Ok(Expr.Cast(Expr.Call("log", [lb, lx], false), float8))
            }
        }
        "newid" { return Ok(Expr.Call("gen_random_uuid", [], false)) }
        "db_name" { return Ok(Expr.Call("current_database", [], false)) }
        "schema_name" { if n == 0 { return Ok(Expr.Lit(Val.Text("dbo"))) } }
        "user_name", "suser_sname", "suser_name", "original_login" {
            if n == 0 {
                append(mut &p.seqs, CAT_MARK)
                return Ok(Expr.Call("current_user", [], false))
            }
        }
        else {}
    }
    return tsqlNewCall(name, a, star)
}

// A property function's value, as SQL Server's sql_variant (lexdb_tds
// sends it so: lexdb_dialect.TS_VARIANT in prec).
fn variant(x: Expr): Expr {
    // the type it is: 1 an integer, 2 text (and NULL), 0 neither
    var k = 0
    match x {
        Expr.Lit(v) {
            match v {
                Val.Int(_) { k = 1 }
                Val.Text(_) { k = 2 }
                Val.Null { k = 2 }
                else {}
            }
        }
        Expr.Cast(_, t) { if t.kind == K_INT { k = 1 } }
        else {}
    }
    if k == 1 { return Expr.Cast(x, TypeName{kind: K_INT, oid: OID_INT4, prec: lexdb_dialect.TS_VARIANT, scale: 0, len: 0}) }
    if k == 2 { return Expr.Cast(x, TypeName{kind: K_TEXT, oid: OID_TEXT, prec: lexdb_dialect.TS_VARIANT, scale: 0, len: 0}) }
    return x
}

// A property's value as SQL Server's type gives it (lexdb_dialect.prop).
fn propExpr(pr: &lexdb_dialect.Prop): Expr {
    if !pr.found || pr.val == "\x00" { return Expr.Lit(Val.Null) }
    let n = strings.parseIntOpt(&pr.val).unwrapOr(0)
    match pr.typ.toStr() {
        "int" { return Expr.Lit(Val.Int(n)) }
        "tinyint" { return Expr.Cast(Expr.Lit(Val.Int(n)), TypeName{kind: K_INT, oid: OID_INT2, prec: lexdb_dialect.TS_TINYINT, scale: 0, len: 0}) }
        "smallint" { return Expr.Cast(Expr.Lit(Val.Int(n)), TypeName{kind: K_INT, oid: OID_INT2, prec: 0, scale: 0, len: 0}) }
        "bigint" { return Expr.Cast(Expr.Lit(Val.Int(n)), TypeName{kind: K_INT, oid: OID_INT8, prec: 0, scale: 0, len: 0}) }
        "datetime" {
            var t = lexdb_sql.timeType(OID_TS)
            t.prec = lexdb_dialect.TS_DATETIME
            t.scale = 3
            return Expr.Cast(Expr.Lit(Val.Text(pr.val.clone())), t)
        }
        else { return Expr.Lit(Val.Text(pr.val.clone())) }
    }
}

// SQL Server's catalog and property functions: a constant's value (a
// server's or a session's property named by a literal), or the executor's
// function (lexdb_exec.callCat: "#object_name", ...); None for another.
fn (p: mut &P) tsqlCatCall(name: &str, a: mut &[]Expr): Result[Option[Expr], lexdb_base.DbErr] {
    let n = len(a)
    let none: Option[Expr] = None
    if (name == "serverproperty" || name == "fulltextserviceproperty") && n == 1 {
        match lexdb_sql.litText(&a[0]) {
            Some(t) { return Ok(Some(variant(propExpr(&lexdb_dialect.prop(if name == "serverproperty" { "server" } else { "fulltext" }, &t))))) }
            None {}
        }
        return Ok(Some(Expr.Call("#" + name, replace(a, []), false)))
    }
    if name == "sessionproperty" && n == 1 {
        // the SET options drivers send: on (NUMERIC_ROUNDABORT off)
        match lexdb_sql.litText(&a[0]) {
            Some(t) {
                let o = strings.toLowerAscii(&t)
                if o == "numeric_roundabort" { return Ok(Some(variant(Expr.Lit(Val.Int(0))))) }
                if o == "ansi_nulls" || o == "ansi_padding" || o == "ansi_warnings" || o == "arithabort" || o == "concat_null_yields_null" ||
                   o == "quoted_identifier" {
                    return Ok(Some(variant(Expr.Lit(Val.Int(1)))))
                }
                return Ok(Some(variant(Expr.Lit(Val.Null))))
            }
            None { return Ok(Some(variant(Expr.Lit(Val.Null)))) }
        }
    }
    if name == "connectionproperty" && n == 1 {
        match lexdb_sql.litText(&a[0]) {
            Some(t) {
                let o = strings.toLowerAscii(&t)
                if o == "net_transport" { return Ok(Some(variant(Expr.Lit(Val.Text("TCP"))))) }
                if o == "protocol_type" { return Ok(Some(variant(Expr.Lit(Val.Text("TSQL"))))) }
                if o == "auth_scheme" { return Ok(Some(variant(Expr.Lit(Val.Text("SQL"))))) }
                return Ok(Some(variant(Expr.Lit(Val.Null))))
            }
            None { return Ok(Some(Expr.Lit(Val.Null))) }
        }
    }
    if name == "context_info" && n == 0 { return Ok(Some(Expr.Cast(Expr.Lit(Val.Null), TypeName{kind: K_BYTEA, oid: OID_BYTEA, prec: 0, scale: 0, len: 0}))) }
    if name == "databasepropertyex" && n == 2 {
        // the property of a database there is (lexdb's, or SQL Server's system ones)
        match lexdb_sql.litText(&a[1]) {
            Some(t) {
                let v = variant(propExpr(&lexdb_dialect.prop("database", &t)))
                let db = replace(mut &a[0], Expr.Lit(Val.Null))
                return Ok(Some(Expr.Call("case else", [Expr.IsNull(Expr.Call("#db_id", [db], false), false), Expr.Lit(Val.Null), v], false)))
            }
            None { return Ok(Some(Expr.Lit(Val.Null))) }
        }
    }
    if name == "db_id" && n == 0 { return Ok(Some(Expr.Lit(Val.Int(5)))) }
    if (name == "db_id" || name == "db_name" || name == "has_dbaccess") && n >= 1 { return Ok(Some(Expr.Call("#" + name, replace(a, []), false))) }
    match name.toStr() {
        "schema_name", "schema_id", "object_name", "object_schema_name", "objectproperty", "objectpropertyex", "columnproperty",
        "indexproperty", "type_name", "type_id", "suser_sid", "sid_binary", "is_srvrolemember", "is_member", "has_perms_by_name" {
            if n == 0 && (name == "schema_name" || name == "schema_id" || name == "suser_sid" || name == "is_member" || name == "is_srvrolemember") {
                if name == "schema_name" { return Ok(none) }
                if name == "schema_id" { return Ok(Some(Expr.Lit(Val.Int(1)))) }
            }
            append(mut &p.seqs, CAT_MARK)
            return Ok(Some(Expr.Call("#" + name, replace(a, []), false)))
        }
        "suser_sname", "suser_name" {
            if n >= 1 {
                append(mut &p.seqs, CAT_MARK)
                return Ok(Some(Expr.Call("#suser_sname", replace(a, []), false)))
            }
        }
        "object_definition" {
            if n != 1 { return Err(lexdb_base.err("TS189", "The object_definition function requires 1 argument(s).")) }
            append(mut &p.seqs, CAT_MARK)
            return Ok(Some(Expr.Call("#object_definition", replace(a, []), false)))
        }
        else {}
    }
    return Ok(none)
}

// ---- statements

fn (p: mut &P) createTable(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_CREATE)
    s.mdialect = if p.tsql { MD_TSQL } else if p.ora { MD_ORA } else { MD_PG }
    // (SQL Server has no IF NOT EXISTS here (156 at NOT, as before), and IF alone is a reserved word there: 156)
    if (!p.tsql || (p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "not")) && p.acceptKw("if") {
        try p.expectKw("not")
        try p.expectKw("exists")
        s.ifFlag = true
    }
    // (SQL Server reads HOLDLOCK and INDEX there as a table hint without WITH: 1018)
    if p.tsql && (p.isKw("holdlock") || p.isKw("index")) { return Err(tableHintErr(&p.peek())) }
    s.table = try p.rname()
    s.spell = p.spelled.clone()
    if p.ora && p.isKw("(") && p.colAnnotThenAs() {
        return Err(lexdb_base.err("ORA11559", "Column level annotations not allowed in CREATE TABLE AS SELECT statements."))
    }
    if p.isKw("as") || p.isKw("on") || (p.ora && p.isKw("annotations")) || (p.isKw("(") && p.nameListThenAs()) { return p.createTableAs(s) }
    return p.tableBody(s)
}

// Oracle: at CREATE TABLE's "(": whether its list has a column's ANNOTATIONS and AS follows it (or the table's ANNOTATIONS, then
// AS): a CREATE TABLE AS whose columns are annotated, ORA-11559.
fn (p: &P) colAnnotThenAs(): bool {
    var i = p.pos + 1
    var depth = 1
    var annot = false
    while i < len(p.toks) && depth > 0 {
        let t = &p.toks[i]
        if t.kind == T_EOF { return false }
        if t.kind == T_OP && t.text == "(" { depth += 1 }
        if t.kind == T_OP && t.text == ")" { depth -= 1 }
        if depth == 1 && t.kind == T_IDENT && t.text == "annotations" { annot = true }
        i += 1
    }
    if !annot || i >= len(p.toks) { return false }
    if p.toks[i].kind == T_IDENT && p.toks[i].text == "annotations" && i + 1 < len(p.toks) && p.toks[i + 1].text == "(" {
        // the table's own ANNOTATIONS (...): what follows it
        i += 2
        depth = 1
        while i < len(p.toks) && depth > 0 {
            if p.toks[i].kind == T_EOF { return false }
            if p.toks[i].kind == T_OP && p.toks[i].text == "(" { depth += 1 }
            if p.toks[i].kind == T_OP && p.toks[i].text == ")" { depth -= 1 }
            i += 1
        }
    }
    return i < len(p.toks) && p.toks[i].kind == T_IDENT && p.toks[i].text == "as"
}


// A table's definition, ( ... ), after its name.
fn (p: mut &P) tableBody(s0: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var s = s0
    try p.expectKw("(")
    var nns: []str = []             // PostgreSQL 18's table constraint [CONSTRAINT n] NOT NULL c: "c\x00n"
    while true {
        var cname = ""
        if p.acceptKw("constraint") { cname = try p.name() }
        if !p.tsql && !p.ora && p.isKw("not") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "null" {
            p.pos += 2
            append(mut &nns, (try p.name()) + "\x00" + cname)
        } else if p.acceptKw("primary") {
            try p.expectKw("key")
            if len(s.pk) > 0 { return Err(p.multiPk(&s.table)) }
            s.pkName = cname
            s.pkCluster = p.clusterWord()
            try p.expectKw("(")
            append(mut &s.pk, try p.name())
            p.keyOrder()
            while p.acceptKw(",") {
                append(mut &s.pk, try p.name())
                p.keyOrder()
            }
            try p.expectKw(")")
            try p.tsqlStorage()
            if p.enforcedNext() { return Err(lexdb_base.err("0A000", "PRIMARY KEY constraints cannot be marked NOT ENFORCED")) }
        } else if p.tsql && len(cname) == 0 && p.acceptKw("index") {
            try p.inlineIndex(mut &s, "")
        } else if len(cname) > 0 || p.isKw("unique") || p.isKw("check") || p.isKw("foreign") || p.isKw("exclude") {
            append(mut &s.cons, try p.tableConstraint(&cname))
        } else {
            let colAt = p.pos
            let n = try p.name()
            if p.tsql { try p.notTsqlReserved(colAt) }
            var c = lexdb_sql.noCol()
            c.name = n.clone()
            c.spell = p.spelled.clone()
            try p.colTypeOpt(mut &c)
            var nnHere = ""             // the name this column's NOT NULL was given
            while true {
                // CONSTRAINT name names the one after it (a UNIQUE's; the
                // others' names are not kept)
                var cn = ""
                if p.acceptKw("constraint") { cn = try p.name() }
                if p.ora && c.genKind == lexdb_sql.GEN_NONE && p.acceptKw("as") {
                    try p.genClause(mut &c, true)
                } else if p.enforcedNext() {
                    return Err(misplacedState())
                } else if p.acceptKw("not") {
                    try p.expectKw("null")
                    c.notNull = true
                    if len(cn) > 0 {
                        if len(nnHere) > 0 && nnHere != cn { return Err(lexdb_base.err("XX000", &("conflicting not-null constraint names \"" + nnHere + "\" and \"" + cn + "\""))) }
                        if len(nnHere) == 0 { append(mut &nns, n.clone() + "\x00" + cn) }
                        nnHere = cn.clone()
                    }
                } else if p.acceptKw("null") {
                } else if p.acceptKw("primary") {
                    try p.expectKw("key")
                    if len(s.pk) > 0 { return Err(p.multiPk(&s.table)) }
                    append(mut &s.pk, n.clone())
                    s.pkName = cn
                    s.pkCluster = p.clusterWord()
                    try p.tsqlStorage()
                    c.notNull = true
                } else if p.acceptKw("default") {
                    c.def = Some(try p.oraDefault())
                    if lexdb_sql.onNullOf(&c.def) > 0 { c.notNull = true }
                } else if p.acceptKw("generated") {
                    try p.identity(mut &c, mut &s)
                } else if p.tsql && p.acceptKw("identity") {
                    try p.tsqlIdentity(mut &c, mut &s)
                } else if p.tsql && len(cn) == 0 && p.acceptKw("index") {
                    try p.inlineIndex(mut &s, &n)
                } else if p.acceptKw("unique") {
                    try p.uniqueTail()
                    var u = lexdb_sql.newConstraint(C_UNIQUE, &cn)
                    u.cluster = p.clusterWord()
                    try p.tsqlStorage()
                    append(mut &u.cols, n.clone())
                    append(mut &s.cons, u)
                } else if p.acceptKw("check") {
                    let ckAt = p.pos
                    var ck = try p.checkTail(&cn)
                    let nvAt = p.notValidSince(ckAt)
                    if nvAt >= 0 { return Err(near(&p.toks[nvAt])) }     // a column's may not be NOT VALID (written, with or without NOT ENFORCED)
                    append(mut &ck.cols, n.clone())         // a column's: named for it
                    append(mut &s.cons, ck)
                } else if p.acceptKw("references") {
                    var fk = lexdb_sql.newConstraint(C_FOREIGN, &cn)
                    append(mut &fk.cols, n.clone())
                    let fkAt = p.pos
                    try p.fkTail(mut &fk)
                    let nvAt = p.notValidSince(fkAt)
                    if nvAt >= 0 { return Err(near(&p.toks[nvAt])) }
                    append(mut &s.cons, fk)
                } else if p.enforcedNext() {
                    return Err(misplacedState())
                } else if p.ora && len(cn) == 0 && p.isKw("annotations") {
                    let annAt = p.pos
                    p.pos += 1
                    append(mut &s.alters, try p.annotClause(&n, true))
                    try p.annotColEnd(colAt, annAt)
                    break
                } else if len(cn) > 0 {
                    return Err(near(&p.peek()))
                } else {
                    break
                }
            }
            append(mut &s.cols, c)
        }
        if !p.acceptKw(",") { break }
    }
    try p.expectKw(")")
    if len(nns) > 0 { try nnCons(mut &s, &nns) }
    try p.tsqlStorage()
    try p.onCommit(mut &s)
    while p.ora && p.acceptKw("annotations") { append(mut &s.alters, try p.annotClause("", true)) }
    return Ok(s)
}

// [ON COMMIT PRESERVE ROWS | DELETE ROWS | DROP] (9.96).
fn (p: mut &P) onCommit(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if !p.acceptKw("on") { return Ok(Unit{}) }
    try p.expectKw("commit")
    if p.acceptKw("drop") {
        s.onCommit = ONC_DROP
        return Ok(Unit{})
    }
    if p.acceptKw("preserve") { s.onCommit = ONC_PRESERVE } else {
        try p.expectKw("delete")
        s.onCommit = ONC_DELETE
    }
    try p.expectKw("rows")
    return Ok(Unit{})
}

// Whether ( names ) AS follows: CREATE TABLE ... AS's column names, not a
// table's definition.
fn (p: &P) nameListThenAs(): bool {
    var k = 1
    while true {
        let t = p.peekAt(k).clone()
        if t.kind != T_IDENT && t.kind != T_QIDENT { return false }
        let u = p.peekAt(k + 1).clone()
        if u.kind == T_OP && u.text == ")" { return p.peekAt(k + 2).kind == T_IDENT && (p.peekAt(k + 2).text == "as" || p.peekAt(k + 2).text == "on" || (p.ora && p.peekAt(k + 2).text == "annotations")) }
        if !(u.kind == T_OP && u.text == ",") { return false }
        k += 2
    }
    return false
}

// CREATE TABLE name [(names)] AS query [WITH [NO] DATA] (9.88): the query
// in inner[0], with its own subqueries; the column names in names.
fn (p: mut &P) createTableAs(s0: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var s = s0
    if p.acceptKw("(") {
        while true {
            append(mut &s.names, try p.name())
            append(mut &s.spells, p.spelled.clone())
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    }
    try p.onCommit(mut &s)
    while p.ora && p.acceptKw("annotations") { append(mut &s.alters, try p.annotClause("", true)) }
    try p.expectKw("as")
    var q = try p.query()
    if p.acceptKw("with") {
        s.noData = p.acceptKw("no")
        try p.expectKw("data")
    }
    append(mut &s.inner, q)
    return Ok(s)
}

// A query where a statement takes one (CREATE TABLE ... AS): SELECT,
// VALUES or WITH ... SELECT, in parentheses or not, with its own
// subqueries, window calls and parameters.
fn (p: mut &P) query(): Result[Stmt, lexdb_base.DbErr] {
    let pq = p.isKw("(") && p.parenQueryStart()
    let paren = !pq && p.acceptKw("(")
    var n = 0
    if !pq && p.acceptKw("with") { n = try p.withList() }
    var q = lexdb_sql.newStmt(S_SELECT)
    if pq {
        q = try p.parenSelect()
    } else if p.acceptKw("select") {
        q = try p.select()
    } else if p.acceptKw("values") {
        q = try p.valuesQuery()
        try p.orderLimit(mut &q)
    } else {
        return Err(near(&p.peek()))
    }
    if paren { try p.expectKw(")") }
    q.subs = replace(mut &p.subs, [])
    q.wins = replace(mut &p.wins, [])
    q.params = p.params
    if n > 0 { p.popCtes(n) }
    return Ok(q)
}

// A table constraint, after [CONSTRAINT name]: UNIQUE (cols), CHECK (expr)
// or FOREIGN KEY (cols) REFERENCES ....
fn (p: mut &P) tableConstraint(name: &str): Result[Constraint, lexdb_base.DbErr] {
    if p.acceptKw("check") { return p.checkTail(name) }
    if p.acceptKw("foreign") {
        try p.expectKw("key")
        var c = lexdb_sql.newConstraint(C_FOREIGN, name)
        try p.expectKw("(")
        append(mut &c.cols, try p.name())
        while p.acceptKw(",") { append(mut &c.cols, try p.name()) }
        try p.expectKw(")")
        try p.expectKw("references")
        try p.fkTail(mut &c)
        return Ok(c)
    }
    let prim = p.isKw("primary")
    if p.acceptKw("unique") || p.acceptKw("primary") {
        var c = lexdb_sql.newConstraint(if prim { C_PRIMARY } else { C_UNIQUE }, name)
        if prim { try p.expectKw("key") } else { try p.uniqueTail() }
        c.cluster = p.clusterWord()
        // ALTER TABLE's ... USING INDEX name (9.117)
        if p.isKw("using") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "index" {
            p.pos += 2
            c.index = try p.name()
            return Ok(c)
        }
        try p.expectKw("(")
        append(mut &c.cols, try p.name())
        p.keyOrder()
        while p.acceptKw(",") {
            append(mut &c.cols, try p.name())
            p.keyOrder()
        }
        try p.expectKw(")")
        try p.indexTail()
        try p.tsqlStorage()
        if p.enforcedNext() { return Err(lexdb_base.err("0A000", &((if prim { "PRIMARY KEY" } else { "UNIQUE" }) + " constraints cannot be marked NOT ENFORCED"))) }
        if p.isNotValid() { return Err(lexdb_base.err("0A000", &((if prim { "PRIMARY KEY" } else { "UNIQUE" }) + " constraints cannot be marked NOT VALID"))) }
        return Ok(c)
    }
    return Err(p.notYet())
}

// NOT VALID next.
fn (p: &P) isNotValid(): bool {
    return p.isKw("not") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "valid"
}

// The position of the VALID of a NOT VALID written between token from and the current one, or -1 (a column constraint takes
// none, however the state words around it are written: PostgreSQL's 42601 is at VALID).
fn (p: &P) notValidSince(from: int): int {
    var k = from
    var depth = 0               // (inside brackets: the CHECK's expression, a column list)
    while k + 1 < p.pos {
        if p.toks[k].kind == T_OP && p.toks[k].text == "(" { depth += 1 }
        else if p.toks[k].kind == T_OP && p.toks[k].text == ")" { depth -= 1 }
        else if depth == 0 && p.toks[k].kind == T_IDENT && p.toks[k].text == "not" && p.toks[k + 1].kind == T_IDENT && p.toks[k + 1].text == "valid" { return k + 1 }
        k += 1
    }
    return -1
}

// After a key's columns: INCLUDE (...), WITH (...), USING INDEX TABLESPACE
// name, DEFERRABLE: not lexdb's.
fn (p: mut &P) indexTail(): Result[Unit, lexdb_base.DbErr] {
    if p.isKw("include") || p.isKw("with") || p.isKw("using") || p.isKw("deferrable") || p.isKw("initially") {
        return Err(lexdb_base.err("0A000", &("lexdb: a key's " + strings.toUpperAscii(&(p.peek().text)) + " is not supported")))
    }
    return Ok(Unit{})
}

// A second PRIMARY KEY of a table: PostgreSQL's 42P16, SQL Server's 8110, Oracle's ORA-02260.
fn (p: &P) multiPk(table: &str): lexdb_base.DbErr {
    let t = lexdb_sql.baseName(table)
    if p.tsql { return lexdb_base.err("TS8110", &("Cannot add multiple PRIMARY KEY constraints to table '" + t + "'.")) }
    if p.ora { return lexdb_base.err("ORA02260", "table can have only one primary key") }
    return lexdb_base.err("42P16", &("multiple primary keys for table \"" + t + "\" are not allowed"))
}

// T-SQL's ASC or DESC after a key's column: read, not kept (a key's order is its columns').
fn (p: mut &P) keyOrder() {
    if p.tsql && (p.isKw("asc") || p.isKw("desc")) { p.pos += 1 }
}

// T-SQL's CLUSTERED (1) or NONCLUSTERED (2) after PRIMARY KEY, UNIQUE or CREATE [UNIQUE]; 0 neither.
fn (p: mut &P) clusterWord(): int {
    if !p.tsql { return 0 }
    if p.acceptKw("clustered") { return 1 }
    if p.acceptKw("nonclustered") { return 2 }
    return 0
}

// T-SQL's storage clauses after a key, an index or a table: WITH (index options), ON filegroup (or partition scheme(column)),
// TEXTIMAGE_ON filegroup. Read and not kept: lexdb's storage is its own.
fn (p: mut &P) tsqlStorage(): Result[Unit, lexdb_base.DbErr] {
    if !p.tsql { return Ok(Unit{}) }
    while true {
        if p.isKw("with") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
            p.pos += 2
            var depth = 1
            while depth > 0 {
                let t = p.next()
                if t.kind == T_EOF { return Err(near(&t)) }
                if t.kind == T_OP && t.text == "(" { depth += 1 }
                if t.kind == T_OP && t.text == ")" { depth -= 1 }
            }
        } else if (p.isKw("on") && (p.peekAt(1).kind == T_IDENT || p.peekAt(1).kind == T_QIDENT) && p.peekAt(1).text != "commit") ||
                  (p.isKw("textimage_on") && (p.peekAt(1).kind == T_IDENT || p.peekAt(1).kind == T_QIDENT)) {
            p.pos += 2
            if p.isKw("(") {
                p.pos += 1
                while !p.isKw(")") && p.peek().kind != T_EOF { p.pos += 1 }
                try p.expectKw(")")
            }
        } else {
            break
        }
    }
    return Ok(Unit{})
}

// After UNIQUE: NULLS [NOT] DISTINCT (only the default, DISTINCT, is lexdb's).
fn (p: mut &P) uniqueTail(): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("nulls") {
        if p.acceptKw("not") { return Err(lexdb_base.err("0A000", "lexdb: UNIQUE NULLS NOT DISTINCT is not supported")) }
        try p.expectKw("distinct")
    }
    return Ok(Unit{})
}

// A constraint's state word after a CHECK's or foreign key's definition (design/lexdb-new-features.md 10.5), when one is next: true
// when read. PostgreSQL 18's ENFORCED and NOT ENFORCED (42601 for two); Oracle's ENABLE, DISABLE, VALIDATE, NOVALIDATE (a state is a
// constraint's ENABLE [VALIDATE | NOVALIDATE] or DISABLE [NOVALIDATE]: not enforced is not validated), RELY and NORELY (read, not kept).
// Not SQL Server's: its WITH NOCHECK is ALTER TABLE's.
fn (p: mut &P) stateWord(c: mut &Constraint): Result[bool, lexdb_base.DbErr] {
    if p.tsql { return Ok(false) }
    if p.ora {
        if p.acceptKw("enable") {
            c.off = false
            c.stated = true
            return Ok(true)
        }
        if p.acceptKw("disable") {
            c.off = true
            c.notValid = true
            c.stated = true
            return Ok(true)
        }
        if p.acceptKw("validate") {
            c.notValid = c.off
            return Ok(true)
        }
        if p.acceptKw("novalidate") {
            c.notValid = true
            c.stated = true
            return Ok(true)
        }
        if p.acceptKw("rely") || p.acceptKw("norely") { return Ok(true) }
        return Ok(false)
    }
    var off = false
    if p.isKw("enforced") { p.pos += 1 }
    else if p.isKw("not") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "enforced" {
        p.pos += 2
        off = true
    } else { return Ok(false) }
    if c.stated { return Err(lexdb_base.err("42601", "multiple ENFORCED/NOT ENFORCED clauses not allowed")) }
    c.stated = true
    if off {
        c.off = true
        c.notValid = true
    }
    return Ok(true)
}

// PostgreSQL's ENFORCED or NOT ENFORCED next (where a key, NOT NULL or a default allows neither).
fn (p: &P) enforcedNext(): bool {
    if p.tsql || p.ora { return false }
    return p.isKw("enforced") || (p.isKw("not") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "enforced")
}

fn misplacedState(): lexdb_base.DbErr { return lexdb_base.err("42601", "misplaced NOT ENFORCED clause") }

// After CHECK: (expr) [NO INHERIT]. No subquery or parameter; NOT VALID is
// not lexdb's (rows there are always checked).
fn (p: mut &P) checkTail(name: &str): Result[Constraint, lexdb_base.DbErr] {
    var c = lexdb_sql.newConstraint(C_CHECK, name)
    try p.expectKw("(")
    let subs = len(p.subs)
    let params = p.params
    c.expr = Some(try p.expr())
    if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in check constraint")) }
    if p.params > params { return Err(lexdb_base.err("42P02", &("there is no parameter $" + p.params.toStr()))) }
    try p.expectKw(")")
    while true {
        if p.acceptKw("no") { try p.expectKw("inherit") }
        else if p.isNotValid() {
            p.pos += 2
            c.notValid = true
        } else if !(try p.stateWord(mut &c)) { break }
    }
    return Ok(c)
}

// After REFERENCES: table [(cols)], then in any order MATCH SIMPLE, ON
// DELETE action, ON UPDATE action, [NOT] DEFERRABLE, INITIALLY IMMEDIATE |
// DEFERRED (9.85). MATCH FULL and PARTIAL are not lexdb's.
fn (p: mut &P) fkTail(c: mut &Constraint): Result[Unit, lexdb_base.DbErr] {
    var notDeferrable = false
    c.refTable = try p.qname()
    if p.acceptKw("(") {
        append(mut &c.refCols, try p.name())
        while p.acceptKw(",") { append(mut &c.refCols, try p.name()) }
        try p.expectKw(")")
    }
    while true {
        if p.acceptKw("match") {
            if p.isKw("full") || p.isKw("partial") {
                return Err(lexdb_base.err("0A000", "lexdb: MATCH FULL and MATCH PARTIAL are not supported (MATCH SIMPLE is)"))
            }
            try p.expectKw("simple")
        } else if p.isKw("on") && p.pos + 1 < len(p.toks) && (p.toks[p.pos + 1].text == "delete" || p.toks[p.pos + 1].text == "update") {
            p.pos += 1
            let del = p.acceptKw("delete")
            if !del { try p.expectKw("update") }
            let act = try p.fkAction()
            if del { c.onDelete = act } else { c.onUpdate = act }
        } else if p.acceptKw("deferrable") {
            c.deferrable = true
        } else if p.isKw("not") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].text == "deferrable" {
            p.pos += 2
            c.deferrable = false
            notDeferrable = true
        } else if p.acceptKw("initially") {
            if p.acceptKw("deferred") { c.deferred = true } else { try p.expectKw("immediate") }
        } else if p.isNotValid() {
            p.pos += 2
            c.notValid = true
        } else if try p.stateWord(mut &c) {
        } else {
            break
        }
    }
    if c.deferred {
        if notDeferrable { return Err(lexdb_base.err("42601", "constraint declared INITIALLY DEFERRED must be DEFERRABLE")) }
        c.deferrable = true
    }
    return Ok(Unit{})
}

fn (p: mut &P) fkAction(): Result[int, lexdb_base.DbErr] {
    if p.acceptKw("no") {
        try p.expectKw("action")
        return Ok(FK_NO_ACTION)
    }
    if p.acceptKw("restrict") { return Ok(FK_RESTRICT) }
    if p.acceptKw("cascade") { return Ok(FK_CASCADE) }
    try p.expectKw("set")
    var act = FK_SET_NULL
    if !p.acceptKw("null") {
        try p.expectKw("default")
        act = FK_SET_DEFAULT
    }
    if p.isKw("(") { return Err(lexdb_base.err("0A000", "lexdb: SET NULL and SET DEFAULT of some columns are not supported")) }
    return Ok(act)
}

fn (p: &P) notYet(): lexdb_base.DbErr {
    if p.isKw("exclude") { return lexdb_base.err("0A000", "lexdb: EXCLUDE constraints are not supported") }
    return near(&p.peek())
}

// pg_get_serial_sequence('t', 'c') of literals (perhaps cast): "t\x00c".
fn serialArgs(x: &Expr): Option[str] {
    match x {
        Expr.Call(n, args, _) {
            if (n == "pg_get_serial_sequence" || n == "#pg_get_serial_sequence") && len(args) == 2 {
                match lexdb_sql.litText(&args[0]) {
                    Some(t) {
                        match lexdb_sql.litText(&args[1]) {
                            Some(c) { return Some(t + "\x00" + c) }
                            None {}
                        }
                    }
                    None {}
                }
            }
            return None
        }
        Expr.Cast(a, _) { return serialArgs(&a) }
        else { return None }
    }
}


// A column's type: serial, bigserial and smallserial are integers taking
// their defaults from a sequence of their own.
fn (p: mut &P) colType(c: mut &ColDef): Result[Unit, lexdb_base.DbErr] {
    let w = p.peek().clone()
    if w.kind == T_IDENT {
        var oid = 0
        if w.text == "serial" || w.text == "serial4" { oid = OID_INT4 }
        if w.text == "bigserial" || w.text == "serial8" { oid = OID_INT8 }
        if w.text == "smallserial" || w.text == "serial2" { oid = OID_INT2 }
        if oid != 0 {
            p.pos += 1
            c.typ = TypeName{kind: K_INT, oid: oid, prec: 0, scale: 0, len: 0}
            c.identity = ID_SERIAL
            c.notNull = true
            return Ok(Unit{})
        }
    }
    c.typ = try p.typeName()
    // its collation (L2): COLLATE name; in T-SQL a text column's is SQL
    // Server's default, case-insensitive
    if p.acceptKw("collate") { c.coll = try p.collName() }
    else if p.tsql && c.typ.kind == K_TEXT { c.coll = TSQL_COLLATION }
    return Ok(Unit{})
}


// A collation's name after COLLATE, as written: name or schema.name.
fn (p: mut &P) collName(): Result[str, lexdb_base.DbErr] {
    var n = try p.name()
    var sp = if len(p.spelled) > 0 { p.spelled.clone() } else { n }
    if p.acceptKw(".") {
        n = try p.name()
        sp = if len(p.spelled) > 0 { p.spelled.clone() } else { n }
    }
    return Ok(sp)
}

// After GENERATED: {ALWAYS | BY DEFAULT} AS IDENTITY [(options)].
// T-SQL's IDENTITY [(seed, increment)], after IDENTITY: an identity column
// a value given to is refused (unless SET IDENTITY_INSERT is ON for the
// table: design/lexdb-tds.md S3).
fn (p: mut &P) tsqlIdentity(c: mut &ColDef, s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    c.identity = ID_ALWAYS
    c.notNull = true
    var o = lexdb_sql.noSeqOpts()
    if p.acceptKw("(") {
        o.start = try p.signedInt()
        o.hasStart = true
        try p.expectKw(",")
        o.inc = try p.signedInt()
        o.hasInc = true
        try p.expectKw(")")
    }
    append(mut &s.idOpts, IdOpts{col: c.name.clone(), opts: o})
    return Ok(Unit{})
}

fn (p: mut &P) identity(c: mut &ColDef, s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("always") {
        c.identity = ID_ALWAYS
    } else {
        try p.expectKw("by")
        try p.expectKw("default")
        c.identity = ID_BY_DEFAULT
    }
    if p.ora && c.identity == ID_BY_DEFAULT && p.acceptKw("on") { try p.expectKw("null") }
    try p.expectKw("as")
    if p.isKw("(") {
        if c.identity != ID_ALWAYS { return Err(lexdb_base.err("42601", "for a generated column, GENERATED ALWAYS must be specified")) }
        c.identity = ID_NONE
        return p.genClause(mut &c, true)
    }
    try p.expectKw("identity")
    c.notNull = true
    // Oracle: NUMBER is the identity's type; lexdb's are integers
    if p.ora && c.typ.kind == K_NUM && c.typ.scale == 0 { c.typ = TypeName{kind: K_INT, oid: OID_INT8, prec: 0, scale: 0, len: 0} }
    if p.acceptKw("(") {
        var o = lexdb_sql.noSeqOpts()
        try p.seqOptions(mut &o, false)
        try p.expectKw(")")
        append(mut &s.idOpts, IdOpts{col: c.name.clone(), opts: o})
    }
    return Ok(Unit{})
}

// A generated column's expression and kind (package C), after AS: PostgreSQL's and Oracle's GENERATED ALWAYS AS (expr)
// [STORED | VIRTUAL], Oracle's AS (expr) [VIRTUAL], T-SQL's AS expr [PERSISTED [NOT NULL]]. The column's type may be missing
// (T-SQL's and Oracle's): the table takes it from the expression.
fn (p: mut &P) genClause(c: mut &ColDef, paren: bool): Result[Unit, lexdb_base.DbErr] {
    let subs = len(p.subs)
    let params = p.params
    if paren { try p.expectKw("(") }
    let x = try p.expr()
    if paren { try p.expectKw(")") }
    if len(p.subs) > subs {
        if p.tsql { return Err(lexdb_base.err("TS1046", "Subqueries are not allowed in this context. Only scalar expressions are allowed.")) }
        if p.ora { return Err(lexdb_base.err("ORA54016", "invalid column expression was specified")) }
        return Err(lexdb_base.err("0A000", "cannot use subquery in column generation expression"))
    }
    if p.params > params { return Err(lexdb_base.err("42P02", &("there is no parameter $" + p.params.toStr()))) }
    c.gen = Some(x)
    c.genKind = lexdb_sql.GEN_VIRTUAL
    if p.tsql {
        if p.isKw("persisted") {
            p.pos += 1
            c.genKind = lexdb_sql.GEN_STORED
            if p.isKw("not") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "null" {
                p.pos += 2
                c.notNull = true
            }
        }
    } else if p.ora {
        let v = p.acceptKw("virtual")
    } else if p.acceptKw("stored") {
        c.genKind = lexdb_sql.GEN_STORED
    } else {
        let v = p.acceptKw("virtual")
    }
    return Ok(Unit{})
}

// Whether a column's definition goes on with no type: T-SQL's name AS expr, Oracle's name AS (expr) and name GENERATED ALWAYS AS.
fn (p: &P) typeless(): bool {
    if p.tsql { return p.isKw("as") }
    if p.ora { return p.isKw("as") || p.isKw("generated") }
    return false
}

// A column's type, or none yet where a generated column has none (the table takes it from its expression).
fn (p: mut &P) colTypeOpt(c: mut &ColDef): Result[Unit, lexdb_base.DbErr] {
    if p.typeless() {
        c.typ = TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}
        if p.tsql {
            p.pos += 1
            try p.genClause(mut &c, false)
        }
        return Ok(Unit{})
    }
    try p.colType(mut &c)
    return Ok(Unit{})
}

// Sequence options, in any order, until none follows.
fn (p: mut &P) seqOptions(o: mut &SeqOpts, alter: bool): Result[Unit, lexdb_base.DbErr] {
    while true {
        if p.acceptKw("as") {
            let t = try p.typeName()
            if t.kind != K_INT { return Err(lexdb_base.err("22023", "sequence type must be smallint, integer, or bigint")) }
            o.typ = t.oid
        } else if p.acceptKw("increment") {
            let by = p.acceptKw("by")
            o.inc = try p.signedInt()
            o.hasInc = true
        } else if p.acceptKw("minvalue") {
            o.min = try p.signedInt()
            o.hasMin = 1
        } else if p.acceptKw("maxvalue") {
            o.max = try p.signedInt()
            o.hasMax = 1
        } else if p.isKw("no") && p.pos + 1 < len(p.toks) && (p.toks[p.pos + 1].text == "minvalue" || p.toks[p.pos + 1].text == "maxvalue" || p.toks[p.pos + 1].text == "cycle") {
            p.pos += 1
            if p.acceptKw("minvalue") {
                o.hasMin = 2
            } else if p.acceptKw("maxvalue") {
                o.hasMax = 2
            } else {
                try p.expectKw("cycle")
                o.cycle = 2
            }
        } else if p.acceptKw("start") {
            let w = p.acceptKw("with")
            o.start = try p.signedInt()
            o.hasStart = true
        } else if alter && p.acceptKw("restart") {
            o.restart = 1
            let w = p.acceptKw("with")
            if w || p.peek().kind == T_NUM || p.isKw("-") {
                o.restart = 2
                o.restartWith = try p.signedInt()
            }
        } else if p.ora && (p.acceptKw("nocache") || p.acceptKw("noorder") || p.acceptKw("order") || p.acceptKw("keep") || p.acceptKw("noscale")) {
        } else if p.ora && p.acceptKw("nocycle") {
            o.cycle = 2
        } else if p.ora && p.acceptKw("nominvalue") {
            o.hasMin = 2
        } else if p.ora && p.acceptKw("nomaxvalue") {
            o.hasMax = 2
        } else if p.acceptKw("cache") {
            o.cache = try p.signedInt()
            if o.cache < 1 { return Err(lexdb_base.err("22023", &("CACHE (" + o.cache.toStr() + ") must be greater than zero"))) }
        } else if p.acceptKw("cycle") {
            o.cycle = 1
        } else if p.acceptKw("owned") {
            try p.expectKw("by")
            if p.acceptKw("none") {
                o.owned = ["", ""]
            } else {
                // table.column, schema.table.column
                var ns = [try p.name()]
                while p.acceptKw(".") { append(mut &ns, try p.name()) }
                if len(ns) < 2 || len(ns) > 3 { return Err(lexdb_base.err("42601", "invalid OWNED BY option (table.column or OWNED BY NONE)")) }
                let col = pop(mut &ns)
                var tn = ns[0].clone()
                if len(ns) == 2 { tn = lexdb_sql.qual(&ns[0], &ns[1]) }
                o.owned = [tn, col]
            }
        } else {
            break
        }
    }
    return Ok(Unit{})
}

// An integer literal, perhaps negative.
fn (p: mut &P) signedInt(): Result[int, lexdb_base.DbErr] {
    let neg = p.acceptKw("-")
    // the smallest bigint, whose digits alone are past the largest (9.117)
    if neg && p.peek().kind == T_NUM && p.peek().text == "9223372036854775808" {
        p.pos += 1
        return Ok(-9223372036854775807 - 1)
    }
    let n = try p.intLit()
    return Ok(if neg { -n } else { n })
}

// CREATE SEQUENCE, after SEQUENCE; ALTER SEQUENCE, after SEQUENCE.
fn (p: mut &P) seqStmt(kind: int): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(kind)
    if p.acceptKw("if") {
        if kind == S_CREATE_SEQ { try p.expectKw("not") }
        try p.expectKw("exists")
        s.ifFlag = true
    }
    s.table = try p.rname()
    // ALTER SEQUENCE ... RENAME TO name, SET SCHEMA name (9.117)
    if kind == S_ALTER_SEQ && p.acceptKw("rename") {
        try p.expectKw("to")
        append(mut &s.alters, lexdb_sql.alterOf(A_RENAME, &(try p.name())))
        return Ok(s)
    }
    if kind == S_ALTER_SEQ && p.isKw("set") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "schema" {
        p.pos += 2
        append(mut &s.alters, lexdb_sql.alterOf(A_SET_SCHEMA, &(try p.name())))
        return Ok(s)
    }
    if kind == S_ALTER_SEQ && (p.isKw("set") || p.isKw("owner")) {
        return Err(lexdb_base.err("0A000", "lexdb: ALTER SEQUENCE takes its options (RESTART, INCREMENT, ...), RENAME TO, SET SCHEMA and OWNER TO, not SET LOGGED or UNLOGGED"))
    }
    try p.seqOptions(mut &s.seq, kind == S_ALTER_SEQ)
    return Ok(s)
}

// A DEFAULT's expression: no subquery, no parameter (column references and
// aggregates are refused where the table is known).
fn (p: mut &P) defaultExpr(): Result[Expr, lexdb_base.DbErr] {
    let subs = len(p.subs)
    let params = p.params
    let x = try p.catExpr()      // no NOT, AND or IS at the top: "DEFAULT 1 NOT NULL" 
    if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in DEFAULT expression")) }
    if p.params > params { return Err(lexdb_base.err("42P02", &("there is no parameter $" + p.params.toStr()))) }
    return Ok(x)
}


// A value, or DEFAULT (INSERT's VALUES, UPDATE's SET).
fn (p: mut &P) valueOrDefault(): Result[Expr, lexdb_base.DbErr] {
    if p.acceptKw("default") { return Ok(Expr.Call(DEFAULT_MARK, [], false)) }
    return p.expr()
}

// T-SQL's ALTER DATABASE name | CURRENT SET option [, option ...] [WITH termination], after "database"
// (design/lexdb-dialect-gaps.md, package B, S6): each option as lexdb_dbopt gives its shape; an option
// SQL Server has that lexdb does not do is 0A000, any other word SQL Server's syntax error.
fn (p: mut &P) alterDatabase(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_ALTER_DB)
    s.mdialect = MD_TSQL
    if p.isKw("scoped") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "configuration" {
        return Err(lexdb_base.err("0A000", "lexdb: ALTER DATABASE SCOPED CONFIGURATION is not supported yet"))
    }
    if !p.acceptKw("current") {
        let t = p.peek().clone()
        if t.kind == T_IDENT && t.text == "set" { return Err(near(&t)) }
        s.table = try p.name()
    }
    if !p.isKw("set") {
        let w = p.peek().clone()
        if w.kind == T_IDENT && (w.text == "modify" || w.text == "add" || w.text == "remove" || w.text == "collate" || w.text == "scoped") {
            return Err(lexdb_base.err("0A000", &("lexdb: ALTER DATABASE " + strings.toUpperAscii(&w.text) + " is not supported yet (ALTER DATABASE ... SET takes the options of SQL Server's that lexdb has)")))
        }
        return Err(near(&w))
    }
    p.pos += 1
    while true {
        let t = p.next()
        if t.kind != T_IDENT { return Err(near(&t)) }
        let sp = match lexdb_dbopt.spec(&t.text) {
            Some(x) { x }
            None { return Err(near(&t)) }
        }
        if !sp.known {
            return Err(lexdb_base.err("0A000", &("lexdb: ALTER DATABASE ... SET " + strings.toUpperAscii(&t.text) + " is not supported yet")))
        }
        var val = ""
        var arg = ""
        if sp.shape == lexdb_dbopt.SH_ONOFF || sp.shape == lexdb_dbopt.SH_EQONOFF {
            if sp.shape == lexdb_dbopt.SH_EQONOFF { try p.expectKw("=") }
            let v = p.next()
            if v.kind != T_IDENT || (v.text != "on" && v.text != "off") { return Err(near(&v)) }
            val = v.text.clone()
            if p.isKw("(") {
                // AUTO_CREATE_STATISTICS ON (INCREMENTAL = ON | OFF); QUERY_STORE = ON (settings)
                if t.text == "auto_create_statistics" {
                    if val != "on" { return Err(near(&p.peek())) }
                    p.pos += 1
                    try p.expectKw("incremental")
                    try p.expectKw("=")
                    let iv = p.next()
                    if iv.kind != T_IDENT || (iv.text != "on" && iv.text != "off") { return Err(near(&iv)) }
                    arg = iv.text.clone()
                    try p.expectKw(")")
                } else if sp.shape == lexdb_dbopt.SH_EQONOFF {
                    var depth = 0
                    while true {
                        let x = p.next()
                        if x.kind == T_EOF { return Err(near(&x)) }
                        if x.kind == T_OP && x.text == "(" { depth += 1 }
                        if x.kind == T_OP && x.text == ")" {
                            depth -= 1
                            if depth == 0 { break }
                        }
                    }
                } else {
                    return Err(near(&p.peek()))
                }
            }
        } else if sp.shape == lexdb_dbopt.SH_WORD || sp.shape == lexdb_dbopt.SH_EQWORD {
            if sp.shape == lexdb_dbopt.SH_EQWORD { try p.expectKw("=") }
            let v = p.next()
            var ok = false
            if v.kind == T_IDENT { for w in sp.vals { if w == v.text { ok = true } } }
            if !ok { return Err(near(&v)) }
            val = v.text.clone()
        } else if sp.shape == lexdb_dbopt.SH_EQNUM {
            try p.expectKw("=")
            let neg = t.text == "target_recovery_time" && p.acceptKw("-")
            let v = p.next()
            if v.kind != T_NUM || strings.parseIntOpt(&v.text).isNone() { return Err(near(&v)) }
            val = (if neg { "-" } else { "" }) + v.text
            if t.text == "target_recovery_time" {
                let u = p.next()
                if u.kind != T_IDENT || (u.text != "seconds" && u.text != "minutes") { return Err(near(&u)) }
                if u.text == "minutes" { val = (strings.parseIntOpt(&val).unwrapOr(0) * 60).toStr() }
            }
        }
        append(mut &s.names, t.text + "\t" + val + (if len(arg) > 0 { "\t" + arg } else { "" }))
        if !p.acceptKw(",") { break }
    }
    // WITH ROLLBACK IMMEDIATE | ROLLBACK AFTER n [SECONDS] | NO_WAIT (not with ALLOW_SNAPSHOT_ISOLATION: 5083)
    if p.acceptKw("with") {
        for it in s.names {
            if strings.startsWith(&it, "allow_snapshot_isolation\t") {
                return Err(lexdb_base.err("TS5083", "The termination option cannot be used with ALLOW_SNAPSHOT_ISOLATION."))
            }
        }
        if p.acceptKw("rollback") {
            if !p.acceptKw("immediate") {
                try p.expectKw("after")
                let n = p.next()
                if n.kind != T_NUM { return Err(near(&n)) }
                let sec = p.acceptKw("seconds")
            }
        } else {
            try p.expectKw("no_wait")
        }
    }
    return Ok(s)
}

// ALTER TABLE [IF EXISTS] [ONLY] name, then RENAME [COLUMN] a TO b,
// RENAME CONSTRAINT a TO b, RENAME TO name or SET SCHEMA name (each alone),
// or actions separated by commas: ADD [COLUMN] [IF NOT EXISTS] name type
// [constraints], ADD [CONSTRAINT name] PRIMARY KEY | UNIQUE | CHECK |
// FOREIGN KEY ..., DROP [COLUMN] [IF EXISTS] name [RESTRICT | CASCADE], DROP
// CONSTRAINT [IF EXISTS] name, VALIDATE CONSTRAINT name, ALTER [COLUMN] name
// [SET DATA] TYPE type [USING expr], SET or DROP NOT NULL, SET or DROP
// DEFAULT, and the identity forms (9.117).
fn (p: mut &P) alterTable(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_ALTER)
    s.mdialect = if p.tsql { MD_TSQL } else if p.ora { MD_ORA } else { MD_PG }
    if p.acceptKw("if") {
        try p.expectKw("exists")
        s.ifFlag = true
    }
    let only = p.acceptKw("only")
    s.table = try p.rname()
    if p.isKw("set") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "schema" {
        p.pos += 2
        append(mut &s.alters, lexdb_sql.alterOf(A_SET_SCHEMA, &(try p.name())))
        return Ok(s)
    }
    // SQL Server renames with sp_rename: ALTER TABLE has no RENAME
    if p.tsql && p.isKw("rename") { return Err(near(&p.peek())) }
    if p.acceptKw("rename") {
        // the new name's spelling in col.spell (L6)
        var sp = lexdb_sql.noCol()
        if p.acceptKw("to") {
            let to = try p.name()
            sp.spell = p.spelled.clone()
            var a = lexdb_sql.alterOf(A_RENAME, &to)
            a.col = sp
            append(mut &s.alters, a)
            return Ok(s)
        }
        if p.acceptKw("constraint") {
            var rc = lexdb_sql.alterOf(A_RENAME_CON, &(try p.name()))
            try p.expectKw("to")
            rc.to = try p.name()
            append(mut &s.alters, rc)
            return Ok(s)
        }
        let c = p.acceptKw("column")
        // Oracle's RENAME without COLUMN is a partition's
        if p.ora && !c { return Err(lexdb_base.err("ORA14155", "missing PARTITION or SUBPARTITION keyword")) }
        let from = try p.name()
        try p.expectKw("to")
        let to = try p.name()
        sp.spell = p.spelled.clone()
        var a = lexdb_sql.alterOf(A_RENAME_COL, &from)
        a.col = sp
        a.to = to
        append(mut &s.alters, a)
        return Ok(s)
    }
    var addList = false          // Oracle: ADD (col type, ...)
    var withNo = false           // T-SQL: WITH NOCHECK ADD
    while true {
        let st = try p.conStateAlter(mut &s)
        if st == 1 {
            if !(p.tsql && p.acceptKw(",")) { break }
            continue
        }
        if st == 3 { withNo = true }
        if addList || p.acceptKw("add") {
            if p.ora && !addList && p.isKw("(") && !(p.peekAt(1).kind == T_IDENT && (p.peekAt(1).text == "constraint" || p.peekAt(1).text == "unique" || p.peekAt(1).text == "check" || p.peekAt(1).text == "foreign" || p.peekAt(1).text == "primary")) {
                p.pos += 1
                addList = true
            }
            if !p.tsql && !p.ora && ((p.isKw("not") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "null") ||
                                     (p.isKw("constraint") && p.peekAt(2).kind == T_IDENT && p.peekAt(2).text == "not" && p.peekAt(3).kind == T_IDENT && p.peekAt(3).text == "null")) {
                // PostgreSQL 18: ADD [CONSTRAINT n] NOT NULL c, SET NOT NULL's (its name in to: lexdb_nncon)
                var cn = ""
                if p.acceptKw("constraint") { cn = try p.name() }
                p.pos += 2
                var nn = lexdb_sql.alterOf(A_SET_NOT_NULL, &(try p.name()))
                nn.to = cn
                append(mut &s.alters, nn)
                if !p.acceptKw(",") { break }
                continue
            }
            if p.isKw("constraint") || p.isKw("unique") || p.isKw("check") || p.isKw("foreign") || p.isKw("exclude") || p.isKw("primary") {
                var cname = ""
                if p.acceptKw("constraint") { cname = try p.name() }
                var a = lexdb_sql.alterOf(A_ADD_CON, "")
                append(mut &a.cons, try p.tableConstraint(&cname))
                if withNo {
                    // T-SQL's WITH NOCHECK: a CHECK or foreign key enforced from now on, its rows not checked (not trusted)
                    withNo = false
                    for k in 0..len(a.cons) {
                        if a.cons[k].kind == C_CHECK || a.cons[k].kind == C_FOREIGN {
                            a.cons[k].notValid = true
                            a.cons[k].stated = true
                        }
                    }
                }
                append(mut &s.alters, a)
                if !p.acceptKw(",") { break }
                continue
            }
            let c = p.acceptKw("column")
            var a = lexdb_sql.alterOf(A_ADD, "")
            if p.acceptKw("if") {
                try p.expectKw("not")
                try p.expectKw("exists")
                a.ifFlag = true
            }
            a.col.name = try p.name()
            a.col.spell = p.spelled.clone()
            try p.colTypeOpt(mut &a.col)
            // its PRIMARY KEY, UNIQUE, CHECK and REFERENCES: added after it,
            // as ADD CONSTRAINT would (9.85)
            var cons: []Constraint = []
            var colAnn: []Alter = []
            while true {
                var cn = ""
                if p.acceptKw("constraint") { cn = try p.name() }
                if p.ora && a.col.genKind == lexdb_sql.GEN_NONE && p.acceptKw("as") {
                    try p.genClause(mut &a.col, true)
                } else if p.enforcedNext() {
                    return Err(misplacedState())
                } else if p.acceptKw("not") {
                    try p.expectKw("null")
                    a.col.notNull = true
                    a.to = cn.clone()
                } else if p.acceptKw("null") {
                } else if p.acceptKw("generated") {
                    try p.identity(mut &a.col, mut &s)
                } else if p.tsql && p.acceptKw("identity") {
                    try p.tsqlIdentity(mut &a.col, mut &s)
                } else if p.acceptKw("primary") {
                    try p.expectKw("key")
                    var pk = lexdb_sql.newConstraint(C_PRIMARY, &cn)
                    append(mut &pk.cols, a.col.name.clone())
                    append(mut &cons, pk)
                } else if p.acceptKw("default") {
                    a.col.def = Some(try p.oraDefault())
                    if lexdb_sql.onNullOf(&a.col.def) > 0 { a.col.notNull = true }
                } else if p.acceptKw("unique") {
                    try p.uniqueTail()
                    var u = lexdb_sql.newConstraint(C_UNIQUE, &cn)
                    append(mut &u.cols, a.col.name.clone())
                    append(mut &cons, u)
                } else if p.acceptKw("check") {
                    let ckAt = p.pos
                    var ck = try p.checkTail(&cn)
                    let nvAt = p.notValidSince(ckAt)
                    if nvAt >= 0 { return Err(near(&p.toks[nvAt])) }     // a column's may not be NOT VALID (written, with or without NOT ENFORCED)
                    append(mut &ck.cols, a.col.name.clone())
                    append(mut &cons, ck)
                } else if p.acceptKw("references") {
                    var fk = lexdb_sql.newConstraint(C_FOREIGN, &cn)
                    append(mut &fk.cols, a.col.name.clone())
                    let fkAt = p.pos
                    try p.fkTail(mut &fk)
                    let nvAt = p.notValidSince(fkAt)
                    if nvAt >= 0 { return Err(near(&p.toks[nvAt])) }
                    append(mut &cons, fk)
                } else if p.enforcedNext() {
                    return Err(misplacedState())
                } else if p.ora && len(cn) == 0 && p.acceptKw("annotations") {
                    // (the column's annotations: after it is added)
                    append(mut &colAnn, try p.annotClause(&a.col.name, true))
                    break
                } else if len(cn) > 0 {
                    return Err(near(&p.peek()))
                } else {
                    break
                }
            }
            let added = a.col.name.clone()
            let ifNot = a.ifFlag
            append(mut &s.alters, a)
            while len(colAnn) > 0 { append(mut &s.alters, pop(mut &colAnn)) }
            // in the order written
            var k = 0
            while k < len(cons) / 2 {
                swap(mut &cons, k, len(cons) - 1 - k)
                k += 1
            }
            while len(cons) > 0 {
                var ac = lexdb_sql.alterOf(A_ADD_CON, "")
                // ADD COLUMN IF NOT EXISTS of a column there: its constraints not added either
                if ifNot { ac.name = added.clone() }
                append(mut &ac.cons, pop(mut &cons))
                append(mut &s.alters, ac)
            }
            if addList {
                if p.acceptKw(",") { continue }
                try p.expectKw(")")
                addList = false
            }
        } else if p.ora && p.isKw("modify") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "constraint" {
            // MODIFY CONSTRAINT name state (design/lexdb-new-features.md 10.5)
            p.pos += 2
            let cn = try p.name()
            try p.oraStateAlter(mut &s, &cn)
        } else if p.ora && p.acceptKw("modify") {
            // MODIFY [(] col [type] [NOT NULL | NULL] [DEFAULT e], ... [)]
            let paren = p.acceptKw("(")
            var named: []str = []
            while true {
                let n = try p.name()
                // (a column given twice: Oracle's ORA-00957)
                for x in named { if x == n { return Err(lexdb_base.err("ORA00957", "duplicate column name")) } }
                append(mut &named, n.clone())
                if p.peek().kind == T_IDENT && !p.isKw("not") && !p.isKw("null") && !p.isKw("default") && !p.isKw("annotations") {
                    var a = lexdb_sql.alterOf(A_TYPE, &n)
                    a.col.typ = try p.typeName()
                    append(mut &s.alters, a)
                }
                if p.acceptKw("not") {
                    try p.expectKw("null")
                    append(mut &s.alters, lexdb_sql.alterOf(A_SET_NOT_NULL, &n))
                } else if p.acceptKw("null") {
                    append(mut &s.alters, lexdb_sql.alterOf(A_DROP_NOT_NULL, &n))
                }
                if p.acceptKw("default") {
                    var a = lexdb_sql.alterOf(A_SET_DEFAULT, &n)
                    a.col.def = Some(try p.oraDefault())
                    let on = lexdb_sql.onNullOf(&a.col.def) > 0
                    append(mut &s.alters, a)
                    if on { append(mut &s.alters, lexdb_sql.alterOf(A_SET_NOT_NULL, &n)) }
                }
                if p.acceptKw("annotations") { append(mut &s.alters, try p.annotClause(&n, false)) }
                if !(paren && p.acceptKw(",")) { break }
            }
            if paren { try p.expectKw(")") }
        } else if p.acceptKw("drop") {
            if p.acceptKw("constraint") {
                var a = lexdb_sql.alterOf(A_DROP_CON, "")
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    a.ifFlag = true
                }
                a.name = try p.name()
                if p.acceptKw("cascade") { a.cascade = true } else { let r = p.acceptKw("restrict") }
                append(mut &s.alters, a)
                if !p.acceptKw(",") { break }
                continue
            }
            let c = p.acceptKw("column")
            if p.ora && !c && p.isKw("(") {
                p.pos += 1
                while true {
                    append(mut &s.alters, lexdb_sql.alterOf(A_DROP_COL, &(try p.name())))
                    if !p.acceptKw(",") { break }
                }
                try p.expectKw(")")
                if !p.acceptKw(",") { break }
                continue
            }
            var a = lexdb_sql.alterOf(A_DROP_COL, "")
            if p.acceptKw("if") {
                try p.expectKw("exists")
                a.ifFlag = true
            }
            a.name = try p.name()
            if p.acceptKw("cascade") { a.cascade = true } else { let r = p.acceptKw("restrict") }
            append(mut &s.alters, a)
        } else if p.acceptKw("validate") {
            try p.expectKw("constraint")
            append(mut &s.alters, lexdb_sql.alterOf(A_VALIDATE, &(try p.name())))
        } else if p.ora && p.acceptKw("annotations") {
            append(mut &s.alters, try p.annotClause("", false))
        } else if p.acceptKw("alter") {
            if !p.tsql && !p.ora && p.isKw("constraint") {
                // ALTER CONSTRAINT name [NOT] ENFORCED (PostgreSQL 18, design/lexdb-new-features.md 10.5)
                p.pos += 1
                var a = lexdb_sql.alterOf(A_CON_STATE, &(try p.name()))
                var enforced = false
                var notEnforced = false
                while true {
                    if p.isKw("enforced") {
                        p.pos += 1
                        enforced = true
                    } else if p.isKw("not") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "enforced" {
                        p.pos += 2
                        notEnforced = true
                    } else if p.isNotValid() {
                        return Err(lexdb_base.err("0A000", "constraints cannot be altered to be NOT VALID"))
                    } else if p.isKw("deferrable") || p.isKw("initially") || (p.isKw("not") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "deferrable") {
                        return Err(lexdb_base.err("0A000", "lexdb: ALTER CONSTRAINT ... DEFERRABLE is not supported"))
                    } else { break }
                }
                if enforced && notEnforced { return Err(lexdb_base.err("42601", "conflicting constraint properties")) }
                if !enforced && !notEnforced { return Err(near(&p.peek())) }
                a.mode = if enforced { lexdb_sql.CS_ON | lexdb_sql.CS_VALIDATE | lexdb_sql.CS_IF_OFF } else { lexdb_sql.CS_OFF | lexdb_sql.CS_NOVALIDATE }
                append(mut &s.alters, a)
                if !p.acceptKw(",") { break }
                continue
            }
            let c = p.acceptKw("column")
            // Oracle changes a column with MODIFY
            if p.ora { return Err(lexdb_base.err("ORA01735", "invalid ALTER TABLE option")) }
            if p.tsql {
                // ALTER COLUMN name type [NULL | NOT NULL]: a new type; without NULL or NOT NULL the column takes NULL
                if !c { return Err(near(&p.peek())) }
                let tn = try p.name()
                var ta = lexdb_sql.alterOf(A_TYPE, &tn)
                // a word that begins another action is not a type; a type name SQL Server does not know is 2715, found after the rest reads
                let tk = p.peek().clone()
                if (tk.kind != T_IDENT && tk.kind != T_QIDENT) || (tk.kind == T_IDENT && (tk.text == "set" || tk.text == "drop" || tk.text == "add" || tk.text == "alter" || tk.text == "with")) { return Err(near(&tk)) }
                let at = p.pos
                match p.typeName() {
                    Ok(ty) { ta.col.typ = ty }
                    Err(er) {
                        if er.state != "42704" { return Err(er) }
                        p.pos = at + 1
                        if !(p.peek().kind == T_EOF || p.isKw(";") || p.isKw("not") || p.isKw("null") || p.isKw(",")) { return Err(near(&p.peek())) }
                        return Err(lexdb_base.err("TS2715", &("Column, parameter, or variable #1: Cannot find data type " + tk.text + ".")))
                    }
                }
                if p.isKw("collate") { return Err(lexdb_base.err("0A000", "lexdb: ALTER COLUMN ... COLLATE is not supported yet")) }
                append(mut &s.alters, ta)
                if p.acceptKw("not") {
                    try p.expectKw("null")
                    append(mut &s.alters, lexdb_sql.alterOf(A_SET_NOT_NULL, &tn))
                } else {
                    let nl = p.acceptKw("null")
                    append(mut &s.alters, lexdb_sql.alterOf(A_DROP_NOT_NULL, &tn))
                }
                break
            }
            let n = try p.name()
            let data = p.isKw("set") && p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "data"
            if data {
                p.pos += 2
                try p.expectKw("type")
            }
            if data || p.acceptKw("type") {
                var a = lexdb_sql.alterOf(A_TYPE, &n)
                a.col.typ = try p.typeName()
                if p.acceptKw("using") {
                    let subs = len(p.subs)
                    let params = p.params
                    a.using = Some(try p.expr())
                    if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in transform expression")) }
                    if p.params > params { return Err(lexdb_base.err("42P02", &("there is no parameter $" + p.params.toStr()))) }
                }
                append(mut &s.alters, a)
            } else if p.acceptKw("add") {
                // ADD GENERATED {ALWAYS | BY DEFAULT} AS IDENTITY [(options)]
                try p.expectKw("generated")
                var a = lexdb_sql.alterOf(A_ADD_IDENTITY, &n)
                if p.acceptKw("always") { a.col.identity = ID_ALWAYS } else {
                    try p.expectKw("by")
                    try p.expectKw("default")
                    a.col.identity = ID_BY_DEFAULT
                }
                try p.expectKw("as")
                try p.expectKw("identity")
                if p.acceptKw("(") {
                    try p.seqOptions(mut &a.seq, false)
                    try p.expectKw(")")
                }
                append(mut &s.alters, a)
            } else if p.isKw("set") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "expression" {
                // SET EXPRESSION AS (expr): a generated column's new expression
                p.pos += 2
                try p.expectKw("as")
                var a = lexdb_sql.alterOf(A_SET_EXPR, &n)
                try p.genClause(mut &a.col, true)
                append(mut &s.alters, a)
            } else if p.identityNext() {
                // SET GENERATED ..., SET sequence options, RESTART [WITH n]
                var a = lexdb_sql.alterOf(A_SET_IDENTITY, &n)
                while p.identityNext() {
                    if p.acceptKw("restart") {
                        a.seq.restart = 1
                        let w = p.acceptKw("with")
                        if w || p.peek().kind == T_NUM || p.isKw("-") {
                            a.seq.restart = 2
                            a.seq.restartWith = try p.signedInt()
                        }
                        continue
                    }
                    try p.expectKw("set")
                    if p.acceptKw("generated") {
                        if p.acceptKw("always") { a.col.identity = ID_ALWAYS } else {
                            try p.expectKw("by")
                            try p.expectKw("default")
                            a.col.identity = ID_BY_DEFAULT
                        }
                        continue
                    }
                    // one option after each SET
                    let at = p.pos
                    var one = lexdb_sql.noSeqOpts()
                    try p.seqOptions(mut &one, false)
                    if p.pos == at { return Err(near(&p.peek())) }
                    lexdb_sql.mergeSeqOpts(mut &a.seq, &one)
                }
                append(mut &s.alters, a)
            } else if p.acceptKw("set") {
                if p.acceptKw("default") {
                    var a = lexdb_sql.alterOf(A_SET_DEFAULT, &n)
                    a.col.def = Some(try p.defaultExpr())
                    append(mut &s.alters, a)
                    if !p.acceptKw(",") { break }
                    continue
                }
                try p.expectKw("not")
                try p.expectKw("null")
                append(mut &s.alters, lexdb_sql.alterOf(A_SET_NOT_NULL, &n))
            } else if p.acceptKw("drop") {
                if p.acceptKw("default") {
                    append(mut &s.alters, lexdb_sql.alterOf(A_DROP_DEFAULT, &n))
                    if !p.acceptKw(",") { break }
                    continue
                }
                if p.acceptKw("expression") {
                    var a = lexdb_sql.alterOf(A_DROP_EXPR, &n)
                    if p.acceptKw("if") {
                        try p.expectKw("exists")
                        a.ifFlag = true
                    }
                    append(mut &s.alters, a)
                    if !p.acceptKw(",") { break }
                    continue
                }
                if p.acceptKw("identity") {
                    var a = lexdb_sql.alterOf(A_DROP_IDENTITY, &n)
                    if p.acceptKw("if") {
                        try p.expectKw("exists")
                        a.ifFlag = true
                    }
                    append(mut &s.alters, a)
                    if !p.acceptKw(",") { break }
                    continue
                }
                try p.expectKw("not")
                try p.expectKw("null")
                append(mut &s.alters, lexdb_sql.alterOf(A_DROP_NOT_NULL, &n))
            } else {
                return Err(lexdb_base.err("0A000", "lexdb: ALTER COLUMN takes TYPE, SET or DROP NOT NULL, SET or DROP DEFAULT, and the identity forms"))
            }
        } else {
            return Err(lexdb_base.err("0A000", "lexdb: ALTER TABLE takes ADD, DROP, ALTER COLUMN, VALIDATE CONSTRAINT, RENAME and SET SCHEMA"))
        }
        // (Oracle's ANNOTATIONS (...) and MODIFY (...) follow another clause without a comma)
        if !p.acceptKw(",") && !(p.ora && (p.isKw("annotations") || p.isKw("modify"))) { break }
    }
    return Ok(s)
}

// ALTER TABLE's constraint states of SQL Server and Oracle (design/lexdb-new-features.md 10.5), at the start of an action:
// 0 none; 1 the action read (one A_CON_STATE a name); 2 WITH CHECK, ADD follows; 3 WITH NOCHECK, ADD follows.
// T-SQL: [WITH CHECK | WITH NOCHECK] CHECK CONSTRAINT {name [, name ...] | ALL} and NOCHECK CONSTRAINT {...}.
// Oracle: ENABLE | DISABLE [VALIDATE | NOVALIDATE] CONSTRAINT name.
fn (p: mut &P) conStateAlter(s: mut &Stmt): Result[int, lexdb_base.DbErr] {
    if p.tsql {
        var w = 0
        if p.isKw("with") && p.peekAt(1).kind == T_IDENT && (p.peekAt(1).text == "check" || p.peekAt(1).text == "nocheck") {
            w = if p.peekAt(1).text == "check" { 1 } else { 2 }
            p.pos += 2
        }
        let cons = p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "constraint"
        if cons && (p.isKw("nocheck") || p.isKw("check")) {
            let mode = if p.isKw("nocheck") { lexdb_sql.CS_OFF | lexdb_sql.CS_NOVALIDATE } else { lexdb_sql.CS_ON | (if w == 1 { lexdb_sql.CS_VALIDATE } else { 0 }) }
            p.pos += 2
            if p.isKw("all") && !(p.peekAt(1).kind == T_OP && p.peekAt(1).text == ".") {
                p.pos += 1
                var a = lexdb_sql.alterOf(A_CON_STATE, lexdb_sql.CON_ALL)
                a.mode = mode
                append(mut &s.alters, a)
                return Ok(1)
            }
            while true {
                var a = lexdb_sql.alterOf(A_CON_STATE, &(try p.name()))
                a.mode = mode
                append(mut &s.alters, a)
                if !p.acceptKw(",") { break }
            }
            return Ok(1)
        }
        if w > 0 {
            if p.isKw("add") { return Ok(1 + w) }
            return Err(near(&p.peek()))
        }
        return Ok(0)
    }
    if p.ora && (p.isKw("enable") || p.isKw("disable")) {
        let en = p.isKw("enable")
        p.pos += 1
        var val = 0
        if p.acceptKw("validate") { val = 1 } else if p.acceptKw("novalidate") { val = 2 }
        if !p.isKw("constraint") { return Err(near(&p.peek())) }
        p.pos += 1
        let cn = try p.name()
        var mode = if en { lexdb_sql.CS_ON } else { lexdb_sql.CS_OFF }
        if val == 1 || (val == 0 && en) { mode = mode | lexdb_sql.CS_VALIDATE } else { mode = mode | lexdb_sql.CS_NOVALIDATE }
        var a = lexdb_sql.alterOf(A_CON_STATE, &cn)
        a.mode = mode
        append(mut &s.alters, a)
        if p.acceptKw("cascade") {}
        return Ok(1)
    }
    return Ok(0)
}

// Oracle's MODIFY CONSTRAINT name state clauses: ENABLE, DISABLE, VALIDATE, NOVALIDATE, RELY, NORELY, in any order: one A_CON_STATE.
fn (p: mut &P) oraStateAlter(s: mut &Stmt, name: &str): Result[Unit, lexdb_base.DbErr] {
    var en = 0
    var val = 0
    while true {
        if p.acceptKw("enable") { en = 1 }
        else if p.acceptKw("disable") { en = 2 }
        else if p.acceptKw("validate") { val = 1 }
        else if p.acceptKw("novalidate") { val = 2 }
        else if p.acceptKw("rely") || p.acceptKw("norely") {}
        else { break }
    }
    var a = lexdb_sql.alterOf(A_CON_STATE, name)
    if en == 1 { a.mode = lexdb_sql.CS_ON } else if en == 2 { a.mode = lexdb_sql.CS_OFF }
    if val == 1 { a.mode = a.mode | lexdb_sql.CS_VALIDATE }
    else if val == 2 { a.mode = a.mode | lexdb_sql.CS_NOVALIDATE }
    else if en == 1 { a.mode = a.mode | lexdb_sql.CS_VALIDATE }
    else if en == 2 { a.mode = a.mode | lexdb_sql.CS_NOVALIDATE }
    append(mut &s.alters, a)
    return Ok(Unit{})
}

// Whether an identity column's change follows (ALTER COLUMN c ...):
// RESTART, SET GENERATED, or SET and a sequence option.
fn (p: &P) identityNext(): bool {
    if p.isKw("restart") { return true }
    if !p.isKw("set") { return false }
    let w = p.peekAt(1).clone()
    if w.kind != T_IDENT { return false }
    if w.text == "generated" || w.text == "increment" || w.text == "minvalue" || w.text == "maxvalue" || w.text == "start" ||
       w.text == "cache" || w.text == "cycle" || w.text == "as" { return true }
    // SET NO MINVALUE | MAXVALUE | CYCLE, not SET NOT NULL
    return w.text == "no" && p.peekAt(2).kind == T_IDENT && (p.peekAt(2).text == "minvalue" || p.peekAt(2).text == "maxvalue" || p.peekAt(2).text == "cycle")
}


// "(" then SELECT: a query in parentheses, not a column list.
fn (p: &P) selectNext(): bool {
    return p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text == "select"
}

fn (p: mut &P) insert(): Result[Stmt, lexdb_base.DbErr] {
    // T-SQL: INTO may be left out; INSERT TOP (n) [PERCENT] (insertTop)
    if p.tsql && !p.isKw("into") {
        if p.isKw("top") { return p.insertTopOf() }
    } else { try p.expectKw("into") }
    var s = lexdb_sql.newStmt(S_INSERT)
    s.mdialect = if p.tsql { MD_TSQL } else if p.ora { MD_ORA } else { MD_PG }
    s.table = try p.rname()
    if p.acceptKw("as") { s.alias = try p.name() }
    if p.isKw("(") && !p.parenQueryStart() {
        p.pos += 1
        append(mut &s.names, try p.name())
        while p.acceptKw(",") { append(mut &s.names, try p.name()) }
        try p.expectKw(")")
    }
    // Oracle 26ai: INSERT INTO t SET c = v, (c, d) = (v, w), ...; INSERT INTO t [(cols)] BY NAME | BY POSITION query
    if p.ora && (p.isKw("set") || p.isKw("by")) {
        if p.isKw("by") { return p.oraInsertBy(s) }
        if len(s.names) > 0 { return Err(near(&p.peek())) }
        return p.oraInsertSet(s)
    }
    if p.tsql && p.acceptKw("output") {
        // T-SQL: OUTPUT INSERTED.col, ... [INTO target [(columns)]]: RETURNING
        var out: []SelItem = []
        try p.outputList(mut &s, mut &out)
        try tsqlDml(mut &s, out)
    }
    if p.acceptKw("overriding") {
        if p.acceptKw("system") { s.overriding = OVR_SYSTEM } else {
            try p.expectKw("user")
            s.overriding = OVR_USER
        }
        try p.expectKw("value")
    }
    // INSERT ... SELECT: the query in inner[0], with its own subqueries
    let paren = p.isKw("(") && p.parenQueryStart()
    if paren || p.isKw("select") {
        var q = lexdb_sql.newStmt(S_SELECT)
        if paren { q = try p.parenSelect() } else {
            p.pos += 1
            q = try p.select()
        }
        q.subs = replace(mut &p.subs, [])
        q.wins = replace(mut &p.wins, [])
        q.params = p.params
        append(mut &s.inner, q)
        try p.onConflict(mut &s)
        try p.oraNoReturning()
        try p.returning(mut &s)
        return Ok(s)
    }
    if p.acceptKw("default") {
        // DEFAULT VALUES: one row, every column its default
        try p.expectKw("values")
        append(mut &s.rows, [])
        try p.onConflict(mut &s)
        try p.returning(mut &s)
        return Ok(s)
    }
    if !p.acceptKw("values") {
        // INSERT INTO t WITH ... SELECT (Oracle's and PostgreSQL's: a recursive CTE feeding an INSERT)
        if !p.tsql && p.isKw("with") { return p.insertWith(s) }
        return Err(near(&p.peek()))
    }
    while true {
        try p.expectKw("(")
        var row: []Expr = []
        append(mut &row, try p.valueOrDefault())
        while p.acceptKw(",") { append(mut &row, try p.valueOrDefault()) }
        try p.expectKw(")")
        append(mut &s.rows, row)
        if !p.acceptKw(",") { break }
    }
    try p.onConflict(mut &s)
    try p.returning(mut &s)
    return Ok(s)
}






// At INSERT's TOP: the TOP, then the rest of the INSERT, the one applied to the other (insertTop).
fn (p: mut &P) insertTopOf(): Result[Stmt, lexdb_base.DbErr] {
    p.pos += 1
    var tq = lexdb_sql.newStmt(S_SELECT)
    try p.top(mut &tq, false)
    return insertTop(try p.insert(), tq)
}

// T-SQL's INSERT TOP (n) [PERCENT] (tq: its limit and topMode) of INSERT s: the query's TOP (its rows' first n, or n percent
// rounded up; which ones is undefined, as SQL Server's), the query read as a derived table under it when it has its own TOP,
// ORDER BY, OFFSET or a set operation; VALUES' rows cut by a constant n.
fn insertTop(s0: Stmt, tq: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var s = s0
    var t = tq
    if len(s.inner) == 0 {
        let n = match t.limit { Some(x) { match x { Expr.Lit(v) { match v { Val.Int(i) { i } else { -2 } } } else { -2 } } } None { -2 } }
        if n == -2 { return Err(lexdb_base.err("0A000", "lexdb: INSERT TOP of VALUES takes a constant count")) }
        if n < 0 { return Err(lexdb_base.err("TS127", "A TOP N or FETCH rowcount value may not be negative.")) }
        var keep = n
        if t.topMode & TOP_PERCENT != 0 {
            if n > 100 { return Err(lexdb_base.err("TS1031", "Percent values must be between 0 and 100.")) }
            keep = (len(s.rows) * n + 99) / 100
        }
        while len(s.rows) > keep { let x = pop(mut &s.rows) }
        return Ok(s)
    }
    var q = pop(mut &s.inner)
    if q.limit.isSome() || q.offset.isSome() || q.topMode != 0 || q.setop != 0 || len(q.order) > 0 {
        var w = lexdb_sql.newStmt(S_SELECT)
        w.params = q.params
        q.use = SUB_FROM
        append(mut &w.subs, q)
        append(mut &w.from, FromItem{table: "", alias: "top_", join: J_FIRST, on: None, sub: 0, cols: [], work: -1, lateral: false, using: [], natural: false, comma: true})
        append(mut &w.items, SelItem{star: true, qual: "", expr: None, alias: "", spell: ""})
        q = w
    }
    q.limit = replace(mut &t.limit, None)
    q.topMode = t.topMode
    append(mut &s.inner, q)
    return Ok(s)
}

// INSERT's query that starts WITH, at WITH: the query in inner[0], its CTEs in scope.
fn (p: mut &P) insertWith(s0: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var s = s0
    p.pos += 1
    let n = try p.withList()
    try p.expectKw("select")
    var q = try p.select()
    p.popCtes(n)
    q.subs = replace(mut &p.subs, [])
    q.wins = replace(mut &p.wins, [])
    q.params = p.params
    append(mut &s.inner, q)
    try p.onConflict(mut &s)
    try p.oraNoReturning()
    try p.returning(mut &s)
    return Ok(s)
}


// ON CONFLICT [(col, ...) [WHERE pred] | ON CONSTRAINT name]
//   DO NOTHING | DO UPDATE SET col = expr, ... [WHERE cond]  (9.77)
// A target's WHERE (a partial unique index's predicate) is read and not
// kept: the index is chosen by its columns.
fn (p: mut &P) onConflict(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if !p.isKw("on") { return Ok(Unit{}) }
    p.pos += 1
    try p.expectKw("conflict")
    if p.acceptKw("(") {
        append(mut &s.conflictCols, try p.name())
        while p.acceptKw(",") { append(mut &s.conflictCols, try p.name()) }
        try p.expectKw(")")
        if p.acceptKw("where") { let pred = try p.expr() }
    } else if p.acceptKw("on") {
        try p.expectKw("constraint")
        s.conflictCon = try p.name()
    }
    try p.expectKw("do")
    if p.acceptKw("nothing") {
        s.conflict = CONFLICT_NOTHING
        return Ok(Unit{})
    }
    if p.isKw("select") { return p.conflictSelect(s) }
    try p.expectKw("update")
    try p.expectKw("set")
    s.conflict = CONFLICT_UPDATE
    try p.setList(s)
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    return Ok(Unit{})
}

// SET's list (UPDATE's, ON CONFLICT DO UPDATE's): col = value, or (a, b) =
// (x, y); a value may be DEFAULT.
fn (p: mut &P) setList(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    while true {
        if p.acceptKw("(") {
            var cols: []str = [try p.name()]
            while p.acceptKw(",") { append(mut &cols, try p.name()) }
            try p.expectKw(")")
            try p.expectKw("=")
            try p.expectKw("(")
            for i in 0..len(cols) {
                if i > 0 { try p.expectKw(",") }
                append(mut &s.sets, SetItem{col: cols[i].clone(), expr: try p.valueOrDefault()})
            }
            try p.expectKw(")")
        } else {
            var c = try p.name()
            if (p.tsql || p.ora) && p.acceptKw(".") { c = try p.name() }      // T-SQL, Oracle: SET t.col = (the target's)
            if p.tsql && !p.isKw("=") {
                // T-SQL: SET c += e and the like
                let op = p.tsqlCompound()
                if len(op) == 0 { return Err(near(&p.peek())) }
                let v = try p.expr()
                append(mut &s.sets, SetItem{col: c.clone(), expr: tsqlAssign(&op, Expr.Col(c.clone(), -1), v)})
            } else {
                try p.expectKw("=")
                append(mut &s.sets, SetItem{col: c, expr: try p.valueOrDefault()})
            }
        }
        if !p.acceptKw(",") { break }
    }
    return Ok(Unit{})
}

// SELECT, after its keyword: a query, or queries joined by UNION,
// INTERSECT (first) and EXCEPT; then ORDER BY, LIMIT and OFFSET, of the
// whole. The queries joined each keep their subqueries.
fn (p: mut &P) select(): Result[Stmt, lexdb_base.DbErr] {
    var first = try p.selectCore()
    let rn = replace(mut &p.rnLimit, -1)
    if len(first.sets) > 0 {
        // T-SQL's GROUP BY ALL: ORDER BY's aggregates too (groupAll)
        let gi = pop(mut &first.sets)
        let w = gi.expr
        if !p.isKw("union") && !p.isKw("intersect") && !p.isKw("except") {
            try p.orderLimit(mut &first)
            for i in 0..len(first.order) { first.order[i].expr = allAgg(&first.order[i].expr, &w) }
            return Ok(first)
        }
    }
    if !p.isKw("union") && !p.isKw("intersect") && !p.isKw("except") {
        try p.orderLimit(mut &first)
        if rn >= 0 { first = p.oraLimit(first, rn) }
        return Ok(first)
    }
    if rn >= 0 { first.limit = Some(Expr.Lit(Val.Int(rn))) }
    first.subs = replace(mut &p.subs, [])
    first.wins = replace(mut &p.wins, [])
    var lhs = try p.intersects(first)
    while p.isKw("union") || p.isKw("except") {
        var op = SET_EXCEPT
        if p.acceptKw("union") { op = SET_UNION } else { let x = p.acceptKw("except") }
        let all = p.setAll()
        let rhs = try p.intersects(try p.armBranch())
        lhs = setOf(op, all, lhs, rhs, p.md())
    }
    try p.orderLimit(mut &lhs)
    return Ok(lhs)
}

fn (p: mut &P) setAll(): bool {
    if p.acceptKw("all") { return true }
    let d = p.acceptKw("distinct")
    return false
}

// The dialect being read (lexdb_sql.MD_*).
fn (p: &P) md(): int { return if p.tsql { MD_TSQL } else if p.ora { MD_ORA } else { MD_PG } }

// (md: its dialect, whose common type of chars it takes: lexdb_exec.planSet)
fn setOf(op: int, all: bool, l: Stmt, r: Stmt, md: int): Stmt {
    var s = lexdb_sql.newStmt(S_SELECT)
    s.setop = op
    s.setAll = all
    s.mdialect = md
    append(mut &s.inner, l)
    append(mut &s.inner, r)
    return s
}

fn (p: mut &P) intersects(first: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var lhs = first
    while p.acceptKw("intersect") {
        let all = p.setAll()
        let rhs = try p.armBranch()
        lhs = setOf(SET_INTERSECT, all, lhs, rhs, p.md())
    }
    return Ok(lhs)
}

// A query whose first operand is in parentheses, at its "(": (SELECT ...) UNION ..., or one query in parentheses
// (PostgreSQL's select_with_parens), then ORDER BY and LIMIT of the whole. One query alone leaves its subqueries in
// p.subs, as select() does, and takes an ORDER BY, LIMIT or OFFSET after it as its own (PostgreSQL's
// insertSelectOptions: one of each).
fn (p: mut &P) parenSelect(): Result[Stmt, lexdb_base.DbErr] {
    var first = try p.setBranch()
    if p.isKw("union") || p.isKw("intersect") || p.isKw("except") {
        try p.armOrder(&first)
        var lhs = try p.intersects(first)
        while p.isKw("union") || p.isKw("except") {
            var op = SET_EXCEPT
            if p.acceptKw("union") { op = SET_UNION } else { let x = p.acceptKw("except") }
            let all = p.setAll()
            let rhs = try p.intersects(try p.armBranch())
            lhs = setOf(op, all, lhs, rhs, p.md())
        }
        try p.orderLimit(mut &lhs)
        return Ok(lhs)
    }
    p.subs = replace(mut &first.subs, [])
    p.wins = replace(mut &first.wins, [])
    let o0 = replace(mut &first.order, [])
    let l0 = replace(mut &first.limit, None)
    let f0 = replace(mut &first.offset, None)
    try p.orderLimit(mut &first)
    if len(o0) > 0 {
        if len(first.order) > 0 { return Err(lexdb_base.err("42601", "multiple ORDER BY clauses not allowed")) }
        first.order = o0
    }
    if l0.isSome() {
        if first.limit.isSome() { return Err(lexdb_base.err("42601", "multiple LIMIT clauses not allowed")) }
        first.limit = l0
    }
    if f0.isSome() {
        if first.offset.isSome() { return Err(lexdb_base.err("42601", "multiple OFFSET clauses not allowed")) }
        first.offset = f0
    }
    return Ok(first)
}

// At "(": "("s, then SELECT or WITH.
fn (p: &P) parenQueryStart(): bool {
    var k = p.pos
    while k < len(p.toks) && p.toks[k].kind == T_OP && p.toks[k].text == "(" { k += 1 }
    return k > p.pos && k < len(p.toks) && p.toks[k].kind == T_IDENT && (p.toks[k].text == "select" || p.toks[k].text == "with")
}

// At "(" in an expression or FROM: a query in parentheses that is a whole subquery, or its first operand: after its
// ")" comes ")", a set operation, ORDER BY or LIMIT. (((SELECT 1) + 1) is an expression, ((SELECT 1), 2) a list.)
fn (p: &P) parenQuery(): bool { return p.parenAt(0) }

// parenQuery at the token d after this one.
fn (p: &P) parenAt(d: int): bool {
    var k = p.pos + d
    while k < len(p.toks) && p.toks[k].kind == T_OP && p.toks[k].text == "(" { k += 1 }
    if k == p.pos + d || k >= len(p.toks) || p.toks[k].kind != T_IDENT || (p.toks[k].text != "select" && p.toks[k].text != "with") { return false }
    var depth = 0
    k = p.pos + d
    while k < len(p.toks) {
        if p.toks[k].kind == T_OP && p.toks[k].text == "(" { depth += 1 }
        if p.toks[k].kind == T_OP && p.toks[k].text == ")" {
            depth -= 1
            if depth == 0 { break }
        }
        k += 1
    }
    if k + 1 >= len(p.toks) { return false }
    let n = &p.toks[k + 1]
    if n.kind == T_OP { return n.text == ")" }
    return n.kind == T_IDENT && (n.text == "union" || n.text == "intersect" || n.text == "except" || n.text == "order" ||
                                 n.text == "limit" || n.text == "offset" || n.text == "fetch")
}

// A role as GRANT and the like name it: a name, PUBLIC (""), CURRENT_USER
// and the like (as "#current_user", resolved when run).
fn (p: mut &P) roleSpec(): Result[str, lexdb_base.DbErr] {
    let t = p.peek().clone()
    if t.kind == T_IDENT && t.text == "public" {
        p.pos += 1
        return Ok("")
    }
    if t.kind == T_IDENT && (t.text == "current_user" || t.text == "session_user" || t.text == "current_role") {
        p.pos += 1
        return Ok("#" + (if t.text == "session_user" { "session_user" } else { "current_user" }))
    }
    if t.kind == T_IDENT && t.text == "user" {
        p.pos += 1
        return Ok("#current_user")
    }
    return p.name()
}

// GRANT privileges ON object TO roles, REVOKE [GRANT OPTION FOR]
// privileges ON object FROM roles [CASCADE | RESTRICT]; GRANT role, ... TO
// role, ..., REVOKE role, ... FROM role, ... (9.83).
fn (p: mut &P) grantStmt(grant: bool): Result[Stmt, lexdb_base.DbErr] {
    var g = lexdb_sql.newStmt(if grant { S_GRANT } else { S_REVOKE })
    if !grant && p.isKw("grant") && p.peekAt(1).text == "option" {
        return Err(lexdb_base.err("0A000", "lexdb: grant options are not supported"))
    }
    // privileges, or roles: names until ON (privileges) or TO / FROM (roles)
    if p.acceptKw("all") {
        let pr = p.acceptKw("privileges")
        append(mut &g.names, "all")
    } else {
        while true {
            let w = p.next()
            if w.kind != T_IDENT && w.kind != T_QIDENT { return Err(near(&w)) }
            append(mut &g.names, w.text.clone())
            if p.isKw("(") { return Err(lexdb_base.err("0A000", "lexdb: column privileges are not supported")) }
            if !p.acceptKw(",") { break }
        }
    }
    if p.acceptKw("on") {
        if p.tsql {
            // SQL Server's: ON [OBJECT::]name. The privileges of a table are its five; the others (ALTER, CONTROL,
            // VIEW DEFINITION, ...) are SQL Server's too and not modelled, TRUNCATE and TRIGGER are no word of its.
            if p.peekAt(1).text == "::" {
                let cls = p.peek().text.clone()
                if cls != "object" { return Err(lexdb_base.err("0A000", &("lexdb: GRANT ON " + strings.toUpperAscii(&cls) + "::... is not supported"))) }
                p.pos += 2
            }
            for k in 0..len(g.names) { if g.names[k] == "exec" { g.names[k] = "execute".toStr() } }
            for pn in g.names {
                if pn == "select" || pn == "insert" || pn == "update" || pn == "delete" || pn == "references" || pn == "all" || pn == "execute" { continue }
                if pn == "truncate" || pn == "trigger" || pn == "maintain" || pn == "usage" {
                    var at = p.pos - 1
                    for k in 0..p.pos { if p.toks[k].text == pn { at = k } }
                    return Err(near(&p.toks[at]))
                }
                return Err(lexdb_base.err("0A000", &("lexdb: the " + strings.toUpperAscii(&pn) + " permission is not supported")))
            }
        }
        if p.acceptKw("all") {
            let w = p.next().text
            if w != "tables" && w != "sequences" && w != "functions" && w != "procedures" && w != "routines" {
                return Err(lexdb_base.err("0A000", &("lexdb: GRANT ON ALL " + strings.toUpperAscii(&w) + " is not supported")))
            }
            try p.expectKw("in")
            try p.expectKw("schema")
            g.index = "all " + w
        } else if p.acceptKw("sequence") {
            g.index = "sequence"
        } else if p.acceptKw("schema") {
            g.index = "schema"
        } else if p.acceptKw("database") {
            g.index = "database"
        } else if (p.isKw("function") || p.isKw("procedure") || p.isKw("routine")) && !p.tsql {
            // each routine as "name NUL signature" in cols (the signature "*": the name alone)
            g.index = p.next().text.clone()
        } else if p.isKw("type") || p.isKw("domain") ||
                  p.isKw("language") || p.isKw("tablespace") || p.isKw("foreign") || p.isKw("large") {
            return Err(lexdb_base.err("0A000", &("lexdb: privileges on " + p.peek().text + " are not supported")))
        } else {
            let tb = p.acceptKw("table")
            // SQL Server's names an object of any kind (a table, view, procedure, function): found when the statement runs
            g.index = if p.tsql { "object" } else { "table" }
        }
        while true {
            if g.index == "function" || g.index == "procedure" || g.index == "routine" {
                let key = try p.rname()
                let sig = try p.routineSig()
                append(mut &g.cols, lexdb_sql.colDef(&(key + "\x00" + sig), TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
                if !p.acceptKw(",") { break }
                continue
            }
            let nm = if g.index == "table" || g.index == "sequence" || g.index == "object" { try p.qname() } else { try p.name() }
            append(mut &g.cols, lexdb_sql.colDef(&nm, TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
            if !p.acceptKw(",") { break }
        }
    } else {
        // GRANT role, ... TO ...: the roles were read as names
        g.index = "role"
        let granted = replace(mut &g.names, [])
        for r in granted { append(mut &g.cols, lexdb_sql.colDef(&r, TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false)) }
    }
    if grant { try p.expectKw("to") } else if p.tsql && p.isKw("to") { p.pos += 1 } else { try p.expectKw("from") }
    while true {
        let a = p.acceptKw("group")
        append(mut &g.pk, try p.roleSpec())
        if !p.acceptKw(",") { break }
    }
    if p.acceptKw("with") {
        let w = p.next().text
        if w == "grant" || w == "admin" { return Err(lexdb_base.err("0A000", "lexdb: grant and admin options are not supported")) }
        if w == "inherit" || w == "set" { return Err(lexdb_base.err("0A000", "lexdb: membership options are not supported")) }
        return Err(near(&p.toks[p.pos - 1]))
    }
    if p.acceptKw("granted") {
        try p.expectKw("by")
        let by = try p.roleSpec()
    }
    if p.acceptKw("cascade") { g.cascade = true } else { let r = p.acceptKw("restrict") }
    return Ok(g)
}

// CREATE [OR REPLACE] VIEW name [(column, ...)] AS query, after "view":
// the query is parsed to check it, and kept as its text (from its first
// token to the statement's end), to be parsed again where it is used (9.82).
fn (p: mut &P) createView(orReplace: bool, alterOnly: bool): Result[Stmt, lexdb_base.DbErr] {
    var v = lexdb_sql.newStmt(S_CREATE_VIEW)
    // where its CREATE is (a few tokens back: CREATE [OR ALTER | OR REPLACE] [TEMP] VIEW)
    var from = -1
    var k = p.pos
    while k > 0 && p.pos - k < 8 {
        k -= 1
        if p.toks[k].kind == T_IDENT && (p.toks[k].text == "create" || (alterOnly && p.toks[k].text == "alter")) {
            from = p.toks[k].at
            break
        }
    }
    v.ifFlag = orReplace || alterOnly
    v.alter = alterOnly
    v.mdialect = if p.tsql { MD_TSQL } else if p.ora { MD_ORA } else { MD_PG }
    // T-SQL keeps CREATE OR ALTER's definition without its "OR ALTER" (SQL Server shows CREATE   VIEW)
    var cutAt = -1
    var cutAlter = -1
    if p.tsql && orReplace && from >= 0 {
        for k2 in 0..len(p.toks) - 3 {
            if p.toks[k2].at == from && p.toks[k2 + 1].text == "or" && p.toks[k2 + 2].text == "alter" {
                cutAt = p.toks[k2 + 1].at
                cutAlter = p.toks[k2 + 2].at
            }
        }
    }
    v.table = try p.rname()
    v.spell = p.spelled.clone()
    if p.acceptKw("(") {
        while true {
            let vn = try p.name()
            append(mut &v.names, vn.clone())
            append(mut &v.spells, p.spelled.clone())
            if p.ora && p.acceptKw("annotations") { append(mut &v.alters, try p.annotClause(&vn, true)) }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    }
    while p.ora && p.acceptKw("annotations") { append(mut &v.alters, try p.annotClause("", true)) }
    // T-SQL's WITH SCHEMABINDING, VIEW_METADATA, ENCRYPTION (SCHEMABINDING kept: SB_MARK; the others read)
    var bound = false
    let withAt = p.peek().at
    if p.tsql && p.acceptKw("with") {
        while true {
            let o = p.next()
            // (WITH CHECK OPTION before AS: SQL Server's 102 at WITH, as written)
            if o.kind == T_IDENT && o.text == "check" { return Err(lexdb_base.err("TS102", &("Incorrect syntax near '" + p.src[withAt..min(withAt + 4, len(p.src))] + "'."))) }
            if o.kind != T_IDENT || (o.text != "schemabinding" && o.text != "view_metadata" && o.text != "encryption") { return Err(lexdb_base.err("TS195", &("'" + o.text + "' is not a recognized option."))) }
            if o.text == "schemabinding" { bound = true }
            if !p.acceptKw(",") { break }
        }
    }
    if p.isKw("with") { return Err(lexdb_base.err("0A000", "lexdb: view options (WITH (...)) are not supported")) }
    try p.expectKw("as")
    let start = p.peek().at
    let pq = p.isKw("(") && p.parenQueryStart()
    let t = if pq { p.peek().clone() } else { p.next() }
    var q = lexdb_sql.newStmt(S_SELECT)
    if pq {
        q = try p.parenSelect()
    } else if t.kind == T_IDENT && t.text == "select" {
        q = try p.select()
    } else if t.kind == T_IDENT && t.text == "values" {
        q = try p.valuesQuery()
        try p.orderLimit(mut &q)
    } else if t.kind == T_IDENT && t.text == "with" {
        let n = try p.withList()
        try p.expectKw("select")
        q = try p.select()
        p.popCtes(n)
    } else {
        return Err(near(&t))
    }
    let end = p.peek().at
    if p.isKw("with") { return Err(lexdb_base.err("0A000", "lexdb: WITH CHECK OPTION is not supported")) }
    if bound { for it in q.items { if it.star { return Err(lexdb_base.err("TS1054", "Syntax '*' is not allowed in schema-bound objects.")) } } }
    if bound { try p.boundNames(start, end, &(if len(v.spell) > 0 { v.spell.clone() } else { lexdb_sql.baseName(&v.table) })) }
    v.index = strings.trim(&p.src[start..end]).toStr()
    // made over TDS: T-SQL, tagged so (parseView)
    if p.tsql {
        v.index = TSQL_VIEW + v.index + (if bound { lexdb_sql.SB_MARK } else { "" })
        // the statement's text from its CREATE to the end of the batch, as SQL Server keeps it
        if from >= 0 {
            v.index = v.index + lexdb_sql.DEF_MARK
            if cutAt >= 0 {
                v.index = v.index + p.src[from..cutAt] + p.src[cutAt + 2..cutAlter] + p.src[cutAlter + 5..len(p.src)]
            } else if alterOnly {
                // SQL Server keeps an ALTER VIEW's text as CREATE VIEW's
                v.index = v.index + "CREATE" + p.src[from + 5..len(p.src)]
            } else {
                v.index = v.index + p.src[from..len(p.src)]
            }
        }
    }
    else if p.ora { v.index = ORA_VIEW + v.index }
    // the query's subqueries were parsed into the statement's: dropped (the
    // text is parsed again where the view is used)
    p.subs = []
    p.wins = []
    if q.params > 0 || p.params > 0 { return Err(lexdb_base.err("42P02", "there is no parameter $1")) }
    return Ok(v)
}

fn encMvOpts(mode: int, timing: int, rewrite: bool, oqc: bool, deferred: bool,
             hasMode: bool, hasTiming: bool, hasRewrite: bool, hasOqc: bool, compile: bool): str {
    return mode.toStr() + "|" + timing.toStr() + "|" + (if rewrite { "1" } else { "0" }) + "|" +
           (if oqc { "1" } else { "0" }) + "|" + (if deferred { "1" } else { "0" }) + "|" +
           (if hasMode { "1" } else { "0" }) + "|" + (if hasTiming { "1" } else { "0" }) + "|" +
           (if hasRewrite { "1" } else { "0" }) + "|" + (if hasOqc { "1" } else { "0" }) + "|" +
           (if compile { "1" } else { "0" })
}

// CREATE MATERIALIZED VIEW [IF NOT EXISTS] name [(col, ...)] [options] AS query [WITH [NO] DATA]
// and Oracle's CREATE MATERIALIZED VIEW LOG ON tbl [WITH ...]
fn (p: mut &P) createMview(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("view")
    if p.acceptKw("log") {
        try p.expectKw("on")
        var s = lexdb_sql.newStmt(S_MVIEW_LOG)
        s.alias = "create"
        s.mdialect = p.md()
        s.table = try p.rname()
        s.spell = p.spelled.clone()
        // Consume optional Oracle clauses: [TABLESPACE ...] [WITH [PRIMARY KEY | ROWID | SEQUENCE | (cols)] [, ...] [INCLUDING|EXCLUDING NEW VALUES]]
        var pk = false
        var rid = false
        var seq = false
        var newVals = false
        while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") {
            if p.acceptKw("tablespace") { let ts = try p.name(); continue }
            if p.acceptKw("with") {
                while true {
                    if p.acceptKw("primary") { try p.expectKw("key"); pk = true }
                    else if p.acceptKw("rowid") { rid = true }
                    else if p.acceptKw("sequence") { seq = true }
                    else if p.acceptKw("object") { try p.expectKw("id") }
                    else if p.acceptKw("(") {
                        while true {
                            append(mut &s.names, try p.name())
                            if !p.acceptKw(",") { break }
                        }
                        try p.expectKw(")")
                    } else { break }
                    if !p.acceptKw(",") && !p.isKw("(") { break }
                }
                continue
            }
            if p.acceptKw("including") { try p.expectKw("new"); try p.expectKw("values"); newVals = true; continue }
            if p.acceptKw("excluding") { try p.expectKw("new"); try p.expectKw("values"); newVals = false; continue }
            if p.acceptKw("purge") {
                let pm = p.acceptKw("immediate") || p.acceptKw("deferred")
                continue
            }
            break
        }
        if !pk && !rid { pk = true }
        s.mvOpts = (if rid { "1" } else { "0" }) + "|" + (if pk { "1" } else { "0" }) + "|" +
                   (if seq { "1" } else { "0" }) + "|" + (if newVals { "1" } else { "0" })
        return Ok(s)
    }

    var mv = lexdb_sql.newStmt(S_CREATE_MVIEW)
    mv.mdialect = p.md()
    if p.acceptKw("if") {
        try p.expectKw("not")
        try p.expectKw("exists")
        mv.ifFlag = true
    }
    mv.table = try p.rname()
    mv.spell = p.spelled.clone()
    if p.acceptKw("(") {
        while true {
            append(mut &mv.names, try p.name())
            append(mut &mv.spells, p.spelled.clone())
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    }

    var mode = if p.ora { lexdb_sql.MV_FORCE } else { lexdb_sql.MV_COMPLETE }
    var timing = lexdb_sql.MV_DEMAND
    var rewrite = false
    var oqc = false
    var deferred = false
    var hasMode = false
    var hasTiming = false
    var hasRewrite = false
    var hasOqc = false

    // Parse PostgreSQL & Oracle clauses before AS.
    while !p.isKw("as") && p.peek().kind != T_EOF {
        if p.acceptKw("using") {
            let um = try p.name()
        } else if p.acceptKw("tablespace") {
            let ts = try p.name()
        } else if p.acceptKw("with") {
            try p.expectKw("(")
            while true {
                let opt = try p.name()
                try p.expectKw("=")
                let valTok = p.next()
                let v = strings.toLowerAscii(&valTok.text)
                if opt == "refresh" {
                    if v == "demand" || v == "complete" || v == "complete_on_demand" {
                        mode = lexdb_sql.MV_COMPLETE; timing = lexdb_sql.MV_DEMAND; hasMode = true; hasTiming = true
                    } else if v == "fast_on_commit" || v == "incremental" {
                        mode = lexdb_sql.MV_FAST; timing = lexdb_sql.MV_COMMIT; hasMode = true; hasTiming = true
                    } else if v == "fast_on_statement" || v == "immediate" {
                        mode = lexdb_sql.MV_FAST; timing = lexdb_sql.MV_STATEMENT; hasMode = true; hasTiming = true
                    } else if v == "force_on_commit" {
                        mode = lexdb_sql.MV_FORCE; timing = lexdb_sql.MV_COMMIT; hasMode = true; hasTiming = true
                    } else if v == "force_on_statement" {
                        mode = lexdb_sql.MV_FORCE; timing = lexdb_sql.MV_STATEMENT; hasMode = true; hasTiming = true
                    } else if v == "complete_on_commit" {
                        mode = lexdb_sql.MV_COMPLETE; timing = lexdb_sql.MV_COMMIT; hasMode = true; hasTiming = true
                    } else if v == "fast_on_demand" {
                        mode = lexdb_sql.MV_FAST; timing = lexdb_sql.MV_DEMAND; hasMode = true; hasTiming = true
                    } else if v == "realtime" {
                        mode = lexdb_sql.MV_FAST; timing = lexdb_sql.MV_REALTIME; oqc = true; hasMode = true; hasTiming = true; hasOqc = true
                    } else {
                        return Err(lexdb_base.err("22023", &("invalid value for materialized view option \"refresh\": \"" + v + "\"")))
                    }
                } else if opt == "query_rewrite" {
                    rewrite = v == "true" || v == "on" || v == "1"
                    hasRewrite = true
                }
                if !p.acceptKw(",") { break }
            }
            try p.expectKw(")")
        } else if p.acceptKw("build") {
            if p.acceptKw("immediate") { deferred = false }
            else if p.acceptKw("deferred") { deferred = true; mv.noData = true }
            else { return Err(near(&p.peek())) }
        } else if p.acceptKw("refresh") {
            if p.acceptKw("fast") { mode = lexdb_sql.MV_FAST; hasMode = true }
            else if p.acceptKw("complete") { mode = lexdb_sql.MV_COMPLETE; hasMode = true }
            else if p.acceptKw("force") { mode = lexdb_sql.MV_FORCE; hasMode = true }
            if p.acceptKw("on") {
                if p.acceptKw("demand") { timing = lexdb_sql.MV_DEMAND; hasTiming = true }
                else if p.acceptKw("commit") { timing = lexdb_sql.MV_COMMIT; hasTiming = true }
                else if p.acceptKw("statement") { timing = lexdb_sql.MV_STATEMENT; hasTiming = true }
                else { return Err(near(&p.peek())) }
            }
        } else if p.acceptKw("never") {
            try p.expectKw("refresh")
            mode = lexdb_sql.MV_COMPLETE
            timing = lexdb_sql.MV_DEMAND
        } else if p.acceptKw("enable") {
            if p.acceptKw("query") { try p.expectKw("rewrite"); rewrite = true; hasRewrite = true }
            else if p.acceptKw("on") { try p.expectKw("query"); try p.expectKw("computation"); oqc = true; hasOqc = true }
            else { return Err(near(&p.peek())) }
        } else if p.acceptKw("disable") {
            if p.acceptKw("query") { try p.expectKw("rewrite"); rewrite = false; hasRewrite = true }
            else if p.acceptKw("on") { try p.expectKw("query"); try p.expectKw("computation"); oqc = false; hasOqc = true }
            else { return Err(near(&p.peek())) }
        } else {
            return Err(near(&p.peek()))
        }
    }

    try p.expectKw("as")
    let start = p.peek().at
    let pq = p.isKw("(") && p.parenQueryStart()
    let t = if pq { p.peek().clone() } else { p.next() }
    var q = lexdb_sql.newStmt(S_SELECT)
    if pq {
        q = try p.parenSelect()
    } else if t.kind == T_IDENT && t.text == "select" {
        q = try p.select()
    } else if t.kind == T_IDENT && t.text == "values" {
        q = try p.valuesQuery()
        try p.orderLimit(mut &q)
    } else if t.kind == T_IDENT && t.text == "with" {
        let n = try p.withList()
        try p.expectKw("select")
        q = try p.select()
        p.popCtes(n)
    } else {
        return Err(near(&t))
    }
    let end = p.peek().at
    if p.acceptKw("with") {
        if p.acceptKw("no") { mv.noData = true; deferred = true }
        try p.expectKw("data")
    }
    mv.index = strings.trim(&p.src[start..end]).toStr()
    mv.mvOpts = encMvOpts(mode, timing, rewrite, oqc, deferred, hasMode, hasTiming, hasRewrite, hasOqc, false)
    p.subs = []
    p.wins = []
    if q.params > 0 || p.params > 0 { return Err(lexdb_base.err("42P02", "there is no parameter $1")) }
    return Ok(mv)
}

fn (p: mut &P) refreshMview(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("materialized")
    try p.expectKw("view")
    var s = lexdb_sql.newStmt(S_REFRESH_MVIEW)
    s.mdialect = p.md()
    if p.acceptKw("concurrently") { s.conc = true }
    s.table = try p.rname()
    var mode = lexdb_sql.MV_COMPLETE
    var hasMode = false
    if p.acceptKw("fast") { mode = lexdb_sql.MV_FAST; hasMode = true }
    else if p.acceptKw("complete") { mode = lexdb_sql.MV_COMPLETE; hasMode = true }
    else if p.acceptKw("force") { mode = lexdb_sql.MV_FORCE; hasMode = true }
    if p.acceptKw("with") {
        if p.acceptKw("no") { s.noData = true }
        try p.expectKw("data")
    }
    s.mvOpts = encMvOpts(mode, lexdb_sql.MV_DEMAND, false, false, s.noData, hasMode, false, false, false, false)
    return Ok(s)
}

fn (p: mut &P) dropMview(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("view")
    if p.acceptKw("log") {
        try p.expectKw("on")
        var s = lexdb_sql.newStmt(S_MVIEW_LOG)
        s.alias = "drop"
        s.mdialect = p.md()
        s.table = try p.rname()
        return Ok(s)
    }
    var s = lexdb_sql.newStmt(S_DROP_MVIEW)
    s.mdialect = p.md()
    if p.acceptKw("if") {
        try p.expectKw("exists")
        s.ifFlag = true
    }
    while true {
        append(mut &s.cols, lexdb_sql.colDef(&(try p.rname()), TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
        if !p.acceptKw(",") { break }
    }
    if p.acceptKw("cascade") { s.cascade = true } else { let _ = p.acceptKw("restrict") }
    return Ok(s)
}

fn (p: mut &P) alterMview(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("view")
    var s = lexdb_sql.newStmt(S_ALTER_MVIEW)
    s.mdialect = p.md()
    if p.acceptKw("if") {
        try p.expectKw("exists")
        s.ifFlag = true
    }
    s.table = try p.qname()
    if p.acceptKw("rename") {
        if p.acceptKw("to") {
            s.alias = "rename"
            s.index = try p.name()
            return Ok(s)
        }
        let _ = p.acceptKw("column")
        s.alias = "rename_col"
        append(mut &s.names, try p.name())
        try p.expectKw("to")
        s.index = try p.name()
        return Ok(s)
    }
    if p.acceptKw("owner") {
        try p.expectKw("to")
        var o = lexdb_sql.newStmt(S_OWNER)
        o.index = "materialized view"
        o.table = s.table.clone()
        o.ifFlag = s.ifFlag
        append(mut &o.names, try p.roleSpec())
        return Ok(o)
    }
    var mode = lexdb_sql.MV_COMPLETE
    var timing = lexdb_sql.MV_DEMAND
    var rewrite = false
    var oqc = false
    var hasMode = false
    var hasTiming = false
    var hasRewrite = false
    var hasOqc = false
    var compile = false
    var any = false
    while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") {
        if p.acceptKw("refresh") {
            any = true
            if p.acceptKw("fast") { mode = lexdb_sql.MV_FAST; hasMode = true }
            else if p.acceptKw("complete") { mode = lexdb_sql.MV_COMPLETE; hasMode = true }
            else if p.acceptKw("force") { mode = lexdb_sql.MV_FORCE; hasMode = true }
            if p.acceptKw("on") {
                if p.acceptKw("demand") { timing = lexdb_sql.MV_DEMAND; hasTiming = true }
                else if p.acceptKw("commit") { timing = lexdb_sql.MV_COMMIT; hasTiming = true }
                else if p.acceptKw("statement") { timing = lexdb_sql.MV_STATEMENT; hasTiming = true }
                else { return Err(near(&p.peek())) }
            }
        } else if p.acceptKw("enable") {
            any = true
            if p.acceptKw("query") { try p.expectKw("rewrite"); rewrite = true; hasRewrite = true }
            else if p.acceptKw("on") { try p.expectKw("query"); try p.expectKw("computation"); oqc = true; hasOqc = true }
            else { return Err(near(&p.peek())) }
        } else if p.acceptKw("disable") {
            any = true
            if p.acceptKw("query") { try p.expectKw("rewrite"); rewrite = false; hasRewrite = true }
            else if p.acceptKw("on") { try p.expectKw("query"); try p.expectKw("computation"); oqc = false; hasOqc = true }
            else { return Err(near(&p.peek())) }
        } else if p.acceptKw("compile") {
            any = true
            compile = true
        } else {
            return Err(near(&p.peek()))
        }
    }
    if !any { return Err(near(&p.peek())) }
    s.alias = "opts"
    s.mvOpts = encMvOpts(mode, timing, rewrite, oqc, false, hasMode, hasTiming, hasRewrite, hasOqc, compile)
    return Ok(s)
}

// A role's options, after its name: [WITH] LOGIN, NOLOGIN, SUPERUSER,
// NOSUPERUSER, [ENCRYPTED] PASSWORD 'text' | NULL into s.names ("login",
// "nologin", "superuser", "nosuperuser", "password:" and the text,
// "password-null"); the rest PostgreSQL has are read and not kept.
fn (p: mut &P) roleOptions(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    let w = p.acceptKw("with")
    while p.peek().kind == T_IDENT {
        let o = p.next().text
        match o {
            "login", "nologin", "superuser", "nosuperuser" { append(mut &s.names, o) }
            "encrypted", "password" {
                if o == "encrypted" { try p.expectKw("password") }
                if p.acceptKw("null") {
                    append(mut &s.names, "password-null")
                } else {
                    let t = p.next()
                    if t.kind != T_STR { return Err(near(&t)) }
                    append(mut &s.names, "password:" + t.text)
                }
            }
            "createdb", "nocreatedb", "createrole", "nocreaterole", "inherit", "noinherit", "replication", "noreplication",
            "bypassrls", "nobypassrls" {}
            "connection" {
                try p.expectKw("limit")
                if p.acceptKw("-") {}
                let n = try p.intLit()
            }
            "valid" {
                try p.expectKw("until")
                let t = p.next()
                if t.kind != T_STR { return Err(near(&t)) }
            }
            "sysid" { let n = try p.intLit() }
            "in", "role", "admin", "user" {
                if o == "in" { if !p.acceptKw("role") { try p.expectKw("group") } }
                let n = try p.name()
                while p.acceptKw(",") { let m = try p.name() }
            }
            else { return Err(lexdb_base.err("42601", &("unrecognized role option \"" + o + "\""))) }
        }
    }
    return Ok(Unit{})
}

// VALUES (a, b), (c, d), ... after "values": a function in FROM
// ("#values:" and its width) whose arguments are the rows' values, row by
// row; its number in p.subs (9.80).
fn (p: mut &P) valuesSub(): Result[int, lexdb_base.DbErr] {
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var s = lexdb_sql.newStmt(S_SELECT)
    s.use = SUB_FROM
    var k = -1
    while true {
        try p.expectKw("(")
        var n = 0
        while true {
            append(mut &s.items, SelItem{star: false, qual: "", expr: Some(try p.expr()), alias: "", spell: ""})
            n += 1
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
        if k < 0 { k = n } else if k != n {
            if p.ora { return Err(oraErr(63801, "each tuple should have same number of elements in a Table Value Constructor")) }
            return Err(lexdb_base.err("42601", "VALUES lists must all be the same length"))
        }
        if !p.acceptKw(",") { break }
    }
    s.srf = "#values:" + k.toStr()
    s.subs = replace(mut &p.subs, saved)
    s.wins = replace(mut &p.wins, savedW)
    p.depth -= 1
    append(mut &p.subs, s)
    return Ok(len(p.subs) - 1)
}

// VALUES ... as a query: SELECT * FROM (VALUES ...) AS "*VALUES*".
fn (p: mut &P) valuesQuery(): Result[Stmt, lexdb_base.DbErr] {
    let i = try p.valuesSub()
    var s = lexdb_sql.newStmt(S_SELECT)
    append(mut &s.items, SelItem{star: true, qual: "", expr: None, alias: "", spell: ""})
    append(mut &s.from, FromItem{table: "", alias: "*VALUES*", join: J_FIRST, on: None, sub: i, cols: [], work: -1, lateral: false, using: [], natural: false, comma: false})
    return Ok(s)
}

// One query of a UNION (and the like): SELECT ..., VALUES ..., or one in
// parentheses with its own ORDER BY and LIMIT.
// An operand of UNION, INTERSECT or EXCEPT after the first (setBranch), its ORDER BY checked (armOrder).
fn (p: mut &P) armBranch(): Result[Stmt, lexdb_base.DbErr] {
    let b = try p.setBranch()
    try p.armOrder(&b)
    return Ok(b)
}

// SQL Server: an operand of a set operation in parentheses has no ORDER BY of its own (156 at ORDER; TOP or not).
fn (p: &P) armOrder(b: &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.tsql && b.setop == 0 && len(b.order) > 0 { return Err(lexdb_base.err("TS156", "Incorrect syntax near the keyword 'ORDER'.")) }
    return Ok(Unit{})
}

fn (p: mut &P) setBranch(): Result[Stmt, lexdb_base.DbErr] {
    var b = lexdb_sql.newStmt(S_SELECT)
    if p.acceptKw("values") {
        b = try p.valuesQuery()
    } else if p.acceptKw("(") {
        var n = 0
        if p.acceptKw("with") { n = try p.withList() }
        let r = if p.isKw("(") { p.parenSelect() } else if p.acceptKw("select") { p.select() } else { Err(near(&p.peek())) }
        p.popCtes(n)
        b = try r
        try p.expectKw(")")
    } else {
        try p.expectKw("select")
        b = try p.selectCore()
        let rn = replace(mut &p.rnLimit, -1)
        if len(b.sets) > 0 { b.sets = [] }
        if rn >= 0 { b.limit = Some(Expr.Lit(Val.Int(rn))) }
    }
    b.subs = replace(mut &p.subs, [])
    b.wins = replace(mut &p.wins, [])
    return Ok(b)
}

fn isColExpr(x: &Expr): bool {
    match x {
        Expr.Col(n, _) { return true }
        else { return false }
    }
}

// A SELECT's output list, or RETURNING's: *, t.*, expr [[AS] alias], ...
fn (p: mut &P) itemList(items: mut &[]SelItem): Result[Unit, lexdb_base.DbErr] {
    var none: []str = []
    return p.itemListAssign(items, mut &none)
}

// itemList with T-SQL's SELECT @v = expr: assign gets each item's variable
// ("" none) once there is one, else stays [].
fn (p: mut &P) itemListAssign(items: mut &[]SelItem, assign: mut &[]str): Result[Unit, lexdb_base.DbErr] {
    while true {
        let q = p.peek().clone()
        if p.acceptKw("*") {
            append(items, SelItem{star: true, qual: "", expr: None, alias: "", spell: ""})
        } else if (q.kind == T_IDENT || q.kind == T_QIDENT) && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." &&
                  p.peekAt(2).kind == T_OP && p.peekAt(2).text == "*" {
            p.pos += 3
            append(items, SelItem{star: true, qual: q.text.clone(), expr: None, alias: "", spell: ""})
        } else if p.tsql && q.kind == T_VAR && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "=" {
            // T-SQL: SELECT @v = expr (design/lexdb-tds.md)
            let target = try p.variable(&q)
            p.pos += 2
            let e = try p.expr()
            while len(assign) < len(items) { append(assign, "") }
            append(assign, q.text.clone())
            append(items, SelItem{star: false, qual: "", expr: Some(e), alias: q.text.clone(), spell: ""})
        } else if p.tsql && (q.kind == T_QIDENT || q.kind == T_STR || (q.kind == T_IDENT && !lexdb_sql.isReserved(&q.text))) &&
                  p.peekAt(1).kind == T_OP && p.peekAt(1).text == "=" {
            // T-SQL: SELECT alias = expr
            p.pos += 2
            let e = try p.expr()
            let al = if q.kind == T_STR { strings.toLowerAscii(&q.text) } else { q.text.clone() }
            let sp = if q.kind == T_STR { q.text.clone() } else { q.spell.clone() }
            append(items, SelItem{star: false, qual: "", expr: Some(e), alias: al, spell: sp})
        } else {
            let eStart = p.pos
            let e = try p.expr()
            let eEnd = p.pos
            // the column's name as written (L6): a bare column's, or the alias's
            var spell = ""
            // (an expression of the PostgreSQL door: its integer literals' arithmetic checked, lexdb_litint)
            if isColExpr(&e) && p.pos > 0 { spell = p.toks[p.pos - 1].spell.clone() } else if !p.tsql && !p.ora { try lexdb_litint.walk(&e) }
            var alias = ""
            if p.tsql && (p.peek().kind == T_STR || (p.isKw("as") && p.peekAt(1).kind == T_STR)) {
                // T-SQL: expr [AS] 'alias'
                let a0 = p.acceptKw("as")
                let t = p.next()
                alias = strings.toLowerAscii(&t.text)
                spell = t.text.clone()
            } else if p.acceptKw("as") {
                alias = try p.name()
                if p.tsql { try p.notTsqlReserved(p.pos - 1) }
                spell = p.spelled.clone()
            } else {
                let t = p.peek().clone()
                let fetch = t.kind == T_IDENT && t.text == "fetch" && p.peekAt(1).kind == T_IDENT && (p.peekAt(1).text == "first" || p.peekAt(1).text == "next")
                if !fetch && !p.waitAhead() && (t.kind == T_QIDENT || (t.kind == T_IDENT && !lexdb_sql.isReserved(&t.text) && !(p.tsql && (tsqlStarts(&t.text) || lexdb_sql.tsqlReserved(&t.text))))) {
                    alias = t.text.clone()
                    spell = t.spell.clone()
                    p.pos += 1
                }
            }
            // T-SQL: a column that is neither a table's nor named has no name
            if p.tsql && len(alias) == 0 && !isColExpr(&e) { spell = ANON }
            if p.ora && len(alias) == 0 && !isColExpr(&e) { spell = p.oraLabel(eStart, eEnd) }
            if p.ora && len(alias) == 0 {
                match e {
                    Expr.Call(fnm, fargs, _) {
                        if (fnm == "nextval" || fnm == "currval") && len(fargs) == 1 { spell = strings.toUpperAscii(&fnm) }
                    }
                    else {}
                }
            }
            append(items, SelItem{star: false, qual: "", expr: Some(e), alias: alias, spell: spell})
        }
        if !p.acceptKw(",") { break }
    }
    if p.tsql { for it in items { match it.expr { Some(x) { try tsqlNotPredicate(&x) } None {} } } }
    return Ok(Unit{})
}

// RETURNING items, after INSERT, UPDATE, DELETE or MERGE (9.44); the old and new rows (lexdb_oldnew): PostgreSQL 18's
// [WITH (OLD AS o, NEW AS n)] old.c, new.*, Oracle 23ai's OLD c, NEW c.
fn (p: mut &P) returning(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("returning") { try p.returningList(s) }
    return Ok(Unit{})
}




// The rest of an Oracle query block at START WITH or CONNECT BY (in either order; a hierarchical query, lexdb_recur.hierQuery):
// its GROUP BY, HAVING and WINDOW as selectCore reads them, its ORDER [SIBLINGS] BY and FETCH, then the query as a recursive CTE.
fn (p: mut &P) hierTail(s0: Stmt, rn: int): Result[Stmt, lexdb_base.DbErr] {
    var s = s0
    var start: Option[Expr] = None
    var conn: Option[Expr] = None
    var nocycle = false
    for k in 0..2 {
        if start.isNone() && p.isKw("start") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "with" {
            p.pos += 2
            start = Some(try p.expr())
        } else if conn.isNone() && p.isKw("connect") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "by" {
            p.pos += 2
            nocycle = p.acceptKw("nocycle")
            conn = Some(try p.expr())
        }
    }
    match conn {
        Some(c) { s.exprs = [lexdb_recur.hierMark(start, c, nocycle)] }
        None { return Err(oraErr(1788, "CONNECT BY clause required in this query block")) }
    }
    if p.acceptKw("group") {
        try p.expectKw("by")
        try p.groupBy(mut &s)
    }
    if p.acceptKw("having") { s.having = Some(try p.expr()) }
    if p.isKw("qualify") { try p.oraQualify(mut &s) }
    p.rnLimit = rn
    try p.orderLimit(mut &s)
    let id = p.nextCte
    p.nextCte += 1
    try lexdb_recur.hierQuery(mut &s, mut &p.subs, id)
    return Ok(s)
}

// ---- Oracle's old outer join operator, a.x = b.y (+) (design/lexdb-oracle.md, O4: JDBC's
// DatabaseMetaData queries use it). In a SELECT's WHERE, each AND-ed condition with the marker
// on columns of one FROM item (listed after a comma, after the items the condition names) is
// moved, without the marker, into the ON of that item, which becomes a LEFT JOIN.

fn oraHasOuter(x: &Expr): bool {
    match x {
        Expr.Unary(op, a) { return oraHasOuter(&a) }
        Expr.Bin(op, a, b) { return oraHasOuter(&a) || oraHasOuter(&b) }
        Expr.IsNull(a, neg) { return oraHasOuter(&a) }
        Expr.Cast(a, t) { return oraHasOuter(&a) }
        Expr.Call(n, args, star) {
            if n == "#outer" { return true }
            for a in args { if oraHasOuter(&a) { return true } }
            return false
        }
        else { return false }
    }
}

fn oraStripOuter(x: &Expr): Expr {
    match x {
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), oraStripOuter(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), oraStripOuter(&a), oraStripOuter(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(oraStripOuter(&a), neg) }
        Expr.Cast(a, t) { return Expr.Cast(oraStripOuter(&a), t) }
        Expr.Call(n, args, star) {
            if n == "#outer" && len(args) == 1 { return oraStripOuter(&args[0]) }
            var out: []Expr = []
            for a in args { append(mut &out, oraStripOuter(&a)) }
            return Expr.Call(n.clone(), out, star)
        }
        else { return cloneE(x) }
    }
}

// The qualifier of a column name ("" none).
fn oraQual(n: &str): str {
    var at = -1
    for i in 0..len(n) { if n[i] == '.' { at = i } }
    return if at < 0 { "" } else { n[0..at].toStr() }
}

// The qualifiers of the columns under a marker (marked) or anywhere (all); an unqualified one is "".
fn oraAliases(x: &Expr, under: bool, out: mut &[]str) {
    match x {
        Expr.Col(n, _) { if under { append(mut &out, oraQual(&n)) } }
        Expr.Unary(op, a) { oraAliases(&a, under, mut &out) }
        Expr.Bin(op, a, b) {
            oraAliases(&a, under, mut &out)
            oraAliases(&b, under, mut &out)
        }
        Expr.IsNull(a, neg) { oraAliases(&a, under, mut &out) }
        Expr.Cast(a, t) { oraAliases(&a, under, mut &out) }
        Expr.Call(n, args, star) {
            for a in args { oraAliases(&a, under || n == "#outer", mut &out) }
        }
        else {}
    }
}

fn oraSplitAnd(x: &Expr, out: mut &[]Expr) {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" {
                oraSplitAnd(&a, mut &out)
                oraSplitAnd(&b, mut &out)
                return
            }
            append(mut &out, cloneE(x))
        }
        else { append(mut &out, cloneE(x)) }
    }
}

fn oraAndAll(es: &[]Expr): Option[Expr] {
    var acc: Option[Expr] = None
    for e in es {
        acc = match replace(mut &acc, None) {
            Some(a) { Some(Expr.Bin("and", a, cloneE(&e))) }
            None { Some(cloneE(&e)) }
        }
    }
    return acc
}

fn oraOuterJoins(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    var has = false
    match s.where {
        Some(w) { has = oraHasOuter(&w) }
        None {}
    }
    if !has { return Ok(Unit{}) }
    let bad = lexdb_base.err("0A000", "this use of the old outer join operator (+) is not supported: use LEFT or RIGHT JOIN")
    var conj: []Expr = []
    match replace(mut &s.where, None) {
        Some(w) { oraSplitAnd(&w, mut &conj) }
        None {}
    }
    var keep: []Expr = []
    var onAt: []int = []
    var onEx: []Expr = []
    for c in conj {
        if !oraHasOuter(&c) {
            append(mut &keep, cloneE(&c))
            continue
        }
        var marked: []str = []
        oraAliases(&c, false, mut &marked)
        if len(marked) == 0 || len(marked[0]) == 0 { return Err(bad) }
        var idx = -1
        for k in 0..len(s.from) { if s.from[k].alias == marked[0] { idx = k } }
        if idx <= 0 || s.from[idx].join != J_CROSS { return Err(bad) }
        for m in marked { if m != marked[0] { return Err(bad) } }
        var all: []str = []
        for k in 0..1 { oraAllAliases(&c, mut &all) }
        for a in all {
            if a == marked[0] { continue }
            var ri = -1
            for k in 0..len(s.from) { if s.from[k].alias == a { ri = k } }
            if ri > idx { return Err(bad) }
        }
        append(mut &onAt, idx)
        append(mut &onEx, oraStripOuter(&c))
    }
    for k in 0..len(s.from) {
        var mine: []Expr = []
        for j in 0..len(onAt) { if onAt[j] == k { append(mut &mine, cloneE(&onEx[j])) } }
        if len(mine) == 0 { continue }
        s.from[k].join = J_LEFT
        s.from[k].comma = false
        s.from[k].on = oraAndAll(mine)
    }
    s.where = oraAndAll(keep)
    if s.where.isSome() {
        match s.where {
            Some(w) { if oraHasOuter(&w) { return Err(bad) } }
            None {}
        }
    }
    return Ok(Unit{})
}

// Every column's qualifier in x.
fn oraAllAliases(x: &Expr, out: mut &[]str) {
    match x {
        Expr.Col(n, _) { append(mut &out, oraQual(&n)) }
        Expr.Unary(op, a) { oraAllAliases(&a, mut &out) }
        Expr.Bin(op, a, b) {
            oraAllAliases(&a, mut &out)
            oraAllAliases(&b, mut &out)
        }
        Expr.IsNull(a, neg) { oraAllAliases(&a, mut &out) }
        Expr.Cast(a, t) { oraAllAliases(&a, mut &out) }
        Expr.Call(n, args, star) { for a in args { oraAllAliases(&a, mut &out) } }
        else {}
    }
}

// GROUP BY's list, after BY (9.94 for ROLLUP, CUBE, GROUPING SETS, () and
// DISTINCT): its expressions, each once, in group; with any of those, the
// grouping sets as places in group (gsets), the items' sets crossed. A row
// (a, b) is its fields.
// T-SQL's GROUP BY ALL: the groups of every row, WHERE's or not, each aggregate over the rows WHERE keeps (a group of
// none has the aggregates of no rows: COUNT 0, the others NULL). As SQL Server's plan does it: WHERE moves into each
// aggregate's argument (CASE WHEN w THEN x END; COUNT(*) counts CASE WHEN w THEN 1 END) and is dropped. The select list
// and HAVING here, ORDER BY's in select (gallW).
fn (p: mut &P) groupAll(s: mut &Stmt) {
    s.sets = []
    match replace(mut &s.where, None) {
        Some(w) {
            for i in 0..len(s.items) {
                match s.items[i].expr {
                    Some(x) { s.items[i].expr = Some(allAgg(&x, &w)) }
                    None {}
                }
            }
            match s.having {
                Some(h) { s.having = Some(allAgg(&h, &w)) }
                None {}
            }
            append(mut &s.sets, SetItem{col: GALL_SET, expr: w})
        }
        None {}
    }
}

fn allAgg(x: &Expr, w: &Expr): Expr {
    match x {
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), allAgg(&a, w)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), allAgg(&a, w), allAgg(&b, w)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(allAgg(&a, w), neg) }
        Expr.Cast(a, t) { return Expr.Cast(allAgg(&a, w), t) }
        Expr.Call(n, args, star) {
            if lexdb_sql.isAgg(&n) {
                if star { return Expr.Call(n.clone(), [Expr.Call("case", [cloneE(w), Expr.Lit(Val.Int(1))], false)], false) }
                var out: []Expr = []
                for i in 0..len(args) {
                    // the value aggregated (STRING_AGG's separator as it is)
                    append(mut &out, if i == 0 { Expr.Call("case", [cloneE(w), cloneE(&args[i])], false) } else { cloneE(&args[i]) })
                }
                return Expr.Call(n.clone(), out, false)
            }
            var out: []Expr = []
            for a in args { append(mut &out, allAgg(&a, w)) }
            return Expr.Call(n.clone(), out, star)
        }
        else { return cloneE(x) }
    }
}

// T-SQL: a predicate is not a value (SELECT REGEXP_LIKE(...), SELECT a IS DISTINCT FROM b: 156; in CASE WHEN, IIF and
// WHERE it is one).
fn tsqlNotPredicate(e: &Expr): Result[Unit, lexdb_base.DbErr] {
    var x = e
    match e {
        Expr.Unary(op, a) { if op == "not" { x = &a } }
        else {}
    }
    match x {
        Expr.Call(n, _, _) {
            if n == "regexp_like" { return Err(lexdb_base.err("TS156", "Incorrect syntax near the keyword 'regexp_like'.")) }
            if n == "distinct from" { return Err(lexdb_base.err("TS156", "Incorrect syntax near the keyword 'IS'.")) }
        }
        else {}
    }
    return Ok(Unit{})
}

// A T-SQL REGEXP_ call's flags, marked as SQL Server's (lexdb_sql.RE_TSQL; a NULL stays NULL).
fn tsReFlags(f: Expr): Expr {
    match f {
        Expr.Lit(v) {
            match v {
                Val.Text(t) { return Expr.Lit(Val.Text(lexdb_sql.RE_TSQL + t)) }
                Val.Null { return Expr.Lit(Val.Null) }
                else {}
            }
        }
        else {}
    }
    return Expr.Bin("||", Expr.Lit(Val.Text(lexdb_sql.RE_TSQL)), f)
}

fn isNullLit(x: &Expr): bool {
    match x {
        Expr.Lit(v) { match v { Val.Null { return true } else { return false } } }
        else { return false }
    }
}

fn isTextLit(x: &Expr): bool {
    match x {
        Expr.Lit(v) { match v { Val.Text(_) { return true } else { return false } } }
        else { return false }
    }
}

// Oracle: the session has ALTER SESSION SET group_by_position_enabled = TRUE (GB_POS after the formats in nls).
fn (p: &P) gbPos(): bool { return len(p.nls) > 0 && p.nls[len(p.nls) - 1] == GB_POS }

// Whether x calls a subquery.
fn hasSubRef(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasSubRef(&a) }
        Expr.Bin(_, a, b) { return hasSubRef(&a) || hasSubRef(&b) }
        Expr.IsNull(a, _) { return hasSubRef(&a) }
        Expr.Cast(a, _) { return hasSubRef(&a) }
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) { return true }
            for a in args { if hasSubRef(&a) { return true } }
            return false
        }
        else { return false }
    }
}


// GROUP BY's list; T-SQL's GROUP BY ALL (groupAll), which keeps the groups WHERE removed, marked in s.sets (GALL_SET).
fn (p: mut &P) groupBy(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    var distinct = false
    if p.ora && p.isKw("all") { return p.oraGroupAll(s) }
    if p.acceptKw("distinct") { distinct = true } else if p.acceptKw("all") { if p.tsql { append(mut &s.sets, SetItem{col: GALL_SET.toStr(), expr: Expr.Lit(Val.Null)}) } }
    s.mdialect = p.md()             // its dialect's rules for names and positions (lexdb_bind.resolveGroupIn)
    var sets: [][]Expr = [[]]          // the cross product so far
    var special = false
    while true {
        let mine = try p.groupItem(true, mut &special)
        var next: [][]Expr = []
        for a in sets {
            for b in mine {
                var u: []Expr = []
                for x in a { append(mut &u, cloneE(&x)) }
                for x in b { append(mut &u, cloneE(&x)) }
                append(mut &next, u)
            }
        }
        sets = next
        if !p.acceptKw(",") { break }
    }
    // (T-SQL's GROUP BY ALL takes no WITH ROLLUP or CUBE)
    if len(s.sets) > 0 && p.isKw("with") { return Err(lexdb_base.err("TS1028", "The CUBE() and ROLLUP() grouping constructs are not allowed in a GROUP BY clause with the keyword ALL.")) }
    var texts: []str = []
    for st in sets {
        for x in st {
            let t = lexdb_sql.exprText(&x)
            var seen = false
            for y in texts { if y == t { seen = true } }
            if !seen {
                append(mut &texts, t)
                append(mut &s.group, cloneE(&x))
            }
        }
    }
    for i in 0..len(s.group) {
        if p.tsql {
            // SQL Server groups by expressions of columns: a constant (a position too) or a variable is 164
            var names: []str = []
            lexdb_sql.colNames(&s.group[i], mut &names)
            if len(names) == 0 && !hasSubRef(&s.group[i]) {
                return Err(lexdb_base.err("TS164", "Each GROUP BY expression must contain at least one column that is not an outer reference."))
            }
        } else if p.ora && !p.gbPos() && lexdb_sql.litInt(&s.group[i]) >= 0 {
            // Oracle: a number is a constant, not a position, unless the session enables them (lexdb_sql.gbConst)
            s.group[i] = lexdb_sql.gbConst(lexdb_sql.litInt(&s.group[i]))
        }
    }
    if !special { return Ok(Unit{}) }
    var keys: []str = []
    for st in sets {
        var places: []int = []
        for x in st {
            let t = lexdb_sql.exprText(&x)
            for i in 0..len(texts) {
                if texts[i] == t {
                    var dup = false
                    for q in places { if q == i { dup = true } }
                    if !dup { append(mut &places, i) }
                }
            }
        }
        if distinct {
            // GROUP BY DISTINCT: a set listed again (in any order) once
            var sorted: []int = []
            for i in 0..len(texts) { for q in places { if q == i { append(mut &sorted, i) } } }
            var kb = ""
            for q in sorted { kb += &(q.toStr() + ",") }
            let k = kb
            var again = false
            for y in keys { if y == k { again = true } }
            if again { continue }
            append(mut &keys, k)
        }
        append(mut &s.gsets, places)
    }
    return Ok(Unit{})
}

// One item of GROUP BY (top: of the list itself), as its grouping sets:
// an expression [[x]]; (a, b) [[a, b]] (at the top, the same); () [[]];
// ROLLUP (x, y) [[x, y], [x], []]; CUBE (x, y) every subset; GROUPING SETS
// (...) its items' sets one after another.
fn (p: mut &P) groupItem(top: bool, special: mut &bool): Result[[][]Expr, lexdb_base.DbErr] {
    if p.isKw("(") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == ")" {
        p.pos += 2
        special = true
        return Ok([[]])
    }
    let t = p.peek().clone()
    let kw = if t.kind == T_IDENT && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" { t.text.clone() } else { "" }
    if kw == "rollup" || kw == "cube" {
        p.pos += 2
        special = true
        var parts: [][]Expr = []
        while true {
            let x = try p.expr()
            if isRow(&x) { append(mut &parts, try rowItems(&x)) } else { append(mut &parts, [x]) }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
        var out: [][]Expr = []
        let n = len(parts)
        if kw == "rollup" {
            var k = n
            while k >= 0 {
                var u: []Expr = []
                for i in 0..k { for x in parts[i] { append(mut &u, cloneE(&x)) } }
                append(mut &out, u)
                k -= 1
            }
        } else {
            if n > 12 { return Err(lexdb_base.err("54001", "CUBE is limited to 12 elements")) }
            // as PostgreSQL lists them: the larger sets first
            var size = n
            while size >= 0 {
                for mask in 0..(1 << n) {
                    var bits = 0
                    for i in 0..n { if (mask >> (n - 1 - i)) & 1 == 1 { bits += 1 } }
                    if bits != size { continue }
                    var u: []Expr = []
                    for i in 0..n { if (mask >> (n - 1 - i)) & 1 == 1 { for x in parts[i] { append(mut &u, cloneE(&x)) } } }
                    append(mut &out, u)
                }
                size -= 1
            }
        }
        return Ok(out)
    }
    if t.kind == T_IDENT && t.text == "grouping" && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "sets" {
        p.pos += 2
        special = true
        try p.expectKw("(")
        var out: [][]Expr = []
        while true {
            var got = try p.groupItem(false, special)
            for i in 0..len(got) { append(mut &out, replace(mut &got[i], [])) }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
        return Ok(out)
    }
    let x = try p.expr()
    if isRow(&x) { return Ok([try rowItems(&x)]) }
    return Ok([[x]])
}


// Whether the query block the parser is in has a QUALIFY clause before here (Oracle: FOR UPDATE of it is ORA-01786).
fn (p: &P) qualifyBefore(): bool {
    var depth = 0
    var k = p.pos - 1
    while k >= 0 {
        let t = &p.toks[k]
        if t.kind == T_OP && t.text == ")" { depth += 1 }
        else if t.kind == T_OP && t.text == "(" {
            if depth == 0 { return false }
            depth -= 1
        } else if depth == 0 && t.kind == T_IDENT && t.text == "qualify" { return true }
        k -= 1
    }
    return false
}

// FOR UPDATE | NO KEY UPDATE | SHARE | KEY SHARE [OF t, ...] [NOWAIT |
// SKIP LOCKED], after FOR. Several: the strongest, the tables of all.
fn (p: mut &P) lockClause(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.ora && p.qualifyBefore() { return Err(lexdb_base.err("ORA01786", "FOR UPDATE of this query expression is not allowed")) }
    var m = LOCK_UPDATE
    if p.acceptKw("update") { m = LOCK_UPDATE }
    else if p.acceptKw("share") { m = LOCK_SHARE }
    else if p.acceptKw("no") {
        try p.expectKw("key")
        try p.expectKw("update")
        m = LOCK_NO_KEY_UPDATE
    } else {
        try p.expectKw("key")
        try p.expectKw("share")
        m = LOCK_KEY_SHARE
    }
    if m > s.lockMode { s.lockMode = m }
    if p.acceptKw("of") {
        append(mut &s.lockOf, try p.qname())
        while p.acceptKw(",") { append(mut &s.lockOf, try p.qname()) }
    }
    if p.acceptKw("nowait") { s.lockWait = WAIT_NOWAIT }
    else if p.acceptKw("skip") {
        try p.expectKw("locked")
        s.lockWait = WAIT_SKIP
    }
    return Ok(Unit{})
}

// T-SQL's TOP, after TOP: n or (expr), then (in a SELECT) PERCENT and
// WITH TIES; its count in limit.
fn (p: mut &P) top(s: mut &Stmt, sel: bool): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("(") {
        s.limit = Some(try p.expr())
        try p.expectKw(")")
    } else {
        let t = p.next()
        if t.kind != T_NUM { return Err(near(&t)) }
        p.pos -= 1
        s.limit = Some(try p.primary())
    }
    if p.acceptKw("percent") { s.topMode = s.topMode | TOP_PERCENT }        // (UPDATE, DELETE and INSERT TOP n PERCENT too)
    if sel && p.isKw("with") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "ties" {
        p.pos += 2
        s.topMode = s.topMode | TOP_TIES
    }
    return Ok(Unit{})
}

// Whether WAIT begins a SELECT's wait clause here: the word, then a number,
// a parameter or a variable (not an alias or a name called wait).
fn (p: &P) waitAhead(): bool {
    if !(p.toks[p.pos].kind == T_IDENT && p.toks[p.pos].text == "wait") { return false }
    let k = p.peekAt(1).kind
    return k == T_NUM || k == T_PARAM || k == T_VAR
}

// A statement SELECT's last clause: WAIT n SECONDS | MILLISECONDS (| MS),
// the SELECT that waits for rows (design/lexdb-events.md). n is a whole
// number, a parameter or a variable, as LIMIT's. Not a reserved word.
// (Oracle's FOR UPDATE WAIT n is a lock wait, not supported: left as the
// syntax error it is.)
fn (p: mut &P) waitSuffix(q: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if !(p.peek().kind == T_IDENT && p.peek().text == "wait") { return Ok(Unit{}) }
    if p.ora && q.lockMode > 0 { return Ok(Unit{}) }
    p.pos += 1
    let bad = lexdb_base.err("42601", "WAIT needs a number and a unit: WAIT n SECONDS or WAIT n MILLISECONDS")
    let k = p.peek().kind
    if !(k == T_NUM || k == T_PARAM || k == T_VAR || (k == T_OP && p.peek().text == "(")) { return Err(bad) }
    let n = try p.primary()
    match n {
        Expr.Lit(v) {
            match v {
                Val.Int(_) {}
                else { return Err(lexdb_base.err("42601", "WAIT takes a whole number of seconds or milliseconds")) }
            }
        }
        else {}
    }
    let u = p.next()
    if u.kind != T_IDENT { return Err(bad) }
    match u.text {
        "second", "seconds" { q.waitMul = 1000 }
        "millisecond", "milliseconds", "ms" { q.waitMul = 1 }
        else { return Err(bad) }
    }
    if len(q.into) > 0 { return Err(lexdb_base.err("0A000", "lexdb: WAIT cannot be used with SELECT INTO")) }
    q.waitFor = true
    q.waitMs = Some(n)
    return Ok(Unit{})
}

// -n of an integer literal n: the literal -n; None for anything else.
fn negPos(x: &Expr): Option[Expr] {
    match x {
        Expr.Unary(op, a) {
            if op == "-" {
                match a {
                    Expr.Lit(v) {
                        match v {
                            Val.Int(k) { return Some(Expr.Lit(Val.Int(0 - k))) }
                            else {}
                        }
                    }
                    else {}
                }
            }
        }
        else {}
    }
    return None
}

fn (p: mut &P) orderLimit(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.acceptKw("order") {
        // Oracle: ORDER SIBLINGS BY, a hierarchical query's
        if p.ora && p.acceptKw("siblings") {
            if !lexdb_recur.isHier(s) { return Err(oraErr(30929, "ORDER SIBLINGS BY clause not allowed here")) }
            lexdb_recur.markSiblings(s)
        }
        try p.expectKw("by")
        while true {
            var e = try p.expr()
            // -n: a position (not in the list) in PostgreSQL and SQL Server, a constant in Oracle (lexdb_bind.orderPos)
            if !p.ora {
                match negPos(&e) {
                    Some(l) { e = l }
                    None {}
                }
            }
            var desc = false
            if p.acceptKw("desc") { desc = true } else { let a = p.acceptKw("asc") }
            var nf = if p.tsql { !desc } else { desc }      // SQL Server's NULLs are the least
            if p.acceptKw("nulls") {
                if p.acceptKw("first") { nf = true } else {
                    try p.expectKw("last")
                    nf = false
                }
            }
            append(mut &s.order, OrderItem{expr: e, desc: desc, nullsFirst: nf})
            if !p.acceptKw(",") { break }
        }
    }
    var limited = false
    var offset = false
    while p.isKw("limit") || p.isKw("offset") || p.isKw("for") || p.isKw("fetch") {
        if p.acceptKw("for") {
            if p.tsql && p.acceptKw("json") { try p.forJsonClause(s) }
            else { try p.lockClause(s) }
        } else if p.isKw("limit") || p.isKw("fetch") {
            if limited { return Err(lexdb_base.err("42601", "multiple LIMIT clauses not allowed")) }
            limited = true
            if p.acceptKw("limit") {
                if p.acceptKw("all") { s.limit = None } else { s.limit = Some(try p.expr()) }
            } else {
                // FETCH FIRST | NEXT [n] ROW | ROWS ONLY | WITH TIES (9.94): n a
                // constant, a parameter or in parentheses; 1 when not given
                p.pos += 1
                if !p.acceptKw("first") { try p.expectKw("next") }
                s.limit = Some(Expr.Lit(Val.Int(1)))
                if !p.isKw("row") && !p.isKw("rows") { s.limit = Some(try p.unary()) }
                if !p.acceptKw("rows") { try p.expectKw("row") }
                if p.acceptKw("with") {
                    try p.expectKw("ties")
                    s.withTies = true
                } else {
                    try p.expectKw("only")
                }
            }
        } else {
            if offset { return Err(lexdb_base.err("42601", "multiple OFFSET clauses not allowed")) }
            offset = true
            let o = p.acceptKw("offset")
            s.offset = Some(try p.expr())
            let r = p.acceptKw("rows") || p.acceptKw("row")
        }
    }
    if s.withTies {
        if len(s.order) == 0 { return Err(lexdb_base.err("42601", "WITH TIES cannot be specified without ORDER BY clause")) }
        if s.lockWait == WAIT_SKIP { return Err(lexdb_base.err("42601", "SKIP LOCKED and WITH TIES options cannot be used together")) }
    }
    return Ok(Unit{})
}

// FROM's list (after FROM; UPDATE's FROM and DELETE's USING, 9.91): its
// first item joined as join, the rest by commas and JOINs. A JOIN binds
// tighter than a comma: from the first comma on, fromTrees reads the list
// (one join tree read alone, treeList's, stops at the comma: J_TREE).
fn (p: mut &P) fromList(from: mut &[]FromItem, join: int): Result[Unit, lexdb_base.DbErr] {
    var first = try p.fromItem(join)
    first.comma = true
    append(from, first)
    while true {
        if p.isKw(",") {
            if join == J_TREE { break }
            return p.fromTrees(from, &"")
        } else if (p.tsql || p.ora) && (p.isKw("cross") || p.isKw("outer")) && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "apply" {
            // T-SQL and Oracle 12c: CROSS APPLY x, OUTER APPLY x: a LATERAL join (inner, left)
            let outer = p.acceptKw("outer")
            if !outer { let c = p.acceptKw("cross") }
            p.pos += 1
            var f = try p.fromItem(if outer { J_LEFT } else { J_CROSS })
            f.lateral = true
            if outer { f.on = Some(Expr.Lit(Val.Bool(true))) }
            append(from, f)
        } else if p.acceptKw("cross") {
            try p.expectKw("join")
            append(from, try p.fromItem(J_CROSS))
        } else if p.isKw("join") || p.isKw("inner") || p.isKw("left") || p.isKw("right") || p.isKw("full") || p.isKw("natural") {
            let natural = p.acceptKw("natural")
            var kind = J_INNER
            if p.acceptKw("left") {
                let o = p.acceptKw("outer")
                kind = J_LEFT
            } else if p.acceptKw("right") {
                let o = p.acceptKw("outer")
                kind = J_RIGHT
            } else if p.acceptKw("full") {
                let o = p.acceptKw("outer")
                kind = J_FULL
            } else {
                let i = p.acceptKw("inner")
            }
            try p.expectKw("join")
            var f = try p.fromItem(kind)
            if natural {
                f.natural = true
            } else if p.acceptKw("using") {
                // USING (a, ...) (9.93)
                try p.expectKw("(")
                append(mut &f.using, try p.name())
                while p.acceptKw(",") { append(mut &f.using, try p.name()) }
                try p.expectKw(")")
                if p.isKw("as") { return Err(lexdb_base.err("0A000", "lexdb: an alias for JOIN ... USING is not supported")) }
            } else {
                try p.expectKw("on")
                f.on = Some(try p.expr())
            }
            append(from, f)
        } else {
            break
        }
    }
    return Ok(Unit{})
}

// FROM's list from a comma on (fromList's), or the whole of an UPDATE's
// FROM or a DELETE's USING (from empty: its first tree joins the target).
// The levels join left-deep, each to all the tables before it: each join
// tree after a comma (or that first one) with a RIGHT or FULL JOIN is read
// again as a subquery of its own (nestTree). target: a T-SQL UPDATE's or
// DELETE's table, else "".
fn (p: mut &P) fromTrees(from: mut &[]FromItem, target: &str): Result[Unit, lexdb_base.DbErr] {
    var nested = false
    var whole = len(from) == 0
    while whole || p.acceptKw(",") {
        whole = false
        let g = len(from)
        let at = p.pos
        let atSubs = len(p.subs)
        try p.treeList(from, J_CROSS)
        nested = (try p.nestTree(from, g, at, atSubs, target)) || nested
    }
    if nested { try p.treeAliases(from) }
    return Ok(Unit{})
}

// An UPDATE's FROM or a DELETE's USING list (fromTrees; T-SQL's target named).
fn (p: mut &P) dmlFrom(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    let target = if p.tsql { s.table.clone() } else { "" }
    return p.fromTrees(mut &s.from, &target)
}

// One join tree (fromList's, up to a comma), its first item joined as join.
fn (p: mut &P) treeList(from: mut &[]FromItem, join: int): Result[Unit, lexdb_base.DbErr] {
    let g = len(from)
    try p.fromList(from, J_TREE)
    from[g].join = join
    return Ok(Unit{})
}

// fromList's join for one join tree read alone (treeList's; its first item's join until treeList sets it).
const J_TREE = 99

// The names of a FROM list with join trees read as subqueries (nestTree's): FROM's still, each once (42712).
fn (p: &P) treeAliases(from: &[]FromItem): Result[Unit, lexdb_base.DbErr] {
    var names: []str = []
    for f in from {
        let inner = f.sub >= 0 && isTreeSub(&p.subs[f.sub])
        let n = if inner { len(p.subs[f.sub].from) } else { 1 }
        for k in 0..n {
            let a = if inner { p.subs[f.sub].from[k].alias.clone() } else { f.alias.clone() }
            if lexdb_base.hasStr(&names, &a) { return Err(lexdb_base.err("42712", &("table name \"" + a + "\" specified more than once"))) }
            append(mut &names, a)
        }
    }
    return Ok(Unit{})
}

// The join tree from[g..] (read from token at to here, after atSubs of
// the subqueries), if it has a RIGHT or FULL JOIN: read again as a
// subquery of its own, a SELECT of its every column under its own name
// (TREE_STAR), and a LATERAL item in its place (its items may see the
// tables before it, as a LATERAL one's; true: so read). A T-SQL UPDATE
// or DELETE keeps a tree with its target (tsqlDml takes the target out of
// FROM).
fn (p: mut &P) nestTree(from: mut &[]FromItem, g: int, at: int, atSubs: int, target: &str): Result[bool, lexdb_base.DbErr] {
    var keeps = false
    for k in g + 1..len(from) { if from[k].join == J_RIGHT || from[k].join == J_FULL { keeps = true } }
    if !keeps { return Ok(false) }
    if len(target) > 0 {
        for k in g..len(from) { if from[k].sub < 0 && (from[k].alias == target || from[k].table == target) { return Ok(false) } }
    }
    let end = p.pos
    let join = from[g].join
    var name = ""
    for k in g..len(from) { name = name + (if k > g { " " } else { "" }) + from[k].alias }
    while len(from) > g { let x = pop(from) }
    // (what reading it noted stays: the sequences named, a recursive CTE's references)
    let seqs = len(p.seqs)
    var refs: []int = []
    for c in p.inCte { append(mut &refs, c.refs) }
    p.pos = at
    while len(p.subs) > atSubs { let x = pop(mut &p.subs) }
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var d = lexdb_sql.newStmt(S_SELECT)
    try p.treeList(mut &d.from, J_FIRST)
    d.subs = replace(mut &p.subs, saved)
    d.wins = replace(mut &p.wins, savedW)
    d.use = SUB_FROM
    if p.pos != end { return Err(near(&p.peek())) }
    while len(p.seqs) > seqs { let x = pop(mut &p.seqs) }
    for k in 0..len(refs) { p.inCte[k].refs = refs[k] }
    append(mut &d.items, SelItem{star: true, qual: lexdb_sql.TREE_STAR, expr: None, alias: "", spell: ""})
    append(mut &p.subs, d)
    append(from, FromItem{table: "", alias: "(" + name + ")", join: join, on: None, sub: len(p.subs) - 1, cols: [], work: -1, lateral: true, using: [],
                          natural: false, comma: true})
    return Ok(true)
}

// A join tree read as a subquery of its own (nestTree's).
pub fn isTreeSub(s: &Stmt): bool { return len(s.items) == 1 && s.items[0].star && s.items[0].qual == lexdb_sql.TREE_STAR }

// A join tree in parentheses, after its "(" (FROM (a JOIN b ON ...), FROM ((SELECT 1) d CROSS JOIN t), nested trees, in
// every door: PostgreSQL's, SQL Server's and Oracle's): read as a subquery of its own, as nestTree reads one, its
// columns under their own names (TREE_STAR: a.x, b.y as before); with an alias (PostgreSQL's (a JOIN b ...) AS j
// [(columns)]) a subquery of its every column under that alias, the names inside hidden.
fn (p: mut &P) parenTree(join: int): Result[FromItem, lexdb_base.DbErr] {
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var d = lexdb_sql.newStmt(S_SELECT)
    let read = p.treeList(mut &d.from, J_FIRST)
    d.subs = replace(mut &p.subs, saved)
    d.wins = replace(mut &p.wins, savedW)
    let ok = try read
    d.use = SUB_FROM
    try p.expectKw(")")
    var name = ""
    for k in 0..len(d.from) { name = name + (if k > 0 { " " } else { "" }) + d.from[k].alias }
    var alias = ""
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols, false)
    let tree = len(alias) == 0
    append(mut &d.items, SelItem{star: true, qual: if tree { lexdb_sql.TREE_STAR } else { "" }, expr: None, alias: "", spell: ""})
    append(mut &p.subs, d)
    return Ok(FromItem{table: "", alias: if tree { "(" + name + ")" } else { alias }, join: join, on: None, sub: len(p.subs) - 1, cols: cols, work: -1,
                       lateral: false, using: [], natural: false, comma: false})
}

// The functions that may be a FROM item.
pub fn isFromFn(n: &str): bool {
    if len(n) > 4 && n[0] == 'j' && n[1] == 's' { return isJsonFromFn(n) }
    return n == "generate_series" || n == "unnest" || n == "pg_partition_ancestors" || n == "pg_available_extensions" || n == "regexp_matches" ||
           n == "regexp_split_to_table" || n == "string_to_table"
}

// The JSON functions that may be a FROM item (isFromFn: a name that starts js).
fn isJsonFromFn(n: &str): bool {
    return n == "json_each" || n == "jsonb_each" || n == "json_each_text" || n == "jsonb_each_text" ||
           n == "json_array_elements" || n == "jsonb_array_elements" || n == "json_array_elements_text" || n == "jsonb_array_elements_text" ||
           n == "json_object_keys" || n == "jsonb_object_keys" || n == "jsonb_path_query"
}

fn (p: mut &P) fromItem(join: int): Result[FromItem, lexdb_base.DbErr] {
    var f = try p.fromItem0(join)
    if p.isKw("match_recognize") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" { f = try p.matchRecognize(f) }
    return Ok(f)
}

fn (p: mut &P) fromItem0(join: int): Result[FromItem, lexdb_base.DbErr] {
    let lateral = p.acceptKw("lateral")
    if p.peek().kind == T_IDENT && p.peek().text == "pg_catalog" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." &&
       p.peekAt(3).kind == T_OP && p.peekAt(3).text == "(" {
        p.pos += 2
    }
    if p.peek().kind == T_IDENT && p.peek().text == "json_table" &&
       p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_OP && p.toks[p.pos + 1].text == "(" {
        return p.jsonTableFrom(join)
    }
    if p.tsql && p.peek().kind == T_IDENT && p.peek().text == "openjson" &&
       p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_OP && p.toks[p.pos + 1].text == "(" {
        return p.openJsonFrom(join)
    }
    if p.peek().kind == T_IDENT && isFromFn(&p.peek().text) &&
       p.pos + 1 < len(p.toks) && p.toks[p.pos + 1].kind == T_OP && p.toks[p.pos + 1].text == "(" {
        return p.fromFunction(join)
    }
    // T-SQL: [schema.]f(arguments), a table-valued function of the user's (an inline one is read as its query: lexdb_routine)
    if p.tsql && (p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT) {
        let k = if p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." && (p.peekAt(2).kind == T_IDENT || p.peekAt(2).kind == T_QIDENT) { 2 } else { 0 }
        let h = p.peekAt(k + 2)
        let hint = h.kind == T_IDENT && (h.text == "nolock" || h.text == "readuncommitted" || h.text == "holdlock" || h.text == "updlock" ||
                                         h.text == "rowlock" || h.text == "tablock" || h.text == "readcommitted" || h.text == "serializable" || h.text == "index")
        if p.peekAt(k + 1).kind == T_OP && p.peekAt(k + 1).text == "(" && !hint && !(p.peek().kind == T_IDENT && (lexdb_sql.isReserved(&p.peek().text) || (k == 0 && p.peek().text == "graph_table"))) {
            return p.udfFrom(join)
        }
    }
    // (PostgreSQL's LATERAL f(...) is a function of the user's, found after its name: below)
    if lateral && !p.isKw("(") && !(!p.tsql && !p.ora && p.peekAt(1).kind == T_OP) { return Err(lexdb_base.err("0A000", "LATERAL is supported before a subquery or a function only")) }
    if p.isKw("(") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "values" {
        // (VALUES (...), ...) [AS] alias [(columns)] (9.80)
        p.pos += 2
        let vi = try p.valuesSub()
        try p.expectKw(")")
        var valias = "*VALUES*"
        var vcols: []str = []
        try p.aliasOf(mut &valias, mut &vcols, true)
        var vspells = spellsOff(mut &vcols)
        if p.ora && valias == "*VALUES*" { return Err(oraErr(931, "missing identifier")) }
        if p.ora && len(vcols) == 0 { return Err(oraErr(63814, "Column names must be specified in the alias for Table Value Constructor.")) }
        if !p.tsql && !p.ora { vspells = [] }
        p.subs[vi].spells = vspells         // (the names as written: lexdb_exec's FROM binding)
        return Ok(FromItem{table: "", alias: valias, join: join, on: None, sub: vi, cols: vcols, work: -1, lateral: false, using: [], natural: false, comma: false})
    }
    if p.acceptKw("(") {
        // a subquery in FROM
        if !p.isKw("select") && !p.isKw("with") && !p.parenQuery() { return p.parenTree(join) }
        let i = try p.subquery(SUB_FROM)
        // (Oracle computes a derived table's aggregate nothing reads: lexdb_bind.prunedSubs)
        if p.ora { p.subs[i].mdialect = MD_ORA }
        var alias = "unnamed_subquery"
        var cols: []str = []
        try p.aliasOf(mut &alias, mut &cols, true)
        let spells = spellsOff(mut &cols)
        if p.tsql || p.ora { p.subs[i].spells = spells }
        return Ok(FromItem{table: "", alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: lateral, using: [], natural: false, comma: false})
    }
    let at0 = p.pos
    let table = try p.rname()
    // PostgreSQL, SQL Server & Oracle: GRAPH_TABLE (...) (SQL/PGQ, O22), or PostgreSQL set-returning SQL function [schema.]f(...)
    if p.toks[p.pos].kind == T_OP && p.isKw("(") {
        if table == "graph_table" { return p.graphTable(join) }
        if !p.tsql && !p.ora {
            p.pos = at0
            return p.pgFunctionFrom(join)
        }
    }
    var alias = lexdb_sql.baseName(&table)
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols, false)
    try p.tableHints()
    if p.ora && lexdb_sql.baseName(&table) == "dual" && !p.cteNamed(&"dual") {
        // Oracle's DUAL: one row, one column DUMMY = 'X'
        var d = lexdb_sql.newStmt(S_SELECT)
        d.srf = "#values:01"           // (a marker of its own, for the label DUMMY: still a one column VALUES)
        d.use = SUB_FROM
        append(mut &d.items, SelItem{star: false, qual: "", expr: Some(Expr.Lit(Val.Text("X"))), alias: "dummy", spell: "DUMMY"})
        append(mut &p.subs, d)
        if len(cols) == 0 { cols = ["dummy"] }
        return Ok(FromItem{table: "", alias: alias, join: join, on: None, sub: len(p.subs) - 1, cols: cols, work: -1, lateral: false, using: [], natural: false, comma: false})
    }
    // a CTE in scope (the innermost of the name) before a table; a
    // qualified name is always a table
    var ci = -1
    for i in 0..len(p.ctes) { if p.ctes[i].name == table { ci = i } }
    var rel = if ci >= 0 { "" } else { lexdb_dialect.pgRelOf(&(if lexdb_sql.isQual(&table) { lexdb_sql.schemaOf(&table) } else { "" }), &lexdb_sql.baseName(&table)) }
    // T-SQL: SQL Server's catalog views, sys.x (design/lexdb-tds.md, section 13)
    if p.tsql && ci < 0 && len(rel) == 0 && lexdb_sql.isQual(&table) { rel = lexdb_dialect.tsqlRelOf(&lexdb_sql.schemaOf(&table), &lexdb_sql.baseName(&table)) }
    // Oracle: its catalog views, ALL_TABLES, V$VERSION, ... (design/lexdb-oracle.md, O4)
    if p.ora && ci < 0 && len(rel) == 0 { rel = lexdb_dialect.oraRelOf(&(if lexdb_sql.isQual(&table) { lexdb_sql.schemaOf(&table) } else { "" }), &lexdb_sql.baseName(&table)) }
    if len(rel) > 0 {
        // a pg_catalog or information_schema relation (9.80): a function
        // in FROM whose rows the executor makes from its catalog
        var s = lexdb_sql.newStmt(S_SELECT)
        s.srf = "#" + rel
        // (the T-SQL door's INFORMATION_SCHEMA: SQL Server's rows, lexdb_sql.TSQL_IS)
        if p.tsql && strings.startsWith(&rel, "information_schema.") { s.srf += lexdb_sql.TSQL_IS }
        s.use = SUB_FROM
        append(mut &p.subs, s)
        append(mut &p.seqs, CAT_MARK)
        return Ok(FromItem{table: rel, alias: alias, join: join, on: None, sub: len(p.subs) - 1, cols: cols, work: -1, lateral: false, using: [], natural: false, comma: false})
    }
    if ci >= 0 {
        let given = len(cols) > 0
        if !given { for c in p.ctes[ci].cols { append(mut &cols, c.clone()) } }
        // in its own body: its working table
        for k in 0..len(p.inCte) {
            if p.inCte[k].id == p.ctes[ci].id {
                if p.inCte[k].depth != p.depth && (p.inCte[k].sub > 0 || p.ora) { return Err(lexdb_recur.inSubquery(&table, p.md())) }
                p.inCte[k].refs += 1
                return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: -1, cols: cols, work: p.ctes[ci].id, lateral: false, using: [], natural: false, comma: false})
            }
        }
        // (with the columns its SEARCH and CYCLE add)
        if !given && len(p.ctes[ci].spec) > 0 { cols = cteCols(&p.ctes[ci]) }
        // (T-SQL's and Oracle's recursive CTE names its columns itself, as written: lexdb_recrun.outsOf)
        if !given && p.ctes[ci].rec && (p.tsql || p.ora) { cols = [] }
        let i = try p.cteRef(ci)
        // a CTE's column list names its columns as written (T-SQL, Oracle: lexdb_exec's FROM binding)
        if !given && !p.ctes[ci].rec && (p.tsql || p.ora) && len(cols) > 0 {
            var sp: []str = []
            for c in p.ctes[ci].spells { append(mut &sp, c.clone()) }
            p.subs[i].spells = sp
        }
        return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: false, using: [], natural: false, comma: false})
    }
    return Ok(FromItem{table: table, alias: alias, join: join, on: None, sub: -1, cols: cols, work: -1, lateral: false, using: [], natural: false, comma: false})
}

// [AS] alias [(column, ...)]
// A function in FROM (9.27): generate_series(start, stop [, step]) or
// unnest(array, ...), [WITH ORDINALITY], [AS alias [(columns)]]. It is a
// subquery (SUB_FROM) whose items are the arguments and whose srf names the
// function; it may use the FROM items before it (LATERAL, as in
// PostgreSQL).
fn (p: mut &P) fromFunction(join: int): Result[FromItem, lexdb_base.DbErr] {
    let name = p.next().text
    try p.expectKw("(")
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var s = lexdb_sql.newStmt(S_SELECT)
    s.srf = name.clone()
    s.use = SUB_FROM
    if !p.isKw(")") {
        while true {
            append(mut &s.items, SelItem{star: false, qual: "", expr: Some(try p.expr()), alias: "", spell: ""})
            if !p.acceptKw(",") { break }
        }
    }
    try p.expectKw(")")
    // SQL Server 2025's REGEXP_MATCHES and REGEXP_SPLIT_TO_TABLE: their own columns (lexdb_srf), SQL Server's flags
    if p.tsql && (name == "regexp_matches" || name == "regexp_split_to_table") && (len(s.items) == 2 || len(s.items) == 3) {
        s.srf = "tsql_" + name
        if len(s.items) == 2 { append(mut &s.items, SelItem{star: false, qual: "", expr: Some(Expr.Lit(Val.Text(""))), alias: "", spell: ""}) }
        match replace(mut &s.items[2].expr, None) {
            Some(f) { s.items[2].expr = Some(tsReFlags(f)) }
            None {}
        }
    }
    s.subs = replace(mut &p.subs, saved)
    s.wins = replace(mut &p.wins, savedW)
    p.depth -= 1
    if p.acceptKw("with") {
        try p.expectKw("ordinality")
        s.ordin = true
    }
    append(mut &p.subs, s)
    let i = len(p.subs) - 1
    var alias = name.clone()
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols, false)
    // SQL Server 2022's GENERATE_SERIES: its column is value; without a step, 1 up to the stop or -1 down to it
    if p.tsql && name == "generate_series" && len(cols) == 0 { append(mut &cols, "value") }
    if p.tsql && name == "generate_series" && len(p.subs[i].items) == 2 {
        match p.subs[i].items[0].expr {
            Some(a) {
                match p.subs[i].items[1].expr {
                    Some(b) {
                        let up = Expr.Bin("<=", cloneE(&a), cloneE(&b))
                        append(mut &p.subs[i].items, SelItem{star: false, qual: "", expr: Some(Expr.Call("case else", [up, Expr.Lit(Val.Int(1)), Expr.Lit(Val.Int(-1))], false)), alias: "", spell: ""})
                    }
                    None {}
                }
            }
            None {}
        }
    }
    // one column, an alias and no column names: the column is the alias
    let isEach = name == "json_each" || name == "jsonb_each" || name == "json_each_text" || name == "jsonb_each_text"
    let single = !strings.startsWith(&p.subs[i].srf, "tsql_") && !isEach &&
                 (name == "generate_series" || name == "regexp_matches" || name == "regexp_split_to_table" || name == "string_to_table" ||
                  name == "json_array_elements" || name == "jsonb_array_elements" || name == "json_array_elements_text" || name == "jsonb_array_elements_text" ||
                  name == "json_object_keys" || name == "jsonb_object_keys" || name == "jsonb_path_query" ||
                  len(p.subs[i].items) == 1)
    if single && !p.subs[i].ordin && alias != name && len(cols) == 0 { append(mut &cols, alias.clone()) }
    return Ok(FromItem{table: name, alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: true, using: [], natural: false, comma: false})
}

// Oracle's old outer join marker after a qualified column: a.b(+).
fn (p: &P) oraOuterMark(): bool {
    return p.ora && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "+" && p.peekAt(2).kind == T_OP && p.peekAt(2).text == ")"
}

// PostgreSQL: a function of the user's in FROM, [schema.]f(arguments) [[AS] alias [(columns)]]: a subquery (SUB_FROM) whose items are
// the arguments (a name in the item's alias for name => value) and whose srf is "#pgf:" and the function's key; it may use the FROM
// items before it (LATERAL, as in PostgreSQL). lexdb_routine writes it as the function's query; the statement is marked (udf).
fn (p: mut &P) pgFunctionFrom(join: int): Result[FromItem, lexdb_base.DbErr] {
    let key = try p.rname()
    let spell = p.spelled.clone()
    try p.expectKw("(")
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var s = lexdb_sql.newStmt(S_SELECT)
    s.srf = "#pgf:" + key
    s.spell = spell.clone()
    s.use = SUB_FROM
    if !p.isKw(")") {
        while true {
            var nm = ""
            if (p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT) && p.peekAt(1).kind == T_OP && p.peekAt(2).kind == T_OP &&
               ((p.peekAt(1).text == "=" && p.peekAt(2).text == ">") || (p.peekAt(1).text == ":" && p.peekAt(2).text == "=")) {
                nm = p.peek().text.clone()
                p.pos += 3
            }
            append(mut &s.items, SelItem{star: false, qual: "", expr: Some(try p.expr()), alias: nm, spell: ""})
            if !p.acceptKw(",") { break }
        }
    }
    try p.expectKw(")")
    s.subs = replace(mut &p.subs, saved)
    s.wins = replace(mut &p.wins, savedW)
    p.depth -= 1
    if p.acceptKw("with") {
        try p.expectKw("ordinality")
        s.ordin = true
    }
    append(mut &p.subs, s)
    let i = len(p.subs) - 1
    var alias = lexdb_sql.baseName(&key)
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols, false)
    p.udf = true
    return Ok(FromItem{table: key, alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: true, using: [], natural: false, comma: false})
}

// T-SQL: a function of the user's in FROM, [schema.]f(arguments) [[AS] alias]: a subquery (SUB_FROM) whose items are the
// arguments and whose srf is "#udf:" and the function's key; it may use the FROM items before it (as APPLY does). Where
// it is not an inline table-valued function, lexdb_routine says so (208 for none of the name).
fn (p: mut &P) udfFrom(join: int): Result[FromItem, lexdb_base.DbErr] {
    let key = try p.rname()
    let spell = p.spelled.clone()
    try p.expectKw("(")
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var s = lexdb_sql.newStmt(S_SELECT)
    s.srf = "#udf:" + key
    s.spell = spell.clone()
    s.use = SUB_FROM
    if !p.isKw(")") {
        while true {
            append(mut &s.items, SelItem{star: false, qual: "", expr: Some(try p.callArg(true)), alias: "", spell: ""})
            if !p.acceptKw(",") { break }
        }
    }
    try p.expectKw(")")
    s.subs = replace(mut &p.subs, saved)
    s.wins = replace(mut &p.wins, savedW)
    p.depth -= 1
    append(mut &p.subs, s)
    let i = len(p.subs) - 1
    var alias = lexdb_sql.baseName(&key)
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols, false)
    p.udf = true
    if len(cols) > 0 { return Err(lexdb_base.err("TS317", &("Table-valued function '" + lexdb_sql.baseName(&key) + "' cannot have a column alias."))) }
    return Ok(FromItem{table: key, alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: true, using: [], natural: false, comma: false})
}

// T-SQL's table hints, WITH (NOLOCK, ...) or (NOLOCK): read, not used
// (lexdb's reads are snapshots; its writes lock rows).
fn (p: mut &P) tableHints(): Result[Unit, lexdb_base.DbErr] {
    if !p.tsql { return Ok(Unit{}) }
    // (not WITH (batch_rows n), lexdb's own at the end of an UPDATE or DELETE: batchOpt)
    let w = p.isKw("with") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" && !(p.peekAt(2).kind == T_IDENT && p.peekAt(2).text == "batch_rows")
    let bare = p.isKw("(") && p.peekAt(1).kind == T_IDENT && (p.peekAt(1).text == "nolock" || p.peekAt(1).text == "readuncommitted" ||
               p.peekAt(1).text == "holdlock" || p.peekAt(1).text == "updlock" || p.peekAt(1).text == "rowlock" || p.peekAt(1).text == "tablock")
    if !w && !bare { return Ok(Unit{}) }
    if w { p.pos += 1 }
    try p.expectKw("(")
    var depth = 1
    while depth > 0 {
        let t = p.next()
        if t.kind == T_EOF { return Err(near(&t)) }
        if t.kind == T_OP && t.text == "(" { depth += 1 }
        if t.kind == T_OP && t.text == ")" { depth -= 1 }
    }
    return Ok(Unit{})
}

// spelled: after a column list, SPELL_MARK and its names' spellings (p.spelled's: the T-SQL and Oracle doors' names as
// written), for the caller to take off (spellsOff).
fn (p: mut &P) aliasOf(alias: mut &str, cols: mut &[]str, spelled: bool): Result[Unit, lexdb_base.DbErr] {
    var got = false
    if p.acceptKw("as") {
        let old = replace(alias, try p.name())
        if p.tsql { try p.notTsqlReserved(p.pos - 1) }
        got = true
    } else {
        let t = p.peek().clone()
        // (T-SQL: OUTPUT and OPTION after a table are clauses)
        let tw = (p.tsql && t.kind == T_IDENT && (t.text == "output" || t.text == "option" || tsqlStarts(&t.text))) ||
                 (t.kind == T_IDENT && t.text == "match_recognize" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(")
        // (FETCH FIRST ... after a table: a clause, as OFFSET)
        let fetch = t.kind == T_IDENT && t.text == "fetch" && p.peekAt(1).kind == T_IDENT && (p.peekAt(1).text == "first" || p.peekAt(1).text == "next")
        if !tw && !fetch && !p.waitAhead() && (t.kind == T_QIDENT || (t.kind == T_IDENT && !lexdb_sql.isReserved(&t.text) && !(p.tsql && lexdb_sql.tsqlReserved(&t.text)))) {
            // (Oracle: START WITH and CONNECT BY after a table are a hierarchical query's clauses)
            if !(p.ora && t.kind == T_IDENT && ((p.peekAt(1).kind == T_IDENT && ((t.text == "start" && p.peekAt(1).text == "with") ||
                                                                               (t.text == "connect" && p.peekAt(1).text == "by"))) ||
                                                (t.text == "qualify" && p.qualifyClause()))) {
                let old = replace(alias, t.text.clone())
                p.pos += 1
                got = true
            }
        }
    }
    if got && p.acceptKw("(") {
        var spells: []str = []
        append(cols, try p.name())
        append(mut &spells, p.spelled.clone())
        while p.acceptKw(",") {
            append(cols, try p.name())
            append(mut &spells, p.spelled.clone())
        }
        try p.expectKw(")")
        if spelled {
            append(cols, SPELL_MARK.toStr())
            for x in spells { append(cols, x) }
        }
    }
    return Ok(Unit{})
}

// A column list read with its spellings (aliasOf's spelled): the spellings, taken off the list.
fn spellsOff(cols: mut &[]str): []str {
    var at = -1
    for i in 0..len(cols) { if cols[i] == SPELL_MARK { at = i } }
    if at < 0 { return [] }
    var sp: []str = []
    while len(cols) > at + 1 { append(mut &sp, pop(cols)) }
    let m = pop(cols)
    var out: []str = []
    var k = len(sp) - 1
    while k >= 0 {
        append(mut &out, sp[k].clone())
        k -= 1
    }
    return out
}

// ---- MATCH_RECOGNIZE (design/lexdb-match-recognize.md 5): after a FROM item, in all three doors.

// An error of the clause: Oracle's number and text, PostgreSQL's SQLSTATE, T-SQL's number (0: as
// PostgreSQL's maps).
fn (p: &P) mrErr(ora: int, oraText: &str, pg: &str, ts: int, msg: &str): lexdb_base.DbErr {
    if p.ora { return oraErr(ora, oraText) }
    if p.tsql && ts > 0 { return lexdb_base.err(&("TS" + ts.toStr()), msg) }
    return lexdb_base.err(pg, msg)
}

// A token that fits nowhere: Oracle's number and text, else a syntax error.
fn (p: &P) mrNear(ora: int, oraText: &str): lexdb_base.DbErr {
    if p.ora { return oraErr(ora, oraText) }
    return near(&p.peek())
}

// Oracle's ORA-02000 for the keyword the clause lacks (PATTERN, DEFINE), else a syntax error.
fn (p: &P) mrMissing(w: &str): lexdb_base.DbErr {
    if p.ora { return oraKeyword(w) }
    return near(&p.peek())
}

// f MATCH_RECOGNIZE ( ... ) [[AS] alias [(columns)]], at MATCH_RECOGNIZE: a subquery in FROM.
fn (p: mut &P) matchRecognize(f0: FromItem): Result[FromItem, lexdb_base.DbErr] {
    var f = f0
    if f.work >= 0 { return Err(lexdb_base.err("0A000", "lexdb: MATCH_RECOGNIZE over a recursive CTE is not supported")) }
    p.pos += 2
    var saved: []Stmt = []
    if f.sub >= 0 {
        if f.sub != len(p.subs) - 1 { return Err(lexdb_base.err("XX000", "lexdb: MATCH_RECOGNIZE: its input is not the last subquery")) }
        let it = pop(mut &p.subs)
        saved = replace(mut &p.subs, [it])
        f.sub = 0
    } else {
        saved = replace(mut &p.subs, [])
    }
    let savedW = replace(mut &p.wins, [])
    p.depth += 1
    p.mr += 1
    let m = try p.mrClause()
    p.mr -= 1
    p.depth -= 1
    p.wins = savedW
    try p.expectKw(")")
    var w = lexdb_sql.newStmt(S_SELECT)
    w.use = SUB_FROM
    append(mut &w.items, SelItem{star: true, qual: "", expr: None, alias: "", spell: ""})
    let outerJoin = f.join
    let outerLateral = f.lateral
    f.join = J_FIRST
    f.comma = true
    f.on = None
    f.lateral = false
    append(mut &w.from, f)
    w.subs = replace(mut &p.subs, saved)
    append(mut &w.mr, m)
    append(mut &p.subs, w)
    var alias = "unnamed_subquery"
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols, false)
    p.subs[len(p.subs) - 1].mr[0].alias = alias.clone()
    return Ok(FromItem{table: "", alias: alias, join: outerJoin, on: None, sub: len(p.subs) - 1, cols: cols, work: -1, lateral: outerLateral,
                       using: [], natural: false, comma: false})
}

fn mrVarIndex(vars: &[]str, n: &str): int {
    for i in 0..len(vars) { if vars[i] == n { return i } }
    return -1
}

fn mrSubsetIndex(subs: &[]MrSubset, n: &str): int {
    for i in 0..len(subs) { if subs[i].name == n { return i } }
    return -1
}

// A column list of PARTITION BY: simple names.
fn (p: mut &P) mrNames(out: mut &[]str): Result[Unit, lexdb_base.DbErr] {
    while true {
        append(out, try p.name())
        if p.isKw(".") {
            if p.ora { return Err(oraErr(1748, "only simple column names allowed here")) }
            return Err(near(&p.peek()))
        }
        if !p.acceptKw(",") { break }
    }
    return Ok(Unit{})
}

fn (p: mut &P) mrClause(): Result[MatchRec, lexdb_base.DbErr] {
    var m = MatchRec{part: [], order: [], measures: [], rows: MR_ONE, skip: SKIP_PAST, skipTo: "", pattern: lexdb_match.PNode.Begin, vars: [],
                     shown: [], subsets: [], defines: [], dialect: if p.tsql { MD_TSQL } else if p.ora { MD_ORA } else { MD_PG }, exclusion: false, alias: ""}
    if p.isKw("partition") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "by" {
        p.pos += 2
        try p.mrNames(mut &m.part)
    }
    if p.isKw("order") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "by" {
        p.pos += 2
        while true {
            var x = Expr.Lit(Val.Null)
            if p.ora {
                x = Expr.Col(try p.name(), -1)
                if p.isKw(".") { return Err(oraErr(1748, "only simple column names allowed here")) }
            } else {
                x = try p.expr()
                match x {
                    Expr.Col(cn, _) { if strings.contains(&cn, &".") { return Err(near(&p.peek())) } }
                    else {}
                }
            }
            var desc = false
            if p.acceptKw("desc") { desc = true } else { let a = p.acceptKw("asc") }
            var nf = if p.tsql { !desc } else { desc }
            if p.acceptKw("nulls") {
                if p.acceptKw("first") { nf = true } else {
                    try p.expectKw("last")
                    nf = false
                }
            }
            append(mut &m.order, WinOrder{expr: x, desc: desc, nullsFirst: nf})
            if !p.acceptKw(",") { break }
        }
    }
    if p.acceptKw("measures") {
        while true {
            let e = try p.expr()
            var alias = ""
            var spell = ""
            if p.acceptKw("as") {
                alias = try p.name()
                spell = p.spelled.clone()
            } else {
                let t = p.peek().clone()
                var ok = t.kind == T_QIDENT || (t.kind == T_IDENT && !lexdb_sql.isReserved(&t.text))
                if ok && !p.ora && t.kind == T_IDENT && (t.text == "one" || t.text == "all" || t.text == "after" || t.text == "pattern" ||
                                                           t.text == "subset" || t.text == "define") { ok = false }
                if ok {
                    alias = t.text.clone()
                    spell = t.spell.clone()
                    p.pos += 1
                }
            }
            if len(alias) == 0 { return Err(p.mrErr(62505, "expression needs to be aliased", "42601", 0, "MEASURES expression needs to be aliased")) }
            append(mut &m.measures, SelItem{star: false, qual: "", expr: Some(e), alias: alias, spell: spell})
            if !p.acceptKw(",") { break }
        }
    }
    if p.acceptKw("one") {
        try p.expectKw("row")
        try p.expectKw("per")
        try p.expectKw("match")
    } else if p.acceptKw("all") {
        try p.expectKw("rows")
        try p.expectKw("per")
        try p.expectKw("match")
        m.rows = MR_ALL
        if p.acceptKw("show") {
            try p.expectKw("empty")
            try p.expectKw("matches")
        } else if p.acceptKw("omit") {
            try p.expectKw("empty")
            try p.expectKw("matches")
            m.rows = MR_OMIT
        } else if p.isKw("with") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "unmatched" {
            p.pos += 2
            try p.expectKw("rows")
            m.rows = MR_UNMATCHED
        }
    }
    if p.isKw("after") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "match" {
        p.pos += 2
        try p.expectKw("skip")
        if p.acceptKw("past") {
            try p.expectKw("last")
            try p.expectKw("row")
        } else {
            try p.expectKw("to")
            if p.acceptKw("next") {
                try p.expectKw("row")
                m.skip = SKIP_NEXT
            } else {
                m.skip = SKIP_LAST
                let q = p.peek().clone()
                let nx = p.peekAt(1).clone()
                if q.kind == T_IDENT && (q.text == "first" || q.text == "last") && (nx.kind == T_QIDENT || (nx.kind == T_IDENT && nx.text != "pattern")) {
                    p.pos += 1
                    if q.text == "first" { m.skip = SKIP_FIRST }
                }
                m.skipTo = try p.name()
            }
        }
    }
    if !p.acceptKw("pattern") { return Err(p.mrMissing("PATTERN")) }
    try p.expectKw("(")
    var exc = false
    m.pattern = try p.mrAlt(mut &m, mut &exc, 0)
    m.exclusion = exc
    try p.expectKw(")")
    if p.acceptKw("subset") {
        while true {
            let nm = try p.name()
            let spell = p.spelled.clone()
            try p.expectKw("=")
            try p.expectKw("(")
            var members: []int = []
            while true {
                let v = try p.name()
                let k = mrVarIndex(&m.vars, &v)
                if k < 0 { return Err(p.mrErr(62504, "illegal variable reference", "42P01", 4104, &("SUBSET names a variable that is not in the pattern: \"" + v + "\""))) }
                append(mut &members, k)
                if !p.acceptKw(",") { break }
            }
            try p.expectKw(")")
            if mrVarIndex(&m.vars, &nm) >= 0 || mrSubsetIndex(&m.subsets, &nm) >= 0 {
                return Err(p.mrErr(62503, "illegal variable definition", "42601", 0, &("SUBSET name \"" + nm + "\" is already used")))
            }
            append(mut &m.subsets, MrSubset{name: nm, spell: spell, vars: members})
            if !p.acceptKw(",") { break }
        }
    }
    if !p.acceptKw("define") { return Err(p.mrMissing("DEFINE")) }
    while true {
        let nm = try p.name()
        let k = mrVarIndex(&m.vars, &nm)
        if k < 0 { return Err(p.mrErr(62503, "illegal variable definition", "42601", 0, &("DEFINE names \"" + nm + "\", which is not a pattern variable"))) }
        for d in m.defines {
            if d.v == k { return Err(p.mrErr(62503, "illegal variable definition", "42601", 0, &("DEFINE defines \"" + nm + "\" twice"))) }
        }
        try p.expectKw("as")
        let c = try p.expr()
        append(mut &m.defines, MrDefine{v: k, cond: c})
        if !p.acceptKw(",") { break }
    }
    if len(m.skipTo) > 0 && mrVarIndex(&m.vars, &m.skipTo) < 0 && mrSubsetIndex(&m.subsets, &m.skipTo) < 0 {
        return Err(p.mrErr(62504, "illegal variable reference", "42P01", 4104, &("AFTER MATCH SKIP TO names \"" + m.skipTo + "\", which is not a variable of the pattern")))
    }
    if m.rows == MR_UNMATCHED && m.exclusion {
        return Err(p.mrErr(62515, "Exclusion syntax cannot be used with WITH UNMATCHED ROWS.", "42601", 0, "exclusion syntax cannot be used with WITH UNMATCHED ROWS"))
    }
    return Ok(m)
}

// pattern: seq { | seq }. d: the nesting (a deeper pattern is too large, so the parser's recursion is bounded).
fn (p: mut &P) mrAlt(m: mut &MatchRec, exc: mut &bool, d: int): Result[lexdb_match.PNode, lexdb_base.DbErr] {
    if d > lexdb_match.MR_MAX_DEPTH { return Err(p.mrErr(62518, "MATCH_RECOGNIZE pattern is too large.", "54001", 0, "MATCH_RECOGNIZE pattern is too large")) }
    var alts: []lexdb_match.PNode = []
    while true {
        append(mut &alts, try p.mrSeq(m, exc, d))
        if !p.acceptKw("|") { break }
    }
    if len(alts) == 1 { return Ok(pop(mut &alts)) }
    return Ok(lexdb_match.PNode.Alt(alts))
}

fn (p: mut &P) mrSeq(m: mut &MatchRec, exc: mut &bool, d: int): Result[lexdb_match.PNode, lexdb_base.DbErr] {
    var xs: []lexdb_match.PNode = []
    while true {
        let t = p.peek().clone()
        if t.kind == T_EOF { break }
        if t.kind == T_OP && (t.text == "|" || t.text == ")" || t.text == ",") { break }
        if t.kind == T_OP && t.text == "-" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "}" { break }
        append(mut &xs, try p.mrTerm(m, exc, d))
    }
    if len(xs) == 0 { return Err(p.mrNear(931, "missing identifier")) }
    if len(xs) == 1 { return Ok(pop(mut &xs)) }
    return Ok(lexdb_match.PNode.Seq(xs))
}

fn (p: mut &P) mrBound(): Result[int, lexdb_base.DbErr] {
    let t = p.peek().clone()
    if t.kind != T_NUM { return Err(near(&t)) }
    for i in 0..len(t.text) { if !isDigit(t.text[i]) { return Err(near(&t)) } }
    p.pos += 1
    match strings.parseIntOpt(&t.text) {
        Some(n) {
            if n > lexdb_match.MR_MAX_PROG { return Err(p.mrErr(62518, "MATCH_RECOGNIZE pattern is too large.", "54001", 0, "MATCH_RECOGNIZE pattern is too large")) }
            return Ok(n)
        }
        None { return Err(p.mrErr(62518, "MATCH_RECOGNIZE pattern is too large.", "54001", 0, "MATCH_RECOGNIZE pattern is too large")) }
    }
}

fn (p: mut &P) mrTerm(m: mut &MatchRec, exc: mut &bool, d: int): Result[lexdb_match.PNode, lexdb_base.DbErr] {
    var x = try p.mrPrimary(m, exc, d)
    // a quantifier
    let t = p.peek().clone()
    if t.kind != T_OP { return Ok(x) }
    var mn = 0
    var mx = -1
    if t.text == "*" { p.pos += 1 }
    else if t.text == "+" { p.pos += 1; mn = 1 }
    else if t.text == "?" { p.pos += 1; mx = 1 }
    else if t.text == "{" && !(p.peekAt(1).kind == T_OP && p.peekAt(1).text == "-") {
        p.pos += 1
        mn = 0
        var hasMin = false
        if p.peek().kind == T_NUM {
            mn = try p.mrBound()
            hasMin = true
        }
        if p.acceptKw(",") {
            if p.peek().kind == T_NUM { mx = try p.mrBound() } else { mx = -1 }
        } else {
            if !hasMin { return Err(near(&p.peek())) }
            mx = mn
        }
        try p.expectKw("}")
        if mx == 0 || (mx >= 0 && mx < mn) {
            return Err(p.mrErr(62501, "invalid value specified for bounded quantifier in MATCH_RECOGNIZE clause", "42601", 0, "invalid value specified for bounded quantifier"))
        }
    } else { return Ok(x) }
    var rel = false
    if p.acceptKw("?") { rel = true }
    return Ok(lexdb_match.PNode.Quant(x, mn, mx, rel))
}

fn (p: mut &P) mrPrimary(m: mut &MatchRec, exc: mut &bool, d: int): Result[lexdb_match.PNode, lexdb_base.DbErr] {
    let t = p.peek().clone()
    if t.kind == T_OP {
        if t.text == "(" {
            p.pos += 1
            let x = try p.mrAlt(m, exc, d + 1)
            try p.expectKw(")")
            return Ok(x)
        }
        if t.text == "{" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "-" {
            p.pos += 2
            let x = try p.mrAlt(m, exc, d + 1)
            try p.expectKw("-")
            try p.expectKw("}")
            exc = true
            return Ok(lexdb_match.PNode.Excl(x))
        }
        // (T-SQL's lexer reads ^ as # in its spelling ^: XOR)
        if t.text == "^" || (t.text == "#" && t.spell == "^") { p.pos += 1; return Ok(lexdb_match.PNode.Begin) }
        if t.text == "$" { p.pos += 1; return Ok(lexdb_match.PNode.End) }
        return Err(p.mrNear(931, "missing identifier"))
    }
    if t.kind == T_IDENT && t.text == "permute" && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
        p.pos += 2
        var xs: []lexdb_match.PNode = []
        while true {
            append(mut &xs, try p.mrAlt(m, exc, d + 1))
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
        return Ok(lexdb_match.PNode.Perm(xs))
    }
    if t.kind == T_QIDENT || (t.kind == T_IDENT && !lexdb_sql.isReserved(&t.text)) {
        p.pos += 1
        var k = mrVarIndex(&m.vars, &t.text)
        if k < 0 {
            append(mut &m.vars, t.text.clone())
            append(mut &m.shown, if len(t.spell) > 0 { t.spell.clone() } else { t.text.clone() })
            k = len(m.vars) - 1
        }
        return Ok(lexdb_match.PNode.Var(k))
    }
    return Err(p.mrNear(931, "missing identifier"))
}


fn isSkipMethod(m: &str): bool {
    return m == "minmax" || m == "brin" || m == "set" || m == "bloom_filter" || m == "bloom" ||
           m == "ngrambf" || m == "ngrambf_v1" || m == "tokenbf" || m == "tokenbf_v1"
}

fn (p: mut &P) indexMethodName(): Result[str, lexdb_base.DbErr] {
    if p.peek().kind == T_IDENT {
        let t = p.next()
        return Ok(strings.toLowerAscii(&t.text))
    }
    return Ok(strings.toLowerAscii(&(try p.name())))
}

fn (p: mut &P) skipMethodParams(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    // Optional positional numeric parameters right after method name: USING ngrambf(3, 2048, 3)
    if p.peek().kind == T_OP && p.peek().text == "(" && p.peekAt(1).kind == T_NUM {
        try p.expectKw("(")
        let v0 = try p.intLit()
        append(mut &s.skipParams, v0)
        while p.acceptKw(",") { append(mut &s.skipParams, try p.intLit()) }
        try p.expectKw(")")
    }
    return Ok(Unit{})
}

fn (p: mut &P) skipWithOpts(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if !p.acceptKw("with") { return Ok(Unit{}) }
    try p.expectKw("(")
    var p1 = -1
    var p2 = -1
    var p3 = -1
    while true {
        let k = strings.toLowerAscii(&(try p.name()))
        try p.expectKw("=")
        let v = try p.intLit()
        if k == "max_rows" || k == "bits_per_key" || k == "n" || k == "ngram" || (k == "size" && (s.skipMethod == "tokenbf" || s.skipMethod == "tokenbf_v1")) || (k == "size_bytes" && (s.skipMethod == "tokenbf" || s.skipMethod == "tokenbf_v1")) {
            p1 = v
        } else if k == "size" || k == "size_bytes" || (k == "hashes" && (s.skipMethod == "tokenbf" || s.skipMethod == "tokenbf_v1")) {
            p2 = v
        } else if k == "hashes" {
            p3 = v
        } else {
            return Err(lexdb_base.err("22023", &("unrecognized skipping index option \"" + k + "\"")))
        }
        if !p.acceptKw(",") { break }
    }
    try p.expectKw(")")
    if p1 >= 0 || p2 >= 0 || p3 >= 0 {
        s.skipParams = [p1, p2, p3]
    }
    return Ok(Unit{})
}

fn (p: mut &P) createIndex(unique: bool): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_CREATE_INDEX)
    s.mdialect = if p.tsql { MD_TSQL } else if p.ora { MD_ORA } else { MD_PG }
    s.unique = unique
    s.conc = p.acceptKw("concurrently")
    if p.acceptKw("if") {
        try p.expectKw("not")
        try p.expectKw("exists")
        s.ifFlag = true
    }
    // in its table's schema; none (9.94): PostgreSQL's name is chosen (lexdb_exec)
    if s.ifFlag || !p.isKw("on") { s.index = try p.name() }
    try p.expectKw("on")
    s.table = try p.rname()
    if p.acceptKw("using") {
        let m = try p.indexMethodName()
        if isSkipMethod(&m) {
            if unique { return Err(lexdb_base.err("0A000", "skipping indexes cannot be UNIQUE")) }
            s.skipMethod = m
            try p.skipMethodParams(mut &s)
        } else if m != "btree" {
            return Err(lexdb_base.err("0A000", &("index method \"" + m + "\" is not supported")))
        }
    }
    try p.indexCols(mut &s)
    if len(s.skipMethod) == 0 && p.acceptKw("using") {
        let m = try p.indexMethodName()
        if isSkipMethod(&m) {
            if unique { return Err(lexdb_base.err("0A000", "skipping indexes cannot be UNIQUE")) }
            s.skipMethod = m
            try p.skipMethodParams(mut &s)
        } else if m != "btree" {
            return Err(lexdb_base.err("0A000", &("index method \"" + m + "\" is not supported")))
        }
    }
    if len(s.skipMethod) > 0 && p.isKw("with") {
        try p.skipWithOpts(mut &s)
    }
    return Ok(s)
}

fn (p: mut &P) createSkippingIndex(): Result[Stmt, lexdb_base.DbErr] {
    var s = try p.createIndex(false)
    if len(s.skipMethod) == 0 { s.skipMethod = "minmax" }
    return Ok(s)
}

// T-SQL's index in CREATE TABLE: INDEX name [UNIQUE] [CLUSTERED | NONCLUSTERED] (columns) [INCLUDE ...] [WHERE ...] [WITH ...] [ON
// ...] among the table's elements, INDEX name [UNIQUE] [CLUSTERED | NONCLUSTERED] after a column (col: its name). A CREATE INDEX of
// s.table, kept in s.inner and made with the table (lexdb_exec).
fn (p: mut &P) inlineIndex(s: mut &Stmt, col: &str): Result[Unit, lexdb_base.DbErr] {
    var ci = lexdb_sql.newStmt(S_CREATE_INDEX)
    ci.mdialect = MD_TSQL
    ci.index = try p.name()
    ci.unique = p.acceptKw("unique")
    ci.cluster = p.clusterWord()
    ci.table = s.table.clone()
    // (SQL Server's: a name twice among the table's indexes, two CLUSTERED ones)
    for x in s.inner {
        if x.kind != S_CREATE_INDEX { continue }
        if x.index == ci.index { return Err(lexdb_base.err("TS8168", &("Cannot create, drop, enable, or disable more than one constraint, column, index, or trigger named '" + ci.index + "' in this context. Duplicate names are not allowed."))) }
        if x.cluster == 1 && ci.cluster == 1 { return Err(clusterTwice(&s.table)) }
    }
    if ci.cluster == 1 && s.pkCluster == 1 { return Err(clusterTwice(&s.table)) }
    // (a CLUSTERED one makes a primary key not said to be either NONCLUSTERED, as SQL Server's)
    if ci.cluster == 1 && s.pkCluster == 0 { s.pkCluster = 2 }
    if len(col) > 0 {
        append(mut &ci.names, col.toStr())
        append(mut &ci.exprs, Expr.Lit(Val.Null))
        append(mut &ci.pk, "")
    } else {
        try p.indexCols(mut &ci)
    }
    append(mut &s.inner, ci)
    return Ok(Unit{})
}

// T-SQL: a schema-bound view's FROM items named in two parts (schema.name), SQL Server's 4512 for one that is not (the query's
// text a..b; view: the view's name as written).
fn (p: &P) boundNames(a: int, b: int, view: &str): Result[Unit, lexdb_base.DbErr] {
    var i = 0
    while i < len(p.toks) && p.toks[i].at < a { i += 1 }
    var depth = 0
    var fromDepth = -1
    while i + 1 < len(p.toks) && p.toks[i].at < b {
        let t = &p.toks[i]
        var item = false
        if t.kind == T_OP && t.text == "(" { depth += 1 }
        else if t.kind == T_OP && t.text == ")" {
            depth -= 1
            if depth < fromDepth { fromDepth = -1 }
        } else if t.kind == T_IDENT && (t.text == "from" || t.text == "join") {
            item = true
            fromDepth = depth
        } else if t.kind == T_OP && t.text == "," && depth == fromDepth {
            item = true
        } else if t.kind == T_IDENT && depth == fromDepth && (t.text == "where" || t.text == "group" || t.text == "having" || t.text == "order" ||
                                                             t.text == "union" || t.text == "except" || t.text == "intersect" || t.text == "on") {
            fromDepth = -1
        }
        let n = &p.toks[i + 1]
        if item && (n.kind == T_IDENT || n.kind == T_QIDENT) && !(i + 2 < len(p.toks) && p.toks[i + 2].kind == T_OP && p.toks[i + 2].text == ".") {
            let w = if len(n.spell) > 0 { n.spell.clone() } else { n.text.clone() }
            return Err(lexdb_base.err("TS4512", &("Cannot schema bind view '" + view + "' because name '" + w +
                                                  "' is invalid for schema binding. Names must be in two-part format and an object cannot reference itself.")))
        }
        i += 1
    }
    return Ok(Unit{})
}

fn clusterTwice(t: &str): lexdb_base.DbErr {
    return lexdb_base.err("TS8112", &("Cannot add more than one clustered index for constraints on table '" + lexdb_sql.baseName(t) + "'."))
}

// An index's (columns) and what follows them: INCLUDE, WHERE, Oracle's ANNOTATIONS, T-SQL's storage.
fn (p: mut &P) indexCols(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    try p.expectKw("(")
    try p.indexCol(s)
    while p.acceptKw(",") { try p.indexCol(s) }
    try p.expectKw(")")
    if p.tsql && p.acceptKw("include") {
        // T-SQL's INCLUDE (columns): read, not kept (lexdb's index holds its
        // key; the row is the table's)
        try p.expectKw("(")
        let first = try p.name()
        while p.acceptKw(",") { let more = try p.name() }
        try p.expectKw(")")
    }
    if p.acceptKw("where") { s.where = Some(try p.expr()) }      // a filtered index
    while p.ora && p.acceptKw("annotations") { append(mut &s.alters, try p.annotClause("", true)) }
    try p.tsqlStorage()
    return Ok(Unit{})
}

// PostgreSQL's B-tree operator classes for the types lexdb has.
fn isOpClass(n: &str): bool {
    match n {
        "text_ops", "text_pattern_ops", "varchar_ops", "varchar_pattern_ops", "bpchar_ops", "bpchar_pattern_ops", "name_ops",
        "int2_ops", "int4_ops", "int8_ops", "numeric_ops", "float4_ops", "float8_ops", "bool_ops", "oid_ops", "char_ops",
        "uuid_ops", "bytea_ops", "date_ops", "time_ops", "timestamp_ops", "timestamptz_ops", "interval_ops", "array_ops" { return true }
        else { return false }
    }
}

// An index's column: name [COLLATE c] [opclass] [ASC | DESC] [NULLS FIRST |
// LAST] (9.85). The name in names; the rest in pk, as PostgreSQL shows it
// ("" none). They change nothing: lexdb's text compares bytewise (C, which
// the pattern operator classes are for), and a B+tree is read either way.
// Whether an index column is a column's name alone (Oracle's function-based indexes take any expression, not parenthesised).
fn (p: &P) plainIndexCol(): bool {
    let t = p.peek()
    if t.kind != T_IDENT && t.kind != T_QIDENT { return false }
    let n = p.peekAt(1)
    if n.kind == T_OP && (n.text == "," || n.text == ")") { return true }
    return n.kind == T_IDENT && (n.text == "asc" || n.text == "desc" || n.text == "collate")
}

fn (p: mut &P) indexCol(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.isKw("(") || (p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(") || (p.ora && !p.plainIndexCol()) {
        // an expression (9.89): (expr), or a function's call
        let subs = len(p.subs)
        let params = p.params
        let x = if p.ora { try p.expr() } else { try p.unary() }
        if len(p.subs) > subs { return Err(lexdb_base.err("0A000", "cannot use subquery in index expression")) }
        if p.params > params { return Err(lexdb_base.err("42P02", &("there is no parameter $" + p.params.toStr()))) }
        append(mut &s.names, "")
        append(mut &s.exprs, x)
    } else {
        append(mut &s.names, try p.name())
        append(mut &s.exprs, Expr.Lit(Val.Null))
    }
    var opts: []str = []
    if p.acceptKw("collate") {
        // a collation's name as written: PostgreSQL's are matched by case ("C")
        let c = try p.qname()
        let sp = if len(p.spelled) > 0 { p.spelled.clone() } else { lexdb_sql.baseName(&c) }
        append(mut &opts, "COLLATE \"" + (if lexdb_sql.isQual(&c) { lexdb_sql.qual(&lexdb_sql.schemaOf(&c), &sp) } else { sp }) + "\"")
    }
    let t = p.peek().clone()
    if t.kind == T_IDENT && t.text != "asc" && t.text != "desc" && t.text != "nulls" {
        let oc = try p.qname()
        if !isOpClass(&lexdb_sql.baseName(&oc)) {
            return Err(lexdb_base.err("42704", &("operator class \"" + oc + "\" does not exist for access method \"btree\"")))
        }
        append(mut &opts, oc)
    }
    var desc = false
    if p.acceptKw("desc") { desc = true } else { let asc = p.acceptKw("asc") }
    if desc { append(mut &opts, "DESC") }
    if p.acceptKw("nulls") {
        // shown when not the default: last ascending, first descending
        let first = p.acceptKw("first")
        if !first { try p.expectKw("last") }
        if first != desc { append(mut &opts, if first { "NULLS FIRST" } else { "NULLS LAST" }) }
    }
    append(mut &s.pk, strings.join(&opts, " "))
    return Ok(Unit{})
}

// UPDATE [ONLY] t [[AS] alias] SET ... [FROM list] [WHERE ...] [RETURNING ...]
// (FROM and the alias: 9.91). The alias in alias, FROM's items in from.
fn (p: mut &P) update(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_UPDATE)
    s.mdialect = if p.tsql { MD_TSQL } else if p.ora { MD_ORA } else { MD_PG }
    if p.tsql && p.acceptKw("top") { try p.top(mut &s, false) }      // T-SQL: UPDATE TOP (n)
    try p.dmlTarget(mut &s)
    try p.expectKw("set")
    try p.setList(mut &s)
    var out: []SelItem = []
    if p.tsql && p.acceptKw("output") { try p.outputList(mut &s, mut &out) }
    if p.acceptKw("from") { try p.dmlFrom(mut &s) }
    if p.acceptKw("where") {
        if p.ora { try p.dmlWhere(mut &s) } else { s.where = Some(try p.expr()) }
    }
    try p.returning(mut &s)
    try p.batchOpt(mut &s)
    if p.tsql { try tsqlDml(mut &s, out) }
    return Ok(s)
}

// An UPDATE's or DELETE's WHERE, after its keyword. Oracle's ROWNUM tests in it (oraRownum) are the statement's limit: the first
// n rows the rest of the condition finds (TOP's, firstN).
fn (p: mut &P) dmlWhere(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    var emptied = false
    var rn = -1
    if p.ora { rn = p.oraRownum(mut &emptied) }
    if !emptied { s.where = Some(try p.expr()) }
    if rn >= 0 { s.limit = Some(Expr.Lit(Val.Int(rn))) }
    return Ok(Unit{})
}

// lexdb's WITH (batch_rows n) at the end of an UPDATE or DELETE (design/
// lexdb-bulkdelete.md stage 8; in all three dialects: they share this
// parser): the statement commits each n rows. Kept in copy.batchRows, as
// COPY's (n must be positive: 22023); the executor refuses what it cannot
// batch.
fn (p: mut &P) batchOpt(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if !(p.isKw("with") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" && p.peekAt(2).kind == T_IDENT && p.peekAt(2).text == "batch_rows") { return Ok(Unit{}) }
    p.pos += 3
    let v = p.peek().clone()
    if v.kind != T_NUM { return Err(near(&v)) }
    p.pos += 1
    let n = strings.parseIntOpt(&v.text).unwrapOr(0)
    if n < 1 { return Err(lexdb_base.err("22023", "batch_rows must be a positive integer")) }
    s.copy.batchRows = n
    try p.expectKw(")")
    return Ok(Unit{})
}

// DELETE FROM [ONLY] t [[AS] alias] [USING list] [WHERE ...] [RETURNING ...]
fn (p: mut &P) delete(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_DELETE)
    // T-SQL: DELETE [TOP (n)] [FROM] t [OUTPUT ...] [FROM list] [WHERE ...]
    if p.tsql && p.acceptKw("top") { try p.top(mut &s, false) }
    if !(p.tsql || p.ora) || p.isKw("from") { try p.expectKw("from") }
    try p.dmlTarget(mut &s)
    var out: []SelItem = []
    if p.tsql && p.acceptKw("output") { try p.outputList(mut &s, mut &out) }
    // (Oracle 23ai's direct join: DELETE [FROM] t [alias] FROM list, as PostgreSQL's USING)
    if p.acceptKw("using") || ((p.tsql || p.ora) && p.acceptKw("from")) { try p.dmlFrom(mut &s) }
    if p.acceptKw("where") {
        if p.ora { try p.dmlWhere(mut &s) } else { s.where = Some(try p.expr()) }
    }
    try p.returning(mut &s)
    try p.batchOpt(mut &s)
    if p.tsql { try tsqlDml(mut &s, out) }
    return Ok(s)
}

// ---- MERGE (design/lexdb.md 9.121): one statement, read in three dialects.
//   PostgreSQL: MERGE INTO t [[AS] a] USING source ON cond when ... [RETURNING ...]
//     WHEN [NOT] MATCHED [BY SOURCE | BY TARGET] [AND cond] THEN
//       UPDATE SET ... | DELETE | DO NOTHING | INSERT [(cols)] [OVERRIDING ...] VALUES (...) | DEFAULT VALUES
//   T-SQL: MERGE [TOP (n)] [INTO] t [[AS] a] USING source [[AS] s] ON cond when ... [OUTPUT ...] ;
//     (no DO NOTHING; the ; is required)
//   Oracle: MERGE INTO t a USING source b ON (cond) [WHEN MATCHED THEN UPDATE SET ... [WHERE c] [DELETE WHERE c]]
//     [WHEN NOT MATCHED THEN INSERT [(cols)] VALUES (...) [WHERE c]], the two in either order
// The source is from[0], ON is where; its clauses are merges.
// Oracle's ORA-02000 for a keyword that was to be there.
fn oraKeyword(w: &str): lexdb_base.DbErr { return lexdb_base.err("ORA02000", &("missing " + w + " keyword")) }

fn noClause(when: int): MergeClause {
    return MergeClause{when: when, cond: None, act: 0, sets: [], names: [], vals: [], defaults: false, delWhere: None}
}

fn (p: mut &P) merge(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_MERGE)
    s.mdialect = if p.tsql { MD_TSQL } else if p.ora { MD_ORA } else { MD_PG }
    if p.tsql && p.acceptKw("top") {
        try p.top(mut &s, false)
        if s.topMode & TOP_PERCENT != 0 { return Err(lexdb_base.err("0A000", "lexdb: MERGE TOP ... PERCENT is not supported")) }
    }
    if p.tsql { let into = p.acceptKw("into") } else { try p.expectKw("into") }
    s.table = try p.rname()
    var cols: []str = []
    try p.tableHints()
    try p.aliasOf(mut &s.alias, mut &cols, false)
    try p.tableHints()
    if len(cols) > 0 { return Err(lexdb_base.err("42601", "syntax error at or near \"(\"")) }
    try p.expectKw("using")
    append(mut &s.from, try p.fromItem(J_CROSS))
    if p.ora && !(p.isKw("on") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(") {
        return Err(lexdb_base.err("ORA00969", "missing ON keyword"))
    }
    try p.expectKw("on")
    s.where = Some(try p.expr())
    if !p.isKw("when") { return Err(if p.ora { oraKeyword("WHEN") } else { near(&p.peek()) }) }
    while p.isKw("when") { try p.mergeWhen(mut &s) }
    if s.mdialect == MD_ORA && len(s.merges) > 2 { return Err(near(&p.peek())) }
    var out: []SelItem = []
    if p.tsql && p.acceptKw("output") { try p.outputList(mut &s, mut &out) }
    if !p.tsql { try p.returning(mut &s) }
    // Oracle: no RETURNING with DELETE WHERE (ORA-03001)
    if p.ora && len(s.items) > 0 { for c in s.merges { if c.delWhere.isSome() { return Err(lexdb_base.err("ORA03001", "unimplemented feature")) } } }
    for i in 0..len(s.items) {
        match replace(mut &s.items[i].expr, None) {
            Some(x) {
                // merge_action() names its column so, unless aliased
                match x {
                    Expr.Call(f, a, _) { if f == "merge_action" && len(s.items[i].alias) == 0 { s.items[i].alias = "merge_action" } }
                    else {}
                }
                s.items[i].expr = Some(renameCall(&x, "merge_action", "#maction"))
            }
            None {}
        }
    }
    if p.tsql {
        try tsqlMergeCheck(&s)
        try mergeOutput(mut &s, out)
        // SQL Server: the statement ends with a semicolon
        let t = p.peek().clone()
        if !(t.kind == T_OP && t.text == ";") {
            return Err(lexdb_base.err("TS10713", "A MERGE statement must be terminated by a semi-colon (;)."))
        }
    }
    return Ok(s)
}

// One WHEN clause, at its WHEN.
fn (p: mut &P) mergeWhen(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    p.pos += 1
    var c = noClause(MC_MATCHED)
    var seen = [false, false]
    for k in s.merges { if k.when == MC_MATCHED { seen[0] = true } else { seen[1] = true } }
    if p.acceptKw("not") {
        if p.ora && seen[1] { return Err(oraKeyword("MATCHED")) }
        try p.expectKw("matched")
        c.when = MC_NOT_MATCHED
        if p.acceptKw("by") {
            if p.ora { return Err(oraKeyword("THEN")) }
            if p.acceptKw("source") { c.when = MC_BY_SOURCE } else { try p.expectKw("target") }
        }
    } else {
        if p.ora && seen[0] { return Err(oraKeyword("NOT")) }
        try p.expectKw("matched")
    }
    if !p.ora && p.acceptKw("and") { c.cond = Some(try p.expr()) }
    try p.expectKw("then")
    let t = p.peek().clone()
    if p.ora && c.when == MC_MATCHED && !p.isKw("update") { return Err(oraKeyword("UPDATE")) }
    if p.ora && c.when == MC_NOT_MATCHED && !p.isKw("insert") { return Err(oraKeyword("INSERT")) }
    if p.acceptKw("update") {
        if c.when == MC_NOT_MATCHED { return Err(mergeAction(p.tsql, "UPDATE", &c, &t)) }
        try p.expectKw("set")
        var tmp = lexdb_sql.newStmt(S_UPDATE)
        try p.setList(mut &tmp)
        c.sets = replace(mut &tmp.sets, [])
        c.act = MA_UPDATE
        if p.ora {
            if p.acceptKw("where") { c.cond = Some(try p.expr()) }
            if p.acceptKw("delete") {
                try p.expectKw("where")
                c.delWhere = Some(try p.expr())
            }
        }
    } else if p.acceptKw("delete") {
        if c.when == MC_NOT_MATCHED || p.ora { return Err(mergeAction(p.tsql, "DELETE", &c, &t)) }
        c.act = MA_DELETE
    } else if p.acceptKw("insert") {
        if c.when != MC_NOT_MATCHED { return Err(mergeAction(p.tsql, "INSERT", &c, &t)) }
        c.act = MA_INSERT
        if p.isKw("(") {
            p.pos += 1
            append(mut &c.names, try p.name())
            while p.acceptKw(",") {
                // Oracle: INSERT (t.col)
                var n = try p.name()
                append(mut &c.names, n)
            }
            try p.expectKw(")")
        }
        if p.acceptKw("overriding") {
            if p.acceptKw("system") { s.overriding = OVR_SYSTEM } else {
                try p.expectKw("user")
                s.overriding = OVR_USER
            }
            try p.expectKw("value")
        }
        if p.acceptKw("default") {
            try p.expectKw("values")
            c.defaults = true
        } else {
            try p.expectKw("values")
            try p.expectKw("(")
            append(mut &c.vals, try p.valueOrDefault())
            while p.acceptKw(",") { append(mut &c.vals, try p.valueOrDefault()) }
            try p.expectKw(")")
        }
        if p.ora && p.acceptKw("where") { c.cond = Some(try p.expr()) }
    } else if p.acceptKw("do") {
        if p.tsql || p.ora { return Err(near(&t)) }
        try p.expectKw("nothing")
        c.act = MA_NOTHING
    } else {
        return Err(near(&t))
    }
    append(mut &s.merges, c)
    return Ok(Unit{})
}

// T-SQL's WHEN clauses' name, as its errors say it.
fn mergeWhenName(when: int): str {
    if when == MC_NOT_MATCHED { return "WHEN NOT MATCHED" }
    return if when == MC_BY_SOURCE { "WHEN NOT MATCHED BY SOURCE" } else { "WHEN MATCHED" }
}

// The error for an action a WHEN clause does not take: SQL Server's (10710, 10711), else a syntax error.
fn mergeAction(tsql: bool, act: &str, c: &MergeClause, at: &Tok): lexdb_base.DbErr {
    if !tsql { return near(at) }
    return lexdb_base.err(if act == "INSERT" { "TS10711" } else { "TS10710" },
                          &("An action of type '" + act + "' is not allowed in the '" + mergeWhenName(c.when) + "' clause of a MERGE statement."))
}

// SQL Server's rules for the clauses: an action once in each kind of clause (10714), and a clause
// with no condition last of its kind (5324).
fn tsqlMergeCheck(s: &Stmt): Result[Unit, lexdb_base.DbErr] {
    for i in 0..len(s.merges) {
        for j in i + 1..len(s.merges) {
            if s.merges[i].when == s.merges[j].when && s.merges[i].act == s.merges[j].act {
                let a = if s.merges[i].act == MA_UPDATE { "UPDATE" } else if s.merges[i].act == MA_DELETE { "DELETE" } else { "INSERT" }
                return Err(lexdb_base.err("TS10714", &("An action of type '" + mergeWhenName(s.merges[i].when) + "' cannot appear more than once in a '" + a + "' clause of a MERGE statement.")))
            }
        }
    }
    for i in 0..len(s.merges) {
        for j in i + 1..len(s.merges) {
            if s.merges[i].when == s.merges[j].when && s.merges[i].cond.isNone() {
                return Err(lexdb_base.err("TS5324", &("In a MERGE statement, a '" + mergeWhenName(s.merges[i].when) + "' clause with a search condition cannot appear after a '" + mergeWhenName(s.merges[i].when) + "' clause with no search condition.")))
            }
        }
    }
    return Ok(Unit{})
}

// x with every call of function from named to.
fn renameCall(x: &Expr, from: &str, to: &str): Expr {
    match x {
        Expr.Call(f, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, renameCall(&a, from, to)) }
            return Expr.Call(if f == from { to.toStr() } else { f.toStr() }, out, star)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.toStr(), renameCall(&a, from, to)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.toStr(), renameCall(&a, from, to), renameCall(&b, from, to)) }
        Expr.Cast(a, t) { return Expr.Cast(renameCall(&a, from, to), t) }
        Expr.IsNull(a, n) { return Expr.IsNull(renameCall(&a, from, to), n) }
        else { return cloneE(x) }
    }
}

// T-SQL's MERGE ... OUTPUT: the items as RETURNING's, INSERTED.c the row's c
// (NULL for a row deleted), DELETED.c the old row's (#old: NULL for a row
// inserted), $action the action's name. DELETED.* is kept apart (the
// qualifier "\x01deleted") for the executor to expand.
fn mergeOutput(s: mut &Stmt, out: []SelItem): Result[Unit, lexdb_base.DbErr] {
    if len(out) == 0 { return Ok(Unit{}) }
    let q = if len(s.alias) > 0 { s.alias.toStr() } else { lexdb_sql.baseName(&s.table) }
    var items = out
    for i in 0..len(items) {
        if items[i].star {
            if items[i].qual == "inserted" { items[i].qual = q.clone() }
            if items[i].qual == "deleted" { items[i].qual = "\x01deleted" }
            continue
        }
        match replace(mut &items[i].expr, None) {
            Some(x) {
                match x {
                    Expr.Col(n, _) { if n == "$action" && len(items[i].alias) == 0 { items[i].alias = "$action" } }
                    else {}
                }
                items[i].expr = Some(outputRefs(&x, &q, true))
            }
            None {}
        }
    }
    s.items = items
    return Ok(Unit{})
}

// UPDATE's and DELETE's table: [ONLY] name [*] [[AS] alias]. lexdb has no
// inheritance, so ONLY and * change nothing.
fn (p: mut &P) dmlTarget(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    let only = p.acceptKw("only")
    s.table = try p.rname()
    let star = p.acceptKw("*")
    var cols: []str = []
    try p.aliasOf(mut &s.alias, mut &cols, false)
    try p.tableHints()
    if len(cols) > 0 { return Err(lexdb_base.err("42601", "syntax error at or near \"(\"")) }
    return Ok(Unit{})
}

// TRUNCATE [TABLE] [ONLY] name [*], ... [RESTART IDENTITY | CONTINUE
// IDENTITY] [CASCADE | RESTRICT] (9.91): the first name in table, the
// others in names; RESTART IDENTITY in ifFlag, CASCADE in cascade.
fn (p: mut &P) truncate(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_TRUNCATE)
    let tb = p.acceptKw("table")
    while true {
        let only = p.acceptKw("only")
        let n = try p.rname()
        let star = p.acceptKw("*")
        if len(s.table) == 0 { s.table = n } else { append(mut &s.names, n) }
        if !p.acceptKw(",") { break }
    }
    if p.acceptKw("restart") {
        try p.expectKw("identity")
        s.ifFlag = true
    } else if p.acceptKw("continue") {
        try p.expectKw("identity")
    }
    if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
    return Ok(s)
}

// The maintenance statements (9.94), after their keyword: checked, then
// done (lexdb_exec maint: some as nothing).
//   VACUUM [(option, ...)] [FULL] [FREEZE] [VERBOSE] [ANALYZE] [[ONLY] table [(col, ...)], ...]
//   ANALYZE [(option, ...)] [VERBOSE] [[ONLY] table [(col, ...)], ...]
//   CHECKPOINT
//   REINDEX [(option, ...)] {INDEX | TABLE | SCHEMA | DATABASE | SYSTEM} [CONCURRENTLY] [name]
//   CLUSTER [(option, ...)] [VERBOSE] [table [USING index]]
fn (p: mut &P) maint(w: &str): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_MAINT)
    let kw = if w == "analyse" { "analyze" } else { w.clone() }
    s.alias = strings.toUpperAscii(&kw)
    if kw == "checkpoint" { return Ok(s) }
    var analyze = kw == "analyze"
    var full = false
    var parallel = false
    var conc = false
    if p.acceptKw("(") {
        while true {
            let o = p.next()
            if o.kind != T_IDENT { return Err(near(&o)) }
            let known = match kw {
                "vacuum" { o.text == "full" || o.text == "freeze" || o.text == "verbose" || o.text == "analyze" || o.text == "disable_page_skipping" ||
                           o.text == "skip_locked" || o.text == "index_cleanup" || o.text == "process_main" || o.text == "process_toast" ||
                           o.text == "truncate" || o.text == "parallel" || o.text == "skip_database_stats" || o.text == "only_database_stats" ||
                           o.text == "buffer_usage_limit" }
                "analyze" { o.text == "verbose" || o.text == "skip_locked" || o.text == "buffer_usage_limit" }
                "reindex" { o.text == "concurrently" || o.text == "tablespace" || o.text == "verbose" }
                else { o.text == "verbose" }
            }
            if !known { return Err(lexdb_base.err("42601", &("unrecognized \"" + s.alias + "\" option \"" + o.text + "\""))) }
            // its value, if any: a word, a number or a text
            var off = false
            if !p.isKw(",") && !p.isKw(")") {
                let v = p.next()
                off = v.text == "false" || v.text == "off" || v.text == "0"
            }
            if !off {
                if o.text == "analyze" { analyze = true }
                if o.text == "full" { full = true }
                if o.text == "parallel" { parallel = true }
                if o.text == "concurrently" { conc = true }
            }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    } else {
        while true {
            if p.acceptKw("verbose") { continue }
            if kw == "vacuum" && (p.isKw("full") || p.isKw("freeze") || p.isKw("analyze") || p.isKw("analyse")) {
                let o = p.next().text
                if o == "full" { full = true }
                if o == "analyze" || o == "analyse" { analyze = true }
                continue
            }
            break
        }
    }
    if full && parallel { return Err(lexdb_base.err("0A000", "VACUUM FULL cannot be performed in parallel")) }
    if kw == "vacuum" || kw == "analyze" {
        if kw == "vacuum" { s.table = "VACUUM" }
        // ANALYZE gathers the planner's statistics (lexdb_exec, optimizer 31)
        if analyze { s.kind = S_ANALYZE }
        while p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT {
            let only = p.acceptKw("only")
            append(mut &s.names, try p.qname())
            var cols: []str = []
            if p.acceptKw("(") {
                append(mut &cols, try p.name())
                while p.acceptKw(",") { append(mut &cols, try p.name()) }
                try p.expectKw(")")
                if !analyze { return Err(lexdb_base.err("0A000", "ANALYZE option must be specified when a column list is provided")) }
            }
            append(mut &s.maintCols, cols)
            if !p.acceptKw(",") { break }
        }
        return Ok(s)
    }
    s.unique = true
    if kw == "reindex" {
        let what = p.next()
        if what.kind != T_IDENT || (what.text != "index" && what.text != "table" && what.text != "schema" && what.text != "database" &&
                                    what.text != "system") { return Err(near(&what)) }
        if p.acceptKw("concurrently") { conc = true }
        let whole = what.text == "database" || what.text == "system"
        if whole && what.text == "system" && conc { return Err(lexdb_base.err("0A000", "cannot reindex system catalogs concurrently")) }
        if conc { s.table = "REINDEX CONCURRENTLY" } else if whole { s.table = "REINDEX " + strings.toUpperAscii(&what.text) }
        if whole {
            if p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT {
                let n = try p.name()
                if n != "lexdb" { return Err(lexdb_base.err("0A000", "can only reindex the currently open database")) }
            }
        } else if what.text == "schema" {
            s.index = SCHEMA_MARK + (try p.name())
        } else if what.text == "index" {
            s.index = try p.qname()
        } else {
            append(mut &s.names, try p.qname())
        }
        return Ok(s)
    }
    // CLUSTER
    if p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT {
        append(mut &s.names, try p.qname())
        if p.acceptKw("using") { s.index = try p.qname() }
    } else {
        s.table = "CLUSTER"
    }
    return Ok(s)
}


// COPY (9.45), after its keyword:
//   COPY table [(col, ...)] FROM STDIN [options]
//   COPY {table [(col, ...)] | (query)} TO STDOUT [options]
// options: [WITH] (FORMAT text|csv, DELIMITER 'c', NULL 's', HEADER [bool],
// QUOTE 'c', ESCAPE 'c', ENCODING 'utf8'), or the old form [WITH] [BINARY]
// [DELIMITER [AS] 'c'] [NULL [AS] 's'] [CSV [HEADER] [QUOTE [AS] 'c']
// [ESCAPE [AS] 'c']]. A table's TO is the query SELECT cols FROM table.
fn (p: mut &P) copyStmt(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_COPY)
    var query = false
    if p.isKw("(") {
        p.pos += 1
        query = true
        var q: Stmt = lexdb_sql.newStmt(S_SELECT)
        if p.acceptKw("select") { q = try p.select() }
        else if p.isKw("(") && p.parenQueryStart() { q = try p.parenSelect() }
        else if p.acceptKw("with") {
            let n = try p.withList()
            try p.expectKw("select")
            let r = p.select()
            p.popCtes(n)
            q = try r
        } else { return Err(lexdb_base.err("0A000", "lexdb: COPY's query must be a SELECT")) }
        try p.expectKw(")")
        q.subs = replace(mut &p.subs, [])
        q.wins = replace(mut &p.wins, [])
        q.params = p.params
        append(mut &s.inner, q)
    } else {
        s.table = try p.rname()
        if p.acceptKw("(") {
            append(mut &s.names, try p.name())
            while p.acceptKw(",") { append(mut &s.names, try p.name()) }
            try p.expectKw(")")
        }
    }
    if p.acceptKw("from") {
        if query { return Err(lexdb_base.err("42601", "COPY FROM takes a table, not a query")) }
        s.copy.from = true
        if !p.acceptKw("stdin") { return Err(lexdb_base.err("0A000", "lexdb: COPY FROM reads only STDIN (a file on the server: use psql's \\copy)")) }
    } else {
        try p.expectKw("to")
        if !p.acceptKw("stdout") { return Err(lexdb_base.err("0A000", "lexdb: COPY TO writes only STDOUT (a file on the server: use psql's \\copy)")) }
    }
    var format = ""
    var hasForceArray = false
    var hasQuote = false
    var hasEscape = false
    var delim: Option[str] = None
    var null: Option[str] = None
    let with = p.acceptKw("with")
    if p.acceptKw("(") {
        var seen: []str = []
        while true {
            let t = p.peek().clone()
            if t.kind != T_IDENT { return Err(near(&t)) }
            p.pos += 1
            // an option given twice: PostgreSQL's error, before any data is asked for
            for x in seen { if x == t.text { return Err(lexdb_base.err("42601", "conflicting or redundant options")) } }
            append(mut &seen, t.text.clone())
            let v = p.peek().clone()
            match t.text {
                "format" {
                    if v.kind != T_IDENT && v.kind != T_STR { return Err(near(&v)) }
                    p.pos += 1
                    format = strings.toLowerAscii(&v.text)
                }
                "header" {
                    if v.kind == T_IDENT && v.text != "match" { p.pos += 1; s.copy.header = !(v.text == "false" || v.text == "off") }
                    else if v.kind == T_NUM && v.text != "0" && v.text != "1" { return Err(lexdb_base.err("42601", "header requires a Boolean value or \"match\"")) }
                    else if v.kind == T_NUM { p.pos += 1; s.copy.header = v.text != "0" }
                    else if v.kind == T_IDENT { return Err(lexdb_base.err("0A000", "lexdb: COPY's HEADER MATCH is not supported")) }
                    else { s.copy.header = true }
                }
                "delimiter" { delim = Some(try p.copyStr()) }
                "null" { null = Some(try p.copyStr()) }
                "quote" { s.copy.quote = try p.copyStr(); hasQuote = true }
                "escape" { s.copy.escape = try p.copyStr(); hasEscape = true }
                "encoding" {
                    let enc = strings.toLowerAscii(&(try p.copyStr()))
                    if enc != "utf8" && enc != "utf-8" && enc != "unicode" && enc != "sql_ascii" {
                        return Err(lexdb_base.err("0A000", "lexdb: COPY's encoding is UTF8 only"))
                    }
                }
                "freeze" {
                    // a hint: accepted (with its boolean) and ignored
                    if v.kind == T_IDENT && (v.text == "true" || v.text == "false" || v.text == "on" || v.text == "off") { p.pos += 1 }
                }
                "force_quote" {
                    if p.acceptKw("*") { s.copy.quoteAll = true } else { s.copy.forceQuote = try p.nameList() }
                }
                "force_not_null" { s.copy.forceNotNull = try p.nameList() }
                "force_null" { s.copy.forceNull = try p.nameList() }
                "batch_rows" {
                    // lexdb's own (9.87)
                    if v.kind != T_NUM { return Err(near(&v)) }
                    p.pos += 1
                    let n = strings.parseIntOpt(&v.text).unwrapOr(0)
                    if n < 1 { return Err(lexdb_base.err("22023", "batch_rows must be a positive integer")) }
                    s.copy.batchRows = n
                }
                "force_array" {
                    // (PostgreSQL 19) FORMAT json's one array of the rows; a Boolean, true when no value is given
                    if v.kind == T_IDENT && (v.text == "true" || v.text == "on") { p.pos += 1; s.copy.setForceArray(true) }
                    else if v.kind == T_IDENT && (v.text == "false" || v.text == "off") { p.pos += 1; s.copy.setForceArray(false) }
                    else if v.kind == T_NUM && (v.text == "1" || v.text == "0") { p.pos += 1; s.copy.setForceArray(v.text == "1") }
                    else if v.kind == T_OP && (v.text == "," || v.text == ")") { s.copy.setForceArray(true) }
                    else { return Err(lexdb_base.err("42601", "force_array requires a Boolean value")) }
                    hasForceArray = true
                }
                "on_error" {
                    // (PostgreSQL 17) stop, or ignore: a row with a value its column does not take is skipped
                    if v.kind != T_IDENT && v.kind != T_STR { return Err(near(&v)) }
                    p.pos += 1
                    let w = strings.toLowerAscii(&v.text)
                    if w == "ignore" { s.copy.setOnErr(1) }
                    else if w == "stop" { s.copy.setOnErr(0) }
                    else if w == "set_null" { return Err(lexdb_base.err("0A000", "lexdb: COPY's ON_ERROR set_null is not supported")) }
                    else { return Err(lexdb_base.err("22023", &("COPY ON_ERROR \"" + v.text + "\" not recognized"))) }
                }
                "reject_limit" {
                    // (PostgreSQL 18) the rows ON_ERROR ignore may skip: more is an error
                    var neg = false
                    if v.kind == T_OP && v.text == "-" { neg = true; p.pos += 1 }
                    let nv = p.peek().clone()
                    if nv.kind != T_NUM { return Err(lexdb_base.err("22P02", &("invalid input syntax for type bigint: \"" + nv.text + "\""))) }
                    p.pos += 1
                    let n = strings.parseIntOpt(&nv.text).unwrapOr(-1)
                    if neg || n < 1 { return Err(lexdb_base.err("22023", &("REJECT_LIMIT (" + (if neg { "-" } else { "" }) + nv.text + ") must be greater than zero"))) }
                    s.copy.setReject(n)
                }
                "log_verbosity" {
                    // (PostgreSQL 16, silent: 18) what COPY FROM ... ON_ERROR ignore tells of the rows it skips
                    if v.kind != T_IDENT && v.kind != T_STR { return Err(near(&v)) }
                    p.pos += 1
                    let w = strings.toLowerAscii(&v.text)
                    if w == "default" { s.copy.setVerb(0) }
                    else if w == "verbose" { s.copy.setVerb(1) }
                    else if w == "silent" { s.copy.setVerb(2) }
                    else { return Err(lexdb_base.err("22023", &("COPY LOG_VERBOSITY \"" + v.text + "\" not recognized"))) }
                }
                "default" {
                    return Err(lexdb_base.err("0A000", &("lexdb: COPY's option \"" + t.text + "\" is not supported")))
                }
                else { return Err(lexdb_base.err("42601", &("option \"" + t.text + "\" not recognized"))) }
            }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    } else {
        while true {
            if p.acceptKw("binary") { format = "binary" }
            else if p.acceptKw("delimiter") { let a = p.acceptKw("as"); delim = Some(try p.copyStr()) }
            else if p.acceptKw("null") { let a = p.acceptKw("as"); null = Some(try p.copyStr()) }
            else if p.acceptKw("csv") { format = "csv" }
            else if p.acceptKw("header") { s.copy.header = true }
            else if p.acceptKw("quote") { let a = p.acceptKw("as"); s.copy.quote = try p.copyStr(); hasQuote = true }
            else if p.acceptKw("escape") { let a = p.acceptKw("as"); s.copy.escape = try p.copyStr(); hasEscape = true }
            else if p.acceptKw("force") {
                // FORCE QUOTE {* | col, ...}, FORCE NOT NULL col, ...
                if p.acceptKw("quote") {
                    if p.acceptKw("*") { s.copy.quoteAll = true } else { s.copy.forceQuote = try p.bareNames() }
                } else {
                    try p.expectKw("not")
                    try p.expectKw("null")
                    s.copy.forceNotNull = try p.bareNames()
                }
            }
            else { break }
        }
    }
    if format == "binary" {
        if s.copy.onErr() > 0 { return Err(lexdb_base.err("42601", "only ON_ERROR STOP is allowed in BINARY mode")) }
        return Err(lexdb_base.err("0A000", "lexdb: COPY's binary format is not supported"))
    }
    if format != "" && format != "text" && format != "csv" && format != "json" { return Err(lexdb_base.err("22023", &("COPY format \"" + format + "\" not recognized"))) }
    if s.copy.onErr() > 0 && !s.copy.from { return Err(lexdb_base.err("22023", "COPY ON_ERROR cannot be used with COPY TO")) }
    if s.copy.reject() > 0 && s.copy.onErr() == 0 { return Err(lexdb_base.err("22023", "COPY REJECT_LIMIT requires ON_ERROR to be set to IGNORE")) }
    if s.copy.reject() > 0 && !s.copy.from { return Err(lexdb_base.err("22023", "COPY REJECT_LIMIT cannot be used with COPY TO")) }
    if hasForceArray && format != "json" { return Err(lexdb_base.err("22023", "COPY FORCE_ARRAY requires JSON mode")) }
    if format == "json" {
        if s.copy.from { return Err(lexdb_base.err("22023", "COPY FORMAT JSON is not supported for COPY FROM")) }
        if s.copy.header { return Err(lexdb_base.err("0A000", "cannot specify HEADER in JSON mode")) }
        if delim.isSome() { return Err(lexdb_base.err("42601", "cannot specify DELIMITER in JSON mode")) }
        if null.isSome() { return Err(lexdb_base.err("42601", "cannot specify NULL in JSON mode")) }
        if hasQuote || hasEscape { return Err(lexdb_base.err("0A000", "cannot specify QUOTE or ESCAPE in JSON mode")) }
        if s.copy.quoteAll || len(s.copy.forceQuote) > 0 || len(s.copy.forceNotNull) > 0 || len(s.copy.forceNull) > 0 {
            return Err(lexdb_base.err("0A000", "cannot specify FORCE_QUOTE, FORCE_NOT_NULL or FORCE_NULL in JSON mode"))
        }
        s.copy.setJson(true)
    }
    s.copy.csv = format == "csv"
    s.copy.delim = delim.unwrapOr(if s.copy.csv { "," } else { "\t" })
    s.copy.null = null.unwrapOr(if s.copy.csv { "" } else { "\\N" })
    if !s.copy.csv && (hasQuote || hasEscape) {
        return Err(lexdb_base.err("0A000", &("COPY " + (if hasQuote { "quote" } else { "escape" }) + " available only in CSV mode")))
    }
    if !hasQuote { s.copy.quote = "\"" }
    if !hasEscape { s.copy.escape = s.copy.quote.clone() }
    if len(s.copy.delim) != 1 { return Err(lexdb_base.err("22023", "COPY delimiter must be a single one-byte character")) }
    if s.copy.delim == "\n" || s.copy.delim == "\r" { return Err(lexdb_base.err("22023", "COPY delimiter cannot be newline or carriage return")) }
    if !s.copy.csv && strings.indexOf(&"\\.abcdefghijklmnopqrstuvwxyz0123456789", &s.copy.delim, 0) >= 0 {
        return Err(lexdb_base.err("22023", &("COPY delimiter cannot be \"" + s.copy.delim + "\"")))
    }
    if s.copy.csv {
        if len(s.copy.quote) != 1 { return Err(lexdb_base.err("22023", "COPY quote must be a single one-byte character")) }
        if len(s.copy.escape) != 1 { return Err(lexdb_base.err("22023", "COPY escape must be a single one-byte character")) }
        if s.copy.quote == s.copy.delim { return Err(lexdb_base.err("22023", "COPY delimiter and quote must be different")) }
    }
    let anyQuote = s.copy.quoteAll || len(s.copy.forceQuote) > 0
    if (anyQuote || len(s.copy.forceNotNull) > 0 || len(s.copy.forceNull) > 0) && !s.copy.csv {
        let which = if anyQuote { "force quote" } else if len(s.copy.forceNotNull) > 0 { "force not null" } else { "force null" }
        return Err(lexdb_base.err("0A000", &("COPY " + which + " available only in CSV mode")))
    }
    if anyQuote && s.copy.from { return Err(lexdb_base.err("0A000", "COPY force quote only available using COPY TO")) }
    if len(s.copy.forceNotNull) > 0 && !s.copy.from { return Err(lexdb_base.err("0A000", "COPY force not null only available using COPY FROM")) }
    if len(s.copy.forceNull) > 0 && !s.copy.from { return Err(lexdb_base.err("0A000", "COPY force null only available using COPY FROM")) }
    if strings.indexOf(&s.copy.null, &s.copy.delim, 0) >= 0 {
        return Err(lexdb_base.err("22023", "COPY delimiter character must not appear in the NULL specification"))
    }
    if strings.indexOf(&s.copy.null, "\n", 0) >= 0 || strings.indexOf(&s.copy.null, "\r", 0) >= 0 {
        return Err(lexdb_base.err("22023", "COPY null representation cannot use newline or carriage return"))
    }
    if !query && !s.copy.from {
        // TO from a table: its query
        var q = lexdb_sql.newStmt(S_SELECT)
        // (its alias "#copy": the columns a COPY has by default, not the generated ones)
        if len(s.names) == 0 { append(mut &q.items, SelItem{star: true, qual: "", expr: None, alias: "#copy", spell: ""}) }
        for n in s.names { append(mut &q.items, SelItem{star: false, qual: "", expr: Some(Expr.Col(n.clone(), -1)), alias: "", spell: ""}) }
        append(mut &q.from, FromItem{table: s.table.clone(), alias: lexdb_sql.baseName(&s.table), join: J_FIRST, on: None, sub: -1, cols: [], work: -1, lateral: false, using: [], natural: false, comma: false})
        append(mut &s.inner, q)
    }
    return Ok(s)
}

// (col, ...): COPY's FORCE options.
fn (p: mut &P) nameList(): Result[[]str, lexdb_base.DbErr] {
    try p.expectKw("(")
    let ns = try p.bareNames()
    try p.expectKw(")")
    return Ok(ns)
}

// col, ...: in the old options' form no comma separates options, so one
// here always continues the list.
fn (p: mut &P) bareNames(): Result[[]str, lexdb_base.DbErr] {
    var ns: []str = [try p.name()]
    while p.acceptKw(",") { append(mut &ns, try p.name()) }
    return Ok(ns)
}

// ---- windows (9.46)

// After OVER: a window's name, or (spec).
fn (p: mut &P) over(): Result[WinDef, lexdb_base.DbErr] {
    if p.acceptKw("(") { return p.winSpec() }
    let n = try p.name()
    return Ok(WinDef{call: Expr.Lit(Val.Null), ref: n, bare: true, part: [], order: [], frame: lexdb_sql.noFrame()})
}

// A window's spec, after its "(": [name] [PARTITION BY ...] [ORDER BY ...]
// [frame], and its ")".
fn (p: mut &P) winSpec(): Result[WinDef, lexdb_base.DbErr] {
    var d = WinDef{call: Expr.Lit(Val.Null), ref: "", bare: false, part: [], order: [], frame: lexdb_sql.noFrame()}
    let t = p.peek().clone()
    if (t.kind == T_IDENT || t.kind == T_QIDENT) && !(t.kind == T_IDENT &&
        (t.text == "partition" || t.text == "order" || t.text == "rows" || t.text == "range" || t.text == "groups")) {
        d.ref = try p.name()
    }
    if p.acceptKw("partition") {
        try p.expectKw("by")
        append(mut &d.part, try p.expr())
        while p.acceptKw(",") { append(mut &d.part, try p.expr()) }
    }
    if p.acceptKw("order") {
        try p.expectKw("by")
        while true {
            let x = try p.expr()
            var desc = false
            if p.acceptKw("desc") { desc = true } else { let a = p.acceptKw("asc") }
            var nf = if p.tsql { !desc } else { desc }      // NULLs first going down, last going up (SQL Server: the other way)
            if p.acceptKw("nulls") {
                if p.acceptKw("first") { nf = true } else {
                    try p.expectKw("last")
                    nf = false
                }
            }
            append(mut &d.order, WinOrder{expr: x, desc: desc, nullsFirst: nf})
            if !p.acceptKw(",") { break }
        }
    }
    var mode = FR_NONE
    if p.acceptKw("rows") { mode = FR_ROWS }
    else if p.acceptKw("range") { mode = FR_RANGE }
    else if p.acceptKw("groups") { mode = FR_GROUPS }
    if mode != FR_NONE {
        var f = lexdb_sql.noFrame()
        f.mode = mode
        if p.acceptKw("between") {
            try p.bound(mut &f, true)
            try p.expectKw("and")
            try p.bound(mut &f, false)
        } else {
            try p.bound(mut &f, true)
            f.end = B_CURRENT
        }
        if p.acceptKw("exclude") {
            if p.acceptKw("current") { try p.expectKw("row"); f.exclude = EX_CURRENT }
            else if p.acceptKw("group") { f.exclude = EX_GROUP }
            else if p.acceptKw("ties") { f.exclude = EX_TIES }
            else { try p.expectKw("no"); try p.expectKw("others") }
        }
        if f.start == B_UNBOUNDED_FOLLOWING { return Err(lexdb_base.err("42P20", "frame start cannot be UNBOUNDED FOLLOWING")) }
        if f.end == B_UNBOUNDED_PRECEDING { return Err(lexdb_base.err("42P20", "frame end cannot be UNBOUNDED PRECEDING")) }
        if f.start == B_CURRENT && f.end == B_PRECEDING {
            return Err(lexdb_base.err("42P20", "frame starting from current row cannot have preceding rows"))
        }
        if f.start == B_FOLLOWING && (f.end == B_PRECEDING || f.end == B_CURRENT) {
            return Err(lexdb_base.err("42P20", "frame starting from following row cannot have preceding rows"))
        }
        d.frame = f
    }
    try p.expectKw(")")
    return Ok(d)
}

// A frame's bound: UNBOUNDED PRECEDING | n PRECEDING | CURRENT ROW |
// n FOLLOWING | UNBOUNDED FOLLOWING.
fn (p: mut &P) bound(f: mut &Frame, start: bool): Result[Unit, lexdb_base.DbErr] {
    var kind = 0
    var off: Option[Expr] = None
    if p.acceptKw("unbounded") {
        if p.acceptKw("preceding") { kind = B_UNBOUNDED_PRECEDING } else {
            try p.expectKw("following")
            kind = B_UNBOUNDED_FOLLOWING
        }
    } else if p.acceptKw("current") {
        try p.expectKw("row")
        kind = B_CURRENT
    } else {
        off = Some(try p.expr())
        if p.acceptKw("preceding") { kind = B_PRECEDING } else {
            try p.expectKw("following")
            kind = B_FOLLOWING
        }
    }
    if start {
        f.start = kind
        f.startOff = off
    } else {
        f.end = kind
        f.endOff = off
    }
    return Ok(Unit{})
}

// A COPY option's value: a string.
fn (p: mut &P) copyStr(): Result[str, lexdb_base.DbErr] {
    let t = p.peek().clone()
    if t.kind != T_STR { return Err(near(&t)) }
    p.pos += 1
    return Ok(t.text.clone())
}

// Marks the uses of a CTE used once in a statement with n CTEs
// (Stmt.cteOnce): a filter on it may go into its query (optimizer 48.3).
// After the statement's subqueries are moved into it (a WITH's check of a
// body is not kept, so not counted).
fn markCtes(s: mut &Stmt, n: int) {
    var uses: []int = []
    for i in 0..n { append(mut &uses, 0) }
    cteUses(s, mut &uses)
    cteOnce(s, &uses)
}

fn cteUses(s: &Stmt, uses: mut &[]int) {
    if s.cte >= 0 && s.cte < len(uses) { uses[s.cte] += 1 }
    for x in s.subs { cteUses(&x, uses) }
    for x in s.inner { cteUses(&x, uses) }
}

fn cteOnce(s: mut &Stmt, uses: &[]int) {
    if s.cte >= 0 { s.cteOnce = s.cte < len(uses) && uses[s.cte] == 1 }
    for i in 0..len(s.subs) { cteOnce(mut &s.subs[i], uses) }
    for i in 0..len(s.inner) { cteOnce(mut &s.inner[i], uses) }
}

fn (p: mut &P) statement(): Result[Stmt, lexdb_base.DbErr] {
    let t = p.peek().clone()
    if t.kind == T_EOF || (t.kind == T_OP && t.text == ";") { return Ok(lexdb_sql.newStmt(S_EMPTY)) }
    if t.kind != T_IDENT {
        if t.kind == T_OP && t.text == "(" && p.parenQueryStart() { return p.parenSelect() }
        return Err(near(&t))
    }
    p.pos += 1
    match t.text {
        "select" {
            var q = try p.select()
            try p.waitSuffix(mut &q)
            if len(q.into) == 0 { return Ok(q) }
            // SELECT ... INTO t: CREATE TABLE t AS the query (9.88)
            var c = lexdb_sql.newStmt(S_CREATE)
            c.mdialect = p.md()
            c.table = replace(mut &q.into, "")
            c.temp = q.temp
            c.spell = replace(mut &q.spell, "")
            q.subs = replace(mut &p.subs, [])
            q.wins = replace(mut &p.wins, [])
            q.params = p.params
            append(mut &c.inner, q)
            return Ok(c)
        }
        "values" {
            var vq = try p.valuesQuery()
            try p.orderLimit(mut &vq)
            return Ok(vq)
        }
        "with" {
            // its queries are used where they are named (cteRef): in an
            // INSERT's SELECT, an UPDATE's or a DELETE's subqueries
            let n = try p.withList()
            var r: Result[Stmt, lexdb_base.DbErr] = Err(lexdb_base.err("42601", "WITH must be followed by SELECT, INSERT, UPDATE or DELETE"))
            if p.acceptKw("select") { r = p.select() }
            else if p.isKw("(") && p.parenQueryStart() { r = p.parenSelect() }
            else if p.acceptKw("insert") { r = p.insert() }
            else if p.acceptKw("update") { r = p.update() }
            else if p.acceptKw("delete") { r = p.delete() }
            else if p.acceptKw("merge") { r = p.merge() }
            p.popCtes(n)
            return r
        }
        "insert" { return p.insert() }
        "comment" {
            // Oracle's COMMENT ON ... IS '...': not kept
            if p.ora {
                p.skipToEnd()
                return Ok(lexdb_sql.newStmt(S_EMPTY))
            }
            return Err(near(&t))
        }
        "alter" {
            if p.ora && p.isKw("assertion") { return p.assertStmt("alter") }
            if p.acceptKw("materialized") { return p.alterMview() }
            // ALTER TABLE | VIEW | SEQUENCE | SCHEMA [IF EXISTS] name OWNER TO role (9.83)
            if p.isKw("table") || p.isKw("view") || p.isKw("sequence") || p.isKw("schema") {
                let back = p.pos
                let kind = p.next().text
                let ife = p.acceptKw("if")
                if ife { try p.expectKw("exists") }
                let nm = if kind == "schema" { try p.name() } else { try p.qname() }
                if p.acceptKw("owner") {
                    try p.expectKw("to")
                    var o = lexdb_sql.newStmt(S_OWNER)
                    o.index = kind
                    o.table = nm
                    o.ifFlag = ife
                    append(mut &o.names, try p.roleSpec())
                    return Ok(o)
                }
                p.pos = back
            }
            if p.tsql && p.isKw("database") {
                p.pos += 1
                return p.alterDatabase()
            }
            if p.tsql && p.isKw("view") {
                // ALTER VIEW name [(columns)] AS query: the view there is given a new definition
                p.pos += 1
                return p.createView(false, true)
            }
            if p.acceptKw("view") {
                var v = lexdb_sql.newStmt(S_ALTER_VIEW)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    v.ifFlag = true
                }
                v.table = try p.qname()
                if p.ora { v.mdialect = MD_ORA }
                if p.ora && (p.isKw("annotations") || p.isKw("modify")) {
                    try p.annotAlters(mut &v, true)
                    return Ok(v)
                }
                if p.ora {
                    // Oracle's ALTER VIEW: COMPILE and [NON]EDITIONABLE do nothing to a view that is there (v.index ""); RENAME is
                    // ORA-00922 (a view is renamed by RENAME v TO w)
                    if p.acceptKw("compile") || p.acceptKw("editionable") || p.acceptKw("noneditionable") { return Ok(v) }
                    if p.isKw("rename") { return Err(lexdb_base.err("ORA00922", "missing or invalid option")) }
                    return Err(lexdb_base.err("0A000", "lexdb: ALTER VIEW takes COMPILE, ANNOTATIONS, MODIFY and [NON]EDITIONABLE only"))
                }
                if !p.acceptKw("rename") { return Err(lexdb_base.err("0A000", "lexdb: ALTER VIEW supports RENAME TO only")) }
                try p.expectKw("to")
                v.index = try p.name()
                return Ok(v)
            }
            if p.acceptKw("table") { return p.alterTable() }
            if p.acceptKw("type") {
                // ALTER TYPE name ADD VALUE [IF NOT EXISTS] 'v' [BEFORE | AFTER 'w'] (9.90)
                var ty = lexdb_sql.newStmt(S_ALTER_TYPE)
                ty.table = try p.qname()
                if !p.acceptKw("add") {
                    return Err(lexdb_base.err("0A000", "lexdb: ALTER TYPE supports ADD VALUE only"))
                }
                try p.expectKw("value")
                if p.acceptKw("if") {
                    try p.expectKw("not")
                    try p.expectKw("exists")
                    ty.ifFlag = true
                }
                let v = p.next()
                if v.kind != T_STR { return Err(near(&v)) }
                append(mut &ty.names, v.text.clone())
                if p.isKw("before") || p.isKw("after") {
                    ty.alias = p.next().text
                    let w = p.next()
                    if w.kind != T_STR { return Err(near(&w)) }
                    ty.index = w.text.clone()
                }
                return Ok(ty)
            }
            if p.acceptKw("role") || p.acceptKw("user") {
                var r = lexdb_sql.newStmt(S_ALTER_ROLE)
                r.table = try p.name()
                if p.acceptKw("rename") {
                    try p.expectKw("to")
                    append(mut &r.names, "rename:" + (try p.name()))
                    return Ok(r)
                }
                if p.isKw("set") || p.isKw("reset") {
                    return Err(lexdb_base.err("0A000", "lexdb: a role's own settings (ALTER ROLE ... SET) are not supported"))
                }
                try p.roleOptions(mut &r)
                return Ok(r)
            }
            if p.acceptKw("sequence") { return p.seqStmt(S_ALTER_SEQ) }
            // ALTER INDEX [IF EXISTS] name RENAME TO new, ALTER SCHEMA name
            // RENAME TO new
            let idx = p.acceptKw("index")
            if idx || p.acceptKw("schema") {
                var s = lexdb_sql.newStmt(if idx { S_ALTER_INDEX } else { S_ALTER_SCHEMA })
                if idx {
                    if p.acceptKw("if") {
                        try p.expectKw("exists")
                        s.ifFlag = true
                    }
                    s.index = try p.qname()
                } else {
                    s.table = try p.name()
                }
                if idx && p.ora {
                    s.mdialect = MD_ORA
                    if p.isKw("annotations") {
                        try p.annotAlters(mut &s, false)
                        return Ok(s)
                    }
                    // REBUILD [ONLINE], COALESCE, [NO]PARALLEL [n], [NO]LOGGING: done to an index that is there, nothing to do (no alters)
                    if p.acceptKw("rebuild") || p.acceptKw("coalesce") || p.acceptKw("parallel") || p.acceptKw("noparallel") || p.acceptKw("logging") || p.acceptKw("nologging") {
                        while p.peek().kind == T_IDENT || p.peek().kind == T_NUM { p.pos += 1 }
                        return Ok(s)
                    }
                    if !p.isKw("rename") { return Err(lexdb_base.err("0A000", "lexdb: ALTER INDEX takes RENAME TO, ANNOTATIONS, REBUILD, COALESCE, [NO]PARALLEL and [NO]LOGGING only")) }
                }
                if !p.acceptKw("rename") {
                    return Err(lexdb_base.err("0A000", &("lexdb: ALTER " + (if idx { "INDEX" } else { "SCHEMA" }) + " takes RENAME TO only")))
                }
                try p.expectKw("to")
                append(mut &s.alters, lexdb_sql.alterOf(A_RENAME, &(try p.name())))
                return Ok(s)
            }
            return Err(lexdb_base.err("0A000", "only ALTER TABLE, ALTER INDEX and ALTER SCHEMA are supported"))
        }
        "call" {
            if p.tsql || p.ora { return Err(near(&t)) }         // (T-SQL's is EXEC, Oracle's is its own)
            return p.callStmt()
        }
        "update" { return p.update() }
        "delete" { return p.delete() }
        "merge" { return p.merge() }
        "truncate" { return p.truncate() }
        "rename" {
            // Oracle's RENAME old TO new: a table, view or sequence (design/lexdb-dialect-gaps.md, package B)
            if !p.ora { return Err(near(&t)) }
            var s = lexdb_sql.newStmt(S_ALTER)
            s.mdialect = MD_ORA
            s.alter = true                  // (RENAME, not ALTER TABLE ... RENAME TO: a view's too)
            s.table = try p.rname()
            try p.expectKw("to")
            let to = try p.name()
            var a = lexdb_sql.alterOf(A_RENAME, &to)
            a.col.spell = p.spelled.clone()
            append(mut &s.alters, a)
            return Ok(s)
        }
        "vacuum", "analyze", "analyse", "checkpoint", "reindex", "cluster" { return p.maint(&t.text) }
        "copy" { return p.copyStmt() }
        "create" {
            // CREATE OR REPLACE (PostgreSQL, Oracle) and CREATE OR ALTER (T-SQL) each take their own
            // dialect's keyword: the other's is a syntax error, as the server gives it
            var orReplace = false
            if p.isKw("or") {
                let w = p.peekAt(1).clone()
                let tsqlReplaceGraph = p.tsql && w.text == "replace" && p.peekAt(2).kind == T_IDENT && p.peekAt(2).text == "property" &&
                                       p.peekAt(3).kind == T_IDENT && p.peekAt(3).text == "graph"
                if w.kind == T_IDENT && ((p.tsql && w.text == "alter") || (!p.tsql && w.text == "replace") || tsqlReplaceGraph) {
                    p.pos += 2
                    orReplace = true
                    if p.ora && p.isKw("force") {
                        return Err(lexdb_base.err("0A000", "lexdb: CREATE OR REPLACE FORCE VIEW (a view with errors) is not supported"))
                    }
                    if p.ora && p.isKw("noforce") { p.pos += 1 }
                    if !p.isKw("view") && !p.isKw("temp") && !p.isKw("temporary") && !p.isKw("function") && !p.isKw("procedure") && !p.graphNext() {
                        // the kinds the dialect's server has OR ALTER | OR REPLACE for, lexdb not yet; for any other kind
                        // the server's syntax error (Oracle's: ORA-00922, missing or invalid option)
                        let kind = p.peek().text.clone()
                        let has = if p.tsql { ["procedure", "proc", "function", "trigger"] }
                                  else if p.ora { ["procedure", "function", "package", "trigger", "synonym", "type", "editionable", "noneditionable", "public"] }
                                  else { ["function", "procedure", "trigger", "rule", "language", "aggregate", "transform", "constraint"] }
                        var found = false
                        for h in has { if h == kind { found = true } }
                        if !found { return Err(if p.ora { lexdb_base.err("ORA00922", "missing or invalid option") } else { near(&p.peek()) }) }
                        let how = if p.tsql { "ALTER" } else { "REPLACE" }
                        return Err(lexdb_base.err("0A000", &("lexdb: CREATE OR " + how + " " + strings.toUpperAscii(&kind) +
                                                             " is not supported yet (CREATE OR " + how + " takes a view)")))
                    }
                } else if p.ora {
                    return Err(lexdb_base.err("ORA02000", "missing REPLACE keyword"))
                } else {
                    return Err(near(&w))
                }
            }
            if p.isKw("function") || p.isKw("procedure") {
                let proc = p.next().text == "procedure"
                return p.createRoutine(orReplace, proc)
            }
            if p.graphNext() { return p.createGraph(orReplace) }
            if p.isKw("assertion") { return p.assertStmt("create") }
            if !orReplace && p.acceptKw("materialized") { return p.createMview() }
            // [GLOBAL | LOCAL] {TEMPORARY | TEMP}, or UNLOGGED (a table as any:
            // lexdb's are logged), before TABLE, SEQUENCE or VIEW (9.96)
            var temp = false
            if p.isKw("global") || p.isKw("local") {
                p.pos += 1
                if !p.acceptKw("temporary") { try p.expectKw("temp") }
                temp = true
            } else if p.acceptKw("temporary") || p.acceptKw("temp") {
                temp = true
            } else if !orReplace && p.isKw("unlogged") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "table" {
                p.pos += 1
            }
            if p.acceptKw("view") {
                var v = try p.createView(orReplace, false)
                v.temp = temp
                return Ok(v)
            }
            if orReplace && temp { return Err(near(&p.peek())) }
            if p.acceptKw("table") {
                var ct = try p.createTable()
                ct.temp = temp
                return Ok(ct)
            }
            if temp {
                if !p.acceptKw("sequence") { return Err(near(&p.peek())) }
                var q = try p.seqStmt(S_CREATE_SEQ)
                q.temp = true
                return Ok(q)
            }
            if p.acceptKw("type") {
                // CREATE TYPE name AS ENUM ('a', ...) (9.90)
                var ty = lexdb_sql.newStmt(S_CREATE_TYPE)
                let nameAt = p.peek().at
                ty.table = try p.qname()
                ty.spell = p.spelled.clone()
                let nameEnd = p.peek().at
                try p.expectKw("as")
                if p.tsql && p.isKw("table") {
                    // T-SQL: CREATE TYPE name AS TABLE (columns and constraints), a table type
                    // (design/lexdb-tds.md, "As built: table-valued parameters"): its definition
                    // read as CREATE TABLE's, and kept as its text (in index; the name as written in
                    // alias, "table" in names)
                    p.pos += 1
                    let open = p.peek().at
                    var body = try p.tableBody(lexdb_sql.newStmt(S_CREATE))
                    if body.onCommit != ONC_NONE { return Err(near(&p.toks[p.pos - 1])) }
                    let last = &p.toks[p.pos - 1]
                    ty.index = p.src[open..last.at + 1].toStr()
                    ty.alias = strings.trim(&p.src[nameAt..min(nameEnd, len(p.src))]).toStr()
                    ty.names = ["table"]
                    ty.cols = replace(mut &body.cols, [])
                    return Ok(ty)
                }
                if !p.acceptKw("enum") { return Err(lexdb_base.err("0A000", "lexdb: CREATE TYPE supports AS ENUM only")) }
                try p.expectKw("(")
                if !p.acceptKw(")") {
                    while true {
                        let v = p.next()
                        if v.kind != T_STR { return Err(near(&v)) }
                        append(mut &ty.names, v.text.clone())
                        if !p.acceptKw(",") { break }
                    }
                    try p.expectKw(")")
                }
                return Ok(ty)
            }
            if p.isKw("role") || p.isKw("user") {
                let user = p.next().text == "user"
                var r = lexdb_sql.newStmt(S_CREATE_ROLE)
                r.table = try p.name()
                if user { append(mut &r.names, "login") }       // CREATE USER: LOGIN unless NOLOGIN
                try p.roleOptions(mut &r)
                return Ok(r)
            }
            if p.acceptKw("sequence") { return p.seqStmt(S_CREATE_SEQ) }
            if p.acceptKw("schema") {
                var s = lexdb_sql.newStmt(S_CREATE_SCHEMA)
                if p.acceptKw("if") {
                    try p.expectKw("not")
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                // name [AUTHORIZATION role], or AUTHORIZATION role (the schema named for it)
                if p.acceptKw("authorization") {
                    let r = try p.roleSpec()
                    s.table = r.clone()
                    append(mut &s.names, r)
                    return Ok(s)
                }
                s.table = try p.name()
                if p.acceptKw("authorization") { append(mut &s.names, try p.roleSpec()) }
                return Ok(s)
            }
            if p.tsql && (p.isKw("clustered") || p.isKw("nonclustered") ||
                          (p.isKw("unique") && p.peekAt(1).kind == T_IDENT && (p.peekAt(1).text == "clustered" || p.peekAt(1).text == "nonclustered"))) {
                // CREATE [UNIQUE] [CLUSTERED | NONCLUSTERED] INDEX
                let uq = p.acceptKw("unique")
                let cl = p.clusterWord()
                try p.expectKw("index")
                var ci = try p.createIndex(uq)
                ci.cluster = cl
                return Ok(ci)
            }
            if p.acceptKw("skipping") {
                try p.expectKw("index")
                return p.createSkippingIndex()
            }
            if p.acceptKw("index") { return p.createIndex(false) }
            if p.acceptKw("unique") {
                try p.expectKw("index")
                return p.createIndex(true)
            }
            // a kind of object lexdb does not make yet, or not an object kind at all
            let kind = p.peek().text.clone()
            if p.peek().kind == T_IDENT && lexdb_base.hasStr(&["procedure", "proc", "function", "trigger", "synonym", "domain", "extension", "aggregate",
                                                                "operator", "rule", "policy", "publication", "subscription", "tablespace", "database",
                                                                "materialized", "foreign", "event", "language", "cast", "collation", "conversion",
                                                                "statistics", "default", "login", "package", "global", "private", "public", "edition"], &kind) {
                return Err(lexdb_base.err("0A000", &("lexdb: CREATE " + strings.toUpperAscii(&kind) + " is not supported yet (CREATE makes tables, views, " +
                                                     "indexes, schemas, sequences, types, roles and users)")))
            }
            return Err(near(&p.peek()))
        }
        "explain" {
            var s = lexdb_sql.newStmt(S_EXPLAIN)
            s.ifFlag = p.acceptKw("analyze")        // EXPLAIN ANALYZE: run it and count
            var inner = try p.statement()
            inner.subs = replace(mut &p.subs, [])
            inner.wins = replace(mut &p.wins, [])
            inner.params = p.params
            if s.ifFlag && inner.kind != S_SELECT {
                return Err(lexdb_base.err("0A000", "EXPLAIN ANALYZE takes SELECT"))
            }
            if inner.kind != S_SELECT && inner.kind != S_UPDATE && inner.kind != S_DELETE && inner.kind != S_MERGE {
                return Err(lexdb_base.err("0A000", "EXPLAIN takes SELECT, UPDATE, DELETE or MERGE"))
            }
            append(mut &s.inner, inner)
            return Ok(s)
        }
        "refresh" {
            return p.refreshMview()
        }
        "drop" {
            if p.tsql && p.isKw("routine") { return Err(lexdb_base.err("TS343", "Unknown object type 'ROUTINE' used in a CREATE, DROP, or ALTER statement.")) }
            if p.isKw("function") || p.isKw("procedure") || (!p.tsql && p.isKw("routine")) || (p.tsql && p.isKw("proc")) {
                var kw = p.next().text
                if kw == "proc" { kw = "procedure" }
                return p.dropRoutine(&kw)
            }
            if p.graphNext() { return p.dropGraph() }
            if p.isKw("assertion") { return p.assertStmt("drop") }
            if p.acceptKw("materialized") { return p.dropMview() }
            if p.acceptKw("view") {
                var v = lexdb_sql.newStmt(S_DROP_VIEW)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    v.ifFlag = true
                }
                while true {
                    append(mut &v.cols, lexdb_sql.colDef(&(try p.rname()), TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
                    if !p.acceptKw(",") { break }
                }
                if p.acceptKw("cascade") { v.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(v)
            }
            if p.acceptKw("role") || p.acceptKw("user") {
                var r = lexdb_sql.newStmt(S_DROP_ROLE)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    r.ifFlag = true
                }
                append(mut &r.cols, lexdb_sql.colDef(&(try p.name()), TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
                while p.acceptKw(",") {
                    append(mut &r.cols, lexdb_sql.colDef(&(try p.name()), TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}, false))
                }
                return Ok(r)
            }
            let isSkipDrop = p.acceptKw("skipping")
            if isSkipDrop || p.acceptKw("index") {
                if isSkipDrop { try p.expectKw("index") }
                var s = lexdb_sql.newStmt(S_DROP_INDEX)
                if isSkipDrop { s.skipMethod = "skip" }
                s.conc = p.acceptKw("concurrently")
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                // T-SQL: DROP INDEX name ON table, or table.name (the index is its table's: lexdb_ixname); spells: table.index as
                // written (SQL Server's 3701 and 3723 name it so); a bare name is 159
                let at0 = p.peek().at
                if p.tsql && !(p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "." {
                    s.mdialect = MD_TSQL
                    var parts: []str = [try p.name()]
                    while p.acceptKw(".") { append(mut &parts, try p.name()) }
                    append(mut &s.spells, lexdb_sql.writtenName(&p.src[at0..min(p.peek().at, len(p.src))]))
                    let n = len(parts)
                    s.table = if n >= 3 { lexdb_sql.qual(&parts[n - 3], &parts[n - 2]) } else { parts[0].clone() }
                    if n >= 3 && parts[n - 3] == "dbo" { s.table = parts[n - 2].clone() }
                    s.index = lexdb_sql.qual(&lexdb_sql.schemaOf(&s.table), &parts[n - 1])
                    return Ok(s)
                }
                s.index = try p.qname()
                let ixWritten = lexdb_sql.writtenName(&p.src[at0..min(p.peek().at, len(p.src))])
                if p.tsql && !isSkipDrop && !p.isKw("on") { return Err(lexdb_base.err("TS159", "Must specify the table name and index name for the DROP INDEX statement.")) }
                if p.tsql && p.acceptKw("on") {
                    s.mdialect = MD_TSQL
                    let at1 = p.peek().at
                    s.table = try p.qname()
                    append(mut &s.spells, lexdb_sql.writtenName(&p.src[at1..min(p.peek().at, len(p.src))]) + "." + ixWritten)
                    s.index = lexdb_sql.qual(&lexdb_sql.schemaOf(&s.table), &lexdb_sql.baseName(&s.index))
                }
                return Ok(s)
            }
            if p.acceptKw("type") {
                var s = lexdb_sql.newStmt(S_DROP_TYPE)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                // (T-SQL: each name as written in spells, for SQL Server's messages)
                var at = p.peek().at
                s.table = try p.qname()
                if p.tsql { append(mut &s.spells, strings.trim(&p.src[at..min(p.peek().at, len(p.src))]).toStr()) }
                while p.acceptKw(",") {
                    at = p.peek().at
                    append(mut &s.names, try p.qname())
                    if p.tsql { append(mut &s.spells, strings.trim(&p.src[at..min(p.peek().at, len(p.src))]).toStr()) }
                }
                if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(s)
            }
            if p.acceptKw("sequence") {
                var s = lexdb_sql.newStmt(S_DROP_SEQ)
                s.mdialect = p.md()
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.table = try p.qname()
                // DROP SEQUENCE a, b, ...: the others in names (9.117)
                while p.acceptKw(",") { append(mut &s.names, try p.qname()) }
                if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(s)
            }
            if p.acceptKw("schema") {
                var s = lexdb_sql.newStmt(S_DROP_SCHEMA)
                if p.acceptKw("if") {
                    try p.expectKw("exists")
                    s.ifFlag = true
                }
                s.table = try p.name()
                if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
                return Ok(s)
            }
            try p.expectKw("table")
            var s = lexdb_sql.newStmt(S_DROP)
            if p.acceptKw("if") {
                try p.expectKw("exists")
                s.ifFlag = true
            }
            s.table = try p.rname()
            // DROP TABLE a, b, ...: the others in names (9.88)
            while p.acceptKw(",") { append(mut &s.names, try p.rname()) }
            if p.acceptKw("cascade") {
                s.cascade = true
                if p.ora { let cc = p.acceptKw("constraints") }
            } else { let r = p.acceptKw("restrict") }
            if p.ora { let pu = p.acceptKw("purge") }
            return Ok(s)
        }
        "begin", "start" {
            if t.text == "start" { try p.expectKw("transaction") } else {
                let a = p.acceptKw("transaction") || p.acceptKw("work")
            }
            // READ ONLY makes a snapshot; ISOLATION LEVEL selects READ COMMITTED
            // or SERIALIZABLE (REPEATABLE READ maps to SERIALIZABLE, READ UNCOMMITTED to READ COMMITTED).
            var b = lexdb_sql.newStmt(S_BEGIN)
            while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") {
                if p.acceptKw("read") {
                    if p.acceptKw("only") { b.ifFlag = true } else if p.acceptKw("write") { b.names = ["read write"] }
                } else if p.acceptKw("isolation") {
                    let lv = p.acceptKw("level")
                    if p.acceptKw("read") {
                        if p.acceptKw("committed") || p.acceptKw("uncommitted") { b.table = "read committed" }
                    } else if p.acceptKw("serializable") {
                        b.table = "serializable"
                    } else if p.acceptKw("repeatable") {
                        let rr = p.acceptKw("read")
                        b.table = "serializable"
                    }
                } else {
                    p.pos += 1
                }
            }
            return Ok(b)
        }
        "commit", "end" {
            let a = p.acceptKw("transaction") || p.acceptKw("work")
            return Ok(lexdb_sql.newStmt(S_COMMIT))
        }
        "rollback", "abort" {
            let a = p.acceptKw("transaction") || p.acceptKw("work")
            if t.text == "rollback" && p.acceptKw("to") {
                let sp = p.acceptKw("savepoint")
                var r = lexdb_sql.newStmt(S_ROLLBACK_TO)
                r.table = try p.name()
                return Ok(r)
            }
            return Ok(lexdb_sql.newStmt(S_ROLLBACK))
        }
        "savepoint" {
            var r = lexdb_sql.newStmt(S_SAVEPOINT)
            r.table = try p.name()
            return Ok(r)
        }
        "release" {
            let sp = p.acceptKw("savepoint")
            var r = lexdb_sql.newStmt(S_RELEASE)
            r.table = try p.name()
            return Ok(r)
        }
        "grant", "revoke" { return p.grantStmt(t.text == "grant") }
        "show" {
            var st = lexdb_sql.newStmt(S_SHOW)
            if p.acceptKw("all") { st.table = "all" } else {
                st.table = try p.name()
                if p.acceptKw(".") { st.table = st.table + "." + (try p.name()) }   // a custom setting (9.92)
            }
            if st.table == "transaction" { st.table = "transaction_isolation" }   // SHOW TRANSACTION ISOLATION LEVEL
            if st.table == "time" && p.acceptKw("zone") { st.table = "timezone" }  // SHOW TIME ZONE
            p.skipToEnd()
            return Ok(st)
        }
        "set", "reset", "discard", "deallocate" {
            // lexdb's own settings (SETTINGS): SET name = value | TO value |
            // = DEFAULT, RESET name, RESET ALL; the rest are accepted and ignored
            var st = lexdb_sql.newStmt(S_SET)
            st.ifFlag = t.text == "reset"
            if t.text == "discard" {
                // DISCARD ALL | TEMP | TEMPORARY | PLANS | SEQUENCES (9.96): table
                // "discard:" and what
                let w = p.next()
                if w.kind != T_IDENT || (w.text != "all" && w.text != "temp" && w.text != "temporary" && w.text != "plans" && w.text != "sequences") {
                    return Err(near(&w))
                }
                st.table = "discard:" + (if w.text == "temporary" { "temp" } else { w.text.clone() })
                return Ok(st)
            }
            let u = p.acceptKw("session")
            if t.text == "reset" && p.acceptKw("all") {
                st.table = "all"
                return Ok(st)
            }
            // SET [SESSION | LOCAL] TIME ZONE value | LOCAL | DEFAULT, SET [SESSION | LOCAL]
            // timezone = | TO value | DEFAULT, RESET timezone, RESET TIME ZONE (9.95):
            // table "timezone", the value in names ("\x01": the default), then "local"
            var tzAt = p.pos
            let tzLocal = t.text == "set" && p.isKw("local")
            if tzLocal { tzAt += 1 }
            let tzWords = p.toks[tzAt].kind == T_IDENT && p.toks[tzAt].text == "time" && p.toks[tzAt + 1].kind == T_IDENT &&
                          p.toks[tzAt + 1].text == "zone"
            if (t.text == "set" || t.text == "reset") &&
               (tzWords || ((p.toks[tzAt].kind == T_IDENT || p.toks[tzAt].kind == T_QIDENT) && strings.toLowerAscii(&p.toks[tzAt].text) == "timezone")) {
                p.pos = tzAt + (if tzWords { 2 } else { 1 })
                st.table = "timezone"
                if t.text == "reset" { return Ok(st) }
                if !tzWords && !p.acceptKw("to") { try p.expectKw("=") }
                append(mut &st.names, try p.zoneValue(tzWords))
                if tzLocal { append(mut &st.names, "local") }
                return Ok(st)
            }
            // SET [SESSION] ROLE name | NONE, RESET ROLE, SET SESSION AUTHORIZATION name |
            // DEFAULT, RESET SESSION AUTHORIZATION (9.83): the role in names, none for NONE and DEFAULT
            if p.isKw("role") || p.isKw("authorization") {
                st.table = if p.next().text == "role" { "role" } else { "session_authorization" }
                if t.text == "set" {
                    let eq = p.acceptKw("to") || p.acceptKw("=")
                    if !p.acceptKw("none") && !p.acceptKw("default") {
                        let v = p.peek().clone()
                        if v.kind == T_STR { p.pos += 1; append(mut &st.names, v.text.clone()) } else { append(mut &st.names, try p.name()) }
                    }
                }
                return Ok(st)
            }
            // SET CONSTRAINTS ALL | name, ... DEFERRED | IMMEDIATE (9.85):
            // table "constraints:deferred" or ":immediate", the names in
            // names (none for ALL)
            if t.text == "set" && (p.acceptKw("constraints") || (p.ora && p.acceptKw("constraint"))) {
                if !p.acceptKw("all") {
                    append(mut &st.names, try p.qname())
                    while p.acceptKw(",") { append(mut &st.names, try p.qname()) }
                }
                if p.acceptKw("deferred") { st.table = "constraints:deferred" } else {
                    try p.expectKw("immediate")
                    st.table = "constraints:immediate"
                }
                return Ok(st)
            }
            if t.text == "set" && p.acceptKw("schema") {
                // SET SCHEMA 'x': the search path x
                st.table = "search_path"
                let v = p.peek().clone()
                if v.kind == T_STR { p.pos += 1; append(mut &st.names, v.text.clone()) } else { append(mut &st.names, try p.name()) }
                return Ok(st)
            }
            // SET [SESSION CHARACTERISTICS AS] TRANSACTION ISOLATION LEVEL ...
            let txChar = t.text == "set" && p.acceptKw("characteristics")
            if txChar {
                let asKw = p.acceptKw("as")
            }
            if t.text == "set" && p.acceptKw("transaction") {
                // its modes, in any order, with or without commas: ISOLATION LEVEL x (limit), READ ONLY | READ WRITE (names; SET
                // TRANSACTION's only: the session's default is not kept), [NOT] DEFERRABLE (read)
                var iso = ""
                while true {
                    if p.acceptKw("isolation") {
                        let lv = p.acceptKw("level")
                        if p.acceptKw("read") {
                            if p.acceptKw("committed") || p.acceptKw("uncommitted") { iso = "read committed" }
                        } else if p.acceptKw("serializable") {
                            iso = "serializable"
                        } else if p.acceptKw("repeatable") {
                            let rr = p.acceptKw("read")
                            iso = "serializable"
                        }
                    } else if p.acceptKw("read") {
                        if p.acceptKw("only") { st.names = ["read only"] } else if p.acceptKw("write") { st.names = ["read write"] }
                    } else if p.acceptKw("not") || p.acceptKw("deferrable") {
                        let d = p.acceptKw("deferrable")
                    } else if !p.acceptKw(",") {
                        break
                    }
                }
                if len(iso) > 0 || len(st.names) > 0 {
                    st.table = if txChar { "default_transaction_isolation" } else { "transaction_isolation" }
                    if len(iso) > 0 { st.limit = Some(Expr.Lit(Val.Text(iso))) }
                }
                p.skipToEnd()
                return Ok(st)
            }
            if (t.text == "set" || t.text == "reset") && p.isKw("default_transaction_read_only") {
                // the session's default: the same statement as SET SESSION CHARACTERISTICS AS TRANSACTION READ ONLY | READ WRITE
                p.pos += 1
                st.table = "default_transaction_isolation"
                st.names = ["read write"]
                if t.text == "set" && !p.acceptKw("default") {
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    let v = p.next()
                    let w = strings.toLowerAscii(&v.text)
                    if w == "on" || w == "true" || w == "yes" || w == "1" { st.names = ["read only"] }
                    else if !(w == "off" || w == "false" || w == "no" || w == "0") {
                        return Err(lexdb_base.err("22023", "parameter \"default_transaction_read_only\" requires a Boolean value"))
                    }
                }
                return Ok(st)
            }
            var known = p.isKw("default_transaction_isolation") || p.isKw("transaction_isolation")
            for name in lexdb_sql.settingsList() { if p.isKw(&name) { known = true } }
            if known && (t.text == "set" || t.text == "reset") {
                st.table = p.toks[p.pos].text.clone()
                p.pos += 1
                if t.text == "set" && st.table == "search_path" {
                    // a list of schemas, names or strings ('a, b' splits too); DEFAULT
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    if p.acceptKw("default") { return Ok(st) }
                    while true {
                        let v = p.peek().clone()
                        if v.kind == T_STR {
                            p.pos += 1
                            for part in strings.split(&v.text, ",") {
                                var x = strings.trim(part)
                                if len(x) >= 2 && x[0] == '"' && x[len(x) - 1] == '"' { x = x[1..len(x) - 1].clone() }
                                if len(x) > 0 { append(mut &st.names, x) }
                            }
                        } else {
                            append(mut &st.names, try p.name())
                        }
                        if !p.acceptKw(",") { break }
                    }
                    if len(st.names) == 0 { return Err(lexdb_base.err("22023", "search_path names no schema")) }
                    return Ok(st)
                }
                if t.text == "set" && (st.table == "lexdb_batch" || st.table == "lexdb_planner" || st.table == "lexdb_autoanalyze" || st.table == "lexdb_range_delete" || st.table == "query_rewrite_enabled") {
                    // lexdb_batch: on, off, true, false, 1, 0, a string of one of
                    // them, DEFAULT; lexdb_planner: cost, rules (optimizer 20), a word or a string
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    let v = p.peek().clone()
                    if v.kind == T_EOF { return Err(near(&v)) }
                    p.pos += 1
                    if v.text != "default" { st.limit = Some(Expr.Lit(Val.Text(v.text.clone()))) }
                    return Ok(st)
                }
                if t.text == "set" {
                    if !p.acceptKw("to") { try p.expectKw("=") }
                    if p.acceptKw("default") { st.limit = None } else { st.limit = Some(try p.expr()) }
                }
                return Ok(st)
            }
            // a custom setting, a dot in its name (9.92): SET [LOCAL] a.b = value | TO value
            // | DEFAULT, RESET a.b: the name in table, the value in names (then
            // "local")
            var at = p.pos
            let local = t.text == "set" && p.isKw("local")
            if local { at += 1 }
            if (t.text == "set" || t.text == "reset") && (p.toks[at].kind == T_IDENT || p.toks[at].kind == T_QIDENT) &&
               p.toks[at + 1].kind == T_OP && p.toks[at + 1].text == "." && (p.toks[at + 2].kind == T_IDENT || p.toks[at + 2].kind == T_QIDENT) {
                p.pos = at + 3
                st.table = p.toks[at].text + "." + p.toks[at + 2].text
                if t.text == "reset" { return Ok(st) }
                if !p.acceptKw("to") { try p.expectKw("=") }
                if p.acceptKw("default") {
                    st.ifFlag = true
                    return Ok(st)
                }
                var vals: []str = []
                while true {
                    let v = p.next()
                    if v.kind == T_EOF || (v.kind == T_OP && v.text != "-") { return Err(near(&v)) }
                    if v.kind == T_OP {
                        let w = p.next()
                        append(mut &vals, "-" + w.text)
                    } else {
                        append(mut &vals, v.text.clone())
                    }
                    if !p.acceptKw(",") { break }
                }
                append(mut &st.names, strings.join(&vals, ", "))
                if local { append(mut &st.names, "local") }
                return Ok(st)
            }
            p.skipToEnd()
            return Ok(st)
        }
        "wait" {
            if !p.tsql && !p.ora {
                if p.isKw("for") { return p.waitLsn() }
                return Err(near(&p.peek()))
            }
        }
        else {}
    }
    return Err(near(&t))
}

// WAIT FOR LSN 'lsn' [WITH (option [value], ...)] (PostgreSQL 19; lexdb.md
// 9.137), after WAIT: a SHOW of lexdb_sql.WAIT_LSN (it gives one row and
// runs outside any transaction, as SHOW does), the LSN's text and each
// option ("mode=v", "timeout=v", "no_throw=v", lower case) in names. The
// options are checked when it runs, as PostgreSQL does.
fn (p: mut &P) waitLsn(): Result[Stmt, lexdb_base.DbErr] {
    try p.expectKw("for")
    try p.expectKw("lsn")
    let l = p.next()
    if l.kind != T_STR { return Err(near(&l)) }
    var st = lexdb_sql.newStmt(S_SHOW)
    st.table = lexdb_sql.WAIT_LSN.clone()
    append(mut &st.names, l.text.clone())
    if p.acceptKw("with") {
        try p.expectKw("(")
        while true {
            let o = p.next()
            if o.kind != T_IDENT { return Err(near(&o)) }
            var v = "\x00"                                  // none: a boolean option's true
            let x = p.peek().clone()
            if x.kind == T_STR || x.kind == T_NUM || x.kind == T_IDENT {
                p.pos += 1
                v = strings.toLowerAscii(&x.text)
            } else if x.kind == T_OP && (x.text == "-" || x.text == "+") && p.peekAt(1).kind == T_NUM {
                p.pos += 2
                v = x.text + p.toks[p.pos - 1].text
            }
            append(mut &st.names, o.text + "=" + v)
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    }
    return Ok(st)
}

// SET TIME ZONE's value (9.95): a string, a name, a number (an offset in
// hours: "-5"), INTERVAL '...' [unit [TO unit]] ("INTERVAL '...'", a bare
// number given its unit), DEFAULT; LOCAL after TIME ZONE. "\x01": the
// default.
fn (p: mut &P) zoneValue(words: bool): Result[str, lexdb_base.DbErr] {
    if p.acceptKw("default") || (words && p.acceptKw("local")) { return Ok("\x01") }
    if p.acceptKw("interval") {
        let v = p.next()
        if v.kind != T_STR { return Err(near(&v)) }
        var body = v.text.clone()
        var unit = ""
        for u in ["year", "month", "day", "hour", "minute", "second"] { if unit == "" && p.acceptKw(&u) { unit = u } }
        var last = unit.clone()
        if unit != "" && p.acceptKw("to") {
            let u2 = p.next()
            if u2.kind != T_IDENT { return Err(near(&u2)) }
            last = u2.text.clone()
        }
        var bare = len(body) > 0
        for i in 0..len(body) { if !((body[i] >= '0' && body[i] <= '9') || body[i] == '.' || body[i] == '-' || body[i] == '+' || body[i] == ' ') { bare = false } }
        if bare && unit != "" { body = body + " " + unit }
        // the qualifier's last unit cuts what is below it (HOUR TO MINUTE: no seconds)
        return Ok("INTERVAL '" + body + "'" + (if last == "hour" || last == "minute" { " " + last } else { "" }))
    }
    let v = p.next()
    if v.kind == T_STR || v.kind == T_IDENT || v.kind == T_QIDENT || v.kind == T_NUM { return Ok(v.text.clone()) }
    if v.kind == T_OP && (v.text == "-" || v.text == "+") {
        let n = p.next()
        if n.kind != T_NUM { return Err(near(&n)) }
        return Ok(v.text + n.text)
    }
    return Err(near(&v))
}

// Whether an Oracle TIMESTAMP literal's text ends in a time zone: +hh:mm, -hh:mm or a name (Europe/Paris, UTC).
// CAST(e AS t) in the Oracle door: a TIMESTAMP WITH TIME ZONE reads its text as TO_TIMESTAMP_TZ does (the session's NLS
// format, the zone it names, Oracle's errors for a bad one), then takes the type's fractional digits.
fn (p: &P) oraCast(e: Expr, ty: TypeName): Expr {
    if lexdb_sql.isTszType(&ty) { return Expr.Cast(Expr.Call("#ora_totstz", [e], false), ty) }
    // a date, timestamp or timestamp with a time zone as text is TO_CHAR's: the session's NLS format
    if ty.kind == K_TEXT && ty.oid != OID_BPCHAR {
        if len(p.nls) >= 3 { return Expr.Cast(Expr.Call("#ora_tochar1", [e, Expr.Lit(Val.Text(p.nls[0].clone())), Expr.Lit(Val.Text(p.nls[1].clone())), Expr.Lit(Val.Text(p.nls[2].clone()))], false), ty) }
        return Expr.Cast(Expr.Call("#ora_tochar", [e], false), ty)
    }
    return Expr.Cast(e, ty)
}

fn oraLitZone(s: &str): bool {
    let sp = strings.lastIndexOf(s, " ")
    if sp < 0 { return false }
    let tail = strings.trim(&s[sp + 1..len(s)])
    if len(tail) == 0 { return false }
    if (tail[0] == '+' || tail[0] == '-') && len(tail) > 1 && tail[1] >= '0' && tail[1] <= '9' { return true }
    return (tail[0] >= 'A' && tail[0] <= 'Z') || (tail[0] >= 'a' && tail[0] <= 'z')
}

// The name of a name => value argument, consumed ("" a positional argument).
fn (p: mut &P) namedArg(): str {
    if (p.peek().kind == T_IDENT) && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "=" && p.peekAt(2).kind == T_OP && p.peekAt(2).text == ">" &&
       p.peekAt(2).at == p.peekAt(1).at + 1 {
        let n = p.peek().text.clone()
        p.pos += 3
        return n
    }
    return ""
}

fn anyNamed(names: &[]str): bool {
    for n in names { if len(n) > 0 { return true } }
    return false
}

// Oracle's name => value arguments of a call (of a stored function: lexdb_plcall resolves them): each named one marked, #named(NAME, x).
fn oraNamed(args: []Expr, names: &[]str): []Expr {
    var out: []Expr = []
    var xs = args
    for i in 0..len(xs) {
        let x = replace(mut &xs[i], Expr.Lit(Val.Null))
        if i < len(names) && len(names[i]) > 0 { append(mut &out, Expr.Call("#named", [Expr.Lit(Val.Text(strings.toUpperAscii(&names[i]))), x], false)) } else { append(mut &out, x) }
    }
    return out
}

// The functions with named parameters (PostgreSQL's name => value notation), their parameters' names in order and
// the defaults of those a call may leave out ("" none).
fn paramsOf(fname: &str): []str {
    match fname {
        "make_interval" { return ["years", "months", "weeks", "days", "hours", "mins", "secs"] }
        else { return [] }
    }
}

// A call's arguments in the parameters' order, the named ones put where they belong; a parameter left out is 0.
fn namedArgs(fname: &str, args: []Expr, names: &[]str): Result[[]Expr, lexdb_base.DbErr] {
    var named = false
    for n in names { if len(n) > 0 { named = true } }
    let ps = paramsOf(fname)
    if len(ps) == 0 {
        if named { return Err(lexdb_base.err("42883", &("function " + fname + " does not accept named arguments"))) }
        return Ok(args)
    }
    var out: []Expr = []
    var set: []bool = []
    for i in 0..len(ps) {
        append(mut &out, Expr.Lit(Val.Int(0)))
        append(mut &set, false)
    }
    var xs = args
    var pos = 0
    var seenNamed = false
    for i in 0..len(xs) {
        if i >= len(names) || len(names[i]) == 0 {
            if seenNamed { return Err(lexdb_base.err("42601", "positional argument cannot follow named argument")) }
            if pos >= len(ps) { return Err(lexdb_base.err("42883", &("function " + fname + " does not exist"))) }
            out[pos] = replace(mut &xs[i], Expr.Lit(Val.Null))
            set[pos] = true
            pos += 1
        } else {
            seenNamed = true
            var at = -1
            for k in 0..len(ps) { if ps[k] == names[i] { at = k } }
            if at < 0 { return Err(lexdb_base.err("42883", &("function " + fname + " does not exist"))) }
            if set[at] { return Err(lexdb_base.err("42883", &("argument name \"" + names[i] + "\" used more than once"))) }
            out[at] = replace(mut &xs[i], Expr.Lit(Val.Null))
            set[at] = true
        }
    }
    return Ok(out)
}

// Skips the rest of a statement (the options of BEGIN, a SET's value).
fn (p: mut &P) skipToEnd() {
    while p.peek().kind != T_EOF && !(p.peek().kind == T_OP && p.peek().text == ";") { p.pos += 1 }
}

// Parses SQL text into its statements (separated by ;). params is the
// highest $n in each.

// A view's query, from its text as kept (TSQL_VIEW: T-SQL).
pub fn parseView(kept: &str): Result[[]Stmt, lexdb_base.DbErr] {
    let text = lexdb_sql.viewKept(kept)
    if strings.startsWith(&text, ORA_VIEW) { return oraParse(&text[len(ORA_VIEW)..len(text)]) }
    if !strings.startsWith(&text, TSQL_VIEW) { return parse(&text) }
    var q = try tsqlParser(&text[len(TSQL_VIEW)..len(text)], Dialect{tsql: true, quotedIdent: true}, &[])
    let st = try q.statement()
    return Ok([st])
}


pub fn parse(sql: &str): Result[[]Stmt, lexdb_base.DbErr] { return parseIn(sql, false, []) }

// SQL text as Oracle's dialect reads it (design/lexdb-oracle.md section 7).
pub fn oraParse(sql: &str): Result[[]Stmt, lexdb_base.DbErr] { return parseIn(sql, true, []) }

// oraParse under a session's NLS formats (date, timestamp, timestamp with time zone; "" the default):
// TO_CHAR, TO_DATE and TO_TIMESTAMP with no format follow them.
pub fn oraParseNls(sql: &str, nls: []str): Result[[]Stmt, lexdb_base.DbErr] { return parseIn(sql, true, nls) }

// Where Oracle's SQL text sql has a syntax error (lexdb_plsql: a stored unit's SQL statement, its error at compile time): the token
// the parser stopped at, as its text and how many tokens of that text come before it ("text\x00n"; "\x00eof" at the end), or ""
// when it parses or fails otherwise.
pub fn oraSyntaxAt(sql: &str, nls: []str): str {
    let toks = match lexOra(sql, pgDialect(), true) { Ok(t) { t } Err(_) { return "" } }
    var tk = toks
    oraWordNames(mut &tk)
    var p = P{toks: tk, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0, seqs: [], wins: [], src: sql.toStr(), tsql: false, vars: [], spelled: "", ora: true, rnLimit: -1, nls: nls, mr: 0, udf: false}
    match p.statement() {
        Ok(_) { return "" }
        Err(e) {
            if e.state != "42601" { return "" }
            if strings.contains(&e.msg, "at end of input") { return "\x00eof" }
            let q = strings.indexOf(&e.msg, "near \"", 0)
            if q < 0 { return "" }
            let x = e.msg[q + 6..len(e.msg) - 1].toStr()
            var k = min(p.pos, len(p.toks) - 1)
            while k > 0 && p.toks[k].text != x { k -= 1 }
            if p.toks[k].text != x { return "" }
            var n = 0
            for j in 0..k { if p.toks[j].text == x { n += 1 } }
            return x + "\x00" + n.toStr()
        }
    }
}

// The last of oraParseNls's nls when the session has ALTER SESSION SET group_by_position_enabled = TRUE: a GROUP BY
// position is the select list's item (by default it is a constant, and ORA-03162 if the list needs a grouping).
pub const GB_POS = "#gbpos"


// Oracle's row generator, FROM dual CONNECT BY LEVEL <= n (or < n), as the table function
// generate_series(1, n) with the column LEVEL; any other CONNECT BY is left to fail as unsupported.
fn connectLevel(sql: &str, toks: &[]Tok): Option[str] {
    var i = 0
    while i + 5 < len(toks) {
        let a = &toks[i]
        let b = &toks[i + 1]
        if a.kind == T_IDENT && a.text == "dual" && b.kind == T_IDENT && b.text == "connect" && toks[i + 2].kind == T_IDENT && toks[i + 2].text == "by" &&
           toks[i + 3].kind == T_IDENT && toks[i + 3].text == "level" && toks[i + 4].kind == T_OP && (toks[i + 4].text == "<=" || toks[i + 4].text == "<") {
            var j = i + 5
            var depth = 0
            while j < len(toks) {
                let t = &toks[j]
                if t.kind == T_EOF { break }
                if t.kind == T_OP && t.text == "(" { depth += 1 }
                else if t.kind == T_OP && t.text == ")" {
                    if depth == 0 { break }
                    depth -= 1
                } else if t.kind == T_OP && t.text == ";" && depth == 0 { break }
                else if depth == 0 && t.kind == T_IDENT && (t.text == "order" || t.text == "group" || t.text == "having" || t.text == "union" || t.text == "except" || t.text == "intersect" || t.text == "fetch" || t.text == "offset") { break }
                j += 1
            }
            let from = toks[i + 5].at
            let to = if j < len(toks) { toks[j].at } else { len(sql) }
            if to <= from { return None }
            let ex = sql[from..to].toStr()
            let lim = if toks[i + 4].text == "<" { "(" + ex + ") - 1" } else { ex }
            return Some(sql[0..a.at].toStr() + "generate_series(1, " + lim + ") as dual(level) " + sql[to..len(sql)].toStr())
        }
        i += 1
    }
    return None
}

// Oracle: OFFSET and LIMIT are not reserved words: a name (a column, an alias, a table's alias) where no clause follows,
// that is, but where a number, a bind, a bracket or (OFFSET) a word and ROW / ROWS comes next (LIMIT n is lexdb's own).
// The token is made a quoted name of the same spelling ("OFFSET": Oracle's bare offset).
fn oraWordNames(toks: mut &[]Tok) {
    for i in 0..len(toks) - 1 {
        let t = &toks[i]
        if t.kind != T_IDENT || (t.text != "offset" && t.text != "limit") { continue }
        let nx = &toks[i + 1]
        if nx.kind == T_NUM || nx.kind == T_PARAM || (nx.kind == T_OP && (nx.text == "(" || nx.text == ":" || nx.text == "?")) { continue }
        if t.text == "offset" && nx.kind == T_IDENT && i + 2 < len(toks) && (toks[i + 2].text == "row" || toks[i + 2].text == "rows") { continue }
        toks[i].kind = T_QIDENT
    }
}

fn parseIn(sql0: &str, ora: bool, nls: []str): Result[[]Stmt, lexdb_base.DbErr] {
    var rewritten = ""
    var toks = try lexOra(sql0, pgDialect(), ora)
    if ora {
        match connectLevel(sql0, &toks) {
            Some(r) {
                rewritten = r
                toks = try lexOra(&rewritten, pgDialect(), ora)
            }
            None {}
        }
        oraWordNames(mut &toks)
    }
    let sql = if len(rewritten) > 0 { &rewritten } else { sql0 }
    var p = P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0, seqs: [], wins: [], src: sql.toStr(), tsql: false, vars: [], spelled: "", ora: ora, rnLimit: -1, nls: nls, mr: 0, udf: false}
    var out: []Stmt = []
    while true {
        // (the parser's per-statement state is as P was made: reset after a ";", below, for the next; resetting it here
        // too remade five empty arrays for every statement, a point select's parse about 50 instructions)
        var s = try p.statement()
        s.params = p.params
        s.seqNames = replace(mut &p.seqs, [])
        s.udf = p.udf
        p.udf = false
        if s.kind != S_EXPLAIN {
            s.subs = replace(mut &p.subs, [])
            s.wins = replace(mut &p.wins, [])
        }
        if s.kind == S_SELECT && !s.udf {
            for sub in s.subs { if sub.srf == lexdb_sql.GRAPH_MARK { s.udf = true; break } }
        }
        let t = p.peek().clone()
        if t.kind == T_EOF {
            // CTE uses marked in out, not through mut &s (that cost every
            // statement about 20 instructions: a point select +0.013%)
            if s.kind != S_EMPTY || len(out) == 0 { append(mut &out, s) }
            if p.nextCte > 0 { markCtes(mut &out[len(out) - 1], p.nextCte) }
            break
        }
        if t.kind == T_OP && t.text == ";" {
            p.pos += 1
            if s.kind != S_EMPTY {
                append(mut &out, s)
                if p.nextCte > 0 { markCtes(mut &out[len(out) - 1], p.nextCte) }
            }
            p.params = 0
            p.subs = []
            p.ctes = []
            p.nextCte = 0
            p.inCte = []
            p.depth = 0
            p.seqs = []
            p.wins = []
            continue
        }
        // (Oracle's QUALIFY comes before ORDER BY, FOR UPDATE and the row limit: ORA-03049 after them)
        if ora && t.kind == T_IDENT && t.text == "qualify" { return Err(oraKwErr(&p.src, &t)) }
        return Err(near(&t))
    }
    return Ok(out)
}


// One expression and nothing after it.
pub fn parseExpr(sql: &str): Result[Expr, lexdb_base.DbErr] {
    let raw = try lex(sql)
    // the executor's own functions (#utcnow(), #len(x): T-SQL's, as exprText
    // writes them) are names here, as the text was made by exprText
    var toks: []Tok = []
    var i = 0
    while i < len(raw) {
        let t = &raw[i]
        if t.kind == T_OP && t.text == "#" && i + 2 < len(raw) && raw[i + 1].kind == T_IDENT && raw[i + 1].at == t.at + 1 &&
           raw[i + 2].kind == T_OP && raw[i + 2].text == "(" {
            append(mut &toks, Tok{kind: T_IDENT, text: "#" + raw[i + 1].text, at: t.at, spell: ""})
            i += 2
            continue
        }
        // T-SQL's + (exprText writes it "t+", the operator that joins strings and adds numbers): one token, after an operand
        if t.kind == T_IDENT && t.text == "t" && i + 1 < len(raw) && raw[i + 1].kind == T_OP && raw[i + 1].text == "+" && raw[i + 1].at == t.at + 1 &&
           i > 0 && (raw[i - 1].kind != T_OP || raw[i - 1].text == ")") {
            append(mut &toks, Tok{kind: T_OP, text: "t+", at: t.at, spell: ""})
            i += 2
            continue
        }
        append(mut &toks, t.clone())
        i += 1
    }
    var p = P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0, seqs: [], wins: [], src: sql.toStr(), tsql: false, vars: [], spelled: "", ora: false, rnLimit: -1, nls: [], mr: 0, udf: false}
    let x = try p.expr()
    let t = p.peek().clone()
    if t.kind != T_EOF { return Err(near(&t)) }
    return Ok(x)
}


// ---- T-SQL (design/lexdb-tds.md) inside lexdb's grammar: @variables and
// SQL Server's type names. A batch's own statements (DECLARE, SET, BEGIN
// TRAN, ...) are lexdb_tsqlparse's.

// @name: $k for the k-th variable in scope; SQL Server's error for one not declared.
fn (p: mut &P) variable(t: &Tok): Result[Expr, lexdb_base.DbErr] {
    for k in 0..len(p.vars) {
        if p.vars[k] == t.text {
            if k + 1 > p.params { p.params = k + 1 }
            return Ok(Expr.Param(k + 1))
        }
    }
    if strings.startsWith(&t.text, "@@") {
        // SQL Server's constant ones (@@MICROSOFTVERSION, @@MAX_PRECISION, ...: lexdb_syscat)
        let pr = lexdb_dialect.prop(&"global", &t.text)
        if pr.found { return Ok(propExpr(&pr)) }
        return Err(lexdb_base.err("TS195", &("'" + t.text + "' is not a recognized built-in function name.")))
    }
    return Err(lexdb_base.err("TS137", &("Must declare the scalar variable \"" + t.text + "\".")))
}

// (n) or (max) after a type name: n, 0 for max, -1 when there is none.
fn (p: mut &P) tsqlLen(): Result[int, lexdb_base.DbErr] {
    if !p.acceptKw("(") { return Ok(-1) }
    var n = 0
    if !p.acceptKw("max") { n = try p.intLit() }
    if p.acceptKw(",") { let x = try p.intLit() }
    try p.expectKw(")")
    return Ok(n)
}

// The SQL Server type (its system_type_id, lexdb_dialect.TS_*) a type made
// from a T-SQL type name keeps where lexdb's own does not say it: in prec,
// which a text, integer or binary type does not use (varchar, char, nchar,
// tinyint, varbinary, ...), and which a time type's says its scale is
// given in (1; datetime, smalldatetime). 0 none.
pub fn tsqlCode(t: &TypeName): int {
    if t.kind == K_TEXT || t.kind == K_INT || t.kind == K_BYTEA { return if t.prec >= 34 { t.prec } else { 0 } }
    if lexdb_sql.timeKind(t.oid) > 0 && (t.prec == lexdb_dialect.TS_DATETIME || t.prec == lexdb_dialect.TS_SMALLDATETIME) { return t.prec }
    return 0
}

// SQL Server's type names as lexdb's types; None for a name both share or
// lexdb's own. Lengths are kept for varchar; (max) is text.
fn (p: mut &P) tsqlType(w: &str): Result[Option[TypeName], lexdb_base.DbErr] {
    match w.toStr() {
        "nvarchar", "varchar", "nchar", "char", "sysname" {
            var n = try p.tsqlLen()
            if w == "sysname" { n = 128 }
            // SQL Server's type, where it is not nvarchar's, in prec (tsqlCode)
            let code = if w == "varchar" { lexdb_dialect.TS_VARCHAR } else if w == "char" { lexdb_dialect.TS_CHAR } else if w == "nchar" { lexdb_dialect.TS_NCHAR } else { 0 }
            if n > 0 { return Ok(Some(TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: code, scale: 0, len: n})) }
            return Ok(Some(TypeName{kind: K_TEXT, oid: OID_TEXT, prec: code, scale: 0, len: 0}))
        }
        "ntext", "xml" {
            return Ok(Some(TypeName{kind: K_TEXT, oid: OID_TEXT, prec: if w == "xml" { lexdb_dialect.TS_XML } else { lexdb_dialect.TS_NTEXT }, scale: 0, len: 0}))
        }
        "bit" { return Ok(Some(TypeName{kind: K_BOOL, oid: OID_BOOL, prec: 0, scale: 0, len: 1})) }     // len 1: takes numbers
        "tinyint" { return Ok(Some(TypeName{kind: K_INT, oid: OID_INT2, prec: lexdb_dialect.TS_TINYINT, scale: 0, len: 0})) }
        "money" { return Ok(Some(TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 19, scale: 4, len: 0})) }
        "smallmoney" { return Ok(Some(TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 10, scale: 4, len: 0})) }
        "uniqueidentifier" { return Ok(Some(TypeName{kind: K_UUID, oid: OID_UUID, prec: 0, scale: 0, len: 0})) }
        "json" { return Ok(Some(TypeName{kind: K_JSON, oid: OID_JSON, prec: 0, scale: 0, len: 0})) }
        "varbinary", "binary", "image", "rowversion", "timestamp" {
            let n = try p.tsqlLen()
            let code = if w == "varbinary" { lexdb_dialect.TS_VARBINARY } else if w == "binary" { lexdb_dialect.TS_BINARY } else if w == "image" { lexdb_dialect.TS_IMAGE } else { lexdb_dialect.TS_TIMESTAMP }
            return Ok(Some(TypeName{kind: K_BYTEA, oid: OID_BYTEA, prec: code, scale: 0, len: if n > 0 { n } else { 0 }}))
        }
        "datetime", "smalldatetime", "datetime2", "datetimeoffset", "time" {
            let oid = if w == "datetimeoffset" { OID_TSTZ } else if w == "time" { OID_TIME } else { OID_TS }
            var t = lexdb_sql.timeType(oid)
            var n = if w == "datetime" { 3 } else if w == "smalldatetime" { 0 } else { 7 }
            if w != "datetime" && w != "smalldatetime" && p.acceptKw("(") {
                n = try p.intLit()
                if n < 0 || n > 7 { return Err(lexdb_base.err("TS1002", &("Line 1: Specified scale " + n.toStr() + " is invalid."))) }
                try p.expectKw(")")
            }
            // prec: 1 (the scale given), or SQL Server's datetime or smalldatetime (tsqlCode)
            t.prec = if w == "datetime" { lexdb_dialect.TS_DATETIME } else if w == "smalldatetime" { lexdb_dialect.TS_SMALLDATETIME } else { 1 }
            t.scale = n                     // (lexdb keeps microseconds: 7 rounds as 6; TDS sends the 7)
            if w == "datetimeoffset" { t.len = lexdb_sql.TSZ_TSQL }       // it keeps each value's offset (Val.Tsz)
            return Ok(Some(t))
        }
        else { return Ok(None) }
    }
}


// ---- a cursor over T-SQL text, for lexdb_tsqlparse (which reads a batch's
// own statements: DECLARE, SET, transaction control, and later IF, WHILE,
// TRY ... CATCH, procedures). Every other statement, and every expression
// and type name, is lexdb's grammar here, read in T-SQL mode.

pub type Parser = record { p: P; lnAt: int; lnN: int }   // lnAt, lnN: lineOf's place so far, and the line there

// A parser over sql read as T-SQL; vars: the variables in scope at its
// start ($1, $2, ... in that order).
pub fn tsqlParser(sql: &str, d: Dialect, vars: &[]str): Result[Parser, lexdb_base.DbErr] {
    var dt = d
    dt.tsql = true
    let toks = try lexIn(sql, dt)
    var given: []str = []
    for v in vars { append(mut &given, v.clone()) }
    return Ok(Parser{p: P{toks: toks, pos: 0, params: 0, subs: [], ctes: [], nextCte: 0, inCte: [], depth: 0, seqs: [], wins: [], src: sql.toStr(), tsql: true, vars: given, spelled: "", ora: false, rnLimit: -1, nls: [], mr: 0, udf: false}, lnAt: 0, lnN: 1})
}

pub fn (q: &Parser) peek(): &Tok { return q.p.peek() }
pub fn (q: &Parser) peekAt(k: int): &Tok { return q.p.peekAt(k) }
pub fn (q: mut &Parser) next(): Tok { return q.p.next() }
pub fn (q: mut &Parser) skip(n: int) { q.p.pos += n }
pub fn (q: &Parser) mark(): int { return q.p.pos }
pub fn (q: mut &Parser) reset(m: int) { q.p.pos = m }
pub fn (q: &Parser) isKw(w: &str): bool { return q.p.isKw(w) }
pub fn (q: mut &Parser) acceptKw(w: &str): bool { return q.p.acceptKw(w) }
pub fn (q: mut &Parser) expectKw(w: &str): Result[Unit, lexdb_base.DbErr] { return q.p.expectKw(w) }

// The syntax error for the next token.
pub fn (q: &Parser) unexpected(): lexdb_base.DbErr { return near(&q.p.peek()) }

// Starts a statement: the state gathered per statement (parameters,
// subqueries, ...) cleared.
pub fn (q: mut &Parser) fresh() { q.p.fresh() }

// The line (from 1) of the text at byte at: the newlines before it, counted on from the last place asked (a batch's
// statements are asked in order), SQL Server's line of an error (design/lexdb-tds.md, "As built: error texts and lines").
pub fn (q: mut &Parser) lineOf(at: int): int {
    if at < q.lnAt {
        q.lnAt = 0
        q.lnN = 1
    }
    let end = min(at, len(q.p.src))
    var n = q.lnN
    for i in q.lnAt..end { if q.p.src[i] == '\n' { n += 1 } }
    q.lnAt = end
    q.lnN = n
    return n
}

// The last token before the end of the text (SQL Server's 102 at the end of a statement names it, at its line): its
// text as written ("" none), and where it is.
pub fn (q: &Parser) lastText(): str {
    let n = len(q.p.toks)
    if n < 2 { return "" }
    return q.spelled(&q.p.toks[n - 2])
}

pub fn (q: &Parser) lastAt(): int {
    let n = len(q.p.toks)
    return if n < 2 { 0 } else { q.p.toks[n - 2].at }
}

// A token's text as the source has it (a keyword's or name's case kept).
pub fn (q: &Parser) spelled(t: &Tok): str {
    if len(t.spell) > 0 { return t.spell.clone() }
    let end = min(len(q.p.src), t.at + max(len(t.text), 1))
    if t.at < 0 || t.at >= end { return t.text.clone() }
    let w = q.p.src[t.at..end].toStr()
    return if strings.toLowerAscii(&w) == t.text { w } else { t.text.clone() }
}

pub fn (q: mut &Parser) expr(): Result[Expr, lexdb_base.DbErr] { return q.p.expr() }
pub fn (q: mut &Parser) compound(): str { return q.p.tsqlCompound() }
pub fn (q: mut &Parser) typeName(): Result[TypeName, lexdb_base.DbErr] { return q.p.typeName() }

// A parameter's type (sp_executesql's @params): a type lexdb knows (key ""),
// or one of the user's, a T-SQL table type's: its name as qname gives it
// (key; dbo as public) and as written.
pub type ParamType = record { pub typ: TypeName; pub key: str; pub written: str }

pub fn (q: mut &Parser) paramType(): Result[ParamType, lexdb_base.DbErr] {
    let at = q.p.pos
    let start = q.p.peek().at
    let t = try q.p.typeName()
    if t.kind != K_ENUM { return Ok(ParamType{typ: t, key: "", written: ""}) }
    q.p.pos = at
    let key = try q.p.qname()
    let end = min(q.p.peek().at, len(q.p.src))
    return Ok(ParamType{typ: t, key: key, written: strings.trim(&q.p.src[start..end]).toStr()})
}

// A table's name ([db.][schema.]name, dbo as public), as a statement names it.
pub fn (q: mut &Parser) tableName(): Result[str, lexdb_base.DbErr] { return q.p.qname() }

// A variable's use: $k, or SQL Server's error for one not declared.
pub fn (q: mut &Parser) variable(t: &Tok): Result[Expr, lexdb_base.DbErr] { return q.p.variable(t) }

// One of lexdb's statements, whole.
pub fn (q: mut &Parser) statement(): Result[Stmt, lexdb_base.DbErr] {
    q.p.fresh()
    let at = q.p.pos
    var s = match q.p.statement() {
        Ok(x) { x }
        Err(e) { return Err(q.p.startErr(at, e)) }
    }
    q.p.finish(mut &s)
    return Ok(s)
}

// SELECT @v = e, as SET @v = e and DECLARE's initialiser are run; e parsed
// since the last fresh().
pub fn (q: mut &Parser) assign(v: &str, e: Expr): Stmt {
    var s = lexdb_sql.newStmt(S_SELECT)
    append(mut &s.items, SelItem{star: false, qual: "", expr: Some(e), alias: v.toStr(), spell: ""})
    append(mut &s.assign, v.toStr())
    q.p.finish(mut &s)
    return s
}

// SELECT xs, as PRINT, RAISERROR and THROW have their arguments; xs parsed
// since the last fresh().
pub fn (q: mut &Parser) values(xs: &[]Expr): Stmt {
    var s = lexdb_sql.newStmt(S_SELECT)
    for x in xs { append(mut &s.items, SelItem{star: false, qual: "", expr: Some(cloneE(&x)), alias: "", spell: ""}) }
    q.p.finish(mut &s)
    return s
}

// DECLARE @t TABLE (...), after TABLE: CREATE TABLE name (...).
pub fn (q: mut &Parser) tableDef(name: &str): Result[Stmt, lexdb_base.DbErr] {
    q.p.fresh()
    var s = lexdb_sql.newStmt(S_CREATE)
    s.mdialect = MD_TSQL
    s.table = name.toStr()
    var r = try q.p.tableBody(s)
    q.p.finish(mut &r)
    return Ok(r)
}

// IF's and WHILE's condition: SELECT CASE WHEN cond THEN 1 ELSE 0 END.
pub fn (q: mut &Parser) condition(): Result[Stmt, lexdb_base.DbErr] {
    q.p.fresh()
    let c = try q.p.expr()
    let e = Expr.Call("case else", [c, Expr.Lit(Val.Int(1)), Expr.Lit(Val.Int(0))], false)
    return Ok(q.values([e]))
}

// Whether v is in scope; declare adds one.
pub fn (q: &Parser) hasVar(v: &str): bool {
    for x in q.p.vars { if x == v { return true } }
    return false
}
pub fn (q: mut &Parser) declare(v: &str) { append(mut &q.p.vars, v.toStr()) }
pub fn (q: mut &Parser) takeVars(): []str { return replace(mut &q.p.vars, []) }

// The per-statement state, fresh.
fn (p: mut &P) fresh() {
    p.params = 0
    p.subs = []
    p.ctes = []
    p.nextCte = 0
    p.inCte = []
    p.depth = 0
    p.seqs = []
    p.wins = []
}

// A statement's parts gathered while it was parsed, moved into it.
fn (p: mut &P) finish(s: mut &Stmt) {
    s.params = p.params
    s.seqNames = replace(mut &p.seqs, [])
    s.udf = p.udf
    p.udf = false
    if s.kind != S_EXPLAIN {
        s.subs = replace(mut &p.subs, [])
        s.wins = replace(mut &p.wins, [])
    }
    if s.kind == S_SELECT && !s.udf {
        for sub in s.subs { if sub.srf == lexdb_sql.GRAPH_MARK { s.udf = true; break } }
    }
    if p.nextCte > 0 { markCtes(mut &s, p.nextCte) }
}


// ---- Oracle (design/lexdb-oracle.md, stage O3) inside lexdb's grammar: its
// names (folded up), types, functions, ROWNUM, DUAL, sequences' .nextval.
// Its functions that lexdb has not are lexdb_orafn's.

fn isNumLit(x: &Expr): bool {
    match x {
        Expr.Lit(v) {
            match v {
                Val.Int(_) { return true }
                Val.Num(_) { return true }
                else { return false }
            }
        }
        else { return false }
    }
}

// l op r for Oracle: || ignores a NULL; + and - take dates and days.
fn oraArith(op: &str, l: Expr, r: Expr): Expr {
    if op == "||" { return Expr.Call("#ora_cat", [l, r], false) }
    if isNumLit(&l) && isNumLit(&r) { return Expr.Bin(op.toStr(), l, r) }
    return Expr.Call(if op == "+" { "#ora_add" } else { "#ora_sub" }, [l, r], false)
}

fn oraErr(num: int, msg: &str): lexdb_base.DbErr { return lexdb_base.err(&("ORA" + strings.padLeft(&(num.toStr()), 5, '0')), msg) }

fn sysdateExpr(): Expr {
    return Expr.Call("date_trunc", [Expr.Lit(Val.Text("second")), Expr.Call("localtimestamp", [], false)], false)
}

// An identifier or keyword Oracle has that lexdb does not read: SYSDATE,
// SYSTIMESTAMP, ROWNUM, USER, seq.NEXTVAL; None for the rest.
fn (p: mut &P) oraPrimary(t: &Tok): Result[Option[Expr], lexdb_base.DbErr] {
    if t.kind != T_IDENT && t.kind != T_QIDENT { return Ok(None) }
    // the hierarchical operators (lexdb_recur.hierQuery): PRIOR x, CONNECT_BY_ROOT x
    if t.kind == T_IDENT && (t.text == "prior" || t.text == "connect_by_root") && (p.peek().kind != T_OP || p.isKw("(") || p.isKw("-")) {
        let e = try p.unary()
        return Ok(Some(Expr.Call(if t.text == "prior" { "#prior" } else { "#cbroot" }, [e], false)))
    }
    // seq.nextval, schema.seq.nextval
    if p.isKw(".") {
        let a = p.peekAt(1).clone()
        if (a.kind == T_IDENT) && (a.text == "nextval" || a.text == "currval") {
            p.pos += 2
            return Ok(Some(p.oraSeq(&t.text, &a.text)))
        }
        let b = p.peekAt(3).clone()
        if (a.kind == T_IDENT || a.kind == T_QIDENT) && p.peekAt(2).kind == T_OP && p.peekAt(2).text == "." && b.kind == T_IDENT && (b.text == "nextval" || b.text == "currval") {
            p.pos += 4
            return Ok(Some(p.oraSeq(&(lexdb_sql.qual(&t.text, &a.text)), &b.text)))
        }
        return Ok(None)
    }
    if t.kind != T_IDENT || p.isKw("(") { return Ok(None) }
    match t.text {
        "sysdate", "current_date" { return Ok(Some(sysdateExpr())) }
        "systimestamp" { return Ok(Some(Expr.Call("#ora_systs", [], false))) }
        "user" { return Ok(Some(Expr.Call("upper", [Expr.Call("current_user", [], false)], false))) }
        "uid" { return Ok(Some(Expr.Lit(Val.Int(1)))) }
        "sessiontimezone" { return Ok(Some(Expr.Call("#ora_sessiontz", [], false))) }
        "dbtimezone" { return Ok(Some(Expr.Lit(Val.Text("+00:00")))) }
        "rownum" {
            // ROWNUM outside WHERE's simple tests (oraRownum): a number for each row
            var d = WinDef{call: Expr.Call("row_number", [], false), ref: "", bare: false, part: [], order: [], frame: lexdb_sql.noFrame()}
            append(mut &p.wins, d)
            return Ok(Some(Expr.Call("#win", [Expr.Lit(Val.Int(len(p.wins) - 1)), Expr.Call("row_number", [], false)], false)))
        }
        else { return Ok(None) }
    }
}

fn (p: mut &P) oraSeq(name: &str, which: &str): Expr {
    append(mut &p.seqs, name.clone())
    return Expr.Call(which.toStr(), [Expr.Lit(Val.Text(name.clone()))], false)
}

fn cloneAll(a: &[]Expr): []Expr {
    var out: []Expr = []
    for x in a { append(mut &out, cloneE(&x)) }
    return out
}

// An Oracle call's argument i (its default when not given).
fn oraArg(a: &[]Expr, i: int, dflt: int): Expr {
    if i < len(a) { return cloneE(&a[i]) }
    return Expr.Lit(Val.Int(dflt))
}

// An Oracle REGEXP_ call's match parameter at i, marked (lexdb_sql.RE_ORA); NULL or missing: none.
fn oraReFlagsArg(a: &[]Expr, i: int): Expr {
    if i >= len(a) { return Expr.Lit(Val.Text(lexdb_sql.RE_ORA)) }
    match a[i] {
        Expr.Lit(v) {
            match v {
                Val.Text(t) { return Expr.Lit(Val.Text(lexdb_sql.RE_ORA + t)) }
                Val.Null { return Expr.Lit(Val.Text(lexdb_sql.RE_ORA)) }
                else {}
            }
        }
        else {}
    }
    return Expr.Bin("||", Expr.Lit(Val.Text(lexdb_sql.RE_ORA)), Expr.Call("coalesce", [cloneE(&a[i]), Expr.Lit(Val.Text(""))], false))
}

fn orArgs(name: &str): lexdb_base.DbErr { return oraErr(909, "invalid number of arguments") }

// SYS_CONTEXT('USERENV', name): what Oracle's connection has of the session
// (design/lexdb-oracle.md, O4). A name that is not a literal, another namespace
// and a parameter lexdb does not know are NULL (Oracle's ORA-02003 for the last).
fn oraSysContext(a: &[]Expr, nls: &[]str): Expr {
    var ns = ""
    var nm = ""
    match a[0] {
        Expr.Lit(v) {
            match v {
                Val.Text(t) { ns = strings.toUpperAscii(&t) }
                else {}
            }
        }
        else {}
    }
    match a[1] {
        Expr.Lit(v) {
            match v {
                Val.Text(t) { nm = strings.toUpperAscii(&t) }
                else {}
            }
        }
        else {}
    }
    let nul = Expr.Lit(Val.Null)
    if ns != "USERENV" || len(nm) == 0 { return nul }
    let user = Expr.Call("upper", [Expr.Call("current_user", [], false)], false)
    match nm {
        "SESSION_USER", "CURRENT_USER", "PROXY_USER_X" { return user }
        // the schema ALTER SESSION SET CURRENT_SCHEMA made the session's (lexdb_tns.reapply keeps it as a setting), else the user's
        "CURRENT_SCHEMA", "SESSION_SCHEMA" { return Expr.Call("coalesce", [oraSetting("current_schema"), user], false) }
        "SESSIONID", "SID", "AUDITED_CURSORID_X" { return Expr.Call("pg_backend_pid", [], false) }
        "DB_NAME", "DB_UNIQUE_NAME" { return Expr.Lit(Val.Text("LEXDB")) }
        "CON_NAME", "SERVICE_NAME" { return Expr.Lit(Val.Text("FREEPDB1")) }
        "CDB_NAME" { return Expr.Lit(Val.Text("LEXDB")) }
        "CON_ID", "CURRENT_SCHEMAID_X" { return Expr.Lit(Val.Text("3")) }
        "INSTANCE" { return Expr.Lit(Val.Text("1")) }
        "INSTANCE_NAME" { return Expr.Lit(Val.Text("lexdb")) }
        "HOST", "SERVER_HOST" { return Expr.Lit(Val.Text(lexdb_dialect.hostName())) }
        "IP_ADDRESS" { return Expr.Lit(Val.Text("127.0.0.1")) }
        "NETWORK_PROTOCOL" { return Expr.Call("#netproto", [], false) }
        "AUTHENTICATION_METHOD" { return Expr.Lit(Val.Text("PASSWORD")) }
        "AUTHENTICATION_TYPE" { return Expr.Lit(Val.Text("DATABASE")) }
        "ISDBA" { return Expr.Lit(Val.Text("FALSE")) }
        // what ALTER SESSION set, else the defaults (lexdb_tns.reapply keeps the settings as oracle.nls_x)
        "LANGUAGE" {
            return Expr.Bin("||", Expr.Bin("||", Expr.Bin("||", Expr.Call("coalesce", [oraSetting("nls_language"), Expr.Lit(Val.Text("AMERICAN"))], false), Expr.Lit(Val.Text("_"))),
                                  Expr.Call("coalesce", [oraSetting("nls_territory"), Expr.Lit(Val.Text("AMERICA"))], false)), Expr.Lit(Val.Text(".AL32UTF8")))
        }
        "LANG" { return Expr.Lit(Val.Text("US")) }
        "NLS_TERRITORY" { return Expr.Call("coalesce", [oraSetting("nls_territory"), Expr.Lit(Val.Text("AMERICA"))], false) }
        "NLS_CURRENCY" { return Expr.Call("coalesce", [oraSetting("nls_currency"), Expr.Lit(Val.Text("$"))], false) }
        "NLS_CALENDAR" { return Expr.Lit(Val.Text("GREGORIAN")) }
        "NLS_SORT" { return Expr.Call("coalesce", [oraSetting("nls_sort"), Expr.Lit(Val.Text("BINARY"))], false) }
        "NLS_DATE_FORMAT" { return Expr.Lit(Val.Text(if len(nls) > 0 && len(nls[0]) > 0 { nls[0].clone() } else { "DD-MON-RR" })) }
        "NLS_DATE_LANGUAGE" {
            return Expr.Call("coalesce", [oraSetting("nls_date_language"), oraSetting("nls_language"), Expr.Lit(Val.Text("AMERICAN"))], false)
        }
        "NLS_TIMESTAMP_FORMAT" { return Expr.Lit(Val.Text(if len(nls) > 1 && len(nls[1]) > 0 { nls[1].clone() } else { "DD-MON-RR HH.MI.SSXFF AM" })) }
        "CURRENT_EDITION_NAME" { return Expr.Lit(Val.Text("ORA$BASE")) }
        "ENTRYID" { return Expr.Lit(Val.Text("0")) }
        "TERMINAL" { return Expr.Lit(Val.Text("unknown")) }
        "OS_USER" { return Expr.Lit(Val.Text("lexdb")) }
        "ORACLE_HOME" { return Expr.Lit(Val.Text("/opt/lexdb")) }
        "DB_DOMAIN" { return nul }
        else { return nul }
    }
}

// A setting of the Oracle session (lexdb_tns.reapply sets oracle.name): its value, NULL when it is not set.
fn oraSetting(name: &str): Expr {
    return Expr.Call("nullif", [Expr.Call("current_setting", [Expr.Lit(Val.Text("oracle." + name)), Expr.Lit(Val.Bool(true))], false), Expr.Lit(Val.Text(""))], false)
}

// An Oracle function's call, as lexdb's own (or lexdb_orafn's).
fn (p: mut &P) oraCall(name: &str, args: []Expr, star: bool): Result[Expr, lexdb_base.DbErr] {
    let n = len(args)
    var a = args
    match name.toStr() {
        "sys_context" {
            if n != 2 && n != 3 { return Err(orArgs(name)) }
            // (CURRENT_SCHEMA reads a setting: the statement is not kept past it, as for current_setting)
            match a[1] {
                Expr.Lit(v) {
                    match v {
                        Val.Text(t) {
                            let u = strings.toUpperAscii(&t)
                            if u == "CURRENT_SCHEMA" || u == "SESSION_SCHEMA" || u == "LANGUAGE" || u == "NLS_TERRITORY" || u == "NLS_CURRENCY" || u == "NLS_SORT" ||
                               u == "NLS_DATE_LANGUAGE" { append(mut &p.seqs, SET_MARK) }
                        }
                        else {}
                    }
                }
                else {}
            }
            return Ok(oraSysContext(&a, &p.nls))
        }
        "ora_database_name" { return Ok(Expr.Lit(Val.Text("LEXDB"))) }
        "utl_raw_cast" { return Ok(Expr.Lit(Val.Null)) }
        "utl_raw_cast_to_raw", "utl_raw_cast_to_varchar2", "utl_encode_base64_encode", "utl_encode_base64_decode" {
            if n != 1 { return Err(orArgs(name)) }
            let f = match name.toStr() { "utl_raw_cast_to_raw" { "#ora_rawof" } "utl_raw_cast_to_varchar2" { "#ora_rawtext" }
                                         "utl_encode_base64_encode" { "#ora_b64enc" } else { "#ora_b64dec" } }
            return Ok(Expr.Call(f, a, false))
        }
        "dbms_lob_getlength" {
            if n != 1 { return Err(orArgs(name)) }
            return Ok(Expr.Call("length", a, false))
        }
        "dbms_lob_substr" {
            // DBMS_LOB.SUBSTR(lob, amount, offset): the arguments swapped for SUBSTR(lob, offset, amount)
            if n < 1 || n > 3 { return Err(orArgs(name)) }
            if n == 1 { return Ok(Expr.Call("#ora_substr", [cloneE(&a[0]), Expr.Lit(Val.Int(1)), Expr.Lit(Val.Int(32767))], false)) }
            if n == 2 { return Ok(Expr.Call("#ora_substr", [cloneE(&a[0]), Expr.Lit(Val.Int(1)), cloneE(&a[1])], false)) }
            return Ok(Expr.Call("#ora_substr", [cloneE(&a[0]), cloneE(&a[2]), cloneE(&a[1])], false))
        }
        "nvl" {
            if n != 2 { return Err(orArgs(name)) }
            return Ok(Expr.Call("coalesce", a, false))
        }
        "nvl2" {
            if n != 3 { return Err(orArgs(name)) }
            return Ok(Expr.Call("case else", [Expr.IsNull(cloneE(&a[0]), true), cloneE(&a[1]), cloneE(&a[2])], false))
        }
        "decode" {
            if n < 3 { return Err(orArgs(name)) }
            var whens: []Expr = []
            var i = 1
            while i + 1 < n {
                let sx = cloneE(&a[i])
                var cond = Expr.Bin("=", cloneE(&a[0]), sx)
                match cloneE(&a[i]) {
                    Expr.Lit(v) {
                        match v {
                            Val.Null { cond = Expr.IsNull(cloneE(&a[0]), false) }
                            else {}
                        }
                    }
                    else {
                        cond = Expr.Bin("or", cond, Expr.Bin("and", Expr.IsNull(cloneE(&a[0]), false), Expr.IsNull(cloneE(&a[i]), false)))
                    }
                }
                append(mut &whens, cond)
                append(mut &whens, cloneE(&a[i + 1]))
                i += 2
            }
            if i < n {
                append(mut &whens, cloneE(&a[i]))
                return Ok(Expr.Call("case else", whens, false))
            }
            return Ok(Expr.Call("case", whens, false))
        }
        "substr", "substrb", "substrc" { return Ok(Expr.Call("#ora_substr", a, false)) }
        "instr", "instrb" { return Ok(Expr.Call("#ora_instr", a, false)) }
        "replace" { return Ok(Expr.Call("#ora_replace", a, false)) }
        "concat" {
            if n != 2 { return Err(orArgs(name)) }
            return Ok(Expr.Call("#ora_cat", a, false))
        }
        "to_char", "to_nchar" {
            if n > 2 { a = [cloneE(&a[0]), cloneE(&a[1])] }
            // no format: a date follows the session's NLS formats
            if n == 1 && len(p.nls) >= 3 { return Ok(Expr.Call("#ora_tochar1", [cloneE(&a[0]), Expr.Lit(Val.Text(p.nls[0].clone())), Expr.Lit(Val.Text(p.nls[1].clone())), Expr.Lit(Val.Text(p.nls[2].clone()))], false)) }
            return Ok(Expr.Call("#ora_tochar", a, false))
        }
        "to_date" {
            if n > 2 { a = [cloneE(&a[0]), cloneE(&a[1])] }
            if n == 1 && len(p.nls) >= 3 && len(p.nls[0]) > 0 { a = [cloneE(&a[0]), Expr.Lit(Val.Text(p.nls[0].clone()))] }
            return Ok(Expr.Call("#ora_todate", a, false))
        }
        "to_timestamp" {
            if n > 2 { a = [cloneE(&a[0]), cloneE(&a[1])] }
            if n == 1 && len(p.nls) >= 3 && len(p.nls[1]) > 0 { a = [cloneE(&a[0]), Expr.Lit(Val.Text(p.nls[1].clone()))] }
            return Ok(Expr.Call("#ora_totimestamp", a, false))
        }
        "to_number" {
            if n > 2 { a = [cloneE(&a[0]), cloneE(&a[1])] }
            return Ok(Expr.Call("#ora_tonumber", a, false))
        }
        "trunc" { return Ok(Expr.Call("#ora_trunc", a, false)) }
        "round" { return Ok(Expr.Call("#n_oround", a, false)) }      // (a number's #ora_round, a date's or an interval's lexdb_newfn's: lexdb_bind.newCall)
        "add_months" { return Ok(Expr.Call("#ora_addmonths", a, false)) }
        "sys_extract_utc" { return Ok(Expr.Call("#ora_sysutc", a, false)) }
        "numtodsinterval" { return Ok(Expr.Call("#ora_numtods", a, false)) }
        "numtoyminterval" { return Ok(Expr.Call("#ora_numtoym", a, false)) }
        "from_tz" { return Ok(Expr.Call("#ora_fromtz", a, false)) }
        "to_timestamp_tz" {
            if n > 2 { a = [cloneE(&a[0]), cloneE(&a[1])] }
            if n == 1 && len(p.nls) >= 3 && len(p.nls[2]) > 0 { a = [cloneE(&a[0]), Expr.Lit(Val.Text(p.nls[2].clone()))] }
            return Ok(Expr.Call("#ora_totstz", a, false))
        }
        "tz_offset" { return Ok(Expr.Call("#ora_tzoffset", a, false)) }
        "new_time" { return Ok(Expr.Call("#ora_newtime", a, false)) }
        "months_between" { return Ok(Expr.Call("#ora_monthsbetween", a, false)) }
        "last_day" { return Ok(Expr.Call("#ora_lastday", a, false)) }
        "next_day" { return Ok(Expr.Call("#ora_nextday", a, false)) }
        "lengthb", "lengthc" { return Ok(Expr.Call("length", a, false)) }
        "power", "sqrt", "exp", "ln", "log" {
            // NUMBER's, not a double's
            var b: []Expr = []
            let nt = TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 0, scale: 0, len: 0}
            for x in a { append(mut &b, Expr.Cast(cloneE(&x), nt)) }
            return Ok(Expr.Call(name.toStr(), b, false))
        }
        "bitand" {
            if n != 2 { return Err(orArgs(name)) }
            return Ok(Expr.Bin("&", cloneE(&a[0]), cloneE(&a[1])))
        }
        "upper", "lower" {
            if n != 1 { return Err(orArgs(name)) }
            return Ok(Expr.Call("#ora_" + name, a, false))
        }
        "greatest", "least" {
            // NULL when any argument is
            if n < 1 { return Err(orArgs(name)) }
            var cs: []Expr = []
            var same: []Expr = []
            for x in a {
                append(mut &cs, Expr.IsNull(cloneE(&x), false))
                // a NULL of the result's type: nullif(g, g)
                append(mut &cs, Expr.Call("nullif", [Expr.Call(name.toStr(), cloneAll(&a), false), Expr.Call(name.toStr(), cloneAll(&a), false)], false))
            }
            append(mut &cs, Expr.Call(name.toStr(), a, false))
            return Ok(Expr.Call("case else", cs, false))
        }
        "rawtohex" {
            if n != 1 { return Err(orArgs(name)) }
            return Ok(Expr.Call("upper", [Expr.Call("encode", [cloneE(&a[0]), Expr.Lit(Val.Text("hex"))], false)], false))
        }
        "hextoraw" {
            if n != 1 { return Err(orArgs(name)) }
            return Ok(Expr.Call("decode", [cloneE(&a[0]), Expr.Lit(Val.Text("hex"))], false))
        }
        "to_clob", "to_nclob" {
            if n != 1 { return Err(orArgs(name)) }
            return Ok(Expr.Cast(cloneE(&a[0]), TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}))
        }
        "sys_guid" {
            let u = Expr.Call("gen_random_uuid", [], false)
            return Ok(Expr.Call("upper", [Expr.Call("replace", [u, Expr.Lit(Val.Text("-")), Expr.Lit(Val.Text(""))], false)], false))
        }
        // REGEXP_REPLACE (source, pattern [, replacement [, position [, occurrence [, match_param]]]]), the occurrence 0 all of them
        // (the replacement NULL: the matches removed); REGEXP_SUBSTR (source, pattern [, position [, occurrence [, match_param
        // [, subexpr]]]]); REGEXP_INSTR (..., occurrence [, return_option [, match_param [, subexpr]]]); REGEXP_COUNT (source,
        // pattern [, position [, match_param]]): lexdb's own functions of the same arguments, the match parameter marked as
        // Oracle's (lexdb_sql.RE_ORA)
        "regexp_replace" {
            if n < 2 || n > 6 { return Err(orArgs(name)) }
            let rep = if n >= 3 { Expr.Call("coalesce", [cloneE(&a[2]), Expr.Lit(Val.Text(""))], false) } else { Expr.Lit(Val.Text("")) }
            return Ok(Expr.Call("regexp_replace", [cloneE(&a[0]), cloneE(&a[1]), rep, oraArg(&a, 3, 1), oraArg(&a, 4, 0), oraReFlagsArg(&a, 5)], false))
        }
        "regexp_substr" {
            if n < 2 || n > 6 { return Err(orArgs(name)) }
            return Ok(Expr.Call("regexp_substr", [cloneE(&a[0]), cloneE(&a[1]), oraArg(&a, 2, 1), oraArg(&a, 3, 1), oraReFlagsArg(&a, 4), oraArg(&a, 5, 0)], false))
        }
        "regexp_instr" {
            if n < 2 || n > 7 { return Err(orArgs(name)) }
            return Ok(Expr.Call("regexp_instr", [cloneE(&a[0]), cloneE(&a[1]), oraArg(&a, 2, 1), oraArg(&a, 3, 1), oraArg(&a, 4, 0), oraReFlagsArg(&a, 5), oraArg(&a, 6, 0)], false))
        }
        "regexp_count" {
            if n < 2 || n > 4 { return Err(orArgs(name)) }
            return Ok(Expr.Call("regexp_count", [cloneE(&a[0]), cloneE(&a[1]), oraArg(&a, 2, 1), oraReFlagsArg(&a, 3)], false))
        }
        "regexp_like" {
            if n < 2 || n > 3 { return Err(orArgs(name)) }
            return Ok(Expr.Call("regexp_like", [cloneE(&a[0]), cloneE(&a[1]), oraReFlagsArg(&a, 2)], false))
        }
        else { return oraNewCall(name, a, star) }
    }
}

// Oracle's type names as lexdb's; None for the rest.
fn (p: mut &P) oraType(w: &str): Result[Option[TypeName], lexdb_base.DbErr] {
    match w.toStr() {
        "varchar2", "nvarchar2" {
            var n = 0
            if p.acceptKw("(") {
                n = try p.intLit()
                if !p.acceptKw("byte") { let c = p.acceptKw("char") }
                try p.expectKw(")")
            }
            if n > 0 { return Ok(Some(TypeName{kind: K_TEXT, oid: OID_VARCHAR, prec: 0, scale: 0, len: n})) }
            return Ok(Some(TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}))
        }
        "number", "float" {
            var t = TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 0, scale: 0, len: 0}
            if p.acceptKw("(") {
                if p.acceptKw("*") { t.prec = 38 } else { t.prec = try p.intLit() }
                if w == "number" && p.acceptKw(",") { t.scale = try p.signedInt() }
                try p.expectKw(")")
                if w == "float" {
                    return Ok(Some(TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 0, scale: 0, len: 0}))
                }
                if t.prec < 1 || t.prec > 38 { return Err(oraErr(1727, "numeric precision specifier is out of range (1 to 38)")) }
                if t.scale < 0 { return Err(lexdb_base.err("0A000", "a NUMBER with a negative scale is not supported")) }
                if t.scale > t.prec { t.prec = t.scale }
            }
            return Ok(Some(t))
        }
        "binary_float" { return Ok(Some(lexdb_sql.floatType(OID_FLOAT4))) }
        "binary_double" { return Ok(Some(lexdb_sql.floatType(OID_FLOAT8))) }
        "json" { return Ok(Some(TypeName{kind: K_JSON, oid: OID_JSON, prec: 0, scale: 0, len: 0})) }
        "integer", "int", "smallint", "pls_integer", "binary_integer", "simple_integer" {
            return Ok(Some(TypeName{kind: K_INT, oid: OID_INT8, prec: 0, scale: 0, len: 0}))
        }
        "clob", "nclob", "rowid", "urowid" {
            if (w == "rowid" || w == "urowid") && p.acceptKw("(") {
                let k = try p.intLit()
                try p.expectKw(")")
            }
            // (prec 1 marks a CLOB for Oracle's DESCRIBE: OutCol's declared type)
            return Ok(Some(TypeName{kind: K_TEXT, oid: OID_TEXT, prec: if w == "clob" || w == "nclob" { 1 } else { 0 }, scale: 0, len: 0}))
        }
        "long" {
            if p.acceptKw("raw") { return Ok(Some(TypeName{kind: K_BYTEA, oid: OID_BYTEA, prec: 0, scale: 0, len: 0})) }
            return Ok(Some(TypeName{kind: K_TEXT, oid: OID_TEXT, prec: 0, scale: 0, len: 0}))
        }
        "blob", "raw", "bfile" {
            if w == "raw" && p.acceptKw("(") {
                let k = try p.intLit()
                try p.expectKw(")")
            }
            return Ok(Some(TypeName{kind: K_BYTEA, oid: OID_BYTEA, prec: if w == "blob" { 1 } else { 0 }, scale: 0, len: 0}))
        }
        "date" {
            // Oracle's DATE has a time of day, to the second
            var t = lexdb_sql.timeType(OID_TS)
            t.prec = 1
            t.scale = 0
            return Ok(Some(t))
        }
        "timestamp" {
            var scale = 6
            if p.acceptKw("(") {
                scale = try p.intLit()
                try p.expectKw(")")
            }
            var oid = OID_TS
            var keeps = false
            if p.acceptKw("with") {
                let loc = p.acceptKw("local")
                try p.expectKw("time")
                try p.expectKw("zone")
                oid = OID_TSTZ
                keeps = !loc            // TIMESTAMP WITH TIME ZONE keeps each value's offset (Val.Tsz); the LOCAL one is an instant
            }
            var t = lexdb_sql.timeType(oid)
            t.prec = 1
            t.scale = min(scale, 6)
            if keeps { t.len = lexdb_sql.TSZ_LEN }
            return Ok(Some(t))
        }
        else { return Ok(None) }
    }
}

// The text of an expression's tokens, as Oracle names a column made by one:
// upper case, "quoted" names too (Oracle 23.26: "Id"+1 is "ID"+1).
fn (p: &P) oraLabel(a: int, b: int): str {
    let from = p.toks[a].at
    let to = p.toks[b].at
    let txt = p.src[from..to].toStr()
    var out = ""
    var q = false           // inside "..."
    var sq = false          // inside '...'
    var n = len(txt)
    while n > 0 && (txt[n - 1] == ' ' || txt[n - 1] == '\n' || txt[n - 1] == '\t' || txt[n - 1] == '\r') { n -= 1 }
    let mark = "/*" + lexdb_sql.PLF_LABEL
    var i = 0
    while i < n {
        let c = txt[i]
        // a stored function's call made before the query: its text, not its value's (lexdb_sql.PLF_LABEL)
        if !q && !sq && c == '(' && strings.startsWith(&txt[i + 1..n], &mark) {
            let e = strings.indexOf(&txt, "*/", i + 1 + len(mark))
            if e > 0 {
                out += &labelText(&txt[i + 1 + len(mark)..e])
                i = skipGroup(&txt, i, n)
                continue
            }
        }
        // blanks outside "quotes" (Oracle drops them inside literals too) are dropped
        i += 1
        if !q && (c == ' ' || c == '\n' || c == '\t' || c == '\r') { continue }
        if c == '"' && !sq { q = !q }
        if c == '\'' && !q { sq = !sq }
        out.addByte(if c >= 'a' && c <= 'z' { c - 32 } else { c })
    }
    return out
}

// oraLabel's text of s: blanks outside quotes dropped, upper case.
fn labelText(s: &str): str {
    var out = ""
    var q = false
    var sq = false
    for i in 0..len(s) {
        let c = s[i]
        if !q && (c == ' ' || c == '\n' || c == '\t' || c == '\r') { continue }
        if c == '"' && !sq { q = !q }
        if c == '\'' && !q { sq = !sq }
        out.addByte(if c >= 'a' && c <= 'z' { c - 32 } else { c })
    }
    return out
}

// Past the group "( ... )" that starts at or after at (blanks before it), quotes read: where it ends (n at most).
fn skipGroup(s: &str, at: int, n: int): int {
    var i = at
    while i < n && s[i] == ' ' { i += 1 }
    if i >= n || s[i] != '(' { return i }
    var d = 0
    var sq = false
    while i < n {
        let c = s[i]
        i += 1
        if c == '\'' { sq = !sq }
        if sq { continue }
        if c == '(' { d += 1 }
        if c == ')' {
            d -= 1
            if d == 0 { return i }
        }
    }
    return n
}

// WHERE's tests of ROWNUM (ROWNUM <= n, < n, = n, > n, >= n, among AND's
// conjuncts) taken out of the tokens: the rows Oracle numbers before any
// sort are the first n it makes, a limit. The limit they give (-1: none);
// emptied: nothing was left of the WHERE.
fn (p: mut &P) oraRownum(emptied: mut &bool): int {
    var limit = -1
    while true {
        // the conjuncts: [start, end) token ranges at the top level
        var starts: []int = []
        var ends: []int = []
        var i = p.pos
        var depth = 0
        var start = p.pos
        var between = false
        var hasOr = false
        var done = false
        while !done {
            let t = &p.toks[i]
            if t.kind == T_EOF { break }
            if t.kind == T_OP && t.text == "(" { depth += 1 }
            else if t.kind == T_OP && t.text == ")" {
                if depth == 0 { break }
                depth -= 1
            } else if t.kind == T_OP && t.text == ";" && depth == 0 { break }
            else if depth == 0 && t.kind == T_IDENT {
                match t.text {
                    "group", "order", "having", "union", "except", "intersect", "fetch", "offset", "for", "window", "limit", "connect", "start", "returning", "with", "qualify" { done = true }
                    "or" { hasOr = true }
                    "between" { between = true }
                    "and" {
                        if between { between = false } else {
                            append(mut &starts, start)
                            append(mut &ends, i)
                            start = i + 1
                        }
                    }
                    else {}
                }
            }
            if !done { i += 1 }
        }
        append(mut &starts, start)
        append(mut &ends, i)
        if hasOr { return limit }
        var k = -1
        var lim = -1
        for c in 0..len(starts) {
            if ends[c] - starts[c] != 3 { continue }
            let a = &p.toks[starts[c]]
            let o = &p.toks[starts[c] + 1]
            let b = &p.toks[starts[c] + 2]
            if !(a.kind == T_IDENT && a.text == "rownum" && o.kind == T_OP && b.kind == T_NUM) { continue }
            let nv = strings.parseIntOpt(&b.text).unwrapOr(-1)
            if nv < 0 || strings.contains(&b.text, ".") { continue }
            if o.text == "<=" { lim = nv; k = c }
            else if o.text == "<" { lim = max(nv - 1, 0); k = c }
            else if o.text == "=" { lim = if nv == 1 { 1 } else { 0 }; k = c }
            else if o.text == ">" { lim = if nv >= 1 { 0 } else { -2 }; k = c }
            else if o.text == ">=" { lim = if nv >= 2 { 0 } else { -2 }; k = c }
            if k >= 0 { break }
        }
        if k < 0 { return limit }
        if lim >= 0 { limit = if limit < 0 { lim } else { min(limit, lim) } }
        // out go the conjunct and one AND beside it
        var from = starts[k]
        var to = ends[k]
        if len(starts) == 1 {
            emptied = true
        } else if k == 0 {
            to = to + 1
        } else {
            from = from - 1
        }
        var nt: []Tok = []
        for q in 0..from { append(mut &nt, p.toks[q].clone()) }
        for q in to..len(p.toks) { append(mut &nt, p.toks[q].clone()) }
        p.toks = nt
        if emptied { return limit }
    }
    return limit
}

// A query's limit from ROWNUM (oraRownum): Oracle cuts the rows before it
// sorts, so with an ORDER BY the rows are taken in a subquery first (for a
// query of one table; else the limit is applied after the sort).
fn (p: mut &P) oraLimit(s0: Stmt, n: int): Stmt {
    var s = s0
    let lim = Some(Expr.Lit(Val.Int(n)))
    // (rows are numbered after WHERE and before what follows: the groups, an aggregate over all the rows, DISTINCT, the sort)
    var after = len(s.order) > 0 || len(s.group) > 0 || len(s.gsets) > 0 || s.distinct || s.having.isSome() || len(s.distinctOn) > 0
    for it in s.items { match it.expr { Some(x) { if aggIn(&x) { after = true } } None {} } }
    if !after || len(p.subs) > 0 || len(p.wins) > 0 || len(s.from) != 1 || s.from[0].sub >= 0 {
        s.limit = lim
        return s
    }
    var inner = lexdb_sql.newStmt(S_SELECT)
    append(mut &inner.items, SelItem{star: true, qual: "", expr: None, alias: "", spell: ""})
    inner.from = replace(mut &s.from, [])
    inner.table = s.table.clone()
    inner.where = replace(mut &s.where, None)
    inner.limit = lim
    inner.use = SUB_FROM
    let al = inner.from[0].alias.clone()
    append(mut &s.from, FromItem{table: "", alias: al, join: J_FIRST, on: None, sub: 0, cols: [], work: -1, lateral: false, using: [], natural: false, comma: true})
    s.table = ""
    p.subs = [inner]
    return s
}

// Whether an expression calls an aggregate.
fn aggIn(x: &Expr): bool {
    match x {
        Expr.Call(name, args, _) {
            if lexdb_sql.isAgg(&name) { return true }
            for a in args { if aggIn(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return aggIn(&a) }
        Expr.Bin(_, a, b) { return aggIn(&a) || aggIn(&b) }
        Expr.IsNull(a, _) { return aggIn(&a) }
        Expr.Cast(a, _) { return aggIn(&a) }
        else { return false }
    }
}


// ---- stored procedures and functions (design/lexdb-dialect-gaps.md, package F; lexdb_routine keeps and runs them)

fn emptyRoutine(proc: bool, dialect: int): lexdb_sql.Routine {
    return lexdb_sql.Routine{key: "", spell: "", kind: if proc { lexdb_sql.RK_PROC } else { lexdb_sql.RK_FUNC }, dialect: dialect, params: [],
                             ret: TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0}, retSpell: "", retSet: false, lang: "sql", attrs: "", body: "",
                             def: "", owner: "", atomic: false, code: "", denied: ""}
}

// A type as a function's parameter or result has it: PostgreSQL ignores a modifier (varchar(5), numeric(10, 2)) there.
fn plainType(t: TypeName): TypeName {
    if t.kind == K_NUM { return TypeName{kind: t.kind, oid: t.oid, prec: 0, scale: 0, len: 0} }
    if t.kind == K_TEXT || (lexdb_sql.timeKind(t.oid) > 0) { return TypeName{kind: t.kind, oid: t.oid, prec: 0, scale: 0, len: 0} }
    return t
}

// Whether the tokens at the parser's place are an unnamed parameter's type: a type's name alone, or a word of a type's
// name of several words ("double precision"), or a name with a modifier, a qualifier or []. Else a name comes first.
fn (p: &P) unnamedParam(): bool {
    let a = p.peek()
    let b = p.peekAt(1)
    if a.kind != T_IDENT && a.kind != T_QIDENT { return false }
    if b.kind == T_EOF { return true }
    if b.kind == T_OP && (b.text == "," || b.text == ")" || b.text == "(" || b.text == "." || b.text == "[") { return true }
    if b.kind == T_IDENT && (b.text == "default" || b.text == "precision" || b.text == "varying") { return true }
    if b.kind == T_OP && b.text == "=" { return true }
    if a.kind == T_IDENT && (a.text == "timestamp" || a.text == "time") && b.kind == T_IDENT && (b.text == "with" || b.text == "without") { return true }
    return false
}

// CREATE [OR REPLACE] FUNCTION | PROCEDURE name ([argmode] [name] type [DEFAULT expr], ...) [RETURNS type] attributes,
// after the keyword (PostgreSQL's; a language other than sql is for the executor to refuse, as PostgreSQL does for one
// that is not installed).
fn (p: mut &P) createRoutine(orReplace: bool, proc: bool): Result[Stmt, lexdb_base.DbErr] {
    if p.tsql && proc { return Err(lexdb_base.err("TS111", "'CREATE/ALTER PROCEDURE' must be the first statement in a query batch.")) }
    // (a function that is the batch's first statement is read whole by lexdb_tsqlparse.funcBatch)
    if p.tsql { return Err(lexdb_base.err("TS111", "'CREATE FUNCTION' must be the first statement in a query batch.")) }
    if p.ora { return Err(lexdb_base.err("0A000", "lexdb: CREATE FUNCTION is not supported in this dialect yet")) }
    var s = lexdb_sql.newStmt(S_CREATE_ROUTINE)
    s.ifFlag = orReplace
    var r = emptyRoutine(proc, lexdb_sql.RD_PG)
    r.key = try p.rname()
    r.spell = p.spelled.clone()
    s.table = r.key.clone()
    try p.expectKw("(")
    var seenDefault = false
    if !p.acceptKw(")") {
        while true {
            var mode = "in"
            if p.isKw("in") || p.isKw("out") || p.isKw("inout") || p.isKw("variadic") {
                let m = p.next().text
                mode = m.clone()
                if m == "in" && p.isKw("out") {
                    p.pos += 1
                    mode = "inout"
                }
            }
            var name = ""
            if !p.unnamedParam() { name = try p.name() }
            let typ = plainType(try p.typeName())
            var prm = lexdb_sql.RParam{name: name.clone(), typ: typ, spell: "", mode: mode.clone(), has: false, dflt: "", readonly: false}
            if p.isKw("default") || p.isKw("=") {
                p.pos += 1
                let a = p.peek().at
                p.fresh()
                let d = try p.expr()
                prm.has = true
                prm.dflt = strings.trim(&p.src[a..min(p.peek().at, len(p.src))]).toStr()
                if mode == "out" { return Err(lexdb_base.err("42P13", "only input parameters can have default values")) }
            }
            if prm.has { seenDefault = true }
            else if seenDefault && mode != "out" && mode != "inout" {
                return Err(lexdb_base.err("42P13", "input parameters after one with a default value must also have defaults"))
            }
            if seenDefault && mode == "out" && proc {
                return Err(lexdb_base.err("42P13", "procedure OUT parameters cannot appear after one with a default value"))
            }
            for q in r.params {
                if len(name) > 0 && q.name == name && ((q.mode == "in") == (mode == "in")) {
                    return Err(lexdb_base.err("42P13", &("parameter name \"" + name + "\" used more than once")))
                }
            }
            append(mut &r.params, prm)
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    }
    var haveBody = false
    var haveReturns = false
    while true {
        let t = p.peek().clone()
        if t.kind == T_EOF || (t.kind == T_OP && t.text == ";") { break }
        if t.kind != T_IDENT { return Err(near(&t)) }
        p.pos += 1
        match t.text {
            "returns" {
                if proc { return Err(near(&t)) }
                if p.acceptKw("null") {
                    // RETURNS NULL ON NULL INPUT
                    try p.expectKw("on")
                    try p.expectKw("null")
                    try p.expectKw("input")
                    r.attrs = r.attrs + " strict"
                } else {
                    haveReturns = true
                    if p.acceptKw("setof") { r.retSet = true }
                    if p.isKw("table") && !r.retSet {
                        // RETURNS TABLE (name type, ...): OUT parameters of a set-returning function ("table" in its attrs says so)
                        p.pos += 1
                        for q in r.params { if q.mode == "out" || q.mode == "inout" { return Err(lexdb_base.err("42P13", "OUT and INOUT arguments aren't allowed in TABLE functions")) } }
                        try p.expectKw("(")
                        var cols = 0
                        while true {
                            let cn = try p.name()
                            let ct = plainType(try p.typeName())
                            for q in r.params { if len(cn) > 0 && q.name == cn && q.mode == "out" { return Err(lexdb_base.err("42P13", &("parameter name \"" + cn + "\" used more than once"))) } }
                            append(mut &r.params, lexdb_sql.RParam{name: cn.clone(), typ: ct, spell: "", mode: "out", has: false, dflt: "", readonly: false})
                            cols += 1
                            if !p.acceptKw(",") { break }
                        }
                        try p.expectKw(")")
                        r.retSet = true
                        r.attrs = r.attrs + " table"
                        r.ret = if cols == 1 { r.params[len(r.params) - 1].typ } else { TypeName{kind: K_TEXT, oid: 2249, prec: 0, scale: 0, len: 0} }
                    } else if p.acceptKw("void") { r.ret = TypeName{kind: K_TEXT, oid: 2278, prec: 0, scale: 0, len: 0} }
                    else if p.acceptKw("record") { r.ret = TypeName{kind: K_TEXT, oid: 2249, prec: 0, scale: 0, len: 0} }
                    else { r.ret = plainType(try p.typeName()) }
                }
            }
            "language" {
                let l = p.next()
                if l.kind != T_IDENT && l.kind != T_STR && l.kind != T_QIDENT { return Err(near(&l)) }
                r.lang = strings.toLowerAscii(&l.text)
            }
            "as" {
                let b = p.next()
                if b.kind != T_STR { return Err(near(&b)) }
                r.body = b.text.clone()
                haveBody = true
                if p.acceptKw(",") { let l = p.next() }       // the link symbol of a C function
            }
            "immutable", "stable", "volatile", "strict", "leakproof", "window" { r.attrs = r.attrs + " " + t.text }
            "security" { let d = p.next() }
            "called" {
                try p.expectKw("on")
                try p.expectKw("null")
                try p.expectKw("input")
            }
            "not" { try p.expectKw("leakproof") }
            "external" {
                try p.expectKw("security")
                let d = p.next()
            }
            "parallel", "cost", "rows" { let d = p.next() }
            "set" {
                // SET name { TO | = } value | FROM CURRENT: not kept (lexdb's settings are the session's)
                while !(p.peek().kind == T_EOF || p.isKw(";") || p.isKw("as") || p.isKw("language") || p.isKw("begin") || p.isKw("return")) { p.pos += 1 }
            }
            "begin" {
                // BEGIN ATOMIC statement; ... END: the statements are parsed now, their text kept
                try p.expectKw("atomic")
                let a = p.peek().at
                var z = a
                while true {
                    while p.acceptKw(";") {}
                    if p.isKw("end") || p.peek().kind == T_EOF { break }
                    p.fresh()
                    let st = try p.statement()
                    z = p.peek().at
                    if !p.isKw(";") && !p.isKw("end") { return Err(near(&p.peek())) }
                }
                try p.expectKw("end")
                r.body = strings.trim(&p.src[a..min(z, len(p.src))]).toStr()
                r.atomic = true
                haveBody = true
            }
            "return" {
                // RETURN expression
                if proc { return Err(near(&t)) }
                let a = p.peek().at
                p.fresh()
                let e = try p.expr()
                r.body = "SELECT " + strings.trim(&p.src[a..min(p.peek().at, len(p.src))])
                r.atomic = true
                r.attrs = r.attrs + " return"
                haveBody = true
            }
            else { return Err(near(&t)) }
        }
    }
    if !haveBody { return Err(lexdb_base.err("42P13", "no function body specified")) }
    if !proc && !haveReturns {
        // a function with OUT parameters has its result from them
        var outs = 0
        for q in r.params { if q.mode == "out" || q.mode == "inout" { outs += 1 } }
        if outs == 0 { return Err(lexdb_base.err("42P13", "function result type must be specified")) }
        if outs == 1 {
            for q in r.params { if q.mode == "out" || q.mode == "inout" { r.ret = q.typ } }
        } else {
            r.ret = TypeName{kind: K_TEXT, oid: 2249, prec: 0, scale: 0, len: 0}        // record
        }
    }
    p.fresh()
    append(mut &s.rtn, r)
    return Ok(s)
}

// The argument list after a routine's name in DROP and GRANT: "*" when there is none (any one of the name), else PostgreSQL's
// identity: the types of the IN, INOUT and VARIADIC arguments, comma-separated oids. T-SQL's has no list.
fn (p: mut &P) routineSig(): Result[str, lexdb_base.DbErr] {
    var sig = "*"
    if !p.tsql && p.acceptKw("(") {
        sig = ""
        if !p.acceptKw(")") {
            var oids: []str = []
            while true {
                var mode = "in"
                if p.isKw("in") || p.isKw("out") || p.isKw("inout") || p.isKw("variadic") { mode = p.next().text }
                if !p.unnamedParam() { let nm = try p.name() }
                let ty = try p.typeName()
                if mode != "out" { append(mut &oids, ty.oid.toStr()) }
                if !p.acceptKw(",") { break }
            }
            try p.expectKw(")")
            sig = strings.join(&oids, ",")
        }
    }
    return Ok(sig)
}

// DROP FUNCTION | PROCEDURE | ROUTINE [IF EXISTS] name [(argtypes)], ...: each "key NUL signature" in names (signature "*":
// no list given; PostgreSQL's: the types of the IN, INOUT and VARIADIC arguments, comma-separated oids), the name as
// written in spells, the keyword in index. T-SQL's has no list.
fn (p: mut &P) dropRoutine(kw: &str): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_DROP_ROUTINE)
    s.index = kw.toStr()
    s.mdialect = if p.tsql { lexdb_sql.MD_TSQL } else { lexdb_sql.MD_PG }
    if p.acceptKw("if") {
        try p.expectKw("exists")
        s.ifFlag = true
    }
    while true {
        let at = p.peek().at
        let key = try p.rname()
        let spell = strings.trim(&p.src[at..min(p.peek().at, len(p.src))]).toStr()
        let sig = try p.routineSig()
        append(mut &s.names, key + "\x00" + sig)
        append(mut &s.spells, spell)
        if !p.acceptKw(",") { break }
    }
    if p.acceptKw("cascade") { s.cascade = true } else { let r = p.acceptKw("restrict") }
    return Ok(s)
}

// CALL name(arguments): the name in table, the arguments in rows[0], each one's name (name => value) in names.
fn (p: mut &P) callStmt(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_CALL)
    s.table = try p.rname()
    s.spell = p.spelled.clone()
    try p.expectKw("(")
    var args: []Expr = []
    if !p.acceptKw(")") {
        while true {
            // name => value, name := value: the name kept in names, "" for a place
            var nm = ""
            if (p.peek().kind == T_IDENT || p.peek().kind == T_QIDENT) && p.peekAt(1).kind == T_OP && p.peekAt(2).kind == T_OP &&
               ((p.peekAt(1).text == "=" && p.peekAt(2).text == ">") || (p.peekAt(1).text == ":" && p.peekAt(2).text == "=")) {
                nm = p.peek().text.clone()
                p.pos += 3
            }
            append(mut &s.names, nm)
            append(mut &args, try p.expr())
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    }
    append(mut &s.rows, args)
    return Ok(s)
}

// A T-SQL procedure's header, after CREATE [OR ALTER] PROC[EDURE]: its name, and parameters
// ([(] @p [AS] type [VARYING] [= default] [OUT | OUTPUT] [READONLY], ... [)]), up to AS (WITH options skipped). The routine has
// no body or text yet (lexdb_tsqlparse puts them).
pub fn (q: mut &Parser) procHeader(): Result[lexdb_sql.Routine, lexdb_base.DbErr] {
    var r = emptyRoutine(true, lexdb_sql.RD_TSQL)
    r.lang = "tsql"
    let at = q.p.peek().at
    r.key = try q.p.qname()
    r.spell = strings.trim(&q.p.src[at..min(q.p.peek().at, len(q.p.src))]).toStr()
    // a procedure number, ;1
    if q.p.isKw(";") && q.p.peekAt(1).kind == T_NUM { q.p.pos += 2 }
    let paren = q.p.acceptKw("(")
    try q.routineParams(mut &r)
    if paren { try q.p.expectKw(")") }
    // WITH options (RECOMPILE, ENCRYPTION, EXECUTE AS ...), FOR REPLICATION: read to AS
    while !q.p.isKw("as") {
        if q.p.peek().kind == T_EOF { return Err(near(&q.p.peek())) }
        q.p.pos += 1
    }
    return Ok(r)
}

// The parameters of a T-SQL procedure or function: @p [AS] type [VARYING] [= default] [OUT | OUTPUT] [READONLY], ...
fn (q: mut &Parser) routineParams(r: mut &lexdb_sql.Routine): Result[Unit, lexdb_base.DbErr] {
    while q.p.peek().kind == T_VAR {
        let v = q.p.next()
        for x in r.params {
            if x.name == v.text { return Err(lexdb_base.err("TS134", &("The variable name '" + v.text + "' has already been declared. Variable names must be unique within a query batch or stored procedure."))) }
        }
        let a = q.p.acceptKw("as")
        let tstart = q.p.peek().at
        let pt = try q.paramType()
        var prm = lexdb_sql.RParam{name: v.text.clone(), typ: pt.typ, spell: strings.trim(&q.p.src[tstart..min(q.p.peek().at, len(q.p.src))]).toStr(),
                                   mode: "in", has: false, dflt: "", readonly: false}
        let vary = q.p.acceptKw("varying")
        if q.p.isKw("=") {
            q.p.pos += 1
            let d0 = q.p.peek().at
            q.p.fresh()
            let d = try q.p.expr()
            prm.has = true
            prm.dflt = strings.trim(&q.p.src[d0..min(q.p.peek().at, len(q.p.src))]).toStr()
        }
        if q.p.acceptKw("output") || q.p.acceptKw("out") { prm.mode = "out" }
        if q.p.acceptKw("readonly") { prm.readonly = true }
        append(mut &r.params, prm)
        if !q.p.acceptKw(",") { break }
    }
    return Ok(Unit{})
}

// A T-SQL function's header, after CREATE [OR ALTER] FUNCTION (or ALTER FUNCTION): its name, (parameters), RETURNS and WITH
// options, up to the body's BEGIN (a scalar or multi-statement function) or RETURN (an inline one), which it leaves
// unread; an AS before it is read. attrs: "scalar", "inline" or "multi", then the options kept (schemabinding). A scalar
// function's type is in ret (and as written in retSpell); the others have retSet, a multi-statement function's table
// declaration (@t TABLE (...)) in retSpell.
pub fn (q: mut &Parser) funcHeader(): Result[lexdb_sql.Routine, lexdb_base.DbErr] {
    var r = emptyRoutine(false, lexdb_sql.RD_TSQL)
    r.lang = "tsql"
    let at = q.p.peek().at
    r.key = try q.p.qname()
    r.spell = strings.trim(&q.p.src[at..min(q.p.peek().at, len(q.p.src))]).toStr()
    try q.p.expectKw("(")
    try q.routineParams(mut &r)
    try q.p.expectKw(")")
    try q.p.expectKw("returns")
    var attrs = ""
    if q.p.peek().kind == T_VAR {
        // RETURNS @t TABLE (columns)
        let ts = q.p.peek().at
        q.p.pos += 1
        try q.p.expectKw("table")
        try q.p.expectKw("(")
        var depth = 1
        while depth > 0 {
            let t = q.p.next()
            if t.kind == T_EOF { return Err(near(&t)) }
            if t.kind == T_OP && t.text == "(" { depth += 1 }
            if t.kind == T_OP && t.text == ")" { depth -= 1 }
        }
        r.retSet = true
        r.retSpell = strings.trim(&q.p.src[ts..min(q.p.peek().at, len(q.p.src))]).toStr()
        attrs = "multi"
    } else if q.p.acceptKw("table") {
        r.retSet = true
        attrs = "inline"
    } else {
        let ts = q.p.peek().at
        let pt = try q.paramType()
        if len(pt.key) > 0 { return Err(lexdb_base.err("TS2715", &("Column, parameter, or variable #1: Cannot find data type " + pt.written + "."))) }
        r.ret = pt.typ
        r.retSpell = strings.trim(&q.p.src[ts..min(q.p.peek().at, len(q.p.src))]).toStr()
        attrs = "scalar"
    }
    if q.p.acceptKw("with") {
        // the options up to the body (EXECUTE AS CALLER has its own AS)
        while true {
            let t = q.p.peek().clone()
            if t.kind == T_EOF { return Err(near(&t)) }
            if t.kind == T_IDENT && (t.text == "begin" || t.text == "return" || t.text == "as") { break }
            if t.kind == T_IDENT && t.text == "schemabinding" { attrs += " schemabinding" }
            q.p.pos += 1
            if t.kind == T_IDENT && t.text == "execute" && q.p.isKw("as") { q.p.pos += 1 }
        }
    }
    let a = q.p.acceptKw("as")
    r.attrs = attrs
    return Ok(r)
}

// A T-SQL query (an inline table-valued function's body) read with the variables vars ($1, $2, ... in that order).
pub fn tsqlSelect(sql: &str, vars: &[]str): Result[Stmt, lexdb_base.DbErr] {
    var q = try tsqlParser(sql, Dialect{tsql: true, quotedIdent: true}, vars)
    let s = try q.statement()
    while q.p.acceptKw(";") {}
    if q.p.peek().kind != T_EOF { return Err(near(&q.p.peek())) }
    return Ok(s)
}

// Where the next token starts, and the source text (a procedure's body, after its AS).
pub fn (q: &Parser) here(): int { return q.p.peek().at }
pub fn (q: &Parser) source(): &str { return &q.p.src }

// A SQL function's body with each use of a named input parameter written as $n (names[i] is $nums[i]): fname.name too. A
// name after a "." or before a "(" is a column's or a function's and stays.
pub fn substParams(body: &str, fname: &str, names: &[]str, nums: &[]int): Result[str, lexdb_base.DbErr] {
    let toks = try lex(body)
    var out = ""
    var last = 0
    var i = 0
    while i < len(toks) {
        let t = &toks[i]
        if t.kind != T_IDENT {
            i += 1
            continue
        }
        let prevDot = i > 0 && toks[i - 1].kind == T_OP && toks[i - 1].text == "."
        let nextParen = i + 1 < len(toks) && toks[i + 1].kind == T_OP && toks[i + 1].text == "("
        var k = -1
        for j in 0..len(names) { if names[j] == t.text { k = j } }
        if !prevDot && t.text == fname && i + 2 < len(toks) && toks[i + 1].kind == T_OP && toks[i + 1].text == "." && toks[i + 2].kind == T_IDENT {
            var q = -1
            for j in 0..len(names) { if names[j] == toks[i + 2].text { q = j } }
            if q >= 0 {
                out += body[last..t.at]
                out += "$" + nums[q].toStr()
                last = toks[i + 2].at + len(toks[i + 2].text)
                i += 3
                continue
            }
        }
        if k >= 0 && !prevDot && !nextParen {
            out += body[last..t.at]
            out += "$" + nums[k].toStr()
            last = t.at + len(t.text)
        }
        i += 1
    }
    out += body[last..len(body)]
    return Ok(out)
}

// RETURNING's list, after RETURNING.
fn (p: mut &P) returningList(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if p.tsql { return p.itemList(mut &s.items) }
    // the name the target's columns are bound by (an INSERT's alias too: lexdb_exec.insFrom)
    let q = if len(s.alias) > 0 { s.alias.toStr() } else { lexdb_sql.baseName(&s.table) }
    if p.ora {
        let marked = try p.oraOldNew()
        try p.itemList(mut &s.items)
        if marked { lexdb_oldnew.oraRefs(mut &s.items, &q) }
        return Ok(Unit{})
    }
    var ns = lexdb_oldnew.defaults()
    if p.isKw("with") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
        p.pos += 2
        while true {
            let w = p.peek().clone()
            if !(w.kind == T_IDENT && (w.text == "old" || w.text == "new")) { return Err(near(&w)) }
            p.pos += 1
            try p.expectKw("as")
            let n = try p.name()
            if w.text == "old" {
                if ns.oldGiven { return Err(syntax("OLD cannot be specified multiple times")) }
                ns.old = n
                ns.oldGiven = true
            } else {
                if ns.newGiven { return Err(syntax("NEW cannot be specified multiple times")) }
                ns.new = n
                ns.newGiven = true
            }
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
        if ns.oldGiven && ns.newGiven && ns.old == ns.new {
            return Err(lexdb_base.err("42712", &("table name \"" + ns.new + "\" specified more than once")))
        }
    }
    try p.itemList(mut &s.items)
    return lexdb_oldnew.refs(mut &s.items, &ns, &q, &s.from)
}

// Oracle's RETURNING OLD c and NEW c (23ai), at RETURNING's first item: the word and its column (c or t.c) made the
// column lexdb_oldnew.ORA_OLD.c (ORA_NEW.c), in the tokens up to the end of the statement (or INTO); true if there was one.
// As Oracle: the word always is OLD or NEW there, ORA-03050 when no column follows, ORA-00904 for a function.
fn (p: mut &P) oraOldNew(): Result[bool, lexdb_base.DbErr] {
    var at = -1
    var k = p.pos
    while k < len(p.toks) && p.toks[k].kind != T_EOF && !(p.toks[k].kind == T_IDENT && p.toks[k].text == "into") &&
          !(p.toks[k].kind == T_OP && p.toks[k].text == ";") {
        if at < 0 && p.toks[k].kind == T_IDENT && (p.toks[k].text == "old" || p.toks[k].text == "new") { at = k }
        k += 1
    }
    if at < 0 { return Ok(false) }
    let end = k
    var out: []Tok = []
    for i in 0..p.pos { append(mut &out, p.toks[i].clone()) }
    var i = p.pos
    while i < end {
        let t = p.toks[i].clone()
        if !(t.kind == T_IDENT && (t.text == "old" || t.text == "new")) {
            append(mut &out, t)
            i += 1
            continue
        }
        let c = p.peekTok(i + 1)
        if c.kind == T_OP && c.text == "." {
            // old.c: a table old's column
            let n = p.peekTok(i + 2)
            return Err(lexdb_base.err("ORA00904", &("\"" + strings.toUpperAscii(&t.text) + "\".\"" + strings.toUpperAscii(&n.text) + "\": invalid identifier")))
        }
        if c.kind == T_OP && c.text == "*" { return Err(lexdb_base.err("ORA01747", "invalid column specification: \"*\"")) }
        if !(c.kind == T_IDENT || c.kind == T_QIDENT) || (c.kind == T_IDENT && c.text == "into") {
            let w = if c.kind == T_EOF { "INTO" } else { strings.toUpperAscii(&c.text) }
            return Err(lexdb_base.err("ORA03050", &("invalid identifier: \"" + w + "\" is a reserved word")))
        }
        var col = i + 1
        let n1 = p.peekTok(i + 2)
        if n1.kind == T_OP && n1.text == "(" {
            return Err(lexdb_base.err("ORA00904", &("\"" + strings.toUpperAscii(&c.text) + "\": invalid identifier")))
        }
        // OLD t.c: t is the target (the only table RETURNING sees)
        if n1.kind == T_OP && n1.text == "." && (p.peekTok(i + 3).kind == T_IDENT || p.peekTok(i + 3).kind == T_QIDENT) { col = i + 3 }
        let q = if t.text == "old" { lexdb_oldnew.ORA_OLD } else { lexdb_oldnew.ORA_NEW }
        append(mut &out, Tok{kind: T_IDENT, text: q.toStr(), at: t.at, spell: q.toStr()})
        append(mut &out, Tok{kind: T_OP, text: ".", at: t.at, spell: "."})
        append(mut &out, p.toks[col].clone())
        i = col + 1
    }
    for j in end..len(p.toks) { append(mut &out, p.toks[j].clone()) }
    p.toks = out
    return Ok(true)
}

fn (p: &P) peekTok(i: int): Tok { return if i < len(p.toks) { p.toks[i].clone() } else { p.toks[len(p.toks) - 1].clone() } }

// A query: the select list to HAVING.
fn (p: mut &P) selectCore(): Result[Stmt, lexdb_base.DbErr] {
    var s = lexdb_sql.newStmt(S_SELECT)
    if p.acceptKw("distinct") {
        if p.acceptKw("on") {
            // DISTINCT ON (exprs) (9.94)
            try p.expectKw("(")
            append(mut &s.distinctOn, try p.expr())
            while p.acceptKw(",") { append(mut &s.distinctOn, try p.expr()) }
            try p.expectKw(")")
        } else {
            s.distinct = true
        }
    } else {
        let all = p.acceptKw("all")
    }
    if p.tsql && p.acceptKw("top") { try p.top(mut &s, true) }
    try p.itemListAssign(mut &s.items, mut &s.assign)
    if len(s.assign) > 0 {
        while len(s.assign) < len(s.items) { append(mut &s.assign, "") }
        var ats: []int = []
        for a in s.assign {
            if len(a) == 0 { return Err(lexdb_base.err("TS141", "A SELECT statement that assigns a value to a variable must not be combined with data-retrieval operations.")) }
            // its parameter: the variable's place
            var at = 0
            for k in 0..len(p.vars) { if p.vars[k] == a { at = k + 1 } }
            append(mut &ats, at)
        }
        s.assignAt = ats
    }
    if p.acceptKw("into") {
        // SELECT ... INTO [TEMPORARY | UNLOGGED] [TABLE] name (9.88)
        let gl = p.acceptKw("global") || p.acceptKw("local")
        s.temp = p.acceptKw("temporary") || p.acceptKw("temp")
        if gl && !s.temp { return Err(near(&p.peek())) }
        let ul = !s.temp && p.acceptKw("unlogged")
        let tb = p.acceptKw("table")
        s.into = try p.qname()
        s.spell = p.spelled.clone()
    }
    if p.acceptKw("from") {
        try p.fromList(mut &s.from, J_FIRST)
        s.table = s.from[0].table.clone()
    }
    var rn = -1
    if p.acceptKw("where") {
        var emptied = false
        if p.ora { rn = p.oraRownum(mut &emptied) }
        if !emptied { s.where = Some(try p.expr()) }
    }
    if p.ora {
        try oraOuterJoins(mut &s)
        // START WITH, CONNECT BY: a hierarchical query (hierTail)
        if (p.isKw("start") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "with") || (p.isKw("connect") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "by") {
            return p.hierTail(s, rn)
        }
    }
    // (a clause word follows, or the end: the token's kind, read once, tells the common end from the clauses)
    if p.peek().kind == T_IDENT {
        if p.acceptKw("group") {
            try p.expectKw("by")
            try p.groupBy(mut &s)
            if len(s.sets) > 0 {
                // T-SQL's GROUP BY ALL (marked by groupBy): HAVING's aggregates too
                if p.acceptKw("having") { s.having = Some(try p.expr()) }
                p.groupAll(mut &s)
            }
        }
        if p.acceptKw("having") {
            s.mdialect = p.md()
            s.having = Some(try p.expr())
        }
        if p.acceptKw("window") {
            // WINDOW name AS (spec), ...
            while true {
                let n = try p.name()
                try p.expectKw("as")
                try p.expectKw("(")
                let d = try p.winSpec()
                for w in s.windows { if w.name == n { return Err(lexdb_base.err("42P20", &("window \"" + n + "\" is already defined"))) } }
                append(mut &s.windows, NamedWin{name: n, def: d})
                if !p.acceptKw(",") { break }
            }
        }
        // Oracle 26ai's QUALIFY (design/lexdb-new-features.md 10.4)
        if p.ora && p.isKw("qualify") { try p.oraQualify(mut &s) }
    }
    p.rnLimit = rn
    return Ok(s)
}

// Oracle 26ai's GROUP BY ALL, at ALL: every select item without an aggregate or a window call (lexdb_sql.GB_ALL); alone,
// as Oracle has it (ORA-03048 for a comma or another ALL after it, ORA-03049 for ROLLUP, CUBE, GROUPING SETS or an
// expression).
fn (p: mut &P) oraGroupAll(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    p.pos += 1
    s.mdialect = p.md()
    let t = p.peek().clone()
    let ends = t.kind == T_EOF || (t.kind == T_OP && (t.text == ")" || t.text == ";")) ||
               (t.kind == T_IDENT && (t.text == "having" || t.text == "order" || t.text == "union" || t.text == "intersect" || t.text == "minus" ||
                                      t.text == "except" || t.text == "fetch" || t.text == "offset" || t.text == "for" || t.text == "window" ||
                                      t.text == "qualify"))
    if !ends {
        if (t.kind == T_OP && t.text == ",") || (t.kind == T_IDENT && t.text == "all") {
            return Err(lexdb_base.err("ORA03048", &("SQL reserved word '" + strings.toUpperAscii(&t.text) + "' is not syntactically valid following '...group by all'")))
        }
        return Err(lexdb_base.err("ORA03049", &("SQL keyword '" + strings.toUpperAscii(&t.text) + "' is not syntactically valid following '...group by all '")))
    }
    append(mut &s.group, Expr.Call(lexdb_sql.GB_ALL.toStr(), [], false))
    return Ok(Unit{})
}

// PostgreSQL 18's NOT NULL constraints with a name (nns: "column\x00name", "" no name; a table constraint's, and a column's CONSTRAINT n
// NOT NULL) on s's columns: NOT NULL; 42703 for a column not there, 42601 for two names of one column. The names are kept in s.names
// (the same entries, a column's once: CREATE TABLE has no other use for it; lexdb_nncon, design/lexdb-new-features.md P7).
fn nnCons(s: mut &Stmt, nns: &[]str): Result[Unit, lexdb_base.DbErr] {
    for k in 0..len(nns) {
        let z = strings.indexOf(&nns[k], "\x00", 0)
        let c = nns[k][0..z].toStr()
        let n = nns[k][z + 1..len(nns[k])].toStr()
        for j in 0..k {
            let z2 = strings.indexOf(&nns[j], "\x00", 0)
            let n2 = nns[j][z2 + 1..len(nns[j])].toStr()
            if nns[j][0..z2] == c && len(n) > 0 && len(n2) > 0 && n != n2 {
                return Err(syntax(&("conflicting not-null constraint names \"" + n2 + "\" and \"" + n + "\"")))
            }
        }
        var found = false
        for i in 0..len(s.cols) { if s.cols[i].name == c { s.cols[i].notNull = true; found = true } }
        if !found {
            return Err(lexdb_base.err("42703", &("column \"" + c + "\" of relation \"" + lexdb_sql.baseName(&s.table) + "\" does not exist")))
        }
        if len(n) > 0 && !lexdb_base.hasStr(&s.names, &nns[k]) { append(mut &s.names, nns[k].clone()) }
    }
    return Ok(Unit{})
}

// Oracle 26ai's INSERT INTO t [(cols)] BY NAME | BY POSITION query, at BY.
fn (p: mut &P) oraInsertBy(s0: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var s = s0
    if !(p.peekAt(1).kind == T_IDENT && (p.peekAt(1).text == "name" || p.peekAt(1).text == "position")) { return Err(near(&p.peek())) }
    let byName = p.peekAt(1).text == "name"
    p.pos += 2
    if p.isKw("values") {
        return Err(oraErr(63878, "BY NAME or POSITION are semantic modifiers of the subquery only and are not compatible with the VALUES clause."))
    }
    if p.isKw("with") {
        s = try p.insertWith(s)
    } else {
        var q2 = lexdb_sql.newStmt(S_SELECT)
        if p.isKw("(") { q2 = try p.parenSelect() } else {
            try p.expectKw("select")
            q2 = try p.select()
        }
        q2.subs = replace(mut &p.subs, [])
        q2.wins = replace(mut &p.wins, [])
        q2.params = p.params
        append(mut &s.inner, q2)
        try p.oraNoReturning()
    }
    if byName { try oraByName(mut &s) }
    return Ok(s)
}

// Oracle 26ai's INSERT ... BY NAME: the query's column names (its first SELECT's) are the columns written, in its order;
// with a column list, exactly the list's (ORA-63877). Each item has a name: an alias or a column (ORA-63875), once
// (ORA-63876). lexdb: a * there is not supported.
fn oraByName(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    if len(s.inner) != 1 { return Ok(Unit{}) }
    var branches: [][]str = []
    try byNames(&s.inner[0], mut &branches)
    let names = branches[0].clone()
    for b in branches {
        // (a later branch's names are the columns too: one the first has not, Oracle's ORA-00904 for it)
        for n in b { if !lexdb_base.hasStr(&names, &n) { return Err(oraErr(904, &("\"" + strings.toUpperAscii(&n) + "\": invalid identifier"))) } }
    }
    if len(s.names) > 0 {
        var same = len(s.names) == len(names)
        for n in names { if !lexdb_base.hasStr(&s.names, &n) { same = false } }
        if !same { return Err(oraErr(63877, "The explicit column list does not exactly match the exposed column names.")) }
    }
    s.names = names
    return Ok(Unit{})
}

// The names of each SELECT of q (its branches, left to right), for BY NAME.
fn byNames(q: &Stmt, out: mut &[][]str): Result[Unit, lexdb_base.DbErr] {
    if q.setop != 0 && len(q.inner) == 2 {
        try byNames(&q.inner[0], out)
        return byNames(&q.inner[1], out)
    }
    var names: []str = []
    for it in q.items {
        if it.star { return Err(lexdb_base.err("0A000", "lexdb: INSERT ... BY NAME of a query with * is not supported")) }
        var n = it.alias.clone()
        if len(n) == 0 {
            match &it.expr {
                Some(x) {
                    match x {
                        Expr.Col(c, _) { n = colOf(&c) }
                        else {}
                    }
                }
                None {}
            }
        }
        if len(n) == 0 { return Err(oraErr(63875, "Non-aliased expressions or constants are not allowed in a BY NAME clause.")) }
        for m in names { if m == n { return Err(oraErr(63876, "No duplicated exposed column names are allowed in the BY NAME clause.")) } }
        append(mut &names, n)
    }
    append(out, names)
    return Ok(Unit{})
}

// Oracle 26ai's INSERT INTO t SET c = v | DEFAULT, (c, d) = (v, w), ... at SET: one row of VALUES with the columns named
// (ORA-00957 for a column twice, ORA-00947 / ORA-00913 for a list of other length); then RETURNING. lexdb: a list set
// from a subquery, (c, d) = (SELECT ...), is not supported.
fn (p: mut &P) oraInsertSet(s0: Stmt): Result[Stmt, lexdb_base.DbErr] {
    var s = s0
    p.pos += 1
    var row: []Expr = []
    while true {
        var cols: []str = []
        if p.acceptKw("(") {
            append(mut &cols, try p.name())
            while p.acceptKw(",") { append(mut &cols, try p.name()) }
            try p.expectKw(")")
        } else {
            append(mut &cols, try p.name())
        }
        try p.expectKw("=")
        var vals: []Expr = []
        if len(cols) > 1 {
            if p.isKw("(") && p.parenQueryStart() { return Err(lexdb_base.err("0A000", "lexdb: INSERT ... SET (columns) = (subquery) is not supported")) }
            try p.expectKw("(")
            append(mut &vals, try p.valueOrDefault())
            while p.acceptKw(",") { append(mut &vals, try p.valueOrDefault()) }
            try p.expectKw(")")
            if len(vals) < len(cols) { return Err(oraErr(947, "not enough values")) }
            if len(vals) > len(cols) { return Err(oraErr(913, "too many values")) }
        } else {
            append(mut &vals, try p.valueOrDefault())
        }
        for c in cols {
            if lexdb_base.hasStr(&s.names, &c) { return Err(oraErr(957, "duplicate column name")) }
            append(mut &s.names, c)
        }
        for v in vals { append(mut &row, v) }
        if !p.acceptKw(",") { break }
    }
    append(mut &s.rows, row)
    try p.returning(mut &s)
    return Ok(s)
}

// Oracle: an INSERT ... SELECT has no RETURNING (ORA-03049 at its first item).
fn (p: mut &P) oraNoReturning(): Result[Unit, lexdb_base.DbErr] {
    if !(p.ora && p.isKw("returning")) { return Ok(Unit{}) }
    let w = p.peekAt(1).text.clone()
    return Err(lexdb_base.err("ORA03049", &("SQL keyword '" + strings.toUpperAscii(&w) + "' is not syntactically valid following '... returning '")))
}

// A column's DEFAULT, after DEFAULT; Oracle's ON NULL [FOR INSERT ONLY | FOR INSERT AND UPDATE] first (lexdb_sql.ON_NULL),
// and ORA-02000 (FOR UPDATE), ORA-00936 (no expression), ORA-30665 (NULL after it) as Oracle.
fn (p: mut &P) oraDefault(): Result[Expr, lexdb_base.DbErr] {
    if !(p.ora && p.isKw("on") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "null") { return p.defaultExpr() }
    p.pos += 2
    var f = lexdb_sql.ON_NULL
    if p.acceptKw("for") {
        if !p.acceptKw("insert") { return Err(oraErr(2000, "missing INSERT keyword")) }
        if p.acceptKw("and") {
            try p.expectKw("update")
            f = lexdb_sql.ON_NULL_UPD
        } else {
            try p.expectKw("only")
        }
    }
    let t = p.peek().clone()
    if t.kind == T_EOF || (t.kind == T_OP && (t.text == "," || t.text == ")")) { return Err(oraErr(936, "missing expression")) }
    let x = try p.defaultExpr()
    if p.isKw("null") { return Err(oraErr(30665, "invalid NOT NULL constraint specified on a DEFAULT ON NULL column")) }
    return Ok(Expr.Call(f.toStr(), [x], false))
}

// T-SQL's & | ^ (XOR, lexed as lexdb's #) of two values, and << >> (SQL Server 2022: LEFT_SHIFT, RIGHT_SHIFT, as wide as
// the value's type: #tbit_shl, lexdb_tsqlfn).
fn tsqlBitOp(op: &str, l: Expr, r: Expr): Expr {
    if op == "<<" { return Expr.Call("#tbit_shl", [l, r], false) }
    if op == ">>" { return Expr.Call("#tbit_shr", [l, r], false) }
    return Expr.Bin(op.toStr(), bitInt(l), bitInt(r))
}

// T-SQL's compound assignment, at its operator: +=, -=, *=, /=, %=, &=, |=, ^= and SQL Server 2025's ||= (S9); the
// operator, read with its =, or "" (none there).
pub fn (p: mut &P) tsqlCompound(): str {
    let o = p.peek().clone()
    if o.kind != T_OP || p.peekAt(1).kind != T_OP || p.peekAt(1).text != "=" { return "" }
    if o.text == "+" || o.text == "-" || o.text == "*" || o.text == "/" || o.text == "%" || o.text == "&" || o.text == "|" ||
       o.text == "#" || o.text == "||" {
        p.pos += 2
        return o.text.clone()
    }
    return ""
}

// target op= e as target = target op e.
pub fn tsqlAssign(op: &str, target: Expr, e: Expr): Expr {
    if op == "+" { return Expr.Bin("t+", target, e) }
    if op == "&" || op == "|" || op == "#" { return tsqlBitOp(op, target, e) }
    return Expr.Bin(op.toStr(), target, e)
}

// A column reference's column: c of t.c.
fn colOf(n: &str): str {
    var d = -1
    for k in 0..len(n) { if n[k] == '.' { d = k } }
    return if d < 0 { n.clone() } else { n[d + 1..len(n)].toStr() }
}

// ---- the newest releases' functions (lexdb_newfn; design/lexdb-new-features.md 6.1 items 6 and 7)

// An aggregate's name in the T-SQL or Oracle door (ora): T-SQL's PRODUCT is #product; Oracle's BIT_AND_AGG, BIT_OR_AGG and
// BIT_XOR_AGG are PostgreSQL's bit_and, bit_or, bit_xor marked " dia:o" (0 over no rows), BOOLEAN_AND_AGG and BOOLEAN_OR_AGG
// bool_and and bool_or, KURTOSIS_ and SKEWNESS_ #kurtosis_ and #skewness_. Any other name as it is.
fn newAggName(f: str, ora: bool): str {
    if !ora { return if f == "product" { "#product" } else { f } }
    match f.toStr() {
        "bit_and_agg" { return "bit_and dia:o" }
        "bit_or_agg" { return "bit_or dia:o" }
        "bit_xor_agg" { return "bit_xor dia:o" }
        "boolean_and_agg" { return "bool_and" }
        "boolean_or_agg" { return "bool_or" }
        "kurtosis_pop", "kurtosis_samp", "skewness_pop", "skewness_samp" { return "#" + f }
        // (AVG of a YEAR TO MONTH interval: whole months, lexdb_agg.finish)
        "avg" { return "avg dia:o" }
        else { return f }
    }
}

fn tsArgs(name: &str, lo: int, hi: int): lexdb_base.DbErr {
    if lo == hi { return lexdb_base.err("TS174", &("The " + name + " function requires " + lo.toStr() + " argument(s).")) }
    return lexdb_base.err("TS189", &("The " + name + " function requires " + lo.toStr() + " to " + hi.toStr() + " arguments."))
}

fn tsNullArg(fname: &str, k: int): lexdb_base.DbErr {
    return lexdb_base.err("TS8116", &("Argument data type NULL is invalid for argument " + (k + 1).toStr() + " of " + fname + " function."))
}

// T-SQL's newer functions (SQL Server 2022's DATE_BUCKET and DATETRUNC, 2025's BASE64_ENCODE, BASE64_DECODE, UNISTR and
// fuzzy matching): lexdb_newfn's #n_t... calls; any other call as it is.
fn tsqlNewCall(name: &str, args: []Expr, star: bool): Result[Expr, lexdb_base.DbErr] {
    let n = len(args)
    var a = args
    match name.toStr() {
        "date_bucket" {
            if n < 3 || n > 4 { return Err(tsArgs(name, 3, 4)) }
            match datePart(&a[0]) {
                Some(dp) { a[0] = dp }
                None { return Err(lexdb_base.err("TS155", &("'" + lexdb_sql.exprText(&a[0]) + "' is not a recognized date_bucket option."))) }
            }
            for k in 1..3 { if isNullLit(&a[k]) { return Err(tsNullArg(&"Date_Bucket", k)) } }
            return Ok(Expr.Call("#n_tbucket", a, false))
        }
        "datetrunc" {
            if n != 2 { return Err(tsArgs(name, 2, 2)) }
            var w = ""
            match a[0] {
                Expr.Col(c, _) { w = c.clone() }
                Expr.Lit(v) { match v { Val.Text(s) { w = strings.toLowerAscii(&s) } else {} } }
                else {}
            }
            if w == "iso_week" || w == "isowk" || w == "isoww" { a[0] = Expr.Lit(Val.Text("iso_week")) } else {
                match datePart(&a[0]) {
                    Some(dp) { a[0] = dp }
                    None { return Err(lexdb_base.err("TS155", &("'" + lexdb_sql.exprText(&a[0]) + "' is not a recognized datetrunc option."))) }
                }
            }
            // a string is read as a datetime2(7), as SQL Server's
            if isTextLit(&a[1]) {
                var dt = lexdb_sql.timeType(OID_TS)
                dt.prec = 1
                dt.scale = 7
                a[1] = Expr.Cast(replace(mut &a[1], Expr.Lit(Val.Null)), dt)
            }
            return Ok(Expr.Call("#n_ttrunc", a, false))
        }
        "base64_encode" {
            if n < 1 || n > 2 { return Err(tsArgs(name, 1, 2)) }
            return Ok(Expr.Call("#n_tb64e", a, false))
        }
        "base64_decode" {
            if n != 1 { return Err(tsArgs(name, 1, 1)) }
            return Ok(Expr.Call("#n_tb64d", a, false))
        }
        "unistr" {
            if n < 1 || n > 2 { return Err(tsArgs(name, 1, 2)) }
            return Ok(Expr.Call("#n_tunistr", a, false))
        }
        "edit_distance" {
            if n < 2 || n > 3 { return Err(tsArgs(name, 2, 3)) }
            return Ok(Expr.Call("#n_tedit", a, false))
        }
        "edit_distance_similarity", "jaro_winkler_distance", "jaro_winkler_similarity" {
            if n != 2 { return Err(tsArgs(name, 2, 2)) }
            let f = if name == "edit_distance_similarity" { "#n_teditsim" } else if name == "jaro_winkler_distance" { "#n_tjwd" } else { "#n_tjws" }
            return Ok(Expr.Call(f, a, false))
        }
        else { return Ok(Expr.Call(name.toStr(), a, star)) }
    }
}

// Oracle's newer functions (23ai's TIME_BUCKET and TO_BOOLEAN, 26ai's UUID, IS_UUID, RAW_TO_UUID, UUID_TO_RAW, UNISTR,
// UTL_MATCH's): lexdb_newfn's #n_o... calls; any other call as it is.
fn oraNewCall(name: &str, args: []Expr, star: bool): Result[Expr, lexdb_base.DbErr] {
    let n = len(args)
    var f = ""
    var lo = 1
    var hi = 1
    match name.toStr() {
        "time_bucket" {
            f = "#n_obucket"
            lo = 3
            hi = 4
        }
        "uuid" {
            f = "#n_ouuid"
            lo = 0
            hi = 0
        }
        "is_uuid" { f = "#n_oisuuid" }
        "raw_to_uuid" { f = "#n_orawuuid" }
        "uuid_to_raw" { f = "#n_ouuidraw" }
        "unistr" { f = "#n_ounistr" }
        "to_boolean" { f = "#n_otobool" }
        "utl_match_edit_distance" { f = "#n_oedit" }
        "utl_match_edit_distance_similarity" { f = "#n_oeditsim" }
        "utl_match_jaro_winkler" { f = "#n_ojw" }
        "utl_match_jaro_winkler_similarity" { f = "#n_ojws" }
        "ceil", "floor" {
            f = if name == "ceil" { "#n_oceil" } else { "#n_ofloor" }
            hi = 2
        }
        "dateadd", "datediff", "timestampdiff" { return oraDateAdd(name, args) }
        else { return Ok(Expr.Call(name.toStr(), args, star)) }
    }
    if strings.startsWith(name, "utl_match_") {
        lo = 2
        hi = 2
    }
    if n < lo || n > hi { return Err(orArgs(name)) }
    return Ok(Expr.Call(f, args, false))
}

// Oracle 26ai's DATEADD(part, n, d), DATEDIFF(part, a, b) and TIMESTAMPDIFF: T-SQL's kernels (#dateadd, #datediff) under
// Oracle's names: a part by its whole name (ORA-00904 for another), n rounded.
fn oraDateAdd(name: &str, args: []Expr): Result[Expr, lexdb_base.DbErr] {
    if len(args) != 3 { return Err(orArgs(name)) }
    var a = args
    var w = ""
    match a[0] { Expr.Col(c, _) { w = c.clone() } else {} }
    match w.toStr() {
        "year", "quarter", "month", "week", "day", "hour", "minute", "second", "millisecond", "microsecond", "nanosecond" {}
        else { return Err(oraErr(904, &("\"" + strings.toUpperAscii(&lexdb_sql.exprText(&a[0])) + "\": invalid identifier"))) }
    }
    a[0] = Expr.Lit(Val.Text(w))
    if name == "dateadd" {
        a[1] = Expr.Call("round", [Expr.Cast(replace(mut &a[1], Expr.Lit(Val.Null)), TypeName{kind: K_NUM, oid: OID_NUMERIC, prec: 0, scale: 0, len: 0})], false)
        return Ok(Expr.Call("#dateadd", a, false))
    }
    return Ok(Expr.Call("#datediff", a, false))
}

// IGNORE NULLS / RESPECT NULLS of a window call (design/lexdb-new-features.md P5, S15, O25), at p: after the call's
// parentheses (PostgreSQL 19, SQL Server 2022, Oracle) or, in Oracle, after its first argument (inside). lag, lead,
// first_value, last_value and nth_value (not SQL Server's, which has no nth_value) take it: IGNORE NULLS marks the name
// " nulls:i" (" nulls:t" in the T-SQL door: SQL Server's lag and lead walk otherwise; " nulls:o" in Oracle's: its errors),
// RESPECT NULLS is the default and marks nothing. Another function, a second treatment (Oracle's inside and after) or no
// OVER after it: each product's error (PostgreSQL 0A000, 42809 for an aggregate or without OVER; SQL Server 16208, 195,
// 156; Oracle ORA-30484; an Oracle aggregate's is not read: "ignore" its alias, as Oracle reads it).
// (after a call's parentheses: one call in the call's parse, kept small) Oracle's treatment inside them came from callArg
// as a #nulls:i / #nulls:r wrapper of the first argument; then the one after them.
fn (p: mut &P) nullsMark(fname: mut &str, args: mut &[]Expr): Result[Unit, lexdb_base.DbErr] {
    if p.ora && len(args) > 0 {
        let w = nullsWrap(&args[0])
        if w > 0 {
            args[0] = nullsInner(&args[0])
            fname = try p.nullsTreat(fname, w == 1)
        }
    }
    if !(p.isKw("ignore") || p.isKw("respect")) || p.peekAt(1).text != "nulls" { return Ok(Unit{}) }
    if p.ora && lexdb_sql.isAgg(fname) { return Ok(Unit{}) }     // (Oracle reads "ignore" as the aggregate's alias)
    let ig = p.isKw("ignore")
    p.pos += 2
    fname = try p.nullsTreat(fname, ig)
    return Ok(Unit{})
}

// Oracle's f(x IGNORE NULLS): the first argument wrapped (callArg's oraNullsIn).
fn (p: mut &P) oraNullsIn(x: Expr): Result[Expr, lexdb_base.DbErr] {
    if p.peekAt(1).text != "nulls" { return Ok(x) }
    let ig = p.isKw("ignore")
    p.pos += 2
    return Ok(Expr.Call(if ig { "#nulls:i" } else { "#nulls:r" }, [x], false))
}

fn nullsWrap(x: &Expr): int {
    match x {
        Expr.Call(n, _, _) {
            if n == "#nulls:i" { return 1 }
            if n == "#nulls:r" { return 2 }
        }
        else {}
    }
    return 0
}

fn nullsInner(x: &Expr): Expr {
    match x {
        Expr.Call(_, xs, _) { if len(xs) == 1 { return cloneE(&xs[0]) } }
        else {}
    }
    return cloneE(x)
}

fn (p: mut &P) nullsTreat(fname: &str, ignore: bool): Result[str, lexdb_base.DbErr] {
    let base = lexdb_sql.aggBase(fname)
    let what = if ignore { "IGNORE NULLS" } else { "RESPECT NULLS" }
    let ok = base == "lag" || base == "lead" || base == "first_value" || base == "last_value" || (base == "nth_value" && !p.tsql)
    let twice = strings.contains(fname, " nulls:")
    if p.ora {
        if !ok || twice || !p.isKw("over") {
            return Err(lexdb_base.err("ORA30484", "missing OVER clause, or invalid identifier found for window function"))
        }
    } else if p.tsql {
        if base == "nth_value" { return Err(lexdb_base.err("TS195", "'nth_value' is not a recognized built-in function name.")) }
        if !ok { return Err(lexdb_base.err("TS16208", &("The function '" + base + "' does not support " + what + "."))) }
        if !p.isKw("over") { return Err(near(&p.peek())) }
    } else {
        if lexdb_sql.isAgg(fname) { return Err(lexdb_base.err("42809", "aggregate functions do not accept RESPECT/IGNORE NULLS")) }
        if !p.isKw("over") {
            if ok { return Err(lexdb_base.err("42809", &("window function " + base + " requires an OVER clause"))) }
            return Err(near(&p.peek()))
        }
        if !ok { return Err(lexdb_base.err("0A000", &("function " + base + " does not allow RESPECT/IGNORE NULLS"))) }
    }
    if !ignore { return Ok(fname.clone()) }
    return Ok(fname + (if p.tsql { " nulls:t" } else if p.ora { " nulls:o" } else { " nulls:i" }))
}

// ON CONFLICT ... DO SELECT [FOR UPDATE | FOR NO KEY UPDATE | FOR SHARE | FOR KEY SHARE] [WHERE cond] (PostgreSQL 19,
// design/lexdb-new-features.md P1), at SELECT: the third action, its lock strength in s.conflict (CONFLICT_SELECT +
// LOCK_*), its WHERE in s.where; RETURNING and a conflict target are required (lexdb_exec.upsertOf's 42601).
fn (p: mut &P) conflictSelect(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    p.pos += 1
    var lock = 0
    if p.acceptKw("for") {
        if p.acceptKw("update") { lock = lexdb_sql.LOCK_UPDATE }
        else if p.acceptKw("share") { lock = lexdb_sql.LOCK_SHARE }
        else if p.acceptKw("no") {
            try p.expectKw("key")
            try p.expectKw("update")
            lock = lexdb_sql.LOCK_NO_KEY_UPDATE
        } else {
            try p.expectKw("key")
            try p.expectKw("share")
            lock = lexdb_sql.LOCK_KEY_SHARE
        }
    }
    s.conflict = lexdb_sql.CONFLICT_SELECT + lock
    if p.acceptKw("where") { s.where = Some(try p.expr()) }
    return Ok(Unit{})
}

// At the word QUALIFY after a table: Oracle's clause (not a table alias) when a condition follows; the word alone, or before
// a word that goes on a FROM list or a query (WHERE, ORDER ...), is an alias (QUALIFY is not a reserved word there).
fn (p: &P) qualifyClause(): bool {
    let n = p.peekAt(1)
    if n.kind == T_EOF { return false }
    if n.kind == T_OP { return n.text != ")" && n.text != "," && n.text != ";" }
    if n.kind == T_IDENT {
        match n.text {
            "where", "group", "having", "window", "order", "union", "intersect", "except", "minus", "fetch", "offset", "for", "join", "inner", "left", "right",
            "full", "cross", "natural", "on", "using", "connect", "start", "as", "pivot", "unpivot", "partition", "tablesample", "sample", "match_recognize" { return false }
            else { return true }
        }
    }
    return true
}

// Oracle 26ai's QUALIFY cond (design/lexdb-new-features.md O1, 10.4), at QUALIFY after WINDOW: a filter on the rows after the
// window step, before DISTINCT, ORDER BY and FETCH. The condition may name a select alias (as ORDER BY does: an output's name
// before a column's, ORA-00960 for a name two outputs have) and hold window calls (numbered in p.wins as the select list's are).
// The aliases are replaced by their items' expressions here. A query with no window call anywhere has nothing to run after:
// the condition is a WHERE's (HAVING's, where the query is grouped). With windows it is kept as a window the query does not
// have, named "#qualify" (no new Stmt field: lexdb_exec.planSelect reads it where it plans the windows).
// HAVING, WINDOW or QUALIFY after the condition: ORA-03049, at the condition's first word.
fn (p: mut &P) oraQualify(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    p.pos += 1
    let first = p.peek().clone()
    let n0 = len(p.wins)
    var cond = try p.expr()
    // (in a query with GROUP BY, Oracle reads HAVING after the condition as the error's word; START WITH and CONNECT BY come before QUALIFY)
    if p.isKw("having") && len(s.group) > 0 { return Err(oraKwErr(&p.src, &p.peek().clone())) }
    if p.isKw("having") || p.isKw("window") || p.isKw("qualify") || p.isKw("connect") || (p.isKw("start") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "with") {
        return Err(oraKwErr(&p.src, &first))
    }
    s.mdialect = p.md()
    cond = try p.qualAliases(&cond, &s.items)
    // a number is true when it is not zero, a text when it reads as a boolean literal (ORA-61800 when it does not): TO_BOOLEAN's
    // reading (a comparison is a boolean already, and stays as it is for the planner)
    if !qualifyBool(&cond) { cond = Expr.Call("#n_otobool", [cond], false) }
    for i in n0..len(p.wins) {
        let c = p.wins[i].call.clone()
        p.wins[i].call = try p.qualAliases(&c, &s.items)
        for j in 0..len(p.wins[i].part) {
            let x = p.wins[i].part[j].clone()
            p.wins[i].part[j] = try p.qualAliases(&x, &s.items)
        }
        for j in 0..len(p.wins[i].order) {
            let x = p.wins[i].order[j].expr.clone()
            p.wins[i].order[j].expr = try p.qualAliases(&x, &s.items)
        }
    }
    if len(p.wins) > 0 {
        append(mut &s.windows, NamedWin{name: "#qualify", def: WinDef{call: cond, ref: "", bare: false, part: [], order: [], frame: lexdb_sql.noFrame()}})
        return Ok(Unit{})
    }
    var grouped = len(s.group) > 0 || len(s.gsets) > 0 || s.having.isSome() || aggIn(&cond)
    for it in s.items { match it.expr { Some(x) { if aggIn(&x) { grouped = true } } None {} } }
    if grouped {
        let h = replace(mut &s.having, None)
        s.having = Some(match h { Some(h2) { Expr.Bin("and", h2, cond) } None { cond } })
    } else {
        let w = replace(mut &s.where, None)
        s.where = Some(match w { Some(w2) { Expr.Bin("and", w2, cond) } None { cond } })
    }
    return Ok(Unit{})
}

// Whether QUALIFY's condition x is a boolean as written (a comparison, AND, OR, NOT, IS NULL, a subquery's EXISTS or IN), so that
// it needs no reading as one.
fn qualifyBool(x: &Expr): bool {
    match x {
        Expr.Bin(op, a, b) { return !(op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "||") }
        Expr.Unary(op, a) { return op == "not" }
        Expr.IsNull(a, neg) { return true }
        Expr.Call(n, args, star) { return n == "#exists" || n == "#in" || n == "like" || n == "between" || n == "regexp_like" }
        Expr.Lit(v) { match v { Val.Bool(_) { return true } else { return false } } }
        else { return false }
    }
}

// Oracle's ORA-03049 (ORA-03048 for a word it reserves) for token t, which may not follow what is before it: the text of the
// statement up to t, from a word boundary and at most 28 characters of it, after "..." when it was cut.
fn oraKwErr(src: &str, t: &Tok): lexdb_base.DbErr {
    var pre = src[0..t.at].toStr()
    var cut = false
    while len(pre) > 28 {
        let sp = strings.indexOf(&pre, " ", 0)
        if sp < 0 { break }
        pre = pre[sp + 1..len(pre)].toStr()
        cut = true
    }
    return kwErr(&pre, cut, t)
}

// The same with the text cut at the tokens before token k (Oracle's cut of GRAPH_TABLE's text: ') columns (a.name as x)) ').
fn oraKwErrToks(src: &str, toks: &[]Tok, k: int): lexdb_base.DbErr {
    var s = k
    while s > 0 && toks[k].at - toks[s - 1].at <= 28 { s -= 1 }
    return kwErr(&(src[toks[s].at..toks[k].at].toStr()), s > 0, &toks[k])
}

fn kwErr(pre: &str, cut: bool, t: &Tok): lexdb_base.DbErr {
    let word = strings.toUpperAscii(&t.text)
    let reserved = word == "HAVING" || word == "WINDOW" || word == "(" || word == "DATE" || word == "ORDER" || word == "GROUP" || word == "AS"
    return lexdb_base.err(if reserved { "ORA03048" } else { "ORA03049" },
                          &("SQL " + (if reserved { "reserved word" } else { "keyword" }) + " '" + word + "' is not syntactically valid following '" + (if cut { "..." } else { "" }) + pre + "'"))
}

// x as a copy of its own, with a copy of each subquery it calls (the subqueries are numbered in the query's list: two calls of
// one index would be one subquery read twice).
fn (p: mut &P) dupSubs(x: &Expr): Expr {
    match x {
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, p.dupSubs(&a)) }
            if (n == "#sub" || n == "#exists" || n == "#in") && len(args) > 0 {
                let i = lexdb_sql.litInt(&args[0])
                if i >= 0 && i < len(p.subs) {
                    append(mut &p.subs, p.subs[i].clone())
                    out[0] = Expr.Lit(Val.Int(len(p.subs) - 1))
                }
            }
            return Expr.Call(n.clone(), out, star)
        }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), p.dupSubs(&a)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), p.dupSubs(&a), p.dupSubs(&b)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(p.dupSubs(&a), neg) }
        Expr.Cast(a, t) { return Expr.Cast(p.dupSubs(&a), t) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// x with each bare name that is a select item's alias made that item's expression; ORA-00960 for a name that two items have
// (an alias, or a column item's own name).
fn (p: mut &P) qualAliases(x: &Expr, items: &[]SelItem): Result[Expr, lexdb_base.DbErr] {
    match x {
        Expr.Col(n, _) {
            if strings.contains(&n, ".") { return Ok(lexdb_sql.cloneExpr(x)) }
            var at = -1
            for i in 0..len(items) {
                var nm = items[i].alias.clone()
                if len(nm) == 0 {
                    match items[i].expr {
                        Some(ex) { match ex { Expr.Col(cn, _) { nm = cn[strings.lastIndexOf(&cn, ".") + 1..len(cn)].toStr() } else {} } }
                        None {}
                    }
                }
                if len(nm) == 0 || nm != n { continue }
                if at >= 0 { return Err(oraErr(960, "ambiguous column naming in select list")) }
                at = i
            }
            // (a column item without an alias is no alias: the name is a column of the FROM list's, ambiguous or not)
            if at >= 0 && len(items[at].alias) > 0 {
                match items[at].expr { Some(ex) { return Ok(p.dupSubs(&ex)) } None {} }
            }
            return Ok(lexdb_sql.cloneExpr(x))
        }
        Expr.Unary(op, a) { return Ok(Expr.Unary(op.clone(), try p.qualAliases(&a, items))) }
        Expr.Bin(op, a, b) { return Ok(Expr.Bin(op.clone(), try p.qualAliases(&a, items), try p.qualAliases(&b, items))) }
        Expr.IsNull(a, neg) { return Ok(Expr.IsNull(try p.qualAliases(&a, items), neg)) }
        Expr.Cast(a, t) { return Ok(Expr.Cast(try p.qualAliases(&a, items), t)) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, try p.qualAliases(&a, items)) }
            return Ok(Expr.Call(n.clone(), out, star))
        }
        else { return Ok(lexdb_sql.cloneExpr(x)) }
    }
}

// ---- Oracle's annotations (design/lexdb-new-features.md 8.5, O21; lexdb_annot keeps them)

// A token as Oracle's annotation errors show it: a word upper-cased.
fn annotTok(t: &Tok): str { return if t.kind == T_IDENT { strings.toUpperAscii(&t.text) } else { t.text.clone() } }

// ANNOTATIONS (...), after the word: an A_ANNOT alteration of column col ("" the object), its items in to (lexdb_annot.item). In a
// CREATE statement's (create) there is no DROP or REPLACE (ORA-11555, ORA-11556); a name is an identifier not reserved (ORA-11548),
// a value a text literal, not empty (ORA-11549).
fn (p: mut &P) annotClause(col: &str, create: bool): Result[Alter, lexdb_base.DbErr] {
    if !p.acceptKw("(") { return Err(lexdb_base.err("ORA11546", "missing left parenthesis when specifying ANNOTATIONS")) }
    if p.isKw(")") { return Err(lexdb_base.err("ORA11551", "missing annotations sequence within the ANNOTATIONS clause")) }
    var out: []str = []
    while true {
        var op = lexdb_annot.OP_PLAIN
        // IF NOT EXISTS | IF EXISTS after ADD or DROP (a name IF otherwise)
        let ifNext = p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "if" && p.peekAt(2).kind == T_IDENT &&
                     (p.peekAt(2).text == "not" || p.peekAt(2).text == "exists")
        if p.acceptKw("add") {
            op = lexdb_annot.OP_ADD
            if ifNext {
                p.pos += 1
                if !p.acceptKw("not") { return Err(lexdb_base.err("ORA11543", "Incorrect IF NOT EXISTS clause for CREATE statement.")) }
                try p.expectKw("exists")
                op = lexdb_annot.OP_ADD_IF
            }
        } else if p.isKw("drop") || p.isKw("replace") {
            let drop = p.next().text == "drop"
            if create {
                return Err(if drop { lexdb_base.err("ORA11555", "DROP annotation is not allowed in a CREATE statement.") }
                           else { lexdb_base.err("ORA11556", "REPLACE annotation is not allowed in a CREATE statement.") })
            }
            op = if drop { lexdb_annot.OP_DROP } else { lexdb_annot.OP_REPLACE }
            if drop && ifNext {
                p.pos += 1
                if p.isKw("not") { return Err(lexdb_base.err("ORA11544", "Incorrect IF EXISTS clause for ALTER/DROP statement.")) }
                try p.expectKw("exists")
                op = lexdb_annot.OP_DROP_IF
            }
        }
        let t = p.next()
        var name = ""
        if t.kind == T_QIDENT {
            if len(t.text) == 0 { return Err(lexdb_base.err("ORA01741", "illegal zero-length identifier")) }
            name = if len(t.spell) > 0 { t.spell.clone() } else { t.text.clone() }      // (a quoted name as written)
        } else if t.kind == T_IDENT && !lexdb_annot.reserved(&t.text) {
            name = strings.toUpperAscii(&t.text)
        } else {
            return Err(lexdb_annot.errName(&annotTok(&t)))
        }
        if len(name) > 1024 {
            return Err(lexdb_base.err("ORA00972", &("The identifier " + name[0..10] + "..." + name[len(name) - 10..len(name)] + "... exceeds the maximum length of 1024 bytes.")))
        }
        var has = false
        var value = ""
        let v = p.peek().clone()
        if v.kind == T_STR {
            p.pos += 1
            if len(v.text) == 0 { return Err(lexdb_annot.errValue("")) }
            if len(v.text) > 4000 {
                return Err(lexdb_base.err("ORA11545", &("annotation value " + v.text[0..10] + "..." + v.text[len(v.text) - 10..len(v.text)] + "... exceeds 4000 bytes limit")))
            }
            has = true
            value = v.text.clone()
        } else if !(v.kind == T_OP && (v.text == "," || v.text == ")")) && v.kind != T_EOF {
            return Err(lexdb_annot.errValue(&annotTok(&v)))
        }
        append(mut &out, lexdb_annot.item(&op, &name, has, &value))
        if p.acceptKw(",") { continue }
        if p.acceptKw(")") { break }
        if p.peek().kind == T_EOF { return Err(lexdb_base.err("ORA11547", "missing right parenthesis when specifying ANNOTATIONS")) }
        return Err(lexdb_base.err("ORA11550", "missing comma between consecutive annotations within ANNOTATIONS"))
    }
    var a = lexdb_sql.alterOf(A_ANNOT, col)
    a.to = strings.join(&out, "\x02")
    return Ok(a)
}

// After a column's ANNOTATIONS (the last of its definition): the next column or the end. A column word is ORA-03099 (ORA-03076 after
// an inline constraint: the tokens from the column's, at, to its ANNOTATIONS', upto), any other ORA-03062.
fn (p: &P) annotColEnd(at: int, upto: int): Result[Unit, lexdb_base.DbErr] {
    let t = p.peek().clone()
    if t.kind == T_OP && (t.text == "," || t.text == ")") { return Ok(Unit{}) }
    if t.kind == T_IDENT {
        match t.text.toStr() {
            "not", "null", "primary", "unique", "check", "references", "constraint", "default", "annotations", "generated", "as", "collate", "enable",
            "disable" {
                var inline = false
                for k in at..upto {
                    let w = p.toks[k].clone()
                    if w.kind == T_IDENT && (w.text == "not" || w.text == "primary" || w.text == "unique" || w.text == "check" || w.text == "references" ||
                                             w.text == "constraint") { inline = true }
                }
                if inline { return Err(lexdb_base.err("ORA03076", &("unexpected item " + strings.toUpperAscii(&t.text) + " in a column definition or inline constraint"))) }
                return Err(lexdb_base.err("ORA03099", &("unexpected item " + strings.toUpperAscii(&t.text) + " in a column definition")))
            }
            else {}
        }
    }
    return Err(lexdb_base.err("ORA03062", "missing comma or right parenthesis"))
}

// ALTER VIEW | INDEX name's clauses: ANNOTATIONS (...) and (a view's: cols) MODIFY [(] col ANNOTATIONS (...) [, ...] [)], in any order.
fn (p: mut &P) annotAlters(s: mut &Stmt, cols: bool): Result[Unit, lexdb_base.DbErr] {
    while true {
        if p.acceptKw("annotations") {
            append(mut &s.alters, try p.annotClause("", false))
        } else if cols && p.acceptKw("modify") {
            let paren = p.acceptKw("(")
            while true {
                let n = try p.name()
                try p.expectKw("annotations")
                append(mut &s.alters, try p.annotClause(&n, false))
                if !(paren && p.acceptKw(",")) { break }
            }
            if paren { try p.expectKw(")") }
        } else {
            break
        }
    }
    return Ok(Unit{})
}

// ---- SQL/PGQ property graphs (Oracle, PostgreSQL and SQL Server doors; lexdb_graph reads the texts kept here)

// PROPERTY GRAPH next.
fn (p: &P) graphNext(): bool {
    return p.isKw("property") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "graph"
}

// T-SQL: past {VERTEX|NODE} TABLES (...) [{EDGE|RELATIONSHIP} TABLES (...)] (the next statement may follow without ";").
fn (p: mut &P) graphEnd() {
    if !((p.isKw("vertex") || p.isKw("node")) && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "tables" &&
         p.peekAt(2).kind == T_OP && p.peekAt(2).text == "(") {
        p.skipToEnd()
        return
    }
    p.pos += 2
    p.skipParens()
    if (p.isKw("edge") || p.isKw("relationship")) && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "tables" &&
       p.peekAt(2).kind == T_OP && p.peekAt(2).text == "(" {
        p.pos += 2
        p.skipParens()
    }
}

fn (p: mut &P) skipParens() {
    if !p.isKw("(") { return }
    var d = 0
    while p.peek().kind != T_EOF {
        let t = p.next()
        if t.kind == T_OP && t.text == "(" { d += 1 }
        if t.kind == T_OP && t.text == ")" {
            d -= 1
            if d == 0 { break }
        }
    }
}

// CREATE [OR REPLACE | OR ALTER] PROPERTY GRAPH [IF NOT EXISTS] name ...: the name, and the rest of the statement as its text.
fn (p: mut &P) createGraph(orReplace: bool): Result[Stmt, lexdb_base.DbErr] {
    p.pos += 2
    var s = lexdb_sql.newStmt(lexdb_sql.S_CREATE_GRAPH)
    s.mdialect = p.md()
    s.ifFlag = orReplace
    if p.isKw("if") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "not" && p.peekAt(2).kind == T_IDENT && p.peekAt(2).text == "exists" {
        p.pos += 3
        s.unique = true
    }
    s.table = try p.qname()
    s.spell = p.spelled.clone()
    let from = p.peek().at
    let k0 = p.pos
    if p.tsql { p.graphEnd() } else { p.skipToEnd() }
    if !p.ora {
        for k in k0..p.pos {
            if p.toks[k].kind == T_PARAM {
                return Err(lexdb_base.err("42P02", &("there is no parameter $" + p.toks[k].text)))
            }
            if p.tsql && p.toks[k].kind == T_VAR && !strings.startsWith(&p.toks[k].text, "@@") {
                return Err(lexdb_base.err("TS137", &("Must declare the scalar variable \"" + p.toks[k].text + "\".")))
            }
        }
    }
    s.index = p.src[from..p.peek().at].toStr()
    return Ok(s)
}

// DROP PROPERTY GRAPH [IF EXISTS] name [RESTRICT | CASCADE].
fn (p: mut &P) dropGraph(): Result[Stmt, lexdb_base.DbErr] {
    p.pos += 2
    var s = lexdb_sql.newStmt(lexdb_sql.S_DROP_GRAPH)
    s.mdialect = p.md()
    if p.isKw("if") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "exists" {
        p.pos += 2
        s.ifFlag = true
    }
    s.table = try p.qname()
    s.spell = p.spelled.clone()
    if p.ora {
        // (Oracle has no CASCADE or PURGE here: ORA-03049)
        if p.isKw("cascade") || p.isKw("purge") { return Err(oraKwErr(&p.src, &p.toks[p.pos])) }
    } else {
        if p.acceptKw("restrict") || p.acceptKw("cascade") {}
    }
    return Ok(s)
}

// GRAPH_TABLE (...) [AS] [alias] in FROM (the name read, "(" next): a subquery marked GRAPH_MARK with the text inside the brackets
// (a bind written $n, its number the statement's; in T-SQL @var checked against p.vars and kept for re-parsing with s.names),
// which lexdb_graph.expand writes as its query where it is planned.
fn (p: mut &P) graphTable(join: int): Result[FromItem, lexdb_base.DbErr] {
    let open = p.pos
    var depth = 0
    var close = -1
    var k = open
    while k < len(p.toks) && p.toks[k].kind != T_EOF {
        let t = &p.toks[k]
        if t.kind == T_OP && t.text == "(" { depth += 1 }
        if t.kind == T_OP && t.text == ")" {
            depth -= 1
            if depth == 0 {
                close = k
                break
            }
        }
        k += 1
    }
    if close < 0 {
        return Err(if p.ora { oraErr(907, "missing right parenthesis") } else { near(&p.peek()) })
    }
    var text = ""
    for i in open + 1..close {
        let t = p.toks[i].clone()
        if t.kind == T_PARAM {
            let n = strings.parseIntOpt(&t.text).unwrapOr(0)
            if n > p.params { p.params = n }
            text += "$" + t.text + " "
        } else {
            if p.tsql && t.kind == T_VAR {
                let checked = try p.variable(&t)
            }
            text += &p.src[t.at..p.toks[i + 1].at]
        }
    }
    p.pos = close + 1
    if p.ora && p.isKw("as") { return Err(oraKwErrToks(&p.src, &p.toks, p.pos)) }
    var s = lexdb_sql.newStmt(S_SELECT)
    s.srf = lexdb_sql.GRAPH_MARK.toStr()
    s.index = text
    if p.tsql {
        for x in p.vars { append(mut &s.names, x.clone()) }
    } else {
        for x in p.nls { append(mut &s.names, x.clone()) }
    }
    s.use = SUB_FROM
    s.mdialect = p.md()
    append(mut &p.subs, s)
    var alias = "\x01graph_table" + len(p.subs).toStr()
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols, true)
    let spells = spellsOff(mut &cols)
    p.subs[len(p.subs) - 1].spells = spells
    return Ok(FromItem{table: "", alias: alias, join: join, on: None, sub: len(p.subs) - 1, cols: cols, work: -1, lateral: false, using: [], natural: false, comma: false})
}

// ---- assertions (design/lexdb-new-features.md O23 and section 14; lexdb_assert reads the text kept here): Oracle's, and
// the SQL standard's in the PostgreSQL and T-SQL doors

// CREATE [IF NOT EXISTS] | DROP [IF EXISTS] | ALTER ASSERTION name ...: the name, and the rest of the statement as its text
// (verb "create", "drop", "alter"; ALTER is Oracle's only). A bind in it is ORA-01027, as Oracle's DDL (PostgreSQL's
// 42P02); CREATE ASSERTION CHECK (...) ORA-00931 (a syntax error elsewhere). T-SQL has no IF NOT EXISTS for CREATE, and
// its statements need no ";": the text ends after CHECK (...) and the constraint characteristics.
fn (p: mut &P) assertStmt(verb: &str): Result[Stmt, lexdb_base.DbErr] {
    p.pos += 1
    var s = lexdb_sql.newStmt(lexdb_sql.S_ASSERT)
    s.alias = verb.toStr()
    s.mdialect = p.md()
    let w = if verb == "create" { "not" } else { "exists" }
    if verb != "alter" && !(p.tsql && verb == "create") && p.isKw("if") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == w &&
       (verb != "create" || (p.peekAt(2).kind == T_IDENT && p.peekAt(2).text == "exists")) {
        p.pos += if verb == "create" { 3 } else { 2 }
        s.ifFlag = true
    }
    if verb == "create" && p.isKw("check") && p.peekAt(1).kind == T_OP && p.peekAt(1).text == "(" {
        return Err(if p.ora { oraErr(931, "missing identifier") } else { near(&p.peek()) })
    }
    s.table = try p.qname()
    s.spell = p.spelled.clone()
    // (Oracle: a quoted name in lower case is kept so, "xd", not shown as XD)
    if p.ora && len(s.spell) == 0 && p.toks[p.pos - 1].kind == T_QIDENT { s.spell = p.toks[p.pos - 1].text.clone() }
    let from = p.peek().at
    let k0 = p.pos
    if p.tsql { p.assertEnd(verb) } else { p.skipToEnd() }
    for k in k0..p.pos {
        if p.toks[k].kind == T_PARAM {
            if p.ora { return Err(oraErr(1027, "bind variables not allowed for data definition operations")) }
            return Err(lexdb_base.err("42P02", &("there is no parameter " + p.toks[k].text)))
        }
    }
    s.index = p.src[from..p.peek().at].toStr()
    return Ok(s)
}

// T-SQL: past CHECK (...) and [NOT] DEFERRABLE, INITIALLY IMMEDIATE | DEFERRED (the next statement may follow without ";").
fn (p: mut &P) assertEnd(verb: &str) {
    if verb != "create" || !p.acceptKw("check") { return }
    if !p.isKw("(") { return }
    var d = 0
    while p.peek().kind != T_EOF {
        let t = p.next()
        if t.kind == T_OP && t.text == "(" { d += 1 }
        if t.kind == T_OP && t.text == ")" {
            d -= 1
            if d == 0 { break }
        }
    }
    while true {
        if p.isKw("deferrable") || p.isKw("immediate") || p.isKw("deferred") { p.pos += 1 }
        else if p.isKw("not") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "deferrable" { p.pos += 2 }
        else if p.isKw("initially") { p.pos += 1 }
        else { break }
    }
}

// An assertion's or property graph's text as its dialect's tokens (MD_PG, MD_TSQL, MD_ORA).
pub fn tokensIn(sql: &str, md: int): Result[[]Tok, lexdb_base.DbErr] {
    if md == MD_ORA { return oraTokens(sql) }
    return lexIn(sql, Dialect{tsql: md == MD_TSQL, quotedIdent: true})
}

// GRAPH_TABLE's inner text as its dialect's tokens (in T-SQL, -[ ... ]- inside MATCH uses [ ] as edge brackets).
pub fn graphTokens(sql: &str, md: int): Result[[]Tok, lexdb_base.DbErr] {
    if md == MD_ORA { return oraTokens(sql) }
    return lexInGt(sql, Dialect{tsql: md == MD_TSQL, quotedIdent: true}, false, if md == MD_TSQL { 1 } else { 0 })
}

// A query of an assertion or GRAPH_TABLE, read as its dialect reads it.
pub fn parseFor(sql: &str, md: int): Result[[]Stmt, lexdb_base.DbErr] {
    if md == MD_ORA { return oraParse(sql) }
    if md == MD_PG { return parse(sql) }
    var q = try tsqlParser(sql, Dialect{tsql: true, quotedIdent: true}, &[])
    let st = try q.statement()
    return Ok([st])
}

// T-SQL query parsed with the enclosing batch's variables in scope (lexdb_graph.expand).
pub fn parseTsqlVars(sql: &str, vars: &[]str): Result[[]Stmt, lexdb_base.DbErr] {
    var q = try tsqlParser(sql, Dialect{tsql: true, quotedIdent: true}, vars)
    let st = try q.statement()
    return Ok([st])
}

// Oracle's and PostgreSQL's SQL text as tokens (lexdb_graph reads a graph's definition and GRAPH_TABLE's text with them).
pub fn oraTokens(sql: &str): Result[[]Tok, lexdb_base.DbErr] { return lexOra(sql, pgDialect(), true) }
pub fn pgTokens(sql: &str): Result[[]Tok, lexdb_base.DbErr] { return lexOra(sql, pgDialect(), false) }

// ---- SQL/JSON expressions, aggregates, JSON_TABLE, OPENJSON, and FOR JSON (all 3 doors)

fn (p: mut &P) strLit(): Result[str, lexdb_base.DbErr] {
    let t = p.next()
    if t.kind != T_STR { return Err(near(&t)) }
    return Ok(t.text)
}

const J_ON_NULL = 0
const J_ON_ERROR = 1
const J_ON_DEFAULT = 2
const J_ON_EMPTY_ARR = 3
const J_ON_EMPTY_OBJ = 4
const J_ON_TRUE = 5
const J_ON_FALSE = 6
const J_ON_UNKNOWN = 7

const J_WRAP_NONE = 0
const J_WRAP_UNCOND = 1
const J_WRAP_COND = 2

const J_QUOTES_KEEP = 0
const J_QUOTES_OMIT = 1

// PASSING expr AS name [, expr AS name ...] -> pairs [Lit(name), expr, ...]
fn (p: mut &P) parseJsonPassing(out: mut &[]Expr): Result[Unit, lexdb_base.DbErr] {
    if !p.acceptKw("passing") { return Ok(Unit{}) }
    while true {
        let v = try p.expr()
        try p.expectKw("as")
        let nm = try p.name()
        append(out, Expr.Lit(Val.Text(nm)))
        append(out, v)
        if !p.acceptKw(",") { break }
    }
    return Ok(Unit{})
}

// Parses optional ON EMPTY and ON ERROR clauses (in either order).
fn (p: mut &P) parseJsonOnClauses(onEmpty: mut &int, emptyDef: mut &Expr, onErr: mut &int, errDef: mut &Expr): Result[bool, lexdb_base.DbErr] {
    var any = false
    while true {
        let save = p.pos
        var mode = -1
        var def = Expr.Lit(Val.Null)
        if p.acceptKw("null") {
            mode = J_ON_NULL
        } else if p.acceptKw("error") {
            mode = J_ON_ERROR
        } else if p.acceptKw("empty") {
            if p.acceptKw("array") { mode = J_ON_EMPTY_ARR }
            else if p.acceptKw("object") { mode = J_ON_EMPTY_OBJ }
            else { mode = J_ON_EMPTY_ARR }
        } else if p.acceptKw("default") {
            mode = J_ON_DEFAULT
            def = try p.expr()
        } else if p.acceptKw("true") {
            mode = J_ON_TRUE
        } else if p.acceptKw("false") {
            mode = J_ON_FALSE
        } else if p.acceptKw("unknown") {
            mode = J_ON_UNKNOWN
        } else {
            break
        }
        if !p.acceptKw("on") {
            p.pos = save
            break
        }
        any = true
        if p.acceptKw("empty") {
            onEmpty = mode
            emptyDef = def
        } else if p.acceptKw("error") {
            onErr = mode
            errDef = def
        } else {
            return Err(near(&p.peek()))
        }
    }
    return Ok(any)
}

// Parses optional RETURNING type [FORMAT JSON].
fn (p: mut &P) parseJsonReturning(): Result[Option[TypeName], lexdb_base.DbErr] {
    if !p.acceptKw("returning") { return Ok(None) }
    let ty = try p.typeName()
    if p.acceptKw("format") { try p.expectKw("json") }
    return Ok(Some(ty))
}

// Parses optional WRAPPER clause: WITHOUT [ARRAY] WRAPPER | WITH [CONDITIONAL | UNCONDITIONAL] [ARRAY] WRAPPER.
fn (p: mut &P) parseJsonWrapper(wrapper: mut &int): Result[bool, lexdb_base.DbErr] {
    let save = p.pos
    if p.acceptKw("without") {
        let _a = p.acceptKw("array")
        if p.acceptKw("wrapper") {
            wrapper = J_WRAP_NONE
            return Ok(true)
        }
        p.pos = save
        return Ok(false)
    }
    if p.acceptKw("with") {
        var w = J_WRAP_UNCOND
        if p.acceptKw("conditional") { w = J_WRAP_COND }
        else if p.acceptKw("unconditional") { w = J_WRAP_UNCOND }
        let _a = p.acceptKw("array")
        if p.acceptKw("wrapper") {
            wrapper = w
            return Ok(true)
        }
        p.pos = save
        return Ok(false)
    }
    return Ok(false)
}

// Parses optional KEEP | OMIT QUOTES [ON SCALAR STRING].
fn (p: mut &P) parseJsonQuotes(quotes: mut &int): Result[bool, lexdb_base.DbErr] {
    let save = p.pos
    if p.acceptKw("keep") || p.acceptKw("omit") {
        let omit = p.toks[p.pos - 1].text == "omit"
        if p.acceptKw("quotes") {
            if p.acceptKw("on") {
                try p.expectKw("scalar")
                try p.expectKw("string")
            }
            quotes = if omit { J_QUOTES_OMIT } else { J_QUOTES_KEEP }
            return Ok(true)
        }
        p.pos = save
    }
    return Ok(false)
}

fn (p: mut &P) jsonCtorExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let x = try p.expr()
    var uniq = 0
    if p.acceptKw("with") {
        try p.expectKw("unique")
        let _k = p.acceptKw("keys")
        uniq = 1
    } else if p.acceptKw("without") {
        try p.expectKw("unique")
        let _k = p.acceptKw("keys")
    }
    try p.expectKw(")")
    return Ok(Expr.Call("#json_ctor", [x, Expr.Lit(Val.Int(uniq)), Expr.Lit(Val.Int(if p.ora { 1 } else { 0 }))], false))
}

fn (p: mut &P) jsonValueExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let doc = try p.expr()
    try p.expectKw(",")
    let path = try p.expr()
    var passing: []Expr = []
    try p.parseJsonPassing(mut &passing)
    let ret = try p.parseJsonReturning()
    var onEmpty = J_ON_NULL
    var emptyDef = Expr.Lit(Val.Null)
    var onErr = J_ON_NULL
    var errDef = Expr.Lit(Val.Null)
    let hadOn = try p.parseJsonOnClauses(mut &onEmpty, mut &emptyDef, mut &onErr, mut &errDef)
    try p.expectKw(")")
    if p.tsql && len(passing) == 0 && ret.isNone() && !hadOn {
        return Ok(Expr.Call("#tsql_json_value", [doc, path], false))
    }
    let retOid = match ret { Some(t) { t.oid } None { 0 } }
    var args: []Expr = [doc, path, Expr.Lit(Val.Int(onEmpty)), emptyDef, Expr.Lit(Val.Int(onErr)), errDef, Expr.Lit(Val.Int(retOid))]
    for px in passing { append(mut &args, px) }
    let call = Expr.Call("#json_value", args, false)
    match ret {
        Some(ty) { return Ok(Expr.Cast(call, ty)) }
        None { return Ok(call) }
    }
}

fn (p: mut &P) jsonQueryExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let doc = try p.expr()
    var path = Expr.Lit(Val.Text("$"))
    if p.acceptKw(",") { path = try p.expr() }
    var passing: []Expr = []
    try p.parseJsonPassing(mut &passing)
    var ret = try p.parseJsonReturning()
    var wrapper = J_WRAP_NONE
    var quotes = J_QUOTES_KEEP
    var hadOpt = false
    while true {
        if try p.parseJsonWrapper(mut &wrapper) { hadOpt = true; continue }
        if try p.parseJsonQuotes(mut &quotes) { hadOpt = true; continue }
        if ret.isNone() {
            let r2 = try p.parseJsonReturning()
            if r2.isSome() { ret = r2; continue }
        }
        break
    }
    var onEmpty = J_ON_NULL
    var emptyDef = Expr.Lit(Val.Null)
    var onErr = J_ON_NULL
    var errDef = Expr.Lit(Val.Null)
    let hadOn = try p.parseJsonOnClauses(mut &onEmpty, mut &emptyDef, mut &onErr, mut &errDef)
    try p.expectKw(")")
    if p.tsql && len(passing) == 0 && ret.isNone() && !hadOpt && !hadOn {
        return Ok(Expr.Call("#tsql_json_query", [doc, path], false))
    }
    let isJsonb = match ret { Some(t) { t.oid == OID_JSONB } None { false } }
    var args: []Expr = [doc, path, Expr.Lit(Val.Int(wrapper)), Expr.Lit(Val.Int(quotes)),
                        Expr.Lit(Val.Int(onEmpty)), emptyDef, Expr.Lit(Val.Int(onErr)), errDef,
                        Expr.Lit(Val.Int(if isJsonb { 1 } else { 0 }))]
    for px in passing { append(mut &args, px) }
    let call = Expr.Call("#json_query", args, false)
    match ret {
        Some(ty) { return Ok(Expr.Cast(call, ty)) }
        None { return Ok(call) }
    }
}

fn (p: mut &P) jsonExistsExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let doc = try p.expr()
    try p.expectKw(",")
    let path = try p.expr()
    var passing: []Expr = []
    try p.parseJsonPassing(mut &passing)
    var onEmpty = J_ON_NULL
    var emptyDef = Expr.Lit(Val.Null)
    var onErr = J_ON_FALSE
    var errDef = Expr.Lit(Val.Null)
    let _h = try p.parseJsonOnClauses(mut &onEmpty, mut &emptyDef, mut &onErr, mut &errDef)
    try p.expectKw(")")
    var args: []Expr = [doc, path, Expr.Lit(Val.Int(onErr))]
    for px in passing { append(mut &args, px) }
    return Ok(Expr.Call("#json_exists", args, false))
}

fn (p: mut &P) jsonObjectExpr(): Result[Option[Expr], lexdb_base.DbErr] {
    let save = p.pos
    try p.expectKw("(")
    var pairs: []Expr = []
    var isSqlJson = false
    if p.isKw(")") || p.isKw("returning") || p.isKw("null") || p.isKw("absent") || p.isKw("with") || p.isKw("without") {
        isSqlJson = true
    } else {
        while true {
            if p.isKw("null") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" { break }
            if p.isKw("absent") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" { break }
            if (p.isKw("with") || p.isKw("without")) && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "unique" { break }
            if p.isKw("returning") || p.isKw(")") { break }
            let hadKey = p.isKw("key") && !(p.peekAt(1).kind == T_OP && (p.peekAt(1).text == ")" || p.peekAt(1).text == ","))
            if hadKey { p.pos += 1; isSqlJson = true }
            let k = try p.expr()
            if p.acceptKw(":") || p.acceptKw("value") {
                isSqlJson = true
            } else {
                if !isSqlJson {
                    p.pos = save
                    return Ok(None)
                }
                return Err(near(&p.peek()))
            }
            let v = try p.expr()
            append(mut &pairs, k)
            append(mut &pairs, v)
            if !p.acceptKw(",") { break }
        }
    }
    var absent = 0
    var uniq = 0
    var ret: Option[TypeName] = None
    while true {
        if p.isKw("null") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2
            try p.expectKw("null")
            absent = 0
            continue
        }
        if p.isKw("absent") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2
            try p.expectKw("null")
            absent = 1
            continue
        }
        if p.acceptKw("with") {
            try p.expectKw("unique")
            let _k = p.acceptKw("keys")
            uniq = 1
            continue
        }
        if p.acceptKw("without") {
            try p.expectKw("unique")
            let _k = p.acceptKw("keys")
            uniq = 0
            continue
        }
        if p.isKw("returning") {
            ret = try p.parseJsonReturning()
            continue
        }
        break
    }
    try p.expectKw(")")
    let isJsonb = match ret { Some(t) { t.oid == OID_JSONB } None { false } }
    var args: []Expr = [Expr.Lit(Val.Int(absent)), Expr.Lit(Val.Int(uniq)), Expr.Lit(Val.Int(if isJsonb { 1 } else { 0 }))]
    for x in pairs { append(mut &args, x) }
    let call = Expr.Call("#json_object", args, false)
    match ret {
        Some(ty) { return Ok(Some(Expr.Cast(call, ty))) }
        None { return Ok(Some(call)) }
    }
}

fn (p: mut &P) jsonArrayExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    if p.isKw("select") || p.isKw("with") || p.parenQuery() {
        return p.jsonArraySub()
    }
    var elems: []Expr = []
    if !p.isKw(")") && !p.isKw("returning") && !(p.isKw("null") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on") &&
       !(p.isKw("absent") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on") {
        while true {
            if (p.isKw("null") || p.isKw("absent")) && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" { break }
            if p.isKw("returning") || p.isKw(")") { break }
            append(mut &elems, try p.expr())
            if !p.acceptKw(",") { break }
        }
    }
    var absent = 1
    var ret: Option[TypeName] = None
    while true {
        if p.isKw("null") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2
            try p.expectKw("null")
            absent = 0
            continue
        }
        if p.isKw("absent") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2
            try p.expectKw("null")
            absent = 1
            continue
        }
        if p.isKw("returning") {
            ret = try p.parseJsonReturning()
            continue
        }
        break
    }
    try p.expectKw(")")
    let isJsonb = match ret { Some(t) { t.oid == OID_JSONB } None { false } }
    var args: []Expr = [Expr.Lit(Val.Int(absent)), Expr.Lit(Val.Int(if isJsonb { 1 } else { 0 }))]
    for x in elems { append(mut &args, x) }
    let call = Expr.Call("#json_array", args, false)
    match ret {
        Some(ty) { return Ok(Expr.Cast(call, ty)) }
        None { return Ok(call) }
    }
}

fn (p: mut &P) jsonArraySub(): Result[Expr, lexdb_base.DbErr] {
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    var nCte = 0
    if p.acceptKw("with") { nCte = try p.withList() }
    var sub = lexdb_sql.newStmt(S_SELECT)
    if p.acceptKw("select") {
        sub = try p.select()
    } else if p.parenQuery() {
        sub = try p.parenSelect()
    } else {
        return Err(near(&p.peek()))
    }
    sub.subs = replace(mut &p.subs, [])
    sub.wins = replace(mut &p.wins, [])
    sub.use = SUB_FROM
    if nCte > 0 { p.popCtes(nCte) }
    var absent = 1
    var ret: Option[TypeName] = None
    while !p.isKw(")") {
        if p.isKw("null") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2; try p.expectKw("null"); absent = 0; continue
        }
        if p.isKw("absent") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2; try p.expectKw("null"); absent = 1; continue
        }
        if p.isKw("returning") { ret = try p.parseJsonReturning(); continue }
        break
    }
    try p.expectKw(")")
    append(mut &p.subs, sub)
    let inner = len(p.subs) - 1
    let isJsonb = match ret { Some(t) { t.oid == OID_JSONB } None { false } }
    let aggName = if isJsonb { if absent == 0 { "jsonb_arrayagg_null" } else { "jsonb_arrayagg" } }
                  else { if absent == 0 { "json_arrayagg_null" } else { "json_arrayagg" } }
    let emptyOid = if isJsonb { OID_JSONB } else { OID_JSON }
    var w = lexdb_sql.newStmt(S_SELECT)
    append(mut &w.from, FromItem{table: "", alias: "#jarr", join: J_FIRST, on: None, sub: inner, cols: ["#a"], work: -1, lateral: false, using: [], natural: false, comma: false})
    let agg = Expr.Call(aggName, [Expr.Col("#jarr.#a", -1)], false)
    let coal = Expr.Call("coalesce", [agg, Expr.Cast(Expr.Lit(Val.Text("[]")), TypeName{kind: K_JSON, oid: emptyOid, prec: 0, scale: 0, len: 0})], false)
    let outExpr = match ret { Some(ty) { Expr.Cast(coal, ty) } None { coal } }
    append(mut &w.items, SelItem{star: false, qual: "", expr: Some(outExpr), alias: "json_array", spell: ""})
    w.subs = replace(mut &p.subs, saved)
    w.wins = replace(mut &p.wins, savedW)
    w.use = SUB_SCALAR
    p.depth -= 1
    append(mut &p.subs, w)
    return Ok(subRef("#sub", len(p.subs) - 1))
}

fn (p: mut &P) jsonScalarExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let x = try p.expr()
    try p.expectKw(")")
    return Ok(Expr.Call("#json_scalar", [x], false))
}

fn (p: mut &P) jsonSerializeExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let x = try p.expr()
    var ret: Option[TypeName] = None
    var pretty = 0
    while !p.isKw(")") {
        if p.isKw("returning") { ret = try p.parseJsonReturning(); continue }
        if p.acceptKw("pretty") { pretty = 1; continue }
        if p.acceptKw("truncate") { continue }
        if p.acceptKw("ascii") { continue }
        break
    }
    try p.expectKw(")")
    let call = Expr.Call("#json_serialize", [x, Expr.Lit(Val.Int(pretty))], false)
    match ret {
        Some(ty) { return Ok(Expr.Cast(call, ty)) }
        None { return Ok(call) }
    }
}

fn (p: mut &P) jsonMergePatchExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let a = try p.expr()
    try p.expectKw(",")
    let b = try p.expr()
    var ret: Option[TypeName] = None
    var pretty = 0
    while !p.isKw(")") {
        if p.isKw("returning") { ret = try p.parseJsonReturning(); continue }
        if p.acceptKw("pretty") { pretty = 1; continue }
        break
    }
    try p.expectKw(")")
    let call = Expr.Call("#json_mergepatch", [a, b, Expr.Lit(Val.Int(pretty))], false)
    match ret {
        Some(ty) { return Ok(Expr.Cast(call, ty)) }
        None { return Ok(call) }
    }
}

fn (p: mut &P) jsonEqualExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let a = try p.expr()
    try p.expectKw(",")
    let b = try p.expr()
    try p.expectKw(")")
    return Ok(Expr.Call("#json_equal", [a, b], false))
}

fn (p: mut &P) jsonTransformExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let doc = try p.expr()
    var args: []Expr = [doc]
    while p.acceptKw(",") {
        let ot = p.next()
        if ot.kind != T_IDENT { return Err(near(&ot)) }
        let op = strings.toLowerAscii(&ot.text)
        let path = try p.catExpr()
        var val = Expr.Lit(Val.Null)
        if op != "remove" && op != "keep" {
            try p.expectKw("=")
            val = try p.expr()
        }
        append(mut &args, Expr.Lit(Val.Text(op)))
        append(mut &args, path)
        append(mut &args, val)
    }
    var ret: Option[TypeName] = None
    if p.isKw("returning") { ret = try p.parseJsonReturning() }
    try p.expectKw(")")
    let call = Expr.Call("#json_transform", args, false)
    match ret {
        Some(ty) { return Ok(Expr.Cast(call, ty)) }
        None { return Ok(call) }
    }
}

fn (p: mut &P) jsonArrayAggExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let distinct = p.acceptKw("distinct")
    if !distinct { let _al = p.acceptKw("all") }
    let x = try p.expr()
    var args: []Expr = [x]
    var dirs = ""
    var absent = 1
    var ret: Option[TypeName] = None
    while !p.isKw(")") {
        if p.acceptKw("order") {
            try p.expectKw("by")
            while true {
                append(mut &args, try p.expr())
                var desc = false
                if p.acceptKw("desc") { desc = true } else { let _asc = p.acceptKw("asc") }
                var flip = false
                if p.acceptKw("nulls") {
                    if p.acceptKw("first") { flip = !desc } else { try p.expectKw("last"); flip = desc }
                }
                dirs = dirs + (if desc { if flip { "D" } else { "d" } } else { if flip { "A" } else { "a" } })
                if !p.acceptKw(",") { break }
            }
            continue
        }
        if p.isKw("null") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2; try p.expectKw("null"); absent = 0; continue
        }
        if p.isKw("absent") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2; try p.expectKw("null"); absent = 1; continue
        }
        if p.isKw("returning") { ret = try p.parseJsonReturning(); continue }
        break
    }
    try p.expectKw(")")
    // Optional SQL Server / Oracle WITHIN GROUP (ORDER BY ...)
    if p.isKw("within") && len(dirs) == 0 {
        p.pos += 1
        try p.expectKw("group")
        try p.expectKw("(")
        try p.expectKw("order")
        try p.expectKw("by")
        while true {
            append(mut &args, try p.expr())
            var desc = false
            if p.acceptKw("desc") { desc = true } else { let _asc = p.acceptKw("asc") }
            dirs = dirs + (if p.ora { if desc { "d" } else { "a" } } else { if desc { "D" } else { "A" } })
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
    }
    let isJsonb = match ret { Some(t) { t.oid == OID_JSONB } None { false } }
    var fname = if isJsonb { if absent == 0 { "jsonb_arrayagg_null" } else { "jsonb_arrayagg" } }
                else { if absent == 0 { "json_arrayagg_null" } else { "json_arrayagg" } }
    if distinct { fname = fname + " distinct" }
    if len(dirs) > 0 { fname = fname + " order:" + dirs }
    if p.acceptKw("filter") {
        try p.expectKw("(")
        try p.expectKw("where")
        append(mut &args, try p.expr())
        try p.expectKw(")")
        fname = fname + " filter"
    }
    let call = Expr.Call(fname, args, false)
    match ret {
        Some(ty) { return Ok(Expr.Cast(call, ty)) }
        None { return Ok(call) }
    }
}

fn (p: mut &P) jsonObjectAggExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let hadKey = p.isKw("key") && !(p.peekAt(1).kind == T_OP && (p.peekAt(1).text == ":" || p.peekAt(1).text == ","))
    if hadKey { p.pos += 1 }
    let k = try p.expr()
    if !p.acceptKw(":") && !p.acceptKw("value") {
        try p.expectKw(",")
    }
    let v = try p.expr()
    var absent = 0
    var uniq = 0
    var ret: Option[TypeName] = None
    while !p.isKw(")") {
        if p.isKw("null") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2; try p.expectKw("null"); absent = 0; continue
        }
        if p.isKw("absent") && p.peekAt(1).kind == T_IDENT && p.peekAt(1).text == "on" {
            p.pos += 2; try p.expectKw("null"); absent = 1; continue
        }
        if p.acceptKw("with") {
            try p.expectKw("unique"); let _k = p.acceptKw("keys"); uniq = 1; continue
        }
        if p.acceptKw("without") {
            try p.expectKw("unique"); let _k = p.acceptKw("keys"); uniq = 0; continue
        }
        if p.isKw("returning") { ret = try p.parseJsonReturning(); continue }
        break
    }
    try p.expectKw(")")
    let isJsonb = match ret { Some(t) { t.oid == OID_JSONB } None { false } }
    var fname = if isJsonb { "jsonb_objectagg" } else { "json_objectagg" }
    if absent == 1 && uniq == 1 { fname += "_abs_uniq" }
    else if absent == 1 { fname += "_abs" }
    else if uniq == 1 { fname += "_uniq" }
    var args: []Expr = [k, v]
    if p.acceptKw("filter") {
        try p.expectKw("(")
        try p.expectKw("where")
        append(mut &args, try p.expr())
        try p.expectKw(")")
        fname = fname + " filter"
    }
    let call = Expr.Call(fname, args, false)
    match ret {
        Some(ty) { return Ok(Expr.Cast(call, ty)) }
        None { return Ok(call) }
    }
}

fn (p: mut &P) tsqlIsJsonExpr(): Result[Expr, lexdb_base.DbErr] {
    try p.expectKw("(")
    let x = try p.expr()
    var kind = ""
    if p.acceptKw(",") {
        let t = p.next()
        if t.kind == T_IDENT || t.kind == T_STR { kind = strings.toLowerAscii(&t.text) }
        else { return Err(near(&t)) }
    }
    try p.expectKw(")")
    return Ok(Expr.Call("#tsql_isjson", [x, Expr.Lit(Val.Text(kind))], false))
}

// Encodes one JSON_TABLE / OPENJSON WITH column spec (13 fields: 11 for lexdb_json.decodeCols + name + spell).
fn encJTabCol(kind: &str, path: &str, oid: int, wrapper: int, onEmpty: int, hasED: bool, eDef: &str,
              onErr: int, hasRD: bool, rDef: &str, nested: &str, name: &str, spell: &str): str {
    let fs: []str = [kind.clone(), path.clone(), oid.toStr(), wrapper.toStr(), onEmpty.toStr(),
                     if hasED { "1" } else { "0" }, eDef.clone(), onErr.toStr(),
                     if hasRD { "1" } else { "0" }, rDef.clone(), nested.clone(), name.clone(), spell.clone()]
    return strings.join(&fs, "\x1f")
}

fn (p: mut &P) parseJTabColList(nestedPrefix: &str, out: mut &[]str): Result[Unit, lexdb_base.DbErr] {
    while true {
        if p.acceptKw("nested") {
            let _pa = p.acceptKw("path")
            let np = try p.strLit()
            try p.expectKw("columns")
            try p.expectKw("(")
            try p.parseJTabColList(&np, out)
            try p.expectKw(")")
        } else {
            let cname = try p.name()
            let cspell = p.spelled.clone()
            if p.acceptKw("for") {
                try p.expectKw("ordinality")
                append(out, encJTabCol(&"ord", &"", OID_INT8, J_WRAP_NONE, J_ON_NULL, false, &"", J_ON_NULL, false, &"", nestedPrefix, &cname, &cspell))
            } else {
                let ty = try p.typeName()
                var kind = "val"
                if p.acceptKw("format") {
                    try p.expectKw("json")
                    kind = "json"
                } else if ty.oid == OID_JSON || ty.oid == OID_JSONB {
                    kind = "json"
                }
                if p.acceptKw("exists") { kind = "exists" }
                var path = "$." + cname
                if p.acceptKw("path") { path = try p.strLit() }
                var wrapper = J_WRAP_NONE
                let _w = try p.parseJsonWrapper(mut &wrapper)
                var onEmpty = J_ON_NULL
                var emptyDef = Expr.Lit(Val.Null)
                var onErr = J_ON_NULL
                var errDef = Expr.Lit(Val.Null)
                let _on = try p.parseJsonOnClauses(mut &onEmpty, mut &emptyDef, mut &onErr, mut &errDef)
                let ed = lexdb_sql.litText(&emptyDef).unwrapOr(lexdb_sql.exprText(&emptyDef))
                let hasED = onEmpty == J_ON_DEFAULT
                let rd = lexdb_sql.litText(&errDef).unwrapOr(lexdb_sql.exprText(&errDef))
                let hasRD = onErr == J_ON_DEFAULT
                append(out, encJTabCol(&kind, &path, ty.oid, wrapper, onEmpty, hasED, &ed, onErr, hasRD, &rd, nestedPrefix, &cname, &cspell))
            }
        }
        if !p.acceptKw(",") { break }
    }
    return Ok(Unit{})
}

fn (p: mut &P) jsonTableFrom(join: int): Result[FromItem, lexdb_base.DbErr] {
    try p.expectKw("json_table")
    try p.expectKw("(")
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    let doc = try p.expr()
    try p.expectKw(",")
    let path = try p.expr()
    var passing: []Expr = []
    try p.parseJsonPassing(mut &passing)
    try p.expectKw("columns")
    try p.expectKw("(")
    var colSpecs: []str = []
    try p.parseJTabColList(&"", mut &colSpecs)
    try p.expectKw(")")
    var onEmpty = J_ON_NULL
    var emptyDef = Expr.Lit(Val.Null)
    var onErr = J_ON_NULL
    var errDef = Expr.Lit(Val.Null)
    let _on = try p.parseJsonOnClauses(mut &onEmpty, mut &emptyDef, mut &onErr, mut &errDef)
    try p.expectKw(")")
    var s = lexdb_sql.newStmt(S_SELECT)
    s.srf = "json_table:" + strings.join(&colSpecs, "\x1e")
    s.use = SUB_FROM
    append(mut &s.items, SelItem{star: false, qual: "", expr: Some(doc), alias: "", spell: ""})
    append(mut &s.items, SelItem{star: false, qual: "", expr: Some(path), alias: "", spell: ""})
    append(mut &s.items, SelItem{star: false, qual: "", expr: Some(Expr.Lit(Val.Int(onErr))), alias: "", spell: ""})
    for px in passing { append(mut &s.items, SelItem{star: false, qual: "", expr: Some(px), alias: "", spell: ""}) }
    s.subs = replace(mut &p.subs, saved)
    s.wins = replace(mut &p.wins, savedW)
    p.depth -= 1
    append(mut &p.subs, s)
    let i = len(p.subs) - 1
    var alias = "json_table"
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols, false)
    return Ok(FromItem{table: "json_table", alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: true, using: [], natural: false, comma: false})
}

fn (p: mut &P) openJsonFrom(join: int): Result[FromItem, lexdb_base.DbErr] {
    try p.expectKw("openjson")
    try p.expectKw("(")
    p.depth += 1
    let saved = replace(mut &p.subs, [])
    let savedW = replace(mut &p.wins, [])
    let doc = try p.expr()
    var hasPath = false
    var path = Expr.Lit(Val.Null)
    if p.acceptKw(",") {
        hasPath = true
        path = try p.expr()
    }
    try p.expectKw(")")
    var s = lexdb_sql.newStmt(S_SELECT)
    s.use = SUB_FROM
    if p.acceptKw("with") {
        try p.expectKw("(")
        var colSpecs: []str = []
        while true {
            let cname = try p.name()
            let cspell = p.spelled.clone()
            let ty = try p.typeName()
            var pathStr = "$." + (if len(cspell) > 0 { cspell.clone() } else { cname.clone() })
            if p.peek().kind == T_STR { pathStr = p.next().text }
            var kind = "val"
            if p.acceptKw("as") {
                try p.expectKw("json")
                kind = "json"
            } else if ty.oid == OID_JSON {
                kind = "json"
            }
            append(mut &colSpecs, encJTabCol(&kind, &pathStr, ty.oid, J_WRAP_NONE, J_ON_NULL, false, &"", J_ON_NULL, false, &"", &"", &cname, &cspell))
            if !p.acceptKw(",") { break }
        }
        try p.expectKw(")")
        s.srf = "openjson_with:" + strings.join(&colSpecs, "\x1e")
        append(mut &s.items, SelItem{star: false, qual: "", expr: Some(doc), alias: "", spell: ""})
        append(mut &s.items, SelItem{star: false, qual: "", expr: Some(path), alias: "", spell: ""})
        append(mut &s.items, SelItem{star: false, qual: "", expr: Some(Expr.Lit(Val.Int(0))), alias: "", spell: ""})
    } else {
        s.srf = "openjson"
        append(mut &s.items, SelItem{star: false, qual: "", expr: Some(doc), alias: "", spell: ""})
        if hasPath { append(mut &s.items, SelItem{star: false, qual: "", expr: Some(path), alias: "", spell: ""}) }
    }
    s.subs = replace(mut &p.subs, saved)
    s.wins = replace(mut &p.wins, savedW)
    p.depth -= 1
    append(mut &p.subs, s)
    let i = len(p.subs) - 1
    var alias = "openjson"
    var cols: []str = []
    try p.aliasOf(mut &alias, mut &cols, false)
    return Ok(FromItem{table: "openjson", alias: alias, join: join, on: None, sub: i, cols: cols, work: -1, lateral: true, using: [], natural: false, comma: false})
}

fn (p: mut &P) forJsonClause(s: mut &Stmt): Result[Unit, lexdb_base.DbErr] {
    var pathMode = true
    if p.acceptKw("path") { pathMode = true }
    else if p.acceptKw("auto") { pathMode = false }
    else { return Err(near(&p.peek())) }
    var rootName = ""
    var incNulls = false
    var noWrap = false
    while p.acceptKw(",") {
        if p.acceptKw("root") {
            if p.acceptKw("(") {
                rootName = try p.strLit()
                try p.expectKw(")")
            } else {
                rootName = "root"
            }
        } else if p.acceptKw("include_null_values") {
            incNulls = true
        } else if p.acceptKw("without_array_wrapper") {
            noWrap = true
        } else {
            return Err(near(&p.peek()))
        }
    }
    s.forJson = (if pathMode { "path" } else { "auto" }) + "\x1f" + rootName + "\x1f" +
                (if incNulls { "1" } else { "0" }) + "\x1f" + (if noWrap { "1" } else { "0" })
    return Ok(Unit{})
}
