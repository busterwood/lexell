// lexdb: the 4 KiB page formats (design/lexdb.md 4.1, 4.2).
//
// Every page: [0..4) CRC32C of [4..4096), [4..12) its own page number,
// [12] its type, [13..16) zero. A page read from the wrong place, or torn,
// fails the check.
//
// Leaf (type 2, T_LEAF; written before design/lexdb.md 9.109, still read):
// [16..18) n; then n entries: u16 key length, u16 value length, key, value.
// Leaf (type 6, T_FLEAF, 9.109; every leaf written since): [16..18) n; then
// n entries, each key front coded against the key before it on the page
// (the first against ""):
//   - a header, of one of two forms, told by its first byte:
//     - below 0x80: that byte is how many bytes the key shares with the key
//       before (0 to 127); then a varint (LEB128) of the bytes left (the
//       tail); then a varint of twice the value's length, plus 1 when the
//       value is the key's last bytes (suffix);
//     - 0x80 and up: a u32 LE: 0x80 | shared's low 7 bits | its high 2 bits
//       << 8 | tail << 10 | suffix << 20 | the value's length << 21;
//   - the tail;
//   - the value, unless it is the key's last bytes. A secondary index's
//     entry is its columns then the primary key, its value the primary key
//     (lexdb_exec idxEntry), so the primary key is stored once.
// Each entry takes at most its bytes in T_LEAF (frontEntry), so a T_LEAF
// page always fits again as T_FLEAF, and a leaf's size (Node.size) is its
// bytes in T_FLEAF.
// Leaf (type 7, T_CLEAF, 9.112; a table's leaf whose rows are all in one
// fixed layout, written by a checkpoint): [16..18) n; [18..20) K, the
// keys' bytes; [20..22) L, the columns' bytes; [22..22 + K) the keys, each
// front coded against the key before (a varint of the bytes shared, a
// varint of the tail's length, the tail); then L bytes, the rows by
// column (lexdb_cols). The rows are given back as they were written,
// byte for byte (lexdb_cols.rowOf).
// Internal (type 3): [16..18) n keys; [18..26) child 0; then n entries: u16
// key length, key, u64 child. Child i+1 holds the keys >= key i.
// Meta (type 1, pages 0 and 1): see Meta.
// List (type 5): [16..24) next list page (0: none), [24..28) count, then
// u64 values. The tree roots, the free pages' runs and the dropped
// subtrees are lists.
import "binary"
import "./lexdb_base"
import "./lexdb_disk"
import "./lexdb_cols"

extern "c" fn memcpy(dst: mut &[byte], src: &[byte], n: int): ptr

pub const PAGE = 4096
pub const T_META = 1
pub const T_LEAF = 2
pub const T_INTERNAL = 3
pub const T_LIST = 5
pub const T_FLEAF = 6
pub const T_CLEAF = 7

// Whether page type t is a leaf's (any form).
pub fn isLeafType(t: int): bool { return t == T_LEAF || t == T_FLEAF || t == T_CLEAF }

const HDR = 16
// The bytes a node's entries may use: the page less the header and count
// (leaf), and for an internal node also its first child.
pub const NODE_ROOM = PAGE - HDR - 2
// The largest leaf entry: a node over NODE_ROOM always splits into two that
// fit when no entry is over a third of it.
pub const MAX_ENTRY = 1350
pub const MAX_KEY = 512
const LIST_ROOM = (PAGE - 28) / 8

// A B+tree node as the store holds it in memory. kids are slot numbers of
// the store's node table (page numbers between decode and install).
//
// A leaf read from disk, or written by a checkpoint, is lazy: it keeps its
// page's entries as one string (body) and where each entry's key and value
// are (ents),
// and a key or value is sliced from body only when asked for (key, val).
// Nothing else is made per entry, so a miss costs a scan of the entry
// lengths, and the node about its page's bytes (design/lexdb.md 9.70).
// Before a change, loosen makes keys and vals arrays (slices of body). Read
// a leaf with count, key, val and lower; keys and vals are empty while it
// is lazy. Internal nodes are never lazy.
pub type Node = record {
    pub leaf: bool
    pub keys: []str
    pub vals: []str
    pub kids: []int
    pub size: int        // the bytes its entries take on a page; -1: a lazy leaf from a T_LEAF page, counted when loosened
    pub packed: bool     // its keys and values are slices of one string (read or written as a page since it changed)
    pub lazy: bool       // a leaf whose entries are body's, at ents (keys and vals empty)
    pub body: str
    pub ents: []int      // a lazy leaf: where entry i's key and value are in body (kStart and the others)
    // A column leaf (lazy, from a T_CLEAF page or a checkpoint, 9.112):
    // body is colBody's (its keys, then cols), ents give the keys (no
    // values), cols is the rows by column (lexdb_cols) and cdir its
    // directory (lexdb_cols.parse); a value is rebuilt when asked for.
    // Empty otherwise.
    pub cols: str
    pub cdir: []int
}

pub fn newNode(leaf: bool): Node { return Node{leaf: leaf, keys: [], vals: [], kids: [], size: 0, packed: false, lazy: false, body: "", ents: [], cols: "", cdir: []} }

// Whether n is a column leaf (its rows by column: cols, cdir).
pub fn (n: &Node) isCols(): bool { return len(n.cdir) > 0 }

pub fn newLeaf(): Node { return newNode(true) }

// Its entries (a leaf's) or keys (an internal node's).
pub fn (n: &Node) count(): int { return if n.lazy { len(n.ents) } else { len(n.keys) } }

// A lazy leaf's entry i: where its key and value are in body: key start
// (20 bits), key length (12), value start (20), value length (11). A body
// is its page's entries made whole: front coding lets a page's keys take
// far more than 4 KiB (at most about 1,360 keys of 530 bytes), and keys
// and values are at most MAX_KEY and MAX_ENTRY bytes. A value that is its
// key's last bytes is a slice of the key.
fn kStart(e: int): int { return e & 0xfffff }
fn kEnd(e: int): int { return (e & 0xfffff) + ((e >> 20) & 0xfff) }
fn vStart(e: int): int { return (e >> 32) & 0xfffff }
fn vEnd(e: int): int { return ((e >> 32) & 0xfffff) + ((e >> 52) & 0x7ff) }
fn ent(ks: int, kl: int, vs: int, vl: int): int { return ks | (kl << 20) | (vs << 32) | (vl << 52) }

// Key i.
pub fn (n: &Node) key(i: int): str {
    if !n.lazy { return n.keys[i] }
    let e = n.ents[i]
    return n.body[kStart(e)..kEnd(e)]
}

// Value i (a leaf's); a column leaf's row is rebuilt.
pub fn (n: &Node) val(i: int): str {
    if !n.lazy { return n.vals[i] }
    if len(n.cdir) > 0 { return lexdb_cols.rowOf(&n.cols, &n.cdir, i) }
    let e = n.ents[i]
    return n.body[vStart(e)..vEnd(e)]
}

// Value i as a view of the node's bytes: nothing made or counted (a scan's
// rows are read through it). Not of a column leaf (isCols), whose rows
// are read by column or rebuilt (val).
pub fn (n: &Node) valView(i: int): &str {
    if !n.lazy { return &n.vals[i] }
    if len(n.cdir) > 0 { panic("valView of a column leaf") }
    let e = n.ents[i]
    return &n.body[vStart(e)..vEnd(e)]
}

// Where a lazy leaf's value i starts in its body.
pub fn valStart(n: &Node, i: int): int { return vStart(n.ents[i]) }

// The first i whose key is >= k (count() when none).
pub fn (n: &Node) lower(k: &str): int {
    var lo = 0
    if !n.lazy {
        var hi = len(n.keys)
        while lo < hi {
            let m = (lo + hi) / 2
            if n.keys[m] < k { lo = m + 1 } else { hi = m }
        }
        return lo
    }
    var hi = len(n.ents)
    if hi > 0 {
        // a scan going on into the next leaf asks for its first key
        let e0 = n.ents[0]
        let k0 = &n.body[kStart(e0)..kEnd(e0)]
        if k0 >= k { return 0 }
    }
    while lo < hi {
        let m = (lo + hi) / 2
        let e = n.ents[m]
        let km = &n.body[kStart(e)..kEnd(e)]
        if km < k { lo = m + 1 } else { hi = m }
    }
    return lo
}

// Makes a lazy leaf's keys and vals arrays, slices of its body, so that it
// can be changed.
pub fn (n: mut &Node) loosen() {
    if !n.lazy { return }
    if len(n.cdir) > 0 {
        // a column leaf: its rows rebuilt, as one string
        n.loosenCols()
        return
    }
    let cnt = len(n.ents)
    var keys: []str = array(cnt, "")
    var vals: []str = array(cnt, "")
    for i in 0..cnt {
        let e = n.ents[i]
        keys[i] = n.body[kStart(e)..kEnd(e)]
        vals[i] = n.body[vStart(e)..vEnd(e)]
    }
    n.keys = keys
    n.vals = vals
    n.lazy = false
    n.packed = true
    n.body = ""
    n.ents = []
    if n.size < 0 { n.size = leafSize(n) }
}

fn (n: mut &Node) loosenCols() {
    let cnt = len(n.ents)
    var ends: []int = array(cnt, 0)
    let rows = lexdb_cols.allRows(&n.cols, &n.cdir, mut &ends)
    var keys: []str = array(cnt, "")
    var vals: []str = array(cnt, "")
    for i in 0..cnt {
        let e = n.ents[i]
        keys[i] = n.body[kStart(e)..kEnd(e)]
        vals[i] = rows[if i == 0 { 0 } else { ends[i - 1] }..ends[i]]
    }
    n.keys = keys
    n.vals = vals
    n.lazy = false
    n.packed = false
    n.body = ""
    n.ents = []
    n.cols = ""
    n.cdir = []
    n.size = leafSize(n)
}

// A leaf's body in memory: its entries whole, each a u16 key length, a u16
// value length, the key and the value; the value length | SUFFIX when the
// value is the key's last bytes, then not there again. A T_LEAF page's
// entries are such a body (none a suffix).
const SUFFIX = 0x8000

// A lazy leaf over body (cnt entries); its size is the caller's to set.
fn lazyLeaf(body: str, cnt: int): Node {
    var ents: []int = array(cnt, 0)
    var at = 0
    for i in 0..cnt {
        let kl = binary.readU16LEStr(&body, at)
        let vw = binary.readU16LEStr(&body, at + 2)
        let vl = vw & 0x7fff
        if vw & SUFFIX != 0 {
            ents[i] = ent(at + 4, kl, at + 4 + kl - vl, vl)
            at += 4 + kl
        } else {
            ents[i] = ent(at + 4, kl, at + 4 + kl, vl)
            at += 4 + kl + vl
        }
    }
    return Node{leaf: true, keys: [], vals: [], kids: [], size: 0, packed: true, lazy: true, body: body, ents: ents, cols: "", cdir: []}
}

// The bytes of an entry in T_LEAF: what bounds an entry (MAX_ENTRY), and
// what it takes at most in T_FLEAF.
pub fn leafEntry(k: &str, v: &str): int { return 4 + len(k) + len(v) }
pub fn kidEntry(k: &str): int { return 2 + len(k) + 8 }

// ---- front coding (T_FLEAF)

fn commonLen(a: &str, b: &str): int {
    let m = if len(a) < len(b) { len(a) } else { len(b) }
    var n = 0
    while n < m && a[n] == b[n] { n += 1 }
    return n
}

// Whether value v is key k's last bytes (an index entry's primary key).
fn isSuffix(k: &str, v: &str): bool {
    let kl = len(k)
    let vl = len(v)
    if vl == 0 || vl > kl { return false }
    for i in 0..vl { if k[kl - vl + i] != v[i] { return false } }
    return true
}

fn varLen(x: int): int { return if x < 0x80 { 1 } else if x < 0x4000 { 2 } else { 3 } }

fn putVar(b: mut &[]byte, at: int, x: int): int {
    var v = x
    var p = at
    while v >= 0x80 {
        b[p] = byte((v & 0x7f) | 0x80)
        v = v >> 7
        p += 1
    }
    b[p] = byte(v)
    return p + 1
}

// An entry's header on a T_FLEAF page: its bytes, the key's bytes shared
// with the key before, whether the value is the key's last bytes, and the
// u32 form (fixed) or the varint one. The smaller of the two; the fixed
// form, never over T_LEAF's 4 bytes, holds any key and value a leaf can
// (a tail up to 1,023 bytes, a value up to 2,047).
type Front = value record { hdr: int; shared: int; suffix: bool; fixed: bool }

fn frontOf(prev: &str, k: &str, v: &str): Front {
    let c = commonLen(prev, k)
    let kl = len(k)
    let vl = len(v)
    let suf = isSuffix(k, v)
    let s1 = if c < 127 { c } else { 127 }
    let hv = 1 + varLen(kl - s1) + varLen(2 * vl + (if suf { 1 } else { 0 }))
    let s2 = if c < 511 { c } else { 511 }
    if kl - s2 <= 1023 && vl <= 2047 && 4 + kl - s2 < hv + kl - s1 {
        return Front{hdr: 4, shared: s2, suffix: suf, fixed: true}
    }
    return Front{hdr: hv, shared: s1, suffix: suf, fixed: false}
}

// The bytes entry (k, v) takes on a T_FLEAF page after the key prev ("" for
// a page's first): at most leafEntry(k, v).
pub fn frontEntry(prev: &str, k: &str, v: &str): int {
    let f = frontOf(prev, k, v)
    return f.hdr + len(k) - f.shared + (if f.suffix { 0 } else { len(v) })
}

// The bytes a leaf's entries take on a T_FLEAF page: its size.
pub fn leafSize(n: &Node): int {
    var size = 0
    for i in 0..n.count() {
        if i == 0 { size += frontEntry(&"", &n.key(0), &n.val(0)) }
        else { size += frontEntry(&n.key(i - 1), &n.key(i), &n.val(i)) }
    }
    return size
}

// The bytes of each of a leaf's entries on a T_FLEAF page (frontEntry after
// the key before).
pub fn leafSizes(n: &Node): []int {
    var out: []int = array(n.count(), 0)
    for i in 0..n.count() {
        out[i] = if i == 0 { frontEntry(&"", &n.key(0), &n.val(0)) } else { frontEntry(&n.key(i - 1), &n.key(i), &n.val(i)) }
    }
    return out
}

// Writes entry (k, v) after key prev at b[at..], if it ends by end; the
// bytes it takes (written or not).
fn putFront(b: mut &[]byte, at: int, end: int, prev: &str, k: &str, v: &str): int {
    let f = frontOf(prev, k, v)
    let tail = len(k) - f.shared
    let vl = len(v)
    let size = f.hdr + tail + (if f.suffix { 0 } else { vl })
    if at + size > end { return size }
    let sb = if f.suffix { 1 } else { 0 }
    var p = at
    if f.fixed {
        binary.setU32LE(b, p, 0x80 | (f.shared & 0x7f) | ((f.shared >> 7) << 8) | (tail << 10) | (sb << 20) | (vl << 21))
        p += 4
    } else {
        b[p] = byte(f.shared)
        p = putVar(b, p + 1, tail)
        p = putVar(b, p, 2 * vl + sb)
    }
    for i in 0..tail { b[p + i] = k[f.shared + i] }
    p += tail
    if !f.suffix {
        for i in 0..vl { b[p + i] = v[i] }
        p += vl
    }
    return p - at
}

// A T_FLEAF page's entries, header by header: shared, tail and value
// lengths, suffix, and where the tail starts.
type FrontHdr = value record { shared: int; tail: int; vl: int; suffix: bool; at: int }

fn readFront(b: &[]byte, at: int): FrontHdr {
    let h0 = int(b[at])
    if h0 < 0x80 {
        var p = at + 1
        var tail = 0
        var sh = 0
        while true {
            let x = int(b[p])
            tail = tail | ((x & 0x7f) << sh)
            p += 1
            sh += 7
            if x < 0x80 { break }
        }
        var w = 0
        sh = 0
        while true {
            let x = int(b[p])
            w = w | ((x & 0x7f) << sh)
            p += 1
            sh += 7
            if x < 0x80 { break }
        }
        return FrontHdr{shared: h0, tail: tail, vl: w >> 1, suffix: w & 1 != 0, at: p}
    }
    let x = binary.readU32LE(b, at)
    return FrontHdr{shared: (x & 0x7f) | (((x >> 8) & 3) << 7), tail: (x >> 10) & 0x3ff, vl: (x >> 21) & 0x7ff,
                    suffix: (x >> 20) & 1 != 0, at: at + 4}
}

// A lazy leaf from a T_FLEAF page b (cnt entries): its keys made whole,
// into a body as lazyLeaf reads; its size, the page's bytes for them.
fn frontLeaf(b: &[]byte, cnt: int): Node {
    var total = 0
    var at = 18
    for i in 0..cnt {
        let h = readFront(b, at)
        total += 4 + h.shared + h.tail + (if h.suffix { 0 } else { h.vl })
        at = h.at + h.tail + (if h.suffix { 0 } else { h.vl })
    }
    let size = at - 18
    var out: []byte = array(total, byte(0))
    var ents: []int = array(cnt, 0)
    var o = 0
    var prev = 0                        // where the key before starts in out
    at = 18
    for i in 0..cnt {
        let h = readFront(b, at)
        let kl = h.shared + h.tail
        binary.setU16LE(mut &out, o, kl)
        binary.setU16LE(mut &out, o + 2, h.vl | (if h.suffix { SUFFIX } else { 0 }))
        let ks = o + 4
        for j in 0..h.shared { out[ks + j] = out[prev + j] }
        // the tail, and the value after it, are together on the page and in out
        let n = h.tail + (if h.suffix { 0 } else { h.vl })
        if n > 0 { let c = memcpy(mut &out[ks + h.shared..ks + h.shared + n], &b[h.at..h.at + n], n) }
        if h.suffix {
            ents[i] = ent(ks, kl, ks + kl - h.vl, h.vl)
            o = ks + kl
        } else {
            ents[i] = ent(ks, kl, ks + kl, h.vl)
            o = ks + kl + h.vl
        }
        at = h.at + n
        prev = ks
    }
    return Node{leaf: true, keys: [], vals: [], kids: [], size: size, packed: true, lazy: true, body: strFromBytes(&out), ents: ents, cols: "", cdir: []}
}

// Leaf n's page, numbered pageNo: front coded (T_FLEAF); or, should its
// entries not fit so (its size miscounted: they always do), whole (T_LEAF)
// if they fit that way. A leaf that fits neither way traps.
fn leafPage(n: &Node, pageNo: int): []byte {
    var b = array(PAGE, byte(0))
    binary.setU16LE(mut &b, 16, n.count())
    var at = 18
    for i in 0..n.count() {
        if at > PAGE { break }
        if i == 0 { at += putFront(mut &b, at, PAGE, &"", &n.key(0), &n.val(0)) }
        else { at += putFront(mut &b, at, PAGE, &n.key(i - 1), &n.key(i), &n.val(i)) }
    }
    if at <= PAGE {
        seal(mut &b, pageNo, T_FLEAF)
        return b
    }
    var w = array(PAGE, byte(0))
    binary.setU16LE(mut &w, 16, n.count())
    at = 18
    for i in 0..n.count() {
        binary.setU16LE(mut &w, at, len(n.key(i)))
        binary.setU16LE(mut &w, at + 2, len(n.val(i)))
        putStr(mut &w, at + 4, &n.key(i))
        putStr(mut &w, at + 4 + len(n.key(i)), &n.val(i))
        at += leafEntry(&n.key(i), &n.val(i))
    }
    seal(mut &w, pageNo, T_LEAF)
    return w
}

// ---- column leaves (T_CLEAF, 9.112)
//
// In memory, and in a checkpoint's PageOut, a column leaf's body is
// \xff\xff (no row body starts so: a key is at most MAX_KEY bytes), a u32
// of its keys' bytes K, its keys as a lazy body holds them (a u16 key
// length, a u16 0, the key), then its columns.

const CB = 6

// Whether body is a column leaf's.
pub fn isColBody(body: &str): bool { return len(body) >= CB && body[0] == 0xff && body[1] == 0xff }

// A column leaf's body: keys from (lazy body form, kb bytes) and columns cols.
fn colBodyOf(keys: &[]byte, kb: int, cols: &str): str {
    var out: []byte = array(CB + kb + len(cols), byte(0))
    out[0] = byte(0xff)
    out[1] = byte(0xff)
    binary.setU32LE(mut &out, 2, kb)
    for i in 0..kb { out[CB + i] = keys[i] }
    for i in 0..len(cols) { out[CB + kb + i] = cols[i] }
    return strFromBytes(&out)
}

// The column leaf of body (cnt rows).
fn colNode(body: str, cnt: int): Node {
    let kb = binary.readU32LEStr(&body, 2)
    var ents: []int = array(cnt, 0)
    var at = CB
    for i in 0..cnt {
        let kl = binary.readU16LEStr(&body, at)
        ents[i] = ent(at + 4, kl, 0, 0)
        at += 4 + kl
    }
    let cols = body[CB + kb..]
    let dir = match lexdb_cols.parse(&cols, cnt) {
        Some(d) { d }
        None { panic("a column leaf's columns") }
    }
    return Node{leaf: true, keys: [], vals: [], kids: [], size: CB + len(body), packed: true, lazy: true, body: body, ents: ents, cols: cols, cdir: dir}
}

// The bytes leaf n's keys take front coded on a T_CLEAF page.
fn colKeysSize(n: &Node): int {
    var size = 0
    for i in 0..n.count() {
        let k = n.key(i)
        let c = if i == 0 { 0 } else { commonLen(&n.key(i - 1), &k) }
        size += varLen(c) + varLen(len(k) - c) + len(k) - c
    }
    return size
}

// Leaf n as a column leaf's body (colBodyOf), its rows encoded with the
// tree's layouts: None when they do not all encode (lexdb_cols.encodeRows)
// or the page would not hold them; a column leaf's own body.
pub fn colBody(n: &Node, spec: &lexdb_cols.Spec): Option[str] {
    if !n.leaf { return None }
    if n.isCols() { return Some(n.body) }
    let cnt = n.count()
    if cnt == 0 { return None }
    var rows: []&str = withCapacity(cnt)
    for i in 0..cnt { append(mut &rows, n.valView(i)) }
    let got = lexdb_cols.encodeChecked(&rows, spec)
    if got.isNone() { return None }
    let cols = got.unwrap()
    if 22 + colKeysSize(n) + len(cols) > PAGE { return None }
    var kb = 0
    for i in 0..cnt { kb += 4 + len(n.key(i)) }
    var keys: []byte = array(kb, byte(0))
    var at = 0
    for i in 0..cnt {
        let k = n.key(i)
        binary.setU16LE(mut &keys, at, len(k))
        putStr(mut &keys, at + 4, &k)
        at += 4 + len(k)
    }
    return Some(colBodyOf(&keys, kb, &cols))
}

// Page pageNo holding column leaf body (colBody's) of cnt rows.
fn colPage(body: &str, cnt: int, pageNo: int): []byte {
    var b = array(PAGE, byte(0))
    let kb = binary.readU32LEStr(body, 2)
    let cols = &body[CB + kb..]
    binary.setU16LE(mut &b, 16, cnt)
    var at = 22
    var p = CB
    var prev = -1
    for i in 0..cnt {
        let kl = binary.readU16LEStr(body, p)
        let k = &body[p + 4..p + 4 + kl]
        let c = if prev < 0 { 0 } else { commonLen(&body[prev + 4..prev + 4 + binary.readU16LEStr(body, prev)], k) }
        at = putVar(mut &b, at, c)
        at = putVar(mut &b, at, kl - c)
        for j in c..kl { b[at + j - c] = k[j] }
        at += kl - c
        prev = p
        p += 4 + kl
    }
    binary.setU16LE(mut &b, 18, at - 22)
    binary.setU16LE(mut &b, 20, len(cols))
    for j in 0..len(cols) { b[at + j] = cols[j] }
    seal(mut &b, pageNo, T_CLEAF)
    return b
}

fn getVar(b: &[]byte, at: mut &int): int {
    var v = 0
    var sh = 0
    while true {
        let x = int(b[at])
        at += 1
        v = v | ((x & 0x7f) << sh)
        sh += 7
        if x < 0x80 || sh > 21 { break }
    }
    return v
}

// Whether a T_CLEAF page's parts are where its header says, its keys
// within them, and its columns a column region (a page that passed its
// checksum, so a check of the format, not of the bytes).
fn colPageOk(b: &[]byte): bool {
    let n = binary.readU16LE(b, 16)
    let kl = binary.readU16LE(b, 18)
    let cl = binary.readU16LE(b, 20)
    if n == 0 || 22 + kl + cl > PAGE { return false }
    var at = 22
    var prevLen = 0
    for i in 0..n {
        if at + 2 > 22 + kl { return false }
        let c = getVar(b, mut &at)
        if at >= 22 + kl { return false }
        let t = getVar(b, mut &at)
        if c > prevLen || at + t > 22 + kl || c + t > MAX_KEY { return false }
        at += t
        prevLen = c + t
    }
    if at != 22 + kl { return false }
    return lexdb_cols.parse(&getStr(b, 22 + kl, cl), n).isSome()
}

// The column leaf on T_CLEAF page b (cnt rows; colPageOk checked it).
fn colLeaf(b: &[]byte, cnt: int): Node {
    let kl = binary.readU16LE(b, 18)
    let cl = binary.readU16LE(b, 20)
    // the keys made whole
    var kb = 0
    var at = 22
    for i in 0..cnt {
        let c = getVar(b, mut &at)
        let t = getVar(b, mut &at)
        kb += 4 + c + t
        at += t
    }
    var out: []byte = array(CB + kb + cl, byte(0))
    out[0] = byte(0xff)
    out[1] = byte(0xff)
    binary.setU32LE(mut &out, 2, kb)
    at = 22
    var o = CB
    var prev = CB
    for i in 0..cnt {
        let c = getVar(b, mut &at)
        let t = getVar(b, mut &at)
        binary.setU16LE(mut &out, o, c + t)
        for j in 0..c { out[o + 4 + j] = out[prev + 4 + j] }
        for j in 0..t { out[o + 4 + c + j] = b[at + j] }
        at += t
        prev = o
        o += 4 + c + t
    }
    for j in 0..cl { out[o + j] = b[22 + kl + j] }
    var l = colNode(strFromBytes(&out), cnt)
    l.size = 22 + kl + cl
    return l
}

// ---- header and check

fn seal(b: mut &[]byte, pageNo: int, typ: int) {
    binary.setU64LE(b, 4, pageNo)
    b[12] = byte(typ)
    let c = lexdb_base.crc32c(b, 4, PAGE)
    binary.setU32LE(b, 0, int(c))
}

// Checks a page read from disk: its CRC, number and type.
pub fn check(b: &[]byte, pageNo: int, typ: int): Result[Unit, lexdb_base.DbErr] {
    let c = lexdb_base.crc32c(b, 4, PAGE)
    if int(c) != binary.readU32LE(b, 0) {
        return Err(lexdb_base.corrupt("page " + pageNo.toStr() + ": checksum mismatch"))
    }
    if int(binary.readU64LE(b, 4)) != pageNo {
        return Err(lexdb_base.corrupt("page " + pageNo.toStr() + ": holds page " + int(binary.readU64LE(b, 4)).toStr()))
    }
    if int(b[12]) != typ && !(typ == T_LEAF && (int(b[12]) == T_INTERNAL || int(b[12]) == T_FLEAF || int(b[12]) == T_CLEAF)) {
        return Err(lexdb_base.corrupt("page " + pageNo.toStr() + ": type " + int(b[12]).toStr()))
    }
    if int(b[12]) == T_CLEAF && !colPageOk(b) {
        return Err(lexdb_base.corrupt("page " + pageNo.toStr() + ": a column leaf's columns"))
    }
    return Ok(Unit{})
}

fn putStr(b: mut &[]byte, at: int, s: &str) {
    for i in 0..len(s) { b[at + i] = s[i] }
}

fn getStr(b: &[]byte, at: int, n: int): str {
    return strFromBytes(&b[at..at + n])
}

// ---- nodes

// The page of a node whose kids have been given page numbers (pages[i] for
// kid i).
pub fn encodeNode(n: &Node, pages: &[]int, pageNo: int): []byte {
    if n.leaf { return leafPage(n, pageNo) }
    var b = array(PAGE, byte(0))
    binary.setU16LE(mut &b, 16, n.count())
    binary.setU64LE(mut &b, 18, pages[0])
    var at = 26
    for i in 0..len(n.keys) {
        binary.setU16LE(mut &b, at, len(n.keys[i]))
        putStr(mut &b, at + 2, &n.keys[i])
        binary.setU64LE(mut &b, at + 2 + len(n.keys[i]), pages[i + 1])
        at += kidEntry(&n.keys[i])
    }
    seal(mut &b, pageNo, T_INTERNAL)
    return b
}

// The node on a checked page; an internal node's kids are page numbers.
// Its keys and values are slices of one string, the page's entries (one
// allocation, not one per key and per value: design/lexdb.md 9.13).
pub fn decodeNode(b: &[]byte): Node {
    let n = binary.readU16LE(b, 16)
    if int(b[12]) == T_FLEAF { return frontLeaf(b, n) }
    if int(b[12]) == T_CLEAF { return colLeaf(b, n) }
    let leaf = int(b[12]) == T_LEAF
    var end = if leaf { 18 } else { 26 }
    for i in 0..n {
        end += if leaf { 4 + binary.readU16LE(b, end) + binary.readU16LE(b, end + 2) } else { 2 + binary.readU16LE(b, end) + 8 }
    }
    if leaf {
        // a page from before 9.109: its body is a lazy leaf's as it is. Its
        // size front coded is counted when it is loosened to change: on a
        // read, counting it cost as much as the read's decoding (9.110)
        var l = lazyLeaf(getStr(b, 18, end - 18), n)
        l.size = -1
        return l
    }
    var node = Node{leaf: false, keys: array(n, ""), vals: [], kids: array(n + 1, 0), size: end - 18, packed: true, lazy: false, body: "", ents: [], cols: "", cdir: []}
    unpack(mut &node, &getStr(b, 18, end - 18), true)
    return node
}

// What a checkpoint keeps of node n to write its page (bodyPage) and to
// make it lazy (repack): a leaf's body as a lazy leaf holds it, its keys
// whole (the page is front coded as it is written); an internal node's
// page from byte 18 (with its kids' pages, pages[i] for kid i).
pub fn nodeBody(n: &Node, pages: &[]int): str {
    if n.lazy { return n.body }
    if n.leaf {
        var total = 0
        for i in 0..len(n.keys) { total += 4 + len(n.keys[i]) + (if isSuffix(&n.keys[i], &n.vals[i]) { 0 } else { len(n.vals[i]) }) }
        var b = array(total, byte(0))
        var at = 0
        for i in 0..len(n.keys) {
            let suf = isSuffix(&n.keys[i], &n.vals[i])
            binary.setU16LE(mut &b, at, len(n.keys[i]))
            binary.setU16LE(mut &b, at + 2, len(n.vals[i]) | (if suf { SUFFIX } else { 0 }))
            putStr(mut &b, at + 4, &n.keys[i])
            at += 4 + len(n.keys[i])
            if !suf {
                putStr(mut &b, at, &n.vals[i])
                at += len(n.vals[i])
            }
        }
        return strFromBytes(&b)
    }
    let b = encodeNode(n, pages, 0)
    return getStr(&b, 18, n.size)
}

// Page pageNo holding a node's body (nodeBody) and count: a leaf's front
// coded (T_FLEAF), or, should its entries not fit so (a size miscounted),
// whole (T_LEAF) when they fit that way.
pub fn bodyPage(leaf: bool, n: int, body: &str, pageNo: int): []byte {
    if leaf && isColBody(body) { return colPage(body, n, pageNo) }
    if leaf { return leafPage(&lazyLeaf(body.toStr(), n), pageNo) }
    var b = array(PAGE, byte(0))
    binary.setU16LE(mut &b, 16, n)
    putStr(mut &b, 18, body)
    seal(mut &b, pageNo, T_INTERNAL)
    return b
}

// Node n, its keys and values made slices of body, its page's body
// (nodeBody; its kids kept): a node changed by commits, each key and value
// its own allocation in arrays with room to spare, takes less memory
// after this.
pub fn repack(n: mut &Node, body: &str) {
    if n.leaf && isColBody(body) {
        let cnt = n.count()
        var l = colNode(body.toStr(), cnt)
        n.keys = []
        n.vals = []
        n.ents = replace(mut &l.ents, [])
        n.cdir = replace(mut &l.cdir, [])
        n.cols = l.cols
        n.body = l.body
        n.lazy = true
        n.packed = true
        return
    }
    if n.leaf {
        let cnt = n.count()
        n.keys = []
        n.vals = []
        n.cols = ""
        n.cdir = []
        var l = lazyLeaf(body.toStr(), cnt)
        n.ents = replace(mut &l.ents, [])
        n.body = l.body
        n.lazy = true
        n.packed = true
        return
    }
    var keys: []str = array(len(n.keys), "")
    n.keys = keys
    if n.leaf {
        var vals: []str = array(len(n.keys), "")
        n.vals = vals
    } else {
        var kids: []int = array(len(n.kids), 0)
        for i in 0..len(n.kids) { kids[i] = n.kids[i] }
        n.kids = kids
    }
    unpack(n, body, false)
}

// Fills n's keys and values (arrays of the right length) with slices of
// body (a page from byte 18), and with kids its kids' page numbers.
fn unpack(n: mut &Node, body: &str, kids: bool) {
    let cnt = len(n.keys)
    if n.leaf {
        var at = 0
        for i in 0..cnt {
            let kl = binary.readU16LEStr(body, at)
            let vl = binary.readU16LEStr(body, at + 2)
            n.keys[i] = body[at + 4..at + 4 + kl]
            n.vals[i] = body[at + 4 + kl..at + 4 + kl + vl]
            at += 4 + kl + vl
        }
        n.size = at
    } else {
        if kids { n.kids[0] = int(binary.readU64LEStr(body, 0)) }
        var at = 8
        for i in 0..cnt {
            let kl = binary.readU16LEStr(body, at)
            n.keys[i] = body[at + 2..at + 2 + kl]
            if kids { n.kids[i + 1] = int(binary.readU64LEStr(body, at + 2 + kl)) }
            at += 2 + kl + 8
        }
        n.size = at
    }
    n.packed = true
}

// About the memory a node in the cache takes (measured, design/lexdb.md
// 9.13): its record, and per key its strs (16 bytes each) with the
// arrays; packed, its entries' bytes and 64 bytes a key; changed since, its
// entries' bytes and 144 bytes a key (each key and value its own
// allocation, arrays with spare room); per child, the slot the store
// keeps for it, loaded or not: its SlotMeta and history list, about 120
// bytes (measured, 9.17; a slot not in memory holds no node).
pub fn nodeCost(n: &Node): int {
    if n.lazy { return 160 + len(n.body) + 8 * len(n.ents) + 8 * len(n.cdir) }
    let keys = n.size + (if n.packed { 64 } else { 144 }) * len(n.keys)
    return 160 + keys + 120 * len(n.kids)
}

// ---- meta pages

pub const MAGIC = 0x313030424458454C    // "LEXDB001", little-endian

pub type Meta = value record {
    pub ckpt: int          // checkpoint number; the higher valid meta page wins
    pub npages: int        // pages in use or free below this; the file's high-water mark
    pub roots: int         // first list page of (tree, root page) pairs, 0 when none
    pub free: int          // first list page of free pages, 0 when none (files before runs)
    pub replaySeg: int     // where recovery starts replaying the log
    pub replayOff: int
    pub replayBatch: int   // the batch number expected there
    pub nextTree: int      // the next tree id to give out
    pub dropped: int       // first list page of dropped subtrees still to free, 0 when none:
                           // (page, height + 1) pairs, 0 for a height not known
    pub runs: int          // first list page of the free pages as (first, count) runs, 0 when none
    pub covers: int        // every commit of the batches up to this one is in the trees (some of
                           // the next, or of this one, may be too: replaying them again changes
                           // nothing); a follower reads them as of a batch >= it (9.71). -1: not
                           // known (files from before it); kept as covers + 1, so 0 is that
}

pub fn encodeMeta(m: &Meta, pageNo: int): []byte {
    var b = array(PAGE, byte(0))
    binary.setU64LE(mut &b, 16, MAGIC)
    binary.setU64LE(mut &b, 24, m.ckpt)
    binary.setU64LE(mut &b, 32, m.npages)
    binary.setU64LE(mut &b, 40, m.roots)
    binary.setU64LE(mut &b, 48, m.free)
    binary.setU64LE(mut &b, 56, m.replaySeg)
    binary.setU64LE(mut &b, 64, m.replayOff)
    binary.setU64LE(mut &b, 72, m.replayBatch)
    binary.setU64LE(mut &b, 80, m.nextTree)
    binary.setU64LE(mut &b, 88, m.dropped)
    binary.setU64LE(mut &b, 96, m.runs)
    binary.setU64LE(mut &b, 104, m.covers + 1)
    seal(mut &b, pageNo, T_META)
    return b
}

// The meta page in b, or None when it is not a valid one (never written, or
// torn).
pub fn decodeMeta(b: &[]byte, pageNo: int): Option[Meta] {
    match check(b, pageNo, T_META) {
        Ok(_) {}
        Err(_) { return None }
    }
    if int(b[12]) != T_META || binary.readU64LE(b, 16) != u64(MAGIC) { return None }
    return Some(Meta{ckpt: int(binary.readU64LE(b, 24)), npages: int(binary.readU64LE(b, 32)),
                     roots: int(binary.readU64LE(b, 40)), free: int(binary.readU64LE(b, 48)),
                     replaySeg: int(binary.readU64LE(b, 56)), replayOff: int(binary.readU64LE(b, 64)),
                     replayBatch: int(binary.readU64LE(b, 72)), nextTree: int(binary.readU64LE(b, 80)),
                     dropped: int(binary.readU64LE(b, 88)), runs: int(binary.readU64LE(b, 96)),
                     covers: int(binary.readU64LE(b, 104)) - 1})
}

// ---- list pages

// How many list pages n values take.
pub fn listPages(n: int): int { return (n + LIST_ROOM - 1) / LIST_ROOM }

// The pages of a list of values, on the given page numbers (listPages(len)
// of them), each pointing to the next.
pub fn encodeList(vals: &[]int, pages: &[]int): [][]byte {
    var out: [][]byte = []
    for p in 0..len(pages) {
        var b = array(PAGE, byte(0))
        var from = p * LIST_ROOM
        if from > len(vals) { from = len(vals) }
        var to = from + LIST_ROOM
        if to > len(vals) { to = len(vals) }
        binary.setU64LE(mut &b, 16, if p + 1 < len(pages) { pages[p + 1] } else { 0 })
        binary.setU32LE(mut &b, 24, to - from)
        for i in from..to { binary.setU64LE(mut &b, 28 + (i - from) * 8, vals[i]) }
        seal(mut &b, pages[p], T_LIST)
        append(mut &out, b)
    }
    return out
}

// Reads a list whose first page is head (0: an empty list). The pages it
// took are added to pages.
pub fn readList(f: &lexdb_disk.File, head: int, pages: mut &[]int): Result[[]int, lexdb_base.DbErr] {
    var vals: []int = []
    var p = head
    var b = array(PAGE, byte(0))
    var seen = 0
    while p != 0 {
        seen += 1
        if seen > 1000000 { return Err(lexdb_base.corrupt("list pages form a loop")) }
        try f.read(p * PAGE, mut &b[0..PAGE], PAGE)
        try check(&b, p, T_LIST)
        if int(b[12]) != T_LIST { return Err(lexdb_base.corrupt("page " + p.toStr() + " is not a list page")) }
        append(mut &pages, p)
        let n = binary.readU32LE(&b, 24)
        for i in 0..n { append(mut &vals, int(binary.readU64LE(&b, 28 + i * 8))) }
        p = int(binary.readU64LE(&b, 16))
    }
    return Ok(vals)
}
