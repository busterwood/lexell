// lexdb_plan: the planner (layer 5, design/lexdb-layers.md 4.5). Its
// vocabulary: a path into a table, a way to join it, and the estimates
// compared to choose them (a table's statistics are lexdb_stats'); the plan
// structures (Query, Level, SubPlan, Sel) and the physical plan (PPlan) the
// executor runs; and the search: access paths (choosePath), the cost model
// and the join order (costOrder), implied equalities, semi and anti joins
// (hashed or looked up per row), ORDER BY served by a path, and EXPLAIN's
// text of a path. lexdb_exec binds FROM (bindFrom), then calls planFrom;
// what the planner needs of the executor comes through its hook (Up). The
// executor builds and reads the plan structures, so their fields are
// public.
import "collections"
import "strings"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_bind"
import "./lexdb_stats"
import "./lexdb_catalog"
import "./lexdb_access"
import "./lexdb_store"
import "./lexdb_ops"
import "./lexdb_rows"
import "./lexdb_agg"
import "./lexdb_window"
import "./lexdb_match"
import "./lexdb_gen"
import "./lexdb_census"

type Expr = lexdb_sql.Expr
type Val = lexdb_sql.Val
type DbErr = lexdb_base.DbErr
type Table = lexdb_catalog.Table
type Est = lexdb_stats.Est
type OutCol = lexdb_bind.OutCol
type Names = lexdb_bind.Names
type AggSpec = lexdb_agg.AggSpec
type WinPlan = lexdb_window.WinPlan
type Who = lexdb_catalog.Who
type BX = lexdb_bind.BX

fn e(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

// ---- the hook: what the planner needs of the executor
//
// Set once by lexdb_exec (planHook, when a session is made), as
// lexdb_pipe.Up and lexdb_stats.Up are: the planner sits below the
// executor and never imports it.
// - eval: an expression with no columns evaluated (a literal expression,
//   a parameter's): the executor's row evaluator, as constant folding.
// - typing: what the dialects supply the binder (exprOid's).
// - planSub: a subquery planned again (planFrom's semi-join alternative:
//   its outer values not a path's keys, Scope.noRefKeys).
pub type EvalFn = fn(&Expr, &[]Val): Result[Val, DbErr]
pub type PlanSubFn = fn(&lexdb_store.Store, mut &lexdb_store.Txn, &lexdb_sql.Stmt, &[]Val, mut &Scope, bool): Result[SubPlan, DbErr]
pub type Up = value record {
    pub eval: EvalFn
    pub typing: lexdb_bind.Typing
    pub planSub: PlanSubFn
}

var UP: once Up

// Sets the hook, once (later calls keep the first).
pub fn hook(f: fn(): Up) { let u = UP.getOrSet(f) }

fn up(): &Up { return UP.get() }

pub const IN_LOOKUP_MAX: int = 1000
pub const JOIN_SEARCH_MAX: int = 24
pub const JOIN_EXACT_MAX: int = 8
pub const JOIN_BEST: int = 10
pub const COST_SCAN: float = 1.0f
pub const COST_SCAN_INNER: float = 44.0f
pub const COST_PK_RANGE: float = 1.8f
pub const COST_DESCENT: float = 12.0f
pub const COST_KEY_ROW: float = 36.0f
pub const COST_IX_ROW: float = 49.0f
// a row of an index range read in key order (optimizer 47.9: 10 to 13 units
// at 3% to 5% of an orders-wide table, 14 to 16 of a narrow one)
pub const COST_SORTED_ROW: float = 12.0f
pub const HASH_PROBE: float = 2.0f
pub const HASH_BUILD: float = 19.0f
pub const ROW_COST: float = 2.0f
pub const EQ_GUESS: float = 0.25f
pub const HASH_MAX_BYTES: float = 67108864.0f
// A range over at least this share of the table was read as a scan, before
// ranges were read in key order (optimizer 47: scanFirst now decides by
// COST_SORTED_ROW; this is KO_NEVER's rule). The plan decides from
// ANALYZE's samples; the counted switch (optimizer 38) is the fallback for
// a range they do not estimate.
pub const SCAN_SHARE: int = 32
// The switch is for tables where reading the index is real work; a small
// table's index-only range is cheap and keeps its order.
pub const SCAN_MIN_ROWS: int = 1024

// A table's way in: its primary key (index -1) or one of its indexes, with
// an equality for each of the first len(eqs) key columns, then perhaps
// bounds on the next one. No equality and no bound is a full scan.
pub type Path = record {
    pub index: int
    pub eqs: []Expr
    pub rng: []Bound
    pub desc: bool          // read backward (ORDER BY ... DESC, MAX)
    pub noNulls: bool       // an index pub path: leave out its next column's NULLs (MIN, MAX)
    pub ins: []Expr         // x IN (...) on the column after the pub equalities: a lookup per value
    pub inSub: int          // or x IN (subquery), pub uncorrelated: a lookup per value it gives; -1 none
    pub inArr: []Expr       // or x = ANY (array): its one expression, a lookup per element (9.28); [] none
    pub stats: bool         // a pure range the planner chose from its samples: the executor need not recount (optimizer 19)
    pub inMax: int          // inSub: the most values looked up one by one; more and the table is read whole (0: IN_LOOKUP_MAX)
    // an index's range (or equality prefix) the cost planner reads in key
    // order where keyOrdered says it may (optimizer 47)
    pub sorted: bool
}

// Whether a table read by path p is read in batches when its scans are
// ranges (pkLen: its primary key's columns; covers: the path's index holds
// every column used, read alone; stops: the reading may stop early; an
// index's batches then start at 32 entries and double, not BROWS): not a
// primary key read backward, IN lists or an array's elements; nor a
// primary key's point unless points (an aggregate's).
pub fn scanBatches(p: &Path, pkLen: int, covers: bool, stops: bool, points: bool): bool {
    if (p.index < 0 && p.desc) || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 { return false }
    return points || !(p.index < 0 && len(p.eqs) > 0 && len(p.eqs) == pkLen)
}

// scanBatches for the first table of a statement's pipeline: the same
// refusals, except that IN lists are read in batches too (a primary key's
// forward one: its points are read together; an index's, or a composite
// key's prefixes', their ranges a chunk of keys at a time) and a primary
// key read backward (the pipeline reads them as it reads a range).
pub fn firstBatches(p: &Path, pkLen: int, covers: bool, stops: bool, points: bool): bool {
    let listed = len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0
    if listed {
        // a primary key's points: forward (read together); its prefixes'
        // ranges and an index's values': either way (a chunk of keys at a time)
        if p.index < 0 && len(p.eqs) + 1 == pkLen { return !p.desc }
        return true
    }
    return points || !(p.index < 0 && len(p.eqs) > 0 && len(p.eqs) == pkLen)
}

// A conjunct "col op value" (or "value op col", turned round).
pub type Bound = record { pub op: str; pub val: Expr }

// kind 0: an implication (c implies p; out 1 yes); 1: a LIMIT or OFFSET (c;
// out its value); 2: an estimate (c a parameter equal to an index's leading
// column of type typ, its common values cm; out the estimate's scale, optimizer 23).
pub type Look = record { pub kind: int; pub c: Expr; pub p: Expr; pub out: int; pub typ: lexdb_sql.TypeName; pub cm: lexdb_stats.Common }

// "column op value", from a comparison of a column with a constant.
pub type Cmp = record { pub col: str; pub op: str; pub val: Val }

pub type EqClass = record { pub names: []str; pub levels: []int; pub konst: []Expr }

// A key column's values among the conjuncts: per value, the levels it uses
// (a bit each; 0 constants and parameters) and its key when it is a literal
// ("" else).
pub type BindCol = record { pub deps: []int; pub keys: []str }

// A way into a level: its primary key (index -1) or an unfiltered index.
pub type WayCand = record { pub index: int; pub tree: int; pub unique: bool; pub cols: []BindCol; pub colIds: []int }

// the levels placed. rows -1: none.
// cost: as the first table (scanned in batches) or per lookup; inner: read
// once as a hashed table (row by row, optimizer 36).
pub type Way = record { pub rows: float; pub cost: float; pub outer: bool; pub inner: float }

// What the statistics say a path reads (optimizer 24): rows, and whether that is an
// estimate or only a bound (at most rows). rows -1: no figure (no
// statistics, or an index ANALYZE has not seen).
pub type Fig = record { pub rows: int; pub bound: bool }

// ---- the physical plan (design/lexdb-layers.md 6.1, step 3)
//
// The operators the executor runs for a planned query, bottom up, each arm
// over its input, in the order today's executor (lexdb_exec's execSel)
// applies them. Slice 3a's cut is a view: lexdb_exec makes it from a
// planned Sel when asked (physOf), holding no expressions and no run-time
// state; the Sel, which the plan cache keeps, holds each operator's details.
// An arm takes its operator's details when step 4 ports it: a plan the
// pipeline runs (lexdb_pipe.compile; slice P1, 6.2.3) has a Scan leaf,
// a Filter, and a Project with outputs or an Agg with its keys and calls,
// their details moved out of the Sel and kept with it (Sel.pipe); the
// arms over an Agg are views, run by the executor over its groups.
pub type PPlan = closed {
    Levels(int, []PSub)             // today's level chain (Query.levels: the tables in join order, each by its path and
                                    // join method; semi and anti levels), its number of levels; its subqueries by number
    Scan(PScan, []PSub)             // one table read by the pipeline; its subqueries
    Join(PPlan, PJoin)              // the rows below joined with one more table (slice P2): its outer input, the join
    Filter(PPlan, []lexdb_bind.BX)  // the conditions a row must meet, bound over the query's columns (moved from Query.cc)
    Result([]PSub)                  // no FROM: one row if the WHERE holds; its subqueries
    Func(str, bool, []PSub)         // a function or VALUES in FROM: its name (Sel.srf), WITH ORDINALITY; its arguments' subqueries
    SetOp(int, bool, int, []PPlan, []PSub)  // lexdb_sql.SET_*, ALL, a recursive CTE's number (-1 none), its parts; the
                                            // set's own subqueries
    MinMax(PPlan)                   // MIN or MAX served by the scan's order: its first value not NULL
    // GROUP BY and the aggregates; true: grouping sets; the keys and calls
    // bound, moved out of the Sel (None in a view, where the Sel holds them)
    Agg(PPlan, bool, Option[PAgg])
    Having(PPlan)
    // the window calls (over the groups when it aggregates); their details
    // for a Window the pipeline runs (Q8 R7; None in a view)
    Window(PPlan, Option[PWin])
    Project(PPlan, []lexdb_bind.BX) // the select list: per output its expression bound over the query's columns (moved
                                    // from Sel.ox; a column as its slot); [] in a view, where the Sel holds them
    // the select list's set-returning values made rows (Q8 R3, PostgreSQL's
    // ProjectSet): its outputs' type OIDs
    ProjectSet(PPlan, []int)
    // true: DISTINCT ON; the outputs' collations' kinds (lexdb_sql.COLL_*), a
    // DISTINCT the pipeline runs (slice P3; [] in a view)
    Distinct(PPlan, bool, []int)
    // ORDER BY: true sorted (a top-N under a LIMIT), false the scan's order;
    // the keys of a sort the pipeline runs (slice P3; None in a view)
    Sort(PPlan, bool, Option[PSort])
    Lock(PPlan)                     // FOR UPDATE and the like
    // LIMIT, OFFSET, FETCH, TOP; true: it stops the scan (no aggregate or
    // sort under it); the count (-1 none: TOP PERCENT, WITH TIES, or an
    // OFFSET alone) and the offset (0 none) when the plan was made (a
    // parameter's: its value then)
    Limit(PPlan, bool, int, int)
    Match(PPlan)                    // MATCH_RECOGNIZE over the query's rows
    // the correlated subqueries left per row (RUN_APPLY), run per row of
    // the joins below at a level's WHERE conjuncts (Q8 R6): its input, the
    // level and the columns the conjuncts read
    Apply(PPlan, PApply)
}

// An Apply (Q8 R6; design/lexdb-layers.md 6.3.Q8 R6): the conjuncts of
// query level `level` that call a correlated subquery run per row (the
// level's last ones, subsLast), evaluated by the caller (lexdb_exec, as
// the row engine evaluates them: their subqueries run per outer row, the
// results kept per outer values) for each row the joins give after that
// level, before the next level's join. reads: the query's columns they
// read.
pub type PApply = record { pub level: int; pub reads: []int }

// A table the pipeline reads (lexdb_pipe's scan). Its table and path stay
// in the query's level (Query.levels: EXPLAIN and the row engine read
// them) until Levels splits into scan and join arms (slice P2).
pub type PScan = record {
    pub level: int          // its level in the query
    pub first: int          // its first column's slot in the query's row
    pub kinds: []int        // per column of the query: its kind in a batch (lexdb_rows.BK_*; BK_NONE another table's)
    pub need: []bool        // per column of the table: decoded (all where the statement's names are not known)
    pub part: bool          // the statement's names known: the columns not needed are not decoded
    // read in batches when its scans are ranges; false: row by row (a
    // primary key's point, a primary key read backward, IN lists, an
    // index's entries' rows where the reading may stop early, an index
    // read alone that its entries cannot give)
    pub batch: bool
    pub stops: bool         // the reading may stop early (a LIMIT): an index's batches start small and double (Cursor.want)
    pub sorted: bool        // its index range read in key order (optimizer 47: keyOrdered)
    // the rows the run holds (item 6 of design/lexdb-batch-gaps.md: a derived
    // table, view, CTE, VALUES, function scan or catalog relation) the level
    // reads, as the subquery in FROM it is: its number; -1 a table. Cut into
    // batches, as a table's rows are (lexdb_held).
    pub held: int
}

// How a join's table is read (PJoin.how).
pub const JH_HASH: int = 0      // once, its rows hashed by its key columns, probed by the outer rows' keys
pub const JH_LOOK: int = 1      // per outer row, by its whole primary key (the keys: its columns' values)
pub const JH_RANGE: int = 2     // per outer row, the range of its path's leading equalities (the keys), then its bounds
pub const JH_ROWS: int = 3      // once, the rows of a subquery (its run's) hashed by its key columns (slice P2b)
// once, a join's rows hashed by its key columns (optimizer 49, a bushy
// plan's build group): its scan the hub's, sub its members' joins over it,
// hcols the query's slots
pub const JH_JOIN: int = 4

// What a join gives (PJoin.mark): the joined rows, or the outer rows
// once each that have a match (semi) or none (anti).
pub const MK_JOIN: int = 0
pub const MK_SEMI: int = 1
pub const MK_ANTI: int = 2
// (optimizer 50) a null-aware anti join, x NOT IN (subquery): the outer
// rows whose IN is false; its hash on (keys, value), a summary per key
pub const MK_NOTIN: int = 3
// a mark join: every outer row once, the level's last column its EXISTS
// (MK_MARK_EX: hash on the keys) or its IN (MK_MARK_IN: on keys, value)
pub const MK_MARK_EX: int = 4
pub const MK_MARK_IN: int = 5

// A table joined to the rows below it (slice P2; design/lexdb-layers.md
// 6.2.3), an inner, LEFT or RIGHT join, or a semi or anti join. Its expressions are bound over the
// query's columns; its keys read only the tables before it.
pub type PJoin = record {
    pub how: int
    pub kind: int               // lexdb_sql.J_INNER (a CROSS JOIN's too), J_LEFT, J_RIGHT or J_FULL (a hash's: its rows that join nothing after the rest)
    pub mark: int               // MK_*
    // a semi or anti join's "inner <> outer" kept as a summary per key (no
    // rows): its column (the table's; -1 none) and the outer value
    pub resCol: int
    pub res: []lexdb_bind.BX
    pub scan: PScan             // its table: level, first slot, kinds, the columns decoded (needs)
    pub build: []lexdb_bind.BX  // JH_HASH: the conditions on its own columns, applied as its rows are read
    pub hcols: []int            // JH_HASH: its key columns (the table's)
    pub keys: []lexdb_bind.BX   // per key column: the value it equals, of the rows below
    // per key column its type (lookups and ranges: the key's; a hash: the
    // column's), the keys made as the row engine makes them (keyVal); a
    // range's bounds' column's type after them
    pub ktypes: []lexdb_sql.TypeName
    pub exact: bool             // JH_HASH: its key columns compared under no collation
    // JH_HASH: per key column the collation it compares under (lexdb_sql.COLL_*;
    // [] none): both sides' keys made its collated values (Q8 R4)
    pub colls: []int
    pub conds: []lexdb_bind.BX  // per candidate row: the join's conditions but those its hash applied
    pub keq: int                // JH_HASH: the one key's equality among conds (-1 none): left out where the hash compares by value
    pub post: []lexdb_bind.BX   // a LEFT JOIN's WHERE conjuncts, after its NULL rows are made
    pub index: int              // JH_RANGE: the path's index (-1 the primary key)
    pub rng: []PBound           // JH_RANGE: its bounds on the column after the equalities (constants of the run)
    pub capNulls: bool          // JH_RANGE: an index's range leaves out its next column's NULLs
    pub noNulls: bool           // JH_RANGE: the path's (Path.noNulls), for a range read in pieces
    // JH_JOIN: its build, a join plan (the members' Join arms, JH_HASH, over
    // Filter? (Scan) of the hub); scan then names the hub's level only
    pub sub: []PPlan
}

// ORDER BY's keys for a Sort the pipeline runs (slice P3). The Project
// under it makes the outputs, then (after shown of them) the keys that are
// not outputs. Per key: the Project's column it reads, DESC, NULLS FIRST,
// and its collation's kind (lexdb_sql.COLL_*).
pub type PSort = record {
    pub shown: int
    pub out: []int
    pub desc: []bool
    pub nf: []bool
    pub coll: []int
    // (Q8 R2) DISTINCT ON: its keys, the first don (0 none); WITH TIES:
    // TS_TOP (TOP n WITH TIES), TS_FETCH (FETCH ... WITH TIES), 0 none; TOP
    // n PERCENT (pct) or TOP n WITH TIES: its n (top, -1 none)
    pub don: int
    pub ties: int
    pub pct: bool
    pub top: int
}

pub const TS_TOP: int = 1
pub const TS_FETCH: int = 2

// A Window the pipeline runs (Q8 R7): the calls (the Sel's, copied; the
// Project over it reads call i's value as #agg i), each one's PARTITION BY
// then ORDER BY expressions, its arguments (lexdb_window.argsOf: an
// aggregate's, then its FILTER) and its frame's start and end offsets,
// bound over the query's columns; and per column of the Project under it
// (its input) the query's column it is.
pub type PWin = record {
    pub wins: []WinPlan
    pub keys: [][]BX
    pub args: [][]BX
    pub offs: [][]Option[BX]
    pub slots: []int
}

// A range's bound: ">", ">=", "<" or "<=" its value.
pub type PBound = record { pub op: str; pub val: lexdb_bind.BX }

// An aggregate the pipeline runs (lexdb_pipe's; slice P1b): per group of
// the keys' values, each call's value. Without keys, one group (the plain
// aggregate); with them, a hash aggregate. The keys, arguments and
// FILTERs are bound over the query's columns.
pub type PAgg = record {
    pub keys: []lexdb_bind.BX
    pub calls: []PCall
    pub keep: []bool        // per column of the query: kept in a group's first row (read after grouping: outputs, HAVING, ORDER BY)
    pub sets: [][]int       // GROUPING SETS, ROLLUP, CUBE: per set the places of its keys (in keys); a group of each set; [] plain
    pub kinds: []int        // per key its collation's kind (lexdb_sql.COLL_*; Q8 R2: a collated key groups by its collated value)
}

// An aggregate call of any function (lexdb_agg's: count (star: count(*)),
// sum, avg, min, max, string_agg, array_agg, bool_and, the variances ...),
// DISTINCT or ORDER BY in the call too; compared as its values are, or by
// its argument's collation (kind, Q8 R2). more: the expressions it reads besides its argument,
// bound like it: string_agg's separator, then its ORDER BY keys (dirs:
// one letter each, as the parser gives them).
pub type PCall = record {
    pub fname: str
    pub star: bool
    pub arg: Option[lexdb_bind.BX]
    pub filter: Option[lexdb_bind.BX]
    pub distinct: bool
    pub more: []lexdb_bind.BX
    pub dirs: str
    pub dia: int            // lexdb_pct.DIA_*: percentile_cont and percentile_disc's dialect
    pub kind: int           // its argument's collation's kind (lexdb_sql.COLL_*: min, max and DISTINCT compare by it)
}

// The columns (of n, the query's) a key-less aggregate's scan decodes:
// those its conditions conds and its calls read. No column is read
// outside a call (42803).
pub fn callsNeed(n: int, conds: &[]lexdb_bind.BX, calls: &[]PCall): []bool {
    var used: []bool = array(n, false)
    for c in conds { uses(&c, mut &used) }
    for c in calls {
        match c.arg {
            Some(x) { uses(&x, mut &used) }
            None {}
        }
        match c.filter {
            Some(x) { uses(&x, mut &used) }
            None {}
        }
        for x in c.more { uses(&x, mut &used) }
    }
    return used
}

// The required columns (design/lexdb-layers.md 6.2.2): each table read
// by plan p decodes only the columns its operators read (its own
// conditions, the joins' keys, conditions and WHERE conjuncts, a hash's
// key columns, the outputs, an aggregate's keys, calls and the columns a
// group keeps), per table instance by its slots (two instances of a
// table, or a "*" elsewhere in the statement, widen nothing). n: the
// query's columns. A table's need is set in its arm (PScan.need, part).
// Above a join only row numbers are carried, so a column is gathered
// once, by the operator that reads it (lexdb_pipe).
pub fn needs(p: PPlan, n: int): PPlan {
    var used: []bool = array(n, false)
    planUses(&p, mut &used)
    return withNeeds(p, &used)
}

// The query's columns a join's arm reads (a build group's: its build's too;
// its key columns are the query's slots).
fn joinUses(j: &PJoin, used: mut &[]bool) {
    for x in j.build { uses(&x, used) }
    for x in j.keys { uses(&x, used) }
    for x in j.conds { uses(&x, used) }
    for x in j.post { uses(&x, used) }
    let at = if j.how == JH_JOIN { 0 } else { j.scan.first }
    for c in j.hcols { if at + c < len(used) { used[at + c] = true } }
    for x in j.res { uses(&x, used) }
    if j.resCol >= 0 && j.scan.first + j.resCol < len(used) { used[j.scan.first + j.resCol] = true }
    for b in j.sub { planUses(&b, used) }
}

fn planUses(p: &PPlan, used: mut &[]bool) {
    match p {
        PPlan.Scan(_, _) {}
        PPlan.Join(i, j) {
            planUses(&i, used)
            joinUses(&j, used)
        }
        PPlan.Filter(i, cs) {
            planUses(&i, used)
            for x in cs { uses(&x, used) }
        }
        PPlan.Agg(i, _, pa) {
            planUses(&i, used)
            match pa {
                Some(a) {
                    for x in a.keys { uses(&x, used) }
                    let none: []lexdb_bind.BX = []
                    let calls = callsNeed(len(used), &none, &a.calls)
                    for c in 0..len(calls) { if calls[c] { used[c] = true } }
                    for c in 0..len(a.keep) { if a.keep[c] && c < len(used) { used[c] = true } }
                }
                None {}
            }
        }
        PPlan.Project(i, xs) {
            planUses(&i, used)
            for x in xs { uses(&x, used) }
        }
        PPlan.Limit(i, _, _, _) { planUses(&i, used) }
        PPlan.Sort(i, _, _) { planUses(&i, used) }
        PPlan.Having(i) { planUses(&i, used) }
        PPlan.Distinct(i, _, _) { planUses(&i, used) }
        PPlan.Match(i) { planUses(&i, used) }
        PPlan.Apply(i, pa) {
            planUses(&i, used)
            for c in pa.reads { if c >= 0 && c < len(used) { used[c] = true } }
        }
        PPlan.Window(i, _) { planUses(&i, used) }
        else {}
    }
}

// p with each of its tables' need set from used (the query's columns read).
fn withNeeds(p: PPlan, used: &[]bool): PPlan {
    match move(p) {
        PPlan.Scan(sc, subs) { return PPlan.Scan(scanNeed(sc, used), subs) }
        PPlan.Join(i, j) {
            var jj = j
            jj.scan = scanNeed(replace(mut &jj.scan, noScan()), used)
            for m in 0..len(jj.sub) { jj.sub[m] = withNeeds(replace(mut &jj.sub[m], PPlan.Result([])), used) }
            return PPlan.Join(withNeeds(i, used), jj)
        }
        PPlan.Filter(i, cs) { return PPlan.Filter(withNeeds(i, used), cs) }
        PPlan.Agg(i, sets, pa) { return PPlan.Agg(withNeeds(i, used), sets, pa) }
        PPlan.Project(i, xs) { return PPlan.Project(withNeeds(i, used), xs) }
        PPlan.Limit(i, stops, n, off) { return PPlan.Limit(withNeeds(i, used), stops, n, off) }
        PPlan.Sort(i, sorted, ps) { return PPlan.Sort(withNeeds(i, used), sorted, ps) }
        PPlan.Having(i) { return PPlan.Having(withNeeds(i, used)) }
        PPlan.Distinct(i, on, ks) { return PPlan.Distinct(withNeeds(i, used), on, ks) }
        PPlan.Match(i) { return PPlan.Match(withNeeds(i, used)) }
        PPlan.Apply(i, pa) { return PPlan.Apply(withNeeds(i, used), pa) }
        PPlan.Levels(n, subs) { return PPlan.Levels(n, subs) }
        PPlan.Result(subs) { return PPlan.Result(subs) }
        PPlan.Func(n, o, subs) { return PPlan.Func(n, o, subs) }
        PPlan.SetOp(k, all, r, parts, subs) { return PPlan.SetOp(k, all, r, parts, subs) }
        PPlan.MinMax(i) { return PPlan.MinMax(i) }
        PPlan.Window(i, pw) { return PPlan.Window(withNeeds(i, used), pw) }
        PPlan.Lock(i) { return PPlan.Lock(i) }
        PPlan.ProjectSet(i, o) { return PPlan.ProjectSet(withNeeds(i, used), o) }
    }
}

fn scanNeed(sc: PScan, used: &[]bool): PScan {
    var s = sc
    for i in 0..len(s.need) { s.need[i] = s.first + i < len(used) && used[s.first + i] }
    s.part = true
    return s
}

pub fn noScan(): PScan { return PScan{level: -1, first: 0, kinds: [], need: [], part: false, batch: false, stops: false, sorted: false, held: -1} }

// The query's columns x reads, set in used.
fn uses(x: &lexdb_bind.BX, used: mut &[]bool) {
    var slots: []int = []
    lexdb_bind.colsRead(x, mut &slots)
    for i in slots { if i >= 0 && i < len(used) { used[i] = true } }
}

// A plan the pipeline runs (lexdb_pipe.compile makes it).
pub type Prog = record {
    pub plan: PPlan      // its operators, their details in their arms
    pub ops: int                    // its operators (run's counts: one each, bottom up)
    // its top is an aggregate (under the caller's views): its groups go to
    // the caller (runAgg), which makes HAVING, the outputs, DISTINCT,
    // ORDER BY and LIMIT of them; else its rows (run)
    pub groups: bool
    pub joins: bool                 // it joins tables (runJ, runAggJ: its tables and their reads per level)
    // its top is a Sort or Distinct (slice P3): the rows are held, then
    // given as one OutBatch (the run holds their bytes in its budget)
    pub sorts: bool
    // how a run starts (PR_*), set once by the planner, not tested per run
    pub run: int
}

pub const PR_PLAIN: int = 0
// a point select's (Q8: lexdb_exec.pipeFetch): no subquery, no join, its
// table read by its whole primary key (pointRead)
pub const PR_POINT: int = 1
// a Result's (no FROM) with an output or condition that does not bind (a
// sequence, session or catalog function's call: lexdb_bind.evalMark), which
// its run's owner evaluates (Q8 R2)
pub const PR_EVAL: int = 2
// a join over a point (Q8 R4: lexdb_exec.pipeFetchJ): no subquery, its
// first table read by its whole primary key, every table after it looked
// up by its whole primary key (lexdb_pipe.pointJoins)
pub const PR_POINTJ: int = 3
// a join under a first table that stops early, every table after it looked
// up by its whole primary key, no subquery (Q8 R4: lexdb_exec.pipeStopJ)
pub const PR_STOPJ: int = 4

// A subquery of a query: what it is (lexdb_sql.SUB_*), how the executor
// runs it (RUN_*), NOT EXISTS's (an anti join) for RUN_SEMI and
// RUN_LOOKED, and its plan.
pub type PSub = record { pub use: int; pub run: int; pub anti: bool; pub plan: PPlan }

pub const RUN_ONCE: int = 0         // no outer values: once per execution, before the query (in FROM: its rows)
pub const RUN_PER_ROW: int = 1      // correlated: per row of the query, its results kept per outer values (an Apply)
pub const RUN_HASHED: int = 2       // correlated, decorrelated (9.9): once, by its keys "inner = outer", probed per row
pub const RUN_SEMI: int = 3         // a semi or anti join's (9.104): once, its rows a level's hash
pub const RUN_LOOKED: int = 4       // not run: its table is a semi or anti level looked up per row (semiLook)
pub const RUN_MARK: int = 5         // a mark join's (optimizer 50): once, its rows a level's hash, every outer row marked
pub const RUN_GROUPED: int = 6      // a grouped level's (optimizer 51): once, grouped by its keys, its rows a level's hash (LEFT joined)
pub const RUN_APPLY: int = 7        // RUN_PER_ROW in a plan the pipeline runs (Q8 R6): its Apply's (or, over groups, the caller's)

// The subqueries of p's query: its leaf's.
pub fn pSubs(p: &PPlan): &[]PSub {
    match p {
        PPlan.Levels(_, s) { return &s }
        PPlan.Scan(_, s) { return &s }
        PPlan.Join(i, _) { return pSubs(&i) }
        PPlan.Filter(i, _) { return pSubs(&i) }
        PPlan.Result(s) { return &s }
        PPlan.Func(_, _, s) { return &s }
        PPlan.SetOp(_, _, _, _, s) { return &s }
        PPlan.MinMax(i) { return pSubs(&i) }
        PPlan.Agg(i, _, _) { return pSubs(&i) }
        PPlan.Having(i) { return pSubs(&i) }
        PPlan.Window(i, _) { return pSubs(&i) }
        PPlan.Project(i, _) { return pSubs(&i) }
        PPlan.Distinct(i, _, _) { return pSubs(&i) }
        PPlan.Sort(i, _, _) { return pSubs(&i) }
        PPlan.Lock(i) { return pSubs(&i) }
        PPlan.Limit(i, _, _, _) { return pSubs(&i) }
        PPlan.Match(i) { return pSubs(&i) }
        PPlan.Apply(i, _) { return pSubs(&i) }
        PPlan.ProjectSet(i, _) { return pSubs(&i) }
    }
}

// p's leaf: its Levels, Scan, Result, Func or SetOp.
pub fn pLeaf(p: &PPlan): &PPlan {
    match p {
        // (the leaves a point select's and a Result's plans reach first: their arms are compared in order)
        PPlan.Scan(_, _) { return p }
        PPlan.Result(_) { return p }
        PPlan.Filter(i, _) { return pLeaf(&i) }
        PPlan.Join(i, _) { return pLeaf(&i) }
        PPlan.MinMax(i) { return pLeaf(&i) }
        PPlan.Agg(i, _, _) { return pLeaf(&i) }
        PPlan.Having(i) { return pLeaf(&i) }
        PPlan.Window(i, _) { return pLeaf(&i) }
        PPlan.Project(i, _) { return pLeaf(&i) }
        PPlan.Distinct(i, _, _) { return pLeaf(&i) }
        PPlan.Sort(i, _, _) { return pLeaf(&i) }
        PPlan.Lock(i) { return pLeaf(&i) }
        PPlan.Limit(i, _, _, _) { return pLeaf(&i) }
        PPlan.Match(i) { return pLeaf(&i) }
        PPlan.Apply(i, _) { return pLeaf(&i) }
        PPlan.ProjectSet(i, _) { return pLeaf(&i) }
        else { return p }
    }
}

// ==== the planner (moved from lexdb_exec: design/lexdb-layers.md 6.3, Q3)

// A column, bare or under a collation's key (#ci(col), #pad(col)): its
// name and the kind; name "" when x is neither.
pub type KeyedCol = value record { pub name: str; pub kind: int }

fn keyedCol(x: &Expr): KeyedCol {
    match x {
        Expr.Col(n, _) { return KeyedCol{name: n.clone(), kind: lexdb_sql.COLL_EXACT} }
        Expr.Call(f, args, _) {
            if (f == "#ci" || f == "#pad") && len(args) == 1 {
                match args[0] {
                    Expr.Col(n, _) { return KeyedCol{name: n.clone(), kind: if f == "#ci" { lexdb_sql.COLL_CI } else { lexdb_sql.COLL_PAD }} }
                    else {}
                }
            }
        }
        else {}
    }
    return KeyedCol{name: "", kind: lexdb_sql.COLL_EXACT}
}

pub fn conjuncts(x: &Expr, out: mut &[]Expr) {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" {
                conjuncts(&a, out)
                conjuncts(&b, out)
                return
            }
        }
        else {}
    }
    append(out, lexdb_sql.cloneExpr(x))
}
// A copy of an expression (Expr is boxed and owned).

// A conjunct "col op value" (or "value op col", turned round).

// A table's way in: its primary key (index -1) or one of its indexes, with
// an equality for each of the first len(eqs) key columns, then perhaps
// bounds on the next one. No equality and no bound is a full scan.

// An IN subquery's values looked up one by one at most; past this many its
// path reads the whole table instead (no row counts to choose by yet).

// The encoded index part of a constant equality value: a literal, or one of
// the statement's parameters, coerced to the column's type. "" when it is
// neither (a value from another table, an outer value), NULL, or not of the type.
fn constKey(x: &Expr, typ: &lexdb_sql.TypeName, params: &[]Val): str {
    var v = Val.Null
    match x {
        Expr.Lit(l) { v = l.clone() }
        Expr.Param(n) {
            if n < 1 || n > len(params) { return "" }
            v = params[n - 1].clone()
        }
        else {
            // a literal expression (a cast: date '2021-06-01'), worked out
            match litValue(x) {
                Some(l) { v = l }
                None { return "" }
            }
        }
    }
    if lexdb_ops.isNull(&v) { return "" }
    match lexdb_ops.coerce(v, &boundType(typ)) {
        Ok(cv) {
            var b = ""
            lexdb_access.encIdxPart(mut &b, &cv)
            return b
        }
        Err(_) { return "" }
    }
}

// An estimate's scale: the looks compare scales, so values whose estimates
// are within about a factor of two share a plan.
fn scaleOf(n: int): int {
    var s = 0
    var x = n + 1
    while x > 1 {
        x = x / 2
        s += 1
    }
    return s
}

// An index's (or the primary key's, by the table's tree) entries; -1 none.

// What the statistics say a path reads (optimizer 24): rows, and whether that is an
// estimate or only a bound (at most rows). rows -1: no figure (no
// statistics, or an index ANALYZE has not seen).

// A path's figure: its equalities' rows by the statistics, the first by its
// value when it is constant; an IN list a lookup per value; a range, an IN
// subquery or an array only bounded by the rows of its equalities (no range
// estimates without samples). The primary key of one column has no
// statistics of its own: the table's rows bound it.
fn pathFig(lv: &Level, p: &Path, params: &[]Val): Fig {
    let none = Fig{rows: -1, bound: false}
    if lv.est.rows < 0 { return none }
    let c = p.index
    let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
    let cols = keyCols(&lv.t, c)
    let unique = c < 0 || lv.t.indexes[c].unique
    var pre = lv.est.entriesOf(tree)
    if pre < 0 {
        if c >= 0 || len(cols) > 1 { return none }
        pre = lv.est.rows
    }
    let ne = len(p.eqs)
    if ne > 0 {
        if ne == len(cols) && unique {
            pre = 1
        } else {
            let key = constKey(&p.eqs[0], &keyType(&lv.t, c, 0), params)
            pre = lv.est.rowsFor(tree, ne, &key)
            if pre < 0 { return none }
        }
    }
    if len(p.ins) > 0 {
        // a lookup per value: a literal's own rows when it is on the leading
        // column, else the average of the next prefix
        var n = 0
        let noParams: []Val = []
        for x in p.ins {
            var per = -1
            if ne + 1 == len(cols) && unique {
                per = 1
            } else {
                let key = if ne == 0 { constKey(&x, &keyType(&lv.t, c, 0), &noParams) } else { "" }
                per = lv.est.rowsFor(tree, ne + 1, &key)
            }
            if per < 0 { return Fig{rows: pre, bound: true} }
            n += per
        }
        if n < pre { return Fig{rows: n, bound: false} }
        return Fig{rows: pre, bound: true}
    }
    if ne == 0 && len(p.rng) > 0 && len(cols) > 0 && cols[0] >= 0 {
        // a range of the leading column: by its samples, when its bounds are
        // literals (optimizer 37); else only bounded
        let e = q0LeadEntry(lv, cols[0])
        if e >= 0 && len(lv.est.samp[e]) > 0 {
            var ops: []str = []
            var vals: []Expr = []
            for b in p.rng {
                if b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" {
                    append(mut &ops, b.op.clone())
                    append(mut &vals, lexdb_sql.cloneExpr(&b.val))
                }
            }
            if len(ops) == len(p.rng) {
                let sh = sampOnly(lv, e, cols[0], &ops, &vals)
                if sh >= 0.0f { return Fig{rows: int(fmax(sh * float(lv.est.entries[e]), 1.0f)), bound: false} }
            }
        }
    }
    if p.inSub >= 0 || len(p.inArr) > 0 || len(p.rng) > 0 { return Fig{rows: pre, bound: true} }
    return Fig{rows: pre, bound: false}
}

// leadEntry for a level outside a Query (pathFig's).
fn q0LeadEntry(lv: &Level, col: int): int {
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        if len(cols) == 0 || cols[0] != col { continue }
        let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
        for j in 0..len(lv.est.trees) { if lv.est.trees[j] == tree { return j } }
    }
    return -1
}

// A range's share by entry e's samples alone (literal bounds); -1 none.
fn sampOnly(lv: &Level, e: int, col: int, ops: &[]str, vals: &[]Expr): float {
    let typ = boundType(&lv.t.cols[col].typ)
    let noParams: []Val = []
    var hasLo = false
    var hasHi = false
    var loKey = ""
    var hiKey = ""
    var loIncl = false
    var hiIncl = false
    var loNum = 0.0f
    var hiNum = 0.0f
    var nums = true
    for i in 0..len(ops) {
        let key = constKey(&vals[i], &typ, &noParams)
        if len(key) == 0 { return -1.0f }
        let xn = litNumOf(lv, col, &vals[i])
        if xn.isNone() { nums = false }
        let x = xn.unwrapOr(0.0f)
        if ops[i] == ">" || ops[i] == ">=" {
            if !hasLo || key > loKey || (key == loKey && ops[i] == ">") {
                loKey = key
                loIncl = ops[i] == ">="
                loNum = x
            }
            hasLo = true
        } else {
            if !hasHi || key < hiKey || (key == hiKey && ops[i] == "<") {
                hiKey = key
                hiIncl = ops[i] == "<="
                hiNum = x
            }
            hasHi = true
        }
    }
    return lv.est.sampShare(e, hasLo, &loKey, loNum, loIncl, hasHi, &hiKey, hiNum, hiIncl, nums)
}

// A path's figure for EXPLAIN: none for a whole-key lookup (one row, by the
// rules) or a path with no condition.
pub fn pathEst(lv: &Level, p: &Path, params: &[]Val): Fig {
    let none = Fig{rows: -1, bound: false}
    let cols = keyCols(&lv.t, p.index)
    let unique = p.index < 0 || lv.t.indexes[p.index].unique
    if len(p.eqs) == len(cols) && unique { return none }
    if len(p.eqs) == 0 && len(p.rng) == 0 && len(p.ins) == 0 && p.inSub < 0 && len(p.inArr) == 0 { return none }
    return pathFig(lv, p, params)
}

// A figure's cost in reads (section 15's model): a primary key row is one
// read, an index entry two (the entry, then its row).
// (optimizer 36: in tenths of the measured units of COST_*: a descent 12,
// a row through an index 45, a primary key range's row 1.7 as the first
// table, 12 after it)
fn figCost(f: &Fig, index: int, first: bool): int {
    return 120 + f.rows * (if index >= 0 { 450 } else if first { 17 } else { 120 })
}

// One table of a query, in FROM order. Its rows join the rows of the tables
// before it: looked up per row through its path when the path's values come
// from them (a nested loop over a key or an index), else read once and
// matched by a hash of the equalities that link it to them (none: every
// row, a cross product).
pub type Level = record {
    pub t: rc Table             // shared with the cache of tables decoded (unshare to change)
    pub alias: str
    pub join: int
    pub first: int              // its first column in the joined row
    pub path: Path
    pub cond: []Expr            // the conjuncts a row of it must satisfy to join
    pub post: []Expr            // a LEFT JOIN's WHERE conjuncts, checked after its NULL row is made
    pub local: []Expr           // the match conjuncts on its own columns only (hash: read once)
    pub perRow: bool
    pub hashCols: []int         // hash: its columns ...
    pub hashVals: []Expr        // ... equal to these values from earlier tables
    pub hashKinds: []int        // ... per column, the collation its key is under (L2: #ci(col) = x)
    pub hashInt: bool           // a semi-join's one integer key: its own map, by value
    pub src: int                // a subquery in FROM (or a CTE): its number, its rows read from the run; -1 a table
    pub work: int               // a recursive CTE's working table: the CTE's number; -1
    pub lateral: bool           // a subquery in FROM using outer values (LATERAL): run per row
    pub gen: bool               // its table has a virtual column (lexdb_gen): computed where it is read
    pub need: []bool            // a table's columns the statement uses (the others are read as NULL); [] all (9.31)
    pub lock: int               // SELECT ... FOR UPDATE and the like: its rows locked (lexdb_sql.LOCK_*, 9.86); 0 none
    pub lockWait: int           // lexdb_sql.WAIT_*
    pub keeps: bool             // the path is chosen for ORDER BY or MIN/MAX: no switch to a scan (optimizer 19)
    pub est: Est                // its table's statistics from ANALYZE, for choosePath (optimizer 20)
    pub stops: bool             // the first table's reading may stop early (a LIMIT, EXISTS): no switch to a scan (optimizer 19)
    pub estRows: int            // its path's expected rows (EXPLAIN); -1 unknown (optimizer 23)
    pub estMax: bool            // estRows only bounds them: at most (optimizer 24)
    pub readOnce: bool          // the join order read it once (a hash join), not per row of the tables before (optimizer 26)
    pub semi: bool              // a semi-join (9.104): subquery src's rows, hashed; a row of the tables before goes on once if any matches
    pub anti: bool              // a NOT EXISTS/IN's: the row goes on once if none matches
    pub resNot: bool            // a semi/anti filter "inner <> outer": per key, mixed or one value (resCol)
    pub resCol: int             // the filter's inner column in t.cols
    pub resVal: Expr            // ... and its outer value
    pub semiSub: int            // a semi/anti join of a table looked up per row of the tables before it (semiLook): its subquery's number (EXPLAIN); -1
    // a build group's hub (optimizer 49): the levels after it hashed with
    // it as one join (its members); 0 none
    pub grp: int
    // a subquery's level of optimizer 50 (LV_*): a null-aware anti join or
    // a mark join (its last column the mark); 0 neither
    pub mode: int
    // the OR of index paths its rows are read by (optimizer 52: one per
    // branch of an OR conjunct; their rows' primary keys collected,
    // deduplicated and read in key order) where orRead says so; [] none
    pub ors: []Path
}

pub const LV_NOTIN: int = 1
pub const LV_MARK: int = 2

// A grouped level's (optimizer 51): a scalar aggregate's rows by its keys,
// LEFT joined.
pub fn grouped(lv: &Level): bool { return lv.src >= 0 && strings.startsWith(&lv.alias, "\x00sg") }

// EXPLAIN's name of level lv: a grouped level's subquery's.
pub fn levelName(lv: &Level): str {
    if grouped(lv) { return "subquery " + (lv.src + 1).toStr() }
    let tn = lexdb_sql.baseName(&lv.t.name)
    return if lv.alias == tn { tn } else { tn + " " + lv.alias }
}

// A level of rows held by the run (a subquery's, a working table), not a table's.
pub fn (lv: &Level) virt(): bool { return lv.src >= 0 || lv.work >= 0 }

pub fn keepsRight(join: int): bool { return join == lexdb_sql.J_RIGHT || join == lexdb_sql.J_FULL }

pub fn keepsLeft(join: int): bool { return join == lexdb_sql.J_LEFT || join == lexdb_sql.J_FULL }

fn isOuter(join: int): bool { return keepsLeft(join) || keepsRight(join) }

pub type Query = record {
    pub levels: []Level
    pub cols: []lexdb_sql.ColDef    // the joined row's columns, named alias.column
    pub top: []Expr                 // no FROM: the WHERE
    pub subs: []SubPlan             // its subqueries, by number
    pub base: int                   // the statement's parameters; then refs' values
    pub corr: bool                  // a subquery of it is correlated
    pub refs: []Expr                // a subquery: the outer values it uses (in the outer query's terms)
    pub implied: bool               // its implied equalities were added (optimizer 27): a constant's equality is taken first
    pub colAt: Map[str, int]        // cols by name, once its tables are read (levelOf's; a name missing: colIndex)
    pub pinned: bool                // its join starts from a pinned row (optimizer 35): an outer value's equality is taken first
    pub noRefKeys: bool             // its outer values (refs) are not a path's or a hash's keys (Scope.noRefKeys, 9.104)
    // per level, its conditions and the WHERE conjuncts after it bound once
    // for the plan (bindSel; parameters as slots); [] bound per run (prepare)
    pub cc: [][]Option[lexdb_bind.BX]
    pub cp: [][]Option[lexdb_bind.BX]
    pub lp: lexdb_bind.LPlan        // FROM and WHERE as the binder gives them (buildQuery; planSelect moves it into Sel.lp)
    // its joins as the pipeline runs them for the row engine (slice P2c:
    // lexdb_pipe.compileLevels), where its Sel's own plan is not the
    // pipeline's; None: the row engine joins
    pub jp: Option[Prog]
}

// Column c added to q's joined row, at the next slot. (Its binder's
// column, a BCol, is in q.lp's Get or Sub: buildQuery.)
pub fn addCol(q: mut &Query, c: lexdb_sql.ColDef) {
    append(mut &q.cols, c)
}

pub fn hasIdx(xs: &[]int, x: int): bool {
    for y in xs { if y == x { return true } }
    return false
}

fn (q: &Query) valBefore(x: &Expr, k: int): bool { return q.maxLevel(x) < k && !(q.corr && hasCorr(x)) && !(q.noRefKeys && usesRefs(x, q.base)) }

// A path's key value for level k: it uses only the tables before k. A
// correlated subquery in it is run per row of them before k is read
// (runLevel: pathCur), so it may be one too (9.23).
fn (q: &Query) keyBefore(x: &Expr, k: int): bool { return q.maxLevel(x) < k && !(q.noRefKeys && usesRefs(x, q.base)) }

// The level whose columns hold name's (-1 none). Levels hold their columns
// where FROM put them, whatever order they run in (join order, optimizer 25).
// Column name's slot in q's joined row (-1: none).
pub fn (q: &Query) slotOf(name: &str): int {
    let i = q.colAt.getOr(name, -1)
    return if i >= 0 { i } else { lexdb_bind.colIndex(&q.cols, name) }
}

pub fn (q: &Query) levelOf(name: &str): int {
    let i = q.slotOf(name)
    if i < 0 { return -1 }
    for j in 0..len(q.levels) {
        let f = q.levels[j].first
        if f <= i && i < f + len(q.levels[j].t.cols) { return j }
    }
    return -1
}

// The latest table an expression uses (-1: none) and the earliest (len: none).
fn (q: &Query) maxLevel(x: &Expr): int {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    var m = -1
    for n in ns {
        let l = q.levelOf(&n)
        if l > m { m = l }
    }
    return m
}

pub fn (q: &Query) minLevel(x: &Expr): int {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    var m = len(q.levels)
    for n in ns {
        let l = q.levelOf(&n)
        if l < m { m = l }
    }
    return m
}

// The conjuncts "col op value" whose value uses only tables before level k.
fn bounds(cs: &[]Expr, col: &str, k: int, q: &Query): []Bound {
    var out: []Bound = []
    for c in cs { likeBounds(&c, col, q, mut &out) }
    for c in cs {
        match c {
            Expr.Bin(op, a, b) {
                if op == "=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                    var done = false
                    match a {
                        Expr.Col(n, _) {
                            if n == col && q.keyBefore(&b, k) {
                                append(mut &out, Bound{op: op.clone(), val: lexdb_sql.cloneExpr(&b)})
                                done = true
                            }
                        }
                        else {}
                    }
                    if !done {
                        match b {
                            Expr.Col(n, _) {
                                if n == col && q.keyBefore(&a, k) {
                                    let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { "=" } }
                                    append(mut &out, Bound{op: flip, val: lexdb_sql.cloneExpr(&a)})
                                }
                            }
                            else {}
                        }
                    }
                }
            }
            else {}
        }
    }
    return out
}

// An index expression with its columns named as a query names them
// (alias.column).
fn qualified(x: &Expr, alias: &str): Expr {
    match x {
        Expr.Col(n, _) { return Expr.Col(alias + "." + n, -1) }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), qualified(&a, alias)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), qualified(&a, alias), qualified(&b, alias)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(qualified(&a, alias), neg) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, qualified(&a, alias)) }
            return Expr.Call(n.clone(), out, star)
        }
        Expr.Cast(a, t) { return Expr.Cast(qualified(&a, alias), t) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// Whether two expressions are the same.
fn sameExpr(a: &Expr, b: &Expr): bool { return lexdb_sql.exprText(a) == lexdb_sql.exprText(b) }

// bounds for an index expression (9.89): conjuncts comparing target with a
// value known before level k.
fn exprBounds(cs: &[]Expr, target: &Expr, k: int, q: &Query): []Bound {
    var out: []Bound = []
    for c in cs {
        match c {
            Expr.Bin(op, a, b) {
                if op == "=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                    if sameExpr(&a, target) && q.keyBefore(&b, k) {
                        append(mut &out, Bound{op: op.clone(), val: lexdb_sql.cloneExpr(&b)})
                    } else if sameExpr(&b, target) && q.keyBefore(&a, k) {
                        let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { "=" } }
                        append(mut &out, Bound{op: flip, val: lexdb_sql.cloneExpr(&a)})
                    }
                }
            }
            else {}
        }
    }
    return out
}

// ---- filtered indexes: when a query's conditions imply the predicate

// The value of an expression without columns, if it has one now (NULL: none).
fn constVal(x: &Expr, params: &[]Val): Option[Val] {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    if len(ns) > 0 || lexdb_bind.hasAgg(x) { return None }
    match up().eval(x, params) {
        Ok(v) {
            if lexdb_ops.isNull(&v) { return None }
            return Some(v)
        }
        Err(_) { return None }
    }
}

// "column op value", from a comparison of a column with a constant.

fn asCmp(x: &Expr, params: &[]Val): Option[Cmp] {
    match x {
        Expr.Bin(op, a, b) {
            if !lexdb_bind.isCmp(&op) { return None }
            match a {
                Expr.Col(n, _) {
                    match constVal(&b, params) {
                        Some(v) { return Some(Cmp{col: n.clone(), op: op.clone(), val: v}) }
                        None {}
                    }
                }
                else {}
            }
            match b {
                Expr.Col(n, _) {
                    match constVal(&a, params) {
                        Some(v) {
                            let flip = match op { "<" { ">" } "<=" { ">=" } ">" { "<" } ">=" { "<=" } else { op.clone() } }
                            return Some(Cmp{col: n.clone(), op: flip, val: v})
                        }
                        None {}
                    }
                }
                else {}
            }
        }
        else {}
    }
    return None
}

fn holds(op: &str, d: int): bool {
    return match op {
        "=" { d == 0 }
        "<>" { d != 0 }
        "<" { d < 0 }
        "<=" { d <= 0 }
        ">" { d > 0 }
        else { d >= 0 }
    }
}

fn mentions(x: &Expr, col: &str): bool {
    match x {
        Expr.Col(n, _) { return n == col }
        else { return false }
    }
}

// Whether a query's conjunct c implies a predicate's conjunct p: the same
// text; a comparison of a column for "column IS NOT NULL"; or comparisons
// of a column with constants (x >= 3 implies x > 0).
//
// Planning that looks at a parameter's value (optimizer 22): whether a partial
// index's predicate is implied for it (yes or no), and a LIMIT or OFFSET (its
// value, which the plan keeps). Each look is noted in the planning's scope
// (Scope.looks) with what it gave; select() keeps the plan with them and takes
// it again only for parameters that give the same (looksHold). So a statement
// keeps a plan per outcome, at most PLAN_VARIANTS.
// kind 0: an implication (c implies p; out 1 yes); 1: a LIMIT or OFFSET (c;
// out its value); 2: an estimate (c a parameter equal to an index's leading
// column of type typ, its common values cm; out the estimate's scale, optimizer 23).

fn noType(): lexdb_sql.TypeName { return lexdb_sql.TypeName{kind: 0, oid: 0, prec: 0, scale: 0, len: 0} }

fn impliesOne(c: &Expr, p: &Expr, params: &[]Val, lk: mut &[]Look): bool {
    let r = impliesRaw(c, p, params)
    if len(params) > 0 { append(lk, Look{kind: 0, c: lexdb_sql.cloneExpr(c), p: lexdb_sql.cloneExpr(p), out: if r { 1 } else { 0 }, typ: noType(), cm: lexdb_stats.noCommon()}) }
    return r
}

// Whether the parameters give what the plan's looks gave.
pub fn looksHold(ls: &[]Look, params: &[]Val): bool {
    for l in ls {
        if l.kind == 0 {
            if impliesRaw(&l.c, &l.p, params) != (l.out == 1) { return false }
        } else if l.kind == 2 {
            if scaleOf(lexdb_stats.rowsOf(&l.cm, &constKey(&l.c, &l.typ, params))) != l.out { return false }
        } else {
            let x = Some(lexdb_sql.cloneExpr(&l.c))
            var none: []Look = []
            match evalInt(&x, params, "LIMIT", mut &none) {
                Ok(n) { if n != l.out { return false } }
                Err(_) { return false }
            }
        }
    }
    return true
}

fn impliesRaw(c: &Expr, p: &Expr, params: &[]Val): bool {
    if lexdb_sql.exprText(c) == lexdb_sql.exprText(p) { return true }
    match p {
        Expr.IsNull(a, neg) {
            if !neg { return false }
            match a {
                Expr.Col(n, _) {
                    match c {
                        Expr.Bin(op, l, r) { return lexdb_bind.isCmp(&op) && (mentions(&l, &n) || mentions(&r, &n)) }
                        else { return false }
                    }
                }
                else { return false }
            }
        }
        else {}
    }
    match asCmp(p, params) {
        Some(pc) {
            match asCmp(c, params) {
                Some(cc) {
                    if cc.col != pc.col { return false }
                    let d = match lexdb_ops.compare(&cc.val, &pc.val) { Ok(x) { x } Err(_) { return false } }
                    let po = pc.op.clone()
                    match cc.op {
                        "=" { return holds(&po, d) }
                        ">" { return (po == ">" || po == ">=" || po == "<>") && d >= 0 }
                        ">=" { return ((po == ">" || po == "<>") && d > 0) || (po == ">=" && d >= 0) }
                        "<" { return (po == "<" || po == "<=" || po == "<>") && d <= 0 }
                        "<=" { return ((po == "<" || po == "<>") && d < 0) || (po == "<=" && d <= 0) }
                        else { return po == "<>" && d == 0 }
                    }
                }
                None { return false }
            }
        }
        None { return false }
    }
}

// A predicate's column names, as alias.column.
fn qualify(x: &Expr, alias: &str): Expr {
    match x {
        Expr.Col(n, _) { return Expr.Col(alias + "." + n, -1) }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), qualify(&a, alias)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), qualify(&a, alias), qualify(&b, alias)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(qualify(&a, alias), neg) }
        Expr.Cast(a, t) { return Expr.Cast(qualify(&a, alias), t) }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, qualify(&a, alias)) }
            return Expr.Call(n.clone(), out, star)
        }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// Whether index c of level k may be used under conditions cs: it is not
// filtered, or they imply each conjunct of its predicate.
fn (q: &Query) usable(k: int, c: int, cs: &[]Expr, params: &[]Val, lk: mut &[]Look): bool {
    if c < 0 { return true }
    let lv = &q.levels[k]
    match lv.t.indexes[c].pred {
        Some(pr) {
            var ps: []Expr = []
            conjuncts(&qualify(&pr, &lv.alias), mut &ps)
            for pc in ps {
                var ok = false
                for cc in cs { if impliesOne(&cc, &pc, params, lk) { ok = true } }
                if !ok { return false }
            }
            return true
        }
        None { return true }
    }
}

// The values of a conjunct "col IN (...)" whose values use only tables
// before level k (none: no such conjunct).
fn inList(cs: &[]Expr, col: &str, k: int, q: &Query): []Expr {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "in" && len(args) > 1 {
                    var ok = false
                    match args[0] { Expr.Col(x, _) { ok = x == col } else {} }
                    for i in 1..len(args) { if !q.keyBefore(&args[i], k) { ok = false } }
                    if ok {
                        var out: []Expr = []
                        for i in 1..len(args) { append(mut &out, lexdb_sql.cloneExpr(&args[i])) }
                        return out
                    }
                }
            }
            else {}
        }
    }
    return []
}

// col = ANY (array), the array from the tables before level k: [it], else [].
fn anyOf(cs: &[]Expr, col: &str, k: int, q: &Query): []Expr {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "any =" && len(args) == 2 && q.keyBefore(&args[1], k) {
                    match args[0] { Expr.Col(x, _) { if x == col { return [lexdb_sql.cloneExpr(&args[1])] } } else {} }
                }
            }
            else {}
        }
    }
    return []
}

// Whether one of cs is x IN (subquery), the subquery uncorrelated.
fn hasInSub(cs: &[]Expr): bool {
    for c in cs {
        match c {
            Expr.Call(n, args, _) { if n == "#in" && len(args) == lexdb_bind.subFixed(&n) { return true } }
            else {}
        }
    }
    return false
}

// col IN (subquery), the subquery uncorrelated (run once, before the
// tables are read): its number, else -1.
fn inSubOf(cs: &[]Expr, col: &str): int {
    for c in cs {
        match c {
            Expr.Call(n, args, _) {
                if n == "#in" && len(args) == lexdb_bind.subFixed(&n) {
                    match args[3] { Expr.Col(x, _) { if x == col { return lexdb_sql.litInt(&args[0]) } } else {} }
                }
            }
            else {}
        }
    }
    return -1
}

// LIKE 'abc%' on a text column: the strings from 'abc' to 'abd'.
fn likeBounds(c: &Expr, col: &str, q: &Query, out: mut &[]Bound) {
    match c {
        Expr.Call(n, args, _) {
            if n != "like" || len(args) != 2 { return }
            match args[0] {
                Expr.Col(x, _) { if x != col { return } }
                else { return }
            }
            let ci = lexdb_bind.colIndex(&q.cols, col)
            if ci < 0 || q.cols[ci].typ.kind != lexdb_sql.K_TEXT { return }
            match args[1] {
                Expr.Lit(v) {
                    match v {
                        Val.Text(pat) {
                            // the characters before the first wildcard; \ escapes
                            var pre = ""
                            var i = 0
                            while i < len(pat) {
                                let b = pat[i]
                                if b == '%' || b == '_' { break }
                                if b == '\\' {
                                    if i + 1 >= len(pat) { return }
                                    i += 1
                                }
                                pre.addByte(pat[i])
                                i += 1
                            }
                            let p = pre
                            if len(p) == 0 { return }
                            append(out, Bound{op: ">=", val: Expr.Lit(Val.Text(p.clone()))})
                            let next = lexdb_access.succ(&p)
                            if next != "" { append(out, Bound{op: "<", val: Expr.Lit(Val.Text(next))}) }
                        }
                        else {}
                    }
                }
                else {}
            }
        }
        else {}
    }
}

pub fn keyCols(t: &Table, index: int): []int {
    var out: []int = []
    if index < 0 {
        for i in t.pk { append(mut &out, i) }
    } else {
        for i in t.indexes[index].cols { append(mut &out, i) }
    }
    return out
}

// ---- join order (optimizer 25): the constraint-bound order, no statistics. A
// SELECT's inner joins run from the first table (in FROM order) that a
// unique key's equalities pin to one row, their values constants or
// parameters; then, each time, the first table left that a unique key binds
// to the tables placed (a row per row at most), else the first that a key's
// or an index's leading column reaches from them (a lookup per row), else
// the first an equality links to them (a hash join), else the first left (a
// cross product). So most OLTP joins (one order, its lines, their products)
// read from the row they are about, whatever FROM's order, and the order
// never depends on the data. Outer joins and LATERAL keep FROM's order, and
// so does SET lexdb_planner = rules. The tables keep their columns' places
// in the joined row (Level.first): only the order they run in changes.

// ---- equal columns (optimizer 27): an inner join's equalities make
// classes of columns equal to each other, and perhaps to a constant (a
// literal or a parameter). Columns of one class are joined only when their
// types are of one kind, so that a comparison means the same whichever two
// are compared. The implied equalities (a = b and b = c: a = c; a = 5 and
// a = b: b = 5) are added to the conjuncts, so that a table is reached
// straight from any other of its class, or by the constant. They hold
// whenever the written ones do (a row where a = b and b = c are true has
// a = c true), so the results are the same.

pub fn (q: &Query) colKind(name: &str): int {
    let i = lexdb_bind.colIndex(&q.cols, name)
    return if i < 0 { -1 } else { q.cols[i].typ.kind }
}

// A constant for the classes: a literal (not NULL) or a parameter.
fn eqConst(x: &Expr): bool {
    match x {
        Expr.Lit(v) { return !lexdb_ops.isNull(&v) }
        else { return lexdb_bind.refParam(x) }
    }
}

fn (q: &Query) eqClasses(cs: &[]Expr): []EqClass {
    var names: []str = []
    var parent: []int = []
    var konstOf: []int = []             // per constant conjunct: the name's index
    var konsts: []Expr = []
    for c in cs {
        match c {
            Expr.Bin(op, l, r) {
                if op != "=" { continue }
                var a = ""
                var b = ""
                match l { Expr.Col(n, _) { a = n.clone() } else {} }
                match r { Expr.Col(n, _) { b = n.clone() } else {} }
                if len(a) > 0 && len(b) > 0 {
                    if q.levelOf(&a) < 0 || q.levelOf(&b) < 0 || q.colKind(&a) != q.colKind(&b) { continue }
                    let i = nameIdx(mut &names, mut &parent, &a)
                    let j = nameIdx(mut &names, mut &parent, &b)
                    let ri = ufRoot(&parent, i)
                    let rj = ufRoot(&parent, j)
                    if ri != rj { parent[rj] = ri }
                } else if len(a) > 0 && eqConst(&r) && q.levelOf(&a) >= 0 {
                    append(mut &konstOf, nameIdx(mut &names, mut &parent, &a))
                    append(mut &konsts, lexdb_sql.cloneExpr(&r))
                } else if len(b) > 0 && eqConst(&l) && q.levelOf(&b) >= 0 {
                    append(mut &konstOf, nameIdx(mut &names, mut &parent, &b))
                    append(mut &konsts, lexdb_sql.cloneExpr(&l))
                }
            }
            else {}
        }
    }
    var roots: []int = []
    var out: []EqClass = []
    for i in 0..len(names) {
        let r = ufRoot(&parent, i)
        var at = -1
        for j in 0..len(roots) { if roots[j] == r { at = j } }
        if at < 0 {
            append(mut &roots, r)
            append(mut &out, EqClass{names: [], levels: [], konst: []})
            at = len(out) - 1
        }
        append(mut &out[at].names, names[i].toStr())
        append(mut &out[at].levels, q.levelOf(&names[i]))
    }
    for i in 0..len(konstOf) {
        let r = ufRoot(&parent, konstOf[i])
        for j in 0..len(roots) { if roots[j] == r && len(out[j].konst) == 0 { append(mut &out[j].konst, lexdb_sql.cloneExpr(&konsts[i])) } }
    }
    return out
}

fn nameIdx(names: mut &[]str, parent: mut &[]int, n: &str): int {
    for i in 0..len(names) { if names[i] == n { return i } }
    append(names, n.toStr())
    append(parent, len(parent))
    return len(names) - 1
}

fn ufRoot(parent: &[]int, i: int): int {
    var x = i
    while parent[x] != x { x = parent[x] }
    return x
}

// One equality per class into each table (ms: the conjuncts per level, the
// implied ones added): of a class's equalities between a column of level k
// and a column of an earlier level, the first is kept and one whose earlier
// column is another level's is left out, since the two earlier columns
// were made equal at the later of their levels (implied adds every pair of
// levels a class joins). PostgreSQL makes one clause per equivalence class
// for each join (equivclass.c, generate_join_implied_equalities). TPC-H
// q5 hashed supplier on (s_suppkey, s_nationkey, s_nationkey): c_nationkey
// = s_nationkey and n_nationkey = s_nationkey; one key of each is enough,
// and a hash of one integer key has its own map. Two columns of the same
// earlier level both stay: nothing need have made them equal. Only an
// equality whose two columns are in the class, and of one integer type or
// both dates (plainEqCols), is left out or stands for another: the classes
// leave out equalities across types (int = numeric), which no other
// equality implies.
fn (q: &Query) oneEqPerClass(ms: mut &[][]Expr) {
    var all: []Expr = []
    for m in ms { for c in m { append(mut &all, lexdb_sql.cloneExpr(&c)) } }
    let cls = q.eqClasses(&all)
    for k in 1..len(ms) {
        var keep: []Expr = []
        var kc: []int = []          // per equality kept: its class, its earlier level
        var kl: []int = []
        let xs = replace(mut &ms[k], [])
        // a build group's member (optimizer 49): its equalities with the
        // group's levels first (its key in the build), then the others
        let g = if k < len(q.levels) { grpOf(q, k) } else { -1 }
        var drops: []bool = array(len(xs), false)
        for pass in 0..(if g >= 0 && g < k { 2 } else { 1 }) {
        for xi in 0..len(xs) {
            let c = &xs[xi]
            var drop = false
            match c {
                Expr.Bin(op, l, r) {
                    if op == "=" {
                        match l {
                            Expr.Col(a, _) {
                                match r {
                                    Expr.Col(b, _) {
                                        let la = q.levelOf(&a)
                                        let lb = q.levelOf(&b)
                                        let lo = if la == k { lb } else { la }
                                        let first = !(g >= 0 && g < k) || (lo >= g) == (pass == 0)
                                        if first && la >= 0 && lb >= 0 && (la == k) != (lb == k) && la <= k && lb <= k && q.plainEqCols(&a, &b) {
                                            var ci = -1
                                            for x in 0..len(cls) {
                                                var hasA = false
                                                var hasB = false
                                                for n in cls[x].names {
                                                    if n == &a { hasA = true }
                                                    if n == &b { hasB = true }
                                                }
                                                if hasA && hasB { ci = x }
                                            }
                                            if ci >= 0 {
                                                for i in 0..len(kc) { if kc[i] == ci && kl[i] != lo { drop = true } }
                                                if !drop {
                                                    append(mut &kc, ci)
                                                    append(mut &kl, lo)
                                                }
                                            }
                                        }
                                    }
                                    else {}
                                }
                            }
                            else {}
                        }
                    }
                }
                else {}
            }
            if drop { drops[xi] = true }
        }
        }
        for xi in 0..len(xs) { if !drops[xi] { append(mut &keep, lexdb_sql.cloneExpr(&xs[xi])) } }
        ms[k] = keep
    }
}

// Whether a = b is an equality oneEqPerClass may stand for by another of
// its class: both columns of one integer type, or both dates. Their
// equality is the values' own, so it is transitive. Not across types (an
// int and a numeric, a date and a timestamp: the classes leave those out,
// and the equality is a conversion's), and not texts (a char(n)'s padding,
// a collation), floats (NaN, -0) or others, where a written equality is
// kept as written.
fn (q: &Query) plainEqCols(a: &str, b: &str): bool {
    let i = lexdb_bind.colIndex(&q.cols, a)
    let j = lexdb_bind.colIndex(&q.cols, b)
    if i < 0 || j < 0 { return false }
    let o = q.cols[i].typ.oid
    if o != q.cols[j].typ.oid { return false }
    return o == lexdb_sql.OID_INT2 || o == lexdb_sql.OID_INT4 || o == lexdb_sql.OID_INT8 || o == lexdb_sql.OID_DATE
}

// The equalities cs holds, as text, each way round (a set, so that the
// implied ones are checked against it at once: a star of 24 tables implies
// hundreds).
fn eqTexts(cs: &[]Expr): Map[str, int] {
    var m: Map[str, int] = newMap()
    for c in cs {
        match c {
            Expr.Bin(op, l, r) {
                if op == "=" {
                    let a = lexdb_sql.exprText(&l)
                    let b = lexdb_sql.exprText(&r)
                    m.put(a + "\x00" + b, 1)
                    m.put(b + "\x00" + a, 1)
                }
            }
            else {}
        }
    }
    return m
}

// The equalities the classes imply that cs does not hold: between columns
// of two tables, and of each column with its class's constant.
fn (q: &Query) implied(cs: &[]Expr): []Expr {
    var out: []Expr = []
    let have = eqTexts(cs)
    for cl in q.eqClasses(cs) {
        var texts: []str = []
        for n in cl.names { append(mut &texts, lexdb_sql.exprText(&Expr.Col(n.toStr(), -1))) }
        let kt = if len(cl.konst) > 0 { lexdb_sql.exprText(&cl.konst[0]) } else { "" }
        for i in 0..len(cl.names) {
            for j in i + 1..len(cl.names) {
                if cl.levels[i] == cl.levels[j] { continue }
                if !have.has(&(texts[i] + "\x00" + texts[j])) {
                    append(mut &out, Expr.Bin("=", Expr.Col(cl.names[i].toStr(), q.slotOf(&cl.names[i])), Expr.Col(cl.names[j].toStr(), q.slotOf(&cl.names[j]))))
                }
            }
            if len(cl.konst) > 0 && !have.has(&(texts[i] + "\x00" + kt)) {
                append(mut &out, Expr.Bin("=", Expr.Col(cl.names[i].toStr(), q.slotOf(&cl.names[i])), lexdb_sql.cloneExpr(&cl.konst[0])))
            }
        }
    }
    return out
}

// ---- join order, step 2 (optimizer 26): by cost, with ANALYZE's statistics.
// When every table of a SELECT's inner join has statistics and there are at
// most JOIN_SEARCH_MAX (24), the order is the cheapest left-deep order:
// found exactly by dynamic programming over the sets of tables placed to
// JOIN_EXACT_MAX tables, past that by SQLite's N-best search (optimizer 28,
// 30); and
// each table after the first is read either by a lookup per row of the
// tables before it or once (a hash join), whichever costs less. Costs are
// reads (optimizer 24): a lookup's descent one, a row by the primary key
// one, by an index two; a row put in a hash HASH_BUILD, a probe of it
// HASH_PROBE (so the smaller side is hashed); each row a join gives ROW_COST. A table's rows by its constant conditions come from its
// statistics (a literal by its value; a parameter as an unknown value, so
// that the order does not depend on parameters); an equality between two
// tables' columns keeps 1 / the larger distinct count of the two (a one-column
// primary key or unique index: the table's rows; an index's leading column:
// ANALYZE's count; else about 10 rows a value, SQLite's default). A set is
// extended only by a table a conjunct links to it, unless none is (no cross
// product while a join is left: a chain of n tables visits n(n+1)/2 sets, not
// 2^n). Without statistics for every table, the order bound by keys
// (optimizer 25) stands.

// Exact search to this many tables; past it SQLite's N-best search, keeping
// the JOIN_BEST cheapest partial orders at each step (optimizer 28).
// The costs, measured (optimizer 36, design/experiments/calib.lxl, in
// memory), in units of a row of a scan in batches (25 ns): a scan read row
// by row (a hashed table's) 12 (307 ns); a primary key range's row, first
// table, 1.7 (42 ns); a descent of a tree 12; a row fetched by its key (a
// lookup's, an index entry's) 45 (about 1,100 ns); a joined row 2. A hash's
// row built 8 and a probe 2 (optimizer 41, calib_batch.lxl: joins over
// batches, lexdb.md 9.102, probe a batch at a time: 13 to 21 ns an outer
// row on an integer key, 79 on a text key; a row read once and hashed 554
// ns, its read's 12 and 8). They were 22 and 22 when each probe went
// through the row path (about 450 ns). The first table's index range, in
// batches (lexdb.md 9.107: its entries' rows read in key order;
// calib_index.lxl, 467 ns an entry against a scan's row's 29), 16 an
// entry, where it was a row by key's 45.
// Measured again on settled tables (optimizer 45: column leaves read from
// their pages, as a server's; the three calib programs load, vacuum and
// checkpoint, then measure in a store opened again): a scan's row in
// batches 12 ns (the unit; it was 25 to 28 on rows just inserted); a row
// read row by row 527 to 568 ns, 44; a primary key range's row 22 ns, 1.8;
// an index range's entry and its row 584 ns, 49; a lookup by primary key
// 436 to 648 ns, 36 to 54 (12 + 36); a row read once and hashed 757 ns, so
// 19 for the hash over the read; a probe 18 ns (a text key's 71).

// A key column's values among the conjuncts: per value, the levels it uses
// (a bit each; 0 constants and parameters) and its key when it is a literal
// ("" else).

// A way into a level: its primary key (index -1) or an unfiltered index.

// Its expected rows and reads each time it is taken; outer: it uses values of
// the levels placed. rows -1: none.
// cost: as the first table (scanned in batches) or per lookup; inner: read
// once as a hashed table (row by row, optimizer 36).

fn fmax(a: float, b: float): float { return if a > b { a } else { b } }

fn (q: &Query) levelMask(x: &Expr): int {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    var m = 0
    for n in ns {
        let l = q.levelOf(&n)
        if l < 0 { return -1 }
        m = m | (1 << l)
    }
    return m
}

// The ways into level k, their key columns' values among cs.
fn (q: &Query) wayCands(k: int, cs: &[]Expr): []WayCand {
    let lv = &q.levels[k]
    var out: []WayCand = []
    let noParams: []Val = []
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        var bcs: []BindCol = []
        for pos in 0..len(cols) {
            var b = BindCol{deps: [], keys: []}
            if cols[pos] >= 0 {
                let name = lv.alias + "." + lv.t.cols[cols[pos]].name
                for x in cs {
                    match x {
                        Expr.Bin(op, l, r) {
                            if op == "=" {
                                for side in 0..2 {
                                    let me = if side == 0 { &l } else { &r }
                                    let other = if side == 0 { &r } else { &l }
                                    match me {
                                        Expr.Col(n, _) {
                                            if n == name && !hasCorr(other) {
                                                let m = q.levelMask(other)
                                                if m >= 0 && (m & (1 << k)) == 0 {
                                                    append(mut &b.deps, m)
                                                    append(mut &b.keys, if m == 0 { constKey(other, &keyType(&lv.t, c, pos), &noParams) } else { "" })
                                                }
                                            }
                                        }
                                        else {}
                                    }
                                }
                            }
                        }
                        else {}
                    }
                }
            }
            append(mut &bcs, b)
        }
        append(mut &out, WayCand{index: c, tree: if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree },
                                 unique: c < 0 || lv.t.indexes[c].unique, cols: bcs, colIds: collections.copyOf(&cols)})
    }
    return out
}

// Whether path choice has a way into level k by its constants (an equality,
// a range or an IN list on a leading column) that does not give the order
// of cols (its columns): it would not read the table in that order.
fn (q: &Query) constWay(k: int, cands: &[]WayCand, cs: &[]Expr, cols: &[]int): bool {
    let lv = &q.levels[k]
    for wc in cands {
        if len(wc.colIds) == 0 || wc.colIds[0] < 0 { continue }
        let name = lv.alias + "." + lv.t.cols[wc.colIds[0]].name
        if len(inList(cs, &name, k, q)) > 0 { return true }
        var any = false
        for b in bounds(cs, &name, k, q) { if q.maxLevel(&b.val) < 0 && !hasCorr(&b.val) { any = true } }
        if !any { continue }
        // its leading constant equalities, then (a range) in key order
        var eqs: []Expr = []
        for bc in wc.cols {
            var konst = false
            for d in bc.deps { if d == 0 { konst = true } }
            if !konst { break }
            append(mut &eqs, Expr.Lit(Val.Null))
        }
        let p = Path{index: wc.index, eqs: eqs, rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0, sorted: false}
        if !servesOrder(&lv.t, &p, cols) { return true }
    }
    return false
}

// The cheapest way into level k with the levels of mask placed: outer, one
// using their values (a lookup per row; rows -1 when there is none); else
// one by constants only (equalities, then a range of the next column, cs's:
// optimizer 29), a full scan at worst.
fn (q: &Query) wayInto(k: int, cands: &[]WayCand, mask: int, outer: bool, cs: &[]Expr): Way {
    let lv = &q.levels[k]
    let t = float(lv.est.rows)
    var best = if outer { Way{rows: -1.0f, cost: 0.0f, outer: true, inner: 0.0f} } else {
        Way{rows: t, cost: t * COST_SCAN, outer: false, inner: t * COST_SCAN_INNER}
    }
    for ci in 0..len(cands) {
        let wc = &cands[ci]
        var n = 0
        var uses = false
        var key = ""
        for bi in 0..len(wc.cols) {
            let b = &wc.cols[bi]
            var found = -1
            for i in 0..len(b.deps) {
                let d = b.deps[i]
                let ok = if outer { (d & ~mask) == 0 } else { d == 0 }
                if found < 0 && ok { found = i }
            }
            if found < 0 { break }
            if b.deps[found] != 0 { uses = true }
            if n == 0 { key = b.keys[found].clone() }
            n += 1
        }
        if outer && (n == 0 || !uses) { continue }
        var m = 1.0f
        if n == 0 {
            let e = lv.est.entriesOf(wc.tree)
            m = if e >= 0 { float(e) } else { t }
        } else if n < len(wc.cols) || !wc.unique {
            let r = lv.est.rowsFor(wc.tree, n, &key)
            m = if r >= 0 { float(r) } else { fmax(t / 10.0f, 1.0f) }
        }
        if n < len(wc.colIds) && wc.colIds[n] >= 0 {
            // a range of the next column (optimizer 29), by constants:
            // a lookup's too, after its equalities
            let sh = q.rangeShare(k, wc.colIds[n], cs)
            if n == 0 && sh >= 1.0f { continue }        // a whole index: no better than the full scan
            m = m * sh
        } else if n == 0 {
            continue
        }
        // a row by key through an index, or the primary key's own (one: a
        // point; more: a range, in batches as the first table)
        let point = wc.index < 0 && n == len(wc.cols) && wc.unique
        let perRow = if point || (wc.index >= 0 && outer) { COST_KEY_ROW } else if wc.index >= 0 { COST_IX_ROW } else if outer { COST_SCAN_INNER } else { COST_PK_RANGE }
        let cost = COST_DESCENT + m * perRow
        let inner = COST_DESCENT + m * (if wc.index >= 0 || point { COST_KEY_ROW } else { COST_SCAN_INNER })
        if best.rows < 0.0f || cost < best.cost { best = Way{rows: m, cost: cost, outer: outer, inner: fmin(inner, best.inner)} }
        else if !outer && inner < best.inner { best.inner = inner }
    }
    return best
}

// ---- a table's own conditions (optimizer 29): the share of its rows they
// keep, for the join order's estimates. An equality with a literal on a
// column leading an index or the primary key: its value's rows (the common
// values); else 1 / the column's distinct values. A range on a column whose
// least and greatest ANALYZE has (a leading column of numbers, dates or
// times), with literal bounds: the part of that span it covers; else 1/4,
// 1/16 bounded on both sides (SQLite's). An IN list of n: n / the distinct
// values. Anything else: 1/2. A parameter is an unknown value (the order
// does not depend on parameters).

// Level k's statistics entry for a column leading its primary key or an
// unfiltered index (-1 none).
fn (q: &Query) leadEntry(k: int, col: int): int {
    let lv = &q.levels[k]
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        if len(cols) == 0 || cols[0] != col { continue }
        let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
        for j in 0..len(lv.est.trees) { if lv.est.trees[j] == tree { return j } }
    }
    return -1
}

// A literal as a number of column col's type; None: not a literal (a cast
// of one counts: date '2021-06-01', optimizer 36), or not a number.
fn (q: &Query) litNum(k: int, col: int, x: &Expr): Option[float] { return litNumOf(&q.levels[k], col, x) }

fn litNumOf(lv: &Level, col: int, x: &Expr): Option[float] {
    match litValue(x) {
        Some(v) {
            if lexdb_ops.isNull(&v) { return None }
            match lexdb_ops.coerce(v, &boundType(&lv.t.cols[col].typ)) {
                Ok(cv) { return lexdb_stats.spanNum(&cv) }
                Err(_) { return None }
            }
        }
        None { return None }
    }
}

// Whether x is made of literals only: no column, parameter or call.
fn litOnly(x: &Expr): bool {
    match x {
        Expr.Lit(_) { return true }
        Expr.Unary(_, a) { return litOnly(&a) }
        Expr.Bin(_, a, b) { return litOnly(&a) && litOnly(&b) }
        Expr.Cast(a, _) { return litOnly(&a) }
        else { return false }
    }
}

// A literal's value, or a literal expression's (a cast, arithmetic) worked
// out; None: not one, or it gives an error.
fn litValue(x: &Expr): Option[Val] {
    match x {
        Expr.Lit(v) { return Some(v.clone()) }
        else {}
    }
    if !litOnly(x) { return None }
    let none: []Val = []
    match up().eval(x, &none) {
        Ok(v) { return Some(v) }
        Err(_) { return None }
    }
}

// x compares the column name with a constant: its operator, the column on
// the left ("" not such a comparison), and the constant in val.
fn (q: &Query) colCmp(name: &str, x: &Expr, val: mut &Expr): str {
    match x {
        Expr.Bin(op, l, r) {
            if !lexdb_bind.isCmp(&op) { return "" }
            match l {
                Expr.Col(n, _) {
                    if n == name && q.levelMask(&r) == 0 && !hasCorr(&r) {
                        val = lexdb_sql.cloneExpr(&r)
                        return op.clone()
                    }
                }
                else {}
            }
            match r {
                Expr.Col(n, _) {
                    if n == name && q.levelMask(&l) == 0 && !hasCorr(&l) {
                        val = lexdb_sql.cloneExpr(&l)
                        return if op == "<" { ">" } else if op == "<=" { ">=" } else if op == ">" { "<" } else if op == ">=" { "<=" } else { op.clone() }
                    }
                }
                else {}
            }
            return ""
        }
        else { return "" }
    }
}

// The share of level k's rows its range conditions on column col keep (1:
// none). By the samples of the column when it leads the primary key or an
// index and the bounds are literals (optimizer 37); else by its least and
// greatest (optimizer 29); else 1/4, 1/16 bounded on both sides.
pub fn (q: &Query) rangeShare(k: int, col: int, cs: &[]Expr): float {
    let lv = &q.levels[k]
    let name = lv.alias + "." + lv.t.cols[col].name
    var ops: []str = []
    var vals: []Expr = []
    for c in cs {
        var v = Expr.Lit(Val.Null)
        let op = q.colCmp(&name, &c, mut &v)
        if op != "<" && op != "<=" && op != ">" && op != ">=" { continue }
        append(mut &ops, op)
        append(mut &vals, v)
    }
    if len(ops) == 0 { return 1.0f }
    return q.boundsShare(k, col, &ops, &vals)
}

// The share of level k's rows within bounds (ops: "<", "<=", ">", ">=") on
// its column col.
fn (q: &Query) boundsShare(k: int, col: int, ops: &[]str, vals: &[]Expr): float {
    let lv = &q.levels[k]
    var hasLo = false
    var hasHi = false
    var known = true
    var lo = 0.0f
    var hi = 0.0f
    for i in 0..len(ops) {
        let x = q.litNum(k, col, &vals[i])
        if x.isNone() { known = false }
        let f = x.unwrapOr(0.0f)
        if ops[i] == ">" || ops[i] == ">=" {
            if !hasLo || f > lo { lo = f }
            hasLo = true
        } else {
            if !hasHi || f < hi { hi = f }
            hasHi = true
        }
    }
    let e = q.leadEntry(k, col)
    let t = fmax(float(lv.est.rows), 1.0f)
    if e >= 0 && e < len(lv.est.samp) {
        let sh = sampOnly(lv, e, col, ops, vals)
        if sh >= 0.0f { return fmax(sh, 1.0f / t) }
    }
    if known && e >= 0 && lv.est.span[e] {
        let mn = lv.est.lo[e]
        let mx = lv.est.hi[e]
        if mx <= mn { return 1.0f }
        let a = if hasLo && lo > mn { lo } else { mn }
        let b = if hasHi && hi < mx { hi } else { mx }
        if b < a { return 1.0f / t }
        return fmax((b - a) / (mx - mn), 1.0f / t)
    }
    return if hasLo && hasHi { 1.0f / 16.0f } else { 0.25f }
}

// The share of level k's rows its own conditions among cs keep (masks:
// the levels each uses); guessed set when a condition's share is a guess (no
// statistics say: an equality on a column no index leads with, or another
// test).
fn (q: &Query) localShare(k: int, cs: &[]Expr, masks: &[]int, guessed: mut &bool): float {
    var mine: []Expr = []
    for i in 0..len(cs) {
        if masks[i] != (1 << k) || hasCorr(&cs[i]) { continue }
        append(mut &mine, lexdb_sql.cloneExpr(&cs[i]))
    }
    return q.andShare(k, &mine, guessed)
}

// The share a conjunction of a level's own conditions keeps of its rows.
fn (q: &Query) andShare(k: int, cs: &[]Expr, guessed: mut &bool): float {
    let lv = &q.levels[k]
    var share = 1.0f
    var ranged: []int = []
    var names: []str = []
    for i in 0..len(cs) {
        // a disjunction: each branch's own share, as if independent
        // (PostgreSQL has no OR estimate either; 1 - (1-s1)(1-s2)...)
        if matchesOr(&cs[i]) {
            share = share * q.orShare(k, &cs[i], guessed)
            continue
        }
        if len(names) == 0 { for c in lv.t.cols { append(mut &names, lv.alias + "." + c.name) } }
        let c = &cs[i]
        var done = false
        for col in 0..len(lv.t.cols) {
            if done { break }
            var v = Expr.Lit(Val.Null)
            let op = q.colCmp(&names[col], c, mut &v)
            if op == "" { continue }
            done = true
            let name = &names[col]
            if op == "=" {
                share = share * q.eqShare(k, col, &v, guessed)
            } else if op == "<>" {
                share = share * (1.0f - 1.0f / q.distinctOf(name, k))
            } else {
                var seen = false
                for r in ranged { if r == col { seen = true } }
                if !seen {
                    append(mut &ranged, col)
                    share = share * q.rangeShare(k, col, cs)
                }
            }
        }
        if done { continue }
        match cs[i] {
            Expr.Call(n, args, _) {
                if n == "in" && len(args) > 1 {
                    match args[0] {
                        Expr.Col(a, _) {
                            let d = q.distinctKnown(&a, k)
                            if d <= 0.0f { guessed = true }
                            share = share * fmin(1.0f, float(len(args) - 1) * (if d > 0.0f { 1.0f / d } else { EQ_GUESS }))
                            continue
                        }
                        else {}
                    }
                }
            }
            else {}
        }
        share = share * 0.5f
        guessed = true
    }
    return share
}

// The share of level k's rows an OR of branches keeps: each branch's
// conditions on k only, multiplied within the branch; a branch with none
// leaves k alone (share 1).
fn (q: &Query) orShare(k: int, x: &Expr, guessed: mut &bool): float {
    var branches: []Expr = []
    orParts(x, mut &branches)
    var miss = 1.0f
    for b in branches {
        var ps: []Expr = []
        andParts(&b, mut &ps)
        var local: []Expr = []
        for d in ps {
            if q.levelMask(&d) == (1 << k) && !hasCorr(&d) { append(mut &local, lexdb_sql.cloneExpr(&d)) }
        }
        if len(local) == 0 { return 1.0f }
        miss = miss * (1.0f - fmin(1.0f, q.andShare(k, &local, guessed)))
    }
    return 1.0f - miss
}

// The share of level k's rows equal to v on column col.
fn (q: &Query) eqShare(k: int, col: int, v: &Expr, guessed: mut &bool): float {
    let lv = &q.levels[k]
    let e = q.leadEntry(k, col)
    if e >= 0 && lv.est.entries[e] > 0 {
        let noParams: []Val = []
        let key = constKey(v, &boundType(&lv.t.cols[col].typ), &noParams)
        let r = lexdb_stats.rowsOf(&lv.est.cm[e], &key)
        if r >= 0 { return fmax(float(r), 1.0f) / float(lv.est.entries[e]) }
    }
    let d = q.distinctKnown(&(lv.alias + "." + lv.t.cols[col].name), k)
    if d <= 0.0f { guessed = true }
    return if d > 0.0f { 1.0f / d } else { EQ_GUESS }
}

// An equality with a constant on a column whose distinct values are not
// known (no index leads with it): the share of the rows it keeps, SQLite's
// guess (a quarter). The table's rows / 10 (distinctOf's guess) made it
// about 10 rows whatever the table's size, which the measured costs
// (optimizer 36) turned into a full scan of the largest table (optimizer 39).

fn fmin(a: float, b: float): float { return if a < b { a } else { b } }

// A column's distinct values (level k's), for an equality's share.
fn (q: &Query) distinctOf(name: &str, k: int): float {
    let d = q.distinctKnown(name, k)
    if d > 0.0f { return d }
    return fmax(fmax(float(q.levels[k].est.rows), 1.0f) / 10.0f, 1.0f)
}

// A column's distinct values when a key or an index (with statistics) leads
// with it; -1 not known.
fn (q: &Query) distinctKnown(name: &str, k: int): float {
    let lv = &q.levels[k]
    let i = lexdb_bind.colIndex(&q.cols, name) - lv.first
    let t = fmax(float(lv.est.rows), 1.0f)
    if len(lv.t.pk) == 1 && lv.t.pk[0] == i { return t }
    for x in 0..len(lv.t.indexes) + 1 {
        let c = x - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        if len(cols) == 0 || cols[0] != i { continue }
        if len(cols) == 1 && (c < 0 || lv.t.indexes[c].unique) { return t }
        let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
        for j in 0..len(lv.est.trees) { if lv.est.trees[j] == tree && lv.est.cm[j].d > 0 { return float(lv.est.cm[j].d) } }
    }
    // ANALYZE's count of another column (optimizer 39); none but NULLs: an
    // equality keeps a row at most
    if i >= 0 && i < len(lv.t.cols) {
        for j in 0..len(lv.est.cols) {
            if lv.est.cols[j] == lv.t.cols[i].name && lv.est.cnd[j] >= 0 { return if lv.est.cnd[j] > 0 { float(lv.est.cnd[j]) } else { t } }
        }
    }
    return -1.0f
}

// The rows of a set of levels (mask): its tables' by their constants,
// times each class's share between its lowest table and the rest: 1 / the
// largest distinct count among the class's columns there; at least one row.
// Defined by the lowest table, so a set's rows do not depend on the order
// that reached it. memo: the sets computed.
fn (q: &Query) setRows(mask: int, nl: int, base: &[]Way, cmask: &[]int, cdist: &[]float, memo: mut &Map[int, float]): float {
    if memo.has(&mask) { return memo.getOr(&mask, 1.0f) }
    var low = 0
    while (mask & (1 << low)) == 0 { low += 1 }
    let rest = mask & ~(1 << low)
    var r = base[low].rows * (if rest == 0 { 1.0f } else { q.setRows(rest, nl, base, cmask, cdist, memo) })
    for ci in 0..len(cmask) {
        let cm = cmask[ci]
        if (cm & (1 << low)) == 0 { continue }
        let other = cm & rest
        if other == 0 { continue }
        // the class's most selective column among the set's
        var d = cdist[ci * nl + low]
        for l in 0..nl { if (other & (1 << l)) != 0 { d = fmax(d, cdist[ci * nl + l]) } }
        r = r / d
    }
    let v = fmax(r, 1.0f)
    memo.put(mask, v)
    return v
}

// SQLite's N-best search from the levels init (each a one-table start):
// the order (order, flags: read once) and its cost (optimizer 28; from a
// given start, optimizer 32).
fn (q: &Query) nBest(init: &[]int, nl: int, cands: &[][]WayCand, owns: &[][]Expr, base: &[]Way, adj: &[]int, cmask: &[]int, cdist: &[]float,
                     memo: mut &Map[int, float], lookups: bool, cap: float, order: mut &[]int, flags: mut &[]bool): float {
    // SQLite's N-best search: at each step the JOIN_BEST cheapest
    // partial orders are kept (one per set of tables), each extended by
    // every table it may take next
    var pm: []int = []
    var pc: []float = []
    var po: [][]int = []
    var pf: [][]bool = []
    for k in init {
        append(mut &pm, 1 << k)
        append(mut &pc, base[k].cost)
        append(mut &po, [k])
        append(mut &pf, [false])
    }
    bestOf(mut &pm, mut &pc, mut &po, mut &pf)
    for step in 1..nl {
        // the extensions: per set of tables the cheapest, as its parent
        // path and the table added (copied only when kept)
        var nm: []int = []
        var nc: []float = []
        var npar: []int = []
        var nk: []int = []
        var nh: []bool = []
        var at: Map[int, int] = newMap()
        for p in 0..len(pm) {
            let mask = pm[p]
            let rin = q.setRows(mask, nl, base, cmask, cdist, memo)
            var nb = 0
            for l in 0..nl { if (mask & (1 << l)) != 0 { nb = nb | adj[l] } }
            let linked = (nb & ~mask) != 0
            for k in 0..nl {
                if (mask & (1 << k)) != 0 { continue }
                if linked && (adj[k] & mask) == 0 { continue }
                let next = mask | (1 << k)
                var o = false
                let rnext = q.setRows(next, nl, base, cmask, cdist, memo)
                let total = pc[p] + q.joinStep(k, &cands[k], &owns[k], &base[k], mask, rin, rnext, lookups, cap, mut &o)
                let j = at.getOr(&next, -1)
                if j >= 0 {
                    if nc[j] <= total { continue }
                    nc[j] = total
                    npar[j] = p
                    nk[j] = k
                    nh[j] = o
                } else {
                    at.put(next, len(nm))
                    append(mut &nm, next)
                    append(mut &nc, total)
                    append(mut &npar, p)
                    append(mut &nk, k)
                    append(mut &nh, o)
                }
            }
        }
        // the JOIN_BEST cheapest, cheapest first (a tie: the earlier)
        var taken: []bool = array(len(nm), false)
        var m2: []int = []
        var c2: []float = []
        var o2: [][]int = []
        var f2: [][]bool = []
        while len(m2) < JOIN_BEST && len(m2) < len(nm) {
            var b = -1
            for i in 0..len(nm) { if !taken[i] && (b < 0 || nc[i] < nc[b]) { b = i } }
            taken[b] = true
            append(mut &m2, nm[b])
            append(mut &c2, nc[b])
            var ord = collections.copyOf(&po[npar[b]])
            append(mut &ord, nk[b])
            var fl = collections.copyOf(&pf[npar[b]])
            append(mut &fl, nh[b])
            append(mut &o2, ord)
            append(mut &f2, fl)
        }
        pm = m2
        pc = c2
        po = o2
        pf = f2
    }
    // the cheapest (the first: bestOf orders them)
    order = replace(mut &po[0], [])
    flags = replace(mut &pf[0], [])
    return pc[0]
}

// The cost of joining level k to the set mask (rin its rows; rnext the rows
// of the set with k): its constant way read once and hashed, then a probe
// per row; or a lookup per row, whichever is cheaper (hashed: the first).
// Where a lookup is possible, it is taken when lookups is set, or when the
// hash would hold more than cap bytes (statement memory, optimizer 26
// review).
fn (q: &Query) joinStep(k: int, cands: &[]WayCand, own: &[]Expr, base: &Way, mask: int, rin: float, rnext: float, lookups: bool,
                        cap: float, hashed: mut &bool): float {
    let out = rnext * ROW_COST
    var add = base.inner + base.rows * HASH_BUILD + rin * HASH_PROBE + out
    hashed = true
    let w = q.wayInto(k, cands, mask, true, own)
    if w.rows >= 0.0f {
        let big = base.rows * float(estRowBytes(&q.levels[k].t)) > cap
        if lookups || big || rin * w.cost + out < add {
            add = rin * w.cost + out
            hashed = false
        }
    }
    return add
}

// A hash join's rows at most, in bytes, unless there is no lookup: a
// quarter of the default statement memory (MAX_STATEMENT_MEM); less when
// the session's max_statement_mem is lower (half of it).

// A row's size in a hash, estimated as rowBytes counts a row held: 32
// bytes, 24 a value, and a text's bytes (32 taken as its length).
fn estRowBytes(t: &Table): int {
    var n = 32
    for c in t.cols { n += 24 + (if c.typ.kind == lexdb_sql.K_TEXT { 32 } else { 0 }) }
    return n
}

// Keeps the JOIN_BEST cheapest of the partial orders, cheapest first (a tie:
// the earlier).
fn bestOf(pm: mut &[]int, pc: mut &[]float, po: mut &[][]int, pf: mut &[][]bool) {
    var taken: []bool = array(len(pm), false)
    var m: []int = []
    var c: []float = []
    var o: [][]int = []
    var f: [][]bool = []
    while len(m) < JOIN_BEST && len(m) < len(pm) {
        var b = -1
        for i in 0..len(pm) { if !taken[i] && (b < 0 || pc[i] < pc[b]) { b = i } }
        taken[b] = true
        append(mut &m, pm[b])
        append(mut &c, pc[b])
        append(mut &o, replace(mut &po[b], []))
        append(mut &f, replace(mut &pf[b], []))
    }
    pm = m
    pc = c
    po = o
    pf = f
}

// A query with outer joins, its tables in FROM's order (optimizer 41):
// per table after the first, whether it is read once and hashed (true)
// or looked up per row of the tables before it, whichever costs less, as
// joinStep weighs them: the rows reaching it are the first table's by its
// own conditions, then times each table's rows a lookup gives (a LEFT
// JOIN keeps a row that joins none). false: it does not apply (a RIGHT or
// FULL JOIN, LATERAL, a table without statistics). early: a lookup stays a
// lookup (reading may stop early); cap: a hash's bytes at most.
fn (q: &Query) outerReadOnce(ms: &[][]Expr, early: bool, cap: float, ro: mut &[]bool): bool {
    let nl = len(q.levels)
    for lv in q.levels {
        if keepsRight(lv.join) || lv.lateral || (lv.est.rows < 0 && !lv.virt()) { return false }
    }
    var out: []bool = array(nl, false)
    var rin = 1.0f
    for k in 0..nl {
        let lv = &q.levels[k]
        if lv.virt() { continue }
        let cs = &ms[k]
        var own: []Expr = []
        var ownMasks: []int = []
        for c in cs {
            let mk = q.levelMask(&c)
            if mk == (1 << k) {
                append(mut &own, lexdb_sql.cloneExpr(&c))
                append(mut &ownMasks, mk)
            }
        }
        let cands = q.wayCands(k, cs)
        var g = false
        let rows = fmax(float(lv.est.rows) * q.localShare(k, &own, &ownMasks, mut &g), 1.0f)
        if k == 0 {
            rin = rows
            continue
        }
        let w = q.wayInto(k, &cands, (1 << k) - 1, true, &own)
        if w.rows < 0.0f { continue }               // no lookup: hashed in any case
        let base = q.wayInto(k, &cands, 0, false, &own)
        let hash = base.inner + rows * HASH_BUILD + rin * HASH_PROBE
        let big = rows * float(estRowBytes(&lv.t)) > cap
        if !early && !big && hash < rin * w.cost { out[k] = true }
        rin = if keepsLeft(lv.join) { rin * fmax(w.rows, 1.0f) } else { rin * w.rows }
    }
    ro = out
    return true
}

// Whether the right join's hash of level 0 (a, rightCheaper) fits in cap
// bytes: its rows (by ANALYZE) at what a row is held as (32 bytes, 24 a
// value) plus its stored size on average (its table's pages, long values'
// included, over its rows). The stored size counts every column, not only
// those the statement uses: an overestimate, so a hash that might not fit
// keeps the lookups (which hold nothing).
fn (q: &Query) rightFits(st: &lexdb_store.Store, cap: float): Result[bool, DbErr] {
    let a = &q.levels[0]
    if a.est.rows <= 0 || a.t.tree < 0 { return Ok(a.est.rows == 0) }
    let pages = try lexdb_access.pages(st, &lexdb_catalog.relOf(&a.t))
    let stored = float(pages * lexdb_rows.PAGE) / float(a.est.rows)
    let held = float(a.est.rows) * (32.0f + 24.0f * float(len(a.t.cols)) + stored)
    return Ok(held <= cap)
}

// Whether "a LEFT JOIN b" (two tables, FROM's order) costs less as a hash
// right join: b read first by its own ON conditions, a read once into a
// hash on the join's equalities, each row of b probing it, and a's rows that
// joined none added at the end with NULLs for b (PostgreSQL's Hash Right
// Join, tpch-perf 4.outer). The left join's way is what outerReadOnce chose
// (ro): a lookup into b per row of a, or b hashed. Not where a's hash would
// hold more than cap bytes, nor without an equality to hash on.
fn (q: &Query) rightCheaper(ms: &[][]Expr, ps: &[][]Expr, cap: float, ro: &[]bool): bool {
    if len(q.levels) != 2 { return false }
    let a = &q.levels[0]
    let b = &q.levels[1]
    if b.join != lexdb_sql.J_LEFT || a.virt() || b.virt() || a.lateral || b.lateral || a.lock != 0 || b.lock != 0 { return false }
    if a.est.rows < 0 || b.est.rows < 0 { return false }
    // every conjunct of this query's own columns (no outer value, no subquery)
    var ownA: []Expr = []
    var maskA: []int = []
    var ownB: []Expr = []
    var maskB: []int = []
    var eq = false
    for k in 0..2 {
        for c in ms[k] {
            let mk = q.levelMask(&c)
            if mk < 0 || hasSubCall(&c) || !lexdb_bind.immutable(&c) { return false }
            if k == 0 && mk == 1 {
                append(mut &ownA, lexdb_sql.cloneExpr(&c))
                append(mut &maskA, mk)
            } else if k == 1 && mk == 2 && cannotFail(&c) {
                append(mut &ownB, lexdb_sql.cloneExpr(&c))
                append(mut &maskB, mk)
            } else if k == 1 && mk == 3 {
                // an equality a hash of a keys on: a column of a (bare or
                // under its collation's key) equal to a value of b's alone
                match c {
                    Expr.Bin(op, x, y) {
                        if op == "=" {
                            let kx = keyedCol(&x)
                            let ky = keyedCol(&y)
                            if len(kx.name) > 0 && q.levelOf(&kx.name) == 0 && q.levelMask(&y) == 2 { eq = true }
                            if len(ky.name) > 0 && q.levelOf(&ky.name) == 0 && q.levelMask(&x) == 2 { eq = true }
                        }
                    }
                    else {}
                }
            }
        }
        for c in ps[k] { if q.levelMask(&c) < 0 || hasSubCall(&c) || !lexdb_bind.immutable(&c) { return false } }
    }
    if !eq { return false }
    var g = false
    let rowsA = fmax(float(a.est.rows) * q.localShare(0, &ownA, &maskA, mut &g), 1.0f)
    let rowsB = fmax(float(b.est.rows) * q.localShare(1, &ownB, &maskB, mut &g), 1.0f)
    let candsA = q.wayCands(0, &ms[0])
    let firstA = q.wayInto(0, &candsA, 0, false, &ownA)
    let candsB = q.wayCands(1, &ms[1])
    let firstB = q.wayInto(1, &candsB, 0, false, &ownB)
    // the left join: a first, then b looked up per row or hashed
    var left = firstA.cost
    if len(ro) > 1 && ro[1] {
        left += firstB.inner + rowsB * HASH_BUILD + rowsA * HASH_PROBE
    } else {
        let w = q.wayInto(1, &candsB, 1, true, &ownB)
        if w.rows < 0.0f { return false }
        left += rowsA * w.cost
    }
    // the right join: b first, a hashed
    let right = firstB.cost + firstA.inner + rowsA * HASH_BUILD + rowsB * HASH_PROBE
    return right < left
}

// The cheapest order by cost: perm (old indexes, [] when it is FROM's) and
// per new place whether it is read once. false: it does not apply (a table
// without statistics, an outer join, LATERAL, too many tables).
// lookups: a table a lookup reaches is not read once instead.
// cap: a hash's bytes at most where a lookup is possible. ordT: the level an
// ORDER BY with a LIMIT can be read in order from (-1 none), ordCols its
// columns there, lim the rows
// the LIMIT and OFFSET take (optimizer 32). bushy: build groups
// (BU_*, optimizer 49); grp: per new place, a group's hub's members after
// it (0 none).
fn (q: &Query) costOrder(ms: &[][]Expr, lookups: bool, cap: float, ordT: int, ordCols: &[]int, lim: float, bushy: int, perm: mut &[]int,
                         ro: mut &[]bool, grp: mut &[]int): bool {
    let nl = len(q.levels)
    if nl < 2 || nl > JOIN_SEARCH_MAX { return false }
    for lv in q.levels {
        if isOuter(lv.join) || lv.lateral || lv.virt() || lv.est.rows < 0 { return false }
    }
    var cs: []Expr = []
    for m in ms { for c in m { append(mut &cs, lexdb_sql.cloneExpr(&c)) } }
    // the levels each conjunct uses
    var masks: []int = []
    for x in cs { append(mut &masks, q.levelMask(&x)) }
    var cands: [][]WayCand = []
    var base: []Way = []                // each level by its constants alone
    var guessed: []bool = []            // per level: its rows by a guessed share
    var owns: [][]Expr = []             // per level: its own conditions
    for k in 0..nl {
        append(mut &cands, q.wayCands(k, &cs))
        // its own conditions (no other table's columns)
        var own: []Expr = []
        var ownMasks: []int = []
        for i in 0..len(cs) {
            if masks[i] == (1 << k) {
                append(mut &own, lexdb_sql.cloneExpr(&cs[i]))
                append(mut &ownMasks, masks[i])
            }
        }
        // read by its constants; its rows: the table's, times the share its
        // own conditions keep (optimizer 29)
        let w = q.wayInto(k, &cands[k], 0, false, &own)
        let t = float(q.levels[k].est.rows)
        var g = false
        append(mut &base, Way{rows: fmax(t * q.localShare(k, &own, &ownMasks, mut &g), 1.0f), cost: w.cost, outer: false, inner: w.inner})
        append(mut &guessed, g)
        append(mut &owns, own)
    }
    // the levels each level shares a conjunct with
    var adj: []int = array(nl, 0)
    for m in masks {
        if m > 0 { for k in 0..nl { if (m & (1 << k)) != 0 { adj[k] = adj[k] | (m & ~(1 << k)) } } }
    }
    // the classes of equal columns (optimizer 27): a class joins the tables
    // holding its columns once, by 1 / the larger distinct count of the two
    // sides; a class with a constant joins nothing (each table's constant
    // condition has counted)
    // flat, for the loop over every set: per class the levels holding it
    // (a mask) and per class and level its column's distinct values
    var cmask: []int = []
    var cdist: []float = []             // class * nl + level
    let all = q.eqClasses(&cs)
    for x in 0..len(all) {
        if len(all[x].konst) > 0 { continue }
        var m = 0
        var ds: []float = array(nl, 0.0f)
        for i in 0..len(all[x].names) {
            let l = all[x].levels[i]
            if (m & (1 << l)) == 0 {
                m = m | (1 << l)
                ds[l] = q.distinctOf(&all[x].names[i], l)
            }
        }
        if m & (m - 1) == 0 { continue }        // one table's columns only
        append(mut &cmask, m)
        for d in ds { append(mut &cdist, d) }
    }
    var order: []int = []
    var flags: []bool = []
    var bestCost = 0.0f
    // the rows of a set, as needed (2^n sets past JOIN_EXACT_MAX is too many
    // to list: optimizer 30)
    var memo: Map[int, float] = newMap()
    if nl <= JOIN_EXACT_MAX {
        let full = (1 << nl) - 1
        var cost: []float = array(full + 1, -1.0f)
        var last: []int = array(full + 1, -1)
        var lastOnce: []bool = array(full + 1, false)
        for k in 0..nl {
            cost[1 << k] = base[k].cost
            last[1 << k] = k
        }
        for mask in 1..full + 1 {
            if cost[mask] < 0.0f { continue }
            let rin = q.setRows(mask, nl, &base, &cmask, &cdist, mut &memo)
            var nb = 0
            for l in 0..nl { if (mask & (1 << l)) != 0 { nb = nb | adj[l] } }
            let linked = (nb & ~mask) != 0
            for k in 0..nl {
                if (mask & (1 << k)) != 0 { continue }
                if linked && (adj[k] & mask) == 0 { continue }       // a cross product while a join is left
                let next = mask | (1 << k)
                var o = false
                let rnext = q.setRows(next, nl, &base, &cmask, &cdist, mut &memo)
                let total = cost[mask] + q.joinStep(k, &cands[k], &owns[k], &base[k], mask, rin, rnext, lookups, cap, mut &o)
                if cost[next] < 0.0f || total < cost[next] {
                    cost[next] = total
                    last[next] = k
                    lastOnce[next] = o
                }
            }
        }
        bestCost = cost[full]
        var rev: []int = []
        var revOnce: []bool = []
        var m = full
        while m != 0 {
            let k = last[m]
            append(mut &rev, k)
            append(mut &revOnce, lastOnce[m] && (m & ~(1 << k)) != 0)
            m = m & ~(1 << k)
        }
        for i in 0..nl {
            append(mut &order, rev[nl - 1 - i])
            append(mut &flags, revOnce[nl - 1 - i])
        }
    } else {
        var starts: []int = []
        for k in 0..nl { append(mut &starts, k) }
        bestCost = q.nBest(&starts, nl, &cands, &owns, &base, &adj, &cmask, &cdist, mut &memo, lookups, cap, mut &order, mut &flags)
    }
    // ORDER BY ... LIMIT (optimizer 32): the ordered table first, read in its
    // order (a full scan the planner turns into its index), each other table
    // looked up per row, stopping after the LIMIT: its cost is the whole
    // order's, times the share of the rows the LIMIT takes. It is taken when
    // that is cheaper than the best order's cost and a sort of its rows. Not
    // with a hash: a hash is built whole before the first row.
    // Only when the table has no way in by its constants, so path choice
    // will read it in order: its cost no longer says so, an index's way can
    // cost more than the scan (optimizer 39).
    //
    // Not when another table's rows are a guess (optimizer 39): if it keeps
    // far fewer than guessed, the LIMIT's rows come late and the ordered
    // table is read whole, a lookup per row (a filter on a column without an
    // index). A hash is built whole before the first row: its cost counts in
    // full, not the LIMIT's share (a hash of one pinned row is no reason
    // against it).
    var sure = true
    var ordered = false
    for k in 0..nl { if k != ordT && guessed[k] { sure = false } }
    if ordT >= 0 && sure && !q.constWay(ordT, &cands[ordT], &cs, ordCols) {
        var o2: []int = []
        var f2: []bool = []
        let c2 = q.nBest(&[ordT], nl, &cands, &owns, &base, &adj, &cmask, &cdist, mut &memo, true, cap, mut &o2, mut &f2)
        var builds = 0.0f
        for i in 1..nl { if f2[i] { builds += base[o2[i]].cost + base[o2[i]].rows * HASH_BUILD } }
        let rall = q.setRows((1 << nl) - 1, nl, &base, &cmask, &cdist, mut &memo)
        let frac = fmin(1.0f, lim / rall)
        let sortCost = rall * ROW_COST * float(scaleOf(int(rall)))
        if fmax(c2 - builds, 0.0f) * frac + builds < bestCost + sortCost {
            order = o2
            flags = f2
            ordered = true
        }
    }
    // build groups (optimizer 49.3): runs of the order made one hash of a join
    var grps: []int = array(nl, 0)
    if bushy != BU_OFF && !lookups && !ordered && nl >= 3 {
        var gs = q.grpSearch(&cs, &masks, nl)
        gs.force = bushy == BU_FORCE
        if gs.on { q.grpPass(&order, mut &flags, mut &grps, &gs, nl, &cands, &owns, &base, &cmask, &cdist, mut &memo, cap) }
    }
    var ident = true
    for i in 0..nl {
        append(perm, order[i])
        append(ro, flags[i])
        if order[i] != i { ident = false }
    }
    if ident { perm = [] }
    grp = grps
    return true
}

// Build groups over the order chosen (optimizer 49.3): a run of it, a hub
// at place i and the one or two tables after it as its members, costed as
// one hash of their join (grpCost) against the steps the order takes for
// them (each step depends on the set before it and the table only, so the
// steps after the run cost the same); the runs that gain most, not
// overlapping, while the plan with them costs under GRP_GAIN of the
// order's. Under BU_FORCE every valid run, first come first taken. The
// members are linked to the hub or the member before by an equality, the
// group to the tables before by one, no conjunct that may fail reads one
// of them with another table (GrpSearch.bad).
fn (q: &Query) grpPass(order: &[]int, flags: mut &[]bool, grps: mut &[]int, gs: &GrpSearch, nl: int, cands: &[][]WayCand, owns: &[][]Expr,
                       base: &[]Way, cmask: &[]int, cdist: &[]float, memo: mut &Map[int, float], cap: float) {
    // each place's step (the set before it, the table)
    var steps: []float = array(nl, 0.0f)
    var befores: []int = array(nl, 0)
    var total = base[order[0]].cost
    var mask = 1 << order[0]
    for i in 1..nl {
        let k = order[i]
        befores[i] = mask
        var o = false
        let rin = q.setRows(mask, nl, base, cmask, cdist, memo)
        let rnext = q.setRows(mask | (1 << k), nl, base, cmask, cdist, memo)
        steps[i] = q.joinStep(k, &cands[k], &owns[k], &base[k], mask, rin, rnext, false, cap, mut &o)
        total += steps[i]
        mask = mask | (1 << k)
    }
    // the runs that gain: hub place, members, gain
    var at: []int = []
    var ms: []int = []
    var gains: []float = []
    for i in 1..nl - 1 {
        let h = order[i]
        let pre = befores[i]
        if (gs.bad & (1 << h)) != 0 { continue }
        var g = 1 << h
        var link = gs.eqAdj[h]
        var removed = steps[i]
        for m in 1..GRP_MAX + 1 {
            if i + m >= nl { break }
            let x = order[i + m]
            if (gs.bad & (1 << x)) != 0 || (gs.eqAdj[x] & g) == 0 { break }
            g = g | (1 << x)
            link = link | gs.eqAdj[x]
            removed += steps[i + m]
            if (link & pre) == 0 { continue }
            let c = q.grpCost(h, order[i + 1], if m == 2 { order[i + 2] } else { -1 }, pre, nl, base, cmask, cdist, memo, cap, &gs.bytes, gs.force)
            if c < 0.0f || (!gs.force && c >= removed) { continue }
            append(mut &at, i)
            append(mut &ms, m)
            append(mut &gains, removed - c)
        }
    }
    // the largest gains first (BU_FORCE: in order), none overlapping
    var taken: []bool = array(len(at), false)
    var used: []bool = array(nl, false)
    var picked: []int = []
    var gain = 0.0f
    while true {
        var b = -1
        for x in 0..len(at) {
            if taken[x] { continue }
            var free = true
            for p in at[x]..at[x] + ms[x] + 1 { if used[p] { free = false } }
            if !free { continue }
            if b < 0 || (!gs.force && gains[x] > gains[b]) { b = x }
        }
        if b < 0 { break }
        taken[b] = true
        for p in at[b]..at[b] + ms[b] + 1 { used[p] = true }
        append(mut &picked, b)
        gain += gains[b]
    }
    if len(picked) == 0 || (!gs.force && !(total - gain < GRP_GAIN * total)) { return }
    for b in picked {
        grps[at[b]] = ms[b]
        for p in at[b]..at[b] + ms[b] + 1 { flags[p] = true }
    }
}

// What the exact search needs for build groups (optimizer 49): per level
// the levels a plain column equality links it to (eqAdj), the levels a
// conjunct that may fail reads with another (bad: in no group), per level
// a row's bytes in a hash; on: groups are tried.
type GrpSearch = record { on: bool; eqAdj: []int; bad: int; bytes: []float; force: bool }

fn (q: &Query) grpSearch(cs: &[]Expr, masks: &[]int, nl: int): GrpSearch {
    var gs = GrpSearch{on: true, eqAdj: array(nl, 0), bad: 0, bytes: [], force: false}
    for k in 0..nl { append(mut &gs.bytes, float(estRowBytes(&q.levels[k].t))) }
    for i in 0..len(cs) {
        let m = masks[i]
        if m < 0 {
            gs.on = false
            return gs
        }
        if (m & (m - 1)) == 0 { continue }          // one table's (or none)
        if !grpSafe(&cs[i]) { gs.bad = gs.bad | m }
        match cs[i] {
            Expr.Bin(op, a, b) {
                if op == "=" {
                    match a {
                        Expr.Col(x, _) {
                            match b {
                                Expr.Col(y, _) {
                                    let la = q.levelOf(&x)
                                    let lb = q.levelOf(&y)
                                    if la >= 0 && lb >= 0 && la != lb {
                                        gs.eqAdj[la] = gs.eqAdj[la] | (1 << lb)
                                        gs.eqAdj[lb] = gs.eqAdj[lb] | (1 << la)
                                    }
                                }
                                else {}
                            }
                        }
                        else {}
                    }
                }
            }
            else {}
        }
    }
    return gs
}

// The cost of build group (h, a, b) (b -1: none) joined to the set mask
// (optimizer 49.3): the hub read by its constants as a build's first table,
// each member hashed and probed by the build's rows so far, the build's
// rows hashed, then probed by the set's rows; -1 when a hash would pass cap,
// or when it costs no less than the same tables hashed left-deep with the
// hub's read priced alike (its gain must be the shape's: fewer probes, a
// smaller hash; not the batched read's price, which the left-deep hash's
// read does not get).
fn (q: &Query) grpCost(h: int, a: int, b: int, mask: int, nl: int, base: &[]Way, cmask: &[]int, cdist: &[]float, memo: mut &Map[int, float],
                       cap: float, bytes: &[]float, force: bool): float {
    let rin = q.setRows(mask, nl, base, cmask, cdist, memo)
    var pre = 1 << h
    var r = q.setRows(pre, nl, base, cmask, cdist, memo)
    var c = base[h].inner
    var rb = bytes[h]
    // left-deep: the hub hashed (its read as the group's), then each member
    var lr = q.setRows(mask | pre, nl, base, cmask, cdist, memo)
    var ld = base[h].inner + base[h].rows * HASH_BUILD + rin * HASH_PROBE + lr * ROW_COST
    for i in 0..2 {
        let m = if i == 0 { a } else { b }
        if m < 0 { break }
        if base[m].rows * bytes[m] > cap { return -1.0f }
        let nx = pre | (1 << m)
        let rn = q.setRows(nx, nl, base, cmask, cdist, memo)
        let build = base[m].inner + base[m].rows * HASH_BUILD
        c += build + r * HASH_PROBE + rn * ROW_COST
        let lr2 = q.setRows(mask | nx, nl, base, cmask, cdist, memo)
        ld += build + lr * HASH_PROBE + lr2 * ROW_COST
        lr = lr2
        pre = nx
        r = rn
        rb += bytes[m]
    }
    if r * rb > cap { return -1.0f }
    c += r * HASH_BUILD + rin * HASH_PROBE + lr * ROW_COST
    return if c < ld || force { c } else { -1.0f }
}

// Whether a SELECT reads all its rows before giving one: GROUP BY, an
// aggregate, DISTINCT, a window (optimizer 33).
pub fn stmtGathers(s: &lexdb_sql.Stmt): bool {
    if len(s.group) > 0 || len(s.gsets) > 0 || s.having.isSome() || s.distinct || len(s.distinctOn) > 0 || len(s.wins) > 0 { return true }
    for it in s.items { match it.expr { Some(x) { if lexdb_bind.hasAgg(&x) { return true } } None {} } }
    return false
}

// A LIMIT's (or OFFSET's) rows for the join order: a literal's value, else
// (a parameter, an expression) 100; none 0.
pub fn limitGuess(x: &Option[Expr]): int {
    match x {
        Some(e) {
            match e {
                Expr.Lit(v) {
                    match v {
                        Val.Int(n) { return if n < 0 { 0 } else { n } }
                        else { return 100 }
                    }
                }
                else { return 100 }
            }
        }
        None { return 0 }
    }
}

// The level whose rows an ORDER BY sorts by, all its items plain columns of
// that one table in one direction (NULLs where an index keeps them), and a
// key or an unfiltered index of it giving that order: its index; else -1.
fn (q: &Query) orderedLevel(items: &[]lexdb_sql.OrderItem, out: mut &[]int): int {
    if len(items) == 0 { return -1 }
    var lv = -1
    var cols: []int = []
    for it in items {
        if it.desc != items[0].desc || it.nullsFirst != it.desc { return -1 }
        match it.expr {
            Expr.Col(n, _) {
                match lexdb_bind.resolveName(&q.cols, len(q.cols), &n) {
                    Ok(ci) {
                        let l = q.levelOf(&q.cols[ci].name)
                        if l < 0 || (lv >= 0 && l != lv) { return -1 }
                        lv = l
                        append(mut &cols, ci - q.levels[l].first)
                    }
                    Err(_) { return -1 }
                }
            }
            else { return -1 }
        }
    }
    if q.levels[lv].virt() { return -1 }
    let t = &q.levels[lv].t
    for c0 in 0..len(t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && t.indexes[c].pred.isSome() { continue }
        let p = Path{index: c, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0, sorted: false}
        if servesOrder(t, &p, &cols) {
            for x in cols { append(out, x) }
            return lv
        }
    }
    return -1
}

// A table of nothing (a level's place while levels are moved).
fn noTable(): Table {
    return Table{name: "", tree: -1, cols: [], pk: [], indexes: [], slots: [], width: 0, checks: [], fks: [], refBy: [], layouts: [], lays: [],
                 view: "", deps: [], rn: [], onCommit: 0, spell: "", pkName: "", invalid: []}
}

// Whether a table is pinned to one row by its key's equalities with
// constants or parameters (optimizer 35), and the order bound by keys from
// it reaches every other table by a key or an index of the tables before
// (optimizer 39): a pinned row that binds nothing else (a settings row) says
// nothing about how to read the rest, which costing decides. The order (old
// indexes, every level) when it is so, else [].
fn (q: &Query) pinnedOrder(ms: &[][]Expr): []int {
    if !q.innerOnly() { return [] }
    let nl = len(q.levels)
    var cs: []Expr = []
    for m in ms { for c in m { append(mut &cs, lexdb_sql.cloneExpr(&c)) } }
    var placed: []bool = array(nl, false)
    var start = -1
    for k in 0..nl { if start < 0 && q.bindOf(k, &cs, &placed) == 3 { start = k } }
    if start < 0 { return [] }
    placed[start] = true
    var out: []int = [start]
    for n in 1..nl {
        var best = -1
        var bb = -1
        for k in 0..nl {
            if placed[k] { continue }
            let b = q.bindOf(k, &cs, &placed)
            if b > bb {
                bb = b
                best = k
            }
        }
        // a subquery's rows have no key: read once, wherever they go
        if bb < 2 && !q.levels[best].virt() { return [] }
        placed[best] = true
        append(mut &out, best)
    }
    return out
}

// Whether every join is inner and none LATERAL: its tables may run in any
// order, and its equalities imply others.
fn (q: &Query) innerOnly(): bool {
    for lv in q.levels { if isOuter(lv.join) || lv.lateral { return false } }
    return true
}

// The new order of q's levels (old indexes), [] when FROM's stands. ms: the
// conjuncts placed so far, per level.
fn (q: &Query) joinOrder(ms: &[][]Expr): []int {
    let nl = len(q.levels)
    if !q.innerOnly() { return [] }
    var cs: []Expr = []
    for m in ms { for c in m { append(mut &cs, lexdb_sql.cloneExpr(&c)) } }
    var placed: []bool = array(nl, false)
    var start = -1
    for k in 0..nl { if start < 0 && q.bindOf(k, &cs, &placed) == 3 { start = k } }
    if start < 0 { return [] }
    var out: []int = [start]
    placed[start] = true
    while len(out) < nl {
        var best = -1
        var bb = -1
        for k in 0..nl {
            if placed[k] { continue }
            let b = q.bindOf(k, &cs, &placed)
            if b > bb {
                bb = b
                best = k
            }
        }
        placed[best] = true
        append(mut &out, best)
    }
    for i in 0..nl { if out[i] != i { return out } }
    return []
}

// How the conjuncts cs bind level k's rows to the placed levels' (or to
// constants and parameters): 3 a unique key (the primary key or a unique
// index, not filtered) all equal: a row at most; 2 the leading column of a
// key or an index equal: a lookup; 1 another column equal: a hash join; 0
// none.
fn (q: &Query) bindOf(k: int, cs: &[]Expr, placed: &[]bool): int {
    let lv = &q.levels[k]
    var got = 0
    for ci in 0..len(lv.t.cols) {
        if got == 0 && q.eqBound(cs, &(lv.alias + "." + lv.t.cols[ci].name), k, placed) { got = 1 }
    }
    if lv.virt() { return got }
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if c >= 0 && lv.t.indexes[c].pred.isSome() { continue }
        let cols = keyCols(&lv.t, c)
        var n = 0
        for ci in cols {
            if ci < 0 || !q.eqBound(cs, &(lv.alias + "." + lv.t.cols[ci].name), k, placed) { break }
            n += 1
        }
        if n > 0 && n == len(cols) && (c < 0 || lv.t.indexes[c].unique) { return 3 }
        if n > 0 { got = 2 }
    }
    return got
}

// Whether a conjunct makes column name (level k's) equal to a value of the
// placed levels only, or of none.
fn (q: &Query) eqBound(cs: &[]Expr, name: &str, k: int, placed: &[]bool): bool {
    for c in cs {
        match c {
            Expr.Bin(op, a, b) {
                if op == "=" {
                    match a { Expr.Col(x, _) { if x == name && q.onlyPlaced(&b, k, placed) { return true } } else {} }
                    match b { Expr.Col(x, _) { if x == name && q.onlyPlaced(&a, k, placed) { return true } } else {} }
                }
            }
            else {}
        }
    }
    return false
}

fn (q: &Query) onlyPlaced(x: &Expr, k: int, placed: &[]bool): bool {
    if hasCorr(x) { return false }
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    for n in ns {
        let l = q.levelOf(&n)
        if l < 0 || l == k || !placed[l] { return false }
    }
    return true
}

// The rules (4.8): the whole primary key equal; then a unique index whose
// columns are all equal; then the most leading equalities, then a range on
// the next column; the primary key wins a tie. Nothing: a full scan.
//
// With ANALYZE's statistics (optimizer 24) the estimates decide between the
// candidates, not only their ties: the fewest reads (figCost) wins, a tie by
// the rules' order. The rules still decide
// - a whole-key equality on the primary key or a unique index (one row);
// - when the rules' choice has no figure (an index ANALYZE has not seen);
// and estimates compare only candidates of the rules' choice's kind: looked
// up per row of the tables before (its values come from them), or read once
// (a hash join); comparing those needs the rows before, which is join
// ordering's work. A candidate without a figure takes no part.
fn choosePath(q: &Query, k: int, cs: &[]Expr, params: &[]Val, lk: mut &[]Look): Path {
    let lv = &q.levels[k]
    var paths: []Path = []
    var scores: []int = []
    var figs: []Fig = []
    var outer: []bool = []
    var looks: []Look = []              // per candidate: its estimate's look if a parameter set it (optimizer 23); kind -1 none
    var best = -1
    for c0 in 0..len(lv.t.indexes) + 1 {
        let c = c0 - 1
        if !q.usable(k, c, cs, params, lk) { continue }
        let cols = keyCols(&lv.t, c)
        var eqs: []Expr = []
        var rng: []Bound = []
        var ins: []Expr = []
        var inSub = -1
        var inArr: []Expr = []
        var feqs: []Expr = []           // from a pinned row: the equalities for the figure
        var fdiff = false
        for pos in 0..len(cols) {
            let ci = cols[pos]
            let ck = if ci >= 0 { lexdb_access.colCollKind(&lv.t.cols[ci]) } else { lexdb_sql.COLL_EXACT }
            let virt = lv.gen && ci >= 0 && lv.t.cols[ci].genKind == lexdb_sql.GEN_VIRTUAL
            if ci < 0 || ck != lexdb_sql.COLL_EXACT || virt {
                // an expression's (9.89): the conditions on the same
                // expression; a column under a collation's keys (L2): the
                // conditions on its key, #ci(col) or #pad(col); a virtual
                // column (lexdb_gen): on its expression, which is what a
                // reference to it means in the query
                let target = if ci < 0 { qualified(&lv.t.indexes[c].exprs[pos], &lv.alias) }
                             else if virt { lexdb_bind.colAt(&q.cols, lv.first + ci) }
                             else { lexdb_bind.collKeyOf(ck, Expr.Col(lv.alias + "." + lv.t.cols[ci].name, -1)) }
                var xb = q.onceBounds(exprBounds(cs, &target, k, q), lv.readOnce)
                var xeq = -1
                for i in 0..len(xb) { if xb[i].op == "=" && xeq < 0 { xeq = i } }
                if xeq < 0 {
                    rng = xb
                    break
                }
                if q.pinned { append(mut &feqs, lexdb_sql.cloneExpr(&xb[xeq].val)) }
                append(mut &eqs, replace(mut &xb[xeq].val, Expr.Lit(Val.Null)))
                continue
            }
            let name = lv.alias + "." + lv.t.cols[ci].name
            var bs = q.onceBounds(bounds(cs, &name, k, q), lv.readOnce)
            var eqAt = -1
            // a constant's equality first where they are implied (optimizer
            // 27): the same for every row of the tables before, so the table
            // can be read once
            if q.implied {
                for i in 0..len(bs) { if bs[i].op == "=" && eqAt < 0 && q.maxLevel(&bs[i].val) < 0 && !hasCorr(&bs[i].val) { eqAt = i } }
            }
            // from a pinned row, the lookup per row (one row): an outer
            // value's equality before a constant's (optimizer 35)
            if q.pinned {
                for i in 0..len(bs) { if bs[i].op == "=" && eqAt < 0 && q.maxLevel(&bs[i].val) >= 0 { eqAt = i } }
            }
            for i in 0..len(bs) { if bs[i].op == "=" && eqAt < 0 { eqAt = i } }
            if eqAt < 0 {
                ins = inList(cs, &name, k, q)
                if lv.readOnce && q.anyOuter(&ins) { ins = [] }
                if len(ins) == 0 { inSub = inSubOf(cs, &name) }
                if len(ins) == 0 && inSub < 0 { inArr = anyOf(cs, &name, k, q) }
                if lv.readOnce && q.anyOuter(&inArr) { inArr = [] }
                if len(ins) == 0 && inSub < 0 && len(inArr) == 0 { rng = bs }
                break
            }
            if q.pinned {
                // the figure by the constant the outer value equals (it is
                // implied: the same rows), not the average (optimizer 39)
                var kAt = -1
                for i in 0..len(bs) { if bs[i].op == "=" && kAt < 0 && q.maxLevel(&bs[i].val) < 0 && !hasCorr(&bs[i].val) { kAt = i } }
                if kAt >= 0 && kAt != eqAt { fdiff = true }
                append(mut &feqs, lexdb_sql.cloneExpr(&bs[if kAt >= 0 { kAt } else { eqAt }].val))
            }
            append(mut &eqs, replace(mut &bs[eqAt].val, Expr.Lit(Val.Null)))
        }
        // an IN list counts as an equality; the full key by one is a lookup per value
        let hasIn = len(ins) > 0 || inSub >= 0 || len(inArr) > 0
        var score = 2 * (len(eqs) + (if hasIn { 1 } else { 0 })) + (if len(rng) > 0 { 1 } else { 0 })
        if c >= 0 && lv.t.indexes[c].pred.isSome() { score += 1 }      // filtered: fewer rows
        if len(eqs) == len(cols) {
            if c < 0 { score = 1000 } else if lv.t.indexes[c].unique { score = 999 }
        } else if hasIn && len(eqs) + 1 == len(cols) {
            if c < 0 { score = 500 } else if lv.t.indexes[c].unique { score = 499 }
        }
        if score == 0 { continue }
        var p = Path{index: c, eqs: eqs, rng: rng, desc: false, noNulls: false, ins: ins, inSub: inSub, inArr: inArr, stats: false, inMax: 0, sorted: false}
        if lv.readOnce && q.pathOuter(&p) { continue }          // read once (optimizer 26)
        let po = q.pathOuter(&p)
        var saved: []Expr = []
        if fdiff { saved = replace(mut &p.eqs, feqs) }
        let f = pathFig(lv, &p, params)
        // The first table's pure range, if the samples estimate it as
        // costing more than a scan (scanFirst: read in key order, optimizer
        // 47, over about 1/24 of the table), is read as a scan: skip it.
        // (A later table's range is a hash build, read once: q10's orders
        // range of 3.8% is 57k rows to build from and 1.5M to scan.) A
        // range they estimate as narrower is the planner's index (stats: the
        // executor must not count it again). No sample: the counted switch
        // decides at run time; a per-row (correlated) range keeps its index.
        if !q.pinned && k == 0 && c >= 0 && lv.est.rows >= SCAN_MIN_ROWS &&
           len(p.eqs) == 0 && len(p.rng) > 0 && len(cols) > 0 && cols[0] >= 0 &&
           f.rows >= 0 && !f.bound && lv.est.rows > 0 && !ixCovers(lv, c) {
            if scanFirst(f.rows, lv.est.rows) { continue }
            p.stats = true
        }
        // the calibration's forced modes: the first table's pure range by
        // its index whatever its size (no counted switch)
        if forcedIndex() && k == 0 && c >= 0 && len(p.eqs) == 0 && len(p.rng) > 0 && !ixCovers(lv, c) { p.stats = true }
        // the first equality's value set the figure: a look (optimizer 23)
        var lo = Look{kind: -1, c: Expr.Lit(Val.Null), p: Expr.Lit(Val.Null), out: 0, typ: noType(), cm: lexdb_stats.noCommon()}
        if f.rows >= 0 && len(p.eqs) >= 1 && !hasIn && score < 999 {
            let byParam = lexdb_bind.refParam(&p.eqs[0])
            if byParam && len(p.eqs) == 1 {
                let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
                let typ = keyType(&lv.t, c, 0)
                lo = Look{kind: 2, c: lexdb_sql.cloneExpr(&p.eqs[0]), p: Expr.Lit(Val.Null), out: scaleOf(f.rows), typ: typ, cm: lv.est.commonOf(tree)}
            }
        }
        if fdiff { p.eqs = saved }
        // x IN (subquery) on the first table: a lookup per value costs a
        // descent and the value's rows; past the values where those cost
        // more than reading the table once, the table is read whole
        // (pathScans). q20's 2,127 part keys into partsupp's 800,000 rows
        // were over the old fixed IN_LOOKUP_MAX.
        if inSub >= 0 && k == 0 && lv.est.rows > 0 {
            let tree = if c < 0 { lv.t.tree } else { lv.t.indexes[c].tree }
            let r = lv.est.rowsFor(tree, len(p.eqs) + 1, &"")
            if r >= 0 {
                let one = COST_DESCENT + float(r) * (if c < 0 { COST_PK_RANGE } else { COST_IX_ROW })
                let most = float(lv.est.rows) * COST_SCAN / one
                p.inMax = if most > 1000000000.0f { 1000000000 } else { int(most) }
            }
        }
        append(mut &outer, po)
        append(mut &paths, p)
        append(mut &scores, score)
        append(mut &figs, f)
        append(mut &looks, lo)
        if best < 0 || score > scores[best] { best = len(scores) - 1 }
    }
    if best < 0 { return Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0, sorted: false} }
    var pick = best
    if scores[best] < 999 && figs[best].rows >= 0 {
        var pc = figCost(&figs[best], paths[best].index, k == 0)
        var group = 0
        for i in 0..len(paths) {
            // from a pinned row the tables before give one row, or rows of
            // the same values: per row or read once compare (optimizer 39)
            if (outer[i] != outer[best] && !q.pinned) || figs[i].rows < 0 { continue }
            group += 1
            let ci = figCost(&figs[i], paths[i].index, k == 0)
            if ci < pc || (ci == pc && scores[i] > scores[pick]) {
                pick = i
                pc = ci
            }
        }
        // a parameter's value set a figure that was compared: the plan is kept
        // for values of the same scale
        if group >= 2 {
            for i in 0..len(paths) {
                if (outer[i] == outer[best] || q.pinned) && figs[i].rows >= 0 && looks[i].kind == 2 {
                    append(lk, replace(mut &looks[i], Look{kind: -1, c: Expr.Lit(Val.Null), p: Expr.Lit(Val.Null), out: 0, typ: noType(), cm: lexdb_stats.noCommon()}))
                }
            }
        }
    }
    return replace(mut &paths[pick], Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0, sorted: false})
}

// A level read once (a hash join, optimizer 26) takes only the bounds whose
// values are the same for every row of the tables before: a constant
// equality or range is kept, an outer value's dropped, rather than the
// whole path (optimizer 33).
fn (q: &Query) onceBounds(bs: []Bound, readOnce: bool): []Bound {
    if !readOnce { return bs }
    var out: []Bound = []
    var all = bs
    for i in 0..len(all) {
        if q.maxLevel(&all[i].val) < 0 && !hasCorr(&all[i].val) {
            append(mut &out, Bound{op: replace(mut &all[i].op, ""), val: replace(mut &all[i].val, Expr.Lit(Val.Null))})
        }
    }
    return out
}

fn (q: &Query) anyOuter(xs: &[]Expr): bool {
    for x in xs { if q.maxLevel(&x) >= 0 || hasCorr(&x) { return true } }
    return false
}

// Whether the path's values change from row to row of the tables before
// it: they use those tables, or a correlated subquery (run per row).
fn (q: &Query) pathOuter(p: &Path): bool {
    for x in p.eqs { if q.maxLevel(&x) >= 0 { return true } }
    for x in p.ins { if q.maxLevel(&x) >= 0 { return true } }
    for b in p.rng { if q.maxLevel(&b.val) >= 0 { return true } }
    for x in p.inArr { if q.maxLevel(&x) >= 0 { return true } }
    return q.corr && pathCorr(p)
}

pub fn pathCorr(p: &Path): bool {
    for x in p.eqs { if hasCorr(&x) { return true } }
    for x in p.ins { if hasCorr(&x) { return true } }
    for b in p.rng { if hasCorr(&b.val) { return true } }
    for x in p.inArr { if hasCorr(&x) { return true } }
    return false
}

// The keys a path covers, its values evaluated now.
// A column's type for its bounds: a value too long for varchar(n) is not
// an error there, it only matches nothing.
pub fn boundType(t: &lexdb_sql.TypeName): lexdb_sql.TypeName {
    return lexdb_sql.TypeName{kind: t.kind, oid: t.oid, prec: t.prec, scale: t.scale, len: 0}
}

pub fn newLevel(t: rc Table, alias: &str, join: int, first: int): Level {
    return Level{t: t, alias: alias.clone(), join: join, first: first, path: Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0, sorted: false}, cond: [],
                 post: [], local: [], perRow: true, hashCols: [], hashVals: [], hashKinds: [], hashInt: false, src: -1, work: -1, lateral: false, gen: lexdb_gen.anyVirtual(&t.cols), need: [],
                 lock: 0, lockWait: 0, keeps: false, est: lexdb_stats.noEst(), stops: false, estRows: -1, estMax: false, readOnce: false, semi: false, anti: false, resNot: false, resCol: -1, resVal: Expr.Lit(Val.Null), semiSub: -1, grp: 0, mode: 0, ors: []}
}

// Marks in cand the subqueries of x's top-level conjuncts (conjuncts')
// that are x IN (subquery) or EXISTS (subquery), as parsed (semiParsed);
// whether any. (Read in place: a WHERE is not copied for it.)
pub fn semiCands(x: &Expr, cand: mut &[]bool): bool {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" {
                let l = semiCands(&a, cand)
                let r = semiCands(&b, cand)
                return l || r
            }
        }
        else {}
    }
    let i = semiParsed(x)
    if i >= 0 && i < len(cand) {
        cand[i] = true
        return true
    }
    return false
}

// The hints planSelect left on the Scope for this query, taken by
// buildQuery before anything is planned (its subqueries set their own).
pub type FromHints = record {
    pub early: bool                 // Scope.early
    pub locking: bool               // Scope.locking
    pub ordBy: []lexdb_sql.OrderItem  // Scope.ordBy
    pub ordLim: int                 // Scope.ordLim
    pub rules: bool                 // SET lexdb_planner = rules: no costs (the statement's, optimizer 20)
    pub memMax: int                 // the statement's memory limit (a hash holds at most half); 0 none
    pub semiCand: []bool            // per subquery: a semi-join's (WHERE's top-level x IN (subquery), EXISTS (subquery), 9.104)
    pub anySemi: bool
}

// What bindFrom found beside the Query.
pub type FromBound = record {
    pub anyUsing: bool              // a JOIN ... USING or NATURAL JOIN (*'s order in ColDef.pos)
    pub where: bool                 // Query.lp's top is WHERE's Filter
}

// A view's query as bindFrom planned it (SubPlan.view, for pushDown): the
// query, its owner (the role its relations are read as; "" the session's)
// and its renames (Table.rn).
pub type ViewSrc = record { pub stmt: lexdb_sql.Stmt; pub owner: str; pub rn: []str }

// The ON conjuncts of q.lp's FROM part, per level (ms[k]: the k-th
// left-deep Join's), and WHERE's (where: q.lp's top is its Filter), as
// bindFrom left them; conjuncts copies them.
fn fromConds(p: &lexdb_bind.LPlan, where: bool, ms: mut &[][]Expr, cs: mut &[]Expr) {
    if where {
        match p {
            lexdb_bind.LPlan.Filter(i, w, _) {
                let n = onConds(&i, ms)
                for x in w { conjuncts(&x, cs) }
                return
            }
            else {}
        }
    }
    let n = onConds(p, ms)
}

// The levels in p, its Joins' ON conjuncts into ms by level.
fn onConds(p: &lexdb_bind.LPlan, ms: mut &[][]Expr): int {
    match p {
        lexdb_bind.LPlan.Join(_, _, l, _, on, _) {
            let k = onConds(&l, ms)
            if k < len(ms) { for x in on { conjuncts(&x, mut &ms[k]) } }
            return k + 1
        }
        lexdb_bind.LPlan.Filter(_, on, _) {
            // a first item's ON (bindFrom)
            if len(ms) > 0 { for x in on { conjuncts(&x, mut &ms[0]) } }
            return 1
        }
        else {}
    }
    return 1
}

// ---- rewrites that keep results (optimizer 48): outer joins made inner,
// WHERE's conjuncts pushed into derived tables, views and CTEs used once

pub const RW_OUTER: int = 1     // outer-to-inner join conversion (48.2)
pub const RW_PUSH: int = 2      // pushdown into a derived level's query (48.3)

var rewriteMode: int = RW_OUTER | RW_PUSH

// Which of the rewrites the cost planner makes (the tests' and a
// measurement's switch; SET lexdb_planner = rules makes neither).
pub fn setRewrites(mode: int) { rewriteMode = mode }

// The binary operators NULL in, NULL out.
fn strictOp(op: &str): bool {
    return op == "=" || op == "<>" || op == "<" || op == "<=" || op == ">" || op == ">=" ||
           op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
}

// The calls that are NULL when their first argument is (and that the
// binder adds around a compared value: collation keys, char trimming).
fn strictCall(f: &str): bool {
    return f == "in" || f == "like" || f == "ilike" || f == "#tlike" || f == "similar" || f == "~" || f == "!~" ||
           f == "~*" || f == "!~*" || f == "#ci" || f == "#pad" || f == "#bptrim" || f == "#tdiv" || f == "lower" ||
           f == "upper" || f == "length" || f == "char_length" || f == "substring" || f == "substr" || f == "btrim" ||
           f == "trim" || f == "ltrim" || f == "rtrim" || f == "abs" || f == "date_trunc" || f == "extract" || f == "date_part"
}

// Whether x is NULL whenever every column of the levels in mask is NULL.
fn (q: &Query) nullOn(x: &Expr, mask: int): bool {
    match x {
        Expr.Col(n, _) {
            let l = q.levelOf(&n)
            return l >= 0 && (mask & (1 << l)) != 0
        }
        Expr.Lit(v) {
            match v {
                Val.Null { return true }
                else { return false }
            }
        }
        Expr.Unary(op, a) { return (op == "-" || op == "not") && q.nullOn(&a, mask) }
        Expr.Bin(op, a, b) { return strictOp(&op) && (q.nullOn(&a, mask) || q.nullOn(&b, mask)) }
        Expr.Cast(a, _) { return q.nullOn(&a, mask) }
        Expr.Call(f, args, star) { return !star && len(args) > 0 && strictCall(&f) && q.nullOn(&args[0], mask) }
        else { return false }
    }
}

// Whether conjunct x is never true on a row whose columns of the levels in
// mask are all NULL: it rejects their NULL-extended rows (48.2).
fn (q: &Query) rejectsNulls(x: &Expr, mask: int): bool {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" { return q.rejectsNulls(&a, mask) || q.rejectsNulls(&b, mask) }
            if op == "or" { return q.rejectsNulls(&a, mask) && q.rejectsNulls(&b, mask) }
        }
        Expr.IsNull(a, neg) { return neg && q.nullOn(&a, mask) }
        Expr.Unary(op, a) {
            if op == "not" {
                match a {
                    Expr.IsNull(b, neg) { return !neg && q.nullOn(&b, mask) }
                    else {}
                }
            }
        }
        else {}
    }
    return q.nullOn(x, mask)
}

// Whether a conjunct above level j's join rejects the NULLs of the levels
// in mask: one of WHERE's (cs), or of the ON of a later level whose join
// drops rows of the levels before it (inner, cross, RIGHT).
fn (q: &Query) rejectedAbove(j: int, mask: int, ms: &[][]Expr, cs: &[]Expr): bool {
    for c in cs { if q.rejectsNulls(&c, mask) { return true } }
    for m in j + 1..len(q.levels) {
        if keepsLeft(q.levels[m].join) { continue }
        for c in ms[m] { if q.rejectsNulls(&c, mask) { return true } }
    }
    return false
}

// Outer joins made inner (48.2), the last first: a LEFT JOIN whose NULL
// rows a conjunct above it rejects, a RIGHT JOIN whose rows of the tables
// before it are rejected; a FULL JOIN loses the side whose rows are.
fn (q: mut &Query) innerJoins(ms: &[][]Expr, cs: &[]Expr) {
    let nl = len(q.levels)
    if nl > 62 { return }
    for i in 1..nl {
        let j = nl - i
        let jn = q.levels[j].join
        if !isOuter(jn) { continue }
        let rightGone = keepsLeft(jn) && q.rejectedAbove(j, 1 << j, ms, cs)
        let leftGone = keepsRight(jn) && q.rejectedAbove(j, (1 << j) - 1, ms, cs)
        var to = jn
        if jn == lexdb_sql.J_LEFT {
            if rightGone { to = lexdb_sql.J_INNER }
        } else if jn == lexdb_sql.J_RIGHT {
            if leftGone { to = lexdb_sql.J_INNER }
        } else if rightGone && leftGone {
            to = lexdb_sql.J_INNER
        } else if leftGone {
            to = lexdb_sql.J_LEFT
        } else if rightGone {
            to = lexdb_sql.J_RIGHT
        }
        q.levels[j].join = to
    }
}

// Whether x has what a pushed filter must not carry or change the calls of
// (48.3): a subquery, a window, a volatile function (random, a sequence's,
// an advisory lock's, gen_random_uuid, clock_timestamp), a user's function.
fn unpushable(x: &Expr): bool {
    match x {
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) || n == "#win" || n == "#udf" || n == "#plf" || lexdb_bind.isSeqFn(&n) || lexdb_bind.isAdvFn(&n) ||
               n == "gen_random_uuid" || n == "random" || n == "setseed" || n == "clock_timestamp" { return true }
            for a in args { if unpushable(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return unpushable(&a) }
        Expr.Bin(_, a, b) { return unpushable(&a) || unpushable(&b) }
        Expr.IsNull(a, _) { return unpushable(&a) }
        Expr.Cast(a, _) { return unpushable(&a) }
        else { return false }
    }
}

// Whether a filter on the rows of query s (planned as sel) may go into it
// (48.3): no LIMIT, OFFSET, TOP, window, DISTINCT ON, grouping sets, FOR
// UPDATE, function scan, nothing volatile or set-returning in its select
// list; a set operation's parts each, their columns not converted.
fn pushable(s: &lexdb_sql.Stmt, sel: &Sel): bool {
    if s.kind != lexdb_sql.S_SELECT || s.limit.isSome() || s.offset.isSome() || s.topMode != 0 || s.withTies ||
       len(s.distinctOn) > 0 || len(s.wins) > 0 || len(s.srf) > 0 || len(s.mr) > 0 || s.lockMode != 0 || len(s.assign) > 0 ||
       len(s.gsets) > 0 || s.rec || s.waitFor || len(s.into) > 0 || len(sel.mr) > 0 || len(sel.wins) > 0 {
        return false
    }
    if s.setop != 0 {
        if len(s.inner) != 2 || len(sel.parts) != 2 { return false }
        for c in sel.conv { if c != 0 { return false } }
        return pushable(&s.inner[0], &sel.parts[0]) && pushable(&s.inner[1], &sel.parts[1])
    }
    for it in s.items {
        match it.expr {
            Some(x) { if unpushable(&x) || srfIn(&x) { return false } }
            None {}
        }
    }
    for x in sel.exprs { if unpushable(&x) || srfIn(&x) { return false } }
    for sp in sel.specs { for a in sp.args { if unpushable(&a) { return false } } }
    return true
}

// Output column j of query s (planned as sel) in s's own terms, as
// written: its select item's expression, or beside a * a plain column by
// its qualified name; None for anything else.
fn outAst(s: &lexdb_sql.Stmt, sel: &Sel, j: int): Option[Expr] {
    var star = false
    for it in s.items { if it.star { star = true } }
    if !star {
        if len(s.items) != len(sel.outs) || j >= len(s.items) { return None }
        match s.items[j].expr {
            Some(x) { return Some(lexdb_sql.cloneExpr(&x)) }
            None { return None }
        }
    }
    if j >= len(sel.exprs) || j >= len(sel.outs) { return None }
    match sel.exprs[j] {
        Expr.Col(n, slot) {
            if strings.contains(&n, lexdb_bind.DUPSEP) { return None }
            if slot >= 0 && slot < len(sel.q.cols) && len(sel.q.cols[slot].using) > 0 { return None }
            return Some(Expr.Col(n.clone(), -1))
        }
        else { return None }
    }
}

// x, a WHERE conjunct as written, with each column of level l as a
// placeholder for the derived query's column: Col("", j). None when a name
// is not one of l's columns (or not this query's alone).
fn (q: &Query) toOuts(x: &Expr, l: int): Option[Expr] {
    match x {
        Expr.Col(n, _) {
            match lexdb_bind.resolveName(&q.cols, len(q.cols), &n) {
                Ok(i) {
                    let f = q.levels[l].first
                    if i < f || i >= f + len(q.levels[l].t.cols) || len(q.cols[i].using) > 0 { return None }
                    return Some(Expr.Col("", i - f))
                }
                Err(_) { return None }
            }
        }
        Expr.Lit(_) { return Some(lexdb_sql.cloneExpr(x)) }
        Expr.Param(_) { return Some(lexdb_sql.cloneExpr(x)) }
        Expr.Unary(op, a) {
            match q.toOuts(&a, l) {
                Some(y) { return Some(Expr.Unary(op.clone(), y)) }
                None { return None }
            }
        }
        Expr.Bin(op, a, b) {
            let ya = q.toOuts(&a, l)
            let yb = q.toOuts(&b, l)
            if ya.isNone() || yb.isNone() { return None }
            return Some(Expr.Bin(op.clone(), ya.unwrap(), yb.unwrap()))
        }
        Expr.IsNull(a, neg) {
            match q.toOuts(&a, l) {
                Some(y) { return Some(Expr.IsNull(y, neg)) }
                None { return None }
            }
        }
        Expr.Cast(a, t) {
            match q.toOuts(&a, l) {
                Some(y) { return Some(Expr.Cast(y, t)) }
                None { return None }
            }
        }
        Expr.Call(f, args, star) {
            if lexdb_sql.isSubCall(&f) || f == "#win" { return None }
            var ys: []Expr = []
            for a in args {
                match q.toOuts(&a, l) {
                    Some(y) { append(mut &ys, y) }
                    None { return None }
                }
            }
            return Some(Expr.Call(f.clone(), ys, star))
        }
    }
}

// t (toOuts') with each placeholder replaced by query s's column (outAst).
fn fillOuts(t: &Expr, s: &lexdb_sql.Stmt, sel: &Sel): Option[Expr] {
    match t {
        Expr.Col(n, j) {
            if len(n) == 0 { return outAst(s, sel, j) }
            return Some(lexdb_sql.cloneExpr(t))
        }
        Expr.Unary(op, a) {
            match fillOuts(&a, s, sel) {
                Some(y) { return Some(Expr.Unary(op.clone(), y)) }
                None { return None }
            }
        }
        Expr.Bin(op, a, b) {
            let ya = fillOuts(&a, s, sel)
            let yb = fillOuts(&b, s, sel)
            if ya.isNone() || yb.isNone() { return None }
            return Some(Expr.Bin(op.clone(), ya.unwrap(), yb.unwrap()))
        }
        Expr.IsNull(a, neg) {
            match fillOuts(&a, s, sel) {
                Some(y) { return Some(Expr.IsNull(y, neg)) }
                None { return None }
            }
        }
        Expr.Cast(a, ty) {
            match fillOuts(&a, s, sel) {
                Some(y) { return Some(Expr.Cast(y, ty)) }
                None { return None }
            }
        }
        Expr.Call(f, args, star) {
            var ys: []Expr = []
            for a in args {
                match fillOuts(&a, s, sel) {
                    Some(y) { append(mut &ys, y) }
                    None { return None }
                }
            }
            return Some(Expr.Call(f.clone(), ys, star))
        }
        else { return Some(lexdb_sql.cloneExpr(t)) }
    }
}

fn andAfter(x: &Option[Expr], y: Expr): Expr {
    match x {
        Some(a) { return Expr.Bin("and", lexdb_sql.cloneExpr(&a), y) }
        None { return y }
    }
}

// Filter t (toOuts') put into query s (planned as sel): into its WHERE,
// or with an aggregate, or over an aggregate without GROUP BY, into its
// HAVING; a set operation's into each part. False when a column is not
// one outAst can write (s is then partly changed: the caller's copy).
fn intoQuery(s: mut &lexdb_sql.Stmt, sel: &Sel, t: &Expr): bool {
    if s.setop != 0 { return intoQuery(mut &s.inner[0], &sel.parts[0], t) && intoQuery(mut &s.inner[1], &sel.parts[1], t) }
    match fillOuts(t, s, sel) {
        Some(x) {
            let having = if len(s.group) > 0 { lexdb_bind.hasAgg(&x) } else { sel.aggQ }
            if having { s.having = Some(andAfter(&s.having, x)) } else { s.where = Some(andAfter(&s.where, x)) }
            return true
        }
        None { return false }
    }
}

// Whether two plans of a query give the same columns.
fn sameOuts(a: &Sel, b: &Sel): bool {
    if len(a.outs) != len(b.outs) { return false }
    for i in 0..len(a.outs) { if a.outs[i].oid != b.outs[i].oid { return false } }
    return true
}

// Predicate pushdown (48.3): each WHERE conjunct that reads one derived
// level's columns only (a FROM subquery, a view, a CTE used once), not on
// an outer join's nullable side, goes into its query as written (each
// column as the query's expression for it), and the query is planned
// again as bindFrom planned it; the conjuncts pushed leave cs. where:
// WHERE as written (its conjuncts after pullCommonOr, as bindFrom's).
fn pushDown(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, where: &Option[Expr], subs: &[]lexdb_sql.Stmt,
            params: &[]Val, sc: mut &Scope, cs: mut &[]Expr): Result[Unit, DbErr] {
    var uc: []Expr = []
    match where {
        Some(w0) { conjuncts(&pullCommonOr(w0), mut &uc) }
        None { return Ok(Unit{}) }
    }
    let nl = len(q.levels)
    if len(uc) != len(cs) || nl > 62 { return Ok(Unit{}) }
    var lastRight = -1
    for k in 0..nl { if keepsRight(q.levels[k].join) { lastRight = k } }
    var gone: []bool = array(len(cs), false)
    var any = false
    for l in 0..nl {
        let src = q.levels[l].src
        if src < 0 || src >= len(q.subs) || q.levels[l].lateral || q.levels[l].work >= 0 || q.subs[src].hashed { continue }
        // not an outer join's nullable side
        if (l > 0 && keepsLeft(q.levels[l].join)) || l < lastRight { continue }
        let view = src >= len(subs)
        if view && q.subs[src].view.isNone() { continue }
        let vs = if view { replace(mut &q.subs[src].view, None).unwrap() } else { ViewSrc{stmt: lexdb_sql.newStmt(0), owner: "", rn: []} }
        let s0 = if view { &vs.stmt } else { &subs[src] }
        if (s0.cte >= 0 && !s0.cteOnce) || !pushable(s0, &q.subs[src].sel) { continue }
        var s = s0.clone()
        s.cte = -1
        var took: []int = []
        for i in 0..len(cs) {
            if gone[i] || q.levelMask(&cs[i]) != (1 << l) || unpushable(&cs[i]) { continue }
            match q.toOuts(&uc[i], l) {
                Some(t) {
                    var s2 = s.clone()
                    if intoQuery(mut &s2, &q.subs[src].sel, &t) {
                        s = s2
                        append(mut &took, i)
                    }
                }
                None {}
            }
        }
        if len(took) == 0 { continue }
        // planned again as bindFrom did: this query's columns hidden; a
        // view's relations read as its owner, its text's names renamed
        let top = len(sc.names.frames) - 1
        let nf = len(sc.names.frames)
        sc.names.frames[top].hidden = true
        let owner = vs.owner.clone()
        if len(owner) > 0 { append(mut &sc.asRole, owner.clone()) }
        let outerRn = replace(mut &sc.rn, vs.rn.clone())
        let again = up().planSub(st, txn, &s, params, sc, false)
        sc.rn = outerRn
        if len(owner) > 0 { let r = pop(mut &sc.asRole) }
        while len(sc.names.frames) > nf { let f = pop(mut &sc.names.frames) }
        sc.names.frames[top].hidden = false
        match again {
            Ok(sp0) {
                var sp = sp0
                if sameOuts(&sp.sel, &q.subs[src].sel) && len(sp.sel.q.refs) == 0 {
                    let lp = takeLp(mut &sp.sel)
                    q.subs[src] = sp
                    for i in took { gone[i] = true }
                    any = true
                }
            }
            Err(_) {}
        }
    }
    if any {
        var keep: []Expr = []
        for i in 0..len(cs) { if !gone[i] { append(mut &keep, replace(mut &cs[i], Expr.Lit(Val.Null))) } }
        let was = replace(cs, keep)
    }
    return Ok(Unit{})
}

// The plans to be hashed of q's subqueries that semi joins (WHERE's
// top-level EXISTS and IN, hs.semiCand) and mark joins (an EXISTS or IN
// under OR, NOT or CASE in WHERE, optimizer 50) may take, into alts;
// looks: those a semi join may look up per row. Whether semiJoins has work:
// a semi join's candidate or a mark join's.
fn semiAlternatives(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, hs: &FromHints, where: &Option[Expr], params: &[]Val,
                    subs: &[]lexdb_sql.Stmt, sc: mut &Scope, early: bool, reorder: bool, alts: mut &[]Option[SubPlan],
                    looks: mut &[]bool): bool {
    // A correlated EXISTS or IN of a semi-join's that 9.9 could not hash,
    // its outer values a lookup's keys: planned again without them as
    // keys, to be hashed if a hash costs less (semiJoins). Not where
    // reading may stop early, nor in a transaction whose reads are noted:
    // there the lookups' reads stand (as in the join order). Planner work:
    // after every subquery is numbered and typed.
    // A WHERE conjunct's EXISTS or IN under OR, NOT or CASE: a mark join's
    // (optimizer 50), its plan to be hashed planned too
    var markCand: []bool = []
    var anyMark = false
    if len(subs) > 0 && reorder && (unnestMode & UN_MARK) != 0 {
        match where {
            Some(w) {
                markCand = array(len(subs), false)
                anyMark = markCands(w, mut &markCand)
            }
            None {}
        }
    }
    if (hs.anySemi || anyMark) && !early && !txn.noting() && !hs.rules {
        for i in 0..len(subs) {
            let semi = i < len(hs.semiCand) && hs.semiCand[i]
            if !semi && !(i < len(markCand) && markCand[i]) { continue }
            let sp = &q.subs[i]
            // (an IN by its value's key: optimizer 50, 5c)
            if semi && sp.use == lexdb_sql.SUB_IN && sp.cte < 0 && (unnestMode & UN_LOOK) != 0 { looks[i] = true }
            if !((sp.use == lexdb_sql.SUB_EXISTS || sp.use == lexdb_sql.SUB_IN) && len(sp.sel.q.refs) > 0 && !sp.hashed && sp.cte < 0) { continue }
            looks[i] = semi
            sc.noRefKeys = true
            let nf = len(sc.names.frames)
            // (a mark join takes no residual filter: none planned)
            let again = up().planSub(st, txn, &subs[i], params, sc, semi)
            sc.noRefKeys = false
            // (a plan that failed may have left its frame: this query's is the top one)
            while len(sc.names.frames) > nf { let gone = pop(mut &sc.names.frames) }
            let got = again.ok()
            if got.isSome() {
                let alt = got.unwrap()
                if alt.hashed && semiAltOk(&alt, &q.subs[i]) { alts[i] = Some(alt) }
            }
        }
    }
    return hs.anySemi || anyMark
}

// The planner's pass over FROM (2e slice 2), after bindFrom: the semi-join
// alternatives, the ON and WHERE conjuncts placed per level (read from
// q.lp), the implied equalities, the join order, the paths, hashing, the
// semi-joins.
pub fn planFrom(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, hs: &FromHints, bf: &FromBound, where: &Option[Expr],
            params: &[]Val, subs: &[]lexdb_sql.Stmt, selNames: &Map[str, int], star: bool, sc: mut &Scope,
            reorder: bool): Result[Unit, DbErr] {
    let early = hs.early
    let locking = hs.locking
    let anyUsing = bf.anyUsing
    // each table's statistics where they choose its path (a join's other
    // tables': when its order is costed, optimizer 35)
    for k in 0..len(q.levels) {
        if q.levels[k].src < 0 && q.levels[k].work < 0 { q.levels[k].est = try lexdb_stats.loadEst(st, txn, &q.levels[k].t, false, hs.rules) }
    }
    // the semi and mark joins' plans to be hashed (semiAlternatives), per
    // subquery; whether semiJoins runs (a semi join's candidate, or a mark
    // join's). (Made only for a query with subqueries: a point select's
    // planning makes none.)
    var semiAlts: []Option[SubPlan] = []
    var semiLooks: []bool = []         // ... may be a lookup per row as a join's level (semiLook)
    var semis = 0                      // 1: semiJoins runs; 2: scalarJoins may
    if len(subs) > 0 {
        for i in 0..len(subs) { append(mut &semiAlts, None) }
        semiLooks = array(len(subs), false)
        if semiAlternatives(st, txn, q, hs, where, params, subs, sc, early, reorder, mut &semiAlts, mut &semiLooks) { semis = 1 }
        if q.corr && (unnestMode & UN_SCALAR) != 0 { semis = semis | 2 }
    }
    let nl = len(q.levels)
    // the columns by name, for levelOf (the planner asks it often: optimizer 30)
    if nl >= 2 { for i in 0..len(q.cols) { if !q.colAt.has(&q.cols[i].name) { q.colAt.put(q.cols[i].name.toStr(), i) } } }
    var ms: [][]Expr = []
    var ps: [][]Expr = []
    for k in 0..nl {
        append(mut &ms, [])
        append(mut &ps, [])
    }
    var cs: []Expr = []                    // WHERE's conjuncts
    fromConds(&q.lp, bf.where, mut &ms, mut &cs)
    // outer joins whose NULL rows WHERE or a later join rejects: inner (optimizer 48.2)
    if nl >= 2 && !hs.rules && (rewriteMode & RW_OUTER) != 0 && !q.innerOnly() { q.innerJoins(&ms, &cs) }
    // WHERE's conjuncts on a derived table, view or CTE used once: into its query (optimizer 48.3)
    if len(q.subs) > 0 {
        // a LATERAL subquery made a join: its keys' equalities, its ON (optimizer 51)
        lateralMs(q, mut &ms)
        if bf.where && !hs.rules && (rewriteMode & RW_PUSH) != 0 { try pushDown(st, txn, q, where, subs, params, sc, mut &cs) }
        for i in 0..len(q.subs) { q.subs[i].view = None }
    }
    // A RIGHT or FULL JOIN can make the columns before it NULL: no WHERE
    // conjunct goes below the last one.
    var lastRight = -1
    for k in 0..nl { if keepsRight(q.levels[k].join) { lastRight = k } }
    for i in 0..len(cs) {
        let c = replace(mut &cs[i], Expr.Lit(Val.Null))
        if nl == 0 {
            append(mut &q.top, c)
        } else {
            var k = q.maxLevel(&c)
            if k < 0 { k = 0 }
            if lastRight > k { k = lastRight }
            // An OR across tables: each table's own part of it is a
            // necessary filter, so a scan of that table can cut its
            // rows before the join (q19's part brand/container).
            // Not a LEFT JOIN's nullable side: its conditions are its
            // ON's, and a branch that holds for its NULL-extended row
            // ("b.y is null") would lose that row's match. Not a
            // volatile OR: its copy would draw again (random()).
            let om = q.levelMask(&c)
            if lastRight < 0 && matchesOr(&c) && (om & (om - 1)) != 0 && !hasSubCall(&c) && lexdb_bind.immutable(&c) {
                for lev in 0..nl {
                    if (om & (1 << lev)) == 0 || isOuter(q.levels[lev].join) { continue }
                    let got = orLevels(&c, lev, q)
                    if got.isSome() { append(mut &ms[lev], got.unwrap()) }
                }
            }
            if isOuter(q.levels[k].join) { append(mut &ps[k], c) } else { append(mut &ms[k], c) }
        }
    }
    // the columns the SELECT names, for the index-only choice (9.31):
    // narrow's, but before the paths are chosen rather than after
    if !star {
        for k in 0..len(q.levels) {
            if q.levels[k].virt() { continue }
            var need: []bool = []
            for c in q.levels[k].t.cols { append(mut &need, selNames.has(&c.name)) }
            if q.levels[k].gen { lexdb_gen.needDeps(&q.levels[k].t.cols, mut &need) }
            q.levels[k].need = need
        }
    }
    var rightLocal: []Expr = []            // a's WHERE conjuncts when "a LEFT JOIN b" runs as a right join
    if reorder && nl >= 2 && !hs.rules {
        // the join order: by cost with statistics (optimizer 26), else bound
        // by keys (optimizer 25); the conjuncts go again to the latest table
        // they use, in the new order
        if q.innerOnly() {
            // the implied equalities (optimizer 27), at the latest table they use
            var all: []Expr = []
            for m in ms { for c in m { append(mut &all, lexdb_sql.cloneExpr(&c)) } }
            let extra = q.implied(&all)
            for i in 0..len(extra) {
                var k = q.maxLevel(&extra[i])
                if k < 0 { k = 0 }
                append(mut &ms[k], lexdb_sql.cloneExpr(&extra[i]))
            }
            q.implied = true
        }
        var ro: []bool = []
        var perm: []int = []
        var grp: []int = []
        // By cost, except in a transaction whose reads are noted: there a
        // whole-table read, a hash's or a first table's scan, would conflict
        // with every write to the table (as the index-to-scan switch,
        // optimizer 19), so the order bound by keys stands, which starts
        // from a pinned row. Where reading may stop early, a lookup stays a
        // lookup (optimizer 26 review).
        // a hash holds at most half the statement's memory, 64 MB at most
        var cap = HASH_MAX_BYTES
        if hs.memMax > 0 && float(hs.memMax) / 2.0f < cap { cap = float(hs.memMax) / 2.0f }
        var ordCols: []int = []
        let ordT = q.orderedLevel(&hs.ordBy, mut &ordCols)
        // A join that starts from a row its key pins (optimizer 35): the
        // order bound by keys, at once; no statistics read for it and no
        // search (most OLTP joins, planned on every run unless prepared).
        // Not with an ORDER BY ... LIMIT a table can serve: reading it in
        // order and stopping early (optimizer 32) may beat starting from the
        // pinned row (optimizer 39).
        var po: []int = []
        if ordT < 0 || hs.ordLim < 0 { po = q.pinnedOrder(&ms) }
        let pinned = len(po) > 0
        // from one row, a lookup per row is one lookup: cheaper than a hash
        // of what a constant reaches (the "constant first" rule, optimizer 27)
        if pinned {
            q.implied = false
            q.pinned = true
        }
        if !pinned && !txn.noting() {
            for k in 0..nl {
                if q.levels[k].est.rows < 0 && !q.levels[k].virt() {
                    let es = try lexdb_stats.loadEst(st, txn, &q.levels[k].t, true, hs.rules)
                    q.levels[k].est = es
                }
            }
        }
        if pinned {
            var ident = true
            for i in 0..nl { if po[i] != i { ident = false } }
            if !ident { perm = po }
        } else if txn.noting() || !q.costOrder(&ms, early, cap, ordT, &ordCols, float(hs.ordLim), if locking || !grpRuns(q, hs) { BU_OFF } else { bushyMode },
                                               mut &perm, mut &ro, mut &grp) {
            perm = q.joinOrder(&ms)
            // outer joins, in FROM's order: each table hashed or looked up
            // by cost (optimizer 41)
            if !txn.noting() && len(perm) == 0 && !q.innerOnly() {
                if !q.outerReadOnce(&ms, early, cap, mut &ro) { ro = [] }
                // "a LEFT JOIN b" as "b RIGHT JOIN a", a hashed (rightCheaper):
                // b's own ON conditions are its filter (its rows that join
                // none are dropped either way); the rest of the ON is the
                // right join's; WHERE's conjuncts on a alone filter a's
                // rows as they are hashed (a row they drop neither joins
                // nor is kept), the others are checked after the join, on
                // the joined rows and a's rows kept with NULLs
                if !early && !locking && !anyUsing && len(q.subs) == 0 && q.rightCheaper(&ms, &ps, cap, &ro) &&
                   (try q.rightFits(st, cap)) {
                    var onB: []Expr = []
                    var onAB: []Expr = []
                    var post: []Expr = []
                    var xs = replace(mut &ms[1], [])
                    for i in 0..len(xs) {
                        let c = replace(mut &xs[i], Expr.Lit(Val.Null))
                        if q.levelMask(&c) == 2 && cannotFail(&c) { append(mut &onB, c) } else { append(mut &onAB, c) }
                    }
                    xs = replace(mut &ms[0], [])
                    for i in 0..len(xs) {
                        let c = replace(mut &xs[i], Expr.Lit(Val.Null))
                        if q.levelMask(&c) == 1 { append(mut &rightLocal, c) } else { append(mut &post, c) }
                    }
                    xs = replace(mut &ps[1], [])
                    for i in 0..len(xs) { append(mut &post, replace(mut &xs[i], Expr.Lit(Val.Null))) }
                    xs = replace(mut &ps[0], [])
                    for i in 0..len(xs) { append(mut &post, replace(mut &xs[i], Expr.Lit(Val.Null))) }
                    let la = replace(mut &q.levels[0], newLevel(rc(noTable()), "", 0, 0))
                    let lb = replace(mut &q.levels[1], newLevel(rc(noTable()), "", 0, 0))
                    q.levels[0] = lb
                    q.levels[1] = la
                    q.levels[0].join = lexdb_sql.J_FIRST
                    q.levels[1].join = lexdb_sql.J_RIGHT
                    ms[0] = onB
                    ms[1] = onAB
                    ps[1] = post
                    ro = []
                }
            }
        }
        if len(perm) == nl {
            var pool: []Expr = []
            for k in 0..nl {
                var xs = replace(mut &ms[k], [])
                for i in 0..len(xs) { append(mut &pool, replace(mut &xs[i], Expr.Lit(Val.Null))) }
            }
            var lvs: []Level = []
            for i in 0..nl { append(mut &lvs, replace(mut &q.levels[perm[i]], newLevel(rc(noTable()), "", 0, 0))) }
            q.levels = lvs
            for i in 0..nl { q.levels[i].join = if i == 0 { lexdb_sql.J_FIRST } else { lexdb_sql.J_INNER } }
            for i in 0..len(pool) {
                let c = replace(mut &pool[i], Expr.Lit(Val.Null))
                var k = q.maxLevel(&c)
                if k < 0 { k = 0 }
                append(mut &ms[k], c)
            }
        }
        for i in 0..len(ro) { q.levels[i].readOnce = ro[i] }
        for i in 0..len(grp) { q.levels[i].grp = grp[i] }
        if q.innerOnly() { q.oneEqPerClass(mut &ms) }
    }
    if q.corr {
        // a correlated subquery runs per row: its conjuncts go last
        for k in 0..nl {
            ms[k] = subsLast(replace(mut &ms[k], []))
            ps[k] = subsLast(replace(mut &ps[k], []))
        }
        q.top = subsLast(replace(mut &q.top, []))
    }
    for k in 0..nl {
        let m = replace(mut &ms[k], [])
        // a subquery's rows have no key: read them all
        // an IN (subquery) on it: its statistics, for the lookups' limit by
        // cost (Path.inMax), as a join's are loaded
        if !q.levels[k].virt() && q.levels[k].est.rows < 0 && !hs.rules && !txn.noting() && hasInSub(&m) {
            q.levels[k].est = try lexdb_stats.loadEst(st, txn, &q.levels[k].t, true, hs.rules)
        }
        var path = if q.levels[k].virt() { Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0, sorted: false} } else {
            choosePath(q, k, &m, params, mut &sc.looks)
        }
        // the cost planner's index range: read in key order where keyOrdered
        // says it may (optimizer 47)
        if !hs.rules && !q.levels[k].virt() { path.sorted = sortable(&q.levels[k].t, &path) }
        // a scan of the first table (or of one read once) where an OR's
        // branches each have an index path: their union by cost (optimizer 52;
        // not under an outer join: a kept row may fail its conditions)
        if !hs.rules && reorder && orMode != OR_NEVER && (k == 0 || q.levels[k].readOnce) && !q.levels[k].virt() && lastRight < 0 &&
           !isOuter(q.levels[k].join) && fullPath(&path) {
            q.levels[k].ors = orPaths(q, k, &m, params)
        }
        var perRow = k == 0 || q.pathOuter(&path) || q.levels[k].lateral
        let right = keepsRight(q.levels[k].join)
        if right {
            // Every row of it is kept: read it all once, and remember which joined.
            path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0, sorted: false}
            perRow = false
        }
        var local: []Expr = []
        var hcols: []int = []
        var hvals: []Expr = []
        var hkinds: []int = []
        if !perRow {
            for c in m {
                if q.minLevel(&c) >= k {
                    if !right { append(mut &local, lexdb_sql.cloneExpr(&c)) }
                    continue
                }
                match c {
                    Expr.Bin(op, a, b) {
                        if op == "=" {
                            // col = x, or a collation's #ci(col) = #ci(x) (L2): hashed on the key
                            let ka = keyedCol(&a)
                            let kb = keyedCol(&b)
                            if len(ka.name) > 0 && q.levelOf(&ka.name) == k && q.valBefore(&b, k) {
                                append(mut &hcols, lexdb_bind.colIndex(&q.cols, &ka.name) - q.levels[k].first)
                                append(mut &hvals, lexdb_sql.cloneExpr(&b))
                                append(mut &hkinds, ka.kind)
                            } else if len(kb.name) > 0 && q.levelOf(&kb.name) == k && q.valBefore(&a, k) {
                                append(mut &hcols, lexdb_bind.colIndex(&q.cols, &kb.name) - q.levels[k].first)
                                append(mut &hvals, lexdb_sql.cloneExpr(&a))
                                append(mut &hkinds, kb.kind)
                            }
                        }
                    }
                    else {}
                }
            }
        }
        q.levels[k].path = path
        let er = pathEst(&q.levels[k], &q.levels[k].path, params)
        q.levels[k].estRows = er.rows
        q.levels[k].estMax = er.bound
        if len(q.levels[k].ors) > 0 {
            let oe = orEst(&q.levels[k], params)
            q.levels[k].estRows = oe.rows
            q.levels[k].estMax = oe.bound
        }
        q.levels[k].perRow = perRow
        q.levels[k].cond = m
        q.levels[k].post = replace(mut &ps[k], [])
        q.levels[k].local = local
        q.levels[k].hashCols = hcols
        q.levels[k].hashVals = hvals
        q.levels[k].hashKinds = hkinds
    }
    for i in 0..len(rightLocal) { append(mut &q.levels[1].local, replace(mut &rightLocal[i], Expr.Lit(Val.Null))) }
    if semis != 0 && nl > 0 {
        if (semis & 1) != 0 { try semiJoins(st, txn, q, mut &semiAlts, &hs.semiCand, &semiLooks, params, sc, hs.rules, (unnestMode & UN_MARK) != 0) }
        // correlated scalar aggregates as grouped levels (optimizer 51)
        if q.corr && (unnestMode & UN_SCALAR) != 0 { try scalarJoins(st, txn, q, params, subs, sc, hs) }
    }
    return Ok(Unit{})
}

// Reads the tables that are joined by hash, once.
// Whether a semi-join hashes one integer key: its own map, not a string's
// (q4/q21 hash millions of order keys).
pub fn semiIntKey(lv: &Level): bool {
    if !lv.semi || !lv.hashInt || len(lv.hashCols) != 1 { return false }
    if len(lv.hashKinds) > 0 && lv.hashKinds[0] != lexdb_sql.COLL_EXACT { return false }
    return lexdb_rows.colKind(&lv.t.cols[lv.hashCols[0]]) == lexdb_rows.BK_INT
}

pub type SubPlan = record {
    pub use: int                    // lexdb_sql.SUB_SCALAR, SUB_EXISTS, SUB_IN
    pub sel: Sel
    pub oid: int                    // its column's type
    pub name: str                   // its column's name, as an output column
    pub hashed: bool                // correlated, run once into a hash: sel outputs the key (then IN's value, a scalar's aggregate)
    pub keyOuter: []Expr            // per key column: what it equals, of outer values only (refs as parameters)
    pub keyText: []str              // EXPLAIN: "inner = outer"
    pub cte: int                    // a CTE's use: the CTE's number (its rows shared); -1
    pub kind: int                   // IN: the collation kind its values are compared under (L2)
    pub semi: bool                  // a semi-join's (9.104): run once, its rows a level's (Level.semi)
    pub res: []Expr                 // correlated filters that are not keys (q21's l_suppkey <> outer), run once
    pub resText: []str              // ... their text, the outer values by name (EXPLAIN)
    pub readAs: int                 // IN: the type its values are read as, as = reads a text beside a value of that type; 0 as they are
    // a view read in FROM: its query, for pushDown to plan it again (planFrom
    // clears it). Here, not in FromBound, so a query with no subquery pays
    // nothing for it (a point select: optimizer 48.5).
    pub view: Option[ViewSrc]
    // a LATERAL subquery made a join and a grouping (optimizer 51, 5e): its keys; [] not
    pub lat: []LateralKeys
}

pub type Scope = record {
    pub names: Names
    pub works: []Work               // the working tables of recursive CTEs being planned
    // privileges (9.83): the roles a view's query is checked as (its
    // owner's, innermost last; none: the session's), the role checks so
    // far, and an UPDATE's or DELETE's target, checked by its statement
    pub asRole: []str
    pub whos: []Who
    pub target: str
    pub looks: []Look               // the planning's looks at parameters' values (optimizer 22)
    // the next query planned may stop reading early (a LIMIT without a sort,
    // EXISTS, a scalar subquery): its join order keeps lookups (optimizer 26
    // review). Set by planSub and planSelect, taken by buildQuery.
    pub early: bool
    // the next query planned locks rows (FOR UPDATE and the like, applied
    // after it is planned): its tables keep FROM's order and join methods
    // that keep it. Set by planSelect, taken by buildQuery.
    pub locking: bool
    // the next query's ORDER BY when it has a LIMIT (and no grouping or
    // window), and its LIMIT plus OFFSET (a parameter's taken as 100);
    // -1: none. The join order may read the table ordered by them first
    // and stop early (optimizer 32). Set by planSelect, taken by buildQuery.
    pub ordBy: []lexdb_sql.OrderItem
    pub ordLim: int
    // the next query planned may not use its outer values as a path's keys
    // (a semi-join's subquery planned to be hashed, 9.104). Set by
    // buildQuery for a subquery, taken by the subquery's buildQuery.
    pub noRefKeys: bool
    // the next SELECT planned is a statement's own, whose logical plan
    // nothing reads (select runs the Sel): its Sel.lp is not built (a point
    // select's planning cost). Set by select, taken by planSelect.
    pub noLp: bool
    // the renames (Table.rn) of the view whose query is being planned: its text's names are what they became
    pub rn: []str
}

pub type Work = record { pub id: int; pub cols: []lexdb_sql.ColDef }

fn refOf(x: &Expr, base: int): int {
    match x {
        Expr.Param(n) { if n > base { return n - base - 1 } }
        Expr.Cast(a, _) { return refOf(&a, base) }
        else {}
    }
    return -1
}

fn usesRefs(x: &Expr, base: int): bool {
    match x {
        Expr.Param(n) { return n > base }
        Expr.Unary(_, a) { return usesRefs(&a, base) }
        Expr.Bin(_, a, b) { return usesRefs(&a, base) || usesRefs(&b, base) }
        Expr.IsNull(a, _) { return usesRefs(&a, base) }
        Expr.Cast(a, _) { return usesRefs(&a, base) }
        Expr.Call(_, args, _) {
            for a in args { if usesRefs(&a, base) { return true } }
            return false
        }
        else { return false }
    }
}

pub type HashKeys = record {
    pub inner: []Expr
    pub outer: []Expr
    pub texts: []str                // the conjuncts taken out, by their text
    pub res: []Expr                 // a filter that is not a key: outer values stay, the inner row's checked
}

// Of outer values only: no column of the subquery's, no subquery.
fn outerOnly(x: &Expr, base: int): bool {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    return len(ns) == 0 && usesRefs(x, base) && !lexdb_bind.hasAgg(x) && !hasSubCall(x)
}

pub fn hasSubCall(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasSubCall(&a) }
        Expr.Bin(_, a, b) { return hasSubCall(&a) || hasSubCall(&b) }
        Expr.IsNull(a, _) { return hasSubCall(&a) }
        Expr.Cast(a, _) { return hasSubCall(&a) }
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) { return true }
            for a in args { if hasSubCall(&a) { return true } }
            return false
        }
        else { return false }
    }
}

// Whether a hashed subquery's key inner = outer compares as = does:
// semiTypes's kinds; one type on both sides, a float's or a char(n)'s
// of one n (padded alike); or an outer value of no known type (a derived
// table's column: an untyped parameter, keyed as before).
fn hashKeyTypes(inner: &Expr, outer: &Expr, cols: &[]lexdb_sql.ColDef): bool {
    match outer {
        Expr.Param(_) { return true }
        else {}
    }
    let io = exprOid(inner, cols, &[])
    let oo = exprOid(outer, cols, &[])
    if semiTypes(io, oo) { return true }
    if io == oo && (io == lexdb_sql.OID_FLOAT4 || io == lexdb_sql.OID_FLOAT8) { return true }
    if io == oo && io == lexdb_sql.OID_BPCHAR {
        let n = lexdb_bind.bpLen(inner, cols)
        return n > 0 && n == lexdb_bind.bpLen(outer, cols)
    }
    return false
}

// A conjunct "inner = outer" (either way round), into hk; false: it uses an
// outer value otherwise.
fn keyConj(c: &Expr, base: int, hk: mut &HashKeys, cols: &[]lexdb_sql.ColDef): bool {
    let t = lexdb_sql.exprText(c)
    for x in hk.texts { if x == t { return true } }
    match c {
        Expr.Bin(op, a, b) {
            if op != "=" { return false }
            var inner = lexdb_sql.cloneExpr(&a)
            var outer = lexdb_sql.cloneExpr(&b)
            if !outerOnly(&outer, base) {
                inner = lexdb_sql.cloneExpr(&b)
                outer = lexdb_sql.cloneExpr(&a)
            }
            if !outerOnly(&outer, base) || usesRefs(&inner, base) || hasCorr(&inner) { return false }
            // a hash compares keys by value (lexdb_pipe.keyPart), which = does only
            // for the same kinds of value (semiTypes): a timestamp with a
            // date, a text with an integer, a float with a numeric compare
            // equal as = converts them, and not as keys. The outer value's
            // type: its column's (outerRef types it)
            if !hashKeyTypes(&inner, &outer, cols) { return false }
            append(mut &hk.inner, inner)
            append(mut &hk.outer, outer)
            append(mut &hk.texts, t)
            return true
        }
        else { return false }
    }
}

fn keyConjs(cs: &[]Expr, base: int, hk: mut &HashKeys, movable: bool, res: bool, cols: &[]lexdb_sql.ColDef): bool {
    for c in cs {
        if !usesRefs(&c, base) { continue }
        if !movable { return false }
        if !keyConj(&c, base, hk, cols) {
            if !res { return false }
            // not inner = outer: a filter the once-run subquery cannot keep
            // (the outer value is a parameter now), checked per candidate
            // row of the key's bucket instead
            if lexdb_bind.hasAgg(&c) || hasSubCall(&c) { return false }
            append(mut &hk.res, lexdb_sql.cloneExpr(&c))
            append(mut &hk.texts, lexdb_sql.exprText(&c))
        }
    }
    return true
}

fn noRefs(xs: &[]Expr, base: int): bool {
    for x in xs { if usesRefs(&x, base) { return false } }
    return true
}

fn dropTexts(cs: []Expr, texts: &[]str): []Expr {
    var all = cs
    var out: []Expr = []
    for i in 0..len(all) {
        let c = replace(mut &all[i], Expr.Lit(Val.Null))
        let t = lexdb_sql.exprText(&c)
        var drop = false
        for x in texts { if x == t { drop = true } }
        if !drop { append(mut &out, c) }
    }
    return out
}

pub fn hashSub(sp: mut &SubPlan, base: int, res: bool) {
    var hk = HashKeys{inner: [], outer: [], texts: [], res: []}
    // a scalar subquery: one aggregate row, no GROUP BY, its key's groups
    // then its value per group (9.26)
    let scalar = sp.use == lexdb_sql.SUB_SCALAR
    {
        let sel = &sp.sel
        if sel.setop != 0 || sel.limit >= 0 || sel.offset > 0 || len(sel.groupBy) > 0 { return }
        if scalar {
            if !sel.aggQ || sel.having.isSome() || sel.distinct || len(sel.exprs) != 1 || hasSubCall(&sel.exprs[0]) { return }
        } else if sel.aggQ { return }
        if !noRefs(&sel.exprs, base) || !noRefs(&sel.order, base) { return }
        let q = &sel.q
        for lv in q.levels {
            if !noRefs(&lv.path.eqs, base) || !noRefs(&lv.path.ins, base) || !noRefs(&lv.hashVals, base) { return }
            // a semi or anti join's conditions (a residual on its hidden
            // columns, a lookup level's filters) are its own: a condition
            // on an outer value there is no WHERE conjunct of this query,
            // to be a key or a residual of it
            if lv.semi && (!noRefs(&lv.cond, base) || usesRefs(&lv.resVal, base)) { return }
            for b in lv.path.rng { if usesRefs(&b.val, base) { return } }
            // an outer join's ON conjuncts are not WHERE filters: they stay
            if !keyConjs(&lv.cond, base, mut &hk, !isOuter(lv.join), res, &q.cols) { return }
            if !keyConjs(&lv.post, base, mut &hk, true, res, &q.cols) { return }
            if !keyConjs(&lv.local, base, mut &hk, !isOuter(lv.join), res, &q.cols) { return }
        }
        if !keyConjs(&q.top, base, mut &hk, true, res, &q.cols) { return }
        if len(hk.inner) == 0 { return }
        // a subquery of its own (in FROM, a LATERAL one's, in an expression) that reads an outer value: run once, it would
        // have none (08P01)
        for s in q.subs { if !noRefs(&s.sel.q.refs, base) { return } }
    }
    for k in 0..len(sp.sel.q.levels) {
        sp.sel.q.levels[k].cond = dropTexts(replace(mut &sp.sel.q.levels[k].cond, []), &hk.texts)
        sp.sel.q.levels[k].post = dropTexts(replace(mut &sp.sel.q.levels[k].post, []), &hk.texts)
        sp.sel.q.levels[k].local = dropTexts(replace(mut &sp.sel.q.levels[k].local, []), &hk.texts)
    }
    sp.sel.q.top = dropTexts(replace(mut &sp.sel.q.top, []), &hk.texts)
    // it outputs the key, then IN's value or the scalar's aggregate (grouped
    // by the key)
    var outs: []Expr = []
    for x in hk.inner { append(mut &outs, lexdb_sql.cloneExpr(&x)) }
    if sp.use == lexdb_sql.SUB_IN || scalar { append(mut &outs, lexdb_sql.cloneExpr(&sp.sel.exprs[0])) }
    if scalar {
        var gb: []Expr = []
        for x in hk.inner { append(mut &gb, lexdb_sql.cloneExpr(&x)) }
        sp.sel.groupBy = gb
        sp.sel.first = -1               // per group now: no stopping at the first row
    }
    var texts: []str = []
    for i in 0..len(hk.inner) {
        let r = refOf(&hk.outer[i], base)
        var outer = "an outer expression"
        if r >= 0 {
            outer = match sp.sel.q.refs[r] {
                Expr.Col(n, _) { n.clone() }
                else { "an outer value" }
            }
        }
        let inner = match hk.inner[i] {
            Expr.Col(n, _) { n.clone() }
            else { lexdb_sql.exprText(&hk.inner[i]) }
        }
        append(mut &texts, inner + " = " + outer)
    }
    sp.sel.lp = takeLp(mut &sp.sel)
    sp.sel.exprs = outs
    sp.sel.order = []
    sp.sel.sort = false
    sp.sel.distinct = false
    sp.sel.desc = []
    sp.sel.nullsFirst = []
    sp.hashed = true
    sp.keyOuter = replace(mut &hk.outer, [])
    sp.keyText = texts
    var rt: []str = []
    for x in hk.res { append(mut &rt, lexdb_sql.exprText(&substRefs(&x, base, &sp.sel.q.refs))) }
    sp.resText = rt
    sp.res = replace(mut &hk.res, [])
}

// A WHERE conjunct as parsed, x IN (subquery) or EXISTS (subquery): the
// subquery's number; -1 none.
fn semiParsed(c: &Expr): int {
    match c {
        Expr.Call(n, args, _) {
            if (n == "#exists" && len(args) == 1) || (n == "#in" && len(args) == 2) { return lexdb_sql.litInt(&args[0]) }
        }
        Expr.Unary(op, a) { if op == "not" { return semiParsedNot(&a) } }
        else {}
    }
    return -1
}

// NOT EXISTS's subquery number; NOT IN's when its null-aware anti join is
// on (optimizer 50), else it keeps its row path's NULL rules.
fn semiParsedNot(x: &Expr): int {
    match x {
        Expr.Call(n, args, _) {
            if n == "#exists" && len(args) == 1 { return lexdb_sql.litInt(&args[0]) }
            if n == "#in" && len(args) == 2 && (unnestMode & UN_NOTIN) != 0 { return lexdb_sql.litInt(&args[0]) }
        }
        else {}
    }
    return -1
}

// ---- subquery unnesting (optimizer 50): which of its levels the planner
// makes (tests and measuring; 0: today's plans)
pub const UN_NOTIN: int = 1     // x NOT IN (subquery) as a null-aware anti join (50.1, 5a)
pub const UN_MARK: int = 2      // EXISTS / IN under OR, in the select list: a mark join (5b)
pub const UN_LOOK: int = 4      // semiLook widened: IN by the inner key, a range-keyed path (5c)
pub const UN_SCALAR: int = 8    // a correlated scalar aggregate as a grouped level, hashed or per row by cost (optimizer 51, 5d)
pub const UN_LATERAL: int = 16  // a correlated FROM subquery (LATERAL, APPLY) with an aggregate as a join and a grouping (5e)

var unnestMode: int = UN_NOTIN | UN_MARK | UN_LOOK | UN_SCALAR | UN_LATERAL

pub fn setUnnest(mode: int) { unnestMode = mode }

// Whether conjunct c (resolved) is NOT (x IN (subquery)).
fn isNotIn(c: &Expr): bool {
    match c {
        Expr.Unary(op, a) {
            if op != "not" { return false }
            match a {
                Expr.Call(n, _, _) { return n == "#in" }
                else {}
            }
        }
        else {}
    }
    return false
}

// The same, resolved.
fn semiResolved(c: &Expr): int {
    match c {
        Expr.Call(n, args, _) {
            if (n == "#exists" || n == "#in") && len(args) >= lexdb_bind.subFixed(&n) { return lexdb_sql.litInt(&args[0]) }
        }
        Expr.Unary(op, a) { if op == "not" { return semiResolvedNot(&a) } }
        else {}
    }
    return -1
}

fn semiResolvedNot(x: &Expr): int {
    match x {
        Expr.Call(n, args, _) {
            if n == "#exists" && len(args) >= lexdb_bind.subFixed(&n) { return lexdb_sql.litInt(&args[0]) }
            if n == "#in" && len(args) >= lexdb_bind.subFixed(&n) && (unnestMode & UN_NOTIN) != 0 { return lexdb_sql.litInt(&args[0]) }
        }
        else {}
    }
    return -1
}

// x with a subquery's outer values (parameters after base) as the outer
// query has them (refs).
fn substRefs(x: &Expr, base: int, refs: &[]Expr): Expr {
    match x {
        Expr.Param(n) { if n > base && n - base - 1 < len(refs) { return lexdb_sql.cloneExpr(&refs[n - base - 1]) } }
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), substRefs(&a, base, refs)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), substRefs(&a, base, refs), substRefs(&b, base, refs)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(substRefs(&a, base, refs), neg) }
        Expr.Cast(a, t) {
            // an outer column typed as itself (outerRef): the column
            // (a bare parameter's: a cast written over it stays)
            match a {
                Expr.Param(n) { if n > base && n - base - 1 < len(refs) && lexdb_bind.refTyped(t.oid) { return lexdb_sql.cloneExpr(&refs[n - base - 1]) } }
                else {}
            }
            return Expr.Cast(substRefs(&a, base, refs), t)
        }
        Expr.Call(n, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, substRefs(&a, base, refs)) }
            return Expr.Call(n.clone(), out, star)
        }
        else {}
    }
    return lexdb_sql.cloneExpr(x)
}

// Whether subquery sp planned again to be hashed (alt) is sp with other
// keys: the same outer values, and nothing whose value would differ when
// run once instead of per row (a subquery of its own; random(), a
// sequence's, the clock).
fn semiAltOk(alt: &SubPlan, sp: &SubPlan): bool {
    let a = &alt.sel.q
    let b = &sp.sel.q
    if len(a.refs) != len(b.refs) || len(a.subs) > 0 || len(b.subs) > 0 { return false }
    for i in 0..len(a.refs) { if lexdb_sql.exprText(&a.refs[i]) != lexdb_sql.exprText(&b.refs[i]) { return false } }
    for x in alt.sel.exprs { if !lexdb_bind.immutable(&x) { return false } }
    for x in alt.keyOuter { if !lexdb_bind.immutable(&x) { return false } }
    // a residual is checked per outer row (or once per key's summary)
    for x in alt.res { if !lexdb_bind.immutable(&x) { return false } }
    for x in a.top { if !lexdb_bind.immutable(&x) { return false } }
    for lv in a.levels {
        if lv.virt() { return false }
        for x in lv.cond { if !lexdb_bind.immutable(&x) { return false } }
        for x in lv.post { if !lexdb_bind.immutable(&x) { return false } }
        for x in lv.local { if !lexdb_bind.immutable(&x) { return false } }
    }
    return true
}

// Whether subquery alt, planned again to be hashed (semiAltOk), may run
// once in place of per outer row in optimizer 50's levels: nothing in it
// can fail (an error a per-row run reaches for some outer rows only, or
// for none, must not appear).
fn altSafe(alt: &SubPlan): bool {
    let a = &alt.sel.q
    for x in alt.sel.exprs { if !noFail(a, &x) { return false } }
    for x in a.top { if !noFail(a, &x) { return false } }
    for lv in a.levels {
        for x in lv.cond { if !noFail(a, &x) { return false } }
        for x in lv.post { if !noFail(a, &x) { return false } }
        for x in lv.local { if !noFail(a, &x) { return false } }
        for x in lv.path.eqs { if !noFail(a, &x) { return false } }
        for b in lv.path.rng { if !noFail(a, &b.val) { return false } }
        for x in lv.hashVals { if !noFail(a, &x) { return false } }
    }
    return true
}

fn valsFree(q: &Query, xs: &[]Expr): bool {
    for x in xs { if !noFail(q, &x) { return false } }
    return true
}

// Whether x cannot fail (optimizer 50.3): grpSafe's, with a subquery of
// q's that runs once (uncorrelated, hashed or a level's: its value is
// there whatever reads it) read as a value, its arguments checked; a
// subquery run per row may fail.
fn noFail(q: &Query, x: &Expr): bool {
    match stripSubs(q, x) {
        Some(s) { return grpSafe(&s) }
        None { return false }
    }
}

fn stripSubs(q: &Query, x: &Expr): Option[Expr] {
    match x {
        Expr.Unary(op, a) {
            match stripSubs(q, &a) {
                Some(s) { return Some(Expr.Unary(op.clone(), s)) }
                None { return None }
            }
        }
        Expr.Bin(op, a, b) {
            let sa = stripSubs(q, &a)
            let sb = stripSubs(q, &b)
            if sa.isNone() || sb.isNone() { return None }
            return Some(Expr.Bin(op.clone(), sa.unwrap(), sb.unwrap()))
        }
        Expr.IsNull(a, neg) {
            match stripSubs(q, &a) {
                Some(s) { return Some(Expr.IsNull(s, neg)) }
                None { return None }
            }
        }
        Expr.Cast(a, t) {
            match stripSubs(q, &a) {
                Some(s) { return Some(Expr.Cast(s, t)) }
                None { return None }
            }
        }
        Expr.Call(n, args, star) {
            if lexdb_sql.isSubCall(&n) {
                let i = if len(args) > 0 { lexdb_sql.litInt(&args[0]) } else { -1 }
                if i < 0 || i >= len(q.subs) { return None }
                let sp = &q.subs[i]
                if len(sp.sel.q.refs) > 0 && !sp.hashed && !sp.semi { return None }
                for j in 3..len(args) { if !noFail(q, &args[j]) { return None } }
                return Some(Expr.Lit(Val.Bool(true)))
            }
            var out: []Expr = []
            for a in args {
                match stripSubs(q, &a) {
                    Some(s) { append(mut &out, s) }
                    None { return None }
                }
            }
            return Some(Expr.Call(n.clone(), out, star))
        }
        else { return Some(lexdb_sql.cloneExpr(x)) }
    }
}

// Whether conjunct ci of level k's conditions cs (those after it as they
// were) may be taken out to a level placed right after level at (k, or a
// build group's last member), optimizer 50.3: what is then evaluated
// before it (the conditions after it at k, the levels' to at) cannot
// fail; exact: there is such a condition, so its own outer values must
// not fail either (they are then evaluated on fewer rows).
fn takeOutOk(q: &Query, cs: &[]Expr, ci: int, olds: &[]Level, k: int, at: int, exact: mut &bool): bool {
    for j in ci + 1..len(cs) {
        exact = true
        if !noFail(q, &cs[j]) { return false }
    }
    for p in k + 1..at + 1 {
        if p >= len(olds) { break }
        exact = true
        for x in olds[p].cond { if !noFail(q, &x) { return false } }
        for x in olds[p].post { if !noFail(q, &x) { return false } }
    }
    return true
}

// Whether keys of types a and b (OIDs) in a hash (lexdb_pipe.keyPart) match exactly
// when = says they are equal, and IN's set (lexdb_pipe.setKey): integers and numerics
// by value, texts and varchars by their text, a few types each with
// itself. (Not floats: -0 and 0; not intervals: '1 day' and '24 hours'; not
// char(n): its blanks.)
fn semiTypes(a: int, b: int): bool {
    let na = lexdb_bind.isIntOid(a) || a == lexdb_sql.OID_NUMERIC
    let nb = lexdb_bind.isIntOid(b) || b == lexdb_sql.OID_NUMERIC
    if na || nb { return na && nb }
    let ta = a == lexdb_sql.OID_TEXT || a == lexdb_sql.OID_VARCHAR
    let tb = b == lexdb_sql.OID_TEXT || b == lexdb_sql.OID_VARCHAR
    if ta || tb { return ta && tb }
    return a == b && (a == lexdb_sql.OID_BOOL || a == lexdb_sql.OID_DATE || a == lexdb_sql.OID_TS || a == lexdb_sql.OID_TSTZ ||
                      a == lexdb_sql.OID_UUID)
}

// A semi-join's keys: per column of the subquery's rows, the outer value
// it is to equal, its type, its name (EXPLAIN); and the correlated filters
// that are not keys (q21's l_suppkey <> outer), checked on the candidates.
pub type SemiKeys = record { pub vals: []Expr; pub oids: []int; pub names: []str; pub res: []Expr }

// The keys of a semi-join of subquery sp for conjunct c of q; None: it is
// not one.
fn semiKeys(q: &Query, sp: &SubPlan, c: &Expr, pt: &[]int): Option[SemiKeys] {
    match c {
        Expr.Unary(op, a) { if op == "not" { return semiKeys(q, sp, &a, pt) } }
        else {}
    }
    let isIn = sp.use == lexdb_sql.SUB_IN
    if (!isIn && sp.use != lexdb_sql.SUB_EXISTS) || sp.cte >= 0 || sp.semi { return None }
    var out = SemiKeys{vals: [], oids: [], names: [], res: []}
    let sq = &sp.sel.q
    if sp.hashed {
        for j in 0..len(sp.keyOuter) {
            let ov = substRefs(&sp.keyOuter[j], q.base, &sq.refs)
            let io = exprOid(&sp.sel.exprs[j], &sq.cols, pt)
            if hasSubCall(&ov) || !semiTypes(io, exprOid(&ov, &q.cols, pt)) { return None }
            let nm = match sp.sel.exprs[j] {
                Expr.Col(n, _) { lexdb_bind.colPart(&n) }
                else { lexdb_sql.exprText(&sp.sel.exprs[j]) }
            }
            append(mut &out.vals, ov)
            append(mut &out.oids, io)
            append(mut &out.names, nm)
        }
    } else if !isIn || len(sq.refs) > 0 {
        return None
    }
    for x in sp.res { append(mut &out.res, substRefs(&x, q.base, &sq.refs)) }
    if isIn {
        if len(sp.sel.outs) != 1 { return None }
        var x = Expr.Lit(Val.Null)
        match c {
            Expr.Call(_, args, _) { x = lexdb_sql.cloneExpr(&args[3]) }
            else { return None }
        }
        let vo = sp.sel.outs[0].oid
        if hasSubCall(&x) || vo == lexdb_sql.OID_BPCHAR || !semiTypes(vo, exprOid(&x, &q.cols, pt)) { return None }
        append(mut &out.vals, x)
        append(mut &out.oids, vo)
        append(mut &out.names, sp.sel.outs[0].name.toStr())
    }
    return Some(out)
}

// About the rows a level reads by its path: one by a unique key, else by
// ANALYZE's statistics (loaded for the figure if the level has none: a
// query of one table, optimizer 24); -1 unknown.
fn semiRows(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, lv: mut &Level, params: &[]Val, rules: bool): Result[float, DbErr] {
    if lv.virt() { return Ok(-1.0f) }
    let cols = keyCols(&lv.t, lv.path.index)
    let unique = lv.path.index < 0 || lv.t.indexes[lv.path.index].unique
    if len(lv.path.eqs) > 0 && len(lv.path.eqs) == len(cols) && unique { return Ok(1.0f) }
    if lv.estRows >= 0 { return Ok(float(lv.estRows)) }
    let loaded = lv.est.rows < 0
    if loaded { lv.est = try lexdb_stats.loadEst(st, txn, &lv.t, true, rules) }
    var n = -1.0f
    if lv.est.rows >= 0 {
        n = float(lv.est.rows)
        let f = pathFig(lv, &lv.path, params)
        if f.rows >= 0 { n = float(f.rows) }
    }
    if loaded { lv.est = lexdb_stats.noEst() }
    return Ok(n)
}

// The rows a subquery's tables read, summed; -1 unknown.
fn semiInner(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, sq: mut &Query, params: &[]Val, rules: bool): Result[float, DbErr] {
    var n = 0.0f
    for k in 0..len(sq.levels) {
        let r = try semiRows(st, txn, mut &sq.levels[k], params, rules)
        if r < 0.0f { return Ok(-1.0f) }
        n += r
    }
    return Ok(n)
}

// Whether the subquery's rows (inner) read once and hashed, each of the
// outer rows probing them, cost less than a lookup per outer row (as the
// join order weighs them, optimizer 41).
// The per-row alternative's fixed cost, measured (optimizer 45's units):
// a primary-key range run (q4's 2.4 lineitem rows) 140 us, ~5000 scan
// rows; a secondary index's lookup (q22's orders) 26 us, ~100. PostgreSQL
// has no such term: its subquery is a plan node. This is the executor's
// per-run setup, so it is charged by the path's shape, not the table's size.
const SEMI_RUN_PK: float = 5000.0f
const SEMI_RUN_INDEX: float = 100.0f

fn semiCheaper(outer: float, inner: float, run: float): bool {
    // The inner side is read once and hashed (COST_SCAN), not once per outer
    // row; the per-row side pays a run each (semiRun). One pinned row is
    // one run: no build.
    if outer <= 1.0f { return false }
    return inner * (COST_SCAN + HASH_BUILD) + outer * HASH_PROBE < outer * run
}

// One per-row run's cost, by its first table's path: its setup and the
// first row's lookup for a key's (a primary key's range, a secondary
// index's), its setup and every row for a path with no key: a full scan
// reads the inner side (about inner rows) again on each run. Charging it as
// a lookup chose 40 runs of a 100k-row scan, 2.76M rows, over one hash.
fn semiRun(lv: &Level, inner: float): float {
    let p = &lv.path
    let keyed = len(p.eqs) > 0 || len(p.rng) > 0 || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0
    if !keyed || lv.virt() { return SEMI_RUN_PK + inner * COST_SCAN }
    let setup = if p.index < 0 { SEMI_RUN_PK } else { SEMI_RUN_INDEX }
    return setup + COST_DESCENT + COST_KEY_ROW
}

// ---- a semi/anti join looked up per row (PostgreSQL's nested loop semi
// and anti join over an index scan, nodeNestloop.c: the inner scan stops
// at its first match). An EXISTS or NOT EXISTS over one table whose path
// is keyed by outer values (q4's lineitem by l_orderkey, q22's orders by
// o_custkey) becomes a level of that table, read per row of the tables
// before it by the path's range, its filters (the residual too: q21's
// l_suppkey <> outer) checked on each row found; a row of the tables
// before goes on once if one passes (semi), or if none does (anti). The
// subquery is not run: a run cost about 140 us (a primary-key range) or
// 26 us (a secondary index), the lookup a descent and the rows read. The
// batches read a batch's ranges together (bRange).

// Whether subquery i of q can be a looked-up semi/anti level (semiLook):
// EXISTS over one table, no grouping, aggregate, LIMIT or set operation,
// its path's leading equalities of outer values and constants only (no
// range, IN list or backward read: what bRange reads), at least one an
// outer value; its filters with no subquery and nothing whose value may
// change between rows (the subquery read them per row too, but a range
// read once for two outer rows of one key must give both the same rows).
fn semiLookable(q: &Query, i: int): bool { return semiLookableN(q, i, 1, 0) }

// semiLookable over a subquery of nl tables (2: twoKey's), its level at
// the one looked up.
fn semiLookableN(q: &Query, i: int, nl: int, at: int): bool {
    let sp = &q.subs[i]
    if sp.use != lexdb_sql.SUB_EXISTS || sp.cte >= 0 || sp.semi || sp.hashed { return false }
    let sel = &sp.sel
    if sel.setop != 0 || sel.aggQ || sel.having.isSome() || len(sel.groupBy) > 0 || sel.limit >= 0 || sel.offset > 0 || len(sel.wins) > 0 ||
       len(sel.locks) > 0 || len(sel.srf) > 0 || sel.rec >= 0 || len(sel.mr) > 0 || len(sel.gsets) > 0 { return false }
    let sq = &sel.q
    if len(sq.levels) != nl || len(sq.subs) > 0 || len(sq.refs) == 0 { return false }
    let sl = &sq.levels[at]
    if sl.virt() || sl.lateral || sl.lock != 0 || len(sl.post) > 0 || len(sl.t.cols) == 0 { return false }
    let p = &sl.path
    if len(p.eqs) == 0 || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 || p.desc { return false }
    // a range on the next column (optimizer 50, 5c): its bounds of outer
    // values and constants only, read per outer row as the subquery read them
    if len(p.rng) > 0 && (unnestMode & UN_LOOK) == 0 { return false }
    for b in p.rng {
        var ns: []str = []
        lexdb_sql.colNames(&b.val, mut &ns)
        if len(ns) > 0 || hasSubCall(&b.val) || lexdb_bind.hasAgg(&b.val) || !lexdb_bind.immutable(&b.val) { return false }
        if usesRefs(&substRefs(&b.val, q.base, &sq.refs), q.base) { return false }
    }
    var keyed = false
    for x in p.eqs {
        var ns: []str = []
        lexdb_sql.colNames(&x, mut &ns)
        if len(ns) > 0 || hasSubCall(&x) || lexdb_bind.hasAgg(&x) || !lexdb_bind.immutable(&x) { return false }
        if usesRefs(&x, q.base) { keyed = true }
    }
    if !keyed { return false }
    for x in sl.cond { if hasSubCall(&x) || lexdb_bind.hasAgg(&x) || !lexdb_bind.immutable(&x) { return false } }
    for x in sl.local { if hasSubCall(&x) || lexdb_bind.hasAgg(&x) || !lexdb_bind.immutable(&x) { return false } }
    for x in sq.top { if hasSubCall(&x) || lexdb_bind.hasAgg(&x) || !lexdb_bind.immutable(&x) { return false } }
    // Nothing of it may use q's own outer values (q a subquery, the
    // EXISTS's outer value one of the query around q): q's level would
    // carry a condition on them, which q's own unnesting (hashSub) could
    // take for a key "inner = outer" of q and drop from the level.
    for x in p.eqs { if usesRefs(&substRefs(&x, q.base, &sq.refs), q.base) { return false } }
    for x in sl.cond { if usesRefs(&substRefs(&x, q.base, &sq.refs), q.base) { return false } }
    for x in sl.local { if usesRefs(&substRefs(&x, q.base, &sq.refs), q.base) { return false } }
    for x in sq.top { if usesRefs(&substRefs(&x, q.base, &sq.refs), q.base) { return false } }
    return true
}

// EXISTS over two tables (optimizer 50, 5c): one (at, of the subquery's
// two levels) looked up per outer row (semiLookableN), the other's rows a
// set read once by one column equal to a column of the first, its other
// conditions its own. Looked up, the other's rows become a set run once (a
// new subquery of q, "b.col IN"), probed by each row of the first: acol
// and bcol the two columns, eq the equality's text (taken out of the
// looked-up level's conditions).
pub type TwoKey = record { pub at: int; pub acol: int; pub bcol: int; pub eq: str }

fn twoKey(q: &Query, i: int, at: int): Option[TwoKey] {
    if (unnestMode & UN_LOOK) == 0 || !semiLookableN(q, i, 2, at) { return None }
    let sq = &q.subs[i].sel.q
    let a = &sq.levels[at]
    let b = &sq.levels[1 - at]
    // the second level (hashed) holds the equality: its hash's key and value
    let h = &sq.levels[1]
    if h.join != lexdb_sql.J_INNER || h.virt() || h.lateral || h.lock != 0 || h.perRow || len(h.post) > 0 || h.semi || h.anti || h.grp != 0 ||
       h.mode != 0 || h.semiSub >= 0 || len(h.hashCols) != 1 || len(h.hashVals) != 1 { return None }
    if b.virt() || b.lateral || b.lock != 0 || len(b.post) > 0 || b.semiSub >= 0 { return None }
    for hk in h.hashKinds { if hk != lexdb_sql.COLL_EXACT { return None } }
    let l0 = &sq.levels[0]
    var vcol = -1
    match h.hashVals[0] {
        Expr.Col(n, _) { for j in 0..len(l0.t.cols) { if sq.cols[l0.first + j].name == n { vcol = j } } }
        else {}
    }
    if vcol < 0 { return None }
    let acol = if at == 0 { vcol } else { h.hashCols[0] }
    let bcol = if at == 0 { h.hashCols[0] } else { vcol }
    let ao = a.t.cols[acol].typ.oid
    let bo = b.t.cols[bcol].typ.oid
    let ints = lexdb_bind.isIntOid(ao) && lexdb_bind.isIntOid(bo)
    let texts = (ao == lexdb_sql.OID_TEXT || ao == lexdb_sql.OID_VARCHAR) && (bo == lexdb_sql.OID_TEXT || bo == lexdb_sql.OID_VARCHAR) &&
                len(a.t.cols[acol].coll) == 0 && len(b.t.cols[bcol].coll) == 0
    if !ints && !texts { return None }
    let an = sq.cols[a.first + acol].name.clone()
    let bn = sq.cols[b.first + bcol].name.clone()
    let want = lexdb_sql.exprText(&Expr.Bin("=", Expr.Col(bn.clone(), -1), Expr.Col(an.clone(), -1)))
    let back = lexdb_sql.exprText(&Expr.Bin("=", Expr.Col(an, -1), Expr.Col(bn, -1)))
    // the second's conditions: the key's equality, and its own; the
    // other's own (run once over all its rows now: none may fail, none
    // read an outer value)
    var eq = ""
    for x in h.cond {
        let t = lexdb_sql.exprText(&x)
        if t == want || t == back {
            eq = t
            continue
        }
        if sq.minLevel(&x) < 1 { return None }
        if at == 0 && !twoOwn(&x, q.base) { return None }
    }
    if len(eq) == 0 { return None }
    for x in b.cond { if lexdb_sql.exprText(&x) != eq && !twoOwn(&x, q.base) { return None } }
    for x in b.local { if !twoOwn(&x, q.base) { return None } }
    return Some(TwoKey{at: at, acol: acol, bcol: bcol, eq: eq})
}

// The alias of the table a looked-up semi or anti level reads (semiLook's:
// its subquery's level whose table it took; twoSet left the other's blank).
pub fn lookName(q: &Query, lv: &Level): str {
    for l in q.subs[lv.semiSub].sel.q.levels { if len(l.alias) > 0 { return l.alias.clone() } }
    return ""
}

fn twoOwn(x: &Expr, base: int): bool { return grpSafe(x) && !hasSubCall(x) && lexdb_bind.immutable(x) && !usesRefs(x, base) }

// The other table of EXISTS subquery i (twoKey tk) as a new subquery of q,
// its rows by its own conditions, its key column out (an IN's set, run
// once); the lookup level lk of the first gets "acol IN (it)".
fn twoSet(q: mut &Query, i: int, tk: &TwoKey, lk: mut &Level) {
    let n = len(q.subs)
    var b = replace(mut &q.subs[i].sel.q.levels[1 - tk.at], newLevel(rc(noTable()), "", 0, 0))
    let slot = b.first + tk.bcol
    let oid = b.t.cols[tk.bcol].typ.oid
    var cols: []lexdb_sql.ColDef = []
    for c in q.subs[i].sel.q.cols {
        var d = lexdb_sql.colDef(&c.name, c.typ, c.notNull)
        d.coll = c.coll.clone()
        d.using = c.using.clone()
        append(mut &cols, d)
    }
    let name = cols[slot].name.clone()
    // read on its own: its own conditions (a hashed level's are its local's)
    var own: []Expr = []
    for x in b.cond { if lexdb_sql.exprText(&x) != tk.eq { append(mut &own, lexdb_sql.cloneExpr(&x)) } }
    b.cond = if b.perRow { own } else { replace(mut &b.local, []) }
    b.local = []
    b.perRow = true
    b.hashCols = []
    b.hashVals = []
    b.hashKinds = []
    b.hashInt = false
    b.readOnce = false
    b.join = lexdb_sql.J_INNER
    b.stops = false
    b.keeps = false
    let nq = Query{levels: [b], cols: cols, top: [], subs: [], base: q.base, corr: false, refs: [], implied: false, colAt: newMap(), pinned: false,
                   noRefKeys: false, cc: [], cp: [], lp: lexdb_bind.noPlan(), jp: None}
    let outs: []lexdb_bind.OutCol = [lexdb_bind.OutCol{name: "?column?", oid: oid, spell: "", coll: "", scale: -1}]
    let sel = Sel{q: nq, exprs: [Expr.Col(name, slot)], outs: outs, groupBy: [], order: [], aggQ: false, sort: false, first: -1, limit: -1, offset: 0,
                  having: None, specs: [], distinct: false, desc: [], nullsFirst: [], parts: [], setop: 0, setAll: false, split: 0, rec: -1, srf: "",
                  ordin: false, wins: [], nAggs: 0, locks: [], nOut: 1, donKey: 0, withTies: false, gsets: [], gx: [], gord: [], gh: [],
                  groupKinds: [], ordKinds: [], outKinds: [lexdb_sql.COLL_EXACT], topMode: 0, topN: -1, feedback: [], mr: [], conv: [], ox: [],
                  oxParam: false, lp: lexdb_bind.noPlan(), pipe: None}
    append(mut &q.subs, SubPlan{use: lexdb_sql.SUB_IN, sel: sel, oid: oid, name: "?column?", hashed: false, keyOuter: [], keyText: [], cte: -1,
                                 kind: lexdb_sql.COLL_EXACT, semi: false, res: [], resText: [], readAs: 0, view: None, lat: []})
    let ax = Expr.Col(lk.alias + "." + lexdb_catalog.ROWID + tk.acol.toStr(), lk.first + tk.acol)
    append(mut &lk.cond, Expr.Call("#in", [Expr.Lit(Val.Int(n)), Expr.Lit(Val.Int(oid)), Expr.Lit(Val.Text("?column?")), ax], false))
    if tk.acol < len(lk.need) { lk.need[tk.acol] = true }
}

// Whether x IN (subquery i of q), conjunct c, may be a semi join looked
// up per row by x (optimizer 50, 5c): one table, no grouping, aggregate,
// LIMIT, set operation, window or lock, its value a plain column that
// leads its primary key or an index, x and the column both integers or
// both texts (varchar) under IN's exact collation (kind), x and the
// conditions immutable with no subquery (semiLookable's), nothing using
// q's own outer values.
fn inLook(q: &Query, i: int, c: &Expr, kind: int, pt: &[]int): Option[InLook] {
    let sp = &q.subs[i]
    if sp.use != lexdb_sql.SUB_IN || sp.cte >= 0 || sp.semi || kind != lexdb_sql.COLL_EXACT || sp.readAs != 0 || len(sp.res) > 0 { return None }
    let sel = &sp.sel
    if sel.setop != 0 || sel.aggQ || sel.having.isSome() || len(sel.groupBy) > 0 || sel.limit >= 0 || sel.offset > 0 || len(sel.wins) > 0 ||
       len(sel.locks) > 0 || len(sel.srf) > 0 || sel.rec >= 0 || len(sel.mr) > 0 || len(sel.gsets) > 0 { return None }
    let sq = &sel.q
    if len(sq.levels) != 1 || len(sq.subs) > 0 { return None }
    let sl = &sq.levels[0]
    if sl.virt() || sl.lateral || sl.lock != 0 || len(sl.post) > 0 || len(sl.t.cols) == 0 { return None }
    // its value: a hashed one's last output, else its only one
    let vi = if sp.hashed { len(sp.keyOuter) } else { 0 }
    if vi >= len(sel.exprs) { return None }
    var col = -1
    match sel.exprs[vi] {
        Expr.Col(n, _) { for j in 0..len(sl.t.cols) { if sq.cols[sl.first + j].name == n { col = j } } }
        else {}
    }
    if col < 0 { return None }
    var x = Expr.Lit(Val.Null)
    match c {
        Expr.Call(n, args, _) { if n == "#in" && len(args) > 3 { x = lexdb_sql.cloneExpr(&args[3]) } else { return None } }
        else { return None }
    }
    if hasSubCall(&x) || lexdb_bind.hasAgg(&x) || !lexdb_bind.immutable(&x) || usesRefs(&x, q.base) { return None }
    let co = sl.t.cols[col].typ.oid
    let xo = exprOid(&x, &q.cols, pt)
    let ints = lexdb_bind.isIntOid(co) && lexdb_bind.isIntOid(xo)
    let texts = (co == lexdb_sql.OID_TEXT || co == lexdb_sql.OID_VARCHAR) && (xo == lexdb_sql.OID_TEXT || xo == lexdb_sql.OID_VARCHAR) && len(sl.t.cols[col].coll) == 0
    if !ints && !texts { return None }
    // the key: the primary key's first column, else an index's
    let t = &sl.t
    var ix = -2
    if len(t.pk) > 0 && t.pk[0] == col { ix = -1 }
    if ix == -2 {
        for k in 0..len(t.indexes) {
            let kc = keyCols(t, k)
            if len(kc) > 0 && kc[0] == col && ix == -2 { ix = k }
        }
    }
    if ix == -2 { return None }
    for x2 in sl.cond { if hasSubCall(&x2) || lexdb_bind.hasAgg(&x2) || !lexdb_bind.immutable(&x2) || usesRefs(&substRefs(&x2, q.base, &sq.refs), q.base) { return None } }
    for x2 in sl.local { if hasSubCall(&x2) || lexdb_bind.hasAgg(&x2) || !lexdb_bind.immutable(&x2) || usesRefs(&substRefs(&x2, q.base, &sq.refs), q.base) { return None } }
    for x2 in sq.top { if hasSubCall(&x2) || lexdb_bind.hasAgg(&x2) || !lexdb_bind.immutable(&x2) || usesRefs(&substRefs(&x2, q.base, &sq.refs), q.base) { return None } }
    for x2 in sp.keyOuter { if !lexdb_bind.immutable(&x2) || usesRefs(&substRefs(&x2, q.base, &sq.refs), q.base) { return None } }
    // its conditions now evaluated on the rows of x's key only, where the
    // subquery's run evaluated them on its path's: none may fail (50.3)
    for x2 in sl.cond { if !grpSafe(&x2) { return None } }
    for x2 in sl.local { if !grpSafe(&x2) { return None } }
    for x2 in sq.top { if !grpSafe(&x2) { return None } }
    return Some(InLook{col: col, ix: ix, x: x, eq: !ints, point: ix == -1 && len(t.pk) == 1})
}

// A looked-up semi/anti level's cost per outer row (optimizer 45's
// units): a descent and the first row's read (a lookup's, COST_DESCENT +
// COST_KEY_ROW), then each further row of the key's range: a primary
// key's or an index read alone 1.8 (COST_PK_RANGE), an index entry and
// its row 49 (COST_IX_ROW). With no filter the first row decides. rows:
// the path's rows per key, -1 unknown (10 assumed, SQLite's default).
fn semiLookRun(t: &Table, lv: &Level, rows: float): float {
    var r = if rows < 0.0f { 10.0f } else { fmax(rows, 1.0f) }
    if len(lv.cond) == 0 { r = 1.0f }
    let ix = lv.path.index
    let each = if ix < 0 || lexdb_access.idxDecOf(&lexdb_catalog.relOf(t), ix, &lv.need).isSome() { COST_PK_RANGE } else { COST_IX_ROW }
    return COST_DESCENT + COST_KEY_ROW + (r - 1.0f) * each
}

// Subquery i of q (semiLookable) as a semi (anti: an anti) join level of
// its table, its columns after q's (semiLookAdd adds them, hidden, and
// moves the table in: t is noTable until then); its path and filters with
// the subquery's columns renamed to the level's and its outer values as q
// has them.
fn semiLook(q: &Query, i: int, anti: bool, pt: &[]int): Level {
    let none: Option[InLook] = None
    return semiLookOf(q, i, anti, pt, &none, 0, &"")
}

// An IN's lookup (optimizer 50, 5c): the subquery's table read per outer
// row by its column col (the IN's value), leading its primary key (ix -1)
// or index ix, at x; eq: col = x kept as a filter (not both integers).
pub type InLook = record { pub col: int; pub ix: int; pub x: Expr; pub eq: bool; pub point: bool }

// semiLook, or an IN's lookup (inl: its key) in place of its path.
fn semiLookOf(q: &Query, i: int, anti: bool, pt: &[]int, inl: &Option[InLook], at: int, skip: &str): Level {
    let alias = "\x00sj" + (i + 1).toStr()
    let first = len(q.cols)
    var names: []str = []
    var path = Path{index: -1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0, sorted: false}
    var conds: []Expr = []
    var estRows = -1
    var estMax = false
    {
        let sq = &q.subs[i].sel.q
        let sl = &sq.levels[at]
        var from: []str = []
        var to: []str = []
        for j in 0..len(sl.t.cols) {
            append(mut &names, sl.t.cols[j].name.toStr())
            append(mut &from, sq.cols[sl.first + j].name.toStr())
            append(mut &to, alias + "." + lexdb_catalog.ROWID + j.toStr())
        }
        var xs: []Expr = []
        for x in sl.cond { if lexdb_sql.exprText(&x) != skip { append(mut &xs, lexdb_sql.cloneExpr(&x)) } }
        for x in sl.local { append(mut &xs, lexdb_sql.cloneExpr(&x)) }
        for x in sq.top { append(mut &xs, lexdb_sql.cloneExpr(&x)) }
        // a hashed IN's keys "inner = outer" (9.9 took them out of its levels)
        let sp = &q.subs[i]
        if inl.isSome() && sp.hashed {
            for j in 0..len(sp.keyOuter) { append(mut &xs, Expr.Bin("=", lexdb_sql.cloneExpr(&sp.sel.exprs[j]), lexdb_sql.cloneExpr(&sp.keyOuter[j]))) }
        }
        for x in xs {
            var rc = lexdb_sql.cloneExpr(&x)
            for j in 0..len(from) { rc = lexdb_bind.renameCol(&rc, &from[j], &to[j], first + j) }
            // (local repeats some of cond: each once)
            let r2 = substRefs(&rc, q.base, &sq.refs)
            let tx = lexdb_sql.exprText(&r2)
            var have = false
            for c in conds { if lexdb_sql.exprText(&c) == tx { have = true } }
            if !have { append(mut &conds, r2) }
        }
        match inl {
            Some(il) {
                // IN by its value's column: the lookup's key is x
                path.index = il.ix
                append(mut &path.eqs, lexdb_sql.cloneExpr(&il.x))
                if il.eq { append(mut &conds, Expr.Bin("=", Expr.Col(to[il.col].clone(), first + il.col), lexdb_sql.cloneExpr(&il.x))) }
            }
            None {
                path.index = sl.path.index
                for x in sl.path.eqs { append(mut &path.eqs, substRefs(&x, q.base, &sq.refs)) }
                for b in sl.path.rng { append(mut &path.rng, Bound{op: b.op.clone(), val: substRefs(&b.val, q.base, &sq.refs)}) }
                path.noNulls = sl.path.noNulls
            }
        }
        // a key column's equality with its path value, both integers: the
        // range holds exactly its rows (keyVal: a value out of the
        // column's range reads none), so no filter is left and a range
        // stops at its first row (bRange)
        let kc = keyCols(&sl.t, sl.path.index)
        var kept: []Expr = []
        for ci in 0..len(conds) {
            let c = replace(mut &conds[ci], Expr.Lit(Val.Null))
            var key = false
            match c {
                Expr.Bin(op, a, b) {
                    if op == "=" {
                        for j in 0..len(path.eqs) {
                            if j >= len(kc) || kc[j] < 0 || !lexdb_bind.isIntOid(sl.t.cols[kc[j]].typ.oid) { continue }
                            let want = &to[kc[j]]
                            let et = lexdb_sql.exprText(&path.eqs[j])
                            match a {
                                Expr.Col(n, _) { if n == want && lexdb_sql.exprText(&b) == et && lexdb_bind.isIntOid(exprOid(&b, &q.cols, pt)) { key = true } }
                                else {}
                            }
                            match b {
                                Expr.Col(n, _) { if n == want && lexdb_sql.exprText(&a) == et && lexdb_bind.isIntOid(exprOid(&a, &q.cols, pt)) { key = true } }
                                else {}
                            }
                        }
                    }
                }
                else {}
            }
            if !key { append(mut &kept, c) }
        }
        conds = kept
        estRows = sl.estRows
        estMax = sl.estMax
        match inl {
            Some(il) {
                estRows = if il.point { 1 } else { -1 }
                estMax = false
            }
            None {}
        }
    }
    // its columns read: those its filters name
    var ns: []str = []
    for c in conds { lexdb_sql.colNames(&c, mut &ns) }
    var need: []bool = []
    for j in 0..len(names) {
        let want = alias + "." + lexdb_catalog.ROWID + j.toStr()
        var used = false
        for n in ns { if n == want { used = true } }
        append(mut &need, used)
    }
    var lv = newLevel(rc(noTable()), &alias, lexdb_sql.J_INNER, first)
    lv.path = path
    lv.cond = conds
    lv.need = need
    lv.perRow = true
    lv.semi = true
    lv.anti = anti
    lv.semiSub = i
    lv.estRows = estRows
    lv.estMax = estMax
    return lv
}

// Level lv of semiLook taken: its table moved in from the subquery's
// level (which is no longer run), its columns added to q's, hidden.
fn semiLookAdd(q: mut &Query, lv: mut &Level, at: int) {
    let i = lv.semiSub
    lv.t = replace(mut &q.subs[i].sel.q.levels[at].t, rc(noTable()))
    let t = &lv.t
    for j in 0..len(t.cols) {
        // a name no query can use, in no * (hiddenName)
        var qc = lexdb_sql.colDef(&(lv.alias + "." + lexdb_catalog.ROWID + j.toStr()), t.cols[j].typ, t.cols[j].notNull)
        qc.coll = t.cols[j].coll.clone()
        qc.using = lexdb_sql.USING_HIDDEN
        addCol(q, qc)
    }
    q.subs[i].semi = true
}

// The rows the first k + 1 levels of q's order give, per k: the join
// order's estimates (costOrder's: each table's rows by its own conditions,
// a class of equal columns joining by its distinct values), before any
// semi-join. [] when one has no statistics or is not an inner join's
// plain table.
fn (q: &Query) orderRows(): []float {
    let nl = len(q.levels)
    if nl < 2 || nl > JOIN_SEARCH_MAX { return [] }
    for lv in q.levels {
        if isOuter(lv.join) || lv.lateral || lv.virt() || lv.est.rows < 0 { return [] }
    }
    var cs: []Expr = []
    for lv in q.levels { for c in lv.cond { if !hasSubCall(&c) { append(mut &cs, lexdb_sql.cloneExpr(&c)) } } }
    var masks: []int = []
    for x in cs { append(mut &masks, q.levelMask(&x)) }
    var base: []Way = []
    for k in 0..nl {
        var own: []Expr = []
        var ownMasks: []int = []
        for i in 0..len(cs) {
            if masks[i] == (1 << k) {
                append(mut &own, lexdb_sql.cloneExpr(&cs[i]))
                append(mut &ownMasks, masks[i])
            }
        }
        let t = float(q.levels[k].est.rows)
        var g = false
        append(mut &base, Way{rows: fmax(t * q.localShare(k, &own, &ownMasks, mut &g), 1.0f), cost: 0.0f, outer: false, inner: 0.0f})
    }
    var cmask: []int = []
    var cdist: []float = []
    let all = q.eqClasses(&cs)
    for x in 0..len(all) {
        if len(all[x].konst) > 0 { continue }
        var m = 0
        var ds: []float = array(nl, 0.0f)
        for i in 0..len(all[x].names) {
            let l = all[x].levels[i]
            if (m & (1 << l)) == 0 {
                m = m | (1 << l)
                ds[l] = q.distinctOf(&all[x].names[i], l)
            }
        }
        if m & (m - 1) == 0 { continue }
        append(mut &cmask, m)
        for d in ds { append(mut &cdist, d) }
    }
    var memo: Map[int, float] = newMap()
    var out: []float = []
    for k in 0..nl { append(mut &out, q.setRows((1 << (k + 1)) - 1, nl, &base, &cmask, &cdist, mut &memo)) }
    return out
}

// Reads a subquery's tables only the columns its output and its conditions
// name. Planned before it was unhashed, a semi-join's subquery still said
// "select *": its scan then fetched every column (q4/q21's lineitem) though
// the keys were all the join needed.
fn narrowSub(sel: mut &Sel) {
    // a window, a lock or a set-returning function reads columns its own
    // code names; those queries keep every column
    if len(sel.wins) > 0 || len(sel.locks) > 0 || len(sel.srf) > 0 { return }
    var xs: []str = []
    for x in sel.exprs { lexdb_sql.colNames(&x, mut &xs) }
    for g in sel.groupBy { lexdb_sql.colNames(&g, mut &xs) }
    // (an aggregate's arguments: its select list reads its slot)
    for sp in sel.specs {
        for a in sp.args { lexdb_sql.colNames(&a, mut &xs) }
        for o in sp.order { lexdb_sql.colNames(&o, mut &xs) }
        match sp.filter { Some(f) { lexdb_sql.colNames(&f, mut &xs) } None {} }
    }
    match sel.having { Some(x) { lexdb_sql.colNames(&x, mut &xs) } None {} }
    for x in sel.order { lexdb_sql.colNames(&x, mut &xs) }
    for x in sel.q.top { lexdb_sql.colNames(&x, mut &xs) }
    for k in 0..len(sel.q.levels) {
        let lv = &sel.q.levels[k]
        for x in lv.cond { lexdb_sql.colNames(&x, mut &xs) }
        for x in lv.post { lexdb_sql.colNames(&x, mut &xs) }
        for x in lv.local { lexdb_sql.colNames(&x, mut &xs) }
        for x in lv.hashVals { lexdb_sql.colNames(&x, mut &xs) }
    }
    var names: Map[str, int] = newMap()
    for x in xs { if !names.has(&lexdb_bind.colPart(&x)) { names.put(lexdb_bind.colPart(&x), 1) } }
    for k in 0..len(sel.q.levels) {
        if sel.q.levels[k].virt() { continue }
        var need: []bool = []
        for c in sel.q.levels[k].t.cols { append(mut &need, names.has(&c.name)) }
        if sel.q.levels[k].gen { lexdb_gen.needDeps(&sel.q.levels[k].t.cols, mut &need) }
        sel.q.levels[k].need = need
    }
}

// The semi-join level of conjunct c (subquery i) of q, or None: c stays.
// kind: IN's collation kind (resolve's); outer: about the rows reaching it.
fn semiLevel(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, c: &Expr, i: int, kind: int, pt: &[]int,
             alts: mut &[]Option[SubPlan], outer: float, params: &[]Val, anti: bool, lookOk: bool, rules: bool,
             exact: bool): Result[Option[Level], DbErr] {
    var keys = SemiKeys{vals: [], oids: [], names: [], res: []}
    var ok = false
    // NOT IN: a null-aware anti join (optimizer 50), no residual filter
    let na = anti && q.subs[i].use == lexdb_sql.SUB_IN
    // a lookup per row as a join's level (semiLook), in place of the
    // subquery run per row
    var look: Option[Level] = None
    var lookRun = 0.0f
    var inLooked = false
    var two: Option[TwoKey] = None
    if lookOk && !na && semiLookable(q, i) {
        let lk = semiLook(q, i, anti, pt)
        let rows = try semiRows(st, txn, mut &q.subs[i].sel.q.levels[0], params, rules)
        lookRun = semiLookRun(&q.subs[i].sel.q.levels[0].t, &lk, rows)
        look = Some(lk)
    } else if lookOk && !na && len(q.subs[i].sel.q.levels) == 2 {
        // EXISTS over two tables, one looked up, the other's rows a set
        // (optimizer 50, 5c)
        two = twoKey(q, i, 0)
        if two.isNone() { two = twoKey(q, i, 1) }
        match two {
            Some(tk) {
                let none: Option[InLook] = None
                let lk = semiLookOf(q, i, anti, pt, &none, tk.at, &tk.eq)
                let rows = try semiRows(st, txn, mut &q.subs[i].sel.q.levels[tk.at], params, rules)
                lookRun = semiLookRun(&q.subs[i].sel.q.levels[tk.at].t, &lk, rows)
                look = Some(lk)
            }
            None {}
        }
    } else if lookOk && !anti && (unnestMode & UN_LOOK) != 0 {
        // x IN (subquery) read per row by x (optimizer 50, 5c)
        match inLook(q, i, c, kind, pt) {
            Some(il) {
                let lk = semiLookOf(q, i, false, pt, &Some(il), 0, &"")
                lookRun = semiLookRun(&q.subs[i].sel.q.levels[0].t, &lk, if lk.estRows >= 0 { float(lk.estRows) } else { -1.0f })
                look = Some(lk)
                inLooked = true
            }
            None {}
        }
    }
    if alts[i].isSome() && !q.subs[i].hashed {
        var alt = replace(mut &alts[i], None).unwrap()
        let inner = try semiInner(st, txn, mut &alt.sel.q, params, rules)
        // the per-row plan's run (the subquery as planned, not alt), or
        // the lookup's
        var run = SEMI_RUN_PK + COST_DESCENT + COST_KEY_ROW
        if look.isSome() {
            run = lookRun
        } else if len(q.subs[i].sel.q.levels) > 0 {
            run = semiRun(&q.subs[i].sel.q.levels[0], inner)
        }
        if outer >= 0.0f && inner >= 0.0f && semiCheaper(outer, inner, run) && (!na || altSafe(&alt)) {
            match semiKeys(q, &alt, c, pt) {
                Some(sk) {
                    // (its keys' outer sides now evaluated per outer row, not inside each run)
                    if !na || (len(sk.res) == 0 && valsFree(q, &sk.vals)) {
                        keys = sk
                        ok = true
                        q.subs[i] = alt
                    }
                }
                None {}
            }
        }
    } else {
        // (an IN looked up per row instead where a hash costs more, by the statistics)
        var hashIt = true
        if inLooked {
            let inner = try semiInner(st, txn, mut &q.subs[i].sel.q, params, rules)
            hashIt = !(outer >= 0.0f && inner >= 0.0f && !semiCheaper(outer, inner, lookRun))
        }
        if hashIt {
            match semiKeys(q, &q.subs[i], c, pt) {
                Some(sk) {
                    if (!na || len(sk.res) == 0) && (!exact || valsFree(q, &sk.vals)) {
                        keys = sk
                        ok = true
                    }
                }
                None {}
            }
        }
    }
    if !ok {
        if look.isSome() {
            var lk = look.unwrap()
            var at = 0
            match two {
                Some(tk) {
                    twoSet(q, i, &tk, mut &lk)
                    at = tk.at
                }
                None {}
            }
            semiLookAdd(q, mut &lk, at)
            return Ok(Some(lk))
        }
        return Ok(None)
    }
    return Ok(Some(keyLevel(q, i, keys, kind, anti, na, false, pt)))
}

// The hashed level of subquery i of q (its rows run once, hashed by keys:
// semiKeys'): its columns added to q's, hidden; a semi or anti join's
// (anti), a null-aware one's (na: NOT IN, optimizer 50), a mark join's
// (mark: a last column, boolean, its mark; the level's slot of it is
// first + len(t.cols) - 1).
fn keyLevel(q: mut &Query, i: int, keys0: SemiKeys, kind: int, anti: bool, na: bool, mark: bool, pt: &[]int): Level {
    var keys = keys0
    let w = len(keys.vals)
    let nk = if q.subs[i].use == lexdb_sql.SUB_IN { w - 1 } else { w }
    // its name and its columns' are no names a query can use: no table, a
    // column in no *
    let alias = "\x00sj" + (i + 1).toStr()
    var t = noTable()
    t.name = alias.toStr()
    let first = len(q.cols)
    for j in 0..w {
        append(mut &t.cols, lexdb_sql.colDef(&(keys.names[j].toStr()), lexdb_sql.oidType(keys.oids[j]), false))
        var qc = lexdb_sql.colDef(&(alias + "." + lexdb_catalog.ROWID + j.toStr()), lexdb_sql.oidType(keys.oids[j]), false)
        qc.using = lexdb_sql.USING_HIDDEN
        addCol(q, qc)
    }
    // a correlated filter's own inner columns: output them with the keys,
    // and check the filter on each candidate row of the key's bucket
    var resCols: []str = []
    var resTypes: []lexdb_sql.TypeName = []
    {
        let sq = &q.subs[i].sel.q
        for x in keys.res {
            var ns: []str = []
            lexdb_sql.colNames(&x, mut &ns)
            for n in move(ns) {
                let ci = lexdb_bind.colIndex(&sq.cols, &n)
                if ci < 0 { continue }
                var have = false
                for y in resCols { if y == n { have = true } }
                if have { continue }
                append(mut &resCols, n.clone())
                append(mut &resTypes, sq.cols[ci].typ)
            }
        }
    }
    var resFrom: []str = []
    var resTo: []str = []
    for j in 0..len(resCols) {
        let n = &resCols[j]
        let pos = w + j
        append(mut &t.cols, lexdb_sql.colDef(&lexdb_bind.colPart(n), resTypes[j], false))
        var qc = lexdb_sql.colDef(&(alias + "." + lexdb_catalog.ROWID + pos.toStr()), resTypes[j], false)
        qc.using = lexdb_sql.USING_HIDDEN
        addCol(q, qc)
        var have = false
        let want = lexdb_sql.exprText(&Expr.Col(n.toStr(), -1))
        for e in q.subs[i].sel.exprs { if lexdb_sql.exprText(&e) == want { have = true } }
        if !have { append(mut &q.subs[i].sel.exprs, Expr.Col(n.toStr(), -1)) }
        append(mut &resFrom, n.toStr())
        append(mut &resTo, alias + "." + lexdb_catalog.ROWID + pos.toStr())
    }
    if mark {
        // a mark join's mark: true, false or NULL (IN), per outer row
        let pos = len(t.cols)
        append(mut &t.cols, lexdb_sql.colDef(&"mark", lexdb_sql.oidType(lexdb_sql.OID_BOOL), false))
        var qc = lexdb_sql.colDef(&(alias + "." + lexdb_catalog.ROWID + pos.toStr()), lexdb_sql.oidType(lexdb_sql.OID_BOOL), false)
        qc.using = lexdb_sql.USING_HIDDEN
        addCol(q, qc)
    }
    var lv = newLevel(rc(t), &alias, lexdb_sql.J_INNER, first)
    lv.src = i
    lv.perRow = false
    lv.semi = true
    lv.anti = anti
    var lcond: []Expr = []
    for x in keys.res {
        var rc = lexdb_sql.cloneExpr(&x)
        for j in 0..len(resFrom) { rc = lexdb_bind.renameCol(&rc, &resFrom[j], &resTo[j], first + w + j) }
        append(mut &lcond, rc)
    }
    // one "inner <> outer" filter: a bucket needs only whether it holds
    // more than one inner value, or the one it holds (q21's l_suppkey)
    if len(lcond) == 1 {
        match lcond[0] {
            Expr.Bin(op, a, b) {
                if op == "<>" {
                    var ii = -1
                    var oval = Expr.Lit(Val.Null)
                    match a {
                        Expr.Col(n, _) { for j in 0..len(resTo) { if resTo[j] == n { ii = j } } }
                        else {}
                    }
                    if ii >= 0 {
                        oval = lexdb_sql.cloneExpr(&b)
                    } else {
                        match b {
                            Expr.Col(n, _) { for j in 0..len(resTo) { if resTo[j] == n { ii = j } } }
                            else {}
                        }
                        if ii >= 0 { oval = lexdb_sql.cloneExpr(&a) }
                    }
                    var ovalOk = ii >= 0 && !hasSubCall(&oval)
                    if ovalOk {
                        var ns: []str = []
                        lexdb_sql.colNames(&oval, mut &ns)
                        for n in ns { for j in 0..len(resTo) { if resTo[j] == n { ovalOk = false } } }
                    }
                    if ovalOk {
                        lv.resNot = true
                        lv.resCol = w + ii
                        lv.resVal = oval
                    }
                }
            }
            else {}
        }
    }
    lv.cond = if lv.resNot { [] } else { lcond }
    var hc: []int = []
    var hk: []int = []
    for j in 0..w {
        append(mut &hc, j)
        // IN's value under its collation, as runSub keys its set
        append(mut &hk, if j == nk { kind } else { lexdb_sql.COLL_EXACT })
    }
    lv.hashCols = hc
    lv.hashVals = replace(mut &keys.vals, [])
    lv.hashKinds = hk
    // one integer key on both sides: materialize's own map (q4/q21's
    // order keys; a numeric's value is not an integer's key)
    if !na && !mark && len(lv.hashCols) == 1 && len(keys.oids) == 1 && lexdb_bind.isIntOid(keys.oids[0]) && lexdb_bind.isIntOid(exprOid(&lv.hashVals[0], &q.cols, pt)) {
        lv.hashInt = true
    }
    // (the row engine keys a null-aware level by keyPart, its summary too)
    if na { lv.mode = LV_NOTIN }
    if mark { lv.mode = LV_MARK }
    q.subs[i].semi = true
    // run whole, once: not stopping at its first row (EXISTS)
    if len(q.subs[i].sel.q.levels) > 0 { q.subs[i].sel.q.levels[0].stops = false }
    narrowSub(mut &q.subs[i].sel)
    return lv
}

// ---- the mark join (optimizer 50, 5b): a correlated EXISTS or IN under
// OR, NOT or CASE in WHERE, or in the select list, as a level whose last
// column is its value for the row (true, false, NULL), the expression
// reading that column

// The numbers of x's EXISTS and IN calls, in order, each once.
fn markCalls(x: &Expr, out: mut &[]int) {
    match x {
        Expr.Unary(_, a) { markCalls(&a, out) }
        Expr.Bin(_, a, b) {
            markCalls(&a, out)
            markCalls(&b, out)
        }
        Expr.IsNull(a, _) { markCalls(&a, out) }
        Expr.Cast(a, _) { markCalls(&a, out) }
        Expr.Call(n, args, _) {
            if (n == "#exists" || n == "#in") && len(args) > 0 {
                let i = lexdb_sql.litInt(&args[0])
                if i >= 0 && !hasIdx(out, i) { append(out, i) }
            }
            for a in args { markCalls(&a, out) }
        }
        else {}
    }
}

// How many calls of subquery i x has.
fn subUses(x: &Expr, i: int): int {
    match x {
        Expr.Unary(_, a) { return subUses(&a, i) }
        Expr.Bin(_, a, b) { return subUses(&a, i) + subUses(&b, i) }
        Expr.IsNull(a, _) { return subUses(&a, i) }
        Expr.Cast(a, _) { return subUses(&a, i) }
        Expr.Call(n, args, _) {
            var m = if lexdb_sql.isSubCall(&n) && len(args) > 0 && lexdb_sql.litInt(&args[0]) == i { 1 } else { 0 }
            for a in args { m += subUses(&a, i) }
            return m
        }
        else { return 0 }
    }
}

// The calls of subquery i in q's conditions (its levels', WHERE's with no FROM).
fn condUses(q: &Query, i: int): int {
    var m = 0
    for lv in q.levels {
        for x in lv.cond { m += subUses(&x, i) }
        for x in lv.post { m += subUses(&x, i) }
        for x in lv.local { m += subUses(&x, i) }
        for x in lv.path.eqs { m += subUses(&x, i) }
        for b in lv.path.rng { m += subUses(&b.val, i) }
        for x in lv.hashVals { m += subUses(&x, i) }
    }
    for x in q.top { m += subUses(&x, i) }
    return m
}

// x's first call of subquery i (None: none).
fn callOf(x: &Expr, i: int): Option[Expr] {
    match x {
        Expr.Unary(_, a) { return callOf(&a, i) }
        Expr.Bin(_, a, b) {
            let l = callOf(&a, i)
            if l.isSome() { return l }
            return callOf(&b, i)
        }
        Expr.IsNull(a, _) { return callOf(&a, i) }
        Expr.Cast(a, _) { return callOf(&a, i) }
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) && len(args) > 0 && lexdb_sql.litInt(&args[0]) == i { return Some(lexdb_sql.cloneExpr(x)) }
            for a in args {
                let c = callOf(&a, i)
                if c.isSome() { return c }
            }
            return None
        }
        else { return None }
    }
}

// x with each call of subquery i replaced by col.
fn markRepl(x: &Expr, i: int, col: &Expr): Expr {
    match x {
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), markRepl(&a, i, col)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), markRepl(&a, i, col), markRepl(&b, i, col)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(markRepl(&a, i, col), neg) }
        Expr.Cast(a, t) { return Expr.Cast(markRepl(&a, i, col), t) }
        Expr.Call(n, args, star) {
            if lexdb_sql.isSubCall(&n) && len(args) > 0 && lexdb_sql.litInt(&args[0]) == i { return lexdb_sql.cloneExpr(col) }
            var out: []Expr = []
            for a in args { append(mut &out, markRepl(&a, i, col)) }
            return Expr.Call(n.clone(), out, star)
        }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// Whether subquery i of q may be a mark join's: a correlated EXISTS or IN,
// no CTE's, no level's yet, its value as it is (no reading as another
// type: readAs), no correlated filter that is not a key.
fn markable(q: &Query, i: int, readAs: int): bool {
    if i < 0 || i >= len(q.subs) || readAs != 0 { return false }
    let sp = &q.subs[i]
    if (sp.use != lexdb_sql.SUB_EXISTS && sp.use != lexdb_sql.SUB_IN) || len(sp.sel.q.refs) == 0 || sp.cte >= 0 || sp.semi || len(sp.res) > 0 { return false }
    for lv in q.levels { if lv.path.inSub == i || lv.semiSub == i { return false } }
    return true
}

// The keys of a mark join of subquery i (its call in q's terms) where it
// is one: hashed as planned (9.9), or its plan to be hashed (alt) when the
// rows reaching it (outer) probing a hash cost less than a run each
// (fromAlt then set); its keys' and IN's outer values evaluated for every
// row, so none may fail (50.3). None: it stays as it is.
fn markKeys(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, call: &Expr, i: int, pt: &[]int, alts: mut &[]Option[SubPlan],
            outer: float, params: &[]Val, rules: bool, fromAlt: mut &bool): Result[Option[SemiKeys], DbErr] {
    var picked: Option[SemiKeys] = None
    if q.subs[i].hashed {
        picked = semiKeys(q, &q.subs[i], call, pt)
    } else if i < len(alts) && alts[i].isSome() && outer >= 0.0f {
        // (taken out to be costed, put back: markJoins takes it if chosen)
        var a = replace(mut &alts[i], None).unwrap()
        if a.hashed && altSafe(&a) {
            let inner = try semiInner(st, txn, mut &a.sel.q, params, rules)
            let run = if len(q.subs[i].sel.q.levels) > 0 { semiRun(&q.subs[i].sel.q.levels[0], inner) } else { SEMI_RUN_PK + COST_DESCENT + COST_KEY_ROW }
            if inner >= 0.0f && semiCheaper(outer, inner, run) {
                picked = semiKeys(q, &a, call, pt)
                fromAlt = picked.isSome()
            }
        }
        alts[i] = Some(a)
    }
    match picked {
        Some(sk) {
            if len(sk.res) == 0 && valsFree(q, &sk.vals) { return Ok(Some(sk)) }
            fromAlt = false
            return Ok(None)
        }
        None { return Ok(None) }
    }
}

// The mark joins of conjunct c of level k (its conditions cs, c the ci-th;
// the levels as they were, olds): each correlated EXISTS or IN in it that
// may be one (markable, called nowhere else, its keys by markKeys) a level
// placed after k (a build group's last member), the last of them with c,
// its calls read from the marks, as its condition. Placed only where no
// error moves (takeOutOk; then c's own outer parts must not fail either).
// The levels made (in order), [] none.
fn markJoins(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, c: &Expr, cs: &[]Expr, ci: int, olds: &[]Level, k: int, at: int,
             alts: mut &[]Option[SubPlan], fr: &lexdb_bind.Frame, pt: &[]int, outer: float, params: &[]Val, rules: bool, total: &[]int,
             copies: int): Result[[]Level, DbErr] {
    var nums: []int = []
    markCalls(c, mut &nums)
    var picks: []SemiKeys = []
    var froms: []bool = []
    var subs: []int = []
    for i in nums {
        let readAs = if i < len(fr.subReads) { fr.subReads[i] } else { 0 }
        if !markable(q, i, readAs) || i >= len(fr.subKinds) || total[i] != subUses(c, i) * copies { continue }
        let call = callOf(c, i).unwrap()
        var fromAlt = false
        let got = try markKeys(st, txn, q, &call, i, pt, alts, outer, params, rules, mut &fromAlt)
        match got {
            Some(sk) {
                append(mut &picks, sk)
                append(mut &froms, fromAlt)
                append(mut &subs, i)
            }
            None {}
        }
    }
    if len(subs) == 0 { return Ok([]) }
    // the conjunct with its marks read as values: what is evaluated later
    var stub = lexdb_sql.cloneExpr(c)
    for i in subs { stub = markRepl(&stub, i, &Expr.Lit(Val.Bool(true))) }
    var exact = false
    if !takeOutOk(q, cs, ci, olds, k, at, mut &exact) || (exact && !noFail(q, &stub)) { return Ok([]) }
    var out: []Level = []
    var cond = lexdb_sql.cloneExpr(c)
    for j in 0..len(subs) {
        let i = subs[j]
        if froms[j] { q.subs[i] = replace(mut &alts[i], None).unwrap() }
        let lv = keyLevel(q, i, replace(mut &picks[j], SemiKeys{vals: [], oids: [], names: [], res: []}), fr.subKinds[i], false, false, true, pt)
        let slot = lv.first + len(lv.t.cols) - 1
        cond = markRepl(&cond, i, &Expr.Col(q.cols[slot].name.clone(), slot))
        append(mut &out, lv)
    }
    out[len(out) - 1].cond = [cond]
    return Ok(out)
}

// Each subquery whose call is in a WHERE conjunct as parsed under OR, NOT
// or CASE (not a semi join's candidate: semiParsed), marked in cand: a mark
// join's, its plan to be hashed planned (planFrom); whether any.
fn markCands(x: &Expr, cand: mut &[]bool): bool {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" {
                let l = markCands(&a, cand)
                let r = markCands(&b, cand)
                return l || r
            }
        }
        else {}
    }
    if semiParsed(x) >= 0 { return false }
    var nums: []int = []
    parsedCalls(x, mut &nums)
    var any = false
    for i in nums {
        if i < len(cand) {
            cand[i] = true
            any = true
        }
    }
    return any
}

// The numbers of x's EXISTS and IN calls as parsed (#exists(i), #in(i, x)).
fn parsedCalls(x: &Expr, out: mut &[]int) {
    match x {
        Expr.Unary(_, a) { parsedCalls(&a, out) }
        Expr.Bin(_, a, b) {
            parsedCalls(&a, out)
            parsedCalls(&b, out)
        }
        Expr.IsNull(a, _) { parsedCalls(&a, out) }
        Expr.Cast(a, _) { parsedCalls(&a, out) }
        Expr.Call(n, args, _) {
            if (n == "#exists" || n == "#in") && len(args) > 0 { append(out, lexdb_sql.litInt(&args[0])) }
            for a in args { parsedCalls(&a, out) }
        }
        else {}
    }
}

// The select list's and ORDER BY's mark joins (optimizer 50, 5b) of a
// planned SELECT (bindSel, before its binding): each correlated EXISTS or
// IN 9.9 hashed that only they call, a level after the last, its calls
// read from its mark. Not in a query that groups, aggregates, has windows,
// a set operation, DISTINCT ON, locks, a function in FROM, MATCH_RECOGNIZE,
// TOP or WITH TIES, SELECT @v =; nor where its keys' or IN's outer values
// may fail (now evaluated for every row, not only those output).
pub fn selMarks(sel: mut &Sel) {
    if (unnestMode & UN_MARK) == 0 || len(sel.q.levels) == 0 || sel.aggQ || len(sel.groupBy) > 0 || len(sel.wins) > 0 || sel.setop != 0 ||
       sel.donKey > 0 || len(sel.locks) > 0 || len(sel.srf) > 0 || len(sel.mr) > 0 || sel.topMode != 0 || sel.withTies ||
       len(sel.feedback) > 0 || sel.first >= 0 || sel.having.isSome() || len(sel.gsets) > 0 || sel.rec >= 0 { return }
    var nums: []int = []
    for x in sel.exprs { markCalls(&x, mut &nums) }
    for x in sel.order { markCalls(&x, mut &nums) }
    if len(nums) == 0 { return }
    let pt: []int = []
    var any = false
    for i in nums {
        if !markable(&sel.q, i, if i < len(sel.q.subs) { sel.q.subs[i].readAs } else { 0 }) || !sel.q.subs[i].hashed || condUses(&sel.q, i) > 0 { continue }
        var call = Expr.Lit(Val.Null)
        for x in sel.exprs {
            match callOf(&x, i) {
                Some(c) { call = c }
                None {}
            }
        }
        for x in sel.order {
            match callOf(&x, i) {
                Some(c) { call = c }
                None {}
            }
        }
        let got = semiKeys(&sel.q, &sel.q.subs[i], &call, &pt)
        if got.isNone() { continue }
        let sk = got.unwrap()
        if len(sk.res) > 0 || !valsFree(&sel.q, &sk.vals) { continue }
        if !any {
            // (the logical plan keeps the list as resolved)
            sel.lp = takeLp(sel)
            any = true
        }
        let kind = sel.q.subs[i].kind
        let lv = keyLevel(mut &sel.q, i, sk, kind, false, false, true, &pt)
        let slot = lv.first + len(lv.t.cols) - 1
        let col = Expr.Col(sel.q.cols[slot].name.clone(), slot)
        append(mut &sel.q.levels, lv)
        for j in 0..len(sel.exprs) { sel.exprs[j] = markRepl(&sel.exprs[j], i, &col) }
        for j in 0..len(sel.order) { sel.order[j] = markRepl(&sel.order[j], i, &col) }
    }
    if !any { return }
    for j in 0..len(sel.q.cols) { if !sel.q.colAt.has(&sel.q.cols[j].name) { sel.q.colAt.put(sel.q.cols[j].name.toStr(), j) } }
    var corr = false
    for sp in sel.q.subs { if len(sp.sel.q.refs) > 0 && !sp.semi { corr = true } }
    sel.q.corr = corr
}

// ---- a correlated scalar aggregate as a grouped level (optimizer 51, 5d):
// the subquery run once, grouped by its keys "inner = outer" (hashSub's
// form), its rows a level hashed on the keys and LEFT joined (at most one
// row a key); the call read from the level's columns, a key with no rows
// given the aggregates over none (count 0, the others NULL)

// Whether sel (a scalar subquery as planned, or as hashSub hashed it:
// hashed) is one aggregate row over its tables: no GROUP BY of its own,
// HAVING, DISTINCT, LIMIT, set operation, window or function in FROM, its
// one output without a subquery.
fn scalarShape(sel: &Sel, hashed: bool): bool {
    if !sel.aggQ || sel.setop != 0 || sel.limit >= 0 || sel.offset > 0 || sel.having.isSome() || sel.distinct || len(sel.wins) > 0 ||
       len(sel.srf) > 0 || len(sel.mr) > 0 || len(sel.gsets) > 0 || len(sel.locks) > 0 || len(sel.q.levels) == 0 || sel.topMode != 0 ||
       len(sel.exprs) == 0 { return false }
    if hashed {
        if len(sel.groupBy) != len(sel.exprs) - 1 { return false }
    } else if len(sel.groupBy) > 0 || len(sel.exprs) != 1 {
        return false
    }
    return !hasSubCall(&sel.exprs[len(sel.exprs) - 1])
}

// Whether subquery i of q may be a grouped level: a correlated scalar
// aggregate of no CTE, no level's yet.
fn scalarCand(q: &Query, i: int): bool {
    if i < 0 || i >= len(q.subs) { return false }
    let sp = &q.subs[i]
    return sp.use == lexdb_sql.SUB_SCALAR && len(sp.sel.q.refs) > 0 && sp.cte < 0 && !sp.semi && scalarShape(&sp.sel, sp.hashed)
}

// Whether a grouped plan's aggregates (alt, planned again to be hashed)
// cannot fail: their arguments, FILTERs and ORDER BYs (run once over every
// key's rows, not only those a per-row run reads).
fn groupSafe(alt: &SubPlan): bool {
    // (its keys, its tables' conditions and paths: altSafe's; its value's
    // expression is evaluated per outer row where it can fail, groupLevel)
    for j in 0..len(alt.sel.exprs) - 1 { if !noFail(&alt.sel.q, &alt.sel.exprs[j]) { return false } }
    return specsSafe(alt)
}

// Its tables' conditions and paths, and the aggregates' arguments, FILTERs
// and ORDER BYs, cannot fail.
fn specsSafe(alt: &SubPlan): bool {
    let a = &alt.sel.q
    for x in a.top { if !noFail(a, &x) { return false } }
    for lv in a.levels {
        for x in lv.cond { if !noFail(a, &x) { return false } }
        for x in lv.post { if !noFail(a, &x) { return false } }
        for x in lv.local { if !noFail(a, &x) { return false } }
        for x in lv.path.eqs { if !noFail(a, &x) { return false } }
        for b in lv.path.rng { if !noFail(a, &b.val) { return false } }
        for x in lv.hashVals { if !noFail(a, &x) { return false } }
    }
    for sp in alt.sel.specs {
        for x in sp.args { if !noFail(a, &x) { return false } }
        for x in sp.order { if !noFail(a, &x) { return false } }
        match sp.filter {
            Some(f) { if !noFail(a, &f) { return false } }
            None {}
        }
    }
    return true
}

// x with each aggregate's slot (#agg(j)) replaced by repl[j].
fn aggRepl(x: &Expr, repl: &[]Expr): Expr {
    match x {
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), aggRepl(&a, repl)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), aggRepl(&a, repl), aggRepl(&b, repl)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(aggRepl(&a, repl), neg) }
        Expr.Cast(a, t) { return Expr.Cast(aggRepl(&a, repl), t) }
        Expr.Call(n, args, star) {
            if n == "#agg" && len(args) == 1 {
                let j = lexdb_sql.litInt(&args[0])
                if j >= 0 && j < len(repl) { return lexdb_sql.cloneExpr(&repl[j]) }
            }
            var out: []Expr = []
            for a in args { append(mut &out, aggRepl(&a, repl)) }
            return Expr.Call(n.clone(), out, star)
        }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// The numbers of x's scalar subquery calls (#sub), each once.
fn scalarCalls(x: &Expr, out: mut &[]int) {
    match x {
        Expr.Unary(_, a) { scalarCalls(&a, out) }
        Expr.Bin(_, a, b) {
            scalarCalls(&a, out)
            scalarCalls(&b, out)
        }
        Expr.IsNull(a, _) { scalarCalls(&a, out) }
        Expr.Cast(a, _) { scalarCalls(&a, out) }
        Expr.Call(n, args, _) {
            if n == "#sub" && len(args) > 0 {
                let i = lexdb_sql.litInt(&args[0])
                if i >= 0 && !hasIdx(out, i) { append(out, i) }
            }
            for a in args { scalarCalls(&a, out) }
        }
        else {}
    }
}

// A grouped level's rows held, about, per row read (the groups' upper
// bound: one per inner row), for the statement's memory (a hash may hold
// at most half of it).
const GROUP_ROW_BYTES: float = 200.0f

// Subquery i's plan to be hashed (planned again without outer values as
// keys, section 42's alternative), where taking it may pay: planned only
// when a hash of the per-row plan's largest table, read whole, could cost
// less than the runs per row (outer rows reaching it); a planning of its
// own for each such subquery, so not for q2's, q17's and q20's (their runs
// cost a fraction of reading the table). None: not planned, or not one to
// hash (semiAltOk, its shape, groupSafe). Not where reading may stop early,
// in a transaction whose reads are noted, or in the rules mode.
fn scalarAlt(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, i: int, subs: &[]lexdb_sql.Stmt, params: &[]Val, sc: mut &Scope,
             hs: &FromHints, outer: float): Result[Option[SubPlan], DbErr] {
    if hs.early || txn.noting() || hs.rules || outer < 0.0f || i >= len(subs) { return Ok(None) }
    let sq = &q.subs[i].sel.q
    var big = -1.0f
    for lv in sq.levels {
        if lv.virt() { return Ok(None) }
        let rows = if lv.est.rows >= 0 { lv.est.rows } else { (try lexdb_stats.loadEst(st, txn, &lv.t, true, hs.rules)).rows }
        if rows < 0 { return Ok(None) }
        if float(rows) > big { big = float(rows) }
    }
    let run = if len(sq.levels) > 0 { semiRun(&sq.levels[0], big) } else { SEMI_RUN_PK + COST_DESCENT + COST_KEY_ROW }
    if groupJoin(big, len(sq.levels)) >= outer * run { return Ok(None) }
    sc.noRefKeys = true
    let nf = len(sc.names.frames)
    let again = up().planSub(st, txn, &subs[i], params, sc, false)
    sc.noRefKeys = false
    // (a plan that failed may have left its frame: this query's is the top one)
    while len(sc.names.frames) > nf { let gone = pop(mut &sc.names.frames) }
    let got = again.ok()
    if got.isNone() { return Ok(None) }
    let alt = got.unwrap()
    if alt.hashed && semiAltOk(&alt, &q.subs[i]) && scalarShape(&alt.sel, true) && groupSafe(&alt) { return Ok(Some(alt)) }
    return Ok(None)
}

// A grouped plan's cost over its rows (inner, read once and grouped as a
// hash is built), its later tables (of n) at least a lookup for each: a
// join's grouping is not one table's (q2's subquery over partsupp,
// supplier, nation and region: 800,000 rows, each joined three times).
fn groupJoin(inner: float, n: int): float { return inner * (COST_SCAN + HASH_BUILD) + inner * COST_KEY_ROW * float(if n > 1 { n - 1 } else { 0 }) }

// Whether subquery i's grouped plan to be hashed (alt) costs less than its
// run per outer row (outer rows reaching it), and its groups fit: the
// choice of optimizer 51 (semiCheaper's terms; the groups as the hash).
fn groupCheaper(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: &Query, i: int, alt: mut &SubPlan, outer: float, params: &[]Val,
                rules: bool, memMax: int): Result[bool, DbErr] {
    if rules || outer < 0.0f { return Ok(false) }
    let inner = try semiInner(st, txn, mut &alt.sel.q, params, rules)
    if inner < 0.0f { return Ok(false) }
    var cap = HASH_MAX_BYTES
    if memMax > 0 && float(memMax) / 2.0f < cap { cap = float(memMax) / 2.0f }
    if inner * GROUP_ROW_BYTES > cap { return Ok(false) }
    let run = if len(q.subs[i].sel.q.levels) > 0 { semiRun(&q.subs[i].sel.q.levels[0], inner) } else { SEMI_RUN_PK + COST_DESCENT + COST_KEY_ROW }
    if outer <= 1.0f { return Ok(false) }
    return Ok(groupJoin(inner, len(alt.sel.q.levels)) + outer * HASH_PROBE < outer * run)
}

// The grouped level of subquery i of q (hashed: hashSub's form; 9.9's, or
// its plan to be hashed chosen by cost), and what its call becomes: the
// level's columns are the keys, then the value (its expression evaluated
// per group where it cannot fail, or 9.9 evaluated it so already) or the
// aggregates (the expression then evaluated per outer row, as a per-row run
// evaluates it). A key with no group: the expression over no rows, also
// per outer row (so its error, 1/count(*), only where a key has none).
// None: not one (keys' types a hash would compare otherwise, a key's outer
// value that may fail, an aggregate whose type is not known here).
pub type GroupLevel = record { pub lv: Level; pub repl: Expr }

// Whether groupLevel makes subquery i's level (its checks, nothing changed):
// -1 not; 0 its expression per group; 1 its aggregates, the expression per
// outer row (split).
fn groupCheck(q: &Query, i: int, pt: &[]int, safe: bool): int {
    let sp = &q.subs[i]
    let nk = len(sp.keyOuter)
    if !sp.hashed || nk == 0 || len(sp.sel.exprs) != nk + 1 || len(sp.res) > 0 || !scalarShape(&sp.sel, true) { return -1 }
    let sq = &sp.sel.q
    var vals: []Expr = []
    for j in 0..nk {
        let ov = substRefs(&sp.keyOuter[j], q.base, &sq.refs)
        let io = exprOid(&sp.sel.exprs[j], &sq.cols, pt)
        if hasSubCall(&ov) || !semiTypes(io, exprOid(&ov, &q.cols, pt)) { return -1 }
        append(mut &vals, ov)
    }
    if !valsFree(q, &vals) { return -1 }
    var ac: []Expr = []
    for j in 0..len(sp.sel.specs) { append(mut &ac, Expr.Col("#a", j)) }
    let split = !safe && !grpSafe(&aggRepl(&sp.sel.exprs[nk], &ac))
    for spec in sp.sel.specs {
        let a = lexdb_agg.newAccs(1)
        if lexdb_agg.finish(&spec, &a[0]).isErr() { return -1 }
        // count, sum, avg, min and max: their types as the select list's (exprOid)
        if split && spec.op != lexdb_agg.OP_COUNT && spec.op != lexdb_agg.OP_SUM && spec.op != lexdb_agg.OP_AVG && spec.op != lexdb_agg.OP_MIN &&
           spec.op != lexdb_agg.OP_MAX { return -1 }
    }
    return if split { 1 } else { 0 }
}

// (groupCheck's checks passed: it is made)
fn groupLevel(q: mut &Query, i: int, pt: &[]int, safe: bool): Option[GroupLevel] {
    let nk = len(q.subs[i].keyOuter)
    if groupCheck(q, i, pt, safe) < 0 { return None }
    var vals: []Expr = []
    var oids: []int = []
    var names: []str = []
    {
        let sp = &q.subs[i]
        let sq = &sp.sel.q
        for j in 0..nk {
            let ov = substRefs(&sp.keyOuter[j], q.base, &sq.refs)
            let io = exprOid(&sp.sel.exprs[j], &sq.cols, pt)
            if hasSubCall(&ov) || !semiTypes(io, exprOid(&ov, &q.cols, pt)) { return None }
            let nm = match sp.sel.exprs[j] {
                Expr.Col(n, _) { lexdb_bind.colPart(&n) }
                else { lexdb_sql.exprText(&sp.sel.exprs[j]) }
            }
            append(mut &vals, ov)
            append(mut &oids, io)
            append(mut &names, nm)
        }
    }
    if !valsFree(q, &vals) { return None }
    let e = lexdb_sql.cloneExpr(&q.subs[i].sel.exprs[nk])
    // the expression per group (it cannot fail, or 9.9 runs it so: safe), or
    // its aggregates, the expression per outer row
    var ac: []Expr = []
    for j in 0..len(q.subs[i].sel.specs) { append(mut &ac, Expr.Col("#a", j)) }
    let split = !safe && !grpSafe(&aggRepl(&e, &ac))
    var vnames: []str = []
    var voids: []int = []
    var empties: []Expr = []
    {
        let sp = &q.subs[i]
        for spec in sp.sel.specs {
            let a = lexdb_agg.newAccs(1)
            match lexdb_agg.finish(&spec, &a[0]) {
                Ok(v) { append(mut &empties, Expr.Lit(v)) }
                Err(_) { return None }
            }
            if split {
                // count, sum, avg, min and max: their types as the select list's (exprOid)
                if spec.op != lexdb_agg.OP_COUNT && spec.op != lexdb_agg.OP_SUM && spec.op != lexdb_agg.OP_AVG && spec.op != lexdb_agg.OP_MIN &&
                   spec.op != lexdb_agg.OP_MAX { return None }
                append(mut &voids, exprOid(&Expr.Call(spec.fname.toStr(), lexdb_sql.cloneAllExpr(&spec.args), spec.star), &sp.sel.q.cols, pt))
                append(mut &vnames, spec.fname.toStr())
            }
        }
        if !split {
            append(mut &voids, sp.oid)
            append(mut &vnames, sp.name.toStr())
        }
    }
    let alias = "\x00sg" + (i + 1).toStr()
    var t = noTable()
    t.name = alias.toStr()
    let first = len(q.cols)
    for j in 0..nk {
        append(mut &t.cols, lexdb_sql.colDef(&names[j], lexdb_sql.oidType(oids[j]), false))
        var qc = lexdb_sql.colDef(&(alias + "." + lexdb_catalog.ROWID + j.toStr()), lexdb_sql.oidType(oids[j]), false)
        qc.using = lexdb_sql.USING_HIDDEN
        addCol(q, qc)
    }
    var cols: []Expr = []
    for j in 0..len(voids) {
        let pos = nk + j
        append(mut &t.cols, lexdb_sql.colDef(&vnames[j], lexdb_sql.oidType(voids[j]), false))
        var qc = lexdb_sql.colDef(&(alias + "." + lexdb_catalog.ROWID + pos.toStr()), lexdb_sql.oidType(voids[j]), false)
        qc.using = lexdb_sql.USING_HIDDEN
        addCol(q, qc)
        append(mut &cols, Expr.Col(q.cols[first + pos].name.clone(), first + pos))
    }
    // the value for an outer row: the group's, or over no rows when its key
    // has none (its first key column NULL: no group matched)
    let got = if split { aggRepl(&e, &cols) } else { lexdb_sql.cloneExpr(&cols[0]) }
    let none = aggRepl(&e, &empties)
    var repl = got
    var fold = false
    var folded = Val.Null
    if !hasParamIn(&none) && lexdb_bind.immutable(&none) {
        let noVals: []Val = []
        match up().eval(&none, &noVals) {
            Ok(v) {
                fold = true
                folded = v
            }
            Err(_) {}
        }
    }
    // (over no rows NULL: the NULL the LEFT join gives is it, when the
    // expression gives NULL for NULL aggregates, as one of its columns does)
    let nullOk = fold && lexdb_ops.isNull(&folded) && (!split || strictOf(&e))
    if !nullOk {
        let k0 = Expr.Col(q.cols[first].name.clone(), first)
        let dflt = if fold { Expr.Lit(folded) } else { none }
        repl = Expr.Call("case else", [Expr.IsNull(k0, false), dflt, replace(mut &repl, Expr.Lit(Val.Null))], false)
    }
    if split {
        var outs: []Expr = []
        for j in 0..nk { append(mut &outs, lexdb_sql.cloneExpr(&q.subs[i].sel.exprs[j])) }
        for j in 0..len(q.subs[i].sel.specs) { append(mut &outs, Expr.Call("#agg", [Expr.Lit(Val.Int(j))], false)) }
        q.subs[i].sel.exprs = outs
    }
    var lv = newLevel(rc(t), &alias, lexdb_sql.J_LEFT, first)
    lv.src = i
    lv.perRow = false
    var hc: []int = []
    var hk: []int = []
    for j in 0..nk {
        append(mut &hc, j)
        append(mut &hk, lexdb_sql.COLL_EXACT)
    }
    lv.hashCols = hc
    lv.hashVals = vals
    lv.hashKinds = hk
    q.subs[i].semi = true
    narrowSub(mut &q.subs[i].sel)
    return Some(GroupLevel{lv: lv, repl: repl})
}

// Whether x has a statement parameter or an outer value.
fn hasParamIn(x: &Expr): bool {
    match x {
        Expr.Param(_) { return true }
        Expr.Unary(_, a) { return hasParamIn(&a) }
        Expr.Bin(_, a, b) { return hasParamIn(&a) || hasParamIn(&b) }
        Expr.IsNull(a, _) { return hasParamIn(&a) }
        Expr.Cast(a, _) { return hasParamIn(&a) }
        Expr.Call(_, args, _) {
            for a in args { if hasParamIn(&a) { return true } }
            return false
        }
        else { return false }
    }
}

// Whether x is NULL when any aggregate it reads is (arithmetic, casts and
// comparisons of them and of constants: the LEFT join's NULLs then give it).
fn strictOf(x: &Expr): bool {
    match x {
        Expr.Call(n, args, _) { return n == "#agg" && len(args) == 1 }
        Expr.Unary(op, a) { return (op == "-" || op == "not") && strictOf(&a) }
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" || op == "||" { return false }
            let la = isConstLit(&a)
            let lb = isConstLit(&b)
            return (strictOf(&a) && (lb || strictOf(&b))) || (strictOf(&b) && la)
        }
        Expr.Cast(a, _) { return strictOf(&a) }
        else { return false }
    }
}

fn isConstLit(x: &Expr): bool {
    match x {
        Expr.Lit(v) { return !lexdb_ops.isNull(&v) }
        Expr.Cast(a, _) { return isConstLit(&a) }
        else { return false }
    }
}

// The grouped levels of q's WHERE (optimizer 51): each conjunct of a
// level's conditions whose scalar calls may each be one (scalarCand,
// called nowhere else; 9.9's hashed, or its plan to be hashed where that
// costs less: groupCheaper) is taken out, its levels placed after its
// level (a build group's last member), the conjunct with the calls read
// from them the last one's WHERE conjunct (post). Placed only where no
// error moves (takeOutOk).
fn scalarJoins(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, params: &[]Val, subs: &[]lexdb_sql.Stmt, sc: mut &Scope,
               hs: &FromHints): Result[Unit, DbErr] {
    let rules = hs.rules
    let memMax = hs.memMax
    var alts: []Option[SubPlan] = []
    for i in 0..len(q.subs) { append(mut &alts, None) }
    let pt = lexdb_bind.ptypesOf(&sc.names)
    let nl = len(q.levels)
    if nl == 0 { return Ok(Unit{}) }
    var total: []int = []
    for i in 0..len(q.subs) { append(mut &total, condUses(q, i)) }
    var cands = false
    for i in 0..len(q.subs) { if scalarCand(q, i) { cands = true } }
    if !cands { return Ok(Unit{}) }
    // the rows reaching a level: the join order's estimates, else (none:
    // one table's query) its first table's (statistics loaded only then)
    let est = q.orderRows()
    var first = -1.0f
    if len(est) != nl { first = try semiRows(st, txn, mut &q.levels[0], params, rules) }
    var gEnd: []int = []
    for k in 0..nl { append(mut &gEnd, k) }
    for h in 0..nl { for l in h..h + q.levels[h].grp { if l < nl { gEnd[l] = h + q.levels[h].grp } } }
    var olds = replace(mut &q.levels, [])
    var placed: [][]Level = []
    for k in 0..nl { append(mut &placed, []) }
    var any = false
    for k in 0..nl {
        var lv = replace(mut &olds[k], newLevel(rc(noTable()), "", 0, 0))
        if !isOuter(lv.join) && lv.mode == 0 && len(lv.cond) > 0 {
            var cs = replace(mut &lv.cond, [])
            var keep: []Expr = []
            var taken: []str = []
            for ci in 0..len(cs) {
                var nums: []int = []
                scalarCalls(&cs[ci], mut &nums)
                var made: []Level = []
                if len(nums) > 0 {
                    let c = &cs[ci]
                    let at = gEnd[k]
                    let outer = if len(est) == nl { est[at] } else { first }
                    let ct = lexdb_sql.exprText(c)
                    var copies = 1
                    for x in lv.local { if lexdb_sql.exprText(&x) == ct { copies += 1 } }
                    var exact = false
                    var ok = takeOutOk(q, &cs, ci, &olds, k, at, mut &exact)
                    // the conjunct with its calls read as values: nothing per
                    // row left in it; evaluated on fewer rows (exact), it may
                    // not fail, nor may an expression then evaluated per row
                    var stub = lexdb_sql.cloneExpr(c)
                    for i in nums { stub = markRepl(&stub, i, &Expr.Lit(Val.Null)) }
                    if hasCorr(&stub) || (exact && !noFail(q, &stub)) { ok = false }
                    // first which plan each call takes (9.9's hashed, or its
                    // plan to be hashed where it costs less) and whether its
                    // level can be made; then the levels
                    var olds2: []SubPlan = []          // the per-row plans replaced, put back if not taken
                    var swapped: []int = []
                    var safes: []bool = []
                    for i in nums {
                        if !ok { break }
                        if !scalarCand(q, i) || total[i] != subUses(c, i) * copies { ok = false; break }
                        let safe = q.subs[i].hashed
                        if !safe {
                            // 9.9 could not hash it (an outer value its path's key)
                            var took = false
                            if alts[i].isNone() { alts[i] = try scalarAlt(st, txn, q, i, subs, params, sc, hs, outer) }
                            if alts[i].isSome() {
                                var a = replace(mut &alts[i], None).unwrap()
                                if try groupCheaper(st, txn, q, i, mut &a, outer, params, rules, memMax) {
                                    append(mut &olds2, replace(mut &q.subs[i], a))
                                    append(mut &swapped, i)
                                    took = true
                                } else {
                                    alts[i] = Some(a)
                                }
                            }
                            if !took { ok = false; break }
                        }
                        let how = groupCheck(q, i, &pt, safe)
                        if how < 0 || (how == 1 && exact) { ok = false; break }
                        append(mut &safes, safe)
                    }
                    if ok && len(safes) == len(nums) {
                        var cond = lexdb_sql.cloneExpr(c)
                        for j in 0..len(nums) {
                            let GroupLevel{lv: glv, repl: grepl} = groupLevel(q, nums[j], &pt, safes[j]).unwrap()
                            cond = markRepl(&cond, nums[j], &grepl)
                            append(mut &made, glv)
                        }
                        let n = len(made)
                        made[n - 1].post = [cond]
                        for j in 0..n { append(mut &placed[at], replace(mut &made[j], newLevel(rc(noTable()), "", 0, 0))) }
                        append(mut &taken, ct)
                        any = true
                        continue
                    }
                    // not taken: the per-row plans back
                    while len(swapped) > 0 {
                        let i = pop(mut &swapped)
                        let back = pop(mut &olds2)
                        alts[i] = Some(replace(mut &q.subs[i], back))
                    }
                }
                append(mut &keep, replace(mut &cs[ci], Expr.Lit(Val.Null)))
            }
            lv.cond = keep
            if len(taken) > 0 {
                var ls = replace(mut &lv.local, [])
                var lkeep: []Expr = []
                for li in 0..len(ls) {
                    let lc = replace(mut &ls[li], Expr.Lit(Val.Null))
                    let lt = lexdb_sql.exprText(&lc)
                    var drop = false
                    for g in taken { if g == lt { drop = true } }
                    if !drop { append(mut &lkeep, lc) }
                }
                lv.local = lkeep
            }
        }
        append(mut &q.levels, lv)
        for j in 0..len(placed[k]) { append(mut &q.levels, replace(mut &placed[k][j], newLevel(rc(noTable()), "", 0, 0))) }
    }
    // the select list's (no condition calls them): its plan to be hashed
    // where it costs less over the query's rows, and only where its value is
    // made per group without fail (selScalars makes the level; where it
    // cannot, 9.9's hashed probe reads it, as it would any hashed one)
    for i in 0..len(q.subs) {
        if total[i] > 0 || !scalarCand(q, i) || q.subs[i].hashed { continue }
        let outer = if len(est) == nl { est[nl - 1] } else { first }
        if alts[i].isNone() { alts[i] = try scalarAlt(st, txn, q, i, subs, params, sc, hs, outer) }
        if alts[i].isNone() { continue }
        var a = replace(mut &alts[i], None).unwrap()
        if try groupCheaper(st, txn, q, i, mut &a, outer, params, rules, memMax) {
            let back = replace(mut &q.subs[i], a)
            if groupCheck(q, i, &pt, false) != 0 { alts[i] = Some(replace(mut &q.subs[i], back)) }
        } else {
            alts[i] = Some(a)
        }
    }
    if !any { return Ok(Unit{}) }
    for i in 0..len(q.cols) { if !q.colAt.has(&q.cols[i].name) { q.colAt.put(q.cols[i].name.toStr(), i) } }
    var corr = false
    for sp in q.subs { if len(sp.sel.q.refs) > 0 && !sp.semi { corr = true } }
    q.corr = corr
    return Ok(Unit{})
}

// ---- a correlated FROM subquery (LATERAL, CROSS and OUTER APPLY) with an
// aggregate as a join and a grouping (optimizer 51, 5e): its outer values
// only in WHERE equalities "inner = outer" (hashSub's keys), the
// equalities taken out and their inner sides added to its GROUP BY and,
// hidden, to its columns; run once, its rows joined on them by hash.
// - With a GROUP BY: a key with no rows has no group, as a run of it has
//   no row: CROSS or INNER joined, a LEFT JOIN's row kept with NULLs.
// - Without: one row for every outer row (its aggregates over no rows for a
//   key with none): LEFT joined, a column whose value over no rows is not
//   the join's NULL (count's 0) read as that value where the key had no
//   group (dflt). Only CROSS (APPLY, a comma) or a LEFT or INNER JOIN ON
//   true: another ON would drop or keep the row by the values.
// Not where it may stop or order per outer row (LIMIT, a window, a set
// operation, DISTINCT), nor where anything run once over every key's rows
// could fail where a run per row would not (its conditions, the
// aggregates' arguments, its outputs and HAVING over the aggregates).
// By the rule 9.9 hashes by: not where an outer value is its path's key
// (an index on it: a run per row reads only its rows).
pub type LateralKeys = record {
    pub outer: []Expr               // per key, its outer side in the outer query's terms (the hidden column's equal)
    pub dflt: []Option[Expr]        // per output column: its value for a key with no group where not NULL
    pub left: bool                  // LEFT joined (no GROUP BY)
    pub on: []Expr                  // its keys' equalities, its level's ON conjuncts (lateralOn; planFrom adds them)
}

// lateralGroup's checks of sel: -1 not; 0 no GROUP BY; 1 GROUP BY.
fn lateralShape(sel: &Sel, base: int, join: int, onTrue: bool): int {
    if !sel.aggQ || sel.setop != 0 || sel.limit >= 0 || sel.offset > 0 || sel.distinct || len(sel.wins) > 0 || len(sel.srf) > 0 ||
       len(sel.mr) > 0 || len(sel.gsets) > 0 || len(sel.locks) > 0 || sel.topMode != 0 || sel.withTies || len(sel.feedback) > 0 ||
       sel.donKey > 0 || len(sel.q.levels) == 0 || len(sel.exprs) != len(sel.outs) || len(sel.exprs) == 0 { return -1 }
    let grouped = len(sel.groupBy) > 0
    let inner = join == lexdb_sql.J_INNER || join == lexdb_sql.J_CROSS
    if !(inner || join == lexdb_sql.J_LEFT) { return -1 }
    if !grouped && (sel.having.isSome() || !(join == lexdb_sql.J_CROSS || onTrue)) { return -1 }
    if !noRefs(&sel.exprs, base) || !noRefs(&sel.order, base) || !noRefs(&sel.groupBy, base) { return -1 }
    match sel.having {
        Some(h) { if usesRefs(&h, base) || !grpSafe(&aggRepl(&h, &aggCols(len(sel.specs)))) { return -1 } }
        None {}
    }
    return if grouped { 1 } else { 0 }
}

// The keys "inner = outer" of sel's conditions, its outer values used in
// no other way (hashSub's, no residual); None not.
fn lateralKeys(sel: &Sel, base: int): Option[HashKeys] {
    var hk = HashKeys{inner: [], outer: [], texts: [], res: []}
    let q = &sel.q
    for lv in q.levels {
        if lv.virt() || lv.lateral { return None }
        if !noRefs(&lv.path.eqs, base) || !noRefs(&lv.path.ins, base) || !noRefs(&lv.hashVals, base) { return None }
        if lv.semi && (!noRefs(&lv.cond, base) || usesRefs(&lv.resVal, base)) { return None }
        for b in lv.path.rng { if usesRefs(&b.val, base) { return None } }
        if !keyConjs(&lv.cond, base, mut &hk, !isOuter(lv.join), false, &q.cols) { return None }
        if !keyConjs(&lv.post, base, mut &hk, true, false, &q.cols) { return None }
        if !keyConjs(&lv.local, base, mut &hk, !isOuter(lv.join), false, &q.cols) { return None }
    }
    if !keyConjs(&q.top, base, mut &hk, true, false, &q.cols) { return None }
    if len(hk.inner) == 0 { return None }
    for x in hk.outer { if hasSubCall(&x) || !lexdb_bind.immutable(&x) { return None } }
    return Some(hk)
}

// lateralGroup's, kept on sp (SubPlan.lat): how many hidden key columns
// it adds after its own; 0 not one.
pub fn lateralGroup(sp: mut &SubPlan, base: int, join: int, onTrue: bool): int {
    match lateralGroupOf(sp, base, join, onTrue) {
        Some(lk) {
            let n = len(lk.outer)
            sp.lat = [lk]
            return n
        }
        None { return 0 }
    }
}

// Its level's ON conjuncts (lateralOn's) into ms (planFrom: after the ONs
// are read from the logical plan).
fn lateralMs(q: &Query, ms: mut &[][]Expr) {
    for k in 0..len(q.levels) {
        let src = q.levels[k].src
        if src < 0 || src >= len(q.subs) || len(q.subs[src].lat) == 0 || k >= len(ms) { continue }
        for x in q.subs[src].lat[0].on { append(mut &ms[k], lexdb_sql.cloneExpr(&x)) }
    }
}

fn lateralGroupOf(sp: mut &SubPlan, base: int, join: int, onTrue: bool): Option[LateralKeys] {
    if (unnestMode & UN_LATERAL) == 0 || sp.cte >= 0 || len(sp.sel.q.refs) == 0 || sp.hashed { return None }
    let shape = lateralShape(&sp.sel, base, join, onTrue)
    if shape < 0 { return None }
    let grouped = shape == 1
    // run once over every key's rows: nothing in it may fail
    if !groupSafeAll(sp) { return None }
    var hk = match lateralKeys(&sp.sel, base) {
        Some(h) { h }
        None { return None }
    }
    // the values over no rows: per output, where the LEFT join's NULL is not it
    var dflt: []Option[Expr] = []
    if !grouped {
        var empties: []Expr = []
        for spec in sp.sel.specs {
            let a = lexdb_agg.newAccs(1)
            match lexdb_agg.finish(&spec, &a[0]) {
                Ok(v) { append(mut &empties, Expr.Lit(v)) }
                Err(_) { return None }
            }
        }
        for x in sp.sel.exprs {
            let none = aggRepl(&x, &empties)
            if hasParamIn(&none) || !lexdb_bind.immutable(&none) { return None }
            let noVals: []Val = []
            match up().eval(&none, &noVals) {
                Ok(v) { append(mut &dflt, if lexdb_ops.isNull(&v) { None } else { Some(Expr.Lit(v)) }) }
                Err(_) { return None }
            }
        }
    }
    for k in 0..len(sp.sel.q.levels) {
        sp.sel.q.levels[k].cond = dropTexts(replace(mut &sp.sel.q.levels[k].cond, []), &hk.texts)
        sp.sel.q.levels[k].post = dropTexts(replace(mut &sp.sel.q.levels[k].post, []), &hk.texts)
        sp.sel.q.levels[k].local = dropTexts(replace(mut &sp.sel.q.levels[k].local, []), &hk.texts)
    }
    sp.sel.q.top = dropTexts(replace(mut &sp.sel.q.top, []), &hk.texts)
    var koids: []int = []
    for x in hk.inner { append(mut &koids, exprOid(&x, &sp.sel.q.cols, &[])) }
    for xi in 0..len(hk.inner) {
        let x = &hk.inner[xi]
        append(mut &sp.sel.groupBy, lexdb_sql.cloneExpr(x))
        append(mut &sp.sel.groupKinds, lexdb_sql.COLL_EXACT)
        append(mut &sp.sel.exprs, lexdb_sql.cloneExpr(x))
        let nm = match x {
            Expr.Col(n, _) { lexdb_bind.colPart(&n) }
            else { lexdb_sql.exprText(x) }
        }
        append(mut &sp.sel.outs, lexdb_bind.OutCol{name: nm, oid: koids[xi], spell: "", coll: "", scale: -1})
        if len(sp.sel.outKinds) > 0 { append(mut &sp.sel.outKinds, lexdb_sql.COLL_EXACT) }
    }
    if len(sp.sel.ox) > 0 { sp.sel.ox = [] }
    sp.sel.first = -1
    sp.sel.order = []
    sp.sel.sort = false
    sp.sel.desc = []
    sp.sel.nullsFirst = []
    sp.sel.ordKinds = []
    sp.sel.lp = takeLp(mut &sp.sel)
    var texts: []str = []
    var outer: []Expr = []
    for i in 0..len(hk.inner) {
        let o = substRefs(&hk.outer[i], base, &sp.sel.q.refs)
        let it = match hk.inner[i] {
            Expr.Col(n, _) { n.clone() }
            else { lexdb_sql.exprText(&hk.inner[i]) }
        }
        let r = refOf(&hk.outer[i], base)
        var on = "an outer expression"
        if r >= 0 {
            on = match sp.sel.q.refs[r] {
                Expr.Col(n, _) { n.clone() }
                else { "an outer value" }
            }
        }
        append(mut &texts, it + " = " + on)
        append(mut &outer, o)
    }
    sp.hashed = true
    sp.keyOuter = replace(mut &hk.outer, [])
    sp.keyText = texts
    return Some(LateralKeys{outer: outer, dflt: dflt, left: !grouped, on: []})
}

// Whether a FROM item's ON is "true" (OUTER APPLY's, ON true) or absent.
pub fn onTrue(on: &Option[Expr]): bool {
    match on {
        Some(x) {
            match x {
                Expr.Lit(v) {
                    match v {
                        Val.Bool(b) { return b }
                        else { return false }
                    }
                }
                else { return false }
            }
        }
        None { return true }
    }
}

// A level's columns (first, n of them; the last ones lk's hidden keys) made
// lateralGroup's: the keys hidden, each equal to its outer side (its ON's
// conjuncts, returned); an output whose value over no rows is not NULL read
// as that value where no group joined (its first key NULL).
pub fn lateralOn(sp: mut &SubPlan, qcols: mut &[]lexdb_sql.ColDef, first: int, lv: mut &Level, virt: mut &bool) {
    if sp.lat[0].left { lv.join = lexdb_sql.J_LEFT } else if lv.join == lexdb_sql.J_CROSS { lv.join = lexdb_sql.J_INNER }
    let n = len(lv.t.cols)
    let nk = len(sp.lat[0].outer)
    let k0 = first + n - nk
    var out: []Expr = []
    for j in 0..nk {
        let slot = k0 + j
        let d = lexdb_bind.dotAt(&qcols[slot].name)
        let al = if d < 0 { "" } else { qcols[slot].name[0..d].clone() }
        qcols[slot].name = al + "." + lexdb_catalog.ROWID + "lk" + j.toStr()
        qcols[slot].using = lexdb_sql.USING_HIDDEN
        append(mut &out, Expr.Bin("=", Expr.Col(qcols[slot].name.clone(), slot), lexdb_sql.cloneExpr(&sp.lat[0].outer[j])))
    }
    for j in 0..len(sp.lat[0].dflt) {
        match sp.lat[0].dflt[j] {
            Some(d) {
                let slot = first + j
                let own = Expr.Col(qcols[slot].name.clone(), slot)
                let g = Expr.Call("case else", [Expr.IsNull(Expr.Col(qcols[k0].name.clone(), k0), false), lexdb_sql.cloneExpr(&d), own], false)
                qcols[slot].genKind = lexdb_sql.GEN_VIRTUAL
                qcols[slot].gen = Some(g)
                // (it keeps its name, as a virtual column does)
                virt = true
            }
            None {}
        }
    }
    sp.lat[0].on = out
}

fn aggCols(n: int): []Expr {
    var ac: []Expr = []
    for j in 0..n { append(mut &ac, Expr.Col("#a", j)) }
    return ac
}

// groupSafe over every output (a FROM subquery's outputs are all values,
// each over the aggregates).
fn groupSafeAll(sp: &SubPlan): bool {
    let ac = aggCols(len(sp.sel.specs))
    for x in sp.sel.exprs { if !grpSafe(&aggRepl(&x, &ac)) { return false } }
    for x in sp.sel.groupBy { if !noFail(&sp.sel.q, &x) { return false } }
    return specsSafe(sp)
}

// The select list's and ORDER BY's grouped levels (optimizer 51) of a
// planned SELECT (bindSel, after selMarks): each correlated scalar
// aggregate hashed (9.9's, or its plan to be hashed that planFrom chose by
// cost: scalarJoins) that only they call, a level after the last, its calls
// read from it. Not in a query that groups or aggregates (its value is then
// a group's), nor where selMarks' other rules refuse a level.
pub fn selScalars(sel: mut &Sel) {
    if (unnestMode & UN_SCALAR) == 0 || len(sel.q.levels) == 0 || sel.aggQ || len(sel.groupBy) > 0 || len(sel.wins) > 0 || sel.setop != 0 ||
       sel.donKey > 0 || len(sel.locks) > 0 || len(sel.srf) > 0 || len(sel.mr) > 0 || sel.topMode != 0 || sel.withTies ||
       len(sel.feedback) > 0 || sel.first >= 0 || sel.having.isSome() || len(sel.gsets) > 0 || sel.rec >= 0 { return }
    var nums: []int = []
    for x in sel.exprs { scalarCalls(&x, mut &nums) }
    for x in sel.order { scalarCalls(&x, mut &nums) }
    if len(nums) == 0 { return }
    let pt: []int = []
    var any = false
    for i in nums {
        if !scalarCand(&sel.q, i) || !sel.q.subs[i].hashed || condUses(&sel.q, i) > 0 { continue }
        if groupCheck(&sel.q, i, &pt, true) != 0 { continue }
        if !any {
            // (the logical plan keeps the list as resolved)
            sel.lp = takeLp(sel)
            any = true
        }
        let GroupLevel{lv: glv, repl: grepl} = groupLevel(mut &sel.q, i, &pt, true).unwrap()
        append(mut &sel.q.levels, glv)
        for j in 0..len(sel.exprs) { sel.exprs[j] = markRepl(&sel.exprs[j], i, &grepl) }
        for j in 0..len(sel.order) { sel.order[j] = markRepl(&sel.order[j], i, &grepl) }
    }
    if !any { return }
    for j in 0..len(sel.q.cols) { if !sel.q.colAt.has(&sel.q.cols[j].name) { sel.q.colAt.put(sel.q.cols[j].name.toStr(), j) } }
    var corr = false
    for sp in sel.q.subs { if len(sp.sel.q.refs) > 0 && !sp.semi { corr = true } }
    sel.q.corr = corr
}

// The semi-joins of q (planned to its last level): each conjunct that is
// one taken from its level's conditions, its level placed after it.
// alts: per candidate subquery, its plan to be hashed (buildQuery).
fn semiJoins(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, q: mut &Query, alts: mut &[]Option[SubPlan], cand: &[]bool,
             looks: &[]bool, params: &[]Val, sc: &Scope, rules: bool, marks: bool): Result[Unit, DbErr] {
    let pt = lexdb_bind.ptypesOf(&sc.names)
    let fr = &sc.names.frames[len(sc.names.frames) - 1]
    var used: []bool = array(len(q.subs), false)       // a path's IN values (Path.inSub)
    for lv in q.levels { if lv.path.inSub >= 0 && lv.path.inSub < len(used) { used[lv.path.inSub] = true } }
    // the rows reaching a semi-join, about: the first table's (a lower
    // bound in most joins: it leans to the lookups of the plan as it was)
    let first = try semiRows(st, txn, mut &q.levels[0], params, rules)
    // Where it goes: after the level, from the one where its outer values
    // are all known on, whose rows are fewest by the join order's
    // estimates (orderRows), as PostgreSQL's join search places a semi
    // join among the others (q21's after supplier and nation cut lineitem's
    // 3.8M rows to 150k); not past an outer join. Without estimates, there.
    let est = q.orderRows()
    let nl = len(q.levels)
    // (not inside a build group, optimizer 49: after its last member)
    var gEnd: []int = []
    for k in 0..nl { append(mut &gEnd, k) }
    for h in 0..nl { for l in h..h + q.levels[h].grp { if l < nl { gEnd[l] = h + q.levels[h].grp } } }
    // per subquery, its calls in q's conditions (a mark join's must be in
    // its conjunct only: markJoins)
    var total: []int = []
    if marks { for i in 0..len(q.subs) { append(mut &total, condUses(q, i)) } }
    var olds = replace(mut &q.levels, [])
    var placed: [][]Level = []
    for k in 0..nl { append(mut &placed, []) }
    var any = false
    for k in 0..nl {
        var lv = replace(mut &olds[k], newLevel(rc(noTable()), "", 0, 0))
        var semis: []Level = []
        var ats: []int = []
        var marked: []str = []         // the mark joins' conjuncts (also in local)
        if !isOuter(lv.join) {
            var cs = replace(mut &lv.cond, [])
            var keep: []Expr = []
            for ci in 0..len(cs) {
                let c = replace(mut &cs[ci], Expr.Lit(Val.Null))
                let i = semiResolved(&c)
                var made = false
                if i >= 0 && i < len(cand) && cand[i] && !used[i] && i < len(fr.subKinds) && (i >= len(fr.subReads) || fr.subReads[i] == 0) {
                    var anti = false
                    match c {
                        Expr.Unary(op, _) { if op == "not" { anti = true } }
                        else {}
                    }
                    // NOT IN (optimizer 50): right after its level, no error moved
                    let na = isNotIn(&c)
                    var at = k
                    var outer = first
                    if len(est) == nl && !na {
                        for p in k + 1..nl {
                            if isOuter(olds[p].join) { break }
                            if est[p] < est[at] { at = p }
                        }
                        outer = est[at]
                    }
                    if gEnd[at] != at {
                        at = gEnd[at]
                        if len(est) == nl { outer = est[at] }
                    }
                    var exact = false
                    var placeOk = true
                    if na { placeOk = takeOutOk(q, &cs, ci, &olds, k, at, mut &exact) }
                    var got: Option[Level] = None
                    if placeOk { got = try semiLevel(st, txn, q, &c, i, fr.subKinds[i], &pt, alts, outer, params, anti, i < len(looks) && looks[i], rules, exact) }
                    if got.isSome() {
                        append(mut &semis, got.unwrap())
                        append(mut &ats, at)
                        made = true
                        any = true
                    }
                }
                // EXISTS and IN under OR, NOT or CASE: mark joins (optimizer 50)
                if !made && marks && len(total) == len(q.subs) {
                    let at = gEnd[k]
                    let outer = if len(est) == nl { est[at] } else { first }
                    let ct = lexdb_sql.exprText(&c)
                    var copies = 1
                    for x in lv.local { if lexdb_sql.exprText(&x) == ct { copies += 1 } }
                    let ms = try markJoins(st, txn, q, &c, &cs, ci, &olds, k, at, alts, fr, &pt, outer, params, rules, &total, copies)
                    if len(ms) > 0 {
                        append(mut &marked, ct)
                        var mv = ms
                        for j in 0..len(mv) {
                            append(mut &semis, replace(mut &mv[j], newLevel(rc(noTable()), "", 0, 0)))
                            append(mut &ats, at)
                        }
                        made = true
                        any = true
                    }
                }
                if !made { append(mut &keep, c) }
            }
            lv.cond = keep
            // a table read once and hashed has its own columns' conjuncts
            // among its hash's filters too (local): not a semi-join's
            if len(semis) > 0 {
                var ls = replace(mut &lv.local, [])
                var lkeep: []Expr = []
                for li in 0..len(ls) {
                    let lc = replace(mut &ls[li], Expr.Lit(Val.Null))
                    var gone = false
                    var drop = false
                    for sl in semis { if sl.mode != LV_MARK && semiResolved(&lc) == (if sl.semiSub >= 0 { sl.semiSub } else { sl.src }) { drop = true } }
                    if len(marked) > 0 {
                        let lt = lexdb_sql.exprText(&lc)
                        for g in marked { if g == lt { drop = true } }
                    }
                    if !drop { append(mut &lkeep, lc) }
                }
                lv.local = lkeep
            }
        }
        for j in 0..len(semis) { append(mut &placed[ats[j]], replace(mut &semis[j], newLevel(rc(noTable()), "", 0, 0))) }
        append(mut &q.levels, lv)
        for j in 0..len(placed[k]) { append(mut &q.levels, replace(mut &placed[k][j], newLevel(rc(noTable()), "", 0, 0))) }
    }
    if !any { return Ok(Unit{}) }
    // its columns by name (levelOf); a subquery still run per row
    for i in 0..len(q.cols) { if !q.colAt.has(&q.cols[i].name) { q.colAt.put(q.cols[i].name.toStr(), i) } }
    var corr = false
    for sp in q.subs { if len(sp.sel.q.refs) > 0 && !sp.semi { corr = true } }
    q.corr = corr
    return Ok(Unit{})
}

// Has a correlated subquery: one run per row.
pub fn hasCorr(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasCorr(&a) }
        Expr.Bin(_, a, b) { return hasCorr(&a) || hasCorr(&b) }
        Expr.IsNull(a, _) { return hasCorr(&a) }
        Expr.Cast(a, _) { return hasCorr(&a) }
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) && len(args) > lexdb_bind.subFixed(&n) { return true }
            for a in args { if hasCorr(&a) { return true } }
            return false
        }
        else { return false }
    }
}

fn subsLast(cs: []Expr): []Expr {
    var all = cs
    var first: []Expr = []
    var last: []Expr = []
    for i in 0..len(all) {
        let c = replace(mut &all[i], Expr.Lit(Val.Null))
        if hasCorr(&c) { append(mut &last, c) } else { append(mut &first, c) }
    }
    for i in 0..len(last) { append(mut &first, replace(mut &last[i], Expr.Lit(Val.Null))) }
    return first
}

fn matchesOr(x: &Expr): bool {
    match x { Expr.Bin(op, _, _) { if op == "or" { return true } } else {} }
    return false
}

// The OR's operands, flattened.
fn orParts(x: &Expr, out: mut &[]Expr) {
    match x {
        Expr.Bin(op, a, b) {
            if op == "or" { orParts(&a, out); orParts(&b, out); return }
        }
        else {}
    }
    append(out, lexdb_sql.cloneExpr(x))
}

// The AND's operands, flattened.
fn andParts(x: &Expr, out: mut &[]Expr) {
    match x {
        Expr.Bin(op, a, b) {
            if op == "and" { andParts(&a, out); andParts(&b, out); return }
        }
        else {}
    }
    append(out, lexdb_sql.cloneExpr(x))
}

fn andOf(xs: &[]Expr): Expr {
    if len(xs) == 0 { return Expr.Lit(Val.Bool(true)) }
    var out = lexdb_sql.cloneExpr(&xs[0])
    for i in 1..len(xs) { out = Expr.Bin("and", out, lexdb_sql.cloneExpr(&xs[i])) }
    return out
}

fn orOf(xs: &[]Expr): Expr {
    if len(xs) == 0 { return Expr.Lit(Val.Bool(false)) }
    var out = lexdb_sql.cloneExpr(&xs[0])
    for i in 1..len(xs) { out = Expr.Bin("or", out, lexdb_sql.cloneExpr(&xs[i])) }
    return out
}

// Whether x can raise no error on a row's values: columns, constants and
// comparisons of them, AND, OR, NOT, IS NULL, IN and LIKE. A part with no
// column is a constant, the same value (or error) on every row. Arithmetic
// (division by zero, overflow), a cast or another call can fail on some
// row's values, so a copy of it must not be evaluated on rows the query
// as written would not evaluate it on (pullCommonOr, orLevels).
fn cannotFail(x: &Expr): bool {
    var ns: []str = []
    lexdb_sql.colNames(x, mut &ns)
    if len(ns) == 0 { return !hasSubCall(x) && lexdb_bind.immutable(x) }
    match x {
        Expr.Col(_, _) { return true }
        Expr.Unary(op, a) { return op == "not" && cannotFail(&a) }
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" || op == "=" || op == "<>" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                return cannotFail(&a) && cannotFail(&b)
            }
            return false
        }
        Expr.IsNull(a, _) { return cannotFail(&a) }
        Expr.Call(n, args, star) {
            if star || (n != "in" && n != "like" && n != "ilike") { return false }
            for a in args { if !cannotFail(&a) { return false } }
            return true
        }
        else { return false }
    }
}

// (A and X) or (A and Y) -> A and (X or Y), when A is the same conjunct in
// every branch. q19's OR of three joins shares p_partkey = l_partkey, and
// pulling it out is what lets the planner join the tables instead of
// crossing them. Only immutable, subquery-free conjuncts are pulled, and
// only those that cannot fail: A then runs before the branches' guards
// ("id > 100 and 1/(id - 5) > 0").
pub fn pullCommonOr(x: &Expr): Expr {
    if !matchesOr(x) { return lexdb_sql.cloneExpr(x) }
    var branches: []Expr = []
    orParts(x, mut &branches)
    if len(branches) < 2 { return lexdb_sql.cloneExpr(x) }
    var parts: [][]Expr = []
    for b in branches {
        var ps: []Expr = []
        andParts(&b, mut &ps)
        append(mut &parts, ps)
    }
    var common: []Expr = []
    for c in parts[0] {
        if !lexdb_bind.immutable(&c) || hasSubCall(&c) || !cannotFail(&c) { continue }
        var all = true
        for j in 1..len(parts) {
            var found = false
            for d in parts[j] { if sameExpr(&c, &d) { found = true } }
            if !found { all = false }
        }
        if all { append(mut &common, lexdb_sql.cloneExpr(&c)) }
    }
    if len(common) == 0 { return lexdb_sql.cloneExpr(x) }
    var rest: []Expr = []
    for j in 0..len(parts) {
        var rem: []Expr = []
        for d in parts[j] {
            var used = false
            for c in common { if sameExpr(&c, &d) { used = true } }
            if !used { append(mut &rem, lexdb_sql.cloneExpr(&d)) }
        }
        append(mut &rest, andOf(&rem))
    }
    append(mut &common, orOf(&rest))
    return andOf(&common)
}

// The necessary filter an OR of branches puts on one table: each branch's
// conditions on it, or'd. Branch 1's part may pair with branch 2's
// lineitem, so the full OR stays at the join; this only cuts the table's
// rows first, as PostgreSQL's BitmapOr does with an index per branch.
// Only conditions that cannot fail are copied: the table's rows are tested
// before the join, some of them rows the OR itself never sees (a.id = 5
// with no b row: "1/(a.id - 5) > 0" would divide by zero). Leaving one out
// keeps the filter necessary, only weaker.
fn orLevels(x: &Expr, k: int, q: &Query): Option[Expr] {
    var branches: []Expr = []
    orParts(x, mut &branches)
    var outs: []Expr = []
    for b in branches {
        var ps: []Expr = []
        andParts(&b, mut &ps)
        var local: []Expr = []
        for d in ps {
            if q.levelMask(&d) == (1 << k) && !hasCorr(&d) && !hasSubCall(&d) && cannotFail(&d) { append(mut &local, lexdb_sql.cloneExpr(&d)) }
        }
        if len(local) == 0 { return None }
        append(mut &outs, andOf(&local))
    }
    if len(outs) < 2 { return None }
    return Some(orOf(&outs))
}

// EXPLAIN's lines for a query's subqueries (with their runs, ANALYZE).
// q's subqueries as the physical plan has them (lexdb_plan.PSub): each
// one's plan, and how it runs, as the planner left it.
pub fn subsOf(q: &Query): []PSub {
    var out: []PSub = []
    for i in 0..len(q.subs) {
        let sp = &q.subs[i]
        var run = RUN_PER_ROW
        var anti = false
        var looked = false
        for lv in q.levels {
            if lv.semiSub == i {
                looked = true
                anti = lv.anti
            }
        }
        if looked {
            // a join's level looked up per row (semiLook): not run; its
            // table is the level's now
            run = RUN_LOOKED
        } else if sp.semi {
            // NOT EXISTS's level is an anti join (Level.anti)
            run = RUN_SEMI
            for lv in q.levels {
                if lv.semi && lv.src == i && lv.anti { anti = true }
                if lv.src == i && lv.mode == LV_MARK { run = RUN_MARK }
                if lv.src == i && grouped(lv) { run = RUN_GROUPED }
            }
        } else if sp.hashed {
            run = if sp.use == lexdb_sql.SUB_FROM { RUN_GROUPED } else { RUN_HASHED }
        } else if len(sp.sel.q.refs) == 0 {
            run = RUN_ONCE
        }
        append(mut &out, PSub{use: sp.use, run: run, anti: anti, plan: physOf(&sp.sel)})
    }
    return out
}

// A planned Sel's operators (lexdb_plan.PPlan; design/lexdb-layers.md 6.1,
// step 3), made when asked, in the order execSel applies them. The Sel holds
// their details.
pub fn physOf(sel: &Sel): PPlan {
    let subs = subsOf(&sel.q)
    if sel.setop != 0 {
        var parts: []PPlan = []
        for i in 0..len(sel.parts) { append(mut &parts, physOf(&sel.parts[i])) }
        let set = PPlan.SetOp(sel.setop, sel.setAll, sel.rec, parts, subs)
        let sorted = if len(sel.order) > 0 { PPlan.Sort(set, sel.sort, None) } else { set }
        return if sel.limit >= 0 || sel.offset > 0 { PPlan.Limit(sorted, false, sel.limit, max(sel.offset, 0)) } else { sorted }
    }
    let leaf = if len(sel.srf) > 0 { PPlan.Func(sel.srf.toStr(), sel.ordin, subs) }
               else if len(sel.q.levels) == 0 { PPlan.Result(subs) }
               else { PPlan.Levels(len(sel.q.levels), subs) }
    let p1 = if sel.first >= 0 { PPlan.MinMax(leaf) } else { leaf }
    let p2 = if len(sel.groupBy) > 0 || (sel.aggQ && sel.first < 0) { PPlan.Agg(p1, len(sel.gsets) > 0, None) } else { p1 }
    return physAbove(sel, p2)
}

// physOf's operators over the groups (or the rows): HAVING, the window
// calls, the select list, DISTINCT, ORDER BY, the locks, the LIMIT and
// MATCH_RECOGNIZE, as views over p2.
fn physAbove(sel: &Sel, p2: PPlan): PPlan {
    let p3 = if sel.having.isSome() { PPlan.Having(p2) } else { p2 }
    let p4 = if len(sel.wins) > 0 { PPlan.Window(p3, None) } else { p3 }
    // a function's select list is its arguments
    let p5 = if len(sel.srf) == 0 { PPlan.Project(p4, []) } else { p4 }
    let p6 = if sel.distinct { PPlan.Distinct(p5, sel.donKey > 0, []) } else { p5 }
    let p7 = if len(sel.order) > 0 { PPlan.Sort(p6, sel.sort, None) } else { p6 }
    let p8 = if len(sel.locks) > 0 { PPlan.Lock(p7) } else { p7 }
    let p9 = if sel.limit >= 0 || sel.offset > 0 || sel.topMode != 0 { PPlan.Limit(p8, sel.limit >= 0 && !sel.aggQ && !sel.sort, sel.limit, max(sel.offset, 0)) } else { p8 }
    return if len(sel.mr) > 0 { PPlan.Match(p9) } else { p9 }
}

// A level's figure (optimizer 23, optimizer 24): "" when none.
fn estText(lv: &Level): str {
    if lv.estRows < 0 { return "" }
    return if lv.estMax { " (at most " } else { " (estimated " } + lv.estRows.toStr() + " rows)"
}

pub fn pathText(lv: &Level): str { return pathTextOf(lv, false) }

// Level k's path's text, naming a range read in key order (optimizer 47).
pub fn pathTextAt(q: &Query, k: int): str {
    if orRead(q, k) { return orText(&q.levels[k]) }
    return pathTextOf(&q.levels[k], keyOrdered(q, k))
}

fn pathTextOf(lv: &Level, keyOrder: bool): str {
    if lv.lateral { return "rows of subquery " + (lv.src + 1).toStr() + ", run" }
    if lv.src >= 0 { return "rows of subquery " + (lv.src + 1).toStr() }
    if lv.work >= 0 { return "rows of the working table" }
    let p = &lv.path
    let cols = keyCols(&lv.t, p.index)
    if len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 {
        let many = if p.inSub >= 0 { " value of subquery " + (p.inSub + 1).toStr() } else if len(p.inArr) > 0 { " element of the array" } else { " of " + len(p.ins).toStr() + " values" }
        let each = " for each" + many + (if p.desc { " backward" } else { "" })
        if p.index < 0 { return "primary key " + (if len(p.eqs) + 1 == len(cols) { "lookup" } else { "range" }) + each + estText(lv) }
        return "index " + lexdb_sql.baseName(&lv.t.indexes[p.index].name) + (if lv.t.indexes[p.index].pred.isSome() { " (filtered)" } else { "" }) +
               " lookup" + each + (if ixCovers(lv, p.index) { ", index only" } else { "" }) + estText(lv)
    }
    if p.index < 0 {
        if len(p.eqs) == len(cols) { return "primary key lookup" }
        if len(p.eqs) > 0 || len(p.rng) > 0 { return "primary key range" + estText(lv) }
        return "full scan" + (if p.desc { " backward" } else { "" })
    }
    let what = if len(p.eqs) == len(cols) { " lookup" } else if len(p.eqs) > 0 || len(p.rng) > 0 { " range" } else { " scan" }
    let filtered = if lv.t.indexes[p.index].pred.isSome() { " (filtered)" } else { "" }
    let alone = if ixCovers(lv, p.index) { ", index only" } else if keyOrder { ", rows in key order" } else { "" }
    return "index " + lexdb_sql.baseName(&lv.t.indexes[p.index].name) + filtered + what + (if p.desc { " backward" } else { "" }) + alone + estText(lv)
}

// An index expression's type, from the table's columns.
pub fn exprType(t: &Table, x: &Expr): lexdb_sql.TypeName {
    let none: []int = []
    let o = exprOid(x, &t.cols, &none)
    return boundType(&lexdb_sql.oidType(if o == 0 || o == 705 { lexdb_sql.OID_TEXT } else { o }))
}

// The type of an index's (or the primary key's: index -1) k-th value, for
// its bounds.
pub fn keyType(t: &Table, index: int, k: int): lexdb_sql.TypeName {
    if index >= 0 && t.indexes[index].cols[k] < 0 { return exprType(t, &t.indexes[index].exprs[k]) }
    let cols = keyCols(t, index)
    return boundType(&t.cols[cols[k]].typ)
}

// The type OID of an expression, as far as it can be told before running
// (lexdb_bind's, with the dialects' functions).
pub fn exprOid(x: &Expr, cols: &[]lexdb_sql.ColDef, ptypes: &[]int): int { return lexdb_bind.exprOid(x, cols, ptypes, &up().typing) }

// A LIMIT's, OFFSET's or TOP's count: its value now (NULL: -1, none).
// evalInt of a write's TOP (n), its looks not kept.
pub fn evalTop(x: &Option[Expr], params: &[]Val): Result[int, DbErr] {
    var lk: []Look = []
    return evalInt(x, params, "TOP", mut &lk)
}

pub fn evalInt(x: &Option[Expr], params: &[]Val, what: &str, lk: mut &[]Look): Result[int, DbErr] {
    match x {
        Some(v) {
            let lit = match v { Expr.Lit(_) { true } else { false } }
            var n = -1                      // NULL: no limit
            match try lexdb_ops.coerce(try up().eval(&v, params), &lexdb_sql.TypeName{kind: lexdb_sql.K_INT, oid: lexdb_sql.OID_INT8, prec: 0, scale: 0, len: 0}) {
                Val.Int(i) {
                    if i < 0 { return Err(e("2201W", &(what + " must not be negative"))) }
                    n = i
                }
                else {}
            }
            // a look (optimizer 22): the plan keeps the value
            if !lit { append(lk, Look{kind: 1, c: lexdb_sql.cloneExpr(&v), p: Expr.Lit(Val.Null), out: n, typ: noType(), cm: lexdb_stats.noCommon()}) }
            return Ok(n)
        }
        None { return Ok(-1) }
    }
}

// A SELECT, planned: its query, its output, and how its order is had.
pub type Sel = record {
    pub q: Query
    pub exprs: []Expr
    pub outs: []OutCol
    pub groupBy: []Expr
    pub order: []Expr
    pub aggQ: bool
    pub sort: bool              // ORDER BY sorts; false: the scan gives the order
    pub first: int              // MIN or MAX served by the scan's order: stop at the first non-NULL value of this column
    pub limit: int
    pub offset: int
    pub having: Option[Expr]
    pub specs: []AggSpec        // the aggregate calls; exprs, having and order use their slots
    pub distinct: bool
    pub desc: []bool            // per ORDER BY item
    pub nullsFirst: []bool      // ... NULLs first
    pub parts: []Sel            // UNION, INTERSECT, EXCEPT: its two queries (q has no tables, refs theirs)
    pub setop: int
    pub setAll: bool
    pub split: int              // refs: the first query's, then the second's
    pub rec: int                // a recursive CTE: its number; -1
    pub srf: str                // a function in FROM: its name; exprs are its arguments, outs its columns (9.27)
    pub ordin: bool             // ... WITH ORDINALITY
    pub wins: []WinPlan         // its window calls (9.46): exprs and order read their values from slots nAggs + i
    pub nAggs: int
    // FOR UPDATE and the like (9.86): per table locked, its key's columns,
    // added to exprs after the output's (nOut of them)
    pub locks: []SelLock
    pub nOut: int
    pub donKey: int             // DISTINCT ON (9.94): the first donKey sort values tell rows apart; 0 none
    pub withTies: bool          // FETCH ... WITH TIES: rows tied with the last kept are kept too
    pub gsets: [][]int          // ROLLUP, CUBE, GROUPING SETS: the sets, places in groupBy; [] plain
    pub gx: [][]Expr            // ... per set, exprs, order and having as that set sees them
    pub gord: [][]Expr
    pub gh: []Option[Expr]
    // collations (L2): per GROUP BY key, ORDER BY item and output column,
    // the kind it is grouped, sorted and made distinct by (lexdb_sql.COLL_*)
    pub groupKinds: []int
    pub ordKinds: []int
    pub outKinds: []int
    // T-SQL's TOP n PERCENT and WITH TIES (lexdb_sql.TOP_*): limit is -1,
    // topN the n, applied to the rows sorted
    pub topMode: int
    pub topN: int
    // T-SQL's SELECT @v = f(@v, ...) (design/lexdb-tds.md S4): per output
    // column the parameter it assigns (0 none), when one reads another's:
    // the rows evaluated in their order, each seeing the last's values
    pub feedback: []int
    pub mr: []MrPlan            // MATCH_RECOGNIZE's wrapper (design/lexdb-match-recognize.md): its plan; outs stay the input's
    // per output expression (exprs), bound once for the plan (bindSel;
    // parameters as slots; None for a column, read at its place, or one eval
    // evaluates); [] bound per run (outC)
    pub ox: []Option[lexdb_bind.BX]
    pub oxParam: bool           // one of ox reads a parameter slot (outC copies the run's parameters only then)
    // UNION, INTERSECT, EXCEPT: per output column, the parts whose values
    // are converted to its type (lexdb_bind.converts): 1 the first, 2 the
    // second; [] none
    pub conv: []int
    pub lp: lexdb_bind.LPlan        // the query as the binder gives it (design/lexdb-layers.md 4.4.1, 2e); read by nothing yet
    // the plan as the pipeline runs it (pipeSel; design/lexdb-layers.md
    // 6.2.3): its arms hold the outputs and conditions bound (then not in
    // ox and q.cc); None: the row engine and the batch drivers run it
    pub pipe: Option[Prog]
}

pub type SelLock = value record { pub level: int; pub at: int; pub n: int; pub mode: int; pub wait: int }

// The column of level 0 an expression is, else -1.
fn (q: &Query) firstCol(x: &Expr): int {
    match x {
        Expr.Col(n, sl) {
            if q.levelOf(&n) == 0 { return lexdb_bind.colSlot(&q.cols, &n, sl) - q.levels[0].first }
        }
        else {}
    }
    return -1
}

// The columns of the first table an ORDER BY sorts by, all one way: the
// direction (0 up, 1 down), or -1 when it sorts by anything else.
pub fn orderCols(q: &Query, order: &[]Expr, items: &[]lexdb_sql.OrderItem, exprs: &[]Expr, outs: &[]OutCol,
             cols: mut &[]int): int {
    if len(order) == 0 || len(q.levels) == 0 { return -1 }
    for i in 0..len(order) {
        if items[i].desc != items[0].desc { return -1 }
        if items[i].nullsFirst != items[i].desc { return -1 }    // NULLs where an index does not keep them
        var c = q.firstCol(&order[i])
        match order[i] {
            Expr.Lit(v) {
                match v {
                    Val.Int(n) { if n >= 1 && n <= len(exprs) { c = q.firstCol(&exprs[n - 1]) } }
                    else {}
                }
            }
            Expr.Col(n, _) {
                if c < 0 {
                    for j in 0..len(outs) { if outs[j].name == n { c = q.firstCol(&exprs[j]) } }
                }
            }
            else {}
        }
        if c < 0 { return -1 }
        append(cols, c)
    }
    return if items[0].desc { 1 } else { 0 }
}

// Whether a path of the first table gives its rows in the order of cols:
// they follow its key (an index's key ends with the primary key) after its
// equalities, skipping columns held equal.
pub fn servesOrder(t: &Table, p: &Path, cols: &[]int): bool {
    if p.inSub >= 0 { return false }        // past IN_LOOKUP_MAX it reads in primary key order
    var key = keyCols(t, p.index)
    if p.index >= 0 { for c in t.pk { append(mut &key, c) } }
    if p.index < 0 && len(p.eqs) == len(t.pk) { return true }     // one row
    var j = len(p.eqs)
    for c in cols {
        if j < len(key) && key[j] == c {
            j += 1
            continue
        }
        var held = false
        for x in 0..len(p.eqs) { if key[x] == c { held = true } }
        if !held { return false }
    }
    return true
}

// Lookups in key order (9.107): the first table, scanned whole, is read
// instead through an index holding every column it uses (read alone),
// whose first column is the value a later table is looked up by (the
// first column of its primary key, per row: lookupPath). That table's
// keys then come in order, and the batches' lookups (bLookup, getMany)
// find each from the leaf of the one before. Not where reading may stop
// early (a LIMIT: the rows it gives would change), nor where the path was
// chosen for an order.
pub fn orderLookups(q: mut &Query) {
    if len(q.levels) < 2 { return }
    var ix = -1
    {
        let l0 = &q.levels[0]
        let p = &l0.path
        if l0.virt() || !l0.perRow || l0.lateral || l0.keeps || l0.stops || p.index >= 0 || p.desc || len(p.eqs) > 0 || len(p.rng) > 0 ||
           len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 || len(l0.need) == 0 || len(l0.ors) > 0 { return }
        for k in 1..len(q.levels) {
            let lv = &q.levels[k]
            if !lv.perRow || !lookupPath(q, lv) { continue }
            var c = -1
            match lv.path.eqs[0] {
                Expr.Col(n, sl) {
                    let at = lexdb_bind.colSlot(&q.cols, &n, sl)
                    if at >= l0.first && at < l0.first + len(l0.t.cols) { c = at - l0.first }
                }
                else {}
            }
            if c < 0 { continue }
            for i in 0..len(l0.t.indexes) {
                let x = &l0.t.indexes[i]
                if ix < 0 && x.pred.isNone() && len(x.cols) > 0 && x.cols[0] == c && ixCovers(l0, i) { ix = i }
            }
            break
        }
    }
    if ix >= 0 { q.levels[0].path.index = ix }
}

// A full scan of the primary key or an index that gives the order, if one does.
pub fn orderedScan(q: &Query, cols: &[]int, params: &[]Val, lk: mut &[]Look): Option[int] {
    let t = &q.levels[0].t
    for c0 in 0..len(t.indexes) + 1 {
        if !q.usable(0, c0 - 1, &q.levels[0].cond, params, lk) { continue }
        let p = Path{index: c0 - 1, eqs: [], rng: [], desc: false, noNulls: false, ins: [], inSub: -1, inArr: [], stats: false, inMax: 0, sorted: false}
        if servesOrder(t, &p, cols) { return Some(c0 - 1) }
    }
    return None
}

// The column of the first table every output is MIN (0) or MAX (1) of, else -1.
pub fn minMax(q: &Query, exprs: &[]Expr, dir: mut &int): int {
    var col = -1
    var fname = ""
    for x in exprs {
        match x {
            Expr.Call(n, args, star) {
                if (n != "min" && n != "max") || star || len(args) != 1 { return -1 }
                let c = q.firstCol(&args[0])
                if c < 0 || (col >= 0 && (c != col || n != fname)) { return -1 }
                col = c
                fname = n.clone()
            }
            else { return -1 }
        }
    }
    dir = if fname == "max" { 1 } else { 0 }
    return col
}

// sel's plan, taken out of it (a FROM subquery's, a view's, a set
// operation's side) or before its lists change (hashSub): whole, the
// Project's list and the Sort's keys copies of the Sel's where the plan
// lends them (lpLentExprs, lpLentOrder).
pub fn takeLp(sel: mut &Sel): lexdb_bind.LPlan {
    let lp = replace(mut &sel.lp, lexdb_bind.noPlan())
    let n = lexdb_bind.lpLentExprs(&lp)
    let lentOrder = lexdb_bind.lpLentOrder(&lp)
    if n < 0 && !lentOrder { return lp }
    var xs: []Expr = []
    if n > 0 {
        xs = withCapacity(n)
        for i in 0..n { append(mut &xs, lexdb_sql.cloneExpr(&sel.exprs[i])) }
    }
    return lexdb_bind.lpRestore(lp, xs, if lentOrder { lexdb_sql.cloneAllExpr(&sel.order) } else { [] })
}

// Whether level lv is looked up per row by its whole primary key, its
// values from the tables before it (a point: pathScan), as the batches
// look it up (bLookup): not an index's, a range's, an IN list's, a
// correlated value's.
fn lookupPath(q: &Query, lv: &Level): bool {
    let p = &lv.path
    if lv.virt() || lv.lateral || p.index >= 0 || p.desc || len(p.rng) > 0 || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 { return false }
    if q.corr && pathCorr(p) { return false }
    return len(p.eqs) > 0 && len(p.eqs) == len(keyCols(&lv.t, -1))
}

// Whether level lv's index (its path's) holds every column it uses: a
// SELECT's (its columns narrowed, 9.31), not locking its rows.
pub fn ixCovers(lv: &Level, ix: int): bool {
    if ix < 0 || lv.lock != 0 || len(lv.need) == 0 || lv.virt() { return false }
    return lexdb_access.idxDecOf(&lexdb_catalog.relOf(&lv.t), ix, &lv.need).isSome()
}

// ---- index ranges read in key order (optimizer 47)

// How the cost planner reads a range in key order: KO_COST by its cost
// (the default); the others for the tests and the calibration, process
// wide: KO_NEVER never (the plans before it), KO_SORTED the first table's
// range always by its index and in key order, KO_PLAIN always by its index
// and in the index's order.
pub const KO_COST: int = 0
pub const KO_NEVER: int = 1
pub const KO_SORTED: int = 2
pub const KO_PLAIN: int = 3

var keyOrderMode: int = KO_COST

pub fn setKeyOrder(mode: int) { keyOrderMode = mode }

// Whether the first table's pure range of n entries (by its samples) of a
// table of rows is read as a scan rather than by its index (choosePath).
// Its rows are read in key order (keyOrdered), so the scan wins where
// twice that read's cost is over the scan's: 2 * (COST_DESCENT + n *
// COST_SORTED_ROW) >= rows * COST_SCAN, about 1/24 of the table (the factor
// 2 leans to the scan, whose cost does not depend on the estimate; the
// measured crossover is near 1/10, optimizer 47.9). KO_NEVER: the rule
// before it, over 1/SCAN_SHARE. KO_SORTED and KO_PLAIN: never.
fn forcedIndex(): bool { return keyOrderMode == KO_SORTED || keyOrderMode == KO_PLAIN }

fn scanFirst(n: int, rows: int): bool {
    if forcedIndex() { return false }
    if keyOrderMode == KO_NEVER { return n * SCAN_SHARE >= rows }
    return 2.0f * (COST_DESCENT + float(n) * COST_SORTED_ROW) >= float(rows) * COST_SCAN
}

// Whether path p is one the cost planner may read in key order: an
// index's range or equality prefix (not a whole unique key's lookup), read
// forward, not a lookup list.
pub fn sortable(t: &Table, p: &Path): bool {
    if p.index < 0 || p.desc || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 { return false }
    if len(p.eqs) == 0 && len(p.rng) == 0 { return false }
    return !(t.indexes[p.index].unique && len(p.eqs) == len(t.indexes[p.index].cols))
}

// Whether level k of q reads its path's range in key order (optimizer 47:
// its entries' primary keys collected, sorted, its rows read by them): a
// path the cost planner marked (Path.sorted), of the first table or of one
// read once (a hash's), not chosen for its order (keeps), not where the
// reading may stop early (stops), not locked, not an index read alone. (A
// transaction whose reads are noted reads it in the index's order: the
// readers' check.)
pub fn keyOrdered(q: &Query, k: int): bool {
    let lv = &q.levels[k]
    let p = &lv.path
    if !p.sorted || keyOrderMode == KO_NEVER || keyOrderMode == KO_PLAIN { return false }
    if (k > 0 && lv.perRow) || lv.keeps || lv.stops || lv.lock != 0 || lv.virt() || lv.lateral || lv.semi || lv.anti || lv.semiSub >= 0 ||
       !sortable(&lv.t, p) { return false }
    return !ixCovers(lv, p.index)
}

// ---- the OR of index paths (optimizer 52)
//
// PostgreSQL's BitmapOr over an index-organised table: a table scanned
// whole whose conditions hold an OR, each branch of it with an index path
// of its own (q19's part: a brand and four containers, three times), is
// read by those paths instead: their entries' primary keys collected,
// sorted, deduplicated, and the rows read by them in key order
// (lexdb_access.orPoints), the level's conditions (the whole OR among
// them) checked on each as on a scan's.

// How the cost planner reads an OR of index paths: OR_COST by its cost
// (the default); OR_NEVER never (the plans before it), OR_ALWAYS wherever
// every branch has a path, whatever the cost or the statistics (the
// tests). Process wide.
pub const OR_COST: int = 0
pub const OR_NEVER: int = 1
pub const OR_ALWAYS: int = 2

var orMode: int = OR_COST

pub fn setOrPaths(mode: int) { orMode = mode }

// A path that reads the whole table: no key condition, forward.
fn fullPath(p: &Path): bool {
    return p.index < 0 && len(p.eqs) == 0 && len(p.rng) == 0 && len(p.ins) == 0 && p.inSub < 0 && len(p.inArr) == 0 && !p.desc
}

// Whether x holds a parameter (or an outer value, a subquery's): its
// figure would be the parameter's value's, which a kept plan does not
// recheck.
fn anyParam(x: &Expr): bool {
    match x {
        Expr.Param(_) { return true }
        Expr.Lit(_) { return false }
        Expr.Col(_, _) { return false }
        Expr.Unary(_, a) { return anyParam(&a) }
        Expr.Bin(_, a, b) { return anyParam(&a) || anyParam(&b) }
        Expr.IsNull(a, _) { return anyParam(&a) }
        Expr.Cast(a, _) { return anyParam(&a) }
        Expr.Call(_, args, _) {
            for a in args { if anyParam(&a) { return true } }
            return false
        }
    }
}

// Whether path p of level lv reads at most one row per value: the whole
// primary key or a unique index, equal (or the last part an IN list).
fn uniquePath(lv: &Level, p: &Path): bool {
    if p.inSub >= 0 || len(p.inArr) > 0 || len(p.rng) > 0 { return false }
    let cols = keyCols(&lv.t, p.index)
    if !(p.index < 0 || (lv.t.indexes[p.index].unique && lv.t.indexes[p.index].pred.isNone())) { return false }
    return len(p.eqs) + (if len(p.ins) > 0 { 1 } else { 0 }) == len(cols)
}

// Level k's OR of index paths among its conjuncts cs, the cheapest, if
// one is chosen; [] none. An OR conjunct on level k's columns alone (no
// parameter, subquery or outer value; none of it can fail: its arms'
// values are evaluated before any row is read) whose every branch, with
// the conjuncts beside the OR, has an index (or primary key) path:
// choosePath's for the branch. Its cost, in section 45's units: per arm
// a descent per value and COST_SORTED_ROW per row of its estimate (each
// row read by key, as optimizer 47's); taken where twice that is under
// the scan's (the lean of scanFirst). Without statistics: only arms of
// unique keys (a row per value at most).
fn orPaths(q: &Query, k: int, cs: &[]Expr, params: &[]Val): []Path {
    let lv = &q.levels[k]
    var best: []Path = []
    var bestCost = 0.0f
    for i in 0..len(cs) {
        let c = &cs[i]
        if !matchesOr(c) || q.levelMask(c) != (1 << k) || hasCorr(c) || hasSubCall(c) || !cannotFail(c) || anyParam(c) || !lexdb_bind.immutable(c) { continue }
        var rest: []Expr = []
        for j in 0..len(cs) { if j != i && !matchesOr(&cs[j]) { append(mut &rest, lexdb_sql.cloneExpr(&cs[j])) } }
        var branches: []Expr = []
        orParts(c, mut &branches)
        if len(branches) < 2 { continue }
        var arms: []Path = []
        var cost = 0.0f
        var ok = true
        var known = true
        for b in branches {
            var parts = lexdb_sql.cloneAllExpr(&rest)
            andParts(&b, mut &parts)
            var lk: []Look = []
            let p = choosePath(q, k, &parts, params, mut &lk)
            if fullPath(&p) || p.desc || p.inSub >= 0 || q.pathOuter(&p) || pathCorr(&p) {
                ok = false
                break
            }
            let f = pathFig(lv, &p, params)
            var rows = f.rows
            if rows < 0 && uniquePath(lv, &p) { rows = max(1, len(p.ins)) }
            if rows < 0 { known = false }
            cost += COST_DESCENT * float(max(1, len(p.ins))) + float(max(rows, 0)) * COST_SORTED_ROW
            append(mut &arms, p)
        }
        if !ok { continue }
        if orMode != OR_ALWAYS {
            if !known { continue }
            // no statistics: arms of unique keys only, read by their keys
            if lv.est.rows >= 0 && 2.0f * cost >= float(lv.est.rows) * COST_SCAN { continue }
            if lv.est.rows < 0 {
                var uniq = true
                for p in arms { if !uniquePath(lv, &p) { uniq = false } }
                if !uniq { continue }
            }
        }
        if len(best) == 0 || cost < bestCost {
            best = arms
            bestCost = cost
        }
    }
    return best
}

// The rows an OR of index paths reads by the statistics: its arms'
// figures summed (rows matching several arms counted in each), a bound
// when one is; -1 when one has none.
fn orEst(lv: &Level, params: &[]Val): Fig {
    var n = 0
    var bound = false
    for p in lv.ors {
        let f = pathFig(lv, &p, params)
        if f.rows < 0 { return Fig{rows: -1, bound: false} }
        n += f.rows
        if f.bound { bound = true }
    }
    return Fig{rows: n, bound: bound}
}

// Whether level k of q is read by its OR of index paths (Level.ors): its
// path still a full scan (not changed for an order), of the first table
// or one read once, not where the reading may stop early, not locked (as
// keyOrdered).
pub fn orRead(q: &Query, k: int): bool {
    let lv = &q.levels[k]
    if len(lv.ors) == 0 || orMode == OR_NEVER { return false }
    if (k > 0 && lv.perRow) || lv.keeps || lv.stops || lv.lock != 0 || lv.virt() || lv.lateral || lv.semi || lv.anti || lv.semiSub >= 0 { return false }
    return fullPath(&lv.path)
}

// EXPLAIN's text of an arm of an OR of index paths.
fn armText(lv: &Level, p: &Path): str {
    let cols = keyCols(&lv.t, p.index)
    let name = if p.index < 0 { "primary key" } else {
        "index " + lexdb_sql.baseName(&lv.t.indexes[p.index].name) + (if lv.t.indexes[p.index].pred.isSome() { " (filtered)" } else { "" })
    }
    if len(p.ins) > 0 { return name + " lookup for each of " + len(p.ins).toStr() + " values" }
    if len(p.inArr) > 0 { return name + " lookup for each element of the array" }
    return name + (if len(p.eqs) == len(cols) { " lookup" } else { " range" })
}

// EXPLAIN's text of a level read by its OR of index paths.
fn orText(lv: &Level): str {
    var arms: []str = []
    for p in lv.ors { append(mut &arms, armText(lv, &p)) }
    return "any of " + strings.join(&arms, ", ") + "; rows in key order" + estText(lv)
}

pub const NV_LAST = 1         // MrNav.kind: LAST(x, off), and a plain column
pub const NV_FIRST = 2
pub const NV_AGG = 3
pub const NV_CLS = 4
pub const NV_MNO = 5

pub type MrNav = record {
    pub kind: int
    pub set: []bool               // the variables it reads; [] the universal variable
    pub off: int                  // FIRST/LAST offset
    pub phys: int                 // then PREV (-n) or NEXT (+n); 0 none
    pub final: bool               // FINAL
    pub arg: Expr                 // evaluated on the target row, against inCols (resolved)
    pub col: int                  // arg is a bare column: its index (a fast path); -1
    pub spec: AggSpec             // NV_AGG
    pub wrap: Option[Expr]        // NV_AGG: what is around the aggregate (its slot is #agg 0): T-SQL's AVG
}

pub type MrPlan = record {
    pub inCols: []lexdb_sql.ColDef    // the input's columns, bare names
    pub keyX: []Expr                  // PARTITION BY then ORDER BY, resolved against inCols
    pub keyAt: []int                  // per key: its input column, -1 an expression
    pub np: int
    pub desc: []bool                  // per ORDER BY item
    pub nullsFirst: []bool
    pub prog: lexdb_match.Prog
    pub shown: []str                  // per variable, CLASSIFIER's text
    pub navs: []MrNav                 // slot k of every rewritten expression
    pub defs: []Option[Expr]          // per variable: its DEFINE, rewritten (slots); None always true
    pub defNavs: [][]int              // ... the slots each uses
    pub meas: []Expr                  // MEASURES, rewritten
    pub measNavs: [][]int
    pub local: bool                   // every DEFINE local: the matcher's memo
    pub rows: int
    pub skip: int
    pub skipSet: []bool               // TO FIRST/LAST: the variables named
    pub outs: []OutCol                // the output columns
    pub outFrom: []int                // per output column: input column j (j >= 0) or measure -1 - i
    pub dialect: int
    pub text: str                     // the clause as one line (EXPLAIN)
}

// ---- what the physical plan's builders ask of a planned query (lazySeries,
// boundOnce, streams)

// Whether subquery i of q, in FROM, is an integer generate_series read by
// q's first level only, as a series made as it is read: nothing reads it
// again (a hash join's or a second scan's rows are held), and its values
// do not depend on the row.
pub fn lazySeries(q: &Query, i: int): bool {
    let sp = &q.subs[i]
    if sp.use != lexdb_sql.SUB_FROM || sp.sel.srf != "generate_series" || sp.cte >= 0 || len(sp.sel.q.refs) > 0 || len(sp.sel.outs) == 0 { return false }
    // (its type an integer's: oidType's K_INT, without its search of the array types)
    let oid = sp.sel.outs[0].oid
    if oid != lexdb_sql.OID_INT2 && oid != lexdb_sql.OID_INT4 && oid != lexdb_sql.OID_INT8 { return false }
    if len(q.levels) == 0 || q.levels[0].src != i || q.levels[0].lateral { return false }
    for k in 1..len(q.levels) { if q.levels[k].src == i { return false } }
    return true
}

// Whether q's levels' conditions were bound for the plan (bindSel) and
// are still its conditions, one each.
pub fn boundOnce(q: &Query): bool {
    if len(q.cc) != len(q.levels) || len(q.cp) != len(q.levels) { return false }
    for k in 0..len(q.levels) { if len(q.cc[k]) != len(q.levels[k].cond) || len(q.cp[k]) != len(q.levels[k].post) { return false } }
    return true
}

// Whether a planned SELECT's rows can be given as the scan reads them
// (eachRow): execSel's last branch, with nothing kept for after it.
pub fn streams(sel: &Sel): bool {
    if sel.setop != 0 || len(sel.srf) > 0 || sel.aggQ || sel.sort || len(sel.wins) > 0 || sel.distinct || sel.offset > 0 || len(sel.locks) > 0 { return false }
    if sel.q.corr { for x in sel.exprs { if hasCorr(&x) { return false } } }
    return !hasSrfCall(&sel.exprs)
}

// ---- the pipeline's plans (lexdb_pipe; design/lexdb-layers.md 6.2.3, slice P1):
// their arms made here (planX, scanArm, filterOver, joinsOver, pipeAgg),
// compiled and run by lexdb_exec (pipeSel, lexdb_pipe.compile)
//
// A SELECT the pipeline runs has its plan made at the end of planning
// (pipeSel, after bindSel) and kept with the Sel, so the plan cache keeps
// it: Limit? (Project (Filter? (Scan))) over one table, or an Agg over
// the same under the Sel's views. Its arms take what the plan bound (the
// outputs, Sel.ox; the table's conditions, Query.cc), moved out of the
// Sel; what it did not bind for a subquery run once is bound for the plan
// (lexdb_bind.bindSubs). With SET lexdb_batch on, every run of the Sel is
// the pipeline's (runPipe, pipeGroups): streamed (eachRowB) and held
// (execSelIn) alike, the subqueries run once first and their values given.
// With it off the row engine runs it, binding per run.

// x bound for a plan the pipeline runs: over q's columns by place, its
// parameters as slots, a subquery run once as its value (BX.Sub).
pub fn planX(x: &Expr, q: &Query): Option[BX] {
    let none: []Val = []
    return lexdb_bind.bindSubs(x, &q.cols, &none, &up().typing)
}

// sel's table's conditions for its plan: moved from Query.cc[0], one the
// plan did not bind bound now (planX); None if one does not bind
// (nothing moved).
pub fn planConds(sel: mut &Sel): Option[[]BX] {
    if sel.q.corr { return planCondsA(sel) }
    var more = match condsMore(&sel.q) {
        Some(x) { x }
        None { return None }
    }
    var cc = replace(mut &sel.q.cc[0], [])
    var cs: []BX = withCapacity(len(cc))
    for i in 0..len(cc) {
        match replace(mut &cc[i], None) {
            Some(b) { append(mut &cs, b) }
            None { append(mut &cs, replace(mut &more[i], None).unwrap()) }
        }
    }
    return Some(cs)
}

// Per condition of q's table the plan did not bind, its binding for the
// plan (planX); [] when the plan bound every one; None if one does not
// bind.
fn condsMore(q: &Query): Option[[]Option[BX]] {
    var more: []Option[BX] = []
    for i in 0..len(q.cc[0]) {
        if q.cc[0][i].isSome() { continue }
        let b = planX(&q.levels[0].cond[i], q)
        if b.isNone() { return None }
        while len(more) < i { append(mut &more, None) }
        append(mut &more, b)
    }
    return Some(more)
}

// The scan of sel's only table (lexdb_plan.PScan): its columns' kinds by
// their slots, those decoded, and whether it reads batches (aggs: an
// aggregate's, which reads a primary key's points as a batch too).
pub fn scanArm(q: &Query, aggs: bool): PScan {
    let lv = &q.levels[0]
    let t = &lv.t
    var kinds: []int = array(len(q.cols), lexdb_rows.BK_NONE)
    for i in 0..len(t.cols) { kinds[lv.first + i] = lexdb_rows.pipeKind(&t.cols[i], false) }
    var need: []bool = withCapacity(len(t.cols))
    for i in 0..len(t.cols) { append(mut &need, len(lv.need) == 0 || lv.need[i]) }
    // (rows the run holds: always read as batches, or row by row if few; a
    // recursive CTE's working table past the query's subqueries, Q8 R2)
    let held = if lv.src >= 0 { lv.src } else if lv.work >= 0 { len(q.subs) + lv.work } else { -1 }
    let batch = held >= 0 || firstBatches(&lv.path, len(t.pk), ixCovers(lv, lv.path.index), lv.stops, aggs)
    return PScan{level: 0, first: lv.first, kinds: kinds, need: need, part: len(lv.need) > 0, batch: batch, stops: lv.stops, sorted: batch && keyOrdered(q, 0), held: held}
}

// Scan (ps, its query's subqueries), under a Filter of cs if any.
pub fn filterOver(ps: PScan, cs: []BX, subs: []PSub): PPlan {
    let leaf = PPlan.Scan(ps, subs)
    return if len(cs) > 0 { PPlan.Filter(leaf, cs) } else { leaf }
}

// The census's word for a level joinsOver does not join by its kind.
fn noJoin(lv: &Level) {
    if lexdb_census.ON { lexdb_census.no(if lv.lateral { "join: LATERAL" } else if lv.lock != 0 { "join: a locked table" } else if lv.semi || lv.anti { "join: a semi or anti join level" } else { "join: a kind it does not join" }) }
}

// The tables after sel's first joined over base (its Filter? (Scan)):
// a Join arm per level (slice P2), its keys, conditions and WHERE
// conjuncts bound for the plan, its table's arm (lexdb_plan.PJoin): a
// hash (read once) of a table, a lookup per row by its whole primary key,
// or a range per row (as the batch driver chose them, bJoinPlan; under a
// first table that may stop early too, Q8 R4). Err(base): a level the
// pipeline does not join (a subquery's or CTE's rows, LATERAL, a semi or
// anti join, RIGHT or FULL, a locked table, a per-row path of another
// kind, a collation's key, an expression that does not bind).
pub fn joinsOver(q: &Query, base: PPlan): Result[PPlan, PPlan] {
    var p = base
    var k = 1
    while k < len(q.levels) {
        let lv = &q.levels[k]
        if lv.grp > 0 {
            // a build group (optimizer 49): one hash of its levels' join
            match grpArm(q, k) {
                Some(j) { p = PPlan.Join(p, j) }
                None {
                    // census: lexdb_census.no("join: a build group's arm")
                    return Err(p)
                }
            }
            k += lv.grp + 1
            continue
        }
        let inner = lv.join == lexdb_sql.J_INNER || lv.join == lexdb_sql.J_CROSS
        let rj = keepsRight(lv.join)
        if !(inner || rj || lv.join == lexdb_sql.J_LEFT) || lv.lateral || lv.lock != 0 {
            // census: noJoin(lv)
            return Err(p)
        }
        if lv.src >= 0 && lazySeries(q, lv.src) {
            // census: lexdb_census.no("join: a series made as read, not first")
            return Err(p)
        }
        if inner && len(lv.post) > 0 {
            // census: lexdb_census.no("join: an inner level with a WHERE after it (post)")
            return Err(p)
        }
        if q.corr && pathCorr(&lv.path) {
            // census: lexdb_census.no("join: a correlated path")
            return Err(p)
        }
        // (a RIGHT or FULL JOIN: hashed, each with its own marks of the rows that joined)
        if rj && lv.perRow {
            // census: lexdb_census.no("join: RIGHT or FULL read per row")
            return Err(p)
        }
        let mark = if lv.mode == LV_NOTIN { MK_NOTIN } else if lv.mode == LV_MARK { markOf(q, lv) }
                   else if lv.anti { MK_ANTI } else if lv.semi || lv.semiSub >= 0 { MK_SEMI } else { MK_JOIN }
        if lv.mode != 0 && !(lv.virt() && !lv.perRow) {
            // census: lexdb_census.no("join: an optimizer-50 level read per row")
            return Err(p)
        }
        // (under a first table that stops early too: the pipe joins its
        // rows in slices that grow, Q8 R4)
        let look = lv.perRow && lv.semiSub < 0 && lookupPath(q, lv)
        let range = lv.perRow && !look && rangePath(q, lv)
        if lv.perRow && !look && !range {
            // census: lexdb_census.no("join: read per row, neither a key lookup nor a range")
            return Err(p)
        }
        let t = &lv.t
        var j = PJoin{how: JH_HASH, kind: if inner { lexdb_sql.J_INNER } else { lv.join }, mark: MK_JOIN, resCol: -1, res: [],
                                 scan: joinScan(q, k),
                                 build: [], hcols: [], keys: [], ktypes: [], exact: true, colls: [], conds: [], keq: -1, post: [], index: lv.path.index,
                                 rng: [], capNulls: false, noNulls: lv.path.noNulls, sub: []}
        j.mark = mark
        if !lv.perRow {
            if lv.virt() { j.how = JH_ROWS }
            if lv.resNot {
                j.resCol = lv.resCol
                match planX(&lv.resVal, q) {
                    Some(b) { append(mut &j.res, b) }
                    None {
                        // census: lexdb_census.no("join: an expression does not bind (planX)")
                        return Err(p)
                    }
                }
            }
            // (no key: a join of every pair, its conditions per pair; a LEFT,
            // RIGHT or FULL JOIN's unmatched rows as a hash's, Q8 R4)
            if len(lv.hashCols) == 0 {
                if mark != MK_JOIN || lv.resNot {
                    // census: lexdb_census.no("join: no hash key, a semi, anti or mark join")
                    return Err(p)
                }
            } else if len(lv.hashVals) != len(lv.hashCols) {
                // census: lexdb_census.no("join: hash keys and values differ")
                return Err(p)
            }
            // (a collation's key, Q8 R4: a table's hash of a join, its keys
            // made their collated values)
            for hk in lv.hashKinds {
                if hk != lexdb_sql.COLL_EXACT {
                    if mark != MK_JOIN || lv.virt() {
                        // census: lexdb_census.no("join: a collation's hash key, not a table's join")
                        return Err(p)
                    }
                    j.colls = collections.copyOf(&lv.hashKinds)
                }
            }
            for i in 0..len(lv.hashCols) {
                append(mut &j.hcols, lv.hashCols[i])
                append(mut &j.ktypes, boundType(&t.cols[lv.hashCols[i]].typ))
                // (a collation's key: its value without its #ci or #pad, the
                // hash makes both sides' collated values)
                match planX(if len(j.colls) > 0 { unColl(&lv.hashVals[i]) } else { &lv.hashVals[i] }, q) {
                    Some(b) { append(mut &j.keys, b) }
                    None {
                        // census: lexdb_census.no("join: an expression does not bind (planX)")
                        return Err(p)
                    }
                }
            }
            for x in lv.local {
                match planX(&x, q) {
                    Some(b) { append(mut &j.build, b) }
                    None {
                        // census: lexdb_census.no("join: an expression does not bind (planX)")
                        return Err(p)
                    }
                }
            }
            // its conditions but those on its own columns (applied as its
            // rows are read: Level.local)
            for x in lv.cond {
                // (a semi join's and a RIGHT JOIN's: every one, none applied as read)
                if !rj && !lv.semi && q.minLevel(&x) >= k { continue }
                if applied(q, &x) { continue }
                if len(lv.hashCols) == 1 && isKeyEq(&x, q, lv) { j.keq = len(j.conds) }
                match planX(&x, q) {
                    Some(b) { append(mut &j.conds, b) }
                    None {
                        // census: lexdb_census.no("join: an expression does not bind (planX)")
                        return Err(p)
                    }
                }
            }
        } else {
            j.how = if look { JH_LOOK } else { JH_RANGE }
            let ix = if look { -1 } else { lv.path.index }
            for i in 0..len(lv.path.eqs) {
                append(mut &j.ktypes, keyType(t, ix, i))
                match planX(&lv.path.eqs[i], q) {
                    Some(b) { append(mut &j.keys, b) }
                    None {
                        // census: lexdb_census.no("join: an expression does not bind (planX)")
                        return Err(p)
                    }
                }
            }
            if range && len(lv.path.rng) > 0 {
                append(mut &j.ktypes, keyType(t, ix, len(lv.path.eqs)))
                for b in lv.path.rng {
                    match planX(&b.val, q) {
                        Some(v) { append(mut &j.rng, PBound{op: b.op.toStr(), val: v}) }
                        None {
                            // census: lexdb_census.no("join: an expression does not bind (planX)")
                            return Err(p)
                        }
                    }
                }
            }
            j.capNulls = range && lv.path.index >= 0 && (len(lv.path.rng) > 0 || lv.path.noNulls)
            for x in lv.cond {
                if applied(q, &x) { continue }
                match planX(&x, q) {
                    Some(b) { append(mut &j.conds, b) }
                    None {
                        // census: lexdb_census.no("join: an expression does not bind (planX)")
                        return Err(p)
                    }
                }
            }
        }
        for x in lv.post {
            if applied(q, &x) { continue }
            match planX(&x, q) {
                Some(b) { append(mut &j.post, b) }
                None {
                    // census: lexdb_census.no("join: an expression does not bind (planX)")
                    return Err(p)
                }
            }
        }
        p = PPlan.Join(p, j)
        k += 1
    }
    return Ok(p)
}

// x without the #ci or #pad L2 wraps a collated comparison's sides in
// (lexdb_bind's), else x.
fn unColl(x: &Expr): &Expr {
    match x {
        Expr.Call(f, args, _) { if (f == "#ci" || f == "#pad") && len(args) == 1 { return &args[0] } }
        else {}
    }
    return x
}

// An optimizer 50 level's correlation keys when it holds IN's summary (a
// null-aware anti join's, an IN's mark: its hash columns but the value);
// -1 none.
pub fn inKeys(q: &Query, k: int): int {
    let lv = &q.levels[k]
    if lv.mode == 0 || (lv.mode == LV_MARK && q.subs[lv.src].use != lexdb_sql.SUB_IN) { return -1 }
    return len(lv.hashCols) - 1
}

// EXPLAIN's word for a hashed semi, anti or mark join's level.
pub fn semiWord(lv: &Level): str {
    if lv.mode == LV_NOTIN { return "anti join (null-aware) " }
    if lv.mode == LV_MARK { return "mark join " }
    return if lv.anti { "anti join " } else { "semi join " }
}

// EXPLAIN's word for a subquery whose rows are a level's (RUN_SEMI,
// RUN_MARK; use its lexdb_sql.SUB_*): NOT IN's anti join is null-aware.
pub fn runWord(ps: &PSub, use: int): str {
    if ps.run == RUN_MARK { return "mark join" }
    if ps.run == RUN_GROUPED { return "grouped" }
    if ps.anti && use == lexdb_sql.SUB_IN { return "anti join (null-aware)" }
    return if ps.anti { "anti join" } else { "semi join" }
}

// A mark join's PJoin.mark: its subquery's EXISTS or IN.
fn markOf(q: &Query, lv: &Level): int { return if q.subs[lv.src].use == lexdb_sql.SUB_IN { MK_MARK_IN } else { MK_MARK_EX } }

// Level k's table as a join reads it (PScan): its columns' kinds by their
// slots, those decoded, in batches where its path reads ranges.
fn joinScan(q: &Query, k: int): PScan {
    let lv = &q.levels[k]
    let t = &lv.t
    var kinds: []int = array(len(q.cols), lexdb_rows.BK_NONE)
    for i in 0..len(t.cols) { kinds[lv.first + i] = lexdb_rows.pipeKind(&t.cols[i], false) }
    var need: []bool = withCapacity(len(t.cols))
    for i in 0..len(t.cols) { append(mut &need, len(lv.need) == 0 || lv.need[i]) }
    let batch = scanBatches(&lv.path, len(t.pk), ixCovers(lv, lv.path.index), false, true)
    return PScan{level: k, first: lv.first, kinds: kinds, need: need, part: len(lv.need) > 0, batch: batch, stops: false, sorted: batch && !lv.perRow && keyOrdered(q, k), held: -1}
}

// ---- bushy joins: a hash of a join (optimizer 49)
//
// A build group is a hub level g and its members, the q.levels[g].grp
// levels after it: a left-deep chain the row engine runs as it is (each
// read once and hashed), which the pipeline runs as one hash of their
// join (JH_JOIN), probed by the rows of the levels before g.

pub const GRP_MAX: int = 2      // a group's members at most

// A plan with build groups is taken when it costs under this share of the
// best left-deep plan (optimizer 49.3): a group's rows are a join's
// estimate and its build reads its hub whole, so a near-tie keeps the
// left-deep order (q5's and q8's (nation, region) groups gain under 4% in
// the model, where reduceHashes already narrows the left-deep hashes).
pub const GRP_GAIN: float = 0.9f

pub const BU_OFF: int = 0       // left-deep orders only
pub const BU_COST: int = 1      // a build group where it costs less (the default)
pub const BU_FORCE: int = 2     // a build group wherever one is valid (tests)

var bushyMode: int = BU_COST

// The build groups' switch (tests and measuring): BU_*.
pub fn setBushy(mode: int) { bushyMode = mode }

// A key of build group g's level l: "col = val", col a plain column of
// level l, val of the levels before g (outer: the group's key) or of the
// group's levels before l (its key in the build). Its column's slot.
type GKey = record { slot: int; val: Expr }

fn (q: &Query) grpKey(g: int, l: int, x: &Expr, outer: bool): Option[GKey] {
    match x {
        Expr.Bin(op, a, b) {
            if op != "=" { return None }
            for side in 0..2 {
                let me = if side == 0 { &a } else { &b }
                let other = if side == 0 { &b } else { &a }
                match me {
                    Expr.Col(n, _) {
                        if q.levelOf(&n) == l {
                            let ok = if outer { q.valBefore(other, g) } else { q.maxLevel(other) < l && q.minLevel(other) >= g && !hasCorr(other) }
                            if ok { return Some(GKey{slot: q.slotOf(&n), val: lexdb_sql.cloneExpr(other)}) }
                        }
                    }
                    else {}
                }
            }
            return None
        }
        else { return None }
    }
}

// The last level of the build group of hub g.
fn grpEnd(q: &Query, g: int): int { return g + q.levels[g].grp }

// Whether build group g's levels are ones its arm may be made of: inner
// joins of tables each read once (hashed), no lock, no WHERE after them,
// no semi or anti join.
fn grpPlain(q: &Query, g: int): bool {
    for l in g..grpEnd(q, g) + 1 {
        let lv = &q.levels[l]
        if !(lv.join == lexdb_sql.J_INNER || lv.join == lexdb_sql.J_CROSS) || lv.lateral || lv.lock != 0 || lv.virt() || lv.perRow { return false }
        if len(lv.post) > 0 || lv.semi || lv.anti || lv.semiSub >= 0 || lv.resNot { return false }
    }
    return true
}

// Whether the pipeline may run q's joins, so that a build group is worth
// planning (optimizer 49.5; else exec's glue clears it): no outer values, no
// correlated subquery that stays one (one in WHERE that is not a semi or
// anti join's candidate, which semiJoins may make a level).
fn grpRuns(q: &Query, hs: &FromHints): bool {
    if len(q.refs) > 0 { return false }
    for i in 0..len(q.subs) {
        if len(q.subs[i].sel.q.refs) > 0 && !(i < len(hs.semiCand) && hs.semiCand[i]) { return false }
    }
    return true
}

// The pipeline's arm of build group g (JH_JOIN): the hub's scan and own
// conditions, each member's hash join over the hub's rows (its keys and
// conditions those of the group's levels before it), and the group's keys
// and conditions on the levels before g. None: not one it makes.
fn grpArm(q: &Query, g: int): Option[PJoin] {
    if g + q.levels[g].grp >= len(q.levels) || !grpPlain(q, g) { return None }
    let hub = &q.levels[g]
    var j = PJoin{how: JH_JOIN, kind: lexdb_sql.J_INNER, mark: MK_JOIN, resCol: -1, res: [], scan: noScan(), build: [], hcols: [], keys: [],
                  ktypes: [], exact: true, colls: [], conds: [], keq: -1, post: [], index: -1, rng: [], capNulls: false, noNulls: false, sub: []}
    j.scan.level = g
    var hb: []BX = []
    for x in hub.local {
        match planX(&x, q) {
            Some(b) { append(mut &hb, b) }
            None { return None }
        }
    }
    // the build: the hub's scan (its own conditions), then each member
    var build = filterOver(joinScan(q, g), hb, [])
    var keyAt = -1
    for l in g..grpEnd(q, g) + 1 {
        let lv = &q.levels[l]
        var m = PJoin{how: JH_HASH, kind: lexdb_sql.J_INNER, mark: MK_JOIN, resCol: -1, res: [], scan: joinScan(q, l), build: [], hcols: [], keys: [],
                      ktypes: [], exact: true, colls: [], conds: [], keq: -1, post: [], index: lv.path.index, rng: [], capNulls: false, noNulls: lv.path.noNulls, sub: []}
        var mkey = -1
        for x in lv.cond {
            let lo = q.minLevel(&x)
            if lo >= l { continue }             // its own: applied as its rows are read (Level.local)
            let outer = lo < g
            match q.grpKey(g, l, &x, outer) {
                Some(gk) {
                    let typ = boundType(&q.cols[gk.slot].typ)
                    match planX(&gk.val, q) {
                        Some(b) {
                            if outer {
                                append(mut &j.hcols, gk.slot)
                                append(mut &j.keys, b)
                                append(mut &j.ktypes, typ)
                                keyAt = len(j.conds)
                            } else {
                                append(mut &m.hcols, gk.slot - lv.first)
                                append(mut &m.keys, b)
                                append(mut &m.ktypes, typ)
                                mkey = len(m.conds)
                            }
                        }
                        None { return None }
                    }
                }
                None {}
            }
            match planX(&x, q) {
                Some(b) { if outer { append(mut &j.conds, b) } else { append(mut &m.conds, b) } }
                None { return None }
            }
        }
        if l == g { continue }
        for x in lv.local {
            match planX(&x, q) {
                Some(b) { append(mut &m.build, b) }
                None { return None }
            }
        }
        if len(m.hcols) == 1 { m.keq = mkey }
        build = PPlan.Join(build, m)
    }
    j.sub = [build]
    if len(j.hcols) == 0 { return None }
    if len(j.hcols) == 1 { j.keq = keyAt }
    return Some(j)
}

// The hub of the build group level k is in (-1 none).
fn grpOf(q: &Query, k: int): int {
    var g = -1
    for h in 0..k + 1 { if q.levels[h].grp > 0 && h + q.levels[h].grp >= k { g = h } }
    return g
}

// EXPLAIN's line of level k when it is in a build group (its counts
// after it), else "": the hub's hash of the join and its keys, a member's
// own hash in it.
pub fn grpLine(q: &Query, k: int): str {
    let g = grpOf(q, k)
    if g < 0 { return "" }
    var cs: []str = []
    for l in g..grpEnd(q, g) + 1 {
        if k != g && l != k { continue }
        for x in q.levels[l].cond {
            let lo = q.minLevel(&x)
            if lo >= l || (k == g) != (lo < g) { continue }
            match q.grpKey(g, l, &x, k == g) {
                Some(gk) { append(mut &cs, colName(q, gk.slot)) }
                None {}
            }
        }
    }
    let lv = &q.levels[k]
    let tn = lexdb_sql.baseName(&lv.t.name)
    let name = if lv.alias == tn { tn } else { tn + " " + lv.alias }
    let keys = "(" + strings.join(&cs, ", ") + ")"
    if k == g { return "join " + name + ": hash of a join on " + keys + " over " + pathTextAt(q, k) }
    return "  with " + name + ": hash on " + keys + " over " + pathTextAt(q, k)
}

// A slot's column's name in its table.
fn colName(q: &Query, slot: int): str {
    let l = q.levelOf(&q.cols[slot].name)
    if l < 0 { return q.cols[slot].name.clone() }
    return q.levels[l].t.cols[slot - q.levels[l].first].name.clone()
}

// The build groups unmarked (the row engine runs their levels left-deep):
// where no pipeline program holds the query's joins.
pub fn flatGroups(q: mut &Query) {
    for i in 0..len(q.levels) { q.levels[i].grp = 0 }
}

// Whether a conjunct reading a build group's table and another may be
// evaluated on other rows than the left-deep order's (optimizer 49.2):
// cannotFail's, with the wrappers the binder adds for chars and
// collations (#bptrim, #pad, #ci), which cannot fail either.
fn grpSafe(x: &Expr): bool {
    match x {
        Expr.Call(n, args, star) {
            if !star && (n == "#bptrim" || n == "#pad" || n == "#ci") && len(args) == 1 { return grpSafe(&args[0]) }
            if star || (n != "in" && n != "like" && n != "ilike") { return cannotFail(x) }
            for a in args { if !grpSafe(&a) { return false } }
            return true
        }
        Expr.Unary(op, a) { return op == "not" && grpSafe(&a) }
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" || op == "=" || op == "<>" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                return grpSafe(&a) && grpSafe(&b)
            }
            return false
        }
        Expr.IsNull(a, _) { return grpSafe(&a) }
        else { return cannotFail(x) }
    }
}

// Whether sel is a SELECT the pipeline may run (what lexdb_pipe.compile
// takes, and what this Sel must give it): streamed (no sort, grouping,
// DISTINCT, window or set; an OFFSET its Limit skips, Q8 R2), sorted or
// DISTINCT (P3), one table read per row, no correlated subquery left in
// it but in an Apply's conjuncts (applyLevel, Q8 R6; not under an OFFSET,
// TOP PERCENT or WITH TIES, R2's shapes; a correlated subquery's own query
// is one: its outer values are parameters, Q8 R1), its outputs and
// conditions bound for the plan.
pub fn pipeShape(sel: &Sel): bool {
    let q = &sel.q
    // (TOP PERCENT and WITH TIES: the Sort's, Q8 R2)
    // (MATCH_RECOGNIZE: its input's rows, Q8 R3; lexdb_exec.execMatch runs over them)
    if !(streams(sel) || sortShape(sel) || offsetShape(sel)) || len(sel.feedback) > 0 || ((sel.topMode != 0 || sel.withTies) && !sel.sort) || sel.first >= 0 { return false }
    if len(q.levels) == 0 || (q.corr && !lat0(q) && (applyLevel(q) < 0 || !applyR2(sel))) || len(q.top) > 0 { return false }
    if !firstRead(q, &q.levels[0]) { return false }
    // (more outputs than its list's: a subquery run once into a hash, its
    // keys and value, hashSub's, which runHashed reads; Q8 R1)
    if len(sel.exprs) != len(sel.outs) && !hashedOuts(sel) { return false }
    return len(sel.exprs) > 0 && len(sel.ox) == len(sel.exprs) && boundOnce(q)
}

// Whether sel is a SELECT with no FROM the pipeline may run (Q8 R2: a
// Result arm, its one row if its WHERE holds, Query.top): its outputs bound
// for the plan; no ORDER BY (its keys are evaluated, and may fail, on the
// one row), grouping, window, set operation, lock, TOP, WITH TIES, SELECT
// @v, MATCH_RECOGNIZE, set-returning function or correlated subquery left
// in it. An OFFSET or LIMIT it applies itself.
pub fn resultShape(sel: &Sel): bool { return resultWhy(sel) == "" }

// Why resultShape is false for sel ("" it is not).
pub fn resultWhy(sel: &Sel): str {
    let q = &sel.q
    if sel.setop != 0 || len(sel.srf) > 0 || sel.aggQ || len(sel.wins) > 0 || len(sel.locks) > 0 || len(sel.mr) > 0 { return "grouped, a window, a set, locked" }
    if sel.sort || len(sel.feedback) > 0 || sel.topMode != 0 || sel.withTies || sel.first >= 0 { return "ORDER BY, TOP, WITH TIES or SELECT @v" }
    if q.corr || len(q.levels) != 0 || hasSrfCall(&sel.exprs) { return "a correlated subquery or a set-returning function" }
    if len(sel.exprs) == 0 || len(sel.exprs) != len(sel.outs) || len(sel.ox) != len(sel.exprs) { return "outputs and columns differ" }
    return ""
}

// sel's Result plan (resultShape): Limit? (Project (Filter? (Result))),
// its outputs as pipeSel binds them (moved from Sel.ox), its WHERE bound
// for the plan; one that does not bind (a sequence, session or catalog
// function's call) marked for eval at the run (lexdb_bind.evalMark); None
// if such a one holds a subquery (the outputs given back).
pub fn resultPlan(sel: mut &Sel): Option[PPlan] {
    var xs: []BX = withCapacity(len(sel.exprs))
    for i in 0..len(sel.exprs) {
        match replace(mut &sel.ox[i], None) {
            Some(b) { append(mut &xs, b) }
            None {
                // (with no subquery it bound as bindSel binds it: not; eval's at
                // the run, but not with a subquery, whose value eval does not see)
                if !hasSubCall(&sel.exprs[i]) {
                    append(mut &xs, lexdb_bind.evalMark())
                    continue
                }
                match planX(&sel.exprs[i], &sel.q) {
                    Some(b) { append(mut &xs, b) }
                    None {
                        // census: lexdb_census.no("no FROM: an output does not bind (planX), with a subquery")
                        oxBack(sel, xs)
                        return None
                    }
                }
            }
        }
    }
    var cs: []BX = []
    for i in 0..len(sel.q.top) {
        let b = planX(&sel.q.top[i], &sel.q)
        if b.isNone() {
            if hasSubCall(&sel.q.top[i]) {
                // census: lexdb_census.no("no FROM: a condition does not bind (planX), with a subquery")
                oxBack(sel, xs)
                return None
            }
            append(mut &cs, lexdb_bind.evalMark())
            continue
        }
        append(mut &cs, b.unwrap())
    }
    let leaf = PPlan.Result(subsOf(&sel.q))
    let proj = PPlan.Project(if len(cs) > 0 { PPlan.Filter(leaf, cs) } else { leaf }, xs)
    return Some(if sel.limit >= 0 || sel.offset > 0 { PPlan.Limit(proj, sel.limit >= 0, sel.limit, max(sel.offset, 0)) } else { proj })
}

// Whether sel is streamed but for its OFFSET (Q8 R2: the pipeline's Limit
// skips its rows): no sort, grouping, DISTINCT, window, set, lock or
// set-returning function, no correlated subquery in its outputs.
fn offsetShape(sel: &Sel): bool {
    if sel.offset <= 0 || sel.setop != 0 || len(sel.srf) > 0 || sel.aggQ || sel.sort || len(sel.wins) > 0 || sel.distinct || len(sel.locks) > 0 { return false }
    if sel.q.corr { for x in sel.exprs { if hasCorr(&x) { return false } } }
    return !hasSrfCall(&sel.exprs)
}

// Whether an Apply may run under sel's limit (Q8 R6 over R2's shapes): not
// under an OFFSET, TOP PERCENT or WITH TIES, whose rows past the limit the
// Apply's first-row asks were not built to count.
fn applyR2(sel: &Sel): bool { return sel.offset <= 0 && sel.topMode == 0 && !sel.withTies }

// ---- Apply (Q8 R6; design/lexdb-layers.md 6.3.Q8 R6): the correlated
// subqueries left per row, run per row of the pipeline's joins
//
// A query whose correlated subqueries left per row (q.corr) are all called
// in the WHERE conjuncts of one level is the pipeline's: the joins give
// their rows after that level to an Apply (PPlan.Apply), whose conjuncts
// the caller evaluates per row as the row engine does (evalX: the
// subqueries run for the row's outer values, their results kept per
// values, MEMO_MAX), and the rows that pass go on to the next level. The
// conjuncts are the level's last (subsLast), so each row meets the
// level's other conditions first, as in the row engine.

// Whether sel's outputs, more than its select list's, are a hashed
// subquery's keys and value (hashSub).
fn hashedOuts(sel: &Sel): bool { return len(sel.exprs) > len(sel.outs) && !sel.sort && !sel.distinct }

// ---- window calls in the pipeline (Q8 R7, design/lexdb-layers.md 6.3.Q8 R7)

// Whether sel is a query of window calls the pipeline may run: not an
// aggregate's (its windows are over the groups: exec's view), one table
// read per row (or joins), no correlated subquery left in it, no set
// operation, function in FROM, lock, MATCH_RECOGNIZE, SELECT @v =, or
// set-returning function in the list; DISTINCT ON, WITH TIES and TOP (the
// Sort's, R2's PSort) only sorted and not DISTINCT, as sortShape's.
pub fn winShape(sel: &Sel): bool {
    let q = &sel.q
    if len(sel.wins) == 0 || sel.aggQ || sel.setop != 0 || len(sel.srf) > 0 || len(sel.locks) > 0 || len(sel.feedback) > 0 || len(sel.mr) > 0 { return false }
    if ((sel.donKey > 0 || sel.withTies || sel.topMode != 0) && (!sel.sort || sel.distinct)) || sel.first >= 0 || hasSrfCall(&sel.exprs) { return false }
    if len(q.levels) == 0 || q.corr || len(q.top) > 0 || !firstRead(q, &q.levels[0]) || !boundOnce(q) { return false }
    return len(sel.exprs) > 0 && len(sel.exprs) == len(sel.outs)
}

// The census's reason winShape declines sel (its tests again, in order).
pub fn winWhy(sel: &Sel): str {
    if sel.setop != 0 { return "a window: a set operation" }
    if len(sel.srf) > 0 { return "a window: a function in FROM (execSrf)" }
    if len(sel.locks) > 0 { return "a window: FOR UPDATE" }
    if len(sel.feedback) > 0 { return "a window: SELECT @v = (feedback)" }
    if len(sel.mr) > 0 { return "a window: MATCH_RECOGNIZE" }
    if (sel.donKey > 0 || sel.withTies || sel.topMode != 0) && (!sel.sort || sel.distinct) { return "a window: DISTINCT ON, TOP or WITH TIES not sorted, or DISTINCT" }
    if sel.first >= 0 { return "a window: MIN or MAX by the scan's order (Sel.first)" }
    if hasSrfCall(&sel.exprs) { return "a window: a set-returning function in the select list" }
    let r = queryWhy(sel)
    return if len(r) > 0 { "a window: " + r } else { "a window: ?" }
}

// x bound for a Window's plan: over the query's columns, its subqueries
// run once and the window calls' values (#agg i).
fn winX(x: &Expr, q: &Query): Option[BX] {
    let none: []Val = []
    return lexdb_bind.bindSubsAggs(x, &q.cols, &none, &up().typing)
}

// sel's plan for the pipeline (winShape): Limit? (Sort? (Distinct? (Project
// (Window (Project (the input)))))), the input the conditions, the scan
// and the joins as pipeShape's plan has them, its Project the query's
// columns the Window keeps per row (a single table's: those its scan
// decodes, as the row engine's rows hold them); the outputs and ORDER BY
// keys over a row and its calls' values. None: a key, argument, offset,
// output or ORDER BY key that does not bind, or joins the pipeline does not
// join (what was moved given back).
pub fn pipeWin(sel: mut &Sel): Option[PPlan] {
    var keys: [][]BX = []
    var args: [][]BX = []
    var offs: [][]Option[BX] = []
    for w in sel.wins {
        var ks: []BX = []
        for x in w.part {
            match winX(&x, &sel.q) {
                Some(b) { append(mut &ks, b) }
                None { return noWin("a window: a PARTITION BY or ORDER BY key does not bind") }
            }
        }
        for x in w.order {
            match winX(&x, &sel.q) {
                Some(b) { append(mut &ks, b) }
                None { return noWin("a window: a PARTITION BY or ORDER BY key does not bind") }
            }
        }
        var avs: []BX = []
        for x in lexdb_window.argsOf(&w) {
            match winX(&x, &sel.q) {
                Some(b) { append(mut &avs, b) }
                None { return noWin("a window: an argument or FILTER does not bind") }
            }
        }
        var os: []Option[BX] = []
        for ox in [w.startOff.clone(), w.endOff.clone()] {
            match ox {
                Some(x) {
                    let b = winX(&x, &sel.q)
                    if b.isNone() { return noWin("a window: a frame offset does not bind") }
                    append(mut &os, b)
                }
                None { append(mut &os, None) }
            }
        }
        append(mut &keys, ks)
        append(mut &args, avs)
        append(mut &offs, os)
    }
    var xs: []BX = withCapacity(len(sel.exprs))
    for x in sel.exprs {
        match winX(&x, &sel.q) {
            Some(b) { append(mut &xs, b) }
            None { return noWin("a window: an output does not bind") }
        }
    }
    // ORDER BY sorted (slice P3): per key the output it is, else its
    // expression made after the outputs
    var ps: Option[PSort] = None
    if sel.sort {
        var srt = PSort{shown: len(xs), out: [], desc: [], nf: [], coll: [], don: sel.donKey,
                        ties: if sel.topMode & lexdb_sql.TOP_TIES != 0 { TS_TOP } else if sel.withTies { TS_FETCH } else { 0 },
                        pct: sel.topMode & lexdb_sql.TOP_PERCENT != 0, top: if sel.topMode != 0 { sel.topN } else { -1 }}
        for oi in 0..len(sel.order) {
            var o = lexdb_bind.orderOut(&sel.order[oi], &sel.q.cols, &sel.outs, len(sel.exprs))
            if o == -2 { return noWin("a window: an ORDER BY position not in the list") }
            if o < 0 {
                match winX(&sel.order[oi], &sel.q) {
                    Some(b) { append(mut &xs, b) }
                    None { return noWin("a window: an ORDER BY key does not bind") }
                }
                o = len(xs) - 1
            }
            append(mut &srt.out, o)
            append(mut &srt.desc, sel.desc[oi])
            append(mut &srt.nf, sel.nullsFirst[oi])
            append(mut &srt.coll, if oi < len(sel.ordKinds) { sel.ordKinds[oi] } else { lexdb_sql.COLL_EXACT })
        }
        ps = Some(srt)
    }
    // the columns a row keeps: those read above it, and a single table's
    // decoded ones
    let nq = len(sel.q.cols)
    var used: []bool = array(nq, false)
    for ks in keys { for b in ks { uses(&b, mut &used) } }
    for avs in args { for b in avs { uses(&b, mut &used) } }
    for b in xs { uses(&b, mut &used) }
    if len(sel.q.levels) == 1 {
        let lv = &sel.q.levels[0]
        for i in 0..len(lv.t.cols) { if len(lv.need) == 0 || lv.need[i] { used[lv.first + i] = true } }
    }
    var slots: []int = []
    var ins: []BX = []
    for c in 0..nq {
        if !used[c] { continue }
        append(mut &slots, c)
        append(mut &ins, BX.Col(c))
    }
    // (no column kept: a Project of one NULL, not a view's empty one; the
    // rows hold none)
    if len(ins) == 0 { append(mut &ins, BX.Const(Val.Null)) }
    let got = planConds(sel)
    if got.isNone() { return noWin("a window: a condition does not bind (planX)") }
    let cs = got.unwrap()
    let base = filterOver(scanArm(&sel.q, false), cs, subsOf(&sel.q))
    let joined = if len(sel.q.levels) > 1 { joinsOver(&sel.q, base) } else { Ok(base) }
    var jp = PPlan.Result([])
    match move(joined) {
        Ok(x) { jp = x }
        Err(b) {
            unplan(sel, b)
            return None
        }
    }
    let pw = PWin{wins: sel.wins.clone(), keys: keys, args: args, offs: offs, slots: slots}
    let proj = PPlan.Project(PPlan.Window(PPlan.Project(jp, ins), Some(pw)), xs)
    // the operators over it as physAbove makes them (EXPLAIN prints them)
    let dist = if sel.distinct { PPlan.Distinct(proj, false, collections.copyOf(&sel.outKinds)) } else { proj }
    let ordered = if len(sel.order) > 0 { PPlan.Sort(dist, sel.sort, ps) } else { dist }
    return Some(if sel.limit >= 0 || sel.offset > 0 { PPlan.Limit(ordered, sel.limit >= 0 && !sel.sort, sel.limit, max(sel.offset, 0)) } else { ordered })
}

// pipeWin's None, the census's reason noted.
fn noWin(r: &str): Option[PPlan] {
    lexdb_census.no(r)
    return None
}

// A Window plan the pipeline did not take (pipeWin's): its conditions back
// to sel (its outputs were never the Sel's ox).
pub fn unplanWin(sel: mut &Sel, p: PPlan) {
    match move(p) {
        PPlan.Limit(i, _, _, _) { unplanWin(sel, i) }
        PPlan.Sort(i, _, _) { unplanWin(sel, i) }
        PPlan.Distinct(i, _, _) { unplanWin(sel, i) }
        PPlan.Project(i, _) { unplanWin(sel, i) }
        PPlan.Window(i, _) {
            match move(i) {
                PPlan.Project(j, _) { unplan(sel, j) }
                else {}
            }
        }
        else {}
    }
}

// Whether sel sorts or is DISTINCT and the pipeline's Sort may run it
// (slice P3): rows of one select list, no grouping, window, set
// operation, lock, SELECT @v, or function returning rows in it; DISTINCT
// ON, WITH TIES and TOP's PERCENT and WITH TIES sorted (Q8 R2).
fn sortShape(sel: &Sel): bool {
    if sel.setop != 0 || len(sel.srf) > 0 || sel.aggQ || len(sel.wins) > 0 || len(sel.locks) > 0 || len(sel.feedback) > 0 { return false }
    if !(sel.sort || sel.distinct) || hasSrfCall(&sel.exprs) { return false }
    if (sel.donKey > 0 || sel.withTies || sel.topMode != 0) && (!sel.sort || sel.distinct) { return false }
    if sel.q.corr {
        for x in sel.exprs { if hasCorr(&x) { return false } }
        for x in sel.order { if hasCorr(&x) { return false } }
    }
    return true
}

// An EXISTS's select list, which nothing reads (its * reads no column:
// exec's stmtNames, PostgreSQL's simplify_EXISTS_query): its columns made
// NULL, the values the row engine read of them, so the pipeline, which
// takes no output of a column its scan does not decode, runs its rows (Q8
// R1). Not where the rows it counts depend on its values (a set operation,
// grouping, DISTINCT, an aggregate).
pub fn existsUnread(sel: mut &Sel, s: &lexdb_sql.Stmt) {
    if s.setop != 0 || len(s.group) > 0 || len(s.gsets) > 0 || s.distinct || len(s.distinctOn) > 0 || sel.aggQ || sel.setop != 0 { return }
    for i in 0..len(sel.exprs) {
        let col = match sel.exprs[i] {
            Expr.Col(_, _) { true }
            else { false }
        }
        if col { sel.exprs[i] = Expr.Lit(Val.Null) }
    }
}

// Whether q's subquery i runs its own query: not one a semi or anti level
// looks up per row (semiLook took its table: it is no longer run).
pub fn subRuns(q: &Query, i: int): bool {
    for lv in q.levels { if lv.semiSub == i { return false } }
    return true
}

// Whether lv is a table read per row: not a subquery's or CTE's rows, not
// LATERAL, not locked, no WHERE after it, not a semi or anti join's.
pub fn tableRead(lv: &Level): bool {
    return lv.perRow && !lv.lateral && !lv.virt() && lv.lock == 0 && len(lv.post) == 0 && !lv.semi && !lv.anti && lv.semiSub < 0
}

// Whether lv is rows the run holds that the pipeline reads as q's first
// table, cut into batches (lexdb_held; item 6 of design/lexdb-batch-gaps.md):
// a subquery in FROM's (a derived table, view, CTE, VALUES, a function
// scan, a catalog relation, an integer series made as it is read) or a
// recursive CTE's working table (Q8 R2: the rows of the round before), not
// LATERAL, locked, with a WHERE after it, or a semi or anti join's. A
// series is one of smallint, integer or bigint (its end is the type's
// range: lexdb_held.seriesOf).
pub fn heldRead(q: &Query, lv: &Level): bool {
    if lv.work >= 0 { return lv.src < 0 && lv.perRow && !lv.lateral && lv.lock == 0 && len(lv.post) == 0 && !lv.semi && !lv.anti && lv.semiSub < 0 }
    if lv.src < 0 || !lv.perRow || lv.lateral || lv.lock != 0 || len(lv.post) > 0 || lv.semi || lv.anti || lv.semiSub >= 0 { return false }
    if lazySeries(q, lv.src) {
        let oid = q.subs[lv.src].sel.outs[0].oid
        return oid == lexdb_sql.OID_INT2 || oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT8
    }
    return true
}

// Whether lv is a table read by its whole primary key (a point select's
// first level: a scan of one point, read row by row; firstBatches is
// false for it).
pub fn pointRead(lv: &Level): bool {
    let p = &lv.path
    return !lv.virt() && p.index < 0 && len(p.eqs) > 0 && len(p.eqs) == len(lv.t.pk) && len(p.ins) == 0 && p.inSub < 0 && len(p.inArr) == 0
}

// Whether lv is a first table the pipeline reads: a table (tableRead) or
// rows the run holds (heldRead), a LATERAL subquery's over outer values
// among them (lat0Read, Q8 R3).
fn firstRead(q: &Query, lv: &Level): bool { return tableRead(lv) || heldRead(q, lv) || lat0Read(q, lv) }

// ---- the census (lexdb_census, design/lexdb-layers.md 6.4): called only
// in a census copy of the tree (its `// census:` hooks, or behind
// `if lexdb_census.ON`); shapeWhy and aggWhy name the first condition of
// pipeShape and aggShape a Sel fails, in their order ("" none)

// A Sel's key for the census: its tables, outputs, columns and kind.
pub fn censusKey(sel: &Sel): str {
    var k = ""
    for lv in sel.q.levels { k = k + lv.t.name + "," }
    return k + "/" + len(sel.exprs).toStr() + "/" + len(sel.q.cols).toStr() + "/" + (if sel.aggQ { "a" } else { "r" }) +
           sel.setop.toStr() + "/" + len(sel.q.subs).toStr() + "/" + sel.srf
}

// After pipeSel's planning of sel (joins: of its levels program, Query.jp):
// the reason noted kept under sel's key when the pipeline did not take it.
pub fn censusKeep(sel: &Sel, joins: bool) {
    let r = lexdb_census.take()
    if joins {
        let pj = match sel.pipe {
            Some(pg) { pg.joins }
            None { false }
        }
        if len(sel.q.levels) > 1 && sel.q.jp.isNone() && !pj {
            lexdb_census.keep(&("jp:" + censusKey(sel)), &(if len(r) > 0 { r } else { "?" }))
        }
        return
    }
    if sel.pipe.isNone() { lexdb_census.keep(&censusKey(sel), &(if len(r) > 0 { r } else { "?" })) }
}

// A run of sel by engine (lexdb_census.note): how, the run's own reason
// (a give-way, a window ...), else the plan's; with the joins' engine.
pub fn censusNote(sel: &Sel, engine: &str, how: &str) {
    let k = censusKey(sel)
    var r = if len(how) > 0 { how.toStr() } else { lexdb_census.reasonOf(&k) }
    if engine != "pipe" && len(sel.q.levels) > 1 {
        if sel.q.jp.isSome() { r = r + " [joins: the pipeline's levels program]" }
        else { r = r + " [joins: row; " + lexdb_census.reasonOf(&("jp:" + k)) + "]" }
    }
    lexdb_census.note(engine, &r)
}

// A run of sel by execSel that its pipeline rows did not make: batch (SET
// lexdb_batch), gave (they gave way at the run), noLimit (FOR UPDATE's
// run). An aggregate the pipeline runs is noted after its run.
pub fn censusRun(sel: &Sel, batch: bool, gave: bool, noLimit: bool) {
    let pa = match sel.pipe {
        Some(pg) { pg.groups }
        None { false }
    }
    if !batch { lexdb_census.note("off", "") }
    else if gave { censusNote(sel, "row", "gave way at the run (pipeHeld)") }
    else if noLimit && sel.pipe.isSome() { censusNote(sel, "row", "FOR UPDATE's run (noLimit)") }
    else if sel.setop != 0 { if !setHeld(sel) { lexdb_census.note("setop", "a set operation (runSet): TOP or WITH TIES") } }
    else if sel.aggQ && pa {}
    else if len(sel.wins) > 0 && !sel.aggQ { censusNote(sel, "row", "") }
    else { censusNote(sel, "row", "") }
}

// A write's rows found by the row engine (runQuery over q): what (UPDATE,
// DELETE, MERGE, ALTER TABLE), batch (SET lexdb_batch).
pub fn censusDml(q: &Query, what: &str, batch: bool) {
    if !batch {
        lexdb_census.note("off", what)
        return
    }
    let shape = if len(q.levels) == 0 { "no table" } else if len(q.levels) > 1 { "joins" } else if q.levels[0].path.index >= 0 { "index" } else if len(q.levels[0].path.eqs) == len(q.levels[0].t.pk) && len(q.levels[0].t.pk) > 0 { "primary key equal" } else { "scan or key range" }
    match q.jp {
        Some(pg) {
            // (Q8 R5: its rows the pipeline's program's; one that gives way at the run is noted again, as dml)
            lexdb_census.note("pipe-dml", &(what + "'s rows by the pipeline's program [" + shape + (if pg.joins { "" } else { ": a point" }) + "]"))
            return
        }
        None {}
    }
    var why = lexdb_census.reasonOf("dml")
    if len(why) == 0 { why = if what == "MERGE" { "a few source rows held, joined row by row (fewSource)" } else { "no reason noted" } }
    lexdb_census.note("dml", &(what + " finds its rows (runQuery) [" + shape + "]: " + why))
}

pub fn shapeWhy(sel: &Sel): str {
    let q = &sel.q
    if !(streams(sel) || sortShape(sel)) {
        if sel.setop != 0 { return "a set operation" }
        if len(sel.srf) > 0 { return "a function in FROM (execSrf)" }
        if len(sel.wins) > 0 { return "a window" }
        if len(sel.locks) > 0 { return "FOR UPDATE" }
        if len(sel.feedback) > 0 { return "SELECT @v = (feedback)" }
        if sel.donKey > 0 { return "DISTINCT ON" }
        if sel.withTies { return "WITH TIES" }
        if sel.topMode != 0 { return "TOP PERCENT or WITH TIES" }
        if hasSrfCall(&sel.exprs) { return "a set-returning function in the select list" }
        if q.corr { return "a correlated subquery in the outputs or ORDER BY" }
        if sel.offset > 0 { return "OFFSET" }
        return "not streamed"
    }
    if len(sel.feedback) > 0 { return "SELECT @v = (feedback)" }
    if (sel.topMode != 0 || sel.withTies) && !sel.sort { return "TOP PERCENT or WITH TIES, not sorted" }
    if sel.first >= 0 { return "MIN or MAX by the scan's order (Sel.first)" }
    return queryWhy(sel)
}

fn queryWhy(sel: &Sel): str {
    let q = &sel.q
    if len(q.levels) == 0 { return "no FROM: " + resultWhy(sel) }
    if q.corr && !lat0(q) && applyLevel(q) < 0 { return "a correlated subquery left per row (q.corr): " + applyWhy(q) }
    if q.corr && !lat0(q) && !applyR2(sel) { return "a correlated subquery left per row (q.corr): under an OFFSET, TOP PERCENT or WITH TIES" }
    if len(q.top) > 0 { return "conditions on no table (q.top)" }
    if !firstRead(q, &q.levels[0]) { return "first level: " + levelWhy(q, &q.levels[0]) }
    if len(sel.exprs) == 0 || (len(sel.exprs) != len(sel.outs) && !hashedOuts(sel)) { return "outputs and columns differ" }
    if len(sel.ox) != len(sel.exprs) { return "outputs not bound for the plan (ox)" }
    if !boundOnce(q) { return "conditions not bound once (boundOnce)" }
    return ""
}

pub fn aggWhy(sel: &Sel): str {
    let q = &sel.q
    if sel.setop != 0 { return "a set operation" }
    if len(sel.srf) > 0 { return "a function in FROM (execSrf)" }
    if sel.first >= 0 && len(q.levels) != 1 { return "agg: MIN or MAX by the scan's order (Sel.first), over joins" }
    if len(sel.locks) > 0 { return "FOR UPDATE" }
    if len(q.levels) == 0 { return "agg: no FROM" }
    if q.corr && !lat0(q) && applyLevel(q) < 0 { return "agg: a correlated subquery left per row (q.corr): " + applyWhy(q) }
    if q.corr && !lat0(q) && aggCorr(sel) { return "agg: a correlated subquery in a key or argument" }
    if q.corr && !lat0(q) && sel.first >= 0 { return "agg: a correlated subquery left per row under MIN or MAX by the scan's order" }
    if len(q.top) > 0 { return "agg: conditions on no table (q.top)" }
    if !firstRead(q, &q.levels[0]) { return "agg: first level: " + levelWhy(q, &q.levels[0]) }
    if !boundOnce(q) { return "agg: conditions not bound once (boundOnce)" }
    if len(q.levels) == 1 && (q.levels[0].first != 0 || len(q.cols) != len(q.levels[0].t.cols)) { return "agg: one table, with columns besides its own" }
    if len(sel.gsets) > 0 { for k in sel.groupKinds { if k != lexdb_sql.COLL_EXACT { return "agg: a collation's GROUP BY key in grouping sets" } } }
    return ""
}

// Why lv is not a first table the pipeline reads (firstRead).
pub fn levelWhy(q: &Query, lv: &Level): str {
    if lv.work >= 0 { return "a recursive CTE's working table" }
    if !lv.perRow { return "not read per row" }
    if lv.lateral { return "LATERAL" }
    if lv.lock != 0 { return "locked" }
    if len(lv.post) > 0 { return "a WHERE after it (post)" }
    if lv.semi || lv.anti || lv.semiSub >= 0 { return "a semi or anti join's" }
    if lv.src >= 0 && lazySeries(q, lv.src) { return "a series not of integers" }
    return "?"
}

// pipeAgg's None, the census's reason noted.
fn noAgg(r: &str): Option[PPlan] {
    lexdb_census.no(r)
    return None
}

// An aggregate's plan for the pipeline (slice P1b; lexdb_exec compiles it, lexdb_pipe.compile):
// Agg (Filter? (Scan)) under physOf's operators over the groups (views:
// HAVING, the outputs, DISTINCT, ORDER BY and LIMIT stay execSel's, over
// the groups the pipeline gives). The keys and calls bound for the plan,
// and the table's conditions (Query.cc) moved, into the arms. None: no plan (what was moved is given back).
pub fn pipeAgg(sel: mut &Sel): Option[PPlan] {
    var keys: []BX = []
    for x in sel.groupBy {
        match planX(&x, &sel.q) {
            Some(b) { append(mut &keys, b) }
            None {
                // census: lexdb_census.no("agg: a GROUP BY key does not bind (planX)")
                return None
            }
        }
    }
    var calls: []PCall = []
    for sp in sel.specs {
        let f = &sp.fname
        // (the calls it accumulates: lexdb_pipe.compile's; one by a collation
        // row by row, Q8 R2)
        var arg: Option[BX] = None
        // (the values besides the argument: string_agg's separator, the ORDER BY keys)
        var more: []BX = []
        if !sp.star {
            if len(sp.args) < 1 || len(sp.args) > 2 {
                // census: lexdb_census.no("agg: a call of no or more than two arguments")
                return None
            }
            arg = planX(&sp.args[0], &sel.q)
            if arg.isNone() {
                // census: lexdb_census.no("agg: a call's argument, ORDER BY or FILTER does not bind (planX)")
                return None
            }
            for k in 1..len(sp.args) {
                match planX(&sp.args[k], &sel.q) {
                    Some(b) { append(mut &more, b) }
                    None {
                        // census: lexdb_census.no("agg: a call's argument, ORDER BY or FILTER does not bind (planX)")
                        return None
                    }
                }
            }
        }
        for o in sp.order {
            match planX(&o, &sel.q) {
                Some(b) { append(mut &more, b) }
                None {
                    // census: lexdb_census.no("agg: a call's argument, ORDER BY or FILTER does not bind (planX)")
                    return None
                }
            }
        }
        var filt: Option[BX] = None
        match sp.filter {
            Some(fx) {
                filt = planX(&fx, &sel.q)
                if filt.isNone() {
                    // census: lexdb_census.no("agg: a call's argument, ORDER BY or FILTER does not bind (planX)")
                    return None
                }
            }
            None {}
        }
        append(mut &calls, PCall{fname: f.toStr(), star: sp.star, arg: arg, filter: filt, distinct: sp.distinct, more: more, dirs: sp.dirs.clone(), dia: sp.dia, kind: sp.kind})
    }
    var cs = match planConds(sel) {
        Some(x) { x }
        None { return noAgg("agg: a condition does not bind (planX)") }
    }
    // (MIN/MAX by the scan's order, Q8 R2: its first row whose value is not
    // NULL; unplan drops the condition)
    if sel.first >= 0 { append(mut &cs, BX.IsNull(BX.Col(sel.first), true)) }
    var ps = scanArm(&sel.q, true)
    // (over joins every table's columns are the plan's: lexdb_plan.needs;
    // an Apply's plan runs as joins, Q8 R6)
    if len(keys) == 0 && len(sel.q.levels) == 1 && !sel.q.corr {
        ps.need = callsNeed(len(ps.need), &cs, &calls)
        ps.part = true
    }
    var keep: []bool = array(len(sel.q.cols), false)
    for ci in afterCols(sel, &sel.q) { keep[ci] = true }
    let base = filterOver(ps, cs, subsOf(&sel.q))
    // (over joins: slice P2)
    let joined = if len(sel.q.levels) > 1 { joinsOver(&sel.q, base) } else { Ok(base) }
    var input = PPlan.Result([])
    match move(joined) {
        Ok(x) { input = x }
        Err(b) {
            unplan(sel, b)
            return None
        }
    }
    // (correlated subqueries left per row: an Apply's over the joins, Q8 R6)
    if sel.q.corr { input = applyOver(&sel.q, replace(mut &input, PPlan.Result([]))) }
    let agg = PPlan.Agg(if sel.first >= 0 { PPlan.MinMax(input) } else { input }, len(sel.gsets) > 0, Some(PAgg{keys: keys, calls: calls, keep: keep, sets: copySets(&sel.gsets), kinds: collections.copyOf(&sel.groupKinds)}))
    return Some(physAbove(sel, agg))
}

// Whether sel is an aggregate the pipeline may run: one table read per
// row (the query's only columns), GROUP BY (grouping sets too; a
// collation's keys row by row, not in grouping sets: Q8 R2), no window, no
// correlated subquery; MIN/MAX by the scan's order over one table (Q8 R2:
// MinMax).
pub fn aggShape(sel: &Sel): bool {
    let q = &sel.q
    // (window calls over the groups: exec's view over them, as HAVING, Q8 R7)
    if sel.setop != 0 || len(sel.srf) > 0 || (sel.first >= 0 && len(q.levels) != 1) || len(sel.locks) > 0 { return false }
    // (a correlated subquery's own: its outer values are its parameters;
    // one left per row: an Apply's, Q8 R6, not in a key or argument, not
    // under MIN/MAX by the scan's order, R2's MinMax)
    if len(q.levels) == 0 || (q.corr && !lat0(q) && (applyLevel(q) < 0 || aggCorr(sel) || sel.first >= 0)) || len(q.top) > 0 || !firstRead(q, &q.levels[0]) || !boundOnce(q) { return false }
    // (one table: the query's only columns; joins: each level's, joinsOver)
    if len(q.levels) == 1 && (q.levels[0].first != 0 || len(q.cols) != len(q.levels[0].t.cols)) { return false }
    if len(sel.gsets) > 0 { for k in sel.groupKinds { if k != lexdb_sql.COLL_EXACT { return false } } }
    return true
}

// A plan the pipeline did not take: its outputs and conditions back to
// sel, those bound for the plan alone (a subquery's value) as unbound.
pub fn unplan(sel: mut &Sel, p: PPlan) {
    match move(p) {
        PPlan.Limit(i, _, _, _) { unplan(sel, i) }
        PPlan.Sort(i, _, _) { unplan(sel, i) }
        PPlan.Distinct(i, _, _) { unplan(sel, i) }
        PPlan.Having(i) { unplan(sel, i) }
        // (its keys and calls were bound for the plan only)
        PPlan.Agg(i, _, _) { unplan(sel, i) }
        PPlan.MinMax(i) { unplan(sel, i) }
        // (a join's expressions were bound for the plan only)
        PPlan.Join(i, _) { unplan(sel, i) }
        PPlan.Apply(i, _) { unplan(sel, i) }
        PPlan.ProjectSet(i, _) { unplan(sel, i) }
        // (a view over the groups; a Window the pipeline runs: unplanWin's)
        PPlan.Window(i, pw) {
            if pw.isNone() {
                unplan(sel, i)
                return
            }
            match move(i) {
                PPlan.Project(j, _) { unplan(sel, j) }
                else {}
            }
        }
        PPlan.Project(i, xs) {
            if len(xs) == 0 {
                // a view: the Sel holds its outputs
                unplan(sel, i)
                return
            }
            oxBack(sel, xs)
            unplan(sel, i)
        }
        PPlan.Filter(i, cs) {
            // (a Result's: its WHERE bound for the plan only)
            match i {
                PPlan.Result(_) { return }
                else {}
            }
            var v = cs
            // (MIN/MAX by the scan's order: its IS NOT NULL, pipeAgg's)
            if sel.first >= 0 && len(sel.q.levels) > 0 && len(v) > len(sel.q.levels[0].cond) { let gone = pop(mut &v) }
            var cc: []Option[BX] = []
            for k in 0..len(v) { append(mut &cc, unbound(replace(mut &v[k], BX.Const(Val.Null)), false)) }
            // (an Apply's conjuncts, the level's last: bound by no plan)
            while len(cc) < len(sel.q.levels[0].cond) { append(mut &cc, None) }
            sel.q.cc[0] = cc
        }
        else {}
    }
}

// The outputs xs (the first len(xs)) back to sel.ox, as unbound those
// bound for the plan alone.
pub fn oxBack(sel: mut &Sel, xs: []BX) {
    var v = xs
    // (keys made after the outputs, slice P3: the plan's alone)
    for k in 0..min(len(v), len(sel.exprs)) {
        let col = match sel.exprs[k] {
            Expr.Col(name, sl) { lexdb_bind.colSlot(&sel.q.cols, &name, sl) >= 0 }
            else { false }
        }
        sel.ox[k] = unbound(replace(mut &v[k], BX.Const(Val.Null)), col)
    }
}

// b as the Sel holds it: None for a column (col) or what only a plan's
// run evaluates (a subquery's value, eval's mark: lexdb_bind.evalMark).
fn unbound(b: BX, col: bool): Option[BX] { return if col || lexdb_bind.hasSub(&b) || lexdb_bind.isEvalMark(&b) { None } else { Some(b) } }

pub fn copySets(xs: &[][]int): [][]int {
    var out: [][]int = []
    for x in xs { append(mut &out, collections.copyOf(&x)) }
    return out
}

// Whether x has no column (its value is the same for every row).
fn bConst(x: &Expr): bool {
    match x {
        Expr.Lit(_) { return true }
        Expr.Param(_) { return true }
        Expr.Col(_, _) { return false }
        Expr.Unary(_, a) { return bConst(&a) }
        Expr.Bin(_, a, b) { return bConst(&a) && bConst(&b) }
        Expr.IsNull(a, _) { return bConst(&a) }
        Expr.Cast(a, _) { return bConst(&a) }
        // a char(n) constant's padding (#bppad, the parser's for 'F' compared
        // with a char(1) column: q21's o_orderstatus = 'F'): of constants, a
        // constant
        Expr.Call(n, args, star) {
            if n != "#bppad" || star || len(args) != 2 { return false }
            return bConst(&args[0]) && bConst(&args[1])
        }
    }
}

// Whether x is the equality of level lv's one hash column with its value
// (hashVals[0]): col = x or x = col, under no collation.
fn isKeyEq(x: &Expr, q: &Query, lv: &Level): bool {
    match x {
        Expr.Bin(op, a, b) {
            if op != "=" { return false }
            let want = lv.first + lv.hashCols[0]
            match a {
                Expr.Col(n, sl) { if lexdb_bind.colSlot(&q.cols, &n, sl) == want && sameExpr(&b, &lv.hashVals[0]) { return true } }
                else {}
            }
            match b {
                Expr.Col(n, sl) { if lexdb_bind.colSlot(&q.cols, &n, sl) == want && sameExpr(&a, &lv.hashVals[0]) { return true } }
                else {}
            }
            return false
        }
        else { return false }
    }
}

// Whether a semi/anti level looked up per row (semiLook) reads a range
// the batches read (bRange): its path's leading equalities only.
fn rangePath(q: &Query, lv: &Level): bool {
    let p = &lv.path
    if lv.virt() || lv.lateral || p.desc || len(p.eqs) == 0 || len(p.ins) > 0 || p.inSub >= 0 || len(p.inArr) > 0 { return false }
    // bounds on the next column: constants only (made once: rangeBounds)
    for b in p.rng { if !bConst(&b.val) { return false } }
    if q.corr && pathCorr(p) { return false }
    return true
}

// ---- Indexes read in batches (9.107)
//
// The first table read through an index, in batches:
// - read alone (index-only), when the index's entries hold every column
//   the level uses (its own columns, then the primary key's, which every
//   entry ends with): each entry's key is decoded into the batch's
//   columns, and no row is read. Its reads are the index's range, as the
//   row path's (fetch reads such an index alone too). Entries are
//   versioned with the store, so what the index holds is what the rows
//   hold, as of the read.
// - else its entries' primary keys a batch at a time, the rows read in
//   key order (getMany: from the leaf of the key before, not from the root)
//   and each put at its entry's place, so the batch is in the index's
//   order (a bitmap heap scan's effect, the rows' order kept). In a
//   transaction whose reads are noted the rows are read in the index's
//   order, as the row path reads them, so the reads are noted the same.

// The query's columns a grouped select reads after grouping: those its
// outputs, HAVING, ORDER BY (with DISTINCT ON's keys) and window calls (their
// PARTITION BY, ORDER BY, arguments and FILTER: Q8 R7) name.
fn afterCols(sel: &Sel, q: &Query): []int {
    var names: []str = []
    for x in sel.exprs { lexdb_sql.colNames(&x, mut &names) }
    match sel.having {
        Some(h) { lexdb_sql.colNames(&h, mut &names) }
        None {}
    }
    for x in sel.order { lexdb_sql.colNames(&x, mut &names) }
    for w in sel.wins {
        for x in w.part { lexdb_sql.colNames(&x, mut &names) }
        for x in w.order { lexdb_sql.colNames(&x, mut &names) }
        for x in lexdb_window.argsOf(&w) { lexdb_sql.colNames(&x, mut &names) }
    }
    var out: []int = []
    for n in names {
        let ci = lexdb_bind.colIndex(&q.cols, &n)
        if ci >= 0 { append(mut &out, ci) }
    }
    return out
}

// ---- The row layout (design/lexdb.md 9.48, 9.50)
//
// A row: FIXED; its layout's number in its table's (Table.layouts), 2
// bytes; a NULL bitmap (bit p%8 of byte p/8); the fixed part, per place in
// order: 8, 4 or 2 bytes an integer (its column's type's width), 1 a
// boolean, 2 a variable-length value's end (from the start of the variable
// part), none a dropped place; then the variable part: texts, and numerics
// in their binary form (Decimal.toBin). Each place is at an offset its
// layout gives, so reading one is a load, not a walk over the places before
// it. A row this cannot hold is in the tagged form (encRow): one with a
// long text (LONG, lexdb_rows.encodeLong), over 255 places, a value not of its place's
// kind, or written with the test hook setFixedRows(false).
//
// Since 9.113 a date, a time, a timestamp and a timestamptz are words in
// the fixed part too (4 bytes the date's days; 8 the others' microseconds),
// as are a double's and a real's bits (8, 4); a uuid (its 16 bytes) and a
// bytea are variable-length values, as texts are. Before, their places
// were text places (PK_TEXT) and a row with such a value was in the tagged
// form; a table keeps such a layout as its current one until its catalog
// row is written again (encFixed: compatible).

// Whether a select list calls a set-returning function: only then are its
// rows looked through for marked values.
pub fn hasSrfCall(xs: &[]Expr): bool {
    for x in xs { if srfIn(&x) { return true } }
    return false
}

fn srfIn(x: &Expr): bool {
    match x {
        Expr.Call(n, args, _) {
            if n == "unnest" || n == "generate_subscripts" || n == "pg_partition_ancestors" || n == "regexp_matches" ||
               n == "regexp_split_to_table" || n == "string_to_table" { return true }
            for a in args { if srfIn(&a) { return true } }
            return false
        }
        Expr.Unary(_, a) { return srfIn(&a) }
        Expr.Bin(_, a, b) { return srfIn(&a) || srfIn(&b) }
        Expr.IsNull(a, _) { return srfIn(&a) }
        Expr.Cast(a, _) { return srfIn(&a) }
        else { return false }
    }
}

// ---- Apply (Q8 R6; design/lexdb-layers.md 6.3.Q8 R6): the correlated subqueries left per row, run per row of
// the pipeline's joins (the planner's side: the shape, the arm, the conditions left out of the joins' arms)

// planConds of a query with an Apply (Q8 R6): its conjuncts left out (the
// Apply's). (A function of its own: the test in planConds' loop cost a
// point select's planning 42 instructions.)
pub fn planCondsA(sel: mut &Sel): Option[[]BX] {
    var more: []Option[BX] = []
    for i in 0..len(sel.q.cc[0]) {
        if sel.q.cc[0][i].isSome() || applied(&sel.q, &sel.q.levels[0].cond[i]) { continue }
        let b = planX(&sel.q.levels[0].cond[i], &sel.q)
        if b.isNone() { return None }
        while len(more) < i { append(mut &more, None) }
        append(mut &more, b)
    }
    var cc = replace(mut &sel.q.cc[0], [])
    var cs: []BX = withCapacity(len(cc))
    for i in 0..len(cc) {
        if applied(&sel.q, &sel.q.levels[0].cond[i]) { continue }
        match replace(mut &cc[i], None) {
            Some(b) { append(mut &cs, b) }
            None { append(mut &cs, replace(mut &more[i], None).unwrap()) }
        }
    }
    return Some(cs)
}

// The level whose WHERE conjuncts hold every correlated subquery left per
// row in q, or -1 (applyWhy says why).
pub fn applyLevel(q: &Query): int {
    if !q.corr || len(q.levels) == 0 || len(q.top) > 0 || hashedProbe(q) { return -1 }
    var at = -1
    for k in 0..len(q.levels) {
        let lv = &q.levels[k]
        if pathCorr(&lv.path) || lv.lateral || anyCorr(&lv.local) || anyCorr(&lv.hashVals) || (lv.resNot && hasCorr(&lv.resVal)) { return -1 }
        let c = corrTail(&lv.cond)
        let p = corrTail(&lv.post)
        if c < 0 || p < 0 { return -1 }
        if c == 0 && p == 0 { continue }
        if at >= 0 || (c > 0 && p > 0) { return -1 }
        // (not a semi, anti or mark level's, nor an outer join's ON)
        if lv.semi || lv.anti || lv.mode != 0 || lv.semiSub >= 0 { return -1 }
        if c > 0 && k > 0 && lv.join != lexdb_sql.J_INNER && lv.join != lexdb_sql.J_CROSS { return -1 }
        at = k
    }
    // (not inside a build group, optimizer 49: its levels are one hash)
    for k in 0..len(q.levels) { if q.levels[k].grp > 0 && at >= k && at <= k + q.levels[k].grp { return -1 } }
    return at
}

pub fn applyWhy(q: &Query): str {
    if len(q.top) > 0 { return "conditions on no table" }
    if hashedProbe(q) { return "a hashed subquery's probe (9.9)" }
    var n = 0
    for k in 0..len(q.levels) {
        let lv = &q.levels[k]
        if pathCorr(&lv.path) { return "a path's key" }
        // (at the first level over outer values only: the pipeline's, lat0, Q8 R3)
        if lv.lateral { return if k == 0 { "LATERAL at the first level, with another subquery per row" } else { "LATERAL after the first level (a join per row)" } }
        if anyCorr(&lv.local) || anyCorr(&lv.hashVals) || (lv.resNot && hasCorr(&lv.resVal)) { return "a hash's key or build condition" }
        if corrTail(&lv.cond) < 0 || corrTail(&lv.post) < 0 { return "not a level's last conjuncts" }
        if corrTail(&lv.cond) > 0 || corrTail(&lv.post) > 0 {
            n += 1
            if lv.semi || lv.anti || lv.mode != 0 || lv.semiSub >= 0 { return "a semi, anti or mark level's" }
            if corrTail(&lv.cond) > 0 && k > 0 && lv.join != lexdb_sql.J_INNER && lv.join != lexdb_sql.J_CROSS { return "an outer join's ON" }
        }
    }
    if n > 1 { return "conjuncts of two levels" }
    if n == 0 { return "not in WHERE" }
    return "a build group's level"
}

// Whether q probes a correlated subquery run once into a hash (9.9's
// hashSub, RUN_HASHED as subsOf says: not a semi, anti or mark level's
// rows, not in FROM): the row engine's (its probe reads the hash).
fn hashedProbe(q: &Query): bool {
    for i in 0..len(q.subs) {
        let sp = &q.subs[i]
        if sp.hashed && !sp.semi && sp.use != lexdb_sql.SUB_FROM && len(sp.sel.q.refs) > 0 && subRuns(q, i) { return true }
    }
    return false
}

fn anyCorr(xs: &[]Expr): bool {
    for x in xs { if hasCorr(&x) { return true } }
    return false
}

// 0: no conjunct of xs calls a correlated subquery; 1: some do, and every
// one after the first that does; -1 else.
fn corrTail(xs: &[]Expr): int {
    var seen = false
    for x in xs {
        if hasCorr(&x) { seen = true } else if seen { return -1 }
    }
    return if seen { 1 } else { 0 }
}

// Whether x is an Apply's conjunct, the plan's arms leave it out (q's
// shape is an Apply's: pipeShape, aggShape).
fn applied(q: &Query, x: &Expr): bool { return q.corr && hasCorr(x) }

// Whether an aggregate's keys or calls read a correlated subquery (run
// per row: the row engine keeps the rows, then groups them).
fn aggCorr(sel: &Sel): bool {
    if anyCorr(&sel.groupBy) { return true }
    for sp in sel.specs {
        if anyCorr(&sp.args) || anyCorr(&sp.order) { return true }
        match sp.filter {
            Some(f) { if hasCorr(&f) { return true } }
            None {}
        }
    }
    return false
}

// The Apply of q's correlated conjuncts at level k: the query's columns
// they read.
pub fn applyOf(q: &Query, k: int): PApply {
    var reads: []int = []
    for x in q.levels[k].cond { if hasCorr(&x) { colsRead(&x, &q.cols, mut &reads) } }
    for x in q.levels[k].post { if hasCorr(&x) { colsRead(&x, &q.cols, mut &reads) } }
    return PApply{level: k, reads: reads}
}

// The columns of cols x reads, as eval finds them (its slot, else by
// name), added to out once each.
fn colsRead(x: &Expr, cols: &[]lexdb_sql.ColDef, out: mut &[]int) {
    match x {
        Expr.Col(n, sl) {
            let i = if sl >= 0 && sl < len(cols) && cols[sl].name == n { sl } else { lexdb_bind.colIndex(cols, &n) }
            if i < 0 { return }
            for r in out { if r == i { return } }
            append(out, i)
        }
        Expr.Unary(_, a) { colsRead(&a, cols, out) }
        Expr.Bin(_, a, b) {
            colsRead(&a, cols, out)
            colsRead(&b, cols, out)
        }
        Expr.IsNull(a, _) { colsRead(&a, cols, out) }
        Expr.Cast(a, _) { colsRead(&a, cols, out) }
        Expr.Call(_, args, _) { for c in args { colsRead(&c, cols, out) } }
        else {}
    }
}

// The level of p's Apply (under the views, the Project or the Agg), -1 none.
pub fn applyAt(p: &PPlan): int {
    match p {
        PPlan.Apply(_, pa) { return pa.level }
        PPlan.Limit(i, _, _, _) { return applyAt(&i) }
        PPlan.Sort(i, _, _) { return applyAt(&i) }
        PPlan.Distinct(i, _, _) { return applyAt(&i) }
        PPlan.Project(i, _) { return applyAt(&i) }
        PPlan.Having(i) { return applyAt(&i) }
        PPlan.Match(i) { return applyAt(&i) }
        PPlan.Window(i, _) { return applyAt(&i) }
        PPlan.Agg(i, _, _) { return applyAt(&i) }
        else { return -1 }
    }
}

// input (the joins over Filter? (Scan)) under an Apply of q's correlated
// conjuncts, if q has them, its scan's subqueries run per row the Apply's
// (RUN_APPLY).
pub fn applyOver(q: &Query, input: PPlan): PPlan {
    let k = applyLevel(q)
    // (no Apply: a LATERAL first level over outer values, run once a run, Q8 R3)
    return if k >= 0 { PPlan.Apply(applySubs(input), applyOf(q, k)) } else if lat0(q) { lat0Once(input, q.levels[0].src) } else { input }
}

// sel's joins jp under an Apply if its query has one (applyOver).
pub fn applyJoins(sel: &Sel, jp: mut &PPlan) { jp = applyOver(&sel.q, replace(jp, PPlan.Result([]))) }

fn applySubs(p: PPlan): PPlan {
    var arm = false
    match p {
        PPlan.Join(_, _) { arm = true }
        PPlan.Filter(_, _) { arm = true }
        PPlan.Scan(_, _) { arm = true }
        else {}
    }
    if !arm { return p }
    match move(p) {
        PPlan.Join(i, j) { return PPlan.Join(applySubs(i), j) }
        PPlan.Filter(i, cs) { return PPlan.Filter(applySubs(i), cs) }
        PPlan.Scan(sc, subs) {
            var out = subs
            for i in 0..len(out) { if out[i].run == RUN_PER_ROW { out[i].run = RUN_APPLY } }
            return PPlan.Scan(sc, out)
        }
        else { return PPlan.Result([]) }        // (not reached: the arms above)
    }
}

// q's conditions bound for the plan with their constant operators made
// constants (lexdb_bind.bxFold).
pub fn foldConds(q: mut &Query) {
    for k in 0..len(q.cc) {
        for i in 0..len(q.cc[k]) {
            match replace(mut &q.cc[k][i], None) {
                Some(b) { q.cc[k][i] = Some(lexdb_bind.bxFold(b)) }
                None {}
            }
        }
    }
    for k in 0..len(q.cp) {
        for i in 0..len(q.cp[k]) {
            match replace(mut &q.cp[k][i], None) {
                Some(b) { q.cp[k][i] = Some(lexdb_bind.bxFold(b)) }
                None {}
            }
        }
    }
}

// ---- a function in FROM as the pipeline's source (Q8 R3; design/lexdb-layers.md 6.3.Q8 R3)

// A function's program (lexdb_exec.pipeFunc): its arguments evaluated by
// the bound expressions, its rows made from their values (lexdb_srf, or
// the catalog's relation read).
pub const PR_FUNC: int = 3

// sel's program when sel is a function in FROM (Sel.srf) whose arguments
// all bind for the plan: Project (Func), the Project's expressions its
// arguments (moved from Sel.ox, else bound with their subqueries' values),
// so a run evaluates them by lexdb_pipe.bxEval; None, those moved given
// back, when one does not bind (a sequence's or a session's call: the row
// engine's eval). (Not a field of Func: one more cost every view's Func,
// physOf's, an empty array made and dropped.)
pub fn funcProg(sel: mut &Sel): Option[Prog] {
    var xs: []BX = withCapacity(len(sel.exprs))
    for i in 0..len(sel.exprs) {
        let got = if i < len(sel.ox) { replace(mut &sel.ox[i], None) } else { None }
        match got {
            Some(b) {
                append(mut &xs, b)
                continue
            }
            None {}
        }
        match planX(&sel.exprs[i], &sel.q) {
            Some(b) { append(mut &xs, b) }
            None {
                // census: lexdb_census.no("a function in FROM: an argument does not bind (planX)")
                oxBack(sel, xs)
                return None
            }
        }
    }
    return Some(Prog{plan: PPlan.Project(PPlan.Func(sel.srf.toStr(), sel.ordin, subsOf(&sel.q)), xs), ops: 1, groups: false, joins: false, sorts: false, run: PR_FUNC})
}

// ---- LATERAL at the first level, over outer values only (Q8 R3)

// Whether q's first level is a LATERAL subquery or function in FROM and
// nothing else of q is run per row: with no level before it, its outer
// values are the run's (its parameters), so the pipeline runs it once a
// run, before the query (lexdb_exec.lat0Rows), its rows held as a FROM
// subquery's are, where the row engine runs it once for its first row
// (runLevel's LATERAL arm).
pub fn lat0(q: &Query): bool {
    if len(q.levels) == 0 || !q.levels[0].lateral { return false }
    let src = q.levels[0].src
    if src < 0 || src >= len(q.subs) || q.subs[src].hashed || q.subs[src].use != lexdb_sql.SUB_FROM { return false }
    for i in 0..len(q.subs) {
        if i == src { continue }
        let sp = &q.subs[i]
        if len(sp.sel.q.refs) > 0 && !(sp.use == lexdb_sql.SUB_FROM && sp.hashed) { return false }
    }
    return true
}

// heldRead for a first level that is LATERAL (lat0).
fn lat0Read(q: &Query, lv: &Level): bool {
    return lv.lateral && lv.src >= 0 && lv.perRow && lv.lock == 0 && len(lv.post) == 0 && !lv.semi && !lv.anti && lv.semiSub < 0 &&
           len(q.levels) > 0 && lv.src == q.levels[0].src && lat0(q)
}

// p (joins over a scan, or a scan) with its first table's subquery src,
// a LATERAL first level's (lat0), run once (RUN_ONCE): the pipeline's run
// makes its rows before the query, for the run's outer values
// (lexdb_exec.lat0Rows). EXPLAIN of the pipeline's plan says so.
fn lat0Once(p: PPlan, src: int): PPlan {
    var arm = false
    match p {
        PPlan.Join(_, _) { arm = true }
        PPlan.Filter(_, _) { arm = true }
        PPlan.Scan(_, _) { arm = true }
        else {}
    }
    if !arm { return p }
    match move(p) {
        PPlan.Join(i, j) { return PPlan.Join(lat0Once(i, src), j) }
        PPlan.Filter(i, cs) { return PPlan.Filter(lat0Once(i, src), cs) }
        PPlan.Scan(sc, subs) {
            var out = subs
            if src >= 0 && src < len(out) && out[src].run == RUN_PER_ROW { out[src].run = RUN_ONCE }
            return PPlan.Scan(sc, out)
        }
        else { return PPlan.Result([]) }        // (not reached: the arms above)
    }
}

// ---- a set operation's rows held (Q8 R3)

// Whether a held set operation's ORDER BY, OFFSET and LIMIT are
// lexdb_setop's (its parts run by the caller, each the pipeline's or not
// as its own plan says): not with TOP or WITH TIES (the row path cuts
// those).
pub fn setHeld(sel: &Sel): bool { return sel.topMode == 0 && !sel.withTies }

// ---- a set-returning function in the select list, with no FROM (Q8 R3)

// Whether sel is a SELECT with no FROM whose select list calls a
// set-returning function (unnest, regexp_matches, ...), the pipeline's as a
// Result under a ProjectSet: its one row's sets made rows in lockstep (the
// shorter padded with NULL, none if every one is empty), as the row
// engine's expandSrfs makes them. Not under a LIMIT, OFFSET or DISTINCT
// (they apply to the rows made), nor where resultShape declines for
// anything else. (Apart from resultShape: a test there cost every SELECT
// with no FROM.)
pub fn srfShape(sel: &Sel): bool {
    let q = &sel.q
    if sel.setop != 0 || len(sel.srf) > 0 || sel.aggQ || len(sel.wins) > 0 || len(sel.locks) > 0 || len(sel.mr) > 0 { return false }
    if sel.sort || len(sel.feedback) > 0 || sel.topMode != 0 || sel.withTies || sel.first >= 0 { return false }
    if q.corr || len(q.levels) != 0 || sel.limit >= 0 || sel.offset > 0 || sel.distinct || !hasSrfCall(&sel.exprs) { return false }
    return len(sel.exprs) > 0 && len(sel.exprs) == len(sel.outs) && len(sel.ox) == len(sel.exprs)
}

// srfShape's plan: ProjectSet (Project (Filter? (Result))), the Result's
// as resultPlan makes it.
pub fn srfPlan(sel: mut &Sel): Option[PPlan] {
    var oids: []int = withCapacity(len(sel.outs))
    for o in sel.outs { append(mut &oids, o.oid) }
    match resultPlan(sel) {
        Some(p) { return Some(PPlan.ProjectSet(p, oids)) }
        None { return None }
    }
}
