// lexdb_agg: the aggregate functions' accumulators, shared by the row
// engine (lexdb_exec: accumulate, over an Env) and the pipeline
// (lexdb_pipe: a call's value from a batch's column), design/lexdb-batch-gaps.md
// item 3. An aggregate call is an AggSpec; per group and call an Acc holds
// what it has counted. A value, however its engine made it, is given by
// admit (a NULL, or a DISTINCT value seen, is not accumulated) and add;
// finish gives the call's result. The engine evaluates the call's
// argument, separator and ORDER BY keys (it holds the expressions' scope);
// nothing here evaluates an expression.
import "strings"
import "collections"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_ops"
import "./lexdb_access"
import "./lexdb_sort"
import "./lexdb_pct"

type Val = lexdb_sql.Val
type Expr = lexdb_sql.Expr
type DbErr = lexdb_base.DbErr

fn e(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

// An aggregate call of the query: its function, arguments, modifiers.
pub type AggSpec = record {
    pub fname: str
    pub args: []Expr
    pub star: bool
    pub distinct: bool
    pub filter: Option[Expr]
    pub order: []Expr           // ORDER BY in the call (string_agg's result depends on it; the others' not)
    pub dirs: str               // per key: a, A (NULLs first), d, D (NULLs last), as the parser gives them
    pub text: str               // to share one accumulator between equal calls
    pub kind: int               // its argument's collation kind (L2): min, max and DISTINCT compare its keys
    pub op: int                 // fname as an OP_* (set by spec: what add dispatches on)
    pub dia: int                // lexdb_pct.DIA_*: the dialect whose types and errors percentile_cont and percentile_disc give
}

pub const OP_COUNT = 0
pub const OP_SUM = 1
pub const OP_AVG = 2
pub const OP_MIN = 3
pub const OP_MAX = 4
pub const OP_BOOL = 5               // bool_and, every, bool_or
pub const OP_ARRAY = 6
pub const OP_STRING = 7
pub const OP_VAR = 8                // the variances and standard deviations
pub const OP_PCT = 9                // percentile_cont, percentile_disc
pub const OP_PRODUCT = 10           // T-SQL's PRODUCT
pub const OP_BITS = 11              // bit_and, bit_or, bit_xor (Oracle's BIT_AND_AGG, ...)
pub const OP_ANY = 12               // any_value
pub const OP_MOMENT = 13            // Oracle's KURTOSIS_POP / _SAMP, SKEWNESS_POP / _SAMP

fn opOf(f: &str): int {
    if f == "count" { return OP_COUNT }
    if f == "sum" { return OP_SUM }
    if f == "avg" { return OP_AVG }
    if f == "min" { return OP_MIN }
    if f == "max" { return OP_MAX }
    if f == "bool_and" || f == "every" || f == "bool_or" { return OP_BOOL }
    if f == "array_agg" { return OP_ARRAY }
    if f == "string_agg" { return OP_STRING }
    if lexdb_pct.isPct(f) { return OP_PCT }
    if strings.startsWith(f, "#product") { return OP_PRODUCT }
    if f == "bit_and" || f == "bit_or" || f == "bit_xor" { return OP_BITS }
    if f == "any_value" { return OP_ANY }
    if strings.startsWith(f, "#kurtosis") || strings.startsWith(f, "#skewness") { return OP_MOMENT }
    return OP_VAR
}

// A call's spec.
pub fn spec(fname: str, args: []Expr, star: bool, distinct: bool, filter: Option[Expr], order: []Expr, dirs: str, text: str, kind: int): AggSpec {
    let op = opOf(&fname)
    return AggSpec{fname: fname, args: args, star: star, distinct: distinct, filter: filter, order: order, dirs: dirs, text: text, kind: kind, op: op, dia: lexdb_pct.DIA_PG}
}

pub type Acc = record {
    pub n: int
    pub val: Val                // min, max, bool_and, bool_or
    pub sum: Val                // sum, avg; the variances: the sum ...
    pub sumsq: Val              // ... and the sum of squares
    pub parts: []str            // string_agg
    pub seps: []Val             // ... with ORDER BY: each value's separator
    pub ords: [][]Val           // ... and its keys (sorted when it finishes)
    pub seen: Map[str, int]     // DISTINCT
}

pub fn newAcc(): Acc {
    return Acc{n: 0, val: Val.Null, sum: Val.Null, sumsq: Val.Null, parts: [], seps: [], ords: [], seen: newMap()}
}

pub fn newAccs(n: int): []Acc {
    var out: []Acc = []
    for i in 0..n { append(mut &out, newAcc()) }
    return out
}

// Whether the call has an ORDER BY.
pub fn ordered(sp: &AggSpec): bool { return len(sp.dirs) > 0 }

// How many values besides its argument a call is given with each row: its
// separator (string_agg), then its ORDER BY keys.
pub fn extras(sp: &AggSpec): int {
    return (if hasSep(sp) { 1 } else { 0 }) + (if sp.op == OP_PCT { 0 } else { len(sp.dirs) })
}

// Whether a call reads its second argument with each row (as a value besides
// its first): string_agg's separator, a percentile's fraction. The engines
// give it to add as more[0].
pub fn hasSep(sp: &AggSpec): bool { return sp.op == OP_STRING || sp.op == OP_PCT }

// Whether a percentile call's ORDER BY is descending (its dirs: a, A, d, D).
fn pctDesc(sp: &AggSpec): bool { return len(sp.dirs) > 0 && (sp.dirs[0] == 'd' || sp.dirs[0] == 'D') }

// Whether the value v of a row is accumulated: not a NULL (array_agg keeps
// them, as elements), and for DISTINCT not one seen in this accumulator
// (it is now).
pub fn admit(sp: &AggSpec, acc: mut &Acc, v: &Val): bool {
    match v {
        Val.Null { if sp.op != OP_ARRAY { return false } }
        else {}
    }
    if sp.distinct {
        var kb = ""
        if sp.kind == lexdb_sql.COLL_EXACT { lexdb_access.encIdxPart(mut &kb, v) } else { lexdb_access.encIdxPart(mut &kb, &lexdb_sort.collVal(sp.kind, v)) }
        let k = kb
        if acc.seen.get(&k).isSome() { return false }
        acc.seen.put(k, 1)
    }
    return true
}

// Whether MIN (side -1) or MAX (1) takes v, compared c with the value it holds: a value past it, or an equal one (the
// last of equal values, as PostgreSQL's numeric_smaller) but for a timestamp that keeps its offset, where equal
// instants keep the first one read (Oracle's TIMESTAMP WITH TIME ZONE, SQL Server's datetimeoffset).
pub fn takes(c: int, side: int, v: &Val): bool {
    if c != 0 { return (c < 0) == (side < 0) }
    match v {
        Val.Tsz(_, _) { return false }
        else { return true }
    }
}

// Adds an admitted value v of a row to an accumulator. more: the row's
// other values the call reads (extras): string_agg's separator, then the
// ORDER BY keys.
pub fn add(sp: &AggSpec, acc: mut &Acc, v: Val, more: []Val): Result[Unit, DbErr] {
    let op = sp.op
    let f = &sp.fname
    if op == OP_SUM || op == OP_AVG {
        // avg of reals adds in double precision, as PostgreSQL's float4_accum
        let w = if op == OP_AVG && lexdb_ops.isReal(&v) { Val.Float(lexdb_ops.asFloat(&v).unwrap()) } else { v }
        // and squares them, so overflows where PostgreSQL's float8_accum does
        if op == OP_AVG && lexdb_ops.isFloat(&w) { let sq = try lexdb_ops.arith(lexdb_ops.OP_MUL, &w, &w) }
        acc.sum = if lexdb_ops.isNull(&acc.sum) { w } else { try sumAdd(&acc.sum, &w) }
    } else if op == OP_MIN {
        // of equal values the last, as PostgreSQL's numeric_smaller gives
        // (0.5 and 0.500: 0.500 if it comes after)
        if sp.kind != lexdb_sql.COLL_EXACT {
            // under a collation's keys: of equal ones the first (L2, as SQL Server)
            if lexdb_ops.isNull(&acc.val) || (try lexdb_ops.compare(&lexdb_sort.collVal(sp.kind, &v), &lexdb_sort.collVal(sp.kind, &acc.val))) < 0 { acc.val = v }
        } else if lexdb_ops.isNull(&acc.val) || takes(try lexdb_ops.compare(&v, &acc.val), -1, &v) { acc.val = v }
    } else if op == OP_MAX {
        if sp.kind != lexdb_sql.COLL_EXACT {
            if lexdb_ops.isNull(&acc.val) || (try lexdb_ops.compare(&lexdb_sort.collVal(sp.kind, &v), &lexdb_sort.collVal(sp.kind, &acc.val))) > 0 { acc.val = v }
        } else if lexdb_ops.isNull(&acc.val) || takes(try lexdb_ops.compare(&v, &acc.val), 1, &v) { acc.val = v }
    } else if op == OP_BOOL {
        let b = match lexdb_ops.truth(&v) {
            Some(x) { x }
            None { return Err(e("42883", &("function " + f + " needs a boolean"))) }
        }
        let prev = match acc.val { Val.Bool(x) { x } else { f != "bool_or" } }
        acc.val = Val.Bool(if f == "bool_or" { prev || b } else { prev && b })
    } else if op == OP_ARRAY {
        // the values, and their ORDER BY keys (parts keeps orderIdx's count)
        append(mut &acc.seps, v)
        append(mut &acc.parts, "")
        if len(sp.dirs) > 0 { append(mut &acc.ords, more) }
    } else if op == OP_STRING {
        let sep = &more[0]
        if len(sp.dirs) > 0 {
            var ks: []Val = []
            for i in 1..len(more) { append(mut &ks, more[i].clone()) }
            append(mut &acc.parts, lexdb_sql.text(&v))
            append(mut &acc.seps, sep.clone())
            append(mut &acc.ords, ks)
        } else {
            if acc.n > 0 && !lexdb_ops.isNull(sep) { append(mut &acc.parts, lexdb_sql.text(sep)) }
            append(mut &acc.parts, lexdb_sql.text(&v))
        }
    } else if op == OP_PCT {
        // the values; the fraction of the first row (the same for all in a group)
        try lexdb_pct.checkValue(sp.dia, f, &v)
        if acc.n == 0 { acc.sum = more[0].clone() }
        append(mut &acc.seps, v)
    } else if op >= OP_PRODUCT {
        try addNew(sp, acc, v)
        return Ok(Unit{})
    } else if op == OP_VAR {
        // the variances and standard deviations
        let x = try numOf(&v, &f)
        let sq = try lexdb_ops.arith(lexdb_ops.OP_MUL, &x, &x)
        acc.sum = if lexdb_ops.isNull(&acc.sum) { x } else { try lexdb_ops.arith(lexdb_ops.OP_ADD, &acc.sum, &x) }
        acc.sumsq = if lexdb_ops.isNull(&acc.sumsq) { sq } else { try lexdb_ops.arith(lexdb_ops.OP_ADD, &acc.sumsq, &sq) }
    }
    acc.n += 1
    return Ok(Unit{})
}

// A sum's or an average's total plus a value: integers as integers while
// they fit, past 2^63 a numeric's (exact, as PostgreSQL sums a bigint in
// numeric); any other as arith adds them.
pub fn sumAdd(a: &Val, b: &Val): Result[Val, DbErr] {
    match a {
        Val.Int(x) {
            match b {
                Val.Int(y) {
                    match x.checkedAdd(y) {
                        Some(s) { return Ok(Val.Int(s)) }
                        None {
                            match Decimal.fromInt(x).addExact(Decimal.fromInt(y)) {
                                Ok(d) { return Ok(Val.Num(d)) }
                                Err(_) { return Err(lexdb_ops.decErr()) }
                            }
                        }
                    }
                }
                else {}
            }
        }
        else {}
    }
    return lexdb_ops.arith(lexdb_ops.OP_ADD, a, b)
}

fn numOf(v: &Val, fname: &str): Result[Val, DbErr] {
    if lexdb_ops.isFloat(v) { return Ok(Val.Float(lexdb_ops.asFloat(v).unwrap())) }      // a float's variance is a double precision
    match lexdb_ops.asNum(v) {
        Some(d) { return Ok(Val.Num(d)) }
        None { return Err(e("42883", &("function " + fname + " needs a number"))) }
    }
}

// The square root at the variance's scale, as PostgreSQL's stddev takes it
// (numeric_stddev_internal: sqrt_var at the division's scale), rounded half
// away: Newton's method 8 places further (fewer where those overflow).
fn sqrtNum(v: &Val): Result[Val, DbErr] {
    if lexdb_ops.isFloat(v) { return Ok(Val.Float(lexdb_ops.asFloat(v).unwrap().sqrt())) }
    let a = lexdb_ops.asNum(v).unwrap()
    if a.isNeg() { return Err(e("2201F", "cannot take square root of a negative number")) }
    if a.isZero() { return Ok(Val.Num(a)) }
    let sc = a.scale()
    for extra in [8, 2, 0] {
        match newtonSqrt(a, sc + extra, (try lexdb_ops.compare(v, &Val.Int(1))) > 0) {
            Some(x) {
                match x.quantize(sc, Rounding.HALF_AWAY) {
                    Ok(d) { return Ok(Val.Num(d)) }
                    Err(_) {}
                }
            }
            None {}
        }
    }
    return Err(lexdb_ops.decErr())
}

// a's square root by Newton's method at scale ws; None: a step overflows.
fn newtonSqrt(a: Decimal, ws: int, big: bool): Option[Decimal] {
    var x = if big { a } else { Decimal.fromInt(1) }
    let two = Decimal.fromInt(2)
    for i in 0..400 {
        let q = match a.div(x, ws, Rounding.HALF_EVEN) { Ok(d) { d } Err(_) { return None } }
        let next = match q.addExact(x) { Ok(d) { d } Err(_) { return None } }
        let half = match next.div(two, ws, Rounding.HALF_EVEN) { Ok(d) { d } Err(_) { return None } }
        if half.canonical() == x.canonical() { break }
        x = half
    }
    return Some(x)
}

// string_agg with ORDER BY: its values sorted by their keys (stable: equal
// keys keep their order), each after its own separator but the first.
fn orderedParts(sp: &AggSpec, acc: &Acc): Result[str, DbErr] {
    let idx = try orderIdx(sp, acc)
    var b = ""
    for j in 0..len(idx) {
        let i = idx[j]
        if j > 0 && !lexdb_ops.isNull(&acc.seps[i]) { b += &(lexdb_sql.text(&acc.seps[i])) }
        b += &(acc.parts[i])
    }
    return Ok(b)
}

// The order of an ordered aggregate's values (string_agg's, array_agg's):
// by its ORDER BY keys, ties as they came.
fn orderIdx(sp: &AggSpec, acc: &Acc): Result[[]int, DbErr] {
    var idx: []int = []
    for i in 0..len(acc.parts) { append(mut &idx, i) }
    var bad = false
    collections.sortBy(mut &idx, fn(a: &int, b: &int): int {
        for k in 0..len(sp.dirs) {
            let d = sp.dirs[k]
            let desc = d == 'd' || d == 'D'
            let nullsFirst = d == 'A' || d == 'd'
            let x = &acc.ords[a][k]
            let y = &acc.ords[b][k]
            let xn = lexdb_ops.isNull(x)
            let yn = lexdb_ops.isNull(y)
            if xn || yn {
                if xn && yn { continue }
                return if xn == nullsFirst { -1 } else { 1 }
            }
            let r = lexdb_ops.compare(x, y)
            if r.isErr() { bad = true }
            let c = r.unwrapOr(0)
            if c != 0 { return if desc { -c } else { c } }
        }
        return a - b
    })
    if bad { return Err(e("42804", &(sp.fname + ": its ORDER BY keys cannot be compared"))) }
    return Ok(idx)
}

// An accumulator's result.
pub fn finish(sp: &AggSpec, acc: &Acc): Result[Val, DbErr] {
    let f = &sp.fname
    if f == "count" { return Ok(Val.Int(acc.n)) }
    if sp.op >= OP_PRODUCT { return finishNew(sp, acc) }
    if acc.n == 0 { return Ok(Val.Null) }
    if sp.op == OP_PCT {
        if lexdb_ops.isNull(&acc.sum) {
            match lexdb_pct.nullFrac(sp.dia) {
                Some(x) { return Err(x) }
                None { return Ok(Val.Null) }
            }
        }
        return lexdb_pct.finish(f, sp.dia, pctDesc(sp), sp.kind, &acc.seps, &acc.sum)
    }
    if f == "sum" { return Ok(acc.sum.clone()) }
    if f == "avg" {
        // of intervals: their sum over the count, as PostgreSQL's interval_avg (and Oracle 23ai's AVG of an INTERVAL; of a
        // YEAR TO MONTH Oracle's whole months, cut toward zero)
        match acc.sum {
            Val.Ival(iv) {
                if sp.dia == lexdb_pct.DIA_ORA && iv.days == 0 && iv.us == 0 {
                    var m = iv
                    m.months = iv.months / acc.n
                    return Ok(Val.Ival(m))
                }
                return lexdb_ops.arith(lexdb_ops.OP_DIV, &acc.sum, &Val.Num(Decimal.fromInt(acc.n)))
            }
            else {}
        }
    }
    if f == "avg" { return lexdb_ops.arith(lexdb_ops.OP_DIV, &(try numOf(&acc.sum, &f)), &Val.Num(Decimal.fromInt(acc.n))) }
    if f == "string_agg" && len(sp.dirs) > 0 { return Ok(Val.Text(try orderedParts(sp, acc))) }
    if f == "string_agg" { return Ok(Val.Text(strings.join(&acc.parts, ""))) }
    if f == "array_agg" {
        // its values in order, as an array's text (9.27)
        let idx = if len(sp.dirs) > 0 { try orderIdx(sp, acc) } else { [] }
        var vals: []Val = []
        if len(sp.dirs) > 0 { for i in idx { append(mut &vals, acc.seps[i].clone()) } } else { for v in acc.seps { append(mut &vals, v.clone()) } }
        return Ok(Val.Text(lexdb_ops.arrayText(&vals)))
    }
    if f == "min" || f == "max" || f == "bool_and" || f == "bool_or" || f == "every" { return Ok(acc.val.clone()) }
    // variance: (n * sum of squares - sum * sum) / (n * (n - 1)), or n * n for the population's
    let pop = f == "var_pop" || f == "stddev_pop"
    if !pop && acc.n < 2 { return Ok(Val.Null) }
    let n = Val.Int(acc.n)
    let num = try lexdb_ops.arith(lexdb_ops.OP_SUB, &(try lexdb_ops.arith(lexdb_ops.OP_MUL, &n, &acc.sumsq)), &(try lexdb_ops.arith(lexdb_ops.OP_MUL, &acc.sum, &acc.sum)))
    let den = Val.Int(if pop { acc.n * acc.n } else { acc.n * (acc.n - 1) })
    let nv = try numOf(&num, &f)
    match nv {
        // a numeric numerator at or below zero is 0, as PostgreSQL's (no division, no scale)
        Val.Num(d) { if d.isZero() || d.isNeg() { return Ok(Val.Num(Decimal.zero())) } }
        else {}
    }
    let vr = try lexdb_ops.arith(lexdb_ops.OP_DIV, &nv, &(try numOf(&den, &f)))
    if f == "variance" || f == "var_samp" || f == "var_pop" { return Ok(vr) }
    return sqrtNum(&vr)
}

// ---- the newest releases' aggregates (design/lexdb-new-features.md 6.1 item 7)

// Adds an admitted value of the newer aggregates (op OP_PRODUCT and after).
fn addNew(sp: &AggSpec, acc: mut &Acc, v: Val): Result[Unit, DbErr] {
    let op = sp.op
    if op == OP_PRODUCT {
        // SQL Server's PRODUCT: integers multiplied as integers (past 2^63 an error, 8115 in the door), decimals exactly,
        // floats as floats; a bit as its 0 or 1; a string 8117
        let w = match v {
            Val.Bool(b) { Val.Int(if b { 1 } else { 0 }) }
            Val.Text(_) { return Err(e("TS8117", "Operand data type varchar is invalid for product operator.")) }
            else { v }
        }
        if acc.n == 0 { acc.sum = w } else {
            match acc.sum {
                Val.Int(x) {
                    match w {
                        Val.Int(y) {
                            match x.checkedMul(y) {
                                Some(p) { acc.sum = Val.Int(p) }
                                None { return Err(e("22003", "Arithmetic overflow error converting expression to data type bigint.")) }
                            }
                        }
                        else { acc.sum = try lexdb_ops.arith(lexdb_ops.OP_MUL, &acc.sum, &w) }
                    }
                }
                else { acc.sum = try lexdb_ops.arith(lexdb_ops.OP_MUL, &acc.sum, &w) }
            }
        }
        // an int's within 2^31; a decimal's at six places (SQL Server's decimal(38, 6), each product rounded)
        if sp.fname == "#product4" {
            match acc.sum {
                Val.Int(x) { if x > 2147483647 || x < -2147483648 { return Err(e("22003", "Arithmetic overflow error converting expression to data type int.")) } }
                else {}
            }
        } else if sp.fname == "#product6" {
            match acc.sum {
                Val.Num(d) {
                    match d.quantize(6, Rounding.HALF_AWAY) {
                        Ok(q) { acc.sum = Val.Num(q) }
                        Err(_) { return Err(e("22003", "Arithmetic overflow error converting expression to data type numeric.")) }
                    }
                }
                Val.Int(x) { acc.sum = Val.Num(Decimal.fromInt(x).quantize(6, Rounding.HALF_AWAY).unwrapOr(Decimal.fromInt(x))) }
                else {}
            }
        }
    } else if op == OP_BITS {
        // integers; Oracle's NUMBER cut toward zero
        let x = match v {
            Val.Int(i) { i }
            Val.Bool(b) { if b { 1 } else { 0 } }
            else {
                match lexdb_ops.asNum(&v) {
                    Some(d) {
                        match d.toInt(Rounding.TOWARD_ZERO) {
                            Ok(i) { i }
                            Err(_) { return Err(e("22003", "bigint out of range")) }
                        }
                    }
                    None { return Err(e("42883", &("function " + sp.fname + " needs an integer"))) }
                }
            }
        }
        if acc.n == 0 { acc.val = Val.Int(x) } else {
            let y = match acc.val { Val.Int(i) { i } else { 0 } }
            acc.val = Val.Int(if sp.fname == "bit_and" { x & y } else if sp.fname == "bit_or" { x | y } else { x ^ y })
        }
    } else if op == OP_ANY {
        if acc.n == 0 { acc.val = v }
    } else if op == OP_MOMENT {
        match lexdb_ops.asFloat(&v) {
            Some(x) { append(mut &acc.seps, Val.Float(x)) }
            None { return Err(e("ORA00932", "inconsistent datatypes: expected NUMBER")) }
        }
    }
    acc.n += 1
    return Ok(Unit{})
}

// The newer aggregates' results: NULL over no rows (Oracle's bit aggregates 0).
fn finishNew(sp: &AggSpec, acc: &Acc): Result[Val, DbErr] {
    let op = sp.op
    if acc.n == 0 { return Ok(if op == OP_BITS && sp.dia == lexdb_pct.DIA_ORA { Val.Num(Decimal.zero()) } else { Val.Null }) }
    if op == OP_PRODUCT { return Ok(acc.sum.clone()) }
    if op == OP_BITS {
        if sp.dia == lexdb_pct.DIA_ORA {
            match acc.val { Val.Int(i) { return Ok(Val.Num(Decimal.fromInt(i))) } else {} }
        }
        return Ok(acc.val.clone())
    }
    if op == OP_ANY { return Ok(acc.val.clone()) }
    // the moments of the values about their mean: the skewness m3 / m2^1.5, the kurtosis m4 / m2^2 - 3 (Oracle's: 0 below
    // 3 values for the skewness, 4 for the kurtosis, and for values all equal); _SAMP the sample's adjustments
    let n = len(acc.seps)
    var mean = 0.0f
    for v in acc.seps { mean += lexdb_ops.asFloat(&v).unwrapOr(0.0f) }
    mean = mean / float(n)
    var m2 = 0.0f
    var m3 = 0.0f
    var m4 = 0.0f
    for v in acc.seps {
        let d = lexdb_ops.asFloat(&v).unwrapOr(0.0f) - mean
        m2 += d * d
        m3 += d * d * d
        m4 += d * d * d * d
    }
    let fn0 = float(n)
    m2 = m2 / fn0
    m3 = m3 / fn0
    m4 = m4 / fn0
    let kurt = strings.startsWith(&sp.fname, "#kurtosis")
    let samp = strings.endsWith(&sp.fname, "_samp")
    if m2 == 0.0f || (kurt && n < 4) || (!kurt && n < 3) { return Ok(Val.Num(Decimal.zero())) }
    var r = 0.0f
    if kurt {
        let g2 = m4 / (m2 * m2) - 3.0f
        r = if samp { ((fn0 + 1.0f) * g2 + 6.0f) * (fn0 - 1.0f) / ((fn0 - 2.0f) * (fn0 - 3.0f)) } else { g2 }
    } else {
        let g1 = m3 / (m2 * m2.sqrt())
        r = if samp { g1 * (fn0 * (fn0 - 1.0f)).sqrt() / (fn0 - 2.0f) } else { g1 }
    }
    match Decimal.parse(&(r.toStr())) {
        Ok(d) { return Ok(Val.Num(d)) }
        Err(_) { return Ok(Val.Float(r)) }
    }
}
