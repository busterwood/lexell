// lexdb: what every layer shares: the error type, CRC32C and a small
// deterministic random generator for the simulated disk and the tests.
// Design: design/lexdb.md.
import "hash"

// An error, with the SQLSTATE a Postgres client sees (design/lexdb.md 4.4:
// 40001 is a serialization failure the client retries).
pub type DbErr = value record {
    pub state: str
    pub msg: str
    pub context: str        // where it happened (PostgreSQL's CONTEXT), "" none: COPY's line (9.45)
}

pub fn err(state: str, msg: str): DbErr { return DbErr{state: state, msg: msg, context: ""} }

pub fn (e: &DbErr) toStr(): str { return e.state + ": " + e.msg }

pub const S_IO = "58030"            // io_error
pub const S_CORRUPT = "XX001"       // data_corrupted
pub const S_INTERNAL = "XX000"      // internal_error
pub const S_CONFLICT = "40001"      // serialization_failure
pub const S_LIMIT = "54000"         // program_limit_exceeded
pub const S_READ_ONLY = "25006"     // read_only_sql_transaction

pub fn ioErr(op: str, errno: int): DbErr {
    return DbErr{state: S_IO, msg: op + ": errno " + errno.toStr(), context: ""}
}

pub fn corrupt(msg: str): DbErr { return DbErr{state: S_CORRUPT, msg: msg, context: ""} }

pub fn conflict(): DbErr {
    return DbErr{state: S_CONFLICT, msg: "could not serialize access due to concurrent update", context: ""}
}

// ---- CRC32C (Castagnoli), as iSCSI and ext4 use it: lib hash's, with the
// CPU's crc32 instruction. Every page read is checked, so this is on the
// read path (a byte-at-a-time table took 17% of the SQL thread in random
// reads beyond the cache).

// CRC32C of b[from..to).
pub fn crc32c(b: &[byte], from: int, to: int): u32 { return hash.crc32c(&b[from..to]) }

// ---- xorshift64*: deterministic, for the simulated disk and the tests.

pub type Rng = value record { s: u64 }

pub fn rng(seed: int): Rng {
    var s = u64(seed & 0x7FFFFFFFFFFFFFFF) *% 0x9E3779B97F4A7C15
    if s == 0 { s = 0x2545F4914F6CDD1D }
    return Rng{s: s}
}

pub fn (r: mut &Rng) next(): u64 {
    var x = r.s
    x = x ^ (x >> 12)
    x = x ^ (x << 25)
    x = x ^ (x >> 27)
    r.s = x
    return x *% 0x2545F4914F6CDD1D
}

// A number in 0..n-1 (n > 0).
pub fn (r: mut &Rng) below(n: int): int {
    return int((r.next() >> 1) % u64(n))
}

// A copy of s with bytes of its own. A slice shares its string's block
// (a decoded page's), so a slice kept would keep the whole page: a key
// moving up into a parent node is copied. A concatenation makes new bytes.
pub fn own(s: &str): str {
    if len(s) == 0 { return "" }
    if len(s) == 1 { return strFromBytes(&strToBytes(s)) }
    return s[0..1] + s[1..len(s)]
}

// ---- temporary objects (design/lexdb.md 9.96): a session's live in its own
// schema, pg_temp_N (N the session's number), and every catalog row of
// one has a key in it: a relation's "pg_temp_N\x1fname", an index's and a
// sequence's that after the byte \x01 or \x04, an owner's and grants' that
// after "\x02acl\x00r:", a table's statistics' after "\x02stat\x00"
// (ANALYZE's, lexdb-optimizer.md 20 and 40).

// Whether schema name sc is a session's temporary one: pg_temp_ and digits.
pub fn isTempSchema(sc: &str): bool {
    if len(sc) < 9 || sc[0] != 'p' || sc[0..8] != "pg_temp_" { return false }
    for i in 8..len(sc) { if sc[i] < '0' || sc[i] > '9' { return false } }
    return true
}

// Whether catalog key k is a temporary object's (its schema's).
pub fn tempCatKey(k: &str): bool {
    var at = 0
    if len(k) > 0 && (k[0] == 1 || k[0] == 4) { at = 1 }
    else if len(k) > 7 && k[0] == 2 && k[0..7] == "\x02acl\x00r:" { at = 7 }
    else if len(k) > 6 && k[0] == 2 && k[0..6] == "\x02stat\x00" { at = 6 }
    if len(k) < at + 10 || k[at] != 'p' { return false }
    var i = at
    while i < len(k) && k[i] != 0x1f { i += 1 }
    return i < len(k) && isTempSchema(&k[at..i])
}
