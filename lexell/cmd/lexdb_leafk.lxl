// lexdb: conditions run on a column leaf's bytes (lexdb-tpch-perf 4.6).
//
// A batch scan decodes a column leaf's places into a batch and then runs
// its conditions over the batch's rows. A condition that compares one
// place's words (an integer's, a date's or time's, a numeric's units) with
// a constant or with another place's words, or one place's texts with
// constant texts, holds or not by those bytes alone: it is run on the leaf
// before anything is decoded (cRunLazy), and the batch decodes the other
// places for the rows it keeps only. A date read into a batch is a value
// (Val.Date) per row; read here it is its word.
//
// Each kernel gives a row what its condition's batch node (lexdb_pipe's
// Cmp, DCmp, ValCmp, VCmp, InVals and their OR) gives it: kept when the
// condition is true, dropped when it is false or NULL. A leaf whose place
// is not of the kind the kernel expects (an older leaf of a retyped
// column) gives None: the caller decodes and runs the conditions instead.

import "./lexdb_rows"
import "collections"
import "strings"
import "./lexdb_cols"
import "./lexdb_like"
import "./lexdb_token"

type LeafView = lexdb_rows.LeafView
type VB = vector[byte]
type VI = vector[int]

// One condition on a leaf's bytes.
pub type LeafK = closed {
    // place pl's words in lo..hi (inclusive): its kind pk (PK_INT: any
    // integer kind), sc a units place's scale (-1 a word place)
    Range(int, byte, int, int, int)
    // place pl's words not k (pl, pk, sc, k)
    Ne(int, byte, int, int)
    // places a and b's words compared, = <> < <= > >= as 0 to 5 (op, a, b,
    // their kind)
    Cols(int, int, int, byte)
    // place pl's texts compared with ks[0] by their bytes, = <> < <= > >=
    // as 0 to 5; 6: one of ks (op, pl, ks)
    Texts(int, int, []str)
    // place pl's texts' first m characters one of ks, its trailing blanks
    // removed first when trim (a char(n)'s): substring(x from 1 for m) IN
    // (...) (pl, m, trim, ks; q22's)
    Prefix(int, int, bool, []str)
    // simple LIKE / ILIKE (no _ or escape) on text place pl (pl, fold, neg, pieces)
    Like(int, bool, bool, []str)
    // has_token / has_token_ci on text place pl (pl, fold, neg, word)
    Token(int, bool, bool, str)
    // runtime hash-join Bloom + range filter on integer place pl (pl, pk, bf)
    IntBloom(int, byte, lexdb_cols.IntBloom)
    // every one holds; one at least holds
    All([]LeafK)
    Any([]LeafK)
}

pub fn intBloom(pl: int, pk: byte, bf: lexdb_cols.IntBloom): LeafK {
    return LeafK.IntBloom(pl, pk, bf)
}

// Fast zero-allocation check: true when k is guaranteed to pass every row in leaf
// (e.g. a non-NULL Range whose leaf [mn, mx] is completely inside [lo, hi]).
pub fn allPassCols(s: &str, dir: &[]int, k: &LeafK): bool {
    match k {
        LeafK.Range(pl, pk, sc, lo, hi) {
            if !wordsOkCols(s, dir, pl, pk, sc) { return false }
            if lexdb_cols.hasNulls(dir, pl) || !lexdb_cols.hasRange(dir, pl) { return false }
            return lexdb_cols.least(dir, pl) >= lo && lexdb_cols.greatest(dir, pl) <= hi
        }
        else { return false }
    }
}

pub fn allPass(leaf: &LeafView, k: &LeafK): bool {
    return allPassCols(leaf.cols, leaf.dir, k)
}

pub const MIN_W: int = -9223372036854775807 - 1
pub const MAX_W: int = 9223372036854775807

// The kernel of place pl's words op k (= <> < <= > >= as 0 to 5).
pub fn words(op: int, pl: int, pk: byte, sc: int, k: int): LeafK {
    if op == 1 { return LeafK.Ne(pl, pk, sc, k) }
    if op == 0 { return LeafK.Range(pl, pk, sc, k, k) }
    if op == 2 { return if k == MIN_W { LeafK.Range(pl, pk, sc, 0, -1) } else { LeafK.Range(pl, pk, sc, MIN_W, k - 1) } }
    if op == 3 { return LeafK.Range(pl, pk, sc, MIN_W, k) }
    if op == 4 { return if k == MAX_W { LeafK.Range(pl, pk, sc, 0, -1) } else { LeafK.Range(pl, pk, sc, k + 1, MAX_W) } }
    return LeafK.Range(pl, pk, sc, k, MAX_W)
}

// ks with each run of ranges on one place (q6's l_shipdate >= a and < b)
// made one.
pub fn merged(ks: []LeafK): []LeafK {
    var out: []LeafK = []
    for k in move(ks) {
        var done = false
        if len(out) > 0 {
            match k {
                LeafK.Range(pl, pk, sc, lo, hi) {
                    let n = len(out) - 1
                    match out[n] {
                        LeafK.Range(pl2, pk2, sc2, lo2, hi2) {
                            if pl == pl2 && pk == pk2 && sc == sc2 {
                                out[n] = LeafK.Range(pl, pk, sc, max(lo, lo2), min(hi, hi2))
                                done = true
                            }
                        }
                        else {}
                    }
                }
                else {}
            }
        }
        if !done { append(mut &out, k) }
    }
    return out
}

// Whether place pl of the leaf holds words of kind pk (PK_INT: any
// integer kind) at scale sc (-1: not a units place) as intAt reads them.
fn wordsOkCols(s: &str, dir: &[]int, pl: int, pk: byte, sc: int): bool {
    if pl >= lexdb_cols.places(dir) { return false }
    let k = lexdb_cols.kindOf(s, pl)
    let c = lexdb_cols.codecOf(dir, pl)
    if sc >= 0 { return k == lexdb_rows.PK_NUM && c == lexdb_cols.C_UNITS && lexdb_cols.scaleOf(dir, pl) == sc }
    if pk == lexdb_rows.PK_INT { if !lexdb_rows.isIntKind(k) { return false } } else if k != pk { return false }
    return c == lexdb_cols.C_FOR || c == lexdb_cols.C_RAW
}


// Place pl's words of rows rs (leaf row from + r - r0), in rs's order, of a
// run of cnt rows: unpacked together when rs holds half the run or more,
// else row by row.
fn wordsOfCols(s: &str, dir: &[]int, from: int, rs: &[]int, r0: int, cnt: int, pl: int): []int {
    let n = len(rs)
    var w: []int = array(n, 0)
    if n == cnt { lexdb_cols.intsInto(s, dir, pl, from, n, mut &w, 0) } else if 2 * n >= cnt {
        var all: []int = array(cnt, 0)
        lexdb_cols.intsInto(s, dir, pl, from, cnt, mut &all, 0)
        for x in 0..n { w[x] = all[rs[x] - r0] }
    } else {
        lexdb_cols.intsPickDense(s, dir, pl, from, rs, r0, mut &w)
    }
    return w
}

// A dictionary place's codes of rows rs, as wordsOfCols.
fn codesOfCols(s: &str, dir: &[]int, from: int, rs: &[]int, r0: int, cnt: int, pl: int): []int {
    let n = len(rs)
    var w: []int = array(n, 0)
    if n == cnt { lexdb_cols.codesInto(s, dir, pl, from, n, mut &w, 0) } else if 2 * n >= cnt {
        var all: []int = array(cnt, 0)
        lexdb_cols.codesInto(s, dir, pl, from, cnt, mut &all, 0)
        for x in 0..n { w[x] = all[rs[x] - r0] }
    } else {
        for x in 0..n { w[x] = lexdb_cols.codeAt(s, dir, pl, from + rs[x] - r0) }
    }
    return w
}

fn holds(op: int, c: int): bool {
    return if op == 0 { c == 0 } else if op == 1 { c != 0 } else if op == 2 { c < 0 } else if op == 3 { c <= 0 } else if op == 4 { c > 0 } else { c >= 0 }
}

// Whether text t passes op against ks (as Texts).
fn textHolds(op: int, t: &str, ks: &[]str): bool {
    if op == 6 {
        for k in ks { if t == k { return true } }
        return false
    }
    return holds(op, t.cmp(&ks[0]))
}

// The first m characters of t (its trailing blanks removed first: trim)
// one of ks, as substring(t from 1 for m) (lexdb_lib.substr) gives them.
fn prefixIn(t: &str, m: int, trim: bool, ks: &[]str): bool {
    var e = len(t)
    if trim { while e > 0 && t[e - 1] == ' ' { e -= 1 } }
    var ascii = true
    var bi = 0
    if e >= VB.lanes {
        let vHi = VB.splat(byte(128))
        let sl = &t[0..e]
        for v in VB.chunks(sl, mut &bi) {
            if (v >= vHi).any() {
                ascii = false
                break
            }
        }
    }
    if ascii {
        while bi < e {
            if t[bi] >= 128 {
                ascii = false
                break
            }
            bi += 1
        }
    }
    if ascii {
        let p = &t[0..min(m, e)]
        for k in ks { if p == k { return true } }
        return false
    }
    let rs = strings.runes(&t[0..e])
    var out: []int = []
    for i in 0..min(m, len(rs)) { append(mut &out, rs[i]) }
    let p = strings.fromRunes(&out)
    for k in ks { if p == k { return true } }
    return false
}

// Direct (non-closure) text kernel helpers so rowsOfCols is 100% pure for par.map kernels.
fn textRowsOp(s: &str, dir: &[]int, from: int, rs: &[]int, r0: int, cnt: int, pl: int, op: int, ks: &[]str): Option[[]int] {
    let n = len(rs)
    if pl >= lexdb_cols.places(dir) || lexdb_cols.kindOf(s, pl) != lexdb_rows.PK_TEXT { return None }
    let codec = lexdb_cols.codecOf(dir, pl)
    let nulls = lexdb_cols.hasNulls(dir, pl)
    var out: []int = []
    if codec == lexdb_cols.C_DICT {
        let nd = lexdb_cols.dictSize(dir, pl)
        var hit: []bool = array(nd, false)
        for j in 0..nd {
            let sp = lexdb_cols.entryAt(s, dir, pl, j)
            hit[j] = textHolds(op, &s[lexdb_cols.spanStart(sp)..lexdb_cols.spanEnd(sp)], ks)
        }
        let codes = codesOfCols(s, dir, from, rs, r0, cnt, pl)
        for x in 0..n {
            if hit[codes[x]] {
                if nulls && lexdb_cols.isNull(s, dir, pl, from + rs[x] - r0) { continue }
                append(mut &out, rs[x])
            }
        }
        return Some(out)
    }
    if codec != lexdb_cols.C_TEXT { return None }
    for x in 0..n {
        let i = from + rs[x] - r0
        if nulls && lexdb_cols.isNull(s, dir, pl, i) { continue }
        let sp = lexdb_cols.varAt(s, dir, pl, i)
        if textHolds(op, &s[lexdb_cols.spanStart(sp)..lexdb_cols.spanEnd(sp)], ks) { append(mut &out, rs[x]) }
    }
    return Some(out)
}

fn textRowsPrefix(s: &str, dir: &[]int, from: int, rs: &[]int, r0: int, cnt: int, pl: int, m: int, trim: bool, ks: &[]str): Option[[]int] {
    let n = len(rs)
    if pl >= lexdb_cols.places(dir) || lexdb_cols.kindOf(s, pl) != lexdb_rows.PK_TEXT { return None }
    let codec = lexdb_cols.codecOf(dir, pl)
    let nulls = lexdb_cols.hasNulls(dir, pl)
    var out: []int = []
    if codec == lexdb_cols.C_DICT {
        let nd = lexdb_cols.dictSize(dir, pl)
        var hit: []bool = array(nd, false)
        for j in 0..nd {
            let sp = lexdb_cols.entryAt(s, dir, pl, j)
            hit[j] = prefixIn(&s[lexdb_cols.spanStart(sp)..lexdb_cols.spanEnd(sp)], m, trim, ks)
        }
        let codes = codesOfCols(s, dir, from, rs, r0, cnt, pl)
        for x in 0..n {
            if hit[codes[x]] {
                if nulls && lexdb_cols.isNull(s, dir, pl, from + rs[x] - r0) { continue }
                append(mut &out, rs[x])
            }
        }
        return Some(out)
    }
    if codec != lexdb_cols.C_TEXT { return None }
    for x in 0..n {
        let i = from + rs[x] - r0
        if nulls && lexdb_cols.isNull(s, dir, pl, i) { continue }
        let sp = lexdb_cols.varAt(s, dir, pl, i)
        if prefixIn(&s[lexdb_cols.spanStart(sp)..lexdb_cols.spanEnd(sp)], m, trim, ks) { append(mut &out, rs[x]) }
    }
    return Some(out)
}

fn textRowsLike(s: &str, dir: &[]int, from: int, rs: &[]int, r0: int, cnt: int, pl: int, fold: bool, neg: bool, ps: &[]str): Option[[]int] {
    let n = len(rs)
    if pl >= lexdb_cols.places(dir) || lexdb_cols.kindOf(s, pl) != lexdb_rows.PK_TEXT { return None }
    let codec = lexdb_cols.codecOf(dir, pl)
    let nulls = lexdb_cols.hasNulls(dir, pl)
    var out: []int = []
    if codec == lexdb_cols.C_DICT {
        let nd = lexdb_cols.dictSize(dir, pl)
        var hit: []bool = array(nd, false)
        for j in 0..nd {
            let sp = lexdb_cols.entryAt(s, dir, pl, j)
            let lo = lexdb_cols.spanStart(sp)
            let hi = lexdb_cols.spanEnd(sp)
            let ok = if fold { lexdb_like.likeRangeFold(s, lo, hi, ps) } else { lexdb_like.likeRange(s, lo, hi, ps) }
            hit[j] = ok != neg
        }
        let codes = codesOfCols(s, dir, from, rs, r0, cnt, pl)
        for x in 0..n {
            if hit[codes[x]] {
                if nulls && lexdb_cols.isNull(s, dir, pl, from + rs[x] - r0) { continue }
                append(mut &out, rs[x])
            }
        }
        return Some(out)
    }
    if codec != lexdb_cols.C_TEXT { return None }
    for x in 0..n {
        let i = from + rs[x] - r0
        if nulls && lexdb_cols.isNull(s, dir, pl, i) { continue }
        let sp = lexdb_cols.varAt(s, dir, pl, i)
        let lo = lexdb_cols.spanStart(sp)
        let hi = lexdb_cols.spanEnd(sp)
        let ok = if fold { lexdb_like.likeRangeFold(s, lo, hi, ps) } else { lexdb_like.likeRange(s, lo, hi, ps) }
        if ok != neg { append(mut &out, rs[x]) }
    }
    return Some(out)
}

fn textRowsToken(s: &str, dir: &[]int, from: int, rs: &[]int, r0: int, cnt: int, pl: int, fold: bool, neg: bool, w: &str): Option[[]int] {
    let n = len(rs)
    if pl >= lexdb_cols.places(dir) || lexdb_cols.kindOf(s, pl) != lexdb_rows.PK_TEXT { return None }
    let codec = lexdb_cols.codecOf(dir, pl)
    let nulls = lexdb_cols.hasNulls(dir, pl)
    var out: []int = []
    if codec == lexdb_cols.C_DICT {
        let nd = lexdb_cols.dictSize(dir, pl)
        var hit: []bool = array(nd, false)
        for j in 0..nd {
            let sp = lexdb_cols.entryAt(s, dir, pl, j)
            let ok = lexdb_token.hasTokenRange(s, lexdb_cols.spanStart(sp), lexdb_cols.spanEnd(sp), w, fold)
            hit[j] = ok != neg
        }
        let codes = codesOfCols(s, dir, from, rs, r0, cnt, pl)
        for x in 0..n {
            if hit[codes[x]] {
                if nulls && lexdb_cols.isNull(s, dir, pl, from + rs[x] - r0) { continue }
                append(mut &out, rs[x])
            }
        }
        return Some(out)
    }
    if codec != lexdb_cols.C_TEXT { return None }
    for x in 0..n {
        let i = from + rs[x] - r0
        if nulls && lexdb_cols.isNull(s, dir, pl, i) { continue }
        let sp = lexdb_cols.varAt(s, dir, pl, i)
        let ok = lexdb_token.hasTokenRange(s, lexdb_cols.spanStart(sp), lexdb_cols.spanEnd(sp), w, fold)
        if ok != neg { append(mut &out, rs[x]) }
    }
    return Some(out)
}

// The rows of rs (batch rows of a run of cnt rows, leaf row from at batch
// row r0) k holds for, in order. None: a place of the leaf is not of the
// kind k reads. Pure (no LeafView / indirect calls) for par.map workers.
pub fn rowsOfCols(s: &str, dir: &[]int, from: int, rs: &[]int, r0: int, cnt: int, k: &LeafK): Option[[]int] {
    let n = len(rs)
    match k {
        LeafK.Range(pl, pk, sc, lo, hi) {
            if !wordsOkCols(s, dir, pl, pk, sc) { return None }
            let nulls = lexdb_cols.hasNulls(dir, pl)
            if lexdb_cols.hasRange(dir, pl) {
                let mn = lexdb_cols.least(dir, pl)
                let mx = lexdb_cols.greatest(dir, pl)
                if lo > hi || mx < lo || mn > hi { return Some([]) }
                if !nulls && mn >= lo && mx <= hi { return Some(collections.copyOf(rs)) }
            }
            if n == cnt && !nulls {
                return Some(lexdb_cols.rangeFilter(s, dir, pl, from, cnt, r0, lo, hi))
            }
            let w = wordsOfCols(s, dir, from, rs, r0, cnt, pl)
            var out: []int = withCapacity(n)
            if !nulls {
                let vLo = VI.splat(lo)
                let vHi = VI.splat(hi)
                var x = 0
                for v in VI.chunks(&w, mut &x) {
                    var m = ((v >= vLo) & (v <= vHi)).bitmask()
                    while m != u64(0) {
                        let tz = int(m.trailingZeros())
                        append(mut &out, rs[x + tz])
                        m = m & (m - u64(1))
                    }
                }
                while x < n {
                    let v = w[x]
                    if v >= lo && v <= hi { append(mut &out, rs[x]) }
                    x += 1
                }
                return Some(out)
            }
            for x in 0..n {
                let v = w[x]
                if v >= lo && v <= hi {
                    if lexdb_cols.isNull(s, dir, pl, from + rs[x] - r0) { continue }
                    append(mut &out, rs[x])
                }
            }
            return Some(out)
        }
        LeafK.Ne(pl, pk, sc, kv) {
            if !wordsOkCols(s, dir, pl, pk, sc) { return None }
            let nulls = lexdb_cols.hasNulls(dir, pl)
            if lexdb_cols.hasRange(dir, pl) {
                let mn = lexdb_cols.least(dir, pl)
                let mx = lexdb_cols.greatest(dir, pl)
                if mn == kv && mx == kv { return Some([]) }
                if !nulls && (kv < mn || kv > mx) { return Some(collections.copyOf(rs)) }
            }
            let w = wordsOfCols(s, dir, from, rs, r0, cnt, pl)
            var out: []int = withCapacity(n)
            if !nulls {
                let vK = VI.splat(kv)
                var x = 0
                for v in VI.chunks(&w, mut &x) {
                    var m = (v != vK).bitmask()
                    while m != u64(0) {
                        let tz = int(m.trailingZeros())
                        append(mut &out, rs[x + tz])
                        m = m & (m - u64(1))
                    }
                }
                while x < n {
                    if w[x] != kv { append(mut &out, rs[x]) }
                    x += 1
                }
                return Some(out)
            }
            for x in 0..n {
                if w[x] != kv {
                    if lexdb_cols.isNull(s, dir, pl, from + rs[x] - r0) { continue }
                    append(mut &out, rs[x])
                }
            }
            return Some(out)
        }
        LeafK.Cols(op, pa, pb, pk) {
            if !wordsOkCols(s, dir, pa, pk, -1) || !wordsOkCols(s, dir, pb, pk, -1) { return None }
            let wa = wordsOfCols(s, dir, from, rs, r0, cnt, pa)
            let wb = wordsOfCols(s, dir, from, rs, r0, cnt, pb)
            var out: []int = withCapacity(n)
            let nulls = lexdb_cols.hasNulls(dir, pa) || lexdb_cols.hasNulls(dir, pb)
            if !nulls {
                var x = 0
                if op == 0 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        var m = (VI.load(&wa, x) == VI.load(&wb, x)).bitmask()
                        while m != u64(0) { append(mut &out, rs[x + int(m.trailingZeros())]); m = m & (m - u64(1)) }
                        x += VI.lanes
                    }
                } else if op == 1 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        var m = (VI.load(&wa, x) != VI.load(&wb, x)).bitmask()
                        while m != u64(0) { append(mut &out, rs[x + int(m.trailingZeros())]); m = m & (m - u64(1)) }
                        x += VI.lanes
                    }
                } else if op == 2 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        var m = (VI.load(&wa, x) < VI.load(&wb, x)).bitmask()
                        while m != u64(0) { append(mut &out, rs[x + int(m.trailingZeros())]); m = m & (m - u64(1)) }
                        x += VI.lanes
                    }
                } else if op == 3 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        var m = (VI.load(&wa, x) <= VI.load(&wb, x)).bitmask()
                        while m != u64(0) { append(mut &out, rs[x + int(m.trailingZeros())]); m = m & (m - u64(1)) }
                        x += VI.lanes
                    }
                } else if op == 4 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        var m = (VI.load(&wa, x) > VI.load(&wb, x)).bitmask()
                        while m != u64(0) { append(mut &out, rs[x + int(m.trailingZeros())]); m = m & (m - u64(1)) }
                        x += VI.lanes
                    }
                } else {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        var m = (VI.load(&wa, x) >= VI.load(&wb, x)).bitmask()
                        while m != u64(0) { append(mut &out, rs[x + int(m.trailingZeros())]); m = m & (m - u64(1)) }
                        x += VI.lanes
                    }
                }
                while x < n {
                    let a = wa[x]
                    let b = wb[x]
                    if holds(op, if a < b { -1 } else if a > b { 1 } else { 0 }) {
                        append(mut &out, rs[x])
                    }
                    x += 1
                }
                return Some(out)
            }
            for x in 0..n {
                let a = wa[x]
                let b = wb[x]
                if holds(op, if a < b { -1 } else if a > b { 1 } else { 0 }) {
                    let i = from + rs[x] - r0
                    if lexdb_cols.isNull(s, dir, pa, i) || lexdb_cols.isNull(s, dir, pb, i) { continue }
                    append(mut &out, rs[x])
                }
            }
            return Some(out)
        }
        LeafK.Texts(op, pl, ks) { return textRowsOp(s, dir, from, rs, r0, cnt, pl, op, &ks) }
        LeafK.Prefix(pl, m, trim, ks) { return textRowsPrefix(s, dir, from, rs, r0, cnt, pl, m, trim, &ks) }
        LeafK.Like(pl, fold, neg, ps) { return textRowsLike(s, dir, from, rs, r0, cnt, pl, fold, neg, &ps) }
        LeafK.Token(pl, fold, neg, w) { return textRowsToken(s, dir, from, rs, r0, cnt, pl, fold, neg, &w) }
        LeafK.IntBloom(pl, pk, bf) {
            if !wordsOkCols(s, dir, pl, pk, -1) { return None }
            let nulls = lexdb_cols.hasNulls(dir, pl)
            if lexdb_cols.hasRange(dir, pl) {
                let mn = lexdb_cols.least(dir, pl)
                let mx = lexdb_cols.greatest(dir, pl)
                if bf.lo > bf.hi || mx < bf.lo || mn > bf.hi { return Some([]) }
            }
            if n == cnt && !nulls {
                return Some(lexdb_cols.bloomFilter(s, dir, pl, from, cnt, r0, &bf))
            }
            let w = wordsOfCols(s, dir, from, rs, r0, cnt, pl)
            var out: []int = withCapacity(n)
            for x in 0..n {
                if bf.has(w[x]) {
                    if nulls && lexdb_cols.isNull(s, dir, pl, from + rs[x] - r0) { continue }
                    append(mut &out, rs[x])
                }
            }
            return Some(out)
        }
        LeafK.All(ks) {
            var cur = collections.copyOf(rs)
            for k2 in ks {
                if len(cur) == 0 { break }
                match rowsOfCols(s, dir, from, &cur, r0, cnt, &k2) {
                    Some(x) { cur = x }
                    None { return None }
                }
            }
            return Some(cur)
        }
        LeafK.Any(ks) {
            var hit: []bool = array(n, false)
            for k2 in ks {
                match rowsOfCols(s, dir, from, rs, r0, cnt, &k2) {
                    Some(x) {
                        var j = 0
                        for r in x {
                            while rs[j] != r { j += 1 }
                            hit[j] = true
                        }
                    }
                    None { return None }
                }
            }
            var out: []int = []
            for x in 0..n { if hit[x] { append(mut &out, rs[x]) } }
            return Some(out)
        }
    }
}

pub fn rowsOf(leaf: &LeafView, from: int, rs: &[]int, r0: int, cnt: int, k: &LeafK): Option[[]int] {
    return rowsOfCols(leaf.cols, leaf.dir, from, rs, r0, cnt, k)
}

// Zero-allocation leaf-direct count of rows in from..from+cnt where k holds.
// Uses SIMD bitmask().countOnes() (popcnt) and skips building row-index arrays.
pub fn countOfCols(s: &str, dir: &[]int, from: int, cnt: int, k: &LeafK): Option[int] {
    if cnt <= 0 { return Some(0) }
    match k {
        LeafK.Range(pl, pk, sc, lo, hi) {
            if !wordsOkCols(s, dir, pl, pk, sc) { return None }
            let nulls = lexdb_cols.hasNulls(dir, pl)
            if lexdb_cols.hasRange(dir, pl) {
                let mn = lexdb_cols.least(dir, pl)
                let mx = lexdb_cols.greatest(dir, pl)
                if lo > hi || mx < lo || mn > hi { return Some(0) }
                if !nulls && mn >= lo && mx <= hi { return Some(cnt) }
            }
            if !nulls {
                return Some(lexdb_cols.rangeCount(s, dir, pl, from, cnt, lo, hi))
            }
            var w: []int = array(cnt, 0)
            lexdb_cols.intsInto(s, dir, pl, from, cnt, mut &w, 0)
            var tot = 0
            for q in 0..cnt {
                let v = w[q]
                if v >= lo && v <= hi && !lexdb_cols.isNull(s, dir, pl, from + q) { tot += 1 }
            }
            return Some(tot)
        }
        LeafK.Ne(pl, pk, sc, kv) {
            if !wordsOkCols(s, dir, pl, pk, sc) { return None }
            let nulls = lexdb_cols.hasNulls(dir, pl)
            if lexdb_cols.hasRange(dir, pl) {
                let mn = lexdb_cols.least(dir, pl)
                let mx = lexdb_cols.greatest(dir, pl)
                if mn == kv && mx == kv { return Some(0) }
                if !nulls && (kv < mn || kv > mx) { return Some(cnt) }
            }
            var w: []int = array(cnt, 0)
            lexdb_cols.intsInto(s, dir, pl, from, cnt, mut &w, 0)
            var tot = 0
            if !nulls {
                let vK = VI.splat(kv)
                var x = 0
                for v in VI.chunks(&w, mut &x) {
                    tot += int((v != vK).bitmask().countOnes())
                }
                while x < cnt {
                    if w[x] != kv { tot += 1 }
                    x += 1
                }
                return Some(tot)
            }
            for q in 0..cnt {
                if w[q] != kv && !lexdb_cols.isNull(s, dir, pl, from + q) { tot += 1 }
            }
            return Some(tot)
        }
        LeafK.Cols(op, pa, pb, pk) {
            if !wordsOkCols(s, dir, pa, pk, -1) || !wordsOkCols(s, dir, pb, pk, -1) { return None }
            var wa: []int = array(cnt, 0)
            var wb: []int = array(cnt, 0)
            lexdb_cols.intsInto(s, dir, pa, from, cnt, mut &wa, 0)
            lexdb_cols.intsInto(s, dir, pb, from, cnt, mut &wb, 0)
            let nulls = lexdb_cols.hasNulls(dir, pa) || lexdb_cols.hasNulls(dir, pb)
            var tot = 0
            if !nulls {
                var x = 0
                if op == 0 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        tot += int((VI.load(&wa, x) == VI.load(&wb, x)).bitmask().countOnes())
                        x += VI.lanes
                    }
                } else if op == 1 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        tot += int((VI.load(&wa, x) != VI.load(&wb, x)).bitmask().countOnes())
                        x += VI.lanes
                    }
                } else if op == 2 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        tot += int((VI.load(&wa, x) < VI.load(&wb, x)).bitmask().countOnes())
                        x += VI.lanes
                    }
                } else if op == 3 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        tot += int((VI.load(&wa, x) <= VI.load(&wb, x)).bitmask().countOnes())
                        x += VI.lanes
                    }
                } else if op == 4 {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        tot += int((VI.load(&wa, x) > VI.load(&wb, x)).bitmask().countOnes())
                        x += VI.lanes
                    }
                } else {
                    while x + VI.lanes <= len(wa) && x + VI.lanes <= len(wb) {
                        tot += int((VI.load(&wa, x) >= VI.load(&wb, x)).bitmask().countOnes())
                        x += VI.lanes
                    }
                }
                while x < cnt {
                    let a = wa[x]
                    let b = wb[x]
                    if holds(op, if a < b { -1 } else if a > b { 1 } else { 0 }) { tot += 1 }
                    x += 1
                }
                return Some(tot)
            }
            for q in 0..cnt {
                let a = wa[q]
                let b = wb[q]
                if holds(op, if a < b { -1 } else if a > b { 1 } else { 0 }) {
                    let i = from + q
                    if !lexdb_cols.isNull(s, dir, pa, i) && !lexdb_cols.isNull(s, dir, pb, i) { tot += 1 }
                }
            }
            return Some(tot)
        }
        LeafK.Like(pl, fold, neg, ps) {
            if pl >= lexdb_cols.places(dir) || lexdb_cols.kindOf(s, pl) != lexdb_rows.PK_TEXT { return None }
            let codec = lexdb_cols.codecOf(dir, pl)
            let nulls = lexdb_cols.hasNulls(dir, pl)
            var tot = 0
            if codec == lexdb_cols.C_DICT {
                let nd = lexdb_cols.dictSize(dir, pl)
                var hit: []bool = array(nd, false)
                for j in 0..nd {
                    let sp = lexdb_cols.entryAt(s, dir, pl, j)
                    let ok = if fold { lexdb_like.likeRangeFold(s, lexdb_cols.spanStart(sp), lexdb_cols.spanEnd(sp), &ps) }
                             else { lexdb_like.likeRange(s, lexdb_cols.spanStart(sp), lexdb_cols.spanEnd(sp), &ps) }
                    hit[j] = ok != neg
                }
                var codes: []int = array(cnt, 0)
                lexdb_cols.codesInto(s, dir, pl, from, cnt, mut &codes, 0)
                for q in 0..cnt {
                    if hit[codes[q]] && (!nulls || !lexdb_cols.isNull(s, dir, pl, from + q)) { tot += 1 }
                }
                return Some(tot)
            }
            if codec != lexdb_cols.C_TEXT { return None }
            for q in 0..cnt {
                let i = from + q
                if nulls && lexdb_cols.isNull(s, dir, pl, i) { continue }
                let sp = lexdb_cols.varAt(s, dir, pl, i)
                let ok = if fold { lexdb_like.likeRangeFold(s, lexdb_cols.spanStart(sp), lexdb_cols.spanEnd(sp), &ps) }
                         else { lexdb_like.likeRange(s, lexdb_cols.spanStart(sp), lexdb_cols.spanEnd(sp), &ps) }
                if ok != neg { tot += 1 }
            }
            return Some(tot)
        }
        LeafK.Token(pl, fold, neg, w) {
            if pl >= lexdb_cols.places(dir) || lexdb_cols.kindOf(s, pl) != lexdb_rows.PK_TEXT { return None }
            let codec = lexdb_cols.codecOf(dir, pl)
            let nulls = lexdb_cols.hasNulls(dir, pl)
            var tot = 0
            if codec == lexdb_cols.C_DICT {
                let nd = lexdb_cols.dictSize(dir, pl)
                var hit: []bool = array(nd, false)
                for j in 0..nd {
                    let sp = lexdb_cols.entryAt(s, dir, pl, j)
                    hit[j] = lexdb_token.hasTokenRange(s, lexdb_cols.spanStart(sp), lexdb_cols.spanEnd(sp), &w, fold) != neg
                }
                var codes: []int = array(cnt, 0)
                lexdb_cols.codesInto(s, dir, pl, from, cnt, mut &codes, 0)
                for q in 0..cnt {
                    if hit[codes[q]] && (!nulls || !lexdb_cols.isNull(s, dir, pl, from + q)) { tot += 1 }
                }
                return Some(tot)
            }
            if codec != lexdb_cols.C_TEXT { return None }
            for q in 0..cnt {
                let i = from + q
                if nulls && lexdb_cols.isNull(s, dir, pl, i) { continue }
                let sp = lexdb_cols.varAt(s, dir, pl, i)
                if lexdb_token.hasTokenRange(s, lexdb_cols.spanStart(sp), lexdb_cols.spanEnd(sp), &w, fold) != neg { tot += 1 }
            }
            return Some(tot)
        }
        else {
            var rs: []int = withCapacity(cnt)
            for q in 0..cnt { append(mut &rs, q) }
            match rowsOfCols(s, dir, from, &rs, 0, cnt, k) {
                Some(out) { return Some(len(out)) }
                None { return None }
            }
        }
    }
}

// Runs of column leaf rows the kernels chose (cRunLazy), for the tests.
var runs: int = 0

pub fn noteRun() { runs += 1 }

pub fn kernRuns(): int { return runs }
