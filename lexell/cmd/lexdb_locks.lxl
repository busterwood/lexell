// lexdb_locks: row locks, their waiters and deadlock check. A lock owner is
// a transaction's id (Txn.lockId) or a session's negative one for advisory
// locks. The store carries the handle; commit, abort and rollback release
// through it. One lock of its own, so a waiter's cycle walk does not hold
// the storage lock.
import "strings"
import "task"
import "collections"
import "./lexdb_base"

pub type Locks = value record { sh: task.Shared[LockState] }

// Another handle to the same lock table (a handle: clone, a copy, does not apply).
pub fn (l: &Locks) share(): Locks { return Locks{sh: l.sh.share()} }

type LockWait = record { key: str; id: int; p: task.Promise[Unit] }

// Typed holder entry: single-owner fast path (zero slice allocs) + rare shared multi-owner overflow.
type LockEntry = record {
    id0: int
    mode0: int
    extraIds: []int
    extraModes: []int
}

type LockState = record {
    held: Map[str, LockEntry]
    waitByKey: Map[str, []LockWait]
    waitFor: Map[int, str]     // owner -> the key it waits for
    next: int
}

pub fn newLocks(): Locks {
    return Locks{sh: task.shared(LockState{held: collections.newMapWith(collections.fxHashStr), waitByKey: collections.newMapWith(collections.fxHashStr), waitFor: newMap(), next: 0})}
}

// A new owner id (a transaction's first lock).
pub fn (l: &Locks) newId(): int {
    var id = 0
    l.sh.with(fn(s: mut &LockState) {
        s.next += 1
        id = s.next
    })
    return id
}

// What lockRow did.
pub const LOCKED = 0
pub const LOCKED_AFTER_WAIT = 1     // the row may have changed meanwhile
pub const LOCK_SKIPPED = 2          // SKIP LOCKED: another holds it

// Takes lock key lk in mode (lexdb_sql.LOCK_*) for owner me, waiting while
// others hold it in a conflicting mode (wait 0), failing (1: 55P03), or
// skipping (2). keep false: only waits for others, takes no lock (an UPDATE
// outside a block: its own commit ends it at once). added: me did not hold
// it before.
pub fn (l: &Locks) lockAs(me: int, lk: &str, mode: int, wait: int, keep: bool, added: mut &bool): Result[int, lexdb_base.DbErr] {
    var waited = false
    while true {
        var out = -1
        var bad: []lexdb_base.DbErr = []
        var fut: []task.Future[Unit] = []
        l.sh.with(fn(s: mut &LockState) {
            if s.waitFor.size() > 0 { let gone = s.waitFor.remove(&me) }
            if !s.held.has(lk) {
                if keep {
                    s.held.put(lk.toStr(), LockEntry{id0: me, mode0: mode, extraIds: [], extraModes: []})
                    added = true
                }
                out = if waited { LOCKED_AFTER_WAIT } else { LOCKED }
                return
            }
            let e = s.held.atMut(lk)
            // Fast path: single holder is already me
            if len(e.extraIds) == 0 && e.id0 == me {
                if keep && e.mode0 < mode { e.mode0 = mode }
                out = if waited { LOCKED_AFTER_WAIT } else { LOCKED }
                return
            }
            var others: []int = []
            var mine = -1
            if e.id0 == me {
                mine = 0
            } else if lockConflict(mode, e.mode0) {
                append(mut &others, e.id0)
            }
            for i in 0..len(e.extraIds) {
                let hi = e.extraIds[i]
                if hi == me {
                    mine = i + 1
                } else if lockConflict(mode, e.extraModes[i]) {
                    append(mut &others, hi)
                }
            }
            if len(others) == 0 {
                if keep {
                    if mine < 0 {
                        append(mut &e.extraIds, me)
                        append(mut &e.extraModes, mode)
                        added = true
                    } else if mine == 0 {
                        if e.mode0 < mode { e.mode0 = mode }
                    } else {
                        if e.extraModes[mine - 1] < mode { e.extraModes[mine - 1] = mode }
                    }
                }
                out = if waited { LOCKED_AFTER_WAIT } else { LOCKED }
                return
            }
            if wait == 1 {
                append(mut &bad, lexdb_base.err("55P03", "could not obtain lock on row"))
                return
            }
            if wait == 2 {
                out = LOCK_SKIPPED
                return
            }
            if s.cycle(me, &others) {
                append(mut &bad, lexdb_base.err("40P01", "deadlock detected"))
                return
            }
            let task.Handoff{promise: p, future: f} = task.promise[Unit]()
            let lw = LockWait{key: lk.toStr(), id: me, p: p}
            if s.waitByKey.has(lk) {
                append(mut &s.waitByKey.atMut(lk), lw)
            } else {
                s.waitByKey.put(lk.toStr(), [lw])
            }
            s.waitFor.put(me, lk.toStr())
            append(mut &fut, f)
        })
        if len(bad) > 0 { return Err(bad[0].clone()) }
        if out >= 0 { return Ok(out) }
        match pop(mut &fut).wait() {
            Ok(_) {}
            Err(_) { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "lock: the waker has gone")) }
        }
        waited = true
    }
    return Ok(LOCKED)
}

// Releases the row locks of owner id (held, its keys), waking those waiting
// for them.
pub fn (l: &Locks) release(id: int, held: &[]str) {
    if id == 0 { return }
    var wake: []task.Promise[Unit] = []
    l.sh.with(fn(s: mut &LockState) {
        if s.waitFor.size() > 0 { let w = s.waitFor.remove(&id) }
        for lk in held {
            if !s.held.has(&lk) { continue }
            var dropAll = false
            {
                let e = s.held.atMut(&lk)
                if len(e.extraIds) == 0 {
                    if e.id0 == id { dropAll = true }
                } else {
                    var wi = 0
                    for i in 0..len(e.extraIds) {
                        if e.extraIds[i] != id {
                            e.extraIds[wi] = e.extraIds[i]
                            e.extraModes[wi] = e.extraModes[i]
                            wi += 1
                        }
                    }
                    while len(e.extraIds) > wi {
                        let d1 = pop(mut &e.extraIds)
                        let d2 = pop(mut &e.extraModes)
                    }
                    if e.id0 == id {
                        if len(e.extraIds) == 0 {
                            dropAll = true
                        } else {
                            e.id0 = pop(mut &e.extraIds)
                            e.mode0 = pop(mut &e.extraModes)
                        }
                    }
                }
            }
            if dropAll { let r = s.held.remove(&lk) }
            if s.waitByKey.size() > 0 && s.waitByKey.has(&lk) {
                var ws = s.waitByKey.remove(&lk).unwrap()
                while len(ws) > 0 {
                    let LockWait{key: _, id: _, p: p} = pop(mut &ws)
                    append(mut &wake, p)
                }
            }
        }
    })
    while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
}

// Whether any row of [lo, hi) of tree (hi "": to the end) is locked by an
// owner other than me (a range delete falls back to the row path when one
// is, which waits for it, 9.86). Keys are "tree:key", so a scan of the
// locks; none are held most of the time.
pub fn (l: &Locks) locksIn(me: int, tree: int, lo: &str, hi: &str): bool {
    var any = false
    let pre = tree.toStr() + ":"
    l.sh.with(fn(s: mut &LockState) {
        if s.held.size() == 0 { return }
        for i in 0..s.held.size() {
            let k: &str = s.held.keyAt(i)
            if !strings.startsWith(&k, &pre) { continue }
            let key = k[len(pre)..len(k)]
            if key < lo || (len(hi) > 0 && key >= hi) { continue }
            let e = s.held.at(&k)
            if e.id0 != me { any = true; return }
            for h in e.extraIds { if h != me { any = true; return } }
        }
    })
    return any
}

// The rows locked now (for tests and EXPLAIN-like checks).
pub fn (l: &Locks) count(): int {
    var n = 0
    l.sh.with(fn(s: mut &LockState) { n = s.held.size() })
    return n
}

fn lockConflict(a: int, b: int): bool {
    let hi = if a > b { a } else { b }
    let lo = if a > b { b } else { a }
    if hi == 4 { return true }
    if hi == 3 { return lo >= 2 }
    return false
}

// Whether owner me waiting for holders hs would wait for itself: a holder
// that is me, or waits (in turn) for a row me holds.
fn (s: &LockState) cycle(me: int, hs: &[]int): bool {
    var todo: []int = []
    for h in hs { append(mut &todo, h) }
    var seen: []int = []
    while len(todo) > 0 {
        let h = pop(mut &todo)
        if h == me { return true }
        var was = false
        for x in seen { if x == h { was = true } }
        if was { continue }
        append(mut &seen, h)
        match s.waitFor.get(&h) {
            Some(k) {
                if s.held.has(&k) {
                    let e = s.held.at(&k)
                    append(mut &todo, e.id0)
                    for ei in e.extraIds { append(mut &todo, ei) }
                }
            }
            None {}
        }
    }
    return false
}
