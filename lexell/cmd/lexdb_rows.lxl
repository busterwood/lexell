// lexdb: the row and leaf codec (design/lexdb-architecture.md). This module
// owns how a row is represented: the fixed layout, the tagged form, the
// column leaf, the conversion between layouts, and the leaf body a
// checkpoint writes. The store and the executor call it; they do not decode
// pages or rows themselves.
//
// The interface is deliberately small: Rows says how a table's rows are
// laid out, Projection says which columns a reader needs, Batch holds
// decoded rows, and LeafView gives a leaf's rows without copying them.
// encode/decode and encodeLeaf move between them; the format details stay
// here.
import "binary"
import "math"
import "task"
import "./lexdb_base"
import "./lexdb_cols"
import "./lexdb_like"
import "./lexdb_sql"
import "./lexdb_time"

type Val = lexdb_sql.Val
type DbErr = lexdb_base.DbErr

pub const FIXED: byte = 8
pub const PK_NONE: byte = 0     // a dropped column's place
pub const PK_INT: byte = 1      // 8 bytes
pub const PK_BOOL: byte = 2
pub const PK_NUM: byte = 3
pub const PK_TEXT: byte = 4
pub const PK_INT4: byte = 5
pub const PK_INT2: byte = 6
pub const PK_DATE: byte = 7     // 4 bytes: days (9.113)
pub const PK_TIME: byte = 8     // 8 bytes: microseconds
pub const PK_TS: byte = 9
pub const PK_TSTZ: byte = 10
pub const PK_F8: byte = 11      // 8 bytes: a double's bits
pub const PK_F4: byte = 12      // 4 bytes: a real's bits
pub const PK_UUID: byte = 13    // variable: its 16 bytes
pub const PK_BYTEA: byte = 14   // variable: its bytes
// A timestamp that keeps its offset (Val.Tsz; lexdb_sql.isTszType) is a variable place of the uuid's kind, 10 bytes (the instant
// and the offset in minutes) where a uuid has 16: a kind of its own would cost the row codec's tests on the point path a few
// instructions (isVarKind's comparisons no longer a bit test).
pub const PK_TSZ: byte = PK_UUID

// A row's stored form: per column a tag (0 NULL, 1 int, 2 bool, 3 numeric,
// 4 text) and its value. A row with a text of LONG bytes or more begins with
// tag 6 and its column count, and each such text is tag 5 and its length
// in place, its bytes after the last column (9.31): the columns before
// them stay at the row's start, which a large row keeps in its leaf.
pub const LONG: int = 256

// A table's column-leaf schema (lexdb_cols): its layouts and the fill
// value rows written before a column was added take.
pub type Spec = lexdb_cols.Spec

// A large value's stored form (lexdb_store): a stub begins with 0xFF, which
// no row does (a key is at most MAX_KEY bytes), version 1 whole, version 2
// followed by the value's first bytes (9.29, 9.31).
pub const BIG: byte = 0xFF
pub const STUB_LEN: int = 14

pub fn isStub(v: &str): bool { return len(v) >= STUB_LEN && v[0] == BIG && ((v[1] == 1 && len(v) == STUB_LEN) || v[1] == 2) }

// A large value's stored form as the store's part scans give it: its first
// bytes, or None for any other value.
pub fn partOf(v: &str): Option[str] {
    if isStub(v) && v[1] == 2 { return Some(v[STUB_LEN..len(v)].clone()) }
    return None
}

fn isNullVal(v: &Val): bool { match v { Val.Null { return true } else { return false } } }

// Where the places of rows in one layout are: each one's offset in the row,
// and for a variable-length value the offset of the previous one's end (-1:
// it starts the variable part).
pub type FixedLay = record {
    pub kinds: []byte
    pub off: []int              // per place
    pub prev: []int
    pub bm: int                 // the bitmap's offset
    pub v0: int                 // the variable part's
}

// A table's row representation: its layouts, the columns' definitions and
// places, and the offsets of each layout's places.
pub type Rows = value record {
    pub layouts: &[][]byte
    pub cols: &[]lexdb_sql.ColDef
    pub slots: &[]int
    pub width: int
    pub lays: &[]FixedLay
}

// Each place's kind, from its column's type.
pub fn placeKinds(r: &Rows): []byte {
    var out: []byte = array(r.width, PK_NONE)
    for i in 0..len(r.cols) { out[if len(r.slots) == 0 { i } else { r.slots[i] }] = placeKind(&r.cols[i]) }
    return out
}

// The kind of place a column has in the current layout: PK_NONE for a virtual column (design/lexdb-dialect-gaps.md, package C:
// it is computed where it is read, its place holds nothing), as for a dropped one.
pub fn placeKind(c: &lexdb_sql.ColDef): byte {
    if c.genKind == lexdb_sql.GEN_VIRTUAL { return PK_NONE }
    let o = c.typ.oid
    var k = PK_TEXT
    if o == lexdb_sql.OID_INT8 { k = PK_INT }
    else if o == lexdb_sql.OID_INT4 { k = PK_INT4 }
    else if o == lexdb_sql.OID_INT2 { k = PK_INT2 }
    else if o == lexdb_sql.OID_BOOL { k = PK_BOOL }
    else if o == lexdb_sql.OID_NUMERIC { k = PK_NUM }
    else if o == lexdb_sql.OID_DATE { k = PK_DATE }
    else if o == lexdb_sql.OID_TIME { k = PK_TIME }
    else if o == lexdb_sql.OID_TS { k = PK_TS }
    else if o == lexdb_sql.OID_TSTZ { k = if c.typ.len == lexdb_sql.TSZ_LEN || c.typ.len == lexdb_sql.TSZ_TSQL { PK_TSZ } else { PK_TSTZ } }
    else if o == lexdb_sql.OID_FLOAT8 { k = PK_F8 }
    else if o == lexdb_sql.OID_FLOAT4 { k = PK_F4 }
    else if o == lexdb_sql.OID_UUID { k = PK_UUID }
    else if o == lexdb_sql.OID_BYTEA { k = PK_BYTEA }
    return k
}

pub fn fixedSize(k: byte): int {
    if k == PK_INT || k == PK_TIME || k == PK_TS || k == PK_TSTZ || k == PK_F8 { return 8 }
    if k == PK_INT4 || k == PK_DATE || k == PK_F4 { return 4 }
    if k == PK_INT2 || isVarKind(k) { return 2 }
    if k == PK_BOOL { return 1 }
    return 0
}

pub fn isIntKind(k: byte): bool { return k == PK_INT || k == PK_INT4 || k == PK_INT2 }

// A place holding a word: an integer, or (9.113) a date, a time, a
// timestamp, a timestamptz, a double's or a real's bits.
pub fn isWordKind(k: byte): bool { return isIntKind(k) || (k >= PK_DATE && k <= PK_F4) }

// A place holding a variable-length value: its end in the fixed part.
pub fn isVarKind(k: byte): bool { return k == PK_NUM || k == PK_TEXT || k == PK_UUID || k == PK_BYTEA }

// The word of v for a place of word kind k; None: v is not of k's kind, or
// does not fit its width.
fn wordOf(v: &Val, k: byte): Option[int] {
    match v {
        Val.Int(x) { if isIntKind(k) && intFits(k, x) { return Some(x) } }
        Val.Date(x) { if k == PK_DATE && x >= -2147483648 && x <= 2147483647 { return Some(x) } }
        Val.Time(x) { if k == PK_TIME { return Some(x) } }
        Val.Ts(x) { if k == PK_TS { return Some(x) } }
        Val.Tstz(x) { if k == PK_TSTZ { return Some(x) } }
        Val.Float(x) { if k == PK_F8 { return Some(math.bitsOf(x)) } }
        Val.Real(x) { if k == PK_F4 { return Some(math.bitsOf32Int(x)) } }
        else {}
    }
    return None
}

// The value of word w at a place of word kind k.
pub fn wordVal(k: byte, w: int): Val {
    if k == PK_DATE { return Val.Date(w) }
    if k == PK_TIME { return Val.Time(w) }
    if k == PK_TS { return Val.Ts(w) }
    if k == PK_TSTZ { return Val.Tstz(w) }
    if k == PK_F8 { return Val.Float(math.fromBits(w)) }
    if k == PK_F4 { return Val.Real(math.fromBits32Int(w & 0xFFFFFFFF)) }
    return Val.Int(w)
}

// A byte's value as a hex digit (0 to 15), -1 for none.
fn hexDigit(c: byte): int {
    if c >= '0' && c <= '9' { return int(c - '0') }
    if c >= 'a' && c <= 'f' { return int(c - 'a') + 10 }
    if c >= 'A' && c <= 'F' { return int(c - 'A') + 10 }
    return -1
}

// A canonical uuid's 16 bytes, and back.
pub fn uuidBytes(u: &str): str {
    var b: []byte = withCapacity(16)
    var i = 0
    while i + 1 < len(u) {
        if u[i] == '-' {
            i += 1
            continue
        }
        append(mut &b, byte(hexDigit(u[i]) * 16 + hexDigit(u[i + 1])))
        i += 2
    }
    return strFromBytes(&b)
}

pub fn uuidText(raw: &str): str {
    let h = lexdb_sql.bytesHex(raw)
    return h[2..10] + "-" + h[10..14] + "-" + h[14..18] + "-" + h[18..22] + "-" + h[22..34]
}

// The bytes v takes in the variable part at a place of variable kind k;
// None: v is not of k's kind.
fn varBytes(v: &Val, k: byte): Option[str] {
    match v {
        Val.Text(x) { if k == PK_TEXT { return Some(x.clone()) } }
        Val.Num(d) { if k == PK_NUM { return Some(d.toBin()) } }
        Val.Uuid(u) { if k == PK_UUID { return Some(uuidBytes(&u)) } }
        Val.Bytes(x) { if k == PK_BYTEA { return Some(x.clone()) } }
        Val.Tsz(u, o) { if k == PK_TSZ { return Some(tszBytes(u, o)) } }
        else {}
    }
    return None
}

// A timestamp with its offset as a place holds it: the instant (8 bytes) and the offset in minutes (2), little-endian.
fn tszBytes(u: int, o: int): str {
    var b: []byte = withCapacity(10)
    binary.appendU64LE(mut &b, u)
    binary.appendU16LE(mut &b, o & 0xFFFF)
    return strFromBytes(&b)
}

// The value of a variable place of kind k: s[a..b].
pub fn varVal(k: byte, s: &str, a: int, b: int): Result[Val, DbErr] {
    if k == PK_TEXT { return Ok(Val.Text(s[a..b].clone())) }
    if k == PK_BYTEA { return Ok(Val.Bytes(s[a..b].clone())) }
    if k == PK_UUID {
        if b - a == 10 { return tszVal(s, a, b) }
        if b - a != 16 { return Err(lexdb_base.corrupt("a uuid value in a row")) }
        return Ok(Val.Uuid(uuidText(&s[a..b])))
    }
    match Decimal.fromBin(s, a, b - a) {
        Ok(d) { return Ok(Val.Num(d)) }
        Err(_) { return Err(lexdb_base.corrupt("a numeric value in a row")) }
    }
}

// A timestamp with its offset at s[a..b] (10 bytes): the instant, the offset in minutes.
fn tszVal(s: &str, a: int, b: int): Result[Val, DbErr] {
    if b - a != 10 { return Err(lexdb_base.corrupt("a timestamp with a time zone in a row")) }
    return Ok(Val.Tsz(binary.readI64LEStr(s, a), binary.readI16LEStr(s, a + 8)))
}

// Whether integer v fits a place of kind k.
fn intFits(k: byte, v: int): bool {
    if k == PK_INT { return true }
    if k == PK_INT4 { return v >= -2147483648 && v <= 2147483647 }
    if k == PK_INT2 { return v >= -32768 && v <= 32767 }
    return false
}

// The word of kind k at s[at..] (by its width; signed).
pub fn readIntK(s: &str, at: int, k: byte): int {
    let w = fixedSize(k)
    if w == 8 { return binary.readI64LEStr(s, at) }
    if w == 4 { return binary.readI32LEStr(s, at) }
    return binary.readI16LEStr(s, at)
}

// The table's row in its current layout; None when the row does not fit it
// (a value of another kind than its place's, a long text, over 255 places)
// or the table has no current layout yet (a schema change not yet stored:
// syncLayouts).
pub fn encodeFixed(r: &Rows, places: &[]Val): Option[str] {
    let nl = len(r.layouts)
    if nl == 0 || nl > 65536 { return None }
    let kinds = &r.layouts[nl - 1]
    let n = len(kinds)
    if n > 255 || len(places) != n { return None }
    // the table as it stands must have this layout as its current one
    if !kindsFit(r, kinds) { return None }
    // first the values checked against their places, and the variable
    // part's size; a numeric's or a uuid's bytes made once (conv)
    var fixed = 3 + (n + 7) / 8
    var varLen = 0
    var conv: []str = []
    for p in 0..n {
        let k = kinds[p]
        match places[p] {
            Val.Null { if isVarKind(k) { fixed += 2 } else { fixed += fixedSize(k) } }
            Val.Bool(_) {
                if k != PK_BOOL { return None }
                fixed += 1
            }
            Val.Text(x) {
                if k != PK_TEXT || len(x) >= LONG { return None }
                varLen += len(x)
                fixed += 2
            }
            Val.Bytes(x) {
                if k != PK_BYTEA || len(x) >= LONG { return None }
                varLen += len(x)
                fixed += 2
            }
            else {
                if isWordKind(k) {
                    match wordOf(&places[p], k) {
                        Some(_) { fixed += fixedSize(k) }
                        None { return None }
                    }
                } else if isVarKind(k) {
                    match varBytes(&places[p], k) {
                        Some(x) {
                            if len(x) >= LONG { return None }
                            varLen += len(x)
                            fixed += 2
                            append(mut &conv, x)
                        }
                        None { return None }
                    }
                } else {
                    return None             // a value its place does not hold: the tagged form
                }
            }
        }
    }
    if varLen > 65535 { return None }
    var b: []byte = withCapacity(fixed + varLen)
    append(mut &b, FIXED)
    binary.appendU16LE(mut &b, nl - 1)
    let bits0 = len(b)
    for i in 0..(n + 7) / 8 { append(mut &b, byte(0)) }
    var end = 0
    var ci = 0
    for p in 0..n {
        let k = kinds[p]
        if isNullVal(&places[p]) { b[bits0 + p / 8] = b[bits0 + p / 8] | byte(1 << (p % 8)) }
        if isWordKind(k) {
            var v = 0
            match wordOf(&places[p], k) {
                Some(w) { v = w }
                None {}
            }
            let w = fixedSize(k)
            if w == 8 { binary.appendU64LE(mut &b, v) }
            else if w == 4 { binary.appendU32LE(mut &b, v & 0xFFFFFFFF) }
            else { binary.appendU16LE(mut &b, v & 0xFFFF) }
        } else if k == PK_BOOL {
            append(mut &b, match places[p] { Val.Bool(x) { if x { byte(1) } else { byte(0) } } else { byte(0) } })
        } else if isVarKind(k) {
            match places[p] {
                Val.Null {}
                Val.Text(x) { end += len(x) }
                Val.Bytes(x) { end += len(x) }
                else {
                    end += len(conv[ci])
                    ci += 1
                }
            }
            binary.appendU16LE(mut &b, end)
        }
    }
    ci = 0
    for p in 0..n {
        if !isVarKind(kinds[p]) { continue }
        match places[p] {
            Val.Null {}
            Val.Text(x) { appendStr(mut &b, x) }
            Val.Bytes(x) { appendStr(mut &b, x) }
            else {
                appendStr(mut &b, conv[ci])
                ci += 1
            }
        }
    }
    return Some(strFromBytes(&b))
}

// Whether kinds is the table's current layout (placeKinds), without making
// placeKinds' array: every column's place of its kind, and every other
// place none.
pub fn kindsFit(r: &Rows, kinds: &[]byte): bool {
    if len(kinds) != r.width { return false }
    var none = 0
    for k in kinds { if k == PK_NONE { none += 1 } }
    var virt = 0
    for i in 0..len(r.cols) { if r.cols[i].genKind == lexdb_sql.GEN_VIRTUAL { virt += 1 } }
    if none != len(kinds) - len(r.cols) + virt { return false }
    for i in 0..len(r.cols) {
        let k = placeKind(&r.cols[i])
        let have = kinds[if len(r.slots) == 0 { i } else { r.slots[i] }]
        if have != k { return false }
    }
    return true
}

// The layout of a row in the fixed form, of its table's lays.
pub fn layOf(s: &str, lays: &[]FixedLay): Result[int, DbErr] {
    if len(s) < 3 { return Err(lexdb_base.corrupt("a row's layout number")) }
    let id = binary.readU16LEStr(s, 1)
    if id >= len(lays) { return Err(lexdb_base.corrupt("a row's layout number")) }
    if lays[id].v0 > len(s) { return Err(lexdb_base.corrupt("a row's fixed part")) }
    return Ok(id)
}

// The value of kind k at place p of row s in layout lay (not NULL).
pub fn fixedVal(s: &str, p: int, k: byte, lay: &FixedLay): Result[Val, DbErr] {
    let at = lay.off[p]
    if isWordKind(k) { return Ok(wordVal(k, readIntK(s, at, k))) }
    if k == PK_BOOL { return Ok(Val.Bool(s[at] == 1)) }
    let end = binary.readU16LEStr(s, at)
    let start = if lay.prev[p] < 0 { 0 } else { binary.readU16LEStr(s, lay.prev[p]) }
    if start > end || lay.v0 + end > len(s) { return Err(lexdb_base.corrupt("a row's variable part")) }
    return varVal(k, s, lay.v0 + start, lay.v0 + end)
}

// A fixed row's text at place p (its kind PK_TEXT, not NULL): a view of
// its bytes.
pub fn fixedText(s: &str, p: int, lay: &FixedLay): Result[&str, DbErr] {
    let end = binary.readU16LEStr(s, lay.off[p])
    let start = if lay.prev[p] < 0 { 0 } else { binary.readU16LEStr(s, lay.prev[p]) }
    if start > end || lay.v0 + end > len(s) { return Err(lexdb_base.corrupt("a row's variable part")) }
    return Ok(&s[lay.v0 + start..lay.v0 + end])
}

// decodeRowNeed for a row in the fixed layout.
pub fn decodeFixed(s: &str, n: int, need: &[]bool, missing: &[]Val, lays: &[]FixedLay): Result[[]Val, DbErr] {
    let lay = &lays[try layOf(s, lays)]
    let np = len(lay.kinds)
    let some = len(need) > 0
    var out: []Val = array(n, Val.Null)
    for p in 0..n {
        if p >= np {
            if p < len(missing) { out[p] = missing[p].clone() }
            continue
        }
        if some && !need[p] { continue }
        let k = lay.kinds[p]
        if k == PK_NONE || (int(s[lay.bm + p / 8]) >> (p % 8)) & 1 == 1 { continue }
        out[p] = try fixedVal(s, p, k, lay)
    }
    return Ok(out)
}

// Whether s is a row in a fixed layout (not tagged; 9.115).
pub fn isFixedRow(s: &str): bool { return len(s) > 0 && s[0] == FIXED }

// The layout of rows with these places' kinds.
pub fn layOfKinds(kinds: &[]byte): FixedLay {
    let np = len(kinds)
    var ks: []byte = []
    for k in kinds { append(mut &ks, k) }
    let bm = 3
    var at = bm + (np + 7) / 8
    var off: []int = array(np, 0)
    var prev: []int = array(np, -1)
    var lastVar = -1
    for p in 0..np {
        off[p] = at
        let k = kinds[p]
        if isVarKind(k) {
            prev[p] = lastVar
            lastVar = at
        }
        at += fixedSize(k)
    }
    return FixedLay{kinds: ks, off: off, prev: prev, bm: bm, v0: at}
}

// Rows written in the fixed layout when every value fits it (9.50); a test
// turns this off to write the tagged form and compare the two.
var fixedRows: bool = true

pub fn setFixedRows(on: bool) { fixedRows = on }

// The values rows written before a column was added have for it, by
// place ([] when all are NULL).
pub fn placesMissing(r: &Rows): []Val {
    var any = false
    for i in 0..len(r.cols) { if !isNullVal(&r.cols[i].missing) { any = true } }
    var out: []Val = []
    if !any { return out }
    out = array(r.width, Val.Null)
    for i in 0..len(r.cols) { out[if len(r.slots) == 0 { i } else { r.slots[i] }] = r.cols[i].missing.clone() }
    return out
}

// need ([] all) of the table's columns as of the row's places.
pub fn placesNeeded(r: &Rows, need: &[]bool): []bool {
    var out: []bool = []
    if len(r.slots) == 0 || len(need) == 0 {
        for x in need { append(mut &out, x) }
        return out
    }
    out = array(r.width, false)
    for i in 0..len(r.slots) { out[r.slots[i]] = need[i] }
    return out
}

// ---- column leaf bodies (T_CLEAF, 9.112)
//
// A column leaf's body is \xff\xff (no row body starts so: a key is at most
// MAX_KEY bytes), a u32 of its keys' bytes K, its keys as a lazy body holds
// them (a u16 key length, a u16 0, the key), then its columns (lexdb_cols).

pub const CB: int = 6
pub const PAGE: int = 4096

// The bytes a leaf's keys from..to take front coded on a T_CLEAF page.
fn colKeysSize(keys: &[]&str, from: int, to: int): int {
    var size = 0
    for i in from..to {
        let k = &keys[i]
        let c = if i == from { 0 } else { commonLen(&keys[i - 1], &k) }
        size += varLen(c) + varLen(len(k) - c) + len(k) - c
    }
    return size
}

// A column leaf's body: keys from (lazy body form, kb bytes) and columns cols.
fn colBodyOf(keys: &[]byte, kb: int, cols: &str): str {
    var out: []byte = withCapacity(CB + kb + len(cols))
    append(mut &out, byte(0xff))
    append(mut &out, byte(0xff))
    binary.appendU32LE(mut &out, kb)
    appendStr(mut &out, strFromBytes(&keys[0..kb]))
    appendStr(mut &out, cols.toStr())
    return strFromBytes(&out)
}

// Leaf keys and vals as a column leaf's body: None when the rows do not all
// encode (lexdb_cols.encodeRows) or the page would not hold them.
pub fn colBody(keys: &[]&str, vals: &[]&str, spec: &Spec): Option[str] {
    return colBodyRange(keys, vals, 0, len(keys), spec)
}

// colBody of the entries from..to.
pub fn colBodyRange(keys: &[]&str, vals: &[]&str, from: int, to: int, spec: &Spec): Option[str] {
    var conv = false
    let got = colBodyRangeK(keys, vals, from, to, spec, lexdb_cols.checking(), mut &conv)
    if conv { lexdb_cols.noteConverted() }
    return got
}

// colBodyRange as a kernel (par.map): check is lexdb_cols.checking(); conv
// set when the rows were converted (9.114), which the caller counts
// (lexdb_cols.noteConverted).
pub fn colBodyRangeK(keys: &[]&str, vals: &[]&str, from: int, to: int, spec: &Spec,
                     check: bool, conv: mut &bool): Option[str] {
    let cnt = to - from
    if cnt <= 0 { return None }
    var rows: []&str = withCapacity(cnt)
    for i in from..to { append(mut &rows, vals[i]) }
    var cv: []str = []
    let got = lexdb_cols.encodeCheckedK(&rows, spec, check, mut &cv)
    var cols = ""
    if got.isSome() {
        cols = got.unwrap()
    } else {
        cv = []
        match lexdb_cols.encodeAny(&rows) {
            Some(x) { cols = x }
            None { return None }
        }
    }
    if len(cv) > 0 { conv = true }
    if 22 + colKeysSize(keys, from, to) + len(cols) > PAGE { return None }
    var kb = 0
    for i in from..to { kb += 4 + len(keys[i]) }
    var keyBytes: []byte = withCapacity(kb)
    for i in from..to {
        let k = &keys[i]
        binary.appendU16LE(mut &keyBytes, len(k))
        binary.appendU16LE(mut &keyBytes, 0)
        appendStr(mut &keyBytes, k)
    }
    return Some(colBodyOf(&keyBytes, kb, &cols))
}

// The bytes a column leaf of the entries from..to would take on its page
// (its header, keys and columns), -1 when the rows do not encode.
pub fn colSize(keys: &[]&str, vals: &[]&str, from: int, to: int, spec: &Spec): int {
    if to <= from { return -1 }
    var rows: []&str = withCapacity(to - from)
    for i in from..to { append(mut &rows, vals[i]) }
    match lexdb_cols.encodeRows(&rows, spec) {
        Some(cols) { return 22 + colKeysSize(keys, from, to) + len(cols) }
        None {
            match lexdb_cols.encodeAny(&rows) {
                Some(cols) { return 22 + colKeysSize(keys, from, to) + len(cols) }
                None { return -1 }
            }
        }
    }
}

// The bytes two keys share at the start (front coding), and the bytes a
// varint of x takes: page's front coding calls these too.
pub fn commonLen(a: &str, b: &str): int {
    let m = if len(a) < len(b) { len(a) } else { len(b) }
    var n = 0
    while n < m && a[n] == b[n] { n += 1 }
    return n
}

pub fn varLen(x: int): int { return if x < 0x80 { 1 } else if x < 0x4000 { 2 } else { 3 } }

// A table's row as stored: its values at their places, NULL at a dropped
// column's.
pub fn encodeRowOf(r: &Rows, row0: &[]Val): str {
    // a virtual column's value is not kept: NULL at its place
    var virt = false
    for i in 0..len(r.cols) { if r.cols[i].genKind == lexdb_sql.GEN_VIRTUAL { virt = true } }
    if virt {
        var blank: []Val = []
        for i in 0..len(row0) { append(mut &blank, if r.cols[i].genKind == lexdb_sql.GEN_VIRTUAL { Val.Null } else { row0[i].clone() }) }
        return encodeRowOfPlain(r, &blank)
    }
    return encodeRowOfPlain(r, row0)
}

fn encodeRowOfPlain(r: &Rows, row: &[]Val): str {
    if fixedRows {
        // the fixed layout (9.50) when every value fits it
        if len(r.slots) == 0 {
            match encodeFixed(r, row) {
                Some(f) { return f }
                None {}
            }
        } else {
            var ps: []Val = array(r.width, Val.Null)
            for i in 0..len(r.slots) { ps[r.slots[i]] = row[i].clone() }
            match encodeFixed(r, &ps) {
                Some(f) { return f }
                None {}
            }
        }
    }
    if len(r.slots) == 0 { return encodeRow(row) }
    var places: []Val = array(r.width, Val.Null)
    for i in 0..len(r.slots) { places[r.slots[i]] = row[i].clone() }
    return encodeRow(&places)
}

pub fn encodeRow(row: &[]Val): str {
    var long = false
    for v in row {
        match v {
            Val.Text(s) { if len(s) >= LONG { long = true } }
            else {}
        }
    }
    // a row whose first value is a time would begin with its tag, 8, which
    // is FIXED: in the long form instead, which begins with 6 (9.115)
    if len(row) > 0 {
        match row[0] {
            Val.Time(_) { long = true }
            else {}
        }
    }
    if long { return encLong(row) }
    var b = ""
    for v in row { encVal(mut &b, &v) }
    return b
}

// A value in a row: its tag and its bytes (a text of any length in place).
// Tags 7 to 10 are a date, time, timestamp and timestamptz (8 bytes), 11 an
// interval (months, days, microseconds: 24 bytes) (9.76).
fn encVal(b: mut &str, v: &Val) {
    match v {
        Val.Null { b.addByte(0) }
        Val.Int(n) {
            b.addByte(1)
            binary.addU64LE(b, n)
        }
        Val.Bool(x) {
            b.addByte(2)
            b.addByte(if x { 1 } else { 0 })
        }
        Val.Num(d) {
            b.addByte(3)
            let s = d.toStr()
            binary.addU32LE(b, len(s))
            b += &s
        }
        Val.Text(s) {
            b.addByte(4)
            binary.addU32LE(b, len(s))
            b += &s
        }
        Val.Date(n) {
            b.addByte(7)
            binary.addU64LE(b, n)
        }
        Val.Time(n) {
            b.addByte(8)
            binary.addU64LE(b, n)
        }
        Val.Ts(n) {
            b.addByte(9)
            binary.addU64LE(b, n)
        }
        Val.Tstz(n) {
            b.addByte(10)
            binary.addU64LE(b, n)
        }
        Val.Tsz(n, o) {
            b.addByte(16)
            binary.addU64LE(b, n)
            binary.addU16LE(b, o & 0xFFFF)
        }
        Val.Ival(iv) {
            b.addByte(11)
            binary.addU64LE(b, iv.months)
            binary.addU64LE(b, iv.days)
            binary.addU64LE(b, iv.us)
        }
        Val.Uuid(u) {
            b.addByte(12)
            b += &(uuidBytes(&u))
        }
        Val.Bytes(x) {
            b.addByte(13)
            binary.addU32LE(b, len(x))
            b += &x
        }
        Val.Float(x) {
            b.addByte(14)
            binary.addU64LE(b, math.bitsOf(x))
        }
        Val.Real(x) {
            b.addByte(15)
            binary.addU32LE(b, math.bitsOf32Int(x))
        }
        Val.Reg(o, _) { encVal(b, &Val.Int(o)) }      // stored as its OID
    }
}

// A value of tag 7 to 15 in a row at s[at..]: a date or time kind, a
// uuid, a bytea, a double precision or a real.
pub fn timeVal(s: &str, at: int, tag: byte): Val {
    if tag == 12 { return Val.Uuid(uuidText(&s[at..at + 16])) }
    if tag == 16 { return Val.Tsz(binary.readI64LEStr(s, at), binary.readI16LEStr(s, at + 8)) }
    if tag == 13 { return Val.Bytes(s[at + 4..at + 4 + binary.readU32LEStr(s, at)].clone()) }
    if tag == 14 { return Val.Float(math.fromBits(binary.readI64LEStr(s, at))) }
    if tag == 15 { return Val.Real(math.fromBits32Int(binary.readU32LEStr(s, at))) }
    let x = binary.readI64LEStr(s, at)
    if tag == 7 { return Val.Date(x) }
    if tag == 8 { return Val.Time(x) }
    if tag == 9 { return Val.Ts(x) }
    if tag == 10 { return Val.Tstz(x) }
    return Val.Ival(lexdb_time.Ival{months: x, days: binary.readI64LEStr(s, at + 8), us: binary.readI64LEStr(s, at + 16)})
}

// The bytes after its tag a value of tag takes in a row at s[at..]; -1 for
// a tag that is not one.
pub fn valSize(s: &str, at: int, tag: byte): int {
    if tag == 0 { return 0 }
    if tag == 1 || (tag >= 7 && tag <= 10) { return 8 }
    if tag == 2 { return 1 }
    if tag == 3 || tag == 4 { return 4 + binary.readU32LEStr(s, at) }
    if tag == 5 { return 4 }
    if tag == 11 { return 24 }
    if tag == 12 { return 16 }
    if tag == 13 { return 4 + binary.readU32LEStr(s, at) }
    if tag == 14 { return 8 }
    if tag == 15 { return 4 }
    if tag == 16 { return 10 }
    return -1
}

fn encLong(row: &[]Val): str {
    var b = ""
    b.addByte(6)
    binary.addU32LE(mut &b, len(row))
    for v in row {
        match v {
            Val.Text(s) {
                if len(s) >= LONG {
                    b.addByte(5)
                    binary.addU32LE(mut &b, len(s))
                } else {
                    encVal(mut &b, &v)
                }
            }
            else { encVal(mut &b, &v) }
        }
    }
    for v in row {
        match v {
            Val.Text(s) { if len(s) >= LONG { b += &s } }
            else {}
        }
    }
    return b
}

// Whether a large row's first bytes hold all the columns used: all its
// columns before its long texts, and none of those texts used.
pub fn fitsIn(p: &str, n: int, need: &[]bool): bool {
    if len(need) == 0 || len(p) < 5 || p[0] != 6 { return false }
    let cols = binary.readU32LEStr(p, 1)
    var at = 5
    for i in 0..cols {
        if at >= len(p) { return false }
        let tag = p[at]
        at += 1
        if tag == 5 {
            if i < n && need[i] { return false }
            at += 4
        } else {
            if (tag == 3 || tag == 4 || tag == 13) && at + 4 > len(p) { return false }
            let sz = valSize(p, at, tag)
            if sz < 0 { return false }
            at += sz
        }
        if at > len(p) { return false }
    }
    return true
}

// A stored row's columns before its long texts: the bytes a large row
// keeps in its leaf (lexdb_store.putRow), 0 for a row with no long text.
pub fn rowHead(s: &str): int {
    if len(s) < 5 || s[0] != 6 { return 0 }
    let cols = binary.readU32LEStr(s, 1)
    var at = 5
    for i in 0..cols {
        let tag = s[at]
        at += 1
        at += valSize(s, at, tag)
    }
    return at
}

// A row's values; need: the columns used ([] all), the others NULL and not
// decoded (9.31).
// lays: the row's table's layouts (Table.lays), for a row in the fixed form.
pub fn decodeRowNeed(s: &str, n: int, need: &[]bool, missing: &[]Val, lays: &[]FixedLay): Result[[]Val, DbErr] {
    if len(s) > 0 && s[0] == FIXED { return decodeFixed(s, n, need, missing, lays) }
    var out: []Val = []
    var at = 0
    let some = len(need) > 0
    // a row with long texts: its column count, and where each long text is
    var cols = n
    let long = len(s) > 0 && s[0] == 6
    if long {
        cols = binary.readU32LEStr(s, 1)
        at = 5
    }
    var longAt: []int = []               // the long texts' columns, in order
    var longLen: []int = []
    for i in 0..n {
        if i >= cols || (!long && at >= len(s)) {
            // a column added after the row was written: its default then
            append(mut &out, if i < len(missing) { missing[i].clone() } else { Val.Null })
            continue
        }
        let tag = s[at]
        at += 1
        if tag == 5 {
            append(mut &longAt, i)
            append(mut &longLen, binary.readU32LEStr(s, at))
            at += 4
            append(mut &out, Val.Null)
            continue
        }
        if some && !need[i] {
            let sz = valSize(s, at, tag)
            if sz < 0 { return Err(lexdb_base.corrupt("a row's value tag")) }
            at += sz
            append(mut &out, Val.Null)
            continue
        }
        if tag == 0 {
            append(mut &out, Val.Null)
        } else if tag == 1 {
            append(mut &out, Val.Int(binary.readI64LEStr(s, at)))
            at += 8
        } else if tag == 2 {
            append(mut &out, Val.Bool(s[at] == 1))
            at += 1
        } else if tag == 3 || tag == 4 {
            let l = binary.readU32LEStr(s, at)
            let t = s[at + 4..at + 4 + l]
            at += 4 + l
            if tag == 4 {
                append(mut &out, Val.Text(t.clone()))
            } else {
                match Decimal.parse(&t) {
                    Ok(d) { append(mut &out, Val.Num(d)) }
                    Err(_) { return Err(lexdb_base.corrupt("a numeric value in a row")) }
                }
            }
        } else if tag >= 7 && tag <= 16 {
            append(mut &out, timeVal(s, at, tag))
            at += valSize(s, at, tag)
        } else {
            return Err(lexdb_base.corrupt("a row's value tag"))
        }
    }
    if long {
        // the columns not read when the row has more than the table (none yet)
        for i in n..cols {
            let tag = s[at]
            at += 1
            if tag == 5 {
                append(mut &longAt, i)
                append(mut &longLen, binary.readU32LEStr(s, at))
                at += 4
            } else { at += valSize(s, at, tag) }
        }
        for k in 0..len(longAt) {
            let l = longLen[k]
            let i = longAt[k]
            if i < n && (!some || need[i]) {
                if at + l > len(s) { return Err(lexdb_base.corrupt("a row's long text")) }
                out[i] = Val.Text(s[at..at + l].clone())
            }
            at += l
        }
    }
    return Ok(out)
}

// ---- Batches (design/lexdb.md 9.47)
//
// A query reads a table's rows in batches: each column used decoded into an
// integer or boolean array (with NULL flags) or an array of values, as a
// Projection says, from a leaf in place (decodeRun) or from a stored row
// (decodeRow). The row format and what a reader needs stay here; the
// operators run over the batches in the executor.

pub const BROWS: int = 1024

// decodeRun's (and the lazy runs') answer for a column leaf whose first row
// holds a value stored apart: the caller reads that row from the store.
pub const APART: int = -3

pub const BK_INT: int = 0    // a column's kind in a batch: an integer ...
pub const BK_BOOL: int = 1   // ... a boolean (0, 1) ...
pub const BK_VAL: int = 2    // ... or any other, as values
pub const BK_NONE: int = -1  // a query's column not in the batch (of another table)
// ... or a text (text, varchar): its bytes in the batch's txt[c], the row's
// v[r] where (start << 24 | length); a value longer than TEXT_MAX does not
// fit (put's false: the batch gives way). Only where the operator asks for
// it (textColKind): its readers take views (textAt), no value per row.
pub const BK_TEXT: int = 3
pub const TEXT_MAX: int = 16777215
// ... or a numeric(p, s) of p at most DEC_MAX_P as its units, the value
// times 10^s, in an integer: BK_DEC + s (decKind). Only where the
// operator asks for it (decColKind); every value read must have display
// scale s and fit, or the batch gives way to the row path (put's false).
pub const BK_DEC: int = 16
pub const DEC_MAX_P: int = 18

pub fn decKind(s: int): int { return BK_DEC + s }
pub fn isDecKind(k: int): bool { return k >= BK_DEC }
pub fn decScale(k: int): int { return k - BK_DEC }

// A column's batch kind when the operator takes numerics as units: a
// numeric(p, s) of 0 < p <= DEC_MAX_P is BK_DEC + s (its values all have
// display scale s: coerce quantizes them), any other as colKind.
pub fn decColKind(c: &lexdb_sql.ColDef): int {
    let t = c.typ
    if t.oid == lexdb_sql.OID_NUMERIC && t.prec > 0 && t.prec <= DEC_MAX_P && t.scale >= 0 && t.scale <= t.prec {
        return decKind(t.scale)
    }
    return colKind(c)
}

// 10^k for 0 <= k <= 18.
pub fn pow10i(k: int): int {
    var r = 1
    for i in 0..k { r *= 10 }
    return r
}

// d's units at scale s (d times 10^s) when d's display scale is s and they
// fit an integer; None otherwise.
pub fn decUnits(d: &Decimal, s: int): Option[int] {
    if d.scale() != s || s > DEC_MAX_P { return None }
    let c = d.coefficient()
    if c == 0 { return Some(0) }
    let sh = d.exponent() + s
    if sh < 0 || sh > DEC_MAX_P { return None }
    let lim = u128(0x7fffffffffffffff) / u128(pow10i(sh))
    if c > lim { return None }
    let u = int(c) * pow10i(sh)
    return Some(if d.isNeg() { -u } else { u })
}

// The value of units u at scale s (display scale s).
pub fn decVal(u: int, s: int): Val { return Val.Num(Decimal.fromUnits(u, s)) }

// A column of a batch: its integers or booleans, and its NULLs.
pub type BVec = record {
    pub v: []int
    pub nul: []bool
}

// A batch of rows: per column used its vectors, per column of values its
// values (a slot per row, NULL too when the batch is used again).
pub type Batch = record {
    pub cols: []BVec
    pub vals: [][]Val
    pub txt: []str          // per BK_TEXT column: its rows' bytes (each other column's "")
    pub n: int
}

// A batch of a SELECT's output rows (design/lexdb.md 9.101), as the
// batch scanned holds them: no row made, no value per integer. Output o
// of row j (0 <= j < n): src[o] >= 0, column src[o] of the batch at row
// idx[j] (cols: its integers or booleans and NULLs; vals: a BK_VAL
// column's values); -1, ex[o] at j (an expression's values). kinds[o]:
// BK_INT, BK_BOOL or BK_VAL. The pipeline makes it (lexdb_pipe), the
// protocols write it.
pub type OutBatch = record {
    pub n: int
    pub kinds: []int
    pub src: []int
    pub idx: []int
    pub cols: []BVec
    pub vals: [][]Val
    pub txt: []str          // a BK_TEXT column's bytes (Batch.txt)
    pub ex: []BVec
}

pub fn noOutBatch(): OutBatch { return OutBatch{n: 0, kinds: [], src: [], idx: [], cols: [], vals: [], txt: [], ex: []} }

// Output o's text at row j (its kind BK_TEXT, not NULL), a view.
pub fn obText(ob: &OutBatch, o: int, j: int): &str {
    let c = ob.src[o]
    let w = ob.cols[c].v[ob.idx[j]]
    let a = w >> 24
    return &ob.txt[c][a..a + (w & TEXT_MAX)]
}

// What a reader needs of a table's rows: per column its batch kind, the
// places used in order and each place's column, the last one's end (a
// tagged row is read to it), the values rows written before a column was
// added have for it, and the ranges a place's words must be in for a row to
// be kept (rangeConditions: place, kind, least, greatest, each).
pub type Projection = record {
    pub kinds: []int
    pub needCol: []bool
    pub placeCol: []int
    pub usedP: []int
    pub stopAt: int
    pub missing: []Val
    pub needP: []bool
    pub width: int
    pub ranges: []int
}

// A projection of a table's rows: kinds and needCol per column, slots the
// column's place, width the places; where each used column is in a stored
// row follows from them.
pub fn projectionOf(kinds: []int, needCol: []bool, slots: &[]int, width: int, missing: []Val, needP: []bool): Projection {
    var placeCol: []int = array(width, -1)
    for i in 0..len(kinds) {
        if needCol[i] { placeCol[if len(slots) == 0 { i } else { slots[i] }] = i }
    }
    var usedP: []int = []
    for pl in 0..width { if placeCol[pl] >= 0 { append(mut &usedP, pl) } }
    let stopAt = if len(usedP) == 0 { 0 } else { usedP[len(usedP) - 1] + 1 }
    return Projection{kinds: kinds, needCol: needCol, placeCol: placeCol, usedP: usedP, stopAt: stopAt,
                      missing: missing, needP: needP, width: width, ranges: []}
}

pub fn emptyProjection(): Projection {
    return Projection{kinds: [], needCol: [], placeCol: [], usedP: [], stopAt: 0, missing: [], needP: [], width: 0, ranges: []}
}

pub fn noRows(): Batch { return Batch{cols: [], vals: [], txt: [], n: 0} }

pub fn bvec(m: int): BVec { return BVec{v: array(m, 0), nul: array(m, false)} }

// A column's kind in a batch where the operator reads texts as BK_TEXT:
// a text or varchar is BK_TEXT, any other as colKind.
pub fn textColKind(c: &lexdb_sql.ColDef): int {
    let o = c.typ.oid
    if o == lexdb_sql.OID_TEXT || o == lexdb_sql.OID_VARCHAR || o == lexdb_sql.OID_BPCHAR { return BK_TEXT }
    return colKind(c)
}

// Whether column c of b, read as a value (not an integer, boolean or
// units column), holds texts (BK_TEXT): its rows' bytes, no values.
pub fn isTextCol(b: &Batch, c: int): bool { return len(b.vals[c]) == 0 && len(b.cols[c].nul) > 0 }

// A column's kind in the pipeline's batches (lexdb_pipe): a text as
// BK_TEXT; with dec, a numeric as its units (decColKind); else colKind.
pub fn pipeKind(c: &lexdb_sql.ColDef, dec: bool): int {
    if dec {
        let k = decColKind(c)
        if k != BK_VAL { return k }
    }
    return textColKind(c)
}

// Row r of BK_TEXT column c of b (not NULL), a view of its bytes.
pub fn textAt(b: &Batch, c: int, r: int): &str {
    let w = b.cols[c].v[r]
    let a = w >> 24
    return &b.txt[c][a..a + (w & TEXT_MAX)]
}

// Row r of BK_TEXT column c of b set to text t (appended to the column's
// bytes); false: longer than TEXT_MAX.
pub fn putText(b: mut &Batch, c: int, r: int, t: &str): bool {
    if len(t) > TEXT_MAX { return false }
    let a = len(b.txt[c])
    b.txt[c] += t
    b.cols[c].v[r] = (a << 24) | len(t)
    return true
}

// A column's kind in a batch, from its type.
pub fn colKind(c: &lexdb_sql.ColDef): int {
    let o = c.typ.oid
    if o == lexdb_sql.OID_INT2 || o == lexdb_sql.OID_INT4 || o == lexdb_sql.OID_INT8 { return BK_INT }
    if o == lexdb_sql.OID_BOOL { return BK_BOOL }
    return BK_VAL
}

// A batch of a projection's columns, cap rows each.
pub fn newBatch(bp: &Projection, cap: int): Batch {
    var b = Batch{cols: [], vals: [], txt: [], n: 0}
    for i in 0..len(bp.kinds) {
        if bp.needCol[i] { append(mut &b.cols, bvec(cap)) } else { append(mut &b.cols, bvec(0)) }
        if bp.needCol[i] && bp.kinds[i] == BK_VAL { append(mut &b.vals, array(cap, Val.Null)) } else { append(mut &b.vals, []) }
        append(mut &b.txt, "")
    }
    return b
}

// Row r of column c NULL; a value column's slot set to NULL too, so a
// batch used again (reuse) holds no value from its last use there.
pub fn setNull(b: mut &Batch, c: int, r: int) {
    b.cols[c].nul[r] = true
    if r < len(b.vals[c]) { b.vals[c][r] = Val.Null }
}

// A batch for a fill of BROWS rows (fillPick's lazy fill, fillBatch): spare,
// the last one the caller used, when it is of this projection, else a new
// one. Its value columns are kept as they are (each slot a fill decodes is
// written, a NULL too: setNull), the integer and NULL columns new (9.111).
// newBatch's fill (BROWS NULLs per value column) was some 7% of TPC-H q1
// per batch read (lexdb-layers.md, after 2d slice 3).
pub fn reuse(spare: mut &Batch, bp: &Projection): Batch {
    var b = replace(spare, noRows())
    var fits = len(b.cols) == len(bp.kinds) && len(b.vals) == len(bp.kinds) && len(b.txt) == len(bp.kinds)
    if fits {
        for i in 0..len(bp.kinds) {
            let want = if bp.needCol[i] && bp.kinds[i] == BK_VAL { BROWS } else { 0 }
            if len(b.vals[i]) != want { fits = false }
        }
    }
    if !fits { return newBatch(bp, BROWS) }
    b.n = 0
    for i in 0..len(bp.kinds) {
        if bp.needCol[i] { b.cols[i] = bvec(BROWS) }
        b.txt[i].clear()                // (its buffer kept)
    }
    return b
}

// Puts value v at row r of column c; false: not of the column's kind.
pub fn put(b: mut &Batch, c: int, r: int, v: Val, kind: int): bool {
    match v {
        Val.Null {
            setNull(b, c, r)
            return true
        }
        Val.Int(i) {
            if kind == BK_INT {
                b.cols[c].v[r] = i
                return true
            }
        }
        Val.Bool(x) {
            if kind == BK_BOOL {
                b.cols[c].v[r] = if x { 1 } else { 0 }
                return true
            }
        }
        Val.Num(d) {
            if isDecKind(kind) {
                match decUnits(&d, decScale(kind)) {
                    Some(u) {
                        b.cols[c].v[r] = u
                        return true
                    }
                    None { return false }
                }
            }
        }
        Val.Text(x) { if kind == BK_TEXT { return putText(b, c, r, &x) } }
        else {}
    }
    if kind != BK_VAL { return false }
    b.vals[c][r] = v
    return true
}

// put of a value borrowed (rows the run holds, read again by the row path
// if the batch gives way): a text's bytes copied into the batch, a value
// column's value cloned.
pub fn putRef(b: mut &Batch, c: int, r: int, v: &Val, kind: int): bool {
    match v {
        Val.Null {
            setNull(b, c, r)
            return true
        }
        Val.Int(i) {
            if kind == BK_INT {
                b.cols[c].v[r] = i
                return true
            }
        }
        Val.Bool(x) {
            if kind == BK_BOOL {
                b.cols[c].v[r] = if x { 1 } else { 0 }
                return true
            }
        }
        Val.Num(d) {
            if isDecKind(kind) {
                match decUnits(&d, decScale(kind)) {
                    Some(u) {
                        b.cols[c].v[r] = u
                        return true
                    }
                    None { return false }
                }
            }
        }
        Val.Text(x) { if kind == BK_TEXT { return putText(b, c, r, &x) } }
        else {}
    }
    if kind != BK_VAL { return false }
    b.vals[c][r] = v.clone()
    return true
}

// ---- Leaf views (the page's entries as the codec reads them)
//
// A leaf's rows as a scan gives them, without copying: body and ents for a
// lazy leaf (entry i's key and value are at kStart and the others), vals for
// one in memory, cols and dir for a column leaf. page makes one from its
// Node; the row codec reads rows through it.

pub type LeafView = value record {
    pub isCols: bool
    pub lazy: bool
    pub n: int
    pub body: &str
    pub ents: &[]int
    pub keys: &[]rc str
    pub vals: &[]rc str
    pub cols: &str
    pub dir: &[]int
}

pub fn kStart(e: int): int { return e & 0xfffff }
pub fn kEnd(e: int): int { return (e & 0xfffff) + ((e >> 20) & 0xfff) }
pub fn vStart(e: int): int { return (e >> 32) & 0xfffff }
pub fn vEnd(e: int): int { return ((e >> 32) & 0xfffff) + ((e >> 52) & 0x7ff) }

pub fn leafKey(l: &LeafView, i: int): str {
    if !l.lazy { return l.keys[i].toStr() }
    let e = l.ents[i]
    return l.body[kStart(e)..kEnd(e)].clone()
}

// Row i (a column leaf's rebuilt).
pub fn leafVal(l: &LeafView, i: int): str {
    if l.isCols { return lexdb_cols.rowOf(l.cols, l.dir, i) }
    if !l.lazy { return l.vals[i].toStr() }
    let e = l.ents[i]
    return l.body[vStart(e)..vEnd(e)].clone()
}

// Row i as a view of the leaf's bytes (not of a column leaf, whose rows are
// read by column or rebuilt).
pub fn leafValAt(l: &LeafView, i: int): &str {
    if !l.lazy { return &l.vals[i] }
    if l.isCols { panic("leafValAt of a column leaf") }
    let e = l.ents[i]
    return &l.body[vStart(e)..vEnd(e)]
}

// Whether a format-6 row (or a version-2 stub's inline prefix p) holds every
// needed place up to stopAt inline, with no needed place stored as a long text
// (tag 5) and every byte in bounds.
pub fn fitsInStop(p: &str, stopAt: int, placeCol: &[]int): bool {
    if len(p) < 5 || p[0] != 6 { return false }
    let cols = binary.readU32LEStr(p, 1)
    let lim = if stopAt < cols { stopAt } else { cols }
    var at = 5
    for pl in 0..lim {
        if at >= len(p) { return false }
        let tag = p[at]
        at += 1
        if tag == 5 {
            if placeCol[pl] >= 0 { return false }
            at += 4
        } else {
            if (tag == 3 || tag == 4 || tag == 13) && at + 4 > len(p) { return false }
            let sz = valSize(p, at, tag)
            if sz < 0 { return false }
            at += sz
        }
        if at > len(p) { return false }
    }
    return true
}

// Decodes tagged row bytes starting at s[at0..] (cols >= 0 for format-6 rows /
// version-2 stub prefixes whose header is validated by fitsInStop, -1 for plain
// tagged rows) into row r of b.
fn decodeTaggedAt(s: &str, at0: int, cols: int, r: int, b: mut &Batch, bp: &Projection): Result[int, DbErr] {
    let kinds = &bp.kinds
    let placeCol = &bp.placeCol
    let missing = &bp.missing
    var at = at0
    for pl in 0..bp.stopAt {
        let c = placeCol[pl]
        if (cols >= 0 && pl >= cols) || (cols < 0 && at >= len(s)) {
            // a column added after the row was written: its value then
            if c >= 0 {
                let mv = if pl < len(missing) { missing[pl].clone() } else { Val.Null }
                if !put(b, c, r, mv, kinds[c]) { return Ok(1) }
            }
            continue
        }
        let tag = s[at]
        at += 1
        if c < 0 {
            let sz = valSize(s, at, tag)
            if sz < 0 { return Err(lexdb_base.corrupt("a row's value tag")) }
            at += sz
            continue
        }
        let k = kinds[c]
        if tag == 0 {
            setNull(b, c, r)
        } else if tag == 1 && k == BK_INT {
            b.cols[c].v[r] = binary.readI64LEStr(s, at)
            at += 8
        } else if tag == 2 && k == BK_BOOL {
            b.cols[c].v[r] = if s[at] == 1 { 1 } else { 0 }
            at += 1
        } else if isDecKind(k) {
            // a numeric's text, as units (anything else gives way)
            if tag != 3 { return Ok(1) }
            let l = binary.readU32LEStr(s, at)
            let tx = s[at + 4..at + 4 + l]
            at += 4 + l
            match Decimal.parse(&tx) {
                Ok(d) { if !put(b, c, r, Val.Num(d), k) { return Ok(1) } }
                Err(_) { return Err(lexdb_base.corrupt("a numeric value in a row")) }
            }
        } else if k == BK_TEXT {
            // a text's bytes into the batch's (anything else gives way)
            if tag != 4 { return Ok(1) }
            let l = binary.readU32LEStr(s, at)
            if !putText(b, c, r, &s[at + 4..at + 4 + l]) { return Ok(1) }
            at += 4 + l
        } else if k != BK_VAL {
            return Ok(1)
        } else if tag == 1 {
            b.vals[c][r] = Val.Int(binary.readI64LEStr(s, at))
            at += 8
        } else if tag == 2 {
            b.vals[c][r] = Val.Bool(s[at] == 1)
            at += 1
        } else if tag == 3 || tag == 4 {
            let l = binary.readU32LEStr(s, at)
            let tx = s[at + 4..at + 4 + l]
            at += 4 + l
            if tag == 4 {
                b.vals[c][r] = Val.Text(tx.clone())
            } else {
                match Decimal.parse(&tx) {
                    Ok(d) { b.vals[c][r] = Val.Num(d) }
                    Err(_) { return Err(lexdb_base.corrupt("a numeric value in a row")) }
                }
            }
        } else if tag >= 7 && tag <= 16 {
            b.vals[c][r] = timeVal(s, at, tag)
            at += valSize(s, at, tag)
        } else {
            return Err(lexdb_base.corrupt("a row's value tag"))
        }
    }
    return Ok(0)
}

// Decodes stored row s into row r of b: 0 done, 1 a value of a kind its
// column's batch does not hold (the row path reads the query), 2 a value
// stored apart (the store must be read: the caller's).
pub fn decodeRow(s: &str, r: int, b: mut &Batch, bp: &Projection, rw: &Rows): Result[int, DbErr] {
    if len(bp.usedP) == 0 { return Ok(0) }
    let kinds = &bp.kinds
    let placeCol = &bp.placeCol
    let missing = &bp.missing
    if isFixedRow(s) {
        // one load per column used, at its offset (9.50)
        let lay = &rw.lays[try layOf(s, rw.lays)]
        let np = len(lay.kinds)
        for pl in bp.usedP {
            let c = placeCol[pl]
            let k = kinds[c]
            if pl >= np {
                let mv = if pl < len(missing) { missing[pl].clone() } else { Val.Null }
                if !put(b, c, r, mv, k) { return Ok(1) }
                continue
            }
            let pk = lay.kinds[pl]
            if pk == PK_NONE || (int(s[lay.bm + pl / 8]) >> (pl % 8)) & 1 == 1 {
                setNull(b, c, r)
            } else if k == BK_INT && isIntKind(pk) {
                b.cols[c].v[r] = readIntK(s, lay.off[pl], pk)
            } else if pk == PK_BOOL && k == BK_BOOL {
                b.cols[c].v[r] = if s[lay.off[pl]] == 1 { 1 } else { 0 }
            } else if k == BK_TEXT {
                if pk != PK_TEXT || !putText(b, c, r, try fixedText(s, pl, lay)) { return Ok(1) }
            } else if isDecKind(k) {
                if !put(b, c, r, try fixedVal(s, pl, pk, lay), k) { return Ok(1) }
            } else if k != BK_VAL {
                return Ok(1)
            } else {
                b.vals[c][r] = try fixedVal(s, pl, pk, lay)
            }
        }
        return Ok(0)
    }
    if len(s) > 0 && s[0] == BIG {
        // a version-2 stub carries the row's inline head right after STUB_LEN;
        // when every needed place fits in it, decode in place without re-reading the store
        if isStub(s) && s[1] == 2 {
            let p = &s[STUB_LEN..len(s)]
            if fitsInStop(p, bp.stopAt, placeCol) {
                return decodeTaggedAt(p, 5, binary.readU32LEStr(p, 1), r, b, bp)
            }
        }
        return Ok(2)
    }
    if len(s) > 0 && s[0] == 6 {
        if fitsInStop(s, bp.stopAt, placeCol) {
            return decodeTaggedAt(s, 5, binary.readU32LEStr(s, 1), r, b, bp)
        }
        // a row with long texts, kept whole in its leaf: read as the row path reads it
        let places = try decodeRowNeed(s, bp.width, &bp.needP, missing, rw.lays)
        for i in 0..len(kinds) {
            if !bp.needCol[i] { continue }
            let pl = if len(rw.slots) == 0 { i } else { rw.slots[i] }
            if !put(b, i, r, places[pl].clone(), kinds[i]) { return Ok(1) }
        }
        return Ok(0)
    }
    return decodeTaggedAt(s, 0, -1, r, b, bp)
}

// The run of rows from `from` (at most `to`) that are in the fixed layout
// of the first, as views of the leaf's bytes ([] when the first is not in a
// fixed layout).
pub fn fixedRunRows(leaf: &LeafView, from: int, to: int, rw: &Rows): Result[[]&str, DbErr] {
    let s0 = leafValAt(leaf, from)
    if !isFixedRow(s0) { return Ok([]) }
    let id = try layOf(s0, rw.lays)
    let lay = &rw.lays[id]
    let id0 = s0[1]
    let id1 = s0[2]
    let v0 = lay.v0
    var rows: []&str = withCapacity(to - from)
    append(mut &rows, s0)
    var end = from + 1
    while end < to {
        let s = leafValAt(leaf, end)
        if len(s) < v0 || s[0] != FIXED || s[1] != id0 || s[2] != id1 { break }
        append(mut &rows, s)
        end += 1
    }
    return Ok(rows)
}

// The number of places a column leaf's rows have, and the kind of one:
// cRunLazy's raw LIKE chooses a text place without seeing lexdb_cols.
pub fn leafPlaces(leaf: &LeafView): int { return lexdb_cols.places(leaf.dir) }

pub fn leafPlaceKind(leaf: &LeafView, pl: int): byte { return lexdb_cols.kindOf(leaf.cols, pl) }

// Decodes the rows of a leaf in the fixed layout of its first, up to to,
// into rows b.n on of b, a column at a time (9.53). The number of rows
// decoded: 0 when the first is not in the fixed layout (decodeRow reads
// it), -1 a value of a kind its column's batch does not hold (as
// decodeRow's 1).
pub fn decodeRun(leaf: &LeafView, from: int, to: int, b: mut &Batch, bp: &Projection, rw: &Rows): Result[int, DbErr] {
    if len(bp.usedP) == 0 { return Ok(to - from) }
    if leaf.isCols { return decodeCols(leaf, from, to, b, bp, rw) }
    // each row's bytes, found once (a lazy leaf's are in its page's body)
    let rows = try fixedRunRows(leaf, from, to, rw)
    if len(rows) == 0 { return Ok(0) }
    let id = try layOf(rows[0], rw.lays)
    let lay = &rw.lays[id]
    let n = len(rows)
    let r0 = b.n
    let np = len(lay.kinds)
    for pl in bp.usedP {
        let c = bp.placeCol[pl]
        let k = bp.kinds[c]
        if pl >= np {
            let mv = if pl < len(bp.missing) { bp.missing[pl].clone() } else { Val.Null }
            for q in 0..n { if !put(b, c, r0 + q, mv.clone(), k) { return Ok(-1) } }
            continue
        }
        let pk = lay.kinds[pl]
        if pk == PK_NONE {
            for q in 0..n { setNull(b, c, r0 + q) }
            continue
        }
        let at = lay.bm + pl / 8
        let bit = pl % 8
        let o = lay.off[pl]
        if k == BK_INT && pk == PK_INT4 {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    col.nul[r0 + q] = true
                } else {
                    let u = int(s[o]) | (int(s[o + 1]) << 8) | (int(s[o + 2]) << 16) | (int(s[o + 3]) << 24)
                    col.v[r0 + q] = if u >= 0x80000000 { u - 0x100000000 } else { u }
                }
            }
            b.cols[c] = col
        } else if k == BK_INT && pk == PK_INT {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    col.nul[r0 + q] = true
                } else {
                    col.v[r0 + q] = int(s[o]) | (int(s[o + 1]) << 8) | (int(s[o + 2]) << 16) | (int(s[o + 3]) << 24) |
                                    (int(s[o + 4]) << 32) | (int(s[o + 5]) << 40) | (int(s[o + 6]) << 48) | (int(s[o + 7]) << 56)
                }
            }
            b.cols[c] = col
        } else if k == BK_INT && pk == PK_INT2 {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    col.nul[r0 + q] = true
                } else {
                    let u = int(s[o]) | (int(s[o + 1]) << 8)
                    col.v[r0 + q] = if u >= 0x8000 { u - 0x10000 } else { u }
                }
            }
            b.cols[c] = col
        } else if k == BK_BOOL && pk == PK_BOOL {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 { col.nul[r0 + q] = true } else { col.v[r0 + q] = if s[o] == 1 { 1 } else { 0 } }
            }
            b.cols[c] = col
        } else if k == BK_TEXT && pk == PK_TEXT {
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 { setNull(b, c, r0 + q) } else if !putText(b, c, r0 + q, try fixedText(s, pl, lay)) { return Ok(-1) }
            }
        } else if k == BK_VAL {
            // a NULL row's value written too: the batch may be used again (reuse)
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 { setNull(b, c, r0 + q) } else { b.vals[c][r0 + q] = try fixedVal(s, pl, pk, lay) }
            }
        } else if isDecKind(k) && pk == PK_NUM {
            for q in 0..n {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 { b.cols[c].nul[r0 + q] = true } else if !put(b, c, r0 + q, try fixedVal(s, pl, pk, lay), k) { return Ok(-1) }
            }
        } else {
            return Ok(-1)
        }
    }
    return Ok(n)
}

// Decodes places ps of a run's rows (their bytes in rows, of layout lay)
// at offsets qs into b's rows r0 + q, a column at a time, as decodeRun
// does; false: a value of a kind its column's batch does not hold.
pub fn runCols(rows: &[]&str, qs: &[]int, r0: int, ps: &[]int, b: mut &Batch, bp: &Projection, lay: &FixedLay): Result[bool, DbErr] {
    let np = len(lay.kinds)
    for pl in ps {
        let c = bp.placeCol[pl]
        let k = bp.kinds[c]
        if pl >= np {
            let mv = if pl < len(bp.missing) { bp.missing[pl].clone() } else { Val.Null }
            for q in qs { if !put(b, c, r0 + q, mv.clone(), k) { return Ok(false) } }
            continue
        }
        let pk = lay.kinds[pl]
        if pk == PK_NONE {
            for q in qs { setNull(b, c, r0 + q) }
            continue
        }
        let at = lay.bm + pl / 8
        let bit = pl % 8
        let o = lay.off[pl]
        if k == BK_INT && pk == PK_INT4 {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in qs {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    col.nul[r0 + q] = true
                } else {
                    let u = int(s[o]) | (int(s[o + 1]) << 8) | (int(s[o + 2]) << 16) | (int(s[o + 3]) << 24)
                    col.v[r0 + q] = if u >= 0x80000000 { u - 0x100000000 } else { u }
                }
            }
            b.cols[c] = col
        } else if k == BK_INT && pk == PK_INT {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in qs {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    col.nul[r0 + q] = true
                } else {
                    col.v[r0 + q] = int(s[o]) | (int(s[o + 1]) << 8) | (int(s[o + 2]) << 16) | (int(s[o + 3]) << 24) |
                                    (int(s[o + 4]) << 32) | (int(s[o + 5]) << 40) | (int(s[o + 6]) << 48) | (int(s[o + 7]) << 56)
                }
            }
            b.cols[c] = col
        } else if k == BK_INT && pk == PK_INT2 {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in qs {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    col.nul[r0 + q] = true
                } else {
                    let u = int(s[o]) | (int(s[o + 1]) << 8)
                    col.v[r0 + q] = if u >= 0x8000 { u - 0x10000 } else { u }
                }
            }
            b.cols[c] = col
        } else if k == BK_BOOL && pk == PK_BOOL {
            var col = replace(mut &b.cols[c], bvec(0))
            for q in qs {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 { col.nul[r0 + q] = true } else { col.v[r0 + q] = if s[o] == 1 { 1 } else { 0 } }
            }
            b.cols[c] = col
        } else if k == BK_TEXT && pk == PK_TEXT {
            for q in qs {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 { b.cols[c].nul[r0 + q] = true } else if !putText(b, c, r0 + q, try fixedText(s, pl, lay)) { return Ok(false) }
            }
        } else if k == BK_VAL {
            for q in qs {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 {
                    b.cols[c].nul[r0 + q] = true
                    b.vals[c][r0 + q] = Val.Null
                } else {
                    b.vals[c][r0 + q] = try fixedVal(s, pl, pk, lay)
                }
            }
        } else if isDecKind(k) && pk == PK_NUM {
            for q in qs {
                let s = rows[q]
                if (int(s[at]) >> bit) & 1 == 1 { b.cols[c].nul[r0 + q] = true } else if !put(b, c, r0 + q, try fixedVal(s, pl, pk, lay), k) { return Ok(false) }
            }
        } else {
            return Ok(false)
        }
    }
    return Ok(true)
}

// Whether column leaf leaf's rows are in a layout of rw with the same kinds.
pub fn layoutOk(leaf: &LeafView, rw: &Rows): bool {
    let lid = lexdb_cols.layoutOf(leaf.dir)
    return lid < len(rw.lays) && lexdb_cols.kindsAre(leaf.cols, leaf.dir, &rw.lays[lid].kinds)
}

// The text of dictionary coded columns, kept for the program (strStatic):
// a batch's value is then a copy of a static string, which costs nothing,
// where a heap string's clone copies its bytes for every row. A dictionary
// column has few distinct values; the pool stops taking new ones at
// DICT_MAX entries or DICT_BYTES bytes, and a value past that is a heap
// copy as before.
type DictPool = record { m: Map[str, str]; bytes: int }

const DICT_MAX = 65536
const DICT_BYTES = 8 << 20

var DICTS: once task.Shared[DictPool]

fn dictPool(): task.Shared[DictPool] {
    if !DICTS.isSet() { DICTS.set(task.shared(DictPool{m: newMap(), bytes: 0})) }
    return DICTS.get().share()
}

// The values of a column leaf's dictionary (place pl), pooled.
fn dictVals(s: &str, dir: &[]int, pl: int): []Val {
    let nd = lexdb_cols.dictSize(dir, pl)
    var dv: []Val = withCapacity(nd)
    dictPool().with(fn(p: mut &DictPool) {
        for j in 0..nd {
            let sp = lexdb_cols.entryAt(s, dir, pl, j)
            let t = &s[lexdb_cols.spanStart(sp)..lexdb_cols.spanEnd(sp)]
            match p.m.get(t) {
                Some(x) { append(mut &dv, Val.Text(x)) }
                None {
                    if p.m.size() < DICT_MAX && p.bytes + len(t) <= DICT_BYTES {
                        let x = strStatic(t)
                        p.m.put(t.toStr(), x.clone())
                        p.bytes += len(t)
                        append(mut &dv, Val.Text(x))
                    } else {
                        append(mut &dv, Val.Text(t.toStr()))
                    }
                }
            }
        }
    })
    return dv
}

// Places ps of column leaf rows from + qs[x] into b's rows r0 + qs[x]
// (all: qs is 0, 1, 2 ... in order, read as a run); false: a value of a
// kind its column's batch does not hold.
pub fn colsInto(leaf: &LeafView, from: int, qs: &[]int, all: bool, r0: int, ps: &[]int, b: mut &Batch, bp: &Projection): Result[bool, DbErr] {
    return colsPick(leaf, from, qs, qs, all, r0, ps, b, bp)
}

// colsInto with the batch's rows given apart: leaf row from + qs[x] into
// b's row r0 + rs[x] (all: both are 0, 1, 2 ... in order).
pub fn colsPick(leaf: &LeafView, from: int, qs: &[]int, rs: &[]int, all: bool, r0: int, ps: &[]int, b: mut &Batch, bp: &Projection): Result[bool, DbErr] {
    let s = leaf.cols
    let dir = leaf.dir
    let np = lexdb_cols.places(dir)
    let n = len(qs)
    if n == 0 { return Ok(true) }
    for pl in ps {
        let c = bp.placeCol[pl]
        let k = bp.kinds[c]
        if pl >= np {
            let mv = if pl < len(bp.missing) { bp.missing[pl].clone() } else { Val.Null }
            for x in 0..n { if !put(b, c, r0 + rs[x], mv.clone(), k) { return Ok(false) } }
            continue
        }
        let pk = lexdb_cols.kindOf(s, pl)
        if pk == PK_NONE {
            for x in 0..n { setNull(b, c, r0 + rs[x]) }
            continue
        }
        let nulls = lexdb_cols.hasNulls(dir, pl)
        if nulls {
            if all { lexdb_cols.nullsInto(s, dir, pl, from, n, mut &b.cols[c].nul, r0) } else {
                for x in 0..n { if lexdb_cols.isNull(s, dir, pl, from + qs[x]) { b.cols[c].nul[r0 + rs[x]] = true } }
            }
        }
        if k == BK_INT && isIntKind(pk) {
            var col = replace(mut &b.cols[c], bvec(0))
            if all { lexdb_cols.intsInto(s, dir, pl, from, n, mut &col.v, r0) } else {
                for x in 0..n { col.v[r0 + rs[x]] = lexdb_cols.intAt(s, dir, pl, from + qs[x]) }
            }
            b.cols[c] = col
        } else if k == BK_BOOL && pk == PK_BOOL {
            var col = replace(mut &b.cols[c], bvec(0))
            if all { lexdb_cols.boolsInto(s, dir, pl, from, n, mut &col.v, r0) } else {
                for x in 0..n { col.v[r0 + rs[x]] = if lexdb_cols.boolAt(s, dir, pl, from + qs[x]) { 1 } else { 0 } }
            }
            b.cols[c] = col
        } else if isDecKind(k) {
            // a numeric as its units: a leaf of units at the column's scale
            // read as integers; any other numeric leaf value by value
            if pk != PK_NUM { return Ok(false) }
            let ds = decScale(k)
            if lexdb_cols.codecOf(dir, pl) == lexdb_cols.C_UNITS {
                if lexdb_cols.scaleOf(dir, pl) != ds { return Ok(false) }
                var col = replace(mut &b.cols[c], bvec(0))
                if all { lexdb_cols.intsInto(s, dir, pl, from, n, mut &col.v, r0) } else {
                    for x in 0..n { col.v[r0 + rs[x]] = lexdb_cols.intAt(s, dir, pl, from + qs[x]) }
                }
                b.cols[c] = col
            } else {
                var sp: []int = array(n, 0)
                if all { lexdb_cols.varsInto(s, dir, pl, from, n, mut &sp, 0) } else {
                    for x in 0..n { sp[x] = lexdb_cols.varAt(s, dir, pl, from + qs[x]) }
                }
                for x in 0..n {
                    let r = r0 + rs[x]
                    if b.cols[c].nul[r] { continue }
                    let v = try varVal(pk, s, lexdb_cols.spanStart(sp[x]), lexdb_cols.spanEnd(sp[x]))
                    if !put(b, c, r, v, k) { return Ok(false) }
                }
            }
        } else if k == BK_TEXT {
            // a text column's bytes from the page: its dictionary's entry or
            // its own span, appended (no value made)
            if pk != PK_TEXT { return Ok(false) }
            let codec = lexdb_cols.codecOf(dir, pl)
            if codec == lexdb_cols.C_DICT && !all && 4 * n < lexdb_cols.dictSize(dir, pl) {
                // a few rows picked (a lookup's): their entries only
                for x in 0..n {
                    let r = r0 + rs[x]
                    if b.cols[c].nul[r] { continue }
                    let sp = lexdb_cols.entryAt(s, dir, pl, lexdb_cols.codeAt(s, dir, pl, from + qs[x]))
                    if !putText(b, c, r, &s[lexdb_cols.spanStart(sp)..lexdb_cols.spanEnd(sp)]) { return Ok(false) }
                }
            } else if codec == lexdb_cols.C_DICT {
                // each entry's bytes into the batch once, the first time a
                // row uses it; its rows point at them (a text's place is
                // its start and length: rows may share bytes)
                var codes: []int = array(n, 0)
                if all { lexdb_cols.codesInto(s, dir, pl, from, n, mut &codes, 0) } else {
                    for x in 0..n { codes[x] = lexdb_cols.codeAt(s, dir, pl, from + qs[x]) }
                }
                var placed: []int = array(lexdb_cols.dictSize(dir, pl), -1)
                for x in 0..n {
                    let r = r0 + rs[x]
                    if b.cols[c].nul[r] { continue }
                    let code = codes[x]
                    if placed[code] < 0 {
                        let sp = lexdb_cols.entryAt(s, dir, pl, code)
                        if !putText(b, c, r, &s[lexdb_cols.spanStart(sp)..lexdb_cols.spanEnd(sp)]) { return Ok(false) }
                        placed[code] = b.cols[c].v[r]
                    } else {
                        b.cols[c].v[r] = placed[code]
                    }
                }
            } else {
                var sp: []int = array(n, 0)
                if all { lexdb_cols.varsInto(s, dir, pl, from, n, mut &sp, 0) } else {
                    for x in 0..n { sp[x] = lexdb_cols.varAt(s, dir, pl, from + qs[x]) }
                }
                for x in 0..n {
                    let r = r0 + rs[x]
                    if b.cols[c].nul[r] { continue }
                    if !putText(b, c, r, &s[lexdb_cols.spanStart(sp[x])..lexdb_cols.spanEnd(sp[x])]) { return Ok(false) }
                }
            }
        } else if k == BK_VAL {
            var vals = replace(mut &b.vals[c], [])
            // a NULL row's value written too: a batch's value columns are
            // used again (reuse, 9.111)
            if nulls { for x in 0..n { if b.cols[c].nul[r0 + rs[x]] { vals[r0 + rs[x]] = Val.Null } } }
            let codec = lexdb_cols.codecOf(dir, pl)
            if isWordKind(pk) {
                // an integer, a date or time, a float's bits (9.113)
                for x in 0..n {
                    let r = r0 + rs[x]
                    if !b.cols[c].nul[r] { vals[r] = wordVal(pk, lexdb_cols.intAt(s, dir, pl, from + qs[x])) }
                }
            } else if pk == PK_BOOL {
                for x in 0..n {
                    let r = r0 + rs[x]
                    if !b.cols[c].nul[r] { vals[r] = Val.Bool(lexdb_cols.boolAt(s, dir, pl, from + qs[x])) }
                }
            } else if codec == lexdb_cols.C_DICT && !all && n < lexdb_cols.dictSize(dir, pl) {
                // fewer rows picked than the dictionary has entries (a
                // lookup's): their entries only, each made (dictVals would
                // look every entry up in the pool)
                for x in 0..n {
                    let r = r0 + rs[x]
                    if b.cols[c].nul[r] { continue }
                    let sp = lexdb_cols.entryAt(s, dir, pl, lexdb_cols.codeAt(s, dir, pl, from + qs[x]))
                    vals[r] = Val.Text(s[lexdb_cols.spanStart(sp)..lexdb_cols.spanEnd(sp)].clone())
                }
            } else if codec == lexdb_cols.C_DICT {
                // each entry made once, pooled (dictVals)
                let dv = dictVals(s, dir, pl)
                var codes: []int = array(n, 0)
                if all { lexdb_cols.codesInto(s, dir, pl, from, n, mut &codes, 0) } else {
                    for x in 0..n { codes[x] = lexdb_cols.codeAt(s, dir, pl, from + qs[x]) }
                }
                for x in 0..n {
                    let r = r0 + rs[x]
                    if !b.cols[c].nul[r] { vals[r] = dv[codes[x]].clone() }
                }
            } else if codec == lexdb_cols.C_UNITS {
                let ds = lexdb_cols.scaleOf(dir, pl)
                for x in 0..n {
                    let r = r0 + rs[x]
                    if !b.cols[c].nul[r] { vals[r] = Val.Num(Decimal.fromUnits(lexdb_cols.intAt(s, dir, pl, from + qs[x]), ds)) }
                }
            } else {
                var sp: []int = array(n, 0)
                if all { lexdb_cols.varsInto(s, dir, pl, from, n, mut &sp, 0) } else {
                    for x in 0..n { sp[x] = lexdb_cols.varAt(s, dir, pl, from + qs[x]) }
                }
                for x in 0..n {
                    let r = r0 + rs[x]
                    if b.cols[c].nul[r] { continue }
                    let a = lexdb_cols.spanStart(sp[x])
                    let e = lexdb_cols.spanEnd(sp[x])
                    if pk == PK_TEXT {
                        vals[r] = Val.Text(s[a..e].clone())
                    } else {
                        // a numeric, a uuid, a bytea (9.113)
                        match varVal(pk, s, a, e) {
                            Ok(v) { vals[r] = v }
                            Err(bad) {
                                b.vals[c] = vals
                                return Err(bad)
                            }
                        }
                    }
                }
            }
            b.vals[c] = vals
        } else {
            return Ok(false)
        }
    }
    return Ok(true)
}

// Rows rs (batch rows, from row r0 = leaf row from) whose text at place pl
// a simple LIKE of pieces ps holds for; a dictionary's entries matched once.
pub fn likeInLeaf(leaf: &LeafView, from: int, rs: &[]int, r0: int, pl: int, ps: &[]str): []int {
    let s = leaf.cols
    let dir = leaf.dir
    var out: []int = []
    if lexdb_cols.codecOf(dir, pl) == lexdb_cols.C_DICT {
        let nd = lexdb_cols.dictSize(dir, pl)
        var hit: []bool = array(nd, false)
        for j in 0..nd {
            let sp = lexdb_cols.entryAt(s, dir, pl, j)
            let a = lexdb_cols.spanStart(sp)
            let e = lexdb_cols.spanEnd(sp)
            hit[j] = lexdb_like.likeRange(&s[a..e], 0, e - a, ps)
        }
        for r in rs {
            let i = from + r - r0
            if lexdb_cols.isNull(s, dir, pl, i) { continue }
            if hit[lexdb_cols.codeAt(s, dir, pl, i)] { append(mut &out, r) }
        }
        return out
    }
    // (each text a view of its own bytes: a piece searched for is not
    // looked for past its end, in the texts after it)
    let nulls = lexdb_cols.hasNulls(dir, pl)
    let ends = lexdb_cols.endsAt(dir, pl)
    let data = lexdb_cols.bytesAt(dir, pl)
    for r in rs {
        let i = from + r - r0
        if nulls && lexdb_cols.isNull(s, dir, pl, i) { continue }
        let a = if i == 0 { data } else { data + (int(s[ends + 2 * i - 2]) | (int(s[ends + 2 * i - 1]) << 8)) }
        let e = data + (int(s[ends + 2 * i]) | (int(s[ends + 2 * i + 1]) << 8))
        if lexdb_like.likeRange(&s[a..e], 0, e - a, ps) { append(mut &out, r) }
    }
    return out
}

// Column leaves batch scans skipped (excluded), for the tests.
var skipped: int = 0

pub fn colLeavesSkipped(): int { return skipped }

// Whether column leaf leaf holds no row bp.ranges keep: a place of the
// range's kind whose least and greatest in the leaf are outside its range
// (or whose rows are all NULL).
pub fn excluded(leaf: &LeafView, bp: &Projection, rw: &Rows): bool {
    if !layoutOk(leaf, rw) { return false }
    let dir = leaf.dir
    let np = lexdb_cols.places(dir)
    var x = 0
    while x + 3 < len(bp.ranges) {
        let pl = bp.ranges[x]
        let want = bp.ranges[x + 1]
        let lo = bp.ranges[x + 2]
        let hi = bp.ranges[x + 3]
        x += 4
        if pl >= np { continue }
        // the place's words must be what the range is of: any integer's, or
        // the one date or time kind (a column retyped keeps older leaves of
        // its old kind)
        let pk = lexdb_cols.kindOf(leaf.cols, pl)
        if !(if want == 0 { isIntKind(pk) } else { int(pk) == want }) { continue }
        if lo > hi || !lexdb_cols.hasRange(dir, pl) || lexdb_cols.least(dir, pl) > hi || lexdb_cols.greatest(dir, pl) < lo {
            skipped += 1
            return true
        }
    }
    return false
}

// Column leaf rows from..to (rebuilt) into rows b.n on of b, a row at a
// time: a leaf whose layout's kinds are not its table's. The rows decoded
// before the first with a value stored apart (Q8 R8: the caller reads that
// one from the store, as decodeRow's 2; APART: the first is), -1 as
// decodeRun.
pub fn rowsInto(leaf: &LeafView, from: int, to: int, b: mut &Batch, bp: &Projection, rw: &Rows): Result[int, DbErr] {
    for k in from..to {
        let row = leafVal(leaf, k)
        let at = b.n
        let code = try decodeRow(&row, at + k - from, b, bp, rw)
        if code == 2 { return Ok(if k == from { APART } else { k - from }) }
        if code != 0 { return Ok(-1) }
    }
    return Ok(to - from)
}

// decodeRun for a column leaf: rows from..to into rows b.n on of b. The
// rows decoded (to - from), -1 as decodeRun.
fn decodeCols(leaf: &LeafView, from: int, to: int, b: mut &Batch, bp: &Projection, rw: &Rows): Result[int, DbErr] {
    if !layoutOk(leaf, rw) { return rowsInto(leaf, from, to, b, bp, rw) }
    let n = to - from
    var qs: []int = withCapacity(n)
    for q in 0..n { append(mut &qs, q) }
    if !(try colsInto(leaf, from, &qs, true, b.n, &bp.usedP, b, bp)) { return Ok(-1) }
    return Ok(n)
}
