// lexdb_oracat: Oracle's catalog views (V$VERSION, ALL_TABLES, USER_TAB_COLUMNS,
// DBA_OBJECTS, NLS_SESSION_PARAMETERS, DICTIONARY, ...) for the Oracle door
// (design/lexdb-oracle.md, O4), as lexdb_syscat gives SQL Server's sys.* to T-SQL
// sessions. Their shapes (columns, types, order), the rows lexdb takes from
// Oracle as they are, and a template row for each kind of object are Oracle
// Database Free's, recorded by tools/gen_oracle_catalog.py in lexdb_oradata;
// the rows that describe lexdb's own tables this module makes from the
// catalog (viewRows), each from a template row with the columns that describe
// the object set.
//
// A view is a catalog relation as pg_catalog's are (lexdb_pgcat): the Oracle
// parser makes ALL_TABLES, SYS.ALL_TABLES, V$VERSION (V_$VERSION), a public
// synonym such as TABS, ... the function "#ora.ALL_TABLES" in FROM, whose rows
// this module makes when the statement runs. PostgreSQL and T-SQL sessions never
// see them.

import "strings"
import "./lexdb_base"
import "./lexdb_catalog"
import "./lexdb_dialect"
import "./lexdb_float"
import "./lexdb_time"
import "./lexdb_oradata"
import "./lexdb_oraadm"
import "./lexdb_sql"
import "./lexdb_annot"

type Val = lexdb_sql.Val
type Expr = lexdb_sql.Expr
type DbErr = lexdb_base.DbErr
type Role = lexdb_catalog.Role
type CatSnap = lexdb_catalog.CatSnap
type CatTab = lexdb_catalog.CatTab
type CatIdx = lexdb_catalog.CatIdx
const ROWID = lexdb_catalog.ROWID

fn iv(n: int): Val { return Val.Int(n) }

// A view's column: as DBA_TAB_COLUMNS describes SYS's own view.
pub type OraCol = record {
    pub name: str
    pub typ: str            // VARCHAR2, NUMBER, DATE, TIMESTAMP(6), CHAR, LONG, RAW, ...
    pub len: int
    pub prec: int           // -1 none
    pub scale: int          // -1 none
    pub nullable: bool
}

// lexdb's OIDs (as lexdb_sql's; this module is below it)
const O_INT8 = 20
const O_TEXT = 25
const O_FLOAT8 = 701
const O_BYTEA = 17
const O_TS = 1114
const O_TSTZ = 1184
const O_NUMERIC = 1700

// Public synonyms too short or too common to take a name from a user's table.
const HIDDEN_SYN: []str = ["TAB", "SYN", "SEQ", "IND", "OBJ", "CLU", "CAT", "COL", "DICT_COLUMNS_X"]

// The name of a view, spelled as SYS's: upper case, V$X as V_$X.
fn real(name: &str): str {
    let u = strings.toUpperAscii(name)
    if strings.startsWith(&u, "V$") { return "V_$" + u[2..len(u)] }
    if strings.startsWith(&u, "GV$") { return "GV_$" + u[3..len(u)] }
    return u
}

fn specOf(view: &str): str {
    for v in lexdb_oradata.VIEWS {
        let t = strings.indexOf(&v, "\t", 0)
        if v[0..t] == view { return v.toStr() }
    }
    return ""
}

// Whether view (a name as SYS has it: V_$VERSION) is served.
pub fn isView(view: &str): bool { return len(specOf(view)) > 0 }

// Every view's name (as SYS's).
pub fn viewNames(): []str {
    var out: []str = []
    for v in lexdb_oradata.VIEWS { append(mut &out, v[0..strings.indexOf(&v, "\t", 0)].toStr()) }
    return out
}

// The view a name in FROM (schema "" if none) means, as SYS's name ("" if it is
// none of ours): the view itself, in SYS or unqualified, or a PUBLIC synonym of one.
pub fn relOf(schema: &str, name: &str): str { return lexdb_dialect.oraRelOf(schema, name) }

pub fn cols(view: &str): []OraCol {
    var out: []OraCol = []
    let s = specOf(view)
    if len(s) == 0 { return out }
    let f = strings.split(&s, "\t")
    for i in 1..len(f) {
        let p = strings.split(&f[i], ":")
        append(mut &out, OraCol{name: p[0].toStr(), typ: p[1].toStr(), len: strings.parseIntOpt(p[2]).unwrapOr(0),
                                prec: strings.parseIntOpt(p[3]).unwrapOr(-1), scale: strings.parseIntOpt(p[4]).unwrapOr(-1),
                                nullable: p[5] == "1"})
    }
    return out
}

// The lexdb type a column is computed as.
pub fn lexOid(c: &OraCol): int {
    let t = &c.typ
    if t == "NUMBER" { return if c.scale > 0 { O_NUMERIC } else { O_INT8 } }
    if t == "FLOAT" { return O_NUMERIC }
    if t == "BINARY_DOUBLE" { return O_FLOAT8 }
    if t == "DATE" || strings.startsWith(&t, "TIMESTAMP") {
        if strings.contains(&t, "WITH TIME ZONE") || strings.contains(&t, "LOCAL") { return O_TSTZ }
        return O_TS
    }
    if t == "RAW" || t == "LONG RAW" || t == "BLOB" { return O_BYTEA }
    return O_TEXT
}

// A view's rows Oracle has: kind "full" (every one lexdb gives) or "template"
// (one of each kind of object, for lexdb_exec to fill in); values as text, NULL
// "\x00".
pub fn rows(view: &str, kind: &str): [][]str {
    var out: [][]str = []
    let head = view + "\t" + kind + "\t"
    for r in lexdb_oradata.ROWS {
        if !strings.startsWith(&r, &head) { continue }
        let body = r[len(head)..len(r)]
        if len(body) == 0 { return out }
        for row in strings.split(&body, "\x1e") {
            var vs: []str = []
            for v in strings.split(&row, "\x1f") { append(mut &vs, v.toStr()) }
            append(mut &out, vs)
        }
    }
    return out
}

fn colIndex(cs: &[]OraCol, name: &str): int {
    for i in 0..len(cs) { if cs[i].name == name { return i } }
    return -1
}

// A view's template row for kind want of column col (exact, else the same first
// word: TIMESTAMP(3) for TIMESTAMP(6), else the first); [] if it has none.
fn copyRow(r: &[]str): []str {
    var out: []str = []
    for v in r { append(mut &out, v.toStr()) }
    return out
}

pub fn template(view: &str, col: &str, want: &str): []str {
    let ts = rows(view, "template")
    if len(ts) == 0 { return [] }
    let ci = colIndex(&cols(view), col)
    if ci < 0 { return copyRow(&ts[0]) }
    for t in ts { if t[ci] == want { return copyRow(&t) } }
    let w = strings.split(&want, "(")[0]
    for t in ts { if strings.split(&t[ci], "(")[0] == w { return copyRow(&t) } }
    return copyRow(&ts[0])
}

// The family of an ALL_/USER_/DBA_ view: its scope ("ALL", "USER", "DBA") and
// base name (TABLES); "" and the name for any other.
pub type Family = record {
    pub scope: str
    pub base: str
}

pub fn family(view: &str): Family {
    for p in ["ALL_", "USER_", "DBA_"] {
        if strings.startsWith(view, &p) { return Family{scope: p[0..len(p) - 1].toStr(), base: view[len(p)..len(view)].toStr()} }
    }
    return Family{scope: "", base: view.toStr()}
}

// The bases lexdb_exec builds the rows of from its catalog.
pub fn isBuilt(base: &str): bool {
    match base.toStr() {
        "TABLES", "TAB_COLUMNS", "TAB_COLS", "INDEXES", "IND_COLUMNS", "IND_EXPRESSIONS", "CONSTRAINTS", "CONS_COLUMNS", "OBJECTS", "SEQUENCES",
        "VIEWS", "TAB_COMMENTS", "COL_COMMENTS", "TAB_IDENTITY_COLS", "CATALOG", "SOURCE", "PROCEDURES", "ERRORS", "ANNOTATIONS_USAGE", "ANNOTATIONS",
        "ANNOTATION_VALUES" { return true }
        else { return false }
    }
}

// The upper-cased name of a view's PUBLIC synonym for view, "" if none.
pub fn synonymOf(view: &str): str {
    for s in lexdb_oradata.SYNONYMS {
        let f = strings.split(&s, "\t")
        if f[1] == view { return f[0].toStr() }
    }
    return ""
}

pub type OraT = record {
    pub dtype: str
    pub len: int
    pub prec: int
    pub scale: int
    pub chars: int
}

pub fn oraTypeOf(t: &lexdb_sql.TypeName): OraT {
    let k = t.kind
    if k == lexdb_sql.K_INT {
        if t.oid == lexdb_sql.OID_INT2 { return OraT{dtype: "NUMBER", len: 22, prec: 5, scale: 0, chars: 0} }
        if t.oid == lexdb_sql.OID_INT4 { return OraT{dtype: "NUMBER", len: 22, prec: 10, scale: 0, chars: 0} }
        return OraT{dtype: "NUMBER", len: 22, prec: -1, scale: 0, chars: 0}
    }
    if k == lexdb_sql.K_BOOL { return OraT{dtype: "BOOLEAN", len: 1, prec: -1, scale: -1, chars: 0} }
    if k == lexdb_sql.K_NUM {
        if t.prec > 0 { return OraT{dtype: "NUMBER", len: 22, prec: t.prec, scale: t.scale, chars: 0} }
        return OraT{dtype: "NUMBER", len: 22, prec: -1, scale: -1, chars: 0}
    }
    if k == lexdb_sql.K_FLOAT {
        if t.oid == lexdb_sql.OID_FLOAT4 { return OraT{dtype: "BINARY_FLOAT", len: 4, prec: -1, scale: -1, chars: 0} }
        return OraT{dtype: "BINARY_DOUBLE", len: 8, prec: -1, scale: -1, chars: 0}
    }
    if k == lexdb_sql.K_DATE { return OraT{dtype: "DATE", len: 7, prec: -1, scale: -1, chars: 0} }
    if k == lexdb_sql.K_UUID { return OraT{dtype: "RAW", len: 16, prec: -1, scale: -1, chars: 0} }
    if k == lexdb_sql.K_BYTEA { return OraT{dtype: "BLOB", len: 4000, prec: -1, scale: -1, chars: 0} }
    if k == lexdb_sql.K_IVAL { return OraT{dtype: "INTERVAL DAY(2) TO SECOND(6)", len: 11, prec: -1, scale: 6, chars: 0} }
    if k == lexdb_sql.K_TS || k == lexdb_sql.K_TSTZ {
        // DATE is lexdb's timestamp(0) (O3)
        if k == lexdb_sql.K_TS && t.prec >= 1 && t.scale == 0 { return OraT{dtype: "DATE", len: 7, prec: -1, scale: -1, chars: 0} }
        let s = if t.prec >= 1 { min(t.scale, 9) } else { 6 }
        if k == lexdb_sql.K_TS { return OraT{dtype: "TIMESTAMP(" + s.toStr() + ")", len: 11, prec: -1, scale: s, chars: 0} }
        return OraT{dtype: "TIMESTAMP(" + s.toStr() + ") WITH TIME ZONE", len: 13, prec: -1, scale: s, chars: 0}
    }
    if k == lexdb_sql.K_TIME { return OraT{dtype: "VARCHAR2", len: 15, prec: -1, scale: -1, chars: 15} }
    if k == lexdb_sql.K_TEXT {
        let n = t.len
        if t.oid == lexdb_sql.OID_BPCHAR { return OraT{dtype: "CHAR", len: if n > 0 { n } else { 1 }, prec: -1, scale: -1, chars: if n > 0 { n } else { 1 }} }
        if n > 0 { return OraT{dtype: "VARCHAR2", len: n, prec: -1, scale: -1, chars: n} }
        return OraT{dtype: "CLOB", len: 4000, prec: -1, scale: -1, chars: 0}
    }
    return OraT{dtype: "VARCHAR2", len: 4000, prec: -1, scale: -1, chars: 4000}
}

// The views' shapes, the rows lexdb takes as Oracle has them (V$VERSION,
// NLS_DATABASE_PARAMETERS, ...) and a template row of each kind of object are
// lexdb_oracat's (recorded from Oracle Database Free); a row that describes one
// of lexdb's objects is its template with the columns that describe the object
// set (a table's name and owner; a column's type, length, nullability; ...).
// ALL_x and DBA_x list every schema (lexdb has no per-object visibility test
// for them), USER_x the session's own. An object's owner is its schema's
// upper-cased name; public's objects are the session user's. A name without a
// spelling of its own is shown in upper case (Oracle's fold), a name that has
// one as written.

const ORA_DATE: str = "2000-01-01 00:00:00"      // CREATED, LAST_DDL_TIME ...: lexdb keeps no times

// A row being made: the owner it is listed under, the kind of its template
// row (the value of the view's discriminating column), the columns it sets.
type OraNV = record {
    name: str
    v: Val
}

type OraPend = record {
    owner: str
    disc: str
    sets: []OraNV
}

fn oraPend(owner: &str, disc: &str): OraPend { return OraPend{owner: owner.toStr(), disc: disc.toStr(), sets: []} }

fn (p: mut &OraPend) set(name: &str, v: Val) { append(mut &p.sets, OraNV{name: name.toStr(), v: v}) }
fn (p: mut &OraPend) s(name: &str, v: &str) { p.set(name, Val.Text(v.toStr())) }
fn (p: mut &OraPend) i(name: &str, n: int) { p.set(name, Val.Int(n)) }
fn (p: mut &OraPend) null(name: &str) { p.set(name, Val.Null) }

// A name as Oracle shows it: one lexdb folded to lower case is its upper case.
fn oraUp(n: &str): str { return if n == strings.toLowerAscii(n) { strings.toUpperAscii(n) } else { n.toStr() } }

fn oraOwner(schema: &str, user: &str): str { return if schema == "public" { strings.toUpperAscii(user) } else { oraUp(schema) } }
fn oraTabName(ct: &CatTab): str { return if len(ct.t.spell) > 0 { ct.t.spell.clone() } else { oraUp(&lexdb_sql.baseName(&ct.name)) } }
fn oraColName(c: &lexdb_sql.ColDef): str { return if len(c.spell) > 0 { c.spell.clone() } else { oraUp(&c.name) } }

// A column's Oracle type: DATA_TYPE, DATA_LENGTH, DATA_PRECISION, DATA_SCALE
// (-1 none), and for a text type its length in characters (0 not text).
fn oraOptInt(n: int): Val { return if n < 0 { Val.Null } else { Val.Int(n) } }

// A template value as its column's type.
fn oraVal(c: &OraCol, s: &str): Val {
    if s == "\x00" { return Val.Null }
    let o = lexOid(c)
    if o == lexdb_sql.OID_INT8 { return Val.Int(strings.parseIntOpt(s).unwrapOr(0)) }
    if o == lexdb_sql.OID_NUMERIC {
        match Decimal.parse(s) {
            Ok(d) { return Val.Num(d) }
            Err(_) { return Val.Null }
        }
    }
    if o == lexdb_sql.OID_FLOAT8 {
        match lexdb_float.parse(s, false) {
            Ok(x) { return Val.Float(x) }
            Err(_) { return Val.Null }
        }
    }
    if o == lexdb_sql.OID_TS {
        match lexdb_time.parseTs(s, lexdb_time.utc()) {
            Ok(u) { return Val.Ts(u) }
            Err(_) { return Val.Null }
        }
    }
    if o == lexdb_sql.OID_BYTEA { return Val.Bytes(lexdb_catalog.hexBytes(s)) }
    return Val.Text(s.toStr())
}

// A value made in code as its column's type (an int in a NUMBER column, a
// text date in a DATE one).
fn oraCoerce(c: &OraCol, v: Val): Val {
    let o = lexOid(c)
    match v {
        Val.Int(n) {
            if o == lexdb_sql.OID_NUMERIC {
                match Decimal.parse(&(n.toStr())) {
                    Ok(d) { return Val.Num(d) }
                    Err(_) { return v }
                }
            }
            return v
        }
        Val.Text(s) {
            if o == lexdb_sql.OID_TS { return oraVal(c, &s) }
            if o == lexdb_sql.OID_NUMERIC || o == lexdb_sql.OID_INT8 { return oraVal(c, &s) }
            return v
        }
        else { return v }
    }
}

fn oraTyped(view: &str, rows: &[][]str): [][]Val {
    let cs = cols(view)
    var out: [][]Val = []
    for r in rows {
        var vs: []Val = []
        for k in 0..len(cs) { append(mut &vs, if k < len(r) { oraVal(&cs[k], &r[k]) } else { Val.Null }) }
        append(mut &out, vs)
    }
    return out
}

// The column of a view that tells a template row's kind (the value a pending row's disc has).
fn oraDiscCol(base: &str): str {
    match base.toStr() {
        "TAB_COLUMNS", "TAB_COLS" { return "DATA_TYPE" }
        "INDEXES" { return "UNIQUENESS" }
        "CONSTRAINTS" { return "CONSTRAINT_TYPE" }
        "OBJECTS", "PROCEDURES" { return "OBJECT_TYPE" }
        "SOURCE", "ERRORS" { return "TYPE" }
        "CATALOG", "TAB_COMMENTS" { return "TABLE_TYPE" }
        else { return "" }
    }
}

// The rows of a view of the ALL_/USER_/DBA_ family from the pending ones: each
// view column from the row's own sets, else the template row (ALL_x's) of its
// kind, else NULL.
fn oraProject(view: &str, fam: &Family, pends: &[]OraPend, userOwner: &str): [][]Val {
    let cs = cols(view)
    let allView = "ALL_" + fam.base
    let tcols = cols(&allView)
    let dc = oraDiscCol(&fam.base)
    var out: [][]Val = []
    var tIdx: []int = []                // each view column's place in the template
    for c in cs {
        var ti = -1
        for k in 0..len(tcols) { if tcols[k].name == c.name { ti = k } }
        append(mut &tIdx, ti)
    }
    for p in pends {
        if fam.scope == "USER" && p.owner != userOwner { continue }
        let tr = template(&allView, &dc, &p.disc)
        var vs: []Val = []
        for k in 0..len(cs) {
            var v = Val.Null
            var found = false
            for nv in p.sets {
                if nv.name == cs[k].name {
                    v = oraCoerce(&cs[k], nv.v.clone())
                    found = true
                }
            }
            if !found && tIdx[k] >= 0 && tIdx[k] < len(tr) { v = oraVal(&cs[k], &tr[tIdx[k]]) }
            // the template's owner is the account the templates were taken from: the object's own owner is this row's
            let cn = &cs[k].name
            if !found && (cn == "OWNER" || cn == "TABLE_OWNER" || cn == "INDEX_OWNER" || cn == "SEQUENCE_OWNER") && len(p.owner) > 0 {
                v = oraCoerce(&cs[k], Val.Text(p.owner.clone()))
            }
            append(mut &vs, v)
        }
        append(mut &out, vs)
    }
    return out
}

// A row of one of the views Oracle has one of for the instance or the session:
// its template row (NULL where it has none) with sets.
fn oraOneRow(view: &str, sets: &[]OraNV): []Val {
    let cs = cols(view)
    let ts = rows(view, "template")
    var vs: []Val = []
    for k in 0..len(cs) { append(mut &vs, if len(ts) > 0 && k < len(ts[0]) { oraVal(&cs[k], &ts[0][k]) } else { Val.Null }) }
    for nv in sets {
        for k in 0..len(cs) { if cs[k].name == nv.name { vs[k] = oraCoerce(&cs[k], nv.v.clone()) } }
    }
    return vs
}

fn oraNV(name: &str, v: Val): OraNV { return OraNV{name: name.toStr(), v: v} }
fn oraNS(name: &str, v: &str): OraNV { return OraNV{name: name.toStr(), v: Val.Text(v.toStr())} }

fn oraSeqLimit(n: int): Val {
    // Oracle's default MAXVALUE is 28 nines; lexdb's is the type's
    if n == 9223372036854775807 {
        match Decimal.parse("9999999999999999999999999999") {
            Ok(d) { return Val.Num(d) }
            Err(_) { return Val.Int(n) }
        }
    }
    return Val.Int(n)
}

fn oraUserId(roles: &[]Role, name: &str): int {
    for i in 0..len(roles) { if roles[i].name == name { return 100 + i } }
    return 100
}

fn oraObject(p: mut &OraPend, name: &str, id: int, typ: &str, generated: bool) {
    p.s("OBJECT_NAME", name)
    p.i("OBJECT_ID", id)
    p.i("DATA_OBJECT_ID", id)
    p.s("OBJECT_TYPE", typ)
    p.s("CREATED", ORA_DATE)
    p.s("LAST_DDL_TIME", ORA_DATE)
    p.s("TIMESTAMP", "2000-01-01:00:00:00")
    p.s("GENERATED", if generated { "Y" } else { "N" })
}

// The default of a column as Oracle shows it (DATA_DEFAULT), "" none.
fn oraDefault(c: &lexdb_sql.ColDef): str {
    if c.identity != lexdb_sql.ID_NONE { return "" }
    match c.def {
        Some(d) { return lexdb_sql.exprText(&lexdb_sql.plainDefault(&d)) }
        None { return "" }
    }
}

// An expression as Oracle's dictionary shows it: names quoted and upper case, no spaces round an operator, functions in upper
// case (a generated column's DATA_DEFAULT, a function-based index's COLUMN_EXPRESSION).
fn oraExprText(x: &Expr): str {
    match x {
        Expr.Col(n, _) {
            let d = strings.indexOf(&n, ".", 0)
            let base: str = if d >= 0 { n[d + 1..len(n)].toStr() } else { n.toStr() }
            return "\"" + oraUp(&base) + "\""
        }
        Expr.Lit(v) {
            match v {
                Val.Null { return "NULL" }
                Val.Text(s) { return "'" + strings.replaceAll(&s, "'", "''") + "'" }
                else { return lexdb_sql.exprText(x) }
            }
        }
        Expr.Unary(op, a) { return (if op == "not" { "NOT " } else { op.toStr() }) + oraExprText(&a) }
        Expr.Bin(op, a, b) {
            if op == "and" || op == "or" { return oraExprText(&a) + " " + strings.toUpperAscii(&op) + " " + oraExprText(&b) }
            return oraExprText(&a) + op + oraExprText(&b)
        }
        Expr.IsNull(a, neg) { return oraExprText(&a) + (if neg { " IS NOT NULL" } else { " IS NULL" }) }
        Expr.Cast(a, t) { return oraExprText(&a) }
        Expr.Call(f, args, star) {
            if f == "case" || f == "case else" {
                var b = "CASE"
                var i = 0
                while i + 1 < len(args) {
                    b += " WHEN " + oraExprText(&args[i]) + " THEN " + oraExprText(&args[i + 1])
                    i += 2
                }
                if f == "case else" && i < len(args) { b += " ELSE " + oraExprText(&args[i]) }
                return b + " END"
            }
            if f == "coalesce" && len(args) == 2 { return "NVL(" + oraExprText(&args[0]) + "," + oraExprText(&args[1]) + ")" }
            if len(args) == 2 && (f == "#ora_add" || f == "#ora_sub" || f == "#ora_cat") {
                let o: &str = if f == "#ora_add" { "+" } else if f == "#ora_sub" { "-" } else { "||" }
                return oraExprText(&args[0]) + o + oraExprText(&args[1])
            }
            var n = f.toStr()
            if strings.startsWith(&n, "#ora_") { n = n[5..len(n)].toStr() }
            // (lexdb's names for to_char and the like have no underscore)
            n = match n.toStr() {
                "tochar" { "to_char" } "todate" { "to_date" } "tonumber" { "to_number" } "totimestamp" { "to_timestamp" }
                "addmonths" { "add_months" } "lastday" { "last_day" } "nextday" { "next_day" } "monthsbetween" { "months_between" }
                else { n }
            }
            var parts: []str = []
            for a in args { append(mut &parts, oraExprText(&a)) }
            return strings.toUpperAscii(&n) + "(" + (if star { "*" } else { strings.join(&parts, ",") }) + ")"
        }
        else { return lexdb_sql.exprText(x) }
    }
}

fn oraIdxName(ix: &CatIdx): str { return oraUp(&ix.name) }

// Whether an index of a constraint has the name lexdb makes when none is given (Oracle's GENERATED = Y: SYS_Cnnn).
fn oraGenIdx(ct: &CatTab, ix: &CatIdx): bool {
    if !ix.con { return false }
    let t = lexdb_sql.baseName(&ct.name)
    return ix.name == t + "_pkey" || (strings.startsWith(&ix.name, &(t + "_")) && strings.endsWith(&ix.name, "_key"))
}

// ALL_TAB_COLUMNS' rows of one table or view.
fn oraColRows(out: mut &[]OraPend, ct: &CatTab, user: &str, view: bool) {
    if lexdb_base.isTempSchema(&ct.schema) { return }
    let owner = oraOwner(&ct.schema, user)
    var n = 0
    for i in 0..len(ct.t.cols) {
        let c = &ct.t.cols[i]
        if c.name == ROWID { continue }
        n += 1
        var nn = c.notNull
        for k in ct.t.pk { if k == i { nn = true } }
        var ty = oraTypeOf(&c.typ)
        // a view's text column has lost its length (lexdb keeps no typmod through a query): Oracle's VARCHAR2, not a CLOB
        if view && ty.dtype == "CLOB" { ty = OraT{dtype: "VARCHAR2", len: 4000, prec: -1, scale: -1, chars: 4000} }
        // an identity column is a plain NUMBER in Oracle (lexdb's is a bigint)
        if (c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT) && ty.dtype == "NUMBER" { ty.scale = -1 }
        var p = oraPend(&owner, &ty.dtype)
        p.s("TABLE_NAME", &oraTabName(ct))
        p.s("COLUMN_NAME", &oraColName(c))
        p.s("DATA_TYPE", &ty.dtype)
        p.i("DATA_LENGTH", ty.len)
        p.set("DATA_PRECISION", oraOptInt(ty.prec))
        p.set("DATA_SCALE", oraOptInt(ty.scale))
        p.s("NULLABLE", if nn { "N" } else { "Y" })
        p.i("COLUMN_ID", n)
        p.i("INTERNAL_COLUMN_ID", n)
        p.i("SEGMENT_COLUMN_ID", n)
        p.s("QUALIFIED_COL_NAME", &oraColName(c))
        var d = oraDefault(c)
        // a generated column's DATA_DEFAULT is its expression, and it is a virtual column
        match c.gen { Some(gx) { d = oraExprText(&gx) } None {} }
        p.s("VIRTUAL_COLUMN", if c.genKind != lexdb_sql.GEN_NONE { "YES" } else { "NO" })
        p.set("DATA_DEFAULT", if len(d) > 0 { Val.Text(d.clone()) } else { Val.Null })
        p.set("DATA_DEFAULT_VC", if len(d) > 0 { Val.Text(d.clone()) } else { Val.Null })
        p.set("DEFAULT_LENGTH", if len(d) > 0 { Val.Int(len(d)) } else { Val.Null })
        let on = lexdb_sql.onNullOf(&c.def)
        p.s("DEFAULT_ON_NULL", if on > 0 { "YES" } else { "NO" })
        p.s("DEFAULT_ON_NULL_UPD", if on > 1 { "YES" } else { "NO" })
        p.s("IDENTITY_COLUMN", if c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT { "YES" } else { "NO" })
        if ty.chars > 0 {
            p.i("CHAR_LENGTH", ty.chars)
            p.i("CHAR_COL_DECL_LENGTH", ty.chars)
        } else if ty.dtype != "VARCHAR2" && ty.dtype != "CHAR" {
            p.i("CHAR_LENGTH", 0)
        }
        append(mut &out, p)
    }
}

fn oraCommentRows(out: mut &[]OraPend, ct: &CatTab, user: &str, tableLevel: bool, isView: bool) {
    if lexdb_base.isTempSchema(&ct.schema) { return }
    let owner = oraOwner(&ct.schema, user)
    if tableLevel {
        var p = oraPend(&owner, if isView { "VIEW" } else { "TABLE" })
        p.s("TABLE_NAME", &oraTabName(ct))
        p.s("TABLE_TYPE", if isView { "VIEW" } else { "TABLE" })
        p.null("COMMENTS")
        append(mut &out, p)
        return
    }
    for c in ct.t.cols {
        if c.name == ROWID { continue }
        var p = oraPend(&owner, &"")
        p.s("TABLE_NAME", &oraTabName(ct))
        p.s("COLUMN_NAME", &oraColName(&c))
        p.null("COMMENTS")
        append(mut &out, p)
    }
}

// Oracle's annotations (lexdb_annot) of a table or view ct: ANNOTATIONS_USAGE's rows, or the names (ANNOTATIONS) or names and values
// (ANNOTATION_VALUES) each once an owner (seen: those listed). A column's or an index's that is no longer there is not listed.
fn oraAnnotRows(out: mut &[]OraPend, seen: mut &[]str, ct: &CatTab, user: &str, base: &str, isView: bool) {
    if lexdb_base.isTempSchema(&ct.schema) { return }
    let ans = lexdb_annot.all(&ct.t.invalid)
    if len(ans) == 0 { return }
    let owner = oraOwner(&ct.schema, user)
    for a in ans {
        var obj = oraTabName(ct)
        var typ = if isView { "VIEW" } else { "TABLE" }
        var col = ""
        var there = len(a.scope) == 0
        if strings.startsWith(&a.scope, "c:") {
            for c in ct.t.cols { if c.name == a.scope[2..len(a.scope)] { col = oraColName(&c); there = true } }
        } else if strings.startsWith(&a.scope, "i:") {
            let ix = a.scope[2..len(a.scope)].toStr()
            for x in ct.t.indexes { if lexdb_sql.baseName(&x.name) == ix { there = true } }
            if lexdb_catalog.hasPk(&ct.t) && lexdb_catalog.pkConName(&ct.t) == ix { there = true }     // (its primary key's)
            obj = oraUp(&ix)
            typ = "INDEX"
        }
        if !there { continue }
        if base != "ANNOTATIONS_USAGE" {
            let k = owner + "\x00" + a.name + (if base == "ANNOTATION_VALUES" { if a.has { "\x00v" + a.value } else { "\x00n" } } else { "" })
            if lexdb_base.hasStr(seen, &k) { continue }
            append(seen, k)
        }
        var p = oraPend(&owner, &"")
        if base == "ANNOTATIONS_USAGE" {
            p.s("OBJECT_NAME", &obj)
            p.s("OBJECT_TYPE", &typ)
            if len(col) > 0 { p.s("COLUMN_NAME", &col) } else { p.null("COLUMN_NAME") }
            p.null("DOMAIN_NAME")
            p.null("DOMAIN_OWNER")
        }
        p.s("ANNOTATION_OWNER", &owner)
        p.s("ANNOTATION_NAME", &a.name)
        if base != "ANNOTATIONS" { if a.has { p.s("ANNOTATION_VALUE", &a.value) } else { p.null("ANNOTATION_VALUE") } }
        append(out, p)
    }
}

fn oraBuilt(snap: &CatSnap, base: &str, roles: &[]Role): []OraPend {
    // objects of the public schema are the login's own only when it has no schema of its name; a user with one
    // has them as the system's (USER_ views list a user's own schema alone)
    var user = snap.user.clone()
    for sc in snap.schemas { if sc == strings.toLowerAscii(&snap.user) && sc != "public" { user = "SYS" } }
    var out: []OraPend = []
    if base == "ANNOTATIONS_USAGE" || base == "ANNOTATIONS" || base == "ANNOTATION_VALUES" {
        var seen: []str = []
        for ct in snap.tabs { oraAnnotRows(mut &out, mut &seen, &ct, &user, base, false) }
        for v in snap.views { oraAnnotRows(mut &out, mut &seen, &v, &user, base, true) }
        return out
    }
    if base == "TABLES" {
        for ct in snap.tabs {
            if lexdb_base.isTempSchema(&ct.schema) { continue }
            var p = oraPend(&oraOwner(&ct.schema, &user), &"")
            p.s("TABLE_NAME", &oraTabName(&ct))
            var ident = false
            for c in ct.t.cols { if c.name != ROWID && (c.identity == lexdb_sql.ID_ALWAYS || c.identity == lexdb_sql.ID_BY_DEFAULT) { ident = true } }
            p.s("HAS_IDENTITY", if ident { "YES" } else { "NO" })
            append(mut &out, p)
        }
        return out
    }
    if base == "TAB_COLUMNS" || base == "TAB_COLS" {
        for ct in snap.tabs { oraColRows(mut &out, &ct, &user, false) }
        for v in snap.views { oraColRows(mut &out, &v, &user, true) }
        return out
    }
    if base == "OBJECTS" {
        for ct in snap.tabs {
            if lexdb_base.isTempSchema(&ct.schema) { continue }
            let owner = oraOwner(&ct.schema, &user)
            var p = oraPend(&owner, &"TABLE")
            oraObject(mut &p, &oraTabName(&ct), ct.oid, &"TABLE", false)
            append(mut &out, p)
            for ix in ct.idxs {
                var q = oraPend(&owner, &"INDEX")
                oraObject(mut &q, &oraIdxName(&ix), ix.oid, &"INDEX", oraGenIdx(&ct, &ix))
                append(mut &out, q)
            }
        }
        for v in snap.views {
            if lexdb_base.isTempSchema(&v.schema) { continue }
            var p = oraPend(&oraOwner(&v.schema, &user), &"VIEW")
            oraObject(mut &p, &oraTabName(&v), v.oid, &"VIEW", false)
            append(mut &out, p)
        }
        for d in snap.seqs {
            if len(d.ownerT) > 0 { continue }
            let sc = lexdb_sql.schemaOf(&d.key)
            if lexdb_base.isTempSchema(&sc) { continue }
            var p = oraPend(&oraOwner(&sc, &user), &"SEQUENCE")
            oraObject(mut &p, &oraUp(&lexdb_sql.baseName(&d.key)), lexdb_catalog.seqOid(&d), &"SEQUENCE", false)
            append(mut &out, p)
        }
        for pr in snap.procs {
            var p = oraPend(&pr.owner, &pr.kind)
            oraObject(mut &p, &pr.name, lexdb_sql.nameOid("p", &(pr.owner + "." + pr.name)), &pr.kind, false)
            p.s("STATUS", if len(pr.err) > 0 { "INVALID" } else { "VALID" })
            p.s("TEMPORARY", "N")
            p.s("SECONDARY", "N")
            p.i("NAMESPACE", 1)
            append(mut &out, p)
        }
        return out
    }
    if base == "PROCEDURES" {
        for pr in snap.procs {
            var p = oraPend(&pr.owner, &pr.kind)
            p.s("OBJECT_NAME", &pr.name)
            p.i("OBJECT_ID", lexdb_sql.nameOid("p", &(pr.owner + "." + pr.name)))
            p.i("SUBPROGRAM_ID", 1)
            p.s("OBJECT_TYPE", &pr.kind)
            p.s("AGGREGATE", "NO")
            p.s("PIPELINED", "NO")
            p.s("PARALLEL", "NO")
            p.s("INTERFACE", "NO")
            p.s("DETERMINISTIC", "NO")
            p.s("AUTHID", "DEFINER")
            append(mut &out, p)
        }
        return out
    }
    if base == "ERRORS" {
        // a unit stored with compilation errors: PLS-nnnnn at its line and column (and, for an error in a statement, Oracle's
        // "PL/SQL: Statement ignored" after it); the error is kept as "line L, column C:", a line feed and the PLS text
        for pr in snap.procs {
            if len(pr.err) == 0 { continue }
            var line = 1
            var col = 1
            var msg = pr.err.toStr()
            let nl = strings.indexOf(&pr.err, "\n", 0)
            if strings.startsWith(&pr.err, "line ") && nl > 0 {
                let head = pr.err[5..nl].toStr()
                let comma = strings.indexOf(&head, ", column ", 0)
                if comma > 0 {
                    line = strings.parseInt(&(head[0..comma].toStr())).unwrapOr(1)
                    var cs = head[comma + 9..len(head)].toStr()
                    if len(cs) > 0 && cs[len(cs) - 1] == ':' { cs = cs[0..len(cs) - 1].toStr() }
                    col = strings.parseInt(&cs).unwrapOr(1)
                    msg = pr.err[nl + 1..len(pr.err)].toStr()
                }
            }
            // (the text of a unit starts at its keyword: CREATE OR REPLACE is no part of the first line's columns)
            if line == 1 {
                let kw = strings.indexOf(&strings.toUpperAscii(&pr.src), &pr.kind, 0)
                if kw > 0 && col > kw { col -= kw }
            }
            let eol = strings.indexOf(&msg, "\n", 0)
            if eol > 0 { msg = msg[0..eol].toStr() }
            var num = 0
            if strings.startsWith(&msg, "PLS-") && len(msg) >= 9 { num = strings.parseInt(&(msg[4..9].toStr())).unwrapOr(0) }
            var texts: []str = [msg]
            var nums: []int = [num]
            if num == 201 || num == 302 || num == 306 || num == 363 || num == 364 || num == 382 {
                append(mut &texts, "PL/SQL: Statement ignored")
                append(mut &nums, 0)
            }
            for k in 0..len(texts) {
                var p = oraPend(&pr.owner, &pr.kind)
                p.s("NAME", &pr.name)
                p.s("TYPE", &pr.kind)
                p.i("SEQUENCE", k + 1)
                p.i("LINE", line)
                p.i("POSITION", col)
                p.s("TEXT", &texts[k])
                p.s("ATTRIBUTE", "ERROR")
                p.i("MESSAGE_NUMBER", nums[k])
                append(mut &out, p)
            }
        }
        return out
    }
    if base == "SOURCE" {
        // the text from the keyword PROCEDURE or FUNCTION on, a row per line
        for pr in snap.procs {
            let up = strings.toUpperAscii(&pr.src)
            var at = strings.indexOf(&up, &pr.kind, 0)
            if at < 0 { at = 0 }
            let lines = strings.split(&pr.src[at..len(pr.src)], "\n")
            for k in 0..len(lines) {
                var p = oraPend(&pr.owner, &pr.kind)
                p.s("NAME", &pr.name)
                p.s("TYPE", &pr.kind)
                p.i("LINE", k + 1)
                p.s("TEXT", &(lines[k] + (if k + 1 < len(lines) { "\n" } else { "" })))
                p.i("ORIGIN_CON_ID", 3)
                append(mut &out, p)
            }
        }
        return out
    }
    if base == "CATALOG" {
        for ct in snap.tabs {
            if lexdb_base.isTempSchema(&ct.schema) { continue }
            var p = oraPend(&oraOwner(&ct.schema, &user), &"TABLE")
            p.s("TABLE_NAME", &oraTabName(&ct))
            p.s("TABLE_TYPE", "TABLE")
            append(mut &out, p)
        }
        for v in snap.views {
            if lexdb_base.isTempSchema(&v.schema) { continue }
            var p = oraPend(&oraOwner(&v.schema, &user), &"VIEW")
            p.s("TABLE_NAME", &oraTabName(&v))
            p.s("TABLE_TYPE", "VIEW")
            append(mut &out, p)
        }
        for d in snap.seqs {
            if len(d.ownerT) > 0 { continue }
            let sc = lexdb_sql.schemaOf(&d.key)
            if lexdb_base.isTempSchema(&sc) { continue }
            var p = oraPend(&oraOwner(&sc, &user), &"SEQUENCE")
            p.s("TABLE_NAME", &oraUp(&lexdb_sql.baseName(&d.key)))
            p.s("TABLE_TYPE", "SEQUENCE")
            append(mut &out, p)
        }
        return out
    }
    if base == "TAB_COMMENTS" || base == "COL_COMMENTS" {
        // (COMMENT ON is accepted and ignored, O3: no comments)
        for ct in snap.tabs { oraCommentRows(mut &out, &ct, &user, base == "TAB_COMMENTS", false) }
        for v in snap.views { oraCommentRows(mut &out, &v, &user, base == "TAB_COMMENTS", true) }
        return out
    }
    if base == "SEQUENCES" {
        for d in snap.seqs {
            if len(d.ownerT) > 0 { continue }
            let sc = lexdb_sql.schemaOf(&d.key)
            if lexdb_base.isTempSchema(&sc) { continue }
            var p = oraPend(&oraOwner(&sc, &user), &"")
            p.s("SEQUENCE_OWNER", &oraOwner(&sc, &user))
            p.s("SEQUENCE_NAME", &oraUp(&lexdb_sql.baseName(&d.key)))
            p.set("MIN_VALUE", Val.Int(d.min))
            p.set("MAX_VALUE", oraSeqLimit(d.max))
            p.i("INCREMENT_BY", d.inc)
            p.s("CYCLE_FLAG", if d.cycle { "Y" } else { "N" })
            p.i("CACHE_SIZE", if d.cache > 1 { d.cache } else { 0 })
            p.i("LAST_NUMBER", d.start)
            append(mut &out, p)
        }
        return out
    }
    if base == "VIEWS" {
        for v in snap.views {
            if lexdb_base.isTempSchema(&v.schema) { continue }
            var p = oraPend(&oraOwner(&v.schema, &user), &"")
            p.s("VIEW_NAME", &oraTabName(&v))
            let text = lexdb_sql.viewShown(&v.t.view)
            p.i("TEXT_LENGTH", len(text))
            p.s("TEXT", &text)
            p.s("TEXT_VC", &text)
            append(mut &out, p)
        }
        return out
    }
    if base == "TAB_IDENTITY_COLS" {
        for ct in snap.tabs {
            if lexdb_base.isTempSchema(&ct.schema) { continue }
            for c in ct.t.cols {
                if c.name == ROWID || (c.identity != lexdb_sql.ID_ALWAYS && c.identity != lexdb_sql.ID_BY_DEFAULT) { continue }
                var p = oraPend(&oraOwner(&ct.schema, &user), &"")
                p.s("TABLE_NAME", &oraTabName(&ct))
                p.s("COLUMN_NAME", &oraColName(&c))
                p.s("GENERATION_TYPE", if c.identity == lexdb_sql.ID_ALWAYS { "ALWAYS" } else { "BY DEFAULT" })
                p.s("SEQUENCE_NAME", &("ISEQ$$_" + ct.oid.toStr()))
                append(mut &out, p)
            }
        }
        return out
    }
    if base == "INDEXES" || base == "IND_COLUMNS" || base == "IND_EXPRESSIONS" {
        for ct in snap.tabs {
            if lexdb_base.isTempSchema(&ct.schema) { continue }
            let owner = oraOwner(&ct.schema, &user)
            var hidden = len(ct.t.cols)          // the hidden columns of function-based indexes: SYS_NCnnnnn$, numbered after the columns
            for c in ct.t.cols { if c.name == ROWID { hidden -= 1 } }
            for ix in ct.idxs {
                var xi = -1
                for k in 0..len(ct.t.indexes) { if lexdb_sql.baseName(&ct.t.indexes[k].name) == ix.name { xi = k } }
                if base == "IND_EXPRESSIONS" {
                    for j in 0..len(ix.cols) {
                        if ix.cols[j] != 0 { continue }
                        hidden += 1
                        if xi < 0 || j >= len(ct.t.indexes[xi].exprs) { continue }
                        var p = oraPend(&owner, &"")
                        p.s("INDEX_OWNER", &owner)
                        p.s("INDEX_NAME", &oraIdxName(&ix))
                        p.s("TABLE_OWNER", &owner)
                        p.s("TABLE_NAME", &oraTabName(&ct))
                        p.s("COLUMN_EXPRESSION", &oraExprText(&ct.t.indexes[xi].exprs[j]))
                        p.i("COLUMN_POSITION", j + 1)
                        append(mut &out, p)
                    }
                    continue
                }
                if base == "INDEXES" {
                    var p = oraPend(&owner, if ix.unique { "UNIQUE" } else { "NONUNIQUE" })
                    p.s("INDEX_NAME", &oraIdxName(&ix))
                    p.s("TABLE_OWNER", &owner)
                    p.s("TABLE_NAME", &oraTabName(&ct))
                    p.s("UNIQUENESS", if ix.unique { "UNIQUE" } else { "NONUNIQUE" })
                    var fn_ = false
                    for c in ix.cols { if c == 0 || (c >= 1 && c <= len(ct.t.cols) && ct.t.cols[c - 1].genKind != lexdb_sql.GEN_NONE) { fn_ = true } }
                    p.s("INDEX_TYPE", if fn_ { "FUNCTION-BASED NORMAL" } else { "NORMAL" })
                    p.s("CONSTRAINT_INDEX", if ix.con { "YES" } else { "NO" })
                    p.s("GENERATED", if oraGenIdx(&ct, &ix) { "Y" } else { "N" })
                    append(mut &out, p)
                } else {
                    for j in 0..len(ix.cols) {
                        var p = oraPend(&owner, &"")
                        p.s("INDEX_OWNER", &owner)
                        p.s("INDEX_NAME", &oraIdxName(&ix))
                        p.s("TABLE_OWNER", &owner)
                        p.s("TABLE_NAME", &oraTabName(&ct))
                        let cn = ix.cols[j]
                        var cname = ""
                        var len_ = 22
                        var chars = 0
                        if cn >= 1 && cn <= len(ct.t.cols) {
                            cname = oraColName(&ct.t.cols[cn - 1])
                            let ty = oraTypeOf(&ct.t.cols[cn - 1].typ)
                            len_ = ty.len
                            chars = ty.chars
                        } else if cn == 0 {
                            hidden += 1
                            cname = "SYS_NC" + strings.padLeft(&hidden.toStr(), 5, '0') + "$"
                        }
                        p.s("COLUMN_NAME", &cname)
                        p.i("COLUMN_POSITION", j + 1)
                        p.i("COLUMN_LENGTH", len_)
                        p.i("CHAR_LENGTH", chars)
                        p.s("DESCEND", if j < len(ix.opts) && strings.contains(&ix.opts[j], "DESC") { "DESC" } else { "ASC" })
                        append(mut &out, p)
                    }
                }
            }
        }
        return out
    }
    if base == "CONSTRAINTS" || base == "CONS_COLUMNS" {
        for c in snap.cons {
            if lexdb_base.isTempSchema(&c.schema) { continue }
            let ti = lexdb_catalog.catTabIdx(snap, c.rel)
            if ti < 0 { continue }
            let ct = &snap.tabs[ti]
            let owner = oraOwner(&c.schema, &user)
            let ty = if c.typ == "p" { "P" } else if c.typ == "u" { "U" } else if c.typ == "f" { "R" } else { "C" }
            if base == "CONSTRAINTS" {
                var p = oraPend(&owner, &ty)
                p.s("CONSTRAINT_NAME", &oraUp(&c.name))
                p.s("CONSTRAINT_TYPE", &ty)
                p.s("TABLE_NAME", &oraTabName(ct))
                if c.typ == "c" {
                    var b = c.check.clone()
                    if strings.startsWith(&b, "(") && strings.endsWith(&b, ")") { b = b[1..len(b) - 1].toStr() }
                    p.s("SEARCH_CONDITION", &b)
                    p.s("SEARCH_CONDITION_VC", &b)
                }
                if c.typ == "f" {
                    // the key it refers to: the primary or UNIQUE constraint on its index
                    var rname = ""
                    var rowner = owner.clone()
                    for k in snap.cons {
                        if (k.typ == "p" || k.typ == "u") && k.rel == c.refRel && k.idx == c.idx {
                            rname = oraUp(&k.name)
                            rowner = oraOwner(&k.schema, &user)
                        }
                    }
                    p.s("R_OWNER", &rowner)
                    p.s("R_CONSTRAINT_NAME", &rname)
                    p.s("DELETE_RULE", if c.del == "c" { "CASCADE" } else if c.del == "n" { "SET NULL" } else { "NO ACTION" })
                }
                if c.typ == "p" || c.typ == "u" {
                    var iname = ""
                    for ix in ct.idxs { if ix.oid == c.idx { iname = oraIdxName(&ix) } }
                    p.s("INDEX_OWNER", &owner)
                    p.s("INDEX_NAME", &iname)
                }
                p.s("DEFERRABLE", if c.deferrable { "DEFERRABLE" } else { "NOT DEFERRABLE" })
                p.s("DEFERRED", if c.deferred { "DEFERRED" } else { "IMMEDIATE" })
                p.s("STATUS", if c.enforced { "ENABLED" } else { "DISABLED" })
                p.s("VALIDATED", if c.valid { "VALIDATED" } else { "NOT VALIDATED" })
                p.s("GENERATED", if lexdb_catalog.sysNamed(&c, &ct.name) { "USER NAME" } else { "GENERATED NAME" })
                append(mut &out, p)
            } else {
                if c.typ == "c" { continue }
                for j in 0..len(c.cols) {
                    let cn = c.cols[j]
                    if cn < 1 || cn > len(ct.t.cols) { continue }
                    var p = oraPend(&owner, &"")
                    p.s("CONSTRAINT_NAME", &oraUp(&c.name))
                    p.s("TABLE_NAME", &oraTabName(ct))
                    p.s("COLUMN_NAME", &oraColName(&ct.t.cols[cn - 1]))
                    p.i("POSITION", j + 1)
                    append(mut &out, p)
                }
            }
        }
        return out
    }
    return out
}

// The object privileges Oracle lists for a letter of lexdb's, "" none (TRUNCATE and TRIGGER are no privilege of its).
fn oraPrivName(letter: &str, kind: &str): str {
    if kind == "sequence" { return if letter == "r" { "SELECT" } else { "" } }
    if kind == "procedure" || kind == "function" { return if letter == "X" { "EXECUTE" } else { "" } }
    return match letter { "r" { "SELECT" } "a" { "INSERT" } "w" { "UPDATE" } "d" { "DELETE" } "x" { "REFERENCES" } else { "" } }
}

// DBA_, ALL_ and USER_TAB_PRIVS: the grants recorded on tables, views and sequences, one row a privilege. USER_ lists those
// the user holds, owns or granted; ALL_ those and the ones to PUBLIC and to the roles it holds; DBA_ every one. The grantor
// is the owner (lexdb has no grant option, so no one else grants).
fn oraTabPrivs(cq: &lexdb_catalog.CatView, view: &str, fam: &Family): [][]Val {
    let snap = &cq.snap
    var user = snap.user.clone()
    for sc in snap.schemas { if sc == strings.toLowerAscii(&snap.user) && sc != "public" { user = "SYS" } }
    let me = strings.toUpperAscii(&snap.user)
    let cs = cols(view)
    var out: [][]Val = []
    for r in lexdb_catalog.privRows(snap) {
        // (SQL Server's routines are no concern of Oracle's)
        if r.dialect == lexdb_sql.RD_TSQL { continue }
        let owner = oraOwner(&r.schema, &user)
        let grantor = strings.toUpperAscii(&r.owner)
        let grantee = if len(r.to) == 0 { "PUBLIC".toStr() } else { strings.toUpperAscii(&r.to) }
        let pn = oraPrivName(&r.letter, &r.kind)
        if len(pn) == 0 { continue }
        if fam.scope == "USER" && owner != me && grantee != me && grantor != me { continue }
        if fam.scope == "ALL" && owner != me && grantee != me && grantor != me && grantee != "PUBLIC" && !lexdb_base.hasStr(&cq.who, &r.to) { continue }
        let tname = if len(r.spell) > 0 { r.spell.clone() } else { oraUp(&r.name) }
        var vs: []Val = []
        for c in cs {
            let n = &c.name
            var v = "NO".toStr()
            if n == "GRANTEE" { v = grantee.clone() }
            else if n == "OWNER" || n == "TABLE_SCHEMA" { v = owner.clone() }
            else if n == "TABLE_NAME" { v = tname.clone() }
            else if n == "GRANTOR" { v = grantor.clone() }
            else if n == "PRIVILEGE" { v = pn.clone() }
            else if n == "TYPE" { v = strings.toUpperAscii(&r.kind) }
            append(mut &vs, Val.Text(v))
        }
        append(mut &out, vs)
    }
    return out
}

// NLS_SESSION_PARAMETERS and V$NLS_PARAMETERS as the session has them: what ALTER SESSION set (the settings oracle.nls_*), and
// what a territory and a language give the others (the formats, the numeric characters, the currencies; the date language and the
// sort), as Oracle Free does; the rest as recorded.
fn nlsFollow(rows: [][]Val, sets: &str): [][]Val {
    var set: Map[str, str] = newMap()
    for l in strings.split(sets, "\n") {
        let t = strings.indexOf(&l, "\t", 0)
        if t > 0 && t + 1 < len(l) && strings.startsWith(&l, "oracle.nls_") { set.put(strings.toUpperAscii(&(l[7..t].toStr())), l[t + 1..len(l)].toStr()) }
    }
    if set.size() == 0 { return rows }
    var derived: Map[str, str] = newMap()
    match set.get(&"NLS_TERRITORY") {
        Some(tn) {
            match lexdb_oraadm.territoryOf(&tn) {
                Some(t) {
                    let tm = t.ts[strings.indexOf(&t.ts, " ", 0) + 1..len(t.ts)].toStr()
                    derived.put("NLS_DATE_FORMAT".toStr(), (t.date).clone())
                    derived.put("NLS_TIMESTAMP_FORMAT".toStr(), (t.ts).clone())
                    derived.put("NLS_TIMESTAMP_TZ_FORMAT".toStr(), (t.tstz).clone())
                    derived.put("NLS_TIME_FORMAT".toStr(), (tm).clone())
                    derived.put("NLS_TIME_TZ_FORMAT".toStr(), ((tm + " TZR")).clone())
                    derived.put("NLS_NUMERIC_CHARACTERS".toStr(), (t.numchars).clone())
                    derived.put("NLS_CURRENCY".toStr(), (t.cur).clone())
                    derived.put("NLS_DUAL_CURRENCY".toStr(), (t.dual).clone())
                    derived.put("NLS_ISO_CURRENCY".toStr(), (t.name).clone())
                }
                None {}
            }
        }
        None {}
    }
    match set.get(&"NLS_LANGUAGE") {
        Some(l) {
            derived.put("NLS_DATE_LANGUAGE".toStr(), (l).clone())
            derived.put("NLS_SORT".toStr(), (lexdb_oraadm.languageSort(&l)).clone())
        }
        None {}
    }
    var out: [][]Val = []
    for r in rows {
        var row = r.clone()
        if len(row) >= 2 {
            let n = lexdb_sql.text(&row[0])
            match set.get(&n) {
                Some(v) { row[1] = Val.Text(v) }
                None {
                    match derived.get(&n) {
                        Some(v) { row[1] = Val.Text(v) }
                        None {}
                    }
                }
            }
        }
        append(mut &out, row)
    }
    return out
}

pub fn viewRows(cq: &lexdb_catalog.CatView, view: &str): Result[[][]Val, DbErr] {
    if !isView(view) { return Ok([]) }
    if strings.endsWith(view, "_TAB_PRIVS") { return Ok(oraTabPrivs(cq, view, &family(view))) }
    let snap = &cq.snap
    let roles = &cq.roles
    let sess = cq.sess
    let userOwner = strings.toUpperAscii(&snap.user)
    let fam = family(view)
    if view == "ALL_USERS" || view == "DBA_USERS" {
        var rows = oraTyped(view, &rows(view, "full"))
        // the roles that log in, and the session's user (a TNS login needs no role under trust)
        var names: []str = []
        for r in roles { if r.login { append(mut &names, r.name.clone()) } }
        var known = false
        for n in names { if n == snap.user { known = true } }
        if !known { append(mut &names, snap.user.clone()) }
        for i in 0..len(names) {
            let uname = strings.toUpperAscii(&names[i])
            append(mut &rows, oraOneRowOf(view, "template", [oraNS("USERNAME", &uname), oraNV("USER_ID", iv(oraUserId(&roles, &names[i]))),
                                                              oraNS("CREATED", ORA_DATE), oraNS("PASSWORD_CHANGE_DATE", ORA_DATE)]))
        }
        return Ok(rows)
    }
    if view == "USER_USERS" {
        return Ok([oraOneRow(view, [oraNS("USERNAME", &userOwner), oraNV("USER_ID", iv(oraUserId(&roles, &snap.user))),
                                    oraNS("CREATED", ORA_DATE), oraNS("PASSWORD_CHANGE_DATE", ORA_DATE)])])
    }
    if view == "V_$SESSION" {
        return Ok([oraOneRow(view, [oraNV("SID", iv(sess)), oraNV("SERIAL#", iv(1)), oraNS("USERNAME", &userOwner),
                                    oraNS("SCHEMANAME", &userOwner), oraNV("USER#", iv(oraUserId(&roles, &snap.user))),
                                    oraNS("STATUS", "ACTIVE"), oraNS("TYPE", "USER"), oraNS("SERVER", "DEDICATED"),
                                    oraNS("MACHINE", &lexdb_dialect.hostName()), oraNS("OSUSER", &snap.user),
                                    oraNS("PROGRAM", "lexdb"), oraNS("SERVICE_NAME", "FREEPDB1"), oraNV("CON_ID", iv(3)),
                                    oraNS("LOGON_TIME", ORA_DATE), oraNS("SQL_ADDRESS", "00"), oraNS("COMMAND", "3")])])
    }
    if view == "V_$INSTANCE" {
        return Ok([oraOneRow(view, [oraNS("INSTANCE_NAME", "lexdb"), oraNS("HOST_NAME", &lexdb_dialect.hostName()),
                                    oraNS("STARTUP_TIME", ORA_DATE), oraNS("STATUS", "OPEN"), oraNS("DATABASE_STATUS", "ACTIVE"),
                                    oraNS("ACTIVE_STATE", "NORMAL")])])
    }
    if view == "V_$DATABASE" {
        // a replica answers as a physical standby open under Active Data Guard (lexdb.md 9.137)
        return Ok([oraOneRow(view, [oraNS("NAME", "LEXDB"), oraNS("CREATED", ORA_DATE),
                                    oraNS("OPEN_MODE", if cq.replica { "READ ONLY WITH APPLY" } else { "READ WRITE" }),
                                    oraNS("DATABASE_ROLE", if cq.replica { "PHYSICAL STANDBY" } else { "PRIMARY" }),
                                    oraNV("CON_ID", iv(0)), oraNS("DB_UNIQUE_NAME", "lexdb")])])
    }
    if view == "NLS_SESSION_PARAMETERS" || view == "V_$NLS_PARAMETERS" { return Ok(nlsFollow(oraTyped(view, &rows(view, "full")), &cq.sets)) }
    if len(fam.scope) > 0 && isBuilt(&fam.base) {
        let pends = oraBuilt(&snap, &fam.base, &roles)
        return Ok(oraProject(view, &fam, &pends, &userOwner))
    }
    return Ok(oraTyped(view, &rows(view, "full")))
}

// A row of kind (its template) with sets, for a view whose template row has a name to replace.
fn oraOneRowOf(view: &str, kind: &str, sets: &[]OraNV): []Val {
    let cs = cols(view)
    let ts = rows(view, kind)
    var vs: []Val = []
    for k in 0..len(cs) { append(mut &vs, if len(ts) > 0 && k < len(ts[0]) { oraVal(&cs[k], &ts[0][k]) } else { Val.Null }) }
    for nv in sets {
        for k in 0..len(cs) { if cs[k].name == nv.name { vs[k] = oraCoerce(&cs[k], nv.v.clone()) } }
    }
    return vs
}
