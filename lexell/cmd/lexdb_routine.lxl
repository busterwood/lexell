// lexdb_routine: stored procedures and functions (design/lexdb-dialect-gaps.md, package F). The catalog records
// (lexdb_sql.Routine, kept by lexdb_catalog) made, replaced, dropped and found; a call's arguments matched to the
// parameters; and PostgreSQL's SQL functions written into the queries that call them. Running a body is the session's:
// lexdb_exec for PostgreSQL's procedures, lexdb_tsql for T-SQL's. This module takes the store and statements only.
import "strings"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_store"
import "./lexdb_catalog"
import "./lexdb_parse"

type Routine = lexdb_sql.Routine
type RParam = lexdb_sql.RParam
type DbErr = lexdb_base.DbErr
type Expr = lexdb_sql.Expr
type Stmt = lexdb_sql.Stmt
type Val = lexdb_sql.Val
type TypeName = lexdb_sql.TypeName

fn err(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

// ---- the catalog's records

// A routine's identity among those of its name: PostgreSQL's, the types of the arguments it is called with (the IN,
// INOUT and VARIADIC ones, comma-separated oids); T-SQL's has none.
pub fn sigOf(r: &Routine): str {
    if r.dialect == lexdb_sql.RD_TSQL { return "" }
    var o: []str = []
    for p in r.params { if p.mode != "out" { append(mut &o, p.typ.oid.toStr()) } }
    return strings.join(&o, ",")
}

// The routines of a dialect named key (a table's key: public's unqualified), every signature.
pub fn find(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, dialect: int, key: &str): Result[[]Routine, DbErr] {
    let pre = lexdb_catalog.routineKey(dialect, key, "")
    let hi = pre + "\xff"
    var out: []Routine = []
    try st.scan(txn, lexdb_catalog.CATALOG, &pre, &hi, fn(en: &lexdb_store.Entry): bool {
        append(mut &out, lexdb_catalog.decRoutine(&en.val))
        return true
    })
    return Ok(out)
}

// The routines of a dialect, whatever their names.
pub fn ofDialect(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, dialect: int): Result[[]Routine, DbErr] {
    var out: []Routine = []
    for r in try lexdb_catalog.allRoutines(st, txn) { if r.dialect == dialect { append(mut &out, r) } }
    return Ok(out)
}

// What a T-SQL routine is: "p" a procedure, "scalar", "inline" or "multi" a function (ALTER keeps the kind).
pub fn tclass(r: &Routine): str {
    if r.kind == lexdb_sql.RK_PROC { return "p" }
    if strings.contains(&r.attrs, "inline") { return "inline" }
    if strings.contains(&r.attrs, "multi") { return "multi" }
    return "scalar"
}

// Makes a routine, or with replace changes the one of its name and signature. taken: the name is a table's, a view's or
// a sequence's (T-SQL's objects share their names). The errors are the dialect's.
pub fn create(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, r: &Routine, replace: bool, taken: bool): Result[Unit, DbErr] {
    let sig = sigOf(r)
    let have = try find(st, txn, r.dialect, &r.key)
    var old: Option[Routine] = None
    for h in have { if sigOf(&h) == sig { old = Some(h) } }
    let base = lexdb_sql.baseName(&r.key)
    if r.dialect == lexdb_sql.RD_TSQL {
        if taken || (old.isSome() && !replace) { return Err(err("TS2714", &("There is already an object named '" + base + "' in the database."))) }
        // OR ALTER and ALTER of a routine of the other kind (a function over a procedure, a scalar over a table-valued one)
        match old {
            Some(o) {
                if tclass(&o) != tclass(r) {
                    return Err(err("TS2010", &("Cannot perform alter on '" + base + "' because it is an incompatible object type.")))
                }
            }
            None {}
        }
    } else {
        match old {
            Some(o) {
                if !replace { return Err(err("42723", &((if r.kind == lexdb_sql.RK_PROC { "procedure" } else { "function" }) + " \"" + base + "\" already exists with same argument types"))) }
                if o.kind != r.kind { return Err(err("42809", &("\"" + base + "\" is not a " + (if r.kind == lexdb_sql.RK_PROC { "procedure" } else { "function" })))) }
                if r.kind == lexdb_sql.RK_FUNC && (o.ret.oid != r.ret.oid || o.ret.kind != r.ret.kind || o.retSet != r.retSet) { return Err(err("42P13", "cannot change return type of existing function")) }
                // the names of the input parameters stay
                var k = 0
                for i in 0..len(o.params) {
                    if o.params[i].mode == "out" { continue }
                    while k < len(r.params) && r.params[k].mode == "out" { k += 1 }
                    if k < len(r.params) && len(o.params[i].name) > 0 && o.params[i].name != r.params[k].name {
                        return Err(err("42P13", &("cannot change name of input parameter \"" + o.params[i].name + "\"")))
                    }
                    k += 1
                }
            }
            None {}
        }
    }
    try txn.put(lexdb_catalog.CATALOG, &(lexdb_catalog.routineKey(r.dialect, &r.key, &sig)), &(lexdb_catalog.encRoutine(r)))
    return Ok(Unit{})
}

// What DROP did to one name: the routines dropped, or the notice for IF EXISTS.
pub type Dropped = record { pub notice: str; pub objs: []str }      // objs: the privileges' objects of the routines dropped (lexdb_catalog.routineObj)

// DROP FUNCTION | PROCEDURE | ROUTINE for one name: kw the keyword; sig the signature written ("*": none); spell the name as
// written; fmt a type's name for the messages (oid to text); roles and super: who drops.
pub fn dropOne(st: &lexdb_store.Store, txn: mut &lexdb_store.Txn, dialect: int, key: &str, sig: &str, kw: &str, spell: &str, ifExists: bool,
               fmt: &fn(int): str, roles: &[]str, super: bool): Result[Dropped, DbErr] {
    let have = try find(st, txn, dialect, key)
    var hit: []Routine = []
    if dialect == lexdb_sql.RD_TSQL {
        for h in have { if (kw == "procedure" && h.kind == lexdb_sql.RK_PROC) || (kw == "function" && h.kind == lexdb_sql.RK_FUNC) || kw == "routine" { append(mut &hit, h.clone()) } }
        if len(hit) == 0 && len(have) > 0 {
            // a routine of the other kind
            let other = if have[0].kind == lexdb_sql.RK_PROC { "procedure" } else { "function" }
            return Err(err("TS3705", &("Cannot use DROP " + strings.toUpperAscii(kw) + " with '" + spell + "' because '" + spell + "' is a " + other + ". Use DROP " + strings.toUpperAscii(&other) + ".")))
        }
        if len(hit) == 0 {
            if ifExists { return Ok(Dropped{notice: "", objs: []}) }
            return Err(err("TS3701", &("Cannot drop the " + kw + " '" + spell + "', because it does not exist or you do not have permission.")))
        }
    } else {
        for h in have {
            if sig == "*" {
                if kw == "routine" || (kw == "function" && h.kind == lexdb_sql.RK_FUNC) || (kw == "procedure" && h.kind == lexdb_sql.RK_PROC) { append(mut &hit, h) }
            } else if sigOf(&h) == sig {
                append(mut &hit, h)
            }
        }
        let what = kw.toStr()
        if len(hit) == 0 {
            var shown = "()"
            if sig != "*" {
                var ts: []str = []
                if len(sig) > 0 { for o in strings.split(sig, ",") { append(mut &ts, fmt(lexdb_base.num(&o))) } }
                shown = "(" + strings.join(&ts, ", ") + ")"
            }
            if ifExists { return Ok(Dropped{notice: what + " " + spell + shown + " does not exist, skipping", objs: []}) }
            if sig == "*" { return Err(err("42883", &("could not find a " + what + " named \"" + spell + "\""))) }
            return Err(err("42883", &(what + " " + spell + shown + " does not exist")))
        }
        if len(hit) > 1 { return Err(err("42725", &(what + " name \"" + spell + "\" is not unique"))) }
        let h = &hit[0]
        let isProc = h.kind == lexdb_sql.RK_PROC
        if (kw == "function" && isProc) || (kw == "procedure" && !isProc) {
            var ts: []str = []
            for p in h.params { if p.mode != "out" { append(mut &ts, fmt(p.typ.oid)) } }
            return Err(err("42809", &(spell + "(" + strings.join(&ts, ", ") + ") is not a " + kw)))
        }
    }
    var objs: []str = []
    for h in hit {
        if !super && !lexdb_base.hasStr(roles, &h.owner) {
            return Err(err("42501", &("must be owner of " + (if h.kind == lexdb_sql.RK_PROC { "procedure" } else { "function" }) + " " + spell)))
        }
        txn.del(lexdb_catalog.CATALOG, &(lexdb_catalog.routineKey(dialect, key, &sigOf(&h))))
        append(mut &objs, lexdb_catalog.routineObjOf(&h))
    }
    return Ok(Dropped{notice: "", objs: objs})
}

// The names of PostgreSQL's SQL functions, kept in the store's memo once known (a function made adds to it; one dropped is
// left: a name more only costs a look at the catalog).
const FN_KEY: str = "rtn.fn"

pub fn knownNames(st: &lexdb_store.Store): Option[[]str] {
    match st.memo.get(&FN_KEY) {
        Some(v) {
            var out: []str = []
            if len(v) == 0 { return Some(out) }
            for n in strings.split(&v, "\x00") { if len(n) > 0 { append(mut &out, n.toStr()) } }
            return Some(out)
        }
        None { return None }
    }
}

pub fn setNames(st: &lexdb_store.Store, names: &[]str) {
    var b = ""
    for n in names { b += n + "\x00" }
    st.memo.put(&FN_KEY, &b)
    namesAt += 1
}

// The generation of the names (any store's in the process): moved by every setNames, so a session that cached the list
// (Session.fnNames) looks again only when it has moved. The process's tasks share one thread, so a plain counter.
var namesAt: int = 0

pub fn namesGen(): int { return namesAt }

// A function named base was made (its transaction may not have committed: the list only has to hold every name some
// transaction can see; a name more costs a look at the catalog). Before the list is built, the name is kept aside
// (FN_EXTRA) for loadNames: else a list built from a transaction that could not see this one's uncommitted function
// would leave it out after it commits.
pub fn noteFunction(st: &lexdb_store.Store, base: &str) {
    match knownNames(st) {
        Some(ns) {
            if !lexdb_base.hasStr(&ns, base) {
                var all = ns.clone()
                append(mut &all, base.toStr())
                setNames(st, &all)
            }
        }
        None {
            let x = st.memo.get(&FN_EXTRA).unwrapOr("")
            st.memo.put(&FN_EXTRA, &(x + base + "\x00"))
            namesAt += 1
        }
    }
}

// Names made before the list was built (noteFunction).
const FN_EXTRA: str = "rtn.fnx"

// The list built: the names the catalog gave (read first, by the caller) and those kept aside, set with no
// suspension between the read of the aside names and the set, so a function made meanwhile is not lost.
pub fn loadNames(st: &lexdb_store.Store, fromCatalog: []str): []str {
    var all = fromCatalog
    match st.memo.get(&FN_EXTRA) {
        Some(x) { for n in strings.split(&x, "\x00") { if len(n) > 0 && !lexdb_base.hasStr(&all, n) { append(mut &all, n.toStr()) } } }
        None {}
    }
    setNames(st, &all)
    st.memo.del(&FN_EXTRA)
    return all
}

// ---- a call's arguments

// The slot of each parameter of r in a call of nargs arguments (names: each one's name, "" by place): the argument's
// place, or -1 for a default (and for an output parameter a function call leaves out). None: the call does not fit r.
// A procedure's arguments run over all its parameters, a function's over its inputs (PostgreSQL's CALL names the
// outputs, a query's function call does not).
pub fn slots(r: &Routine, nargs: int, names: &[]str): Option[[]int] {
    let proc = r.kind == lexdb_sql.RK_PROC
    var out: []int = []
    for p in r.params { append(mut &out, -2) }
    var k = 0
    var named = false
    for a in 0..nargs {
        let nm = if a < len(names) { names[a].toStr() } else { "" }
        if len(nm) == 0 {
            if named { return None }
            while k < len(r.params) && !proc && r.params[k].mode == "out" { k += 1 }
            if k >= len(r.params) { return None }
            out[k] = a
            k += 1
        } else {
            named = true
            var f = -1
            for i in 0..len(r.params) { if r.params[i].name == nm && (proc || r.params[i].mode != "out") { f = i } }
            if f < 0 || out[f] != -2 { return None }
            out[f] = a
        }
    }
    for i in 0..len(r.params) {
        if out[i] == -2 {
            if r.params[i].mode == "out" {
                if proc { return None }         // a procedure's call gives its outputs too
                out[i] = -1
            }
            else if r.params[i].has { out[i] = -1 }
            else { return None }
        }
    }
    return Some(out)
}

// Whether a value's kind is the kind of a parameter's type (the overload that fits the arguments best).
pub fn kindFits(v: &Val, t: &TypeName): bool {
    match v {
        Val.Int(_) { return t.kind == lexdb_sql.K_INT }
        Val.Text(_) { return t.kind == lexdb_sql.K_TEXT }
        Val.Bool(_) { return t.kind == lexdb_sql.K_BOOL }
        Val.Num(_) { return t.kind == lexdb_sql.K_NUM }
        else { return false }
    }
}

// ---- a body's parameters

// The text of a body with each use of a named input parameter written as $n (its place among the inputs, from 1): fname.name
// too. A name after a "." or before a "(" is a column's or a function's, and stays; so does a name in skip (a column of a
// table the body reads: PostgreSQL's columns win over parameters).
pub fn bindNames(body: &str, fname: &str, r: &Routine, skip: &[]str): Result[str, DbErr] {
    var names: []str = []
    var nums: []int = []
    var n = 0
    for p in r.params {
        if p.mode == "out" { continue }
        n += 1
        if len(p.name) > 0 && !lexdb_base.hasStr(skip, &p.name) {
            append(mut &names, p.name.clone())
            append(mut &nums, n)
        }
    }
    if len(names) == 0 { return Ok(body.toStr()) }
    return lexdb_parse.substParams(body, fname, &names, &nums)
}

// The error for a call of a routine the session may not use (r.denied: the privilege it lacks): PostgreSQL's 42501, SQL Server's 229.
pub fn deniedErr(r: &Routine): DbErr {
    if r.dialect == lexdb_sql.RD_TSQL {
        let sc = lexdb_sql.schemaOf(&r.key)
        return err("TS229", &("The " + (if r.denied == "r" { "SELECT" } else { "EXECUTE" }) + " permission was denied on the object '" + lexdb_sql.baseName(&r.key) + "', database 'lexdb', schema '" +
                              (if sc == "public" { "dbo" } else { sc }) + "'."))
    }
    if r.denied == "U" { return err("42501", &("permission denied for schema " + lexdb_sql.schemaOf(&r.key))) }
    return err("42501", &("permission denied for " + (if r.kind == lexdb_sql.RK_PROC { "procedure " } else { "function " }) + lexdb_sql.baseName(&r.key)))
}

// ---- PostgreSQL's SQL functions in queries

pub fn mapE(x: &Expr, f: &fn(&Expr): Option[Expr]): Expr {
    match f(x) {
        Some(y) { return y }
        None {}
    }
    match x {
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), mapE(&a, f)) }
        Expr.Bin(op, a, b) { return Expr.Bin(op.clone(), mapE(&a, f), mapE(&b, f)) }
        Expr.IsNull(a, neg) { return Expr.IsNull(mapE(&a, f), neg) }
        Expr.Call(nm, args, star) {
            var out: []Expr = []
            for a in args { append(mut &out, mapE(&a, f)) }
            return Expr.Call(nm.clone(), out, star)
        }
        Expr.Cast(a, t) { return Expr.Cast(mapE(&a, f), t) }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

fn mapO(x: &Option[Expr], f: &fn(&Expr): Option[Expr]): Option[Expr] {
    match x {
        Some(e) { return Some(mapE(&e, f)) }
        None { return None }
    }
}

fn mapWin(w: &lexdb_sql.WinDef, f: &fn(&Expr): Option[Expr]): lexdb_sql.WinDef {
    var out = w.clone()
    out.call = mapE(&w.call, f)
    for i in 0..len(w.part) { out.part[i] = mapE(&w.part[i], f) }
    for i in 0..len(w.order) { out.order[i].expr = mapE(&w.order[i].expr, f) }
    out.frame.startOff = mapO(&w.frame.startOff, f)
    out.frame.endOff = mapO(&w.frame.endOff, f)
    return out
}

// s with f applied to each of its expressions (and its subqueries'): f's Some replaces the expression it was given.
pub fn mapStmt(s: &Stmt, f: &fn(&Expr): Option[Expr]): Stmt {
    var out = mapStmtTop(s, f)
    for i in 0..len(s.subs) { out.subs[i] = mapStmt(&s.subs[i], f) }
    for i in 0..len(s.inner) { out.inner[i] = mapStmt(&s.inner[i], f) }
    return out
}

// mapStmt for the statement's own expressions only.
pub fn mapStmtTop(s: &Stmt, f: &fn(&Expr): Option[Expr]): Stmt {
    var out = s.clone()
    for i in 0..len(s.items) { out.items[i].expr = mapO(&s.items[i].expr, f) }
    out.where = mapO(&s.where, f)
    for i in 0..len(s.group) { out.group[i] = mapE(&s.group[i], f) }
    for i in 0..len(s.order) { out.order[i].expr = mapE(&s.order[i].expr, f) }
    out.limit = mapO(&s.limit, f)
    out.offset = mapO(&s.offset, f)
    out.having = mapO(&s.having, f)
    for i in 0..len(s.sets) { out.sets[i].expr = mapE(&s.sets[i].expr, f) }
    for i in 0..len(s.rows) { for j in 0..len(s.rows[i]) { out.rows[i][j] = mapE(&s.rows[i][j], f) } }
    for i in 0..len(s.exprs) { out.exprs[i] = mapE(&s.exprs[i], f) }
    for i in 0..len(s.distinctOn) { out.distinctOn[i] = mapE(&s.distinctOn[i], f) }
    for i in 0..len(s.from) { out.from[i].on = mapO(&s.from[i].on, f) }
    for i in 0..len(s.wins) { out.wins[i] = mapWin(&s.wins[i], f) }
    for i in 0..len(s.merges) {
        out.merges[i].cond = mapO(&s.merges[i].cond, f)
        for j in 0..len(s.merges[i].sets) { out.merges[i].sets[j].expr = mapE(&s.merges[i].sets[j].expr, f) }
        for j in 0..len(s.merges[i].vals) { out.merges[i].vals[j] = mapE(&s.merges[i].vals[j], f) }
    }
    return out
}

// Whether a statement calls a function of one of these names (lower case, unqualified): its expressions walked.
pub fn callsAny(s: &Stmt, names: &[]str): bool { return len(callNames(s, names)) > 0 }

fn srfNames(s: &Stmt, names: &[]str, found: mut &[]str) {
    if strings.startsWith(&s.srf, "#pgf:") {
        let b = lexdb_sql.baseName(&s.srf[5..len(s.srf)])
        if lexdb_base.hasStr(names, &b) && !lexdb_base.hasStr(found, &b) { append(found, b.toStr()) }
    }
    for x in s.subs { srfNames(&x, names, found) }
    for x in s.inner { srfNames(&x, names, found) }
}

// The names among these that a statement calls.
pub fn callNames(s: &Stmt, names: &[]str): []str {
    var found: []str = []
    srfNames(s, names, mut &found)
    let t = mapStmt(s, fn(x: &Expr): Option[Expr] {
        match x {
            Expr.Call(nm, args, star) {
                let b = lexdb_sql.baseName(&nm)
                for n in names { if n == b && !lexdb_base.hasStr(&found, &b) { append(mut &found, b.toStr()) } }
            }
            else {}
        }
        return None
    })
    return found
}

// The routine a call resolves to: by name through the schemas of path (a qualified name: its schema), then by the number of
// its arguments. A procedure of that name is an error here (42809): a query calls functions.
fn resolve(fns: &[]Routine, path: &[]str, name: &str, nargs: int): Result[Option[Routine], DbErr] {
    let base = lexdb_sql.baseName(name)
    let qualified = lexdb_sql.isQual(name)
    let sch: []str = if qualified { [lexdb_sql.schemaOf(name)] } else { path.clone() }
    for sc in sch {
        let key = lexdb_sql.qual(&sc, &base)
        for r in fns {
            if r.key == key && !r.retSet {
                let names: []str = []
                if slots(&r, nargs, &names).isNone() { continue }
                if r.kind == lexdb_sql.RK_PROC {
                    var d = err("42809", &(base + "() is a procedure"))
                    d.hint = "To call a procedure, use CALL."
                    return Err(d)
                }
                if len(r.denied) > 0 { return Err(deniedErr(&r)) }
                return Ok(Some(r.clone()))
            }
        }
    }
    return Ok(None)
}

// The set-returning function a FROM item calls: by name through the path, then by what its arguments (each one's name, "" by place) fit.
fn resolveSrf(fns: &[]Routine, path: &[]str, name: &str, nargs: int, names: &[]str): Option[Routine] {
    let base = lexdb_sql.baseName(name)
    let sch: []str = if lexdb_sql.isQual(name) { [lexdb_sql.schemaOf(name)] } else { path.clone() }
    for sc in sch {
        let key = lexdb_sql.qual(&sc, &base)
        for r in fns {
            if r.key == key && r.retSet && r.kind == lexdb_sql.RK_FUNC && r.dialect == lexdb_sql.RD_PG && slots(&r, nargs, names).isSome() { return Some(r.clone()) }
        }
    }
    return None
}

// A set-returning function's columns: its OUT (or TABLE) parameters', else one named for the function.
fn srfColumns(r: &Routine): []str {
    var out: []str = []
    for p in r.params {
        if p.mode == "out" { append(mut &out, if len(p.name) > 0 { p.name.clone() } else { "column" + (len(out) + 1).toStr() }) }
    }
    if len(out) == 0 { append(mut &out, lexdb_sql.baseName(&r.key)) }
    return out
}

// The set-returning function an item of FROM (f: its arguments the items of subs[f.sub]) calls, written as its query in the same
// place: items to the new FROM list. An argument that reads a column comes through a derived table of one row, before it.
fn inlineSrf(t: mut &Stmt, f: &lexdb_sql.FromItem, fns: &[]Routine, path: &[]str, nfrom: mut &[]lexdb_sql.FromItem, depth: int): Result[Unit, DbErr] {
    let call = t.subs[f.sub].clone()
    let key = call.srf[5..len(call.srf)].toStr()
    let shown = if len(call.spell) > 0 { call.spell.clone() } else { lexdb_sql.baseName(&key) }
    var args: []Expr = []
    var names: []str = []
    for it in call.items {
        match it.expr {
            Some(x) {
                append(mut &args, lexdb_sql.cloneExpr(&x))
                append(mut &names, it.alias.clone())
            }
            None {}
        }
    }
    let found = resolveSrf(fns, path, &key, len(args), &names)
    if found.isNone() {
        var ts: []str = []
        for a in args { append(mut &ts, "unknown") }
        var d = err("42883", &("function " + shown + "(" + strings.join(&ts, ", ") + ") does not exist"))
        d.hint = "No function matches the given name and argument types. You might need to add explicit type casts."
        return Err(d)
    }
    let r = found.unwrap()
    if len(r.denied) > 0 { return Err(deniedErr(&r)) }
    if depth > 32 { return Err(err("54001", "stack depth limit exceeded")) }
    if call.ordin { return Err(err("0A000", &("lexdb: WITH ORDINALITY on the function " + shown + " is not supported yet"))) }
    let fname = lexdb_sql.baseName(&r.key)
    let sl = slots(&r, len(args), &names).unwrap()
    let bound = try bindNames(&r.body, &fname, &r, &[])
    let stmts = try lexdb_parse.parse(&bound)
    if len(stmts) != 1 || stmts[0].kind != lexdb_sql.S_SELECT {
        return Err(err("0A000", &("lexdb: the function " + fname + " cannot be used in FROM yet: its body must be one SELECT")))
    }
    // the input parameters' arguments, converted to the parameters' types (a default's text parsed where it is used)
    var vals: []Expr = []
    var aitems: []lexdb_sql.SelItem = []
    let at = len(t.subs)
    let aalias = "__pgf" + at.toStr()
    var n = 0
    for i in 0..len(r.params) {
        if r.params[i].mode == "out" { continue }
        var a: Expr = Expr.Lit(Val.Null)
        if sl[i] >= 0 { a = lexdb_sql.cloneExpr(&args[sl[i]]) } else { a = try lexdb_parse.parseExpr(&r.params[i].dflt) }
        let c = Expr.Cast(a, r.params[i].typ)
        if constArg(&c) {
            append(mut &vals, c)
        } else {
            let cn = "__a" + n.toStr()
            append(mut &aitems, lexdb_sql.SelItem{star: false, qual: "", expr: Some(c), alias: cn.clone(), spell: cn.clone()})
            append(mut &vals, Expr.Col(aalias + "." + cn, -1))
        }
        n += 1
    }
    var body = mapStmt(&stmts[0], fn(x: &Expr): Option[Expr] {
        match x {
            Expr.Param(k) {
                if k >= 1 && k <= len(vals) { return Some(lexdb_sql.cloneExpr(&vals[k - 1])) }
                return None
            }
            else { return None }
        }
    })
    body.use = lexdb_sql.SUB_FROM
    body.params = 0
    body.src = ""
    // (its own calls of functions)
    match try inlineCallsAt(&body, fns, path, depth + 1) {
        Some(b2) { body = b2 }
        None {}
    }
    var g = f.clone()
    g.table = ""
    // the columns: those the function declares, the first ones renamed by a list the call gave (a scalar one's column by its alias)
    var cols = srfColumns(&r)
    var hasOut = false
    for q in r.params { if q.mode == "out" { hasOut = true } }
    if len(f.cols) > 0 {
        for k in 0..len(f.cols) { if k < len(cols) { cols[k] = f.cols[k].clone() } }
    } else if !hasOut && f.alias != fname {
        cols[0] = f.alias.clone()
    }
    g.cols = cols
    t.subs[f.sub] = body
    if len(aitems) > 0 {
        var a = lexdb_sql.newStmt(lexdb_sql.S_SELECT)
        a.use = lexdb_sql.SUB_FROM
        a.items = aitems
        a.subs = call.subs.clone()
        a.wins = call.wins.clone()
        append(mut &t.subs, a)
        let first = f.join == lexdb_sql.J_FIRST
        append(nfrom, lexdb_sql.FromItem{table: "", alias: aalias, join: if first { lexdb_sql.J_FIRST } else { lexdb_sql.J_CROSS }, on: None, sub: at, cols: [],
                                         work: -1, lateral: true, using: [], natural: false, comma: f.comma})
        g.comma = false
        if first { g.join = lexdb_sql.J_CROSS }
    }
    append(nfrom, g)
    return Ok(Unit{})
}

// Whether an argument is a value the statement is given (no column, no subquery of its own).
pub fn constArg(x: &Expr): bool {
    match x {
        Expr.Lit(_) { return true }
        Expr.Param(_) { return true }
        Expr.Col(_, _) { return false }
        Expr.Unary(_, a) { return constArg(&a) }
        Expr.Bin(_, a, b) { return constArg(&a) && constArg(&b) }
        Expr.IsNull(a, _) { return constArg(&a) }
        Expr.Cast(a, _) { return constArg(&a) }
        Expr.Call(n, args, _) {
            if len(n) > 0 && n[0] == '#' { return false }
            for a in args { if !constArg(&a) { return false } }
            return true
        }
    }
}

// What a function's call becomes: its body's expression with the arguments for its parameters, or, for a body that reads
// tables, a scalar subquery of the statement (added to extra: the statement's subs from base) over arguments that are
// values.
fn expand(r: &Routine, args: &[]Expr, extra: mut &[]Stmt, base: int): Result[Expr, DbErr] {
    let fname = lexdb_sql.baseName(&r.key)
    let bound = try bindNames(&r.body, &fname, r, &[])
    let stmts = try lexdb_parse.parse(&bound)
    let names: []str = []
    let sl = slots(r, len(args), &names).unwrap()
    // the input parameters' arguments (a default's text parsed where it is used)
    var ins: []Expr = []
    var strictNull: []Expr = []
    var allConst = true
    for i in 0..len(r.params) {
        if r.params[i].mode == "out" { continue }
        var a: Expr = Expr.Lit(Val.Null)
        if sl[i] >= 0 { a = lexdb_sql.cloneExpr(&args[sl[i]]) } else { a = try lexdb_parse.parseExpr(&r.params[i].dflt) }
        if !constArg(&a) { allConst = false }
        let c = Expr.Cast(a, r.params[i].typ)
        append(mut &strictNull, Expr.IsNull(lexdb_sql.cloneExpr(&c), false))
        append(mut &ins, c)
    }
    let subst = fn(x: &Expr): Option[Expr] {
        match x {
            Expr.Param(n) {
                if n >= 1 && n <= len(ins) { return Some(lexdb_sql.cloneExpr(&ins[n - 1])) }
                return None
            }
            else { return None }
        }
    }
    // the last statement is the value (PostgreSQL's: a function's final SELECT)
    if len(stmts) == 0 || stmts[len(stmts) - 1].kind != lexdb_sql.S_SELECT || len(stmts[len(stmts) - 1].items) != 1 || stmts[len(stmts) - 1].items[0].star {
        return Err(err("0A000", &("lexdb: the function " + fname + " cannot be used in a query yet: its body must end in a SELECT of one value")))
    }
    let b = &stmts[len(stmts) - 1]
    let simple = len(stmts) == 1 && len(b.from) == 0 && b.where.isNone() && len(b.group) == 0 && b.having.isNone() && len(b.order) == 0 && b.limit.isNone() &&
                 b.offset.isNone() && !b.distinct && len(b.subs) == 0 && len(b.wins) == 0 && b.items[0].expr.isSome() && len(b.assign) == 0 && b.setop == 0
    var e: Expr = Expr.Lit(Val.Null)
    if simple {
        let body = b.items[0].expr.clone().unwrap()
        e = mapE(&body, subst)
    } else {
        if len(stmts) > 1 { return Err(err("0A000", &("lexdb: the function " + fname + " cannot be used in a query yet: its body must be one SELECT"))) }
        if !allConst { return Err(err("0A000", &("lexdb: the function " + fname + " reads tables: it cannot be given a column or a subquery as an argument yet"))) }
        var sq = mapStmt(b, subst)
        sq.use = lexdb_sql.SUB_SCALAR
        sq.params = 0
        sq.src = ""
        append(extra, sq)
        e = Expr.Call("#sub", [Expr.Lit(Val.Int(base + len(extra) - 1))], false)
    }
    if r.ret.oid != 0 && r.ret.oid != 2278 && r.ret.oid != 2249 { e = Expr.Cast(e, r.ret) }
    if strings.contains(&r.attrs, "strict") && len(strictNull) > 0 {
        var cond = lexdb_sql.cloneExpr(&strictNull[0])
        for i in 1..len(strictNull) { cond = Expr.Bin("or", cond, lexdb_sql.cloneExpr(&strictNull[i])) }
        e = Expr.Call("case else", [cond, Expr.Lit(Val.Null), e], false)
    }
    return Ok(e)
}

// x with the calls of PostgreSQL's SQL functions in it written as their bodies (the arguments' first).
fn inlineExpr(x: &Expr, fns: &[]Routine, path: &[]str, depth: int, failure: mut &Option[DbErr], changed: mut &bool, extra: mut &[]Stmt, base: int): Expr {
    match x {
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), inlineExpr(&a, fns, path, depth, failure, changed, extra, base)) }
        Expr.Bin(op, a, b) {
            let l = inlineExpr(&a, fns, path, depth, failure, changed, extra, base)
            return Expr.Bin(op.clone(), l, inlineExpr(&b, fns, path, depth, failure, changed, extra, base))
        }
        Expr.IsNull(a, neg) { return Expr.IsNull(inlineExpr(&a, fns, path, depth, failure, changed, extra, base), neg) }
        Expr.Cast(a, t) { return Expr.Cast(inlineExpr(&a, fns, path, depth, failure, changed, extra, base), t) }
        Expr.Call(nm, args, star) {
            var done: []Expr = []
            for a in args { append(mut &done, inlineExpr(&a, fns, path, depth, failure, changed, extra, base)) }
            if star || len(nm) == 0 || nm[0] == '#' { return Expr.Call(nm.clone(), done, star) }
            match resolve(fns, path, &nm, len(done)) {
                Ok(found) {
                    match found {
                        Some(r) {
                            if depth > 32 {
                                if failure.isNone() { failure = Some(err("54001", "stack depth limit exceeded")) }
                                return lexdb_sql.cloneExpr(x)
                            }
                            match expand(&r, &done, extra, base) {
                                Ok(e) {
                                    changed = true
                                    return inlineExpr(&e, fns, path, depth + 1, failure, changed, extra, base)
                                }
                                Err(e) {
                                    if failure.isNone() { failure = Some(e) }
                                    return lexdb_sql.cloneExpr(x)
                                }
                            }
                        }
                        None { return Expr.Call(nm.clone(), done, star) }
                    }
                }
                Err(e) {
                    if failure.isNone() { failure = Some(e) }
                    return lexdb_sql.cloneExpr(x)
                }
            }
        }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

// s with the calls of PostgreSQL's SQL functions (fns: all of them, in the catalog) written as their bodies; None when it
// calls none. A body that reads tables becomes a subquery of the statement, so each statement and subquery is done by itself.
pub fn inlineCalls(s: &Stmt, fns: &[]Routine, path: &[]str): Result[Option[Stmt], DbErr] { return inlineCallsAt(s, fns, path, 0) }

fn inlineCallsAt(s: &Stmt, fns: &[]Routine, path: &[]str, depth: int): Result[Option[Stmt], DbErr] {
    var failure: Option[DbErr] = None
    var changed = false
    var extra: []Stmt = []
    let base = len(s.subs)
    var t = mapStmtTop(s, fn(x: &Expr): Option[Expr] { return Some(inlineExpr(x, fns, path, 0, mut &failure, mut &changed, mut &extra, base)) })
    match failure {
        Some(e) { return Err(e) }
        None {}
    }
    for i in 0..len(t.subs) {
        match try inlineCallsAt(&t.subs[i], fns, path, depth) {
            Some(u) {
                t.subs[i] = u
                changed = true
            }
            None {}
        }
    }
    for i in 0..len(t.inner) {
        match try inlineCallsAt(&t.inner[i], fns, path, depth) {
            Some(u) {
                t.inner[i] = u
                changed = true
            }
            None {}
        }
    }
    for x in extra { append(mut &t.subs, x) }
    // the set-returning functions in FROM
    var any = false
    for f in t.from { if f.sub >= 0 && f.sub < len(t.subs) && strings.startsWith(&t.subs[f.sub].srf, "#pgf:") { any = true } }
    if any {
        var nfrom: []lexdb_sql.FromItem = []
        let from = t.from.clone()
        for f in from {
            if f.sub >= 0 && f.sub < len(t.subs) && strings.startsWith(&t.subs[f.sub].srf, "#pgf:") {
                try inlineSrf(mut &t, &f, fns, path, mut &nfrom, depth)
            } else {
                append(mut &nfrom, f)
            }
        }
        t.from = nfrom
        changed = true
    }
    if !changed { return Ok(None) }
    return Ok(Some(t))
}

// ---- T-SQL's functions of the user's in queries (package F, slice F2)
//
// A scalar call, dbo.f(args) (the parser names it "dbo.f" and marks the statement), is written Cast(#udf("f", args), result type)
// for the evaluator, which runs the function's program (lexdb_udf); an inline table-valued function in FROM is written as its
// query, the arguments put in for the parameters (a column the call reads comes through a derived table of one row, so that
// no name in the function's query can capture it).

// A routine's catalog key from a call's name: dbo's is the bare name, as tables'.
pub fn tsqlKey(nm0: &str): str {
    let nm = strings.replaceAll(nm0, lexdb_sql.QSEP, ".")
    let parts = strings.split(nm, ".")
    let base = parts[len(parts) - 1].toStr()
    let sch = if len(parts) >= 2 { parts[len(parts) - 2].toStr() } else { "dbo" }
    return if sch == "dbo" { base } else { sch + "." + base }
}

fn argCountErr(nm: &str, n: int, want: int): DbErr {
    if n > want { return err("TS8144", &("Procedure or function " + nm + " has too many arguments specified.")) }
    return err("TS313", &("An insufficient number of arguments were supplied for the procedure or function " + nm + "."))
}

// The arguments of a call of r with each DEFAULT (#default) put as the parameter's default: SQL Server needs one for each
// parameter (313 for too few, 8144 for too many); a parameter without a default takes NULL for DEFAULT.
fn fillArgs(r: &Routine, nm: &str, args: &[]Expr): Result[[]Expr, DbErr] {
    if len(args) != len(r.params) { return Err(argCountErr(nm, len(args), len(r.params))) }
    var out: []Expr = []
    for i in 0..len(args) {
        var isDefault = false
        match args[i] {
            Expr.Call(f, a, _) { isDefault = f == "#default" }
            else {}
        }
        if !isDefault {
            append(mut &out, lexdb_sql.cloneExpr(&args[i]))
        } else if r.params[i].has {
            append(mut &out, try lexdb_parse.parseExpr(&r.params[i].dflt))
        } else {
            append(mut &out, Expr.Lit(Val.Null))
        }
    }
    return Ok(out)
}

// The query a function that reads tables is written as (lexdb_tsqlfunc, set by lexdb_tds): SELECT of its result, over the
// arguments; tag makes the names it makes for them its own.
pub type QueryFn = fn(&Routine, &[]Expr, int): Result[Stmt, DbErr]

fn hasSubRef(x: &Expr): bool {
    match x {
        Expr.Unary(_, a) { return hasSubRef(&a) }
        Expr.Bin(_, a, b) { return hasSubRef(&a) || hasSubRef(&b) }
        Expr.IsNull(a, _) { return hasSubRef(&a) }
        Expr.Cast(a, _) { return hasSubRef(&a) }
        Expr.Call(n, args, _) {
            if lexdb_sql.isSubCall(&n) { return true }
            for a in args { if hasSubRef(&a) { return true } }
            return false
        }
        else { return false }
    }
}

// Whether a function reads tables, or calls (as its attrs list: calls:key) one that does.
fn readsDeep(r: &Routine, lookup: &fn(&str): Option[Routine], depth: int): bool {
    if strings.contains(&r.attrs, "reads") { return true }
    if depth > 32 { return false }
    for w in strings.split(&r.attrs, " ") {
        if strings.startsWith(&w, "calls:") {
            match lookup(&w[6..len(w)].toStr()) {
                Some(c) { if readsDeep(&c, lookup, depth + 1) { return true } }
                None {}
            }
        }
    }
    return false
}

fn scalarCall(nm: &str, args: &[]Expr, lookup: &fn(&str): Option[Routine], qry: &QueryFn, extra: mut &[]Stmt, base: int): Result[Expr, DbErr] {
    let key = tsqlKey(nm)
    match lookup(&key) {
        Some(r) {
            if len(r.denied) > 0 { return Err(deniedErr(&r)) }
            let ins = try fillArgs(&r, nm, args)
            if readsDeep(&r, lookup, 0) {
                // a function that reads tables (or calls one): its result as a scalar subquery of the statement
                for a in ins { if hasSubRef(&a) { return Err(err("0A000", &("lexdb: the function " + nm + " reads tables: an argument that is a subquery is not supported yet"))) } }
                var sq = try qry(&r, &ins, base + len(extra))
                sq.use = lexdb_sql.SUB_SCALAR
                sq.params = 0
                sq.src = ""
                sq.runAs = r.owner.clone()
                append(extra, sq)
                return Ok(Expr.Cast(Expr.Call("#sub", [Expr.Lit(Val.Int(base + len(extra) - 1))], false), r.ret))
            }
            var xs: []Expr = [Expr.Lit(Val.Text(key))]
            for a in ins { append(mut &xs, a) }
            return Ok(Expr.Cast(Expr.Call("#udf", xs, false), r.ret))
        }
        None {
            let parts = strings.split(nm, ".")
            let sch = if len(parts) >= 2 { parts[len(parts) - 2].toStr() } else { "dbo" }
            return Err(err("TS4121", &("Cannot find either column \"" + sch + "\" or the user-defined function or aggregate \"" + nm + "\", or the name is ambiguous.")))
        }
    }
}

fn resolveE(x: &Expr, lookup: &fn(&str): Option[Routine], qry: &QueryFn, extra: mut &[]Stmt, base: int, failure: mut &Option[DbErr], changed: mut &bool): Expr {
    match x {
        Expr.Unary(op, a) { return Expr.Unary(op.clone(), resolveE(&a, lookup, qry, extra, base, failure, changed)) }
        Expr.Bin(op, a, b) {
            let l = resolveE(&a, lookup, qry, extra, base, failure, changed)
            return Expr.Bin(op.clone(), l, resolveE(&b, lookup, qry, extra, base, failure, changed))
        }
        Expr.IsNull(a, neg) { return Expr.IsNull(resolveE(&a, lookup, qry, extra, base, failure, changed), neg) }
        Expr.Cast(a, t) { return Expr.Cast(resolveE(&a, lookup, qry, extra, base, failure, changed), t) }
        Expr.Call(nm0, args, star) {
            // (a name read back by the PostgreSQL parser has its schema joined by QSEP)
            let nm = strings.replaceAll(&nm0, lexdb_sql.QSEP, ".")
            var done: []Expr = []
            for a in args { append(mut &done, resolveE(&a, lookup, qry, extra, base, failure, changed)) }
            if star || len(nm) == 0 || nm[0] == '#' || !strings.contains(&nm, ".") { return Expr.Call(nm0.clone(), done, star) }
            changed = true
            match scalarCall(&nm, &done, lookup, qry, extra, base) {
                Ok(e) { return e }
                Err(e) {
                    if failure.isNone() { failure = Some(e) }
                    return lexdb_sql.cloneExpr(x)
                }
            }
        }
        else { return lexdb_sql.cloneExpr(x) }
    }
}

fn noQuery(r: &Routine, args: &[]Expr, tag: int): Result[Stmt, DbErr] {
    return Err(err("0A000", &("lexdb: the function " + lexdb_sql.baseName(&r.key) + " reads tables: a function that reads tables cannot be called from another function yet")))
}

// x with its calls of T-SQL functions of the user's (by their schema-qualified names) written out; lookup finds a scalar
// function by its key.
pub fn resolveUdf(x: &Expr, lookup: &fn(&str): Option[Routine]): Result[Expr, DbErr] {
    var failure: Option[DbErr] = None
    var changed = false
    var extra: []Stmt = []
    let r = resolveE(x, lookup, noQuery, mut &extra, 0, mut &failure, mut &changed)
    match failure {
        Some(e) { return Err(e) }
        None {}
    }
    return Ok(r)
}

// The inline table-valued function an item of FROM (f: a function's call, its arguments the items of subs[f.sub]) names, written
// as its query in the same place: items to the new FROM list.
fn inlineTvf(t: mut &Stmt, f: &lexdb_sql.FromItem, fns: &[]Routine, nfrom: mut &[]lexdb_sql.FromItem, depth: int, qry: &QueryFn): Result[Unit, DbErr] {
    let call = t.subs[f.sub].clone()
    let key = call.srf[5..len(call.srf)].toStr()
    var found: Option[Routine] = None
    for r in fns { if r.key == key && r.kind == lexdb_sql.RK_FUNC && r.retSet { found = Some(r.clone()) } }
    let shown = if len(call.spell) > 0 { call.spell.clone() } else { key.clone() }
    if found.isNone() { return Err(err("TS208", &("Invalid object name '" + shown + "'."))) }
    let r = found.unwrap()
    if len(r.denied) > 0 { return Err(deniedErr(&r)) }
    if strings.contains(&r.attrs, "multi") {
        return Err(err("0A000", &("lexdb: the multi-statement table-valued function " + shown + " is not supported yet (an inline one is)")))
    }
    if depth > 32 { return Err(err("TS217", "Maximum stored procedure, function, trigger, or view nesting level exceeded (limit 32).")) }
    var args: []Expr = []
    for it in call.items {
        match it.expr {
            Some(x) { append(mut &args, lexdb_sql.cloneExpr(&x)) }
            None {}
        }
    }
    let ins = try fillArgs(&r, &shown, &args)
    var names: []str = []
    for p in r.params { append(mut &names, p.name.clone()) }
    let body0 = try lexdb_parse.tsqlSelect(&r.body, &names)
    // an argument that reads a column (or a subquery) comes as a column of a derived table of one row, before the function's query
    var vals: []Expr = []
    var aitems: []lexdb_sql.SelItem = []
    let at = len(t.subs)
    let aalias = "__udf" + at.toStr()
    for i in 0..len(ins) {
        if constArg(&ins[i]) {
            append(mut &vals, lexdb_sql.cloneExpr(&ins[i]))
        } else {
            let cn = "__a" + i.toStr()
            append(mut &aitems, lexdb_sql.SelItem{star: false, qual: "", expr: Some(lexdb_sql.cloneExpr(&ins[i])), alias: cn.clone(), spell: cn.clone()})
            append(mut &vals, Expr.Col(aalias + "." + cn, -1))
        }
    }
    var body = mapStmt(&body0, fn(x: &Expr): Option[Expr] {
        match x {
            Expr.Param(n) {
                if n >= 1 && n <= len(vals) { return Some(lexdb_sql.cloneExpr(&vals[n - 1])) }
                return None
            }
            else { return None }
        }
    })
    body.use = lexdb_sql.SUB_FROM
    body.params = 0
    body.runAs = r.owner.clone()
    // (its own calls of functions)
    match try tsqlCallsAt(&body, fns, depth + 1, qry) {
        Some(b2) { body = b2 }
        None {}
    }
    var g = f.clone()
    g.table = ""
    t.subs[f.sub] = body
    if len(aitems) > 0 {
        var a = lexdb_sql.newStmt(lexdb_sql.S_SELECT)
        a.use = lexdb_sql.SUB_FROM
        a.items = aitems
        a.subs = call.subs.clone()
        a.wins = call.wins.clone()
        append(mut &t.subs, a)
        let first = f.join == lexdb_sql.J_FIRST
        append(nfrom, lexdb_sql.FromItem{table: "", alias: aalias, join: if first { lexdb_sql.J_FIRST } else { lexdb_sql.J_CROSS }, on: None, sub: at, cols: [],
                                         work: -1, lateral: true, using: [], natural: false, comma: f.comma})
        g.comma = false
        if first { g.join = lexdb_sql.J_CROSS }
    }
    append(nfrom, g)
    return Ok(Unit{})
}

// s with its calls of T-SQL functions of the user's written out (fns: those of the catalog); None when it calls none. An
// error as SQL Server gives it for a name that is none (4121, 208), a call with too few or too many arguments (313, 8144).
pub fn tsqlCalls(s: &Stmt, fns: &[]Routine, qry: &QueryFn): Result[Option[Stmt], DbErr] { return tsqlCallsAt(s, fns, 0, qry) }

fn tsqlCallsAt(s: &Stmt, fns: &[]Routine, depth: int, qry: &QueryFn): Result[Option[Stmt], DbErr] {
    if depth > 32 { return Err(err("TS217", "Maximum stored procedure, function, trigger, or view nesting level exceeded (limit 32).")) }
    var failure: Option[DbErr] = None
    var changed = false
    var extra: []Stmt = []
    let base = len(s.subs)
    var t = mapStmtTop(s, fn(x: &Expr): Option[Expr] {
        return Some(resolveE(x, fn(k: &str): Option[Routine] {
            for r in fns {
                if r.key == k && r.kind == lexdb_sql.RK_FUNC && !r.retSet { return Some(r.clone()) }
            }
            return None
        }, qry, mut &extra, base, mut &failure, mut &changed))
    })
    match failure {
        Some(e) { return Err(e) }
        None {}
    }
    // (the queries of functions that read tables, with their own calls written out)
    for i in 0..len(extra) {
        match try tsqlCallsAt(&extra[i], fns, depth + 1, qry) {
            Some(u) { extra[i] = u }
            None {}
        }
    }
    for i in 0..len(t.subs) {
        match try tsqlCallsAt(&t.subs[i], fns, depth, qry) {
            Some(u) {
                t.subs[i] = u
                changed = true
            }
            None {}
        }
    }
    for i in 0..len(t.inner) {
        match try tsqlCallsAt(&t.inner[i], fns, depth, qry) {
            Some(u) {
                t.inner[i] = u
                changed = true
            }
            None {}
        }
    }
    // the table-valued functions in FROM
    var any = false
    for f in t.from { if f.sub >= 0 && f.sub < len(t.subs) && strings.startsWith(&t.subs[f.sub].srf, "#udf:") { any = true } }
    for x in extra { append(mut &t.subs, x.clone()) }
    if len(extra) > 0 { changed = true }
    if any {
        var nfrom: []lexdb_sql.FromItem = []
        let from = t.from.clone()
        for f in from {
            if f.sub >= 0 && f.sub < len(t.subs) && strings.startsWith(&t.subs[f.sub].srf, "#udf:") {
                try inlineTvf(mut &t, &f, fns, mut &nfrom, depth, qry)
            } else {
                append(mut &nfrom, f)
            }
        }
        t.from = nfrom
        changed = true
    }
    if !changed { return Ok(None) }
    return Ok(Some(t))
}
