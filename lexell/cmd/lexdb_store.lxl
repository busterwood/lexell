// lexdb: the store. Copy-on-write B+trees of byte keys and values, a node
// cache, optimistic transactions checked by leaf versions, a log of
// committed rows with group commit, checkpoints and recovery
// (design/lexdb.md section 4, stages D1 and D2).
//
// All of the store's state is one Db in a task.Shared. Everything that
// changes it runs inside `with`, which cannot park, so no other task can see
// it half done; every read, write and flush of a file runs outside `with`.
// A descent that meets a node not in memory leaves `with` with the slot it
// needs, loads the page, installs it in another `with`, and starts again
// from the root: what it saw before the park may have changed.
//
// Nodes live in a table of slots. A slot keeps its number while its node is
// evicted and loaded again; a page number is where the node was last
// written. A node that changes after a checkpoint wrote it is dirty, and the
// next checkpoint writes it to a new page (copy on write): its old page is
// freed once that checkpoint's meta page is durable.
import "task"
import "hash"
import "binary"
import "collections"
import "strings"
import "time"
import "crypto"
import "./lexdb_base"
import "./lexdb_disk"
import "./lexdb_page"
import "./lexdb_cols"
import "./lexdb_time"

pub const DATA = "data.lxdb"
const SPARE = "log.spare"
const PAGE = 4096
const LOG_MAGIC = 0x4C474C58
const FRAME_HDR = 32
// The most record bytes a log frame holds: its length is 32 bits, and a frame
// past it would be one recovery stops at (9.127). Tests set fewer.
pub const FRAME_MAX = 4294967296 - 4096

pub const OP_PUT = 1
pub const OP_DEL = 2
pub const OP_CREATE = 3
pub const OP_DROP = 4
const OP_PUT_HEAD = 5       // in the log only: a put with its head (TxWrite.head)

pub fn segName(g: int): str { return "log." + g.toStr() }

pub type Options = value record {
    pub cacheBytes: int     // about the memory nodes take before clean ones are evicted (lexdb_page.nodeCost)
    pub segBytes: int       // the size of a log segment
    pub ckptBytes: int      // log bytes after which the checkpointer runs (an eighth when the cache is full)
    pub snapNodes: int      // old node versions kept for snapshots before the oldest is cancelled
}

pub fn defaults(): Options {
    return Options{cacheBytes: 128 * 1024 * 1024, segBytes: 64 * 1024 * 1024, ckptBytes: 32 * 1024 * 1024, snapNodes: 50000}
}

type SlotMeta = value record {
    used: bool
    gen: int            // changes when the slot is freed, so stale references are seen
    loaded: bool
    dirty: bool
    root: bool
    disk: int           // the page it was last written to, -1 when none
    ckpt: int           // the checkpoint that wrote that page
    version: int        // changes with every change to the node (leaf versions: 4.4)
    ref: bool           // clock bit
    since: int          // the commit (seq) that made the node's current version
    pinned: bool        // freed, but a snapshot may still reach it: kept until it ends
    cost: int           // loaded: what it counts against the cache (lexdb_page.nodeCost)
    listed: bool        // in Db.histSlots
    frame: int          // loaded: its node, pool[frame]; -1 when not (a slot not in memory holds no node)
    upg: int            // a clean row leaf of a table (9.114): 0 not seen, 1 queued to be converted, 2 its rows did not convert
}

// A descent's path, with the separators around each node on it: keys in
// [lo[j], hi[j]) (no lo: from the start; no hi: to the end) reach path[j]
// by path[0..j], as of Db.shape. The leaf is the last.
type LastLeaf = record { tree: int; shape: int; path: []int; lo: []str; hasLo: []bool; hi: []str; hasHi: []bool }

// An old version of a node, kept while a snapshot can see it: the commits
// [since, until) saw it.
type Hist = record { since: int; until: int; node: lexdb_page.Node }

// A live snapshot: it sees the store as it was after commit seq.
type Snap = value record { id: int; seq: int; cancelled: bool }

type Deferred = value record { slot: int; seq: int; height: int; whole: bool }  // whole: a dropped tree's slot (its children's too, 9.127)

// A tree's root changed by commit seq (prev: the root before, -1 none): a
// snapshot at an earlier commit starts from prev.
type RootChange = value record { seq: int; tree: int; prev: int }

type HoldAt = value record { ckpt: int; seg: int }

// The pages checkpoint ckpt freed, as runs, kept from reuse while a
// follower may read an earlier checkpoint (hold).
type HeldRuns = record { ckpt: int; runs: []int }

type Waiter = record { batch: int; p: task.Promise[Result[Unit, lexdb_base.DbErr]] }

// A page a checkpoint writes: a node's body (the node's own string since
// repack, so the pages waiting take no memory of their own; the page is
// made as it is written), or a list page's bytes.
type PageOut = record { no: int; leaf: bool; n: int; body: str; raw: []byte }

pub type Db = record {
    opts: Options
    fs: lexdb_disk.Fs
    logFs: lexdb_disk.Fs        // the log segments and the spare: fs, or a directory of their own (--log-dir, 9.124)
    data: lexdb_disk.File
    watched: int                // a tree whose writes are counted (watch), -1 none
    watchedWrites: int
    pool: []lexdb_page.Node     // the nodes in memory, one per loaded slot (SlotMeta.frame)
    owner: []int                // the slot of each node in pool
    meta: []SlotMeta
    freeSlots: []int
    loadedCount: int
    cacheUsed: int              // the loaded nodes' costs
    wlog: []WEntry              // the writes of recent commits, in commit order (validate)
    wlogFloor: int              // reads before this commit can no longer be checked
    hand: int
    trees: Map[int, int]        // tree id -> root slot
    // The last descent to a leaf (descend), and the keys that lead there:
    // a descent of a key between its fences gives its path without
    // searching, while shape is what it was. shape changes with every
    // change to what a path may hold: a node replaced, loaded or dropped,
    // a separator added or removed, a root set (9.109).
    lastLeaf: LastLeaf
    shape: int
    nextTree: int
    npages: int
    fileEnd: int                // the data file's bytes, written or reserved (reserveAhead)
    reserving: bool             // false once reserving space has failed: the file then grows by its writes
    free: []int                 // pages free now: runs, (first, count) pairs, highest first (9.33)
    freeAfterNext: []int        // pages the next checkpoint frees
    pendingFree: []int          // runs the checkpoint in flight frees when durable
    dropped: []int              // subtrees no tree reaches, their pages to free: (page, height or -1) pairs (9.32)
    frameMax: int               // FRAME_MAX (tests set fewer)
    dropReads: int              // the most of their pages a checkpoint reads (DROP_READS; tests set fewer)
    memo: Map[str, str]         // what the SQL layer keeps while the store is open, outside transactions (its sequences' blocks: 9.43)
    listPages: []int            // the list pages of the last durable checkpoint
    ckpt: int
    durableCkpt: int
    ckptRunning: bool
    batch: []byte               // the records of the open batch
    batchCount: int
    batchNo: int                // the open batch's number
    appliedBatch: int           // the highest batch with an applied commit
    durableBatch: int
    waiters: []Waiter
    // Row locks (9.86): "tree:key" -> its holders, "id mode" each, joined
    // by ";"; the transactions waiting for one, and what each waits for.
    locks: Map[str, str]
    lockWaits: []LockWait
    waitFor: Map[int, str]
    nextLock: int
    writerWake: []task.Promise[Unit]
    ckptWake: []task.Promise[Unit]
    ckptDone: []task.Promise[Unit]  // commits held while the cache is over twice its budget (see commit)
    seg: int                    // the end of the durable log
    segOff: int
    logSinceCkpt: int
    failed: []lexdb_base.DbErr  // one element once a write or flush has failed
    closing: bool
    seq: int                    // commits applied
    snaps: []Snap
    nextSnap: int
    hist: [][]Hist              // per slot
    histCount: int
    histSlots: []int            // the slots with old versions
    deferred: []Deferred        // slots freed while a snapshot may reach them
    rootHist: []RootChange      // root changes a snapshot may still need
    durableSeq: int             // the last commit the log holds: snapshots read as of it
    holds: Map[int, HoldAt]     // each follower's hold (9.73); the fields below are the oldest's
    holdCkpt: int               // a follower reads checkpoints from this one on (9.71), -1 none:
    holdSeg: int                //   pages later checkpoints free stay unused (heldFree), and
    heldFree: []HeldRuns        //   log segments from holdSeg on are kept
    changeWake: []task.Promise[Unit]    // woken after a flush or a checkpoint (waitChange)
    durWaits: []DurWait                 // woken after a flush, or when the store closes or fails (waitDurable)
    nextDurWait: int
    ckptCovers: int             // the last durable checkpoint's covers batch, -1 not known (9.72)
    // counters
    pub snapshots: int
    pub tooOld: int
    pub commits: int
    pub conflicts: int
    pub loads: int
    pub aheadReads: int         // reads of pages ahead (loadAhead), and their pages
    pub aheadPages: int
    pub evictions: int
    pub flushes: int
    pub logBytes: int           // bytes the log writer wrote (frames, padding included)
    pub checkpoints: int
    pub pagesWritten: int       // pages checkpoints wrote (meta pages included)
    pub held: int               // commits held for a checkpoint (the cache over twice its budget)
    pub wholes: int             // large values read whole: their chunks read (9.31)
    // Column leaves (9.112): per table tree, its layouts as the executor
    // gave them (setColSpec), specs[colSpecs[tree]]; leaves checkpoints
    // wrote as columns and as rows (of trees with layouts)
    colSpecs: Map[int, int]
    specs: []lexdb_cols.Spec
    pub colLeaves: int
    pub rowLeaves: int
    colsOff: bool               // no column leaves written (setColumns)
    // per spec: a column leaf's page bytes per 1000 of its rows' T_FLEAF
    // bytes, as last sampled (0 not yet, -1 its rows did not encode), and
    // the leaves split since (leafRoom)
    specRatio: []int
    specSplits: []int
    pub refitCuts: int          // leaves a checkpoint cut to fit their pages (refit)
    // Clean row leaves of table trees a scan read (9.114): converted to
    // column leaves by the next checkpoint, upgBudget at most (upgradeQueued)
    upgTree: []int
    upgKey: []str
    upgBudget: int
    pub upgLeaves: int          // clean leaves rewritten as column leaves (upgradeLeaf)
    pub upgFailed: int          // and those whose rows did not convert
}

// A handle to an open store; copies reach the same store. A replica's
// (openReplica) reads through its follower (fo), and takes no writes.
pub type Store = value record { sh: task.Shared[Db]; fo: Option[Follower] }

// A read mark: a leaf seen at a version (4.4).
// A leaf a transaction read: its slot as it was then, and its page if it
// was clean (the slot may be dropped meanwhile, its parent evicted: the
// page, unless freed since, still holds what was read) with the commit
// the read saw.
// A read, for its transaction's commit check: the keys [lo, hi) of a tree
// (hi "": to the end), as of commit seq. Per key, not per leaf: a commit
// fails only when a write committed after the read falls in its range
// (9.19), so writes to other rows of the same leaf no longer conflict, and
// a range read sees an insert into it (no phantoms).
type Mark = value record { tree: int; lo: str; hi: str; seq: int }

// A committed write, kept for the commit checks (Db.wlog): all, a dropped
// tree (every key).
// A key range [key, hi] (hi "": the key alone): a commit of many writes to
// a tree logs their range, not each (a large COPY's commit would otherwise
// add an entry per row).
type WEntry = value record { seq: int; tree: int; key: str; hi: str; all: bool }

// Past this many writes to one tree, a commit logs their range.
const WLOG_RANGE = 1024

// The writes kept: past this many, the older half goes, and a transaction
// whose read is older than what is kept fails its check (a conflict).
var WLOG_MAX: int = 131072

// For the tests: keeps fewer writes.
pub fn setWriteLogMax(n: int) { WLOG_MAX = n }

// head: a large value's first bytes its writer wants kept in its leaf (9.31).
pub type TxWrite = value record { pub op: int; pub tree: int; pub key: str; pub val: str; pub head: int }

pub type Txn = record {
    reads: []Mark
    writes: []TxWrite
    // Per tree written (idxTrees[k]), key -> the last write of it: keyed by
    // the write's own key string (shared, not copied), one map per tree.
    idxTrees: []int
    idx: []Map[str, int]
    // Per tree written, the keys of idx[k] sorted, as of its first
    // sortedN[k] keys (a map's keys stay in the order added): ownRange
    // sorts only the keys added since, and merges them in.
    sortedKeys: [][]str
    sortedN: []int
    created: []int
    snap: int                   // its reads' snapshot's id, -1 for none (reads of the live tree)
    snapSeq: int
    snapTrees: Map[int, int]    // the tree roots as the snapshot sees them
    track: bool                 // a snapshot's reads are noted (Mark) for its writes' commit: a transaction block
    pub live: bool              // a block's reads go to the live tree for now (its UPDATE and DELETE: 9.16)
    pub path: []str             // the SQL layer's search path for its names (lexdb_exec); [] the default
    pub sess: int               // the SQL layer's session running it (its sequences' values, 9.43)
    pub rules: bool             // the SQL layer's planner ignores statistics (SET lexdb_planner = rules: lexdb_exec optimizer 20)
    pub memMax: int             // the SQL layer's statement memory (SET max_statement_mem, bytes; 0 none): its planner's hash joins fit in it (optimizer 26 review)
    // Read-ahead's run size where the last scan left it, and its tree: a
    // scan the caller goes on with in parts (a batch at a time) keeps
    // growing its runs, not starting again at AHEAD_MIN.
    raTree: int
    ra: int
    fsnap: []RepPin             // on a replica: its follower snapshot, from its first read to its end (or its drop)
    pub now: int                // when it began, Unix microseconds: SQL's now() (9.76)
    pub zone: lexdb_time.Zone   // the SQL layer's session's time zone (9.95): it travels with the statement
    // The SQL layer's deferred foreign key checks, encoded (lexdb_exec,
    // 9.85), and SET CONSTRAINTS: consAll 0 none, 1 ALL DEFERRED, 2 ALL
    // IMMEDIATE; then per name (later ones win).
    pub pending: []str
    pub consAll: int
    pub consNames: []str
    pub consDeferred: []bool
    lockId: int                 // its row locks' owner (9.86); 0 none yet
    held: []str                 // the rows it has locked ("tree:key")
    // Its reads not noted for the commit's check, for now: a SELECT that
    // locks the rows it gives (9.86), as PostgreSQL's READ COMMITTED: the
    // locks keep those rows as they were read
    pub quiet: bool
    // A scan's read that reaches the end of what it asked for is noted only
    // up to the last key it read: rows added after that key do not fail the
    // commit. WAITFOR's (lexdb_exec, design/lexdb-events.md): a consumer
    // that read to the stream's end is not failed by every producer's
    // append, while the rows it read, and the gaps between them, are still
    // checked.
    pub openEnd: bool
    // The SQL layer's temporary objects (9.96): its session's temporary
    // schema ("" none yet); whether the transaction changed one of them in
    // the catalog; the tables made in it with ON COMMIT DELETE ROWS or DROP
    pub tmp: str
    pub tmpDdl: bool
    pub onCommit: []str
}

pub fn begin(): Txn {
    return Txn{reads: [], writes: [], idxTrees: [], idx: [], sortedKeys: [], sortedN: [], created: [], snap: -1, snapSeq: 0, snapTrees: newMap(), track: false, live: false, path: [], sess: 0, rules: false, memMax: 0,
               raTree: -1, ra: AHEAD_MIN, fsnap: [], now: time.now().unixMicros(), zone: lexdb_time.utc(),
               pending: [], consAll: 0, consNames: [], consDeferred: [], lockId: 0, held: [], quiet: false, openEnd: false,
               tmp: "", tmpDdl: false, onCommit: []}
}

pub fn (t: &Txn) isSnapshot(): bool { return t.snap >= 0 }

// A transaction block's (BEGIN ... COMMIT), not a statement's own.
pub fn (t: &Txn) inBlock(): bool { return t.track }

// Notes a read of [lo, hi) of tree as of commit seq; one adjacent to the
// last (a scan's next leaf) extends it.
fn (t: mut &Txn) noteRead(tree: int, lo: str, hi: str, seq: int) {
    let n = len(t.reads)
    if n > 0 {
        let p = t.reads[n - 1]
        if p.tree == tree && p.seq == seq && p.hi == lo && len(lo) > 0 {
            t.reads[n - 1].hi = hi
            return
        }
        if p.tree == tree && p.seq == seq && p.lo == hi && len(hi) > 0 {
            t.reads[n - 1].lo = lo
            return
        }
    }
    append(mut &t.reads, Mark{tree: tree, lo: lo, hi: hi, seq: seq})
}

// Whether the transaction's reads are noted: a live transaction's, and a
// block's (a read-only snapshot's are not). lexdb_exec keeps its
// index-to-scan switch off while they are (optimizer 19).
pub fn (t: &Txn) noting(): bool { return !t.quiet && (t.snap < 0 || t.live || t.track) }

// The reads noted so far; forgetReads(n) forgets those after the first n
// (a statement run again after waiting for a lock, which reads again).
pub fn (t: &Txn) readCount(): int { return len(t.reads) }

pub fn (t: mut &Txn) forgetReads(n: int) { while len(t.reads) > n { let r = pop(mut &t.reads) } }

fn hexTo(b: mut &StrBuf, s: &str) {
    let ds = "0123456789abcdef"
    for i in 0..len(s) {
        b.addByte(ds[int(s[i]) >> 4])
        b.addByte(ds[int(s[i]) & 15])
    }
}

// The reads noted, as text (for the tests: tree, range, seq of each).
pub fn (t: &Txn) readsText(): str {
    var b = newStrBuf()
    for r in t.reads {
        b.add(&(r.tree.toStr()))
        b.add(" [")
        hexTo(mut &b, &r.lo)
        b.add(", ")
        hexTo(mut &b, &r.hi)
        b.add(") @")
        b.add(&(r.seq.toStr()))
        b.add("\n")
    }
    return b.toStr()
}

// The transaction's last write of key in tree (its index in writes).
fn (t: &Txn) lastWrite(tree: int, key: &str): Option[int] {
    for k in 0..len(t.idxTrees) { if t.idxTrees[k] == tree { return t.idx[k].get(key) } }
    return None
}

// Whether the transaction has written key in tree.
pub fn (t: &Txn) wrote(tree: int, key: &str): bool { return t.lastWrite(tree, key).isSome() }

fn (t: mut &Txn) noteWrite(tree: int, key: str, i: int) {
    for k in 0..len(t.idxTrees) {
        if t.idxTrees[k] == tree {
            t.idx[k].put(key, i)
            return
        }
    }
    var m: Map[str, int] = newMap()
    m.put(key, i)
    append(mut &t.idxTrees, tree)
    append(mut &t.idx, m)
    append(mut &t.sortedKeys, [])
    append(mut &t.sortedN, 0)
}

pub fn (t: mut &Txn) put(tree: int, key: str, val: str): Result[Unit, lexdb_base.DbErr] { return t.putRow(tree, key, val, 0) }

// put; if the value is stored in chunks, its first head bytes stay in its
// leaf (as many as the leaf holds), so getPart and the Part scans give them
// without reading the chunks (9.31).
pub fn (t: mut &Txn) putRow(tree: int, key: str, val: str, head: int): Result[Unit, lexdb_base.DbErr] {
    if len(key) > lexdb_page.MAX_KEY {
        return Err(lexdb_base.err(lexdb_base.S_LIMIT, "key too large: " + len(key).toStr() + " bytes, at most " + lexdb_page.MAX_KEY.toStr()))
    }
    if len(val) > MAX_VALUE {
        return Err(lexdb_base.err(lexdb_base.S_LIMIT, "row too large: " + len(val).toStr() + " bytes, at most " + MAX_VALUE.toStr()))
    }
    t.noteWrite(tree, key, len(t.writes))
    append(mut &t.writes, TxWrite{op: OP_PUT, tree: tree, key: key, val: val, head: head})
    return Ok(Unit{})
}

pub fn (t: mut &Txn) del(tree: int, key: str) {
    t.noteWrite(tree, key, len(t.writes))
    append(mut &t.writes, TxWrite{op: OP_DEL, tree: tree, key: key, val: "", head: 0})
}

// A savepoint (9.80): the writes so far; undoTo forgets those after it. Its
// reads stay noted (a commit checks them all, which is the safe side), and a
// tree made after it stays made (empty, if its writes went).
pub fn (t: &Txn) mark(): int { return len(t.writes) }

pub fn (t: mut &Txn) undoTo(n: int) {
    while len(t.writes) > n { let w = pop(mut &t.writes) }
    t.idxTrees = []
    t.idx = []
    t.sortedKeys = []
    t.sortedN = []
    for i in 0..len(t.writes) { t.noteWrite(t.writes[i].tree, t.writes[i].key, i) }
}

pub fn (t: mut &Txn) dropTree(tree: int) {
    append(mut &t.writes, TxWrite{op: OP_DROP, tree: tree, key: "", val: "", head: 0})
}

pub fn (t: &Txn) hasWrites(): bool { return len(t.writes) > 0 }

// ---- slots and the cache

fn (db: mut &Db) allocSlot(): int {
    if len(db.freeSlots) > 0 {
        let s = pop(mut &db.freeSlots)
        db.meta[s].used = true
        db.meta[s].loaded = false
        db.meta[s].dirty = false
        db.meta[s].root = false
        db.meta[s].disk = -1
        db.meta[s].ckpt = 0
        db.meta[s].version = 0
        db.meta[s].ref = false
        db.meta[s].since = 0
        db.meta[s].pinned = false
        db.meta[s].cost = 0
        db.meta[s].upg = 0
        return s
    }
    append(mut &db.meta, SlotMeta{used: true, gen: 0, loaded: false, dirty: false, root: false, disk: -1,
                                  ckpt: 0, version: 0, ref: false, since: 0, pinned: false, cost: 0,
                                  listed: false, frame: -1, upg: 0})
    append(mut &db.hist, [])
    return len(db.meta) - 1
}

// Gives slot s node n, in a frame of the pool (its own, or a new one).
fn (db: mut &Db) setNode(s: int, n: lexdb_page.Node) {
    db.shape += 1
    let f = db.meta[s].frame
    if f >= 0 {
        db.pool[f] = n
        return
    }
    db.meta[s].frame = len(db.pool)
    append(mut &db.pool, n)
    append(mut &db.owner, s)
}

// Takes slot s's node out of memory: the pool's last node moves into its
// frame, so the pool holds loaded nodes only.
fn (db: mut &Db) freeNode(s: int) {
    let f = db.meta[s].frame
    if f < 0 { return }
    db.shape += 1
    db.meta[s].frame = -1
    let last = len(db.pool) - 1
    let n = pop(mut &db.pool)
    let o = pop(mut &db.owner)
    if f < last {
        db.pool[f] = n
        db.owner[f] = o
        db.meta[o].frame = f
    }
}

// A new node in memory, dirty.
fn (db: mut &Db) newNode(n: lexdb_page.Node): int {
    let s = db.allocSlot()
    db.setNode(s, n)
    db.meta[s].loaded = true
    db.meta[s].dirty = true
    db.meta[s].since = db.seq
    db.loadedCount += 1
    db.recost(s)
    return s
}

// Counts node s's memory again after it changed (a loaded node).
fn (db: mut &Db) recost(s: int) {
    if !db.meta[s].loaded { return }
    let c = lexdb_page.nodeCost(&db.pool[db.meta[s].frame])
    db.cacheUsed += c - db.meta[s].cost
    db.meta[s].cost = c
}

fn (db: mut &Db) uncost(s: int) {
    db.cacheUsed -= db.meta[s].cost
    db.meta[s].cost = 0
}

// The highest commit a live snapshot sees, or -1.
fn (db: &Db) maxSnap(): int {
    var m = -1
    for sn in db.snaps { if !sn.cancelled && sn.seq > m { m = sn.seq } }
    return m
}

// Frees a slot the tree no longer reaches; while a snapshot may still reach
// it (it sees a version the slot holds), the slot is kept until then.
fn (db: mut &Db) freeSlot(s: int) { db.freeSubtree(s, -1, false) }

// freeSlot for a slot whose subtree is h high (-1: not known), which
// matters when it is not in memory (releaseSlot). whole: s is a dropped
// tree's, so that the slots a snapshot gave its children after the drop
// are freed with it (releaseWhole).
fn (db: mut &Db) freeSubtree(s: int, h: int, whole: bool) {
    if (db.seq > db.durableSeq || db.maxSnap() >= 0) && !db.meta[s].pinned {
        db.meta[s].pinned = true
        append(mut &db.deferred, Deferred{slot: s, seq: db.seq, height: h, whole: whole})
        return
    }
    db.releaseSlot(s, h)
}

// releaseSlot for a dropped tree's deferred slot. A snapshot may have
// loaded it after the drop, which gave its children slots no deferral names
// (those loaded before the drop are deferred, pinned, and freed by their
// own entries, after their parent's, which came first): freed here, down to
// the pages not in memory (9.127).
fn (db: mut &Db) releaseWhole(s: int, h: int) {
    if db.meta[s].loaded && !db.pool[db.meta[s].frame].leaf {
        var kids: []int = []
        for k in db.pool[db.meta[s].frame].kids { append(mut &kids, k) }
        for k in kids {
            if db.meta[k].used && !db.meta[k].pinned { db.releaseWhole(k, if h >= 0 { h - 1 } else { -1 }) }
        }
    }
    db.releaseSlot(s, h)
}

fn (db: mut &Db) releaseSlot(s: int, h: int) {
    if db.meta[s].disk >= 0 {
        // A node not in memory: its page's subtree is on disk as it was
        // written, and a checkpoint reads it to free its pages (9.32); its
        // height says which of them are leaves, freed unread.
        if db.meta[s].loaded { db.freePage(db.meta[s].disk) }
        else {
            append(mut &db.dropped, db.meta[s].disk)
            append(mut &db.dropped, h)
        }
    }
    db.dropSlot(s)
}

// A node's page no longer the tree's (the node changed or left): free after
// the next checkpoint.
fn (db: mut &Db) freePage(p: int) {
    append(mut &db.freeAfterNext, p)
}

// Frees slot s, its page kept: the slot of a child of a node being evicted
// (the page is still the tree's, named by the parent's page).
fn (db: mut &Db) dropSlot(s: int) {
    db.meta[s].pinned = false
    if len(db.hist[s]) > 0 {
        db.histCount -= len(db.hist[s])
        db.hist[s] = []
    }
    if db.meta[s].loaded {
        db.loadedCount -= 1
        db.uncost(s)
        db.freeNode(s)
    }
    db.meta[s].used = false
    db.meta[s].gen += 1
    db.meta[s].loaded = false
    db.meta[s].dirty = false
    db.meta[s].disk = -1
    append(mut &db.freeSlots, s)
}

// Marks a node changed: its page belongs to the last checkpoint, and the
// next one writes it elsewhere and frees that page.
fn (db: mut &Db) markDirty(s: int) {
    if !db.meta[s].dirty {
        db.meta[s].dirty = true
        db.meta[s].upg = 0
        if db.meta[s].disk >= 0 { db.freePage(db.meta[s].disk) }
        db.meta[s].disk = -1
    }
}

fn copyNode(n: &lexdb_page.Node): lexdb_page.Node {
    var c = lexdb_page.newNode(n.leaf)
    c.size = n.size
    if n.lazy {
        c.lazy = true
        c.packed = true
        c.body = n.body
        for e in n.ents { append(mut &c.ents, e) }
        c.cols = n.cols
        for x in n.cdir { append(mut &c.cdir, x) }
        return c
    }
    for k in n.keys { append(mut &c.keys, k) }
    for v in n.vals { append(mut &c.vals, v) }
    for k in n.kids { append(mut &c.kids, k) }
    return c
}

// Called before a commit changes node s's contents: its current version is
// kept while a snapshot may read it (4.5): one that is live, or one that
// begins before this commit is durable (snapshots read as of the last
// durable commit, so readers never wait for the log: 9.16).
fn (db: mut &Db) willChange(s: int) {
    if db.meta[s].since == db.seq { return }
    if (db.seq > db.durableSeq || db.maxSnap() >= db.meta[s].since) && db.meta[s].loaded {
        if !db.meta[s].listed {
            append(mut &db.histSlots, s)
            db.meta[s].listed = true
        }
        append(mut &db.hist[s], Hist{since: db.meta[s].since, until: db.seq, node: copyNode(&db.pool[db.meta[s].frame])})
        db.histCount += 1
    }
    db.meta[s].since = db.seq
}

// Drops the old versions, kept slots and root changes no snapshot needs: a
// live one, or one that may begin (as of a commit from durableSeq on).
fn (db: mut &Db) prune() {
    var live: []int = []
    for sn in db.snaps { if !sn.cancelled { append(mut &live, sn.seq) } }
    var roots: []RootChange = []
    for rc in replace(mut &db.rootHist, []) {
        var need = rc.seq > db.durableSeq
        for q in live { if q < rc.seq { need = true } }
        if need { append(mut &roots, rc) }
    }
    db.rootHist = roots
    var keepSlots: []int = []
    for s in replace(mut &db.histSlots, []) {
        db.meta[s].listed = false
        var kept: []Hist = []
        var old = replace(mut &db.hist[s], [])
        while len(old) > 0 {
            let h = pop(mut &old)
            var need = h.until > db.durableSeq
            for q in live { if h.since <= q && q < h.until { need = true } }
            if need { append(mut &kept, h) } else { db.histCount -= 1 }
        }
        if len(kept) > 0 {
            db.hist[s] = kept
            append(mut &keepSlots, s)
            db.meta[s].listed = true
        }
    }
    db.histSlots = keepSlots
    var still: []Deferred = []
    for d in replace(mut &db.deferred, []) {
        var need = d.seq > db.durableSeq
        for q in live { if q < d.seq { need = true } }
        if need { append(mut &still, d) } else if d.whole { db.releaseWhole(d.slot, d.height) } else { db.releaseSlot(d.slot, d.height) }
    }
    db.deferred = still
}

// Whether slot s could be evicted, but for its children (kidsOut).
fn (db: &Db) evictable(s: int): bool {
    let m = &db.meta[s]
    if !m.used || !m.loaded || m.dirty || m.root || m.ckpt > db.durableCkpt || m.disk < 0 { return false }
    return !m.pinned && len(db.hist[s]) == 0
}

// Whether none of an inner node's children is in memory (a leaf: true).
fn (db: &Db) kidsOut(s: int): bool {
    if !db.pool[db.meta[s].frame].leaf {
        for k in db.pool[db.meta[s].frame].kids { if db.meta[k].loaded { return false } }
    }
    return true
}

// Evicts clean nodes, clock order, while more than the cache's size are in
// memory. A node is evicted only after its children (they hang from it).
// One sweep at most: a node referenced since the last sweep survives this
// one, so a commit that needs many paths in memory at once (every descent
// marks its path) never loses them while it loads the rest; the cache
// then holds more than its size for a while.
fn (db: mut &Db) maybeEvict() {
    var tries = 0
    while db.cacheUsed > db.opts.cacheBytes && tries < len(db.meta) {
        tries += 1
        db.hand += 1
        if db.hand >= len(db.meta) { db.hand = 0 }
        let s = db.hand
        if !db.evictable(s) { continue }
        // the reference bit first: an inner node on a path in use is almost
        // always referenced, and its children's scan was 8% of a read
        if db.meta[s].ref {
            db.meta[s].ref = false
            continue
        }
        if !db.kidsOut(s) { continue }
        if !db.pool[db.meta[s].frame].leaf {
            var kids: []int = []
            for k in db.pool[db.meta[s].frame].kids { append(mut &kids, k) }
            for k in kids { db.dropSlot(k) }
        }
        db.uncost(s)
        db.freeNode(s)
        db.meta[s].loaded = false
        db.loadedCount -= 1
        db.evictions += 1
    }
}

// What a load needs, read inside with: the page and the slot's generation.
type LoadReq = value record { slot: int; gen: int; page: int }

fn (db: &Db) loadReq(s: int): LoadReq {
    return LoadReq{slot: s, gen: db.meta[s].gen, page: db.meta[s].disk}
}

// Installs a page read for a slot, unless the slot changed meanwhile.
fn (db: mut &Db) install(r: LoadReq, b: &[]byte): Result[Unit, lexdb_base.DbErr] {
    try db.installOnly(r, b)
    db.maybeEvict()
    return Ok(Unit{})
}

// install, evicting nothing: loadMany evicts once after its pages (each
// install's sweep would clear the reference bits the ones before it set).
fn (db: mut &Db) installOnly(r: LoadReq, b: &[]byte): Result[Unit, lexdb_base.DbErr] {
    let s = r.slot
    if !db.meta[s].used || db.meta[s].gen != r.gen || db.meta[s].loaded || db.meta[s].disk != r.page {
        return Ok(Unit{})
    }
    try lexdb_page.check(b, r.page, lexdb_page.T_LEAF)
    var n = lexdb_page.decodeNode(b)
    if !n.leaf {
        for i in 0..len(n.kids) {
            let k = db.allocSlot()
            db.meta[k].disk = n.kids[i]
            db.meta[k].ckpt = db.meta[s].ckpt
            n.kids[i] = k
        }
    }
    db.setNode(s, n)
    db.meta[s].loaded = true
    db.meta[s].ref = true
    db.loadedCount += 1
    db.recost(s)
    db.loads += 1
    return Ok(Unit{})
}

// Loads the page of a slot that is not in memory (parks).
fn (st: &Store) load(slot: int): Result[Unit, lexdb_base.DbErr] {
    var r = LoadReq{slot: 0, gen: 0, page: -1}
    var f = lexdb_disk.File.Real(-1, false)
    st.sh.with(fn(db: mut &Db) {
        r = db.loadReq(slot)
        f = db.data
    })
    if r.page < 0 { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "load: a slot without a page")) }
    var b = array(PAGE, byte(0))
    try f.read(r.page * PAGE, mut &b[0..PAGE], PAGE)
    var res: Result[Unit, lexdb_base.DbErr] = Ok(Unit{})
    st.sh.with(fn(db: mut &Db) { res = db.install(r, &b) })
    return res
}

// Read-ahead (9.51): a scan that needs a page loads it with the pages of
// the leaves after it under the same parent, when those are not in memory
// and are at the pages after its own, in one read. Checkpoints write a
// tree's leaves in key order, so a run is most of a parent's children. A
// scan's first read is AHEAD_MIN pages, each next one twice its last, up to
// AHEAD_MAX (256 KiB): a short scan reads little ahead, a long one reads
// at the disk's sequential speed. A lookup reads its one page (load).
const AHEAD_MIN = 8
const AHEAD_MAX = 64

// The slots to read from kids[i] on, when kids[i] is not in memory: those
// in a row whose pages follow its own, at most max.
// A run is at most a 32nd of the cache's budget in pages (a decoded page
// costs more than its 4 KiB), so a small cache does not evict a run's
// pages before the scan reaches them.
fn (db: &Db) runAt(kids: &[]int, i: int, most: int): []LoadReq {
    var out: []LoadReq = []
    if i < 0 || i >= len(kids) { return out }
    let max = min(most, db.opts.cacheBytes / (32 * PAGE))
    let first = kids[i]
    let p0 = db.meta[first].disk
    if p0 < 0 { return out }
    var j = i
    while j < len(kids) && len(out) < max {
        let s = kids[j]
        if !db.meta[s].used || db.meta[s].loaded || db.meta[s].disk != p0 + (j - i) { break }
        append(mut &out, db.loadReq(s))
        j += 1
    }
    return out
}

// The run of slots to read for slot need, which descend reached under
// parent par (live tree) by key k: runAt there, if need is its child at k.
fn (db: &Db) runFor(par: int, k: &str, need: int, max: int): []LoadReq {
    let none: []LoadReq = []
    if par < 0 || !db.meta[par].loaded { return none }
    let pn = &db.pool[db.meta[par].frame]
    if pn.leaf { return none }
    let i = childIndex(&pn.keys, k)
    if i >= len(pn.kids) || pn.kids[i] != need { return none }
    return db.runAt(&pn.kids, i, max)
}

// Loads slot need, and the run read ahead with it (runAt) when there is
// one: the pages in one read, installed together.
fn (st: &Store) loadAhead(need: int, run: &[]LoadReq): Result[Unit, lexdb_base.DbErr] {
    let n = len(run)
    if n <= 1 || run[0].slot != need { return st.load(need) }
    var f = lexdb_disk.File.Real(-1, false)
    st.sh.with(fn(db: mut &Db) { f = db.data })
    var bufs: [][]byte = []
    for j in 0..n { append(mut &bufs, array(PAGE, byte(0))) }
    try f.readPages(run[0].page * PAGE, mut &bufs)
    var res: Result[Unit, lexdb_base.DbErr] = Ok(Unit{})
    st.sh.with(fn(db: mut &Db) {
        for j in 0..n {
            match db.install(run[j], &bufs[j]) {
                Ok(_) {}
                Err(x) {
                    res = Err(x)
                    return
                }
            }
        }
        db.aheadReads += 1
        db.aheadPages += n
    })
    return res
}

// How many reads loadMany has in flight at a time.
const READS_IN_FLIGHT = 32

type PageRead = record { f: lexdb_disk.File; page: int; n: int }

fn readOne(r: PageRead): Result[[][]byte, lexdb_base.DbErr] {
    var bufs: [][]byte = []
    for j in 0..r.n { append(mut &bufs, array(PAGE, byte(0))) }
    if r.n == 1 { try r.f.read(r.page * PAGE, mut &bufs[0][0..PAGE], PAGE) } else { try r.f.readPages(r.page * PAGE, mut &bufs) }
    return Ok(bufs)
}

// Loads the slots not in memory among slots, READS_IN_FLIGHT reads at a
// time. Their pages are read in order, and pages next to each other in
// one read (at most AHEAD_MAX): a commit's leaves are scattered when its
// writes are, but a large commit's (its writes in key order: commitOrder)
// are mostly a tree's leaves in a row, which checkpoints write in key
// order (9.110). The cache is swept once, after all are in: they are
// marked referenced, and so are the nodes the caller's descents just
// passed, so a commit's nodes are not evicted by its own loads (the cache
// holds more than its size meanwhile, as before).
fn (st: &Store) loadMany(slots: &[]int): Result[Unit, lexdb_base.DbErr] {
    if len(slots) == 1 { return st.load(slots[0]) }
    var reqs: []LoadReq = []
    var f = lexdb_disk.File.Real(-1, false)
    var bad = false
    st.sh.with(fn(db: mut &Db) {
        f = db.data
        for s in slots {
            if !db.meta[s].used || db.meta[s].loaded { continue }
            if db.meta[s].disk < 0 {
                bad = true
                return
            }
            append(mut &reqs, db.loadReq(s))
        }
    })
    if bad { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "load: a slot without a page")) }
    collections.sortBy(mut &reqs, fn(a, b) { return a.page.cmp(&b.page) })
    // the reads: (first request, pages) pairs of requests for pages in a row
    var runs: []int = []
    var i = 0
    while i < len(reqs) {
        var j = i + 1
        while j < len(reqs) && j - i < AHEAD_MAX && reqs[j].page == reqs[j - 1].page + 1 { j += 1 }
        append(mut &runs, i)
        append(mut &runs, j - i)
        i = j
    }
    var r = 0
    while r < len(runs) {
        let rend = min(r + 2 * READS_IN_FLIGHT, len(runs))
        let at = runs[r]
        let end = runs[rend - 2] + runs[rend - 1]
        var batch: []PageRead = []
        var q = r
        while q < rend {
            append(mut &batch, PageRead{f: f, page: reqs[runs[q]].page, n: runs[q + 1]})
            q += 2
        }
        var got: []Result[[][]byte, lexdb_base.DbErr] = []
        var res: Result[Unit, lexdb_base.DbErr] = Ok(Unit{})
        task.scope(fn(sc: mut &task.Scope) {
            var fs: []task.Future[Result[[][]byte, lexdb_base.DbErr]] = []
            while len(batch) > 0 { append(mut &fs, sc.start(readOne, pop(mut &batch))) }
            match task.all(fs) {
                Ok(rs) { got = rs }
                Err(_) { res = Err(lexdb_base.err(lexdb_base.S_INTERNAL, "load: a page read was cancelled")) }
            }
        })
        try res
        // (started from the batch's end: got is in reverse order)
        var pages: [][]byte = []
        while len(got) > 0 {
            let g = pop(mut &got)
            if g.isErr() { return Err(g.unwrapErr()) }
            var bufs = g.unwrap()
            for k in 0..len(bufs) { append(mut &pages, replace(mut &bufs[k], [])) }
        }
        st.sh.with(fn(db: mut &Db) {
            for j in 0..len(pages) {
                match db.installOnly(reqs[at + j], &pages[j]) {
                    Ok(_) {}
                    Err(x) {
                        res = Err(x)
                        return
                    }
                }
            }
        })
        try res
        r = rend
    }
    st.sh.with(fn(db: mut &Db) { db.maybeEvict() })
    return Ok(Unit{})
}

// ---- descending

// The number of keys <= k: the child to follow.
fn childIndex(keys: &[]str, k: &str): int {
    var lo = 0
    var hi = len(keys)
    while lo < hi {
        let mid = (lo + hi) / 2
        if keys[mid] <= k { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

// The first index whose key is >= k.
fn lowerIndex(keys: &[]str, k: &str): int {
    var lo = 0
    var hi = len(keys)
    while lo < hi {
        let mid = (lo + hi) / 2
        if keys[mid] < k { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

// A descent: the path from the root to the leaf for a key, or the slot to
// load first (need >= 0). upper is the smallest separator above the key on
// the path: the leaf holds no key >= it.
type Descent = record {
    path: []int
    need: int
    upper: str
    hasUpper: bool
}

fn (db: mut &Db) descend(tree: int, k: &str): Descent {
    // From the last descent's path, at the deepest node whose separators
    // hold k (a finger): a commit's writes in key order (a load, a range
    // deleted, and every large commit's since 9.110: commitOrder) mostly
    // go to the leaf the one before went to, or to one near it.
    var d = Descent{path: [], need: -1, upper: "", hasUpper: false}
    var s = -1
    var lo = ""
    var hasLo = false
    var los: []str = []
    var hasLos: []bool = []
    var his: []str = []
    var hasHis: []bool = []
    if db.lastLeaf.shape == db.shape && db.lastLeaf.tree == tree && len(db.lastLeaf.path) > 0 {
        var j = len(db.lastLeaf.path) - 1
        while j > 0 && !((!db.lastLeaf.hasLo[j] || k >= db.lastLeaf.lo[j]) && (!db.lastLeaf.hasHi[j] || k < db.lastLeaf.hi[j])) { j -= 1 }
        if j == len(db.lastLeaf.path) - 1 {
            for x in 0..len(db.lastLeaf.path) {
                let sl = db.lastLeaf.path[x]
                db.meta[sl].ref = true
            }
            return Descent{path: collections.copyOf(&db.lastLeaf.path), need: -1, upper: db.lastLeaf.hi[j], hasUpper: db.lastLeaf.hasHi[j]}
        }
        for x in 0..j {
            let sl = db.lastLeaf.path[x]
            db.meta[sl].ref = true
            append(mut &d.path, sl)
            append(mut &los, db.lastLeaf.lo[x])
            append(mut &hasLos, db.lastLeaf.hasLo[x])
            append(mut &his, db.lastLeaf.hi[x])
            append(mut &hasHis, db.lastLeaf.hasHi[x])
        }
        s = db.lastLeaf.path[j]
        lo = db.lastLeaf.lo[j]
        hasLo = db.lastLeaf.hasLo[j]
        d.upper = db.lastLeaf.hi[j]
        d.hasUpper = db.lastLeaf.hasHi[j]
    } else {
        s = match db.trees.get(&tree) { Some(r) { r } None { -1 } }
        if s < 0 { return d }
    }
    while true {
        if !db.meta[s].loaded {
            d.need = s
            return d
        }
        db.meta[s].ref = true
        append(mut &d.path, s)
        append(mut &los, lo)
        append(mut &hasLos, hasLo)
        append(mut &his, d.upper)
        append(mut &hasHis, d.hasUpper)
        if db.pool[db.meta[s].frame].leaf {
            db.lastLeaf = LastLeaf{tree: tree, shape: db.shape, path: collections.copyOf(&d.path), lo: los, hasLo: hasLos, hi: his, hasHi: hasHis}
            return d
        }
        let i = childIndex(&db.pool[db.meta[s].frame].keys, k)
        if i < db.pool[db.meta[s].frame].count() {
            d.upper = db.pool[db.meta[s].frame].key(i)
            d.hasUpper = true
        }
        if i > 0 {
            lo = db.pool[db.meta[s].frame].key(i - 1)
            hasLo = true
        }
        s = db.pool[db.meta[s].frame].kids[i]
    }
    return d
}

// ---- changing a tree (inside with; every node on the path is in memory)

// collections.insert and removeAt for a node's keys and values, each
// element moved by replace rather than swap: about 3 times faster, which
// matters as front-coded leaves hold several times the entries (an index's
// leaf about 700: design/lexdb.md 9.109).
fn insertStr(xs: mut &[]str, i: int, x: str) {
    append(xs, "")
    var j = len(xs) - 1
    while j > i {
        xs[j] = replace(mut &xs[j - 1], "")
        j -= 1
    }
    xs[i] = x
}

fn removeStr(xs: mut &[]str, i: int): str {
    let out = replace(mut &xs[i], "")
    for j in i..len(xs) - 1 { xs[j] = replace(mut &xs[j + 1], "") }
    let last = pop(xs)
    return out
}

fn nodeSize(n: &lexdb_page.Node): int {
    var size = 0
    if n.leaf {
        size = lexdb_page.leafSize(n)       // front coded (lexdb_page T_FLEAF, 9.109)
    } else {
        size = 8
        for k in n.keys { size += lexdb_page.kidEntry(&k) }
    }
    return size
}

// Splits an oversized node; the new right node's slot and separator.
// at >= 0: a leaf of a companion tree, the new entry's index. A large
// value's chunks come in key order, so the leaf is split just after the new
// entry, or else just before it, when both halves fit: the leaves a run of
// chunks fills stay full, where halving would leave them half full wherever
// in the tree the run goes (9.30).
fn (db: mut &Db) split(s: int, atEnd: bool, at: int): Descent {
    db.shape += 1
    db.willChange(s)
    db.pool[db.meta[s].frame].loosen()
    let leaf = db.pool[db.meta[s].frame].leaf
    let total = db.pool[db.meta[s].frame].size
    let n = db.pool[db.meta[s].frame].count()
    var right = lexdb_page.newNode(leaf)
    var sep = ""
    if leaf {
        // Entry sizes front coded (lexdb_page T_FLEAF): each after the key
        // before it; the right node's first entry, after none, takes its
        // key whole (first), at most its bytes in T_LEAF. A half of the
        // entries is then at most about half the node and one entry, so
        // both fit, as before (MAX_ENTRY).
        let sizes = lexdb_page.leafSizes(&db.pool[db.meta[s].frame])
        var acc = 0
        var m = 0
        while m < n - 1 {
            let e = sizes[m]
            if m > 0 && acc + e > total / 2 { break }
            acc += e
            m += 1
        }
        if atEnd && n >= 2 { m = n - 1 }        // the left stays full: only the new entry goes right
        if at >= 0 {
            var left = 0
            for i in 0..at + 1 { left += sizes[i] }
            let rightAt = if at + 1 < n { total - left - sizes[at + 1] + lexdb_page.frontEntry(&"", &db.pool[db.meta[s].frame].keys[at + 1], &db.pool[db.meta[s].frame].vals[at + 1]) } else { 0 }
            if at + 1 < n && left <= lexdb_page.NODE_ROOM && rightAt <= lexdb_page.NODE_ROOM {
                m = at + 1
            } else {
                left -= sizes[at]
                let right2 = total - left - sizes[at] + lexdb_page.frontEntry(&"", &db.pool[db.meta[s].frame].keys[at], &db.pool[db.meta[s].frame].vals[at])
                if at > 0 && left <= lexdb_page.NODE_ROOM && right2 <= lexdb_page.NODE_ROOM { m = at }
            }
        }
        for i in m..n {
            append(mut &right.keys, db.pool[db.meta[s].frame].keys[i])
            append(mut &right.vals, db.pool[db.meta[s].frame].vals[i])
        }
        for i in m..n {
            let k = pop(mut &db.pool[db.meta[s].frame].keys)
            let v = pop(mut &db.pool[db.meta[s].frame].vals)
        }
        sep = lexdb_base.own(&right.keys[0])
    } else {
        var acc = 8
        var m = 1
        while m < n - 1 {
            let e = lexdb_page.kidEntry(&db.pool[db.meta[s].frame].key(m - 1))
            if acc + e > total / 2 { break }
            acc += e
            m += 1
        }
        if atEnd && n >= 3 { m = n - 2 }        // the left stays full: the last two children go right
        // keys[m] goes up; keys after it and kids after m go right
        sep = lexdb_base.own(&db.pool[db.meta[s].frame].key(m))
        for i in m + 1..n { append(mut &right.keys, db.pool[db.meta[s].frame].keys[i]) }
        for i in m + 1..n + 1 { append(mut &right.kids, db.pool[db.meta[s].frame].kids[i]) }
        for i in m..n {
            let k = pop(mut &db.pool[db.meta[s].frame].keys)
            let c = pop(mut &db.pool[db.meta[s].frame].kids)
        }
    }
    db.pool[db.meta[s].frame].size = nodeSize(&db.pool[db.meta[s].frame])
    right.size = nodeSize(&right)
    db.meta[s].version += 1
    db.pool[db.meta[s].frame].packed = false
    db.recost(s)
    let r = db.newNode(right)
    return Descent{path: [r], need: -1, upper: sep, hasUpper: true}
}

// After path[j] grew past a page, split it and the parents that overflow
// in turn; a split root gets a new root above it. A table's leaf may hold
// more rows than a page of rows, as many as a column leaf holds (leafRoom).
fn (db: mut &Db) fixOverflow(tree: int, path: &[]int, from: int, atEnd: bool, ins: int) {
    var j = from
    var end = atEnd
    while j >= 0 {
        let s = path[j]
        let room = if db.pool[db.meta[s].frame].leaf { db.leafRoom(tree, s) } else { lexdb_page.NODE_ROOM }
        if db.pool[db.meta[s].frame].size <= room { return }
        let sp = db.split(s, end, if j == len(path) - 1 { ins } else { -1 })
        if room > lexdb_page.NODE_ROOM { db.noteSplit(tree) }
        end = db.hang(tree, path, j, &sp, end)
        if j == 0 { return }
        j -= 1
    }
}

// Hangs the right node of path[j]'s split (sp: its slot and separator)
// beside it, in its parent, or under a new root when path[j] is the root.
// Whether the new node is its parent's last, with atEnd (fixOverflow's end).
fn (db: mut &Db) hang(tree: int, path: &[]int, j: int, sp: &Descent, atEnd: bool): bool {
    let s = path[j]
    let r = sp.path[0]
    if j == 0 {
        let root = lexdb_page.Node{leaf: false, keys: [sp.upper], vals: [], kids: [s, r], size: 0, packed: false, lazy: false, body: "", ents: [], cols: "", cdir: []}
        var rn = root
        rn.size = nodeSize(&rn)
        let ns = db.newNode(rn)
        db.meta[s].root = false
        db.meta[ns].root = true
        db.recost(s)
        db.setRoot(tree, ns)
        return atEnd
    }
    let p = path[j - 1]
    db.willChange(p)
    var at = 0
    while db.pool[db.meta[p].frame].kids[at] != s { at += 1 }
    db.shape += 1
    insertStr(mut &db.pool[db.meta[p].frame].keys, at, sp.upper)
    collections.insert(mut &db.pool[db.meta[p].frame].kids, at + 1, r)
    let end = atEnd && at + 2 == len(db.pool[db.meta[p].frame].kids)     // the new child is the parent's last
    db.pool[db.meta[p].frame].size += lexdb_page.kidEntry(&sp.upper)
    db.meta[p].version += 1
    db.pool[db.meta[p].frame].packed = false
    db.recost(p)
    return end
}

// ---- table leaves of a column leaf's rows (9.112)
//
// A column leaf holds more rows than a page of rows (about 73 of w's
// against 43). So a changed leaf of a table tree with layouts is split
// when its rows pass what a column leaf of them is estimated to hold: a
// page's bytes over the tree's ratio of column bytes to row bytes, as last
// sampled (an encoding of the leaf being split, at first and every 64th
// split after), less 4%. A checkpoint then makes sure (refit): a changed
// leaf over a page of rows is written as a column leaf if it fits one, and
// is cut into leaves that do if not (or into leaves of a page of rows
// each, when its rows do not encode).

const CAP_LEAF = 4 * lexdb_page.NODE_ROOM      // the most row bytes a leaf holds in memory
const COL_ROOM = lexdb_page.PAGE - 22          // a column leaf's keys and columns at most

// The bytes leaf s of tree may take before it splits.
fn (db: mut &Db) leafRoom(tree: int, s: int): int {
    let size = db.pool[db.meta[s].frame].size
    if size <= lexdb_page.NODE_ROOM || !lexdb_cols.on() || db.colsOff { return lexdb_page.NODE_ROOM }
    let i = match db.colSpecs.get(&tree) {
        Some(x) { x }
        None { return lexdb_page.NODE_ROOM }
    }
    // sampled at first, and when a leaf is about to split (it is about
    // as full as a column leaf then: a ratio taken from a leaf of fewer
    // rows counts its dictionaries and headers more)
    if db.specRatio[i] == 0 || (db.specSplits[i] >= 64 && size > roomOf(db.specRatio[i])) {
        db.specSplits[i] = 0
        let f = db.meta[s].frame
        let e = lexdb_page.colSize(&db.pool[f], 0, db.pool[f].count(), &db.specs[i])
        db.noteRatio(i, e, size)
        if e >= 0 && e <= lexdb_page.PAGE && size <= CAP_LEAF { return size }        // fits as it is
    }
    return roomOf(db.specRatio[i])
}

// The row bytes a column leaf holds at ratio r (noteRatio's), less 3%.
fn roomOf(r: int): int {
    if r <= 0 { return lexdb_page.NODE_ROOM }
    let room = COL_ROOM * 1000 / r * 97 / 100
    return if room < lexdb_page.NODE_ROOM { lexdb_page.NODE_ROOM } else if room > CAP_LEAF { CAP_LEAF } else { room }
}

// A sample of spec i's leaves: e page bytes as a column leaf (-1: its rows
// did not encode) for size bytes of rows.
fn (db: mut &Db) noteRatio(i: int, e: int, size: int) {
    if e < 0 {
        if db.specRatio[i] == 0 { db.specRatio[i] = -1 }
        return
    }
    let r = e * 1000 / size + 1
    db.specRatio[i] = if db.specRatio[i] <= 0 { r } else { (db.specRatio[i] * 3 + r) / 4 }
}

fn (db: mut &Db) noteSplit(tree: int) {
    match db.colSpecs.get(&tree) {
        Some(i) { db.specSplits[i] += 1 }
        None {}
    }
}

// Splits leaf path[last] of tree before its entry m (0 < m < count): the
// entries from m go to a new leaf beside it; parents that overflow split
// in turn.
fn (db: mut &Db) cutLeaf(tree: int, path: &[]int, m: int) {
    let j = len(path) - 1
    let s = path[j]
    db.shape += 1
    db.willChange(s)
    db.pool[db.meta[s].frame].loosen()
    let n = db.pool[db.meta[s].frame].count()
    var right = lexdb_page.newNode(true)
    for i in m..n {
        append(mut &right.keys, db.pool[db.meta[s].frame].keys[i])
        append(mut &right.vals, db.pool[db.meta[s].frame].vals[i])
    }
    for i in m..n {
        let k = pop(mut &db.pool[db.meta[s].frame].keys)
        let v = pop(mut &db.pool[db.meta[s].frame].vals)
    }
    let sep = lexdb_base.own(&right.keys[0])
    db.pool[db.meta[s].frame].size = nodeSize(&db.pool[db.meta[s].frame])
    right.size = nodeSize(&right)
    db.meta[s].version += 1
    db.pool[db.meta[s].frame].packed = false
    db.recost(s)
    let r = db.newNode(right)
    let sp = Descent{path: [r], need: -1, upper: sep, hasUpper: true}
    let end = db.hang(tree, path, j, &sp, false)
    if j > 0 { db.fixOverflow(tree, path, j - 1, false, -1) }
}

// Before a checkpoint writes the trees: every changed leaf of a table tree
// over a page of rows becomes a column leaf that fits a page, or is cut
// into leaves that do (refitLeaf).
fn (db: mut &Db) refit() {
    for x in 0..db.colSpecs.size() {
        let tree: int = db.colSpecs.keyAt(x)
        let i: int = db.colSpecs.valAt(x)
        let root = match db.trees.get(&tree) {
            Some(r) { r }
            None { -1 }
        }
        if root < 0 || !db.meta[root].dirty { continue }
        // the first keys of the leaves to fit: changed nodes only (a
        // changed node's parents are changed, and in memory)
        var firsts: []str = []
        var stack = [root]
        while len(stack) > 0 {
            let s = pop(mut &stack)
            if !db.meta[s].dirty || !db.meta[s].loaded { continue }
            let f = db.meta[s].frame
            if db.pool[f].leaf {
                if db.pool[f].size > lexdb_page.NODE_ROOM && !db.pool[f].isCols() && db.pool[f].count() > 0 { append(mut &firsts, db.pool[f].key(0)) }
                continue
            }
            for k in db.pool[f].kids { append(mut &stack, k) }
        }
        for k in firsts { db.refitLeaf(tree, i, &k) }
    }
}

fn (db: mut &Db) refitLeaf(tree: int, i: int, first: &str) {
    var k = first.toStr()
    let cols = lexdb_cols.on() && !db.colsOff
    var guard = 0
    while guard < 10000 {
        guard += 1
        let d = db.descend(tree, &k)
        if d.need >= 0 || len(d.path) == 0 { return }
        let s = d.path[len(d.path) - 1]
        let f = db.meta[s].frame
        if db.pool[f].isCols() { return }
        let n = db.pool[f].count()
        if cols {
            let c0 = lexdb_cols.converted()
            match lexdb_page.colBody(&db.pool[f], &db.specs[i]) {
                Some(b) {
                    if lexdb_cols.converted() != c0 { db.willChange(s) }
                    lexdb_page.repack(mut &db.pool[f], &b)
                    db.recost(s)
                    return
                }
                None {}
            }
        }
        if db.pool[f].size <= lexdb_page.NODE_ROOM { return }
        let e = if cols { lexdb_page.colSize(&db.pool[f], 0, n, &db.specs[i]) } else { -1 }
        var m = 0
        var body = ""
        if e > 0 {
            // as many rows as fit a column leaf: estimated, then fewer until they do
            m = n * COL_ROOM / e
            if m >= n { m = n - 1 }
            if m < 1 { m = 1 }
            while true {
                match lexdb_page.colBodyRange(&db.pool[f], 0, m, &db.specs[i]) {
                    Some(b) {
                        body = b
                        break
                    }
                    None {}
                }
                if m == 1 { break }
                m = m * 9 / 10
                if m < 1 { m = 1 }
            }
        }
        if len(body) == 0 {
            // a page of rows
            let sizes = lexdb_page.leafSizes(&db.pool[f])
            var acc = 0
            m = 0
            while m < n - 1 && (m == 0 || acc + sizes[m] <= lexdb_page.NODE_ROOM) {
                acc += sizes[m]
                m += 1
            }
        }
        if m <= 0 || m >= n { return }
        let next = lexdb_base.own(&db.pool[f].key(m))
        db.refitCuts += 1
        db.cutLeaf(tree, &d.path, m)
        if len(body) > 0 {
            lexdb_page.repack(mut &db.pool[db.meta[s].frame], &body)
            db.recost(s)
        }
        k = next
    }
}

fn (db: mut &Db) applyPut(tree: int, key: &str, val: &str) {
    let d = db.descend(tree, key)
    if len(d.path) == 0 { return }       // no such tree (recovery replays a dropped tree's rows)
    for s in d.path { db.markDirty(s) }
    let leaf = d.path[len(d.path) - 1]
    db.willChange(leaf)
    db.pool[db.meta[leaf].frame].loosen()
    let i = db.pool[db.meta[leaf].frame].lower(key)
    // A key past every key in the tree (the rightmost leaf, at its end): an
    // ascending load. Its splits leave the left node full, not half (as
    // PostgreSQL's rightmost split and SQLite's quick balance do): a table
    // loaded in key order then takes half the pages.
    let cnt = db.pool[db.meta[leaf].frame].count()
    let atEnd = !d.hasUpper && i == cnt
    // the size front coded: the entry's bytes after the key before it, and
    // the next entry's after it rather than after that one (lexdb_page T_FLEAF)
    let prev = if i > 0 { db.pool[db.meta[leaf].frame].keys[i - 1] } else { "" }
    if i < cnt && db.pool[db.meta[leaf].frame].key(i) == key {
        db.pool[db.meta[leaf].frame].size += lexdb_page.frontEntry(&prev, key, val) - lexdb_page.frontEntry(&prev, key, &db.pool[db.meta[leaf].frame].vals[i])
        db.pool[db.meta[leaf].frame].vals[i] = val
    } else {
        var grow = lexdb_page.frontEntry(&prev, key, val)
        if i < cnt {
            grow += lexdb_page.frontEntry(key, &db.pool[db.meta[leaf].frame].keys[i], &db.pool[db.meta[leaf].frame].vals[i]) -
                    lexdb_page.frontEntry(&prev, &db.pool[db.meta[leaf].frame].keys[i], &db.pool[db.meta[leaf].frame].vals[i])
        }
        insertStr(mut &db.pool[db.meta[leaf].frame].keys, i, key)
        insertStr(mut &db.pool[db.meta[leaf].frame].vals, i, val)
        db.pool[db.meta[leaf].frame].size += grow
    }
    db.meta[leaf].version += 1
    db.pool[db.meta[leaf].frame].packed = false
    db.recost(leaf)
    db.fixOverflow(tree, &d.path, len(d.path) - 1, atEnd, if isOvf(tree) { i } else { -1 })
}

fn (db: mut &Db) applyDel(tree: int, key: &str) {
    let d = db.descend(tree, key)
    if len(d.path) == 0 { return }
    let leaf = d.path[len(d.path) - 1]
    let i = db.pool[db.meta[leaf].frame].lower(key)
    if i >= db.pool[db.meta[leaf].frame].count() || db.pool[db.meta[leaf].frame].key(i) != key { return }
    for s in d.path { db.markDirty(s) }
    db.willChange(leaf)
    db.pool[db.meta[leaf].frame].loosen()
    // the size front coded (as applyPut's): the next entry then follows the key before this one
    let prev = if i > 0 { db.pool[db.meta[leaf].frame].keys[i - 1] } else { "" }
    var shrink = lexdb_page.frontEntry(&prev, &db.pool[db.meta[leaf].frame].keys[i], &db.pool[db.meta[leaf].frame].vals[i])
    if i + 1 < db.pool[db.meta[leaf].frame].count() {
        shrink += lexdb_page.frontEntry(&db.pool[db.meta[leaf].frame].keys[i], &db.pool[db.meta[leaf].frame].keys[i + 1], &db.pool[db.meta[leaf].frame].vals[i + 1]) -
                  lexdb_page.frontEntry(&prev, &db.pool[db.meta[leaf].frame].keys[i + 1], &db.pool[db.meta[leaf].frame].vals[i + 1])
    }
    db.pool[db.meta[leaf].frame].size -= shrink
    let k = removeStr(mut &db.pool[db.meta[leaf].frame].keys, i)
    let v = removeStr(mut &db.pool[db.meta[leaf].frame].vals, i)
    db.meta[leaf].version += 1
    db.pool[db.meta[leaf].frame].packed = false
    db.recost(leaf)
    // An empty node leaves its parent (no merging: design/lexdb.md 4.2),
    // its keys' range going to a neighbour: only when the neighbour's nodes
    // that take that range are in memory. A later write of the same commit
    // may go there, and a commit cannot load (writeNeeds loaded the nodes
    // as they were). Otherwise the empty node stays.
    var j = len(d.path) - 1
    while j > 0 {
        let c = d.path[j]
        let empty = if db.pool[db.meta[c].frame].leaf { db.pool[db.meta[c].frame].count() == 0 } else { len(db.pool[db.meta[c].frame].kids) == 0 }
        if !empty { break }
        let p = d.path[j - 1]
        var at = 0
        while db.pool[db.meta[p].frame].kids[at] != c { at += 1 }
        let nk = len(db.pool[db.meta[p].frame].kids)
        if at > 0 && !db.edgeLoaded(db.pool[db.meta[p].frame].kids[at - 1], true) { break }
        if at == 0 && nk > 1 && !db.edgeLoaded(db.pool[db.meta[p].frame].kids[1], false) { break }
        db.willChange(p)
        db.shape += 1
        let gone = collections.removeAt(mut &db.pool[db.meta[p].frame].kids, at)
        if db.pool[db.meta[p].frame].count() > 0 {
            let ki = if at == 0 { 0 } else { at - 1 }
            let sk = removeStr(mut &db.pool[db.meta[p].frame].keys, ki)
        }
        db.pool[db.meta[p].frame].size = nodeSize(&db.pool[db.meta[p].frame])
        db.meta[p].version += 1
        db.pool[db.meta[p].frame].packed = false
        db.recost(p)
        db.freeSlot(c)
        j -= 1
    }
    // The root: an internal root with no children becomes an empty leaf, and
    // one with a single child in memory gives way to it.
    var root = d.path[0]
    if !db.pool[db.meta[root].frame].leaf && len(db.pool[db.meta[root].frame].kids) == 0 {
        db.willChange(root)
        db.setNode(root, lexdb_page.newLeaf())
        db.meta[root].version += 1
        db.recost(root)
    }
    while !db.pool[db.meta[root].frame].leaf && len(db.pool[db.meta[root].frame].kids) == 1 && db.meta[db.pool[db.meta[root].frame].kids[0]].loaded {
        let only = db.pool[db.meta[root].frame].kids[0]
        db.markDirty(only)
        db.meta[only].root = true
        db.setRoot(tree, only)
        db.meta[root].root = false
        db.freeSlot(root)
        root = only
    }
}

// Whether a node and its last (right) or first children down to a leaf
// are in memory: the nodes that take an emptied neighbour's range.
fn (db: &Db) edgeLoaded(s: int, right: bool): bool {
    var x = s
    while true {
        if !db.meta[x].loaded { return false }
        if db.pool[db.meta[x].frame].leaf { return true }
        let n = len(db.pool[db.meta[x].frame].kids)
        if n == 0 { return true }
        x = db.pool[db.meta[x].frame].kids[if right { n - 1 } else { 0 }]
    }
    return true
}

// Sets (slot >= 0) or removes a tree's root, noting the change for snapshots.
fn (db: mut &Db) setRoot(tree: int, slot: int) {
    db.shape += 1
    let prev = match db.trees.get(&tree) { Some(x) { x } None { -1 } }
    if db.seq > db.durableSeq || db.maxSnap() >= 0 { append(mut &db.rootHist, RootChange{seq: db.seq, tree: tree, prev: prev}) }
    if slot >= 0 { db.trees.put(tree, slot) } else { let gone = db.trees.remove(&tree) }
}

fn (db: mut &Db) applyCreate(tree: int) {
    if db.trees.has(&tree) { return }
    let s = db.newNode(lexdb_page.newLeaf())
    db.meta[s].root = true
    db.setRoot(tree, s)
    if !isOvf(tree) && tree >= db.nextTree { db.nextTree = tree + 1 }
}

// Drops a tree. Its nodes in memory are freed; those that are not go to the
// dropped subtrees, which checkpoints free (9.32).
fn (db: mut &Db) applyDrop(tree: int) {
    let r = match db.trees.get(&tree) { Some(x) { x } None { -1 } }
    if r < 0 { return }
    db.setRoot(tree, -1)
    // Its height: writeNeeds loaded its first leaf's path (not known only
    // where nothing loaded it).
    var height = 0
    var x = r
    while db.meta[x].loaded && !db.pool[db.meta[x].frame].leaf {
        x = db.pool[db.meta[x].frame].kids[0]
        height += 1
    }
    if !db.meta[x].loaded { height = -1 }
    var stack = [r, 0]
    while len(stack) > 0 {
        let depth = pop(mut &stack)
        let s = pop(mut &stack)
        if db.meta[s].loaded && !db.pool[db.meta[s].frame].leaf {
            for k in db.pool[db.meta[s].frame].kids {
                append(mut &stack, k)
                append(mut &stack, depth + 1)
            }
        }
        db.freeSubtree(s, if height >= 0 { height - depth } else { -1 }, true)
    }
}

fn (db: mut &Db) applyWrite(w: &TxWrite) {
    // (a temporary object's row is its session's alone: 9.96)
    if w.tree == db.watched && !lexdb_base.tempCatKey(&w.key) { db.watchedWrites += 1 }
    if w.op == OP_PUT { db.putValue(w.tree, &w.key, &w.val, w.head) }
    else if w.op == OP_DEL {
        db.dropChunks(w.tree, &w.key)
        db.applyDel(w.tree, &w.key)
    }
    else if w.op == OP_CREATE { db.applyCreate(w.tree) }
    else if w.op == OP_DROP {
        db.applyDrop(w.tree)
        db.applyDrop(w.tree + OVF)
    }
}

// The slot a write needs loaded before it can be applied, or -1: the leaf
// of its key, and when it writes or removes a large value, the companion
// tree's leaves its chunks are in or go to; for a drop, a slot on the
// way to the first leaf of the tree or its companion.
fn (db: mut &Db) writeNeeds(w: &TxWrite): int {
    // A drop: the paths give the trees' heights (applyDrop).
    if w.op == OP_DROP {
        for t in [w.tree, w.tree + OVF] {
            let d = db.descend(t, &"")
            if d.need >= 0 { return d.need }
        }
        return -1
    }
    if w.op == OP_PUT || w.op == OP_DEL {
        let d = db.descend(w.tree, &w.key)
        if d.need >= 0 { return d.need }
        let ovf = w.tree + OVF
        if db.trees.has(&ovf) {
            var touch = w.op == OP_PUT && lexdb_page.leafEntry(&w.key, &w.val) + 1 > lexdb_page.MAX_ENTRY
            if !touch {
                match db.leafVal(w.tree, &w.key) {
                    Some(v) { touch = isStub(&v) }
                    None {}
                }
            }
            if touch { return db.rangeNeeds(ovf, &chunkKey(&w.key, 0), &chunkKey(&w.key, LAST_CHUNK)) }
        }
    }
    return -1
}

// ---- large values (design/lexdb.md 9.29)
//
// A value whose leaf entry would be over MAX_ENTRY is cut into chunks kept
// in its tree's companion tree (id tree + OVF), under the key's length,
// the key and the chunk's number; the leaf holds a stub: BIG, 1, the
// value's length (u64), its CRC32C (u32). A value that itself begins with
// BIG is stored with one more BIG before it. Only the store sees these
// forms: the log, a transaction's writes and what get and scans give are
// the values written. The chunks change only with their row, in the same
// apply, so they need no conflict marks of their own.

pub const MAX_VALUE = 64 * 1024 * 1024       // the wire's largest message (lexdb_wire.MAX_MESSAGE)
pub const OVF = 1 << 40                       // (public for the tests: a scan of tree + OVF gives its chunks)
const BIG: byte = 0xFF
pub const STUB_LEN = 14
pub const LAST_CHUNK = 0xFFFFFFFF                 // past every chunk's number: a key range's end

fn isOvf(tree: int): bool { return tree >= OVF }
pub fn marked(v: &str): bool { return len(v) > 0 && v[0] == BIG }
// A stub: version 1 (9.29) has no row start; version 2 (9.31) is followed
// by the value's first bytes, the chunks holding the rest.
pub fn isStub(v: &str): bool { return len(v) >= STUB_LEN && v[0] == BIG && ((v[1] == 1 && len(v) == STUB_LEN) || v[1] == 2) }

// How a scan gives large values: whole; RAW, as stored (a companion's
// chunks); PART, as their stubs (partOf, whole).
const M_FULL = 0
const M_RAW = 1
const M_PART = 2

// A large value's stored form as getPart and the Part scans give it: its
// first bytes (as many as its leaf holds), or None for any other value.
pub fn partOf(v: &str): Option[str] {
    if isStub(v) && v[1] == 2 { return Some(v[STUB_LEN..len(v)]) }
    return None
}

// A value given in part (partOf), whole.
pub fn (st: &Store) whole(t: mut &Txn, tree: int, key: &str, v: &str): Result[str, lexdb_base.DbErr] {
    if !isStub(v) { return Ok(lexdb_base.own(v)) }
    return st.unstore(t, tree, key, v)
}

pub fn chunkKey(key: &str, i: int): str {
    var b = newStrBuf()
    binary.addU16BE(mut &b, len(key))
    b.add(key)
    binary.addU32BE(mut &b, i)
    return b.toStr()
}

// The bytes of a value each chunk of key holds.
fn chunkRoom(key: &str): int { return lexdb_page.MAX_ENTRY - lexdb_page.leafEntry(&chunkKey(key, 0), &"") }

pub fn crcOf(crc: u32, s: &str): u32 { return hash.crc32cMore(crc, &strToBytes(s)) }

// The value at key in a tree whose leaf for it is in memory.
fn (db: mut &Db) leafVal(tree: int, key: &str): Option[str] {
    let d = db.descend(tree, key)
    if len(d.path) == 0 || d.need >= 0 { return None }
    let leaf = d.path[len(d.path) - 1]
    let i = db.pool[db.meta[leaf].frame].lower(key)
    if i < db.pool[db.meta[leaf].frame].count() && db.pool[db.meta[leaf].frame].key(i) == key {
        return Some(db.pool[db.meta[leaf].frame].val(i))
    }
    return None
}

// The first leaf of [lo, hi) of tree not in memory, or -1.
fn (db: mut &Db) rangeNeeds(tree: int, lo: &str, hi: &str): int {
    var cursor = lexdb_base.own(lo)
    while true {
        let d = db.descend(tree, &cursor)
        if d.need >= 0 { return d.need }
        if !d.hasUpper || d.upper >= hi { return -1 }
        cursor = d.upper
    }
    return -1
}

// Removes the chunks of the value at key, if it is a large one: the ones
// there (writeNeeds loaded their leaves), not as many as the stub's length
// says, so a damaged stub cannot make a commit run on.
fn (db: mut &Db) dropChunks(tree: int, key: &str) {
    // no companion tree, no chunks: not looked for (a put's descent saved)
    if !db.trees.has(&(tree + OVF)) { return }
    let big = match db.leafVal(tree, key) {
        Some(v) { isStub(&v) }
        None { false }
    }
    if !big { return }
    let ovf = tree + OVF
    let hi = chunkKey(key, LAST_CHUNK)
    var gone: []str = []
    var cursor = chunkKey(key, 0)
    while true {
        let d = db.descend(ovf, &cursor)
        if len(d.path) == 0 || d.need >= 0 { break }
        let leaf = d.path[len(d.path) - 1]
        var i = db.pool[db.meta[leaf].frame].lower(&cursor)
        while i < db.pool[db.meta[leaf].frame].count() && db.pool[db.meta[leaf].frame].key(i) < hi {
            append(mut &gone, lexdb_base.own(&db.pool[db.meta[leaf].frame].key(i)))
            i += 1
        }
        if !d.hasUpper || d.upper >= hi { break }
        cursor = d.upper
    }
    for k in gone { db.applyDel(ovf, &k) }
}

// Writes a value in its stored form: itself, escaped, or chunks and a stub.
fn (db: mut &Db) putValue(tree: int, key: &str, val: &str, want: int) {
    db.dropChunks(tree, key)
    let esc = marked(val)
    if lexdb_page.leafEntry(key, val) + (if esc { 1 } else { 0 }) <= lexdb_page.MAX_ENTRY {
        if !esc {
            db.applyPut(tree, key, val)
            return
        }
        var b = newStrBuf()
        b.addByte(BIG)
        b.add(val)
        db.applyPut(tree, key, &b.toStr())
        return
    }
    let ovf = tree + OVF
    if !db.trees.has(&ovf) { db.applyCreate(ovf) }
    let room = chunkRoom(key)
    // the first bytes the writer asked for, as many as the leaf entry
    // holds, stay in the stub
    let room0 = lexdb_page.MAX_ENTRY - lexdb_page.leafEntry(key, &"") - STUB_LEN
    let head = if want < 0 { 0 } else if want > room0 { room0 } else { want }
    var crc: u32 = crcOf(0, &val[0..head])
    var i = 0
    var at = head
    while at < len(val) {
        let end = if at + room < len(val) { at + room } else { len(val) }
        let part = lexdb_base.own(&val[at..end])
        crc = crcOf(crc, &part)
        db.applyPut(ovf, &chunkKey(key, i), &part)
        i += 1
        at = end
    }
    var b = newStrBuf()
    b.addByte(BIG)
    b.addByte(2)
    binary.addU64LE(mut &b, len(val))
    binary.addU32LE(mut &b, int(crc))
    b.add(&val[0..head])
    db.applyPut(tree, key, &b.toStr())
}

// The value written, from its stored form (marked): an escaped value without
// its mark, or a stub's chunks read back and checked. A live read that finds
// them changed since it read the stub (a commit between) fails as a conflict,
// as its commit would.
fn (st: &Store) unstore(t: mut &Txn, tree: int, key: &str, v: &str): Result[str, lexdb_base.DbErr] {
    if !isStub(v) { return Ok(v[1..len(v)]) }
    let total = int(binary.readU64LEStr(v, 2))
    let want = binary.readU32LEStr(v, 10)
    let head = v[STUB_LEN..len(v)]
    st.sh.with(fn(db: mut &Db) { db.wholes += 1 })
    var b = newStrBuf()
    b.add(&head)
    var got = len(head)
    var crc: u32 = crcOf(0, &head)
    try st.scanIn(t, tree + OVF, chunkKey(key, 0), chunkKey(key, LAST_CHUNK), fn(e: &Entry): bool {
        b.add(&e.val)
        got += len(e.val)
        crc = crcOf(crc, &e.val)
        return got <= total
    }, M_RAW)
    if got != total || int(crc) != want {
        if t.snap < 0 || t.live { return Err(lexdb_base.conflict()) }
        return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "a large value's chunks do not match it"))
    }
    return Ok(b.toStr())
}

// ---- the log record format

// The bytes t's records take in a frame.
fn recordsLen(writes: &[]TxWrite): int {
    var n = 0
    for w in writes { n += 13 + len(w.key) + len(w.val) + (if w.op == OP_PUT && w.head > 0 { 4 } else { 0 }) }
    return n
}

fn addRecord(b: mut &[]byte, w: &TxWrite) {
    let withHead = w.op == OP_PUT && w.head > 0
    append(b, byte(if withHead { OP_PUT_HEAD } else { w.op }))
    binary.appendU32LE(b, w.tree)
    binary.appendU32LE(b, len(w.key))
    appendStr(b, w.key)
    binary.appendU32LE(b, len(w.val))
    appendStr(b, w.val)
    if withHead { binary.appendU32LE(b, w.head) }
}

fn parseRecords(b: &[]byte, from: int, to: int): Result[[]TxWrite, lexdb_base.DbErr] {
    var out: []TxWrite = []
    var at = from
    while at < to {
        if at + 13 > to { return Err(lexdb_base.corrupt("log record cut short")) }
        let op = int(b[at])
        let tree = binary.readU32LE(b, at + 1)
        let kl = binary.readU32LE(b, at + 5)
        if at + 9 + kl + 4 > to { return Err(lexdb_base.corrupt("log record cut short")) }
        let key = strFromBytes(&b[at + 9..at + 9 + kl])
        let vl = binary.readU32LE(b, at + 9 + kl)
        let vs = at + 13 + kl
        if vs + vl > to { return Err(lexdb_base.corrupt("log record cut short")) }
        let val = strFromBytes(&b[vs..vs + vl])
        var head = 0
        var end = vs + vl
        if op == OP_PUT_HEAD {
            if end + 4 > to { return Err(lexdb_base.corrupt("log record cut short")) }
            head = binary.readU32LE(b, end)
            end += 4
        }
        append(mut &out, TxWrite{op: if op == OP_PUT_HEAD { OP_PUT } else { op }, tree: tree, key: key, val: val, head: head})
        at = end
    }
    return Ok(out)
}

// A frame: the header, the records, padded to whole pages so that a block
// once flushed is never written again (4.6).
// A batch's frame, made in place: b is the batch, its first FRAME_HDR
// bytes kept for the header (reserveBatch), then its records; padded to
// whole pages.
fn frame(b: mut &[]byte, count: int, batchNo: int, seg: int) {
    let plen = len(b) - FRAME_HDR
    while len(b) % PAGE != 0 { append(b, byte(0)) }
    binary.setU32LE(b, 0, LOG_MAGIC)
    binary.setU64LE(b, 8, batchNo)
    binary.setU32LE(b, 16, seg)
    binary.setU32LE(b, 20, plen)
    binary.setU32LE(b, 24, count)
    let c = lexdb_base.crc32c(b, 8, FRAME_HDR + plen)
    binary.setU32LE(b, 4, int(c))
}

// Room in the batch for t's records, made before they are added: a large
// commit's grow it once, not by doubling (which held the old and the new
// at once). A new batch starts with room for its frame's header.
fn (db: mut &Db) reserveBatch(t: &Txn) {
    var need = 0
    for w in t.writes { need += 17 + len(w.key) + len(w.val) }
    if len(db.batch) == 0 {
        var nb: []byte = withCapacity(FRAME_HDR + need + PAGE)
        for i in 0..FRAME_HDR { append(mut &nb, byte(0)) }
        db.batch = nb
    } else if need > 1048576 {
        var nb: []byte = withCapacity(len(db.batch) + need + PAGE)
        for x in db.batch { append(mut &nb, x) }
        db.batch = nb
    }
}

// ---- transactions

// Reads key in tree: the transaction's own write of it, else the store's.
pub fn (st: &Store) get(t: mut &Txn, tree: int, key: str): Result[Option[str], lexdb_base.DbErr] { return st.getIn(t, tree, key, M_FULL) }

// get, the read not noted for the commit's check: for what cannot change a
// result, as the planner's statistics (lexdb_exec optimizer 20), so that a write of
// them does not make the transaction conflict.
pub fn (st: &Store) getUnnoted(t: mut &Txn, tree: int, key: str): Result[Option[str], lexdb_base.DbErr] {
    let was = t.quiet
    t.quiet = true
    let got = st.getIn(t, tree, key, M_FULL)
    t.quiet = was
    return got
}

// get, a large value given in part (partOf, whole).
pub fn (st: &Store) getPart(t: mut &Txn, tree: int, key: str): Result[Option[str], lexdb_base.DbErr] { return st.getIn(t, tree, key, M_PART) }

fn (st: &Store) getIn(t: mut &Txn, tree: int, key: str, mode: int): Result[Option[str], lexdb_base.DbErr] {
    match t.lastWrite(tree, &key) {
        Some(i) {
            if t.writes[i].op == OP_DEL { return Ok(None) }
            return Ok(Some(t.writes[i].val))
        }
        None {}
    }
    match st.fo {
        Some(fo) {
            let s = try repSnap(&fo, t)
            return fo.get(&s, tree, &key)
        }
        None {}
    }
    if t.snap >= 0 && !t.live { return st.snapGet(t, tree, key, mode) }
    while true {
        var need = -1
        var out: Option[str] = None
        var bad: []lexdb_base.DbErr = []
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            let d = db.descend(tree, &key)
            if d.need >= 0 {
                need = d.need
                return
            }
            // an empty tree too: an insert of key conflicts. A read of a
            // key after the last one read, with no key of the tree between
            // them, widens that read instead (a load of rows in key order:
            // one range, not a mark per row)
            let nr = len(t.reads)
            var widened = false
            if !t.quiet && nr > 0 && t.reads[nr - 1].tree == tree && t.reads[nr - 1].seq == db.seq && len(t.reads[nr - 1].hi) > 0 && key >= t.reads[nr - 1].hi {
                var clear = len(d.path) == 0
                if !clear {
                    let lf = db.meta[d.path[len(d.path) - 1]].frame
                    let li = db.pool[lf].lower(&key)
                    // (an empty leaf: an empty tree; at a leaf's start, the key before
                    // is in another leaf: not looked for)
                    clear = db.pool[lf].count() == 0 || (li > 0 && db.pool[lf].key(li - 1) < t.reads[nr - 1].hi)
                }
                if clear {
                    t.reads[nr - 1].hi = key + "\x00"
                    widened = true
                }
            }
            if !widened && !t.quiet { t.noteRead(tree, key, key + "\x00", db.seq) }
            if len(d.path) == 0 { return }
            let leaf = d.path[len(d.path) - 1]
            let i = db.pool[db.meta[leaf].frame].lower(&key)
            if i < db.pool[db.meta[leaf].frame].count() && db.pool[db.meta[leaf].frame].key(i) == key {
                out = Some(db.pool[db.meta[leaf].frame].val(i))
            }
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need < 0 {
            match out {
                Some(v) {
                    if marked(&v) && !isOvf(tree) && !(mode == M_PART && isStub(&v)) { return Ok(Some(try st.unstore(t, tree, &key, &v))) }
                }
                None {}
            }
            return Ok(out)
        }
        try st.load(need)
    }
    return Ok(None)
}

// ---- many keys at once (lexdb.md 9.107)

// getMany's path from the root to the leaf of the last key: per node its
// slot, its version as snapNode takes it (-1 the current), and the keys it
// holds, [lo, hi) (each end bounded or not).
type Finger = record { slots: []int; vers: []int; lo: []str; hasLo: []bool; hi: []str; hasHi: []bool }

fn newFinger(): Finger { return Finger{slots: [], vers: [], lo: [], hasLo: [], hi: [], hasHi: []} }

fn (f: &Finger) holds(d: int, k: &str): bool { return (!f.hasLo[d] || f.lo[d] <= k) && (!f.hasHi[d] || k < f.hi[d]) }

fn (f: mut &Finger) push(s: int, v: int, lo: str, hasLo: bool, hi: str, hasHi: bool) {
    append(mut &f.slots, s)
    append(mut &f.vers, v)
    append(mut &f.lo, lo)
    append(mut &f.hasLo, hasLo)
    append(mut &f.hi, hi)
    append(mut &f.hasHi, hasHi)
}

fn (f: mut &Finger) pop() {
    let s = pop(mut &f.slots)
    let v = pop(mut &f.vers)
    let l = pop(mut &f.lo)
    let hl = pop(mut &f.hasLo)
    let h = pop(mut &f.hi)
    let hh = pop(mut &f.hasHi)
}

// A node's version for a read as of q (snap: a snapshot's; else the live
// tree's, -1 when loaded): verOf's codes, -2 to load it, -3 missing.
fn (db: &Db) fingerVer(s: int, snap: bool, q: int): int {
    if snap { return db.verOf(s, q) }
    return if db.meta[s].loaded { -1 } else { -2 }
}

// The leaf holding k, reached from the finger: up its path to the lowest
// node whose range holds k, then down. Its depth in f; -1 with need set: a
// node to load first; -2 a snapshot's version missing.
fn (db: mut &Db) fingerTo(f: mut &Finger, root: int, snap: bool, q: int, k: &str, need: mut &int): int {
    while len(f.slots) > 0 && !f.holds(len(f.slots) - 1, k) { f.pop() }
    if len(f.slots) == 0 {
        let v = db.fingerVer(root, snap, q)
        if v == -2 {
            need = root
            return -1
        }
        if v == -3 { return -2 }
        db.meta[root].ref = true
        f.push(root, v, "", false, "", false)
    }
    while true {
        let d = len(f.slots) - 1
        var c = -1
        var lo = ""
        var hasLo = false
        var hi = ""
        var hasHi = false
        {
            let n = db.snapNode(f.slots[d], f.vers[d])
            if n.leaf { return d }
            let i = childIndex(&n.keys, k)
            c = n.kids[i]
            if i > 0 {
                lo = n.key(i - 1)
                hasLo = true
            } else {
                lo = f.lo[d]
                hasLo = f.hasLo[d]
            }
            if i < n.count() {
                hi = n.key(i)
                hasHi = true
            } else {
                hi = f.hi[d]
                hasHi = f.hasHi[d]
            }
        }
        let v = db.fingerVer(c, snap, q)
        if v == -2 {
            need = c
            return -1
        }
        if v == -3 { return -2 }
        db.meta[c].ref = true
        f.push(c, v, lo, hasLo, hi, hasHi)
    }
    return -1
}

// get (part: getPart) of each of keys in turn, their values (or None)
// appended to out: what as many calls give, their reads noted as they note
// them, in the same order. The store's lock is taken once for as many keys
// as it can, and a key is found from the path to the key before's leaf,
// not from the root: up to the lowest node whose range holds it, then down
// (none up, on the same leaf). Keys in order (a batch's lookups sorted, or
// an index's keys in its order) mostly stay on a leaf or go to the next.
pub fn (st: &Store) getMany(t: mut &Txn, tree: int, keys: &[]str, part: bool, out: mut &[]Option[str]): Result[Unit, lexdb_base.DbErr] {
    let mode = if part { M_PART } else { M_FULL }
    let n = len(keys)
    if st.fo.isSome() {
        // a replica's reads: one by one
        for k in keys { append(out, try st.getIn(t, tree, k, mode)) }
        return Ok(Unit{})
    }
    let snap = t.snap >= 0 && !t.live
    let sroot = if snap { match t.snapTrees.get(&tree) { Some(r) { r } None { -1 } } } else { -1 }
    let noting = t.noting()
    var i = 0
    while i < n {
        var need = -1
        var bad: []lexdb_base.DbErr = []
        var apart = false               // out's last value is stored apart: unstore it first
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            if snap && db.snapGone(t.snap) {
                append(mut &bad, snapCancelled())
                return
            }
            let root = if snap { sroot } else { match db.trees.get(&tree) { Some(r) { r } None { -1 } } }
            let q = if snap { t.snapSeq } else { db.seq }
            var f = newFinger()
            while i < n {
                // the transaction's own write of it
                match t.lastWrite(tree, &keys[i]) {
                    Some(w) {
                        if t.writes[w].op == OP_DEL { append(out, None) } else { append(out, Some(t.writes[w].val)) }
                        i += 1
                        continue
                    }
                    None {}
                }
                var d = -1
                if root >= 0 {
                    d = db.fingerTo(mut &f, root, snap, q, &keys[i], mut &need)
                    if d == -1 { return }
                    if d == -2 {
                        append(mut &bad, lexdb_base.err(lexdb_base.S_INTERNAL, "snapshot: a node version is missing"))
                        return
                    }
                }
                // noted as getIn notes it: a snapshot's key by key; the live
                // tree's widening the last read when no key is between
                if snap {
                    if noting { t.noteRead(tree, keys[i], keys[i] + "\x00", q) }
                } else {
                    let nr = len(t.reads)
                    var widened = false
                    if !t.quiet && nr > 0 && t.reads[nr - 1].tree == tree && t.reads[nr - 1].seq == q && len(t.reads[nr - 1].hi) > 0 &&
                       keys[i] >= t.reads[nr - 1].hi {
                        var clear = d < 0
                        if !clear {
                            let lf = db.snapNode(f.slots[d], f.vers[d])
                            let li = lf.lower(&keys[i])
                            clear = lf.count() == 0 || (li > 0 && lf.key(li - 1) < t.reads[nr - 1].hi)
                        }
                        if clear {
                            t.reads[nr - 1].hi = keys[i] + "\x00"
                            widened = true
                        }
                    }
                    if !widened && !t.quiet { t.noteRead(tree, keys[i], keys[i] + "\x00", q) }
                }
                var got: Option[str] = None
                if d >= 0 {
                    let lf = db.snapNode(f.slots[d], f.vers[d])
                    let li = lf.lower(&keys[i])
                    if li < lf.count() && lf.key(li) == keys[i] {
                        let v = lf.val(li)
                        apart = marked(&v) && !isOvf(tree) && !(mode == M_PART && isStub(&v))
                        got = Some(v)
                    }
                }
                append(out, got)
                i += 1
                if apart { return }
            }
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need >= 0 {
            try st.load(need)
            continue
        }
        if apart {
            let at = len(out) - 1
            let v = out[at].unwrap()
            out[at] = Some(try st.unstore(t, tree, &keys[i - 1], &v))
        }
    }
    return Ok(Unit{})
}

// The pages of tree and of its companion (large values), as the latest
// commit has them: for pg_relation_size and the like. The interior nodes
// are read (loaded if they are not in the cache); the leaves under the
// lowest interior level are counted from their parents, not loaded. The
// height is the leftmost path's. A replica: 0.
pub fn (st: &Store) treePages(tree: int): Result[int, lexdb_base.DbErr] {
    if st.fo.isSome() { return Ok(0) }
    var total = 0
    for tr in [tree, tree + OVF] {
        while true {
            var need = -1
            var count = 0
            var bad: []lexdb_base.DbErr = []
            st.sh.with(fn(db: mut &Db) {
                if len(db.failed) > 0 {
                    append(mut &bad, db.failed[0])
                    return
                }
                let r = match db.trees.get(&tr) { Some(x) { x } None { -1 } }
                if r < 0 { return }
                var h = 0
                var s = r
                while true {
                    if !db.meta[s].loaded {
                        need = s
                        return
                    }
                    if db.pool[db.meta[s].frame].leaf { break }
                    s = db.pool[db.meta[s].frame].kids[0]
                    h += 1
                }
                if h == 0 {
                    count = 1
                    return
                }
                var level: []int = [r]
                var depth = 0
                while depth < h {
                    var next: []int = []
                    for x in level {
                        if !db.meta[x].loaded {
                            need = x
                            return
                        }
                        count += 1
                        let nk = len(db.pool[db.meta[x].frame].kids)
                        if depth == h - 1 { count += nk } else { for k in db.pool[db.meta[x].frame].kids { append(mut &next, k) } }
                    }
                    level = next
                    depth += 1
                }
            })
            if len(bad) > 0 { return Err(bad[0]) }
            if need < 0 {
                total += count
                break
            }
            try st.load(need)
        }
    }
    return Ok(total)
}

// getIn for a snapshot's reads: the key's leaf as the snapshot sees it,
// one descent (9.53; a one-key scan, as before, cost a point lookup 15%).
fn (st: &Store) snapGet(t: mut &Txn, tree: int, key: str, mode: int): Result[Option[str], lexdb_base.DbErr] {
    let root = match t.snapTrees.get(&tree) { Some(r) { r } None { -1 } }
    let noting = t.noting()
    while true {
        var need = -1
        var out: Option[str] = None
        var bad: []lexdb_base.DbErr = []
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            if db.snapGone(t.snap) {
                append(mut &bad, snapCancelled())
                return
            }
            if root < 0 { return }
            let d = db.snapDescend(root, t.snapSeq, &key, false)
            if d.need >= 0 {
                need = d.need
                return
            }
            if d.missing {
                append(mut &bad, lexdb_base.err(lexdb_base.S_INTERNAL, "snapshot: a node version is missing"))
                return
            }
            let n = db.snapNode(d.leaf, d.ver)
            let i = n.lower(&key)
            if i < n.count() && n.key(i) == key { out = Some(n.val(i)) }
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need >= 0 {
            try st.load(need)
            continue
        }
        if noting { t.noteRead(tree, key, key + "\x00", t.snapSeq) }
        match out {
            Some(v) {
                if marked(&v) && !isOvf(tree) && !(mode == M_PART && isStub(&v)) { return Ok(Some(try st.unstore(t, tree, &key, &v))) }
            }
            None {}
        }
        return Ok(out)
    }
    return Ok(None)
}

// An entry a scan gives. What get and scans give shares the memory of the
// page the node was read from (its keys and values are slices of one
// string, design/lexdb.md 9.13): kept, it keeps that page's bytes alive,
// evicted or not. lexdb_exec keeps nothing beyond a statement; what is kept
// longer must be copied (lexdb_base.own). Copying every entry here cost
// scans 14%.
pub type Entry = value record { pub key: str; pub val: str }

// The transaction's own writes to tree with keys in [from, to) (to "" for no
// end), sorted, the last write of each key. The tree's keys are kept
// sorted (sortedKeys), so a scan's call costs the keys in its range and a
// binary search, not a pass over every write the transaction made: an
// INSERT ... SELECT's source scan called this per batch while its writes
// grew, quadratic in the rows (design/lexdb.md 9.109).
fn (t: mut &Txn) ownRange(tree: int, from: &str, to: &str): []TxWrite {
    var out: []TxWrite = []
    var k = 0
    while k < len(t.idxTrees) && t.idxTrees[k] != tree { k += 1 }
    if k == len(t.idxTrees) { return out }
    let n = t.idx[k].size()
    if t.sortedN[k] < n {
        var added: []str = []
        for i in t.sortedN[k]..n { append(mut &added, t.idx[k].keyAt(i)) }
        collections.sortBy(mut &added, fn(a: &str, b: &str): int { return a.cmp(b) })
        let old = replace(mut &t.sortedKeys[k], [])
        var merged: []str = withCapacity(len(old) + len(added))
        var a = 0
        var b = 0
        while a < len(old) || b < len(added) {
            if b == len(added) || (a < len(old) && old[a] < added[b]) {
                append(mut &merged, old[a])
                a += 1
            } else {
                append(mut &merged, added[b])
                b += 1
            }
        }
        t.sortedKeys[k] = merged
        t.sortedN[k] = n
    }
    var j = collections.lowerBound(&t.sortedKeys[k], from)
    while j < len(t.sortedKeys[k]) {
        if len(to) > 0 && t.sortedKeys[k][j] >= to { break }
        match t.idx[k].get(&t.sortedKeys[k][j]) {
            Some(i) { append(mut &out, t.writes[i]) }
            None {}
        }
        j += 1
    }
    return out
}

// Calls f on the entries of tree with keys in [from, to) (to "": to the
// end) in key order, the transaction's own writes included, while f gives
// true.
pub fn (st: &Store) scan(t: mut &Txn, tree: int, from: str, to: str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    return st.scanIn(t, tree, from, to, f, M_FULL)
}

// scan, large values given in part (partOf, whole).
pub fn (st: &Store) scanPart(t: mut &Txn, tree: int, from: str, to: str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    return st.scanIn(t, tree, from, to, f, M_PART)
}

// scan; raw: the stored forms, no reads noted (a companion tree's chunks).
fn (st: &Store) scanIn(t: mut &Txn, tree: int, from: str, to: str, f: &fn(&Entry): bool, mode: int): Result[Unit, lexdb_base.DbErr] {
    match st.fo {
        Some(fo) {
            let s = try repSnap(&fo, t)
            return fo.scan(&s, tree, &from, &to, f)
        }
        None {}
    }
    let raw = mode == M_RAW
    let own: []TxWrite = if raw { [] } else { t.ownRange(tree, &from, &to) }
    let root = if t.snap >= 0 && !t.live { match t.snapTrees.get(&tree) { Some(r) { r } None { -1 } } } else { -1 }
    var oi = 0
    var cursor = from
    var more = true
    let noting = !raw && t.noting()
    var ahead = if t.raTree == tree { t.ra } else { AHEAD_MIN }
    while more {
        var rseq = 0
        var need = -1
        var run: []LoadReq = []
        var seen = ""                   // the last key given to f in this chunk
        var chunk: []Entry = []
        var bad: []lexdb_base.DbErr = []
        var upper = ""
        var hasUpper = false
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            rseq = if t.snap >= 0 && !t.live { t.snapSeq } else { db.seq }
            if t.snap >= 0 && !t.live {
                if db.snapGone(t.snap) {
                    append(mut &bad, snapCancelled())
                    return
                }
                if root < 0 { return }
                let d = db.snapDescend(root, t.snapSeq, &cursor, false)
                if d.need >= 0 {
                    need = d.need
                    if d.par >= 0 { run = db.runAt(&db.snapNode(d.par, d.pver).kids, d.at, ahead) }
                    return
                }
                if d.missing {
                    append(mut &bad, lexdb_base.err(lexdb_base.S_INTERNAL, "snapshot: a node version is missing"))
                    return
                }
                let n = db.snapNode(d.leaf, d.ver)
                var i = n.lower(&cursor)
                while i < n.count() {
                    if len(to) > 0 && n.key(i) >= to { break }
                    append(mut &chunk, Entry{key: n.key(i), val: n.val(i)})
                    i += 1
                }
                upper = d.fence
                hasUpper = d.hasFence
                return
            }
            let d = db.descend(tree, &cursor)
            if d.need >= 0 {
                need = d.need
                if len(d.path) > 0 { run = db.runFor(d.path[len(d.path) - 1], &cursor, need, ahead) }
                return
            }
            if len(d.path) == 0 { return }
            let leaf = d.path[len(d.path) - 1]
            var i = db.pool[db.meta[leaf].frame].lower(&cursor)
            while i < db.pool[db.meta[leaf].frame].count() {
                let k = db.pool[db.meta[leaf].frame].key(i)
                if len(to) > 0 && k >= to { break }
                append(mut &chunk, Entry{key: k, val: db.pool[db.meta[leaf].frame].val(i)})
                i += 1
            }
            upper = d.upper
            hasUpper = d.hasUpper
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need >= 0 {
            try st.loadAhead(need, &run)
            if len(run) > 1 {
                ahead = min(ahead * 2, AHEAD_MAX)
                t.raTree = tree
                t.ra = ahead
            }
            continue
        }
        let last = !hasUpper || (len(to) > 0 && upper >= to)
        // Merge with the transaction's own writes below the chunk's end.
        var ci = 0
        while ci < len(chunk) || (oi < len(own) && (last || own[oi].key < upper)) {
            var takeOwn = false
            if oi < len(own) && (last || own[oi].key < upper) {
                takeOwn = ci >= len(chunk) || own[oi].key <= chunk[ci].key
            }
            if takeOwn {
                let w = own[oi]
                oi += 1
                if ci < len(chunk) && chunk[ci].key == w.key { ci += 1 }
                if w.op == OP_PUT {
                    seen = w.key.toStr()
                    if !f(&Entry{key: w.key, val: w.val}) {
                        if noting { t.noteRead(tree, cursor, w.key + "\x00", rseq) }
                        return Ok(Unit{})
                    }
                }
            } else {
                if !raw && marked(&chunk[ci].val) && !isOvf(tree) && !(mode == M_PART && isStub(&chunk[ci].val)) {
                    let v = try st.unstore(t, tree, &chunk[ci].key, &chunk[ci].val)
                    chunk[ci].val = v
                }
                seen = chunk[ci].key.toStr()
                if !f(&chunk[ci]) {
                    if noting { t.noteRead(tree, cursor, chunk[ci].key + "\x00", rseq) }
                    return Ok(Unit{})
                }
                ci += 1
            }
        }
        // the read: from the cursor to the leaf's fence, or to the end asked
        // (an open end: to the last key read, if any)
        if noting && last && t.openEnd {
            if len(seen) > 0 { t.noteRead(tree, cursor, seen + "\x00", rseq) }
        } else if noting { t.noteRead(tree, cursor, if !last { upper } else if len(to) > 0 { to } else { "" }, rseq) }
        if last { more = false } else { cursor = upper }
    }
    return Ok(Unit{})
}

// The entries of tree with keys in [from, to) (to "": to the end), read in
// place: f gets each leaf and the range [i, j) of its entries in the
// range, inside the store's lock, in key order, while it gives true. f
// must not use the store; a value stored apart (marked) is given as
// stored. Ok(false): nothing done, the transaction having its own writes
// in the range (scan merges them). Each leaf's whole range is noted as
// read, even when f stops in it (a wider read is safe).
pub fn (st: &Store) scanLeaves(t: mut &Txn, tree: int, from: str, to: str,
                               f: &fn(&lexdb_page.Node, int, int): bool): Result[bool, lexdb_base.DbErr] {
    if st.fo.isSome() { return Ok(false) }         // a replica's reads go through scan
    if len(t.ownRange(tree, &from, &to)) > 0 { return Ok(false) }
    let root = if t.snap >= 0 && !t.live { match t.snapTrees.get(&tree) { Some(r) { r } None { -1 } } } else { -1 }
    var cursor = from
    var more = true
    let noting = t.noting()
    var ahead = if t.raTree == tree { t.ra } else { AHEAD_MIN }
    while more {
        var rseq = 0
        var need = -1
        var run: []LoadReq = []
        var bad: []lexdb_base.DbErr = []
        var upper = ""
        var hasUpper = false
        var go = true
        var empty = false
        var seen = ""                   // the last key in the range given to f
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            rseq = if t.snap >= 0 && !t.live { t.snapSeq } else { db.seq }
            if t.snap >= 0 && !t.live {
                if db.snapGone(t.snap) {
                    append(mut &bad, snapCancelled())
                    return
                }
                if root < 0 {
                    empty = true
                    return
                }
                let d = db.snapDescend(root, t.snapSeq, &cursor, false)
                if d.need >= 0 {
                    need = d.need
                    if d.par >= 0 { run = db.runAt(&db.snapNode(d.par, d.pver).kids, d.at, ahead) }
                    return
                }
                if d.missing {
                    append(mut &bad, lexdb_base.err(lexdb_base.S_INTERNAL, "snapshot: a node version is missing"))
                    return
                }
                if d.ver == -1 { db.noteLeaf(tree, d.leaf) }
                let n = db.snapNode(d.leaf, d.ver)
                let i = n.lower(&cursor)
                var j = n.count()
                if len(to) > 0 { j = n.lower(&to) }
                if j > i {
                    seen = n.key(j - 1)
                    go = f(n, i, j)
                }
                upper = d.fence
                hasUpper = d.hasFence
                return
            }
            let d = db.descend(tree, &cursor)
            if d.need >= 0 {
                need = d.need
                if len(d.path) > 0 { run = db.runFor(d.path[len(d.path) - 1], &cursor, need, ahead) }
                return
            }
            if len(d.path) == 0 {
                empty = true
                return
            }
            let leaf = d.path[len(d.path) - 1]
            db.noteLeaf(tree, leaf)
            let n = &db.pool[db.meta[leaf].frame]
            let i = n.lower(&cursor)
            var j = n.count()
            if len(to) > 0 { j = n.lower(&to) }
            if j > i {
                seen = n.key(j - 1)
                go = f(n, i, j)
            }
            upper = d.upper
            hasUpper = d.hasUpper
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need >= 0 {
            try st.loadAhead(need, &run)
            if len(run) > 1 {
                ahead = min(ahead * 2, AHEAD_MAX)
                t.raTree = tree
                t.ra = ahead
            }
            continue
        }
        if empty { return Ok(true) }
        let last = !hasUpper || (len(to) > 0 && upper >= to)
        if noting && last && t.openEnd {
            if len(seen) > 0 { t.noteRead(tree, cursor, seen + "\x00", rseq) }     // an open end (Txn.openEnd)
        } else if noting { t.noteRead(tree, cursor, if !last { upper } else if len(to) > 0 { to } else { "" }, rseq) }
        if !go || last { more = false } else { cursor = upper }
    }
    return Ok(true)
}

// A descent for a backward scan: the leaf with the largest keys below k (k
// "": the last leaf). lower is the largest separator above it on the path:
// the leaf holds no key below it, so the next leaf back is the one below it.
fn (db: mut &Db) descendBack(tree: int, k: &str): Descent {
    var d = Descent{path: [], need: -1, upper: "", hasUpper: false}
    var s = match db.trees.get(&tree) { Some(r) { r } None { -1 } }
    if s < 0 { return d }
    while true {
        if !db.meta[s].loaded {
            d.need = s
            return d
        }
        db.meta[s].ref = true
        append(mut &d.path, s)
        if db.pool[db.meta[s].frame].leaf { return d }
        let j = if len(k) == 0 { db.pool[db.meta[s].frame].count() } else { db.pool[db.meta[s].frame].lower(k) }
        if j > 0 {
            d.upper = db.pool[db.meta[s].frame].key(j - 1)       // here: the lower fence
            d.hasUpper = true
        }
        s = db.pool[db.meta[s].frame].kids[j]
    }
    return d
}

// scan, backward: the entries with keys in [from, to) (to "": to the end)
// from the last down, the transaction's own writes included, while f gives
// true. Each leaf read is marked as scan marks it.
pub fn (st: &Store) scanBack(t: mut &Txn, tree: int, from: str, to: str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    return st.scanBackIn(t, tree, from, to, f, M_FULL)
}

// scanBack, large values given in part (partOf, whole).
pub fn (st: &Store) scanBackPart(t: mut &Txn, tree: int, from: str, to: str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    return st.scanBackIn(t, tree, from, to, f, M_PART)
}

fn (st: &Store) scanBackIn(t: mut &Txn, tree: int, from: str, to: str, f: &fn(&Entry): bool, mode: int): Result[Unit, lexdb_base.DbErr] {
    match st.fo {
        Some(fo) {
            let s = try repSnap(&fo, t)
            return fo.scanBack(&s, tree, &from, &to, f)
        }
        None {}
    }
    let own = t.ownRange(tree, &from, &to)
    let root = if t.snap >= 0 && !t.live { match t.snapTrees.get(&tree) { Some(r) { r } None { -1 } } } else { -1 }
    var oi = len(own) - 1
    var cursor = to
    var more = true
    let noting = t.noting()
    while more {
        var rseq = 0
        var need = -1
        var chunk: []Entry = []                 // descending
        var bad: []lexdb_base.DbErr = []
        var lower = ""
        var hasLower = false
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            rseq = if t.snap >= 0 && !t.live { t.snapSeq } else { db.seq }
            if t.snap >= 0 && !t.live {
                if db.snapGone(t.snap) {
                    append(mut &bad, snapCancelled())
                    return
                }
                if root < 0 { return }
                let d = db.snapDescend(root, t.snapSeq, &cursor, true)
                if d.need >= 0 {
                    need = d.need
                    return
                }
                if d.missing {
                    append(mut &bad, lexdb_base.err(lexdb_base.S_INTERNAL, "snapshot: a node version is missing"))
                    return
                }
                let n = db.snapNode(d.leaf, d.ver)
                var i = if len(cursor) == 0 { n.count() } else { n.lower(&cursor) }
                while i > 0 {
                    i -= 1
                    if n.key(i) < from { break }
                    append(mut &chunk, Entry{key: n.key(i), val: n.val(i)})
                }
                lower = d.fence
                hasLower = d.hasFence
                return
            }
            let d = db.descendBack(tree, &cursor)
            if d.need >= 0 {
                need = d.need
                return
            }
            if len(d.path) == 0 { return }
            let leaf = d.path[len(d.path) - 1]
            var i = if len(cursor) == 0 { db.pool[db.meta[leaf].frame].count() } else { db.pool[db.meta[leaf].frame].lower(&cursor) }
            while i > 0 {
                i -= 1
                let k = db.pool[db.meta[leaf].frame].key(i)
                if k < from { break }
                append(mut &chunk, Entry{key: k, val: db.pool[db.meta[leaf].frame].val(i)})
            }
            lower = d.upper
            hasLower = d.hasUpper
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need >= 0 {
            try st.load(need)
            continue
        }
        let last = !hasLower || lower <= from
        // Merge with the transaction's own writes at or above the leaf's fence.
        var ci = 0
        while ci < len(chunk) || (oi >= 0 && (last || own[oi].key >= lower)) {
            var takeOwn = false
            if oi >= 0 && (last || own[oi].key >= lower) {
                takeOwn = ci >= len(chunk) || own[oi].key >= chunk[ci].key
            }
            if takeOwn {
                let w = own[oi]
                oi -= 1
                if ci < len(chunk) && chunk[ci].key == w.key { ci += 1 }
                if w.op == OP_PUT {
                    if !f(&Entry{key: w.key, val: w.val}) {
                        if noting { t.noteRead(tree, w.key, cursor, rseq) }
                        return Ok(Unit{})
                    }
                }
            } else {
                if marked(&chunk[ci].val) && !isOvf(tree) && !(mode == M_PART && isStub(&chunk[ci].val)) {
                    let v = try st.unstore(t, tree, &chunk[ci].key, &chunk[ci].val)
                    chunk[ci].val = v
                }
                if !f(&chunk[ci]) {
                    if noting { t.noteRead(tree, chunk[ci].key, cursor, rseq) }
                    return Ok(Unit{})
                }
                ci += 1
            }
        }
        // the read: from the leaf's lower fence, or the start asked, to the
        // cursor ("": the end)
        if noting { t.noteRead(tree, if last { from } else { lower }, cursor, rseq) }
        if last { more = false } else { cursor = lower }
    }
    return Ok(Unit{})
}

// A new tree, created when the transaction commits.
pub fn (st: &Store) createTree(t: mut &Txn): int {
    var id = 0
    st.sh.with(fn(db: mut &Db) {
        id = db.nextTree
        db.nextTree += 1
    })
    append(mut &t.writes, TxWrite{op: OP_CREATE, tree: id, key: "", val: "", head: 0})
    append(mut &t.created, id)
    return id
}

// Whether nothing the transaction read was written by a commit after the
// read: per key range, against the recent commits' writes.
fn (db: &Db) validate(t: &Txn): bool {
    for m in t.reads {
        if m.seq < db.wlogFloor { return false }
        // the first write after the read (wlog is in commit order)
        var lo = 0
        var hi = len(db.wlog)
        while lo < hi {
            let mid = (lo + hi) / 2
            if db.wlog[mid].seq <= m.seq { lo = mid + 1 } else { hi = mid }
        }
        var i = lo
        while i < len(db.wlog) {
            let e = &db.wlog[i]
            if e.tree == m.tree {
                if e.all { return false }
                let top = if len(e.hi) > 0 { &e.hi } else { &e.key }
                if top >= m.lo && (len(m.hi) == 0 || e.key < m.hi) { return false }
            }
            i += 1
        }
    }
    var last = -1                       // a tree just checked (a large write's rows are of one or a few)
    for w in t.writes {
        if w.op == OP_CREATE || w.tree == last { continue }
        last = w.tree
        if !db.trees.has(&w.tree) {
            var mine = false
            for c in t.created { if c == w.tree { mine = true } }
            if !mine { return false }
        }
    }
    return true
}

// Keeps a commit's writes for the checks of transactions still running.
fn (db: mut &Db) logWrites(t: &Txn) {
    // per tree: its writes' count and range
    var trees: []int = []
    var counts: []int = []
    var los: []str = []
    var his: []str = []
    for w in t.writes {
        if w.op != OP_PUT && w.op != OP_DEL { continue }
        var k = 0
        while k < len(trees) && trees[k] != w.tree { k += 1 }
        if k == len(trees) {
            append(mut &trees, w.tree)
            append(mut &counts, 0)
            append(mut &los, w.key)
            append(mut &his, w.key)
        }
        counts[k] += 1
        if w.key < los[k] { los[k] = w.key }
        if w.key > his[k] { his[k] = w.key }
    }
    for k in 0..len(trees) {
        if counts[k] > WLOG_RANGE { append(mut &db.wlog, WEntry{seq: db.seq, tree: trees[k], key: los[k], hi: his[k], all: false}) }
    }
    for w in t.writes {
        if w.op == OP_PUT || w.op == OP_DEL {
            var k = 0
            while trees[k] != w.tree { k += 1 }
            if counts[k] <= WLOG_RANGE { append(mut &db.wlog, WEntry{seq: db.seq, tree: w.tree, key: w.key, hi: "", all: false}) }
        }
        else if w.op == OP_DROP { append(mut &db.wlog, WEntry{seq: db.seq, tree: w.tree, key: "", hi: "", all: true}) }
    }
    if len(db.wlog) > WLOG_MAX {
        let half = len(db.wlog) / 2
        db.wlogFloor = db.wlog[half - 1].seq
        var keep: []WEntry = []
        for k in half..len(db.wlog) { append(mut &keep, db.wlog[k]) }
        db.wlog = keep
    }
}

// Whether t reads the live tree (outside a snapshot, or a block's UPDATE,
// DELETE and INSERT: Txn.live) and something it read has changed since,
// so that its commit would fail (40001): the SQL layer's look at an error
// that a state read in two moments may have caused (lexdb.md 9.120).
pub fn (st: &Store) liveStale(t: &Txn): bool {
    if st.fo.isSome() || (t.snap >= 0 && !t.live) { return false }
    var stale = false
    st.sh.with(fn(db: mut &Db) { stale = !db.validate(t) })
    return stale
}

// Commits: checks that nothing the transaction read has changed, applies its
// writes and waits until the log holds them. A transaction that only read
// is checked too, and waits until what it saw is durable (4.4).
pub fn (st: &Store) commit(t0: Txn): Result[Unit, lexdb_base.DbErr] {
    if st.fo.isSome() { return st.repEnd(&t0) }
    var t = t0
    let id = t.snap
    let lid = t.lockId
    let held = replace(mut &t.held, [])
    if id >= 0 && len(t.writes) == 0 {
        st.endSnap(id)
        st.unlockAll(lid, &held)
        return Ok(Unit{})
    }
    let r = st.commitLive(t, true)
    st.endSnap(id)
    st.unlockAll(lid, &held)            // after the commit: those woken read what it wrote
    return r
}

// A commit that does not wait for the log to reach the disk: applied, and in
// the log ahead of every commit after it, so durable once any later commit
// is (a sequence's block, 9.43: no transaction using its values can be
// durable before it). A crash before then loses it.
pub fn (st: &Store) commitAhead(t0: Txn): Result[Unit, lexdb_base.DbErr] {
    if st.fo.isSome() { return st.repEnd(&t0) }
    var t = t0
    let id = t.snap
    let lid = t.lockId
    let held = replace(mut &t.held, [])
    let r = st.commitLive(t, false)
    st.endSnap(id)
    st.unlockAll(lid, &held)
    return r
}

// The order a commit checks and applies its writes in (9.110): each run of
// puts and deletes tree by tree, and each tree's writes by key, stably (a
// key's writes keep their order, so the last still wins); creates and drops
// stay where they are. Each descent then starts where the one before ended
// (descend's finger), and the writes to one leaf come together. The final
// state is the same in any order (each key's last write; the trees' shapes
// may differ). The log keeps the writes as made. A tree's writes already
// in key order (a load's, an index built: most large commits) are not
// sorted again, and a commit of fewer than ORDER_MIN writes keeps its
// order: sorting would cost more than it saves.
const ORDER_MIN = 32

fn identityOf(n: int): []int {
    var out: []int = withCapacity(n)
    for i in 0..n { append(mut &out, i) }
    return out
}

fn commitOrder(ws: &[]TxWrite): []int {
    var ix: []int = withCapacity(len(ws))
    for i in 0..len(ws) { append(mut &ix, i) }
    if len(ws) < ORDER_MIN { return ix }
    var a = 0
    while a < len(ws) {
        if ws[a].op != OP_PUT && ws[a].op != OP_DEL {
            a += 1
            continue
        }
        var b = a
        while b < len(ws) && (ws[b].op == OP_PUT || ws[b].op == OP_DEL) { b += 1 }
        // already in order, tree by tree and key by key: left as it is
        var inOrder = true
        var u = a + 1
        while inOrder && u < b {
            let x = &ws[u]
            let y = &ws[u - 1]
            if x.tree < y.tree || (x.tree == y.tree && x.key < y.key) { inOrder = false }
            u += 1
        }
        if inOrder {
            a = b
            continue
        }
        // the run's trees, and each one's writes as made
        var slot: Map[int, int] = newMap()
        var trees: []int = []
        var each: [][]int = []
        for q in a..b {
            let t = ws[q].tree
            var k = match slot.get(&t) { Some(x) { x } None { -1 } }
            if k < 0 {
                k = len(trees)
                slot.put(t, k)
                append(mut &trees, t)
                append(mut &each, [])
            }
            append(mut &each[k], q)
        }
        var byTree = identityOf(len(trees))
        collections.sortBy(mut &byTree, fn(x, y) { return trees[x].cmp(&trees[y]) })
        var at = a
        for k in byTree {
            var mine = replace(mut &each[k], [])
            var sorted = true
            for q in 1..len(mine) { if sorted && ws[mine[q]].key < ws[mine[q - 1]].key { sorted = false } }
            if !sorted {
                collections.sortBy(mut &mine, fn(x, y) {
                    return if ws[x].key < ws[y].key { -1 } else if ws[y].key < ws[x].key { 1 } else { 0 }
                })
            }
            for q in mine {
                ix[at] = q
                at += 1
            }
        }
        a = b
    }
    return ix
}

fn (st: &Store) commitLive(t: Txn, durable: bool): Result[Unit, lexdb_base.DbErr] {
    var wait: []task.Future[Result[Unit, lexdb_base.DbErr]] = []
    var wake: []task.Promise[Unit] = []
    let order = commitOrder(&t.writes)
    while true {
        var needs: []int = []
        var bad: []lexdb_base.DbErr = []
        var held: []task.Future[Unit] = []
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            // Written nodes leave the cache only once a checkpoint has
            // written them: while a checkpoint runs and the cache is over
            // twice its budget, a commit that writes waits for it to end
            // (writes faster than checkpoints would otherwise grow memory
            // without bound). Over the budget with none running: one starts.
            if len(t.writes) > 0 && db.cacheUsed > 2 * db.opts.cacheBytes {
                if db.ckptRunning {
                    let task.Handoff{promise: p, future: f} = task.promise[Unit]()
                    append(mut &db.ckptDone, p)
                    append(mut &held, f)
                    db.held += 1
                    return
                }
                if db.logSinceCkpt > 0 {
                    while len(db.ckptWake) > 0 { append(mut &wake, pop(mut &db.ckptWake)) }
                }
            }
            // Every write's nodes in memory: a pass over the writes gathers
            // the slots missing, which are read together (loadMany), and
            // the commit applies after a pass that finds none; a pass per
            // level of the trees the writes miss. Loading one slot and
            // starting the pass again, as before, made a commit quadratic
            // in its writes when they missed the cache (design/lexdb.md
            // 9.109). Each pass's descents mark the nodes they pass, so
            // loadMany's sweep keeps them.
            var seen: Map[int, int] = newMap()
            for i in order {
                let n = db.writeNeeds(&t.writes[i])
                if n >= 0 && !seen.has(&n) {
                    seen.put(n, 1)
                    append(mut &needs, n)
                }
            }
            if len(needs) > 0 { return }
            if !db.validate(&t) {
                db.conflicts += 1
                append(mut &bad, lexdb_base.conflict())
                return
            }
            var b = db.appliedBatch
            if len(t.writes) > 0 {
                // A frame's length is 32 bits: a commit that would not fit
                // one fails, before anything is written (9.127); one that
                // would not fit the batch waits for the writer to take it.
                let recs = recordsLen(&t.writes)
                if recs > db.frameMax {
                    append(mut &bad, lexdb_base.err(lexdb_base.S_LIMIT, "transaction too large: its log records take " + recs.toStr() + " bytes, at most " + db.frameMax.toStr()))
                    return
                }
                if len(db.batch) > FRAME_HDR && len(db.batch) - FRAME_HDR + recs > db.frameMax {
                    let task.Handoff{promise: p, future: f} = task.promise[Unit]()
                    append(mut &db.ckptDone, p)
                    append(mut &held, f)
                    return
                }
                db.seq += 1
                db.logWrites(&t)
                db.reserveBatch(&t)
                for i in order { db.applyWrite(&t.writes[i]) }
                for w in t.writes {
                    addRecord(mut &db.batch, &w)
                    db.batchCount += 1
                }
                b = db.batchNo
                db.appliedBatch = b
                db.commits += 1
                while len(db.writerWake) > 0 { append(mut &wake, pop(mut &db.writerWake)) }
                db.overBudget()
            }
            if durable && b > db.durableBatch {
                let task.Handoff{promise: p, future: f} = task.promise[Result[Unit, lexdb_base.DbErr]]()
                append(mut &db.waiters, Waiter{batch: b, p: p})
                append(mut &wait, f)
            }
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if len(held) > 0 {
            match pop(mut &held).wait() {
                Ok(_) {}
                Err(_) { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "commit: the checkpointer has gone")) }
            }
            continue
        }
        if len(needs) > 0 {
            try st.loadMany(&needs)
            continue
        }
        break
    }
    while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
    if len(wait) > 0 {
        match pop(mut &wait).wait() {
            Ok(r) { return r }
            Err(_) { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "commit: the log writer has gone")) }
        }
    }
    return Ok(Unit{})
}

// ---- snapshots (4.5): read-only transactions that see the store as it was
// when they began, never abort and never hold up a writer.

// Cancels the oldest snapshots while the old versions kept for them are over
// the budget ("snapshot too old").
fn (db: mut &Db) overBudget() {
    while db.histCount > db.opts.snapNodes {
        var oldest = -1
        for i in 0..len(db.snaps) {
            if !db.snaps[i].cancelled && (oldest < 0 || db.snaps[i].seq < db.snaps[oldest].seq) { oldest = i }
        }
        if oldest < 0 { return }
        db.snaps[oldest].cancelled = true
        db.tooOld += 1
        db.prune()
    }
}

// A read-only transaction on a snapshot, as of the last durable commit:
// nothing it shows can be lost in a crash, and it waits for nothing.
pub fn (st: &Store) beginSnapshot(): Result[Txn, lexdb_base.DbErr] { return st.snapshotTxn(false) }

// A transaction block: it reads a snapshot (as beginSnapshot), with its own
// writes over it, so its reads never wait; its reads are noted, and a
// commit with writes checks that none changed since (9.16).
pub fn (st: &Store) beginBlock(): Result[Txn, lexdb_base.DbErr] { return st.snapshotTxn(true) }

fn (st: &Store) snapshotTxn(track: bool): Result[Txn, lexdb_base.DbErr] {
    var t = begin()
    t.track = track
    match st.fo {
        Some(fo) {
            let s = try repSnap(&fo, mut &t)       // as of now, as on the master
            return Ok(t)
        }
        None {}
    }
    var bad: []lexdb_base.DbErr = []
    st.sh.with(fn(db: mut &Db) {
        if len(db.failed) > 0 {
            append(mut &bad, db.failed[0])
            return
        }
        t.snap = db.nextSnap
        db.nextSnap += 1
        // as of the last commit the log holds: what it shows is durable, and
        // it waits for nothing (9.16)
        let q = db.durableSeq
        t.snapSeq = q
        append(mut &db.snaps, Snap{id: t.snap, seq: q, cancelled: false})
        db.snapshots += 1
        for i in 0..db.trees.size() {
            let id: int = db.trees.keyAt(i)
            let r: int = db.trees.valAt(i)
            t.snapTrees.put(id, r)
        }
        var k = len(db.rootHist) - 1
        while k >= 0 {
            let rc = db.rootHist[k]
            if rc.seq > q {
                if rc.prev >= 0 { t.snapTrees.put(rc.tree, rc.prev) } else { let gone = t.snapTrees.remove(&rc.tree) }
            }
            k -= 1
        }
    })
    if len(bad) > 0 { return Err(bad[0]) }
    return Ok(t)
}

// The commit a snapshot shows: the last durable one when it began.
pub fn (t: &Txn) snapshotSeq(): int { return t.snapSeq }

// A snapshot let go while its transaction waits (WAITFOR,
// design/lexdb-events.md): it pins no old versions and cannot be
// cancelled (72000) meanwhile. Its transaction has read and written
// nothing; renewSnapshot takes a new one before it reads again.
pub fn (st: &Store) releaseSnapshot(t: mut &Txn) {
    st.endSnap(t.snap)
    t.snap = -1
}

// A block's snapshot taken again, as of now, and its now() with it: for a
// WAITFOR that is its block's first statement, which has written nothing,
// so that the block begins when the wait ends. Its reads go: they were of
// the snapshot before (an earlier run of the WAITFOR, or BEGIN's). Not on a replica
// (WAITFOR is refused there).
pub fn (st: &Store) renewSnapshot(t: mut &Txn): Result[Unit, lexdb_base.DbErr] {
    var fresh = try st.snapshotTxn(t.track)
    st.endSnap(t.snap)
    t.snap = fresh.snap
    t.snapSeq = fresh.snapSeq
    t.snapTrees = replace(mut &fresh.snapTrees, newMap())
    t.now = fresh.now
    t.reads = []                    // (an earlier run's, gone with its snapshot)
    return Ok(Unit{})
}

// Ends a snapshot (its commit or rollback); its old versions go.
pub fn (st: &Store) endSnapshot(t: &Txn) {
    match st.fo {
        Some(fo) { for p in t.fsnap { fo.end(&p.s) } }       // (ending twice is harmless: the drop does again)
        None { st.endSnap(t.snap) }
    }
}

fn (st: &Store) endSnap(id: int) {
    if id < 0 { return }
    st.sh.with(fn(db: mut &Db) {
        var keep: []Snap = []
        for sn in db.snaps { if sn.id != id { append(mut &keep, sn) } }
        db.snaps = keep
        db.prune()
    })
}

// Ends a transaction without committing it.
pub fn (st: &Store) abort(t: Txn) {
    st.unlockAll(t.lockId, &t.held)
    st.endSnapshot(&t)
}

// ---- row locks (9.86)
//
// SELECT ... FOR UPDATE and the like, and a block's UPDATE and DELETE, lock
// the rows they return or change until the transaction ends. A lock is kept
// here, not in the row: a table of "tree:key" to holders, as many as their
// modes allow (PostgreSQL's four, and its table of which conflict). A
// transaction a lock keeps out waits for the holders to end, woken then to
// try again; one whose wait would close a cycle fails (40P01).

type LockWait = record { key: str; id: int; p: task.Promise[Unit] }

// Whether lock modes a and b (LOCK_*: 1 key share, 2 share, 3 no key
// update, 4 update) keep each other out.
fn lockConflict(a: int, b: int): bool {
    let hi = if a > b { a } else { b }
    let lo = if a > b { b } else { a }
    if hi == 4 { return true }
    if hi == 3 { return lo >= 2 }
    return false
}

// A row's holders: ids and their modes.
fn holdersOf(s: &str, ids: mut &[]int, modes: mut &[]int) {
    if len(s) == 0 { return }
    for h in strings.split(s, ";") {
        let sp = strings.indexOf(&h, " ", 0)
        append(ids, strings.parseIntOpt(&(h[0..sp].toStr())).unwrapOr(0))
        append(modes, strings.parseIntOpt(&(h[sp + 1..len(h)].toStr())).unwrapOr(0))
    }
}

fn holdersText(ids: &[]int, modes: &[]int): str {
    var parts: []str = []
    for i in 0..len(ids) { append(mut &parts, ids[i].toStr() + " " + modes[i].toStr()) }
    return strings.join(&parts, ";")
}

// Whether transaction me waiting for the holders hs would wait for itself:
// a holder that is me, or waits (in turn) for a row me holds.
fn (db: &Db) cycle(me: int, hs: &[]int): bool {
    var todo: []int = []
    for h in hs { append(mut &todo, h) }
    var seen: []int = []
    while len(todo) > 0 {
        let h = pop(mut &todo)
        if h == me { return true }
        var was = false
        for x in seen { if x == h { was = true } }
        if was { continue }
        append(mut &seen, h)
        match db.waitFor.get(&h) {
            Some(k) {
                var ids: []int = []
                var modes: []int = []
                holdersOf(&db.locks.get(&k).unwrapOr(""), mut &ids, mut &modes)
                for i in ids { append(mut &todo, i) }
            }
            None {}
        }
    }
    return false
}

// What lockRow did.
pub const LOCKED = 0
pub const LOCKED_AFTER_WAIT = 1     // the row may have changed meanwhile
pub const LOCK_SKIPPED = 2          // SKIP LOCKED: another holds it

// Locks key of tree in mode (LOCK_*) for t, waiting while others hold it
// in a mode that conflicts (wait 0), or failing (1: 55P03), or skipping
// (2). keep false: only waits for others, takes no lock (an UPDATE outside
// a block: its own commit ends it at once).
pub fn (st: &Store) lockRow(t: mut &Txn, tree: int, key: &str, mode: int, wait: int, keep: bool): Result[int, lexdb_base.DbErr] {
    if t.lockId == 0 {
        var id = 0
        st.sh.with(fn(db: mut &Db) {
            db.nextLock += 1
            id = db.nextLock
        })
        t.lockId = id
    }
    let lk = tree.toStr() + ":" + key
    var added = false
    let r = try st.lockAs(t.lockId, &lk, mode, wait, keep, mut &added)
    if added { append(mut &t.held, lk) }
    return Ok(r)
}

// lockRow for lock owner me (a transaction's lockId, or a session's own
// for advisory locks: negative) and lock key lk. added: me did not hold it.
pub fn (st: &Store) lockAs(me: int, lk: &str, mode: int, wait: int, keep: bool, added: mut &bool): Result[int, lexdb_base.DbErr] {
    var waited = false
    while true {
        var out = -1
        var bad: []lexdb_base.DbErr = []
        var fut: []task.Future[Unit] = []
        st.sh.with(fn(db: mut &Db) {
            let gone = db.waitFor.remove(&me)
            var ids: []int = []
            var modes: []int = []
            holdersOf(&db.locks.get(&lk).unwrapOr(""), mut &ids, mut &modes)
            var others: []int = []
            var mine = -1
            for i in 0..len(ids) {
                if ids[i] == me { mine = i } else if lockConflict(mode, modes[i]) { append(mut &others, ids[i]) }
            }
            if len(others) == 0 {
                if keep {
                    if mine < 0 {
                        append(mut &ids, me)
                        append(mut &modes, mode)
                        added = true
                    } else if modes[mine] < mode {
                        modes[mine] = mode
                    }
                    db.locks.put(lk.toStr(), holdersText(&ids, &modes))
                }
                out = if waited { LOCKED_AFTER_WAIT } else { LOCKED }
                return
            }
            if wait == 1 {
                append(mut &bad, lexdb_base.err("55P03", "could not obtain lock on row"))
                return
            }
            if wait == 2 {
                out = LOCK_SKIPPED
                return
            }
            if db.cycle(me, &others) {
                append(mut &bad, lexdb_base.err("40P01", "deadlock detected"))
                return
            }
            let task.Handoff{promise: p, future: f} = task.promise[Unit]()
            append(mut &db.lockWaits, LockWait{key: lk.toStr(), id: me, p: p})
            db.waitFor.put(me, lk.toStr())
            append(mut &fut, f)
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if out >= 0 { return Ok(out) }
        match pop(mut &fut).wait() {
            Ok(_) {}
            Err(_) { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "lock: the waker has gone")) }
        }
        waited = true
    }
    return Ok(LOCKED)
}

// Releases the row locks of lock owner id (held, its rows), waking those
// waiting for them.
pub fn (st: &Store) unlockAll(id: int, held: &[]str) {
    if id == 0 { return }
    var wake: []task.Promise[Unit] = []
    st.sh.with(fn(db: mut &Db) {
        let w = db.waitFor.remove(&id)
        for lk in held {
            var ids: []int = []
            var modes: []int = []
            holdersOf(&db.locks.get(&lk).unwrapOr(""), mut &ids, mut &modes)
            var ki: []int = []
            var km: []int = []
            for i in 0..len(ids) {
                if ids[i] != id {
                    append(mut &ki, ids[i])
                    append(mut &km, modes[i])
                }
            }
            if len(ki) == 0 { let r = db.locks.remove(&lk) } else { db.locks.put(lk.toStr(), holdersText(&ki, &km)) }
        }
        if len(held) == 0 { return }
        var keep: []LockWait = []
        while len(db.lockWaits) > 0 {
            let lw = pop(mut &db.lockWaits)
            var mine = false
            for lk in held { if lk == lw.key { mine = true } }
            if mine {
                let LockWait{key: _, id: _, p: p} = move(lw)
                append(mut &wake, p)
            } else { append(mut &keep, lw) }
        }
        db.lockWaits = keep
    })
    while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
}

// The rows locked now (for tests and EXPLAIN-like checks): count.
pub fn (st: &Store) lockCount(): int {
    var n = 0
    st.sh.with(fn(db: mut &Db) { n = db.locks.size() })
    return n
}

// The version of slot s a snapshot at seq q sees: -1 the current one (in
// memory), -2 the current one (to load), -3 none (a bug), else the index of
// an old version.
fn (db: &Db) verOf(s: int, q: int): int {
    if !db.meta[s].used { return -3 }
    if db.meta[s].since <= q { return if db.meta[s].loaded { -1 } else { -2 } }
    for i in 0..len(db.hist[s]) {
        if db.hist[s][i].since <= q && q < db.hist[s][i].until { return i }
    }
    return -3
}

fn (db: &Db) snapNode(s: int, v: int): &lexdb_page.Node {
    if v >= 0 { return &db.hist[s][v].node }
    return &db.pool[db.meta[s].frame]
}

fn snapCancelled(): lexdb_base.DbErr {
    return lexdb_base.err("72000", "snapshot too old: the old versions it needed went over the budget")
}

// A snapshot's descent to the leaf holding cursor (back: the leaf with the
// largest keys below it, "" the last): the leaf's slot and version (verOf),
// a slot to load first, or a version missing; and the fence on its path
// (forward: the separator above it; back: the one below it).
// par, pver, at: where need was reached (the parent's slot and version,
// the child's index), for read-ahead; par -1 at the root.
type SnapLeaf = value record { leaf: int; ver: int; need: int; missing: bool; fence: str; hasFence: bool; par: int; pver: int; at: int }

fn (db: mut &Db) snapDescend(root: int, q: int, cursor: &str, back: bool): SnapLeaf {
    var r = SnapLeaf{leaf: -1, ver: -1, need: -1, missing: false, fence: "", hasFence: false, par: -1, pver: -1, at: -1}
    var s = root
    while true {
        let v = db.verOf(s, q)
        if v == -2 {
            r.need = s
            return r
        }
        if v == -3 {
            r.missing = true
            return r
        }
        db.meta[s].ref = true
        let n = db.snapNode(s, v)
        if n.leaf {
            r.leaf = s
            r.ver = v
            return r
        }
        if back {
            let j = if len(cursor) == 0 { n.count() } else { n.lower(cursor) }
            if j > 0 {
                r.fence = n.key(j - 1)
                r.hasFence = true
            }
            r.par = s
            r.pver = v
            r.at = j
            s = n.kids[j]
        } else {
            let i = childIndex(&n.keys, cursor)
            if i < n.count() {
                r.fence = n.key(i)
                r.hasFence = true
            }
            r.par = s
            r.pver = v
            r.at = i
            s = n.kids[i]
        }
    }
    return r
}

fn (db: &Db) snapGone(id: int): bool {
    for sn in db.snaps { if sn.id == id && sn.cancelled { return true } }
    return false
}

// ---- the log writer: one task, one flush at a time; commits made while a
// flush runs go in the next batch (group commit, 4.6).

fn (st: &Store) openSeg(g: int, size: int): Result[lexdb_disk.File, lexdb_base.DbErr] {
    var fs = lexdb_disk.Fs.Real("")
    st.sh.with(fn(db: mut &Db) { fs = db.logFs })
    let name = segName(g)
    if !fs.exists(name) && fs.exists(SPARE) { try fs.rename(SPARE, name) }
    let f = try fs.open(name, true)
    let have = try f.size()
    if have < size {
        // Written with zeros once, not just allocated: a flush after a write
        // into an allocated but unwritten extent costs about twice as much
        // on ext4, which must journal the extent's change (design/lexdb.md 3).
        try f.grow(size)
        if !fs.isReal() { return Ok(f) }      // no extents to convert in the simulation
        let chunk = array(1024 * 1024, byte(0))
        var at = have / PAGE * PAGE
        while at < size {
            let n = if size - at < len(chunk) { size - at } else { len(chunk) }
            try f.write(at, &chunk[0..n])
            at += n
        }
        try f.flush()
    }
    return Ok(f)
}

fn (st: &Store) fail(e: lexdb_base.DbErr) {
    var ws: []Waiter = []
    var held: []task.Promise[Unit] = []
    st.sh.with(fn(db: mut &Db) {
        if len(db.failed) == 0 { append(mut &db.failed, e) }
        while len(db.waiters) > 0 { append(mut &ws, pop(mut &db.waiters)) }
        while len(db.ckptDone) > 0 { append(mut &held, pop(mut &db.ckptDone)) }
        while len(db.durWaits) > 0 {
            let DurWait{id: _, p: p} = pop(mut &db.durWaits)
            append(mut &held, p)
        }
    })
    while len(held) > 0 { pop(mut &held).complete(Unit{}) }
    while len(ws) > 0 {
        let Waiter{batch: _, p: p} = pop(mut &ws)
        p.complete(Err(e))
    }
}

// The writer's loop; runs until the store closes or fails.
pub fn writer(st: Store): int {
    var segNo = 0
    var segOff = 0
    var segBytes = 0
    st.sh.with(fn(db: mut &Db) {
        segNo = db.seg
        segOff = db.segOff
        segBytes = db.opts.segBytes
    })
    var segF = lexdb_disk.File.Real(-1, false)
    match st.openSeg(segNo, segBytes) {
        Ok(f) { segF = f }
        Err(e) {
            st.fail(e)
            return 1
        }
    }
    while true {
        var job: []byte = []
        var count = 0
        var no = 0
        var upto = 0
        var stop = false
        var idle: []task.Future[Unit] = []
        var room: []task.Promise[Unit] = []
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 || (db.closing && db.batchCount == 0) {
                stop = true
                return
            }
            if db.batchCount > 0 {
                job = replace(mut &db.batch, [])
                upto = db.seq                   // every commit applied so far is in this batch or before
                count = db.batchCount
                no = db.batchNo
                db.batchNo += 1
                db.batchCount = 0
                while len(db.ckptDone) > 0 { append(mut &room, pop(mut &db.ckptDone)) }     // (commits waiting for room in a batch, 9.127)
            } else {
                let task.Handoff{promise: p, future: f} = task.promise[Unit]()
                append(mut &db.writerWake, p)
                append(mut &idle, f)
            }
        })
        while len(room) > 0 { pop(mut &room).complete(Unit{}) }
        if stop { break }
        if len(idle) > 0 {
            match pop(mut &idle).wait() {
                Ok(_) {}
                Err(_) { break }
            }
            continue
        }
        let plen = len(job) - FRAME_HDR
        frame(mut &job, count, no, segNo)
        var fr = move(job)
        if segOff > 0 && segOff + len(fr) > segBytes {
            segF.close()
            segNo += 1
            segOff = 0
            binary.setU32LE(mut &fr, 16, segNo)
            let c = lexdb_base.crc32c(&fr, 8, FRAME_HDR + plen)
            binary.setU32LE(mut &fr, 4, int(c))
            match st.openSeg(segNo, if len(fr) > segBytes { len(fr) } else { segBytes }) {
                Ok(f) { segF = f }
                Err(e) {
                    st.fail(e)
                    return 1
                }
            }
        }
        match segF.write(segOff, &fr) {
            Ok(_) {}
            Err(e) {
                st.fail(e)
                return 1
            }
        }
        match segF.flush() {
            Ok(_) {}
            Err(e) {
                st.fail(e)        // never retried: the store stops (fsyncgate, 4.1)
                return 1
            }
        }
        segOff += len(fr)
        var done: []Waiter = []
        var ck: []task.Promise[Unit] = []
        st.sh.with(fn(db: mut &Db) {
            db.durableBatch = no
            while len(db.changeWake) > 0 { append(mut &ck, pop(mut &db.changeWake)) }
            while len(db.durWaits) > 0 {
                let DurWait{id: _, p: p} = pop(mut &db.durWaits)
                append(mut &ck, p)
            }
            if upto > db.durableSeq {
                db.durableSeq = upto
                db.prune()
            }
            db.seg = segNo
            db.segOff = segOff
            db.flushes += 1
            db.logBytes += len(fr)
            db.logSinceCkpt += len(fr)
            var keep: []Waiter = []
            while len(db.waiters) > 0 {
                let w = pop(mut &db.waiters)
                if w.batch <= no { append(mut &done, w) } else { append(mut &keep, w) }
            }
            db.waiters = keep
            // a checkpoint after ckptBytes of log, or sooner when the cache
            // is over its budget: written nodes are clean, so they can go
            let full = db.cacheUsed > db.opts.cacheBytes && db.logSinceCkpt >= db.opts.ckptBytes / 8
            if (db.logSinceCkpt >= db.opts.ckptBytes || full) && !db.ckptRunning {
                while len(db.ckptWake) > 0 { append(mut &ck, pop(mut &db.ckptWake)) }
            }
        })
        while len(done) > 0 {
            let Waiter{batch: _, p: p} = pop(mut &done)
            p.complete(Ok(Unit{}))
        }
        while len(ck) > 0 { pop(mut &ck).complete(Unit{}) }
    }
    segF.close()
    return 0
}

// ---- checkpoints (4.5)

// The lowest free page, or a new one at the file's end.
fn (db: mut &Db) allocPage(): int {
    let n = len(db.free)
    if n > 0 {
        let p = db.free[n - 2]
        if db.free[n - 1] == 1 {
            let c = pop(mut &db.free)
            let f = pop(mut &db.free)
        } else {
            db.free[n - 2] = p + 1
            db.free[n - 1] -= 1
        }
        return p
    }
    let p = db.npages
    db.npages += 1
    return p
}

// ---- free runs (9.33)
//
// Free pages are kept, and written, as runs of consecutive pages:
// (first, count) pairs, highest first, none touching another. A dropped
// table's pages are mostly consecutive, so its many pages are a few runs.

// The runs of a list of pages.
fn runsOf(pages: &[]int): []int {
    var ps: []int = []
    for p in pages { append(mut &ps, p) }
    collections.sortStable(mut &ps)
    var up: []int = []
    for p in ps {
        let n = len(up)
        if n > 0 && up[n - 2] + up[n - 1] > p { panic("lexdb: page " + p.toStr() + " freed twice") }
        if n > 0 && up[n - 2] + up[n - 1] == p { up[n - 1] += 1 }
        else {
            append(mut &up, p)
            append(mut &up, 1)
        }
    }
    var out: []int = []
    var i = len(up) - 2
    while i >= 0 {
        append(mut &out, up[i])
        append(mut &out, up[i + 1])
        i -= 2
    }
    return out
}

// Two lists of runs as one, runs that touch joined.
fn mergeRuns(a: &[]int, b: &[]int): []int {
    var out: []int = []
    var i = 0
    var j = 0
    while i < len(a) || j < len(b) {
        var f = 0
        var c = 0
        if j >= len(b) || (i < len(a) && a[i] > b[j]) {
            f = a[i]
            c = a[i + 1]
            i += 2
        } else {
            f = b[j]
            c = b[j + 1]
            j += 2
        }
        let n = len(out)
        if n > 0 && f + c > out[n - 2] { panic("lexdb: page " + out[n - 2].toStr() + " freed twice") }
        if n > 0 && f + c == out[n - 2] {
            out[n - 2] = f
            out[n - 1] += c
        } else {
            append(mut &out, f)
            append(mut &out, c)
        }
    }
    return out
}

fn runPages(runs: &[]int): int {
    var n = 0
    var i = 1
    while i < len(runs) {
        n += runs[i]
        i += 2
    }
    return n
}

// The most pages of dropped subtrees one checkpoint reads (9.32).
const DROP_READS = 256

// The height of the subtree on page p (0: a leaf), read down its first
// children.
fn heightAt(f: &lexdb_disk.File, p: int, b: mut &[]byte, reads: mut &int): Result[int, lexdb_base.DbErr] {
    var h = 0
    var at = p
    while true {
        try f.read(at * PAGE, mut &b[0..PAGE], PAGE)
        try lexdb_page.check(b, at, lexdb_page.T_LEAF)
        reads += 1
        if lexdb_page.isLeafType(int(b[12])) { return Ok(h) }
        if h > 64 { return Err(lexdb_base.corrupt("page " + p.toStr() + ": its subtree is over 64 deep")) }
        at = lexdb_page.decodeNode(b).kids[0]
        h += 1
    }
    return Ok(h)
}

// Frees pages of the dropped subtrees in todo ((page, height) pairs, -1 a
// height not known), reading up to most of them: a leaf of known
// height is freed unread, an internal page read for its children. The
// pages freed are added to gone; todo keeps what is left.
fn walkDropped(f: &lexdb_disk.File, todo: mut &[]int, gone: mut &[]int, most: int): Result[Unit, lexdb_base.DbErr] {
    var b = array(PAGE, byte(0))
    var reads = 0
    while len(todo) >= 2 && reads < most {
        let h = pop(mut &todo)
        let p = pop(mut &todo)
        if h == 0 {
            append(mut &gone, p)
            continue
        }
        try f.read(p * PAGE, mut &b[0..PAGE], PAGE)
        try lexdb_page.check(&b, p, lexdb_page.T_LEAF)
        reads += 1
        if int(b[12]) == lexdb_page.T_INTERNAL {
            let node = lexdb_page.decodeNode(&b)
            let kids = &node.kids
            var kh = h - 1
            if h < 0 { kh = try heightAt(f, kids[0], mut &b, mut &reads) }
            for k in kids {
                append(mut &todo, k)
                append(mut &todo, kh)
            }
        } else if h > 0 {
            return Err(lexdb_base.corrupt("page " + p.toStr() + ": a leaf where a dropped subtree has height " + h.toStr()))
        }
        append(mut &gone, p)
    }
    return Ok(Unit{})
}

// Writes out the dirty nodes under s (children first) of tree: s's page.
fn (db: mut &Db) encodeSlot(s: int, n: int, out: mut &[]PageOut, tree: int): int {
    if !db.meta[s].dirty { return db.meta[s].disk }
    var pages: []int = []
    if !db.pool[db.meta[s].frame].leaf {
        var kids: []int = []
        for k in db.pool[db.meta[s].frame].kids { append(mut &kids, k) }
        for k in kids { append(mut &pages, db.encodeSlot(k, n, mut &out, tree)) }
    }
    let p = db.allocPage()
    let body = db.leafBody(s, &pages, tree)
    lexdb_page.repack(mut &db.pool[db.meta[s].frame], &body)
    db.recost(s)
    db.meta[s].dirty = false
    db.meta[s].disk = p
    db.meta[s].ckpt = n
    append(mut &out, PageOut{no: p, leaf: db.pool[db.meta[s].frame].leaf, n: db.pool[db.meta[s].frame].count(), body: body, raw: []})
    return p
}

// What a checkpoint writes of node s of tree (nodeBody): a leaf of a tree
// with layouts (setColSpec) as a column leaf when its rows encode
// (lexdb_page.colBody, 9.112), else as rows.
fn (db: mut &Db) leafBody(s: int, pages: &[]int, tree: int): str {
    let f = db.meta[s].frame
    if db.pool[f].leaf && lexdb_cols.on() && !db.colsOff {
        match db.colSpecs.get(&tree) {
            Some(i) {
                let c0 = lexdb_cols.converted()
                match lexdb_page.colBody(&db.pool[f], &db.specs[i]) {
                    Some(b) {
                        // its rows rewritten (9.114): a snapshot keeps them as they were
                        if lexdb_cols.converted() != c0 { db.willChange(s) }
                        db.colLeaves += 1
                        // a full leaf's ratio (leafRoom)
                        let size = db.pool[f].size
                        if size > lexdb_page.NODE_ROOM && !db.pool[f].isCols() { db.noteRatio(i, lexdb_page.colPageBytes(&b, db.pool[f].count()), size) }
                        return b
                    }
                    None { db.rowLeaves += 1 }
                }
            }
            None {}
        }
    }
    return lexdb_page.nodeBody(&db.pool[f], pages)
}

// Gives tree (a table's) its layouts, layout i's kind per place
// (lexdb_exec Table.layouts): its leaves are written as column leaves
// from then on when their rows are all in one of them (9.112). What a
// column leaf holds does not depend on this being right: an encoder that
// is given wrong kinds writes rows that do not parse in them as rows, and
// the rows it does take come back byte for byte; a reader that reads
// columns first checks the leaf's kinds against its table's.
//
// Since 9.114 the last layout is the one rows are converted to, so the
// layouts must be committed ones: the executor gives none its own
// transaction has written. A table's layouts are only ever added to, so
// layouts that begin the ones already given (a snapshot's older catalog)
// are not taken. fill, fillOk: lexdb_cols.Spec's.
pub fn (st: &Store) setColSpec(tree: int, layouts: &[][]byte, fill: &str, fillOk: bool) {
    if st.fo.isSome() { return }
    st.sh.with(fn(db: mut &Db) {
        match db.colSpecs.get(&tree) {
            Some(i) {
                if lexdb_cols.sameSpec(&db.specs[i], layouts, fill, fillOk) { return }
                let given = lexdb_cols.Spec{layouts: copyLayouts(layouts), fill: fill.toStr(), fillOk: fillOk}
                if len(layouts) < len(db.specs[i].layouts) && lexdb_cols.extends(&given, &db.specs[i].layouts) { return }
                db.specs[i] = given
                // leaves whose rows did not convert may now
                for x in 0..len(db.meta) { if db.meta[x].upg == 2 { db.meta[x].upg = 0 } }
            }
            None {
                db.colSpecs.put(tree, len(db.specs))
                append(mut &db.specs, lexdb_cols.Spec{layouts: copyLayouts(layouts), fill: fill.toStr(), fillOk: fillOk})
                append(mut &db.specRatio, 0)
                append(mut &db.specSplits, 0)
            }
        }
    })
}

fn copyLayouts(ls: &[][]byte): [][]byte {
    var out: [][]byte = []
    for l in ls {
        var x: []byte = []
        for k in l { append(mut &x, k) }
        append(mut &out, x)
    }
    return out
}

// Whether this store's checkpoints write column leaves (with
// lexdb_cols.on(), LEXDB_COLUMNS): off, every leaf is written as rows
// (tests compare the two).
pub fn (st: &Store) setColumns(on: bool) { st.sh.with(fn(db: mut &Db) { db.colsOff = !on }) }

// Leaves checkpoints wrote as column leaves, and as rows (of trees with
// layouts: their rows did not all encode), and cut to fit (refit): 9.112.
pub fn (st: &Store) colCounts(): []int {
    var out: []int = []
    st.sh.with(fn(db: mut &Db) { out = [db.colLeaves, db.rowLeaves, db.refitCuts] })
    return out
}

// ---- clean row leaves made column leaves (9.114)
//
// A checkpoint writes changed leaves only, so a table's leaves written as
// rows (T_LEAF before 9.109, T_FLEAF; or rows of two layouts, or tagged,
// before 9.114) stay so while their rows do not change. Such a leaf is
// converted the way a commit changes one: its version kept for the
// snapshots that may read it (willChange), its rows made a column leaf in
// memory (rewritten in the current layout when they were not in one:
// lexdb_cols.encodeConv), and its path marked changed (copy on write: the
// next checkpoint writes them to new pages and frees the old). Which:
// - those a batch scan reads (scanLeaves, noteLeaf): queued by their first
//   key, at most UPG_QUEUE; each checkpoint converts the first upgBudget
//   (upgradeQueued), loading those no longer in memory;
// - every leaf of a table, by VACUUM (upgradeTree), a step at a time, a
//   checkpoint after each.
// A leaf whose rows do not encode stays rows, and is marked (SlotMeta.upg)
// so it is not queued again until it changes or its tree's layouts do.

const UPG_QUEUE = 4096          // leaves queued at most
const UPG_BUDGET = 256          // leaves a checkpoint converts at most (lexdb.md 9.114: its cost)

// The leaves a checkpoint converts at most (tests set fewer).
pub fn (st: &Store) setUpgradeBudget(n: int) { st.sh.with(fn(db: mut &Db) { db.upgBudget = n }) }

// Leaf s of tree, just read by a scan: queued when it is a clean row leaf
// of a table tree (one with layouts).
fn (db: mut &Db) noteLeaf(tree: int, s: int) {
    if db.meta[s].upg != 0 || db.meta[s].dirty || len(db.upgTree) >= UPG_QUEUE { return }
    let f = db.meta[s].frame
    if f < 0 || !db.pool[f].leaf || db.pool[f].isCols() || db.pool[f].count() == 0 { return }
    if !lexdb_cols.on() || db.colsOff { return }
    if !db.colSpecs.has(&tree) {
        db.meta[s].upg = 2          // (an index's: until a tree's layouts change)
        return
    }
    db.meta[s].upg = 1
    append(mut &db.upgTree, tree)
    append(mut &db.upgKey, db.pool[f].key(0))
}

// The leaf d reached (of tree), made a column leaf when it is a clean row
// leaf of a table: 1 done, 0 its rows did not encode (it stays rows), -1
// nothing to do (changed: the checkpoint encodes it; a column leaf; not a
// table's).
fn (db: mut &Db) upgradeLeaf(tree: int, d: &Descent): int {
    let s = d.path[len(d.path) - 1]
    let f = db.meta[s].frame
    if db.meta[s].dirty || !db.pool[f].leaf || db.pool[f].isCols() || db.pool[f].count() == 0 { return -1 }
    if !lexdb_cols.on() || db.colsOff { return -1 }
    let i = match db.colSpecs.get(&tree) {
        Some(x) { x }
        None { return -1 }
    }
    if db.meta[s].upg == 2 { return 0 }
    match lexdb_page.colBody(&db.pool[f], &db.specs[i]) {
        Some(b) {
            db.willChange(s)
            lexdb_page.repack(mut &db.pool[db.meta[s].frame], &b)
            db.meta[s].version += 1
            db.recost(s)
            for x in d.path { db.markDirty(x) }
            db.upgLeaves += 1
            return 1
        }
        None {
            db.meta[s].upg = 2
            db.upgFailed += 1
            return 0
        }
    }
}

// The leaf of tree holding key, converted (upgradeLeaf), loaded first if
// it is not in memory.
fn (st: &Store) upgradeAt(tree: int, key: &str): Result[Unit, lexdb_base.DbErr] {
    var guard = 0
    while guard < 64 {
        guard += 1
        var need = -1
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 { return }
            let d = db.descend(tree, key)
            if d.need >= 0 {
                need = d.need
                return
            }
            if len(d.path) > 0 { let r = db.upgradeLeaf(tree, &d) }
        })
        if need < 0 { return Ok(Unit{}) }
        try st.load(need)
    }
    return Ok(Unit{})
}

// The first upgBudget leaves queued, converted (by a checkpoint).
fn (st: &Store) upgradeQueued(): Result[Unit, lexdb_base.DbErr] {
    var trees: []int = []
    var keys: []str = []
    st.sh.with(fn(db: mut &Db) {
        let k = min(db.upgBudget, len(db.upgTree))
        if k <= 0 { return }
        var restT: []int = []
        var restK: []str = []
        for i in 0..len(db.upgTree) {
            if i < k {
                append(mut &trees, db.upgTree[i])
                append(mut &keys, replace(mut &db.upgKey[i], ""))
            } else {
                append(mut &restT, db.upgTree[i])
                append(mut &restK, replace(mut &db.upgKey[i], ""))
            }
        }
        db.upgTree = restT
        db.upgKey = restK
    })
    for i in 0..len(trees) { try st.upgradeAt(trees[i], &keys[i]) }
    return Ok(Unit{})
}

// What upgradeTree did: the key to go on from (when not done), the leaves
// converted, and those left as rows (their rows did not encode).
pub type Upgrade = value record { pub next: str; pub done: bool; pub converted: int; pub kept: int }

// Converts tree's leaves (upgradeLeaf) from key from on, until most are
// converted or the tree ends (VACUUM, 9.114). The leaves converted stay in
// memory, changed, until a checkpoint writes them: the caller takes one
// after each step.
pub fn (st: &Store) upgradeTree(tree: int, from: str, most: int): Result[Upgrade, lexdb_base.DbErr] {
    var out = Upgrade{next: "", done: true, converted: 0, kept: 0}
    if st.fo.isSome() { return Ok(out) }           // a replica writes nothing
    out.done = false
    var cursor = from
    var ahead = AHEAD_MIN
    while true {
        var need = -1
        var run: []LoadReq = []
        var bad: []lexdb_base.DbErr = []
        var upper = ""
        var hasUpper = false
        var empty = false
        var r = -1
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            let d = db.descend(tree, &cursor)
            if d.need >= 0 {
                need = d.need
                if len(d.path) > 0 { run = db.runFor(d.path[len(d.path) - 1], &cursor, need, ahead) }
                return
            }
            if len(d.path) == 0 {
                empty = true
                return
            }
            r = db.upgradeLeaf(tree, &d)
            upper = d.upper
            hasUpper = d.hasUpper
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need >= 0 {
            try st.loadAhead(need, &run)
            if len(run) > 1 { ahead = min(ahead * 2, AHEAD_MAX) }
            continue
        }
        if r == 1 { out.converted += 1 }
        if r == 0 { out.kept += 1 }
        if empty || !hasUpper {
            out.done = true
            return Ok(out)
        }
        cursor = upper
        if out.converted >= most {
            out.next = cursor
            return Ok(out)
        }
    }
    return Ok(out)
}

// Tree's leaves: column leaves, and leaves of rows (a test's look; every
// leaf is read).
pub fn (st: &Store) leafKinds(tree: int): Result[[]int, lexdb_base.DbErr] {
    var out: []int = [0, 0]
    if st.fo.isSome() { return Ok(out) }
    var cursor = ""
    while true {
        var need = -1
        var bad: []lexdb_base.DbErr = []
        var upper = ""
        var hasUpper = false
        var empty = false
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            let d = db.descend(tree, &cursor)
            if d.need >= 0 {
                need = d.need
                return
            }
            if len(d.path) == 0 {
                empty = true
                return
            }
            let n = &db.pool[db.meta[d.path[len(d.path) - 1]].frame]
            if n.count() > 0 { if n.isCols() { out[0] += 1 } else { out[1] += 1 } }
            upper = d.upper
            hasUpper = d.hasUpper
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need >= 0 {
            try st.load(need)
            continue
        }
        if empty || !hasUpper { return Ok(out) }
        cursor = upper
    }
    return Ok(out)
}

// Leaves converted while clean (upgradeLeaf), and those left as rows; the
// leaves queued now.
pub fn (st: &Store) upgradeCounts(): []int {
    var out: []int = []
    st.sh.with(fn(db: mut &Db) { out = [db.upgLeaves, db.upgFailed, len(db.upgTree)] })
    return out
}

// A checkpoint of everything applied so far, waiting first for one that
// is running (checkpoint returns at once then): at shutdown, so the next
// start replays nothing.
// ---- the data file's space (9.110)
//
// A checkpoint's new pages go past the file's end, in runs written several
// at once (9.63). Written so, each write allocates its own extent, and on
// btrfs (copy-on-write off, 9.61) the runs of one checkpoint land wherever
// the allocator had room as they came: a 1M-row load left 452 extents of
// 64 pages, and read at two thirds of a copy's speed. Space reserved ahead
// in large steps (fallocate) is laid out in a few large extents, which the
// writes then fill in place.

const RESERVE_MIN = 4 * 1024 * 1024        // the least a reservation adds
const RESERVE_MAX = 256 * 1024 * 1024      // the most beyond what is needed
const RESERVE_ALIGN = 1024 * 1024

// The range [from, to) of the data file to reserve before this
// checkpoint's pages are written, or nothing when its pages fit: the pages
// needed, and an eighth of the file more (at least RESERVE_MIN, at most
// RESERVE_MAX), so the file grows in about log(size) steps and at most an
// eighth of it is reserved and unused.
fn (db: &Db) reserveAhead(): []int {
    let need = db.npages * PAGE
    if !db.reserving || need <= db.fileEnd { return [] }
    let step = min(max(db.fileEnd / 8, RESERVE_MIN), RESERVE_MAX)
    let to = (max(need, db.fileEnd + step) + RESERVE_ALIGN - 1) / RESERVE_ALIGN * RESERVE_ALIGN
    return [db.fileEnd, to]
}

pub fn (st: &Store) checkpointAll(): Result[Unit, lexdb_base.DbErr] {
    if st.fo.isSome() { return Ok(Unit{}) }        // a replica writes nothing
    while true {
        var running = false
        st.sh.with(fn(db: mut &Db) { running = db.ckptRunning && len(db.failed) == 0 })
        if !running { return st.checkpoint() }
        match task.sleep(1) {
            Ok(_) {}
            Err(_) { return st.checkpoint() }
        }
    }
    return Ok(Unit{})
}

// Takes a checkpoint: writes the changed nodes to new pages, then a meta
// page that names them, once the log holds every commit they include.
// Commits go on meanwhile. Does nothing while another checkpoint runs.
pub fn (st: &Store) checkpoint(): Result[Unit, lexdb_base.DbErr] {
    var out: []PageOut = []
    var metaPage: []byte = []
    var f = lexdb_disk.File.Real(-1, false)
    var busy = false
    var bad: []lexdb_base.DbErr = []
    var target = 0
    var n = 0
    var newLists: []int = []
    var oldSegs: []int = []
    var fs = lexdb_disk.Fs.Real("")
    var todo: []int = []
    var most = 0
    var reserve: []int = []
    var ckPages = 0
    st.sh.with(fn(db: mut &Db) {
        if len(db.failed) > 0 {
            append(mut &bad, db.failed[0])
            return
        }
        if db.ckptRunning {
            busy = true
            return
        }
        db.ckptRunning = true
        todo = replace(mut &db.dropped, [])
        most = db.dropReads
        f = db.data
    })
    if len(bad) > 0 { return Err(bad[0]) }
    if busy { return Ok(Unit{}) }
    // Clean row leaves the scans queued, made column leaves (9.114): changed
    // nodes this checkpoint then writes.
    match st.upgradeQueued() {
        Ok(_) {}
        Err(e) {
            st.fail(e)
            return Err(e)
        }
    }
    // Some of the dropped subtrees' pages: freed by this checkpoint, which
    // names the rest.
    var gone: []int = []
    match walkDropped(&f, mut &todo, mut &gone, most) {
        Ok(_) {}
        Err(e) {
            st.fail(e)
            return Err(e)
        }
    }
    st.sh.with(fn(db: mut &Db) {
        if len(db.failed) > 0 {
            append(mut &bad, db.failed[0])
            return
        }
        for x in db.dropped { append(mut &todo, x) }
        db.dropped = replace(mut &todo, [])
        for p in gone { db.freePage(p) }
        db.ckpt += 1
        n = db.ckpt
        f = db.data
        fs = db.logFs
        db.refit()      // (it may split leaves, and roots: before the roots are taken)
        var roots: []int = []
        var ids: []int = []
        var rs: []int = []
        for i in 0..db.trees.size() {
            let id: int = db.trees.keyAt(i)
            let r: int = db.trees.valAt(i)
            append(mut &ids, id)
            append(mut &rs, r)
        }
        for i in 0..len(ids) {
            append(mut &roots, ids[i])
            append(mut &roots, db.encodeSlot(rs[i], n, mut &out, ids[i]))
        }
        var freed = replace(mut &db.freeAfterNext, [])
        for p in db.listPages { append(mut &freed, p) }
        // The list pages come from the free pages; the free list then holds
        // what is left, and what this checkpoint frees.
        var rootPages: []int = []
        for i in 0..lexdb_page.listPages(len(roots)) { append(mut &rootPages, db.allocPage()) }
        var dropVals: []int = []
        var i = 0
        while i + 1 < len(db.dropped) {
            append(mut &dropVals, db.dropped[i])
            append(mut &dropVals, db.dropped[i + 1] + 1)
            i += 2
        }
        var dropPages: []int = []
        for j in 0..lexdb_page.listPages(len(dropVals)) { append(mut &dropPages, db.allocPage()) }
        // As many list pages as the runs if none join (taking the lowest
        // free pages for them joins none and splits none).
        let freedRuns = runsOf(&freed)
        var freePages: []int = []
        var heldRuns = 0
        for h in db.heldFree { heldRuns += len(h.runs) }
        for j in 0..lexdb_page.listPages(len(db.free) + len(freedRuns) + heldRuns) { append(mut &freePages, db.allocPage()) }
        // pages held for a follower are free as far as recovery goes
        var freeVals = mergeRuns(&db.free, &freedRuns)
        for h in db.heldFree { freeVals = mergeRuns(&freeVals, &h.runs) }
        var dl = lexdb_page.encodeList(&dropVals, &dropPages)
        i = len(dl) - 1
        while i >= 0 {
            append(mut &out, PageOut{no: dropPages[i], leaf: false, n: 0, body: "", raw: pop(mut &dl)})
            i -= 1
        }
        var rl = lexdb_page.encodeList(&roots, &rootPages)
        i = len(rl) - 1
        while i >= 0 {
            append(mut &out, PageOut{no: rootPages[i], leaf: false, n: 0, body: "", raw: pop(mut &rl)})
            i -= 1
        }
        var fl = lexdb_page.encodeList(&freeVals, &freePages)
        i = len(fl) - 1
        while i >= 0 {
            append(mut &out, PageOut{no: freePages[i], leaf: false, n: 0, body: "", raw: pop(mut &fl)})
            i -= 1
        }
        for p in rootPages { append(mut &newLists, p) }
        for p in dropPages { append(mut &newLists, p) }
        for p in freePages { append(mut &newLists, p) }
        db.pendingFree = freedRuns
        target = db.appliedBatch
        let m = lexdb_page.Meta{ckpt: n, npages: db.npages,
                                roots: if len(rootPages) > 0 { rootPages[0] } else { 0 },
                                free: 0, runs: if len(freePages) > 0 { freePages[0] } else { 0 },
                                replaySeg: db.seg, replayOff: db.segOff, replayBatch: db.durableBatch + 1,
                                nextTree: db.nextTree, dropped: if len(dropPages) > 0 { dropPages[0] } else { 0 },
                                covers: target}
        metaPage = lexdb_page.encodeMeta(&m, n % 2)
        reserve = db.reserveAhead()
        ckPages = db.npages
        for s in 1..db.seg { if db.holdSeg < 0 || s < db.holdSeg { append(mut &oldSegs, s) } }
    })
    if len(bad) > 0 { return Err(bad[0]) }
    if busy { return Ok(Unit{}) }
    if len(reserve) == 2 {
        let ok = f.reserve(reserve[0], reserve[1] - reserve[0]).isOk()
        st.sh.with(fn(db: mut &Db) {
            if ok { db.fileEnd = max(db.fileEnd, reserve[1]) } else { db.reserving = false }
        })
    }
    let r = st.finishCheckpoint(&f, &out, &metaPage, n, target)
    var done: []task.Promise[Unit] = []
    match r {
        Ok(_) {}
        Err(e) {
            st.fail(e)
            return Err(e)
        }
    }
    st.sh.with(fn(db: mut &Db) {
        db.durableCkpt = n
        db.ckptCovers = target
        while len(db.changeWake) > 0 { append(mut &done, pop(mut &db.changeWake)) }
        let pf = replace(mut &db.pendingFree, [])
        if db.holdCkpt >= 0 && db.holdCkpt < n {
            append(mut &db.heldFree, HeldRuns{ckpt: n, runs: pf})        // base n - 1's: a follower may read them
        } else {
            db.free = mergeRuns(&db.free, &pf)
        }
        db.listPages = replace(mut &newLists, [])
        db.fileEnd = max(db.fileEnd, ckPages * PAGE)
        db.ckptRunning = false
        db.logSinceCkpt = 0
        db.checkpoints += 1
        db.maybeEvict()
        while len(db.ckptDone) > 0 { append(mut &done, pop(mut &db.ckptDone)) }
    })
    while len(done) > 0 { pop(mut &done).complete(Unit{}) }
    // Segments before the one recovery now starts from are not needed.
    for s in oldSegs {
        let name = segName(s)
        if fs.exists(name) {
            if !fs.exists(SPARE) { try fs.rename(name, SPARE) } else { try fs.remove(name) }
        }
    }
    return Ok(Unit{})
}

// A run of consecutive pages, written with one call (writePages).
type PageRun = record { f: lexdb_disk.File; off: int; pages: [][]byte }

fn writeRun(r: PageRun): Result[Unit, lexdb_base.DbErr] { return r.f.writePages(r.off, &r.pages) }

const RUN_PAGES = 64            // a run's pages at most: 256 KiB a write
const RUNS_IN_FLIGHT = 16       // runs written at once (32 and 64 measured no faster, 9.63)

// A checkpoint's pages, in runs of consecutive page numbers, each run one
// write, RUNS_IN_FLIGHT at a time (9.63). One page at a time, as before, a
// checkpoint waited a write's round trip (40-50 us on NVMe) per page. Only
// the runs being written are encoded: a checkpoint can hold every page the
// cache has (a quarter of the memory by default), so it is never encoded
// whole; what is in flight is at most RUNS_IN_FLIGHT * RUN_PAGES pages
// (4 MiB, and as much again in the writes' aligned buffers). A page listed
// twice is written once, as the later of its entries (as the writes in
// order left it).
fn writeCheckpointPages(f: &lexdb_disk.File, out: &[]PageOut, written: mut &int): Result[Unit, lexdb_base.DbErr] {
    var ix: []int = []
    for i in 0..len(out) { append(mut &ix, i) }
    collections.sortBy(mut &ix, fn(a, b) {
        if out[a].no != out[b].no { return out[a].no.cmp(&out[b].no) }
        return a.cmp(&b)
    })
    // the entries to write (the later of a page's), and where each run starts
    var keep: []int = []
    for i in 0..len(ix) {
        if i + 1 < len(ix) && out[ix[i + 1]].no == out[ix[i]].no { continue }
        append(mut &keep, ix[i])
    }
    written = len(keep)
    var starts: []int = []
    for i in 0..len(keep) {
        let k = len(starts)
        if k == 0 || i - starts[k - 1] >= RUN_PAGES || out[keep[i]].no != out[keep[i - 1]].no + 1 {
            append(mut &starts, i)
        }
    }
    append(mut &starts, len(keep))
    var res: Result[Unit, lexdb_base.DbErr] = Ok(Unit{})
    var r = 0
    while r + 1 < len(starts) && res.isOk() {
        var batch: []PageRun = []
        while r + 1 < len(starts) && len(batch) < RUNS_IN_FLIGHT {
            var pages: [][]byte = []
            for i in starts[r]..starts[r + 1] {
                let p = &out[keep[i]]
                if len(p.raw) > 0 { append(mut &pages, collections.copyOf(&p.raw)) } else {
                    append(mut &pages, lexdb_page.bodyPage(p.leaf, p.n, &p.body, p.no))
                }
            }
            append(mut &batch, PageRun{f: f, off: out[keep[starts[r]]].no * PAGE, pages: pages})
            r += 1
        }
        task.scope(fn(s: mut &task.Scope) {
            var fs: []task.Future[Result[Unit, lexdb_base.DbErr]] = []
            while len(batch) > 0 { append(mut &fs, s.start(writeRun, pop(mut &batch))) }
            match task.all(fs) {
                Ok(rs) { for x in rs { if x.isErr() && res.isOk() { res = x } } }
                Err(_) { res = Err(lexdb_base.err(lexdb_base.S_INTERNAL, "checkpoint: a page write was cancelled")) }
            }
        })
    }
    return res
}

fn (st: &Store) finishCheckpoint(f: &lexdb_disk.File, out: &[]PageOut, metaPage: &[]byte, n: int, target: int): Result[Unit, lexdb_base.DbErr] {
    var written = 0
    try writeCheckpointPages(f, out, mut &written)
    // The log must hold every commit this checkpoint includes before its
    // meta page may name it (otherwise recovery could mix a commit's rows).
    var wait: []task.Future[Result[Unit, lexdb_base.DbErr]] = []
    var wake: []task.Promise[Unit] = []
    st.sh.with(fn(db: mut &Db) {
        if target > db.durableBatch {
            let task.Handoff{promise: p, future: fu} = task.promise[Result[Unit, lexdb_base.DbErr]]()
            append(mut &db.waiters, Waiter{batch: target, p: p})
            append(mut &wait, fu)
            while len(db.writerWake) > 0 { append(mut &wake, pop(mut &db.writerWake)) }
        }
    })
    while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
    if len(wait) > 0 {
        match pop(mut &wait).wait() {
            Ok(r) { try r }
            Err(_) { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "checkpoint: the log writer has gone")) }
        }
    }
    try f.flush()
    try f.write((n % 2) * PAGE, metaPage)
    try f.flush()
    st.sh.with(fn(db: mut &Db) { db.pagesWritten += written + 1 })
    return Ok(Unit{})
}

// The checkpointer's loop: a checkpoint whenever the writer says the log
// has grown by ckptBytes.
pub fn checkpointer(st: Store): int {
    while true {
        var stop = false
        var idle: []task.Future[Unit] = []
        st.sh.with(fn(db: mut &Db) {
            if db.closing || len(db.failed) > 0 {
                stop = true
                return
            }
            let task.Handoff{promise: p, future: f} = task.promise[Unit]()
            append(mut &db.ckptWake, p)
            append(mut &idle, f)
        })
        if stop { break }
        match pop(mut &idle).wait() {
            Ok(_) {}
            Err(_) { break }
        }
        match st.checkpoint() {
            Ok(_) {}
            Err(_) { break }
        }
    }
    return 0
}

// ---- the log directory's check (--log-dir, design/lexdb.md 9.124)
//
// A data directory made with a log directory has a small file, LOGDIR_MARK,
// naming a random id (and, for the messages, the log directory's path); the
// log directory has LOGID with the same id. Start-up compares them, so the
// wrong log is never replayed: a data directory with the mark needs a log
// directory with its id; one without the mark (made without --log-dir) is
// started without. A directory made without --log-dir has no new file at all.
pub const LOGDIR_MARK = "logdir"
pub const LOGID = "logid"

fn hexOf(raw: &str): str {
    let digits = "0123456789abcdef"
    var b = newStrBuf()
    for i in 0..len(raw) {
        b.addByte(digits[int(raw[i]) / 16])
        b.addByte(digits[int(raw[i]) % 16])
    }
    return b.toStr()
}

// A small file, replaced whole: written beside under another name,
// flushed, then renamed over (the rename syncs the directory). Plain text,
// through the page cache (before 9.125 a zero-padded page).
fn putSmall(fs: &lexdb_disk.Fs, name: str, text: str): Result[Unit, lexdb_base.DbErr] {
    let tmp = name + ".tmp"
    if fs.exists(tmp) { try fs.remove(tmp) }
    let f = try fs.openBuffered(tmp, true)
    try f.writeText(&text)
    try f.flush()
    f.close()
    return fs.rename(tmp, name)
}

// A small file's text (up to its first zero byte, so a file padded to a page
// by an earlier version reads the same), None when there is no such file.
fn getSmall(fs: &lexdb_disk.Fs, name: str): Result[Option[str], lexdb_base.DbErr] {
    if !fs.exists(name) { return Ok(None) }
    let f = try fs.openBuffered(name, false)
    let text = try f.readText()
    f.close()
    return Ok(Some(text))
}

// The lines of text after its first line (the format's name), the id first.
fn smallLines(text: &str): []str {
    let ls = strings.splitByte(&(text.toStr()), byte(10))
    var out: []str = []
    var i = 1
    while i < len(ls) {
        append(mut &out, ls[i])
        i += 1
    }
    return out
}

// Whether fs has a log segment: log.<digits> (any number: they are not reused) or log.spare.
fn hasSegments(fs: &lexdb_disk.Fs): bool {
    for n in fs.names() {
        if n == SPARE { return true }
        if strings.startsWith(&n, "log.") && len(n) > 4 {
            var digits = true
            for i in 4..len(n) { if n[i] < byte(48) || n[i] > byte(57) { digits = false } }
            if digits { return true }
        }
    }
    return false
}

fn logRefuse(msg: str): Result[Unit, lexdb_base.DbErr] { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, msg)) }

// Refuses a data directory whose log is not the one given (split: a log
// directory was given). create: a new database may be set up (the master);
// a replica only checks.
fn checkLog(fs: &lexdb_disk.Fs, logFs: &lexdb_disk.Fs, split: bool, create: bool): Result[Unit, lexdb_base.DbErr] {
    let mark = try getSmall(fs, LOGDIR_MARK)
    if !split {
        if mark.isSome() {
            let l = smallLines(&mark.unwrap())
            let where = if len(l) >= 2 { l[1] } else { "(unknown)" }
            return logRefuse("this data directory's log is in " + where + " (it was made with --log-dir): start it with --log-dir " + where)
        }
        return Ok(Unit{})
    }
    match mark {
        Some(text) {
            let l = smallLines(&text)
            if len(l) < 2 || len(l[0]) == 0 { return logRefuse("the data directory's " + LOGDIR_MARK + " file is damaged") }
            let where = l[1]
            let have = try getSmall(logFs, LOGID)
            match have {
                None {
                    return logRefuse("the log directory is missing or is not this database's: it has no " + LOGID + " file; this data directory's log is in " + where)
                }
                Some(t) {
                    let ls = smallLines(&t)
                    if len(ls) < 1 || ls[0] != l[0] {
                        return logRefuse("the log directory belongs to another database (log id differs); this data directory's log is in " + where)
                    }
                }
            }
            return Ok(Unit{})
        }
        None {}
    }
    // no mark: a new database, or one made without a log directory
    var fresh = !hasSegments(fs)
    if fresh && fs.exists(DATA) {
        let d = try fs.openBuffered(DATA, false)
        let n = try d.size()
        d.close()
        if n > 0 { fresh = false }
    }
    if !fresh { return logRefuse("this data directory has its log inside it (it was made without --log-dir): start it without --log-dir") }
    if !create { return Ok(Unit{}) }
    // a new database needs a log directory with nothing in it but, maybe, what a crashed first start left
    if hasSegments(logFs) {
        return logRefuse("the log directory already holds a log (another database's): a new database needs an empty log directory")
    }
    for n in logFs.names() {
        if n != LOGID && n != LOGID + ".tmp" {
            return logRefuse("the log directory is not empty (" + n + "): a new database needs an empty log directory")
        }
    }
    try logFs.ensureDir()
    var raw = ""
    match crypto.randomBytes(16) {
        Ok(r) { raw = r }
        Err(e) { return logRefuse("random: " + e.toStr()) }
    }
    let id = hexOf(&raw)
    // the log's id first, then the data directory's mark: a crash between leaves a log directory
    // with an id and no log, which a start replaces
    try putSmall(logFs, LOGID, "lexdb-log 1\n" + id + "\n")
    try putSmall(fs, LOGDIR_MARK, "lexdb-logdir 1\n" + id + "\n" + logFs.where() + "\n")
    return Ok(Unit{})
}

// ---- open, recovery, close

fn newDb(fs: lexdb_disk.Fs, logFs: lexdb_disk.Fs, data: lexdb_disk.File, opts: Options, m: &lexdb_page.Meta): Db {
    return Db{opts: opts, fs: fs, logFs: logFs, data: data, watched: -1, watchedWrites: 0, pool: [], owner: [], meta: [], freeSlots: [], loadedCount: 0, cacheUsed: 0, wlog: [], wlogFloor: 0, hand: 0,
              trees: newMap(), lastLeaf: LastLeaf{tree: -1, shape: -1, path: [], lo: [], hasLo: [], hi: [], hasHi: []}, shape: 0, nextTree: m.nextTree, npages: m.npages, fileEnd: 0, reserving: true, free: [], freeAfterNext: [],
              pendingFree: [], dropped: [], frameMax: FRAME_MAX, dropReads: DROP_READS, memo: newMap(), listPages: [], ckpt: m.ckpt, durableCkpt: m.ckpt, ckptRunning: false,
              batch: [], batchCount: 0, batchNo: m.replayBatch, appliedBatch: m.replayBatch - 1,
              durableBatch: m.replayBatch - 1, waiters: [], locks: newMap(), lockWaits: [], waitFor: newMap(), nextLock: 0, writerWake: [], ckptWake: [], ckptDone: [], seg: m.replaySeg,
              segOff: m.replayOff, logSinceCkpt: 0, failed: [], closing: false, seq: 0, snaps: [], nextSnap: 0,
              hist: [], histCount: 0, histSlots: [], deferred: [], rootHist: [], durableSeq: 0, holds: newMap(), holdCkpt: -1, holdSeg: -1, heldFree: [], changeWake: [], durWaits: [], nextDurWait: 0, ckptCovers: m.covers, snapshots: 0, tooOld: 0, commits: 0,
              conflicts: 0, loads: 0, aheadReads: 0, aheadPages: 0, evictions: 0, flushes: 0, logBytes: 0, checkpoints: 0, pagesWritten: 0, held: 0, wholes: 0,
              colSpecs: newMap(), specs: [], colLeaves: 0, rowLeaves: 0, colsOff: false,
              specRatio: [], specSplits: [], refitCuts: 0, upgTree: [], upgKey: [], upgBudget: UPG_BUDGET, upgLeaves: 0, upgFailed: 0}
}

// Opens the store in fs (creating it when it is new) and recovers: the last
// checkpoint, then the log after it.
pub fn open(fs: lexdb_disk.Fs, opts: Options): Result[Store, lexdb_base.DbErr] { return openIn(fs, fs, false, opts) }

// open with the log segments in logFs, a directory of their own (--log-dir,
// design/lexdb.md 9.124): refused unless fs's data was made with this log.
pub fn openSplit(fs: lexdb_disk.Fs, logFs: lexdb_disk.Fs, opts: Options): Result[Store, lexdb_base.DbErr] {
    return openIn(fs, logFs, true, opts)
}

fn openIn(fs: lexdb_disk.Fs, logFs: lexdb_disk.Fs, split: bool, opts: Options): Result[Store, lexdb_base.DbErr] {
    try checkLog(&fs, &logFs, split, true)
    let data = try fs.openBuffered(DATA, true)
    let size = try data.size()
    var best: Option[lexdb_page.Meta] = None
    if size >= 2 * PAGE {
        var b = array(PAGE, byte(0))
        for i in 0..2 {
            try data.read(i * PAGE, mut &b[0..PAGE], PAGE)
            match lexdb_page.decodeMeta(&b, i) {
                Some(m) {
                    let better = match best { Some(o) { m.ckpt > o.ckpt } None { true } }
                    if better { best = Some(m) }
                }
                None {}
            }
        }
    }
    if best.isNone() && fs.exists(segName(2)) && !fs.exists(segName(1)) {
        return Err(lexdb_base.corrupt("no valid meta page, and the log does not start at its beginning"))
    }
    let m = best.unwrapOr(lexdb_page.Meta{ckpt: 0, npages: 2, roots: 0, free: 0, replaySeg: 1, replayOff: 0,
                                          replayBatch: 1, nextTree: 1, dropped: 0, runs: 0, covers: -1})
    var lists: []int = []
    let roots = try lexdb_page.readList(&data, m.roots, mut &lists)
    let free = try lexdb_page.readList(&data, m.free, mut &lists)
    let runs = try lexdb_page.readList(&data, m.runs, mut &lists)
    let dropped = try lexdb_page.readList(&data, m.dropped, mut &lists)
    var db = newDb(fs, logFs, data, opts, &m)
    db.fileEnd = size
    db.free = mergeRuns(&runsOf(&free), &runs)
    var d = 0
    while d + 1 < len(dropped) {
        append(mut &db.dropped, dropped[d])
        append(mut &db.dropped, dropped[d + 1] - 1)
        d += 2
    }
    db.listPages = lists
    var i = 0
    while i + 1 < len(roots) {
        let s = db.allocSlot()
        db.meta[s].disk = roots[i + 1]
        db.meta[s].ckpt = m.ckpt
        db.meta[s].root = true
        db.trees.put(roots[i], s)
        i += 2
    }
    let st = Store{sh: task.shared(db), fo: None}
    try st.replay(&m)
    return Ok(st)
}

// Checks the data file's last checkpoint (a test's check, with the store
// closed): every page below its high-water mark is in one tree, one dropped
// subtree, the free list or a list page, and in no more than one of them.
pub fn audit(fs: lexdb_disk.Fs): Result[str, lexdb_base.DbErr] {
    let data = try fs.openBuffered(DATA, false)
    var best: Option[lexdb_page.Meta] = None
    var b = array(PAGE, byte(0))
    for i in 0..2 {
        try data.read(i * PAGE, mut &b[0..PAGE], PAGE)
        match lexdb_page.decodeMeta(&b, i) {
            Some(m) {
                let better = match best { Some(o) { m.ckpt > o.ckpt } None { true } }
                if better { best = Some(m) }
            }
            None {}
        }
    }
    let m = match best {
        Some(x) { x }
        None { return Err(lexdb_base.corrupt("no valid meta page")) }
    }
    var lists: []int = []
    let roots = try lexdb_page.readList(&data, m.roots, mut &lists)
    let flat = try lexdb_page.readList(&data, m.free, mut &lists)
    let runs = try lexdb_page.readList(&data, m.runs, mut &lists)
    let dropped = try lexdb_page.readList(&data, m.dropped, mut &lists)
    var uses = array(m.npages, 0)
    for p in lists { uses[p] += 1 }
    var free: []int = []
    for p in flat { append(mut &free, p) }
    var r = 0
    while r + 1 < len(runs) {
        for p in runs[r]..runs[r] + runs[r + 1] {
            if p < 2 || p >= m.npages { return Err(lexdb_base.corrupt("free page " + p.toStr() + " is past the file's pages")) }
            append(mut &free, p)
        }
        r += 2
    }
    for p in free { uses[p] += 1 }
    var inTrees = 0
    var inDropped = 0
    var internal = 0
    var stack: []int = []
    for pass in 0..2 {
        var i = 0
        let tops = if pass == 0 { &roots } else { &dropped }
        while i + 1 < len(tops) {
            append(mut &stack, if pass == 0 { tops[i + 1] } else { tops[i] })
            i += 2
        }
        while len(stack) > 0 {
            let p = pop(mut &stack)
            if p < 2 || p >= m.npages { return Err(lexdb_base.corrupt("page " + p.toStr() + " is past the file's pages")) }
            uses[p] += 1
            if pass == 0 { inTrees += 1 } else { inDropped += 1 }
            try data.read(p * PAGE, mut &b[0..PAGE], PAGE)
            try lexdb_page.check(&b, p, lexdb_page.T_LEAF)
            if int(b[12]) == lexdb_page.T_INTERNAL {
                internal += 1
                for k in lexdb_page.decodeNode(&b).kids { append(mut &stack, k) }
            }
        }
    }
    var lost = 0
    var twice = 0
    for p in 2..m.npages {
        if uses[p] == 0 { lost += 1 }
        if uses[p] > 1 { twice += 1 }
    }
    data.close()
    return Ok("pages " + (m.npages - 2).toStr() + ": trees " + (len(roots) / 2).toStr() + " " + inTrees.toStr() +
              ", dropped " + inDropped.toStr() + ", free " + len(free).toStr() + " in " + (len(runs) / 2).toStr() + " runs, lists " + len(lists).toStr() +
              ", lost " + lost.toStr() + ", twice " + twice.toStr() + "; internal " + internal.toStr())
}

fn (st: &Store) applyRecovered(w: &TxWrite): Result[Unit, lexdb_base.DbErr] {
    while true {
        var need = -1
        st.sh.with(fn(db: mut &Db) {
            need = db.writeNeeds(w)
            if need < 0 { db.applyWrite(w) }
        })
        if need < 0 { return Ok(Unit{}) }
        try st.load(need)
    }
    return Ok(Unit{})
}

// Reads one frame at off: its records and length, or None when there is no
// valid frame with that batch number there.
pub fn readFrame(f: &lexdb_disk.File, off: int, size: int, seg: int, batch: int): Result[Option[[]TxWrite], lexdb_base.DbErr] {
    if off + PAGE > size { return Ok(None) }
    var h = array(PAGE, byte(0))
    try f.read(off, mut &h[0..PAGE], PAGE)
    if binary.readU32LE(&h, 0) != LOG_MAGIC || int(binary.readU64LE(&h, 8)) != batch || binary.readU32LE(&h, 16) != seg {
        return Ok(None)
    }
    let plen = binary.readU32LE(&h, 20)
    var n = (FRAME_HDR + plen + PAGE - 1) / PAGE * PAGE
    if off + n > size { return Ok(None) }
    var b = array(n, byte(0))
    try f.read(off, mut &b[0..n], n)
    let c = lexdb_base.crc32c(&b, 8, FRAME_HDR + plen)
    if int(c) != binary.readU32LE(&b, 4) { return Ok(None) }
    let recs = try parseRecords(&b, FRAME_HDR, FRAME_HDR + plen)
    return Ok(Some(recs))
}

pub fn frameLen(recs: &[]TxWrite): int {
    var n = FRAME_HDR
    for w in recs { n += 13 + len(w.key) + len(w.val) + (if w.op == OP_PUT && w.head > 0 { 4 } else { 0 }) }
    return (n + PAGE - 1) / PAGE * PAGE
}

// Replays the log from the meta page's position; afterwards the writer
// goes on where the last valid frame ended.
fn (st: &Store) replay(m: &lexdb_page.Meta): Result[Unit, lexdb_base.DbErr] {
    var fs = lexdb_disk.Fs.Real("")
    st.sh.with(fn(db: mut &Db) { fs = db.logFs })
    var seg = m.replaySeg
    var off = m.replayOff
    var batch = m.replayBatch
    while fs.exists(segName(seg)) {
        let f = try fs.open(segName(seg), false)
        let size = try f.size()
        var got = try readFrame(&f, off, size, seg, batch)
        var at = off
        var sg = seg
        match got {
            Some(_) {}
            None {
                // The writer may have moved on to the next segment.
                f.close()
                if !fs.exists(segName(seg + 1)) { break }
                let g = try fs.open(segName(seg + 1), false)
                let gs = try g.size()
                got = try readFrame(&g, 0, gs, seg + 1, batch)
                g.close()
                match got {
                    Some(_) {
                        sg = seg + 1
                        at = 0
                    }
                    None { break }
                }
            }
        }
        match got {
            Some(recs) {
                for w in recs { try st.applyRecovered(&w) }
                seg = sg
                off = at + frameLen(&recs)
                batch += 1
            }
            None { break }
        }
        f.close()
    }
    st.sh.with(fn(db: mut &Db) {
        db.seg = seg
        db.segOff = off
        db.batchNo = batch
        db.appliedBatch = batch - 1
        db.durableBatch = batch - 1
    })
    return Ok(Unit{})
}

// Asks the writer and the checkpointer to stop once the log holds every
// commit.
pub fn (st: &Store) close() {
    match st.fo {
        Some(fo) {
            fo.close()
            return
        }
        None {}
    }
    var wake: []task.Promise[Unit] = []
    st.sh.with(fn(db: mut &Db) {
        db.closing = true
        while len(db.writerWake) > 0 { append(mut &wake, pop(mut &db.writerWake)) }
        while len(db.ckptWake) > 0 { append(mut &wake, pop(mut &db.ckptWake)) }
        while len(db.durWaits) > 0 {
            let DurWait{id: _, p: p} = pop(mut &db.durWaits)
            append(mut &wake, p)
        }
    })
    while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
}

// Counters, for the tests and the server's log.
pub type Stats = value record {
    pub commits: int
    pub conflicts: int
    pub loads: int
    pub aheadReads: int
    pub aheadPages: int
    pub evictions: int
    pub flushes: int
    pub logBytes: int
    pub checkpoints: int
    pub pagesWritten: int
    pub loaded: int
    pub cacheUsed: int          // about the bytes the loaded nodes take
    pub held: int
    pub pages: int
    pub free: int
    pub freeRuns: int
    pub dropped: int            // dropped subtrees whose pages are still to free
    pub wholes: int
}

// The most pages of dropped subtrees one checkpoint reads (tests).
pub fn (st: &Store) setFrameMax(n: int) { st.sh.with(fn(db: mut &Db) { db.frameMax = n }) }
pub fn (st: &Store) setDropReads(n: int) { st.sh.with(fn(db: mut &Db) { db.dropReads = n }) }

// The memo: values the SQL layer keeps while the store is open, outside any
// transaction (lost when it closes).
// A copy of the store's handle (it is a reference to the one store).
pub fn (st: &Store) handle(): Store { return Store{sh: st.sh, fo: st.fo} }

pub fn (st: &Store) memoGet(k: &str): Option[str] {
    var out: Option[str] = None
    st.sh.with(fn(db: mut &Db) { out = db.memo.get(k) })
    return out
}

pub fn (st: &Store) memoPut(k: &str, v: &str) { st.sh.with(fn(db: mut &Db) { db.memo.put(k, v) }) }

pub fn (st: &Store) memoDel(k: &str) { st.sh.with(fn(db: mut &Db) { let gone = db.memo.remove(k) }) }

// ---- followers (9.71)

// The last batch the log holds: a follower applies batches up to it.
pub fn (st: &Store) durableBatch(): int {
    var b = 0
    st.sh.with(fn(db: mut &Db) { b = db.durableBatch })
    return b
}

// Keeps what a follower reads: the pages that checkpoints after ckpt free
// are not reused, and log segments from seg on are kept. A follower moves
// it up as it lets go of older checkpoints; ckpt -1 lets go of all. The
// pages held become free once ckpt reaches the checkpoint that freed them.
// (The follower in this process: holdFor's 0.)
pub fn (st: &Store) hold(ckpt: int, seg: int) { st.holdFor(0, ckpt, seg) }

// hold, for follower id (each replica its own, 9.73): what is kept is what
// the oldest hold needs.
pub fn (st: &Store) holdFor(id: int, ckpt: int, seg: int) {
    st.sh.with(fn(db: mut &Db) {
        if ckpt < 0 { let x = db.holds.remove(&id) } else { db.holds.put(id, HoldAt{ckpt: ckpt, seg: seg}) }
        db.rehold()
    })
}

// The effective hold, the oldest of the followers', and the pages it no
// longer keeps freed.
fn (db: mut &Db) rehold() {
    var ck = -1
    var sg = -1
    for i in 0..db.holds.size() {
        let h: HoldAt = db.holds.valAt(i)
        if ck < 0 || h.ckpt < ck { ck = h.ckpt }
        if sg < 0 || h.seg < sg { sg = h.seg }
    }
    db.holdCkpt = ck
    db.holdSeg = sg
    var keep: []HeldRuns = []
    while len(db.heldFree) > 0 {
        let h = pop(mut &db.heldFree)
        if ck >= 0 && ck < h.ckpt { append(mut &keep, h) } else { db.free = mergeRuns(&db.free, &h.runs) }
    }
    db.heldFree = keep
}

// Whether the last durable checkpoint says which batch it covers (one
// written before covers was kept does not: a follower cannot use it).
pub fn (st: &Store) checkpointCovers(): bool {
    var k = false
    st.sh.with(fn(db: mut &Db) { k = db.ckptCovers >= 0 })
    return k
}

// The last durable checkpoint.
pub fn (st: &Store) durableCheckpoint(): int {
    var c = 0
    st.sh.with(fn(db: mut &Db) { c = db.durableCkpt })
    return c
}

// The waitDurable calls waiting now (for the tests).
pub fn (st: &Store) durWaiting(): int {
    var n = 0
    st.sh.with(fn(db: mut &Db) { n = len(db.durWaits) })
    return n
}

// A waitDurable's place: its promise, and its id to take it out again.
type DurWait = record { id: int; p: task.Promise[Unit] }

// Waits until a flush makes a commit after seq durable (durableSeq past
// seq), for at most ms: true then; false at the timeout, or when the store
// closes or fails, or the task is cancelled. WAITFOR's wait
// (design/lexdb-events.md): seq is the snapshot it read (snapshotSeq), so
// the snapshot taken next shows what woke it.
// - Woken after the flush (the writer drains durWaits as it advances
//   durableSeq), and by close and fail.
// - The check and the promise's place are taken in one with, which cannot
//   park, so no flush comes between them.
// - A wait that times out takes its place out again, so an idle store
//   does not gather them. A timer that ends a little early is waited on
//   again.
pub fn (st: &Store) waitDurable(seq: int, ms: int): bool {
    let until = time.monotonicNs() + ms * 1000000
    while true {
        let left = (until - time.monotonicNs() + 999999) / 1000000
        var fut: []task.Future[Unit] = []
        var done = false
        var over = false
        var id = 0
        st.sh.with(fn(db: mut &Db) {
            if db.durableSeq > seq {
                done = true
                return
            }
            if db.closing || len(db.failed) > 0 || left <= 0 {
                over = true
                return
            }
            let task.Handoff{promise: p, future: f} = task.promise[Unit]()
            id = db.nextDurWait
            db.nextDurWait += 1
            append(mut &db.durWaits, DurWait{id: id, p: p})
            append(mut &fut, f)
        })
        if done { return true }
        if over { return false }
        match pop(mut &fut).waitFor(left) {
            Ok(_) {}
            Err(c) {
                // its place out (dropped there, its future being gone)
                var mine: []DurWait = []
                st.sh.with(fn(db: mut &Db) {
                    var i = 0
                    while i < len(db.durWaits) {
                        if db.durWaits[i].id == id {
                            append(mut &mine, collections.swapRemove(mut &db.durWaits, i))
                        } else {
                            i += 1
                        }
                    }
                })
                if !c.eq(&task.Cancelled.Timeout) { return false }
            }
        }
    }
    return false
}

// Waits until the next flush of the log or the next checkpoint (the
// replication link's master side sends what changed), or until the store
// closes or fails; false then.
pub fn (st: &Store) waitChange(): bool {
    var fut: []task.Future[Unit] = []
    var over = false
    st.sh.with(fn(db: mut &Db) {
        if db.closing || len(db.failed) > 0 {
            over = true
            return
        }
        let task.Handoff{promise: p, future: f} = task.promise[Unit]()
        append(mut &db.changeWake, p)
        append(mut &fut, f)
    })
    if over { return false }
    return pop(mut &fut).wait().isOk()
}

// Starts a hold at the last durable checkpoint, and every log segment,
// in one step (a follower's first; it then holds the checkpoint it reads,
// which is this one or a later one), and gives that checkpoint.
pub fn (st: &Store) holdNow(): int { return st.holdNowFor(0) }

// holdNow, for follower id.
pub fn (st: &Store) holdNowFor(id: int): int {
    var c = 0
    st.sh.with(fn(db: mut &Db) {
        c = db.durableCkpt
        db.holds.put(id, HoldAt{ckpt: c, seg: 0})
        db.rehold()
    })
    return c
}

pub fn (st: &Store) stats(): Stats {
    var s = Stats{commits: 0, conflicts: 0, loads: 0, aheadReads: 0, aheadPages: 0, evictions: 0, flushes: 0, logBytes: 0, checkpoints: 0, pagesWritten: 0, loaded: 0,
                  cacheUsed: 0, held: 0, pages: 0, free: 0, freeRuns: 0, dropped: 0, wholes: 0}
    st.sh.with(fn(db: mut &Db) {
        s = Stats{commits: db.commits, conflicts: db.conflicts, loads: db.loads, aheadReads: db.aheadReads,
                  aheadPages: db.aheadPages, evictions: db.evictions,
                  flushes: db.flushes, logBytes: db.logBytes, checkpoints: db.checkpoints, pagesWritten: db.pagesWritten, loaded: db.loadedCount,
                  cacheUsed: db.cacheUsed, held: db.held, pages: db.npages,
                  free: runPages(&db.free), freeRuns: len(db.free) / 2, dropped: len(db.dropped) / 2, wholes: db.wholes}
    })
    return s
}

// Counts the writes to tree from now on (changes): the executor watches
// its catalog, so what it derived from the schema (a prepared statement's
// columns) is known to be current while the count is the same.
pub fn (st: &Store) watch(tree: int) {
    match st.fo {
        Some(fo) { fo.watch(tree) }
        None {}
    }
    st.sh.with(fn(db: mut &Db) {
        db.watched = tree
        db.watchedWrites = 0
    })
}

// The writes to the watched tree applied so far.
pub fn (st: &Store) changes(): int {
    match st.fo {
        Some(fo) { return fo.changes() }
        None {}
    }
    var n = 0
    st.sh.with(fn(db: mut &Db) { n = db.watchedWrites })
    return n
}

// The ids of the trees, in no order.
pub fn (st: &Store) trees(): []int {
    match st.fo {
        Some(fo) { return fo.trees() }
        None {}
    }
    var out: []int = []
    st.sh.with(fn(db: mut &Db) {
        for i in 0..db.trees.size() {
            let id: int = db.trees.keyAt(i)
            if !isOvf(id) { append(mut &out, id) }
        }
    })
    return out
}

// Opens the store, runs the writer and the checkpointer as tasks, calls f,
// then closes the store and waits for them.
pub fn run[R](fs: lexdb_disk.Fs, opts: Options, f: &fn(Store): R): Result[R, lexdb_base.DbErr] {
    return runWith(open(fs, opts), f)
}

// run with the log in logFs (openSplit).
pub fn runSplit[R](fs: lexdb_disk.Fs, logFs: lexdb_disk.Fs, opts: Options, f: &fn(Store): R): Result[R, lexdb_base.DbErr] {
    return runWith(openSplit(fs, logFs, opts), f)
}

fn runWith[R](opened: Result[Store, lexdb_base.DbErr], f: &fn(Store): R): Result[R, lexdb_base.DbErr] {
    let st = try opened
    var out: []R = []
    task.scope(fn(s: mut &task.Scope) {
        s.spawn(writer, st)
        s.spawn(checkpointer, st)
        append(mut &out, f(st))
        st.close()
    })
    return Ok(pop(mut &out))
}

// ==== the follower (design/lexdb.md 9.68, 9.71)
//
//
// It reads the store as the master leaves it on disk, and changes nothing:
//
// - the base: the trees of a checkpoint, from the master's page file. A page
//   is never written in place (4.1), so a page read once stays right for
//   every checkpoint that still names it. The cache keeps pages by number,
//   decoded (leaves lazy, internal nodes' kids as page numbers);
// - the delta: the rows of every batch since, from the master's log, each
//   key's versions by batch, whole values (the log holds rows, not pages).
//
// A snapshot reads as of a batch: a key's newest version at or below it,
// else the base. A checkpoint's trees hold every commit up to its covers
// batch (and perhaps some after its replay point, which the delta has as
// well), so a base serves snapshots at batches >= its covers.
//
// The master keeps what the follower may still read (Store.hold): the
// pages that checkpoints after the oldest base in use free, and the log
// segments from the follower's position on. When no snapshot uses a base
// but the newest, the follower lets it go: it evicts the pages the newer
// base lists as free (the master may reuse them from then on), drops the
// versions that base holds, and moves the hold up.
//
// Here the follower shares a process with the master (it calls the Store
// for durableBatch and hold); a replica process will get both from a
// stream instead (9.68).

// Where a follower's master is. Local: a Store in this process (the
// tests); a replica process's follower talks to its master over a socket
// (9.72).
pub type Link = value closed {
    Local(Store)
    LocalId(Store, int)         // Local, holding as follower id (several in one process: the tests)
    Remote(task.Shared[Outbox])
}

// What a replica's follower has for its master, sent by the link's task
// (lexdb_repl): the hold as it now is (a newer one replaces one not yet
// sent: only the last matters). The follower may not park (it asks inside
// its lock), so it only leaves it here.
pub type Outbox = record {
    pub first: int              // the checkpoint the master's hold began at (the handshake's)
    pub ckpt: int               // the hold to send, ckpt -1 none
    pub seg: int
    pub wake: []task.Promise[Unit]
}

pub fn newOutbox(first: int): task.Shared[Outbox] {
    return task.shared(Outbox{first: first, ckpt: -1, seg: -1, wake: []})
}

// Asks the master to keep what the follower reads (Store.hold).
fn (l: &Link) hold(ckpt: int, seg: int) {
    match l {
        Link.Local(st) { st.hold(ckpt, seg) }
        Link.LocalId(st, id) { st.holdFor(id, ckpt, seg) }
        Link.Remote(ob) {
            var wake: []task.Promise[Unit] = []
            ob.with(fn(o: mut &Outbox) {
                o.ckpt = ckpt
                o.seg = seg
                while len(o.wake) > 0 { append(mut &wake, pop(mut &o.wake)) }
            })
            while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
        }
    }
}

// Starts a hold at the master's last durable checkpoint (Store.holdNow);
// over a link, the master did at the handshake.
fn (l: &Link) holdNow(): int {
    var c = 0
    match l {
        Link.Local(st) { c = st.holdNow() }
        Link.LocalId(st, id) { c = st.holdNowFor(id) }
        Link.Remote(ob) { ob.with(fn(o: mut &Outbox) { c = o.first }) }
    }
    return c
}

fn (l: &Link) local(): bool { return match l { Link.Local(_) { true } Link.LocalId(_, _) { true } Link.Remote(_) { false } } }


// A checkpoint the follower reads.
type Base = record {
    ckpt: int
    covers: int
    replayBatch: int
    replaySeg: int
    roots: Map[int, int]    // tree -> root page
    free: []int             // its free pages, as (first, count) runs
}

type Ver = value record { batch: int; val: str; gone: bool }

// A tree's rows since the base: each key's versions, oldest first, and the
// keys in sorted runs of their numbers (each key in one run; runs merge as
// they grow, so a scan merges a few).
type Delta = record {
    idx: Map[str, int]      // key -> its number: keys and vers index
    keys: []str
    vers: [][]Ver
    runs: [][]int
}

fn newDelta(): Delta { return Delta{idx: newMap(), keys: [], vers: [], runs: []} }

// A tree created (or dropped) by the batch.
type Life = value record { batch: int; created: bool }

type FolSnap = value record { id: int; batch: int; ckpt: int }

type Fol = record {
    link: Link
    data: lexdb_disk.File
    fs: lexdb_disk.Fs       // the log's (the data file is opened from the data directory's)
    bases: []Base           // oldest first; snapshots begin on the last
    next: []Base            // a newer checkpoint, used once applied reaches its covers
    pool: []lexdb_page.Node // cached pages
    pageOf: []int           // pool[i]'s page
    refd: []bool            // clock bits
    at: Map[int, int]       // page -> pool index
    used: int               // the cached pages' cost (lexdb_page.nodeCost)
    budget: int
    hand: int
    deltas: Map[int, Delta]
    life: Map[int, []Life]
    applied: int            // the last batch applied
    seg: int                // where the next batch's frame is
    off: int
    segF: []lexdb_disk.File // the segment open for reading, if any
    segNo: int
    snaps: []FolSnap
    nextSnap: int
    pub loads: int
    pub evictions: int
    pub batches: int
    pub freed: int          // pages evicted as the master may reuse them (release)
    watched: int            // a tree whose applied writes are counted (Store.watch), -1 none
    watchedWrites: int
    metaDue: bool           // a newer checkpoint may be on disk (checkpointed); a local link's always
}

pub type Follower = value record { sh: task.Shared[Fol] }

// A snapshot: the store as of batch, read through checkpoint ckpt.
pub type FSnap = value record { pub id: int; pub batch: int; pub ckpt: int }

// ---- opening

// The newer valid meta page of the page file.
fn readMeta(f: &lexdb_disk.File): Result[lexdb_page.Meta, lexdb_base.DbErr] {
    var best: Option[lexdb_page.Meta] = None
    var b = array(PAGE, byte(0))
    for i in 0..2 {
        try f.read(i * PAGE, mut &b[0..PAGE], PAGE)
        match lexdb_page.decodeMeta(&b, i) {
            Some(m) {
                let better = match best { Some(o) { m.ckpt > o.ckpt } None { true } }
                if better { best = Some(m) }
            }
            None {}
        }
    }
    return match best {
        Some(m) { Ok(m) }
        None { Err(lexdb_base.corrupt("follower: no valid meta page")) }
    }
}

fn loadBase(f: &lexdb_disk.File, m: &lexdb_page.Meta): Result[Base, lexdb_base.DbErr] {
    var lists: []int = []
    let pairs = if m.roots > 0 { try lexdb_page.readList(f, m.roots, mut &lists) } else { [] }
    var roots: Map[int, int] = newMap()
    var i = 0
    while i + 1 < len(pairs) {
        roots.put(pairs[i], pairs[i + 1])
        i += 2
    }
    let free = if m.runs > 0 { try lexdb_page.readList(f, m.runs, mut &lists) } else { [] }
    return Ok(Base{ckpt: m.ckpt, covers: m.covers, replayBatch: m.replayBatch, replaySeg: m.replaySeg, roots: roots, free: free})
}

// A follower of st, whose files are fs's, with a page cache of about
// cacheBytes. It is ready (ready) once it has applied the log up to its
// first checkpoint's covers batch.
pub fn openFollower(link: Link, fs: lexdb_disk.Fs, cacheBytes: int): Result[Follower, lexdb_base.DbErr] {
    return openFollowerHow(link, fs, fs, cacheBytes)
}

// openFollower, with the log in logFs.
fn openFollowerHow(link: Link, fs: lexdb_disk.Fs, logFs: lexdb_disk.Fs, cacheBytes: int): Result[Follower, lexdb_base.DbErr] {
    let held = link.holdNow()
    let data = try fs.openBuffered(DATA, false)
    let m = try readMeta(&data)
    if m.ckpt < held { return Err(lexdb_base.corrupt("follower: the meta page is older than the store's checkpoint")) }
    let b = try loadBase(&data, &m)
    link.hold(m.ckpt, m.replaySeg)
    let fol = Fol{link: link, data: data, fs: logFs, bases: [], next: [b], pool: [], pageOf: [], refd: [], at: newMap(),
                  used: 0, budget: cacheBytes, hand: 0, deltas: newMap(), life: newMap(), applied: m.replayBatch - 1,
                  seg: m.replaySeg, off: m.replayOff, segF: [], segNo: -1, snaps: [], nextSnap: 0,
                  loads: 0, evictions: 0, batches: 0, freed: 0, watched: -1, watchedWrites: 0, metaDue: false}
    let fo = Follower{sh: task.shared(fol)}
    fo.adopt()
    return Ok(fo)
}

// The master has written a newer checkpoint: the next poll reads the meta
// page.
pub fn (fo: &Follower) checkpointed() {
    fo.sh.with(fn(f: mut &Fol) { f.metaDue = true })
}

pub fn (fo: &Follower) ready(): bool {
    var r = false
    fo.sh.with(fn(f: mut &Fol) { r = len(f.bases) > 0 })
    return r
}

pub fn (fo: &Follower) applied(): int {
    var a = 0
    fo.sh.with(fn(f: mut &Fol) { a = f.applied })
    return a
}

pub fn (fo: &Follower) close() {
    fo.sh.with(fn(f: mut &Fol) {
        f.data.close()
        while len(f.segF) > 0 { pop(mut &f.segF).close() }
        f.link.hold(-1, -1)
    })
}

// ---- following the log

// Applies the log's batches up to upto (at most the last durable one), and
// takes up a newer checkpoint when there is one. Gives the batches applied.
// A batch up to upto that the log does not have is an error.
pub fn (fo: &Follower) poll(upto: int): Result[int, lexdb_base.DbErr] {
    var n = 0
    while true {
        var seg = 0
        var off = 0
        var batch = 0
        var open: []lexdb_disk.File = []
        var fs = lexdb_disk.Fs.Real("")
        fo.sh.with(fn(f: mut &Fol) {
            seg = f.seg
            off = f.off
            batch = f.applied + 1
            fs = f.fs
            if f.segNo == seg && len(f.segF) > 0 { append(mut &open, f.segF[0]) }
        })
        if batch > upto { break }
        if len(open) == 0 {
            if !fs.exists(segName(seg)) { return Err(logGone(batch, seg)) }
            append(mut &open, try fs.open(segName(seg), false))
            let fresh = open[0]
            fo.sh.with(fn(f: mut &Fol) {
                while len(f.segF) > 0 { pop(mut &f.segF).close() }
                append(mut &f.segF, fresh)
                f.segNo = seg
            })
        }
        let size = try open[0].size()
        var got = try readFrame(&open[0], off, size, seg, batch)
        var at = off
        var sg = seg
        if got.isNone() {
            // the writer may have gone on to the next segment
            if !fs.exists(segName(seg + 1)) { return Err(logGone(batch, seg)) }
            let g = try fs.open(segName(seg + 1), false)
            let gs = try g.size()
            got = try readFrame(&g, 0, gs, seg + 1, batch)
            if got.isNone() {
                g.close()
                return Err(logGone(batch, seg))
            }
            sg = seg + 1
            at = 0
            fo.sh.with(fn(f: mut &Fol) {
                while len(f.segF) > 0 { pop(mut &f.segF).close() }
                append(mut &f.segF, g)
                f.segNo = seg + 1
            })
        }
        let recs = got.unwrap()
        let flen = frameLen(&recs)
        fo.sh.with(fn(f: mut &Fol) {
            for w in recs { f.apply(batch, &w) }
            f.applied = batch
            f.seg = sg
            f.off = at + flen
            f.batches += 1
        })
        n += 1
    }
    // the meta page only when there may be a new checkpoint: a link says so
    var due = false
    fo.sh.with(fn(f: mut &Fol) {
        due = f.metaDue || f.link.local()
        f.metaDue = false
    })
    if due { try fo.checkMeta() } else { fo.adopt() }
    return Ok(n)
}

// A durable batch the log no longer has where the follower looks: its
// segments were reused (the hold was not kept), or the master is not the
// one it follows.
fn logGone(batch: int, seg: int): lexdb_base.DbErr {
    return lexdb_base.corrupt("follower: batch " + batch.toStr() + " is not in log segment " + seg.toStr() + " or the next")
}

fn (f: mut &Fol) apply(batch: int, w: &TxWrite) {
    if w.tree == f.watched { f.watchedWrites += 1 }
    if w.op == OP_PUT || w.op == OP_DEL {
        if !f.deltas.has(&w.tree) { f.deltas.put(w.tree, newDelta()) }
        let gone = w.op == OP_DEL
        f.deltas.atMut(w.tree).add(&w.key, Ver{batch: batch, val: if gone { "" } else { w.val }, gone: gone})
    } else if w.op == OP_CREATE || w.op == OP_DROP {
        if !f.life.has(&w.tree) { f.life.put(w.tree, []) }
        append(f.life.atMut(w.tree), Life{batch: batch, created: w.op == OP_CREATE})
    }
}

fn (d: mut &Delta) add(key: &str, v: Ver) {
    match d.idx.get(key) {
        Some(i) {
            append(mut &d.vers[i], v)
            return
        }
        None {}
    }
    let n = len(d.vers)
    d.idx.put(lexdb_base.own(key), n)
    append(mut &d.keys, lexdb_base.own(key))
    append(mut &d.vers, [v])
    append(mut &d.runs, [n])
    // runs as a binary counter: a run merges into the one before it while
    // that one is no longer
    while len(d.runs) >= 2 && len(d.runs[len(d.runs) - 2]) <= len(d.runs[len(d.runs) - 1]) {
        let b = pop(mut &d.runs)
        let a = pop(mut &d.runs)
        append(mut &d.runs, mergeKeys(&d.keys, &a, &b))
    }
}

// Two sorted runs of key numbers as one.
fn mergeKeys(keys: &[]str, a: &[int], b: &[int]): []int {
    var out: []int = withCapacity(len(a) + len(b))
    var i = 0
    var j = 0
    while i < len(a) && j < len(b) {
        if keys[a[i]] < keys[b[j]] {
            append(mut &out, a[i])
            i += 1
        } else {
            append(mut &out, b[j])
            j += 1
        }
    }
    while i < len(a) {
        append(mut &out, a[i])
        i += 1
    }
    while j < len(b) {
        append(mut &out, b[j])
        j += 1
    }
    return out
}

// A newer checkpoint on disk becomes the next base; the next base becomes
// the one snapshots begin on once the log is applied to its covers batch.
fn (fo: &Follower) checkMeta(): Result[Unit, lexdb_base.DbErr] {
    var data = lexdb_disk.File.Real(-1, false)
    var newest = 0
    fo.sh.with(fn(f: mut &Fol) {
        data = f.data
        newest = if len(f.next) > 0 { f.next[0].ckpt } else if len(f.bases) > 0 { f.bases[len(f.bases) - 1].ckpt } else { 0 }
    })
    let m = try readMeta(&data)
    // covers -1: a file from before covers was kept; not used
    if m.ckpt > newest && m.covers >= 0 {
        var nb = [try loadBase(&data, &m)]
        fo.sh.with(fn(f: mut &Fol) { f.next = replace(mut &nb, []) })
    }
    fo.adopt()
    return Ok(Unit{})
}

fn (fo: &Follower) adopt() {
    fo.sh.with(fn(f: mut &Fol) {
        if len(f.next) > 0 && f.next[0].covers >= 0 && f.next[0].covers <= f.applied {
            append(mut &f.bases, pop(mut &f.next))
            f.release()
        }
    })
}

// Lets go of the bases no snapshot uses (all but the newest): the pages
// the oldest kept base lists as free leave the cache, as the master may
// reuse them once the hold moves; the versions it holds go; the hold moves
// up to it.
fn (f: mut &Fol) release() {
    if len(f.bases) == 0 { return }
    var keep = f.bases[len(f.bases) - 1].ckpt
    for s in f.snaps { if s.ckpt < keep { keep = s.ckpt } }
    if f.bases[0].ckpt >= keep { return }
    var kept: []Base = []
    while len(f.bases) > 0 {
        let b = pop(mut &f.bases)
        if b.ckpt >= keep { append(mut &kept, b) }
    }
    while len(kept) > 0 { append(mut &f.bases, pop(mut &kept)) }
    // pages free in the oldest kept base: not in it nor in any later one
    // until the master reuses them, which it may from now on
    var r = 0
    while r + 1 < len(f.bases[0].free) {
        let first = f.bases[0].free[r]
        let cnt = f.bases[0].free[r + 1]
        for p in first..first + cnt {
            match f.at.get(&p) {
                Some(i) {
                    f.evictAt(i)
                    f.freed += 1
                }
                None {}
            }
        }
        r += 2
    }
    f.prune(f.bases[0].replayBatch)
    f.link.hold(f.bases[0].ckpt, f.seg)
}

// Drops the versions before batch floor (the oldest base in use holds
// them), and rebuilds each tree's runs from the keys left.
fn (f: mut &Fol) prune(floor: int) {
    var trees: []int = []
    for i in 0..f.deltas.size() {
        let t: int = f.deltas.keyAt(i)
        append(mut &trees, t)
    }
    for t in trees {
        var d = f.deltas.remove(&t).unwrap()
        var nd = newDelta()
        // the keys in order: the runs merged
        var order: []int = []
        for run in d.runs { order = mergeKeys(&d.keys, &order, &run) }
        var run: []int = withCapacity(len(order))
        for i in order {
            var vs: []Ver = []
            for v in d.vers[i] { if v.batch >= floor { append(mut &vs, v) } }
            if len(vs) > 0 {
                let n = len(nd.vers)
                nd.idx.put(lexdb_base.own(&d.keys[i]), n)
                append(mut &nd.keys, lexdb_base.own(&d.keys[i]))
                append(mut &nd.vers, vs)
                append(mut &run, n)
            }
        }
        if len(nd.vers) > 0 {
            append(mut &nd.runs, run)
            f.deltas.put(t, nd)
        }
    }
    var lt: []int = []
    for i in 0..f.life.size() {
        let t: int = f.life.keyAt(i)
        append(mut &lt, t)
    }
    for t in lt {
        // a tree's life before the floor is in the base
        var ls = f.life.remove(&t).unwrap()
        var keep: []Life = []
        for l in ls { if l.batch >= floor { append(mut &keep, l) } }
        if len(keep) > 0 { f.life.put(t, keep) }
    }
}

// ---- the cache

const MIN_PAGES = 16        // never evicted below: a descent's whole path fits

// What a cached page takes: a lazy leaf, its page's entries and 8 bytes an
// entry; an internal node, its keys decoded (64 bytes a key, 9.13) and its
// kids' page numbers. (lexdb_page.nodeCost charges the store's slots for
// kids, which a follower has none of.)
fn pageCost(n: &lexdb_page.Node): int {
    if n.leaf { return lexdb_page.nodeCost(n) }
    return 160 + n.size + 64 * len(n.keys) + 8 * len(n.kids)
}

fn (f: mut &Fol) evictAt(i: int) {
    let p = f.pageOf[i]
    f.used -= pageCost(&f.pool[i])
    let last = len(f.pool) - 1
    if i != last {
        swap(mut &f.pool, i, last)
        swap(mut &f.pageOf, i, last)
        swap(mut &f.refd, i, last)
        f.at.put(f.pageOf[i], i)
    }
    let gone = pop(mut &f.pool)
    let gp = pop(mut &f.pageOf)
    let gr = pop(mut &f.refd)
    let x = f.at.remove(&p)
    f.evictions += 1
}

fn (f: mut &Fol) install(p: int, n: lexdb_page.Node) {
    if f.at.has(&p) { return }
    f.used += pageCost(&n)
    f.at.put(p, len(f.pool))
    append(mut &f.pool, n)
    append(mut &f.pageOf, p)
    append(mut &f.refd, true)
    // the clock: a page looked at since the hand last passed is kept once
    var turns = 0
    while f.used > f.budget && len(f.pool) > MIN_PAGES && turns < 4 * len(f.pool) {
        if f.hand >= len(f.pool) { f.hand = 0 }
        if f.pageOf[f.hand] == p || f.refd[f.hand] {
            f.refd[f.hand] = false
            f.hand += 1
        } else {
            f.evictAt(f.hand)
        }
        turns += 1
    }
}

fn (fo: &Follower) load(p: int): Result[Unit, lexdb_base.DbErr] {
    var data = lexdb_disk.File.Real(-1, false)
    fo.sh.with(fn(f: mut &Fol) { data = f.data })
    var b = array(PAGE, byte(0))
    try data.read(p * PAGE, mut &b[0..PAGE], PAGE)
    try lexdb_page.check(&b, p, lexdb_page.T_LEAF)          // a leaf or an internal page
    var n = [lexdb_page.decodeNode(&b)]
    fo.sh.with(fn(f: mut &Fol) {
        f.loads += 1
        f.install(p, pop(mut &n))
    })
    return Ok(Unit{})
}

// ---- snapshots

// A snapshot as of the last batch applied, on the newest base.
pub fn (fo: &Follower) begin(): Result[FSnap, lexdb_base.DbErr] {
    var out: []FSnap = []
    fo.sh.with(fn(f: mut &Fol) {
        if len(f.bases) == 0 { return }
        let s = FolSnap{id: f.nextSnap, batch: f.applied, ckpt: f.bases[len(f.bases) - 1].ckpt}
        f.nextSnap += 1
        append(mut &f.snaps, s)
        append(mut &out, FSnap{id: s.id, batch: s.batch, ckpt: s.ckpt})
    })
    if len(out) == 0 { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "follower: not ready")) }
    return Ok(out[0])
}

pub fn (fo: &Follower) end(s: &FSnap) {
    fo.sh.with(fn(f: mut &Fol) {
        var keep: []FolSnap = []
        for x in f.snaps { if x.id != s.id { append(mut &keep, x) } }
        f.snaps = keep
        f.release()
    })
}

fn (f: &Fol) baseOf(ckpt: int): int {
    for i in 0..len(f.bases) { if f.bases[i].ckpt == ckpt { return i } }
    return -1
}

// Whether tree is there as of the snapshot: its last create or drop at or
// before the batch, else whether the base has it.
fn (f: &Fol) live(s: &FSnap, tree: int, bi: int): bool {
    if f.life.has(&tree) {
        let ls = f.life.at(tree)
        var i = len(ls) - 1
        while i >= 0 {
            if ls[i].batch <= s.batch { return ls[i].created }
            i -= 1
        }
    }
    return f.bases[bi].roots.has(&tree)
}

// The key's newest version at or before the batch: 0 none, 1 a value, 2 gone.
fn (f: &Fol) version(tree: int, key: &str, batch: int, out: mut &[]str): int {
    if !f.deltas.has(&tree) { return 0 }
    let d = f.deltas.at(tree)
    return match d.idx.get(key) {
        Some(i) { versionAt(d, i, batch, out) }
        None { 0 }
    }
}

// version, for key number i of d.
fn versionAt(d: &Delta, i: int, batch: int, out: mut &[]str): int {
    var j = len(d.vers[i]) - 1
    while j >= 0 {
        if d.vers[i][j].batch <= batch {
            if d.vers[i][j].gone { return 2 }
            append(out, d.vers[i][j].val)
            return 1
        }
        j -= 1
    }
    return 0
}


// One step of a descent through the base for key k: the leaf's pool index
// (leaf), or the page to load first (need), with the smallest separator
// above k on the way (the leaf holds no key >= it).
type Step = record { leaf: int; need: int; upper: str; hasUpper: bool }

fn (f: mut &Fol) descend(root: int, k: &str): Step {
    var st = Step{leaf: -1, need: -1, upper: "", hasUpper: false}
    var p = root
    while true {
        match f.at.get(&p) {
            Some(i) {
                f.refd[i] = true
                if f.pool[i].leaf {
                    st.leaf = i
                    return st
                }
                let c = childIndex(&f.pool[i].keys, k)
                if c < len(f.pool[i].keys) {
                    st.upper = f.pool[i].keys[c]
                    st.hasUpper = true
                }
                p = f.pool[i].kids[c]
            }
            None {
                st.need = p
                return st
            }
        }
    }
    return st
}

// The value the base holds for key in tree, as stored (marked when large
// or escaped), if any.
fn (fo: &Follower) baseGet(bi: int, tree: int, key: &str): Result[Option[str], lexdb_base.DbErr] {
    while true {
        var need = -1
        var out: []str = []
        fo.sh.with(fn(f: mut &Fol) {
            match f.bases[bi].roots.get(&tree) {
                Some(root) {
                    let st = f.descend(root, key)
                    if st.need >= 0 {
                        need = st.need
                        return
                    }
                    let n = &f.pool[st.leaf]
                    let i = n.lower(key)
                    if i < n.count() && n.key(i) == key { append(mut &out, n.val(i)) }
                }
                None {}
            }
        })
        if need >= 0 {
            try fo.load(need)
            continue
        }
        if len(out) == 0 { return Ok(None) }
        return Ok(Some(pop(mut &out)))
    }
    return Ok(None)
}

// The entries of the base's tree with keys in [from, to) (to "": to the
// end), in order, while f gives true; as stored.
fn (fo: &Follower) baseScan(bi: int, tree: int, from: &str, to: &str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    var cursor = lexdb_base.own(from)
    while true {
        var need = -1
        var chunk: []Entry = []
        var upper = ""
        var last = true
        var none = false
        fo.sh.with(fn(fl: mut &Fol) {
            match fl.bases[bi].roots.get(&tree) {
                Some(root) {
                    let st = fl.descend(root, &cursor)
                    if st.need >= 0 {
                        need = st.need
                        return
                    }
                    let n = &fl.pool[st.leaf]
                    var i = n.lower(&cursor)
                    while i < n.count() {
                        let k = n.key(i)
                        if len(to) > 0 && k >= to { break }
                        append(mut &chunk, Entry{key: k, val: n.val(i)})
                        i += 1
                    }
                    last = !st.hasUpper || (len(to) > 0 && st.upper >= to)
                    upper = st.upper
                }
                None { none = true }
            }
        })
        if none { return Ok(Unit{}) }
        if need >= 0 {
            try fo.load(need)
            continue
        }
        for e in chunk { if !f(&e) { return Ok(Unit{}) } }
        if last { return Ok(Unit{}) }
        cursor = upper
    }
    return Ok(Unit{})
}

// A value as stored in the base, as written: an escaped value without its
// mark, a large one's chunks read back (from the base's companion tree)
// and checked.
fn (fo: &Follower) unstore(bi: int, tree: int, key: &str, v: str): Result[str, lexdb_base.DbErr] {
    if !marked(&v) { return Ok(v) }
    if !isStub(&v) { return Ok(v[1..len(v)]) }
    let total = int(binary.readU64LEStr(&v, 2))
    let want = binary.readU32LEStr(&v, 10)
    let head = v[STUB_LEN..len(v)]
    var b = newStrBuf()
    b.add(&head)
    var got = len(head)
    var crc: u32 = crcOf(0, &head)
    try fo.baseScan(bi, tree + OVF, &chunkKey(key, 0), &chunkKey(key, LAST_CHUNK),
                    fn(e: &Entry): bool {
        b.add(&e.val)
        got += len(e.val)
        crc = crcOf(crc, &e.val)
        return got <= total
    })
    if got != total || int(crc) != want {
        return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "follower: a large value's chunks do not match it"))
    }
    return Ok(b.toStr())
}

// The value of key in tree as of the snapshot.
pub fn (fo: &Follower) get(s: &FSnap, tree: int, key: &str): Result[Option[str], lexdb_base.DbErr] {
    var bi = -1
    var live = false
    var kind = 0
    var vs: []str = []
    fo.sh.with(fn(f: mut &Fol) {
        bi = f.baseOf(s.ckpt)
        if bi < 0 { return }
        live = f.live(s, tree, bi)
        if live { kind = f.version(tree, key, s.batch, mut &vs) }
    })
    if bi < 0 { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "follower: the snapshot has ended")) }
    if !live || kind == 2 { return Ok(None) }
    if kind == 1 { return Ok(Some(pop(mut &vs))) }
    match try fo.baseGet(bi, tree, key) {
        Some(v) { return Ok(Some(try fo.unstore(bi, tree, key, v))) }
        None { return Ok(None) }
    }
}

// The entries of tree with keys in [from, to) (to "": to the end) as of
// the snapshot, in order, while f gives true.
// The delta's keys in [from, to) as of the snapshot, in order, each a
// value or gone; and the snapshot's base and whether the tree is there.
type DRange = record { bi: int; live: bool; keys: []str; vals: []str; gone: []bool }

fn (fo: &Follower) deltaRange(s: &FSnap, tree: int, from: &str, to: &str): DRange {
    var r = DRange{bi: -1, live: false, keys: [], vals: [], gone: []}
    fo.sh.with(fn(fl: mut &Fol) {
        r.bi = fl.baseOf(s.ckpt)
        if r.bi < 0 { return }
        r.live = fl.live(s, tree, r.bi)
        if !r.live || !fl.deltas.has(&tree) { return }
        let d = fl.deltas.at(tree)
        // each run's keys in the range, merged (the runs are sorted, and
        // hold no key twice)
        var ks: []int = []
        for run in d.runs {
            var lo = 0
            var hi = len(run)
            while lo < hi {
                let m = (lo + hi) / 2
                if d.keys[run[m]] < from { lo = m + 1 } else { hi = m }
            }
            var end = lo
            if len(to) == 0 { end = len(run) } else {
                var h = len(run)
                while end < h {
                    let m = (end + h) / 2
                    if d.keys[run[m]] < to { end = m + 1 } else { h = m }
                }
            }
            if end > lo { ks = mergeKeys(&d.keys, &ks, &run[lo..end]) }
        }
        for k in ks {
            var vs: []str = []
            let kind = versionAt(d, k, s.batch, mut &vs)
            if kind > 0 {
                append(mut &r.keys, d.keys[k])
                append(mut &r.gone, kind == 2)
                append(mut &r.vals, if kind == 1 { pop(mut &vs) } else { "" })
            }
        }
    })
    return r
}

pub fn (fo: &Follower) scan(s: &FSnap, tree: int, from: &str, to: &str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    let dr = fo.deltaRange(s, tree, from, to)
    let bi = dr.bi
    let live = dr.live
    let dkeys = &dr.keys
    let dvals = &dr.vals
    let dgone = &dr.gone
    if bi < 0 { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "follower: the snapshot has ended")) }
    if !live { return Ok(Unit{}) }
    var j = 0
    var go = true
    var bad: []lexdb_base.DbErr = []
    try fo.baseScan(bi, tree, from, to, fn(e: &Entry): bool {
        // the delta's keys before this one, then this one, its version first
        while j < len(dkeys) && dkeys[j] < e.key {
            if !dgone[j] && !f(&Entry{key: dkeys[j], val: dvals[j]}) {
                go = false
                return false
            }
            j += 1
        }
        if j < len(dkeys) && dkeys[j] == e.key {
            let gone = dgone[j]
            let v = dvals[j]
            j += 1
            if gone { return true }
            if !f(&Entry{key: e.key, val: v}) {
                go = false
                return false
            }
            return true
        }
        match fo.unstore(bi, tree, &e.key, e.val) {
            Ok(v) {
                if !f(&Entry{key: e.key, val: v}) {
                    go = false
                    return false
                }
            }
            Err(x) {
                append(mut &bad, x)
                go = false
                return false
            }
        }
        return true
    })
    if len(bad) > 0 { return Err(bad[0]) }
    while go && j < len(dkeys) {
        if !dgone[j] && !f(&Entry{key: dkeys[j], val: dvals[j]}) { return Ok(Unit{}) }
        j += 1
    }
    return Ok(Unit{})
}

pub type FStats = value record { pub applied: int; pub bases: int; pub ckpt: int; pub cached: int; pub cacheBytes: int; pub loads: int; pub evictions: int; pub freed: int; pub deltaKeys: int; pub snaps: int }

pub fn (fo: &Follower) stats(): FStats {
    var s = FStats{applied: 0, bases: 0, ckpt: -1, cached: 0, cacheBytes: 0, loads: 0, evictions: 0, freed: 0, deltaKeys: 0, snaps: 0}
    fo.sh.with(fn(f: mut &Fol) {
        var dk = 0
        for i in 0..f.deltas.size() { dk += f.deltas.valAt(i).idx.size() }
        s = FStats{applied: f.applied, bases: len(f.bases), ckpt: if len(f.bases) > 0 { f.bases[len(f.bases) - 1].ckpt } else { -1 },
                   cached: len(f.pool), cacheBytes: f.used, loads: f.loads, evictions: f.evictions, freed: f.freed, deltaKeys: dk, snaps: len(f.snaps)}
    })
    return s
}

// A descent through the base for a backward scan: the leaf holding the
// largest keys below k (k "": the last leaf), with its lower fence (the
// largest separator at or below its keys on the way).
fn (f: mut &Fol) descendBack(root: int, k: &str): Step {
    var st = Step{leaf: -1, need: -1, upper: "", hasUpper: false}
    var p = root
    while true {
        match f.at.get(&p) {
            Some(i) {
                f.refd[i] = true
                if f.pool[i].leaf {
                    st.leaf = i
                    return st
                }
                let j = if len(k) == 0 { len(f.pool[i].keys) } else { lowerIndex(&f.pool[i].keys, k) }
                if j > 0 {
                    st.upper = f.pool[i].keys[j - 1]        // here: the lower fence
                    st.hasUpper = true
                }
                p = f.pool[i].kids[j]
            }
            None {
                st.need = p
                return st
            }
        }
    }
    return st
}

// baseScan, backward: from the last key below to (to "": the end) down to
// from.
fn (fo: &Follower) baseScanBack(bi: int, tree: int, from: &str, to: &str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    var cursor = lexdb_base.own(to)
    while true {
        var need = -1
        var chunk: []Entry = []
        var fence = ""
        var last = true
        var none = false
        fo.sh.with(fn(fl: mut &Fol) {
            match fl.bases[bi].roots.get(&tree) {
                Some(root) {
                    let st = fl.descendBack(root, &cursor)
                    if st.need >= 0 {
                        need = st.need
                        return
                    }
                    let n = &fl.pool[st.leaf]
                    var i = if len(cursor) == 0 { n.count() } else { n.lower(&cursor) }
                    while i > 0 {
                        i -= 1
                        let k = n.key(i)
                        if k < from { break }
                        append(mut &chunk, Entry{key: k, val: n.val(i)})
                    }
                    last = !st.hasUpper || st.upper <= from
                    fence = st.upper
                }
                None { none = true }
            }
        })
        if none { return Ok(Unit{}) }
        if need >= 0 {
            try fo.load(need)
            continue
        }
        for e in chunk { if !f(&e) { return Ok(Unit{}) } }
        if last { return Ok(Unit{}) }
        cursor = fence
    }
    return Ok(Unit{})
}

// scan, backward: the entries of tree with keys in [from, to) as of the
// snapshot, from the last down, while f gives true.
pub fn (fo: &Follower) scanBack(s: &FSnap, tree: int, from: &str, to: &str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    let dr = fo.deltaRange(s, tree, from, to)
    if dr.bi < 0 { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "follower: the snapshot has ended")) }
    if !dr.live { return Ok(Unit{}) }
    let bi = dr.bi
    var j = len(dr.keys) - 1
    var go = true
    var bad: []lexdb_base.DbErr = []
    try fo.baseScanBack(bi, tree, from, to, fn(e: &Entry): bool {
        // the delta's keys after this one, then this one, its version first
        while j >= 0 && dr.keys[j] > e.key {
            if !dr.gone[j] && !f(&Entry{key: dr.keys[j], val: dr.vals[j]}) {
                go = false
                return false
            }
            j -= 1
        }
        if j >= 0 && dr.keys[j] == e.key {
            let gone = dr.gone[j]
            let v = dr.vals[j]
            j -= 1
            if gone { return true }
            if !f(&Entry{key: e.key, val: v}) {
                go = false
                return false
            }
            return true
        }
        match fo.unstore(bi, tree, &e.key, e.val) {
            Ok(v) {
                if !f(&Entry{key: e.key, val: v}) {
                    go = false
                    return false
                }
            }
            Err(x) {
                append(mut &bad, x)
                go = false
                return false
            }
        }
        return true
    })
    if len(bad) > 0 { return Err(bad[0]) }
    while go && j >= 0 {
        if !dr.gone[j] && !f(&Entry{key: dr.keys[j], val: dr.vals[j]}) { return Ok(Unit{}) }
        j -= 1
    }
    return Ok(Unit{})
}

// The trees there as of the last batch applied (tree ids, no companions).
pub fn (fo: &Follower) trees(): []int {
    var out: []int = []
    fo.sh.with(fn(f: mut &Fol) {
        if len(f.bases) == 0 { return }
        let s = FSnap{id: -1, batch: f.applied, ckpt: f.bases[len(f.bases) - 1].ckpt}
        let bi = len(f.bases) - 1
        var ids: []int = []
        for i in 0..f.bases[bi].roots.size() {
            let id: int = f.bases[bi].roots.keyAt(i)
            append(mut &ids, id)
        }
        for i in 0..f.life.size() {
            let id: int = f.life.keyAt(i)
            if !f.bases[bi].roots.has(&id) { append(mut &ids, id) }
        }
        for id in ids { if !isOvf(id) && f.live(&s, id, bi) { append(mut &out, id) } }
    })
    return out
}

// Counts the writes applied to tree from now on (changes): Store.watch.
pub fn (fo: &Follower) watch(tree: int) {
    fo.sh.with(fn(f: mut &Fol) {
        f.watched = tree
        f.watchedWrites = 0
    })
}

pub fn (fo: &Follower) changes(): int {
    var n = 0
    fo.sh.with(fn(f: mut &Fol) { n = f.watchedWrites })
    return n
}

// ==== a replica's store (design/lexdb.md 9.72)

// A store that reads through a follower of the master that link names, in
// the data directory fs: the SQL layer runs on it as on the master's, and
// its writes fail (25006, read_only_sql_transaction). It is ready once the
// follower is (Follower.ready); poll applies the master's batches.
pub fn openReplica(fs: lexdb_disk.Fs, opts: Options, link: Link): Result[Store, lexdb_base.DbErr] {
    return openReplicaIn(fs, fs, false, opts, link)
}

// openReplica of a master whose log is in logFs (--log-dir): the same check as the master's.
pub fn openReplicaSplit(fs: lexdb_disk.Fs, logFs: lexdb_disk.Fs, opts: Options, link: Link): Result[Store, lexdb_base.DbErr] {
    return openReplicaIn(fs, logFs, true, opts, link)
}

fn openReplicaIn(fs: lexdb_disk.Fs, logFs: lexdb_disk.Fs, split: bool, opts: Options, link: Link): Result[Store, lexdb_base.DbErr] {
    try checkLog(&fs, &logFs, split, false)
    let fo = try openFollowerHow(link, fs, logFs, opts.cacheBytes)
    // the Db keeps what the SQL layer keeps (the memo) and the counters
    let m = lexdb_page.Meta{ckpt: 0, npages: 2, roots: 0, free: 0, replaySeg: 1, replayOff: 0, replayBatch: 1, nextTree: 1,
                            dropped: 0, runs: 0, covers: -1}
    let db = newDb(fs, logFs, lexdb_disk.File.Real(-1, false), opts, &m)
    return Ok(Store{sh: task.shared(db), fo: Some(fo)})
}

pub fn (st: &Store) isReplica(): bool { return st.fo.isSome() }

// A replica's follower.
pub fn (st: &Store) follower(): Option[Follower] { return st.fo }

// A replica transaction's follower snapshot. Dropping it ends the
// snapshot: the SQL layer drops some transactions without ending them (a
// prepared statement's Describe reads the catalog in one), harmless on the
// master, whose plain transactions read the live trees and pin nothing; on
// a replica every read pins a base, and one never let go keeps the master's
// pages and log held, and the delta growing.
type RepPin = record { fo: Follower; s: FSnap }

fn (p: mut &RepPin) drop() { p.fo.end(&p.s) }

// The transaction's follower snapshot, taken at its first read.
fn repSnap(fo: &Follower, t: mut &Txn): Result[FSnap, lexdb_base.DbErr] {
    if len(t.fsnap) == 0 { append(mut &t.fsnap, RepPin{fo: fo, s: try fo.begin()}) }
    return Ok(t.fsnap[0].s)
}

pub fn readOnly(what: &str): lexdb_base.DbErr {
    return lexdb_base.err(lexdb_base.S_READ_ONLY, "cannot execute " + what + " in a read-only transaction")
}

// A replica transaction's end: its snapshot ends; one with writes fails.
fn (st: &Store) repEnd(t: &Txn): Result[Unit, lexdb_base.DbErr] {
    st.endSnapshot(t)
    if len(t.writes) > 0 { return Err(readOnly(&"a write on a replica")) }
    return Ok(Unit{})
}
