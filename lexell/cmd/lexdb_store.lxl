// lexdb: the store. Copy-on-write B+trees of byte keys and values, a node
// cache, optimistic transactions checked by leaf versions, a log of
// committed rows with group commit, checkpoints and recovery
// (design/lexdb.md section 4, stages D1 and D2).
//
// All of the store's state is one Db in a task.Shared. Everything that
// changes it runs inside `with`, which cannot park, so no other task can see
// it half done; every read, write and flush of a file runs outside `with`.
// A descent that meets a node not in memory leaves `with` with the slot it
// needs, loads the page, installs it in another `with`, and starts again
// from the root: what it saw before the park may have changed.
//
// Nodes live in a table of slots. A slot keeps its number while its node is
// evicted and loaded again; a page number is where the node was last
// written. A node that changes after a checkpoint wrote it is dirty, and the
// next checkpoint writes it to a new page (copy on write): its old page is
// freed once that checkpoint's meta page is durable.
import "task"
import "binary"
import "collections"
import "./lexdb_base"
import "./lexdb_disk"
import "./lexdb_page"

pub const DATA = "data.lxdb"
const SPARE = "log.spare"
const PAGE = 4096
const LOG_MAGIC = 0x4C474C58
const FRAME_HDR = 32

pub const OP_PUT = 1
pub const OP_DEL = 2
pub const OP_CREATE = 3
pub const OP_DROP = 4

fn segName(g: int): str { return "log." + g.toStr() }

pub type Options = value record {
    pub cacheBytes: int     // about the memory nodes take before clean ones are evicted (lexdb_page.nodeCost)
    pub segBytes: int       // the size of a log segment
    pub ckptBytes: int      // log bytes after which the checkpointer runs (an eighth when the cache is full)
    pub snapNodes: int      // old node versions kept for snapshots before the oldest is cancelled
}

pub fn defaults(): Options {
    return Options{cacheBytes: 128 * 1024 * 1024, segBytes: 64 * 1024 * 1024, ckptBytes: 32 * 1024 * 1024, snapNodes: 50000}
}

type SlotMeta = value record {
    used: bool
    gen: int            // changes when the slot is freed, so stale references are seen
    loaded: bool
    dirty: bool
    root: bool
    disk: int           // the page it was last written to, -1 when none
    ckpt: int           // the checkpoint that wrote that page
    version: int        // changes with every change to the node (leaf versions: 4.4)
    ref: bool           // clock bit
    since: int          // the commit (seq) that made the node's current version
    pinned: bool        // freed, but a snapshot may still reach it: kept until it ends
    cost: int           // loaded: what it counts against the cache (lexdb_page.nodeCost)
    listed: bool        // in Db.histSlots
    frame: int          // loaded: its node, pool[frame]; -1 when not (a slot not in memory holds no node)
}

// An old version of a node, kept while a snapshot can see it: the commits
// [since, until) saw it.
type Hist = record { since: int; until: int; node: lexdb_page.Node }

// A live snapshot: it sees the store as it was after commit seq.
type Snap = value record { id: int; seq: int; cancelled: bool }

type Deferred = value record { slot: int; seq: int }

// A tree's root changed by commit seq (prev: the root before, -1 none): a
// snapshot at an earlier commit starts from prev.
type RootChange = value record { seq: int; tree: int; prev: int }

type Waiter = record { batch: int; p: task.Promise[Result[Unit, lexdb_base.DbErr]] }

// A page a checkpoint writes: a node's body (the node's own string since
// repack, so the pages waiting take no memory of their own; the page is
// made as it is written), or a list page's bytes.
type PageOut = record { no: int; leaf: bool; n: int; body: str; raw: []byte }

pub type Db = record {
    opts: Options
    fs: lexdb_disk.Fs
    data: lexdb_disk.File
    watched: int                // a tree whose writes are counted (watch), -1 none
    watchedWrites: int
    pool: []lexdb_page.Node     // the nodes in memory, one per loaded slot (SlotMeta.frame)
    owner: []int                // the slot of each node in pool
    meta: []SlotMeta
    freeSlots: []int
    loadedCount: int
    cacheUsed: int              // the loaded nodes' costs
    wlog: []WEntry              // the writes of recent commits, in commit order (validate)
    wlogFloor: int              // reads before this commit can no longer be checked
    hand: int
    trees: Map[int, int]        // tree id -> root slot
    nextTree: int
    npages: int
    free: []int                 // pages free now
    freeAfterNext: []int        // pages the next checkpoint frees
    pendingFree: []int          // pages the checkpoint in flight frees when durable
    listPages: []int            // the list pages of the last durable checkpoint
    ckpt: int
    durableCkpt: int
    ckptRunning: bool
    batch: []byte               // the records of the open batch
    batchCount: int
    batchNo: int                // the open batch's number
    appliedBatch: int           // the highest batch with an applied commit
    durableBatch: int
    waiters: []Waiter
    writerWake: []task.Promise[Unit]
    ckptWake: []task.Promise[Unit]
    ckptDone: []task.Promise[Unit]  // commits held while the cache is over twice its budget (see commit)
    seg: int                    // the end of the durable log
    segOff: int
    logSinceCkpt: int
    failed: []lexdb_base.DbErr  // one element once a write or flush has failed
    closing: bool
    seq: int                    // commits applied
    snaps: []Snap
    nextSnap: int
    hist: [][]Hist              // per slot
    histCount: int
    histSlots: []int            // the slots with old versions
    deferred: []Deferred        // slots freed while a snapshot may reach them
    rootHist: []RootChange      // root changes a snapshot may still need
    durableSeq: int             // the last commit the log holds: snapshots read as of it
    // counters
    pub snapshots: int
    pub tooOld: int
    pub commits: int
    pub conflicts: int
    pub loads: int
    pub evictions: int
    pub flushes: int
    pub checkpoints: int
    pub held: int               // commits held for a checkpoint (the cache over twice its budget)
}

// A handle to an open store; copies reach the same store.
pub type Store = value record { sh: task.Shared[Db] }

// A read mark: a leaf seen at a version (4.4).
// A leaf a transaction read: its slot as it was then, and its page if it
// was clean (the slot may be dropped meanwhile, its parent evicted: the
// page, unless freed since, still holds what was read) with the commit
// the read saw.
// A read, for its transaction's commit check: the keys [lo, hi) of a tree
// (hi "": to the end), as of commit seq. Per key, not per leaf: a commit
// fails only when a write committed after the read falls in its range
// (9.19), so writes to other rows of the same leaf no longer conflict, and
// a range read sees an insert into it (no phantoms).
type Mark = value record { tree: int; lo: str; hi: str; seq: int }

// A committed write, kept for the commit checks (Db.wlog): all, a dropped
// tree (every key).
type WEntry = value record { seq: int; tree: int; key: str; all: bool }

// The writes kept: past this many, the older half goes, and a transaction
// whose read is older than what is kept fails its check (a conflict).
var WLOG_MAX: int = 131072

// For the tests: keeps fewer writes.
pub fn setWriteLogMax(n: int) { WLOG_MAX = n }

type TxWrite = value record { op: int; tree: int; key: str; val: str }

pub type Txn = record {
    reads: []Mark
    writes: []TxWrite
    index: Map[str, int]        // tree:key -> the last write of it
    created: []int
    snap: int                   // its reads' snapshot's id, -1 for none (reads of the live tree)
    snapSeq: int
    snapTrees: Map[int, int]    // the tree roots as the snapshot sees them
    track: bool                 // a snapshot's reads are noted (Mark) for its writes' commit: a transaction block
    pub live: bool              // a block's reads go to the live tree for now (its UPDATE and DELETE: 9.16)
    pub path: []str             // the SQL layer's search path for its names (lexdb_exec); [] the default
}

pub fn begin(): Txn {
    return Txn{reads: [], writes: [], index: newMap(), created: [], snap: -1, snapSeq: 0, snapTrees: newMap(), track: false, live: false, path: []}
}

pub fn (t: &Txn) isSnapshot(): bool { return t.snap >= 0 }

// Notes a read of [lo, hi) of tree as of commit seq; one adjacent to the
// last (a scan's next leaf) extends it.
fn (t: mut &Txn) noteRead(tree: int, lo: str, hi: str, seq: int) {
    let n = len(t.reads)
    if n > 0 {
        let p = t.reads[n - 1]
        if p.tree == tree && p.seq == seq && p.hi == lo && len(lo) > 0 {
            t.reads[n - 1].hi = hi
            return
        }
        if p.tree == tree && p.seq == seq && p.lo == hi && len(hi) > 0 {
            t.reads[n - 1].lo = lo
            return
        }
    }
    append(mut &t.reads, Mark{tree: tree, lo: lo, hi: hi, seq: seq})
}

// Whether the transaction's reads are noted: a live transaction's, and a
// block's (a read-only snapshot's are not).
fn (t: &Txn) noting(): bool { return t.snap < 0 || t.live || t.track }

fn wkey(tree: int, key: &str): str { return tree.toStr() + ":" + key }

pub fn (t: mut &Txn) put(tree: int, key: str, val: str): Result[Unit, lexdb_base.DbErr] {
    if len(key) > lexdb_page.MAX_KEY || lexdb_page.leafEntry(&key, &val) > lexdb_page.MAX_ENTRY {
        return Err(lexdb_base.err(lexdb_base.S_LIMIT, "row too large: a key and value take at most " +
                                  lexdb_page.MAX_ENTRY.toStr() + " bytes (key at most " + lexdb_page.MAX_KEY.toStr() + ")"))
    }
    t.index.put(wkey(tree, &key), len(t.writes))
    append(mut &t.writes, TxWrite{op: OP_PUT, tree: tree, key: key, val: val})
    return Ok(Unit{})
}

pub fn (t: mut &Txn) del(tree: int, key: str) {
    t.index.put(wkey(tree, &key), len(t.writes))
    append(mut &t.writes, TxWrite{op: OP_DEL, tree: tree, key: key, val: ""})
}

pub fn (t: mut &Txn) dropTree(tree: int) {
    append(mut &t.writes, TxWrite{op: OP_DROP, tree: tree, key: "", val: ""})
}

pub fn (t: &Txn) hasWrites(): bool { return len(t.writes) > 0 }

// ---- slots and the cache

fn (db: mut &Db) allocSlot(): int {
    if len(db.freeSlots) > 0 {
        let s = pop(mut &db.freeSlots)
        db.meta[s].used = true
        db.meta[s].loaded = false
        db.meta[s].dirty = false
        db.meta[s].root = false
        db.meta[s].disk = -1
        db.meta[s].ckpt = 0
        db.meta[s].version = 0
        db.meta[s].ref = false
        db.meta[s].since = 0
        db.meta[s].pinned = false
        db.meta[s].cost = 0
        return s
    }
    append(mut &db.meta, SlotMeta{used: true, gen: 0, loaded: false, dirty: false, root: false, disk: -1,
                                  ckpt: 0, version: 0, ref: false, since: 0, pinned: false, cost: 0,
                                  listed: false, frame: -1})
    append(mut &db.hist, [])
    return len(db.meta) - 1
}

// Gives slot s node n, in a frame of the pool (its own, or a new one).
fn (db: mut &Db) setNode(s: int, n: lexdb_page.Node) {
    let f = db.meta[s].frame
    if f >= 0 {
        db.pool[f] = n
        return
    }
    db.meta[s].frame = len(db.pool)
    append(mut &db.pool, n)
    append(mut &db.owner, s)
}

// Takes slot s's node out of memory: the pool's last node moves into its
// frame, so the pool holds loaded nodes only.
fn (db: mut &Db) freeNode(s: int) {
    let f = db.meta[s].frame
    if f < 0 { return }
    db.meta[s].frame = -1
    let last = len(db.pool) - 1
    let n = pop(mut &db.pool)
    let o = pop(mut &db.owner)
    if f < last {
        db.pool[f] = n
        db.owner[f] = o
        db.meta[o].frame = f
    }
}

// A new node in memory, dirty.
fn (db: mut &Db) newNode(n: lexdb_page.Node): int {
    let s = db.allocSlot()
    db.setNode(s, n)
    db.meta[s].loaded = true
    db.meta[s].dirty = true
    db.meta[s].since = db.seq
    db.loadedCount += 1
    db.recost(s)
    return s
}

// Counts node s's memory again after it changed (a loaded node).
fn (db: mut &Db) recost(s: int) {
    if !db.meta[s].loaded { return }
    let c = lexdb_page.nodeCost(&db.pool[db.meta[s].frame])
    db.cacheUsed += c - db.meta[s].cost
    db.meta[s].cost = c
}

fn (db: mut &Db) uncost(s: int) {
    db.cacheUsed -= db.meta[s].cost
    db.meta[s].cost = 0
}

// The highest commit a live snapshot sees, or -1.
fn (db: &Db) maxSnap(): int {
    var m = -1
    for sn in db.snaps { if !sn.cancelled && sn.seq > m { m = sn.seq } }
    return m
}

// Frees a slot the tree no longer reaches; while a snapshot may still reach
// it (it sees a version the slot holds), the slot is kept until then.
fn (db: mut &Db) freeSlot(s: int) {
    if (db.seq > db.durableSeq || db.maxSnap() >= 0) && !db.meta[s].pinned {
        db.meta[s].pinned = true
        append(mut &db.deferred, Deferred{slot: s, seq: db.seq})
        return
    }
    db.releaseSlot(s)
}

fn (db: mut &Db) releaseSlot(s: int) {
    if db.meta[s].disk >= 0 { db.freePage(db.meta[s].disk) }
    db.dropSlot(s)
}

// A node's page no longer the tree's (the node changed or left): free after
// the next checkpoint.
fn (db: mut &Db) freePage(p: int) {
    append(mut &db.freeAfterNext, p)
}

// Frees slot s, its page kept: the slot of a child of a node being evicted
// (the page is still the tree's, named by the parent's page).
fn (db: mut &Db) dropSlot(s: int) {
    db.meta[s].pinned = false
    if len(db.hist[s]) > 0 {
        db.histCount -= len(db.hist[s])
        db.hist[s] = []
    }
    if db.meta[s].loaded {
        db.loadedCount -= 1
        db.uncost(s)
        db.freeNode(s)
    }
    db.meta[s].used = false
    db.meta[s].gen += 1
    db.meta[s].loaded = false
    db.meta[s].dirty = false
    db.meta[s].disk = -1
    append(mut &db.freeSlots, s)
}

// Marks a node changed: its page belongs to the last checkpoint, and the
// next one writes it elsewhere and frees that page.
fn (db: mut &Db) markDirty(s: int) {
    if !db.meta[s].dirty {
        db.meta[s].dirty = true
        if db.meta[s].disk >= 0 { db.freePage(db.meta[s].disk) }
        db.meta[s].disk = -1
    }
}

fn copyNode(n: &lexdb_page.Node): lexdb_page.Node {
    var c = lexdb_page.Node{leaf: n.leaf, keys: [], vals: [], kids: [], size: n.size, packed: false}
    for k in n.keys { append(mut &c.keys, k) }
    for v in n.vals { append(mut &c.vals, v) }
    for k in n.kids { append(mut &c.kids, k) }
    return c
}

// Called before a commit changes node s's contents: its current version is
// kept while a snapshot may read it (4.5): one that is live, or one that
// begins before this commit is durable (snapshots read as of the last
// durable commit, so readers never wait for the log: 9.16).
fn (db: mut &Db) willChange(s: int) {
    if db.meta[s].since == db.seq { return }
    if (db.seq > db.durableSeq || db.maxSnap() >= db.meta[s].since) && db.meta[s].loaded {
        if !db.meta[s].listed {
            append(mut &db.histSlots, s)
            db.meta[s].listed = true
        }
        append(mut &db.hist[s], Hist{since: db.meta[s].since, until: db.seq, node: copyNode(&db.pool[db.meta[s].frame])})
        db.histCount += 1
    }
    db.meta[s].since = db.seq
}

// Drops the old versions, kept slots and root changes no snapshot needs: a
// live one, or one that may begin (as of a commit from durableSeq on).
fn (db: mut &Db) prune() {
    var live: []int = []
    for sn in db.snaps { if !sn.cancelled { append(mut &live, sn.seq) } }
    var roots: []RootChange = []
    for rc in replace(mut &db.rootHist, []) {
        var need = rc.seq > db.durableSeq
        for q in live { if q < rc.seq { need = true } }
        if need { append(mut &roots, rc) }
    }
    db.rootHist = roots
    var keepSlots: []int = []
    for s in replace(mut &db.histSlots, []) {
        db.meta[s].listed = false
        var kept: []Hist = []
        var old = replace(mut &db.hist[s], [])
        while len(old) > 0 {
            let h = pop(mut &old)
            var need = h.until > db.durableSeq
            for q in live { if h.since <= q && q < h.until { need = true } }
            if need { append(mut &kept, h) } else { db.histCount -= 1 }
        }
        if len(kept) > 0 {
            db.hist[s] = kept
            append(mut &keepSlots, s)
            db.meta[s].listed = true
        }
    }
    db.histSlots = keepSlots
    var still: []Deferred = []
    for d in replace(mut &db.deferred, []) {
        var need = d.seq > db.durableSeq
        for q in live { if q < d.seq { need = true } }
        if need { append(mut &still, d) } else { db.releaseSlot(d.slot) }
    }
    db.deferred = still
}

// Whether slot s could be evicted, but for its children (kidsOut).
fn (db: &Db) evictable(s: int): bool {
    let m = &db.meta[s]
    if !m.used || !m.loaded || m.dirty || m.root || m.ckpt > db.durableCkpt || m.disk < 0 { return false }
    return !m.pinned && len(db.hist[s]) == 0
}

// Whether none of an inner node's children is in memory (a leaf: true).
fn (db: &Db) kidsOut(s: int): bool {
    if !db.pool[db.meta[s].frame].leaf {
        for k in db.pool[db.meta[s].frame].kids { if db.meta[k].loaded { return false } }
    }
    return true
}

// Evicts clean nodes, clock order, while more than the cache's size are in
// memory. A node is evicted only after its children (they hang from it).
// One sweep at most: a node referenced since the last sweep survives this
// one, so a commit that needs many paths in memory at once (every descent
// marks its path) never loses them while it loads the rest; the cache
// then holds more than its size for a while.
fn (db: mut &Db) maybeEvict() {
    var tries = 0
    while db.cacheUsed > db.opts.cacheBytes && tries < len(db.meta) {
        tries += 1
        db.hand += 1
        if db.hand >= len(db.meta) { db.hand = 0 }
        let s = db.hand
        if !db.evictable(s) { continue }
        // the reference bit first: an inner node on a path in use is almost
        // always referenced, and its children's scan was 8% of a read
        if db.meta[s].ref {
            db.meta[s].ref = false
            continue
        }
        if !db.kidsOut(s) { continue }
        if !db.pool[db.meta[s].frame].leaf {
            var kids: []int = []
            for k in db.pool[db.meta[s].frame].kids { append(mut &kids, k) }
            for k in kids { db.dropSlot(k) }
        }
        db.uncost(s)
        db.freeNode(s)
        db.meta[s].loaded = false
        db.loadedCount -= 1
        db.evictions += 1
    }
}

// What a load needs, read inside with: the page and the slot's generation.
type LoadReq = value record { slot: int; gen: int; page: int }

fn (db: &Db) loadReq(s: int): LoadReq {
    return LoadReq{slot: s, gen: db.meta[s].gen, page: db.meta[s].disk}
}

// Installs a page read for a slot, unless the slot changed meanwhile.
fn (db: mut &Db) install(r: LoadReq, b: &[]byte): Result[Unit, lexdb_base.DbErr] {
    let s = r.slot
    if !db.meta[s].used || db.meta[s].gen != r.gen || db.meta[s].loaded || db.meta[s].disk != r.page {
        return Ok(Unit{})
    }
    try lexdb_page.check(b, r.page, lexdb_page.T_LEAF)
    var n = lexdb_page.decodeNode(b)
    if !n.leaf {
        for i in 0..len(n.kids) {
            let k = db.allocSlot()
            db.meta[k].disk = n.kids[i]
            db.meta[k].ckpt = db.meta[s].ckpt
            n.kids[i] = k
        }
    }
    db.setNode(s, n)
    db.meta[s].loaded = true
    db.meta[s].ref = true
    db.loadedCount += 1
    db.recost(s)
    db.loads += 1
    db.maybeEvict()
    return Ok(Unit{})
}

// Loads the page of a slot that is not in memory (parks).
fn (st: &Store) load(slot: int): Result[Unit, lexdb_base.DbErr] {
    var r = LoadReq{slot: 0, gen: 0, page: -1}
    var f = lexdb_disk.File.Real(-1)
    st.sh.with(fn(db: mut &Db) {
        r = db.loadReq(slot)
        f = db.data
    })
    if r.page < 0 { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "load: a slot without a page")) }
    var b = array(PAGE, byte(0))
    try f.read(r.page * PAGE, mut &b[0..PAGE], PAGE)
    var res: Result[Unit, lexdb_base.DbErr] = Ok(Unit{})
    st.sh.with(fn(db: mut &Db) { res = db.install(r, &b) })
    return res
}

// ---- descending

// The number of keys <= k: the child to follow.
fn childIndex(keys: &[]str, k: &str): int {
    var lo = 0
    var hi = len(keys)
    while lo < hi {
        let mid = (lo + hi) / 2
        if keys[mid] <= k { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

// The first index whose key is >= k.
fn lowerIndex(keys: &[]str, k: &str): int {
    var lo = 0
    var hi = len(keys)
    while lo < hi {
        let mid = (lo + hi) / 2
        if keys[mid] < k { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

// A descent: the path from the root to the leaf for a key, or the slot to
// load first (need >= 0). upper is the smallest separator above the key on
// the path: the leaf holds no key >= it.
type Descent = record {
    path: []int
    need: int
    upper: str
    hasUpper: bool
}

fn (db: mut &Db) descend(tree: int, k: &str): Descent {
    var d = Descent{path: [], need: -1, upper: "", hasUpper: false}
    var s = match db.trees.get(&tree) { Some(r) { r } None { -1 } }
    if s < 0 { return d }
    while true {
        if !db.meta[s].loaded {
            d.need = s
            return d
        }
        db.meta[s].ref = true
        append(mut &d.path, s)
        if db.pool[db.meta[s].frame].leaf { return d }
        let i = childIndex(&db.pool[db.meta[s].frame].keys, k)
        if i < len(db.pool[db.meta[s].frame].keys) {
            d.upper = db.pool[db.meta[s].frame].keys[i]
            d.hasUpper = true
        }
        s = db.pool[db.meta[s].frame].kids[i]
    }
    return d
}

// ---- changing a tree (inside with; every node on the path is in memory)

fn nodeSize(n: &lexdb_page.Node): int {
    var size = 0
    if n.leaf {
        for i in 0..len(n.keys) { size += lexdb_page.leafEntry(&n.keys[i], &n.vals[i]) }
    } else {
        size = 8
        for k in n.keys { size += lexdb_page.kidEntry(&k) }
    }
    return size
}

// Splits an oversized node; the new right node's slot and separator.
fn (db: mut &Db) split(s: int, atEnd: bool): Descent {
    db.willChange(s)
    let leaf = db.pool[db.meta[s].frame].leaf
    let total = db.pool[db.meta[s].frame].size
    let n = len(db.pool[db.meta[s].frame].keys)
    var right = lexdb_page.Node{leaf: leaf, keys: [], vals: [], kids: [], size: 0, packed: false}
    var sep = ""
    if leaf {
        var acc = 0
        var m = 0
        while m < n - 1 {
            let e = lexdb_page.leafEntry(&db.pool[db.meta[s].frame].keys[m], &db.pool[db.meta[s].frame].vals[m])
            if m > 0 && acc + e > total / 2 { break }
            acc += e
            m += 1
        }
        if atEnd && n >= 2 { m = n - 1 }        // the left stays full: only the new entry goes right
        for i in m..n {
            append(mut &right.keys, db.pool[db.meta[s].frame].keys[i])
            append(mut &right.vals, db.pool[db.meta[s].frame].vals[i])
        }
        for i in m..n {
            let k = pop(mut &db.pool[db.meta[s].frame].keys)
            let v = pop(mut &db.pool[db.meta[s].frame].vals)
        }
        sep = lexdb_base.own(&right.keys[0])
    } else {
        var acc = 8
        var m = 1
        while m < n - 1 {
            let e = lexdb_page.kidEntry(&db.pool[db.meta[s].frame].keys[m - 1])
            if acc + e > total / 2 { break }
            acc += e
            m += 1
        }
        if atEnd && n >= 3 { m = n - 2 }        // the left stays full: the last two children go right
        // keys[m] goes up; keys after it and kids after m go right
        sep = lexdb_base.own(&db.pool[db.meta[s].frame].keys[m])
        for i in m + 1..n { append(mut &right.keys, db.pool[db.meta[s].frame].keys[i]) }
        for i in m + 1..n + 1 { append(mut &right.kids, db.pool[db.meta[s].frame].kids[i]) }
        for i in m..n {
            let k = pop(mut &db.pool[db.meta[s].frame].keys)
            let c = pop(mut &db.pool[db.meta[s].frame].kids)
        }
    }
    db.pool[db.meta[s].frame].size = nodeSize(&db.pool[db.meta[s].frame])
    right.size = nodeSize(&right)
    db.meta[s].version += 1
    db.pool[db.meta[s].frame].packed = false
    db.recost(s)
    let r = db.newNode(right)
    return Descent{path: [r], need: -1, upper: sep, hasUpper: true}
}

// After path[j] grew past a page, split it and the parents that overflow
// in turn; a split root gets a new root above it.
fn (db: mut &Db) fixOverflow(tree: int, path: &[]int, from: int, atEnd: bool) {
    var j = from
    var end = atEnd
    while j >= 0 {
        let s = path[j]
        if db.pool[db.meta[s].frame].size <= lexdb_page.NODE_ROOM { return }
        let sp = db.split(s, end)
        let r = sp.path[0]
        if j == 0 {
            let root = lexdb_page.Node{leaf: false, keys: [sp.upper], vals: [], kids: [s, r], size: 0, packed: false}
            var rn = root
            rn.size = nodeSize(&rn)
            let ns = db.newNode(rn)
            db.meta[s].root = false
            db.meta[ns].root = true
            db.recost(s)
            db.setRoot(tree, ns)
            return
        }
        let p = path[j - 1]
        db.willChange(p)
        var at = 0
        while db.pool[db.meta[p].frame].kids[at] != s { at += 1 }
        collections.insert(mut &db.pool[db.meta[p].frame].keys, at, sp.upper)
        collections.insert(mut &db.pool[db.meta[p].frame].kids, at + 1, r)
        end = end && at + 2 == len(db.pool[db.meta[p].frame].kids)     // the new child is the parent's last
        db.pool[db.meta[p].frame].size += lexdb_page.kidEntry(&sp.upper)
        db.meta[p].version += 1
        db.pool[db.meta[p].frame].packed = false
        db.recost(p)
        j -= 1
    }
}

fn (db: mut &Db) applyPut(tree: int, key: &str, val: &str) {
    let d = db.descend(tree, key)
    if len(d.path) == 0 { return }       // no such tree (recovery replays a dropped tree's rows)
    for s in d.path { db.markDirty(s) }
    let leaf = d.path[len(d.path) - 1]
    db.willChange(leaf)
    let i = lowerIndex(&db.pool[db.meta[leaf].frame].keys, key)
    // A key past every key in the tree (the rightmost leaf, at its end): an
    // ascending load. Its splits leave the left node full, not half (as
    // PostgreSQL's rightmost split and SQLite's quick balance do): a table
    // loaded in key order then takes half the pages.
    let atEnd = !d.hasUpper && i == len(db.pool[db.meta[leaf].frame].keys)
    if i < len(db.pool[db.meta[leaf].frame].keys) && db.pool[db.meta[leaf].frame].keys[i] == key {
        db.pool[db.meta[leaf].frame].size += len(val) - len(db.pool[db.meta[leaf].frame].vals[i])
        db.pool[db.meta[leaf].frame].vals[i] = val
    } else {
        collections.insert(mut &db.pool[db.meta[leaf].frame].keys, i, key)
        collections.insert(mut &db.pool[db.meta[leaf].frame].vals, i, val)
        db.pool[db.meta[leaf].frame].size += lexdb_page.leafEntry(key, val)
    }
    db.meta[leaf].version += 1
    db.pool[db.meta[leaf].frame].packed = false
    db.recost(leaf)
    db.fixOverflow(tree, &d.path, len(d.path) - 1, atEnd)
}

fn (db: mut &Db) applyDel(tree: int, key: &str) {
    let d = db.descend(tree, key)
    if len(d.path) == 0 { return }
    let leaf = d.path[len(d.path) - 1]
    let i = lowerIndex(&db.pool[db.meta[leaf].frame].keys, key)
    if i >= len(db.pool[db.meta[leaf].frame].keys) || db.pool[db.meta[leaf].frame].keys[i] != key { return }
    for s in d.path { db.markDirty(s) }
    db.willChange(leaf)
    db.pool[db.meta[leaf].frame].size -= lexdb_page.leafEntry(&db.pool[db.meta[leaf].frame].keys[i], &db.pool[db.meta[leaf].frame].vals[i])
    let k = collections.removeAt(mut &db.pool[db.meta[leaf].frame].keys, i)
    let v = collections.removeAt(mut &db.pool[db.meta[leaf].frame].vals, i)
    db.meta[leaf].version += 1
    db.pool[db.meta[leaf].frame].packed = false
    db.recost(leaf)
    // An empty node leaves its parent (no merging: design/lexdb.md 4.2).
    var j = len(d.path) - 1
    while j > 0 {
        let c = d.path[j]
        let empty = if db.pool[db.meta[c].frame].leaf { len(db.pool[db.meta[c].frame].keys) == 0 } else { len(db.pool[db.meta[c].frame].kids) == 0 }
        if !empty { break }
        let p = d.path[j - 1]
        db.willChange(p)
        var at = 0
        while db.pool[db.meta[p].frame].kids[at] != c { at += 1 }
        let gone = collections.removeAt(mut &db.pool[db.meta[p].frame].kids, at)
        if len(db.pool[db.meta[p].frame].keys) > 0 {
            let ki = if at == 0 { 0 } else { at - 1 }
            let sk = collections.removeAt(mut &db.pool[db.meta[p].frame].keys, ki)
        }
        db.pool[db.meta[p].frame].size = nodeSize(&db.pool[db.meta[p].frame])
        db.meta[p].version += 1
        db.pool[db.meta[p].frame].packed = false
        db.recost(p)
        db.freeSlot(c)
        j -= 1
    }
    // The root: an internal root with no children becomes an empty leaf, and
    // one with a single child in memory gives way to it.
    var root = d.path[0]
    if !db.pool[db.meta[root].frame].leaf && len(db.pool[db.meta[root].frame].kids) == 0 {
        db.willChange(root)
        db.setNode(root, lexdb_page.newLeaf())
        db.meta[root].version += 1
        db.recost(root)
    }
    while !db.pool[db.meta[root].frame].leaf && len(db.pool[db.meta[root].frame].kids) == 1 && db.meta[db.pool[db.meta[root].frame].kids[0]].loaded {
        let only = db.pool[db.meta[root].frame].kids[0]
        db.markDirty(only)
        db.meta[only].root = true
        db.setRoot(tree, only)
        db.meta[root].root = false
        db.freeSlot(root)
        root = only
    }
}

// Sets (slot >= 0) or removes a tree's root, noting the change for snapshots.
fn (db: mut &Db) setRoot(tree: int, slot: int) {
    let prev = match db.trees.get(&tree) { Some(x) { x } None { -1 } }
    if db.seq > db.durableSeq || db.maxSnap() >= 0 { append(mut &db.rootHist, RootChange{seq: db.seq, tree: tree, prev: prev}) }
    if slot >= 0 { db.trees.put(tree, slot) } else { let gone = db.trees.remove(&tree) }
}

fn (db: mut &Db) applyCreate(tree: int) {
    if db.trees.has(&tree) { return }
    let s = db.newNode(lexdb_page.newLeaf())
    db.meta[s].root = true
    db.setRoot(tree, s)
    if tree >= db.nextTree { db.nextTree = tree + 1 }
}

// Drops a tree. Its nodes in memory are freed; the pages of nodes that are
// not are not reclaimed yet (design/lexdb.md, as built).
fn (db: mut &Db) applyDrop(tree: int) {
    let r = match db.trees.get(&tree) { Some(x) { x } None { -1 } }
    if r < 0 { return }
    db.setRoot(tree, -1)
    var stack = [r]
    while len(stack) > 0 {
        let s = pop(mut &stack)
        if db.meta[s].loaded && !db.pool[db.meta[s].frame].leaf {
            for k in db.pool[db.meta[s].frame].kids { append(mut &stack, k) }
        }
        db.freeSlot(s)
    }
}

fn (db: mut &Db) applyWrite(w: &TxWrite) {
    if w.tree == db.watched { db.watchedWrites += 1 }
    if w.op == OP_PUT { db.applyPut(w.tree, &w.key, &w.val) }
    else if w.op == OP_DEL { db.applyDel(w.tree, &w.key) }
    else if w.op == OP_CREATE { db.applyCreate(w.tree) }
    else if w.op == OP_DROP { db.applyDrop(w.tree) }
}

// The slot a write needs loaded before it can be applied, or -1.
fn (db: mut &Db) writeNeeds(w: &TxWrite): int {
    if w.op == OP_PUT || w.op == OP_DEL {
        let d = db.descend(w.tree, &w.key)
        if d.need >= 0 { return d.need }
        if w.op == OP_DEL && len(d.path) > 0 {
            // collapsing the root wants its only child in memory; it is not required
        }
    }
    return -1
}

// ---- the log record format

fn addRecord(b: mut &[]byte, w: &TxWrite) {
    append(b, byte(w.op))
    binary.appendU32LE(b, w.tree)
    binary.appendU32LE(b, len(w.key))
    appendStr(b, w.key)
    binary.appendU32LE(b, len(w.val))
    appendStr(b, w.val)
}

fn parseRecords(b: &[]byte, from: int, to: int): Result[[]TxWrite, lexdb_base.DbErr] {
    var out: []TxWrite = []
    var at = from
    while at < to {
        if at + 13 > to { return Err(lexdb_base.corrupt("log record cut short")) }
        let op = int(b[at])
        let tree = binary.readU32LE(b, at + 1)
        let kl = binary.readU32LE(b, at + 5)
        if at + 9 + kl + 4 > to { return Err(lexdb_base.corrupt("log record cut short")) }
        let key = strFromBytes(&b[at + 9..at + 9 + kl])
        let vl = binary.readU32LE(b, at + 9 + kl)
        let vs = at + 13 + kl
        if vs + vl > to { return Err(lexdb_base.corrupt("log record cut short")) }
        let val = strFromBytes(&b[vs..vs + vl])
        append(mut &out, TxWrite{op: op, tree: tree, key: key, val: val})
        at = vs + vl
    }
    return Ok(out)
}

// A frame: the header, the records, padded to whole pages so that a block
// once flushed is never written again (4.6).
fn frame(records: &[]byte, count: int, batchNo: int, seg: int): []byte {
    var n = FRAME_HDR + len(records)
    n = (n + PAGE - 1) / PAGE * PAGE
    var b = array(n, byte(0))
    binary.setU32LE(mut &b, 0, LOG_MAGIC)
    binary.setU64LE(mut &b, 8, batchNo)
    binary.setU32LE(mut &b, 16, seg)
    binary.setU32LE(mut &b, 20, len(records))
    binary.setU32LE(mut &b, 24, count)
    for i in 0..len(records) { b[FRAME_HDR + i] = records[i] }
    let c = lexdb_base.crc32c(&b, 8, FRAME_HDR + len(records))
    binary.setU32LE(mut &b, 4, int(c))
    return b
}

// ---- transactions

// Reads key in tree: the transaction's own write of it, else the store's.
pub fn (st: &Store) get(t: mut &Txn, tree: int, key: str): Result[Option[str], lexdb_base.DbErr] {
    match t.index.get(&wkey(tree, &key)) {
        Some(i) {
            if t.writes[i].op == OP_DEL { return Ok(None) }
            return Ok(Some(t.writes[i].val))
        }
        None {}
    }
    if t.snap >= 0 && !t.live {
        var out: Option[str] = None
        try st.scan(t, tree, key, key + "\x00", fn(e: &Entry): bool {
            if e.key == key { out = Some(e.val) }
            return false
        })
        return Ok(out)
    }
    while true {
        var need = -1
        var out: Option[str] = None
        var bad: []lexdb_base.DbErr = []
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            let d = db.descend(tree, &key)
            if d.need >= 0 {
                need = d.need
                return
            }
            t.noteRead(tree, key, key + "\x00", db.seq)         // an empty tree too: an insert of key conflicts
            if len(d.path) == 0 { return }
            let leaf = d.path[len(d.path) - 1]
            let i = lowerIndex(&db.pool[db.meta[leaf].frame].keys, &key)
            if i < len(db.pool[db.meta[leaf].frame].keys) && db.pool[db.meta[leaf].frame].keys[i] == key {
                out = Some(db.pool[db.meta[leaf].frame].vals[i])
            }
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need < 0 { return Ok(out) }
        try st.load(need)
    }
    return Ok(None)
}

// An entry a scan gives. What get and scans give shares the memory of the
// page the node was read from (its keys and values are slices of one
// string, design/lexdb.md 9.13): kept, it keeps that page's bytes alive,
// evicted or not. lexdb_exec keeps nothing beyond a statement; what is kept
// longer must be copied (lexdb_base.own). Copying every entry here cost
// scans 14%.
pub type Entry = value record { pub key: str; pub val: str }

// The transaction's own writes to tree with keys in [from, to) (to "" for no
// end), sorted, the last write of each key.
fn (t: &Txn) ownRange(tree: int, from: &str, to: &str): []TxWrite {
    var out: []TxWrite = []
    for i in 0..len(t.writes) {
        let w = t.writes[i]
        if w.tree != tree || (w.op != OP_PUT && w.op != OP_DEL) { continue }
        if w.key < from || (len(to) > 0 && w.key >= to) { continue }
        match t.index.get(&wkey(tree, &w.key)) {
            Some(last) { if last != i { continue } }
            None {}
        }
        append(mut &out, w)
    }
    collections.sortBy(mut &out, fn(a: &TxWrite, b: &TxWrite): int { return a.key.cmp(&b.key) })
    return out
}

// Calls f on the entries of tree with keys in [from, to) (to "": to the
// end) in key order, the transaction's own writes included, while f gives
// true.
pub fn (st: &Store) scan(t: mut &Txn, tree: int, from: str, to: str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    let own = t.ownRange(tree, &from, &to)
    let root = if t.snap >= 0 && !t.live { match t.snapTrees.get(&tree) { Some(r) { r } None { -1 } } } else { -1 }
    var oi = 0
    var cursor = from
    var more = true
    let noting = t.noting()
    while more {
        var rseq = 0
        var need = -1
        var chunk: []Entry = []
        var bad: []lexdb_base.DbErr = []
        var upper = ""
        var hasUpper = false
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            rseq = if t.snap >= 0 && !t.live { t.snapSeq } else { db.seq }
            if t.snap >= 0 && !t.live {
                if db.snapGone(t.snap) {
                    append(mut &bad, snapCancelled())
                    return
                }
                if root < 0 { return }
                let d = db.snapDescend(root, t.snapSeq, &cursor, false)
                if d.need >= 0 {
                    need = d.need
                    return
                }
                if d.missing {
                    append(mut &bad, lexdb_base.err(lexdb_base.S_INTERNAL, "snapshot: a node version is missing"))
                    return
                }
                let n = db.snapNode(d.leaf, d.ver)
                var i = lowerIndex(&n.keys, &cursor)
                while i < len(n.keys) {
                    if len(to) > 0 && n.keys[i] >= to { break }
                    append(mut &chunk, Entry{key: n.keys[i], val: n.vals[i]})
                    i += 1
                }
                upper = d.fence
                hasUpper = d.hasFence
                return
            }
            let d = db.descend(tree, &cursor)
            if d.need >= 0 {
                need = d.need
                return
            }
            if len(d.path) == 0 { return }
            let leaf = d.path[len(d.path) - 1]
            var i = lowerIndex(&db.pool[db.meta[leaf].frame].keys, &cursor)
            while i < len(db.pool[db.meta[leaf].frame].keys) {
                let k = db.pool[db.meta[leaf].frame].keys[i]
                if len(to) > 0 && k >= to { break }
                append(mut &chunk, Entry{key: k, val: db.pool[db.meta[leaf].frame].vals[i]})
                i += 1
            }
            upper = d.upper
            hasUpper = d.hasUpper
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need >= 0 {
            try st.load(need)
            continue
        }
        let last = !hasUpper || (len(to) > 0 && upper >= to)
        // Merge with the transaction's own writes below the chunk's end.
        var ci = 0
        while ci < len(chunk) || (oi < len(own) && (last || own[oi].key < upper)) {
            var takeOwn = false
            if oi < len(own) && (last || own[oi].key < upper) {
                takeOwn = ci >= len(chunk) || own[oi].key <= chunk[ci].key
            }
            if takeOwn {
                let w = own[oi]
                oi += 1
                if ci < len(chunk) && chunk[ci].key == w.key { ci += 1 }
                if w.op == OP_PUT {
                    if !f(&Entry{key: w.key, val: w.val}) {
                        if noting { t.noteRead(tree, cursor, w.key + "\x00", rseq) }
                        return Ok(Unit{})
                    }
                }
            } else {
                if !f(&chunk[ci]) {
                    if noting { t.noteRead(tree, cursor, chunk[ci].key + "\x00", rseq) }
                    return Ok(Unit{})
                }
                ci += 1
            }
        }
        // the read: from the cursor to the leaf's fence, or to the end asked
        if noting { t.noteRead(tree, cursor, if !last { upper } else if len(to) > 0 { to } else { "" }, rseq) }
        if last { more = false } else { cursor = upper }
    }
    return Ok(Unit{})
}

// A descent for a backward scan: the leaf with the largest keys below k (k
// "": the last leaf). lower is the largest separator above it on the path:
// the leaf holds no key below it, so the next leaf back is the one below it.
fn (db: mut &Db) descendBack(tree: int, k: &str): Descent {
    var d = Descent{path: [], need: -1, upper: "", hasUpper: false}
    var s = match db.trees.get(&tree) { Some(r) { r } None { -1 } }
    if s < 0 { return d }
    while true {
        if !db.meta[s].loaded {
            d.need = s
            return d
        }
        db.meta[s].ref = true
        append(mut &d.path, s)
        if db.pool[db.meta[s].frame].leaf { return d }
        let j = if len(k) == 0 { len(db.pool[db.meta[s].frame].keys) } else { lowerIndex(&db.pool[db.meta[s].frame].keys, k) }
        if j > 0 {
            d.upper = db.pool[db.meta[s].frame].keys[j - 1]       // here: the lower fence
            d.hasUpper = true
        }
        s = db.pool[db.meta[s].frame].kids[j]
    }
    return d
}

// scan, backward: the entries with keys in [from, to) (to "": to the end)
// from the last down, the transaction's own writes included, while f gives
// true. Each leaf read is marked as scan marks it.
pub fn (st: &Store) scanBack(t: mut &Txn, tree: int, from: str, to: str, f: &fn(&Entry): bool): Result[Unit, lexdb_base.DbErr] {
    let own = t.ownRange(tree, &from, &to)
    let root = if t.snap >= 0 && !t.live { match t.snapTrees.get(&tree) { Some(r) { r } None { -1 } } } else { -1 }
    var oi = len(own) - 1
    var cursor = to
    var more = true
    let noting = t.noting()
    while more {
        var rseq = 0
        var need = -1
        var chunk: []Entry = []                 // descending
        var bad: []lexdb_base.DbErr = []
        var lower = ""
        var hasLower = false
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            rseq = if t.snap >= 0 && !t.live { t.snapSeq } else { db.seq }
            if t.snap >= 0 && !t.live {
                if db.snapGone(t.snap) {
                    append(mut &bad, snapCancelled())
                    return
                }
                if root < 0 { return }
                let d = db.snapDescend(root, t.snapSeq, &cursor, true)
                if d.need >= 0 {
                    need = d.need
                    return
                }
                if d.missing {
                    append(mut &bad, lexdb_base.err(lexdb_base.S_INTERNAL, "snapshot: a node version is missing"))
                    return
                }
                let n = db.snapNode(d.leaf, d.ver)
                var i = if len(cursor) == 0 { len(n.keys) } else { lowerIndex(&n.keys, &cursor) }
                while i > 0 {
                    i -= 1
                    if n.keys[i] < from { break }
                    append(mut &chunk, Entry{key: n.keys[i], val: n.vals[i]})
                }
                lower = d.fence
                hasLower = d.hasFence
                return
            }
            let d = db.descendBack(tree, &cursor)
            if d.need >= 0 {
                need = d.need
                return
            }
            if len(d.path) == 0 { return }
            let leaf = d.path[len(d.path) - 1]
            var i = if len(cursor) == 0 { len(db.pool[db.meta[leaf].frame].keys) } else { lowerIndex(&db.pool[db.meta[leaf].frame].keys, &cursor) }
            while i > 0 {
                i -= 1
                let k = db.pool[db.meta[leaf].frame].keys[i]
                if k < from { break }
                append(mut &chunk, Entry{key: k, val: db.pool[db.meta[leaf].frame].vals[i]})
            }
            lower = d.upper
            hasLower = d.hasUpper
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if need >= 0 {
            try st.load(need)
            continue
        }
        let last = !hasLower || lower <= from
        // Merge with the transaction's own writes at or above the leaf's fence.
        var ci = 0
        while ci < len(chunk) || (oi >= 0 && (last || own[oi].key >= lower)) {
            var takeOwn = false
            if oi >= 0 && (last || own[oi].key >= lower) {
                takeOwn = ci >= len(chunk) || own[oi].key >= chunk[ci].key
            }
            if takeOwn {
                let w = own[oi]
                oi -= 1
                if ci < len(chunk) && chunk[ci].key == w.key { ci += 1 }
                if w.op == OP_PUT {
                    if !f(&Entry{key: w.key, val: w.val}) {
                        if noting { t.noteRead(tree, w.key, cursor, rseq) }
                        return Ok(Unit{})
                    }
                }
            } else {
                if !f(&chunk[ci]) {
                    if noting { t.noteRead(tree, chunk[ci].key, cursor, rseq) }
                    return Ok(Unit{})
                }
                ci += 1
            }
        }
        // the read: from the leaf's lower fence, or the start asked, to the
        // cursor ("": the end)
        if noting { t.noteRead(tree, if last { from } else { lower }, cursor, rseq) }
        if last { more = false } else { cursor = lower }
    }
    return Ok(Unit{})
}

// A new tree, created when the transaction commits.
pub fn (st: &Store) createTree(t: mut &Txn): int {
    var id = 0
    st.sh.with(fn(db: mut &Db) {
        id = db.nextTree
        db.nextTree += 1
    })
    append(mut &t.writes, TxWrite{op: OP_CREATE, tree: id, key: "", val: ""})
    append(mut &t.created, id)
    return id
}

// Whether nothing the transaction read was written by a commit after the
// read: per key range, against the recent commits' writes.
fn (db: &Db) validate(t: &Txn): bool {
    for m in t.reads {
        if m.seq < db.wlogFloor { return false }
        // the first write after the read (wlog is in commit order)
        var lo = 0
        var hi = len(db.wlog)
        while lo < hi {
            let mid = (lo + hi) / 2
            if db.wlog[mid].seq <= m.seq { lo = mid + 1 } else { hi = mid }
        }
        var i = lo
        while i < len(db.wlog) {
            let e = &db.wlog[i]
            if e.tree == m.tree && (e.all || (e.key >= m.lo && (len(m.hi) == 0 || e.key < m.hi))) { return false }
            i += 1
        }
    }
    for w in t.writes {
        if w.op == OP_CREATE { continue }
        if !db.trees.has(&w.tree) {
            var mine = false
            for c in t.created { if c == w.tree { mine = true } }
            if !mine { return false }
        }
    }
    return true
}

// Keeps a commit's writes for the checks of transactions still running.
fn (db: mut &Db) logWrites(t: &Txn) {
    for w in t.writes {
        if w.op == OP_PUT || w.op == OP_DEL { append(mut &db.wlog, WEntry{seq: db.seq, tree: w.tree, key: w.key, all: false}) }
        else if w.op == OP_DROP { append(mut &db.wlog, WEntry{seq: db.seq, tree: w.tree, key: "", all: true}) }
    }
    if len(db.wlog) > WLOG_MAX {
        let half = len(db.wlog) / 2
        db.wlogFloor = db.wlog[half - 1].seq
        var keep: []WEntry = []
        for k in half..len(db.wlog) { append(mut &keep, db.wlog[k]) }
        db.wlog = keep
    }
}

// Commits: checks that nothing the transaction read has changed, applies its
// writes and waits until the log holds them. A transaction that only read
// is checked too, and waits until what it saw is durable (4.4).
pub fn (st: &Store) commit(t: Txn): Result[Unit, lexdb_base.DbErr] {
    let id = t.snap
    if id >= 0 && len(t.writes) == 0 {
        st.endSnap(id)
        return Ok(Unit{})
    }
    let r = st.commitLive(t)
    st.endSnap(id)
    return r
}

fn (st: &Store) commitLive(t: Txn): Result[Unit, lexdb_base.DbErr] {
    var wait: []task.Future[Result[Unit, lexdb_base.DbErr]] = []
    var wake: []task.Promise[Unit] = []
    while true {
        var need = -1
        var bad: []lexdb_base.DbErr = []
        var held: []task.Future[Unit] = []
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 {
                append(mut &bad, db.failed[0])
                return
            }
            // Written nodes leave the cache only once a checkpoint has
            // written them: while a checkpoint runs and the cache is over
            // twice its budget, a commit that writes waits for it to end
            // (writes faster than checkpoints would otherwise grow memory
            // without bound). Over the budget with none running: one starts.
            if len(t.writes) > 0 && db.cacheUsed > 2 * db.opts.cacheBytes {
                if db.ckptRunning {
                    let task.Handoff{promise: p, future: f} = task.promise[Unit]()
                    append(mut &db.ckptDone, p)
                    append(mut &held, f)
                    db.held += 1
                    return
                }
                if db.logSinceCkpt > 0 {
                    while len(db.ckptWake) > 0 { append(mut &wake, pop(mut &db.ckptWake)) }
                }
            }
            for w in t.writes {
                let n = db.writeNeeds(&w)
                if n >= 0 {
                    need = n
                    return
                }
            }
            if !db.validate(&t) {
                db.conflicts += 1
                append(mut &bad, lexdb_base.conflict())
                return
            }
            var b = db.appliedBatch
            if len(t.writes) > 0 {
                db.seq += 1
                db.logWrites(&t)
                for w in t.writes {
                    db.applyWrite(&w)
                    addRecord(mut &db.batch, &w)
                    db.batchCount += 1
                }
                b = db.batchNo
                db.appliedBatch = b
                db.commits += 1
                while len(db.writerWake) > 0 { append(mut &wake, pop(mut &db.writerWake)) }
                db.overBudget()
            }
            if b > db.durableBatch {
                let task.Handoff{promise: p, future: f} = task.promise[Result[Unit, lexdb_base.DbErr]]()
                append(mut &db.waiters, Waiter{batch: b, p: p})
                append(mut &wait, f)
            }
        })
        if len(bad) > 0 { return Err(bad[0]) }
        if len(held) > 0 {
            match pop(mut &held).wait() {
                Ok(_) {}
                Err(_) { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "commit: the checkpointer has gone")) }
            }
            continue
        }
        if need >= 0 {
            try st.load(need)
            continue
        }
        break
    }
    while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
    if len(wait) > 0 {
        match pop(mut &wait).wait() {
            Ok(r) { return r }
            Err(_) { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "commit: the log writer has gone")) }
        }
    }
    return Ok(Unit{})
}

// ---- snapshots (4.5): read-only transactions that see the store as it was
// when they began, never abort and never hold up a writer.

// Cancels the oldest snapshots while the old versions kept for them are over
// the budget ("snapshot too old").
fn (db: mut &Db) overBudget() {
    while db.histCount > db.opts.snapNodes {
        var oldest = -1
        for i in 0..len(db.snaps) {
            if !db.snaps[i].cancelled && (oldest < 0 || db.snaps[i].seq < db.snaps[oldest].seq) { oldest = i }
        }
        if oldest < 0 { return }
        db.snaps[oldest].cancelled = true
        db.tooOld += 1
        db.prune()
    }
}

// A read-only transaction on a snapshot, as of the last durable commit:
// nothing it shows can be lost in a crash, and it waits for nothing.
pub fn (st: &Store) beginSnapshot(): Result[Txn, lexdb_base.DbErr] { return st.snapshotTxn(false) }

// A transaction block: it reads a snapshot (as beginSnapshot), with its own
// writes over it, so its reads never wait; its reads are noted, and a
// commit with writes checks that none changed since (9.16).
pub fn (st: &Store) beginBlock(): Result[Txn, lexdb_base.DbErr] { return st.snapshotTxn(true) }

fn (st: &Store) snapshotTxn(track: bool): Result[Txn, lexdb_base.DbErr] {
    var t = begin()
    t.track = track
    var bad: []lexdb_base.DbErr = []
    st.sh.with(fn(db: mut &Db) {
        if len(db.failed) > 0 {
            append(mut &bad, db.failed[0])
            return
        }
        t.snap = db.nextSnap
        db.nextSnap += 1
        // as of the last commit the log holds: what it shows is durable, and
        // it waits for nothing (9.16)
        let q = db.durableSeq
        t.snapSeq = q
        append(mut &db.snaps, Snap{id: t.snap, seq: q, cancelled: false})
        db.snapshots += 1
        for i in 0..db.trees.size() {
            let id: int = db.trees.keyAt(i)
            let r: int = db.trees.valAt(i)
            t.snapTrees.put(id, r)
        }
        var k = len(db.rootHist) - 1
        while k >= 0 {
            let rc = db.rootHist[k]
            if rc.seq > q {
                if rc.prev >= 0 { t.snapTrees.put(rc.tree, rc.prev) } else { let gone = t.snapTrees.remove(&rc.tree) }
            }
            k -= 1
        }
    })
    if len(bad) > 0 { return Err(bad[0]) }
    return Ok(t)
}

// Ends a snapshot (its commit or rollback); its old versions go.
pub fn (st: &Store) endSnapshot(t: &Txn) { st.endSnap(t.snap) }

fn (st: &Store) endSnap(id: int) {
    if id < 0 { return }
    st.sh.with(fn(db: mut &Db) {
        var keep: []Snap = []
        for sn in db.snaps { if sn.id != id { append(mut &keep, sn) } }
        db.snaps = keep
        db.prune()
    })
}

// Ends a transaction without committing it.
pub fn (st: &Store) abort(t: Txn) { st.endSnapshot(&t) }

// The version of slot s a snapshot at seq q sees: -1 the current one (in
// memory), -2 the current one (to load), -3 none (a bug), else the index of
// an old version.
fn (db: &Db) verOf(s: int, q: int): int {
    if !db.meta[s].used { return -3 }
    if db.meta[s].since <= q { return if db.meta[s].loaded { -1 } else { -2 } }
    for i in 0..len(db.hist[s]) {
        if db.hist[s][i].since <= q && q < db.hist[s][i].until { return i }
    }
    return -3
}

fn (db: &Db) snapNode(s: int, v: int): &lexdb_page.Node {
    if v >= 0 { return &db.hist[s][v].node }
    return &db.pool[db.meta[s].frame]
}

fn snapCancelled(): lexdb_base.DbErr {
    return lexdb_base.err("72000", "snapshot too old: the old versions it needed went over the budget")
}

// A snapshot's descent to the leaf holding cursor (back: the leaf with the
// largest keys below it, "" the last): the leaf's slot and version (verOf),
// a slot to load first, or a version missing; and the fence on its path
// (forward: the separator above it; back: the one below it).
type SnapLeaf = value record { leaf: int; ver: int; need: int; missing: bool; fence: str; hasFence: bool }

fn (db: mut &Db) snapDescend(root: int, q: int, cursor: &str, back: bool): SnapLeaf {
    var r = SnapLeaf{leaf: -1, ver: -1, need: -1, missing: false, fence: "", hasFence: false}
    var s = root
    while true {
        let v = db.verOf(s, q)
        if v == -2 {
            r.need = s
            return r
        }
        if v == -3 {
            r.missing = true
            return r
        }
        db.meta[s].ref = true
        let n = db.snapNode(s, v)
        if n.leaf {
            r.leaf = s
            r.ver = v
            return r
        }
        if back {
            let j = if len(cursor) == 0 { len(n.keys) } else { lowerIndex(&n.keys, cursor) }
            if j > 0 {
                r.fence = n.keys[j - 1]
                r.hasFence = true
            }
            s = n.kids[j]
        } else {
            let i = childIndex(&n.keys, cursor)
            if i < len(n.keys) {
                r.fence = n.keys[i]
                r.hasFence = true
            }
            s = n.kids[i]
        }
    }
    return r
}

fn (db: &Db) snapGone(id: int): bool {
    for sn in db.snaps { if sn.id == id && sn.cancelled { return true } }
    return false
}

// ---- the log writer: one task, one flush at a time; commits made while a
// flush runs go in the next batch (group commit, 4.6).

fn (st: &Store) openSeg(g: int, size: int): Result[lexdb_disk.File, lexdb_base.DbErr] {
    var fs = lexdb_disk.Fs.Real("")
    st.sh.with(fn(db: mut &Db) { fs = db.fs })
    let name = segName(g)
    if !fs.exists(name) && fs.exists(SPARE) { try fs.rename(SPARE, name) }
    let f = try fs.open(name, true)
    let have = try f.size()
    if have < size {
        // Written with zeros once, not just allocated: a flush after a write
        // into an allocated but unwritten extent costs about twice as much
        // on ext4, which must journal the extent's change (design/lexdb.md 3).
        try f.grow(size)
        if !fs.isReal() { return Ok(f) }      // no extents to convert in the simulation
        let chunk = array(1024 * 1024, byte(0))
        var at = have / PAGE * PAGE
        while at < size {
            let n = if size - at < len(chunk) { size - at } else { len(chunk) }
            try f.write(at, &chunk[0..n])
            at += n
        }
        try f.flush()
    }
    return Ok(f)
}

fn (st: &Store) fail(e: lexdb_base.DbErr) {
    var ws: []Waiter = []
    var held: []task.Promise[Unit] = []
    st.sh.with(fn(db: mut &Db) {
        if len(db.failed) == 0 { append(mut &db.failed, e) }
        while len(db.waiters) > 0 { append(mut &ws, pop(mut &db.waiters)) }
        while len(db.ckptDone) > 0 { append(mut &held, pop(mut &db.ckptDone)) }
    })
    while len(held) > 0 { pop(mut &held).complete(Unit{}) }
    while len(ws) > 0 {
        let Waiter{batch: _, p: p} = pop(mut &ws)
        p.complete(Err(e))
    }
}

// The writer's loop; runs until the store closes or fails.
pub fn writer(st: Store): int {
    var segNo = 0
    var segOff = 0
    var segBytes = 0
    st.sh.with(fn(db: mut &Db) {
        segNo = db.seg
        segOff = db.segOff
        segBytes = db.opts.segBytes
    })
    var segF = lexdb_disk.File.Real(-1)
    match st.openSeg(segNo, segBytes) {
        Ok(f) { segF = f }
        Err(e) {
            st.fail(e)
            return 1
        }
    }
    while true {
        var job: []byte = []
        var count = 0
        var no = 0
        var upto = 0
        var stop = false
        var idle: []task.Future[Unit] = []
        st.sh.with(fn(db: mut &Db) {
            if len(db.failed) > 0 || (db.closing && db.batchCount == 0) {
                stop = true
                return
            }
            if db.batchCount > 0 {
                job = replace(mut &db.batch, [])
                upto = db.seq                   // every commit applied so far is in this batch or before
                count = db.batchCount
                no = db.batchNo
                db.batchNo += 1
                db.batchCount = 0
            } else {
                let task.Handoff{promise: p, future: f} = task.promise[Unit]()
                append(mut &db.writerWake, p)
                append(mut &idle, f)
            }
        })
        if stop { break }
        if len(idle) > 0 {
            match pop(mut &idle).wait() {
                Ok(_) {}
                Err(_) { break }
            }
            continue
        }
        var fr = frame(&job, count, no, segNo)
        if segOff > 0 && segOff + len(fr) > segBytes {
            segF.close()
            segNo += 1
            segOff = 0
            binary.setU32LE(mut &fr, 16, segNo)
            let c = lexdb_base.crc32c(&fr, 8, FRAME_HDR + len(job))
            binary.setU32LE(mut &fr, 4, int(c))
            match st.openSeg(segNo, if len(fr) > segBytes { len(fr) } else { segBytes }) {
                Ok(f) { segF = f }
                Err(e) {
                    st.fail(e)
                    return 1
                }
            }
        }
        match segF.write(segOff, &fr) {
            Ok(_) {}
            Err(e) {
                st.fail(e)
                return 1
            }
        }
        match segF.flush() {
            Ok(_) {}
            Err(e) {
                st.fail(e)        // never retried: the store stops (fsyncgate, 4.1)
                return 1
            }
        }
        segOff += len(fr)
        var done: []Waiter = []
        var ck: []task.Promise[Unit] = []
        st.sh.with(fn(db: mut &Db) {
            db.durableBatch = no
            if upto > db.durableSeq {
                db.durableSeq = upto
                db.prune()
            }
            db.seg = segNo
            db.segOff = segOff
            db.flushes += 1
            db.logSinceCkpt += len(fr)
            var keep: []Waiter = []
            while len(db.waiters) > 0 {
                let w = pop(mut &db.waiters)
                if w.batch <= no { append(mut &done, w) } else { append(mut &keep, w) }
            }
            db.waiters = keep
            // a checkpoint after ckptBytes of log, or sooner when the cache
            // is over its budget: written nodes are clean, so they can go
            let full = db.cacheUsed > db.opts.cacheBytes && db.logSinceCkpt >= db.opts.ckptBytes / 8
            if (db.logSinceCkpt >= db.opts.ckptBytes || full) && !db.ckptRunning {
                while len(db.ckptWake) > 0 { append(mut &ck, pop(mut &db.ckptWake)) }
            }
        })
        while len(done) > 0 {
            let Waiter{batch: _, p: p} = pop(mut &done)
            p.complete(Ok(Unit{}))
        }
        while len(ck) > 0 { pop(mut &ck).complete(Unit{}) }
    }
    segF.close()
    return 0
}

// ---- checkpoints (4.5)

fn (db: mut &Db) allocPage(): int {
    if len(db.free) > 0 { return pop(mut &db.free) }
    let p = db.npages
    db.npages += 1
    return p
}

// Writes out the dirty nodes under s (children first): s's page.
fn (db: mut &Db) encodeSlot(s: int, n: int, out: mut &[]PageOut): int {
    if !db.meta[s].dirty { return db.meta[s].disk }
    var pages: []int = []
    if !db.pool[db.meta[s].frame].leaf {
        var kids: []int = []
        for k in db.pool[db.meta[s].frame].kids { append(mut &kids, k) }
        for k in kids { append(mut &pages, db.encodeSlot(k, n, mut &out)) }
    }
    let p = db.allocPage()
    let body = lexdb_page.nodeBody(&db.pool[db.meta[s].frame], &pages)
    lexdb_page.repack(mut &db.pool[db.meta[s].frame], &body)
    db.recost(s)
    db.meta[s].dirty = false
    db.meta[s].disk = p
    db.meta[s].ckpt = n
    append(mut &out, PageOut{no: p, leaf: db.pool[db.meta[s].frame].leaf, n: len(db.pool[db.meta[s].frame].keys), body: body, raw: []})
    return p
}

// A checkpoint of everything applied so far, waiting first for one that
// is running (checkpoint returns at once then): at shutdown, so the next
// start replays nothing.
pub fn (st: &Store) checkpointAll(): Result[Unit, lexdb_base.DbErr] {
    while true {
        var running = false
        st.sh.with(fn(db: mut &Db) { running = db.ckptRunning && len(db.failed) == 0 })
        if !running { return st.checkpoint() }
        match task.sleep(1) {
            Ok(_) {}
            Err(_) { return st.checkpoint() }
        }
    }
    return Ok(Unit{})
}

// Takes a checkpoint: writes the changed nodes to new pages, then a meta
// page that names them, once the log holds every commit they include.
// Commits go on meanwhile. Does nothing while another checkpoint runs.
pub fn (st: &Store) checkpoint(): Result[Unit, lexdb_base.DbErr] {
    var out: []PageOut = []
    var metaPage: []byte = []
    var f = lexdb_disk.File.Real(-1)
    var busy = false
    var bad: []lexdb_base.DbErr = []
    var target = 0
    var n = 0
    var newLists: []int = []
    var oldSegs: []int = []
    var fs = lexdb_disk.Fs.Real("")
    st.sh.with(fn(db: mut &Db) {
        if len(db.failed) > 0 {
            append(mut &bad, db.failed[0])
            return
        }
        if db.ckptRunning {
            busy = true
            return
        }
        db.ckptRunning = true
        db.ckpt += 1
        n = db.ckpt
        f = db.data
        fs = db.fs
        var roots: []int = []
        var ids: []int = []
        var rs: []int = []
        for i in 0..db.trees.size() {
            let id: int = db.trees.keyAt(i)
            let r: int = db.trees.valAt(i)
            append(mut &ids, id)
            append(mut &rs, r)
        }
        for i in 0..len(ids) {
            append(mut &roots, ids[i])
            append(mut &roots, db.encodeSlot(rs[i], n, mut &out))
        }
        var freed = replace(mut &db.freeAfterNext, [])
        for p in db.listPages { append(mut &freed, p) }
        // The list pages come from the free pages; the free list then holds
        // what is left, and what this checkpoint frees.
        var rootPages: []int = []
        for i in 0..lexdb_page.listPages(len(roots)) { append(mut &rootPages, db.allocPage()) }
        var freePages: []int = []
        for i in 0..lexdb_page.listPages(len(db.free) + len(freed)) { append(mut &freePages, db.allocPage()) }
        var freeVals: []int = []
        for p in db.free { append(mut &freeVals, p) }
        for p in freed { append(mut &freeVals, p) }
        var rl = lexdb_page.encodeList(&roots, &rootPages)
        var i = len(rl) - 1
        while i >= 0 {
            append(mut &out, PageOut{no: rootPages[i], leaf: false, n: 0, body: "", raw: pop(mut &rl)})
            i -= 1
        }
        var fl = lexdb_page.encodeList(&freeVals, &freePages)
        i = len(fl) - 1
        while i >= 0 {
            append(mut &out, PageOut{no: freePages[i], leaf: false, n: 0, body: "", raw: pop(mut &fl)})
            i -= 1
        }
        for p in rootPages { append(mut &newLists, p) }
        for p in freePages { append(mut &newLists, p) }
        db.pendingFree = freed
        target = db.appliedBatch
        let m = lexdb_page.Meta{ckpt: n, npages: db.npages,
                                roots: if len(rootPages) > 0 { rootPages[0] } else { 0 },
                                free: if len(freePages) > 0 { freePages[0] } else { 0 },
                                replaySeg: db.seg, replayOff: db.segOff, replayBatch: db.durableBatch + 1,
                                nextTree: db.nextTree}
        metaPage = lexdb_page.encodeMeta(&m, n % 2)
        for s in 1..db.seg { append(mut &oldSegs, s) }
    })
    if len(bad) > 0 { return Err(bad[0]) }
    if busy { return Ok(Unit{}) }
    let r = st.finishCheckpoint(&f, &out, &metaPage, n, target)
    var done: []task.Promise[Unit] = []
    match r {
        Ok(_) {}
        Err(e) {
            st.fail(e)
            return Err(e)
        }
    }
    st.sh.with(fn(db: mut &Db) {
        db.durableCkpt = n
        let pf = replace(mut &db.pendingFree, [])
        for p in pf { append(mut &db.free, p) }
        db.listPages = replace(mut &newLists, [])
        db.ckptRunning = false
        db.logSinceCkpt = 0
        db.checkpoints += 1
        db.maybeEvict()
        while len(db.ckptDone) > 0 { append(mut &done, pop(mut &db.ckptDone)) }
    })
    while len(done) > 0 { pop(mut &done).complete(Unit{}) }
    // Segments before the one recovery now starts from are not needed.
    for s in oldSegs {
        let name = segName(s)
        if fs.exists(name) {
            if !fs.exists(SPARE) { try fs.rename(name, SPARE) } else { try fs.remove(name) }
        }
    }
    return Ok(Unit{})
}

fn (st: &Store) finishCheckpoint(f: &lexdb_disk.File, out: &[]PageOut, metaPage: &[]byte, n: int, target: int): Result[Unit, lexdb_base.DbErr] {
    for p in out {
        if len(p.raw) > 0 { try f.write(p.no * PAGE, &p.raw) } else {
            try f.write(p.no * PAGE, &lexdb_page.bodyPage(p.leaf, p.n, &p.body, p.no))
        }
    }
    // The log must hold every commit this checkpoint includes before its
    // meta page may name it (otherwise recovery could mix a commit's rows).
    var wait: []task.Future[Result[Unit, lexdb_base.DbErr]] = []
    var wake: []task.Promise[Unit] = []
    st.sh.with(fn(db: mut &Db) {
        if target > db.durableBatch {
            let task.Handoff{promise: p, future: fu} = task.promise[Result[Unit, lexdb_base.DbErr]]()
            append(mut &db.waiters, Waiter{batch: target, p: p})
            append(mut &wait, fu)
            while len(db.writerWake) > 0 { append(mut &wake, pop(mut &db.writerWake)) }
        }
    })
    while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
    if len(wait) > 0 {
        match pop(mut &wait).wait() {
            Ok(r) { try r }
            Err(_) { return Err(lexdb_base.err(lexdb_base.S_INTERNAL, "checkpoint: the log writer has gone")) }
        }
    }
    try f.flush()
    try f.write((n % 2) * PAGE, metaPage)
    try f.flush()
    return Ok(Unit{})
}

// The checkpointer's loop: a checkpoint whenever the writer says the log
// has grown by ckptBytes.
pub fn checkpointer(st: Store): int {
    while true {
        var stop = false
        var idle: []task.Future[Unit] = []
        st.sh.with(fn(db: mut &Db) {
            if db.closing || len(db.failed) > 0 {
                stop = true
                return
            }
            let task.Handoff{promise: p, future: f} = task.promise[Unit]()
            append(mut &db.ckptWake, p)
            append(mut &idle, f)
        })
        if stop { break }
        match pop(mut &idle).wait() {
            Ok(_) {}
            Err(_) { break }
        }
        match st.checkpoint() {
            Ok(_) {}
            Err(_) { break }
        }
    }
    return 0
}

// ---- open, recovery, close

fn newDb(fs: lexdb_disk.Fs, data: lexdb_disk.File, opts: Options, m: &lexdb_page.Meta): Db {
    return Db{opts: opts, fs: fs, data: data, watched: -1, watchedWrites: 0, pool: [], owner: [], meta: [], freeSlots: [], loadedCount: 0, cacheUsed: 0, wlog: [], wlogFloor: 0, hand: 0,
              trees: newMap(), nextTree: m.nextTree, npages: m.npages, free: [], freeAfterNext: [],
              pendingFree: [], listPages: [], ckpt: m.ckpt, durableCkpt: m.ckpt, ckptRunning: false,
              batch: [], batchCount: 0, batchNo: m.replayBatch, appliedBatch: m.replayBatch - 1,
              durableBatch: m.replayBatch - 1, waiters: [], writerWake: [], ckptWake: [], ckptDone: [], seg: m.replaySeg,
              segOff: m.replayOff, logSinceCkpt: 0, failed: [], closing: false, seq: 0, snaps: [], nextSnap: 0,
              hist: [], histCount: 0, histSlots: [], deferred: [], rootHist: [], durableSeq: 0, snapshots: 0, tooOld: 0, commits: 0,
              conflicts: 0, loads: 0, evictions: 0, flushes: 0, checkpoints: 0, held: 0}
}

// Opens the store in fs (creating it when it is new) and recovers: the last
// checkpoint, then the log after it.
pub fn open(fs: lexdb_disk.Fs, opts: Options): Result[Store, lexdb_base.DbErr] {
    let data = try fs.open(DATA, true)
    let size = try data.size()
    var best: Option[lexdb_page.Meta] = None
    if size >= 2 * PAGE {
        var b = array(PAGE, byte(0))
        for i in 0..2 {
            try data.read(i * PAGE, mut &b[0..PAGE], PAGE)
            match lexdb_page.decodeMeta(&b, i) {
                Some(m) {
                    let better = match best { Some(o) { m.ckpt > o.ckpt } None { true } }
                    if better { best = Some(m) }
                }
                None {}
            }
        }
    }
    if best.isNone() && fs.exists(segName(2)) && !fs.exists(segName(1)) {
        return Err(lexdb_base.corrupt("no valid meta page, and the log does not start at its beginning"))
    }
    let m = best.unwrapOr(lexdb_page.Meta{ckpt: 0, npages: 2, roots: 0, free: 0, replaySeg: 1, replayOff: 0,
                                          replayBatch: 1, nextTree: 1})
    var lists: []int = []
    let roots = try lexdb_page.readList(&data, m.roots, mut &lists)
    let free = try lexdb_page.readList(&data, m.free, mut &lists)
    var db = newDb(fs, data, opts, &m)
    db.free = free
    db.listPages = lists
    var i = 0
    while i + 1 < len(roots) {
        let s = db.allocSlot()
        db.meta[s].disk = roots[i + 1]
        db.meta[s].ckpt = m.ckpt
        db.meta[s].root = true
        db.trees.put(roots[i], s)
        i += 2
    }
    let st = Store{sh: task.shared(db)}
    try st.replay(&m)
    return Ok(st)
}

fn (st: &Store) applyRecovered(w: &TxWrite): Result[Unit, lexdb_base.DbErr] {
    while true {
        var need = -1
        st.sh.with(fn(db: mut &Db) {
            need = db.writeNeeds(w)
            if need < 0 { db.applyWrite(w) }
        })
        if need < 0 { return Ok(Unit{}) }
        try st.load(need)
    }
    return Ok(Unit{})
}

// Reads one frame at off: its records and length, or None when there is no
// valid frame with that batch number there.
fn readFrame(f: &lexdb_disk.File, off: int, size: int, seg: int, batch: int): Result[Option[[]TxWrite], lexdb_base.DbErr] {
    if off + PAGE > size { return Ok(None) }
    var h = array(PAGE, byte(0))
    try f.read(off, mut &h[0..PAGE], PAGE)
    if binary.readU32LE(&h, 0) != LOG_MAGIC || int(binary.readU64LE(&h, 8)) != batch || binary.readU32LE(&h, 16) != seg {
        return Ok(None)
    }
    let plen = binary.readU32LE(&h, 20)
    var n = (FRAME_HDR + plen + PAGE - 1) / PAGE * PAGE
    if off + n > size { return Ok(None) }
    var b = array(n, byte(0))
    try f.read(off, mut &b[0..n], n)
    let c = lexdb_base.crc32c(&b, 8, FRAME_HDR + plen)
    if int(c) != binary.readU32LE(&b, 4) { return Ok(None) }
    let recs = try parseRecords(&b, FRAME_HDR, FRAME_HDR + plen)
    return Ok(Some(recs))
}

fn frameLen(recs: &[]TxWrite): int {
    var n = FRAME_HDR
    for w in recs { n += 13 + len(w.key) + len(w.val) }
    return (n + PAGE - 1) / PAGE * PAGE
}

// Replays the log from the meta page's position; afterwards the writer
// goes on where the last valid frame ended.
fn (st: &Store) replay(m: &lexdb_page.Meta): Result[Unit, lexdb_base.DbErr] {
    var fs = lexdb_disk.Fs.Real("")
    st.sh.with(fn(db: mut &Db) { fs = db.fs })
    var seg = m.replaySeg
    var off = m.replayOff
    var batch = m.replayBatch
    while fs.exists(segName(seg)) {
        let f = try fs.open(segName(seg), false)
        let size = try f.size()
        var got = try readFrame(&f, off, size, seg, batch)
        var at = off
        var sg = seg
        match got {
            Some(_) {}
            None {
                // The writer may have moved on to the next segment.
                f.close()
                if !fs.exists(segName(seg + 1)) { break }
                let g = try fs.open(segName(seg + 1), false)
                let gs = try g.size()
                got = try readFrame(&g, 0, gs, seg + 1, batch)
                g.close()
                match got {
                    Some(_) {
                        sg = seg + 1
                        at = 0
                    }
                    None { break }
                }
            }
        }
        match got {
            Some(recs) {
                for w in recs { try st.applyRecovered(&w) }
                seg = sg
                off = at + frameLen(&recs)
                batch += 1
            }
            None { break }
        }
        f.close()
    }
    st.sh.with(fn(db: mut &Db) {
        db.seg = seg
        db.segOff = off
        db.batchNo = batch
        db.appliedBatch = batch - 1
        db.durableBatch = batch - 1
    })
    return Ok(Unit{})
}

// Asks the writer and the checkpointer to stop once the log holds every
// commit.
pub fn (st: &Store) close() {
    var wake: []task.Promise[Unit] = []
    st.sh.with(fn(db: mut &Db) {
        db.closing = true
        while len(db.writerWake) > 0 { append(mut &wake, pop(mut &db.writerWake)) }
        while len(db.ckptWake) > 0 { append(mut &wake, pop(mut &db.ckptWake)) }
    })
    while len(wake) > 0 { pop(mut &wake).complete(Unit{}) }
}

// Counters, for the tests and the server's log.
pub type Stats = value record {
    pub commits: int
    pub conflicts: int
    pub loads: int
    pub evictions: int
    pub flushes: int
    pub checkpoints: int
    pub loaded: int
    pub cacheUsed: int          // about the bytes the loaded nodes take
    pub held: int
    pub pages: int
    pub free: int
}

pub fn (st: &Store) stats(): Stats {
    var s = Stats{commits: 0, conflicts: 0, loads: 0, evictions: 0, flushes: 0, checkpoints: 0, loaded: 0,
                  cacheUsed: 0, held: 0, pages: 0, free: 0}
    st.sh.with(fn(db: mut &Db) {
        s = Stats{commits: db.commits, conflicts: db.conflicts, loads: db.loads, evictions: db.evictions,
                  flushes: db.flushes, checkpoints: db.checkpoints, loaded: db.loadedCount,
                  cacheUsed: db.cacheUsed, held: db.held, pages: db.npages,
                  free: len(db.free)}
    })
    return s
}

// Counts the writes to tree from now on (changes): the executor watches
// its catalog, so what it derived from the schema (a prepared statement's
// columns) is known to be current while the count is the same.
pub fn (st: &Store) watch(tree: int) {
    st.sh.with(fn(db: mut &Db) {
        db.watched = tree
        db.watchedWrites = 0
    })
}

// The writes to the watched tree applied so far.
pub fn (st: &Store) changes(): int {
    var n = 0
    st.sh.with(fn(db: mut &Db) { n = db.watchedWrites })
    return n
}

// The ids of the trees, in no order.
pub fn (st: &Store) trees(): []int {
    var out: []int = []
    st.sh.with(fn(db: mut &Db) {
        for i in 0..db.trees.size() { append(mut &out, db.trees.keyAt(i)) }
    })
    return out
}

// Opens the store, runs the writer and the checkpointer as tasks, calls f,
// then closes the store and waits for them.
pub fn run[R](fs: lexdb_disk.Fs, opts: Options, f: &fn(Store): R): Result[R, lexdb_base.DbErr] {
    let st = try open(fs, opts)
    var out: []R = []
    task.scope(fn(s: mut &task.Scope) {
        s.spawn(writer, st)
        s.spawn(checkpointer, st)
        append(mut &out, f(st))
        st.close()
    })
    return Ok(pop(mut &out))
}
