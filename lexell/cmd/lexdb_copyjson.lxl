// lexdb_copyjson: COPY ... TO STDOUT (FORMAT json [, FORCE_ARRAY]), PostgreSQL 19 (design/lexdb-new-features.md P16). A row is a JSON object of
// the columns' names, each value as to_json writes it: numbers as they are, a boolean true or false, NULL null, an array of a type a JSON array,
// every other type (text, dates, timestamps, uuid, bytea, intervals) its text output as a string. A float's NaN and infinities are strings.
// COPY FROM does not read JSON (PostgreSQL 19 does not: 0A000).
import "./lexdb_sql"
import "./lexdb_ops"
import "./lexdb_time"
import "./lexdb_bind"

type Val = lexdb_sql.Val
type OutCol = lexdb_bind.OutCol
type VB = vector[byte]

const PAIRS: str = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"

fn appendInt(b: mut &[]byte, n: int) {
    if n == -9223372036854775807 - 1 {
        appendStr(b, "-9223372036854775808")
        return
    }
    var neg = false
    var v = n
    if v < 0 {
        neg = true
        v = -v
    }
    var nd = 1
    var p = 10
    while nd < 19 && v >= p {
        nd += 1
        if nd < 19 { p = p * 10 }
    }
    let extra = if neg { 1 } else { 0 }
    let at = bytesGrow(b, extra + nd)
    if neg { b[at] = '-' }
    var k = at + extra + nd - 1
    while v >= 100 {
        let r = (v % 100) * 2
        v = v / 100
        b[k] = PAIRS[r + 1]
        b[k - 1] = PAIRS[r]
        k -= 2
    }
    if v >= 10 {
        b[k] = PAIRS[v * 2 + 1]
        b[k - 1] = PAIRS[v * 2]
    } else {
        b[k] = byte(48 + v)
    }
}

fn nextJsonEscSimd(t: &str, from: int): int {
    let n = len(t)
    let v32 = VB.splat(byte(32))
    let vQ = VB.splat('"')
    let vB = VB.splat('\\')
    var i = from
    while i + 32 <= n {
        let v = VB.load(t, i)
        let m = ((v < v32) | (v == vQ) | (v == vB)).bitmask()
        if m != u64(0) { return i + int(m.trailingZeros()) }
        i += 32
    }
    while i < n {
        let c = t[i]
        if c < byte(32) || c == '"' || c == '\\' { return i }
        i += 1
    }
    return n
}

fn nextJsonEsc(t: &str, from: int): int {
    let n = len(t)
    if n - from >= 32 { return nextJsonEscSimd(t, from) }
    var i = from
    while i < n {
        let c = t[i]
        if c < byte(32) || c == '"' || c == '\\' { return i }
        i += 1
    }
    return n
}

// COPY FROM's FORCE_NOT_NULL and FORCE_NULL lists (a and b): the first name that is no column of the table ([] none), which
// PostgreSQL refuses (42703, "column ... of relation ... does not exist") before it asks the client for the data, as lexdb_exec's
// copyStmt does with this and the lists' FORCE checks (design/lexdb-robust.md, "The third bug slice").
pub fn unknownCol(a: &[]str, b: &[]str, cols: &[]lexdb_sql.ColDef): []str {
    for x in a { if lexdb_bind.colIndex(cols, x) < 0 { return [x.clone()] } }
    for x in b { if lexdb_bind.colIndex(cols, x) < 0 { return [x.clone()] } }
    return []
}

fn hex2(c: int, b: mut &[]byte) {
    let d = "0123456789abcdef"
    append(b, d[(c >> 4) & 15])
    append(b, d[c & 15])
}

// A text as a JSON string.
pub fn jstr(t: &str, b: mut &[]byte) {
    let n = len(t)
    let first = nextJsonEsc(t, 0)
    if first == n {
        append(b, '"')
        if n > 0 { appendStr(b, t) }
        append(b, '"')
        return
    }
    append(b, '"')
    var start = 0
    var k = first
    while k < n {
        if k > start { appendStr(b, &t[start..k]) }
        let c = t[k]
        if c == '"' { appendStr(b, "\\\"") }
        else if c == '\\' { appendStr(b, "\\\\") }
        else if c == '\n' { appendStr(b, "\\n") }
        else if c == '\r' { appendStr(b, "\\r") }
        else if c == '\t' { appendStr(b, "\\t") }
        else if c == byte(8) { appendStr(b, "\\b") }
        else if c == byte(12) { appendStr(b, "\\f") }
        else {
            appendStr(b, "\\u00")
            hex2(int(c), b)
        }
        start = k + 1
        k = nextJsonEsc(t, start)
    }
    if start < n { appendStr(b, &t[start..n]) }
    append(b, '"')
}

fn isNumber(oid: int): bool {
    return oid == lexdb_sql.OID_INT2 || oid == lexdb_sql.OID_INT4 || oid == lexdb_sql.OID_INT8 || oid == lexdb_sql.OID_NUMERIC || oid == lexdb_sql.OID_OID
}

fn isFloat(oid: int): bool { return oid == lexdb_sql.OID_FLOAT4 || oid == lexdb_sql.OID_FLOAT8 }

// One value of type oid (its text output t).
fn scalar(t: &str, oid: int, b: mut &[]byte) {
    if isNumber(oid) {
        appendStr(b, t)
    } else if isFloat(oid) {
        if t == "NaN" || t == "Infinity" || t == "-Infinity" { jstr(t, b) } else { appendStr(b, t) }
    } else if oid == lexdb_sql.OID_BOOL {
        appendStr(b, if t == "t" || t == "true" { "true" } else { "false" })
    } else {
        jstr(t, b)
    }
}

// An array's text ({1,2,NULL}) as a JSON array of its element type's values.
fn jarray(t: &str, elem: int, b: mut &[]byte) {
    match lexdb_ops.arrayParts(t) {
        Ok(ps) {
            append(b, '[')
            var first = true
            for p in ps {
                if !first { append(b, ',') }
                first = false
                match p {
                    Some(x) { scalar(&x, elem, b) }
                    None { appendStr(b, "null") }
                }
            }
            append(b, ']')
        }
        Err(_) { jstr(t, b) }
    }
}

// Precomputes each column's JSON key prefix: "{\"col\":" for k == 0, ",\"col\":" for k > 0.
pub fn keyPrefixes(cols: &[]OutCol): []str {
    var out: []str = withCapacity(len(cols))
    for k in 0..len(cols) {
        var b: []byte = withCapacity(32)
        append(mut &b, if k == 0 { '{' } else { ',' })
        let nm = cols[k].label()
        jstr(&nm, mut &b)
        append(mut &b, ':')
        append(mut &out, strFromBytes(&b))
    }
    return out
}

// A row as one JSON object using precomputed keyPrefixes (zero per-row key alloc/escape).
pub fn objectPre(r: &[]Val, cols: &[]OutCol, keys: &[]str, z: &lexdb_time.Zone, b: mut &[]byte) {
    let utc = z.isUtc()
    if len(r) == 0 {
        appendStr(b, "{}")
        return
    }
    for k in 0..len(r) {
        if k < len(keys) {
            appendStr(b, &keys[k])
        } else {
            append(b, if k == 0 { '{' } else { ',' })
            appendStr(b, "\"?column?\":")
        }
        let oid = if k < len(cols) { cols[k].oid } else { lexdb_sql.OID_TEXT }
        match r[k] {
            Val.Null { appendStr(b, "null") }
            Val.Int(n) {
                if isNumber(oid) || isFloat(oid) { appendInt(b, n) }
                else {
                    let t = lexdb_ops.textOut(&r[k], oid, z)
                    let el = lexdb_sql.elemOid(oid)
                    if el > 0 { jarray(&t, el, b) } else { scalar(&t, oid, b) }
                }
            }
            Val.Bool(v) {
                if oid == lexdb_sql.OID_BOOL { appendStr(b, if v { "true" } else { "false" }) }
                else { jstr(if v { "t" } else { "f" }, b) }
            }
            Val.Text(t) {
                let el = lexdb_sql.elemOid(oid)
                if el == 0 && (utc || oid != lexdb_sql.OID_TSTZ) && !isNumber(oid) && !isFloat(oid) && oid != lexdb_sql.OID_BOOL {
                    jstr(&t, b)
                } else {
                    let s = lexdb_ops.textOut(&r[k], oid, z)
                    if el > 0 { jarray(&s, el, b) } else { scalar(&s, oid, b) }
                }
            }
            else {
                let t = lexdb_ops.textOut(&r[k], oid, z)
                let el = lexdb_sql.elemOid(oid)
                if el > 0 { jarray(&t, el, b) } else { scalar(&t, oid, b) }
            }
        }
    }
    append(b, '}')
}

// A row as one JSON object (without its line end): cols' names, the values' types, the session's zone.
pub fn object(r: &[]Val, cols: &[]OutCol, z: &lexdb_time.Zone, b: mut &[]byte) {
    let utc = z.isUtc()
    append(b, '{')
    for k in 0..len(r) {
        if k > 0 { append(b, ',') }
        let nm = if k < len(cols) { cols[k].label() } else { "?column?".toStr() }
        jstr(&nm, b)
        append(b, ':')
        let oid = if k < len(cols) { cols[k].oid } else { lexdb_sql.OID_TEXT }
        match r[k] {
            Val.Null { appendStr(b, "null") }
            Val.Int(n) {
                if isNumber(oid) || isFloat(oid) { appendInt(b, n) }
                else {
                    let t = lexdb_ops.textOut(&r[k], oid, z)
                    let el = lexdb_sql.elemOid(oid)
                    if el > 0 { jarray(&t, el, b) } else { scalar(&t, oid, b) }
                }
            }
            Val.Bool(v) {
                if oid == lexdb_sql.OID_BOOL { appendStr(b, if v { "true" } else { "false" }) }
                else { jstr(if v { "t" } else { "f" }, b) }
            }
            Val.Text(t) {
                let el = lexdb_sql.elemOid(oid)
                if el == 0 && (utc || oid != lexdb_sql.OID_TSTZ) && !isNumber(oid) && !isFloat(oid) && oid != lexdb_sql.OID_BOOL {
                    jstr(&t, b)
                } else {
                    let s = lexdb_ops.textOut(&r[k], oid, z)
                    if el > 0 { jarray(&s, el, b) } else { scalar(&s, oid, b) }
                }
            }
            else {
                let t = lexdb_ops.textOut(&r[k], oid, z)
                let el = lexdb_sql.elemOid(oid)
                if el > 0 { jarray(&t, el, b) } else { scalar(&t, oid, b) }
            }
        }
    }
    append(b, '}')
}
