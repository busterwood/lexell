    "fr-FR~ ~,~ ~,~0~{n} €~-{n} €~{n} %~-{n} %",
    "fr-CA~ ~,~ ~,~0~{n} $~({n} $)~{n} %~-{n} %",
    "fr-BE~.~,~.~,~0~{n} €~-{n} €~{n} %~-{n} %",
    "fr-CH~ ~,~ ~.~0~{n} CHF~-{n} CHF~{n}%~-{n}%",
    "es-ES~.~,~.~,~0~{n} €~-{n} €~{n} %~-{n} %",
