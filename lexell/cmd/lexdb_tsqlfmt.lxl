]

// Whether name has the form of a culture name (SQL Server accepts any such: a language of two or three letters, then parts of
// letters and digits divided by "-"; 'en_US', 'english', 'x' and '' it refuses with 9818).
fn cultureForm(name: &str): bool {
    let parts = strings.split(name, "-")
    if len(parts) == 0 { return false }
    for k in 0..len(parts) {
        let p = &parts[k]
        if k == 0 && (len(p) < 2 || len(p) > 3) { return false }
        if len(p) == 0 || len(p) > 8 { return false }
        for i in 0..len(p) {
            let c = p[i]
            let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
            if !(letter || (k > 0 && c >= '0' && c <= '9')) { return false }
        }
    }
    return true
}

// The numbers of culture name (""): its entry in NUMCULS, or the invariant one for a name of the form; error 9818 for another.
fn culOf(name: &str): Result[Cul, DbErr] {
    if !cultureForm(name) {
        return Err(e("TS9818", &("The culture parameter '" + name + "' provided in the function call is not supported.")))
    }
    let l = strings.toLowerAscii(name)
    for r in NUMCULS {
        let f = strings.split(&r, "~")
        if strings.toLowerAscii(&f[0]) == l {
            return Ok(Cul{grp: f[1].toStr(), dec: f[2].toStr(), cgrp: f[3].toStr(), cdec: f[4].toStr(), indian: f[5] == "1", cpos: f[6].toStr(), cneg: f[7].toStr(),
                          ppos: f[8].toStr(), pneg: f[9].toStr()})
        }
    }
    return Ok(Cul{grp: ",", dec: ".", cgrp: ",", cdec: ".", indian: false, cpos: "¤{n}", cneg: "(¤{n})", ppos: "{n} %", pneg: "-{n} %"})
}

// Whether name is one of the cultures whose numbers lexdb has.
fn numCulture(name: &str): bool {
    let l = strings.toLowerAscii(name)
    for r in NUMCULS {
        if strings.toLowerAscii(&r[0..strings.indexOf(&r, "~", 0)]) == l { return true }
    }
    return false
}

// A culture's dates: the names (months, abbreviated months, days from Sunday, abbreviated days), AM and PM, the date separator and
// the standard patterns d D t T M Y (f is D and t, F D and T, g d and t, G d and T), as .NET gives them SQL Server (read from
// SQL Server 2022: FORMAT(@d, 'd', 'de-DE') ...). Fields: name ; months ; months' abbreviations ; days ; days' abbreviations ;
// AM ; PM ; separator ; d ; D ; t ; T ; M ; Y, then (a culture that has them) the months' genitive names (used where a day of the month is
// in the pattern, MMMM beside d or dd), their abbreviations, the time separator (a ":" of a custom pattern: "" is ":"), the years' offset
// (Thai Buddhist era, 543), divided by "~" (the names by "|"). The cultures after ja-JP were read from SQL Server 2022 with the one date
// 2031-07-04 15:08:06 (and 09:08:06 for the hours' digits) and each pattern read off the answers; ar-SA (Hijri calendar) is not here.
type DCul = value record { mon: []str; monA: []str; day: []str; dayA: []str; am: str; pm: str; sep: str; d: str; D: str; t: str; T: str; M: str; Y: str;
                           monG: []str; monGA: []str; tsep: str; yoff: int }

