// The dates of a culture: the first entry of CULTURES named so (a neutral name, de, takes its first specific one); en-US else.
fn dateCul(name: &str): DCul {
    let l = strings.toLowerAscii(name)
    // (a culture whose numbers are known and whose dates are not: en-US's, as before; one that is none of them: the invariant's)
    var pick = 0
    if len(l) > 0 && !numCulture(name) {
        for i in 0..len(CULTURES) { if strings.startsWith(&CULTURES[i], "invariant~") { pick = i } }
    }
    for i in 0..len(CULTURES) {
        let nm = strings.toLowerAscii(&CULTURES[i][0..strings.indexOf(&CULTURES[i], "~", 0)])
        if nm == l || (len(l) == 2 && strings.startsWith(&nm, &(l + "-"))) { pick = i; break }
    }
    let f = strings.split(&CULTURES[pick], "~")
    let more = len(f) > 14
    let mon = splitBar(&f[1])
    let monA = splitBar(&f[2])
    return DCul{mon: splitBar(&f[1]), monA: splitBar(&f[2]), day: splitBar(&f[3]), dayA: splitBar(&f[4]), am: f[5].toStr(), pm: f[6].toStr(), sep: f[7].toStr(),
                d: f[8].toStr(), D: f[9].toStr(), t: f[10].toStr(), T: f[11].toStr(), M: f[12].toStr(), Y: f[13].toStr(),
                monG: if more && len(f[14]) > 0 { splitBar(&f[14]) } else { mon }, monGA: if more && len(f[15]) > 0 { splitBar(&f[15]) } else { monA },
                tsep: if more && len(f[16]) > 0 { f[16].toStr() } else { ":" }, yoff: if more { strings.parseIntOpt(&f[17]).unwrapOr(0) } else { 0 }}
}

fn splitBar(s: &str): []str {
    var out: []str = []
    for x in strings.split(s, "|") { append(mut &out, x.toStr()) }
    return out
}

// FORMAT's value: vs the value, the format and the culture ('' en-US).
pub fn format(vs: &[]Val, z: &lexdb_time.Zone): Result[Val, DbErr] {
    if len(vs) < 2 { return Ok(Val.Null) }
    for v in vs {
        match v {
            Val.Null { return Ok(Val.Null) }
            else {}
        }
    }
    let f = lexdb_sql.text(&vs[1])
    let cname = if len(vs) > 2 { lexdb_sql.text(&vs[2]) } else { "en-US" }
    let cul = try culOf(&cname)
    let dc = dateCul(&cname)
    match vs[0] {
        Val.Int(n) { return numFormat(&Decimal.fromInt(n), true, &f, &cul, n) }
        Val.Num(d) { return numFormat(&d, false, &f, &cul, 0) }
        Val.Float(x) { return floatFormat(x, &f, &cul) }
        Val.Real(x) { return floatFormat(x, &f, &cul) }
        Val.Date(d) { return dateFormat(d * lexdb_time.DAY_US, &f, &dc) }
        Val.Ts(us) { return dateFormat(us, &f, &dc) }
        Val.Tstz(us) { return dateFormat(lexdb_time.tstzToTs(us, z), &f, &dc) }
        Val.Time(us) { return timeFormat(us, &f) }
        Val.Text(_) { return Err(e("TS8116", "Argument data type varchar is invalid for argument 1 of format function.")) }
        else { return Ok(Val.Null) }
    }
}

fn floatFormat(x: float, f: &str, cul: &Cul): Result[Val, DbErr] {
    match Decimal.parse(&(x.toStr())) {
        Ok(d) { return numFormat(&d, false, f, cul, 0) }
        Err(_) { return Ok(Val.Null) }
    }
}

// ---- numbers

fn isDigit(c: byte): bool { return c >= '0' && c <= '9' }

fn numFormat(d: &Decimal, isInt: bool, f: &str, cul: &Cul, n: int): Result[Val, DbErr] {
    if len(f) == 0 { return Ok(Val.Text(plainText(d))) }
    // a letter and at most two digits: a standard format
    var std = (f[0] >= 'a' && f[0] <= 'z') || (f[0] >= 'A' && f[0] <= 'Z')
    for i in 1..len(f) { if !isDigit(f[i]) { std = false } }
    if std && len(f) > 3 { std = false }
    if !std { return Ok(Val.Text(custom(d, f, cul))) }
    let hasP = len(f) > 1
    let p = if hasP { strings.parseIntOpt(&(f[1..len(f)].toStr())).unwrapOr(0) } else { -1 }
    let k = f[0]
    if k == 'N' || k == 'n' { return Ok(Val.Text(fixed(d, if hasP { p } else { 2 }, true, cul))) }
    if k == 'F' || k == 'f' { return Ok(Val.Text(fixed(d, if hasP { p } else { 2 }, false, cul))) }
    if k == 'D' || k == 'd' {
        if !isInt { return Ok(Val.Null) }
        let s = d.abs().toStr()
        return Ok(Val.Text((if d.isNeg() { "-" } else { "" }) + strings.padLeft(&s, if hasP { p } else { 0 }, '0')))
    }
    if k == 'X' || k == 'x' {
        if !isInt { return Ok(Val.Null) }
        // a negative value's two's complement, of an int's 32 bits or a bigint's 64
        var u = n
        var digits = 16
        if n >= -2147483648 && n <= 2147483647 {
            digits = 8
            if n < 0 { u = n + 4294967296 }
        }
        var h = ""
        if u == 0 { h = "0" }
        var c = 0
        while u != 0 && c < digits {
            let q = u & 15
            h = (if q < 10 { (q).toStr() } else { (if k == 'X' { ["A", "B", "C", "D", "E", "F"] } else { ["a", "b", "c", "d", "e", "f"] })[q - 10].toStr() }) + h
            u = (u >> 4) & 0x0fffffffffffffff
            c += 1
        }
        return Ok(Val.Text(strings.padLeft(&h, if hasP { p } else { 0 }, '0')))
    }
    if k == 'P' || k == 'p' {
        let x = d.mul(Decimal.fromInt(100))
        let t = fixed(&x.abs(), if hasP { p } else { 2 }, true, cul)
        let neg = x.isNeg() && t != fixed(&Decimal.zero(), if hasP { p } else { 2 }, true, cul)
        return Ok(Val.Text(strings.replaceAll(&(if neg { cul.pneg.clone() } else { cul.ppos.clone() }), "{n}", &t)))
    }
    if k == 'C' || k == 'c' {
        let cc = Cul{grp: cul.cgrp.clone(), dec: cul.cdec.clone(), cgrp: cul.cgrp.clone(), cdec: cul.cdec.clone(), indian: cul.indian, cpos: "", cneg: "", ppos: "", pneg: ""}
        let t = fixed(&d.abs(), if hasP { p } else { 2 }, true, &cc)
        let neg = d.isNeg() && t != fixed(&Decimal.zero(), if hasP { p } else { 2 }, true, &cc)
        return Ok(Val.Text(strings.replaceAll(&(if neg { cul.cneg.clone() } else { cul.cpos.clone() }), "{n}", &t)))
    }
    if k == 'E' || k == 'e' { return Ok(Val.Text(sci(d, if hasP { p } else { 6 }, k == 'E', 3, false, cul))) }
    if k == 'G' || k == 'g' {
        if !hasP || p == 0 { return Ok(Val.Text(plainText(d))) }
        return Ok(Val.Text(general(d, p, k == 'G', cul)))
    }
    return Ok(Val.Null)
}

// A decimal's own text (its scale kept), as .NET's G of a decimal.
fn plainText(d: &Decimal): str { return d.toStr() }

// The digits of |d| rounded to scale p, half away from zero: the integer part and the fraction's p digits.
fn parts(d: &Decimal, p: int): []str {
    let q = d.abs().quantize(p, Rounding.HALF_AWAY).unwrapOr(d.abs())
    let s = q.toStr()
    let dot = strings.indexOf(&s, ".", 0)
    if dot < 0 { return [s, strings.repeat("0", p)] }
    return [s[0..dot].toStr(), strings.padRight(&(s[dot + 1..len(s)].toStr()), p, '0')]
}

fn grouped(ip: &str, grp: &str): str { return groupedBy(ip, grp, false) }

// The digits ip with grp between groups of three, or (indian) between the last three and then twos.
fn groupedBy(ip: &str, grp: &str, indian: bool): str {
    var out = ""
    let n = len(ip)
    for i in 0..n {
        let left = n - i
        if i > 0 && (if indian { left == 3 || (left > 3 && (left - 3) % 2 == 0) } else { left % 3 == 0 }) { out += grp }
        out.addByte(ip[i])
    }
    return out
}

// N (group) and F: p decimals, the sign only when what shows is not zero.
fn fixed(d: &Decimal, p: int, group: bool, cul: &Cul): str {
    let ps = parts(d, p)
    let ip = if group { groupedBy(&ps[0], &cul.grp, cul.indian) } else { ps[0].clone() }
    let body = ip + (if p > 0 { cul.dec + ps[1] } else { "" })
    var zero = true
    for i in 0..len(ps[0]) { if ps[0][i] != '0' { zero = false } }
    for i in 0..len(ps[1]) { if ps[1][i] != '0' { zero = false } }
    return (if d.isNeg() && !zero { "-" } else { "" }) + body
}

// Digits and a number with them: sigDigits' exponent, roundTo's carry (1 or 0).
type Ds = record { ds: str; k: int }

// |d|'s significant digits and the exponent of the first: "12345", 3 for 1234.5.
fn sigDigits(d: &Decimal): Ds {
    let s = d.abs().toStr()
    let dot = strings.indexOf(&s, ".", 0)
    let ip = if dot < 0 { s.clone() } else { s[0..dot].toStr() }
    let fp = if dot < 0 { "" } else { s[dot + 1..len(s)].toStr() }
    var all = ip + fp
    var lead = 0
    while lead < len(all) && all[lead] == '0' { lead += 1 }
    if lead == len(all) { return Ds{ds: "0", k: 0} }
    let ex = len(ip) - 1 - lead
    var t = all[lead..len(all)].toStr()
    while len(t) > 1 && t[len(t) - 1] == '0' { t = t[0..len(t) - 1].toStr() }
    return Ds{ds: t, k: ex}
}

// digits rounded to k (half away), and whether it carried into a new digit (999 to 1000).
fn roundTo(ds: &str, k: int): Ds {
    if len(ds) <= k { return Ds{ds: strings.padRight(ds, k, '0'), k: 0} }
    var b: []int = []
    for i in 0..k { append(mut &b, int(ds[i] - '0')) }
    if ds[k] >= '5' {
        var i = k - 1
        var carry = true
        while carry && i >= 0 {
            b[i] += 1
            if b[i] == 10 { b[i] = 0 } else { carry = false }
            i -= 1
        }
        if carry {
            var out = "1"
            for x in b { out += x.toStr() }
            return Ds{ds: out[0..k].toStr(), k: 1}
        }
    }
    var out = ""
    for x in b { out += x.toStr() }
    return Ds{ds: out, k: 0}
}

// d.ddd...E+xxx: p decimals, the exponent of at least w digits.
fn sci(d: &Decimal, p: int, up: bool, w: int, trim: bool, cul: &Cul): str {
    let sd = sigDigits(d)
    var ex = sd.k
    let r = roundTo(&sd.ds, p + 1)
    ex += r.k
    if d.isZero() { ex = 0 }
    var frac = r.ds[1..len(r.ds)].toStr()
    if trim { while len(frac) > 0 && frac[len(frac) - 1] == '0' { frac = frac[0..len(frac) - 1].toStr() } }
    let sign = if d.isNeg() && !d.isZero() { "-" } else { "" }
    let es = (if ex < 0 { "-" } else { "+" }) + strings.padLeft(&((if ex < 0 { 0 - ex } else { ex }).toStr()), w, '0')
    return sign + r.ds[0..1].toStr() + (if len(frac) > 0 { cul.dec + frac } else { "" }) + (if up { "E" } else { "e" }) + es
}

// G with p significant digits: fixed if the exponent is from -5 to p - 1, else scientific (E+xx); no trailing zeros.
fn general(d: &Decimal, p: int, up: bool, cul: &Cul): str {
    let sd = sigDigits(d)
    var ex = sd.k
    let r = roundTo(&sd.ds, p)
    ex += r.k
    if ex >= p || ex < -5 { return sci(d, p - 1, up, 2, true, cul) }
    let sc = max(p - 1 - ex, 0)
    var t = fixed(d, sc, false, cul)
    if strings.contains(&t, &cul.dec) {
        while strings.endsWith(&t, "0") { t = t[0..len(t) - 1].toStr() }
        if strings.endsWith(&t, &cul.dec) { t = t[0..len(t) - len(cul.dec)].toStr() }
    }
    return t
}

// A custom numeric format (checked against SQL Server 2022): up to three sections divided by ";" (positive, negative, zero; a value that
// rounds to zero in its section takes the zero one, or the first with two; the negative section shows no sign of its own; an empty one
// is the first with the sign), each of 0 a digit always shown, # one shown where it is significant, the group separator between the
// integer part's placeholders, a decimal point, % (the value a hundred times), and the rest (quoted or escaped text too) as written
// where it stands: the digits go to the placeholders from the right in the integer part (more digits than placeholders go to the
// leftmost) and from the left in the fraction, the literals between them stay between them.
type Tk = record { kind: int; text: str }      // kind: 0 a literal, 1 "0", 2 "#", 3 ",", 4 the decimal point, 5 "%"

fn tokens(f: &str): []Tk {
    var out: []Tk = []
    var seenDp = false
    var i = 0
    let n = len(f)
    while i < n {
        let c = f[i]
        if c == '\'' || c == '"' {
            var j = i + 1
            var lit = ""
            while j < n && f[j] != c {
                lit.addByte(f[j])
                j += 1
            }
            append(mut &out, Tk{kind: 0, text: lit})
            i = j + 1
            continue
        }
        if c == '\\' && i + 1 < n {
            let ch = firstChar(&(f[i + 1..n].toStr()))
            append(mut &out, Tk{kind: 0, text: ch.clone()})
            i += 1 + len(ch)
            continue
        }
        if c == '0' { append(mut &out, Tk{kind: 1, text: "0"}) }
        else if c == '#' { append(mut &out, Tk{kind: 2, text: "#"}) }
        else if c == ',' { append(mut &out, Tk{kind: 3, text: ","}) }
        else if c == '.' && !seenDp {
            seenDp = true
            append(mut &out, Tk{kind: 4, text: "."})
        } else if c == '%' { append(mut &out, Tk{kind: 5, text: "%"}) }
        else {
            let ch = firstChar(&(f[i..n].toStr()))
            append(mut &out, Tk{kind: 0, text: ch.clone()})
            i += len(ch)
            continue
        }
        i += 1
    }
    return out
}

// f's sections (divided by ";" outside quotes).
fn splitSections(f: &str): []str {
    var out: []str = []
    var cur = ""
    var i = 0
    let n = len(f)
    while i < n {
        let c = f[i]
        if c == '\'' || c == '"' {
            var j = i + 1
            while j < n && f[j] != c { j += 1 }
            let end = min(j + 1, n)
            for k in i..end { cur.addByte(f[k]) }
            i = end
            continue
        }
        if c == '\\' && i + 1 < n {
            cur.addByte(c)
            cur.addByte(f[i + 1])
            i += 2
            continue
        }
        if c == ';' {
            append(mut &out, cur.clone())
            cur = ""
        } else { cur.addByte(c) }
        i += 1
    }
    append(mut &out, cur.clone())
    return out
}

// |d0| as section sec shows it: its percent signs multiplied in, and how many fraction placeholders it has.
type Sec = record { tk: []Tk; d: Decimal; nf: int; fz: int; intZeros: int; group: bool; dpAt: int; firstPh: int }

fn scanSection(d0: &Decimal, sec: &str): Sec {
    let tk = tokens(sec)
    var dpAt = -1
    var firstPh = -1
    var lastIntPh = -1
    for i in 0..len(tk) {
        let k = tk[i].kind
        if k == 4 && dpAt < 0 { dpAt = i }
        if k == 1 || k == 2 {
            if firstPh < 0 { firstPh = i }
            if dpAt < 0 { lastIntPh = i }
        }
    }
    var pct = 0
    var group = false
    var nf = 0
    var fz = 0
    var intZeros = 0
    for i in 0..len(tk) {
        let k = tk[i].kind
        if k == 3 && firstPh >= 0 && i > firstPh && i < lastIntPh { group = true }
        if k == 5 { pct += 1 }
        if k == 1 || k == 2 {
            if dpAt >= 0 && i > dpAt {
                nf += 1
                if k == 1 { fz = nf }
            } else if k == 1 { intZeros += 1 }
        }
    }
    var d = d0.abs()
    for _ in 0..pct { d = d.mul(Decimal.fromInt(100)) }
    return Sec{tk: tk, d: d, nf: nf, fz: fz, intZeros: intZeros, group: group, dpAt: dpAt, firstPh: firstPh}
}

// Whether section sec shows d0 as zero (what it rounds to has no digit but zeros).
fn sectionZero(d0: &Decimal, sec: &str): bool {
    let sc = scanSection(d0, sec)
    let ps = parts(&sc.d, sc.nf)
    for k in 0..len(ps[0]) { if ps[0][k] != '0' { return false } }
    for k in 0..len(ps[1]) { if ps[1][k] != '0' { return false } }
    return true
}

// ch put before out, after the group separator the digits so far call for.
fn prependDigit(out: &str, ch: &str, cnt: int, group: bool, cul: &Cul): str {
    var sep = ""
    if group && cnt > 0 && (if cul.indian { cnt == 3 || (cnt > 3 && (cnt - 3) % 2 == 0) } else { cnt % 3 == 0 }) { sep = cul.grp.clone() }
    return ch + sep + out
}

fn renderSection(d0: &Decimal, sec: &str, cul: &Cul): str {
    let sc = scanSection(d0, sec)
    let tk = &sc.tk
    let ps = parts(&sc.d, sc.nf)
    var ip = ps[0].clone()
    if ip == "0" && sc.intZeros == 0 { ip = "" }
    let full = ps[1].clone()
    var trim = ps[1].clone()
    while len(trim) > sc.fz && trim[len(trim) - 1] == '0' { trim = trim[0..len(trim) - 1].toStr() }
    // the integer part, from its right
    let nInt = if sc.dpAt >= 0 { sc.dpAt } else { len(tk) }
    var out = ""
    var di = len(ip) - 1
    var cnt = 0
    for r in 0..nInt {
        let i = nInt - 1 - r
        let k = tk[i].kind
        if k == 1 || k == 2 {
            if di >= 0 {
                out = prependDigit(&out, &(ip[di..di + 1].toStr()), cnt, sc.group, cul)
                cnt += 1
                di -= 1
            } else if k == 1 {
                out = prependDigit(&out, "0", cnt, sc.group, cul)
                cnt += 1
            }
            if i == sc.firstPh {
                while di >= 0 {
                    out = prependDigit(&out, &(ip[di..di + 1].toStr()), cnt, sc.group, cul)
                    cnt += 1
                    di -= 1
                }
            }
        } else if k == 0 || k == 5 { out = tk[i].text + out }
    }
    // the fraction, from its left
    var fr = ""
    var printed = 0
    if sc.dpAt >= 0 {
        var fi = 0
        let from = sc.dpAt + 1
        for i in from..len(tk) {
            let k = tk[i].kind
            if k == 1 {
                fr += (if fi < len(full) { full[fi..fi + 1].toStr() } else { "0" })
                printed += 1
                fi += 1
            } else if k == 2 {
                if fi < len(trim) {
                    fr += &(trim[fi..fi + 1].toStr())
                    printed += 1
                }
                fi += 1
            } else if k == 0 || k == 5 { fr += &tk[i].text }
        }
    }
    return out + (if sc.dpAt >= 0 && printed > 0 { cul.dec.clone() } else { "" }) + fr
}

fn custom(d0: &Decimal, f0: &str, cul: &Cul): str {
    let secs = splitSections(f0)
    let neg = d0.isNeg()
    var si = 0
    if len(secs) >= 2 && neg { si = 1 }
    if sectionZero(d0, &secs[si]) { si = if len(secs) >= 3 { 2 } else { 0 } }
    if len(secs[si]) == 0 { si = 0 }
    let auto = si == 0 && neg && !sectionZero(d0, &secs[0])
    return (if auto { "-" } else { "" }) + renderSection(d0, &secs[si], cul)
}

// ---- dates and times (en-US)

// The first character of s (UTF-8).
fn firstChar(s: &str): str {
    if len(s) == 0 { return "" }
    let c = int(s[0])
    let n = if c < 0x80 { 1 } else if c < 0xe0 { 2 } else if c < 0xf0 { 3 } else { 4 }
    return s[0..min(n, len(s))].toStr()
}

fn floorDiv(a: int, b: int): int {
    let q = a / b
    return if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// A time's FORMAT (SQL Server hands .NET a TimeSpan): c, t and T the constant form (the fraction as 7 digits when there is one),
// g the short and G the long, or a custom one of h, m, s, f, F with their literals escaped; any other is NULL.
fn timeFormat(us: int, f: &str): Result[Val, DbErr] {
    let h = us / 3600000000
    let mi = us / 60000000 % 60
    let se = us / 1000000 % 60
    let frac = strings.padLeft(&((us % 1000000).toStr()), 6, '0') + "0"
    let hh = strings.padLeft(&(h.toStr()), 2, '0')
    let mm = strings.padLeft(&(mi.toStr()), 2, '0')
    let ss = strings.padLeft(&(se.toStr()), 2, '0')
    var trimmed = frac.clone()
    while len(trimmed) > 0 && trimmed[len(trimmed) - 1] == '0' { trimmed = trimmed[0..len(trimmed) - 1].toStr() }
    if len(f) == 0 || f == "c" || f == "t" || f == "T" { return Ok(Val.Text(hh + ":" + mm + ":" + ss + (if us % 1000000 != 0 { "." + frac } else { "" }))) }
    if f == "g" { return Ok(Val.Text(h.toStr() + ":" + mm + ":" + ss + (if len(trimmed) > 0 { "." + trimmed } else { "" }))) }
    if f == "G" { return Ok(Val.Text("0:" + hh + ":" + mm + ":" + ss + "." + frac)) }
    if len(f) == 1 && f != "%" { return Ok(Val.Null) }
    var out = ""
    var i = 0
    let n = len(f)
    while i < n {
        let c = f[i]
        var k = 1
        while i + k < n && f[i + k] == c { k += 1 }
        if c == '\'' || c == '"' {
            var j = i + 1
            while j < n && f[j] != c {
                out.addByte(f[j])
                j += 1
            }
            i = j + 1
            continue
        }
        if c == '\\' && i + 1 < n {
            out.addByte(f[i + 1])
            i += 2
            continue
        }
        if c == '%' && i + 1 < n {
            i += 1
            continue
        }
        if c == 'h' && k <= 2 { out += if k == 1 { h.toStr() } else { hh.clone() } }
        else if c == 'm' && k <= 2 { out += if k == 1 { mi.toStr() } else { mm.clone() } }
        else if c == 's' && k <= 2 { out += if k == 1 { se.toStr() } else { ss.clone() } }
        else if c == 'd' && k <= 8 { out += strings.padLeft(&"0", k, '0') }
        else if (c == 'f' || c == 'F') && k <= 7 {
            var fs = frac[0..k].toStr()
            if c == 'F' { while len(fs) > 0 && fs[len(fs) - 1] == '0' { fs = fs[0..len(fs) - 1].toStr() } }
            out += fs
        } else { return Ok(Val.Null) }
        i += k
    }
    return Ok(Val.Text(out))
}

fn dateFormat(us: int, f: &str, dc: &DCul): Result[Val, DbErr] {
    if len(f) == 0 { return dateFormat(us, &"G", dc) }
    if len(f) == 1 {
        // the standard ones
        let pat = match f.toStr() {
            "d" { dc.d.clone() }
            "D" { dc.D.clone() }
            "t" { dc.t.clone() }
            "T" { dc.T.clone() }
            "f" { dc.D + " " + dc.t }
            "F" { dc.D + " " + dc.T }
            "g" { dc.d + " " + dc.t }
            "G" { dc.d + " " + dc.T }
            "M", "m" { dc.M.clone() }
            "Y", "y" { dc.Y.clone() }
            "s" { "yyyy'-'MM'-'dd'T'HH':'mm':'ss" }
            "u" { "yyyy'-'MM'-'dd HH':'mm':'ss'Z'" }
            else { "" }
        }
        if len(pat) == 0 { return Ok(Val.Null) }
        return Ok(Val.Text(customDate(us, &pat, dc)))
    }
    return Ok(Val.Text(customDate(us, f, dc)))
}

fn customDate(us: int, f: &str, dc: &DCul): str {
    let days = floorDiv(us, lexdb_time.DAY_US)
    let tod = us - days * lexdb_time.DAY_US
    let dt = lexdb_time.dateOf(days)
    let wd = ((days + 6) % 7 + 7) % 7
    let h = tod / 3600000000
    let mi = tod / 60000000 % 60
    let se = tod / 1000000 % 60
    let frac = tod % 1000000
    var out = ""
    var i = 0
    let n = len(f)
    while i < n {
        let c = f[i]
        var k = 1
        while i + k < n && f[i + k] == c { k += 1 }
        if c == '\'' || c == '"' {
            var j = i + 1
            while j < n && f[j] != c {
                out.addByte(f[j])
                j += 1
            }
            i = j + 1
            continue
        }
        if c == '\\' && i + 1 < n {
            out.addByte(f[i + 1])
            i += 2
            continue
        }
        if c == '%' && i + 1 < n {
            i += 1
            continue
        }
        if c == 'y' {
            let yr = dt.year + dc.yoff
            if k == 1 { out += (yr % 100).toStr() }
            else if k == 2 { out += strings.padLeft(&((yr % 100).toStr()), 2, '0') }
            else { out += strings.padLeft(&(yr.toStr()), k, '0') }
        } else if c == 'M' {
            if k == 1 { out += dt.month.toStr() }
            else if k == 2 { out += strings.padLeft(&(dt.month.toStr()), 2, '0') }
            else if k == 3 {
                if genitive(f, i, k) { out += &dc.monGA[dt.month - 1] } else { out += &dc.monA[dt.month - 1] }
            } else {
                if genitive(f, i, k) { out += &dc.monG[dt.month - 1] } else { out += &dc.mon[dt.month - 1] }
            }
        } else if c == 'd' {
            if k == 1 { out += dt.day.toStr() }
            else if k == 2 { out += strings.padLeft(&(dt.day.toStr()), 2, '0') }
            else if k == 3 { out += &dc.dayA[wd] }
            else { out += &dc.day[wd] }
        } else if c == 'H' {
            out += if k == 1 { h.toStr() } else { strings.padLeft(&(h.toStr()), 2, '0') }
        } else if c == 'h' {
            let h12 = if h % 12 == 0 { 12 } else { h % 12 }
            out += if k == 1 { h12.toStr() } else { strings.padLeft(&(h12.toStr()), 2, '0') }
        } else if c == 'm' {
            out += if k == 1 { mi.toStr() } else { strings.padLeft(&(mi.toStr()), 2, '0') }
        } else if c == 's' {
            out += if k == 1 { se.toStr() } else { strings.padLeft(&(se.toStr()), 2, '0') }
        } else if c == 'f' || c == 'F' {
            // the fraction's first k digits of seven (lexdb keeps six)
            var fs = strings.padLeft(&(frac.toStr()), 6, '0') + "0"
            fs = fs[0..min(k, 7)].toStr()
            if c == 'F' { while len(fs) > 0 && fs[len(fs) - 1] == '0' { fs = fs[0..len(fs) - 1].toStr() } }
            out += fs
        } else if c == 't' {
            let am = if h < 12 { dc.am.clone() } else { dc.pm.clone() }
            out += if k == 1 { firstChar(&am) } else { am }
        } else if c == '/' {
            for x in 0..k { out += &dc.sep }
        } else if c == ':' {
            for x in 0..k { out += &dc.tsep }
        } else {
            for x in 0..k { out.addByte(c) }
        }
        i += k
    }
    return out
}

// Whether the month name at f[at..at + klen] is the genitive one (.NET's): a day of the month, d or dd, is in the pattern outside the quotes,
// the nearest run of d's before the name looked at first, then the nearest after it.
fn genitive(f: &str, at: int, klen: int): bool {
    var before = 0          // the length of the last run of d's before the name (0 none)
    var after = 0           // ... of the first after it
    var i = 0
    let n = len(f)
    while i < n {
        let c = f[i]
        if c == '\'' || c == '"' {
            i += 1
            while i < n && f[i] != c { i += 1 }
            i += 1
            continue
        }
        if c == '\\' { i += 2; continue }
        if c == 'd' {
            var k = 1
            while i + k < n && f[i + k] == 'd' { k += 1 }
            if i < at { before = k } else if i >= at + klen && after == 0 { after = k }
            i += k
            continue
        }
        i += 1
    }
    return (before > 0 && before <= 2) || (after > 0 && after <= 2)
}
