    "fr~ ~,~ ~,~0~{n} €~-{n} €~{n} %~-{n} %",
    "es~.~,~.~,~0~{n} €~-{n} €~{n} %~-{n} %",
    "it~.~,~.~,~0~{n} €~-{n} €~{n}%~-{n}%",
