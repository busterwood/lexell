    "sv~ ~,~ ~,~0~{n} kr~-{n} kr~{n} %~-{n} %",
    "ru~ ~,~ ~,~0~{n} ₽~-{n} ₽~{n}%~-{n}%",
    "zh~,~.~,~.~0~¥{n}~¥-{n}~{n}%~-{n}%",
    "ko~,~.~,~.~0~₩{n}~-₩{n}~{n}%~-{n}%",
    "pl~ ~,~ ~,~0~{n} zł~-{n} zł~{n}%~-{n}%",
