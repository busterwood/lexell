// lexdb_tsqlfmt: T-SQL's FORMAT(value, format [, culture]) (design/lexdb-new-features.md, S21), the .NET format strings
// SQL Server hands its values to: for numbers the standard ones (N, F, D, X, P, C, E, G, each with a precision) and the
// custom ones (0, #, the group separator, a decimal point, %, literals); for dates and times the standard ones (d, D,
// t, T, f, F, g, G, M, Y, s, u) and the custom ones (yyyy, MM, dd, HH, mm, ss, fff, tt, ...). The culture en-US
// (SQL Server's default under us_english); de-DE swaps the separators of the numbers. A format .NET refuses gives NULL,
// as SQL Server's. Checked against SQL Server 2025 (tests/lexdb/run/tds_newfix.lxl).
import "strings"
import "./lexdb_base"
import "./lexdb_sql"
import "./lexdb_time"

type Val = lexdb_sql.Val
type DbErr = lexdb_base.DbErr

fn e(state: &str, msg: &str): DbErr { return lexdb_base.err(state, msg) }

// A culture's numbers: the separators of numbers (grp, dec) and of currency (cgrp, cdec), whether it groups the way India does (the
// last three digits, then twos), and the patterns of C and P, positive and negative, "{n}" the number.
type Cul = value record { grp: str; dec: str; cgrp: str; cdec: str; indian: bool; cpos: str; cneg: str; ppos: str; pneg: str }

// The cultures SQL Server 2022 knows and lexdb has the numbers of, as it answers FORMAT(x, 'N2' | 'C2' | 'P2', culture) (read from it:
// the fields are name ; group ; decimal ; currency group ; currency decimal ; India's grouping ; C ; C negative ; P ; P negative,
// divided by "~"). Another name of the same form (a language, then optional parts) is the invariant culture's: ',' and '.', ¤ for
// the currency; one that is not of that form is error 9818.
const NUMCULS: []str = [
    "en-US~,~.~,~.~0~${n}~(${n})~{n}%~-{n}%",
    "en-GB~,~.~,~.~0~£{n}~-£{n}~{n}%~-{n}%",
