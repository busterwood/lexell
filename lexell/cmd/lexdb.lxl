// lexdb: a small SQL server on disk behind the PostgreSQL wire protocol
// (design/lexdb.md).
//
//     lexdb DATADIR [ADDR ...]
//
// DATADIR is made when it does not exist. Each ADDR is listened on:
// - HOST:PORT, TCP; with no ADDR, 127.0.0.1:5433;
// - a directory (an ADDR with a "/"): a Unix socket in it named as
//   PostgreSQL names one, .s.PGSQL.PORT, PORT the first TCP address's (5433
//   without one), so `psql -h DIR -p PORT` finds it;
// - any other path with a "/": the Unix socket file itself.
// A socket file left by a server that is gone is replaced; one a server
// still answers on is an error. The files are removed when lexdb stops.
// One server per DATADIR: a second one exits 1 ("in use") while the first
// holds DATADIR/lock (flock; the kernel drops it when the process ends,
// however it ends).
// There is no authentication yet: keep TCP on loopback, and a socket in a
// directory only its users can reach. SIGTERM or SIGINT stops it: no new
// connections, the open ones are cut off, and the log is flushed before it
// exits.
import "task"
import "net"
import "io"
import "os"
import "fs"
import "strings"
import "./lexdb_base"
import "./lexdb_disk"
import "./lexdb_store"
import "./lexdb_exec"
import "./lexdb_wire"
import "./lexdb_tds"
import "./lexdb_tns"
import "./lexdb_repl"

extern "c" fn openLock(path: &str, flags: i32, mode: u32): i32 as "open"
extern "c" fn flock(fd: i32, op: i32): i32
extern "c" fn lockErrno(): int as "lxl_errno"
extern "c" fn lockStrerror(e: i32): str as "strerror"
extern "c" fn closeDir(fd: i32): i32 as "close"
extern "c" fn ioctlFlags(fd: i32, req: int, flags: mut &int): i32 as "ioctl"

// Copy-on-write off for the files made in the data directory (design/lexdb.md
// 9.61): on btrfs an O_DIRECT write to a copy-on-write file must allocate,
// so io_uring hands every log write to a kernel worker, and a flush costs
// more. Its checksums are not needed: every page carries a CRC32C. Set on
// the directory, the flag (FS_NOCOW_FL) is taken by files created in it;
// a file that already has data keeps copy-on-write. Other file systems
// refuse the flag, and any failure is ignored: it is an optimisation.
fn noCow(dir: &str) {
    let fd = openLock(dir, i32(65536 | 524288), u32(0))           // O_RDONLY|O_DIRECTORY|O_CLOEXEC
    if fd < 0 { return }
    var fl = 0                                                      // the kernel uses the low 4 bytes
    if ioctlFlags(fd, 0x80086601, mut &fl) == 0 && (fl & 0x800000) == 0 {     // FS_IOC_GETFLAGS
        fl = fl | 0x800000                                          // FS_NOCOW_FL
        ioctlFlags(fd, 0x40086602, mut &fl)                        // FS_IOC_SETFLAGS
    }
    closeDir(fd)
}

// lexdb DATADIR [ADDR ...] [--replicas N [--replica-addr ADDR ...]]
// lexdb --replica DATADIR [ADDR ...]
//
// ADDR: host:port (TCP), or a directory for a Unix socket (.s.PGSQL.<the
// first TCP port>, as PostgreSQL names it). With --replicas N the process
// supervises the master and N read-only replicas (design/lexdb.md 9.73),
// each a process of its own, started again when it ends badly; the
// replicas serve --replica-addr (by default each of ADDR with the port one
// higher), sharing its TCP port (SO_REUSEPORT) and its Unix socket.
// --replica runs one replica by hand, of a master already serving DATADIR.
//
// Replicas in every door (design/lexdb.md 9.137): --replica takes --tds,
// --tns and --tcps for its own listeners; under --replicas N the replicas
// serve --replica-tds, --replica-tns and --replica-tcps (by default each of
// the master's --tds, --tns, --tcps with the port one higher, shared with
// SO_REUSEPORT). Each door answers as its product's read-only secondary.
//
// Authentication (design/lexdb.md 9.81): --auth METHOD for TCP connections,
// --auth-local METHOD for Unix socket ones: trust (the default for both) or
// scram-sha-256 (a role's password, CREATE ROLE ... PASSWORD). TLS with
// --tls-cert FILE [--tls-key FILE] (PEM; the key may be in the certificate's
// file); --require-tls refuses TCP connections without it.
//
// --tds HOST:PORT (repeatable): the master also speaks SQL Server's
// protocol, TDS 7.4, there (design/lexdb-tds.md; SQL Server's port is
// 1433), with the same roles, authentication and TLS settings.
//
// --tns HOST:PORT (repeatable): the master also speaks Oracle's protocol,
// TNS with TTC, there (design/lexdb-oracle.md; Oracle's port is 1521, which
// is never a default), logins by the roles' Oracle 12c verifiers.
// --tns-ro-service NAME: the read-only service the master redirects to a
// replica (default lexdb_ro and freepdb1_ro).
//
// --unsafe-no-sync: TESTS ONLY. Commits and checkpoints never wait for
// fdatasync/fsync (data is still written, so a clean stop and restart keeps
// everything; a power cut or kernel crash may lose or corrupt it). It
// reaches every worker (they are forks) and replicas; a warning is printed.
// --log-dir DIR: the write-ahead log segments in DIR (made when the data
// directory is new), apart from the data file. A data directory made with it
// is refused without it or with another log directory, and one made without it
// is refused with it, so the wrong log is never replayed (design/lexdb.md
// 9.124). --replica and the supervised replicas follow the same log directory.
// --cache-mb N: the cache budget of each server in MB (1 to 1048576), in
// place of a quarter of the memory; it beats LEXDB_CACHE_MB.
var CACHE_MB: int = 0

// --log-dir DIR (design/lexdb.md 9.124): the log segments' directory, "" for the data directory's own.
// Set once at start, before any worker process is made (a worker is a fork, so it keeps it).
var LOG_DIR: str = ""

// The exit code of a master that cannot start (a refused log directory, the data directory's lock held, a store that will not open,
// a listener that will not bind): 1, and under --replicas EXIT_REFUSED, which the supervisor does not restart (design/lexdb.md 9.126).
const EXIT_REFUSED = 3
var START_FAIL: int = 1

// The log's file system: the data directory's own, or the one --log-dir names.
fn logFs(dir: &str): lexdb_disk.Fs {
    if LOG_DIR == "" { return lexdb_disk.real(dir) }
    let d = LOG_DIR.clone()
    return lexdb_disk.real(&d)
}

// The MB of --cache-mb or LEXDB_CACHE_MB: 1 to 1048576 (1 TB), else None.
fn parseCacheMb(v: &str): Option[int] {
    match strings.parseIntOpt(&v) {
        Some(mb) {
            if mb >= 1 && mb <= 1048576 { return Some(mb) }
            return None
        }
        None { return None }
    }
}

fn main() {
    let args = os.arguments()
    var replica = false
    var replicas = 0
    var raddrs: []str = []
    var tdsAddrs: []str = []
    var tnsAddrs: []str = []
    var rtds: []str = []
    var rtns: []str = []
    var pos: []str = []
    var noSync = false
    var auth = lexdb_wire.noAuth()
    var i = 0
    while i < len(args) {
        let a = args[i].clone()
        if a == "--replica" {
            replica = true
        } else if a == "--unsafe-no-sync" {
            noSync = true
        } else if a == "--log-dir" {
            if i + 1 >= len(args) || len(args[i + 1]) == 0 || strings.startsWith(&args[i + 1], "--") { usage() }
            LOG_DIR = args[i + 1].clone()
            i += 1
        } else if a == "--cache-mb" {
            if i + 1 >= len(args) { usage() }
            match parseCacheMb(&(args[i + 1])) {
                Some(mb) { CACHE_MB = mb }
                None {
                    eprintln("lexdb: --cache-mb: a whole number of MB from 1 to 1048576, not " + args[i + 1])
                    exit(2)
                }
            }
            i += 1
        } else if a == "--require-tls" {
            auth.requireTls = true
        } else if a == "--auth" || a == "--auth-local" || a == "--tls-cert" || a == "--tls-key" {
            if i + 1 >= len(args) { usage() }
            let v = args[i + 1].clone()
            if a == "--auth" { auth.tcp = v } else if a == "--auth-local" { auth.local = v } else if a == "--tls-cert" { auth.cert = v } else { auth.key = v }
            i += 1
        } else if a == "--tds" {
            // SQL Server's protocol (design/lexdb-tds.md): TCP only
            if i + 1 >= len(args) || strings.indexOf(&args[i + 1], "/", 0) >= 0 { usage() }
            append(mut &tdsAddrs, args[i + 1].clone())
            i += 1
        } else if a == "--tns" {
            // Oracle's protocol (design/lexdb-oracle.md): TCP only
            if i + 1 >= len(args) || strings.indexOf(&args[i + 1], "/", 0) >= 0 { usage() }
            append(mut &tnsAddrs, args[i + 1].clone())
            i += 1
        } else if a == "--tcps" {
            // Oracle's protocol inside TLS (TCPS), with the certificate of --tls-cert; kept with --tns's, marked
            if i + 1 >= len(args) || strings.indexOf(&args[i + 1], "/", 0) >= 0 { usage() }
            append(mut &tnsAddrs, "tcps:" + args[i + 1])
            i += 1
        } else if a == "--replica-tds" || a == "--replica-tns" || a == "--replica-tcps" {
            // the supervised replicas' own listeners for a door (9.137): TCP only
            if i + 1 >= len(args) || strings.indexOf(&args[i + 1], "/", 0) >= 0 { usage() }
            if a == "--replica-tds" {
                append(mut &rtds, args[i + 1].clone())
            } else if a == "--replica-tns" {
                append(mut &rtns, args[i + 1].clone())
            } else {
                append(mut &rtns, "tcps:" + args[i + 1])
            }
            i += 1
        } else if a == "--tns-ro-service" {
            // the Oracle read-only service the master redirects to a replica (9.137)
            if i + 1 >= len(args) || len(args[i + 1]) == 0 { usage() }
            lexdb_tns.setReadOnlyService(&args[i + 1])
            i += 1
        } else if a == "--replicas" || a == "--replica-addr" {
            if i + 1 >= len(args) { usage() }
            if a == "--replicas" {
                replicas = strings.parseIntOpt(&args[i + 1]).unwrapOr(-1)
                if replicas < 0 || replicas > 64 { usage() }
            } else {
                append(mut &raddrs, args[i + 1].clone())
            }
            i += 1
        } else if strings.startsWith(&a, "--") {
            usage()
        } else {
            append(mut &pos, a)
        }
        i += 1
    }
    if len(pos) < 1 || (replica && replicas > 0) || (replicas == 0 && (len(rtds) > 0 || len(rtns) > 0)) { usage() }
    match lexdb_wire.checkAuth(&auth) {
        Ok(_) {}
        Err(msg) {
            eprintln("lexdb: " + msg)
            exit(2)
        }
    }
    // LEXDB_LOG_DSYNC=0: the log written then fdatasync'd, not O_DSYNC (design/lexdb.md 9.131)
    match os.env("LEXDB_LOG_DSYNC") {
        Some(v) { if v == "0" { lexdb_disk.setLogDsync(false) } }
        None {}
    }
    if noSync {
        lexdb_disk.setNoSync(true)
        eprintln("lexdb: WARNING: --unsafe-no-sync: nothing is synced to disk; a power cut or kernel crash can lose or corrupt the data. For tests only.")
    }
    let dir = pos[0].clone()
    var addrs: []str = []
    for k in 1..len(pos) { append(mut &addrs, pos[k].clone()) }
    if len(addrs) == 0 { append(mut &addrs, if replica { "127.0.0.1:5434" } else { "127.0.0.1:5433" }) }
    if os.env("LXL_HELPERS").isNone() { os.setEnv("LXL_HELPERS", "32") }   // reads in flight (section 3)
    if replica {
        let none: []net.Listener = []
        runReplica(dir, &addrs, &tdsAddrs, &tnsAddrs, opts0(), false, none, 10000, &auth)
        return
    }
    match fs.mkdirAll(&dir) {
        Ok(_) {}
        Err(e) {
            eprintln("lexdb: " + dir + ": " + e.toStr())
            exit(1)
        }
    }
    noCow(&dir)
    if replicas == 0 {
        runMaster(dir, &addrs, &tdsAddrs, &tnsAddrs, &auth)
        return
    }
    supervise(dir, &addrs, &tdsAddrs, &tnsAddrs, replicas, &raddrs, &rtds, &rtns, &auth)
}

fn usage() {
    eprintln("usage: lexdb DATADIR [ADDR ...] [--tds HOST:PORT ...] [--tns HOST:PORT ...] [--tcps HOST:PORT ...] [--tns-ro-service NAME]")
    eprintln("             [--replicas N [--replica-addr ADDR ...] [--replica-tds HOST:PORT ...] [--replica-tns HOST:PORT ...] [--replica-tcps HOST:PORT ...]]")
    eprintln("             [--log-dir DIR] [--cache-mb N] [--unsafe-no-sync] [AUTH]")
    eprintln("       lexdb --replica DATADIR [ADDR ...] [--tds HOST:PORT ...] [--tns HOST:PORT ...] [--tcps HOST:PORT ...] [--tns-ro-service NAME]")
    eprintln("             [--log-dir DIR] [--cache-mb N] [--unsafe-no-sync] [AUTH]")
    eprintln("--replica-tds/-tns/-tcps: the supervised replicas' listeners for a door (default: each of the master's, the port one up)")
    eprintln("--tns-ro-service NAME: the Oracle service the master redirects to a replica (default lexdb_ro and freepdb1_ro)")
    eprintln("--log-dir DIR: the write-ahead log in DIR, not in DATADIR (e.g. another device); fixed when DATADIR is made, and then required, with --replica too")
    eprintln("--cache-mb N: the cache budget in MB (1 to 1048576; default a quarter of the memory)")
    eprintln("--unsafe-no-sync: TESTS ONLY: never fsync; a power cut can lose or corrupt data")
    eprintln("AUTH:  [--auth trust|scram-sha-256] [--auth-local trust|scram-sha-256]")
    eprintln("       [--tls-cert FILE [--tls-key FILE]] [--require-tls]")
    exit(2)
}

// The master and n replicas, each a worker process (task.workers): worker
// 0 the master, the others replicas. A worker that ends badly is started
// again; a replica ends when its master does, and so is started again with
// it. SIGTERM or SIGINT stops them all.
fn supervise(dir: &str, addrs: &[]str, tdsAddrs: &[]str, tnsAddrs: &[]str, n: int, given: &[]str, givenTds: &[]str, givenTns: &[]str,
             auth: &lexdb_wire.AuthConf) {
    // the replicas' addresses: given, or each of the master's one port up
    var raddrs: []str = []
    for a in given { append(mut &raddrs, a.clone()) }
    if len(raddrs) == 0 {
        for a in addrs {
            if strings.contains(&a, "/") {
                append(mut &raddrs, a.clone())
            } else {
                append(mut &raddrs, portUp(&a, "--replica-addr"))
            }
        }
    }
    // and for the other doors (9.137): given, or each of the master's for that door one port up
    var rtds: []str = []
    for a in givenTds { append(mut &rtds, a.clone()) }
    if len(rtds) == 0 { for a in tdsAddrs { append(mut &rtds, portUp(&a, "--replica-tds")) } }
    var rtns: []str = []
    for a in givenTns { append(mut &rtns, a.clone()) }
    if len(rtns) == 0 {
        for a in tnsAddrs {
            if strings.startsWith(&a, "tcps:") {
                append(mut &rtns, "tcps:" + portUp(&(a[5..len(a)].toStr()), "--replica-tcps"))
            } else {
                append(mut &rtns, portUp(&a, "--replica-tns"))
            }
        }
    }
    // their Unix sockets, made here: every replica accepts from them (a
    // Unix socket's path cannot be shared with SO_REUSEPORT)
    var tcpPort = ""
    for a in raddrs {
        if !strings.contains(&a, "/") && tcpPort == "" {
            let c = strings.lastIndexOf(&a, ":")
            if c >= 0 { tcpPort = a[c + 1..len(a)].clone() }
        }
    }
    var shared: []net.Listener = []
    var files: []str = []
    for a in raddrs {
        if !strings.contains(&a, "/") { continue }
        if tcpPort == "" {
            eprintln("lexdb: the replicas' Unix socket is named by their TCP port: give one with --replica-addr")
            exit(2)
        }
        let path = if strings.endsWith(&a, "/") { a + ".s.PGSQL." + tcpPort } else { a + "/.s.PGSQL." + tcpPort }
        match lexdb_wire.clearStale(&path) {
            Ok(_) {}
            Err(msg) {
                eprintln("lexdb: " + msg)
                exit(1)
            }
        }
        match net.listenUnix(&path) {
            Ok(ln) {
                append(mut &files, path)
                append(mut &shared, ln)
            }
            Err(e) {
                eprintln("lexdb: listen " + path + ": " + e.toStr())
                exit(1)
            }
        }
    }
    var tcp: []str = []
    for a in raddrs { if !strings.contains(&a, "/") { append(mut &tcp, a.clone()) } }
    println("lexdb: supervising a master and " + n.toStr() + " replica" + (if n == 1 { "" } else { "s" }) + " of " + dir)
    let fl = io.flushStdout()
    var policy = task.workerPolicy()
    policy.maxBackoffMs = 2000
    policy.fatalCode = EXIT_REFUSED
    START_FAIL = EXIT_REFUSED
    let ends = task.workersWith(n + 1, policy, fn(w: int) {
        if w == 0 {
            runMaster(dir, addrs, tdsAddrs, tnsAddrs, auth)
        } else {
            // each replica a copy of the shared sockets (this process's own
            // memory: the supervisor keeps its)
            runReplica(dir, &tcp, &rtds, &rtns, opts0(), true, replace(mut &shared, []), 60000, auth)
        }
    })
    for f in files { let gone = fs.remove(&f) }
    match ends {
        Ok(_) {}
        Err(g) {
            var refused = false
            for e in g.ends { if e.code == EXIT_REFUSED && !e.drained { refused = true } }
            if refused {
                eprintln("lexdb: the master was refused at start-up (see the message above): stopped, not restarted")
            } else {
                eprintln("lexdb: the workers ended too often (" + g.crashes.toStr() + " times): stopped")
            }
            exit(1)
        }
    }
}

// HOST:PORT with the port one higher (a replica's default address), else
// exit 2 naming the flag that gives one.
fn portUp(a: &str, flag: &str): str {
    let c = strings.lastIndexOf(a, ":")
    let port = if c < 0 { -1 } else { strings.parseIntOpt(a[c + 1..len(a)]).unwrapOr(-1) }
    if port <= 0 {
        eprintln("lexdb: --replicas needs the master's TCP port to pick the replicas' (or " + flag + "): " + a)
        exit(2)
    }
    return a[0..c + 1] + (port + 1).toStr()
}

// The SQL Server and Oracle doors' listeners (TCP only): TDS on tdsAddrs,
// TNS and TCPS on tnsAddrs (TCPS's marked "tcps:"), each printed as it
// listens (who: "" for the master, "replica " for a replica); with
// reusePort each with SO_REUSEPORT (the supervised replicas share a port).
// names: per listener its door and address, "tds 127.0.0.1:1434", which a
// replica announces to its master (lexdb.md 9.137).
type Doors = record { tds: []net.Listener; tns: []net.Listener; tcps: []net.Listener; names: []str }

fn listenDoors(tdsAddrs: &[]str, tnsAddrs: &[]str, reusePort: bool, who: &str): Result[Doors, str] {
    var d = Doors{tds: [], tns: [], tcps: [], names: []}
    for door in ["tds", "tns", "tcps"] {
        var want: []str = []
        if door == "tds" {
            for a in tdsAddrs { append(mut &want, a.clone()) }
        } else {
            for ta in tnsAddrs {
                if strings.startsWith(&ta, "tcps:") == (door == "tcps") { append(mut &want, if door == "tcps" { ta[5..len(ta)].toStr() } else { ta.clone() }) }
            }
        }
        if len(want) == 0 { continue }
        var lns: []net.Listener = []
        if reusePort {
            for a in want {
                match net.listenReusePort(&a) {
                    Ok(ln) { append(mut &lns, ln) }
                    Err(e) { return Err((if door == "tds" { "tds" } else { "tns" }) + ": listen " + a + ": " + e.toStr()) }
                }
            }
        } else {
            var files: []str = []
            match lexdb_wire.listenAll(&want, mut &files) {
                Ok(x) { lns = x }
                Err(msg) { return Err((if door == "tds" { "tds" } else { "tns" }) + ": " + msg) }
            }
        }
        var tn: []str = []
        for ln in lns {
            append(mut &tn, ln.localAddr())
            append(mut &d.names, door + " " + ln.localAddr())
        }
        let what = if door == "tds" { "TDS (SQL Server)" } else if door == "tns" { "TNS (Oracle)" } else { "TCPS (Oracle over TLS)" }
        println("lexdb: " + who + what + " on " + strings.join(&tn, ", "))
        let fl = io.flushStdout()
        if door == "tds" { d.tds = lns } else if door == "tns" { d.tns = lns } else { d.tcps = lns }
    }
    return Ok(d)
}

// The master: the data directory's lock, the store, its listeners and the
// replication socket, until SIGTERM or SIGINT.
fn runMaster(dir: &str, addrs: &[]str, tdsAddrs: &[]str, tnsAddrs: &[]str, auth: &lexdb_wire.AuthConf) {
    // One server per data directory: two writing the same files would
    // corrupt them (a benchmark started a second server while the first
    // still wrote its shutdown checkpoint, 9.58). The lock is held, its
    // descriptor open, until the process ends.
    let lockPath = dir + "/lock"
    let lfd = openLock(lockPath, i32(2 | 64 | 524288), u32(384))    // O_RDWR|O_CREAT|O_CLOEXEC, 0600
    if lfd < 0 {
        eprintln("lexdb: " + lockPath + ": " + lockStrerror(i32(lockErrno())))
        exit(START_FAIL)
    }
    if flock(lfd, i32(2 | 4)) != 0 {                                // LOCK_EX|LOCK_NB
        let e = lockErrno()
        if e == 11 {                                                // EWOULDBLOCK
            eprintln("lexdb: " + dir + " is in use by another lexdb (" + lockPath + " is locked)")
        } else {
            eprintln("lexdb: " + lockPath + ": " + lockStrerror(i32(e)))
        }
        exit(START_FAIL)
    }
    task.watchSignals(&[task.SIGTERM, task.SIGINT])
    // LEXDB_CACHE_MB: the cache's budget (lexdb_store.Options.cacheBytes);
    // without it a quarter of the memory, 128 MB at least (9.54): the data
    // file is read past the kernel's cache (O_DIRECT), so this cache is all
    // there is
    let opts = opts0()
    let opened = if LOG_DIR == "" { lexdb_store.open(lexdb_disk.real(&dir), opts) } else { lexdb_store.openSplit(lexdb_disk.real(&dir), logFs(&dir), opts) }
    if opened.isErr() {
        eprintln("lexdb: open " + dir + ": " + opened.unwrapErr().toStr())
        exit(START_FAIL)
    }
    let st = opened.unwrap()
    if LOG_DIR != "" {
        let ld = LOG_DIR.clone()
        noCow(&ld)
    }
    var code = 0
    task.scope(fn(s: mut &task.Scope) {
        s.spawn(lexdb_store.writer, st.share())
        s.spawn(lexdb_store.checkpointer, st.share())
        match lexdb_exec.bootstrap(&st) {
            Ok(_) {}
            Err(e) {
                eprintln("lexdb: " + e.toStr())
                code = START_FAIL
                st.close()
                return
            }
        }
        match lexdb_wire.configure(&st, auth) {
            Ok(_) {}
            Err(msg) {
                eprintln("lexdb: " + msg)
                code = START_FAIL
                st.close()
                return
            }
        }
        // replicas (--replica) connect here
        let repl = s.start(lexdb_repl.serve, lexdb_repl.Serve{st: st.share(), dir: dir.clone()})
        // the automatic statistics (optimizer 44): LEXDB_AUTOANALYZE=off
        // for none; their task ends at once then
        let auto = s.start(lexdb_exec.autoAnalyzer, st.share())
        var files: []str = []                       // the Unix sockets made: removed at the end
        match lexdb_wire.listenAll(addrs, mut &files) {
            Ok(lns) {
                var names: []str = []
                for ln in lns { append(mut &names, ln.localAddr()) }
                println("lexdb: listening on " + strings.join(&names, ", ") + ", data in " + dir)
                let fl = io.flushStdout()
                let ready = task.workerReady()             // (outside task.workers, nothing)
                let f = s.start(lexdb_wire.acceptAll, lexdb_wire.ListenArg{lns: lns, st: st.share()})
                // SQL Server's protocol on its own listeners (design/lexdb-tds.md), Oracle's likewise
                // (design/lexdb-oracle.md)
                var doors = Doors{tds: [], tns: [], tcps: [], names: []}
                match listenDoors(tdsAddrs, tnsAddrs, false, "") {
                    Ok(d) { doors = d }
                    Err(msg) {
                        eprintln("lexdb: " + msg)
                        code = START_FAIL
                    }
                }
                let g = s.start(lexdb_tds.acceptAll, lexdb_tds.ListenArg{lns: replace(mut &doors.tds, []), st: st.share()})
                let h = s.start(lexdb_tns.acceptAll, lexdb_tns.ListenArg{lns: replace(mut &doors.tns, []), st: st.share()})
                let h2 = s.start(lexdb_tns.acceptAllTls, lexdb_tns.ListenArg{lns: replace(mut &doors.tcps, []), st: st.share()})
                if code == 0 { let sig = task.terminated() }
                { let stop = h }
                { let stop = h2 }
                { let stop = g }
                { let stop = f }                       // cancels the accept loops and the connections
                println("lexdb: stopping")
            }
            Err(msg) {
                eprintln("lexdb: " + msg)
                code = START_FAIL
            }
        }
        { let stop = auto }
        { let stop = repl }                         // replicas see the link end
        for p in files { let gone = fs.remove(&p) }
        let ck = st.checkpointAll()
        let x = st.stats()
        println("lexdb: " + x.commits.toStr() + " commits, " + x.loads.toStr() + " pages read, " + x.evictions.toStr() +
                " evicted, " + x.checkpoints.toStr() + " checkpoints (" +
                x.pagesWritten.toStr() + " pages written, " + (x.logBytes / 1024).toStr() + " KB of log), " + x.held.toStr() + " commits held for one, cache " +
                (x.cacheUsed / 1048576).toStr() + " of " + (opts.cacheBytes / 1048576).toStr() + " MB")
        st.close()
    })
    if code != 0 { exit(code) }
}

// The machine's memory in bytes (/proc/meminfo's MemTotal), 0 when it is
// not known.
fn memBytes(): int {
    match io.read("/proc/meminfo") {
        Ok(text) {
            for line in strings.split(&text, &"\n") {
                if strings.startsWith(line, "MemTotal:") {
                    let f = strings.fields(&line)
                    if len(f) >= 2 {
                        match strings.parseIntOpt(f[1]) {
                            Some(kb) { return kb * 1024 }
                            None {}
                        }
                    }
                }
            }
        }
        Err(_) {}
    }
    return 0
}

// The environment variable name in KiB as bytes, else d.
fn envKb(name: &str, d: int): int {
    match os.env(&name) {
        Some(v) {
            match strings.parseIntOpt(&v) {
                Some(kb) { if kb > 0 { return kb * 1024 } }
                None {
                    eprintln("lexdb: " + name + ": not a number: " + v)
                    exit(2)
                }
            }
        }
        None {}
    }
    return d
}

// The store's options: the defaults, and the environment's.
fn opts0(): lexdb_store.Options {
    var opts = lexdb_store.defaults()
    opts.cacheBytes = max(opts.cacheBytes, memBytes() / 4)
    match os.env("LEXDB_CACHE_MB") {
        Some(v) {
            match parseCacheMb(&v) {
                Some(mb) { opts.cacheBytes = mb * 1024 * 1024 }
                None {
                    eprintln("lexdb: LEXDB_CACHE_MB: a whole number of MB from 1 to 1048576, not " + v)
                    exit(2)
                }
            }
        }
        None {}
    }
    if CACHE_MB > 0 { opts.cacheBytes = CACHE_MB * 1024 * 1024 }
    // LEXDB_SEG_KB, LEXDB_CKPT_KB: a log segment's size and the log bytes
    // between checkpoints (small for the crash test: tests/lexdb/crash.py)
    opts.segBytes = envKb("LEXDB_SEG_KB", opts.segBytes)
    opts.ckptBytes = envKb("LEXDB_CKPT_KB", opts.ckptBytes)
    return opts
}

// A read-only replica (--replica): follows the master of dir over its
// replication socket and serves addrs with the same SQL, refusing writes
// (25006). It stops when the master does (exit 1) or on SIGTERM/SIGINT.
fn runReplica(dir: &str, addrs: &[]str, tdsAddrs: &[]str, tnsAddrs: &[]str, opts: lexdb_store.Options, reusePort: bool, shared: []net.Listener,
              waitMs: int, auth: &lexdb_wire.AuthConf) {
    task.watchSignals(&[task.SIGTERM, task.SIGINT])
    var sharedLns = shared
    let conn = lexdb_repl.connect(&dir, if LOG_DIR == "" { None } else { Some(logFs(&dir)) }, opts, waitMs)
    if conn.isErr() {
        eprintln("lexdb: replica of " + dir + ": " + conn.unwrapErr().toStr())
        exit(1)
    }
    var rps = [conn.unwrap()]
    let st = rps[0].st.share()
    let ob = lexdb_repl.outboxOf(&rps[0])          // (the doors it serves are announced through it)
    var code = 0
    task.scope(fn(s: mut &task.Scope) {
        let task.Handoff{promise: p, future: ready} = task.promise[Unit]()
        let fol = s.start(lexdb_repl.follow, lexdb_repl.Follow{rp: pop(mut &rps), ready: p})
        if ready.wait().isErr() {
            eprintln("lexdb: replica: the link to the master ended before the replica was ready")
            code = 1
            return
        }
        match lexdb_exec.bootstrap(&st) {
            Ok(_) {}
            Err(e) {
                eprintln("lexdb: replica: " + e.toStr())
                code = 1
                return
            }
        }
        match lexdb_wire.configure(&st, auth) {
            Ok(_) {}
            Err(msg) {
                eprintln("lexdb: replica: " + msg)
                code = 1
                return
            }
        }
        var files: []str = []
        let listening = if reusePort { listenShared(addrs, replace(mut &sharedLns, [])) } else { lexdb_wire.listenAll(addrs, mut &files) }
        match move(listening) {
            Ok(lns) {
                var names: []str = []
                for ln in lns { append(mut &names, ln.localAddr()) }
                println("lexdb: replica listening on " + strings.join(&names, ", ") + ", following the master of " + dir)
                let fl = io.flushStdout()
                // the other doors (9.137), each the product's read-only secondary
                var doors = Doors{tds: [], tns: [], tcps: [], names: []}
                match listenDoors(tdsAddrs, tnsAddrs, reusePort, "replica ") {
                    Ok(d) { doors = d }
                    Err(msg) {
                        eprintln("lexdb: replica: " + msg)
                        exit(1)                             // (it writes nothing: the master lets its hold go with the link)
                    }
                }
                let g = s.start(lexdb_tds.acceptAll, lexdb_tds.ListenArg{lns: replace(mut &doors.tds, []), st: st.share()})
                let h = s.start(lexdb_tns.acceptAll, lexdb_tns.ListenArg{lns: replace(mut &doors.tns, []), st: st.share()})
                let h2 = s.start(lexdb_tns.acceptAllTls, lexdb_tns.ListenArg{lns: replace(mut &doors.tcps, []), st: st.share()})
                lexdb_repl.announce(&ob, &doors.names)       // the master routes read-only clients of these doors here
                let marked = task.workerReady()
                let acc = s.start(lexdb_wire.acceptAll, lexdb_wire.ListenArg{lns: lns, st: st.share()})
                let sig = s.start(waitStop, 0)
                match task.any([fol, sig]) {
                    Ok(which) {
                        if which != 2 {                     // follow ended: the master went
                            eprintln("lexdb: replica: the link to the master ended")
                            code = 1
                        }
                    }
                    Err(_) {}
                }
                { let stop = acc }
                { let stop = h2 }
                { let stop = h }
                { let stop = g }
                println("lexdb: replica stopping")
                let fs0 = st.follower().unwrap().stats()
                println("lexdb: replica applied batch " + fs0.applied.toStr() + ", checkpoint " + fs0.ckpt.toStr() + " (" +
                        fs0.bases.toStr() + " held), " + fs0.deltaKeys.toStr() + " keys in the delta, cache " +
                        (fs0.cacheBytes / 1048576).toStr() + " MB in " + fs0.cached.toStr() + " pages, " + fs0.loads.toStr() +
                        " pages read, " + fs0.freed.toStr() + " evicted as freed, " + fs0.snaps.toStr() + " snapshots open")
            }
            Err(msg) {
                eprintln("lexdb: " + msg)
                code = 1
            }
        }
        for f in files { let gone = fs.remove(&f) }
    })
    st.close()
    if code != 0 { exit(code) }
}

// A supervised replica's listeners: its TCP addresses with SO_REUSEPORT
// (each replica a socket of its own on the one port; the kernel spreads
// the connections), and the Unix sockets the supervisor made, shared.
fn listenShared(addrs: &[]str, shared: []net.Listener): Result[[]net.Listener, str] {
    var lns = shared
    for a in addrs {
        match net.listenReusePort(&a) {
            Ok(ln) { append(mut &lns, ln) }
            Err(e) { return Err("listen " + a + ": " + e.toStr()) }
        }
    }
    return Ok(lns)
}

// Waits for SIGTERM or SIGINT; 2 (follow gives 0 or 1).
fn waitStop(u: int): int {
    let r = task.terminated()
    return 2
}
