// lexdb: a small SQL server on disk behind the PostgreSQL wire protocol
// (design/lexdb.md).
//
//     lexdb DATADIR [ADDR ...]
//
// DATADIR is made when it does not exist. Each ADDR is listened on:
// - HOST:PORT, TCP; with no ADDR, 127.0.0.1:5433;
// - a directory (an ADDR with a "/"): a Unix socket in it named as
//   PostgreSQL names one, .s.PGSQL.PORT, PORT the first TCP address's (5433
//   without one), so `psql -h DIR -p PORT` finds it;
// - any other path with a "/": the Unix socket file itself.
// A socket file left by a server that is gone is replaced; one a server
// still answers on is an error. The files are removed when lexdb stops.
// One server per DATADIR: a second one exits 1 ("in use") while the first
// holds DATADIR/lock (flock; the kernel drops it when the process ends,
// however it ends).
// There is no authentication yet: keep TCP on loopback, and a socket in a
// directory only its users can reach. SIGTERM or SIGINT stops it: no new
// connections, the open ones are cut off, and the log is flushed before it
// exits.
import "task"
import "net"
import "io"
import "os"
import "fs"
import "strings"
import "./lexdb_base"
import "./lexdb_disk"
import "./lexdb_store"
import "./lexdb_exec"
import "./lexdb_wire"
import "./lexdb_tds"
import "./lexdb_tns"
import "./lexdb_repl"

extern "c" fn openLock(path: str, flags: i32, mode: u32): i32 as "open"
extern "c" fn flock(fd: i32, op: i32): i32
extern "c" fn lockErrno(): int as "lxl_errno"
extern "c" fn lockStrerror(e: i32): str as "strerror"
extern "c" fn closeDir(fd: i32): i32 as "close"
extern "c" fn ioctlFlags(fd: i32, req: int, flags: mut &int): i32 as "ioctl"

// Copy-on-write off for the files made in the data directory (design/lexdb.md
// 9.61): on btrfs an O_DIRECT write to a copy-on-write file must allocate,
// so io_uring hands every log write to a kernel worker, and a flush costs
// more. Its checksums are not needed: every page carries a CRC32C. Set on
// the directory, the flag (FS_NOCOW_FL) is taken by files created in it;
// a file that already has data keeps copy-on-write. Other file systems
// refuse the flag, and any failure is ignored: it is an optimisation.
fn noCow(dir: str) {
    let fd = openLock(dir, i32(65536 | 524288), u32(0))           // O_RDONLY|O_DIRECTORY|O_CLOEXEC
    if fd < 0 { return }
    var fl = 0                                                      // the kernel uses the low 4 bytes
    if ioctlFlags(fd, 0x80086601, mut &fl) == 0 && (fl & 0x800000) == 0 {     // FS_IOC_GETFLAGS
        fl = fl | 0x800000                                          // FS_NOCOW_FL
        ioctlFlags(fd, 0x40086602, mut &fl)                        // FS_IOC_SETFLAGS
    }
    closeDir(fd)
}

// lexdb DATADIR [ADDR ...] [--replicas N [--replica-addr ADDR ...]]
// lexdb --replica DATADIR [ADDR ...]
//
// ADDR: host:port (TCP), or a directory for a Unix socket (.s.PGSQL.<the
// first TCP port>, as PostgreSQL names it). With --replicas N the process
// supervises the master and N read-only replicas (design/lexdb.md 9.73),
// each a process of its own, started again when it ends badly; the
// replicas serve --replica-addr (by default each of ADDR with the port one
// higher), sharing its TCP port (SO_REUSEPORT) and its Unix socket.
// --replica runs one replica by hand, of a master already serving DATADIR.
//
// Authentication (design/lexdb.md 9.81): --auth METHOD for TCP connections,
// --auth-local METHOD for Unix socket ones: trust (the default for both) or
// scram-sha-256 (a role's password, CREATE ROLE ... PASSWORD). TLS with
// --tls-cert FILE [--tls-key FILE] (PEM; the key may be in the certificate's
// file); --require-tls refuses TCP connections without it.
//
// --tds HOST:PORT (repeatable): the master also speaks SQL Server's
// protocol, TDS 7.4, there (design/lexdb-tds.md; SQL Server's port is
// 1433), with the same roles, authentication and TLS settings. Replicas do
// not serve it yet.
//
// --tns HOST:PORT (repeatable): the master also speaks Oracle's protocol,
// TNS with TTC, there (design/lexdb-oracle.md; Oracle's port is 1521, which
// is never a default), logins by the roles' Oracle 12c verifiers. Replicas
// do not serve it.
fn main() {
    let args = os.arguments()
    var replica = false
    var replicas = 0
    var raddrs: []str = []
    var tdsAddrs: []str = []
    var tnsAddrs: []str = []
    var pos: []str = []
    var auth = lexdb_wire.noAuth()
    var i = 0
    while i < len(args) {
        let a = args[i]
        if a == "--replica" {
            replica = true
        } else if a == "--require-tls" {
            auth.requireTls = true
        } else if a == "--auth" || a == "--auth-local" || a == "--tls-cert" || a == "--tls-key" {
            if i + 1 >= len(args) { usage() }
            let v = args[i + 1]
            if a == "--auth" { auth.tcp = v } else if a == "--auth-local" { auth.local = v } else if a == "--tls-cert" { auth.cert = v } else { auth.key = v }
            i += 1
        } else if a == "--tds" {
            // SQL Server's protocol (design/lexdb-tds.md): TCP only
            if i + 1 >= len(args) || strings.indexOf(args[i + 1], "/", 0) >= 0 { usage() }
            append(mut &tdsAddrs, args[i + 1])
            i += 1
        } else if a == "--tns" {
            // Oracle's protocol (design/lexdb-oracle.md): TCP only
            if i + 1 >= len(args) || strings.indexOf(args[i + 1], "/", 0) >= 0 { usage() }
            append(mut &tnsAddrs, args[i + 1])
            i += 1
        } else if a == "--tcps" {
            // Oracle's protocol inside TLS (TCPS), with the certificate of --tls-cert; kept with --tns's, marked
            if i + 1 >= len(args) || strings.indexOf(args[i + 1], "/", 0) >= 0 { usage() }
            append(mut &tnsAddrs, "tcps:" + args[i + 1])
            i += 1
        } else if a == "--replicas" || a == "--replica-addr" {
            if i + 1 >= len(args) { usage() }
            if a == "--replicas" {
                replicas = strings.parseIntOpt(args[i + 1]).unwrapOr(-1)
                if replicas < 0 || replicas > 64 { usage() }
            } else {
                append(mut &raddrs, args[i + 1])
            }
            i += 1
        } else if strings.startsWith(a, "--") {
            usage()
        } else {
            append(mut &pos, a)
        }
        i += 1
    }
    if len(pos) < 1 || (replica && replicas > 0) { usage() }
    match lexdb_wire.checkAuth(&auth) {
        Ok(_) {}
        Err(msg) {
            eprintln("lexdb: " + msg)
            exit(2)
        }
    }
    let dir = pos[0]
    var addrs: []str = []
    for k in 1..len(pos) { append(mut &addrs, pos[k]) }
    if len(addrs) == 0 { append(mut &addrs, if replica { "127.0.0.1:5434" } else { "127.0.0.1:5433" }) }
    if os.env("LXL_HELPERS").isNone() { os.setEnv("LXL_HELPERS", "32") }   // reads in flight (section 3)
    if replica {
        let none: []net.Listener = []
        runReplica(dir, &addrs, opts0(), false, none, 10000, &auth)
        return
    }
    match fs.mkdirAll(dir) {
        Ok(_) {}
        Err(e) {
            eprintln("lexdb: " + dir + ": " + e.toStr())
            exit(1)
        }
    }
    noCow(dir)
    if replicas == 0 {
        runMaster(dir, &addrs, &tdsAddrs, &tnsAddrs, &auth)
        return
    }
    supervise(dir, &addrs, &tdsAddrs, &tnsAddrs, replicas, &raddrs, &auth)
}

fn usage() {
    eprintln("usage: lexdb DATADIR [ADDR ...] [--tds HOST:PORT ...] [--tns HOST:PORT ...] [--tcps HOST:PORT ...] [--replicas N [--replica-addr ADDR ...]] [AUTH]")
    eprintln("       lexdb --replica DATADIR [ADDR ...] [AUTH]")
    eprintln("AUTH:  [--auth trust|scram-sha-256] [--auth-local trust|scram-sha-256]")
    eprintln("       [--tls-cert FILE [--tls-key FILE]] [--require-tls]")
    exit(2)
}

// The master and n replicas, each a worker process (task.workers): worker
// 0 the master, the others replicas. A worker that ends badly is started
// again; a replica ends when its master does, and so is started again with
// it. SIGTERM or SIGINT stops them all.
fn supervise(dir: str, addrs: &[]str, tdsAddrs: &[]str, tnsAddrs: &[]str, n: int, given: &[]str, auth: &lexdb_wire.AuthConf) {
    // the replicas' addresses: given, or each of the master's one port up
    var raddrs: []str = []
    for a in given { append(mut &raddrs, a) }
    if len(raddrs) == 0 {
        for a in addrs {
            if strings.contains(a, "/") {
                append(mut &raddrs, a)
            } else {
                let c = strings.lastIndexOf(a, ":")
                let port = strings.parseIntOpt(a[c + 1..len(a)]).unwrapOr(-1)
                if c < 0 || port <= 0 {
                    eprintln("lexdb: --replicas needs the master's TCP port to pick the replicas' (or --replica-addr): " + a)
                    exit(2)
                }
                append(mut &raddrs, a[0..c + 1] + (port + 1).toStr())
            }
        }
    }
    // their Unix sockets, made here: every replica accepts from them (a
    // Unix socket's path cannot be shared with SO_REUSEPORT)
    var tcpPort = ""
    for a in raddrs {
        if !strings.contains(a, "/") && tcpPort == "" {
            let c = strings.lastIndexOf(a, ":")
            if c >= 0 { tcpPort = a[c + 1..len(a)] }
        }
    }
    var shared: []net.Listener = []
    var files: []str = []
    for a in raddrs {
        if !strings.contains(a, "/") { continue }
        if tcpPort == "" {
            eprintln("lexdb: the replicas' Unix socket is named by their TCP port: give one with --replica-addr")
            exit(2)
        }
        let path = if strings.endsWith(a, "/") { a + ".s.PGSQL." + tcpPort } else { a + "/.s.PGSQL." + tcpPort }
        match lexdb_wire.clearStale(&path) {
            Ok(_) {}
            Err(msg) {
                eprintln("lexdb: " + msg)
                exit(1)
            }
        }
        match net.listenUnix(path) {
            Ok(ln) {
                append(mut &files, path)
                append(mut &shared, ln)
            }
            Err(e) {
                eprintln("lexdb: listen " + path + ": " + e.toStr())
                exit(1)
            }
        }
    }
    var tcp: []str = []
    for a in raddrs { if !strings.contains(a, "/") { append(mut &tcp, a) } }
    println("lexdb: supervising a master and " + n.toStr() + " replica" + (if n == 1 { "" } else { "s" }) + " of " + dir)
    let fl = io.flushStdout()
    var policy = task.workerPolicy()
    policy.maxBackoffMs = 2000
    let ends = task.workersWith(n + 1, policy, fn(w: int) {
        if w == 0 {
            runMaster(dir, addrs, tdsAddrs, tnsAddrs, auth)
        } else {
            // each replica a copy of the shared sockets (this process's own
            // memory: the supervisor keeps its)
            runReplica(dir, &tcp, opts0(), true, replace(mut &shared, []), 60000, auth)
        }
    })
    for f in files { let gone = fs.remove(f) }
    match ends {
        Ok(_) {}
        Err(g) {
            eprintln("lexdb: the workers ended too often (" + g.crashes.toStr() + " times): stopped")
            exit(1)
        }
    }
}

// The master: the data directory's lock, the store, its listeners and the
// replication socket, until SIGTERM or SIGINT.
fn runMaster(dir: str, addrs: &[]str, tdsAddrs: &[]str, tnsAddrs: &[]str, auth: &lexdb_wire.AuthConf) {
    // One server per data directory: two writing the same files would
    // corrupt them (a benchmark started a second server while the first
    // still wrote its shutdown checkpoint, 9.58). The lock is held, its
    // descriptor open, until the process ends.
    let lockPath = dir + "/lock"
    let lfd = openLock(lockPath, i32(2 | 64 | 524288), u32(384))    // O_RDWR|O_CREAT|O_CLOEXEC, 0600
    if lfd < 0 {
        eprintln("lexdb: " + lockPath + ": " + lockStrerror(i32(lockErrno())))
        exit(1)
    }
    if flock(lfd, i32(2 | 4)) != 0 {                                // LOCK_EX|LOCK_NB
        let e = lockErrno()
        if e == 11 {                                                // EWOULDBLOCK
            eprintln("lexdb: " + dir + " is in use by another lexdb (" + lockPath + " is locked)")
        } else {
            eprintln("lexdb: " + lockPath + ": " + lockStrerror(i32(e)))
        }
        exit(1)
    }
    task.watchSignals(&[task.SIGTERM, task.SIGINT])
    // LEXDB_CACHE_MB: the cache's budget (lexdb_store.Options.cacheBytes);
    // without it a quarter of the memory, 128 MB at least (9.54): the data
    // file is read past the kernel's cache (O_DIRECT), so this cache is all
    // there is
    let opts = opts0()
    let opened = lexdb_store.open(lexdb_disk.real(dir), opts)
    if opened.isErr() {
        eprintln("lexdb: open " + dir + ": " + opened.unwrapErr().toStr())
        exit(1)
    }
    let st = opened.unwrap()
    var code = 0
    task.scope(fn(s: mut &task.Scope) {
        s.spawn(lexdb_store.writer, st)
        s.spawn(lexdb_store.checkpointer, st)
        match lexdb_exec.bootstrap(&st) {
            Ok(_) {}
            Err(e) {
                eprintln("lexdb: " + e.toStr())
                code = 1
                st.close()
                return
            }
        }
        match lexdb_wire.configure(&st, auth) {
            Ok(_) {}
            Err(msg) {
                eprintln("lexdb: " + msg)
                code = 1
                st.close()
                return
            }
        }
        // replicas (--replica) connect here
        let repl = s.start(lexdb_repl.serve, lexdb_repl.Serve{st: st, dir: dir})
        // the automatic statistics (optimizer 44): LEXDB_AUTOANALYZE=off
        // for none; their task ends at once then
        let auto = s.start(lexdb_exec.autoAnalyzer, st)
        var files: []str = []                       // the Unix sockets made: removed at the end
        match lexdb_wire.listenAll(addrs, mut &files) {
            Ok(lns) {
                var names: []str = []
                for ln in lns { append(mut &names, ln.localAddr()) }
                println("lexdb: listening on " + strings.join(&names, ", ") + ", data in " + dir)
                let fl = io.flushStdout()
                let ready = task.workerReady()             // (outside task.workers, nothing)
                let f = s.start(lexdb_wire.acceptAll, lexdb_wire.ListenArg{lns: lns, st: st})
                // SQL Server's protocol on its own listeners (design/lexdb-tds.md)
                var tdsFiles: []str = []
                var tdsLns: []net.Listener = []
                if len(tdsAddrs) > 0 {
                    match lexdb_wire.listenAll(tdsAddrs, mut &tdsFiles) {
                        Ok(x) {
                            var tn: []str = []
                            for ln in x { append(mut &tn, ln.localAddr()) }
                            println("lexdb: TDS (SQL Server) on " + strings.join(&tn, ", "))
                            let fl2 = io.flushStdout()
                            tdsLns = x
                        }
                        Err(msg) {
                            eprintln("lexdb: tds: " + msg)
                            code = 1
                        }
                    }
                }
                let g = s.start(lexdb_tds.acceptAll, lexdb_tds.ListenArg{lns: tdsLns, st: st})
                // Oracle's protocol, likewise (design/lexdb-oracle.md)
                var tnsFiles: []str = []
                var tnsLns: []net.Listener = []
                var tcpsLns: []net.Listener = []
                for secure in [false, true] {
                    var want: []str = []
                    for ta in tnsAddrs {
                        if strings.startsWith(ta, "tcps:") == secure { append(mut &want, if secure { ta[5..len(ta)].toStr() } else { ta }) }
                    }
                    if len(want) == 0 { continue }
                    match lexdb_wire.listenAll(&want, mut &tnsFiles) {
                        Ok(x) {
                            var tn: []str = []
                            for ln in x { append(mut &tn, ln.localAddr()) }
                            println("lexdb: " + (if secure { "TCPS (Oracle over TLS)" } else { "TNS (Oracle)" }) + " on " + strings.join(&tn, ", "))
                            let fl3 = io.flushStdout()
                            if secure { tcpsLns = x } else { tnsLns = x }
                        }
                        Err(msg) {
                            eprintln("lexdb: tns: " + msg)
                            code = 1
                        }
                    }
                }
                let h = s.start(lexdb_tns.acceptAll, lexdb_tns.ListenArg{lns: tnsLns, st: st})
                let h2 = s.start(lexdb_tns.acceptAllTls, lexdb_tns.ListenArg{lns: tcpsLns, st: st})
                if code == 0 { let sig = task.terminated() }
                { let stop = h }
                { let stop = h2 }
                { let stop = g }
                { let stop = f }                       // cancels the accept loops and the connections
                println("lexdb: stopping")
            }
            Err(msg) {
                eprintln("lexdb: " + msg)
                code = 1
            }
        }
        { let stop = auto }
        { let stop = repl }                         // replicas see the link end
        for p in files { let gone = fs.remove(p) }
        let ck = st.checkpointAll()
        let x = st.stats()
        println("lexdb: " + x.commits.toStr() + " commits, " + x.loads.toStr() + " pages read, " + x.evictions.toStr() +
                " evicted, " + x.checkpoints.toStr() + " checkpoints (" +
                x.pagesWritten.toStr() + " pages written, " + (x.logBytes / 1024).toStr() + " KB of log), " + x.held.toStr() + " commits held for one, cache " +
                (x.cacheUsed / 1048576).toStr() + " of " + (opts.cacheBytes / 1048576).toStr() + " MB")
        st.close()
    })
    if code != 0 { exit(code) }
}

// The machine's memory in bytes (/proc/meminfo's MemTotal), 0 when it is
// not known.
fn memBytes(): int {
    match io.read("/proc/meminfo") {
        Ok(text) {
            for line in strings.split(&text, &"\n") {
                if strings.startsWith(line, "MemTotal:") {
                    let f = strings.fields(&line)
                    if len(f) >= 2 {
                        match strings.parseIntOpt(f[1]) {
                            Some(kb) { return kb * 1024 }
                            None {}
                        }
                    }
                }
            }
        }
        Err(_) {}
    }
    return 0
}

// The environment variable name in KiB as bytes, else d.
fn envKb(name: str, d: int): int {
    match os.env(name) {
        Some(v) {
            match strings.parseIntOpt(v) {
                Some(kb) { if kb > 0 { return kb * 1024 } }
                None {
                    eprintln("lexdb: " + name + ": not a number: " + v)
                    exit(2)
                }
            }
        }
        None {}
    }
    return d
}

// The store's options: the defaults, and the environment's.
fn opts0(): lexdb_store.Options {
    var opts = lexdb_store.defaults()
    opts.cacheBytes = max(opts.cacheBytes, memBytes() / 4)
    match os.env("LEXDB_CACHE_MB") {
        Some(v) {
            match strings.parseIntOpt(v) {
                Some(mb) { if mb > 0 { opts.cacheBytes = mb * 1024 * 1024 } }
                None {
                    eprintln("lexdb: LEXDB_CACHE_MB: not a number: " + v)
                    exit(2)
                }
            }
        }
        None {}
    }
    // LEXDB_SEG_KB, LEXDB_CKPT_KB: a log segment's size and the log bytes
    // between checkpoints (small for the crash test: tests/lexdb/crash.py)
    opts.segBytes = envKb("LEXDB_SEG_KB", opts.segBytes)
    opts.ckptBytes = envKb("LEXDB_CKPT_KB", opts.ckptBytes)
    // LEXDB_PAGES=buffered: the page file through the kernel's page cache
    // (design/lexdb.md 9.69); direct (O_DIRECT) by default
    match os.env("LEXDB_PAGES") {
        Some(v) {
            if v == "buffered" { opts.bufferedPages = true } else if v != "direct" {
                eprintln("lexdb: LEXDB_PAGES: buffered or direct, not " + v)
                exit(2)
            }
        }
        None {}
    }
    return opts
}

// A read-only replica (--replica): follows the master of dir over its
// replication socket and serves addrs with the same SQL, refusing writes
// (25006). It stops when the master does (exit 1) or on SIGTERM/SIGINT.
fn runReplica(dir: str, addrs: &[]str, opts: lexdb_store.Options, reusePort: bool, shared: []net.Listener, waitMs: int,
              auth: &lexdb_wire.AuthConf) {
    task.watchSignals(&[task.SIGTERM, task.SIGINT])
    var sharedLns = shared
    let conn = lexdb_repl.connect(dir, opts, waitMs)
    if conn.isErr() {
        eprintln("lexdb: replica of " + dir + ": " + conn.unwrapErr().toStr())
        exit(1)
    }
    var rps = [conn.unwrap()]
    let st = rps[0].st
    var code = 0
    task.scope(fn(s: mut &task.Scope) {
        let task.Handoff{promise: p, future: ready} = task.promise[Unit]()
        let fol = s.start(lexdb_repl.follow, lexdb_repl.Follow{rp: pop(mut &rps), ready: p})
        if ready.wait().isErr() {
            eprintln("lexdb: replica: the link to the master ended before the replica was ready")
            code = 1
            return
        }
        match lexdb_exec.bootstrap(&st) {
            Ok(_) {}
            Err(e) {
                eprintln("lexdb: replica: " + e.toStr())
                code = 1
                return
            }
        }
        match lexdb_wire.configure(&st, auth) {
            Ok(_) {}
            Err(msg) {
                eprintln("lexdb: replica: " + msg)
                code = 1
                return
            }
        }
        var files: []str = []
        let listening = if reusePort { listenShared(addrs, replace(mut &sharedLns, [])) } else { lexdb_wire.listenAll(addrs, mut &files) }
        match move(listening) {
            Ok(lns) {
                var names: []str = []
                for ln in lns { append(mut &names, ln.localAddr()) }
                println("lexdb: replica listening on " + strings.join(&names, ", ") + ", following the master of " + dir)
                let fl = io.flushStdout()
                let marked = task.workerReady()
                let acc = s.start(lexdb_wire.acceptAll, lexdb_wire.ListenArg{lns: lns, st: st})
                let sig = s.start(waitStop, 0)
                match task.any([fol, sig]) {
                    Ok(which) {
                        if which != 2 {                     // follow ended: the master went
                            eprintln("lexdb: replica: the link to the master ended")
                            code = 1
                        }
                    }
                    Err(_) {}
                }
                { let stop = acc }
                println("lexdb: replica stopping")
                let fs0 = st.follower().unwrap().stats()
                println("lexdb: replica applied batch " + fs0.applied.toStr() + ", checkpoint " + fs0.ckpt.toStr() + " (" +
                        fs0.bases.toStr() + " held), " + fs0.deltaKeys.toStr() + " keys in the delta, cache " +
                        (fs0.cacheBytes / 1048576).toStr() + " MB in " + fs0.cached.toStr() + " pages, " + fs0.loads.toStr() +
                        " pages read, " + fs0.freed.toStr() + " evicted as freed, " + fs0.snaps.toStr() + " snapshots open")
            }
            Err(msg) {
                eprintln("lexdb: " + msg)
                code = 1
            }
        }
        for f in files { let gone = fs.remove(f) }
    })
    st.close()
    if code != 0 { exit(code) }
}

// A supervised replica's listeners: its TCP addresses with SO_REUSEPORT
// (each replica a socket of its own on the one port; the kernel spreads
// the connections), and the Unix sockets the supervisor made, shared.
fn listenShared(addrs: &[]str, shared: []net.Listener): Result[[]net.Listener, str] {
    var lns = shared
    for a in addrs {
        match net.listenReusePort(a) {
            Ok(ln) { append(mut &lns, ln) }
            Err(e) { return Err("listen " + a + ": " + e.toStr()) }
        }
    }
    return Ok(lns)
}

// Waits for SIGTERM or SIGINT; 2 (follow gives 0 or 1).
fn waitStop(u: int): int {
    let r = task.terminated()
    return 2
}
