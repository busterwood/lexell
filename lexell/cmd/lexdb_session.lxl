// lexdb_session: the SQL layer's state a transaction carries: its search
// path, session number, planner mode, memory budget, time, zone and its
// deferred constraints. The store carries this record but never reads it;
// statements fill it from the session before they run.
import "./lexdb_time"

pub type SqlTxn = record {
    pub path: []str             // the search path for its names; [] the default
    pub sess: int               // the session running it (its sequences' values)
    pub rules: bool             // SET lexdb_planner = rules
    pub memMax: int             // SET max_statement_mem (bytes; 0 none)
    pub zone: lexdb_time.Zone   // the session's time zone
    pub pending: []str          // deferred foreign key checks, encoded
    pub consAll: int            // SET CONSTRAINTS: 0 none, 1 ALL DEFERRED, 2 ALL IMMEDIATE
    pub consNames: []str        // per name, later ones win
    pub consDeferred: []bool
}

pub fn newSqlTxn(): SqlTxn {
    return SqlTxn{path: [], sess: 0, rules: false, memMax: 0, zone: lexdb_time.utc(), pending: [], consAll: 0, consNames: [], consDeferred: []}
}
