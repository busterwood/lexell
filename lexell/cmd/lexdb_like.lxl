// lexdb: simple LIKE matching (design/lexdb.md 9.52, 9.108).
//
// A pattern of literal text and % only is split into pieces and matched as
// bytes: the first at the text's start, the last at its end, the others in
// order between, each at its first place. The row codec uses the range form
// on a text in a row's or a column leaf's bytes, without copying it out;
// the evaluator uses it for the whole text.
// Whether LIKE pattern pat is literal text and % only (no _, no escape
// character): matched as bytes. UTF-8 text matches a literal piece only at
// a character's start, so bytes give what characters do.
type VB = vector[byte]

pub fn likeSimple(pat: &str, esc: &str): bool {
    for i in 0..len(pat) { if pat[i] == '_' { return false } }
    if len(esc) == 0 { return true }
    var i = 0
    while i + len(esc) <= len(pat) {
        if bytesAt(pat, i, esc) { return false }
        i += 1
    }
    return true
}

// pat's pieces between its %s ("a%b%" gives "a", "b", "").
pub fn likeSplit(pat: &str): []str {
    var out: []str = []
    var from = 0
    for i in 0..len(pat) {
        if pat[i] == '%' {
            append(mut &out, pat[from..i].clone())
            from = i + 1
        }
    }
    append(mut &out, pat[from..len(pat)].clone())
    return out
}

fn bytesAt(s: &str, at: int, p: &str): bool {
    if at < 0 || at + len(p) > len(s) { return false }
    for i in 0..len(p) { if s[at + i] != p[i] { return false } }
    return true
}

// Whether s matches the pattern of these pieces (likeSplit).
pub fn likePieces(s: &str, ps: &[]str): bool { return likeRange(s, 0, len(s), ps) }

// ILIKE's likePieces: s matched with its ASCII letters folded to lower case,
// as likeMatch folds both sides (strings.toLowerAscii); the pieces are
// already folded. Not copied: a skipping index's SET values are tested so.
pub fn likePiecesFold(s: &str, ps: &[]str): bool { return likeRangeFold(s, 0, len(s), ps) }

// likePiecesFold of s[lo..hi], zero-copy, using 2-byte branchless SIMD filtering.
pub fn likeRangeFold(s: &str, lo: int, hi: int, ps: &[]str): bool {
    let n = len(ps)
    if n == 1 { return hi - lo == len(ps[0]) && bytesAtFold(s, lo, &ps[0]) }
    let first = &ps[0]
    let last = &ps[n - 1]
    if hi - lo < len(first) + len(last) { return false }
    if !bytesAtFold(s, lo, first) || !bytesAtFold(s, hi - len(last), last) { return false }
    var at = lo + len(first)
    let end = hi - len(last)
    for k in 1..n - 1 {
        let p = &ps[k]
        let plen = len(p)
        if plen == 0 { continue }
        let lim = end - plen + 1
        if at >= lim { return false }
        let b0 = p[0]
        let v0Lo = VB.splat(b0)
        let vM0 = if b0 >= 'a' && b0 <= 'z' { VB.splat(byte(0x20)) } else { VB.zero() }
        var found = -1
        var i = at
        if plen == 1 {
            while i + VB.lanes <= lim {
                var m = ((VB.load(s, i) | vM0) == v0Lo).bitmask()
                if m != u64(0) { found = i + int(m.trailingZeros()); break }
                i += VB.lanes
            }
            if found < 0 && i < lim {
                let m = ((VB.loadPartial(s, i, byte(0)) | vM0) == v0Lo).bitmask() & VB.tailMask(lim - i)
                if m != u64(0) { found = i + int(m.trailingZeros()) }
            }
        } else {
            let off1 = plen - 1
            let b1 = p[off1]
            let v1Lo = VB.splat(b1)
            let vM1 = if b1 >= 'a' && b1 <= 'z' { VB.splat(byte(0x20)) } else { VB.zero() }
            while i + VB.lanes <= lim {
                let ma = (VB.load(s, i) | vM0) == v0Lo
                let mb = (VB.load(s, i + off1) | vM1) == v1Lo
                var m = (ma & mb).bitmask()
                while m != u64(0) {
                    let pos = i + int(m.trailingZeros())
                    if plen == 2 || bytesAtFoldMid(s, pos, p) { found = pos; break }
                    m = m & (m - u64(1))
                }
                if found >= 0 { break }
                i += VB.lanes
            }
            if found < 0 && i < lim {
                let ma = (VB.loadPartial(s, i, byte(0)) | vM0) == v0Lo
                let mb = (VB.loadPartial(s, i + off1, byte(0)) | vM1) == v1Lo
                var m = (ma & mb).bitmask() & VB.tailMask(lim - i)
                while m != u64(0) {
                    let pos = i + int(m.trailingZeros())
                    if plen == 2 || bytesAtFoldMid(s, pos, p) { found = pos; break }
                    m = m & (m - u64(1))
                }
            }
        }
        if found < 0 { return false }
        at = found + plen
    }
    return true
}

fn foldByte(c: byte): byte { return if c >= 'A' && c <= 'Z' { c + 32 } else { c } }

// Whether s at at holds p, s's ASCII letters folded (p is folded).
fn bytesAtFold(s: &str, at: int, p: &str): bool {
    if at < 0 || at + len(p) > len(s) { return false }
    for i in 0..len(p) { if foldByte(s[at + i]) != p[i] { return false } }
    return true
}

// Like bytesAtFold when p[0] and p[len(p)-1] have already been matched in SIMD.
fn bytesAtFoldMid(s: &str, at: int, p: &str): bool {
    for i in 1..len(p) - 1 { if foldByte(s[at + i]) != p[i] { return false } }
    return true
}

// Like bytesAt when p[0] and p[len(p)-1] have already been matched in SIMD.
fn bytesAtMid(s: &str, at: int, p: &str): bool {
    for i in 1..len(p) - 1 { if s[at + i] != p[i] { return false } }
    return true
}

// likePieces of s[lo..hi] (9.108: a text in a row's bytes, not copied out).
// Bounded 2-byte SIMD scan stays strictly within s[at..end] instead of scanning
// past hi into the rest of a multi-row columnar leaf buffer.
pub fn likeRange(s: &str, lo: int, hi: int, ps: &[]str): bool {
    let n = len(ps)
    if n == 1 { return hi - lo == len(ps[0]) && bytesAt(s, lo, &ps[0]) }
    let first = &ps[0]
    let last = &ps[n - 1]
    if hi - lo < len(first) + len(last) { return false }
    if !bytesAt(s, lo, first) || !bytesAt(s, hi - len(last), last) { return false }
    var at = lo + len(first)
    let end = hi - len(last)
    for k in 1..n - 1 {
        let p = &ps[k]
        let plen = len(p)
        if plen == 0 { continue }
        let lim = end - plen + 1
        if at >= lim { return false }
        let v0 = VB.splat(p[0])
        var found = -1
        var i = at
        if plen == 1 {
            while i + VB.lanes <= lim {
                let m = (VB.load(s, i) == v0).bitmask()
                if m != u64(0) { found = i + int(m.trailingZeros()); break }
                i += VB.lanes
            }
            if found < 0 && i < lim {
                let m = (VB.loadPartial(s, i, byte(0)) == v0).bitmask() & VB.tailMask(lim - i)
                if m != u64(0) { found = i + int(m.trailingZeros()) }
            }
        } else {
            let off1 = plen - 1
            let v1 = VB.splat(p[off1])
            while i + VB.lanes <= lim {
                var m = ((VB.load(s, i) == v0) & (VB.load(s, i + off1) == v1)).bitmask()
                while m != u64(0) {
                    let pos = i + int(m.trailingZeros())
                    if plen == 2 || bytesAtMid(s, pos, p) { found = pos; break }
                    m = m & (m - u64(1))
                }
                if found >= 0 { break }
                i += VB.lanes
            }
            if found < 0 && i < lim {
                let ma = VB.loadPartial(s, i, byte(0)) == v0
                let mb = VB.loadPartial(s, i + off1, byte(0)) == v1
                var m = (ma & mb).bitmask() & VB.tailMask(lim - i)
                while m != u64(0) {
                    let pos = i + int(m.trailingZeros())
                    if plen == 2 || bytesAtMid(s, pos, p) { found = pos; break }
                    m = m & (m - u64(1))
                }
            }
        }
        if found < 0 { return false }
        at = found + plen
    }
    return true
}
