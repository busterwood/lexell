// emit: instantiates the checked templates once per instance, from main (SPEC 6.4), and
// lowers the program to the IR (lower.lxl).
//
// Holes in a template name what depends on type arguments; filling them substitutes the
// instance's type arguments and asks for C types, drop and dup glue and callee instances,
// which are themselves made later (a worklist). Glue is written as templates too.
//
// Every C name is numbered in the order it is first asked for (fn<n>/S<n>_ types, gl<n>_
// glue, f<n>_ instances, sl<n> strings): holes are filled in the order of the C text.

import "./syntax" as sx
import "./sema"
import "./check" as ck
import "./tmpl" as tm
import "./lower" as lw
import "./ir"

const MAX_DEPTH = 24
const MAX_INSTANCES = 20000
const DEEP = -1         // in reach(): a type too deep to follow (a non-terminating instantiation)

// Glue kinds.
const G_DROP = 0
const G_ACT = 1
const G_REST = 2
const G_DUP = 3
const G_TRAMP = 4
const G_CLONE = 5
const G_EQ = 6          // derived methods (design/consistency.md, finding 4)
const G_HASH = 7
const G_SHOW = 8
const G_TODATA = 9
const G_FROMDATA = 10
const GLUE_NAMES: []str = ["drop", "act", "rest", "dup", "tramp", "clone", "eq", "hash", "toStr", "toData", "fromData"]

fn deriveKind(name: &str): int {
    return if name == "eq" { G_EQ } else if name == "hash" { G_HASH } else if name == "toStr" { G_SHOW }
        else if name == "toData" { G_TODATA } else { G_FROMDATA }
}

type Inst = value record {
    f: int
    targs: int      // a tuple type (a fn type with the type arguments as parameters)
}

type Glue = value record {
    kind: int
    t: int
}

// Statements and whether pushed actions read the memory of the place.
type Lines = record {
    ls: []int
    refs: bool
}

// A function to define: C types of its result and parameters, its parameters' names, its
// body (template lines or statements) and what its holes stand for.
type FnDef = record {
    name: str
    ret: str
    ptys: []str
    pnames: []str
    lines: []int
    res: int            // index in Emitter.ress (-1: no holes)
}

// typedef ret (*name)(ptys);
type FnType = record {
    name: str
    ret: str
    ptys: []str
}

type Extern = record {
    name: str           // the symbol; the C name is x_<name>
    ret: str
    ptys: []str
    va: bool
    blocking: bool      // some declaration of it is blocking: it gets a thunk bk1_<name> (SPEC 12)
}

// A global: its C type (an array of n if n >= 0), initializer (or -1) and its holes.
type GDef = record {
    name: str
    ty: str
    n: int
    init: int
    isConst: bool
    res: []int
}

type EnvStruct = record {
    name: str
    fieldTys: []str
}

// What cases() does with the fields of a record or variant (ref passes a function).
const CM_PARTS = 0      // push: each part
const CM_DIRECT = 1     // direct: drop each, last to first
const CM_SEQ = 2        // rest: push the parts up to the last chain field, drop the others

pub type Emitter = record {
    c: ck.Checker
    names: Map[int, str]
    nnames: int
    structs: []int
    fntypes: []FnType
    dynIfaceNames: Map[int, str]
    dynIfaces: []int
    dynFnNames: Map[int, str]
    dynFns: []int
    fnBoxVts: Map[int, str]
    envStructs: []EnvStruct
    noopDrop: bool
    vtables: Map[str, str]
    boxFns: Map[str, str]
    nvt: int
    vtGlobs: []GDef
    insts: Map[str, str]
    ninsts: int
    work: []Inst
    glue: Map[int, str]
    nglue: int
    gluework: []Glue
    reachIdx: Map[int, int]
    reachSets: [][]int
    strs: Map[str, str]
    strKeys: []str
    fns: []FnDef
    ress: [][]int       // what the holes of each instance stand for
    podMemo: []int
    // for kernel.lxl (ir.Ir's fields of the same names)
    fsrc: Map[str, str]
    gsrc: Map[str, str]
    parMaps: Map[str, bool]
    parBounds: Map[str, bool]
    kglobals: Map[str, bool]
    kexterns: Map[str, bool]    // externs declared pure (SPEC 12): kernel.lxl lets par.map call them
    stops: Map[str, bool]
    pstr: Map[str, str]
    fpath: Map[str, str]
}

pub fn newEmitter(c: ck.Checker): Emitter {
    return Emitter{c: c, names: newMap(), nnames: 0, structs: [], fntypes: [],
        dynIfaceNames: newMap(), dynIfaces: [], dynFnNames: newMap(), dynFns: [], fnBoxVts: newMap(), envStructs: [], noopDrop: false,
        vtables: newMapWith[str, str](fxHashStr), boxFns: newMapWith[str, str](fxHashStr), nvt: 0, vtGlobs: [],
        insts: newMapWith[str, str](fxHashStr), ninsts: 0, work: [],
        glue: newMap(), nglue: 0, gluework: [], reachIdx: newMap(), reachSets: [], strs: newMapWith[str, str](fxHashStr), strKeys: [],
        fns: [], ress: [], podMemo: [], fsrc: newMapWith[str, str](fxHashStr), gsrc: newMapWith[str, str](fxHashStr),
        parMaps: newMapWith[str, bool](fxHashStr), parBounds: newMapWith[str, bool](fxHashStr), kglobals: newMapWith[str, bool](fxHashStr), kexterns: newMapWith[str, bool](fxHashStr),
        stops: newMapWith[str, bool](fxHashStr), pstr: newMapWith[str, str](fxHashStr), fpath: newMapWith[str, str](fxHashStr)}
}

fn (e: mut &Emitter) pod(t: int): bool { return ck.isPod(mut &e.c.pg, mut &e.podMemo, t) }

fn (e: &Emitter) tk(t: int): int { return e.c.pg.tk(t) }

fn prefix(s: &str, n: int): str { return if len(s) > n { s[0..n].clone() } else { s.clone() } }

fn (e: &Emitter) fail(m: int, line: int, msg: str): never {
    if m < 0 { sx.failText(msg) }
    sx.fail(e.c.pg.mods[m].fname, line, msg)
}

// ---- types

fn (e: mut &Emitter) ctype(t: int): str {
    let k = e.tk(t)
    if k == sema.TK_PRIM { return ck.CTYPES[t].clone() }
    if k == sema.TK_VEC { return ck.vecCType(e.c.pg.ta(t)) }
    if k == sema.TK_ARR { return "lxl_arr" }
    if e.c.pg.isBoxIface(t) { return "D" + e.dynIface(e.c.pg.ta(t)) }
    if e.c.pg.isBoxFn(t) { return "DF" + e.dynFn(e.c.pg.ta(t)) }
    if e.c.pg.isDynRef(t) { return "D" + e.dynIface(e.c.pg.ta(t)) }
    if k == sema.TK_REF {
        if !e.c.pg.tm(t) && e.c.pg.isRefByVal(e.c.pg.ta(t)) { return e.ctype(e.c.pg.ta(t)) }
        return e.ctype(e.c.pg.ta(t)) + "*"
    }
    if k == sema.TK_SLICE { return "lxl_slice" }
    if k == sema.TK_CLO { return "lxl_clo" }
    if k == sema.TK_TP || k == sema.TK_SELF { sx.failText("internal error: unsubstituted type " + e.c.pg.tstr(t)) }
    if !e.names.has(&t) {
        if e.c.pg.depth(t) > MAX_DEPTH + 8 { e.tooDeep(t) }
        var n = ""
        if k == sema.TK_FN {
            var ps: []str = []
            for i in 0..e.c.pg.tn(t) { append(mut &ps, e.ctype(e.c.pg.ti(t, i))) }
            let r = e.ctype(e.c.pg.tb(t))
            n = "fn" + intToStr(e.nnames)
            append(mut &e.fntypes, FnType{name: n.clone(), ret: r, ptys: ps})
        } else {
            n = "S" + intToStr(e.nnames) + "_" + e.c.pg.types[e.c.pg.ta(t)].cname
            append(mut &e.structs, t)
        }
        e.names.put(t, n)
        e.nnames += 1
    }
    let n = e.names.getOr(&t, "")
    return if k == sema.TK_FN || e.c.pg.types[e.c.pg.ta(t)].value { n } else { n + "*" }
}

// Register the fat-pointer struct D<n>_<I> and vtable struct V<n>_<I> for interface instance `iface`.
// Returns the suffix "<n>_<cname>".
fn (e: mut &Emitter) dynIface(iface: int): str {
    let have = e.dynIfaceNames.getOr(&iface, "")
    if len(have) > 0 { return have }
    let s = intToStr(e.nnames) + "_" + e.c.pg.types[e.c.pg.ta(iface)].cname
    e.nnames += 1
    e.dynIfaceNames.put(iface, s.clone())
    append(mut &e.dynIfaces, iface)
    // Eagerly name all member parameter and return types so they are registered before lower().
    let d = e.c.pg.ta(iface)
    let env = e.c.pg.declEnv(iface)
    let nm = len(e.c.pg.types[d].members)
    for j in 0..nm {
        let mb = e.c.pg.types[d].members[j].clone()
        for p in mb.params { let _ = e.ctype(e.c.pg.subst(p, &env)) }
        let _ = e.ctype(e.c.pg.subst(mb.ret, &env))
    }
    return s
}

// Emit (or reuse) the vtable global, drop action, and method thunks for concrete type `t` as interface `iface`.
fn (e: mut &Emitter) vtableFor(t: int, iface: int): str {
    let key = intToStr(t) + "," + intToStr(iface)
    let have = e.vtables.getOr(&key, "")
    if len(have) > 0 { return have }
    let id = e.nvt
    e.nvt += 1
    let vtName = "vt" + intToStr(id)
    e.vtables.put(key, vtName.clone())
    let dn = e.dynIface(iface)
    let ct = e.ctype(t)

    // Drop action: void vtd_<id>(void* p) — drops *(C(T)*)p and frees the heap cell p.
    let dropName = "vtd_" + intToStr(id)
    var dbody: []int = []
    if e.pod(t) {
        append(mut &dbody, e.callS("rt_free", [e.nm("p")]))
    } else if t == sema.T_STR {
        append(mut &dbody, e.callS("rt_str_drop", [e.c.x.at(e.ct(&ct), e.nm("p"))]))
        append(mut &dbody, e.callS("rt_free", [e.nm("p")]))
    } else if e.tk(t) == sema.TK_BOX {
        append(mut &dbody, e.c.x.decl(e.ct(&ct), "v", e.c.x.at(e.ct(&ct), e.nm("p"))))
        append(mut &dbody, e.callS("rt_free", [e.nm("p")]))
        append(mut &dbody, e.callS("rt_dpush", [e.c.x.arrow(e.c.x.dot(e.nm("v"), "vt"), "drop"), e.c.x.dot(e.nm("v"), "data")]))
    } else if e.tk(t) == sema.TK_INST && !e.c.pg.types[e.c.pg.ta(t)].value {
        // Boxed record or closed type: C(T) is S*, so p points to S*.
        append(mut &dbody, e.c.x.decl(e.ct(&ct), "v", e.c.x.at(e.ct(&ct), e.nm("p"))))
        append(mut &dbody, e.callS("rt_free", [e.nm("p")]))
        if e.listed(t) {
            let act = e.glueFn(G_ACT, t)
            append(mut &dbody, e.callS("rt_dpush", [e.nm(&act), e.nm("v")]))
        } else {
            append(mut &dbody, e.c.x.sx(e.dropC(t, e.nm("v"))))
        }
    } else if e.listed(t) {
        // Value record/closed/array on iterative drop stack: LIFO — push free first, then drop action.
        let act = e.glueFn(G_ACT, t)
        append(mut &dbody, e.callS("rt_dpush", [e.nm("rt_free_act"), e.nm("p")]))
        append(mut &dbody, e.callS("rt_dpush", [e.nm(&act), e.nm("p")]))
    } else {
        append(mut &dbody, e.c.x.sx(e.dropC(t, e.c.x.at(e.ct(&ct), e.nm("p")))))
        append(mut &dbody, e.callS("rt_free", [e.nm("p")]))
    }
    e.define(&dropName, "void", ["void*"], ["p"], dbody, -1)

    // Method thunks: R vtm_<id>_<j>(void* p, P0 a0, ...)
    var vtEntries: []int = [e.nm(&dropName)]
    let d = e.c.pg.ta(iface)
    let ienv = e.c.pg.declEnv(iface)
    let nm = len(e.c.pg.types[d].members)
    for j in 0..nm {
        let mb = e.c.pg.types[d].members[j].clone()
        let mName = "vtm_" + intToStr(id) + "_" + intToStr(j)
        var ps: []str = ["void*"]
        var pns: []str = ["p"]
        var avs: []int = []
        for k in 0..len(mb.params) {
            append(mut &ps, e.ctype(e.c.pg.subst(mb.params[k], &ienv)))
            let an = "a" + intToStr(k)
            append(mut &pns, an.clone())
            append(mut &avs, e.nm(&an))
        }
        let retTy = e.c.pg.subst(mb.ret, &ienv)
        let rc = e.ctype(retTy)
        var callExpr = -1
        var body: []int = []
        if e.c.pg.isBoxIface(t) || e.c.pg.isDynRef(t) {
            let srcIface = e.c.pg.ta(t)
            let sidx = e.c.pg.ifaceMemberIdx(srcIface, &mb.name)
            append(mut &body, e.c.x.decl(e.ct(&ct), "v", e.c.x.at(e.ct(&ct), e.nm("p"))))
            var all: []int = [e.c.x.dot(e.nm("v"), "data")]
            for a in avs { append(mut &all, a) }
            callExpr = e.c.x.callx(e.c.x.arrow(e.c.x.dot(e.nm("v"), "vt"), &("m_" + intToStr(sidx))), all)
        } else {
            let f = e.c.pg.methodOf(t, &mb.name)
            if f < 0 && (mb.name == "eq" || mb.name == "hash" || mb.name == "toStr" || mb.name == "toData") && e.c.pg.derivable(t, &mb.name) {
                let g = e.glueFn(deriveKind(&mb.name), t)
                let recv = if e.c.pg.isRefByVal(t) { e.c.x.at(e.ct(&ct), e.nm("p")) } else { e.c.x.pcast(e.c.x.ptr(e.ct(&ct)), e.nm("p")) }
                var all: []int = [recv]
                for a in avs { append(mut &all, a) }
                callExpr = e.call(&g, all)
            } else {
                var bind: []int = []
                if f < 0 || !e.c.pg.unify(e.c.pg.fns[f].recvType, t, mut &bind, &e.c.pg.fns[f].tps) {
                    sx.failText("internal error: vtable: " + e.c.pg.tstr(t) + " has no method " + mb.name)
                }
                var ta: []int = []
                for tp in e.c.pg.fns[f].tps { append(mut &ta, envGet(&bind, tp)) }
                let fname = e.instance(f, e.c.pg.mkFn(&ta, sema.T_VOID))
                let rmode = e.c.pg.fns[f].recvMode
                let recv = if rmode == sema.RM_VAL {
                    e.dupC(t, e.c.x.at(e.ct(&ct), e.nm("p")))
                } else if rmode == sema.RM_REF && e.c.pg.isRefByVal(t) {
                    e.c.x.at(e.ct(&ct), e.nm("p"))
                } else {
                    e.c.x.pcast(e.c.x.ptr(e.ct(&ct)), e.nm("p"))
                }
                var all: []int = [recv]
                for a in avs { append(mut &all, a) }
                callExpr = e.call(&fname, all)
            }
        }
        append(mut &body, if rc == "void" { e.c.x.sx(callExpr) } else { e.c.x.sret(callExpr) })
        e.define(&mName, &rc, ps, pns, body, -1)
        append(mut &vtEntries, e.nm(&mName))
    }
    append(mut &e.vtGlobs, GDef{name: vtName.clone(), ty: "V" + dn, n: -1, init: e.c.x.init(vtEntries), isConst: true, res: []})
    return vtName
}

// Emit (or reuse) the boxing helper: D<dn> box_<k>(C(T) v) { C(T)* p = rt_alloc(sizeof(*p)); *p = v; return (D){p, &vt}; }
fn (e: mut &Emitter) boxFnFor(t: int, iface: int): str {
    let key = intToStr(t) + "," + intToStr(iface)
    let have = e.boxFns.getOr(&key, "")
    if len(have) > 0 { return have }
    let vt = e.vtableFor(t, iface)
    let dn = e.dynIface(iface)
    let bid = e.nvt
    e.nvt += 1
    let fnName = "box_" + intToStr(bid)
    e.boxFns.put(key, fnName.clone())
    let ct = e.ctype(t)
    let pTy = e.c.x.ptr(e.ct(&ct))
    let pDecl = e.c.x.decl(pTy, "p", e.call("rt_alloc", [e.c.x.szof(e.c.x.pre("*", e.nm("p")))]))
    let store = e.c.x.sx(e.c.x.asg(e.c.x.pre("*", e.nm("p")), e.nm("v")))
    let ret = e.c.x.sret(e.c.x.clit(e.ct(&("D" + dn)), e.c.x.init([
        e.c.x.cast(e.ct("void*"), e.nm("p")),
        e.c.x.pcast(e.c.x.ptr(e.ct(&("V" + dn))), e.c.x.pre("&", e.nm(&vt)))
    ])))
    e.define(&fnName, &("D" + dn), [ct], ["v"], [pDecl, store, ret], -1)
    return fnName
}

// Register the fat-pointer struct DF<n> and vtable struct VF<n> for escaping closure fn type `fnTy`.
fn (e: mut &Emitter) dynFn(fnTy: int): str {
    let have = e.dynFnNames.getOr(&fnTy, "")
    if len(have) > 0 { return have }
    let s = intToStr(e.nnames)
    e.nnames += 1
    e.dynFnNames.put(fnTy, s.clone())
    append(mut &e.dynFns, fnTy)
    for i in 0..e.c.pg.tn(fnTy) { let _ = e.ctype(e.c.pg.ti(fnTy, i)) }
    let _ = e.ctype(e.c.pg.tb(fnTy))
    return s
}

fn (e: mut &Emitter) ensureNoopDrop(): str {
    if !e.noopDrop {
        e.noopDrop = true
        e.define("rt_box_noop", "void", ["void*"], ["p"], [e.c.x.sx(e.c.x.cast(e.ct("void"), e.nm("p")))], -1)
    }
    return "rt_box_noop"
}

// Vtable for coercing a plain function pointer fn(A): R to box fn(A): R (zero allocation).
fn (e: mut &Emitter) fnBoxVtFor(fnTy: int): str {
    let have = e.fnBoxVts.getOr(&fnTy, "")
    if len(have) > 0 { return have }
    let dn = e.dynFn(fnTy)
    let id = e.nvt
    e.nvt += 1
    let vtName = "fvt" + intToStr(id)
    e.fnBoxVts.put(fnTy, vtName.clone())
    let noop = e.ensureNoopDrop()
    let tramp = e.glueFn(G_TRAMP, fnTy)
    append(mut &e.vtGlobs, GDef{name: vtName.clone(), ty: "VF" + dn, n: -1,
        init: e.c.x.init([e.nm(&noop), e.nm(&tramp)]), isConst: true, res: []})
    return vtName
}

fn (e: &Emitter) tooDeep(t: int): never {
    var ds: []int = []
    var x = t
    while true {
        let k = e.tk(x)
        if !(k == sema.TK_INST || k == sema.TK_ARR || k == sema.TK_REF) || (k == sema.TK_INST && e.c.pg.tn(x) == 0) {
            break
        }
        if k == sema.TK_INST {
            append(mut &ds, e.c.pg.ta(x))
            x = e.c.pg.ti(x, 0)
        } else {
            x = e.c.pg.ta(x)
        }
    }
    var d = -1
    for y in ds {
        if d < 0 && !e.c.pg.mods[e.c.pg.types[y].mod].isStd { d = y }
    }
    if d < 0 && len(ds) > 0 { d = ds[0] }
    let ts = e.c.pg.tstr(t)
    let nm = if d >= 0 { e.c.pg.types[d].name.clone() } else { prefix(&ts, 40) }
    let msg = "instantiation of type " + nm + " does not terminate: its type arguments grow without bound (" +
        prefix(&ts, 80) + "...)"
    if d < 0 { e.fail(-1, 0, msg) }
    e.fail(e.c.pg.types[d].mod, e.c.pg.types[d].line, msg)
}

fn copyInts(xs: &[]int): []int {
    var out: []int = []
    for x in xs { append(mut &out, x) }
    return out
}

// ---- structs

// The fields of the record t or of its variant vr: their C types and names.
fn (e: mut &Emitter) fields(t: int, vr: int, env: &[]int, cts: mut &[]str, names: mut &[]str) {
    let d = e.c.pg.ta(t)
    let n = if vr >= 0 { len(e.c.pg.variants[vr].fields) } else { len(e.c.pg.types[d].fields) }
    for i in 0..n {
        let f = if vr >= 0 { e.c.pg.variants[vr].fields[i].clone() } else { e.c.pg.types[d].fields[i].clone() }
        let ft = e.c.pg.subst(f.ty, env)
        append(cts, e.ctype(ft))
        append(names, "f_" + f.name)
    }
    if n == 0 {
        append(cts, "char")
        append(names, "_e")
    }
}

// Names the types of t's fields (which may name more types).
fn (e: mut &Emitter) nameFields(t: int) {
    let d = e.c.pg.ta(t)
    let env = e.c.pg.declEnv(t)
    var cts: []str = []
    var names: []str = []
    if e.c.pg.types[d].form == sx.F_RECORD {
        e.fields(t, -1, &env, mut &cts, mut &names)
        return
    }
    let vs = copyInts(&e.c.pg.types[d].variants)
    for v in vs { e.fields(t, v, &env, mut &cts, mut &names) }
}

fn (e: mut &Emitter) irFields(u: mut &lw.Lower, cts: &[]str, names: &[]str): []ir.Field {
    var fs: []ir.Field = []
    for i in 0..len(cts) { append(mut &fs, ir.Field{name: names[i].clone(), ty: u.ctName(cts[i].clone()), off: 0}) }
    return fs
}

// The layout of t: struct S { fields } for a record, else
// struct S { int64_t tag; union { struct { fields } V_x; ... char _e; } u; }; for a niche type
// (sema niche: Option of a box) struct S { union { struct { T* f } V_Some; } u; }, no tag.
fn (e: mut &Emitter) layout(u: mut &lw.Lower, t: int) {
    let d = e.c.pg.ta(t)
    let env = e.c.pg.declEnv(t)
    let ty = u.ctName(e.names.getOr(&t, ""))
    var cts: []str = []
    var names: []str = []
    if e.c.pg.types[d].form == sx.F_RECORD {
        e.fields(t, -1, &env, mut &cts, mut &names)
        u.layout(ty, e.irFields(u, &cts, &names))
        return
    }
    let un = u.newStruct("<anonymous>", true)
    var ufs: []ir.Field = []
    let vs = copyInts(&e.c.pg.types[d].variants)
    for v in vs {
        let vt = u.newStruct("<anonymous>", false)
        var vcts: []str = []
        var vnames: []str = []
        e.fields(t, v, &env, mut &vcts, mut &vnames)
        u.layout(vt, e.irFields(u, &vcts, &vnames))
        append(mut &ufs, ir.Field{name: "V_" + e.c.pg.variants[v].name, ty: vt, off: 0})
    }
    let nv = e.c.pg.niche(t)
    if nv >= 0 {
        // a niche type (sema niche): the box's pointer alone, null the other variant; no tag
        let keep = "V_" + e.c.pg.variants[nv].name
        var only: []ir.Field = []
        for f in ufs { if f.name == keep { append(mut &only, f.clone()) } }
        u.layout(un, only)
        u.layout(ty, [ir.Field{name: "u", ty: un, off: 0}])
        return
    }
    append(mut &ufs, ir.Field{name: "_e", ty: ir.TY_I8, off: 0})
    u.layout(un, ufs)
    u.layout(ty, [ir.Field{name: "tag", ty: ir.TY_I64, off: 0}, ir.Field{name: "u", ty: un, off: 0}])
}

// ---- glue

fn (e: mut &Emitter) nm(s: &str): int { return e.c.x.nm(s) }

fn (e: mut &Emitter) ct(s: &str): int { return e.c.x.ct(s) }

fn (e: mut &Emitter) call(f: &str, args: []int): int { return e.c.x.call(f, args) }

fn (e: mut &Emitter) callS(f: &str, args: []int): int { return e.c.x.sx(e.c.x.call(f, args)) }

fn (e: mut &Emitter) dropC(t: int, cc: int): int {
    if e.pod(t) { return e.c.x.pcast(e.ct("void"), e.c.x.lit(0)) }
    if t == sema.T_STR { return e.call("rt_str_drop", [cc]) }
    let g = e.glueFn(G_DROP, t)
    return e.call(&g, [cc])
}

// A deep copy of the value cc of type t (design/owned-str.md, issue 4): itself for plain data, a copy
// for a type copied while str is counted, a call of t's clone method if it has one, else clone glue.
fn (e: mut &Emitter) cloneC(t: int, cc: int): int {
    if e.pod(t) { return cc }
    let f = e.c.pg.methodOf(t, "clone")
    if f >= 0 && e.tk(t) == sema.TK_INST {
        var bind: []int = []
        if e.c.pg.unify(e.c.pg.fns[f].recvType, t, mut &bind, &e.c.pg.fns[f].tps) {
            var ta: []int = []
            for tp in e.c.pg.fns[f].tps { append(mut &ta, envGet(&bind, tp)) }
            let fname = e.instance(f, e.c.pg.mkFn(&ta, sema.T_VOID))
            let arg = if e.c.pg.fns[f].recvMode == sema.RM_VAL { e.dupC(t, cc) } else { e.refC(t, cc) }
            return e.call(&fname, [arg])
        }
    }
    if e.c.pg.isCopyLegacy(t) { return e.dupC(t, cc) }
    let g = e.glueFn(G_CLONE, t)
    return e.call(&g, [cc])
}

// The body of clone glue: a new buffer or box for v, each part cloned into it.
fn (e: mut &Emitter) cloneBody(t: int, ct: &str): []int {
    let r = e.nm("r")
    if e.tk(t) == sema.TK_ARR {
        let et = e.c.pg.ta(t)
        let ec = e.ctype(et)
        let size = e.c.x.szof(e.ct(&ec))
        let src = e.c.x.idx(e.c.x.pcast(e.c.x.ptr(e.ct(&ec)), e.c.x.dot(e.nm("v"), "data")), e.nm("i"))
        let dst = e.c.x.idx(e.c.x.pcast(e.c.x.ptr(e.ct(&ec)), e.c.x.dot(r, "data")), e.nm("i"))
        let h = e.loopHead(e.c.x.lit(0), "<", e.c.x.dot(e.nm("v"), "len"), "++")
        return [e.c.x.decl(e.ct(ct), "r", e.call("rt_arr_new", [e.c.x.dot(e.nm("v"), "len"), size])),
            e.c.x.for1(h[0], h[1], h[2], e.c.x.sx(e.c.x.asg(dst, e.cloneC(et, src)))), e.c.x.sret(r)]
    }
    let d = e.c.pg.ta(t)
    let env = e.c.pg.declEnv(t)
    if d == e.c.pg.shared {
        return [e.callS("rt_sh_dup", [e.c.x.dot(e.nm("v"), "f_p")]), e.c.x.sret(e.nm("v"))]
    }
    if e.c.pg.isRc(t) {        // another handle to the same box
        let nf = e.c.x.arrow(e.nm("v"), "f_n")
        return [e.c.x.sx(e.c.x.asg(nf, e.c.x.bin("+", nf, e.c.x.lit(1)))), e.c.x.sret(e.nm("v"))]
    }
    let boxed = !e.c.pg.types[d].value
    var body: []int = []
    if boxed {
        append(mut &body, e.c.x.decl(e.ct(ct), "r", e.call("rt_alloc", [e.c.x.szof(e.c.x.pre("*", r))])))
        append(mut &body, e.c.x.sx(e.c.x.asg(e.c.x.pre("*", r), e.c.x.pre("*", e.nm("v")))))
    } else {
        append(mut &body, e.c.x.decl(e.ct(ct), "r", e.nm("v")))
    }
    let sep = if boxed { "->" } else { "." }
    if e.c.pg.types[d].form == sx.F_RECORD {
        for i in 0..len(e.c.pg.types[d].fields) {
            let f = e.c.pg.types[d].fields[i].clone()
            let ft = e.c.pg.subst(f.ty, &env)
            if e.pod(ft) { continue }
            let src = if boxed { e.c.x.arrow(e.nm("v"), &("f_" + f.name)) } else { e.c.x.dot(e.nm("v"), &("f_" + f.name)) }
            let dst = if boxed { e.c.x.arrow(r, &("f_" + f.name)) } else { e.c.x.dot(r, &("f_" + f.name)) }
            append(mut &body, e.cloneField(ft, dst, src))
        }
    } else {
        append(mut &body, e.c.x.sswitch(e.tagX(t, e.nm("v"), if boxed { "->" } else { "." })))
        let vs = copyInts(&e.c.pg.types[d].variants)
        for v in vs {
            append(mut &body, e.c.x.scase(e.c.x.lit(e.c.pg.variants[v].index)))
            let vn = "V_" + e.c.pg.variants[v].name
            for i in 0..len(e.c.pg.variants[v].fields) {
                let fd = e.c.pg.variants[v].fields[i].clone()
                let ft = e.c.pg.subst(fd.ty, &env)
                if e.pod(ft) { continue }
                let su = if boxed { e.c.x.arrow(e.nm("v"), "u") } else { e.c.x.dot(e.nm("v"), "u") }
                let du = if boxed { e.c.x.arrow(r, "u") } else { e.c.x.dot(r, "u") }
                let src = e.c.x.dot(e.c.x.dot(su, &vn), &("f_" + fd.name))
                let dst = e.c.x.dot(e.c.x.dot(du, &vn), &("f_" + fd.name))
                append(mut &body, e.cloneField(ft, dst, src))
            }
            append(mut &body, e.c.x.sbreak())
        }
        append(mut &body, e.c.x.send())
    }
    append(mut &body, e.c.x.sret(r))
    return body
}

// A field of a record clone r, which starts as a copy of v. A str field of static bytes (cap 0) is
// left as copied: rewriting it with an equal value would cost a call, and its 8-byte stores make
// the 16-byte loads of the record copy that follows wait (store forwarding).
fn (e: mut &Emitter) cloneField(ft: int, dst: int, src: int): int {
    if ft == sema.T_STR { return e.c.x.if1(e.c.x.dot(src, "cap"), e.c.x.sx(e.c.x.asg(dst, e.cloneC(ft, src)))) }
    return e.c.x.sx(e.c.x.asg(dst, e.cloneC(ft, src)))
}

// A field of dup glue's v, made a second owner in place; a str of static bytes is left as it is
// (cloneField).
fn (e: mut &Emitter) dupField(ft: int, loc: int): int {
    if ft == sema.T_STR { return e.c.x.if1(e.c.x.dot(loc, "cap"), e.c.x.sx(e.c.x.asg(loc, e.dupC(ft, loc)))) }
    return e.c.x.sx(e.c.x.asg(loc, e.dupC(ft, loc)))
}

// A global initialized on first use (design/consistency.md, finding 3): gacc_<cname>() runs its
// __ginit_ function the first time and returns the global's address. An initializer that reaches its
// own global, or a use after the global was dropped at exit, stops the program (exit 12).
fn (e: mut &Emitter) globalAccessor(g: int, t: int, cn: &str, m: int, name: &str) {
    let ct = e.ctype(t)
    let st = e.nm(&(cn + "_st"))
    let fi = e.c.pg.globals[g].initFn
    if fi < 0 { sx.failText("internal error: global " + name + " has no initializer function") }
    let init = e.instance(fi, e.c.pg.mkFn(&[], sema.T_VOID))
    let w = e.c.x.str(&(e.c.pg.mods[m].fname + ":" + intToStr(e.c.pg.globals[g].line)))
    var body: []int = []
    append(mut &body, e.c.x.sif(e.c.x.bin("!=", st, e.c.x.lit(1))))
    append(mut &body, e.c.x.if1(e.c.x.bin("==", st, e.c.x.lit(2)), e.c.x.sx(e.c.x.call("rt_trap", [e.c.x.lit(12),
        e.c.x.str(&("the initializer of global " + name + " uses " + name)), w]))))
    append(mut &body, e.c.x.if1(e.c.x.bin("==", st, e.c.x.lit(3)), e.c.x.sx(e.c.x.call("rt_trap", [e.c.x.lit(12),
        e.c.x.str(&("global " + name + " is dropped")), w]))))
    append(mut &body, e.c.x.sx(e.c.x.asg(st, e.c.x.lit(2))))
    append(mut &body, e.c.x.sx(e.c.x.asg(e.nm(cn), e.call(&init, []))))
    append(mut &body, e.c.x.sx(e.c.x.asg(st, e.c.x.lit(1))))
    append(mut &body, e.c.x.send())
    append(mut &body, e.c.x.sret(e.c.x.pre("&", e.nm(cn))))
    e.define(&("gacc_" + cn), &(ct + "*"), [], [], body, -1)
}

// ---- derived methods (design/consistency.md, finding 4): eq, hash and toStr glue for a record or
// closed type without its own, each taking pointers to the values (&Self).

// The C of &x for a value x of type t (str and boxed records/closed types pass by value).
fn (e: mut &Emitter) refC(t: int, x: int): int {
    return if e.c.pg.isRefByVal(t) { x } else { e.c.x.par(e.c.x.pre("&", x)) }
}

// A call of t's method name (declared, or derived) on the value x, with the &Self argument y.
fn (e: mut &Emitter) methodC(t: int, name: &str, x: int, y: int): int {
    let f = e.c.pg.methodOf(t, name)
    if f < 0 {
        let g = e.glueFn(deriveKind(name), t)
        return if y >= 0 { e.call(&g, [e.refC(t, x), e.refC(t, y)]) } else { e.call(&g, [e.refC(t, x)]) }
    }
    var bind: []int = []
    e.c.pg.unify(e.c.pg.fns[f].recvType, t, mut &bind, &e.c.pg.fns[f].tps)
    var ta: []int = []
    for tp in e.c.pg.fns[f].tps { append(mut &ta, envGet(&bind, tp)) }
    let fname = e.instance(f, e.c.pg.mkFn(&ta, sema.T_VOID))
    let recv = if e.c.pg.fns[f].recvMode == sema.RM_VAL { e.dupC(t, x) } else { e.refC(t, x) }
    return if y >= 0 { e.call(&fname, [recv, e.refC(t, y)]) } else { e.call(&fname, [recv]) }
}

// The fields of t's record, or of variant v of its closed type, as places of the value at pointer p.
fn (e: mut &Emitter) derivedFields(t: int, d: int, v: int, p: int): []int {
    let boxed = !e.c.pg.types[d].value
    let base = if boxed { p } else { e.c.x.par(e.c.x.pre("*", p)) }
    var out: []int = []
    let names = e.fieldNames(d, v)
    if v < 0 {
        for f in names {
            append(mut &out, if boxed { e.c.x.arrow(base, &("f_" + f)) } else { e.c.x.dot(base, &("f_" + f)) })
        }
        return out
    }
    let u = if boxed { e.c.x.arrow(base, "u") } else { e.c.x.dot(base, "u") }
    let vn = "V_" + e.c.pg.variants[v].name
    for f in names { append(mut &out, e.c.x.dot(e.c.x.dot(u, &vn), &("f_" + f))) }
    return out
}

fn (e: mut &Emitter) derivedTypes(t: int, d: int, v: int): []int {
    let env = e.c.pg.declEnv(t)
    var raw: []int = []
    if v < 0 {
        for f in e.c.pg.types[d].fields { append(mut &raw, f.ty) }
    } else {
        for f in e.c.pg.variants[v].fields { append(mut &raw, f.ty) }
    }
    var out: []int = []
    for ty in raw { append(mut &out, e.c.pg.subst(ty, &env)) }
    return out
}

fn (e: mut &Emitter) tagC(t: int, boxed: bool, p: int): int {
    let base = if boxed { p } else { e.c.x.par(e.c.x.pre("*", p)) }
    return e.tagX(t, base, if boxed { "->" } else { "." })
}

// The tag of the closed value base (sep "." or "->") of type t; for a niche type (sema niche: its
// box's pointer, null the other variant) the index of the variant its pointer is (it has no tag).
fn (e: mut &Emitter) tagX(t: int, base: int, sep: &str): int {
    let nv = e.c.pg.niche(t)
    if nv < 0 { return e.c.x.member(base, sep, "tag") }
    let d = e.c.pg.ta(t)
    var other = -1
    for v in e.c.pg.types[d].variants { if v != nv { other = e.c.pg.variants[v].index } }
    let f = e.c.pg.variants[nv].fields[0].name.clone()
    let p = e.c.x.dot(e.c.x.dot(e.c.x.member(base, sep, "u"), &("V_" + e.c.pg.variants[nv].name)), &("f_" + f))
    return e.c.x.par(e.c.x.cond(e.c.x.pre("!", p), e.c.x.lit(other), e.c.x.lit(e.c.pg.variants[nv].index)))
}

// h = (h ^ x) * the FNV prime
fn (e: mut &Emitter) mixC(x: int): int {
    let h = e.nm("h")
    let prime = e.c.x.cast(e.ct("uint64_t"), e.c.x.lit(1099511628211))
    return e.c.x.sx(e.c.x.asg(h, e.c.x.bin("*", e.c.x.par(e.c.x.bin("^", h, e.c.x.cast(e.ct("uint64_t"), x))), prime)))
}

fn (e: mut &Emitter) deriveGlue(kind: int, t: int, n: &str) {
    let d = e.c.pg.ta(t)
    let pt = e.ctype(e.c.pg.mkRef(t, false))
    let a = e.nm("a")
    let b = e.nm("b")
    let boxed = !e.c.pg.types[d].value
    let isRec = e.c.pg.types[d].form == sx.F_RECORD
    var body: []int = []
    if kind == G_EQ {
        // field by field, in declaration order; for a closed type the tags first
        let no = e.c.x.sret(e.c.x.lit(0))
        if isRec {
            let fa = e.derivedFields(t, d, -1, a)
            let fb = e.derivedFields(t, d, -1, b)
            let fts = e.derivedTypes(t, d, -1)
            for i in 0..len(fts) { append(mut &body, e.c.x.if1(e.c.x.pre("!", e.c.x.par(e.eqC(fts[i], fa[i], fb[i]))), no)) }
        } else {
            append(mut &body, e.c.x.if1(e.c.x.bin("!=", e.tagC(t, boxed, a), e.tagC(t, boxed, b)), no))
            append(mut &body, e.c.x.sswitch(e.tagC(t, boxed, a)))
            let vs = copyInts(&e.c.pg.types[d].variants)
            for v in vs {
                append(mut &body, e.c.x.scase(e.c.x.lit(e.c.pg.variants[v].index)))
                let fa = e.derivedFields(t, d, v, a)
                let fb = e.derivedFields(t, d, v, b)
                let fts = e.derivedTypes(t, d, v)
                for i in 0..len(fts) { append(mut &body, e.c.x.if1(e.c.x.pre("!", e.c.x.par(e.eqC(fts[i], fa[i], fb[i]))), no)) }
                append(mut &body, e.c.x.sbreak())
            }
            append(mut &body, e.c.x.send())
        }
        append(mut &body, e.c.x.sret(e.c.x.lit(1)))
        e.define(n, "bool", [pt.clone(), pt], ["a", "b"], body, -1)
        return
    }
    if kind == G_HASH {
        // FNV-style: h = (h ^ part) * prime over the tag and the fields
        let h = e.nm("h")
        append(mut &body, e.c.x.decl(e.ct("uint64_t"), "h", e.c.x.cast(e.ct("uint64_t"), e.c.x.lit(1469598103934665603))))
        if isRec {
            let fa = e.derivedFields(t, d, -1, a)
            let fts = e.derivedTypes(t, d, -1)
            for i in 0..len(fts) { append(mut &body, e.mixC(e.methodC(fts[i], "hash", fa[i], -1))) }
        } else {
            append(mut &body, e.mixC(e.c.x.cast(e.ct("uint64_t"), e.tagC(t, boxed, a))))
            append(mut &body, e.c.x.sswitch(e.tagC(t, boxed, a)))
            let vs = copyInts(&e.c.pg.types[d].variants)
            for v in vs {
                append(mut &body, e.c.x.scase(e.c.x.lit(e.c.pg.variants[v].index)))
                let fa = e.derivedFields(t, d, v, a)
                let fts = e.derivedTypes(t, d, v)
                for i in 0..len(fts) { append(mut &body, e.mixC(e.methodC(fts[i], "hash", fa[i], -1))) }
                append(mut &body, e.c.x.sbreak())
            }
            append(mut &body, e.c.x.send())
        }
        append(mut &body, e.c.x.sret(h))
        e.define(n, "uint64_t", [pt], ["a"], body, -1)
        return
    }
    // toStr: P{x: 1, name: "a"}, E.V, E.V(1, 2), E.V{s: "a"}; strings quoted
    var k = 0
    append(mut &body, e.c.x.decl(e.ct("lxl_str"), "s", e.strlit("", false)))
    let tn = e.c.pg.types[d].name.clone()
    if isRec {
        e.showParts(&tn, t, d, -1, a, mut &body, mut &k)
    } else {
        append(mut &body, e.c.x.sswitch(e.tagC(t, boxed, a)))
        let vs = copyInts(&e.c.pg.types[d].variants)
        for v in vs {
            append(mut &body, e.c.x.scase(e.c.x.lit(e.c.pg.variants[v].index)))
            e.showParts(&(tn + "." + e.c.pg.variants[v].name), t, d, v, a, mut &body, mut &k)
            append(mut &body, e.c.x.sbreak())
        }
        append(mut &body, e.c.x.send())
    }
    append(mut &body, e.c.x.sret(e.nm("s")))
    e.define(n, "lxl_str", [pt], ["a"], body, -1)
}

// x == y for values of type t: C == for a primitive, rt_str_eq for a string, else t's eq.
fn (e: mut &Emitter) eqC(t: int, x: int, y: int): int {
    if t == sema.T_STR { return e.call("rt_str_eq", [x, y]) }
    if e.c.pg.tk(t) == sema.TK_PRIM { return e.c.x.bin("==", x, y) }
    return e.methodC(t, "eq", x, y)
}

// Appends to s (an owned string being built) the text of the record, or variant v, at pointer p.
fn (e: mut &Emitter) showParts(head: &str, t: int, d: int, v: int, p: int, body: mut &[]int, k: mut &int) {
    let fs = e.fieldNames(d, v)
    let fx = e.derivedFields(t, d, v, p)
    let fts = e.derivedTypes(t, d, v)
    let positional = len(fs) > 0 && strByte(fs[0], 0) >= '0' && strByte(fs[0], 0) <= '9'
    e.showAdd(e.strlit(head, false), false, body, k)
    if len(fs) == 0 && v >= 0 { return }
    e.showAdd(e.strlit(if positional { "(" } else { "{" }, false), false, body, k)
    for i in 0..len(fts) {
        if i > 0 { e.showAdd(e.strlit(", ", false), false, body, k) }
        if !positional { e.showAdd(e.strlit(&(fs[i] + ": "), false), false, body, k) }
        if fts[i] == sema.T_STR {
            e.showAdd(e.strlit("\"", false), false, body, k)
            e.showAdd(fx[i], false, body, k)        // the field itself, borrowed: not dropped
            e.showAdd(e.strlit("\"", false), false, body, k)
        } else {
            e.showAdd(e.methodC(fts[i], "toStr", fx[i], -1), true, body, k)
        }
    }
    e.showAdd(e.strlit(if positional { ")" } else { "}" }, false), false, body, k)
}

fn (e: mut &Emitter) showAdd(piece: int, owned: bool, body: mut &[]int, k: mut &int) {
    let pn = "p" + intToStr(k)
    let nn = "n" + intToStr(k)
    k += 1
    append(body, e.c.x.decl(e.ct("lxl_str"), &pn, piece))
    append(body, e.c.x.decl(e.ct("lxl_str"), &nn, e.call("rt_str_concat", [e.nm("s"), e.nm(&pn)])))
    append(body, e.callS("rt_str_drop", [e.nm("s")]))
    if owned { append(body, e.callS("rt_str_drop", [e.nm(&pn)])) }
    append(body, e.c.x.sx(e.c.x.asg(e.nm("s"), e.nm(&nn))))
}

fn (e: &Emitter) fieldNames(d: int, v: int): []str {
    var out: []str = []
    if v < 0 {
        for f in e.c.pg.types[d].fields { append(mut &out, f.name.clone()) }
    } else {
        for f in e.c.pg.variants[v].fields { append(mut &out, f.name.clone()) }
    }
    return out
}

// ---- derived serialization & deserialization (toData / fromData)

fn (e: mut &Emitter) serdeCall(name: &str, args: []int): int {
    let sm = e.c.pg.serdeMod()
    let sym = e.c.pg.mods[sm].scope.getOr(name, sema.Sym{k: -1, i: -1})
    let fnName = e.instance(sym.i, e.c.pg.mkFn(&[], sema.T_VOID))
    return e.call(&fnName, args)
}

fn (e: mut &Emitter) fromDataC(ft: int, dp: int): int {
    let f = e.c.pg.methodOf(ft, "fromData")
    if f < 0 {
        let g = e.glueFn(G_FROMDATA, ft)
        return e.call(&g, [dp])
    }
    var bind: []int = []
    e.c.pg.unify(e.c.pg.fns[f].recvType, ft, mut &bind, &e.c.pg.fns[f].tps)
    var ta: []int = []
    for tp in e.c.pg.fns[f].tps { append(mut &ta, envGet(&bind, tp)) }
    let fname = e.instance(f, e.c.pg.mkFn(&ta, sema.T_VOID))
    return e.call(&fname, [dp])
}

fn (e: mut &Emitter) resOkC(resCt: &str, v: int): int {
    let tag = e.c.x.desig(".tag", e.c.x.lit(0))
    let u = e.c.x.desig(".u.V_Ok", e.c.x.init([e.c.x.desig(".f_0", v)]))
    return e.c.x.par(e.c.x.clit(e.ct(resCt), e.c.x.init([tag, u])))
}

fn (e: mut &Emitter) resErrC(resCt: &str, err: int): int {
    let tag = e.c.x.desig(".tag", e.c.x.lit(1))
    let u = e.c.x.desig(".u.V_Err", e.c.x.init([e.c.x.desig(".f_0", err)]))
    return e.c.x.par(e.c.x.clit(e.ct(resCt), e.c.x.init([tag, u])))
}

fn (e: mut &Emitter) buildObjFields(t: int, d: int, v: int, a: int, dfCt: &str, arrVar: &str, body: mut &[]int) {
    let fnames = e.fieldNames(d, v)
    let fx = e.derivedFields(t, d, v, a)
    let fts = e.derivedTypes(t, d, v)
    let n = len(fts)
    append(body, e.c.x.decl(e.ct("lxl_arr"), arrVar, e.call("rt_arr_new", [e.c.x.lit(n), e.c.x.szof(e.ct(dfCt))])))
    let base = e.c.x.pcast(e.c.x.ptr(e.ct(dfCt)), e.c.x.dot(e.nm(arrVar), "data"))
    for i in 0..n {
        let kv = e.c.x.clit(e.ct(dfCt), e.c.x.init([
            e.c.x.desig(".f_key", e.call("rt_str_dup", [e.strlit(&fnames[i], false)])),
            e.c.x.desig(".f_val", e.methodC(fts[i], "toData", fx[i], -1))
        ]))
        append(body, e.c.x.sx(e.c.x.asg(e.c.x.idx(base, e.c.x.lit(i)), kv)))
    }
}

fn (e: mut &Emitter) deriveToData(t: int, n: &str) {
    let dataTy = e.c.pg.stdType("Data")
    let dfTy = e.c.pg.stdType("DataField")
    let dataCt = e.ctype(dataTy)
    let dfCt = e.ctype(dfTy)
    let pt = e.ctype(e.c.pg.mkRef(t, false))
    let a = e.nm("a")
    var body: []int = []
    if e.tk(t) == sema.TK_ARR {
        let et = e.c.pg.ta(t)
        let ec = e.ctype(et)
        let src = e.c.x.idx(e.c.x.pcast(e.c.x.ptr(e.ct(&ec)), e.c.x.arrow(a, "data")), e.nm("i"))
        let dst = e.c.x.idx(e.c.x.pcast(e.c.x.ptr(e.ct(&dataCt)), e.c.x.dot(e.nm("xs"), "data")), e.nm("i"))
        let h = e.loopHead(e.c.x.lit(0), "<", e.c.x.arrow(a, "len"), "++")
        append(mut &body, e.c.x.decl(e.ct("lxl_arr"), "xs", e.call("rt_arr_new", [e.c.x.arrow(a, "len"), e.c.x.szof(e.ct(&dataCt))])))
        append(mut &body, e.c.x.for1(h[0], h[1], h[2], e.c.x.sx(e.c.x.asg(dst, e.methodC(et, "toData", src, -1)))))
        append(mut &body, e.c.x.sret(e.serdeCall("dataArr", [e.nm("xs")])))
        e.define(n, &dataCt, [pt], ["a"], body, -1)
        return
    }
    let d = e.c.pg.ta(t)
    let boxed = !e.c.pg.types[d].value
    if e.c.pg.types[d].form == sx.F_RECORD {
        e.buildObjFields(t, d, -1, a, &dfCt, "fs", mut &body)
        append(mut &body, e.c.x.sret(e.serdeCall("dataObj", [e.nm("fs")])))
        e.define(n, &dataCt, [pt], ["a"], body, -1)
        return
    }
    // closed / value closed
    append(mut &body, e.c.x.sswitch(e.tagC(t, boxed, a)))
    let vs = copyInts(&e.c.pg.types[d].variants)
    for v in vs {
        append(mut &body, e.c.x.scase(e.c.x.lit(e.c.pg.variants[v].index)))
        let vname = e.c.pg.variants[v].name.clone()
        let fnames = e.fieldNames(d, v)
        let fx = e.derivedFields(t, d, v, a)
        let fts = e.derivedTypes(t, d, v)
        let nf = len(fts)
        let positional = nf > 0 && strByte(fnames[0], 0) >= '0' && strByte(fnames[0], 0) <= '9'
        if nf == 0 {
            append(mut &body, e.c.x.sret(e.serdeCall("dataStr", [e.call("rt_str_dup", [e.strlit(&vname, false)])])))
        } else if positional && nf == 1 {
            let pv = e.methodC(fts[0], "toData", fx[0], -1)
            append(mut &body, e.c.x.sret(e.serdeCall("wrapVariant", [e.strlit(&vname, false), pv])))
        } else if positional {
            let av = "xs" + intToStr(v)
            append(mut &body, e.c.x.decl(e.ct("lxl_arr"), &av, e.call("rt_arr_new", [e.c.x.lit(nf), e.c.x.szof(e.ct(&dataCt))])))
            let base = e.c.x.pcast(e.c.x.ptr(e.ct(&dataCt)), e.c.x.dot(e.nm(&av), "data"))
            for i in 0..nf {
                append(mut &body, e.c.x.sx(e.c.x.asg(e.c.x.idx(base, e.c.x.lit(i)), e.methodC(fts[i], "toData", fx[i], -1))))
            }
            let arrD = e.serdeCall("dataArr", [e.nm(&av)])
            append(mut &body, e.c.x.sret(e.serdeCall("wrapVariant", [e.strlit(&vname, false), arrD])))
        } else {
            let fv = "fs" + intToStr(v)
            e.buildObjFields(t, d, v, a, &dfCt, &fv, mut &body)
            let objD = e.serdeCall("dataObj", [e.nm(&fv)])
            append(mut &body, e.c.x.sret(e.serdeCall("wrapVariant", [e.strlit(&vname, false), objD])))
        }
    }
    append(mut &body, e.c.x.send())
    append(mut &body, e.c.x.sret(e.serdeCall("dataNull", [])))
    e.define(n, &dataCt, [pt], ["a"], body, -1)
}

fn (e: mut &Emitter) dropDecoded(fts: &[]int, prefix: &str, count: int, body: mut &[]int) {
    var j = count - 1
    while j >= 0 {
        if !e.pod(fts[j]) {
            append(body, e.c.x.sx(e.dropC(fts[j], e.nm(&(prefix + intToStr(j))))))
        }
        j -= 1
    }
}

fn (e: mut &Emitter) buildDecodedValue(t: int, d: int, vr: int, fnames: &[]str, prefix: &str, body: mut &[]int): int {
    let ct = e.ctype(t)
    let m = len(fnames)
    if e.c.pg.types[d].value {
        var its: []int = []
        for i in 0..m { append(mut &its, e.c.x.desig(&(".f_" + fnames[i]), e.nm(&(prefix + intToStr(i))))) }
        if vr >= 0 {
            let nv = e.c.pg.niche(t)
            if nv >= 0 {
                let u = "V_" + e.c.pg.variants[nv].name
                if vr == nv {
                    return e.c.x.par(e.c.x.clit(e.ct(&ct), e.c.x.init([e.c.x.desig(&(".u." + u), e.c.x.init(&its))])))
                }
                let fd = e.c.pg.variants[nv].fields[0].clone()
                let fenv = e.c.pg.declEnv(t)
                let ft = e.c.pg.subst(fd.ty, &fenv)
                let fct = e.ctype(ft)
                let z = e.c.x.desig(&(".f_" + fd.name), e.c.x.cast(e.ct(&fct), e.c.x.lit(0)))
                return e.c.x.par(e.c.x.clit(e.ct(&ct), e.c.x.init([e.c.x.desig(&(".u." + u), e.c.x.init(&[z]))])))
            }
            let tag = e.c.x.desig(".tag", e.c.x.lit(e.c.pg.variants[vr].index))
            if m == 0 { return e.c.x.par(e.c.x.clit(e.ct(&ct), e.c.x.init([tag]))) }
            let u = e.c.x.desig(&(".u.V_" + e.c.pg.variants[vr].name), e.c.x.init(&its))
            return e.c.x.par(e.c.x.clit(e.ct(&ct), e.c.x.init([tag, u])))
        }
        let inner = if m == 0 { [e.c.x.lit(0)] } else { its }
        return e.c.x.par(e.c.x.clit(e.ct(&ct), e.c.x.init(&inner)))
    }
    let ov = if vr >= 0 { "ov" + intToStr(vr) } else { "out" }
    let nn = e.nm(&ov)
    append(body, e.c.x.decl(e.ct(&ct), &ov, e.call("rt_alloc", [e.c.x.szof(e.c.x.pre("*", nn))])))
    if vr >= 0 { append(body, e.c.x.sx(e.c.x.asg(e.c.x.arrow(nn, "tag"), e.c.x.lit(e.c.pg.variants[vr].index)))) }
    for i in 0..m {
        let dst = if vr >= 0 {
            e.c.x.dot(e.c.x.dot(e.c.x.arrow(nn, "u"), &("V_" + e.c.pg.variants[vr].name)), &("f_" + fnames[i]))
        } else {
            e.c.x.arrow(nn, &("f_" + fnames[i]))
        }
        append(body, e.c.x.sx(e.c.x.asg(dst, e.nm(&(prefix + intToStr(i))))))
    }
    return nn
}

fn (e: mut &Emitter) decodeObjectFields(srcPtr: int, fnames: &[]str, fts: &[]int, resCt: &str, wrapField: &str,
                                        prefix: &str, body: mut &[]int) {
    let dataTy = e.c.pg.stdType("Data")
    let errTy = e.c.pg.stdType("DataError")
    let optDecl = e.c.pg.stdDecl("Option")
    let resDecl = e.c.pg.stdDecl("Result")
    let unitTy = e.c.pg.stdType("Unit")
    let chkResTy = e.c.pg.mkInst(resDecl, &[unitTy, errTy])
    let chkResCt = e.ctype(chkResTy)
    let optRefTy = e.c.pg.mkInst(optDecl, &[e.c.pg.mkRef(dataTy, false)])
    let optRefCt = e.ctype(optRefTy)
    let dataCt = e.ctype(dataTy)
    let chkVar = prefix + "chk"
    append(body, e.c.x.decl(e.ct(&chkResCt), &chkVar, e.serdeCall("objCheck", [srcPtr])))
    append(body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm(&chkVar), "tag"), e.c.x.lit(1))))
    var chkErr = e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&chkVar), "u"), "V_Err"), "f_0")
    if len(wrapField) > 0 { chkErr = e.serdeCall("errAtField", [chkErr, e.strlit(wrapField, false)]) }
    append(body, e.c.x.sret(e.resErrC(resCt, chkErr)))
    append(body, e.c.x.send())
    for i in 0..len(fts) {
        let ft = fts[i]
        let fCt = e.ctype(ft)
        let fResTy = e.c.pg.mkInst(resDecl, &[ft, errTy])
        let fResCt = e.ctype(fResTy)
        let optVar = prefix + "o" + intToStr(i)
        let ptrVar = prefix + "p" + intToStr(i)
        let resVar = prefix + "r" + intToStr(i)
        let valVar = prefix + intToStr(i)
        append(body, e.c.x.decl(e.ct(&optRefCt), &optVar, e.serdeCall("objLookup", [srcPtr, e.strlit(&fnames[i], false)])))
        if e.c.pg.isOption(ft) {
            let nulVar = prefix + "n" + intToStr(i)
            append(body, e.c.x.decl(e.ct(&dataCt), &nulVar, e.serdeCall("dataNull", [])))
            let pExpr = e.c.x.cond(
                e.c.x.bin("==", e.c.x.dot(e.nm(&optVar), "tag"), e.c.x.lit(0)),
                e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&optVar), "u"), "V_Some"), "f_0"),
                e.c.x.pre("&", e.nm(&nulVar))
            )
            append(body, e.c.x.decl(e.c.x.ptr(e.ct(&dataCt)), &ptrVar, pExpr))
        } else {
            append(body, e.c.x.sif(e.c.x.bin("!=", e.c.x.dot(e.nm(&optVar), "tag"), e.c.x.lit(0))))
            e.dropDecoded(fts, prefix, i, body)
            var mErr = e.serdeCall("errMissing", [e.strlit(&fnames[i], false)])
            if len(wrapField) > 0 { mErr = e.serdeCall("errAtField", [mErr, e.strlit(wrapField, false)]) }
            append(body, e.c.x.sret(e.resErrC(resCt, mErr)))
            append(body, e.c.x.send())
            append(body, e.c.x.decl(e.c.x.ptr(e.ct(&dataCt)), &ptrVar,
                e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&optVar), "u"), "V_Some"), "f_0")))
        }
        append(body, e.c.x.decl(e.ct(&fResCt), &resVar, e.fromDataC(ft, e.nm(&ptrVar))))
        append(body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm(&resVar), "tag"), e.c.x.lit(1))))
        e.dropDecoded(fts, prefix, i, body)
        var fErr = e.serdeCall("errAtField", [
            e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&resVar), "u"), "V_Err"), "f_0"),
            e.strlit(&fnames[i], false)
        ])
        if len(wrapField) > 0 { fErr = e.serdeCall("errAtField", [fErr, e.strlit(wrapField, false)]) }
        append(body, e.c.x.sret(e.resErrC(resCt, fErr)))
        append(body, e.c.x.send())
        append(body, e.c.x.decl(e.ct(&fCt), &valVar, e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&resVar), "u"), "V_Ok"), "f_0")))
    }
}

fn (e: mut &Emitter) deriveFromData(t: int, n: &str) {
    let dataTy = e.c.pg.stdType("Data")
    let errTy = e.c.pg.stdType("DataError")
    let resDecl = e.c.pg.stdDecl("Result")
    let optDecl = e.c.pg.stdDecl("Option")
    let resTy = e.c.pg.mkInst(resDecl, &[t, errTy])
    let resCt = e.ctype(resTy)
    let dataCt = e.ctype(dataTy)
    let dpCt = e.ctype(e.c.pg.mkRef(dataTy, false))
    let dp = e.nm("d")
    var body: []int = []
    if e.tk(t) == sema.TK_ARR {
        let et = e.c.pg.ta(t)
        let ec = e.ctype(et)
        let arrDataTy = e.c.pg.mkArr(dataTy)
        let itemsResTy = e.c.pg.mkInst(resDecl, &[e.c.pg.mkRef(arrDataTy, false), errTy])
        let itemsResCt = e.ctype(itemsResTy)
        let elemResTy = e.c.pg.mkInst(resDecl, &[et, errTy])
        let elemResCt = e.ctype(elemResTy)
        append(mut &body, e.c.x.decl(e.ct(&itemsResCt), "ar", e.serdeCall("arrItems", [dp])))
        append(mut &body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm("ar"), "tag"), e.c.x.lit(1))))
        append(mut &body, e.c.x.sret(e.resErrC(&resCt, e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm("ar"), "u"), "V_Err"), "f_0"))))
        append(mut &body, e.c.x.send())
        append(mut &body, e.c.x.decl(e.c.x.ptr(e.ct("lxl_arr")), "xs",
            e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm("ar"), "u"), "V_Ok"), "f_0")))
        append(mut &body, e.c.x.decl(e.ct("lxl_arr"), "out",
            e.call("rt_arr_cap", [e.c.x.arrow(e.nm("xs"), "len"), e.c.x.szof(e.ct(&ec)), e.c.x.str("serde")])))
        let h = e.loopHead(e.c.x.lit(0), "<", e.c.x.arrow(e.nm("xs"), "len"), "++")
        append(mut &body, e.c.x.sfor(h[0], h[1], h[2]))
        let itemPtr = e.c.x.pre("&", e.c.x.idx(e.c.x.pcast(e.c.x.ptr(e.ct(&dataCt)), e.c.x.arrow(e.nm("xs"), "data")), e.nm("i")))
        append(mut &body, e.c.x.decl(e.ct(&elemResCt), "er", e.fromDataC(et, itemPtr)))
        append(mut &body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm("er"), "tag"), e.c.x.lit(1))))
        append(mut &body, e.c.x.sx(e.dropC(t, e.nm("out"))))
        let idxErr = e.serdeCall("errAtIndex", [
            e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm("er"), "u"), "V_Err"), "f_0"),
            e.nm("i")
        ])
        append(mut &body, e.c.x.sret(e.resErrC(&resCt, idxErr)))
        append(mut &body, e.c.x.send())
        let slot = e.c.x.pre("*", e.c.x.pcast(e.c.x.ptr(e.ct(&ec)),
            e.call("rt_arr_push", [e.c.x.pre("&", e.nm("out")), e.c.x.szof(e.ct(&ec))])))
        append(mut &body, e.c.x.sx(e.c.x.asg(slot, e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm("er"), "u"), "V_Ok"), "f_0"))))
        append(mut &body, e.c.x.send())
        append(mut &body, e.c.x.sret(e.resOkC(&resCt, e.nm("out"))))
        e.define(n, &resCt, [dpCt], ["d"], body, -1)
        return
    }
    let d = e.c.pg.ta(t)
    if e.c.pg.types[d].form == sx.F_RECORD {
        let fnames = e.fieldNames(d, -1)
        let fts = e.derivedTypes(t, d, -1)
        e.decodeObjectFields(dp, &fnames, &fts, &resCt, "", "f", mut &body)
        let built = e.buildDecodedValue(t, d, -1, &fnames, "f", mut &body)
        append(mut &body, e.c.x.sret(e.resOkC(&resCt, built)))
        e.define(n, &resCt, [dpCt], ["d"], body, -1)
        return
    }
    // closed / value closed
    let tagResTy = e.c.pg.mkInst(resDecl, &[e.c.pg.mkRef(sema.T_STR, false), errTy])
    let tagResCt = e.ctype(tagResTy)
    let optRefTy = e.c.pg.mkInst(optDecl, &[e.c.pg.mkRef(dataTy, false)])
    let payResTy = e.c.pg.mkInst(resDecl, &[optRefTy, errTy])
    let payResCt = e.ctype(payResTy)
    let arrDataTy = e.c.pg.mkArr(dataTy)
    let itemsResTy = e.c.pg.mkInst(resDecl, &[e.c.pg.mkRef(arrDataTy, false), errTy])
    let itemsResCt = e.ctype(itemsResTy)
    append(mut &body, e.c.x.decl(e.ct(&tagResCt), "tr", e.serdeCall("asTagName", [dp])))
    append(mut &body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm("tr"), "tag"), e.c.x.lit(1))))
    append(mut &body, e.c.x.sret(e.resErrC(&resCt, e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm("tr"), "u"), "V_Err"), "f_0"))))
    append(mut &body, e.c.x.send())
    append(mut &body, e.c.x.decl(e.ct("lxl_str"), "tn", e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm("tr"), "u"), "V_Ok"), "f_0")))
    append(mut &body, e.c.x.decl(e.ct(&payResCt), "pr", e.serdeCall("asTagPayload", [dp])))
    append(mut &body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm("pr"), "tag"), e.c.x.lit(1))))
    append(mut &body, e.c.x.sret(e.resErrC(&resCt, e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm("pr"), "u"), "V_Err"), "f_0"))))
    append(mut &body, e.c.x.send())
    let optRefCt = e.ctype(optRefTy)
    append(mut &body, e.c.x.decl(e.ct(&optRefCt), "po", e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm("pr"), "u"), "V_Ok"), "f_0")))

    let vs = copyInts(&e.c.pg.types[d].variants)
    for v in vs {
        let vname = e.c.pg.variants[v].name.clone()
        let fnames = e.fieldNames(d, v)
        let fts = e.derivedTypes(t, d, v)
        let nf = len(fts)
        let positional = nf > 0 && strByte(fnames[0], 0) >= '0' && strByte(fnames[0], 0) <= '9'
        let vp = "v" + intToStr(v) + "_"
        append(mut &body, e.c.x.sif(e.call("rt_str_eq", [e.nm("tn"), e.strlit(&vname, false)])))
        if nf == 0 {
            append(mut &body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm("po"), "tag"), e.c.x.lit(0))))
            append(mut &body, e.c.x.sret(e.resErrC(&resCt, e.serdeCall("errVariantNoPayload", [e.strlit(&vname, false)]))))
            append(mut &body, e.c.x.send())
            let built = e.buildDecodedValue(t, d, v, &fnames, &vp, mut &body)
            append(mut &body, e.c.x.sret(e.resOkC(&resCt, built)))
        } else {
            append(mut &body, e.c.x.sif(e.c.x.bin("!=", e.c.x.dot(e.nm("po"), "tag"), e.c.x.lit(0))))
            append(mut &body, e.c.x.sret(e.resErrC(&resCt, e.serdeCall("errVariantNeedsPayload", [e.strlit(&vname, false)]))))
            append(mut &body, e.c.x.send())
            let payVar = vp + "pay"
            append(mut &body, e.c.x.decl(e.c.x.ptr(e.ct(&dataCt)), &payVar,
                e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm("po"), "u"), "V_Some"), "f_0")))
            if positional && nf == 1 {
                let ft = fts[0]
                let fCt = e.ctype(ft)
                let fResTy = e.c.pg.mkInst(resDecl, &[ft, errTy])
                let fResCt = e.ctype(fResTy)
                let rVar = vp + "r0"
                append(mut &body, e.c.x.decl(e.ct(&fResCt), &rVar, e.fromDataC(ft, e.nm(&payVar))))
                append(mut &body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm(&rVar), "tag"), e.c.x.lit(1))))
                let vErr = e.serdeCall("errAtField", [
                    e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&rVar), "u"), "V_Err"), "f_0"),
                    e.strlit(&vname, false)
                ])
                append(mut &body, e.c.x.sret(e.resErrC(&resCt, vErr)))
                append(mut &body, e.c.x.send())
                append(mut &body, e.c.x.decl(e.ct(&fCt), &(vp + "0"),
                    e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&rVar), "u"), "V_Ok"), "f_0")))
                let built = e.buildDecodedValue(t, d, v, &fnames, &vp, mut &body)
                append(mut &body, e.c.x.sret(e.resOkC(&resCt, built)))
            } else if positional {
                let arVar = vp + "ar"
                let xsVar = vp + "xs"
                append(mut &body, e.c.x.decl(e.ct(&itemsResCt), &arVar, e.serdeCall("arrItems", [e.nm(&payVar)])))
                append(mut &body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm(&arVar), "tag"), e.c.x.lit(1))))
                let aErr = e.serdeCall("errAtField", [
                    e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&arVar), "u"), "V_Err"), "f_0"),
                    e.strlit(&vname, false)
                ])
                append(mut &body, e.c.x.sret(e.resErrC(&resCt, aErr)))
                append(mut &body, e.c.x.send())
                append(mut &body, e.c.x.decl(e.c.x.ptr(e.ct("lxl_arr")), &xsVar,
                    e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&arVar), "u"), "V_Ok"), "f_0")))
                append(mut &body, e.c.x.sif(e.c.x.bin("!=", e.c.x.arrow(e.nm(&xsVar), "len"), e.c.x.lit(nf))))
                append(mut &body, e.c.x.sret(e.resErrC(&resCt, e.serdeCall("errVariantArity", [
                    e.strlit(&vname, false), e.c.x.lit(nf), e.c.x.arrow(e.nm(&xsVar), "len")
                ]))))
                append(mut &body, e.c.x.send())
                for i in 0..nf {
                    let ft = fts[i]
                    let fCt = e.ctype(ft)
                    let fResTy = e.c.pg.mkInst(resDecl, &[ft, errTy])
                    let fResCt = e.ctype(fResTy)
                    let rVar = vp + "r" + intToStr(i)
                    let elPtr = e.c.x.pre("&", e.c.x.idx(e.c.x.pcast(e.c.x.ptr(e.ct(&dataCt)), e.c.x.arrow(e.nm(&xsVar), "data")), e.c.x.lit(i)))
                    append(mut &body, e.c.x.decl(e.ct(&fResCt), &rVar, e.fromDataC(ft, elPtr)))
                    append(mut &body, e.c.x.sif(e.c.x.bin("==", e.c.x.dot(e.nm(&rVar), "tag"), e.c.x.lit(1))))
                    e.dropDecoded(&fts, &vp, i, mut &body)
                    let idxErr = e.serdeCall("errAtIndex", [
                        e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&rVar), "u"), "V_Err"), "f_0"),
                        e.c.x.lit(i)
                    ])
                    let vErr = e.serdeCall("errAtField", [idxErr, e.strlit(&vname, false)])
                    append(mut &body, e.c.x.sret(e.resErrC(&resCt, vErr)))
                    append(mut &body, e.c.x.send())
                    append(mut &body, e.c.x.decl(e.ct(&fCt), &(vp + intToStr(i)),
                        e.c.x.dot(e.c.x.dot(e.c.x.dot(e.nm(&rVar), "u"), "V_Ok"), "f_0")))
                }
                let built = e.buildDecodedValue(t, d, v, &fnames, &vp, mut &body)
                append(mut &body, e.c.x.sret(e.resOkC(&resCt, built)))
            } else {
                e.decodeObjectFields(e.nm(&payVar), &fnames, &fts, &resCt, &vname, &vp, mut &body)
                let built = e.buildDecodedValue(t, d, v, &fnames, &vp, mut &body)
                append(mut &body, e.c.x.sret(e.resOkC(&resCt, built)))
            }
        }
        append(mut &body, e.c.x.send())
    }
    let tname = e.c.pg.types[d].name.clone()
    append(mut &body, e.c.x.sret(e.resErrC(&resCt, e.serdeCall("errUnknownVariant", [e.strlit(&tname, false), e.nm("tn")]))))
    e.define(n, &resCt, [dpCt], ["d"], body, -1)
}

fn (e: mut &Emitter) dupC(t: int, cc: int): int {
    if e.pod(t) { return cc }
    if t == sema.T_STR { return e.call("rt_str_dup", [cc]) }
    let g = e.glueFn(G_DUP, t)
    return e.call(&g, [cc])
}

// Drop glue. A type is dropped by direct (recursive) C functions unless it is a chain type (it
// lies on a cycle of the type graph of fields and elements, generic instances included, so its
// values can nest without bound) or has a drop method. Those are dropped by actions on an
// explicit stack (rt_dpush/rt_drun, SPEC 9.4); an action gets the object pointer of a boxed
// value, the address of any other. The order is that of SPEC 9.2 either way.

// The non-pod types reachable from the fields or elements of t (DEEP: too deep to tell).
fn (e: mut &Emitter) reach(t: int): int {
    let have = e.reachIdx.getOr(&t, -1)
    if have >= 0 { return have }
    var r: []int = []
    var seen: Map[int, bool] = newMap()
    var todo = e.kids(t)
    while len(todo) > 0 {
        let x = pop(mut &todo)
        if !seen.has(&x) {
            seen.put(x, true)
            append(mut &r, x)
            if x != DEEP {
                if e.c.pg.depth(x) <= MAX_DEPTH + 8 {
                    let ks = e.kids(x)
                    for k in ks { append(mut &todo, k) }
                } else {
                    append(mut &todo, DEEP)
                }
            }
        }
    }
    append(mut &e.reachSets, r)
    e.reachIdx.put(t, len(e.reachSets) - 1)
    return len(e.reachSets) - 1
}

fn (e: mut &Emitter) kids(t: int): []int {
    var ks: []int = []
    let k = e.tk(t)
    if k == sema.TK_ARR {
        append(mut &ks, e.c.pg.ta(t))
    } else if k == sema.TK_INST {
        ks = e.c.pg.fieldTypes(t)
    }
    var out: []int = []
    for x in ks {
        if !e.pod(x) { append(mut &out, x) }
    }
    return out
}

fn (e: mut &Emitter) inReach(t: int, x: int): bool {
    let r = e.reach(t)
    for y in e.reachSets[r] {
        if y == x { return true }
    }
    return false
}

fn (e: mut &Emitter) chain(t: int): bool { return e.tk(t) == sema.TK_BOX || e.inReach(t, t) || e.inReach(t, DEEP) }

fn (e: &Emitter) hasDrop(t: int): bool {
    return e.tk(t) == sema.TK_BOX || (e.tk(t) == sema.TK_INST && e.c.pg.types[e.c.pg.ta(t)].drop >= 0)
}

// Dropping t runs no drop method and does not nest without bound: it may run at any time.
fn (e: mut &Emitter) quiet(t: int): bool {
    if e.chain(t) || e.hasDrop(t) { return false }
    let r = e.reach(t)
    for x in e.reachSets[r] {
        if x != DEEP && e.hasDrop(x) { return false }
    }
    return true
}

fn (e: mut &Emitter) listed(t: int): bool { return e.chain(t) || e.hasDrop(t) }

// The non-pod fields of the record t or a variant vr of it: types and places (fields of base,
// sep "." or "->").
fn (e: mut &Emitter) us(t: int, vr: int, base: int, sep: &str, fts: mut &[]int, locs: mut &[]int) {
    let d = e.c.pg.ta(t)
    let env = e.c.pg.declEnv(t)
    let n = if vr >= 0 { len(e.c.pg.variants[vr].fields) } else { len(e.c.pg.types[d].fields) }
    var b = base
    var s: str = sep.clone()
    if vr >= 0 {
        b = e.c.x.dot(e.c.x.member(base, sep, "u"), &("V_" + e.c.pg.variants[vr].name))
        s = "."
    }
    for i in 0..n {
        let f = if vr >= 0 { e.c.pg.variants[vr].fields[i].clone() } else { e.c.pg.types[d].fields[i].clone() }
        let ft = e.c.pg.subst(f.ty, &env)
        if !e.pod(ft) {
            append(fts, ft)
            append(locs, e.c.x.member(b, &s, &("f_" + f.name)))
        }
    }
}

// f(fields) for the record t or each variant of the closed type t (in a switch on its tag).
fn (e: mut &Emitter) cases(t: int, base: int, sep: &str, mode: int, boxed: bool): Lines {
    let d = e.c.pg.ta(t)
    if e.c.pg.types[d].form == sx.F_RECORD {
        var fts: []int = []
        var locs: []int = []
        e.us(t, -1, base, sep, mut &fts, mut &locs)
        return e.caseBody(mode, &fts, &locs, boxed)
    }
    let nv = e.c.pg.niche(t)
    if nv >= 0 {
        // a niche type (sema niche): the box variant's fields when its pointer is not null
        var fts: []int = []
        var locs: []int = []
        e.us(t, nv, base, sep, mut &fts, mut &locs)
        let r = e.caseBody(mode, &fts, &locs, boxed)
        let f = e.c.pg.variants[nv].fields[0].name.clone()
        let p = e.c.x.dot(e.c.x.dot(e.c.x.member(base, sep, "u"), &("V_" + e.c.pg.variants[nv].name)), &("f_" + f))
        var out: []int = [e.c.x.sif(p)]
        for x in r.ls { append(mut &out, x) }
        append(mut &out, e.c.x.send())
        return Lines{ls: out, refs: r.refs}
    }
    var refs = false
    let vs = copyInts(&e.c.pg.types[d].variants)
    var active: [][]int = []
    var cidx: []int = []
    for v in vs {
        var fts: []int = []
        var locs: []int = []
        e.us(t, v, base, sep, mut &fts, mut &locs)
        let r = e.caseBody(mode, &fts, &locs, boxed)
        refs = refs || r.refs
        if len(r.ls) > 0 {
            append(mut &active, r.ls)
            append(mut &cidx, e.c.pg.variants[v].index)
        }
    }
    if len(cidx) == 0 { return Lines{ls: [], refs: refs} }
    if len(cidx) == 1 {
        var out: []int = [e.c.x.sif(e.c.x.bin("==", e.tagX(t, base, sep), e.c.x.lit(cidx[0])))]
        for x in active[0] { append(mut &out, x) }
        append(mut &out, e.c.x.send())
        return Lines{ls: out, refs: refs}
    }
    var out: []int = [e.c.x.sswitch(e.tagX(t, base, sep))]
    for i in 0..len(cidx) {
        append(mut &out, e.c.x.scase(e.c.x.lit(cidx[i])))
        for x in active[i] { append(mut &out, x) }
        append(mut &out, e.c.x.sbreak())
    }
    append(mut &out, e.c.x.send())
    return Lines{ls: out, refs: refs}
}

fn (e: mut &Emitter) caseBody(mode: int, fts: &[]int, locs: &[]int, boxed: bool): Lines {
    var out: []int = []
    var refs = false
    if mode == CM_PARTS {
        for i in 0..len(fts) {
            let p = e.part(fts[i], locs[i])
            for x in p.ls { append(mut &out, x) }
            refs = refs || p.refs
        }
    } else if mode == CM_DIRECT {
        var i = len(fts) - 1
        while i >= 0 {
            append(mut &out, e.c.x.sx(e.dropC(fts[i], locs[i])))
            i -= 1
        }
    } else {
        // a field after the last pushed one is dropped now (they run first), as is a quiet one
        var k = 0
        for i in 0..len(fts) {
            if e.chain(fts[i]) { k = i + 1 }
        }
        for i in 0..k {
            let p = e.part(fts[i], locs[i])
            for x in p.ls { append(mut &out, x) }
            refs = refs || p.refs
        }
        var i = len(fts) - 1
        while i >= k {
            append(mut &out, e.c.x.sx(e.dropC(fts[i], locs[i])))
            i -= 1
        }
        if boxed {
            if refs {
                var o2: []int = [e.callS("rt_dpush", [e.nm("rt_free_act"), e.nm("v")])]
                for x in out { append(mut &o2, x) }
                out = o2
            } else {
                append(mut &out, e.callS("rt_free", [e.nm("v")]))
            }
        }
    }
    return Lines{ls: out, refs: refs}
}

// Statements that push the drop of the value at loc, and whether the actions read loc's
// memory: a boxed value is pushed by pointer, a chain value type without a drop method by its
// parts.
fn (e: mut &Emitter) push(t: int, loc: int): Lines {
    if e.tk(t) == sema.TK_BOX {
        return Lines{ls: [e.callS("rt_dpush", [e.c.x.arrow(e.c.x.dot(loc, "vt"), "drop"), e.c.x.dot(loc, "data")])], refs: false}
    }
    let inst = e.tk(t) == sema.TK_INST
    if inst && !e.c.pg.types[e.c.pg.ta(t)].value {
        let g = e.glueFn(G_ACT, t)
        return Lines{ls: [e.callS("rt_dpush", [e.nm(&g), loc])], refs: false}
    }
    if inst && e.chain(t) && e.c.pg.types[e.c.pg.ta(t)].drop < 0 { return e.cases(t, loc, ".", CM_PARTS, false) }
    let g = e.glueFn(G_ACT, t)
    return Lines{ls: [e.callS("rt_dpush", [e.nm(&g), e.c.x.pre("&", loc)])], refs: true}
}

// In an action, before the last pushed part: a quiet drop now, any other pushed.
fn (e: mut &Emitter) part(t: int, loc: int): Lines {
    if e.quiet(t) { return Lines{ls: [e.c.x.sx(e.dropC(t, loc))], refs: false} }
    return e.push(t, loc)
}

// for (int64_t i = from; i op to; i<step>)
fn (e: mut &Emitter) loopHead(from: int, op: &str, to: int, step: &str): []int {
    let i = e.nm("i")
    return [e.c.x.decl(e.ct("int64_t"), "i", from), e.c.x.bin(op, i, to), e.c.x.post(i, step)]
}

// The body of a recursive drop of v (not a chain type, no drop method).
fn (e: mut &Emitter) direct(t: int): []int {
    if e.tk(t) == sema.TK_ARR {
        let et = e.c.pg.ta(t)
        let ec = e.ctype(et)
        let el = e.c.x.idx(e.c.x.pcast(e.c.x.ptr(e.ct(&ec)), e.c.x.dot(e.nm("v"), "data")), e.nm("i"))
        var out: []int = []
        let dc = e.dropC(et, el)
        if !e.pod(et) {
            let h = e.loopHead(e.c.x.lit(0), "<", e.c.x.dot(e.nm("v"), "len"), "++")
            append(mut &out, e.c.x.for1(h[0], h[1], h[2], e.c.x.sx(dc)))
        }
        append(mut &out, e.callS("rt_arr_free", [e.nm("v")]))
        return out
    }
    if e.c.pg.ta(t) == e.c.pg.shared { return [e.callS("rt_sh_drop", [e.c.x.dot(e.nm("v"), "f_p")])] }
    let boxed = !e.c.pg.types[e.c.pg.ta(t)].value
    var r = e.cases(t, e.nm("v"), if boxed { "->" } else { "." }, CM_DIRECT, boxed)
    if boxed { append(mut &r.ls, e.callS("rt_free", [e.nm("v")])) }
    return replace(mut &r.ls, [])
}

// The body of an action that drops the fields or elements of t and frees its memory: what
// must not nest is pushed (fields in declaration order, so that they run last to first;
// elements last to first), the rest is dropped now; a container that a pushed action reads
// is freed by an action pushed first.
fn (e: mut &Emitter) rest(t: int): []int {
    if e.tk(t) == sema.TK_ARR {
        let et = e.c.pg.ta(t)
        let ec = e.ctype(et)
        let el = e.c.x.idx(e.c.x.pcast(e.c.x.ptr(e.ct(&ec)), e.c.x.arrow(e.nm("a"), "data")), e.nm("i"))
        let da = e.c.x.decl(e.ct("lxl_arr*"), "a", e.nm("p"))
        let free = e.callS("rt_arr_free", [e.c.x.pre("*", e.nm("a"))])
        if !e.chain(et) {
            let dc = e.dropC(et, el)
            let h = e.loopHead(e.c.x.lit(0), "<", e.c.x.arrow(e.nm("a"), "len"), "++")
            return [da, e.c.x.for1(h[0], h[1], h[2], e.c.x.sx(dc)), free]
        }
        let p = e.push(et, el)
        let h = e.loopHead(e.c.x.bin("-", e.c.x.arrow(e.nm("a"), "len"), e.c.x.lit(1)), ">=", e.c.x.lit(0), "--")
        var loop: []int = [e.c.x.sfor(h[0], h[1], h[2])]
        for x in p.ls { append(mut &loop, x) }
        append(mut &loop, e.c.x.send())
        let lp = e.c.x.seq(loop)
        if p.refs {
            let data = e.c.x.arrow(e.nm("a"), "data")
            return [da, e.c.x.if1(data, e.callS("rt_dpush", [e.nm("rt_free_act"), data])), lp]
        }
        return [da, lp, free]
    }
    let boxed = !e.c.pg.types[e.c.pg.ta(t)].value
    let ct = e.ctype(t)
    var out: []int = [e.c.x.decl(e.ct(&(ct + (if boxed { "" } else { "*" }))), "v", e.nm("p"))]
    let r = e.cases(t, e.nm("v"), "->", CM_SEQ, boxed)
    for x in r.ls { append(mut &out, x) }
    return out
}

// A drop action that pushes itself (a chain type: a list's next node, a tree's children) loops on
// the last of those pushes instead: that action is the next to run when this one returns (the
// stack is LIFO, rt_drun), so running it from the top in a loop keeps every drop and free in its
// order and saves a push, a pop and an indirect call per node. Each push of itself is held in nx
// and pushed only when another push follows it; what is held at the end is looped on:
//     while (1) { void* nx = 0; ...  if (nx) rt_dpush(self, nx); nx = X;  ...
//                 if (nx) { rt_dpush(self, nx); nx = 0; } rt_dpush(other, Y);  ...
//                 if (!nx) break; p = nx; }
// Only when every push is a statement of the body itself (not inside a loop of it).
// With local (no drop method reachable from the type: the order of its parts' drops shows
// nothing), the values of its own type wait in a stack of the action's own, up to DSTACK, before
// the worklist: a tree's drop then makes no call but rt_free's.
fn (e: mut &Emitter) selfLoop(n: &str, body: []int, local: bool): []int {
    var selfs = 0
    var nested = false
    for ln in body {
        let k = e.pushOf(ln, n)
        if k == 1 { selfs += 1 }
        if k == 0 && e.mentions(ln, "rt_dpush") { nested = true }
    }
    if selfs == 0 || nested { return body }
    let nx = e.nm("nx")
    let flush = e.c.x.if1(nx, e.callS("rt_dpush", [e.nm(n), e.nm("nx")]))
    var out: []int = []
    if local {
        append(mut &out, e.c.x.declArr(e.ct("void*"), "ls", DSTACK, -1))
        append(mut &out, e.c.x.decl(e.ct("int64_t"), "lt", e.c.x.lit(0)))
    }
    append(mut &out, e.c.x.swhile(e.c.x.lit(1)))
    append(mut &out, e.c.x.decl(e.ct("void*"), "nx", e.c.x.lit(0)))
    for ln in body {
        let k = e.pushOf(ln, n)
        if k == 1 && local {
            // if (nx) { if (lt < DSTACK) ls[lt++] = nx; else rt_dpush(self, nx); }
            append(mut &out, e.c.x.sif(e.nm("nx")))
            append(mut &out, e.c.x.sif(e.c.x.bin("<", e.nm("lt"), e.c.x.lit(DSTACK))))
            append(mut &out, e.c.x.sx(e.c.x.asg(e.c.x.idx(e.nm("ls"), e.nm("lt")), e.nm("nx"))))
            append(mut &out, e.c.x.sx(e.c.x.asg(e.nm("lt"), e.c.x.bin("+", e.nm("lt"), e.c.x.lit(1)))))
            append(mut &out, e.c.x.selse())
            append(mut &out, e.callS("rt_dpush", [e.nm(n), e.nm("nx")]))
            append(mut &out, e.c.x.send())
            append(mut &out, e.c.x.send())
            let arg = e.c.x.listAt(e.c.x.nodes[e.c.x.nodes[ln].a].l, 1)
            append(mut &out, e.c.x.sx(e.c.x.asg(e.nm("nx"), arg)))
        } else if k == 1 {
            append(mut &out, flush)
            let arg = e.c.x.listAt(e.c.x.nodes[e.c.x.nodes[ln].a].l, 1)
            append(mut &out, e.c.x.sx(e.c.x.asg(e.nm("nx"), arg)))
        } else if k == 2 {
            append(mut &out, e.c.x.sif(e.nm("nx")))
            append(mut &out, e.callS("rt_dpush", [e.nm(n), e.nm("nx")]))
            append(mut &out, e.c.x.sx(e.c.x.asg(e.nm("nx"), e.c.x.lit(0))))
            append(mut &out, e.c.x.send())
            append(mut &out, ln)
        } else {
            append(mut &out, ln)
        }
    }
    if local {
        // if (!nx) { if (lt == 0) break; nx = ls[--lt]; }
        append(mut &out, e.c.x.sif(e.c.x.pre("!", e.nm("nx"))))
        append(mut &out, e.c.x.if1(e.c.x.bin("==", e.nm("lt"), e.c.x.lit(0)), e.c.x.sbreak()))
        append(mut &out, e.c.x.sx(e.c.x.asg(e.nm("lt"), e.c.x.bin("-", e.nm("lt"), e.c.x.lit(1)))))
        append(mut &out, e.c.x.sx(e.c.x.asg(e.nm("nx"), e.c.x.idx(e.nm("ls"), e.nm("lt")))))
        append(mut &out, e.c.x.send())
    } else {
        append(mut &out, e.c.x.if1(e.c.x.pre("!", e.nm("nx")), e.c.x.sbreak()))
    }
    append(mut &out, e.c.x.sx(e.c.x.asg(e.nm("p"), e.nm("nx"))))
    append(mut &out, e.c.x.send())
    return out
}

// The values a drop action keeps in its own stack before the worklist (selfLoop).
const DSTACK = 32

// Whether no type reachable from t (t too) has a drop method: the order of its parts' drops is
// not seen.
fn (e: mut &Emitter) noUserDrop(t: int): bool {
    if e.hasDrop(t) { return false }
    let r = e.reach(t)
    for x in e.reachSets[r] {
        if x != DEEP && e.hasDrop(x) { return false }
    }
    return true
}

// Whether line ln is `rt_dpush(f, x);`: 1 when f is self, 2 another, else 0.
fn (e: &Emitter) pushOf(ln: int, me: &str): int {
    let x = &e.c.x
    if x.k(ln) != tm.Z_EXPR { return 0 }
    let c = x.nodes[ln].a
    if c < 0 || x.k(c) != tm.X_CALL || x.k(x.nodes[c].a) != tm.X_NAME || x.nodes[x.nodes[c].a].s != "rt_dpush" { return 0 }
    let f = x.listAt(x.nodes[c].l, 0)
    return if x.k(f) == tm.X_NAME && x.nodes[f].s == me { 1 } else { 2 }
}

// Whether node m (a statement or expression) names name anywhere.
fn (e: &Emitter) mentions(m: int, name: &str): bool {
    if m < 0 { return false }
    let x = &e.c.x
    let nd = &x.nodes[m]
    if nd.k == tm.X_NAME && nd.s == name { return true }
    if nd.k == tm.X_HOLE { return false }
    if e.mentions(nd.a, name) || e.mentions(nd.b, name) || e.mentions(nd.c, name) { return true }
    if nd.k == tm.Z_FOR1 && e.mentions(nd.v, name) { return true }
    if nd.l >= 0 {
        for j in 0..x.listLen(nd.l) {
            if e.mentions(x.listAt(nd.l, j), name) { return true }
        }
    }
    return false
}

fn (e: mut &Emitter) glueFn(kind: int, t: int): str {
    let key = t * 16 + kind
    if !e.glue.has(&key) {
        // an rc handle's glue ends in _rc: par.map's kernel check refuses it (the count is not atomic)
        let sfx = if e.c.pg.isRc(t) { "_rc" } else { "" }
        e.glue.put(key, "gl" + intToStr(e.nglue) + "_" + GLUE_NAMES[kind] + sfx)
        e.nglue += 1
        append(mut &e.gluework, Glue{kind: kind, t: t})
    }
    return e.glue.getOr(&key, "")
}

fn (e: mut &Emitter) define(name: &str, ret: &str, ptys: []str, pnames: []str, lines: []int, res: int) {
    append(mut &e.fns, FnDef{name: name.clone(), ret: ret.clone(), ptys: ptys, pnames: pnames, lines: lines, res: res})
}

fn (e: mut &Emitter) makeGlue(kind: int, t: int) {
    let key = t * 16 + kind
    let n = e.glue.getOr(&key, "")
    let gk: []str = ["the drop of", "a drop action of", "the drop of the rest of", "the copy of", "the closure made of",
        "the clone of", "the derived eq of", "the derived hash of", "the derived toStr of",
        "the derived toData of", "the derived fromData of"]
    e.fsrc.put(n.clone(), gk[kind] + " " + e.c.pg.tstr(t))
    let ct = e.ctype(t)
    if kind == G_EQ || kind == G_HASH || kind == G_SHOW {
        e.deriveGlue(kind, t, &n)
        return
    }
    if kind == G_TODATA {
        e.deriveToData(t, &n)
        return
    }
    if kind == G_FROMDATA {
        e.deriveFromData(t, &n)
        return
    }
    if kind == G_TRAMP {        // a plain function seen as a closure: the environment is the function
        var ps: []str = ["void*"]
        var pns: []str = ["e"]
        var avs: []int = []
        for i in 0..e.c.pg.tn(t) {
            append(mut &ps, e.ctype(e.c.pg.ti(t, i)))
            append(mut &pns, "a" + intToStr(i))
            append(mut &avs, e.nm(&("a" + intToStr(i))))
        }
        let rc = e.ctype(e.c.pg.tb(t))
        let c = e.c.x.callx(e.c.x.par(e.c.x.cast(e.ct(&ct), e.nm("e"))), avs)
        let st = if rc == "void" { e.c.x.sx(c) } else { e.c.x.sret(c) }
        e.define(&n, &rc, ps, pns, [st], -1)
        return
    }
    if (kind == G_DROP || kind == G_ACT || kind == G_REST) && e.tk(t) == sema.TK_BOX {
        if kind == G_DROP {
            let st = e.callS("rt_drun", [e.c.x.arrow(e.c.x.dot(e.nm("v"), "vt"), "drop"), e.c.x.dot(e.nm("v"), "data")])
            e.define(&n, "void", [ct], ["v"], [st], -1)
        } else {
            let vDecl = e.c.x.decl(e.ct(&ct), "v", e.c.x.at(e.ct(&ct), e.nm("p")))
            let st = e.callS("rt_dpush", [e.c.x.arrow(e.c.x.dot(e.nm("v"), "vt"), "drop"), e.c.x.dot(e.nm("v"), "data")])
            e.define(&n, "void", ["void*"], ["p"], [vDecl, st], -1)
        }
        return
    }
    if (kind == G_DROP || kind == G_ACT || kind == G_REST) && e.c.pg.isRc(t) {
        // rc T (design/owned-str.md): one handle fewer; the last drops the value and frees the box
        let vt = e.c.pg.targs(t)[0]
        var body: []int = []
        if kind != G_DROP { append(mut &body, e.c.x.decl(e.ct(&ct), "v", e.nm("p"))) }
        let nf = e.c.x.arrow(e.nm("v"), "f_n")
        append(mut &body, e.c.x.sx(e.c.x.asg(nf, e.c.x.bin("-", nf, e.c.x.lit(1)))))
        append(mut &body, e.c.x.sif(e.c.x.bin("==", nf, e.c.x.lit(0))))
        if !e.pod(vt) { append(mut &body, e.c.x.sx(e.dropC(vt, e.c.x.arrow(e.nm("v"), "f_v")))) }
        append(mut &body, e.callS("rt_free", [e.nm("v")]))
        append(mut &body, e.c.x.send())
        if kind == G_DROP {
            e.define(&n, "void", [ct], ["v"], body, -1)
        } else {
            e.define(&n, "void", ["void*"], ["p"], body, -1)
        }
        return
    }
    if kind == G_DROP || kind == G_ACT || kind == G_REST {
        let inst = e.tk(t) == sema.TK_INST
        let boxed = inst && !e.c.pg.types[e.c.pg.ta(t)].value
        var body: []int = []
        if !e.listed(t) {
            if kind != G_DROP {
                let v = if boxed { e.nm("p") } else { e.c.x.at(e.ct(&ct), e.nm("p")) }
                append(mut &body, e.c.x.decl(e.ct(&ct), "v", v))
            }
            let ds = e.direct(t)
            for x in ds { append(mut &body, x) }
        } else if kind == G_DROP {
            let g = e.glueFn(G_ACT, t)
            body = [e.callS("rt_drun", [e.nm(&g), if boxed { e.nm("v") } else { e.c.x.pre("&", e.nm("v")) }])]
        } else if kind == G_ACT && inst && e.c.pg.types[e.c.pg.ta(t)].drop >= 0 {
            // The drop method runs first; the fields are dropped by a second action, pushed
            // before the call, so that what the method defers (ddrop) is dropped before them.
            let g = e.glueFn(G_REST, t)
            append(mut &body, e.callS("rt_dpush", [e.nm(&g), e.nm("p")]))
            if boxed { append(mut &body, e.c.x.decl(e.ct(&ct), "v", e.nm("p"))) }
            let ta = e.c.pg.targs(t)
            let tu = e.c.pg.mkFn(&ta, sema.T_VOID)
            let f = e.instance(e.c.pg.types[e.c.pg.ta(t)].drop, tu)
            let a = if boxed { e.c.x.pre("&", e.nm("v")) } else { e.c.x.pcast(e.c.x.ptr(e.ct(&ct)), e.nm("p")) }
            append(mut &body, e.callS(&f, [a]))
        } else {
            body = e.rest(t)
        }
        if kind == G_DROP {
            e.define(&n, "void", [ct], ["v"], body, -1)
        } else {
            if kind == G_ACT { body = e.selfLoop(&n, body, e.noUserDrop(t)) }
            e.define(&n, "void", ["void*"], ["p"], body, -1)
        }
        return
    }
    if kind == G_CLONE {
        let body = e.cloneBody(t, &ct)
        e.define(&n, &ct, [ct.clone()], ["v"], body, -1)
        return
    }
    let d = e.c.pg.ta(t)
    let env = e.c.pg.declEnv(t)
    var body: []int = []
    if d == e.c.pg.shared {
        append(mut &body, e.callS("rt_sh_dup", [e.c.x.dot(e.nm("v"), "f_p")]))
    } else if e.c.pg.types[d].form == sx.F_RECORD {
        for i in 0..len(e.c.pg.types[d].fields) {
            let f = e.c.pg.types[d].fields[i].clone()
            let ft = e.c.pg.subst(f.ty, &env)
            if e.pod(ft) { continue }
            let loc = e.c.x.dot(e.nm("v"), &("f_" + f.name))
            append(mut &body, e.dupField(ft, loc))
        }
    } else {
        let vs = copyInts(&e.c.pg.types[d].variants)
        var active: [][]int = []
        var cidx: []int = []
        for v in vs {
            var ls: []int = []
            for i in 0..len(e.c.pg.variants[v].fields) {
                let fd = e.c.pg.variants[v].fields[i].clone()
                let ft = e.c.pg.subst(fd.ty, &env)
                if e.pod(ft) { continue }
                let vv = e.c.x.dot(e.c.x.dot(e.nm("v"), "u"), &("V_" + e.c.pg.variants[v].name))
                let loc = e.c.x.dot(vv, &("f_" + fd.name))
                append(mut &ls, e.dupField(ft, loc))
            }
            if len(ls) > 0 {
                append(mut &active, ls)
                append(mut &cidx, e.c.pg.variants[v].index)
            }
        }
        if len(cidx) == 1 {
            append(mut &body, e.c.x.sif(e.c.x.bin("==", e.tagX(t, e.nm("v"), "."), e.c.x.lit(cidx[0]))))
            for x in active[0] { append(mut &body, x) }
            append(mut &body, e.c.x.send())
        } else if len(cidx) >= 2 {
            append(mut &body, e.c.x.sswitch(e.tagX(t, e.nm("v"), ".")))
            for i in 0..len(cidx) {
                append(mut &body, e.c.x.scase(e.c.x.lit(cidx[i])))
                for x in active[i] { append(mut &body, x) }
                append(mut &body, e.c.x.sbreak())
            }
            append(mut &body, e.c.x.send())
        }
    }
    append(mut &body, e.c.x.sret(e.nm("v")))
    e.define(&n, &ct, [ct.clone()], ["v"], body, -1)
}

// ---- holes

fn (e: mut &Emitter) strlit(b: &str, glob: bool): int {
    if !e.strs.has(b) {
        e.strs.put(b.clone(), "sl" + intToStr(len(e.strKeys)))
        append(mut &e.strKeys, b.clone())
    }
    let n = e.strs.getOr(b, "")
    if !glob { return e.nm(&n) }
    // a literal: static bytes, cap 0 (never freed; a copy shares them; design/owned-str.md)
    let p = e.c.x.cast(e.c.x.ptr(e.ct("char")), e.nm(&(n + "b")))
    return e.c.x.init([p, e.c.x.lit(len(b)), e.c.x.lit(0)])      // {p, len, cap}
}

// Fills the holes of the template node n (res[k]: what hole k stands for), in the order of
// the C text (env: the instance's type arguments; name: the instance).
fn (e: mut &Emitter) fill(n: int, holes: &[]ck.Hole, env: &[]int, name: &str, res: mut &[]int) {
    if n < 0 { return }
    let k = e.c.x.nodes[n].k
    if k == tm.X_HOLE {
        let v = e.c.x.nodes[n].v
        if res[v] < 0 { res[v] = e.hole(v, holes, env, name, res) }
        return
    }
    let a = e.c.x.nodes[n].a
    let b = e.c.x.nodes[n].b
    let c = e.c.x.nodes[n].c
    let l = e.c.x.nodes[n].l
    e.fill(a, holes, env, name, res)
    e.fill(b, holes, env, name, res)
    e.fill(c, holes, env, name, res)
    if l >= 0 {
        for j in 0..e.c.x.items[l] { e.fill(e.c.x.items[l + 1 + j], holes, env, name, res) }
    }
    if k == tm.Z_FOR1 { e.fill(e.c.x.nodes[n].v, holes, env, name, res) }
}

fn (e: mut &Emitter) hole(i: int, holes: &[]ck.Hole, env: &[]int, name: &str, res: mut &[]int): int {
    let h = &holes[i]
    let k = h.k
    if k == ck.H_T {
        let s = e.ctype(e.c.pg.subst(h.t, env))
        return e.ct(&s)
    }
    if k == ck.H_DROP {
        let t = e.c.pg.subst(h.t, env)
        e.fill(h.x, holes, env, name, res)
        return e.dropC(t, h.x)
    }
    if k == ck.H_DDROP {        // a drop when a drop method returns: onto the worklist (SPEC 9.4)
        let t = e.c.pg.subst(h.t, env)
        e.fill(h.x, holes, env, name, res)
        if e.pod(t) || e.quiet(t) { return e.dropC(t, h.x) }
        var p = e.push(t, h.x)      // what reads the place's memory is pushed with a heap copy of it
        if p.refs {
            let g = e.glueFn(G_ACT, t)
            return e.call("rt_ddefer", [e.nm(&g), e.c.x.pre("&", h.x), e.c.x.szof(h.x)])
        }
        return e.c.x.seq(replace(mut &p.ls, []))
    }
    if k == ck.H_DUP {
        let t = e.c.pg.subst(h.t, env)
        e.fill(h.x, holes, env, name, res)
        return e.dupC(t, h.x)
    }
    if k == ck.H_CLONE {
        let t = e.c.pg.subst(h.t, env)
        e.fill(h.x, holes, env, name, res)
        return e.cloneC(t, h.x)
    }
    if k == ck.H_DERIVE {
        let t = e.c.pg.subst(h.t, env)
        let g = e.glueFn(deriveKind(&h.s), t)
        return e.nm(&g)
    }
    if k == ck.H_TAGIS {
        let t = e.c.pg.subst(h.t, env)
        e.fill(h.x, holes, env, name, res)
        let nv = e.c.pg.niche(t)
        if nv < 0 { return e.c.x.bin(if h.r == 1 { "==" } else { "!=" }, e.c.x.member(h.x, &h.s, "tag"), e.c.x.lit(h.f)) }
        let f = e.c.pg.variants[nv].fields[0].name.clone()
        let p = e.c.x.dot(e.c.x.dot(e.c.x.member(h.x, &h.s, "u"), &("V_" + e.c.pg.variants[nv].name)), &("f_" + f))
        let some = e.c.pg.variants[nv].index == h.f
        return if some == (h.r == 1) { e.c.x.pre("!", e.c.x.pre("!", p)) } else { e.c.x.pre("!", p) }
    }
    if k == ck.H_VINIT {
        let t = e.c.pg.subst(h.t, env)
        for a in h.args { e.fill(a, holes, env, name, res) }
        let vr = h.f
        let nv = e.c.pg.niche(t)
        let u = "V_" + e.c.pg.variants[if nv >= 0 { nv } else { vr }].name
        if nv < 0 {
            let tag = e.c.x.desig(".tag", e.c.x.lit(e.c.pg.variants[vr].index))
            return e.c.x.init([tag, e.c.x.desig(&("." + "u." + u), e.c.x.init(&h.args))])
        }
        if vr == nv { return e.c.x.init([e.c.x.desig(&(".u." + u), e.c.x.init(&h.args))]) }
        let fd = e.c.pg.variants[nv].fields[0].clone()
        let fenv = e.c.pg.declEnv(t)
        let ft = e.c.pg.subst(fd.ty, &fenv)
        let cty = e.ctype(ft)
        let z = e.c.x.desig(&(".f_" + fd.name), e.c.x.cast(e.ct(&cty), e.c.x.lit(0)))
        return e.c.x.init([e.c.x.desig(&(".u." + u), e.c.x.init(&[z]))])
    }
    if k == ck.H_STR || k == ck.H_GSTR { return e.strlit(h.s, k == ck.H_GSTR) }
    if k == ck.H_ADDR || k == ck.H_DEREF || k == ck.H_SHARE {
        let t = e.c.pg.subst(h.t, env)
        e.fill(h.x, holes, env, name, res)
        let byVal = e.c.pg.isRefByVal(t)
        if k == ck.H_ADDR { return if byVal { e.c.x.par(h.x) } else { e.c.x.par(e.c.x.pre("&", h.x)) } }
        if k == ck.H_DEREF { return if byVal { e.c.x.par(h.x) } else { e.c.x.par(e.c.x.pre("*", h.x)) } }
        return if byVal { e.c.x.par(e.c.x.pre("*", h.x)) } else { e.c.x.par(h.x) }
    }
    if k == ck.H_FN {
        let f = e.instance(h.f, e.c.pg.subst(h.t, env))
        return e.nm(&f)
    }
    if k == ck.H_CL { return e.nm(&(name + "_c" + intToStr(h.f))) }
    if k == ck.H_TRAMP {
        let g = e.glueFn(G_TRAMP, e.c.pg.subst(h.t, env))
        return e.nm(&g)
    }
    if k == ck.H_BOX {
        let t0 = e.c.pg.subst(h.t, env)
        let iface = e.c.pg.subst(h.r, env)
        e.fill(h.x, holes, env, name, res)
        let bf = e.boxFnFor(t0, iface)
        return e.call(&bf, [h.x])
    }
    if k == ck.H_DYNSPILL {
        let t0 = e.c.pg.subst(h.t, env)
        e.fill(h.x, holes, env, name, res)
        if e.c.pg.isRefByVal(t0) { return h.x }
        let k0 = e.tk(t0)
        let isStruct = k0 == sema.TK_ARR || k0 == sema.TK_SLICE || k0 == sema.TK_CLO || k0 == sema.TK_BOX ||
            e.c.pg.isDynRef(t0) || (k0 == sema.TK_INST && e.c.pg.types[e.c.pg.ta(t0)].value)
        if isStruct { return e.c.x.init([]) }
        return e.c.x.lit(0)
    }
    if k == ck.H_DYNREF {
        let t0 = e.c.pg.subst(h.t, env)
        let iface = e.c.pg.subst(h.r, env)
        e.fill(h.x, holes, env, name, res)
        let vt = e.vtableFor(t0, iface)
        let dn = e.dynIface(iface)
        let dataPtr = if h.f == 1 && e.c.pg.isRefByVal(t0) { e.c.x.pre("&", e.nm(&h.s)) } else { h.x }
        return e.c.x.par(e.c.x.clit(e.ct(&("D" + dn)), e.c.x.init([
            e.c.x.cast(e.ct("void*"), dataPtr),
            e.c.x.pcast(e.c.x.ptr(e.ct(&("V" + dn))), e.c.x.pre("&", e.nm(&vt)))
        ])))
    }
    if k == ck.H_BOXCLO {
        var args: []int = []
        for a in h.args {
            e.fill(a, holes, env, name, res)
            append(mut &args, a)
        }
        return e.call(&("mkc_" + name + "_c" + intToStr(h.f)), args)
    }
    if k == ck.H_BOXFN {
        let fnTy = e.c.pg.subst(h.t, env)
        e.fill(h.x, holes, env, name, res)
        let dn = e.dynFn(fnTy)
        let vt = e.fnBoxVtFor(fnTy)
        return e.c.x.par(e.c.x.clit(e.ct(&("DF" + dn)), e.c.x.init([
            e.c.x.cast(e.ct("void*"), h.x),
            e.c.x.pcast(e.c.x.ptr(e.ct(&("VF" + dn))), e.c.x.pre("&", e.nm(&vt)))
        ])))
    }
    let t = e.c.pg.subst(h.t, env)
    if k == ck.H_IMETH && (e.c.pg.isBoxIface(t) || e.c.pg.isDynRef(t)) {
        let iface = e.c.pg.ta(t)
        let idx = e.c.pg.ifaceMemberIdx(iface, &h.s)
        e.fill(h.r, holes, env, name, res)
        var args: []int = [e.c.x.arrow(e.c.x.par(h.r), "data")]
        for a in h.args {
            e.fill(a, holes, env, name, res)
            append(mut &args, a)
        }
        return e.c.x.callx(e.c.x.arrow(e.c.x.arrow(e.c.x.par(h.r), "vt"), &("m_" + intToStr(idx))), args)
    }
    if k == ck.H_IMETH && e.c.pg.tk(t) == sema.TK_REF && !e.c.pg.tm(t) {
        // T is a shared borrow &U (sema.satisfies): U's method on the borrowed value. The receiver
        // and the &Self arguments are pointers to the borrow: one dereference gives the &U.
        let u = e.c.pg.ta(t)
        e.fill(h.r, holes, env, name, res)
        let rv = e.c.x.par(e.c.x.pre("*", h.r))
        if h.s == "clone" { return rv }         // a copy of the borrow
        var bargs: []int = []
        for a in h.args {
            e.fill(a, holes, env, name, res)
            append(mut &bargs, e.c.x.par(e.c.x.pre("*", a)))
        }
        let f = e.c.pg.methodOf(u, h.s)
        if f < 0 {
            let g = e.glueFn(deriveKind(&h.s), u)
            var gargs: []int = [rv]
            for a in bargs { append(mut &gargs, a) }
            return e.call(&g, gargs)
        }
        var bind: []int = []
        e.c.pg.unify(e.c.pg.fns[f].recvType, u, mut &bind, &e.c.pg.fns[f].tps)
        var ta: []int = []
        for tp in e.c.pg.fns[f].tps { append(mut &ta, envGet(&bind, tp)) }
        let fname = e.instance(f, e.c.pg.mkFn(&ta, sema.T_VOID))
        let recv = if e.c.pg.fns[f].recvMode == sema.RM_VAL {
            e.dupC(u, if e.c.pg.isRefByVal(u) { rv } else { e.c.x.par(e.c.x.pre("*", rv)) })
        } else { rv }
        var args: []int = [recv]
        for a in bargs { append(mut &args, a) }
        return e.call(&fname, args)
    }
    if k == ck.H_IMETH && h.s == "clone" && e.c.pg.methodOf(t, "clone") < 0 && e.c.pg.cloneable(t) {
        // design/owned-str.md: the built-in clone (sema.builtinClone)
        e.fill(h.r, holes, env, name, res)
        if h.f == sema.RM_VAL { return h.r }
        return e.cloneC(t, if e.c.pg.isRefByVal(t) { e.c.x.par(h.r) } else { e.c.x.par(e.c.x.pre("*", h.r)) })
    }
    if k == ck.H_IMETH && (h.s == "eq" || h.s == "hash" || h.s == "toStr" || h.s == "toData") && e.c.pg.methodOf(t, h.s) < 0 &&
            e.c.pg.derivable(t, h.s) {
        // a derived method (design/consistency.md, finding 4): its glue, given pointers (&Self)
        e.fill(h.r, holes, env, name, res)
        for a in h.args { e.fill(a, holes, env, name, res) }
        let g = e.glueFn(deriveKind(&h.s), t)
        var gargs: []int = [h.r]
        for a in h.args { append(mut &gargs, a) }
        return e.c.x.call(&g, gargs)
    }
    if k == ck.H_IASSOC && h.s == "fromData" && e.c.pg.methodOf(t, h.s) < 0 && e.c.pg.derivable(t, h.s) {
        let g = e.glueFn(G_FROMDATA, t)
        return e.nm(&g)
    }
    let f = e.c.pg.methodOf(t, h.s)
    var bind: []int = []
    if f < 0 || !e.c.pg.unify(e.c.pg.fns[f].recvType, t, mut &bind, &e.c.pg.fns[f].tps) {
        sx.failText("internal error: " + e.c.pg.tstr(t) + " has no method " + h.s)
    }
    var ta: []int = []
    for tp in e.c.pg.fns[f].tps { append(mut &ta, envGet(&bind, tp)) }
    let fname = e.instance(f, e.c.pg.mkFn(&ta, sema.T_VOID))
    if k == ck.H_IASSOC { return e.nm(&fname) }
    e.fill(h.r, holes, env, name, res)
    var recv = h.r
    if h.f == sema.RM_REF && e.c.pg.fns[f].recvMode == sema.RM_VAL {
        recv = e.dupC(t, if e.c.pg.isRefByVal(t) { e.c.x.par(h.r) } else { e.c.x.par(e.c.x.pre("*", h.r)) })
    }
    var args: []int = [recv]
    for a in h.args {
        e.fill(a, holes, env, name, res)
        append(mut &args, a)
    }
    return e.call(&fname, args)
}

fn envGet(env: &[]int, tp: int): int {
    var i = 0
    while i < len(env) {
        if env[i] == tp { return env[i + 1] }
        i += 2
    }
    return -1
}

fn newRes(n: int): []int {
    var r: []int = []
    for i in 0..n { append(mut &r, -1) }
    return r
}

// ---- instances

fn cident(s: &str): str {
    var b = ""
    for i in 0..len(s) {
        let x = strByte(s, i)
        let w = (x >= 'a' && x <= 'z') || (x >= 'A' && x <= 'Z') || (x >= '0' && x <= '9') || x == '_' || x >= 128
        b.addByte(if w { x } else { '_' })
    }
    return b
}

fn (e: mut &Emitter) instance(f: int, targs: int): str {
    let key = intToStr(f) + "," + intToStr(targs)
    if !e.insts.has(&key) {
        let label = e.c.pg.label(f)
        let m = e.c.pg.fns[f].mod
        let line = e.c.pg.fns[f].line
        for i in 0..e.c.pg.tn(targs) {
            let a = e.c.pg.ti(targs, i)
            if e.c.pg.depth(a) > MAX_DEPTH {
                e.fail(m, line, "instantiation of " + label + " does not terminate: its type arguments grow without " +
                    "bound (" + prefix(&(e.c.pg.tstr(a)), 80) + "...)")
            }
        }
        if e.ninsts > MAX_INSTANCES {
            e.fail(m, line, "too many instances (instantiation of " + label + " does not terminate)")
        }
        e.insts.put(key.clone(), "f" + intToStr(e.ninsts) + "_" + e.c.pg.mods[m].cprefix + "_" + cident(&label))
        e.ninsts += 1
        append(mut &e.work, Inst{f: f, targs: targs})
    }
    return e.insts.getOr(&key, "")
}

fn (e: mut &Emitter) makeInstance(f: int, targs: int) {
    let key = intToStr(f) + "," + intToStr(targs)
    let name = e.insts.getOr(&key, "")
    var env: []int = []
    for i in 0..len(e.c.pg.fns[f].tps) {
        append(mut &env, e.c.pg.fns[f].tps[i])
        append(mut &env, e.c.pg.ti(targs, i))
    }
    var ps: []str = []
    var pns: []str = []
    for i in 0..len(e.c.pg.fns[f].params) {
        let p = e.c.pg.fns[f].params[i].clone()
        append(mut &ps, e.ctype(e.c.pg.subst(p.ty, &env)))
        append(mut &pns, "p_" + p.name)
    }
    let rc = e.ctype(e.c.pg.subst(e.c.pg.fns[f].ret, &env))
    let fm = e.c.pg.fns[f].mod
    let label = e.c.pg.label(f)
    let file = e.c.pg.mods[fm].fname.clone()
    e.fsrc.put(name.clone(), label + " (" + file + ":" + intToStr(e.c.pg.fns[f].line) + ")")
    if e.c.pg.fns[f].ret == sema.T_NEVER { e.stops.put(name.clone(), true) }
    var mask = ""
    for i in 0..len(e.c.pg.fns[f].params) { mask = mask + (if e.c.pg.fns[f].params[i].ty == sema.T_STR { "1" } else { "0" }) }
    e.pstr.put(name.clone(), mask)
    e.fpath.put(name.clone(), e.c.pg.mods[fm].path + ":" + intToStr(e.c.pg.fns[f].line))
    if e.c.pg.mods[fm].isLib && e.c.pg.mods[fm].name == "par" {
        let fnm = &e.c.pg.fns[f].name
        if fnm == "map" { e.parMaps.put(name.clone(), true) }
        if fnm == "item" || fnm == "callAt" { e.parBounds.put(name.clone(), true) }
    }
    let tm = replace(mut &e.c.tmpls[f], ck.Tmpl{done: false, lines: [], holes: [], lifted: []})
    var res = newRes(len(tm.holes))
    for l in tm.lines { e.fill(l, &tm.holes, &env, &name, mut &res) }
    let ri = len(e.ress)
    e.define(&name, &rc, ps, pns, copyInts(&tm.lines), ri)
    for l in tm.lifted {        // its closures
        var cps: []str = ["void*"]
        var cns: []str = ["cv_"]
        var subPtys: []int = []
        for j in 0..len(l.pnames) {
            let spt = e.c.pg.subst(l.ptys[j], &env)
            append(mut &subPtys, spt)
            append(mut &cps, e.ctype(spt))
            append(mut &cns, l.pnames[j].clone())
        }
        let subRet = e.c.pg.subst(l.ret, &env)
        let lrc = e.ctype(subRet)
        for x in l.lines { e.fill(x, &tm.holes, &env, &name, mut &res) }
        let lname = name + "_c" + intToStr(l.k)
        if l.escaping {
            let fnTy = e.c.pg.mkFn(&subPtys, subRet)
            let dn = e.dynFn(fnTy)
            var subCaps: []int = []
            var capCts: []str = []
            for ct0 in l.capTys {
                let sct = e.c.pg.subst(ct0, &env)
                append(mut &subCaps, sct)
                append(mut &capCts, e.ctype(sct))
            }
            var lines: []int = []
            var dropFn = ""
            let vtName = "cvt_" + lname
            let mkName = "mkc_" + lname
            if len(subCaps) == 0 {
                append(mut &lines, e.c.x.sx(e.c.x.cast(e.ct("void"), e.nm("cv_"))))
                for x in l.lines { append(mut &lines, x) }
                dropFn = e.ensureNoopDrop()
                let ret = e.c.x.sret(e.c.x.clit(e.ct(&("DF" + dn)), e.c.x.init([
                    e.c.x.cast(e.ct("void*"), e.c.x.lit(0)),
                    e.c.x.pcast(e.c.x.ptr(e.ct(&("VF" + dn))), e.c.x.pre("&", e.nm(&vtName)))
                ])))
                e.define(&mkName, &("DF" + dn), [], [], [ret], -1)
            } else {
                let envName = "CE_" + lname
                append(mut &e.envStructs, EnvStruct{name: envName.clone(), fieldTys: capCts.clone()})
                let envPtr = e.c.x.ptr(e.ct(&envName))
                append(mut &lines, e.c.x.decl(envPtr, "ce_", e.nm("cv_")))
                append(mut &lines, e.c.x.sx(e.c.x.cast(e.ct("void"), e.nm("ce_"))))
                for x in l.lines { append(mut &lines, x) }
                // Drop action for the heap environment struct.
                dropFn = "ced_" + lname
                var dbody: []int = [e.c.x.decl(e.c.x.ptr(e.ct(&envName)), "ce", e.nm("p"))]
                var dops: []int = []
                var anyRefs = false
                var ci = len(subCaps) - 1
                while ci >= 0 {
                    let fty = subCaps[ci]
                    if !e.pod(fty) {
                        let loc = e.c.x.arrow(e.nm("ce"), &("c" + intToStr(ci)))
                        if e.quiet(fty) {
                            append(mut &dops, e.c.x.sx(e.dropC(fty, loc)))
                        } else {
                            let pl = e.push(fty, loc)
                            if pl.refs { anyRefs = true }
                            for s in pl.ls { append(mut &dops, s) }
                        }
                    }
                    ci -= 1
                }
                if anyRefs {
                    append(mut &dbody, e.callS("rt_dpush", [e.nm("rt_free_act"), e.nm("p")]))
                    for s in dops { append(mut &dbody, s) }
                } else {
                    for s in dops { append(mut &dbody, s) }
                    append(mut &dbody, e.callS("rt_free", [e.nm("p")]))
                }
                e.define(&dropFn, "void", ["void*"], ["p"], dbody, -1)
                // Constructor: DF<dn> mkc_<lname>(C(T0) c0, ...)
                var mkPns: []str = []
                var mkBody: []int = [e.c.x.decl(e.c.x.ptr(e.ct(&envName)), "ce",
                    e.call("rt_alloc", [e.c.x.szof(e.c.x.pre("*", e.nm("ce")))]))]
                for ci2 in 0..len(subCaps) {
                    let fnm = "c" + intToStr(ci2)
                    append(mut &mkPns, fnm.clone())
                    append(mut &mkBody, e.c.x.sx(e.c.x.asg(e.c.x.arrow(e.nm("ce"), &fnm), e.nm(&fnm))))
                }
                append(mut &mkBody, e.c.x.sret(e.c.x.clit(e.ct(&("DF" + dn)), e.c.x.init([
                    e.c.x.cast(e.ct("void*"), e.nm("ce")),
                    e.c.x.pcast(e.c.x.ptr(e.ct(&("VF" + dn))), e.c.x.pre("&", e.nm(&vtName)))
                ]))))
                e.define(&mkName, &("DF" + dn), capCts, mkPns, mkBody, -1)
            }
            append(mut &e.vtGlobs, GDef{name: vtName, ty: "VF" + dn, n: -1,
                init: e.c.x.init([e.nm(&dropFn), e.nm(&lname)]), isConst: true, res: []})
            e.define(&lname, &lrc, cps, cns, lines, ri)
            e.fsrc.put(lname, "the closure in " + label + " (" + file + ":" + intToStr(l.line) + ")")
        } else {
            // void** ce_ = cv_; (void)ce_;
            var lines: []int = [e.c.x.decl(e.ct("void**"), "ce_", e.nm("cv_")), e.c.x.sx(e.c.x.cast(e.ct("void"), e.nm("ce_")))]
            for x in l.lines { append(mut &lines, x) }
            e.define(&lname, &lrc, cps, cns, lines, ri)
            e.fsrc.put(lname, "the closure in " + label + " (" + file + ":" + intToStr(l.line) + ")")
        }
    }
    append(mut &e.ress, res)
    e.c.tmpls[f] = tm
}

fn (e: mut &Emitter) externC(t: int): str {
    let k = e.c.pg.tk(t)
    if k == sema.TK_SLICE || (k == sema.TK_REF && e.c.pg.tk(e.c.pg.ta(t)) == sema.TK_ARR) { return "void*" }
    return if t == sema.T_STR { "const char*" } else { e.ctype(t) }
}

// ---- the program

// The IR of the program whose entry is the function main (and the libraries its externs
// name, in libs).
pub fn (e: mut &Emitter) program(main: int, libs: mut &[]str): ir.Ir {
    var externs: []Extern = []
    var seen: Map[str, bool] = newMapWith[str, bool](fxHashStr)
    var blocking: Map[str, bool] = newMapWith[str, bool](fxHashStr)
    for f in 0..len(e.c.pg.fns) {
        if e.c.pg.fns[f].isExtern && e.c.pg.fns[f].blocking { blocking.put(e.c.pg.fns[f].cname.clone(), true) }
        if e.c.pg.fns[f].isExtern && e.c.pg.fns[f].pure { e.kexterns.put(e.c.pg.fns[f].cname.clone(), true) }
    }
    for m in 0..len(e.c.pg.mods) {
        let fs = copyInts(&e.c.pg.mods[m].fns)
        for f in fs {
            let cn = e.c.pg.fns[f].cname.clone()
            if e.c.pg.fns[f].isExtern && cn != "" && !seen.has(&cn) {
                seen.put(cn.clone(), true)
                var ps: []str = []
                for i in 0..len(e.c.pg.fns[f].params) { append(mut &ps, e.externC(e.c.pg.fns[f].params[i].ty)) }
                let rc = e.externC(e.c.pg.fns[f].ret)
                append(mut &externs, Extern{name: cn, ret: rc, ptys: ps, va: e.c.pg.fns[f].varargs, blocking: blocking.has(&cn)})
                let lib = &e.c.pg.fns[f].lib
                var known = lib == "c" || lib == ""
                for l in libs {
                    if l == lib { known = true }
                }
                if !known { append(libs, lib.clone()) }
            }
        }
    }
    let entry = e.instance(main, e.c.pg.mkFn(&[], sema.T_VOID))
    // SPEC 5.2: at exit a module's set-once globals are dropped before those of the modules it
    // imports, each module's in reverse declaration order; a dropped one is marked (state 2) first.
    // Copy globals are dropped after them all (that runs no code), so no drop method sees them freed.
    var globs: []GDef = []
    var copies: []int = []
    var post: []int = []
    var visited: []bool = []
    for m in 0..len(e.c.pg.mods) { append(mut &visited, false) }
    e.visit(e.c.pg.std, mut &visited, mut &post)
    for m in 0..len(e.c.pg.mods) { e.visit(m, mut &visited, mut &post) }
    var onces: [][]int = []
    for m in 0..len(e.c.pg.mods) { append(mut &onces, []) }
    for m in post {
        var names: []str = []
        for n in e.c.pg.mods[m].scopeNames { append(mut &names, n.clone()) }
        for n in names {
            let s = e.c.pg.mods[m].scope.getOr(&n, sema.Sym{k: -1, i: -1})
            let isG = s.k == sema.D_GLOBAL
            if !isG && s.k != sema.D_CONST { continue }
            let gi = if isG { replace(mut &e.c.ginits[s.i], noInit()) } else { replace(mut &e.c.cinits[s.i], noInit()) }
            if !gi.has { continue }
            let t = if isG { e.c.pg.globals[s.i].ty } else { e.c.pg.consts[s.i].table }
            let cn = if isG { e.c.pg.globals[s.i].cname.clone() } else { e.c.pg.consts[s.i].cname.clone() }
            e.gsrc.put(cn.clone(), e.c.pg.mods[m].name + "." + n)
            if isG && e.c.pg.mods[m].isLib && e.c.pg.mods[m].name == "hash" &&
                (n == "sipKeyed" || n == "sipK0" || n == "sipK1" || n == "mapSeed") {
                e.kglobals.put(cn.clone(), true)        // par.map derives the key before its workers run (hash.keyReady)
            }
            if isG && !gi.isOnce {      // G.with's open flag (design/consistency.md, finding 3)
                append(mut &globs, GDef{name: cn + "_open", ty: "uint8_t", n: -1, init: -1, isConst: false, res: []})
            }
            if gi.rt {                  // initialized on first use: 0 not yet, 1 set, 2 initializing, 3 dropped
                let ct = e.ctype(t)
                append(mut &globs, GDef{name: cn.clone(), ty: ct, n: -1, init: -1, isConst: false, res: []})
                append(mut &globs, GDef{name: cn + "_st", ty: "uint8_t", n: -1, init: -1, isConst: false, res: []})
                e.globalAccessor(s.i, t, &cn, m, &n)
                let st = e.nm(&(cn + "_st"))
                var l: []int = []
                if !e.pod(t) {
                    append(mut &l, e.c.x.sif(e.c.x.bin("==", st, e.c.x.lit(1))))
                    append(mut &l, e.c.x.sx(e.c.x.asg(st, e.c.x.lit(3))))
                    append(mut &l, e.c.x.sx(e.dropC(t, e.nm(&cn))))
                    append(mut &l, e.c.x.send())
                }
                append(mut &l, e.c.x.sx(e.c.x.asg(st, e.c.x.lit(3))))
                for x in onces[m] { append(mut &l, x) }
                onces[m] = l
                continue
            }
            if gi.isOnce {          // a set-once global: 0 empty, 1 set, 2 dropped
                let ct = e.ctype(t)
                append(mut &globs, GDef{name: cn.clone(), ty: ct, n: -1, init: -1, isConst: false, res: []})
                append(mut &globs, GDef{name: cn + "_set", ty: "uint8_t", n: -1, init: -1, isConst: false, res: []})
                let set = e.nm(&(cn + "_set"))
                let mark = e.c.x.sx(e.c.x.asg(set, e.c.x.lit(2)))
                var l: []int = []
                if !e.pod(t) {
                    append(mut &l, e.c.x.sif(e.c.x.bin("==", set, e.c.x.lit(1))))
                    append(mut &l, mark)
                    append(mut &l, e.c.x.sx(e.dropC(t, e.nm(&cn))))
                    append(mut &l, e.c.x.send())
                }
                append(mut &l, mark)
                for x in onces[m] { append(mut &l, x) }
                onces[m] = l
            } else if e.tk(t) == sema.TK_ARR {      // a constant table: read-only static data seen as a slice
                var res = newRes(len(gi.holes))
                for x in gi.items { e.fill(x, &gi.holes, &[], &"", mut &res) }
                let ct = e.ctype(e.c.pg.ta(t))
                let nn = if len(gi.items) == 0 { 1 } else { len(gi.items) }
                let its = if len(gi.items) == 0 { e.c.x.init([e.c.x.lit(0)]) } else { e.c.x.init(copyInts(&gi.items)) }
                append(mut &globs, GDef{name: cn + "_d", ty: ct, n: nn, init: its, isConst: true, res: res})
                let sl = e.c.x.init([e.c.x.cast(e.ct("void*"), e.nm(&(cn + "_d"))), e.c.x.lit(len(gi.items))])
                append(mut &globs, GDef{name: cn.clone(), ty: "lxl_slice", n: -1, init: sl, isConst: true, res: []})
            } else {
                let ct = e.ctype(t)
                var res = newRes(len(gi.holes))
                e.fill(gi.c, &gi.holes, &[], &"", mut &res)
                append(mut &globs, GDef{name: cn.clone(), ty: ct, n: -1, init: gi.c, isConst: !isG, res: res})
                if !e.pod(t) {
                    var l: []int = [e.c.x.sx(e.dropC(t, e.nm(&cn)))]
                    for x in copies { append(mut &l, x) }
                    copies = l
                }
            }
        }
    }
    var gdrops: []int = []
    var pi = len(post) - 1
    while pi >= 0 {
        for x in onces[post[pi]] { append(mut &gdrops, x) }
        pi -= 1
    }
    for x in copies { append(mut &gdrops, x) }
    while len(e.work) > 0 || len(e.gluework) > 0 {
        if len(e.work) > 0 {
            let w = pop(mut &e.work)
            e.makeInstance(w.f, w.targs)
        } else {
            let g = pop(mut &e.gluework)
            e.makeGlue(g.kind, g.t)
        }
    }
    var i = 0
    while i < len(e.structs) {          // field types may name more types (including box I)
        e.nameFields(e.structs[i])
        i += 1
    }
    e.c.pg.checkHandleCycles()          // design/consistency.md, finding 1: every instance is known now
    return e.lower(&entry, &externs, &globs, &gdrops)
}

// The IR of it all, declared in the order of the C text: structs, function types, string
// literals, externs, globals, functions, main.
fn (e: mut &Emitter) lower(entry: &str, externs: &[]Extern, globs: &[]GDef, gdrops: &[]int): ir.Ir {
    var u = lw.newLower()
    u.ir.fsrc = replace(mut &e.fsrc, newMapWith[str, str](fxHashStr))
    u.ir.gsrc = replace(mut &e.gsrc, newMapWith[str, str](fxHashStr))
    u.ir.parMaps = replace(mut &e.parMaps, newMapWith[str, bool](fxHashStr))
    u.ir.parBounds = replace(mut &e.parBounds, newMapWith[str, bool](fxHashStr))
    u.ir.kglobals = replace(mut &e.kglobals, newMapWith[str, bool](fxHashStr))
    u.ir.kexterns = replace(mut &e.kexterns, newMapWith[str, bool](fxHashStr))
    u.ir.stops = replace(mut &e.stops, newMapWith[str, bool](fxHashStr))
    u.ir.pstr = replace(mut &e.pstr, newMapWith[str, str](fxHashStr))
    u.ir.fpath = replace(mut &e.fpath, newMapWith[str, str](fxHashStr))
    let structs = copyInts(&e.structs)
    for t in structs { u.newStruct(&(e.names.getOr(&t, "")), false) }
    let dynIfs = copyInts(&e.dynIfaces)
    for iface in dynIfs {
        let dn = e.dynIfaceNames.getOr(&iface, "")
        u.newStruct(&("V" + dn), false)
        u.newStruct(&("D" + dn), false)
    }
    let dynFns = copyInts(&e.dynFns)
    for fnTy in dynFns {
        let dn = e.dynFnNames.getOr(&fnTy, "")
        u.newStruct(&("VF" + dn), false)
        u.newStruct(&("DF" + dn), false)
    }
    for es in e.envStructs {
        u.newStruct(&es.name, false)
    }
    for ft in e.fntypes {
        var pts: []int = []
        for p in ft.ptys { append(mut &pts, u.ctName(p.clone())) }
        let r = u.ctName(ft.ret.clone())
        u.typedef(&ft.name, u.ir.ptrTo(u.ir.fnType(r, &pts)))
    }
    for iface in dynIfs {
        let dn = e.dynIfaceNames.getOr(&iface, "")
        let vTy = u.ctName("V" + dn)
        let dTy = u.ctName("D" + dn)
        let vp = u.ctName("void*")
        var vfs: []ir.Field = [ir.Field{name: "drop", ty: u.ir.ptrTo(u.ir.fnType(ir.TY_VOID, &[vp])), off: 0}]
        let d = e.c.pg.ta(iface)
        let ienv = e.c.pg.declEnv(iface)
        for j in 0..len(e.c.pg.types[d].members) {
            let mb = e.c.pg.types[d].members[j].clone()
            var mps: []int = [vp]
            for p in mb.params {
                let pc = e.ctype(e.c.pg.subst(p, &ienv))
                append(mut &mps, u.ctName(pc))
            }
            let rc = e.ctype(e.c.pg.subst(mb.ret, &ienv))
            let rIr = u.ctName(rc)
            append(mut &vfs, ir.Field{name: "m_" + intToStr(j), ty: u.ir.ptrTo(u.ir.fnType(rIr, &mps)), off: 0})
        }
        u.layout(vTy, vfs)
        u.layout(dTy, [ir.Field{name: "data", ty: vp, off: 0}, ir.Field{name: "vt", ty: u.ir.ptrTo(vTy), off: 0}])
    }
    for fnTy in dynFns {
        let dn = e.dynFnNames.getOr(&fnTy, "")
        let vTy = u.ctName("VF" + dn)
        let dTy = u.ctName("DF" + dn)
        let vp = u.ctName("void*")
        var mps: []int = [vp]
        for i in 0..e.c.pg.tn(fnTy) {
            let pc = e.ctype(e.c.pg.ti(fnTy, i))
            append(mut &mps, u.ctName(pc))
        }
        let rc = e.ctype(e.c.pg.tb(fnTy))
        let rIr = u.ctName(rc)
        let vfs: []ir.Field = [
            ir.Field{name: "drop", ty: u.ir.ptrTo(u.ir.fnType(ir.TY_VOID, &[vp])), off: 0},
            ir.Field{name: "call", ty: u.ir.ptrTo(u.ir.fnType(rIr, &mps)), off: 0}
        ]
        u.layout(vTy, vfs)
        u.layout(dTy, [ir.Field{name: "data", ty: vp, off: 0}, ir.Field{name: "vt", ty: u.ir.ptrTo(vTy), off: 0}])
    }
    var order: []int = []
    var done: Map[int, bool] = newMap()
    for t in structs { e.visitStruct(t, mut &done, mut &order) }
    for t in order { e.layout(mut &u, t) }
    for es in e.envStructs {
        let eTy = u.ctName(es.name.clone())
        var efs: []ir.Field = []
        for k in 0..len(es.fieldTys) {
            append(mut &efs, ir.Field{name: "c" + intToStr(k), ty: u.ctName(es.fieldTys[k].clone()), off: 0})
        }
        u.layout(eTy, efs)
    }
    u.x = replace(mut &e.c.x, tm.newArena())
    for b in e.strKeys {
        let n = e.strs.getOr(&b, "")
        // the bytes and a NUL; the str is {bytes, cap 0, len}: static, never freed (design/owned-str.md)
        u.global(&(n + "b"), u.ir.arrOf(ir.TY_I8, len(b) + 1), u.x.str(&b), false)
        u.ir.kglobals.put(n + "b", true)        // written by nothing
        let p = u.x.cast(u.x.ptr(u.x.ct("char")), u.x.nm(&(n + "b")))
        u.global(&n, u.ctName("lxl_str"), u.x.init([p, u.x.lit(len(b)), u.x.lit(0)]), true)
    }
    for x in externs {
        var pts: []int = []
        for p in x.ptys { append(mut &pts, u.ctName(p.clone())) }
        let r = u.ctName(x.ret.clone())
        let ty = if x.va { u.ir.varFnType(r, &pts) } else { u.ir.fnType(r, &pts) }
        u.declFunc("x_" + x.name, ty, &x.name, true)
        if x.blocking { u.declFunc("bk1_" + x.name, u.ir.fnType(ir.TY_VOID, &[u.ctName("void*")]), "", false) }
    }
    u.declFunc("gx_end", u.ir.fnType(ir.TY_VOID, &[u.ctName("void*")]), "", false)
    for g in globs {
        u.res = copyInts(&g.res)
        var ty = u.ctName(g.ty.clone())
        if g.n >= 0 { ty = u.ir.arrOf(ty, g.n) }
        u.global(&g.name, ty, g.init, g.isConst)
    }
    var ftys: []int = []
    for f in e.fns {
        var pts: []int = []
        for p in f.ptys { append(mut &pts, u.ctName(p.clone())) }
        let r = u.ctName(f.ret.clone())
        let ty = u.ir.fnType(r, &pts)
        u.declFunc(f.name.clone(), ty, "", false)
        append(mut &ftys, ty)
    }
    for vg in e.vtGlobs {
        u.res = []
        u.global(&vg.name, u.ctName(vg.ty.clone()), vg.init, vg.isConst)
    }
    for j in 0..len(e.fns) {
        let ri = e.fns[j].res
        u.res = if ri >= 0 { replace(mut &e.ress[ri], []) } else { [] }
        u.defineFunc(e.fns[j].name.clone(), ftys[j], &e.fns[j].pnames, &e.fns[j].lines)
        if ri >= 0 { e.ress[ri] = replace(mut &u.res, []) }
    }
    // a blocking extern's thunk, run on a helper thread (check.blockingCall):
    // void bk1_x(void* a) { *(R*)((int64_t*)a + n) = x_x(*(P0*)((int64_t*)a + 0), ...); }
    for x in externs {
        if !x.blocking { continue }
        var args: []int = []
        for k in 0..len(x.ptys) { append(mut &args, u.x.at(u.x.ct(&x.ptys[k]), e.thunkSlot(mut &u, k))) }
        let call = u.x.call(&("x_" + x.name), args)
        let st = if x.ret == "void" { call } else { u.x.asg(u.x.at(u.x.ct(&x.ret), e.thunkSlot(mut &u, len(x.ptys))), call) }
        u.res = []
        u.defineFunc("bk1_" + x.name, u.ir.fnType(ir.TY_VOID, &[u.ctName("void*")]), &["a"], &[u.x.sx(st)])
    }
    // The globals' drops at the program's end, a function of their own: a worker of task.workers
    // runs them too at its end (rt_on_end), before its leak check.
    u.res = []
    u.defineFunc("gx_end", u.ir.fnType(ir.TY_VOID, &[u.ctName("void*")]), &["a"], &gdrops)
    // int main(int argc, char** argv) { rt_init(argc, argv); rt_on_end(gx_end); entry(); gx_end(0);
    //                                   rt_finish(); return 0; }
    var ml: []int = [u.x.sx(u.x.call("rt_init", [u.x.nm("argc"), u.x.nm("argv")])),
                     u.x.sx(u.x.call("rt_on_end", [u.x.nm("gx_end")])), u.x.sx(u.x.call(entry, []))]
    append(mut &ml, u.x.sx(u.x.call("gx_end", [u.x.cast(u.x.ptr(u.x.ct("void")), u.x.lit(0))])))
    append(mut &ml, u.x.sx(u.x.call("rt_finish", [])))
    append(mut &ml, u.x.sret(u.x.lit(0)))
    u.res = []
    let mt = u.ir.fnType(ir.TY_I32, &[ir.TY_I32, u.ir.ptrTo(u.ir.ptrTo(ir.TY_I8))])
    u.defineFunc("main", mt, &["argc", "argv"], &ml)
    return replace(mut &u.ir, ir.newIr())
}

// ((int64_t*)a + k): slot k of a thunk's argument a.
fn (e: &Emitter) thunkSlot(u: mut &lw.Lower, k: int): int {
    return u.x.par(u.x.bin("+", u.x.cast(u.x.ptr(u.x.ct("int64_t")), u.x.nm("a")), u.x.lit(k)))
}

fn noInit(): ck.GInit { return ck.GInit{has: false, isOnce: false, table: false, items: [], c: -1, holes: [], rt: false} }

fn (e: &Emitter) visit(m: int, visited: mut &[]bool, post: mut &[]int) {
    if visited[m] { return }
    visited[m] = true
    for sub in e.c.pg.mods[m].importMods { e.visit(sub, visited, post) }
    append(post, m)
}

fn (e: mut &Emitter) visitStruct(t: int, done: mut &Map[int, bool], order: mut &[]int) {
    if done.has(&t) { return }
    done.put(t, true)
    let fts = e.c.pg.fieldTypes(t)
    for ft in fts {
        if e.tk(ft) == sema.TK_INST && e.c.pg.types[e.c.pg.ta(ft)].value && !done.has(&ft) { e.visitStruct(ft, done, order) }
    }
    append(order, t)
}
