// cgen: the C backend (design/native.md, section 1a): prints the IR (ir.lxl) as C for gcc.
//
// The output is the C runtime (rt.h, the prefix) and then the program: its structs (every
// struct gets a tag; the runtime's own types are named by their typedefs), prototypes,
// externs (with their __asm__ symbols), globals and functions. The IR already has every
// conversion explicit; the printer writes C whose rules give the same values (casts where
// C would convert otherwise), so gcc's result behaves like the native backend's.
//
// Expressions are printed with C's precedences, parenthesized only where needed.

import "./ir"
import "./num"
import "strings"

type Gen = record {
    u: ir.Ir
    out: str
    sname: []str            // the C name of each struct type ("struct S" or a typedef name)
    lname: []str            // the C name of each local of the function being printed
    done: []int             // struct definition state: 0 not yet, 1 in progress, 2 printed
    tn: []str               // the C name of each type (an abstract declarator)
}

// The C text of the program p, after the runtime text prefix.
pub fn print(p: ir.Ir, prefix: &str): str {
    var g = Gen{u: p, out: "", sname: [], lname: [], done: [], tn: []}
    g.out += &prefix
    g.program()
    return g.out.toStr()
}

// The libm functions that are the runtime's own (lxl_<name>: rt.h's single instructions, and
// lxlmath.inc, the ported ones: the same text as the native runtime's, so that both backends
// give the same bits).
const MATH_PRIM: []str = ["sqrt", "fabs", "floor", "ceil", "trunc", "rint", "round", "copysign", "fma"]
const MATH_PORT: []str = ["exp", "exp2", "log", "log2", "log10", "log1p", "expm1", "cbrt", "sin", "cos", "tan", "asin", "acos",
    "atan", "sinh", "cosh", "tanh", "pow", "atan2", "hypot", "fmod"]

fn inPrim(s: &str): bool {
    for x in MATH_PRIM {
        if x == s { return true }
    }
    return false
}

fn inPort(s: &str): bool {
    for x in MATH_PORT {
        if x == s { return true }
    }
    return false
}

fn builtinMath(name: &str): bool { return inPrim(name) || inPort(name) }

// Whether the program calls a ported libm function: then rt.RTMATH goes with the C runtime.
pub fn usesMath(p: &ir.Ir): bool {
    for f in p.funcs {
        if f.isExtern && inPort(&f.asmName) { return true }
    }
    return false
}

// Whether the program declares an extern that is neither the runtime's math nor its port
// (jq's acosh, erf, lgamma, j0 ...): gcc then links -lm, as the native backend searches libm.so.6
// for such names. The linker's --as-needed drops it again when nothing in libm is used.
pub fn needsLibm(p: &ir.Ir): bool {
    for f in p.funcs {
        if f.isExtern && !builtinMath(&f.asmName) { return true }
    }
    return false
}

fn (g: mut &Gen) line(s: &str) {
    g.out += &s
    g.out.addByte('\n')
}

fn (g: mut &Gen) program() {
    if g.u.hasAnyVec() { g.vecPrelude() }
    for s in 0..len(g.u.structs) {
        let name = &g.u.structs[s].name
        let kw = if g.u.structs[s].isUnion { "union " } else { "struct " }
        if s < g.u.nRtStructs {
            append(mut &g.sname, name.clone())
        } else if name == "<anonymous>" {
            append(mut &g.sname, kw + "A" + intToStr(s))
        } else {
            append(mut &g.sname, kw + name)
        }
        append(mut &g.done, if s < g.u.nRtStructs { 2 } else { 0 })
    }
    for t in 0..len(g.u.tys) { append(mut &g.tn, g.decl(t, "")) }
    for s in g.u.nRtStructs..len(g.u.structs) { g.line(&(g.sname[s] + ";")) }
    for s in g.u.nRtStructs..len(g.u.structs) { g.structDef(s) }
    for f in g.u.nRtFuncs..len(g.u.funcs) { g.proto(f) }
    for v in g.u.nRtGlobals..len(g.u.globals) { g.global(v) }
    for f in g.u.nRtFuncs..len(g.u.funcs) {
        if g.u.funcs[f].body >= 0 { g.funcDef(f) }
    }
}

// ---------------------------------------------------------------- types

// A struct's definition, after the structs it holds by value.
fn (g: mut &Gen) structDef(s: int) {
    if g.done[s] != 0 { return }
    g.done[s] = 1
    for j in 0..len(g.u.structs[s].fields) { g.needDefs(g.u.structs[s].fields[j].ty) }
    var b = ""
    b += &(g.sname[s] + " {")
    for f in g.u.structs[s].fields { b += &(" " + g.decl(f.ty, &f.name) + ";") }
    b += " };"
    g.line(&(b))
    g.done[s] = 2
}

fn (g: mut &Gen) needDefs(t: int) {
    let k = g.u.tk(t)
    if k == ir.TY_STRUCT {
        g.structDef(g.u.tys[t].sid)
    } else if k == ir.TY_ARR {
        g.needDefs(g.u.tys[t].base)
    }
}

const SCALAR_NAMES: []str = ["void", "bool", "char", "uint8_t", "int16_t", "uint16_t", "int32_t", "uint32_t", "int64_t",
    "uint64_t", "__int128", "unsigned __int128", "double"]

// The C declaration of inner as type t ("" for an abstract declarator).
fn (g: &Gen) decl(t: int, inner: &str): str {
    let ty = &g.u.tys[t]
    let k = ty.k
    if k <= ir.TY_F64 || k == ir.TY_STRUCT || k == ir.TY_VEC {
        let n = if k == ir.TY_STRUCT { g.sname[ty.sid].clone() } else if k == ir.TY_VEC { g.u.typeName(t) } else { SCALAR_NAMES[k].clone() }
        return if inner == "" { n } else if strByte(inner, 0) == '*' { n + inner } else { n + " " + inner }
    }
    if k == ir.TY_PTR {
        let bk = g.u.tk(ty.base)
        let in2 = if bk == ir.TY_FN || bk == ir.TY_ARR { "(*" + inner + ")" } else { "*" + inner }
        return g.decl(ty.base, &in2)
    }
    if k == ir.TY_ARR { return g.decl(ty.base, &(inner + "[" + (if ty.n == 0 { "" } else { intToStr(ty.n) }) + "]")) }
    // a function
    let ps = g.u.fnParams(t)
    var parts: []str = []
    for p in ps { append(mut &parts, g.decl(p, "")) }
    if g.u.isVarFn(t) { append(mut &parts, "...") }
    if len(parts) == 0 { append(mut &parts, "void") }
    return g.decl(ty.base, &(inner + "(" + strings.join(&parts, ", ") + ")"))
}

fn (g: &Gen) tname(t: int): str { return g.tn[t].clone() }

// ---------------------------------------------------------------- declarations

fn (g: mut &Gen) proto(f: int) {
    let name = g.u.funcs[f].name.clone()
    if name == "main" { return }
    let d = g.decl(g.u.funcs[f].ty, &name)
    if g.u.funcs[f].isExtern {
        g.line(&("extern " + d + " __asm__(\"" + g.u.funcs[f].asmName + "\");"))
        return
    }
    g.line(&("static " + d + ";"))
}

fn (g: mut &Gen) global(v: int) { g.line(&(g.globalText(v))) }

fn (g: &Gen) globalText(v: int): str {
    let gl = &g.u.globals[v]
    var s = "static " + (if gl.isConst { "const " } else { "" }) + g.decl(gl.ty, &gl.name)
    if gl.init >= 0 { s = s + " = " + g.initText(gl.ty, gl.init) }
    return s + ";"
}

fn (g: mut &Gen) funcDef(f: int) {
    g.nameLocals(f)
    g.line(&(g.funcHead(f)))
    let body = g.u.funcs[f].body
    for j in 0..g.u.listLen(g.u.nodes[body].a) { g.stmt(g.u.listAt(g.u.nodes[body].a, j), 1) }
    g.line("}")
}

fn (g: &Gen) funcHead(f: int): str {
    let fn0 = &g.u.funcs[f]
    let pts = g.u.fnParams(fn0.ty)
    var parts: []str = []
    for j in 0..len(fn0.params) { append(mut &parts, g.decl(pts[j], &(g.lname[fn0.params[j]]))) }
    if len(parts) == 0 { append(mut &parts, "void") }
    let head = g.decl(g.u.tys[fn0.ty].base, &(fn0.name + "(" + strings.join(&parts, ", ") + ")"))
    return (if fn0.name == "main" { "" } else { "static " }) + head + " {"
}

// The C names of the locals of function f: their own, with the local's number where a name
// is used for more than one.
fn (g: mut &Gen) nameLocals(f: int) {
    while len(g.lname) < len(g.u.locals) { append(mut &g.lname, "") }
    var ls: []int = []
    for p in g.u.funcs[f].params { append(mut &ls, p) }
    g.declsIn(g.u.funcs[f].body, mut &ls)
    var seen: Map[str, int] = newMapWith[str, int](fxHashStr)
    for l in ls {
        let n = g.u.locals[l].name.clone()
        seen.put(n, seen.getOr(&n, 0) + 1)
    }
    for l in ls {
        let n = g.u.locals[l].name.clone()
        g.lname[l] = if seen.getOr(&n, 0) > 1 { n + "_" + intToStr(l) } else { n }
    }
}

fn (g: &Gen) declsIn(x: int, ls: mut &[]int) {
    if x < 0 { return }
    let n = &g.u.nodes[x]
    let k = n.k
    if k == ir.S_DECL {
        append(ls, n.a)
    } else if k == ir.S_BLOCK {
        for j in 0..g.u.listLen(n.a) { g.declsIn(g.u.listAt(n.a, j), ls) }
    } else if k == ir.S_IF {
        g.declsIn(n.b, ls)
        g.declsIn(n.c, ls)
    } else if k == ir.S_WHILE || k == ir.S_SWITCH {
        g.declsIn(n.b, ls)
    } else if k == ir.S_FOR {
        g.declsIn(n.a, ls)
        g.declsIn(n.d, ls)
    }
}

// ---------------------------------------------------------------- initializers

// The initializer of an object of type t from the entries (a list of E_IENT).
fn (g: &Gen) initText(t: int, l: int): str {
    var es: []int = []
    for j in 0..g.u.listLen(l) { append(mut &es, g.u.listAt(l, j)) }
    if len(es) == 0 { return "{0}" }
    return g.initOf(t, 0, &es)
}

// The initializer of the object of type t at offset base from the entries es (all inside it).
fn (g: &Gen) initOf(t: int, base: int, es: &[]int): str {
    if len(es) == 1 && g.u.nodes[es[0]].v == base && g.u.nodes[es[0]].ty == t {
        return g.expr(g.u.nodes[es[0]].a, 2)
    }
    let ty = &g.u.tys[t]
    var parts: []str = []
    if ty.k == ir.TY_STRUCT {
        let st = &g.u.structs[ty.sid]
        var used: []bool = array(len(es), false)
        for f in st.fields {
            let sub = g.within(es, base + f.off, g.u.sizeOf(f.ty))
            if len(sub) == 0 { continue }
            if st.isUnion && !g.fits(f.ty, base + f.off, &sub) { continue }
            if st.isUnion && len(sub) != len(es) { continue }
            append(mut &parts, "." + f.name + " = " + g.initOf(f.ty, base + f.off, &sub))
            if st.isUnion { break }
        }
    } else if ty.k == ir.TY_ARR {
        let es0 = g.u.sizeOf(ty.base)
        let subs = g.elements(es, base, es0, ty.n)
        for j in 0..ty.n {
            if len(subs[j]) > 0 { append(mut &parts, "[" + intToStr(j) + "] = " + g.initOf(ty.base, base + j * es0, &subs[j])) }
        }
    }
    if len(parts) == 0 { ir.failAt("IR node", g.u.nodes[es[0]].line, "cgen: an initializer entry that fits no member") }
    return "{" + strings.join(&parts, ", ") + "}"
}

// The entries of es inside [off, off + size) (an empty member holds the entries at off).
fn (g: &Gen) within(es: &[]int, off: int, size: int): []int {
    var out: []int = []
    for e in es {
        let o = g.u.nodes[e].v
        if o >= off && (o < off + size || (size == 0 && o == off)) { append(mut &out, e) }
    }
    return out
}

// The entries of es in each of the n elements (of size es0) of an array at base.
fn (g: &Gen) elements(es: &[]int, base: int, es0: int, n: int): [][]int {
    var subs: [][]int = []
    for j in 0..n { append(mut &subs, []) }
    if es0 == 0 {
        if n > 0 { subs[0] = g.within(es, base, 0) }
        return subs
    }
    for e in es {
        let j = (g.u.nodes[e].v - base) / es0
        if g.u.nodes[e].v >= base && j < n { append(mut &subs[j], e) }
    }
    return subs
}

// Whether the entries es can all initialize parts of an object of type t at base.
fn (g: &Gen) fits(t: int, base: int, es: &[]int): bool {
    if len(es) == 1 && g.u.nodes[es[0]].v == base && g.u.nodes[es[0]].ty == t { return true }
    let ty = &g.u.tys[t]
    if ty.k == ir.TY_STRUCT {
        let st = &g.u.structs[ty.sid]
        var n = 0
        for f in st.fields {
            let sub = g.within(es, base + f.off, g.u.sizeOf(f.ty))
            if len(sub) > 0 && g.fits(f.ty, base + f.off, &sub) {
                if st.isUnion { return len(sub) == len(es) }
                n += len(sub)
            }
        }
        return n == len(es)
    }
    if ty.k == ir.TY_ARR {
        let es0 = g.u.sizeOf(ty.base)
        let subs = g.elements(es, base, es0, ty.n)
        var n = 0
        for j in 0..ty.n {
            if len(subs[j]) > 0 && g.fits(ty.base, base + j * es0, &subs[j]) { n += len(subs[j]) }
        }
        return n == len(es)
    }
    return false
}

// ---------------------------------------------------------------- statements

// Statements are written straight into the output.
fn (g: mut &Gen) stmt(x: int, d: int) {
    let k = g.u.nodes[x].k
    let a = g.u.nodes[x].a
    let b = g.u.nodes[x].b
    if k == ir.S_BLOCK {
        if g.u.nodes[x].v == 1 {
            for j in 0..g.u.listLen(a) { g.stmt(g.u.listAt(a, j), d) }
            return
        }
        g.start(d, "{\n")
        for j in 0..g.u.listLen(a) { g.stmt(g.u.listAt(a, j), d + 1) }
        g.start(d, "}\n")
    } else if k == ir.S_IF {
        g.head(d, "if (", a, b)
        var el = g.u.nodes[x].c
        while el >= 0 {
            if g.u.nk(el) == ir.S_IF {
                g.head(d, "} else if (", g.u.nodes[el].a, g.u.nodes[el].b)
                el = g.u.nodes[el].c
            } else {
                g.start(d, "} else {\n")
                g.body(el, d)
                el = -1
            }
        }
        g.start(d, "}\n")
    } else if k == ir.S_WHILE || k == ir.S_SWITCH {
        g.head(d, if k == ir.S_WHILE { "while (" } else { "switch (" }, a, b)
        g.start(d, "}\n")
    } else if k == ir.S_FOR {
        g.start(d, "for (")
        if a < 0 { g.out.addByte(';') } else { g.simple(a) }
        if b >= 0 {
            g.out.addByte(' ')
            g.ex(b, 0)
        }
        g.out.addByte(';')
        let c = g.u.nodes[x].c
        if c >= 0 {
            g.out.addByte(' ')
            g.ex(c, 0)
        }
        g.out += ") {\n"
        g.body(g.u.nodes[x].d, d)
        g.start(d, "}\n")
    } else if k == ir.S_CASE {
        g.start(d, &("case " + g.intLit(ir.TY_I64, g.u.nodes[x].v) + ":;\n"))
    } else if k == ir.S_DEFAULT {
        g.start(d, "default:;\n")
    } else {
        g.start(d, "")
        g.simple(x)
        g.out.addByte('\n')
    }
}

// The indentation of depth d, then s.
fn (g: mut &Gen) start(d: int, s: &str) {
    for i in 0..d { g.out += "  " }
    g.out += &s
}

// kw (c) { body
fn (g: mut &Gen) head(d: int, kw: &str, c: int, body: int) {
    g.start(d, kw)
    g.ex(c, 0)
    g.out += ") {\n"
    g.body(body, d)
}

// The expression x, into the output.
fn (g: mut &Gen) ex(x: int, need: int) {
    var b = replace(mut &g.out, "")
    g.put(x, need, mut &b)
    g.out = b
}

// The statements of a body (a block's, without its braces), one level in.
fn (g: mut &Gen) body(b: int, d: int) {
    if g.u.nk(b) == ir.S_BLOCK && g.u.nodes[b].v == 0 {
        let l = g.u.nodes[b].a
        for j in 0..g.u.listLen(l) { g.stmt(g.u.listAt(l, j), d + 1) }
        return
    }
    g.stmt(b, d + 1)
}

// A statement on one line: a declaration, expression, break, continue, return or empty.
fn (g: mut &Gen) simple(x: int) {
    let k = g.u.nodes[x].k
    let a = g.u.nodes[x].a
    if k == ir.S_DECL {
        let t = g.u.locals[a].ty
        g.out += &(g.decl(t, &g.lname[a]))
        let b = g.u.nodes[x].b
        let c = g.u.nodes[x].c
        if b >= 0 {
            g.out += " = "
            g.ex(b, 2)
        }
        if c >= 0 { g.out += &(" = " + g.initText(t, c)) }
        g.out.addByte(';')
    } else if k == ir.S_EXPR || k == ir.S_RETURN {
        if k == ir.S_RETURN { g.out += if a < 0 { "return" } else { "return " } }
        if a >= 0 { g.ex(a, 0) }
        g.out.addByte(';')
    } else if k == ir.S_BREAK || k == ir.S_CONTINUE || k == ir.S_EMPTY {
        g.out += if k == ir.S_BREAK { "break;" } else if k == ir.S_CONTINUE { "continue;" } else { ";" }
    } else if k == ir.S_BLOCK && g.u.nodes[x].v == 1 {
        for j in 0..g.u.listLen(a) {
            if j > 0 { g.out.addByte(' ') }
            g.simple(g.u.listAt(a, j))
        }
    } else {
        ir.failAt("IR node", g.u.nodes[x].line, "cgen: statement kind " + intToStr(k))
    }
}

// ---------------------------------------------------------------- expressions

// C's precedence levels.
const P_ASSIGN = 2
const P_COND = 3
const P_UNARY = 14
const P_POST = 15

const OP_TEXT: []str = ["+", "-", "*", "/", "%", "<<", ">>", "&", "|", "^", "==", "!=", "<", "<=", ">", ">="]
const OP_PREC: []int = [12, 12, 13, 13, 13, 11, 11, 8, 6, 7, 9, 9, 10, 10, 10, 10]

fn paren(s: &str, p: int, need: int): str { return if p < need { "(" + s + ")" } else { s.clone() } }

fn open(p: int, need: int, b: mut &str) {
    if p < need { b.addByte('(') }
}

fn close(p: int, need: int, b: mut &str) {
    if p < need { b.addByte(')') }
}

// The C text of expression x, parenthesized when its precedence is below need.
fn (g: &Gen) expr(x: int, need: int): str {
    var b = ""
    g.put(x, need, mut &b)
    return b
}

fn (g: &Gen) put(x: int, need: int, b: mut &str) {
    let n = &g.u.nodes[x]
    let k = n.k
    if k == ir.E_INT {
        let s = g.intLit(n.ty, n.v)
        b += &(paren(&s, if strByte(s, 0) == '-' || strByte(s, 0) == '(' { P_UNARY } else { P_POST }, need))
    } else if k == ir.E_FLT {
        b += &(paren(&(fltLit(g.u.flts[n.v])), P_UNARY, need))
    } else if k == ir.E_STR {
        b += &(strLit(&g.u.strs[n.v]))
    } else if k == ir.E_LOCAL {
        b += &g.lname[n.a]
    } else if k == ir.E_GLOBAL {
        b += &g.u.globals[n.a].name
    } else if k == ir.E_FUNC {
        b += &g.u.funcs[n.a].name
    } else if k == ir.E_CALL {
        let c = &g.u.nodes[n.a]
        if c.k == ir.E_DECAY && g.u.nk(c.a) == ir.E_FUNC {
            let cf = &g.u.funcs[g.u.nodes[c.a].a]
            if cf.isExtern && builtinMath(&cf.asmName) {
                // the runtime's own (gcc would not know an extern by its C name: it has another label)
                b += &("lxl_" + cf.asmName)
            } else {
                b += &cf.name
            }
        } else {
            g.put(n.a, P_POST, b)
        }
        b.addByte('(')
        for j in 0..g.u.listLen(n.b) {
            if j > 0 { b += ", " }
            g.put(g.u.listAt(n.b, j), P_ASSIGN, b)
        }
        b.addByte(')')
    } else if k == ir.E_MEMBER {
        let a = &g.u.nodes[n.a]
        let f = g.fieldAt(a.ty, n.v, n.ty)
        open(P_POST, need, b)
        if a.k == ir.E_DEREF {
            g.put(a.a, P_POST, b)
            b += "->"
        } else {
            g.put(n.a, P_POST, b)
            b.addByte('.')
        }
        b += &f
        close(P_POST, need, b)
    } else if k == ir.E_BNOT && g.u.isVec(n.ty) {
        b += &("lxl_" + vecSufC(&g.u, n.ty) + "_bnot(")
        g.put(n.a, P_ASSIGN, b)
        b.addByte(')')
    } else if k == ir.E_DEREF || k == ir.E_BNOT || k == ir.E_LNOT || (k == ir.E_ADDR && g.u.nk(n.a) != ir.E_DEREF) {
        open(P_UNARY, need, b)
        b += if k == ir.E_DEREF { "*" } else if k == ir.E_BNOT { "~" } else if k == ir.E_LNOT { "!" } else { "&" }
        g.put(n.a, P_UNARY, b)
        close(P_UNARY, need, b)
    } else if k == ir.E_ADDR {
        g.put(g.u.nodes[n.a].a, need, b)
    } else if k == ir.E_DECAY || (k == ir.E_CAST && n.ty == g.u.nodes[n.a].ty) {
        g.put(n.a, need, b)
    } else if k == ir.E_CAST {
        open(P_UNARY, need, b)
        b += &("(" + g.tn[n.ty] + ")")
        g.put(n.a, P_UNARY, b)
        close(P_UNARY, need, b)
    } else if k == ir.E_BIN && g.u.isVec(n.c) {
        g.putVecBin(x, b)
    } else if k == ir.E_BIN {
        let p = OP_PREC[n.v]
        g.infix(n.a, &(" " + OP_TEXT[n.v] + " "), n.b, p, p, p + 1, need, b)
    } else if k == ir.E_NEG && g.u.isVec(n.ty) {
        b += "lxl_vf64_neg("
        g.put(n.a, P_ASSIGN, b)
        b.addByte(')')
    } else if k == ir.E_NEG {
        let s = g.expr(n.a, P_UNARY)
        b += &(paren(&("-" + (if strByte(s, 0) == '-' { "(" + s + ")" } else { s })), P_UNARY, need))
    } else if k == ir.E_LAND {
        g.infix(n.a, " && ", n.b, 5, 5, 6, need, b)
    } else if k == ir.E_LOR {
        g.infix(n.a, " || ", n.b, 4, 4, 5, need, b)
    } else if k == ir.E_COND {
        open(P_COND, need, b)
        g.put(n.a, 4, b)
        b += " ? "
        g.put(n.b, 0, b)
        b += " : "
        g.put(n.c, P_COND, b)
        close(P_COND, need, b)
    } else if k == ir.E_ASSIGN {
        g.infix(n.a, " = ", n.b, P_ASSIGN, P_UNARY, P_ASSIGN, need, b)
    } else if k == ir.E_POSTINC {
        open(P_POST, need, b)
        g.put(n.a, P_POST, b)
        b += if n.v > 0 { "++" } else { "--" }
        close(P_POST, need, b)
    } else if k == ir.E_CLIT {
        b += &(paren(&("(" + g.tn[n.ty] + ")" + g.initText(n.ty, n.b)), P_POST, need))
    } else if k == ir.E_PADD {
        let pt = g.u.tys[n.ty].base
        let es = if g.u.sizeOf(pt) == 0 { 1 } else { g.u.sizeOf(pt) }
        if es == n.v {
            g.infix(n.a, " + ", n.b, 12, 12, 13, need, b)
        } else {
            open(P_UNARY, need, b)
            b += &("(" + g.tn[n.ty] + ")((char*)")
            g.put(n.a, P_UNARY, b)
            b += " + "
            g.put(n.b, 13, b)
            b += &(" * " + intToStr(n.v) + ")")
            close(P_UNARY, need, b)
        }
    } else if k == ir.E_VECOP {
        g.putVecOp(x, b)
    } else {
        ir.failAt("IR node", n.line, "cgen: expression kind " + intToStr(k))
    }
}

// a op c at precedence p (operands at pa and pc).
fn (g: &Gen) infix(a: int, op: &str, c: int, p: int, pa: int, pc: int, need: int, b: mut &str) {
    open(p, need, b)
    g.put(a, pa, b)
    b += &op
    g.put(c, pc, b)
    close(p, need, b)
}

// The name of the field of struct type t at offset off with type ft.
fn (g: &Gen) fieldAt(t: int, off: int, ft: int): str {
    let st = &g.u.structs[g.u.tys[t].sid]
    for f in st.fields {
        if f.off == off && f.ty == ft { return f.name.clone() }
    }
    for f in st.fields {
        if f.off == off { return f.name.clone() }
    }
    ir.failAt("IR struct", 0, "cgen: no field at " + intToStr(off) + " in " + st.name)
}

// An integer constant of type t: its C literal (with a cast when no suffix gives the type).
fn (g: &Gen) intLit(t: int, v: int): str {
    let k = g.u.tk(t)
    if k == ir.TY_I32 && v >= -2147483647 && v <= 2147483647 { return intToStr(v) }
    if k == ir.TY_I64 || k == ir.TY_I128 {
        let s = if v == -9223372036854775807 - 1 { "(-9223372036854775807LL - 1)" } else { intToStr(v) + "LL" }
        return if k == ir.TY_I64 { s } else { "(" + g.tname(t) + ")" + s }
    }
    let u = if v >= 0 { intToStr(v) } else { "0x" + hex32((v >> 32) & 4294967295) + hex32(v & 4294967295) }
    if k == ir.TY_U64 { return u + "ULL" }
    if k == ir.TY_U32 && v >= 0 && v <= 4294967295 { return u + "U" }
    return "(" + g.tname(t) + ")" + (if v < 0 && !ir.isSignedK(k) { u + "ULL" } else { intToStr(v) + "LL" })
}

fn hex32(v: int): str {
    let s = strings.hex(v)
    return strings.repeat("0", 8 - len(s)) + s
}

fn fltLit(f: float): str {
    if f != f { return "__builtin_nan(\"\")" }
    let s = num.pyFloatRepr(f)
    if s == "inf" { return "__builtin_inf()" }
    if s == "-inf" { return "-__builtin_inf()" }
    return s
}

// A C string literal of the bytes s (octal escapes for all but printable ASCII).
fn strLit(s: &str): str {
    var b = ""
    b.addByte('"')
    for i in 0..len(s) {
        let c = strByte(s, i)
        if c == '"' || c == '\\' {
            b.addByte('\\')
            b.addByte(c)
        } else if c >= ' ' && c < 127 && c != '?' {
            b.addByte(c)
        } else {
            b.addByte('\\')
            b.addByte('0' + (c >> 6))
            b.addByte('0' + ((c >> 3) & 7))
            b.addByte('0' + (c & 7))
        }
    }
    b.addByte('"')
    return b
}

// ---------------------------------------------------------------- SIMD vector C helpers

fn vecSufC(u: &ir.Ir, t: int): str {
    let b = u.tys[t].base
    if b == ir.TY_F64 { return "vf64" }
    if b == ir.TY_I64 { return "vi64" }
    if b == ir.TY_I32 { return "vi32" }
    return "vu8"
}

fn (g: &Gen) putVecBin(x: int, b: mut &str) {
    let n = &g.u.nodes[x]
    let suf = vecSufC(&g.u, n.c)
    let op = match n.v {
        ir.OP_ADD { "add" }
        ir.OP_SUB { "sub" }
        ir.OP_MUL { "mul" }
        ir.OP_DIV { "div" }
        ir.OP_AND { "and" }
        ir.OP_OR { "or" }
        ir.OP_XOR { "xor" }
        ir.OP_EQ { "eq" }
        ir.OP_NE { "ne" }
        ir.OP_LT { "lt" }
        ir.OP_LE { "le" }
        ir.OP_GT { "gt" }
        ir.OP_GE { "ge" }
        else { "" }
    }
    b += &("lxl_" + suf + "_" + op + "(")
    g.put(n.a, P_ASSIGN, b)
    b += ", "
    g.put(n.b, P_ASSIGN, b)
    b.addByte(')')
}

fn (g: &Gen) putVecOp(x: int, b: mut &str) {
    let n = &g.u.nodes[x]
    let v = n.v
    if v == ir.V_CTZ || v == ir.V_CLZ || v == ir.V_POPCNT {
        let is64 = g.u.tk(g.u.nty(n.a)) == ir.TY_U64
        let nm = if v == ir.V_CTZ { "lxl_bit_ctz" } else if v == ir.V_CLZ { "lxl_bit_clz" } else { "lxl_bit_popcnt" }
        b += &(nm + (if is64 { "64(" } else { "32(" }))
        g.put(n.a, P_ASSIGN, b)
        b.addByte(')')
        return
    }
    let vt = if v == ir.V_STORE { g.u.nty(n.b) }
        else if v == ir.V_STORE_PARTIAL { g.u.nty(n.c) }
        else if v == ir.V_BITMASK || v == ir.V_SUM || v == ir.V_RMIN || v == ir.V_RMAX || v == ir.V_LANE { g.u.nty(n.a) }
        else { n.ty }
    let suf = vecSufC(&g.u, vt)
    let op = match v {
        ir.V_ZERO { "zero" }
        ir.V_SPLAT { "splat" }
        ir.V_LOAD { "load" }
        ir.V_STORE { "store" }
        ir.V_LOAD_PARTIAL { "loadp" }
        ir.V_STORE_PARTIAL { "storep" }
        ir.V_FMADD { "fma" }
        ir.V_SQRT { "sqrt" }
        ir.V_ABS { "abs" }
        ir.V_MIN { "min" }
        ir.V_MAX { "max" }
        ir.V_SELECT { "select" }
        ir.V_BITMASK { "bitmask" }
        ir.V_SUM { "sum" }
        ir.V_RMIN { "rmin" }
        ir.V_RMAX { "rmax" }
        ir.V_SHUFFLE { "shuffle" }
        ir.V_LANE { "lane" }
        ir.V_SHL { "shl" }
        ir.V_SHR { "shr" }
        else { "" }
    }
    b += &("lxl_" + suf + "_" + op + "(")
    if n.a >= 0 { g.put(n.a, P_ASSIGN, b) }
    if n.b >= 0 {
        b += ", "
        g.put(n.b, P_ASSIGN, b)
    }
    if n.c >= 0 {
        b += ", "
        g.put(n.c, P_ASSIGN, b)
    }
    b.addByte(')')
}

fn (g: mut &Gen) vecPrelude() {
    g.line("#include <immintrin.h>")
    g.line("typedef __m256d lxl_vf64;")
    g.line("typedef __m256i lxl_vi64;")
    g.line("typedef __m256i lxl_vi32;")
    g.line("typedef __m256i lxl_vu8;")
    g.line("static inline int64_t lxl_bit_ctz64(uint64_t x) { return x ? (int64_t)__builtin_ctzll(x) : 64LL; }")
    g.line("static inline int64_t lxl_bit_clz64(uint64_t x) { return x ? (int64_t)__builtin_clzll(x) : 64LL; }")
    g.line("static inline int64_t lxl_bit_popcnt64(uint64_t x) { return (int64_t)__builtin_popcountll(x); }")
    g.line("static inline int64_t lxl_bit_ctz32(uint32_t x) { return x ? (int64_t)__builtin_ctz(x) : 32LL; }")
    g.line("static inline int64_t lxl_bit_clz32(uint32_t x) { return x ? (int64_t)__builtin_clz(x) : 32LL; }")
    g.line("static inline int64_t lxl_bit_popcnt32(uint32_t x) { return (int64_t)__builtin_popcount(x); }")
    g.line("static inline __m256i lxl_v_ones(void) { __m256i z = _mm256_setzero_si256(); return _mm256_cmpeq_epi32(z, z); }")
    // f64x4
    g.line("static inline lxl_vf64 lxl_vf64_zero(void) { return _mm256_setzero_pd(); }")
    g.line("static inline lxl_vf64 lxl_vf64_splat(double x) { return _mm256_set1_pd(x); }")
    g.line("static inline lxl_vf64 lxl_vf64_load(const double* p) { return _mm256_loadu_pd(p); }")
    g.line("static inline void lxl_vf64_store(double* p, lxl_vf64 v) { _mm256_storeu_pd(p, v); }")
    g.line("static inline lxl_vf64 lxl_vf64_add(lxl_vf64 a, lxl_vf64 b) { return _mm256_add_pd(a, b); }")
    g.line("static inline lxl_vf64 lxl_vf64_sub(lxl_vf64 a, lxl_vf64 b) { return _mm256_sub_pd(a, b); }")
    g.line("static inline lxl_vf64 lxl_vf64_mul(lxl_vf64 a, lxl_vf64 b) { return _mm256_mul_pd(a, b); }")
    g.line("static inline lxl_vf64 lxl_vf64_div(lxl_vf64 a, lxl_vf64 b) { return _mm256_div_pd(a, b); }")
    g.line("static inline lxl_vf64 lxl_vf64_neg(lxl_vf64 a) { return _mm256_xor_pd(a, _mm256_set1_pd(-0.0)); }")
    g.line("static inline lxl_vf64 lxl_vf64_abs(lxl_vf64 a) { return _mm256_andnot_pd(_mm256_set1_pd(-0.0), a); }")
    g.line("static inline lxl_vf64 lxl_vf64_sqrt(lxl_vf64 a) { return _mm256_sqrt_pd(a); }")
    g.line("static inline lxl_vf64 lxl_vf64_fma(lxl_vf64 a, lxl_vf64 b, lxl_vf64 c) { return _mm256_fmadd_pd(a, b, c); }")
    g.line("static inline lxl_vf64 lxl_vf64_min(lxl_vf64 a, lxl_vf64 b) { return _mm256_min_pd(a, b); }")
    g.line("static inline lxl_vf64 lxl_vf64_max(lxl_vf64 a, lxl_vf64 b) { return _mm256_max_pd(a, b); }")
    g.line("static inline lxl_vi64 lxl_vf64_eq(lxl_vf64 a, lxl_vf64 b) { return _mm256_castpd_si256(_mm256_cmp_pd(a, b, 0)); }")
    g.line("static inline lxl_vi64 lxl_vf64_ne(lxl_vf64 a, lxl_vf64 b) { return _mm256_castpd_si256(_mm256_cmp_pd(a, b, 4)); }")
    g.line("static inline lxl_vi64 lxl_vf64_lt(lxl_vf64 a, lxl_vf64 b) { return _mm256_castpd_si256(_mm256_cmp_pd(a, b, 1)); }")
    g.line("static inline lxl_vi64 lxl_vf64_le(lxl_vf64 a, lxl_vf64 b) { return _mm256_castpd_si256(_mm256_cmp_pd(a, b, 2)); }")
    g.line("static inline lxl_vi64 lxl_vf64_gt(lxl_vf64 a, lxl_vf64 b) { return _mm256_castpd_si256(_mm256_cmp_pd(b, a, 1)); }")
    g.line("static inline lxl_vi64 lxl_vf64_ge(lxl_vf64 a, lxl_vf64 b) { return _mm256_castpd_si256(_mm256_cmp_pd(b, a, 2)); }")
    g.line("static inline lxl_vf64 lxl_vf64_select(lxl_vi64 m, lxl_vf64 a, lxl_vf64 b) { return _mm256_blendv_pd(b, a, _mm256_castsi256_pd(m)); }")
    g.line("static inline uint64_t lxl_vf64_bitmask(lxl_vf64 v) { return (uint64_t)(unsigned)_mm256_movemask_pd(v); }")
    g.line("static inline double lxl_vf64_sum(lxl_vf64 v) { __m128d s = _mm_add_pd(_mm256_castpd256_pd128(v), _mm256_extractf128_pd(v, 1)); return _mm_cvtsd_f64(_mm_add_sd(s, _mm_unpackhi_pd(s, s))); }")
    g.line("static inline double lxl_vf64_rmin(lxl_vf64 v) { __m128d s = _mm_min_pd(_mm256_castpd256_pd128(v), _mm256_extractf128_pd(v, 1)); return _mm_cvtsd_f64(_mm_min_sd(s, _mm_unpackhi_pd(s, s))); }")
    g.line("static inline double lxl_vf64_rmax(lxl_vf64 v) { __m128d s = _mm_max_pd(_mm256_castpd256_pd128(v), _mm256_extractf128_pd(v, 1)); return _mm_cvtsd_f64(_mm_max_sd(s, _mm_unpackhi_pd(s, s))); }")
    g.line("static inline double lxl_vf64_lane(lxl_vf64 v, int64_t k) { double a[4]; _mm256_storeu_pd(a, v); return a[k]; }")
    // i64x4
    g.line("static inline lxl_vi64 lxl_vi64_zero(void) { return _mm256_setzero_si256(); }")
    g.line("static inline lxl_vi64 lxl_vi64_splat(int64_t x) { return _mm256_set1_epi64x(x); }")
    g.line("static inline lxl_vi64 lxl_vi64_load(const int64_t* p) { return _mm256_loadu_si256((const __m256i*)p); }")
    g.line("static inline void lxl_vi64_store(int64_t* p, lxl_vi64 v) { _mm256_storeu_si256((__m256i*)p, v); }")
    g.line("static inline lxl_vi64 lxl_vi64_add(lxl_vi64 a, lxl_vi64 b) { return _mm256_add_epi64(a, b); }")
    g.line("static inline lxl_vi64 lxl_vi64_sub(lxl_vi64 a, lxl_vi64 b) { return _mm256_sub_epi64(a, b); }")
    g.line("static inline lxl_vi64 lxl_vi64_and(lxl_vi64 a, lxl_vi64 b) { return _mm256_and_si256(a, b); }")
    g.line("static inline lxl_vi64 lxl_vi64_or(lxl_vi64 a, lxl_vi64 b) { return _mm256_or_si256(a, b); }")
    g.line("static inline lxl_vi64 lxl_vi64_xor(lxl_vi64 a, lxl_vi64 b) { return _mm256_xor_si256(a, b); }")
    g.line("static inline lxl_vi64 lxl_vi64_bnot(lxl_vi64 a) { return _mm256_xor_si256(a, lxl_v_ones()); }")
    g.line("static inline lxl_vi64 lxl_vi64_shl(lxl_vi64 a, int64_t k) { return _mm256_sll_epi64(a, _mm_cvtsi64_si128(k)); }")
    g.line("static inline lxl_vi64 lxl_vi64_shr(lxl_vi64 a, int64_t k) { __m256i s = _mm256_cmpgt_epi64(_mm256_setzero_si256(), a); return _mm256_xor_si256(_mm256_srl_epi64(_mm256_xor_si256(a, s), _mm_cvtsi64_si128(k)), s); }")
    g.line("static inline lxl_vi64 lxl_vi64_eq(lxl_vi64 a, lxl_vi64 b) { return _mm256_cmpeq_epi64(a, b); }")
    g.line("static inline lxl_vi64 lxl_vi64_ne(lxl_vi64 a, lxl_vi64 b) { return _mm256_xor_si256(_mm256_cmpeq_epi64(a, b), lxl_v_ones()); }")
    g.line("static inline lxl_vi64 lxl_vi64_gt(lxl_vi64 a, lxl_vi64 b) { return _mm256_cmpgt_epi64(a, b); }")
    g.line("static inline lxl_vi64 lxl_vi64_lt(lxl_vi64 a, lxl_vi64 b) { return _mm256_cmpgt_epi64(b, a); }")
    g.line("static inline lxl_vi64 lxl_vi64_le(lxl_vi64 a, lxl_vi64 b) { return _mm256_xor_si256(_mm256_cmpgt_epi64(a, b), lxl_v_ones()); }")
    g.line("static inline lxl_vi64 lxl_vi64_ge(lxl_vi64 a, lxl_vi64 b) { return _mm256_xor_si256(_mm256_cmpgt_epi64(b, a), lxl_v_ones()); }")
    g.line("static inline lxl_vi64 lxl_vi64_select(lxl_vi64 m, lxl_vi64 a, lxl_vi64 b) { return _mm256_castpd_si256(_mm256_blendv_pd(_mm256_castsi256_pd(b), _mm256_castsi256_pd(a), _mm256_castsi256_pd(m))); }")
    g.line("static inline lxl_vi64 lxl_vi64_min(lxl_vi64 a, lxl_vi64 b) { return lxl_vi64_select(_mm256_cmpgt_epi64(a, b), b, a); }")
    g.line("static inline lxl_vi64 lxl_vi64_max(lxl_vi64 a, lxl_vi64 b) { return lxl_vi64_select(_mm256_cmpgt_epi64(a, b), a, b); }")
    g.line("static inline uint64_t lxl_vi64_bitmask(lxl_vi64 v) { return (uint64_t)(unsigned)_mm256_movemask_pd(_mm256_castsi256_pd(v)); }")
    g.line("static inline int64_t lxl_vi64_sum(lxl_vi64 v) { __m128i s = _mm_add_epi64(_mm256_castsi256_si128(v), _mm256_extracti128_si256(v, 1)); return _mm_cvtsi128_si64(_mm_add_epi64(s, _mm_shuffle_epi32(s, 0x4E))); }")
    g.line("static inline int64_t lxl_vi64_rmin(lxl_vi64 v) { int64_t a[4]; _mm256_storeu_si256((__m256i*)a, v); int64_t m = a[0]; for (int i = 1; i < 4; i++) if (a[i] < m) m = a[i]; return m; }")
    g.line("static inline int64_t lxl_vi64_rmax(lxl_vi64 v) { int64_t a[4]; _mm256_storeu_si256((__m256i*)a, v); int64_t m = a[0]; for (int i = 1; i < 4; i++) if (a[i] > m) m = a[i]; return m; }")
    g.line("static inline int64_t lxl_vi64_lane(lxl_vi64 v, int64_t k) { int64_t a[4]; _mm256_storeu_si256((__m256i*)a, v); return a[k]; }")
    // i32x8
    g.line("static inline lxl_vi32 lxl_vi32_zero(void) { return _mm256_setzero_si256(); }")
    g.line("static inline lxl_vi32 lxl_vi32_splat(int32_t x) { return _mm256_set1_epi32(x); }")
    g.line("static inline lxl_vi32 lxl_vi32_load(const int32_t* p) { return _mm256_loadu_si256((const __m256i*)p); }")
    g.line("static inline void lxl_vi32_store(int32_t* p, lxl_vi32 v) { _mm256_storeu_si256((__m256i*)p, v); }")
    g.line("static inline lxl_vi32 lxl_vi32_add(lxl_vi32 a, lxl_vi32 b) { return _mm256_add_epi32(a, b); }")
    g.line("static inline lxl_vi32 lxl_vi32_sub(lxl_vi32 a, lxl_vi32 b) { return _mm256_sub_epi32(a, b); }")
    g.line("static inline lxl_vi32 lxl_vi32_mul(lxl_vi32 a, lxl_vi32 b) { return _mm256_mullo_epi32(a, b); }")
    g.line("static inline lxl_vi32 lxl_vi32_and(lxl_vi32 a, lxl_vi32 b) { return _mm256_and_si256(a, b); }")
    g.line("static inline lxl_vi32 lxl_vi32_or(lxl_vi32 a, lxl_vi32 b) { return _mm256_or_si256(a, b); }")
    g.line("static inline lxl_vi32 lxl_vi32_xor(lxl_vi32 a, lxl_vi32 b) { return _mm256_xor_si256(a, b); }")
    g.line("static inline lxl_vi32 lxl_vi32_bnot(lxl_vi32 a) { return _mm256_xor_si256(a, lxl_v_ones()); }")
    g.line("static inline lxl_vi32 lxl_vi32_shl(lxl_vi32 a, int64_t k) { return _mm256_sll_epi32(a, _mm_cvtsi64_si128(k)); }")
    g.line("static inline lxl_vi32 lxl_vi32_shr(lxl_vi32 a, int64_t k) { return _mm256_sra_epi32(a, _mm_cvtsi64_si128(k)); }")
    g.line("static inline lxl_vi32 lxl_vi32_eq(lxl_vi32 a, lxl_vi32 b) { return _mm256_cmpeq_epi32(a, b); }")
    g.line("static inline lxl_vi32 lxl_vi32_ne(lxl_vi32 a, lxl_vi32 b) { return _mm256_xor_si256(_mm256_cmpeq_epi32(a, b), lxl_v_ones()); }")
    g.line("static inline lxl_vi32 lxl_vi32_gt(lxl_vi32 a, lxl_vi32 b) { return _mm256_cmpgt_epi32(a, b); }")
    g.line("static inline lxl_vi32 lxl_vi32_lt(lxl_vi32 a, lxl_vi32 b) { return _mm256_cmpgt_epi32(b, a); }")
    g.line("static inline lxl_vi32 lxl_vi32_le(lxl_vi32 a, lxl_vi32 b) { return _mm256_xor_si256(_mm256_cmpgt_epi32(a, b), lxl_v_ones()); }")
    g.line("static inline lxl_vi32 lxl_vi32_ge(lxl_vi32 a, lxl_vi32 b) { return _mm256_xor_si256(_mm256_cmpgt_epi32(b, a), lxl_v_ones()); }")
    g.line("static inline lxl_vi32 lxl_vi32_select(lxl_vi32 m, lxl_vi32 a, lxl_vi32 b) { return _mm256_castps_si256(_mm256_blendv_ps(_mm256_castsi256_ps(b), _mm256_castsi256_ps(a), _mm256_castsi256_ps(m))); }")
    g.line("static inline lxl_vi32 lxl_vi32_min(lxl_vi32 a, lxl_vi32 b) { return _mm256_min_epi32(a, b); }")
    g.line("static inline lxl_vi32 lxl_vi32_max(lxl_vi32 a, lxl_vi32 b) { return _mm256_max_epi32(a, b); }")
    g.line("static inline uint64_t lxl_vi32_bitmask(lxl_vi32 v) { return (uint64_t)(unsigned)_mm256_movemask_ps(_mm256_castsi256_ps(v)); }")
    g.line("static inline int32_t lxl_vi32_sum(lxl_vi32 v) { __m128i s = _mm_add_epi32(_mm256_castsi256_si128(v), _mm256_extracti128_si256(v, 1)); s = _mm_add_epi32(s, _mm_shuffle_epi32(s, 0x4E)); s = _mm_add_epi32(s, _mm_shuffle_epi32(s, 0xB1)); return _mm_cvtsi128_si32(s); }")
    g.line("static inline int32_t lxl_vi32_rmin(lxl_vi32 v) { __m128i s = _mm_min_epi32(_mm256_castsi256_si128(v), _mm256_extracti128_si256(v, 1)); s = _mm_min_epi32(s, _mm_shuffle_epi32(s, 0x4E)); s = _mm_min_epi32(s, _mm_shuffle_epi32(s, 0xB1)); return _mm_cvtsi128_si32(s); }")
    g.line("static inline int32_t lxl_vi32_rmax(lxl_vi32 v) { __m128i s = _mm_max_epi32(_mm256_castsi256_si128(v), _mm256_extracti128_si256(v, 1)); s = _mm_max_epi32(s, _mm_shuffle_epi32(s, 0x4E)); s = _mm_max_epi32(s, _mm_shuffle_epi32(s, 0xB1)); return _mm_cvtsi128_si32(s); }")
    g.line("static inline int32_t lxl_vi32_lane(lxl_vi32 v, int64_t k) { int32_t a[8]; _mm256_storeu_si256((__m256i*)a, v); return a[k]; }")
    // u8x32
    g.line("static inline lxl_vu8 lxl_vu8_zero(void) { return _mm256_setzero_si256(); }")
    g.line("static inline lxl_vu8 lxl_vu8_splat(uint8_t x) { return _mm256_set1_epi8((char)x); }")
    g.line("static inline lxl_vu8 lxl_vu8_load(const uint8_t* p) { return _mm256_loadu_si256((const __m256i*)p); }")
    g.line("static inline void lxl_vu8_store(uint8_t* p, lxl_vu8 v) { _mm256_storeu_si256((__m256i*)p, v); }")
    g.line("static inline lxl_vu8 lxl_vu8_add(lxl_vu8 a, lxl_vu8 b) { return _mm256_add_epi8(a, b); }")
    g.line("static inline lxl_vu8 lxl_vu8_sub(lxl_vu8 a, lxl_vu8 b) { return _mm256_sub_epi8(a, b); }")
    g.line("static inline lxl_vu8 lxl_vu8_and(lxl_vu8 a, lxl_vu8 b) { return _mm256_and_si256(a, b); }")
    g.line("static inline lxl_vu8 lxl_vu8_or(lxl_vu8 a, lxl_vu8 b) { return _mm256_or_si256(a, b); }")
    g.line("static inline lxl_vu8 lxl_vu8_xor(lxl_vu8 a, lxl_vu8 b) { return _mm256_xor_si256(a, b); }")
    g.line("static inline lxl_vu8 lxl_vu8_bnot(lxl_vu8 a) { return _mm256_xor_si256(a, lxl_v_ones()); }")
    g.line("static inline lxl_vu8 lxl_vu8_eq(lxl_vu8 a, lxl_vu8 b) { return _mm256_cmpeq_epi8(a, b); }")
    g.line("static inline lxl_vu8 lxl_vu8_ne(lxl_vu8 a, lxl_vu8 b) { return _mm256_xor_si256(_mm256_cmpeq_epi8(a, b), lxl_v_ones()); }")
    g.line("static inline lxl_vu8 lxl_vu8_le(lxl_vu8 a, lxl_vu8 b) { return _mm256_cmpeq_epi8(_mm256_min_epu8(a, b), a); }")
    g.line("static inline lxl_vu8 lxl_vu8_ge(lxl_vu8 a, lxl_vu8 b) { return _mm256_cmpeq_epi8(_mm256_max_epu8(a, b), a); }")
    g.line("static inline lxl_vu8 lxl_vu8_lt(lxl_vu8 a, lxl_vu8 b) { return _mm256_xor_si256(lxl_vu8_ge(a, b), lxl_v_ones()); }")
    g.line("static inline lxl_vu8 lxl_vu8_gt(lxl_vu8 a, lxl_vu8 b) { return _mm256_xor_si256(lxl_vu8_le(a, b), lxl_v_ones()); }")
    g.line("static inline lxl_vu8 lxl_vu8_select(lxl_vu8 m, lxl_vu8 a, lxl_vu8 b) { return _mm256_blendv_epi8(b, a, m); }")
    g.line("static inline lxl_vu8 lxl_vu8_min(lxl_vu8 a, lxl_vu8 b) { return _mm256_min_epu8(a, b); }")
    g.line("static inline lxl_vu8 lxl_vu8_max(lxl_vu8 a, lxl_vu8 b) { return _mm256_max_epu8(a, b); }")
    g.line("static inline lxl_vu8 lxl_vu8_shuffle(lxl_vu8 a, lxl_vu8 b) { return _mm256_shuffle_epi8(a, b); }")
    g.line("static inline uint64_t lxl_vu8_bitmask(lxl_vu8 v) { return (uint64_t)(unsigned)_mm256_movemask_epi8(v); }")
    g.line("static inline uint8_t lxl_vu8_sum(lxl_vu8 v) { uint8_t a[32]; _mm256_storeu_si256((__m256i*)a, v); uint8_t s = 0; for (int i = 0; i < 32; i++) s = (uint8_t)(s + a[i]); return s; }")
    g.line("static inline uint8_t lxl_vu8_rmin(lxl_vu8 v) { uint8_t a[32]; _mm256_storeu_si256((__m256i*)a, v); uint8_t m = a[0]; for (int i = 1; i < 32; i++) if (a[i] < m) m = a[i]; return m; }")
    g.line("static inline uint8_t lxl_vu8_rmax(lxl_vu8 v) { uint8_t a[32]; _mm256_storeu_si256((__m256i*)a, v); uint8_t m = a[0]; for (int i = 1; i < 32; i++) if (a[i] > m) m = a[i]; return m; }")
    g.line("static inline uint8_t lxl_vu8_lane(lxl_vu8 v, int64_t k) { uint8_t a[32]; _mm256_storeu_si256((__m256i*)a, v); return a[k]; }")
    // partial load/store (safe at buffer edges)
    g.line("static inline lxl_vf64 lxl_vf64_loadp(const double* p, int64_t n, double f) { if (n >= 4) return _mm256_loadu_pd(p); double a[4] = {f, f, f, f}; for (int64_t i = 0; i < n; i++) a[i] = p[i]; return _mm256_loadu_pd(a); }")
    g.line("static inline void lxl_vf64_storep(double* p, int64_t n, lxl_vf64 v) { if (n >= 4) { _mm256_storeu_pd(p, v); return; } double a[4]; _mm256_storeu_pd(a, v); for (int64_t i = 0; i < n; i++) p[i] = a[i]; }")
    g.line("static inline lxl_vi64 lxl_vi64_loadp(const int64_t* p, int64_t n, int64_t f) { if (n >= 4) return _mm256_loadu_si256((const __m256i*)p); int64_t a[4] = {f, f, f, f}; for (int64_t i = 0; i < n; i++) a[i] = p[i]; return _mm256_loadu_si256((const __m256i*)a); }")
    g.line("static inline void lxl_vi64_storep(int64_t* p, int64_t n, lxl_vi64 v) { if (n >= 4) { _mm256_storeu_si256((__m256i*)p, v); return; } int64_t a[4]; _mm256_storeu_si256((__m256i*)a, v); for (int64_t i = 0; i < n; i++) p[i] = a[i]; }")
    g.line("static inline lxl_vi32 lxl_vi32_loadp(const int32_t* p, int64_t n, int32_t f) { if (n >= 8) return _mm256_loadu_si256((const __m256i*)p); int32_t a[8] = {f, f, f, f, f, f, f, f}; for (int64_t i = 0; i < n; i++) a[i] = p[i]; return _mm256_loadu_si256((const __m256i*)a); }")
    g.line("static inline void lxl_vi32_storep(int32_t* p, int64_t n, lxl_vi32 v) { if (n >= 8) { _mm256_storeu_si256((__m256i*)p, v); return; } int32_t a[8]; _mm256_storeu_si256((__m256i*)a, v); for (int64_t i = 0; i < n; i++) p[i] = a[i]; }")
    g.line("static inline lxl_vu8 lxl_vu8_loadp(const uint8_t* p, int64_t n, uint8_t f) { if (n >= 32) return _mm256_loadu_si256((const __m256i*)p); uint8_t a[32]; _mm256_storeu_si256((__m256i*)a, _mm256_set1_epi8((char)f)); for (int64_t i = 0; i < n; i++) a[i] = p[i]; return _mm256_loadu_si256((const __m256i*)a); }")
    g.line("static inline void lxl_vu8_storep(uint8_t* p, int64_t n, lxl_vu8 v) { if (n >= 32) { _mm256_storeu_si256((__m256i*)p, v); return; } uint8_t a[32]; _mm256_storeu_si256((__m256i*)a, v); for (int64_t i = 0; i < n; i++) p[i] = a[i]; }")
}
