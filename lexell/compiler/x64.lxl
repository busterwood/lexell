pub fn (a: mut &Asm) vandnpd256(dst: int, s1: int, s2: int) { a.vexRR(1, 1, 0, 1, s1, 0x55, dst, s2) }
pub fn (a: mut &Asm) vfmadd231pd256(dst: int, s1: int, s2: int) { a.vexRR(1, 2, 1, 1, s1, 0xB8, dst, s2) }
pub fn (a: mut &Asm) vcmppd256(dst: int, s1: int, s2: int, imm: int) {
    a.vexRR(1, 1, 0, 1, s1, 0xC2, dst, s2)
    a.b(imm)
}
pub fn (a: mut &Asm) vblendvpd256(dst: int, s1: int, s2: int, mask: int) {
    a.vexRR(1, 3, 0, 1, s1, 0x4B, dst, s2)
    a.b((mask & 15) << 4)
}
pub fn (a: mut &Asm) vblendvps256(dst: int, s1: int, s2: int, mask: int) {
