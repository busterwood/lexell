// x64: the x86-64 instruction encoder of the native backend (design/native.md).
//
// An Asm is a code buffer with labels (jumps within it, resolved by fixLabels) and
// relocations (references to symbols outside it: calls, addresses of data, resolved by the
// linker in native.lxl). The encodings are those GNU as chooses for the same instruction
// (the register-to-register ALU forms with the destination in r/m, the accumulator forms
// of the immediate ALU, `shl r, 1` as D1), so that tools/x64_encode_test.py can compare the
// bytes with as's: `lxlc --encode-test file` reads one instruction per line (the format of
// runTest below) and prints the bytes of each in hex.

// Registers (their encoding numbers); xmm registers are 0 to 15 in their own operands.
import "strings"

pub const RAX = 0
pub const RCX = 1
pub const RDX = 2
pub const RBX = 3
pub const RSP = 4
pub const RBP = 5
pub const RSI = 6
pub const RDI = 7
pub const R8 = 8
pub const R9 = 9
pub const R10 = 10
pub const R11 = 11
pub const R12 = 12
pub const R13 = 13
pub const R14 = 14
pub const R15 = 15

// ALU operations (the /digit of 0x81, 0x83 and the opcode row of the r/m forms).
pub const ADD = 0
pub const OR = 1
pub const ADC = 2
pub const SBB = 3
pub const AND = 4
pub const SUB = 5
pub const XOR = 6
pub const CMP = 7

// Unary group 3 (0xF7 /digit).
pub const NOT = 2
pub const NEG = 3
pub const MUL = 4
pub const IMUL1 = 5
pub const DIV = 6
pub const IDIV = 7

// Shifts and rotates (0xD3 /digit, 0xC1 /digit).
pub const ROL = 0
pub const SHL = 4
pub const SHR = 5
pub const SAR = 7

// Condition codes.
pub const CC_O = 0
pub const CC_NO = 1
pub const CC_B = 2
pub const CC_AE = 3
pub const CC_E = 4
pub const CC_NE = 5
pub const CC_BE = 6
pub const CC_A = 7
pub const CC_S = 8
pub const CC_NS = 9
pub const CC_P = 10
pub const CC_NP = 11
pub const CC_L = 12
pub const CC_GE = 13
pub const CC_LE = 14
pub const CC_G = 15

// SSE2 scalar double operations (F2 0F op), and the 66 0F ones.
pub const ADDSD = 0x58
pub const MULSD = 0x59
pub const SUBSD = 0x5C
pub const DIVSD = 0x5E
pub const SQRTSD = 0x51
pub const MOVSD = 0x10
pub const UCOMISD = 0x2E
pub const XORPD = 0x57

// Relocation kinds: a 32-bit displacement to the symbol from the end of the field (calls,
// jumps), the symbol's absolute address in 32 bits (sign-extended by the CPU: everything
// is below 2 GiB) or in 64 bits.
pub const R_REL32 = 0
pub const R_ABS32 = 1
pub const R_ABS64 = 2

// A memory operand [base + index*scale + disp]; base -1 with index -1 is an absolute
// address (disp), encoded with a SIB byte and no base; base -2 (RIP) is [rip + disp].
pub type Mem = value record {
    pub base: int
    pub index: int
    pub scale: int
    pub disp: int
}

pub fn mem(base: int, disp: int): Mem { return Mem{base: base, index: -1, scale: 1, disp: disp} }

pub fn memx(base: int, index: int, scale: int, disp: int): Mem {
    return Mem{base: base, index: index, scale: scale, disp: disp}
}

pub fn absMem(addr: int): Mem { return Mem{base: -1, index: -1, scale: 1, disp: addr} }

pub const RIP = -2

pub fn ripMem(disp: int): Mem { return Mem{base: RIP, index: -1, scale: 1, disp: disp} }

type Fix = value record {
    at: int         // the rel32 field
    label: int
    base: int       // a jump table's entry: the label the offset is from (else -1: the field's end)
    op: int         // a jump's opcode bytes before the field (jmp 1, jcc 2), else 0 (layout)
}

pub type Reloc = value record {
    pub at: int         // the field
    pub sym: int        // the linker's symbol number
    pub kind: int       // R_*
    pub addend: int
}

pub type Asm = record {
    pub code: []byte
    labels: []int           // label -> position, -1 while unbound
    fixes: []Fix
    pub relocs: []Reloc
    pub peep: bool          // the peephole below (off for the encoder test, which checks bytes)
    stEnd: int              // the end of the last 8-byte store of a register, or -1
    nsEnd: int              // the end of the last narrower store of a tagged value (storeTag), or -1
    nsMem: Mem
    nsReg: int
    nsTag: int
    stMem: Mem
    stReg: int
    jmpEnd: int             // the end of the last jmp to a label (no label bound since), or -1
    jmpLabel: int
    termEnd: int            // the end of the last ret or jmp (no label bound since), or -1
    cmpEnd: int             // the end of the last cmp (or jcc after it, no label since), or -1
    cmpKind: int            // 0: rr, 1: ri, 2: rm, 3: mi
    cmpSize: int
    cmpA: int
    cmpB: int
    cmpMem: Mem
}

pub fn newAsm(): Asm {
    return Asm{code: [], labels: [], fixes: [], relocs: [], peep: false, stEnd: -1, stMem: mem(-1, 0), stReg: 0,
        jmpEnd: -1, jmpLabel: -1, termEnd: -1, nsEnd: -1, nsMem: mem(-1, 0), nsReg: 0, nsTag: -1,
        cmpEnd: -1, cmpKind: 0, cmpSize: 0, cmpA: 0, cmpB: 0, cmpMem: mem(-1, 0)}
}

fn memEq(a: Mem, b: Mem): bool {
    return a.base == b.base && a.index == b.index && a.disp == b.disp && (a.index < 0 || a.scale == b.scale)
}

pub fn (a: &Asm) pos(): int { return len(a.code) }

pub fn (a: mut &Asm) b(x: int) { append(mut &a.code, byte(x & 255)) }

pub fn (a: mut &Asm) d32(x: int) {
    a.b(x)
    a.b(x >> 8)
    a.b(x >> 16)
    a.b(x >> 24)
}

pub fn (a: mut &Asm) d64(x: int) {
    a.d32(x)
    a.d32(x >> 32)
}

// Overwrites the 32-bit field at.
pub fn (a: mut &Asm) put32(at: int, x: int) {
    a.code[at] = byte(x & 255)
    a.code[at + 1] = byte((x >> 8) & 255)
    a.code[at + 2] = byte((x >> 16) & 255)
    a.code[at + 3] = byte((x >> 24) & 255)
}

pub fn fits8(v: int): bool { return v >= -128 && v < 128 }

pub fn fits32(v: int): bool { return v >= -2147483648 && v < 2147483648 }

// ---------------------------------------------------------------- ModRM forms

// prefix (0, or 0x66, 0xF2, 0xF3), REX, the opcode (one to three bytes: 0x0FAF is 0F AF).
fn (a: mut &Asm) head(pfx: int, w: bool, opc: int, reg: int, x: int, bse: int, force: bool) {
    if pfx != 0 { a.b(pfx) }
    var r = 0x40
    if w { r = r | 8 }
    r = r | (((reg >> 3) & 1) << 2) | (((x >> 3) & 1) << 1) | ((bse >> 3) & 1)
    if r != 0x40 || force { a.b(r) }
    if opc > 0xFFFF { a.b(opc >> 16) }
    if opc > 0xFF { a.b(opc >> 8) }
    a.b(opc)
}

// byte: an 8-bit register operand (spl, bpl, sil, dil need a REX prefix to be named).
fn lowByte(r: int): bool { return r >= 4 && r <= 7 }

// opc reg, rm (both registers). breg/brm: the operand is a byte register.
pub fn (a: mut &Asm) rr(pfx: int, w: bool, opc: int, reg: int, rm: int, breg: bool, brm: bool) {
    a.head(pfx, w, opc, reg, 0, rm, (breg && lowByte(reg)) || (brm && lowByte(rm)))
    a.b(0xC0 | ((reg & 7) << 3) | (rm & 7))
}

// opc reg, [m].
pub fn (a: mut &Asm) rm(pfx: int, w: bool, opc: int, reg: int, m: Mem, breg: bool) {
    let x = if m.index >= 0 { m.index } else { 0 }
    let bs = if m.base >= 0 { m.base } else { 0 }
    a.head(pfx, w, opc, reg, x, bs, breg && lowByte(reg))
    a.memTail(reg, m)
}

// The ModRM, SIB and displacement bytes of the memory operand m with register field reg.
fn (a: mut &Asm) memTail(reg: int, m: Mem) {
    if m.base == RIP {
        a.b(0x05 | ((reg & 7) << 3))
        a.d32(m.disp)
        return
    }
    if m.base < 0 && m.index < 0 {
        a.b(0x04 | ((reg & 7) << 3))
        a.b(0x25)
        a.d32(m.disp)
        return
    }
    var md = 2
    if m.base >= 0 && m.disp == 0 && (m.base & 7) != 5 {
        md = 0
    } else if m.base >= 0 && fits8(m.disp) {
        md = 1
    }
    if m.index >= 0 {
        let ss = if m.scale == 1 { 0 } else if m.scale == 2 { 1 } else if m.scale == 4 { 2 } else { 3 }
        if m.base < 0 {             // [index*scale + disp32]: no base
            a.b(((reg & 7) << 3) | 4)
            a.b((ss << 6) | ((m.index & 7) << 3) | 5)
            a.d32(m.disp)
            return
        }
        a.b((md << 6) | ((reg & 7) << 3) | 4)
        a.b((ss << 6) | ((m.index & 7) << 3) | (m.base & 7))
    } else if (m.base & 7) == 4 {
        a.b((md << 6) | ((reg & 7) << 3) | 4)
        a.b(0x24)
    } else {
        a.b((md << 6) | ((reg & 7) << 3) | (m.base & 7))
    }
    if md == 1 {
        a.b(m.disp)
    } else if md == 2 {
        a.d32(m.disp)
    }
}

fn pfxOf(size: int): int { return if size == 2 { 0x66 } else { 0 } }

// ---------------------------------------------------------------- moves

// mov dst, src (size 1, 2, 4 or 8; a 4-byte move zero-extends to 64 bits).
pub fn (a: mut &Asm) movRR(size: int, dst: int, src: int) {
    if a.peep && size == 8 && dst == src { return }     // peephole: a move that changes nothing
    a.rr(pfxOf(size), size == 8, if size == 1 { 0x88 } else { 0x89 }, src, dst, size == 1, size == 1)
}

pub fn (a: mut &Asm) load(size: int, dst: int, m: Mem) {
    // peephole: a load of what the instruction before (no label between) stored
    if a.peep && size == 8 && a.stEnd == a.pos() && memEq(m, a.stMem) && m.base != dst && m.index != dst {
        if dst != a.stReg { a.movRR(8, dst, a.stReg) }
        return
    }
    a.rm(pfxOf(size), size == 8, if size == 1 { 0x8A } else { 0x8B }, dst, m, size == 1)
}

// A store of size bytes (1, 2 or 4) of register src, which holds tag (for the code generator:
// a type whose values it holds normalized to 64 bits). storedTag finds it when the next
// instruction would load it back.
pub fn (a: mut &Asm) storeTag(size: int, m: Mem, src: int, tag: int) {
    a.store(size, m, src)
    if size < 8 && m.base != src && m.index != src && m.base != RIP {
        a.nsEnd = a.pos()
        a.nsMem = m
        a.nsReg = src
        a.nsTag = tag
    }
}

// The register that the instruction before (no label between) stored with storeTag at m with
// tag, or -1.
pub fn (a: &Asm) storedTag(m: Mem, tag: int): int {
    if a.peep && a.nsEnd == a.pos() && memEq(m, a.nsMem) && a.nsTag == tag { return a.nsReg }
    return -1
}

pub fn (a: mut &Asm) store(size: int, m: Mem, src: int) {
    a.rm(pfxOf(size), size == 8, if size == 1 { 0x88 } else { 0x89 }, src, m, size == 1)
    if size == 8 && m.base != src && m.index != src && m.base != RIP {
        a.stEnd = a.pos()
        a.stMem = m
        a.stReg = src
    }
}

// A load of size bytes, zero- or sign-extended to 64 bits.
pub fn (a: mut &Asm) loadZX(size: int, dst: int, m: Mem) {
    if size == 1 {
        a.rm(0, false, 0x0FB6, dst, m, false)
    } else if size == 2 {
        a.rm(0, false, 0x0FB7, dst, m, false)
    } else {
        a.load(size, dst, m)
    }
}

pub fn (a: mut &Asm) loadSX(size: int, dst: int, m: Mem) {
    if size == 1 {
        a.rm(0, true, 0x0FBE, dst, m, false)
    } else if size == 2 {
        a.rm(0, true, 0x0FBF, dst, m, false)
    } else if size == 4 {
        a.rm(0, true, 0x63, dst, m, false)
    } else {
        a.load(8, dst, m)
    }
}

// dst = the low size bytes of src, zero- or sign-extended to 64 bits.
pub fn (a: mut &Asm) zx(size: int, dst: int, src: int) {
    if size == 1 {
        a.rr(0, false, 0x0FB6, dst, src, false, true)
    } else if size == 2 {
        a.rr(0, false, 0x0FB7, dst, src, false, false)
    } else if size == 4 {
        a.movRR(4, dst, src)
    } else if dst != src {
        a.movRR(8, dst, src)
    }
}

pub fn (a: mut &Asm) sx(size: int, dst: int, src: int) {
    if size == 1 {
        a.rr(0, true, 0x0FBE, dst, src, false, true)
    } else if size == 2 {
        a.rr(0, true, 0x0FBF, dst, src, false, false)
    } else if size == 4 {
        a.rr(0, true, 0x63, dst, src, false, false)
    } else if dst != src {
        a.movRR(8, dst, src)
    }
}

// mov r, v: the shortest of mov r32, imm32 (zero-extends), mov r64, simm32 and movabs.
pub fn (a: mut &Asm) movRI(r: int, v: int) {
    if v >= 0 && v < 4294967296 {
        if r >= 8 { a.b(0x41) }
        a.b(0xB8 + (r & 7))
        a.d32(v)
    } else if fits32(v) {
        a.rr(0, true, 0xC7, 0, r, false, false)
        a.d32(v)
    } else {
        a.b(0x48 | ((r >> 3) & 1))
        a.b(0xB8 + (r & 7))
        a.d64(v)
    }
}

// mov r, imm32 with the immediate a relocation (the absolute address of sym + addend).
pub fn (a: mut &Asm) movRSym(r: int, sym: int, addend: int) {
    if r >= 8 { a.b(0x41) }
    a.b(0xB8 + (r & 7))
    append(mut &a.relocs, Reloc{at: a.pos(), sym: sym, kind: R_ABS32, addend: addend})
    a.d32(0)
}

// mov [m], imm32 (sign-extended for size 8).
pub fn (a: mut &Asm) storeI(size: int, m: Mem, v: int) {
    if size == 1 {
        a.rm(0, false, 0xC6, 0, m, false)
        a.b(v)
    } else {
        a.rm(pfxOf(size), size == 8, 0xC7, 0, m, false)
        if size == 2 {
            a.b(v)
            a.b(v >> 8)
        } else {
            a.d32(v)
        }
    }
}

pub fn (a: mut &Asm) lea(dst: int, m: Mem) { a.rm(0, true, 0x8D, dst, m, false) }

// ---------------------------------------------------------------- arithmetic

// op dst, src (ADD ... CMP).
pub fn (a: mut &Asm) alu(op: int, size: int, dst: int, src: int) {
    if a.peep && op == CMP && a.cmpEnd == a.pos() && a.cmpKind == 0 && a.cmpSize == size && a.cmpA == dst && a.cmpB == src {
        return
    }
    a.rr(pfxOf(size), size == 8, op * 8 + (if size == 1 { 0 } else { 1 }), src, dst, size == 1, size == 1)
    if op == CMP {
        a.cmpEnd = a.pos()
        a.cmpKind = 0
        a.cmpSize = size
        a.cmpA = dst
        a.cmpB = src
    }
}

// op dst, [m].
pub fn (a: mut &Asm) aluRM(op: int, size: int, dst: int, m: Mem) {
    if a.peep && op == CMP && a.cmpEnd == a.pos() && a.cmpKind == 2 && a.cmpSize == size && a.cmpA == dst && memEq(a.cmpMem, m) {
        return
    }
    a.rm(pfxOf(size), size == 8, op * 8 + (if size == 1 { 2 } else { 3 }), dst, m, size == 1)
    if op == CMP && m.base != RIP {
        a.cmpEnd = a.pos()
        a.cmpKind = 2
        a.cmpSize = size
        a.cmpA = dst
        a.cmpMem = m
    }
}

// op [m], src.
pub fn (a: mut &Asm) aluMR(op: int, size: int, m: Mem, src: int) {
    a.rm(pfxOf(size), size == 8, op * 8 + (if size == 1 { 0 } else { 1 }), src, m, size == 1)
}

// op dst, imm (size 4 or 8; the immediate fits 32 bits, sign-extended).
pub fn (a: mut &Asm) aluI(op: int, size: int, dst: int, v: int) {
    if a.peep && op == CMP && a.cmpEnd == a.pos() && a.cmpKind == 1 && a.cmpSize == size && a.cmpA == dst && a.cmpB == v {
        return
    }
    if fits8(v) {
        a.rr(0, size == 8, 0x83, op, dst, false, false)
        a.b(v)
    } else if dst == RAX {
        if size == 8 { a.b(0x48) }
        a.b(op * 8 + 5)
        a.d32(v)
    } else {
        a.rr(0, size == 8, 0x81, op, dst, false, false)
        a.d32(v)
    }
    if op == CMP {
        a.cmpEnd = a.pos()
        a.cmpKind = 1
        a.cmpSize = size
        a.cmpA = dst
        a.cmpB = v
    }
}

// op size [m], imm (the immediate fits the operand, or 32 bits sign-extended for size 8).
pub fn (a: mut &Asm) aluMI(op: int, size: int, m: Mem, v: int) {
    if a.peep && op == CMP && a.cmpEnd == a.pos() && a.cmpKind == 3 && a.cmpSize == size && a.cmpB == v && memEq(a.cmpMem, m) {
        return
    }
    if size == 1 {
        a.rm(0, false, 0x80, op, m, false)
        a.b(v)
    } else if fits8(v) {
        a.rm(pfxOf(size), size == 8, 0x83, op, m, false)
        a.b(v)
    } else {
        a.rm(pfxOf(size), size == 8, 0x81, op, m, false)
        if size == 2 {
            a.b(v)
            a.b(v >> 8)
        } else {
            a.d32(v)
        }
    }
    if op == CMP && m.base != RIP {
        a.cmpEnd = a.pos()
        a.cmpKind = 3
        a.cmpSize = size
        a.cmpB = v
        a.cmpMem = m
    }
}

pub fn (a: mut &Asm) test(size: int, x: int, y: int) {
    a.rr(pfxOf(size), size == 8, if size == 1 { 0x84 } else { 0x85 }, y, x, size == 1, size == 1)
}

// imul dst, src (size 4 or 8).
pub fn (a: mut &Asm) imul(size: int, dst: int, src: int) { a.rr(0, size == 8, 0x0FAF, dst, src, false, false) }

// imul dst, src, imm (the immediate fits 32 bits, sign-extended).
pub fn (a: mut &Asm) imulI(size: int, dst: int, src: int, v: int) {
    if fits8(v) {
        a.rr(0, size == 8, 0x6B, dst, src, false, false)
        a.b(v & 255)
    } else {
        a.rr(0, size == 8, 0x69, dst, src, false, false)
        a.d32(v)
    }
}

// NOT, NEG, MUL, IMUL1, DIV, IDIV of r (size 4 or 8).
pub fn (a: mut &Asm) unary(op: int, size: int, r: int) { a.rr(0, size == 8, 0xF7, op, r, false, false) }

// SHL, SHR, SAR r by cl.
pub fn (a: mut &Asm) shiftCL(op: int, size: int, r: int) { a.rr(0, size == 8, 0xD3, op, r, false, false) }

pub fn (a: mut &Asm) shiftI(op: int, size: int, r: int, n: int) {
    if n == 1 {
        a.rr(0, size == 8, 0xD1, op, r, false, false)
    } else {
        a.rr(0, size == 8, 0xC1, op, r, false, false)
        a.b(n)
    }
}

// shld dst, src, cl / shrd dst, src, cl (64-bit).
pub fn (a: mut &Asm) shldCL(dst: int, src: int) { a.rr(0, true, 0x0FA5, src, dst, false, false) }

pub fn (a: mut &Asm) shrdCL(dst: int, src: int) { a.rr(0, true, 0x0FAD, src, dst, false, false) }

// shld dst, src, n and shrd dst, src, n (64-bit, n in 0..63).
pub fn (a: mut &Asm) shldI(dst: int, src: int, n: int) {
    a.rr(0, true, 0x0FA4, src, dst, false, false)
    a.b(n)
}

pub fn (a: mut &Asm) shrdI(dst: int, src: int, n: int) {
    a.rr(0, true, 0x0FAC, src, dst, false, false)
    a.b(n)
}

// setcc r8.
pub fn (a: mut &Asm) setcc(cc: int, r: int) { a.rr(0, false, 0x0F90 + cc, 0, r, false, true) }

// cmovcc dst, src (64-bit).
pub fn (a: mut &Asm) cmov(cc: int, dst: int, src: int) { a.rr(0, true, 0x0F40 + cc, dst, src, false, false) }

pub fn (a: mut &Asm) cqo() {
    a.b(0x48)
    a.b(0x99)
}

pub fn (a: mut &Asm) cdq() { a.b(0x99) }

pub fn (a: mut &Asm) push(r: int) {
    if r >= 8 { a.b(0x41) }
    a.b(0x50 + (r & 7))
}

pub fn (a: mut &Asm) pop(r: int) {
    if r >= 8 { a.b(0x41) }
    a.b(0x58 + (r & 7))
}

pub fn (a: mut &Asm) ret() {
    a.b(0xC3)
    a.termEnd = a.pos()
}

pub fn (a: mut &Asm) leave() { a.b(0xC9) }

pub fn (a: mut &Asm) ud2() {
    a.b(0x0F)
    a.b(0x0B)
}

// call r / jmp r.
pub fn (a: mut &Asm) callR(r: int) { a.rr(0, false, 0xFF, 2, r, false, false) }

pub fn (a: mut &Asm) jmpR(r: int) { a.rr(0, false, 0xFF, 4, r, false, false) }

// rep movsb (rdi <- rsi, rcx bytes) and rep stosb (rdi <- al, rcx bytes).
pub fn (a: mut &Asm) repMovsb() {
    a.b(0xF3)
    a.b(0xA4)
}

pub fn (a: mut &Asm) repStosb() {
    a.b(0xF3)
    a.b(0xAA)
}

// rep stosw, stosd or stosq (size 2, 4 or 8; 1 is stosb): rcx elements at rdi get ax, eax or rax.
pub fn (a: mut &Asm) repStos(size: int) {
    if size == 2 { a.b(0x66) }
    a.b(0xF3)
    if size == 8 { a.b(0x48) }
    a.b(if size == 1 { 0xAA } else { 0xAB })
}

// ---------------------------------------------------------------- SSE2

// op xd, xs: addsd, mulsd, subsd, divsd, sqrtsd, movsd (F2 0F op).
pub fn (a: mut &Asm) sse(op: int, dst: int, src: int) { a.rr(0xF2, false, 0x0F00 + op, dst, src, false, false) }

// roundsd xd, xs, imm (SSE4.1, which every AVX CPU has): 9 floor, 10 ceil, 11 trunc, 12 rint.
pub fn (a: mut &Asm) roundsd(dst: int, src: int, imm: int) {
    a.rr(0x66, false, 0x0F3A0B, dst, src, false, false)
    a.b(imm)
}

// vfmadd213sd xd, xs2, xs3: xd = xs2 * xd + xs3 (VEX.LIG.66.0F38.W1 A9; FMA3; registers 0 to 7).
pub fn (a: mut &Asm) vfmadd213sd(dst: int, s2: int, s3: int) {
    a.b(0xC4)
    a.b(0xE2)
    a.b(0x80 | ((15 - s2) << 3) | 1)
    a.b(0xA9)
    a.b(0xC0 | ((dst & 7) << 3) | (s3 & 7))
}

// ucomisd, xorpd (66 0F op).
pub fn (a: mut &Asm) sse66(op: int, dst: int, src: int) { a.rr(0x66, false, 0x0F00 + op, dst, src, false, false) }

pub fn (a: mut &Asm) movsdLoad(x: int, m: Mem) { a.rm(0xF2, false, 0x0F10, x, m, false) }

// op xd, [m]: addsd, mulsd, subsd, divsd, movsd (F2 0F op) with the source in memory.
pub fn (a: mut &Asm) sseM(op: int, dst: int, m: Mem) { a.rm(0xF2, false, 0x0F00 + op, dst, m, false) }

// The [rip + disp32] operand of the instruction just emitted (one with no immediate) made sym's
// address.
pub fn (a: mut &Asm) relocRip(sym: int) {
    append(mut &a.relocs, Reloc{at: a.pos() - 4, sym: sym, kind: R_REL32, addend: 0})
}

pub fn (a: mut &Asm) movsdStore(m: Mem, x: int) { a.rm(0xF2, false, 0x0F11, x, m, false) }

// movdqu x, [m] and movdqu [m], x (16 bytes, any alignment: F3 0F 6F / 7F).
pub fn (a: mut &Asm) movdquLoad(x: int, m: Mem) { a.rm(0xF3, false, 0x0F6F, x, m, false) }

pub fn (a: mut &Asm) movdquStore(m: Mem, x: int) { a.rm(0xF3, false, 0x0F7F, x, m, false) }

// movq x, r / movq r, x (64 bits between an integer and an xmm register).
pub fn (a: mut &Asm) movqXR(x: int, r: int) { a.rr(0x66, true, 0x0F6E, x, r, false, false) }

pub fn (a: mut &Asm) movqRX(r: int, x: int) { a.rr(0x66, true, 0x0F7E, x, r, false, false) }

// cvtsi2sd x, r64 and cvttsd2si r64, x.
pub fn (a: mut &Asm) cvtsi2sd(x: int, r: int) { a.rr(0xF2, true, 0x0F2A, x, r, false, false) }

pub fn (a: mut &Asm) cvttsd2si(r: int, x: int) { a.rr(0xF2, true, 0x0F2C, r, x, false, false) }

// ---------------------------------------------------------------- BMI1 / LZCNT / POPCNT (x86-64-v3)

pub fn (a: mut &Asm) tzcnt(size: int, dst: int, src: int) { a.rr(0xF3, size == 8, 0x0FBC, dst, src, false, false) }

pub fn (a: mut &Asm) lzcnt(size: int, dst: int, src: int) { a.rr(0xF3, size == 8, 0x0FBD, dst, src, false, false) }

pub fn (a: mut &Asm) popcnt(size: int, dst: int, src: int) { a.rr(0xF3, size == 8, 0x0FB8, dst, src, false, false) }

// ---------------------------------------------------------------- AVX2 / FMA3 (VEX)

// pp: 0 none, 1 66, 2 F3, 3 F2; mm: 1 0F, 2 0F38, 3 0F3A; w: 0 or 1; l: 0 (128) or 1 (256).
fn (a: mut &Asm) vexHead(pp: int, mm: int, w: int, l: int, vvvv: int, op: int, reg: int, x: int, bse: int) {
    let r = if reg >= 8 { 0 } else { 1 }
    let xb = if x >= 8 { 0 } else { 1 }
    let b = if bse >= 8 { 0 } else { 1 }
    let nv = (~vvvv) & 15
    if mm == 1 && w == 0 && xb == 1 && b == 1 {
        a.b(0xC5)
        a.b((r << 7) | (nv << 3) | (l << 2) | pp)
    } else {
        a.b(0xC4)
        a.b((r << 7) | (xb << 6) | (b << 5) | mm)
        a.b((w << 7) | (nv << 3) | (l << 2) | pp)
    }
    a.b(op)
}

pub fn (a: mut &Asm) vexRR(pp: int, mm: int, w: int, l: int, vvvv: int, op: int, reg: int, rm: int) {
    a.vexHead(pp, mm, w, l, vvvv, op, reg, 0, rm)
    a.b(0xC0 | ((reg & 7) << 3) | (rm & 7))
}

pub fn (a: mut &Asm) vexRM(pp: int, mm: int, w: int, l: int, vvvv: int, op: int, reg: int, m: Mem) {
    let x = if m.index >= 0 { m.index } else { 0 }
    let bs = if m.base >= 0 { m.base } else { 0 }
    a.vexHead(pp, mm, w, l, vvvv, op, reg, x, bs)
    a.memTail(reg, m)
}

pub fn (a: mut &Asm) vzeroupper() {
    a.b(0xC5)
    a.b(0xF8)
    a.b(0x77)
}

// 256-bit moves, loads, stores, broadcasts
pub fn (a: mut &Asm) vmovdquRR(dst: int, src: int) { a.vexRR(2, 1, 0, 1, 0, 0x6F, dst, src) }
pub fn (a: mut &Asm) vmovupdLoad(dst: int, m: Mem) { a.vexRM(1, 1, 0, 1, 0, 0x10, dst, m) }
pub fn (a: mut &Asm) vmovupdStore(m: Mem, src: int) { a.vexRM(1, 1, 0, 1, 0, 0x11, src, m) }
pub fn (a: mut &Asm) vmovdquLoad(dst: int, m: Mem) { a.vexRM(2, 1, 0, 1, 0, 0x6F, dst, m) }
pub fn (a: mut &Asm) vmovdquStore(m: Mem, src: int) { a.vexRM(2, 1, 0, 1, 0, 0x7F, src, m) }
pub fn (a: mut &Asm) vbroadcastsd(dst: int, srcX: int) { a.vexRR(1, 2, 0, 1, 0, 0x19, dst, srcX) }
pub fn (a: mut &Asm) vpbroadcastq(dst: int, srcX: int) { a.vexRR(1, 2, 0, 1, 0, 0x59, dst, srcX) }
pub fn (a: mut &Asm) vpbroadcastd(dst: int, srcX: int) { a.vexRR(1, 2, 0, 1, 0, 0x58, dst, srcX) }
pub fn (a: mut &Asm) vpbroadcastb(dst: int, srcX: int) { a.vexRR(1, 2, 0, 1, 0, 0x78, dst, srcX) }
pub fn (a: mut &Asm) vmovqXR(x: int, r: int) { a.vexRR(1, 1, 1, 0, 0, 0x6E, x, r) }
pub fn (a: mut &Asm) vmovqRX(r: int, x: int) { a.vexRR(1, 1, 1, 0, 0, 0x7E, x, r) }
pub fn (a: mut &Asm) vmovdXR(x: int, r: int) { a.vexRR(1, 1, 0, 0, 0, 0x6E, x, r) }
pub fn (a: mut &Asm) vmovdRX(r: int, x: int) { a.vexRR(1, 1, 0, 0, 0, 0x7E, x, r) }

// 256-bit f64x4 ops
pub fn (a: mut &Asm) vaddpd256(dst: int, s1: int, s2: int) { a.vexRR(1, 1, 0, 1, s1, 0x58, dst, s2) }
pub fn (a: mut &Asm) vsubpd256(dst: int, s1: int, s2: int) { a.vexRR(1, 1, 0, 1, s1, 0x5C, dst, s2) }
pub fn (a: mut &Asm) vmulpd256(dst: int, s1: int, s2: int) { a.vexRR(1, 1, 0, 1, s1, 0x59, dst, s2) }
pub fn (a: mut &Asm) vdivpd256(dst: int, s1: int, s2: int) { a.vexRR(1, 1, 0, 1, s1, 0x5E, dst, s2) }
pub fn (a: mut &Asm) vminpd256(dst: int, s1: int, s2: int) { a.vexRR(1, 1, 0, 1, s1, 0x5D, dst, s2) }
pub fn (a: mut &Asm) vmaxpd256(dst: int, s1: int, s2: int) { a.vexRR(1, 1, 0, 1, s1, 0x5F, dst, s2) }
pub fn (a: mut &Asm) vsqrtpd256(dst: int, src: int) { a.vexRR(1, 1, 0, 1, 0, 0x51, dst, src) }
