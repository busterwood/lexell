// ---------------------------------------------------------------- labels and relocations

pub fn (a: mut &Asm) newLabel(): int {
    append(mut &a.labels, -1)
    return len(a.labels) - 1
}

pub fn (a: mut &Asm) bind(l: int) {
    // peephole: a jmp to the label bound right after it is dropped
    if a.peep && a.jmpEnd == a.pos() && a.jmpLabel == l {
        for i in 0..5 { pop(mut &a.code) }
        pop(mut &a.fixes)
    }
    a.jmpEnd = -1
    a.termEnd = -1
    a.labels[l] = a.pos()
    a.stEnd = -1
    a.nsEnd = -1
    a.cmpEnd = -1
}

// Binds label l again, at p.
pub fn (a: mut &Asm) moveLabel(l: int, p: int) { a.labels[l] = p }

pub fn (a: &Asm) labelCount(): int { return len(a.labels) }

// Where label l is bound, or -1.
pub fn (a: &Asm) labelPos(l: int): int { return a.labels[l] }

// The pad before a loop's top at position now (a multiple of 64 being an address's), as gcc pads:
// to a multiple of 16 when that takes at most 10 bytes, else of 8. An innermost loop of size up
// to lines bytes is moved further, to a multiple of 16 from which it spans the fewest 64-byte
// lines it can, so that it runs from as few lines of the instruction cache (and of the op cache)
// as its size allows: the sieve's inner loop, 17 bytes from 48 bytes into a line, ran at about
// 1.5 times the cycles, and wc's 84-byte loop over three lines 9% slower than over two.
pub fn loopPad(now: int, size: int, inner: bool, lines: int): int {
    var pad = (16 - now % 16) % 16
    if pad > 10 { pad = (8 - now % 8) % 8 }
    if inner && size <= lines {
        // the fewest 64-byte lines the loop can span
        let need = (size + 63) / 64
        if ((now + pad) % 64 + size + 63) / 64 > need {
            pad = (16 - now % 16) % 16
            while ((now + pad) % 64 + size + 63) / 64 > need { pad += 16 }
        }
    }
    return pad
}

// The number of the keys (sorted) at or before p.
fn upTo(keys: &[]int, p: int): int {
    var lo = 0
    var hi = len(keys)
    while lo < hi {
        let m = (lo + hi) / 2
        if keys[m] <= p { lo = m + 1 } else { hi = m }
    }
    return lo
}

// Jump threading: each jump (from fix-up f0 on) to a label of the function (from first on) where
// a jmp to another such label stands goes to that jmp's target instead, along a chain of at most 8
// (a case of a match that jumps to the jmp back to its loop's top: one taken jump instead of two).
// A jmp is known by its fix-up, so bytes that only look like one (in a jump table) are not.
fn (a: mut &Asm) thread(f0: int, first: int) {
    // the jmps to the function's labels, by position (the fix-ups are in the order of the code)
    var jat: []int = []
    var jl: []int = []
    for i in f0..len(a.fixes) {
        let f = a.fixes[i]
        if f.op == 1 && f.label >= first {
            append(mut &jat, f.at - 1)
            append(mut &jl, f.label)
        }
    }
    if len(jat) == 0 { return }
    for i in f0..len(a.fixes) {
        let f = a.fixes[i]
        if f.op == 0 || f.label < first { continue }
        var l = f.label
        var n = 0
        while n < 8 && a.labels[l] >= 0 {
            // the jmp at the label's position, if any
            let p = a.labels[l]
            var lo = 0
            var hi = len(jat)
            while lo < hi {
                let m = (lo + hi) / 2
                if jat[m] < p { lo = m + 1 } else { hi = m }
            }
            if lo == len(jat) || jat[lo] != p { break }
            let next = jl[lo]
            if next == l || next == f.label { break }
            l = next
            n += 1
        }
        if l != f.label { a.fixes[i].label = l }
    }
}

// Lays out a function's code, generated from position start since label first was made, in one
// pass: the prologue pro inserted at at (where the guards end), the pads before its loops
// (loopPad; tops[j] and ends[j] the positions of the loops' tops and ends in the order of the
// code, a loop's top before its inner loops'), and, when short, each jump to a label of the
// function in its 2-byte form (jmp rel8, jcc rel8) where its target is in reach. Making jumps
// short brings others into reach and moves the pads, so the reach is checked again until every
// short jump has it; a jump only ever goes from short to long, so that ends. The labels from first
// on, the remaining fix-ups and the relocations move with the code; the guards' labels (bound at
// at) go to the start of the prologue, which is returned. The short jumps are resolved here.
pub fn (a: mut &Asm) layout(start: int, at: int, pro: &[]byte, tops: &[]int, ends: &[]int, first: int, short: bool,
    guards: &[]int, lines: int): int {
    var f0 = len(a.fixes)
    while f0 > 0 && a.fixes[f0 - 1].at >= start { f0 -= 1 }
    if short { a.thread(f0, first) }
    // the jumps that may be short (fix-up indexes, in the order of the code) and their ends
    var js: []int = []
    var jend: []int = []
    if short {
        for i in f0..len(a.fixes) {
            let f = a.fixes[i]
            if f.op > 0 && f.label >= first && a.labels[f.label] >= 0 {
                append(mut &js, i)
                append(mut &jend, f.at + 4)
            }
        }
    }
    var isShort = array(len(js), true)
    var rel = array(len(js), 0)
    // the edits, each at a key (an old position) and moving the code from there: the savings of the
    // short jumps at their ends, the inserts (the prologue, then the pads) where they go
    var savKeys: []int = []
    var savSum: []int = [0]
    var insKeys: []int = []
    var insSum: []int = [0]
    var proStart = at
    var changed = true
    while changed {
        changed = false
        savKeys = []
        savSum = [0]
        for j in 0..len(js) {
            if isShort[j] {
                append(mut &savKeys, jend[j])
                append(mut &savSum, savSum[len(savSum) - 1] + (if a.fixes[js[j]].op == 1 { 3 } else { 4 }))
            }
        }
        insKeys = [at]
        insSum = [0, len(pro)]
        var last = at
        for j in 0..len(tops) {
            let t = tops[j]
            if t <= last { continue }
            let sv = savSum[upTo(&savKeys, t)]
            let now = t + insSum[len(insSum) - 1] - sv
            let size = ends[j] - t - (savSum[upTo(&savKeys, ends[j])] - sv)
            let inner = j + 1 == len(tops) || tops[j + 1] >= ends[j]
            let pad = loopPad(now, size, inner, lines)
            if pad == 0 { continue }
            append(mut &insKeys, t)
            append(mut &insSum, insSum[len(insSum) - 1] + pad)
            last = t
        }
        proStart = at - savSum[upTo(&savKeys, at)]
        var nsh = 0
        var ik = 0
        for j in 0..len(js) {
            if !isShort[j] { continue }
            nsh += 1
            let f = a.fixes[js[j]]
            let lp = a.labels[f.label]
            var tgt = lp + insSum[upTo(&insKeys, lp)] - savSum[upTo(&savKeys, lp)]
            for g in guards {
                if g == f.label { tgt = proStart }
            }
            // the jump's end (the short jumps up to this one end at or before it; an insert at the
            // end, a pad after the jump to a loop's test, follows it)
            let e = jend[j]
            while ik < len(insKeys) && insKeys[ik] < e { ik += 1 }
            let d = tgt - (e + insSum[ik] - savSum[nsh])
            if d < -128 || d > 127 {
                isShort[j] = false
                changed = true
            } else {
                rel[j] = d
            }
        }
    }
    // the pieces of code between the edits, each with its shift, and the edits' new places: a
    // prologue or pad (insert ii >= 0) or a short jump (-1 - j)
    let old = len(a.code)
    var segS: []int = []
    var segE: []int = []
    var segD: []int = []
    var fillAt: []int = []
    var fillOf: []int = []
    var fillOp: []byte = []         // a short jump's opcode (read before the code moves)
    var p = start
    var sh = 0
    var ii = 0
    var jj = 0
    while true {
        while jj < len(js) && !isShort[jj] { jj += 1 }
        var next = old
        if ii < len(insKeys) && insKeys[ii] < next { next = insKeys[ii] }
        let js0 = if jj < len(js) { a.fixes[js[jj]].at - a.fixes[js[jj]].op } else { old }
        if js0 < next { next = js0 }
        if next > p {
            append(mut &segS, p)
            append(mut &segE, next)
            append(mut &segD, sh)
        }
        p = next
        if ii < len(insKeys) && insKeys[ii] == p {
            append(mut &fillAt, p + sh)
            append(mut &fillOf, ii)
            append(mut &fillOp, 0)
            sh += insSum[ii + 1] - insSum[ii]
            ii += 1
        } else if jj < len(js) && js0 == p {
            let f = a.fixes[js[jj]]
            append(mut &fillAt, p + sh)
            append(mut &fillOf, -1 - jj)
            append(mut &fillOp, if f.op == 1 { byte(0xEB) } else { byte(0x70 + int(a.code[f.at - 1]) - 0x80) })
            sh -= if f.op == 1 { 3 } else { 4 }
            p = jend[jj]
            jj += 1
        } else {
            break
        }
    }
    // the pieces moved in place, each byte once: those that move left from the left, then those that
    // move right from the right (a piece's new place never covers a piece not yet moved)
    // (the code in a local while it moves: one load of its address)
    var c = replace(mut &a.code, [])
    if sh > 0 { bytesGrow(mut &c, sh) }
    for k in 0..len(segS) {
        let dk = segD[k]
        if dk < 0 {
            for i in segS[k]..segE[k] { c[i + dk] = c[i] }
        }
    }
    var k = len(segS) - 1
    while k >= 0 {
        let dk = segD[k]
        if dk > 0 {
            let s0 = segS[k]
            var i = segE[k] - 1
            while i >= s0 {
                c[i + dk] = c[i]
                i -= 1
            }
        }
        k -= 1
    }
    for q in 0..len(fillAt) {
        let w = fillAt[q]
        let x = fillOf[q]
        if x == 0 {
            for i in 0..len(pro) { c[w + i] = pro[i] }
        } else if x > 0 {
            let ns = nops(insSum[x + 1] - insSum[x])
            for i in 0..len(ns) { c[w + i] = ns[i] }
        } else {
            c[w] = fillOp[q]
            c[w + 1] = byte(rel[-1 - x] & 0xFF)
        }
    }
    if sh < 0 {
        for i in 0..-sh { pop(mut &c) }
    }
    a.code = c
    // the labels, fix-ups and relocations (the fix-ups and relocations in the order of the code)
    for l in first..len(a.labels) {
        let q = a.labels[l]
        if q >= 0 { a.labels[l] = q + insSum[upTo(&insKeys, q)] - savSum[upTo(&savKeys, q)] }
    }
    for g in guards { a.labels[g] = proStart }
    var w = f0
    jj = 0
    ii = 0
    var sk = 0
    for i in f0..len(a.fixes) {
        while jj < len(js) && js[jj] < i { jj += 1 }
        if jj < len(js) && js[jj] == i && isShort[jj] { continue }
        var f = a.fixes[i]
        while ii < len(insKeys) && insKeys[ii] <= f.at { ii += 1 }
        while sk < len(savKeys) && savKeys[sk] <= f.at { sk += 1 }
        f.at = f.at + insSum[ii] - savSum[sk]
        a.fixes[w] = f
        w += 1
    }
    while len(a.fixes) > w { pop(mut &a.fixes) }
    var r0 = len(a.relocs)
    while r0 > 0 && a.relocs[r0 - 1].at >= start { r0 -= 1 }
    ii = 0
    sk = 0
    for r in r0..len(a.relocs) {
        let q = a.relocs[r].at
        while ii < len(insKeys) && insKeys[ii] <= q { ii += 1 }
        while sk < len(savKeys) && savKeys[sk] <= q { sk += 1 }
        a.relocs[r].at = q + insSum[ii] - savSum[sk]
    }
    a.stEnd = -1
    a.nsEnd = -1
    a.jmpEnd = -1
    a.termEnd = -1
    return proStart
}

// Replaces the jmp to label l at position at with bytes (straight code: no jumps, no
// relocations), in the code generated since label first was made: the labels from first on
// bound after the jmp, and the jump fix-ups and relocations after it, move with the code; the
// jmp's fix-up goes. False, and nothing changed, when no jmp to l is at at.
pub fn (a: mut &Asm) replaceJmp(at: int, l: int, bytes: &[]byte, first: int): bool {
    if at + 5 > len(a.code) || a.code[at] != byte(0xE9) { return false }
    var fi = len(a.fixes) - 1
    while fi >= 0 && a.fixes[fi].at > at + 1 { fi -= 1 }
    if fi < 0 || a.fixes[fi].at != at + 1 || a.fixes[fi].label != l { return false }
    let n = len(bytes)
    let d = n - 5
    let old = len(a.code)
    if d > 0 {
        for i in 0..d { append(mut &a.code, 0) }
        var i = old - 1
        while i >= at + 5 {
            a.code[i + d] = a.code[i]
            i -= 1
        }
    } else if d < 0 {
        for i in at + 5..old { a.code[i + d] = a.code[i] }
        for i in 0..-d { pop(mut &a.code) }
    }
    for j in 0..n { a.code[at + j] = bytes[j] }
    for k in first..len(a.labels) {
        if a.labels[k] > at { a.labels[k] = a.labels[k] + d }
    }
    for k in fi + 1..len(a.fixes) {
        a.fixes[k - 1] = a.fixes[k]
        a.fixes[k - 1].at = a.fixes[k - 1].at + d
    }
    pop(mut &a.fixes)
    var k = len(a.relocs) - 1
    while k >= 0 && a.relocs[k].at > at {
        a.relocs[k].at = a.relocs[k].at + d
        k -= 1
    }
    a.stEnd = -1
    a.nsEnd = -1
    a.jmpEnd = -1
    a.termEnd = -1
    a.cmpEnd = -1
    return true
}

pub fn (a: mut &Asm) jcc(cc: int, l: int) {
    let keepCmp = a.cmpEnd == a.pos()
    a.b(0x0F)
    a.b(0x80 + cc)
    append(mut &a.fixes, Fix{at: a.pos(), label: l, base: -1, op: 2})
    a.d32(0)
    if keepCmp { a.cmpEnd = a.pos() }
}

// A jump table's entry: the 32-bit offset of label l from label base (bound at the table).
pub fn (a: mut &Asm) tableEntry(l: int, base: int) {
    append(mut &a.fixes, Fix{at: a.pos(), label: l, base: base, op: 0})
    a.d32(0)
}

// lea r, [rip + label l].
pub fn (a: mut &Asm) leaLabel(r: int, l: int) {
    a.lea(r, ripMem(0))
    append(mut &a.fixes, Fix{at: a.pos() - 4, label: l, base: -1, op: 0})
}

// bt dst, src: the carry flag is bit src of dst.
pub fn (a: mut &Asm) bt(dst: int, src: int) { a.rr(0, true, 0x0FA3, src, dst, false, false) }

// Whether the code at the current position can be reached (not right after a ret or jmp).
pub fn (a: &Asm) reachable(): bool { return a.termEnd != a.pos() }

pub fn (a: mut &Asm) jmp(l: int) {
    if a.peep && !a.reachable() { return }
    a.b(0xE9)
    append(mut &a.fixes, Fix{at: a.pos(), label: l, base: -1, op: 1})
    a.d32(0)
    a.jmpEnd = a.pos()
    a.jmpLabel = l
    a.termEnd = a.pos()
}

// call sym (a relocation).
pub fn (a: mut &Asm) callSym(sym: int) {
    a.b(0xE8)
    append(mut &a.relocs, Reloc{at: a.pos(), sym: sym, kind: R_REL32, addend: 0})
    a.d32(0)
}

// call [rip + sym]: an indirect call through the 8-byte slot sym (a GOT entry).
pub fn (a: mut &Asm) callAt(sym: int) {
    a.rm(0, false, 0xFF, 2, ripMem(0), false)
    append(mut &a.relocs, Reloc{at: a.pos() - 4, sym: sym, kind: R_REL32, addend: 0})
}

// mov r, [rip + sym]: the 8 bytes of the slot sym.
pub fn (a: mut &Asm) loadAt(r: int, sym: int) {
    a.load(8, r, ripMem(0))
    append(mut &a.relocs, Reloc{at: a.pos() - 4, sym: sym, kind: R_REL32, addend: 0})
}

// A 32-bit absolute-address field for sym + addend at the current position (the disp32 of
// an absMem operand is the last 4 bytes of the instruction when it has no immediate).
pub fn (a: mut &Asm) relocAbs32(at: int, sym: int, addend: int) {
    append(mut &a.relocs, Reloc{at: at, sym: sym, kind: R_ABS32, addend: addend})
}

// n bytes of nops (n <= 15): the recommended multi-byte nops, at most 8 bytes each.
pub fn nops(n: int): []byte {
    let forms: [][]byte = [[0x90], [0x66, 0x90], [0x0F, 0x1F, 0x00], [0x0F, 0x1F, 0x40, 0x00],
        [0x0F, 0x1F, 0x44, 0x00, 0x00], [0x66, 0x0F, 0x1F, 0x44, 0x00, 0x00],
        [0x0F, 0x1F, 0x80, 0x00, 0x00, 0x00, 0x00], [0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00]]
    var out: []byte = []
    var left = n
    while left > 0 {
        let k = if left > 8 { 8 } else { left }
        for b in forms[k - 1] { append(mut &out, b) }
        left -= k
    }
    return out
}

// Resolves the jumps to labels; every label used must be bound.
pub fn (a: mut &Asm) fixLabels() {
    for i in 0..len(a.fixes) {
        let f = a.fixes[i]
        let t = a.labels[f.label]
        if t < 0 { panic("x64: unbound label") }
        a.put32(f.at, if f.base >= 0 { t - a.labels[f.base] } else { t - (f.at + 4) })
    }
    a.fixes = []
}

// ---------------------------------------------------------------- the encoder test

fn words(s: &str): []str {
    var out: []str = []
    var start = -1
    for i in 0..len(s) + 1 {
        let sp = i == len(s) || strByte(s, i) == ' '
        if sp && start >= 0 {
            append(mut &out, s[start..i].clone())
            start = -1
        } else if !sp && start < 0 {
            start = i
        }
    }
    return out
}

fn num(s: &str): int {
    var i = 0
    var neg = false
    if strByte(s, 0) == '-' {
        neg = true
        i = 1
    }
    var v = 0
    while i < len(s) {
        v = v * 10 + int(strByte(s, i) - '0')
        i += 1
    }
    return if neg { -v } else { v }
}

// m:base,index,scale,disp
fn memOf(s: &str): Mem {
    var ps: []int = []
    var start = 2
    for i in 2..len(s) + 1 {
        if i == len(s) || strByte(s, i) == ',' {
            append(mut &ps, num(s[start..i]))
            start = i + 1
        }
    }
    return Mem{base: ps[0], index: ps[1], scale: ps[2], disp: ps[3]}
}

const ALU_NAMES: []str = ["add", "or", "adc", "sbb", "and", "sub", "xor", "cmp"]
const UN_NAMES: []str = ["", "", "not", "neg", "mul", "imul", "div", "idiv"]
const SH_NAMES: []str = ["", "", "", "", "shl", "shr", "", "sar"]

fn nameIndex(names: &[str], n: &str): int {
    for i in 0..len(names) {
        if names[i] == n { return i }
    }
    panic("x64 test: unknown name " + n)
}

const SSE_NAMES: []str = ["addsd", "mulsd", "subsd", "divsd", "sqrtsd", "movsd"]
const SSE_OPS: []int = [0x58, 0x59, 0x5C, 0x5E, 0x51, 0x10]

// One instruction of the test format (operands are numbers; m: is a memory operand):
//   alu OP SIZE DST SRC | alui OP SIZE DST IMM | alum OP SIZE DST MEM | test SIZE A B
//   mov SIZE DST SRC | load SIZE DST MEM | store SIZE MEM SRC | storei SIZE MEM IMM
//   loadzx SIZE DST MEM | loadsx SIZE DST MEM | zx SIZE DST SRC | sx SIZE DST SRC
//   lea DST MEM | movri R IMM | imul SIZE DST SRC | un OP SIZE R | shcl OP SIZE R
//   shi OP SIZE R N | setcc CC R | cmov CC DST SRC | push R | pop R | callr R | jmpr R
//   shld DST SRC | shrd DST SRC
//   ret | leave | cqo | cdq | movsb | stosb | ud2 | sse OP X Y | ucomisd X Y | xorpd X Y
//   movsdload X MEM | movsdstore MEM X | movdquload X MEM | movdqustore MEM X | movqxr X R | movqrx R X | cvtsi2sd X R
//   cvttsd2si R X
fn (a: mut &Asm) testLine(l: &str) {
    let w = words(l)
    if len(w) == 0 { return }
    let k = w[0].clone()
    if k == "alu" {
        a.alu(nameIndex(ALU_NAMES, &w[1]), num(&w[2]), num(&w[3]), num(&w[4]))
    } else if k == "alui" {
        a.aluI(nameIndex(ALU_NAMES, &w[1]), num(&w[2]), num(&w[3]), num(&w[4]))
    } else if k == "alum" {
        a.aluRM(nameIndex(ALU_NAMES, &w[1]), num(&w[2]), num(&w[3]), memOf(&w[4]))
    } else if k == "alumr" {
        a.aluMR(nameIndex(ALU_NAMES, &w[1]), num(&w[2]), memOf(&w[3]), num(&w[4]))
    } else if k == "alumi" {
        a.aluMI(nameIndex(ALU_NAMES, &w[1]), num(&w[2]), memOf(&w[3]), num(&w[4]))
    } else if k == "test" {
        a.test(num(&w[1]), num(&w[2]), num(&w[3]))
    } else if k == "mov" {
        a.movRR(num(&w[1]), num(&w[2]), num(&w[3]))
    } else if k == "load" {
        a.load(num(&w[1]), num(&w[2]), memOf(&w[3]))
    } else if k == "store" {
        a.store(num(&w[1]), memOf(&w[2]), num(&w[3]))
    } else if k == "storei" {
        a.storeI(num(&w[1]), memOf(&w[2]), num(&w[3]))
    } else if k == "loadzx" {
        a.loadZX(num(&w[1]), num(&w[2]), memOf(&w[3]))
    } else if k == "loadsx" {
        a.loadSX(num(&w[1]), num(&w[2]), memOf(&w[3]))
    } else if k == "zx" {
        a.zx(num(&w[1]), num(&w[2]), num(&w[3]))
    } else if k == "sx" {
        a.sx(num(&w[1]), num(&w[2]), num(&w[3]))
    } else if k == "lea" {
        a.lea(num(&w[1]), memOf(&w[2]))
    } else if k == "movri" {
        a.movRI(num(&w[1]), num(&w[2]))
    } else if k == "imul" {
        a.imul(num(&w[1]), num(&w[2]), num(&w[3]))
    } else if k == "imuli" {
        a.imulI(num(&w[1]), num(&w[2]), num(&w[3]), num(&w[4]))
    } else if k == "un" {
        a.unary(nameIndex(UN_NAMES, &w[1]), num(&w[2]), num(&w[3]))
    } else if k == "shcl" {
        a.shiftCL(nameIndex(SH_NAMES, &w[1]), num(&w[2]), num(&w[3]))
    } else if k == "shi" {
        a.shiftI(nameIndex(SH_NAMES, &w[1]), num(&w[2]), num(&w[3]), num(&w[4]))
    } else if k == "shld" {
        a.shldCL(num(&w[1]), num(&w[2]))
    } else if k == "shrd" {
        a.shrdCL(num(&w[1]), num(&w[2]))
    } else if k == "shldi" {
        a.shldI(num(&w[1]), num(&w[2]), num(&w[3]))
    } else if k == "shrdi" {
        a.shrdI(num(&w[1]), num(&w[2]), num(&w[3]))
    } else if k == "setcc" {
        a.setcc(num(&w[1]), num(&w[2]))
    } else if k == "cmov" {
        a.cmov(num(&w[1]), num(&w[2]), num(&w[3]))
    } else if k == "push" {
        a.push(num(&w[1]))
    } else if k == "pop" {
        a.pop(num(&w[1]))
    } else if k == "callr" {
        a.callR(num(&w[1]))
    } else if k == "jmpr" {
        a.jmpR(num(&w[1]))
    } else if k == "ret" {
        a.ret()
    } else if k == "leave" {
        a.leave()
    } else if k == "cqo" {
        a.cqo()
    } else if k == "cdq" {
        a.cdq()
    } else if k == "movsb" {
        a.repMovsb()
    } else if k == "stosb" {
        a.repStosb()
    } else if k == "stos" {
        a.repStos(num(&w[1]))
    } else if k == "ud2" {
        a.ud2()
    } else if k == "sse" {
        a.sse(SSE_OPS[nameIndex(SSE_NAMES, &w[1])], num(&w[2]), num(&w[3]))
    } else if k == "ucomisd" {
        a.sse66(UCOMISD, num(&w[1]), num(&w[2]))
    } else if k == "xorpd" {
        a.sse66(XORPD, num(&w[1]), num(&w[2]))
    } else if k == "movsdload" {
        a.movsdLoad(num(&w[1]), memOf(&w[2]))
    } else if k == "movsdstore" {
        a.movsdStore(memOf(&w[1]), num(&w[2]))
    } else if k == "movdquload" {
        a.movdquLoad(num(&w[1]), memOf(&w[2]))
    } else if k == "movdqustore" {
        a.movdquStore(memOf(&w[1]), num(&w[2]))
    } else if k == "movqxr" {
        a.movqXR(num(&w[1]), num(&w[2]))
    } else if k == "movqrx" {
        a.movqRX(num(&w[1]), num(&w[2]))
    } else if k == "cvtsi2sd" {
        a.cvtsi2sd(num(&w[1]), num(&w[2]))
    } else if k == "cvttsd2si" {
        a.cvttsd2si(num(&w[1]), num(&w[2]))
    } else {
        panic("x64 test: unknown instruction " + k)
    }
}

// The bytes of each instruction of text (one per line), in hex, one line each.
pub fn runTest(text: &str): str {
    var out = ""
    let hex = "0123456789abcdef"
    for l in strings.splitByte(&text, '\n') {
        if len(strings.trim(&l)) == 0 { continue }
        var a = newAsm()
        a.testLine(&l)
        for x in a.code {
            out.addByte(strByte(hex, int(x >> 4)))
            out.addByte(strByte(hex, int(x & 15)))
        }
        out.addByte('\n')
    }
    return out
}
