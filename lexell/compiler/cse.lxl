// cse: loads and checked element addresses repeated in straight-line code, in the IR after
// loops and before the native backend (design/native.md, section 4).
//
// A run is a stretch of statements that write no memory and call nothing but the runtime's
// reading functions (bounds and arithmetic checks, conversions, a string's bytes or
// comparison): declarations, assignments of locals, conditions, returns. Along a run, a
// place's value read through memory (`(*p_e)->f_c->f_x`, two loads or more) or an element's
// address with its bounds check (`(T*)a.data + rt_idx(i, a.len, w)`) that an earlier
// statement surely evaluated is read again from a local: the first evaluation becomes `(t =
// X)` where it stands, so nothing moves and every check happens where it did, and the later
// ones `t`. The value is the same because nothing in between writes memory, and no local it
// names was assigned in between (copies of locals, `ix = n`, stand for what they copy).
// Element addresses compare without their checks' locations: a later check of the same
// index against the same length cannot fail where the first passed.
//
// What a run surely evaluated: not what is in the right of `&&` or `||` or the arms of `?:`,
// nor in a branch of an if (available in the branch, and after the if only from a branch
// that cannot fall through, whose returns end it); a loop, a case label, a statement that
// writes memory or calls the program end the run (what is inside starts runs of its own).
// Within one statement nothing is reused (the native backend's order of evaluation is its
// own). LXL_CSE=0 turns the pass off; LXL_CSE=v prints the count.
//
// An element address that is arithmetic on locals alone (addrOnly: `d + i * 56`, the data
// pointer a local, no load, every local's address never taken) reads no memory, so a statement
// that writes memory or calls the program does not change it, only an assignment of one of its
// locals: it stays available across stores (killMem), and a store's own place and value are
// visited. It is worth a local when its element size is not one an addressing mode scales by
// (1, 2, 4, 8: the native backend multiplies for the others, at every use).

import "strings"

import "./ir"
import "os"

const MAX_AVAIL = 48

// A node's kind and operands (a copy without its string).
type Kids = value record {
    k: int
    a: int
    b: int
    c: int
    d: int
}

type Avail = value record {
    x: int          // the first evaluation (a node, rewritten in place when reused)
    h: int          // its hash
    t: int          // the local holding it once reused, else -1
    blk: int        // the block (an index of blks) and statement before which t is declared
    at: int
    sid: int        // the statement it is in
    dead: bool      // something it reads may have changed
    mask: int       // a bit per local it names (by canon, mod 62)
    held: bool      // made by held (not counted against MAX_AVAIL's candidates)
    addr: bool      // pure address arithmetic (addrOnly): reads no memory, so stores leave it
}

type Cse = record {
    u: ir.Ir
    pureFn: []bool          // per runtime function: reads only (no memory written)
    idxFn: int              // rt_idx
    glueKind: []int         // per function: 0 none, 1 enum drop, 2 enum dup/clone
    glueMask: []int         // per function: bitmask of active (non-POD) enum tags (0..62)
    taken: []bool           // per local: its address is taken (in the function being done)
    canon: []int            // per local: the local whose value it copies (-1: its own)
    copies: []int           // the locals with a canon
    avail: []Avail
    blks: [][]int           // per open block: pairs (statement index, declaration) to insert
    cb: int                 // the block and statement being done, its id
    cp: int
    sid: int
    n: int                  // reuses
    dry: bool
    inCand: int             // visit: the candidates (cand) the expression being visited is in
    nHeld: int              // the entries of avail that held made (at most MAX_AVAIL of them)
}

// The program p with repeated loads in straight-line code read once.
pub fn optimize(p: ir.Ir): ir.Ir {
    let ev = os.envOr("LXL_CSE", "")
    if ev == "0" { return p }
    var o = Cse{u: p, pureFn: [], idxFn: -1, glueKind: [], glueMask: [], taken: [], canon: [], copies: [], avail: [], blks: [], cb: -1, cp: 0, sid: 0, n: 0, dry: ev == "dry", inCand: 0, nHeld: 0}
    for f in 0..o.u.nRtFuncs {
        let name = o.u.funcs[f].name.clone()
        append(mut &o.pureFn, pureName(&name))
        if name == "rt_idx" { o.idxFn = f }
    }
    o.marks()
    o.findPodGlues()
    for f in o.u.nRtFuncs..len(o.u.funcs) {
        let b = o.u.funcs[f].body
        if b >= 0 {
            if !o.dry {
                o.elidePodGlue(b)
                o.hoistDeref(f)
            }
            o.function(b)
        }
    }
    if ev == "v" { eprintln("cse: " + intToStr(o.n) + " reuses") }
    return replace(mut &o.u, ir.newIr())
}

fn (o: &Cse) kids(x: int): Kids {
    let n = &o.u.nodes[x]
    return Kids{k: n.k, a: n.a, b: n.b, c: n.c, d: n.d}
}

fn pureName(name: &str): bool {
    if name == "rt_idx" || name == "rt_str_byte" || name == "rt_str_eq" || name == "rt_str_cmp" { return true }
    if len(name) < 8 { return false }
    if strings.startsWith(&name, "rt_cvs_") || strings.startsWith(&name, "rt_cvu_") { return true }
    let o4 = name[3..7]
    let o5 = name[3..8]
    return o4 == "add_" || o4 == "sub_" || o4 == "mul_" || o4 == "div_" || o4 == "rem_" || o4 == "neg_" ||
        o4 == "shl_" || o4 == "shr_" || o5 == "wadd_" || o5 == "wsub_" || o5 == "wmul_"
}

fn (o: mut &Cse) function(body: int) {
    o.avail = []
    o.nHeld = 0
    o.resetCanon()
    o.u.nodes[body].a = o.seq(o.u.nodes[body].a)
}

// The locals whose addresses are taken anywhere (a local belongs to one function): every
// E_ADDR and E_DECAY node of the program, whichever function it is in (nodes no function
// reaches any more mark too much, which is safe).
fn (o: mut &Cse) marks() {
    for l in 0..len(o.u.locals) {
        append(mut &o.taken, false)
        append(mut &o.canon, -1)
    }
    for x in 0..len(o.u.nodes) {
        let k = o.u.nodes[x].k
        if k == ir.E_ADDR || k == ir.E_DECAY {
            var r = o.u.nodes[x].a
            while o.u.nodes[r].k == ir.E_MEMBER { r = o.u.nodes[r].a }
            if o.u.nodes[r].k == ir.E_LOCAL { o.taken[o.u.nodes[r].a] = true }
        }
    }
}

// ---------------------------------------------------------------- runs

// The statements of the list l done in order; the list with the declarations of new locals
// inserted (or l).
fn (o: mut &Cse) seq(l: int): int {
    if l < 0 { return l }
    append(mut &o.blks, [])
    let bi = len(o.blks) - 1
    let n0 = len(o.avail)
    let cnt = o.u.listLen(l)
    for i in 0..cnt {
        o.stmt(o.u.listAt(l, i), bi, i)
    }
    o.cut(n0)
    let ins = pop(mut &o.blks)
    if len(ins) == 0 { return l }
    var xs: []int = []
    for i in 0..cnt {
        var j = 0
        while j < len(ins) {
            if ins[j] == i { append(mut &xs, ins[j + 1]) }
            j += 2
        }
        append(mut &xs, o.u.listAt(l, i))
    }
    return o.u.list(&xs)
}

// A body (a block, or one statement): done as a list of its own; the statement to put there.
fn (o: mut &Cse) body(x: int): int {
    if x < 0 { return x }
    if o.u.nk(x) == ir.S_BLOCK {
        o.u.nodes[x].a = o.seq(o.u.nodes[x].a)
        return x
    }
    let one: []int = [x]
    let l = o.u.list(&one)
    let l2 = o.seq(l)
    if l2 == l { return x }
    append(mut &o.u.nodes, ir.Node{k: ir.S_BLOCK, ty: ir.TY_VOID, line: o.u.nodes[x].line, a: l2, b: -1, c: -1, d: -1, v: 0})
    return len(o.u.nodes) - 1
}

fn (o: mut &Cse) cut(n: int) {
    while len(o.avail) > n {
        if pop(mut &o.avail).held { o.nHeld -= 1 }
    }
}

fn (o: mut &Cse) killAll() {
    for i in 0..len(o.avail) { o.avail[i].dead = true }
}

// Memory written (a store, a call): what reads memory is no longer known; pure address
// arithmetic of locals stays.
fn (o: mut &Cse) killMem() {
    for i in 0..len(o.avail) {
        if !o.avail[i].addr { o.avail[i].dead = true }
    }
}

fn (o: mut &Cse) resetCanon() {
    let cs = replace(mut &o.copies, [])
    for l in cs { o.canon[l] = -1 }
}

fn (o: &Cse) canonOf(l: int): int { return if o.canon[l] >= 0 { o.canon[l] } else { l } }

// Local l written: what names it (or a copy of it) is no longer known, and copies of it no
// longer are.
fn (o: mut &Cse) killLocal(l: int) {
    let bit = 1 << (l % 62)
    for i in 0..len(o.avail) {
        if !o.avail[i].dead && o.avail[i].mask & bit != 0 && o.names(o.avail[i].x, l) { o.avail[i].dead = true }
        if o.avail[i].t == l { o.avail[i].dead = true }        // the local holding it (held)
    }
    if o.canon[l] >= 0 { o.canon[l] = -1 }
    for j in 0..len(o.copies) {
        let m = o.copies[j]
        if o.canon[m] == l { o.canon[m] = -1 }
    }
}

fn (o: &Cse) maskOf(x: int): int {
    if x < 0 { return 0 }
    let n = &o.u.nodes[x]
    if n.k == ir.E_LOCAL { return (1 << (n.a % 62)) | (1 << (o.canonOf(n.a) % 62)) }
    if n.k == ir.E_CALL {
        var m = 0
        for j in 0..o.u.listLen(n.b) { m = m | o.maskOf(o.u.listAt(n.b, j)) }
        return m
    }
    if n.k == ir.E_INT || n.k == ir.E_STR || n.k == ir.E_GLOBAL || n.k == ir.E_FUNC || n.k == ir.E_FLT { return 0 }
    return o.maskOf(n.a) | o.maskOf(n.b)
}

fn (o: &Cse) names(x: int, l: int): bool {
    if x < 0 { return false }
    let n = &o.u.nodes[x]
    if n.k == ir.E_LOCAL { return n.a == l || o.canonOf(n.a) == l }
    if n.k == ir.E_CALL {
        for j in 0..o.u.listLen(n.b) {
            if o.names(o.u.listAt(n.b, j), l) { return true }
        }
        return false
    }
    if n.k == ir.E_INT || n.k == ir.E_STR || n.k == ir.E_GLOBAL || n.k == ir.E_FUNC || n.k == ir.E_FLT { return false }
    return o.names(n.a, l) || o.names(n.b, l)
}

fn (o: mut &Cse) stmt(s: int, bi: int, i: int) {
    o.sid += 1
    o.cb = bi
    o.cp = i
    let n = o.kids(s)
    let k = n.k
    if k == ir.S_DECL {
        if n.c >= 0 || (n.b >= 0 && !o.calm(n.b)) {
            o.killMem()
            o.killAssigned(n.b)
            o.killAssignedList(n.c)
            o.killLocal(n.a)
            return
        }
        o.visit(n.b, false, false)
        o.killLocal(n.a)
        o.held(n.a, n.b)
        if n.b >= 0 && o.u.nk(n.b) == ir.E_LOCAL && !o.taken[n.a] && !o.taken[o.u.nodes[n.b].a] &&
            o.u.nodes[n.b].ty == o.u.locals[n.a].ty {
            o.canon[n.a] = o.canonOf(o.u.nodes[n.b].a)
            append(mut &o.copies, n.a)
        }
    } else if k == ir.S_EXPR {
        let e = n.a
        if o.u.nk(e) == ir.E_ASSIGN && o.u.nk(o.u.nodes[e].a) == ir.E_LOCAL && !o.taken[o.u.nodes[o.u.nodes[e].a].a] &&
            o.calm(o.u.nodes[e].b) {
            o.visit(o.u.nodes[e].b, false, false)
            o.killLocal(o.u.nodes[o.u.nodes[e].a].a)
        } else if o.calm(e) {
            o.visit(e, false, false)
        } else if o.u.nk(e) == ir.E_ASSIGN && o.calm(o.u.nodes[e].b) && o.calm(o.u.nodes[e].a) {
            // a store: its value, then its place's address, read before memory changes
            o.visit(o.u.nodes[e].b, false, false)
            o.visit(o.u.nodes[e].a, false, true)
            o.killMem()
        } else {
            o.killMem()
            o.killAssigned(e)
        }
    } else if k == ir.S_RETURN {
        if n.a >= 0 && o.calm(n.a) { o.visit(n.a, false, false) }
        o.killAll()
    } else if k == ir.S_IF {
        if !o.calm(n.a) {
            o.killAll()
            o.killAssigned(n.a)
            o.u.nodes[s].b = o.body(n.b)
            o.killAll()
            o.u.nodes[s].c = o.body(n.c)
            o.killAll()
            return
        }
        o.visit(n.a, false, false)
        let na = len(o.avail)
        let before = o.deads()
        let b = o.body(n.b)
        o.u.nodes[s].b = b
        var after = o.deads()
        if !o.falls(b) {
            for j in 0..len(after) { after[j] = before[j] }
        }
        o.setDeads(&before)
        let c = o.body(n.c)
        o.u.nodes[s].c = c
        if c < 0 || o.falls(c) {
            let dc = o.deads()
            for j in 0..len(after) { after[j] = after[j] || dc[j] }
        }
        o.cut(na)
        o.setDeads(&after)
    } else if k == ir.S_BLOCK {
        let n0 = len(o.avail)
        o.u.nodes[s].a = o.seq(n.a)
        o.cut(n0)
    } else if k == ir.S_WHILE || k == ir.S_SWITCH {
        o.killAll()
        o.resetCanon()
        o.u.nodes[s].b = o.body(n.b)
        o.killAll()
        o.resetCanon()
    } else if k == ir.S_FOR {
        o.killAll()
        o.resetCanon()
        o.u.nodes[s].d = o.body(n.d)
        o.killAll()
        o.resetCanon()
    } else if k == ir.S_EMPTY {
    } else {
        // break, continue, case labels
        o.killAll()
        o.resetCanon()
    }
}

// The locals the expression x assigns (or increments) forgotten.
fn (o: mut &Cse) killAssigned(x: int) {
    if x < 0 { return }
    let n = o.kids(x)
    let k = n.k
    if k == ir.E_ASSIGN || k == ir.E_POSTINC {
        var r = n.a
        while o.u.nk(r) == ir.E_MEMBER { r = o.u.nodes[r].a }
        if o.u.nk(r) == ir.E_LOCAL { o.killLocal(o.u.nodes[r].a) }
    }
    if k == ir.E_CALL || k == ir.E_CLIT {
        o.killAssigned(n.a)
        o.killAssignedList(n.b)
    } else if k != ir.E_INT && k != ir.E_FLT && k != ir.E_STR && k != ir.E_LOCAL && k != ir.E_GLOBAL && k != ir.E_FUNC {
        o.killAssigned(n.a)
        o.killAssigned(n.b)
        o.killAssigned(n.c)
    }
}

fn (o: mut &Cse) killAssignedList(l: int) {
    if l < 0 { return }
    for j in 0..o.u.listLen(l) { o.killAssigned(o.u.listAt(l, j)) }
}

fn (o: &Cse) deads(): []bool {
    var ds: []bool = []
    for a in o.avail { append(mut &ds, a.dead) }
    return ds
}

fn (o: mut &Cse) setDeads(ds: &[]bool) {
    for j in 0..len(o.avail) {
        if j < len(ds) { o.avail[j].dead = ds[j] }
    }
}

fn (o: &Cse) falls(s: int): bool {
    if s < 0 { return true }
    let k = o.u.nk(s)
    if k == ir.S_BREAK || k == ir.S_CONTINUE || k == ir.S_RETURN { return false }
    if k == ir.S_BLOCK {
        let l = o.u.nodes[s].a
        let c = o.u.listLen(l)
        return c == 0 || o.falls(o.u.listAt(l, c - 1))
    }
    if k == ir.S_IF {
        let e = o.u.nodes[s].c
        return e < 0 || o.falls(o.u.nodes[s].b) || o.falls(e)
    }
    return true
}

// Whether evaluating the expression x writes no memory and no local.
fn (o: &Cse) calm(x: int): bool {
    if x < 0 { return true }
    let n = &o.u.nodes[x]
    let k = n.k
    if k == ir.E_ASSIGN || k == ir.E_POSTINC { return false }
    if k == ir.E_CALL {
        let f = o.rtFn(x)
        if f < 0 || !o.pureFn[f] { return false }
        for j in 0..o.u.listLen(n.b) {
            if !o.calm(o.u.listAt(n.b, j)) { return false }
        }
        return true
    }
    if k == ir.E_CLIT {
        for j in 0..o.u.listLen(n.b) {
            if !o.calm(o.u.listAt(n.b, j)) { return false }
        }
        return true
    }
    if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_FUNC { return true }
    return o.calm(n.a) && o.calm(n.b) && o.calm(n.c)
}

fn (o: &Cse) rtFn(x: int): int {
    let c = o.u.nodes[x].a
    if o.u.nk(c) != ir.E_DECAY || o.u.nk(o.u.nodes[c].a) != ir.E_FUNC { return -1 }
    let f = o.u.nodes[o.u.nodes[c].a].a
    return if f < o.u.nRtFuncs { f } else { -1 }
}

// ---------------------------------------------------------------- expressions

// The calm expression x, in the order it is evaluated: cond, in a part that may not be
// evaluated; lv, x is a place (not read as a value).
fn (o: mut &Cse) visit(x: int, cond: bool, lv: bool) {
    if x < 0 { return }
    let k = o.u.nodes[x].k
    let cd = !lv && o.cand(x)
    if cd || (!lv && o.inCand == 0 && o.oneLoad(x)) {
        // one load is looked for (held may have it in a local) but not made available here, nor
        // reused inside a larger candidate (which then would not compare the same as itself later)
        let h = o.hash(x)
        for i in 0..len(o.avail) {
            let a = o.avail[i]
            if !a.dead && a.h == h && a.sid != o.sid && o.same(a.x, x) {
                o.reuse(i, x)
                return
            }
        }
        if cd && !cond && len(o.avail) - o.nHeld < MAX_AVAIL {
            append(mut &o.avail, Avail{x: x, h: h, t: -1, blk: o.cb, at: o.cp, sid: o.sid, dead: false, mask: o.maskOf(x), held: false,
                addr: o.u.nk(x) == ir.E_PADD && o.addrOnly(x)})
        }
    }
    if cd { o.inCand += 1 }
    o.kidsOf(x, k, cond)
    if cd { o.inCand -= 1 }
}

fn (o: mut &Cse) kidsOf(x: int, k: int, cond: bool) {
    let a = o.u.nodes[x].a
    let b = o.u.nodes[x].b
    if k == ir.E_MEMBER || k == ir.E_ADDR || k == ir.E_DECAY {
        o.visit(a, cond, true)
    } else if k == ir.E_LAND || k == ir.E_LOR {
        o.visit(a, cond, false)
        o.visit(b, true, false)
    } else if k == ir.E_COND {
        o.visit(a, cond, false)
        o.visit(b, true, false)
        o.visit(o.u.nodes[x].c, true, false)
    } else if k == ir.E_CALL || k == ir.E_CLIT {
        for j in 0..o.u.listLen(b) { o.visit(o.u.listAt(b, j), cond, false) }
    } else if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_FUNC {
    } else {
        o.visit(a, cond, false)
        o.visit(b, cond, false)
    }
}

// `T t = X;` with X one load of a scalar (`*(p + i)`, `s->f`: not worth a local of its own, cand)
// and t a local whose address is never taken, of X's type: X is available in t (its holder) for
// the rest of t's block, until t, a local X names or memory may change. A later X in the run
// reads t: no new local, the load not repeated (a byte tested in both arms of a branch).
fn (o: mut &Cse) held(t: int, x: int) {
    if x < 0 || o.taken[t] || o.nHeld >= MAX_AVAIL || !o.oneLoad(x) { return }
    if o.u.nodes[x].ty != o.u.locals[t].ty || o.names(x, t) { return }
    append(mut &o.avail, Avail{x: x, h: o.hash(x), t: t, blk: o.cb, at: o.cp, sid: o.sid, dead: false, mask: o.maskOf(x), held: true,
        addr: false})
    o.nHeld += 1
}

// Whether x is a scalar read through exactly one load (no bounds check, no call but checks).
fn (o: &Cse) oneLoad(x: int): bool {
    let k = o.u.nk(x)
    if k != ir.E_MEMBER && k != ir.E_DEREF { return false }
    let tk = o.u.tk(o.u.nodes[x].ty)
    if !(tk >= ir.TY_BOOL && tk <= ir.TY_U64 || tk == ir.TY_PTR) { return false }
    var loads = 0
    var idx = false
    return o.plain(x, mut &loads, mut &idx) && loads == 1 && !idx
}

// Whether x is worth a local: a scalar or pointer (no float, no 128-bit integer) read through
// two loads or more, or an address with a bounds check, with no call but checks.
fn (o: &Cse) cand(x: int): bool {
    let k = o.u.nk(x)
    if k != ir.E_MEMBER && k != ir.E_DEREF && k != ir.E_PADD { return false }
    let tk = o.u.tk(o.u.nodes[x].ty)
    if !(tk >= ir.TY_BOOL && tk <= ir.TY_U64 || tk == ir.TY_PTR) { return false }
    var loads = 0
    var idx = false
    if !o.plain(x, mut &loads, mut &idx) { return false }
    if loads >= 2 || idx { return true }
    if loads == 1 && k == ir.E_DEREF && o.u.nk(o.u.nodes[x].a) == ir.E_LOCAL &&
        tk == ir.TY_PTR && !o.taken[o.u.nodes[o.u.nodes[x].a].a] {
        return true
    }
    let sc = o.u.nodes[x].v
    return k == ir.E_PADD && sc != 1 && sc != 2 && sc != 4 && sc != 8 && o.addrOnly(x)
}

// Whether x is address arithmetic on locals alone (no load, no call but the pure runtime
// functions, every local's address never taken): no store or call changes its value.
fn (o: &Cse) addrOnly(x: int): bool {
    if x < 0 { return true }
    let n = &o.u.nodes[x]
    let k = n.k
    if k == ir.E_INT { return true }
    if k == ir.E_LOCAL { return !o.taken[n.a] }
    if k == ir.E_CALL {
        let f = o.rtFn(x)
        if f < 0 || !o.pureFn[f] { return false }
        for j in 0..o.u.listLen(n.b) {
            if !o.where(n.b, j) && !o.addrOnly(o.u.listAt(n.b, j)) { return false }
        }
        return true
    }
    if k == ir.E_CAST || k == ir.E_NEG { return o.addrOnly(n.a) }
    if k == ir.E_BIN || k == ir.E_PADD { return o.addrOnly(n.a) && o.addrOnly(n.b) }
    return false
}

// Whether x is made of locals, globals, constants, members, loads, casts, arithmetic and the
// runtime's pure functions; counts its loads and bounds checks.
fn (o: &Cse) plain(x: int, loads: mut &int, idx: mut &bool): bool {
    if x < 0 { return true }
    let n = &o.u.nodes[x]
    let k = n.k
    if k == ir.E_LOCAL || k == ir.E_INT || k == ir.E_GLOBAL || k == ir.E_STR { return true }
    if k == ir.E_DEREF {
        loads += 1
        return o.plain(n.a, loads, idx)
    }
    if k == ir.E_CALL {
        let f = o.rtFn(x)
        if f < 0 || !o.pureFn[f] { return false }
        if f == o.idxFn { idx = true }
        for j in 0..o.u.listLen(n.b) {
            if !o.plain(o.u.listAt(n.b, j), loads, idx) { return false }
        }
        return true
    }
    if k == ir.E_MEMBER || k == ir.E_CAST || k == ir.E_NEG || k == ir.E_BNOT || k == ir.E_DECAY || k == ir.E_ADDR {
        return o.plain(n.a, loads, idx)
    }
    if k == ir.E_BIN || k == ir.E_PADD { return o.plain(n.a, loads, idx) && o.plain(n.b, loads, idx) }
    return false
}

// A check's location (the last argument of a runtime call, a string) is not part of its value.
fn (o: &Cse) where(l: int, j: int): bool {
    let w = o.u.listAt(l, j)
    return j == o.u.listLen(l) - 1 && j > 0 && o.u.nk(w) == ir.E_DECAY && o.u.nk(o.u.nodes[w].a) == ir.E_STR
}

fn (o: &Cse) hash(x: int): int {
    let n = &o.u.nodes[x]
    var h = (n.k *% 1000003) +% (n.ty *% 8191) +% n.v
    if n.k == ir.E_LOCAL { return ((h *% 31) +% o.canonOf(n.a)) & 0x3fffffffffffffff }
    if n.k == ir.E_GLOBAL || n.k == ir.E_FUNC { return ((h *% 31) +% n.a) & 0x3fffffffffffffff }
    if n.k == ir.E_INT { return h & 0x3fffffffffffffff }
    if n.k == ir.E_STR { return ((h *% 31) +% int(o.u.strs[n.v].hash())) & 0x3fffffffffffffff }
    if n.k == ir.E_CALL {
        h = (h *% 31) +% o.hash(n.a)
        for j in 0..o.u.listLen(n.b) {
            if !o.where(n.b, j) { h = (h *% 31) +% o.hash(o.u.listAt(n.b, j)) }
        }
        return h & 0x3fffffffffffffff
    }
    h = (h *% 31) +% (if n.a >= 0 { o.hash(n.a) } else { 0 })
    h = (h *% 31) +% (if n.b >= 0 { o.hash(n.b) } else { 0 })
    return h & 0x3fffffffffffffff
}

fn (o: &Cse) same(x: int, y: int): bool {
    if x < 0 || y < 0 { return x == y }
    let a = &o.u.nodes[x]
    let b = &o.u.nodes[y]
    if a.k != b.k || a.ty != b.ty || a.v != b.v { return false }
    let k = a.k
    if k == ir.E_LOCAL { return o.canonOf(a.a) == o.canonOf(b.a) }
    if k == ir.E_GLOBAL || k == ir.E_FUNC { return a.a == b.a }
    if k == ir.E_INT { return true }
    if k == ir.E_STR { return o.u.strs[a.v] == o.u.strs[b.v] }
    if k == ir.E_CALL {
        if !o.same(a.a, b.a) || o.u.listLen(a.b) != o.u.listLen(b.b) { return false }
        for j in 0..o.u.listLen(a.b) {
            if !o.where(a.b, j) && !o.same(o.u.listAt(a.b, j), o.u.listAt(b.b, j)) { return false }
        }
        return true
    }
    return o.same(a.a, b.a) && o.same(a.b, b.b)
}

// The value avail[i] evaluated again at y: y reads the local holding it (made now if this is
// the first reuse: the first evaluation assigns it where it stands).
fn (o: mut &Cse) reuse(i: int, y: int) {
    if o.dry { return }
    let x = o.avail[i].x
    let ty = o.u.nodes[x].ty
    var t = o.avail[i].t
    if t < 0 {
        append(mut &o.u.locals, ir.Local{name: "cs", ty: ty})
        t = len(o.u.locals) - 1
        append(mut &o.taken, false)
        append(mut &o.canon, -1)
        o.avail[i].t = t
        o.u.fresh.put(t, true)
        let line = o.u.nodes[x].line
        append(mut &o.u.nodes, o.u.nodes[x])
        let c = len(o.u.nodes) - 1
        append(mut &o.u.nodes, ir.Node{k: ir.E_LOCAL, ty: ty, line: line, a: t, b: -1, c: -1, d: -1, v: 0})
        let lt = len(o.u.nodes) - 1
        o.u.nodes[x] = ir.Node{k: ir.E_ASSIGN, ty: ty, line: line, a: lt, b: c, c: -1, d: -1, v: 0}
        append(mut &o.u.nodes, ir.Node{k: ir.S_DECL, ty: ir.TY_VOID, line: line, a: t, b: -1, c: -1, d: -1, v: 0})
        let d = len(o.u.nodes) - 1
        append(mut &o.blks[o.avail[i].blk], o.avail[i].at)
        append(mut &o.blks[o.avail[i].blk], d)
        // the entry now names the copy (x is the assignment)
        o.avail[i].x = c
    }
    o.u.nodes[y] = ir.Node{k: ir.E_LOCAL, ty: ty, line: o.u.nodes[y].line, a: t, b: -1, c: -1, d: -1, v: 0}
    o.n += 1
}

// ---------------------------------------------------------------- POD enum glue & invariant S** hoisting

// Identifies enum drop/dup/clone glue functions that are no-ops for tags outside their active bitmask.
fn (o: mut &Cse) findPodGlues() {
    let nf = len(o.u.funcs)
    o.glueKind = array(nf, 0)
    o.glueMask = array(nf, 0)
    for f in o.u.nRtFuncs..nf {
        if len(o.u.funcs[f].params) != 1 { continue }
        let b = o.u.funcs[f].body
        if b < 0 || o.u.nk(b) != ir.S_BLOCK { continue }
        let p = o.u.funcs[f].params[0]
        let pt = o.u.locals[p].ty
        if o.u.tk(pt) != ir.TY_STRUCT { continue }
        let rt = o.u.tys[o.u.funcs[f].ty].base
        let ls = o.u.nodes[b].a
        let ln = o.u.listLen(ls)
        if rt == ir.TY_VOID && ln == 1 {
            let m = o.glueBranchMask(o.u.listAt(ls, 0), p, -1)
            if m >= 0 {
                o.glueKind[f] = 1
                o.glueMask[f] = m
            }
        } else if rt == pt && ln == 2 {
            let s1 = o.u.listAt(ls, 1)
            if o.u.nk(s1) == ir.S_RETURN && o.u.nk(o.u.nodes[s1].a) == ir.E_LOCAL && o.u.nodes[o.u.nodes[s1].a].a == p {
                let m = o.glueBranchMask(o.u.listAt(ls, 0), p, -1)
                if m >= 0 {
                    o.glueKind[f] = 2
                    o.glueMask[f] = m
                }
            }
        } else if rt == pt && ln == 3 {
            let s0 = o.u.listAt(ls, 0)
            let s2 = o.u.listAt(ls, 2)
            if o.u.nk(s0) == ir.S_DECL && o.u.nodes[s0].c < 0 && o.u.nk(o.u.nodes[s0].b) == ir.E_LOCAL &&
                o.u.nodes[o.u.nodes[s0].b].a == p && o.u.nk(s2) == ir.S_RETURN &&
                o.u.nk(o.u.nodes[s2].a) == ir.E_LOCAL && o.u.nodes[o.u.nodes[s2].a].a == o.u.nodes[s0].a {
                let r = o.u.nodes[s0].a
                let m = o.glueBranchMask(o.u.listAt(ls, 1), p, r)
                if m >= 0 {
                    o.glueKind[f] = 2
                    o.glueMask[f] = m
                }
            }
        }
    }
}

fn (o: &Cse) isTagRead(x: int, p: int, r: int): bool {
    if o.u.nk(x) != ir.E_MEMBER || o.u.nodes[x].v != 0 { return false }
    let base = o.u.nodes[x].a
    if o.u.nk(base) != ir.E_LOCAL { return false }
    let l = o.u.nodes[base].a
    return l == p || (r >= 0 && l == r)
}

// If s is `if (tag == K) { ... }` or `switch (tag) { case K: ... }` with no default and all K in 0..62,
// returns the bitmask of those K; else -1.
fn (o: &Cse) glueBranchMask(s: int, p: int, r: int): int {
    let k = o.u.nk(s)
    if k == ir.S_IF {
        if o.u.nodes[s].c >= 0 { return -1 }
        let cond = o.u.nodes[s].a
        if o.u.nk(cond) != ir.E_BIN || o.u.nodes[cond].v != ir.OP_EQ { return -1 }
        let a = o.u.nodes[cond].a
        let b = o.u.nodes[cond].b
        var tagv = -1
        if o.isTagRead(a, p, r) && o.u.nk(b) == ir.E_INT { tagv = o.u.nodes[b].v } else if o.isTagRead(b, p, r) && o.u.nk(a) == ir.E_INT { tagv = o.u.nodes[a].v }
        if tagv < 0 || tagv >= 63 { return -1 }
        return 1 << tagv
    }
    if k == ir.S_SWITCH {
        if !o.isTagRead(o.u.nodes[s].a, p, r) { return -1 }
        let sb = o.u.nodes[s].b
        if o.u.nk(sb) != ir.S_BLOCK { return -1 }
        var mask = 0
        let ls = o.u.nodes[sb].a
        for j in 0..o.u.listLen(ls) {
            let st = o.u.listAt(ls, j)
            let sk = o.u.nk(st)
            if sk == ir.S_DEFAULT { return -1 }
            if sk == ir.S_CASE {
                let cv = o.u.nodes[st].v
                if cv < 0 || cv >= 63 { return -1 }
                mask = mask | (1 << cv)
            }
        }
        return mask
    }
    return -1
}

// Constant enum tag at offset 0 of a compound literal / init list (0..62), or -1 if unknown.
fn (o: &Cse) clitTag(ents: int): int {
    var tag = 0
    if ents >= 0 {
        for j in 0..o.u.listLen(ents) {
            let en = o.u.listAt(ents, j)
            if o.u.nodes[en].v == 0 {
                let v = o.u.nodes[en].a
                if o.u.nk(v) != ir.E_INT { return -1 }
                tag = o.u.nodes[v].v
            }
        }
    }
    return if tag >= 0 && tag < 63 { tag } else { -1 }
}

fn (o: &Cse) tagScan(x: int, assigned: mut &Map[int, bool], declTag: mut &Map[int, int]) {
    if x < 0 { return }
    let n = o.kids(x)
    let k = n.k
    if k == ir.S_DECL {
        let l = n.a
        if !o.taken[l] && o.u.tk(o.u.locals[l].ty) == ir.TY_STRUCT {
            var tg = -1
            if n.b >= 0 && n.c < 0 && o.u.nk(n.b) == ir.E_CLIT && o.u.nodes[n.b].ty == o.u.locals[l].ty {
                tg = o.clitTag(o.u.nodes[n.b].b)
            } else if n.b < 0 && n.c >= 0 {
                tg = o.clitTag(n.c)
            } else if n.b >= 0 && n.c < 0 && o.u.nk(n.b) == ir.E_LOCAL {
                let src = o.u.nodes[n.b].a
                if !o.taken[src] && !assigned.has(&src) { tg = declTag.getOr(&src, -1) }
            }
            if tg >= 0 {
                if declTag.has(&l) { assigned.put(l, true) } else { declTag.put(l, tg) }
            }
        }
        o.tagScan(n.b, assigned, declTag)
        if n.c >= 0 {
            for j in 0..o.u.listLen(n.c) { o.tagScan(o.u.listAt(n.c, j), assigned, declTag) }
        }
        return
    }
    if k == ir.E_ASSIGN || k == ir.E_POSTINC {
        var r = n.a
        while o.u.nk(r) == ir.E_MEMBER { r = o.u.nodes[r].a }
        if o.u.nk(r) == ir.E_LOCAL { assigned.put(o.u.nodes[r].a, true) }
    }
    if k == ir.S_BLOCK {
        for j in 0..o.u.listLen(n.a) { o.tagScan(o.u.listAt(n.a, j), assigned, declTag) }
        return
    }
    if k == ir.E_CALL || k == ir.E_CLIT {
        if k == ir.E_CALL { o.tagScan(n.a, assigned, declTag) }
        for j in 0..o.u.listLen(n.b) { o.tagScan(o.u.listAt(n.b, j), assigned, declTag) }
        return
    }
    if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_FUNC ||
        k == ir.S_BREAK || k == ir.S_CONTINUE || k == ir.S_CASE || k == ir.S_DEFAULT || k == ir.S_EMPTY {
        return
    }
    o.tagScan(n.a, assigned, declTag)
    if k == ir.E_BIN || k == ir.E_LAND || k == ir.E_LOR || k == ir.E_ASSIGN || k == ir.E_PADD || k == ir.S_SWITCH ||
        k == ir.S_WHILE || k == ir.E_COND || k == ir.S_IF || k == ir.S_FOR {
        o.tagScan(n.b, assigned, declTag)
    }
    if k == ir.E_COND || k == ir.S_IF || k == ir.S_FOR { o.tagScan(n.c, assigned, declTag) }
    if k == ir.S_FOR { o.tagScan(n.d, assigned, declTag) }
}

fn (o: &Cse) argConstTag(x: int, assigned: &Map[int, bool], declTag: &Map[int, int]): int {
    let k = o.u.nk(x)
    if k == ir.E_LOCAL {
        let l = o.u.nodes[x].a
        if o.taken[l] || assigned.has(&l) { return -1 }
        return declTag.getOr(&l, -1)
    }
    if k == ir.E_CLIT && o.calm(x) { return o.clitTag(o.u.nodes[x].b) }
    return -1
}

fn (o: &Cse) directCallee(x: int): int {
    if o.u.nk(x) != ir.E_CALL { return -1 }
    let c = o.u.nodes[x].a
    if o.u.nk(c) != ir.E_DECAY || o.u.nk(o.u.nodes[c].a) != ir.E_FUNC { return -1 }
    return o.u.nodes[o.u.nodes[c].a].a
}

fn (o: mut &Cse) tagRewrite(x: int, assigned: &Map[int, bool], declTag: &Map[int, int]) {
    if x < 0 { return }
    let n = o.kids(x)
    let k = n.k
    if k == ir.S_EXPR {
        let gf = o.directCallee(n.a)
        if gf >= 0 && o.glueKind[gf] == 1 && o.u.listLen(o.u.nodes[n.a].b) == 1 {
            let arg = o.u.listAt(o.u.nodes[n.a].b, 0)
            let tg = o.argConstTag(arg, assigned, declTag)
            if tg >= 0 && (o.glueMask[gf] & (1 << tg)) == 0 {
                o.u.nodes[x].k = ir.S_EMPTY
                o.u.nodes[x].a = -1
                return
            }
        }
        o.tagRewrite(n.a, assigned, declTag)
        return
    }
    if k == ir.E_CALL {
        let gf = o.directCallee(x)
        if gf >= 0 && o.glueKind[gf] == 2 && o.u.listLen(n.b) == 1 {
            let arg = o.u.listAt(n.b, 0)
            let tg = o.argConstTag(arg, assigned, declTag)
            if tg >= 0 && (o.glueMask[gf] & (1 << tg)) == 0 {
                let line = o.u.nodes[x].line
                o.u.nodes[x] = o.u.nodes[arg]
                o.u.nodes[x].line = line
                return
            }
        }
        for j in 0..o.u.listLen(n.b) { o.tagRewrite(o.u.listAt(n.b, j), assigned, declTag) }
        return
    }
    if k == ir.S_BLOCK {
        for j in 0..o.u.listLen(n.a) { o.tagRewrite(o.u.listAt(n.a, j), assigned, declTag) }
        return
    }
    if k == ir.E_CLIT {
        for j in 0..o.u.listLen(n.b) { o.tagRewrite(o.u.listAt(n.b, j), assigned, declTag) }
        return
    }
    if k == ir.S_DECL {
        o.tagRewrite(n.b, assigned, declTag)
        if n.c >= 0 {
            for j in 0..o.u.listLen(n.c) { o.tagRewrite(o.u.listAt(n.c, j), assigned, declTag) }
        }
        return
    }
    if k == ir.S_SWITCH {
        if o.u.nk(n.a) == ir.E_MEMBER && o.u.nodes[n.a].v == 0 && o.u.nk(o.u.nodes[n.a].a) == ir.E_LOCAL {
            let l = o.u.nodes[o.u.nodes[n.a].a].a
            let tg = o.argConstTag(o.u.nodes[n.a].a, assigned, declTag)
            if tg >= 0 {
                let m = o.glueBranchMask(x, l, -1)
                if m >= 0 && (m & (1 << tg)) == 0 {
                    o.u.nodes[x].k = ir.S_EMPTY
                    o.u.nodes[x].a = -1
                    o.u.nodes[x].b = -1
                    return
                }
            }
        }
        o.tagRewrite(n.a, assigned, declTag)
        o.tagRewrite(n.b, assigned, declTag)
        return
    }
    if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_LOCAL || k == ir.E_GLOBAL || k == ir.E_FUNC ||
        k == ir.S_BREAK || k == ir.S_CONTINUE || k == ir.S_CASE || k == ir.S_DEFAULT || k == ir.S_EMPTY {
        return
    }
    o.tagRewrite(n.a, assigned, declTag)
    if k == ir.E_BIN || k == ir.E_LAND || k == ir.E_LOR || k == ir.E_ASSIGN || k == ir.E_PADD || k == ir.S_SWITCH ||
        k == ir.S_WHILE || k == ir.E_COND || k == ir.S_IF || k == ir.S_FOR {
        o.tagRewrite(n.b, assigned, declTag)
    }
    if k == ir.E_COND || k == ir.S_IF || k == ir.S_FOR { o.tagRewrite(n.c, assigned, declTag) }
    if k == ir.S_FOR { o.tagRewrite(n.d, assigned, declTag) }
}

fn (o: mut &Cse) elidePodGlue(body: int) {
    var assigned: Map[int, bool] = newMap()
    var declTag: Map[int, int] = newMap()
    o.tagScan(body, mut &assigned, mut &declTag)
    o.tagRewrite(body, &assigned, &declTag)
}

// Hoists `*p` once at function entry for `mut &BoxedRecord` (`S**`) parameters that are never
// reassigned, address-taken, or passed as `p` to another call.
fn (o: &Cse) scanDeref(x: int, p: int, isLhs: bool, out: mut &[]int): bool {
    if x < 0 { return true }
    let n = o.kids(x)
    let k = n.k
    if k == ir.E_LOCAL { return n.a != p }
    if k == ir.E_DEREF && o.u.nk(n.a) == ir.E_LOCAL && o.u.nodes[n.a].a == p {
        if isLhs { return false }
        append(out, x)
        return true
    }
    if k == ir.E_ASSIGN || k == ir.E_POSTINC {
        if !o.scanDeref(n.a, p, true, out) { return false }
        return if k == ir.E_ASSIGN { o.scanDeref(n.b, p, false, out) } else { true }
    }
    if k == ir.E_ADDR || k == ir.E_DECAY { return o.scanDeref(n.a, p, true, out) }
    if k == ir.E_MEMBER {
        // (*p)->field = ... or &((*p)->field) still reads *p as an rvalue pointer.
        let innerIsDeref = o.u.nk(n.a) == ir.E_DEREF
        return o.scanDeref(n.a, p, if innerIsDeref { false } else { isLhs }, out)
    }
    if k == ir.S_BLOCK {
        for j in 0..o.u.listLen(n.a) {
            if !o.scanDeref(o.u.listAt(n.a, j), p, false, out) { return false }
        }
        return true
    }
    if k == ir.E_CALL || k == ir.E_CLIT {
        if k == ir.E_CALL && !o.scanDeref(n.a, p, false, out) { return false }
        for j in 0..o.u.listLen(n.b) {
            if !o.scanDeref(o.u.listAt(n.b, j), p, false, out) { return false }
        }
        return true
    }
    if k == ir.S_DECL {
        if !o.scanDeref(n.b, p, false, out) { return false }
        if n.c >= 0 {
            for j in 0..o.u.listLen(n.c) {
                if !o.scanDeref(o.u.listAt(n.c, j), p, false, out) { return false }
            }
        }
        return true
    }
    if k == ir.E_INT || k == ir.E_FLT || k == ir.E_STR || k == ir.E_GLOBAL || k == ir.E_FUNC ||
        k == ir.S_BREAK || k == ir.S_CONTINUE || k == ir.S_CASE || k == ir.S_DEFAULT || k == ir.S_EMPTY {
        return true
    }
    if !o.scanDeref(n.a, p, false, out) { return false }
    if k == ir.E_BIN || k == ir.E_LAND || k == ir.E_LOR || k == ir.E_PADD || k == ir.S_SWITCH ||
        k == ir.S_WHILE || k == ir.E_COND || k == ir.S_IF || k == ir.S_FOR {
        if !o.scanDeref(n.b, p, false, out) { return false }
    }
    if (k == ir.E_COND || k == ir.S_IF || k == ir.S_FOR) && !o.scanDeref(n.c, p, false, out) { return false }
    if k == ir.S_FOR && !o.scanDeref(n.d, p, false, out) { return false }
    return true
}

fn (o: mut &Cse) hoistDeref(f: int) {
    let body = o.u.funcs[f].body
    if body < 0 || o.u.nk(body) != ir.S_BLOCK { return }
    var prep: []int = []
    let line = o.u.nodes[body].line
    for p in o.u.funcs[f].params {
        if o.taken[p] { continue }
        let pt = o.u.locals[p].ty
        if o.u.tk(pt) != ir.TY_PTR { continue }
        let inner = o.u.tys[pt].base
        if o.u.tk(inner) != ir.TY_PTR { continue }
        var derefs: []int = []
        if !o.scanDeref(body, p, false, mut &derefs) || len(derefs) < 2 { continue }
        append(mut &o.u.locals, ir.Local{name: "hd", ty: inner})
        let t = len(o.u.locals) - 1
        append(mut &o.taken, false)
        append(mut &o.canon, -1)
        o.u.fresh.put(t, true)
        append(mut &o.u.nodes, ir.Node{k: ir.E_LOCAL, ty: pt, line: line, a: p, b: -1, c: -1, d: -1, v: 0})
        let lp = len(o.u.nodes) - 1
        append(mut &o.u.nodes, ir.Node{k: ir.E_DEREF, ty: inner, line: line, a: lp, b: -1, c: -1, d: -1, v: 0})
        let dr = len(o.u.nodes) - 1
        append(mut &o.u.nodes, ir.Node{k: ir.S_DECL, ty: ir.TY_VOID, line: line, a: t, b: dr, c: -1, d: -1, v: 0})
        append(mut &prep, len(o.u.nodes) - 1)
        for d in derefs {
            o.u.nodes[d] = ir.Node{k: ir.E_LOCAL, ty: inner, line: o.u.nodes[d].line, a: t, b: -1, c: -1, d: -1, v: 0}
        }
    }
    if len(prep) == 0 { return }
    let old = o.u.nodes[body].a
    var ns: []int = []
    for s in prep { append(mut &ns, s) }
    for j in 0..o.u.listLen(old) { append(mut &ns, o.u.listAt(old, j)) }
    o.u.nodes[body].a = o.u.list(&ns)
}
