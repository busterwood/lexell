// error: array needs a value it can copy or clone, and D cannot be cloned: D has a drop method
// line: 7
// array(n, v) clones an owned v into each element (design/owned-str.md); a value with a drop method cannot be cloned
type D = record { id: int }
fn (d: mut &D) drop() {}
fn main() {
    let xs = array(2, D{id: 1})
}
