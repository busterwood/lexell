// error: move|borrow
type D = record { id: int }
type Op = closed { Has(D); Nope }
fn eat(d: D) {}
fn main() {
    let o = Op.Has(D{id: 1})
    match o {
        Op.Has(d) { eat(d) }
        Op.Nope { }
    }
    let again = o       // o is used after the match, so the match borrows it and d is a borrow
}
