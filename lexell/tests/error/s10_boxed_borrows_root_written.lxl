// error: 's' is borrowed by 'e' and cannot be assigned
// line: 8
// A boxed type holding borrows is second class like a value type holding them (SPEC 10 rule 1).
type E = closed { Name(&str); Add(E, E) }
fn main() {
    var s = "a" + "b"
    let e = E.Name(&s)
    s = "z"
    match e { E.Name(n) { println(n) } else { } }
}
