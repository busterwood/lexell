// try into Result[T, box MyErr] rejects an error type that does not satisfy MyErr.
// error: does not satisfy
type MyErr = interface {
    fn (&Self) code(): int
}
type Plain = value record { m: str }
fn bad(): Result[int, box MyErr] {
    let r: Result[int, Plain] = Err(Plain{m: "no code"})
    return Ok(try r)
}
fn main() {}
