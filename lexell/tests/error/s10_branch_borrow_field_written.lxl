// error: cannot be assigned while that borrow is in scope
// line: 9
// An if or match borrow still freezes the place it borrows: write the borrowed field
type C = record { at: str; started: bool }
fn main() {
    var c = C{at: "a" + "", started: false}
    let hi = "h" + ""
    let to: &str = if c.started { &c.at } else { &hi }
    c.at = "x"
    println(to)
}
