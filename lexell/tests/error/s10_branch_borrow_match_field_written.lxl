// error: cannot be assigned while that borrow is in scope
// line: 8
// An if or match borrow still freezes the place it borrows: match arm borrow, write the borrowed field
type C = record { a: str; b: str; n: int }
fn main() {
    var c = C{a: "a" + "", b: "b" + "", n: 0}
    let s: &str = match c.n { 0 { &c.a } else { &c.b } }
    c.b = "x"
    println(s)
}
