// SPEC 10 rule 5: a function returning a mut slice needs exactly one borrowed
// parameter for it to be rooted at (a shared slice may have several).
// error: borrow
// line: 6

fn pick(xs: mut &[]int, ys: &[]int): mut &[]int { return xs }

fn main() {
    var a: []int = [4, 5, 6]
    let b: []int = [1]
    println(pick(mut &a, &b)[0].toStr())
}
