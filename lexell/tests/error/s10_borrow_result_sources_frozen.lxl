// error: 'x' is borrowed by 'r' and cannot be assigned
// line: 9
// a borrow result with several sources borrows all its arguments (SPEC 10 rule 5)
fn longer(a: &str, b: &str): &str { return if len(a) >= len(b) { a } else { b } }
fn main() {
    var x = "ab" + ""
    let y = "c" + ""
    let r = longer(&x, &y)
    x = "q"
    println(r)
}
