// error: cannot move a str out of a field or element of 'h'
// line: 8
// two fields of h in one statement: h is used again, so neither moves out (SPEC 9.1)
type H = record { name: str; tag: str }
fn both(a: str, b: str): str { return a + b }
fn main() {
    let h = H{name: "x" + "", tag: "y" + ""}
    println(both(h.name, h.tag))
}
