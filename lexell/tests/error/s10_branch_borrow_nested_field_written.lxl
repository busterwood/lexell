// error: cannot be assigned while that borrow is in scope
// line: 8
// An if or match borrow still freezes the place it borrows: nested if, write a nested branch's field
type C = record { a: str; b: str; n: int }
fn main() {
    var c = C{a: "a" + "", b: "b" + "", n: 1}
    let s: &str = if c.n == 0 { &c.a } else if c.n == 1 { &c.b } else { "lit" }
    c.b = "y"
    println(s)
}
