// SPEC 7.4 (design/owned-str.md, issue 7): s += ch(mut &s) on an owned str borrows s for the
// operator while ch runs, so the mut & of s conflicts with it. Write let t = ch(mut &s); s += t.
// error: 's' cannot be mutably borrowed here: an enclosing call already holds a borrow of it
// line: 8
fn ch(s: mut &str): str { s = "zz"; return "x" }
fn main() {
    var s = "abc" + ""
    s += ch(mut &s)
    println(s)
}
