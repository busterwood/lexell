// error: 'd' is borrowed by 's' and cannot be assigned while that borrow is in scope
// line: 7
type In = record { a: int; b: str }
type D = record { inner: In; pos: int }
fn f(d: mut &D): int {
    let s = &d.inner
    d.inner.a = 3
    return s.a
}
fn main() { var d = D{inner: In{a: 1, b: ""}, pos: 0}; println(f(mut &d)) }
