// Red-team round 2, g07: building a string in place checks the str limit as it grows: the append
// that passes the limit stops the program (exit 2). (StrBuf, which could grow past it until made
// a str, is gone: design/consistency.md.)
// cflags: -DRT_STR_MAX=100
// expect: 100
// exit: 2
fn main() {
    var b = ""
    for i in 0..10 { b += "0123456789" }
    println(len(b).toStr())
    b.addByte('x')
    println("not reached")
}
