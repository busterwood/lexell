// expect: 2
// expect: line2
// expect: true
// expect: 1
// expect: false
// expect: 5
// expect: false
// expect: zbc
// expect: raw
// expect: 4
// expect: -122
// expect: false
// expect: 4
// expect: true
// expect: ababab
// expect: el
import "strings"

fn main() {
    let text = " line1\nline2\n"
    let lines = strings.splitByte(strings.trim(text), '\n')
    println(len(lines))
    println(lines[1])
    var missing = ""
    println(readFile("nope.txt", mut &missing) != 0)
    let a = args()
    println(len(a))
    var home = ""
    println(getenv("LXL_SURELY_UNSET_VARIABLE", mut &home))
    var f: float = 0.0f
    if parseFloat("2.5", mut &f) { println(f * 2.0f) }
    println(parseFloat("x", mut &f))
    var bs = strToBytes("abc")
    bs[0] = 'z'
    println(strFromBytes(&bs))
    println(writeFd(1, "raw\n"))
    match strings.parseIntOpt("-123") {
        Some(n) { println(n + 1) }
        None {}
    }
    println(strings.parseIntOpt("9223372036854775808").isSome())
    println(strings.indexOf("hello world", "o w", 0))
    println(strings.startsWith("hello", "he"))
    println(strings.repeat("ab", 3))
    println(strings.substr("hello", 1, 3))
}
