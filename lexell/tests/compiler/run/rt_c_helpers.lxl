// The lxl_* C helpers in rt.h that the library (io, fs, os, time) calls
// through extern "c": errno, stat fields, open modes, clocks, getcwd.
// expect: stat / ok, is dir true
// expect: stat missing: 2
// expect: open missing: -2, bad mode: -22
// expect: clocks ok
// expect: cwd ok
extern "c" fn lxl_errno(): int
extern "c" fn lxl_stat(path: str, follow: int): int
extern "c" fn lxl_stat_field(i: int): int
extern "c" fn lxl_open(path: str, how: int): int
extern "c" fn lxl_clock_ns(which: int): int
extern "c" fn lxl_getcwd(): ptr

fn main() {
    let r = lxl_stat("/", 1)
    if r == 0 { println("stat / ok, is dir " + (lxl_stat_field(1) & 0xF000 == 0x4000).toStr()) }
    println("stat missing: " + lxl_stat("/no/such/path", 0).toStr())
    println("open missing: " + lxl_open("/no/such/path", 0).toStr() + ", bad mode: " + lxl_open("/", 7).toStr())
    let a = lxl_clock_ns(1)
    let b = lxl_clock_ns(1)
    if b >= a && lxl_clock_ns(0) > 1577836800000000000 { println("clocks ok") }
    if len(strFromC(lxl_getcwd())) > 0 { println("cwd ok") }
}
