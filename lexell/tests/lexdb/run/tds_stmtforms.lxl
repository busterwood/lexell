// lexdb over TDS: the audit's cheap T-SQL odds, checked against SQL Server 2025 (generated by tests/lexdb/gen_mssql.py --port
// 14331 --container lxl-mssql25 stmtforms from mssql_stmtforms_queries.txt; design/lexdb-new-features.md S9, S21): 2025's ||=
// (NULL, a number, int ||= int 402), the compound assignments of SET @v and UPDATE ... SET (+= -= *= /= %= &= |= ^= ||=), ^ as
// XOR, 2022's BIT_COUNT, LEFT_SHIFT, RIGHT_SHIFT (<< >>), GET_BIT, SET_BIT of smallint, int and bigint (logical shifts, a
// negative count, a count past the width; NULLs; 8116, 9838, 9839, 174) over columns, grouped and summed, and APPROX_PERCENTILE_CONT
// / _DISC (grouped, DESC, empty input, 8727, 4113, 10754). Each batch runs against lexdb with SET lexdb_batch = off and on:
// "same: " and the answer, or DIFFERENT and both; writes in a transaction rolled back.
// expect: ok
// expect: (3)
// expect: ok
// expect: (3000)
// expect: same: (1) / (1) / (1) / s: 'abc'
// expect: same: (1) / (1) / s: NULL
// expect: same: (1) / (1) / s: NULL
// expect: same: (1) / (1) / s: 'x1'
// expect: same: error 402
// expect: same: (1) / (1) / i: 2
// expect: same: (1) / (1) / i: 15
// expect: same: (1) / (1) / i: 5
// expect: same: (1) / (1) / (1) / (1) / (1) / i: 14
// expect: same: (1) / (1) / i: 8
// expect: same: x,y,z,w,v: 5|2|7|11|0
// expect: same: (2) / id,a,s: 1|6|'pq';2|NULL|NULL;3|6|'x'
// expect: same: (1) / (1) / a,s: 2|'xx'
// expect: same: (1) / a,h: 7|15
// expect: same: error 402
// expect: same: (76) / n,b: 3000|3
// expect: same: a,b,c,g,z: 3|32|64|16|0
// expect: same: a,b,c,d,f,g,h,i: 8|4|16|16|-2147483648|0|1073741820|0
// expect: same: a,b,d,e,f,g,h: true|false|7|4|1099511627776|true|-2147483648
// expect: same: a,b,c,d,e,f: 5|15|4095|-16|0|-1073741824
// expect: same: a,b,c,d,e: 0|8589934592|10|-9223372036854775808|-32768
// expect: same: (1) / a,b,c,d,e,f,g,h: NULL|NULL|NULL|NULL|NULL|NULL|NULL|NULL
// expect: same: id,ba,bg,bh,l,r,gb,sh,rh: 1|1|63|15|2|1|false|-2|32767;2|NULL|1|0|NULL|2|true|8|0;3|2|2|3|12|0|false|15|3
// expect: same: b,n: NULL|230;0|27;1|194;2|579;3|904;4|712;5|299;6|55
// expect: same: s,m,odd: 16835|800|1500
// expect: same: error 9838
// expect: same: error 9838
// expect: same: error 9838
// expect: same: error 9839
// expect: same: error 8116
// expect: same: error 8116
// expect: same: error 8116
// expect: same: error 174
// expect: same: error 174
// expect: same: error 9838
// expect: same: m,d: 2.5|2
// expect: same: k,c,d,cd,df: NULL|52|41|67.75|20.5;'k0'|47.5|46|69.25|3.5;'k1'|47|47|73|0.5;'k2'|48|48|77.5|1;'k3'|47|45|76|1.5;'k4'|55|53|77|2;'k5'|51|51|72|2.5;'k6'|53.5|52|73.75|3
// expect: same: c: NULL
// expect: same: error 8727
// expect: same: error 4113
// expect: same: error 10754
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once create table u (id int primary key, a int, s varchar(10), g bigint, h smallint)\n@once insert into u values (1, 1, 'p', 9223372036854775807, -2), (2, NULL, NULL, -9223372036854775807 - 1, 0), (3, 6, 'x', 5, 7)\n@once create table pb (id int primary key, k varchar(10), v int, f float)\n@once with n as (select 1 as i union all select i + 1 from n where i < 3000) insert into pb select i, case when i % 41 = 0 then NULL else 'k' + cast(i % 7 as varchar(5)) end, case when i % 13 = 0 then NULL else i % 101 end, i * 0.5 from n option (maxrecursion 3000)\ndeclare @s varchar(20) = 'a'; set @s ||= 'b'; set @s ||= 'c'; select @s as s\ndeclare @s varchar(20) = null; set @s ||= 'b'; select @s as s\ndeclare @s varchar(20) = 'a'; set @s ||= null; select @s as s\ndeclare @s nvarchar(20) = N'x'; set @s ||= 1; select @s as s\ndeclare @i int = 1; set @i ||= 2; select @i as i\ndeclare @i int = 6; set @i &= 3; select @i as i\ndeclare @i int = 6; set @i |= 9; select @i as i\ndeclare @i int = 6; set @i ^= 3; select @i as i\ndeclare @i int = 7; set @i %= 4; set @i *= 10; set @i -= 1; set @i /= 2; select @i as i\ndeclare @i int = 7; set @i += 1; select @i as i\nselect 6 ^ 3 as x, 6 & 3 as y, 6 | 3 as z, 2 + 6 ^ 3 as w, 5 ^ 5 as v\nbegin tran; update u set a += 5, s ||= 'q' where id <= 2; select id, a, s from u order by id; rollback\nbegin tran; update u set a *= 2, s ||= s where id = 3; update u set a %= 5 where id = 3; select a, s from u where id = 3; rollback\nbegin tran; update u set a ^= 1, h |= 8 where id = 3; select a, h from u where id = 3; rollback\nbegin tran; update u set a ||= 1 where id = 1; rollback\nbegin tran; update pb set k ||= '!' where id <= 3 or k is null; select count(*) as n, sum(case when k like '%!' then 1 else 0 end) as b from pb; rollback\nselect bit_count(7) as a, bit_count(cast(-1 as int)) as b, bit_count(cast(-1 as bigint)) as c, bit_count(cast(-1 as smallint)) as g, bit_count(0) as z\nselect left_shift(1, 3) as a, right_shift(16, 2) as b, 1 << 4 as c, 256 >> 4 as d, left_shift(1, 31) as f, left_shift(1, 32) as g, right_shift(-16, 2) as h, left_shift(1, -1) as i\nselect get_bit(5, 0) as a, get_bit(5, 1) as b, set_bit(5, 1) as d, set_bit(5, 0, 0) as e, set_bit(cast(0 as bigint), 40) as f, get_bit(cast(-1 as bigint), 63) as g, set_bit(cast(0 as int), 31) as h\nselect left_shift(5, 0) as a, right_shift(cast(-1 as bigint), 60) as b, right_shift(cast(-1 as smallint), 4) as c, left_shift(cast(-1 as smallint), 4) as d, right_shift(1, 33) as e, left_shift(3, 30) as f\nselect 1 << 33 as a, cast(1 as bigint) << 33 as b, 5 >> -1 as c, left_shift(cast(1 as bigint), 63) as d, left_shift(cast(3 as smallint), 15) as e\ndeclare @n int = null; select bit_count(@n) as a, left_shift(@n, 1) as b, left_shift(1, @n) as c, get_bit(@n, 1) as d, set_bit(@n, 1) as e, set_bit(1, @n) as f, get_bit(1, @n) as g, set_bit(1, 1, @n) as h\nselect id, bit_count(a) as ba, bit_count(g) as bg, bit_count(h) as bh, a << 1 as l, g >> 62 as r, get_bit(g, 63) as gb, set_bit(h, 3) as sh, right_shift(h, 1) as rh from u order by id\nselect bit_count(v) as b, count(*) as n from pb group by bit_count(v) order by 1\nselect sum(bit_count(id)) as s, max(left_shift(v, 3)) as m, sum(cast(get_bit(id, 0) as int)) as odd from pb\nselect get_bit(5, 32)\nselect get_bit(5, -1)\nselect set_bit(5, 32)\nselect set_bit(5, 1, 2) as a\nselect left_shift('a', 1)\nselect bit_count(1.5)\nselect bit_count(cast(1 as bit)) as a\nselect bit_count(1, 2)\nselect get_bit(1)\nselect id, get_bit(a, 40) as x from u where id = 3\nselect approx_percentile_cont(0.5) within group (order by v) as m, approx_percentile_disc(0.5) within group (order by v) as d from (values (1), (2), (3), (4)) x(v)\nselect k, approx_percentile_cont(0.5) within group (order by v) as c, approx_percentile_disc(0.5) within group (order by v) as d, approx_percentile_cont(0.25) within group (order by v desc) as cd, approx_percentile_disc(0) within group (order by f) as df from pb where id <= 200 group by k order by k\nselect approx_percentile_cont(0.5) within group (order by v) as c from pb where 1 = 0\nselect approx_percentile_cont(1.5) within group (order by v) from (values (1)) x(v)\nselect approx_percentile_cont(0.5) within group (order by v) over () from (values (1)) x(v)\nselect approx_percentile_cont(0.5) from (values (1)) x(v)"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(50), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
