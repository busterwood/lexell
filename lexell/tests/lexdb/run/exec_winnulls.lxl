// lexdb_exec: IGNORE NULLS and RESPECT NULLS of lag, lead, first_value, last_value and nth_value (design/lexdb-new-features.md
// P5, PostgreSQL 19): offsets 0, 2 and negative, a NULL offset, defaults, partitions, ROWS, RANGE and GROUPS frames with offsets
// and EXCLUDE, text values, a named window, descending orders with NULLs first, 3,000 rows grouped, no rows, every value NULL,
// an error in a later row (22012, 22016); 0A000 for row_number, rank, ntile, 42809 for an aggregate and without OVER, 42601.
// Checked against PostgreSQL 19 (generated by tests/lexdb/gen_pg.py from winnulls_queries.txt). Each answer: the columns'
// names and the rows, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off and on.
// expect: CREATE TABLE
// expect: INSERT 0 9
// expect: CREATE TABLE
// expect: INSERT 0 3000
// expect: CREATE TABLE
// expect: same: id|a|b|c|d|e: 1||10|||10;2||20||10|20;3|10|20|||20;4|10|30||20|-1;5|20|30|10||-1;6|20|30|10||30;7|20|30|10||30;8|20||10|30|-1;9|30||20||-1
// expect: same: id|a|b|c|d|e: 1|||10||;2||20|20||;3|10||20||;4|||30||;5|20||30|10|;6||30|30|10|;7|||30|10|;8||||10|;9|30|||20|
// expect: same: id|a|b|c|d|e: 1|||20||10;2|10|10|20||10;3|10|10|20||20;4|10|20|20||20;5|10|20|20||20;6|10|20|20||;7|10|20|20||30;8|10|30|20||30;9|10|30|20||30
// expect: same: id|a|b|c: 1|10||20;2|20|10|20;3|20|10|30;4||20|30;5|30|20|30;6|30||20;7|30||20;8||30|;9||30|
// expect: same: id|a|b|c|d: 1|p|s|none|;2|p|s|none|;3|r|s|p|;4|r|s|p|;5|r|s|q|r;6||s|r|r;7||s|r|r;8|s|s|r|r;9|s|s|r|r
// expect: same: id|a|b|c: 1|10|10|;2|10|10|;3|20|20|;4|20|20|;5|20||20;6|20|30|;7|30|30|;8|30|30|;9|30||
// expect: same: id|a|b: 1||;2||10;3|10|10;4|10|10;5|20|10;6||;7||;8||30;9|30|30
// expect: same: k|x|a|b: a|||;a|10|10|30;b|||;b|20|20|30;b|||;a|||;a|||;c|30|30|30;c|||
// expect: same: g|n|sa|sb|sc|sd|ce|sf: 0|428|10534|9842|10522|10502|424|6885;1|429|10469|10606|10509|10440|425|7007;2|429|10583|11335|10395|10622|424|7109;3|429|10568|10153|10474|10601|425|6932;4|429|10492|9928|10531|10377|423|6879;5|428|10587|11102|10359|10514|424|7082;6|428|10550|10761|10351|10585|423|7003
// expect: same: id|k|a|b: 5|||;10||5|;11|k2||;12|k0||;1500||10|5;2995||10|10;2996|k2|11|;3000||45|10
// expect: same: id|a|b|c: 
// expect: same: id|a|b: 1||;3||;5||;6||;7||;9||
// expect: same: ERROR 22012
// expect: same: ERROR 22016
// expect: same: ERROR 0A000
// expect: same: ERROR 0A000
// expect: same: ERROR 0A000
// expect: same: ERROR 42809
// expect: same: ERROR 42809
// expect: same: ERROR 42601
// expect: same: ERROR 22016
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table wn (id int primary key, g int, k text, x int, s text)\n@once insert into wn values (1, 1, 'a', null, null), (2, 1, 'a', 10, 'p'), (3, 1, 'b', null, null), (4, 1, 'b', 20, 'q'), (5, 1, 'b', null, 'r'), (6, 2, 'a', null, null), (7, 2, 'a', null, null), (8, 2, 'c', 30, null), (9, 2, 'c', null, 's')\n@once create table wb (id int primary key, g int, k text, x int)\n@once insert into wb select i, i % 7, case when i % 5 = 0 then null else 'k' || (i % 3) end, case when i % 4 = 0 or i % 9 = 0 then null else i % 50 end from generate_series(1, 3000) i\n@once create table we (id int primary key, x int)\nselect id, lag(x) ignore nulls over (order by id) a, lead(x) ignore nulls over (order by id) b, lag(x, 2) ignore nulls over (order by id) c, lag(x, 0) ignore nulls over (order by id) d, lead(x, 1, -1) ignore nulls over (partition by g order by id) e from wn order by id\nselect id, lag(x) respect nulls over (order by id) a, lead(x, 2) respect nulls over (order by id) b, lag(x, -1) ignore nulls over (order by id) c, lead(x, -2) ignore nulls over (order by id) d, lag(x, null) ignore nulls over (order by id) e from wn order by id\nselect id, first_value(x) ignore nulls over (order by id) a, last_value(x) ignore nulls over (order by id) b, nth_value(x, 2) ignore nulls over (order by id rows between unbounded preceding and unbounded following) c, first_value(x) respect nulls over (order by id) d, last_value(x) ignore nulls over (order by id rows between 1 preceding and 1 following) e from wn order by id\nselect id, first_value(x) ignore nulls over (order by id rows between 1 following and 3 following exclude current row) a, last_value(x) ignore nulls over (partition by g order by id groups between 1 preceding and current row exclude ties) b, nth_value(x, 1) ignore nulls over (order by k range between current row and unbounded following exclude group) c from wn order by id\nselect id, first_value(s) ignore nulls over (partition by k order by id desc) a, last_value(s) ignore nulls over (order by k, id range between unbounded preceding and unbounded following) b, lag(s, 1, 'none') ignore nulls over (order by id) c, nth_value(s, 3) ignore nulls over (order by id) d from wn order by id\nselect id, last_value(x) ignore nulls over (order by id range between 2 preceding and 1 following) a, first_value(x) ignore nulls over (order by id groups between current row and 2 following) b, nth_value(x, 2) ignore nulls over (order by g, k rows between 3 preceding and current row exclude current row) c from wn order by id\nselect id, lag(x) ignore nulls over w1 a, first_value(x) ignore nulls over w1 b from wn window w1 as (partition by g order by id) order by id\nselect k, x, last_value(x) ignore nulls over (partition by k order by x nulls first) a, first_value(x) ignore nulls over (order by x desc nulls first, id) b from wn order by id\nselect g, count(*) n, sum(a) sa, sum(b) sb, sum(c) sc, sum(d) sd, count(e) ce, sum(f) sf from (select g, lag(x) ignore nulls over (partition by g order by id) a, lead(x, 3, 0) ignore nulls over (partition by g order by id) b, first_value(x) ignore nulls over (partition by g order by id rows between 5 preceding and 5 following) c, last_value(x) ignore nulls over (partition by k order by id) d, nth_value(x, 4) ignore nulls over (partition by g order by id) e, lag(x, 2, -1) respect nulls over (partition by g order by id) f from wb) t group by g order by g\nselect id, k, lag(x) ignore nulls over (partition by k order by id) a, last_value(x) ignore nulls over (partition by k order by id rows between 10 preceding and 2 preceding) b from wb where id in (5, 10, 11, 12, 1500, 2995, 2996, 3000) order by id\nselect id, lag(x) ignore nulls over (order by id) a, first_value(x) ignore nulls over () b, last_value(x) ignore nulls over () c from we\nselect id, lag(x) ignore nulls over (order by id) a, nth_value(x, 2) ignore nulls over (order by id) b from wn where x is null order by id\nselect count(a) n from (select lag(x, 3000 / (3000 - id)) ignore nulls over (order by id) a from wb) t\nselect count(a) n from (select nth_value(x, 2 - id / 1500) ignore nulls over (order by id) a from wb) t\nselect row_number() ignore nulls over (order by id) from wn\nselect rank() respect nulls over (order by id) from wn\nselect ntile(2) ignore nulls over (order by id) from wn\nselect sum(x) ignore nulls over (order by id) from wn\nselect first_value(x) ignore nulls from wn\nselect lag(x ignore nulls) over (order by id) from wn\nselect nth_value(x, 0) ignore nulls over (order by id) from wn"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(152), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
