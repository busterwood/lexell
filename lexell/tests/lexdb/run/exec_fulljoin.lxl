// lexdb_exec and lexdb_pipe: FULL JOIN, more than one RIGHT or FULL JOIN in a
// query, and CROSS JOIN or a join with no key, in batches (design/
// lexdb-batch-gaps.md item 9; constructs F3-F8, M14). Every query runs with
// SET lexdb_batch = off (the row engine, the reference) and on, from the same
// data: the rows, in the order they come out, must be the same as text, with
// and without an ORDER BY (the row engine's order is the algorithm's: the
// first table's rows in turn, each with its matches in the order read, then a
// RIGHT or FULL JOIN's rows that joined nothing, level by level), and so must
// the error (SQLSTATE and message). A counter (lexdb_pipe.joinCounts, the runs
// of a join's batches) says the batches ran the query where its shape takes
// them: not with batches off.
// - FULL JOIN: NULL keys on both sides, duplicates on both sides, an empty
//   side or two, FULL JOIN ... USING (the merged column COALESCEs both), a
//   condition in ON against one in WHERE (on either side, on the NULL rows),
//   1,024 rows and more each side, an aggregate over it (count of each side,
//   sums, GROUP BY), ORDER BY ... LIMIT, DISTINCT, a join after it, a
//   subquery or view around it, an error in a later batch (in the select
//   list, in ON, in WHERE).
// - two and three RIGHT or FULL JOINs (also with LEFT and inner joins, and
//   USING) in one query: each hash keeps its own marks of the rows that
//   joined; the unmatched rows come level by level, as the row engine
//   gives them (a level's unmatched rows joined to a later level are noted
//   there before that level's own tail).
// - CROSS JOIN and comma joins with no key (a nested loop over batches): 0, 1,
//   3 and 3,000 rows crossed with each other in both orders (the larger table
//   inside as well as outside), 3,000 x 3,000 pairs with a condition on the
//   pair, joins before and after it (hash, LEFT, FULL, RIGHT, a lookup), a
//   view, VALUES, a derived table and a series, LIMIT, ORDER BY, DISTINCT,
//   aggregates, errors in a later batch.
// - MERGE with WHEN NOT MATCHED BY SOURCE (the source's join with the target
//   is RIGHT, FULL with NOT MATCHED): over 3,000 source rows, in a rolled-back
//   transaction, the result (tag, RETURNING rows, OUTPUT, the error) and the
//   tables afterwards compared as text; clause conditions, DO NOTHING, VALUES,
//   a view and a derived table as the source, NULL and repeated source keys,
//   a target matched twice, CHECK, FK and expression errors in a later batch,
//   T-SQL's forms (BY TARGET, TOP, OUTPUT $action); a few source rows and an
//   ON with no key stay row by row.
// "batched": statements whose join ran in batches with them on.
// timeout: 120
// expect: loaded: 1500|1300|0|800
// expect: full: 42 statements, 42 the same, 42 batched, 0 batched with batches off, 4 errors or no rows seen
// expect: multi: 40 statements, 40 the same, 40 batched, 0 batched with batches off, 3 errors or no rows seen
// expect: cross: 41 statements, 41 the same, 41 batched, 0 batched with batches off, 7 errors or no rows seen
// expect: merge: 32 statements, 32 the same, 30 batched, 0 batched with batches off, 10 errors or no rows seen
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_pipe"
import "../../../cmd/lexdb_sql"
import "../../../cmd/lexdb_parse"

fn text(rs: &[lexdb_exec.Res]): str {
    var out: []str = []
    for r in rs {
        if !r.hasRows { append(mut &out, r.tag.clone()) }
        for row in r.rows {
            var vs: []str = []
            for v in row { append(mut &vs, lexdb_sql.text(&v)) }
            append(mut &out, strings.join(&vs, "|"))
        }
    }
    return strings.join(&out, ";")
}

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    // "T: " begins a statement in T-SQL's dialect (MERGE ... WHEN NOT MATCHED BY SOURCE, TOP, OUTPUT)
    if strings.startsWith(sql, "T: ") {
        let none: []str = []
        var p = lexdb_parse.tsqlParser(sql[3..len(sql)], lexdb_parse.Dialect{tsql: true, quotedIdent: true}, &none).unwrap()
        match p.statement() {
            Ok(stmt) {
                var pc = lexdb_exec.oneShot()
                let noVals: []lexdb_sql.Val = []
                let noTypes: []int = []
                match s.runCached(&stmt, &noVals, &noTypes, mut &pc) {
                    Ok(r) { return text(&[r]) }
                    Err(e) { return "ERROR " + e.state + " " + e.msg + " [" + e.detail + "]" }
                }
            }
            Err(e) { return "PARSE " + e.state + " " + e.msg }
        }
    }
    match s.exec(sql) {
        Ok(rs) { return text(&rs) }
        Err(e) { return "ERROR " + e.state + " " + e.msg }
    }
}

type Group = record { n: int; same: int; batched: int; off: int; odd: int; seen: []str }

fn newGroup(): Group { return Group{n: 0, same: 0, batched: 0, off: 0, odd: 0, seen: []} }

// sql run with batches off or on: its result, and whether a join ran in batches.
fn trial(s: mut &lexdb_exec.Session, sql: &str, on: bool, ran: mut &bool): str {
    let m = q(s, &(if on { "set lexdb_batch = on" } else { "set lexdb_batch = off" }))
    let j0 = lexdb_pipe.joinCounts()
    let res = q(s, sql)
    let j1 = lexdb_pipe.joinCounts()
    ran = j1[0] > j0[0]
    return res
}

// sql with batches off and on: the same text; batched: it ran in batches.
fn check(s: mut &lexdb_exec.Session, g: mut &Group, sql: &str, batched: bool) {
    var ranOff = false
    var ranOn = false
    let off = trial(s, sql, false, mut &ranOff)
    let on = trial(s, sql, true, mut &ranOn)
    g.n += 1
    if off == on {
        g.same += 1
    } else if len(g.seen) < 3 {
        append(mut &g.seen, "DIFFERENT: " + sql + "\n  off: " + strings.substr(&off, 0, min(len(off), 300)) + "\n  on:  " + strings.substr(&on, 0, min(len(on), 300)))
    }
    if ranOn { g.batched += 1 }
    if ranOff { g.off += 1 }
    if strings.startsWith(&off, "ERROR") || len(off) == 0 || off == "0" { g.odd += 1 }
    if batched != ranOn && len(g.seen) < 3 {
        append(mut &g.seen, "EXPECTED " + (if batched { "batched" } else { "row" }) + ": " + sql)
    }
}

// The tables a MERGE changes, a digest of every row in key order.
fn digest(s: mut &lexdb_exec.Session): str {
    let a = q(s, &"select count(*), md5(string_agg(id || ':' || coalesce(v::text, 'N') || ':' || coalesce(w::text, 'N') || ':' || coalesce(r::text, 'N') || ':' || coalesce(name, 'N'), ',' order by id)) from tg")
    let b = q(s, &"select count(*), md5(string_agg(id || ':' || tid, ',' order by id)) from kid")
    return a + " / " + b
}

// A statement of sql run in a transaction rolled back, with batches off or on: its result and the tables after it.
fn mtrial(s: mut &lexdb_exec.Session, sql: &str, on: bool, ran: mut &bool): str {
    let m = q(s, &(if on { "set lexdb_batch = on" } else { "set lexdb_batch = off" }))
    let b = q(s, &"begin")
    let j0 = lexdb_pipe.joinCounts()
    let res = q(s, sql)
    let j1 = lexdb_pipe.joinCounts()
    var d = ""
    if !strings.startsWith(&res, "ERROR") { d = digest(s) }
    let r = q(s, &"rollback")
    if len(d) == 0 { d = digest(s) }
    ran = j1[0] > j0[0]
    return res + " // " + d
}

// check for a statement that changes tables: the same result and tables afterwards.
fn mcheck(s: mut &lexdb_exec.Session, g: mut &Group, sql: &str, batched: bool) {
    var ranOff = false
    var ranOn = false
    let off = mtrial(s, sql, false, mut &ranOff)
    let on = mtrial(s, sql, true, mut &ranOn)
    g.n += 1
    if off == on {
        g.same += 1
    } else if len(g.seen) < 3 {
        append(mut &g.seen, "DIFFERENT: " + sql + "\n  off: " + strings.substr(&off, 0, min(len(off), 300)) + "\n  on:  " + strings.substr(&on, 0, min(len(on), 300)))
    }
    if strings.startsWith(&on, "PARSE") && len(g.seen) < 3 { append(mut &g.seen, "NOT PARSED: " + sql + " " + on) }
    if ranOn { g.batched += 1 }
    if ranOff { g.off += 1 }
    if strings.startsWith(&off, "ERROR") || strings.startsWith(&off, "MERGE 0") { g.odd += 1 }
    if batched != ranOn && len(g.seen) < 3 {
        append(mut &g.seen, "EXPECTED " + (if batched { "batched" } else { "row" }) + ": " + sql)
    }
}

// VALUES of n rows (k, v), k from lo.
fn values(lo: int, n: int): str {
    var xs: []str = []
    for i in 0..n { append(mut &xs, "(" + (lo + i).toStr() + ", " + ((lo + i) * 3).toStr() + ")") }
    return "(values " + strings.join(&xs, ", ") + ") as x(k, v)"
}

fn report(name: &str, g: &Group) {
    println(name + ": " + g.n.toStr() + " statements, " + g.same.toStr() + " the same, " + g.batched.toStr() + " batched, " + g.off.toStr() +
            " batched with batches off, " + g.odd.toStr() + " errors or no rows seen")
    for x in g.seen { println(x) }
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(73), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 4 * 1024 * 1024, ckptBytes: 2 * 1024 * 1024, snapNodes: 100000}, fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st)
        // fa and fb: 1,500 and 1,300 rows, keys with NULLs (every 13th and 11th row) and duplicates on both sides
        let c1 = q(mut &s, &"create table fa (id int primary key, k int, v int, t text)")
        let c2 = q(mut &s, &"insert into fa select g, case when g % 13 = 0 then null else g % 400 end, g, 'a' || g from generate_series(1, 1500) g")
        let c3 = q(mut &s, &"create table fb (id int primary key, k int, w int, t text)")
        let c4 = q(mut &s, &"insert into fb select g, case when g % 11 = 0 then null else (g * 3) % 600 end, g * 2, 'b' || g from generate_series(1, 1300) g")
        let c5 = q(mut &s, &"create table fe (id int primary key, k int, w int, t text)")
        let c6 = q(mut &s, &"create table fc (id int primary key, k int, x int)")
        let c7 = q(mut &s, &"insert into fc select g, case when g % 7 = 0 then null else (g * 5) % 700 end, g % 50 from generate_series(1, 800) g")
        let c8 = q(mut &s, &"create view fv as select k, count(*) as n from fb group by k")
        let c8b = q(mut &s, &"create table fd (id int primary key, k int, y int)")
        let c8c = q(mut &s, &"insert into fd select g, case when g % 9 = 0 then null else (g * 7) % 500 end, g % 30 from generate_series(1, 1100) g")
        // x0, x1, x3 and x3k: 0, 1, 3 and 3,000 rows, for the joins with no key
        let x1 = q(mut &s, &"create table x0 (id int primary key, v int)")
        let x2 = q(mut &s, &"create table x1 (id int primary key, v int)")
        let x3 = q(mut &s, &"create table x3 (id int primary key, v int)")
        let x4 = q(mut &s, &"create table x3k (id int primary key, v int)")
        let x5 = q(mut &s, &"insert into x1 values (1, 10)")
        let x6 = q(mut &s, &"insert into x3 values (1, 5), (2, 6), (3, null)")
        let x7 = q(mut &s, &"insert into x3k select g, g * 2 from generate_series(1, 3000) g")
        // MERGE: a target tg (4,000 rows; a CHECK and a foreign key to par), its children kid (cascade),
        // sources msrc (4,000 rows: k not a multiple of 5, up to 5,000), mdup (a key twice), mnull (NULL
        // and repeated keys)
        let m1 = q(mut &s, &"create table par (id int primary key)")
        let m2 = q(mut &s, &"insert into par select g from generate_series(1, 100) g")
        let m3 = q(mut &s, &"create table tg (id int primary key, v int, w int check (w >= 0), r int references par (id), name text)")
        let m4 = q(mut &s, &"insert into tg select g, g, g % 10, g % 100 + 1, case when g % 17 = 0 then null else 'n' || g end from generate_series(1, 4000) g")
        let m5 = q(mut &s, &"create table kid (id int primary key, tid int references tg (id) on delete cascade)")
        let m6 = q(mut &s, &"insert into kid select g, g * 2 from generate_series(1, 1900) g")
        let m7 = q(mut &s, &"create table msrc (k int, v int)")
        let m8 = q(mut &s, &"insert into msrc select g, g * 5 from generate_series(1, 5000) g where g % 5 <> 0")
        let m9 = q(mut &s, &"create table mdup (k int, v int)")
        let ma = q(mut &s, &"insert into mdup select g, g from generate_series(1, 3000) g")
        let mb = q(mut &s, &"insert into mdup values (2900, 0)")
        let mc = q(mut &s, &"create table mnull (k int, v int)")
        let md = q(mut &s, &"insert into mnull select case when g % 9 = 0 then null else g % 1500 end, g from generate_series(1, 2500) g")
        let me = q(mut &s, &"create view msv as select k, v + 1 as v from msrc where k % 2 = 0")
        let c9 = q(mut &s, &"analyze")
        println("loaded: " + q(mut &s, &"select (select count(*) from fa), (select count(*) from fb), (select count(*) from fe), (select count(*) from fc)"))

        var g = newGroup()
        let on = "fa full join fb on fa.k = fb.k"
        // the rows, in order, and sorted
        check(mut &s, mut &g, "select fa.id, fa.k, fb.id, fb.k from " + on, true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " order by fa.id nulls first, fb.id nulls first", true)
        check(mut &s, mut &g, "select * from " + on, true)
        check(mut &s, mut &g, "select fa.t, fb.t, fa.v + fb.w from " + on + " order by 1 nulls last, 2 nulls last", true)
        // an aggregate over it
        check(mut &s, mut &g, "select count(*), count(fa.id), count(fb.id), sum(fa.v), sum(fb.w) from " + on, true)
        check(mut &s, mut &g, "select fa.k, count(*), count(fb.id), sum(fb.w) from " + on + " group by fa.k order by fa.k nulls first", true)
        check(mut &s, mut &g, "select coalesce(fa.k, fb.k) as kk, count(fa.id), count(fb.id) from " + on + " group by coalesce(fa.k, fb.k) order by kk nulls first", true)
        check(mut &s, mut &g, "select count(*), min(fa.id), max(fb.id), avg(fa.v) from " + on + " where fa.id is null or fb.id is null", true)
        // ORDER BY ... LIMIT, DISTINCT
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " order by fb.id desc nulls last, fa.id limit 25", true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " order by fa.id nulls first, fb.id nulls first limit 7 offset 1400", true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " limit 30", true)
        check(mut &s, mut &g, "select distinct fa.k, fb.k from " + on + " order by 1 nulls first, 2 nulls first", true)
        // a condition in ON against one in WHERE
        check(mut &s, mut &g, "select fa.id, fb.id from fa full join fb on fa.k = fb.k and fa.v > 700", true)
        check(mut &s, mut &g, "select fa.id, fb.id from fa full join fb on fa.k = fb.k and fb.w > 1000", true)
        check(mut &s, mut &g, "select fa.id, fb.id from fa full join fb on fa.k = fb.k and fa.v % 2 = 0 and fb.w % 3 = 0", true)
        check(mut &s, mut &g, "select fa.id, fb.id from fa full join fb on fa.k = fb.k and fa.v + fb.w > 2500", true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " where fa.v > 700", true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " where fb.w > 1000", true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " where fa.v > 700 or fb.w > 1000", true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " where fa.id is null", true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " where fb.id is null", true)
        check(mut &s, mut &g, "select count(*) from " + on + " where fa.id is null or fb.id is null", true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " where coalesce(fa.v, 0) + coalesce(fb.w, 0) > 3000", true)
        // empty sides
        check(mut &s, mut &g, "select fa.id, fe.id from fa full join fe on fa.k = fe.k", true)
        check(mut &s, mut &g, "select fa.id, fe.id from fe full join fa on fa.k = fe.k", true)
        check(mut &s, mut &g, "select fe.id, fe2.id from fe full join fe fe2 on fe.k = fe2.k", true)
        check(mut &s, mut &g, "select count(*), count(fe.id) from fa full join fe on fa.k = fe.k", true)
        // FULL JOIN ... USING: the merged column, * and its order
        check(mut &s, mut &g, "select k, fa.v, fb.w from fa full join fb using (k)", true)
        check(mut &s, mut &g, "select * from fa full join fb using (k)", true)
        check(mut &s, mut &g, "select k, count(*), count(fa.id), count(fb.id) from fa full join fb using (k) group by k order by k nulls first", true)
        check(mut &s, mut &g, "select k, fa.id, fb.id from fa full join fb using (k) where k > 300 order by k, 2 nulls first, 3 nulls first", true)
        check(mut &s, mut &g, "select * from fa full join fb using (id, k)", true)
        check(mut &s, mut &g, "select id, k from fa natural full join fb", true)
        // a join after it, a view, a subquery around it
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + on + " join fc on fc.k = coalesce(fa.k, fb.k)", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + on + " left join fc on fc.k = fb.k and fc.x < 10", true)
        check(mut &s, mut &g, "select fa.id, fv.n from fa full join fv on fa.k = fv.k", true)
        check(mut &s, mut &g, "select sum(d.n), count(*) from (select fa.id as a, fb.id as b, fa.v + fb.w as n from " + on + ") d where d.a is null or d.b is null", true)
        // a larger table first, a smaller one first
        check(mut &s, mut &g, "select fb.id, fc.id from fb full join fc on fb.k = fc.k", true)
        check(mut &s, mut &g, "select fc.id, fb.id from fc full join fb on fb.k = fc.k", true)
        // errors in a later batch: the select list, ON, WHERE
        check(mut &s, mut &g, "select 100 / (fa.id - 1400), fb.id from " + on, true)
        check(mut &s, mut &g, "select fa.id, fb.id from fa full join fb on fa.k = fb.k and 100 / (fb.id - 1250) > 0", true)
        check(mut &s, mut &g, "select fa.id, fb.id from " + on + " where 100 / (coalesce(fb.id, 0) - 1290) > 0", true)
        report("full", &g)

        // two and three RIGHT or FULL joins in a query: each hash its own marks, the unmatched rows given
        // level by level (what one level's tail joins to a later level is noted before that level's tail)
        g = newGroup()
        let two = "fa full join fb on fa.k = fb.k full join fc on fc.k = fb.k"
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + two, true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa full join fb on fa.k = fb.k full join fc on fc.k = fa.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa full join fb on fa.k = fb.k full join fc on fc.k = coalesce(fa.k, fb.k)", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa full join fb on fa.k = fb.k full join fc on fc.k = fb.k and fc.x < 20 and fa.v > 100", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa right join fb on fa.k = fb.k right join fc on fc.k = fb.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa right join fb on fa.k = fb.k full join fc on fc.k = fb.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa full join fb on fa.k = fb.k right join fc on fc.k = fb.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa left join fb on fa.k = fb.k full join fc on fc.k = fb.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa join fb on fa.k = fb.k full join fc on fc.k = fb.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa full join fb on fa.k = fb.k join fc on fc.k = fb.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa full join fb on fa.k = fb.k left join fc on fc.k = fb.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa full join fb on fa.k = fb.k left join fc on fc.k = fb.k and fc.x < 5 where fc.id is null", true)
        check(mut &s, mut &g, "select count(*), count(fa.id), count(fb.id), count(fc.id), sum(fc.x) from " + two, true)
        check(mut &s, mut &g, "select fc.x, count(*), count(fa.id), count(fb.id) from " + two + " group by fc.x order by fc.x nulls first", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + two + " order by fc.id nulls first, fb.id nulls first, fa.id nulls first limit 40", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + two + " order by fa.id nulls last, fb.id nulls last, fc.id nulls last limit 12 offset 2000", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + two + " limit 50", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + two + " where fa.v > 900 or fb.w > 2000 or fc.x = 3", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + two + " where fc.id is null", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + two + " where fa.id is null and fb.id is null", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + two + " where fb.id is null", true)
        // three: a fourth table
        let three = two + " full join fd on fd.k = fc.k"
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id, fd.id from " + three, true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id, fd.id from fa full join fb on fa.k = fb.k full join fc on fc.k = fa.k full join fd on fd.k = fb.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id, fd.id from fa right join fb on fa.k = fb.k right join fc on fc.k = fb.k right join fd on fd.k = fc.k", true)
        check(mut &s, mut &g, "select count(*), count(fa.id), count(fb.id), count(fc.id), count(fd.id), sum(fd.y) from " + three, true)
        check(mut &s, mut &g, "select fd.y, count(*), count(fa.id) from " + three + " group by fd.y order by fd.y nulls first", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id, fd.id from " + three + " order by fd.id desc nulls last, fc.id nulls first, fb.id nulls first, fa.id nulls first limit 33", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id, fd.id from " + three + " where fa.id is null or fd.id is null", true)
        // USING, chained
        check(mut &s, mut &g, "select k, fa.id, fb.id, fc.id from fa full join fb using (k) full join fc using (k)", true)
        check(mut &s, mut &g, "select * from fa full join fb using (k) full join fc using (k)", true)
        check(mut &s, mut &g, "select k, count(*), count(fa.id), count(fb.id), count(fc.id) from fa full join fb using (k) full join fc using (k) group by k order by k nulls first", true)
        check(mut &s, mut &g, "select k, fa.id, fb.id, fc.id, fd.id from fa full join fb using (k) full join fc using (k) full join fd using (k) where k < 100", true)
        // a view and a subquery as a level, empty sides
        check(mut &s, mut &g, "select fa.id, fv.n, fc.id from fa full join fv on fa.k = fv.k full join fc on fc.k = fv.k", true)
        check(mut &s, mut &g, "select fa.id, fe.id, fc.id from fa full join fe on fa.k = fe.k full join fc on fc.k = fa.k", true)
        check(mut &s, mut &g, "select fe.id, fa.id, fc.id from fe full join fa on fa.k = fe.k full join fc on fc.k = fa.k", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fe.id from fa full join fb on fa.k = fb.k full join fe on fe.k = fb.k", true)
        check(mut &s, mut &g, "select count(*), count(a), count(b), count(c) from (select fa.id as a, fb.id as b, fc.id as c from " + two + ") d where a is null or c is null", true)
        // errors in a later batch
        check(mut &s, mut &g, "select 100 / (fc.id - 780), fa.id from " + two, true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from fa full join fb on fa.k = fb.k full join fc on fc.k = fb.k and 100 / (fc.id - 790) > 0", true)
        check(mut &s, mut &g, "select fa.id, fb.id, fc.id from " + two + " where 100 / (coalesce(fa.id, 0) - 1450) > 0", true)
        report("multi", &g)

        // CROSS JOIN and comma joins with no key: a nested loop over batches, the hash's rows held once, each
        // outer batch crossed with them in pieces of BROWS pairs, a pair's conditions as any join's
        g = newGroup()
        check(mut &s, mut &g, "select count(*) from x3k cross join x3", true)
        check(mut &s, mut &g, "select count(*) from x3 cross join x3k", true)
        check(mut &s, mut &g, "select a.id, b.id from x3 a cross join x3k b", true)
        check(mut &s, mut &g, "select a.id, b.id from x3k a cross join x3 b", true)
        check(mut &s, mut &g, "select a.id, b.id, a.v, b.v from x3 a, x3 b", true)
        check(mut &s, mut &g, "select a.id, b.id from x1 a cross join x3k b", true)
        check(mut &s, mut &g, "select a.id, b.id from x3k a cross join x1 b", true)
        check(mut &s, mut &g, "select a.id, b.id from x0 a cross join x3k b", true)
        check(mut &s, mut &g, "select a.id, b.id from x3k a cross join x0 b", true)
        check(mut &s, mut &g, "select count(*) from x0 a cross join x0 b", true)
        check(mut &s, mut &g, "select count(*), sum(a.v), sum(b.v) from x3k a cross join x3 b", true)
        check(mut &s, mut &g, "select a.id, b.id from x3 a cross join x3k b order by b.id desc, a.id limit 20", true)
        check(mut &s, mut &g, "select a.id, b.id from x3 a cross join x3k b limit 25", true)
        check(mut &s, mut &g, "select a.id, b.id from x3 a cross join x3k b limit 5 offset 4000", true)
        check(mut &s, mut &g, "select distinct a.v, b.v % 7 from x3 a cross join x3k b order by 1 nulls first, 2", true)
        check(mut &s, mut &g, "select a.id, count(*), sum(b.v) from x3 a cross join x3k b group by a.id order by a.id", true)
        // a condition on the pair (not a key), over 3,000 x 3,000 pairs too
        check(mut &s, mut &g, "select a.id, b.id from x3 a, x3k b where a.v < b.v and b.v < 20 order by 1, 2", true)
        check(mut &s, mut &g, "select a.id, b.id from x3k a join x3k b on a.id < b.id and b.id < a.id + 3", true)
        check(mut &s, mut &g, "select count(*), sum(a.id), sum(b.id) from x3k a cross join x3k b where a.v + b.v = 3000", true)
        check(mut &s, mut &g, "select count(*), sum(a.id + b.id) from x3k a, x3k b where (a.id * 7 + b.id * 3) % 1001 = 0", true)
        check(mut &s, mut &g, "select a.id, b.id from x3k a, x3k b where a.v > 5990 and b.v < 8 and a.id <> b.id", true)
        check(mut &s, mut &g, "select a.id, b.id from x3 a cross join x3k b where a.v is null", true)
        check(mut &s, mut &g, "select a.id, b.id from x3 a cross join x3k b where a.v + b.v > 6000 or b.id < 3", true)
        // more levels: crossed with each other, then a hash or a lookup, a LEFT JOIN or an outer join after
        check(mut &s, mut &g, "select a.id, b.id, c.id from x3 a, x3 b, x3 c", true)
        check(mut &s, mut &g, "select a.id, b.id, c.id from x3 a cross join x1 b cross join x3k c where c.id < 10", true)
        check(mut &s, mut &g, "select a.id, c.id, b.id from x3 a cross join x3k c cross join x3 b where c.id % 1000 = 0", true)
        check(mut &s, mut &g, "select count(*) from x3k a cross join x3 b cross join x3 c", true)
        check(mut &s, mut &g, "select a.id, b.id, fa.id from x3 a cross join x3k b join fa on fa.k = b.id % 400 where b.id < 5", true)
        check(mut &s, mut &g, "select a.id, b.id, fa.id from x3 a cross join x3 b left join fa on fa.k = a.id + b.id", true)
        check(mut &s, mut &g, "select a.id, b.id, fa.id from x3 a cross join x3 b full join fb fa on fa.k = a.id + b.id + 100", true)
        check(mut &s, mut &g, "select a.id, b.id, fa.id from x3 a cross join x3 b right join fa on fa.k = a.id + b.id", true)
        check(mut &s, mut &g, "select x3.id, fa.id, x3k.id from x3 cross join fa join x3k on x3k.id = fa.k + x3.id", true)
        check(mut &s, mut &g, "select a.id, b.id from x3 a cross join x3 b left join x3k c on c.id = a.id and b.id > 1 where c.id is null", true)
        // a view, VALUES, a derived table and a series as the crossed level
        check(mut &s, mut &g, "select a.id, v.z from x3 a cross join (values (1), (2), (3)) v(z)", true)
        check(mut &s, mut &g, "select a.id, d.n from x3k a cross join (select count(*) as n from fa) d where a.id < 5", true)
        check(mut &s, mut &g, "select a.id, v.n from x3 a cross join fv v where v.k < 10", true)
        check(mut &s, mut &g, "select a.id, g from x3 a cross join generate_series(1, 2000) g", true)
        // errors in a later batch: the select list, a pair's condition, a WHERE
        check(mut &s, mut &g, "select 100 / (b.id - 2500), a.id from x3 a cross join x3k b", true)
        check(mut &s, mut &g, "select a.id, b.id from x3 a cross join x3k b where 100 / (b.id - 2600) > 0", true)
        check(mut &s, mut &g, "select a.id, b.id from x3 a join x3k b on 100 / (a.id + b.id - 2800) > 0", true)
        check(mut &s, mut &g, "select a.id, b.id from x3k a join x3k b on a.id = 3 and b.id > 2990 and 100 / (b.id - 2995) > 0", true)
        report("cross", &g)

        // MERGE with WHEN NOT MATCHED BY SOURCE (a RIGHT join of the source and the target, FULL with NOT MATCHED too),
        // the clauses' rules and the first match per target row as the row engine's
        g = newGroup()
        let upd = "when matched then update set v = m.v "
        let ins = "when not matched then insert (id, v, w, r, name) values (m.k, m.v, 1, 1, 'new') "
        let bys = "when not matched by source then delete"
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k " + upd + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when not matched by source then update set v = -tg.v", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when not matched by source and tg.id % 2 = 0 then delete when not matched by source then update set v = 0", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when matched and m.k > 3000 then delete " + upd + " when not matched by source and tg.id > 3000 then do nothing " + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k " + upd + ins + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k " + upd + ins + "when not matched by source then update set name = 'gone'", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k " + ins + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when matched and m.k % 3 = 0 then update set v = m.v when not matched and m.k < 4500 then insert (id, v, w, r) values (m.k, 1, 1, 1) when not matched by source and tg.id % 7 = 0 then delete", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k " + upd + ins + "when not matched by source then do nothing", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k " + upd + bys + " returning merge_action(), tg.id, m.k, tg.v", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k " + upd + ins + bys + " returning merge_action(), tg.id, m.k, tg.v, tg.name", true)
        // other sources: VALUES (rows the run holds), a view, a derived table, NULL and repeated keys
        mcheck(mut &s, mut &g, "merge into tg using " + values(3000, 1500) + " on tg.id = x.k when matched then update set v = x.v " + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using " + values(3500, 1200) + " on tg.id = x.k when matched then update set v = x.v when not matched then insert (id, v, w, r) values (x.k, x.v, 2, 2) " + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using msv m on tg.id = m.k when matched then update set v = m.v " + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using (select k, v from msrc where k > 2000) m on tg.id = m.k when matched then update set v = m.v when not matched by source then update set v = 1", true)
        mcheck(mut &s, mut &g, "merge into tg using mnull m on tg.id = m.k when not matched by source then update set v = 2", true)
        mcheck(mut &s, mut &g, "merge into tg using mnull m on tg.id = m.k " + ins + "when not matched by source and tg.id < 100 then delete", true)
        mcheck(mut &s, mut &g, "merge into tg using mnull m on tg.id = m.k when matched then update set v = m.v " + bys, true)
        // errors: a target matched twice (21000), a CHECK, a foreign key, an expression, a unique violation, in a later batch; atomic
        mcheck(mut &s, mut &g, "merge into tg using mdup m on tg.id = m.k when matched then update set v = m.v " + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using mdup m on tg.id = m.k when matched then delete when not matched by source then update set v = 3", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when not matched by source and tg.id > 3500 then update set w = -1", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when not matched by source and tg.id > 3900 then update set r = 9999", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when not matched by source then update set v = 100 / (tg.id - 3990)", true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when matched then update set v = 100 / (m.k - 3990) " + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when not matched then insert (id, v, w, r) values (m.k % 100, m.v, 1, 1) " + bys, true)
        mcheck(mut &s, mut &g, "merge into tg using msrc m on tg.id = m.k when not matched by source and tg.id <= 1900 then delete", true)
        // T-SQL: WHEN NOT MATCHED BY SOURCE, BY TARGET, TOP and OUTPUT
        mcheck(mut &s, mut &g, "T: MERGE tg USING msrc m ON tg.id = m.k WHEN MATCHED THEN UPDATE SET v = m.v WHEN NOT MATCHED BY SOURCE THEN DELETE;", true)
        mcheck(mut &s, mut &g, "T: MERGE tg USING msrc m ON tg.id = m.k WHEN NOT MATCHED BY TARGET THEN INSERT (id, v, w, r) VALUES (m.k, m.v, 1, 1) WHEN NOT MATCHED BY SOURCE THEN UPDATE SET v = -1 OUTPUT $action, inserted.id, deleted.id;", true)
        mcheck(mut &s, mut &g, "T: MERGE TOP (700) tg USING msrc m ON tg.id = m.k WHEN MATCHED THEN UPDATE SET v = 7 WHEN NOT MATCHED BY SOURCE THEN DELETE;", true)
        mcheck(mut &s, mut &g, "T: MERGE tg USING mdup m ON tg.id = m.k WHEN MATCHED THEN UPDATE SET v = m.v WHEN NOT MATCHED BY SOURCE THEN DELETE;", true)
        // not batched: a few source rows (held, under a batch), and an ON with no key to hash on
        mcheck(mut &s, mut &g, "merge into tg using (values (1, 5), (2, 6), (5000, 7)) as x(k, v) on tg.id = x.k when matched then update set v = x.v " + bys, false)
        mcheck(mut &s, mut &g, "merge into tg using (select k, v from msrc where k < 4) m on tg.id > m.k + 3990 when matched then update set v = m.v " + bys, false)
        report("merge", &g)
        s.close()
        return 0
    }).unwrap()
}
