import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once CREATE TABLE v7 (a int, b int); INSERT INTO v7 VALUES (1, 2)\n@once CREATE VIEW v7a AS SELECT * FROM v7\n@once CREATE VIEW v7b AS SELECT v7.*, a + 10 AS x FROM v7\n@once CREATE TABLE w7 (k int, m int); INSERT INTO w7 VALUES (1, 5)\n@once CREATE VIEW v7c AS SELECT v7.*, w7.* FROM v7 JOIN w7 ON w7.k = v7.a\n@once CREATE VIEW v7d (p, q) AS SELECT * FROM v7\n@once ALTER TABLE v7 ADD c int\n@once UPDATE v7 SET c = 3\nSELECT * FROM v7a\nSELECT * FROM v7b\nSELECT * FROM v7c\nSELECT * FROM v7d\nBEGIN TRY EXEC('SELECT * FROM v7d') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nSELECT a, b FROM v7a WHERE b = 2\nSELECT COUNT(*) AS n FROM v7c v JOIN v7 t ON t.a = v.a\nSELECT column_name FROM INFORMATION_SCHEMA.COLUMNS WHERE table_name = 'v7b' ORDER BY ordinal_position\n@once @sets EXEC sp_refreshview 'v7a'\nSELECT * FROM v7a\n@once ALTER TABLE v7 DROP COLUMN c\nSELECT * FROM v7a\nSELECT * FROM dbo.v7a\nBEGIN TRY EXEC('SELECT * FROM dbo.v7a') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\n@once @sets EXEC sp_refreshview 'v7a'\nSELECT * FROM v7a\n@once CREATE TABLE base7 (a int, b int)\n@once CREATE VIEW sb7 WITH SCHEMABINDING AS SELECT a FROM dbo.base7\n@once CREATE VIEW nb7 AS SELECT a FROM dbo.base7\nBEGIN TRY EXEC('SELECT * FROM nosuch7') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('SELECT * FROM dbo.nosuch7') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('SELECT * FROM DBO.NoSuch7') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('SELECT * FROM [dbo].[nosuch7]') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('SELECT x.a FROM dbo.nosuch7 x -- dbo.other') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nSELECT * FROM dbo.nosuch7\nBEGIN TRY DROP TABLE base7 END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY DROP TABLE [dbo].[Base7] END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('CREATE VIEW dbo.sb7b WITH SCHEMABINDING AS SELECT a FROM base7') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('CREATE VIEW sb7c WITH SCHEMABINDING AS SELECT a FROM base7') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('CREATE VIEW dbo.sb7d WITH SCHEMABINDING AS SELECT a FROM [dbo].[NB7]') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('CREATE VIEW sb7e WITH SCHEMABINDING AS SELECT a FROM dbo.nb7') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('CREATE VIEW sb7f With Check Option AS SELECT a FROM dbo.base7') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('CREATE VIEW sb7g WITH CHECK OPTION AS SELECT a FROM dbo.base7') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\n@once CREATE TABLE gone7 (a int)\n@once CREATE VIEW vg7 AS SELECT a FROM dbo.gone7\n@once CREATE VIEW vg7b AS SELECT a FROM GONE7\n@once DROP TABLE gone7\nBEGIN TRY EXEC('SELECT * FROM vg7') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY EXEC('SELECT * FROM vg7b') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\n@once CREATE TABLE ix7 (a int PRIMARY KEY, b int)\n@once CREATE INDEX i7 ON ix7 (b)\nDROP INDEX i7\nDROP INDEX IF EXISTS i7\nBEGIN TRY DROP INDEX dbo.i7 END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY DROP INDEX nosuch7.i7 END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY DROP INDEX Ix7.NIX END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY DROP INDEX nix ON dbo.Ix7 END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY DROP INDEX i7 ON nosuch7 END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY DROP INDEX dbo.ix7.nix END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\n@once CREATE TABLE uq7 (a int CONSTRAINT uq7_a UNIQUE, b int CONSTRAINT pk_u7 PRIMARY KEY)\nBEGIN TRY DROP INDEX uq7.pk_u7 END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY DROP INDEX UQ7_A ON dbo.UQ7 END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nBEGIN TRY DROP INDEX dbo.uq7.uq7_a END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_MESSAGE() AS m END CATCH\nSELECT i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name IN ('ix7', 'uq7') AND i.name IS NOT NULL AND i.is_primary_key = 0 ORDER BY 1\n@once DROP INDEX i7 ON ix7\nSELECT i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name = 'ix7' AND i.name IS NOT NULL AND i.is_primary_key = 0 ORDER BY 1\nSELECT domain_schema, domain_name, data_type FROM INFORMATION_SCHEMA.DOMAINS\n@once CREATE ROLE r7\n@once GRANT SELECT ON ix7 TO r7\nSELECT grantee, table_name, column_name, privilege_type FROM INFORMATION_SCHEMA.COLUMN_PRIVILEGES\n@once CREATE SCHEMA s7 AUTHORIZATION r7\n@once CREATE SCHEMA s7b\nSELECT schema_name, schema_owner FROM INFORMATION_SCHEMA.SCHEMATA WHERE schema_name IN ('s7', 's7b') ORDER BY 1\nSELECT s.name, p.name AS owner FROM sys.schemas s JOIN sys.database_principals p ON p.principal_id = s.principal_id WHERE s.name IN ('s7', 's7b') ORDER BY 1"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(81), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
