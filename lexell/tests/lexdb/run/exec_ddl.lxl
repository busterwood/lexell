import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table tv (id int primary key, v int, w text)\ninsert into tv values (1, 10, 'a'), (2, 20, 'b')\ncreate view vv as select id, v from tv\nselect * from vv order by id\ncreate or replace view vv as select id, v, w from tv\nselect * from vv order by id\ncreate or replace view vv as select id, v, w from tv where id > 1\nselect * from vv order by id\ncreate or replace view vv as select id, w from tv\ncreate or replace view vv as select w, id, v from tv\ncreate or replace view vv as select id, v::bigint as v, w from tv\ncreate or replace view vv as select id, v, w, v * 2 as dbl from tv where id < 3\nselect * from vv order by id\ncreate or replace view vnew as select id from tv\nselect * from vnew\ncreate or replace view vv (a, b, c, d) as select id, v, w, v * 2 from tv\ncreate or replace view vv (id, v, w, dbl) as select id, v, w, v + 1 from tv\nselect * from vv order by id\ncreate or replace view tv as select 1 as a\ncreate or replace view vv2 as select id, w from vv\ncreate or replace view vv as select id, v, w, v + 1 as dbl, 'x' as extra from tv\nselect * from vv2 order by id\nselect * from vv order by id\ncreate view vv as select id from tv\ncreate or replace view vnone as select * from nothing_here\ncreate or replace view vbad as select nothing from tv\ncreate or alter view vca as select id from tv\ncreate or replace table tnew (a int)\ncreate or replace temp view vtemp as select id from tv\nselect * from vtemp order by id\ncreate or replace temp view vtemp as select id, v from tv\nselect * from vtemp order by id\nbegin\ncreate or replace view vv as select id, v, w, v + 1 as dbl, 'y' as extra from tv\nselect extra from vv where id = 1\nrollback\nselect extra from vv where id = 1\ndrop role if exists vu\ncreate user vu\ngrant select on vv to vu\ncreate or replace view vv as select id, v, w, v + 1 as dbl, 'x' as extra, 1 as more from tv\nselect has_table_privilege('vu', 'vv', 'select')\ncreate table ra (id int primary key, v int, w text)\ncreate index ix_ra_v on ra (v)\ncreate unique index ux_ra_w on ra (w)\nalter table ra add constraint ck_ra check (length(w) > 0 and v > 0)\ninsert into ra values (1, 10, 'a'), (2, 20, 'b')\ncreate table rb (id int primary key, ra_id int references ra (id), note text)\ninsert into rb values (1, 1, 'n1'), (2, 2, 'n2')\ncreate view va as select id, v from ra\ncreate view vastar as select * from ra\ncreate view vaj as select ra.v, x.id as xid, rb.note from ra, ra x, rb where ra.id = x.id and rb.ra_id = ra.id\ncreate view vasub as select id, (select count(*) from ra r2 where r2.v < ra.v) as less from ra where id in (select ra_id from rb)\ncreate view vacte as with c as (select id, v from ra) select id, v * 2 as dbl from c\ncreate view vav as select id from va\nalter table ra rename to ra2\nselect * from va order by id\nselect * from vastar order by id\nselect * from vaj order by v\nselect * from vasub order by id\nselect * from vacte order by id\nselect * from vav order by id\nselect * from ra\nselect * from ra2 order by id\ninsert into ra2 values (3, 30, 'c')\ninsert into ra2 values (4, 40, 'c')\ninsert into ra2 values (5, 50, '')\ninsert into rb values (3, 3, 'n3')\ninsert into rb values (4, 99, 'bad')\nselect id, v from ra2 where v = 30\nselect indexname from pg_indexes where tablename = 'ra2' order by indexname\nselect conname, conrelid::regclass from pg_constraint where conname = 'ck_ra'\nselect conrelid::regclass, confrelid::regclass from pg_constraint where contype = 'f'\nselect * from va order by id\nselect viewname from pg_views where viewname like 'va%' order by viewname\nalter table ra2 rename column v to vx\nselect * from va order by id\nselect * from vastar order by id\nselect * from vaj order by v\nselect * from vasub order by id\nselect * from vacte order by id\nselect vx from ra2 order by id\nselect v from ra2\nselect count(*) from ra2 where vx = 30\ninsert into ra2 (id, vx, w) values (6, 60, 'f')\ninsert into ra2 (id, vx, w) values (7, -1, 'g')\nselect attname from pg_attribute where attrelid = 'ra2'::regclass and attnum > 0 order by attnum\nselect indexdef from pg_indexes where indexname = 'ix_ra_v'\nalter table ra2 rename column id to idx\nselect * from va order by id\nselect * from vav order by id\nselect * from vaj order by v\nalter table ra2 rename column vx to vy\nalter table ra2 rename column vy to v\nselect * from va order by id\nselect * from vastar order by id\nalter table ra2 rename to ra3\nalter table ra3 rename to ra\nselect * from va order by id\nselect * from vaj order by v\ncreate table ra2 (id int, v int, w text)\ninsert into ra2 values (100, 100, 'z')\nselect * from va order by id\nselect * from ra2\nalter table ra rename column idx to id\nalter table ra rename column w to ww\nselect * from vastar order by id\nselect * from vaj order by v\nalter table ra rename column ww to w\nselect * from vastar order by id\nalter table ra2 rename column v to vz\nselect * from va order by id\nalter table ra2 rename to ra9\nselect * from va order by id\ndrop table ra9\ncreate table rc (id int primary key, n int)\ninsert into rc values (1, 1), (2, 2)\ncreate view vc as select id, n from rc\nbegin\nalter table rc rename to rc2\nselect * from vc order by id\nalter table rc2 rename column n to m\nselect * from vc order by id\nrollback\nselect * from vc order by id\nalter table rc rename to rc2\nalter table rc2 rename column n to m\nbegin\nalter table rc2 rename to rc3\ncreate view vc3 as select id, m from rc3\nalter table rc3 rename to rc4\nselect * from vc3 order by id\nselect * from vc order by id\ncommit\nselect * from vc3 order by id\nselect * from vc order by id\nalter table rc4 add column k int default 7\nselect * from vc order by id\nselect k from rc4 order by id\nalter view vc rename to vcc\nselect * from vcc order by id\nalter view vcc rename to vc\ncreate view vcv as select id from vc\nalter view vc rename to vc2\nselect * from vcv order by id\nselect * from vc2 order by id\nalter view vc2 rename to vc\nselect * from vcv order by id\nalter table rc4 rename to rc4\nalter table rc4 rename to rb\nalter table rc4 rename to vc\nalter table nothere rename to x\nalter table if exists nothere rename to x\nalter table rc4 rename column m to id\nalter table rc4 rename column m to m\nalter table rc4 rename column nocol to x\nalter table rc4 rename column m to n\nalter view vc rename to vcv\nalter view nothere rename to x\nalter view rc4 rename to x\ndrop table rc4\ndrop table rc4 cascade\nselect * from vc\nselect * from vc3\ncreate schema s9\ncreate table s9.t (a int, b int)\ncreate view s9.vt as select a, b from s9.t\nalter table s9.t rename to t2\nalter table s9.t2 rename column a to aa\nselect * from s9.vt\nset search_path = s9, public\ncreate view vs as select aa from t2\nalter table t2 rename to t3\nselect * from vs\nselect * from s9.vt\nreset search_path\ncreate temp table tt (a int)\ncreate temp view tv as select a from tt\nalter table tt rename to tt2\nalter table tt2 rename column a to b\nselect * from tv"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag.clone()) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(140), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
