// lexdb_exec: the DDL forms of design/lexdb-dialect-gaps.md package B, checked against PostgreSQL 18
// (generated by tests/lexdb/gen_pg.py from ddl_queries.txt): CREATE OR REPLACE VIEW (new columns
// appended only, 42P16 otherwise), ALTER TABLE ... RENAME [COLUMN] with views following, and
// ALTER COLUMN ... TYPE [USING] (rows cast, indexes and constraints kept, a view on the column
// refusing it, a failed cast leaving the table, rollback, a large table).
// Each expect line: a query's rows or tag, or ERROR and its SQLSTATE.
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: CREATE VIEW
// expect: 1|10;2|20
// expect: CREATE VIEW
// expect: 1|10|a;2|20|b
// expect: CREATE VIEW
// expect: 2|20|b
// expect: ERROR 42P16
// expect: ERROR 42P16
// expect: ERROR 42P16
// expect: CREATE VIEW
// expect: 1|10|a|20;2|20|b|40
// expect: CREATE VIEW
// expect: 1;2
// expect: ERROR 42P16
// expect: CREATE VIEW
// expect: 1|10|a|11;2|20|b|21
// expect: ERROR 42809
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: 1|a;2|b
// expect: 1|10|a|11|x;2|20|b|21|x
// expect: ERROR 42P07
// expect: ERROR 42P01
// expect: ERROR 42703
// expect: ERROR 42601
// expect: ERROR 42601
// expect: CREATE VIEW
// expect: 1;2
// expect: CREATE VIEW
// expect: 1|10;2|20
// expect: BEGIN
// expect: CREATE VIEW
// expect: y
// expect: ROLLBACK
// expect: x
// expect: DROP ROLE
// expect: CREATE ROLE
// expect: GRANT
// expect: CREATE VIEW
// expect: t
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table tv (id int primary key, v int, w text)\ninsert into tv values (1, 10, 'a'), (2, 20, 'b')\ncreate view vv as select id, v from tv\nselect * from vv order by id\ncreate or replace view vv as select id, v, w from tv\nselect * from vv order by id\ncreate or replace view vv as select id, v, w from tv where id > 1\nselect * from vv order by id\ncreate or replace view vv as select id, w from tv\ncreate or replace view vv as select w, id, v from tv\ncreate or replace view vv as select id, v::bigint as v, w from tv\ncreate or replace view vv as select id, v, w, v * 2 as dbl from tv where id < 3\nselect * from vv order by id\ncreate or replace view vnew as select id from tv\nselect * from vnew\ncreate or replace view vv (a, b, c, d) as select id, v, w, v * 2 from tv\ncreate or replace view vv (id, v, w, dbl) as select id, v, w, v + 1 from tv\nselect * from vv order by id\ncreate or replace view tv as select 1 as a\ncreate or replace view vv2 as select id, w from vv\ncreate or replace view vv as select id, v, w, v + 1 as dbl, 'x' as extra from tv\nselect * from vv2 order by id\nselect * from vv order by id\ncreate view vv as select id from tv\ncreate or replace view vnone as select * from nothing_here\ncreate or replace view vbad as select nothing from tv\ncreate or alter view vca as select id from tv\ncreate or replace table tnew (a int)\ncreate or replace temp view vtemp as select id from tv\nselect * from vtemp order by id\ncreate or replace temp view vtemp as select id, v from tv\nselect * from vtemp order by id\nbegin\ncreate or replace view vv as select id, v, w, v + 1 as dbl, 'y' as extra from tv\nselect extra from vv where id = 1\nrollback\nselect extra from vv where id = 1\ndrop role if exists vu\ncreate user vu\ngrant select on vv to vu\ncreate or replace view vv as select id, v, w, v + 1 as dbl, 'x' as extra, 1 as more from tv\nselect has_table_privilege('vu', 'vv', 'select')"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag.clone()) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(140), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
