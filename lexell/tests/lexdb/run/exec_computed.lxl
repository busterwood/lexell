import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table g (id int primary key, a int, b int, s int generated always as (a + b) stored, v int generated always as (a * 2) virtual, d int generated always as (a - 1))\nselect attname, attgenerated, atthasdef from pg_attribute where attrelid = 'g'::regclass and attnum > 0 order by attnum\nselect column_name, is_generated, generation_expression, column_default, is_updatable from information_schema.columns where table_name = 'g' order by ordinal_position\nselect a.attname, pg_get_expr(d.adbin, d.adrelid) from pg_attrdef d join pg_attribute a on a.attrelid = d.adrelid and a.attnum = d.adnum where d.adrelid = 'g'::regclass order by a.attnum\ninsert into g (id, a, b) values (1, 2, 3), (2, null, 4), (3, 5, null)\nselect * from g order by id\ninsert into g values (4, 1, 1, 5, 5, 5)\ninsert into g (id, a, b, s) values (4, 1, 1, 5)\ninsert into g (id, a, b, v) values (4, 1, 1, 7)\ninsert into g values (4, 1, 1, default, default, default)\ninsert into g (id, a, b, s, v) values (5, 6, 7, default, default)\nselect * from g order by id\nupdate g set s = 10 where id = 1\nupdate g set v = 10 where id = 1\nupdate g set d = default where id = 1\nupdate g set a = 10 where id = 1\nupdate g set b = 100, a = a + 1 where id = 2\nselect * from g order by id\nupdate g set b = 100 where id = 3 returning id, s, v, d\nupdate g set b = 100 where id <> 3\nupdate g set a = null\nselect * from g order by id\nselect s, v, d from g where id = 1\ninsert into g (id, a, b) values (6, 1, 1) returning s, v, d\ninsert into g (id, a, b) select id + 10, a, b from g where a is not null\nselect * from g where id > 10 order by id\ninsert into g (id, a, b) values (11, 7, 7) on conflict (id) do update set a = excluded.a + 1\nselect id, a, s, v from g where id = 11\ninsert into g (id, a, b) values (11, 7, 7) on conflict (id) do update set s = 1\ninsert into g (id, a, b) values (11, 7, 7) on conflict (id) do update set s = default\ninsert into g (id, a, b) values (11, 7, 7) on conflict (id) do nothing\ndelete from g where id > 10\ncreate index g_s on g (s)\ncreate unique index g_u on g (s)\ncreate index g_v on g (v)\ncreate index g_vx on g ((v + 1))\ncreate index g_sx on g ((s * 2))\nselect id from g where s = 10 order by id\nselect id from g where s * 2 = 20 order by id\nselect indexname, indexdef from pg_indexes where tablename = 'g' order by 1\ninsert into g (id, a, b) values (20, 1, 1), (21, 1, 1)\nselect id, s from g where id > 19 order by id\ncreate table h1 (a int, b int generated always as (a * 2) stored, c int generated always as (b + 1) stored)\ncreate table h2 (a int, b int generated always as (a * 2) stored, c int generated always as (b + 1) virtual)\ncreate table h3 (a int, b int generated always as (random()::int) stored)\ncreate table h4 (a int, b int generated always as (now()::date - current_date) stored)\ncreate table h5 (a int, b int generated always as ((select 1)) stored)\ncreate table h6 (a int, b int generated always as (count(*)) stored)\ncreate table h7 (a int, b int generated always as (a) stored default 3)\ncreate table h8 (a int, b int generated by default as (a) stored)\ncreate table h9 (a int, b int generated always as (nope + 1) stored)\ncreate table h10 (a int, b int generated always as (b + 1) stored)\ncreate table h11 (a int, b int generated always as (a) stored not null, c text generated always as (a::text || 'x') stored check (c <> 'x'))\ninsert into h11 (a) values (1)\ninsert into h11 (a) values (null)\ninsert into h11 values (1, default, default)\nselect * from h11 order by a\nupdate h11 set a = null\nalter table h11 add constraint h11_u unique (c)\ninsert into h11 (a) values (1)\ncreate table h12 (a int primary key, b int generated always as (a + 1) stored unique, c int generated always as (a + 2) virtual)\ninsert into h12 (a) values (1), (2)\ninsert into h12 (a) values (1)\nselect * from h12 order by a\ncreate table h13 (a int, b int generated always as (a + 1) virtual primary key)\ncreate table h14 (a int, b int generated always as (a + 1) virtual unique)\ncreate table h15 (a int, b int generated always as (a + 1) virtual not null)\ncreate table h16 (a int, b int generated always as (a + 1) virtual check (b > 0))\ninsert into h16 (a) values (1), (null)\ncreate table h17 (t text, n text generated always as (upper(t) || '!') stored, l int generated always as (length(t)) virtual, r numeric(8,2) generated always as (length(t) / 3.0) stored)\ninsert into h17 values ('abc'), ('x'), (null), ('')\nselect * from h17 order by t\nselect t, n, l, r from h17 where l > 0 order by t\nalter table g add column w int generated always as (a + 100) stored\nalter table g add column w2 int generated always as (a + 100) virtual\nalter table g add column w3 int generated always as (a + 100)\nalter table g add column w4 int generated always as (nope + 100) stored\nalter table g add column w5 int generated always as (s + 100) stored\nalter table g add column w6 int generated always as (a + 1) stored not null\nselect id, a, w, w2, w3 from g order by id\nalter table g add column w7 int generated always as (1 / (a - 1)) stored\ncreate table k (a int, b int generated always as (a + 1) stored)\ninsert into k (a) select x from generate_series(1, 3) as x\nselect * from k order by a\nalter table k add column c int generated always as (b * 2) stored\nalter table k add column c int generated always as (a * 2) stored\nselect * from k order by a\nalter table k rename column a to z\nselect attname, attgenerated from pg_attribute where attrelid = 'k'::regclass and attnum > 0 order by attnum\nselect column_name, generation_expression from information_schema.columns where table_name = 'k' and generation_expression is not null order by ordinal_position\ninsert into k (z) values (10)\nselect * from k order by z\nalter table k rename column b to bb\ninsert into k (z) values (11)\nselect z, bb, c from k order by z\nalter table k alter column z type bigint\nalter table k alter column z type bigint using z::bigint\nalter table k alter column bb type bigint\nalter table k alter column bb type bigint using bb\nalter table k alter column c type numeric(10,2)\nselect z, bb, c from k order by z\ninsert into k (z) values (12)\nselect bb, c, pg_typeof(bb), pg_typeof(c) from k where z = 12\nalter table k alter column c set default 5\nalter table k alter column c set not null\nalter table k drop column z\nalter table k drop column z cascade\nselect column_name from information_schema.columns where table_name = 'k' order by ordinal_position\ncreate view vk as select * from g\nselect id, s, v from vk where id = 1\ncreate table cp as select id, s, v from g\nselect * from cp order by id limit 2\nselect attname, attgenerated from pg_attribute where attrelid = 'cp'::regclass and attnum > 0 order by attnum\nbegin\ninsert into g (id, a, b) values (30, 1, 2)\nselect s, v from g where id = 30\nrollback\nselect count(*) from g where id = 30\ndrop table g"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag.clone()) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(123), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
