import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_plan"
import "../../../cmd/lexdb_ops"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            var out: []str = []
            for r in rs {
                for row in r.rows {
                    var vs: []str = []
                    for k in 0..len(row) { append(mut &vs, if lexdb_ops.isNull(&row[k]) { "NULL" } else { s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 }) }) }
                    append(mut &out, strings.join(&vs, "|"))
                }
            }
            return strings.join(&out, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// each statement with the row engine and with batches, in a transaction rolled back (a write's rows the same both times)
fn two(s: mut &lexdb_exec.Session, label: &str, sql: &str) {
    let x = q(s, &"set lexdb_batch = off")
    let b0 = q(s, &"begin")
    let off = q(s, sql)
    let r0 = q(s, &"rollback")
    let y = q(s, &"set lexdb_batch = on")
    let b1 = q(s, &"begin")
    let on = q(s, sql)
    let r1 = q(s, &"rollback")
    println(label + ": " + on + ", same: " + (off == on).toStr())
}

const SETUP = "create table wa (x int, y int)\ncreate table wb (x int, y int)\ncreate table wc (x int, z int)\ncreate table we (x int)\ninsert into wa values (1, 10), (2, 20), (2, 20)\ninsert into wb values (1, 1), (3, 3), (null, 7)\ninsert into wc values (1, 5), (4, 6), (null, 8)\ncreate view wv as select x, y from wb\ncreate table t0 (a1 bigint)\ncreate table t1 (b0 bool)\ninsert into t0 values (9)\ncreate table t2 (a1 int)\ninsert into t2 values (8), (4)\ncreate table p (id int, c char(3), v varchar(4), t text)\ninsert into p values (1, 'a', 'a', 'a'), (2, ' a', ' a ', ' a '), (3, 'ab', 'ab ', 'ab'), (4, null, null, null), (5, 'b', 'b', 'b  '), (6, 'ab', 'ab', 'ab ')\ncreate view pv as select id, c, v, t from p\ncreate table pe (c char(3), v varchar(4), t text)\ncreate table c0 (a0 char(3))\ninsert into c0 values ('c')\ncreate table c1 (a0 varchar(4), a4 char(3))\ninsert into c1 values ('bb', ' a'), (' a', 'a ')\ncreate view c1v as select a4, a0 from c1\ncreate table c2 (a2 text, a4 char(3))\ninsert into c2 values ('ab', 'ab')\ncreate view c2v as select a4, a2 from c2\ncreate table e0 (a3 numeric(6,2), a5 bigint, a4 int, f float8)\ncreate table e1 (b2 int)\ncreate table e3 (d1 int)\ninsert into e1 values (0), (1), (1)\ninsert into e3 values (1), (1), (null)\ncreate table e4 (a3 numeric(6,2), a5 bigint, a4 int, f float8)\ninsert into e4 values (1, 5, 2, 1e10), (2, 5, 3, null), (null, null, null, null)\ncreate table r0 (c0 int, c2 numeric(10,2), f float8)\ninsert into r0 values (1, 1.5, 1.25), (2, null, null), (3, -2.25, -2.5), (4, 1234.56, 0)\ncreate table x0 (a0 numeric(6,2), s smallint, i int, b bigint)\ncreate table x1 (b2 int)\ncreate index x0_a on x0 (a0)\ncreate index x0_s on x0 (s)\ncreate index x0_i on x0 (i)\ncreate index x0_b on x0 (b)\ninsert into x0 values (12.5, 3, 7, 9), (9999.99, 32767, 2147483647, 9223372036854775807), (-9999.99, -32768, -2147483648, -9223372036854775807), (null, null, null, null), (12.5, 3, 7, 9)\ninsert into x1 values (1), (2)\ncreate table x2 (a0 numeric(6,2), s smallint)\ncreate index x2_a on x2 (a0)\ncreate index x2_s on x2 (s)"

const QS = "W1 doc, t1 empty, right join\tselect 1 from t1 as q1, t0 as q2 right join t0 as q3 on true\nW1 doc, full join on false\tselect count(*) from t2 as q1, (select 1 from t2 as q3) as d2 full join t2 as q10 on false\nW1 right join\tselect * from wa, wb right join wc on wb.x = wc.x order by 1, 2, 3, 4, 5, 6\nW1 full join\tselect * from wa, wb full join wc on wb.x = wc.x order by 1, 2, 3, 4, 5, 6\nW1 left join\tselect * from wa, wb left join wc on wb.x = wc.x order by 1, 2, 3, 4, 5, 6\nW1 inner join\tselect * from wa, wb join wc on wb.x = wc.x order by 1, 2, 3, 4, 5, 6\nW1 empty first\tselect count(*) from we, wb right join wc on wb.x = wc.x\nW1 empty right\tselect count(*) from wa, wb right join we on wb.x = we.x\nW1 empty left of full\tselect count(*), count(we.x), count(wc.x) from wa, we full join wc on we.x = wc.x\nW1 qualified columns\tselect wa.y, wb.y, wc.z from wa, wb right join wc on wb.x = wc.x where wc.z > 5 order by 1, 2, 3\nW1 a star of the tree\tselect wc.*, wb.* from wa, wb right join wc on wb.x = wc.x where wa.x = 1 order by 1, 2, 3, 4\nW1 unqualified names\tselect y, z from wa, wb w2 right join wc on w2.x = wc.x order by 1, 2\nW1 ambiguous name\tselect x from wa, wb right join wc on wb.x = wc.x\nW1 view\tselect count(*), count(wv.y) from wa, wv right join wc on wv.x = wc.x\nW1 derived table\tselect count(*), count(d.y) from wa, (select x, y from wb where y < 5) d full join wc on d.x = wc.x\nW1 CTE\twith k as (select x, y from wb) select count(*), count(k.y), count(wc.z) from wa, k full join wc on k.x = wc.x\nW1 inside LATERAL\tselect wa.x, l.n from wa, lateral (select count(*) as n from wb, wa a2 right join wc on a2.x = wc.x where a2.x is null or a2.x <> wa.x) l order by 1, 2\nW1 inside a subquery\tselect (select count(*) from wa, wb full join wc on wb.x = wc.x) from we union all select 1 order by 1\nW1 three in the tree\tselect count(*), count(wb.x), count(wc.x), count(w3.x) from wa, wb right join wc on wb.x = wc.x full join wb w3 on w3.x = wc.x\nW1 two trees\tselect count(*), count(a2.x), count(wb.x) from wa a2 right join wc on a2.x = wc.x, wb right join wc c2 on wb.x = c2.x\nW1 a tree then a comma\tselect count(*) from wa, wb right join wc on wb.x = wc.x, we\nW1 a tree then items\tselect count(*) from wa, wb right join wc on wb.x = wc.x, wb w4\nW1 a later LATERAL sees the tree\tselect wa.x, wc.x, l.s from wa, wb right join wc on wb.x = wc.x, lateral (select wa.y + wc.z as s) l order by 1, 2, 3\nW1 LATERAL in the tree\tselect wa.x, l.x, wc.z from wa, lateral (select wa.x as x) l right join wc on l.x = wc.x order by 1, 2, 3\nW1 USING in the tree\tselect * from wa, wb full join wc using (x) order by 1, 2, 3, 4, 5\nW1 the USING name\tselect x, d.y from (select y from wa) d, wb full join wc using (x) order by 1, 2\nW1 the USING name, ambiguous\tselect x from wa, wb full join wc using (x)\nW1 NATURAL in the tree\tselect count(*) from wa, wb natural full join wc\nW1 WHERE on the tree\tselect wa.x, wb.y, wc.z from wa, wb right join wc on wb.x = wc.x where wb.y is null order by 1, 2, 3\nW1 GROUP BY\tselect wc.z, count(*) from wa, wb right join wc on wb.x = wc.x group by wc.z order by 1\nW1 a name twice\tselect 1 from wa, wb right join wa on true\nW1 a name twice, later\tselect 1 from wa a, wb right join wc on true, wc\nW1 UPDATE FROM\tupdate wa set y = y from wb right join wc on wb.x = wc.x where wa.x = 2 and wc.z = 6 returning wa.x, wa.y\nW1 DELETE USING\tdelete from we using wa, wb right join wc on wb.x = wc.x where we.x = wa.x returning we.x\nW1 tree first\tselect count(*) from wb right join wc on wb.x = wc.x, wa\nW2 doc, >= any\tselect 'a' from c0 as q4 where q4.a0 >= any (select q5.a0 from c0 as q5)\nW2 doc, >= all\tselect 'a' from c0 as q4 where q4.a0 >= all (select q5.a0 from c0 as q5)\nW2 doc, exists, view\tselect 'a' from c1v as q1 where exists (select 1 from c1v as q4 where q4.a0 = q1.a4)\nW2 doc, exists, table\tselect 'a' from c1 as q1 where exists (select 1 from c1 as q4 where q4.a0 = q1.a4)\nW2 doc, scalar, view\tselect (select 1 from c2v as q3 where q3.a2 = q2.a4) from c2v as q2\nW2 p c/v in\tselect o.id from p o where o.c in (select i.v from p i where i.id <> o.id) order by 1\nW2 p c/v not in\tselect o.id from p o where o.c not in (select i.v from p i where i.id <> 4) order by 1\nW2 p c/v exists\tselect o.id from p o where exists (select 1 from p i where i.v = o.c and i.id <> o.id) order by 1\nW2 p c/v scalar\tselect o.id, (select count(*) from p i where i.v = o.c) from p o order by 1\nW2 p c/v > any\tselect o.id from p o where o.c > any (select i.v from p i where i.id <> o.id) order by 1\nW2 p c/v <= all\tselect o.id from p o where o.c <= all (select i.v from p i where i.id <> 4) order by 1\nW2 p c/v join\tselect o.id, i.id from p o join p i on o.c = i.v order by 1, 2\nW2 p v/c in\tselect o.id from p o where o.v in (select i.c from p i where i.id <> o.id) order by 1\nW2 p v/c not in\tselect o.id from p o where o.v not in (select i.c from p i where i.id <> 4) order by 1\nW2 p v/c exists\tselect o.id from p o where exists (select 1 from p i where i.c = o.v and i.id <> o.id) order by 1\nW2 p v/c scalar\tselect o.id, (select count(*) from p i where i.c = o.v) from p o order by 1\nW2 p v/c > any\tselect o.id from p o where o.v > any (select i.c from p i where i.id <> o.id) order by 1\nW2 p v/c <= all\tselect o.id from p o where o.v <= all (select i.c from p i where i.id <> 4) order by 1\nW2 p v/c join\tselect o.id, i.id from p o join p i on o.v = i.c order by 1, 2\nW2 p c/t in\tselect o.id from p o where o.c in (select i.t from p i where i.id <> o.id) order by 1\nW2 p c/t not in\tselect o.id from p o where o.c not in (select i.t from p i where i.id <> 4) order by 1\nW2 p c/t exists\tselect o.id from p o where exists (select 1 from p i where i.t = o.c and i.id <> o.id) order by 1\nW2 p c/t scalar\tselect o.id, (select count(*) from p i where i.t = o.c) from p o order by 1\nW2 p c/t > any\tselect o.id from p o where o.c > any (select i.t from p i where i.id <> o.id) order by 1\nW2 p c/t <= all\tselect o.id from p o where o.c <= all (select i.t from p i where i.id <> 4) order by 1\nW2 p c/t join\tselect o.id, i.id from p o join p i on o.c = i.t order by 1, 2\nW2 p t/c in\tselect o.id from p o where o.t in (select i.c from p i where i.id <> o.id) order by 1\nW2 p t/c not in\tselect o.id from p o where o.t not in (select i.c from p i where i.id <> 4) order by 1\nW2 p t/c exists\tselect o.id from p o where exists (select 1 from p i where i.c = o.t and i.id <> o.id) order by 1\nW2 p t/c scalar\tselect o.id, (select count(*) from p i where i.c = o.t) from p o order by 1\nW2 p t/c > any\tselect o.id from p o where o.t > any (select i.c from p i where i.id <> o.id) order by 1\nW2 p t/c <= all\tselect o.id from p o where o.t <= all (select i.c from p i where i.id <> 4) order by 1\nW2 p t/c join\tselect o.id, i.id from p o join p i on o.t = i.c order by 1, 2\nW2 p c/c in\tselect o.id from p o where o.c in (select i.c from p i where i.id <> o.id) order by 1\nW2 p c/c not in\tselect o.id from p o where o.c not in (select i.c from p i where i.id <> 4) order by 1\nW2 p c/c exists\tselect o.id from p o where exists (select 1 from p i where i.c = o.c and i.id <> o.id) order by 1\nW2 p c/c scalar\tselect o.id, (select count(*) from p i where i.c = o.c) from p o order by 1\nW2 p c/c > any\tselect o.id from p o where o.c > any (select i.c from p i where i.id <> o.id) order by 1\nW2 p c/c <= all\tselect o.id from p o where o.c <= all (select i.c from p i where i.id <> 4) order by 1\nW2 p c/c join\tselect o.id, i.id from p o join p i on o.c = i.c order by 1, 2\nW2 pv c/v in\tselect o.id from pv o where o.c in (select i.v from pv i where i.id <> o.id) order by 1\nW2 pv c/v not in\tselect o.id from pv o where o.c not in (select i.v from pv i where i.id <> 4) order by 1\nW2 pv c/v exists\tselect o.id from pv o where exists (select 1 from pv i where i.v = o.c and i.id <> o.id) order by 1\nW2 pv c/v scalar\tselect o.id, (select count(*) from pv i where i.v = o.c) from pv o order by 1\nW2 pv c/v > any\tselect o.id from pv o where o.c > any (select i.v from pv i where i.id <> o.id) order by 1\nW2 pv c/v <= all\tselect o.id from pv o where o.c <= all (select i.v from pv i where i.id <> 4) order by 1\nW2 pv c/v join\tselect o.id, i.id from pv o join pv i on o.c = i.v order by 1, 2\nW2 pv v/c in\tselect o.id from pv o where o.v in (select i.c from pv i where i.id <> o.id) order by 1\nW2 pv v/c not in\tselect o.id from pv o where o.v not in (select i.c from pv i where i.id <> 4) order by 1\nW2 pv v/c exists\tselect o.id from pv o where exists (select 1 from pv i where i.c = o.v and i.id <> o.id) order by 1\nW2 pv v/c scalar\tselect o.id, (select count(*) from pv i where i.c = o.v) from pv o order by 1\nW2 pv v/c > any\tselect o.id from pv o where o.v > any (select i.c from pv i where i.id <> o.id) order by 1\nW2 pv v/c <= all\tselect o.id from pv o where o.v <= all (select i.c from pv i where i.id <> 4) order by 1\nW2 pv v/c join\tselect o.id, i.id from pv o join pv i on o.v = i.c order by 1, 2\nW2 pv c/t in\tselect o.id from pv o where o.c in (select i.t from pv i where i.id <> o.id) order by 1\nW2 pv c/t not in\tselect o.id from pv o where o.c not in (select i.t from pv i where i.id <> 4) order by 1\nW2 pv c/t exists\tselect o.id from pv o where exists (select 1 from pv i where i.t = o.c and i.id <> o.id) order by 1\nW2 pv c/t scalar\tselect o.id, (select count(*) from pv i where i.t = o.c) from pv o order by 1\nW2 pv c/t > any\tselect o.id from pv o where o.c > any (select i.t from pv i where i.id <> o.id) order by 1\nW2 pv c/t <= all\tselect o.id from pv o where o.c <= all (select i.t from pv i where i.id <> 4) order by 1\nW2 pv c/t join\tselect o.id, i.id from pv o join pv i on o.c = i.t order by 1, 2\nW2 pv t/c in\tselect o.id from pv o where o.t in (select i.c from pv i where i.id <> o.id) order by 1\nW2 pv t/c not in\tselect o.id from pv o where o.t not in (select i.c from pv i where i.id <> 4) order by 1\nW2 pv t/c exists\tselect o.id from pv o where exists (select 1 from pv i where i.c = o.t and i.id <> o.id) order by 1\nW2 pv t/c scalar\tselect o.id, (select count(*) from pv i where i.c = o.t) from pv o order by 1\nW2 pv t/c > any\tselect o.id from pv o where o.t > any (select i.c from pv i where i.id <> o.id) order by 1\nW2 pv t/c <= all\tselect o.id from pv o where o.t <= all (select i.c from pv i where i.id <> 4) order by 1\nW2 pv t/c join\tselect o.id, i.id from pv o join pv i on o.t = i.c order by 1, 2\nW2 pv c/c in\tselect o.id from pv o where o.c in (select i.c from pv i where i.id <> o.id) order by 1\nW2 pv c/c not in\tselect o.id from pv o where o.c not in (select i.c from pv i where i.id <> 4) order by 1\nW2 pv c/c exists\tselect o.id from pv o where exists (select 1 from pv i where i.c = o.c and i.id <> o.id) order by 1\nW2 pv c/c scalar\tselect o.id, (select count(*) from pv i where i.c = o.c) from pv o order by 1\nW2 pv c/c > any\tselect o.id from pv o where o.c > any (select i.c from pv i where i.id <> o.id) order by 1\nW2 pv c/c <= all\tselect o.id from pv o where o.c <= all (select i.c from pv i where i.id <> 4) order by 1\nW2 pv c/c join\tselect o.id, i.id from pv o join pv i on o.c = i.c order by 1, 2\nW2 = any array\tselect id from p where c = any (array['a', 'ab ', ' a']) order by 1\nW2 >= any char array\tselect id from p where t >= any (array['ab'::char(3)]) order by 1\nW2 char = any of a column\tselect id from p where 'ab'::char(3) = any (array[v]) order by 1\nW2 >= any, empty\tselect id from p where c >= any (select pe.c from pe) order by 1\nW2 >= all, empty\tselect count(*) from p where c >= all (select pe.v from pe)\nW2 a literal in chars\tselect id from p where 'ab ' in (select c from p) and id < 3 order by 1\nW2 duplicates and NULL\tselect id from p where c <> all (select c from p where id in (3, 6)) order by 1\nE1 doc, EXISTS\tselect (exists (select 1 from e1 as q7 join lateral (select count(*) from e3 as q9 where q9.d1 = d1.x6) as l8 on true where q7.b2 = d1.x6)) as x15 from (select 1 as x6 from e0 as q2) as d1\nE1 EXISTS, rows\tselect d1.x6, (exists (select 1 from e1 as q7 join lateral (select count(*) as n from e3 as q9 where q9.d1 = d1.x6) as l8 on l8.n > 1 where q7.b2 = d1.x6)) from (select a4 - 2 as x6 from e4) as d1 order by 1\nE1 IN\tselect q1.a5 from e4 as q1 where (1.5 in (select 1.5 from e4 as q3 join lateral (select q1.f as x8 from e4 as q5) as l4 on true where q3.a5 = q1.a5)) order by 1\nE1 IN, the value\tselect q1.a4 from e4 as q1 where q1.a4 in (select l4.x8 from e4 as q3 join lateral (select q1.a4 + q5.a4 - q5.a4 as x8 from e4 as q5) as l4 on true where q3.a5 = q1.a5) order by 1\nE1 scalar\tselect q1.a4, (select avg(1.5) from lateral (select 1.5 * q1.a4 as x10 from e4 as q5) as l4 where l4.x10 = q1.a4) from e4 as q1 order by 1\nE1 scalar count\tselect q1.a4, (select count(*) from (select q1.a4 * 2 as x from e4 q5) l where l.x = q1.a4 + 2) from e4 q1 order by 1\nE1 NOT EXISTS\tselect q1.a4 from e4 q1 where not exists (select 1 from e1 q7, lateral (select q1.a4 as v) l where q7.b2 = q1.a4 - 2 and l.v > 0) order by 1\nE2 doc\tselect round(c2, 1) from r0 order by c0\nE2 doc, limit 1\tselect round(c2, 1) from r0 order by c0 limit 1\nE2 a NULL numeric\tselect round(cast(null as numeric), 0) from r0\nE2 a NULL scale\tselect round(c2, null) from r0 order by c0\nE2 scale per row\tselect round(c2, c0 - 2) from r0 order by c0\nE2 an integer\tselect round(c0, 1) from r0 order by c0\nE2 in WHERE\tselect c0 from r0 where round(c2, 1) > 1 order by 1\nE2 in an aggregate\tselect sum(round(c2, 0)), avg(round(c2, 1)) from r0\nE2 left join\tselect 'a' from x1 left join r0 on false where round(r0.c2, 2) is null\nE3 doc\tselect 1.5 from x1 as q1 join x0 as q2 on (q2.a0 > 2147483647)\nE3 numeric >\tselect a0 from x0 where a0 > 2147483647\nE3 numeric <\tselect a0 from x0 where a0 < 2147483647 order by 1\nE3 numeric <=, negative\tselect a0 from x0 where a0 <= -2147483647\nE3 numeric >=, negative\tselect a0 from x0 where a0 >= -2147483647 order by 1\nE3 numeric between\tselect a0 from x0 where a0 between -100000 and 100000 order by 1\nE3 numeric =\tselect a0 from x0 where a0 = 123456789\nE3 numeric rounds past\tselect a0 from x0 where a0 > 9999.995\nE3 numeric >=, at the top\tselect a0 from x0 where a0 >= 9999.99\nE3 smallint <\tselect s from x0 where s < 2147483647 order by 1\nE3 smallint, flipped\tselect 1 from (select 1 from x0 as q2 where (2147483647 > q2.s)) as d1\nE3 smallint >\tselect s from x0 where s > 40000\nE3 smallint between\tselect s from x0 where s between -40000 and 40000 order by 1\nE3 smallint both past\tselect s from x0 where s > 40000 and s < 50000\nE3 int\tselect i from x0 where i < 3000000000 and i > -3000000000 order by 1\nE3 bigint\tselect b from x0 where b < 1e30 order by 1\nE3 per row\tselect q2.s from x1 q1 join x0 q2 on q2.s < q1.b2 + 40000 order by 1\nE3 empty table\tselect s from x2 where s > 40000 or a0 > 2147483647\nE3 empty table, join\tselect 1 from x1 join x2 on x2.a0 < 2147483647\nE3 a text bound\tselect a0 from x0 where a0 > '99999'"

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let setup: str = SETUP
    for l in strings.lines(&setup) {
        let o = q(mut &s, &l)
        if strings.startsWith(&o, "ERROR") { println(l + ": " + o) }
    }
    let qs: str = QS
    for pass in 0..2 {
        // the second pass with unnesting off (lexdb_plan.setUnnest(0)): each correlated subquery as written
        if pass == 1 { lexdb_plan.setUnnest(0) }
        for l in strings.lines(&qs) {
            let parts = strings.split(&l, "\t")
            let lab = if pass == 1 { "unnest off, " + parts[0] } else { parts[0].toStr() }
            if pass == 1 && !strings.startsWith(&lab, "unnest off, E1") && !strings.startsWith(&lab, "unnest off, W2") { continue }
            two(mut &s, &lab, &parts[1])
        }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(97), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 4 * 1024 * 1024, ckptBytes: 2 * 1024 * 1024,
                                                           snapNodes: 100000}, body).unwrap()
}
