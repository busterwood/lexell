// expect: same: i: 70
// expect: same: error 530
// expect: same: i: 7;14;21
// expect: same: error 530
// expect: same: i,d: 101|202;103|206;105|210
// expect: same: i: 7
// expect: same: i: 7;14;21;28;35;42;49;56;63;70;77;84;91;98
// expect: same: i: 
// expect: same: i,s: 4|'abbb';8|'abbbbbbb'
// expect: same: i,v: 2|'v2';4|'v4';6|'v6'
// expect: same: i,v: 50|'v50';100|'v100';150|NULL
// expect: same: i: 4;5;6
// expect: same: : 3
// expect: same: : 70
// expect: same: n: 2;3;4;1;2;3;4;5;6
// expect: same: ,: 2|6
// expect: same: i: 7;14;21
// expect: same: error 8134
// expect: same: : 4;6;11;50
// expect: same: : 4;6;11;50;-20
// expect: same: error 8115
// expect: same: : 2147483647
// expect: same: error 8115
// expect: same: error 8115
// expect: same: error 8115
// expect: same: : 2147395600
// expect: same: : 2147483649
// expect: same: : 2147483648.0
// expect: same: : 2147483648
// expect: same: error 8115
// expect: same: error 8115
// expect: same: error 8115
// expect: same: : 
// expect: ok
// expect: (1)
// expect: same: error 8115
// expect: same: error 8115
// expect: same: id,v: 1|2147483647
// expect: ok
// expect: (2)
// expect: ok
// expect: ok
// expect: ok
// expect: same: (1) / id,a,b,c: 1|-5|7|10;2|3|2|20
// expect: same: error 547
// expect: same: error 547
// expect: same: (1) / id,a: 1|4;2|3
// expect: same: error 547
// expect: same: error 547
// expect: same: (1) / id,b,c: 1|1|2;2|2|20
// expect: same: (2) / id,b: 1|2;2|3
// expect: same: error 547
// expect: same: (1) / id,b: 1|7;2|2
// expect: same: (1)
// expect: same: (1) / id,b: 1|9
// expect: same: error 547
// expect: same: (1) / n: 1
// expect: same: error 547
// expect: same: (1) / id,b: 1|6;2|2
// expect: same: error 547
// expect: same: (2) / id,b: 1|6;2|6
// expect: same: error 547
// expect: same: (1) / id,b: 1|7;2|2
// expect: same: error 547
// expect: same: (1) / id,b: 1|8;2|2
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once CREATE TABLE rt (k int PRIMARY KEY, v varchar(10))\n@once INSERT INTO rt SELECT value, 'v' + CAST(value AS varchar) FROM generate_series(1, 100)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 70 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 1 i FROM n WHERE i % 70 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 5)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 20)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 19)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i, i * 2 AS d FROM n WHERE i > 100 AND i % 2 = 1 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 10) SELECT TOP 3 i FROM n WHERE i % 7 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 100) SELECT TOP 30 i FROM n WHERE i % 7 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 0 i FROM n WHERE i % 7 = 0\nWITH n(i, s) AS (SELECT 1, CAST('a' AS varchar(50)) UNION ALL SELECT i + 1, CAST(s + 'b' AS varchar(50)) FROM n) SELECT TOP 2 i, s FROM n WHERE i % 4 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 n.i, rt.v FROM n JOIN rt ON rt.k = n.i WHERE n.i % 2 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 n.i, rt.v FROM n LEFT JOIN rt ON rt.k = n.i WHERE n.i % 50 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM (SELECT i FROM n WHERE i > 3) s OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT COUNT(*) FROM (SELECT TOP 3 i FROM n WHERE i % 7 = 0) s OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT SUM(i) FROM (SELECT TOP 4 i FROM n WHERE i % 7 = 0) s OPTION (MAXRECURSION 0)\nWITH r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 6) SELECT TOP 3 n FROM r WHERE n > 1 UNION ALL SELECT n FROM r\nWITH r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 6) SELECT (SELECT COUNT(*) FROM (SELECT TOP 2 n FROM r WHERE n > 2) x), (SELECT COUNT(*) FROM r)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT CASE WHEN i = 40 THEN 1 / (i - 40) ELSE i + 1 END FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT CASE WHEN i = 40 THEN 1 / (i - 40) ELSE i + 1 END FROM n) SELECT TOP 7 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 4 100 / (30 - i) FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 5 100 / (30 - i) FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nSELECT 2147483647 + 1\nSELECT 2147483647 + 0\nSELECT -2147483648 - 1\nSELECT 2147483647 * 2\nSELECT 46341 * 46341\nSELECT 46340 * 46340\nSELECT 2147483648 + 1\nSELECT 2147483647 + 1.0\nSELECT CAST(2147483647 AS bigint) + 1\nSELECT 3 * -715827883\nSELECT 1 + 2147483647 + 1\nSELECT 2147483647 - -1\nSELECT 2147483647 + 1 WHERE 1 = 0\n@once CREATE TABLE lit (id int PRIMARY KEY, v int)\n@once INSERT INTO lit VALUES (1, 2147483647)\nBEGIN TRAN; UPDATE lit SET v = v + 1 WHERE id = 1; ROLLBACK\nBEGIN TRAN; UPDATE lit SET v = 2147483647 + 1 WHERE id = 1; ROLLBACK\nSELECT id, v FROM lit\n@once CREATE TABLE ck (id int PRIMARY KEY, a int, b int, c int)\n@once INSERT INTO ck VALUES (1, -5, 1, 10), (2, 3, 2, 20)\n@once ALTER TABLE ck WITH NOCHECK ADD CONSTRAINT ck_a CHECK (a > 0)\n@once ALTER TABLE ck WITH NOCHECK ADD CONSTRAINT ck_bc CHECK (b < c AND c < 100)\n@once CREATE TABLE ckl (n int)\nBEGIN TRAN; UPDATE ck SET b = 7 WHERE id = 1; SELECT id, a, b, c FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = a WHERE id = 1; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = a + 1; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = 4 WHERE id = 1; SELECT id, a FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 50 WHERE id = 2; ROLLBACK\nBEGIN TRAN; UPDATE ck SET c = 200 WHERE id = 2; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 1, c = 2 WHERE id = 1; SELECT id, b, c FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = b + 1; SELECT id, b FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 7 WHERE id = 1; UPDATE ck SET a = a WHERE id = 1; ROLLBACK\nUPDATE ck SET b = 7 WHERE id = 1; SELECT id, b FROM ck ORDER BY id\nUPDATE ck SET b = 1 WHERE id = 1\nBEGIN TRAN; DECLARE @o TABLE (id int, b int); UPDATE ck SET b = 9 OUTPUT inserted.id, inserted.b INTO @o WHERE id = 1; SELECT id, b FROM @o; ROLLBACK\nBEGIN TRAN; DECLARE @o TABLE (id int, a int); UPDATE ck SET a = a OUTPUT inserted.id, inserted.a INTO @o WHERE id = 1; SELECT id, a FROM @o; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 9 OUTPUT inserted.id INTO ckl WHERE id = 1; SELECT n FROM ckl; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = a OUTPUT inserted.id INTO ckl WHERE id = 1; SELECT n FROM ckl; ROLLBACK\nBEGIN TRAN; MERGE ck AS t USING (SELECT 1 AS id) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET b = 6; SELECT id, b FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE ck AS t USING (SELECT 1 AS id) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET a = a; ROLLBACK\nBEGIN TRAN; MERGE ck AS t USING (SELECT 1 AS id UNION ALL SELECT 2) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET b = 6; SELECT id, b FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE ck AS t USING (SELECT 3 AS id) AS s ON t.id = s.id WHEN NOT MATCHED THEN INSERT (id, a, b, c) VALUES (3, -1, 1, 2); ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 7 FROM ck JOIN (SELECT 1 AS id) s ON s.id = ck.id; SELECT id, b FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = a FROM ck JOIN (SELECT 1 AS id) s ON s.id = ck.id; ROLLBACK\nBEGIN TRAN; UPDATE TOP (1) ck SET b = 8; SELECT id, b FROM ck ORDER BY id; ROLLBACK"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(71), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
