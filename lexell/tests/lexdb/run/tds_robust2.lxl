const QUERIES = "@once CREATE TABLE rt (k int PRIMARY KEY, v varchar(10))\n@once INSERT INTO rt SELECT value, 'v' + CAST(value AS varchar) FROM generate_series(1, 100)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 70 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 1 i FROM n WHERE i % 70 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 5)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 20)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 19)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i, i * 2 AS d FROM n WHERE i > 100 AND i % 2 = 1 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 10) SELECT TOP 3 i FROM n WHERE i % 7 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 100) SELECT TOP 30 i FROM n WHERE i % 7 = 0\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 0 i FROM n WHERE i % 7 = 0\nWITH n(i, s) AS (SELECT 1, CAST('a' AS varchar(50)) UNION ALL SELECT i + 1, CAST(s + 'b' AS varchar(50)) FROM n) SELECT TOP 2 i, s FROM n WHERE i % 4 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 n.i, rt.v FROM n JOIN rt ON rt.k = n.i WHERE n.i % 2 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 n.i, rt.v FROM n LEFT JOIN rt ON rt.k = n.i WHERE n.i % 50 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 3 i FROM (SELECT i FROM n WHERE i > 3) s OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT COUNT(*) FROM (SELECT TOP 3 i FROM n WHERE i % 7 = 0) s OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT SUM(i) FROM (SELECT TOP 4 i FROM n WHERE i % 7 = 0) s OPTION (MAXRECURSION 0)\nWITH r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 6) SELECT TOP 3 n FROM r WHERE n > 1 UNION ALL SELECT n FROM r\nWITH r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 6) SELECT (SELECT COUNT(*) FROM (SELECT TOP 2 n FROM r WHERE n > 2) x), (SELECT COUNT(*) FROM r)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT CASE WHEN i = 40 THEN 1 / (i - 40) ELSE i + 1 END FROM n) SELECT TOP 3 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT CASE WHEN i = 40 THEN 1 / (i - 40) ELSE i + 1 END FROM n) SELECT TOP 7 i FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 4 100 / (30 - i) FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nWITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n) SELECT TOP 5 100 / (30 - i) FROM n WHERE i % 7 = 0 OPTION (MAXRECURSION 0)\nSELECT 2147483647 + 1\nSELECT 2147483647 + 0\nSELECT -2147483648 - 1\nSELECT 2147483647 * 2\nSELECT 46341 * 46341\nSELECT 46340 * 46340\nSELECT 2147483648 + 1\nSELECT 2147483647 + 1.0\nSELECT CAST(2147483647 AS bigint) + 1\nSELECT 3 * -715827883\nSELECT 1 + 2147483647 + 1\nSELECT 2147483647 - -1\nSELECT 2147483647 + 1 WHERE 1 = 0\n@once CREATE TABLE lit (id int PRIMARY KEY, v int)\n@once INSERT INTO lit VALUES (1, 2147483647)\nBEGIN TRAN; UPDATE lit SET v = v + 1 WHERE id = 1; ROLLBACK\nBEGIN TRAN; UPDATE lit SET v = 2147483647 + 1 WHERE id = 1; ROLLBACK\nSELECT id, v FROM lit\n@once CREATE TABLE ck (id int PRIMARY KEY, a int, b int, c int)\n@once INSERT INTO ck VALUES (1, -5, 1, 10), (2, 3, 2, 20)\n@once ALTER TABLE ck WITH NOCHECK ADD CONSTRAINT ck_a CHECK (a > 0)\n@once ALTER TABLE ck WITH NOCHECK ADD CONSTRAINT ck_bc CHECK (b < c AND c < 100)\n@once CREATE TABLE ckl (n int)\nBEGIN TRAN; UPDATE ck SET b = 7 WHERE id = 1; SELECT id, a, b, c FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = a WHERE id = 1; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = a + 1; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = 4 WHERE id = 1; SELECT id, a FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 50 WHERE id = 2; ROLLBACK\nBEGIN TRAN; UPDATE ck SET c = 200 WHERE id = 2; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 1, c = 2 WHERE id = 1; SELECT id, b, c FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = b + 1; SELECT id, b FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 7 WHERE id = 1; UPDATE ck SET a = a WHERE id = 1; ROLLBACK\nUPDATE ck SET b = 7 WHERE id = 1; SELECT id, b FROM ck ORDER BY id\nUPDATE ck SET b = 1 WHERE id = 1\nBEGIN TRAN; DECLARE @o TABLE (id int, b int); UPDATE ck SET b = 9 OUTPUT inserted.id, inserted.b INTO @o WHERE id = 1; SELECT id, b FROM @o; ROLLBACK\nBEGIN TRAN; DECLARE @o TABLE (id int, a int); UPDATE ck SET a = a OUTPUT inserted.id, inserted.a INTO @o WHERE id = 1; SELECT id, a FROM @o; ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 9 OUTPUT inserted.id INTO ckl WHERE id = 1; SELECT n FROM ckl; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = a OUTPUT inserted.id INTO ckl WHERE id = 1; SELECT n FROM ckl; ROLLBACK\nBEGIN TRAN; MERGE ck AS t USING (SELECT 1 AS id) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET b = 6; SELECT id, b FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE ck AS t USING (SELECT 1 AS id) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET a = a; ROLLBACK\nBEGIN TRAN; MERGE ck AS t USING (SELECT 1 AS id UNION ALL SELECT 2) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET b = 6; SELECT id, b FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE ck AS t USING (SELECT 3 AS id) AS s ON t.id = s.id WHEN NOT MATCHED THEN INSERT (id, a, b, c) VALUES (3, -1, 1, 2); ROLLBACK\nBEGIN TRAN; UPDATE ck SET b = 7 FROM ck JOIN (SELECT 1 AS id) s ON s.id = ck.id; SELECT id, b FROM ck ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE ck SET a = a FROM ck JOIN (SELECT 1 AS id) s ON s.id = ck.id; ROLLBACK\nBEGIN TRAN; UPDATE TOP (1) ck SET b = 8; SELECT id, b FROM ck ORDER BY id; ROLLBACK\n@once CREATE TABLE fd (n int, d datetime2)\n@once INSERT INTO fd VALUES (1, '2026-03-15 08:05:09'), (2, '2031-12-25 17:30:45'), (3, '2024-09-01 00:00:00')\nSELECT n, FORMAT(d, 'd', 'en-AU'), FORMAT(d, 'D', 'en-AU'), FORMAT(d, 'f', 'en-AU'), FORMAT(d, 'F', 'en-AU'), FORMAT(d, 'g', 'en-AU'), FORMAT(d, 'G', 'en-AU'), FORMAT(d, 't', 'en-AU'), FORMAT(d, 'T', 'en-AU'), FORMAT(d, 'M', 'en-AU'), FORMAT(d, 'Y', 'en-AU') FROM fd ORDER BY n\nSELECT n, FORMAT(d, 'dd MMMM yyyy', 'en-AU'), FORMAT(d, 'MMMM yyyy', 'en-AU'), FORMAT(d, 'dddd', 'en-AU'), FORMAT(d, 'ddd', 'en-AU'), FORMAT(d, 'MMM', 'en-AU'), FORMAT(d, 'd MMM yy', 'en-AU'), FORMAT(d, 'HH:mm:ss', 'en-AU'), FORMAT(d, 'yyyy/MM/dd', 'en-AU'), FORMAT(d, 'tt h:mm', 'en-AU'), FORMAT(d, 'MMMM', 'en-AU') FROM fd ORDER BY n\nSELECT n, FORMAT(d, 'd', 'en-CA'), FORMAT(d, 'D', 'en-CA'), FORMAT(d, 'f', 'en-CA'), FORMAT(d, 'F', 'en-CA'), FORMAT(d, 'g', 'en-CA'), FORMAT(d, 'G', 'en-CA'), FORMAT(d, 't', 'en-CA'), FORMAT(d, 'T', 'en-CA'), FORMAT(d, 'M', 'en-CA'), FORMAT(d, 'Y', 'en-CA') FROM fd ORDER BY n\nSELECT n, FORMAT(d, 'dd MMMM yyyy', 'en-CA'), FORMAT(d, 'MMMM yyyy', 'en-CA'), FORMAT(d, 'dddd', 'en-CA'), FORMAT(d, 'ddd', 'en-CA'), FORMAT(d, 'MMM', 'en-CA'), FORMAT(d, 'd MMM yy', 'en-CA'), FORMAT(d, 'HH:mm:ss', 'en-CA'), FORMAT(d, 'yyyy/MM/dd', 'en-CA'), FORMAT(d, 'tt h:mm', 'en-CA'), FORMAT(d, 'MMMM', 'en-CA') FROM fd ORDER BY n\nSELECT n, FORMAT(d, 'd', 'en-IN'), FORMAT(d, 'D', 'en-IN'), FORMAT(d, 'f', 'en-IN'), FORMAT(d, 'F', 'en-IN'), FORMAT(d, 'g', 'en-IN'), FORMAT(d, 'G', 'en-IN'), FORMAT(d, 't', 'en-IN'), FORMAT(d, 'T', 'en-IN'), FORMAT(d, 'M', 'en-IN'), FORMAT(d, 'Y', 'en-IN') FROM fd ORDER BY n\nSELECT n, FORMAT(d, 'dd MMMM yyyy', 'en-IN'), FORMAT(d, 'MMMM yyyy', 'en-IN'), FORMAT(d, 'dddd', 'en-IN'), FORMAT(d, 'ddd', 'en-IN'), FORMAT(d, '