import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table dg (i number(10))\ninsert into dg values (0)\ninsert into dg values (1)\ninsert into dg values (2)\ninsert into dg values (3)\ninsert into dg values (4)\ninsert into dg values (5)\ninsert into dg values (6)\ninsert into dg values (7)\ninsert into dg values (8)\ninsert into dg values (9)\ncreate table t (id number(10) primary key, g number(10), x number(10))\ninsert into t select n, mod(n, 7), case when mod(n, 13) = 0 then null else mod(n, 50) end from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 3000\ncreate table u (id number(10) primary key, k number(10), w number(10), c varchar2(5))\ninsert into u select n, mod(n, 9), mod(n * 37, 1000), 'c' || mod(n, 4) from (select p.i + q.i * 10 + r.i * 100 + 1 n from dg p cross join dg q cross join dg r) z where n <= 400\ncreate index u_k on u (k)\ncreate table tx (k varchar2(5) primary key, v varchar2(5), n number(10))\ninsert into tx values ('a', 'b', 1)\ninsert into tx values ('b', 'c', 2)\ninsert into tx values ('c', null, 3)\ninsert into tx values ('d', 'zz', 0)\ninsert into tx values ('e', 'a', 5)\ncreate table e0 (id number(10) primary key, v number(10))"

const QS = "select t.id, l.w from t, lateral (select u.w from u where u.k = t.g order by u.id fetch first 2 rows only) l where t.id < 30 order by t.id, l.w\nselect t.id, l.w from t cross apply (select u.w from u where u.k = t.g order by u.w desc fetch first 3 rows only) l where t.id < 20 order by t.id, l.w\nselect t.id, l.w from t outer apply (select u.w from u where u.k = t.g + 100) l where t.id < 10 order by 1\nselect t.id, l.id lid from t outer apply (select u.id from u where u.id = t.x) l where t.id < 60 order by 1\nselect t.id, l.w from t left join lateral (select u.w from u where u.k = t.g order by u.id fetch first 2 rows only) l on l.w > 500 where t.id < 25 order by 1, 2\nselect count(*) n, count(l.id) m, sum(l.w) s from t outer apply (select u.id, u.w from u where u.k = t.x) l\nselect x.k, l.v, l.n from tx x cross apply (select y.v, y.n from tx y where y.k = x.v) l order by 1\nselect x.k, l.v from tx x outer apply (select y.v from tx y where y.k = x.v or y.v = x.k) l order by 1, 2\nselect e0.id, l.z from e0 cross apply (select e0.v + 1 z from dual) l\nselect t.id, l.q from t, lateral (select 10 / (t.id - 25) q from dual) l where t.id < 40 order by 1\nselect t.id, 10 / (l.w - 777) q from t cross apply (select u.w from u where u.id = t.id) l where t.id < 400 order by 1\nselect t.id, l.w from t cross apply (select u.w from u where u.k = t.g order by u.id fetch first 2 rows only) l order by t.id, l.w fetch first 5 rows only\nselect t.id, a.w, b.z from t cross apply (select u.w, u.id from u where u.k = t.g order by u.id fetch first 2 rows only) a cross apply (select a.w + t.id z from dual) b where t.id < 10 order by 1, 2, 3\nselect t.id, l.id lid, l.z from t cross apply (select u.id, m.z from u cross apply (select u.w + t.id z from dual) m where u.k = t.g order by u.id fetch first 2 rows only) l where t.id < 8 order by 1, 2\nselect t.id, u.id uid2, l.z from t join u on u.id = t.x cross apply (select t.g + u.k z from dual) l where t.id < 20 order by 1\nselect count(*) n, sum(l.w) s, min(l.c) c from t cross apply (select u.w, u.c from u where u.k = t.g order by u.id fetch first 3 rows only) l\nselect t.id, l.n from t cross apply (select count(*) n from u where u.k = t.x) l where t.id < 40 order by 1\nselect l.id, t.id tid, row_number() over (order by l.id, t.id) rn from t cross apply (select u.id from u where u.k = t.x order by u.id fetch first 1 rows only) l where t.id < 20 order by 3\nselect distinct l.c from t cross apply (select u.c from u where u.k = t.g) l where t.id < 50 order by 1\nselect u.id from u where u.id < 30 and exists (select 1 from t cross apply (select t.x + u.k z from dual) l where t.id = u.id and l.z > 20) order by 1\nselect count(*) n from t cross apply (select u.id from u where u.k = t.g) l\nselect t.id, l.w from t outer apply (select u.w from u where u.k = t.g + 5 order by u.id fetch first 1 rows only) l where t.id < 30 and (l.w is null or l.w > 500) order by 1"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(54), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
