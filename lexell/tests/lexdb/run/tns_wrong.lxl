// lexdb over TNS: what the user documentation's wrong-answer list held for the Oracle door (KNOWN-ISSUES.md), through its doors: NUMBER
// variables, parameters and function arguments dividing as numbers (1 + p / 100 in PL/SQL, a procedure, a function), integer-sized
// constants adding and multiplying as NUMBERs (no overflow: 2147483647 + 1), two primary keys (ORA-02260), the interval fields kept as
// they were (INTERVAL '1' DAY, '1-2' YEAR TO MONTH, DAY TO SECOND), and a text compared with a number (ORA-01722). Checked against Oracle
// Database Free 23.26 (gen_oracle.py --check tns_wrong: the answers below are Oracle's). Each statement runs with set lexdb_batch = off
// (the row engine) and on: "same" and the answer, or DIFFERENT and both.
// expect: setup: 6 statements
// expect: same: A,B,C,D,E,F = 2147483648|4294967294|-2147483649|32768|1073676289|0.3333333333333333333333333333333333333
// expect: same: A,B,C,D,E = 1.1|1.025|1|NULL|2.2
// expect: same: 0 / K,V = 1|110.00;2|250.50
// expect: same: 0 / K,V = 1|350.00;2|876.75
// expect: same: 0 / K,V = 1|1.10;2|250.50
// expect: same: 0 / K,V = 1|100.00;2|4.33
// expect: same: 0 / K,V = 1|1.10;2|250.50
// expect: same: 0 / K,V = 1|1.10;2|250.50
// expect: same: 1 / 1 / K = 1;2;2147483648;4294967294
// expect: same: 1 / K,V = 1|110.00;2|250.50
// expect: same: A,B,C = 1.1|2.5|7
// expect: same: error 2260
// expect: same: error 2260
// expect: same: error 2260
// expect: same: A,B,C,D,E,F = '+000000001 00:00:00.000000000'|'+000000000 02:00:00.000000000'|'+000000000 00:03:00.000000000'|'+000000000 00:00:04.000000000'|'+000000000-05'|'+000000006-00'
// expect: same: A,B,C,D = '+000000001-02'|'+000000001 02:03:04.000000000'|'+000000000 02:03:00.000000000'|'+000000000 00:03:04.000000000'
// expect: same: A,B,C = '2020-02-15T00:00:00'|'2021-01-01T00:00:00'|'2020-01-01T11:30:00'
// expect: same: D,H = 3|3
// expect: same: error 1722
// expect: same: error 1722
// expect: same: A,B,C = 1|3|1
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table pt (k number(12) primary key, v number(10,2))\ninsert into pt values (1, 100)\ninsert into pt values (2, 250.5)\ncreate or replace procedure rp(p in number) as begin update pt set v = v * (1 + p / 100) where k = 1; end;\ncreate or replace procedure rq(p in number, q in number) as begin update pt set v = v * (1 + p / q); end;\ncreate or replace function rf(p in number) return number as begin return 1 + p / 100; end;"

const QS = "select 2147483647 + 1 a, 2147483647 * 2 b, -2147483648 - 1 c, 32767 + 1 d, 32767 * 32767 e, 1 / 3 f from dual\nselect rf(10) a, rf(2.5) b, rf(0) c, rf(null) d, rf(10) * 2 e from dual\nbegin rp(10); end; ;; select k, v from pt order by k\nbegin rq(10, 4); end; ;; select k, v from pt order by k\ndeclare p number := 10; r number; begin r := 1 + p / 100; update pt set v = r where k = 1; end; ;; select k, v from pt order by k\ndeclare p number(5,2) := 10; q number := 3; begin update pt set v = 1 + p / q where k = 2; end; ;; select k, v from pt order by k\ndeclare p integer := 10; begin update pt set v = 1 + p / 100 where k = 1; end; ;; select k, v from pt order by k\ndeclare p pls_integer := 10; r number; begin r := 1 + p / 100; update pt set v = r where k = 1; end; ;; select k, v from pt order by k\ninsert into pt (k) values (2147483647 + 1) ;; insert into pt (k) values (2147483647 * 2) ;; select k from pt order by k\nupdate pt set v = (1 + 10 / 100) * 100 where k = 1 ;; select k, v from pt order by k\nselect 1 + 10 / 100 a, 10 / 4 b, 2 * (7 / 2) c from dual\ncreate table pk2 (a number primary key, b number primary key)\ncreate table pk2 (a number primary key, b number, primary key (b))\ncreate table pk2 (a number, b number, c number primary key, primary key (a, b))\nselect interval '1' day a, interval '2' hour b, interval '3' minute c, interval '4' second d, interval '5' month e, interval '6' year f from dual\nselect interval '1-2' year to month a, interval '1 02:03:04' day to second b, interval '02:03' hour to minute c, interval '03:04' minute to second d from dual\nselect date '2020-01-15' + interval '1' month a, date '2020-01-01' + interval '1' year b, timestamp '2020-01-01 10:00:00' + interval '90' minute c from dual\nselect extract(day from interval '3' day) d, extract(hour from interval '3' hour) h from dual\nselect 1 from dual where 1 = 'a'\nselect 1 + 'a' from dual\nselect case when 1 = 1 then 1 else 2 end a, coalesce(null, 3) b, nullif(1, 2) c from dual"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(160), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
