// lexdb_exec: array_agg, uuid and bytea, checked against PostgreSQL 18
// (generated by tests/lexdb/gen_pg.py from types_queries.txt): array_agg
// with NULLs, DISTINCT, ORDER BY and FILTER; uuid's input forms, its order
// and keys, gen_random_uuid's version and variant; bytea's hex and escape
// forms, encode and decode, ||, length, its order and keys.
// Each expect line: a query's rows or tag, or ERROR and its SQLSTATE.
// expect: CREATE TABLE
// expect: INSERT 0 4
// expect: {Tom,Rex,NULL,Ace}
// expect: {Ace,Rex,Tom,NULL}
// expect: {Tom,Rex,Ace,NULL}
// expect: cat|{3,1};dog|{4,2}
// expect: {cat,dog}
// expect: {2019-05-05,2020-01-01,2021-03-03,NULL}
// expect: {Tom,NULL}
// expect: 
// expect: {NULL}
// expect: a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
// expect: a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11|a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
// expect: ERROR 22P02
// expect: ERROR 22P02
// expect: ERROR 22P02
// expect: ERROR 22P02
// expect: CREATE TABLE
// expect: INSERT 0 3
// expect: 00000000-0000-0000-0000-000000000001|one;00000000-0000-0000-0000-000000000002|two;ffffffff-0000-0000-0000-000000000000|ff
// expect: one
// expect: two;ff
// expect: ERROR 23505
// expect: ffffffff-0000-0000-0000-000000000000|36
// expect: 36|4|t
// expect: t
// expect: \x0001ff|\xdeadbeef|\x616263|\x00015c|\x
// expect: ERROR 22023
// expect: ERROR 22023
// expect: ERROR 22P02
// expect: 0001ff|aGVsbG8=|a\000b\\c
// expect: \x0001ff|\x68656c6c6f|\x610062
// expect: ERROR 22023
// expect: \x0102|3|3|6
// expect: CREATE TABLE
// expect: INSERT 0 4
// expect: \x|-1;\x0100|0;\x01ff|1;\x02|2
// expect: 1
// expect: 1;0;-1
// expect: ;0100;01ff;02
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table pets (id int primary key, kind text, name text, born date)\ninsert into pets values (1, 'cat', 'Tom', '2020-01-01'), (2, 'dog', 'Rex', '2019-05-05'), (3, 'cat', null, '2021-03-03'), (4, 'dog', 'Ace', null)\nselect array_agg(name) from pets\nselect array_agg(name order by name) from pets\nselect array_agg(name order by name desc nulls last) from pets\nselect kind, array_agg(id order by id desc) from pets group by kind order by kind\nselect array_agg(distinct kind) from pets\nselect array_agg(born order by born) from pets\nselect array_agg(name) filter (where kind = 'cat') from pets\nselect array_agg(id) from pets where id > 10\nselect array_agg(name) from pets where id = 3\nselect 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid, 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid, '{a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}'::uuid\nselect 'a0eebc999c0b4ef8bb6d6bb9bd380a11'::uuid, 'a0ee-bc99-9c0b-4ef8-bb6d-6bb9-bd38-0a11'::uuid, '{a0eebc999c0b4ef8bb6d6bb9bd380a11}'::uuid\nselect 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a1'::uuid\nselect 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11-'::uuid\nselect 'g0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid\nselect 'a0eebc99--9c0b-4ef8-bb6d-6bb9bd380a11'::uuid\ncreate table things (id uuid primary key, label text)\ninsert into things values ('00000000-0000-0000-0000-000000000002', 'two'), ('FFFFFFFF-0000-0000-0000-000000000000', 'ff'), ('{00000000-0000-0000-0000-000000000001}', 'one')\nselect * from things order by id\nselect label from things where id = '00000000000000000000000000000001'\nselect label from things where id > '00000000-0000-0000-0000-000000000001' order by id\ninsert into things values ('00000000-0000-0000-0000-000000000002', 'again')\nselect id::text, length(id::text) from things where label = 'ff'\nselect length(gen_random_uuid()::text), substr(gen_random_uuid()::text, 15, 1), gen_random_uuid() <> gen_random_uuid()\nselect substr(gen_random_uuid()::text, 20, 1) in ('8', '9', 'a', 'b')\nselect '\\x0001ff'::bytea, '\\xDEADbeef'::bytea, 'abc'::bytea, '\\000\\001\\\\'::bytea, ''::bytea\nselect '\\x0'::bytea\nselect '\\xzz'::bytea\nselect 'a\\9'::bytea\nselect encode('\\x0001ff'::bytea, 'hex'), encode('hello'::bytea, 'base64'), encode('a\\000b\\\\c'::bytea, 'escape')\nselect decode('0001ff', 'hex'), decode('aGVsbG8=', 'base64'), decode('a\\000b', 'escape')\nselect decode('xyz', 'nope')\nselect '\\x01'::bytea || '\\x02'::bytea, length('\\x010203'::bytea), octet_length('\\x010203'::bytea), octet_length('héllo')\ncreate table blobs (k bytea primary key, n int)\ninsert into blobs values ('\\x02', 2), ('\\x01ff', 1), ('\\x0100', 0), ('\\x', -1)\nselect k, n from blobs order by k\nselect n from blobs where k = '\\x01ff'\nselect n from blobs where k < '\\x02' order by k desc\nselect encode(k, 'hex') from blobs order by k"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(78), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
