// expect: same: NAME,TYPE,LINE,POSITION,TEXT = 'FB1'|'FUNCTION'|1|55|'PLS-00201: identifier ''M'' must be declared';'FB1'|'FUNCTION'|1|48|'PL/SQL: Statement ignored';'FB3'|'FUNCTION'|1|63|'PLS-00201: identifier ''UNDECLARED_FN'' must be declared';'FB3'|'FUNCTION'|1|58|'PL/SQL: Statement ignored';'PB1'|'PROCEDURE'|1|36|'PL/SQL: ORA-00942: table or view does not exist';'PB1'|'PROCEDURE'|1|24|'PL/SQL: SQL Statement ignored'
