import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "drop role if exists lx_alice\ncreate table t (id int primary key, v int, g text)\ninsert into t values (1, 10, 'a'), (2, 20, 'a'), (3, 30, 'b'), (4, 40, 'b')\ncreate function ids() returns setof int language sql as $$ select id from t order by id $$\ncreate function big(minv int) returns table (id int, v int) language sql as $$ select id, v from t where v >= minv $$\ncreate function two(a int) returns table (x int, y text) language sql as $$ select a, 'p' union all select a + 1, 'q' $$\ncreate function grp(gg text, out total int, out n bigint) returns setof record language sql as $$ select sum(v)::int, count(*) from t where g = gg $$\ncreate function one(a int) returns table (x int) language sql as $$ select a * 10 $$\ncreate function lit() returns setof text language sql as $$ values ('x'), ('y') $$\ncreate function inc(a int default 1, b int default 100) returns table (s int) language sql as $$ select a + b $$\nselect * from ids()\nselect ids from ids()\nselect * from ids() as i\nselect * from ids() as i(n)\nselect n from ids() as i(n) where n > 2\nselect * from big(25)\nselect * from big(25) order by id desc\nselect id from big(15) where v < 40\nselect count(*), sum(v) from big(0)\nselect b.id, t.g from big(15) b join t on t.id = b.id order by b.id\nselect t.g, count(*) from t join big(15) b on b.id = t.id group by t.g order by t.g\nselect * from two(1)\nselect * from two(1) as q(a, b)\nselect x from two(5) where y = 'q'\nselect * from grp('a')\nselect total from grp('b')\nselect * from one(4)\nselect * from lit()\nselect lit from lit()\nselect * from inc()\nselect * from inc(5)\nselect * from inc(b => 7)\nselect * from ids() where ids = 3\nselect * from ids() i join big(0) b on b.id = i.i order by 1\nselect * from ids() i, big(0) b where b.id = i order by 1\nselect (select count(*) from big(t.v)) from t order by id\nselect t.id, b.id from t, big(t.v) b order by t.id, b.id\nselect t.id, b.id from t cross join lateral big(t.v) b where b.id < 3 order by t.id, b.id\nselect t.id, x.s from t, inc(t.v, 1) x order by t.id\nselect * from big(1, 2)\nselect * from big()\nselect * from nothing()\nselect * from big('x')\nselect 1 where 3 in (select * from ids())\nselect id from t where id in (select id from big(20)) order by id\nselect * from (select * from big(15)) q where q.v > 20\nwith c as (select * from big(15)) select count(*) from c\nselect * from ids() union all select * from ids() order by 1\ncreate function bad1() returns setof int language sql as $$ select id, v from t $$\ncreate function bad2() returns table (a int, b int) language sql as $$ select 1 $$\ncreate function w() returns setof int language sql as $$ select 1 $$\ncreate or replace function w() returns int language sql as $$ select 1 $$\nselect proname, proretset, prorettype::regtype, proargnames, proargmodes from pg_proc where proname in ('ids', 'big', 'two', 'grp', 'one', 'lit', 'inc') order by proname\nselect replace(pg_get_functiondef('ids'::regproc), chr(10), '~')\nselect replace(pg_get_functiondef('big'::regproc), chr(10), '~')\nselect replace(pg_get_functiondef('grp'::regproc), chr(10), '~')\nselect replace(pg_get_functiondef('inc'::regproc), chr(10), '~')\nselect pg_get_function_arguments('inc'::regproc), pg_get_function_result('inc'::regproc), pg_get_function_identity_arguments('inc'::regproc)\nselect pg_get_function_arguments('big'::regproc), pg_get_function_result('big'::regproc), pg_get_function_identity_arguments('big'::regproc)\nselect pg_get_function_arguments('grp'::regproc), pg_get_function_result('grp'::regproc), pg_get_function_identity_arguments('grp'::regproc)\nselect pg_get_function_result('ids'::regproc), pg_get_function_result('lit'::regproc)\ncreate function f1(a int, b text default 'x') returns int language sql immutable strict as $$ select a $$\ncreate function f2(a int) returns int language sql stable as $$ select a $$\ncreate function f3() returns int language sql return 5\ncreate procedure p1(a int, inout b int, out c text) language sql as $$ select a + b, 'z' $$\ncreate procedure p2() language sql as $$ select 1 $$\nselect replace(pg_get_functiondef('f1'::regproc), chr(10), '~')\nselect replace(pg_get_functiondef('f2'::regproc), chr(10), '~')\nselect replace(pg_get_functiondef('f3'::regproc), chr(10), '~')\nselect replace(pg_get_functiondef('p1'::regproc), chr(10), '~')\nselect replace(pg_get_functiondef('p2'::regproc), chr(10), '~')\nselect pg_get_function_arguments('p1'::regproc), pg_get_function_identity_arguments('p1'::regproc)\nselect replace(pg_get_functiondef(oid), chr(10), '~') from pg_proc where proname = 'one'\nselect replace(pg_get_functiondef(0), chr(10), '~')\nselect routine_name, routine_type, data_type, type_udt_name, routine_body, external_language, is_deterministic, is_null_call, security_type, sql_data_access from information_schema.routines where routine_schema = 'public' order by routine_name\nselect routine_name, routine_definition from information_schema.routines where routine_schema = 'public' and routine_name in ('ids', 'f1', 'f3') order by routine_name\nselect routine_name, specific_schema, routine_catalog = specific_catalog, character_maximum_length, numeric_precision, dtd_identifier from information_schema.routines where routine_schema = 'public' and routine_name in ('f1', 'one') order by routine_name\nselect specific_name = routine_name || '_' || (select oid::text from pg_proc where proname = routine_name), routine_name from information_schema.routines where routine_schema = 'public' and routine_name in ('ids', 'f1') order by routine_name\nselect r.routine_name, p.ordinal_position, p.parameter_mode, p.is_result, p.parameter_name, p.data_type, p.udt_name, p.parameter_default from information_schema.parameters p join information_schema.routines r on r.specific_name = p.specific_name where r.routine_schema = 'public' order by r.routine_name, p.ordinal_position\nselect substr(specific_name, 1, position('_' in specific_name) - 1) as r, parameter_name, ordinal_position, parameter_mode from information_schema.parameters where specific_schema = 'public' and parameter_mode <> 'IN' order by 1, ordinal_position\ncreate role lx_alice login\nrevoke execute on function f1(int, text) from public\nset role lx_alice\nselect routine_name from information_schema.routines where routine_schema = 'public' and routine_name in ('f1', 'f2') order by 1\nselect count(*) from information_schema.parameters where specific_schema = 'public' and parameter_name = 'a'\nreset role\ndrop function ids()\nselect count(*) from information_schema.routines where routine_name = 'ids'\nselect * from ids()"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" && r.tag != "CALL" { append(mut &rows, r.tag.clone()) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(125), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
