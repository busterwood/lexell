// The fuzzer's long run, what it left (design/lexdb-fuzz.md), each statement against PostgreSQL 18's answer, with SET
// lexdb_batch = off and on (in a transaction rolled back each time).
// - W18: a correlated scalar subquery or EXISTS hashed on its key where the outer value is a derived table's column of
//   another kind (a float beside a numeric or an integer key, a numeric beside a float): the outer value is an untyped
//   parameter, and the hash compares values as they are, so 1 (float) found no 1.00 (numeric) without an index. Such a
//   key is no hash key now (run per row); an integer beside a numeric is still hashed.
// - V: ORDER BY a set operation's char column whose values have two lengths ('a  ' of a char(3), 'a' of a text) sorted
//   by the blanks, where bpchar's order has them tie (the next key decides): UNION ALL, UNION, EXCEPT, INTERSECT, three
//   sides, DESC, by name, LIMIT and OFFSET (the held path), a literal first, an empty side, duplicates.
// expect: W18 the reduced case: 3.0;3.0;3.0;3.0;3.0;3.0, same: true
// expect: W18 a float = a numeric(6,2): 0|6;0|6;1|6;2.5|NULL;NULL|NULL, same: true
// expect: W18 a real = a numeric(6,2): 0|6;1|6;2.5|NULL;3|NULL;NULL|NULL, same: true
// expect: W18 a numeric = a float: 0.00|9;1.00|1;1.00|1;1.50|NULL;2.00|NULL;NULL|NULL, same: true
// expect: W18 a float = an integer: 0|NULL;0|NULL;1|1;2.5|NULL;NULL|NULL, same: true
// expect: W18 a real = a bigint: 0|NULL;1|1;2.5|NULL;3|5;NULL|NULL, same: true
// expect: W18 an integer = a numeric, hashed: 1|6;2|3;2|3;3|NULL;NULL|NULL, same: true
// expect: W18 with an index: 0|6;0|6;1|6;2.5|NULL;NULL|NULL, same: true
// expect: W18 EXISTS: 0;0;1, same: true
// expect: W18 NOT EXISTS: NULL;2.5, same: true
// expect: W18 a numeric EXISTS in reals: 0.00;1.00;1.00, same: true
// expect: W18 IN: 0;0;1, same: true
// expect: W18 empty: NULL|0;0|0;0|0;1|0;2.5|0, same: true
// expect: W18 an error per row: ERROR 22012, same: true
// expect: W18 EXISTS over batches: 3|4.5, same: true
// expect: W18 scalar over batches: 3|4.5, same: true
// expect: V UNION ALL a char and a text:    |3;|9;   |10;a  |1;a  |6;a|6;a |7;ab |5;ab|12;b  |2;b  |8;NULL|4;NULL|11, same: true
// expect: V DESC: NULL|11;NULL|4;b  |8;b  |2;ab|12;ab |5;a |7;a  |6;a|6;a  |1;   |10;|9;   |3, same: true
// expect: V by name, NULLS FIRST: NULL|4;NULL|11;   |3;|9;   |10;a  |1;a  |6;a|6;a |7;ab |5;ab|12;b  |2;b  |8, same: true
// expect: V UNION:    |3;|9;   |10;a  |1;a  |6;a |7;ab |5;ab|12;b  |2;b  |8;NULL|4;NULL|11, same: true
// expect: V char(3) and char(5): NULL|4;b  |2;b    |14;ab |5;ab   |15;a  |1;a  |6;a    |13;   |3, same: true
// expect: V LIMIT:    |3;|9;   |10;a  |1, same: true
// expect: V LIMIT OFFSET:    |10;a  |1;a  |6, same: true
// expect: V three:    |3;|9;   |10;a  |1;a  |6;a|6;a |7;a    |13;ab |5;ab|12;ab   |15;b  |2;b  |8;b    |14;NULL|4;NULL|11, same: true
// expect: V EXCEPT:    |3;|9;   |10;a  |1;a  |6;a |7;ab |5;ab|12;b  |2;b  |8;NULL|4;NULL|11, same: true
// expect: V INTERSECT: a  |1, same: true
// expect: V a literal first:    |3;a  |1;a|2;a  |6;ab |5;b  |2;NULL|4, same: true
// expect: V an empty side: |9;   |10;a|6;a |7;ab|12;b  |8;NULL|11, same: true
// expect: V duplicates:    |3;   |3;a  |1;a  |1;a  |6;a  |6;ab |5;ab |5;b  |2;b  |2;NULL|4;NULL|4, same: true
// expect: V over a derived union, LIMIT: NULL|4;NULL|11;b  |2;b  |8, same: true
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_ops"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            var out: []str = []
            for r in rs {
                for row in r.rows {
                    var vs: []str = []
                    for k in 0..len(row) { append(mut &vs, if lexdb_ops.isNull(&row[k]) { "NULL" } else { s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 }) }) }
                    append(mut &out, strings.join(&vs, "|"))
                }
            }
            return strings.join(&out, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// each statement with the row engine and with batches, in a transaction rolled back
fn two(s: mut &lexdb_exec.Session, label: &str, sql: &str) {
    let x = q(s, &"set lexdb_batch = off")
    let b0 = q(s, &"begin")
    let off = q(s, sql)
    let r0 = q(s, &"rollback")
    let y = q(s, &"set lexdb_batch = on")
    let b1 = q(s, &"begin")
    let on = q(s, sql)
    let r1 = q(s, &"rollback")
    println(label + ": " + on + ", same: " + (off == on).toStr())
}

const SETUP = "create table w1 (b2 numeric(6,2), p int)\ninsert into w1 values (1, 1), (1.5, 2), (2, 3), (NULL, 4), (1, 5), (0, 6)\ncreate table w2 (k int, f float8, r real, g bigint, p int)\ninsert into w2 values (1, 1, 1, 1, 1), (2, 2.5, 2.5, 2, 2), (NULL, NULL, NULL, NULL, 3), (2, 0, 0, 2, 4), (3, -0.0, 3, 3, 5)\ncreate table w3 (b2 numeric(6,2), p int)\ninsert into w3 select b2, p from w1\ncreate index w3_i on w3 (b2)\ncreate table w4 (k int)\ncreate table q0 (a char(3), n int)\ninsert into q0 values ('a', 1), ('b', 2), ('', 3), (NULL, 4), ('ab', 5), ('a', 6)\ncreate table q1 (b text, n int)\ninsert into q1 values ('a', 6), ('a ', 7), ('b  ', 8), ('', 9), ('   ', 10), (NULL, 11), ('ab', 12)\ncreate table q2 (a char(5), n int)\ninsert into q2 values ('a', 13), ('b', 14), ('ab', 15)\ncreate table q3 (a char(3), n int)\nanalyze"

const QS = "W18 the reduced case	select (select sum(1.5) from w1 as q10 where q10.b2 = d2.x9) from (select ceil(1) as x9 from w1) as d2 order by 1\nW18 a float = a numeric(6,2)	select d.x, (select sum(p) from w1 where w1.b2 = d.x) from (select f as x from w2) as d order by 1, 2\nW18 a real = a numeric(6,2)	select d.x, (select sum(p) from w1 where w1.b2 = d.x) from (select r as x from w2) as d order by 1, 2\nW18 a numeric = a float	select d.x, (select sum(p) from w2 where w2.f = d.x) from (select b2 as x from w1) as d order by 1, 2\nW18 a float = an integer	select d.x, (select sum(p) from w2 where w2.k = d.x) from (select f as x from w2) as d order by 1, 2\nW18 a real = a bigint	select d.x, (select sum(p) from w2 where w2.g = d.x) from (select r as x from w2) as d order by 1, 2\nW18 an integer = a numeric, hashed	select d.x, (select sum(p) from w1 where w1.b2 = d.x) from (select k as x from w2) as d order by 1, 2\nW18 with an index	select d.x, (select sum(p) from w3 where w3.b2 = d.x) from (select f as x from w2) as d order by 1, 2\nW18 EXISTS	select d.x from (select f as x from w2) as d where exists (select 1 from w1 where w1.b2 = d.x) order by 1\nW18 NOT EXISTS	select d.x from (select f as x from w2) as d where not exists (select 1 from w1 where w1.b2 = d.x) order by 1 nulls first\nW18 a numeric EXISTS in reals	select d.x from (select b2 as x from w1) as d where exists (select 1 from w2 where w2.r = d.x) order by 1\nW18 IN	select d.x from (select f as x from w2) as d where d.x in (select b2 from w1) order by 1\nW18 empty	select d.x, (select count(*) from w4 where w4.k = d.x) from (select f as x from w2) as d order by 1 nulls first\nW18 an error per row	select d.x, (select sum(1 / (w1.p - 5)) from w1 where w1.b2 = d.x) from (select f as x from w2) as d order by 1\nW18 EXISTS over batches	select count(*), sum(d.x) from (select cast(i as float8) / 2 as x from generate_series(1, 3000) as i) as d where exists (select 1 from w1 where w1.b2 = d.x)\nW18 scalar over batches	select count(*), sum(d.x) from (select cast(i as float8) / 2 as x from generate_series(1, 3000) as i) as d where (select sum(p) from w1 where w1.b2 = d.x) > 1\nV UNION ALL a char and a text	select a, n from q0 union all select b, n from q1 order by 1, 2\nV DESC	select a, n from q0 union all select b, n from q1 order by 1 desc, 2 desc\nV by name, NULLS FIRST	select a as x, n from q0 union all select b, n from q1 order by x nulls first, n\nV UNION	select a, n from q0 union select b, n from q1 order by 1, 2\nV char(3) and char(5)	select a, n from q0 union all select a, n from q2 order by 1 desc, 2\nV LIMIT	select a, n from q0 union all select b, n from q1 order by 1, 2 limit 4\nV LIMIT OFFSET	select a, n from q0 union all select b, n from q1 order by 1, 2 limit 3 offset 2\nV three	select a, n from q0 union all select b, n from q1 union all select a, n from q2 order by 1, 2\nV EXCEPT	(select a, n from q0 union all select b, n from q1) except select a, n from q2 order by 1, 2\nV INTERSECT	select a, n from q0 intersect select b, n - 5 from q1 order by 1, 2\nV a literal first	select 'a' as a, 2 as n union all select a, n from q0 order by 1, 2\nV an empty side	select a, n from q3 union all select b, n from q1 order by 1, 2\nV duplicates	select a, n from q0 union all select a, n from q0 order by 1, 2\nV over a derived union, LIMIT	select x, n from (select a as x, n from q0 union all select b, n from q1) as d order by x desc, n limit 4"

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let setup: str = SETUP
    for l in strings.lines(&setup) {
        let o = q(mut &s, &l)
        if strings.startsWith(&o, "ERROR") { println(l + ": " + o) }
    }
    let qs: str = QS
    for l in strings.lines(&qs) {
        let parts = strings.split(&l, "\t")
        two(mut &s, &parts[0], &parts[1])
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(99), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 4 * 1024 * 1024, ckptBytes: 2 * 1024 * 1024,
                                                           snapNodes: 100000}, body).unwrap()
}
