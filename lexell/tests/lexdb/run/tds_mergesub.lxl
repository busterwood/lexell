// lexdb over TDS: MERGE's subqueries read the rows as the statement found them, not as its own earlier rows left them, checked against
// SQL Server 2022 (generated by tests/lexdb/gen_mssql.py mergesub from mssql_mergesub_queries.txt): in UPDATE's SET, a WHEN condition,
// DELETE, INSERT's values and WHEN NOT MATCHED BY SOURCE, correlated and not, a source that is the target, NULLs, an empty and a duplicate
// source (8672), text keys, an error in a later row, TOP, OUTPUT (10705 for a subquery there). Each batch runs with SET lexdb_batch off and
// on; each expect line: "same: " and the batch's result sets and counts, or its error number.
// expect: ok
// expect: (4)
// expect: ok
// expect: (3)
// expect: same: (3) / id,salary: 1|100;2|101;3|201;4|301
// expect: same: (4) / id,salary: 1|1000;2|1000;3|1000;4|1000
// expect: same: (4) / id,salary: 1|103;2|202;3|301;4|400
// expect: same: (3) / id,salary: 1|100;2|100;3|200;4|300
// expect: same: (2) / id,salary: 1|404;2|404;3|300;4|400
// expect: same: (2) / id,salary: 1|100;2|1200;3|1300;4|400
// expect: same: (3) / id,salary: 1|100
// expect: same: (3) / id,salary: 1|100;4|0
// expect: same: (3) / id,salary: 1|100;2|200;3|4;4|4;5|4
// expect: same: (3) / id,salary: 1|100;2|200;3|300;4|400;5|4;6|4;7|4
// expect: same: (3) / id,salary: 1|100;2|200;3|300;4|400;5|4;6|4;7|4
// expect: same: (3) / id,salary: 1|4;2|200;3|300;4|400;5|4;7|4
// expect: same: (4) / id,salary: 1|100;2|4;3|300;4|400;5|4;6|4;7|4
// expect: same: (3) / id,salary: 1|4;2|200;3|2;4|1
// expect: same: (3) / id,salary: 1|100;2|200;9|4
// expect: same: error 10705
// expect: same: $action,id,salary: 'INSERT'|5|4;'INSERT'|6|4
// expect: same: id,salary,salary: 2|200|101;3|300|201;4|400|301
// expect: same: id,$action: 2|'DELETE';3|'DELETE'
// expect: same: error 10705
// expect: same: error 10705
// expect: same: error 10705
// expect: same: id,salary: 1|5
// expect: same: (2) / id,salary: 1|NULL;2|100;3|300;4|400
// expect: same: (0) / : 0
// expect: same: (3) / id,salary: 1|100;2|4;3|300;4|4;99|4
// expect: same: error 8672
// expect: same: (1) / id,salary: 1|100;3|300;4|400
// expect: same: (3) / k,v: 'a'|6;'b'|6;'c'|3;'z'|3
// expect: same: (1) / k,v: 'b'|2;'c'|3
// expect: same: error 8134
// expect: same: error 8134
// expect: same: error 2627
// expect: same: error 512
// expect: same: (1) / id,salary: 1|100;2|NULL;3|300;4|400
// expect: same: (2) / id,salary: 1|100;2|3;3|2;4|400
// expect: same: (2) / id,salary: 1|100;2|202;3|303;4|400
// expect: same: id,salary: 2|0;6|9
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once CREATE TABLE emp (id int PRIMARY KEY, mgr_id int, salary int)\n@once INSERT INTO emp VALUES (1, NULL, 100), (2, 1, 200), (3, 2, 300), (4, 3, 400)\n@once CREATE TABLE tk (k varchar(10) PRIMARY KEY, v int)\n@once INSERT INTO tk VALUES ('a', 1), ('b', 2), ('c', 3)\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT x.salary + 1 FROM emp x WHERE x.id = e.mgr_id); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (SELECT id FROM emp) s ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT SUM(salary) FROM emp); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (1), (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = salary + (SELECT COUNT(*) FROM emp x WHERE x.salary > e.salary); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING emp s ON e.id = s.id + 1 WHEN MATCHED THEN UPDATE SET salary = (SELECT x.salary FROM emp x WHERE x.id = s.id); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (SELECT id, (SELECT MAX(salary) FROM emp) m FROM emp WHERE id < 3) s ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = s.m + (SELECT COUNT(*) FROM emp); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED AND (SELECT x.salary FROM emp x WHERE x.id = e.mgr_id) < 300 THEN UPDATE SET salary = salary + 1000; SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED AND e.salary > (SELECT MIN(salary) FROM emp) THEN DELETE; SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED AND EXISTS (SELECT 1 FROM emp x WHERE x.mgr_id = e.id) THEN DELETE WHEN MATCHED AND (SELECT COUNT(*) FROM emp) > 3 THEN UPDATE SET salary = 0; SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3), (4), (5)) s(id) ON e.id = s.id WHEN MATCHED AND e.salary > 250 THEN UPDATE SET salary = (SELECT COUNT(*) FROM emp) WHEN NOT MATCHED AND (SELECT COUNT(*) FROM emp) < 5 THEN INSERT (id, salary) VALUES (s.id, (SELECT COUNT(*) FROM emp)); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (5), (6), (7)) s(id) ON e.id = s.id WHEN NOT MATCHED THEN INSERT (id, salary) VALUES (s.id, (SELECT COUNT(*) FROM emp)); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (5), (6), (7)) s(id) ON e.id = s.id WHEN NOT MATCHED THEN INSERT (id, salary) VALUES (s.id, (SELECT COUNT(*) FROM emp x WHERE x.id < s.id)); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (5), (1), (7)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT COUNT(*) FROM emp) WHEN NOT MATCHED THEN INSERT (id, salary) VALUES (s.id, (SELECT COUNT(*) FROM emp)); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (5), (6), (7), (2)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT COUNT(*) FROM emp x WHERE x.id <= s.id + 3) WHEN NOT MATCHED THEN INSERT (id, salary) VALUES (s.id, (SELECT COUNT(*) FROM emp x WHERE x.id <= s.id)); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (9)) s(id) ON e.id = s.id WHEN NOT MATCHED BY SOURCE THEN UPDATE SET salary = (SELECT COUNT(*) FROM emp x WHERE x.salary >= e.salary); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (9)) s(id) ON e.id = s.id WHEN NOT MATCHED BY SOURCE AND e.salary > (SELECT MIN(salary) FROM emp) THEN DELETE WHEN NOT MATCHED BY TARGET THEN INSERT (id, salary) VALUES (s.id, (SELECT COUNT(*) FROM emp)); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (5), (6)) s(id) ON e.id = s.id WHEN NOT MATCHED THEN INSERT (id, salary) VALUES (s.id, (SELECT COUNT(*) FROM emp)) OUTPUT inserted.id, (SELECT COUNT(*) FROM emp); ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (5), (6)) s(id) ON e.id = s.id WHEN NOT MATCHED THEN INSERT (id, salary) VALUES (s.id, (SELECT COUNT(*) FROM emp x WHERE x.id < s.id)) OUTPUT $action, inserted.id, inserted.salary; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT x.salary + 1 FROM emp x WHERE x.id = e.mgr_id) OUTPUT deleted.id, deleted.salary, inserted.salary; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED AND EXISTS (SELECT 1 FROM emp x WHERE x.mgr_id = e.id) THEN DELETE OUTPUT deleted.id, $action; ROLLBACK\nBEGIN TRAN; UPDATE emp SET salary = 1 OUTPUT inserted.id, (SELECT COUNT(*) FROM emp) WHERE id = 1; ROLLBACK\nBEGIN TRAN; DELETE FROM emp OUTPUT deleted.id, CASE WHEN EXISTS (SELECT 1 FROM emp x WHERE x.mgr_id = deleted.id) THEN 1 ELSE 0 END WHERE id = 1; ROLLBACK\nBEGIN TRAN; INSERT INTO emp (id, salary) OUTPUT inserted.id, inserted.salary + (SELECT 1) VALUES (9, 9); ROLLBACK\nBEGIN TRAN; UPDATE emp SET salary = (SELECT 5) OUTPUT inserted.id, inserted.salary WHERE id IN (SELECT 1); ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (1), (2)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT x.salary FROM emp x WHERE x.id = e.mgr_id); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (SELECT 1 WHERE 1 = 0) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT COUNT(*) FROM emp) WHEN NOT MATCHED THEN INSERT (id) VALUES (s.id); SELECT @@ROWCOUNT; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (NULL), (4)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT COUNT(*) FROM emp) WHEN NOT MATCHED THEN INSERT (id, salary) VALUES (ISNULL(s.id, 99), (SELECT COUNT(*) FROM emp)); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (2)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT COUNT(*) FROM emp); ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (2)) s(id) ON e.id = s.id WHEN MATCHED AND (SELECT COUNT(*) FROM emp) > 3 THEN DELETE; SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE tk t USING (VALUES ('a'), ('b'), ('z')) s(k) ON t.k = s.k WHEN MATCHED THEN UPDATE SET v = (SELECT SUM(v) FROM tk) WHEN NOT MATCHED THEN INSERT (k, v) VALUES (s.k, (SELECT COUNT(*) FROM tk)); SELECT k, v FROM tk ORDER BY k; ROLLBACK\nBEGIN TRAN; MERGE tk t USING (VALUES ('a'), ('c')) s(k) ON t.k = s.k WHEN MATCHED AND (SELECT MAX(v) FROM tk x WHERE x.k <> t.k) > 2 THEN DELETE; SELECT k, v FROM tk ORDER BY k; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT 1 / (x.salary - 300) FROM emp x WHERE x.id = e.id); ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED AND (SELECT 1 / (x.salary - 300) FROM emp x WHERE x.id = e.id) > 0 THEN DELETE; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (5), (5)) s(id) ON e.id = s.id WHEN NOT MATCHED THEN INSERT (id, salary) VALUES (s.id, (SELECT COUNT(*) FROM emp)); ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT salary FROM emp WHERE id > 1); ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT salary FROM emp WHERE id > 5); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE TOP (2) emp e USING (VALUES (2), (3), (4)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = (SELECT COUNT(*) FROM emp x WHERE x.salary >= e.salary); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (3)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = e.salary + s.id; SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; MERGE emp e USING (VALUES (2), (6)) s(id) ON e.id = s.id WHEN MATCHED THEN UPDATE SET salary = 0 WHEN NOT MATCHED THEN INSERT (id, salary) VALUES (s.id, 9) OUTPUT inserted.id, inserted.salary; ROLLBACK"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(56), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
