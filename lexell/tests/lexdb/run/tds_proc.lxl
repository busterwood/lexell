const QUERIES = "CREATE TABLE t (id int PRIMARY KEY, v int)\nINSERT INTO t VALUES (1, 10), (2, 20)\nCREATE TABLE lg (i int IDENTITY(1,1), m varchar(20))\nSELEC 1\nfoo\nCREATE PROCEDURE p1 @a int, @b int = 5, @c int OUTPUT AS BEGIN SELECT @a + @b AS s; SET @c = @a * 2; SELECT * FROM t WHERE id <= @a; RETURN 7 END\nCREATE PROCEDURE p1 AS SELECT 1\nCREATE PROCEDURE t AS SELECT 1\nSELECT 1 AS a CREATE PROCEDURE p2 AS SELECT 1\nCREATE PROCEDURE bad AS SELECT FROM\nCREATE PROCEDURE bad2 @a AS SELECT 1\nSELECT OBJECT_ID('bad'), OBJECT_ID('bad2')\nEXEC p1 1, 2, 0\nEXEC p1 @a = 1, @b = 2, @c = 0\nEXEC p1 @c = 0, @a = 2\nDECLARE @o int, @rc int; EXEC @rc = p1 1, @c = @o OUTPUT; SELECT @o AS o, @rc AS rc\nDECLARE @o int, @rc int; EXEC @rc = dbo.p1 @a = 3, @c = @o OUTPUT; SELECT @o AS o, @rc AS rc\nDECLARE @o int; EXEC p1 4, @c = @o OUTPUT; SELECT @o AS o\nEXEC p1 1\nEXEC p1 @b = 1\nEXEC p1 1, 2, 3, 4\nEXEC p1 @a = 1, @zz = 3\nEXEC p1 @a = 1, @c = 0, @zz = 3\nEXEC p1 @a = 1, 2\nEXEC p1 @a = 1, @a = 2, @c = 0\nEXEC p1 DEFAULT, 1, 0\nEXEC p1 1, DEFAULT, 0\nEXEC p1 @a = 1, @b = DEFAULT, @c = 0\nDECLARE @x int = 1; EXEC p1 @a = 1, @c = @x\nDECLARE @x int; EXEC p1 1, 2, @x OUTPUT; SELECT @x AS x\nEXEC p1 1, 2, 3 OUTPUT\nDECLARE @x int; EXEC p1 @x OUTPUT, 2, 0\nCREATE PROCEDURE q3 @a int OUTPUT AS SET @a = @a + 1\nDECLARE @x int = 1; EXEC q3 @x; SELECT @x AS x1; EXEC q3 @x OUTPUT; SELECT @x AS x2; EXEC q3 @a = @x OUTPUT; SELECT @x AS x3\nDECLARE @x varchar(10) = 'abc'; EXEC q3 @x OUTPUT\nDECLARE @x varchar(10) = '5'; EXEC q3 @x OUTPUT; SELECT @x AS x\nEXEC q3 'abc'\nEXEC q3 5\nEXEC q3 5 OUTPUT\nEXEC q3 NULL\nCREATE PROCEDURE q4 @s varchar(5) = 'dflt', @i int = NULL, @d decimal(5,2) = -1.5, @n nvarchar(10) = N'nn', @bt bit = 1 AS SELECT @s AS s, @i AS i, @d AS d, @n AS n, @bt AS bt\nEXEC q4\nEXEC q4 'x', 2, 3.14159, N'abcdefghijklm', 0\nEXEC q4 DEFAULT, 3\nEXEC q4 @i = 4\nEXEC q4 @s = DEFAULT, @d = 99.999\nEXEC q4 'toolong'\nEXEC q4 @s = 'a', @s = 'b'\nEXEC q4 @i = 'x'\nEXEC q4 @i = 2147483648\nEXEC q4 @d = 1000\nCREATE PROCEDURE q5 AS EXEC q5\nEXEC q5\nCREATE PROCEDURE q5a @n int AS BEGIN IF @n > 0 BEGIN SELECT @n AS n; DECLARE @m int = @n - 1; EXEC q5a @m END END\nEXEC q5a 3\nCREATE PROCEDURE fact @n int, @r bigint OUTPUT AS BEGIN IF @n <= 1 SET @r = 1 ELSE BEGIN DECLARE @sub bigint; DECLARE @m int = @n - 1; EXEC fact @m, @sub OUTPUT; SET @r = @n * @sub END END\nDECLARE @r bigint; EXEC fact 10, @r OUTPUT; SELECT @r AS r\nDECLARE @r bigint; EXEC fact 25, @r OUTPUT; SELECT @r AS r\nDECLARE @r bigint; EXEC fact 31, @r OUTPUT; SELECT @r AS r\nCREATE PROCEDURE lvl AS SELECT @@NESTLEVEL AS lvl\nCREATE PROCEDURE lvl2 AS BEGIN EXEC lvl; EXEC lvl END\nEXEC lvl2\nSELECT @@NESTLEVEL AS lvl\nCREATE PROCEDURE tryp AS BEGIN TRY DECLARE @z int; SET @z = 1 / 0 END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_PROCEDURE() AS p, ERROR_MESSAGE() AS m END CATCH\nEXEC tryp\nCREATE PROCEDURE boom AS RAISERROR('boom', 16, 1)\nEXEC boom\nDECLARE @rc int = -1; BEGIN TRY EXEC @rc = boom END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_MESSAGE() AS m, ERROR_PROCEDURE() AS p, @rc AS rc END CATCH\nCREATE PROCEDURE boom2 AS BEGIN EXEC boom; SELECT 'not reached' AS nr END\nBEGIN TRY EXEC boom2 END TRY BEGIN CATCH SELECT ERROR_PROCEDURE() AS p, ERROR_LINE() AS ln END CATCH\nCREATE PROCEDURE thrower AS THROW 50001, 'thrown', 2\nBEGIN TRY EXEC thrower END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_MESSAGE() AS m, ERROR_STATE() AS s, ERROR_PROCEDURE() AS p END CATCH\nCREATE PROCEDURE missing_in AS SELECT * FROM nosuch_table\nBEGIN TRY EXEC missing_in END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_PROCEDURE() AS p END CATCH\nCREATE PROCEDURE z1 AS BEGIN SELECT * FROM nosuch; INSERT INTO lg (m) VALUES ('after1') END\nEXEC z1; INSERT INTO lg (m) VALUES ('caller1')\nSELECT m FROM lg ORDER BY i\nDELETE FROM lg\nCREATE PROCEDURE z2 AS BEGIN SELECT 1 / 0 AS x; INSERT INTO lg (m) VALUES ('after2') END\nEXEC z2; INSERT INTO lg (m) VALUES ('caller2')\nSELECT m FROM lg ORDER BY i\nDELETE FROM lg\nCREATE PROCEDURE z3 AS BEGIN EXEC z1; INSERT INTO lg (m) VALUES ('after3') END\nEXEC z3; INSERT INTO lg (m) VALUES ('caller3')\nSELECT m FROM lg ORDER BY i\nDELETE FROM lg\nCREATE PROCEDURE z5 AS BEGIN THROW 50001, 'x', 1; INSERT INTO lg (m) VALUES ('after5') END\nEXEC z5; INSERT INTO lg (m) VALUES ('caller5')\nSELECT m FROM lg ORDER BY i\nEXEC nothing; INSERT INTO lg (m) VALUES ('after missing')\nSELECT m FROM lg ORDER BY i\nCREATE PROCEDURE z6 AS BEGIN EXEC nothing; INSERT INTO lg (m) VALUES ('z6 after missing') END\nEXEC z6; INSERT INTO lg (m) VALUES ('caller6')\nSELECT m FROM lg ORDER BY i\nDELETE FROM lg\nCREATE PROCEDURE ins @m varchar(20) AS BEGIN INSERT INTO lg (m) VALUES (@m); RETURN @@ROWCOUNT END\nDECLARE @n int; EXEC @n = ins 'a'; EXEC ins 'b'; SELECT @n AS n, COUNT(*) AS c FROM lg\nBEGIN TRAN; EXEC ins 'rolled back'; ROLLBACK; SELECT COUNT(*) AS c FROM lg\nCREATE PROCEDURE tx AS BEGIN BEGIN TRAN; INSERT INTO lg (m) VALUES ('in tx'); COMMIT END\nEXEC tx; SELECT COUNT(*) AS c FROM lg\nCREATE PROCEDURE tmpt AS BEGIN CREATE TABLE #tmp (a int); INSERT INTO #tmp VALUES (1), (2); SELECT COUNT(*) AS c FROM #tmp END\nEXEC tmpt\nEXEC tmpt\nCREATE PROCEDURE tmp_user AS SELECT a FROM #outer_tmp ORDER BY a\nCREATE TABLE #outer_tmp (a int); INSERT INTO #outer_tmp VALUES (3), (4); EXEC tmp_user\nCREATE PROCEDURE tabv AS BEGIN DECLARE @tv TABLE (a int); INSERT INTO @tv VALUES (1), (2), (3); SELECT SUM(a) AS s FROM @tv END\nEXEC tabv\nEXEC tabv\nCREATE PROCEDURE loops @n int AS BEGIN DECLARE @i int = 0, @s int = 0; WHILE @i < @n BEGIN SET @i += 1; IF @i % 2 = 0 CONTINUE; SET @s += @i END; SELECT @s AS s; RETURN @s END\nDECLARE @r int; EXEC @r = loops 10; SELECT @r AS r\nCREATE PROCEDURE sets AS BEGIN SELECT 1 AS a; SELECT 'x' AS b, 2 AS c; SELECT id FROM t ORDER BY id END\nEXEC sets\nCREATE PROCEDURE nocnt AS BEGIN SET NOCOUNT ON; INSERT INTO lg (m) VALUES ('q'); SELECT 1 AS a END\nEXEC nocnt\nCREATE TABLE dst (id int, v int)\nCREATE PROCEDURE two_cols AS SELECT id, v FROM t ORDER BY id\nINSERT INTO dst EXEC two_cols\nSELECT * FROM dst ORDER BY id\nEXEC('EXEC p1 1, 2, 0')\nEXEC sp_executesql N'EXEC p1 @a, 2, 0', N'@a int', 5\nEXEC sp_executesql N'DECLARE @o int; EXEC p1 @a, 2, @o OUTPUT; SELECT @o AS o', N'@a int', 5\nCREATE PROCEDURE outs @a int OUTPUT, @b varchar(10) OUTPUT AS SELECT @a = 7, @b = 'seven'\nDECLARE @x int, @y varchar(10); EXEC outs @x OUTPUT, @y OUTPUT; SELECT @x AS x, @y AS y\nDECLARE @x int, @y varchar(10); EXEC outs @b = @y OUTPUT, @a = @x OUTPUT; SELECT @x AS x, @y AS y\nCREATE PROCEDURE ro @a int = 1 AS RETURN\nDECLARE @r int = 5; EXEC @r = ro; SELECT @r AS r\nRETURN 3\nCREATE SCHEMA s2\nCREATE PROCEDURE s2.sp @x int AS SELECT @x * 2 AS dbl\nEXEC s2.sp 4\nEXEC sp 4\nEXEC dbo.sp 4\nCREATE PROCEDURE dbo.dp @x int AS SELECT @x * 3 AS tpl\nEXEC dp 4\nEXEC dbo.dp 4\nEXEC [dp] 4\nEXEC [dbo].[dp] 4\nEXEC DP 4\nexec Dp @X = 4\nSELECT name, type, type_desc, SCHEMA_NAME(schema_id) AS sch FROM sys.procedures WHERE name IN ('p1', 'dp', 'sp') ORDER BY name\nSELECT name, type, type_desc FROM sys.objects WHERE type = 'P' AND name IN ('p1', 'dp', 'sp') ORDER BY name\nSELECT CASE WHEN OBJECT_ID('p1') IS NOT NULL THEN 1 END AS a, CASE WHEN OBJECT_ID('dbo.dp') IS NOT NULL THEN 1 END AS b, CASE WHEN OBJECT_ID('s2.sp') IS NOT NULL THEN 1 END AS c, OBJECT_ID('s2.dp') AS d, CASE WHEN OBJECT_ID('p1', 'P') IS NOT NULL THEN 1 END AS e, OBJECT_ID('p1', 'U') AS f, CASE WHEN OBJECT_ID('t', 'U') IS NOT NULL THEN 1 END AS g\nSELECT OBJECT_NAME(OBJECT_ID('p1')) AS n\nSELECT OBJECT_DEFINITION(OBJECT_ID('p1'))\nSELECT OBJECT_DEFINITION(OBJECT_ID('dp'))\nSELECT p.name, m.definition FROM sys.sql_modules m JOIN sys.procedures p ON p.object_id = m.object_id WHERE p.name IN ('dp', 'sp') ORDER BY p.name\nSELECT name, parameter_id, TYPE_NAME(system_type_id) AS tn, max_length, is_output, has_default_value FROM sys.parameters WHERE object_id = OBJECT_ID('p1') ORDER BY parameter_id\nSELECT name, parameter_id, TYPE_NAME(system_type_id) AS tn, max_length, precision, scale, is_output FROM sys.parameters WHERE object_id = OBJECT_ID('q4') ORDER BY parameter_id\nCREATE OR ALTER PROCEDURE dp @x int, @y int = 2 AS SELECT @x * @y AS prod\nEXEC dp 4\nSELECT OBJECT_DEFINITION(OBJECT_ID('dp'))\nCREATE OR ALTER PROC brand_new AS SELECT 'new' AS n\nSELECT OBJECT_DEFINITION(OBJECT_ID('brand_new'))\nEXEC brand_new\ncreate or alter procedure brand_new as select 'newer' as n\nEXEC brand_new\nALTER PROCEDURE brand_new AS SELECT 'altered' AS n\nSELECT OBJECT_DEFINITION(OBJECT_ID('brand_new'))\nEXEC brand_new\nalter procedure brand_new as select 'lower alter' as n\nSELECT OBJECT_DEFINITION(OBJECT_ID('brand_new'))\nAlter  Procedure  brand_new  as  select 'spaced' as n\nSELECT OBJECT_DEFINITION(OBJECT_ID('brand_new'))\nALTER PROCEDURE not_there AS SELECT 1\nCREATE OR ALTER PROCEDURE t AS SELECT 1\nCREATE PROCEDURE with_opts @a int WITH RECOMPILE AS SELECT @a AS a\nEXEC with_opts 1\nCREATE PROCEDURE with_paren (@a int, @b int = 2) AS SELECT @a + @b AS s\nEXEC with_paren 1\nCREATE PROCEDURE no_params AS\nCREATE PROCEDURE only_comment AS /* nothing */ SELECT 'c' AS c\nEXEC only_comment\nDROP PROCEDURE brand_new\nEXEC brand_new\nDROP PROCEDURE brand_new\nDROP PROCEDURE IF EXISTS brand_new\nDROP PROCEDURE IF EXISTS with_opts, with_paren\nEXEC with_opts 1\nDROP PROC only_comment\nDROP PROCEDURE t\nDROP PROCEDURE s2.sp\nDROP PROCEDURE dbo.dp, p1\nSELECT name FROM sys.procedures ORDER BY name\nDROP PROCEDURE nothing_here\nDROP PROCEDURE a_schema.nothing\nCREATE PROCEDURE after_drop @a int AS SELECT @a AS a\nEXEC after_drop 1\nDROP PROCEDURE after_drop\nCREATE PROCEDURE after_drop @a int, @b int AS SELECT @a + @b AS s\nEXEC after_drop 1\nEXEC after_drop 1, 2\nSELECT name FROM sys.procedures ORDER BY name\nALTER PROCEDURE t AS SELECT 1\nCREATE PROCEDURE op1 AS SELECT 1 AS a\nSELECT OBJECTPROPERTY(OBJECT_ID('op1'), 'IsProcedure') AS p, OBJECTPROPERTY(OBJECT_ID('t'), 'IsProcedure') AS q, OBJECTPROPERTY(OBJECT_ID('op1'), 'IsTable') AS r\nCALL op1()\nDROP ROUTINE op1\nEXEC op1"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(37), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
