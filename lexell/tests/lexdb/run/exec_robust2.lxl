import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table rt (k int primary key, v text)\n@once insert into rt select g, 'v' || g from generate_series(1, 100) g\n@once create table nulls (a int, b int)\n@once insert into nulls values (1, null), (null, 2), (3, 3)\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i from n where i % 7 = 0 limit 3\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i from n where i % 7 = 0 limit 3 offset 2\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i from n where i % 7 = 0 fetch first 3 rows only\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i, i * 2 as d from n where i > 100 and i % 2 = 1 limit 2\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i from n where i % 7 = 0 limit 0\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i from n where i > 300 limit 1\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i from n where i > 3 limit 1 offset 70\nwith recursive n(i) as (select 1 union all select i + 1 from n where i < 10) select i from n where i % 7 = 0 limit 3\nwith recursive n(i) as (select 1 union all select i + 1 from n where i < 100) select i from n where i % 7 = 0 limit 30\nwith recursive n(i) as (select 1 union select i + 1 from n) select i from n where i % 5 = 0 limit 3\nwith recursive n(i, s) as (select 1, 'a' union all select i + 1, s || 'b' from n) select i, s from n where i % 4 = 0 limit 2\nwith recursive n(i, x) as (select 1, 1 union all select i + 1, case when i % 2 = 0 then null else i end from n) select i, x from n where x is null limit 3\nwith recursive n(i) as (select 1 union all select i + 1 from n) select n.i, rt.v from n join rt on rt.k = n.i where n.i % 2 = 0 limit 3\nwith recursive n(i) as (select 1 union all select i + 1 from n) select n.i, rt.v from n left join rt on rt.k = n.i where n.i % 50 = 0 limit 3\nwith recursive n(i) as (select 1 union all select i + 1 from n) select n.i, rt.v from n, rt where rt.k = n.i and n.i > 98 limit 2\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i from (select i from n where i > 3) s limit 3\nwith recursive n(i) as (select 1 union all select i + 1 from n) select j from (select i * 10 as j from n where i % 2 = 0) s where j > 100 limit 2\nwith recursive n(i) as (select 1 union all select i + 1 from n) select count(*) from (select i from n where i % 7 = 0 limit 3) s\nwith recursive n(i) as (select 1 union all select i + 1 from n) select sum(i) from (select i from n where i % 7 = 0 fetch first 4 rows only) s\nwith recursive r(n) as (select 1 union all select n + 1 from r where n < 6) (select n from r where n > 1 limit 3) union all (select n from r)\nwith recursive r(n) as (select 1 union all select n + 1 from r where n < 6), s as (select n from r) select (select count(*) from (select n from r where n > 2 limit 2) x), (select count(*) from s)\nwith recursive n(i) as (select 1 union all select case when i = 40 then 1 / (i - 40) else i + 1 end from n) select i from n where i % 7 = 0 limit 3\nwith recursive n(i) as (select 1 union all select case when i = 40 then 1 / (i - 40) else i + 1 end from n) select i from n where i % 7 = 0 limit 7\nwith recursive n(i) as (select 1 union all select i + 1 from n) select 100 / (30 - i) from n where i % 7 = 0 limit 4\nwith recursive n(i) as (select 1 union all select i + 1 from n) select 100 / (30 - i) from n where i % 7 = 0 limit 5\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i from n limit 3\nwith recursive n(i) as (select 1 union all select i + 1 from n) select i from n where i > 5 limit 2 offset 1\nselect 2147483647 + 1\nselect 2147483647 + 0\nselect -2147483648 - 1\nselect -2147483648 + 0\nselect 2147483647 * 2\nselect 46341 * 46341\nselect 46340 * 46340\nselect 1 + 2147483647 + 1\nselect 2147483647 + 0 + 1\nselect 2147483647 - -1\nselect 1 - -2147483648\nselect 3 * -715827883\nselect 2147483648 + 1\nselect 2147483647 + 1::bigint\nselect 2147483647 + 1.0\nselect 2147483647::bigint + 1\nselect (2147483647 + 1)::bigint\nselect 9223372036854775807 + 1\nselect 9223372036854775807 * 2\nselect -9223372036854775808 - 1\nselect 9223372036854775807 - -1\nselect 4611686018427387904 * 2\nselect 4611686018427387904 + 4611686018427387903\nselect 32767 + 1\nselect 2147483647 + 1 where false\nselect 2147483647 + 1 as x union all select 1\nselect i from generate_series(1, 3) i where i + 2147483647 > 0\nselect i + 1 from (select 2147483647 as i) s\n@once create table lit (id int primary key, v int)\n@once insert into lit values (1, 2147483647)\n@tx update lit set v = v + 1 where id = 1\n@tx update lit set v = 2147483647 + 1 where id = 1\n@tx insert into lit values (2, 2147483647 + 1)\nselect id, v + 0 from lit where id = 1\nselect 2147483647 - 1 + 1"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(171), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
