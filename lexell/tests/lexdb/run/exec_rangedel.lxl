// lexdb_exec: a DELETE of a primary key range drops the key range from the
// tree as one write (design/lexdb-bulkdelete.md 2.1, stage 4). Each shape
// below is run twice on identical tables, with SET lexdb_range_delete on
// and off: the command tags, the rows left (a full ordered dump, with
// checks through the indexes) and the data file's audit after the store
// closes must agree, and EXPLAIN and the count of range deletes taken
// (lexdb_exec.rangeDeletes) must show the path chosen: a shape that should
// take it does, a fallback does not. The tables hold 4,000 to 6,000 rows
// of about 200 bytes in a 256 KB cache, so most of a covered range is on
// disk and its subtrees are dropped without being read.
// - takes the path: one-, two- and three-column keys of int, bigint,
//   numeric, date, timestamp, timestamptz, uuid and text; =, <, <=, >, >=,
//   BETWEEN, both bounds, a bound flipped, parameters, now(), a scalar
//   subquery, NULL, no WHERE; keys at the ends of the type; deletes in a
//   row with inserts into the dropped range between; large values in the
//   range; indexes that lead with the range's key columns, and (stage 6)
//   indexes that do not, whose entries go one by one (exec_rangedel_ix
//   has those at length); a temporary
//   table; a keyless table.
// - falls back: a table others reference, RETURNING, USING, a residual
//   conjunct, OR, IN, a bound that does not survive the column's type
//   (1500.5 on an int, a numeric scale, a timestamp on a date, a bigint
//   past an int, a float), a float key, a case-insensitive key, a volatile
//   function, a point, a column after the first, an equality and a range on
//   one column, two bounds one way.
// - inside a transaction block (stage 5; Txn.cuts, Store.countView): 12
//   scripts run on and off, each reading the rows after the range delete
//   (point, range, backward, IN, through an index), inserting into the
//   deleted range, updating and deleting in it (0 rows), own writes before
//   the delete (inserts of new keys, updates, deletes, earlier overlapping
//   range deletes, adjacent ones), savepoints (ROLLBACK TO before and
//   after), ROLLBACK, a table made in the block, large values and
//   qualifying indexes; the counts must equal the row path's. Then two
//   sessions: 40001 both ways, a write of a row in the range that commits
//   first or second, a locked row, a lock taken after.
// - the switch (SET, SHOW, RESET, a block's ROLLBACK); a row locked by
//   another session; a row inserted into the range by another session
//   between the count and the commit (40001: the statement runs again and
//   deletes it too).
// expect: shapes 134: tags equal 134, rows equal 134, audits clean 268
// expect: path as expected 134: 99 took it, 35 fell back
// expect: switch: on, off, on after RESET, on after the block's ROLLBACK, 22023 for junk
// expect: locked: explain without the line true, with it after COMMIT true
// expect: concurrent insert: DELETE 1801, the count ran again true, left 2200, the inserted row gone true, audit clean true
// expect: blocks, insert first: DELETE 300, in block SELECT 1: 0, INSERT 0 1, commit error 40001, then SELECT 1: 301
// expect: blocks, again: DELETE 301, COMMIT, left SELECT 1: 0
// expect: blocks, outside: DELETE 101, INSERT 0 1, UPDATE 1, commit COMMIT, left SELECT 1: 20
// expect: blocks, delete first: DELETE 11, the block's commit error 40001
// expect: blocks, update first: DELETE 101, UPDATE 1, COMMIT, delete's commit error 40001
// expect: blocks, delete first, update second: DELETE 101, UPDATE 1, COMMIT, update's commit error 40001
// expect: blocks, locked first: explain over the locked rows true, elsewhere true
// expect: blocks, lock after: DELETE 101, the locker SELECT 1: 5250 and UPDATE 1 at once, delete's commit COMMIT, locker's commit error 40001
// expect: blocks, lock after, locker first: DELETE 101, locker's commit COMMIT, delete's commit error 40001, row left SELECT 1: 1
// expect: blocks, range deletes taken 8
// expect: blocks, table SELECT 1: 5375|16585139
// expect: blocks: audit clean true
// timeout: 600
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_sql"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_parse"

type Val = lexdb_sql.Val

type Q = record { sql: str; ps: []Val }

type Shape = record {
    name: str
    fam: str
    pre: []str                  // run before: SET and the like
    stmts: []Q
    take: bool                  // the statements take the range path
    block: bool                 // EXPLAIN is asked inside a block
    noex: bool                  // the first DELETE is not the one to check EXPLAIN on
}

type Fam = record { setup: []str; dump: []str }

type Out = record { tags: str; dump: str; audit: str; ex: str; taken: int }

fn q(sql: str): Q { return Q{sql: sql, ps: []} }

fn qp(sql: str, ps: []Val): Q { return Q{sql: sql, ps: ps} }

// A script run in one session: its DELETEs without a residual take the path.
fn blockShape(name: str, fam: str, sqls: []str): Shape {
    var qs: []Q = []
    for x in sqls { append(mut &qs, q(x.clone())) }
    var b = sh(name.clone(), fam, qs, true)
    b.block = true
    b.noex = name == "block: own writes before the delete" || name == "block: a table made in it"
    return b
}

fn sh(name: str, fam: str, stmts: []Q, take: bool): Shape {
    return Shape{name: name, fam: fam, pre: [], stmts: stmts, take: take, block: false, noex: false}
}

fn gs(n: int): str { return "generate_series(1, " + n.toStr() + ") i" }

const PAD: str = "repeat('x', 150)"

fn famOf(name: str): Fam {
    let ck = ["select count(*) from t"]
    if name == "int" {
        return Fam{setup: ["create table t (id int primary key, v int not null, pad text not null)",
                           "insert into t select i, i % 7, " + PAD + " from " + gs(6000),
                           "create table u (id int primary key)", "insert into u select i from " + gs(200)],
                   dump: ["select id, v, pad from t order by id", "select count(*), min(id), max(id) from t"]}
    }
    if name == "bigint" {
        return Fam{setup: ["create table t (id bigint primary key, pad text not null)",
                           "insert into t select 9223372036854775807 - i, " + PAD + " from " + gs(4000)],
                   dump: ["select id, pad from t order by id", "select count(*) from t"]}
    }
    if name == "numeric" {
        return Fam{setup: ["create table t (id numeric(12,2) primary key, pad text not null)",
                           "insert into t select i * 0.5 - 1500, " + PAD + " from " + gs(4000)],
                   dump: ["select id, pad from t order by id", "select count(*) from t"]}
    }
    if name == "date" {
        return Fam{setup: ["create table t (d date primary key, pad text not null)",
                           "insert into t select date '2000-01-01' + i, " + PAD + " from " + gs(4000)],
                   dump: ["select d, pad from t order by d", "select count(*) from t"]}
    }
    if name == "ts" {
        return Fam{setup: ["create table t (ts timestamp primary key, pad text not null)",
                           "insert into t select timestamp '2020-01-01 00:00:00' + i * interval '1 hour', " + PAD + " from " + gs(4000)],
                   dump: ["select ts, pad from t order by ts", "select count(*) from t"]}
    }
    if name == "tstz" {
        // 3,000 rows in the past, 1,500 in the future
        return Fam{setup: ["create table t (ts timestamptz primary key, pad text not null)",
                           "insert into t select timestamptz '2020-01-01 00:00:00+00' + i * interval '1 hour', " + PAD + " from " + gs(3000),
                           "insert into t select timestamptz '2999-01-01 00:00:00+00' + i * interval '1 hour', " + PAD + " from " + gs(1500)],
                   dump: ["select ts, pad from t order by ts", "select count(*) from t"]}
    }
    if name == "uuid" {
        return Fam{setup: ["create table t (u uuid primary key, pad text not null)",
                           "insert into t select ('00000000-0000-0000-0000-' || lpad(to_hex(i), 12, '0'))::uuid, " + PAD + " from " + gs(4000)],
                   dump: ["select u, pad from t order by u", "select count(*) from t"]}
    }
    if name == "text" {
        return Fam{setup: ["create table t (k text primary key, pad text not null)",
                           "insert into t select 'k' || lpad(i::text, 6, '0'), " + PAD + " from " + gs(6000)],
                   dump: ["select k, pad from t order by k", "select count(*) from t"]}
    }
    if name == "textedge" {
        return Fam{setup: ["create table t (k text primary key, n int)",
                           "insert into t values ('', 0), ('a', 1), ('a ', 2), ('a b', 3), ('a b c', 4), ('aa', 5), ('ab', 6), ('abc', 7), ('b', 8), ('B', 9), ('a~', 10), ('ab ', 11), ('z', 12)"],
                   dump: ["select k, n from t order by k", "select count(*) from t"]}
    }
    if name == "two" {
        return Fam{setup: ["create table t (a int, b int, v int not null, pad text not null, primary key (a, b))",
                           "insert into t select i / 100, i % 100, i % 5, " + PAD + " from " + gs(6000)],
                   dump: ["select a, b, v, pad from t order by a, b", "select count(*), min(a), max(a) from t"]}
    }
    if name == "twotext" {
        return Fam{setup: ["create table t (g text, n int, pad text not null, primary key (g, n))",
                           "insert into t select 'g' || lpad((i / 100)::text, 3, '0'), i % 100, " + PAD + " from " + gs(6000)],
                   dump: ["select g, n, pad from t order by g, n", "select count(*) from t"]}
    }
    if name == "three" {
        return Fam{setup: ["create table t (a int, b int, c int, pad text not null, primary key (a, b, c))",
                           "insert into t select i / 1000, (i / 100) % 10, i % 100, " + PAD + " from " + gs(6000)],
                   dump: ["select a, b, c, pad from t order by a, b, c", "select count(*) from t"]}
    }
    if name == "idx" {
        // an index that leads with the key's column: its range goes with the table's
        return Fam{setup: ["create table t (id int primary key, v int not null, pad text not null)",
                           "insert into t select i, i % 7, " + PAD + " from " + gs(6000),
                           "create index t_id on t (id)"],
                   dump: ["select id, v, pad from t order by id", "select count(*) from t where id >= 0", "select count(*), sum(id) from t where id > 100 and id < 5000"]}
    }
    if name == "idxa" {
        // indexes that lead with a: a lone (a) is too short for a range on b
        return Fam{setup: ["create table t (a int, b int, v int not null, pad text not null, primary key (a, b))",
                           "insert into t select i / 100, i % 100, i % 5, " + PAD + " from " + gs(6000),
                           "create index t_a on t (a)", "create index t_ab on t (a, b)", "create index t_abv on t (a, b, v)",
                           "create index t_av on t (a, v) where b > 10"],
                   dump: ["select a, b, v, pad from t order by a, b", "select count(*) from t where a >= 0", "select count(*) from t where a >= 0 and b >= 0",
                          "select count(*) from t where a >= 0 and v >= 0", "select count(*), sum(b) from t where a > 20 and v = 2"]}
    }
    if name == "idxab" {
        return Fam{setup: ["create table t (a int, b int, v int not null, pad text not null, primary key (a, b))",
                           "insert into t select i / 100, i % 100, i % 5, " + PAD + " from " + gs(6000),
                           "create index t_ab on t (a, b)", "create index t_abv on t (a, b, v)", "create unique index t_ba on t (a, b, pad)"],
                   dump: ["select a, b, v, pad from t order by a, b", "select count(*) from t where a >= 0 and b >= 0",
                          "select count(*), sum(b) from t where a >= 0 and b >= 0 and v >= 0", "select count(*) from t where a = 5 and b < 90"]}
    }
    if name == "idxv" {
        return Fam{setup: ["create table t (id int primary key, v int not null, pad text not null)",
                           "insert into t select i, i % 7, " + PAD + " from " + gs(6000),
                           "create index t_v on t (v)"],
                   dump: ["select id, v from t order by id", "select count(*) from t where v >= 0", "select count(*), sum(id) from t where v = 3"]}
    }
    if name == "idxx" {
        return Fam{setup: ["create table t (id int primary key, pad text not null)",
                           "insert into t select i, 'N' || i from " + gs(6000),
                           "create index t_l on t (lower(pad))"],
                   dump: ["select id, pad from t order by id", "select count(*) from t where lower(pad) >= ''", "select count(*) from t where lower(pad) = 'n77'"]}
    }
    if name == "fk" || name == "fkcascade" || name == "fkfar" {
        let act = if name == "fkcascade" { " on delete cascade" } else { "" }
        let lo = if name == "fkfar" { 3000 } else { 1 }
        return Fam{setup: ["create table t (id int primary key, pad text not null)",
                           "insert into t select i, " + PAD + " from " + gs(6000),
                           "create table c (id int primary key, pid int references t (id)" + act + ")",
                           "insert into c select i, i + " + (lo - 1).toStr() + " from " + gs(100)],
                   dump: ["select id, pad from t order by id", "select id, pid from c order by id", "select count(*) from t"]}
    }
    if name == "float" {
        return Fam{setup: ["create table t (f double precision primary key, pad text not null)",
                           "insert into t select i * 0.5, " + PAD + " from " + gs(4000)],
                   dump: ["select f, pad from t order by f", "select count(*) from t"]}
    }
    if name == "ci" {
        return Fam{setup: ["create table t (k varchar(20) collate SQL_Latin1_General_CP1_CI_AS primary key, pad text not null)",
                           "insert into t select 'k' || lpad(i::text, 6, '0'), " + PAD + " from " + gs(4000)],
                   dump: ["select k, pad from t order by k", "select count(*) from t"]}
    }
    if name == "temp" {
        return Fam{setup: ["create temp table t (id int primary key, pad text not null)",
                           "insert into t select i, " + PAD + " from " + gs(4000)],
                   dump: ["select id, pad from t order by id", "select count(*) from t"]}
    }
    if name == "big" {
        // every 40th value is 20,000 bytes: the range holds large values
        return Fam{setup: ["create table t (id int primary key, pad text not null)",
                           "insert into t select i, case when i % 40 = 0 then repeat('z', 20000) else " + PAD + " end from " + gs(3000)],
                   dump: ["select id, length(pad), md5(pad) from t order by id", "select count(*), sum(length(pad)) from t"]}
    }
    if name == "keyless" {
        return Fam{setup: ["create table t (a int, b text)", "insert into t select i, " + PAD + " from " + gs(3000)],
                   dump: ["select a, b from t order by a", "select count(*) from t"]}
    }
    return Fam{setup: [], dump: []}
}

fn shapes(): []Shape {
    var out: []Shape = []
    // ---- int key: bounds
    append(mut &out, sh("int <", "int", [q("delete from t where id < 1500")], true))
    append(mut &out, sh("int <=", "int", [q("delete from t where id <= 1500")], true))
    append(mut &out, sh("int >", "int", [q("delete from t where id > 4500")], true))
    append(mut &out, sh("int >=", "int", [q("delete from t where id >= 4500")], true))
    append(mut &out, sh("int between", "int", [q("delete from t where id between 1000 and 2000")], true))
    append(mut &out, sh("int >= and <", "int", [q("delete from t where id >= 1000 and id < 2000")], true))
    append(mut &out, sh("int > and <=", "int", [q("delete from t where id > 1000 and id <= 2000")], true))
    append(mut &out, sh("int no where", "int", [q("delete from t")], true))
    append(mut &out, sh("int flipped", "int", [q("delete from t where 1500 > id")], true))
    append(mut &out, sh("int flipped >=", "int", [q("delete from t where 5000 <= id and 5500 >= id")], true))
    append(mut &out, sh("int empty below", "int", [q("delete from t where id < 1")], true))
    append(mut &out, sh("int empty above", "int", [q("delete from t where id > 6000")], true))
    append(mut &out, sh("int inverted", "int", [q("delete from t where id between 20 and 10")], true))
    append(mut &out, sh("int whole by range", "int", [q("delete from t where id >= 1 and id <= 6000")], true))
    append(mut &out, sh("int constant arithmetic", "int", [q("delete from t where id < 1000 + 500")], true))
    append(mut &out, sh("int text literal", "int", [q("delete from t where id < '1500'")], true))
    append(mut &out, sh("int parameter", "int", [qp("delete from t where id < $1", [Val.Int(1500)])], true))
    append(mut &out, sh("int parameters", "int", [qp("delete from t where id >= $1 and id < $2", [Val.Int(2000), Val.Int(2500)])], true))
    append(mut &out, sh("int subquery", "int", [q("delete from t where id < (select min(id) + 1500 from t)")], true))
    append(mut &out, sh("int subquery value", "int", [q("delete from t where id >= (select 4000)")], true))
    append(mut &out, sh("int NULL bound", "int", [q("delete from t where id < null")], true))
    append(mut &out, sh("int NULL equality (a point)", "int", [q("delete from t where id = null")], false))
    append(mut &out, sh("two NULL equality", "two", [q("delete from t where a = null")], true))
    append(mut &out, sh("int deletes in a row", "int", [q("delete from t where id < 1000"), q("delete from t where id < 2000"), q("delete from t where id > 5000"),
                                                        q("delete from t where id between 2500 and 2600")], true))
    append(mut &out, sh("int insert into the dropped range", "int", [q("delete from t where id < 3000"), q("insert into t select i, 0, 'again' from " + gs(100)),
                                                                     q("delete from t where id < 50"), q("select count(*) from t where id < 3000"),
                                                                     q("delete from t where id < 3000")], true))
    // ---- int key: fall back
    append(mut &out, sh("int residual", "int", [q("delete from t where id < 1500 and v = 3")], false))
    append(mut &out, sh("int OR", "int", [q("delete from t where id < 100 or id > 5900")], false))
    append(mut &out, sh("int IN", "int", [q("delete from t where id in (1, 2, 3, 4000)")], false))
    append(mut &out, sh("int ANY", "int", [q("delete from t where id = any (array[5, 6, 7])")], false))
    append(mut &out, sh("int non-exact bound", "int", [q("delete from t where id < 1500.5")], false))
    append(mut &out, sh("int non-exact float parameter", "int", [qp("delete from t where id < $1", [Val.Float(1500.5f)])], false))
    append(mut &out, sh("int bound past the type", "int", [q("delete from t where id < 3000000000")], false))
    append(mut &out, sh("int bound below the type", "int", [q("delete from t where id > -3000000000")], false))
    append(mut &out, sh("int point", "int", [q("delete from t where id = 77")], false))
    append(mut &out, sh("int not equal", "int", [q("delete from t where id <> 77")], false))
    append(mut &out, sh("int RETURNING", "int", [q("delete from t where id < 300 returning id, v")], false))
    append(mut &out, sh("int USING", "int", [q("delete from t using u where t.id = u.id and t.id < 100")], false))
    append(mut &out, sh("int column against column", "int", [q("delete from t where id < v * 100")], false))
    append(mut &out, sh("int two lower bounds", "int", [q("delete from t where id > 5 and id > 10 and id < 500")], false))
    append(mut &out, sh("int two upper bounds", "int", [q("delete from t where id < 500 and id < 400")], false))
    append(mut &out, sh("int volatile bound", "int", [q("delete from t where id < 100 + (random() * 0)::int")], false))
    append(mut &out, sh("int correlated subquery", "int", [q("delete from t where id < 200 and exists (select 1 from u where u.id = t.id)")], false))
    append(mut &out, sh("int IS NOT NULL", "int", [q("delete from t where id is not null and id < 100")], false))
    append(mut &out, sh("int expression of the key", "int", [q("delete from t where id + 0 < 1500")], false))
    // ---- inside a transaction block (stage 5): the transaction's own reads see the range gone
    var blk = sh("int in a block", "int", [q("begin"), q("delete from t where id < 1500"), q("select count(*) from t"), q("commit")], true)
    blk.block = true
    append(mut &out, blk)
    var blk2 = sh("int in a block, rolled back", "int", [q("begin"), q("delete from t where id < 1500"), q("select count(*) from t"), q("rollback"), q("select count(*) from t")], true)
    blk2.block = true
    append(mut &out, blk2)
    append(mut &out, blockShape("block: delete, read, count, insert, update, delete again", "int", [
        "begin", "delete from t where id < 1500", "select count(*), min(id), max(id) from t", "select count(*) from t where id < 2000",
        "select id from t where id = 700", "select id, v from t where id between 695 and 705 order by id",
        "select id from t where id < 1600 order by id desc limit 3", "select id from t where id in (5, 700, 1499, 1500, 1501) order by id",
        "select id from t where id < 1500 order by id desc limit 3", "select count(*) from u join t on t.id = u.id",
        "select count(*) from t where id in (select id from u)", "select count(*), min(t.id) from t join u on u.id = t.id + 1000",
        "insert into t values (700, 1, 'n')", "select id from t where id < 1500 order by id desc limit 3", "select count(*) from u join t on t.id = u.id", "select id, v, pad from t where id between 695 and 705 order by id",
        "select id from t where id < 1600 order by id desc limit 3",
        "update t set v = 9 where id = 800", "update t set v = 9 where id = 700", "delete from t where id = 800",
        "update t set id = 701 where id = 5000", "select id from t where id between 695 and 705 order by id",
        "delete from t where id < 1500", "select count(*) from t", "delete from t where id < 1500", "delete from t where id < 1700 and v = 3",
        "select count(*) from t", "commit"]))
    append(mut &out, blockShape("block: own writes before the delete", "int", [
        "begin", "delete from t where id = 100", "update t set v = 99 where id = 101", "insert into t values (0, 1, 'a'), (-5, 1, 'a')",
        "update t set pad = 'zz' where id between 110 and 120", "insert into t select i, 1, 'n' from generate_series(6001, 6050) i",
        "delete from t where id < 300", "select count(*), min(id), max(id) from t", "delete from t where id > 5990",
        "select count(*), min(id), max(id) from t", "delete from t where id between 4000 and 4010", "insert into t values (4005, 1, 'b')",
        "delete from t where id between 4000 and 4010", "select count(*) from t where id between 3990 and 4020", "commit"]))
    append(mut &out, blockShape("block: earlier range deletes overlap", "int", [
        "begin", "delete from t where id < 200", "delete from t where id < 300", "delete from t where id between 150 and 250",
        "insert into t values (150, 1, 'a'), (260, 1, 'a'), (280, 1, 'a')", "delete from t where id between 100 and 270",
        "select count(*), min(id) from t", "delete from t where id between 100 and 400",
        "delete from t where id between 1000 and 1100", "delete from t where id between 1101 and 1200", "delete from t where id between 1050 and 1150",
        "delete from t where id between 900 and 1300", "select count(*) from t where id between 800 and 1400",
        "delete from t where id >= 5000", "delete from t where id >= 4000", "insert into t values (5500, 1, 'a')", "delete from t",
        "select count(*) from t", "insert into t values (1, 1, 'a')", "select id from t", "commit"]))
    append(mut &out, blockShape("block: savepoints", "int", [
        "begin", "savepoint a", "delete from t where id < 1500", "select count(*) from t", "rollback to a", "select count(*) from t",
        "delete from t where id < 800", "savepoint b", "delete from t where id < 1500", "select count(*) from t where id < 1000", "insert into t values (900, 1, 'a')",
        "rollback to b", "select count(*) from t where id < 1000", "select id from t where id between 795 and 805 order by id",
        "savepoint c", "delete from t where id between 2000 and 2100", "insert into t values (2050, 1, 'a')", "delete from t where id between 2040 and 2060",
        "rollback to c", "select count(*) from t where id between 1990 and 2110", "delete from t where id between 2000 and 2100",
        "release c", "select count(*) from t where id between 1990 and 2110", "commit"]))
    append(mut &out, blockShape("block: rolled back after own writes", "int", [
        "begin", "insert into t values (0, 1, 'a')", "delete from t where id < 100", "select count(*) from t where id < 200", "rollback",
        "select count(*) from t where id < 200"]))
    append(mut &out, blockShape("block: a failed statement undone", "int", [
        "begin", "delete from t where id < 100", "insert into t values (50, 1, 'a'), (50, 2, 'b')", "rollback", "select count(*) from t"]))
    append(mut &out, blockShape("block: two keys", "two", [
        "begin", "delete from t where a = 3", "select count(*) from t where a between 2 and 4", "insert into t values (3, 5, 1, 'x')",
        "select a, b from t where a = 3", "delete from t where a = 3 and b < 50", "delete from t where a = 3", "delete from t where a < 10 and b < 50",
        "delete from t where a < 10", "select count(*), min(a) from t", "commit"]))
    append(mut &out, blockShape("block: large values", "big", [
        "begin", "delete from t where id between 100 and 2000", "select count(*) from t where id between 90 and 2010",
        "insert into t select i, repeat('q', 30000) from generate_series(150, 1990, 10) i", "select count(*), sum(length(pad)) from t where id between 90 and 2010",
        "delete from t where id between 500 and 1500", "select count(*), sum(length(pad)) from t where id between 90 and 2010",
        "delete from t where id between 1400 and 1600", "select md5(pad) from t where id = 160", "commit"]))
    // (two range deletes of one commit over large values, the first from the start: the second's skip over the
    // companion's key lengths passed nodes the plan had not loaded, and the commit panicked)
    append(mut &out, blockShape("block: two range deletes, large values", "big", [
        "begin", "delete from t where id < 600", "delete from t where id >= 2400", "select count(*) from t", "delete from t where id between 1000 and 1200", "commit",
        "select count(*), sum(length(pad)) from t"]))
    append(mut &out, blockShape("block: a table made in it", "int", [
        "begin", "create table nt (id int primary key, pad text not null)", "insert into nt select i, 'p' from generate_series(1, 300) i",
        "delete from nt where id < 100", "select count(*), min(id) from nt", "insert into nt values (50, 'z')", "delete from nt where id < 200",
        "select count(*) from nt", "commit", "select count(*), min(id) from nt"]))
    // (t_av, a partial index on (a, v), serves the first query alone: EXPLAIN says "index t_av ... index only")
    append(mut &out, blockShape("block: indexes read after the delete", "idxa", [
        "begin", "explain select count(*) from t where a >= 0 and b > 10 and v >= 0",
        "delete from t where a = 5", "select count(*), sum(v) from t where a >= 0 and b > 10 and v >= 0", "select count(*) from t where a = 5 and b > 10 and v >= 0",
        "select count(*) from t where a >= 0 and b >= 0", "select count(*) from t where a >= 0 and v >= 0",
        "insert into t values (5, 17, 1, 'x'), (5, 3, 1, 'x')", "select count(*), sum(v) from t where a >= 0 and b > 10 and v >= 0",
        "select count(*) from t where a = 5 and b > 10 and v >= 0", "delete from t where a < 8", "select count(*) from t where a >= 0 and b > 10 and v >= 0",
        "select count(*) from t where a >= 0 and v >= 0", "commit", "select count(*), sum(v) from t where a >= 0 and b > 10 and v >= 0"]))
    append(mut &out, blockShape("block: an index of the key, read by it", "idx", [
        "begin", "delete from t where id < 1500", "select count(*) from t where id >= 0", "select count(*), sum(id) from t where id > 100 and id < 5000",
        "insert into t values (700, 1, 'n')", "select count(*), sum(id) from t where id > 100 and id < 5000", "delete from t where id < 800",
        "select count(*) from t where id >= 0", "rollback", "select count(*) from t where id >= 0"]))
    append(mut &out, blockShape("block: after other writes", "int", [
        "begin", "update t set v = 1 where id = 5", "insert into t values (7000, 1, 'a')", "delete from t where id < 1500",
        "select count(*) from t", "delete from t where id < 7500", "select count(*) from t", "commit"]))
    // ---- bigint: the type's end (the key of the greatest is all ones)
    append(mut &out, sh("bigint top", "bigint", [q("delete from t where id > 9223372036854775807 - 100")], true))
    append(mut &out, sh("bigint <= max", "bigint", [q("delete from t where id <= 9223372036854775807")], true))
    append(mut &out, sh("bigint > max", "bigint", [q("delete from t where id > 9223372036854775807")], true))
    append(mut &out, sh("bigint >= max", "bigint", [q("delete from t where id >= 9223372036854775807")], true))
    append(mut &out, sh("bigint between", "bigint", [q("delete from t where id between 9223372036854772000 and 9223372036854774000")], true))
    // ---- numeric
    append(mut &out, sh("numeric <", "numeric", [q("delete from t where id < -500.5")], true))
    append(mut &out, sh("numeric range", "numeric", [q("delete from t where id >= 10 and id <= 20.5")], true))
    append(mut &out, sh("numeric integers", "numeric", [q("delete from t where id between 1 and 50")], true))
    append(mut &out, sh("numeric scale lost", "numeric", [q("delete from t where id < 10.123")], false))
    // ---- date, timestamp, timestamptz
    append(mut &out, sh("date <", "date", [q("delete from t where d < '2005-01-01'")], true))
    append(mut &out, sh("date range", "date", [q("delete from t where d >= date '2003-03-01' and d < date '2003-04-01'")], true))
    append(mut &out, sh("date given a timestamp", "date", [q("delete from t where d < timestamp '2005-01-01 10:00:00'")], false))
    append(mut &out, sh("timestamp range", "ts", [q("delete from t where ts >= '2020-02-01' and ts < '2020-03-01 12:00:00'")], true))
    append(mut &out, sh("timestamptz now()", "tstz", [q("delete from t where ts < now()")], true))
    append(mut &out, sh("timestamptz future", "tstz", [q("delete from t where ts >= now() - interval '1 day'")], true))
    append(mut &out, sh("timestamptz current_timestamp", "tstz", [q("delete from t where ts < current_timestamp")], true))
    append(mut &out, sh("timestamptz text range", "tstz", [q("delete from t where ts >= '2020-02-01 00:00:00+00' and ts < '2020-03-01 00:00:00+00'")], true))
    var tz = sh("timestamptz in another zone", "tstz", [q("delete from t where ts < '2020-02-01 00:00:00'")], true)
    tz.pre = ["set timezone = 'Asia/Tokyo'"]
    append(mut &out, tz)
    // ---- uuid and text
    append(mut &out, sh("uuid <", "uuid", [q("delete from t where u < '00000000-0000-0000-0000-0000000007D0'")], true))
    append(mut &out, sh("uuid >=", "uuid", [q("delete from t where u >= '00000000-0000-0000-0000-000000000BB8'")], true))
    append(mut &out, sh("text <", "text", [q("delete from t where k < 'k002000'")], true))
    append(mut &out, sh("text >=", "text", [q("delete from t where k >= 'k004000'")], true))
    append(mut &out, sh("text between", "text", [q("delete from t where k between 'k000100' and 'k000200'")], true))
    append(mut &out, sh("text >", "text", [q("delete from t where k > 'k005990'")], true))
    append(mut &out, sh("text LIKE", "text", [q("delete from t where k like 'k0001%'")], false))
    append(mut &out, sh("text edge >", "textedge", [q("delete from t where k > 'a'")], true))
    append(mut &out, sh("text edge <=", "textedge", [q("delete from t where k <= 'a'")], true))
    append(mut &out, sh("text edge range", "textedge", [q("delete from t where k >= 'ab' and k < 'b'")], true))
    append(mut &out, sh("text edge empty string", "textedge", [q("delete from t where k >= ''")], true))
    append(mut &out, sh("text edge >= 'a '", "textedge", [q("delete from t where k >= 'a ' and k <= 'a b c'")], true))
    // ---- two-column and three-column keys
    append(mut &out, sh("two a =", "two", [q("delete from t where a = 5")], true))
    append(mut &out, sh("two a = and b <", "two", [q("delete from t where a = 5 and b < 50")], true))
    append(mut &out, sh("two a = and b range", "two", [q("delete from t where a = 5 and b >= 20 and b < 80")], true))
    append(mut &out, sh("two a >", "two", [q("delete from t where a > 30")], true))
    append(mut &out, sh("two a range", "two", [q("delete from t where a >= 10 and a < 20")], true))
    append(mut &out, sh("two a <", "two", [q("delete from t where a < 20")], true))
    append(mut &out, sh("two a = and b >", "two", [q("delete from t where a = 59 and b > 90")], true))
    append(mut &out, sh("two a = parameter", "two", [qp("delete from t where a = $1", [Val.Int(7)])], true))
    append(mut &out, sh("two b < (not the first)", "two", [q("delete from t where b < 50")], false))
    append(mut &out, sh("two whole key", "two", [q("delete from t where a = 5 and b = 7")], false))
    append(mut &out, sh("two equality and range on a", "two", [q("delete from t where a = 5 and a < 20")], false))
    append(mut &out, sh("two b = and a <", "two", [q("delete from t where b = 5 and a < 10")], false))
    append(mut &out, sh("two residual", "two", [q("delete from t where a = 5 and b < 50 and v = 1")], false))
    append(mut &out, sh("text-first a =", "twotext", [q("delete from t where g = 'g005'")], true))
    append(mut &out, sh("text-first range", "twotext", [q("delete from t where g >= 'g010' and g < 'g020'")], true))
    append(mut &out, sh("text-first g = and n >=", "twotext", [q("delete from t where g = 'g030' and n >= 40")], true))
    append(mut &out, sh("three a = b = c <", "three", [q("delete from t where a = 1 and b = 2 and c < 50")], true))
    append(mut &out, sh("three a = b >=", "three", [q("delete from t where a = 1 and b >= 3")], true))
    append(mut &out, sh("three a <", "three", [q("delete from t where a < 3")], true))
    append(mut &out, sh("three a = c <", "three", [q("delete from t where a = 1 and c < 50")], false))
    // ---- indexes
    append(mut &out, sh("index leading with the key", "idx", [q("delete from t where id < 1500")], true))
    append(mut &out, sh("index leading with the key, whole", "idx", [q("delete from t")], true))
    append(mut &out, sh("indexes on a, a = ", "idxa", [q("delete from t where a = 5")], true))
    append(mut &out, sh("indexes on a, a range", "idxa", [q("delete from t where a >= 10 and a < 20")], true))
    append(mut &out, sh("indexes on a, too short for b (entry by entry)", "idxa", [q("delete from t where a = 5 and b < 50")], true))
    append(mut &out, sh("indexes on a and b, a = b <", "idxab", [q("delete from t where a = 5 and b < 50")], true))
    append(mut &out, sh("indexes on a and b, a = b range", "idxab", [q("delete from t where a = 20 and b >= 10 and b < 90")], true))
    append(mut &out, sh("indexes on a and b, a >", "idxab", [q("delete from t where a > 40")], true))
    append(mut &out, sh("index of another column (entry by entry)", "idxv", [q("delete from t where id < 1500")], true))
    append(mut &out, sh("index of another column, whole", "idxv", [q("delete from t")], true))
    append(mut &out, sh("expression index, whole", "idxx", [q("delete from t")], true))
    append(mut &out, sh("expression index, range (entry by entry)", "idxx", [q("delete from t where id < 1500")], true))
    // ---- foreign keys, key types, large values, temporary and keyless tables
    append(mut &out, sh("referenced, rows in the range", "fk", [q("delete from t where id < 1500"), q("select count(*) from t")], false))
    append(mut &out, sh("referenced, rows elsewhere", "fkfar", [q("delete from t where id < 1500")], false))
    append(mut &out, sh("referenced, cascade", "fkcascade", [q("delete from t where id < 50")], false))
    append(mut &out, sh("float key", "float", [q("delete from t where f < 1000.5")], false))
    append(mut &out, sh("float key, whole", "float", [q("delete from t")], true))
    append(mut &out, sh("case-insensitive key", "ci", [q("delete from t where k < 'k002000'")], false))
    append(mut &out, sh("case-insensitive key, whole", "ci", [q("delete from t")], true))
    append(mut &out, sh("temporary table", "temp", [q("delete from t where id < 1500")], true))
    append(mut &out, sh("large values in the range", "big", [q("delete from t where id between 100 and 2000")], true))
    append(mut &out, sh("large values, then new ones", "big", [q("delete from t where id between 100 and 2000"),
                                                               q("insert into t select i, repeat('q', 30000) from generate_series(150, 1990) i"),
                                                               q("delete from t where id >= 1000 and id < 1500")], true))
    append(mut &out, sh("large values, whole", "big", [q("delete from t")], true))
    append(mut &out, sh("keyless, whole", "keyless", [q("delete from t")], true))
    append(mut &out, sh("keyless, a range", "keyless", [q("delete from t where a < 1000")], false))
    return out
}

fn show(r: &lexdb_exec.Res): str {
    if !r.hasRows { return r.tag.clone() }
    var rows: []str = []
    for row in r.rows {
        var cells: []str = []
        for v in row { append(mut &cells, lexdb_sql.text(&v)) }
        append(mut &rows, strings.join(&cells, "|"))
    }
    return r.tag + ": " + strings.join(&rows, ";")
}

fn runOne(s: mut &lexdb_exec.Session, sql: &str, ps: &[]Val): str {
    let nt: []int = []
    match lexdb_parse.parse(sql) {
        Ok(stmts) {
            match s.run(&stmts[0], ps, &nt) {
                Ok(r) { return show(&r) }
                Err(e) { return "error " + e.state }
            }
        }
        Err(e) { return "parse error " + e.state }
    }
}

fn one(s: mut &lexdb_exec.Session, sql: str): str {
    let none: []Val = []
    return runOne(s, &sql, &none)
}

fn opts(): lexdb_store.Options {
    return lexdb_store.Options{cacheBytes: 256 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 100000}
}

fn runShape(n: int, sh: &Shape, on: bool): Out {
    var out = Out{tags: "", dump: "", audit: "", ex: "", taken: 0}
    let fam = famOf(sh.fam.clone())
    let fs = lexdb_disk.sim(300 + n)
    let none: []Val = []
    // the tables are built and the store closed, then opened again: nothing is in memory when the statements run
    // (a temporary table does not outlive its session: one run)
    let reopen = sh.fam != "temp"
    if reopen {
        lexdb_store.run(fs.share(), opts(), fn(st: lexdb_store.Store): int {
            lexdb_exec.bootstrap(&st).unwrap()
            var s = lexdb_exec.newSession(st.share())
            for sql in fam.setup {
                let r = runOne(mut &s, &sql, &none)
                if strings.contains(&r, "error") { out.tags = out.tags + "setup " + sql + ": " + r + "\n" }
            }
            s.close()
            return 0
        }).unwrap()
    }
    lexdb_store.run(fs.share(), opts(), fn(st: lexdb_store.Store): int {
        if !reopen { lexdb_exec.bootstrap(&st).unwrap() }
        var s = lexdb_exec.newSession(st.share())
        if !reopen {
            for sql in fam.setup {
                let r = runOne(mut &s, &sql, &none)
                if strings.contains(&r, "error") { out.tags = out.tags + "setup " + sql + ": " + r + "\n" }
            }
            st.checkpoint().unwrap()
        }
        for sql in sh.pre { let r = runOne(mut &s, &sql, &none) }
        let sw = runOne(mut &s, &("set lexdb_range_delete = " + (if on { "on" } else { "off" })), &none)
        // what EXPLAIN says of the first DELETE
        for x in sh.stmts {
            if !sh.noex && strings.startsWith(&x.sql, "delete") {
                if sh.block { let b = runOne(mut &s, &"begin", &none) }
                out.ex = runOne(mut &s, &("explain " + x.sql), &x.ps)
                if sh.block { let b = runOne(mut &s, &"rollback", &none) }
                break
            }
        }
        let before = lexdb_exec.rangeDeletes()
        for x in sh.stmts { out.tags = out.tags + runOne(mut &s, &x.sql, &x.ps) + "\n" }
        out.taken = lexdb_exec.rangeDeletes() - before
        for d in fam.dump { out.dump = out.dump + runOne(mut &s, &d, &none) + "\n" }
        s.close()
        return 0
    }).unwrap()
    out.audit = match lexdb_store.testHooks().audit(fs) { Ok(a) { a } Err(e) { "audit: " + e.msg } }
    return out
}

fn clean(a: &str): bool { return strings.contains(a, "lost 0, twice 0") }

fn firstDiff(a: &str, b: &str): str {
    var i = 0
    while i < len(a) && i < len(b) && a[i] == b[i] { i += 1 }
    var j = i
    while j > 0 && a[j - 1] != '\n' { j -= 1 }
    var e1 = i
    while e1 < len(a) && a[e1] != '\n' { e1 += 1 }
    var e2 = i
    while e2 < len(b) && b[e2] != '\n' { e2 += 1 }
    // (a long line cut where it differs)
    let c1 = if e1 > i + 80 { i + 80 } else { e1 }
    let c2 = if e2 > i + 80 { i + 80 } else { e2 }
    let from = if i > j + 40 { i - 40 } else { j }
    return "on: " + a[from..c1] + " / off: " + b[from..c2]
}

fn switchTest() {
    let fs = lexdb_disk.sim(900)
    var res: []str = []
    lexdb_store.run(fs.share(), opts(), fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st.share())
        let none: []Val = []
        let a = runOne(mut &s, &"show lexdb_range_delete", &none)
        let b0 = runOne(mut &s, &"set lexdb_range_delete = off", &none)
        let b = runOne(mut &s, &"show lexdb_range_delete", &none)
        let c0 = runOne(mut &s, &"reset lexdb_range_delete", &none)
        let c = runOne(mut &s, &"show lexdb_range_delete", &none)
        let d0 = runOne(mut &s, &"begin", &none)
        let d1 = runOne(mut &s, &"set lexdb_range_delete = off", &none)
        let d2 = runOne(mut &s, &"rollback", &none)
        let d = runOne(mut &s, &"show lexdb_range_delete", &none)
        let e = runOne(mut &s, &"set lexdb_range_delete = 'maybe'", &none)
        append(mut &res, "switch: " + strings.replaceAll(&a, "SHOW: ", "") + ", " + strings.replaceAll(&b, "SHOW: ", "") + ", " + strings.replaceAll(&c, "SHOW: ", "") +
               " after RESET, " + strings.replaceAll(&d, "SHOW: ", "") + " after the block's ROLLBACK, " + strings.replaceAll(&e, "error ", "") + " for junk")
        s.close()
        return 0
    }).unwrap()
    for l in res { println(l) }
}

// Another session's row locked in the range: the row path, which waits for
// the lock, is the one to take.
fn lockTest() {
    let fs = lexdb_disk.sim(901)
    var res: []str = []
    lexdb_store.run(fs.share(), opts(), fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var a = lexdb_exec.newSession(st.share())
        var b = lexdb_exec.newSession(st.share())
        let none: []Val = []
        for sql in famOf("int").setup { let r = runOne(mut &a, &sql, &none) }
        let b0 = runOne(mut &a, &"begin", &none)
        let b1 = runOne(mut &a, &"select id from t where id between 100 and 110 for update", &none)
        let locked = runOne(mut &b, &"explain delete from t where id < 1500", &none)
        let other = runOne(mut &b, &"explain delete from t where id > 1500", &none)
        let c = runOne(mut &a, &"commit", &none)
        let free = runOne(mut &b, &"explain delete from t where id < 1500", &none)
        append(mut &res, "locked: explain without the line " + (!strings.contains(&locked, "range delete:") && strings.contains(&other, "range delete:")).toStr() +
               ", with it after COMMIT " + strings.contains(&free, "range delete:").toStr())
        a.close()
        b.close()
        return 0
    }).unwrap()
    for l in res { println(l) }
}

var HOOKED: int = 0

// During the count, once: another session commits a row into the range.
fn hook(st: lexdb_store.Store, mode: int, arg: str, k: int) {
    if HOOKED > 0 { return }
    HOOKED = 1
    var s2 = lexdb_exec.newSession(st.share())
    let none: []Val = []
    let r = runOne(mut &s2, &arg, &none)
    s2.close()
}

// A row inserted into the range after the count began fails the commit
// (40001); the statement runs again, counts it and deletes it too.
fn concurrentTest() {
    let fs = lexdb_disk.sim(902)
    var res: []str = []
    lexdb_store.run(fs.share(), opts(), fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var a = lexdb_exec.newSession(st.share())
        let none: []Val = []
        let c1 = runOne(mut &a, &"create table t (id int primary key, pad text not null)", &none)
        let c2 = runOne(mut &a, &("insert into t select i * 2, " + PAD + " from " + gs(4000)), &none)
        a.close()
        return 0
    }).unwrap()
    lexdb_store.run(fs.share(), opts(), fn(st: lexdb_store.Store): int {
        var a = lexdb_exec.newSession(st.share())
        let none: []Val = []
        lexdb_store.testHooks().setCountHook(st, hook, 0, "insert into t values (2001, 'new')")
        let tag = runOne(mut &a, &"delete from t where id >= 1000 and id < 4600", &none)
        let calls = lexdb_store.testHooks().countHookCalls(st)
        lexdb_store.testHooks().clearCountHook(st)
        let left = runOne(mut &a, &"select count(*) from t", &none)
        let gone = runOne(mut &a, &"select count(*) from t where id = 2001", &none)
        res = [tag, calls.toStr(), left, gone]
        a.close()
        return 0
    }).unwrap()
    let au = match lexdb_store.testHooks().audit(fs) { Ok(x) { x } Err(e) { e.msg.clone() } }
    println("concurrent insert: " + res[0] + ", the count ran again " + (strings.parseIntOpt(&res[1]).unwrapOr(0) >= 2).toStr() + ", left " + res[2][strings.indexOf(&res[2], ": ", 0) + 2..len(res[2])] + ", the inserted row gone " +
            strings.endsWith(&res[3], "0").toStr() + ", audit clean " + clean(&au).toStr())
}

// Two sessions, a range delete in a block (stage 5): serializable as the row
// path is. A commit into the range, or a write of one of its rows, that
// commits first fails the block's commit (40001); a range delete that
// commits first fails the block that read or wrote in its range. A row
// locked by another session sends the statement to the row path (it waits);
// a lock taken after the range delete does not wait for it.
fn blockTest() {
    let fs = lexdb_disk.sim(903)
    var res: []str = []
    lexdb_store.run(fs.share(), opts(), fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var a = lexdb_exec.newSession(st.share())
        var b = lexdb_exec.newSession(st.share())
        let none: []Val = []
        for sql in famOf("int").setup { let r = runOne(mut &a, &sql, &none) }
        let g = runOne(mut &a, &"delete from t where id = 1100 or id between 2000 and 2010", &none)
        let rd0 = lexdb_exec.rangeDeletes()
        let cnt = "select count(*) from t where id between 1000 and 1300"
        // 1. a row committed into the range first
        let a1 = one(mut &a, "begin")
        let a2 = one(mut &a, "delete from t where id between 1000 and 1300")
        let a3 = one(mut &a, cnt.clone())
        let a4 = one(mut &b, "insert into t values (1100, 1, 'b')")
        let a5 = one(mut &a, "commit")
        append(mut &res, "insert first: " + a2 + ", in block " + a3 + ", " + a4 + ", commit " + a5 + ", then " + one(mut &b, cnt.clone()))
        // ... run again: it counts the row
        let a6 = one(mut &a, "begin")
        let a7 = one(mut &a, "delete from t where id between 1000 and 1300")
        let a8 = one(mut &a, "commit")
        append(mut &res, "again: " + a7 + ", " + a8 + ", left " + one(mut &b, cnt))
        // 2. a row outside it
        let b1 = one(mut &a, "begin")
        let b2 = one(mut &a, "delete from t where id between 1500 and 1600")
        let b3 = one(mut &b, "insert into t values (99999, 1, 'b')")
        let b4 = one(mut &b, "update t set v = 2 where id = 1499")
        let b5 = one(mut &a, "commit")
        append(mut &res, "outside: " + b2 + ", " + b3 + ", " + b4 + ", commit " + b5 + ", left " + one(mut &b, "select count(*) from t where id between 1490 and 1610"))
        // 3. the other way: a block read the range, a range delete commits first (write skew)
        let c1 = one(mut &b, "begin")
        let c2 = one(mut &b, "select count(*) from t where id between 3000 and 3100")
        let c3a = one(mut &a, "begin")
        let c3r = one(mut &a, "select count(*) from t where id = 88888")
        let c3 = one(mut &a, "delete from t where id between 3050 and 3060")
        let c3c = one(mut &a, "commit")
        let c4 = one(mut &b, "insert into t values (88888, 1, 'b')")
        let c5 = one(mut &b, "commit")
        append(mut &res, "delete first: " + c3 + ", the block's commit " + c5)
        // 4. both in blocks, each writing a row of the other's range: the first to commit wins
        let d1 = one(mut &a, "begin")
        let d2 = one(mut &a, "delete from t where id between 4000 and 4100")
        let d3 = one(mut &b, "begin")
        let d4 = one(mut &b, "update t set v = 3 where id = 4050")
        let d5 = one(mut &b, "commit")
        let d6 = one(mut &a, "commit")
        append(mut &res, "update first: " + d2 + ", " + d4 + ", " + d5 + ", delete's commit " + d6)
        let e1 = one(mut &a, "begin")
        let e2 = one(mut &a, "delete from t where id between 4200 and 4300")
        let e3 = one(mut &b, "begin")
        let e4 = one(mut &b, "update t set v = 3 where id = 4250")
        let e5 = one(mut &a, "commit")
        let e6 = one(mut &b, "commit")
        append(mut &res, "delete first, update second: " + e2 + ", " + e4 + ", " + e5 + ", update's commit " + e6)
        // 5. a row locked by another session first: the row path (it waits)
        let f1 = one(mut &b, "begin")
        let f2 = one(mut &b, "select id from t where id between 5000 and 5003 for update")
        let f3 = one(mut &a, "begin")
        let f4 = one(mut &a, "explain delete from t where id between 4990 and 5010")
        let f5 = one(mut &a, "explain delete from t where id between 5100 and 5110")
        let f6 = one(mut &a, "rollback")
        let f7 = one(mut &b, "commit")
        append(mut &res, "locked first: explain over the locked rows " + (!strings.contains(&f4, "range delete:")).toStr() + ", elsewhere " +
               strings.contains(&f5, "range delete:").toStr())
        // 6. a lock taken after the range delete does not wait: the commit that comes second fails
        let h1 = one(mut &a, "begin")
        let h2 = one(mut &a, "delete from t where id between 5200 and 5300")
        let h3 = one(mut &b, "begin")
        let h4 = one(mut &b, "select id from t where id = 5250 for update")
        let h5 = one(mut &b, "update t set v = 4 where id = 5250")
        let h6 = one(mut &a, "commit")
        let h7 = one(mut &b, "commit")
        append(mut &res, "lock after: " + h2 + ", the locker " + h4 + " and " + h5 + " at once, delete's commit " + h6 + ", locker's commit " + h7)
        // ... and a delete that commits second
        let k1 = one(mut &a, "begin")
        let k2 = one(mut &a, "delete from t where id between 5400 and 5500")
        let k3 = one(mut &b, "begin")
        let k4 = one(mut &b, "select id from t where id = 5450 for update")
        let k5 = one(mut &b, "update t set v = 4 where id = 5450")
        let k6 = one(mut &b, "commit")
        let k7 = one(mut &a, "commit")
        append(mut &res, "lock after, locker first: " + k2 + ", locker's commit " + k6 + ", delete's commit " + k7 + ", row left " + one(mut &b, "select count(*) from t where id = 5450"))
        append(mut &res, "range deletes taken " + (lexdb_exec.rangeDeletes() - rd0).toStr())
        let z = one(mut &a, "select count(*), sum(id) from t")
        append(mut &res, "table " + z)
        a.close()
        b.close()
        return 0
    }).unwrap()
    let au = match lexdb_store.testHooks().audit(fs) { Ok(x) { x } Err(e) { e.msg.clone() } }
    for l in res { println("blocks, " + l) }
    println("blocks: audit clean " + clean(&au).toStr())
}

fn main() {
    let list = shapes()
    var tagsEq = 0
    var rowsEq = 0
    var clean2 = 0
    var asWanted = 0
    var took = 0
    var fell = 0
    for n in 0..len(list) {
        let a = runShape(n, &list[n], true)
        let b = runShape(n, &list[n], false)
        if a.tags == b.tags { tagsEq += 1 } else { println(list[n].name + ": tags differ " + firstDiff(&a.tags, &b.tags)) }
        if a.dump == b.dump { rowsEq += 1 } else { println(list[n].name + ": rows differ " + firstDiff(&a.dump, &b.dump)) }
        if clean(&a.audit) { clean2 += 1 } else { println(list[n].name + ": audit on: " + a.audit) }
        if clean(&b.audit) { clean2 += 1 } else { println(list[n].name + ": audit off: " + b.audit) }
        if list[n].name == "block: indexes read after the delete" && !strings.contains(&a.tags, "index t_av") { println(list[n].name + ": the partial index was not the one read") }
        let line = strings.contains(&a.ex, "range delete:")
        let ok = (line == list[n].take || list[n].noex) && (a.taken > 0) == list[n].take && !strings.contains(&b.ex, "range delete:") && b.taken == 0
        if ok { asWanted += 1 } else {
            println(list[n].name + ": expected " + (if list[n].take { "the range path" } else { "a fallback" }) + ", explain line " + line.toStr() + ", taken on " +
                    a.taken.toStr() + ", off " + b.taken.toStr() + "; explain: " + a.ex)
        }
        if list[n].take { took += 1 } else { fell += 1 }
    }
    println("shapes " + len(list).toStr() + ": tags equal " + tagsEq.toStr() + ", rows equal " + rowsEq.toStr() + ", audits clean " + clean2.toStr())
    println("path as expected " + asWanted.toStr() + ": " + took.toStr() + " took it, " + fell.toStr() + " fell back")
    switchTest()
    lockTest()
    concurrentTest()
    blockTest()
}
