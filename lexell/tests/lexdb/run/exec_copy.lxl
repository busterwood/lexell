// lexdb_exec: COPY (design/lexdb.md 9.45) through the session: run gives
// COPY_IN for FROM STDIN, then copyIn takes the client's data as one
// statement. Text format (escapes, \N, delimiters, the end marker, a
// header), CSV (quotes, newlines in fields, NULL, FORCE options), COPY TO
// (escaped, quoted, a query's rows); defaults, serial and identity columns;
// errors with their line and column (PostgreSQL's CONTEXT); constraints,
// foreign keys and indexes as INSERT's; in a transaction block, rolled
// back, read only; the client's CopyFail; many rows; after a reopen.
// expect: text in: COPY 4; 1|a b|7 2|NULL|7 3|x\y|7 4|tab	in|7
// expect: escapes: AB|1|é
// expect: header and end marker: COPY 2, rows 6
// expect: csv in: COPY 4; 10|a,b 11|NULL 12|"" 13|two/lines "q"
// expect: force: 1|NULL 1|""
// expect: csv crlf: COPY 2; 20|"" 21|NULL
// expect: special out: 1|a,b|2|q"r|3|p\|q / 1,"a,b"|2,"q""r"|3,p|q / tag COPY 3
// expect: text out: 1\ta b\t7|2\t\N\t7|3\tx\\y\t7|4\ttab\tin\t7
// expect: csv out: id,v,n|1,a b,7|2,,7|3,x\y,7|4,tab	in,7
// expect: query out: "1";"A B"|"3";"X\Y", tag COPY 2
// expect: identity: COPY 1 COPY 1; 100|a 1|b
// expect: errors: 22P02 invalid input syntax for type integer: "x" | COPY t, line 2, column n: "x"
// expect: 22P04 missing data for column "n" | COPY t, line 1: "9	z"
// expect: 22P04 extra data after last expected column | COPY t, line 1: "9	z	1	2"
// expect: 22P04 unterminated CSV quoted field | COPY t, line 1: "9,"z,1"
// expect: 23505 | COPY t, line 2; 23514 | COPY t, line 1; 23503 none
// expect: 42P01 42703 42701 0A000 0A000 22023
// expect: nothing kept: 4 rows
// expect: block: COPY 1 then ROLLBACK, 4 rows; read only: 25006, out COPY 4
// expect: client failed: 57014 COPY from stdin failed: no more
// expect: index: 10|idx|1
// expect: many: COPY 10000, 10000 50005000
// expect: reopened: 10006 rows, by the index 1
import "strings"
import "../../../cmd/lexdb_base"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_sql"
import "../../../cmd/lexdb_exec"

fn fail(e: &lexdb_base.DbErr): str {
    return e.state + " " + e.msg + (if e.context != "" { " | " + e.context } else { "" })
}

// COPY ... FROM STDIN with data: its tag, or its error.
fn copyIn(s: mut &lexdb_exec.Session, sql: &str, data: &str): str {
    let stmts = lexdb_sql.parse(sql).unwrap()
    let none: []lexdb_sql.Val = []
    let nt: []int = []
    match s.run(&stmts[0], &none, &nt) {
        Ok(r) {
            if r.copy != lexdb_exec.COPY_IN { return "not COPY_IN: " + r.tag }
            match s.copyIn(&stmts[0], lexdb_exec.CopyInput{have: true, data: data, fail: "", proto: false}) {
                Ok(r2) { return r2.tag }
                Err(e) { return fail(&e) }
            }
        }
        Err(e) { return fail(&e) }
    }
}

// COPY ... TO STDOUT: its lines (each without its newline) joined by |.
fn copyOut(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if r.copy != lexdb_exec.COPY_OUT { return "not COPY_OUT" }
            var ls: []str = []
            for row in r.rows {
                let l = lexdb_exec.text(&row[0])
                append(mut &ls, l[0..len(l) - 1])
            }
            return strings.join(&ls, "|")
        }
        Err(e) { return fail(&e) }
    }
}

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var out: []str = []
            for row in r.rows {
                var vs: []str = []
                for v in row { append(mut &vs, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &out, strings.join(&vs, "|"))
            }
            return strings.join(&out, " ")
        }
        Err(e) { return fail(&e) }
    }
}

fn state(s: mut &lexdb_exec.Session, sql: &str): str { return q(s, sql)[0..5] }

fn opts(): lexdb_store.Options {
    return lexdb_store.Options{cacheBytes: 256 * 1024, segBytes: 1024 * 1024, ckptBytes: 512 * 1024, snapNodes: 100000}
}

fn main() {
    let fs = lexdb_disk.sim(45)
    lexdb_store.run(fs, opts(), fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st)
        let c1 = q(mut &s, &"create table t (id serial primary key, v text, n int default 7 check (n < 100))")
        let t1 = copyIn(mut &s, &"copy t (v) from stdin", &"a b\n\\N\nx\\\\y\ntab\\tin\n")
        println("text in: " + t1 + "; " + q(mut &s, &"select id, v, n from t order by id"))
        let e1 = q(mut &s, &"create table esc (k int primary key, v text, w text)")
        let e2 = copyIn(mut &s, &"copy esc (v, k, w) from stdin with (delimiter '|')", &"\\101\\x42|1|\xc3\xa9\n")
        println("escapes: " + q(mut &s, &"select v, k, w from esc"))
        let h1 = copyIn(mut &s, &"copy t (v, n) from stdin with (format text, header true)", &"v\tn\r\nh1\t1\r\nh2\t2\r\n\\.\nignored\t3\n")
        println("header and end marker: " + h1 + ", rows " + q(mut &s, &"select count(*) from t"))
        let d1 = q(mut &s, &"delete from t where id > 4")

        let cv1 = q(mut &s, &"create table c (id int primary key, v text)")
        let cv2 = copyIn(mut &s, &"copy c from stdin with (format csv)", &"10,\"a,b\"\n11,\n12,\"\"\"\"\"\"\n13,\"two\nlines \"\"q\"\"\"\n")
        println("csv in: " + cv2 + "; " + q(mut &s, &"select id, replace(v, E'\\n', '/') from c order by id"))
        let f1 = q(mut &s, &"create table fz (id int primary key, a text, b text)")
        let f2 = copyIn(mut &s, &"copy fz from stdin with (format csv, force_not_null (a), force_null (b))", &"1,,\"\"\n")
        println("force: " + q(mut &s, &"select id, coalesce(b, 'NULL') from fz") + " " + q(mut &s, &"select id, '\"' || a || '\"' from fz"))
        let cr = copyIn(mut &s, &"copy c from stdin with (format csv)", &"20,\"\"\r\n21,\r\n")
        println("csv crlf: " + cr + "; " + q(mut &s, &"select id, coalesce('\"' || v || '\"', 'NULL') from c where id >= 20 order by id"))
        let so = q(mut &s, &"create table so (id int primary key, v text); insert into so values (1, 'a,b'), (2, 'q\"r'), (3, 'p|q')")
        println("special out: " + copyOut(mut &s, &"copy so to stdout with (delimiter '|')") + " / " +
                copyOut(mut &s, &"copy so to stdout with (format csv)") + " / tag " + q(mut &s, &"copy so to stdout with (format csv, header)"))

        println("text out: " + strings.replaceAll(&copyOut(mut &s, &"copy t to stdout"), "\t", "\\t"))
        println("csv out: " + copyOut(mut &s, &"copy t to stdout with (format csv, header)"))
        let qo = copyOut(mut &s, &"copy (select id, upper(v) from t where id in (1, 3) order by id) to stdout with (format csv, delimiter ';', force_quote *)")
        let qt = q(mut &s, &"copy (select 1 union all select 2) to stdout")
        println("query out: " + qo + ", tag " + qt)

        let g1 = q(mut &s, &"create table g (id int generated always as identity primary key, v text)")
        let g2 = copyIn(mut &s, &"copy g from stdin", &"100\ta\n")
        let g3 = copyIn(mut &s, &"copy g (v) from stdin", &"b\n")
        println("identity: " + g2 + " " + g3 + "; " + q(mut &s, &"select id, v from g order by v"))

        println("errors: " + copyIn(mut &s, &"copy t (v, n) from stdin", &"ok\t1\nbad\tx\n"))
        println(copyIn(mut &s, &"copy t (id, v, n) from stdin", &"9\tz\n"))
        println(copyIn(mut &s, &"copy t (id, v, n) from stdin", &"9\tz\t1\t2\n"))
        println(copyIn(mut &s, &"copy t (id, v, n) from stdin with csv", &"9,\"z,1"))
        let k1 = q(mut &s, &"create table fp (id int primary key); create table fc (id int primary key, p int references fp)")
        let dupe = copyIn(mut &s, &"copy t (id, v) from stdin", &"50\tnew\n1\tdup\n")
        let chk = copyIn(mut &s, &"copy t (v, n) from stdin", &"big\t500\n")
        let fk = copyIn(mut &s, &"copy fc from stdin", &"1\t1\n")
        println(dupe[0..5] + dupe[strings.indexOf(&dupe, " | ", 0)..len(dupe)] + "; " + chk[0..5] + chk[strings.indexOf(&chk, " | ", 0)..len(chk)] +
                "; " + fk[0..5] + (if strings.indexOf(&fk, " | ", 0) < 0 { " none" } else { " with context" }))
        println(copyIn(mut &s, &"copy nope from stdin", &"")[0..5] + " " + copyIn(mut &s, &"copy t (zz) from stdin", &"")[0..5] + " " +
                copyIn(mut &s, &"copy t (v, v) from stdin", &"")[0..5] + " " + state(mut &s, &"copy t from '/tmp/f'") + " " +
                state(mut &s, &"copy t from stdin with (format binary)") + " " + state(mut &s, &"copy t from stdin with (delimiter '||')"))
        println("nothing kept: " + q(mut &s, &"select count(*) from t") + " rows")

        let b1 = q(mut &s, &"begin")
        let b2 = copyIn(mut &s, &"copy t (v) from stdin", &"in block\n")
        let b3 = q(mut &s, &"rollback")
        let r1 = q(mut &s, &"begin read only")
        let r2 = copyIn(mut &s, &"copy t (v) from stdin", &"ro\n")
        let r3 = q(mut &s, &"rollback; begin read only")
        let r4 = q(mut &s, &"copy t to stdout")
        let r5 = q(mut &s, &"commit")
        println("block: " + b2 + " then " + b3 + ", " + q(mut &s, &"select count(*) from t") + " rows; read only: " + r2[0..5] + ", out " + r4)

        let stmts = lexdb_sql.parse(&"copy t (v) from stdin").unwrap()
        let none: []lexdb_sql.Val = []
        let nt: []int = []
        let ci = s.run(&stmts[0], &none, &nt).unwrap()
        match s.copyIn(&stmts[0], lexdb_exec.CopyInput{have: true, data: "x\n", fail: "no more", proto: false}) {
            Ok(r) { println("client failed: no error? " + r.tag) }
            Err(x) { println("client failed: " + fail(&x)) }
        }

        let i1 = q(mut &s, &"create index t_v on t (v); select count(*) from t")
        let i2 = copyIn(mut &s, &"copy t (v, n) from stdin", &"idx\t1\n")
        println("index: " + q(mut &s, &"select id, v, n from t where v = 'idx'"))

        var big = newStrBuf()
        for i in 1..10001 { big.add(i.toStr() + "\n") }
        let m1 = q(mut &s, &"create table m (id int primary key)")
        let m2 = copyIn(mut &s, &"copy m from stdin", &big.toStr())
        println("many: " + m2 + ", " + q(mut &s, &"select count(*) || ' ' || sum(id) from m"))
        let m3 = copyIn(mut &s, &"copy t (v) from stdin", &"after\n")
        return 0
    }).unwrap()
    lexdb_store.run(fs, opts(), fn(st: lexdb_store.Store): int {
        var s = lexdb_exec.newSession(st)
        println("reopened: " + q(mut &s, &"select (select count(*) from m) + (select count(*) from t)") + " rows, by the index " +
                q(mut &s, &"select count(*) from t where v = 'after'"))
        return 0
    }).unwrap()
}
