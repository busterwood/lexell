const QUERIES = "create table t(a int primary key, b varchar(10)); insert into t values (1,'x'),(2,'y'),(3,'z'),(4,NULL)\ncreate function dbo.sq(@a int) returns int as begin return @a * @a end\nselect a, dbo.sq(a), dbo.sq(dbo.sq(a)) from t order by a\nselect dbo.sq(3), dbo.sq(null), dbo.sq(-4)\nselect dbo.sq(46341)\nselect dbo.sq('abc')\nselect dbo.sq('7')\nselect a from t where dbo.sq(a) between 2 and 10 order by a\nselect dbo.sq(a) s, count(*) from t group by dbo.sq(a) having count(*) > 0 order by s\nselect a from t order by dbo.sq(a) desc\nselect sum(dbo.sq(a)), max(dbo.sq(a)) from t\nselect top 2 a from t order by dbo.sq(a) desc\nselect t1.a, t2.a from t t1 join t t2 on dbo.sq(t1.a) = t2.a order by 1\nselect dbo.sq(a) from (select 1 a union all select 2) q\nselect case when dbo.sq(2) = 4 then 'ok' else 'no' end\ndeclare @x int = dbo.sq(7); select @x\ndeclare @x int; set @x = dbo.sq(3) + dbo.sq(4); select @x\nif dbo.sq(3) = 9 select 'yes' else select 'no'\ndeclare @i int = 0; while dbo.sq(@i) < 10 set @i += 1; select @i\ninsert into t select a + 10, 'n' from t where dbo.sq(a) < 10; select count(*) from t\nupdate t set a = dbo.sq(a) + 100 where a > 10; select a from t order by a\ndelete from t where dbo.sq(a) > 10000; select count(*) from t\nselect dbo.nosuch(3)\nselect nosuch(3)\nselect dbo.sq()\nselect dbo.sq(1, 2)\nselect sq(3)\nselect sys.sq(3)\nselect dbo.len('abc')\ncreate function dbo.h(@a int, @b int = 5) returns int with schemabinding as begin return @a + @b end\nselect dbo.h(1)\nselect dbo.h(1, default), dbo.h(1, 2), dbo.h(default, default)\ncreate function dbo.nodef(@a int) returns int as begin return isnull(@a, -1) end\nselect dbo.nodef(default), dbo.nodef(null), dbo.nodef(4)\ncreate function dbo.t1() returns int as begin return 1 end\nselect dbo.t1()\nselect dbo.t1(1)\ncreate function t2() returns int as begin return 2 end\nselect dbo.t2()\nselect t2()\ncreate function dbo.sv(@x varchar(5)) returns varchar(3) as begin return @x + 'abcdef' end\nselect dbo.sv('abcdefgh'), len(dbo.sv('a'))\ncreate function dbo.dec1(@x decimal(10,2)) returns decimal(10,3) as begin return @x / 3 end\nselect dbo.dec1(10), dbo.dec1('4.567'), dbo.dec1(null)\ncreate function dbo.dt(@d date) returns date as begin return dateadd(day, 1, @d) end\nselect dbo.dt('2020-02-28'), dbo.dt(null), dbo.dt('2020-12-31')\ncreate function dbo.bt(@a int) returns bit as begin return case when @a > 0 then 1 else 0 end end\nselect dbo.bt(5), dbo.bt(-5), dbo.bt(null)\ncreate function dbo.cls(@n int) returns varchar(10) as begin declare @r varchar(10); if @n < 0 set @r = 'neg' else if @n = 0 set @r = 'zero' else set @r = 'pos'; return @r end\nselect dbo.cls(-1), dbo.cls(0), dbo.cls(1), dbo.cls(null)\ncreate function dbo.str1(@s varchar(20)) returns varchar(40) as begin declare @i int = 1, @o varchar(40) = ''; while @i <= len(@s) begin set @o = @o + substring(@s, @i, 1) + '-'; set @i += 1 end; return @o end\nselect dbo.str1('abc'), dbo.str1(''), dbo.str1(null)\nselect a, dbo.str1(b) from t order by a\ncreate function dbo.brk(@n int) returns int as begin declare @i int = 0; while 1 = 1 begin set @i += 1; if @i >= @n break; if @i % 2 = 0 continue; end; return @i end\nselect dbo.brk(5), dbo.brk(0), dbo.brk(10)\ncreate function dbo.fact(@n int) returns bigint as begin if @n <= 1 return 1; return @n * dbo.fact(@n - 1) end\nselect dbo.fact(5), dbo.fact(1), dbo.fact(20)\nselect dbo.fact(21)\ncreate function dbo.sumto(@n int) returns int as begin if @n <= 0 return 0; return @n + dbo.sumto(@n - 1) end\nselect dbo.sumto(10), dbo.sumto(32)\nselect dbo.sumto(33)\ncreate function dbo.inf(@n int) returns int as begin declare @r int; set @r = dbo.inf(@n + 1); return @r end\nselect dbo.inf(1)\ncreate function dbo.dz(@n int) returns int as begin return 10 / @n end\nselect dbo.dz(2)\nselect dbo.dz(0)\nselect a, dbo.dz(a - 2) from t where a <> 2 order by a\ncreate function dbo.rd(@a int) returns varchar(10) as begin declare @r varchar(10); select @r = b from t where a=@a; return @r end\nselect a, dbo.rd(a) as r from t order by a\nselect dbo.rd(2), dbo.rd(9)\ncreate function dbo.cnt(@lo int) returns int as begin return (select count(*) from t where a >= @lo) end\nselect a, dbo.cnt(a) from t order by a\nselect dbo.cnt(3) + 1\nselect a from t where dbo.cnt(a) > 2 order by a\ncreate function dbo.cond3(@a int) returns varchar(20) as begin declare @n int; select @n = count(*) from t where a > @a; if @n > 2 begin return 'many' end; if @n > 0 begin return 'some' end; return 'none' end\nselect a, dbo.cond3(a) from t order by a\ncreate function dbo.nest(@a int) returns int as begin return dbo.sq(@a) + dbo.cnt(@a) end\nselect a, dbo.nest(a) from t order by a\ncreate function dbo.itvf(@lo int) returns table as return (select a, b from t where a >= @lo)\nselect * from dbo.itvf(2) order by a\nselect x.a, y.b from dbo.itvf(2) x join t y on y.a = x.a order by x.a\nselect a, (select count(*) from dbo.itvf(t.a)) c from t\nselect t.a, i.b from t cross apply dbo.itvf(t.a) i order by 1,2\nselect t.a, i.b from t outer apply dbo.itvf(t.a + 2) i order by 1,2\nselect * from dbo.itvf()\nselect * from dbo.itvf(1, 2)\nselect * from itvf(1) order by a\nselect * from dbo.nosuch(1)\nselect dbo.itvf(1)\nselect * from dbo.rd(1)\nselect * from dbo.itvf(2) as i(x, y) order by x\nselect i.* from dbo.itvf(3) i\nselect count(*) from dbo.itvf(0) where a > 1\nselect a from t where exists (select 1 from dbo.itvf(t.a) where a > 3) order by a\nselect a from t where a in (select a from dbo.itvf(3)) order by a\ncreate function dbo.itvf2(@lo int, @hi int = 3) returns table as return select a from t where a between @lo and @hi\nselect * from dbo.itvf2(1, default) order by a\nselect * from dbo.itvf2(2, 4) order by a\nselect count(*) from dbo.itvf2(2, 4) f where f.a > 2\ncreate function dbo.itvf4(@p int) returns table as return select i.a, i.b from dbo.itvf(@p) i where i.a < 4\nselect * from dbo.itvf4(2) order by a\ncreate function dbo.e1(@a int) returns int as begin raiserror('x', 16, 1); return 1 end\ncreate function dbo.e2(@a int) returns int as begin throw 50000, 'x', 1; return 1 end\ncreate function dbo.e3(@a int) returns int as begin begin tran; return 1 end\ncreate function dbo.e5(@a int) returns int as begin delete t; return 1 end\ncreate function dbo.e5b(@a int) returns int as begin insert t values (1, 'a'); return 1 end\ncreate function dbo.e5c(@a int) returns int as begin update t set b = 'q'; return 1 end\ncreate function dbo.e6(@a int) returns int as begin print 'x'; return 1 end\ncreate function dbo.e7(@a int) returns int as begin exec ('select 1'); return 1 end\ncreate function dbo.e8(@a int) returns int as begin return end\ncreate function dbo.e9(@a int) returns int as begin select 1; return 1 end\ncreate function dbo.e9b(@a int) returns int as begin select a from t; return 1 end\ncreate function dbo.e10(@a int) returns int as begin declare @x int; select @x = 1; return @x end\ncreate function dbo.e11(@a int) returns int as begin set nocount on; return 1 end\ncreate function dbo.e13(@a int) returns int as begin create table #x(a int); return 1 end\ncreate function dbo.e14(@a int) returns int as begin select * into #y from t; return 1 end\ncreate function dbo.e17(@a int) returns int as begin if @a > 0 return 1 else return 2 end\ncreate function dbo.e18(@a int) returns int as begin if @a > 0 return 1 end\ncreate function dbo.e19(@a int) returns int as begin begin try return 1 end try begin catch return 2 end catch end\ncreate function dbo.e20(@a int) returns int as begin return @a end; select 1\ncreate function dbo.e22(@a int) returns int as begin return @a end select 1\nselect 1; create function dbo.e23(@a int) returns int as begin return @a end\ncreate function dbo.e24(@a int) returns int as return @a\ncreate function dbo.e25(@a int, @a int) returns int as begin return 1 end\ncreate function dbo.e26(@a int) returns int as begin declare @a int; return 1 end\ncreate function dbo.e27(@a int) returns int as begin return @b end\ncreate function dbo.e29(@a int) returns int as begin return dbo.nosuchfn(@a) end\nselect dbo.e29(1)\ncreate function dbo.e30(@a int) returns int as begin break; return 1 end\ncreate function dbo.e31(@a int) returns table as return (select a from t)\ncreate function dbo.e32() returns table as begin return end\ncreate function dbo.e33() returns table as return 1\ncreate function dbo.e34(@a int) returns int\ncreate function dbo.e35(@a int)\ncreate function dbo.sq(@a int) returns int as begin return @a end\ncreate function dbo.sq2(@a int) returns int as begin return @a end\ncreate or alter function dbo.sq2(@a int) returns int as begin return @a + 1 end\nselect dbo.sq2(1)\nalter function dbo.sq2(@a int) returns int as begin return @a + 2 end\nselect dbo.sq2(1)\nalter function dbo.nosuch(@a int) returns int as begin return @a end\ncreate or alter function dbo.sq2(@a int, @b int) returns int as begin return @a + @b end\nselect dbo.sq2(1), dbo.sq2(1, 2)\nselect dbo.sq2(1, 2)\ncreate procedure dbo.pr as select 1\ncreate function dbo.pr() returns int as begin return 1 end\ncreate or alter function dbo.pr() returns int as begin return 1 end\nalter function dbo.pr() returns int as begin return 1 end\nalter function dbo.sq2() returns table as return select 1 a\ncreate function dbo.sq3() returns int as begin return 1 end;\nselect object_definition(object_id('dbo.sq3'))\ncreate   or   alter   function   dbo.sq4  ( @a int )  returns int  as  begin  return 4  end\nselect object_definition(object_id('dbo.sq4'))\nalter function dbo.sq4(@a int) returns int as begin return 5 end\nselect object_definition(object_id('dbo.sq4'))\nselect name, type, type_desc from sys.objects where name in ('sq','itvf','rd','sq3') order by name\nselect o.name, len(m.definition) from sys.sql_modules m join sys.objects o on o.object_id = m.object_id where o.name in ('sq3', 'sq4') order by 1\nselect object_id('dbo.sq3', 'FN') - object_id('dbo.sq3'), object_id('dbo.itvf', 'IF') - object_id('dbo.itvf'), object_id('dbo.sq3', 'IF'), object_id('dbo.sq3', 'P')\nselect objectproperty(object_id('dbo.sq'), 'IsScalarFunction'), objectproperty(object_id('dbo.itvf'), 'IsTableFunction'), objectproperty(object_id('dbo.itvf'), 'IsInlineFunction'), objectproperty(object_id('dbo.sq'), 'IsInlineFunction'), objectproperty(object_id('dbo.sq'), 'IsProcedure')\nselect p.name, p.parameter_id, t.name, p.is_output from sys.parameters p join sys.types t on t.user_type_id = p.user_type_id where p.object_id = object_id('dbo.str1') order by p.parameter_id\nselect name from sys.procedures where name in ('pr', 'sq3')\ndrop function dbo.sq3\nselect dbo.sq3()\ndrop function dbo.sq3\ndrop function if exists dbo.sq3\ndrop function if exists dbo.sq3, dbo.sq4\ndrop function dbo.zzz\ndrop function dbo.pr\ndrop procedure dbo.pr\ndrop procedure dbo.sq\ndrop function dbo.sq, dbo.h\nselect dbo.sq(2)\nselect dbo.h(1)\ndrop function dbo.itvf\nselect * from dbo.itvf(2)\ndrop function dbo.rd; drop function dbo.cnt\nselect dbo.rd(1)\ncreate table dup(a int); create function dbo.dup() returns int as begin return 1 end\ncreate function dbo.dup() returns int as begin return 1 end\nselect 1 where 1 = 0 union all select dbo.t1() where 1 = 0"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(41), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
