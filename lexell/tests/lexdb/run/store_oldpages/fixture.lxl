// The fixture of store_oldpages: a data directory as the store wrote it at
// 78731801, before front-coded leaves (design/lexdb.md 9.109). Made by
// gen.lxl.txt, compiled against that commit's sources; the files'
// non-zero bytes by page, in base64. The log holds only what replay
// reads: the frames from the checkpoint's replay position (segment 1,
// offset 24576) on.

pub type Part = value record { pub at: int; pub b64: str }
pub type File = record { pub name: str; pub size: int; pub parts: []Part }

pub fn files(): []File {
    return [
        File{name: "data.lxdb", size: 45056, parts: [
            Part{at: 4096, b64: "r8JLhgEAAAAAAAAAAQAAAExFWERCMDAxAQAAAAAAAAALAAAAAAAAAAoAAAAAAAAAAAAAAAAAAAABAAAAAAAAAABgAAAAAAAAAwAAAAAAAAAEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD"},
            Part{at: 8192, b64: ""},
            Part{at: 12288, b64: ""},
            Part{at: 16384, b64: ""},
            Part{at: 20480, b64: ""},
            Part{at: 24576, b64: ""},
            Part{at: 28672, b64: "eqS2UQcAAAAAAAAAAwAAAAMAAwAAAAAAAAARAAEAAAAAAAAACAAAAAAAAAFlBAAAAAAAAAARAAEAAAAAAAAAEQAAAAAAAAERBQAAAAAAAAARAAEAAAAAAAAAGgAAAAAAAALoBg=="},
            Part{at: 32768, b64: ""},
            Part{at: 36864, b64: ""},
            Part{at: 40960, b64: "hIVr9QoAAAAAAAAABQAAAAAAAAAAAAAACAAAAAEAAAAAAAAAAgAAAAAAAAACAAAAAAAAAAcAAAAAAAAAAwAAAAAAAAAIAAAAAAAAAAEAAAAAAQAACQ=="}
        ]},
        File{name: "log.1", size: 32768, parts: [
            Part{at: 24576, b64: ""}
        ]}
    ]
}
