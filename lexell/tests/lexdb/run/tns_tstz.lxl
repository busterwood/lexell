const SETUP = "create table tz1 (id number primary key, t timestamp with time zone, p timestamp(3) with time zone, l timestamp with local time zone)\ninsert into tz1 values (1, timestamp '2026-03-15 10:00:00 +02:00', timestamp '2026-03-15 10:00:00.123456 +02:00', timestamp '2026-03-15 10:00:00 +02:00')\ninsert into tz1 values (2, timestamp '2026-03-15 08:00:00 +00:00', timestamp '2026-03-15 08:00:00.9996 -05:30', timestamp '2026-03-15 08:00:00 +00:00')\ninsert into tz1 values (3, timestamp '2026-03-15 03:00:00 -05:00', null, null)\ninsert into tz1 values (4, timestamp '2026-03-15 12:00:00 +05:30', timestamp '2026-03-15 12:00:00 +05:30', timestamp '2026-03-15 12:00:00 +05:30')\ninsert into tz1 values (5, null, null, null)\ncreate table tz2 (id number primary key, t timestamp with time zone)\ninsert into tz2 values (1, timestamp '2026-03-15 11:00:00 +03:00')\ninsert into tz2 values (2, timestamp '2026-03-15 06:30:00 +00:00')\ninsert into tz2 values (3, timestamp '2026-03-16 00:00:00 +14:00')\ncreate index tz2_t on tz2 (t)\ncreate table tz3 (id number primary key, t timestamp with time zone)\ncreate unique index tz3_u on tz3 (t)"

const QS = "select id, to_char(t, 'YYYY-MM-DD HH24:MI:SS.FF6 TZH:TZM') a, to_char(p, 'YYYY-MM-DD HH24:MI:SS.FF6 TZH:TZM') b, to_char(l, 'YYYY-MM-DD HH24:MI:SS.FF6') c from tz1 order by id\nselect id from tz1 order by t, id\nselect id from tz1 order by t desc, id\nselect id from tz1 order by t nulls first, id\nselect to_char(t, 'HH24:MI TZH:TZM') a, count(*) n from tz1 group by t order by n, a\nselect count(*) n from (select distinct t from tz1)\nselect count(distinct t) n from tz1\nselect count(*) n from tz1 where t = timestamp '2026-03-15 08:00:00 +00:00'\nselect id from tz1 where t = timestamp '2026-03-15 11:00:00 +03:00' order by id\nselect id from tz1 where t > timestamp '2026-03-15 07:00:00 +00:00' order by id\nselect id from tz1 where t between timestamp '2026-03-15 06:00:00 +00:00' and timestamp '2026-03-15 08:00:00 +00:00' order by id\nselect id from tz1 where t in (timestamp '2026-03-15 08:00:00 +00:00', timestamp '2026-03-15 06:30:00 +00:00') order by id\nselect a.id x, b.id y from tz1 a join tz1 b on a.t = b.t and a.id < b.id order by 1, 2\nselect a.id x, b.id y from tz1 a join tz2 b on a.t = b.t order by 1, 2\nselect a.id x, b.id y from tz1 a, tz2 b where a.t < b.t and a.id < 3 order by 1, 2\nselect to_char(max(t), 'HH24:MI TZH:TZM') mx, to_char(min(t), 'HH24:MI TZH:TZM') mn from tz2\nselect id from tz2 where t >= timestamp '2026-03-15 08:00:00 +00:00' order by id\nselect id from tz2 where t = timestamp '2026-03-15 08:00:00 +02:00' order by id\nselect id, row_number() over (order by t) rn from tz2 order by id\ninsert into tz3 values (1, timestamp '2026-03-15 10:00:00 +02:00') ;; insert into tz3 values (2, timestamp '2026-03-15 08:00:00 +00:00') ;; select count(*) n from tz3\ninsert into tz3 values (1, timestamp '2026-03-15 10:00:00 +02:00') ;; insert into tz3 values (2, timestamp '2026-03-15 09:00:00 +02:00') ;; select to_char(t, 'HH24:MI TZH:TZM') a from tz3 order by id\ninsert into tz3 values (1, '15-MAR-26 10.00.00.000000 AM +02:00') ;; select to_char(t, 'YYYY-MM-DD HH24:MI TZH:TZM') a from tz3\ninsert into tz3 values (1, timestamp '2026-03-15 10:00:00') ;; select to_char(t, 'YYYY-MM-DD HH24:MI TZH:TZM') a from tz3\ninsert into tz3 values (1, date '2026-03-15') ;; select to_char(t, 'YYYY-MM-DD HH24:MI TZH:TZM') a from tz3\ninsert into tz3 select id, t from tz1 where id < 4 ;; select count(*) n from tz3\nupdate tz1 set t = t + interval '1' day where id = 1 ;; select to_char(t, 'YYYY-MM-DD HH24:MI TZH:TZM') a from tz1 where id = 1\nupdate tz1 set t = timestamp '2026-03-15 08:00:00 +02:00' where id = 2 ;; select to_char(t, 'YYYY-MM-DD HH24:MI TZH:TZM') a from tz1 where id = 2\ndelete from tz1 where t = timestamp '2026-03-15 08:00:00 +00:00' ;; select count(*) n from tz1\nselect to_char(t, 'YYYY-MM-DD HH24:MI TZH:TZM') a from tz1 where t = timestamp '2026-03-15 08:00:00 +00:00' and id = 2\nselect extract(hour from timestamp '2026-03-15 10:00:00 +02:00') h from dual\nselect extract(minute from timestamp '2026-03-15 10:30:00 +05:30') h from dual\nselect extract(day from timestamp '2026-03-15 01:00:00 +05:30') h from dual\nselect extract(timezone_hour from timestamp '2026-03-15 10:00:00 -05:30') h from dual\nselect extract(timezone_minute from timestamp '2026-03-15 10:00:00 -05:30') h from dual\nselect extract(timezone_region from timestamp '2026-03-15 10:00:00 -05:30') h from dual\nselect extract(timezone_abbr from timestamp '2026-03-15 10:00:00 -05:30') h from dual\nselect extract(timezone_hour from timestamp '2026-03-15 10:00:00') h from dual\nselect extract(timezone_hour from t) h from tz1 where id = 4\nselect extract(hour from cast(timestamp '2026-03-15 10:00:00 +02:00' as timestamp)) h from dual\nselect to_char(from_tz(timestamp '2026-03-15 10:00:00', '+03:00'), 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(from_tz(timestamp '2026-03-15 10:00:00', '-05:30'), 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(from_tz(timestamp '2026-03-15 10:00:00', 'Mars/Olympus'), 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(from_tz(timestamp '2026-03-15 10:00:00', '+16:00'), 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(from_tz(timestamp '2026-03-15 10:00:00', '+03'), 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(sys_extract_utc(timestamp '2026-03-15 10:00:00 +02:00'), 'YYYY-MM-DD HH24:MI') a from dual\nselect to_char(sys_extract_utc(t), 'YYYY-MM-DD HH24:MI') a from tz1 where id = 4\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' at time zone '+05:00', 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' at time zone '-05:30', 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(t at time zone '+00:00', 'YYYY-MM-DD HH24:MI TZH:TZM') a from tz1 where id = 4\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' at time zone dbtimezone, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' at time zone 'Nowhere/Land', 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect tz_offset('+05:30') a, tz_offset('-08:00') b, tz_offset(dbtimezone) c from dual\nselect tz_offset('Mars/Olympus') a from dual\nselect to_char(new_time(timestamp '2026-03-15 10:00:00', 'EST', 'PST'), 'YYYY-MM-DD HH24:MI') a from dual\nselect to_char(new_time(date '2026-03-15', 'GMT', 'CST'), 'YYYY-MM-DD HH24:MI') a from dual\nselect to_char(new_time(date '2026-03-15', 'GMT', 'XXX'), 'YYYY-MM-DD HH24:MI') a from dual\nselect to_char(to_timestamp_tz('2026-03-15 10:30:00 +03:00', 'YYYY-MM-DD HH24:MI:SS TZH:TZM'), 'HH24:MI TZH:TZM') a from dual\nselect to_char(to_timestamp_tz('2026-03-15 10:30:00 -03:30', 'YYYY-MM-DD HH24:MI:SS TZH:TZM'), 'HH24:MI TZH:TZM') a from dual\nselect to_char(to_timestamp_tz('2026-03-15 10:30:00.123456 +03:00', 'YYYY-MM-DD HH24:MI:SS.FF TZH:TZM'), 'HH24:MI:SS.FF3 TZH:TZM') a from dual\nselect to_char(to_timestamp_tz('2026-03-15 10:30:00', 'YYYY-MM-DD HH24:MI:SS'), 'HH24:MI TZH:TZM') a from dual\nselect to_char(to_timestamp_tz('15-MAR-26 10.30.00.000000 AM +03:00'), 'HH24:MI TZH:TZM') a from dual\nselect to_char(to_timestamp_tz('2026-03-15 10:30:00 +16:00', 'YYYY-MM-DD HH24:MI:SS TZH:TZM'), 'HH24:MI TZH:TZM') a from dual\nselect to_char(to_timestamp_tz('nonsense', 'YYYY-MM-DD HH24:MI:SS TZH:TZM'), 'HH24:MI TZH:TZM') a from dual\nselect timestamp '2026-03-15 10:30:00 +16:00' a from dual\nselect timestamp '2026-03-15 10:30:00 +02:60' a from dual\nselect timestamp '2026-03-15 10:30:00 Mars/Olympus' a from dual\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' - timestamp '2026-03-15 10:00:00 +00:00') a from dual\nselect extract(hour from timestamp '2026-03-15 10:00:00 +02:00' - timestamp '2026-03-15 08:00:00 +00:00') h, extract(hour from timestamp '2026-03-15 10:00:00 +00:00' - timestamp '2026-03-15 08:00:00 +03:00') g from dual\nselect extract(day from t - timestamp '2026-03-14 00:00:00 +00:00') d, extract(hour from t - timestamp '2026-03-14 00:00:00 +00:00') h from tz1 where id = 4\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' + interval '1' day, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' + interval '1' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' - interval '5' hour, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' + numtodsinterval(30, 'minute'), 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(t + interval '90' minute, 'HH24:MI TZH:TZM') a from tz1 where id = 4\nselect to_char(cast(timestamp '2026-03-15 10:00:00 +02:00' as timestamp), 'YYYY-MM-DD HH24:MI:SS') a from dual\nselect to_char(cast(timestamp '2026-03-15 10:00:00 +02:00' as date), 'YYYY-MM-DD HH24:MI:SS') a from dual\nselect to_char(cast(t as timestamp), 'YYYY-MM-DD HH24:MI:SS') a from tz1 where id = 4\nselect to_char(cast(timestamp '2026-03-15 10:00:00 +02:00' as timestamp with local time zone), 'YYYY-MM-DD HH24:MI:SS') a from dual\nselect to_char(cast(timestamp '2026-03-15 10:00:00 +02:00' as timestamp(0) with time zone), 'YYYY-MM-DD HH24:MI:SS TZH:TZM') a from dual\nselect to_char(cast(timestamp '2026-03-15 10:00:00.999 +02:00' as timestamp(0) with time zone), 'YYYY-MM-DD HH24:MI:SS TZH:TZM') a from dual\nselect to_char(cast(timestamp '2026-03-15 10:00:00' as timestamp with time zone), 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(cast(date '2026-03-15' as timestamp with time zone), 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(cast('15-MAR-26 10.00.00.000000 AM +02:00' as timestamp with time zone), 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect cast(timestamp '2026-03-15 10:00:00 +02:00' as varchar2(60)) a from dual\nselect cast(t as varchar2(60)) a from tz1 where id = 4\nselect to_char(t) a from tz1 where id = 3\nselect to_char(timestamp '2026-03-15 10:00:00.5 +02:00', 'SSXFF3 TZH:TZM') a from dual\nselect case when timestamp '2026-03-15 10:00:00 +02:00' = timestamp '2026-03-15 08:00:00 +00:00' then 'eq' else 'ne' end a from dual\nselect case when timestamp '2026-03-15 10:00:00 +02:00' < timestamp '2026-03-15 09:00:00 +00:00' then 'lt' else 'ge' end a from dual\nselect case when timestamp '2026-03-15 10:00:00 +02:00' = timestamp '2026-03-15 08:00:00' then 'eq' else 'ne' end a from dual\nselect to_char(trunc(timestamp '2026-03-15 10:45:00 +02:00'), 'YYYY-MM-DD HH24:MI') a from dual\nselect to_char(greatest(timestamp '2026-03-15 10:00:00 +02:00', timestamp '2026-03-15 09:00:00 +00:00'), 'HH24:MI TZH:TZM') a from dual\nselect to_char(least(timestamp '2026-03-15 10:00:00 +02:00', timestamp '2026-03-15 09:00:00 +00:00'), 'HH24:MI TZH:TZM') a from dual\nselect to_char(coalesce(cast(null as timestamp with time zone), timestamp '2026-03-15 09:00:00 +03:00'), 'HH24:MI TZH:TZM') a from dual\nselect to_char(nvl(t, timestamp '2026-03-15 09:00:00 +03:00'), 'HH24:MI TZH:TZM') a from tz1 where id = 5\nselect to_char(decode(id, 5, timestamp '2026-03-15 09:00:00 +03:00', t), 'HH24:MI TZH:TZM') a from tz1 where id in (4, 5) order by id\nselect id, to_char(t, 'TZH:TZM') a from tz1 where t is not null order by id\nselect to_char(systimestamp, 'TZH:TZM') a from dual\nselect to_char(current_timestamp, 'TZH:TZM') a from dual\nselect case when systimestamp > timestamp '2020-01-01 00:00:00 +00:00' then 1 else 0 end a from dual\nalter session set time_zone = '+02:00' ;; select sessiontimezone a from dual ;; select to_char(current_timestamp, 'TZH:TZM') b from dual ;; select to_char(systimestamp, 'TZH:TZM') c from dual ;; alter session set time_zone = '+00:00'\nalter session set time_zone = '-05:30' ;; select sessiontimezone a from dual ;; select to_char(cast(timestamp '2026-03-15 10:00:00' as timestamp with time zone), 'HH24:MI TZH:TZM') b from dual ;; alter session set time_zone = '+00:00'\nalter session set time_zone = '+02:00' ;; select to_char(timestamp '2026-03-15 10:00:00' at time zone '+05:00', 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual ;; select to_char(timestamp '2026-03-15 10:00:00 +05:00' at local, 'YYYY-MM-DD HH24:MI TZH:TZM') b from dual ;; select to_char(timestamp '2026-03-15 10:00:00 +02:00' at time zone sessiontimezone, 'YYYY-MM-DD HH24:MI TZH:TZM') c from dual ;; alter session set time_zone = '+00:00'\nalter session set time_zone = '+02:00' ;; select case when timestamp '2026-03-15 10:00:00 +02:00' = timestamp '2026-03-15 08:00:00' then 'eq' else 'ne' end a from dual ;; select to_char(cast(timestamp '2026-03-15 10:00:00 +02:00' as timestamp with local time zone), 'YYYY-MM-DD HH24:MI:SS') b from dual ;; alter session set time_zone = '+00:00'\nalter session set time_zone = '+16:00'\nalter session set time_zone = '+15:30'\nalter session set time_zone = '+02'\nalter session set time_zone = 'Mars/Olympus'\nalter session set nls_timestamp_tz_format = 'YYYY-MM-DD HH24:MI:SS TZH:TZM' ;; select cast(t as varchar2(40)) a from tz1 where id = 1 ;; select to_char(t) b from tz1 where id = 4 ;; alter session set nls_timestamp_tz_format = 'DD-MON-RR HH.MI.SSXFF AM TZR'\nalter session set nls_timestamp_tz_format = 'DD/MM/YYYY HH24:MI TZR' ;; select to_char(timestamp '2026-03-15 10:00:00 -03:30') a from dual ;; select to_char(to_timestamp_tz('15/03/2026 10:30 +04:00')) b from dual ;; alter session set nls_timestamp_tz_format = 'DD-MON-RR HH.MI.SSXFF AM TZR'\nselect to_char(t, 'TZD') a, to_char(t, 'TZR') b from tz1 where id = 1\nselect to_char(timestamp '2026-03-15 10:00:00', 'TZH') a from dual\nselect to_char(date '2026-03-15', 'TZR') a from dual"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(171), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
