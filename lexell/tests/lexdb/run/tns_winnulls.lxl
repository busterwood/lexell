// lexdb over TNS: IGNORE NULLS and RESPECT NULLS of LAG, LEAD, FIRST_VALUE, LAST_VALUE and NTH_VALUE (design/lexdb-new-features.md
// O25), after the call (f(x) IGNORE NULLS OVER) and inside it (f(x IGNORE NULLS) OVER): offsets, defaults, NULL offsets,
// partitions, ROWS, RANGE and GROUPS frames with offsets and EXCLUDE, text values, a named window, NULLS FIRST orders, 3,000
// rows grouped, no rows, every value NULL, an error in a later row (ORA-01476, ORA-01428); ORA-01428 for an offset or n below 1,
// ORA-30484 for another function, two treatments and no OVER. Checked against Oracle Database Free 23.26 (gen_oracle.py --check
// tns_winnulls: the answers below are Oracle's). Each statement runs with set lexdb_batch = off (the row engine) and on: "same"
// and the answer, or DIFFERENT and both.
// expect: setup: 7 statements
// expect: same: ID,A,B,C,E = 1|NULL|10|NULL|10;2|NULL|20|NULL|20;3|10|20|NULL|20;4|10|30|NULL|-1;5|20|30|10|-1;6|20|30|10|30;7|20|30|10|30;8|20|NULL|10|-1;9|30|NULL|20|-1
// expect: same: ID,A,B,C,D,E = 1|NULL|20|NULL|NULL|99;2|NULL|30|10|10|99;3|10|30|10|10|10;4|10|NULL|10|20|10;5|20|NULL|10|20|20;6|20|NULL|10|20|99;7|20|NULL|10|20|99;8|20|NULL|10|30|99;9|30|NULL|10|30|30
// expect: same: ID,A,B,C,D = 1|-5|-5|NULL|NULL;2|NULL|NULL|NULL|NULL;3|10|10|NULL|NULL;4|NULL|NULL|NULL|NULL;5|20|20|NULL|NULL;6|NULL|NULL|NULL|NULL;7|NULL|NULL|NULL|NULL;8|NULL|NULL|NULL|NULL;9|30|30|NULL|NULL
// expect: same: ID,A,B,C,D,E = 1|NULL|NULL|20|NULL|10;2|10|10|20|NULL|10;3|10|10|20|NULL|20;4|10|20|20|NULL|20;5|10|20|20|NULL|20;6|10|20|20|NULL|NULL;7|10|20|20|NULL|30;8|10|30|20|NULL|30;9|10|30|20|NULL|30
// expect: same: ID,A,B,C = 1|10|NULL|20;2|20|10|20;3|20|10|30;4|NULL|20|30;5|30|20|30;6|30|NULL|20;7|30|NULL|20;8|NULL|30|NULL;9|NULL|30|NULL
// expect: same: ID,A,B,C,D = 1|'p'|'s'|'none'|NULL;2|'p'|'s'|'none'|NULL;3|'r'|'s'|'p'|NULL;4|'r'|'s'|'p'|NULL;5|'r'|'s'|'q'|'r';6|NULL|'s'|'r'|'r';7|NULL|'s'|'r'|'r';8|'s'|'s'|'r'|'r';9|'s'|'s'|'r'|'r'
// expect: same: ID,A,B = 1|10|10;2|10|10;3|20|20;4|20|20;5|20|NULL;6|20|30;7|30|30;8|30|30;9|30|NULL
// expect: same: ID,A,B = 1|NULL|NULL;2|NULL|10;3|10|10;4|10|10;5|20|10;6|NULL|NULL;7|NULL|NULL;8|NULL|30;9|30|30
// expect: same: K,X,A,B = 'a'|NULL|NULL|NULL;'a'|10|10|30;'b'|NULL|NULL|NULL;'b'|20|20|30;'b'|NULL|NULL|NULL;'a'|NULL|NULL|NULL;'a'|NULL|NULL|NULL;'c'|30|30|30;'c'|NULL|NULL|NULL
// expect: same: G,N,SA,SB,SC,SD,CE,SF = 0|428|10534|9842|10522|10502|424|6885;1|429|10469|10606|10509|10440|425|7007;2|429|10583|11335|10395|10622|424|7109;3|429|10568|10153|10474|10601|425|6932;4|429|10492|9928|10531|10377|423|6879;5|428|10587|11102|10359|10514|424|7082;6|428|10550|10761|10351|10585|423|7003
// expect: same: ID,K,A,B = 5|NULL|NULL|NULL;10|NULL|5|NULL;11|'k2'|NULL|NULL;12|'k0'|NULL|NULL;1500|NULL|10|5;2995|NULL|10|10;2996|'k2'|11|NULL;3000|NULL|45|10
// expect: same: ID,A,B = 
