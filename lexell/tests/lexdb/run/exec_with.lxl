// expect: select c.name, s.total from c join (select cust, sum(amount) total from o group by cust) s on s.cust = c.id order by c.name -> ann|12.50; bob|3.00; cy|9.99
// expect: explain select c.name, s.total from c join (select cust, sum(amount) total from o group by cust) s on s.cust = c.id -> scan c: full scan; join s: hash on (cust) over rows of subquery 1; subquery 1 (from): run once;   scan o: full scan;   aggregate
// expect: select c.name, s.n from c left join (select cust, count(*) n from o where status = 'paid' group by cust) s on s.cust = c.id order by c.id -> ann|1; bob|1; cy|NULL; dee|NULL; eve|NULL
// expect: select count(*) from (select distinct city from c) d -> 4
// expect: select max(n) from (select count(*) n from o group by status) g -> 4
// expect: select * from (select 1 as one, 'x' as two) z -> 1|x
