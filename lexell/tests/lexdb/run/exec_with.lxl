// expect: with recursive r(n) as (select 1 union all select e.b from edge e join r on e.a = r.n) select count(*) from r -> 54001 recursive query still adding rows after 1000 rounds (max_recursion); SET max_recursion = n to allow more, 0 for no limit
// expect: set max_recursion = 10 -> SET
// expect: with recursive t(n) as (select 1 union all select n + 1 from t where n < 20) select count(*) from t -> 54001 recursive query still adding rows after 10 rounds (max_recursion); SET max_recursion = n to allow more, 0 for no limit
// expect: with recursive t(n) as (select 1 union all select n + 1 from t where n < 11) select count(*) from t -> 11
// expect: set max_recursion to 0 -> SET
// expect: with recursive t(n) as (select 1 union all select n + 1 from t where n < 2000) select count(*) from t -> 2000
// expect: reset max_recursion -> RESET
// expect: with recursive t(n) as (select 1 union all select n + 1 from t where n < 2000) select count(*) from t -> 54001 recursive query still adding rows after 1000 rounds (max_recursion); SET max_recursion = n to allow more, 0 for no limit
// expect: with recursive t(n) as (select 1 union all select n + 1 from t where n < 5) select count(*) from t a, t b -> 25
// expect: with recursive r as (select * from r union select 1) select * from r -> 42P19 recursive reference to query "r" must not appear within its non-recursive term
// expect: with recursive r(n) as (select n from r) select * from r -> 42P19 recursive query does not have the form non-recursive-term UNION [ALL] recursive-term
// expect: with recursive r(n) as (select 1 union all select n + 1 from r where n < (select max(n) from r)) select * from r -> 42P19 recursive reference to query "r" must not appear within a subquery
// expect: with recursive r(n) as (select 1 intersect select n from r) select * from r -> 42P19 recursive query does not have the form non-recursive-term UNION [ALL] recursive-term
// expect: select c.name, t.amount from c, lateral (select amount from o where o.cust = c.id order by amount desc limit 1) t order by c.name -> ann|7.50; bob|3.00; cy|9.99
// expect: select c.name, t.amount from c left join lateral (select amount from o where o.cust = c.id order by amount desc limit 1) t on true order by c.id -> ann|7.50; bob|3.00; cy|9.99; dee|NULL; eve|NULL
// expect: select c.id, t.n, t.s from c cross join lateral (select count(*) as n, sum(amount) as s from o where o.cust = c.id) t order by c.id -> 1|2|12.50; 2|1|3.00; 3|1|9.99; 4|0|NULL; 5|0|NULL
// expect: explain analyze select c.id, t.n from c, lateral (select count(*) n from o where o.cust = c.id) t -> scan c: full scan (rows read 5, kept 5); cross join t: rows of subquery 1, run per row (lookups 5, rows read 5, joined 5); subquery 1 (from): per row, on c.id (runs 5, from cache 0);   scan o: full scan (rows read 30, kept 4, batches 5);   aggregate; result: 5 rows
// expect: select c.id, x.v from c join lateral (select c.id * 10 as v union all select c.id * 100) x on x.v > 30 order by 1, 2 -> 1|100; 2|200; 3|300; 4|40; 4|400; 5|50; 5|500
// expect: select o.id, l.name from o, lateral (select name from c where c.id = o.cust) l order by o.id -> 10|ann; 11|ann; 12|bob; 13|cy
// expect: select count(*) from o, lateral (select name from c where c.city = (select city from c c2 where c2.id = o.cust)) l -> 7
// expect: select id from c where exists (select 1 from (select cust from o where o.cust = c.id) s) order by 1 -> 1; 2; 3
// expect: select c.id, (select max(v) from (select amount as v from o where o.cust = c.id) z) from c order by 1 -> 1|7.50; 2|3.00; 3|9.99; 4|NULL; 5|NULL
// expect: select c.id from c join (select cust from o) s on s.cust = c.id and c.id < (select 2) order by 1 -> 1; 1
// expect: select * from c, (select o.id from o where o.cust = c.id) t -> 42P01 missing FROM-clause entry for table "c"
// expect: select * from c right join lateral (select o.id from o where o.cust = c.id) t on true -> 42P10 a LATERAL subquery cannot be the right side of a RIGHT or FULL JOIN
// expect: select * from lateral c -> 0A000 LATERAL is supported before a subquery or a function only
// expect: explain analyze select c.name, s.total from c join (select cust, sum(amount) total from o group by cust) s on s.cust = c.id -> scan c: full scan (rows read 5, kept 5); join s: hash on (cust) over rows of subquery 1 (table rows 4 of 5 read, probes 5, rows read 3, joined 3); subquery 1 (from): run once (runs 1, from cache 0);   scan o: full scan (rows read 6, kept 6);   aggregate; result: 3 rows
// expect: update c set city = 'lyon' where id in (select cust from (select cust from o where status = 'open') t) -> UPDATE 2
// expect: delete from o where exists (select 1 from (select id from c where city = 'lyon') l where l.id = o.cust) -> DELETE 3
