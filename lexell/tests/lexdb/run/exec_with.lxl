// expect: select id, name from c union select 1 -> 42601 each UNION query must have the same number of columns
// expect: select id from c union select cust from o order by id + 1 -> 42P10 invalid UNION ORDER BY clause: name or number an output column
// expect: explain analyze with x as (select id from c where city = 'paris') select a.id, b.id from x a join x b on b.id >= a.id order by 1, 2 -> scan a: rows of subquery 1 (rows read 2, kept 2); join b: loop over rows of subquery 2 (table rows 2 of 2 read, probes 2, rows read 4, joined 3); order: sort; subquery 1 (from): run once (runs 1, from cache 0);   scan c: full scan (rows read 5, kept 2); subquery 2 (from): run once (runs 0, from cache 1);   scan c: full scan; result: 3 rows
// expect: with recursive t(n) as (select 1 union all select n + 1 from t where n < 5) select n from t -> 1; 2; 3; 4; 5
// expect: with recursive t(n) as (select 1 union all select n + 1 from t where n < 100) select count(*), sum(n) from t -> 100|5050
// expect: create table emp (id int primary key, boss int, name text) -> CREATE TABLE
// expect: insert into emp values (1, null, 'root'), (2, 1, 'a'), (3, 1, 'b'), (4, 2, 'c'), (5, 4, 'd'), (6, 99, 'orphan') -> INSERT 0 6
// expect: with recursive sub(id, lvl) as (select id, 0 from emp where id = 1 union all select e.id, s.lvl + 1 from emp e join sub s on e.boss = s.id) select id, lvl from sub order by id -> 1|0; 2|1; 3|1; 4|2; 5|3
// expect: with recursive up(id, boss) as (select id, boss from emp where id = 5 union all select e.id, e.boss from up join emp e on e.id = up.boss) select id from up -> 5; 4; 2; 1
// expect: explain analyze with recursive sub(id) as (select id from emp where id = 1 union all select e.id from emp e join sub s on e.boss = s.id) select count(*) from sub -> scan sub: rows of subquery 1 (rows read 5, kept 5); aggregate; subquery 1 (from): run once (runs 1, from cache 0);   recursive union all;     first (runs 1):;       scan emp: primary key lookup (rows read 1, kept 1);     then, per round, over the working table (runs 4):;       scan emp e: full scan (rows read 24, kept 24);       join s: hash on (id) over rows of the working table (table rows 5 of 5 read, probes 24, rows read 4, joined 4); result: 1 rows
// expect: create table edge (a int primary key, b int) -> CREATE TABLE
// expect: insert into edge values (1, 2), (2, 3), (3, 1) -> INSERT 0 3
