// expect: select * from (c join o on o.cust = c.id) -> 0A000 parenthesized joins are not supported
// expect: select * from c x(a) -> 0A000 column aliases for a table are not supported
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"
fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            let out = sql + " -> " + (if len(lines) == 0 { r.tag } else { strings.join(&lines, "; ") })
            let k = strings.indexOf(out, " rows in ", 0)      // EXPLAIN ANALYZE's time varies
            println(if k >= 0 { out[0..k] + " rows" } else { out })
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}
fn main() {
    lexdb_store.run(lexdb_disk.sim(1), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st)
        show(mut &s, "create table c (id int primary key, name text, city text)")
        show(mut &s, "create table o (id int primary key, cust int, amount numeric(8,2), status text)")
        show(mut &s, "insert into c values (1,'ann','paris'),(2,'bob','rome'),(3,'cy','paris'),(4,'dee',null),(5,'eve','oslo')")
        show(mut &s, "insert into o values (10,1,5.00,'paid'),(11,1,7.50,'open'),(12,2,3.00,'paid'),(13,3,9.99,'open'),(14,null,1.00,'paid'),(15,9,2.00,'paid')")
        show(mut &s, "select * from (select id, name from c where city = 'paris') p order by id")
        show(mut &s, "select x.n, x.total from (select cust as n, sum(amount) as total from o group by cust) x where x.total > 3 order by x.n")
        show(mut &s, "select t.a, t.b from (select id, name from c) as t(a, b) where t.a < 3 order by 1")
        show(mut &s, "select c.name, s.total from c join (select cust, sum(amount) total from o group by cust) s on s.cust = c.id order by c.name")
        show(mut &s, "explain select c.name, s.total from c join (select cust, sum(amount) total from o group by cust) s on s.cust = c.id")
        show(mut &s, "select c.name, s.n from c left join (select cust, count(*) n from o where status = 'paid' group by cust) s on s.cust = c.id order by c.id")
        show(mut &s, "select count(*) from (select distinct city from c) d")
        show(mut &s, "select max(n) from (select count(*) n from o group by status) g")
        show(mut &s, "select * from (select 1 as one, 'x' as two) z")
        show(mut &s, "select * from (select id from c order by id desc limit 2) t order by id")
        show(mut &s, "select s.cust from (select cust from o) s right join c on c.id = s.cust where c.id > 3 order by c.id")
        show(mut &s, "select q.id from (select id from c) q where q.id in (select cust from o) order by 1")
        show(mut &s, "select (select count(*) from (select id from o where amount > 4) big)")
        show(mut &s, "select id from c where exists (select 1 from (select cust from o) s where s.cust = c.id) order by 1")
        show(mut &s, "select * from (select id from c) t, (select id from o where id < 12) u order by 1, 2")
        show(mut &s, "with p as (select id, name from c where city = 'paris') select name from p order by name")
        show(mut &s, "with p as (select id from c where city = 'paris'), q as (select cust from o where cust in (select id from p)) select count(*) from q")
        show(mut &s, "with t(a, b) as (select id, name from c) select b from t where a = 2")
        show(mut &s, "with totals as (select cust, sum(amount) as total from o group by cust) select c.name, t.total from c join totals t on t.cust = c.id where t.total = (select max(total) from totals)")
        show(mut &s, "explain with totals as (select cust, sum(amount) as total from o group by cust) select c.name, t.total from c join totals t on t.cust = c.id where t.total = (select max(total) from totals)")
        show(mut &s, "with c as (select 42 as id) select id from c")
        show(mut &s, "with x as (select 1 as v) select * from (with x as (select 2 as v) select v from x) inner_q, x")
        show(mut &s, "with a as (select 1 as v), b as (select v + 1 as v from a) select v from b")
        show(mut &s, "with b as (select v from a), a as (select 1 as v) select * from b")
        show(mut &s, "with recursive r as (select 1) select * from r")
        show(mut &s, "with x as (select 1 as v), x as (select 2 as v) select * from x")
        show(mut &s, "with x as (select 1 as v) create table z (id int primary key)")
        show(mut &s, "select id from c where id in (with w as (select cust from o where status = 'open') select cust from w) order by 1")
        show(mut &s, "with w as (select cust from o where status = 'open') select id from c where exists (select 1 from w where w.cust = c.id) order by 1")
        show(mut &s, "with w as (select id, city from c) select city, count(*) from w group by city order by city")
        show(mut &s, "with w as (select id, city from c) select city, max(id) from w group by city having count(*) > 1")
        show(mut &s, "select id from c where city = 'paris' union select cust from o order by 1")
        show(mut &s, "select count(*) from (select id from c union all select cust from o) u")
        show(mut &s, "select id from c intersect select cust from o order by 1")
        show(mut &s, "select id from c except select cust from o order by 1")
        show(mut &s, "select cust from o intersect select id from c order by 1")
        show(mut &s, "select cust from o except select id from c where id > 2 order by 1")
        show(mut &s, "select cust from o intersect all select cust from o where status = 'paid' order by 1")
        show(mut &s, "select cust from o except all select cust from o where status = 'paid' order by 1")
        show(mut &s, "select 1 union select 2 intersect select 3")
        show(mut &s, "select 2 union select 2.0")
        show(mut &s, "select null union select null")
        show(mut &s, "select id as k from c union select cust from o order by k desc limit 2")
        show(mut &s, "select 0 union all (select id from c order by id desc limit 1)")
        show(mut &s, "select name from c where id in (select 1 union select 3) order by 1")
        show(mut &s, "select max(x) from (select 1 as x union all select 5) t")
        show(mut &s, "select id from c where exists (select 1 from o where o.cust = c.id union all select 1 where c.city = 'oslo') order by 1")
        show(mut &s, "explain select id from c union all select cust from o where status = 'open'")
        show(mut &s, "select id, name from c union select 1")
        show(mut &s, "select id from c union select cust from o order by id + 1")
        show(mut &s, "explain analyze with x as (select id from c where city = 'paris') select a.id, b.id from x a join x b on b.id >= a.id order by 1, 2")
        show(mut &s, "with recursive t(n) as (select 1 union all select n + 1 from t where n < 5) select n from t")
        show(mut &s, "with recursive t(n) as (select 1 union all select n + 1 from t where n < 100) select count(*), sum(n) from t")
        show(mut &s, "create table emp (id int primary key, boss int, name text)")
        show(mut &s, "insert into emp values (1, null, 'root'), (2, 1, 'a'), (3, 1, 'b'), (4, 2, 'c'), (5, 4, 'd'), (6, 99, 'orphan')")
        show(mut &s, "with recursive sub(id, lvl) as (select id, 0 from emp where id = 1 union all select e.id, s.lvl + 1 from emp e join sub s on e.boss = s.id) select id, lvl from sub order by id")
        show(mut &s, "with recursive up(id, boss) as (select id, boss from emp where id = 5 union all select e.id, e.boss from up join emp e on e.id = up.boss) select id from up")
        show(mut &s, "explain analyze with recursive sub(id) as (select id from emp where id = 1 union all select e.id from emp e join sub s on e.boss = s.id) select count(*) from sub")
        show(mut &s, "create table edge (a int primary key, b int)")
        show(mut &s, "insert into edge values (1, 2), (2, 3), (3, 1)")
        show(mut &s, "with recursive r(n) as (select 1 union select e.b from edge e join r on e.a = r.n) select n from r order by n")
        show(mut &s, "with recursive r(n) as (select 1 union all select e.b from edge e join r on e.a = r.n) select count(*) from r")
        show(mut &s, "set max_recursion = 10")
        show(mut &s, "with recursive t(n) as (select 1 union all select n + 1 from t where n < 20) select count(*) from t")
        show(mut &s, "with recursive t(n) as (select 1 union all select n + 1 from t where n < 11) select count(*) from t")
        show(mut &s, "set max_recursion to 0")
        show(mut &s, "with recursive t(n) as (select 1 union all select n + 1 from t where n < 2000) select count(*) from t")
        show(mut &s, "reset max_recursion")
        show(mut &s, "with recursive t(n) as (select 1 union all select n + 1 from t where n < 2000) select count(*) from t")
        show(mut &s, "with recursive t(n) as (select 1 union all select n + 1 from t where n < 5) select count(*) from t a, t b")
        show(mut &s, "with recursive r as (select * from r union select 1) select * from r")
        show(mut &s, "with recursive r(n) as (select n from r) select * from r")
        show(mut &s, "with recursive r(n) as (select 1 union all select n + 1 from r where n < (select max(n) from r)) select * from r")
        show(mut &s, "with recursive r(n) as (select 1 intersect select n from r) select * from r")
        show(mut &s, "select c.name, t.amount from c, lateral (select amount from o where o.cust = c.id order by amount desc limit 1) t order by c.name")
        show(mut &s, "select c.name, t.amount from c left join lateral (select amount from o where o.cust = c.id order by amount desc limit 1) t on true order by c.id")
        show(mut &s, "select c.id, t.n, t.s from c cross join lateral (select count(*) as n, sum(amount) as s from o where o.cust = c.id) t order by c.id")
        show(mut &s, "explain analyze select c.id, t.n from c, lateral (select count(*) n from o where o.cust = c.id) t")
        show(mut &s, "select c.id, x.v from c join lateral (select c.id * 10 as v union all select c.id * 100) x on x.v > 30 order by 1, 2")
        show(mut &s, "select o.id, l.name from o, lateral (select name from c where c.id = o.cust) l order by o.id")
        show(mut &s, "select count(*) from o, lateral (select name from c where c.city = (select city from c c2 where c2.id = o.cust)) l")
        show(mut &s, "select id from c where exists (select 1 from (select cust from o where o.cust = c.id) s) order by 1")
        show(mut &s, "select c.id, (select max(v) from (select amount as v from o where o.cust = c.id) z) from c order by 1")
        show(mut &s, "select c.id from c join (select cust from o) s on s.cust = c.id and c.id < (select 2) order by 1")
        show(mut &s, "select * from c, (select o.id from o where o.cust = c.id) t")
        show(mut &s, "select * from c right join lateral (select o.id from o where o.cust = c.id) t on true")
        show(mut &s, "select * from lateral c")
        show(mut &s, "explain analyze select c.name, s.total from c join (select cust, sum(amount) total from o group by cust) s on s.cust = c.id")
        show(mut &s, "update c set city = 'lyon' where id in (select cust from (select cust from o where status = 'open') t)")
        show(mut &s, "delete from o where exists (select 1 from (select id from c where city = 'lyon') l where l.id = o.cust)")
        show(mut &s, "select id, city from c order by id")
        show(mut &s, "select id from o order by id")
        show(mut &s, "select * from (select id from c)")
        show(mut &s, "select * from (select id from c) t(a, b)")
        show(mut &s, "select * from (select x from c) t")
        show(mut &s, "select id from c where exists (select 1 from (select cust from o where o.cust = c.id) s)")
        show(mut &s, "select * from (c join o on o.cust = c.id)")
        show(mut &s, "select * from c x(a)")
        return 0
    }).unwrap()
}
