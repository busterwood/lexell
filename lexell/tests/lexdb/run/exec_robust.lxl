// lexdb_exec: wrong answers of the PostgreSQL door the user documentation found (KNOWN-ISSUES.md, robustness slice): an UPDATE's and
// DELETE's subqueries (in SET, WHERE and RETURNING, correlated, a self join, a derived table) reading the rows as the statement found them,
// not as its own earlier rows left them, a LANGUAGE sql function's column named as the function, INTERVAL(p) with no fields after the string
// and INTERVAL YEAR '1' a syntax error. Checked against PostgreSQL 19 (generated by tests/lexdb/gen_pg.py from robust_queries.txt). Each
// answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off and on (an "@once"
// one once, an "@tx" one in a transaction rolled back).
// expect: CREATE TABLE
// expect: INSERT 0 4
// expect: same: id|salary: 2|101;3|201;4|301
// expect: same: id|salary: 1|100;2|101;3|201;4|301
// expect: same: id|salary: 1|103;2|202;3|301;4|400
// expect: same: id|salary: 1|400;2|400;3|400;4|300
// expect: same: id|salary|c: 2|100|1;3|200|1;4|300|1
// expect: same: id|salary: 1|100;2|101;3|201;4|301
// expect: same: id: 1;2;3
// expect: same: id|c: 2|4;3|4;4|4
// expect: same: id|salary: 1|100;2|101;3|201;4|301
// expect: same: id|salary: 1|;2|200;3|300;4|400
// expect: same: ERROR 22012
// expect: same: id|salary: 1|100;2|200;4|400;13|300
// expect: same: ERROR 23505
// expect: CREATE FUNCTION
// expect: CREATE FUNCTION
// expect: CREATE FUNCTION
// expect: same: twice: 4
// expect: same: twice|?column?|nm: 4|7|a
// expect: same: t|plus1: 4|2
// expect: same: abs|lower|?column?|d|int8|twice: 1|a|2|t|1|2
// expect: same: twice: 2;4
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: interval|interval|interval: 00:00:01|1 mon|1 day 02:00:00
// expect: same: interval|interval|interval: 00:00:01.123|00:00:02|00:00:01.123457
// expect: same: ERROR 22007
// expect: same: ERROR 22007
// expect: same: ERROR 22007
// expect: same: ERROR 42601
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table emp (id int primary key, mgr_id int, salary int)\n@once insert into emp values (1, null, 100), (2, 1, 200), (3, 2, 300), (4, 3, 400)\n@tx update emp e set salary = (select x.salary + 1 from emp x where x.id = e.mgr_id) where mgr_id is not null returning id, salary\n@tx update emp e set salary = (select x.salary + 1 from emp x where x.id = e.mgr_id) where mgr_id is not null; select id, salary from emp order by id\n@tx update emp e set salary = salary + (select count(*) from emp x where x.salary > e.salary); select id, salary from emp order by id\n@tx update emp e set salary = (select max(x.salary) from emp x where x.id <> e.id); select id, salary from emp order by id\n@tx update emp e set salary = (select x.salary from emp x where x.id = e.id - 1) where id > 1 returning id, salary, (select count(*) from emp y where y.salary = 100) as c\n@tx update emp e set salary = (select x.salary + 1 from emp x where x.id = e.mgr_id) from (select id from emp where mgr_id is not null) s where s.id = e.id; select id, salary from emp order by id\n@tx delete from emp e where exists (select 1 from emp x where x.mgr_id = e.id) and salary >= (select min(salary) from emp) returning id\n@tx delete from emp e where salary > 150 returning id, (select count(*) from emp y) as c\n@tx update emp set salary = (select x.salary + 1 from emp x where x.id = emp.mgr_id) where mgr_id is not null; select id, salary from emp order by id\n@tx update emp e set salary = (select x.salary + 1 from emp x where x.id = e.mgr_id) where id = 1; select id, salary from emp order by id\n@tx update emp e set salary = (select 1 / (x.salary - 200) from emp x where x.id = e.id) where id < 3 returning id, salary\n@tx update emp e set id = (select x.id + 10 from emp x where x.id = e.id) where id = 3; select id, salary from emp order by id\n@tx update emp e set id = 1 where id = 2\n@once create function twice(x int) returns int language sql as 'select x * 2'\n@once create function nm() returns text language sql as $$ select 'a' $$\n@once create function plus1(x int) returns int language sql as 'select x + 1'\nselect twice(2)\nselect twice(2), twice(3) + 1, nm()\nselect twice(2) as t, plus1(1)\nselect abs(-1), lower('A'), 1 + 1, now()::date = current_date as d, cast(1 as bigint), twice(1)::bigint\nselect twice(id) from emp order by id limit 2\nselect interval(3) '1' second\nselect interval(2) second '1'\nselect interval year '1'\nselect interval '1' second(3), interval '1' year to month, interval '1 2' day to hour\nselect interval(3) '1.123456', interval(0) '1.6', interval(6) '1.1234567'\nselect '1 2'::interval year to month\nselect cast('1 2' as interval year to month)\nselect interval '1 2 3' day to second\nselect interval '1' day(3)"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(161), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
