// expect: same: id,w: 1|37;1|370;2|74;2|407;3|111
// expect: same: id,w: 4|NULL;5|NULL;6|NULL;11|NULL;12|NULL;13|NULL;18|NULL;19|NULL;20|NULL;25|NULL;26|NULL;27|NULL
// expect: same: id,w,z: 1|37|38;1|370|371;2|74|76;2|407|409;3|111|114;3|444|447;4|148|152;4|481|485;5|185|190;5|518|523;6|222|228;6|555|561;7|333|340;7|666|673;8|37|45;8|370|378;9|74|83;9|407|416
// expect: same: id,lid,z: 1|1|38;1|10|371;2|2|76;2|11|409;3|3|114;3|12|447;4|4|152;4|13|485;5|5|190;5|14|523;6|6|228;6|15|561;7|9|340;7|18|673
// expect: same: id,uid,z: 1|1|2;2|2|4;3|3|6;4|4|8;5|5|10;6|6|12;7|7|7;8|8|9;9|9|2;10|10|4;11|11|6;12|12|8;14|14|5;15|15|7;16|16|9;17|17|11;18|18|4;19|19|6
// expect: same: id,w,c: 1|37|'c1';2|74|'c2';3|111|'c3';4|148|'c0';5|185|'c1';6|222|'c2';7|333|'c1';8|37|'c1';9|74|'c2';10|111|'c3';11|148|'c0';12|185|'c1';13|222|'c2';14|333|'c1'
