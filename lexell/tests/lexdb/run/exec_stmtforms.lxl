// lexdb_exec: the audit's cheap statement forms in the PostgreSQL door (design/lexdb-new-features.md P23, P7): VALUES as a
// CTE's body (with and without a column list, NULLs, ORDER BY and LIMIT in it, joined, feeding an INSERT, the errors of
// its widths) and PostgreSQL 18's NOT NULL table constraints ([CONSTRAINT n] NOT NULL c in CREATE TABLE and ALTER TABLE ...
// ADD, 42703, 42601 for two names). Checked against PostgreSQL 18 (generated by tests/lexdb/gen_pg.py from
// stmtforms_queries.txt). Each answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE; each
// statement runs with lexdb_batch off and on, an "@tx" one in a transaction rolled back each time.
// expect: CREATE TABLE
// expect: INSERT 0 3000
// expect: same: x|y: 1|a;2|b
// expect: same: column1|column2: 2|b;1|a
// expect: same: c|n|s: 3|2|4
// expect: same: z: 10;20
// expect: same: x: 
// expect: same: k|w|n: k1|10|486;k2|20|486;|30|0
// expect: same: x: 2
// expect: same: ERROR 42601
// expect: same: x|column2: 1|a
// expect: same: ERROR 42P10
// expect: same: id|k: 5001|n;5002|m
// expect: same: x: 7
// expect: CREATE TABLE
// expect: same: ERROR 23502
// expect: same: ERROR 23502
// expect: same: a|b: 1|x
// expect: same: attname|attnotnull: a|t;b|t
// expect: same: ERROR 42703
// expect: same: ERROR 42601
// expect: CREATE TABLE
// expect: ALTER TABLE
// expect: ALTER TABLE
// expect: same: ERROR 23502
// expect: same: ERROR 23502
// expect: same: attname|attnotnull: a|t;b|t
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table vt (id int primary key, k text, v int)\n@once insert into vt select i, case when i % 37 = 0 then null else 'k' || (i % 6) end, i % 50 from generate_series(1, 3000) i\nwith v (x, y) as (values (1, 'a'), (2, 'b')) select * from v\nwith v as (values (1, 'a'), (2, 'b')) select * from v order by column1 desc\nwith v (x) as (values (1), (null), (3)) select count(*) c, count(x) n, sum(x) s from v\nwith v (x, y) as (values (1, 'a'), (2, 'b')), w (z) as (select x * 10 from v) select * from w order by z\nwith v (x) as (values (1), (2)) select x from v where x > 5\nwith v (k, w) as (values ('k1', 10), ('k2', 20), (null, 30)) select v.k, v.w, count(vt.id) n from v left join vt on vt.k = v.k group by v.k, v.w order by v.k\nwith v (x) as (values (1), (2) order by 1 desc limit 1) select * from v\nwith v (x, y) as (values (1, 'a'), (2)) select * from v\nwith v (x) as (values (1, 'a')) select * from v\nwith v (x, y, z) as (values (1, 'a')) select * from v\n@tx insert into vt (id, k) with v (a, b) as (values (5001, 'n'), (5002, 'm')) select a, b from v returning id, k\nselect * from (with v (x) as (values (7)) select x from v) s\n@once create table nn1 (a int, b text, constraint nn1_b_nn not null b, not null a)\n@tx insert into nn1 values (1, null)\n@tx insert into nn1 values (null, 'x')\n@tx insert into nn1 values (1, 'x') returning a, b\nselect attname, attnotnull from pg_attribute where attrelid = 'nn1'::regclass and attnum > 0 order by attnum\ncreate table nn3 (a int, constraint c1 not null nosuch)\ncreate table nn3 (a int, constraint c1 not null a, constraint c2 not null a)\n@once create table nn4 (a int, b int)\n@once alter table nn4 add constraint y not null a\n@once alter table nn4 add not null b\n@tx insert into nn4 values (null, 1)\n@tx insert into nn4 values (1, null)\nselect attname, attnotnull from pg_attribute where attrelid = 'nn4'::regclass and attnum > 0 order by attnum"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(143), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
