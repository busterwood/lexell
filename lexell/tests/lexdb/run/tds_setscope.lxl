// lexdb over TDS: a SET in sp_executesql, EXEC of a string or a procedure lasts to its end, checked against SQL Server 2022
// (generated by tests/lexdb/gen_mssql.py setscope from mssql_setscope_queries.txt; design/lexdb-tds.md, "As built: SET
// options of a scope"): FMTONLY (mssql-jdbc's "sp_executesql N'SET FMTONLY ON SELECT * FROM [t] '" before a bulk copy, no OFF),
// NOCOUNT, ROWCOUNT, QUOTED_IDENTIFIER, IDENTITY_INSERT, IMPLICIT_TRANSACTIONS and XACT_ABORT, in dynamic SQL and in procedures.
// Each batch runs against lexdb with SET lexdb_batch = off and on: "same: " and the answer, or DIFFERENT and both.
// expect: ok
// expect: (2)
// expect: ok
// expect: (1)
// expect: same: id,v: 
// expect: same: n: 2
// expect: same: id,v:  / n: 2
// expect: same: id,v:  / n: 2
// expect: same: id,v:  / n: 2
// expect: same: inner_n: 2 / n: 2
// expect: same: id,v:  / n: 2
// expect: same: (1)
// expect: same: ok
// expect: same: v: 1;2
// expect: same: v: 1
// expect: same: error 207
// expect: same: error 544
// expect: (1) / tc: 0
// expect: (1)
// expect: error 2627
// expect: tc: 1
// expect: ok
// expect: same: id,v:  / n: 2
// expect: ok
// expect: same: (1)
// expect: ok
// expect: same: error 544
// expect: ok
// expect: (1) / tc: 0
// expect: (1)
// expect: same: n: 2
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once create table fq (id int identity primary key, v int)\n@once insert into fq (v) values (1), (2)\n@once create table fx (id int primary key)\n@once insert into fx values (1)\nsp_executesql N'SET FMTONLY ON SELECT * FROM [fq] '\nselect count(*) as n from fq\nexec sp_executesql N'SET FMTONLY ON SELECT * FROM [fq] '; select count(*) as n from fq\nexec ('set fmtonly on select * from fq'); select count(*) as n from fq\nexec sp_executesql N'set fmtonly on select * from fq set fmtonly off'; select count(*) as n from fq\nexec sp_executesql N'select count(*) as inner_n from fq set fmtonly on'; select count(*) as n from fq\nset fmtonly on; select * from fq; set fmtonly off; select count(*) as n from fq\nexec sp_executesql N'set nocount on'; update fq set v = v where id = 1\nexec sp_executesql N'set nocount on; update fq set v = v where id = 1'\nexec sp_executesql N'set rowcount 1'; select v from fq order by v\nexec sp_executesql N'set rowcount 1; select v from fq order by v'\nexec sp_executesql N'set quoted_identifier off'; select \"a\" as x\nexec sp_executesql N'set identity_insert fq on'; insert into fq (id, v) values (100, 5)\n@once exec sp_executesql N'set implicit_transactions on'; insert into fx values (5); select @@trancount as tc\n@once delete from fx where id = 5\n@once exec sp_executesql N'set xact_abort on'; begin tran; insert into fx values (1)\n@once select @@trancount as tc; if @@trancount > 0 rollback\n@once create procedure p_fmt as begin set fmtonly on; select * from fq end\nexec p_fmt; select count(*) as n from fq\n@once create procedure p_nc as set nocount on\nexec p_nc; update fq set v = v where id = 1\n@once create procedure p_ii as set identity_insert fq on\nexec p_ii; insert into fq (id, v) values (101, 5)\n@once create procedure p_it as set implicit_transactions on\n@once exec p_it; insert into fx values (6); select @@trancount as tc\n@once delete from fx where id = 6\nselect count(*) as n from fq"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(52), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
