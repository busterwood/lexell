nselect distinct on (grouping(a)) grouping(a), a, sum(c) from g group by rollup(a) order by grouping(a), sum(c) desc\nselect a, (select count(*) from g g2 where g2.a = g.a) from g group by rollup(a) order by 1\nselect b, count(*) from g group by 1, rollup(a) order by 1, 2\nselect pg_typeof(grouping(a)), grouping(a) from g group by a order by a limit 1\nselect 'x', name from emp where id = 1 union all (select distinct on (boss) 'b', name from emp where boss is not null order by boss, name desc) order by 1, 2\nwith d as (select distinct on (dept) dept, sal from emp order by dept, sal) select * from d order by sal, dept\ncreate view dv as select distinct on (dept) dept, name from emp order by dept, name desc fetch first 3 rows with ties\nselect * from dv order by dept\nselect exists (select distinct on (dept) dept from emp order by dept), (select distinct on (dept) name from emp where dept = 'hr' order by dept)\nselect (select distinct on (dept) name from emp order by dept)\nselect dept from emp where (dept, sal) in (select distinct on (dept) dept, sal from emp order by dept, sal desc) order by dept\nselect count(*) filter (where name similar to '%(a|e)%'), count(*) filter (where name like any (array['%n', '%y'])) from emp\nselect dept, count(*) from emp where sal between symmetric 100 and 80 group by rollup(dept) order by dept nulls last fetch first 2 rows with ties\nselect k, grouping(k), count(*) from ct group by rollup(k) order by 1\nselect k from ct where k in (select t from ct where t is not null) order by k\nselect k, k in (select t from ct c2 where c2.v = c1.v), v in (select t from ct) from ct c1 order by k"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(94), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
