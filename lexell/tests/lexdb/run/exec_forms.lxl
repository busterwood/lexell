const QUERIES = "create table emp (id int primary key, dept text, name text, sal int, boss int)\ninsert into emp values (1, 'eng', 'ann', 100, null), (2, 'eng', 'bob', 90, 1), (3, 'ops', 'cat', 80, 1), (4, 'ops', 'dan', 80, 3), (5, 'eng', 'eve', 90, 1), (6, null, 'fay', 70, null), (7, 'hr', 'gus', null, 6)\nselect id, percent_rank() over (order by sal), cume_dist() over (order by sal), pg_typeof(percent_rank() over ()), pg_typeof(cume_dist() over ()) from emp order by id\nselect dept, percent_rank() over (partition by dept order by sal desc) * 3, cume_dist() over (partition by dept order by sal) from emp where dept is not null order by dept, id\nvacuum\nvacuum emp\nvacuum full emp\nvacuum full freeze verbose analyze emp\nvacuum (verbose false, analyze, skip_locked true, index_cleanup auto) emp (sal, name)\nvacuum analyze emp\nvacuum emp, public.emp\nvacuum nosuch\nvacuum emp, nosuch\nvacuum emp (sal)\nvacuum analyze emp (nosuch)\nvacuum (nosuchopt) emp\nvacuum (full, parallel 2) emp\nanalyze\nanalyze emp\nanalyse emp\nanalyze verbose emp (sal, dept)\nanalyze (skip_locked) emp\nanalyze emp (sal, sal)\nanalyze nosuch\nanalyze (full) emp\nvacuum only emp\ncheckpoint\ncreate index emp_sal on emp (sal)\nreindex table emp\nreindex index emp_sal\nreindex (verbose) index emp_sal\nreindex index nosuch\nreindex table nosuch\nreindex schema public\nreindex schema nosuch\nreindex system\nreindex database\nreindex system concurrently\ncluster emp using emp_sal\ncluster (verbose) emp using emp_pkey\ncluster verbose emp using emp_sal\ncluster emp using nosuch\ncluster nosuch\ncluster nosuch using emp_sal\ncluster\ncreate view emp_v as select * from emp\nvacuum emp_v\nanalyze emp_v\nreindex table emp_v\ncluster emp_v\nbegin\nanalyze emp\ncheckpoint\nreindex table emp\ncluster emp using emp_sal\nvacuum emp\nrollback\nbegin\nreindex table concurrently emp\nrollback\nbegin\nreindex database\nrollback\nbegin\ncluster\nrollback\nbegin\nvacuum\nrollback\nreindex table concurrently emp\nselect 2 between symmetric 3 and 1, 2 between 3 and 1, 2 not between symmetric 3 and 1, 2 between asymmetric 1 and 3, 4 not between asymmetric 1 and 3\nselect null between symmetric 1 and 2, 1 between symmetric null and 1, 5 between symmetric null and 1, 0 not between symmetric null and 1, 'b' between symmetric 'c' and 'a'\nselect id from emp where sal between symmetric 95 and 80 order by id\nselect id from emp where sal not between symmetric 95 and 80 order by id\nselect id from emp where id between symmetric 5 and 3 and dept = 'ops' order by id\nselect 'abc' like any (array['a%', 'x%']), 'abc' like all (array['a%', 'x%']), 'abc' like all (array['a%', '%c']), 'abc' not like any (array['a%', 'x%']), 'abc' not like all (array['a%', 'x%']), 'ABC' ilike any (array['a%']), 'ABC' not ilike all (array['a%'])\nselect 'abc' like any (array['x%', null]), 'abc' like any (array['a%', null]), 'abc' like all (array['a%', null]), 'abc' like all (array['x%', null]), null like any (array['a']), 'a' like any ('{}'::text[]), 'a' like all ('{}'::text[]), 'a' like any (null::text[])\nselect 'abc' like some (array['a%']), 'a_c' like any (array['a\\_c']), 'abc' like any ('{a%,b%}'), 'a%' like any (array['a\\%'])\nselect name from emp where name like any (array['a%', '%y', 'g_s']) order by name\nselect name from emp where name not like all (array['a%', '%y', 'g_s']) order by name\nselect name from emp where name ilike any (select upper(left(name, 1)) || '%' from emp where dept = 'ops') order by name\nselect 'abc' like all (select unnest(array['a%', '%c'])), 'abc' like all (select unnest(array['a%', 'b%'])), 'abc' like any (select 'x' where false)\nselect id from emp where sal > all (select sal from emp where dept = 'ops') order by id\nselect id from emp where sal < any (select sal from emp where dept = 'ops') order by id\nselect id, sal >= all (select sal from emp e2 where e2.dept = emp.dept) from emp where dept is not null order by id\nselect 'abc' similar to 'a%', 'abc' similar to 'b%', 'abc' not similar to '(a|b)c?%', 'a.c' similar to 'a.c', 'abc' similar to 'a.c', 'aaa' similar to 'a{2,3}', 'a+' similar to 'a#+' escape '#', 'ab' similar to '[a-b]*', 'a' similar to null, 'abc' similar to '%(b|d)%', 'a_b' similar to 'a\\_b', 'ab' similar to 'a_'\nselect 'x' similar to 'x' escape '', 'x\\y' similar to 'x\\y' escape '', 'a$' similar to 'a$', 'a^' similar to 'a^', '(' similar to '\\(', 'abc' similar to 'a(b|c)*', 'a' similar to '', '' similar to '', 'abc' similar to '%', 'aBc' similar to '%b%'\nselect E'a\\nb' similar to 'a_b', 'a1' similar to 'a\\d', 'a]' similar to 'a[]]', 'a-' similar to 'a[^a-z]', '%' similar to '!%' escape '!', 'xy' similar to '(x|y)+', 'abab' similar to '(ab){2}', 'é' similar to '_', 'aé' similar to 'a[é]'\nselect 'ab' similar to 'a' escape 'xx'\nselect name from emp where name similar to '(a|b|c)%' order by name\nselect name from emp where name not similar to '%(n|y)' order by name\nselect substring('foobar' similar '%#\"o_b#\"%' escape '#'), substring('foobar' similar '#\"o_b#\"%' escape '#'), substring('foobar' from '%#\"o_b#\"%' for '#'), substring('foobar' similar 'f%' escape '#'), substring('foobar' similar 'f#\"%' escape '#')\nselect substring('foobar' similar '%#\"o%#\"b%' escape '#'), substring('foobar' similar '%#\"o%#\"%' escape '#'), substring('abcabc' similar '%#\"b%#\"%' escape '#'), substring('abcabc' similar '%#\"b_#\"%' escape '#'), substring(null similar 'a' escape '#'), pg_typeof(substring('a' similar 'a' escape '#'))\nselect substring('foobar' similar '%#\"o_b#\"%#\"%' escape '#')\nselect substring(name similar '_#\"_#\"%' escape '#') from emp order by id\nselect distinct on (dept) dept, name, sal from emp order by dept, sal desc, name\nselect distinct on (dept) dept, name from emp order by dept desc nulls last, name\nselect distinct on (dept) dept, name from emp order by sal\nselect distinct on (dept) name from emp order by dept, sal, id\nselect distinct on (1) dept, name from emp order by 1, name desc\nsele