// expect: jdbc getTables: TABLE_CAT,TABLE_SCHEM,TABLE_NAME,TABLE_TYPE = NULL|'APP'|'DEPT'|'TABLE';NULL|'APP'|'EMP'|'TABLE';NULL|'APP'|'IDT'|'TABLE';NULL|'APP'|'TYS'|'TABLE';NULL|'APP'|'EMP_V'|'VIEW'
