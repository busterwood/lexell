// expect: jdbc getPrimaryKeys: TABLE_CAT,TABLE_SCHEM,TABLE_NAME,COLUMN_NAME,KEY_SEQ,PK_NAME = NULL|'APP'|'EMP'|'EMPNO'|1|'EMP_PK'
