// expect: jdbc getIndexInfo: TABLE_SCHEM,TABLE_NAME,INDEX_NAME,UNIQUENESS,COLUMN_NAME,COLUMN_POSITION = 'APP'|'EMP'|'EMP_ENAME_UQ'|'UNIQUE'|'ENAME'|1;'APP'|'EMP'|'EMP_HIRED_IX'|'UNIQUE'|'HIRED'|1;'APP'|'EMP'|'EMP_JOB_IX'|'NONUNIQUE'|'JOB'|1;'APP'|'EMP'|'EMP_JOB_IX'|'NONUNIQUE'|'MGR'|2;'APP'|'EMP'|'EMP_PK'|'UNIQUE'|'EMPNO'|1
// expect: jdbc getTables outer: TABLE_SCHEM,TABLE_NAME,TABLE_TYPE,REMARKS = 'APP'|'EMP'|'TABLE'|NULL;'APP'|'EMP_V'|'VIEW'|NULL
// expect: jdbc getColumns outer: TABLE_SCHEM,TABLE_NAME,COLUMN_NAME,DATA_TYPE,REMARKS = 'APP'|'DEPT'|'DEPTNO'|'NUMBER'|NULL;'APP'|'DEPT'|'DNAME'|'VARCHAR2'|NULL;'APP'|'DEPT'|'LOC'|'VARCHAR2'|NULL
// expect: outer join no match: COLUMN_NAME,CONSTRAINT_NAME = 'ID'|NULL;'V'|NULL
// expect: outer join filter kept: N = 1
// expect: jdbc outer join: TABLE_NAME,COMMENTS = 'DEPT'|NULL;'EMP'|NULL;'IDT'|NULL;'TYS'|NULL
// expect: join object and tables: OBJECT_NAME,TABLESPACE_NAME = 'DEPT'|'USERS';'EMP'|'USERS';'IDT'|'USERS';'TYS'|'USERS'
