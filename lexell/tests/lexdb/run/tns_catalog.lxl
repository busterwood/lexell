import "task"
import "net"
import "strings"
import "oracle"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows.
fn q(c: mut &oracle.Conn, label: &str, sql: &str) {
    match c.query(sql.toStr(), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            println(label + ": " + strings.join(&names, ",") + " = " + strings.join(&rs, ";"))
        }
        Err(e) { println(label + ": error " + e.code.toStr()) }
    }
}

// A statement: its row count, or error and the number.
fn x(c: mut &oracle.Conn, label: &str, sql: &str) {
    match c.run(sql.toStr(), &[]) {
        Ok(n) { println(label + ": " + n.toStr()) }
        Err(e) { println(label + ": error " + e.code.toStr()) }
    }
}

fn connect(s: &str): oracle.Conn {
    match oracle.connect(s.toStr()) {
        Ok(c) { return c }
        Err(e) {
            println("connect: error " + e.code.toStr() + " " + e.msg)
            exit(1)
        }
    }
}

fn client(port: &str) {
    var c = connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb"))
    x(mut &c, "create dept", "create table dept (deptno number(4) constraint dept_pk primary key, dname varchar2(30) not null, loc varchar2(20))")
    x(mut &c, "create emp", "create table emp (empno number(6) not null, ename varchar2(50) not null, job varchar2(20) default 'CLERK', sal number(8,2), comm number, hired date, mgr number(6), deptno number(4), constraint emp_pk primary key (empno), constraint emp_dept_fk foreign key (deptno) references dept (deptno) on delete cascade, constraint emp_sal_ck check (sal > 0), constraint emp_ename_uq unique (ename))")
    x(mut &c, "create index", "create index emp_job_ix on emp (job, mgr)")
    x(mut &c, "create unique index", "create unique index emp_hired_ix on emp (hired)")
    x(mut &c, "create sequence", "create sequence emp_seq start with 100 increment by 5 nocache")
    x(mut &c, "create view", "create view emp_v as select empno, ename from emp where sal > 100")
    x(mut &c, "create identity", "create table idt (id number generated always as identity, v varchar2(10))")
    x(mut &c, "create types", "create table tys (a varchar2(10), b char(4), c number, d number(10), e number(10,2), f integer, g date, h timestamp, i clob, j blob, k binary_double, l timestamp(3), m number(5,0))")
    q(mut &c, "user", "select user as u from dual")
    q(mut &c, "sys_context", "select sys_context('USERENV', 'CURRENT_SCHEMA') as cs, sys_context('USERENV', 'SESSION_USER') as su, sys_context('USERENV', 'CON_NAME') as cn, sys_context('USERENV', 'ISDBA') as isdba from dual")
    q(mut &c, "sys_context sid", "select count(*) as n from v$session where sid = sys_context('USERENV', 'SID')")
    q(mut &c, "sys_context lower", "select sys_context('userenv', 'current_schema') as cs from dual")
    q(mut &c, "v$version shape", "select * from v$version where 1 = 0")
    q(mut &c, "v$version rows", "select count(*) as n from v$version")
    q(mut &c, "v$instance shape", "select * from v$instance where 1 = 0")
    q(mut &c, "v$instance rows", "select count(*) as n from v$instance")
    q(mut &c, "v$database shape", "select * from v$database where 1 = 0")
    q(mut &c, "v$session shape", "select * from v$session where 1 = 0")
    q(mut &c, "v$session mine", "select username, schemaname, status, type, server from v$session where sid = sys_context('USERENV', 'SID')")
    q(mut &c, "v$parameter shape", "select * from v$parameter where 1 = 0")
    q(mut &c, "v$parameter", "select name, value from v$parameter where name in ('db_block_size', 'nls_language', 'nls_territory', 'processes', 'open_cursors') order by name")
    q(mut &c, "v$nls_parameters", "select parameter, value from v$nls_parameters where parameter in ('NLS_CHARACTERSET', 'NLS_DATE_FORMAT', 'NLS_LANGUAGE', 'NLS_NCHAR_CHARACTERSET') order by parameter")
    q(mut &c, "nls_session_parameters", "select * from nls_session_parameters order by parameter")
    q(mut &c, "nls_database_parameters", "select * from nls_database_parameters order by parameter")
    q(mut &c, "nls_instance_parameters shape", "select * from nls_instance_parameters where 1 = 0")
    q(mut &c, "product_component_version shape", "select * from product_component_version where 1 = 0")
    q(mut &c, "database_properties", "select property_name, property_value from database_properties where property_name in ('NLS_CHARACTERSET', 'DEFAULT_PERMANENT_TABLESPACE', 'DBTIMEZONE', 'GLOBAL_DB_NAME') order by property_name")
    q(mut &c, "user_tables shape", "select * from user_tables where 1 = 0")
    q(mut &c, "user_tables", "select table_name, tablespace_name, status, temporary, partitioned, iot_type, has_identity from user_tables order by table_name")
    q(mut &c, "all_tables", "select owner, table_name from all_tables where owner = 'APP' order by table_name")
    q(mut &c, "all_tables sys", "select owner, table_name from sys.all_tables where owner = 'APP' and table_name like 'D%' order by table_name")
    q(mut &c, "tabs synonym", "select table_name from tabs order by table_name")
    q(mut &c, "dba_tables shape", "select owner, table_name from dba_tables where 1 = 0")
    q(mut &c, "user_tab_columns shape", "select * from user_tab_columns where 1 = 0")
    q(mut &c, "user_tab_columns", "select table_name, column_name, data_type, data_length, data_precision, data_scale, nullable, column_id from user_tab_columns where table_name in ('DEPT', 'EMP', 'IDT') order by table_name, column_id")
    q(mut &c, "user_tab_columns types", "select column_name, data_type, data_length, data_precision, data_scale, nullable, char_length from user_tab_columns where table_name = 'TYS' order by column_id")
    q(mut &c, "user_tab_columns default", "select column_name, data_default, default_length, identity_column from user_tab_columns where table_name = 'EMP' and data_default is not null order by column_name")
    q(mut &c, "all_tab_columns", "select owner, table_name, column_name from all_tab_columns where owner = 'APP' and table_name = 'DEPT' order by column_id")
    q(mut &c, "user_tab_cols", "select table_name, column_name, hidden_column, virtual_column from user_tab_cols where table_name = 'DEPT' order by internal_column_id")
    q(mut &c, "cols synonym", "select table_name, column_name from cols where table_name = 'DEPT' order by column_id")
    q(mut &c, "user_indexes shape", "select * from user_indexes where 1 = 0")
    q(mut &c, "user_indexes", "select index_name, index_type, uniqueness, table_name, table_owner, status from user_indexes where table_name in ('DEPT', 'EMP') and index_name not like 'SYS\\_%' escape '\\' order by index_name")
    q(mut &c, "user_ind_columns shape", "select * from user_ind_columns where 1 = 0")
    q(mut &c, "user_ind_columns", "select index_name, table_name, column_name, column_position, descend from user_ind_columns where table_name = 'EMP' order by index_name, column_position")
    q(mut &c, "all_ind_columns", "select index_owner, index_name, column_name from all_ind_columns where index_owner = 'APP' and table_name = 'EMP' and index_name = 'EMP_JOB_IX' order by column_position")
    q(mut &c, "user_constraints shape", "select * from user_constraints where 1 = 0")
    q(mut &c, "user_constraints", "select constraint_name, constraint_type, table_name, r_constraint_name, delete_rule, status, deferrable, deferred, validated from user_constraints where table_name = 'EMP' and constraint_name like 'EMP\\_%' escape '\\' order by constraint_name")
    q(mut &c, "user_constraints check", "select constraint_name, search_condition_vc, generated from user_constraints where constraint_type = 'C' and constraint_name = 'EMP_SAL_CK'")
    q(mut &c, "user_constraints index", "select constraint_name, index_name from user_constraints where constraint_type in ('P', 'U') and table_name = 'EMP' order by constraint_name")
    q(mut &c, "user_cons_columns shape", "select * from user_cons_columns where 1 = 0")
    q(mut &c, "user_cons_columns", "select constraint_name, table_name, column_name, position from user_cons_columns where constraint_name in ('EMP_PK', 'EMP_DEPT_FK', 'EMP_ENAME_UQ') order by constraint_name, position")
    q(mut &c, "all_constraints", "select owner, constraint_name, constraint_type from all_constraints where owner = 'APP' and constraint_name in ('EMP_PK', 'EMP_DEPT_FK') order by constraint_name")
    q(mut &c, "user_objects shape", "select * from user_objects where 1 = 0")
    q(mut &c, "user_objects", "select object_name, object_type, status, temporary, generated from user_objects where object_name not like 'ISEQ$$%' and object_name not like 'SYS\\_%' escape '\\' order by object_type, object_name")
    q(mut &c, "all_objects", "select owner, object_name, object_type from all_objects where owner = 'APP' and object_type in ('TABLE', 'VIEW', 'SEQUENCE') and object_name not like 'ISEQ$$%' order by object_type, object_name")
    q(mut &c, "user_sequences shape", "select * from user_sequences where 1 = 0")
    q(mut &c, "user_sequences", "select sequence_name, min_value, increment_by, cycle_flag, order_flag, cache_size, last_number from user_sequences where sequence_name = 'EMP_SEQ'")
    q(mut &c, "user_views shape", "select * from user_views where 1 = 0")
    q(mut &c, "user_views", "select view_name, text_length from user_views order by view_name")
    q(mut &c, "user_catalog", "select table_name, table_type from user_catalog where table_name not like 'ISEQ$$%' order by table_name")
    q(mut &c, "user_tab_comments", "select table_name, table_type, comments from user_tab_comments order by table_name")
    q(mut &c, "user_col_comments", "select table_name, column_name, comments from user_col_comments where table_name = 'DEPT' order by column_name")
    q(mut &c, "user_tab_identity_cols", "select table_name, column_name, generation_type from user_tab_identity_cols")
    q(mut &c, "all_users shape", "select * from all_users where 1 = 0")
    q(mut &c, "all_users", "select username from all_users where username in ('APP', 'SYS', 'SYSTEM') order by username")
    q(mut &c, "user_users", "select username, account_status, default_tablespace, temporary_tablespace from user_users")
    q(mut &c, "user_synonyms", "select count(*) as n from user_synonyms")
    q(mut &c, "all_synonyms shape", "select * from all_synonyms where 1 = 0")
    q(mut &c, "user_source shape", "select * from user_source where 1 = 0")
    q(mut &c, "all_source", "select count(*) as n from all_source where owner = 'APP'")
    q(mut &c, "all_procedures", "select count(*) as n from all_procedures where owner = 'APP'")
    q(mut &c, "all_arguments shape", "select * from all_arguments where 1 = 0")
    q(mut &c, "all_triggers shape", "select * from all_triggers where 1 = 0")
    q(mut &c, "user_triggers", "select count(*) as n from user_triggers")
    q(mut &c, "all_db_links shape", "select * from all_db_links where 1 = 0")
    q(mut &c, "all_mviews", "select count(*) as n from all_mviews where owner = 'APP'")
    q(mut &c, "user_recyclebin", "select count(*) as n from user_recyclebin")
    q(mut &c, "all_editions", "select * from all_editions")
    q(mut &c, "user_tablespaces", "select tablespace_name, status, contents from user_tablespaces order by tablespace_name")
    q(mut &c, "dictionary shape", "select * from dictionary where 1 = 0")
    q(mut &c, "dictionary", "select table_name from dictionary where table_name in ('USER_TABLES', 'ALL_TAB_COLUMNS', 'V$VERSION', 'NLS_SESSION_PARAMETERS') order by table_name")
    q(mut &c, "dict synonym", "select count(*) as n from dict where table_name = 'USER_OBJECTS'")
    q(mut &c, "session_privs", "select count(*) as n from session_privs where privilege = 'CREATE SESSION'")
    q(mut &c, "jdbc getTables", "select null as table_cat, o.owner as table_schem, o.object_name as table_name, o.object_type as table_type from all_objects o where o.owner like 'APP' escape '/' and o.object_name like '%' escape '/' and o.object_type in ('TABLE', 'VIEW') order by table_type, table_schem, table_name")
    q(mut &c, "jdbc getColumns", "select t.owner as table_schem, t.table_name, t.column_name, t.data_type, t.nullable, t.column_id, t.data_default from all_tab_columns t where t.owner like 'APP' escape '/' and t.table_name like 'EMP' escape '/' order by t.owner, t.table_name, t.column_id")
    q(mut &c, "jdbc getPrimaryKeys", "select null as table_cat, c.owner as table_schem, c.table_name, c.column_name, c.position as key_seq, c.constraint_name as pk_name from all_cons_columns c, all_constraints k where k.constraint_type = 'P' and k.table_name = 'EMP' and k.owner like 'APP' escape '/' and k.constraint_name = c.constraint_name and k.table_name = c.table_name and k.owner = c.owner order by column_name")
    q(mut &c, "jdbc getImportedKeys", "select pk.owner as pktable_schem, pk.table_name as pktable_name, pkc.column_name as pkcolumn_name, fk.owner as fktable_schem, fk.table_name as fktable_name, fkc.column_name as fkcolumn_name, fkc.position as key_seq, fk.delete_rule, fk.constraint_name as fk_name, pk.constraint_name as pk_name from all_constraints fk, all_constraints pk, all_cons_columns fkc, all_cons_columns pkc where fk.table_name = 'EMP' and fk.owner = 'APP' and fk.constraint_type = 'R' and pk.owner = fk.r_owner and pk.constraint_name = fk.r_constraint_name and fkc.owner = fk.owner and fkc.constraint_name = fk.constraint_name and pkc.owner = pk.owner and pkc.constraint_name = pk.constraint_name and fkc.position = pkc.position order by pktable_schem, pktable_name, key_seq")
    q(mut &c, "jdbc getIndexInfo", "select i.owner as table_schem, i.table_name, i.index_name, i.uniqueness, c.column_name, c.column_position from all_indexes i, all_ind_columns c where i.table_name = 'EMP' and i.owner = 'APP' and c.index_name = i.index_name and c.index_owner = i.owner and c.table_name = i.table_name and c.table_owner = i.table_owner order by i.index_name, c.column_position")
    q(mut &c, "jdbc getTables outer", "select o.owner as table_schem, o.object_name as table_name, o.object_type as table_type, c.comments as remarks from all_objects o, all_tab_comments c where o.owner like 'APP' escape '/' and o.object_name like 'E%' escape '/' and o.object_type in ('TABLE', 'VIEW') and o.owner = c.owner (+) and o.object_name = c.table_name (+) and c.table_type (+) = o.object_type order by table_type, table_name")
    q(mut &c, "jdbc getColumns outer", "select t.owner as table_schem, t.table_name, t.column_name, t.data_type, c.comments as remarks from all_tab_columns t, all_col_comments c where t.owner like 'APP' escape '/' and t.table_name like 'DEPT' escape '/' and t.owner = c.owner (+) and t.table_name = c.table_name (+) and t.column_name = c.column_name (+) order by t.column_id")
    q(mut &c, "outer join no match", "select d.column_name, e.constraint_name from user_tables t, user_constraints e, user_tab_columns d where t.table_name = 'IDT' and d.table_name = t.table_name and e.table_name (+) = t.table_name and e.constraint_type (+) = 'P' order by 1")
    q(mut &c, "outer join filter kept", "select count(*) as n from user_tables t, user_indexes i where t.table_name in ('DEPT', 'EMP', 'IDT') and t.table_name = i.table_name (+) and i.index_name is null")
    q(mut &c, "jdbc outer join", "select t.table_name, c.comments from user_tables t left join user_tab_comments c on c.table_name = t.table_name order by t.table_name")
    q(mut &c, "join object and tables", "select o.object_name, t.tablespace_name from user_objects o join user_tables t on t.table_name = o.object_name order by o.object_name")
    q(mut &c, "missing view", "select * from user_nothing")
    q(mut &c, "sys missing view", "select * from sys.nothing_at_all")
    x(mut &c, "drop view", "drop view emp_v")
    x(mut &c, "drop emp", "drop table emp purge")
    q(mut &c, "after drop", "select table_name from user_tables order by table_name")
    q(mut &c, "constraints after drop", "select count(*) as n from user_constraints where table_name = 'EMP'")
    q(mut &c, "user_tables dept after", "select table_name from user_tab_columns where table_name = 'EMP'")
    x(mut &c, "drop types", "drop table tys purge")
    x(mut &c, "drop idt", "drop table idt purge")
    x(mut &c, "drop dept", "drop table dept purge")
    x(mut &c, "drop seq", "drop sequence emp_seq")
    c.logoff()
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
