import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once create table et (id int constraint et_pk primary key, name varchar(10) not null, u int constraint et_u unique, n int constraint et_n check (n > 0))\n@once create table ep (id int constraint ep_pk primary key)\n@once create table ec (id int constraint ec_pk primary key, p int constraint ec_fk references ep (id), k int)\n@once create unique index ec_k on ec (k)\n@once create table ep2 (a int, b int, constraint ep2_pk primary key (a, b))\n@once create table em (id int constraint em_pk primary key, x int, y int, constraint em_xy check (x < y), u varchar(5) not null default 'q')\n@once create table ec2 (id int constraint ec2_pk primary key, a int, b int, constraint ec2_fk foreign key (a, b) references ep2 (a, b))\n@once insert into et values (1, 'a', 1, 1); insert into ep values (1); insert into ec values (1, 1, 1); insert into ep2 values (1, 2); insert into em (id, x, y) values (1, 1, 5); insert into ec2 values (1, 1, 2)\ncreate table et (id int)\ncreate table ep2 (z int)\ninsert into et values (1, 'b', 2, 2)\ninsert into et values (2, 'b', 1, 2)\ninsert into ec values (2, 1, 1)\ninsert into ep2 values (1, 2)\ninsert into et values (3, null, 3, 3)\nupdate et set name = null where id = 1\nmerge em as t using (select 1 as id) as s on t.id = s.id when matched then update set u = null;\ninsert into et values (4, 'd', 4, -1)\ninsert into em (id, x, y) values (3, 9, 1)\ninsert into ec values (3, 9, 3)\nupdate ec2 set a = 5 where id = 1\ndelete from ep where id = 1\nupdate ep2 set a = 5\ndrop table nosuch\ndrop view nosuch\nselect nosuchfn(1)\nselect cast('abc' as int)\nselect cast('abc' as smallint)\nselect cast('abc' as bit)\nselect cast('abc' as bigint)\nselect cast('abc' as decimal(10,2))\nselect cast('abc' as float)\nselect cast('abc' as uniqueidentifier)\nselect convert(datetime, 'notadate')\nselect (select id from et union all select 2)\nselect 1 / 0\nselect * from nosuch\nselect nosuchcol from et\n@lines select 1 as a\\n\\nselect * from et where\n@lines select 1 as a\\nselect * FROM from et\n@lines select 1 +\n@lines declare @x int\\nselect @x = 1\\nselect 1 / 0\n@lines select 1 as a\\n\\n\\nselect * from nosuch2\n@lines declare @a int = 1\\ninsert into et values (1, 'z', 9, 9)\n@lines declare @a int = 1\\n\\nupdate et\\n  set name = null\\n  where id = 1\n@lines begin try\\n  select 1 as a\\n  insert into et values (1, 'z', 9, 9)\\nend try\\nbegin catch\\n  select error_number() as n, error_line() as l, error_message() as m\\nend catch\n@lines begin try\\n  select 1 / 0 as a\\nend try\\nbegin catch\\n  select error_line() as l\\nend catch\\n\\nselect 1 / 0\n@lines if 1 = 1\\nbegin\\n  select 1 as a\\n  select 1 / 0\\nend\n@lines exec sp_executesql N'select 1 as a\\nselect 1/0'\n@lines \\n\\nselect 1/0"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = true   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(53), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
