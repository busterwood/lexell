// expect: skip past last row: 1|2 3|4 5|6 7|8
// expect: skip to first: 1|3 2|4 3|5 4|6 5|7 6|8
// expect: skip to last: 1|4 4|8
// expect: skip to subset: 1|3 3|5 5|7
// expect: skip unbounded: 22000
// expect: skip same start: 22000
// expect: show empty: 1|1|0 2|2|1 3|2|2 4|3|0 5|4|1
// expect: unmatched: 1|NULL|NULL 2|1|a 3|1|a 4|NULL|NULL 5|2|a
// expect: skip to next row overlaps: 1|1 2|1 2|2 3|2 3|3 4|3
// expect: order desc: 3|2 5|4 8|7
// expect: null partition: x|1 NULL|3
// expect: order nulls first: 4|8
// expect: order nulls last: 5|8
// expect: two partition columns: a|0|2 a|1|3 b|0|2 b|1|1
// expect: subquery: 5
// expect: cte: 3
// expect: view: 3
// expect: join: 1|5 6|3
// expect: lateral: a|3 a|1 b|1
// expect: lateral partition by outer: a|ax|3 a|ax|1 b|bx|1
// expect: lateral order by outer: a|3 a|1 b|1
// expect: lateral all rows: a|1|a a|2|a a|3|a a|5|a b|7|a
// expect: lateral no outer reference: a|3 a|1 a|1 b|3 b|1 b|1
// expect: lateral left join: a|3 a|1 b|1
