// expect: (2) / a,b,n,c: 20|'l1'|1|'dd ';21|'l2'|2|'dd '
// expect: (2) / a,b,n,c: 20|'l1'|1|'dd ';21|'l2'|2|'dd ';20|'U'|3|'dd ';21|'U'|4|'dd '
// expect: (2) / a,b,n,c: 20|'l1'|1|'dd ';21|'l2'|2|'dd ';20|'U'|3|'dd ';21|'U'|4|'dd ';20|'U'|5|'dd ';21|'U'|6|'dd '
// expect: error 213
// expect: error 213
// expect: error 121
// expect: error 120
// expect: (1) / a,b: 31|'q'
// expect: error 2627
// expect: (1) / : 1
// expect: error 245
// expect: error 2628
// expect: error 213
// expect: error 208
// expect: error 1087
// expect: (1) / a: 60
// expect: (3) / act,a,b: 'UPDATE'|1|'V';'UPDATE'|2|'V';'UPDATE'|60|'m'
// expect: (4) / act,a,b: 'DELETE'|1|NULL;'DELETE'|31|NULL;'DELETE'|40|NULL;'DELETE'|60|NULL
// expect: error 2627
// expect: error 2627
// expect: (2) / a: 200;201
// expect: error 2627
// expect: error 515
// expect: (1) / a,b: 1|'x'
// expect: : 1 / (1) / a: 71
// expect: (1) / (1) / a: 72
// expect: (1) / a,b: 80|'x'
// expect: (2) / a: 302;303
