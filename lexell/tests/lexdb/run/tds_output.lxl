import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "create table t(a int primary key, b varchar(10)); insert into t values (1,'x'),(2,'y'),(3,'z'); create table log(a int, b varchar(10), n int identity(1,1), c char(3) default 'dd')\ndeclare @x table (a int, b varchar(10)); insert t output inserted.a, inserted.b into @x values (8,'q'),(9,'r'); select * from @x\ndeclare @x table (a int, b varchar(10)); insert t output inserted.* into @x values (10,'q'); select * from @x\ndeclare @x table (a int, b varchar(10)); insert t output inserted.a, inserted.b into @x select a + 100, b from t where a < 3; select * from @x order by a\ndeclare @x table (a int, b varchar(10)); delete t output deleted.a, deleted.b into @x where a >= 9; select * from @x order by a\ndeclare @x table (a int, b varchar(10)); update t set b = 'W' output deleted.a, inserted.b into @x where a = 1; select * from @x\ndeclare @x table (o varchar(10), n varchar(10)); update t set b = 'V' output deleted.b, inserted.b into @x where a <= 2; select * from @x order by o\ndeclare @x table (a int, b varchar(10)); delete t output deleted.* into @x where a > 100; select * from @x order by a\ndeclare @x table (n int, a int); update t set b = 'u' output inserted.a + 1000, inserted.a into @x where a = 3; select * from @x\ndeclare @x table (a int, b varchar(10)); delete t output deleted.a, deleted.b into @x where a = 999; select count(*) from @x\ninsert t output inserted.a, inserted.b into log (a, b) values (20,'l1'),(21,'l2'); select * from log\nupdate t set b = 'U' output inserted.a, inserted.b into log (a, b) where a >= 20; select a,b,n,c from log\ndelete t output deleted.a, deleted.b into log (a, b) where a >= 20; select a,b,n,c from log\ndeclare @x table (a int, b varchar(10), c int); insert t output inserted.a, inserted.b into @x values (30,'q')\ndeclare @x table (a int); insert t output inserted.a, inserted.b into @x values (30,'q')\ndeclare @x table (a int, b varchar(10)); insert t output inserted.a, inserted.b into @x (a) values (30,'q')\ndeclare @x table (a int, b varchar(10)); insert t output inserted.a into @x (a, b) values (30,'q')\ndeclare @x table (a int, b varchar(10)); insert t output inserted.b, inserted.a into @x (b, a) values (31, 'q'); select * from @x\ndeclare @x table (a int primary key, b varchar(10)); insert t output 1, 'a' into @x select a+100, 'k' from t; select * from @x; select count(*) from t\ndeclare @x table (a int, b varchar(10)); insert t output inserted.a, inserted.b into @x values (40,'q'); select @@rowcount\ndeclare @x table (a varchar(10), b int); insert t output inserted.a, inserted.b into @x values (42,'q')\ndeclare @x table (a int, b varchar(2)); insert t output inserted.a, inserted.b into @x values (43,'qqqqq')\ninsert t output inserted.a into t values (50,'a')\ninsert t output inserted.a into nosuch values (50,'a')\ninsert t output inserted.a into @undeclared values (50,'a')\ndeclare @x table (a int); merge t using (values (60)) s(k) on t.a = s.k when not matched then insert values (60, 'm') output inserted.a into @x; select * from @x\ndeclare @x table (act varchar(10), a int, b varchar(10)); merge t using (values (1),(60),(2)) s(k) on t.a = s.k when matched then update set b='M' when not matched then insert values (k, 'n') output $action, inserted.a, deleted.b into @x; select * from @x order by a\ndeclare @x table (act varchar(10), a int, b int); merge t using (values (1),(61)) s(k) on t.a = s.k when matched then delete when not matched by source and t.a > 10 then delete output $action, deleted.a, inserted.a into @x; select * from @x order by 1,2\ncreate table dst(a int primary key); insert into dst values (200); insert t output inserted.a into dst values (200,'x'); select count(*) from t where a = 200\ncreate table dst2(a int primary key); insert into dst2 values (200); begin tran; insert t output inserted.a into dst2 values (201,'x'),(200,'y'); rollback; select count(*) from t where a >= 200\ncreate table dst3(a int primary key); insert t output inserted.a into dst3 values (200,'x'),(201,'y'); select * from dst3\nbegin tran; delete t output deleted.a into dst3 where a >= 200; select count(*) from dst3; rollback; select count(*) from dst3, t where t.a >= 200\ndeclare @x table (a int); insert t output inserted.a into @x default values\ndeclare @x table (a int identity(1,1), b varchar(10)); insert t output inserted.b into @x (b) values (70,'x'); select * from @x\nselect 1; declare @x table (a int); insert t output inserted.a into @x values (71,'x'); select * from @x\ndeclare @x table (a int); insert t output inserted.a into @x values (72,'x'); declare @y table (a int); update t set b='q' output deleted.a into @y where a=72; select * from @y\ncreate table #tt(a int, b varchar(10)); insert t output inserted.a, inserted.b into #tt values (80,'x'); select * from #tt\ndeclare @x table (a int); insert t output inserted.a into @x select top 2 a + 300, b from t order by a; select * from @x order by a\ndeclare @x table (a int); update top (1) t set b = 'top' output inserted.a into @x where a < 100; select count(*) from @x\ndeclare @x table (a int, s varchar(5)); insert t output inserted.a, 'k' + inserted.b into @x values (90, 'abc'); select * from @x\ndeclare @x table (a int); delete from t output deleted.a into @x where a in (select a from t where a > 300); select * from @x order by a\ndeclare @x table (a bigint, b int); insert into t (a, b) output inserted.a, inserted.a into @x values (92, 'x'); select * from @x"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(42), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
