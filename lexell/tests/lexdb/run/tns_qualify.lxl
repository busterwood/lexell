const SETUP = "create table qt (id number primary key, g number, v number, tx varchar2(5))\ninsert into qt select level, mod(level, 3), case when mod(level, 5) = 0 then null else mod(level * 7, 10) end, case when mod(level, 6) = 0 then null else 'k' || mod(level, 4) end from dual connect by level <= 12\ncreate table qe (id number primary key)\ncreate table dg (i number(10))\ninsert into dg select level - 1 from dual connect by level <= 10\ncreate table qb (id number primary key, g number, k varchar2(5), x number, w number)\ninsert into qb select n, mod(n, 7), case when mod(n, 5) = 0 then null else 'k' || mod(n, 3) end, case when mod(n, 4) = 0 or mod(n, 9) = 0 then null else mod(n, 50) end, mod(n * 37, 101) from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 3000"

const QS = "select id, g, v, row_number() over (partition by g order by v, id) rn from qt qualify rn = 1 order by id\nselect id, g, v from qt qualify row_number() over (partition by g order by v, id) = 1 order by id\nselect id from qt qualify id > 10 order by id\nselect g, count(*) c from qt group by g qualify rank() over (order by count(*) desc, g) = 2 order by g\nselect g, count(*) c, rank() over (order by sum(v) desc, g) rk from qt group by g qualify rk <= 2 order by rk\nselect g, count(*) c from qt group by g qualify c > 3 order by g\nselect g, count(*) c from qt group by g qualify g > 0 order by g\nselect g from qt group by g qualify v > 0\nselect id, row_number() over (order by id) as id from qt qualify id = 1\nselect id as x, v as id from qt qualify id = 1 order by x\nselect id as v, v from qt qualify v = 1\nselect id, row_number() over (order by id) as g from qt qualify g = 1\nselect id, row_number() over (order by id) as \"Rn\" from qt qualify \"Rn\" = 1\nselect id, row_number() over (order by id) as rn from qt qualify \"RN\" = 1\nselect id, v from qt qualify v = max(v) over () order by id\nselect id, v from qt qualify v = max(v) over () and id > 3 order by id\nselect id, v from qt qualify v is null order by id\nselect distinct v, row_number() over (partition by v order by id) rn from qt qualify rn = 1 order by v\nselect v from qt qualify row_number() over (partition by v order by id) = 1 order by v\nselect distinct v from qt qualify row_number() over (partition by v order by id) = 1 order by v\nselect id, rank() over (order by v, id) rk from qt qualify rk <= 4 order by rk fetch first 3 rows only\nselect id from qt qualify row_number() over (order by id) <= 3 order by id desc\nselect id from qt where id > 2 qualify row_number() over (order by id) <= 3 order by id\nselect id from qt group by id having id > 1 qualify id < 4 order by id\nselect id from qt window w as (order by id) qualify row_number() over w <= 2 order by id\nselect id, row_number() over w rn from qt window w as (partition by g order by id) qualify rn = 2 order by id\nselect id from qt qualify id = 1 having id = 1\nselect id from qt qualify id = 1 qualify id = 1\nselect id from qt qualify row_number() over w <= 2 window w as (order by id)\nselect * from (select id, rank() over (order by v, id) rk from qt qualify rk <= 2) order by id\nselect id from qt qualify id < 3 union all select id from qt qualify id > 11 order by 1\nselect id r from qt union all select id from qt qualify r < 3\nselect id r from qt qualify r < 3 union all select id from qt where id > 10 order by 1\nselect id from qt qualify (select 1 from dual) = 1 and id < 3 order by id\nselect id from qt qualify id in (select 1 from dual union select 2 from dual) order by id\nselect id, (select count(*) from qt q2 where q2.g = qt.g) cnt from qt qualify cnt = 4 and id < 3 order by id\nselect id from qt qualify (select count(*) from qt q2 where q2.id = qt.id) = 1 and id < 3 order by id\nselect id from qt qualify exists (select 1 from qt q2 where q2.id = qt.id + 11) order by id\nselect id from qt where id in (select id from qt qualify row_number() over (order by id) <= 2) order by id\nwith c as (select id, row_number() over (order by id) rn from qt qualify rn < 3) select * from c order by id\nwith c as (select id from qt qualify id < 3) select * from c order by id\nselect id, v, rank() over (order by v, id) rk, dense_rank() over (order by v) dr from qt qualify dr <= 2 and rk > 1 order by id\nselect id, v, sum(v) over (order by id) rs from qt qualify rs > 20 order by id\nselect id, v, sum(v) over (order by id) rs from qt qualify rs > 20 order by rs desc, id desc\nselect id, v, sum(v) over (order by id) rs from qt qualify rs > 20 order by 3 desc fetch first 2 rows only\nselect id, v from qt qualify sum(v) over (order by id) > 20 order by v desc, id\nselect g, count(*) from qt group by g qualify count(*) over () = 3 order by g\nselect g, count(*) c from qt group by g qualify row_number() over (order by g) = 2\nselect g, count(*) c from qt group by g qualify row_number() over (order by c, g) = 2\nselect g from qt group by g qualify row_number() over (order by sum(v) desc, g) <= 2 order by g\nselect id from qt qualify lag(v) over (order by id) = 7 order by id\nselect id, lag(v) over (order by id) lg from qt qualify lg is null\nselect id, lag(v) over (order by id) lg from qt qualify lg is not null and id < 4 order by id\nselect id from qt qualify id between 2 and 4 order by id\nselect id, case when id = 1 then 1 end z from qt qualify z = 1\nselect id i from qt qualify i / 0 = 1\nselect id i from qt qualify 10 / (id - 6) > 0 order by id\nselect id i from qt qualify i = 1 or 1 / (id - 1) = 1 order by id\nselect id i from qt where id < 3 qualify i / (id - 2) = 1\nselect 1 x from dual qualify x = 1\nselect 1 x from dual qualify x = 2\nselect id from qe qualify row_number() over (order by id) = 1\nselect count(*) c from qt where 1 = 0 qualify c = 0\nselect count(*) c, row_number() over (order by count(*)) rn from qt where 1 = 0 qualify rn = 1\nselect sum(v) sv from qt qualify sv > 0\nselect sum(v) sv from qt qualify sv > 1000\nselect sum(v) sv, row_number() over (order by sum(v)) rn from qt qualify rn = 1\nselect id from qt qualify null\nselect id from qt qualify 1 = 1 and id = 2\nselect id from qt qualify nosuch = 1\nselect distinct g from qt qualify v > 5 order by g\nselect distinct g, row_number() over (order by g, id) rn from qt qualify rn <= 5 order by rn\nselect g from qt qualify row_number() over (partition by g order by id) = 1 order by v\nselect g from qt qualify row_number() over (partition by g order by id) = 1 order by v fetch first 2 rows only\nselect id from qt qualify row_number() over (order by id) = 1 fetch first 0 rows only\nselect id from qt qualify id > 1 order by id offset 2 rows fetch first 2 rows only\nselect g, count(*) c from qt group by g, id qualify id < 3 order by g\nselect id from qt qualify id = (select min(id) from qt)\nselect * from qt qualify row_number() over (order by id) = 2\nselect qt.* from qt qualify row_number() over (order by id) = 2\nselect * from qt q qualify q.id = 3\nselect id from qt q qualify qt.id = 3\nselect qualify.id from qt qualify where qualify.id < 3 order by qualify.id\nselect qualify.id from qt qualify order by 1 fetch first 2 rows only\nselect qualify.id from qt qualify qualify.id < 3 order by qualify.id\nselect qualify from (select 1 qualify from dual)\nselect id, tx from qt qualify row_number() over (partition by tx order by id) = 1 order by id\nselect id, count(*) over (partition by g) c from qt qualify c = 4 and id < 4 order by id\nselect count(*) n, sum(rn) sr, max(id) mx from (select id, row_number() over (partition by g order by id desc) rn from qb qualify rn <= 10)\nselect count(*) n, sum(id) si from (select id, rank() over (order by w, id) rk from qb qualify rk <= 500)\nselect g, id, rn from (select g, id, row_number() over (partition by g order by id) rn, count(*) over (partition by g) cnt from qb qualify rn = cnt) order by g\nselect id, k, x, lag(x) over (partition by k order by id) lg from qb qualify lg is null and k is not null order by id fetch first 8 rows only\nselect k, count(*) n, min(id) mi from qb group by k qualify dense_rank() over (order by k nulls first) <= 2 order by k\nselect id from qb qualify row_number() over (order by id desc) = 1\nselect id from qb qualify 100 / (3000 - id) > 0 order by id\nselect distinct k from qb qualify x > 40 order by k\nselect id, x from qb qualify x * count(x) over (partition by g) > sum(x) over (partition by g) and id <= 40 order by id"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            println("pipeline windows: " + lexdb_pipe.winRuns().toStr())
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(62), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
