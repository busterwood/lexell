// lexdb_assert (design/lexdb-new-features.md O23, section 14), in process:
// - 1,200 random statements (INSERT one row and many, UPDATE by key and by a range, DELETE, MERGE, in blocks and on their own)
//   on two tables that four assertions read (a join on a key, a correlated NOT EXISTS, ALL ... SATISFY, a self-join), each also
//   run on a copy of the tables without assertions whose four queries are then asked: the statement must fail exactly when one
//   of them finds a row, and the tables stay the copy's. Half of the statements with batches off, half on;
// - two sessions, each in a task: each adds half of a violation of the join (write skew): the second waits for the first's
//   COMMIT and then fails; two rows of different join keys: neither waits; two DELETEs each leaving the anti-join one row:
//   the second waits and fails; an assertion without a join key: the second waits, then passes after a ROLLBACK;
// - the PostgreSQL door: its writes are checked (23514), UPDATE and DELETE ... WITH (batch_rows n) of a table an assertion reads
//   checked batch by batch (they commit as they go), its CREATE ASSERTION (the standard's, pg_assert) and the T-SQL door's parsed;
// - the store reopened: the assertions there, still checked.
// expect: random: 1200 statements, 200 refused, 0 differences
// expect: skew: first INSERT 0 1, second waited then 23514, commit ROLLBACK
// expect: keys apart: both INSERT 0 1, the second committed while the first was open: 1
// expect: anti-join: first DELETE 1, second waited then 23514
// expect: no key: waited, then INSERT 0 1 after the first's ROLLBACK
// expect: locks left: 0
// expect: pg write: 23514 assertion "c_cap" is violated
// expect: pg: 23514 assertion "z" is violated by some row
// expect: pg: 42704 assertion "z" does not exist
// expect: batch_rows: UPDATE 2 DELETE 0 UPDATE 3
// expect: tsql: parsed
// expect: ora: ORA08601 Assertion (LEXDB.C_CAP) violated.
// expect: reopened: 23514, 23514, INSERT 0 1; USER_ASSERTIONS: C_CAP|C_NOVAL|C_ONE|K_X|P_KID
import "task"
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_sql"
import "../../../cmd/lexdb_parse"
import "../../../cmd/lexdb_tsqlparse"

// A statement of the PostgreSQL door: its tag, its rows ("a|b;c|d"), or its error's state.
fn one(s: mut &lexdb_exec.Session, sql: str): str {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if r.hasRows {
                var rows: []str = []
                for row in r.rows {
                    var cells: []str = []
                    for v in row { append(mut &cells, lexdb_sql.text(&v)) }
                    append(mut &rows, strings.join(&cells, "|"))
                }
                return strings.join(&rows, ";")
            }
            return r.tag.clone()
        }
        Err(e) { return e.state.clone() }
    }
}

// A statement of the Oracle dialect: its tag or rows, or its error's state and text.
fn ora(s: mut &lexdb_exec.Session, sql: &str): str {
    match lexdb_parse.oraParse(sql) {
        Ok(stmts) {
            match s.run(&stmts[0], &[], &[]) {
                Ok(r) {
                    if r.hasRows {
                        var rows: []str = []
                        for row in r.rows {
                            var cells: []str = []
                            for v in row { append(mut &cells, lexdb_sql.text(&v)) }
                            append(mut &rows, strings.join(&cells, "|"))
                        }
                        return strings.join(&rows, ";")
                    }
                    return r.tag.clone()
                }
                Err(e) { return e.state + " " + e.msg }
            }
        }
        Err(e) { return "PARSE " + e.state + " " + e.msg }
    }
}

// The four assertions' queries over tables p and c (their copies: mp, mc): a row of any is a violation.
fn violations(p: &str, c: &str): []str {
    return ["select 1 from " + c + " x, " + p + " y where x.k = y.k and y.kind = 'X' and x.qty > 10",
            "select 1 from " + p + " y where y.kind = 'B' and not exists (select 1 from " + c + " x where x.k = y.k)",
            "select 1 from " + c + " where not (qty < 1000)",
            "select 1 from " + c + " x, " + c + " z where x.k = z.k and x.id <> z.id and x.qty = 7 and z.qty = 7"]
}

type Rng = record { x: int }

fn (r: mut &Rng) next(n: int): int {
    r.x = (r.x * 1103515245 + 12345) % 2147483648
    return (r.x / 65536) % n
}

// A random statement over p and c (the copy's names put in after).
fn stmtOf(r: mut &Rng): str {
    let k = 1 + r.next(12)
    let id = 1 + r.next(60)
    let q = [0, 5, 7, 7, 11, 20, 2000][r.next(7)]
    let kinds = ["A", "X", "B", "B"]
    let kind = kinds[r.next(4)].clone()
    let w = r.next(14)
    if w == 0 { return "insert into P values (" + id.toStr() + ", " + k.toStr() + ", '" + kind + "')" }
    if w <= 3 { return "insert into C values (" + (100 + id).toStr() + ", " + k.toStr() + ", " + q.toStr() + ")" }
    if w == 4 { return "insert into C select 300 + g, " + k.toStr() + ", " + q.toStr() + " + g % 2 from generate_series(1, " + (1 + r.next(80)).toStr() + ") g" }
    if w == 5 { return "update C set qty = " + q.toStr() + " where id = " + (100 + id).toStr() }
    if w == 6 { return "update C set k = " + k.toStr() + " where id = " + (100 + id).toStr() }
    if w == 7 { return "update P set kind = '" + kind + "' where k = " + k.toStr() }
    if w == 8 { return "update C set qty = qty + 1 where k = " + k.toStr() }
    if w == 9 { return "delete from C where id = " + (100 + id).toStr() }
    if w == 10 { return "delete from C where k = " + k.toStr() }
    if w == 11 { return "delete from P where id = " + id.toStr() }
    if w == 12 { return "update C set qty = 7 where id in (" + (100 + id).toStr() + ", " + (101 + id).toStr() + ")" }
    return "insert into C values (" + (100 + id).toStr() + ", " + k.toStr() + ", " + q.toStr() + ") on conflict (id) do update set qty = excluded.qty"
}

fn names(sql: &str, p: &str, c: &str): str { return strings.replaceAll(&strings.replaceAll(sql, "P ", &(p + " ")), "C ", &(c + " ")) }

fn random(s: mut &lexdb_exec.Session) {
    for t in ["p", "mp"] { let x = one(s, "create table " + t + " (id int primary key, k int not null, kind text)") }
    for t in ["c", "mc"] { let x = one(s, "create table " + t + " (id int primary key, k int not null, qty int)") }
    for t in ["p", "mp"] { let x = one(s, "insert into " + t + " select g, g % 12 + 1, case when g % 3 = 0 then 'A' else 'B' end from generate_series(1, 30) g") }
    for t in ["c", "mc"] { let x = one(s, "insert into " + t + " select 100 + g, g % 12 + 1, g % 5 from generate_series(1, 40) g") }
    s.setDoor(&"tns")
    for a in ["create assertion k_x check (not exists (select 1 from c x, p y where x.k = y.k and y.kind = 'X' and x.qty > 10))",
              "create assertion p_kid check (not exists (select 1 from p y where y.kind = 'B' and not exists (select 1 from c x where x.k = y.k)))",
              "create assertion c_cap check (all (select qty from c) satisfy (qty < 1000))",
              "create assertion c_one check (not exists (select 1 from c x, c z where x.k = z.k and x.id <> z.id and x.qty = 7 and z.qty = 7))"] {
        let r = ora(s, a)
        if r != "CREATE ASSERTION" { println("create: " + r) }
    }
    s.setDoor(&"pg")
    var rng = Rng{x: 20261125}
    var diffs = 0
    var refused = 0
    for i in 0..1200 {
        if i % 600 == 0 { let b = one(s, if i == 0 { "set lexdb_batch = off" } else { "set lexdb_batch = on" }) }
        let sql = stmtOf(mut &rng)
        let block = rng.next(5) == 0
        // the copy: the statement, then the four queries; a row is a violation, and the statement is undone
        let m0 = one(s, "begin")
        let mres = one(s, names(&sql, &"mp", &"mc"))
        var broke = false
        let ran = strings.startsWith(&mres, "INSERT") || strings.startsWith(&mres, "UPDATE") || strings.startsWith(&mres, "DELETE")
        if ran { for v in violations(&"mp", &"mc") { if one(s, "select count(*) from (" + v + ") v") != "0" { broke = true } } }
        let mend = one(s, if broke { "rollback" } else { "commit" })
        // the tables with the assertions
        if block { let b0 = one(s, "begin") }
        let res = one(s, names(&sql, &"p", &"c"))
        if block { let b1 = one(s, if res == "23514" { "rollback" } else { "commit" }) }
        let want = if broke { "23514" } else { mres.clone() }
        if res != want {
            diffs += 1
            if diffs < 6 { println("statement " + i.toStr() + ": " + sql + ": " + res + ", the copy " + mres + (if broke { " (breaks one)" } else { "" })) }
        }
        if res == "23514" { refused += 1 }
    }
    for t in [["p", "mp"], ["c", "mc"]] {
        if one(s, "select * from " + t[0] + " order by id") != one(s, "select * from " + t[1] + " order by id") { println("tables differ: " + t[0]) }
    }
    println("random: 1200 statements, " + refused.toStr() + " refused, " + diffs.toStr() + " differences")
}

// A session's statements, run in a task: their results joined by " / ".
type Job = record { s: lexdb_exec.Session; sqls: []str }
type Done = record { s: lexdb_exec.Session; out: str }

fn runJob(j: Job): Done {
    let Job{s: s0, sqls: sqls} = move(j)
    var s = s0
    var outs: []str = []
    for q in sqls { append(mut &outs, one(mut &s, q.toStr())) }
    return Done{s: s, out: strings.join(&outs, " / ")}
}

fn pause() { let z = task.sleep(30) }

fn sessions(st: &lexdb_store.Store) {
    var a = lexdb_exec.newSession(st.share())
    var watch = lexdb_exec.newSession(st.share())
    task.scope(fn(sc: mut &task.Scope) {
        // write skew: a's X parent, b's child over 10, the same key 50
        let a0 = one(mut &a, "begin")
        let a1 = one(mut &a, "insert into p values (500, 50, 'X')")
        let fb = sc.start(runJob, Job{s: lexdb_exec.newSession(st.share()), sqls: ["begin", "insert into c values (500, 50, 20)", "commit"]})
        pause()
        let a2 = one(mut &a, "commit")
        let Done{s: b0, out: bout} = fb.wait().unwrap()
        let bs = strings.split(&bout, " / ")
        println("skew: first " + a1 + ", second waited then " + bs[1] + ", commit " + bs[2])

        // two keys apart: the second does not wait for the first
        let k0 = one(mut &a, "begin")
        let k1 = one(mut &a, "insert into p values (501, 51, 'X')")
        let fk = sc.start(runJob, Job{s: b0, sqls: ["begin", "insert into c values (501, 52, 20)", "commit"]})
        pause()
        let seen = one(mut &watch, "select count(*) from c where id = 501")
        let k2 = one(mut &a, "commit")
        let Done{s: b1, out: kout} = fk.wait().unwrap()
        println("keys apart: both " + k1 + ", the second committed while the first was open: " + seen)

        // the anti-join: B parent 60 with two children; each session deletes one
        let n0 = one(mut &a, "insert into c values (601, 60, 1), (602, 60, 1)")
        let n1 = one(mut &a, "insert into p values (600, 60, 'B')")
        let d0 = one(mut &a, "begin")
        let d1 = one(mut &a, "delete from c where id = 601")
        let fd = sc.start(runJob, Job{s: b1, sqls: ["begin", "delete from c where id = 602", "commit"]})
        pause()
        let d2 = one(mut &a, "commit")
        let Done{s: b2, out: dout} = fd.wait().unwrap()
        println("anti-join: first " + d1 + ", second waited then " + strings.split(&dout, " / ")[1])

        // no join key: two rows of qty 7 under the same key are the self-join's; under keys apart they are not
        // (the assertion's lock: the second waits for the first's end)
        a.setDoor(&"tns")
        let c0 = ora(mut &a, "create assertion c_noval check (not exists (select 1 from c x, c z where x.qty = 900 and z.qty = 901))")
        a.setDoor(&"pg")
        let e0 = one(mut &a, "begin")
        let e1 = one(mut &a, "insert into c values (700, 70, 900)")
        let fe = sc.start(runJob, Job{s: b2, sqls: ["begin", "insert into c values (701, 71, 901)", "commit"]})
        pause()
        let waiting = one(mut &watch, "select count(*) from c where id = 701")
        let e2 = one(mut &a, "rollback")
        let Done{s: b3, out: eout} = fe.wait().unwrap()
        println("no key: " + (if waiting == "0" { "waited" } else { "did not wait" }) + ", then " + strings.split(&eout, " / ")[1] + " after the first's ROLLBACK")
        let e3 = one(mut &a, "delete from c where id = 701")
        var b = b3
        b.close()
    })
    println("locks left: " + st.locks.count().toStr())
    watch.close()
    a.close()
}

fn main() {
    let fs = lexdb_disk.sim(53)
    let opts = lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 100000}
    lexdb_store.run(fs.share(), opts, fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st.share())
        random(mut &s)
        let u0 = one(mut &s, "create table u2 (id int primary key, v int); insert into u2 values (1, 1), (2, 2), (3, 3)")
        sessions(&st)
        println("pg write: " + one(mut &s, "insert into c values (800, 1, 5000)") + " " + (match s.exec(&"insert into c values (800, 1, 5000)") {
            Ok(_) { "" }
            Err(e) { e.msg.clone() }
        }))
        for x in ["create assertion z check (not exists (select 1 from c))", "drop assertion z"] { println("pg: " + one(mut &s, x.toStr()) + " " + (match s.exec(&x) {
            Ok(_) { "" }
            Err(e) { e.msg.clone() }
        })) }
        println("batch_rows: " + one(mut &s, "update c set qty = qty where k = 1 with (batch_rows 2)") + " " + one(mut &s, "delete from p where id = 1 with (batch_rows 2)") +
                " " + one(mut &s, "update u2 set v = v with (batch_rows 2)"))
        match lexdb_tsqlparse.parseBatch(&"create assertion z check (not exists (select 1 from c))", lexdb_parse.Dialect{tsql: true, quotedIdent: true}, &[]) {
            Ok(_) { println("tsql: parsed") }
            Err(e) { println("tsql: " + e.state) }
        }
        s.setDoor(&"tns")
        println("ora: " + ora(mut &s, &"insert into c values (800, 1, 5000)"))
        s.close()
        return 0
    }).unwrap()
    lexdb_store.run(fs, opts, fn(st: lexdb_store.Store): int {
        var s = lexdb_exec.newSession(st)
        let r1 = one(mut &s, "insert into c values (900, 1, 5000)")
        let r1b = one(mut &s, "begin")
        let r2 = one(mut &s, "insert into p values (900, 90, 'B')")
        let r2b = one(mut &s, "rollback")
        let r3 = one(mut &s, "insert into c values (900, 1, 5)")
        s.setDoor(&"tns")
        println("reopened: " + r1 + ", " + r2 + ", " + r3 + "; USER_ASSERTIONS: " + strings.replaceAll(&ora(mut &s, &"select assertion_name from user_assertions order by 1"), ";", "|"))
        s.close()
        return 0
    }).unwrap()
}
