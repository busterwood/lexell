import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "DECLARE @p decimal(5,2) = 10; SELECT 1 + @p / 100 AS a, @p / 100 AS b, 2 * (@p / 100) AS c, 1 + @p / 3 AS d, @p / @p AS e\nDECLARE @p decimal(5,2); SET @p = 10.456; SELECT @p AS a, 1 + @p / 100 AS b\nDECLARE @p decimal(5,2) = 10, @q int = 3; SELECT @p / @q AS a, 1 + @p / @q AS b\nDECLARE @p decimal(9,4) = 2.5; SELECT 1 + @p / 100 AS a, CAST(1 + @p / 100 AS decimal(10,4)) AS b\nDECLARE @p decimal(5,2) = 10; IF 1 + @p / 100 > 1.05 SELECT 'above' ELSE SELECT 'below'\n@once CREATE TABLE acc (id int PRIMARY KEY, salary decimal(10,2))\n@once INSERT INTO acc VALUES (1, 100), (2, 250.50)\n@once DECLARE @p decimal(5,2) = 10; UPDATE acc SET salary = salary * (1 + @p / 100) WHERE id = 1\nSELECT id, salary FROM acc ORDER BY id\n@once DECLARE @p decimal(5,2) = 3; UPDATE acc SET salary = salary * (1 + @p / 100)\nSELECT id, salary FROM acc ORDER BY id\n@once CREATE PROCEDURE dbo.raise_pct @p decimal(5,2) AS UPDATE acc SET salary = salary * (1 + @p / 100) WHERE id = 2\n@once EXEC dbo.raise_pct 10\nSELECT id, salary FROM acc ORDER BY id\nDECLARE @p decimal(5,2) = 10; SELECT salary * (1 + @p / 100) AS s FROM acc ORDER BY id\nSELECT 2147483647 + 1\nSELECT CAST(2147483647 AS int) + 1\nSELECT 2147483647 * 2\nSELECT -2147483648 - 1\nSELECT CAST(32767 AS smallint) + CAST(1 AS smallint)\nSELECT CAST(-2147483648 AS int) / -1\nSELECT 2147483648 + 1\nSELECT CAST(2147483647 AS int) + 1 AS x WHERE 1 = 0\nSELECT ABS(CAST(-2147483648 AS int))\nDECLARE @i int = 2147483647; SELECT @i + 1\nDECLARE @i int = 2147483647; SELECT @i - 1 AS ok\n@once CREATE TABLE ov (a int, b smallint)\n@once INSERT INTO ov VALUES (2147483647, 32767)\nSELECT a + 1 FROM ov\nSELECT b + 1 FROM ov\nSELECT b * 2 FROM ov\nSELECT 2147483647 + a FROM ov\nRAISERROR('fatal', 19, 1)\nRAISERROR('fatal', 20, 1)\nRAISERROR('fatal', 25, 1)\nRAISERROR('fatal', 26, 1)\nRAISERROR('logged', 19, 1) WITH LOG\nSELECT 1 AS a; RAISERROR('logged', 19, 1) WITH LOG; SELECT 2 AS b\nBEGIN TRY RAISERROR('x', 20, 1) END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_SEVERITY() AS s END CATCH\nBEGIN TRY RAISERROR('x', 19, 1) WITH LOG END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_SEVERITY() AS s END CATCH\nBEGIN TRY RAISERROR('x', 18, 1) END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_SEVERITY() AS s END CATCH\nRAISERROR('x', 5, 1) WITH SETERROR; SELECT @@ERROR AS e\nRAISERROR('x', 5, 1) WITH NOWAIT, SETERROR; SELECT @@ERROR AS e\nRAISERROR('x', 5, 1); SELECT @@ERROR AS e\nRAISERROR('x', 16, 1) WITH LOG\n@once CREATE TABLE lg (n int, m nvarchar(100))\n@lines BEGIN TRY\\n    BEGIN TRY\\n        RAISERROR('inner failure', 16, 1);\\n    END TRY\\n    BEGIN CATCH\\n        PRINT 'inner CATCH: ' + ERROR_MESSAGE();\\n        THROW;\\n    END CATCH;\\nEND TRY\\nBEGIN CATCH\\n    PRINT 'outer CATCH: ' + ERROR_MESSAGE();\\nEND CATCH;\n@lines BEGIN TRY\\n    SELECT * FROM dbo.nothere;\\nEND TRY\\nBEGIN CATCH\\n    INSERT lg VALUES (ERROR_NUMBER(), ERROR_MESSAGE());\\nEND CATCH;\nSELECT COUNT(*) AS n FROM lg\nSELECT ERROR_NUMBER() AS n, ERROR_MESSAGE() AS m\n@lines BEGIN TRY\\n    BEGIN TRY\\n        THROW 50001, 'inner', 1;\\n    END TRY\\n    BEGIN CATCH\\n        THROW;\\n    END CATCH;\\nEND TRY\\nBEGIN CATCH\\n    THROW;\\nEND CATCH;\n@lines BEGIN TRY\\n    SELECT * FROM dbo.nothere2;\\nEND TRY\\nBEGIN CATCH\\n    INSERT lg VALUES (ERROR_NUMBER(), ERROR_MESSAGE());\\nEND CATCH;\nSELECT COUNT(*) AS n FROM lg\nSELECT n, m FROM lg\n@once CREATE TABLE cl1 (id int NOT NULL, v int, CONSTRAINT pk_cl1 PRIMARY KEY CLUSTERED (id ASC) WITH (PAD_INDEX = OFF, IGNORE_DUP_KEY = OFF) ON [PRIMARY]) ON [PRIMARY]\n@once CREATE TABLE cl2 (id int NOT NULL PRIMARY KEY NONCLUSTERED, v int UNIQUE CLUSTERED)\n@once CREATE TABLE cl3 (id int PRIMARY KEY CLUSTERED, v int UNIQUE NONCLUSTERED, w int)\n@once CREATE TABLE cl4 (id int NOT NULL, v int NOT NULL, CONSTRAINT pk_cl4 PRIMARY KEY NONCLUSTERED (id), CONSTRAINT uq_cl4 UNIQUE CLUSTERED (v DESC))\n@once CREATE TABLE cl5 (id int, v int)\n@once CREATE TABLE cl6 (id int NOT NULL, CONSTRAINT pk_cl6 PRIMARY KEY (id))\n@once CREATE UNIQUE NONCLUSTERED INDEX ix_cl3_w ON cl3 (w) WITH (FILLFACTOR = 80) ON [PRIMARY]\n@once CREATE NONCLUSTERED INDEX ix_cl1_v ON cl1 (v DESC)\n@once CREATE CLUSTERED INDEX ix_cl5 ON cl5 (v)\n@once CREATE UNIQUE CLUSTERED INDEX ix_cl6 ON cl6 (id)\nCREATE CLUSTERED INDEX ix_cl1_c ON cl1 (v)\nCREATE UNIQUE CLUSTERED INDEX ix_cl2_c ON cl2 (id)\nCREATE CLUSTERED INDEX ix_cl3_c ON cl3 (v)\nCREATE CLUSTERED INDEX ix_cl5_c ON cl5 (id)\nSELECT o.name AS t, i.name AS i, i.index_id, i.type, i.type_desc, i.is_unique, i.is_primary_key, i.is_unique_constraint FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name IN ('cl1', 'cl3', 'cl4', 'cl5', 'cl6') AND i.name IN ('pk_cl1', 'ix_cl1_v', 'ix_cl3_w', 'pk_cl4', 'uq_cl4', 'ix_cl5', 'pk_cl6', 'ix_cl6') OR (o.name IN ('cl1', 'cl3', 'cl4', 'cl5', 'cl6') AND i.name IS NULL) ORDER BY o.name, i.index_id\nSELECT o.name AS t, i.type_desc, COUNT(*) AS n FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name IN ('cl2', 'cl3') GROUP BY o.name, i.type_desc ORDER BY o.name, i.type_desc\nSELECT OBJECTPROPERTY(OBJECT_ID('cl1'), 'TableHasClustIndex') AS a, OBJECTPROPERTY(OBJECT_ID('cl5'), 'TableHasClustIndex') AS b\n@once INSERT cl1 VALUES (2, 20), (1, 10)\nSELECT id, v FROM cl1 ORDER BY id\nINSERT cl1 VALUES (1, 99)\nINSERT cl2 VALUES (1, 5), (2, 5)\n@once DROP INDEX ix_cl5 ON cl5\nSELECT o.name AS t, i.index_id, i.type_desc FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name = 'cl5' ORDER BY i.index_id\n@once ALTER TABLE cl5 ADD CONSTRAINT uq_cl5 UNIQUE CLUSTERED (v)\nCREATE CLUSTERED INDEX ix_cl5_d ON cl5 (id)\n@once ALTER TABLE cl5 DROP CONSTRAINT uq_cl5\nSELECT o.name AS t, i.index_id, i.type_desc FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name = 'cl5' ORDER BY i.index_id\n@once CREATE TABLE cl7 (id int NOT NULL, v int)\n@once ALTER TABLE cl7 ADD CONSTRAINT pk_cl7 PRIMARY KEY NONCLUSTERED (id)\n@once CREATE CLUSTERED INDEX ix_cl7 ON cl7 (v)\nSELECT i.name AS i, i.index_id, i.type_desc FROM sys.indexes i WHERE i.object_id = OBJECT_ID('cl7') ORDER BY i.index_id\nDROP INDEX IF EXISTS ix_nothere ON cl7\n@once CREATE TABLE cl8 (id int NOT NULL, v int NOT NULL, w int NOT NULL, CONSTRAINT pk_cl8 PRIMARY KEY CLUSTERED (id, v DESC), CONSTRAINT uq_cl8 UNIQUE NONCLUSTERED (w ASC))\nSELECT i.name AS i, i.type_desc FROM sys.indexes i WHERE i.object_id = OBJECT_ID('cl8') ORDER BY i.index_id\nCREATE TABLE pk2 (a int PRIMARY KEY, b int PRIMARY KEY)\nCREATE TABLE pk2 (a int PRIMARY KEY, b int, PRIMARY KEY (b))\nCREATE TABLE pk2 (a int NOT NULL, b int NOT NULL, c int NOT NULL, PRIMARY KEY (a, b), CONSTRAINT x PRIMARY KEY (c))\n@once CREATE TABLE pk2 (a int NOT NULL PRIMARY KEY, b int UNIQUE)"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(54), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
