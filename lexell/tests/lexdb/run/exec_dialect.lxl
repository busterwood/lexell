// expect: 4|2
// expect: ERROR 42883
// expect: 2024-03-05 10:00:00+00|2024-03-05 08:00:00|2024-03-05 08:00:00
// expect: timestamp with time zone|timestamp without time zone
// expect: 2024-03-05 08:00:00+00|2024-03-05 08:00:00+00
// expect: t|infinity|2024-03-05 08:00:00.123456
// expect: 3 days 02:00:00|1 year 2 mons 25 days 05:06:07.5|00:00:00|00:00:01.5|-01:30:00|15 days
// expect: 2 years 2 mons|00:00:00.000001|25:00:00
// expect: ERROR 22008
// expect: interval|t|3
// expect: CREATE TABLE
// expect: INSERT 0 1025
// expect: 1025|23575|52230|30375.000000|29737.500000|0
// expect: 1025|0|1025|00:01:00|58.500000
// expect: 23|1.500000;23|36.000000;23|37.500000
// expect: 17:05:00|1025.000000
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "select system_user is null, current_user = session_user\nselect system_user as who\nselect system_user()\ncreate table audit (id int, who text default system_user, who2 text default current_user)\ninsert into audit (id) values (1)\nselect id, who is null, who2 = current_user from audit\nselect quote_ident('abc'), quote_ident('a b'), quote_ident('A'), quote_ident('a\"b'), quote_ident(''), quote_ident('select'), quote_ident('a_1'), quote_ident('1a'), quote_ident('é')\nselect quote_ident(null) is null, quote_ident('user'), quote_ident('table'), quote_ident('abc$')\nselect quote_ident()\ncreate table qt (id int primary key, v text)\ncreate view v_qt as select id, v from qt where id > 0\nselect pg_get_viewdef('qt'::regclass)\nselect pg_get_viewdef(0::oid) is null, pg_get_viewdef(null) is null\nselect pg_get_viewdef('nothing'::regclass)\ncreate sequence sq1 start 5 increment 2\nselect sequencename, start_value, min_value, max_value, increment_by, cycle, cache_size, last_value from pg_sequences where sequencename = 'sq1'\nselect nextval('sq1')\nselect last_value from pg_sequences where sequencename = 'sq1'\nselect nextval('sq1'), nextval('sq1')\nselect last_value from pg_sequences where sequencename = 'sq1'\nselect setval('sq1', 100)\nselect last_value from pg_sequences where sequencename = 'sq1'\nselect setval('sq1', 200, false)\nselect last_value from pg_sequences where sequencename = 'sq1'\nselect nextval('sq1')\nselect last_value from pg_sequences where sequencename = 'sq1'\ncreate sequence sq2 as bigint increment -3 minvalue -100 maxvalue 0 start 0 cycle\nselect last_value, data_type, cycle from pg_sequences where sequencename = 'sq2'\nselect nextval('sq2'), nextval('sq2')\nselect last_value from pg_sequences where sequencename = 'sq2'\nselect count(*), count(last_value) from pg_sequences\nselect last_value from pg_sequences where sequencename = 'nothing'\ncreate table ser (id serial primary key, x int)\ninsert into ser (x) values (1), (2), (3)\nselect sequencename, last_value from pg_sequences where sequencename = 'ser_id_seq'\nselect schemaname, sequencename, data_type, last_value from pg_sequences where sequencename in ('sq1', 'sq2') order by 1, 2\nselect extract(day from interval '3 days 4 hours'), extract(hour from interval '3 days 4 hours'), extract(minute from interval '1 hour 90 minutes'), extract(second from interval '1 minute 5.25 seconds')\nselect extract(day from interval '-3 days -4 hours'), extract(hour from interval '-3 days -4 hours'), extract(minute from interval '-1 hour -30 minutes'), extract(second from interval '-1 minute -5.25 seconds')\nselect extract(day from timestamp '2024-03-05 10:00' - timestamp '2024-03-01 07:30:15.5'), extract(hour from timestamp '2024-03-05 10:00' - timestamp '2024-03-01 07:30:15.5'), extract(minute from timestamp '2024-03-05 10:00' - timestamp '2024-03-01 07:30:15.5'), extract(second from timestamp '2024-03-05 10:00' - timestamp '2024-03-01 07:30:15.5')\nselect extract(day from timestamp '2024-03-01 07:30:15.5' - timestamp '2024-03-05 10:00'), extract(hour from timestamp '2024-03-01 07:30:15.5' - timestamp '2024-03-05 10:00'), extract(minute from timestamp '2024-03-01 07:30:15.5' - timestamp '2024-03-05 10:00'), extract(second from timestamp '2024-03-01 07:30:15.5' - timestamp '2024-03-05 10:00')\nselect extract(year from interval '2 years 14 months'), extract(month from interval '2 years 14 months'), extract(decade from interval '25 years'), extract(century from interval '250 years'), extract(millennium from interval '2500 years')\nselect extract(epoch from interval '1 day 2 hours'), extract(milliseconds from interval '1.5 seconds'), extract(microseconds from interval '1.5 seconds'), extract(quarter from interval '7 months')\nselect extract(dow from interval '1 day')\nselect extract(second from interval '59.999999 seconds'), extract(second from interval '1 hour 0.000001 seconds'), extract(minute from interval '0.5 hours')\nselect extract(hour from interval '25 hours'), extract(hour from interval '1 day 25 hours'), extract(day from interval '40 days'), extract(day from interval '1 month 40 days')\nselect date_part('hour', interval '2 days 3 hours'), date_part('day', timestamp '2024-03-05' - timestamp '2024-03-01'), date_part('minute', interval '1 hour 5 minutes')\nselect extract(hour from timestamp '2024-03-05 10:11:12') - extract(hour from interval '1 hour')\nselect extract(day from age(timestamp '2024-03-05', timestamp '2024-01-01')), extract(month from age(timestamp '2024-03-05', timestamp '2024-01-01'))\nselect extract(hour from time '10:11:12'), extract(hour from timestamptz '2024-03-05 10:00+02'), extract(day from date '2024-03-05' - date '2024-03-01') is null\nselect timestamp '2024-03-05 10:00:00' at time zone 'UTC', timestamptz '2024-03-05 10:00:00+02' at time zone 'UTC', timestamptz '2024-03-05 10:00:00+02' at time zone 'utc'\nselect pg_typeof(timestamp '2024-03-05 10:00:00' at time zone 'UTC'), pg_typeof(timestamptz '2024-03-05 10:00:00+02' at time zone 'UTC')\nselect (timestamptz '2024-03-05 10:00:00+02' at time zone 'UTC')::timestamptz, timestamptz '2024-03-05 10:00:00+02' at time zone 'UTC' at time zone 'UTC'\nselect null::timestamptz at time zone 'UTC' is null, timestamptz 'infinity' at time zone 'UTC', timestamptz '2024-03-05 10:00:00.123456+02' at time zone 'UTC'\nselect make_interval(days => 3, hours => 2), make_interval(1, 2, 3, 4, 5, 6, 7.5), make_interval(), make_interval(secs => 1.5), make_interval(mins => -90), make_interval(weeks => 2, days => 1)\nselect make_interval(years => 1, months => 14), make_interval(secs => 0.000001), make_interval(hours => 25)\nselect make_interval(days => null) is null, make_interval(secs => 'NaN'), make_interval(years => 2147483647, months => 1)\nselect pg_typeof(make_interval(days => 1)), make_interval(days => 1) = interval '1 day', extract(day from make_interval(days => 3))\ncreate table iv (id int, a timestamp, b timestamp, d interval)\ninsert into iv select g, timestamp '2024-01-01' + g * interval '1 second', timestamp '2024-01-02', make_interval(secs => g * 1.5) from generate_series(1, 1025) g\nselect count(*), sum(extract(hour from b - a)), sum(extract(minute from b - a)), sum(extract(second from b - a)), sum(extract(second from d)), sum(extract(day from b - a)) from iv\nselect count(*), count(system_user), count(*) filter (where quote_ident('a' || id::text) = 'a' || id::text), min(make_interval(mins => id)), max(extract(second from d)) from iv\nselect extract(hour from b - a), extract(second from d) from iv where id in (1, 1024, 1025) order by id\nselect make_interval(mins => id), extract(epoch from make_interval(secs => id)) from iv where id = 1025"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag.clone()) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(122), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
