// lexdb_tns, binds (design/lexdb-oracle.md, stage O2), through lib/oracle: :1 and
// :name placeholders (one value per occurrence, in order), every bind type, NULL,
// numbers beyond int and float, text where a number is wanted, a placeholder
// count that does not match (ORA-01008), RETURNING ... INTO (one row, many rows,
// none), a failed bound statement undone alone, and the output types of intervals.
// expect: binds: 1 'two' NULL 2.5 true x'0102' 12.5 '2026-11-12T01:02:03'
// expect: bind order: 'b' 'a' 'b'
// expect: bind insert, select: 2 | 7 'seven' | 8 NULL
// expect: bind in where: 'seven'
// expect: number binds: 3 1.5 0.000001 -12345678901234567890.5
// expect: text on a number: 7
// expect: not all bound: error 1008
// expect: returning: 1 row, id 3, label 'x'
// expect: returning many: 3 3 rows, ids 3 7 8
// expect: returning none: 0 rows
// expect: bound error: error 1
// expect: bound error undone: 3
// expect: interval: INTERVAL DAY TO SECOND '+000000001 02:03:04.500000000' INTERVAL YEAR TO MONTH '+000000001-02'
import "task"
import "net"
import "strings"
import "time"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

fn connect(s: &str): oracle.Conn {
    match oracle.connect(s.toStr()) {
        Ok(c) { return c }
        Err(e) {
            println("connect: error " + e.code.toStr() + " " + e.msg)
            exit(1)
        }
    }
}

fn show(r: Result[oracle.Rows, oracle.Error]): str {
    match r {
        Ok(rows) { return "ok" }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, " ")
}

fn err(r: Result[int, oracle.Error]): str {
    match r {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn q1(c: mut &oracle.Conn, sql: &str): str {
    match c.query(sql.toStr(), &[]) {
        Ok(r) {
            var out: []str = []
            for i in 0..r.rowCount() { append(mut &out, values(&r, i)) }
            return strings.join(&out, ",")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}


fn client(port: &str) {
    var c = connect(&("User Id=sa;Password=sa;Data Source=127.0.0.1:" + port + "/lexdb"))
    println("binds: " + values(&c.queryWith("select :1, :2, :3, :4, :5, :6, :7, :8 from dual",
        &[oracle.Param.Of(sqldialect.Value.Int(1)), oracle.Param.Of(sqldialect.Value.Text("two")), oracle.Param.Of(sqldialect.Value.Null),
          oracle.Param.Of(sqldialect.Value.Float(2.5f)), oracle.Param.Of(sqldialect.Value.Bool(true)),
          oracle.Param.Of(sqldialect.Value.Bytes("\x01\x02")), oracle.Param.Of(sqldialect.Value.Dec(Decimal.parse("12.50").unwrap())),
          oracle.Param.DateTime(time.LocalDateTime{date: time.Date{year: 2026, month: 11, day: 12}, time: time.timeOfDay(1, 2, 3, 0).unwrap()})]).unwrap(), 0))
    // a placeholder written twice takes two values (as python-oracledb sends them: one per occurrence)
    println("bind order: " + values(&c.query("select :1, :2, :3 from dual", &[sqldialect.Value.Text("b"), sqldialect.Value.Text("a"), sqldialect.Value.Text("b")]).unwrap(), 0))
    c.exec("create table bt (id int primary key, label text)").unwrap()
    let ins = c.run("insert into bt values (:1, :2)", &[sqldialect.Value.Int(7), sqldialect.Value.Text("seven")]).unwrap() +
              c.run("insert into bt values (:id, :label)", &[sqldialect.Value.Int(8), sqldialect.Value.Null]).unwrap()
    println("bind insert, select: " + ins.toStr() + " | " + strings.replaceAll(q1(mut &c, &"select id, label from bt order by id"), ",", " | "))
    println("bind in where: " + values(&c.query("select label from bt where id = :1", &[sqldialect.Value.Int(7)]).unwrap(), 0))
    println("number binds: " + values(&c.query("select :1 + 1, :2, :3, :4 from dual", &[sqldialect.Value.Int(2), sqldialect.Value.Float(1.5f),
        sqldialect.Value.Dec(Decimal.parse("0.000001").unwrap()), sqldialect.Value.Dec(Decimal.parse("-12345678901234567890.5").unwrap())]).unwrap(), 0))
    println("text on a number: " + values(&c.query("select id from bt where id = :1", &[sqldialect.Value.Text("7")]).unwrap(), 0))
    println("not all bound: " + show(c.query("select :1, :2 from dual", &[sqldialect.Value.Int(1)])))
    let rr = c.call("insert into bt (id, label) values (:1, 'x') returning id, label into :id, :label", &[sqldialect.Value.Int(3)],
                    &[oracle.out("id", "NUMBER"), oracle.out("label", "VARCHAR2(20)")]).unwrap()
    println("returning: " + rr.outputs.rowCount().toStr() + " row, id " + rr.outputs.int(0, 0).unwrap().toStr() + ", label " + "'" + rr.outputs.text(0, 1).unwrap() + "'")
    let rm = c.call("update bt set label = label returning id into :id", &[], &[oracle.out("id", "NUMBER")]).unwrap()
    var ids: []str = []
    for i in 0..rm.outputs.rowCount() { append(mut &ids, rm.outputs.int(i, 0).unwrap().toStr()) }
    println("returning many: " + rm.affected.toStr() + " " + rm.outputs.rowCount().toStr() + " rows, ids " + strings.join(&ids, " "))
    let rn = c.call("delete from bt where id = :1 returning id into :id", &[sqldialect.Value.Int(99)], &[oracle.out("id", "NUMBER")]).unwrap()
    println("returning none: " + rn.outputs.rowCount().toStr() + " rows")
    println("bound error: " + err(c.run("insert into bt values (:1, :2)", &[sqldialect.Value.Int(7), sqldialect.Value.Text("dup")])))
    println("bound error undone: " + q1(mut &c, &"select count(*) from bt"))
    let iv = c.query("select interval '1 day 2 hours 3 minutes 4.5 seconds' as a, interval '14 months' as b from dual", &[]).unwrap()
    println("interval: " + iv.columnTypeName(0).unwrap() + " '" + iv.text(0, 0).unwrap() + "' " + iv.columnTypeName(1).unwrap() + " '" + iv.text(0, 1).unwrap() + "'")
    c.logoff()
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
