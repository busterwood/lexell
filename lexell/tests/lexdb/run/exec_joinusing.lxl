import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table emp (id int primary key, name text, dept int)\ncreate table dept (dept int primary key, dname text)\ncreate table pay (id int primary key, amt int, name text)\ncreate table extra (code int primary key, note text, dept bigint)\ninsert into emp values (1, 'ann', 10), (2, 'bob', 20), (3, 'cy', null), (4, 'di', 30)\ninsert into dept values (10, 'eng'), (20, 'ops'), (40, 'hr')\ninsert into pay values (1, 100, 'ann'), (2, 200, 'robert'), (5, 500, 'eve')\ninsert into extra values (1, 'x', 10), (2, 'y', 40)\nselect * from emp join dept using (dept) order by id\nselect dept, name, dname from emp join dept using (dept) order by dept\nselect emp.dept, dept.dept, dept from emp join dept using (dept) order by 1\nselect * from emp left join dept using (dept) order by id\nselect * from emp right join dept using (dept) order by dept\nselect * from emp full join dept using (dept) order by dept, id\nselect dept, id from emp full join dept using (dept) order by dept nulls first, id\nselect dept, count(*) from emp full join dept using (dept) group by dept order by dept\nselect * from emp join pay using (id, name)\nselect * from emp join pay using (id) order by id\nselect id, emp.name, pay.name from emp join pay using (id) order by id\nselect name from emp join pay using (id) order by 1\nselect * from emp natural join pay\nselect * from emp natural left join pay order by id\nselect * from emp natural full join pay order by id, name\nselect * from emp natural join dept order by id\nselect count(*) from dept natural join pay\nselect * from emp join dept using (dept) join extra using (dept) order by id\nselect * from emp join dept using (dept) left join extra using (dept) order by id\nselect dept from emp join dept using (dept) where dept > 10 order by dept\nselect e.name, d.dname from emp e join dept d using (dept) where dept = 20\nselect * from emp e join dept d using (dept) order by e.id\nselect d.* from emp e join dept d using (dept) order by 1\nselect e.* from emp e join dept d using (dept) order by 1\nselect x.dept, x.dname from (select * from emp join dept using (dept)) x order by 1\ncreate view ed as select * from emp join dept using (dept)\nselect * from ed order by id\nselect * from emp join dept using (nope)\nselect * from emp join pay using (dept)\nselect * from emp join dept using (dept, dept)\nselect * from emp cross join pay join dept using (dept) order by 1, 4\nselect * from emp, pay join emp e2 using (id) where false\nselect * from pay p1 cross join pay p2 join emp using (id)\nselect * from emp join dept on true join pay using (name) order by dname\nselect dept, (select count(*) from extra where extra.dept = dept) from emp join dept using (dept) order by 1\nselect * from emp natural join extra\nupdate emp set name = upper(name) from dept join extra using (dept) where emp.dept = dept.dept\nselect id, name from emp order by id\nselect * from emp join dept using (dept) order by dept desc limit 1\nselect dept, sum(id) from emp join dept using (dept) group by 1 having dept < 30 order by 1\nselect emp.dept, dept.dept, dept from emp full join dept using (dept) order by 3, 1\ncreate table ca (k char(3), id int primary key)\ncreate table cb (k char(5), v int primary key)\ninsert into ca values ('x', 1), ('y', 2), ('z', 3)\ninsert into cb values ('x', 10), ('y  ', 20), ('w', 30)\nselect * from ca join cb using (k) order by id\nselect k, id, v from ca full join cb using (k) order by k\nselect count(*) from ca natural join cb\nselect count(*) from emp join dept using (dept)"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(93), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
