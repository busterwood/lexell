// lexdb_exec, lexdb_ops, lexdb_rows, lexdb_pipe: a timestamp that keeps its offset (Val.Tsz: Oracle's TIMESTAMP WITH TIME ZONE, design/
// lexdb-robust.md item 9), in process. A table of 2,400 rows of five offsets made by Oracle's SQL (lexdb_parse.oraParse, the Oracle
// door's own session), read by every operator: a comparison, a range, GROUP BY and DISTINCT by instant (the same instant at
// different offsets is one group), ORDER BY with a limit, a hash join and a self join, an aggregate over the fields (EXTRACT is UTC's),
// an index (by instant), NULLs, an empty result, a unique index (the same instant twice is a duplicate), a write rolled back. Each
// statement runs with batches on and off (the row engine, the reference): the same rows or the same error. Then the PostgreSQL door's
// timestamptz, which stays an instant shown in the session's zone, byte for byte as before, and an Oracle table read through it
// (its TIMESTAMP WITH TIME ZONE is a timestamptz there: pg_typeof, the instant in the session's zone, compared and grouped by instant).
// expect: oracle: 32 statements, 32 the same
// expect: pg: 12 statements, 12 the same
// expect: oracle table through the PostgreSQL door: 6 statements, 6 the same
// expect: samples
// expect: SELECT 1: 1|2025-12-31 23:00:00+00|timestamp with time zone
// expect: SELECT 1: 2|2026-01-01 07:00:00+00|timestamp with time zone
// expect: pg timestamptz in Asia/Kolkata: SELECT 1: 2026-03-15 13:30:00+05:30
// expect: oracle shows: SELECT 1: 2026-01-01 03:00:00 +05:30
// timeout: 120
import "strings"
import "os"
import "collections"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_ops"
import "../../../cmd/lexdb_parse"
import "../../../cmd/lexdb_sql"

type Val = lexdb_sql.Val

// A result's rows as text (sorted unless ordered), or the tag, or the error's state.
fn render(rs: &[]lexdb_exec.Res, sql: &str, s: &lexdb_exec.Session): str {
    var parts: []str = []
    for r in rs {
        if !r.hasRows && len(r.rows) == 0 {
            append(mut &parts, r.tag.clone())
            continue
        }
        var lines: []str = []
        for row in r.rows {
            var cells: []str = []
            for i in 0..len(row) { append(mut &cells, if lexdb_ops.isNull(&row[i]) { "NULL" } else { s.text(&row[i], r.cols[i].oid) }) }
            append(mut &lines, strings.join(&cells, "|"))
        }
        if !strings.contains(&strings.toLowerAscii(sql), &"order by") { collections.sort(mut &lines) }
        append(mut &parts, r.tag + ": " + strings.join(&lines, "; "))
    }
    return strings.join(&parts, " / ")
}

// A statement as the Oracle door reads it (its parser and its session's door), or as PostgreSQL's.
fn run(s: mut &lexdb_exec.Session, sql: &str, ora: bool): str {
    if !ora {
        match s.exec(sql) {
            Ok(rs) { return render(&rs, sql, s) }
            Err(e) { return "ERROR " + e.state }
        }
    }
    match lexdb_parse.oraParse(sql) {
        Ok(stmts) {
            var out: []str = []
            for st in stmts {
                match s.run(&st, &[], &[]) {
                    Ok(r) { append(mut &out, render(&[r], sql, s)) }
                    Err(e) { return "ERROR " + e.state }
                }
            }
            return strings.join(&out, " / ")
        }
        Err(e) { return "PARSE " + e.state }
    }
}

type Group = record { name: str; n: int; same: int }

fn report(g: &Group) { println(g.name + ": " + g.n.toStr() + " statements, " + g.same.toStr() + " the same") }

// Statements (separated by ";;") with batches on and off; a write's in a block rolled back each way.
fn check(s: mut &lexdb_exec.Session, g: mut &Group, sql: &str, ora: bool) {
    let w = strings.startsWith(sql, &"W ")
    let body = if w { sql[2..len(sql)].toStr() } else { sql.toStr() }
    let on = stmts(s, &body, w, ora)
    let a = run(s, &"set lexdb_batch = off", false)
    let off = stmts(s, &body, w, ora)
    let b = run(s, &"set lexdb_batch = on", false)
    g.n += 1
    if on == off { g.same += 1 } else { println("DIFFERENT: " + sql + "\n  on:  " + on + "\n  off: " + off) }
    if strings.startsWith(&on, &"ERROR") || strings.startsWith(&on, &"PARSE") || os.envOr("VERBOSE", "") != "" { println("  " + sql + " -> " + on) }
}

fn stmts(s: mut &lexdb_exec.Session, sql: &str, w: bool, ora: bool): str {
    var out: []str = []
    if w { let b = run(s, &"begin", false) }
    for x in strings.split(sql, &";;") { append(mut &out, run(s, &x, ora)) }
    if w { let r = run(s, &"rollback", false) }
    return strings.join(&out, " // ")
}

// What one statement gives, printed with a label: the value the group's "same" does not show.
fn show(s: mut &lexdb_exec.Session, label: &str, sql: &str, ora: bool) { println(label + run(s, sql, ora)) }

fn main() {
    lexdb_store.run(lexdb_disk.sim(93), lexdb_store.Options{cacheBytes: 32 * 1024 * 1024, segBytes: 1024 * 1024, ckptBytes: 1024 * 1024, snapNodes: 200000}, fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st.share())
        s.setDoor(&"tns")
        let osetup = [
            "create table m (id number primary key, t timestamp with time zone, g number)",
            "insert into m select level, from_tz(timestamp '2026-01-01 00:00:00' + numtodsinterval(mod(level, 40), 'hour'), case mod(level, 5) when 0 then '+00:00' when 1 then '+02:00' when 2 then '-05:00' when 3 then '+05:30' else '-03:30' end), mod(level, 7) from dual connect by level <= 2400",
            "create index m_t on m (t)",
            "create table k (id number primary key, t timestamp with time zone)",
            "insert into k select level, from_tz(timestamp '2026-01-01 00:00:00' + numtodsinterval(level, 'hour'), '+01:00') from dual connect by level <= 60",
            "create table u (id number primary key, t timestamp with time zone)",
            "create unique index u_t on u (t)",
            "create table e (id number primary key, t timestamp with time zone)",
        ]
        for x in osetup {
            let r = run(mut &s, &x, true)
            if strings.startsWith(&r, &"ERROR") || strings.startsWith(&r, &"PARSE") { println("setup: " + x + ": " + r) }
        }
        let a1 = run(mut &s, &"analyze", false)

        var g = Group{name: "oracle", n: 0, same: 0}
        let oq = [
            "select count(*) from m where t = timestamp '2026-01-01 05:00:00 +05:30'",
            "select count(*) from m where t = timestamp '2025-12-31 23:30:00 +00:00'",
            "select count(*) from m where t between timestamp '2026-01-01 03:00:00 +00:00' and timestamp '2026-01-01 08:00:00 +00:00'",
            "select count(*) from m where t > timestamp '2026-01-02 00:00:00 -05:00'",
            "select count(*) from m where t in (timestamp '2026-01-01 07:00:00 +02:00', timestamp '2026-01-01 01:00:00 -04:00')",
            "select count(*) from (select t, count(*) c from m group by t)",
            "select count(distinct t) from m",
            "select count(*) from (select distinct t from m)",
            "select g, count(*), sum(extract(hour from t)) from m group by g order by g",
            "select to_char(sys_extract_utc(t), 'YYYY-MM-DD HH24:MI') u, count(*) from m group by t order by 1 fetch first 4 rows only",
            "select id from m order by t, id fetch first 6 rows only",
            "select id from m order by t desc, id fetch first 6 rows only",
            "select id from m where g = 3 order by t, id offset 2 rows fetch first 4 rows only",
            "select count(*) from m join k on m.t = k.t",
            "select count(*) from m a join m b on a.t = b.t and a.id < b.id",
            "select count(*) from m a join k b on a.t < b.t and b.id = 3",
            "select to_char(sys_extract_utc(max(t)), 'YYYY-MM-DD HH24:MI') mx, to_char(sys_extract_utc(min(t)), 'YYYY-MM-DD HH24:MI') mn from m",
            "select id, row_number() over (order by t, id) rn from m where id <= 5 order by id",
            "select count(*) from m where t is null",
            "select count(*) from e",
            "select count(*) from e where t = timestamp '2026-01-01 00:00:00 +00:00'",
            "select count(*) from m where t = (select min(t) from k)",
            "select extract(timezone_hour from t) h, count(*) from m group by extract(timezone_hour from t) order by 1",
            "W insert into m values (9001, null, 0) ;; select count(*) from m where t is null",
            "W insert into m values (9001, timestamp '2026-01-01 05:00:00 +05:30', 0) ;; select count(*) from m where t = timestamp '2026-01-01 00:00:00 +00:00'",
            "W update m set t = t + interval '1' hour where id <= 10 ;; select count(*) from m where t = timestamp '2026-01-01 01:00:00 +00:00'",
            "W delete from m where t = timestamp '2026-01-01 00:00:00 +00:00' ;; select count(*) from m",
            "W insert into u values (1, timestamp '2026-03-15 10:00:00 +02:00') ;; insert into u values (2, timestamp '2026-03-15 08:00:00 +00:00')",
            "W insert into u values (1, timestamp '2026-03-15 10:00:00 +02:00') ;; insert into u values (2, timestamp '2026-03-15 09:00:00 +02:00') ;; select count(*) from u",
            "W insert into e select id, t from m where id <= 100 ;; select count(*), count(distinct t) from e",
            "W insert into e select id, t from m where id = 2 or id = 3 ;; select to_char(t, 'TZH:TZM') z from e order by id",
            "select to_char(t, 'TZH:TZM') z, count(*) from m where id <= 10 group by to_char(t, 'TZH:TZM') order by 1",
        ]
        for q in oq { check(mut &s, mut &g, &q, true) }
        report(&g)

        var h = Group{name: "pg", n: 0, same: 0}
        let psetup = [
            "create table pt (id int primary key, ts timestamptz)",
            "insert into pt values (1, '2026-03-15 10:00:00+02'), (2, '2026-03-15 08:00:00+00'), (3, '2026-03-15 03:00:00-05'), (4, '2026-03-15 12:00:00+05:30'), (5, null)",
            "create index pt_ts on pt (ts)",
        ]
        for x in psetup {
            let r = run(mut &s, &x, false)
            if strings.startsWith(&r, &"ERROR") { println("setup: " + x + ": " + r) }
        }
        let pq = [
            "select id, ts from pt order by ts, id",
            "select ts, count(*) from pt group by ts order by 1",
            "select count(distinct ts) from pt",
            "select id from pt where ts = '2026-03-15 08:00:00+00' order by id",
            "select id from pt where ts > '2026-03-15 07:00:00+00' order by id",
            "select id from pt where ts between '2026-03-15 06:00:00+00' and '2026-03-15 08:00:00+00' order by id",
            "select a.id, b.id from pt a join pt b on a.ts = b.ts and a.id < b.id order by 1, 2",
            "select max(ts), min(ts) from pt",
            "select id, ts at time zone 'UTC' from pt order by id",
            "select id, ts + interval '1 day' from pt order by id",
            "select id, ts - timestamptz '2026-03-15 00:00:00+00' from pt order by id",
            "select id, extract(hour from ts), date_trunc('hour', ts) from pt order by id",
        ]
        for q in pq { check(mut &s, mut &h, &q, false) }
        report(&h)

        var j = Group{name: "oracle table through the PostgreSQL door", n: 0, same: 0}
        let tq = [
            "select id, t, pg_typeof(t) from m where id <= 3 order by id",
            "select count(*) from m where t = '2026-01-01 05:00:00+05:30'",
            "select count(*), count(distinct t) from m",
            "select id from m where t < '2026-01-01 00:30:00+00' order by id",
            "select g, min(t) from m group by g order by g",
            "select id, t at time zone 'UTC' from m where id <= 3 order by id",
        ]
        for q in tq { check(mut &s, mut &j, &q, false) }
        report(&j)

        println("samples")
        show(mut &s, "", "select id, t, pg_typeof(t) from m where id = 1", false)
        show(mut &s, "", "select id, t, pg_typeof(t) from m where id = 2", false)
        let z = run(mut &s, &"set time zone 'Asia/Kolkata'", false)
        show(mut &s, "pg timestamptz in Asia/Kolkata: ", "select ts from pt where id = 1", false)
        let z2 = run(mut &s, &"set time zone 'UTC'", false)
        show(mut &s, "oracle shows: ", "select to_char(t, 'YYYY-MM-DD HH24:MI:SS TZH:TZM') from m where id = 3", true)
        s.close()
        return 0
    }).unwrap()
}
