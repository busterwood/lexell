import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_ops"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            var out: []str = []
            for r in rs {
                for row in r.rows {
                    var vs: []str = []
                    for k in 0..len(row) { append(mut &vs, if lexdb_ops.isNull(&row[k]) { "NULL" } else { s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 }) }) }
                    append(mut &out, strings.join(&vs, "|"))
                }
            }
            return strings.join(&out, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// each statement with the row engine and with batches, in a transaction rolled back
fn two(s: mut &lexdb_exec.Session, label: &str, sql: &str) {
    let x = q(s, &"set lexdb_batch = off")
    let b0 = q(s, &"begin")
    let off = q(s, sql)
    let r0 = q(s, &"rollback")
    let y = q(s, &"set lexdb_batch = on")
    let b1 = q(s, &"begin")
    let on = q(s, sql)
    let r1 = q(s, &"rollback")
    println(label + ": " + on + ", same: " + (off == on).toStr())
}

const SETUP = "create table f0 (a0 float8, a1 date, a2 text, a3 text, a4 bool, a5 text)\ninsert into f0 values (3, '2024-01-06', 'A', 'z', false, 'Ab'), (-0, '2024-01-06', 'b', 'a_c', false, '')\ncreate table f1 (b0 bool, b1 date not null, b2 int, b3 float8, b4 bigint, b5 text)\ninsert into f1 values (true, '2024-01-07', 2, 1e10, 0, 'a'), (NULL, '2024-01-02', NULL, 1e10, NULL, NULL), (true, '2024-01-08', 1, -0, NULL, NULL), (NULL, '2024-01-03', 1, 2.5, NULL, 'z'), (false, '2024-01-03', NULL, 0.5, 9, NULL), (true, '2024-01-03', -2, NULL, 0, NULL), (false, '2024-01-08', 12, NULL, 9223372036854775807, NULL), (true, '2024-01-03', 12, 0, -2, 'a'), (NULL, '2024-01-09', NULL, 0, 8, 'a '), (false, '2024-01-07', NULL, 1e10, NULL, 'ba'), (NULL, '2024-01-01', 11, 0.5, 8, 'abc'), (false, '2024-01-03', 9, 3, 11, NULL), (NULL, '2024-01-01', 12, -1.25, NULL, 'B'), (false, '2024-01-03', NULL, 0.5, NULL, 'ba'), (false, '2023-12-31', 8, -0, -2, NULL)\ncreate index f0_i0 on f0 (a4, a5)\nupdate f0 set a0 = -0 where a4 = true\ncreate index f1_i0 on f1 (b5, b1)\ncreate table e0 (a int, t text)\ncreate table e1 (b5 text, k int)\ncreate table e2 (k int)\ncreate table e3 (k int, v int)\ninsert into e0 values (1, ''), (2, 'x'), (0, 'y')\ninsert into e2 values (1), (2), (0)\ninsert into e3 select x, x % 10 from generate_series(1, 3000) x\nanalyze\ncreate table bb (g int, b bigint, i int, s smallint)\ninsert into bb values (1, 9223372036854775807, 2147483647, 1), (1, 9223372036854775807, 2147483647, 2), (2, -9223372036854775807, 5, 3), (2, -9223372036854775807, null, 4), (3, null, null, null), (2, 10, 1, 5), (4, 1, 1, 1), (5, 9223372036854775807, 1, 1), (5, -9223372036854775807, 1, 1), (5, 9223372036854775807, 1, 1)\ncreate table big (g int, b bigint, i int)\ninsert into big select x % 7, case when x % 3 = 0 then 9223372036854775807 - x else x end, x from generate_series(1, 6000) as t(x)\ncreate table s1 (id int, a char(3), a5 char(5), v varchar(4), t text)\ninsert into s1 values (1, '', '', '', ''), (2, 'ab', 'ab', 'ab ', 'ab '), (3, 'ab', 'a', 'ab', 'ab'), (4, null, null, null, null), (5, ' a', 'z', 'x', 'y'), (6, 'ab', 'ab', 'ab ', 'ab ')\ncreate table s2 (id int, a char(3), v varchar(4), t text)\ninsert into s2 values (1, 'ab', 'ab', 'ab'), (2, '', ' a', 'a'), (3, null, 'ab ', null), (4, 'q', 'q', 'q ')\ncreate table se (a char(3), v varchar(4), t text)\ncreate table nn (id int, i int, b bigint, s smallint, n numeric, f float8, r real)\ninsert into nn values (1, 1, 1, 1, 1.0, 1, 1), (2, 2, 9223372036854775807, 2, 2.5, 0.5, 2.5), (3, null, null, null, null, null, null), (4, 0, -3, -1, 0, 0, 0), (5, 2, 2, 2, 2.00, 2, 2)\ncreate table t0 (a0 char(3), a1 int)\ninsert into t0 values (null, null), ('a ', 7), (null, -2), ('c', 4), ('a', 10), ('', null)\ncreate table t2 (c1 text, c3 text, c4 numeric)\ninsert into t2 values ('a', 'ba', 1.5), ('b', 'a_c', 3.333), (null, '', -1), ('ab ', 'z', 1)"

const QS = "W6 doc\tselect case when true then a else cast(null as text) end as x4 from s1 order by id\nW6 w0-1774\tselect string_agg(q1.c3, ',' order by q1.c3) as x3, max(case when true then q2.a0 else q1.c1 end) as x4, min(q1.c4) as x5 from t2 as q1 cross join t0 as q2 where (('a_c' || 'ab') like '%a%') group by q1.c4 order by 1 desc, 2, 3 asc nulls first limit 10\nW6 CASE then char else text\tselect id, '[' || (case when id > 2 then a else t end) || ']', octet_length(case when id > 2 then a else t end), (case when id > 2 then a else t end) = 'ab', pg_typeof(case when id > 2 then a else t end) from s1 order by id\nW6 CASE then text else char\tselect id, '[' || (case when id > 2 then t else a end) || ']', octet_length(case when id > 2 then t else a end), (case when id > 2 then t else a end) = 'ab', pg_typeof(case when id > 2 then t else a end) from s1 order by id\nW6 CASE then char else varchar\tselect id, '[' || (case when id > 2 then a else v end) || ']', octet_length(case when id > 2 then a else v end), (case when id > 2 then a else v end) = 'ab' from s1 order by id\nW6 CASE then varchar else char\tselect id, '[' || (case when id > 2 then v else a end) || ']', octet_length(case when id > 2 then v else a end), (case when id > 2 then v else a end) = 'ab', pg_typeof(case when id > 2 then v else a end) from s1 order by id\nW6 CASE then text else varchar, then varchar else text\tselect id, octet_length(case when id > 2 then t else v end), octet_length(case when id > 2 then v else t end), pg_typeof(case when id > 2 then v else t end) from s1 order by id\nW6 CASE no ELSE, NULL ELSE, a literal\tselect id, '[' || (case when id > 2 then a when id = 1 then t end) || ']', '[' || (case when id > 2 then t when id = 1 then a else null end) || ']', '[' || (case when id > 2 then a else 'q' end) || ']', octet_length(case when id > 2 then 'q' else a end), pg_typeof(case when id > 2 then a when id = 1 then t end) from s1 order by id\nW6 simple CASE, nested\tselect id, '[' || (case id when 3 then a when 5 then a5 else t end) || ']', pg_typeof(case id when 3 then a else t end), '[' || (case when id > 1 then case when id > 3 then a else a5 end else t end) || ']' from s1 order by id\nW6 CASE chars of two lengths\tselect id, '[' || (case when id > 2 then a else a5 end) || ']', octet_length(case when id > 2 then a else a5 end) from s1 order by id\nW6 CASE in aggregates and GROUP BY\tselect case when id > 2 then a else t end as k, count(*), max(case when true then a else t end) from s1 group by 1 order by 1\nW6 CASE in WHERE\tselect id from s1 where (case when id > 2 then a else t end) = 'ab' order by id\nW6 COALESCE\tselect id, '[' || coalesce(t, a) || ']', '[' || coalesce(v, a) || ']', '[' || coalesce(a, t) || ']', octet_length(coalesce(a, t)), '[' || coalesce(null, a) || ']', octet_length(coalesce(a, 'z')), pg_typeof(coalesce(t, a)), pg_typeof(coalesce(a, t)) from s1 order by id\nW6 COALESCE of a NULL text\tselect id, '[' || coalesce(cast(null as text), a) || ']', octet_length(coalesce(cast(null as varchar), a, t)) from s1 order by id\nW6 GREATEST, LEAST\tselect id, '[' || greatest(t, a) || ']', '[' || least(v, a) || ']', octet_length(greatest(v, a)), pg_typeof(greatest(t, a)), pg_typeof(least(a, t)) from s1 order by id\nW6 NULLIF of chars\tselect id, '[' || nullif(a, t) || ']', '[' || nullif(v, a) || ']', '[' || nullif(a, v) || ']', '[' || nullif(v, t) || ']', '[' || nullif(t, a) || ']', pg_typeof(nullif(a, t)), pg_typeof(nullif(a, v)), pg_typeof(nullif(v, a)), pg_typeof(nullif(t, v)), pg_typeof(nullif(a, 'x')) from s1 order by id\nW6 NULLIF of numbers' types\tselect pg_typeof(nullif(i, b)), pg_typeof(nullif(b, i)), pg_typeof(nullif(s, i)), pg_typeof(nullif(i, n)), pg_typeof(nullif(n, i)), pg_typeof(nullif(i, f)), pg_typeof(nullif(f, n)), pg_typeof(nullif(n, f)), pg_typeof(nullif(i, 1.5)), pg_typeof(nullif(s, r)), pg_typeof(nullif(r, f)), pg_typeof(nullif(b, '3')), pg_typeof(nullif(null, b)), pg_typeof(nullif(1, i)) from nn where id = 1\nW6 NULLIF of numbers\tselect id, nullif(i, n), nullif(n, i), nullif(i, f), nullif(b, n), nullif(i, 2.5), nullif(i, 2.0), nullif(s, r), nullif(null, b), nullif(b, 1.5) from nn order by id\nW6 NULLIF in expressions\tselect id, nullif(i, n) + 1, nullif(b, 2.0) * 2, sum(nullif(i, n)) over (), 10 / nullif(i, 0.0) from nn order by id\nW6 NULLIF aggregated\tselect sum(nullif(i, n)), avg(nullif(b, f)), max(nullif(a, t)), count(nullif(v, a)) from nn, s1\nW6 UNION ALL char and text\tselect '[' || x || ']', octet_length(x) from (select t as x from s1 union all select a from s2) d order by 1\nW6 UNION char and varchar\tselect x, '[' || x || ']' from (select v as x from s1 union select a from s2) d order by 1\nW6 UNION char and text: one row per char value\tselect '[' || x::text || ']', count(*) from (select a as x from s1 union select t from s2) d group by 1 order by 1\nW6 UNION chars of two lengths\tselect count(*) from (select a as x from s1 union select a5 from s1) d\nW6 INTERSECT char and text\tselect x::text from (select a as x from s1 intersect select t from s2) d order by 1\nW6 INTERSECT ALL char and varchar\tselect x::text from (select a as x from s1 intersect all select v from s1) d order by 1\nW6 EXCEPT char and varchar\tselect x::text from (select a as x from s1 except select v from s2) d order by 1\nW6 EXCEPT text and char\tselect '[' || x || ']' from (select t as x from s1 except select a from s2) d order by 1\nW6 UNION with an empty side\tselect '[' || x || ']' from (select t as x from se union select a from s2) d order by 1\nW6 UNION of empty sides\tselect x from (select a as x from se union select t from se) d\nW6 UNION char and char\tselect x, octet_length(x) from (select a as x from s1 union select a from s2) d order by 1\nW6 VALUES\tselect '[' || column1 || ']', octet_length(column1) from (values ('a'::text), ('b '::char(3)), (null)) d order by 1\nW6 VALUES varchar and char\tselect '[' || column1 || ']', column2 from (values ('a'::varchar, 1), ('b '::char(3), 2), (null, 3), ('c'::char(4), 4)) d order by 2\nW6 VALUES of chars\tselect '[' || column1 || ']', octet_length(column1) from (values ('b '::char(3)), ('c'::char(4))) d order by 1\nW6 numbers: CASE, COALESCE, GREATEST types\tselect pg_typeof(case when id = 1 then i else b end), pg_typeof(case when id = 1 then n else i end), pg_typeof(case when id = 1 then f else n end), pg_typeof(case when id = 1 then s else 1 end), pg_typeof(case when id = 1 then b else '7' end), pg_typeof(coalesce(i, n)), pg_typeof(coalesce(s, r)), pg_typeof(greatest(i, b)), pg_typeof(least(n, f, i)) from nn where id = 1\nW6 numbers: CASE and COALESCE values\tselect id, case when id = 1 then i else n end, coalesce(i, n), case when id > 1 then s else b end, greatest(s, n), coalesce(n, f) from nn order by id\nW6 numbers: UNION\tselect x from (select i as x from nn union select n from nn) d order by 1\nW6 an empty table\tselect case when true then a else t end, coalesce(t, a), nullif(a, t) from se\nE4 sum and avg of bigints, types\tselect sum(b), avg(b), sum(i), avg(i), sum(s), pg_typeof(sum(b)), pg_typeof(sum(i)), pg_typeof(sum(s)), pg_typeof(avg(b)), pg_typeof(avg(i)) from bb\nE4 grouped\tselect g, sum(b), avg(b), count(b), sum(b) / 2, sum(b) + 1, sum(distinct b), avg(distinct b) from bb group by g order by g\nE4 back in range\tselect sum(b) from bb where g = 5\nE4 FILTER\tselect sum(b) filter (where g < 3), avg(b) filter (where g = 1), sum(b) filter (where g = 99) from bb\nE4 a product past 2^63 still errs\tselect sum(b * 2) from bb\nE4 HAVING, ORDER BY\tselect g, sum(b) from bb group by g having sum(b) > 9223372036854775807 or sum(b) < -9223372036854775807 order by sum(b) desc\nE4 UNION ALL\tselect sum(x), avg(x) from (select b as x from bb union all select b from bb) d\nE4 a join\tselect b1.g, sum(b2.b), avg(b2.b) from bb b1 join bb b2 on b1.g = b2.g group by b1.g order by 1\nE4 a cross join, one group\tselect sum(b1.b), avg(b1.b), count(*) from bb b1, bb b2\nE4 empty\tselect sum(b), avg(b), sum(i) from bb where g = 99\nE4 many rows, one group\tselect sum(b), avg(b), sum(i), count(*) from big\nE4 many rows, grouped\tselect g, sum(b), avg(b), min(b), max(b) from big group by g order by g\nE4 many rows, a condition\tselect g, sum(b) from big where i > 100 group by g order by g\nE4 window running, partition, moving\tselect g, sum(b) over (order by g, b rows between unbounded preceding and current row), sum(b) over (partition by g), avg(b) over (order by g, b rows between 1 preceding and current row), sum(b) over (order by g, b rows between 1 preceding and 1 following) from bb order by g, b\nE4 window EXCLUDE\tselect g, b, sum(b) over (order by g, b rows between unbounded preceding and unbounded following exclude current row) from bb order by g, b\nE4 window types, a named window\tselect g, pg_typeof(sum(b) over ()), sum(i) over (), pg_typeof(sum(i) over ()), sum(b) over w, avg(b) over w from bb window w as (order by g) order by g, b\nE5 doc\tselect case when false then (select cast(0.5 as float8) as x11 from e0 as q8 where (1 <> any (select (1 / (1 % nullif(1, 0))) as x10 from e0 as q9))) end as x12 from e1 as q1\nE5 w0-1627\tselect case when (exists (select ' a' as x7 from f0 as q6 where ((q6.a4 = q1.b0) and (q6.a4 and q6.a4)))) then (select avg(q8.a0) as x11 from f0 as q8 where ((q8.a4 = q1.b0) and (cast(3.333 as int) <> any (select ((q1.b2 * 5) / (q1.b2 % nullif(q1.b2, 0))) as x10 from f0 as q9 where (q9.a0 = q8.a0))))) end as x12, avg(case when (q1.b4 <= 2) then q3.b3 end) as x13 from f1 as q1 left join f0 as q2 on (q1.b5 = q2.a3) left join f1 as q3 on ((q1.b0 = q3.b0) and (q1.b1 = q3.b1)) where ((coalesce(q3.b1, q2.a1) in (select q4.b1 as x5 from f1 as q4 where ((q1.b5 in (cast(null as text), 'bb')) or (q4.b1 >= date '2024-01-07')) group by q4.b1)) = true) group by q1.b2, q1.b0 order by 1, 2\nE5 CASE false, rows\tselect case when false then (select 1 / (1 % nullif(1, 0)) from e0 limit 1) end from e2\nE5 a branch not taken, run once\tselect case when k > 5 then (select 1 / (count(*) - 3) from e0) else 1 end from e2\nE5 a branch taken, run once\tselect case when k > 1 then (select 1 / (count(*) - 3) from e0) else 1 end from e2\nE5 two rows, a branch not taken\tselect case when k > 5 then (select t from e0) else 'q' end from e2\nE5 two rows, a branch taken\tselect case when k > 1 then (select t from e0) else 'q' end from e2\nE5 no rows read it\tselect k, (select 1 / (count(*) - 3) from e0) from e2 where k > 5\nE5 an empty table\tselect (select 1 / (count(*) - 3) from e0) from e1\nE5 rows read it\tselect k, (select 1 / (count(*) - 3) from e0) from e2 where k > 0\nE5 WHERE, a later batch\tselect count(*) from e3 where case when v = 9 and k > 2990 then (select 10 / (count(*) - 3) from e0) = 1 else false end\nE5 WHERE, no row reaches it\tselect count(*) from e3 where case when v > 20 then v = (select 1 / (count(*) - 3) from e0) else true end\nE5 WHERE, rows read it\tselect count(*) from e3 where v = (select 1 / (count(*) - 3) from e0)\nE5 an aggregate's argument, not reached\tselect sum(case when v > 20 then (select 1 / (count(*) - 3) from e0) else v end) from e3\nE5 an aggregate's argument, reached\tselect sum(case when v > 5 then (select 1 / (count(*) - 3) from e0) else v end) from e3\nE5 IN under CASE false\tselect case when false then 1 in (select 1 / (count(*) - 3) from e0) end from e2\nE5 EXISTS, an empty table\tselect exists (select 1 / (count(*) - 3) from e0) from e1\nE5 IN, rows read it\tselect k from e2 where k in (select 1 / (count(*) - 3) from e0)\nE5 IN over a path, rows read it\tselect k from e3 where k in (select 1 / (count(*) - 3) from e0) and k < 10\nE5 correlated, a branch not taken\tselect k, case when k > 5 then (select 10 / (a - e2.k) from e0 where a = 0) else 0 end from e2 order by k\nE5 correlated, a branch taken\tselect k, case when k > 0 then (select 10 / (a - e2.k) from e0 where a = 1) else 0 end from e2 order by k\nE5 correlated, taken for one row\tselect k, case when k = 1 then (select 10 / (a - e2.k) from e0 where a = 2) else -1 end from e2 order by k\nE5 correlated, two rows, taken\tselect k, case when k <> 2 then (select t from e0 where a >= e2.k) else 'q' end from e2 order by k\nE5 correlated, two rows, in ELSE\tselect k, case when k = 0 then 'z' else (select t from e0 where a >= e2.k) end from e2 order by k\nE5 correlated, under a false EXISTS\tselect k, case when exists (select 1 from e0 where a = e2.k + 10) then (select 10 / (a - a) from e0 where a = e2.k) end from e2 order by k\nE5 correlated, a later row of an aggregate\tselect count(*), sum(case when v = 3 then (select 10 / (a - e3.v + 2) from e0 where a = 1) else 0 end) from e3\nE5 correlated in WHERE\tselect k from e3 where case when v > 20 then (select 10 / (a - e3.v) from e0 where a = 0) = 1 else k = 5 end\nE5 correlated in WHERE, a later batch\tselect k from e3 where case when v = 9 and k > 2990 then (select 10 / (a - e3.v + 9) from e0 where a = 0) = 1 else false end\nE5 correlated aggregate, not reached\tselect k, case when k > 5 then (select 10 / (count(*) - 3) from e0 where a < e2.k + 9) else 0 end from e2 order by k"

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let setup: str = SETUP
    for l in strings.lines(&setup) {
        let o = q(mut &s, &l)
        if strings.startsWith(&o, "ERROR") { println(l + ": " + o) }
    }
    let qs: str = QS
    for l in strings.lines(&qs) {
        let parts = strings.split(&l, "\t")
        two(mut &s, &parts[0], &parts[1])
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(98), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 4 * 1024 * 1024, ckptBytes: 2 * 1024 * 1024,
                                                           snapNodes: 100000}, body).unwrap()
}
