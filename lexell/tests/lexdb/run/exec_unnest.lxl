// lexdb_plan, lexdb_pipe: subquery unnesting (optimizer 50). Each query
// runs with the new levels (setUnnest(all)), with today's plans
// (setUnnest(0)), and each of them with batches off (the row engine): the
// same rows (sorted, unless it orders them) or the same error. "made": per
// query, y when its EXPLAIN shows the new level; "piped": whether a run
// with the new plan went through the pipeline's joins.
// - notin (5a): x NOT IN (subquery) and x <> ALL, uncorrelated and
//   correlated (hashed as planned, or planned again by cost), NULLs on
//   both sides, an empty subquery, a subquery with no NULL, duplicates, a
//   text key, a numeric against integers, after a join, inside another
//   subquery, under an aggregate, ORDER BY and LIMIT, errors (in a later
//   batch, in x, inside the subquery, after it: those stay per row).
// - mark (5b): EXISTS and IN under OR, NOT, CASE and IS NULL in WHERE
//   (hashed as planned, or planned again by cost; two in one conjunct;
//   before and after other conjuncts, one that may fail), in the select
//   list and ORDER BY (with LIMIT, DISTINCT, after a join and a LEFT
//   JOIN), NULLs, an empty subquery, a text key, under an aggregate;
//   those that stay as they were: a key that may fail, LIMIT inside, a
//   select list's subquery looked up by an index, a grouped query's.
// - look (5c): x IN (subquery) read per outer row by x where it is the
//   inner table's primary key or an index's first column (integers, a
//   text key), uncorrelated and correlated, by cost against the hash (few
//   outer rows); a numeric x and an expression stay hashed; EXISTS whose
//   path has a range after its equalities (constants, an outer value: the
//   row engine's only); EXISTS over two tables, the first looked up, the
//   second's rows a set run once (integer and text keys; a condition of
//   the second that may fail, or one on both: stays per row).
// - EXPLAIN ANALYZE's counts with batches on and off.
// timeout: 120
// expect: create table t1 (id int primary key, a int, b text, c int, d numeric) -> CREATE TABLE
// expect: insert into t1 select g, case when g % 23 = 0 then null else g % 50 end, case when g % 19 = 0 then null else 'b' || (g % 30) end, case when g % 29 = 0 then null else g % 40 end, (g % 7) * 1.5 from generate_series(1, 3000) g -> INSERT 0 3000
// expect: create table t2 (id int primary key, k int, v int, s text, w int) -> CREATE TABLE
// expect: insert into t2 select g, case when g % 31 = 0 then null else g % 35 end, case when g % 37 = 0 then null else (g * 7) % 45 end, case when g % 41 = 0 then null else 'b' || (g % 25) end, g % 3 from generate_series(1, 800) g -> INSERT 0 800
// expect: create index t2k on t2 (k) -> CREATE INDEX
// expect: create table t3 (id int primary key, k int, v int, s text) -> CREATE TABLE
// expect: insert into t3 select g, case when g % 17 = 0 then null else g % 30 end, case when g % 13 = 0 then null else (g * 11) % 48 end, case when g % 11 = 0 then null else 'b' || (g % 33) end from generate_series(1, 300) g -> INSERT 0 300
// expect: create table nn (id int primary key, k int, v int not null, s text not null) -> CREATE TABLE
// expect: insert into nn select g, g % 20, (g * 3) % 40, 'b' || (g % 20) from generate_series(1, 200) g -> INSERT 0 200
// expect: create table e (id int primary key, k int, v int, s text) -> CREATE TABLE
// expect: create table lr (ok int, ln int, v int, primary key (ok, ln)) -> CREATE TABLE
// expect: insert into lr select g / 6, g % 6, case when g % 7 = 0 then null else g % 9 end from generate_series(0, 239) g where g % 11 <> 3 -> INSERT 0 218
// expect: create table tx (s text primary key, k int) -> CREATE TABLE
// expect: insert into tx select 'b' || g, g % 5 from generate_series(0, 40) g where g % 4 <> 1 -> INSERT 0 31
// expect: analyze -> ANALYZE
// expect: notin: 27 queries, 27 the same, made yyyyyyyyyyyynynyyyyyynnnyyy, piped yyyyyyyyyyyynynnynyyynnnyyy
// expect: notin in a transaction: 23 queries, 23 the same, made yyyynyyyyyyyyyyyynnnynn, piped yyyynyyyyyynynyyynnnynn
// expect: in over an aggregate: 516|21786, the same: true
// expect: mark: 34 queries, 34 the same, made yyyyyyyyyynyyyyyyyyyynyyyyynnyyyyy, piped yyyyyyyyyynyyyyyyyyynnyyyyynnyyyyy
// expect: look: 22 queries, 22 the same, made yyyynynnnynyyyynyyynny, piped yyyyyyyyyynyynyyyyynyy
// expect: counts notin: same: true
// expect: counts mark or: same: true
// expect: counts mark select list: same: true
// expect: counts notin uncorrelated: same: true
// expect: plan notin: scan t1: full scan; anti join (null-aware) t2: hash on (v) over rows of subquery 1; aggregate; subquery 1 (in): anti join (null-aware), run once;   scan t2: full scan
// expect: plan notin hashed: scan t1: full scan; anti join (null-aware) t3: hash on (k, v) over rows of subquery 1; aggregate; subquery 1 (in): anti join (null-aware) on t3.k = t1.c, run once;   scan t3: full scan
// expect: plan notin by cost: scan t1: full scan; anti join (null-aware) t2: hash on (k, v) over rows of subquery 1; aggregate; subquery 1 (in): anti join (null-aware) on t2.k = t1.c, run once;   scan t2: full scan
// expect: plan notin text: scan t1: full scan; anti join (null-aware) t3: hash on (k, s) over rows of subquery 1; aggregate; subquery 1 (in): anti join (null-aware) on t3.k = t1.c, run once;   scan t3: full scan
// expect: plan notin after a join: scan t3: full scan; join t1: primary key lookup per row; anti join (null-aware) nn: hash on (k, v) over rows of subquery 1; aggregate; subquery 1 (in): anti join (null-aware) on nn.k = t3.k, run once;   scan nn: full scan
// expect: plan notin error after it: scan t1: full scan; aggregate; subquery 1 (in): run once;   scan t3: full scan
// expect: plan notin error inside: scan t1: full scan; aggregate; subquery 1 (in): per row, on t1.c;   scan t2: index t2k lookup, rows in key order
// expect: plan notin limit inside: scan t1: full scan; aggregate; subquery 1 (in): per row, on t1.c;   scan t3: full scan;   order: sort
// expect: plan mark or: scan t1: full scan; mark join t3: hash on (k, v) over rows of subquery 1, filter per row; aggregate; subquery 1 (in): mark join on t3.k = t1.c, run once;   scan t3: full scan
// expect: plan mark by cost: scan t1: full scan; mark join t2: hash on (k) over rows of subquery 1, filter per row; aggregate; subquery 1 (exists): mark join on t2.k = t1.c, run once;   scan t2: full scan
// expect: plan mark two: scan t1: full scan; mark join t3: hash on (k) over rows of subquery 1; mark join nn: hash on (k, v) over rows of subquery 2, filter per row; aggregate; subquery 1 (exists): mark join on t3.k = t1.c, run once;   scan t3: full scan; subquery 2 (in): mark join on nn.k = t1.c, run once;   scan nn: full scan
// expect: plan mark select list: scan t1: primary key range; mark join t3: hash on (k, v) over rows of subquery 1; mark join t3: hash on (k, v) over rows of subquery 2; order: the scan's; subquery 1 (in): mark join on t3.k = t1.c, run once;   scan t3: full scan; subquery 2 (in): mark join on t3.k = t1.c, run once;   scan t3: full scan
// expect: plan mark order by: scan t1: primary key range; mark join t3: hash on (k) over rows of subquery 1; order: sort; subquery 1 (exists): mark join on t3.k = t1.c, run once;   scan t3: full scan
// expect: plan mark key may fail: scan t1: full scan; aggregate; subquery 1 (exists): hashed on t3.k = an outer expression;   scan t3: full scan
// expect: plan look in: scan t1: primary key range (estimated 19 rows); semi join t3: primary key lookup per row, filter per row read; order: the scan's; subquery 1 (in): semi join, looked up per row by the join
// expect: plan look in hashed: scan t1: primary key range; semi join t3: primary key lookup per row, filter per row read; order: the scan's; subquery 1 (in): semi join, looked up per row by the join
// expect: plan look in text: scan t1: primary key range (estimated 7 rows); semi join tx: primary key lookup per row, filter per row read; order: the scan's; subquery 1 (in): semi join, looked up per row by the join
// expect: plan look in index: scan t1: primary key range (estimated 7 rows); semi join t2: index t2k lookup per row, filter per row read; order: the scan's; subquery 1 (in): semi join, looked up per row by the join
// expect: plan look in many rows: scan t1: full scan; semi join t3: hash on (id) over rows of subquery 1; aggregate; subquery 1 (in): semi join, run once;   scan t3: full scan
// expect: plan look range: scan t1: primary key range; semi join lr: primary key range per row, filter per row read; order: the scan's; subquery 1 (exists): semi join, looked up per row by the join
// expect: plan look range outer: scan t1: primary key range; semi join lr: primary key range per row, filter per row read; order: the scan's; subquery 1 (exists): semi join, looked up per row by the join
// expect: plan look two tables: scan t1: primary key range; semi join lr: primary key range (estimated 6 rows) per row, filter per row read; order: the scan's; subquery 1 (exists): semi join, looked up per row by the join; subquery 2 (in): run once;   scan nn: full scan
// expect: plan look two tables text: scan t1: primary key range; semi join t2: index t2k lookup (estimated 23 rows) per row, filter per row read; order: the scan's; subquery 1 (exists): semi join, looked up per row by the join; subquery 2 (in): run once;   scan nn: full scan
// expect: plan mark grouped: scan t1: full scan; aggregate; order: sort; subquery 1 (exists): hashed on t3.k = t1.c;   scan t3: full scan
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_ops"
import "../../../cmd/lexdb_sql"
import "../../../cmd/lexdb_plan"
import "../../../cmd/lexdb_pipe"
import "collections"
import "strings"

fn run(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_ops.isNull(&v) { "NULL" } else { lexdb_sql.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            if !strings.contains(&strings.toLowerAscii(sql), &"order by") { collections.sort(mut &lines) }
            return strings.join(&lines, "; ")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn show(s: mut &lexdb_exec.Session, sql: str) { println(sql + " -> " + run(s, &sql)) }

// EXPLAIN's lines, in one; analyze: EXPLAIN ANALYZE's, its counts but not its time.
fn planOf(s: mut &lexdb_exec.Session, sql: &str, analyze: bool): str {
    let head = if analyze { "explain analyze " } else { "explain " }
    match s.exec(&(head + sql)) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            let n = if analyze { len(r.rows) - 1 } else { len(r.rows) }
            var lines: []str = []
            for i in 0..n { append(mut &lines, lexdb_sql.text(&r.rows[i][0])) }
            return strings.join(&lines, "; ")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

type Group = record { name: str; word: str; n: int; same: int; made: str; piped: str; seen: []str }

fn newGroup(name: &str, word: &str): Group { return Group{name: name.clone(), word: word.clone(), n: 0, same: 0, made: "", piped: "", seen: []} }

const ALL: int = 7

fn check(s: mut &lexdb_exec.Session, g: mut &Group, sql: &str) {
    lexdb_plan.setUnnest(ALL)
    let j0 = lexdb_pipe.joinCounts()[0]
    let on = run(s, sql)
    let j1 = lexdb_pipe.joinCounts()[0]
    let p = planOf(s, sql, false)
    lexdb_plan.setUnnest(0)
    let off = run(s, sql)
    let x = run(s, &"set lexdb_batch = off")
    let offRows = run(s, sql)
    lexdb_plan.setUnnest(ALL)
    let onRows = run(s, sql)
    let y = run(s, &"set lexdb_batch = on")
    g.n += 1
    if on == off && on == offRows && on == onRows {
        g.same += 1
    } else if len(g.seen) < 4 {
        append(mut &g.seen, "DIFFERENT: " + sql + "\n  new: " + on + "\n  old: " + off + "\n  old, rows: " + offRows + "\n  new, rows: " + onRows + "\n  plan: " + p)
    }
    g.made += if strings.contains(&p, &g.word) { "y" } else { "n" }
    g.piped += if j1 > j0 { "y" } else { "n" }
}

fn report(g: &Group) {
    println(g.name + ": " + g.n.toStr() + " queries, " + g.same.toStr() + " the same, made " + g.made + ", piped " + g.piped)
    for x in g.seen { println(x) }
}

fn explain(s: mut &lexdb_exec.Session, label: &str, sql: &str) {
    lexdb_plan.setUnnest(ALL)
    println("plan " + label + ": " + planOf(s, sql, false))
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    // t1: 3000 rows (a NULL every 23rd, b every 19th, c every 29th); t2:
    // 800 (k NULL every 31st, v every 37th, s every 41st), an index on k;
    // t3: 300, no index; nn: no NULL value; e: empty
    show(mut &s, "create table t1 (id int primary key, a int, b text, c int, d numeric)")
    show(mut &s, "insert into t1 select g, case when g % 23 = 0 then null else g % 50 end, case when g % 19 = 0 then null else 'b' || (g % 30) end, case when g % 29 = 0 then null else g % 40 end, (g % 7) * 1.5 from generate_series(1, 3000) g")
    show(mut &s, "create table t2 (id int primary key, k int, v int, s text, w int)")
    show(mut &s, "insert into t2 select g, case when g % 31 = 0 then null else g % 35 end, case when g % 37 = 0 then null else (g * 7) % 45 end, case when g % 41 = 0 then null else 'b' || (g % 25) end, g % 3 from generate_series(1, 800) g")
    show(mut &s, "create index t2k on t2 (k)")
    show(mut &s, "create table t3 (id int primary key, k int, v int, s text)")
    show(mut &s, "insert into t3 select g, case when g % 17 = 0 then null else g % 30 end, case when g % 13 = 0 then null else (g * 11) % 48 end, case when g % 11 = 0 then null else 'b' || (g % 33) end from generate_series(1, 300) g")
    show(mut &s, "create table nn (id int primary key, k int, v int not null, s text not null)")
    show(mut &s, "insert into nn select g, g % 20, (g * 3) % 40, 'b' || (g % 20) from generate_series(1, 200) g")
    show(mut &s, "create table e (id int primary key, k int, v int, s text)")
    // lr: lines keyed by (order, line), an order's lines 0 to 5; tx: a text key
    show(mut &s, "create table lr (ok int, ln int, v int, primary key (ok, ln))")
    show(mut &s, "insert into lr select g / 6, g % 6, case when g % 7 = 0 then null else g % 9 end from generate_series(0, 239) g where g % 11 <> 3")
    show(mut &s, "create table tx (s text primary key, k int)")
    show(mut &s, "insert into tx select 'b' || g, g % 5 from generate_series(0, 40) g where g % 4 <> 1")
    show(mut &s, "analyze")
    var g = newGroup(&"notin", &"null-aware")
    let qs = [
        "select count(*) from t1 where a not in (select v from t2)",
        "select count(*), sum(a) from t1 where a not in (select v from t2 where v is not null)",
        "select id, a from t1 where a not in (select v from e) order by id limit 30",
        "select count(*), sum(a) from t1 where a not in (select v from t3 where t3.k = t1.c)",
        "select count(*), sum(a) from t1 where a not in (select v from t2 where t2.k = t1.c)",
        "select count(*) from t1 where b not in (select s from t3 where t3.k = t1.c)",
        "select count(*) from t1 where b not in (select s from nn)",
        "select id, a, c from t1 where c < 5 and a not in (select v from nn where nn.k = t1.c) order by id",
        "select count(*) from t1 where a <> all (select v from t3 where v is not null)",
        "select count(*) from t1 where d not in (select v from t3 where v is not null)",
        "select count(*) from t1 join t3 on t3.id = t1.id where t1.a not in (select v from nn where nn.k = t3.k)",
        "select count(*) from t1 where 1 / (id - 2500) >= 0 and a not in (select v from t3 where v is not null)",
        "select count(*) from t1 where a not in (select v from t3) and 1 / (id - 2500) >= 0",
        "select count(*) from t1 where (10 / (id - 2900)) not in (select v from t3 where v is not null)",
        "select count(*) from t1 where a not in (select 10 / (v - 3) from t2 where t2.k = t1.c)",
        "select count(*) from t1 where exists (select 1 from t3 where t3.id = t1.id and t3.v not in (select v from nn where nn.k = t1.c))",
        "select c, count(*) from t1 where a not in (select v from nn where nn.k = t1.c) group by c order by c",
        "select count(*) from t1 where a not in (select v from nn where nn.k = t1.c + 1) and b not in (select s from nn where nn.k = t1.c)",
        "select count(*) from t1 where a not in (select v from t3 order by v limit 5)",
        "select count(*) from t1 where a not in (select max(v) from t3 group by k)",
        "select count(*) from t1 where a not in (select v from t3 union select v from nn)",
        "select count(*) from t1 where a not in (select v from t3 where t3.k = t1.c order by v limit 2)",
        "select count(*) from t1 where a not in (select v from t3 where t3.k = t1.c and t3.v > t1.id % 7)",
        "select count(*) from t1 where c not in (select k from t2 where k is not null) or id < 10",
        "select id from t1 where id < 400 and a not in (select v from nn where nn.k = t1.c) order by a desc, id limit 7",
        "select count(*) from t1 where a not in (select v from t2 where t2.k = t1.c and t2.w = 1)",
        "select count(*) from t1 where a not in (select v from t2 where t2.k = t1.c) and id > 2000",
    ]
    for x in qs { check(mut &s, mut &g, &x) }
    report(&g)
    // in a transaction that wrote: no plan again by cost (its reads are noted)
    var gt = newGroup(&"notin in a transaction", &"null-aware")
    let b = run(mut &s, &"begin")
    let i = run(mut &s, &"insert into t3 values (1001, 5, null, 'zz'), (1002, null, 7, null)")
    for x in qs { if !strings.contains(&x, &" / ") { check(mut &s, mut &gt, &x) } }
    let r = run(mut &s, &"rollback")
    report(&gt)
    // a semi join's subquery that aggregates reads its aggregates' arguments
    // (narrowSub): against the same IN under OR (no semi join)
    let ia = run(mut &s, &"select count(*), sum(a) from t1 where a in (select max(v) from t3 group by k)")
    let ib = run(mut &s, &"select count(*), sum(a) from t1 where a in (select max(v) from t3 group by k) or false")
    println("in over an aggregate: " + ia + ", the same: " + (ia == ib).toStr())
    var gm = newGroup(&"mark", &"mark join")
    let ms = [
        "select count(*) from t1 where a = 3 or exists (select 1 from t3 where t3.k = t1.c)",
        "select count(*), sum(a) from t1 where a = 3 or a in (select v from t3 where t3.k = t1.c)",
        "select count(*) from t1 where (a in (select v from t3 where t3.k = t1.c)) is null",
        "select count(*) from t1 where (a in (select v from t3 where t3.k = t1.c)) is not true",
        "select count(*) from t1 where case when a > 10 then exists (select 1 from t3 where t3.k = t1.c) else b = 'b3' end",
        "select count(*) from t1 where a = 3 or exists (select 1 from t2 where t2.k = t1.c)",
        "select count(*) from t1 where a = 3 or a in (select v from t2 where t2.k = t1.c)",
        "select count(*) from t1 where b = 'b1' or b in (select s from t3 where t3.k = t1.c)",
        "select count(*) from t1 where exists (select 1 from t3 where t3.k = t1.c and t3.v > 40) or a in (select v from nn where nn.k = t1.c)",
        "select count(*) from t1 where 1 / (id - 2500) > 0 or exists (select 1 from t3 where t3.k = t1.c)",
        "select count(*) from t1 where a = 3 or exists (select 1 from t3 where t3.k = t1.c / (t1.id - 2500))",
        "select c, count(*) from t1 where a < 5 or exists (select 1 from t3 where t3.k = t1.c and t3.v < 3) group by c order by c",
        "select id from t1 where a < 2 or exists (select 1 from t3 where t3.k = t1.c and t3.v = 7) order by id limit 15",
        "select count(*) from t1 join t3 on t3.id = t1.id where t1.a = 1 or exists (select 1 from nn where nn.k = t3.k and nn.v = t1.a)",
        "select count(*) from t1 where not (exists (select 1 from t3 where t3.k = t1.c and t3.v > 20) and a > 5)",
        "select count(*) from t1 where a = 3 or exists (select 1 from e where e.k = t1.c)",
        "select count(*) from t1 where a = 3 or a in (select v from e where e.k = t1.c)",
        "select count(*) from t1 where c > 30 and (a = 3 or exists (select 1 from t3 where t3.k = t1.c))",
        "select count(*) from t1 where (a = 3 or exists (select 1 from t3 where t3.k = t1.c)) and c > 30",
        "select count(*) from t1 where (a = 3 or exists (select 1 from t3 where t3.k = t1.c)) and 1 / (id - 2900) >= 0",
        "select count(*) from t1 where a = 3 or exists (select 1 from t3 where t3.k = t1.c and t3.v / (t3.k - 5) > 1)",
        "select count(*) from t1 where a = 3 or exists (select 1 from t3 where t3.k = t1.c order by v limit 1)",
        "select id, exists (select 1 from t3 where t3.k = t1.c) from t1 where id < 100",
        "select id, a in (select v from t3 where t3.k = t1.c), a not in (select v from t3 where t3.k = t1.c) from t1 where id < 200 order by id",
        "select id, case when b in (select s from t3 where t3.k = t1.c) then 'y' else 'n' end from t1 order by id limit 50",
        "select distinct exists (select 1 from t3 where t3.k = t1.c) from t1",
        "select id from t1 where id < 300 order by exists (select 1 from t3 where t3.k = t1.c and t3.v > 30), id",
        "select id, exists (select 1 from t2 where t2.k = t1.c) from t1 where id < 50",
        "select c, count(*), exists (select 1 from t3 where t3.k = t1.c) from t1 group by c order by c",
        "select id, a in (select v from nn where nn.k = t1.c) from t1 where a = 4 or exists (select 1 from t3 where t3.k = t1.c and t3.v = 1)",
        "select id, exists (select 1 from t3 where t3.k = t1.c), 10 / (id - 2900) from t1",
        "select t1.id, t3.id, exists (select 1 from nn where nn.k = t3.k and nn.v = t1.a) from t1 join t3 on t3.id = t1.id + 5 order by t1.id",
        "select t1.id, (a in (select v from t3 where t3.k = t1.c)) is null from t1 left join nn on nn.id = t1.id where t1.id < 400 order by 1",
        "select id, exists (select 1 from t3 where t3.k = t1.c) from t1 order by id limit 7",
    ]
    for x in ms { check(mut &s, mut &gm, &x) }
    report(&gm)
    var gl = newGroup(&"look", &"looked up per row")
    let ls = [
        "select id, c from t1 where id < 20 and c in (select id from t3 where t3.v > 20) order by id",
        "select count(*) from t1 where id < 60 and c in (select id from t3)",
        "select id, a from t1 where id < 40 and a in (select id from t3 where t3.k = t1.c) order by id",
        "select id, b from t1 where id < 8 and b in (select s from tx where tx.k > 1) order by id",
        "select id, b from t1 where id < 50 and b in (select s from tx where tx.k = t1.c % 5) order by id",
        "select id from t1 where id < 8 and c in (select k from t2 where t2.v > 10) order by id",
        "select id from t1 where id < 40 and d in (select id from t3) order by id",
        "select count(*) from t1 where c in (select id from t3 where t3.v > 20)",
        "select id from t1 where id < 30 and c in (select id from e) order by id",
        "select id from t1 where id < 30 and c + 1 in (select id from t3 where t3.v is null) order by id",
        "select id from t1 where id < 30 and c in (select id from t3 where 10 / (t3.v - 8) > 0) order by id",
        "select id, c from t1 where id < 50 and exists (select 1 from lr where lr.ok = t1.c and lr.ln > 2) order by id",
        "select id, c from t1 where id < 50 and not exists (select 1 from lr where lr.ok = t1.c and lr.ln >= 4 and lr.v > 3) order by id",
        "select id, c from t1 where id < 50 and exists (select 1 from lr where lr.ok = t1.c and lr.ln > t1.a % 6) order by id",
        "select id, c from t1 where id < 50 and exists (select 1 from lr where lr.ok = t1.c and lr.ln between 1 and 3 and lr.v is null) order by id",
        "select count(*) from t1 where exists (select 1 from lr where lr.ok = t1.c and lr.ln < 2)",
        "select id, c from t1 where id < 4 and exists (select 1 from lr join nn on nn.k = lr.v where lr.ok = t1.c and nn.v > 10) order by id",
        "select id, c from t1 where id < 50 and not exists (select 1 from lr join nn on nn.k = lr.v where lr.ok = t1.c and nn.v > 30) order by id",
        "select id from t1 where id < 4 and exists (select 1 from t2 join nn on nn.s = t2.s where t2.k = t1.c and nn.v < 20) order by id",
        "select id from t1 where id < 30 and exists (select 1 from lr join nn on nn.k = lr.v where lr.ok = t1.c and nn.v / (nn.k - 3) > 1) order by id",
        "select id from t1 where id < 30 and exists (select 1 from lr join nn on nn.k = lr.v where lr.ok = t1.c and lr.ln + nn.v > 12) order by id",
        "select id from t1 where id < 30 and exists (select 1 from lr join e on e.k = lr.v where lr.ok = t1.c) order by id",
    ]
    for x in ls { check(mut &s, mut &gl, &x) }
    report(&gl)
    counts(mut &s, &"notin", &"select count(*) from t1 where a not in (select v from t3 where t3.k = t1.c)")
    counts(mut &s, &"mark or", &"select count(*) from t1 where a = 3 or a in (select v from t3 where t3.k = t1.c)")
    counts(mut &s, &"mark select list", &"select id, exists (select 1 from t3 where t3.k = t1.c) from t1 where id < 100")
    counts(mut &s, &"notin uncorrelated", &"select id from t1 where a not in (select v from nn) order by id")
    explain(mut &s, &"notin", &"select count(*) from t1 where a not in (select v from t2)")
    explain(mut &s, &"notin hashed", &"select count(*), sum(a) from t1 where a not in (select v from t3 where t3.k = t1.c)")
    explain(mut &s, &"notin by cost", &"select count(*), sum(a) from t1 where a not in (select v from t2 where t2.k = t1.c)")
    explain(mut &s, &"notin text", &"select count(*) from t1 where b not in (select s from t3 where t3.k = t1.c)")
    explain(mut &s, &"notin after a join", &"select count(*) from t1 join t3 on t3.id = t1.id where t1.a not in (select v from nn where nn.k = t3.k)")
    explain(mut &s, &"notin error after it", &"select count(*) from t1 where a not in (select v from t3) and 1 / (id - 2500) >= 0")
    explain(mut &s, &"notin error inside", &"select count(*) from t1 where a not in (select 10 / (v - 3) from t2 where t2.k = t1.c)")
    explain(mut &s, &"notin limit inside", &"select count(*) from t1 where a not in (select v from t3 where t3.k = t1.c order by v limit 2)")
    explain(mut &s, &"mark or", &"select count(*), sum(a) from t1 where a = 3 or a in (select v from t3 where t3.k = t1.c)")
    explain(mut &s, &"mark by cost", &"select count(*) from t1 where a = 3 or exists (select 1 from t2 where t2.k = t1.c)")
    explain(mut &s, &"mark two", &"select count(*) from t1 where exists (select 1 from t3 where t3.k = t1.c and t3.v > 40) or a in (select v from nn where nn.k = t1.c)")
    explain(mut &s, &"mark select list", &"select id, a in (select v from t3 where t3.k = t1.c), a not in (select v from t3 where t3.k = t1.c) from t1 where id < 200 order by id")
    explain(mut &s, &"mark order by", &"select id from t1 where id < 300 order by exists (select 1 from t3 where t3.k = t1.c and t3.v > 30), id")
    explain(mut &s, &"mark key may fail", &"select count(*) from t1 where a = 3 or exists (select 1 from t3 where t3.k = t1.c / (t1.id - 2500))")
    explain(mut &s, &"look in", &"select id, c from t1 where id < 20 and c in (select id from t3 where t3.v > 20) order by id")
    explain(mut &s, &"look in hashed", &"select id, a from t1 where id < 40 and a in (select id from t3 where t3.k = t1.c) order by id")
    explain(mut &s, &"look in text", &"select id, b from t1 where id < 8 and b in (select s from tx where tx.k > 1) order by id")
    explain(mut &s, &"look in index", &"select id from t1 where id < 8 and c in (select k from t2 where t2.v > 10) order by id")
    explain(mut &s, &"look in many rows", &"select count(*) from t1 where c in (select id from t3 where t3.v > 20)")
    explain(mut &s, &"look range", &"select id, c from t1 where id < 50 and exists (select 1 from lr where lr.ok = t1.c and lr.ln > 2) order by id")
    explain(mut &s, &"look range outer", &"select id, c from t1 where id < 50 and exists (select 1 from lr where lr.ok = t1.c and lr.ln > t1.a % 6) order by id")
    explain(mut &s, &"look two tables", &"select id, c from t1 where id < 4 and exists (select 1 from lr join nn on nn.k = lr.v where lr.ok = t1.c and nn.v > 10) order by id")
    explain(mut &s, &"look two tables text", &"select id from t1 where id < 4 and exists (select 1 from t2 join nn on nn.s = t2.s where t2.k = t1.c and nn.v < 20) order by id")
    explain(mut &s, &"mark grouped", &"select c, count(*), exists (select 1 from t3 where t3.k = t1.c) from t1 group by c order by c")
    return 0
}

// EXPLAIN ANALYZE's counts with batches on and off (but "batches N").
fn counts(s: mut &lexdb_exec.Session, label: &str, sql: &str) {
    lexdb_plan.setUnnest(ALL)
    let a = run(s, &"set lexdb_batch = off")
    let off = planOf(s, sql, true)
    let b = run(s, &"set lexdb_batch = on")
    let on = planOf(s, sql, true)
    let ok = dropNum(&on, &", batches ") == dropNum(&off, &", batches ")
    println("counts " + label + ": same: " + ok.toStr())
    if !ok {
        println("  off: " + off)
        println("  on:  " + on)
    }
}

// s without each pre and the digits after it.
fn dropNum(s: &str, pre: &str): str {
    let parts = strings.split(s, pre)
    var out = "" + parts[0]
    for i in 1..len(parts) {
        let p = parts[i]
        var j = 0
        while j < len(p) && p[j] >= '0' && p[j] <= '9' { j += 1 }
        out = out + strings.substr(&p, j, len(p))
    }
    return out
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
