// expect: same: constraint_name,check_clause = d1_neg|(not exists (select 1 from d1 where v < 0));log_pos|(all (select v from logt) satisfy (v >= 0));sal_pos|(not exists (select 1 from emp where sal < 0))
// expect: same: n = 0 // n = 0 // o = NULL
// expect: reopened: error 23514 assertion "sal_pos" is violated / error 23514 assertion "d1_big" is violated / any_dept;big_pos;d1_big;d1_neg;in_budget;kc_any;log_pos;sal_pos
import "strings"
import "task"
import "net"
import "tds"
import "sqldialect"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
