// lexdb over TNS: the operators over an aggregate's groups (HAVING, the select list, DISTINCT, ORDER BY, FETCH FIRST and
// OFFSET: Q8's R7, design/lexdb-layers.md 6.3.Q8 R7 as built (group views, FOR UPDATE)) and FOR UPDATE's lock operator
// through the Oracle door, checked against Oracle Database Free (gen_oracle.py --check: the answers below are Oracle's):
// GROUP BY with FETCH FIRST (ONLY, WITH TIES) and OFFSET; HAVING (a subquery run once in it); DISTINCT; ROLLUP, CUBE and
// GROUPING SETS with HAVING; joins, a CTE; errors in a later group (ORA-01476), in HAVING, and none in a group HAVING
// drops; correlated subqueries in an output and ORDER BY; window calls over the groups; an empty input; FOR UPDATE, NOWAIT
// and SKIP LOCKED (one session: every row locked, none skipped), over a join, in a transaction, an error in a later row.
// Each statement runs with set lexdb_batch = off (the row engine) and on: "same" and the answer, or DIFFERENT and both.
// expect: setup: 21 statements
// expect: same: G,C,S,LO = 0|428|9345|'Ab';1|429|9522|'Ab';2|429|9649|'Ab';3|429|9576|'Ab';4|429|9414|'Ab';5|428|9554|'Ab';6|428|9744|'Ab'
// expect: same: G,S = 6|9744;2|9649;3|9576
// expect: same: T,C = 'Ab'|924;'ab'|923
// expect: same: G,S = 1|50430.5;2|50918.75;3|50171;4|50439
// expect: same: C = 428;429
// expect: same: G,C = 2|429;3|429;4|429
// expect: same: NAME,C,M = 'five'|428|49;'four'|429|49;'one'|429|49;'three'|429|49;'two'|429|49;'zero'|428|49
// expect: same: error 1476
// expect: same: error 1476
// expect: same: G,Q = 0|-3.3333;1|-5;2|-10;4|10;5|5;6|3.3333
// expect: same: G,T,C = NULL|NULL|30;0|'Ab'|1;0|'ab'|2;0|'b2'|1;0|NULL|4;1|'Ab'|1;1|'ab'|2;1|'b0'|1;1|'b1'|1;1|NULL|5;2|'Ab'|2;2|'ab'|1;2|'b2'|1;2|'b3'|1;2|NULL|5;3|'Ab'|2;3|'ab'|1;3|'b1'|1;3|NULL|4;4|'Ab'|1;4|'ab'|2;4|'b3'|1;4|NULL|4;5|NULL|1;5|'Ab'|1;5|'ab'|1;5|'b1'|1;5|NULL|4;6|NULL|1;6|'Ab'|2;6|'b0'|1;6|NULL|4
// expect: same: G,C,GG = 1|429|0;2|429|0;3|429|0;4|429|0;NULL|3000|1
// expect: same: G,P,C = NULL|NULL|20;NULL|0|10;NULL|1|10;0|NULL|2;0|0|1;0|1|1;1|NULL|3;1|0|1;1|1|2;2|NULL|3;2|0|2;2|1|1;3|NULL|3;3|0|1;3|1|2;4|NULL|3;4|0|2;4|1|1;5|NULL|3;5|0|1;5|1|2;6|NULL|3;6|0|2;6|1|1
// expect: same: C,S = 0|NULL
// expect: same: X,C = 
// expect: same: G,NAME,C = 0|'zero'|428;1|'one'|429;2|'two'|429;3|'three'|429;4|'four'|429;5|'five'|428;6|NULL|428
// expect: same: G,C = 6|428;5|428;4|429;1|429;3|429;2|429;0|428
// expect: same: T,C = NULL|230;'Ab'|924;'ab'|923;'b0'|231;'b1'|231;'b2'|230;'b3'|231
// expect: same: G,C,R = 0|428|5;1|429|1;2|429|2;3|429|3;4|429|4;5|428|6;6|428|7
// expect: same: M,LO = 3000|1
// expect: same: P,C = 0|1714
// expect: same: G,D = 0|6;1|6;2|6;3|6;4|6;5|6;6|6
// expect: same: G,S = 3|281;0|296;1|323;2|327;4|328;5|338;6|342
// expect: same: G,S = 4|1373;1|1363;5|1314;6|1253
// expect: same: G,C = 
// expect: same: G,C = 2|429;3|429;4|429
// expect: same: ID,X = 1|37;2|24;3|11;4|48;5|35
// expect: same: ID = 14;13;12;11;10
// expect: same: ID = 1;2;4;5;6
// expect: same: ID,NAME = 1|'one';2|'two';3|'three';4|'four'
// expect: same: ID,X = 1|37;2|24;3|11 / N = 3
// expect: same: ID = 7;8
