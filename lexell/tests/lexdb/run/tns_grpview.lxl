import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table dg (i number(10))\ninsert into dg values (0)\ninsert into dg values (1)\ninsert into dg values (2)\ninsert into dg values (3)\ninsert into dg values (4)\ninsert into dg values (5)\ninsert into dg values (6)\ninsert into dg values (7)\ninsert into dg values (8)\ninsert into dg values (9)\ncreate table wt (id number(10) primary key, g number(10), x number(10), t varchar2(10), n number(10,2))\ninsert into wt select n, mod(n, 7), case when mod(n, 11) = 0 then null else mod(n * 37, 50) end, case when mod(n, 13) = 0 then null when mod(n, 3) = 0 then 'Ab' when mod(n, 3) = 1 then 'ab' else 'b' || mod(n, 4) end, case when mod(n, 17) = 0 then null else mod(n * 7, 1000) / 4 end from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 3000\ncreate table kt (g number(10) primary key, name varchar2(10))\ninsert into kt values (0, 'zero')\ninsert into kt values (1, 'one')\ninsert into kt values (2, 'two')\ninsert into kt values (3, 'three')\ninsert into kt values (4, 'four')\ninsert into kt values (5, 'five')\ncreate table et (id number(10) primary key, x number(10))"

const QS = "select g, count(*) c, sum(x) s, min(t) lo from wt group by g order by g\nselect g, sum(x) s from wt group by g order by s desc fetch first 3 rows only\nselect t, count(*) c from wt where t is not null group by t order by c desc fetch first 2 rows with ties\nselect g, sum(n) s from wt group by g having count(*) > 428 order by g\nselect distinct count(*) c from wt group by g order by c\nselect g, count(*) c from wt group by g order by g offset 2 rows fetch next 3 rows only\nselect kt.name, count(*) c, max(wt.x) m from wt join kt on kt.g = wt.g group by kt.name having max(wt.x) > 40 order by kt.name\nselect g, 10 / (g - 3) q from wt group by g order by g\nselect g, count(*) c from wt group by g having 10 / (g - 4) > 0\nselect g, trunc(10 / (g - 3), 4) q from wt group by g having g <> 3 order by g\nselect g, t, count(*) c from wt where id <= 30 group by rollup (g, t) order by g nulls first, grouping(t), t nulls first\nselect g, count(*) c, grouping(g) gg from wt group by grouping sets ((g), ()) having count(*) > 428 order by gg, g\nselect g, mod(id, 2) p, count(*) c from wt where id <= 20 group by cube (g, mod(id, 2)) order by g nulls first, p nulls first\nselect count(*) c, sum(x) s from et\nselect x, count(*) c from et group by x\nselect g, (select name from kt where kt.g = wt.g) name, count(*) c from wt group by g order by g\nselect g, count(*) c from wt group by g order by (select name from kt where kt.g = wt.g) nulls first, g\nselect t, count(*) c from wt group by t order by t nulls first\nselect g, count(*) c, rank() over (order by count(*) desc, g) r from wt group by g order by g\nselect max(id) m, min(id) lo from wt\nselect mod(g, 2) p, count(*) c from wt group by mod(g, 2) order by c desc fetch first 1 rows with ties\nselect g, count(distinct t) d from wt group by g order by d desc, g\nselect g, sum(x) s from wt where id <= 100 group by g having sum(x) > (select count(*) * 30 from kt) order by s\nwith c as (select g, x from wt where id <= 400) select g, sum(x) s from c group by g order by s desc fetch first 4 rows only\nselect g, count(*) c from wt where id < 0 group by g order by g\nselect g, count(*) c from wt group by g having count(*) > 428 order by c desc, g offset 1 rows\nselect id, x from wt where id <= 5 order by id for update\nselect id from wt where id between 10 and 14 order by id desc for update nowait\nselect id from wt where id <= 6 and x > 20 order by id for update skip locked\nselect wt.id, kt.name from wt join kt on kt.g = wt.g where wt.id <= 4 order by wt.id for update\nselect id, x from wt where id <= 3 order by id for update ;; select count(*) n from wt where id <= 3\nselect id from wt where id in (7, 8, 3001) order by id for update\nselect id, 10 / (id - 2999) q from wt order by id for update"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(58), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
