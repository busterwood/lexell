// lexdb over TDS: what applications send, checked against SQL Server 2022
// (generated by tests/lexdb/gen_mssql.py from mssql_app_queries.txt): EF Core's
// tables, inserts, updates and deletes with OUTPUT, its queries (APPLY, paging,
// EXISTS, ROW_NUMBER), SQL Server's UPDATE and DELETE with joins, table hints,
// dbo. Each expect line: a batch's result sets and counts, or its error number.
// expect: ok
// expect: ok
// expect: ok
// expect: Id: 1
// expect: Id,Rating: 2|4.5
// expect: (3)
// expect: (1) / : 1
// expect: Id,Name,Url: 1|'Uno'|'http://one';2|'Two'|'http://two'
// expect: (1) / Title: 'b'
// expect: Id,Name: 1|'Uno'
// expect: : true
// expect: ,: 3|3
// expect: Name,PostCount: 'Uno'|2;'Two'|1
// expect: Id,Title: 1|'a';1|'b';2|'c'
// expect: Id,Title: 1|'b';2|'c'
// expect: Id,Title: 1|'a';1|'b';2|'c'
// expect: Title,rn: 'a'|1;'c'|1
// expect: Title: 'b'
// expect: : '2024-01-01 00:00:00.0000000';'1900-01-01 00:00:00.0000000';'2024-02-01 00:00:00.0000000'
// expect: (1)
// expect: (2)
// expect: Title: 'a!';'b!';'Two: c'
// expect: (1)
// expect: : 2
// expect: Id,Name: 2|'Two'
// expect: : 
// expect: Rating,Rating: 1.0|0.0
// expect: Id: 1
// expect: : 10
// expect: Url: 'http://one'
// expect: : 2024;NULL
// expect: (1) / Id,Rating: 3|0.0
// expect: error 547
// expect: Id,Name,Url,Rating: 1|'Uno'|'http://one'|1.0
// expect: Id,Name: 1|'Uno'
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "CREATE TABLE [Blogs] ([Id] int NOT NULL IDENTITY, [Name] nvarchar(max) NULL, [Url] nvarchar(200) NOT NULL, [Rating] decimal(3,1) NOT NULL DEFAULT 0.0, CONSTRAINT [PK_Blogs] PRIMARY KEY ([Id]))\nCREATE TABLE [Posts] ([Id] int NOT NULL IDENTITY, [Title] nvarchar(100) NOT NULL, [BlogId] int NOT NULL, [Published] datetime2 NULL, CONSTRAINT [PK_Posts] PRIMARY KEY ([Id]), CONSTRAINT [FK_Posts_Blogs_BlogId] FOREIGN KEY ([BlogId]) REFERENCES [Blogs] ([Id]) ON DELETE CASCADE)\nCREATE INDEX [IX_Posts_BlogId] ON [Posts] ([BlogId])\nSET NOCOUNT ON; INSERT INTO [Blogs] ([Name], [Url]) OUTPUT INSERTED.[Id] VALUES (N'One', N'http://one');\nSET NOCOUNT ON; INSERT INTO [Blogs] ([Name], [Url], [Rating]) OUTPUT INSERTED.[Id], INSERTED.[Rating] VALUES (N'Two', N'http://two', 4.5);\nSET NOCOUNT OFF; INSERT INTO [Posts] ([Title], [BlogId], [Published]) VALUES (N'a', 1, '2024-01-01'), (N'b', 1, NULL), (N'c', 2, '2024-02-01')\nDECLARE @p0 nvarchar(4000) = N'Uno', @p1 int = 1; SET NOCOUNT ON; UPDATE [Blogs] SET [Name] = @p0 OUTPUT 1 WHERE [Id] = @p1; SET NOCOUNT OFF\nSELECT [b].[Id], [b].[Name], [b].[Url] FROM [Blogs] AS [b] ORDER BY [b].[Id]\nDECLARE @__p_0 int = 1, @__p_1 int = 1; SELECT [p].[Title] FROM [Posts] AS [p] ORDER BY [p].[Id] OFFSET @__p_0 ROWS FETCH NEXT @__p_1 ROWS ONLY\nSELECT TOP(1) [b].[Id], [b].[Name] FROM [Blogs] AS [b] WHERE [b].[Name] LIKE N'%n%'\nSELECT CASE WHEN EXISTS (SELECT 1 FROM [Posts] AS [p] WHERE [p].[BlogId] = 2) THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END\nSELECT COUNT(*), COUNT_BIG(*) FROM [Posts]\nSELECT [b].[Name], (SELECT COUNT(*) FROM [Posts] AS [p] WHERE [b].[Id] = [p].[BlogId]) AS [PostCount] FROM [Blogs] AS [b] ORDER BY [b].[Id]\nSELECT [b].[Id], [p].[Title] FROM [Blogs] AS [b] LEFT JOIN [Posts] AS [p] ON [b].[Id] = [p].[BlogId] ORDER BY [b].[Id], [p].[Id]\nSELECT [b].[Id], [t].[Title] FROM [Blogs] AS [b] OUTER APPLY (SELECT TOP(1) [p].[Title] FROM [Posts] AS [p] WHERE [p].[BlogId] = [b].[Id] ORDER BY [p].[Id] DESC) AS [t] ORDER BY [b].[Id]\nSELECT [b].[Id], [t].[Title] FROM [Blogs] AS [b] CROSS APPLY (SELECT [p].[Title] FROM [Posts] AS [p] WHERE [p].[BlogId] = [b].[Id]) AS [t] ORDER BY [b].[Id], [t].[Title]\nSELECT [t].[Title], [t].[rn] FROM (SELECT [p].[Title], ROW_NUMBER() OVER(PARTITION BY [p].[BlogId] ORDER BY [p].[Id]) AS [rn] FROM [Posts] AS [p]) AS [t] WHERE [t].[rn] <= 1 ORDER BY [t].[Title]\nSELECT [p].[Title] FROM [Posts] AS [p] WHERE [p].[Title] LIKE N'a!%' ESCAPE N'!' OR [p].[Published] IS NULL ORDER BY [p].[Title]\nSELECT COALESCE([p].[Published], '1900-01-01') FROM [Posts] AS [p] ORDER BY [p].[Id]\nUPDATE [p] SET [p].[Title] = [b].[Name] + N': ' + [p].[Title] FROM [Posts] AS [p] INNER JOIN [Blogs] AS [b] ON [p].[BlogId] = [b].[Id] WHERE [b].[Id] = 2\nUPDATE Posts SET Title = Title + N'!' FROM Posts JOIN Blogs ON Blogs.Id = Posts.BlogId WHERE Blogs.Name = N'Uno'\nSELECT [Title] FROM [Posts] ORDER BY [Id]\nDELETE [p] FROM [Posts] AS [p] INNER JOIN [Blogs] AS [b] ON [p].[BlogId] = [b].[Id] WHERE [b].[Rating] > 1\nSELECT COUNT(*) FROM [Posts]\nSET NOCOUNT ON; DELETE FROM [Blogs] OUTPUT DELETED.[Id], DELETED.[Name] WHERE [Id] = 2; SET NOCOUNT OFF\nDELETE FROM [Blogs] OUTPUT 1 WHERE [Id] = 99\nUPDATE [Blogs] SET [Rating] = [Rating] + 1 OUTPUT INSERTED.[Rating], DELETED.[Rating] WHERE [Id] = 1\nSELECT [b].[Id] FROM [Blogs] AS [b] WHERE [b].[Id] IN (1, 2, 3) AND [b].[Name] IS NOT NULL\nSELECT CAST(LEN([b].[Url]) AS int) FROM [Blogs] AS [b]\nSELECT [b].[Url] FROM [Blogs] AS [b] WHERE CHARINDEX(N'ONE', [b].[Url]) > 0\nSELECT DATEPART(year, [p].[Published]) FROM [Posts] AS [p] ORDER BY [p].[Id]\nINSERT INTO [Blogs] ([Url]) VALUES (N'http://three'); SELECT [Id], [Rating] FROM [Blogs] WHERE @@ROWCOUNT = 1 AND [Id] = scope_identity();\nINSERT INTO [Posts] ([Title], [BlogId]) VALUES (N'orphan', 42)\nSELECT * FROM [Blogs] WITH (NOLOCK) WHERE [Id] = 1\nSELECT [b].[Id], [b].[Name] FROM [dbo].[Blogs] AS [b] WHERE [b].[Id] = 1"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(32), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
