import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@oracle create login lxu1 with password = 'Lx_Pw0rd_7x'\n@oracle create login lxu2 with password = 'Lx_Pw0rd_7x'\n@oracle create user lxu1 for login lxu1\n@oracle create user lxu2 for login lxu2\n@lexdb create role lxu1 login\n@lexdb create role lxu2 login\ncreate table t (id int primary key, v int)\ninsert into t values (1, 10), (2, 20)\ncreate procedure p1 @a int as select v from t where id = @a\ncreate procedure p2 as select 1 as one\ncreate function f1(@x int) returns int as begin return @x + 1 end\ncreate function tv1(@x int) returns table as return select id, v from t where id = @x\ncreate schema s1\ncreate procedure s1.p3 as select 3 as three\n@as lxu1 exec p1 1\n@as lxu1 exec dbo.p1 1\n@as lxu1 select dbo.f1(1)\n@as lxu1 select * from dbo.tv1(1)\n@as lxu1 exec s1.p3\n@as lxu1 select * from t\ngrant execute on p1 to lxu1\n@as lxu1 exec p1 1\n@as lxu1 exec p1 3\n@as lxu1 select * from t\n@as lxu2 exec p1 1\n@as lxu1 exec p2\n@as lxu1 grant execute on p1 to lxu2\n@as lxu1 grant execute on p2 to lxu2\ngrant exec on object::dbo.p2 to lxu2\n@as lxu2 exec p2\n@as lxu2 exec p1 1\n@as lxu1 select has_perms_by_name('dbo.p1', 'OBJECT', 'EXECUTE'), has_perms_by_name('dbo.p2', 'OBJECT', 'EXECUTE')\n@as lxu2 select has_perms_by_name('dbo.p1', 'OBJECT', 'EXECUTE'), has_perms_by_name('dbo.p2', 'OBJECT', 'EXECUTE')\nselect o.name, p.name, dp.class, dp.class_desc, dp.permission_name, dp.state, dp.state_desc, dp.type, g.name from sys.database_permissions dp join sys.objects o on o.object_id = dp.major_id join sys.database_principals p on p.principal_id = dp.grantee_principal_id join sys.database_principals g on g.principal_id = dp.grantor_principal_id where dp.class = 1 order by o.name, p.name\ngrant execute on f1 to lxu1\n@as lxu1 select dbo.f1(1)\ngrant select on tv1 to lxu1\n@as lxu1 select * from dbo.tv1(1)\n@as lxu1 select * from dbo.tv1(2)\ngrant select on p2 to lxu1\ngrant select on f1 to lxu1\ngrant execute on tv1 to lxu1\ngrant execute, select on p2 to lxu1\ngrant execute on t to lxu1\ngrant execute on nothing to lxu1\ngrant execute on p2 to nobody\ngrant all on p2 to lxu1\n@as lxu1 exec p2\nselect p.name, dp.permission_name from sys.database_permissions dp join sys.objects o on o.object_id = dp.major_id join sys.database_principals p on p.principal_id = dp.grantee_principal_id where dp.class = 1 and o.name = 'p2' order by 1, 2\nrevoke execute on p2 from lxu1\n@as lxu1 exec p2\nrevoke execute on p2 to lxu2\n@as lxu2 exec p2\ngrant execute on p2 to public\n@as lxu2 exec p2\nselect p.name, dp.permission_name from sys.database_permissions dp join sys.objects o on o.object_id = dp.major_id join sys.database_principals p on p.principal_id = dp.grantee_principal_id where dp.class = 1 and o.name = 'p2' order by 1, 2\nrevoke execute on p2 from public\n@as lxu2 exec p2\ncreate or alter procedure p1 @a int as select v + 1 as v from t where id = @a\n@as lxu1 exec p1 1\nalter procedure p1 @a int as select v + 2 as v from t where id = @a\n@as lxu1 exec p1 1\ndrop procedure p1\ncreate procedure p1 @a int as select v from t where id = @a\n@as lxu1 exec p1 1\ngrant execute on p1 to lxu1\n@as lxu1 exec p1 2\ndrop procedure p1\n@as lxu1 exec p1 2\nselect count(*) from sys.database_permissions dp join sys.database_principals p on p.principal_id = dp.grantee_principal_id where dp.class = 1 and p.name like 'lxu%' and dp.major_id in (select object_id from sys.objects where name = 'p1')\n@as lxu1 select * from t\ncreate procedure pr @a int as insert into t values (@a, @a * 10)\ngrant execute on pr to lxu1\n@as lxu1 exec pr 5\n@as lxu1 insert into t values (6, 60)\nselect * from t order by id\ncreate procedure pn as exec p2\ngrant execute on pn to lxu1\n@as lxu1 exec pn\n@as lxu1 exec p2\nselect p.name, o.name, dp.permission_name from sys.database_permissions dp join sys.objects o on o.object_id = dp.major_id join sys.database_principals p on p.principal_id = dp.grantee_principal_id where dp.class = 1 order by 1, 2, 3\ngrant select on t to lxu1\n@as lxu1 grant select on t to lxu2\n@as lxu1 select count(*) from t\nrevoke select on t from lxu1\n@as lxu1 revoke execute on pn from lxu1\nrevoke execute on nothing from lxu1\n@as lxu1 select has_perms_by_name('dbo.pn', 'OBJECT', 'EXECUTE')\nselect has_perms_by_name('dbo.pn', 'OBJECT', 'EXECUTE')"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(44), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
