// lexdb_exec: ANALYZE's statistics (optimizer 20). ANALYZE [table] counts each
// table's rows and, per index, the distinct values of each leading prefix.
// The planner takes the path with the fewer expected rows (here, a tie the
// rules leave between indexes; exec_estimates has the rest, optimizer 24). SET
// lexdb_planner = rules turns them off. Temporary tables' statistics are
// their session's (optimizer 40); a role named as a table keeps its row.
// Checked by hand.
// expect: -- ev: 1000 rows; kind 1 for 990 of them, uid 100 values
// expect: create table ev (id int primary key, kind int, uid int) -> CREATE TABLE
// expect: insert into ev select g, case when g <= 990 then 1 else 2 end, g % 100 from generate_series(1, 1000) g -> INSERT 0 1000
// expect: create index ev_kind on ev (kind) -> CREATE INDEX
// expect: create index ev_uid on ev (uid) -> CREATE INDEX
// expect: explain select id from ev where kind = 1 and uid = 5 -> [QUERY PLAN] scan ev: index ev_kind lookup
// expect: analyze ev -> ANALYZE
// expect: explain select id from ev where kind = 1 and uid = 5 -> [QUERY PLAN] scan ev: index ev_uid lookup (estimated 10 rows)
// expect: explain analyze select id from ev where kind = 1 and uid = 5 -> scan ev: index ev_uid lookup (estimated 10 rows) (rows read 10, kept 10, batches 1)
// expect: select count(*) from ev where kind = 1 and uid = 5 -> [count] 10
// expect: explain select id from ev where kind = 2 -> [QUERY PLAN] scan ev: index ev_kind lookup, index only (estimated 10 rows)
// expect: explain select id from ev where kind = 2 and uid = 5 -> [QUERY PLAN] scan ev: index ev_kind lookup (estimated 10 rows)
// expect: -- the rules, by SET; RESET gives cost back
// expect: show lexdb_planner -> [lexdb_planner] cost
// expect: set lexdb_planner = rules -> SET
// expect: show lexdb_planner -> [lexdb_planner] rules
// expect: explain select id from ev where kind = 1 and uid = 5 -> [QUERY PLAN] scan ev: index ev_kind lookup
// expect: select count(*) from ev where kind = 1 and uid = 5 -> [count] 10
// expect: reset lexdb_planner -> RESET
// expect: explain select id from ev where kind = 1 and uid = 5 -> [QUERY PLAN] scan ev: index ev_uid lookup (estimated 10 rows)
// expect: set lexdb_planner = 'fast' -> 22023 invalid value for parameter "lexdb_planner": use cost or rules
// expect: -- a SET in a block is undone by its ROLLBACK
// expect: begin -> BEGIN
// expect: set lexdb_planner = 'rules' -> SET
// expect: explain select id from ev where kind = 1 and uid = 5 -> [QUERY PLAN] scan ev: index ev_kind lookup
// expect: rollback -> ROLLBACK
// expect: show lexdb_planner -> [lexdb_planner] cost
// expect: -- RESET ALL in a block gives cost back to the block too
// expect: begin -> BEGIN
// expect: set lexdb_planner = rules -> SET
// expect: reset all -> RESET
// expect: explain select id from ev where kind = 1 and uid = 5 -> [QUERY PLAN] scan ev: index ev_uid lookup (estimated 10 rows)
// expect: rollback -> ROLLBACK
// expect: -- a renamed table keeps its statistics
// expect: alter table ev rename to ev2 -> ALTER TABLE
// expect: explain select id from ev2 where kind = 1 and uid = 5 -> [QUERY PLAN] scan ev2: index ev_uid lookup (estimated 10 rows)
// expect: -- uniqueness the rules cannot see: c unique in the data, not declared
// expect: create table t (id int primary key, a int, c int) -> CREATE TABLE
// expect: insert into t select g, g % 2, g from generate_series(1, 2000) g -> INSERT 0 2000
// expect: create index t_a on t (a) -> CREATE INDEX
// expect: create index t_c on t (c) -> CREATE INDEX
// expect: explain select id from t where a = 1 and c = 7 -> [QUERY PLAN] scan t: index t_a lookup
// expect: analyze -> ANALYZE
// expect: explain select id from t where a = 1 and c = 7 -> [QUERY PLAN] scan t: index t_c lookup (estimated 1 rows)
// expect: select id from t where a = 1 and c = 7 -> [id] 7
// expect: -- statistics of a dropped table are not used by a new one of the name
// expect: drop table t -> DROP TABLE
// expect: create table t (id int primary key, a int, c int) -> CREATE TABLE
// expect: create index t_a on t (a) -> CREATE INDEX
// expect: create index t_c on t (c) -> CREATE INDEX
// expect: explain select id from t where a = 1 and c = 7 -> [QUERY PLAN] scan t: index t_a lookup
// expect: -- an ANALYZE in a block that rolls back leaves no statistics
// expect: insert into t select g, g % 2, g from generate_series(1, 2000) g -> INSERT 0 2000
// expect: begin -> BEGIN
// expect: analyze t -> ANALYZE
// expect: explain select id from t where a = 1 and c = 7 -> [QUERY PLAN] scan t: index t_c lookup (estimated 1 rows)
// expect: rollback -> ROLLBACK
// expect: explain select id from t where a = 1 and c = 7 -> [QUERY PLAN] scan t: index t_a lookup
// expect: -- errors
// expect: analyze nope -> 42P01 relation "nope" does not exist
// expect: -- SHOW ALL lists the lexdb settings (it panicked on lexdb_batch before)
// expect: show lexdb_batch -> [lexdb_batch] on
// expect: show all -> [name,setting] max_recursion|1000; statement_timeout|0; max_statement_mem|262144kB; search_path|public; lexdb_batch|on; lexdb_planner|cost; lexdb_autoanalyze|on
// expect: -- temporary tables (optimizer 40): another session's are not analyzed; one's own are, and
// expect: -- neither that nor dropping it conflicts with another session's block that read the catalog
// expect: create temp table tt (id int primary key, k int, j int) -> CREATE TABLE
// expect: insert into tt select g, g % 50, g % 7 from generate_series(1, 700) g -> INSERT 0 700
// expect: create index tt_k on tt (k) -> CREATE INDEX
// expect: create index tt_j on tt (j) -> CREATE INDEX
// expect: analyze -> ANALYZE
// expect: explain select id from tt where k = 3 and j = 4 -> [QUERY PLAN] scan tt: index tt_k lookup
// expect: begin -> BEGIN
// expect: select count(*) from pg_class where relname = 't' -> [count] 1
// expect: update t set a = a where id = 1 -> UPDATE 1
// expect: analyze tt -> ANALYZE
// expect: analyze -> ANALYZE
// expect: explain select id from tt where k = 3 and j = 4 -> [QUERY PLAN] scan tt: index tt_k lookup (estimated 14 rows)
// expect: drop table tt -> DROP TABLE
// expect: commit -> COMMIT
// expect: -- a role named as a table: ANALYZE and DROP TABLE leave it (statistics were under the roles' prefix)
// expect: create role t login password 'pw' -> CREATE ROLE
// expect: select count(*) from pg_roles -> [count] 2
// expect: analyze -> ANALYZE
// expect: select rolname, rolcanlogin from pg_roles where rolname = 't' -> [rolname,rolcanlogin] t|t
// expect: select count(*) from pg_roles -> [count] 2
// expect: drop table t -> DROP TABLE
// expect: select rolname, rolcanlogin from pg_roles where rolname = 't' -> [rolname,rolcanlogin] t|t
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"

fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows {
                println(sql + " -> " + r.tag)
                return
            }
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name) }
            println(sql + " -> [" + strings.join(&names, ",") + "]" + (if len(lines) > 0 { " " } else { "" }) + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

// EXPLAIN ANALYZE without its last line (the time).
fn analyze(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for i in 0..len(r.rows) - 1 { append(mut &lines, lexdb_exec.text(&r.rows[i][0])) }
            println(sql + " -> " + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    println("-- ev: 1000 rows; kind 1 for 990 of them, uid 100 values")
    show(mut &s, "create table ev (id int primary key, kind int, uid int)")
    show(mut &s, "insert into ev select g, case when g <= 990 then 1 else 2 end, g % 100 from generate_series(1, 1000) g")
    show(mut &s, "create index ev_kind on ev (kind)")
    show(mut &s, "create index ev_uid on ev (uid)")
    show(mut &s, "explain select id from ev where kind = 1 and uid = 5")
    show(mut &s, "analyze ev")
    show(mut &s, "explain select id from ev where kind = 1 and uid = 5")
    analyze(mut &s, "explain analyze select id from ev where kind = 1 and uid = 5")
    show(mut &s, "select count(*) from ev where kind = 1 and uid = 5")
    show(mut &s, "explain select id from ev where kind = 2")
    show(mut &s, "explain select id from ev where kind = 2 and uid = 5")
    println("-- the rules, by SET; RESET gives cost back")
    show(mut &s, "show lexdb_planner")
    show(mut &s, "set lexdb_planner = rules")
    show(mut &s, "show lexdb_planner")
    show(mut &s, "explain select id from ev where kind = 1 and uid = 5")
    show(mut &s, "select count(*) from ev where kind = 1 and uid = 5")
    show(mut &s, "reset lexdb_planner")
    show(mut &s, "explain select id from ev where kind = 1 and uid = 5")
    show(mut &s, "set lexdb_planner = 'fast'")
    println("-- a SET in a block is undone by its ROLLBACK")
    show(mut &s, "begin")
    show(mut &s, "set lexdb_planner = 'rules'")
    show(mut &s, "explain select id from ev where kind = 1 and uid = 5")
    show(mut &s, "rollback")
    show(mut &s, "show lexdb_planner")
    println("-- RESET ALL in a block gives cost back to the block too")
    show(mut &s, "begin")
    show(mut &s, "set lexdb_planner = rules")
    show(mut &s, "reset all")
    show(mut &s, "explain select id from ev where kind = 1 and uid = 5")
    show(mut &s, "rollback")
    println("-- a renamed table keeps its statistics")
    show(mut &s, "alter table ev rename to ev2")
    show(mut &s, "explain select id from ev2 where kind = 1 and uid = 5")
    println("-- uniqueness the rules cannot see: c unique in the data, not declared")
    show(mut &s, "create table t (id int primary key, a int, c int)")
    show(mut &s, "insert into t select g, g % 2, g from generate_series(1, 2000) g")
    show(mut &s, "create index t_a on t (a)")
    show(mut &s, "create index t_c on t (c)")
    show(mut &s, "explain select id from t where a = 1 and c = 7")
    show(mut &s, "analyze")
    show(mut &s, "explain select id from t where a = 1 and c = 7")
    show(mut &s, "select id from t where a = 1 and c = 7")
    println("-- statistics of a dropped table are not used by a new one of the name")
    show(mut &s, "drop table t")
    show(mut &s, "create table t (id int primary key, a int, c int)")
    show(mut &s, "create index t_a on t (a)")
    show(mut &s, "create index t_c on t (c)")
    show(mut &s, "explain select id from t where a = 1 and c = 7")
    println("-- an ANALYZE in a block that rolls back leaves no statistics")
    show(mut &s, "insert into t select g, g % 2, g from generate_series(1, 2000) g")
    show(mut &s, "begin")
    show(mut &s, "analyze t")
    show(mut &s, "explain select id from t where a = 1 and c = 7")
    show(mut &s, "rollback")
    show(mut &s, "explain select id from t where a = 1 and c = 7")
    println("-- errors")
    show(mut &s, "analyze nope")
    println("-- SHOW ALL lists the lexdb settings (it panicked on lexdb_batch before)")
    show(mut &s, "show lexdb_batch")
    show(mut &s, "show all")
    println("-- temporary tables (optimizer 40): another session's are not analyzed; one's own are, and")
    println("-- neither that nor dropping it conflicts with another session's block that read the catalog")
    var s2 = lexdb_exec.newSession(st)
    show(mut &s2, "create temp table tt (id int primary key, k int, j int)")
    show(mut &s2, "insert into tt select g, g % 50, g % 7 from generate_series(1, 700) g")
    show(mut &s2, "create index tt_k on tt (k)")
    show(mut &s2, "create index tt_j on tt (j)")
    show(mut &s, "analyze")
    show(mut &s2, "explain select id from tt where k = 3 and j = 4")
    show(mut &s, "begin")
    show(mut &s, "select count(*) from pg_class where relname = 't'")
    show(mut &s, "update t set a = a where id = 1")
    show(mut &s2, "analyze tt")
    show(mut &s2, "analyze")
    show(mut &s2, "explain select id from tt where k = 3 and j = 4")
    show(mut &s2, "drop table tt")
    show(mut &s, "commit")
    println("-- a role named as a table: ANALYZE and DROP TABLE leave it (statistics were under the roles' prefix)")
    show(mut &s, "create role t login password 'pw'")
    show(mut &s, "select count(*) from pg_roles")
    show(mut &s, "analyze")
    show(mut &s, "select rolname, rolcanlogin from pg_roles where rolname = 't'")
    show(mut &s, "select count(*) from pg_roles")
    show(mut &s, "drop table t")
    show(mut &s, "select rolname, rolcanlogin from pg_roles where rolname = 't'")
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
