const SETUP = "create table dg (i number(10))\ninsert into dg values (0)\ninsert into dg values (1)\ninsert into dg values (2)\ninsert into dg values (3)\ninsert into dg values (4)\ninsert into dg values (5)\ninsert into dg values (6)\ninsert into dg values (7)\ninsert into dg values (8)\ninsert into dg values (9)\ncreate table tb (id number(10) primary key, k varchar2(5), x number, b boolean, d date, t timestamp, s varchar2(20))\ninsert into tb select n, case when mod(n, 37) = 0 then null else 'k' || mod(n, 6) end, case when mod(n, 11) = 0 then null else mod(n, 64) end, case when mod(n, 13) = 0 then null when mod(n, 3) = 0 then false else true end, date '2024-03-05' + mod(n, 40), timestamp '2024-03-05 00:00:00' + numtodsinterval(n * 433, 'SECOND'), case when mod(n, 7) = 0 then null else 'v' || mod(n, 9) end from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 3000\ncreate table fz (id number primary key, a varchar2(20), b varchar2(20))\ninsert into fz values (1, 'kitten', 'sitting')\ninsert into fz values (2, 'martha', 'marhta')\ninsert into fz values (3, 'Abc', 'abc')\ninsert into fz values (4, null, 'abc')\ninsert into fz values (5, 'dixon', 'dicksonx')\ninsert into fz values (6, 'same', 'same')\ninsert into fz values (7, 'flaw', 'lawn')\ninsert into fz values (8, null, null)"

const QS = "select time_bucket(timestamp '2024-03-05 10:22:33', interval '15' minute, timestamp '2000-01-01 00:00:00') a, time_bucket(timestamp '2024-03-05 10:22:33', interval '15' minute, timestamp '2000-01-01 00:00:00', end) b, time_bucket(timestamp '2024-03-05 10:22:33', interval '15' minute, timestamp '2000-01-01 00:00:00', start) c from dual\nselect time_bucket(date '2024-03-05', interval '1' month, date '2024-01-15') a, time_bucket(date '2024-03-05', interval '1' month, date '2024-01-15', end) b, time_bucket(date '2024-03-05', interval '2' year, date '2000-07-01') c from dual\nselect time_bucket(timestamp '2024-03-05 10:22:33', 'PT15M', timestamp '2000-01-01 00:00:00') a, time_bucket(date '2024-03-05', 'P1M', date '2024-01-31') b, time_bucket(date '2024-03-05', 'P2D', date '2024-03-01') c, time_bucket(timestamp '2024-03-05 10:22:33', 'PT1H30M', timestamp '2024-03-05 00:00:00') d from dual\nselect time_bucket(date '1999-12-25', interval '7' day, date '2000-01-03') a, time_bucket(date '2024-03-05', interval '1 12' day to hour, date '2024-03-01') b, time_bucket(timestamp '2024-03-05 10:22:33', interval '1.5' second, timestamp '2024-03-05 00:00:00') c, time_bucket(timestamp '2024-03-05 10:22:33', interval '1:30' hour to minute, timestamp '2024-03-05 00:00:00') d from dual\nselect time_bucket(timestamp '2024-03-05 10:22:33.75', interval '0.5' second, timestamp '2024-03-05 00:00:00') c from dual\nselect interval '1 12' day to hour a, interval '30:15' minute to second b, interval '-1 6' day to hour c from dual\nselect time_bucket(null, interval '1' day, date '2000-01-01') a, time_bucket(date '2024-03-05', null, date '2000-01-01') b, time_bucket(date '2024-03-05', interval '1' day, null) c from dual\nselect time_bucket(date '2024-03-05', interval '-1' day, date '2000-01-01') from dual\nselect time_bucket(date '2024-03-05', interval '1' day, timestamp '2000-01-01 00:00:00') from dual\nselect time_bucket(timestamp '2024-03-05 10:00:00', interval '1' day, date '2000-01-01') from dual\nselect time_bucket(date '2024-03-05', interval '1' day) from dual\nselect time_bucket(date '2024-03-05', 'P1X', date '2000-01-01') from dual\nselect time_bucket(d, interval '1' day, date '2024-03-01') b, count(*) n from tb where id <= 500 group by time_bucket(d, interval '1' day, date '2024-03-01') order by 1\nselect id, time_bucket(t, interval '20' minute, timestamp '2024-03-05 00:05:00') b, time_bucket(t, interval '20' minute, timestamp '2024-03-05 00:05:00', end) e from tb where id in (1, 2, 77, 3000) order by id\nselect length(rawtohex(uuid())) l, length(rawtohex(uuid_to_raw('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a1'))) l2, is_uuid(raw_to_uuid(uuid())) i, uuid() = uuid() e, substr(rawtohex(uuid()), 13, 1) v from dual\nselect is_uuid('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11') a, is_uuid('a0eebc999c0b4ef8bb6d6bb9bd380a11') b, is_uuid('x') c, is_uuid(null) d, is_uuid('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a1g') e from dual\nselect raw_to_uuid(uuid_to_raw('A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11')) a, rawtohex(uuid_to_raw('a0eebc999c0b4ef8bb6d6bb9bd380a11')) b, raw_to_uuid(null) c from dual\nselect uuid_to_raw('x') from dual\nselect raw_to_uuid(hextoraw('0102')) from dual\nselect count(distinct uuid()) n from tb\nselect unistr('\\00e9a') a, unistr('a\\\\b') b, unistr('\\D83D\\DE00') c, unistr('plain') d, unistr(null) e from dual\nselect unistr('\\00e') from dual\nselect unistr('\\+01F600') from dual\nselect k, unistr(k || '\\00e9') u, count(*) n from tb group by k order by k\nselect to_boolean('true') a, to_boolean('no') b, to_boolean(0) c, to_boolean(2.5) d, to_boolean('Y') e, to_boolean(null) f, to_boolean('Off') g, to_boolean(' yes ') h from dual\nselect to_boolean('maybe') from dual\nselect count(*) n from tb where to_boolean(mod(id, 2))\nselect utl_match.edit_distance('kitten', 'sitting') a, utl_match.edit_distance_similarity('kitten', 'sitting') b, utl_match.jaro_winkler('martha', 'marhta') c, utl_match.jaro_winkler_similarity('martha', 'marhta') d from dual\nselect id, utl_match.edit_distance(a, b) e, utl_match.edit_distance_similarity(a, b) s, utl_match.jaro_winkler(a, b) j, utl_match.jaro_winkler_similarity(a, b) js from fz order by id\nselect utl_match.edit_distance('', '') a, utl_match.edit_distance_similarity(null, 'abc') b, utl_match.jaro_winkler(null, 'abc') c, utl_match.edit_distance('ab', 'abc') d, utl_match.edit_distance_similarity('ab', 'abc') e from dual\nselect utl_match.edit_distance(s, 'v4') e, count(*) n from tb group by utl_match.edit_distance(s, 'v4') order by 1\nselect k, bit_and_agg(x) a, bit_or_agg(x) o, bit_xor_agg(x) x, count(*) n from tb group by k order by k\nselect bit_and_agg(x) a, bit_or_agg(x) o, bit_xor_agg(x) x, any_value(x) v from tb where id < 0\nselect bit_and_agg(2.5) a, bit_and_agg(3.5) b, bit_and_agg(-2.5) c, bit_or_agg(-1) d, bit_and_agg('7') e from dual\nselect bit_xor_agg(distinct x) a, bit_xor_agg(x) b, bit_or_agg(distinct x) c from tb\nselect k, boolean_and_agg(b) ba, boolean_or_agg(b) bo, boolean_and_agg(x > 0) bx from tb group by k order by k\nselect boolean_and_agg(b) ba, boolean_or_agg(b) bo from tb where id < 0\nselect k, any_value(s) a from tb where s = 'v3' group by k order by k\nselect any_value(x) a, any_value(distinct x) b from (select 7 x from dual union all select null from dual)\nselect k, round(kurtosis_pop(x), 10) kp, round(kurtosis_samp(x), 10) ks, round(skewness_pop(x), 10) sp, round(skewness_samp(x), 10) ss from tb group by k order by k\nselect round(kurtosis_pop(x), 10) kp, round(kurtosis_samp(x), 10) ks, round(skewness_pop(x), 10) sp, round(skewness_samp(x), 10) ss from (select 1 x from dual union all select 2 from dual union all select 4 from dual union all select 10 from dual union all select 3 from dual)\nselect kurtosis_pop(x) kp, kurtosis_samp(x) ks, round(skewness_pop(x), 10) sp, round(skewness_samp(x), 10) ss from (select 1 x from dual union all select 2 from dual union all select 4 from dual)\nselect kurtosis_pop(x) kp, kurtosis_samp(x) ks, skewness_pop(x) sp, skewness_samp(x) ss from (select 1 x from dual union all select 1 from dual)\nselect kurtosis_pop(x) kp, skewness_samp(x) ss from tb where id < 0\nselect id, bit_xor_agg(x) over (order by id rows between 2 preceding and current row) x, bit_or_agg(x) over (partition by k) o from tb where id <= 8 order by id\nselect k, bit_or_agg(x) filter (where mod(id, 2) = 0) o from tb group by k order by k\nselect bit_and_agg(d) from tb\nselect dateadd(month, 1, date '2024-01-31') a, dateadd(hour, 5, date '2024-01-31') b, dateadd(day, -1, timestamp '2024-03-01 10:00:00') c, dateadd(year, 1, date '2024-02-29') d, dateadd(minute, 90, date '2024-01-31') e, dateadd(week, 2, date '2024-01-31') f, dateadd(quarter, 1, date '2024-01-31') g from dual\nselect datediff(day, date '2024-03-05', date '2024-04-04') a, datediff(month, date '2024-01-31', date '2024-02-01') b, datediff(year, date '2023-12-31', date '2024-01-01') c, datediff(hour, timestamp '2024-03-05 10:59:00', timestamp '2024-03-05 11:01:00') d, datediff(week, date '2024-03-02', date '2024-03-03') e, datediff(second, date '2024-03-05', date '2024-03-04') f, timestampdiff(month, date '2024-01-31', date '2024-02-01') g from dual\nselect dateadd(millisecond, 1500, timestamp '2024-03-05 10:00:00') a, datediff(millisecond, timestamp '2024-03-05 10:00:00', timestamp '2024-03-05 10:00:01.5') b, dateadd(day, 1.5, date '2024-01-31') c, dateadd(day, null, date '2024-01-31') d, datediff(day, null, date '2024-01-31') e from dual\nselect dateadd(xx, 1, date '2024-01-31') from dual\nselect dateadd(dd, 1, date '2024-01-31') from dual\nselect k, min(dateadd(day, id, d)) lo, max(datediff(hour, d, t)) hi from tb group by k order by k\nselect ceil(date '2024-03-05', 'MONTH') a, floor(timestamp '2024-03-05 10:22:33', 'HH') b, round(date '2024-03-20', 'MONTH') c, round(date '2024-03-15', 'MONTH') d, round(timestamp '2024-03-05 12:00:00', 'DD') e, ceil(timestamp '2024-03-05 00:00:00', 'DD') f, round(date '2024-07-01', 'YEAR') g, round(date '2024-06-30', 'YEAR') h from dual\nselect ceil(date '2024-03-05') a, floor(timestamp '2024-03-05 10:00:00') b, round(timestamp '2024-03-05 11:59:59') c, ceil(timestamp '2024-03-05 10:00:00.5', 'MI') d, round(date '2024-03-06', 'D') e, round(date '2024-05-16', 'Q') f, ceil(date '2024-03-05', 'IW') g, round(timestamp '2024-03-05 10:29:30', 'MI') h from dual\nselect round(date '2024-03-05', 'WW') a, ceil(date '2024-03-05', 'W') b, floor(date '2024-03-05', 'Q') c, round(date '2024-02-15', 'Q') d, ceil(date '2024-12-31', 'YEAR') e, round(null, 'DD') f, ceil(1.5) g, floor(-1.5) h, round(2.5) i from dual\nselect ceil(date '2024-03-05', 'XX') from dual\nselect round(date '2024-03-05', 'SS') from dual\nselect round(interval '1 11:30:00' day to second, 'DD') a, ceil(interval '1 00:00:01' day to second, 'DD') b, floor(interval '1 23:59:59' day to second, 'HH') c, round(interval '1 10:29:30' day to second, 'MI') d, floor(interval '-1 12:00:00' day to second, 'DD') g, round(interval '-1 12:00:00' day to second, 'DD') h from dual\nselect round(interval '1-6' year to month, 'YEAR') a, ceil(interval '1-1' year to month, 'YEAR') b, round(interval '1 11:30:00' day to second) c, ceil(interval '1-1' year to month) d from dual\nselect round(interval '1-1' year to month, 'MM') from dual\nselect round(interval '1 11:30:00' day to second, 'MM') from dual\nselect k, ceil(max(t), 'HH') c, floor(min(d), 'MONTH') f, round(max(t), 'DD') r from tb group by k order by k\nselect avg(x) a from (select interval '1-0' year to month x from dual union all select interval '1-1' year to month from dual)\nselect avg(x) a, count(*) n from (select interval '-1-0' year to month x from dual union all select interval '-1-1' year to month from dual union all select interval '0-1' year to month from dual)\nselect k, avg(x) over (order by k) a from (select 1 k, interval '1-0' year to month x from dual union all select 2, interval '1-1' year to month from dual) order by k\nselect k, avg(numtoyminterval(mod(id, 7), 'MONTH')) a from tb group by k order by k"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(55), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
