// lexdb_exec: PostgreSQL 18's RETURNING old and new rows (design/lexdb-new-features.md P2): old.c, new.c, old.*, new.*
// and RETURNING WITH (OLD AS o, NEW AS n) in INSERT (old NULL), ON CONFLICT DO UPDATE (old the row there), UPDATE (and
// ... FROM), DELETE (new NULL; and ... USING), MERGE per action; a default name a table has is the table's, one given in
// WITH is 42712; the syntax errors. Checked against PostgreSQL 18 (generated by tests/lexdb/gen_pg.py from
// retold_queries.txt). Each answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE; each
// statement runs with lexdb_batch off and on ("same: " and the answer, or DIFFERENT and both), an "@tx" one in a
// transaction rolled back each time.
// expect: CREATE TABLE
// expect: INSERT 0 3
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: CREATE TABLE
// expect: INSERT 0 3000
// expect: CREATE TABLE
// expect: CREATE TABLE
// expect: INSERT 0 1
// expect: CREATE TABLE
// expect: INSERT 0 3
// expect: same: id|id|id|a|b|id|a|b: |3||||3|30|z
// expect: same: a|a|nb: ||t
// expect: same: a|a|a: |60|60
// expect: same: id|a|b|id|a|b: 1|10|x|1|21|x
// expect: same: a|a|a: 10|10|10;|80|80
// expect: same: a|a: 
// expect: same: a|a: 
// expect: same: b|b|oa: |c|t
// expect: same: id|id: |11;|12;|14
// expect: same: a|a|a|s: 10|11|11|21;20|21|21|41
// expect: same: ?column?|coalesce|u: 21|x|X;41|y|Y
// expect: same: ob|b|a: t|q|
// expect: same: a|a|x|id|a|b: 10|100|100|1|10|x;20|200|200|2|20|y
// expect: same: a: 
// expect: same: a|a|a: 10|11|11
// expect: same: a|a|a: 10|11|11
// expect: same: id|a|b|a: 1|10|x|11
// expect: same: a: 10
// expect: same: a|a: 10|9
// expect: same: a|a|a: 10|10|9
// expect: same: x|b: 10|x
// expect: same: a|a|a|id|a|b: 20||20|||
// expect: same: id|a|b|id: 1|10|x|;2|20|y|
// expect: same: id|id|k: |2|2
// expect: same: a: 
// expect: same: a|a: 2|2
// expect: same: a|a: 1|3
// expect: same: a|a: 1|4
// expect: same: merge_action|a|a|a: UPDATE|10|99|99
// expect: same: merge_action|a|a|a|id|id: INSERT||50|50||5
// expect: same: merge_action|a|a|a|id|a|b|id|a|b: DELETE|20||20|2|20|y|||
// expect: same: id|a|b|id|a|b: 4|||4|7|
// expect: same: k|v|v: b|2|3;c||
// expect: same: w|w: w1|w1x;w2|w2x;w3|w3x;w4|w4x
// expect: same: k|k: |n;|n;k3|n
// expect: same: id|k: 37|;74|;111|
// expect: same: w|w: w1|v;w7|v;w13|v;w19|v;w25|v;w31|v
// expect: same: ERROR 22012
// expect: same: ERROR 42601
// expect: same: ERROR 42712
// expect: same: ERROR 42712
// expect: same: ERROR 42703
// expect: same: ERROR 42P01
// expect: same: ERROR 42712
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42803
// expect: same: ERROR 42712
// expect: same: id|a|b: 1|10|x;2|20|y;4||
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table t (id int primary key, a int, b text)\n@once insert into t values (1, 10, 'x'), (2, 20, 'y'), (4, null, null)\n@once create table s (k int, x int)\n@once insert into s values (1, 100), (2, 200)\n@once create table big (id int primary key, k text, w text)\n@once insert into big select i, case when i % 37 = 0 then null else 'k' || (i % 6) end, 'w' || i from generate_series(1, 3000) i\n@once create table e (id int primary key, a int)\n@once create table old (id int, a int)\n@once insert into old values (1, 1)\n@once create table tk (k text primary key, v int)\n@once insert into tk values ('a', 1), ('b', 2), ('c', null)\n@tx insert into t values (3, 30, 'z') returning old.id, new.id, old.*, new.*\n@tx insert into t (id) values (5) returning old.a, new.a, new.b is null as nb\n@tx insert into t as x values (6, 60, 'f') returning old.a, x.a, new.a\n@tx insert into t values (1, 11, 'c') on conflict (id) do update set a = excluded.a + t.a returning old.*, new.*\n@tx insert into t values (1, 0, 'c'), (8, 80, 'e') on conflict (id) do update set a = excluded.a + t.a returning old.a, new.a, a\n@tx insert into t values (1, 0, 'c') on conflict (id) do nothing returning old.a, new.a\n@tx insert into t values (2, 0, 'c') on conflict (id) do update set a = 0 where t.a > 100 returning old.a, new.a\n@tx insert into t values (4, 1, 'c') on conflict (id) do update set b = excluded.b returning old.b, new.b, old.a is null as oa\n@tx insert into t select id + 10, a, b from t returning old.id, new.id\n@tx update t set a = a + 1 where id <= 2 returning old.a, new.a, a, old.a + new.a s\n@tx update t set a = a + 1 where id <= 2 returning old.a + new.a, coalesce(old.b, 'z'), upper(new.b) as u\n@tx update t set b = 'q' where id = 4 returning old.b is null as ob, new.b, old.a\n@tx update t set a = s.x from s where s.k = t.id returning old.a, new.a, s.x, old.*\n@tx update t set a = 1 where id = 99 returning old.a\n@tx update t as x set a = a + 1 where id = 1 returning old.a, x.a, new.a\n@tx update t set a = a + 1 where id = 1 returning with (old as o, new as n) o.a, n.a, a\n@tx update t set a = a + 1 where id = 1 returning with (old as o) o.*, new.a\n@tx update t set a = 8 where id = 1 returning with (old as new) new.a\n@tx update t set a = 9 where id = 1 returning with (old as new, new as old) new.a, old.a\n@tx update t set a = 9 where id = 1 returning \"old\".a, OLD.a, New.A\n@tx update t set a = 9 where id = 1 returning old.a as \"x\", new.b\n@tx delete from t where id = 2 returning old.a, new.a, a, new.*\n@tx delete from t where id <= 2 returning old.*, new.id\n@tx delete from t using s where s.k = t.id and s.k = 2 returning new.id, old.id, s.k\n@tx delete from e returning old.a\n@tx update old set a = 2 returning old.a, new.a\n@tx update old o set a = 3 returning old.a, new.a\n@tx update old set a = 4 returning with (old as p) p.a, old.a\n@tx merge into t using (values (1, 0)) v(k, x) on t.id = v.k when matched then update set a = 99 returning merge_action(), old.a, new.a, a\n@tx merge into t using (values (5, 50)) v(k, x) on t.id = v.k when not matched then insert values (v.k, v.x, 'm') returning merge_action(), old.a, new.a, a, old.id, new.id\n@tx merge into t using (values (2, -1)) v(k, x) on t.id = v.k when matched then delete returning merge_action(), old.a, new.a, a, old.*, new.*\n@tx merge into t using (select 4 k) v on t.id = v.k when matched then update set a = 7 returning with (old as o, new as n) o.*, n.*\n@tx update tk set v = v + 1 where k > 'a' returning old.k, old.v, new.v\n@tx update big set w = w || 'x' where id <= 4 returning old.w, new.w\n@tx update big set k = 'n' where id in (37, 74, 75) returning old.k, new.k\n@tx delete from big where k is null and id < 120 returning old.id, new.k\n@tx update big set w = 'v' where k = 'k1' and id < 40 returning old.w, new.w\n@tx update big set w = (100 / (id - 50))::text where id <= 100 returning old.w\n@tx update t set a = 7 where id = 1 returning with (old as o, old as n) o.a\n@tx update t set a = 7 where id = 1 returning with (old as o, new as o) o.a\n@tx update t set a = 10 where id = 1 returning with (old as t) t.a\n@tx update t set a = 7 where id = 1 returning old.nosuch\n@tx update t set a = 7 where id = 1 returning with (new as n) new.a\n@tx update t set a = s.x from s where s.k = t.id returning with (old as s) s.a\n@tx update t set a = 7 returning with (foo as o) o.*\n@tx update t set a = 7 returning with (old as o)\n@tx update t set a = 7 returning with (old o) o.a\n@tx update t set a = a + 1 where id = 1 returning count(old.a)\n@tx update t as o set a = a + 1 where id = 1 returning with (old as o) o.a\nselect * from t order by id"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(142), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
