// lexdb_exec: what psql's \d+ commands call, checked against PostgreSQL 18
// (generated by tests/lexdb/gen_pg.py from psqlplus_queries.txt): pg_size_pretty
// at each unit's edges, the size functions' NULLs, zeros and signs, pg_database_size,
// pg_language, pg_available_extensions in FROM (9.97).
// Each expect line: a query's rows or tag, or ERROR and its SQLSTATE.
// expect: 0 bytes|1 bytes|10239 bytes|10 kB|10 kB|11 kB
// expect: 20 MB|20 MB|1024 MB|5000 GB
// expect: -1 bytes|-10 kB|-11 kB|-20 MB
// expect: 8192 PB|-8192 PB
// expect: 12 MB|1536 bytes|
// expect: CREATE TABLE
// expect: CREATE INDEX
// expect: INSERT 0 2000
// expect: CREATE VIEW
// expect: CREATE SEQUENCE
// expect: t|t|t|t
// expect: t|0|0|8192|0
// expect: t|
// expect: ERROR 42P01
// expect: ERROR 3D000
// expect: c|f;internal|f;sql|t
// expect: 0
// expect: 
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "select pg_size_pretty(0::bigint), pg_size_pretty(1::bigint), pg_size_pretty(10239::bigint), pg_size_pretty(10240::bigint), pg_size_pretty(10751::bigint), pg_size_pretty(10752::bigint)\nselect pg_size_pretty(20971519::bigint), pg_size_pretty(20971520::bigint), pg_size_pretty(1073741824::bigint), pg_size_pretty(5368709120000::bigint)\nselect pg_size_pretty(-1::bigint), pg_size_pretty(-10240::bigint), pg_size_pretty(-10752::bigint), pg_size_pretty(-20971520::bigint)\nselect pg_size_pretty(9223372036854775807::bigint), pg_size_pretty(-9223372036854775807::bigint)\nselect pg_size_pretty(12345678::numeric), pg_size_pretty(1536::bigint), pg_size_pretty(null::bigint)\ncreate table big (id int primary key, v text)\ncreate index big_v on big (v)\ninsert into big select i, repeat('x', 200) || i from generate_series(1, 2000) i\ncreate view bigv as select * from big\ncreate sequence bigs\nselect pg_relation_size('big') > 0, pg_table_size('big') > 0, pg_indexes_size('big') > 0, pg_total_relation_size('big') > pg_table_size('big')\nselect pg_relation_size('big_v') > 0, pg_relation_size('bigv'), pg_table_size('bigv'), pg_relation_size('bigs'), pg_relation_size('big', 'init')\nselect pg_relation_size('big'::regclass) = pg_relation_size('big'), pg_relation_size(0)\nselect pg_relation_size('nosuch')\nselect pg_database_size(current_database()) > 0, pg_database_size('nosuchdb')\nselect lanname, lanpltrusted from pg_language where lanname in ('internal', 'c', 'sql') order by 1\nselect count(*) from pg_available_extensions() ae(name, default_version, comment) where ae.name = 'no_such_extension'\nselect e.extname from pg_catalog.pg_extension e left join pg_catalog.pg_available_extensions() ae(name, default_version, comment) on ae.name = e.extname where e.extname <> 'plpgsql'"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(97), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
