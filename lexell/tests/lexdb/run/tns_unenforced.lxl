// lexdb over TNS: Oracle's constraint states (design/lexdb-new-features.md 10.5, O26): CHECK and foreign key constraints DISABLE, ENABLE NOVALIDATE and
// ENABLE [VALIDATE] in CREATE TABLE (column and table constraints) and ALTER TABLE ADD CONSTRAINT, ALTER TABLE ENABLE | DISABLE [VALIDATE | NOVALIDATE]
// CONSTRAINT and MODIFY CONSTRAINT (ENABLE VALIDATE and VALIDATE check the rows: ORA-02293, ORA-02298; ENABLE NOVALIDATE checks the rows written from then on:
// ORA-02290, ORA-02291), ORA-02430 and ORA-02431 for a name not there, USER_CONSTRAINTS' STATUS and VALIDATED, a parent deleted under a foreign key disabled
// (no ON DELETE CASCADE) and enabled again. Checked against Oracle Database Free 23.26 (gen_oracle.py --check tns_unenforced: the answers below are Oracle's;
// 23.26.3 has no NOT ENFORCED). Each statement runs with set lexdb_batch = off (the row engine) and on: "same" and the answer, or DIFFERENT and both; every
// statement gives its answer again the second time (the ALTERs set a state, the writes run in a transaction rolled back).
// expect: setup: 28 statements
// expect: same: CONSTRAINT_NAME,CONSTRAINT_TYPE,STATUS,VALIDATED,SEARCH_CONDITION = 'CK1'|'C'|'DISABLED'|'NOT VALIDATED'|'v > 0';'FK1'|'R'|'DISABLED'|'NOT VALIDATED'|NULL
// expect: same: 1 / N = 3
// expect: same: error 2293
// expect: same: error 2293
// expect: same: error 2293
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK1'|'DISABLED'|'NOT VALIDATED';'FK1'|'DISABLED'|'NOT VALIDATED'
// expect: same: 0
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK1'|'ENABLED'|'NOT VALIDATED';'FK1'|'DISABLED'|'NOT VALIDATED'
// expect: same: error 2290 / N = 2
// expect: same: error 2290 / N = 2
// expect: same: error 2293
// expect: same: 0
// expect: same: error 2291 / N = 2
// expect: same: error 2298
// expect: same: error 2298
// expect: same: error 2298
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK1'|'ENABLED'|'NOT VALIDATED';'FK1'|'ENABLED'|'NOT VALIDATED'
// expect: same: 0
// expect: same: 0
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK1'|'ENABLED'|'NOT VALIDATED';'FK1'|'ENABLED'|'NOT VALIDATED'
// expect: same: 0
// expect: same: 0
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK1'|'DISABLED'|'NOT VALIDATED';'FK1'|'DISABLED'|'NOT VALIDATED'
// expect: same: 1 / N = 3
// expect: same: error 2431
// expect: same: error 2430
// expect: same: error 2430
// expect: same: error 2431
// expect: same: error 2430
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK2'|'DISABLED'|'NOT VALIDATED';'FK2'|'DISABLED'|'NOT VALIDATED'
// expect: same: 1 / N = 3
// expect: same: 0
// expect: same: 0
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK2'|'ENABLED'|'VALIDATED';'FK2'|'ENABLED'|'VALIDATED'
// expect: same: error 2290 / N = 2
// expect: same: error 2291 / N = 2
// expect: same: error 2290 / N = 2
// expect: same: error 2291 / N = 2
// expect: same: 1 / N = 3
// expect: same: 0
// expect: same: 0
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK2'|'DISABLED'|'NOT VALIDATED';'FK2'|'DISABLED'|'NOT VALIDATED'
// expect: same: 0
// expect: same: 0
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK2'|'ENABLED'|'NOT VALIDATED';'FK2'|'ENABLED'|'NOT VALIDATED'
// expect: same: 0
// expect: same: 0
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK2'|'ENABLED'|'VALIDATED';'FK2'|'ENABLED'|'VALIDATED'
// expect: same: 1 / N = 2
// expect: same: 0
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED,DELETE_RULE = 'FK3'|'ENABLED'|'VALIDATED'|'CASCADE'
// expect: same: 1 / N = 1
// expect: same: 0
// expect: same: 1 / N = 3
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'OC4A'|'DISABLED'|'NOT VALIDATED';'OC4B'|'ENABLED'|'NOT VALIDATED';'OC4C'|'ENABLED'|'VALIDATED';'OC4D'|'DISABLED'|'NOT VALIDATED';'OC4E'|'ENABLED'|'NOT VALIDATED'
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED,SEARCH_CONDITION = 'CK5'|'DISABLED'|'NOT VALIDATED'|'v > 0';'CK6'|'ENABLED'|'NOT VALIDATED'|'v > 0';'FK5'|'DISABLED'|'NOT VALIDATED'|NULL;'FK6'|'ENABLED'|'NOT VALIDATED'|NULL
// expect: same: error 2290 / N = 1
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK7'|'DISABLED'|'NOT VALIDATED'
// expect: same: 1 / N = 2
// expect: same: 0
// expect: same: error 2290 / N = 1
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK7'|'ENABLED'|'VALIDATED'
// expect: same: CONSTRAINT_NAME,STATUS,VALIDATED = 'CK8'|'DISABLED'|'NOT VALIDATED'
