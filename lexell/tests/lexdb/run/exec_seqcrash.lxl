// lexdb_exec: a sequence's values across crashes (design/lexdb.md 9.43).
// A block's last value is written without waiting for the disk (Store.
// commitAhead): in the log ahead of every commit using the block's values,
// it is durable once they are. Here rows with serial ids are inserted, some
// committed one by one, some in transactions rolled back, and
// nextval taken in bare SELECTs; the simulated disk crashes at a random
// commit. After it every committed row must be there, and new rows must get
// ids none of them has (a value given again would collide with the key).
// expect: 120 crashes, every committed row there, no id given again
import "strings"
import "../../../cmd/lexdb_base"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

fn opts(): lexdb_store.Options {
    return lexdb_store.Options{cacheBytes: 256 * 1024, segBytes: 1024 * 1024, ckptBytes: 512 * 1024, snapNodes: 100000, bufferedPages: false}
}

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var out: []str = []
            for row in r.rows {
                var vs: []str = []
                for v in row { append(mut &vs, lexdb_exec.text(&v)) }
                append(mut &out, strings.join(&vs, "|"))
            }
            return strings.join(&out, " ")
        }
        Err(e) { return e.state + " " + e.msg }
    }
}

// Works until commit crashAt: inserts (most committed alone), rolled-back
// inserts and bare nextvals. The ids committed go to ids.
fn work(st: lexdb_store.Store, rng: mut &lexdb_base.Rng, crashAt: int, ids: mut &[]str): str {
    var s = lexdb_exec.newSession(st)
    var commits = 0
    while commits < crashAt {
        let r = rng.below(10)
        if r < 6 {
            let got = q(mut &s, &"insert into t (v) values (1); select currval('t_id_seq')")
            if strings.parseIntOpt(got).isNone() { return "insert: " + got }
            append(ids, got)
            commits += 1
        } else if r < 8 {
            let a = q(mut &s, &"begin; insert into t (v) values (2), (3); rollback")
        } else {
            let b = q(mut &s, &"select nextval('t_id_seq')")
        }
    }
    return ""
}

fn main() {
    var crashes = 0
    var bad: []str = []
    for seed in 0..40 {
        var rng = lexdb_base.rng(seed)
        var fs = lexdb_disk.sim(seed)
        var ids: []str = []
        let made = lexdb_store.run(fs, opts(), fn(st: lexdb_store.Store): str {
            lexdb_exec.bootstrap(&st).unwrap()
            var s = lexdb_exec.newSession(st)
            return q(mut &s, &"create table t (id serial primary key, v int)")
        }).unwrap()
        for k in 0..3 {
            let crashAt = 1 + rng.below(80)
            var crashed = fs
            let r = lexdb_store.run(fs, opts(), fn(st: lexdb_store.Store): str {
                let w = work(st, mut &rng, crashAt, mut &ids)
                crashed = fs.crash(seed * 10 + k)
                return w
            }).unwrap()
            if len(r) > 0 { append(mut &bad, "seed " + seed.toStr() + ": " + r) }
            fs = crashed
            crashes += 1
            // every committed row there; a new row's id is none of theirs
            let c = lexdb_store.run(fs, opts(), fn(st: lexdb_store.Store): str {
                var s = lexdb_exec.newSession(st)
                let n = q(mut &s, &"select count(*) from t")
                if n != len(ids).toStr() { return "rows " + n + ", committed " + len(ids).toStr() }
                let ins = q(mut &s, &"insert into t (v) values (9)")
                if ins != "INSERT 0 1" { return "after the crash: " + ins }
                let del = q(mut &s, &"delete from t where v = 9")
                return ""
            }).unwrap()
            if len(c) > 0 { append(mut &bad, "seed " + seed.toStr() + " crash " + k.toStr() + ": " + c) }
        }
    }
    if len(bad) > 0 {
        for b in bad { println(b) }
    } else {
        println(crashes.toStr() + " crashes, every committed row there, no id given again")
    }
}
