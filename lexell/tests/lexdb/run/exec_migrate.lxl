import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table p (id int primary key, code text unique)\ncreate table c (id int primary key, pid int references p deferrable initially deferred, qid int)\nalter table c add constraint c_qid_fkey foreign key (qid) references p (id) deferrable\nselect conname, condeferrable, condeferred, pg_get_constraintdef(oid) from pg_constraint where conrelid = 'c'::regclass and contype = 'f' order by 1\nselect constraint_name, is_deferrable, initially_deferred from information_schema.table_constraints where table_name = 'c' and constraint_name not like '%not_null' order by 1\nbegin\ninsert into c values (1, 10, null)\ninsert into p values (10, 'ten')\ncommit\nselect * from c\nbegin\ninsert into c values (2, 20, null)\ncommit\nselect count(*) from c\nbegin\ninsert into c values (3, 30, null)\nset constraints c_pid_fkey immediate\nrollback\nbegin\nset constraints all deferred\ninsert into c values (4, null, 40)\ninsert into p values (40, 'forty')\ncommit\nbegin\nset constraints all deferred\ndelete from p where id = 40\ncommit\nselect count(*) from p\nbegin\ninsert into c values (5, 50, null)\ndelete from c where id = 5\ncommit\nbegin\nset constraints c_qid_fkey, c_pid_fkey deferred\ninsert into c values (6, 60, 60)\nset constraints all immediate\nrollback\nbegin\nset constraints nope deferred\nrollback\nbegin\nset constraints p_code_key deferred\nrollback\nset constraints all deferred\ninsert into c values (7, 70, null)\ncreate table e1 (id int primary key, x int references p not deferrable initially deferred)\ncreate table e2 (id int primary key, x int references p initially deferred)\nselect condeferrable, condeferred from pg_constraint where conname = 'e2_x_fkey'\nalter table c add column rid int constraint c_rid_fkey references p (id) on delete set null deferrable initially deferred\nalter table c add column u text unique, add column k int check (k > 0)\nselect column_name, data_type from information_schema.columns where table_name = 'c' order by ordinal_position\nalter table c add column if not exists u text unique\ninsert into c (id, k) values (8, 0)\ninsert into c (id, u) values (9, 'x'), (10, 'x')\ncreate index c_u_like on c (u text_pattern_ops)\ncreate index c_k_desc on c (k desc nulls last, u)\ncreate unique index c_two on c (k nulls first, u varchar_pattern_ops desc)\ncreate index c_coll on c (u collate \"C\")\ncreate index c_bad on c (u no_such_ops)\nselect indexname, indexdef from pg_indexes where tablename = 'c' order by 1\nselect i.indoption from pg_index i join pg_class x on x.oid = i.indexrelid where x.relname in ('c_k_desc', 'c_two') order by x.relname\ncreate index concurrently c_conc on c (qid)\ndrop index concurrently c_conc\nbegin\ncreate index concurrently c_conc2 on c (qid)\nrollback\nselect 5 & 3, 5 | 2, 5 # 1, 1 << 4, 256 >> 2, ~0, -8 >> 1, 1 << 64\nselect 1 + 2 & 3, 7 & 3 = 3, 2 | 1 << 2\ncreate table kv (key text primary key, value int)\ninsert into kv (key, value) values ('a', 1)\nselect key, value from kv where key = 'a'\nselect conname, conkey from pg_constraint where conrelid = 'c'::regclass and contype = 'c'\ncreate table acct (id int primary key, bal int, owner int references p deferrable)\ninsert into acct values (1, 100, 10), (2, 200, 10), (3, 300, null)\nselect id from acct where bal > 100 order by id for update\nselect id from acct order by id limit 2 for share\nselect id from acct order by id limit 1 offset 1 for no key update\nselect a.id, p.code from acct a join p on p.id = a.owner order by a.id for key share of a\nselect a.id from acct a left join p on p.id = a.owner for update\nselect a.id from acct a left join p on p.id = a.owner order by 1 for update of a\nselect id from acct for update of nope\nselect count(*) from acct for update\nselect distinct bal from acct for update\nselect bal from acct group by bal for update\nselect id from acct union select id from acct for update\nselect id from acct order by id for update nowait\nselect id from acct order by id for update skip locked\nbegin\nselect id from acct where id = 1 for update\nselect id from acct where id = 1 for update nowait\nupdate acct set bal = bal + 1 where id = 1\nselect bal from acct where id = 1 for share skip locked\ncommit\nbegin read only\nselect id from acct for update\nrollback\nselect pg_advisory_lock(1), pg_try_advisory_lock(1), pg_advisory_unlock(1), pg_advisory_unlock(1), pg_advisory_unlock(1)\nselect pg_try_advisory_lock(2, 3), pg_advisory_unlock(2, 3), pg_advisory_unlock(3, 2)\nselect pg_advisory_lock_shared(5), pg_advisory_unlock(5), pg_advisory_unlock_shared(5)\nbegin\nselect pg_advisory_xact_lock(9), pg_try_advisory_xact_lock_shared(9)\nselect pg_advisory_unlock(9)\ncommit\nselect pg_advisory_unlock_all()\nselect pg_advisory_lock(null)"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(85), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
