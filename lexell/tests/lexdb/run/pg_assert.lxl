// expect: same: constraint_schema,constraint_name,check_clause = public|any_dept|(exists (select 1 from dept));public|d1_neg|(not exists (select 1 from d1 where v < 0));public|nn_pos|(all (select v from nn) satisfy (v > 0));public|sal_pos|(not exists (select 1 from emp where sal < 0))
