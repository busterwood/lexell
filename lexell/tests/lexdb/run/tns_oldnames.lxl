// lexdb over TNS: a database made before the Oracle door's quoted names were exact (design/lexdb-robust.md, "The sixth bug slice", item 1)
// keeps folding them, so its objects answer to the spellings they were made with: the store is made as such a store is (the catalog's mark of a store
// made with exact names, the leading 0 of the sequences' tree's number, is taken out and the store opened again), and its tables, columns, views, sequences and indexes,
// made with quoted names, are found quoted and unquoted, as by the lexdb that made them (checked against main b7c7b37f's binary on a store
// it made); USER_TABLES and USER_TAB_COLUMNS show them as it did; "mixt" quoted is the table "MixT" made before (ORA-00955 for a new one).
// A store made now has exact names (tns_bugs6). Each statement runs with set lexdb_batch = off and on: "same" and the answer.
// expect: setup: 7 statements
// expect: same: A = 1
// expect: same: A = 1
// expect: same: A = 1
// expect: same: Col,MixC = 2|3
// expect: same: COL,MIXC = 2|3
// expect: same: COL = 2
// expect: same: Col,MixC = 2|3
// expect: same: Col,MixC = 2|3
// expect: same: TABLE_NAME = 'LOWT';'MixT'
// expect: same: TABLE_NAME,COLUMN_NAME = 'LOWT'|'Col';'LOWT'|'MixC';'MixT'|'A';'vLow'|'Col';'vLow'|'MixC'
// expect: same: N = 0
// expect: same: INDEX_NAME = 'IXL'
// expect: same: error 955
// expect: same: error 955
// expect: same: error 955
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"
import "../../../cmd/lexdb_catalog"

const SETUP = "create table \"MixT\" (a number)\ninsert into \"MixT\" values (1)\ncreate table \"lowt\" (\"Col\" number, \"MixC\" number)\ninsert into \"lowt\" values (2, 3)\ncreate view \"vLow\" as select \"Col\", \"MixC\" from \"lowt\"\ncreate sequence \"sQ\"\ncreate index \"ixL\" on \"lowt\" (\"Col\")"

const QS = "select * from \"MixT\"\nselect * from mixt\nselect * from MIXT\nselect \"Col\", \"MixC\" from \"lowt\"\nselect col, mixc from lowt\nselect \"COL\" from \"lowt\"\nselect * from \"vLow\"\nselect * from vlow\nselect table_name from user_tables order by 1\nselect table_name, column_name from user_tab_columns where table_name in ('MixT', 'LOWT', 'vLow') order by 1, 2\nselect \"sQ\".nextval - sq.currval n from dual\nselect index_name from user_indexes where table_name = 'LOWT'\ncreate table \"mixt\" (b number)\ncreate table \"lowt\" (b number)\ncreate index \"ixl\" on \"lowt\" (\"MixC\")"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    // a store made before exact names: its sequences' tree's number without the leading 0 lexdb_exec.bootstrap writes now, opened again
    var t = lexdb_store.begin()
    let seqs = st.get(mut &t, lexdb_catalog.CATALOG, "\x02seqs").unwrap().unwrap()
    t.put(lexdb_catalog.CATALOG, "\x02seqs", &(strings.parseIntOpt(&seqs).unwrap().toStr())).unwrap()
    st.commit(t).unwrap()
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(161), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
