import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "drop role if exists lx_alice, lx_bob, lx_team\ncreate role lx_alice login\ncreate role lx_bob login\ncreate role lx_team\ncreate table t (id int primary key, v int)\ninsert into t values (1, 10), (2, 20)\ncreate function f1(a int) returns int language sql as $$ select a + 1 $$\ncreate function f2(a int) returns int language sql as $$ select v from t where id = a $$\ncreate procedure p1(a int) language sql as $$ insert into t values (a, a * 10) $$\ncreate schema s1\ncreate function s1.f3() returns int language sql as $$ select 3 $$\ncreate function f1(a int, b int) returns int language sql as $$ select a + b $$\nset role lx_alice\nselect f1(1)\nselect f1(1, 2)\nselect f2(1)\ncall p1(5)\ncreate function mine() returns int language sql as $$ select 1 $$\nreset role\nselect proname, proacl is null from pg_proc where proname in ('f1', 'f2', 'p1') order by proname, pronargs\nrevoke execute on function f1(int) from public\nset role lx_alice\nselect f1(1)\nselect f1(1, 2)\nreset role\ngrant execute on function f1(int) to lx_alice\nset role lx_alice\nselect f1(1)\nselect f1(1) + f1(2, 3)\nselect 1 where f1(2) = 3\nreset role\nset role lx_bob\nselect f1(1)\nreset role\nrevoke execute on procedure p1(int) from public\nset role lx_alice\ncall p1(5)\nreset role\ngrant execute on procedure p1(int) to lx_team\ngrant lx_team to lx_bob\nset role lx_bob\ncall p1(5)\nreset role\ngrant select, insert on t to lx_bob\nset role lx_bob\ncall p1(5)\nselect f2(1)\nreset role\nrevoke execute on function f1(int) from lx_alice\nset role lx_alice\ngrant execute on function f1(int) to lx_bob\nselect f1(1)\nreset role\ngrant execute on function f1(int, int), f2(int) to lx_bob\ngrant execute on function f1 to lx_bob\ngrant execute on function nothing(int) to lx_bob\ngrant execute on function f1(int) to nobody\ngrant execute on function s1.f3() to lx_bob\ngrant execute on function f3() to lx_bob\ngrant execute on procedure f1(int) to lx_bob\ngrant execute on function p1(int) to lx_bob\ngrant execute on routine p1(int) to lx_bob\ngrant execute on routine f2(int) to lx_bob\ngrant select on function f2(int) to lx_bob\ngrant all on function f2(int) to lx_bob\ngrant all privileges on procedure p1(int) to lx_bob\ngrant usage on function f2(int) to lx_bob\nrevoke all on function f2(int) from lx_bob\nselect grantee, routine_schema, routine_name, privilege_type, is_grantable from information_schema.routine_privileges where routine_schema = 'public' and grantee <> current_user order by routine_name, grantee, privilege_type\nselect routine_name, privilege_type, is_grantable from information_schema.routine_privileges where routine_schema = 'public' and grantee = current_user order by routine_name\nselect grantee, routine_schema, routine_name, privilege_type from information_schema.role_routine_grants where routine_schema = 'public' and grantee <> current_user order by routine_name, grantee, privilege_type\nselect proname, proacl is null from pg_proc where proname in ('f1', 'f2', 'p1') order by proname, pronargs\nselect has_function_privilege('lx_alice', 'f1(int)', 'execute'), has_function_privilege('lx_bob', 'f1(int)', 'execute'), has_function_privilege('lx_team', 'p1(int)', 'execute')\nselect has_function_privilege('lx_alice', 'f1(int, int)', 'execute'), has_function_privilege('lx_alice', 'public.f1(integer, integer)', 'EXECUTE'), has_function_privilege('lx_alice', 's1.f3()', 'execute')\nselect has_function_privilege('lx_alice', 'f1(int)', 'select')\nselect has_function_privilege('lx_alice', 'nothing(int)', 'execute')\nset role lx_bob\nselect has_function_privilege('f1(int)', 'execute'), has_function_privilege('f2(int)', 'execute')\nreset role\ngrant execute on all functions in schema public to lx_alice\nselect grantee, routine_name, privilege_type from information_schema.routine_privileges where routine_schema = 'public' and grantee = 'lx_alice' order by routine_name\nrevoke execute on all functions in schema public from lx_alice\nselect grantee, routine_name, privilege_type from information_schema.routine_privileges where routine_schema = 'public' and grantee = 'lx_alice' order by routine_name\ngrant execute on all procedures in schema public to lx_alice\ngrant execute on all routines in schema s1 to lx_alice\ngrant execute on all functions in schema nothing to lx_alice\nselect grantee, routine_schema, routine_name, privilege_type from information_schema.routine_privileges where grantee = 'lx_alice' order by routine_schema, routine_name\nset role lx_alice\nselect s1.f3()\nreset role\ngrant usage on schema s1 to lx_alice\nset role lx_alice\nselect s1.f3()\nreset role\nrevoke execute on function s1.f3() from public\nset role lx_alice\nselect s1.f3()\nreset role\nset role lx_bob\nselect s1.f3()\nreset role\ncreate or replace function f2(a int) returns int language sql as $$ select v + 1 from t where id = a $$\nselect grantee, routine_name, privilege_type from information_schema.routine_privileges where routine_name = 'f2' and grantee <> current_user order by grantee\ndrop function f1(int)\nselect count(*) from information_schema.routine_privileges where routine_name = 'f1' and grantee <> current_user\ncreate function f1(a int) returns int language sql as $$ select a + 100 $$\nset role lx_alice\nselect f1(1)\nreset role\nselect grantee, privilege_type from information_schema.routine_privileges where routine_name = 'f1' and routine_schema = 'public' and grantee <> current_user order by 1\ndrop function f1(int)\ndrop function f1(int, int)\ncreate schema s2\ncreate function s2.g() returns int language sql as $$ select 9 $$\ngrant execute on function s2.g() to lx_alice\ndrop schema s2 cascade\nselect count(*) from information_schema.routine_privileges where routine_schema = 's2'\ncreate function s1.f3() returns int language sql as $$ select 4 $$\nselect grantee, routine_name from information_schema.routine_privileges where routine_schema = 's1' and grantee <> current_user order by 1"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" && r.tag != "CALL" { append(mut &rows, r.tag.clone()) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(124), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
