// lexdb_exec: the review of the join order (optimizer 25, 26), its
// findings fixed (optimizer 29), one case each: a key value a column cannot
// hold matches no row; a hash join fits the statement's memory; ranges and
// other filters count in the estimates; a LIMIT or EXISTS keeps lookups; a
// block whose reads are noted keeps the order bound by keys (no
// whole-table read to conflict with another session's write); the first
// table is read in batches wherever FROM put it. The second review's
// (optimizer 33): batches test the right column of a reordered first table;
// a hashed table keeps its constant range; an aggregate subquery is planned
// as the same query alone. The third review's (optimizer 39): from a pinned
// row the constant's estimate picks the index; a pinned row that binds no
// other table leaves the order to the costs; ORDER BY ... LIMIT from a pinned
// row stops early; ANALYZE's distinct counts of other columns; a range that
// is not the ORDER BY's plans no early stop; a NaN bound. Checked by hand
// against the rules mode.
// expect: -- tables as the review's: small (100 rows, one labelled x), big (20,000, 200 per small row, a pad column)
// expect: create table small (id int primary key, label text) -> CREATE TABLE
// expect: insert into small select g, case when g = 7 then 'x' else 'l' || (g % 10) end from generate_series(1, 100) g -> INSERT 0 100
// expect: create index small_label on small (label) -> CREATE INDEX
// expect: create table big (id int primary key, sid int, v int, pad text) -> CREATE TABLE
// expect: insert into big select g, g % 100 + 1, g % 7, repeat('x', 50) from generate_series(1, 20000) g -> INSERT 0 20000
// expect: create index big_sid on big (sid) -> CREATE INDEX
// expect: -- 1. a key value the column cannot hold matches no row (it was an error in a hash probe or a lookup)
// expect: create table bigv (id bigint primary key, x bigint, t text) -> CREATE TABLE
// expect: insert into bigv values (1, 1, '1'), (2, 1099511627776, 'abc'), (3, 3, 'abcdef'), (4, null, null), (5, 5, ' 5') -> INSERT 0 5
// expect: create table sm (id int primary key, vc varchar(3)) -> CREATE TABLE
// expect: insert into sm values (1, '1'), (2, 'abc'), (3, 'ab'), (5, '5') -> INSERT 0 4
// expect: create index sm_vc on sm (vc) -> CREATE INDEX
// expect: analyze -> ANALYZE
// expect: select count(*) from sm s join bigv b on s.id = b.x -> [count] 3
// expect: select count(*) from bigv b join sm s on s.vc = b.t -> [count] 2
// expect: select count(*) from bigv b join sm s on s.id = b.x -> [count] 3
// expect: select count(*) from sm where id = 1099511627776 -> [count] 0
// expect: select count(*) from sm where id = 'abc' -> 22P02 invalid input syntax for type integer: "abc"
// expect: set lexdb_planner = rules -> SET
// expect: select count(*) from sm s join bigv b on s.id = b.x -> [count] 3
// expect: select count(*) from bigv b join sm s on s.vc = b.t -> [count] 2
// expect: reset lexdb_planner -> RESET
// expect: -- 2. a hash join fits the statement's memory: with 256kB, big is looked up per row
// expect: set max_statement_mem = '256kB' -> SET
// expect: explain select count(*), max(b.pad) from big a join big b on b.id = a.sid -> [QUERY PLAN] scan big a: full scan; join big b: primary key lookup per row; aggregate
// expect: select count(*) from big a join big b on b.id = a.sid -> [count] 20000
// expect: reset max_statement_mem -> RESET
// expect: explain select count(*) from big a join big b on b.id = a.sid -> [QUERY PLAN] scan big a: full scan; join big b: hash on (id) over full scan; aggregate
// expect: -- 3. ranges, IN lists and other filters count: the range's table first
// expect: explain analyze select count(*) from big b join small s on b.sid = s.id where b.id < 5 and s.label = 'l3' -> scan big b: primary key range (estimated 4 rows) (rows read 5, kept 4, batches 1); join small s: primary key lookup per row (lookups 4, rows read 4, joined 1); aggregate
// expect: explain analyze select count(*) from big a join big b on b.id = a.sid where a.id between 10 and 12 -> scan big a: primary key range (estimated 1 rows) (rows read 3, kept 3, batches 1); join big b: primary key lookup per row (lookups 3, rows read 3, joined 3); aggregate
// expect: explain analyze select count(*) from big a join big b on b.id = a.sid where a.pad = 'none' -> scan big a: full scan (rows read 20000, kept 0, batches 20); join big b: hash on (id) over full scan (table rows 20000 of 20000 read, probes 0, rows read 0, joined 0); aggregate
// expect: -- 4. a LIMIT or EXISTS keeps lookups: no hash built for one row
// expect: explain analyze select a.id from big a join big b on b.id = a.id limit 1 -> scan big a: full scan (rows read 1, kept 1); join big b: primary key lookup per row (lookups 1, rows read 1, joined 1); limit: stops the scan
// expect: explain analyze select 1 where exists (select 1 from big a join big b on b.id = a.id) -> result; subquery 1 (exists): run once (runs 1, from cache 0);   scan big a: full scan (rows read 1, kept 1);   join big b: primary key lookup per row (lookups 1, rows read 1, joined 1)
// expect: -- 5. in a block that writes, the order bound by keys: no whole-table read, no conflict with B's write
// expect: create table cust (id int primary key, name text) -> CREATE TABLE
// expect: insert into cust select g, 'c' || g from generate_series(1, 50) g -> INSERT 0 50
// expect: create table ord (id int primary key, cid int, note text) -> CREATE TABLE
// expect: insert into ord select g, g % 50 + 1, 'n' from generate_series(1, 5000) g -> INSERT 0 5000
// expect: create index ord_cid on ord (cid) -> CREATE INDEX
// expect: create table log (id int primary key, what text) -> CREATE TABLE
// expect: analyze -> ANALYZE
// expect: begin -> BEGIN
// expect: explain select count(*) from ord o join cust c on c.id = o.cid where o.id < 20 -> [QUERY PLAN] scan ord o: primary key range; join cust c: primary key lookup per row; aggregate
// expect: select count(*) from ord o join cust c on c.id = o.cid where o.id < 20 -> [count] 19
// expect: insert into log values (1, 'a') -> INSERT 0 1
// expect: B: update cust set name = 'zz' where id = 45 -> UPDATE 1
// expect: commit -> COMMIT
// expect: -- 6. the first table in batches wherever FROM put it
// expect: explain analyze select count(*) from small s join big b on b.sid = s.id where b.v = 3 -> scan big b: full scan (rows read 20000, kept 2857, batches 20); join small s: hash on (id) over full scan (table rows 100 of 100 read, probes 2857, rows read 2857, joined 2857); aggregate
// expect: -- second review (optimizer 33)
// expect: -- 1. the reordered first table's batches test text, LIKE and ranges on its own columns
// expect: create table ra (id int primary key) -> CREATE TABLE
// expect: create table rb (id int primary key, aid int, t1 text, t2 text) -> CREATE TABLE
// expect: insert into ra select g from generate_series(1, 50) g -> INSERT 0 50
// expect: insert into rb values (1, 1, 'x', 'y'), (2, 2, 'y', 'x'), (3, 3, 'z', 'z') -> INSERT 0 3
// expect: analyze -> ANALYZE
// expect: explain select ra.id, rb.id, rb.t1, rb.t2 from ra, rb where ra.id = rb.aid and rb.t1 = 'x' -> [QUERY PLAN] scan rb: full scan; join ra: primary key lookup per row
// expect: select ra.id, rb.id, rb.t1, rb.t2 from ra, rb where ra.id = rb.aid and rb.t1 = 'x' -> [id,id,t1,t2] 1|1|x|y
// expect: select ra.id, rb.id, rb.t1, rb.t2 from ra, rb where ra.id = rb.aid and rb.t1 like 'x%' -> [id,id,t1,t2] 1|1|x|y
// expect: select ra.id, rb.id, rb.t1, rb.t2 from ra join rb on ra.id = rb.aid where rb.t1 >= 'y' order by rb.id -> [id,id,t1,t2] 2|2|y|x; 3|3|z|z
// expect: select count(*), min(rb.t2) from ra join rb on ra.id = rb.aid where rb.t1 >= 'y' -> [count,min] 2|x
// expect: -- 3. a hashed table keeps its constant range when its key is also joined
// expect: create table ev (id int primary key, k int) -> CREATE TABLE
// expect: create table dim (k int primary key, nm text) -> CREATE TABLE
// expect: insert into ev select g, g from generate_series(1, 20000) g -> INSERT 0 20000
// expect: insert into dim select g, 'n' || g from generate_series(1, 20000) g -> INSERT 0 20000
// expect: analyze -> ANALYZE
// expect: explain analyze select count(*) from ev join dim on dim.k = ev.k where dim.k < 10 and ev.id > 19000 -> scan ev: primary key range (estimated 1000 rows) (rows read 1001, kept 1000, batches 1); join dim: hash on (k) over primary key range (estimated 9 rows) (table rows 9 of 10 read, probes 1000, rows read 0, joined 0); aggregate
// expect: -- 4. an aggregate subquery reads everything: its join is planned as the same query alone
// expect: explain select count(*) from big a join big b on b.id = a.sid -> [QUERY PLAN] scan big a: full scan; join big b: hash on (id) over full scan; aggregate
// expect: explain select (select count(*) from big a join big b on b.id = a.sid) -> [QUERY PLAN] result; subquery 1 (scalar): run once;   scan big a: full scan;   join big b: hash on (id) over full scan;   aggregate
// expect: explain select count(*) from big a join big b on b.id = a.sid limit 1 -> [QUERY PLAN] scan big a: full scan; join big b: hash on (id) over full scan; aggregate
// expect: -- third review (optimizer 39): customers, orders (customer 5 has 600 of the newest), items, skus, a settings row
// expect: create table cust3 (id int primary key, region int, name text) -> CREATE TABLE
// expect: insert into cust3 select g, g % 4 + 1, 'c' || g from generate_series(1, 400) g -> INSERT 0 400
// expect: create table ord3 (id int primary key, cid int, d date, st int) -> CREATE TABLE
// expect: insert into ord3 select g, (g * 7919) % 400 + 1, date '2020-01-01' + (g / 30), case when g % 50 = 0 then 9 else g % 3 end from generate_series(1, 2000) g -> INSERT 0 2000
// expect: insert into ord3 select 100000 + g, 5, date '2022-01-01' + (g % 300), g % 3 from generate_series(1, 600) g -> INSERT 0 600
// expect: create index ord3_cid on ord3 (cid) -> CREATE INDEX
// expect: create index ord3_d on ord3 (d) -> CREATE INDEX
// expect: create index ord3_st on ord3 (st) -> CREATE INDEX
// expect: create table item (oid int, n int, sku int, qty int, primary key (oid, n)) -> CREATE TABLE
// expect: insert into item select g / 2 + 1, g % 2, (g * 31) % 50 + 1, g % 7 from generate_series(1, 3000) g -> INSERT 0 3000
// expect: create index item_sku on item (sku) -> CREATE INDEX
// expect: create table sku (id int primary key, cat int, name text) -> CREATE TABLE
// expect: insert into sku select g, g % 5, 's' || g from generate_series(1, 50) g -> INSERT 0 50
// expect: create index sku_cat on sku (cat) -> CREATE INDEX
// expect: create table config (id int primary key, rate int) -> CREATE TABLE
// expect: insert into config values (1, 3) -> INSERT 0 1
// expect: analyze -> ANALYZE
// expect: -- 1. from a pinned row, the index by the constant's estimate: customer 5's orders of a day by date, not its 600 orders
// expect: explain analyze select count(*) from cust3 c join ord3 o on o.cid = c.id where c.id = 5 and o.d = date '2022-03-01' -> scan cust3 c: primary key lookup (rows read 1, kept 1); join ord3 o: hash on (cid) over index ord3_d lookup (estimated 7 rows) (table rows 2 of 2 read, probes 1, rows read 2, joined 2); aggregate
// expect: explain analyze select count(*) from cust3 c join ord3 o on o.cid = c.id where c.id = 77 and o.st = 9 -> scan cust3 c: primary key lookup (rows read 1, kept 1); join ord3 o: index ord3_cid lookup (estimated 7 rows) per row (lookups 1, rows read 5, joined 0); aggregate
// expect: -- 2. a pinned row that binds no other table (the settings) leaves the order to the costs
// expect: explain analyze select count(*), min(s.id) from sku s, config g, item i, ord3 o where i.oid = o.id and s.id = i.sku and o.d >= date '2020-02-01' and o.d < date '2020-02-08' and g.id = 1 -> scan ord3 o: index ord3_d range (estimated 210 rows) (rows read 240, kept 210); join item i: primary key range (estimated 2 rows) per row (lookups 210, rows read 420, joined 420); join sku s: hash on (id) over full scan (table rows 50 of 50 read, probes 420, rows read 420, joined 420); join config g: loop over primary key lookup (table rows 1 of 1 read, probes 420, rows read 420, joined 420); aggregate
// expect: -- 3. ORDER BY ... LIMIT from a pinned row: the orders in key order, stopping at 10, wherever FROM puts them
// expect: explain analyze select o.id, o.d, c.name from cust3 c join ord3 o on o.cid = c.id where c.id = 5 order by o.id limit 10 -> scan ord3 o: index ord3_cid lookup (estimated 605 rows) (rows read 10, kept 10); join cust3 c: hash on (id) over primary key lookup (table rows 1 of 1 read, probes 10, rows read 10, joined 10); order: the scan's; limit: stops the scan
// expect: explain analyze select o.id, o.d, c.name from ord3 o join cust3 c on o.cid = c.id where c.id = 5 order by o.id limit 10 -> scan ord3 o: index ord3_cid lookup (estimated 605 rows) (rows read 10, kept 10); join cust3 c: hash on (id) over primary key lookup (table rows 1 of 1 read, probes 10, rows read 10, joined 10); order: the scan's; limit: stops the scan
// expect: select o.id, o.d, c.name from cust3 c join ord3 o on o.cid = c.id where c.id = 5 order by o.id limit 3 -> [id,d,name] 316|2020-01-11|c5; 716|2020-01-24|c5; 1116|2020-02-07|c5
// expect: -- 4. equalities on columns no index leads with: ANALYZE counts their distinct values (qty 7, name 50)
// expect: explain analyze select count(*), min(s.id) from sku s, item i where s.id = i.sku and i.qty = 3 and s.cat = 0 -> scan item i: full scan (rows read 3000, kept 429, batches 3); join sku s: hash on (id) over index sku_cat lookup (estimated 10 rows) (table rows 10 of 10 read, probes 429, rows read 86, joined 86); aggregate
// expect: explain analyze select count(*), min(s.id) from sku s, item i where s.id = i.sku and i.qty = 3 and s.name = 's42' -> scan sku s: full scan (rows read 50, kept 1, batches 1); cross join item i: index item_sku lookup (estimated 60 rows) per row (lookups 1, rows read 60, joined 8); aggregate
// expect: -- 5. a range that is not the ORDER BY's: no early stop is planned (the range is read, then sorted)
// expect: explain analyze select o.id from ord3 o join cust3 c on c.id = o.cid where o.st < 2 order by o.id limit 10 -> scan ord3 o: index ord3_st range (estimated 1707 rows) (rows read 2600, kept 1707, switched to scan: cheaper than the range, by the measured costs); join cust3 c: hash on (id) over full scan (table rows 400 of 400 read, probes 1707, rows read 1707, joined 1707); order: sort
// expect: -- 6. a NaN bound: above every number (the primary key's range is the smaller)
// expect: create table fl (id int primary key, f float8) -> CREATE TABLE
// expect: insert into fl select g, g / 7.0 from generate_series(1, 1000) g -> INSERT 0 1000
// expect: create index fl_f on fl (f) -> CREATE INDEX
// expect: analyze fl -> ANALYZE
// expect: explain analyze select count(*) from fl where f < 'NaN' and id > 500 -> scan fl: primary key range (rows read 501, kept 500, batches 1); aggregate
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"

fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows {
                println(sql + " -> " + r.tag)
                return
            }
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name) }
            println(sql + " -> [" + strings.join(&names, ",") + "]" + (if len(lines) > 0 { " " } else { "" }) + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

// EXPLAIN ANALYZE without its last line (the time).
fn analyze(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for i in 0..len(r.rows) - 1 { append(mut &lines, lexdb_exec.text(&r.rows[i][0])) }
            println(sql + " -> " + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var a = lexdb_exec.newSession(st)
    var b = lexdb_exec.newSession(st)
    println("-- tables as the review's: small (100 rows, one labelled x), big (20,000, 200 per small row, a pad column)")
    show(mut &a, "create table small (id int primary key, label text)")
    show(mut &a, "insert into small select g, case when g = 7 then 'x' else 'l' || (g % 10) end from generate_series(1, 100) g")
    show(mut &a, "create index small_label on small (label)")
    show(mut &a, "create table big (id int primary key, sid int, v int, pad text)")
    show(mut &a, "insert into big select g, g % 100 + 1, g % 7, repeat('x', 50) from generate_series(1, 20000) g")
    show(mut &a, "create index big_sid on big (sid)")
    println("-- 1. a key value the column cannot hold matches no row (it was an error in a hash probe or a lookup)")
    show(mut &a, "create table bigv (id bigint primary key, x bigint, t text)")
    show(mut &a, "insert into bigv values (1, 1, '1'), (2, 1099511627776, 'abc'), (3, 3, 'abcdef'), (4, null, null), (5, 5, ' 5')")
    show(mut &a, "create table sm (id int primary key, vc varchar(3))")
    show(mut &a, "insert into sm values (1, '1'), (2, 'abc'), (3, 'ab'), (5, '5')")
    show(mut &a, "create index sm_vc on sm (vc)")
    show(mut &a, "analyze")
    show(mut &a, "select count(*) from sm s join bigv b on s.id = b.x")
    show(mut &a, "select count(*) from bigv b join sm s on s.vc = b.t")
    show(mut &a, "select count(*) from bigv b join sm s on s.id = b.x")
    show(mut &a, "select count(*) from sm where id = 1099511627776")
    show(mut &a, "select count(*) from sm where id = 'abc'")
    show(mut &a, "set lexdb_planner = rules")
    show(mut &a, "select count(*) from sm s join bigv b on s.id = b.x")
    show(mut &a, "select count(*) from bigv b join sm s on s.vc = b.t")
    show(mut &a, "reset lexdb_planner")
    println("-- 2. a hash join fits the statement's memory: with 256kB, big is looked up per row")
    show(mut &a, "set max_statement_mem = '256kB'")
    show(mut &a, "explain select count(*), max(b.pad) from big a join big b on b.id = a.sid")
    show(mut &a, "select count(*) from big a join big b on b.id = a.sid")
    show(mut &a, "reset max_statement_mem")
    show(mut &a, "explain select count(*) from big a join big b on b.id = a.sid")
    println("-- 3. ranges, IN lists and other filters count: the range's table first")
    analyze(mut &a, "explain analyze select count(*) from big b join small s on b.sid = s.id where b.id < 5 and s.label = 'l3'")
    analyze(mut &a, "explain analyze select count(*) from big a join big b on b.id = a.sid where a.id between 10 and 12")
    analyze(mut &a, "explain analyze select count(*) from big a join big b on b.id = a.sid where a.pad = 'none'")
    println("-- 4. a LIMIT or EXISTS keeps lookups: no hash built for one row")
    analyze(mut &a, "explain analyze select a.id from big a join big b on b.id = a.id limit 1")
    analyze(mut &a, "explain analyze select 1 where exists (select 1 from big a join big b on b.id = a.id)")
    println("-- 5. in a block that writes, the order bound by keys: no whole-table read, no conflict with B's write")
    show(mut &a, "create table cust (id int primary key, name text)")
    show(mut &a, "insert into cust select g, 'c' || g from generate_series(1, 50) g")
    show(mut &a, "create table ord (id int primary key, cid int, note text)")
    show(mut &a, "insert into ord select g, g % 50 + 1, 'n' from generate_series(1, 5000) g")
    show(mut &a, "create index ord_cid on ord (cid)")
    show(mut &a, "create table log (id int primary key, what text)")
    show(mut &a, "analyze")
    show(mut &a, "begin")
    show(mut &a, "explain select count(*) from ord o join cust c on c.id = o.cid where o.id < 20")
    show(mut &a, "select count(*) from ord o join cust c on c.id = o.cid where o.id < 20")
    show(mut &a, "insert into log values (1, 'a')")
    print("B: ")
    show(mut &b, "update cust set name = 'zz' where id = 45")
    show(mut &a, "commit")
    println("-- 6. the first table in batches wherever FROM put it")
    analyze(mut &a, "explain analyze select count(*) from small s join big b on b.sid = s.id where b.v = 3")
    println("-- second review (optimizer 33)")
    println("-- 1. the reordered first table's batches test text, LIKE and ranges on its own columns")
    show(mut &a, "create table ra (id int primary key)")
    show(mut &a, "create table rb (id int primary key, aid int, t1 text, t2 text)")
    show(mut &a, "insert into ra select g from generate_series(1, 50) g")
    show(mut &a, "insert into rb values (1, 1, 'x', 'y'), (2, 2, 'y', 'x'), (3, 3, 'z', 'z')")
    show(mut &a, "analyze")
    show(mut &a, "explain select ra.id, rb.id, rb.t1, rb.t2 from ra, rb where ra.id = rb.aid and rb.t1 = 'x'")
    show(mut &a, "select ra.id, rb.id, rb.t1, rb.t2 from ra, rb where ra.id = rb.aid and rb.t1 = 'x'")
    show(mut &a, "select ra.id, rb.id, rb.t1, rb.t2 from ra, rb where ra.id = rb.aid and rb.t1 like 'x%'")
    show(mut &a, "select ra.id, rb.id, rb.t1, rb.t2 from ra join rb on ra.id = rb.aid where rb.t1 >= 'y' order by rb.id")
    show(mut &a, "select count(*), min(rb.t2) from ra join rb on ra.id = rb.aid where rb.t1 >= 'y'")
    println("-- 3. a hashed table keeps its constant range when its key is also joined")
    show(mut &a, "create table ev (id int primary key, k int)")
    show(mut &a, "create table dim (k int primary key, nm text)")
    show(mut &a, "insert into ev select g, g from generate_series(1, 20000) g")
    show(mut &a, "insert into dim select g, 'n' || g from generate_series(1, 20000) g")
    show(mut &a, "analyze")
    analyze(mut &a, "explain analyze select count(*) from ev join dim on dim.k = ev.k where dim.k < 10 and ev.id > 19000")
    println("-- 4. an aggregate subquery reads everything: its join is planned as the same query alone")
    show(mut &a, "explain select count(*) from big a join big b on b.id = a.sid")
    show(mut &a, "explain select (select count(*) from big a join big b on b.id = a.sid)")
    show(mut &a, "explain select count(*) from big a join big b on b.id = a.sid limit 1")
    println("-- third review (optimizer 39): customers, orders (customer 5 has 600 of the newest), items, skus, a settings row")
    show(mut &a, "create table cust3 (id int primary key, region int, name text)")
    show(mut &a, "insert into cust3 select g, g % 4 + 1, 'c' || g from generate_series(1, 400) g")
    show(mut &a, "create table ord3 (id int primary key, cid int, d date, st int)")
    show(mut &a, "insert into ord3 select g, (g * 7919) % 400 + 1, date '2020-01-01' + (g / 30), case when g % 50 = 0 then 9 else g % 3 end from generate_series(1, 2000) g")
    show(mut &a, "insert into ord3 select 100000 + g, 5, date '2022-01-01' + (g % 300), g % 3 from generate_series(1, 600) g")
    show(mut &a, "create index ord3_cid on ord3 (cid)")
    show(mut &a, "create index ord3_d on ord3 (d)")
    show(mut &a, "create index ord3_st on ord3 (st)")
    show(mut &a, "create table item (oid int, n int, sku int, qty int, primary key (oid, n))")
    show(mut &a, "insert into item select g / 2 + 1, g % 2, (g * 31) % 50 + 1, g % 7 from generate_series(1, 3000) g")
    show(mut &a, "create index item_sku on item (sku)")
    show(mut &a, "create table sku (id int primary key, cat int, name text)")
    show(mut &a, "insert into sku select g, g % 5, 's' || g from generate_series(1, 50) g")
    show(mut &a, "create index sku_cat on sku (cat)")
    show(mut &a, "create table config (id int primary key, rate int)")
    show(mut &a, "insert into config values (1, 3)")
    show(mut &a, "analyze")
    println("-- 1. from a pinned row, the index by the constant's estimate: customer 5's orders of a day by date, not its 600 orders")
    analyze(mut &a, "explain analyze select count(*) from cust3 c join ord3 o on o.cid = c.id where c.id = 5 and o.d = date '2022-03-01'")
    analyze(mut &a, "explain analyze select count(*) from cust3 c join ord3 o on o.cid = c.id where c.id = 77 and o.st = 9")
    println("-- 2. a pinned row that binds no other table (the settings) leaves the order to the costs")
    analyze(mut &a, "explain analyze select count(*), min(s.id) from sku s, config g, item i, ord3 o where i.oid = o.id and s.id = i.sku and o.d >= date '2020-02-01' and o.d < date '2020-02-08' and g.id = 1")
    println("-- 3. ORDER BY ... LIMIT from a pinned row: the orders in key order, stopping at 10, wherever FROM puts them")
    analyze(mut &a, "explain analyze select o.id, o.d, c.name from cust3 c join ord3 o on o.cid = c.id where c.id = 5 order by o.id limit 10")
    analyze(mut &a, "explain analyze select o.id, o.d, c.name from ord3 o join cust3 c on o.cid = c.id where c.id = 5 order by o.id limit 10")
    show(mut &a, "select o.id, o.d, c.name from cust3 c join ord3 o on o.cid = c.id where c.id = 5 order by o.id limit 3")
    println("-- 4. equalities on columns no index leads with: ANALYZE counts their distinct values (qty 7, name 50)")
    analyze(mut &a, "explain analyze select count(*), min(s.id) from sku s, item i where s.id = i.sku and i.qty = 3 and s.cat = 0")
    analyze(mut &a, "explain analyze select count(*), min(s.id) from sku s, item i where s.id = i.sku and i.qty = 3 and s.name = 's42'")
    println("-- 5. a range that is not the ORDER BY's: no early stop is planned (the range is read, then sorted)")
    analyze(mut &a, "explain analyze select o.id from ord3 o join cust3 c on c.id = o.cid where o.st < 2 order by o.id limit 10")
    println("-- 6. a NaN bound: above every number (the primary key's range is the smaller)")
    show(mut &a, "create table fl (id int primary key, f float8)")
    show(mut &a, "insert into fl select g, g / 7.0 from generate_series(1, 1000) g")
    show(mut &a, "create index fl_f on fl (f)")
    show(mut &a, "analyze fl")
    analyze(mut &a, "explain analyze select count(*) from fl where f < 'NaN' and id > 500")
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
