// lexdb over TNS: the third bug slice (design/lexdb-robust.md, "The third bug slice"), checked against Oracle Database Free 23.26
// (gen_oracle.py --check tns_bugs3): MIN and MAX of equal instants with different offsets keep the first one read (a keyed table
// filled in key order, a keyless one, an index on the column, GROUP BY, a window, NULLs, no rows); a TIMESTAMP WITH LOCAL TIME
// ZONE value is type 231 (in DBTIMEZONE); a datetime plus an INTERVAL YEAR TO MONTH whose day is not in the month is ORA-01839
// (DATE, TIMESTAMP, TIMESTAMP WITH TIME ZONE moved in UTC, NUMTOYMINTERVAL; ADD_MONTHS clamps); OFFSET and LIMIT as column
// aliases, column names and a table's alias. Each statement runs with set lexdb_batch = off (the row engine) and on: "same" and
// the answer, or DIFFERENT and both.
// expect: setup: 22 statements
// expect: same: MN,MX = '10:00 +02:00'|'10:00 +02:00'
// expect: same: G,MN,MX,N = 1|'10:00 +02:00'|'10:00 +02:00'|3;2|'07:00 +00:00'|'07:00 +00:00'|2;3|NULL|NULL|0
// expect: same: MN,MX = '07:00 +00:00'|'10:00 +02:00'
// expect: same: MX = '10:00 +02:00'
// expect: same: MN = '07:00 +00:00'
// expect: same: MN,MX = NULL|NULL
// expect: same: MN,MX = NULL|NULL
// expect: same: ID,MN,MX = 1|'10:00 +02:00'|'10:00 +02:00';2|'10:00 +02:00'|'10:00 +02:00';3|'10:00 +02:00'|'10:00 +02:00';4|'07:00 +00:00'|'07:00 +00:00';5|'07:00 +00:00'|'07:00 +00:00';6|'07:00 +00:00'|'07:00 +00:00';7|NULL|NULL
// expect: same: MN,MX = '08:00'|'08:00'
// expect: same: K,MN,MX = 'x'|'13:30 +05:30'|'13:30 +05:30';'y'|'10:00 +02:00'|'10:00 +02:00'
// expect: same: MN,MX = '13:30 +05:30'|'13:30 +05:30'
// expect: same: MN,MX = '10:00 +02:00'|'01:00 +01:00'
// expect: same: MX = '10:00 +02:00'
// expect: same: MN = '10:00 +02:00'
// expect: same: ID,A = 1|'10:00 +02:00';2|'08:00 +00:00';3|'13:30 +05:30';4|'01:00 +01:00'
// expect: same: N,C = 2|4
// expect: same: A = '01:00 +01:00'
// expect: same: A = '2026-03-15T08:00:00'
// expect: same: A = '2026-03-15T08:00:00'
// expect: same: ID,A = 3|'2026-03-15T08:00:00';4|NULL
// expect: same: A = 
// expect: same: error 1839
// expect: same: error 1839
// expect: same: error 1839
// expect: same: error 1839
// expect: same: A = '2028-02-29'
// expect: same: error 1839
// expect: same: error 1839
// expect: same: error 1839
// expect: same: A = '2026-02-28 23:00 -05:00'
// expect: same: A = '2026-01-29 01:00 +05:00'
// expect: same: A = '2026-04-15 10:00 +02:00'
// expect: same: error 1839
// expect: same: A = '2026-02-28'
// expect: same: A = '2026-03-02'
// expect: same: error 1839
// expect: same: A = NULL
// expect: same: ID,A = 1|'2027-02-15 10:00 +02:00';2|'2027-02-15 08:00 +00:00';3|'2027-02-15 13:30 +05:30'
// expect: same: N = 3
// expect: same: OFFSET = 1
// expect: same: OFFSET = 1
// expect: same: LIMIT = 1
// expect: same: LIMIT = 1
// expect: same: OFFSET,LIMIT = 1|2
// expect: same: OFFSET,LIMIT = 1|2;3|4
// expect: same: LIMIT = 2
// expect: same: OFFSET = 1
// expect: same: OFFSET,LIMIT = 3|4
// expect: same: OFFSET = 1
// expect: same: S = 3;7
// expect: same: X = 1
// expect: same: DUMMY = 'X'
// expect: same: A = 1
// expect: same: DUMMY = 'X'
// expect: same: A = 1
// expect: same: 1 / LIMIT = 3
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table b3m (id number primary key, g number, t timestamp with time zone, l timestamp with local time zone)\ninsert into b3m values (1, 1, timestamp '2026-03-15 10:00:00 +02:00', timestamp '2026-03-15 10:00:00 +02:00')\ninsert into b3m values (2, 1, timestamp '2026-03-15 08:00:00 +00:00', timestamp '2026-03-15 08:00:00 +00:00')\ninsert into b3m values (3, 1, timestamp '2026-03-15 13:30:00 +05:30', timestamp '2026-03-15 13:30:00 +05:30')\ninsert into b3m values (4, 2, timestamp '2026-03-15 07:00:00 +00:00', null)\ninsert into b3m values (5, 2, timestamp '2026-03-15 09:00:00 +02:00', null)\ninsert into b3m values (6, 2, null, null)\ninsert into b3m values (7, 3, null, null)\ncreate table b3h (k varchar2(10), t timestamp with time zone)\ninsert into b3h values ('x', timestamp '2026-03-15 13:30:00 +05:30')\ninsert into b3h values ('y', timestamp '2026-03-15 10:00:00 +02:00')\ninsert into b3h values ('x', timestamp '2026-03-15 08:00:00 +00:00')\ninsert into b3h values ('y', timestamp '2026-03-15 12:00:00 +04:00')\ncreate table b3n (id number primary key, t timestamp with time zone)\ninsert into b3n values (1, timestamp '2026-03-15 10:00:00 +02:00')\ninsert into b3n values (2, timestamp '2026-03-15 08:00:00 +00:00')\ninsert into b3n values (3, timestamp '2026-03-15 13:30:00 +05:30')\ninsert into b3n values (4, timestamp '2026-03-16 01:00:00 +01:00')\ncreate index b3n_t on b3n (t)\ncreate table b3o (offset number, limit number)\ninsert into b3o (offset, limit) values (1, 2)\ninsert into b3o (offset, limit) values (3, 4)"

const QS = "select to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m where g = 1\nselect g, to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx, count(t) n from b3m group by g order by g\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m\nselect to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m where g = 1\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn from b3m where g = 2\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m where g = 3\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m where id > 100\nselect id, to_char(min(t) over (partition by g), 'HH24:MI TZH:TZM') mn, to_char(max(t) over (partition by g), 'HH24:MI TZH:TZM') mx from b3m order by id\nselect to_char(min(l), 'HH24:MI') mn, to_char(max(l), 'HH24:MI') mx from b3m\nselect k, to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3h group by k order by k\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3h\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3n\nselect to_char(max(t), 'HH24:MI TZH:TZM') mx from b3n where t < timestamp '2026-03-16 00:00:00 +00:00'\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn from b3n where t > timestamp '2026-03-15 00:00:00 +00:00'\nselect id, to_char(t, 'HH24:MI TZH:TZM') a from b3n where t > timestamp '2026-03-15 00:00:00 +00:00' order by id\nselect count(distinct t) n, count(*) c from b3n where t > timestamp '2026-03-15 00:00:00 +00:00'\nselect to_char(t, 'HH24:MI TZH:TZM') a from b3n where t = timestamp '2026-03-16 00:00:00 +00:00'\nselect cast(timestamp '2026-03-15 10:00:00 +02:00' as timestamp with local time zone) a from dual\nselect l a from b3m where id = 1\nselect id, l a from b3m where id in (3, 4) order by id\nselect l a from b3m where id > 100\nselect to_char(date '2026-01-31' + interval '1' month, 'YYYY-MM-DD') a from dual\nselect to_char(date '2026-01-31' - interval '2' month, 'YYYY-MM-DD') a from dual\nselect to_char(date '2026-01-30' + interval '1' month, 'YYYY-MM-DD') a from dual\nselect to_char(date '2024-02-29' + interval '1' year, 'YYYY-MM-DD') a from dual\nselect to_char(date '2024-02-29' + interval '4' year, 'YYYY-MM-DD') a from dual\nselect to_char(date '2026-03-31' + interval '1-1' year to month, 'YYYY-MM-DD') a from dual\nselect to_char(timestamp '2026-01-31 10:00:00' + interval '1' month, 'YYYY-MM-DD HH24:MI') a from dual\nselect to_char(timestamp '2026-01-31 10:00:00 +02:00' + interval '1' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-01-31 23:00:00 -05:00' + interval '1' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-03-01 01:00:00 +05:00' - interval '1' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' + interval '1' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(date '2026-01-31' + numtoyminterval(1, 'MONTH'), 'YYYY-MM-DD') a from dual\nselect to_char(add_months(date '2026-01-31', 1), 'YYYY-MM-DD') a from dual\nselect to_char(date '2026-01-31' + interval '30' day, 'YYYY-MM-DD') a from dual\nselect to_char(interval '1' month + date '2026-01-31', 'YYYY-MM-DD') a from dual\nselect to_char(cast(null as date) + interval '1' month, 'YYYY-MM-DD') a from dual\nselect id, to_char(t + interval '11' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from b3m where id < 4 order by id\nselect count(*) n from b3m where t + interval '1' month > timestamp '2026-04-15 07:30:00 +00:00'\nselect 1 offset from dual\nselect 1 as offset from dual\nselect 1 limit from dual\nselect 1 as limit from dual\nselect 1 offset, 2 limit from dual\nselect offset, limit from b3o order by offset\nselect limit from b3o order by limit desc offset 1 rows\nselect offset from b3o order by offset fetch first 1 rows only\nselect b.offset, b.limit from b3o b where b.offset = 3\nselect * from (select 1 offset from dual) where offset = 1\nselect offset + limit s from b3o order by s\nselect 1 x from dual offset 0 rows\nselect dummy from dual d offset 0 rows\nselect 1 a from dual offset\nselect offset.dummy from dual offset\nwith offset as (select 1 a from dual) select a from offset\nupdate b3o set limit = limit + 1 where offset = 1 ;; select limit from b3o where offset = 1"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(173), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
