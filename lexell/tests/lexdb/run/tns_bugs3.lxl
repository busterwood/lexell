const SETUP = "create table b3m (id number primary key, g number, t timestamp with time zone, l timestamp with local time zone)\ninsert into b3m values (1, 1, timestamp '2026-03-15 10:00:00 +02:00', timestamp '2026-03-15 10:00:00 +02:00')\ninsert into b3m values (2, 1, timestamp '2026-03-15 08:00:00 +00:00', timestamp '2026-03-15 08:00:00 +00:00')\ninsert into b3m values (3, 1, timestamp '2026-03-15 13:30:00 +05:30', timestamp '2026-03-15 13:30:00 +05:30')\ninsert into b3m values (4, 2, timestamp '2026-03-15 07:00:00 +00:00', null)\ninsert into b3m values (5, 2, timestamp '2026-03-15 09:00:00 +02:00', null)\ninsert into b3m values (6, 2, null, null)\ninsert into b3m values (7, 3, null, null)\ncreate table b3h (k varchar2(10), t timestamp with time zone)\ninsert into b3h values ('x', timestamp '2026-03-15 13:30:00 +05:30')\ninsert into b3h values ('y', timestamp '2026-03-15 10:00:00 +02:00')\ninsert into b3h values ('x', timestamp '2026-03-15 08:00:00 +00:00')\ninsert into b3h values ('y', timestamp '2026-03-15 12:00:00 +04:00')\ncreate table b3n (id number primary key, t timestamp with time zone)\ninsert into b3n values (1, timestamp '2026-03-15 10:00:00 +02:00')\ninsert into b3n values (2, timestamp '2026-03-15 08:00:00 +00:00')\ninsert into b3n values (3, timestamp '2026-03-15 13:30:00 +05:30')\ninsert into b3n values (4, timestamp '2026-03-16 01:00:00 +01:00')\ncreate index b3n_t on b3n (t)\ncreate table b3o (offset number, limit number)\ninsert into b3o (offset, limit) values (1, 2)\ninsert into b3o (offset, limit) values (3, 4)\ncreate table b11t (id number primary key, x number)\ninsert into b11t values (1, 10)\ninsert into b11t values (2, 20)\ninsert into b11t values (3, null)\ncreate or replace function b11f(n number) return number is begin return n * 2; end;\ncreate or replace function b11s(s varchar2) return varchar2 is begin return '<' || s || '>'; end;\ncreate or replace package b11p is function g(n number) return number; end;\ncreate or replace package body b11p is function g(n number) return number is begin return n + 100; end; end;\ncreate view b11v as select id, b11f(x) y from b11t\ncreate view b11w as select id, b11p.g(x) y, b11f(id) z from b11t where b11f(x) > 20\ncreate view b11x as select b11f(3) a, b11s('q') b from dual\ncreate table b12t (a number, b varchar2(10))\ncreate index b12i on b12t (a)\ncreate view b12v as select a from b12t"

const QS = "select to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m where g = 1\nselect g, to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx, count(t) n from b3m group by g order by g\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m\nselect to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m where g = 1\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn from b3m where g = 2\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m where g = 3\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3m where id > 100\nselect id, to_char(min(t) over (partition by g), 'HH24:MI TZH:TZM') mn, to_char(max(t) over (partition by g), 'HH24:MI TZH:TZM') mx from b3m order by id\nselect to_char(min(l), 'HH24:MI') mn, to_char(max(l), 'HH24:MI') mx from b3m\nselect k, to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3h group by k order by k\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3h\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn, to_char(max(t), 'HH24:MI TZH:TZM') mx from b3n\nselect to_char(max(t), 'HH24:MI TZH:TZM') mx from b3n where t < timestamp '2026-03-16 00:00:00 +00:00'\nselect to_char(min(t), 'HH24:MI TZH:TZM') mn from b3n where t > timestamp '2026-03-15 00:00:00 +00:00'\nselect id, to_char(t, 'HH24:MI TZH:TZM') a from b3n where t > timestamp '2026-03-15 00:00:00 +00:00' order by id\nselect count(distinct t) n, count(*) c from b3n where t > timestamp '2026-03-15 00:00:00 +00:00'\nselect to_char(t, 'HH24:MI TZH:TZM') a from b3n where t = timestamp '2026-03-16 00:00:00 +00:00'\nselect cast(timestamp '2026-03-15 10:00:00 +02:00' as timestamp with local time zone) a from dual\nselect l a from b3m where id = 1\nselect id, l a from b3m where id in (3, 4) order by id\nselect l a from b3m where id > 100\nselect to_char(date '2026-01-31' + interval '1' month, 'YYYY-MM-DD') a from dual\nselect to_char(date '2026-01-31' - interval '2' month, 'YYYY-MM-DD') a from dual\nselect to_char(date '2026-01-30' + interval '1' month, 'YYYY-MM-DD') a from dual\nselect to_char(date '2024-02-29' + interval '1' year, 'YYYY-MM-DD') a from dual\nselect to_char(date '2024-02-29' + interval '4' year, 'YYYY-MM-DD') a from dual\nselect to_char(date '2026-03-31' + interval '1-1' year to month, 'YYYY-MM-DD') a from dual\nselect to_char(timestamp '2026-01-31 10:00:00' + interval '1' month, 'YYYY-MM-DD HH24:MI') a from dual\nselect to_char(timestamp '2026-01-31 10:00:00 +02:00' + interval '1' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-01-31 23:00:00 -05:00' + interval '1' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-03-01 01:00:00 +05:00' - interval '1' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(timestamp '2026-03-15 10:00:00 +02:00' + interval '1' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from dual\nselect to_char(date '2026-01-31' + numtoyminterval(1, 'MONTH'), 'YYYY-MM-DD') a from dual\nselect to_char(add_months(date '2026-01-31', 1), 'YYYY-MM-DD') a from dual\nselect to_char(date '2026-01-31' + interval '30' day, 'YYYY-MM-DD') a from dual\nselect to_char(interval '1' month + date '2026-01-31', 'YYYY-MM-DD') a from dual\nselect to_char(cast(null as date) + interval '1' month, 'YYYY-MM-DD') a from dual\nselect id, to_char(t + interval '11' month, 'YYYY-MM-DD HH24:MI TZH:TZM') a from b3m where id < 4 order by id\nselect count(*) n from b3m where t + interval '1' month > timestamp '2026-04-15 07:30:00 +00:00'\nselect 1 offset from dual\nselect 1 as offset from dual\nselect 1 limit from dual\nselect 1 as limit from dual\nselect 1 offset, 2 limit from dual\nselect offset, limit from b3o order by offset\nselect limit from b3o order by limit desc offset 1 rows\nselect offset from b3o order by offset fetch first 1 rows only\nselect b.offset, b.limit from b3o b where b.offset = 3\nselect * from (select 1 offset from dual) where offset = 1\nselect offset + limit s from b3o order by s\nselect 1 x from dual offset 0 rows\nselect dummy from dual d offset 0 rows\nselect 1 a from dual offset\nselect offset.dummy from dual offset\nwith offset as (select 1 a from dual) select a from offset\nupdate b3o set limit = limit + 1 where offset = 1 ;; select limit from b3o where offset = 1\nselect * from b11v order by id\nselect * from b11w order by id\nselect a, b from b11x\nselect v.id, v.y, w.y w from b11v v join b11w w on w.id = v.id\nselect count(*) n from b11v where y > 10\nselect id, y from b11v where id in (select id from b11w) order by id\nselect max(y) m, sum(y) s from b11v\nselect text from user_views where view_name = 'B11V'\nselect id, b11f(y) yy from b11v order by id\ncreate or replace function b11f(n number) return number is begin return n * 3; end;\nselect * from b11v order by id\ncreate or replace function b11f(n number) return number is begin return n * 2; end;\ncreate table b12c (a annotations (x 'y')) as select 1 a from dual\ncreate table b12c (a number annotations (x 'y')) as select 1 a from dual\ncreate table b12c (a, b annotations (z)) as select 1 a, 2 b from dual\nalter table b12t modify (a annotations (add x), a annotations (add y))\nalter table b12t modify (a number, a number)\nalter table b12t modify (a annotations (add q), b varchar2(20), a annotations (add r))\nalter index b12nosuch rename to b12z\nalter index b12nosuch annotations (add x)\nalter index b12nosuch rebuild\nalter index b12i rebuild\nalter index b12i rebuild online\nalter index b12i coalesce\nalter index b12i noparallel\nalter table b12v add (c number)\nalter table b12v annotations (add x)\nalter table b12v rename to b12vv\nalter view b12t compile\nalter view b12t annotations (add x)\nalter view b12v compile\nalter view b12v rename to b12w\nalter view b12nosuch compile\nalter view b12v editionable\nselect view_name from user_views where view_name like 'B12%' order by 1"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(173), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
