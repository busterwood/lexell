// expect: same: id,path: 1|'ann';2|'ann/bob';4|'ann/bob/dan';9|'ann/bob/dan/ivy';10|'ann/bob/dan/ivy/jon';6|'ann/bob/fay';3|'ann/cid';5|'ann/cid/eve';7|'gus';8|'gus/hal';12|'lou'
// expect: same: lvl,n: 0|3;1|3;2|3;3|1;4|1
// expect: same: name,lvl: 'dan'|2;'eve'|2;'fay'|2;'ivy'|3;'jon'|4
