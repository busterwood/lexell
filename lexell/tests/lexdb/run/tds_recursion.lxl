// expect: same: id,lvl: 2|0;6|1;7|1;8|1;24|2;25|2;26|2;78|3;79|3;80|3;240|4;241|4
// expect: same: id,lvl: 2999|0
// expect: same: n: 1;2;3
// expect: same: n,k: 1|'x';2|'x';3|'x'
// expect: same: (11) // n,s: 11|16
// expect: same: (5) // id,name: 2|'xbob';4|'xdan';6|'xfay';9|'xivy';10|'xjon'
// expect: same: (2) // n: 10
// expect: same: (11) // n,s: 11|160
// expect: same: error 530 // n: 0
// expect: same: (200) // n: 200
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
