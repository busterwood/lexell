const QUERIES = "@once create table rx (id int primary key, s varchar(40), p varchar(20), f varchar(5))\n@once insert into rx values (1, 'abc', 'b', 'i'), (2, 'ABC', 'b', 'c'), (3, NULL, 'a', ''), (4, 'a1b22c333', '\\d+', ''), (5, 'x' + char(10) + 'ab', '^ab', 'm'), (6, 'a' + char(10) + 'b', 'a.b', 's'), (7, '', 'x*', ''), (8, 'é1', '\\d', NULL), (9, 'ABC', 'b', 'ci'), (10, 'ab', 'a|ab', '')\n@once create table rp (id int primary key, s varchar(10), p varchar(10))\n@once insert into rp values (1, 'abc', 'b'), (2, 'abc', 'c'), (3, 'abc', '('), (4, 'abc', 'a')\n@once create table rbig (id int primary key, s varchar(20), k varchar(10))\n@once with n as (select 1 as i union all select i + 1 from n where i < 3000) insert into rbig select i, 'v' + cast(i % 97 as varchar(5)) + 'x' + cast(i % 13 as varchar(5)), case when i % 50 = 0 then NULL else 'k' + cast(i % 7 as varchar(5)) end from n option (maxrecursion 3000)\nselect id, case when regexp_like(s, p) then 1 else 0 end as m from rx order by id\nselect id from rx where regexp_like(s, 'b', 'i') order by id\nselect id from rx where regexp_like(s, p, f) order by id\nselect id from rx where not regexp_like(s, 'b') order by id\nselect id, iif(regexp_like(s, '^a', 'i'), 'y', 'n') as m from rx order by id\nselect case when regexp_like('abc', 'B', 'i') then 1 else 0 end, case when regexp_like('abc', 'B') then 1 else 0 end, case when regexp_like('abc', 'B', 'c') then 1 else 0 end, case when regexp_like('abc', 'b', '') then 1 else 0 end\nselect case when regexp_like('ab', 'B', 'ic') then 1 else 0 end, case when regexp_like('ab', 'B', 'ci') then 1 else 0 end, case when regexp_like('ab', 'B', 'iic') then 1 else 0 end\nselect case when regexp_like('a' + char(10) + 'b', 'a.b') then 1 else 0 end, case when regexp_like('a' + char(10) + 'b', 'a.b', 's') then 1 else 0 end, case when regexp_like('x' + char(10) + 'ab', '^ab') then 1 else 0 end, case when regexp_like('x' + char(10) + 'ab', '^ab', 'm') then 1 else 0 end, case when regexp_like('x' + char(10) + 'ab', '^ab', 'sm') then 1 else 0 end, case when regexp_like('ab' + char(10), 'b$') then 1 else 0 end\nselect case when regexp_like('a', '(?i)A') then 1 else 0 end, case when regexp_like('a' + char(10) + 'b', '(?s)a.b') then 1 else 0 end\nselect case when regexp_like(NULL, 'b') then 1 else 0 end, case when regexp_like('abc', NULL) then 1 else 0 end, case when regexp_like('abc', 'b', NULL) then 1 else 0 end\nselect case when regexp_like('abc', 'b', 'q') then 1 else 0 end\nselect case when regexp_like('abc', 'b', 'x') then 1 else 0 end\nselect case when regexp_like('abc', 'b', 'g') then 1 else 0 end\nselect case when regexp_like('abc', 'b', 'iz') then 1 else 0 end\ndeclare @f varchar(5) = 'i'; select case when regexp_like('ABC', 'b', @f) then 1 else 0 end\ndeclare @f varchar(5) = 'q'; select case when regexp_like('ABC', 'b', @f) then 1 else 0 end\nselect case when regexp_like('abc', '(b') then 1 else 0 end\nselect case when regexp_like('abc', 'b[') then 1 else 0 end\nselect case when regexp_like('abc', 'a)') then 1 else 0 end\nselect case when regexp_like('abc', 'a\\') then 1 else 0 end\nselect case when regexp_like('abc', 'a{2,1}') then 1 else 0 end\nselect case when regexp_like('abc', '\\1') then 1 else 0 end\nselect case when regexp_like('abc', '(?=a)') then 1 else 0 end\nselect case when regexp_like('abc', '*a') then 1 else 0 end\nselect case when regexp_like('abc', '[z-a]') then 1 else 0 end\nselect case when regexp_like('abc', '\\m') then 1 else 0 end\nselect case when regexp_like('abc', '\\y') then 1 else 0 end\nselect id from rp where regexp_like(s, p) order by id\nselect count(*) from rbig where regexp_like(s, case when id = 2500 then '(' else 'v' end)\nselect regexp_like('abc', 'b')\nselect regexp_like('abc', 'b') as x\nselect x = regexp_like('abc', 'b')\nselect id, regexp_replace(s, '[a-z]', '*') from rx order by id\nselect id, regexp_replace(s, '\\d+', '#', 1, 2) from rx order by id\nselect id, regexp_replace(s, '(\\w)(\\w)', '\\2\\1', 2) from rx order by id\nselect id, regexp_replace(s, 'B', 'x', 1, 0, f) from rx order by id\nselect regexp_replace('a1b22c', '\\d+', '#'), regexp_replace('a1b22c', '\\d+', '#', 1, 0), regexp_replace('a1b22c', '\\d+', '#', 1, 1), regexp_replace('a1b22c', '\\d+', '#', 1, 2), regexp_replace('a1b22c', '\\d+', '#', 3), regexp_replace('a1b22c', '\\d+', '#', 9)\nselect regexp_replace('abc', '(b)', '[\\1]'), regexp_replace('abc', 'B', 'x', 1, 0, 'i'), regexp_replace('abc', 'B', 'x'), regexp_replace('abcd', 'a|ab', 'X'), regexp_replace('abc', '', '-')\nselect regexp_replace(NULL, 'b', 'x'), regexp_replace('abc', 'b', NULL), regexp_replace('abc', 'z', 'x'), regexp_replace('abc', 'b', 'x', 1, 0, NULL)\nselect regexp_replace('abc', 'b', 'x', 0)\nselect regexp_replace('abc', 'b', 'x', 1, -1)\nselect regexp_replace('abc', 'b', 'x', 1, 0, 'z')\nselect regexp_replace('abc', '(b', 'x')\nselect id, regexp_substr(s, '\\d+', 1, 2), regexp_instr(s, '\\d+', 1, 2, 1), regexp_count(s, '\\d'), regexp_count(s, '[A-Z]', 1, 'i') from rx order by id\nselect regexp_substr('a1b22c', '\\d+'), regexp_substr('a1b22c', '\\d+', 1, 2), regexp_instr('a1b22c', '\\d+', 1, 2), regexp_count('a1b22c', '\\d+'), regexp_substr('abcd', 'a|ab'), regexp_count('aaa', 'a*'), regexp_count('abc', '')\nselect regexp_substr('abc', '(b)(c)', 1, 1, '', 2), regexp_substr('abc', '(b)', 1, 1, 'i', 2), regexp_instr('abc', 'b', 1, 1, 1), regexp_instr('abc', 'z'), regexp_substr('abc', 'z'), regexp_count('', 'a')\nselect regexp_count('abc', 'b', 0)\nselect regexp_substr('abc', 'b', 1, 0)\nselect regexp_instr('abc', 'b', 1, 1, 2)\nselect regexp_substr('abc', 'b', 1, 1, 'i', -1)\nselect regexp_substr('abc', 'b', 1, 1, 'w')\nselect * from regexp_matches('a1b22c3', '\\d+')\nselect * from regexp_matches('a1b22c3', '(\\d)(\\d)?')\nselect * from regexp_matches('ab', '(a)(x)?(b)')\nselect * from regexp_matches('abc', 'x*')\nselect * from regexp_matches('baaa', 'a*')\nselect * from regexp_matches('ab', 'a|')\nselect * from regexp_matches('abcd', 'a|ab')\nselect * from regexp_matches('AbA', 'a', 'i')\nselect * from regexp_matches('abc', 'z')\nselect * from regexp_matches(NULL, 'a')\nselect * from regexp_matches('a,b', ',', NULL)\nselect * from regexp_matches('a\"b\\c' + char(9) + 'é/', '.+', 's')\nselect * from regexp_matches('é1', '\\d')\nselect match_value, start_position from regexp_matches('x1y2', '\\d') order by match_id desc\nselect * from regexp_matches('abc', 'b', 'q')\nselect * from regexp_matches('abc', '(b')\nselect * from regexp_split_to_table('a,b,,c', ',')\nselect * from regexp_split_to_table('aXbxc', 'x', 'i')\nselect * from regexp_split_to_table('abc', '')\nselect * from regexp_split_to_table('', ',')\nselect * from regexp_split_to_table('abc', 'z')\nselect * from regexp_split_to_table(NULL, ',')\nselect * from regexp_split_to_table('a,b', ',', NULL)\nselect * from regexp_split_to_table('a1b', '\\d', 'z')\nselect * from regexp_split_to_table('abc', '(b')\nselect value from regexp_split_to_table('c;a;b', ';') order by value\nselect r.id, m.match_id, m.match_value from rx r cross apply regexp_matches(r.s, '[a-z]') m order by r.id, m.match_id\nselect r.id, s.ordinal, s.value from rx r cross apply regexp_split_to_table(r.s, '\\d+') s where r.id = 4 order by s.ordinal\nselect r.id, count(m.match_id) from rx r outer apply regexp_matches(r.s, '\\d') m group by r.id order by r.id\nselect m.match_value, s.value from regexp_matches('a1b2', '\\d') m cross apply regexp_split_to_table('x-y', '-') s order by 1, 2\nselect count(*), sum(m.start_position), max(m.match_value) from rbig b cross apply regexp_matches(b.s, '\\d') m\nselect k, count(*) from rbig where regexp_like(s, 'x1$') group by k order by k\nselect count(*) from rbig where regexp_like(k, 'K', 'i')\nselect max(regexp_replace(s, '\\d', '')), count(distinct regexp_substr(s, '\\d+')), sum(regexp_count(s, '\\d')), sum(regexp_instr(s, 'x')) from rbig\nselect k, count(*) from rbig where regexp_like(s, 'v1') and k is not null group by k having count(*) > 40 order by k\nselect id from rx where 1 = 0 and regexp_like(s, 'b')\nselect count(*) from rbig b cross apply regexp_split_to_table(b.s, 'x') s where b.id < 100"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(48), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
