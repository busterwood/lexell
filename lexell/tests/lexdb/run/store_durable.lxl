// lexdb_store: snapshots read as of the last durable commit, so they never
// wait for the log. With the log's flushes held open, a commit is applied
// but not durable: it updates a value, inserts enough keys to split the
// root, deletes every key of a second tree, creates a third and drops the
// second. A snapshot begun meanwhile does not wait and sees the state
// before it, exactly; the transaction that wrote sees its own state. Once
// the flush goes through, a new snapshot sees the new state, and the first
// still sees the old one. Then many rounds of the same with the flush not
// held, snapshots taken between commits: each sees a whole state. A
// transaction block reads its snapshot with its own writes over it
// (forward, backward, point reads); its commit fails (40001) when a key it
// read changed after its snapshot, and not when a key far from its reads did.
// expect: in the window: committed false, snapshot old true, tree 3 absent true, writer waiting true
// expect: after: committed true, new snapshot new true, old snapshot old true, new tree true
// expect: rounds 40 whole 40
// expect: blocks 20 read right 20, commits checked 20 right 20
import "task"
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"

fn key(i: int): str { return "k" + strings.padLeft(i.toStr(), 5, '0') }

// tree's entries in order, "k=v" joined (with the count)
fn dump(st: &lexdb_store.Store, t: mut &lexdb_store.Txn, tree: int): str {
    var out: []str = []
    let r = st.scan(t, tree, "", "", fn(e: &lexdb_store.Entry): bool {
        append(mut &out, e.key + "=" + e.val)
        return true
    })
    if r.isErr() { return "error " + r.unwrapErr().state }
    return len(out).toStr() + ":" + strings.join(&out, ",")
}

type Arg = record { st: lexdb_store.Store; a: int; b: int; done: task.Shared[[]int] }

// The big commit: an update, many inserts (splits, a root split), every
// key of tree b deleted, a new tree, tree b dropped.
fn big(x: Arg): int {
    var t = lexdb_store.begin()
    t.put(x.a, key(0), "changed").unwrap()
    for i in 1000..1600 { t.put(x.a, key(i), strings.repeat("v", 60)).unwrap() }
    for i in 0..30 { t.del(x.b, key(i)) }
    let c = x.st.createTree(mut &t)
    t.put(c, "only", "here").unwrap()
    t.dropTree(x.b)
    let r = x.st.commit(t)
    x.done.with(fn(d: mut &[]int) { append(d, if r.isOk() { c } else { -2 }) })
    return 0
}

// tree's entries in [k01990, k02100), "k=v" joined
fn rangeOf(st: &lexdb_store.Store, t: mut &lexdb_store.Txn, tree: int): str {
    var out: []str = []
    st.scan(t, tree, key(1990), key(2100), fn(e: &lexdb_store.Entry): bool {
        append(mut &out, e.key + "=" + e.val)
        return true
    }).unwrap()
    return strings.join(&out, ",")
}

type Round = record { st: lexdb_store.Store; a: int; round: int }

fn roundCommit(x: Round): int {
    var t = lexdb_store.begin()
    for i in 0..20 { t.put(x.a, key(2000 + x.round * 20 + i), "r" + x.round.toStr()).unwrap() }
    for i in 0..10 { t.del(x.a, key(1000 + x.round * 10 + i)) }
    t.put(x.a, "count", (630 + 10 * (x.round + 1)).toStr()).unwrap()
    x.st.commit(t).unwrap()
    return 0
}

// A snapshot's view of tree a: "count/keys" (count missing: the keys twice)
fn counted(st: &lexdb_store.Store, a: int): str {
    var s = st.beginSnapshot().unwrap()
    var keys = 0
    var cnt = -1
    st.scan(mut &s, a, "", "", fn(e: &lexdb_store.Entry): bool {
        if e.key == "count" { cnt = strings.parseIntOpt(e.val).unwrapOr(-1) } else { keys += 1 }
        return true
    }).unwrap()
    st.endSnapshot(&s)
    return (if cnt < 0 { keys } else { cnt }).toStr() + "/" + keys.toStr()
}

fn main() {
    let fs = lexdb_disk.sim(31)
    var lines: []str = []
    lexdb_store.run(fs, lexdb_store.Options{cacheBytes: 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 1024 * 1024, snapNodes: 100000, bufferedPages: false}, fn(st: lexdb_store.Store): int {
        var t0 = lexdb_store.begin()
        let a = st.createTree(mut &t0)
        let b = st.createTree(mut &t0)
        for i in 0..30 {
            t0.put(a, key(i), "a" + i.toStr()).unwrap()
            t0.put(b, key(i), "b" + i.toStr()).unwrap()
        }
        st.commit(t0).unwrap()
        var tr = lexdb_store.begin()
        let oldA = dump(&st, mut &tr, a)
        let oldB = dump(&st, mut &tr, b)
        let none: []int = []
        let done = task.shared(none)
        var s1 = lexdb_store.begin()
        var mid = ""
        task.scope(fn(sc: mut &task.Scope) {
            fs.holdFlushes("log.")
            sc.spawn(big, Arg{st: st, a: a, b: b, done: done})
            for i in 0..50 { let y = task.yield() }       // the commit applies and waits for its flush
            var n = 0
            done.with(fn(d: mut &[]int) { n = len(d) })
            s1 = st.beginSnapshot().unwrap()
            let sa = dump(&st, mut &s1, a)
            let sb = dump(&st, mut &s1, b)
            let s3 = dump(&st, mut &s1, b + 1)
            mid = "in the window: committed " + (n > 0).toStr() + ", snapshot old " + (sa == oldA && sb == oldB).toStr() +
                  ", tree 3 absent " + (s3 == "0:").toStr()
            var n2 = 0
            done.with(fn(d: mut &[]int) { n2 = len(d) })
            mid = mid + ", writer waiting " + (n2 == 0).toStr()
            fs.holdFlushes("")
        })
        append(mut &lines, mid)
        var c = -1
        done.with(fn(d: mut &[]int) { c = d[0] })
        var s2 = st.beginSnapshot().unwrap()
        let na = dump(&st, mut &s2, a)
        let nb = dump(&st, mut &s2, b)
        let nc = dump(&st, mut &s2, c)
        let newOk = strings.startsWith(na, "630:k00000=changed,") && nb == "0:"
        let oldStill = dump(&st, mut &s1, a) == oldA && dump(&st, mut &s1, b) == oldB
        append(mut &lines, "after: committed " + (c >= 0).toStr() + ", new snapshot new " + newOk.toStr() + ", old snapshot old " +
               oldStill.toStr() + ", new tree " + (nc == "1:only=here").toStr())
        st.endSnapshot(&s1)
        st.endSnapshot(&s2)
        // rounds: one commit inserts 20 keys and deletes 10 in tree a and
        // sets "count" to the number of keys; with its flush held, a snapshot
        // sees the round before, whole; after it, this round, whole
        var whole = 0
        var prev = 630
        for round in 0..40 {
            var mid2 = ""
            task.scope(fn(sc: mut &task.Scope) {
                fs.holdFlushes("log.")
                sc.spawn(roundCommit, Round{st: st, a: a, round: round})
                for i in 0..20 { let y = task.yield() }
                mid2 = counted(&st, a)
                let again = counted(&st, a)     // after the first ended (its old versions pruned)
                if again != mid2 { mid2 = mid2 + " then " + again }
                fs.holdFlushes("")
            })
            let after = counted(&st, a)
            let want = prev + 10
            if mid2 == prev.toStr() + "/" + prev.toStr() && after == want.toStr() + "/" + want.toStr() { whole += 1 } else {
                println("round " + round.toStr() + ": in the window " + mid2 + ", after " + after)
            }
            prev = want
        }
        append(mut &lines, "rounds 40 whole " + whole.toStr())
        // a block: reads its snapshot with its own writes over it
        var bl = 0
        var blOk = 0
        var stale = 0
        var staleOk = 0
        for round in 0..20 {
            var blk = st.beginBlock().unwrap()
            // another commit after the block began, before it reads: to a key
            // in the block's range or far from it
            let near = round % 2 == 0
            let k = if near { 2000 + round } else { 2700 + round }
            var other = lexdb_store.begin()
            other.put(a, key(k), "other" + round.toStr()).unwrap()
            st.commit(other).unwrap()
            let before = rangeOf(&st, mut &blk, a)
            // own writes, then reads: forward, backward, point
            blk.put(a, key(2000 + round * 2 + 1), "mine").unwrap()
            blk.del(a, key(2000 + round * 2 + 3))
            var fwd: []str = []
            st.scan(mut &blk, a, key(1990), key(2100), fn(e: &lexdb_store.Entry): bool {
                append(mut &fwd, e.key + "=" + e.val)
                return true
            }).unwrap()
            var bwd: []str = []
            st.scanBack(mut &blk, a, key(1990), key(2100), fn(e: &lexdb_store.Entry): bool {
                append(mut &bwd, e.key + "=" + e.val)
                return true
            }).unwrap()
            var rev: []str = []
            var i = len(bwd) - 1
            while i >= 0 {
                append(mut &rev, bwd[i])
                i -= 1
            }
            let mine = st.get(mut &blk, a, key(2000 + round * 2 + 1)).unwrap()
            let gone = st.get(mut &blk, a, key(2000 + round * 2 + 3)).unwrap()
            let seen = if near { st.get(mut &blk, a, key(k)).unwrap() } else { None }      // far: not read
            var ok = strings.join(&fwd, ",") == strings.join(&rev, ",")
            ok = ok && mine == Some("mine") && gone.isNone() && seen != Some("other" + round.toStr())
            ok = ok && rangeOf(&st, mut &blk, a) != before       // its own writes show
            for e in fwd { if strings.startsWith(e, key(k) + "=") && strings.endsWith(e, "other" + round.toStr()) { ok = false } }
            bl += 1
            if ok { blOk += 1 }
            // the block read the key the other commit changed (near: in the
            // leaves it read): its commit fails; far: it commits
            let r = st.commit(blk)
            if near {
                stale += 1
                if r.isErr() && r.unwrapErr().state == "40001" { staleOk += 1 }
            } else if r.isOk() { staleOk += 1; stale += 1 } else { stale += 1 }
        }
        append(mut &lines, "blocks " + bl.toStr() + " read right " + blOk.toStr() + ", commits checked " + stale.toStr() +
               " right " + staleOk.toStr())
        return 0
    }).unwrap()
    for l in lines { println(l) }
}
