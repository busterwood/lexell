// lexdb over TDS: T-SQL batches' control of flow, checked against SQL Server 2022
// (generated by tests/lexdb/gen_mssql.py from mssql_batch_queries.txt): IF, WHILE,
// BREAK, CONTINUE, BEGIN ... END, PRINT, TRY ... CATCH and the ERROR_ functions,
// RAISERROR, THROW, XACT_STATE, #temp tables, table variables, RETURN, OBJECT_ID,
// EF Core's migration batches. Each expect line: a batch's result sets and counts,
// or its error number.
// expect: ok
// expect: (1) / (1) / (1) / (1) / (1) / (1) / (1) / : 3
// expect: : 'yes'
// expect: : 'b' / : 'c'
// expect: ok
// expect: (1) / (1) / (1) / (1) / (1) / (1) / (1) / (1) / id: 101;103
// expect: : 'printed'
// expect: (0) / ,,: 2627|14|1
// expect: (0) / ,: 8134|'Divide by zero error encountered.'
// expect: ,,,: 50000|'custom 42 and x'|16|1
// expect: ,,,: 50001|'thrown'|3|16
// expect: ,: 50003|'inner'
// expect: error 50002
// expect: : 'after'
// expect: : 'tried'
// expect: : NULL
// expect: (0) / ,: 0|0
// expect: (1) / (0) / : -1 / : 0
// expect: (2) / k,s: 1|'a';2|'b'
// expect: : 2
// expect: ok
// expect: error 208
// expect: (2) / id: 0;1
// expect: : 'exists' / : 'missing'
// expect: ok
// expect: (1)
// expect: ok
// expect: MigrationId,ProductVersion: '20240101_Init'|'8.0.0'
// expect: (2) / a,b: 1|'x';2|'y' / : 1
// expect: : 'before'
// expect: (1) / : 103
// expect: (1) / (3) / : 'x0,x1,x2,'
// expect: (1) / : 0 / (1) / : 1 / (1)
// expect: (1) / (1) / (1) / : 14
// expect: : 'many'
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "CREATE TABLE t (id int PRIMARY KEY, v nvarchar(20))\nDECLARE @i int = 0; WHILE @i < 3 BEGIN INSERT INTO t VALUES (@i, N'x' + CAST(@i AS nvarchar(10))); SET @i = @i + 1 END; SELECT COUNT(*) FROM t\nIF EXISTS (SELECT 1 FROM t WHERE id = 1) SELECT 'yes' ELSE SELECT 'no'\nIF 1 = 0 BEGIN SELECT 'a' END ELSE BEGIN SELECT 'b'; SELECT 'c' END\nIF 1 = 0 SELECT 'never'\nDECLARE @n int = 0; WHILE 1 = 1 BEGIN SET @n = @n + 1; IF @n >= 5 BREAK; IF @n % 2 = 0 CONTINUE; INSERT INTO t VALUES (100 + @n, N'odd') END; SELECT id FROM t WHERE id > 100 ORDER BY id\nPRINT 'hello'; SELECT 'printed'\nBEGIN TRY INSERT INTO t VALUES (1, N'dup') END TRY BEGIN CATCH SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE() END CATCH\nBEGIN TRY DECLARE @z int; SET @z = 1/0 END TRY BEGIN CATCH SELECT ERROR_NUMBER(), ERROR_MESSAGE() END CATCH\nBEGIN TRY RAISERROR('custom %d and %s', 16, 1, 42, 'x') END TRY BEGIN CATCH SELECT ERROR_NUMBER(), ERROR_MESSAGE(), ERROR_SEVERITY(), ERROR_STATE() END CATCH\nBEGIN TRY THROW 50001, 'thrown', 3 END TRY BEGIN CATCH SELECT ERROR_NUMBER(), ERROR_MESSAGE(), ERROR_STATE(), ERROR_SEVERITY() END CATCH\nBEGIN TRY BEGIN TRY THROW 50003, 'inner', 1 END TRY BEGIN CATCH THROW END CATCH END TRY BEGIN CATCH SELECT ERROR_NUMBER(), ERROR_MESSAGE() END CATCH\nTHROW 50002, 'out', 1\nRAISERROR('note', 10, 1); SELECT 'after'\nBEGIN TRY SELECT 'tried' END TRY BEGIN CATCH SELECT 'caught' END CATCH\nSELECT ERROR_NUMBER()\nBEGIN TRAN; BEGIN TRY INSERT INTO t VALUES (1, N'dup'); COMMIT END TRY BEGIN CATCH IF @@TRANCOUNT > 0 ROLLBACK; SELECT XACT_STATE(), @@TRANCOUNT END CATCH\nSET XACT_ABORT ON; BEGIN TRY BEGIN TRAN; INSERT INTO t VALUES (200, N'a'); INSERT INTO t VALUES (1, N'dup'); COMMIT END TRY BEGIN CATCH SELECT XACT_STATE(); ROLLBACK END CATCH; SET XACT_ABORT OFF; SELECT COUNT(*) FROM t WHERE id = 200\nCREATE TABLE #tmp (k int, s nvarchar(10)); INSERT INTO #tmp VALUES (1, N'a'), (2, N'b'); SELECT * FROM #tmp ORDER BY k\nSELECT COUNT(*) FROM #tmp\nDROP TABLE #tmp\nSELECT COUNT(*) FROM #tmp\nSELECT id INTO #ids FROM t WHERE id < 2; SELECT * FROM #ids ORDER BY id\nIF OBJECT_ID(N't') IS NOT NULL SELECT 'exists'; IF OBJECT_ID(N'nope') IS NULL SELECT 'missing'\nIF OBJECT_ID(N'[__EFMigrationsHistory]') IS NULL BEGIN CREATE TABLE [__EFMigrationsHistory] ([MigrationId] nvarchar(150) NOT NULL, [ProductVersion] nvarchar(32) NOT NULL, CONSTRAINT [PK___EFMigrationsHistory] PRIMARY KEY ([MigrationId])); END;\nIF NOT EXISTS (SELECT * FROM [__EFMigrationsHistory] WHERE [MigrationId] = N'20240101_Init') BEGIN INSERT INTO [__EFMigrationsHistory] ([MigrationId], [ProductVersion]) VALUES (N'20240101_Init', N'8.0.0'); END;\nIF NOT EXISTS (SELECT * FROM [__EFMigrationsHistory] WHERE [MigrationId] = N'20240101_Init') BEGIN INSERT INTO [__EFMigrationsHistory] ([MigrationId], [ProductVersion]) VALUES (N'20240101_Init', N'8.0.0'); END;\nSELECT [MigrationId], [ProductVersion] FROM [__EFMigrationsHistory]\nDECLARE @tv TABLE (a int PRIMARY KEY, b nvarchar(5)); INSERT INTO @tv VALUES (2, N'y'), (1, N'x'); SELECT * FROM @tv ORDER BY a; SELECT COUNT(*) FROM @tv WHERE b = N'Y'\nSELECT 'before'; RETURN; SELECT 'not reached'\nDECLARE @x int; SELECT @x = MAX(id) FROM t; IF @x IS NULL PRINT 'none' ELSE SELECT @x\nDECLARE @s nvarchar(100) = N''; SELECT @s = @s + v + N',' FROM t WHERE id < 3 ORDER BY id; SELECT @s\nDECLARE @k int = 0; WHILE @k < 2 BEGIN SELECT @k; SET @k += 1 END\nDECLARE @c int = 10; SET @c -= 3; SET @c *= 2; SELECT @c\nIF (SELECT COUNT(*) FROM t) > 3 AND 1 = 1 SELECT 'many' ELSE SELECT 'few'"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(33), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000, bufferedPages: false}, body).unwrap()
        }
    }
}
