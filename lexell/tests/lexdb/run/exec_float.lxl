// lexdb_exec: real and double precision, checked against PostgreSQL 18
// (generated by tests/lexdb/gen_pg.py from float_queries.txt): their text
// both ways, arithmetic and its types, overflow, casts to and from integers
// and numeric, comparison with NaN, the math functions, float columns and
// keys, their order and aggregates.
// Each expect line: a query's rows or tag, or ERROR and its SQLSTATE.
// expect: 1e+20|1e+15|100000000000000|123456789012345.6|0.0001|1e-05|1.5e-07|-0
// expect: NaN|Infinity|-Infinity|1.5|2|NaN|-Infinity
// expect: 0.1|1e+06|1e+07|123456.7|1.2345678e+06|0.0001|1e-05|3.4e+38|1.6777216e+07
// expect: 0.30000000000000004|0.3333333333333333|0.6666666666666666|0.3|0.33333334
// expect: double precision|real|double precision|double precision|double precision|double precision
// expect: 3.75|0.20000000149011612|-2.5|-2.5
// expect: ERROR 22003
// expect: ERROR 22003
// expect: ERROR 22P02
// expect: ERROR 22003
// expect: ERROR 22003
// expect: ERROR 22003
// expect: ERROR 22012
// expect: ERROR 42883
// expect: 2|2|-2|4|2|2
// expect: ERROR 22003
// expect: ERROR 22003
// expect: 10000000000|0.1|1.23457|123456789012346|0.00000015
// expect: 0.1|1.2345678901234567e+19|7|2.5|1e+20
// expect: t|t|t|f|t|t|t
// expect: 1.5|1.5|real|2|4|-2|double precision
// expect: -2|-1|2|-1|2|3|-2|numeric|double precision
// expect: 1.4142135623730951|4|2.718281828459045|2.302585092994046|3|1024|1.4142135623730951|double precision
// expect: -1|0|double precision
// expect: ERROR 2201F
// expect: ERROR 2201E
// expect: ERROR 2201F
// expect: ERROR 2201F
// expect: t|double precision
// expect: CREATE TABLE
// expect: INSERT 0 5
// expect: 1|1.5|0.1|2;2|-2.25|1e+07|;3|NaN|-0|1e+300;4|-Infinity|3.4e+38|0.5;5|0|1.6777216e+07|1.5
// expect: 4;2;5;1;3
// expect: 4;5;2;1;3
// expect: 1|1.5;3|NaN
// expect: 3
// expect: ERROR 22003
// expect: 4|1.3333333333333333|0.5833333333333334|0.7637626158259734|0.3888888888888889
// expect: 4|-Infinity|1.5
// expect: 5000000.050000001
// expect: CREATE TABLE
// expect: INSERT 0 5
// expect: -Infinity|lo;0|zero;1.5|a;1e+300|big;NaN|n
// expect: ERROR 23505
// expect: n
// expect: a;big;n
// expect: 3|0.2|real;UPDATE 1
// expect: 3!|0.1|2
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "select 1e20::float8, 1e15::float8, 1e14::float8, 123456789012345.6::float8, 0.0001::float8, 0.00001::float8, 1.5e-7::float8, -0.0::float8\nselect 'nan'::float8, 'Infinity'::float8, '-inf'::float8, ' 1.5 '::float8, '+2'::double precision, 'NaN'::real, '-Infinity'::real\nselect 0.1::real, 1e6::real, 1e7::real, 123456.7::real, 1234567.8::real, 0.0001::real, 0.00001::real, 3.4e38::real, 16777217::real\nselect 0.1::float8 + 0.2::float8, 1::float8 / 3, 2.0::float8 / 3, 0.1::real + 0.2::real, 1::real / 3::real\nselect pg_typeof(1 + 1.5::real), pg_typeof(1.5::real + 1.5::real), pg_typeof(1.5::real + 1.5::float8), pg_typeof(2 * 1.5::float8), pg_typeof(1.5::numeric + 1.5::float8), pg_typeof(1.5::real * 2.5)\nselect 1.5::real * 2.5, 0.1::real + 0.1::float8, -(2.5::float8), -(2.5::real)\nselect '1e400'::float8\nselect '1e-400'::float8\nselect 'abc'::float8\nselect '3.5e38'::real\nselect 1e308::float8 * 10\nselect 1e-300::float8 * 1e-300::float8\nselect 1::float8 / 0\nselect 5::float8 % 2::float8\nselect 1.5::float8::int, 2.5::float8::int, -2.5::float8::int, 3.5::real::int, 2.5::float8::bigint, 2.5::float8::smallint\nselect 1e10::float8::int\nselect 'nan'::float8::int\nselect 1e10::float8::numeric, 0.1::float8::numeric, 1.23456789012::real::numeric, 123456789012345.6::float8::numeric, 1.5e-7::float8::numeric\nselect 0.1::numeric::float8, 12345678901234567890::numeric::float8, 7::float8, 2.5::float8::text, 1e20::real::text\nselect 'nan'::float8 > 'inf'::float8, 'nan'::float8 = 'nan'::float8, -0.0::float8 = 0.0::float8, 0.1::real = 0.1::float8, 1.5::real = 1.5::float8, 2::float8 > 1, 1.5::float8 < 1.6\nselect abs(-1.5::float8), abs(-1.5::real), pg_typeof(abs(-1.5::real)), round(2.5::float8), round(3.5::float8), round(-2.5::float8), pg_typeof(round(2.5::float8))\nselect floor(-1.5::float8), ceil(-1.5::float8), ceiling(1.2::float8), trunc(-1.7::float8), floor(2.7), ceil(2.1), trunc(-2.7), pg_typeof(floor(2.7)), pg_typeof(floor(1.5::real))\nselect sqrt(2::float8), sqrt(16), exp(1::float8), ln(10::float8), log10(1000::float8), power(2::float8, 10), power(2, 0.5::float8), pg_typeof(power(2, 10))\nselect sign(-2.5::float8), sign(0::float8), pg_typeof(sign(2::float8))\nselect sqrt(-1::float8)\nselect ln(0::float8)\nselect power(0::float8, -1)\nselect power(-8::float8, 0.5::float8)\nselect random() >= 0 and random() < 1, pg_typeof(random())\ncreate table m (id int primary key, x float8, y real, z double precision)\ninsert into m values (1, 1.5, 0.1, 2), (2, -2.25, 1e7, null), (3, 'NaN', '-0', 1e300), (4, '-Infinity', 3.4e38, 0.5), (5, 0, 16777217, 1.5)\nselect * from m order by id\nselect id from m order by x, id\nselect id from m order by y desc, id\nselect id, x from m where x > 0 order by id\nselect id from m where x = 'nan' order by id\nselect sum(x), sum(y), sum(z), avg(z), pg_typeof(sum(y)), pg_typeof(avg(y)), pg_typeof(avg(z)), min(x), max(x), min(y), max(y) from m\nselect sum(z), avg(z), variance(z), stddev(z), var_pop(z) from m where id in (1, 4, 5)\nselect count(*), min(x), max(x) from m where id <> 3\nselect avg(y) from m where id in (1, 2)\ncreate table fk (k float8 primary key, v text)\ninsert into fk values (1.5, 'a'), (-0.0, 'zero'), ('nan', 'n'), ('-inf', 'lo'), (1e300, 'big')\nselect k, v from fk order by k\ninsert into fk values (0, 'dup')\nselect v from fk where k = 'NaN'\nselect v from fk where k > 1 order by k\nupdate m set x = x * 2 where id = 1 returning x, y * 2::real, pg_typeof(y * 2::real)\nselect x::text || '!', y::numeric, z::int from m where id = 1"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(r.tag, "SELECT") { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(79), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
