// expect: same: ID,V = 1|7;2|14;3|21;4|28;5|35;9|NULL;10|10;11|17;12|24;13|NULL;14|38;15|45;16|52;18|NULL;19|13;20|20;21|27;22|34;23|41;26|NULL;27|NULL;28|16;29|23;30|30;31|37;32|44;33|51;35|5;36|NULL;37|19;38|26;39|NULL;40|40;43|1;44|8;45|NULL;46|22;47|29;48|36;50|NULL;51|7;52|NULL;53|21;54|28;55|35;59|NULL;60|10;61|17;62|24;63|31;64|38;65|NULL;68|NULL;69|13;70|20;71|27;72|34;76|2;77|NULL;78|NULL;79|23;80|30;81|37;82|44;85|5;86|NULL;87|19;88|26;89|33;90|40;91|NULL;93|1;94|8;95|NULL;96|22;97|29;98|36;99|43;100|NULL;101|7;102|14;103|21;104|NULL;105|35;106|42;107|49;109|NULL;110|10;111|17;112|24;113|31;114|38;117|NULL;118|NULL;119|13;120|20;121|27;122|34;123|41;124|48;126|2;127|NULL;128|16;129|23;130|NULL;131|37;135|5;136|NULL;137|19;138|26;139|33;143|NULL;144|8;145|NULL;146|22;147|29;148|36;149|43;150|NULL;151|7;152|14;153|21;154|28;155|35;156|NULL;159|NULL;160|10;161|17;162|24;163|31;164|38;165|45;166|52;168|NULL;169|NULL;170|20;171|27;172|34;173|41;176|2;177|NULL;178|16;179|23;180|30;181|37;182|NULL;185|5;186|NULL;187|19;188|26;189|33;190|40;191|47;193|1;194|8;195|NULL;196|22;197|29;198|36
