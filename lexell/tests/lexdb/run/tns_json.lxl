// lexdb over TNS: Oracle JSON & SQL/JSON support (Oracle 21c / 23ai / 26ai).
// Covers JSON column type (USER_TAB_COLUMNS), JSON() constructor, IS [NOT] JSON (OBJECT/ARRAY/SCALAR/WITH UNIQUE KEYS),
// JSON_VALUE (RETURNING, DEFAULT ... ON EMPTY, ERROR ON ERROR, PASSING), JSON_QUERY (WITH WRAPPER, WITH CONDITIONAL WRAPPER,
// OMIT QUOTES), JSON_EXISTS, JSON_OBJECT (KEY ... VALUE ..., ABSENT ON NULL, WITH UNIQUE KEYS), JSON_ARRAY (list + subquery),
// JSON_ARRAYAGG, JSON_OBJECTAGG, JSON_SERIALIZE (PRETTY), JSON_MERGEPATCH (RFC 7396), JSON_EQUAL,
// JSON_TRANSFORM (SET, INSERT, REPLACE, REMOVE, APPEND, KEEP), JSON_TABLE (FOR ORDINALITY, FORMAT JSON, EXISTS PATH,
// NESTED PATH, implicit lateral join), and batches off & on.
// expect: setup: 4 statements
// expect: same: COLUMN_NAME,DATA_TYPE = 'ID'|'NUMBER';'GRP'|'VARCHAR2';'DOC'|'JSON'
// expect: same: S = '{"a":1,"b":2}'
// expect: same: O,A,U,N = 1|1|0|1
// expect: same: ID,NM,SC,MS = 1|'Ann'|90|-1;2|'Bob'|75|-1;3|'Cid'|85|-1
// expect: same: JSON_VALUE(DOC,'$.SCORE'RETURNINGNUMBER) = 90;85
// expect: same: W,CW,OQ = '[["x","y"]]'|'["x","y"]'|'Ann'
// expect: same: O = '{"id":1,"name":"Ann"}'
// expect: same: A1,A2,A3 = '[1,"hi",{"k":true}]'|'[1,null,2]'|'[1,2,3]'
// expect: same: GRP,ARR,OBJ = 'a'|'["Ann","Bob"]'|'{"Ann":90,"Bob":75}';'b'|'["Cid"]'|'{"Cid":85}'
// expect: same: MP = '{"a":1,"c":99,"d":4}'
// expect: same: EQ1,EQ2 = 1|0
// expect: same: T1,T2,T3 = '{"a":10,"b":20,"arr":[1,2,3],"c":3}'|'{"a":1}'|'{"b":2}'
// expect: same: ID,ORD,NM,VIP,TAG = 1|1|'Ann'|1|'x';1|1|'Ann'|1|'y';2|1|'Bob'|1|'z';3|1|'Cid'|0|NULL
// expect: same: error 1722
// expect: same: error 20000
// expect: same: BADNUM,EA,EO = -1|'[]'|'{}'
// expect: same: NESTED_T = '{"a":{"b":99}}'
// expect: same: NM,TAGS_J = 'Ann'|'["x","y"]'
// expect: same: error 1722
// expect: same: JSUB = '[1,null,3]'
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table jdocs (id number primary key, grp varchar2(10), doc json)\ninsert into jdocs values (1, 'a', '{\"name\":\"Ann\",\"score\":90,\"tags\":[\"x\",\"y\"],\"meta\":{\"vip\":true}}')\ninsert into jdocs values (2, 'a', '{\"name\":\"Bob\",\"score\":75,\"tags\":[\"z\"],\"meta\":{\"vip\":false}}')\ninsert into jdocs values (3, 'b', '{\"name\":\"Cid\",\"score\":85,\"tags\":[]}')"

const QS = "select column_name, data_type from user_tab_columns where table_name = 'JDOCS' order by column_id\nselect json_serialize(json('{\"a\": 1, \"b\": 2}')) s from dual\nselect case when '{\"a\":1}' is json object then 1 else 0 end o, case when '[1,2]' is json array then 1 else 0 end a, case when '{\"a\":1,\"a\":2}' is json with unique keys then 1 else 0 end u, case when 'bad' is not json then 1 else 0 end n from dual\nselect id, json_value(doc, '$.name') nm, json_value(doc, '$.score' returning number) sc, json_value(doc, '$.missing' returning number default -1 on empty) ms from jdocs order by id\nselect json_value(doc, '$.score' returning number) from jdocs where json_exists(doc, '$.score ? (@ > $min)' passing 80 as min) order by id\nselect json_query(doc, '$.tags' with wrapper) w, json_query(doc, '$.tags[*]' with conditional wrapper) cw, json_query(doc, '$.name' omit quotes) oq from jdocs where id = 1\nselect json_object(key 'id' value id, key 'name' value json_value(doc, '$.name'), key 'opt' value null absent on null) o from jdocs where id = 1\nselect json_array(1, 'hi', null, json_object('k' value true)) a1, json_array(1, null, 2 null on null) a2, json_array(select id from jdocs order by id) a3 from dual\nselect grp, json_arrayagg(json_value(doc, '$.name') order by id) arr, json_objectagg(key json_value(doc, '$.name') value json_value(doc, '$.score' returning number)) obj from jdocs group by grp order by grp\nselect json_mergepatch('{\"a\":1,\"b\":2,\"c\":3}', '{\"b\":null,\"c\":99,\"d\":4}') mp from dual\nselect case when json_equal('{\"a\":1,\"b\":2}', '{\"b\": 2, \"a\": 1}') then 1 else 0 end eq1, case when json_equal('{\"a\":1}', '{\"a\":2}') then 1 else 0 end eq2 from dual\nselect json_transform('{\"a\":1,\"b\":2,\"arr\":[1,2]}', set '$.a' = 10, insert '$.c' = 3, replace '$.b' = 20, append '$.arr' = 3, remove '$.missing') t1, json_transform('{\"a\":1,\"b\":2}', remove '$.b') t2, json_transform('{\"a\":1,\"b\":2,\"c\":3}', keep '$.b') t3 from dual\nselect d.id, jt.ord, jt.nm, jt.vip, jt.tag from jdocs d, json_table(d.doc, '$' columns (ord for ordinality, nm varchar2(20) path '$.name', vip number exists path '$.meta.vip', nested path '$.tags[*]' columns (tag varchar2(10) path '$'))) jt order by d.id, jt.tag\nselect json_value('{bad}', '$.a' error on error) from dual\nselect json_object('a' value 1, 'a' value 2 with unique keys) from dual\nselect json_value('{\"x\":\"abc\"}', '$.x' returning number default -1 on error) badnum, json_query('{\"a\":1}', '$.missing' empty array on empty) ea, json_query('{\"a\":1}', '$.missing' empty object on empty) eo from dual\nselect json_transform('{\"a\":{\"b\":1,\"c\":2}}', set '$.a.b' = 99, insert '$.a.b' = 0, replace '$.a.missing' = 5, remove '$.a.c') nested_t from dual\nselect jt.nm, jt.tags_j from json_table('{\"name\":\"Ann\",\"tags\":[\"x\",\"y\"]}', '$' columns (nm varchar2(10) path '$.name', tags_j varchar2(50) format json path '$.tags')) jt\nselect jt.nm from json_table('{bad}', '$' columns (nm varchar2(10) path '$.name') error on error) jt\nselect json_array(select case when id = 2 then null else id end from jdocs order by id null on null returning json) jsub from dual"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let _a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = qtext(mut &c, &q)
                let _b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = qtext(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(181), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
