// lexdb_exec: LIKE, ILIKE, IN, BETWEEN, CASE, IS DISTINCT FROM and the
// string functions; the planner's IN lists and LIKE prefixes. Expected
// output checked by hand when written.
// expect: create table t (id int primary key, g text, v int, n numeric(6,2), code varchar(3)) -> CREATE TABLE
// expect: insert into t values (1,'apple',1,1.50,'ab'),(2,'apricot',3,null,'xy'),(3,'banana',null,2.25,'a_c'),(4,'Avocado',5,1,'a%'),(5,null,7,0.5,null),(6,'app',9,3,'abc') -> INSERT 0 6
// expect: create index t_g on t (g) -> CREATE INDEX
// expect: select id from t where g like 'ap%' order by id -> 1; 2; 6
// expect: explain select id from t where g like 'ap%' -> scan t: index t_g range
// expect: select id from t where g like '%an%' -> 3
// expect: select id from t where g like 'a_p%' -> 6; 1
// expect: select id from t where g not like 'a%' order by id -> 3; 4
// expect: select id from t where g ilike 'a%' order by id -> 1; 2; 4; 6
// expect: select id from t where code like 'a\_c' -> 3
// expect: select id from t where code like 'a!%' escape '!' -> 4
// expect: select id from t where code like 'a\' -> 22025 LIKE pattern must not end with escape character
// expect: select id from t where id in (5, 1, 3, 99) order by id -> 1; 3; 5
// expect: explain select id from t where id in (5, 1, 3, 99) -> scan t: primary key lookup for each of 4 values
// expect: select id from t where id in (5, 1, 3) order by id desc limit 2 -> 5; 3
// expect: explain select id from t where id in (5, 1, 3) order by id desc limit 2 -> scan t: primary key lookup for each of 3 values backward; order: the scan's; limit: stops the scan
// expect: select id from t where g in ('app', 'banana') order by id -> 3; 6
// expect: explain select id from t where g in ('app', 'banana') -> scan t: index t_g lookup for each of 2 values
// expect: select id from t where v not in (1, 3) order by id -> 4; 5; 6
// expect: select id from t where v not in (1, null) order by id -> SELECT 0
// expect: select id from t where v in (1, null) order by id -> 1
// expect: select id from t where id between 2 and 4 order by id -> 2; 3; 4
// expect: explain select id from t where id between 2 and 4 -> scan t: primary key range
// expect: select id from t where id not between 2 and 4 order by id -> 1; 5; 6
// expect: select id, case when v > 4 then 'big' when v > 2 then 'mid' else 'small' end from t order by id -> 1|small; 2|mid; 3|small; 4|big; 5|big; 6|big
// expect: select id, case v when 1 then 'one' when 3 then 'three' end from t order by id -> 1|one; 2|three; 3|NULL; 4|NULL; 5|NULL; 6|NULL
// expect: select case when id > 0 then 'ok' else 1 / 0 end from t where id = 1 -> ok
// expect: select id from t where v is distinct from 3 order by id -> 1; 3; 4; 5; 6
// expect: select id from t where v is not distinct from null -> 3
// expect: select nullif(v, 3), greatest(v, 4, id), least(v, id), coalesce(v, -1) from t where id in (2, 3) -> NULL|4|2|3; NULL|4|3|-1
// expect: select substr(g, 2, 3), substring(g, 3), left(g, 2), right(g, -2), strpos(g, 'an'), upper(g), replace(g, 'p', 'P'), concat(g, '-', v, null) from t where id = 3 or id = 2 order by id -> pri|ricot|ap|ricot|0|APRICOT|aPricot|apricot-3; ana|nana|ba|nana|2|BANANA|banana|banana-
// expect: select trim('  x  '), ltrim('  x'), rtrim('x  '), length(trim(' é ')) -> x|x|x|1
// expect: select id from t where code = 'toolong' -> SELECT 0
// expect: select max(id) from t where id in (1, 4, 2) -> 4
// expect: select id from t where g in ('app', 'banana', 'apple') order by id desc limit 2 -> 6; 3
// expect: explain select id from t where g in ('app', 'banana', 'apple') order by id desc limit 2 -> scan t: index t_g lookup for each of 3 values; order: sort
// expect: select min(g), max(g) from t where g in ('banana', 'apple', 'zzz') -> apple|banana
// expect: select count(*) from t where g like 'a%' and v between 1 and 5 -> 2
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"
fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            println(sql + " -> " + (if len(lines) == 0 { r.tag } else { strings.join(&lines, "; ") }))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}
fn main() {
    lexdb_store.run(lexdb_disk.sim(1), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st)
        show(mut &s, "create table t (id int primary key, g text, v int, n numeric(6,2), code varchar(3))")
        show(mut &s, "insert into t values (1,'apple',1,1.50,'ab'),(2,'apricot',3,null,'xy'),(3,'banana',null,2.25,'a_c'),(4,'Avocado',5,1,'a%'),(5,null,7,0.5,null),(6,'app',9,3,'abc')")
        show(mut &s, "create index t_g on t (g)")
        show(mut &s, "select id from t where g like 'ap%' order by id")
        show(mut &s, "explain select id from t where g like 'ap%'")
        show(mut &s, "select id from t where g like '%an%'")
        show(mut &s, "select id from t where g like 'a_p%'")
        show(mut &s, "select id from t where g not like 'a%' order by id")
        show(mut &s, "select id from t where g ilike 'a%' order by id")
        show(mut &s, "select id from t where code like 'a\\_c'")
        show(mut &s, "select id from t where code like 'a!%' escape '!'")
        show(mut &s, "select id from t where code like 'a\\'")
        show(mut &s, "select id from t where id in (5, 1, 3, 99) order by id")
        show(mut &s, "explain select id from t where id in (5, 1, 3, 99)")
        show(mut &s, "select id from t where id in (5, 1, 3) order by id desc limit 2")
        show(mut &s, "explain select id from t where id in (5, 1, 3) order by id desc limit 2")
        show(mut &s, "select id from t where g in ('app', 'banana') order by id")
        show(mut &s, "explain select id from t where g in ('app', 'banana')")
        show(mut &s, "select id from t where v not in (1, 3) order by id")
        show(mut &s, "select id from t where v not in (1, null) order by id")
        show(mut &s, "select id from t where v in (1, null) order by id")
        show(mut &s, "select id from t where id between 2 and 4 order by id")
        show(mut &s, "explain select id from t where id between 2 and 4")
        show(mut &s, "select id from t where id not between 2 and 4 order by id")
        show(mut &s, "select id, case when v > 4 then 'big' when v > 2 then 'mid' else 'small' end from t order by id")
        show(mut &s, "select id, case v when 1 then 'one' when 3 then 'three' end from t order by id")
        show(mut &s, "select case when id > 0 then 'ok' else 1 / 0 end from t where id = 1")
        show(mut &s, "select id from t where v is distinct from 3 order by id")
        show(mut &s, "select id from t where v is not distinct from null")
        show(mut &s, "select nullif(v, 3), greatest(v, 4, id), least(v, id), coalesce(v, -1) from t where id in (2, 3)")
        show(mut &s, "select substr(g, 2, 3), substring(g, 3), left(g, 2), right(g, -2), strpos(g, 'an'), upper(g), replace(g, 'p', 'P'), concat(g, '-', v, null) from t where id = 3 or id = 2 order by id")
        show(mut &s, "select trim('  x  '), ltrim('  x'), rtrim('x  '), length(trim(' é '))")
        show(mut &s, "select id from t where code = 'toolong'")
        show(mut &s, "select max(id) from t where id in (1, 4, 2)")
        show(mut &s, "select id from t where g in ('app', 'banana', 'apple') order by id desc limit 2")
        show(mut &s, "explain select id from t where g in ('app', 'banana', 'apple') order by id desc limit 2")
        show(mut &s, "select min(g), max(g) from t where g in ('banana', 'apple', 'zzz')")
        show(mut &s, "select count(*) from t where g like 'a%' and v between 1 and 5")
        return 0
    }).unwrap()
}
