// lexdb_exec: the fourth bug slice in the PostgreSQL door (design/lexdb-robust.md, "The fourth bug slice"): a numeric foreign key to a bigint
// (identity) key refused as PostgreSQL refuses it (42804; the Oracle door takes it, tns_bugs4), an integer one taken. Checked against PostgreSQL 18
// (generated by tests/lexdb/gen_pg.py from bugs4_queries.txt). Each answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE;
// each statement runs with lexdb_batch off and on (an "@once" one once, an "@tx" one in a transaction rolled back).
// expect: CREATE TABLE
// expect: INSERT 0 3
// expect: same: ERROR 42804
// expect: same: ERROR 42804
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: same: DELETE 1
// expect: same: id|pid: 1|2;2|3
// expect: same: ERROR 23503
// expect: same: n: 2
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table b4p (id bigint generated always as identity primary key, v text)\n@once insert into b4p (v) values ('a'), ('b'), ('c')\ncreate table b4n (id int primary key, pid numeric references b4p (id))\ncreate table b4n (id int primary key, pid numeric(10) references b4p (id))\n@once create table b4i (id int primary key, pid int references b4p (id) on delete cascade)\n@once insert into b4i values (1, 2), (2, 3)\n@tx delete from b4p where id = 2\nselect id, pid from b4i order by id\ninsert into b4i values (9, 7)\nselect count(*) as n from b4i"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(174), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
