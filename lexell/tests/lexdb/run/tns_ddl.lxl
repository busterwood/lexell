// lexdb over TNS: the DDL forms of design/lexdb-dialect-gaps.md package B (generated by tests/lexdb/gen_oracle.py from
// oracle_ddl_queries.txt): CREATE OR REPLACE VIEW (any new definition), RENAME and ALTER TABLE ... RENAME [COLUMN]
// (views over them invalidated), ALTER TABLE ... MODIFY (column type) (rows cast, indexes and constraints kept).
// Its answers are as Oracle's documentation gives them (no Oracle was at hand: each line gives its answer as a fourth field).
// Each answer is a label, then the row count, or the columns' names and rows, or error and the ORA- number.
// expect: table: 0
// expect: insert: 1
// expect: insert 2: 1
// expect: view: 0
// expect: replace wider: 0
// expect: select wider: ID,V,W = 1|10|'a';2|20|'b'
// expect: replace new: 0
// expect: select new: ID = 1;2
// expect: replace narrower: 0
// expect: select narrower: W = 'a';'b'
// expect: view text: VIEW_NAME,TEXT = 'VV'|'select w from tv'
// expect: replace columns: 0
// expect: select columns: A,B = 1|10;2|20
// expect: replace other columns: 0
// expect: select other columns: X,Y,Z = 1|10|'a';2|20|'b'
// expect: replace over table: error 955
// expect: create over view: error 955
// expect: noforce: 0
// expect: bad column: error 904
// expect: bad table: error 942
// expect: create or alter: error 922
// expect: create or alter table: error 922
// expect: replace table: error 922
// expect: view over view: 0
// expect: replace under: 0
// expect: select over: W = 1;2
// expect: replace is DDL: committed: 0 / W = 'z' / W = 'z' / N = 1
// expect: after rollback: W = 'z'
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn q(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + qtext(c, sql)) }
fn x(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + xtext(c, sql)) }

// Statements and queries ("a ;; b ;; c") in one transaction, rolled back (t) or committed (u): each answer, joined by " / ".
fn tx(c: mut &oracle.Conn, label: &str, sqls: &str, commit: bool) {
    var out: []str = []
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for part in strings.split(sqls, " ;; ") {
            if strings.startsWith(&strings.toLowerAscii(part), "select") { append(mut &out, qtext(c2, part)) } else { append(mut &out, xtext(c2, part)) }
        }
        if !commit { return Err(sqldialect.inputError("rolled back")) }
        return Ok(0)
    })
    println(label + ": " + strings.join(&out, " / "))
}
fn t(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, false) }
fn u(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, true) }

fn connect(s: &str): oracle.Conn {
    match oracle.connect(&(s.toStr())) {
        Ok(c) { return c }
        Err(e) {
            println("connect: error " + e.code.toStr() + " " + e.msg)
            exit(1)
        }
    }
}

fn client(port: &str) {
    var c = connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb"))
    x(mut &c, "table", "create table tv (id number primary key, v number, w varchar2(10))")
    x(mut &c, "insert", "insert into tv values (1, 10, 'a')")
    x(mut &c, "insert 2", "insert into tv values (2, 20, 'b')")
    x(mut &c, "view", "create view vv as select id, v from tv")
    x(mut &c, "replace wider", "create or replace view vv as select id, v, w from tv")
    q(mut &c, "select wider", "select * from vv order by id")
    x(mut &c, "replace new", "create or replace view vn as select id from tv")
    q(mut &c, "select new", "select * from vn order by id")
    x(mut &c, "replace narrower", "create or replace view vv as select w from tv")
    q(mut &c, "select narrower", "select * from vv order by w")
    q(mut &c, "view text", "select view_name, text from user_views where view_name = 'VV'")
    x(mut &c, "replace columns", "create or replace view vc (a, b) as select id, v from tv")
    q(mut &c, "select columns", "select * from vc order by a")
    x(mut &c, "replace other columns", "create or replace view vc (x, y, z) as select id, v, w from tv")
    q(mut &c, "select other columns", "select * from vc order by x")
    x(mut &c, "replace over table", "create or replace view tv as select 1 as a from dual")
    x(mut &c, "create over view", "create view vv as select id from tv")
    x(mut &c, "noforce", "create or replace noforce view vnf as select id from tv")
    x(mut &c, "bad column", "create or replace view vbad as select nothing from tv")
    x(mut &c, "bad table", "create or replace view vbad as select 1 from nothing_here")
    x(mut &c, "create or alter", "create or alter view vca as select id from tv")
    x(mut &c, "create or alter table", "create or alter table tx (a number)")
    x(mut &c, "replace table", "create or replace table tx (a number)")
    x(mut &c, "view over view", "create or replace view vw2 as select w from vv")
    x(mut &c, "replace under", "create or replace view vv as select id as w, v from tv")
    q(mut &c, "select over", "select * from vw2 order by w")
    t(mut &c, "replace is DDL: committed", "create or replace view vv as select 'z' as w from dual ;; select * from vv ;; select * from vv ;; select 1 as n from dual")
    q(mut &c, "after rollback", "select * from vv order by w")
    c.logoff()
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
