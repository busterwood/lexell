// lexdb over TNS: the DDL forms of design/lexdb-dialect-gaps.md package B (generated by tests/lexdb/gen_oracle.py from
// oracle_ddl_queries.txt): CREATE OR REPLACE VIEW (any new definition), RENAME and ALTER TABLE ... RENAME [COLUMN]
// (views over them invalidated), ALTER TABLE ... MODIFY (column type) (rows cast, indexes and constraints kept).
// Its answers are as Oracle's documentation gives them (no Oracle was at hand: each line gives its answer as a fourth field).
// Each answer is a label, then the row count, or the columns' names and rows, or error and the ORA- number.
// expect: table: 0
// expect: insert: 1
// expect: insert 2: 1
// expect: view: 0
// expect: replace wider: 0
// expect: select wider: ID,V,W = 1|10|'a';2|20|'b'
// expect: replace new: 0
// expect: select new: ID = 1;2
// expect: replace narrower: 0
// expect: select narrower: W = 'a';'b'
// expect: view text: VIEW_NAME,TEXT = 'VV'|'select w from tv'
// expect: replace columns: 0
// expect: select columns: A,B = 1|10;2|20
// expect: replace other columns: 0
// expect: select other columns: X,Y,Z = 1|10|'a';2|20|'b'
// expect: replace over table: error 955
// expect: create over view: error 955
// expect: noforce: 0
// expect: bad column: error 904
// expect: bad table: error 942
// expect: create or alter: error 922
// expect: create or alter table: error 922
// expect: replace table: error 922
// expect: view over view: 0
// expect: replace under: 0
// expect: select over: W = 1;2
// expect: replace is DDL: committed: 0 / W = 'z' / W = 'z' / N = 1
// expect: after rollback: W = 'z'
// expect: rn table: 0
// expect: rn index: 0
// expect: rn unique: 0
// expect: rn check: 0
// expect: rn row: 1
// expect: rn view: 0
// expect: rn view star: 0
// expect: rn child: 0
// expect: rn child row: 1
// expect: rename: 0
// expect: old name: error 942
// expect: new name: ID,V,W = 1|10|'a'
// expect: view invalid: error 4063
// expect: view star invalid: error 4063
// expect: rename keeps index: error 1
// expect: rename keeps check: error 2290
// expect: rename keeps fk: error 2291
// expect: rename keeps fk ok: 1
// expect: index of new: INDEX_NAME,TABLE_NAME = 'IX_TA_V'|'TA2';'UX_TA_W'|'TA2'
// expect: check of new: CONSTRAINT_NAME,TABLE_NAME = 'CK_TA'|'TA2'
// expect: rename back: 0
// expect: view valid again: ID,V = 1|10
// expect: view filtered: ID,V = 1|10
// expect: view filtered in a join: ID,V = 1|10
// expect: alter rename: 0
// expect: view invalid again: error 4063
// expect: alter rename back: 0
// expect: view works: ID,V = 1|10
// expect: rename column: 0
// expect: view over column: error 4063
// expect: new column: ID,VX = 1|10
// expect: index follows column: 1
// expect: check follows column: error 2290
// expect: column list: COLUMN_NAME = 'ID';'VX';'W'
// expect: index column: COLUMN_NAME = 'VX'
// expect: rename column back: 0
// expect: view valid after column: ID,V = 1|10;5|50
// expect: rename column to existing: error 957
// expect: rename column to itself: error 957
// expect: rename missing column: error 904
// expect: rename missing keyword COLUMN: error 14155
// expect: rename to itself: error 955
// expect: rename missing: error 942
// expect: rename to existing table: error 955
// expect: rename to existing view: error 955
// expect: rename view: 0
// expect: renamed view: ID,V = 1|10;5|50
// expect: old view name: error 942
// expect: rename view back: 0
// expect: sequence: 0
// expect: rename sequence: 0
// expect: sequence new name: N = 1
// expect: alter table rename missing: error 942
// expect: alter table rename to existing: error 955
// expect: rename case: 0
// expect: mixed name: TABLE_NAME = 'TB';'TV';'Ta_Mixed'
// expect: mixed select: N = 2
// expect: rename plain again: 0
// expect: rename is DDL: committed: N = 2
// expect: ty table: 0
// expect: ty rows: 1
// expect: ty rows 2: 1
// expect: ty rows 3: 1
// expect: ty index: 0
// expect: ty view: 0
// expect: widen number: 0
// expect: widen number data: N = 123;45;NULL
// expect: narrow number with data: error 1440
// expect: number to text with data: error 1439
// expect: widen varchar: 0
// expect: narrow varchar too small: error 1441
// expect: narrow varchar fits: 0
// expect: varchar data: S = 'abc';'12';NULL
// expect: varchar to number with data: error 1439
// expect: unchanged after failures: ID,N,S = 1|123|'abc';2|45|'12';3|NULL|NULL
// expect: index still used: ID = 2
// expect: view over modified: ID,N,S = 1|123|'abc';2|45|'12';3|NULL|NULL
// expect: empty column to number: 0
// expect: empty column data: 1
// expect: empty column value: E = 7
// expect: modify two: 0
// expect: modify missing column: error 904
// expect: modify missing table: error 942
// expect: modify unknown type: error 902
// expect: modify not null: error 2296
// expect: modify null: 0
// expect: insert null into modified: 1
// expect: modify not null again: error 2296
// expect: delete null row: 1
// expect: modify not null ok: 0
// expect: not null kept: error 1400
// expect: modify default: 0
// expect: alter column is not Oracle: error 905
// expect: big table: 0
// expect: big rows: 3500
// expect: big index: 0
// expect: big widen: 0
// expect: big widen data: N,S,LO,HI = 3500|6126750|1|3500
// expect: big index lookup: ID = 3333
// expect: big narrow varchar: error 1441
// expect: big unchanged: N,LEN = 3500|4
// expect: big narrow fits: 0
// expect: big text to number: error 1439
// expect: big end: N,S = 3500|6126750
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn q(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + qtext(c, sql)) }
fn x(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + xtext(c, sql)) }

// Statements and queries ("a ;; b ;; c") in one transaction, rolled back (t) or committed (u): each answer, joined by " / ".
fn tx(c: mut &oracle.Conn, label: &str, sqls: &str, commit: bool) {
    var out: []str = []
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for part in strings.split(sqls, " ;; ") {
            if strings.startsWith(&strings.toLowerAscii(part), "select") { append(mut &out, qtext(c2, part)) } else { append(mut &out, xtext(c2, part)) }
        }
        if !commit { return Err(sqldialect.inputError("rolled back")) }
        return Ok(0)
    })
    println(label + ": " + strings.join(&out, " / "))
}
fn t(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, false) }
fn u(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, true) }

fn connect(s: &str): oracle.Conn {
    match oracle.connect(&(s.toStr())) {
        Ok(c) { return c }
        Err(e) {
            println("connect: error " + e.code.toStr() + " " + e.msg)
            exit(1)
        }
    }
}

fn client(port: &str) {
    var c = connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb"))
    x(mut &c, "table", "create table tv (id number primary key, v number, w varchar2(10))")
    x(mut &c, "insert", "insert into tv values (1, 10, 'a')")
    x(mut &c, "insert 2", "insert into tv values (2, 20, 'b')")
    x(mut &c, "view", "create view vv as select id, v from tv")
    x(mut &c, "replace wider", "create or replace view vv as select id, v, w from tv")
    q(mut &c, "select wider", "select * from vv order by id")
    x(mut &c, "replace new", "create or replace view vn as select id from tv")
    q(mut &c, "select new", "select * from vn order by id")
    x(mut &c, "replace narrower", "create or replace view vv as select w from tv")
    q(mut &c, "select narrower", "select * from vv order by w")
    q(mut &c, "view text", "select view_name, text from user_views where view_name = 'VV'")
    x(mut &c, "replace columns", "create or replace view vc (a, b) as select id, v from tv")
    q(mut &c, "select columns", "select * from vc order by a")
    x(mut &c, "replace other columns", "create or replace view vc (x, y, z) as select id, v, w from tv")
    q(mut &c, "select other columns", "select * from vc order by x")
    x(mut &c, "replace over table", "create or replace view tv as select 1 as a from dual")
    x(mut &c, "create over view", "create view vv as select id from tv")
    x(mut &c, "noforce", "create or replace noforce view vnf as select id from tv")
    x(mut &c, "bad column", "create or replace view vbad as select nothing from tv")
    x(mut &c, "bad table", "create or replace view vbad as select 1 from nothing_here")
    x(mut &c, "create or alter", "create or alter view vca as select id from tv")
    x(mut &c, "create or alter table", "create or alter table tx (a number)")
    x(mut &c, "replace table", "create or replace table tx (a number)")
    x(mut &c, "view over view", "create or replace view vw2 as select w from vv")
    x(mut &c, "replace under", "create or replace view vv as select id as w, v from tv")
    q(mut &c, "select over", "select * from vw2 order by w")
    t(mut &c, "replace is DDL: committed", "create or replace view vv as select 'z' as w from dual ;; select * from vv ;; select * from vv ;; select 1 as n from dual")
    q(mut &c, "after rollback", "select * from vv order by w")
    x(mut &c, "rn table", "create table ta (id number primary key, v number, w varchar2(10))")
    x(mut &c, "rn index", "create index ix_ta_v on ta (v)")
    x(mut &c, "rn unique", "create unique index ux_ta_w on ta (w)")
    x(mut &c, "rn check", "alter table ta add constraint ck_ta check (v > 0)")
    x(mut &c, "rn row", "insert into ta values (1, 10, 'a')")
    x(mut &c, "rn view", "create view va as select id, v from ta")
    x(mut &c, "rn view star", "create view vastar as select * from ta")
    x(mut &c, "rn child", "create table tb (id number, ta_id number references ta (id))")
    x(mut &c, "rn child row", "insert into tb values (1, 1)")
    x(mut &c, "rename", "rename ta to ta2")
    q(mut &c, "old name", "select * from ta")
    q(mut &c, "new name", "select * from ta2")
    q(mut &c, "view invalid", "select * from va")
    q(mut &c, "view star invalid", "select * from vastar")
    x(mut &c, "rename keeps index", "insert into ta2 values (2, 20, 'a')")
    x(mut &c, "rename keeps check", "insert into ta2 values (3, -1, 'c')")
    x(mut &c, "rename keeps fk", "insert into tb values (2, 99)")
    x(mut &c, "rename keeps fk ok", "insert into tb values (2, 1)")
    q(mut &c, "index of new", "select index_name, table_name from user_indexes where index_name in ('IX_TA_V', 'UX_TA_W') order by index_name")
    q(mut &c, "check of new", "select constraint_name, table_name from user_constraints where constraint_name = 'CK_TA'")
    x(mut &c, "rename back", "rename ta2 to ta")
    q(mut &c, "view valid again", "select * from va")
    q(mut &c, "view filtered", "select * from va where id = 1 and v > 5")
    q(mut &c, "view filtered in a join", "select a.id, b.v from ta a join va b on b.id = a.id where b.v = 10")
    x(mut &c, "alter rename", "alter table ta rename to ta3")
    q(mut &c, "view invalid again", "select * from va")
    x(mut &c, "alter rename back", "alter table ta3 rename to ta")
    q(mut &c, "view works", "select * from va")
    x(mut &c, "rename column", "alter table ta rename column v to vx")
    q(mut &c, "view over column", "select * from va")
    q(mut &c, "new column", "select id, vx from ta")
    x(mut &c, "index follows column", "insert into ta (id, vx, w) values (5, 50, 'e')")
    x(mut &c, "check follows column", "insert into ta (id, vx, w) values (6, -5, 'f')")
    q(mut &c, "column list", "select column_name from user_tab_columns where table_name = 'TA' order by column_id")
    q(mut &c, "index column", "select column_name from user_ind_columns where index_name = 'IX_TA_V'")
    x(mut &c, "rename column back", "alter table ta rename column vx to v")
    q(mut &c, "view valid after column", "select * from va order by id")
    x(mut &c, "rename column to existing", "alter table ta rename column v to w")
    x(mut &c, "rename column to itself", "alter table ta rename column v to v")
    x(mut &c, "rename missing column", "alter table ta rename column nocol to x")
    x(mut &c, "rename missing keyword COLUMN", "alter table ta rename v to vx")
    x(mut &c, "rename to itself", "rename ta to ta")
    x(mut &c, "rename missing", "rename nothere to x")
    x(mut &c, "rename to existing table", "rename ta to tb")
    x(mut &c, "rename to existing view", "rename ta to va")
    x(mut &c, "rename view", "rename va to va2")
    q(mut &c, "renamed view", "select * from va2 order by id")
    q(mut &c, "old view name", "select * from va")
    x(mut &c, "rename view back", "rename va2 to va")
    x(mut &c, "sequence", "create sequence sq1")
    x(mut &c, "rename sequence", "rename sq1 to sq2")
    q(mut &c, "sequence new name", "select sq2.nextval as n from dual")
    x(mut &c, "alter table rename missing", "alter table nothere rename to x")
    x(mut &c, "alter table rename to existing", "alter table ta rename to tb")
    x(mut &c, "rename case", "rename ta to \"Ta_Mixed\"")
    q(mut &c, "mixed name", "select table_name from user_tables where table_name like 'T%' order by 1")
    q(mut &c, "mixed select", "select count(*) as n from \"Ta_Mixed\"")
    x(mut &c, "rename plain again", "rename \"Ta_Mixed\" to ta")
    q(mut &c, "rename is DDL: committed", "select count(*) as n from ta")
    x(mut &c, "ty table", "create table ma (id number primary key, n number(10), s varchar2(10), d date, c char(5), v varchar2(10) not null, e varchar2(5))")
    x(mut &c, "ty rows", "insert into ma values (1, 123, 'abc', date '2024-01-02', 'xy', 'v1', null)")
    x(mut &c, "ty rows 2", "insert into ma values (2, 45, '12', date '2024-03-04', 'z', 'v2', null)")
    x(mut &c, "ty rows 3", "insert into ma values (3, null, null, null, null, 'v3', null)")
    x(mut &c, "ty index", "create index ix_ma_s on ma (s)")
    x(mut &c, "ty view", "create view vma as select id, n, s from ma")
    x(mut &c, "widen number", "alter table ma modify (n number(12))")
    q(mut &c, "widen number data", "select n from ma order by id")
    x(mut &c, "narrow number with data", "alter table ma modify (n number(5))")
    x(mut &c, "number to text with data", "alter table ma modify (n varchar2(10))")
    x(mut &c, "widen varchar", "alter table ma modify (s varchar2(20))")
    x(mut &c, "narrow varchar too small", "alter table ma modify (s varchar2(2))")
    x(mut &c, "narrow varchar fits", "alter table ma modify (s varchar2(3))")
    q(mut &c, "varchar data", "select s from ma order by id")
    x(mut &c, "varchar to number with data", "alter table ma modify (s number)")
    q(mut &c, "unchanged after failures", "select id, n, s from ma order by id")
    q(mut &c, "index still used", "select id from ma where s = '12'")
    q(mut &c, "view over modified", "select * from vma order by id")
    x(mut &c, "empty column to number", "alter table ma modify (e number)")
    x(mut &c, "empty column data", "update ma set e = 7 where id = 1")
    q(mut &c, "empty column value", "select e from ma where id = 1")
    x(mut &c, "modify two", "alter table ma modify (s varchar2(40), n number(14))")
    x(mut &c, "modify missing column", "alter table ma modify (nocol number)")
    x(mut &c, "modify missing table", "alter table nothere modify (n number)")
    x(mut &c, "modify unknown type", "alter table ma modify (n nosuchtype)")
    x(mut &c, "modify not null", "alter table ma modify (e not null)")
    x(mut &c, "modify null", "alter table ma modify (v null)")
    x(mut &c, "insert null into modified", "insert into ma (id, v) values (4, null)")
    x(mut &c, "modify not null again", "alter table ma modify (v not null)")
    x(mut &c, "delete null row", "delete from ma where id = 4")
    x(mut &c, "modify not null ok", "alter table ma modify (v not null)")
    x(mut &c, "not null kept", "insert into ma (id, v) values (5, null)")
    x(mut &c, "modify default", "alter table ma modify (e default 9)")
    x(mut &c, "alter column is not Oracle", "alter table ma alter column n number")
    x(mut &c, "big table", "create table mb (id number primary key, v number(10), s varchar2(20))")
    x(mut &c, "big rows", "insert into mb select level, level, to_char(level) from dual connect by level <= 3500")
    x(mut &c, "big index", "create index ix_mb_v on mb (v)")
    x(mut &c, "big widen", "alter table mb modify (v number(15))")
    q(mut &c, "big widen data", "select count(*) as n, sum(v) as s, min(v) as lo, max(v) as hi from mb")
    q(mut &c, "big index lookup", "select id from mb where v = 3333")
    x(mut &c, "big narrow varchar", "alter table mb modify (s varchar2(3))")
    q(mut &c, "big unchanged", "select count(*) as n, max(length(s)) as len from mb")
    x(mut &c, "big narrow fits", "alter table mb modify (s varchar2(4))")
    x(mut &c, "big text to number", "alter table mb modify (s number)")
    q(mut &c, "big end", "select count(*) as n, sum(to_number(s)) as s from mb")
    c.logoff()
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
