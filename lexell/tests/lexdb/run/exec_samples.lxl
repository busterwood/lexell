// lexdb_exec: ANALYZE's samples (optimizer 37), the rest of SQLite's stat4:
// per index and primary key, up to 24 keys of the leading column spread
// evenly over its rows, with the rows below and equal to each. A range with
// literal bounds is estimated from them (within a gap, by the numbers for
// numbers and dates, else a third or two thirds of it), so a clustered or
// skewed column's ranges are estimated as they are; a parameter's is not.
// Checked by hand against the counts.
// expect: -- ev: 20,000 rows; 90% dated in June 2020, the rest spread over the year; names n0 .. n999
// expect: create table ev (id int primary key, d date, name text, kind int) -> CREATE TABLE
// expect: insert into ev select g, case when g % 10 = 0 then date '2020-01-01' + (g % 365) else date '2020-06-01' + (g % 30) end, 'n' || (g % 1000), g % 3 from generate_series(1, 20000) g -> INSERT 0 20000
// expect: create index ev_d on ev (d) -> CREATE INDEX
// expect: create index ev_name on ev (name) -> CREATE INDEX
// expect: create index ev_kind on ev (kind) -> CREATE INDEX
// expect: analyze -> ANALYZE
// expect: -- ranges by the samples: inside the cluster, outside it, at the end, of text, of the key
// expect: explain select count(*) from ev where d >= date '2020-06-01' and d < date '2020-07-01' -> [QUERY PLAN] scan ev: index ev_d range (estimated 18175 rows); aggregate
// expect: select count(*) from ev where d >= date '2020-06-01' and d < date '2020-07-01' -> [count] 18165
// expect: explain select count(*) from ev where d >= date '2020-02-01' and d < date '2020-03-01' -> [QUERY PLAN] scan ev: index ev_d range (estimated 159 rows); aggregate
// expect: select count(*) from ev where d >= date '2020-02-01' and d < date '2020-03-01' -> [count] 137
// expect: explain select count(*) from ev where d > date '2020-12-01' -> [QUERY PLAN] scan ev: index ev_d range (estimated 135 rows); aggregate
// expect: select count(*) from ev where d > date '2020-12-01' -> [count] 135
// expect: explain select count(*) from ev where name >= 'n5' and name < 'n6' -> [QUERY PLAN] scan ev: index ev_name range (estimated 1933 rows); aggregate
// expect: select count(*) from ev where name >= 'n5' and name < 'n6' -> [count] 2220
// expect: explain select count(*) from ev where id between 100 and 199 -> [QUERY PLAN] scan ev: primary key range (estimated 98 rows); aggregate
// expect: -- the range decides between indexes: February by date (few rows), June by kind
// expect: explain select count(*) from ev where kind = 1 and d >= date '2020-02-01' and d < date '2020-03-01' -> [QUERY PLAN] scan ev: index ev_d range (estimated 159 rows); aggregate
// expect: explain select count(*) from ev where kind = 1 and d >= date '2020-06-01' and d < date '2020-07-01' -> [QUERY PLAN] scan ev: index ev_kind lookup (estimated 6667 rows); aggregate
// expect: -- a parameter bound is an unknown value: a bound, not the samples
// expect: explain select count(*) from ev where d >= $1 -> [QUERY PLAN] scan ev: index ev_d range (at most 20000 rows); aggregate
// expect: -- in a join: February is hashed through its index
// expect: create table o (id int primary key, eid int) -> CREATE TABLE
// expect: insert into o select g, g * 7 % 20000 + 1 from generate_series(1, 5000) g -> INSERT 0 5000
// expect: analyze o -> ANALYZE
// expect: explain select count(*) from o join ev on ev.id = o.eid where ev.d >= date '2020-02-01' and ev.d < date '2020-03-01' -> [QUERY PLAN] scan o: full scan; join ev: hash on (id) over index ev_d range (estimated 159 rows); aggregate
// expect: select count(*) from o join ev on ev.id = o.eid where ev.d >= date '2020-02-01' and ev.d < date '2020-03-01' -> [count] 35
// expect: set lexdb_planner = rules -> SET
// expect: select count(*) from o join ev on ev.id = o.eid where ev.d >= date '2020-02-01' and ev.d < date '2020-03-01' -> [count] 35
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"

fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows {
                println(sql + " -> " + r.tag)
                return
            }
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name) }
            println(sql + " -> [" + strings.join(&names, ",") + "]" + (if len(lines) > 0 { " " } else { "" }) + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

// EXPLAIN ANALYZE without its last line (the time).
fn analyze(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for i in 0..len(r.rows) - 1 { append(mut &lines, lexdb_exec.text(&r.rows[i][0])) }
            println(sql + " -> " + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    println("-- ev: 20,000 rows; 90% dated in June 2020, the rest spread over the year; names n0 .. n999")
    show(mut &s, "create table ev (id int primary key, d date, name text, kind int)")
    show(mut &s, "insert into ev select g, case when g % 10 = 0 then date '2020-01-01' + (g % 365) else date '2020-06-01' + (g % 30) end, 'n' || (g % 1000), g % 3 from generate_series(1, 20000) g")
    show(mut &s, "create index ev_d on ev (d)")
    show(mut &s, "create index ev_name on ev (name)")
    show(mut &s, "create index ev_kind on ev (kind)")
    show(mut &s, "analyze")
    println("-- ranges by the samples: inside the cluster, outside it, at the end, of text, of the key")
    show(mut &s, "explain select count(*) from ev where d >= date '2020-06-01' and d < date '2020-07-01'")
    show(mut &s, "select count(*) from ev where d >= date '2020-06-01' and d < date '2020-07-01'")
    show(mut &s, "explain select count(*) from ev where d >= date '2020-02-01' and d < date '2020-03-01'")
    show(mut &s, "select count(*) from ev where d >= date '2020-02-01' and d < date '2020-03-01'")
    show(mut &s, "explain select count(*) from ev where d > date '2020-12-01'")
    show(mut &s, "select count(*) from ev where d > date '2020-12-01'")
    show(mut &s, "explain select count(*) from ev where name >= 'n5' and name < 'n6'")
    show(mut &s, "select count(*) from ev where name >= 'n5' and name < 'n6'")
    show(mut &s, "explain select count(*) from ev where id between 100 and 199")
    println("-- the range decides between indexes: February by date (few rows), June by kind")
    show(mut &s, "explain select count(*) from ev where kind = 1 and d >= date '2020-02-01' and d < date '2020-03-01'")
    show(mut &s, "explain select count(*) from ev where kind = 1 and d >= date '2020-06-01' and d < date '2020-07-01'")
    println("-- a parameter bound is an unknown value: a bound, not the samples")
    show(mut &s, "explain select count(*) from ev where d >= $1")
    println("-- in a join: February is hashed through its index")
    show(mut &s, "create table o (id int primary key, eid int)")
    show(mut &s, "insert into o select g, g * 7 % 20000 + 1 from generate_series(1, 5000) g")
    show(mut &s, "analyze o")
    show(mut &s, "explain select count(*) from o join ev on ev.id = o.eid where ev.d >= date '2020-02-01' and ev.d < date '2020-03-01'")
    show(mut &s, "select count(*) from o join ev on ev.id = o.eid where ev.d >= date '2020-02-01' and ev.d < date '2020-03-01'")
    show(mut &s, "set lexdb_planner = rules")
    show(mut &s, "select count(*) from o join ev on ev.id = o.eid where ev.d >= date '2020-02-01' and ev.d < date '2020-03-01'")
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
