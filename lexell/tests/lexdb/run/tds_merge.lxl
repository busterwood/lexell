import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "CREATE TABLE tgt (id int PRIMARY KEY, name varchar(20), qty int NOT NULL DEFAULT 0, note varchar(20) NULL)\nINSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nCREATE TABLE src (id int, name varchar(20), qty int)\nINSERT INTO src VALUES (2, 'B', 5), (3, 'C', 7), (4, 'D', 9), (5, 'E', 11)\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET name = s.name, qty = t.qty + s.qty WHEN NOT MATCHED THEN INSERT (id, name, qty) VALUES (s.id, s.name, s.qty);\nSELECT * FROM tgt ORDER BY id\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN DELETE\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN DELETE WHEN NOT MATCHED THEN INSERT (id) VALUES (s.id) ; SELECT 1\nSELECT COUNT(*) FROM tgt\nMERGE INTO tgt USING (VALUES (6, 'F', 1)) AS v(id, name, qty) ON tgt.id = v.id WHEN NOT MATCHED BY TARGET THEN INSERT VALUES (v.id, v.name, DEFAULT, NULL);\nSELECT * FROM tgt WHERE id = 6\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED AND s.qty > 6 THEN DELETE WHEN MATCHED THEN UPDATE SET note = 'small' WHEN NOT MATCHED AND s.qty < 10 THEN INSERT (id, name) VALUES (s.id, s.name);\nSELECT * FROM tgt ORDER BY id\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET note = 'a' WHEN MATCHED THEN DELETE;\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED AND s.qty > 6 THEN UPDATE SET note = 'a' WHEN MATCHED AND s.qty > 5 THEN DELETE;\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN NOT MATCHED THEN INSERT (id) VALUES (s.id) WHEN NOT MATCHED THEN INSERT (id) VALUES (s.id);\nSELECT * FROM tgt ORDER BY id\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nDELETE FROM src; INSERT INTO src VALUES (2, 'B', 5), (3, 'C', 7), (4, 'D', 9), (5, 'E', 11)\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED AND t.id = 3 THEN UPDATE SET note = 'three'; SELECT @@ROWCOUNT\nMERGE tgt AS t USING (SELECT * FROM src WHERE 1 = 0) AS s ON t.id = s.id WHEN MATCHED THEN DELETE WHEN NOT MATCHED THEN INSERT (id) VALUES (s.id); SELECT @@ROWCOUNT\nSELECT * FROM tgt ORDER BY id\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nMERGE tgt AS t USING (SELECT 1 AS id UNION ALL SELECT 2) AS s ON t.id = s.id WHEN MATCHED THEN DELETE;\nMERGE tgt AS t USING (SELECT id, name FROM src WHERE id > 3) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET name = LOWER(s.name) WHEN NOT MATCHED THEN INSERT (id, name) VALUES (s.id + 100, s.name);\nMERGE tgt AS t USING (VALUES (3, 'x'), (77, 'y')) AS v (id, name) ON t.id = v.id WHEN MATCHED THEN UPDATE SET name = v.name WHEN NOT MATCHED THEN INSERT (id, name) VALUES (v.id, v.name);\nMERGE tgt AS t USING (SELECT name, SUM(qty) AS q FROM src GROUP BY name) AS s ON t.name = LOWER(s.name) WHEN MATCHED THEN UPDATE SET qty = s.q;\nSELECT * FROM tgt ORDER BY id\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nCREATE TABLE dup (id int, name varchar(20))\nINSERT INTO dup VALUES (3, 'p'), (3, 'q'), (8, 'r')\nMERGE tgt AS t USING dup AS d ON t.id = d.id WHEN MATCHED THEN UPDATE SET name = d.name;\nMERGE tgt AS t USING dup AS d ON t.id = d.id WHEN MATCHED THEN DELETE;\nMERGE tgt AS t USING dup AS d ON t.id = d.id WHEN MATCHED AND d.name = 'p' THEN UPDATE SET name = 'only p';\nSELECT * FROM tgt ORDER BY id\nMERGE tgt AS t USING dup AS d ON t.id = d.id WHEN NOT MATCHED THEN INSERT (id, name) VALUES (d.id, d.name);\nSELECT * FROM tgt ORDER BY id\nMERGE tgt AS t USING (VALUES (50, 'a'), (50, 'b')) AS v(id, name) ON t.id = v.id WHEN NOT MATCHED THEN INSERT (id, name) VALUES (v.id, v.name);\nSELECT COUNT(*) FROM tgt WHERE id = 50\nCREATE TABLE nk (k int, v varchar(10))\nINSERT INTO nk VALUES (1, 'one'), (NULL, 'n1')\nMERGE nk AS t USING (VALUES (1, 'x1'), (NULL, 'n2')) AS s(k, v) ON t.k = s.k WHEN MATCHED THEN UPDATE SET v = s.v WHEN NOT MATCHED THEN INSERT (k, v) VALUES (s.k, s.v);\nSELECT * FROM nk ORDER BY k, v\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nMERGE tgt AS t USING (VALUES (1), (2), (900)) AS s(id) ON t.id = s.id WHEN MATCHED THEN UPDATE SET note = 'kept' WHEN NOT MATCHED BY SOURCE AND t.id > 100 THEN DELETE WHEN NOT MATCHED BY SOURCE THEN UPDATE SET note = 'orphan' WHEN NOT MATCHED BY TARGET THEN INSERT (id, name) VALUES (s.id + 1000, 'new');\nSELECT * FROM tgt ORDER BY id\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nMERGE tgt AS t USING (VALUES (1, 'R1'), (60, 'R60')) AS s(id, name) ON t.id = s.id WHEN MATCHED THEN UPDATE SET name = s.name WHEN NOT MATCHED THEN INSERT (id, name) VALUES (s.id, s.name) OUTPUT $action, inserted.id, deleted.id, inserted.name, deleted.name, s.name;\nMERGE tgt AS t USING (VALUES (1), (61)) AS s(id) ON t.id = s.id WHEN MATCHED THEN DELETE WHEN NOT MATCHED THEN INSERT (id, name) VALUES (s.id, 'ret') OUTPUT $action AS act, inserted.*, deleted.*;\nMERGE tgt AS t USING (VALUES (2)) AS s(id) ON t.id = s.id WHEN MATCHED THEN DELETE WHEN NOT MATCHED BY SOURCE AND t.id = 1 THEN UPDATE SET note = 'bysrc' OUTPUT $action, deleted.id, inserted.id, s.id, deleted.note, inserted.note;\nSET NOCOUNT ON; MERGE tgt AS t USING (VALUES (3)) AS s(id) ON t.id = s.id WHEN MATCHED THEN UPDATE SET note = 'nocount' OUTPUT inserted.id; SET NOCOUNT OFF\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nMERGE TOP (1) tgt AS t USING (VALUES (3), (4)) AS s(id) ON t.id = s.id WHEN MATCHED THEN UPDATE SET note = 'top';\nMERGE TOP (1) tgt AS t USING (VALUES (2000), (2001)) AS s(id) ON t.id = s.id WHEN NOT MATCHED THEN INSERT (id) VALUES (s.id);\nSELECT COUNT(*) FROM tgt WHERE note = 'top' OR id IN (2000, 2001)\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nCREATE TABLE idt (id int IDENTITY(1, 1) PRIMARY KEY, v varchar(10))\nMERGE idt AS t USING (VALUES ('a'), ('b'), ('c')) AS s(v) ON 1 = 0 WHEN NOT MATCHED THEN INSERT (v) VALUES (s.v);\nSELECT * FROM idt ORDER BY id\nMERGE idt AS t USING (VALUES (9, 'z')) AS s(id, v) ON t.id = s.id WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.id, s.v);\nSET IDENTITY_INSERT idt ON; MERGE idt AS t USING (VALUES (9, 'z')) AS s(id, v) ON t.id = s.id WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.id, s.v); SET IDENTITY_INSERT idt OFF; INSERT INTO idt (v) VALUES ('after'); SELECT * FROM idt ORDER BY id\nMERGE idt AS t USING (VALUES (1, 'A')) AS s(id, v) ON t.id = s.id WHEN MATCHED THEN UPDATE SET id = 5;\nMERGE idt AS t USING (VALUES (1)) AS s(id) ON t.id = s.id WHEN NOT MATCHED THEN INSERT DEFAULT VALUES;\nMERGE idt AS t USING (VALUES (77)) AS s(id) ON t.id = s.id WHEN NOT MATCHED THEN INSERT DEFAULT VALUES; SELECT COUNT(*) FROM idt\nMERGE tgt AS t USING (VALUES (1, 5)) AS s(id, n) ON t.id = s.id WHEN MATCHED THEN UPDATE SET qty = DEFAULT, note = DEFAULT;\nSELECT * FROM tgt WHERE id = 1\nCREATE TABLE kl (a int, b varchar(10))\nINSERT INTO kl VALUES (1, 'x'), (1, 'x'), (2, 'y')\nMERGE kl USING (VALUES (1), (3)) AS v(a) ON kl.a = v.a WHEN MATCHED THEN UPDATE SET b = 'hit' WHEN NOT MATCHED THEN INSERT (a, b) VALUES (v.a, 'new');\nMERGE kl USING (VALUES (2)) AS v(a) ON kl.a = v.a WHEN MATCHED THEN DELETE;\nSELECT * FROM kl ORDER BY a, b\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nMERGE tgt AS t USING (VALUES (1, 'ok'), (1000, 'bad')) AS s(id, name) ON t.id = s.id WHEN MATCHED THEN UPDATE SET name = s.name WHEN NOT MATCHED THEN INSERT (id, name, qty) VALUES (s.id, s.name, NULL);\nSELECT name FROM tgt WHERE id = 1\nMERGE tgt AS t USING (VALUES (1, 'ok')) AS s(id, name) ON t.id = s.id WHEN MATCHED THEN UPDATE SET id = 2;\nCREATE TABLE par (id int PRIMARY KEY)\nINSERT INTO par VALUES (1), (2)\nCREATE TABLE kid (id int PRIMARY KEY, p int REFERENCES par, n int CHECK (n > 0))\nMERGE kid AS k USING (VALUES (1, 1, 5), (2, 2, 6)) AS s(id, p, n) ON k.id = s.id WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.p, s.n);\nMERGE kid AS k USING (VALUES (3, 9, 5)) AS s(id, p, n) ON k.id = s.id WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.p, s.n);\nMERGE kid AS k USING (VALUES (3, 1, 0)) AS s(id, p, n) ON k.id = s.id WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.p, s.n);\nMERGE par AS t USING (VALUES (1)) AS s(id) ON t.id = s.id WHEN MATCHED THEN DELETE;\nBEGIN TRAN; MERGE tgt AS t USING (VALUES (1)) AS s(id) ON t.id = s.id WHEN MATCHED THEN UPDATE SET name = 'in tx'; SELECT name FROM tgt WHERE id = 1; ROLLBACK; SELECT name FROM tgt WHERE id = 1\nBEGIN TRAN; MERGE tgt AS t USING (VALUES (1)) AS s(id) ON t.id = s.id WHEN MATCHED THEN UPDATE SET name = 'committed'; COMMIT; SELECT name FROM tgt WHERE id = 1\nBEGIN TRAN; MERGE tgt AS t USING dup AS d ON t.id = d.id WHEN MATCHED THEN UPDATE SET name = 'x'; SELECT @@TRANCOUNT; ROLLBACK\nBEGIN TRY MERGE tgt AS t USING dup AS d ON t.id = d.id WHEN MATCHED THEN UPDATE SET name = 'x'; END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n; END CATCH\nWITH w AS (SELECT 4 AS id, 'cte' AS name) MERGE tgt AS t USING w ON t.id = w.id WHEN MATCHED THEN UPDATE SET name = w.name WHEN NOT MATCHED THEN INSERT (id, name) VALUES (w.id, w.name);\nSELECT * FROM tgt WHERE id = 4\nMERGE tgt AS t USING tgt AS s ON t.id = s.id + 1 WHEN MATCHED THEN UPDATE SET note = s.name;\nSELECT id, note FROM tgt WHERE id <= 4 ORDER BY id\nMERGE nope AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN DELETE;\nMERGE tgt AS t USING nope AS s ON t.id = s.id WHEN MATCHED THEN DELETE;\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET nope = 1;\nMERGE tgt AS t USING src AS s ON t.nope = s.id WHEN MATCHED THEN DELETE;\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN DO NOTHING;\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN INSERT (id) VALUES (1);\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN NOT MATCHED THEN DELETE;\nMERGE tgt AS t USING src AS s ON t.id = s.id;\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN NOT MATCHED THEN INSERT (id, name) VALUES (s.id);\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nCREATE TABLE s2 (id int, k int)\nINSERT INTO s2 VALUES (1, 1), (1, 2), (2, 1), (2, 2)\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN MATCHED AND s2.k = 1 THEN DELETE WHEN MATCHED THEN UPDATE SET qty = 0;\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN MATCHED AND s2.k = 1 THEN UPDATE SET qty = 0 WHEN MATCHED THEN DELETE;\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN MATCHED AND s2.k = 2 THEN UPDATE SET qty = 7;\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN MATCHED THEN DELETE OUTPUT deleted.id, deleted.qty;\nSELECT * FROM tgt ORDER BY id\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN NOT MATCHED BY SOURCE THEN INSERT (id) VALUES (1);\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN NOT MATCHED BY TARGET THEN UPDATE SET qty = 1;\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN MATCHED THEN UPDATE SET qty = 1 WHEN MATCHED THEN UPDATE SET qty = 2;\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN MATCHED THEN DELETE WHEN MATCHED AND t.id = 1 THEN UPDATE SET qty = 2;\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN MATCHED AND t.id = 1 THEN DELETE WHEN MATCHED AND t.id = 2 THEN DELETE;\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN NOT MATCHED BY SOURCE THEN DELETE WHEN NOT MATCHED BY SOURCE AND t.id = 1 THEN DELETE;\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN NOT MATCHED THEN INSERT (id, qty) VALUES (s2.id);\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN NOT MATCHED THEN INSERT (id) VALUES (s2.id, 5);\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN NOT MATCHED THEN INSERT VALUES (s2.id);\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN NOT MATCHED THEN INSERT (id, qty) VALUES (s2.id + 100, DEFAULT)\nMERGE tgt AS t USING s2 ON t.id = s2.id WHEN NOT MATCHED THEN INSERT (id, qty) VALUES (s2.id + 100, DEFAULT); SELECT 1\nDELETE FROM tgt; INSERT INTO tgt VALUES (1, 'a', 10, NULL), (2, 'b', 20, NULL), (3, 'c', 30, NULL)\nMERGE tgt WITH (HOLDLOCK) AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET note = 'hl';\nMERGE dbo.tgt t USING dbo.src s ON t.id = s.id WHEN MATCHED THEN UPDATE SET note = 'dbo';\nMERGE [tgt] AS [t] USING [src] AS [s] ON [t].[id] = [s].[id] WHEN MATCHED THEN UPDATE SET [note] = 'br';\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET t.note = 'qual';\nDECLARE @n int = 3; MERGE tgt AS t USING (SELECT @n AS id) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET note = 'var' + CAST(@n AS varchar(5));\nSELECT id, note FROM tgt ORDER BY id\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET qty = t.qty + 1 OUTPUT inserted.qty - deleted.qty AS diff, $action, UPPER(inserted.name) AS up;\nMERGE tgt AS t USING src AS s ON t.id = s.id WHEN MATCHED THEN DELETE OUTPUT deleted.*;"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(q.toStr(), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(dsn.toStr()) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(35), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
