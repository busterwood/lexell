// lexdb over TNS: a text the client sent after its length (lexdb_tns.lenStr): JDBC's is bare, python-oracledb's has a length byte first. A bare text
// whose first byte equals its length (a SELECT of 83 bytes starts with S, 83; INSERT 73, CREATE 67, BEGIN 66, DECLARE 68, WITH 87, UPDATE 85) was read as
// a length byte (the statement came out one byte short: ORA-00900, or a shifted request that closed the connection); the client's table of types
// (JDBC's) says which form it is. Each line: the text read (length and first character) or "error".
// expect: jdbc bare 83 S: 83 S
// expect: jdbc bare 84 S: 84 S
// expect: jdbc bare 82 S: 82 S
// expect: jdbc bare 67 C: 67 C
// expect: jdbc bare 73 I: 73 I
// expect: jdbc bare 87 W: 87 W
// expect: jdbc bare 2 x: 2 x
// expect: python prefixed 83 S: 83 S
// expect: python prefixed 67 C: 67 C
// expect: python prefixed 5: 5 a
// expect: jdbc bare 300: 300 y
import "strings"
import "tns"
import "../../../cmd/lexdb_tns"

// the text of n bytes starting with the letter first
fn text(first: &str, n: int): str { return first + strings.repeat("x", n - 1) }

fn read(label: &str, d: &str, n: int, jdbc: bool) {
    var c = tns.cursor(d)
    match lexdb_tns.lenStr(mut &c, d, n, "sql", jdbc) {
        Ok(s) { println(label + ": " + len(s).toStr() + " " + s[0..1].toStr()) }
        Err(e) { println(label + ": error") }
    }
}

fn main() {
    read("jdbc bare 83 S", &text("S", 83), 83, true)
    read("jdbc bare 84 S", &text("S", 84), 84, true)
    read("jdbc bare 82 S", &text("S", 82), 82, true)
    read("jdbc bare 67 C", &text("C", 67), 67, true)
    read("jdbc bare 73 I", &text("I", 73), 73, true)
    read("jdbc bare 87 W", &text("W", 87), 87, true)
    read("jdbc bare 2 x", &text("x", 2), 2, true)
    // python-oracledb: the length byte, then the text
    var b83 = ""
    b83.addByte(byte(83))
    read("python prefixed 83 S", &(b83 + text("S", 83)), 83, false)
    var b67 = ""
    b67.addByte(byte(67))
    read("python prefixed 67 C", &(b67 + text("C", 67)), 67, false)
    var b5 = ""
    b5.addByte(byte(5))
    read("python prefixed 5", &(b5 + "abcde"), 5, false)
    read("jdbc bare 300", &strings.repeat("y", 300), 300, true)
}
