// lexdb_wire: a COPY FROM STDIN whose table, columns or options are wrong is refused before the CopyInResponse (design/lexdb-robust.md,
// "The third bug slice"), as PostgreSQL 18 does: a client (psql running a script) sends no data for it. Each statement's messages,
// from a raw client; at a CopyInResponse it sends CopyFail. Checked against PostgreSQL 18.6 (the same messages and SQLSTATEs; the
// texts are PostgreSQL's but where lexdb's own: the delimiter's 0A000 is 22023, FORCE_NOT_NULL without CSV says "COPY force not null
// available only in CSV mode"): an unknown table, column or option, REJECT_LIMIT without ON_ERROR, an option given twice (42601),
// FORCE_NOT_NULL and FORCE_NULL of no column (42703) and of one not copied (42P10), HEADER 2.
// expect: unknown table: E 42P01 relation "nosuch" does not exist | Z
// expect: reject_limit without on_error: E 22023 COPY REJECT_LIMIT requires ON_ERROR to be set to IGNORE | Z
// expect: unknown option: E 42601 option "bogus" not recognized | Z
// expect: unknown column: E 42703 column "nosuchcol" of relation "b10" does not exist | Z
// expect: column twice: E 42701 column "a" specified more than once | Z
// expect: delimiter of two bytes: E 22023 COPY delimiter must be a single one-byte character | Z
// expect: header twice: E 42601 conflicting or redundant options | Z
// expect: format twice: E 42601 conflicting or redundant options | Z
// expect: delimiter twice: E 42601 conflicting or redundant options | Z
// expect: null twice: E 42601 conflicting or redundant options | Z
// expect: force_not_null of no column: E 42703 column "nosuch" of relation "b10" does not exist | Z
// expect: force_null of no column: E 42703 column "nosuch" of relation "b10" does not exist | Z
// expect: force_null of a column not copied: E 42P10 FORCE_NULL column "b" not referenced by COPY | Z
// expect: force_not_null without csv: E 0A000 COPY force not null available only in CSV mode | Z
// expect: header 2: E 42601 header requires a Boolean value or "match" | Z
// expect: header 1: G cols 2 | E 57014 COPY from stdin failed: stop | Z
// expect: a good one: G cols 2 | E 57014 COPY from stdin failed: stop | Z
// expect: after: T | D 0 | C SELECT 1 | Z
import "task"
import "net"
import "pgwire"
import "binary"
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"

type Rx = record { buf: []byte }

type Msg = record { typ: byte; body: []byte }

fn next(c: &net.Conn, rx: mut &Rx): Msg {
    var chunk = array(65536, byte(0))
    while len(rx.buf) < 5 || len(rx.buf) < 1 + binary.readI32BE(&rx.buf, 1) {
        let n = c.read(mut &chunk).unwrap()
        if n == 0 { return Msg{typ: '?', body: []} }
        for i in 0..n { append(mut &rx.buf, chunk[i]) }
    }
    let size = binary.readI32BE(&rx.buf, 1)
    var body: []byte = []
    for i in 5..1 + size { append(mut &body, rx.buf[i]) }
    var rest: []byte = []
    for i in 1 + size..len(rx.buf) { append(mut &rest, rx.buf[i]) }
    let typ = rx.buf[0]
    rx.buf = rest
    return Msg{typ: typ, body: body}
}

fn cstr(b: &[]byte, at: int): str {
    var i = at
    while i < len(b) && b[i] != 0 { i += 1 }
    return strFromBytes(&b[at..i])
}

// A message as the test shows it.
fn show(m: &Msg): str {
    let t = strFromBytes(&[m.typ])
    if m.typ == 'G' || m.typ == 'H' { return t + " cols " + binary.readU16BE(&m.body, 1).toStr() }
    if m.typ == 'd' {
        let l = strFromBytes(&m.body)
        return "d " + l[0..len(l) - 1]
    }
    if m.typ == 'C' { return "C " + cstr(&m.body, 0) }
    if m.typ == 'D' {
        let n = binary.readI32BE(&m.body, 2)
        return "D " + strFromBytes(&m.body[6..6 + n])
    }
    if m.typ == 'E' {
        var code = ""
        var msg = ""
        var at = 0
        while at < len(m.body) && m.body[at] != 0 {
            let f = m.body[at]
            let v = cstr(&m.body, at + 1)
            if f == 'C' { code = v.clone() }
            if f == 'M' { msg = v.clone() }
            if f == 'W' { msg = msg + " (" + v + ")" }
            at += 2 + len(v)
        }
        return "E " + code + " " + msg
    }
    return t
}

// until 'Z', the CopyData shown as their count, first and last line, each
// checked to be one line.
fn lines(c: &net.Conn, rx: mut &Rx): str {
    var out: []str = []
    var n = 0
    var first = ""
    var last = ""
    var bad = 0
    while true {
        let m = next(c, rx)
        if m.typ == 'd' {
            let l = strFromBytes(&m.body)
            if len(l) == 0 || l[len(l) - 1] != '\n' || strings.indexOf(&l[0..len(l) - 1], "\n", 0) >= 0 { bad += 1 }
            if n == 0 { first = l[0..len(l) - 1].clone() }
            last = l[0..len(l) - 1].clone()
            n += 1
            continue
        }
        if n > 0 {
            append(mut &out, "d*" + n.toStr() + " [" + first + " .. " + last + "]" + (if bad > 0 { " " + bad.toStr() + " not one line" } else { "" }))
            n = 0
        }
        append(mut &out, show(&m))
        if m.typ == 'Z' || m.typ == '?' { break }
    }
    return strings.join(&out, " | ")
}

// Messages until one of type stop (shown, joined by " | ").
fn until(c: &net.Conn, rx: mut &Rx, stop: byte): str {
    var out: []str = []
    while true {
        let m = next(c, rx)
        append(mut &out, show(&m))
        if m.typ == stop || m.typ == '?' { break }
    }
    return strings.join(&out, " | ")
}

fn raw(c: &net.Conn, typ: byte, body: &str) {
    var b = ""
    b.addByte(typ)
    binary.addU32BE(mut &b, len(body) + 4)
    b += body
    let s = b
    var out: []byte = []
    for i in 0..len(s) { append(mut &out, s[i]) }
    c.write(&out).unwrap()
}

fn query(c: &net.Conn, sql: str) {
    var o = pgwire.newOut()
    pgwire.putQuery(mut &o, &sql)
    c.write(o.bytes()).unwrap()
}

// Messages until ReadyForQuery; a CopyInResponse answered with CopyFail.
fn answer(c: &net.Conn, rx: mut &Rx): str {
    var out: []str = []
    while true {
        let m = next(c, rx)
        append(mut &out, show(&m))
        if m.typ == 'G' { raw(c, 'f', &"stop\x00") }
        if m.typ == 'Z' || m.typ == '?' { break }
    }
    return strings.join(&out, " | ")
}

fn client(addr: str) {
    let c = net.connect(&addr).unwrap()
    var rx = Rx{buf: []}
    var o = pgwire.newOut()
    let settings: []pgwire.Setting = []
    pgwire.putStartup(mut &o, "test", "test", &settings)
    c.write(o.bytes()).unwrap()
    let hello = until(&c, mut &rx, 'Z')
    query(&c, "create table b10 (a int, b text)")
    let made = until(&c, mut &rx, 'Z')
    query(&c, "copy nosuch from stdin")
    println("unknown table: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (reject_limit 5)")
    println("reject_limit without on_error: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (bogus 1)")
    println("unknown option: " + answer(&c, mut &rx))
    query(&c, "copy b10 (a, nosuchcol) from stdin")
    println("unknown column: " + answer(&c, mut &rx))
    query(&c, "copy b10 (a, a) from stdin")
    println("column twice: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (format csv, delimiter 'xx')")
    println("delimiter of two bytes: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (format csv, header true, header false)")
    println("header twice: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (format csv, format text)")
    println("format twice: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (delimiter ',', delimiter ';')")
    println("delimiter twice: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (null 'x', null 'y')")
    println("null twice: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (format csv, force_not_null (nosuch))")
    println("force_not_null of no column: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (format csv, force_null (a, nosuch))")
    println("force_null of no column: " + answer(&c, mut &rx))
    query(&c, "copy b10 (a) from stdin with (format csv, force_null (b))")
    println("force_null of a column not copied: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (format text, force_not_null (a))")
    println("force_not_null without csv: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (header 2)")
    println("header 2: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (header 1)")
    println("header 1: " + answer(&c, mut &rx))
    query(&c, "copy b10 from stdin with (format csv, force_not_null (b))")
    println("a good one: " + answer(&c, mut &rx))
    query(&c, "select count(*) from b10")
    println("after: " + answer(&c, mut &rx))
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_wire.acceptLoop, lexdb_wire.AcceptArg{ln: ln, st: st.share()})
        client(addr)
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(76), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
