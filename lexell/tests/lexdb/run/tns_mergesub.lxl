// lexdb over TNS: MERGE's subqueries read the rows as the statement found them, not as its own earlier rows left them, checked against Oracle Database
// Free 23.26 (gen_oracle.py --check tns_mergesub: the answers below are Oracle's): in UPDATE's SET and WHERE, DELETE WHERE, INSERT's values and WHERE,
// correlated and not, a source that is the target, NULLs, an empty and a duplicate source (ORA-30926), text keys, an error in a later row. Each statement
// runs with set lexdb_batch = off (the row engine) and on: "same" and the answer, or DIFFERENT and both.
// expect: setup: 9 statements
// expect: same: 3 / ID,SALARY = 1|100;2|101;3|201;4|301
// expect: same: 4 / ID,SALARY = 1|1000;2|1000;3|1000;4|1000
// expect: same: 4 / ID,SALARY = 1|103;2|202;3|301;4|400
// expect: same: 3 / ID,SALARY = 1|100;2|100;3|200;4|300
// expect: same: 2 / ID,SALARY = 1|404;2|404;3|300;4|400
// expect: same: 2 / ID,SALARY = 1|100;2|1200;3|1300;4|400
// expect: same: 2 / ID,SALARY = 1|100;2|200;3|301;4|401
// expect: same: 3 / ID,SALARY = 1|100
// expect: same: 3 / ID,SALARY = 1|100;4|401
// expect: same: 3 / ID,SALARY = 1|100
// expect: same: 3 / ID,SALARY = 1|100;2|200;3|300;4|400;5|4;6|4;7|4
// expect: same: 3 / ID,MGR_ID,SALARY = 1|NULL|100;2|1|200;3|2|300;4|3|400;5|4|1000;6|4|1000;7|4|1000
// expect: same: 3 / ID,SALARY = 1|100;2|200;3|300;4|400;5|4;6|4;7|4
// expect: same: 3 / ID,SALARY = 1|4;2|200;3|300;4|400;5|4;7|4
// expect: same: 4 / ID,SALARY = 1|100;2|4;3|300;4|400;5|4;6|4;7|4
// expect: same: 3 / ID,SALARY = 1|100;2|200;3|300;4|400;5|1;6|1;7|1
// expect: same: 3 / ID,SALARY = 1|100;2|0;3|300;4|400;5|1;6|1
// expect: same: 2 / ID,SALARY = 1|NULL;2|100;3|300;4|400
// expect: same: 0 / ID,SALARY = 1|100;2|200;3|300;4|400
// expect: same: 3 / ID,SALARY = 1|100;2|4;3|300;4|4;99|4
// expect: same: error 30926 / ID,SALARY = 1|100;2|200;3|300;4|400
// expect: same: error 8006 / ID,SALARY = 1|100;2|200;3|300;4|400
// expect: same: 3 / K,V = 'a'|6;'b'|6;'c'|3;'z'|3
// expect: same: 2 / K,V = 'b'|2;'c'|0
// expect: same: error 1476 / ID,SALARY = 1|100;2|200;3|300;4|400
// expect: same: error 1476 / ID,SALARY = 1|100;2|200;3|300;4|400
// expect: same: error 1 / ID,SALARY = 1|100;2|200;3|300;4|400
// expect: same: 2 / ID,SALARY = 1|100;2|1;3|1;4|400
// expect: same: error 1427 / ID,SALARY = 1|100;2|200;3|300;4|400
// expect: same: 1 / ID,SALARY = 1|100;2|NULL;3|300;4|400
// expect: same: 2 / ID,SALARY = 1|100;2|202;3|303;4|400
// expect: same: 2 / ID,SALARY = 1|100;2|0;3|300;4|400;6|9
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table emp (id number(10) primary key, mgr_id number(10), salary number(10))\ninsert into emp values (1, null, 100)\ninsert into emp values (2, 1, 200)\ninsert into emp values (3, 2, 300)\ninsert into emp values (4, 3, 400)\ncreate table tk (k varchar2(10) primary key, v number(10))\ninsert into tk values ('a', 1)\ninsert into tk values ('b', 2)\ninsert into tk values ('c', 3)"

const QS = "merge into emp e using (select 2 id from dual union all select 3 id from dual union all select 4 id from dual) s on (e.id = s.id) when matched then update set salary = (select x.salary + 1 from emp x where x.id = e.mgr_id) ;; select id, salary from emp order by id\nmerge into emp e using (select id from emp) s on (e.id = s.id) when matched then update set salary = (select sum(salary) from emp) ;; select id, salary from emp order by id\nmerge into emp e using (select 1 id from dual union all select 2 id from dual union all select 3 id from dual union all select 4 id from dual) s on (e.id = s.id) when matched then update set salary = salary + (select count(*) from emp x where x.salary > e.salary) ;; select id, salary from emp order by id\nmerge into emp e using emp s on (e.id = s.id + 1) when matched then update set salary = (select x.salary from emp x where x.id = s.id) ;; select id, salary from emp order by id\nmerge into emp e using (select id, (select max(salary) from emp) m from emp where id < 3) s on (e.id = s.id) when matched then update set salary = s.m + (select count(*) from emp) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 3 id from dual union all select 4 id from dual) s on (e.id = s.id) when matched then update set salary = salary + 1000 where (select x.salary from emp x where x.id = e.mgr_id) < 300 ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 3 id from dual union all select 4 id from dual) s on (e.id = s.id) when matched then update set salary = salary + 1 where salary > (select min(salary) from emp) + 100 ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 3 id from dual union all select 4 id from dual) s on (e.id = s.id) when matched then update set salary = salary + 1 delete where salary > (select min(x.salary) + 100 from emp x where x.id <> e.id) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 3 id from dual union all select 4 id from dual) s on (e.id = s.id) when matched then update set salary = salary + 1 delete where exists (select 1 from emp x where x.mgr_id = e.id) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 3 id from dual union all select 4 id from dual) s on (e.id = s.id) when matched then update set salary = (select count(*) from emp) delete where (select count(*) from emp) = 4 ;; select id, salary from emp order by id\nmerge into emp e using (select 5 id from dual union all select 6 id from dual union all select 7 id from dual) s on (e.id = s.id) when not matched then insert (id, salary) values (s.id, (select count(*) from emp)) ;; select id, salary from emp order by id\nmerge into emp e using (select 5 id from dual union all select 6 id from dual union all select 7 id from dual) s on (e.id = s.id) when not matched then insert (id, mgr_id, salary) values (s.id, (select max(id) from emp), (select sum(salary) from emp)) ;; select id, mgr_id, salary from emp order by id\nmerge into emp e using (select 5 id from dual union all select 6 id from dual union all select 7 id from dual) s on (e.id = s.id) when not matched then insert (id, salary) values (s.id, (select count(*) from emp x where x.id < s.id)) ;; select id, salary from emp order by id\nmerge into emp e using (select 5 id from dual union all select 1 id from dual union all select 7 id from dual) s on (e.id = s.id) when matched then update set salary = (select count(*) from emp) when not matched then insert (id, salary) values (s.id, (select count(*) from emp)) ;; select id, salary from emp order by id\nmerge into emp e using (select 5 id from dual union all select 6 id from dual union all select 7 id from dual union all select 2 id from dual) s on (e.id = s.id) when matched then update set salary = (select count(*) from emp x where x.id <= s.id + 3) when not matched then insert (id, salary) values (s.id, (select count(*) from emp x where x.id <= s.id)) ;; select id, salary from emp order by id\nmerge into emp e using (select 5 id from dual union all select 6 id from dual union all select 7 id from dual) s on (e.id = s.id) when not matched then insert (id, salary) values (s.id, 1) where (select count(*) from emp x where x.id < s.id) < 5 ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 5 id from dual union all select 6 id from dual) s on (e.id = s.id) when matched then update set salary = 0 where (select count(*) from emp) > 3 when not matched then insert (id, salary) values (s.id, 1) where (select count(*) from emp) > 3 ;; select id, salary from emp order by id\nmerge into emp e using (select 1 id from dual union all select 2 id from dual) s on (e.id = s.id) when matched then update set salary = (select x.salary from emp x where x.id = e.mgr_id) ;; select id, salary from emp order by id\nmerge into emp e using (select 1 id from dual where 1 = 0) s on (e.id = s.id) when matched then update set salary = (select count(*) from emp) when not matched then insert (id) values (s.id) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select null from dual union all select 4 from dual) s on (e.id = s.id) when matched then update set salary = (select count(*) from emp) when not matched then insert (id, salary) values (nvl(s.id, 99), (select count(*) from emp)) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 2 id from dual) s on (e.id = s.id) when matched then update set salary = (select count(*) from emp) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 2 id from dual) s on (e.id = s.id) when matched then update set salary = 1 delete where (select count(*) from emp) > 3 ;; select id, salary from emp order by id\nmerge into tk t using (select 'a' k from dual union all select 'b' from dual union all select 'z' from dual) s on (t.k = s.k) when matched then update set v = (select sum(v) from tk) when not matched then insert (k, v) values (s.k, (select count(*) from tk)) ;; select k, v from tk order by k\nmerge into tk t using (select 'a' k from dual union all select 'c' from dual) s on (t.k = s.k) when matched then update set v = 0 delete where (select max(v) from tk x where x.k <> t.k) > 2 ;; select k, v from tk order by k\nmerge into emp e using (select 2 id from dual union all select 3 id from dual union all select 4 id from dual) s on (e.id = s.id) when matched then update set salary = (select 1 / (x.salary - 300) from emp x where x.id = e.id) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 3 id from dual union all select 4 id from dual) s on (e.id = s.id) when matched then update set salary = 1 where (select 1 / (x.salary - 300) from emp x where x.id = e.id) > 0 ;; select id, salary from emp order by id\nmerge into emp e using (select 5 id from dual union all select 5 id from dual) s on (e.id = s.id) when not matched then insert (id, salary) values (s.id, (select count(*) from emp)) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 3 id from dual) s on (e.id = s.id) when matched then update set salary = (select count(*) from emp x where x.id = e.id + 1) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual) s on (e.id = s.id) when matched then update set salary = (select salary from emp where id > 1) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual) s on (e.id = s.id) when matched then update set salary = (select salary from emp where id > 5) ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 3 id from dual) s on (e.id = s.id) when matched then update set salary = e.salary + s.id ;; select id, salary from emp order by id\nmerge into emp e using (select 2 id from dual union all select 6 id from dual) s on (e.id = s.id) when matched then update set salary = 0 when not matched then insert (id, salary) values (s.id, 9) ;; select id, salary from emp order by id"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(164), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
