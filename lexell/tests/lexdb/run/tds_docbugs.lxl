const QUERIES = "@once CREATE TABLE nums (i int PRIMARY KEY)\n@once WITH n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 3000) INSERT INTO nums SELECT i FROM n OPTION (MAXRECURSION 0)\n@once CREATE TABLE p9 (id int PRIMARY KEY)\n@once INSERT INTO p9 VALUES (1), (2)\n@once CREATE TABLE c9 (id int PRIMARY KEY, pid int REFERENCES p9 (id), v int CHECK (v > 0))\nINSERT INTO c9 SELECT i + 100, 1, 2000 - i FROM nums\nSELECT count(*) AS n FROM c9\n@once INSERT INTO c9 SELECT i, 1, 5 FROM nums\nSELECT count(*) AS n FROM c9\nINSERT INTO c9 SELECT i + 10000, 1, 2000 - i FROM nums\nSELECT count(*) AS n FROM c9\nINSERT INTO c9 SELECT i + 10000, 1, 5 FROM nums WHERE i <= 2000 UNION ALL SELECT 20000, 3, 5\nSELECT count(*) AS n FROM c9\nUPDATE c9 SET pid = 2, v = 2000 - id\nSELECT count(*) AS n FROM c9 WHERE pid = 2\nUPDATE c9 SET id = id + 5000, v = 2000 - id\nSELECT count(*) AS n, min(id) AS lo FROM c9\nMERGE c9 AS t USING (SELECT i AS id FROM nums) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET v = 2000 - t.id, pid = 2;\nSELECT count(*) AS n FROM c9 WHERE pid = 2\nMERGE c9 AS t USING (SELECT i + 3000 AS id FROM nums) AS s ON t.id = s.id WHEN NOT MATCHED THEN INSERT VALUES (s.id, 1, 3500 - s.id);\nSELECT count(*) AS n FROM c9\n@once CREATE TABLE c9b (id int PRIMARY KEY, v int CHECK (v > 0))\nINSERT INTO c9b SELECT i + 100, 2000 - i FROM nums\nSELECT count(*) AS n FROM c9b\n@once CREATE TABLE dc1 (a int, b int, c int CONSTRAINT ckc CHECK (c > 0), CONSTRAINT ckab CHECK (a < b), CONSTRAINT ckbc CHECK (b + c > 0), d int)\nALTER TABLE dc1 DROP COLUMN c\nALTER TABLE dc1 DROP COLUMN b\nALTER TABLE dc1 DROP COLUMN a\n@once ALTER TABLE dc1 DROP COLUMN d\nSELECT name FROM sys.check_constraints WHERE parent_object_id = OBJECT_ID('dc1') ORDER BY name\n@once ALTER TABLE dc1 DROP CONSTRAINT ckbc\n@once ALTER TABLE dc1 DROP CONSTRAINT ckc\nALTER TABLE dc1 DROP COLUMN b\n@once ALTER TABLE dc1 DROP COLUMN c\nSELECT name FROM sys.check_constraints WHERE parent_object_id = OBJECT_ID('dc1') ORDER BY name\n@once CREATE TABLE dc2 (id int, v int CHECK (v > 0))\nALTER TABLE dc2 DROP COLUMN v\nINSERT INTO dc2 VALUES (1, -1)\n@once ALTER TABLE dc2 ADD w int CONSTRAINT ckw CHECK (w > 0)\nALTER TABLE dc2 DROP COLUMN w\nSELECT FORMAT(-5, '0;(0)') a, FORMAT(5, '0;(0)') b, FORMAT(0, '0;(0)') c, FORMAT(-5, '0;(0);zero') d, FORMAT(0, '0;(0);zero') e, FORMAT(5, '0;(0);zero') f, FORMAT(-0.4, '0;(0)') g, FORMAT(-0.4, '0;(0);zero') h, FORMAT(0.4, '0;(0);zero') h2\nSELECT FORMAT(1234.5, '#,##0.00;(#,##0.00)') a, FORMAT(-1234.5, '#,##0.00;(#,##0.00)') b, FORMAT(-1234.5, '0.0;-0.0;0') c, FORMAT(-7, ';(0)') d, FORMAT(7, '0;') e, FORMAT(-7, '0;') f, FORMAT(-7, '0;;') g, FORMAT(0, '0;;') h, FORMAT(0, '0;;\"nil\"') i, FORMAT(-1234.5, '#,##0.0 \"CR\";#,##0.0 \"DB\"') j, FORMAT(-12, '0;\\;0') k\nSELECT FORMAT(123456789, '###-##-####') a, FORMAT(12345, '###-##-####') b, FORMAT(1234, '###-##-####') c, FORMAT(123, '###-##-####') d, FORMAT(12, '###-##-####') e, FORMAT(0, '###-##-####') f, FORMAT(1234567, '(###) ###-####') g, FORMAT(5551234567, '(###) ###-####') h\nSELECT FORMAT(12345, '0-0-0-0-0') a, FORMAT(5, '0-0-0') b, FORMAT(5, '00-00-00') c, FORMAT(123456, '00-00-00') d, FORMAT(1234567, '00-00-00') e, FORMAT(1.5, '0-0.0-0') f, FORMAT(12.345, '0 0.0 0') g, FORMAT(1234.5678, '0-0.0-0-0') h, FORMAT(1234567, '#,##0 units') i, FORMAT(1234567, '#\"x\"##\"y\"#') j, FORMAT(12, '#\"x\"##\"y\"#') k, FORMAT(1234, '#a#b#c#') l\nSELECT FORMAT(1234567.891, '#,##0.00', 'de-DE') a, FORMAT(-1234567.891, '#,##0.00;(#,##0.00)', 'fr-FR') b, FORMAT(1234567, '000-000-0000', 'de-DE') c, FORMAT(0.256, '0.0%') d, FORMAT(0.256, '0.0 \"pct\"', 'de-DE') e, FORMAT(1234567.891, '#,###', 'en-IN') f\nSELECT FORMAT(-1234567.891, 'N2', 'en-US') n, FORMAT(1234567.891, 'C2', 'en-US') c, FORMAT(-1234567.891, 'C2', 'en-US') cn, FORMAT(0.1234, 'P2', 'en-US') p, FORMAT(-0.1234, 'P2', 'en-US') pn, FORMAT(1234567, 'N0', 'en-US') g, FORMAT(1234567.891, '#,##0.00', 'en-US') cu\nSELECT FORMAT(-1234567.891, 'N2', 'en-