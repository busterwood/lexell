// lexdb over TDS: the eighth bug slice (design/lexdb-robust.md, "The eighth bug slice"), checked against SQL Server 2022 (generated by
// tests/lexdb/gen_mssql.py bugs8 from mssql_bugs8_queries.txt): 159 has severity 15; 4512 and 2010 name the view or table as the statement
// wrote it; ALTER VIEW of a missing view is 208 state 6; INFORMATION_SCHEMA.DOMAINS lists table types. Each batch runs with
// SET lexdb_batch off and on; each expect line: "same: " and the batch's result sets and counts, or its error number, line and text.
// expect: ok
// expect: ok
// expect: ok
// expect: same: n,s,v,m: 159|1|15|'Must specify the table name and index name for the DROP INDEX statement.'
// expect: same: error 159 line 1: Must specify the table name and index name for the DROP INDEX statement.
// expect: same: n,s,v,m: 4512|3|16|'Cannot schema bind view ''dbo.v_bad1'' because name ''part8'' is invalid for schema binding. Names must be in two-part format and an object cannot reference itself.'
// expect: same: error 4512 line 1: Cannot schema bind view 'dbo.v_bad1' because name 'part8' is invalid for schema binding. Names must be in two-part format and an object cannot reference itself.
// expect: same: n,s,v,m: 4512|3|16|'Cannot schema bind view ''v_bad2'' because name ''part8'' is invalid for schema binding. Names must be in two-part format and an object cannot reference itself.'
// expect: same: error 4512 line 1: Cannot schema bind view 'v_bad2' because name 'part8' is invalid for schema binding. Names must be in two-part format and an object cannot reference itself.
// expect: same: n,s,v,m: 4512|3|16|'Cannot schema bind view ''dbo.V_Bad3'' because name ''part8'' is invalid for schema binding. Names must be in two-part format and an object cannot reference itself.'
// expect: same: error 4512 line 1: Cannot schema bind view 'dbo.V_Bad3' because name 'part8' is invalid for schema binding. Names must be in two-part format and an object cannot reference itself.
// expect: same: n,s,v,m: 208|6|16|'Invalid object name ''nosuch1''.'
// expect: same: error 208 line 1: Invalid object name 'nosuch1'.
// expect: same: n,s,v,m: 208|6|16|'Invalid object name ''dbo.nosuch2''.'
// expect: same: error 208 line 1: Invalid object name 'dbo.nosuch2'.
// expect: same: n,s,v,m: 208|6|16|'Invalid object name ''dbo.NoSuch3''.'
// expect: same: error 208 line 1: Invalid object name 'dbo.NoSuch3'.
// expect: same: n,s,v,m: 2010|1|16|'Cannot perform alter on ''emp8'' because it is an incompatible object type.'
// expect: same: error 2010 line 1: Cannot perform alter on 'emp8' because it is an incompatible object type.
// expect: same: n,s,v,m: 2010|1|16|'Cannot perform alter on ''dbo.emp8'' because it is an incompatible object type.'
// expect: same: error 2010 line 1: Cannot perform alter on 'dbo.emp8' because it is an incompatible object type.
// expect: same: n,s,v,m: 2010|1|16|'Cannot perform alter on ''dbo.EMP8'' because it is an incompatible object type.'
// expect: same: error 2010 line 1: Cannot perform alter on 'dbo.EMP8' because it is an incompatible object type.
// expect: ok
// expect: ok
// expect: same: domain_schema,domain_name,data_type,character_maximum_length,character_octet_length,numeric_precision,numeric_precision_radix,numeric_scale,datetime_precision,domain_default: 'dbo'|'tt8_tab'|'table type'|NULL|NULL|NULL|NULL|NULL|NULL|NULL;'dbo'|'tt8_tab2'|'table type'|NULL|NULL|NULL|NULL|NULL|NULL|NULL
// expect: same: domain_catalog,collation_name,character_set_name: 'lexdb'|NULL|NULL;'lexdb'|NULL|NULL
// expect: same: n: 2
// expect: ok
// expect: same: domain_name: 'tt8_tab'
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once CREATE TABLE emp8 (id int PRIMARY KEY, a int)\n@once CREATE TABLE part8 (id int)\n@once CREATE INDEX ix8 ON emp8 (a)\nBEGIN TRY EXEC('DROP INDEX ix8') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nDROP INDEX ix8\nBEGIN TRY EXEC('CREATE VIEW dbo.v_bad1 WITH SCHEMABINDING AS SELECT id FROM part8') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nCREATE VIEW dbo.v_bad1 WITH SCHEMABINDING AS SELECT id FROM part8\nBEGIN TRY EXEC('CREATE VIEW v_bad2 WITH SCHEMABINDING AS SELECT id FROM part8') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nCREATE VIEW v_bad2 WITH SCHEMABINDING AS SELECT id FROM part8\nBEGIN TRY EXEC('CREATE VIEW [dbo].[V_Bad3] WITH SCHEMABINDING AS SELECT id FROM part8') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nCREATE VIEW [dbo].[V_Bad3] WITH SCHEMABINDING AS SELECT id FROM part8\nBEGIN TRY EXEC('ALTER VIEW nosuch1 AS SELECT 1 AS a') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nALTER VIEW nosuch1 AS SELECT 1 AS a\nBEGIN TRY EXEC('ALTER VIEW dbo.nosuch2 AS SELECT 1 AS a') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nALTER VIEW dbo.nosuch2 AS SELECT 1 AS a\nBEGIN TRY EXEC('ALTER VIEW [dbo].[NoSuch3] AS SELECT 1 AS a') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nALTER VIEW [dbo].[NoSuch3] AS SELECT 1 AS a\nBEGIN TRY EXEC('ALTER VIEW emp8 AS SELECT 1 AS a') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nALTER VIEW emp8 AS SELECT 1 AS a\nBEGIN TRY EXEC('ALTER VIEW dbo.emp8 AS SELECT 1 AS a') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nALTER VIEW dbo.emp8 AS SELECT 1 AS a\nBEGIN TRY EXEC('ALTER VIEW [dbo].[EMP8] AS SELECT 1 AS a') END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS n, ERROR_STATE() AS s, ERROR_SEVERITY() AS v, ERROR_MESSAGE() AS m END CATCH\nALTER VIEW [dbo].[EMP8] AS SELECT 1 AS a\n@once CREATE TYPE tt8_tab2 AS TABLE (x int)\n@once CREATE TYPE tt8_tab AS TABLE (a int, b varchar(5))\nSELECT domain_schema, domain_name, data_type, character_maximum_length, character_octet_length, numeric_precision, numeric_precision_radix, numeric_scale, datetime_precision, domain_default FROM INFORMATION_SCHEMA.DOMAINS ORDER BY domain_name\nSELECT domain_catalog, collation_name, character_set_name FROM INFORMATION_SCHEMA.DOMAINS ORDER BY domain_name\nSELECT COUNT(*) AS n FROM INFORMATION_SCHEMA.DOMAINS WHERE domain_name LIKE 'tt8%'\n@once DROP TYPE tt8_tab2\nSELECT domain_name FROM INFORMATION_SCHEMA.DOMAINS ORDER BY domain_name"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = true   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(83), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
