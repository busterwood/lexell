// lexdb_exec: a SQL function called in a statement of another function's body or of a procedure (nested calls, in a select list, WHERE, a scalar subquery,
// INSERT ... SELECT, UPDATE, DELETE and a procedure's statements; PostgreSQL has no DO block here and lexdb no PL/pgSQL), checked against PostgreSQL 18
// (generated by tests/lexdb/gen_pg.py from sqlfunc_queries.txt). Each answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE;
// each statement runs with lexdb_batch off and on (an "@once" one once, an "@tx" one in a transaction rolled back).
// expect: CREATE TABLE
// expect: INSERT 0 3
// expect: CREATE FUNCTION
// expect: CREATE FUNCTION
// expect: CREATE FUNCTION
// expect: CREATE FUNCTION
// expect: CREATE FUNCTION
// expect: CREATE PROCEDURE
// expect: CREATE PROCEDURE
// expect: same: sf_f: 2;4;6
// expect: same: sf_g|sf_h|sf_sum: 2|5|12
// expect: same: a|sf_t: 2|n4;3|n6
// expect: same: a|c: 1|10;2|40;3|30;102|3
// expect: same: a|c: 1|10;3|30
// expect: same: a|c: 1|10;2|5;3|30
// expect: same: a|c: 1|10;2|20;3|30;1003|2;1005|4;1007|6
// expect: same: a|c: 1|10;3|30
// expect: same: sf_g: 
// expect: same: sf_f: 
// expect: same: sf_f: 
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table sf (a int primary key, c int)\n@once insert into sf values (1, 10), (2, 20), (3, 30)\n@once create function sf_f(x int) returns int language sql as $$ select x * 2 $$\n@once create function sf_g(x int) returns int language sql as $$ select (select sf_f(a) from sf where a = x) $$\n@once create function sf_h(x int) returns int language sql begin atomic select sf_f(x) + 1; end\n@once create function sf_sum() returns bigint language sql as $$ select sum(sf_f(a)) from sf $$\n@once create function sf_t(x int) returns text language sql as $$ select 'n' || sf_f(x) $$\n@once create procedure sf_p1() language sql as $$ insert into sf select sf_f(a) + 100, 3 from sf where a = 1; update sf set c = sf_f(c) where a = 2 $$\n@once create procedure sf_p2(x int) language sql as $$ delete from sf where a = sf_f(x) $$\nselect sf_f(a) from sf order by a\nselect sf_g(1), sf_h(2), sf_sum()\nselect a, sf_t(a) from sf where sf_f(a) > 2 order by a\n@tx call sf_p1(); select a, c from sf order by a\n@tx call sf_p2(1); select a, c from sf order by a\n@tx update sf set c = sf_h(a) where sf_f(a) = 4; select a, c from sf order by a\n@tx insert into sf select sf_h(a) + 1000, sf_f(a) from sf; select a, c from sf order by a\n@tx delete from sf where a = sf_g(1); select a, c from sf order by a\nselect sf_g(7)\nselect sf_f(null)\nselect sf_f(a) from sf where false"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(172), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
