// lexdb_exec: the seventh bug slice in the PostgreSQL door (design/lexdb-robust.md, "The seventh bug slice"): a SELECT * view keeps its columns
// as at CREATE VIEW when its table gains one (PostgreSQL expands * then; tds_bugs7 and tns_bugs7 for the other doors); SET TRANSACTION READ
// ONLY makes the block read-only, READ WRITE before its first query only (25001), ISOLATION LEVEL after it taken when the level stays;
// information_schema.domains and column_privileges. Checked against PostgreSQL 18 (generated by tests/lexdb/gen_pg.py from bugs7_queries.txt).
// Each answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off and on (an
// "@once" one once, an "@tx" one in a transaction rolled back).
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: ALTER TABLE
// expect: same: a|b: 1|2;3|
// expect: same: a|b|x: 1|2|11;3||13
// expect: same: a|b|k|m: 1|2|1|x;1|2|1|y
// expect: same: p|q: 1|2;3|
// expect: same: a|b: 1|2
// expect: same: a|b: 1|2
// expect: same: n: 2
// expect: same: a|c: 1|7;3|7
// expect: same: column_name: a;b;k;m
// expect: same: a|b: 
// expect: CREATE TABLE
// expect: INSERT 0 1
// expect: same: ERROR 25006
// expect: same: transaction_read_only: on
// expect: same: n: 1
// expect: same: ERROR 25006
// expect: same: ERROR 25006
// expect: same: n: 2
// expect: same: transaction_read_only: off
// expect: same: ERROR 25001
// expect: same: INSERT 0 1
// expect: same: n: 2
// expect: same: transaction_isolation: serializable
// expect: same: ERROR 25006
// expect: same: transaction_isolation: serializable
// expect: same: ERROR 25001
// expect: same: transaction_isolation: read committed
// expect: same: transaction_read_only: off
// expect: same: transaction_read_only: off
// expect: same: n: 1
// expect: same: domain_schema|domain_name|data_type|character_maximum_length|numeric_precision|datetime_precision|domain_default|udt_name: information_schema|cardinal_number|integer||32|||int4;information_schema|character_data|character varying|||||varchar;information_schema|sql_identifier|name|||||name;information_schema|time_stamp|timestamp with time zone|||2|CURRENT_TIMESTAMP(2)|timestamptz;information_schema|yes_or_no|character varying|3||||varchar
// expect: CREATE ROLE
// expect: GRANT
// expect: GRANT
// expect: same: grantee|table_name|column_name|privilege_type|is_grantable: PUBLIC|tt7|a|INSERT|NO;r7b7|tt7|a|SELECT|NO;r7b7|tt7|a|UPDATE|NO
// expect: same: n: 4
// expect: REVOKE
// expect: DROP ROLE
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table v7 (a int, b int)\n@once insert into v7 values (1, 2), (3, NULL)\n@once create view v7a as select * from v7\n@once create view v7b as select v7.*, a + 10 as x from v7\n@once create table w7 (k int, m text)\n@once insert into w7 values (1, 'x'), (1, 'y')\n@once create view v7c as select v7.*, w7.* from v7 join w7 on w7.k = v7.a\n@once create view v7d (p, q) as select * from v7\n@once create view v7e as select * from v7a where b is not null\n@once alter table v7 add column c int default 7\nselect * from v7a order by a\nselect * from v7b order by a\nselect * from v7c order by a, m\nselect * from v7d order by p\nselect * from v7e\nselect a, b from v7a where b = 2\nselect count(*) as n from v7c v join v7 t on t.a = v.a\nselect v.a, t.c from v7a v join v7 t on t.a = v.a order by 1\nselect column_name from information_schema.columns where table_name = 'v7c' order by ordinal_position\nselect * from v7a where a > 100\n@once create table tt7 (a int)\n@once insert into tt7 values (1)\n@tx set transaction read only; insert into tt7 values (5)\n@tx set transaction read only; show transaction_read_only\n@tx set transaction read only; select count(*) as n from tt7\n@tx select 1; set transaction read only; insert into tt7 values (6)\n@tx insert into tt7 values (7); set transaction read only; update tt7 set a = 0\n@tx insert into tt7 values (7); set transaction read only; select count(*) as n from tt7\n@tx select 1; set transaction read write; show transaction_read_only\n@tx set transaction read only; select 1; set transaction read write\n@tx set transaction read only; set transaction read write; insert into tt7 values (8)\n@tx set transaction read only; set transaction read write; insert into tt7 values (8); select count(*) as n from tt7\n@tx set transaction isolation level serializable, read only; show transaction_isolation\n@tx set transaction read only isolation level serializable; delete from tt7\n@tx set transaction isolation level serializable; select 1; set transaction isolation level serializable; show transaction_isolation\n@tx set transaction isolation level serializable; select 1; set transaction isolation level read committed\n@tx set transaction isolation level read committed; select 1; set transaction isolation level read committed; show transaction_isolation\n@tx show transaction_read_only\nshow transaction_read_only\nselect count(*) as n from tt7\nselect domain_schema, domain_name, data_type, character_maximum_length, numeric_precision, datetime_precision, domain_default, udt_name from information_schema.domains order by domain_name\n@once create role r7b7\n@once grant select, update on tt7 to r7b7\n@once grant insert on tt7 to public\nselect grantee, table_name, column_name, privilege_type, is_grantable from information_schema.column_privileges where table_name = 'tt7' and grantee <> current_user order by grantee, privilege_type\nselect count(*) as n from information_schema.column_privileges where table_name = 'tt7' and grantee = current_user\n@once revoke all on tt7 from r7b7\n@once drop role r7b7"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(177), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
