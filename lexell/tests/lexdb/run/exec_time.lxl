const QUERIES = "select date '2026-11-11', date '1066-10-14', date '0044-03-15 BC', date '0001-01-01 BC'\nselect date '4714-11-24 BC', date '5874897-12-31'\nselect date '4714-11-23 BC'\nselect date '5874898-01-01'\nselect date 'infinity', date '-infinity', date 'epoch'\nselect date '2026-02-30'\nselect date '2026-11-11 10:20'\nselect time '10:20', time '10:20:30', time '10:20:30.123456', time '23:59:59.9999995', time '24:00'\nselect time '25:00'\nselect timestamp '2026-11-11 10:20:30.5', timestamp '2026-11-11', timestamp '2026-11-11T10:20', timestamp '1215-06-15 09:30 BC'\nselect timestamp '2026-11-11 10:20:30+05', timestamp '294276-12-31 23:59:59.999999'\nselect timestamp '294277-01-01'\nselect timestamp 'infinity', timestamp '-infinity', timestamp 'epoch'\nselect timestamptz '2026-11-11 10:20:30+02', timestamptz '2026-11-11 10:20:30-05:30', timestamptz '2026-11-11 10:20:30Z', timestamptz '2026-11-11 10:20:30'\nselect timestamptz '2026-07-01 12:00 Europe/London', timestamptz '2026-01-01 12:00 America/New_York', timestamptz '2026-03-29 01:30 Europe/London'\nselect timestamptz '2026-11-11 10:20:30 UTC', timestamptz 'epoch', timestamptz 'infinity'\nselect timestamp(0) '2026-11-11 10:20:30.5', timestamp(3) '2026-11-11 10:20:30.12345', timestamptz(1) '2026-11-11 10:20:30.25+00'\nselect '2026-11-11 10:20:30.1234567'::timestamp, '2026-11-11 10:20:30.9999999'::timestamp\nselect interval '1 day', interval '1 year 2 months 3 days 04:05:06.5', interval '-1 day', interval '00:00:00'\nselect interval '1 day -2 hours', interval '-1 day 2 hours', interval '1 year -2 months', interval '-1 year -2 mons'\nselect interval '1.5 days', interval '1.5 months', interval '1.5 years', interval '2 weeks', interval '90 minutes'\nselect interval '1 day ago', interval '@ 2 hours', interval '1 hour 30 minutes 15.25 seconds', interval '3 days 04:05'\nselect interval 'P1Y2M3DT4H5M6S', interval 'PT90M', interval 'PT-1H', interval 'P-1Y'\nselect interval '-PT1H'\nselect interval '100 hours', interval '1000 years', interval '1 millisecond', interval '1 microsecond'\nselect interval '1 century', interval '1 decade', interval '2 millennium'\nselect interval '1 fortnight'\nselect interval '1 day' = interval '24 hours', interval '1 month' = interval '30 days', interval '1 month' < interval '31 days'\nselect '2026-11-11'::date, '2026-11-11 10:20:30'::timestamp::date, '2026-11-11'::date::timestamp, '2026-11-11 10:20:30'::timestamptz::date\nselect '2026-11-11 10:20:30'::timestamp::timestamptz, '2026-11-11 10:20:30+03'::timestamptz::timestamp, '2026-11-11 10:20:30'::timestamp::time\nselect '10:20'::time::interval, '1 day 02:03:04'::interval::time, cast('5 days' as interval)\nselect date '2026-11-11'::text, timestamp '2026-11-11 10:20'::text, interval '1 day'::text\nselect 'garbage'::date\nselect 'garbage'::interval\nselect 'garbage'::timestamptz\nselect date '2026-11-11' + 30, date '2026-11-11' - 30, 30 + date '2026-11-11', date '2026-11-11' - date '2026-01-01'\nselect date '2026-01-31' + interval '1 month', date '2026-11-11' - interval '1 day', date '2026-11-11' + time '10:20'\nselect timestamp '2026-01-31 10:00' + interval '1 month', timestamp '2024-02-29 10:00' + interval '1 year', timestamp '2026-11-11 10:00' - interval '1 day 2 hours'\nselect timestamp '2026-11-11 10:00' - timestamp '2026-11-01 08:30', timestamp '2026-11-01 08:30' - timestamp '2026-11-11 10:00'\nselect timestamptz '2026-11-11 10:00+00' - timestamptz '2026-11-11 08:00+02', timestamptz '2026-11-11 10:00+00' + interval '1 day 2 hours'\nselect time '23:00' + interval '2 hours', time '01:00' - interval '2 hours', time '10:00' - time '08:30'\nselect interval '1 day' + interval '2 hours', interval '1 day' - interval '2 hours', -interval '1 day 02:00', interval '1 day' * 2.5, interval '1 month' / 3, 3 * interval '1 hour'\nselect interval '1 day' + timestamp '2026-11-11', interval '1 hour' + time '10:00'\nselect timestamp '2026-11-11 10:00' + '1 day'\nselect timestamp '2026-11-11 10:00' - '1 day'\nselect date '2026-03-31' - interval '1 month', timestamp '2026-03-31' - interval '1 month'\nselect date '2026-11-11' < date '2026-11-12', date '2026-11-11' = timestamp '2026-11-11 00:00', date '2026-11-11' < timestamp '2026-11-11 00:00:01', timestamp '2026-11-11 10:00' = timestamptz '2026-11-11 10:00+00'\nselect date '2026-11-11' > '2026-01-01', timestamp '2026-11-11' between '2026-01-01' and '2027-01-01', interval '1 day' > '23 hours'\nselect date 'infinity' > date '5874897-12-31', timestamp '-infinity' < timestamp '4714-11-24 00:00 BC'\nselect greatest(date '2026-01-01', date '2026-11-11'), least(timestamp '2026-01-01', timestamp '2025-01-01')\nselect extract(year from date '2026-11-11'), extract(month from date '2026-11-11'), extract(day from date '2026-11-11'), extract(dow from date '2026-11-11'), extract(isodow from date '2026-11-15'), extract(doy from date '2026-11-11')\nselect extract(week from date '2026-01-01'), extract(week from date '2027-01-01'), extract(isoyear from date '2027-01-01'), extract(quarter from date '2026-11-11')\nselect extract(hour from timestamp '2026-11-11 10:20:30.5'), extract(minute from timestamp '2026-11-11 10:20:30.5'), extract(second from timestamp '2026-11-11 10:20:30.5'), extract(millisecond from timestamp '2026-11-11 10:20:30.5'), extract(microsecond from timestamp '2026-11-11 10:20:30.5')\nselect extract(epoch from timestamptz '2026-11-11 10:20:30.5+00'), extract(epoch from timestamp '1970-01-02'), extract(epoch from date '2000-01-01')\nselect extract(century from date '2000-12-31'), extract(century from date '2001-01-01'), extract(millennium from date '2001-01-01'), extract(decade from date '2026-11-11'), extract(year from date '0044-03-15 BC'), extract(century from date '0044-03-15 BC')\nselect extract(epoch from interval '1 day 02:00'), extract(epoch from interval '1 month'), extract(epoch from interval '1 year'), extract(hour from interval '1 day 26:30'), extract(day from interval '40 days'), extract(month from interval '14 months'), extract(year from interval '14 months')\nselect date_part('year', timestamp '2026-11-11'), date_part('minute', time '10:20:30'), extract(julian from date '2026-11-11')\nselect extract(fortnight from date '2026-11-11')\nselect date_trunc('month', timestamp '2026-11-11 10:20:30'), date_trunc('year', timestamp '2026-11-11 10:20:30'), date_trunc('hour', timestamp '2026-11-11 10:20:30'), date_trunc('week', timestamp '2026-11-11 10:20:30'), date_trunc('quarter', timestamp '2026-11-11')\nselect date_trunc('day', timestamptz '2026-11-11 10:20:30+05'), date_trunc('minute', timestamptz '2026-11-11 10:20:30.5+00'), date_trunc('day', date '2026-11-11'), date_trunc('century', timestamp '2026-11-11'), date_trunc('millennium', timestamp '2026-11-11'), date_trunc('decade', timestamp '2026-11-11')\nselect date_trunc('hour', interval '1 day 02:30:40'), date_trunc('month', interval '1 year 2 months 3 days')\nselect age(timestamp '2026-11-11', timestamp '2000-02-29'), age(timestamp '2026-03-01', timestamp '2026-01-31'), age(timestamp '2026-01-31', timestamp '2026-03-01'), age(timestamp '2026-11-11 10:00', timestamp '2026-11-10 12:00')\nselect age(date '2026-11-11', date '1966-05-20'), age(timestamp '2024-02-29', timestamp '2023-02-28')\nselect make_date(2026, 11, 11), make_date(-44, 3, 15), to_timestamp(0), to_timestamp(1762856430.5), isfinite(date 'infinity'), isfinite(timestamp '2026-11-11')\nselect make_date(2026, 2, 30)\nselect date_trunc('day', now()) <= now(), now() > timestamptz '2026-01-01', current_date >= date '2026-11-11', localtimestamp > timestamp '2026-01-01', current_timestamp = now() or current_timestamp > now()\ncreate table ev (id int primary key, d date, t time, ts timestamp, tz timestamptz, iv interval)\ninsert into ev values (1, '2026-11-11', '10:20', '2026-11-11 10:20:30.5', '2026-11-11 10:20:30+02', '1 day'), (2, '1066-10-14', '23:59:59.999999', '1215-06-15 09:30', '2000-01-01 00:00Z', '-1 year 2 days'), (3, '0044-03-15 BC', '00:00', '0044-03-15 12:00 BC', '1969-12-31 23:59:59.5+00', '36 hours'), (4, null, null, null, null, null), (5, 'infinity', '12:00', '-infinity', 'infinity', '1 month')\nselect * from ev order by id\nselect id from ev order by d, id\nselect id from ev order by ts desc nulls last\nselect id from ev order by iv, id\nselect min(d), max(d), min(ts), max(tz), min(iv), max(iv), count(d) from ev\nselect id, d + 1, ts + interval '1 hour', tz - interval '1 day', iv * 2 from ev where id < 4 order by id\nselect id from ev where d < date '2000-01-01' order by id\nselect id from ev where tz > '1999-01-01' order by id\ncreate index ev_ts on ev (ts)\nselect id from ev where ts >= timestamp '1000-01-01' order by ts\ncreate table days (d date primary key, n int)\ninsert into days select date '2026-01-01' + i, i from generate_series(0, 9) i\nselect d, n from days where d between '2026-01-03' and '2026-01-05' order by d\nselect d, n from days order by d desc limit 2\nselect extract(dow from d) dw, count(*) from days group by dw order by dw\nupdate ev set ts = ts + interval '1 day' where id = 1\nselect ts from ev where id = 1\ncreate table rnd (id int primary key, ts timestamp(0), t time(2), tz timestamptz(3))\ninsert into rnd values (1, '2026-11-11 10:20:30.5', '10:20:30.125', '2026-11-11 10:20:30.12345+00'), (2, '2026-11-11 10:20:30.4999', '10:20:30.124', '2026-11-11 10:20:30.0005+00')\nselect * from rnd order by id\nselect extract(julian from timestamp '2026-11-11 10:20'), extract(epoch from interval '14 months'), interval '1 month' / 3, interval '1 day' / 7, interval '1 month 1 day' * 0.3\nselect extract(second from date '2026-11-11')\nbegin\nselect now() = current_timestamp, now() = transaction_timestamp(), clock_timestamp() >= now()\ncommit"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(r.tag, "SELECT") { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(76), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
