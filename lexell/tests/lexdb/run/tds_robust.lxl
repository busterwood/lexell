// lexdb over TDS: the wrong answers and gaps the user documentation found in the SQL Server door (KNOWN-ISSUES.md, robustness slice), checked
// against SQL Server 2022 (generated by tests/lexdb/gen_mssql.py robust from mssql_robust_queries.txt): an UPDATE's subqueries reading the
// rows as the statement found them, LOG(x, base), tinyint's range (220, 244), char(n) and nchar(n) padded, datetime + days and datetime - datetime
// (206 for date and datetime2), FORMAT with a culture (dates, times, numbers), 0x literals as varbinary (their arithmetic, comparisons, casts,
// CONVERT styles, SUBSTRING, LEFT, RIGHT, assignment to int, varchar, binary and varbinary columns), DROP SEQUENCE under a default (3729), a second
// PRIMARY KEY by ALTER TABLE (1779), two CLUSTERED keys (8112, 1902), OBJECTPROPERTY's TableHas... Each batch runs with SET lexdb_batch off and
// on; each expect line: "same: " and the batch's result sets and counts, or its error number.
// expect: ok
// expect: (4)
// expect: same: (3) / id,salary: 1|100;2|101;3|201;4|301
// expect: same: (3) / id,salary: 1|100;2|101;3|201;4|301
// expect: same: (4) / id,salary: 1|103;2|202;3|301;4|400
// expect: same: (4) / (4) / id,salary: 1|5;2|5;3|5;4|5
// expect: same: (2) / id: 1;4
// expect: same: id,salary: 2|101;3|201;4|301
// expect: same: a,b,c,d,e: 2|3|2.302585092994046|2|0
// expect: same: a,b: NULL|NULL
// expect: same: error 220
// expect: same: error 220
// expect: same: a,b,c: 255|12|0
// expect: same: a,b,c: NULL|NULL|100
// expect: same: error 244
// expect: same: error 220
// expect: same: (1) / a,b,c: 300|400|-1
// expect: same: a,b: 27|440
// expect: ok
// expect: same: (1) / a: 255
// expect: same: error 220
// expect: same: error 220
// expect: same: error 220
// expect: same: (1) / (1) / a: 199
// expect: same: (1) / b,bb,lb,cc,dd: 'ab   '|'[ab   ]'|2|'[xy  ]'|'[cd]'
// expect: same: a,b,c,d: '[ab   ]'|'[ab  ]'|'[ab]'|'[abc]'
// expect: same: (1) / a,c: '[ab   ]'|2
// expect: same: error 2628
// expect: same: a,b,c,d: '2026-03-16 10:00:00.000'|'2026-03-14 10:00:00.000'|'2026-03-16 22:00:00.000'|'2026-03-16 10:00:00.000'
// expect: same: a,b: '1900-01-02 05:30:00.000'|'1900-01-01 00:00:00.000'
// expect: same: (1) / a,b,c,d,f: '2026-03-16 10:00:00.000'|'2026-03-14 10:00:00.000'|'2026-03-15 16:00:00.000'|'1900-01-01 00:00:00.000'|3
// expect: same: error 206
// expect: same: error 206
// expect: same: error 206
// expect: same: a: '2026-03-16 10:00:00'
// expect: same: a,b,c,d,e,g: '05.03.2026'|'Donnerstag, 5. März 2026'|'Donnerstag, 5. März 2026 14:07'|'05.03.2026 14:07:09'|'5. März'|'März 2026'
// expect: same: a,b,c,d,e: 'Donnerstag, 5. März 2026'|'Do Mrz'|'05.03.26 14:07'|'mars'|'jueves'
// expect: same: a,b,c,d,e,f,g,h: '05/03/2026'|'jeudi 5 mars 2026'|'jueves, 5 de marzo de 2026'|'giovedì 5 marzo 2026'|'05/03/2026'|'05 March 2026'|'2026/03/05'|'2026年3月5日'
// expect: same: a,b,c,d,e,f,g: '9:05'|'9:05:03 AM'|'9:05:03 PM'|'25-11-2026 21:05'|'午前 9'|'den 25 november 2026'|'quarta-feira, 25 de novembro de 2026'
// expect: same: a,b,c: '05.03.2026'|'Donnerstag, 5. März 2026'|'Thursday, March 5, 2026'
