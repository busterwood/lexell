const QUERIES = "@once CREATE TABLE emp (id int PRIMARY KEY, mgr_id int, salary int)\n@once INSERT INTO emp VALUES (1, NULL, 100), (2, 1, 200), (3, 2, 300), (4, 3, 400)\nBEGIN TRAN; UPDATE e SET salary = (SELECT x.salary + 1 FROM emp x WHERE x.id = e.mgr_id) FROM emp e WHERE mgr_id IS NOT NULL; SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE emp SET salary = (SELECT x.salary + 1 FROM emp x WHERE x.id = emp.mgr_id + 0) WHERE mgr_id IS NOT NULL; SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE emp SET salary = salary + (SELECT COUNT(*) FROM emp x WHERE x.salary > emp.salary); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE emp SET salary = 1; UPDATE emp SET salary = salary + (SELECT COUNT(*) FROM emp x WHERE x.salary = 1); SELECT id, salary FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; DELETE e FROM emp e WHERE EXISTS (SELECT 1 FROM emp x WHERE x.mgr_id = e.id) AND salary > (SELECT MIN(salary) FROM emp); SELECT id FROM emp ORDER BY id; ROLLBACK\nBEGIN TRAN; UPDATE emp SET salary = (SELECT x.salary + 1 FROM emp x WHERE x.id = emp.mgr_id) OUTPUT inserted.id, inserted.salary WHERE mgr_id IS NOT NULL; ROLLBACK\nSELECT LOG(100, 10) AS a, LOG(8, 2) AS b, LOG(10) AS c, LOG(100.0, 10) AS d, LOG(1, 10) AS e\nSELECT LOG(NULL, 10) AS a, LOG(100, NULL) AS b\nSELECT CAST(256 AS tinyint) AS a\nSELECT CAST(-1 AS tinyint) AS a\nSELECT CAST(255 AS tinyint) AS a, CAST(12.9 AS tinyint) AS b, CAST(0 AS tinyint) AS c\nSELECT TRY_CAST(300 AS tinyint) AS a, TRY_CAST(-1 AS tinyint) AS b, TRY_CAST(100 AS tinyint) AS c\nSELECT CAST('300' AS tinyint) AS a\nDECLARE @t tinyint = 200; SET @t = @t + 100\nDECLARE @t tinyint = 200; SELECT @t + 100 AS a, @t * 2 AS b, @t - 201 AS c\nSELECT CAST(220 AS tinyint) / 8 AS a, CAST(220 AS tinyint) * 2 AS b\n@once CREATE TABLE ty (a tinyint, b char(5), c nchar(4), d varchar(5), e datetime, f binary(4), g varbinary(3))\nBEGIN TRAN; INSERT INTO ty (a) VALUES (255); SELECT a FROM ty; ROLLBACK\nBEGIN TRAN; INSERT INTO ty (a) VALUES (256); ROLLBACK\nBEGIN TRAN; INSERT INTO ty (a) VALUES (-1); ROLLBACK\nBEGIN TRAN; INSERT INTO ty (a) VALUES (200); UPDATE ty SET a = a + 100; ROLLBACK\nBEGIN TRAN; INSERT INTO ty (a) VALUES (200); UPDATE ty SET a = a - 1; SELECT a FROM ty; ROLLBACK\nBEGIN TRAN; INSERT INTO ty (b, c, d) VALUES ('ab', N'xy', 'cd'); SELECT b, '[' + b + ']' AS bb, LEN(b) AS lb, '[' + c + ']' AS cc, '[' + d + ']' AS dd FROM ty; ROLLBACK\nSELECT '[' + CAST('ab' AS char(5)) + ']' AS a, '[' + CAST('ab' AS nchar(4)) + ']' AS b, '[' + CAST('ab' AS varchar(5)) + ']' AS c, '[' + CAST('abcdefg' AS char(3)) + ']' AS d\nDECLARE @c char(5) = 'ab'; SELECT '[' + @c + ']' AS a, LEN(@c) AS c\nBEGIN TRAN; INSERT INTO ty (b) VALUES ('abcdef'); ROLLBACK\nSELECT CAST('2026-03-15 10:00:00' AS datetime) + 1 AS a, CAST('2026-03-15 10:00:00' AS datetime) - 1 AS b, CAST('2026-03-15 10:00:00' AS datetime) + 1.5 AS c, 1 + CAST('2026-03-15 10:00:00' AS datetime) AS d\nSELECT CAST('2026-03-15 10:00:00' AS datetime) - CAST('2026-03-14 04:30:00' AS datetime) AS a, CAST('2026-03-15' AS datetime) - CAST('2026-03-15' AS datetime) AS b\nBEGIN TRAN; INSERT INTO ty (e) VALUES ('2026-03-15 10:00:00'); SELECT e + 1 AS a, e - 1 AS b, e + 0.25 AS c, e - e AS d, DATEDIFF(day, e - 3, e) AS f FROM ty; ROLLBACK\nSELECT CAST('2026-03-15' AS date) + 1 AS a\nSELECT CAST('2026-03-15 10:00:00' AS datetime2) + 1 AS a\nSELECT CAST('2026-03-15 10:00:00' AS datetime2) - 1 AS a\nSELECT CAST('2026-03-15 10:00:00' AS smalldatetime) + 1 AS a\nSELECT FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'd', 'de-DE') AS a, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'D', 'de-DE') AS b, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'f', 'de-DE') AS c, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'G', 'de-DE') AS d, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'M', 'de-DE') AS e, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'Y', 'de-DE') AS g\nSELECT FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'dddd, d. MMMM yyyy', 'de-DE') AS a, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'ddd MMM', 'de-DE') AS b, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'dd/MM/yy HH:mm', 'de-DE') AS c, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'MMMM', 'fr-FR') AS d, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'dddd', 'es-ES') AS e\nSELECT FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'd', 'fr-FR') AS a, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'D', 'fr-FR') AS b, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'D', 'es-ES') AS c, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'D', 'it-IT') AS d, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'd', 'en-GB') AS e, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'D', 'en-GB') AS f, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'd', 'ja-JP') AS g, FORMAT(CAST('2026-03-05 14:07:09' AS datetime), 'D', 'ja-JP') AS h\nSELECT FORMAT(CAST('2026-11-25 09:05:03' AS datetime), 't', 'es-ES') AS a, FORMAT(CAST('2026-11-25 09:05:03' AS datetime), 'T', 'en-US') AS b, FORMAT(CAST('2026-11-25 21:05:03' AS datetime), 'T', 'en-US') AS c, FORMAT(CAST('2026-11-25 21:05:03' AS datetime), 'g', 'nl-NL') AS d, FORMAT(CAST('2026-11-25 09:05:03' AS datetime), 'tt h', 'ja-JP') AS e, FORMAT(CAST('2026-11-25 09:05:03' AS datetime), 'D', 'sv-SE') AS f, FORMAT(CAST('2026-11-25 09:05:03' AS datetime), 'D', 'pt-BR') AS g\nSELECT FORMAT(CAST('2026-03-05' AS date), 'd', 'de-DE') AS a, FORMAT(CAST('2026-03-05' AS date), 'D', 'de-DE') AS b, FORMAT(CAST('2026-03-05' AS date), 'D') AS c\nSELECT FORMAT(CAST('14:07:09' AS time), 'T', 'de-DE') AS a, FORMAT(CAST('14:07:09' AS time), 'T') AS b, FORMAT(CAST('14:07:09.5' AS time), 'c') AS c, FORMAT(CAST('04:07:09' AS time), 'g') AS d, FORMAT(CAST('14:07:09' AS time), 'hh\\:mm') AS e, FORMAT(CAST('14:07:09' AS time), 'hh:mm') AS f, FORMAT(CAST('14:07:09' AS time), 'd') AS g\nSELECT FORMAT(1234567.891, 'N2', 'de-DE') AS a, FORMAT(1234567.891, 'C', 'de-DE') AS b, FORMAT(0.256, 'P', 'de-DE') AS c, FORMAT(1234567.891, 'N2', 'en-US') AS d\nSELECT 0x4142 AS a, 0xFF AS b, DATALENGTH(0x4142) AS c, LEN(0x4142) AS d, DATALENGTH(0x) AS e\nSELECT 0x4142 + 1 AS a, 0x10 * 2 AS b, 1 + 0x10 AS c, 0xFF / 2 AS d, 0x10 % 3 AS e, 0x10 | 1 AS f, 0xF0 & 0x3C AS g\nSELECT 0x4142 + 0x43 AS a, 0x41 + 0x4243 AS b\nSELECT 0x4142 - 0x4140 AS a\nSELECT 'a' + 0x41 AS a\nSELECT 0x4142 * 2.5 AS a\nSELECT CASE WHEN 0x4142 = 16706 THEN 1 ELSE 0 END AS a, CASE WHEN 0x4142 = 0x4142 THEN 1 ELSE 0 END AS b, CASE WHEN 0x41 < 0x42 THEN 1 ELSE 0 END AS c, CASE WHEN 0x4142 = 'AB' THEN 1 ELSE 0 END AS d, CASE WHEN 0x41 = 'A' THEN 1 ELSE 0 END AS e, CASE WHEN 0x4142 > 0x41 THEN 1 ELSE 0 END AS f\nSELECT CAST(0x4142 AS varbinary(10)) AS a, CAST(0x4142 AS int) AS b, CAST(0x4142 AS varchar(10)) AS c, CAST(0x4142 AS bigint) AS d, CAST(0x41 AS varchar(5)) AS e, CAST(0x0100 AS smallint) AS g\nSELECT CONVERT(varchar(10), 0x4142, 1) AS a, CONVERT(varchar(10), 0x4142, 2) AS b, CONVERT(varchar(10), 0x4142) AS c, CONVERT(varbinary(10), '4142', 2) AS d, CONVERT(varbinary(10), '0x4142', 1) AS e, CONVERT(varbinary(10), 'AB') AS f\nSELECT CAST(0x4142 AS binary(4)) AS a, CAST(0x414243 AS binary(2)) AS b, CAST(0x4142 AS varbinary(1)) AS c, CAST(16 AS varbinary(4)) AS d, CAST('AB' AS varbinary(10)) AS e, CAST(65 AS varbinary(2)) AS f\nSELECT SUBSTRING(0x41424344, 2, 2) AS a, LEFT(0x41424344, 2) AS b, RIGHT(0x41424344, 2) AS c, SUBSTRING(0x41424344, 3, 10) AS d, SUBSTRING(0x41424344, 0, 3) AS e\nSELECT 0x7FFFFFFF + 1 AS a\nSELECT 0xFFFFFFFF + 1 AS a\nBEGIN TRAN; INSERT INTO ty (a, b, f, g) VALUES (0x10, 'x', 0x41, 0x4142); SELECT a, f, g, DATALENGTH(f) AS df, DATALENGTH(g) AS dg FROM ty; ROLLBACK\nBEGIN TRAN; INSERT INTO ty (g) VALUES (0x41424344); ROLLBACK\nBEGIN TRAN; INSERT INTO ty (f, g) VALUES (0x4142, 0x4142); SELECT f, g FROM ty WHERE g = 0x4142; ROLLBACK\nBEGIN TRAN; INSERT INTO ty (d, a) VALUES (0x4142, 0x41); SELECT d, a FROM ty; ROLLBACK\n@once CREATE SEQUENCE sq\n@once CREATE TABLE sqt (id int NOT NULL DEFAULT (NEXT VALUE FOR sq), v int)\nDROP SEQUENCE sq\n@once CREATE TABLE pk2 (id int NOT NULL, v int NOT NULL)\n@once ALTER TABLE pk2 ADD CONSTRAINT pk2a PRIMARY KEY (id)\nALTER TABLE pk2 ADD CONSTRAINT pk2b PRIMARY KEY (v)\nCREATE TABLE cl2 (a int PRIMARY KEY CLUSTERED, b int UNIQUE CLUSTERED)\nDROP TABLE IF EXISTS cl3; CREATE TABLE cl3 (a int NOT NULL PRIMARY KEY NONCLUSTERED, b int, CONSTRAINT k3 UNIQUE CLUSTERED (b)); SELECT type_desc, is_primary_key, is_unique_constraint FROM sys.indexes WHERE object_id = OBJECT_ID('cl3') ORDER BY type_desc\nDROP TABLE IF EXISTS cl4; CREATE TABLE cl4 (a int NOT NULL PRIMARY KEY CLUSTERED, b int, CONSTRAINT k4 UNIQUE NONCLUSTERED (b)); SELECT type_desc, is_primary_key, is_unique_constraint FROM sys.indexes WHERE object_id = OBJECT_ID('cl4') ORDER BY type_desc\n@once CREATE TABLE cl5 (a int NOT NULL PRIMARY KEY CLUSTERED, b int)\nALTER TABLE cl5 ADD CONSTRAINT u5 UNIQUE CLUSTERED (b)\nSELECT OBJECTPROPERTY(OBJECT_ID('cl3'), 'TableHasPrimaryKey') AS p, OBJECTPROPERTY(OBJECT_ID('cl3'), 'TableHasClustIndex') AS c, OBJECTPROPERTY(OBJECT_ID('cl3'), 'TableHasUniqueCnst') AS u, OBJECTPROPERTY(OBJECT_ID('cl3'), 'TableHasIndex') AS i\nSELECT OBJECTPROPERTY(OBJECT_ID('cl4'), 'TableHasPrimaryKey') AS p, OBJECTPROPERTY(OBJECT_ID('cl4'), 'TableHasClustIndex') AS c, OBJECTPROPERTY(OBJECT_ID('cl4'), 'TableHasUniqueCnst') AS u\nSELECT OBJECTPROPERTY(OBJECT_ID('ty'), 'TableHasPrimaryKey') AS p, OBJECTPROPERTY(OBJECT_ID('ty'), 'TableHasClustIndex') AS c, OBJECTPROPERTY(OBJECT_ID('ty'), 'TableHasUniqueCnst') AS u, OBJECTPROPERTY(OBJECT_ID('ty'), 'TableHasIndex') AS i\nSELECT OBJECTPROPERTY(OBJECT_ID('emp'), 'TableHasPrimaryKey') AS p, OBJECTPROPERTY(OBJECT_ID('emp'), 'TableHasClustIndex') AS c"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(55), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
