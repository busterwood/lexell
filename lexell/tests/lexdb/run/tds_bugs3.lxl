// expect: same: g,mn,mx,n: 1|'2026-03-15 10:00:00 +02:00'|'2026-03-15 10:00:00 +02:00'|3;2|'2026-03-15 07:00:00 +00:00'|'2026-03-15 07:00:00 +00:00'|2;3|NULL|NULL|0
// expect: same: mn,mx: '2026-03-15 07:00:00 +00:00'|'2026-03-15 10:00:00 +02:00'
// expect: same: mn,mx: '2026-03-15 10:00:00.125 +02:00'|'2026-03-15 10:00:00.125 +02:00'
// expect: same: mn,mx: NULL|NULL
// expect: same: id,mn,mx: 1|'2026-03-15 10:00:00 +02:00'|'2026-03-15 10:00:00 +02:00';2|'2026-03-15 10:00:00 +02:00'|'2026-03-15 10:00:00 +02:00';3|'2026-03-15 10:00:00 +02:00'|'2026-03-15 10:00:00 +02:00';4|'2026-03-15 07:00:00 +00:00'|'2026-03-15 07:00:00 +00:00';5|'2026-03-15 07:00:00 +00:00'|'2026-03-15 07:00:00 +00:00';6|'2026-03-15 07:00:00 +00:00'|'2026-03-15 07:00:00 +00:00';7|NULL|NULL
// expect: same: mn,mx: '2026-03-15 13:30:00.0000000 +05:30'|'2026-03-15 13:30:00.0000000 +05:30'
// expect: same: mn: '2026-03-15 13:30:00.0000000 +05:30'
// expect: same: id,a,b,c: 1|'2026-03-15 13:00:00 +05:00'|'2026-03-15 13:00:00.125 +05:00'|'2026-03-15 04:30:00.1250000 -03:30';2|NULL|NULL|NULL
// expect: same: a: '2026-03-15 09:00:00.00 +01:00'
// expect: same: id,a,b,c: 1|'2026-03-15 10:00:00.12 +01:00'|'2026-03-15 10:00:00 +01:00'|'2026-03-15 10:00:00.125 +01:00';2|NULL|NULL|NULL
// expect: same: id,a,b,c,d: 1|'2026-03-15 08:00:00 +00:00'|'2026-03-15 01:00:00.125 -07:00'|'2026-03-15 10:00:00.12 +00:00'|'2026-03-15 10:00:00 +09:00';2|NULL|NULL|NULL|NULL
// expect: same: a,b,c: '2026-03-15 10:00:00 +02:00'|'2026-03-15 10:00:00.125 +02:00'|'2026-03-15 10:00:00.1250000 +02:00'
// expect: same: a: '2026-03-15 10:00:00 +02:00';NULL
