// expect: ok
// expect: same: constraint_name,check_clause: 'k0'|'([b]>(0))';'k1'|'([a]>=(1) AND [a]<=(10) OR [a] IS NULL)';'k10'|'(([a]*(2)-[b]/(3))>=(0))';'k12'|'(NOT ([a]=(4) OR [a]=(3)) AND NOT ([a]>=(50) AND [a]<=(60)))';'k13'|'(case when [a]>(1) then (1) else (0) end=(1))';'k14'|'([a]>(2))';'k16'|'(([a]=(1) OR [a]=(2)) AND [b]=(1))';'k17'|'([a]=(7))';'k18'|'(([a]-([b]-(1)))>(0) AND [a]/([b]*(2))<(5))';'k19'|'(coalesce([f],(0))>=(0) AND abs([g])<(10))';'k2'|'([c]=''z'' OR [c]=''y'' OR [c]=''x'')';'k3'|'([a]>=(1) AND [a]<=(100))';'k4'|'([c] like ''a%'' OR NOT [c] like ''%z'')';'k5'|'(len([c])>(2) AND upper([c])<>''ABC'')';'k6'|'([d]>=''2020-01-01'')';'k7'|'([e]<>(-1.5) AND [e]<(100))';'k8'|'(NOT [a]=(5))';'k9'|'([f] IS NOT NULL AND [g]<>([f]+(1)))'
// expect: same: name,definition: 'k0'|'([b]>(0))';'k1'|'([a]>=(1) AND [a]<=(10) OR [a] IS NULL)';'k10'|'(([a]*(2)-[b]/(3))>=(0))';'k12'|'(NOT ([a]=(4) OR [a]=(3)) AND NOT ([a]>=(50) AND [a]<=(60)))';'k13'|'(case when [a]>(1) then (1) else (0) end=(1))';'k14'|'([a]>(2))';'k16'|'(([a]=(1) OR [a]=(2)) AND [b]=(1))';'k17'|'([a]=(7))';'k18'|'(([a]-([b]-(1)))>(0) AND [a]/([b]*(2))<(5))';'k19'|'(coalesce([f],(0))>=(0) AND abs([g])<(10))';'k2'|'([c]=''z'' OR [c]=''y'' OR [c]=''x'')';'k3'|'([a]>=(1) AND [a]<=(100))';'k4'|'([c] like ''a%'' OR NOT [c] like ''%z'')';'k5'|'(len([c])>(2) AND upper([c])<>''ABC'')';'k6'|'([d]>=''2020-01-01'')';'k7'|'([e]<>(-1.5) AND [e]<(100))';'k8'|'(NOT [a]=(5))';'k9'|'([f] IS NOT NULL AND [g]<>([f]+(1)))'
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once CREATE TABLE b3m (id int PRIMARY KEY, g int, t datetimeoffset(0), p datetimeoffset(3))\n@once INSERT INTO b3m VALUES (1, 1, '2026-03-15 10:00:00 +02:00', '2026-03-15 10:00:00.125 +02:00'), (2, 1, '2026-03-15 08:00:00 +00:00', '2026-03-15 08:00:00.125 +00:00'), (3, 1, '2026-03-15 13:30:00 +05:30', NULL), (4, 2, '2026-03-15 07:00:00 +00:00', NULL), (5, 2, '2026-03-15 09:00:00 +02:00', NULL), (6, 2, NULL, NULL), (7, 3, NULL, NULL)\n@once CREATE TABLE b3h (k varchar(10), t datetimeoffset)\n@once INSERT INTO b3h VALUES ('x', '2026-03-15 13:30:00 +05:30'), ('y', '2026-03-15 10:00:00 +02:00'), ('x', '2026-03-15 08:00:00 +00:00'), ('y', '2026-03-15 12:00:00 +04:00')\n@once CREATE TABLE b6 (id int PRIMARY KEY, t0 datetimeoffset(0), t3 datetimeoffset(3), t7 datetimeoffset, d2 datetime2(2), d0 datetime2(0))\n@once INSERT INTO b6 VALUES (1, '2026-03-15 10:00:00 +02:00', '2026-03-15 10:00:00.125 +02:00', '2026-03-15 10:00:00.125 +02:00', '2026-03-15 10:00:00.12', '2026-03-15 10:00:00'), (2, NULL, NULL, NULL, NULL, NULL)\nSELECT MIN(t) AS mn, MAX(t) AS mx FROM b3m WHERE g = 1\nSELECT g, MIN(t) AS mn, MAX(t) AS mx, COUNT(t) AS n FROM b3m GROUP BY g ORDER BY g\nSELECT MIN(t) AS mn, MAX(t) AS mx FROM b3m\nSELECT MIN(p) AS mn, MAX(p) AS mx FROM b3m\nSELECT MIN(t) AS mn, MAX(t) AS mx FROM b3m WHERE id > 100\nSELECT id, MIN(t) OVER (PARTITION BY g) AS mn, MAX(t) OVER (PARTITION BY g) AS mx FROM b3m ORDER BY id\nSELECT MIN(t) AS mn, MAX(t) AS mx FROM b3h\nSELECT CAST(MIN(t) AS varchar(40)) AS mn FROM b3h\nSELECT id, SWITCHOFFSET(t0, '+05:00') AS a, SWITCHOFFSET(t3, '+05:00') AS b, SWITCHOFFSET(t7, '-03:30') AS c FROM b6 ORDER BY id\nSELECT SWITCHOFFSET(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset(2)), '+01:00') AS a\nSELECT id, TODATETIMEOFFSET(d2, '+01:00') AS a, TODATETIMEOFFSET(d0, 60) AS b, TODATETIMEOFFSET(t3, '+01:00') AS c FROM b6 ORDER BY id\nSELECT id, t0 AT TIME ZONE 'UTC' AS a, t3 AT TIME ZONE 'Pacific Standard Time' AS b, d2 AT TIME ZONE 'UTC' AS c, d0 AT TIME ZONE 'Tokyo Standard Time' AS d FROM b6 ORDER BY id\nSELECT MIN(t0) AS a, MAX(t3) AS b, MIN(t7) AS c FROM b6\nSELECT MAX(t0) AS a FROM b6 GROUP BY id ORDER BY id\nSELECT MAX(SWITCHOFFSET(t3, '+01:00')) AS a FROM b6\n@once CREATE TABLE b7s (x int)\n@once INSERT INTO b7s VALUES (1), (2), (NULL)\nSELECT 1 AS x INTO b7a; DROP TABLE b7a\nSELECT x INTO b7b FROM b7s WHERE x = 0; DROP TABLE b7b\nSELECT * INTO #t7 FROM b7s; SELECT COUNT(*) AS n FROM #t7; DROP TABLE #t7\nSELECT x INTO b7c FROM b7s; SELECT @@ROWCOUNT AS rc; DROP TABLE b7c\nSET NOCOUNT ON; SELECT x INTO b7c FROM b7s; SET NOCOUNT OFF; DROP TABLE b7c\nDECLARE @n int = 1; IF @n = 1 BEGIN SELECT x INTO b7c FROM b7s WHERE x > 1 END; DROP TABLE b7c\nBEGIN TRAN; SELECT x INTO b7d FROM b7s; ROLLBACK; SELECT OBJECT_ID('b7d') AS o\nSELECT FORMAT(1234.5, 'C', 'ja-JP') AS a, FORMAT(-1234.5, 'C', 'ja-JP') AS b, FORMAT(0.125, 'C', 'ja-JP') AS c, FORMAT(1234.5, 'C2', 'ja-JP') AS d\nSELECT FORMAT(1234.5, 'C', 'ko-KR') AS a, FORMAT(1234.5, 'C', 'id-ID') AS b, FORMAT(1234.5, 'C', 'es-CO') AS c, FORMAT(1234.5, 'C', 'ja') AS d, FORMAT(1234.5, 'C', 'ko') AS e\nSELECT FORMAT(1234.5, 'C', 'en-US') AS a, FORMAT(1234.5, 'C', 'de-DE') AS b, FORMAT(1234.5, 'C', 'zh-CN') AS c, FORMAT(1234.5, 'C0', 'en-US') AS d, FORMAT(1234.5, 'C3', 'ja-JP') AS e\nSELECT FORMAT(1234.5, 'N', 'ja-JP') AS a, FORMAT(0.5, 'P', 'ja-JP') AS b, FORMAT(CAST(1234.5 AS money), 'C', 'ja-JP') AS c, FORMAT(CAST(NULL AS decimal(5,1)), 'C', 'ja-JP') AS d\n@once CREATE TABLE b9 (a int, b int, c varchar(10), d date, e decimal(5,2), f int, g int, CONSTRAINT k0 CHECK (b > 0), CONSTRAINT k1 CHECK (a >= 1 AND a <= 10 OR a IS NULL), CONSTRAINT k2 CHECK (c IN ('x', 'y', 'z')), CONSTRAINT k3 CHECK (a BETWEEN 1 AND 100), CONSTRAINT k4 CHECK (c LIKE 'a%' OR c NOT LIKE '%z'), CONSTRAINT k5 CHECK (LEN(c) > 2 AND UPPER(c) <> 'ABC'), CONSTRAINT k6 CHECK (d >= '2020-01-01'), CONSTRAINT k7 CHECK (e <> -1.5 AND e < 100), CONSTRAINT k8 CHECK (NOT (a = 5)), CONSTRAINT k9 CHECK (f IS NOT NULL AND g <> f + 1), CONSTRAINT k10 CHECK (a * 2 - b / 3 >= 0), CONSTRAINT k12 CHECK (a NOT IN (3, 4) AND a NOT BETWEEN 50 AND 60), CONSTRAINT k13 CHECK (CASE WHEN a > 1 THEN 1 ELSE 0 END = 1), CONSTRAINT k14 CHECK ([a] > (2)), CONSTRAINT k16 CHECK ((a = 1 OR a = 2) AND b = 1), CONSTRAINT k17 CHECK (a IN (7)), CONSTRAINT k18 CHECK (a - (b - 1) > 0 AND a / (b * 2) < 5), CONSTRAINT k19 CHECK (COALESCE(f, 0) >= 0 AND ABS(g) < 10))\nSELECT constraint_name, check_clause FROM information_schema.check_constraints WHERE constraint_name LIKE 'k%' ORDER BY constraint_name\nSELECT name, definition FROM sys.check_constraints WHERE parent_object_id = OBJECT_ID('b9') ORDER BY name"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(74), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
