const QUERIES = "@once CREATE TABLE dt1 (id int PRIMARY KEY, t datetimeoffset, p datetimeoffset(3))\n@once INSERT INTO dt1 VALUES (1, '2026-03-15 10:00:00 +02:00', '2026-03-15 10:00:00.123 +02:00'), (2, '2026-03-15 08:00:00 +00:00', NULL), (3, '2026-03-15 03:00:00 -05:00', '2026-03-15 03:00:00.5 -05:30'), (4, '2026-03-15 12:00:00 +05:30', NULL), (5, NULL, NULL)\n@once CREATE TABLE dt2 (id int PRIMARY KEY, t datetimeoffset)\n@once INSERT INTO dt2 VALUES (1, '2026-03-15 11:00:00 +03:00'), (2, '2026-03-15 06:30:00 +00:00'), (3, '2026-03-16 00:00:00 +14:00')\n@once CREATE INDEX dt2_t ON dt2 (t)\nSELECT id, t, p FROM dt1 ORDER BY id\nSELECT id FROM dt1 ORDER BY t, id\nSELECT id FROM dt1 ORDER BY t DESC, id\nSELECT COUNT(*) AS n FROM (SELECT DISTINCT t FROM dt1) d\nSELECT COUNT(DISTINCT t) AS n FROM dt1\nSELECT COUNT(*) AS n FROM dt1 GROUP BY t ORDER BY n\nSELECT id FROM dt1 WHERE t = '2026-03-15 08:00:00 +00:00' ORDER BY id\nSELECT id FROM dt1 WHERE t = CAST('2026-03-15 11:00:00 +03:00' AS datetimeoffset) ORDER BY id\nSELECT id FROM dt1 WHERE t > '2026-03-15 07:30:00 +00:00' ORDER BY id\nSELECT id FROM dt1 WHERE t BETWEEN '2026-03-15 06:00:00 +00:00' AND '2026-03-15 08:00:00 +00:00' ORDER BY id\nSELECT id FROM dt1 WHERE t IN ('2026-03-15 08:00:00 +00:00', '2026-03-15 06:30:00 +00:00') ORDER BY id\nSELECT a.id AS x, b.id AS y FROM dt1 a JOIN dt1 b ON a.t = b.t AND a.id < b.id ORDER BY 1, 2\nSELECT a.id AS x, b.id AS y FROM dt1 a JOIN dt2 b ON a.t = b.t ORDER BY 1, 2\nSELECT id FROM dt2 WHERE t >= '2026-03-15 08:00:00 +00:00' ORDER BY id\nSELECT id FROM dt2 WHERE t = '2026-03-15 08:00:00 +02:00' ORDER BY id\nSELECT COUNT(*) AS n FROM dt1 WHERE t IS NULL\nSELECT id, DATEPART(tzoffset, t) AS a, DATEPART(tz, t) AS b, DATENAME(tzoffset, t) AS c FROM dt1 ORDER BY id\nSELECT id, DATEPART(hour, t) AS h, DATEPART(minute, t) AS m, DATEPART(day, t) AS d FROM dt1 WHERE id IN (1, 3, 4) ORDER BY id\nSELECT id, CAST(t AS datetime2) AS a, CAST(t AS date) AS b, CAST(t AS time) AS c FROM dt1 WHERE id IN (1, 3) ORDER BY id\nSELECT id, CAST(t AS varchar(40)) AS a FROM dt1 WHERE id IN (1, 3) ORDER BY id\nSELECT 'at ' + CAST(t AS varchar(40)) AS a FROM dt1 WHERE id = 4\nSELECT CAST(CAST('2026-03-15 10:00:00' AS datetime2) AS datetimeoffset) AS a, CAST(CAST('2026-03-15' AS date) AS datetimeoffset) AS b, CAST(CAST('2026-03-15 10:00:00' AS datetime) AS datetimeoffset) AS c\nSELECT CAST('2026-03-15 10:00:00.5 -05:30' AS datetimeoffset) AS a\nSELECT CAST('2026-03-15T10:00:00+02:00' AS datetimeoffset) AS a, CAST('2026-03-15 10:00:00Z' AS datetimeoffset) AS b, CAST('2026-03-15 10:00:00' AS datetimeoffset) AS c, CAST('2026-03-15 10:00:00 -00:30' AS datetimeoffset) AS d\nSELECT CAST('2026-03-15 10:00:00 +14:00' AS datetimeoffset) AS a, CAST('2026-03-15 10:00:00 -14:00' AS datetimeoffset) AS b\nSELECT CAST('2026-03-15 10:00:00 +15:00' AS datetimeoffset) AS a\nSELECT CAST('2026-03-15 10:00:00 +14:01' AS datetimeoffset) AS a\nSELECT CAST('nonsense' AS datetimeoffset) AS a\nSELECT CAST('2026-13-15 10:00:00 +02:00' AS datetimeoffset) AS a\nSELECT CAST('2026-03-15 10:00:00 +02' AS datetimeoffset) AS a\nSELECT TRY_CAST('nonsense' AS datetimeoffset) AS a, TRY_CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AS b, TRY_CONVERT(datetimeoffset, '2026-03-15 10:00:00 +20:00') AS c\nSELECT SWITCHOFFSET(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), '+05:00') AS a, SWITCHOFFSET(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), -300) AS b\nSELECT SWITCHOFFSET(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), '+05:30') AS a, SWITCHOFFSET(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), '-00:30') AS b\nSELECT SWITCHOFFSET(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), '+15:00') AS a\nSELECT SWITCHOFFSET(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 'x') AS a\nSELECT SWITCHOFFSET(NULL, '+01:00') AS a, SWITCHOFFSET(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), NULL) AS b\nSELECT SWITCHOFFSET(CAST('2026-03-15 10:00:00' AS datetime2), '+01:00') AS a\nSELECT TODATETIMEOFFSET(CAST('2026-03-15 10:00:00' AS datetime2), '+05:00') AS a, TODATETIMEOFFSET(CAST('2026-03-15 10:00:00' AS datetime2), 120) AS b, TODATETIMEOFFSET(CAST('2026-03-15 10:00:00' AS datetime2), -90) AS c\nSELECT TODATETIMEOFFSET(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), '+05:00') AS a, TODATETIMEOFFSET(CAST('2026-03-15' AS date), '+02:00') AS b\nSELECT TODATETIMEOFFSET(CAST('2026-03-15 10:00:00' AS datetime2), '+15:00') AS a\nSELECT TODATETIMEOFFSET(CAST('2026-03-15 10:00:00' AS datetime2), 'zz') AS a\nSELECT TODATETIMEOFFSET(CAST('2026-03-15 10:00:00' AS datetime2), NULL) AS a\nSELECT CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE 'UTC' AS a, CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE 'Pacific Standard Time' AS b, CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE 'India Standard Time' AS c\nSELECT CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE 'W. Europe Standard Time' AS a, CAST('2026-07-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE 'W. Europe Standard Time' AS b\nSELECT CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE 'Eastern Standard Time' AS a, CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE 'GMT Standard Time' AS b, CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE 'Tokyo Standard Time' AS c\nSELECT CAST('2026-03-15 10:00:00' AS datetime2) AT TIME ZONE 'Pacific Standard Time' AS a, CAST('2026-03-15 10:00:00' AS datetime2) AT TIME ZONE 'UTC' AT TIME ZONE 'India Standard Time' AS b\nSELECT CAST('2026-03-08 02:30:00' AS datetime2) AT TIME ZONE 'Eastern Standard Time' AS a, CAST('2026-11-01 01:30:00' AS datetime2) AT TIME ZONE 'Eastern Standard Time' AS b\nSELECT CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE 'Nowhere Time' AS a\nSELECT CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) AT TIME ZONE NULL AS a\nSELECT t AT TIME ZONE 'Pacific Standard Time' AS a FROM dt1 WHERE id = 3\nSELECT DATEADD(hour, 5, CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset)) AS a, DATEADD(month, 1, CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset)) AS b\nSELECT DATEADD(day, 1, t) AS a FROM dt1 WHERE id IN (1, 3, 4) ORDER BY id\nSELECT DATEDIFF(hour, CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), CAST('2026-03-15 10:00:00 +00:00' AS datetimeoffset)) AS a, DATEDIFF(day, CAST('2026-03-15 23:00:00 +02:00' AS datetimeoffset), CAST('2026-03-15 23:30:00 -05:00' AS datetimeoffset)) AS b\nSELECT DATEDIFF(minute, CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), CAST('2026-03-15 10:00:00 +03:00' AS datetimeoffset)) AS a, DATEDIFF(day, CAST('2026-03-15 00:30:00 +02:00' AS datetimeoffset), CAST('2026-03-15 00:30:00 +00:00' AS datetimeoffset)) AS b\nSELECT YEAR(CAST('2026-03-15 23:00:00 -05:00' AS datetimeoffset)) AS a, MONTH(CAST('2026-03-15 23:00:00 -05:00' AS datetimeoffset)) AS b, DAY(CAST('2026-03-15 23:00:00 -05:00' AS datetimeoffset)) AS c, EOMONTH(CAST('2026-03-15 23:00:00 -05:00' AS datetimeoffset)) AS d\nSELECT CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 126) AS a, CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 127) AS b\nSELECT CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 121) AS a, CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 120) AS b, CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 101) AS c\nSELECT CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 0) AS a, CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 100) AS b, CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 1) AS c, CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 23) AS d, CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 108) AS e, CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 111) AS f\nSELECT CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 9) AS a, CONVERT(varchar(40), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset), 13) AS b\nSELECT CONVERT(datetimeoffset, '2026-03-15T10:00:00+02:00', 127) AS a, CONVERT(datetimeoffset, '2026-03-15T10:00:00Z', 127) AS b\nSELECT COALESCE(CAST(NULL AS datetimeoffset), CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset)) AS a, ISNULL(CAST(NULL AS datetimeoffset), CAST('2026-03-15 10:00:00 -03:00' AS datetimeoffset)) AS b\nSELECT CASE WHEN 1 = 1 THEN CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) ELSE CAST('2026-03-15 10:00:00 +05:00' AS datetimeoffset) END AS a\nSELECT IIF(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) = CAST('2026-03-15 08:00:00 +00:00' AS datetimeoffset), 'eq', 'ne') AS a, IIF(CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) < CAST('2026-03-15 09:00:00 +00:00' AS datetimeoffset), 'lt', 'ge') AS b\nSELECT 1 AS a WHERE CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) = CAST('2026-03-15 08:00:00' AS datetime2)\nSELECT 1 AS a WHERE CAST('2026-03-15 10:00:00 +02:00' AS datetimeoffset) > CAST('2026-03-15 07:00:00' AS datetime)\nSELECT CAST('2026-03-15 10:00:00.9999999 +02:00' AS datetimeoffset(3)) AS a\nSELECT DATEPART(tzoffset, CAST('2026-03-15 10:00:00' AS datetime2)) AS a\nSELECT DATEPART(tzoffset, CAST('2026-03-15' AS date)) AS a\n@once UPDATE dt1 SET t = SWITCHOFFSET(t, '+09:00') WHERE id = 1\nSELECT id, t FROM dt1 ORDER BY id\n@once UPDATE dt1 SET t = DATEADD(hour, 1, t) WHERE id = 2\nSELECT id, t FROM dt1 ORDER BY id\n@once CREATE TABLE dt3 (id int PRIMARY KEY, t datetimeoffset)\n@once CREATE UNIQUE INDEX dt3_u ON dt3 (t)\n@once INSERT INTO dt3 VALUES (1, '2026-03-15 10:00:00 +02:00')\nINSERT INTO dt3 VALUES (2, '2026-03-15 08:00:00 +00:00')\n@once INSERT INTO dt3 VALUES (2, '2026-03-15 09:00:00 +02:00')\nSELECT id, t FROM dt3 ORDER BY id\n@once SELECT id, t INTO dt4 FROM dt1 WHERE id < 4\nSELECT id, DATEPART(tzoffset, t) AS z FROM dt4 ORDER BY id\n@once DROP TABLE dt1\n@once DROP TABLE dt2\n@once DROP TABLE dt3\n@once DROP TABLE dt4"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(72), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
