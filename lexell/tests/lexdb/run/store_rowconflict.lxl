// lexdb_store: conflicts per key, not per leaf (design/lexdb.md 9.19). A
// transaction's reads are key ranges; its commit fails only when a commit
// after a read wrote a key in its range. All in one leaf of 100 keys:
// - two transactions updating different rows: both commit;
// - the same row: the second fails;
// - a range scan, then another commit inserts into the range (a phantom):
//   fails; inserts at the range's end (exclusive): commits;
// - a scan its callback stops at k06: an insert before k06 conflicts, one
//   after it does not; the same backward (stopped at k94);
// - a read of a missing key, then that key inserted: fails; its neighbour:
//   commits;
// - a tree dropped after a read of it: fails;
// - a block (a snapshot): a write to a neighbouring row passes, to its row
//   fails;
// - a read older than the writes kept (setWriteLogMax): fails.
// expect: different rows: ok ok
// expect: same row: ok 40001
// expect: phantom in the range: 40001, at its end: ok
// expect: stopped scan: before the stop 40001, after it ok
// expect: stopped backward: after the stop 40001, before it ok
// expect: missing key: inserted 40001, its neighbour ok
// expect: dropped tree: 40001
// expect: block: neighbour ok, own row 40001
// expect: older than the log: 40001
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_base"

fn key(i: int): str { return "k" + strings.padLeft(i.toStr(), 2, '0') }

fn res(r: &Result[Unit, lexdb_base.DbErr]): str {
    match r {
        Ok(_) { return "ok" }
        Err(e) { return e.state }
    }
}

// a tree of keys k00, k02, ..., k98 (the odd ones missing)
fn fresh(st: &lexdb_store.Store): int {
    var t = lexdb_store.begin()
    let tree = st.createTree(mut &t)
    for i in 0..50 { t.put(tree, key(i * 2), "v").unwrap() }
    st.commit(t).unwrap()
    return tree
}

fn put1(st: &lexdb_store.Store, tree: int, k: str): str {
    var t = lexdb_store.begin()
    t.put(tree, k, "w").unwrap()
    let r = st.commit(t)
    return res(&r)
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(17), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 1024 * 1024, ckptBytes: 1024 * 1024, snapNodes: 100000, bufferedPages: false}, fn(st: lexdb_store.Store): int {
        var a = fresh(&st)
        // different rows, then the same row: read, then write what was read
        var t1 = lexdb_store.begin()
        var t2 = lexdb_store.begin()
        let r1 = st.get(mut &t1, a, key(10)).unwrap()
        let r2 = st.get(mut &t2, a, key(20)).unwrap()
        t1.put(a, key(10), "t1").unwrap()
        t2.put(a, key(20), "t2").unwrap()
        let c1 = st.commit(t1)
        let c2 = st.commit(t2)
        println("different rows: " + res(&c1) + " " + res(&c2))
        var t3 = lexdb_store.begin()
        var t4 = lexdb_store.begin()
        let r3 = st.get(mut &t3, a, key(30)).unwrap()
        let r4 = st.get(mut &t4, a, key(30)).unwrap()
        t3.put(a, key(30), "t3").unwrap()
        t4.put(a, key(30), "t4").unwrap()
        let c3 = st.commit(t3)
        let c4 = st.commit(t4)
        println("same row: " + res(&c3) + " " + res(&c4))

        // a range scan [k40, k50), then inserts by another commit
        var t5 = lexdb_store.begin()
        st.scan(mut &t5, a, key(40), key(50), fn(e: &lexdb_store.Entry): bool { return true }).unwrap()
        t5.put(a, key(90), "t5").unwrap()
        let p5 = put1(&st, a, key(45))
        let c5 = st.commit(t5)
        var t6 = lexdb_store.begin()
        st.scan(mut &t6, a, key(40), key(50), fn(e: &lexdb_store.Entry): bool { return true }).unwrap()
        t6.put(a, key(92), "t6").unwrap()
        let p6 = put1(&st, a, key(50))
        let c6 = st.commit(t6)
        println("phantom in the range: " + res(&c5) + ", at its end: " + res(&c6))

        // a scan stopped by its callback at k06 (the third key from k02)
        a = fresh(&st)
        var seen = 0
        var t7 = lexdb_store.begin()
        st.scan(mut &t7, a, key(2), "", fn(e: &lexdb_store.Entry): bool {
            seen += 1
            return seen < 3
        }).unwrap()
        t7.put(a, key(98), "t7").unwrap()
        let p7 = put1(&st, a, key(5))
        let c7 = st.commit(t7)
        var seen8 = 0
        var t8 = lexdb_store.begin()
        st.scan(mut &t8, a, key(2), "", fn(e: &lexdb_store.Entry): bool {
            seen8 += 1
            return seen8 < 3
        }).unwrap()
        t8.put(a, key(98), "t8").unwrap()
        let p8 = put1(&st, a, key(7))
        let c8 = st.commit(t8)
        println("stopped scan: before the stop " + res(&c7) + ", after it " + res(&c8))

        // backward from the end, stopped at k94 (the third key back)
        a = fresh(&st)
        var b9 = 0
        var t9 = lexdb_store.begin()
        st.scanBack(mut &t9, a, "", "", fn(e: &lexdb_store.Entry): bool {
            b9 += 1
            return b9 < 3
        }).unwrap()
        t9.put(a, key(0), "t9").unwrap()
        let p9 = put1(&st, a, key(95))
        let c9 = st.commit(t9)
        var b10 = 0
        var t10 = lexdb_store.begin()
        st.scanBack(mut &t10, a, "", "", fn(e: &lexdb_store.Entry): bool {
            b10 += 1
            return b10 < 3
        }).unwrap()
        t10.put(a, key(0), "t10").unwrap()
        let p10 = put1(&st, a, key(93))
        let c10 = st.commit(t10)
        println("stopped backward: after the stop " + res(&c9) + ", before it " + res(&c10))

        // a missing key read, then inserted; its neighbour
        a = fresh(&st)
        var t11 = lexdb_store.begin()
        let m11 = st.get(mut &t11, a, key(11)).unwrap()
        t11.put(a, key(80), "t11").unwrap()
        let p11 = put1(&st, a, key(11))
        let c11 = st.commit(t11)
        var t12 = lexdb_store.begin()
        let m12 = st.get(mut &t12, a, key(13)).unwrap()
        t12.put(a, key(82), "t12").unwrap()
        let p12 = put1(&st, a, key(15))
        let c12 = st.commit(t12)
        println("missing key: inserted " + res(&c11) + ", its neighbour " + res(&c12))

        // a tree dropped after a read of it
        let d = fresh(&st)
        let other = fresh(&st)
        var t13 = lexdb_store.begin()
        let r13 = st.get(mut &t13, d, key(10)).unwrap()
        t13.put(other, key(10), "t13").unwrap()
        var dt = lexdb_store.begin()
        dt.dropTree(d)
        st.commit(dt).unwrap()
        let c13 = st.commit(t13)
        println("dropped tree: " + res(&c13))

        // a block reads its snapshot
        a = fresh(&st)
        var b14 = st.beginBlock().unwrap()
        let r14 = st.get(mut &b14, a, key(40)).unwrap()
        let p14 = put1(&st, a, key(42))
        b14.put(a, key(40), "b14").unwrap()
        let c14 = st.commit(b14)
        var b15 = st.beginBlock().unwrap()
        let r15 = st.get(mut &b15, a, key(60)).unwrap()
        let p15 = put1(&st, a, key(60))
        b15.put(a, key(60), "b15").unwrap()
        let c15 = st.commit(b15)
        println("block: neighbour " + res(&c14) + ", own row " + res(&c15))

        // a read older than the writes kept
        lexdb_store.setWriteLogMax(64)
        a = fresh(&st)
        var t16 = lexdb_store.begin()
        let r16 = st.get(mut &t16, a, key(10)).unwrap()
        for i in 0..100 { let p = put1(&st, a, key(50 + i % 40)) }
        t16.put(a, key(10), "t16").unwrap()
        let c16 = st.commit(t16)
        println("older than the log: " + res(&c16))
        return 0
    }).unwrap()
}
