import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once create table g (a int, b int, t varchar(10), d datetime)\n@once insert into g values (1, 10, 'x', '2020-01-01'), (1, 20, 'Y', '2020-02-01'), (2, 30, 'x', NULL), (3, NULL, NULL, '2021-03-04 10:00'), (NULL, 5, 'z', '2020-01-01')\n@once create table gb (id int primary key, k varchar(10), v int)\n@once with n as (select 1 as i union all select i + 1 from n where i < 3000) insert into gb select i, case when i % 41 = 0 then NULL else 'k' + cast(i % 9 as varchar(5)) end, i % 100 from n option (maxrecursion 3000)\nselect a, count(*) as n, sum(b) as s from g where b > 15 group by all a order by a\nselect a, count(b) as n, max(b) as m, min(t) as mt from g where a = 9 group by all a order by a\nselect a, count(*) as n from g where 1 = 0 group by all a order by a\nselect t, count(*) as n, avg(b) as v from g where b < 25 group by all t order by t\nselect a, count(*) as n from g where b > 15 group by all a having count(*) = 0 order by a\nselect a, count(*) as n from g where b > 15 group by all a order by count(*), a\nselect a, count(distinct t) as n, count(*) as c from g where b > 15 group by all a order by a\nselect a, count(*) as n from g group by all a order by a\nselect a, t, count(*) as n from g where b > 15 group by all a, t order by a, t\nselect g1.a, count(*) as n from g g1 join g g2 on g2.a = g1.a where g2.b > 15 group by all g1.a order by 1\nselect a, sum(b) + 1 as s, count(*) * 2 as c from g where b > 15 group by all a order by a\nselect a, max(b) as m from g where b > 15 or t = 'z' group by all a order by a\nselect k, count(*) as n, sum(v) as s from gb where v > 50 group by all k order by k\nselect k, count(*) as n from gb where v > 98 group by all k having count(*) < 30 order by k\nselect a, count(*) as n from g where 10 / (b - 30) > 0 group by all a order by a\nselect a, count(*) as n from g where b > 15 group by all a with rollup\nselect a as k, count(*) from g group by k\nselect a, count(*) from g group by 1\nselect count(*) from g group by 'x'\ndeclare @x int = 1; select count(*) from g group by @x\nselect a + 1 as k, count(*) from g group by a + 1 order by 1\nselect a, count(*) as n from g group by a having n > 1\nselect value from generate_series(1, 3)\nselect * from generate_series(1, 10, 3)\nselect g.value from generate_series(5, 1, -2) as g\nselect count(*), sum(value) from generate_series(1, 3000)\nselect * from generate_series(1, 0)\nselect s.value, t.a from generate_series(1, 2) s join g t on t.a = s.value order by 1, 2\nselect 1 || 2\nselect 1.5 || 2\nselect a || b from g\nselect 'a' || 1, 1 || 'a', NULL || 'a', t || a from g order by a\nselect substring(NULL, 1)\nselect substring(NULL, 1, 2)\nselect substring(cast(NULL as varchar(5)), 1, 2), substring('abc', 2), substring(t, 2, 5) from g order by a\nselect format(1234.5, 'N2'), format(1234.567, 'N1'), format(-1234.5, 'N0'), format(0.5, 'N2'), format(1234567.891, 'N'), format(0.125, 'N2'), format(2.5, 'N0'), format(-0.004, 'N2')\nselect format(cast(1234.5 as float), 'N2'), format(12345, 'N2'), format(cast(12345 as bigint), 'n'), format(cast(0.1 as real), 'N3')\nselect format(1234.5, 'F2'), format(1234.5, 'F'), format(-1.005, 'F2'), format(12, 'F0'), format(1234.5, 'f3')\nselect format(42, 'D5'), format(-42, 'D'), format(42, 'd3'), format(42.5, 'D')\nselect format(255, 'X'), format(255, 'x4'), format(-1, 'X'), format(255.5, 'X')\nselect format(0.1234, 'P'), format(0.1234, 'P1'), format(-0.5, 'P0'), format(1, 'p')\nselect format(1234.5, 'C'), format(-1234.5, 'C'), format(1234.5, 'C0'), format(1234.5, 'C', 'de-DE')\nselect format(1234.5, 'E'), format(1234.5, 'e2'), format(0, 'E')\nselect format(1234.5, 'G'), format(1234.5, 'G3'), format(cast(1234.5 as float), 'G')\nselect format(1234.5, '#,##0.00'), format(1234.5, '0.000'), format(5, '000'), format(1234.5, '#'), format(0.5, '#.##'), format(-1234.567, '#,#.0')\nselect format(1234.5, 'N2', 'de-DE'), format(1234.5, 'N2', 'en-US')\nselect format(1234.5, 'Q'), format(1234.5, '')\nselect format(cast('2024-03-05 14:07:09.123' as datetime2), 'yyyy-MM-dd HH:mm:ss'), format(cast('2024-03-05' as date), 'dd/MM/yyyy'), format(cast('2024-03-05 14:07:09' as datetime), 'MMM d, yyyy h:mm tt')\nselect format(cast('2024-03-05 14:07:09' as datetime2), 'd'), format(cast('2024-03-05 14:07:09' as datetime2), 'D'), format(cast('2024-03-05 14:07:09' as datetime2), 'T'), format(cast('2024-03-05 14:07:09' as datetime2), 'dddd MMMM')\nselect format(cast('2024-03-05 14:07:09.1234567' as datetime2), 'fff'), format(cast('2024-03-05' as date), 'yy M d')\nselect a, format(b, 'N1'), format(d, 'yyyy-MM') from g order by a\nselect format('abc', 'N2')\nselect format(cast(NULL as int), 'N2'), format(1, NULL)\nselect format(1234.5, 'N2', NULL)\nselect k, format(sum(v), 'N0') from gb group by k order by k\nselect dateadd(day, 2, '2020-01-01'), dateadd(hour, 1, '2020-01-01 10:00'), dateadd(month, 1, '2020-01-31')\nselect dateadd(day, 2, cast('2020-01-01' as date)), dateadd(day, 2, cast('2020-01-01' as datetime2)), dateadd(day, 2, cast('2020-01-01' as datetime)), dateadd(minute, 1, cast('2020-01-01' as smalldatetime))\nselect a, dateadd(day, 1, d) from g order by a\nselect nosuchfn(a) from g where 1 = 0\nselect nosuch2(a, b) from g where 1 = 0\nselect nosuchfn(1)\nselect a from g where nosuchfn(a) = 1 and 1 = 0\nselect a is distinct from b from g\nselect a is distinct from b as k from g\nselect char(65), nchar(233), char(300), char(NULL), len(char(10) + 'a')"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(49), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
