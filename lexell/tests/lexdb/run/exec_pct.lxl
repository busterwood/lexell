// expect: SELECT 5103
// expect: 1|800.5|800;2|477|477;3|3000|2997;4|10|10;5||
// expect: 1|160.89999999999986|1599|1600;2|95|998|999;3|602.3999999999992|5994|5997;4|10|10|10;5|||
// expect: 618|618|5103
// expect: 117.5|764.5|95
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table tp (g int, x int, d numeric(10,2), f float8, s text, dt date, ts timestamp, iv interval)\ninsert into tp values (1, 1, 1.5, 1.5, 'a', '2020-01-01', '2020-01-01 00:00', '1 day'), (1, 2, 2.5, 2.5, 'b', '2020-01-03', '2020-01-03 00:00', '3 days'), (1, 3, 3.5, 3.5, 'c', '2020-01-04', '2020-01-04 12:00', '4 days'), (1, 4, 10.0, 10, 'd', '2020-01-10', '2020-01-10 00:00', '10 days'), (2, 5, 7.0, 7, 'e', '2020-02-01', '2020-02-01 00:00', '2 hours'), (2, NULL, NULL, NULL, NULL, NULL, NULL, NULL), (3, NULL, NULL, NULL, NULL, NULL, NULL, NULL), (4, 7, 7.0, 7, 'x', '2021-01-01', '2021-01-01 00:00', '7 days'), (4, 7, 7.0, 7, 'x', '2021-01-01', '2021-01-01 00:00', '7 days'), (4, 7, 7.0, 7, 'y', '2021-01-02', '2021-01-02 00:00', '7 days'), (4, 9, 9.0, 9, 'z', '2021-01-03', '2021-01-03 00:00', '9 days'), (5, 42, 42.5, 42.5, 'q', '2022-02-02', '2022-02-02 00:00', '42 days')\nselect g, percentile_cont(0.5) within group (order by x), percentile_disc(0.5) within group (order by x) from tp group by g order by g\nselect g, percentile_cont(0.25) within group (order by x desc), percentile_disc(0.25) within group (order by x desc) from tp group by g order by g\nselect percentile_cont(0) within group (order by x), percentile_cont(0.25) within group (order by x), percentile_cont(0.9) within group (order by x), percentile_cont(1) within group (order by x) from tp where g = 1\nselect percentile_disc(0) within group (order by x), percentile_disc(0.25) within group (order by x), percentile_disc(0.26) within group (order by x), percentile_disc(0.75) within group (order by x), percentile_disc(1) within group (order by x) from tp where g = 1\nselect percentile_cont(0.5) within group (order by x), percentile_disc(0.5) within group (order by x) from tp\nselect percentile_cont(0.5) within group (order by x), percentile_disc(0.5) within group (order by x) from tp where g = 3\nselect percentile_cont(0.5) within group (order by x), percentile_disc(0.5) within group (order by x) from tp where false\nselect percentile_cont(0.5) within group (order by x) from tp where g = 5\nselect g, percentile_cont(0.5) within group (order by x) from tp where false group by g\nselect pg_typeof(a), pg_typeof(b), pg_typeof(c), pg_typeof(d) from (select percentile_cont(0.5) within group (order by x) a, percentile_cont(0.5) within group (order by d) b, percentile_cont(0.5) within group (order by f) c, percentile_cont(0.5) within group (order by iv) d from tp) t\nselect pg_typeof(a), pg_typeof(b), pg_typeof(c), pg_typeof(d), pg_typeof(e) from (select percentile_disc(0.5) within group (order by x) a, percentile_disc(0.5) within group (order by d) b, percentile_disc(0.5) within group (order by s) c, percentile_disc(0.5) within group (order by dt) d, percentile_disc(0.5) within group (order by iv) e from tp) t\nselect percentile_cont(0.5) within group (order by d), percentile_disc(0.5) within group (order by d), percentile_cont(0.5) within group (order by f), percentile_disc(0.5) within group (order by f) from tp where g = 1\nselect percentile_disc(0.5) within group (order by s), percentile_disc(0.5) within group (order by dt), percentile_disc(0.5) within group (order by ts), percentile_disc(0.5) within group (order by s desc), percentile_disc(0.5) within group (order by dt desc) from tp where g = 1\nselect percentile_cont(0.5) within group (order by iv), percentile_cont(0.25) within group (order by iv desc), percentile_cont(0.3) within group (order by iv), percentile_disc(0.5) within group (order by iv), percentile_cont(0) within group (order by iv), percentile_cont(1) within group (order by iv) from tp where g = 1\nselect percentile_cont(0.5) within group (order by iv) from tp where g = 2\nselect percentile_cont(0.5) within group (order by x * 2) + 1, percentile_cont(0.5) within group (order by x) * 2 from tp where g = 1\nselect percentile_cont(0.5) within group (order by x desc nulls first), percentile_cont(0.5) within group (order by x nulls last), percentile_disc(0.5) within group (order by x asc) from tp\nselect percentile_cont(0.5) within group (order by x) filter (where g = 1), percentile_disc(0.5) within group (order by x) filter (where g = 9), percentile_cont(0.5) within group (order by x) filter (where g = 4) from tp\nselect g, percentile_cont(g / 4.0) within group (order by x), percentile_disc(g / 5.0) within group (order by x) from tp group by g order by g\nselect g, percentile_cont(0.5) within group (order by x) from tp group by g having percentile_cont(0.5) within group (order by x) > 3 order by g\nselect g, percentile_cont(0.5) within group (order by x) as med, count(*), sum(x), min(x) from tp group by g order by percentile_disc(0.5) within group (order by x) desc, g\nselect (select percentile_cont(0.5) within group (order by x) from tp t2 where t2.g = t1.g) from tp t1 order by t1.g, t1.x\nselect percentile_cont('0.5') within group (order by x), percentile_disc(0.5::float4) within group (order by x), percentile_cont(1.0/2) within group (order by x) from tp where g = 1\nselect percentile_cont(NULL) within group (order by x), percentile_disc(NULL::float8) within group (order by x) from tp\nselect percentile_cont(1.5) within group (order by x) from tp\nselect percentile_cont(-0.1) within group (order by x) from tp\nselect percentile_disc(2) within group (order by x) from tp where false\nselect g, percentile_cont(g) within group (order by x) from tp group by g order by g\nselect percentile_cont(0.5) within group (order by s) from tp\nselect percentile_cont(0.5) within group (order by dt) from tp\nselect percentile_cont(0.5) within group (order by x, d) from tp\nselect percentile_cont(0.5) from tp\nselect percentile_cont(0.5) within group (order by x) over () from tp\nselect percentile_disc(0.5) within group (order by x) over (partition by g) from tp\nselect percentile_cont(0.5, 0.2) within group (order by x) from tp\ncreate table bigp as select g, x from (select 1 as g, i as x from generate_series(1, 1600) i union all select 2, (i * 7) % 1000 from generate_series(1, 1501) i union all select 3, case when i % 5 = 0 then null else i * 3 end from generate_series(1, 2000) i union all select 4, 10 union all select 5, null) t\nselect g, percentile_cont(0.5) within group (order by x), percentile_disc(0.5) within group (order by x) from bigp group by g order by g\nselect g, percentile_cont(0.9) within group (order by x desc), percentile_disc(0.001) within group (order by x desc), percentile_disc(1) within group (order by x) from bigp group by g order by g\nselect percentile_cont(0.37) within group (order by x), percentile_disc(0.37) within group (order by x), count(*) from bigp\nselect percentile_cont(0.123) within group (order by x::float8), percentile_cont(0.777) within group (order by x::float8), percentile_cont(0.1) within group (order by x) from bigp where g = 2"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag.clone()) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(122), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
