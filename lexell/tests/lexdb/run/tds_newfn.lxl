const QUERIES = "@once create table dts (id int primary key, d date, t datetime, t2 datetime2(7), t3 datetime2(3), sd smalldatetime, tm time, k varchar(10))\n@once insert into dts values (1, '2020-01-08', '2024-03-05 10:22:33.123', '2024-03-05 10:22:33.1234567', '2024-03-05 10:22:33.123', '2024-03-05 10:22', '10:22:33.1234567', 'a'), (2, '1899-12-25', '1950-07-01 23:59:59.997', '0001-01-01 00:00:00', '9999-12-31 23:59:59.999', '1900-01-01 00:00', '00:00:00', 'b'), (3, NULL, NULL, NULL, NULL, NULL, NULL, NULL), (4, '2024-02-29', '2024-12-31 12:00:00', '2024-12-31 23:59:59.999999', '2024-06-15 06:30:00', '2024-06-15 06:31', '23:59:59.999999', 'a')\n@once create table pr (id int primary key, k varchar(10), v int, b bigint, f float, m decimal(6,2), s smallint)\n@once with n as (select 1 as i union all select i + 1 from n where i < 3000) insert into pr select i, case when i % 41 = 0 then NULL else 'k' + cast(i % 7 as varchar(5)) end, case when i % 13 = 0 then NULL else 1 + i % 3 end, i % 5, 1.0 + (i % 4) / 4.0, case when i % 17 = 0 then NULL else 1.01 end, case when i % 9 = 0 then -1 else 1 end from n option (maxrecursion 3000)\n@once create table fz (id int primary key, a varchar(20) collate Latin1_General_100_CI_AS, b varchar(20) collate Latin1_General_100_CI_AS, c varchar(20))\n@once insert into fz values (1, 'kitten', 'sitting', 'kitten'), (2, 'martha', 'marhta', 'x'), (3, 'Abc', 'abc', NULL), (4, '', 'abc', ''), (5, NULL, 'abc', 'q'), (6, 'dixon', 'dicksonx', 'z'), (7, 'same', 'same', 'same'), (8, 'flaw', 'lawn', 'f')\n@once create table bb (id int primary key, v varbinary(20), s varchar(40))\n@once insert into bb values (1, cast('hi' as varbinary(20)), 'aGk='), (2, 0x, ''), (3, NULL, NULL), (4, cast('hello world' as varbinary(20)), 'AQL_'), (5, base64_decode('+v/+'), 'Af8=')\nselect date_bucket(week, 1, cast('2020-01-08' as date)) as a, date_bucket(day, 2, cast('2024-03-05' as date)) as b, date_bucket(month, 1, cast('2024-03-05' as date)) as c, date_bucket(year, 3, cast('2024-03-05' as date)) as d, date_bucket(quarter, 1, cast('2024-08-05' as date)) as e\nselect date_bucket(minute, 15, cast('2024-03-05 10:22:33' as datetime2)) as a, date_bucket(hour, 5, cast('2024-03-05 10:22:33' as datetime)) as b, date_bucket(second, 10, cast('2024-03-05 10:22:33.5' as datetime2(3))) as c, date_bucket(millisecond, 250, cast('2024-03-05 10:22:33.777' as datetime2(3))) as d\nselect date_bucket(month, 1, cast('2024-03-05' as date), cast('2024-01-15' as date)) as a, date_bucket(day, 7, cast('2024-03-05' as date), cast('2024-03-01' as date)) as b, date_bucket(hour, 1, cast('2024-03-05 10:22' as datetime2), cast('2024-03-05 00:30' as datetime2)) as c, date_bucket(week, 2, cast('2024-03-05' as date), cast('2024-03-07' as date)) as d\nselect date_bucket(day, 1, cast('1899-12-25' as date)) as a, date_bucket(week, 1, cast('1899-12-25' as date)) as b, date_bucket(month, 2, cast('1899-12-25' as date)) as c, date_bucket(year, 1, cast('1899-07-25' as date)) as d\nselect date_bucket(month, 1, cast('2024-03-31' as date), cast('2024-01-31' as date)) as a, date_bucket(month, 1, cast('2024-02-29' as date), cast('2023-01-31' as date)) as b, date_bucket(month, 1, cast('2024-03-30' as date), cast('2024-01-31' as date)) as c\nselect date_bucket(day, 1, cast('2024-03-05 10:22' as smalldatetime)) as a, date_bucket(minute, 30, cast('10:22:33' as time)) as b\nselect id, date_bucket(week, 1, d) as w, date_bucket(month, 2, t) as m, date_bucket(hour, 6, t2) as h, date_bucket(minute, 10, sd) as s, date_bucket(second, 30, tm) as x from dts order by id\nselect k, date_bucket(month, 1, t) as m, count(*) as n from dts group by k, date_bucket(month, 1, t) order by k, m\nselect date_bucket(day, 0, cast('2024-03-05' as date))\nselect date_bucket(day, -1, cast('2024-03-05' as date))\nselect date_bucket(hour, 1, cast('2024-03-05' as date))\nselect date_bucket(xx, 1, cast('2024-03-05' as date))\nselect date_bucket(day, 1, 5)\nselect date_bucket(day, 1, '2024-03-05')\nselect date_bucket(day, 1, cast('2024-03-05' as date), cast('2024-03-01' as datetime))\nselect date_bucket(day, null, cast('2024-03-05' as date)) as a, date_bucket(day, 1, cast(null as date)) as b\ndeclare @n int = 3; select date_bucket(day, @n, cast('2024-03-05' as date)) as a\nselect date_bucket(dayofyear, 1, cast('2024-03-05' as date))\nselect date_bucket(microsecond, 1, cast('2024-03-05' as datetime2))\nselect datetrunc(month, cast('2024-03-05 10:22:33.1234567' as datetime2)) as a, datetrunc(week, cast('2024-03-05' as date)) as b, datetrunc(iso_week, cast('2024-03-05' as date)) as c, datetrunc(hour, cast('2024-03-05 10:22:33.123' as datetime)) as d, datetrunc(quarter, '2024-08-05') as e\nselect datetrunc(dayofyear, cast('2024-03-05 10:22' as smalldatetime)) as a, datetrunc(millisecond, cast('2024-03-05 10:22:33.1234567' as datetime2(7))) as b, datetrunc(microsecond, cast('2024-03-05 10:22:33.1234561' as datetime2(7))) as c, datetrunc(year, cast('2024-03-05' as date)) as d, datetrunc(day, cast('2024-03-05 10:22:33' as datetime)) as e\nselect datetrunc(hour, cast('10:22:33' as time)) as a, datetrunc(minute, cast('10:22:33.5' as time)) as b, datetrunc(second, cast('10:22:33.5' as time(3))) as c, datetrunc(yy, '2024-08-05 10:00') as d, datetrunc(mm, cast('2024-01-31' as date)) as e\nselect datetrunc(week, cast('2024-03-03' as date)) as a, datetrunc(week, cast('2024-03-09' as date)) as b, datetrunc(iso_week, cast('2024-03-03' as date)) as c, datetrunc(iso_week, cast('2024-03-04 12:00' as datetime2)) as d, datetrunc(dw, cast('2024-03-04 12:00' as datetime2)) as e\nselect id, datetrunc(month, d) as a, datetrunc(hour, t) as b, datetrunc(minute, t2) as c, datetrunc(day, t3) as e, datetrunc(year, sd) as f, datetrunc(minute, tm) as g from dts order by id\nselect datetrunc(year, null) as a, datetrunc(month, cast(null as date)) as b\nselect datetrunc(xx, getdate())\nselect datetrunc(nanosecond, sysdatetime())\nselect datetrunc(day, cast('10:22:33' as time))\nselect datetrunc(day, 5)\nselect datetrunc(microsecond, cast('2024-03-05 10:22:33.123' as datetime2(3)))\nselect datetrunc(millisecond, cast('2024-03-05 10:22:33' as smalldatetime))\nselect datetrunc(hour, cast('2024-03-05' as date))\nselect base64_encode(cast('hi' as varbinary(10))) as a, base64_encode(cast('hello world' as varbinary(20)), 1) as b, base64_decode('AQL/') as c, base64_decode('AQL_') as d, base64_decode('') as e, base64_decode('aGk') as f\nselect base64_encode(cast(null as varbinary(5))) as a, base64_decode(null) as b, base64_encode(cast('x' as varbinary(5)), null) as c, base64_encode(cast('x' as varbinary(5)), 0) as d, base64_encode(cast('xy' as varbinary(5)), 2) as e\nselect id, base64_encode(v) as e, base64_encode(v, 1) as u, base64_decode(s) as d from bb order by id\nselect base64_decode(base64_encode(cast('round trip' as varbinary(20)))) as r\nselect base64_decode('A')\nselect base64_decode('AQ=')\nselect base64_decode('A Q==') as a, base64_decode('AQ==') as b\nselect base64_decode('a$b=')\nselect base64_encode('hi')\nselect base64_encode(5)\nselect id, base64_decode(s) as d from bb where id >= 4 order by id\nselect unistr(N'\\00e9a') as a, unistr(N'x\\+01F600y') as b, unistr(N'a\\\\b') as c, unistr(N'$00e9', N'$') as d, unistr(cast(null as nvarchar(5))) as e, unistr(N'plain') as f, unistr(N'\\0041') as g\nselect unistr(N'\\00e')\nselect unistr(N'\\+01F6')\nselect unistr(N'a\\', N'\\')\nselect unistr(N'$00e9', N'ab')\nselect unistr(N'$00e9', N'+')\nselect unistr(N'\\D83D\\DE00') as a, unistr(N'\\00E9') as b\nselect unistr(5)\nselect unistr(null)\nselect id, unistr(cast(k as nvarchar(10)) + N'\\00e9') as u from dts order by id\nselect edit_distance('kitten', 'sitting')\nselect edit_distance('kitten' collate Latin1_General_100_CI_AS, 'sitting') as a, edit_distance_similarity('kitten' collate Latin1_General_100_CI_AS, 'sitting') as b, jaro_winkler_distance('martha' collate Latin1_General_100_CI_AS, 'marhta') as c, jaro_winkler_similarity('martha' collate Latin1_General_100_CI_AS, 'marhta') as d\nselect edit_distance('kitten' collate Latin1_General_100_CI_AS, 'sitting', 2) as a, edit_distance('kitten' collate Latin1_General_100_CI_AS, 'sitting', 0) as b, edit_distance('kitten' collate Latin1_General_100_CI_AS, 'sitting', 5) as c, edit_distance('kitten' collate Latin1_General_100_CI_AS, 'sitting', null) as d\nselect id, a, b, edit_distance(a, b) as e, edit_distance_similarity(a, b) as s, jaro_winkler_distance(a, b) as jd, jaro_winkler_similarity(a, b) as js from fz order by id\nselect edit_distance(a, 'kitchen') as e, count(*) as n from fz group by edit_distance(a, 'kitchen') order by e\nselect edit_distance('abc' collate Latin1_General_100_CS_AS, 'ABC') as a, edit_distance('abc' collate Latin1_General_100_CI_AS, 'ABC') as b, jaro_winkler_similarity('' collate Latin1_General_100_CI_AS, '') as c, jaro_winkler_distance('a' collate Latin1_General_100_CI_AS, 'b') as d, edit_distance_similarity('' collate Latin1_General_100_CI_AS, '') as e\nselect edit_distance(N'kitten' collate Latin1_General_100_CI_AS, N'sitting') as a, edit_distance_similarity(N'ab' collate Latin1_General_100_CI_AS, N'abc') as b\nselect edit_distance('kitten' collate Latin1_General_100_CI_AS, 'sitting', -1)\nselect edit_distance(5, 6)\nselect edit_distance('a')\nselect jaro_winkler_similarity('a' collate Latin1_General_100_CI_AS, 'b', 1)\nselect product(v) as p, product(distinct v) as pd, product(b) as pb, count(*) as n from pr where id <= 20\nselect product(f) as pf, product(m) as pm, product(s) as ps from pr where id <= 30\nselect k, product(v) as p, product(s) as ps, count(*) as n from pr where id <= 200 group by k order by k\nselect product(v) as p from pr where 1 = 0\nselect k, product(v) as p from pr where 1 = 0 group by k\nselect product(x) as p, product(distinct x) as pd, product(cast(x as float)) as pf, product(cast(x as decimal(5,2))) as pdec from (values (2), (3), (4), (2), (NULL)) v(x)\nselect product(x) as p from (values (cast(1.5 as decimal(4,1))), (2.5)) v(x)\nselect product(x) as p from (values (cast(1.12345678 as decimal(10,8))), (1.5), (3)) v(x)\nselect product(x) as p, count(*) as n from (values (cast(9999999999.999 as decimal(13,3))), (9999999999.999), (9999999999.999), (9999999999.999)) v(x)\nselect product(x) as p from (values (cast(100 as tinyint)), (3)) v(x)\nselect product(x) as p from (values (0), (-3)) v(x)\nselect product(cast(x as bigint)) as p from (values (2147483647), (2)) v(x)\nselect product(x) as p from (values (2147483647), (2)) v(x)\nselect product(v) as p from pr\nselect product(x) as p from (values ('2'), ('3')) v(x)\nselect k, x, product(x) over (partition by k) as p, product(x) over (order by x rows between 1 preceding and current row) as q from (values (1, 2), (1, 3), (2, 5)) v(k, x) order by k, x\nselect id, product(v) over (partition by k order by id rows between 2 preceding and current row) as p from pr where id <= 12 order by id\nselect k, product(case when v is null then null else 2 end) as p from pr where id between 100 and 160 group by k having product(v) > 100 order by k"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(51), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
