// lexdb_exec: indexes and joins against plain scans. Tables a and b have
// secondary indexes (composite and filtered ones too); a0 and b0 hold the
// same rows and have none. The same
// random inserts, updates and deletes go to both; random queries must give
// the same rows from each (index lookups and ranges against full scans),
// and the same joins (per-row index lookups against hash joins). The cache
// is small, so nodes are evicted and loaded meanwhile. ORDER BY with LIMIT
// and MIN/MAX are read in an index's order on one side and sorted or
// aggregated on the other; a RIGHT JOIN must equal the LEFT JOIN the other
// way round, and a FULL JOIN the LEFT JOIN plus the other side's unmatched
// rows. Subqueries are compared with what they equal: IN with a correlated
// EXISTS and with the list of its values, NOT EXISTS with a LEFT JOIN's
// unmatched rows, a correlated count with a grouped LEFT JOIN, a scalar with
// its value; UPDATE uses them too. b has an index on x and b0 none, so a
// subquery correlated on x is per row on one side and hashed on the other.
// A subquery in FROM and a CTE are compared with the tables they read;
// UNION with DISTINCT, INTERSECT and EXCEPT with AND and AND NOT; WITH RECURSIVE with
// the same walk done by the test; LATERAL with scalar subqueries.
// expect: statements ok, queries 1204 differ 0, index paths used true, hash joins used true, index order used true, backward true, min/max true, filtered true, in-lists true, subqueries per row true and once true, hashed true
import "strings"
import "collections"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_base"

fn rows(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "N" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            return strings.join(&lines, ";")
        }
        Err(e) { return "error " + e.state }      // the message names the table
    }
}

fn sorted(x: &str): str {
    var parts: []str = []
    for part in strings.split(x, ";") { append(mut &parts, part.toStr()) }
    collections.sortBy(mut &parts, fn(a: &str, b: &str): int { return a.cmp(b) })
    return strings.join(&parts, ";")
}

fn must(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(_) {}
        Err(e) { panic(sql + ": " + e.state + " " + e.msg) }
    }
}

fn xval(r: mut &lexdb_base.Rng): str {
    if r.below(8) == 0 { return "null" }
    return (r.below(40) - 10).toStr()
}

fn yval(r: mut &lexdb_base.Rng): str {
    let ys = ["'ash'", "'birch'", "'cedar'", "'elm'", "'fir'", "''", "null"]
    return ys[r.below(len(ys))]
}

fn zval(r: mut &lexdb_base.Rng): str {
    if r.below(9) == 0 { return "null" }
    return (r.below(2000) - 1000).toStr() + "." + r.below(100).toStr()
}

fn cond(r: mut &lexdb_base.Rng): str {
    return match r.below(18) {
        14 { "x in (" + xval(r) + ", " + xval(r) + ", " + xval(r) + ")" }
        15 { "x between " + xval(r) + " and " + xval(r) }
        16 { "y like '" + ["a", "b", "c", "ce", "e", "f", "fi", "x", ""][r.below(9)] + "%'" }
        17 { "x not in (" + xval(r) + ", " + xval(r) + ") and y like '%r%'" }
        11 { "x >= " + xval(r) + " and z < " + zval(r) }
        12 { "y = " + yval(r) + " and x = " + xval(r) + " and z > " + zval(r) }
        13 { "y > 'b' and x >= " + xval(r) }
        10 { "id >= " + r.below(3000).toStr() + " and id <= " + r.below(3000).toStr() }
        0 { "x = " + xval(r) }
        1 { "x > " + xval(r) + " and x <= " + xval(r) }
        2 { "y = " + yval(r) + " and x < " + xval(r) }
        3 { "y = " + yval(r) }
        4 { "z >= " + zval(r) }
        5 { "x is null" }
        6 { "y > " + yval(r) }
        7 { "z = " + zval(r) + " or x = 3" }
        8 { "y = " + yval(r) + " and x = " + xval(r) }
        else { "x >= " + xval(r) + " and x < " + xval(r) }
    }
}

// A condition's columns qualified by a table's alias.
fn qual(c: &str, alias: &str): str {
    var out: []str = []
    for w in strings.split(c, " ") {
        let t = w.toStr()
        append(mut &out, if t == "x" || t == "y" || t == "z" || t == "id" { alias + "." + t } else { t })
    }
    return strings.join(&out, " ")
}

// A query's single column as a list of literals.
fn literals(x: &str): []str {
    var out: []str = []
    if x == "" { return out }
    for v in strings.split(x, ";") {
        let t = v.toStr()
        append(mut &out, if t == "N" { "null" } else { t })
    }
    return out
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    for t in ["a", "a0", "b", "b0"] {
        must(mut &s, "create table " + t + " (id int primary key, x int, y text, z numeric(8,2))")
    }
    must(mut &s, "create index a_x on a (x)")
    must(mut &s, "create index a_yx on a (y, x)")
    must(mut &s, "create index a_z on a (z)")
    must(mut &s, "create index a_pos on a (z) where x > 0")
    must(mut &s, "create index a_named on a (x, z) where y is not null and y <> ''")
    must(mut &s, "create index b_ash on b (x) where y = 'ash'")
    must(mut &s, "create index b_x on b (x)")
    var r = lexdb_base.rng(42)
    var queries = 0
    var differ = 0
    var indexed = false
    var hashed = false
    var ordered = false
    var backward = false
    var firstValue = false
    var filtered = false
    var inLists = false
    var correlated = false
    var hashedSub = false
    var runOnce = false
    for round in 0..40 {
        // changes, the same to both pairs
        for k in 0..25 {
            let op = r.below(10)
            var sql = ""
            if op < 6 {
                var vs: []str = []
                for v in 0..5 {
                    append(mut &vs, "(" + r.below(3000).toStr() + ", " + xval(mut &r) + ", " + yval(mut &r) + ", " +
                           zval(mut &r) + ")")
                }
                sql = "insert into T values " + strings.join(&vs, ", ")
            } else if op < 8 {
                sql = "update T set x = " + xval(mut &r) + ", y = " + yval(mut &r) + " where " + cond(mut &r)
            } else if op < 9 {
                // subqueries in DML: a value and a condition from b0, the same for both of a pair
                sql = "update T set z = (select max(v.z) from b0 v where v.x = T.x) where x " + (if r.below(2) == 0 { "" } else { "not " }) +
                      "in (select x from b0 where " + cond(mut &r) + ")"
            } else {
                sql = "delete from T where " + cond(mut &r)
            }
            let p = if r.below(2) == 0 { ["a", "a0"] } else { ["b", "b0"] }
            let got1 = rows(mut &s, &strings.replaceAll(&(strings.replaceAll(&sql, " T ", &(" " + p[0] + " "))), " T.", &(" " + p[0] + ".")))
            let got0 = rows(mut &s, &strings.replaceAll(&(strings.replaceAll(&sql, " T ", &(" " + p[1] + " "))), " T.", &(" " + p[1] + ".")))
            if got1 != got0 {
                differ += 1
                println("differ: " + sql + ": " + got1 + " / " + got0)
            }
        }
        // queries
        for k in 0..30 {
            var sql = ""
            let c = cond(mut &r)
            let n = (r.below(9) + 1).toStr()
            let j = r.below(35)
            var q1 = ""
            var q0 = ""
            var got1 = ""
            var got0 = ""
            if j < 9 {
                if j < 2 {
                    sql = "select id, x, y, z from T where " + c + " order by id"
                } else if j == 2 {
                    sql = "select t.id, u.id from T t join U u on u.x = t.x where t." + c + " order by 1, 2"
                } else if j == 3 {
                    sql = "select t.id, u.id, u.y from T t left join U u on u.x = t.x and u.y = t.y order by 1, 2"
                } else if j == 4 {
                    sql = "select id, x from T where " + c + " order by x, id limit " + n
                } else if j == 5 {
                    sql = "select id, x from T where " + c + " order by x desc, id desc limit " + n
                } else if j == 6 {
                    sql = "select y, x, id from T where " + c + " order by y desc, x desc, id desc limit " + n
                } else if j == 7 {
                    sql = "select id from T where " + c + " order by id desc limit " + n + " offset 2"
                } else {
                    let f = ["min(x)", "max(x)", "min(z)", "max(z)", "max(y)", "min(y)", "max(id)"][r.below(7)]
                    sql = "select " + f + " from T where " + c
                }
                q1 = strings.replaceAll(&(strings.replaceAll(&sql, "from T", "from a")), "join U", "join b")
                q0 = strings.replaceAll(&(strings.replaceAll(&sql, "from T", "from a0")), "join U", "join b0")
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 19 {
                // IN (subquery) = a correlated EXISTS
                q1 = "select id from a where x in (select x from b where " + c + ") order by id"
                q0 = "select t.id from a0 t where exists (select 1 from b0 u where u.x = t.x and (" + qual(&c, &"u") + ")) order by 1"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 20 {
                // NOT EXISTS = a LEFT JOIN's rows that joined nothing
                q1 = "select t.id from a t where not exists (select 1 from b u where u.x = t.x and (" + qual(&c, &"u") + ")) order by 1"
                q0 = "select t.id from a0 t left join b0 u on u.x = t.x and (" + qual(&c, &"u") + ") where u.id is null order by 1"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 21 {
                // a correlated count = a LEFT JOIN grouped
                let c2 = cond(mut &r)
                q1 = "select t.id, (select count(*) from b u where u.x = t.x and (" + qual(&c, &"u") + ")), (select max(u.z) from b u where u.x = t.x) from a t where " +
                     qual(&c2, &"t") + " order by 1"
                q0 = "select t.id, count(u.id), (select max(z) from b0 where b0.x = t.x) from a0 t left join b0 u on u.x = t.x and (" + qual(&c, &"u") + ") where " +
                     qual(&c2, &"t") + " group by t.id order by 1"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 22 {
                // IN and NOT IN (subquery) = the list of its values
                let neg = if r.below(2) == 0 { "" } else { "not " }
                let vals = literals(&rows(mut &s, &("select x from b0 where " + c)))
                q1 = "select id from a where x " + neg + "in (select x from b where " + c + ") order by id"
                if len(vals) == 0 {
                    q0 = "select id from a0 where " + (if neg == "" { "false" } else { "true" }) + " order by id"
                } else {
                    q0 = "select id from a0 where x " + neg + "in (" + strings.join(&vals, ", ") + ") order by id"
                }
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 23 {
                // a scalar subquery = its value; in ORDER BY with LIMIT too
                let v = rows(mut &s, &("select max(x) from b0 where " + c))
                let lit = if v == "N" { "null" } else { v }
                q1 = "select id, x from a where x <= (select max(x) from b where " + c + ") order by x desc, id limit " + n
                q0 = "select id, x from a0 where x <= " + lit + " order by x desc, id limit " + n
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 26 {
                // a subquery in FROM = its query
                q1 = "select t.id, t.y from (select id, y from a where " + c + ") t order by t.id"
                q0 = "select id, y from a0 where " + c + " order by id"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 27 {
                // a CTE grouped and joined = a correlated count where there is one
                let c2 = cond(mut &r)
                q1 = "with u as (select x, count(*) as n from b where " + c + " group by x) select t.id, u.n from a t join u on u.x = t.x where " +
                     qual(&c2, &"t") + " order by 1"
                q0 = "select t.id, (select count(*) from b0 u where u.x = t.x and (" + qual(&c, &"u") + ")) from a0 t where (" + qual(&c2, &"t") +
                     ") and exists (select 1 from b0 u where u.x = t.x and (" + qual(&c, &"u") + ")) order by 1"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 28 {
                // a subquery in FROM on either side of a LEFT JOIN = the tables themselves
                if r.below(2) == 0 {
                    q1 = "select t.id, u.id from a t left join (select id, x from b where " + c + ") u on u.x = t.x order by 1, 2"
                } else {
                    q1 = "select t.id, u.id from (select id, x from a) t left join (select id, x from b where " + c + ") u on u.x = t.x order by 1, 2"
                }
                q0 = "select t.id, u.id from a0 t left join b0 u on u.x = t.x and (" + qual(&c, &"u") + ") order by 1, 2"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 29 {
                // UNION = DISTINCT of UNION ALL; UNION ALL = the counts added
                let c2 = cond(mut &r)
                if r.below(2) == 0 {
                    q1 = "select x from a where " + c + " union select x from b where " + c2 + " order by 1"
                    q0 = "select distinct x from (select x from a0 where " + c + " union all select x from b0 where " + c2 + ") u order by 1"
                    got0 = rows(mut &s, &q0)
                } else {
                    q1 = "select count(*) from (select id from a where " + c + " union all select id from b where " + c2 + ") u"
                    let n1 = strings.parseIntOpt(&(rows(mut &s, &("select count(*) from a0 where " + c)))).unwrapOr(-1)
                    let n2 = strings.parseIntOpt(&(rows(mut &s, &("select count(*) from b0 where " + c2)))).unwrapOr(-1)
                    q0 = "(counts added)"
                    got0 = (n1 + n2).toStr()
                }
                got1 = rows(mut &s, &q1)
            } else if j == 30 {
                // INTERSECT = AND; EXCEPT = AND NOT (a NULL condition: not in the second)
                let c2 = cond(mut &r)
                if r.below(2) == 0 {
                    q1 = "select id, x from a where " + c + " intersect select id, x from a where " + c2 + " order by 1"
                    q0 = "select id, x from a0 where (" + c + ") and (" + c2 + ") order by 1"
                } else {
                    q1 = "select id, x from a where " + c + " except select id, x from a where " + c2 + " order by 1"
                    q0 = "select id, x from a0 where (" + c + ") and case when (" + c2 + ") then false else true end order by 1"
                }
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 31 || j == 32 {
                // WITH RECURSIVE: from the smallest x, the run of x + 1, x + 2, ... in the table
                let walk = if j == 31 { "from r join a on a.x = r.v + 1" } else { "from a join r on a.x = r.v + 1" }
                q1 = "with recursive r(v) as (select min(x) from a where " + c + " union select a.x " + walk + ") select v from r where v is not null order by v"
                q0 = "(the run, from the rows)"
                let lo = rows(mut &s, &("select min(x) from a0 where " + c))
                var run: []str = []
                if lo != "N" {
                    var v = strings.parseIntOpt(&lo).unwrapOr(0)
                    while true {
                        append(mut &run, v.toStr())
                        let more = rows(mut &s, &("select count(*) from a0 where x = " + (v + 1).toStr()))
                        if more == "0" { break }
                        v += 1
                    }
                }
                got0 = strings.join(&run, ";")
                got1 = rows(mut &s, &q1)
            } else if j == 33 {
                // LATERAL count = a scalar subquery's
                q1 = "select t.id, l.n from a t, lateral (select count(*) as n from b u where u.x = t.x and (" + qual(&c, &"u") + ")) l order by 1"
                q0 = "select t.id, (select count(*) from b0 u where u.x = t.x and (" + qual(&c, &"u") + ")) from a0 t order by 1"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 34 {
                // LEFT JOIN LATERAL, the first row = min
                q1 = "select t.id, l.id from a t left join lateral (select u.id from b u where u.x = t.x and (" + qual(&c, &"u") + ") order by u.id limit 1) l on true order by 1"
                q0 = "select t.id, (select min(u.id) from b0 u where u.x = t.x and (" + qual(&c, &"u") + ")) from a0 t order by 1"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 24 || j == 25 {
                // correlated IN and NOT IN as values (NULLs and all): per row
                // through b's index against b0 hashed
                let key = if j == 24 { "u.x = t.x" } else { "u.x = t.x + 1" }
                let sub = "(select u.z from T u where " + key + " and (" + qual(&c, &"u") + "))"
                let sql2 = "select t.id, t.z in " + sub + ", t.z not in " + sub + " from a t order by 1"
                q1 = strings.replaceAll(&sql2, "from T", "from b")
                q0 = strings.replaceAll(&sql2, "from T", "from b0")
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 12 {
                // grouped aggregates, the indexed table against the plain one
                sql = "select y, count(*), sum(x), min(z), max(z), count(distinct x), avg(x), sum(id) from T where " + c + " group by y order by y"
                q1 = strings.replaceAll(&sql, "from T", "from a")
                q0 = strings.replaceAll(&sql, "from T", "from a0")
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 13 {
                // DISTINCT = GROUP BY on the same columns
                q1 = "select distinct y, x % 3 from a where " + c + " order by 1, 2"
                q0 = "select y, x % 3 from a0 where " + c + " group by y, x % 3 order by 1, 2"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 14 {
                // FILTER = WHERE
                q1 = "select count(*) filter (where " + c + "), sum(x) filter (where " + c + "), max(z) filter (where " + c + ") from a"
                q0 = "select count(*), sum(x), max(z) from a0 where " + c
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 15 {
                // HAVING = the groups, filtered here
                let lim = r.below(6)
                q1 = "select y, count(*) from a group by y having count(*) > " + lim.toStr() + " order by y"
                q0 = "select y, count(*) from a0 group by y order by y"
                got1 = rows(mut &s, &q1)
                var kept: []str = []
                for line in strings.split(&rows(mut &s, &q0), ";") {
                    let parts = strings.split(&line, "|")
                    if len(parts) == 2 && strings.parseIntOpt(&(parts[1].toStr())).unwrapOr(0) > lim { append(mut &kept, line.toStr()) }
                }
                got0 = strings.join(&kept, ";")
            } else if j == 16 {
                // IN = a chain of ORs; NOT IN = NOT of it (NULLs alike)
                let v1 = xval(mut &r)
                let v2 = xval(mut &r)
                let v3 = xval(mut &r)
                let neg = if r.below(2) == 0 { "" } else { "not " }
                q1 = "select id from a where " + neg + "x in (" + v1 + ", " + v2 + ", " + v3 + ") order by id"
                q0 = "select id from a0 where " + neg + "(x = " + v1 + " or x = " + v2 + " or x = " + v3 + ") order by id"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 17 {
                // LIKE 'p%' = substr(y, 1, len) = 'p'
                let pf = ["a", "b", "c", "ce", "e", "f", "fi", "x", "ash"][r.below(9)]
                q1 = "select id from a where y like '" + pf + "%' order by id"
                q0 = "select id from a0 where substr(y, 1, " + len(pf).toStr() + ") = '" + pf + "' order by id"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else if j == 18 {
                // BETWEEN = two comparisons; CASE buckets = FILTER counts
                let lo = xval(mut &r)
                let hi = xval(mut &r)
                q1 = "select case when x between " + lo + " and " + hi + " then 'in' when x is null then 'none' else 'out' end, count(*) from a group by 1 order by 1"
                // "out" is the rest: a NULL bound makes the condition NULL, and CASE falls through
                let c1 = rows(mut &s, &("select count(*) filter (where x >= " + lo + " and x <= " + hi + "), count(*) filter (where x is null), count(*) from a0"))
                got1 = rows(mut &s, &q1)
                let parts = strings.split(&c1, "|")
                let nIn = strings.parseIntOpt(&(parts[0].toStr())).unwrapOr(0)
                let nNone = strings.parseIntOpt(&(parts[1].toStr())).unwrapOr(0)
                let nOut = strings.parseIntOpt(&(parts[2].toStr())).unwrapOr(0) - nIn - nNone
                var want: []str = []
                if nIn > 0 { append(mut &want, "in|" + nIn.toStr()) }
                if nNone > 0 { append(mut &want, "none|" + nNone.toStr()) }
                if nOut > 0 { append(mut &want, "out|" + nOut.toStr()) }
                got0 = strings.join(&want, ";")
            } else if j == 9 {
                // RIGHT JOIN = the LEFT JOIN the other way round
                let side = if r.below(2) == 0 { "u." } else { "t." }
                q1 = "select t.id, u.id from a t right join b u on u.x = t.x where " + side + c + " order by 1, 2"
                q0 = "select t.id, u.id from b u left join a t on u.x = t.x where " + side + c + " order by 1, 2"
                got1 = rows(mut &s, &q1)
                got0 = rows(mut &s, &q0)
            } else {
                // FULL JOIN = the LEFT JOIN, and the other side's rows that joined nothing
                let on = if j == 10 { "u.x = t.x" } else { "u.x = t.x and u.y = t.y and u.id > 1000" }
                q1 = "select t.id, u.id from a0 t full join b0 u on " + on
                q0 = "select t.id, u.id from a0 t left join b0 u on " + on
                got1 = sorted(&rows(mut &s, &q1))
                let l = rows(mut &s, &q0)
                let rest = rows(mut &s, &("select t.id, u.id from b0 u left join a0 t on " + on + " where t.id is null"))
                var all: []str = []
                if l != "" { append(mut &all, l) }
                if rest != "" { append(mut &all, rest) }
                got0 = sorted(&strings.join(&all, ";"))
            }
            queries += 1
            if got1 != got0 {
                differ += 1
                println("differ: " + q1 + "\n  " + got1 + "\n  " + got0)
            }
            if strings.contains(&(rows(mut &s, &("explain " + q1))), "index ") { indexed = true }
            if strings.contains(&(rows(mut &s, &("explain " + q0))), "hash on") { hashed = true }
            let ex = rows(mut &s, &("explain " + q1))
            if strings.contains(&ex, "order: the scan's") && strings.contains(&ex, "index ") { ordered = true }
            if strings.contains(&ex, "backward") { backward = true }
            if strings.contains(&ex, "min/max:") { firstValue = true }
            if strings.contains(&ex, "(filtered)") { filtered = true }
            if strings.contains(&ex, "for each of") { inLists = true }
            if strings.contains(&ex, "per row, on") { correlated = true }
            if strings.contains(&(rows(mut &s, &("explain " + q0))), "hashed on") { hashedSub = true }
            if strings.contains(&ex, "run once") { runOnce = true }
        }
    }
    // Scans longer than a batch (256 rows), in order both ways, against sorts
    // (an expression in ORDER BY is always sorted).
    must(mut &s, "create table big (id int primary key, x int)")
    must(mut &s, "create index big_x on big (x)")
    for k in 0..14 {
        var vs: []str = []
        for i in 0..50 { append(mut &vs, "(" + (k * 50 + i).toStr() + ", " + xval(mut &r) + ")") }
        must(mut &s, "insert into big values " + strings.join(&vs, ", "))
    }
    for pair in [["order by id desc limit 700", "order by id + 0 desc limit 700"],
                 ["order by x desc, id desc limit 700", "order by x + 0 desc, id desc limit 700"],
                 ["order by x, id limit 690", "order by x + 0, id limit 690"],
                 ["where id > 20 order by id desc limit 600", "where id > 20 order by id + 0 desc limit 600"]] {
        let g1 = rows(mut &s, &("select id, x from big " + pair[0]))
        let g0 = rows(mut &s, &("select id, x from big " + pair[1]))
        queries += 1
        if g1 != g0 {
            differ += 1
            println("differ: " + pair[0])
        }
    }
    let n = rows(mut &s, &"select count(*) from a")
    if n == "0" { println("a is empty") }
    println("statements ok, queries " + queries.toStr() + " differ " + differ.toStr() + ", index paths used " +
            indexed.toStr() + ", hash joins used " + hashed.toStr() +
            ", index order used " + ordered.toStr() + ", backward " + backward.toStr() + ", min/max " + firstValue.toStr() + ", filtered " + filtered.toStr() + ", in-lists " + inLists.toStr() + ", subqueries per row " + correlated.toStr() + " and once " + runOnce.toStr() + ", hashed " + hashedSub.toStr())
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(3), lexdb_store.Options{cacheBytes: 12 * 2048, segBytes: 256 * 1024, ckptBytes: 64 * 1024, snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
