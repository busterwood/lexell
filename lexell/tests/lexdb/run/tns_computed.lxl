// lexdb over TNS: virtual columns and function-based indexes (design/lexdb-dialect-gaps.md, package C; generated by tests/lexdb/gen_oracle.py from
// oracle_computed_queries.txt): GENERATED ALWAYS AS (expr) [VIRTUAL] and the short form AS (expr), with and without a type, at CREATE TABLE and
// ALTER TABLE ADD; INSERT and UPDATE computing them (ORA-54013, ORA-54017, ORA-00947); the expressions refused (ORA-54012, 54002, 54016, 904);
// indexes on them and function-based indexes on CASE, arithmetic and function expressions, used by queries with the same expression, kept by
// INSERT, UPDATE and DELETE; NOT NULL, CHECK, PRIMARY KEY and UNIQUE on a virtual column; USER_TAB_COLS, USER_INDEXES, USER_IND_COLUMNS
// and USER_IND_EXPRESSIONS; RENAME, MODIFY and DROP of a column read or virtual (ORA-54031, 54033, 54027). Its answers are as Oracle's documentation
// gives them (no Oracle was at hand: each line gives its answer as a fourth field). Each answer is a label, then the row count, or the columns' names
// and rows, or error and the ORA- number.
// expect: table: 0
// expect: insert 1: 1
// expect: insert 2 nulls: 1
// expect: insert 3: 1
// expect: value for virtual: error 54013
// expect: too few values: error 947
// expect: insert v: error 54013
// expect: insert w: error 54013
// expect: insert u: error 54013
// expect: update v: error 54017
// expect: update u: error 54017
// expect: update a: 1
// expect: update b and s: 1
// expect: select columns: ID,A,B,V,W,S,U = 1|10|3|13|20|'x'|'X';2|NULL|4|NULL|NULL|'new'|'NEW';3|5|5|10|10|'yz'|'YZ'
// expect: select star: ID,A,B,V,W,S,U = 1|10|3|13|20|'x'|'X';2|NULL|4|NULL|NULL|'new'|'NEW';3|5|5|10|10|'yz'|'YZ'
// expect: where virtual: ID = 1
// expect: where either: ID = 2;3
// expect: group by virtual: V,COUNT(*) = 10|1;13|1;NULL|1
// expect: order by virtual: ID,V = 2|NULL;1|13;3|10
// expect: index on virtual: 0
// expect: unique index on virtual: 0
// expect: unique violated: error 1
// expect: insert 5: 1
// expect: read by index: ID = 5
// expect: function-based case: 0
// expect: function-based sum: 0
// expect: function-based two: 0
// expect: function-based unique: 0
// expect: not pure: error 1743
// expect: no column: error 904
// expect: case predicate: ID = 1
// expect: sum predicate: ID = 1
// expect: insert 6: 1
// expect: case after insert: ID = 1;6
// expect: sum after insert: ID = 6
// expect: update 6: 1
// expect: sum after update: ID = 
// expect: sum after update 2: ID = 6
// expect: unique function: 1
// expect: unique function again: error 1
// expect: delete 6: 1
// expect: sum after delete: ID = 
// expect: indexes: INDEX_NAME,INDEX_TYPE,UNIQUENESS = 'IX_CASE'|'FUNCTION-BASED NORMAL'|'NONUNIQUE';'IX_SUM'|'FUNCTION-BASED NORMAL'|'NONUNIQUE';'IX_UP'|'FUNCTION-BASED NORMAL'|'NONUNIQUE';'IX_V'|'FUNCTION-BASED NORMAL'|'NONUNIQUE';'UX_FN'|'FUNCTION-BASED NORMAL'|'UNIQUE';'UX_W'|'FUNCTION-BASED NORMAL'|'UNIQUE'
// expect: index columns: INDEX_NAME,COLUMN_NAME,COLUMN_POSITION,DESCEND = 'IX_CASE'|'SYS_NC00008$'|1|'ASC';'IX_UP'|'SYS_NC00010$'|1|'ASC';'IX_UP'|'SYS_NC00011$'|2|'DESC';'IX_V'|'V'|1|'ASC';'UX_W'|'W'|1|'ASC'
// expect: index expressions: INDEX_NAME,COLUMN_EXPRESSION,COLUMN_POSITION = 'IX_CASE'|'CASE WHEN "A">5 THEN 1 ELSE 0 END'|1;'IX_SUM'|'"A"+"B"'|1;'IX_UP'|'UPPER("S")'|1;'IX_UP'|'"A"*2'|2;'UX_FN'|'NVL("B",0)*100+"ID"'|1
// expect: table c: 0
// expect: tab cols: COLUMN_NAME,DATA_TYPE,VIRTUAL_COLUMN,DATA_DEFAULT,HIDDEN_COLUMN = 'A'|'NUMBER'|'NO'|NULL|'NO';'B'|'NUMBER'|'YES'|'"A"*2'|'NO';'C'|'VARCHAR2'|'YES'|'TO_CHAR("A")'|'NO';'D'|'NUMBER'|'NO'|'7'|'NO'
// expect: tab columns: COLUMN_NAME,DATA_TYPE,DATA_DEFAULT = 'A'|'NUMBER'|NULL;'B'|'NUMBER'|'"A"*2';'C'|'VARCHAR2'|'TO_CHAR("A")';'D'|'NUMBER'|'7'
// expect: insert c: 1
// expect: select c: A,B,C,D = 12|24|'12'|7
// expect: add short: 0
// expect: add virtual: 0
// expect: add list: 0
// expect: added columns: ID,A,X,X2,X3 = 1|10|11|4|110;2|NULL|NULL|5|NULL;3|5|6|6|105;5|4|5|1|104;7|2|3|1|102
// expect: reads a virtual: error 54012
// expect: unknown column: error 904
// expect: sysdate: error 54002
// expect: subquery: error 54016
// expect: rename a read column: error 54031
// expect: rename a virtual column: 0
// expect: renamed: COLUMN_NAME = 'A';'WW'
// expect: modify a read column: error 54033
// expect: drop a read column: error 54027
// expect: drop a virtual column: 0
// expect: columns: COLUMN_NAME = 'ID';'A';'B';'V';'WW';'S';'U';'X2';'X3'
// expect: table not null: 0
// expect: not null ok: 1
// expect: not null violated: error 1400
// expect: table check: 0
// expect: check ok: 1
// expect: check violated: error 2290
// expect: table key: 0
// expect: key ok: 1
// expect: key violated: error 1
// expect: table unique: 0
// expect: unique ok: 1
// expect: unique violated 2: error 1
// expect: typeless: 0
// expect: typeless insert: 1
// expect: typeless select: A,B = 21|42
// expect: table default: error 54016
// expect: table reads virtual: error 54012
// expect: table impure: error 54002
// expect: div table: 0
// expect: div insert: 1
// expect: div insert 2: 1
// expect: div other column: A = 0;4
// expect: div read: error 1476
// expect: div filtered: B = 0.25
// expect: add virtual over rows: 0
// expect: add read: A,C = 4|40
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn q(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + qtext(c, sql)) }
fn x(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + xtext(c, sql)) }

// Statements and queries ("a ;; b ;; c") in one transaction, rolled back (t) or committed (u): each answer, joined by " / ".
fn tx(c: mut &oracle.Conn, label: &str, sqls: &str, commit: bool) {
    var out: []str = []
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for part in strings.split(sqls, " ;; ") {
            if strings.startsWith(&strings.toLowerAscii(part), "select") { append(mut &out, qtext(c2, part)) } else { append(mut &out, xtext(c2, part)) }
        }
        if !commit { return Err(sqldialect.inputError("rolled back")) }
        return Ok(0)
    })
    println(label + ": " + strings.join(&out, " / "))
}
fn t(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, false) }
fn u(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, true) }

fn connect(s: &str): oracle.Conn {
    match oracle.connect(&(s.toStr())) {
        Ok(c) { return c }
        Err(e) {
            println("connect: error " + e.code.toStr() + " " + e.msg)
            exit(1)
        }
    }
}

fn client(port: &str) {
    var c = connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb"))
    x(mut &c, "table", "create table g (id number primary key, a number, b number, v number generated always as (a + b) virtual, w as (a * 2), s varchar2(20), u varchar2(30) generated always as (upper(s)) virtual)")
    x(mut &c, "insert 1", "insert into g (id, a, b, s) values (1, 2, 3, 'x')")
    x(mut &c, "insert 2 nulls", "insert into g (id, a, b, s) values (2, null, 3, null)")
    x(mut &c, "insert 3", "insert into g (id, a, b, s) values (3, 5, 5, 'yz')")
    x(mut &c, "value for virtual", "insert into g values (4, 1, 1, 1, 1, 'y', 'z')")
    x(mut &c, "too few values", "insert into g values (4, 1, 1, 'y')")
    x(mut &c, "insert v", "insert into g (id, a, b, v) values (4, 1, 1, 1)")
    x(mut &c, "insert w", "insert into g (id, a, b, w) values (4, 1, 1, 1)")
    x(mut &c, "insert u", "insert into g (id, a, b, u) values (4, 1, 1, 'q')")
    x(mut &c, "update v", "update g set v = 1 where id = 1")
    x(mut &c, "update u", "update g set u = 'q' where id = 1")
    x(mut &c, "update a", "update g set a = 10 where id = 1")
    x(mut &c, "update b and s", "update g set b = b + 1, s = 'new' where id = 2")
    q(mut &c, "select columns", "select id, a, b, v, w, s, u from g order by id")
    q(mut &c, "select star", "select * from g order by id")
    q(mut &c, "where virtual", "select id from g where v = 13")
    q(mut &c, "where either", "select id from g where w = 10 or u = 'NEW' order by id")
    q(mut &c, "group by virtual", "select v, count(*) from g group by v order by v")
    q(mut &c, "order by virtual", "select id, v from g order by v desc, id")
    x(mut &c, "index on virtual", "create index ix_v on g (v)")
    x(mut &c, "unique index on virtual", "create unique index ux_w on g (w)")
    x(mut &c, "unique violated", "insert into g (id, a, b) values (5, 5, 0)")
    x(mut &c, "insert 5", "insert into g (id, a, b) values (5, 4, 0)")
    q(mut &c, "read by index", "select id from g where v = 4")
    x(mut &c, "function-based case", "create index ix_case on g (case when a > 5 then 1 else 0 end)")
    x(mut &c, "function-based sum", "create index ix_sum on g (a + b)")
    x(mut &c, "function-based two", "create index ix_up on g (upper(s), a * 2 desc)")
    x(mut &c, "function-based unique", "create unique index ux_fn on g (nvl(b, 0) * 100 + id)")
    x(mut &c, "not pure", "create index ix_bad on g (sysdate + a)")
    x(mut &c, "no column", "create index ix_bad2 on g (nope + 1)")
    q(mut &c, "case predicate", "select id from g where case when a > 5 then 1 else 0 end = 1")
    q(mut &c, "sum predicate", "select id from g where a + b = 13")
    x(mut &c, "insert 6", "insert into g (id, a, b) values (6, 7, 7)")
    q(mut &c, "case after insert", "select id from g where case when a > 5 then 1 else 0 end = 1 order by id")
    q(mut &c, "sum after insert", "select id from g where a + b = 14")
    x(mut &c, "update 6", "update g set a = 1 where id = 6")
    q(mut &c, "sum after update", "select id from g where a + b = 14")
    q(mut &c, "sum after update 2", "select id from g where a + b = 8")
    x(mut &c, "unique function", "insert into g (id, a, b) values (7, 2, 0)")
    x(mut &c, "unique function again", "insert into g (id, a, b) values (7, 2, 0)")
    x(mut &c, "delete 6", "delete from g where id = 6")
    q(mut &c, "sum after delete", "select id from g where a + b = 8")
    q(mut &c, "indexes", "select index_name, index_type, uniqueness from user_indexes where table_name = 'G' and index_name <> 'G_PKEY' order by index_name")
    q(mut &c, "index columns", "select index_name, column_name, column_position, descend from user_ind_columns where table_name = 'G' and index_name in ('IX_CASE', 'IX_UP', 'IX_V', 'UX_W') order by index_name, column_position")
    q(mut &c, "index expressions", "select index_name, column_expression, column_position from user_ind_expressions where table_name = 'G' order by index_name, column_position")
    x(mut &c, "table c", "create table c (a number, b number generated always as (a * 2) virtual, c varchar2(5) as (to_char(a)), d number default 7)")
    q(mut &c, "tab cols", "select column_name, data_type, virtual_column, data_default, hidden_column from user_tab_cols where table_name = 'C' order by column_id")
    q(mut &c, "tab columns", "select column_name, data_type, data_default from user_tab_columns where table_name = 'C' order by column_id")
    x(mut &c, "insert c", "insert into c (a) values (12)")
    q(mut &c, "select c", "select * from c")
    x(mut &c, "add short", "alter table g add (x as (a + 1))")
    x(mut &c, "add virtual", "alter table g add x2 number generated always as (b + 1) virtual")
    x(mut &c, "add list", "alter table g add (x3 number as (a + 100) virtual)")
    q(mut &c, "added columns", "select id, a, x, x2, x3 from g order by id")
    x(mut &c, "reads a virtual", "alter table g add y as (v + 1)")
    x(mut &c, "unknown column", "alter table g add y number generated always as (nope + 1)")
    x(mut &c, "sysdate", "alter table g add y number generated always as (sysdate) virtual")
    x(mut &c, "subquery", "alter table g add y number generated always as ((select 1 from dual))")
    x(mut &c, "rename a read column", "alter table g rename column a to aa")
    x(mut &c, "rename a virtual column", "alter table g rename column w to ww")
    q(mut &c, "renamed", "select column_name from user_tab_cols where table_name = 'G' and column_name in ('A', 'AA', 'W', 'WW') order by column_name")
    x(mut &c, "modify a read column", "alter table g modify (a number(5))")
    x(mut &c, "drop a read column", "alter table g drop column a")
    x(mut &c, "drop a virtual column", "alter table g drop column x")
    q(mut &c, "columns", "select column_name from user_tab_cols where table_name = 'G' and column_name not like 'SYS_NC%' order by column_id")
    x(mut &c, "table not null", "create table h (a number, b number generated always as (a * 2) virtual not null)")
    x(mut &c, "not null ok", "insert into h (a) values (1)")
    x(mut &c, "not null violated", "insert into h (a) values (null)")
    x(mut &c, "table check", "create table h2 (a number, b number generated always as (a * 2) virtual, constraint ck check (b > 0))")
    x(mut &c, "check ok", "insert into h2 (a) values (1)")
    x(mut &c, "check violated", "insert into h2 (a) values (-1)")
    x(mut &c, "table key", "create table h3 (a number, b number generated always as (a * 2) virtual primary key)")
    x(mut &c, "key ok", "insert into h3 (a) values (1)")
    x(mut &c, "key violated", "insert into h3 (a) values (1)")
    x(mut &c, "table unique", "create table h6 (a number, b number generated always as (a * 2) virtual unique)")
    x(mut &c, "unique ok", "insert into h6 (a) values (1)")
    x(mut &c, "unique violated 2", "insert into h6 (a) values (1)")
    x(mut &c, "typeless", "create table h4 (a number, b generated always as (a * 2) virtual)")
    x(mut &c, "typeless insert", "insert into h4 (a) values (21)")
    q(mut &c, "typeless select", "select * from h4")
    x(mut &c, "table default", "create table h7 (a number, b number generated always as (a * 2) virtual default 3)")
    x(mut &c, "table reads virtual", "create table h8 (a number, b number generated always as (a * 2) virtual, c number as (b + 1))")
    x(mut &c, "table impure", "create table h9 (a number, b date generated always as (sysdate) virtual)")
    x(mut &c, "div table", "create table r1 (a number, b number generated always as (1 / a) virtual)")
    x(mut &c, "div insert", "insert into r1 (a) values (0)")
    x(mut &c, "div insert 2", "insert into r1 (a) values (4)")
    q(mut &c, "div other column", "select a from r1 order by a")
    x(mut &c, "div read", "select b from r1")
    q(mut &c, "div filtered", "select b from r1 where a = 4")
    x(mut &c, "add virtual over rows", "alter table r1 add (c number generated always as (a * 10) virtual)")
    q(mut &c, "add read", "select a, c from r1 where a = 4")
    c.logoff()
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
