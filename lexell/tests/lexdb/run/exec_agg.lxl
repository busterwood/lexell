// lexdb_exec: GROUP BY, HAVING, DISTINCT and the aggregates (count, sum,
// avg, min, max, string_agg, bool_and, bool_or, every, the variances and
// standard deviations; DISTINCT and FILTER on them). Expected output
// checked by hand when written.
// expect: create table t (id int primary key, g text, v int, n numeric(6,2)) -> CREATE TABLE
// expect: insert into t values (1,'a',1,1.50),(2,'a',3,null),(3,'b',null,2.25),(4,'b',5,1),(5,null,7,0.5) -> INSERT 0 5
// expect: select g, count(*), count(v), sum(v), avg(v), min(n), max(n), sum(n), avg(n) from t group by g order by g -> a|2|2|4|2.0000000000000000|1.50|1.50|1.50|1.5000000000000000; b|2|1|5|5.0000000000000000|1.00|2.25|3.25|1.6250000000000000; NULL|1|1|7|7.0000000000000000|0.50|0.50|0.50|0.5000000000000000
// expect: select g, sum(v) from t group by g having sum(v) > 3 order by g -> a|4; b|5; NULL|7
// expect: select g, count(*) as c from t group by 1 order by 1 -> a|2; b|2; NULL|1
// expect: select g as k, count(*) from t group by k order by k -> a|2; b|2; NULL|1
// expect: select count(distinct g), count(g), count(*) from t -> 2|4|5
// expect: select distinct g from t order by g -> a; b; NULL
// expect: select distinct v % 2 from t order by 1 -> 1; NULL
// expect: select distinct g from t order by v -> 42P10 for SELECT DISTINCT, ORDER BY expressions must appear in select list
// expect: select g, v from t group by g -> 42803 column "t.v" must appear in the GROUP BY clause or be used in an aggregate function
// expect: select id, g, v from t group by id order by id -> 1|a|1; 2|a|3; 3|b|NULL; 4|b|5; 5|NULL|7
// expect: select v % 2, count(*) from t group by v % 2 order by 1 -> 1|4; NULL|1
// expect: select sum(v) * 2 + count(*) from t -> 37
// expect: select string_agg(g, ',') from t -> a,a,b,b
// expect: select g, string_agg(cast(v as text), '+') from t group by g order by g -> a|1+3; b|5; NULL|7
// expect: select bool_and(v > 0), bool_or(v > 6), every(v > 2) from t -> t|t|f
// expect: select variance(v), var_pop(v), stddev(v), stddev_pop(v) from t -> 6.6666666666666667|5.0000000000000000|2.5819888974716113|2.2360679774997897
// expect: select stddev(n), variance(n) from t -> 0.7465197027987049|0.5572916666666667
// expect: select count(*) filter (where v > 2), sum(v) filter (where g = 'a') from t -> 3|4
// expect: select g, count(*) from t group by g having count(*) > 1 and min(v) > 0 order by g -> a|2; b|2
// expect: select count(*) from t having count(*) > 100 -> SELECT 0
// expect: select avg(v) from t where id > 99 -> NULL
// expect: select count(*) from t where id > 99 group by g -> SELECT 0
// expect: select sum(count(*)) from t -> 42803 aggregate function calls cannot be nested
// expect: select g from t group by count(*) -> 42803 aggregate functions are not allowed in GROUP BY
// expect: select g, count(*) from t group by g order by count(*) desc, g -> a|2; b|2; NULL|1
// expect: select max(v) - min(v) from t -> 6
// expect: select count(distinct v % 2) from t -> 1
// expect: select sum(distinct v) from t where v is not null -> 16
// expect: explain select g, count(*) from t group by g having count(*) > 1 -> scan t: full scan; aggregate; having
// expect: select g from t where count(*) > 1 -> 42803 aggregate functions are not allowed here
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"
fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            println(sql + " -> " + (if len(lines) == 0 { r.tag } else { strings.join(&lines, "; ") }))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}
fn main() {
    lexdb_store.run(lexdb_disk.sim(1), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000, bufferedPages: false}, fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st)
        show(mut &s, "create table t (id int primary key, g text, v int, n numeric(6,2))")
        show(mut &s, "insert into t values (1,'a',1,1.50),(2,'a',3,null),(3,'b',null,2.25),(4,'b',5,1),(5,null,7,0.5)")
        for q in ["select g, count(*), count(v), sum(v), avg(v), min(n), max(n), sum(n), avg(n) from t group by g order by g",
                  "select g, sum(v) from t group by g having sum(v) > 3 order by g",
                  "select g, count(*) as c from t group by 1 order by 1",
                  "select g as k, count(*) from t group by k order by k",
                  "select count(distinct g), count(g), count(*) from t",
                  "select distinct g from t order by g",
                  "select distinct v % 2 from t order by 1",
                  "select distinct g from t order by v",
                  "select g, v from t group by g",
                  "select id, g, v from t group by id order by id",
                  "select v % 2, count(*) from t group by v % 2 order by 1",
                  "select sum(v) * 2 + count(*) from t",
                  "select string_agg(g, ',') from t",
                  "select g, string_agg(cast(v as text), '+') from t group by g order by g",
                  "select bool_and(v > 0), bool_or(v > 6), every(v > 2) from t",
                  "select variance(v), var_pop(v), stddev(v), stddev_pop(v) from t",
                  "select stddev(n), variance(n) from t",
                  "select count(*) filter (where v > 2), sum(v) filter (where g = 'a') from t",
                  "select g, count(*) from t group by g having count(*) > 1 and min(v) > 0 order by g",
                  "select count(*) from t having count(*) > 100",
                  "select avg(v) from t where id > 99",
                  "select count(*) from t where id > 99 group by g",
                  "select sum(count(*)) from t",
                  "select g from t group by count(*)",
                  "select g, count(*) from t group by g order by count(*) desc, g",
                  "select max(v) - min(v) from t",
                  "select count(distinct v % 2) from t",
                  "select sum(distinct v) from t where v is not null",
                  "explain select g, count(*) from t group by g having count(*) > 1",
                  "select g from t where count(*) > 1"] { show(mut &s, q) }
        return 0
    }).unwrap()
}
