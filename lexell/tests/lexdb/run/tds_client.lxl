// lexdb_tds, SQL Server's protocol (design/lexdb-tds.md, stage S1), against
// Lexell's own SQL Server client (lib/sqlserver over tds): logins with TLS
// for the login only (Encrypt=no) and for everything; batches of
// lexdb's dialect with their row counts and result sets; every lexdb type
// as its TDS type; errors by SQL Server's numbers, the batch ending at the
// first; the SET options drivers send, NOCOUNT kept; stage S2: parameters
// (sp_executesql), OUTPUT parameters, Transaction Manager transactions,
// T-SQL variables, nested transactions with statement-level rollback,
// XACT_ABORT, savepoints, lexdb's dialect, RESETCONNECTION; passwords checked
// against the roles' verifiers under scram-sha-256; the database asked for.
// needs: ssl
// expect: plain: login only tds 0x74000004 database lexdb version 16.0.4315 collation 1033
// expect: create, insert: 3
// expect: update: 2
// expect: select: id int, name nvarchar, amount numeric, at datetime2 | 1 'café' 12.50 '2026-11-11 10:00:00.0000000' | 2 NULL -3.10 NULL | 3 'naïve 😀' 0.00 '2000-01-01 00:00:00.0000000'
// expect: two sets: 2 sets, counts 3
// expect: types: smallint int bigint bit float real decimal varbinary uniqueidentifier date time datetime2 datetimeoffset nvarchar nvarchar
// expect: values: 7 -8 9000000000 true 1.5 0.25 123456789012345678901234567890.123 x'00ff' '00000000-0000-0000-0000-000000000001' '2026-11-11' '13:14:15.5000000' '2026-11-11 10:00:00.2500000' '2026-11-11 10:00:00.0000000 +00:00' '1 day' 'text'
// expect: nulls: NULL NULL NULL NULL NULL NULL NULL NULL NULL NULL NULL NULL NULL NULL
// expect: long text: nvarchar 5000
// expect: missing table: error 208
// expect: divide: error 8134
// expect: duplicate: error 2627
// expect: syntax: error 102
// expect: errors do not end the batch: 1,2,3,4,5
// expect: date out of range: error 8115
// expect: set options: ok
// expect: nocount: -1
// expect: count again: 1
// expect: implicit transactions: 1 then 0
// expect: parameters: 42 'héllo' NULL true 2.5 12.34 x'78'
// expect: parameter compared: 'café'
// expect: parameters twice: 2,3
// expect: output parameter: 42
// expect: transaction committed: 7
// expect: transaction rolled back: 0
// expect: variables: 10 'ten' 3
// expect: select assigns: 5 2
// expect: undeclared: error 137
// expect: nested: 2 1 0, rows 1
// expect: statement rolled back: 2627 then 1 row, trancount 2
// expect: xact_abort: 2627, trancount 0, rows 0
// expect: savepoint: 1
// expect: commit without begin: error 3902
// expect: syntax error runs nothing: error 102, rows 0
// expect: unknown table ends the batch: error 208, rows '40'
// expect: quoted identifier off: 'str'
// expect: brackets and N strings: 'café'
// expect: spelling kept: OrderId int, Ship Name nvarchar | 1 'x'
// expect: spelling of the query: orderID int, Who nvarchar | 1 'x'
// expect: spelling through a subquery: ORDERID int | 1
// expect: name taken in another case: error 2714
// expect: case ignored: 3
// expect: grouped by the first: 'alice' 2,'bob' 3
// expect: distinct, min, max: 2 'alice' 'bob'
// expect: literals: 1 0 1 0
// expect: key ignores case: error 2627, found 'x'
// expect: collation conflict: error 468
// expect: explicit collation: 1
// expect: joined on the key: 13
// expect: SQL Server's order: 6,4,5,3,2,1,11,10,9,7,8
// expect: postgres dialect: 4
// expect: reset: resets 1, trancount 0, nocount off 1
// expect: tls: full
// expect: login only: login only
// expect: scram: app
// expect: wrong password: error 18456
// expect: no login: error 18456
// expect: no such role: error 18456
// expect: master: lexdb
// expect: other database: error 4060
import "task"
import "net"
import "strings"
import "sqlserver"
import "sqldialect"
import "../../../lib/tests/support/tlstest"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

fn cs(port: &str, user: &str, pw: &str, extra: &str): str {
    return "Server=127.0.0.1," + port + ";UID=" + user + ";PWD=" + pw + ";" + extra
}

fn connect(s: &str): sqlserver.Conn {
    match sqlserver.connect(s.toStr()) {
        Ok(c) { return c }
        Err(e) {
            println("connect: error " + e.code.toStr() + " " + e.msg)
            exit(1)
        }
    }
}

fn code(r: Result[sqlserver.Conn, sqlserver.Error]): str {
    match r {
        Ok(c) { return "connected as " + c.database() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn values(rows: &sqlserver.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.value(row, i) {
            Ok(v) { append(mut &out, v.toStr()) }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, " ")
}

fn show(r: Result[sqlserver.Rows, sqlserver.Error]): str {
    match r {
        Ok(rows) {
            var cols: []str = []
            for j in 0..rows.columnCount() {
                append(mut &cols, rows.columnName(j).unwrap() + " " + rows.columnTypeName(j).unwrap())
            }
            var out = strings.join(&cols, ", ")
            for i in 0..rows.rowCount() { out = out + " | " + values(&rows, i) }
            return out
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn err(r: Result[int, sqlserver.Error]): str {
    match r {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn q1(c: mut &sqlserver.Conn, sql: &str): str {
    match c.query(sql.toStr(), &[]) {
        Ok(r) {
            var out: []str = []
            for i in 0..r.rowCount() { append(mut &out, values(&r, i)) }
            return strings.join(&out, ",")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// Stage S2: RPC, transactions, T-SQL variables.
fn s2(c: mut &sqlserver.Conn) {
    match c.query("SELECT @p1 + 1 AS a, @p2 AS b, @p3 AS c, @p4 AS d, @p5 AS e, @p6 AS f, @p7 AS g",
                  &[sqldialect.Value.Int(41), sqldialect.Value.Text("héllo"), sqldialect.Value.Null, sqldialect.Value.Bool(true), sqldialect.Value.Float(2.5f), sqldialect.Value.Dec(12.34m), sqldialect.Value.Bytes("x")]) {
        Ok(r) { println("parameters: " + values(&r, 0)) }
        Err(e) { println("parameters: error " + e.code.toStr() + " " + e.msg) }
    }
    match c.query("select name from t where id = @p1", &[sqldialect.Value.Int(1)]) {
        Ok(r) { println("parameter compared: " + values(&r, 0)) }
        Err(e) { println("parameter compared: error " + e.code.toStr() + " " + e.msg) }
    }
    match c.query("select @p1 + 1 union all select @p1 + 2 order by 1", &[sqldialect.Value.Int(1)]) {
        Ok(r) { println("parameters twice: " + r.text(0, 0).unwrap() + "," + r.text(1, 0).unwrap()) }
        Err(e) { println("parameters twice: error " + e.code.toStr() + " " + e.msg) }
    }
    let outs = [sqlserver.Out{name: "@total", sqlType: "int"}]
    match c.call("SET @total = @p1 * 2", &[sqldialect.Value.Int(21)], &outs) {
        Ok(r) { println("output parameter: " + values(&r.outputs, 0)) }
        Err(e) { println("output parameter: error " + e.code.toStr() + " " + e.msg) }
    }
    c.exec("create table acct (id int primary key, n int)").unwrap()
    let tc = c.transaction(fn(x: mut &sqlserver.Conn): Result[int, sqlserver.Error] {
        return x.run("insert into acct values (@p1, 7)", &[sqldialect.Value.Int(1)])
    })
    println("transaction committed: " + q1(c, &"select n from acct"))
    let tr = c.transaction(fn(x: mut &sqlserver.Conn): Result[int, sqlserver.Error] {
        let n = try x.run("insert into acct values (2, 8)", &[])
        return Err(sqldialect.inputError("no"))
    })
    println("transaction rolled back: " + q1(c, &"select count(*) from acct where id = 2"))
    println("variables: " + q1(c, &"DECLARE @n int = 10, @s nvarchar(10); SET @s = N'ten'; DECLARE @k int; SELECT @k = count(*) FROM t WHERE id < 4; SELECT @n, @s, @k"))
    println("select assigns: " + q1(c, &"DECLARE @a int, @b int; SELECT @a = max(id), @b = count(*) FROM t WHERE id IN (2, 5); SELECT @a, @b"))
    println("undeclared: " + q1(c, &"SELECT @nope"))
    println("nested: " + q1(c, &"BEGIN TRAN; BEGIN TRANSACTION; INSERT INTO acct VALUES (10, 1); DECLARE @a int = @@TRANCOUNT; COMMIT; DECLARE @b int = @@TRANCOUNT; COMMIT TRAN; SELECT @a, @b, @@TRANCOUNT") +
            ", rows " + q1(c, &"select count(*) from acct where id = 10"))
    let sr = c.exec("BEGIN TRAN; INSERT INTO acct VALUES (10, 2); INSERT INTO acct VALUES (11, @@TRANCOUNT); COMMIT")
    let srCode = match sr {
        Ok(_) { 0 }
        Err(e) { e.code }
    }
    println("statement rolled back: " + srCode.toStr() + " then " + q1(c, &"select count(*) from acct where id = 11") + " row, trancount " +
            q1(c, &"select n from acct where id = 11"))
    let xa = c.exec("SET XACT_ABORT ON; BEGIN TRAN; INSERT INTO acct VALUES (12, 1); INSERT INTO acct VALUES (10, 3); INSERT INTO acct VALUES (13, 1); COMMIT")
    let xaCode = match xa {
        Ok(_) { 0 }
        Err(e) { e.code }
    }
    c.exec("SET XACT_ABORT OFF").unwrap()
    println("xact_abort: " + xaCode.toStr() + ", trancount " + q1(c, &"select @@trancount") + ", rows " + q1(c, &"select count(*) from acct where id in (12, 13)"))
    println("savepoint: " + q1(c, &"BEGIN TRAN; INSERT INTO acct VALUES (20, 1); SAVE TRAN s1; INSERT INTO acct VALUES (21, 1); ROLLBACK TRAN s1; COMMIT; SELECT count(*) FROM acct WHERE id IN (20, 21)"))
    println("commit without begin: " + q1(c, &"COMMIT"))
    let se = q1(c, &"INSERT INTO acct VALUES (30, 1); SELEC 1")
    println("syntax error runs nothing: " + se + ", rows " + q1(c, &"select count(*) from acct where id = 30"))
    let ut = c.exec("INSERT INTO acct VALUES (40, 1); SELECT * FROM nope; INSERT INTO acct VALUES (41, 1)")
    let utCode = match ut {
        Ok(_) { 0 }
        Err(e) { e.code }
    }
    println("unknown table ends the batch: error " + utCode.toStr() + ", rows " + q1(c, &"select string_agg(id::text, ',') from acct where id in (40, 41)"))
    println("quoted identifier off: " + q1(c, &"SET QUOTED_IDENTIFIER OFF; SELECT \"str\"") )
    c.exec("SET QUOTED_IDENTIFIER ON").unwrap()
    println("brackets and N strings: " + q1(c, &"SELECT [name] AS [the name] FROM [t] WHERE [id] = 1 AND N'ok' = N'ok'"))
    // L6: names matched without regard to case, shown as written (as the oracle shows them)
    c.exec("CREATE TABLE Orders (OrderId int PRIMARY KEY, [Ship Name] nvarchar(20))").unwrap()
    c.exec("INSERT INTO orders (orderid, [SHIP NAME]) VALUES (1, N'x')").unwrap()
    println("spelling kept: " + show(c.query("SELECT * FROM ORDERS", &[])))
    println("spelling of the query: " + show(c.query("SELECT orderID, o.[ship name] AS Who FROM [orders] AS O", &[])))
    println("spelling through a subquery: " + show(c.query("SELECT * FROM (SELECT ORDERID FROM Orders) s", &[])))
    println("name taken in another case: " + err(c.run("CREATE TABLE ORDERS (a int)", &[])))
    // L2: SQL Server's default collation on text columns made over TDS (the oracle's answers)
    c.exec("CREATE TABLE people (id int PRIMARY KEY, nm nvarchar(20))").unwrap()
    c.exec("INSERT INTO people VALUES (1, N'bob'), (2, N'Bob'), (3, N'BOB '), (4, N'alice'), (5, N'Alice')").unwrap()
    println("case ignored: " + q1(c, &"SELECT count(*) FROM people WHERE nm = 'BOB'"))
    println("grouped by the first: " + q1(c, &"SELECT nm, count(*) FROM people GROUP BY nm ORDER BY nm"))
    println("distinct, min, max: " + q1(c, &"SELECT count(DISTINCT nm), min(nm), max(nm) FROM people"))
    println("literals: " + q1(c, &"SELECT CASE WHEN 'a' = 'A' THEN 1 ELSE 0 END, CASE WHEN N'a ' LIKE N'A' THEN 1 ELSE 0 END, CASE WHEN N'é' = N'É' THEN 1 ELSE 0 END, CASE WHEN N'e' = N'é' THEN 1 ELSE 0 END"))
    c.exec("CREATE TABLE tags (t nvarchar(20) PRIMARY KEY)").unwrap()
    c.exec("INSERT INTO tags VALUES (N'x')").unwrap()
    println("key ignores case: " + err(c.run("INSERT INTO tags VALUES (N'X ')", &[])) + ", found " + q1(c, &"SELECT t FROM tags WHERE t = 'X'"))
    c.exec("CREATE TABLE cs (a nvarchar(10) COLLATE Latin1_General_CS_AS, b nvarchar(10))").unwrap()
    println("collation conflict: " + q1(c, &"SELECT * FROM cs WHERE a = b"))
    println("explicit collation: " + q1(c, &"SELECT count(*) FROM people WHERE nm = 'BOB' COLLATE Latin1_General_CS_AS"))
    println("joined on the key: " + q1(c, &"SELECT count(*) FROM people a JOIN people b ON a.nm = b.nm"))
    c.exec("CREATE TABLE words (id int PRIMARY KEY, w nvarchar(20))").unwrap()
    c.exec("INSERT INTO words VALUES (1, N'cop'), (2, N'coöp'), (3, N'co-op'), (4, N'Coop'), (5, N'-coop'), (6, N'co op'), (7, N'straße'), (8, N'strasse'), (9, N'éa'), (10, N'ea'), (11, N'é')").unwrap()
    println("SQL Server's order: " + q1(c, &"SELECT id FROM words ORDER BY w, id"))
    c.exec("SET LEXDB_DIALECT POSTGRES").unwrap()
    println("postgres dialect: " + q1(c, &"select count(*) from t where name is not null and \"id\" > 0"))
    c.exec("SET LEXDB_DIALECT TSQL").unwrap()
    // a pooled connection given back: the next request asks for RESETCONNECTION
    c.exec("SET NOCOUNT ON; BEGIN TRAN").unwrap()
    c.exec("COMMIT").unwrap()
    let rel = c.release()
    c.reuse().unwrap()
    let n = c.run("update acct set n = n where id = 1", &[]).unwrap()
    println("reset: resets " + c.resets().toStr() + ", trancount " + q1(c, &"select @@trancount") + ", nocount off " + n.toStr())
}

fn client(st: &lexdb_store.Store, port: &str) {
    let plain = cs(port, &"sa", &"anything", &"Encrypt=no;TrustServerCertificate=yes")
    var c = connect(&plain)
    println("plain: " + c.encryption() + " tds 0x" + strings.hex(c.tdsVersion()) + " database " + c.database() +
            " version " + c.serverVersion() + " collation " + c.collation().lcid.toStr())
    c.exec("create table t (id int primary key, name text, amount numeric(10,2), at datetime2)").unwrap()
    println("create, insert: " + err(c.run("insert into t values (1, 'café', 12.5, '2026-11-11 10:00'), (2, null, -3.1, null), (3, 'naïve 😀', 0, '2000-01-01')", &[])))
    println("update: " + err(c.run("update t set amount = amount where id < 3", &[])))
    println("select: " + show(c.query("select * from t order by id", &[])))
    match c.queryAll("select 1; select 2 as two; update t set id = id", &[]) {
        Ok(r) { println("two sets: " + len(r.sets).toStr() + " sets, counts " + r.counts[len(r.counts) - 1].rows.toStr()) }
        Err(e) { println("two sets: error " + e.code.toStr()) }
    }
    let typed = "select 7::int2 as a, -8 as b, 9000000000 as c, true as d, 1.5::float8 as e, 0.25::real as f, " +
                "123456789012345678901234567890.123 as g, '\\x00ff'::bytea as h, '00000000-0000-0000-0000-000000000001'::uuid as i, " +
                "'2026-11-11'::date as j, '13:14:15.5'::time as k, '2026-11-11 10:00:00.25'::datetime2 as l, " +
                "'2026-11-11 10:00:00+00'::timestamptz as m, interval '1 day' as n, 'text' as o"
    match c.query(typed, &[]) {
        Ok(rows) {
            var ts: []str = []
            for j in 0..rows.columnCount() { append(mut &ts, rows.columnTypeName(j).unwrap()) }
            println("types: " + strings.join(&ts, " "))
            println("values: " + values(&rows, 0))
        }
        Err(e) { println("types: error " + e.code.toStr() + " " + e.msg) }
    }
    let nulls = "select null::int2, null::int, null::int8, null::bool, null::float8, null::real, null::numeric, null::bytea, " +
                "null::uuid, null::date, null::time, null::datetime2, null::timestamptz, null::text"
    match c.query(nulls, &[]) {
        Ok(rows) { println("nulls: " + values(&rows, 0)) }
        Err(e) { println("nulls: error " + e.code.toStr() + " " + e.msg) }
    }
    match c.query("select repeat('x', 5000) as s", &[]) {
        Ok(rows) { println("long text: " + rows.columnTypeName(0).unwrap() + " " + len(rows.text(0, 0).unwrap()).toStr()) }
        Err(e) { println("long text: error " + e.code.toStr()) }
    }
    println("missing table: " + show(c.query("select * from nope", &[])))
    println("divide: " + show(c.query("select 1 / 0", &[])))
    println("duplicate: " + err(c.run("insert into t values (1, 'again', 0, null)", &[])))
    println("syntax: " + err(c.run("selec 1", &[])))
    let r = c.run("insert into t values (4, 'a', 0, null); insert into t values (1, 'dup', 0, null); insert into t values (5, 'b', 0, null)", &[])
    println("errors do not end the batch: " + c.query("select string_agg(id::text, ',' order by id) from t", &[]).unwrap().text(0, 0).unwrap())
    println("date out of range: " + show(c.query("select '0044-03-15 BC'::date", &[])))
    match c.exec("SET QUOTED_IDENTIFIER OFF; SET TEXTSIZE 4096\nSET ANSI_NULLS, ANSI_PADDING ON SET TRANSACTION ISOLATION LEVEL READ COMMITTED") {
        Ok(_) { println("set options: ok") }
        Err(e) { println("set options: error " + e.code.toStr() + " " + e.msg) }
    }
    c.exec("set nocount on").unwrap()
    println("nocount: " + err(c.run("update t set amount = 1 where id = 1", &[])))
    c.exec("SET NOCOUNT OFF").unwrap()
    println("count again: " + err(c.run("update t set amount = 1 where id = 1", &[])))
    c.exec("SET IMPLICIT_TRANSACTIONS ON").unwrap()
    let it1 = c.query("update t set amount = 2 where id = 1; select @@trancount", &[]).unwrap().text(0, 0).unwrap()
    let it2 = c.query("commit; select @@trancount", &[]).unwrap().text(0, 0).unwrap()
    c.exec("SET IMPLICIT_TRANSACTIONS OFF").unwrap()
    println("implicit transactions: " + it1 + " then " + it2)
    s2(mut &c)
    c.exec("create role app login password 'S3cret'").unwrap()
    c.exec("create role ro password 'S3cret'").unwrap()
    c.exec("grant select on t to app").unwrap()
    c.close()

    // TLS: the accept loop reads the certificate when it starts (body)
    let tlsOn = cs(port, &"sa", &"x", &"Encrypt=yes;TrustServerCertificate=yes")
    var e = connect(&tlsOn)
    println("tls: " + e.encryption())
    e.close()
    var lo = connect(&cs(port, &"sa", &"x", &"Encrypt=no;TrustServerCertificate=yes"))
    println("login only: " + lo.encryption())
    lo.close()

    // passwords: the roles' SCRAM verifiers
    var conf = lexdb_wire.confOf(st)
    conf.tcp = "scram-sha-256"
    lexdb_wire.configure(st, &conf).unwrap()
    var a = connect(&cs(port, &"app", &"S3cret", &"Encrypt=yes;TrustServerCertificate=yes"))
    println("scram: " + a.query("select current_user", &[]).unwrap().text(0, 0).unwrap())
    a.close()
    println("wrong password: " + code(sqlserver.connect(cs(port, &"app", &"nope", &"Encrypt=yes;TrustServerCertificate=yes"))))
    println("no login: " + code(sqlserver.connect(cs(port, &"ro", &"S3cret", &"Encrypt=yes;TrustServerCertificate=yes"))))
    println("no such role: " + code(sqlserver.connect(cs(port, &"ghost", &"S3cret", &"Encrypt=yes;TrustServerCertificate=yes"))))
    let m = sqlserver.connect(cs(port, &"app", &"S3cret", &"Encrypt=yes;TrustServerCertificate=yes;Database=master"))
    match m {
        Ok(x) { println("master: " + x.database()) }
        Err(x) { println("master: error " + x.code.toStr()) }
    }
    println("other database: " + code(sqlserver.connect(cs(port, &"app", &"S3cret", &"Encrypt=yes;TrustServerCertificate=yes;Database=sales"))))
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        // the accept loop reads the TLS files when it starts: configured first;
        // a client that asks for no encryption still gets none (Encrypt=no
        // with a certificate is TLS for the login only)
        var conf = lexdb_wire.noAuth()
        conf.cert = tlstest.path("srv.pem")
        conf.key = tlstest.path("srv.key")
        lexdb_wire.configure(&st, &conf).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st})
        client(&st, &addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    tlstest.pki()
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
