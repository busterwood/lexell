const QUERIES = "@once CREATE TABLE b4t (id int PRIMARY KEY, v int)\nCREATE TABLE add (a int)\nCREATE TABLE all (a int)\nCREATE TABLE alter (a int)\nCREATE TABLE and (a int)\nCREATE TABLE any (a int)\nCREATE TABLE as (a int)\nCREATE TABLE asc (a int)\nCREATE TABLE authorization (a int)\nCREATE TABLE backup (a int)\nCREATE TABLE begin (a int)\nCREATE TABLE between (a int)\nCREATE TABLE break (a int)\nCREATE TABLE browse (a int)\nCREATE TABLE bulk (a int)\nCREATE TABLE by (a int)\nCREATE TABLE cascade (a int)\nCREATE TABLE case (a int)\nCREATE TABLE check (a int)\nCREATE TABLE checkpoint (a int)\nCREATE TABLE close (a int)\nCREATE TABLE clustered (a int)\nCREATE TABLE coalesce (a int)\nCREATE TABLE collate (a int)\nCREATE TABLE column (a int)\nCREATE TABLE commit (a int)\nCREATE TABLE compute (a int)\nCREATE TABLE constraint (a int)\nCREATE TABLE contains (a int)\nCREATE TABLE containstable (a int)\nCREATE TABLE continue (a int)\nCREATE TABLE convert (a int)\nCREATE TABLE create (a int)\nCREATE TABLE cross (a int)\nCREATE TABLE current (a int)\nCREATE TABLE current_date (a int)\nCREATE TABLE current_time (a int)\nCREATE TABLE current_timestamp (a int)\nCREATE TABLE current_user (a int)\nCREATE TABLE cursor (a int)\nCREATE TABLE database (a int)\nCREATE TABLE dbcc (a int)\nCREATE TABLE deallocate (a int)\nCREATE TABLE declare (a int)\nCREATE TABLE default (a int)\nCREATE TABLE delete (a int)\nCREATE TABLE deny (a int)\nCREATE TABLE desc (a int)\nCREATE TABLE disk (a int); DROP TABLE disk\nCREATE TABLE distinct (a int)\nCREATE TABLE distributed (a int)\nCREATE TABLE double (a int)\nCREATE TABLE drop (a int)\nCREATE TABLE dump (a int); DROP TABLE dump\nCREATE TABLE else (a int)\nCREATE TABLE end (a int)\nCREATE TABLE errlvl (a int)\nCREATE TABLE escape (a int)\nCREATE TABLE except (a int)\nCREATE TABLE exec (a int)\nCREATE TABLE execute (a int)\nCREATE TABLE exists (a int)\nCREATE TABLE exit (a int)\nCREATE TABLE external (a int)\nCREATE TABLE fetch (a int)\nCREATE TABLE file (a int)\nCREATE TABLE fillfactor (a int)\nCREATE TABLE for (a int)\nCREATE TABLE foreign (a int)\nCREATE TABLE freetext (a int)\nCREATE TABLE freetexttable (a int)\nCREATE TABLE from (a int)\nCREATE TABLE full (a int)\nCREATE TABLE function (a int)\nCREATE TABLE goto (a int)\nCREATE TABLE grant (a int)\nCREATE TABLE group (a int)\nCREATE TABLE having (a int)\nCREATE TABLE identity (a int)\nCREATE TABLE identity_insert (a int)\nCREATE TABLE identitycol (a int)\nCREATE TABLE if (a int)\nCREATE TABLE in (a int)\nCREATE TABLE inner (a int)\nCREATE TABLE insert (a int)\nCREATE TABLE intersect (a int)\nCREATE TABLE into (a int)\nCREATE TABLE is (a int)\nCREATE TABLE join (a int)\nCREATE TABLE key (a int)\nCREATE TABLE kill (a int)\nCREATE TABLE left (a int)\nCREATE TABLE like (a int)\nCREATE TABLE lineno (a int)\nCREATE TABLE load (a int); DROP TABLE load\nCREATE TABLE merge (a int)\nCREATE TABLE national (a int)\nCREATE TABLE nocheck (a int)\nCREATE TABLE nonclustered (a int)\nCREATE TABLE not (a int)\nCREATE TABLE null (a int)\nCREATE TABLE nullif (a int)\nCREATE TABLE of (a int)\nCREATE TABLE off (a int)\nCREATE TABLE offsets (a int)\nCREATE TABLE on (a int)\nCREATE TABLE open (a int)\nCREATE TABLE opendatasource (a int)\nCREATE TABLE openquery (a int)\nCREATE TABLE openrowset (a int)\nCREATE TABLE openxml (a int)\nCREATE TABLE option (a int)\nCREATE TABLE or (a int)\nCREATE TABLE order (a int)\nCREATE TABLE outer (a int)\nCREATE TABLE over (a int)\nCREATE TABLE percent (a int)\nCREATE TABLE pivot (a int)\nCREATE TABLE plan (a int)\nCREATE TABLE precision (a int); DROP TABLE precision\nCREATE TABLE primary (a int)\nCREATE TABLE print (a int)\nCREATE TABLE proc (a int)\nCREATE TABLE procedure (a int)\nCREATE TABLE public (a int)\nCREATE TABLE raiserror (a int)\nCREATE TABLE read (a int)\nCREATE TABLE readtext (a int)\nCREATE TABLE reconfigure (a int)\nCREATE TABLE references (a int)\nCREATE TABLE replication (a int)\nCREATE TABLE restore (a int)\nCREATE TABLE restrict (a int)\nCREATE TABLE return (a int)\nCREATE TABLE revert (a int)\nCREATE TABLE revoke (a int)\nCREATE TABLE right (a int)\nCREATE TABLE rollback (a int)\nCREATE TABLE rowcount (a int)\nCREATE TABLE rowguidcol (a int)\nCREATE TABLE rule (a int)\nCREATE TABLE save (a int)\nCREATE TABLE schema (a int)\nCREATE TABLE securityaudit (a int); DROP TABLE securityaudit\nCREATE TABLE select (a int)\nCREATE TABLE semantickeyphrasetable (a int)\nCREATE TABLE semanticsimilaritydetailstable (a int)\nCREATE TABLE semanticsimilaritytable (a int)\nCREATE TABLE session_user (a int)\nCREATE TABLE set (a int)\nCREATE TABLE setuser (a int)\nCREATE TABLE shutdown (a int)\nCREATE TABLE some (a int)\nCREATE TABLE statistics (a int)\nCREATE TABLE system_user (a int)\nCREATE TABLE table (a int)\nCREATE TABLE tablesample (a int)\nCREATE TABLE textsize (a int)\nCREATE TABLE then (a int)\nCREATE TABLE to (a int)\nCREATE TABLE top (a int)\nCREATE TABLE tran (a int)\nCREATE TABLE transaction (a int)\nCREATE TABLE trigger (a int)\nCREATE TABLE truncate (a int)\nCREATE TABLE try_convert (a int)\nCREATE TABLE tsequal (a int)\nCREATE TABLE union (a int)\nCREATE TABLE unique (a int)\nCREATE TABLE unpivot (a int)\nCREATE TABLE update (a int)\nCREATE TABLE updatetext (a int)\nCREATE TABLE use (a int)\nCREATE TABLE user (a int)\nCREATE TABLE values (a int)\nCREATE TABLE varying (a int)\nCREATE TABLE view (a int)\nCREATE TABLE waitfor (a int)\nCREATE TABLE when (a int)\nCREATE TABLE where (a int)\nCREATE TABLE while (a int)\nCREATE TABLE with (a int)\nCREATE TABLE writetext (a int)\nCREATE TABLE [rule] (a int); INSERT INTO [rule] VALUES (1); SELECT a FROM [rule]; DROP TABLE [rule]\nCREATE TABLE b4c (rule int)\nSELECT * FROM rule\nSELECT 1 AS x FROM b4t AS rule\nCREATE TABLE [file] (a int); INSERT INTO [file] VALUES (1); SELECT a FROM [file]; DROP TABLE [file]\nCREATE TABLE b4c (file int)\nSELECT * FROM file\nSELECT 1 AS x FROM b4t AS file\nCREATE TABLE [plan] (a int); INSERT INTO [plan] VALUES (1); SELECT a FROM [plan]; DROP TABLE [plan]\nCREATE TABLE b4c (plan int)\nSELECT * FROM plan\nSELECT 1 AS x FROM b4t AS plan\nCREATE TABLE [key] (a int); INSERT INTO [key] VALUES (1); SELECT a FROM [key]; DROP TABLE [key]\nCREATE TABLE b4c (key int)\nSELECT * FROM key\nSELECT 1 AS x FROM b4t AS key\nCREATE TABLE [user] (a int); INSERT INTO [user] VALUES (1); SELECT a FROM [user]; DROP TABLE [user]\nCREATE TABLE b4c (user int)\nSELECT * FROM user\nSELECT 1 AS x FROM b4t AS user\nCREATE TABLE [percent] (a int); INSERT INTO [percent] VALUES (1); SELECT a FROM [percent]; DROP TABLE [percent]\nCREATE TABLE b4c (percent int)\nSELECT * FROM percent\nSELECT 1 AS x FROM b4t AS percent\nCREATE TABLE [open] (a int); INSERT INTO [open] VALUES (1); SELECT a FROM [open]; DROP TABLE [open]\nCREATE TABLE b4c (open int)\nSELECT * FROM open\nSELECT 1 AS x FROM b4t AS open\nCREATE TABLE name (name int); INSERT INTO name VALUES (1); SELECT name FROM name; DROP TABLE name\nCREATE TABLE type (type int); INSERT INTO type VALUES (1); SELECT type FROM type; DROP TABLE type\nCREATE TABLE status (status int); INSERT INTO status VALUES (1); SELECT status FROM status; DROP TABLE status\nCREATE TABLE level (level int); INSERT INTO level VALUES (1); SELECT level FROM level; DROP TABLE level\nCREATE TABLE value (value int); INSERT INTO value VALUES (1); SELECT value FROM value; DROP TABLE value\nCREATE TABLE date (date int); INSERT INTO date VALUES (1); SELECT date FROM date; DROP TABLE date\nCREATE TABLE text (text int); INSERT INTO text VALUES (1); SELECT text FROM text; DROP TABLE text\nCREATE TABLE source (source int); INSERT INTO source VALUES (1); SELECT source FROM source; DROP TABLE source\nCREATE TABLE target (target int); INSERT INTO target VALUES (1); SELECT target FROM target; DROP TABLE target\nCREATE TABLE action (action int); INSERT INTO action VALUES (1); SELECT action FROM action; DROP TABLE action\nCREATE TABLE role (role int); INSERT INTO role VALUES (1); SELECT role FROM role; DROP TABLE role\nCREATE TABLE data (data int); INSERT INTO data VALUES (1); SELECT data FROM data; DROP TABLE data\nCREATE TABLE row (row int); INSERT INTO row VALUES (1); SELECT row FROM row; DROP TABLE row\nCREATE TABLE rows (rows int); INSERT INTO rows VALUES (1); SELECT rows FROM rows; DROP TABLE rows\nCREATE TABLE first (first int); INSERT INTO first VALUES (1); SELECT first FROM first; DROP TABLE first\nCREATE TABLE last (last int); INSERT INTO last VALUES (1); SELECT last FROM last; DROP TABLE last\nCREATE TABLE next (next int); INSERT INTO next VALUES (1); SELECT next FROM next; DROP TABLE next\nCREATE TABLE partition (partition int); INSERT INTO partition VALUES (1); SELECT partition FROM partition; DROP TABLE partition\nCREATE TABLE range (range int); INSERT INTO range VALUES (1); SELECT range FROM range; DROP TABLE range\nCREATE TABLE returns (returns int); INSERT INTO returns VALUES (1); SELECT returns FROM returns; DROP TABLE returns\nCREATE TABLE language (language int); INSERT INTO language VALUES (1); SELECT language FROM language; DROP TABLE language\nCREATE TABLE max (max int); INSERT INTO max VALUES (1); SELECT max FROM max; DROP TABLE max\nCREATE TABLE min (min int); INSERT INTO min VALUES (1); SELECT min FROM min; DROP TABLE min\nCREATE TABLE count (count int); INSERT INTO count VALUES (1); SELECT count FROM count; DROP TABLE count\nCREATE TABLE sum (sum int); INSERT INTO sum VALUES (1); SELECT sum FROM sum; DROP TABLE sum\nCREATE TABLE password (password int); INSERT INTO password VALUES (1); SELECT password FROM password; DROP TABLE password\nCREATE TABLE login (login int); INSERT INTO login VALUES (1); SELECT login FROM login; DROP TABLE login\nCREATE TABLE zone (zone int); INSERT INTO zone VALUES (1); SELECT zone FROM zone; DROP TABLE zone\nCREATE TABLE time (time int); INSERT INTO time VALUES (1); SELECT time FROM time; DROP TABLE time\nCREATE TABLE year (year int); INSERT INTO year VALUES (1); SELECT year FROM year; DROP TABLE year\nCREATE TABLE month (month int); INSERT INTO month VALUES (1); SELECT month FROM month; DROP TABLE month\nCREATE TABLE day (day int); INSERT INTO day VALUES (1); SELECT day FROM day; DROP TABLE day\nCREATE TABLE hour (hour int); INSERT INTO hour VALUES (1); SELECT hour FROM hour; DROP TABLE hour\nCREATE TABLE sql (sql int); INSERT INTO sql VALUES (1); SELECT sql FROM sql; DROP TABLE sql\nCREATE TABLE output (output int); INSERT INTO output VALUES (1); SELECT output FROM output; DROP TABLE output\nCREATE TABLE output_x (output_x int); INSERT INTO output_x VALUES (1); SELECT output_x FROM output_x; DROP TABLE output_x\nCREATE TABLE matched (matched int); INSERT INTO matched VALUES (1); SELECT matched FROM matched; DROP TABLE matched\nCREATE TABLE nocount (nocount int); INSERT INTO nocount VALUES (1); SELECT nocount FROM nocount; DROP TABLE nocount\nCREATE TABLE xml (xml int); INSERT INTO xml VALUES (1); SELECT xml FROM xml; DROP TABLE xml\nCREATE TABLE json (json int); INSERT INTO json VALUES (1); SELECT json FROM json; DROP TABLE json\nSELECT 1 AS x FROM b4t AS status\nSELECT 1 AS x FROM b4t status\nSELECT 1 AS rule\nSELECT 1 AS [rule]\nSELECT 1 AS x FROM b4t AS [rule]"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(76), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
