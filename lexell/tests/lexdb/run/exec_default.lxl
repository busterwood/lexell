// lexdb_exec: column defaults (design/lexdb.md 9.38). CREATE TABLE's
// DEFAULT; INSERT leaving columns out, DEFAULT in VALUES, DEFAULT VALUES,
// INSERT ... SELECT; UPDATE SET c = DEFAULT; defaults checked when made.
// ALTER TABLE ADD COLUMN ... DEFAULT: the rows there read the default
// without being written (rows with long texts, narrowed reads, an index made
// after, after a DROP COLUMN); SET DEFAULT and DROP DEFAULT change new rows
// only; a type change checks the default and rewrites the old rows' values;
// rolled back; after a reopen.
// expect: created: CREATE TABLE
// expect: left out: 1|3|ab|2.50|t|X|{1,2}|7 2|3|ab|2.50|t|X|{1,2}|7
// expect: DEFAULT in VALUES: 3|3|given|2.50|f|X|{1,2}|8, NULL kept: 4|
// expect: DEFAULT VALUES: 5|1|q
// expect: INSERT ... SELECT: 10|3|ab 11|3|ab
// expect: SET c = DEFAULT: 3|3|ab|2.50|X, no default: 3|
// expect: checked when made: 0A000 0A000 42803 22P02 22003 42P02
// expect: parsed: 1|-1|0|x y|t
// expect: added with a default: 1|5 2|5 3|5, long 1|300|5, alone 5 5 5, where 3
// expect: by an index made after: 1 2 3, Index Scan using a_k
// expect: not null with a default: ALTER TABLE 0 0 0; default NULL: 23502
// expect: set default: old 5 5 5, new 9; dropped: new []
// expect: after a dropped column: 1|x|7 2|x|7 3|x|7
// expect: type change: 22P02; text default to int: ALTER TABLE, 5 5 5 5, new 42
// expect: rolled back: 42703
// expect: reopened: 1|5|7|5 2|5|7|5, new 42|9, g's new row 7
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var out: []str = []
            for row in r.rows {
                var vs: []str = []
                for v in row { append(mut &vs, lexdb_exec.text(&v)) }
                append(mut &out, strings.join(&vs, "|"))
            }
            return strings.join(&out, " ")
        }
        Err(e) { return e.state + " " + e.msg }
    }
}

fn state(s: mut &lexdb_exec.Session, sql: &str): str { return q(s, sql)[0..5] }

fn plan(s: mut &lexdb_exec.Session, sql: &str, want: &str): str {
    let p = q(s, &("explain " + sql))
    return if strings.contains(&p, want) { "Index Scan using " + want } else { p }
}

fn opts(): lexdb_store.Options {
    return lexdb_store.Options{cacheBytes: 256 * 1024, segBytes: 1024 * 1024, ckptBytes: 512 * 1024, snapNodes: 100000, bufferedPages: false}
}

fn main() {
    let fs = lexdb_disk.sim(38)
    lexdb_store.run(fs, opts(), fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st)
        println("created: " + q(mut &s, &"create table d (id int primary key, n int default 1 + 2, t text default 'a' || 'b', m numeric(5,2) default 2.499 not null, b bool not null default true, v varchar(3) default upper('x'), a int[] default '{1,2}', k bigint default 7::bigint)"))
        let i1 = q(mut &s, &"insert into d (id) values (1), (2)")
        println("left out: " + q(mut &s, &"select * from d order by id"))
        let i2 = q(mut &s, &"insert into d values (3, default, 'given', default, false, default, default, 8)")
        let i3 = q(mut &s, &"insert into d (id, n) values (4, null)")
        println("DEFAULT in VALUES: " + q(mut &s, &"select * from d where id = 3") + ", NULL kept: " + q(mut &s, &"select id, n from d where id = 4"))
        let c2 = q(mut &s, &"create table dv (id int primary key default 5, x int default 1, y text default 'q')")
        let i4 = q(mut &s, &"insert into dv default values")
        println("DEFAULT VALUES: " + q(mut &s, &"select * from dv"))
        let i5 = q(mut &s, &"insert into d (id) select id + 9 from d where id <= 2")
        println("INSERT ... SELECT: " + q(mut &s, &"select id, n, t from d where id >= 10 order by id"))
        let u1 = q(mut &s, &"update d set n = 100, t = 'zz', v = 'y' where id = 3")
        let u2 = q(mut &s, &"update d set n = default, t = default, v = default where id = 3")
        let c3 = q(mut &s, &"create table nd (id int primary key, x int)")
        let i6 = q(mut &s, &"insert into nd values (3, 4)")
        let u3 = q(mut &s, &"update nd set x = default")
        println("SET c = DEFAULT: " + q(mut &s, &"select id, n, t, m, v from d where id = 3") + ", no default: " + q(mut &s, &"select * from nd"))
        println("checked when made: " + state(mut &s, &"create table e1 (id int primary key, x int default id)") + " " +
                state(mut &s, &"create table e2 (id int primary key, x int default (select 1))") + " " +
                state(mut &s, &"create table e3 (id int primary key, x int default count(*))") + " " +
                state(mut &s, &"create table e4 (id int primary key, x int default 'abc')") + " " +
                state(mut &s, &"create table e5 (id int primary key, x numeric(2,1) default 100)") + " " +
                state(mut &s, &"create table e6 (id int primary key, x int default $1)"))
        let c4 = q(mut &s, &"create table p (id int primary key default 1 not null, a int default -1 null, b int not null default (0), c text default 'x' || ' ' || 'y', e bool default (1 > 0))")
        let i7 = q(mut &s, &"insert into p default values")
        println("parsed: " + q(mut &s, &"select * from p"))

        // ADD COLUMN ... DEFAULT over rows there
        let c5 = q(mut &s, &"create table a (id int primary key, body text)")
        let i8 = q(mut &s, &("insert into a values (1, '" + strings.repeat("b", 300) + "'), (2, 'short'), (3, null)"))
        let a1 = q(mut &s, &"alter table a add column k int default 5")
        println("added with a default: " + q(mut &s, &"select id, k from a order by id") + ", long " + q(mut &s, &"select id, length(body), k from a where id = 1") +
                ", alone " + q(mut &s, &"select k from a order by id") + ", where " + q(mut &s, &"select count(*) from a where k = 5"))
        let x1 = q(mut &s, &"create index a_k on a (k)")
        println("by an index made after: " + q(mut &s, &"select id from a where k = 5 order by id") + ", " + plan(mut &s, &"select id from a where k = 5", &"a_k"))
        let a2 = q(mut &s, &"alter table a add z int not null default 0")
        println("not null with a default: " + a2 + " " + q(mut &s, &"select z from a order by id") + "; default NULL: " +
                state(mut &s, &"alter table a add y int not null default null"))
        let a3 = q(mut &s, &"alter table a alter k set default 9")
        let i9 = q(mut &s, &"insert into a (id) values (4)")
        let a4 = q(mut &s, &"alter table a alter column k drop default")
        let i10 = q(mut &s, &"insert into a (id) values (5)")
        println("set default: old " + q(mut &s, &"select k from a where id <= 3 order by id") + ", new " + q(mut &s, &"select k from a where id = 4") +
                "; dropped: new [" + q(mut &s, &"select k from a where id = 5") + "]")
        let d5 = q(mut &s, &"delete from a where id = 5")

        // after a dropped column: the default goes to the new place
        let c6 = q(mut &s, &"create table g (id int primary key, gone int, t text)")
        let i11 = q(mut &s, &"insert into g values (1, 10, 'x'), (2, 20, 'x'), (3, 30, 'x')")
        let g1 = q(mut &s, &"alter table g drop gone")
        let g2 = q(mut &s, &"alter table g add w int default 7")
        println("after a dropped column: " + q(mut &s, &"select * from g order by id"))

        // a type change: the default must convert; the old rows are rewritten
        let c7 = q(mut &s, &"create table tc (id int primary key, x text default 'abc')")
        let a5 = q(mut &s, &"alter table a add s text default '5'")
        let a6 = q(mut &s, &"alter table a alter k set default 9")
        let tc1 = state(mut &s, &"alter table tc alter x type int using 0")
        let tc2 = q(mut &s, &"alter table a alter s type int using s::int")
        let tc3 = q(mut &s, &"alter table a alter s set default 42")
        let i12 = q(mut &s, &"insert into a (id) values (42)")
        println("type change: " + tc1 + "; text default to int: " + tc2 + ", " + q(mut &s, &"select s from a where id <= 4 order by id") +
                ", new " + q(mut &s, &"select s from a where id = 42"))

        let bg = q(mut &s, &"begin")
        let a7 = q(mut &s, &"alter table g add r int default 3")
        let rb = q(mut &s, &"rollback")
        println("rolled back: " + state(mut &s, &"select r from g"))
        return 0
    }).unwrap()

    lexdb_store.run(fs, opts(), fn(st: lexdb_store.Store): int {
        var s = lexdb_exec.newSession(st)
        let i = q(mut &s, &"insert into g (id, t) values (42, 'n')")
        println("reopened: " + q(mut &s, &"select a.id, a.k, g.w, a.s from a join g on g.id = a.id where a.id <= 2 order by a.id") +
                ", new " + q(mut &s, &"select id, k from a where id = 42") + ", g's new row " + q(mut &s, &"select w from g where id = 42"))
        return 0
    }).unwrap()
}
