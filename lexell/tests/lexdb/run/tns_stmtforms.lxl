const SETUP = "create table dg (i number(10))\ninsert into dg values (0)\ninsert into dg values (1)\ninsert into dg values (2)\ninsert into dg values (3)\ninsert into dg values (4)\ninsert into dg values (5)\ninsert into dg values (6)\ninsert into dg values (7)\ninsert into dg values (8)\ninsert into dg values (9)\ncreate table gt (a number, b number, c varchar2(5))\ninsert into gt values (1, 10, 'x')\ninsert into gt values (1, 20, 'x')\ninsert into gt values (2, 30, 'y')\ninsert into gt values (null, 5, null)\ncreate table big (id number(10) primary key, k2 varchar2(5), w number)\ninsert into big select n, case when mod(n, 37) = 0 then null else 'k' || mod(n, 6) end, mod(n, 50) from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 3000\ncreate table dt (id number primary key, a number, b varchar2(5))\ninsert into dt values (1, 10, 'x')\ninsert into dt values (2, 20, 'y')\ninsert into dt values (3, 30, 'z')\ncreate table ds (k number, x number)\ninsert into ds values (1, 100)\ninsert into ds values (2, 200)\ncreate table bn (id number, a number default 7, b varchar2(5))\ncreate table dn (id number primary key, a number default on null 5, b varchar2(5) default on null for insert only 'x', c number default on null for insert and update 9, d number default 1)\ninsert into dn values (100, 1, 'q', 1, 1)"

const QS = "select a, count(*) n from gt group by all order by 1\nselect a, c, sum(b) s from gt group by all order by 1, 2\nselect a + 1 a1, count(*) n from gt group by all order by 1\nselect count(*) n from gt group by all\nselect 1 one, a, count(*) n from gt group by all order by 2\nselect a, sum(b) + a s from gt group by all order by 1\nselect a, b from gt group by all order by 1, 2\nselect * from gt group by all order by 1, 2\nselect gt.*, count(*) n from gt group by all order by 1, 2\nselect a, count(*) n from gt group by all having count(*) > 1\nselect a, row_number() over (order by a) rn from gt group by all order by 1\nselect a, sum(count(*)) over () t from gt group by all order by 1\nselect a x, count(*) n from gt where b > 5 group by all order by x\nselect upper(c) u, max(a) m from gt group by all order by 1\nselect a, nvl(c, '-') c2, count(*) n from gt group by all order by 1, 2\nselect distinct a, count(*) n from gt group by all order by 1\nselect a, 'k' || count(*) k from gt group by all order by 1\nselect a, grouping(a) g from gt group by all order by 1\nselect k2, count(*) n, sum(w) s from big group by all order by 1\nselect k2, mod(w, 3) m, count(*) n from big where id < 200 group by all order by 1, 2\nselect k2, count(*) n from big where 1 = 0 group by all\nselect x, count(*) n from (select a x from gt) group by all order by 1\nselect a, count(*) n from gt group by all, b\nselect a, count(*) n from gt group by all rollup\nselect a, count(*) from gt group by all all\nselect a, avg(b) over (partition by a) w from gt group by all order by 1\ndelete dt from ds where dt.id = ds.k and ds.x > 150 ;; select * from dt order by id\ndelete from dt from ds where dt.id = ds.k and ds.x > 150 ;; select * from dt order by id\ndelete dt d from ds s where d.id = s.k ;; select * from dt order by id\ndelete from dt d from ds s where d.id = s.k ;; select * from dt order by id\ndelete dt from ds s join ds s2 on s2.k = s.k where dt.id = s.k ;; select * from dt order by id\ndelete dt from ds ;; select count(*) n from dt\ndelete big from ds where big.id = ds.k or big.k2 is null ;; select count(*) n from big\nupdate dt d set d.a = s.x from ds s where d.id = s.k ;; select * from dt order by id\ninsert into dt set id = 9, a = 90, b = 'n' ;; select * from dt order by id\ninsert into dt set id = 9, a = 90 ;; select * from dt where id = 9\ninsert into dt set (id, a) = (9, 90), b = 'w' ;; select * from dt where id = 9\ninsert into bn set id = default, a = default ;; select * from bn\ninsert into bn set id = (select max(id) from dt) ;; select * from bn\ninsert into dt by name select 8 id, 'q' b, 80 a from dual ;; select * from dt where id = 8\ninsert into dt (id, a) by name select 8 a, 7 id from dual ;; select * from dt where id = 7\ninsert into dt by position select 7, 70, 'p' from dual ;; select * from dt where id = 7\ninsert into bn by name select id, w a from big where id <= 3 ;; select * from bn order by id\ninsert into bn by name select 1 id from dual ;; select * from bn\ninsert into bn set id = 5, id = 6\ninsert into bn set id = 5, nosuch = 6\ninsert into bn set (id, a) = (8)\ninsert into bn set (id, a) = (8, 9, 10)\ninsert into dt set id = 1, a = 2\ninsert into dt by name select 8 id, 'q' zz from dual\ninsert into dt by name select 8 id, 1 id from dual\ninsert into bn by name select 1 + 1 from dual\ninsert into bn (id) by name select 2 id, 3 a from dual\ninsert into bn by name values (1, 2)\nwith v (x, y) as (values (1, 'a'), (2, 'b')) select * from v\nwith v (x) as (values (1), (2)) select sum(x) s from v\nwith v (x, y) as (values (1, 'a'), (2, 'b')) select v.y from v where v.x = 2\nwith v (x) as (values (1), (null)) select count(*) c, count(x) n from v\nwith v (x) as (values (1)), w (y) as (select x + 1 from v) select * from w\nwith v (k, n) as (values ('k1', 1), ('k9', 2)) select v.k, count(big.id) c from v left join big on big.k2 = v.k group by v.k order by 1\nselect * from (with v (x) as (values (1), (2)) select x from v) order by 1\nwith v as (values (1, 'a'), (2, 'b')) select * from v\nwith v (x, y) as (values (1, 'a'), (2)) select * from v\nwith v (x) as (values (1, 'a')) select * from v\nwith v (x, y, z) as (values (1, 'a')) select * from v\ninsert into dn values (1, null, null, null, null) ;; select * from dn order by id\ninsert into dn (id) values (2) ;; select * from dn order by id\ninsert into dn (id, a, b, c, d) values (3, 30, 'y', 33, 3) ;; update dn set c = null where id = 3 ;; select * from dn order by id\ninsert into dn (id, a) select n, case when mod(n, 2) = 0 then null else n end from (select i n from dg) ;; select count(*) n, sum(a) s, min(b) b, sum(c) c from dn\ninsert into dn (id) values (4) ;; merge into dn using (select 4 k from dual) s on (dn.id = s.k) when matched then update set c = null ;; select * from dn order by id\nmerge into dn using (select 5 k from dual) s on (dn.id = s.k) when not matched then insert (id, a, c) values (s.k, null, null) ;; select * from dn order by id\ninsert into dn (id) values (6) ;; update dn set c = null, d = null where id = 6 ;; select * from dn order by id\nselect column_name, data_default, default_on_null, default_on_null_upd, nullable from user_tab_columns where table_name = 'DN' order by column_id\nupdate dn set a = null where id = 100\nupdate dn set b = null where id = 100\ncreate table dn2 (id number, a number default on null for update 5)\ncreate table dn2 (id number, a number default on null)\ncreate table dn2 (id number, a number default on null 5 null)"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(55), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
