// lexdb over TDS: what the fuzzer's long run left (design/lexdb-fuzz.md), through the T-SQL door, checked against SQL
// Server 2022 (run with LEXDB_MSSQL set to its connection string, this test prints SQL Server's answers: the expect
// lines). W18: a correlated scalar subquery, EXISTS and NOT EXISTS on a key of another numeric kind than the derived
// table's outer value (a float beside a decimal or an int, a decimal beside a float), with and without an index. V:
// ORDER BY a set operation's column of varchars that differ in trailing blanks ('a' and 'a  '): they do not count, so
// the next key decides; OFFSET ... FETCH, UNION, EXCEPT, INTERSECT, and chars. Each batch with SET lexdb_batch = off
// (the row engine) and on: the label and the answer, or DIFFERENT and both.
// expect: W18 a float = a decimal: x,s: NULL|NULL;0|6;0|6;1|6;2.5|NULL
// expect: W18 a real = a decimal: x,s: NULL|NULL;0|6;1|6;2.5|NULL;3|NULL
// expect: W18 a decimal = a float: x,s: NULL|NULL;0.00|9;1.00|1;1.00|1;1.50|NULL;2.00|NULL
// expect: W18 a float = an int: x,s: NULL|NULL;0|NULL;0|NULL;1|1;2.5|NULL
// expect: W18 an int = a decimal: x,s: NULL|NULL;1|6;2|3;2|3;3|NULL
// expect: W18 with an index: x,s: NULL|NULL;0|6;0|6;1|6;2.5|NULL
// expect: W18 EXISTS: x: 0;0;1
// expect: W18 NOT EXISTS: x: NULL;2.5
// expect: V UNION ALL varchars: b,n: NULL|11;''|9;'   '|10;' '|16;'a'|6;'a '|7;'a  '|13;'a'|17;'ab'|12;'ab '|15;'b  '|8;'b'|14
// expect: V DESC: b,n: 'b'|14;'b  '|8;'ab '|15;'ab'|12;'a'|17;'a  '|13;'a '|7;'a'|6;' '|16;'   '|10;''|9;NULL|11
// expect: V by name: x,n: NULL|11;''|9;'   '|10;' '|16;'a'|6;'a '|7;'a  '|13;'a'|17;'ab'|12;'ab '|15;'b  '|8;'b'|14
// expect: V UNION: b,n: NULL|11;' '|6;''|9;'   '|10;'a  '|3;'a'|6;'a '|7;'ab '|5;'ab'|12;'b'|4;'b  '|8
// expect: V OFFSET FETCH: b,n: '   '|10;' '|16;'a'|6
// expect: V EXCEPT: b,n: NULL|11;''|9;'   '|10;'a'|6;'ab'|12;'b  '|8
// expect: V INTERSECT: b,n: 'a '|7
// expect: V chars: a,n: 'b  '|2;'ab '|5;'ab '|7;'a  '|0;'a  '|1;'a  '|6;'   '|3;NULL|4;NULL|8
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"
import "../../../cmd/lexdb_plan"

const SETUP = "CREATE TABLE w1 (b2 decimal(6,2) NULL, p int NULL)\nINSERT INTO w1 VALUES (1, 1), (1.5, 2), (2, 3), (NULL, 4), (1, 5), (0, 6)\nCREATE TABLE w2 (k int NULL, f float NULL, r real NULL, g bigint NULL, p int NULL)\nINSERT INTO w2 VALUES (1, 1, 1, 1, 1), (2, 2.5, 2.5, 2, 2), (NULL, NULL, NULL, NULL, 3), (2, 0, 0, 2, 4), (3, 0, 3, 3, 5)\nCREATE TABLE w3 (b2 decimal(6,2) NULL, p int NULL)\nINSERT INTO w3 SELECT b2, p FROM w1\nCREATE INDEX w3_i ON w3 (b2)\nCREATE TABLE q0 (a char(3) NULL, n int NULL)\nINSERT INTO q0 VALUES ('a', 1), ('b', 2), ('', 3), (NULL, 4), ('ab', 5), ('a', 6)\nCREATE TABLE q1 (b varchar(10) NULL, n int NULL)\nINSERT INTO q1 VALUES ('a', 6), ('a ', 7), ('b  ', 8), ('', 9), ('   ', 10), (NULL, 11), ('ab', 12)\nCREATE TABLE q2 (a varchar(5) NULL, n int NULL)\nINSERT INTO q2 VALUES ('a  ', 13), ('b', 14), ('ab ', 15), (' ', 16), ('a', 17)\nCREATE TABLE q3 (a char(3) NULL, n int NULL)\nINSERT INTO q3 VALUES ('a', 0), ('ab', 7), (NULL, 8)"

const QS = "W18 a float = a decimal	SELECT d.x, (SELECT SUM(p) FROM w1 WHERE w1.b2 = d.x) AS s FROM (SELECT f AS x FROM w2) AS d ORDER BY 1, 2\nW18 a real = a decimal	SELECT d.x, (SELECT SUM(p) FROM w1 WHERE w1.b2 = d.x) AS s FROM (SELECT r AS x FROM w2) AS d ORDER BY 1, 2\nW18 a decimal = a float	SELECT d.x, (SELECT SUM(p) FROM w2 WHERE w2.f = d.x) AS s FROM (SELECT b2 AS x FROM w1) AS d ORDER BY 1, 2\nW18 a float = an int	SELECT d.x, (SELECT SUM(p) FROM w2 WHERE w2.k = d.x) AS s FROM (SELECT f AS x FROM w2) AS d ORDER BY 1, 2\nW18 an int = a decimal	SELECT d.x, (SELECT SUM(p) FROM w1 WHERE w1.b2 = d.x) AS s FROM (SELECT k AS x FROM w2) AS d ORDER BY 1, 2\nW18 with an index	SELECT d.x, (SELECT SUM(p) FROM w3 WHERE w3.b2 = d.x) AS s FROM (SELECT f AS x FROM w2) AS d ORDER BY 1, 2\nW18 EXISTS	SELECT d.x FROM (SELECT f AS x FROM w2) AS d WHERE EXISTS (SELECT 1 FROM w1 WHERE w1.b2 = d.x) ORDER BY 1\nW18 NOT EXISTS	SELECT d.x FROM (SELECT f AS x FROM w2) AS d WHERE NOT EXISTS (SELECT 1 FROM w1 WHERE w1.b2 = d.x) ORDER BY 1\nV UNION ALL varchars	SELECT b, n FROM q1 UNION ALL SELECT a, n FROM q2 ORDER BY 1, 2\nV DESC	SELECT b, n FROM q1 UNION ALL SELECT a, n FROM q2 ORDER BY 1 DESC, 2 DESC\nV by name	SELECT b AS x, n FROM q1 UNION ALL SELECT a, n FROM q2 ORDER BY x, n\nV UNION	SELECT b, n FROM q1 UNION SELECT a, n - 10 FROM q2 ORDER BY 1, 2\nV OFFSET FETCH	SELECT b, n FROM q1 UNION ALL SELECT a, n FROM q2 ORDER BY 1, 2 OFFSET 2 ROWS FETCH NEXT 3 ROWS ONLY\nV EXCEPT	SELECT b, n FROM q1 EXCEPT SELECT a, n - 10 FROM q2 ORDER BY 1, 2\nV INTERSECT	SELECT b, n FROM q1 INTERSECT SELECT a, n - 10 FROM q2 ORDER BY 1, 2\nV chars	SELECT a, n FROM q0 UNION ALL SELECT a, n FROM q3 ORDER BY 1 DESC, 2"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A query, or a write ("W write ;; check") in a transaction rolled back, the check after the write
fn answer(c: mut &sqlserver.Conn, q: &str): str {
    if !strings.startsWith(q, "W ") { return show(c, q) }
    let parts = strings.split(&q[2..len(q)], " ;; ")
    let b = show(c, &"BEGIN TRANSACTION")
    let w = show(c, &parts[0])
    if strings.startsWith(&w, "error") {
        let r = show(c, &"ROLLBACK")
        return w + " // " + show(c, &parts[1])
    }
    let k = show(c, &parts[1])
    let r = show(c, &"ROLLBACK")
    return w + " // " + k
}

// local: lexdb, each batch with the row engine and with batches, unnesting on and then off
fn batches(dsn: &str, local: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let setup: str = SETUP
            for q in strings.lines(&setup) {
                let r = show(mut &c, &q)
                if strings.startsWith(&r, "error") { println("setup: " + r + ": " + q) }
            }
            let text: str = QS
            for pass in 0..2 {
                if pass == 1 && local { lexdb_plan.setUnnest(0) }
                for l in strings.lines(&text) {
                    let parts = strings.split(&l, "\t")
                    if pass == 1 && !strings.startsWith(&parts[0], "W7") { continue }
                    let lab = if pass == 1 { "unnest off, " + parts[0] } else { parts[0].toStr() }
                    let q = parts[1].toStr()
                    if !local {
                        println(lab + ": " + answer(mut &c, &q))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off")
                    let off = answer(mut &c, &q)
                    let b = show(mut &c, &"SET lexdb_batch = on")
                    let on = answer(mut &c, &q)
                    if off == on { println(lab + ": " + on) } else {
                        println("DIFFERENT " + lab + ": " + q)
                        println("  rows:    " + off)
                        println("  batches: " + on)
                    }
                }
            }
            if !local {
                for t in ["w1", "w2", "w3", "q0", "q1", "q2", "q3"] {
                    let d = show(mut &c, &((if strings.startsWith(&t, "v") { "DROP VIEW " } else { "DROP TABLE " }) + t))
                }
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), true)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, false) }
        None {
            lexdb_store.run(lexdb_disk.sim(60), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
