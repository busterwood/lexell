const QUERIES = "@once create table bt (id int primary key, k text, v int, b bigint, s smallint, t timestamp, tz timestamptz, u uuid)\n@once insert into bt select i, case when i % 37 = 0 then null else 'k' || (i % 6) end, case when i % 11 = 0 then null else i % 64 end, i::bigint * 1000003, (i % 8)::smallint, timestamp '2024-03-05 00:00' + i * interval '7 minutes 13 seconds', timestamptz '2024-03-05 00:00+00' + i * interval '1 hour 1 second', case when i % 5 = 0 then null else ('0190a6f0-' || lpad(to_hex(i), 4, '0') || '-7000-8000-000000000000')::uuid end from generate_series(1, 3000) i\nselect date_bin('15 minutes', timestamp '2024-03-05 10:22:33', timestamp '2000-01-01') a, date_bin('1 day', timestamptz '2024-03-05 10:22:33+00', timestamptz '2001-01-01') b, date_bin('2 hours', timestamp '1999-03-05 10:22:33', timestamp '2000-01-01 00:30') c\nselect date_bin('1 hour 1 day', timestamp '2024-03-05 10:22', timestamp '2000-01-01') a, date_bin('90 seconds', timestamp '2024-03-05 10:22:33.5', timestamp '2024-03-05') b, date_bin('1 week', timestamp '1999-12-25', timestamp '2000-01-03') c, date_bin('10 ms', timestamp '2024-03-05 10:22:33.123456', timestamp '2000-01-01') d\nselect date_bin('1 hour', date '2024-03-05', timestamp '2000-01-01') a, date_bin('1 hour', '2024-03-05 10:00', '2000-01-01') b, date_bin('1 hour', timestamp 'infinity', timestamp '2000-01-01') c, date_bin(null, timestamp '2024-03-05', timestamp '2000-01-01') d, date_bin('1 hour', null::timestamp, timestamp '2000-01-01') e\nselect date_bin('1 month', timestamp '2024-03-05', timestamp '2000-01-01')\nselect date_bin('0 s', timestamp '2024-03-05', timestamp '2000-01-01')\nselect date_bin('-1 hour', timestamp '2024-03-05', timestamp '2000-01-01')\nselect date_bin('1 year', timestamptz '2024-03-05 00:00+00', timestamptz '2000-01-01 00:00+00')\nselect date_bin('6 hours', t, timestamp '2024-01-01') h, count(*) n, min(t) lo, max(t) hi from bt group by 1 order by 1 limit 5\nselect date_bin('1 day', tz, timestamptz '2024-01-01 00:00+00') d, count(*) n from bt where id <= 100 group by 1 order by 1\nselect id, date_bin('25 minutes', t, timestamp '2024-03-05 00:03') b from bt where id in (1, 2, 50, 3000) order by id\nselect uuid_extract_version('0190a6f0-0000-7000-8000-000000000000') a, uuid_extract_timestamp('0190a6f0-0000-7000-8000-000000000000') b, uuid_extract_version('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11') c, uuid_extract_timestamp('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11') d\nselect uuid_extract_timestamp('c232ab00-9414-11ec-b3c8-9f6bdeced846') a, uuid_extract_version('c232ab00-9414-11ec-b3c8-9f6bdeced846') b, uuid_extract_version('00000000-0000-0000-0000-000000000000') c, uuid_extract_version('ffffffff-ffff-4fff-7fff-ffffffffffff') d, uuid_extract_version(null) e\nselect uuid_extract_version(uuidv7()) a, uuid_extract_version(uuidv4()) b, uuid_extract_timestamp(uuidv7()) - now() < interval '1 s' c, uuid_extract_timestamp(uuidv7(interval '1 day'))::date - current_date d, uuid_extract_timestamp(uuidv7(interval '-30 days')) < now() - interval '29 days' e\nselect uuidv4() = uuidv4() a, uuidv7() < uuidv7() b, uuidv7(null) c, length(uuidv4()::text) d, pg_typeof(uuidv7()) e, pg_typeof(uuid_extract_version(uuidv4())) f, pg_typeof(uuid_extract_timestamp(uuidv7())) g\nselect count(distinct uuidv4()) n from bt\nselect count(*) n, count(uuid_extract_timestamp(u)) ts, min(uuid_extract_timestamp(u)) lo, max(uuid_extract_version(u)) v from bt\nselect uuid_extract_version(x) from (values ('x')) v(x)\nselect unistr('d\\0061t\\+000061') a, unistr('é\\U0001F600') b, unistr('a\\\\b') c, unistr(null) d, unistr('\\D83D\\DE00') e, unistr('plain') f\nselect unistr('\\00e')\nselect unistr('\\d800')\nselect unistr('\\+110000')\nselect unistr(k || '\\00e9') u, count(*) n from bt group by 1 order by 1\nselect encode('\\x01ff'::bytea, 'base64url') a, encode('\\x01fffe'::bytea, 'base64url') b, encode('\\xfbff'::bytea, 'base64') c, decode('-_8', 'base64url') d, decode('AQ', 'base64url') e, decode('+/', 'base64url') f\nselect encode('\\x01ff'::bytea, 'base32hex') a, decode('07VG====', 'base32hex') b, decode('07vg', 'base32hex') c, encode(''::bytea, 'base32hex') d, encode(''::bytea, 'base64url') e, encode('hello world'::bytea, 'base32hex') f\nselect encode(repeat('x', 60)::bytea, 'base64url') a, decode(encode(repeat('xyz', 30)::bytea, 'base64url'), 'base64url') = repeat('xyz', 30)::bytea b, decode(encode('abcdefgh'::bytea, 'base32hex'), 'base32hex') c\nselect decode('A', 'base64url')\nselect decode('A===', 'base64url')\nselect decode('A*', 'base64url')\nselect decode('0', 'base32hex')\nselect decode('W0======', 'base32hex')\nselect decode('07VG=', 'base32hex')\nselect encode(k::bytea, 'base64url') e, count(*) n from bt group by 1 order by 1\nselect bit_and(v) a, bit_or(v) o, bit_xor(v) x, bit_and(b) ab, bit_or(s) os, bit_xor(s) xs, any_value(k) av from bt where id <= 10\nselect k, bit_and(v) a, bit_or(v) o, bit_xor(v) x, bit_xor(b) xb, count(*) n from bt group by k order by k\nselect bit_and(v) a, bit_or(v) o, bit_xor(v) x, any_value(v) v from bt where id < 0\nselect bit_xor(distinct s) a, bit_xor(s) b, bit_or(distinct v) c from bt\nselect pg_typeof(a) a, pg_typeof(o) b, pg_typeof(x) c, pg_typeof(v) d from (select bit_and(s) a, bit_or(v) o, bit_xor(b) x, any_value(k) v from bt) q\nselect k, any_value(s) a from bt where s = 3 group by k order by k\nselect any_value(x) a from (values (null::int), (7), (null)) v(x)\nselect k, bit_or(v) filter (where id % 2 = 0) o from bt group by k order by k\nselect id, bit_xor(v) over (order by id rows between 2 preceding and current row) x, bit_or(v) over (partition by k) o from bt where id <= 8 order by id\nselect bit_and(x) from (values (1.5)) v(x)\nselect bit_and(k) from bt\nselect error_on_null(1) a, error_on_null('x'::text) b, error_on_null(v) c from bt where id = 1\nselect error_on_null(null::int)\nselect count(error_on_null(v)) n from bt where id < 11\nselect count(error_on_null(v)) n from bt\nselect to_bin(10) a, to_oct(-8) b, to_bin(-1::bigint) c, to_oct(0) d, to_bin(255) e, to_oct(2147483647) f, to_bin(null::int) g, to_oct(-9223372036854775807 - 1) h\nselect k, to_bin(sum(v)) b, to_oct(max(b)) o from bt group by k order by k\nselect bit_count('\\xff01'::bytea) a, bit_count(''::bytea) b, bit_count(null::bytea) c, bit_count(decode('ffffffff', 'hex')) d\nselect erf(0.5) a, erfc(0.5) b, gamma(5.5) c, lgamma(3) d, gamma(1) e, erf(0) f, lgamma(0.5) g, gamma(-1.5) h\nselect gamma(0)\nselect gamma(-1)\nselect lgamma(0)\nselect gamma(200)\nselect crc32('abc'::bytea) a, crc32c('abc'::bytea) b, crc32(''::bytea) c, crc32c(null::bytea) d, crc32('The quick brown fox jumps over the lazy dog'::bytea) e\nselect k, crc32(k::bytea) c, crc32c(k::bytea) d from bt group by k order by k\nselect date_add(timestamptz '2024-03-30 12:00+00', interval '1 day', 'Europe/Paris') a, date_subtract(timestamptz '2024-03-31 12:00+00', interval '1 day', 'Europe/Paris') b, date_add(timestamptz '2024-03-30 12:00+00', interval '1 day') c, date_add(timestamptz '2024-01-31 00:00+00', interval '1 month', 'UTC') d, date_add(null, interval '1 day') e\nselect date_add(timestamptz '2024-03-30 12:00+00', interval '1 day', 'Nowhere/Zone')\nselect casefold('ẞ ß Σ Abc') a, casefold('ÀÉÎ') b, casefold(null) c\nselect trim_array(array[1,2,3,4], 2) a, trim_array(array['a','b'], 0) b, trim_array(array[1,2], 2) c, trim_array(null::int[], 1) d, array_reverse(array[1,2,3]) e, array_reverse(array['x', null, 'z']) f, array_reverse('{}'::int[]) g\nselect trim_array(array[1,2], 3)\nselect trim_array(array[1,2], -1)\nselect cardinality(array_shuffle(array[1,2,3,4,5])) a, (select sum(x) from unnest(array_shuffle(array[1,2,3,4,5])) x) b, cardinality(array_sample(array[1,2,3,4,5], 3)) c, array_sample(array[1,2,3], 0) d, array_shuffle('{}'::int[]) e, array_sample(array[7,7], 2) f\nselect array_sample(array[1,2], 3)\nselect random(1, 10) between 1 and 10 a, random(1.5, 2.25) between 1.5 and 2.25 b, scale(random(1.5, 2.25)) c, random(7, 7) d, random(-3::bigint, -3::bigint) e, random(2.50, 2.50) f, pg_typeof(random(1, 2)) g, pg_typeof(random(1.0, 2.0)) h\nselect random(5, 1)\nselect count(*) n, min(r) >= 0 lo, max(r) <= 3 hi, count(distinct r) d from (select random(0, 3) r from bt) q\nselect 258::bytea a, (-1)::int2::bytea b, 258::int8::bytea c, '\\x0102'::bytea::int4 d, '\\x01020304050607'::bytea::int8 e, 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid::bytea f, '\\xa0eebc999c0b4ef8bb6d6bb9bd380a11'::bytea::uuid g\nselect '\\xffff'::bytea::int2 a, '\\xff'::bytea::int2 b, '\\xffffffff'::bytea::int4 c, '\\x'::bytea::int4 d, cast(v as bytea) e, cast(b as bytea) f from bt where id = 3\nselect '\\x010203'::bytea::int2\nselect '\\x0102030405060708090a'::bytea::int8\nselect '\\x01'::bytea::uuid\nselect k, count(distinct v::bytea) n, min(s::bytea) lo, max(u::bytea) hi from bt group by k order by k\nselect (v::bytea)::int = v ok, count(*) n from bt group by 1 order by 1\nselect 2.5::bytea"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(144), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
