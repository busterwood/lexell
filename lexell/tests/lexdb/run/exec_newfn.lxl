// expect: same: ERROR 42883
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table bt (id int primary key, k text, v int, b bigint, s smallint, t timestamp, tz timestamptz, u uuid)\n@once insert into bt select i, case when i % 37 = 0 then null else 'k' || (i % 6) end, case when i % 11 = 0 then null else i % 64 end, i::bigint * 1000003, (i % 8)::smallint, timestamp '2024-03-05 00:00' + i * interval '7 minutes 13 seconds', timestamptz '2024-03-05 00:00+00' + i * interval '1 hour 1 second', case when i % 5 = 0 then null else ('0190a6f0-' || lpad(to_hex(i), 4, '0') || '-7000-8000-000000000000')::uuid end from generate_series(1, 3000) i\nselect date_bin('15 minutes', timestamp '2024-03-05 10:22:33', timestamp '2000-01-01') a, date_bin('1 day', timestamptz '2024-03-05 10:22:33+00', timestamptz '2001-01-01') b, date_bin('2 hours', timestamp '1999-03-05 10:22:33', timestamp '2000-01-01 00:30') c\nselect date_bin('1 hour 1 day', timestamp '2024-03-05 10:22', timestamp '2000-01-01') a, date_bin('90 seconds', timestamp '2024-03-05 10:22:33.5', timestamp '2024-03-05') b, date_bin('1 week', timestamp '1999-12-25', timestamp '2000-01-03') c, date_bin('10 ms', timestamp '2024-03-05 10:22:33.123456', timestamp '2000-01-01') d\nselect date_bin('1 hour', date '2024-03-05', timestamp '2000-01-01') a, date_bin('1 hour', '2024-03-05 10:00', '2000-01-01') b, date_bin('1 hour', timestamp 'infinity', timestamp '2000-01-01') c, date_bin(null, timestamp '2024-03-05', timestamp '2000-01-01') d, date_bin('1 hour', null::timestamp, timestamp '2000-01-01') e\nselect date_bin('1 month', timestamp '2024-03-05', timestamp '2000-01-01')\nselect date_bin('0 s', timestamp '2024-03-05', timestamp '2000-01-01')\nselect date_bin('-1 hour', timestamp '2024-03-05', timestamp '2000-01-01')\nselect date_bin('1 year', timestamptz '2024-03-05 00:00+00', timestamptz '2000-01-01 00:00+00')\nselect date_bin('6 hours', t, timestamp '2024-01-01') h, count(*) n, min(t) lo, max(t) hi from bt group by 1 order by 1 limit 5\nselect date_bin('1 day', tz, timestamptz '2024-01-01 00:00+00') d, count(*) n from bt where id <= 100 group by 1 order by 1\nselect id, date_bin('25 minutes', t, timestamp '2024-03-05 00:03') b from bt where id in (1, 2, 50, 3000) order by id\nselect uuid_extract_version('0190a6f0-0000-7000-8000-000000000000') a, uuid_extract_timestamp('0190a6f0-0000-7000-8000-000000000000') b, uuid_extract_version('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11') c, uuid_extract_timestamp('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11') d\nselect uuid_extract_timestamp('c232ab00-9414-11ec-b3c8-9f6bdeced846') a, uuid_extract_version('c232ab00-9414-11ec-b3c8-9f6bdeced846') b, uuid_extract_version('00000000-0000-0000-0000-000000000000') c, uuid_extract_version('ffffffff-ffff-4fff-7fff-ffffffffffff') d, uuid_extract_version(null) e\nselect uuid_extract_version(uuidv7()) a, uuid_extract_version(uuidv4()) b, uuid_extract_timestamp(uuidv7()) - now() < interval '1 s' c, uuid_extract_timestamp(uuidv7(interval '1 day'))::date - current_date d, uuid_extract_timestamp(uuidv7(interval '-30 days')) < now() - interval '29 days' e\nselect uuidv4() = uuidv4() a, uuidv7() < uuidv7() b, uuidv7(null) c, length(uuidv4()::text) d, pg_typeof(uuidv7()) e, pg_typeof(uuid_extract_version(uuidv4())) f, pg_typeof(uuid_extract_timestamp(uuidv7())) g\nselect count(distinct uuidv4()) n from bt\nselect count(*) n, count(uuid_extract_timestamp(u)) ts, min(uuid_extract_timestamp(u)) lo, max(uuid_extract_version(u)) v from bt\nselect uuid_extract_version(x) from (values ('x')) v(x)\nselect unistr('d\\0061t\\+000061') a, unistr('é\\U0001F600') b, unistr('a\\\\b') c, unistr(null) d, unistr('\\D83D\\DE00') e, unistr('plain') f\nselect unistr('\\00e')\nselect unistr('\\d800')\nselect unistr('\\+110000')\nselect unistr(k || '\\00e9') u, count(*) n from bt group by 1 order by 1\nselect encode('\\x01ff'::bytea, 'base64url') a, encode('\\x01fffe'::bytea, 'base64url') b, encode('\\xfbff'::bytea, 'base64') c, decode('-_8', 'base64url') d, decode('AQ', 'base64url') e, decode('+/', 'base64url') f\nselect encode('\\x01ff'::bytea, 'base32hex') a, decode('07VG====', 'base32hex') b, decode('07vg', 'base32hex') c, encode(''::bytea, 'base32hex') d, encode(''::bytea, 'base64url') e, encode('hello world'::bytea, 'base32hex') f\nselect encode(repeat('x', 60)::bytea, 'base64url') a, decode(encode(repeat('xyz', 30)::bytea, 'base64url'), 'base64url') = repeat('xyz', 30)::bytea b, decode(encode('abcdefgh'::bytea, 'base32hex'), 'base32hex') c\nselect decode('A', 'base64url')\nselect decode('A===', 'base64url')\nselect decode('A*', 'base64url')\nselect decode('0', 'base32hex')\nselect decode('W0======', 'base32hex')\nselect decode('07VG=', 'base32hex')\nselect encode(k::bytea, 'base64url') e, count(*) n from bt group by 1 order by 1\nselect bit_and(v) a, bit_or(v) o, bit_xor(v) x, bit_and(b) ab, bit_or(s) os, bit_xor(s) xs, any_value(k) av from bt where id <= 10\nselect k, bit_and(v) a, bit_or(v) o, bit_xor(v) x, bit_xor(b) xb, count(*) n from bt group by k order by k\nselect bit_and(v) a, bit_or(v) o, bit_xor(v) x, any_value(v) v from bt where id < 0\nselect bit_xor(distinct s) a, bit_xor(s) b, bit_or(distinct v) c from bt\nselect pg_typeof(a) a, pg_typeof(o) b, pg_typeof(x) c, pg_typeof(v) d from (select bit_and(s) a, bit_or(v) o, bit_xor(b) x, any_value(k) v from bt) q\nselect k, any_value(s) a from bt where s = 3 group by k order by k\nselect any_value(x) a from (values (null::int), (7), (null)) v(x)\nselect k, bit_or(v) filter (where id % 2 = 0) o from bt group by k order by k\nselect id, bit_xor(v) over (order by id rows between 2 preceding and current row) x, bit_or(v) over (partition by k) o from bt where id <= 8 order by id\nselect bit_and(x) from (values (1.5)) v(x)\nselect bit_and(k) from bt"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(144), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
