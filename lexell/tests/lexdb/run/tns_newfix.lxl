// expect: same: S,A = NULL|NULL
// expect: same: K2,S,N = 'k0'|'+000000008 11:08:18.000000000'|487;'k1'|'+000000008 10:18:00.000000000'|486;'k2'|'+000000008 10:17:42.000000000'|486;'k3'|'+000000008 10:17:24.000000000'|486;'k4'|'+000000008 11:07:40.000000000'|487;'k5'|'+000000008 11:07:59.000000000'|487;NULL|'+000000001 10:07:57.000000000'|81
// expect: same: S,A = '+000000000 00:00:10.000000000'|'+000000000 00:00:02.500000000'
// expect: same: M,A = 0|'+000000000 00:00:45.000000000';1|'+000000000 00:00:33.000000000';2|'+000000000 00:00:39.000000000'
// expect: same: E = '61476B3D'
// expect: same: E = 'aGk='
// expect: same: D = 'hi'
// expect: same: E,D = '41514C2F'|'0102FF'
// expect: same: R,V = NULL|NULL
