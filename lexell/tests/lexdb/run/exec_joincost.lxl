// lexdb_exec: the join order by cost (optimizer 26). When every table of a
// SELECT's inner join has ANALYZE's statistics, the cheapest left-deep order
// is found (exactly to 8 tables, past that by SQLite's N-best search,
// optimizer 28), and each table after the first is looked up per row or
// read once and hashed, whichever costs less in reads. Without statistics
// for every table, the order bound by keys (optimizer 25) stands; SET
// lexdb_planner = rules keeps FROM's. The results are the rules'. Checked
// by hand. With a LEFT JOIN (optimizer 41) FROM's order stands, and each
// table after the first is hashed or looked up by the same costs.
// expect: -- small: 100 rows, one labelled x; big: 20,000 rows, 200 per small row; mid: 2,000 rows, no index on sid
// expect: create table small (id int primary key, label text) -> CREATE TABLE
// expect: insert into small select g, case when g = 7 then 'x' else 'l' || (g % 10) end from generate_series(1, 100) g -> INSERT 0 100
// expect: create index small_label on small (label) -> CREATE INDEX
// expect: create table big (id int primary key, sid int, v int) -> CREATE TABLE
// expect: insert into big select g, g % 100 + 1, g % 7 from generate_series(1, 20000) g -> INSERT 0 20000
// expect: create index big_sid on big (sid) -> CREATE INDEX
// expect: create table mid (id int primary key, sid int) -> CREATE TABLE
// expect: insert into mid select g, g % 100 + 1 from generate_series(1, 2000) g -> INSERT 0 2000
// expect: -- before ANALYZE: nothing pinned (label is not unique), FROM order
// expect: explain select count(*) from big b join small s on b.sid = s.id where s.label = 'x' -> [QUERY PLAN] scan big b: index big_sid scan, index only; join small s: primary key lookup per row; aggregate
// expect: analyze -> ANALYZE
// expect: -- after: the one small row by its label, then its big rows by index
// expect: explain select count(*) from big b join small s on b.sid = s.id where s.label = 'x' -> [QUERY PLAN] scan small s: index small_label lookup, index only (estimated 5 rows); join big b: index big_sid lookup, index only (estimated 200 rows) per row; aggregate
// expect: select count(*) from big b join small s on b.sid = s.id where s.label = 'x' -> [count] 200
// expect: explain analyze select count(*) from big b join small s on b.sid = s.id where s.label = 'x' -> scan small s: index small_label lookup, index only (estimated 5 rows) (rows read 1, kept 1, batches 1); join big b: index big_sid lookup, index only (estimated 200 rows) per row (lookups 1, rows read 200, joined 200); aggregate
// expect: -- no filter: big read once, small hashed (100 rows) rather than looked up 20,000 times
// expect: explain select count(*), sum(b.v) from big b join small s on b.sid = s.id -> [QUERY PLAN] scan big b: full scan; join small s: hash on (id) over full scan; aggregate
// expect: select count(*), sum(b.v) from big b join small s on b.sid = s.id -> [count,sum] 20000|59998
// expect: -- three tables: mid has no index on sid, so it is hashed after the small row
// expect: explain select count(*) from mid m join big b on b.sid = m.sid join small s on s.id = m.sid where s.label = 'x' -> [QUERY PLAN] scan small s: index small_label lookup, index only (estimated 5 rows); join big b: index big_sid lookup, index only (estimated 200 rows) per row; join mid m: hash on (sid, sid) over full scan; aggregate
// expect: select count(*) from mid m join big b on b.sid = m.sid join small s on s.id = m.sid where s.label = 'x' -> [count] 4000
// expect: -- the rules: FROM order, the same results
// expect: set lexdb_planner = rules -> SET
// expect: explain select count(*) from big b join small s on b.sid = s.id where s.label = 'x' -> [QUERY PLAN] scan big b: index big_sid scan, index only; join small s: primary key lookup per row; aggregate
// expect: select count(*) from mid m join big b on b.sid = m.sid join small s on s.id = m.sid where s.label = 'x' -> [count] 4000
// expect: select count(*), sum(b.v) from big b join small s on b.sid = s.id -> [count,sum] 20000|59998
// expect: reset lexdb_planner -> RESET
// expect: -- ORDER BY ... LIMIT (optimizer 32): big read in its order and stopped, when the LIMIT's share of the rows makes that cheaper than a sort
// expect: explain analyze select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id limit 5 -> scan big b: full scan (rows read 42, kept 42); join small s: primary key lookup per row (lookups 42, rows read 42, joined 5); order: the scan's; limit: stops the scan
// expect: explain analyze select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id desc limit 5 -> scan big b: full scan backward (rows read 49, kept 49); join small s: primary key lookup per row (lookups 49, rows read 49, joined 5); order: the scan's; limit: stops the scan
// expect: explain analyze select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id limit 1000 -> scan big b: full scan (rows read 10240, kept 10240, batches 10); join small s: hash on (id) over index small_label lookup, index only (estimated 10 rows) (table rows 10 of 10 read, probes 10240, rows read 1024, joined 1024); order: the scan's; limit: stops the scan
// expect: explain analyze select b.id from big b join small s on s.id = b.sid where s.label = 'x' order by b.id limit 150 -> scan small s: index small_label lookup, index only (estimated 5 rows) (rows read 1, kept 1, batches 1); join big b: index big_sid lookup, index only (estimated 200 rows) per row (lookups 1, rows read 200, joined 200); order: sort
// expect: select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id limit 5 -> [id] 2; 12; 22; 32; 42
// expect: select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id desc limit 5 -> [id] 19992; 19982; 19972; 19962; 19952
// expect: -- a table without statistics: the order bound by keys (here FROM order)
// expect: create table other (id int primary key, sid int) -> CREATE TABLE
// expect: insert into other select g, g % 100 + 1 from generate_series(1, 50) g -> INSERT 0 50
// expect: explain select count(*) from other o join small s on s.id = o.sid where s.label = 'x' -> [QUERY PLAN] scan other o: full scan; join small s: primary key lookup per row; aggregate
// expect: -- twenty tables (the N-best search past JOIN_EXACT_MAX, optimizer 28; past the old bound of 12, optimizer 30): a chain c1 .. c20, c1 filtered by an index; the same count as the rules
// expect: create table c1 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c1 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c1_p on c1 (p) -> CREATE INDEX
// expect: create table c2 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c2 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c2_p on c2 (p) -> CREATE INDEX
// expect: create table c3 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c3 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c3_p on c3 (p) -> CREATE INDEX
// expect: create table c4 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c4 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c4_p on c4 (p) -> CREATE INDEX
// expect: create table c5 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c5 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c5_p on c5 (p) -> CREATE INDEX
// expect: create table c6 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c6 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c6_p on c6 (p) -> CREATE INDEX
// expect: create table c7 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c7 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c7_p on c7 (p) -> CREATE INDEX
// expect: create table c8 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c8 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c8_p on c8 (p) -> CREATE INDEX
// expect: create table c9 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c9 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c9_p on c9 (p) -> CREATE INDEX
// expect: create table c10 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c10 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c10_p on c10 (p) -> CREATE INDEX
// expect: create table c11 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c11 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c11_p on c11 (p) -> CREATE INDEX
// expect: create table c12 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c12 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c12_p on c12 (p) -> CREATE INDEX
// expect: create table c13 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c13 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c13_p on c13 (p) -> CREATE INDEX
// expect: create table c14 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c14 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c14_p on c14 (p) -> CREATE INDEX
// expect: create table c15 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c15 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c15_p on c15 (p) -> CREATE INDEX
// expect: create table c16 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c16 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c16_p on c16 (p) -> CREATE INDEX
// expect: create table c17 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c17 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c17_p on c17 (p) -> CREATE INDEX
// expect: create table c18 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c18 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c18_p on c18 (p) -> CREATE INDEX
// expect: create table c19 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c19 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c19_p on c19 (p) -> CREATE INDEX
// expect: create table c20 (id int primary key, p int, k int) -> CREATE TABLE
// expect: insert into c20 select g, g % 100 + 1, g % 20 from generate_series(1, 200) g -> INSERT 0 200
// expect: create index c20_p on c20 (p) -> CREATE INDEX
// expect: create index c1_k on c1 (k) -> CREATE INDEX
// expect: analyze -> ANALYZE
// expect: explain select count(*) from c20 join c19 on c20.p = c19.id join c18 on c19.p = c18.id join c17 on c18.p = c17.id join c16 on c17.p = c16.id join c15 on c16.p = c15.id join c14 on c15.p = c14.id join c13 on c14.p = c13.id join c12 on c13.p = c12.id join c11 on c12.p = c11.id join c10 on c11.p = c10.id join c9 on c10.p = c9.id join c8 on c9.p = c8.id join c7 on c8.p = c7.id join c6 on c7.p = c6.id join c5 on c6.p = c5.id join c4 on c5.p = c4.id join c3 on c4.p = c3.id join c2 on c3.p = c2.id join c1 on c2.p = c1.id where c1.k = 3 -> [QUERY PLAN] scan c1: index c1_k lookup (estimated 10 rows); join c2: index c2_p lookup (estimated 2 rows) per row; join c3: index c3_p lookup (estimated 2 rows) per row; join c4: index c4_p lookup (estimated 2 rows) per row; join c5: index c5_p lookup (estimated 2 rows) per row; join c6: index c6_p lookup (estimated 2 rows) per row; join c7: index c7_p lookup (estimated 2 rows) per row; join c8: index c8_p lookup (estimated 2 rows) per row; join c9: index c9_p lookup (estimated 2 rows) per row; join c10: index c10_p lookup (estimated 2 rows) per row; join c11: index c11_p lookup (estimated 2 rows) per row; join c12: index c12_p lookup (estimated 2 rows) per row; join c13: index c13_p lookup (estimated 2 rows) per row; join c14: index c14_p lookup (estimated 2 rows) per row; join c15: index c15_p lookup (estimated 2 rows) per row; join c16: index c16_p lookup (estimated 2 rows) per row; join c17: index c17_p lookup (estimated 2 rows) per row; join c18: index c18_p lookup (estimated 2 rows) per row; join c19: index c19_p lookup (estimated 2 rows) per row; join c20: index c20_p lookup (estimated 2 rows) per row; aggregate
// expect: select count(*) from c20 join c19 on c20.p = c19.id join c18 on c19.p = c18.id join c17 on c18.p = c17.id join c16 on c17.p = c16.id join c15 on c16.p = c15.id join c14 on c15.p = c14.id join c13 on c14.p = c13.id join c12 on c13.p = c12.id join c11 on c12.p = c11.id join c10 on c11.p = c10.id join c9 on c10.p = c9.id join c8 on c9.p = c8.id join c7 on c8.p = c7.id join c6 on c7.p = c6.id join c5 on c6.p = c5.id join c4 on c5.p = c4.id join c3 on c4.p = c3.id join c2 on c3.p = c2.id join c1 on c2.p = c1.id where c1.k = 3 -> [count] 10
// expect: set lexdb_planner = rules -> SET
// expect: select count(*) from c20 join c19 on c20.p = c19.id join c18 on c19.p = c18.id join c17 on c18.p = c17.id join c16 on c17.p = c16.id join c15 on c16.p = c15.id join c14 on c15.p = c14.id join c13 on c14.p = c13.id join c12 on c13.p = c12.id join c11 on c12.p = c11.id join c10 on c11.p = c10.id join c9 on c10.p = c9.id join c8 on c9.p = c8.id join c7 on c8.p = c7.id join c6 on c7.p = c6.id join c5 on c6.p = c5.id join c4 on c5.p = c4.id join c3 on c4.p = c3.id join c2 on c3.p = c2.id join c1 on c2.p = c1.id where c1.k = 3 -> [count] 10
// expect: reset lexdb_planner -> RESET
// expect: -- LEFT JOIN (optimizer 41): FROM's order kept, each table hashed or looked up per row by cost; the results the rules'
// expect: explain analyze select count(*), count(s.label) from big b left join small s on s.id = b.sid -> scan big b: full scan (rows read 20000, kept 20000, batches 20); left join small s: hash on (id) over full scan (table rows 100 of 100 read, probes 20000, rows read 20000, joined 20000, null rows 0); aggregate
// expect: select count(*), count(s.label) from big b left join small s on s.id = b.sid -> [count,count] 20000|20000
// expect: explain analyze select s.id, b.v from small s left join big b on b.id = s.id * 1000 where s.id < 3 -> scan small s: primary key range (estimated 2 rows) (rows read 3, kept 2, batches 1); left join big b: primary key lookup per row (lookups 2, rows read 2, joined 2, null rows 0)
// expect: select s.id, b.v from small s left join big b on b.id = s.id * 1000 where s.id < 3 -> [id,v] 1|6; 2|5
// expect: set lexdb_planner = rules -> SET
// expect: select count(*), count(s.label) from big b left join small s on s.id = b.sid -> [count,count] 20000|20000
// expect: select s.id, b.v from small s left join big b on b.id = s.id * 1000 where s.id < 3 -> [id,v] 1|6; 2|5
// expect: reset lexdb_planner -> RESET
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"

fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows {
                println(sql + " -> " + r.tag)
                return
            }
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name) }
            println(sql + " -> [" + strings.join(&names, ",") + "]" + (if len(lines) > 0 { " " } else { "" }) + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

// EXPLAIN ANALYZE without its last line (the time).
fn analyze(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for i in 0..len(r.rows) - 1 { append(mut &lines, lexdb_exec.text(&r.rows[i][0])) }
            println(sql + " -> " + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    println("-- small: 100 rows, one labelled x; big: 20,000 rows, 200 per small row; mid: 2,000 rows, no index on sid")
    show(mut &s, "create table small (id int primary key, label text)")
    show(mut &s, "insert into small select g, case when g = 7 then 'x' else 'l' || (g % 10) end from generate_series(1, 100) g")
    show(mut &s, "create index small_label on small (label)")
    show(mut &s, "create table big (id int primary key, sid int, v int)")
    show(mut &s, "insert into big select g, g % 100 + 1, g % 7 from generate_series(1, 20000) g")
    show(mut &s, "create index big_sid on big (sid)")
    show(mut &s, "create table mid (id int primary key, sid int)")
    show(mut &s, "insert into mid select g, g % 100 + 1 from generate_series(1, 2000) g")
    println("-- before ANALYZE: nothing pinned (label is not unique), FROM order")
    show(mut &s, "explain select count(*) from big b join small s on b.sid = s.id where s.label = 'x'")
    show(mut &s, "analyze")
    println("-- after: the one small row by its label, then its big rows by index")
    show(mut &s, "explain select count(*) from big b join small s on b.sid = s.id where s.label = 'x'")
    show(mut &s, "select count(*) from big b join small s on b.sid = s.id where s.label = 'x'")
    analyze(mut &s, "explain analyze select count(*) from big b join small s on b.sid = s.id where s.label = 'x'")
    println("-- no filter: big read once, small hashed (100 rows) rather than looked up 20,000 times")
    show(mut &s, "explain select count(*), sum(b.v) from big b join small s on b.sid = s.id")
    show(mut &s, "select count(*), sum(b.v) from big b join small s on b.sid = s.id")
    println("-- three tables: mid has no index on sid, so it is hashed after the small row")
    show(mut &s, "explain select count(*) from mid m join big b on b.sid = m.sid join small s on s.id = m.sid where s.label = 'x'")
    show(mut &s, "select count(*) from mid m join big b on b.sid = m.sid join small s on s.id = m.sid where s.label = 'x'")
    println("-- the rules: FROM order, the same results")
    show(mut &s, "set lexdb_planner = rules")
    show(mut &s, "explain select count(*) from big b join small s on b.sid = s.id where s.label = 'x'")
    show(mut &s, "select count(*) from mid m join big b on b.sid = m.sid join small s on s.id = m.sid where s.label = 'x'")
    show(mut &s, "select count(*), sum(b.v) from big b join small s on b.sid = s.id")
    show(mut &s, "reset lexdb_planner")
    println("-- ORDER BY ... LIMIT (optimizer 32): big read in its order and stopped, when the LIMIT's share of the rows makes that cheaper than a sort")
    analyze(mut &s, "explain analyze select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id limit 5")
    analyze(mut &s, "explain analyze select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id desc limit 5")
    analyze(mut &s, "explain analyze select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id limit 1000")
    // one small row of 100 ('x'): its 200 rows looked up and sorted, not big read in order
    analyze(mut &s, "explain analyze select b.id from big b join small s on s.id = b.sid where s.label = 'x' order by b.id limit 150")
    show(mut &s, "select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id limit 5")
    show(mut &s, "select b.id from big b join small s on s.id = b.sid where s.label = 'l3' order by b.id desc limit 5")
    println("-- a table without statistics: the order bound by keys (here FROM order)")
    show(mut &s, "create table other (id int primary key, sid int)")
    show(mut &s, "insert into other select g, g % 100 + 1 from generate_series(1, 50) g")
    show(mut &s, "explain select count(*) from other o join small s on s.id = o.sid where s.label = 'x'")
    println("-- twenty tables (the N-best search past JOIN_EXACT_MAX, optimizer 28; past the old bound of 12, optimizer 30): a chain c1 .. c20, c1 filtered by an index; the same count as the rules")
    for i in 1..21 {
        let t = "c" + i.toStr()
        show(mut &s, "create table " + t + " (id int primary key, p int, k int)")
        show(mut &s, "insert into " + t + " select g, g % 100 + 1, g % 20 from generate_series(1, 200) g")
        show(mut &s, "create index " + t + "_p on " + t + " (p)")
    }
    show(mut &s, "create index c1_k on c1 (k)")
    show(mut &s, "analyze")
    var q = "select count(*) from c20"
    // FROM from c20 down to c1: the filtered table last
    var i = 19
    while i >= 1 {
        q = q + " join c" + i.toStr() + " on c" + (i + 1).toStr() + ".p = c" + i.toStr() + ".id"
        i -= 1
    }
    q = q + " where c1.k = 3"
    show(mut &s, "explain " + q)
    show(mut &s, q)
    show(mut &s, "set lexdb_planner = rules")
    show(mut &s, q)
    show(mut &s, "reset lexdb_planner")
    println("-- LEFT JOIN (optimizer 41): FROM's order kept, each table hashed or looked up per row by cost; the results the rules'")
    // big's 20,000 rows: small (100 rows) hashed once, not 20,000 lookups
    analyze(mut &s, "explain analyze select count(*), count(s.label) from big b left join small s on s.id = b.sid")
    show(mut &s, "select count(*), count(s.label) from big b left join small s on s.id = b.sid")
    // small's 2 rows: big looked up by its key twice, not read whole
    analyze(mut &s, "explain analyze select s.id, b.v from small s left join big b on b.id = s.id * 1000 where s.id < 3")
    show(mut &s, "select s.id, b.v from small s left join big b on b.id = s.id * 1000 where s.id < 3")
    show(mut &s, "set lexdb_planner = rules")
    show(mut &s, "select count(*), count(s.label) from big b left join small s on s.id = b.sid")
    show(mut &s, "select s.id, b.v from small s left join big b on b.id = s.id * 1000 where s.id < 3")
    show(mut &s, "reset lexdb_planner")
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
