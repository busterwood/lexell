const SETUP = "create table dept (id number primary key, name varchar2(20), budget number)\ncreate table emp (id number primary key, dept number not null, sal number, mgr number, role varchar2(10))\ncreate table proj (id number primary key, dept number not null, lead number not null)\ncreate table nn (id number, v number)\ncreate table d1 (id number primary key, v number)\ncreate table r1 (id number primary key, grp number not null, role varchar2(10))\ncreate table tx (k varchar2(10) primary key, v number)\ncreate table cv (id number primary key, v number)\ncreate table vt (id number, sal number)\ncreate view vemp as select * from vt\ninsert into dept values (1, 'Sales', 100)\ninsert into dept values (2, 'Labs', 200)\ninsert into dept values (3, 'Empty', null)\ninsert into emp values (1, 1, 50, null, 'boss')\ninsert into emp values (2, 1, 30, 1, 'dev')\ninsert into emp values (3, 2, 40, null, 'boss')\ninsert into emp values (4, 2, null, 3, 'dev')\ninsert into proj values (10, 1, 1)\ninsert into proj values (11, 2, 3)\ninsert into nn values (1, 5)\ninsert into nn values (2, null)\ninsert into r1 values (1, 1, 'A')\ninsert into tx values ('a', 1)\ninsert into cv values (1, -1)\ncreate assertion sal_pos check (not exists (select 1 from emp where sal < 0))\ncreate assertion nn_pos check (all (select v from nn) satisfy (v > 0))\ncreate assertion lead_boss check (not exists (select 1 from proj p, emp e where p.lead = e.id and e.role = 'dev'))\ncreate assertion has_boss check (not exists (select 1 from proj p where not exists (select 1 from emp e where e.dept = p.dept and e.role = 'boss')))\ncreate assertion in_budget check (not exists (select 1 from emp e, dept d where e.dept = d.id and e.sal > d.budget))\ncreate assertion any_dept check (exists (select 1 from dept))\ncreate assertion d1_neg check (not exists (select 1 from d1 where v < 0)) deferrable initially deferred\ncreate assertion d1_big check (not exists (select 1 from d1 where v > 100)) deferrable\ncreate assertion r1_ab check (not exists (select 1 from r1 x, r1 y where x.grp = y.grp and x.role = 'A' and y.role = 'B'))\ncreate assertion tx_key check (not exists (select 1 from tx where k = 'zz' and v is null))\ncreate assertion cv_pos check (not exists (select 1 from cv where v < 0)) novalidate"

const QS = "insert into emp values (5, 1, -1, null, 'dev') ;; select count(*) n from emp\ninsert into emp values (5, 1, 10, null, 'dev') ;; select count(*) n from emp\ninsert into emp values (5, 3, 1000, null, 'dev') ;; select count(*) n from emp\ninsert into emp values (5, 1, null, null, 'dev') ;; insert into emp values (6, 1, 0, null, 'dev') ;; select count(*) n from emp\ninsert into emp select 10 + level, 1, 60 - level * 25, null, 'dev' from dual connect by level <= 3 ;; select count(*) n from emp\ninsert into emp select 10 + level, 1, 60 - level * 15, null, 'dev' from dual connect by level <= 3 ;; select count(*) n from emp\ninsert into emp select 100 + level, 2, mod(level, 7), null, 'dev' from dual connect by level <= 200 ;; select count(*) n from emp\ninsert into emp select 100 + level, 2, mod(level, 7) - case when level = 150 then 10 else 0 end, null, 'dev' from dual connect by level <= 200 ;; select count(*) n from emp\nupdate emp set sal = -5 where id = 2 ;; select sal from emp where id = 2\nupdate emp set sal = case id when 1 then 60 when 2 then 500 else sal end ;; select id, sal from emp order by id\nupdate emp set sal = case id when 1 then 60 when 2 then 5 else sal end ;; select id, sal from emp order by id\nupdate emp set sal = sal + 60 ;; select id, sal from emp order by id\nupdate emp set sal = sal + 10 ;; select id, sal from emp order by id\nupdate dept set budget = 20 where id = 1 ;; select budget from dept where id = 1\nupdate dept set budget = null where id = 1 ;; select budget from dept where id = 1\nupdate dept set budget = budget - 50 ;; select id, budget from dept order by id\ninsert into proj values (12, 1, 2) ;; select count(*) n from proj\ninsert into proj values (12, 2, 3) ;; select count(*) n from proj\ninsert into proj values (13, 3, 1) ;; select count(*) n from proj\nupdate emp set role = 'dev' where id = 1 ;; select role from emp where id = 1\nupdate emp set role = 'dev' where id = 3 ;; select role from emp where id = 3\nupdate emp set role = 'boss' where id = 4 ;; update emp set role = 'dev' where id = 3 ;; select id, role from emp order by id\nupdate proj set lead = 2 where id = 10 ;; select lead from proj where id = 10\nupdate proj set dept = 3 where id = 11 ;; select dept from proj where id = 11\ndelete from emp where id = 3 ;; select count(*) n from emp\ndelete from emp where id = 4 ;; select count(*) n from emp\ndelete from emp where role = 'boss' ;; select count(*) n from emp\ndelete from proj where id = 11 ;; delete from emp where id = 3 ;; select count(*) n from emp\ndelete from dept where id = 3 ;; select count(*) n from dept\ndelete from dept ;; select count(*) n from dept\ndelete from dept where id > 1 ;; delete from dept where id = 1 ;; select count(*) n from dept\nmerge into emp t using (select 2 id, -3 sal from dual) s on (t.id = s.id) when matched then update set t.sal = s.sal ;; select sal from emp where id = 2\nmerge into emp t using (select 9 id, -3 sal from dual) s on (t.id = s.id) when not matched then insert values (s.id, 1, s.sal, null, 'dev') ;; select count(*) n from emp\nmerge into emp t using (select 9 id, 3 sal from dual) s on (t.id = s.id) when not matched then insert values (s.id, 1, s.sal, null, 'dev') ;; select count(*) n from emp\nbegin insert into emp values (7, 1, 5, null, 'dev'); insert into emp values (8, 1, -5, null, 'dev'); end; ;; select count(*) n from emp\nbegin insert into emp values (7, 1, 5, null, 'dev'); begin insert into emp values (8, 1, -5, null, 'dev'); exception when others then null; end; end; ;; select id from emp order by id\nbegin update emp set sal = sal - 100 where id = 1; end; ;; select sal from emp where id = 1\ninsert into nn values (3, -1) ;; select count(*) n from nn\ninsert into nn values (3, null) ;; select count(*) n from nn\ninsert into nn values (3, 7) ;; update nn set v = 0 where id = 3 ;; select id, v from nn order by id\nupdate nn set v = v - 5 ;; select id, v from nn order by id\ninsert into r1 values (2, 1, 'B') ;; select count(*) n from r1\ninsert into r1 values (2, 2, 'B') ;; select count(*) n from r1\ninsert into r1 values (2, 2, 'A') ;; insert into r1 values (3, 2, 'B') ;; select count(*) n from r1\nupdate r1 set role = 'B' where id = 1 ;; insert into r1 values (2, 1, 'A') ;; select count(*) n from r1\ninsert into tx values ('zz', null) ;; select count(*) n from tx\ninsert into tx values ('zz', 1) ;; update tx set v = null where k = 'zz' ;; select count(*) n from tx\ninsert into tx values ('ZZ', null) ;; select count(*) n from tx\ninsert into cv values (2, 5) ;; select count(*) n from cv\ninsert into cv values (2, -5) ;; select count(*) n from cv\nupdate cv set v = -2 where id = 1 ;; select v from cv where id = 1\nupdate cv set v = 3 where id = 1 ;; select v from cv where id = 1\ninsert into d1 values (1, -5) ;; select count(*) n from d1 ;; commit ;; select count(*) n from d1\ninsert into d1 values (2, -5) ;; update d1 set v = 5 where id = 2 ;; commit ;; select id, v from d1 ;; delete from d1 ;; commit ;; select count(*) n from d1\ninsert into d1 values (3, 200) ;; select count(*) n from d1\nset constraint d1_big deferred ;; insert into d1 values (3, 200) ;; select count(*) n from d1 ;; commit ;; select count(*) n from d1\nset constraints all deferred ;; insert into d1 values (4, 200) ;; set constraints all immediate ;; select count(*) n from d1\nset constraint d1_neg immediate ;; insert into d1 values (5, -1) ;; select count(*) n from d1\nset constraint d1_neg immediate ;; insert into d1 values (5, 1) ;; insert into d1 values (6, -1) ;; set constraint d1_neg deferred ;; insert into d1 values (6, -1) ;; select count(*) n from d1 ;; commit ;; select count(*) n from d1\nset constraint sal_pos deferred\nset constraint d1_neg, d1_big deferred ;; insert into d1 values (7, 500) ;; insert into d1 values (8, -500) ;; set constraint d1_big immediate ;; select count(*) n from d1\nselect assertion_name, status, deferrable, deferred, validated, invalid from user_assertions order by 1\nselect assertion_name, replace(replace(definition_sql, chr(13), '<cr>'), chr(10), '<lf>') d from user_assertions where assertion_name in ('SAL_POS', 'NN_POS', 'D1_NEG', 'CV_POS') order by 1\nselect owner, assertion_name, status from all_assertions where owner = 'APP' order by 2\nselect assertion_name, referenced_owner, referenced_name, referenced_type, referenced_id, validation_type, validation_event from user_assertion_dependencies order by 1, 5\nselect owner, assertion_name, referenced_name, referenced_id from all_assertion_dependencies where assertion_name = 'HAS_BOSS' order by 4\nselect object_name, object_type, status from user_objects where object_type = 'UNDEFINED' order by 1\nselect count(*) n from user_assertion_lock_matrix where assertion_name = 'SAL_POS'\ncreate assertion a1 check (not exists (select count(*) from emp having count(*) > 3))\ncreate assertion a1 check (not exists (select dept from emp group by dept having count(*) > 9))\ncreate assertion a1 check (not exists (select 1 from emp where sal < 0) or not exists (select 1 from emp where sal > 1000))\ncreate assertion a1 check (not exists (select 1 from emp where sal < 0) and not exists (select 1 from emp where sal > 1000))\ncreate assertion a1 check (not exists (select 1 from emp where sal = 7 union all select 1 from emp where sal = 8))\ncreate assertion a1 check (not exists (select 1 from emp where sal = 7 order by 1))\ncreate assertion a1 check (not exists (select 1 from emp where sal = 7 fetch first 1 rows only))\ncreate assertion a1 check (not exists (select 1 from emp where nosuch > sysdate))\ncreate assertion a1 check (not exists (select 1 from emp where sal > sysdate - sysdate))\ncreate assertion a1 check (not exists (select 1 from emp where rownum = 1 and sal = 7))\ncreate assertion a1 check (not exists (select row_number() over (order by id) from emp where sal = 7))\ncreate assertion a1 check (not exists (select 1 from dual where 1 = 0))\ncreate assertion a1 check (not exists (select 1 from emp a, emp b where a.id <> b.id and a.mgr = b.mgr))\ncreate assertion a1 check (not exists (select 1 from emp a, emp b where a.id <> b.id and a.mgr = b.mgr and a.mgr > 0)) ;; drop assertion a1\ncreate assertion a1 check (not exists (select 1 from emp a left join emp b on a.id = b.mgr where b.id is null and a.sal = 77))\ncreate assertion a1 check (not exists (select 1 from emp a where a.sal = 56 and a.id not in (select b.dept from proj b))) ;; drop assertion a1\ncreate assertion a1 check (not exists (select 1 from emp a where a.sal = 56 and a.mgr not in (select b.dept from proj b)))\ncreate assertion a1 check (not exists (select 1 from emp a where a.sal = 56 and a.id in (select b.lead from proj b))) ;; drop assertion a1\ncreate assertion a1 check (not exists (select 1 from emp where sal in (select max(sal) from emp)))\ncreate assertion a1 check (not exists (select 1 from emp where sal = (select 1 from dual)))\ncreate assertion a1 check (not exists (with w as (select * from emp) select 1 from w where w.sal = 58))\ncreate assertion a1 check (not exists (select 1 from user_tables))\ncreate assertion a1 check (not exists (select 1 from vemp where sal = 59))\ncreate assertion a1 check (not exists (select 1 from nosuch))\ncreate assertion a1 check (all (select sal from emp x) satisfy (x.sal < 1000))\ncreate assertion a1 check (all (select sal + 1 from emp) satisfy (sal < 1000))\ncreate assertion a1 check (all (select sal from emp) satisfy (sal < 1000 and exists (select 1 from dept)))\ncreate assertion a1 check (all (select sal from emp where dept = 1) satisfy (sal > 0) and not exists (select 1 from emp where sal = 60))\ncreate assertion a1 check (1 = 1)\ncreate assertion a1 check not exists (select 1 from emp)\ncreate assertion a1 (not exists (select 1 from emp))\ncreate assertion check (not exists (select 1 from emp))\ncreate assertion a1 check (not exists (select 1 from emp where sal = 3)) not deferrable initially deferred\ncreate assertion a1 check (not exists (select 1 from emp where sal = 3)) disable validate\ncreate assertion a1 check (not exists (select 1 from emp where sal = 3)) deferrable deferrable\ncreate assertion a1 check (not exists (select 1 from emp where sal = 3)) rely\ncreate or replace assertion a1 check (not exists (select 1 from emp where sal = 3))\ncreate assertion sal_pos check (not exists (select 1 from emp where sal = 3))\ncreate assertion emp check (not exists (select 1 from emp where sal = 3))\ncreate assertion if not exists sal_pos check (not exists (select 1 from emp where sal = 3))\ncreate assertion a1 check (not exists (select 1 from emp where sal > 45))\ncreate table sal_pos (x number)\ncreate view sal_pos as select 1 x from dual\ncreate sequence sal_pos\ndrop assertion nosuch\ndrop assertion if exists nosuch\nalter assertion nosuch enable\nalter assertion sal_pos deferrable\nalter assertion sal_pos rename to s2\nalter assertion sal_pos\nalter assertion sal_pos disable validate\ncreate assertion a1 check (not exists (select 1 from emp where sal > 45)) novalidate ;; select validated from user_assertions where assertion_name = 'A1' ;; insert into emp values (9, 1, 46, null, 'dev') ;; insert into emp values (9, 1, 44, null, 'dev') ;; update emp set sal = 51 where id = 1 ;; update emp set mgr = 7 where id = 1 ;; update emp set sal = 45 where id = 1 ;; delete from emp where id = 9 ;; drop assertion a1 ;; update emp set sal = 50 where id = 1 ;; commit\ncreate assertion a1 check (not exists (select 1 from emp where sal > 45)) disable ;; select status, validated from user_assertions where assertion_name = 'A1' ;; insert into emp values (9, 1, 46, null, 'dev') ;; delete from emp where id = 9 ;; drop assertion a1\ncreate assertion a1 check (not exists (select 1 from emp where sal > 45)) enable novalidate ;; alter assertion a1 enable ;; alter assertion a1 enable validate ;; alter assertion a1 disable ;; select status, validated from user_assertions where assertion_name = 'A1' ;; alter assertion a1 enable novalidate ;; select status, validated from user_assertions where assertion_name = 'A1' ;; drop assertion a1\nalter assertion sal_pos disable ;; insert into emp values (9, 1, -9, null, 'dev') ;; alter assertion sal_pos enable ;; select status, validated from user_assertions where assertion_name = 'SAL_POS' ;; delete from emp where id = 9 ;; alter assertion sal_pos enable ;; select status, validated from user_assertions where assertion_name = 'SAL_POS'\ncreate assertion a1 check (not exists (select 1 from emp where sal > 1000)) ;; create table a1 (x number) ;; create assertion a1 check (not exists (select 1 from emp where sal > 1000)) ;; drop assertion a1 ;; drop assertion a1\ncreate assertion \"MixA\" check (not exists (select 1 from emp where sal > 1000)) ;; select assertion_name from user_assertions where assertion_name like 'M%' ;; drop assertion \"MixA\"\ncreate assertion app.a1 check (not exists (select 1 from app.emp where sal > 1000)) ;; select assertion_name from user_assertions where assertion_name = 'A1' ;; drop assertion app.a1\nalter table emp drop column sal\nalter table emp rename column sal to s\nalter table emp drop column role\nalter table dept rename column budget to b\nalter table proj rename column lead to l\nalter table emp modify (sal number(5,0))\nalter table emp add (x number) ;; alter table emp drop column x ;; alter table emp rename column mgr to m ;; alter table emp rename column m to mgr ;; select count(*) n from emp\nrename emp to emp2\nalter table emp rename to emp2\ndrop table emp\ndrop table dept\ncreate table tmp1 (id number primary key, v number) ;; create assertion tmp_a check (not exists (select 1 from tmp1 where v < 0)) ;; drop table tmp1 ;; drop table tmp1 cascade constraints purge ;; select count(*) n from user_assertions where assertion_name = 'TMP_A' ;; select count(*) n from user_tables where table_name = 'TMP1'\ncreate table tmp1 (id number primary key, v number) ;; create table tmp2 (id number primary key, w number not null) ;; create assertion tmp_a check (not exists (select 1 from tmp1, tmp2 where tmp1.id = tmp2.id and tmp1.v > tmp2.w)) ;; drop table tmp2 cascade constraints purge ;; insert into tmp1 values (1, -1) ;; select count(*) n from user_assertions where assertion_name = 'TMP_A' ;; drop table tmp1 purge\ncreate table tmp1 (id number primary key, v number) ;; create assertion tmp_a check (not exists (select 1 from tmp1 where v < 0)) ;; truncate table tmp1 ;; insert into tmp1 values (1, -1) ;; drop table tmp1 cascade constraints purge"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back after them all (a failing one undone alone, as in
// Oracle: the others go on), each answer joined by " / ": as gen_oracle.py --check gives Oracle's.
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) { append(mut &out, one(c2, &parts[i])) }
        return Err(sqldialect.inputError("rolled back"))
    })
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(173), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
