// lexdb_base: CRC32C against the published check value and the iSCSI
// vectors (RFC 3720 B.4), and the generator's determinism.
// expect: e3069283
// expect: 8a9136aa 62a8ab43
// expect: true
import "../../../cmd/lexdb_base"
import "strings"

fn hex(c: u32): str { return strings.padLeft(&(strings.hex(int(c))), 8, '0') }

fn main() {
    let v = "123456789"
    var nine: []byte = []
    for i in 0..len(v) { append(mut &nine, v[i]) }
    println(hex(lexdb_base.crc32c(&nine, 0, 9)))
    let zeros = array(32, byte(0))
    let ones = array(32, byte(0xFF))
    println(hex(lexdb_base.crc32c(&zeros, 0, 32)) + " " + hex(lexdb_base.crc32c(&ones, 0, 32)))
    var a = lexdb_base.rng(42)
    var b = lexdb_base.rng(42)
    var same = true
    for i in 0..100 { if a.next() != b.next() { same = false } }
    println(same)
}
