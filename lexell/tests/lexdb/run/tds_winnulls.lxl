// lexdb over TDS: IGNORE NULLS and RESPECT NULLS of LAG, LEAD, FIRST_VALUE and LAST_VALUE (SQL Server 2022,
// design/lexdb-new-features.md S15), checked against SQL Server 2022 (generated by tests/lexdb/gen_mssql.py from
// mssql_winnulls_queries.txt): SQL Server's LAG and LEAD (the row the offset names, then the nearest value not NULL beyond
// it; the default only past the partition), offsets 0 and 2, a NULL offset, defaults, partitions, frames, text, a named
// window, 3,000 rows grouped, no rows, every value NULL, an error in a later row (8134); 8730, 16208, 195, 102, 156. Each
// batch runs with SET lexdb_batch = off and on: "same: " and the answer, or DIFFERENT and both.
// expect: (9)
// expect: (3000)
// expect: ok
// expect: same: id,a,b,c,d,e: 1|NULL|10|NULL|NULL|10;2|NULL|20|NULL|10|20;3|10|20|NULL|10|20;4|10|30|10|20|NULL;5|20|30|10|20|-1;6|20|30|20|20|30;7|20|30|20|20|30;8|20|NULL|20|30|NULL;9|30|NULL|20|30|-1
// expect: same: id,a,b,c,d,e: 1|20|NULL|10|NULL|NULL;2|20|NULL|10|NULL|NULL;3|30|NULL|20|NULL|10;4|30|NULL|20|NULL|NULL;5|30|NULL|30|NULL|20;6|30|NULL|30|NULL|NULL;7|NULL|NULL|30|NULL|NULL;8|0|NULL|30|NULL|NULL;9|0|NULL|NULL|NULL|30
// expect: same: id,a,b,d,e: 1|NULL|NULL|NULL|10;2|10|10|NULL|10;3|10|10|NULL|20;4|10|20|NULL|20;5|10|20|NULL|20;6|10|20|NULL|NULL;7|10|20|NULL|30;8|10|30|NULL|30;9|10|30|NULL|30
// expect: same: id,a,b,c: 1|10|20|10;2|20|20|10;3|20|20|20;4|NULL|20|20;5|30|20|30;6|30|30|20;7|30|30|20;8|NULL|30|30;9|NULL|30|NULL
// expect: same: id,a,b,c: 1|'none'|'p'|'s';2|NULL|'p'|'s';3|'p'|'r'|'s';4|'p'|'r'|'s';5|'q'|'r'|'s';6|'r'|NULL|'s';7|'r'|NULL|'s';8|'r'|'s'|'s';9|'r'|'s'|'s'
// expect: same: id,a,b: 1|NULL|NULL;2|NULL|10;3|10|10;4|10|10;5|20|10;6|NULL|NULL;7|NULL|NULL;8|NULL|30;9|30|30
// expect: same: g,n,sa,sb,sc,sd,sf: 0|428|10534|10566|10522|10502|6885;1|429|10469|10598|10509|10440|7007;2|429|10583|10521|10395|10622|7109;3|429|10568|10611|10474|10601|6932;4|429|10492|10580|10531|10377|6879;5|428|10587|10448|10359|10514|7082;6|428|10550|10430|10351|10585|7003
// expect: same: id,k,a,b: 5|NULL|NULL|NULL;10|NULL|5|NULL;11|'k2'|NULL|NULL;12|'k0'|NULL|NULL;1500|NULL|10|5;2995|NULL|10|10;2996|'k2'|11|NULL;3000|NULL|45|10
// expect: same: id,a,b: 
// expect: same: id,a,b: 1|NULL|NULL;3|NULL|NULL;5|NULL|NULL;6|NULL|NULL;7|NULL|NULL;9|NULL|NULL
// expect: same: error 8134
// expect: same: error 8730
// expect: same: error 16208
// expect: same: error 16208
// expect: same: error 16208
// expect: same: error 16208
// expect: same: error 195
// expect: same: error 102
// expect: same: error 156
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once create table wn (id int primary key, g int, k varchar(5), x int, s varchar(5)); insert into wn values (1, 1, 'a', null, null), (2, 1, 'a', 10, 'p'), (3, 1, 'b', null, null), (4, 1, 'b', 20, 'q'), (5, 1, 'b', null, 'r'), (6, 2, 'a', null, null), (7, 2, 'a', null, null), (8, 2, 'c', 30, null), (9, 2, 'c', null, 's')\n@once create table wb (id int primary key, g int, k varchar(5), x int); insert into wb select value, value % 7, case when value % 5 = 0 then null else 'k' + cast(value % 3 as varchar(2)) end, case when value % 4 = 0 or value % 9 = 0 then null else value % 50 end from generate_series(1, 3000)\n@once create table we (id int primary key, x int)\nselect id, lag(x) ignore nulls over (order by id) a, lead(x) ignore nulls over (order by id) b, lag(x, 2) ignore nulls over (order by id) c, lag(x, 0) ignore nulls over (order by id) d, lead(x, 1, -1) ignore nulls over (partition by g order by id) e from wn order by id\nselect id, lead(x, 2, 0) ignore nulls over (order by id) a, lag(x, 3) ignore nulls over (partition by k order by id) b, lead(x, 0) ignore nulls over (order by id) c, lag(x, null) ignore nulls over (order by id) d, lag(x) respect nulls over (order by id) e from wn order by id\nselect id, first_value(x) ignore nulls over (order by id) a, last_value(x) ignore nulls over (order by id) b, first_value(x) respect nulls over (order by id) d, last_value(x) ignore nulls over (order by id rows between 1 preceding and 1 following) e from wn order by id\nselect id, first_value(x) ignore nulls over (order by id rows between 1 following and 3 following) a, last_value(x) ignore nulls over (partition by g order by id range between unbounded preceding and unbounded following) b, first_value(x) ignore nulls over (order by k, id rows between current row and unbounded following) c from wn order by id\nselect id, lag(s, 1, 'none') ignore nulls over (order by id) a, first_value(s) ignore nulls over (partition by k order by id desc) b, last_value(s) ignore nulls over (order by k, id range between unbounded preceding and unbounded following) c from wn order by id\nselect id, lag(x) ignore nulls over w1 a, first_value(x) ignore nulls over w1 b from wn window w1 as (partition by g order by id) order by id\nselect g, count(*) n, sum(a) sa, sum(b) sb, sum(c) sc, sum(d) sd, sum(f) sf from (select g, lag(x) ignore nulls over (partition by g order by id) a, lead(x, 3, 0) ignore nulls over (partition by g order by id) b, first_value(x) ignore nulls over (partition by g order by id rows between 5 preceding and 5 following) c, last_value(x) ignore nulls over (partition by k order by id) d, lag(x, 2, -1) respect nulls over (partition by g order by id) f from wb) t group by g order by g\nselect id, k, lag(x) ignore nulls over (partition by k order by id) a, last_value(x) ignore nulls over (partition by k order by id rows between 10 preceding and 2 preceding) b from wb where id in (5, 10, 11, 12, 1500, 2995, 2996, 3000) order by id\nselect id, lag(x) ignore nulls over (order by id) a, first_value(x) ignore nulls over (order by id) b from we\nselect id, lag(x) ignore nulls over (order by id) a, last_value(x) ignore nulls over (order by id) b from wn where x is null order by id\nselect count(a) n from (select lag(x, 3000 / (3000 - id)) ignore nulls over (order by id) a from wb) t\nselect lag(x, -1) ignore nulls over (order by id) from wn\nselect row_number() ignore nulls over (order by id) from wn\nselect sum(x) ignore nulls over (order by id) from wn\nselect rank() respect nulls over (order by id) from wn\nselect ntile(2) ignore nulls over (order by id) from wn\nselect nth_value(x, 2) ignore nulls over (order by id) from wn\nselect lag(x ignore nulls) over (order by id) from wn\nselect first_value(x) ignore nulls from wn"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(48), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
