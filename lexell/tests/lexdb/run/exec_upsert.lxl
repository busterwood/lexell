// lexdb_exec: INSERT ... ON CONFLICT, checked against PostgreSQL 18
// (generated by tests/lexdb/gen_pg.py from upsert_queries.txt): DO NOTHING
// on each kind of key, DO UPDATE with EXCLUDED and the row there, its WHERE,
// RETURNING, a row touched twice, the targets (ON CONSTRAINT, several
// columns, none matching), an alias, DEFAULT, INSERT ... SELECT, ROLLBACK.
// Each expect line: a query's rows or tag, or ERROR and its SQLSTATE.
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: INSERT 0 0
// expect: INSERT 0 0
// expect: INSERT 0 0
// expect: INSERT 0 0
// expect: INSERT 0 1
// expect: 1|a@x|Ann|0;2|b@x|Bob|0;5|e@x|Eve|0
// expect: INSERT 0 1
// expect: ERROR 42702
// expect: 1|a@x|Annie|1;2|b@x|Bob|0;5|e@x|Eve|0
// expect: INSERT 0 0
// expect: INSERT 0 0
// expect: 1|a@x|Annie|1;2|b@x|Bob|0;5|e@x|Eve|0
// expect: 1|R1|1;6|R6|0;INSERT 0 2
// expect: 7;INSERT 0 1
// expect: ERROR 21000
// expect: INSERT 0 1
// expect: 1|a@x|R1|1;2|b@x|Bob|0;5|e@x|Eve|0;6|f@x|R6|0;7|g@x|R7|0;8|h@x|H|0
// expect: INSERT 0 1
// expect: ERROR 42P10
// expect: ERROR 42601
// expect: ERROR 42704
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: INSERT 0 2
// expect: 1|1|one;1|2|TWO;2|1|new
// expect: ERROR 23505
// expect: INSERT 0 1
// expect: INSERT 0 1
// expect: INSERT 0 1
// expect: INSERT 0 2
// expect: 1|a@x|R1+|1;2|b@x|pair+|42;5|e@x|Eve|0;6|f@x|R6|0;7|g@x|R7|0;8|h@x|H|0
// expect: BEGIN
// expect: INSERT 0 1
// expect: ROLLBACK
// expect: R1+
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table u (id int primary key, email text unique, name text, hits int not null default 0)\ninsert into u values (1, 'a@x', 'Ann', 0), (2, 'b@x', 'Bob', 0)\ninsert into u values (1, 'z@x', 'Zed', 0) on conflict do nothing\ninsert into u values (3, 'a@x', 'Ann2', 0) on conflict do nothing\ninsert into u values (1, 'q@x', 'Q', 0) on conflict (id) do nothing\ninsert into u values (4, 'b@x', 'B2', 0) on conflict (email) do nothing\ninsert into u values (5, 'e@x', 'Eve', 0) on conflict do nothing\nselect * from u order by id\ninsert into u values (1, 'a@x', 'Annie', 0) on conflict (id) do update set name = excluded.name, hits = u.hits + 1\ninsert into u values (9, 'b@x', 'Bobby', 0) on conflict (email) do update set name = excluded.name || '!', hits = hits + 10\nselect * from u order by id\ninsert into u values (1, 'a@x', 'Never', 0) on conflict (id) do update set name = excluded.name where u.hits > 100\ninsert into u values (2, 'b@x', 'Maybe', 0) on conflict (id) do update set name = excluded.name where u.hits >= 10\nselect * from u order by id\ninsert into u values (1, 'a@x', 'R1', 0), (6, 'f@x', 'R6', 0) on conflict (id) do update set name = excluded.name returning id, name, hits\ninsert into u values (1, 'a@x', 'R1', 0), (7, 'g@x', 'R7', 0) on conflict do nothing returning id\ninsert into u values (8, 'h@x', 'H', 0), (8, 'h2@x', 'H2', 0) on conflict (id) do update set name = excluded.name\ninsert into u values (8, 'h@x', 'H', 0), (8, 'h2@x', 'H2', 0) on conflict (id) do nothing\nselect * from u order by id\ninsert into u values (2, 'b@x', 'C', 0) on conflict on constraint u_pkey do update set name = 'by constraint'\ninsert into u values (2, 'b@x', 'C', 0) on conflict (name) do nothing\ninsert into u values (2, 'b@x', 'C', 0) on conflict do update set name = 'x'\ninsert into u values (2, 'b@x', 'C', 0) on conflict on constraint nope do nothing\ncreate table pair (a int, b int, v text, primary key (a, b))\ninsert into pair values (1, 1, 'one'), (1, 2, 'two')\ninsert into pair values (1, 2, 'TWO'), (2, 1, 'new') on conflict (b, a) do update set v = excluded.v\nselect * from pair order by a, b\ninsert into u values (2, 'a@x', 'D', 0) on conflict (id) do update set email = excluded.email\ninsert into u as t (id, email, name) values (2, 'b@x', 'Alias') on conflict (id) do update set name = excluded.name, hits = t.hits + 1\ninsert into u values (2, 'b@x', 'Def', 5) on conflict (id) do update set hits = default\ninsert into u (id, email) values (2, 'b@x') on conflict (id) do update set (name, hits) = ('pair', 42)\ninsert into u select id, email, name || '+', 0 from u where id <= 2 on conflict (id) do update set name = excluded.name\nselect * from u order by id\nbegin\ninsert into u values (1, 'a@x', 'Rolled', 0) on conflict (id) do update set name = excluded.name\nrollback\nselect name from u where id = 1"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(77), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
