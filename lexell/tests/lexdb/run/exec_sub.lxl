// lexdb_exec: subqueries. Scalar, EXISTS and IN (SELECT ...), uncorrelated
// (run once) and correlated (per row, cached by outer value), nested, in
// WHERE, ON, the select list, ORDER BY, GROUP BY, HAVING, UPDATE,
// DELETE and INSERT; hashed (no index on the correlating column): EXISTS,
// NOT EXISTS, IN and NOT IN with their NULLs; the errors. Expected
// output checked by hand when written.
// expect: create table c (id int primary key, name text, city text) -> CREATE TABLE
// expect: create table o (id int primary key, cust int, amount numeric(8,2), status text) -> CREATE TABLE
// expect: create index o_cust on o (cust) -> CREATE INDEX
// expect: insert into c values (1,'ann','paris'),(2,'bob','rome'),(3,'cy','paris'),(4,'dee',null),(5,'eve','oslo') -> INSERT 0 5
// expect: insert into o values (10,1,5.00,'paid'),(11,1,7.50,'open'),(12,2,3.00,'paid'),(13,3,9.99,'open'),(14,null,1.00,'paid'),(15,9,2.00,'paid') -> INSERT 0 6
// expect: select (select max(amount) from o) -> 9.99
// expect: select id from c where id = (select min(cust) from o)  -> 1
// expect: explain select id from c where id = (select min(cust) from o) -> scan c: primary key lookup; subquery 1 (scalar): run once;   scan o: index o_cust scan;   min/max: the first value in the scan's order
// expect: select id from c where id in (select cust from o where status = 'paid') order by id -> 1; 2
// expect: select id from c where id not in (select cust from o where status = 'paid') order by id -> SELECT 0
// expect: select id from c where id not in (select cust from o where cust is not null) order by id -> 4; 5
// expect: select id, id in (select cust from o) from c order by id -> 1|t; 2|t; 3|t; 4|NULL; 5|NULL
// expect: select exists (select 1 from o where amount > 9), exists (select 1 from o where amount > 100) -> t|f
// expect: select (select name from c where id = 99) -> NULL
// expect: select (select name from c) -> 21000 more than one row returned by a subquery used as an expression
// expect: select (select id, name from c where id = 1) -> 42601 subquery must return only one column
// expect: select id from c where id in (select id, name from c) -> 42601 subquery has too many columns
// expect: select 2.0 in (select cust from o), '3' in (select cust from o) -> t|t
// expect: select id, name from c where exists (select 1 from o where o.cust = c.id) order by id -> 1|ann; 2|bob; 3|cy
// expect: select id from c where not exists (select 1 from o where o.cust = c.id) order by id -> 4; 5
// expect: select c.id, (select count(*) from o where o.cust = c.id) from c order by c.id -> 1|2; 2|1; 3|1; 4|0; 5|0
// expect: select name, (select sum(amount) from o where cust = c.id and status = 'paid') as paid from c order by name -> ann|5.00; bob|3.00; cy|NULL; dee|NULL; eve|NULL
// expect: select id from c where (select count(*) from o where o.cust = c.id) >= 1 and city = 'paris' order by id -> 1; 3
// expect: select id from c where id in (select cust from o where o.amount > c.id * 3) order by id -> 1; 3
// expect: select id from c x where exists (select 1 from c y where y.city = x.city and y.id <> x.id) order by id -> 1; 3
// expect: select id from c where exists (select 1 from o where o.cust = c.id and exists (select 1 from c c2 where c2.id = o.cust and c2.city = 'rome')) -> 2
// expect: select id from c where exists (select 1 from o where exists (select 1 from c c2 where c2.id = o.cust and o.cust = c.id and c2.city = 'paris')) order by id -> 1; 3
// expect: select c.id, o.id from c join o on o.cust = c.id where o.amount = (select max(amount) from o o2 where o2.cust = c.id) order by c.id -> 1|11; 2|12; 3|13
// expect: select city, count(*) from c where exists (select 1 from o where o.cust = c.id) group by city order by city -> paris|2; rome|1
// expect: select city, (select count(*) from o where o.status = 'paid') from c group by city order by city -> oslo|4; paris|4; rome|4; NULL|4
// expect: select city, count(*) from c group by city having count(*) >= (select count(*) from o where status = 'open') order by city -> paris|2
// expect: select city, count(*) from c group by city having count(*) > (select count(*) from c c2 where c2.city = c.city and c2.id > 3) order by city -> paris|2; rome|1; NULL|1
// expect: select id from c order by (select count(*) from o where o.cust = c.id) desc, id -> 1; 2; 3; 4; 5
// expect: explain analyze select id from c where exists (select 1 from o where o.cust = c.id) -> scan c: full scan (rows read 5, kept 3); subquery 1 (exists): per row, on c.id (runs 5, from cache 0);   scan o: index o_cust lookup (rows read 3, kept 3); result: 3 rows
// expect: select o.id from o where (select city from c where c.id = o.cust) = 'paris' order by o.id -> 10; 11; 13
// expect: explain analyze select o.id from o where (select city from c where c.id = o.cust) = 'paris' -> scan o: full scan (rows read 6, kept 3); subquery 1 (scalar): per row, on o.cust (runs 5, from cache 1);   scan c: primary key lookup (rows read 3, kept 3); result: 3 rows
// expect: select c.id, o.id from c left join o on o.cust = c.id where not exists (select 1 from o o3 where o3.id = o.id and o3.status = 'open') order by c.id, o.id -> 1|10; 2|12; 4|NULL; 5|NULL
// expect: select c.id, o.id from c join o on o.cust = c.id and o.amount > (select avg(amount) from o o4 where o4.cust = c.id) order by c.id -> 1|11
// expect: select c.id from c right join o on o.cust = c.id where o.amount < (select max(amount) from o) order by o.id -> 1; 1; 2; NULL; NULL
// expect: select c.id + 0 in (select cust from o where o.status = c.city) from c order by c.id -> f; f; f; f; f
// expect: select distinct (select count(*) from o where o.cust = c.id) from c order by 1 -> 0; 1; 2
// expect: select id, (select count(*) from o where o.cust = c.id) from c order by id limit 2 -> 1|2; 2|1
// expect: select id from c where exists (select 1 from o where o.cust = c.id order by amount desc limit 1) order by id -> 1; 2; 3
// expect: select (select id from o where o.cust = c.id order by amount desc limit 1) from c order by id -> 11; 12; 13; NULL; NULL
// expect: select id from c where city = (select city from c where id = 1) or exists (select 1 from o where o.cust = c.id and o.status = 'open') order by id -> 1; 3
// expect: select a.id, b.id from c a join c b on b.id = (select min(id) from c where id > a.id) order by a.id -> 1|2; 2|3; 3|4; 4|5
// expect: create table h (id int primary key, g int, v int) -> CREATE TABLE
// expect: insert into h values (1, 1, 10), (2, 1, null), (3, 2, 20), (4, 3, 30) -> INSERT 0 4
// expect: create table k (id int primary key, g int, x int) -> CREATE TABLE
// expect: insert into k values (1, 1, 10), (2, 1, 11), (3, 2, 20), (4, 2, null), (5, 4, 1), (6, null, 5) -> INSERT 0 6
// expect: select k.id, k.x in (select v from h where h.g = k.g), k.x not in (select v from h where h.g = k.g) from k order by k.id -> 1|t|f; 2|NULL|NULL; 3|t|f; 4|NULL|NULL; 5|f|t; 6|f|t
// expect: explain analyze select k.id from k where k.x not in (select v from h where h.g = k.g) -> scan k: full scan (rows read 6, kept 2); subquery 1 (in): hashed on h.g = k.g (runs 1, probes 6);   scan h: full scan (rows read 4, kept 4); result: 2 rows
// expect: select k.id from k where exists (select 1 from h where h.g = k.g) order by 1 -> 1; 2; 3; 4
// expect: select k.id from k where not exists (select 1 from h where k.g = h.g) order by 1 -> 5; 6
// expect: select k.id from k where exists (select 1 from h where h.g = k.g and h.v = k.x) order by 1 -> 1; 3
// expect: explain select k.id from k where exists (select 1 from h where h.g = k.g and h.v = k.x) -> scan k: full scan; subquery 1 (exists): hashed on h.g = k.g, h.v = k.x;   scan h: full scan
// expect: select k.id from k where exists (select 1 from h where h.g = k.g and h.v > 15) order by 1 -> 3; 4
// expect: select k.id from k where exists (select 1 from h where h.g + 0 = k.g + 0) order by 1 -> 1; 2; 3; 4
// expect: explain select k.id from k where exists (select 1 from h where h.g + 0 = k.g + 0) -> scan k: full scan; subquery 1 (exists): hashed on ("h"."g" + 0) = an outer expression;   scan h: full scan
// expect: select k.id from k where exists (select 1 from h join k k2 on k2.x = h.v where k2.g = k.g) order by 1 -> 1; 2; 3; 4
// expect: explain select k.id from k where exists (select 1 from h join k k2 on k2.x = h.v where k2.g = k.g) -> scan k: full scan; subquery 1 (exists): hashed on k2.g = k.g;   scan h: full scan;   join k k2: hash on (x) over full scan
// expect: select k.id from k where k.x + 10 in (select v from h where h.g = k.g + 1) order by 1 -> 1; 3
// expect: select k.id from k where exists (select 1 from h where h.g = k.g and exists (select 1 from h h2 where h2.id = h.id + 1)) order by 1 -> 1; 2; 3; 4
// expect: explain select k.id from k where exists (select 1 from h where h.g = k.g and h.v > k.x) -> scan k: full scan; subquery 1 (exists): per row, on k.g, k.x;   scan h: full scan
// expect: explain select k.id from k where exists (select 1 from h where h.id = k.g) -> scan k: full scan; subquery 1 (exists): per row, on k.g;   scan h: primary key lookup
// expect: explain select k.id from k where exists (select 1 from h left join c on c.id = h.v and c.id = k.x) -> scan k: full scan; subquery 1 (exists): per row, on k.x;   scan h: full scan;   left join c: primary key lookup per row
// expect: explain select id from c where id in (select cust from o where status = 'open') -> scan c: full scan; subquery 1 (in): run once;   scan o: full scan
// expect: select id from c where id in (select cust from o where status = $1) -> SELECT 0
// expect: update c set city = (select status from o where o.cust = c.id order by id limit 1) where id < 3 -> UPDATE 2
// expect: select id, city from c order by id -> 1|paid; 2|paid; 3|paris; 4|NULL; 5|oslo
// expect: delete from o where cust not in (select id from c) -> DELETE 1
// expect: select count(*) from o -> 5
// expect: insert into o values ((select max(id) + 1 from o), 5, (select sum(amount) from o), 'sum') -> INSERT 0 1
// expect: select * from o where cust = 5 -> 15|5|26.49|sum
// expect: select id from c where id = (select id from c) -> 21000 more than one row returned by a subquery used as an expression
// expect: select (select x from o) -> 42703 column "x" does not exist
// expect: select id from c where exists (select 1 from o where o.cust = c.nope) -> 42703 column c.nope does not exist
// expect: select id from c where exists (select 1 from o o1 join o o2 on o1.id = o2.id where id = 10) -> 42702 column reference "id" is ambiguous
// expect: select id from c where exists (select 1 from o where id = 10 and cust = c.id) -> 1
// expect: create index bad on c (id) where id in (select 1) -> 0A000 cannot use subquery in index predicate
// expect: select sum((select count(*) from o where o.cust = c.id)) from c -> 0A000 correlated subqueries in aggregate arguments are not supported yet
// expect: select (select count(*) from o where o.cust = c.id) from c group by city -> 42803 column "c.id" must appear in the GROUP BY clause or be used in an aggregate function
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"
fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            let out = sql + " -> " + (if len(lines) == 0 { r.tag } else { strings.join(&lines, "; ") })
            let k = strings.indexOf(out, " rows in ", 0)      // EXPLAIN ANALYZE's time varies
            println(if k >= 0 { out[0..k] + " rows" } else { out })
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}
fn main() {
    lexdb_store.run(lexdb_disk.sim(1), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st)
        show(mut &s, "create table c (id int primary key, name text, city text)")
        show(mut &s, "create table o (id int primary key, cust int, amount numeric(8,2), status text)")
        show(mut &s, "create index o_cust on o (cust)")
        show(mut &s, "insert into c values (1,'ann','paris'),(2,'bob','rome'),(3,'cy','paris'),(4,'dee',null),(5,'eve','oslo')")
        show(mut &s, "insert into o values (10,1,5.00,'paid'),(11,1,7.50,'open'),(12,2,3.00,'paid'),(13,3,9.99,'open'),(14,null,1.00,'paid'),(15,9,2.00,'paid')")
        show(mut &s, "select (select max(amount) from o)")
        show(mut &s, "select id from c where id = (select min(cust) from o) ")
        show(mut &s, "explain select id from c where id = (select min(cust) from o)")
        show(mut &s, "select id from c where id in (select cust from o where status = 'paid') order by id")
        show(mut &s, "select id from c where id not in (select cust from o where status = 'paid') order by id")
        show(mut &s, "select id from c where id not in (select cust from o where cust is not null) order by id")
        show(mut &s, "select id, id in (select cust from o) from c order by id")
        show(mut &s, "select exists (select 1 from o where amount > 9), exists (select 1 from o where amount > 100)")
        show(mut &s, "select (select name from c where id = 99)")
        show(mut &s, "select (select name from c)")
        show(mut &s, "select (select id, name from c where id = 1)")
        show(mut &s, "select id from c where id in (select id, name from c)")
        show(mut &s, "select 2.0 in (select cust from o), '3' in (select cust from o)")
        show(mut &s, "select id, name from c where exists (select 1 from o where o.cust = c.id) order by id")
        show(mut &s, "select id from c where not exists (select 1 from o where o.cust = c.id) order by id")
        show(mut &s, "select c.id, (select count(*) from o where o.cust = c.id) from c order by c.id")
        show(mut &s, "select name, (select sum(amount) from o where cust = c.id and status = 'paid') as paid from c order by name")
        show(mut &s, "select id from c where (select count(*) from o where o.cust = c.id) >= 1 and city = 'paris' order by id")
        show(mut &s, "select id from c where id in (select cust from o where o.amount > c.id * 3) order by id")
        show(mut &s, "select id from c x where exists (select 1 from c y where y.city = x.city and y.id <> x.id) order by id")
        show(mut &s, "select id from c where exists (select 1 from o where o.cust = c.id and exists (select 1 from c c2 where c2.id = o.cust and c2.city = 'rome'))")
        show(mut &s, "select id from c where exists (select 1 from o where exists (select 1 from c c2 where c2.id = o.cust and o.cust = c.id and c2.city = 'paris')) order by id")
        show(mut &s, "select c.id, o.id from c join o on o.cust = c.id where o.amount = (select max(amount) from o o2 where o2.cust = c.id) order by c.id")
        show(mut &s, "select city, count(*) from c where exists (select 1 from o where o.cust = c.id) group by city order by city")
        show(mut &s, "select city, (select count(*) from o where o.status = 'paid') from c group by city order by city")
        show(mut &s, "select city, count(*) from c group by city having count(*) >= (select count(*) from o where status = 'open') order by city")
        show(mut &s, "select city, count(*) from c group by city having count(*) > (select count(*) from c c2 where c2.city = c.city and c2.id > 3) order by city")
        show(mut &s, "select id from c order by (select count(*) from o where o.cust = c.id) desc, id")
        show(mut &s, "explain analyze select id from c where exists (select 1 from o where o.cust = c.id)")
        show(mut &s, "select o.id from o where (select city from c where c.id = o.cust) = 'paris' order by o.id")
        show(mut &s, "explain analyze select o.id from o where (select city from c where c.id = o.cust) = 'paris'")
        show(mut &s, "select c.id, o.id from c left join o on o.cust = c.id where not exists (select 1 from o o3 where o3.id = o.id and o3.status = 'open') order by c.id, o.id")
        show(mut &s, "select c.id, o.id from c join o on o.cust = c.id and o.amount > (select avg(amount) from o o4 where o4.cust = c.id) order by c.id")
        show(mut &s, "select c.id from c right join o on o.cust = c.id where o.amount < (select max(amount) from o) order by o.id")
        show(mut &s, "select c.id + 0 in (select cust from o where o.status = c.city) from c order by c.id")
        show(mut &s, "select distinct (select count(*) from o where o.cust = c.id) from c order by 1")
        show(mut &s, "select id, (select count(*) from o where o.cust = c.id) from c order by id limit 2")
        show(mut &s, "select id from c where exists (select 1 from o where o.cust = c.id order by amount desc limit 1) order by id")
        show(mut &s, "select (select id from o where o.cust = c.id order by amount desc limit 1) from c order by id")
        show(mut &s, "select id from c where city = (select city from c where id = 1) or exists (select 1 from o where o.cust = c.id and o.status = 'open') order by id")
        show(mut &s, "select a.id, b.id from c a join c b on b.id = (select min(id) from c where id > a.id) order by a.id")
        show(mut &s, "create table h (id int primary key, g int, v int)")
        show(mut &s, "insert into h values (1, 1, 10), (2, 1, null), (3, 2, 20), (4, 3, 30)")
        show(mut &s, "create table k (id int primary key, g int, x int)")
        show(mut &s, "insert into k values (1, 1, 10), (2, 1, 11), (3, 2, 20), (4, 2, null), (5, 4, 1), (6, null, 5)")
        show(mut &s, "select k.id, k.x in (select v from h where h.g = k.g), k.x not in (select v from h where h.g = k.g) from k order by k.id")
        show(mut &s, "explain analyze select k.id from k where k.x not in (select v from h where h.g = k.g)")
        show(mut &s, "select k.id from k where exists (select 1 from h where h.g = k.g) order by 1")
        show(mut &s, "select k.id from k where not exists (select 1 from h where k.g = h.g) order by 1")
        show(mut &s, "select k.id from k where exists (select 1 from h where h.g = k.g and h.v = k.x) order by 1")
        show(mut &s, "explain select k.id from k where exists (select 1 from h where h.g = k.g and h.v = k.x)")
        show(mut &s, "select k.id from k where exists (select 1 from h where h.g = k.g and h.v > 15) order by 1")
        show(mut &s, "select k.id from k where exists (select 1 from h where h.g + 0 = k.g + 0) order by 1")
        show(mut &s, "explain select k.id from k where exists (select 1 from h where h.g + 0 = k.g + 0)")
        show(mut &s, "select k.id from k where exists (select 1 from h join k k2 on k2.x = h.v where k2.g = k.g) order by 1")
        show(mut &s, "explain select k.id from k where exists (select 1 from h join k k2 on k2.x = h.v where k2.g = k.g)")
        show(mut &s, "select k.id from k where k.x + 10 in (select v from h where h.g = k.g + 1) order by 1")
        show(mut &s, "select k.id from k where exists (select 1 from h where h.g = k.g and exists (select 1 from h h2 where h2.id = h.id + 1)) order by 1")
        show(mut &s, "explain select k.id from k where exists (select 1 from h where h.g = k.g and h.v > k.x)")
        show(mut &s, "explain select k.id from k where exists (select 1 from h where h.id = k.g)")
        show(mut &s, "explain select k.id from k where exists (select 1 from h left join c on c.id = h.v and c.id = k.x)")
        show(mut &s, "explain select id from c where id in (select cust from o where status = 'open')")
        show(mut &s, "select id from c where id in (select cust from o where status = $1)")
        show(mut &s, "update c set city = (select status from o where o.cust = c.id order by id limit 1) where id < 3")
        show(mut &s, "select id, city from c order by id")
        show(mut &s, "delete from o where cust not in (select id from c)")
        show(mut &s, "select count(*) from o")
        show(mut &s, "insert into o values ((select max(id) + 1 from o), 5, (select sum(amount) from o), 'sum')")
        show(mut &s, "select * from o where cust = 5")
        show(mut &s, "select id from c where id = (select id from c)")
        show(mut &s, "select (select x from o)")
        show(mut &s, "select id from c where exists (select 1 from o where o.cust = c.nope)")
        show(mut &s, "select id from c where exists (select 1 from o o1 join o o2 on o1.id = o2.id where id = 10)")
        show(mut &s, "select id from c where exists (select 1 from o where id = 10 and cust = c.id)")
        show(mut &s, "create index bad on c (id) where id in (select 1)")
        show(mut &s, "select sum((select count(*) from o where o.cust = c.id)) from c")
        show(mut &s, "select (select count(*) from o where o.cust = c.id) from c group by city")
        return 0
    }).unwrap()
}
