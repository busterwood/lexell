            "select id from t where id < 10 intersect all select id from t where id < 10",
            "select id from t where id < 10 except all select id from t where id < 10",
            "select x from t where id < 200 except all select x from u where id < 100 union all select x from t where id < 5",
            "select x from t where id < 200 except all select x from t where id < 100 except all select x from t where id < 50",
            "select x from t where id < 200 intersect all select x from t where id < 100 intersect all select x from t where id < 150",
            "select x from t intersect all select x from u intersect select x from t where id < 100",
            "select x from t where id < 300 except select x from u where id < 100 intersect all select x from u",
            "select x from t where id < 300 union select x from u where id < 100 except all select x from u where id < 50",
            "select x from t where id < 100 union all select x from u where id < 100 intersect all select x from t where id < 100",
            "(select x from t where id < 100 union all select x from u where id < 100) intersect all select x from t where id < 100",
