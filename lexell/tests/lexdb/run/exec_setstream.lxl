            "with c as (select id from u where id < 20) select id % 5 from c intersect all select id % 3 from c"
        ]
        var same = 0
        for sql in shapes {
            let a = held(mut &s, sql)
            let b = sunk(mut &s, sql)
            if a == b { same += 1 } else { println("DIFFERENT " + sql + "\n  held: " + a + "\n  sink: " + b) }
        }
        println("union all through a sink: " + len(shapes).toStr() + " queries, " + same.toStr() + " the same as held")
        // errors after rows: the first part gives rows, the second fails
        let late = sunk(mut &s, "select id from t where id < 3 union all select id/0 from u where id < 3")
        let early = sunk(mut &s, "select id/0 from t where id < 3 union all select id from u where id < 3")
        println("errors after rows: first part " + early + ", second part " + late)
        // a volatile CTE: one run in the statement, so both parts read the same rows
        let sq = held(mut &s, &"create sequence sq")
        let c1 = sunk(mut &s, "with r as (select random() as x) select x from r except select x from r")
        let c2 = sunk(mut &s, "with r as (select random() as x) select x from r intersect select x from r")
        let r3 = sunk(mut &s, "with r as (select nextval('sq') as x) select x from r union all select x from r")
        let r4 = sunk(mut &s, "with r as (select nextval('sq') as x) select x from r union all select x from r union all select x from r")
        let c3 = strings.split(&r3, " ")
        let c4 = strings.split(&r4, " ")
        println("a CTE once: except " + (if c1 == "" { "none" } else { c1 }) + ", intersect " +
                (if c2 != "" && len(strings.split(&c2, " ")) == 1 { "1 row" } else { "rows: " + c2 }) + ", union all " +
                (if len(c3) == 2 && c3[0] == c3[1] { "the same value twice" } else { r3.clone() }) + ", nested " +
                (if len(c4) == 3 && c4[0] == c4[1] && c4[1] == c4[2] { "the same value thrice" } else { r4.clone() }))
        // ... through a sort and through counted keys: the same value in every part
        let o1 = sunk(mut &s, "with r as (select nextval('sq') as x) select x from r union all select x from r order by x desc")
        let o2 = sunk(mut &s, "with r as (select nextval('sq') as x) select x from r except all select x from r")
        let o3 = sunk(mut &s, "with r as (select nextval('sq') as x) select x from r intersect all select x from r")
        let o4 = sunk(mut &s, "with r as (select random() as x) select x from r intersect all select x from r order by x")
        let o5 = sunk(mut &s, "with r as (select random() as x) select x from r except all select x from r union all select x from r order by x")
        let c5 = strings.split(&o1, " ")
        println("a CTE once, sorted and counted: union all " + (if len(c5) == 2 && c5[0] == c5[1] { "the same value twice" } else { o1.clone() }) +
                ", except all " + (if o2 == "" { "none" } else { o2.clone() }) + ", intersect all " +
                (if o3 != "" && len(strings.split(&o3, " ")) == 1 { "1 row" } else { "rows: " + o3 }) + ", random " +
                (if o4 != "" && len(strings.split(&o4, " ")) == 1 { "1 row" } else { "rows: " + o4 }) + ", " +
                (if o5 != "" && len(strings.split(&o5, " ")) == 1 { "1 row" } else { "rows: " + o5 }))
        // the memory limit: the same statement held and through a sink
        let ms = held(mut &s, &"set max_statement_mem = 16")
        let mems = ["select id, x from t union select id, x from u", "select id, x from t except select id, x from u",
                    "select id, x from t intersect all select id, x from u", "select id, x from t except all select id, x from u",
                    "select id, x from t union all select id, x from u order by x, id",
                    "select id, x from t union all select id, x from u order by x, id limit 1",
                    "select id, x from t union select id, x from u order by x, id limit 3"]
        var msame: []str = []
        var mres: []str = []
        for m in mems {
            let a = held(mut &s, m)
            let b = sunk(mut &s, m)
            append(mut &msame, if a == b { "same" } else { "DIFFERENT" })
            append(mut &mres, a)
        }
        let mr = held(mut &s, &"set max_statement_mem = 0")
        println("memory: " + strings.join(&msame, " ") + " " + strings.join(&mres, " / "))
        return 0
    })
}
