import "strings"
import "../../../cmd/lexdb_base"
import "../../../cmd/lexdb_sql"

fn clause(st: &lexdb_sql.Stmt): str {
    for f in st.from {
        let k = f.sub
        if k >= 0 && k < len(st.subs) && len(st.subs[k].mr) > 0 {
            return f.alias + (if f.lateral { " lateral" } else { "" }) + ": " + lexdb_sql.mrText(&st.subs[k].mr[0])
        }
    }
    return "no mr"
}

fn pg(sql: str): str {
    match lexdb_sql.parse(&sql) {
        Ok(ss) { return clause(&ss[0]) }
        Err(e) { return e.state }
    }
}

fn ora(sql: str): str {
    match lexdb_sql.oraParse(&sql) {
        Ok(ss) { return clause(&ss[0]) }
        Err(e) { return e.state }
    }
}

fn ts(sql: str): str {
    match lexdb_sql.tsqlParser(&sql, lexdb_sql.Dialect{tsql: true, quotedIdent: true}, &[]) {
        Ok(q) {
            var p = q
            match p.statement() {
                Ok(st) { return clause(&st) }
                Err(e) { return e.state }
            }
        }
        Err(e) { return e.state }
    }
}

const V = "select * from t match_recognize (partition by g order by id measures strt.id as s, last(down.id) as b pattern (strt down+ up+) define down as price < prev(price), up as price > prev(price)) m"

fn all3(label: str, body: str) {
    println(label + " pg: " + pg("select * from t match_recognize (" + body + ") m"))
    println(label + " ora: " + ora("select * from t match_recognize (" + body + ") m"))
    println(label + " ts: " + ts("select * from t match_recognize (" + body + ") m"))
}

fn main() {
    println("v pg: " + pg(V))
    println("v ora: " + ora(V))
    println("v ts: " + ts(V))
    all3("all rows", "order by id desc measures count(*) as c all rows per match pattern (a+) define a as true")
    all3("omit", "measures match_number() as m all rows per match omit empty matches pattern (a*) define a as v > 1")
    all3("unmatched", "order by id nulls first all rows per match with unmatched rows pattern (a b?) define a as true")
    all3("show", "measures classifier() as c all rows per match show empty matches pattern (a*) define a as true")
    all3("skip next", "measures 1 as one after match skip to next row pattern (a b) define a as true")
    all3("skip first", "measures 1 as one after match skip to first b pattern (a b+) define a as true")
    all3("skip last", "measures 1 as one after match skip to last a pattern (a b+) define a as true")
    all3("skip var", "measures 1 as one after match skip to b pattern (a b+) define a as true")
    all3("skip past", "measures 1 as one after match skip past last row pattern (a) define a as true")
    all3("quantifiers", "pattern (a* b+ c? d{2} e{2,} f{,3} g{1,2} h*? i+? j?? k{2,3}?) define a as true")
    all3("groups", "pattern ((a | b c)+ (d | e)* ^ f $) define a as true")
    all3("permute", "pattern (permute(a, b c, d+)) define a as true")
    all3("exclusion", "all rows per match pattern (a {- b+ -} c) define a as true")
    all3("subset", "measures s.v as sv pattern (a b) subset s = (a, b), t = (a) define a as true")
    all3("rn", "measures running sum(a.v) as r, final last(a.v, 1) as f, count(a.*) as ca, count(*) as n pattern (a+) define a as true")
    all3("no define", "pattern (a)")
    all3("no pattern", "define a as true")
    all3("measures no alias", "measures a.v pattern (a) define a as true")
    all3("measures keyword alias", "measures a.v one row per match pattern (a) define a as true")
    all3("empty pattern", "pattern () define a as true")
    all3("empty alt", "pattern (a | ) define a as true")
    all3("reserved var", "pattern (select) define a as true")
    all3("bad bound 0", "pattern (a{0}) define a as true")
    all3("bad bound 00", "pattern (a{0,0}) define a as true")
    all3("bad bound 32", "pattern (a{3,2}) define a as true")
    all3("huge bound", "pattern (a{10001}) define a as true")
    all3("define twice", "pattern (a) define a as true, a as false")
    all3("define non-var", "pattern (a) define b as true")
    all3("subset var twice", "pattern (a) subset a = (a) define a as true")
    all3("subset dup", "pattern (a) subset s = (a), s = (a) define a as true")
    all3("subset non-var", "pattern (a) subset s = (b) define a as true")
    all3("qualified partition", "partition by t.g pattern (a) define a as true")
    all3("expr partition", "partition by g + 1 pattern (a) define a as true")
    all3("qualified order", "order by t.id pattern (a) define a as true")
    all3("expr order", "order by id + 1 pattern (a) define a as true")
    all3("order after pattern", "pattern (a) order by id define a as true")
    all3("skip after pattern", "pattern (a) after match skip past last row define a as true")
    all3("unmatched with exclusion", "all rows per match with unmatched rows pattern ({- a -}) define a as true")
    all3("classifier arg", "measures classifier(a) as c pattern (a) define a as true")
    all3("over", "measures sum(a.v) over () as c pattern (a) define a as true")
    all3("deep", "pattern (((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((a))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) define a as true")
    println("alias none pg: " + pg("select * from t match_recognize (pattern (a) define a as true)"))
    println("alias cols pg: " + pg("select * from t x match_recognize (pattern (a) define a as true) as m (c1, c2)"))
    println("input alias ora: " + ora("select * from t x match_recognize (pattern (a) define a as true) m"))
    println("subquery input pg: " + pg("select * from (select 1 as v) s match_recognize (pattern (a) define a as true) m"))
    println("cte input ora: " + ora("with c as (select 1 v from dual) select * from c match_recognize (pattern (a) define a as true) m"))
    println("lateral pg: " + pg("select * from u, lateral (select * from t where t.g = u.g) match_recognize (pattern (a) define a as true) m"))
    println("apply ts: " + ts("select * from u cross apply (select * from t where t.g = u.g) match_recognize (pattern (a) define a as true) m"))
    println("join pg: " + pg("select * from u join t match_recognize (pattern (a) define a as true) m on m.x = u.x"))
    println("not a clause pg: " + pg("select match_recognize from t"))
    println("two pg: " + pg("select * from t match_recognize (pattern (a) define a as true) m match_recognize (pattern (b) define b as true) n"))
    println("quoted pg: " + pg("select * from t match_recognize (pattern (\"A\" b) define \"A\" as true) m"))
    println("char ops ora: " + ora("select * from t match_recognize (pattern (a b $) define a as true) m"))
    println("dollar name ora: " + ora("select * from t match_recognize (pattern (b$ c) define b$ as true) m"))
    println("running not mr pg: " + pg("select running sum(x) from t"))
    println("brace outside pg: " + pg("select {1}"))
}
