// lexdb_exec: the eighth bug slice (design/lexdb-robust.md, "The eighth bug slice"), the PostgreSQL door: SET SESSION CHARACTERISTICS AS
// TRANSACTION READ ONLY | READ WRITE (default_transaction_read_only: the session's later transactions, a block or a statement alone, are
// read-only; SET TRANSACTION READ WRITE overrides it before the first query; an isolation level alone leaves it), SET and RESET
// default_transaction_read_only, and a schema's owner (AUTHORIZATION) in information_schema.schemata. Checked against PostgreSQL 18
// (generated by tests/lexdb/gen_pg.py from bugs8_queries.txt). Each answer: the columns' names and the rows, or the tag, or ERROR and the
// SQLSTATE; each statement runs with lexdb_batch off and on (an "@once" one once, an "@tx" one in a transaction rolled back).
// expect: CREATE TABLE
// expect: INSERT 0 1
// expect: CREATE TABLE
// expect: same: default_transaction_read_only: off
// expect: SET
// expect: same: default_transaction_read_only: on
// expect: same: transaction_read_only: on
// expect: same: n: 1
// expect: same: ERROR 25006
// expect: same: ERROR 25006
// expect: same: ERROR 25006
// expect: same: ERROR 25006
// expect: same: ERROR 25006
// expect: same: ERROR 25006
// expect: INSERT 0 1
// expect: same: n: 1
// expect: same: transaction_read_only: on
// expect: same: ERROR 25006
// expect: same: INSERT 0 1
// expect: same: transaction_read_only: off
// expect: same: transaction_read_only: on
// expect: same: ERROR 25001
// expect: same: INSERT 0 1
// expect: SET
// expect: same: default_transaction_read_only: on
// expect: same: default_transaction_isolation: serializable
// expect: SET
// expect: same: default_transaction_read_only: off
// expect: same: INSERT 0 1
// expect: same: transaction_read_only: off
// expect: SET
// expect: same: default_transaction_read_only: on
// expect: same: n: 1
// expect: same: ERROR 25006
// expect: same: transaction_read_only: on
// expect: RESET
// expect: same: default_transaction_read_only: off
// expect: same: INSERT 0 1
// expect: SET
// expect: same: default_transaction_read_only: on
// expect: same: default_transaction_isolation: serializable
// expect: same: ERROR 25006
// expect: SET
// expect: same: default_transaction_read_only: off
// expect: same: INSERT 0 1
// expect: CREATE ROLE
// expect: CREATE SCHEMA
// expect: same: schema_name|schema_owner: sch8|own8
// expect: same: nspname|o: sch8|own8
// expect: CREATE SCHEMA
// expect: same: schema_name|schema_owner: sch8|own8;sch8b|own8
// expect: DROP SCHEMA
// expect: DROP SCHEMA
// expect: DROP ROLE
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table ro8 (a int primary key, b text)\n@once insert into ro8 values (1, 'x')\n@once create temp table ro8t (a int)\nshow default_transaction_read_only\n@once set session characteristics as transaction read only\nshow default_transaction_read_only\nshow transaction_read_only\nselect count(*) as n from ro8\ninsert into ro8 values (2, 'y')\nupdate ro8 set b = 'z' where a = 1\ndelete from ro8 where a = 1\ncreate table ro8b (a int)\ntruncate ro8\nselect * from ro8 for update\n@once insert into ro8t values (1)\nselect count(*) as n from ro8t\n@tx show transaction_read_only\n@tx insert into ro8 values (3, 'w')\n@tx set transaction read write; insert into ro8 values (3, 'w')\n@tx set transaction read write; show transaction_read_only\n@tx set transaction read only; show transaction_read_only\n@tx select 1; set transaction read write\n@tx insert into ro8t values (2)\n@once set session characteristics as transaction isolation level serializable\nshow default_transaction_read_only\nshow default_transaction_isolation\n@once set session characteristics as transaction read write\nshow default_transaction_read_only\n@tx insert into ro8 values (2, 'y')\n@tx show transaction_read_only\n@once set default_transaction_read_only = on\nshow default_transaction_read_only\nselect count(*) as n from ro8\ninsert into ro8 values (2, 'y')\n@tx show transaction_read_only\n@once reset default_transaction_read_only\nshow default_transaction_read_only\n@tx insert into ro8 values (2, 'y')\n@once set session characteristics as transaction read only, isolation level serializable\nshow default_transaction_read_only\nshow default_transaction_isolation\ninsert into ro8 values (2, 'y')\n@once set session characteristics as transaction read write, isolation level read committed\nshow default_transaction_read_only\n@tx insert into ro8 values (2, 'y')\n@once create role own8\n@once create schema sch8 authorization own8\nselect schema_name, schema_owner from information_schema.schemata where schema_name = 'sch8'\nselect nspname, pg_get_userbyid(nspowner) as o from pg_namespace where nspname = 'sch8'\n@once create schema sch8b authorization own8\nselect schema_name, schema_owner from information_schema.schemata where schema_name like 'sch8%' order by 1\n@once drop schema sch8b\n@once drop schema sch8\n@once drop role own8"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(179), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
