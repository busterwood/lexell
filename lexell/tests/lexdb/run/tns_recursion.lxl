const SETUP = "create table emp (id number(10) primary key, boss number(10), name varchar2(10))\ninsert into emp select 1, null, 'ann' from dual union all select 2, 1, 'bob' from dual union all select 3, 1, 'cid' from dual union all select 4, 2, 'dan' from dual union all select 5, 3, 'eve' from dual union all select 6, 2, 'fay' from dual union all select 7, null, 'gus' from dual union all select 8, 7, 'hal' from dual union all select 9, 4, 'ivy' from dual union all select 10, 9, 'jon' from dual union all select 11, 99, 'kim' from dual union all select 12, null, 'lou' from dual\ncreate table g (a number(10), b number(10))\ninsert into g select 1, 2 from dual union all select 2, 3 from dual union all select 3, 1 from dual union all select 3, 4 from dual union all select null, 1 from dual union all select 4, null from dual union all select 5, 5 from dual\ncreate table dg (i number(10))\ninsert into dg select level - 1 from dual connect by level <= 10\ncreate table big (id number(10) primary key, p number(10))\ninsert into big select n, case when n = 1 then null else trunc(n / 3) end from (select p.i + q.i * 10 + r.i * 100 + s.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg s) z where n <= 3000\ncreate table tgt (id number(10) primary key, lvl number(10))"

const QS = "with r (id, name, lvl) as (select id, name, 0 from emp where boss is null union all select e.id, e.name, r.lvl + 1 from emp e join r on e.boss = r.id) select id, name, lvl from r order by id\nwith r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) select id, lvl from r\nwith r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from r join emp e on e.boss = r.id) select id, lvl from r\nwith r (id, lvl) as (select e.id, r.lvl + 1 from emp e join r on e.boss = r.id union all select id, 0 from emp where boss is null) select id, lvl from r order by lvl, id\nwith r as (select id, 0 lvl from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) select id, lvl from r\nwith r (n) as (select 1 from dual union select n + 1 from r where n < 3) select n from r\nwith r (n) as (select 1 from dual union all select 2 from dual union all select n + 1 from r where n < 3) select n from r\nwith r (n) as (select 1 from dual union all select n + 1 from r where n < 3 union all select n + 10 from r where n < 3) select n from r\nwith r (n) as (select 1 from dual union all select count(*) from r) select n from r\nwith r (n) as (select 1 from dual union all select distinct n + 1 from r where n < 3) select n from r\nwith r (n) as (select 1 from dual union all select n + 1 from r where n < 3 group by n) select n from r\nwith r (n) as (select 1 from dual union all select r.n + 1 from r left join emp on emp.id = r.n where r.n < 3) select n from r\nwith r (n) as (select 1 from dual union all select r.n + 1 from emp left join r on emp.id = r.n where r.n < 3) select n from r\nwith r (n) as (select 1 from dual union all select a.n + 1 from r a join r b on a.n = b.n where a.n < 3) select n from r\nwith r (n) as (select 1 from dual union all select n + 1 from r where n < 3 and n in (select n from r)) select n from r\nwith r (n) as (select 1 from dual union all select n + 1 from (select n from r) d where n < 3) select n from r\nwith r (n, s) as (select 1, 'a' from dual union all select n + 1, s || 'a' from r where n < 3) select n, s from r\nwith r (n, s) as (select 1, 1 from dual union all select n + 1, 'x' from r where n < 3) select n, s from r\nwith r (n) as (select 1 from dual union all select n + 1.5 from r where n < 3) select n from r\nwith r (n, x) as (select 1 from dual union all select n + 1 from r where n < 3) select n from r\nwith r (id, lvl) as (select id, 0 from emp where id > 100 union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) select id, lvl from r\nwith r (id, boss) as (select id, boss from emp where id = 11 union all select e.id, e.boss from emp e join r on e.id = r.boss) select id, boss from r\nwith r (id, boss) as (select id, boss from emp where id = 10 union all select e.id, e.boss from emp e join r on e.id = r.boss) select id, boss from r\nwith r (n) as (select 1 from dual union all select n + 1 from r) select count(*) c from r\nwith r (n) as (select 1 from dual union all select n + 1 from r where 1 = 1) select count(*) c from r\nwith r (n) as (select 1 from dual union all select mod(n, 3) + 1 from r where n > 0) select count(*) c from r\nwith r (n, m) as (select 1, 1 from dual union all select mod(n, 3) + 1, m + 1 from r where m < 50) select count(*) c, max(m) m from r\nwith r (n) as (select 1 from dual union all select n + 1 from r where n < 3000) select count(*) c, max(n) m from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) select count(*) c from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) cycle a set c to 'Y' default 'N' select a, b, c from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) cycle a, b set c to 'Y' default 'N' select a, b, c from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) search depth first by a set o cycle a set c to 1 default 0 select a, b, o, c from r\nwith r (a, b) as (select a, b from g where a is null union all select g.a, g.b from g join r on g.a = r.b) cycle a set c to 'Y' default 'N' select a, b, c from r\nwith r (a, b) as (select a, b from g where b = 1 union all select g.a, g.b from g join r on g.b = r.a) cycle a set c to 'Y' default 'N' select a, b, c from r\nwith r (a, b) as (select a, b from g where a = 5 union all select g.a, g.b from g join r on g.a = r.b) cycle a set c to 'Y' default 'N' select a, b, c from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) cycle a set c to 'YES' default 'N' select a, b, c from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) cycle a set a to 'Y' default 'N' select a, b from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) search depth first by a set a select a, b from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) search depth first by a set o cycle a set o to 'Y' default 'N' select a, b from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) search depth first by x set o select a, b from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) cycle a set c to 'Y' default 'N' select * from r\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) cycle a set c to 'Y' default 'N' select a, b, c from r where c = 'N'\nwith r (a, b) as (select a, b from g where a = 1 union all select g.a, g.b from g join r on g.a = r.b) cycle a set c to 1 default 'N' select a, b, c from r\nwith r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) search depth first by id set o select id, lvl, o from r\nwith r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) search breadth first by id set o select id, lvl, o from r\nwith r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) search depth first by id desc set o select id, lvl, o from r\nwith r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) search depth first by id set o select id, lvl, o from r order by id\nwith r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) search breadth first by lvl desc, id set o select id, o from r\nwith r (a, b) as (select a, b from g where a = 3 union all select g.a, g.b from g join r on g.a = r.b) search depth first by b nulls first set o cycle a set c to 'Y' default 'N' select a, b, o, c from r\nwith r (id, path) as (select id, cast(name as varchar2(100)) from emp where boss is null union all select e.id, r.path || '/' || e.name from emp e join r on e.boss = r.id) select id, path from r order by path\nwith r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) select lvl, count(*) n from r group by lvl order by lvl\nwith r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) select e.name, r.lvl from r join emp e on e.id = r.id where r.lvl >= 2 order by e.name\nwith r (n) as (select 1 from dual union all select n + 1 from r where n < 3) select a.n x, b.n y from r a cross join r b order by 1, 2\nwith r (id, lvl) as (select id, 0 from big where p is null union all select big.id, r.lvl + 1 from big join r on big.p = r.id) select count(*) n, max(lvl) d, sum(id) s from r\nwith r (id, lvl) as (select id, 0 from big where id = 2 union all select big.id, r.lvl + 1 from big join r on big.p = r.id) search depth first by id set o select id, lvl, o from r order by o fetch first 12 rows only\ninsert into tgt with r (id, lvl) as (select id, 0 from emp where boss is null union all select e.id, r.lvl + 1 from emp e join r on e.boss = r.id) select id, lvl from r ;; select count(*) n, sum(lvl) s from tgt\nupdate emp set name = 'x' || name where id in (with r (id) as (select 2 from dual union all select e.id from emp e join r on e.boss = r.id) select id from r) ;; select id, name from emp where name like 'x%' order by id\nselect id, boss, name, level, connect_by_isleaf il, sys_connect_by_path(name, '/') pth, connect_by_root name rt, prior name pn from emp start with boss is null connect by prior id = boss order siblings by id\nselect id, level from emp start with boss is null connect by prior id = boss order siblings by id desc\nselect id, level from emp start with boss is null connect by prior id = boss order siblings by name\nselect a, b, level, connect_by_iscycle ic, connect_by_isleaf il from g start with a = 1 connect by nocycle prior b = a\nselect a, b, level from g start with a = 1 connect by prior b = a\nselect a, b, level, connect_by_iscycle ic, connect_by_isleaf il from g start with a = 3 connect by nocycle prior b = a order siblings by b\nselect id, level from emp where level > 1 start with boss is null connect by prior id = boss order siblings by id\nselect level, count(*) n from emp start with boss is null connect by prior id = boss group by level order by level\nselect id, level from emp start with id = 1 connect by prior id = boss and level <= 2 order siblings by id\nselect level, sys_connect_by_path(id, ',') p from emp start with id = 10 connect by id = prior boss\nselect id, level from emp start with boss is null connect by prior id = boss and prior name <> 'bob' order siblings by id\nselect lpad(' ', 2 * (level - 1)) || name t from emp start with boss is null connect by prior id = boss order siblings by name\nselect * from emp where id < 3 start with id = 1 connect by prior id = boss\nselect id from emp connect by prior id = boss start with id = 2 order siblings by id\nselect count(*) c from emp connect by level <= 2\nselect level l, dummy from dual connect by prior dummy = dummy and level <= 3\nselect level l from dual connect by level <= 5\nselect level l from dual connect by level < 4\nselect count(*) c, sum(level) s from dual connect by level <= 10000\nselect prior id from emp\nselect id from emp order siblings by id\nselect e.id, level from (select id, boss from emp where id <> 3) e start with e.boss is null connect by prior e.id = e.boss order siblings by e.id\nselect id, level, connect_by_root id r from big start with id = 2 connect by prior id = p and level <= 4 order siblings by id fetch first 15 rows only\nselect count(*) n, max(level) d from big start with p is null connect by prior id = p"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(63), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
