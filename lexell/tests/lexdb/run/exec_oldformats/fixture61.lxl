// The fixture of exec_oldformats: a data directory as lexdb wrote it at 61d57286 (front-coded leaves, T_FLEAF). Made by gen.lxl.txt,
// compiled against that commit's sources; the files' non-zero bytes by
// page, in base64. The log holds only what replay reads: the frames from
// the checkpoint's replay position on.

pub type Part = value record { pub at: int; pub b64: str }
pub type File = record { pub name: str; pub size: int; pub parts: []Part }

pub fn files(): []File {
    return [
        File{name: "data.lxdb", size: 53248, parts: [
            Part{at: 4096, b64: ""}
        ]},
        File{name: "log.1", size: 65536, parts: [

        ]},
        File{name: "log.2", size: 65536, parts: [
            Part{at: 0, b64: ""}
        ]}
    ]
}
