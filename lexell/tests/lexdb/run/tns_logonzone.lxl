// lexdb over TNS: the time zone a client sends at logon (AUTH_ALTER_SESSION, design/lexdb-robust.md, "The third bug slice"),
// as lexdb_oraadm.zoneSet reads it from the statement: python-oracledb's (its local offset, or ORA_SDTZ), JDBC's (the JVM's
// zone, a region), lib/oracle's '+00:00' (which sets nothing: lexdb_tns.logonZone), a statement without one. The session then
// starts in it and ALTER SESSION SET TIME_ZONE = LOCAL goes back to it, as Oracle's (checked by hand with python-oracledb 26.1
// and ojdbc11 23.26 against Oracle Free 23.26: SESSIONTIMEZONE and CURRENT_TIMESTAMP's offset; lib/oracle always sends +00:00).
// expect: python: '+05:30'
// expect: ORA_SDTZ: 'Europe/Berlin'
// expect: JDBC: 'Asia/Kolkata'
// expect: bare: '-05:00'
// expect: lib/oracle: '+00:00'
// expect: none: ''
// expect: empty: ''
// expect: no value: ''
import "../../../cmd/lexdb_oraadm"

fn say(label: &str, sql: &str) { println(label + ": '" + lexdb_oraadm.zoneSet(sql) + "'") }

fn main() {
    say("python", "ALTER SESSION SET TIME_ZONE='+05:30'\x00")
    say("ORA_SDTZ", "ALTER SESSION SET TIME_ZONE='Europe/Berlin'\x00")
    say("JDBC", "ALTER SESSION SET NLS_LANGUAGE='AMERICAN' NLS_TERRITORY='AMERICA' TIME_ZONE='Asia/Kolkata'")
    say("bare", "alter session set time_zone = -05:00")
    say("lib/oracle", "ALTER SESSION SET TIME_ZONE='+00:00'\x00")
    say("none", "ALTER SESSION SET NLS_DATE_FORMAT='YYYY-MM-DD'")
    say("empty", "")
    say("no value", "ALTER SESSION SET TIME_ZONE =")
}
