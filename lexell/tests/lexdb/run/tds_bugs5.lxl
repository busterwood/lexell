import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once CREATE TABLE d1 (a int, b int, c int); INSERT INTO d1 VALUES (1, 2, 3), (4, NULL, 6)\n@once CREATE VIEW d1a AS SELECT a FROM d1\n@once CREATE VIEW d1b AS SELECT a, b FROM d1\n@once CREATE VIEW d1s AS SELECT * FROM d1\n@once CREATE VIEW d1vb AS SELECT a FROM d1b\n@once CREATE VIEW d1cnt AS SELECT COUNT(*) AS n FROM d1\n@once CREATE VIEW d1sb WITH SCHEMABINDING AS SELECT a, c FROM dbo.d1\n@once CREATE VIEW d1sx WITH SCHEMABINDING, VIEW_METADATA AS SELECT a + c AS x FROM dbo.d1 WHERE c > 0\n@once CREATE VIEW d1e WITH ENCRYPTION AS SELECT a FROM d1\nCREATE VIEW d1bad WITH bogus AS SELECT a FROM d1\nCREATE VIEW d1st WITH SCHEMABINDING AS SELECT * FROM dbo.d1\nSELECT OBJECT_NAME(object_id) AS n, is_schema_bound FROM sys.sql_modules WHERE OBJECT_NAME(object_id) LIKE 'd1%' ORDER BY n\nALTER TABLE d1 DROP COLUMN c\nSELECT * FROM d1sx ORDER BY x\n@once ALTER TABLE d1 DROP COLUMN b\nSELECT a FROM d1a ORDER BY a\nSELECT n FROM d1cnt\nSELECT * FROM d1b\nSELECT * FROM d1s\nSELECT * FROM d1vb\nSELECT * FROM d1 ORDER BY a\nALTER TABLE d1 DROP COLUMN a\n@once DROP VIEW d1sb\nALTER TABLE d1 DROP COLUMN c\n@once DROP VIEW d1sx\n@once ALTER TABLE d1 DROP COLUMN c\nSELECT * FROM d1 ORDER BY a\nSELECT * FROM d1a ORDER BY a\n@once CREATE TABLE i1 (id int, v int, INDEX ix1 (id))\n@once CREATE TABLE i2 (id int PRIMARY KEY, a int, b int, INDEX ix2 CLUSTERED (a, b))\n@once CREATE TABLE i3 (id int PRIMARY KEY, a int, b int, INDEX ix3 NONCLUSTERED (a DESC, b))\n@once CREATE TABLE i4 (id int INDEX ix4, v int)\n@once CREATE TABLE i5 (id int PRIMARY KEY, a int, INDEX ix5 UNIQUE (a))\n@once CREATE TABLE i6 (id int PRIMARY KEY, a int, b int, INDEX ix6 UNIQUE NONCLUSTERED (a) INCLUDE (b) WHERE a > 0)\n@once CREATE TABLE i8 (id int PRIMARY KEY, a int INDEX ix8 NONCLUSTERED, b int INDEX ix8b UNIQUE)\nSELECT t.name AS t, i.name AS i, i.is_unique FROM sys.indexes i JOIN sys.tables t ON t.object_id = i.object_id WHERE t.name LIKE 'i_' AND i.name LIKE 'ix%' ORDER BY t.name, i.name\nINSERT INTO i5 VALUES (1, 1), (2, 1)\nBEGIN TRAN; INSERT INTO i6 VALUES (1, 0, 0), (2, 0, 0), (3, 1, 0); SELECT COUNT(*) AS n FROM i6; ROLLBACK\nINSERT INTO i6 VALUES (1, 1, 0), (2, 1, 0)\nINSERT INTO i8 VALUES (1, 1, 1), (2, 1, 1)\nCREATE TABLE i9 (id int, INDEX ix9 (nosuch))\nSELECT COUNT(*) AS n FROM sys.tables WHERE name = 'i9'\n@once CREATE TABLE tp (id int PRIMARY KEY, v int); INSERT INTO tp SELECT value, value FROM generate_series(1, 10)\n@once CREATE TABLE tq (id int, v int)\nBEGIN TRAN; DELETE TOP (3) FROM tp; SELECT COUNT(*) AS n FROM tp; ROLLBACK\nBEGIN TRAN; DELETE TOP (50) PERCENT FROM tp; SELECT COUNT(*) AS n FROM tp; ROLLBACK\nBEGIN TRAN; DELETE TOP (33) PERCENT FROM tp WHERE id > 3; SELECT COUNT(*) AS n FROM tp; ROLLBACK\nBEGIN TRAN; DELETE TOP (1) PERCENT tp; SELECT COUNT(*) AS n FROM tp; ROLLBACK\nBEGIN TRAN; DELETE TOP (0) PERCENT FROM tp; SELECT COUNT(*) AS n FROM tp; ROLLBACK\nDELETE TOP (101) PERCENT FROM tp\nBEGIN TRAN; UPDATE TOP (2) tp SET v = -1; SELECT COUNT(*) AS n FROM tp WHERE v = -1; ROLLBACK\nBEGIN TRAN; UPDATE TOP (25) PERCENT tp SET v = -1 WHERE id <= 9; SELECT COUNT(*) AS n FROM tp WHERE v = -1; ROLLBACK\nBEGIN TRAN; INSERT TOP (4) INTO tq SELECT id, v FROM tp; SELECT COUNT(*) AS n FROM tq; ROLLBACK\nBEGIN TRAN; INSERT TOP (25) PERCENT INTO tq SELECT id, v FROM tp; SELECT COUNT(*) AS n FROM tq; ROLLBACK\nBEGIN TRAN; INSERT TOP (25) PERCENT tq (id, v) SELECT id, v FROM tp WHERE id > 100; SELECT COUNT(*) AS n FROM tq; ROLLBACK\nBEGIN TRAN; INSERT TOP (2) INTO tq SELECT TOP (5) id, v FROM tp ORDER BY id; SELECT COUNT(*) AS n FROM tq; ROLLBACK\nBEGIN TRAN; INSERT TOP (2) INTO tq SELECT 1, 1 UNION ALL SELECT 2, 2 UNION ALL SELECT 3, 3; SELECT COUNT(*) AS n FROM tq; ROLLBACK\nBEGIN TRAN; INSERT TOP (1) INTO tq VALUES (1, 1), (2, 2); SELECT COUNT(*) AS n FROM tq; ROLLBACK\nBEGIN TRAN; INSERT TOP (50) PERCENT INTO tq VALUES (1, 1), (2, 2), (3, 3); SELECT COUNT(*) AS n FROM tq; ROLLBACK\nBEGIN TRAN; INSERT INTO tq SELECT TOP (50) PERCENT id, v FROM tp; SELECT COUNT(*) AS n FROM tq; ROLLBACK\nBEGIN TRAN; INSERT TOP (2) INTO tq (id) OUTPUT inserted.v SELECT id FROM tp; ROLLBACK\nINSERT TOP (101) PERCENT INTO tq SELECT id, v FROM tp"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(77), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
