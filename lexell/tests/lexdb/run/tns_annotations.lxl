const SETUP = "create table an1 (id number not null annotations (Display 'Id', Hidden), v varchar2(10) annotations (Mask 'x'), w number) annotations (A1 'x', A1 'y', \"Mixed\" 'm', Flag)\ncreate index an1_ix on an1 (v) annotations (IxNote 'idx')\ncreate view anv1 annotations (VNote 'view') as select id, v from an1\ncreate view anv2 (a annotations (ColV 'c'), b) annotations (VNote2) as select id, v from an1\ncreate table an2 (id number primary key annotations (Display 'Id'), v number default 1 annotations (d 'x'), x number null annotations (n))\ncreate table an3 (id number annotations (key 'k', value 'v', annotations 'a', \"select\" 's', name 'n', type 't', constraint 'c', primary 'p', if 'f', ignore 'g', true 't', when 'w', end 'e'))\ncreate table an4 (id number) annotations (add a 'x', add if not exists b 'y', a 'z')\ncreate table an5 (id number annotations (a 'x')) annotations (add if not exists a 'y', add if not exists a 'z')\ncreate table an6 (id number annotations (a 'it''s'), v number annotations (b 'x', c))\ncreate table an7 (id number annotations (a, a 'x', \"A\" 'y', \"a\" 'z')) annotations (t1) annotations (t2 'v')\ncreate table an8 (id number primary key, v number annotations (m 'x'), w number)\nalter table an8 annotations (add a 'x')\nalter table an8 annotations (add a 'y')\nalter table an8 annotations (add if not exists a 'z')\nalter table an8 annotations (b 'b')\nalter table an8 annotations (replace a 'r')\nalter table an8 annotations (drop if exists zz, add c 'c')\nalter table an8 modify (v annotations (add n 'n'))\nalter table an8 modify (v annotations (replace m 'mm'))\nalter table an8 modify (w annotations (add o))\nalter table an8 modify v annotations (add p 'p')\nalter table an8 modify (v annotations (add q 'q'), w annotations (add r 'r'))\nalter table an8 modify (v number annotations (add s 's'))\nalter table an8 annotations (add c2 'x') modify (v annotations (add d))\nalter table an8 modify (w annotations (add e)) annotations (add c3)\nalter table an8 add (z number annotations (az 'z'))\nalter table an8 add z2 number annotations (az2)\nalter table an8 add (z3 number) annotations (add az3)\ncreate table an9 (id number annotations (a 'x', a 'y', a, b 'x', b 'y', c 'x', c)) annotations (t 'x', t 'y', u)\nalter table an9 modify (id annotations (drop a))\nalter table an9 annotations (drop t)\nalter table an9 modify (id annotations (drop c 'x'))\nalter table an9 modify (id annotations (replace b 'z'))\nalter table an9 annotations (add u 'uu')\nalter table an9 annotations (add u2 'a', add u2 'b')\nalter table an9 annotations (drop u2 'a')\ncreate table an10 (id number primary key, v number annotations (m 'x'), w number annotations (k))\ncreate index an10_ix on an10 (w) annotations (i1 'x')\nalter index an10_ix annotations (add i2 'y')\nalter index an10_ix annotations (replace i1 'z')\ncreate view an10v as select id, v from an10\nalter view an10v annotations (add v1 'x')\nalter view an10v modify (v annotations (add v2 'y'))\nalter table an10 rename column v to vv\nalter index an10_ix rename to an10_ix2\nalter table an10 rename to an11\ncreate table an12 (id number primary key, v number annotations (gone 'x'), w number) annotations (tbl)\ncreate index an12_ix on an12 (w) annotations (igone)\nalter table an12 drop column v\ndrop index an12_ix\ncreate table an13 (id number annotations (dropme)) annotations (dropme2)\ndrop table an13 purge\ncreate or replace view anv3 annotations (o1 'x') as select id from an1\ncreate or replace view anv3 annotations (o2 'y') as select id from an1\ncreate or replace view anv4 annotations (p1) as select id from an1\ncreate or replace view anv4 as select id from an1\ncreate table an14 annotations (ct1 'x') as select 1 id from dual\ncreate table an15 (id) annotations (ct2) as select 1 id from dual\ncreate table an16 (id number primary key, v number, w number)\ninsert into an16 values (1, 1, 1)\ncreate table an17 (id number annotations (q 'v', \"q\" 'v', z1 'one', z2 'one'))"

const QS = "select * from user_annotations_usage order by object_type, object_name, column_name nulls first, annotation_name, annotation_value\nselect object_name, object_type, column_name, annotation_owner, annotation_name, annotation_value from all_annotations_usage where annotation_owner = 'APP' order by 2, 1, 3 nulls first, 5, 6\nselect * from user_annotations order by 1\nselect * from all_annotations where annotation_owner = 'APP' order by 2\nselect * from user_annotation_values order by 1, 2\nselect * from all_annotation_values where annotation_owner = 'APP' order by 2, 3\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN8' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN9' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN11' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN10_IX2' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN10V' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN12' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN13' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'ANV3' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'ANV4' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN14' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN15' order by 3 nulls first, 4, 5\nselect annotation_name, annotation_value from user_annotations_usage where object_name = 'AN7' order by 1, 2\nselect count(*) n from user_annotations_usage where object_type = 'INDEX'\nselect count(*) n from user_annotations_usage where annotation_value is null\nselect annotation_name, count(*) n from user_annotation_values group by annotation_name having count(*) > 1 order by 1\ncreate table ae1 (id number annotations (Display 'Id') not null)\ncreate table ae1 (id number annotations (Display 'Id') primary key)\ncreate table ae1 (id number annotations (a 'x') default 1)\ncreate table ae1 (id number annotations (a 'x') annotations (b))\ncreate table ae1 (id number not null annotations (a 'x') check (id > 0))\ncreate table ae1 (id number primary key annotations (a 'x') not null)\ncreate table ae1 (id number annotations (a 'x') xyz)\ncreate table ae1 (id number annotations (Display ''))\ncreate table ae1 (id number annotations (Display null))\ncreate table ae1 (id number annotations (long 'x'))\ncreate table ae1 (id number annotations (select 'x'))\ncreate table ae1 (id number annotations (number 'x'))\ncreate table ae1 (id number annotations (table 'x'))\ncreate table ae1 (id number annotations (check 'x'))\ncreate table ae1 (id number annotations (default 'x'))\ncreate table ae1 (id number annotations ())\ncreate table ae1 (id number annotations (a 1))\ncreate table ae1 (id number annotations (a 'x' 'y'))\ncreate table ae1 (id number) annotations (drop a)\ncreate table ae1 (id number) annotations (a 'x', drop b)\ncreate table ae1 (id number annotations (replace a 'x'))\ncreate table ae1 (id number annotations (drop if exists a))\ncreate table ae1 (id number annotations (\"\" 'x'))\ncreate table ae1 (id number annotations (a.b 'x'))\ncreate table ae1 (id number annotations (a 'x',))\ncreate table ae1 (id number annotations a 'x')\ncreate table ae1 (id number annotations (1a 'x'))\ncreate table ae1 (id number annotations (add))\ncreate table ae1 (id number annotations (a 'x', a 'x'))\ncreate table ae1 (id number annotations (a, a))\ncreate table ae1 (id number) annotations (ta 'x', ta 'x')\ncreate table ae1 (id number annotations ( 'x'))\ncreate table ae1 (id number annotations (a ''))\ncreate view aev annotations (drop a) as select 1 x from dual\ncreate index aeix on an1 (w) annotations (replace a)\ncreate index aeix on an1 (w) annotations (a, a)\nalter table an8 annotations (drop nosuch)\nalter table an8 annotations (drop a 'nosuch')\nalter table an8 annotations (replace zz 'q')\nalter table an8 annotations (replace zz)\nalter table an8 annotations (drop ignore)\nalter table an8 annotations (add d 'd', drop d)\nalter table an8 annotations (add e 'e', drop nosuch)\nalter table an8 annotations (add b 'b')\nalter table an8 annotations (add a 'r', drop nosuch)\nalter table an8 modify (v annotations (add n 'n'))\nalter table an8 modify (v annotations (add d))\nalter table an8 modify (nosuch annotations (add o))\nalter table an8 modify (v annotations (drop nosuch))\nalter table an8 modify (v annotations (replace nosuch 'w'))\nalter table an8 modify (v annotations (add x1), id annotations (drop nosuch))\nalter table an8 modify (v annotations (add x2), nosuch annotations (add e))\nalter table an8 annotations (add if exists x)\nalter table an8 annotations (drop if not exists x)\nalter table an8 annotations (add a 'x', replace a 'y')\nalter table an8 annotations (replace q 'y', replace q 'z')\nalter table an8 annotations (drop if exists q, drop if exists q)\nalter table an8 annotations (drop b, drop b)\nalter table an8 annotations (add a2 'v', add if not exists a2 'v')\nalter table an8 annotations (add a3 'x', add a3 'x', drop a3)\nalter table an8 annotations (drop a3, add a3 'x', add a3 'x')\nalter table an8 annotations (drop nosuch, add b3 'x', add b3 'x')\nalter table an8 annotations (drop a, drop nosuch)\nalter table nosuch annotations (add a 'x')\nalter table an8 annotations ()\nalter table an8 annotations (add c '')\nalter table an8 annotations (add c 'x' d)\nalter table an8 annotations (add c 'x'\nalter table an8 annotations add a\nalter table an8 annotations\nalter table an8 annotations (add)\nalter table an8 annotations (drop)\nalter table an8 annotations (drop if exists)\nalter table an8 annotations (drop 'x')\nalter table an8 annotations (drop long)\nalter index an10_ix2 annotations (drop nosuch)\nalter index an10_ix2 annotations (add i2 'y')\nalter view an10v annotations (drop nosuch)\nalter view an10v modify (id annotations (drop nosuch))\nalter view an10v modify (nosuch annotations (add a))\nalter view nosuchv annotations (add a)\nalter table an8 annotations (add if not exists a 'zz')\nalter table an8 annotations (drop if exists nosuch)\nalter table an8 annotations (drop if exists a 'nosuch')\nalter table an8 annotations (replace b 'b')\nalter table an8 modify (w annotations (replace o))\nalter index an10_ix2 annotations (replace i2 'y')\nalter view an10v annotations (replace v1 'x')\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN8' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN10_IX2' order by 3 nulls first, 4, 5\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN10V' order by 3 nulls first, 4, 5\nupdate an16 set v = 5 where id = 1 ;; alter table an16 annotations (add if not exists cm 'x') ;; select v from an16\nselect v from an16\nupdate an16 set w = 7 where id = 1 ;; alter table an16 annotations (drop nosuch) ;; select w from an16\nselect w from an16\nselect object_type, object_name, column_name, annotation_name, annotation_value from user_annotations_usage where object_name = 'AN16' order by 3 nulls first, 4, 5"
fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(62), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
