// lexdb_exec and lexdb_pipe: a SELECT of one table, its rows filtered and
// its outputs made, run by the pipeline (design/lexdb-layers.md 6.2.3,
// slice P1a), against the engines it replaces. Random queries over a
// table of 2,600 rows (three batches, the last part full) with integers,
// booleans, numerics, texts, dates and NULLs, an index and its covering
// read, run by the row engine (SET lexdb_batch = off, the reference) and
// by the pipeline, each with the rows held and given to a sink (an
// OutBatch where a chunk made them). They must agree, errors included,
// and the rows a sink was given before an error:
// - every path: a scan, a primary key range, its point, IN lists, read
//   backward, an index range, the index read alone, a LIMIT on each;
// - outputs and conditions of every type, with NULLs, and errors under
//   vector evaluation: a division by zero on one row of a batch, past a
//   LIMIT or before it, under AND and CASE (short-circuits: never
//   evaluated where the row engine does not), a text not a number, an
//   integer's overflow (the held rows' path no longer reads a row under
//   LIMIT 0, as the sinks and PostgreSQL do not);
// - parameters, the plan kept and run again with others;
// - max_statement_mem: the rows held past it, the same error;
// - EXPLAIN ANALYZE's counts the same in the pipeline and the row engine
//   (but for the batches); its EXPLAIN the same.
// (Slices P1a and P1b compared the batch drivers too, with the pipeline
// switched off; slice P1c deleted the one-table drivers and the switch.)
// Aggregates over the table (slice P1b), the same ways: the plain
// aggregate and GROUP BY one or more keys (integers, booleans, texts,
// numerics, dates, expressions, NULL keys), count, sum, avg, min and max
// of every type, FILTER, numerics' scales, HAVING, DISTINCT over the
// groups, ORDER BY and LIMIT; empty input; an integer's overflow and a
// division by zero in a call; shapes the batches do not run (a float's
// sum, a text function's key: the pipeline's rows) and shapes the
// pipeline does not take (DISTINCT and ORDER BY in a call, string_agg,
// grouping sets: the row engine); parameters; max_statement_mem.
// Subqueries run once (slice P1c), their values given to the pipeline's
// run: scalar, EXISTS and IN subqueries in WHERE, in the select list and
// in an aggregate's conditions, keys and calls; a scalar's NULL and an
// empty set, a set with a NULL, IN of numbers, texts and dates; a scalar
// of more than one row (21000); a subquery in the path (a primary key's
// point, a lookup per value of an IN); parameters in the subqueries, the
// plan kept and run again; EXPLAIN ANALYZE's lines (the subqueries' runs
// included) the same.
// Joins (slice P2), the same ways: inner and LEFT joins of f with d (a
// hash, or a lookup per row by its primary key), g (duplicate and NULL
// keys, a text key), h (a range per row of its key's first column, or a
// lookup by both), e (empty), three tables, expression keys and two
// keys; rows and aggregates over them; NULL keys, empty build and probe
// sides, a LEFT JOIN's WHERE after it; errors in a join's condition, an
// output or a call, before and past a LIMIT (a chunk with an error is
// joined again row by row, as the row engine); in a transaction with
// its own writes; parameters; max_statement_mem; EXPLAIN ANALYZE's
// counts. Semi and anti joins (slice P2b): EXISTS, NOT EXISTS, IN and NOT
// IN (NULLs in the set, an empty set) by a hash of the subquery's rows, a
// range per row with a filter, a summary of "inner <> outer"; RIGHT
// joins (the rows that joined nothing after the scan).
// timeout: 120
// expect: committed: 500 queries, 500 the same both ways
// expect: in a transaction: 120 queries, 120 the same both ways
// expect: fixed: 30 queries, 30 the same both ways
// expect: the pipeline ran: true, read batches: true, errors: true
// expect: parameters: 12 of 12 the same
// expect: memory: ERROR 53200 | ERROR 53200 | ERROR 53200; under it: true
// expect: counts: 24 of 24 the same
// expect: aggregates: 400 queries, 400 the same both ways
// expect: aggregates in a transaction: 80 queries, 80 the same both ways
// expect: aggregates fixed: 26 queries, 26 the same both ways
// expect: aggregates ran in the pipeline: true, over batches: true, row by row: true
// expect: aggregate parameters: 12 of 12 the same
// expect: aggregate memory: ERROR 53200 | ERROR 53200 | ERROR 53200; under it: true
// expect: aggregate counts: 12 of 12 the same
// expect: subqueries: 300 queries, 300 the same both ways
// expect: subqueries fixed: 34 queries, 34 the same both ways
// expect: subqueries ran in the pipeline: true
// expect: subquery parameters: 12 of 12 the same
// expect: subquery counts: 10 of 10 the same
// expect: joins: 400 queries, 400 the same both ways
// expect: joins in a transaction: 100 queries, 100 the same both ways
// expect: joins fixed: 26 queries, 26 the same both ways
// expect: joins ran in the pipeline: true, hashes built: true, rows dropped by the first hash's keys: true, ranges per row: true
// expect: join parameters: 12 of 12 the same
// expect: join memory: ERROR 53200 | ERROR 53200; under it: true
// expect: join counts: 10 of 10 the same
// expect: semi and anti joins: 300 queries, 300 the same both ways
// expect: semi, anti and right fixed: 12 queries, 12 the same both ways
// expect: semi, anti and right counts: 6 of 6 the same
import "strings"
import "../../../cmd/lexdb_base"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_sql"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_rows"
import "../../../cmd/lexdb_bind"
import "../../../cmd/lexdb_parse"
import "../../../cmd/lexdb_pipe"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            var out: []str = []
            for r in rs {
                if !r.hasRows { append(mut &out, r.tag.clone()) }
                for row in r.rows {
                    var vs: []str = []
                    for v in row { append(mut &vs, lexdb_sql.text(&v)) }
                    append(mut &out, strings.join(&vs, "|"))
                }
            }
            return strings.join(&out, " ")
        }
        Err(e) { return "ERROR " + e.state + " " + e.msg }
    }
}

// An OutBatch's row j as text.
fn obText(ob: &lexdb_rows.OutBatch, j: int): str {
    var vs: []str = []
    for o in 0..len(ob.kinds) {
        let c = ob.src[o]
        let k = ob.kinds[o]
        var v = lexdb_sql.Val.Null
        if c < 0 {
            if !ob.ex[o].nul[j] { v = if k == lexdb_exec.BK_BOOL { lexdb_sql.Val.Bool(ob.ex[o].v[j] == 1) } else { lexdb_sql.Val.Int(ob.ex[o].v[j]) } }
        } else {
            let at = ob.idx[j]
            if !ob.cols[c].nul[at] {
                v = if k == lexdb_exec.BK_INT { lexdb_sql.Val.Int(ob.cols[c].v[at]) } else if k == lexdb_exec.BK_BOOL { lexdb_sql.Val.Bool(ob.cols[c].v[at] == 1) } else { ob.vals[c][at].clone() }
            }
        }
        append(mut &vs, lexdb_sql.text(&v))
    }
    return strings.join(&vs, "|")
}

// sql's rows through runRows' sink (with params, the plan cache pc), as q
// gives them, the rows given before an error too; batched: whether some
// came as an OutBatch.
fn viaSink(s: mut &lexdb_exec.Session, sql: &str, params: &[]lexdb_sql.Val, pc: mut &lexdb_exec.PlanCache, batched: mut &bool): str {
    let stmts = match lexdb_parse.parse(sql) {
        Ok(x) { x }
        Err(e) { return "ERROR " + e.state + " " + e.msg }
    }
    let nt: []int = []
    var lines: []str = []
    var nb = 0
    let r = s.runRows(&stmts[0], params, &nt, pc, fn(cols: &[]lexdb_bind.OutCol, row: &[]lexdb_sql.Val, ob: &lexdb_rows.OutBatch, start: bool): bool {
        if start { return true }
        if ob.n > 0 {
            nb += 1
            for j in 0..ob.n { append(mut &lines, obText(ob, j)) }
            return true
        }
        var vs: []str = []
        for v in row { append(mut &vs, lexdb_sql.text(&v)) }
        append(mut &lines, strings.join(&vs, "|"))
        return true
    })
    batched = nb > 0
    match r {
        Ok(res) {
            for row in res.rows {
                var vs: []str = []
                for v in row { append(mut &vs, lexdb_sql.text(&v)) }
                append(mut &lines, strings.join(&vs, "|"))
            }
            return strings.join(&lines, " ")
        }
        Err(e) {
            // the rows given before it: those the row engine gives too
            return strings.join(&lines, " ") + " ERROR " + e.state + " " + e.msg
        }
    }
}

// sql's held rows (q) and its sink's (viaSink) in the row engine, then in
// the pipeline: the same.
var sunkErrors: int = 0

fn both(s: mut &lexdb_exec.Session, sql: &str): bool {
    let a = q(s, &"set lexdb_batch = off")
    let off = q(s, sql)
    var pc0 = lexdb_exec.oneShot()
    let none: []lexdb_sql.Val = []
    var ob0 = false
    let sunk0 = viaSink(s, sql, &none, mut &pc0, mut &ob0)
    let b = q(s, &"set lexdb_batch = on")
    let held = q(s, sql)
    var pc = lexdb_exec.oneShot()
    var ob = false
    let sunk = viaSink(s, sql, &none, mut &pc, mut &ob)
    if strings.contains(&sunk, "ERROR") { sunkErrors += 1 }
    // LIMIT 0: the pipeline reads nothing, as the sinks did before and as
    // PostgreSQL's Limit; the held rows' path read a first row, and gave
    // its error (design/lexdb-layers.md 6.2.6)
    if strings.endsWith(sql, &" limit 0") {
        if held == "" && sunk == "" && sunk0 == "" { return true }
    }
    // a sink's rows before an error are the row engine's sink's
    if off == held && sunk == sunk0 && (strings.contains(&sunk, "ERROR") || sunk == held) { return true }
    println("DIFFERENT: " + sql)
    println("  rows:     " + off)
    println("  pipeline: " + held)
    println("  sink (rows):     " + sunk0)
    println("  sink (pipeline): " + sunk)
    return false
}

fn pick(r: mut &lexdb_base.Rng, xs: &[]str): str { return xs[r.below(len(xs))].clone() }

fn maybe(r: mut &lexdb_base.Rng, v: str): str { return if r.below(10) == 0 { "null" } else { v } }

fn day(r: mut &lexdb_base.Rng): str {
    let d = 1 + r.below(28)
    return if d < 10 { "0" + d.toStr() } else { d.toStr() }
}

fn opts(): lexdb_store.Options {
    return lexdb_store.Options{cacheBytes: 1024 * 1024, segBytes: 4 * 1024 * 1024, ckptBytes: 2 * 1024 * 1024, snapNodes: 100000}
}

fn cond(r: mut &lexdb_base.Rng, safe: bool): str {
    let c = r.below(16)
    if c == 0 { return "x > " + (r.below(240) - 20).toStr() }
    if c == 1 { return "z <> " + r.below(5).toStr() }
    if c == 2 { return "tx like 'L1%'" }
    if c == 3 { return "bo" }
    if c == 4 { return if safe { "y is not null" } else { "x / (z - 3) > 0" } }
    if c == 5 { return "nu > " + r.below(30).toStr() + ".5" }
    if c == 6 { return "dt >= '2024-01-" + day(r) + "'" }
    if c == 7 { return "x between " + r.below(100).toStr() + " and " + (100 + r.below(100)).toStr() }
    if c == 8 { return "z in (1, 3)" }
    if c == 9 { return "tx is null" }
    if c == 10 { return "upper(tx) = 'L" + r.below(80).toStr() + "'" }
    // short-circuits: the division only where the row engine reaches it
    if c == 11 { return "z <> 3 and x / (z - 3) >= 0" }
    if c == 12 { return "case when z = 2 then false else x / (z - 2) > 1 end" }
    if c == 13 { return if safe { "coalesce(x, 0) > 5" } else { "x + y > 0" } }
    if c == 14 { return "not (bo and x > 50)" }
    return if safe { "w like 'w1%'" } else { "cast(tx as int) > 0" }
}

// The path a condition gives: a primary key range or point, IN lists, the
// index on x (with x alone in the output: read alone), or none.
fn path(r: mut &lexdb_base.Rng): str {
    let c = r.below(9)
    if c == 0 { return "id between " + r.below(2600).toStr() + " and " + r.below(2600).toStr() }
    if c == 1 { return "id = " + r.below(2700).toStr() }
    if c == 2 { return "id in (" + r.below(2600).toStr() + ", " + r.below(2600).toStr() + ", 7)" }
    if c == 3 { return "x = " + r.below(200).toStr() }
    if c == 4 { return "x between " + r.below(200).toStr() + " and " + r.below(200).toStr() }
    if c == 5 { return "id > " + r.below(2700).toStr() }
    return ""
}

fn query(r: mut &lexdb_base.Rng, safe: bool): str {
    let cols = ["id", "x", "y", "z", "bo", "tx", "nu", "dt", "w", "x + z", "x > 100", "x * 2 - z", "-y", "nu * 2", "nu + x",
                "upper(tx)", "tx || '!'", "length(w)", "dt + 1", "case when z = 0 then 'zero' else tx end", "coalesce(x, -1)",
                "x is null", "abs(x - 100)", "round(nu)", "cast(x as text)", "substr(tx, 2)", "z = 1 or bo"]
    let unsafe = ["x / (z - 3)", "y * 1000000000", "cast(tx as int)", "100 / x", "case when z <> 1 then x / (z - 1) end"]
    var items: []str = []
    if r.below(6) == 0 {
        // the index read alone
        append(mut &items, "x")
    } else {
        for i in 0..(1 + r.below(4)) { append(mut &items, pick(r, &cols)) }
        if !safe && r.below(3) == 0 { append(mut &items, pick(r, &unsafe)) }
    }
    var conds: []str = []
    let p = path(r)
    if p != "" { append(mut &conds, p) }
    for i in 0..r.below(3) { append(mut &conds, cond(r, safe)) }
    var sql = "select " + strings.join(&items, ", ") + " from f"
    if len(conds) > 0 { sql = sql + " where " + strings.join(&conds, " and ") }
    let o = r.below(8)
    if o == 0 { sql = sql + " order by id" }
    if o == 1 { sql = sql + " order by id desc" }
    let l = r.below(4)
    if l == 0 { sql = sql + " limit " + pick(r, &["0", "1", "5", "300", "1100"]) }
    return sql
}

// A random aggregate over f: keys, calls (with FILTERs), conditions,
// HAVING, DISTINCT, ORDER BY by the keys, a LIMIT.
fn aggQuery(r: mut &lexdb_base.Rng, safe: bool): str {
    let keys = ["z", "bo", "tx", "w", "x % 7", "dt", "nu", "x > 100", "z + 1", "upper(tx)", "length(w)", "coalesce(z, -1)"]
    let calls = ["count(*)", "count(x)", "sum(x)", "avg(x)", "min(x)", "max(x)", "sum(nu)", "avg(nu)", "min(nu)", "max(nu)",
                 "min(tx)", "max(w)", "min(dt)", "max(dt)", "sum(y)", "count(tx)", "sum(nu * 2)", "sum(nu + x)", "avg(nu * x)",
                 "sum(x) filter (where z > 1)", "min(nu) filter (where bo)", "count(*) filter (where tx like 'L%')",
                 "max(x * 2 - z)", "sum(z)", "min(bo::int)", "sum(cast(x as float8))", "max(upper(tx))", "avg(y)"]
    let unsafe = ["sum(x / (z - 3))", "sum(y * 1000000000)", "count(distinct z)", "string_agg(tx, ',' order by tx)", "max(cast(tx as int))"]
    var ks: []str = []
    let nk = r.below(3)
    for i in 0..nk { append(mut &ks, pick(r, &keys)) }
    var items: []str = []
    for k in ks { append(mut &items, k.clone()) }
    for i in 0..(1 + r.below(3)) { append(mut &items, pick(r, &calls)) }
    if !safe && r.below(4) == 0 { append(mut &items, pick(r, &unsafe)) }
    var conds: []str = []
    let p = path(r)
    if p != "" { append(mut &conds, p) }
    for i in 0..r.below(2) { append(mut &conds, cond(r, true)) }
    var sql = "select " + strings.join(&items, ", ") + " from f"
    if len(conds) > 0 { sql = sql + " where " + strings.join(&conds, " and ") }
    if nk > 0 {
        sql = sql + " group by " + strings.join(&ks, ", ")
        let h = r.below(5)
        if h == 0 { sql = sql + " having count(*) > " + r.below(40).toStr() }
        if h == 1 { sql = sql + " having sum(x) > " + r.below(3000).toStr() }
        var ords: []str = []
        for i in 0..nk { append(mut &ords, (i + 1).toStr()) }
        sql = sql + " order by " + strings.join(&ords, ", ")
        if r.below(4) == 0 { sql = sql + " limit " + pick(r, &["0", "1", "3", "10"]) }
    } else if r.below(6) == 0 {
        sql = sql + " having count(*) > " + r.below(2000).toStr()
    }
    return sql
}

fn load(s: mut &lexdb_exec.Session, r: mut &lexdb_base.Rng) {
    let c1 = q(s, &"create table f (id int primary key, x int, y bigint, z int, bo boolean, tx text, nu numeric(10,2), dt date, w varchar(20))")
    let c2 = q(s, &"create index f_x on f (x)")
    var id = 1
    for chunk in 0..26 {
        var rows: []str = []
        for i in 0..100 {
            append(mut &rows, "(" + id.toStr() + ", " + maybe(r, (r.below(220) - 10).toStr()) + ", " + maybe(r, ((r.below(11) - 5) * 1000000007).toStr()) + ", " +
                   maybe(r, r.below(5).toStr()) + ", " + maybe(r, pick(r, &["true", "false"])) + ", " +
                   maybe(r, pick(r, &["'L" + r.below(80).toStr() + "'", "'" + r.below(30).toStr() + "'"])) + ", " +
                   maybe(r, r.below(30).toStr() + "." + pick(r, &["0", "5", "50"])) + ", " + maybe(r, "'2024-01-" + day(r) + "'") + ", " +
                   maybe(r, "'w" + r.below(40).toStr() + "'") + ")")
            id += 1
        }
        let ins = q(s, &("insert into f values " + strings.join(&rows, ", ")))
        if ins != "INSERT 0 100" { println("insert: " + ins) }
    }
}

// An EXPLAIN ANALYZE's lines without the result's time.
fn plan(x: &str): str {
    let parts = strings.split(x, &"result:")
    return "" + parts[0]
}


// x without its tables' batches (", batches n").
fn noBatches(x: &str): str {
    var out = ""
    var i = 0
    while i < len(x) {
        if strings.startsWith(&x[i..len(x)], &", batches ") {
            i += 10
            while i < len(x) && x[i] >= '0' && x[i] <= '9' { i += 1 }
            continue
        }
        out = out + x[i..i + 1]
        i += 1
    }
    return out
}

// EXPLAIN ANALYZE's lines of sql in the row engine and in the pipeline
// the same, but for the tables' batches; and its EXPLAIN. (A scan that
// stops within a batch, at a LIMIT or an EXISTS's first row, reads the
// batch's rows: not among the shapes.)
fn sameCounts(s: mut &lexdb_exec.Session, sql: &str): bool {
    let a = q(s, &"set lexdb_batch = off")
    let off = noBatches(&q(s, &("explain analyze " + sql)))
    let offPlan = q(s, &("explain " + sql))
    let b = q(s, &"set lexdb_batch = on")
    let on = noBatches(&q(s, &("explain analyze " + sql)))
    let onPlan = q(s, &("explain " + sql))
    if plan(&on) == plan(&off) && onPlan == offPlan { return true }
    println("COUNTS: " + sql)
    println("  rows:     " + off)
    println("  pipeline: " + on)
    println("  plans: " + offPlan + " / " + onPlan)
    return false
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(61), opts(), fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st.clone())
        var r = lexdb_base.rng(61)
        load(mut &s, mut &r)
        let an = q(mut &s, &"analyze f")
        let runs0 = lexdb_pipe.runCounts()
        var same = 0
        for i in 0..500 {
            let sql = query(mut &r, i % 3 == 0)
            if both(mut &s, &sql) { same += 1 }
        }
        println("committed: 500 queries, " + same.toStr() + " the same both ways")
        // a transaction's own writes, not committed, read merged
        let b = q(mut &s, &"begin")
        let w1 = q(mut &s, &"insert into f values (5001, 7, 7, 1, true, 'L1', 1.5, '2024-01-02', 'w1'), (5002, null, 1, 3, false, 'x', 2.0, null, null)")
        let w2 = q(mut &s, &"update f set x = x + 1, tx = 'L1' || tx where id % 7 = 0")
        let w3 = q(mut &s, &"delete from f where id % 11 = 0")
        var sameT = 0
        for i in 0..120 {
            // (no errors: one would end the transaction)
            let sql = query(mut &r, true)
            if both(mut &s, &sql) { sameT += 1 }
        }
        let rb = q(mut &s, &"rollback")
        println("in a transaction: 120 queries, " + sameT.toStr() + " the same both ways")
        // the shapes one by one: errors on one row of a batch, before and
        // past a LIMIT; short-circuits; every path
        let fixed = ["select id, x / (z - 3) from f", "select id, x / (z - 3) from f limit 2", "select id from f where x / (z - 3) > 0",
                     "select id from f where x / (z - 3) > 0 limit 1", "select id, 100 / x from f where x <> 0",
                     "select id, case when z <> 1 then x / (z - 1) end from f", "select id from f where z <> 3 and x / (z - 3) >= 0",
                     "select id from f where z = 3 or x / (z - 3) >= 0", "select id, cast(tx as int) from f where tx not like 'L%'",
                     "select id, cast(tx as int) from f", "select y * 1000000000 from f", "select id from f where id = 17",
                     "select id, tx from f where id = 999999", "select id, x from f where id in (5, 2500, 1300)",
                     "select id from f order by id desc limit 3", "select x from f where x between 10 and 20",
                     "select id, x from f where x = 42", "select x from f where x > 200 limit 5", "select id, nu * 2, nu + x from f where nu > 20.5",
                     "select dt + 1, dt from f where dt >= '2024-01-20' and id < 300", "select tx || '!', upper(tx) from f where tx like 'L2%'",
                     "select id from f where id > 2590", "select id, w from f where id between 1000 and 1030 and w is null",
                     "select bo, not bo, bo and x > 5 from f where id < 50", "select coalesce(x, -1), x is null from f where id < 1030",
                     "select id from f limit 0", "select * from f where id < 3", "select x + z, x > 100 from f limit 1100",
                     "select abs(x - 100), round(nu) from f where id between 2000 and 2100", "select id from f where x is null"]
        var sameF = 0
        for sql in fixed { if both(mut &s, &sql) { sameF += 1 } }
        println("fixed: " + len(fixed).toStr() + " queries, " + sameF.toStr() + " the same both ways")
        let runs1 = lexdb_pipe.runCounts()
        println("the pipeline ran: " + (runs1[0] - runs0[0] > 500).toStr() + ", read batches: " + (runs1[1] - runs0[1] > 100).toStr() +
                ", errors: " + (sunkErrors > 20).toStr())
        // parameters: the plan kept (one cache) and run with each value,
        // against the row engine's
        let psql = "select id, x + $1, tx from f where x > $1 and id < $2 limit 40"
        var pc = lexdb_exec.newPlanCache()
        var sameP = 0
        for i in 0..12 {
            let ps = [lexdb_sql.Val.Int(r.below(200)), lexdb_sql.Val.Int(r.below(2700))]
            var ob = false
            let viaPipe = viaSink(mut &s, &psql, &ps, mut &pc, mut &ob)
            let a = q(mut &s, &"set lexdb_batch = off")
            var pc2 = lexdb_exec.oneShot()
            var ob2 = false
            let viaRows = viaSink(mut &s, &psql, &ps, mut &pc2, mut &ob2)
            let b2 = q(mut &s, &"set lexdb_batch = on")
            if viaPipe == viaRows { sameP += 1 } else { println("PARAMS: " + viaPipe + " / " + viaRows) }
        }
        println("parameters: " + sameP.toStr() + " of 12 the same")
        // max_statement_mem: the rows held past it
        let m1 = q(mut &s, &"set max_statement_mem = '64kB'")
        let big = "select id, tx, w, nu from f"
        var errs: []str = []
        let a1 = q(mut &s, &"set lexdb_batch = off")
        append(mut &errs, strings.split(&q(mut &s, &big), &" ")[0] + " " + strings.split(&q(mut &s, &big), &" ")[1])
        let a2 = q(mut &s, &"set lexdb_batch = on")
        append(mut &errs, strings.split(&q(mut &s, &big), &" ")[0] + " " + strings.split(&q(mut &s, &big), &" ")[1])
        let lim = "select id, tx, w, nu from f where x > 100 limit 2000"
        append(mut &errs, strings.split(&q(mut &s, &lim), &" ")[0] + " " + strings.split(&q(mut &s, &lim), &" ")[1])
        let small = "select id, tx from f where id < 40"
        let under = q(mut &s, &small)
        let a3 = q(mut &s, &"set lexdb_batch = off")
        let underOff = q(mut &s, &small)
        let a4 = q(mut &s, &"set lexdb_batch = on")
        let m2 = q(mut &s, &"set max_statement_mem = 0")
        println("memory: " + strings.join(&errs, " | ") + "; under it: " + (under == underOff && !strings.contains(&under, "ERROR")).toStr())
        // EXPLAIN ANALYZE's counts, and EXPLAIN, with the pipeline on and off
        let shapes = ["select id from f", "select id, x + z from f where x > 100", "select x from f where x between 10 and 30",
                      "select id from f where id = 17", "select id from f where id between 100 and 1500 and bo",
                      "select id, tx from f where tx like 'L1%'", "select id from f where id in (1, 2, 3)",
                      "select id from f order by id desc limit 4", "select id, x from f where x = 42", "select id from f limit 1100",
                      "select id from f where id > 2000 order by id", "select nu * 2 from f where nu > 10.5 and z = 1",
                      "select id from f where x > 50 limit 3", "select upper(tx) from f where dt >= '2024-01-10'",
                      "select id from f where x is null", "select bo from f where not bo", "select id from f where z in (1, 4)",
                      "select id from f where id < 0", "select x from f where x > 200 limit 1", "select id, w from f where w like 'w2%'",
                      "select id from f where id between 1020 and 1030", "select id, x from f where x between 0 and 5 limit 2",
                      "select id from f where coalesce(x, 0) > 150", "select dt from f where id >= 2599"]
        var sameC = 0
        for sql in shapes { if sameCounts(mut &s, &sql) { sameC += 1 } }
        println("counts: " + sameC.toStr() + " of " + len(shapes).toStr() + " the same")
        aggregates(mut &s, mut &r)
        subqueries(mut &s, mut &r)
        joins(mut &s, mut &r)
        return 0
    })
}

// The aggregates (slice P1b), both ways.
fn aggregates(s: mut &lexdb_exec.Session, r: mut &lexdb_base.Rng) {
    let g0 = lexdb_exec.decCounts()[2]
    let runs0 = lexdb_pipe.runCounts()
    var same = 0
    for i in 0..400 {
        let sql = aggQuery(r, i % 3 != 0)
        if both(s, &sql) { same += 1 }
    }
    println("aggregates: 400 queries, " + same.toStr() + " the same both ways")
    let b = q(s, &"begin")
    let w1 = q(s, &"insert into f values (6001, 7, 7, 1, true, 'L1', 1.5, '2024-01-02', 'w1'), (6002, null, 1, 3, false, 'x', 2.0, null, null)")
    let w2 = q(s, &"update f set x = x + 1, nu = nu * 3, tx = 'L1' || tx where id % 7 = 0")
    let w3 = q(s, &"delete from f where id % 11 = 0")
    var sameT = 0
    for i in 0..80 {
        let sql = aggQuery(r, true)
        if both(s, &sql) { sameT += 1 }
    }
    let rb = q(s, &"rollback")
    println("aggregates in a transaction: 80 queries, " + sameT.toStr() + " the same both ways")
    let fixed = ["select count(*) from f", "select count(*), sum(x), avg(nu) from f where id < 0", "select z, count(*) from f where id < 0 group by z",
                 "select sum(y * 1000000000) from f", "select z, sum(y * 1000000000) from f group by z order by 1",
                 "select sum(x / (z - 3)) from f", "select z, max(x / (z - 3)) from f group by z order by 1",
                 "select z, bo, count(*), sum(nu), min(tx), max(dt) from f group by z, bo order by 1, 2",
                 "select tx, count(*) from f group by tx order by 1", "select w, sum(x) from f where id between 100 and 2000 group by w order by 1",
                 "select id, count(*) from f group by id having count(*) > 1 order by 1", "select nu, count(*) from f group by nu order by 1",
                 "select sum(nu), avg(nu), min(nu), max(nu) from f", "select avg(nu * x), sum(nu * 2 + 1) from f where bo",
                 "select count(distinct z), count(z) from f", "select string_agg(tx, ',' order by id) from f where id < 30",
                 "select z, sum(cast(x as float8)) from f group by z order by 1", "select upper(tx), count(*) from f group by upper(tx) order by 1",
                 "select distinct z % 2, count(*) from f group by z order by 1, 2", "select z, count(*) from f group by z order by 2 desc, 1 limit 2",
                 "select sum(x) filter (where z > 1), count(*) filter (where nu > 10.5) from f", "select x, count(*) from f where x between 10 and 20 group by x order by 1",
                 "select count(*), max(x) from f where id in (5, 7, 2600)", "select count(*) from f where id = 17",
                 "select z, count(*) from f group by rollup (z) order by 1", "select dt, min(nu) from f where dt >= '2024-01-25' group by dt having min(nu) > 1 order by 1"]
    var sameF = 0
    for sql in fixed { if both(s, &sql) { sameF += 1 } }
    println("aggregates fixed: " + len(fixed).toStr() + " queries, " + sameF.toStr() + " the same both ways")
    let runs1 = lexdb_pipe.runCounts()
    let batches = lexdb_exec.decCounts()[2] - g0
    println("aggregates ran in the pipeline: " + (runs1[0] - runs0[0] > 400).toStr() + ", over batches: " + (runs1[1] - runs0[1] > 200 && batches > 200).toStr() +
            ", row by row: " + (runs1[0] - runs0[0] > runs1[1] - runs0[1]).toStr())
    // parameters: the plan kept and run with each value, against the row engine's
    let psql = "select z, sum(x + $1), count(*) filter (where x > $1) from f where id < $2 group by z order by 1"
    var pc = lexdb_exec.newPlanCache()
    var sameP = 0
    for i in 0..12 {
        let ps = [lexdb_sql.Val.Int(r.below(200)), lexdb_sql.Val.Int(r.below(2700))]
        var ob = false
        let viaPipe = viaSink(s, &psql, &ps, mut &pc, mut &ob)
        let a = q(s, &"set lexdb_batch = off")
        var pc2 = lexdb_exec.oneShot()
        var ob2 = false
        let viaRows = viaSink(s, &psql, &ps, mut &pc2, mut &ob2)
        let b2 = q(s, &"set lexdb_batch = on")
        if viaPipe == viaRows { sameP += 1 } else { println("AGG PARAMS: " + viaPipe + " / " + viaRows) }
    }
    println("aggregate parameters: " + sameP.toStr() + " of 12 the same")
    // max_statement_mem: the groups held past it
    let m1 = q(s, &"set max_statement_mem = '64kB'")
    let big = "select id, tx, count(*) from f group by id, tx"
    var errs: []str = []
    let a1 = q(s, &"set lexdb_batch = off")
    append(mut &errs, firstTwo(&q(s, &big)))
    let a2 = q(s, &"set lexdb_batch = on")
    append(mut &errs, firstTwo(&q(s, &big)))
    // (row by row: a float's sum does not run over batches)
    append(mut &errs, firstTwo(&q(s, &"select id, sum(cast(x as float8)) from f group by id")))
    let small = "select z, count(*), sum(nu) from f group by z order by 1"
    let under = q(s, &small)
    let a3 = q(s, &"set lexdb_batch = off")
    let underOff = q(s, &small)
    let a4 = q(s, &"set lexdb_batch = on")
    let m2 = q(s, &"set max_statement_mem = 0")
    println("aggregate memory: " + strings.join(&errs, " | ") + "; under it: " + (under == underOff && !strings.contains(&under, "ERROR")).toStr())
    let shapes = ["select count(*) from f", "select z, count(*) from f group by z", "select sum(nu) from f where x > 100",
                  "select tx, max(x) from f where id between 100 and 1500 group by tx", "select count(*) from f where id between 17 and 30",
                  "select count(*) from f where id in (1, 2, 3)", "select x, count(*) from f where x between 10 and 30 group by x",
                  "select z, sum(cast(x as float8)) from f group by z", "select z, count(*) from f group by z having count(*) > 500 order by 1",
                  "select count(*) from f where id < 0", "select bo, avg(nu) from f where upper(tx) = 'L1' group by bo",
                  "select max(x) from f where id > 2500"]
    var sameC = 0
    for sql in shapes { if sameCounts(s, &sql) { sameC += 1 } }
    println("aggregate counts: " + sameC.toStr() + " of " + len(shapes).toStr() + " the same")
}

fn firstTwo(x: &str): str {
    let p = strings.split(x, &" ")
    return if len(p) > 1 { p[0] + " " + p[1] } else { x.toStr() }
}

// A condition with a subquery run once (safe: no error).
fn subCond(r: mut &lexdb_base.Rng, safe: bool): str {
    let c = r.below(14)
    if c == 0 { return "x > (select avg(k) from g)" }
    if c == 1 { return "z in (select k from g)" }
    if c == 2 { return "z not in (select k from g where k is not null)" }
    if c == 3 { return "z in (select k from g)" }       // (g has a NULL: NULL where none is equal)
    if c == 4 { return "exists (select 1 from g where k > " + r.below(8).toStr() + ")" }
    if c == 5 { return "nu in (select n from g)" }
    if c == 6 { return "tx in (select t from g)" }
    if c == 7 { return "dt in (select d from g)" }
    if c == 8 { return "x < (select max(k) * 30 from g where k < " + r.below(8).toStr() + ")" }
    if c == 9 { return "(select min(k) from e) is null" }
    if c == 10 { return "z not in (select k from e)" }
    if c == 11 { return "bo = (select count(*) > 3 from g)" }
    if c == 12 { return if safe { "x <> (select k from g where k = 3)" } else { "x = (select k from g)" } }
    return "x in (select k * 20 from g) or z = 0"
}

// An output with a subquery run once.
fn subOut(r: mut &lexdb_base.Rng): str {
    return pick(r, &["(select max(k) from g)", "x - (select min(k) from g)", "z in (select k from g)", "exists (select 1 from e)",
                     "(select t from g where k = 2)", "case when z = 1 then (select sum(k) from g) else z end", "(select k from e)",
                     "tx in (select t from g)", "coalesce((select max(n) from g where k > 50), nu)"])
}

// A random query over f with subqueries run once: in WHERE, in the select
// list, or in an aggregate's.
fn subQ(r: mut &lexdb_base.Rng, safe: bool): str {
    var conds: []str = []
    let p = path(r)
    if p != "" { append(mut &conds, p) }
    for i in 0..(1 + r.below(2)) { append(mut &conds, subCond(r, safe)) }
    if r.below(3) == 0 { append(mut &conds, cond(r, safe)) }
    let w = " where " + strings.join(&conds, " and ")
    if r.below(4) == 0 {
        let k = pick(r, &["z", "bo", "tx", "z in (select k from g)"])
        let c = pick(r, &["count(*)", "sum(x)", "max(nu)", "sum(x - (select min(k) from g))", "count(*) filter (where z in (select k from g))"])
        return "select " + k + ", " + c + " from f" + w + " group by 1 order by 1"
    }
    var items: []str = []
    for i in 0..(1 + r.below(2)) { append(mut &items, pick(r, &["id", "x", "z", "tx", "nu", "x + z"])) }
    if r.below(2) == 0 { append(mut &items, subOut(r)) }
    var sql = "select " + strings.join(&items, ", ") + " from f" + w
    if r.below(4) == 0 { sql = sql + " limit " + pick(r, &["1", "5", "300"]) }
    return sql
}

// Subqueries run once (slice P1c), both ways.
fn subqueries(s: mut &lexdb_exec.Session, r: mut &lexdb_base.Rng) {
    let c1 = q(s, &"create table g (k int, t text, n numeric(10,2), d date)")
    let c2 = q(s, &"insert into g values (1, 'L1', 1.5, '2024-01-03'), (2, 'L2', 2.0, '2024-01-07'), (3, '7', 10.50, null), (4, null, null, '2024-01-12'), (null, 'L40', 3.0, '2024-01-20'), (6, 'L60', 21.5, '2024-01-28'), (2, 'L2', 2.0, null)")
    let c3 = q(s, &"create table e (k int)")
    let runs0 = lexdb_pipe.runCounts()
    var same = 0
    for i in 0..300 {
        let sql = subQ(r, i % 3 != 0)
        if both(s, &sql) { same += 1 }
    }
    println("subqueries: 300 queries, " + same.toStr() + " the same both ways")
    let fixed = ["select id, x from f where x > (select avg(k) * 40 from g)", "select id, (select max(k) from g) from f where id < 20",
                 "select id from f where z in (select k from g)", "select id, z in (select k from g) from f where id < 60",
                 "select id from f where z not in (select k from g)", "select id from f where z not in (select k from g where k is not null)",
                 "select id from f where exists (select 1 from g where k = 6)", "select id from f where not exists (select 1 from e)",
                 "select id, exists (select 1 from g where k = 99) from f where id < 5", "select id, (select k from e) from f where id < 5",
                 "select id from f where x in (select k from e)", "select id from f where x = (select k from g)",
                 "select id, (select k from g) from f", "select id, (select k from g) from f where id < 0",
                 "select id from f where id = (select max(k) from g)", "select id, x from f where id in (select k from g)",
                 "select id from f where id in (select k from g where k > 100)", "select x from f where x = (select min(k) * 50 from g)",
                 "select id from f where nu in (select n from g)", "select id from f where tx in (select t from g)",
                 "select id from f where dt in (select d from g)", "select id from f where x / ((select min(k) from g) - 1) > 0",
                 "select id, x / ((select min(k) from g) - 1) from f", "select id from f where z = 3 or x / ((select min(k) from g) - 1) > 0 limit 3",
                 "select case when z = 1 then (select sum(k) from g) else z end from f where id < 40",
                 "select z, count(*) from f where x > (select avg(k) * 40 from g) group by z order by 1",
                 "select sum(x), count(*) from f where z in (select k from g)", "select z in (select k from g), count(*) from f group by 1 order by 1",
                 "select z, sum(x - (select min(k) from g)) from f group by z order by 1", "select count(*) filter (where tx in (select t from g)) from f",
                 "select z, count(*) from f where z = (select k from g) group by z", "select max(x) from f where id in (select k from g)",
                 "select id from f where x > (select avg(x) from f where z in (select k from g)) limit 10",
                 "select id from f where x > (select avg(k) from g where g.k = f.z)"]
    var sameF = 0
    for sql in fixed { if both(s, &sql) { sameF += 1 } }
    println("subqueries fixed: " + len(fixed).toStr() + " queries, " + sameF.toStr() + " the same both ways")
    let runs1 = lexdb_pipe.runCounts()
    println("subqueries ran in the pipeline: " + (runs1[0] - runs0[0] > 300).toStr())
    // parameters in the subqueries: the plan kept and run with each value,
    // against the row engine's
    let psql = "select id, x + $1, (select max(k) from g where k < $2) from f where x > (select avg(k) * $1 from g) and z in (select k from g where k <> $2) limit 30"
    var pc = lexdb_exec.newPlanCache()
    var sameP = 0
    for i in 0..12 {
        let ps = [lexdb_sql.Val.Int(r.below(60)), lexdb_sql.Val.Int(r.below(7))]
        var ob = false
        let viaPipe = viaSink(s, &psql, &ps, mut &pc, mut &ob)
        let a = q(s, &"set lexdb_batch = off")
        var pc2 = lexdb_exec.oneShot()
        var ob2 = false
        let viaRows = viaSink(s, &psql, &ps, mut &pc2, mut &ob2)
        let b2 = q(s, &"set lexdb_batch = on")
        if viaPipe == viaRows && !strings.contains(&viaPipe, "ERROR") { sameP += 1 } else { println("SUB PARAMS: " + viaPipe + " / " + viaRows) }
    }
    println("subquery parameters: " + sameP.toStr() + " of 12 the same")
    let shapes = ["select id from f where x > (select avg(k) * 40 from g)", "select id, (select max(k) from g) from f where id < 20",
                  "select id from f where z in (select k from g) and id < 1000", "select id from f where not exists (select 1 from g where k > 100) limit 5",
                  "select id from f where id = (select max(k) from g)", "select id from f where id in (select k from g)",
                  "select z, count(*) from f where x > (select avg(k) * 40 from g) group by z", "select sum(x) from f where z in (select k from g)",
                  "select id from f where x > (select avg(x) from f where z in (select k from g)) limit 10",
                  "select id from f where tx in (select t from g) and x > 10"]
    var sameC = 0
    for sql in shapes { if sameCounts(s, &sql) { sameC += 1 } }
    println("subquery counts: " + sameC.toStr() + " of " + len(shapes).toStr() + " the same")
}

// A random join over f (slice P2): its tables d (by f.x: a hash or a
// lookup per row by its primary key), g (by f.z or f.tx: duplicate and
// NULL keys), h (by f.x: a range per row of its key's first column, or a
// lookup by both), e (empty); inner and LEFT; rows or an aggregate.
fn joinQ(r: mut &lexdb_base.Rng, safe: bool): str {
    let froms = ["f join d on d.dk = f.x", "f left join d on d.dk = f.x and d.dz <> 1", "f join g on g.k = f.z", "f left join g on g.k = f.z",
                 "f join g on g.t = f.tx", "f join h on h.hk = f.x", "f left join h on h.hk = f.x and h.ht <> 'H3'", "f join h on h.hk = f.x and h.hz = f.id",
                 "f join d on d.dk = f.x join g on g.k = d.dz", "f join d on d.dk = f.x left join h on h.hk = d.dk", "d join f on f.x = d.dk",
                 "f join e on e.k = f.z", "f left join e on e.k = f.z", "g join f on f.z = g.k", "f join d on d.dk = f.x + 1 and d.dz = f.z"]
    let f = pick(r, &froms)
    let gs = strings.contains(&f, "g on") || strings.contains(&f, "g join")
    let ds = strings.contains(&f, "d on") || strings.contains(&f, "d join")
    let hs = strings.contains(&f, "h on")
    var items: []str = []
    var cols = ["f.id", "f.x", "f.z", "f.tx", "f.nu", "f.dt", "f.bo"]
    if gs { for c in ["g.k", "g.t", "g.n", "g.d"] { append(mut &cols, c) } }
    if ds { for c in ["d.dk", "d.dz", "d.dtx", "d.dn", "d.dn * f.z", "f.x + d.dz"] { append(mut &cols, c) } }
    if hs { for c in ["h.hk", "h.hz", "h.ht"] { append(mut &cols, c) } }
    var conds: []str = []
    for i in 0..r.below(3) { append(mut &conds, cond(r, safe)) }
    if ds && r.below(3) == 0 { append(mut &conds, pick(r, &["d.dz <> 2", "d.dtx like 'D1%'", "d.dn > 10.5", "d.dz is null", "d.dk is null"])) }
    if gs && r.below(3) == 0 { append(mut &conds, pick(r, &["g.n > 2", "g.t is not null", "g.k <> 2"])) }
    if hs && r.below(3) == 0 { append(mut &conds, pick(r, &["h.hz > 300", "h.ht = 'H1'", "h.hk is null"])) }
    if !safe && ds && r.below(3) == 0 { append(mut &conds, "f.x / (d.dz - 2) > 0") }
    var sql = ""
    if r.below(3) == 0 {
        // an aggregate
        let keys = ["f.z", "f.tx", "f.bo"]
        var ks: []str = []
        if r.below(3) > 0 {
            append(mut &ks, pick(r, &keys))
            if ds { append(mut &ks, "d.dz") }
        }
        for k in ks { append(mut &items, k.clone()) }
        append(mut &items, pick(r, &["count(*)", "sum(f.x)", "avg(f.nu)", "min(f.tx)", "max(f.dt)"]))
        if ds { append(mut &items, pick(r, &["sum(d.dn)", "count(d.dk)", "max(d.dtx)", "sum(d.dn * f.z)"])) }
        if gs { append(mut &items, pick(r, &["sum(g.n)", "min(g.t)", "count(g.k)"])) }
        if hs { append(mut &items, pick(r, &["sum(h.hz)", "max(h.ht)"])) }
        if !safe && r.below(3) == 0 { append(mut &items, "sum(f.x / (f.z - 3))") }
        sql = "select " + strings.join(&items, ", ") + " from " + f
        if len(conds) > 0 { sql = sql + " where " + strings.join(&conds, " and ") }
        if len(ks) > 0 {
            sql = sql + " group by " + strings.join(&ks, ", ")
            var ords: []str = []
            for i in 0..len(ks) { append(mut &ords, (i + 1).toStr()) }
            sql = sql + " order by " + strings.join(&ords, ", ")
        }
        return sql
    }
    for i in 0..(1 + r.below(4)) { append(mut &items, pick(r, &cols)) }
    if !safe && r.below(3) == 0 { append(mut &items, pick(r, &["f.x / (f.z - 3)", "100 / f.x", "cast(f.tx as int)"])) }
    sql = "select " + strings.join(&items, ", ") + " from " + f
    if len(conds) > 0 { sql = sql + " where " + strings.join(&conds, " and ") }
    if r.below(4) == 0 { sql = sql + " limit " + pick(r, &["1", "5", "300", "2000"]) }
    return sql
}

// A random semi or anti join over f (slice P2b): EXISTS, NOT EXISTS, IN
// and NOT IN conjuncts of WHERE (a hash of the subquery's rows, a range
// looked up per row, a summary of "inner <> outer"), rows or an aggregate.
fn semiQ(r: mut &lexdb_base.Rng, safe: bool): str {
    let semis = ["exists (select 1 from d where d.dk = f.x)", "not exists (select 1 from d where d.dk = f.x and d.dz = 2)",
                 "f.z in (select k from g)", "f.z not in (select k from g)", "f.z not in (select k from g where k is not null)",
                 "f.tx in (select t from g)", "exists (select 1 from h where h.hk = f.x and h.hz > f.id)", "not exists (select 1 from h where h.hk = f.x)",
                 "exists (select 1 from d where d.dk = f.x and d.dz <> f.z)", "not exists (select 1 from d where d.dk = f.x and d.dz <> f.z)",
                 "f.x in (select dk from d where dn > 100)", "exists (select * from e where e.k = f.z)", "not exists (select 1 from e where e.k = f.z)",
                 "f.dt in (select d from g)", "exists (select 1 from h where h.hk = f.x and h.ht = 'H2')"]
    var conds: []str = []
    append(mut &conds, pick(r, &semis))
    if r.below(3) == 0 { append(mut &conds, pick(r, &semis)) }
    for i in 0..r.below(2) { append(mut &conds, cond(r, safe)) }
    if r.below(3) == 0 {
        let k = pick(r, &["z", "tx", "bo"])
        return "select " + k + ", count(*), sum(x) from f where " + strings.join(&conds, " and ") + " group by 1 order by 1"
    }
    var items: []str = []
    for i in 0..(1 + r.below(3)) { append(mut &items, pick(r, &["id", "x", "z", "tx", "nu", "dt"])) }
    var sql = "select " + strings.join(&items, ", ") + " from f where " + strings.join(&conds, " and ")
    if r.below(4) == 0 { sql = sql + " limit " + pick(r, &["1", "5", "300"]) }
    return sql
}

// Joins (slice P2), both ways.
fn joins(s: mut &lexdb_exec.Session, r: mut &lexdb_base.Rng) {
    let c1 = q(s, &"create table d (dk int primary key, dz int, dtx text, dn numeric(10,2))")
    let c2 = q(s, &"insert into d select i, case when i % 13 = 0 then null else i % 5 end, 'D' || (i % 20), i * 0.75 from generate_series(-5, 300) i")
    let c3 = q(s, &"create table h (hk int, hz int, ht text, primary key (hk, hz))")
    let c4 = q(s, &"insert into h select i % 230 - 5, i, 'H' || (i % 7) from generate_series(1, 1600) i")
    let c5 = q(s, &"analyze")
    let j0 = lexdb_pipe.joinCounts()
    let rj0 = lexdb_exec.rangeJoins()
    var same = 0
    for i in 0..400 {
        let sql = joinQ(r, i % 3 != 0)
        if both(s, &sql) { same += 1 }
    }
    println("joins: 400 queries, " + same.toStr() + " the same both ways")
    let b = q(s, &"begin")
    let w1 = q(s, &"insert into d values (301, 2, 'D9', 1.5), (302, null, null, null)")
    let w2 = q(s, &"update d set dz = dz + 1 where dk % 9 = 0")
    let w3 = q(s, &"delete from h where hz % 5 = 0")
    var sameT = 0
    for i in 0..100 {
        let sql = joinQ(r, true)
        if both(s, &sql) { sameT += 1 }
    }
    let rb = q(s, &"rollback")
    println("joins in a transaction: 100 queries, " + sameT.toStr() + " the same both ways")
    let fixed = ["select f.id, d.dz from f join d on d.dk = f.x where f.id < 100", "select f.id, f.x / (d.dz - 2) from f join d on d.dk = f.x",
                 "select f.id, f.x / (d.dz - 2) from f join d on d.dk = f.x limit 3", "select f.id from f join d on d.dk = f.x where f.x / (d.dz - 2) > 0 limit 2",
                 "select f.id from f join d on d.dk = f.x where f.x / (f.z - 3) > 0 limit 2", "select f.id, g.k from f join g on g.k = f.z where f.id < 30",
                 "select f.id, g.k from f left join g on g.k = f.z where f.id < 30", "select f.id, e.k from f join e on e.k = f.z",
                 "select f.id, e.k from f left join e on e.k = f.z where f.id < 10", "select f.id, d.dk from f join d on d.dk = f.x where f.id < 0",
                 "select f.id, d.dk from f left join d on d.dk = f.x and d.dz = 2 where d.dk is null and f.id < 200",
                 "select f.id, h.hz from f join h on h.hk = f.x and h.hz = f.id", "select f.id, h.hz from f join h on h.hk = f.x where f.id < 50",
                 "select f.id, h.hz from f left join h on h.hk = f.x and h.hz > 1500 where f.id < 50",
                 "select f.id, d.dk, g.t from f join d on d.dk = f.x join g on g.k = d.dz where f.id < 400",
                 "select f.id, d.dk from f join d on d.dk = f.x + 1 and d.dz = f.z", "select f.id, g.t from f join g on g.t = f.tx",
                 "select z, count(*), sum(d.dn) from f join d on d.dk = f.x group by z order by 1",
                 "select count(*), sum(d.dn * f.nu), min(d.dtx) from f join d on d.dk = f.x where f.z <> 1",
                 "select d.dz, count(*), avg(f.nu), max(g.t) from f join d on d.dk = f.x join g on g.k = d.dz group by d.dz order by 1",
                 "select f.tx, count(h.hz) from f left join h on h.hk = f.x group by f.tx order by 1 limit 5",
                 "select count(*) from f join e on e.k = f.z", "select sum(f.x / (d.dz - 2)) from f join d on d.dk = f.x",
                 "select sum(d.dn) from f join d on d.dk = f.x where d.dtx like 'D1%'", "select g.k, count(*) from f join g on g.k = f.z group by g.k order by 1",
                 "select count(*), sum(h.hz) from f join h on h.hk = f.x and h.hz = f.id"]
    var sameF = 0
    for sql in fixed { if both(s, &sql) { sameF += 1 } }
    println("joins fixed: " + len(fixed).toStr() + " queries, " + sameF.toStr() + " the same both ways")
    let j1 = lexdb_pipe.joinCounts()
    println("joins ran in the pipeline: " + (j1[0] - j0[0] > 300).toStr() + ", hashes built: " + (j1[2] - j0[2] > 50).toStr() +
            ", rows dropped by the first hash's keys: " + (j1[3] - j0[3] > 0).toStr() + ", ranges per row: " + (lexdb_exec.rangeJoins() - rj0 > 20).toStr())
    // parameters: the plan kept and run with each value
    let psql = "select f.id, d.dtx, d.dn + $1 from f join d on d.dk = f.x where f.z <> $2 and d.dz <> $2 limit 50"
    var pc = lexdb_exec.newPlanCache()
    var sameP = 0
    for i in 0..12 {
        let ps = [lexdb_sql.Val.Int(r.below(60)), lexdb_sql.Val.Int(r.below(5))]
        var ob = false
        let viaPipe = viaSink(s, &psql, &ps, mut &pc, mut &ob)
        let a = q(s, &"set lexdb_batch = off")
        var pc2 = lexdb_exec.oneShot()
        var ob2 = false
        let viaRows = viaSink(s, &psql, &ps, mut &pc2, mut &ob2)
        let b2 = q(s, &"set lexdb_batch = on")
        if viaPipe == viaRows && !strings.contains(&viaPipe, "ERROR") { sameP += 1 } else { println("JOIN PARAMS: " + viaPipe + " / " + viaRows) }
    }
    println("join parameters: " + sameP.toStr() + " of 12 the same")
    // max_statement_mem: a hash's rows held past it, both ways; and under it
    let m1 = q(s, &"set max_statement_mem = '64kB'")
    let a1 = q(s, &"set lexdb_batch = off")
    let mOff = q(s, &"select f.id, f.tx, d.dtx from f join d on d.dk = f.x")
    let a2 = q(s, &"set lexdb_batch = on")
    let mOn = q(s, &"select f.id, f.tx, d.dtx from f join d on d.dk = f.x")
    let m2 = q(s, &"set max_statement_mem = '4MB'")
    let a3 = q(s, &"set lexdb_batch = off")
    let uOff = q(s, &"select count(*), sum(b.nu) from f a join f b on b.y = a.y where a.id < 100")
    let a4 = q(s, &"set lexdb_batch = on")
    let uOn = q(s, &"select count(*), sum(b.nu) from f a join f b on b.y = a.y where a.id < 100")
    let m3 = q(s, &"reset max_statement_mem")
    println("join memory: " + mOff[0..11] + " | " + mOn[0..11] + "; under it: " + (uOff == uOn).toStr())
    let shapes = ["select f.id, d.dz from f join d on d.dk = f.x", "select f.id, g.k from f left join g on g.k = f.z",
                  "select f.id, h.hz from f join h on h.hk = f.x", "select f.id, d.dk, g.t from f join d on d.dk = f.x join g on g.k = d.dz",
                  "select z, count(*), sum(d.dn) from f join d on d.dk = f.x group by z", "select count(*) from f join e on e.k = f.z",
                  "select f.id from f left join d on d.dk = f.x and d.dz = 2 where d.dk is null", "select count(*) from f join h on h.hk = f.x and h.hz = f.id",
                  "select f.id, g.t from f join g on g.t = f.tx", "select count(*) from f join d on d.dk = f.x where f.z <> 1 and d.dz <> 2"]
    var sameC = 0
    for sql in shapes { if sameCounts(s, &sql) { sameC += 1 } }
    println("join counts: " + sameC.toStr() + " of " + len(shapes).toStr() + " the same")
    // semi and anti joins, RIGHT joins (slice P2b)
    var sameS = 0
    for i in 0..300 {
        let sql = semiQ(r, i % 3 != 0)
        if both(s, &sql) { sameS += 1 }
    }
    println("semi and anti joins: 300 queries, " + sameS.toStr() + " the same both ways")
    let fixed2 = ["select id from f where exists (select 1 from d where d.dk = f.x) and f.x / (f.z - 3) > 0 limit 2",
                  "select id, x / (z - 3) from f where f.z in (select k from g) limit 3", "select id from f where f.z not in (select k from g)",
                  "select count(*) from f where f.x not in (select dk from d)", "select count(*) from f where f.x not in (select dz from d)",
                  "select id from f where exists (select 1 from h where h.hk = f.x and h.hz > f.id) and id < 300",
                  "select z, count(*) from f where not exists (select 1 from d where d.dk = f.x and d.dz <> f.z) group by z order by 1",
                  "select f.id, d.dk from d right join f on f.x = d.dk where f.id < 300", "select d.dz, count(f.id) from f right join d on d.dk = f.x group by d.dz order by 1",
                  "select d.dk, f.id from f right join d on d.dk = f.x and f.z = 1 where d.dk < 40", "select count(*) from e right join f on f.z = e.k",
                  "select g.k, f.id from f right join g on g.k = f.x where f.id is null"]
    var sameF2 = 0
    for sql in fixed2 { if both(s, &sql) { sameF2 += 1 } }
    println("semi, anti and right fixed: " + len(fixed2).toStr() + " queries, " + sameF2.toStr() + " the same both ways")
    let shapes2 = ["select id from f where exists (select 1 from d where d.dk = f.x)", "select id from f where f.z not in (select k from g where k is not null)",
                   "select count(*) from f where exists (select 1 from h where h.hk = f.x and h.hz > f.id)",
                   "select z, count(*) from f where not exists (select 1 from d where d.dk = f.x and d.dz <> f.z) group by z",
                   "select f.id, d.dk from d right join f on f.x = d.dk", "select d.dz, count(f.id) from f right join d on d.dk = f.x group by d.dz"]
    var sameC2 = 0
    for sql in shapes2 { if sameCounts(s, &sql) { sameC2 += 1 } }
    println("semi, anti and right counts: " + sameC2.toStr() + " of " + len(shapes2).toStr() + " the same")
}
