// lexdb_exec: CHECK and foreign key constraints NOT ENFORCED (PostgreSQL 18 and 19, design/lexdb-new-features.md P6, 10.5): in CREATE TABLE (column
// and table constraints, with NO INHERIT) and ALTER TABLE ADD CONSTRAINT, the rows written and deleted while one is off (a parent deleted under a
// foreign key not enforced, ON DELETE CASCADE not done), ALTER CONSTRAINT [NOT] ENFORCED (the rows checked: 23514, 23503; enforced and valid
// after), NOT VALID, VALIDATE CONSTRAINT of one not enforced (55000), RENAME and DROP CONSTRAINT, a column retyped, renamed and dropped, an
// expression that would divide by zero, 3,000 rows in batches; 42601 for NOT ENFORCED on a key, NOT NULL or a default, and for two states;
// 42809 and 42704 for ALTER CONSTRAINT of a key or a name not there; pg_constraint.conenforced and convalidated, pg_get_constraintdef and
// information_schema.table_constraints.enforced. Checked against PostgreSQL 19 (generated by tests/lexdb/gen_pg.py from unenf_queries.txt).
// Each answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off and on, an "@tx" one in
// a transaction rolled back.
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: same: conname|contype|conenforced|convalidated: ck|c|f|f;fk|f|f|f
// expect: same: conname|pg_get_constraintdef: ck|CHECK ((v > 0)) NOT ENFORCED;fk|FOREIGN KEY (pid) REFERENCES p(id) NOT ENFORCED
// expect: same: constraint_name|constraint_type|enforced: ck|CHECK|NO;fk|FOREIGN KEY|NO
// expect: same: id|pid|v: 3|1|-1;4|77|5
// expect: same: id|pid|v: 1|55|-9
// expect: same: id: 1
// expect: same: id|pid|v: 1|1|-5;2|99|5
// expect: same: ERROR 23514
// expect: same: conname|conenforced|convalidated: ck|t|t;fk|f|f
// expect: same: ERROR 23514
// expect: same: ERROR 23514
// expect: same: ERROR 23503
// expect: same: conname|conenforced|convalidated: ck|f|f;fk|t|t
// expect: same: ERROR 23503
// expect: same: ERROR 23503
// expect: same: conname|conenforced|convalidated: ck|f|f;fk|f|f
// expect: same: conname|conenforced|convalidated: ck|t|t;fk|f|f
// expect: same: ERROR 55000
// expect: same: ERROR 55000
// expect: same: ERROR 42809
// expect: same: ERROR 42704
// expect: same: ERROR 42704
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 0A000
// expect: same: conname|conenforced|convalidated: ckx|f|f;fkx|f|f
// expect: same: conname|conenforced|convalidated: 
// expect: same: conname|conenforced|convalidated: ck|f|f;ck2|t|f;fk|f|f
// expect: same: conname|conenforced|convalidated: ck|f|f;ck2|t|t;fk|f|f
// expect: same: id: 3
// expect: same: id: 3
// expect: same: ERROR 23514
// expect: same: count: 3002
// expect: same: ERROR 23514
// expect: same: ERROR 23503
// expect: same: id|pid: 1|1001;2|1002
// expect: same: id: 3
// expect: same: id: 3
// expect: same: ERROR 23514
// expect: same: conname|conenforced|convalidated: fk|f|f
// expect: same: id: -1
// expect: same: conname|conenforced|convalidated: k|f|f
// expect: same: ERROR 23514
// expect: same: conname|conenforced|convalidated: dfk|f|f
// expect: same: pg_get_constraintdef: FOREIGN KEY (id) REFERENCES p(id) NOT ENFORCED
// expect: same: id: 1;2
// expect: same: id: 1;2
// expect: same: ERROR 23503
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: conenforced: t
// expect: same: id: -1
// expect: same: ERROR 0A000
// expect: same: ERROR 0A000
// expect: same: a: -1
// expect: same: ERROR 23514
// expect: same: ERROR 23514
// expect: same: id|x: 3|-1
// expect: same: ERROR 23514
// expect: same: ERROR 42601
// expect: same: ERROR 0A000
// expect: same: ERROR 0A000
// expect: same: ERROR 42601
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table p (id int primary key, v int)\n@once insert into p values (1, 10), (2, 20)\n@once create table c (id int primary key, pid int, v int)\n@once insert into c values (1, 1, -5), (2, 99, 5)\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; select conname, contype, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; select conname, pg_get_constraintdef(oid) from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; select constraint_name, constraint_type, enforced from information_schema.table_constraints where table_name = 'c' and constraint_type in ('CHECK', 'FOREIGN KEY') and constraint_name not like '%not_null' order by constraint_name\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; insert into c values (3, 1, -1), (4, 77, 5) returning id, pid, v\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; update c set v = -9, pid = 55 where id = 1 returning id, pid, v\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from p where id = 1 returning id\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from p where id = 1; select id, pid, v from c order by id\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c alter constraint ck enforced\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where v < 0; alter table c alter constraint ck enforced; select conname, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where v < 0; alter table c alter constraint ck enforced; insert into c values (3, 1, -1)\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where v < 0; alter table c alter constraint ck enforced; update c set v = -1 where id = 2\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c alter constraint fk enforced\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where pid = 99; alter table c alter constraint fk enforced; select conname, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where pid = 99; alter table c alter constraint fk enforced; insert into c values (5, 55, 1)\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where pid = 99; alter table c alter constraint fk enforced; delete from p where id = 1\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where v < 0 or pid = 99; alter table c alter constraint ck enforced; alter table c alter constraint fk enforced; alter table c alter constraint ck not enforced; alter table c alter constraint fk not enforced; insert into c values (6, 66, -6) returning id; select conname, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where v < 0 or pid = 99; alter table c alter constraint ck enforced; alter table c alter constraint ck not enforced; alter table c alter constraint ck not enforced; alter table c alter constraint ck enforced; alter table c alter constraint ck enforced; select conname, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c validate constraint ck\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c validate constraint fk\n@tx alter table c alter constraint c_pkey not enforced\n@tx alter table c alter constraint nosuch enforced\n@tx alter table c alter constraint pk enforced\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c alter constraint ck enforced not enforced\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c alter constraint ck not enforced enforced\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c alter constraint ck enforced not valid\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c rename constraint ck to ckx; alter table c rename constraint fk to fkx; select conname, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c drop constraint ck; alter table c drop constraint fk; select conname, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c add constraint ck2 check (v < 100) not valid; alter table c alter constraint ck2 enforced; select conname, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c add constraint ck2 check (v < 100) not valid; alter table c alter constraint ck2 not enforced; alter table c alter constraint ck2 enforced; select conname, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c add constraint ck3 check (v < 0) not enforced; insert into c values (3, 1, 5) returning id\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c add constraint ckz check (1 / (v - 5) > 0) not enforced; insert into c values (3, 1, 5) returning id\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c add constraint ckz check (1 / (v - 5) > 0) not enforced; alter table c alter constraint ckz enforced\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; insert into c select i + 100, 1, -i from generate_series(1, 3000) i; select count(*) from c\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where v < 0 or pid = 99; alter table c alter constraint ck enforced; alter table c drop constraint fk; insert into c select i + 100, 1, 2000 - i from generate_series(1, 3000) i\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; delete from c where v < 0 or pid = 99; alter table c alter constraint fk enforced; insert into c select i + 100, 1 + (i / 2999) * 50, 1 from generate_series(1, 3000) i\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; update c set pid = 1000 + id where id > 0; select id, pid from c order by id\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c alter column v type bigint; insert into c values (3, 1, -1) returning id\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c rename column v to w; insert into c values (3, 1, -1) returning id\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c alter column v type bigint; alter table c alter constraint ck enforced\n@tx alter table c add constraint ck check (v > 0) not enforced; alter table c add constraint fk foreign key (pid) references p (id) not enforced; alter table c drop column v; select conname, conenforced, convalidated from pg_constraint where conrelid = 'c'::regclass and contype in ('c', 'f') order by conname\n@tx create table d1 (id int check (id > 0) not enforced); insert into d1 values (-1) returning id\n@tx create table d1 (a int, b int, constraint k check (a < b) not enforced); insert into d1 values (2, 1) returning a; select conname, conenforced, convalidated from pg_constraint where conrelid = 'd1'::regclass\n@tx create table d1 (a int, b int, constraint k check (a < b) not enforced); alter table d1 alter constraint k enforced; insert into d1 values (2, 1)\n@tx create table d1 (id int, constraint dfk foreign key (id) references p (id) not enforced); insert into d1 values (99) returning id; select conname, conenforced, convalidated from pg_constraint where conrelid = 'd1'::regclass\n@tx create table d1 (id int references p (id) not enforced); insert into d1 values (99) returning id; delete from p where id = 1; select pg_get_constraintdef(oid) from pg_constraint where conrelid = 'd1'::regclass\n@tx create table d1 (id int references p (id) on delete cascade not enforced); insert into d1 values (1), (2); delete from p where id = 1; select id from d1 order by id\n@tx create table d1 (id int references p (id) on delete cascade); insert into d1 values (1), (2); alter table d1 alter constraint d1_id_fkey not enforced; delete from p where id = 1; select id from d1 order by id\n@tx create table d1 (id int references p (id) on delete cascade not enforced); insert into d1 values (1), (2), (99); alter table d1 alter constraint d1_id_fkey enforced\n@tx create table d1 (id int primary key not enforced)\n@tx create table d1 (id int unique not enforced)\n@tx create table d1 (id int not null not enforced)\n@tx create table d1 (id int default 1 not enforced)\n@tx create table d1 (id int check (id > 0) enforced not enforced)\n@tx create table d1 (id int check (id > 0) not enforced not enforced)\n@tx create table d1 (id int check (id > 0) enforced); select conenforced from pg_constraint where conrelid = 'd1'::regclass\n@tx create table d1 (id int check (id > 0) no inherit not enforced); insert into d1 values (-1) returning id\n@tx create table d1 (a int, primary key (a) not enforced)\n@tx create table d1 (a int, unique (a) not enforced)\n@tx create table d1 (a int check (a > 0) not enforced, b int check (b > 0)); insert into d1 values (-1, 1) returning a\n@tx create table d1 (a int check (a > 0) not enforced, b int check (b > 0)); insert into d1 values (1, -1)\n@tx create table d1 (a int check (a > 0) not enforced, check (a < 10)); insert into d1 values (-1) returning a; insert into d1 values (20)\n@tx alter table c add column x int check (x > 0) not enforced; insert into c values (3, 1, 1, -1) returning id, x\n@tx alter table c add constraint ck5 check (v > 0) not enforced, add constraint ck6 check (v > 0)\n@tx alter table c add constraint ck5 not enforced\n@tx alter table c add constraint ck5 unique (v) not enforced\n@tx alter table c add constraint ck5 primary key (v) not enforced\n@tx alter table c add constraint ck7 check (v > 0) enforced not enforced"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(154), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
