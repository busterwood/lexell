import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table dg (i number(10))\ninsert into dg values (0)\ninsert into dg values (1)\ninsert into dg values (2)\ninsert into dg values (3)\ninsert into dg values (4)\ninsert into dg values (5)\ninsert into dg values (6)\ninsert into dg values (7)\ninsert into dg values (8)\ninsert into dg values (9)\ncreate table wt (id number(10) primary key, g number(10), x number(10), t varchar2(10), n number(10,2))\ninsert into wt select n, mod(n, 7), case when mod(n, 11) = 0 then null else mod(n * 37, 50) end, case when mod(n, 13) = 0 then null when mod(n, 3) = 0 then 'Ab' when mod(n, 3) = 1 then 'ab' else 'b' || mod(n, 4) end, case when mod(n, 17) = 0 then null else mod(n * 7, 1000) / 4 end from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 3000\ncreate table kt (g number(10) primary key, name varchar2(10))\ninsert into kt values (0, 'zero')\ninsert into kt values (1, 'one')\ninsert into kt values (2, 'two')\ninsert into kt values (3, 'three')\ninsert into kt values (4, 'four')\ninsert into kt values (5, 'five')\ncreate table et (id number(10) primary key, x number(10))"

const QS = "select id, row_number() over (partition by g order by id) rn from wt where id <= 20 order by id\nselect id, x, rank() over (order by x) r, dense_rank() over (order by x) d from wt where id <= 30 order by id\nselect id, sum(x) over (order by id rows between 2 preceding and current row) s, count(x) over (order by id rows unbounded preceding) c from wt where id <= 15 order by id\nselect id, max(n) over (partition by g order by id rows between 1 preceding and 1 following) m, min(x) over (partition by g) lo from wt where id < 25 order by id\nselect id, lag(x, 1, -1) over (order by id) l, lead(t) over (partition by g order by id) ld, lag(t, 2) over (order by id) l2 from wt where id <= 12 order by id\nselect id, first_value(x) over (partition by g order by id) f, last_value(x) over (partition by g order by id rows between unbounded preceding and unbounded following) la, nth_value(x, 2) over (partition by g order by id) n2 from wt where id <= 16 order by id\nselect id, ntile(4) over (order by id) q from wt where id <= 10 order by id\nselect id, count(*) over (partition by g) c, sum(x) over (partition by g) s from wt where id <= 14 order by id\nselect id, sum(x) over (order by x range between 5 preceding and 5 following) s, sum(x) over (order by x groups between 1 preceding and current row) gs from wt where id <= 12 order by id\nselect id, sum(x) over (order by id rows between 1 preceding and 1 following exclude current row) s, count(*) over (order by x range between unbounded preceding and current row exclude ties) c from wt where id <= 12 order by id\nselect id, row_number() over (order by x desc nulls last, id) rn from wt order by rn fetch first 5 rows only\nselect id, x, rank() over (order by x) r from wt where id <= 30 and x is not null order by r fetch first 3 rows with ties\nselect id, g, dense_rank() over (order by g) r from wt where id <= 20 order by r, id fetch first 2 rows with ties\nselect id, sum(x) over (partition by g) s from wt order by id offset 100 rows fetch next 5 rows only\nselect wt.id, kt.name, rank() over (partition by kt.name order by wt.x desc nulls last, wt.id) r from wt join kt on kt.g = wt.g where wt.id <= 20 order by wt.id\nselect wt.id, kt.name, count(*) over (partition by kt.name) c from wt left join kt on kt.g = wt.g where wt.id <= 9 order by wt.id\nselect id, row_number() over (order by id) rn, 10 / (id - 2500) q from wt\nselect id, sum(trunc(10 / (id - 2999))) over (order by id) s from wt\nselect g, sum(x) s, rank() over (order by sum(x) desc) r from wt group by g order by g\nselect g, count(*) c, sum(count(*)) over () total, sum(count(*)) over (order by g) run from wt group by g order by g\nselect g, max(x) m, lag(max(x)) over (order by g) pm from wt where id > 100 group by g having count(*) > 400 order by g\nselect distinct g, count(*) over (partition by g) c from wt order by g\nselect g, id from (select g, id, row_number() over (partition by g order by x desc nulls last, id) rn from wt) z where rn = 1 order by g\nselect id, row_number() over (order by id) rn from wt where id < 0\nselect id, row_number() over (order by id) rn from et\nselect t, count(*) over (partition by t) c, row_number() over (partition by t order by id) rn from wt where id <= 12 order by id\nselect id, x - lag(x) over (order by id) dx, trunc(100 * x / nullif(sum(x) over (partition by g), 0), 4) pct from wt where id <= 10 order by id\nselect id, row_number() over (order by id) rn, (select max(g) from kt) mg from wt where id <= 3 order by id\nwith c as (select id, g, x from wt where id <= 40) select id, dense_rank() over (partition by g order by x) d from c order by id fetch first 8 rows only\nselect count(*) n, sum(rn) s from (select row_number() over (partition by g order by id) rn from wt) z"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(58), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
