import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "CREATE TABLE md_parent (id int NOT NULL, code varchar(10) NOT NULL, note varchar(100) NULL, amt decimal(10,2), dt datetime2(3), CONSTRAINT md_parent_pk PRIMARY KEY (id, code))\nCREATE UNIQUE INDEX md_parent_ix ON md_parent (note)\nCREATE TABLE md_child (cid int IDENTITY(1,1) PRIMARY KEY, pid int, pcode varchar(10), CONSTRAINT md_child_fk FOREIGN KEY (pid, pcode) REFERENCES md_parent (id, code))\nCREATE VIEW md_view AS SELECT id FROM md_parent\nsp_tables @table_name = N'md_%', @table_owner = N'dbo', @table_type = N'''TABLE'',''VIEW'''\nEXEC sp_tables @table_name = N'md_view', @table_type = N'''VIEW'''\nEXEC sp_pkeys @table_name = N'md_parent'\nEXEC sp_fkeys @fktable_name = N'md_child'\nEXEC sp_fkeys @pktable_name = N'md_parent'\nEXEC sp_statistics_100 @table_name = N'md_parent'\nEXEC sp_special_columns_100 @table_name = N'md_parent', @col_type = 'R'\nEXEC sp_special_columns_100 @table_name = N'md_parent', @col_type = 'V'\nEXEC sp_table_privileges @table_name = N'md_parent'\nEXEC sp_column_privileges @table_name = N'md_parent', @column_name = N'id'\nEXEC sp_stored_procedures\nDECLARE @mssqljdbc_temp_sp_columns_result TABLE(TABLE_QUALIFIER SYSNAME, TABLE_OWNER SYSNAME, TABLE_NAME SYSNAME, COLUMN_NAME SYSNAME, DATA_TYPE smallint, TYPE_NAME SYSNAME, PRECISION int, LENGTH int, SCALE smallint, RADIX smallint, NULLABLE smallint, REMARKS varchar(254), COLUMN_DEF nvarchar(4000), SQL_DATA_TYPE smallint, SQL_DATETIME_SUB smallint, CHAR_OCTET_LENGTH int, ORDINAL_POSITION int, IS_NULLABLE varchar(254), SS_IS_SPARSE smallint, SS_IS_COLUMN_SET smallint, SS_IS_COMPUTED smallint, SS_IS_IDENTITY smallint, SS_UDT_CATALOG_NAME nvarchar(128), SS_UDT_SCHEMA_NAME nvarchar(128), SS_UDT_ASSEMBLY_TYPE_NAME nvarchar(max), SS_XML_SCHEMACOLLECTION_CATALOG_NAME nvarchar(128), SS_XML_SCHEMACOLLECTION_SCHEMA_NAME nvarchar(128), SS_XML_SCHEMACOLLECTION_NAME nvarchar(128), SS_DATA_TYPE tinyint); INSERT INTO @mssqljdbc_temp_sp_columns_result EXEC sp_columns_170 @table_name = N'md_%', @table_owner = N'dbo'; SELECT TABLE_NAME, COLUMN_NAME, DATA_TYPE, TYPE_NAME, PRECISION, LENGTH, SCALE, NULLABLE, ORDINAL_POSITION, IS_NULLABLE, SS_IS_IDENTITY FROM @mssqljdbc_temp_sp_columns_result ORDER BY TABLE_NAME, ORDINAL_POSITION\nDECLARE @t1 TABLE (a int); DECLARE @t2 TABLE (b varchar(5)); INSERT INTO @t1 VALUES (1), (2); INSERT INTO @t2 SELECT 'x' + CAST(a AS varchar) FROM @t1; SELECT b FROM @t2 ORDER BY b\nDECLARE @t1 TABLE (a int); INSERT INTO @t1 VALUES (7); SELECT a FROM @t1\nsp_executesql N'SELECT 1 AS x'\nIF @@TRANCOUNT = 0 BEGIN BEGIN TRAN IF @@TRANCOUNT = 2 COMMIT TRAN END SAVE TRAN [sp1]\nSELECT @@TRANCOUNT\nROLLBACK TRAN [sp1]\nROLLBACK\nSELECT CONVERT(smallint, CAST(1 AS bit)), CONVERT(int, CAST(0 AS bit)), CAST(CAST(1 AS bit) AS bigint)\nINSERT INTO md_parent (id, code, note) VALUES (1, 'a', 'n1'), (2, 'b', 'n2'), (3, 'c', 'n3')\nSET ROWCOUNT 2; SELECT id FROM md_parent UNION ALL SELECT id FROM md_parent ORDER BY id; SET ROWCOUNT 0\nSELECT COUNT(*) FROM md_parent\nMERGE md_parent AS t USING (SELECT 1 AS id, 'a' AS code) AS s ON t.id = s.id AND t.code = s.code WHEN MATCHED THEN DELETE;\nSELECT id FROM md_parent ORDER BY id\nSELECT 1 FROM FROM\nSELECT 1 +\nSELECT * FROM no_such_table\nSELECT no_such FROM md_parent"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() + ": " + e.msg }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(32), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
