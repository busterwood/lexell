// expect: PKTABLE_QUALIFIER,PKTABLE_OWNER,PKTABLE_NAME,PKCOLUMN_NAME,FKTABLE_QUALIFIER,FKTABLE_OWNER,FKTABLE_NAME,FKCOLUMN_NAME,KEY_SEQ,UPDATE_RULE,DELETE_RULE,FK_NAME,PK_NAME,DEFERRABILITY: 'lexdb'|'dbo'|'md_parent'|'id'|'lexdb'|'dbo'|'md_child'|'pid'|1|1|1|'md_child_fk'|'md_parent_pk'|7;'lexdb'|'dbo'|'md_parent'|'code'|'lexdb'|'dbo'|'md_child'|'pcode'|2|1|1|'md_child_fk'|'md_parent_pk'|7
// expect: TABLE_QUALIFIER,TABLE_OWNER,TABLE_NAME,NON_UNIQUE,INDEX_QUALIFIER,INDEX_NAME,TYPE,SEQ_IN_INDEX,COLUMN_NAME,COLLATION,CARDINALITY,PAGES,FILTER_CONDITION: 'lexdb'|'dbo'|'md_parent'|NULL|NULL|NULL|0|NULL|NULL|NULL|0|0|NULL;'lexdb'|'dbo'|'md_parent'|0|'md_parent'|'md_parent_pk'|1|1|'id'|'A'|0|0|NULL;'lexdb'|'dbo'|'md_parent'|0|'md_parent'|'md_parent_pk'|1|2|'code'|'A'|0|0|NULL;'lexdb'|'dbo'|'md_parent'|0|'md_parent'|'md_parent_ix'|3|1|'note'|'A'|NULL|NULL|NULL
