import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table t (id int primary key, v int)\ninsert into t values (1, 10), (2, 20)\ncreate function f1(a int, b int default 5) returns int language sql as $$ select a + b $$\nselect f1(1), f1(1, 2)\nselect f1('3')\nselect f1()\nselect f1(1, 2, 3)\ncreate function f1(a int, b int default 5) returns int language sql as $$ select a * b $$\ncreate or replace function f1(a int, b int default 5) returns int language sql as $$ select a * b $$\nselect f1(3), f1(3, 4)\ncreate or replace function f1(a int, b int default 5) returns text language sql as $$ select a * b $$\ncreate or replace function f1(x int, b int default 5) returns int language sql as $$ select x * b $$\ncreate or replace procedure f1(a int, b int default 5) language sql as $$ select 1 $$\ncreate function g(a text) returns text language foo as $$ x $$\ncreate function g(a text) returns text language sql as $$ select from from $$\ncreate function g(a int) returns int language sql as $$ insert into t values (a, a) $$\ncreate function g(a int) returns text language sql as 'select upper($1::text) || ''!'''\nselect g(7), g(null)\ncreate function g(a text, b text) returns text language sql as $$ select a || b $$\nselect g('x', 'y'), g(7)\ncreate function neg(a int) returns int immutable strict language sql as 'select -a'\nselect neg(null), neg(3)\ncreate function t_count() returns int language sql as $$ select count(*)::int from t $$\nselect t_count()\ncreate function add_tax(price numeric, rate numeric default 0.2) returns numeric language sql as $$ select round(price * (1 + rate), 2) $$\nselect id, add_tax(v), add_tax(v, 0.5) from t order by id\nselect id from t where add_tax(v) > 15 order by id\nselect id, f1(id) + f1(v, 1) from t order by id\nupdate t set v = f1(v, 2) where id = 1\nselect * from t order by id\ninsert into t values (3, f1(4, 5))\nselect * from t order by id\ncreate schema s1\ncreate function s1.h(a int) returns int language sql as 'select a + 100'\nselect s1.h(3)\nselect h(3)\nset search_path = s1, public\nselect h(4)\nreset search_path\ncreate function dup() returns int language sql as 'select 1'\ncreate function dup() returns int language sql as 'select 2'\ncreate function ret_one() returns int language sql return 5\ncreate function atomic1(a int) returns int language sql begin atomic select a + 1; end\nselect ret_one(), atomic1(4)\ncreate procedure p0() language sql as $$ select 1 $$\ncall p0()\ncall p0(1)\ncall nope()\ncreate procedure ins(a int) language sql as $$ insert into t values (a, a); insert into t values (a + 1, a + 1) $$\ncall ins(20)\nselect * from t order by id\ncall ins(1)\nselect id from t where id in (1, 20, 21) order by id\ncall ins('x')\ncall ins()\ncall ins(1, 2)\ncall ins(a => 30)\nselect id from t where id >= 30 order by id\ncreate procedure outp(a int, out c int, b int default 5) language sql as $$ select a + b $$\ncreate procedure outp(a int, b int default 5, out c int) language sql as $$ select a + b $$\ncall outp(1, null)\ncall outp(1)\ncreate procedure io(inout a int, in b int) language sql as $$ select a + b $$\ncall io(1, 2)\ncall io(b => 2, a => 5)\ncreate procedure fails() language sql as $$ insert into t values (500, 1); select 1 / 0 $$\ncall fails()\nselect count(*) from t where id = 500\nbegin\ncall ins(40)\nselect id from t where id >= 40 order by id\nrollback\nselect count(*) from t where id >= 40\ncall f1(1)\nselect p0()\ndrop function p0\ndrop procedure f1(int, int)\ndrop function f1(int, int)\ndrop function f1(int, int)\ndrop function if exists f1(int, int)\ndrop function f1\ndrop function g\ndrop function g(text)\ndrop function g(text, text)\ndrop procedure p0\ndrop procedure p0\ndrop procedure if exists p0\ndrop function nope(int)\ndrop function if exists nope\ndrop procedure if exists nope()\ndrop routine ins\ndrop routine ins(int)\nselect proname, prokind, pronargs, pronargdefaults, prorettype::regtype, proargnames, proargmodes, prolang, pronamespace::regnamespace from pg_proc where oid > 16384 order by proname, oid\ncreate function cnt_above(x int) returns int language sql as $$ select count(*)::int from t where id > x $$\nselect cnt_above(1), cnt_above(0) + 1\nselect cnt_above(null)\ncreate function twice(a int) returns int language sql as 'select cnt_above(a) * 2'\nselect twice(0)\ncreate function big(a int) returns bigint language sql as 'select a::bigint * 1000000000'\nselect big(5)\ncreate function vc(a varchar(5), b numeric(10, 2)) returns varchar(3) language sql as 'select a || b::text'\nselect vc('abcdefgh', 1.234)\ncreate function dflt_expr(a int, b int default 2 + 3) returns int language sql as 'select a * b'\nselect dflt_expr(2), dflt_expr(2, 3)\ncreate function flags(a int) returns int language sql immutable parallel safe cost 10 as 'select a + 1'\nselect flags(1)\ncreate function sql_up(a text) returns text language 'sql' security invoker as $body$ select upper(a) $body$\nselect sql_up('xy')\ncreate procedure p_atomic(a int) language sql begin atomic insert into t values (a, a); insert into t values (a + 1000, a); end\ncall p_atomic(70)\nselect id from t where id in (70, 1070) order by id\ncreate procedure outer_p(a int) language sql as $$ call p_atomic(a) $$\ncall outer_p(80)\nselect id from t where id in (80, 1080) order by id\ncreate procedure p_out(a int, inout b int) language sql as $$ select b + a $$\ncall p_out(1, 2)\ncreate schema s3\ncreate function s3.g3() returns int language sql as 'select 3'\nselect s3.g3()\ndrop schema s3\ndrop schema s3 cascade\ncreate schema s4\ncreate procedure s4.pp() language sql as 'select 1'\ncall s4.pp()\ncall s4.nope()\ndrop procedure s4.pp()\ndrop schema s4\ncreate function public.pf() returns int language sql as 'select 9'\nselect pf(), public.pf()\nselect proname, prokind, pronargs, prosrc from pg_proc where proname in ('pf', 'cnt_above', 'p_atomic', 'sql_up') order by proname\nselect proname, proisstrict, provolatile from pg_proc where proname in ('neg', 'flags', 'cnt_above') order by proname\ncreate function bad_syntax() returns int language sql as 'select 1 +'\ncreate function bad_syntax2() returns int language sql as 'selec 1'\ncreate function no_body() returns int language sql\ncreate function no_ret() language sql as 'select 1'\ncreate function in_rt(a int) returns int language sql as 'select 1;'\nselect in_rt(1)\ncreate function empty_body() returns int language sql as ''\ncreate procedure empty_proc() language sql as ''\ncall empty_proc()\ncreate function p_named(first_n int, second_n int) returns int language sql as 'select first_n - second_n'\nselect p_named(10, 3)\ncreate function p_qual(a int) returns int language sql as 'select p_qual.a + 1'\nselect p_qual(1)"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" && r.tag != "CALL" { append(mut &rows, r.tag.clone()) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(123), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
