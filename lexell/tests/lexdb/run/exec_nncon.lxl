// lexdb_exec: PostgreSQL 18's NOT NULL constraints in the catalogs (design/lexdb-new-features.md P7, 8.4), checked against PostgreSQL 18 (generated by
// tests/lexdb/gen_pg.py from nncon_queries.txt): a pg_constraint row of contype n for each NOT NULL column (the name given, else table_column_not_null, a number
// after it where a constraint has the name), pg_get_constraintdef, the information_schema views, ADD [CONSTRAINT n] NOT NULL, ALTER COLUMN SET and DROP NOT NULL, DROP
// and RENAME CONSTRAINT of one, RENAME COLUMN and RENAME TO (the names stay), DROP COLUMN, primary keys, serial and identity columns, LIKE. Each answer: the columns'
// names and the rows, or the tag, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off and on (an "@tx" one in a transaction rolled back).
// expect: same: conname|contype|conkey|convalidated|conislocal|coninhcount|connoinherit|pg_get_constraintdef: b_nn|n|{2}|t|t|0|f|NOT NULL b;e_ck|c|{5}|t|t|0|f|CHECK ((e > 0));nt_a_not_null|n|{1}|t|t|0|f|NOT NULL a;nt_d_not_null|n|{4}|t|t|0|f|NOT NULL d;nt_pkey|p|{4}|t|t|0|t|PRIMARY KEY (d)
// expect: same: constraint_name|constraint_type|is_deferrable|initially_deferred|enforced: b_nn|CHECK|NO|NO|YES;e_ck|CHECK|NO|NO|YES;nt_a_not_null|CHECK|NO|NO|YES;nt_d_not_null|CHECK|NO|NO|YES;nt_pkey|PRIMARY KEY|NO|NO|YES
// expect: same: constraint_name|check_clause: b_nn|b IS NOT NULL;e_ck|(e > 0);nt_a_not_null|a IS NOT NULL;nt_d_not_null|d IS NOT NULL
// expect: same: table_name|column_name|constraint_name: nt|b|b_nn;nt|e|e_ck;nt|a|nt_a_not_null;nt|d|nt_d_not_null;nt|d|nt_pkey
// expect: same: constraint_name|table_name|column_name|ordinal_position: nt_pkey|nt|d|1
// expect: same: conname|contype|conkey: c_nn|n|{3};nt_a_not_null|n|{1};nt_b_not_null|n|{2}
// expect: same: conname: bb_nn;c_nn;nt_a_not_null
// expect: same: attname|attnotnull: a|t;b|f;c|f
// expect: same: conname|conkey: nt_b_not_null|{2}
// expect: same: conname|conkey: nt_a_not_null|{1};nt_c_not_null|{2}
// expect: same: conname: nt_a_not_null;nt_c_not_null
// expect: same: conname: nt2_a_not_null;nt_c_not_null
// expect: same: conname|conkey: nt_a_not_null|{1}
// expect: same: ERROR 42704
// expect: same: count: 1
// expect: same: ERROR 42710
// expect: same: ERROR 42710
// expect: same: ERROR 55000
// expect: same: ERROR 55000
// expect: same: conname: b_nn
// expect: same: ERROR 23502
// expect: same: conname|contype: nt3_x_not_null|n;nt3_x_not_null2|c;nt3_y_not_null|n
// expect: same: ERROR 42710
// expect: same: ERROR XX000
// expect: same: ERROR 42601
// expect: same: conname|contype|conkey: nt_x_nn|n|{1}
// expect: same: ERROR 42703
// expect: same: conname|contype: nt_id_not_null|n;nt_pkey|p;nt_v_not_null|n
// expect: same: conname|contype: nt_id_not_null|n;nt_v_not_null|n
// expect: same: ERROR 42P16
// expect: same: ERROR 42P16
// expect: same: conname|contype|conkey: nt_a_not_null|n|{1};nt_b_not_null|n|{2};nt_pkey|p|{1,2}
// expect: same: conname|contype: nt_a_key|u;nt_a_not_null|n;nt_b_key|u
// expect: same: conname|contype: nt_a_not_null|n;nt_b_not_null|n;nt_c_not_null|n;nt_d_not_null|n
// expect: same: conname|conkey: c_nn|{2};nt_a_not_null|{1};nt_d_not_null|{3};nt_e_not_null|{4};nt_pkey|{1}
// expect: same: conname|contype: nt_g_not_null|n;nt_pkey|p
// expect: same: conname|contype: nt_g_not_null|n
// expect: same: conname|contype: nt_a_not_null|c;nt_a_not_null1|n
// expect: same: conname|pg_get_constraintdef|pg_get_constraintdef|conrelid|contype|convalidated|conenforced|connoinherit|condeferrable|condeferred: nt_a_not_null|NOT NULL a|NOT NULL a|nt|n|t|t|f|f|f
// expect: same: constraint_name|check_clause: M9_A b_not_null|A b IS NOT NULL
// expect: same: conname|connamespace: nt_a_not_null|s1
// expect: same: conname: nt_a_not_null
// expect: same: count: 0
// expect: same: count: 0
// expect: same: conname: nt_a_not_null;nt_b_not_null
// expect: same: count: 0
// expect: same: ERROR 23502
// expect: same: count: 0
// expect: same: attname|attnotnull: a|t
// expect: same: conkey|?column?|?column?|contypid|conindid|conparentid|confrelid: {1}|t|t|0|0|0|0
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@tx create table nt (a int not null, b int constraint b_nn not null, c text, d int primary key, e int, constraint e_ck check (e > 0)); select conname, contype, conkey, convalidated, conislocal, coninhcount, connoinherit, pg_get_constraintdef(oid) from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a int not null, b int constraint b_nn not null, c text, d int primary key, e int, constraint e_ck check (e > 0)); select constraint_name, constraint_type, is_deferrable, initially_deferred, enforced from information_schema.table_constraints where table_name = 'nt' order by constraint_name\n@tx create table nt (a int not null, b int constraint b_nn not null, c text, d int primary key, e int, constraint e_ck check (e > 0)); select constraint_name, check_clause from information_schema.check_constraints where constraint_name in ('nt_a_not_null', 'b_nn', 'e_ck', 'nt_d_not_null') order by 1\n@tx create table nt (a int not null, b int constraint b_nn not null, c text, d int primary key, e int, constraint e_ck check (e > 0)); select table_name, column_name, constraint_name from information_schema.constraint_column_usage where table_name = 'nt' order by 3, 2\n@tx create table nt (a int not null, b int constraint b_nn not null, c text, d int primary key, e int); select constraint_name, table_name, column_name, ordinal_position from information_schema.key_column_usage where table_name = 'nt' order by 3\n@tx create table nt (a int not null, b int, c int); alter table nt alter column b set not null; alter table nt add constraint c_nn not null c; select conname, contype, conkey from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a int not null, b int constraint b_nn not null, c int); alter table nt add constraint c_nn not null c; alter table nt rename constraint b_nn to bb_nn; select conname from pg_constraint where conrelid = 'nt'::regclass and contype = 'n' order by conname\n@tx create table nt (a int not null, b int constraint b_nn not null, c int); alter table nt drop constraint b_nn; select conname from pg_constraint where conrelid = 'nt'::regclass and contype = 'n' order by conname; select attname, attnotnull from pg_attribute where attrelid = 'nt'::regclass and attnum > 0 order by attnum\n@tx create table nt (a int not null, b int not null); alter table nt alter column a drop not null; select conname, conkey from pg_constraint where conrelid = 'nt'::regclass and contype = 'n' order by conname\n@tx create table nt (a int not null, c text not null); alter table nt rename column c to cc; select conname, conkey from pg_constraint where conrelid = 'nt'::regclass and contype = 'n' order by conname\n@tx create table nt (a int not null, c text not null); alter table nt rename to nt2; select conname from pg_constraint where conrelid = 'nt2'::regclass and contype = 'n' order by conname\n@tx create table nt (a int not null, c text not null); alter table nt rename to nt2; alter table nt2 alter column a drop not null; alter table nt2 alter column a set not null; select conname from pg_constraint where conrelid = 'nt2'::regclass and contype = 'n' order by conname\n@tx create table nt (a int not null, c text not null, d int); alter table nt drop column c; select conname, conkey from pg_constraint where conrelid = 'nt'::regclass and contype = 'n' order by conname\n@tx create table nt (a int not null); alter table nt drop constraint nosuch_nn\n@tx create table nt (a int not null); alter table nt drop constraint if exists nosuch_nn; select count(*) from pg_constraint where conrelid = 'nt'::regclass\n@tx create table nt (a int not null, b int check (b > 0)); alter table nt rename constraint nt_a_not_null to nt_b_check\n@tx create table nt (a int not null, b int); alter table nt add constraint nt_a_not_null check (b > 0)\n@tx create table nt (a int not null, b int); alter table nt add constraint a_nn2 not null a\n@tx create table nt (a int, b int); alter table nt add constraint b_nn not null b; alter table nt add constraint b_nn3 not null b\n@tx create table nt (a int, b int); alter table nt add constraint b_nn not null b; alter table nt alter column b set not null; select conname from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a int, b int); insert into nt values (1, null); alter table nt add constraint bn not null b\n@tx create table nt3 (x int not null, y int not null, constraint nt3_x_not_null2 check (x > 0)); select conname, contype from pg_constraint where conrelid = 'nt3'::regclass order by conname\n@tx create table nt (x int constraint dup not null, y int constraint dup not null)\n@tx create table nt (x int constraint n1 not null constraint n2 not null)\n@tx create table nt (x int, constraint nt_x_nn not null x, constraint nt_y not null x)\n@tx create table nt (x int, constraint nt_x_nn not null x); select conname, contype, conkey from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (x int, constraint nt_x_nn not null y)\n@tx create table nt (id int primary key, v int not null); select conname, contype from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (id int primary key, v int not null); alter table nt drop constraint nt_pkey; select conname, contype from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (id int primary key, v int not null); alter table nt drop constraint nt_id_not_null\n@tx create table nt (id int primary key, v int not null); alter table nt alter column id drop not null\n@tx create table nt (a int, b int, primary key (a, b)); select conname, contype, conkey from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a int unique not null, b int unique); select conname, contype from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a serial, b bigserial, c int generated by default as identity, d int generated always as identity); select conname, contype from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a int primary key); alter table nt add column c int constraint c_nn not null default 0; alter table nt add column d int not null default 0; alter table nt add column e serial; select conname, conkey from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a int); alter table nt add column g int primary key default 1; select conname, contype from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a int); alter table nt add column g int primary key default 1; alter table nt drop constraint nt_pkey; select conname, contype from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a int); alter table nt add constraint nt_a_not_null check (a > 0); alter table nt alter column a set not null; select conname, contype from pg_constraint where conrelid = 'nt'::regclass order by conname\n@tx create table nt (a int not null); select conname, pg_get_constraintdef(oid), pg_get_constraintdef(oid, true), conrelid::regclass, contype, convalidated, conenforced, connoinherit, condeferrable, condeferred from pg_constraint where conrelid = 'nt'::regclass\n@tx create table \"M9\" (\"A b\" int not null); select conname from pg_constraint where conrelid = '\"M9\"'::regclass; select pg_get_constraintdef(oid) from pg_constraint where conrelid = '\"M9\"'::regclass; select constraint_name, check_clause from information_schema.check_constraints where constraint_name like 'M9%'\n@tx create schema s1; create table s1.nt (a int not null); select conname, connamespace::regnamespace from pg_constraint where conrelid = 's1.nt'::regclass\n@tx create temp table nt (a int not null); select conname from pg_constraint where conrelid = 'nt'::regclass\n@tx create table nt (a int not null); create view v1 as select * from nt; select count(*) from pg_constraint where conrelid = 'v1'::regclass\n@tx create table nt (a int not null); create table nt3 as select * from nt; select count(*) from pg_constraint where conrelid = 'nt3'::regclass\n@tx create table nt (a int not null, b int not null); alter table nt rename column a to aa; alter table nt rename to nt2; select conname from pg_constraint where conrelid = 'nt2'::regclass order by 1\n@tx create table nt (a int not null); drop table nt; select count(*) from pg_constraint where conname like 'nt%'\n@tx create table nt (a int not null); insert into nt values (1); insert into nt values (null)\n@tx create table nt (a int not null); select count(*) from pg_constraint where contype = 'n' and conrelid = 'nt'::regclass; select count(*) from pg_constraint where contype in ('c', 'f', 'p', 'u') and conrelid = 'nt'::regclass\n@tx create table nt (a int not null); select a.attname, a.attnotnull from pg_attribute a where attrelid = 'nt'::regclass and attnum > 0 order by attnum\n@tx create table nt (a int not null); select conkey, confkey is null, conbin is null, contypid, conindid, conparentid, confrelid from pg_constraint where conrelid = 'nt'::regclass"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(173), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
