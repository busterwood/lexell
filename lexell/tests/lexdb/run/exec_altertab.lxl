import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table p (a int, b text, c int, l text)\ninsert into p values (3, 'z', 30, null), (1, 'x', 10, 'short'), (2, 'y', 20, repeat('long', 900)), (4, 'w4', 40, null)\ncreate index p_c on p (c)\ncreate unique index p_b on p (b)\ncreate index p_lower on p (lower(b)) where c > 10\ncreate view pv as select a, b from p where c > 10\nalter table p add primary key (a)\nselect a, b, c, length(l) from p order by a\nselect a from pv order by a\nselect a from p where c = 20\nselect a from p where b = 'z'\nselect a from p where lower(b) = 'y' and c > 10\nselect c from p where a = 3\ninsert into p values (1, 'dup', 0, '')\ninsert into p values (null, 'n', 0, '')\ninsert into p values (5, 'e', 50, '')\nupdate p set a = 6 where a = 5\nselect a, c from p where a > 4\nselect conname, contype, conkey from pg_constraint where conrelid = 'p'::regclass and contype <> 'n' order by 1\nselect indexrelid::regclass, indisprimary, indisunique, indkey from pg_index where indrelid = 'p'::regclass order by 1\nselect constraint_name, constraint_type from information_schema.table_constraints where table_name = 'p' and constraint_type <> 'CHECK' order by 1\nselect constraint_name, column_name, ordinal_position from information_schema.key_column_usage where table_name = 'p' order by 1, 3\nselect attname, attnum, attnotnull from pg_attribute where attrelid = 'p'::regclass and attnum > 0 order by attnum\nselect indexname, indexdef from pg_indexes where tablename = 'p' order by 1\nSELECT a.attname, pg_catalog.format_type(a.atttypid, a.atttypmod), (SELECT pg_catalog.pg_get_expr(d.adbin, d.adrelid, true) FROM pg_catalog.pg_attrdef d WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum AND a.atthasdef), a.attnotnull, (SELECT c.collname FROM pg_catalog.pg_collation c, pg_catalog.pg_type t WHERE c.oid = a.attcollation AND t.oid = a.atttypid AND a.attcollation <> t.typcollation) AS attcollation, a.attidentity, a.attgenerated FROM pg_catalog.pg_attribute a WHERE a.attrelid = 'p'::regclass AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum\nSELECT c2.relname, i.indisprimary, i.indisunique, i.indisclustered, i.indisvalid, pg_catalog.pg_get_indexdef(i.indexrelid, 0, true), pg_catalog.pg_get_constraintdef(con.oid, true), contype, condeferrable, condeferred, i.indisreplident, c2.reltablespace, con.conperiod FROM pg_catalog.pg_class c, pg_catalog.pg_class c2, pg_catalog.pg_index i LEFT JOIN pg_catalog.pg_constraint con ON (conrelid = i.indrelid AND conindid = i.indexrelid AND contype IN ('p','u','x')) WHERE c.oid = 'p'::regclass AND c.oid = i.indrelid AND i.indexrelid = c2.oid ORDER BY i.indisprimary DESC, c2.relname\nSELECT r.conname, pg_catalog.pg_get_constraintdef(r.oid, true) FROM pg_catalog.pg_constraint r WHERE r.conrelid = 'p'::regclass AND r.contype = 'c' ORDER BY 1\nSELECT true as sametable, conname, pg_catalog.pg_get_constraintdef(r.oid, true) as condef, conrelid::pg_catalog.regclass AS ontable FROM pg_catalog.pg_constraint r WHERE r.conrelid = 'p'::regclass AND r.contype = 'f' AND conparentid = 0 ORDER BY conname\nSELECT conname, conrelid::pg_catalog.regclass AS ontable, pg_catalog.pg_get_constraintdef(oid, true) AS condef FROM pg_catalog.pg_constraint c WHERE confrelid IN (SELECT pg_catalog.pg_partition_ancestors('p'::regclass) UNION ALL VALUES ('p'::pg_catalog.regclass)) AND contype = 'f' AND conparentid = 0 ORDER BY conname\ncreate table ch (id int primary key, pa int references p (a))\ninsert into ch values (1, 2)\ninsert into ch values (2, 9)\nalter table p drop constraint p_pkey\nalter table p drop constraint p_pkey cascade\ninsert into ch values (3, 9)\nselect conname from pg_constraint where conrelid = 'ch'::regclass and contype <> 'n' order by 1\nselect attname, attnotnull from pg_attribute where attrelid = 'p'::regclass and attnum > 0 order by attnum\nselect conname from pg_constraint where conrelid = 'p'::regclass and contype = 'p'\nSELECT a.attname, pg_catalog.format_type(a.atttypid, a.atttypmod), (SELECT pg_catalog.pg_get_expr(d.adbin, d.adrelid, true) FROM pg_catalog.pg_attrdef d WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum AND a.atthasdef), a.attnotnull, (SELECT c.collname FROM pg_catalog.pg_collation c, pg_catalog.pg_type t WHERE c.oid = a.attcollation AND t.oid = a.atttypid AND a.attcollation <> t.typcollation) AS attcollation, a.attidentity, a.attgenerated FROM pg_catalog.pg_attribute a WHERE a.attrelid = 'p'::regclass AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum\nSELECT c2.relname, i.indisprimary, i.indisunique, i.indisclustered, i.indisvalid, pg_catalog.pg_get_indexdef(i.indexrelid, 0, true), pg_catalog.pg_get_constraintdef(con.oid, true), contype, condeferrable, condeferred, i.indisreplident, c2.reltablespace, con.conperiod FROM pg_catalog.pg_class c, pg_catalog.pg_class c2, pg_catalog.pg_index i LEFT JOIN pg_catalog.pg_constraint con ON (conrelid = i.indrelid AND conindid = i.indexrelid AND contype IN ('p','u','x')) WHERE c.oid = 'p'::regclass AND c.oid = i.indrelid AND i.indexrelid = c2.oid ORDER BY i.indisprimary DESC, c2.relname\nSELECT r.conname, pg_catalog.pg_get_constraintdef(r.oid, true) FROM pg_catalog.pg_constraint r WHERE r.conrelid = 'p'::regclass AND r.contype = 'c' ORDER BY 1\nSELECT true as sametable, conname, pg_catalog.pg_get_constraintdef(r.oid, true) as condef, conrelid::pg_catalog.regclass AS ontable FROM pg_catalog.pg_constraint r WHERE r.conrelid = 'p'::regclass AND r.contype = 'f' AND conparentid = 0 ORDER BY conname\nSELECT conname, conrelid::pg_catalog.regclass AS ontable, pg_catalog.pg_get_constraintdef(oid, true) AS condef FROM pg_catalog.pg_constraint c WHERE confrelid IN (SELECT pg_catalog.pg_partition_ancestors('p'::regclass) UNION ALL VALUES ('p'::pg_catalog.regclass)) AND contype = 'f' AND conparentid = 0 ORDER BY conname\ninsert into p values (1, 'w', 0, '')\nselect a, b from p where a = 1 order by b\nselect a from p where c = 30\ndelete from p where b = 'w'\nalter table p add constraint p_pk primary key (b, a)\nselect a, c from p