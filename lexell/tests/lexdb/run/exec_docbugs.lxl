// lexdb_exec: the bugs the user documentation found in the PostgreSQL door (KNOWN-ISSUES.md, the bug-fix slice): an INSERT ... SELECT, UPDATE and MERGE
// into a table with a foreign key and a CHECK that a row fails part way (23514, not 23505: the rows before the failing one were written twice; 23503
// for a parent missing at the end), DROP COLUMN dropping the CHECKs that read the column (one column or several), and a column constraint written NOT
// VALID with NOT ENFORCED either side (42601; a table constraint takes both). Checked against PostgreSQL 18 (generated by tests/lexdb/gen_pg.py from
// docbugs_queries.txt). Each answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off
// and on (an "@once" one once).
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: CREATE TABLE
// expect: same: ERROR 23514
// expect: same: n: 0
// expect: INSERT 0 3000
// expect: same: n: 3000
// expect: same: ERROR 23514
// expect: same: n: 3000
// expect: same: ERROR 23503
// expect: same: n: 3000
// expect: same: ERROR 23514
// expect: same: n: 0
// expect: same: ERROR 23514
// expect: same: n|lo: 3000|1
// expect: same: ERROR 23514
// expect: same: n: 0
// expect: same: ERROR 23514
// expect: same: n: 3000
// expect: CREATE TABLE
// expect: same: ERROR 23514
// expect: same: n: 0
// expect: CREATE TABLE
// expect: same: conname: ck3;dc1_c_check;dc1_check
// expect: ALTER TABLE
// expect: same: conname: dc1_check
// expect: ALTER TABLE
// expect: same: conname: 
// expect: INSERT 0 1
// expect: same: b: -5
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: CREATE TABLE
// expect: CREATE TABLE
// expect: same: conname|convalidated|conenforced: x|f|f;x|f|f
// expect: ALTER TABLE
// expect: same: n: 2
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table p9 (id int primary key)\n@once insert into p9 values (1), (2)\n@once create table c9 (id int primary key, pid int references p9 (id), v int check (v > 0))\ninsert into c9 select i + 100, 1, 2000 - i from generate_series(1, 3000) i\nselect count(*) as n from c9\n@once insert into c9 select i, 1, 5 from generate_series(1, 3000) i\nselect count(*) as n from c9\ninsert into c9 select i + 10000, 1, 2000 - i from generate_series(1, 3000) i\nselect count(*) as n from c9\ninsert into c9 select i + 10000, 1, 5 from generate_series(1, 2000) i union all select 20000, 3, 5\nselect count(*) as n from c9\nupdate c9 set pid = 2, v = 2000 - id\nselect count(*) as n from c9 where pid = 2\nupdate c9 set id = id + 5000, v = 2000 - id\nselect count(*) as n, min(id) as lo from c9\nmerge into c9 t using (select i as id from generate_series(1, 3000) i) s on t.id = s.id when matched then update set v = 2000 - t.id, pid = 2\nselect count(*) as n from c9 where pid = 2\nmerge into c9 t using (select i + 3000 as id from generate_series(1, 3000) i) s on t.id = s.id when not matched then insert values (s.id, 1, 3500 - s.id)\nselect count(*) as n from c9\n@once create table c9b (id int primary key, v int check (v > 0))\ninsert into c9b select i + 100, 2000 - i from generate_series(1, 3000) i\nselect count(*) as n from c9b\n@once create table dc1 (a int, b int, c int check (c > 0), check (a < b), constraint ck3 check (b + c > 0))\nselect conname from pg_constraint where conrelid = 'dc1'::regclass order by conname\n@once alter table dc1 drop column c\nselect conname from pg_constraint where conrelid = 'dc1'::regclass order by conname\n@once alter table dc1 drop column a\nselect conname from pg_constraint where conrelid = 'dc1'::regclass order by conname\n@once insert into dc1 values (-5)\nselect b from dc1\ncreate table nv1 (id int, v int constraint x check (v > 0) not valid not enforced)\ncreate table nv2 (id int, v int constraint x check (v > 0) not enforced not valid)\ncreate table nv3 (id int, v int check (v > 0) not valid)\ncreate table nv4 (id int primary key, v int references p9 (id) not valid)\ncreate table nv5 (id int primary key, v int references p9 (id) not enforced not valid)\n@once create table nv6 (id int, v int, constraint x check (v > 0) not valid not enforced)\n@once create table nv7 (id int, v int, constraint x check (v > 0) not enforced not valid)\nselect conname, convalidated, conenforced from pg_constraint where conrelid in ('nv6'::regclass, 'nv7'::regclass) order by conrelid, conname\n@once alter table nv6 add column w int check (w > 0)\nselect count(*) as n from pg_constraint where conrelid = 'nv6'::regclass"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(170), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
