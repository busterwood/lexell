import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table t1 (n number, s varchar2(10), d date)\ninsert into t1 values (2, 'abc', date '2020-01-01')\ninsert into t1 values (3, 'hello', null)\ncreate table lg (k varchar2(5), v number)\ncreate or replace package pko as function sq(x varchar2) return number; function sq(x number) return number; function sq(x date) return number; function sq(x number, y number) return number; procedure pr(x number); procedure pr(x varchar2); function amb(x number) return number; function amb(y number) return number; function cv(x number) return number; function cv(x date) return number; end;\ncreate or replace package body pko as function sq(x varchar2) return number is begin return length(x); end; function sq(x number) return number is begin return x * x; end; function sq(x date) return number is begin return 7; end; function sq(x number, y number) return number is begin return x * y; end; procedure pr(x number) is begin insert into lg values ('n', x); end; procedure pr(x varchar2) is begin insert into lg values ('v', length(x)); end; function amb(x number) return number is begin return 1; end; function amb(y number) return number is begin return 2; end; function cv(x number) return number is begin return 10; end; function cv(x date) return number is begin return 20; end; end;\ncreate or replace package pk2 as function tw(x number) return number; function tw(x varchar2) return varchar2; function dd(x date) return number; function dd(x number, y number default 5) return number; function sq(x number) return number; function sq(x varchar2) return number; end;\ncreate or replace package body pk2 as function priv(x number) return number; function priv(x varchar2) return number; function tw(x number) return number is begin return x * 2; end; function tw(x varchar2) return varchar2 is begin return x || x; end; function dd(x date) return number is begin return 1; end; function dd(x number, y number default 5) return number is begin return x + y; end; function sq(x number) return number is begin return x * x + priv('a') + priv(1); end; function sq(x varchar2) return number is begin return length(x) + sq(2); end; function priv(x number) return number is begin return 100; end; function priv(x varchar2) return number is begin return 200; end; end;\ncreate or replace function sf(x number, y number := 10) return number is begin return x * 100 + y; end;\ncreate or replace function usepk(n number, s varchar2) return number is begin return pk2.tw(n) * 10 + pk2.sq(s); end;\ncreate or replace package pe as function sq(x number) return number; function sq(y number) return number; end;\ncreate or replace package body pe as function sq(x number) return number is begin return 1; end; function sq(y number) return number is begin return 2; end; end;\ncreate or replace function e1(n number) return number is function sq(x number) return number is begin return x * x; end; begin return sq(1, 2); end;\ncreate or replace function e2(n number) return number is function sq(x number) return number is begin return x * x; end; function sq(y number) return number is begin return y; end; begin return 1 + sq(1); end;\ncreate or replace function e3(n number) return number is r number; function sq(x number) return number is begin return x * x; end; begin select sq(3) into r from dual; return r; end;\ncreate or replace function e4(n number) return number is begin return pe.sq(1); end;\ncreate or replace function e5(n number) return number is begin return 1 + pe.sq(1, 2); end;\ncreate or replace procedure e6 is begin pe.nosuch(1); end;\ncreate or replace function e7(n number) return number is function sq(x number) return number is begin return x * x; end; begin return sq(x => 1, x => 2); end;\ncreate view v1 as select n, pko.sq(n) a, pko.sq(s) b, pk2.tw(s) c from t1\ncreate table t2 (a number, b number)\ninsert into t2 select pko.sq(n), pko.sq(s) from t1"

const QS = "select pko.sq(4) a from dual\nselect pko.sq('abc') a from dual\nselect pko.sq(date '2020-01-01') a from dual\nselect pko.sq(sysdate) a from dual\nselect pko.sq(4, 5) a from dual\nselect pko.sq(n) a, pko.sq(s) b, pko.sq(d) c, pko.sq(n, n) e from t1 order by n\nselect n from t1 where pko.sq(n) = 9\nselect n from t1 where pko.sq(s) = 3\nselect pko.sq(x => 3) a from dual\nselect pko.sq(x => 'abcd') a from dual\nselect pko.sq(y => 2, x => 3) a from dual\nselect pko.sq(null) a from dual\nselect pko.amb(1) a from dual\nselect pko.amb(x => 1) a from dual\nselect pko.amb(y => 1) a, pko.amb(x => 1) b from dual\nselect pko.cv('5') a from dual\nselect pko.cv(s) a from t1\nselect pko.cv(d) a from t1 order by n\nselect pko.sq(1, 2, 3) a from dual\nselect pko.sq(n || '') a from t1 order by n\nselect pko.sq(n + 1) a from t1 order by n\nselect * from v1 order by n\nselect n from v1 where b = 5\nselect * from t2 order by a\nselect pk2.tw(n) a, pk2.tw(s) b from t1 order by n\nselect pk2.tw(to_char(n)) a from t1 order by n\nselect pk2.tw(substr(s, 1, 2)) a from t1 order by n\nselect pk2.tw(length(s)) a from t1 order by n\nselect pk2.tw(case when n = 2 then 'x' else 'y' end) a from t1 order by n\nselect pk2.tw(case when n = 2 then 7 else 8 end) a from t1 order by n\nselect pk2.tw(coalesce(s, 'q')) a from t1 order by n\nselect n from t1 where pk2.tw(n) = 6\nselect n from t1 where pk2.tw(s) = 'abcabc'\nselect s, count(*) c from t1 group by s having pk2.tw(s) = 'abcabc'\nselect n, pk2.tw(n) a from t1 order by pk2.tw(s)\nselect pk2.dd(date '2020-01-01') a, pk2.dd(1) b, pk2.dd(1, 2) c from dual\nselect pk2.dd(d) a from t1 order by n\nselect pk2.sq(4) a, pk2.sq('abc') b, pk2.sq(pk2.sq(1)) c from dual\nselect usepk(1, 'ab') a from dual\nselect sf(x => 1) a from dual\nselect sf(y => 2, x => 1) a from dual\nselect sf(1, y => 3) a from dual\nselect sf(n, y => n) a from t1 order by n\nselect sf(z => 1) a from dual\ninsert into t2 select pk2.tw(n), pk2.sq(s) from t1 ;; select a, b from t2 order by a\nupdate t1 set n = pk2.tw(n) where pk2.tw(s) = 'abcabc' ;; select n from t1 order by n\ndelete from t1 where pko.sq(s) = 3 ;; select count(*) c from t1\ndeclare r number; function sq(x number) return number is begin return x * x; end; begin r := sq(1, 2); end;\ndeclare r number; function sq(x number) return number is begin return x * x; end; begin r := 1 + sq('a', 2); end;\ndeclare r number; function sq(x number) return number is begin return x * x; end; function sq(y number) return number is begin return y; end; begin r := sq(3); end;\ndeclare r number; function sq(x number) return number is begin return x * x; end; begin select sq(3) into r from dual; end;\ndeclare r number; procedure pr(x number) is begin null; end; begin pr(1, 2); end;\ndeclare r number; procedure pr(x number) is begin null; end; procedure pr(y number) is begin null; end; begin pr(1); end;\ndeclare r number; procedure pr(x number) is begin null; end; begin pr(z => 1); end;\ndeclare r number; function sq(x number) return number is begin return x * x; end; begin r := sq(x => 1, x => 2); end;\ndeclare r number; function sq(x number, y number) return number is begin return x * x; end; begin r := sq(y => 1); end;\ndeclare r number; begin r := pe.sq(1); end;\ndeclare r number; begin r := 1 + pe.sq(1, 2); end;\ndeclare r number; begin r := pe.sq(z => 1); end;\nselect name, line, position, text from user_errors where name in ('E1', 'E2', 'E3', 'E4', 'E5', 'E6', 'E7') order by name, sequence\nbegin pko.pr(1); pko.pr('xyz'); pko.pr(x => 2); end; ;; select k, v from lg order by k, v\nbegin pko.pr(n => 1); end;\ndeclare a number; b varchar2(20); begin a := pk2.tw(3); b := pk2.tw('ab'); insert into lg values (b, a); end; ;; select k, v from lg\ndeclare a number; begin a := pko.sq(4) * 1000 + pko.sq('ab') * 100 + pko.sq(sysdate) * 10 + pko.sq(2, 3); insert into lg values ('r', a); end; ;; select k, v from lg\ndeclare a number; begin a := pk2.dd(date '2020-01-01'); insert into lg values ('d', a); a := pk2.dd(x => 3); insert into lg values ('e', a); a := pk2.dd(3, y => 4); insert into lg values ('f', a); end; ;; select k, v from lg order by k\ndeclare a number; begin select pko.sq(s) into a from t1 where n = 3; insert into lg values ('s', a); end; ;; select k, v from lg\ndeclare a number; begin a := pko.amb(1); end;\ndeclare a number; begin a := pko.amb(y => 1); insert into lg values ('a', a); end; ;; select k, v from lg\ndeclare a number; begin a := pko.sq(1, 2, 3); end;\ndeclare a number; begin a := pko.cv('5'); end;"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(160), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
