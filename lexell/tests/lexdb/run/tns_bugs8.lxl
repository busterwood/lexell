// expect: same: NAME,LINE,POSITION,TEXT = 'E1'|1|117|'PLS-00306: wrong number or types of arguments in call to ''SQ''';'E1'|1|110|'PL/SQL: Statement ignored';'E2'|1|181|'PLS-00307: too many declarations of ''SQ'' match this call';'E2'|1|170|'PL/SQL: Statement ignored';'E3'|1|127|'PLS-00231: function ''SQ'' may not be used in SQL';'E3'|1|127|'PL/SQL: ORA-03066: invalid PL/SQL expression';'E3'|1|120|'PL/SQL: SQL Statement ignored';'E4'|1|53|'PLS-00307: too many declarations of ''SQ'' match this call';'E4'|1|46|'PL/SQL: Statement ignored';'E5'|1|57|'PLS-00306: wrong number or types of arguments in call to ''SQ''';'E5'|1|46|'PL/SQL: Statement ignored';'E6'|1|26|'PLS-00302: component ''NOSUCH'' must be declared';'E6'|1|23|'PL/SQL: Statement ignored';'E7'|1|117|'PLS-00703: multiple instances of named argument in list';'E7'|1|110|'PL/SQL: Statement ignored'
// expect: same: 0 / K,V = 'n'|1;'n'|2;'v'|3
