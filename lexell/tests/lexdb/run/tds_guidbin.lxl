// lexdb over TDS: a uniqueidentifier converted to and from binary and varbinary (SQL Server's layout: the first three groups little-endian; it was
// error 529 after the hex-literal slice), to a string in upper case, and OBJECTPROPERTY's TableHasNonclustIndex, checked against SQL Server 2022
// (generated by tests/lexdb/gen_mssql.py guidbin from mssql_guidbin_queries.txt). Each batch runs with SET lexdb_batch off and on; each expect line:
// "same: " and the batch's result sets and counts, or its error number.
// expect: same: a,b,c,d: x'33221100554477668899aabbccddeeff'|x'33221100554477668899aabbccddeeff00000000'|x'33221100'|x'33221100554477668899aabbccddeeff'
// expect: same: a,b,c: x'33221100554477668899aabbccddeeff'|x'0403020106050807090a0b0c0d0e0f10'|NULL
// expect: same: a,b,c: 16|16|16
// expect: same: a,b,c: '00112233-4455-6677-8899-AABBCCDDEEFF'|'00002233-0000-0000-0000-000000000000'|x'33221100554477668899aabbccddeeff'
// expect: same: a,b: '00112233-4455-6677-8899-AABBCCDDEEFF'|x'00112233445566778899aabbccddeeff'
// expect: same: a,b,d: '00112233-4455-6677-8899-AABBCCDDEEFF'|'AABBCCDD-EEFF-0011-2233-445566778899'|'00112233-4455-6677-8899-AABBCCDDEEFF'
// expect: same: error 8170
// expect: same: a,b: x'33221100554477668899aabbccddeeff01'|1
// expect: ok
// expect: (2)
// expect: same: (2) / k,v: '00112233-4455-6677-8899-AABBCCDDEEFF'|x'33221100554477668899aabbccddeeff';'FFEEDDCC-BBAA-9988-7766-554433221100'|x'ccddeeffaabb88997766554433221100'
// expect: same: u: '00112233-4455-6677-8899-AABBCCDDEEFF';'FFEEDDCC-BBAA-9988-7766-554433221100'
// expect: ok
// expect: ok
// expect: ok
// expect: ok
// expect: ok
// expect: ok
// expect: same: t,n,c,i: 'h1'|1|1|1;'h2'|0|1|1;'h3'|0|0|0;'h4'|1|0|1;'h5'|1|0|1
// expect: same: a,b: NULL|NULL
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "SELECT CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS varbinary(16)) AS a, CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS binary(20)) AS b, CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS varbinary(4)) AS c, CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS varbinary(max)) AS d\nSELECT CONVERT(varbinary(16), CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier)) AS a, CONVERT(binary(16), CAST('01020304-0506-0708-090A-0B0C0D0E0F10' AS uniqueidentifier)) AS b, CAST(CAST(NULL AS uniqueidentifier) AS varbinary(16)) AS c\nSELECT LEN(CAST(NEWID() AS varbinary(16))) AS a, DATALENGTH(CAST(NEWID() AS varbinary(16))) AS b, DATALENGTH(CAST(NEWID() AS binary(16))) AS c\nSELECT CAST(0x33221100554477668899AABBCCDDEEFF AS uniqueidentifier) AS a, CAST(0x3322 AS uniqueidentifier) AS b, CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS varbinary(16)) AS c\nSELECT CAST(CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS varbinary(16)) AS uniqueidentifier) AS a, CAST(CAST(0x00112233445566778899AABBCCDDEEFF AS uniqueidentifier) AS varbinary(16)) AS b\nSELECT CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS varchar(40)) AS a, CAST(CAST('aabbccdd-eeff-0011-2233-445566778899' AS uniqueidentifier) AS nvarchar(40)) AS b, CONVERT(varchar(36), CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier)) AS d\nSELECT CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS varchar(8)) AS a\nSELECT CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS varbinary(16)) + 0x01 AS a, CASE WHEN CAST(CAST('00112233-4455-6677-8899-AABBCCDDEEFF' AS uniqueidentifier) AS varbinary(16)) = 0x33221100554477668899AABBCCDDEEFF THEN 1 ELSE 0 END AS b\n@once CREATE TABLE gb (k uniqueidentifier PRIMARY KEY, v varbinary(16))\n@once INSERT INTO gb VALUES ('00112233-4455-6677-8899-AABBCCDDEEFF', NULL), ('FFEEDDCC-BBAA-9988-7766-554433221100', NULL)\nUPDATE gb SET v = CAST(k AS varbinary(16)); SELECT CAST(k AS varchar(40)) AS k, v FROM gb ORDER BY k\nSELECT CAST(v AS uniqueidentifier) AS u FROM gb ORDER BY v\n@once CREATE TABLE h1 (a int PRIMARY KEY, b int UNIQUE)\n@once CREATE TABLE h2 (a int PRIMARY KEY)\n@once CREATE TABLE h3 (a int)\n@once CREATE TABLE h4 (a int)\n@once CREATE INDEX ix4 ON h4 (a)\n@once CREATE TABLE h5 (a int PRIMARY KEY NONCLUSTERED)\nSELECT 'h1' AS t, OBJECTPROPERTY(OBJECT_ID('h1'), 'TableHasNonclustIndex') AS n, OBJECTPROPERTY(OBJECT_ID('h1'), 'TableHasClustIndex') AS c, OBJECTPROPERTY(OBJECT_ID('h1'), 'TableHasIndex') AS i UNION ALL SELECT 'h2', OBJECTPROPERTY(OBJECT_ID('h2'), 'TableHasNonclustIndex'), OBJECTPROPERTY(OBJECT_ID('h2'), 'TableHasClustIndex'), OBJECTPROPERTY(OBJECT_ID('h2'), 'TableHasIndex') UNION ALL SELECT 'h3', OBJECTPROPERTY(OBJECT_ID('h3'), 'TableHasNonclustIndex'), OBJECTPROPERTY(OBJECT_ID('h3'), 'TableHasClustIndex'), OBJECTPROPERTY(OBJECT_ID('h3'), 'TableHasIndex') UNION ALL SELECT 'h4', OBJECTPROPERTY(OBJECT_ID('h4'), 'TableHasNonclustIndex'), OBJECTPROPERTY(OBJECT_ID('h4'), 'TableHasClustIndex'), OBJECTPROPERTY(OBJECT_ID('h4'), 'TableHasIndex') UNION ALL SELECT 'h5', OBJECTPROPERTY(OBJECT_ID('h5'), 'TableHasNonclustIndex'), OBJECTPROPERTY(OBJECT_ID('h5'), 'TableHasClustIndex'), OBJECTPROPERTY(OBJECT_ID('h5'), 'TableHasIndex')\nSELECT OBJECTPROPERTY(OBJECT_ID('ghost'), 'TableHasNonclustIndex') AS a, OBJECTPROPERTY(OBJECT_ID('sys.objects'), 'TableHasNonclustIndex') AS b"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(57), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
