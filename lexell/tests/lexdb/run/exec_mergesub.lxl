// lexdb_exec: MERGE's subqueries read the rows as the statement found them, not as its own earlier rows left them, checked against
// PostgreSQL 19 (generated by tests/lexdb/gen_pg.py from mergesub_queries.txt): in UPDATE's SET, a WHEN condition, DELETE, INSERT's values
// and RETURNING, correlated and not, a source that is the target, NULLs, an empty and a duplicate source, text keys, an error in a later row.
// Each answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off and on (an
// "@once" one once, an "@tx" one in a transaction rolled back).
// expect: CREATE TABLE
// expect: INSERT 0 4
// expect: CREATE TABLE
// expect: INSERT 0 3
// expect: same: id|salary: 1|100;2|101;3|201;4|301
// expect: same: id|salary: 2|101;3|201;4|301
// expect: same: id|salary: 1|1000;2|1000;3|1000;4|1000
// expect: same: id|salary: 1|103;2|202;3|301;4|400
// expect: same: id|salary: 1|100;2|100;3|200;4|300
// expect: same: id|salary: 1|404;2|404;3|300;4|400
// expect: same: id|salary: 1|100;2|1200;3|1300;4|400
// expect: same: id|salary: 1|100
// expect: same: id|salary: 1|100;4|0
// expect: same: id|salary: 1|100;2|200;3|4;4|4;5|4
// expect: same: id|salary: 1|100;2|200;3|300;4|400;5|4;6|4;7|4
// expect: same: id|mgr_id|salary: 1||100;2|1|200;3|2|300;4|3|400;5|4|1000;6|4|1000;7|4|1000
// expect: same: id|salary: 1|4;2|200;3|300;4|400;5|4;7|4
// expect: same: id|salary: 1|100;2|200;3|300;4|400;5|4;6|4;7|4
// expect: same: id|salary: 1|100;2|4;3|300;4|400;5|4;6|4;7|4
// expect: same: id|c: 5|4;6|4;7|4
// expect: same: id|salary|c: 2|0|1;3|0|2;4|0|3
// expect: same: id|c: 2|3;3|2;4|1
// expect: same: id|salary|c: 5|1|4;6|1|4;7|1|4
// expect: same: id|salary|c: 2|201|0;3|301|0;4|401|0
// expect: same: id|c: 2|4;3|4
// expect: same: id|c|act: 3|4|DELETE;5|4|INSERT
// expect: same: id|salary: 1|;2|100;3|300;4|400
// expect: same: MERGE 0
// expect: same: id|salary: 1|100;2|4;3|300;4|4;99|4
// expect: same: ERROR 21000
// expect: same: ERROR 21000
// expect: same: k|v: a|6;b|6;c|3;z|3
// expect: same: k|v: b|2;c|3
// expect: same: ERROR 22012
// expect: same: ERROR 22012
// expect: same: ERROR 23505
// expect: same: ERROR 23505
// expect: same: id|salary: 5|4;6|4
// expect: same: ERROR 21000
// expect: same: MERGE 1
// expect: same: id|salary: 1|100;2|202;3|303;4|400
// expect: same: id|salary: 2|0;6|9
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table emp (id int primary key, mgr_id int, salary int)\n@once insert into emp values (1, null, 100), (2, 1, 200), (3, 2, 300), (4, 3, 400)\n@once create table tk (k text primary key, v int)\n@once insert into tk values ('a', 1), ('b', 2), ('c', 3)\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched then update set salary = (select x.salary + 1 from emp x where x.id = e.mgr_id); select id, salary from emp order by id\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched then update set salary = (select x.salary + 1 from emp x where x.id = e.mgr_id) returning e.id, e.salary\n@tx merge into emp e using (select id from emp) s on e.id = s.id when matched then update set salary = (select sum(salary) from emp); select id, salary from emp order by id\n@tx merge into emp e using (values (1), (2), (3), (4)) s(id) on e.id = s.id when matched then update set salary = salary + (select count(*) from emp x where x.salary > e.salary); select id, salary from emp order by id\n@tx merge into emp e using emp s on e.id = s.id + 1 when matched then update set salary = (select x.salary from emp x where x.id = s.id); select id, salary from emp order by id\n@tx merge into emp e using (select id, (select max(salary) from emp) m from emp where id < 3) s on e.id = s.id when matched then update set salary = s.m + (select count(*) from emp); select id, salary from emp order by id\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched and (select x.salary from emp x where x.id = e.mgr_id) < 300 then update set salary = salary + 1000; select id, salary from emp order by id\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched and e.salary > (select min(salary) from emp) then delete; select id, salary from emp order by id\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched and exists (select 1 from emp x where x.mgr_id = e.id) then delete when matched and (select count(*) from emp) > 3 then update set salary = 0; select id, salary from emp order by id\n@tx merge into emp e using (values (2), (3), (4), (5)) s(id) on e.id = s.id when matched and e.salary > 250 then update set salary = (select count(*) from emp) when not matched and (select count(*) from emp) < 5 then insert (id, salary) values (s.id, (select count(*) from emp)); select id, salary from emp order by id\n@tx merge into emp e using (values (5), (6), (7)) s(id) on e.id = s.id when not matched then insert (id, salary) values (s.id, (select count(*) from emp)); select id, salary from emp order by id\n@tx merge into emp e using (values (5), (6), (7)) s(id) on e.id = s.id when not matched then insert (id, mgr_id, salary) values (s.id, (select max(id) from emp), (select sum(salary) from emp)); select id, mgr_id, salary from emp order by id\n@tx merge into emp e using (values (5), (1), (7)) s(id) on e.id = s.id when matched then update set salary = (select count(*) from emp) when not matched then insert (id, salary) values (s.id, (select count(*) from emp)); select id, salary from emp order by id\n@tx merge into emp e using (values (5), (6), (7)) s(id) on e.id = s.id when not matched then insert (id, salary) values (s.id, (select count(*) from emp x where x.id < s.id)); select id, salary from emp order by id\n@tx merge into emp e using (values (5), (6), (7), (2)) s(id) on e.id = s.id when matched then update set salary = (select count(*) from emp x where x.id <= s.id + 3) when not matched then insert (id, salary) values (s.id, (select count(*) from emp x where x.id <= s.id)); select id, salary from emp order by id\n@tx merge into emp e using (values (5), (6), (7)) s(id) on e.id = s.id when not matched then insert (id, salary) values (s.id, 1) returning e.id, (select count(*) from emp x where x.id <= e.id) as c\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched then update set salary = 0 returning e.id, e.salary, (select count(*) from emp x where x.salary = 0 or x.id < e.id) as c\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched then delete returning e.id, (select count(*) from emp x where x.id >= e.id) as c\n@tx merge into emp e using (values (5), (6), (7)) s(id) on e.id = s.id when not matched then insert (id, salary) values (s.id, 1) returning e.id, e.salary, (select count(*) from emp) as c\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched then update set salary = salary + 1 returning e.id, e.salary, (select count(*) from emp x where x.salary = 201) as c\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched and exists (select 1 from emp x where x.mgr_id = e.id) then delete returning e.id, (select count(*) from emp) as c\n@tx merge into emp e using (values (3), (5)) s(id) on e.id = s.id when matched then delete when not matched then insert (id, salary) values (s.id, 0) returning e.id, (select count(*) from emp) as c, merge_action() as act\n@tx merge into emp e using (values (1), (2)) s(id) on e.id = s.id when matched then update set salary = (select x.salary from emp x where x.id = e.mgr_id); select id, salary from emp order by id\n@tx merge into emp e using (select 1 where false) s(id) on e.id = s.id when matched then update set salary = (select count(*) from emp) when not matched then insert (id) values (s.id)\n@tx merge into emp e using (values (2), (null), (4)) s(id) on e.id = s.id when matched then update set salary = (select count(*) from emp) when not matched then insert (id, salary) values (coalesce(s.id, 99), (select count(*) from emp)); select id, salary from emp order by id\n@tx merge into emp e using (values (2), (2)) s(id) on e.id = s.id when matched then update set salary = (select count(*) from emp)\n@tx merge into emp e using (values (2), (2)) s(id) on e.id = s.id when matched then delete returning e.id, (select count(*) from emp)\n@tx merge into tk t using (values ('a'), ('b'), ('z')) s(k) on t.k = s.k when matched then update set v = (select sum(v) from tk) when not matched then insert (k, v) values (s.k, (select count(*) from tk)); select k, v from tk order by k\n@tx merge into tk t using (values ('a'), ('c')) s(k) on t.k = s.k when matched and (select max(v) from tk x where x.k <> t.k) > 2 then delete; select k, v from tk order by k\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched then update set salary = (select 1 / (x.salary - 300) from emp x where x.id = e.id)\n@tx merge into emp e using (values (2), (3), (4)) s(id) on e.id = s.id when matched and (select 1 / (x.salary - 300) from emp x where x.id = e.id) > 0 then delete\n@tx merge into emp e using (values (5), (5)) s(id) on e.id = s.id when not matched then insert (id, salary) values (s.id, (select count(*) from emp))\n@tx merge into emp e using (values (2), (3)) s(id) on e.id = s.id when matched then update set id = e.id + (select count(*) from emp x where x.id = 4)\n@tx merge into emp e using (values (5), (6)) s(id) on e.id = s.id when not matched then insert (id, salary) values (s.id, (select count(*) from emp)) returning e.id, e.salary\n@tx merge into emp e using (values (2)) s(id) on e.id = s.id when matched then update set salary = (select salary from emp where id > 1)\n@tx merge into emp e using (values (2)) s(id) on e.id = s.id when matched then update set salary = (select salary from emp where id > 5)\n@tx merge into emp e using (values (2), (3)) s(id) on e.id = s.id when matched then update set salary = e.salary + s.id; select id, salary from emp order by id\n@tx merge into emp e using (values (2), (6)) s(id) on e.id = s.id when matched then update set salary = 0 when not matched then insert (id, salary) values (s.id, 9) returning e.id, e.salary"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(162), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
