import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_ops"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            var out: []str = []
            for r in rs {
                for row in r.rows {
                    var vs: []str = []
                    for k in 0..len(row) { append(mut &vs, if lexdb_ops.isNull(&row[k]) { "NULL" } else { s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 }) }) }
                    append(mut &out, strings.join(&vs, "|"))
                }
            }
            return strings.join(&out, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// each statement with the row engine and with batches, in a transaction rolled back
fn two(s: mut &lexdb_exec.Session, label: &str, sql: &str) {
    let x = q(s, &"set lexdb_batch = off")
    let b0 = q(s, &"begin")
    let off = q(s, sql)
    let r0 = q(s, &"rollback")
    let y = q(s, &"set lexdb_batch = on")
    let b1 = q(s, &"begin")
    let on = q(s, sql)
    let r1 = q(s, &"rollback")
    println(label + ": " + on + ", same: " + (off == on).toStr())
}

const SETUP = "create table f1 (b0 date, b1 bool)\ncreate table f2 (c0 bigint primary key, c1 text, c2 int)\ninsert into f1 values ('2024-02-29', false), ('2024-01-09', false)\ninsert into f2 values (29, 'b', 8), (35, 'a_c', 2)\ncreate table wl1 (id int, b0 date, b1 bool)\ninsert into wl1 values (1, '2024-02-29', false), (2, '2024-01-09', false), (3, '2024-01-09', false), (4, null, true)\ncreate table wl2 (c0 bigint primary key, c1 text, c2 int)\ninsert into wl2 values (29, 'b', 8), (35, 'a_c', 2), (16, 'z', -1), (39, 'B', 0)\ncreate table wl3 (id int, k int, v int, t text)\ninsert into wl3 values (1, 1, 10, 'x'), (2, 1, 20, 'y'), (3, 2, 5, 'x'), (4, 2, 5, 'x'), (5, 3, null, null), (6, 2, null, 'y')\ncreate table we (x int)\ncreate table n0 (a1 bigint)\ninsert into n0 values (9223372036854775807), (0), (null), (-2), (3), (-9223372036854775807)\ncreate table n1 (id int, a numeric, b numeric, i int, d numeric(10,3))\ninsert into n1 values (1, 1.5, 3, 7, 2.500), (2, -10, 0.0003, -3, 0.001), (3, 0, 7.00, 0, null), (4, 123456789.123, -0.5, 2, 1.000), (5, null, 2, null, 3.333), (6, 1, 33554432, 33554432, 0.000), (7, 2.25, 2.25, 9, -7.125)\ncreate table ne (a numeric, i int)"

const QS = "W3 doc, the numbers by partition\tselect q12.c0, q1.b0, row_number() over (partition by q12.c0, l2.x10 order by q1.b0, q1.b1, l2.x10, l2.x11, q12.c0, q12.c1, q12.c2) as x14 from f1 as q1 cross join lateral (select 'a' as x10, 1.5 as x11 from (select 1.5 as x8 from f1 as q4) as d3) as l2, f2 as q12 order by 1, 2, 3\nW3 doc, both windows by peers\tselect c0, b0, count(*), min(x14), max(x14), min(x13), max(x13), sum(x13) from (select q12.c0, q1.b0, sum(1.5) over (partition by q1.b0, q12.c2 order by q1.b0, q1.b1, l2.x10, l2.x11, q12.c0, q12.c1, q12.c2 rows between 1 preceding and current row) as x13, row_number() over (partition by q12.c0, l2.x10 order by q1.b0, q1.b1, l2.x10, l2.x11, q12.c0, q12.c1, q12.c2) as x14 from f1 as q1 cross join lateral (select 'a' as x10, 1.5 as x11 from (select 1.5 as x8 from f1 as q4) as d3) as l2, f2 as q12) z group by c0, b0 order by 1, 2\nW3 row_number, rank, dense_rank\tselect q1.id, l.id, row_number() over (partition by q1.b1 order by q1.id, l.id), rank() over (partition by q1.b1 order by l.k), dense_rank() over (partition by q1.b1 order by l.k desc) from wl1 q1 cross join lateral (select id, k, v, t from wl3 where wl3.k <= q1.id) l order by 1, 2\nW3 by the outer row\tselect q1.id, l.id, row_number() over (partition by q1.id order by l.v nulls first, l.id), rank() over (partition by q1.id order by l.v), dense_rank() over (partition by q1.b0 order by l.t) from wl1 q1 cross join lateral (select id, k, v, t from wl3 where wl3.k <= q1.id) l order by 1, 2\nW3 lag and lead\tselect q1.id, l.id, lag(l.v) over (partition by q1.id order by l.id), lead(l.v, 1, -1) over (partition by q1.id order by l.id), lag(l.v, 2) over (order by q1.id, l.id), lead(l.t) over (partition by l.k order by q1.id, l.id) from wl1 q1 cross join lateral (select id, k, v, t from wl3 where wl3.k <= q1.id) l order by 1, 2\nW3 running sums\tselect q1.id, l.id, sum(l.v) over (partition by q1.id order by l.id), sum(l.v) over (partition by q1.id order by l.id rows between 1 preceding and current row), sum(l.v) over (order by q1.id, l.id rows between unbounded preceding and current row), sum(l.v) over (partition by q1.b0 order by l.k), count(*) over (partition by q1.b0), avg(l.v) over (partition by l.k) from wl1 q1 cross join lateral (select id, k, v, t from wl3 where wl3.k <= q1.id) l order by 1, 2\nW3 ntile\tselect q1.id, l.id, ntile(2) over (partition by q1.b1 order by q1.id, l.id), ntile(3) over (order by l.id, q1.id), ntile(4) over (partition by q1.id order by l.id) from wl1 q1 cross join lateral (select id, k, v, t from wl3 where wl3.k <= q1.id) l order by 1, 2\nW3 first_value, min, max\tselect q1.id, l.id, first_value(l.v) over (partition by q1.id order by l.id), first_value(l.t) over (partition by l.k order by q1.id desc, l.id), min(l.v) over (partition by q1.id order by l.id), max(l.t) over (partition by q1.b0) from wl1 q1 cross join lateral (select id, k, v, t from wl3 where wl3.k <= q1.id) l order by 1, 2\nW3 a comma after the LATERAL\tselect q1.id, l.id, q12.c0, row_number() over (partition by q12.c0 order by q1.id, l.id), rank() over (partition by q12.c0, l.k order by q1.id), sum(q12.c2) over (partition by q1.id, l.id) from wl1 q1 cross join lateral (select id, k from wl3 where wl3.k < q1.id) l, wl2 q12 order by 3, 1, 2\nW3 identical rows\tselect q1.b0, l.v, row_number() over (partition by q1.b0 order by l.v) from wl1 q1 cross join lateral (select v from wl3 where k = 2 and v is not null) l order by 1, 2, 3\nW3 identical rows, two windows by peers\tselect b0, v, count(*), min(r), max(r), sum(s) from (select q1.b0, l.v, row_number() over (partition by q1.b0 order by l.v) as r, sum(l.v) over (partition by l.v order by q1.b0 rows between 1 preceding and current row) as s from wl1 q1 cross join lateral (select v from wl3 where k = 2 and v is not null) l) z group by b0, v order by 1, 2\nW3 a window inside the LATERAL\tselect q1.id, l.v, l.r, row_number() over (partition by l.r order by q1.id, l.v) from wl1 q1 cross join lateral (select v, row_number() over (order by id) as r from wl3 where k <= q1.id) l order by 1, 3\nW3 LEFT JOIN LATERAL, no rows\tselect q1.id, l.x, row_number() over (partition by l.x order by q1.id), rank() over (order by l.x nulls first) from wl1 q1 left join lateral (select x from we where we.x = q1.id) l on true order by 1\nW3 empty LATERAL\tselect q1.id, row_number() over (order by q1.id) from wl1 q1 cross join lateral (select x from we where we.x = q1.id) l\nW3 empty outer\tselect l.id, row_number() over (order by l.id) from we cross join lateral (select id from wl3 where wl3.k = we.x) l\nW3 text keys\tselect l.t, q1.id, l.id, row_number() over (partition by l.t order by q1.id, l.id), dense_rank() over (order by l.t nulls first) from wl1 q1 cross join lateral (select id, k, v, t from wl3 where wl3.k <= q1.id) l order by 1 nulls first, 2, 3\nW4 doc\tselect (1.5 / nullif(q3.a1, 0)) as x4 from n0 as q3 order by a1 nulls first\nW4 numeric / bigint\tselect a1, 10.25 / nullif(a1, 0), a1 / 3.0, a1 / 7.000, a1 / 0.5 from n0 order by 1\nW4 numeric / numeric\tselect id, a / nullif(b, 0), b / nullif(a, 0) from n1 order by id\nW4 numeric / int\tselect id, a / nullif(i, 0), i / nullif(a, 0), d / nullif(i, 0), i / nullif(d, 0) from n1 order by id\nW4 int / int\tselect id, i / 2, i / nullif(i, 0) from n1 order by id\nW4 casts\tselect id, cast(a as numeric(20,4)) / nullif(cast(i as numeric(12,1)), 0), cast(i as numeric) / 3, i::numeric / 7, cast(a / nullif(b, 0) as numeric(30,10)) from n1 order by id\nW4 nullif\tselect id, a / nullif(d, 0), nullif(a, 0) / nullif(d, 0.000), nullif(d, 0) / nullif(a, 0), nullif(i, 7) / nullif(d, 0) from n1 order by id\nW4 ties round half away\tselect 1 / 33554432.0, -1 / 33554432::numeric, 5 / 2.0, 0.5 / 3, 1 / 32.0\nW4 zero dividend\tselect 0 / 7.00, 0.000 / 3, 0 / -0.5, 0.0 / 33554432\nW4 big quotients\tselect 123456789012345678901234567890.5 / 3, 1e20 / 3, 7 / 0.0001, 99999999999999999999 / 0.01\nW4 small quotients\tselect 1e-30 / 1e30, 0.0001 / 7, 1 / 9999.0, 9999 / 10000.0, 1 / 10000.0, 1 / 100000000.0\nW4 more than 38 places at PostgreSQL's scale\tselect a1, round(1.5 / (1.5 / nullif(a1, 0)), 6), round(a1 / 0.00000000000000001, 1) from n0 where a1 > 1 order by 1\nW4 w0-0421, a quotient of a quotient\tselect 1.5 as x16 from (select 1 as x12 from (select 1 as x9 from n0 as q5 where (1 <= (1.5 / nullif((1.5 / nullif(q5.a1, 0)), 0)))) as d4) as d1\nW4 in expressions\tselect id, (a + 1) / nullif(b * 2, 0), 100.00 * a / nullif(b, 0), round(a / nullif(b, 0), 2), -a / nullif(b, 0) from n1 order by id\nW4 WHERE and ORDER BY\tselect id from n1 where a / nullif(b, 0) > 0.4 order by a / nullif(b, 0), id\nW4 avg\tselect avg(a), avg(b), avg(i), avg(d) from n1\nW4 avg by group\tselect i % 2, avg(d), avg(a), count(*) from n1 group by 1 order by 1\nW4 avg, empty\tselect avg(a), sum(a) / count(*), avg(i) from ne\nW4 variance, stddev\tselect variance(d), stddev(d), var_pop(i), stddev_pop(i), variance(a), stddev(b), var_samp(b) from n1\nW4 variance of equal values\tselect variance(v), stddev(v), variance(cast(v as numeric(6,2))), stddev_pop(cast(v as numeric(6,2))) from wl3 where k = 2 and v is not null\nW4 window avg\tselect id, avg(d) over (order by id rows between 1 preceding and current row), avg(a) over (), avg(b) over (partition by i % 2) from n1 order by id\nW4 division by zero\tselect id, a / i from n1 order by id\nW4 division by zero, no rows\tselect a / (i - i) from n1 where id = 99\nW4 a NULL divisor\tselect id, 2.5 / (case when id = 5 then null else 1 end) from n1 order by id\nW4 floats stay floats\tselect 1.5 / 2::float8, 3 / 2.0::float8, 1 / 33554432::float8\nW4 an untyped literal\tselect 1.5 / '4', '1' / 3.0"

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let setup: str = SETUP
    for l in strings.lines(&setup) {
        let o = q(mut &s, &l)
        if strings.startsWith(&o, "ERROR") { println(l + ": " + o) }
    }
    let qs: str = QS
    for l in strings.lines(&qs) {
        let parts = strings.split(&l, "\t")
        two(mut &s, &parts[0], &parts[1])
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(97), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 4 * 1024 * 1024, ckptBytes: 2 * 1024 * 1024,
                                                           snapNodes: 100000}, body).unwrap()
}
