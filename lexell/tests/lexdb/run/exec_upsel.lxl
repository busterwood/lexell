// lexdb_exec: INSERT ... ON CONFLICT DO SELECT (design/lexdb-new-features.md P1, PostgreSQL 19): the row there returned as it
// is, a new row as inserted, WHERE over the row there and EXCLUDED, FOR UPDATE, NO KEY UPDATE, SHARE and KEY SHARE, a conflict
// column, a unique text key and a constraint's name, RETURNING old.* and new.* (both the row there), a row met twice and one the
// statement inserted, INSERT ... SELECT of 3,000 rows, an error in a later row (22012), 23505 on another key; 42601 without
// RETURNING or a conflict target, 42P01 for EXCLUDED in RETURNING, 42702, 42P10, 42601 for NOWAIT and OF. Checked against
// PostgreSQL 19 (generated by tests/lexdb/gen_pg.py from upsel_queries.txt). Each answer: the columns' names and the rows, or
// the tag, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off and on, an "@tx" one in a transaction rolled back.
// expect: CREATE TABLE
// expect: INSERT 0 3
// expect: CREATE TABLE
// expect: INSERT 0 3000
// expect: same: id|k|v: 1|a|10
// expect: same: id|k|v: 4|c|30
// expect: same: id|k|v: 1|a|10;4|d|40
// expect: same: id|k|v: 
// expect: same: id|k|v: 2|b|20
// expect: same: id|k|v: 2|b|20
// expect: same: id|v: 3|
// expect: same: id|k: 2|b
// expect: same: id|k|v: 1|a|10
// expect: same: id|k|v: 1|a|10
// expect: same: id|k|v: 1|a|10
// expect: same: id|k|v: 1|a|10
// expect: same: id|k|v: 1|a|10
// expect: same: id|k|v|id|k|v: 1|a|10|1|a|10
// expect: same: id|id|v|v: |9||99
// expect: same: id|k|v: 1|a|10;1|a|10
// expect: same: id|k|v: 6|x|1;6|x|1
// expect: same: id|k|v: 1|a|10
// expect: same: id|k|v: 1|a|10;2|b|20;3||;4|n4|4;5|n5|5
// expect: same: id|g|s: 2992|3|s2992;2999|3|s2999;3001|0|new;3002|0|new;3003|0|new;3004|0|new;3005|0|new;3006|0|new;3007|0|new;3008|0|new;3009|0|new;3010|0|new
// expect: same: id|s: 1000|s1000;2000|s2000;3000|s3000
// expect: same: ERROR 23505
// expect: same: ERROR 22012
// expect: same: ERROR 22012
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: ERROR 42P01
// expect: same: ERROR 42702
// expect: same: ERROR 42P10
// expect: same: ERROR 42601
// expect: same: ERROR 42601
// expect: same: id|k|v: 1|a|10;2|b|20;3||
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table u (id int primary key, k text unique, v int)\n@once insert into u values (1, 'a', 10), (2, 'b', 20), (3, null, null)\n@once create table ub (id int primary key, g int, s text)\n@once insert into ub select i, i % 7, 's' || i from generate_series(1, 3000) i\n@tx insert into u values (1, 'z', 99) on conflict (id) do select returning *\n@tx insert into u values (4, 'c', 30) on conflict (id) do select returning *\n@tx insert into u values (1, 'z', 99), (4, 'd', 40) on conflict (id) do select returning id, k, v\n@tx insert into u values (1, 'z', 99) on conflict (id) do select where u.v > 10 returning *\n@tx insert into u values (2, 'z', 99) on conflict (id) do select where u.v > 10 returning *\n@tx insert into u values (2, 'z', 99) on conflict (id) do select where excluded.v > 10 returning *\n@tx insert into u values (3, 'z', 99) on conflict (id) do select where u.v is null returning id, v\n@tx insert into u as t values (2, 'z', 99) on conflict (id) do select where t.k = 'b' returning t.id, t.k\n@tx insert into u values (1, 'z', 99) on conflict (id) do select for update returning *\n@tx insert into u values (1, 'z', 99) on conflict (id) do select for no key update returning *\n@tx insert into u values (1, 'z', 99) on conflict (id) do select for share returning *\n@tx insert into u values (1, 'z', 99) on conflict (id) do select for key share where u.v > 0 returning *\n@tx insert into u values (9, 'a', 99) on conflict (k) do select returning *\n@tx insert into u values (9, 'a', 99) on conflict (k) do select returning old.*, new.*\n@tx insert into u values (9, 'q', 99) on conflict (k) do select returning old.id, new.id, old.v, new.v\n@tx insert into u values (1, 'z', 99), (1, 'y', 98) on conflict (id) do select returning *\n@tx insert into u values (6, 'x', 1), (6, 'y', 2) on conflict (id) do select returning *\n@tx insert into u select 1, 'q', 5 on conflict on constraint u_pkey do select returning *\n@tx insert into u select i, 'n' || i, i from generate_series(1, 5) i on conflict (id) do select returning id, k, v\n@tx insert into ub select i, 0, 'new' from generate_series(2990, 3010) i on conflict (id) do select where ub.g = 3 returning id, g, s\n@tx insert into ub select i, 0, 'x' from generate_series(1, 3000) i on conflict (id) do select where ub.id % 1000 = 0 returning id, s\n@tx insert into u values (5, 'a', 99) on conflict (id) do select returning *\n@tx insert into u values (1, 'z', 1 / 0) on conflict (id) do select returning *\n@tx insert into u values (1, 'z', 99) on conflict (id) do select where 1 / (u.v - 10) > 0 returning *\ninsert into u values (1, 'z', 99) on conflict (id) do select\ninsert into u values (1, 'z', 99) on conflict do select returning *\ninsert into u values (9, 'a', 99) on conflict (k) do select returning *, excluded.v\ninsert into u values (1, 'z', 99) on conflict (id) do select where v > 10 returning *\ninsert into u values (1, 'z', 99) on conflict (v) do select returning *\ninsert into u values (1, 'z', 99) on conflict (id) do select for update nowait returning *\ninsert into u values (1, 'z', 99) on conflict (id) do select for update of u returning *\nselect * from u order by id"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(153), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
