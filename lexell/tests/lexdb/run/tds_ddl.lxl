// lexdb over TDS: the DDL forms of design/lexdb-dialect-gaps.md package B, checked against SQL Server 2022
// (generated by tests/lexdb/gen_mssql.py from mssql_ddl_queries.txt): CREATE OR ALTER VIEW and
// ALTER VIEW (a new definition of any shape, the definition kept as written), ALTER DATABASE ... SET
// (snapshot isolation), sp_rename of tables and columns (views over them breaking), ALTER COLUMN with
// a new type (rows cast, indexes and constraints kept, failing casts, rollback, a large table).
// Each expect line: a batch's result sets and counts, or its error number.
// expect: ok
// expect: (2)
// expect: ok
// expect: ok
// expect: id,v,w: 1|10|'a';2|20|'b'
// expect: ok
// expect: id: 1;2
// expect: ok
// expect: w: 'a';'b'
// expect: : 'CREATE   VIEW vv AS SELECT w FROM tv'
// expect: ok
// expect: a,b: 1|2
// expect: ok
// expect: : 'CREATE      VIEW v2 AS SELECT 1 AS a'
// expect: ok
// expect: : 'create   view v3 as select 1 as a'
// expect: ok
// expect: : 'CREATE /* c */   VIEW v4 AS SELECT 2 AS a'
// expect: error 2010
// expect: error 2714
// expect: ok
// expect: a,b: 3|4
// expect: : 'CREATE VIEW v2 AS SELECT 3 AS a, 4 AS b'
// expect: error 208
// expect: error 2010
// expect: error 102
// expect: ok
// expect: x,y: 1|2
// expect: ok
// expect: ok
// expect: error 207
// expect: q: 9
// expect: error 208
// expect: error 207
// expect: q: 9
// expect: error 156
// expect: error 102
// expect: error 102
// expect: ok
// expect: error 2010
// expect: ok
// expect: ok
// expect: q: 'tx'
// expect: ok
// expect: q: 9
// expect: ok
// expect: name: 'v2';'v3';'v4';'v6';'v7';'vnew';'vv'
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "CREATE TABLE tv (id int PRIMARY KEY, v int, w varchar(10))\nINSERT INTO tv VALUES (1, 10, 'a'), (2, 20, 'b')\nCREATE VIEW vv AS SELECT id, v FROM tv\nCREATE OR ALTER VIEW vv AS SELECT id, v, w FROM tv\nSELECT * FROM vv ORDER BY id\nCREATE OR ALTER VIEW vnew AS SELECT id FROM tv\nSELECT * FROM vnew ORDER BY id\nCREATE OR ALTER VIEW vv AS SELECT w FROM tv\nSELECT * FROM vv ORDER BY w\nSELECT OBJECT_DEFINITION(OBJECT_ID('vv'))\nCREATE OR ALTER VIEW vnew AS SELECT 1 AS a, 2 AS b\nSELECT * FROM vnew\nCREATE  OR  ALTER  VIEW v2 AS SELECT 1 AS a\nSELECT OBJECT_DEFINITION(OBJECT_ID('v2'))\ncreate or alter view v3 as select 1 as a\nSELECT OBJECT_DEFINITION(OBJECT_ID('v3'))\nCREATE /* c */ OR ALTER VIEW v4 AS SELECT 2 AS a\nSELECT OBJECT_DEFINITION(OBJECT_ID('v4'))\nCREATE OR ALTER VIEW tv AS SELECT 2 AS a\nCREATE VIEW v2 AS SELECT 3 AS a\nALTER VIEW v2 AS SELECT 3 AS a, 4 AS b\nSELECT * FROM v2\nSELECT OBJECT_DEFINITION(OBJECT_ID('v2'))\nALTER VIEW nothere AS SELECT 1 AS a\nALTER VIEW tv AS SELECT 1 AS a\nCREATE OR REPLACE VIEW v5 AS SELECT 1 AS a\nCREATE OR ALTER VIEW v6 (x, y) AS SELECT 1, 2\nSELECT * FROM v6\nCREATE OR ALTER VIEW v7 AS SELECT a FROM v2\nCREATE OR ALTER VIEW v2 AS SELECT 9 AS q\nSELECT * FROM v7\nSELECT * FROM v2\nCREATE OR ALTER VIEW v2 AS SELECT * FROM nothing_here\nCREATE OR ALTER VIEW v2 AS SELECT nothing FROM tv\nSELECT * FROM v2\nCREATE OR ALTER TABLE x (a int)\nCREATE OR ALTER SYNONYM s FOR tv\nCREATE OR ALTER\nCREATE TABLE ck (a int)\nCREATE OR ALTER VIEW ck AS SELECT 1 AS a\nBEGIN TRAN\nCREATE OR ALTER VIEW v2 AS SELECT 'tx' AS q\nSELECT * FROM v2\nROLLBACK\nSELECT * FROM v2\nCREATE OR ALTER VIEW v2 AS SELECT 1 AS q, 2 AS more\nSELECT name FROM sys.views WHERE name LIKE 'v%' ORDER BY name"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(37), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
