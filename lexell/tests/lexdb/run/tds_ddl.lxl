_id = OBJECT_ID('z1tvw') AND c.name = 'a'\nCREATE TABLE z1ttx (id int PRIMARY KEY, v int)\nINSERT INTO z1ttx VALUES (1, 1), (2, 2)\nBEGIN TRAN\nALTER TABLE z1ttx ALTER COLUMN v bigint\nINSERT INTO z1ttx VALUES (3, 9000000000)\nSELECT v FROM z1ttx ORDER BY id\nROLLBACK\nSELECT v FROM z1ttx ORDER BY id\nINSERT INTO z1ttx VALUES (3, 9000000000)\nBEGIN TRAN\nALTER TABLE z1ttx ALTER COLUMN v bigint\nINSERT INTO z1ttx VALUES (3, 9000000000)\nCOMMIT\nSELECT v FROM z1ttx ORDER BY id\nCREATE TABLE z1tfail (id int PRIMARY KEY, v varchar(10))\nINSERT INTO z1tfail VALUES (1, '1'), (2, '2'), (3, 'x'), (4, '4')\nALTER TABLE z1tfail ALTER COLUMN v int\nSELECT v FROM z1tfail ORDER BY id\nUPDATE z1tfail SET v = '3' WHERE id = 3\nALTER TABLE z1tfail ALTER COLUMN v int\nSELECT v FROM z1tfail ORDER BY id\nINSERT INTO z1tfail VALUES (5, 5)\nUPDATE z1tfail SET v = 2147483647 WHERE id = 1\nALTER TABLE z1tfail ALTER COLUMN v smallint\nALTER TABLE z1tfail ALTER COLUMN v bigint\nUPDATE z1tfail SET v = NULL WHERE id = 1\nALTER TABLE z1tfail ALTER COLUMN v smallint\nSELECT v FROM z1tfail ORDER BY id\nCREATE TABLE z1tbig (id int PRIMARY KEY, v int, s varchar(20))\nDECLARE @i int = 1; WHILE @i <= 3500 BEGIN INSERT INTO z1tbig VALUES (@i, @i, CAST(@i AS varchar(20))); SET @i = @i + 1 END\nSELECT COUNT(*), SUM(CAST(v AS bigint)), MIN(v), MAX(v) FROM z1tbig\nALTER TABLE z1tbig ALTER COLUMN v bigint\nSELECT COUNT(*), SUM(v), MIN(v), MAX(v) FROM z1tbig\nSELECT ty.name FROM sys.columns c JOIN sys.types ty ON ty.user_type_id = c.user_type_id WHERE c.object_id = OBJECT_ID('z1tbig') AND c.name = 'v'\nSELECT v FROM z1tbig WHERE v = 3333\nALTER TABLE z1tbig ALTER COLUMN s int\nSELECT COUNT(*), SUM(s) FROM z1tbig\nALTER TABLE z1tbig ALTER COLUMN s varchar(30)\nSELECT COUNT(*), SUM(LEN(s)) FROM z1tbig\nINSERT INTO z1tbig VALUES (3600, 3600, 'x')\nALTER TABLE z1tbig ALTER COLUMN s int\nSELECT COUNT(*), SUM(LEN(s)) FROM z1tbig\nDELETE FROM z1tbig WHERE id = 3600\nALTER TABLE z1tbig ALTER COLUMN s int\nSELECT C