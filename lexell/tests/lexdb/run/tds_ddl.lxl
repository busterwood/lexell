const QUERIES = "CREATE TABLE tv (id int PRIMARY KEY, v int, w varchar(10))\nINSERT INTO tv VALUES (1, 10, 'a'), (2, 20, 'b')\nCREATE VIEW vv AS SELECT id, v FROM tv\nCREATE OR ALTER VIEW vv AS SELECT id, v, w FROM tv\nSELECT * FROM vv ORDER BY id\nCREATE OR ALTER VIEW vnew AS SELECT id FROM tv\nSELECT * FROM vnew ORDER BY id\nCREATE OR ALTER VIEW vv AS SELECT w FROM tv\nSELECT * FROM vv ORDER BY w\nSELECT OBJECT_DEFINITION(OBJECT_ID('vv'))\nCREATE OR ALTER VIEW vnew AS SELECT 1 AS a, 2 AS b\nSELECT * FROM vnew\nCREATE  OR  ALTER  VIEW v2 AS SELECT 1 AS a\nSELECT OBJECT_DEFINITION(OBJECT_ID('v2'))\ncreate or alter view v3 as select 1 as a\nSELECT OBJECT_DEFINITION(OBJECT_ID('v3'))\nCREATE /* c */ OR ALTER VIEW v4 AS SELECT 2 AS a\nSELECT OBJECT_DEFINITION(OBJECT_ID('v4'))\nCREATE OR ALTER VIEW tv AS SELECT 2 AS a\nCREATE VIEW v2 AS SELECT 3 AS a\nALTER VIEW v2 AS SELECT 3 AS a, 4 AS b\nSELECT * FROM v2\nSELECT OBJECT_DEFINITION(OBJECT_ID('v2'))\nALTER VIEW nothere AS SELECT 1 AS a\nALTER VIEW tv AS SELECT 1 AS a\nCREATE OR REPLACE VIEW v5 AS SELECT 1 AS a\nCREATE OR ALTER VIEW v6 (x, y) AS SELECT 1, 2\nSELECT * FROM v6\nCREATE OR ALTER VIEW v7 AS SELECT a FROM v2\nCREATE OR ALTER VIEW v2 AS SELECT 9 AS q\nSELECT * FROM v7\nSELECT * FROM v2\nCREATE OR ALTER VIEW v2 AS SELECT * FROM nothing_here\nCREATE OR ALTER VIEW v2 AS SELECT nothing FROM tv\nSELECT * FROM v2\nCREATE OR ALTER TABLE x (a int)\nCREATE OR ALTER SYNONYM s FOR tv\nCREATE OR ALTER\nCREATE TABLE ck (a int)\nCREATE OR ALTER VIEW ck AS SELECT 1 AS a\nBEGIN TRAN\nCREATE OR ALTER VIEW v2 AS SELECT 'tx' AS q\nSELECT * FROM v2\nROLLBACK\nSELECT * FROM v2\nCREATE OR ALTER VIEW v2 AS SELECT 1 AS q, 2 AS more\nSELECT name FROM sys.views WHERE name LIKE 'v%' ORDER BY name\nSELECT snapshot_isolation_state, snapshot_isolation_state_desc, is_read_committed_snapshot_on, compatibility_level, recovery_model_desc, is_auto_shrink_on, is_auto_close_on, is_auto_create_stats_on, is_auto_update_stats_on, page_verify_option_desc, is_trustworthy_on, state_desc, user_access_desc, is_read_only, delayed_durability_desc FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION ON\nSELECT snapshot_isolation_state, snapshot_isolation_state_desc FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION ON\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION OFF\nSELECT snapshot_isolation_state, snapshot_isolation_state_desc FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON\nSELECT is_read_committed_snapshot_on FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT OFF WITH ROLLBACK IMMEDIATE\nSELECT is_read_committed_snapshot_on FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON WITH NO_WAIT\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT OFF WITH ROLLBACK AFTER 30 SECONDS\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON WITH ROLLBACK AFTER 30\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON, ALLOW_SNAPSHOT_ISOLATION ON\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION ON, RECOVERY SIMPLE\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON, RECOVERY SIMPLE\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION ON WITH NO_WAIT\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION OFF WITH ROLLBACK IMMEDIATE\nALTER DATABASE CURRENT SET AUTO_SHRINK ON WITH ROLLBACK IMMEDIATE\nALTER DATABASE CURRENT SET AUTO_SHRINK ON, AUTO_SHRINK OFF\nALTER DATABASE CURRENT SET AUTO_SHRINK ON,\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON WITH BOGUS\nALTER DATABASE CURRENT SET FOOBAR ON\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION MAYBE\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION = ON\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION\nALTER DATABASE CURRENT SET\nALTER DATABASE CURRENT\nALTER DATABASE SET ALLOW_SNAPSHOT_ISOLATION ON\nALTER DATABASE nothere SET ALLOW_SNAPSHOT_ISOLATION ON\nALTER DATABASE 'x' SET AUTO_SHRINK OFF\nDECLARE @s nvarchar(200) = N'ALTER DATABASE ' + QUOTENAME(DB_NAME()) + N' SET ALLOW_SNAPSHOT_ISOLATION ON'; EXEC(@s)\nDECLARE @n sysname = DB_NAME(); SELECT snapshot_isolation_state FROM sys.databases WHERE name = @n\nDECLARE @s nvarchar(200) = N'ALTER DATABASE ' + DB_NAME() + N' SET ALLOW_SNAPSHOT_ISOLATION OFF'; EXEC(@s)\nSELECT snapshot_isolation_state FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET allow_snapshot_isolation on\nSELECT snapshot_isolation_state_desc FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET AUTO_CLOSE ON\nALTER DATABASE CURRENT SET AUTO_SHRINK ON\nALTER DATABASE CURRENT SET AUTO_CREATE_STATISTICS OFF\nALTER DATABASE CURRENT SET AUTO_UPDATE_STATISTICS OFF\nALTER DATABASE CURRENT SET AUTO_UPDATE_STATISTICS_ASYNC ON\nALTER DATABASE CURRENT SET AUTO_CREATE_STATISTICS ON (INCREMENTAL = ON)\nALTER DATABASE CURRENT SET AUTO_CREATE_STATISTICS OFF (INCREMENTAL = ON)\nALTER DATABASE CURRENT SET RECOVERY SIMPLE\nALTER DATABASE CURRENT SET RECOVERY BULK_LOGGED\nALTER DATABASE CURRENT SET RECOVERY FULL\nALTER DATABASE CURRENT SET RECOVERY FAST\nALTER DATABASE CURRENT SET PAGE_VERIFY NONE\nALTER DATABASE CURRENT SET PAGE_VERIFY TORN_PAGE_DETECTION\nALTER DATABASE CURRENT SET PAGE_VERIFY BOGUS\nSELECT recovery_model, recovery_model_desc, page_verify_option, page_verify_option_desc, is_auto_close_on, is_auto_shrink_on, is_auto_create_stats_on, is_auto_create_stats_incremental_on, is_auto_update_stats_on, is_auto_update_stats_async_on FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL = 150\nSELECT compatibility_level FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL = 999\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL = 90\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL 150\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL = 'x'\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL = 160\nALTER DATABASE CURRENT SET TRUSTWORTHY ON\nALTER DATABASE CURRENT SET DB_CHAINING ON\nALTER DATABASE CURRENT SET RECURSIVE_TRIGGERS ON\nALTER DATABASE CURRENT SET PARAMETERIZATION FORCED\nALTER DATABASE CURRENT SET CURSOR_DEFAULT LOCAL\nALTER DATABASE CURRENT SET CURSOR_CLOSE_ON_COMMIT ON\nALTER DATABASE CURRENT SET ANSI_NULLS ON\nALTER DATABASE CURRENT SET ANSI_PADDING OFF\nSELECT is_trustworthy_on, is_db_chaining_on, is_recursive_triggers_on, is_parameterization_forced, is_local_cursor_default, is_cursor_close_on_commit_on, is_ansi_nulls_on, is_ansi_padding_on FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET DELAYED_DURABILITY = FORCED\nALTER DATABASE CURRENT SET DELAYED_DURABILITY FORCED\nSELECT delayed_durability, delayed_durability_desc FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET TARGET_RECOVERY_TIME = 2 MINUTES\nSELECT target_recovery_time_in_seconds FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET TARGET_RECOVERY_TIME = 60\nALTER DATABASE CURRENT SET TARGET_RECOVERY_TIME = -5 SECONDS\nALTER DATABASE CURRENT SET QUERY_STORE = ON\nALTER DATABASE CURRENT SET QUERY_STORE = ON (OPERATION_MODE = READ_WRITE)\nALTER DATABASE CURRENT SET ACCELERATED_DATABASE_RECOVERY = ON\nSELECT is_query_store_on, is_accelerated_database_recovery_on FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET MULTI_USER\nALTER DATABASE CURRENT SET READ_WRITE\nALTER DATABASE CURRENT SET ONLINE\nALTER DATABASE CURRENT SET RECOVERY SIMPLE, AUTO_SHRINK OFF\nALTER DATABASE CURRENT SET AUTO_SHRINK OFF; SELECT 1 AS x\nSELECT 1 AS x; ALTER DATABASE CURRENT SET AUTO_SHRINK ON\nSELECT is_auto_shrink_on FROM sys.databases WHERE name = DB_NAME()\nBEGIN TRAN\nALTER DATABASE CURRENT SET AUTO_SHRINK OFF\nSELECT @@TRANCOUNT\nROLLBACK\nSELECT is_auto_shrink_on FROM sys.databases WHERE name = DB_NAME()\nBEGIN TRY ALTER DATABASE CURRENT SET AUTO_SHRINK OFF END TRY BEGIN CATCH SELECT 1 AS caught END CATCH\nSELECT is_auto_shrink_on FROM sys.databases WHERE name = DB_NAME()\nCREATE TABLE ra (id int PRIMARY KEY, v int, w varchar(10))\nCREATE INDEX ix_ra_v ON ra (v)\nCREATE UNIQUE INDEX ux_ra_w ON ra (w)\nALTER TABLE ra ADD CONSTRAINT ck_ra CHECK (LEN(w) > 0)\nINSERT INTO ra VALUES (1, 10, 'a'), (2, 20, 'b')\nCREATE VIEW va AS SELECT id, v FROM ra\nCREATE VIEW vastar AS SELECT * FROM ra\nCREATE TABLE rb (id int, ra_id int REFERENCES ra (id))\nINSERT INTO rb VALUES (1, 1)\nEXEC sp_rename 'ra', 'ra2'\nSELECT * FROM ra\nSELECT * FROM ra2 ORDER BY id\nSELECT * FROM va\nSELECT * FROM vastar\nINSERT INTO ra2 VALUES (3, 30, 'c')\nINSERT INTO ra2 VALUES (5, 50, '')\nINSERT INTO rb VALUES (2, 3)\nINSERT INTO rb VALUES (3, 99)\nSELECT * FROM ra2 WHERE v = 30\nSELECT COUNT(*) FROM sys.tables WHERE name = 'ra2'\nSELECT COUNT(*) FROM sys.tables WHERE name = 'ra'\nSELECT name FROM sys.indexes WHERE object_id = OBJECT_ID('ra2') AND name LIKE '%ra_%' AND is_primary_key = 0 ORDER BY name\nSELECT name, OBJECT_NAME(parent_object_id) FROM sys.check_constraints WHERE name = 'ck_ra'\nSELECT OBJECT_NAME(parent_object_id), OBJECT_NAME(referenced_object_id) FROM sys.foreign_keys\nSELECT OBJECT_DEFINITION(OBJECT_ID('va'))\nEXEC sp_rename 'ra2', 'ra'\nSELECT * FROM va ORDER BY id\nSELECT * FROM vastar ORDER BY id\nEXEC sp_rename 'ra.v', 'vx', 'COLUMN'\nSELECT * FROM ra ORDER BY id\nSELECT * FROM va\nSELECT * FROM vastar ORDER BY id\nSELECT id, vx FROM ra WHERE vx > 10 ORDER BY id\nINSERT INTO ra (id, vx, w) VALUES (6, 60, 'f')\nSELECT name FROM sys.columns WHERE object_id = OBJECT_ID('ra') ORDER BY column_id\nSELECT i.name, c.name FROM sys.index_columns ic JOIN sys.indexes i ON i.object_id = ic.object_id AND i.index_id = ic.index_id JOIN sys.columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id WHERE ic.object_id = OBJECT_ID('ra') AND i.is_primary_key = 0 ORDER BY i.name\nSELECT COUNT(*) FROM ra WHERE vx = 60\nEXEC sp_rename 'ra.w', 'wx', 'COLUMN'\nEXEC sp_rename 'ra.id', 'idx', 'COLUMN'\nINSERT INTO rb VALUES (4, 6)\nEXEC sp_rename 'ra.vx', 'v', 'COLUMN'\nSELECT * FROM va ORDER BY id\nSELECT * FROM ra ORDER BY idx\nEXEC sp_rename 'ra.idx', 'id'\nSELECT * FROM va ORDER BY id\nCREATE TABLE rc (id int PRIMARY KEY, n int)\nINSERT INTO rc VALUES (1, 1), (2, 2)\nEXEC sp_rename 'rc', 'rc2'\nEXEC sp_rename 'rc2', 'rc3', 'OBJECT'\nEXEC sp_rename 'rc3', 'rc4'\nSELECT COUNT(*) FROM rc4\nEXEC sp_rename 'dbo.rc4', 'rc5'\nEXEC sp_rename '[dbo].[rc5]', 'rc6'\nEXEC sp_rename '[rc6]', 'RC7'\nSELECT name FROM sys.tables WHERE name LIKE 'rc%' ORDER BY name\nSELECT COUNT(*) FROM rc7\nEXEC sp_rename 'rc7', 'rc'\nEXEC sp_rename @objname = 'rc', @newname = 'rc8'\nEXEC sp_rename @newname = 'rc9', @objname = 'rc8'\nEXEC sp_rename 'rc9', @objtype = 'OBJECT', @newname = 'rc10'\nDECLARE @o sysname = 'rc10', @n sysname = 'rc11'; EXEC sp_rename @o, @n\nEXEC sp_rename N'rc11', N'rc12', N'OBJECT'\nSELECT name FROM sys.tables WHERE name LIKE 'rc%' ORDER BY name\nEXEC sp_rename 'rc12', 'rc 13'\nEXEC sp_rename '[rc 13]', 'rc14'\nSELECT COUNT(*) FROM rc14\nEXEC sp_rename 'rc14', 'rc15', NULL\nEXEC sp_rename 'rc15', 'rc_new', ' object '\nEXEC sp_rename 'rc_new', 'rc16', 'Object'\nSELECT name FROM sys.tables WHERE name LIKE 'rc%' ORDER BY name\nCREATE TABLE rd (a int)\nCREATE TABLE re (a int)\nCREATE VIEW rv AS SELECT a FROM rd\nCREATE INDEX ix_rd ON rd (a)\nALTER TABLE rd ADD CONSTRAINT ck_rd CHECK (a > 0)\nEXEC sp_rename 'rd', 're'\nEXEC sp_rename 'rd', 'rv'\nEXEC sp_rename 'rd', 'RE'\nEXEC sp_rename 'nothere', 'x'\nEXEC sp_rename 'dbo.nothere', 'x'\nEXEC sp_rename 'rd.nocol', 'x', 'COLUMN'\nEXEC sp_rename 'nothere.a', 'x', 'COLUMN'\nEXEC sp_rename 'rd.a', 'x', 'OBJECT'\nEXEC sp_rename 'rd.a', 'x'\nEXEC sp_rename 'rd', 'x', 'COLUMN'\nEXEC sp_rename 'rd', 'x', 'INDEX'\nEXEC sp_rename 'rd.ix_rd', 'ix_rd'\nEXEC sp_rename 'rd.nothere', 'ix_q', 'INDEX'\nEXEC sp_rename 'nothere.ix_rd', 'ix_q', 'INDEX'\nEXEC sp_rename 'rd.a', 'ra', 'COLUMN'\nEXEC sp_rename 'rd', 'x', 'USERDATATYPE'\nEXEC sp_rename 'rd', 'x', 'FOO'\nEXEC sp_rename 'rd', NULL\nEXEC sp_rename NULL, 'x'\nEXEC sp_rename 'rd'\nEXEC sp_rename\nEXEC sp_rename 'rd', ''\nEXEC sp_rename '', 'abc'\nEXEC sp_rename 'ck_rd', 'ck_rd2'\nEXEC sp_rename 'ck_rd2', 'ck_rd', 'OBJECT'\nSELECT name FROM sys.check_constraints WHERE parent_object_id = OBJECT_ID('rd')\nEXEC sp_rename 'rd.ix_rd', 'ix_rd2', 'INDEX'\nEXEC sp_rename 'dbo.rd.ix_rd2', 'ix_rd3'\nSELECT name FROM sys.indexes WHERE object_id = OBJECT_ID('rd') AND name IS NOT NULL ORDER BY name\nEXEC sp_rename 'rv', 'rv2'\nSELECT * FROM rv2\nSELECT * FROM rv\nSELECT name FROM sys.views WHERE name LIKE 'rv%' ORDER BY name\nEXEC sp_rename 'rd', 'rd2'\nSELECT * FROM rv2\nEXEC sp_rename 'rd2', 'rd'\nSELECT * FROM rv2\nSELECT OBJECT_DEFINITION(OBJECT_ID('rv2'))\nBEGIN TRAN\nEXEC sp_rename 'rd', 'rdt'\nSELECT COUNT(*) FROM rdt\nROLLBACK\nSELECT COUNT(*) FROM rd\nBEGIN TRAN\nEXEC sp_rename 'rd.a', 'at', 'COLUMN'\nEXEC sp_rename 'rd.nocol', 'x', 'COLUMN'\nSELECT at FROM rd\nCOMMIT\nSELECT at FROM rd\nCREATE SCHEMA s2\nCREATE TABLE s2.u (a int)\nEXEC sp_rename 's2.u', 'u2'\nSELECT * FROM s2.u2\nEXEC sp_rename 'u2', 'u3'\nEXEC sp_rename 's2.u2', 'u3'\nSELECT * FROM s2.u3\nEXEC sp_rename 's2.u3.a', 'b', 'COLUMN'\nSELECT b FROM s2.u3\nEXEC sp_rename 's2.u3.b', 'c'\nSELECT c FROM s2.u3\nEXEC sp_rename 's2.u3', 'u4', 'OBJECT'\nSELECT * FROM s2.u4\nEXEC sp_rename 'master.dbo.rd', 'x'\nEXEC sp_rename 'sys.objects', 'x'\nEXEC sp_rename 'rd', 'rd ; drop'\nSELECT name FROM sys.tables WHERE name LIKE 'rd%' ORDER BY name\nEXEC sp_rename '[rd ; drop]', 'rd'\nSELECT name FROM sys.tables WHERE name LIKE 'rd%' ORDER BY name\nEXEC sp_rename 'rd', 'rd', 'OBJECT'\nEXEC sp_rename 'rd', 'RD'\nSELECT name FROM sys.tables WHERE name LIKE 'rd%' ORDER BY name"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(37), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
