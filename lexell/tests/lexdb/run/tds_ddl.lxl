const QUERIES = "CREATE TABLE tv (id int PRIMARY KEY, v int, w varchar(10))\nINSERT INTO tv VALUES (1, 10, 'a'), (2, 20, 'b')\nCREATE VIEW vv AS SELECT id, v FROM tv\nCREATE OR ALTER VIEW vv AS SELECT id, v, w FROM tv\nSELECT * FROM vv ORDER BY id\nCREATE OR ALTER VIEW vnew AS SELECT id FROM tv\nSELECT * FROM vnew ORDER BY id\nCREATE OR ALTER VIEW vv AS SELECT w FROM tv\nSELECT * FROM vv ORDER BY w\nSELECT OBJECT_DEFINITION(OBJECT_ID('vv'))\nCREATE OR ALTER VIEW vnew AS SELECT 1 AS a, 2 AS b\nSELECT * FROM vnew\nCREATE  OR  ALTER  VIEW v2 AS SELECT 1 AS a\nSELECT OBJECT_DEFINITION(OBJECT_ID('v2'))\ncreate or alter view v3 as select 1 as a\nSELECT OBJECT_DEFINITION(OBJECT_ID('v3'))\nCREATE /* c */ OR ALTER VIEW v4 AS SELECT 2 AS a\nSELECT OBJECT_DEFINITION(OBJECT_ID('v4'))\nCREATE OR ALTER VIEW tv AS SELECT 2 AS a\nCREATE VIEW v2 AS SELECT 3 AS a\nALTER VIEW v2 AS SELECT 3 AS a, 4 AS b\nSELECT * FROM v2\nSELECT OBJECT_DEFINITION(OBJECT_ID('v2'))\nALTER VIEW nothere AS SELECT 1 AS a\nALTER VIEW tv AS SELECT 1 AS a\nCREATE OR REPLACE VIEW v5 AS SELECT 1 AS a\nCREATE OR ALTER VIEW v6 (x, y) AS SELECT 1, 2\nSELECT * FROM v6\nCREATE OR ALTER VIEW v7 AS SELECT a FROM v2\nCREATE OR ALTER VIEW v2 AS SELECT 9 AS q\nSELECT * FROM v7\nSELECT * FROM v2\nCREATE OR ALTER VIEW v2 AS SELECT * FROM nothing_here\nCREATE OR ALTER VIEW v2 AS SELECT nothing FROM tv\nSELECT * FROM v2\nCREATE OR ALTER TABLE x (a int)\nCREATE OR ALTER SYNONYM s FOR tv\nCREATE OR ALTER\nCREATE TABLE ck (a int)\nCREATE OR ALTER VIEW ck AS SELECT 1 AS a\nBEGIN TRAN\nCREATE OR ALTER VIEW v2 AS SELECT 'tx' AS q\nSELECT * FROM v2\nROLLBACK\nSELECT * FROM v2\nCREATE OR ALTER VIEW v2 AS SELECT 1 AS q, 2 AS more\nSELECT name FROM sys.views WHERE name LIKE 'v%' ORDER BY name\nSELECT snapshot_isolation_state, snapshot_isolation_state_desc, is_read_committed_snapshot_on, compatibility_level, recovery_model_desc, is_auto_shrink_on, is_auto_close_on, is_auto_create_stats_on, is_auto_update_stats_on, page_verify_option_desc, is_trustworthy_on, state_desc, user_access_desc, is_read_only, delayed_durability_desc FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION ON\nSELECT snapshot_isolation_state, snapshot_isolation_state_desc FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION ON\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION OFF\nSELECT snapshot_isolation_state, snapshot_isolation_state_desc FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON\nSELECT is_read_committed_snapshot_on FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT OFF WITH ROLLBACK IMMEDIATE\nSELECT is_read_committed_snapshot_on FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON WITH NO_WAIT\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT OFF WITH ROLLBACK AFTER 30 SECONDS\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON WITH ROLLBACK AFTER 30\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON, ALLOW_SNAPSHOT_ISOLATION ON\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION ON, RECOVERY SIMPLE\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON, RECOVERY SIMPLE\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION ON WITH NO_WAIT\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION OFF WITH ROLLBACK IMMEDIATE\nALTER DATABASE CURRENT SET AUTO_SHRINK ON WITH ROLLBACK IMMEDIATE\nALTER DATABASE CURRENT SET AUTO_SHRINK ON, AUTO_SHRINK OFF\nALTER DATABASE CURRENT SET AUTO_SHRINK ON,\nALTER DATABASE CURRENT SET READ_COMMITTED_SNAPSHOT ON WITH BOGUS\nALTER DATABASE CURRENT SET FOOBAR ON\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION MAYBE\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION = ON\nALTER DATABASE CURRENT SET ALLOW_SNAPSHOT_ISOLATION\nALTER DATABASE CURRENT SET\nALTER DATABASE CURRENT\nALTER DATABASE SET ALLOW_SNAPSHOT_ISOLATION ON\nALTER DATABASE nothere SET ALLOW_SNAPSHOT_ISOLATION ON\nALTER DATABASE 'x' SET AUTO_SHRINK OFF\nDECLARE @s nvarchar(200) = N'ALTER DATABASE ' + QUOTENAME(DB_NAME()) + N' SET ALLOW_SNAPSHOT_ISOLATION ON'; EXEC(@s)\nDECLARE @n sysname = DB_NAME(); SELECT snapshot_isolation_state FROM sys.databases WHERE name = @n\nDECLARE @s nvarchar(200) = N'ALTER DATABASE ' + DB_NAME() + N' SET ALLOW_SNAPSHOT_ISOLATION OFF'; EXEC(@s)\nSELECT snapshot_isolation_state FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET allow_snapshot_isolation on\nSELECT snapshot_isolation_state_desc FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET AUTO_CLOSE ON\nALTER DATABASE CURRENT SET AUTO_SHRINK ON\nALTER DATABASE CURRENT SET AUTO_CREATE_STATISTICS OFF\nALTER DATABASE CURRENT SET AUTO_UPDATE_STATISTICS OFF\nALTER DATABASE CURRENT SET AUTO_UPDATE_STATISTICS_ASYNC ON\nALTER DATABASE CURRENT SET AUTO_CREATE_STATISTICS ON (INCREMENTAL = ON)\nALTER DATABASE CURRENT SET AUTO_CREATE_STATISTICS OFF (INCREMENTAL = ON)\nALTER DATABASE CURRENT SET RECOVERY SIMPLE\nALTER DATABASE CURRENT SET RECOVERY BULK_LOGGED\nALTER DATABASE CURRENT SET RECOVERY FULL\nALTER DATABASE CURRENT SET RECOVERY FAST\nALTER DATABASE CURRENT SET PAGE_VERIFY NONE\nALTER DATABASE CURRENT SET PAGE_VERIFY TORN_PAGE_DETECTION\nALTER DATABASE CURRENT SET PAGE_VERIFY BOGUS\nSELECT recovery_model, recovery_model_desc, page_verify_option, page_verify_option_desc, is_auto_close_on, is_auto_shrink_on, is_auto_create_stats_on, is_auto_create_stats_incremental_on, is_auto_update_stats_on, is_auto_update_stats_async_on FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL = 150\nSELECT compatibility_level FROM sys.databases WHERE name = DB_NAME()\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL = 999\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL = 90\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL 150\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL = 'x'\nALTER DATABASE CURRENT SET COMPATIBILITY_LEVEL 