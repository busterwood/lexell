// lexdb_sql: statements and errors.
// expect: 1 create t cols 3 pk id
// expect: 3 insert t rows 2 params 2
// expect: 4 select t items 2 where true order 1 limit true
// expect: 5 update 6 delete 7 8 9 10
// expect: 42601: syntax error at or near "frm"
// expect: 42601: unterminated quoted string
// expect: 2 statements
import "../../../cmd/lexdb_sql"

fn main() {
    let a = lexdb_sql.parse(&"CREATE TABLE t (id bigint PRIMARY KEY, name text NOT NULL, price numeric(10,2))").unwrap()
    println(a[0].kind.toStr() + " create " + a[0].table + " cols " + len(a[0].cols).toStr() + " pk " + a[0].pk[0])
    let b = lexdb_sql.parse(&"insert into T values ($1, 'x''y', 2.50), (2, $2, -1)").unwrap()
    println(b[0].kind.toStr() + " insert " + b[0].table + " rows " + len(b[0].rows).toStr() + " params " + b[0].params.toStr())
    let c = lexdb_sql.parse(&"SELECT id, name AS n FROM t WHERE id >= 3 AND name IS NOT NULL ORDER BY id DESC LIMIT 10").unwrap()
    println(c[0].kind.toStr() + " select " + c[0].table + " items " + len(c[0].items).toStr() + " where " + c[0].where.isSome().toStr() + " order " + len(c[0].order).toStr() + " limit " + c[0].limit.isSome().toStr())
    let d = lexdb_sql.parse(&"update t set name = name || '!' where id = 1; delete from t where id = 2; begin; commit; rollback; set datestyle to iso").unwrap()
    var ks = ""
    for s in d { ks = ks + s.kind.toStr() + if s.kind == 5 { " update " } else if s.kind == 6 { " delete " } else { " " } }
    println(ks[0..len(ks) - 1])
    match lexdb_sql.parse(&"select * frm t") { Ok(_) { println("ok?") } Err(e) { println(e.toStr()) } }
    match lexdb_sql.parse(&"select 'abc") { Ok(_) { println("ok?") } Err(e) { println(e.toStr()) } }
    println(len(lexdb_sql.parse(&"select 1; ; select 2;").unwrap()).toStr() + " statements")
}
