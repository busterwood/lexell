// lexdb_exec: UPDATE ... FROM, DELETE ... USING, a target's alias and
// TRUNCATE, checked against PostgreSQL 18 (generated by tests/lexdb/gen_pg.py
// from joinwrite_queries.txt): FROM tables, subqueries, VALUES and joins;
// a row joined twice changed once; SET (a, b) = (...); RETURNING of both
// sides; the alias hiding the name; TRUNCATE's foreign keys and CASCADE,
// RESTART IDENTITY, indexes after it, a block rolled back, and its errors.
// Each expect line: a query's rows or tag, or ERROR and its SQLSTATE.
// expect: CREATE TABLE
// expect: CREATE TABLE
// expect: CREATE TABLE
// expect: INSERT 0 4
// expect: INSERT 0 3
// expect: INSERT 0 2
// expect: UPDATE 2
// expect: 1|105.00;2|57.50;3|0.00;4|10.00
// expect: UPDATE 3
// expect: 1|106.50;2|57.50;3|1.50;4|10.00
// expect: UPDATE 0
// expect: UPDATE 1
// expect: 1|gold;2|none;3|gold;4|
// expect: UPDATE 1
// expect: 1|5.00|paid;2|57.50|none;3|1.50|gold;4|10.00|
// expect: UPDATE 4
// expect: 1|6.00;2|58.50;3|2.50;4|11.00
// expect: 2|bob|7.50|none|2|7.50;UPDATE 1
// expect: UPDATE 2
// expect: 1|ann;2|bob;3|cyrus;4|diana
// expect: ERROR 42702
// expect: ERROR 42712
// expect: ERROR 42P01
// expect: UPDATE 0
// expect: ERROR 42703
// expect: ERROR 42703
// expect: BEGIN
// expect: UPDATE 2
// expect: ROLLBACK
// expect: 1|6.00;2|7.50;3|2.50;4|11.00
// expect: DELETE 1
// expect: 1;3
// expect: 1|ann;DELETE 1
// expect: 3
// expect: INSERT 0 3
// expect: DELETE 2
// expect: 2;4
// expect: DELETE 0
// expect: 2;4
// expect: DELETE 1
// expect: ERROR 42P01
// expect: 3;5;6
// expect: CREATE TABLE
// expect: CREATE TABLE
// expect: CREATE TABLE
// expect: CREATE SEQUENCE
// expect: CREATE TABLE
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: INSERT 0 1
// expect: INSERT 0 1
// expect: INSERT 0 3
// expect: INSERT 0 2
// expect: 1
// expect: ERROR 0A000
// expect: ERROR 0A000
// expect: TRUNCATE TABLE
// expect: 0
// expect: 0
// expect: INSERT 0 1
// expect: INSERT 0 1
// expect: TRUNCATE TABLE
// expect: 0|0|0
// expect: INSERT 0 1
// expect: INSERT 0 1
// expect: 1|again
// expect: TRUNCATE TABLE
// expect: 4;INSERT 0 1
// expect: TRUNCATE TABLE
// expect: 1;INSERT 0 1
// expect: 1;INSERT 0 1
// expect: 2
// expect: BEGIN
// expect: INSERT 0 2
// expect: TRUNCATE TABLE
// expect: 0
// expect: ROLLBACK
// expect: 1
// expect: CREATE INDEX
// expect: CREATE INDEX
// expect: INSERT 0 2
// expect: TRUNCATE TABLE
// expect: 0
// expect: INSERT 0 1
// expect: 20
// expect: CREATE VIEW
// expect: ERROR 42809
// expect: ERROR 42P01
// expect: ERROR 42P01
// expect: 1
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table acct (id int primary key, owner text, bal numeric(10,2), tier text)\ncreate table pay (id int primary key, acct_id int, amt numeric(10,2))\ncreate table tiers (name text primary key, bonus numeric(10,2))\ninsert into acct values (1, 'ann', 100, 'gold'), (2, 'bob', 50, 'basic'), (3, 'cy', 0, 'gold'), (4, 'di', 10, null)\ninsert into pay values (1, 1, 5), (2, 2, 7.5), (3, 9, 1)\ninsert into tiers values ('gold', 1.5), ('basic', 0)\nupdate acct set bal = bal + pay.amt from pay where pay.acct_id = acct.id\nselect id, bal from acct order by id\nupdate acct a set bal = a.bal + t.bonus from tiers t where t.name = a.tier\nselect id, bal from acct order by id\nupdate acct set bal = 0 from pay where pay.acct_id = acct.id and pay.amt > 100\nupdate acct as a set tier = 'none' from pay p join tiers t on t.name = 'gold' where p.acct_id = a.id and a.tier = 'basic'\nselect id, tier from acct order by id\nupdate acct set (bal, tier) = (p.amt, 'paid') from pay p where p.acct_id = acct.id and p.id = 1\nselect id, bal, tier from acct order by id\nupdate acct set bal = bal + 1 from pay where pay.acct_id in (1, 2)\nselect id, bal from acct order by id\nupdate acct set bal = s.total from (select acct_id, sum(amt) as total from pay group by acct_id) s where s.acct_id = acct.id and acct.id = 2 returning *\nupdate acct set owner = v.n from (values (3, 'cyrus'), (4, 'diana')) as v(i, n) where v.i = acct.id\nselect id, owner from acct order by id\nupdate acct set bal = 1 from pay where id = 1\nupdate acct set bal = 1 from acct where acct.id = 1\nupdate acct a set bal = 1 where acct.id = 1\nupdate acct a set bal = a.bal where a.id = 99\nupdate acct set bal = pay.nope from pay where pay.acct_id = acct.id\nupdate acct set nope = 1 from pay\nbegin\nupdate acct set bal = 999 from pay where pay.acct_id = acct.id\nrollback\nselect id, bal from acct order by id\ndelete from pay using acct where acct.id = pay.acct_id and acct.owner = 'bob'\nselect id from pay order by id\ndelete from pay p using acct a where a.id = p.acct_id returning p.id, a.owner\nselect id from pay order by id\ninsert into pay values (4, 1, 1), (5, 1, 2), (6, 3, 3)\ndelete from acct using pay where pay.acct_id = acct.id and pay.amt < 10\nselect id from acct order by id\ndelete from acct a using (select 3 as x) s where a.id = s.x\nselect id from acct order by id\ndelete from pay as p where p.id = 4\ndelete from pay p where pay.id = 5\nselect id from pay order by id\ncreate table par (id int primary key, n text)\ncreate table kid (id int primary key, par_id int references par)\ncreate table grandkid (id int primary key, kid_id int references kid)\ncreate sequence other_seq\ncreate table ser (id serial primary key, x int)\ncreate table idt (id int generated always as identity primary key, x int)\ninsert into par values (1, 'p'), (2, 'q')\ninsert into kid values (10, 1)\ninsert into grandkid values (100, 10)\ninsert into ser (x) values (1), (2), (3)\ninsert into idt (x) values (1), (2)\nselect nextval('other_seq')\ntruncate par\ntruncate kid\ntruncate grandkid, kid\nselect count(*) from kid\nselect count(*) from grandkid\ninsert into kid values (11, 2)\ninsert into grandkid values (101, 11)\ntruncate table par cascade\nselect (select count(*) from par), (select count(*) from kid), (select count(*) from grandkid)\ninsert into par values (1, 'again')\ninsert into kid values (10, 1)\nselect * from par\ntruncate ser\ninsert into ser (x) values (9) returning id\ntruncate ser, idt restart identity\ninsert into ser (x) values (9) returning id\ninsert into idt (x) values (9) returning id\nselect nextval('other_seq')\nbegin\ninsert into ser (x) values (10), (11)\ntruncate ser\nselect count(*) from ser\nrollback\nselect count(*) from ser\ncreate index ser_x on ser (x)\ncreate unique index ser_ux on ser (x, id)\ninsert into ser (x) values (20), (21)\ntruncate only ser continue identity restrict\nselect count(*) from ser where x = 20\ninsert into ser (x) values (20)\nselect x from ser where x = 20\ncreate view serv as select * from ser\ntruncate serv\ntruncate nosuch\ntruncate ser, nosuch\nselect count(*) from ser"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(91), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
