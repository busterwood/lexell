// lexdb over TNS: what the pipeline took from the row engine in Q8's R8 (design/lexdb-layers.md 6.3.Q8 R8), the give-ways,
// through the Oracle door, checked against Oracle Database Free (gen_oracle.py --check: the answers below are Oracle's):
// DISTINCT and ORDER BY over a date, a number (NULLS FIRST, OFFSET ... FETCH, DESC), a CASE's number, a binary_double, two
// columns; an error in a later row (ORA-01476); DISTINCT over a join; hash joins on a key that is an expression of values (||,
// upper(), mod(), nvl(), a CASE with an error in a later row), LEFT, EXISTS, a scalar subquery per row; joins of a few held rows
// (a derived table by primary key, with NULLs and no match, by a hash, FETCH FIRST, DISTINCT, an error in a later row, by an
// index). Recursive WITH is tns_recursion's (design/lexdb-dialect-gaps.md, "Recursion in the doors"). Each statement runs
// with set lexdb_batch = off (the row engine) and on: "same" and the answer, or DIFFERENT and both.
// expect: setup: 29 statements
// expect: same: DT = '2024-01-01T00:00:00';'2024-01-02T00:00:00';'2024-01-03T00:00:00';'2024-01-04T00:00:00';'2024-01-05T00:00:00';'2024-01-06T00:00:00';'2024-01-07T00:00:00';'2024-01-08T00:00:00';'2024-01-09T00:00:00';'2024-01-10T00:00:00';'2024-01-11T00:00:00';'2024-01-12T00:00:00';'2024-01-13T00:00:00';'2024-01-14T00:00:00';'2024-01-15T00:00:00';'2024-01-16T00:00:00';'2024-01-17T00:00:00';'2024-01-18T00:00:00';'2024-01-19T00:00:00';'2024-01-20T00:00:00'
// expect: same: NU = 3.50;4.50;5.50;6.50;7.50;8.50;9.50
// expect: same: NU = 29.50;28.50;27.50;26.50;25.50;24.50;23.50;22.50;21.50;20.50;19.50;18.50;17.50;16.50;15.50;14.50;13.50;12.50;11.50;10.50;9.50;8.50;7.50;6.50;5.50;4.50;3.50;2.50;1.50;0.50;NULL
// expect: same: NU = NULL;0.50;1.50;2.50;3.50;4.50;5.50;6.50;7.50;8.50;9.50;10.50;11.50;12.50;13.50;14.50;15.50;16.50;17.50;18.50;19.50;20.50;21.50;22.50;23.50;24.50;25.50;26.50;27.50;28.50;29.50
// expect: same: C = 1.5;6.5;11.5;16.5;21.5;26.5;NULL
// expect: same: FL = 0;0.25;0.5;0.75;1;1.25;1.5;1.75;2
// expect: same: DT,Z = '2024-01-01T00:00:00'|0;'2024-01-06T00:00:00'|0;'2024-01-11T00:00:00'|0;'2024-01-16T00:00:00'|0;'2024-01-02T00:00:00'|1;'2024-01-07T00:00:00'|1;'2024-01-12T00:00:00'|1;'2024-01-17T00:00:00'|1;'2024-01-03T00:00:00'|2;'2024-01-08T00:00:00'|2;'2024-01-13T00:00:00'|2;'2024-01-18T00:00:00'|2;'2024-01-04T00:00:00'|3;'2024-01-09T00:00:00'|3;'2024-01-14T00:00:00'|3;'2024-01-19T00:00:00'|3;'2024-01-05T00:00:00'|4;'2024-01-10T00:00:00'|4;'2024-01-15T00:00:00'|4;'2024-01-20T00:00:00'|4
// expect: same: error 1476
// expect: same: DT,N = '2024-01-01T00:00:00'|150;'2024-01-02T00:00:00'|150;'2024-01-03T00:00:00'|150
// expect: same: DT = '2024-01-01T00:00:00';'2024-01-02T00:00:00';'2024-01-03T00:00:00';'2024-01-04T00:00:00';'2024-01-05T00:00:00';'2024-01-06T00:00:00';'2024-01-07T00:00:00';'2024-01-08T00:00:00';'2024-01-09T00:00:00';'2024-01-10T00:00:00';'2024-01-11T00:00:00';'2024-01-12T00:00:00';'2024-01-13T00:00:00';'2024-01-14T00:00:00';'2024-01-15T00:00:00';'2024-01-16T00:00:00';'2024-01-17T00:00:00';'2024-01-18T00:00:00';'2024-01-19T00:00:00';'2024-01-20T00:00:00'
// expect: same: N = 77468
// expect: same: N = 0
// expect: same: N = 77518
// expect: same: N = 77468
// expect: same: N = 3908
// expect: same: N = 603
// expect: same: ID,N = 1|39;2|39;3|38
// expect: same: error 1476
// expect: same: N = 77508
// expect: same: A,W = 1|'w1';2|'w2';3|'w3';4|'w4';5|'w5'
// expect: same: A,W = 3|'w3';3|'w3';2000|NULL;NULL|NULL
// expect: same: A,W = 1|'w1';2|'w2';3|'w3';4|'w4';5|'w5'
// expect: same: A,W = 1|'w1';2|'w2'
// expect: same: error 1476
// expect: same: W = 'w1';'w2'
// expect: same: G,N = 0|75;1|75;2|75;3|75;4|75;5|75;6|75;7|75;8|75;9|75;10|75;11|75;12|75;13|75;14|75;15|75;16|75;17|75;18|75;19|75
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table dg (i number(10))\ninsert into dg values (0)\ninsert into dg values (1)\ninsert into dg values (2)\ninsert into dg values (3)\ninsert into dg values (4)\ninsert into dg values (5)\ninsert into dg values (6)\ninsert into dg values (7)\ninsert into dg values (8)\ninsert into dg values (9)\ncreate table t (id number(10) primary key, v number(10), w varchar2(10))\ninsert into t select n, n * 7, 'w' || n from (select p.i + q.i * 10 + r.i * 100 + 1 n from dg p cross join dg q cross join dg r) z where n <= 1000\ncreate table f (id number(10) primary key, x number(10), nu number(10,2), dt date, fl binary_double, z number(10))\ninsert into f select n, case when mod(n, 17) = 0 then null else mod(n, 37) end, case when mod(n, 19) = 0 then null else mod(n, 30) + 0.5 end, date '2024-01-01' + mod(n, 20), mod(n, 9) / 4, mod(n, 5) from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 3000\ncreate table p (id number(10) primary key, t varchar2(8), vc varchar2(8))\ninsert into p select n, case when mod(n, 31) = 0 then null else 'k' || mod(n, 50) end, 'k' || mod(n, 30) from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 2000\ninsert into p values (3001, null, null)\ninsert into p values (3002, 'zz', 'zz')\ncreate table a (id number(10) primary key, x number(10), y varchar2(5))\ncreate index a_x on a (x)\ninsert into a select n, mod(n, 40), 'y' || mod(n, 7) from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 3000\ncreate table emp (id number(10) primary key, boss number(10), name varchar2(5))\ninsert into emp values (1, null, 'a')\ninsert into emp values (2, 1, 'b')\ninsert into emp values (3, 1, 'c')\ninsert into emp values (4, 2, 'd')\ninsert into emp values (5, 4, 'e')\ninsert into emp values (6, 5, 'f')"

const QS = "select distinct dt from f where x > 17 and id < 446 order by dt\nselect distinct nu from f where id < 2000 order by nu offset 3 rows fetch next 7 rows only\nselect distinct nu from f order by nu desc nulls last\nselect distinct nu from f order by nu nulls first\nselect distinct case when z = 1 then nu end c from f where id < 1500 order by 1\nselect distinct fl from f order by fl\nselect distinct dt, z from f where id < 700 order by z, dt\nselect distinct 10 / (id - 1500) q from f\nselect dt, count(*) n from f group by dt order by dt fetch first 3 rows only\nselect distinct f.dt from f join t on t.id = f.x where f.id < 800 order by 1\nselect count(*) n from p o join p i on i.t = o.vc\nselect count(*) n from p o join p i on i.t = o.t || 'x'\nselect count(*) n from p o join p i on i.t = 'k' || mod(o.id, 50)\nselect count(*) n from p o join p i on i.t = lower(upper(o.vc))\nselect count(*) n from p o left join p i on i.vc = o.t where o.id < 100\nselect count(*) n from p o where exists (select 1 from p i where i.t = o.vc and i.id < 10)\nselect o.id, (select count(*) from p i where i.t = o.vc) n from p o where o.id < 4 order by 1\nselect count(*) n from p o join p i on i.t = case when o.id = 1500 then to_char(o.id / 0) else o.t end\nselect count(*) n from p o join p i on i.t = nvl(o.t, 'k1')\nselect v.a, t.w from (select 1 a from dual union all select 2 from dual union all select 3 from dual union all select 4 from dual union all select 5 from dual) v join t on t.id = v.a order by 1\nselect v.a, t.w from (select 3 a from dual union all select null from dual union all select 2000 from dual union all select 3 from dual) v left join t on t.id = v.a order by 1, 2\nselect v.a, t.w from (select 1 a from dual union all select 2 from dual union all select 3 from dual union all select 4 from dual union all select 5 from dual) v join t on t.v = v.a * 7 order by 1\nselect v.a, t.w from (select 1 a from dual union all select 2 from dual union all select 3 from dual union all select 4 from dual union all select 5 from dual) v join t on t.id = v.a order by 1 fetch first 2 rows only\nselect v.a, t.w from (select 1 a from dual union all select 2 from dual union all select 0 from dual union all select 4 from dual) v join t on t.id = 10 / v.a order by 1\nselect distinct t.w from (select 1 a from dual union all select 2 from dual union all select 1 from dual) v join t on t.id = v.a order by 1\nselect d.g, count(*) n from (select distinct mod(v, 20) g from t) d join a on a.x = d.g group by d.g order by 1"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(54), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
