// lexdb_exec: tables without a primary key, CREATE TABLE AS and SELECT INTO,
// checked against PostgreSQL 18 (generated by tests/lexdb/gen_pg.py from
// keyless_queries.txt): duplicate rows, UPDATE, DELETE, RETURNING, joins,
// indexes and ON CONFLICT on them, a view, the catalog not showing the hidden
// key, a foreign key to one refused; the forms of CREATE TABLE ... AS and
// SELECT INTO, their column names and types, WITH NO DATA, in a block (9.88).
// Each expect line: a query's rows or tag, or ERROR and its SQLSTATE.
// expect: CREATE TABLE
// expect: INSERT 0 4
// expect: 1|x|1.50;1|x|1.50;2|y|;|z|3.00
// expect: 4|2
// expect: |only b|;INSERT 0 1
// expect: UPDATE 2
// expect: 1|x|9.00;1|x|9.00
// expect: DELETE 1
// expect: 2|y|
// expect: 1;1;1;1;2
// expect: ERROR 23505
// expect: CREATE INDEX
// expect: INSERT 0 1
// expect: ERROR 42P10
// expect: 5
// expect: CREATE VIEW
// expect: 1|x|9.00;1|x|9.00;2|y|;5|five|5.00
// expect: a|1;b|2;c|3
// expect: a;b;c
// expect: nk|r;nk_a|i;nkv|v
// expect: 1
// expect: 
// expect: ERROR 42704
// expect: ALTER TABLE
// expect: 2|y||4
// expect: SELECT 4
// expect: 1|x|10;1|x|10;2|y|20;5|five|50
// expect: SELECT 2
// expect: 1|one;2|two
// expect: CREATE TABLE AS
// expect: 0
// expect: SELECT 0
// expect: q|text
// expect: ERROR 42601
// expect: ERROR 42P07
// expect: CREATE TABLE AS
// expect: SELECT 4
// expect: 1|2;2|1;5|1;|1
// expect: SELECT 1
// expect: x
// expect: SELECT 1
// expect: 3|6
// expect: SELECT 2
// expect: 1|x;1|x
// expect: SELECT 1
// expect: 1|two
// expect: a|integer;n|bigint
// expect: BEGIN
// expect: SELECT 1
// expect: INSERT 0 1
// expect: 7;8
// expect: ROLLBACK
// expect: 0
// expect: ERROR 42701
// expect: DROP TABLE
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table nk (a int, b text, c numeric(6,2))\ninsert into nk values (1, 'x', 1.5), (1, 'x', 1.5), (2, 'y', null), (null, 'z', 3)\nselect * from nk order by a, b\nselect count(*), count(distinct a) from nk\ninsert into nk (b) values ('only b') returning *\nupdate nk set c = 9 where a = 1\nselect a, b, c from nk where a = 1\ndelete from nk where b = 'only b'\nselect nk.* from nk where a = 2\nselect t.a from nk t join nk u on t.a = u.a order by 1\ncreate unique index nk_b_c on nk (b, c)\ncreate index nk_a on nk (a)\ninsert into nk values (5, 'five', 5) on conflict do nothing\ninsert into nk values (5, 'five', 5) on conflict (b, c) do update set a = excluded.a + 1\nselect a from nk where b = 'five'\ncreate view nkv as select * from nk where a is not null\nselect * from nkv order by a, b\nselect column_name, ordinal_position from information_schema.columns where table_name = 'nk' order by 2\nselect attname from pg_attribute where attrelid = 'nk'::regclass and attnum > 0 order by attnum\nselect relname, relkind from pg_class where relname like 'nk%' order by 1\nselect count(*) from pg_indexes where tablename = 'nk'\nselect conname from pg_constraint where conrelid = 'nk'::regclass\ncreate table child (x int references nk)\nalter table nk add column d int default 4\nselect * from nk where a = 2\ncreate table ct as select a, b, a * 10 as ten from nk where a is not null\nselect * from ct order by a, b\ncreate table ct2 (x, y) as values (1, 'one'), (2, 'two')\nselect * from ct2 order by x\ncreate table ct3 as select * from ct with no data\nselect count(*) from ct3\ncreate table ct4 (q) as select b from nk where false\nselect column_name, data_type from information_schema.columns where table_name = 'ct4' order by ordinal_position\ncreate table ct5 (x, y, z) as select 1, 2\ncreate table ct as select 1\ncreate table if not exists ct as select 1\ncreate table ct6 as select a, count(*) as n from nk group by a order by a\nselect * from ct6 order by a\ncreate table ct7 as (select b from nk where a = 1 limit 1)\nselect * from ct7\ncreate table ct8 as with w as (select 3 as v) select v, v * 2 as w2 from w\nselect * from ct8\nselect a, b into ct9 from nk where a = 1\nselect * from ct9\nselect 1 as one, 'two'::text as two into table ct10\nselect * from ct10\nselect column_name, data_type from information_schema.columns where table_name = 'ct6' order by ordinal_position\nbegin\ncreate table ct11 as select 7 as s\ninsert into ct11 values (8)\nselect * from ct11 order by s\nrollback\nselect count(*) from pg_class where relname = 'ct11'\ncreate table dup as select 1 as a, 2 as a\ndrop table ct, ct2, ct3, ct4, ct6, ct7, ct8, ct9, ct10"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(88), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
