// lexdb over TNS: IS [NOT] DISTINCT FROM in the Oracle door, lexdb's extension (the user's decision, 2026-11-23,
// design/lexdb-new-features.md O24): Oracle 23.26/26ai has no IS DISTINCT FROM (ORA-00908) but the other two doors have it, and
// lexdb keeps it in this one. Each query is followed by its Oracle equivalent with DECODE (which treats two NULLs as equal),
// and both must give the same rows, with Oracle's '' as NULL, over numbers, texts and dates, in WHERE, CASE, NOT, a join and an
// UPDATE. Not in gen_oracle.py's CHECKED: Oracle refuses the first of each pair. Each statement runs with set lexdb_batch = off
// (the row engine) and on: "same" and the answer, or DIFFERENT and both.
// expect: setup: 7 statements
// expect: same: ID = 2;3;4
// expect: same: ID = 2;3;4
// expect: same: ID = 1;5;6
// expect: same: ID = 1;5;6
// expect: same: ID = 2;3;4;6
// expect: same: ID = 2;3;4;6
// expect: same: ID = 1;5
// expect: same: ID = 1;5
// expect: same: ID = 2;3;4
// expect: same: ID = 2;3;4
// expect: same: ID = 3;4;5
// expect: same: ID = 3;4;5
// expect: same: ID = 3;5
// expect: same: ID = 3;5
// expect: same: ID = 1;5;6
// expect: same: ID = 1;5;6
// expect: same: ID,K = 1|0;2|1;3|1;4|1;5|0;6|0
// expect: same: ID,K = 1|0;2|1;3|1;4|1;5|0;6|0
// expect: same: XI,YI = 1|1;1|3;2|1;2|3;3|4;3|5
// expect: same: XI,YI = 1|1;1|3;2|1;2|3;3|4;3|5
// expect: same: N = 4
// expect: same: N = 4
// expect: same: ID = 6
// expect: same: ID = 6
// expect: same: 2 / ID,B = 1|1;2|2;3|9;4|NULL;5|9;6|2
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table dt (id number(10) primary key, a number, b number, s varchar2(10), u varchar2(10), d date, e date)\ninsert into dt values (1, 1, 1, 'x', 'x', date '2024-03-05', date '2024-03-05')\ninsert into dt values (2, 1, 2, 'x', 'y', date '2024-03-05', date '2024-03-06')\ninsert into dt values (3, null, 1, null, 'x', null, date '2024-03-05')\ninsert into dt values (4, 1, null, '', 'x', date '2024-03-05', null)\ninsert into dt values (5, null, null, '', null, null, null)\ninsert into dt values (6, 2, 2, 'y', '', date '2024-03-06', date '2024-03-06')"

const QS = "select id from dt where a is distinct from b order by id\nselect id from dt where decode(a, b, 0, 1) = 1 order by id\nselect id from dt where a is not distinct from b order by id\nselect id from dt where decode(a, b, 0, 1) = 0 order by id\nselect id from dt where s is distinct from u order by id\nselect id from dt where decode(s, u, 0, 1) = 1 order by id\nselect id from dt where s is not distinct from u order by id\nselect id from dt where decode(s, u, 0, 1) = 0 order by id\nselect id from dt where d is distinct from e order by id\nselect id from dt where decode(d, e, 0, 1) = 1 order by id\nselect id from dt where s is not distinct from '' order by id\nselect id from dt where decode(s, '', 0, 1) = 0 order by id\nselect id from dt where a is not distinct from null order by id\nselect id from dt where decode(a, null, 0, 1) = 0 order by id\nselect id from dt where not (a is distinct from b) order by id\nselect id from dt where not (decode(a, b, 0, 1) = 1) order by id\nselect id, case when a is distinct from b then 1 else 0 end k from dt order by id\nselect id, decode(a, b, 0, 1) k from dt order by id\nselect x.id xi, y.id yi from dt x join dt y on x.a is not distinct from y.b where x.id <= 3 order by 1, 2\nselect x.id xi, y.id yi from dt x join dt y on decode(x.a, y.b, 0, 1) = 0 where x.id <= 3 order by 1, 2\nselect count(*) n from dt where a + 1 is distinct from b * 2\nselect count(*) n from dt where decode(a + 1, b * 2, 0, 1) = 1\nselect id from dt where a is distinct from 1 and s is not distinct from 'y' order by id\nselect id from dt where decode(a, 1, 0, 1) = 1 and decode(s, 'y', 0, 1) = 0 order by id\nupdate dt set b = 9 where a is not distinct from null ;; select id, b from dt order by id"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(55), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
