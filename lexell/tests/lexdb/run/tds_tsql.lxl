// lexdb over TDS: the T-SQL query surface, checked against SQL Server 2022
// (generated by tests/lexdb/gen_mssql.py from mssql_tsql_queries.txt): TOP,
// string +, IDENTITY and SCOPE_IDENTITY, OFFSET ... FETCH, SELECT ... INTO, the
// common functions, SQL Server's types, and the names of a result's columns.
// Each expect line: a batch's result sets and counts, or its error number.
// expect: ok
// expect: (1)
// expect: id,ident: 1|1
// expect: (4)
// expect: : 5
// expect: name: 'Ann';'Bob'
// expect: id: 1;2;3
// expect: (1) / name: 'Ann';'Bob'
// expect: name: 'Ann';'Bob';'Cy'
// expect: dept: 'Ops';'Ops'
// expect: name: 'Bob';'Cy'
// expect: name: 'Di';'Ed'
// expect: name: 'Ann'
// expect: : 'Ann (Eng)';'Bob (Eng)';'Cy (Ops)';NULL;'Ed (Ops)'
// expect: label: 'Ann Eng';'Bob Eng';'Cy Ops';'Di none';'Ed Ops'
// expect: ,,,: 'ab'|3|3|NULL
// expect: ,,,,: 3|0|6|3|NULL
// expect: ,,,,: 2|4|0|2|3
// expect: ,,,,,,: 'ell'|'he'|'llo'|'ABC'|'abc'|'a '|' a'
// expect: ,,,: 'a-b-'|'ababab'|'cba'|'aXYef'
// expect: ,,,: 'x'|'x   y'|'a1b'|'a-b'
// expect: ,,,,: 5|3|NULL|'yes'|'b'
// expect: ,,,,: 12.3|42|3|7|'123'
// expect: ,,: NULL|12|NULL
// expect: ,,,,: '03/05/2024'|'05/03/2024'|'2024-03-05 13:04:05'|'20240305'|'2024-03-05T13:04:05.123'
// expect: ,,,: '2024-03-06'|'2024-02-29'|'2023-02-28'|'2024-03-06 02:00:00.0000000'
// expect: ,,,: 60|1|1|90
// expect: ,,,,,,: 2024|3|3|5|3|2024|'March'
// expect: ,,,: '2024-02-29'|'2024-02-29'|'2024-03-05'|'13:04:05.0000000'
// expect: ,,,: 1|1|1|1
// expect: ,,,,,,,,,,: 3|2.570|3.0|3|-3|1024|4|3|1|3.500000|-1
// expect: ,,,,,,: true|false|'x'|1.5|2|3|4
// expect: : '0E984725-C51C-4BF4-9960-E1C80E27ABA0'
// expect: ,,: 12.5000|'2024-03-05 13:04:05.1234560'|'2024-03-05 13:04:05.123'
// expect: name,salary: 'Ann'|120000.00;'Cy'|70000.00;'Ed'|72000.00
// expect: dept,n,total,avg: NULL|1|88000.00|88000.000000;'Eng'|2|215000.50|107500.250000;'Ops'|2|142000.00|71000.000000
// expect: ,,,: 5|4|'Ed'|'2018-11-30'
// expect: (4)
// expect: id,name: 1|'Ann';2|'Bob';4|'Di';5|'Ed'
// expect: a,,x,y z: 1|2|5|'six'
// expect: Full Name: 'Ann'
// expect: : 'Ann,Bob,Cy,Di,Ed'
// expect: name: 'Ann';'Bob'
// expect: name: 'Cy';'Di';'Ed'
// expect: (2)
// expect: name,salary: 'Cy'|77000.00;'Ed'|79200.00
// expect: (1)
// expect: : 1
// expect: id,name,dept,salary,hired,active: 5|'Ed'|'Ops'|79200.00|'2022-07-04'|true
// expect: error 515
// expect: (1)
// expect: (1) / : 101
// expect: id,name: 1|'Ann';2|'Bob';4|'Di';5|'Ed';100|'Zed';101|'Next'
// expect: (1)
// expect: name: 'Di'
// expect: : 1
// expect: ,,: 1|'dbo'|1
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "CREATE TABLE emp (id int IDENTITY(1,1) PRIMARY KEY, name nvarchar(50) NOT NULL, dept nvarchar(20), salary decimal(10,2), hired date, active bit)\nINSERT INTO emp (name, dept, salary, hired, active) VALUES (N'Ann', N'Eng', 120000.00, '2020-01-15', 1)\nSELECT SCOPE_IDENTITY() AS id, @@IDENTITY AS ident\nINSERT INTO emp (name, dept, salary, hired, active) VALUES (N'Bob', N'Eng', 95000.50, '2019-06-01', 1), (N'Cy', N'Ops', 70000, '2021-03-10', 0), (N'Di', NULL, 88000, '2018-11-30', 1), (N'Ed', N'Ops', 72000, '2022-07-04', 1)\nSELECT SCOPE_IDENTITY()\nSELECT TOP 2 name FROM emp ORDER BY salary DESC\nSELECT TOP (3) id FROM emp ORDER BY id\nDECLARE @n int = 2; SELECT TOP (@n) name FROM emp ORDER BY name\nSELECT TOP 50 PERCENT name FROM emp ORDER BY id\nSELECT TOP 2 WITH TIES dept FROM emp ORDER BY dept DESC\nSELECT name FROM emp ORDER BY id OFFSET 1 ROWS FETCH NEXT 2 ROWS ONLY\nSELECT name FROM emp ORDER BY id OFFSET 3 ROWS\nSELECT name FROM emp ORDER BY id OFFSET 0 ROWS FETCH FIRST 1 ROW ONLY\nSELECT name + N' (' + dept + N')' FROM emp ORDER BY id\nSELECT name + N' ' + ISNULL(dept, N'none') AS label FROM emp ORDER BY id\nSELECT 'a' + 'b', 1 + 2, '1' + 2, 'x' + NULL\nSELECT LEN(N'abc  '), LEN(N''), DATALENGTH(N'abc'), LEN(123), LEN(NULL)\nSELECT CHARINDEX('b', 'abcb'), CHARINDEX('b', 'abcb', 3), CHARINDEX('z', 'abc'), CHARINDEX('B', 'abc'), PATINDEX('%c%', 'abc')\nSELECT SUBSTRING('hello', 2, 3), LEFT('hello', 2), RIGHT('hello', 3), UPPER('abc'), LOWER('ABC'), LTRIM('  a '), RTRIM(' a  ')\nSELECT REPLACE('aXbx', 'x', '-'), REPLICATE('ab', 3), REVERSE('abc'), STUFF('abcdef', 2, 3, 'XY')\nSELECT TRIM('  x  '), 'x' + SPACE(3) + 'y', CONCAT('a', NULL, 1, 'b'), CONCAT_WS('-', 'a', NULL, 'b')\nSELECT ISNULL(NULL, 5), COALESCE(NULL, NULL, 3), NULLIF(1, 1), IIF(1 < 2, 'yes', 'no'), CHOOSE(2, 'a', 'b', 'c')\nSELECT CAST(12.345 AS decimal(5,1)), CAST('42' AS int), CAST(3.9 AS int), CONVERT(int, '7'), CONVERT(varchar(10), 123)\nSELECT TRY_CAST('abc' AS int), TRY_CONVERT(int, '12'), TRY_CAST('2024-02-30' AS date)\nSELECT CONVERT(varchar(10), CAST('2024-03-05' AS date), 101), CONVERT(varchar(10), CAST('2024-03-05' AS date), 103), CONVERT(varchar(30), CAST('2024-03-05 13:04:05' AS datetime), 120), CONVERT(varchar(10), CAST('2024-03-05' AS date), 112), CONVERT(varchar(30), CAST('2024-03-05 13:04:05.123' AS datetime), 126)\nSELECT DATEADD(day, 10, CAST('2024-02-25' AS date)), DATEADD(month, 1, CAST('2024-01-31' AS date)), DATEADD(year, -1, CAST('2024-02-29' AS date)), DATEADD(hour, 3, CAST('2024-03-05 23:00' AS datetime2))\nSELECT DATEDIFF(day, '2024-01-01', '2024-03-01'), DATEDIFF(month, '2024-01-31', '2024-02-01'), DATEDIFF(year, '2023-12-31', '2024-01-01'), DATEDIFF(minute, '2024-01-01 10:00', '2024-01-01 11:30')\nSELECT DATEPART(year, '2024-03-05'), DATEPART(month, '2024-03-05'), DATEPART(weekday, '2024-03-05'), DAY('2024-03-05'), MONTH('2024-03-05'), YEAR('2024-03-05'), DATENAME(month, '2024-03-05')\nSELECT EOMONTH('2024-02-10'), DATEFROMPARTS(2024, 2, 29), CAST(CAST('2024-03-05 13:04:05' AS datetime2) AS date), CAST(CAST('2024-03-05 13:04:05' AS datetime2) AS time)\nSELECT CASE WHEN GETDATE() > '2020-01-01' THEN 1 ELSE 0 END, CASE WHEN SYSDATETIME() > '2020-01-01' THEN 1 ELSE 0 END, CASE WHEN GETUTCDATE() > '2020-01-01' THEN 1 ELSE 0 END, CASE WHEN CURRENT_TIMESTAMP > '2020-01-01' THEN 1 ELSE 0 END\nSELECT ABS(-3), ROUND(2.567, 2), ROUND(2.5, 0), CEILING(2.1), FLOOR(-2.1), POWER(2, 10), SQRT(16.0), 7 / 2, 7 % 3, 7.0 / 2, SIGN(-4)\nSELECT CAST(1 AS bit), CAST(0 AS bit), CAST(N'x' AS nvarchar(5)), CAST(1.5 AS float), CAST(2 AS bigint), CAST(3 AS smallint), CAST(4 AS tinyint)\nSELECT CAST('0E984725-C51C-4BF4-9960-E1C80E27ABA0' AS uniqueidentifier)\nSELECT CAST(12.5 AS money), CAST('2024-03-05 13:04:05.123456' AS datetime2), CAST('2024-03-05 13:04:05.123' AS datetime)\nSELECT name, salary FROM emp WHERE hired >= '2020-01-01' ORDER BY hired\nSELECT dept, COUNT(*) AS n, SUM(salary) AS total, AVG(salary) AS avg FROM emp GROUP BY dept ORDER BY dept\nSELECT COUNT(*), COUNT(dept), MAX(name), MIN(hired) FROM emp\nSELECT id, name INTO emp_copy FROM emp WHERE active = 1\nSELECT * FROM emp_copy ORDER BY id\nSELECT 1 AS a, 2, x = 5, 'six' AS [y z]\nSELECT name AS 'Full Name' FROM emp WHERE id = 1\nSELECT STRING_AGG(name, ',') WITHIN GROUP (ORDER BY name) FROM emp\nSELECT name FROM emp WHERE name LIKE N'[AB]%' ORDER BY name\nSELECT name FROM emp WHERE name LIKE N'[^AB]_' ORDER BY name\nUPDATE emp SET salary = salary * 1.1 WHERE dept = N'Ops'\nSELECT name, salary FROM emp WHERE dept = N'ops' ORDER BY id\nDELETE FROM emp WHERE active = 0\nSELECT @@ROWCOUNT\nSELECT TOP 1 * FROM emp ORDER BY id DESC\nINSERT INTO emp (name) VALUES (NULL)\nSET IDENTITY_INSERT emp ON; INSERT INTO emp (id, name) VALUES (100, N'Zed'); SET IDENTITY_INSERT emp OFF\nINSERT INTO emp (name) VALUES (N'Next'); SELECT SCOPE_IDENTITY()\nSELECT id, name FROM emp ORDER BY id\nUPDATE TOP (1) emp SET dept = N'X' WHERE dept IS NULL\nSELECT name FROM emp WHERE dept = N'X'\nSELECT CASE WHEN @@VERSION LIKE '%SQL Server%' OR @@VERSION LIKE '%lexdb%' THEN 1 ELSE 0 END\nSELECT CASE WHEN DB_NAME() LIKE 'lexdb%' THEN 1 ELSE 0 END, SCHEMA_NAME(), CASE WHEN USER_NAME() IS NOT NULL THEN 1 ELSE 0 END"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(q.toStr(), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(dsn.toStr()) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(31), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000, bufferedPages: false}, body).unwrap()
        }
    }
}
