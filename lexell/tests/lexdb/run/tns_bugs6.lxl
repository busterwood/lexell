// lexdb over TNS: the sixth bug slice (design/lexdb-robust.md, "The sixth bug slice"; KNOWN-ISSUES.md), checked against Oracle Database Free
// 23.26 (gen_oracle.py --check tns_bugs6): quoted names are exact ("qt" and QT two tables, "MixT" not found as mixt, quoted lower-case and
// mixed-case columns, indexes, constraints, sequences, views, a quoted function's call "MixF"(2), the dictionary views' columns); nested
// subprograms in stored units (access to the enclosing variables, recursion, forward declarations, in a package body's member, errors in
// USER_ERRORS); DROP TABLE under a view (the view INVALID, ORA-04063, ORA-00942 in USER_ERRORS, back when the table is made again); a SELECT
// with a parenthesis left open before INTO in a stored unit (ORA-00907). Each statement runs with set lexdb_batch = off (the row engine) and
// on: "same" and the answer, or DIFFERENT and both.
// expect: setup: 25 statements
// expect: same: TABLE_NAME = 'MixT';'QT';'qt'
// expect: same: A = 10
// expect: same: B = 20
// expect: same: A = 10
// expect: same: error 942
// expect: same: Col,low,UP = 1|2|3
// expect: same: Col,low,UP,UP = 1|2|3|3
// expect: same: error 904
// expect: same: error 904
// expect: same: COLUMN_NAME = 'Col';'low';'UP'
// expect: same: Col,lo2,UP = 1|2|3
// expect: same: lo2 = 2
// expect: same: error 904
// expect: same: error 942
// expect: same: COLUMN_NAME = 'Col';'lo2';'UP'
// expect: same: INDEX_NAME,TABLE_NAME = 'IXMIX'|'QT';'ixMix'|'MixT'
// expect: same: N = 0
// expect: same: error 2289
// expect: same: "MIXF"(2) = 3
// expect: same: error 904
// expect: same: Id,name,SAL = 1|'x'|10
// expect: same: error 2290
// expect: same: error 2290
// expect: same: 1 / ID,empId = 1|1
// expect: same: error 2291
// expect: same: CONSTRAINT_NAME,CONSTRAINT_TYPE = 'ckLow'|'C'
// expect: same: name = 'x'
// expect: same: error 904
// expect: same: a,A = 1|2
// expect: same: a = 1
// expect: same: error 904
// expect: same: error 904
// expect: same: TABLE_NAME = 'MixT'
// expect: same: 0 / 0 / COLUMN_NAME = 'Col';'low';'UP';'extra2' / 0
// expect: same: 0 / 0 / TABLE_NAME = 'tmp6b' / 0
// expect: same: 0 / 0 / B = 25
// expect: same: OBJECT_NAME,STATUS = 'EVN'|'VALID';'FACT'|'VALID';'NEST2'|'VALID';'NP1'|'VALID';'NP1W'|'VALID';'PK6'|'VALID';'PK6'|'VALID'
// expect: same: F = 120
// expect: same: A,B = 1|0
// expect: same: A = 76
// expect: same: N = 12
// expect: same: R = 20
// expect: same: 0 / A = 33
// expect: same: 0
// expect: same: OBJECT_NAME,STATUS = 'NBAD'|'INVALID'
// expect: same: LINE,POSITION,TEXT = 1|44|'PLS-00201: identifier ''X'' must be declared';1|44|'PL/SQL: Statement ignored'
// expect: same: 0
// expect: same: N = 201
// expect: same: 0
// expect: same: OBJECT_NAME,STATUS = 'NSCOPE'|'VALID';'NSELF'|'VALID'
// expect: same: 0 / 1 / 0 / 0 / OBJECT_NAME,STATUS = 'DTV2'|'INVALID'
// expect: same: error 4063
// expect: same: NAME,TYPE,TEXT = 'DTV2'|'VIEW'|'ORA-00942: table or view "APP"."DT2" does not exist'
// expect: same: 0 / N = 0 / OBJECT_NAME,STATUS = 'DTV2'|'VALID' / 0
// expect: same: A = 5
// expect: same: 0
// expect: same: LINE,POSITION,TEXT = 1|49|'PL/SQL: ORA-00907: missing right parenthesis';1|34|'PL/SQL: SQL Statement ignored'
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table qt (a number)\ncreate table \"qt\" (b number)\ninsert into qt values (10)\ninsert into \"qt\" values (20)\ncreate table \"MixT\" (\"Col\" number, \"low\" number, up number)\ninsert into \"MixT\" values (1, 2, 3)\ncreate view \"vMix\" as select \"Col\", \"low\" \"lo2\", up from \"MixT\"\ncreate index \"ixMix\" on \"MixT\" (\"low\")\ncreate index ixmix on qt (a)\ncreate sequence \"sq\"\ncreate or replace function \"MixF\" (n number) return number is begin return n + 1; end;\ncreate table \"Emp\" (\"Id\" number primary key, \"name\" varchar2(20) default 'x' not null, sal number check (sal > -100), constraint \"ckLow\" check (sal >= 0))\ninsert into \"Emp\" (\"Id\", sal) values (1, 10)\ncreate table kid (id number primary key, \"empId\" number references \"Emp\" (\"Id\"))\ncreate or replace procedure np1 (n number, r out number) is v number := 10; function sq(x number) return number is begin return x * x + v; end; procedure bump is begin v := v + 1; end; begin bump; r := sq(n); end;\ncreate or replace function np1w (n number) return number is r number; begin np1(n, r); return r; end;\ncreate or replace function fact (n number) return number is function f(k number) return number is begin if k <= 1 then return 1; end if; return k * f(k - 1); end; begin return f(n); end;\ncreate or replace function evn (n number) return number is function isodd(k number) return number; function iseven(k number) return number is begin if k = 0 then return 1; end if; return isodd(k - 1); end; function isodd(k number) return number is begin if k = 0 then return 0; end if; return iseven(k - 1); end; begin return iseven(n); end;\ncreate or replace package pk6 as function g(n number) return number; end;\ncreate or replace package body pk6 as cnt number := 0; function g(n number) return number is function h(m number) return number is begin cnt := cnt + 1; return m + cnt; end; begin cnt := 5; return h(n) * 10 + cnt; end; end;\ncreate or replace function nest2 (n number) return number is t number := 0; procedure addto(k number) is procedure inner2 is begin t := t + k; end; begin inner2; inner2; end; begin for i in 1..n loop addto(i); end loop; return t; end;\ncreate table dt (a number)\ninsert into dt values (5)\ncreate view dtv as select a from dt\ncreate view dtvv as select a from dtv"

const QS = "select table_name from user_tables where table_name in ('QT', 'qt', 'MixT') order by 1\nselect a from qt\nselect b from \"qt\"\nselect * from \"QT\"\nselect * from mixt\nselect * from \"MixT\"\nselect \"Col\", \"low\", up, \"UP\" from \"MixT\"\nselect col from \"MixT\"\nselect \"COL\" from \"MixT\"\nselect column_name from user_tab_columns where table_name = 'MixT' order by column_id\nselect * from \"vMix\"\nselect \"lo2\" from \"vMix\"\nselect lo2 from \"vMix\"\nselect * from vmix\nselect column_name from user_tab_columns where table_name = 'vMix' order by column_id\nselect index_name, table_name from user_indexes where index_name in ('ixMix', 'IXMIX') order by 1\nselect \"sq\".nextval - \"sq\".currval n from dual\nselect sq.nextval from dual\nselect \"MixF\"(2) from dual\nselect mixf(2) from dual\nselect \"Id\", \"name\", sal from \"Emp\"\ninsert into \"Emp\" (\"Id\", sal) values (2, -1)\ninsert into \"Emp\" (\"Id\", sal) values (3, -200)\ninsert into kid values (1, 1) ;; select id, \"empId\" from kid\ninsert into kid values (2, 99)\nselect constraint_name, constraint_type from user_constraints where table_name = 'Emp' and constraint_name = 'ckLow'\nselect e.\"name\" from \"Emp\" e where e.\"Id\" = 1\nselect e.name from \"Emp\" e where e.\"Id\" = 1\nselect 1 \"a\", 2 a from dual\nselect x.\"a\" from (select 1 \"a\" from dual) x\nselect x.a from (select 1 \"a\" from dual) x\nselect \"table_name\" from user_tables where rownum = 1\nselect \"TABLE_NAME\" from user_tables where table_name = 'MixT'\nalter table \"MixT\" add (\"Extra\" number) ;; alter table \"MixT\" rename column \"Extra\" to \"extra2\" ;; select column_name from user_tab_columns where table_name = 'MixT' order by column_id ;; alter table \"MixT\" drop column \"extra2\"\ncreate table \"Tmp6\" (x number) ;; rename \"Tmp6\" to \"tmp6b\" ;; select table_name from user_tables where lower(table_name) like 'tmp6%' ;; drop table \"tmp6b\"\ncreate or replace procedure \"upQ\" (p number) is begin update \"qt\" set b = b + p; end; ;; begin \"upQ\"(5); end; ;; select b from \"qt\"\nselect object_name, status from user_objects where object_name in ('NP1', 'NP1W', 'FACT', 'EVN', 'PK6', 'NEST2') order by 1, 2\nselect fact(5) f from dual\nselect evn(4) a, evn(7) b from dual\nselect pk6.g(1) a from dual\nselect nest2(3) n from dual\nselect np1w(3) r from dual\ndeclare k number := 2; v number; function f(x number) return number is begin return x * 3 + k; end; procedure g is begin k := k + 1; end; begin g; v := f(10); update qt set a = v; end; ;; select a from qt\ncreate or replace procedure nbad is procedure inner is begin x := 1; end; begin inner; end;\nselect object_name, status from user_objects where object_name = 'NBAD'\nselect line, position, text from user_errors where name = 'NBAD' order by sequence\ncreate or replace function nself (n number) return number is function nself(k number) return number is begin return k * 100; end; begin return nself(n) + 1; end;\nselect nself(2) n from dual\ncreate or replace procedure nscope is procedure a1 is begin null; end; begin declare procedure b1 is begin a1; end; begin b1; end; end;\nselect object_name, status from user_objects where object_name in ('NSELF', 'NSCOPE') order by 1\ncreate table dt2 (a number) ;; insert into dt2 values (1) ;; create or replace view dtv2 as select a from dt2 ;; drop table dt2 ;; select object_name, status from user_objects where object_name = 'DTV2'\nselect count(*) n from dtv2\nselect name, type, rtrim(text, chr(10)) text from user_errors where name = 'DTV2' order by sequence\ncreate table dt2 (a number) ;; select count(*) n from dtv2 ;; select object_name, status from user_objects where object_name = 'DTV2' ;; drop table dt2\nselect a from dtvv\ncreate or replace procedure pin is n number; begin select count(* into n from dt; end;\nselect line, position, text from user_errors where name = 'PIN' order by sequence"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(160), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
