import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once CREATE TABLE x1 (a int, b int)\n@once CREATE TABLE x2 (a int, b int)\n@once CREATE INDEX ix ON x1 (a)\n@once CREATE INDEX ix ON x2 (a)\nCREATE INDEX ix ON x2 (b)\nCREATE TABLE x3 (a int, b int, INDEX i3 (a), INDEX i3 (b))\nCREATE TABLE x4 (a int, b int, INDEX c1 CLUSTERED (a), INDEX c2 CLUSTERED (b))\nCREATE TABLE x5 (a int PRIMARY KEY CLUSTERED, b int, INDEX c1 CLUSTERED (b))\nSELECT o.name AS t, i.name, i.index_id FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name IN ('x1', 'x2') AND i.name IS NOT NULL ORDER BY 1, 2\nSELECT INDEXPROPERTY(OBJECT_ID('x2'), 'ix', 'IndexID') AS a, INDEXPROPERTY(OBJECT_ID('x1'), 'ix', 'IndexID') AS b\n@once DROP INDEX ix ON x2\nSELECT o.name AS t, i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name IN ('x1', 'x2') AND i.name IS NOT NULL ORDER BY 1, 2\n@once CREATE INDEX ix ON x2 (b)\n@once DROP INDEX x1.ix\nSELECT o.name AS t, i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name IN ('x1', 'x2') AND i.name IS NOT NULL ORDER BY 1, 2\n@once CREATE INDEX ix ON x1 (b)\n@once DROP INDEX dbo.x2.ix\nSELECT o.name AS t, i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name IN ('x1', 'x2') AND i.name IS NOT NULL ORDER BY 1, 2\n@once CREATE TABLE x6 (a int PRIMARY KEY, b int)\n@once CREATE INDEX x6 ON x6 (b)\n@once CREATE TABLE ixt (a int)\n@once CREATE INDEX ixt ON x1 (a)\nSELECT o.name AS t, i.name FROM sys.indexes i JOIN sys.objects o ON o.object_id = i.object_id WHERE o.name IN ('x1', 'x6') AND i.is_primary_key = 0 AND i.name IS NOT NULL ORDER BY 1, 2\n@once CREATE TABLE d4 (a int, b int); INSERT INTO d4 VALUES (1, 2)\n@once CREATE VIEW d4v AS SELECT a FROM d4\n@once CREATE VIEW d4vv AS SELECT a FROM d4v\n@once CREATE VIEW d4b WITH SCHEMABINDING AS SELECT a FROM dbo.d4\nDROP TABLE d4\n@once DROP VIEW d4b\n@once DROP TABLE d4\nSELECT * FROM d4v\nSELECT * FROM d4vv\nSELECT name FROM sys.views WHERE name LIKE 'd4%' ORDER BY 1\n@once CREATE TABLE d4 (a int, c int); INSERT INTO d4 VALUES (7, 8)\nSELECT * FROM d4v\nSELECT * FROM d4vv\n@once CREATE SCHEMA s5\nSELECT schema_name, schema_owner, default_character_set_name FROM INFORMATION_SCHEMA.SCHEMATA ORDER BY LOWER(schema_name)\n@once CREATE TABLE p5 (id int PRIMARY KEY, n varchar(10))\n@once CREATE TABLE c5 (id int CONSTRAINT pk_c5 PRIMARY KEY, pid int, v int CONSTRAINT ck5 CHECK (v > 0), CONSTRAINT uq5 UNIQUE (v), CONSTRAINT fk5 FOREIGN KEY (pid) REFERENCES p5 (id))\nSELECT table_schema, table_name, column_name, constraint_name FROM INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE WHERE table_name = 'c5' ORDER BY constraint_name, column_name\n@once CREATE PROCEDURE pr5 @a int, @b varchar(10) OUTPUT AS BEGIN SET @b = 'x' END\n@once CREATE FUNCTION fn5 (@x int) RETURNS int AS BEGIN RETURN @x + 1 END\n@once CREATE FUNCTION tf5 (@x int) RETURNS TABLE AS RETURN (SELECT @x AS y)\nSELECT specific_schema, specific_name, routine_schema, routine_name, routine_type, data_type, character_maximum_length, numeric_precision, routine_body, is_deterministic, sql_data_access FROM INFORMATION_SCHEMA.ROUTINES ORDER BY routine_name\nSELECT routine_name, routine_definition FROM INFORMATION_SCHEMA.ROUTINES WHERE routine_name = 'fn5'\nSELECT specific_schema, specific_name, ordinal_position, parameter_mode, is_result, as_locator, parameter_name, data_type, character_maximum_length, numeric_precision, numeric_scale FROM INFORMATION_SCHEMA.PARAMETERS ORDER BY specific_name, ordinal_position\n@once CREATE VIEW v5 AS SELECT p5.id, c5.v FROM p5 JOIN c5 ON c5.pid = p5.id\n@once CREATE VIEW v5b AS SELECT * FROM v5\n@once CREATE VIEW v5c AS SELECT x.n FROM p5 AS x WHERE x.id > 0\nSELECT view_schema, view_name, table_schema, table_name FROM INFORMATION_SCHEMA.VIEW_TABLE_USAGE WHERE view_name LIKE 'v5%' ORDER BY view_name, table_name\nSELECT view_schema, view_name, table_schema, table_name, column_name FROM INFORMATION_SCHEMA.VIEW_COLUMN_USAGE WHERE view_name LIKE 'v5%' ORDER BY view_name, table_name, column_name\n@once CREATE TABLE r5 (a int, b int); INSERT INTO r5 VALUES (1, 2)\n@once CREATE VIEW vs5 AS SELECT * FROM r5\n@once ALTER TABLE r5 DROP COLUMN b\nSELECT * FROM vs5\n@once ALTER TABLE r5 ADD c int\n@once SET NOCOUNT ON; EXEC sp_refreshview 'vs5'; SET NOCOUNT OFF\nSELECT * FROM vs5\nSELECT column_name FROM INFORMATION_SCHEMA.COLUMNS WHERE table_name = 'vs5' ORDER BY ordinal_position\nEXEC sp_refreshview 'nosuch'\nEXEC sp_refreshview 'r5'\nCREATE VIEW vco WITH CHECK OPTION AS SELECT a FROM x1\n@once CREATE TABLE s6 (id int, v int, w int)\nCREATE VIEW vb1 WITH SCHEMABINDING AS SELECT id FROM s6\nCREATE VIEW vb1j WITH SCHEMABINDING AS SELECT s.id FROM dbo.s6 AS s JOIN s6 AS t ON t.id = s.id\n@once CREATE VIEW vnb AS SELECT id FROM s6\nCREATE VIEW vb2 WITH SCHEMABINDING AS SELECT id FROM dbo.vnb\n@once CREATE FUNCTION dbo.f6 (@x int) RETURNS int AS BEGIN RETURN @x END\nCREATE VIEW vb3 WITH SCHEMABINDING AS SELECT dbo.f6(id) AS x FROM dbo.s6\n@once CREATE VIEW vb4 WITH SCHEMABINDING AS SELECT id, v FROM dbo.s6\nALTER TABLE s6 ALTER COLUMN v bigint\nALTER TABLE s6 ALTER COLUMN id bigint\n@once ALTER TABLE s6 ALTER COLUMN w bigint\nSELECT * FROM vb4"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(79), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
