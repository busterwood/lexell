// lexdb_page: nodes, meta and list pages round-trip; a flipped byte or the
// wrong page number fails the check.
// expect: leaf 3 a=1 bb=22 ccc=333 size 24
// expect: lazy true lower 0 1 1 3 3; loosened 3 a=1 ccc=333 lazy false
// expect: internal 2 kids 7 8 9 keys m t
// expect: meta 5 120 9 6 10
// expect: bad crc true wrong page true
// expect: list 1000 2 999
import "../../../cmd/lexdb_page"
import "../../../cmd/lexdb_disk"

fn main() {
    var n = lexdb_page.newLeaf()
    append(mut &n.keys, "a"); append(mut &n.vals, "1")
    append(mut &n.keys, "bb"); append(mut &n.vals, "22")
    append(mut &n.keys, "ccc"); append(mut &n.vals, "333")
    n.size = 21
    let none: []int = []
    var b = lexdb_page.encodeNode(&n, &none, 12)
    lexdb_page.check(&b, 12, lexdb_page.T_LEAF).unwrap()
    let d = lexdb_page.decodeNode(&b)
    println("leaf " + d.count().toStr() + " " + d.key(0) + "=" + d.val(0) + " " + d.key(1) + "=" + d.val(1) + " " + d.key(2) + "=" + d.val(2) + " size " + d.size.toStr())
    var l = lexdb_page.decodeNode(&b)
    let lw = l.lower(&"").toStr() + " " + l.lower(&"b").toStr() + " " + l.lower(&"bb").toStr() + " " + l.lower(&"ccc0").toStr() + " " + l.lower(&"d").toStr()
    let wasLazy = l.lazy
    l.loosen()
    println("lazy " + wasLazy.toStr() + " lower " + lw + "; loosened " + len(l.keys).toStr() + " " + l.keys[0] + "=" + l.vals[0] + " " + l.keys[2] + "=" + l.vals[2] + " lazy " + l.lazy.toStr())
    var i = lexdb_page.newNode(false)
    i.keys = ["m", "t"]
    i.kids = [0, 1, 2]
    let pages = [7, 8, 9]
    let ib = lexdb_page.encodeNode(&i, &pages, 13)
    let di = lexdb_page.decodeNode(&ib)
    println("internal " + len(di.keys).toStr() + " kids " + di.kids[0].toStr() + " " + di.kids[1].toStr() + " " + di.kids[2].toStr() + " keys " + di.keys[0] + " " + di.keys[1])
    let m = lexdb_page.Meta{ckpt: 5, npages: 120, roots: 3, free: 4, replaySeg: 1, replayOff: 8192, replayBatch: 77, nextTree: 9, dropped: 6, runs: 10, covers: 76}
    let mb = lexdb_page.encodeMeta(&m, 1)
    let back = lexdb_page.decodeMeta(&mb, 1).unwrap()
    println("meta " + back.ckpt.toStr() + " " + back.npages.toStr() + " " + back.nextTree.toStr() + " " + back.dropped.toStr() + " " + back.runs.toStr())
    b[100] = b[100] ^ 1
    let bad = lexdb_page.check(&b, 12, lexdb_page.T_LEAF).isErr()
    let wrong = lexdb_page.check(&ib, 14, lexdb_page.T_LEAF).isErr()
    println("bad crc " + bad.toStr() + " wrong page " + wrong.toStr())
    var vals: []int = []
    for k in 0..1000 { append(mut &vals, k) }
    let lp = [5, 6]
    let enc = lexdb_page.encodeList(&vals, &lp)
    let fs = lexdb_disk.sim(1)
    let f = fs.open("x", true).unwrap()
    for k in 0..2 { f.write(lp[k] * 4096, &enc[k]).unwrap() }
    var used: []int = []
    let got = lexdb_page.readList(&f, 5, mut &used).unwrap()
    println("list " + len(got).toStr() + " " + len(used).toStr() + " " + got[999].toStr())
}
