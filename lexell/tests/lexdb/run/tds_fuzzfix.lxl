// lexdb over TDS: the fuzzer's bugs (design/lexdb-fuzz.md) through the T-SQL door, checked against SQL Server 2022 (run
// with LEXDB_MSSQL set to its connection string, this test prints SQL Server's answers: the expect lines). W1: a JOIN
// binds tighter than a comma (FROM a, b RIGHT JOIN c is a x (b RIGHT JOIN c)): RIGHT, FULL and LEFT JOIN, an empty
// table, a view, a derived table, a CTE, an APPLY in the tree and a tree inside one, two trees, UPDATE and DELETE with
// a tree in FROM. W2: char(n) beside varchar in subqueries: ANY, ALL, IN, NOT IN, EXISTS and a scalar over a view, a
// join. E1: an outer value in an APPLY inside a correlated EXISTS, IN and scalar subquery. E2: ROUND with a NULL. Each
// batch runs with unnesting on, then the subqueries' again with it off (lexdb_plan.setUnnest(0)), each with SET
// lexdb_batch = off (the row engine) and on: the label and the answer, or DIFFERENT and both.
// expect: W1 right join: x,y,bx,by2,cx,z: 1|10|NULL|NULL|NULL|8;1|10|NULL|NULL|4|6;1|10|1|1|1|5;2|20|NULL|NULL|NULL|8;2|20|NULL|NULL|NULL|8;2|20|NULL|NULL|4|6;2|20|NULL|NULL|4|6;2|20|1|1|1|5;2|20|1|1|1|5
// expect: W1 full join: n,b,c: 15|6|6
// expect: W1 left join: n,c: 9|3
// expect: W1 empty: n: 0
// expect: W1 view: n,y: 9|3
// expect: W1 derived table: n,y: 12|6
// expect: W1 CTE: n,y: 15|9
// expect: W1 APPLY in the tree: n,s: 9|66
// expect: W1 inside APPLY: x,n: 1|6;2|9;2|9
// expect: W1 two trees: n: 9
// expect: W1 a tree then a comma: n: 27
// expect: W1 UPDATE FROM: (2) // s: 52
// expect: W1 DELETE FROM: (1) // n: 2
// expect: W2 >= ANY: id: 1;3;5;6
// expect: W2 >= ALL: id: 5
// expect: W2 char IN varchar: id: 3;6
// expect: W2 varchar IN char: id: 3;6
// expect: W2 char NOT IN varchar: id: 
// expect: W2 EXISTS, view: id: 3;6
// expect: W2 scalar, view: id,n: 1|1;2|1;3|2;4|0;5|1;6|2
// expect: W2 > ANY varchar: id: 1;3;5;6
// expect: W2 join: id,iid: 1|1;2|2;3|3;3|6;5|5;6|3;6|6
// expect: E1 EXISTS: x6,e: NULL|0;0|0;1|1
// expect: E1 IN: a4: 2;3
// expect: E1 scalar: a4,n: NULL|0;2|3;3|0
// expect: E2 ROUND: r: 1.50;NULL;-2.30;1234.60
// expect: E2 ROUND of NULL: r: NULL;NULL;NULL;NULL
// expect: E2 ROUND, a NULL scale: r: NULL;NULL;NULL;NULL
// expect: unnest off, W2 >= ANY: id: 1;3;5;6
// expect: unnest off, W2 >= ALL: id: 5
// expect: unnest off, W2 char IN varchar: id: 3;6
// expect: unnest off, W2 varchar IN char: id: 3;6
// expect: unnest off, W2 char NOT IN varchar: id: 
// expect: unnest off, W2 EXISTS, view: id: 3;6
// expect: unnest off, W2 scalar, view: id,n: 1|1;2|1;3|2;4|0;5|1;6|2
// expect: unnest off, W2 > ANY varchar: id: 1;3;5;6
// expect: unnest off, W2 join: id,iid: 1|1;2|2;3|3;3|6;5|5;6|3;6|6
// expect: unnest off, E1 EXISTS: x6,e: NULL|0;0|0;1|1
// expect: unnest off, E1 IN: a4: 2;3
// expect: unnest off, E1 scalar: a4,n: NULL|0;2|3;3|0
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"
import "../../../cmd/lexdb_plan"

const SETUP = "CREATE TABLE wa (x int NULL, y int NULL)\nCREATE TABLE wb (x int NULL, y int NULL)\nCREATE TABLE wc (x int NULL, z int NULL)\nCREATE TABLE we (x int NULL)\nINSERT INTO wa VALUES (1, 10), (2, 20), (2, 20)\nINSERT INTO wb VALUES (1, 1), (3, 3), (NULL, 7)\nINSERT INTO wc VALUES (1, 5), (4, 6), (NULL, 8)\nCREATE VIEW wv AS SELECT x, y FROM wb\nCREATE TABLE p (id int NOT NULL, c char(3) NULL, v varchar(4) NULL)\nINSERT INTO p VALUES (1, 'a', 'a'), (2, ' a', ' a '), (3, 'ab', 'ab '), (4, NULL, NULL), (5, 'b', 'b'), (6, 'ab', 'ab')\nCREATE VIEW pv AS SELECT id, c, v FROM p\nCREATE TABLE e1 (b2 int NULL)\nCREATE TABLE e3 (d1 int NULL)\nCREATE TABLE e4 (a5 bigint NULL, a4 int NULL)\nINSERT INTO e1 VALUES (0), (1), (1)\nINSERT INTO e3 VALUES (1), (1), (NULL)\nINSERT INTO e4 VALUES (5, 2), (5, 3), (NULL, NULL)\nCREATE TABLE r0 (c0 int NOT NULL, c2 numeric(10,2) NULL)\nINSERT INTO r0 VALUES (1, 1.5), (2, NULL), (3, -2.25), (4, 1234.56)\nCREATE TABLE x0 (a0 numeric(6,2) NULL, s smallint NULL)\nCREATE INDEX x0_a ON x0 (a0)\nCREATE INDEX x0_s ON x0 (s)\nINSERT INTO x0 VALUES (12.5, 3), (9999.99, 32767), (-9999.99, -32768), (NULL, NULL), (12.5, 3)\nCREATE TABLE x1 (b2 int NULL)\nINSERT INTO x1 VALUES (1), (2)"

const QS = "W1 right join\tSELECT wa.x, wa.y, wb.x AS bx, wb.y AS by2, wc.x AS cx, wc.z FROM wa, wb RIGHT JOIN wc ON wb.x = wc.x ORDER BY 1, 2, 3, 4, 5, 6\nW1 full join\tSELECT COUNT(*) AS n, COUNT(wb.x) AS b, COUNT(wc.x) AS c FROM wa, wb FULL JOIN wc ON wb.x = wc.x\nW1 left join\tSELECT COUNT(*) AS n, COUNT(wc.x) AS c FROM wa, wb LEFT JOIN wc ON wb.x = wc.x\nW1 empty\tSELECT COUNT(*) AS n FROM we, wb RIGHT JOIN wc ON wb.x = wc.x\nW1 view\tSELECT COUNT(*) AS n, COUNT(wv.y) AS y FROM wa, wv RIGHT JOIN wc ON wv.x = wc.x\nW1 derived table\tSELECT COUNT(*) AS n, COUNT(d.y) AS y FROM wa, (SELECT x, y FROM wb WHERE y < 5) d FULL JOIN wc ON d.x = wc.x\nW1 CTE\tWITH k AS (SELECT x, y FROM wb) SELECT COUNT(*) AS n, COUNT(k.y) AS y FROM wa, k FULL JOIN wc ON k.x = wc.x\nW1 APPLY in the tree\tSELECT COUNT(*) AS n, SUM(l.s) AS s FROM wa, wb RIGHT JOIN wc ON wb.x = wc.x CROSS APPLY (SELECT wc.z + 1 AS s) l\nW1 inside APPLY\tSELECT wa.x, l.n FROM wa CROSS APPLY (SELECT COUNT(*) AS n FROM wb, wa a2 RIGHT JOIN wc ON a2.x = wc.x WHERE a2.x IS NULL OR a2.x <> wa.x) l ORDER BY 1, 2\nW1 two trees\tSELECT COUNT(*) AS n FROM wa a2 RIGHT JOIN wc ON a2.x = wc.x, wb RIGHT JOIN wc c2 ON wb.x = c2.x\nW1 a tree then a comma\tSELECT COUNT(*) AS n FROM wa, wb RIGHT JOIN wc ON wb.x = wc.x, wb w4\nW1 UPDATE FROM\tW UPDATE wa SET y = wa.y + 1 FROM wb RIGHT JOIN wc ON wb.x = wc.x WHERE wa.x = 2 AND wc.z = 6 ;; SELECT SUM(y) AS s FROM wa\nW1 DELETE FROM\tW DELETE FROM wa FROM wb FULL JOIN wc ON wb.x = wc.x WHERE wc.z = 6 AND wa.x = 1 ;; SELECT COUNT(*) AS n FROM wa\nW2 >= ANY\tSELECT o.id FROM p o WHERE o.c >= ANY (SELECT i.c FROM p i WHERE i.id <> o.id) ORDER BY 1\nW2 >= ALL\tSELECT o.id FROM p o WHERE o.c >= ALL (SELECT i.c FROM p i WHERE i.id <> 4) ORDER BY 1\nW2 char IN varchar\tSELECT o.id FROM p o WHERE o.c IN (SELECT i.v FROM p i WHERE i.id <> o.id) ORDER BY 1\nW2 varchar IN char\tSELECT o.id FROM p o WHERE o.v IN (SELECT i.c FROM p i WHERE i.id <> o.id) ORDER BY 1\nW2 char NOT IN varchar\tSELECT o.id FROM p o WHERE o.c NOT IN (SELECT i.v FROM p i WHERE i.id <> 4) ORDER BY 1\nW2 EXISTS, view\tSELECT o.id FROM pv o WHERE EXISTS (SELECT 1 FROM pv i WHERE i.v = o.c AND i.id <> o.id) ORDER BY 1\nW2 scalar, view\tSELECT o.id, (SELECT COUNT(*) FROM pv i WHERE i.v = o.c) AS n FROM pv o ORDER BY 1\nW2 > ANY varchar\tSELECT o.id FROM p o WHERE o.c > ANY (SELECT i.v FROM p i WHERE i.id <> o.id) ORDER BY 1\nW2 join\tSELECT o.id, i.id AS iid FROM p o JOIN p i ON o.c = i.v ORDER BY 1, 2\nE1 EXISTS\tSELECT d1.x6, CASE WHEN EXISTS (SELECT 1 FROM e1 q7 CROSS APPLY (SELECT COUNT(*) AS n FROM e3 q9 WHERE q9.d1 = d1.x6) l8 WHERE l8.n > 1 AND q7.b2 = d1.x6) THEN 1 ELSE 0 END AS e FROM (SELECT a4 - 2 AS x6 FROM e4) d1 ORDER BY 1\nE1 IN\tSELECT q1.a4 FROM e4 q1 WHERE q1.a4 IN (SELECT l4.x8 FROM e4 q3 CROSS APPLY (SELECT q1.a4 AS x8 FROM e4 q5) l4 WHERE q3.a5 = q1.a5) ORDER BY 1\nE1 scalar\tSELECT q1.a4, (SELECT COUNT(*) FROM (SELECT q1.a4 * 2 AS x FROM e4 q5) l WHERE l.x = q1.a4 + 2) AS n FROM e4 q1 ORDER BY 1\nE2 ROUND\tSELECT ROUND(c2, 1) AS r FROM r0 ORDER BY c0\nE2 ROUND of NULL\tSELECT ROUND(CAST(NULL AS numeric(10,2)), 0) AS r FROM r0\nE2 ROUND, a NULL scale\tSELECT ROUND(c2, NULL) AS r FROM r0 ORDER BY c0"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A query, or a write ("W write ;; check") in a transaction rolled back, the check after the write
fn answer(c: mut &sqlserver.Conn, q: &str): str {
    if !strings.startsWith(q, "W ") { return show(c, q) }
    let parts = strings.split(&q[2..len(q)], " ;; ")
    let b = show(c, &"BEGIN TRANSACTION")
    let w = show(c, &parts[0])
    if strings.startsWith(&w, "error") {
        let r = show(c, &"ROLLBACK")
        return w + " // " + show(c, &parts[1])
    }
    let k = show(c, &parts[1])
    let r = show(c, &"ROLLBACK")
    return w + " // " + k
}

// local: lexdb, each batch with the row engine and with batches, unnesting on and then off
fn batches(dsn: &str, local: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let setup: str = SETUP
            for q in strings.lines(&setup) {
                let r = show(mut &c, &q)
                if strings.startsWith(&r, "error") { println("setup: " + r + ": " + q) }
            }
            let text: str = QS
            for pass in 0..2 {
                if pass == 1 && local { lexdb_plan.setUnnest(0) }
                for l in strings.lines(&text) {
                    let parts = strings.split(&l, "\t")
                    if pass == 1 && !strings.startsWith(&parts[0], "W2") && !strings.startsWith(&parts[0], "E1") { continue }
                    let lab = if pass == 1 { "unnest off, " + parts[0] } else { parts[0].toStr() }
                    let q = parts[1].toStr()
                    if !local {
                        println(lab + ": " + answer(mut &c, &q))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off")
                    let off = answer(mut &c, &q)
                    let b = show(mut &c, &"SET lexdb_batch = on")
                    let on = answer(mut &c, &q)
                    if off == on { println(lab + ": " + on) } else {
                        println("DIFFERENT " + lab + ": " + q)
                        println("  rows:    " + off)
                        println("  batches: " + on)
                    }
                }
            }
            if !local {
                for t in ["wv", "pv", "wa", "wb", "wc", "we", "p", "e1", "e3", "e4", "r0", "x0", "x1"] {
                    let d = show(mut &c, &((if t == "wv" || t == "pv" { "DROP VIEW " } else { "DROP TABLE " }) + t))
                }
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), true)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, false) }
        None {
            lexdb_store.run(lexdb_disk.sim(59), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
