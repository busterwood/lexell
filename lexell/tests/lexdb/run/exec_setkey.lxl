// lexdb_pipe.keyInt, the key a set operation makes of an integer column
// without a Decimal: the same bytes as keyPart of the value (an integer's
// number: 2 = 2.0 as a key), for zero, powers of ten, numbers with and
// without trailing zeros, both signs, the edges of 64 bits and 20,000
// pseudo-random integers of every length.
// expect: keyInt: 20168 integers, 20168 the same as keyPart

import "../../../cmd/lexdb_sql"
import "../../../cmd/lexdb_pipe"

fn pow10(k: int): int {
    var p = 1
    for i in 0..k { p *= 10 }
    return p
}

fn main() {
    var vals: []int = [0, 1, -1, 9, -9, 10, -10, 11, 99, 100, 101, 1000, 1200, -1200, 9223372036854775807, -9223372036854775807,
                       -9223372036854775807 - 1, 9223372036854775800, -9223372036854775800, 1000000000000000000,
                       -1000000000000000000, 9000000000000000000, 4611686018427387904, 123456789012345678]
    var p = 1
    for i in 0..18 {
        append(mut &vals, p)
        append(mut &vals, -p)
        append(mut &vals, p - 1)
        append(mut &vals, 1 - p)
        append(mut &vals, 2 * p)
        append(mut &vals, 25 * p)
        append(mut &vals, -35 * p)
        append(mut &vals, 12 * p + 1)
        p *= 10
    }
    // an LCG, its values cut to every length
    var x = 12345
    for i in 0..20000 {
        x = (x * 1103515245 + 12345) % 2147483648
        let hi = x
        x = (x * 1103515245 + 12345) % 2147483648
        let v = (hi << 31) + x
        append(mut &vals, (if i % 2 == 0 { v } else { -v }) / pow10(i % 19))
    }
    var same = 0
    for v in vals {
        var a = ""
        var b = ""
        lexdb_pipe.keyInt(mut &a, v)
        lexdb_pipe.keyPart(mut &b, &lexdb_sql.Val.Int(v))
        if a == b { same += 1 } else { println("DIFFERENT " + v.toStr()) }
    }
    println("keyInt: " + len(vals).toStr() + " integers, " + same.toStr() + " the same as keyPart")
}
