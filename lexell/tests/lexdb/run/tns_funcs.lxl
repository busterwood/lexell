// lexdb over TNS: Oracle functions of design/lexdb-dialect-gaps.md package A: SYS_EXTRACT_UTC,
// NUMTODSINTERVAL, NUMTOYMINTERVAL, EXTRACT of the fields of an interval and of a timestamp difference
// (INTERVAL DAY TO SECOND), FROM_TZ, and a timestamp with a time zone literal (generated by tests/lexdb/gen_oracle.py from
// oracle_funcs_queries.txt). Its answers are as Oracle's documentation gives them (no Oracle was at hand: each line gives its answer as a fourth field).
// Each answer is a label, then the columns' names and rows, or error and the ORA- number.
// expect: sys_extract_utc offset: T = '2000-03-28T19:30:00'
// expect: sys_extract_utc positive: T = '2024-03-05T08:00:00'
// expect: sys_extract_utc fraction: T = '2024-03-05T08:00:00.123456'
// expect: sys_extract_utc region: A,B = '2024-07-01T10:00:00'|'2024-01-01T11:00:00'
// expect: sys_extract_utc day edge: T = '2024-02-29T19:30:00'
// expect: sys_extract_utc utc: T = '2024-03-05T10:00:00'
// expect: sys_extract_utc null: T = NULL
// expect: sys_extract_utc from_tz: T = '2024-03-05T05:00:00'
// expect: sys_extract_utc now: OK = 1
// expect: sys_extract_utc cast: D = '2024-03-05T08:00:00'
// expect: sys_extract_utc table: U = '2024-03-06T02:30:00';'2025-01-01T11:59:59.5'
// expect: sys_extract_utc number: error 932
// expect: sys_extract_utc args: error 938
// expect: sys_extract_utc two: error 939
// expect: numtodsinterval day: D,H = 1|12
// expect: numtodsinterval hour: D,H,M = 4|4|30
// expect: numtodsinterval minute: H,M,S = 2|30|30
// expect: numtodsinterval second: M,S,U = 2|5.5|0.000001
// expect: numtodsinterval case: A,B,C = 2|2|2
// expect: numtodsinterval negative: D,H = -1|-12
// expect: numtodsinterval zero: D,S = 0|0
// expect: numtodsinterval null: A,B = NULL|NULL
// expect: numtodsinterval string: D = 2
// expect: numtodsinterval show: D,M,S = '+000000001 12:00:00.000000000'|'+000000000 01:30:00.000000000'|'-000000000 00:00:00.500000000'
// expect: numtodsinterval add: T,D = '2024-03-06T22:00:00'|'2024-03-07T00:00:00'
// expect: numtodsinterval column: N,H = 1.25|1;30|6
// expect: numtodsinterval bad unit: error 1760
// expect: numtodsinterval month: error 1760
// expect: numtodsinterval text: error 1722
// expect: numtodsinterval args: error 938
// expect: numtoyminterval year: Y,M = 1|6
// expect: numtoyminterval month: Y,M = 1|2
// expect: numtoyminterval negative: Y,M = -1|-2
// expect: numtoyminterval null: A = NULL
// expect: numtoyminterval bad unit: error 1760
// expect: numtoyminterval show: A,B = '+000000001-06'|'+000000001-02'
// expect: numtoyminterval add: A,B = '2024-02-29T00:00:00'|'2025-03-05T00:00:00'
// expect: extract diff: D,H,M,S = 4|2|29|44.5
// expect: extract diff negative: D,H,M,S = -4|-2|-29|-44.5
// expect: extract diff inline: D,S = 4|44.5
// expect: extract diff fraction: S = 0.249999
// expect: extract diff zero: D,S = 0|0
// expect: extract diff tz: H = -2
// expect: extract diff sys: OK = 1
// expect: extract diff table: ID,D,H = 1|2|12;2|0|-12
// expect: extract diff null: D = NULL
// expect: extract interval literal: D,H,M,S = 3|4|5|6.789
// expect: extract interval ym: Y,M = 1|2
// expect: extract interval negative: D,H,S = -3|-4|-6
// expect: extract date: Y,M,D = 2024|3|5
// expect: extract timestamp: H,M,S = 10|11|12.5
// expect: extract date diff: error 30076
// expect: extract diff year: error 30076
// expect: extract ym day: error 30076
// expect: extract ds month: error 30076
// expect: extract number: error 30076
// expect: extract chain: H = 5
// expect: extract round trip: M = 35
// expect: extract sum: H = 12
// expect: batch table: 0
// expect: batch insert: 1025
// expect: batch extract: N,H,M,S,D = 1025|23575|52230|30375|21420
// expect: batch date and utc: DAYS,U,S = -464325|1025|0
// expect: batch edges: ID,S = 1|59;1024|56;1025|55
// expect: batch compare: N = 1025
// expect: drop batch table: 0
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn q(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + qtext(c, sql)) }
fn x(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + xtext(c, sql)) }

// Statements and queries ("a ;; b ;; c") in one transaction, rolled back (t) or committed (u): each answer, joined by " / ".
fn tx(c: mut &oracle.Conn, label: &str, sqls: &str, commit: bool) {
    var out: []str = []
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for part in strings.split(sqls, " ;; ") {
            if strings.startsWith(&strings.toLowerAscii(part), "select") { append(mut &out, qtext(c2, part)) } else { append(mut &out, xtext(c2, part)) }
        }
        if !commit { return Err(sqldialect.inputError("rolled back")) }
        return Ok(0)
    })
    println(label + ": " + strings.join(&out, " / "))
}
fn t(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, false) }
fn u(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, true) }

fn connect(s: &str): oracle.Conn {
    match oracle.connect(&(s.toStr())) {
        Ok(c) { return c }
        Err(e) {
            println("connect: error " + e.code.toStr() + " " + e.msg)
            exit(1)
        }
    }
}

fn client(port: &str) {
    var c = connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb"))
    q(mut &c, "sys_extract_utc offset", "select sys_extract_utc(timestamp '2000-03-28 11:30:00.00 -08:00') as t from dual")
    q(mut &c, "sys_extract_utc positive", "select sys_extract_utc(timestamp '2024-03-05 10:00:00 +02:00') as t from dual")
    q(mut &c, "sys_extract_utc fraction", "select sys_extract_utc(timestamp '2024-03-05 10:00:00.123456 +02:00') as t from dual")
    q(mut &c, "sys_extract_utc region", "select sys_extract_utc(timestamp '2024-07-01 12:00:00 Europe/Paris') as a, sys_extract_utc(timestamp '2024-01-01 12:00:00 Europe/Paris') as b from dual")
    q(mut &c, "sys_extract_utc day edge", "select sys_extract_utc(timestamp '2024-03-01 01:00:00 +05:30') as t from dual")
    q(mut &c, "sys_extract_utc utc", "select sys_extract_utc(timestamp '2024-03-05 10:00:00 +00:00') as t from dual")
    q(mut &c, "sys_extract_utc null", "select sys_extract_utc(cast(null as timestamp with time zone)) as t from dual")
    q(mut &c, "sys_extract_utc from_tz", "select sys_extract_utc(from_tz(timestamp '2024-03-05 10:00:00', '+05:00')) as t from dual")
    q(mut &c, "sys_extract_utc now", "select case when sys_extract_utc(systimestamp) between timestamp '2020-01-01 00:00:00' and timestamp '2100-01-01 00:00:00' then 1 else 0 end as ok from dual")
    q(mut &c, "sys_extract_utc cast", "select cast(sys_extract_utc(timestamp '2024-03-05 10:00:00 +02:00') as date) as d from dual")
    q(mut &c, "sys_extract_utc table", "select sys_extract_utc(t) as u from (select timestamp '2024-03-05 23:30:00 -03:00' as t from dual union all select timestamp '2024-12-31 23:59:59.5 -12:00' from dual) order by 1")
    q(mut &c, "sys_extract_utc number", "select sys_extract_utc(1) as t from dual")
    q(mut &c, "sys_extract_utc args", "select sys_extract_utc() as t from dual")
    q(mut &c, "sys_extract_utc two", "select sys_extract_utc(systimestamp, 1) as t from dual")
    q(mut &c, "numtodsinterval day", "select extract(day from numtodsinterval(1.5, 'DAY')) as d, extract(hour from numtodsinterval(1.5, 'DAY')) as h from dual")
    q(mut &c, "numtodsinterval hour", "select extract(day from numtodsinterval(100, 'HOUR')) as d, extract(hour from numtodsinterval(100, 'HOUR')) as h, extract(minute from numtodsinterval(100.5, 'HOUR')) as m from dual")
    q(mut &c, "numtodsinterval minute", "select extract(hour from numtodsinterval(150, 'MINUTE')) as h, extract(minute from numtodsinterval(150, 'MINUTE')) as m, extract(second from numtodsinterval(2.5, 'MINUTE')) as s from dual")
    q(mut &c, "numtodsinterval second", "select extract(minute from numtodsinterval(125.5, 'SECOND')) as m, extract(second from numtodsinterval(125.5, 'SECOND')) as s, extract(second from numtodsinterval(0.000001, 'SECOND')) as u from dual")
    q(mut &c, "numtodsinterval case", "select extract(hour from numtodsinterval(2, 'hour')) as a, extract(hour from numtodsinterval(2, 'Hour')) as b, extract(minute from numtodsinterval(2, 'minute')) as c from dual")
    q(mut &c, "numtodsinterval negative", "select extract(day from numtodsinterval(-1.5, 'DAY')) as d, extract(hour from numtodsinterval(-1.5, 'DAY')) as h from dual")
    q(mut &c, "numtodsinterval zero", "select extract(day from numtodsinterval(0, 'DAY')) as d, extract(second from numtodsinterval(0, 'SECOND')) as s from dual")
    q(mut &c, "numtodsinterval null", "select numtodsinterval(null, 'DAY') as a, numtodsinterval(1, null) as b from dual")
    q(mut &c, "numtodsinterval string", "select extract(day from numtodsinterval('2', 'DAY')) as d from dual")
    q(mut &c, "numtodsinterval show", "select numtodsinterval(1.5, 'DAY') as d, numtodsinterval(90, 'MINUTE') as m, numtodsinterval(-0.5, 'SECOND') as s from dual")
    q(mut &c, "numtodsinterval add", "select timestamp '2024-03-05 10:00:00' + numtodsinterval(36, 'HOUR') as t, date '2024-03-05' + numtodsinterval(2, 'DAY') as d from dual")
    q(mut &c, "numtodsinterval column", "select n, extract(hour from numtodsinterval(n, 'HOUR')) as h from (select 1.25 as n from dual union all select 30 from dual) order by n")
    q(mut &c, "numtodsinterval bad unit", "select numtodsinterval(1, 'WEEK') as d from dual")
    q(mut &c, "numtodsinterval month", "select numtodsinterval(1, 'MONTH') as d from dual")
    q(mut &c, "numtodsinterval text", "select numtodsinterval('abc', 'DAY') as d from dual")
    q(mut &c, "numtodsinterval args", "select numtodsinterval(1) as d from dual")
    q(mut &c, "numtoyminterval year", "select extract(year from numtoyminterval(1.5, 'YEAR')) as y, extract(month from numtoyminterval(1.5, 'YEAR')) as m from dual")
    q(mut &c, "numtoyminterval month", "select extract(year from numtoyminterval(14, 'MONTH')) as y, extract(month from numtoyminterval(14, 'month')) as m from dual")
    q(mut &c, "numtoyminterval negative", "select extract(year from numtoyminterval(-14, 'MONTH')) as y, extract(month from numtoyminterval(-14, 'MONTH')) as m from dual")
    q(mut &c, "numtoyminterval null", "select numtoyminterval(null, 'YEAR') as a from dual")
    q(mut &c, "numtoyminterval bad unit", "select numtoyminterval(1, 'DAY') as a from dual")
    q(mut &c, "numtoyminterval show", "select numtoyminterval(1.5, 'YEAR') as a, numtoyminterval(14, 'MONTH') as b from dual")
    q(mut &c, "numtoyminterval add", "select add_months(date '2024-01-31', 1) as a, date '2024-03-05' + numtoyminterval(1, 'YEAR') as b from dual")
    q(mut &c, "extract diff", "select extract(day from d) as d, extract(hour from d) as h, extract(minute from d) as m, extract(second from d) as s from (select timestamp '2024-03-05 10:00:00' - timestamp '2024-03-01 07:30:15.5' as d from dual)")
    q(mut &c, "extract diff negative", "select extract(day from d) as d, extract(hour from d) as h, extract(minute from d) as m, extract(second from d) as s from (select timestamp '2024-03-01 07:30:15.5' - timestamp '2024-03-05 10:00:00' as d from dual)")
    q(mut &c, "extract diff inline", "select extract(day from (timestamp '2024-03-05 10:00:00' - timestamp '2024-03-01 07:30:15.5')) as d, extract(second from (timestamp '2024-03-05 10:00:00' - timestamp '2024-03-01 07:30:15.5')) as s from dual")
    q(mut &c, "extract diff fraction", "select extract(second from timestamp '2024-03-05 10:00:00.250000' - timestamp '2024-03-05 10:00:00.000001') as s from dual")
    q(mut &c, "extract diff zero", "select extract(day from timestamp '2024-03-05 10:00:00' - timestamp '2024-03-05 10:00:00') as d, extract(second from timestamp '2024-03-05 10:00:00' - timestamp '2024-03-05 10:00:00') as s from dual")
    q(mut &c, "extract diff tz", "select extract(hour from timestamp '2024-03-05 10:00:00 +02:00' - timestamp '2024-03-05 10:00:00 +00:00') as h from dual")
    q(mut &c, "extract diff sys", "select case when extract(day from systimestamp - timestamp '2020-01-01 00:00:00') > 1000 then 1 else 0 end as ok from dual")
    q(mut &c, "extract diff table", "select id, extract(day from t2 - t1) as d, extract(hour from t2 - t1) as h from (select 1 as id, timestamp '2024-01-01 00:00:00' as t1, timestamp '2024-01-03 12:00:00' as t2 from dual union all select 2, timestamp '2024-01-01 12:00:00', timestamp '2024-01-01 00:00:00' from dual) order by id")
    q(mut &c, "extract diff null", "select extract(day from cast(null as timestamp) - timestamp '2024-01-01 00:00:00') as d from dual")
    q(mut &c, "extract interval literal", "select extract(day from interval '3 04:05:06.789' day to second) as d, extract(hour from interval '3 04:05:06.789' day to second) as h, extract(minute from interval '3 04:05:06.789' day to second) as m, extract(second from interval '3 04:05:06.789' day to second) as s from dual")
    q(mut &c, "extract interval ym", "select extract(year from interval '1-02' year to month) as y, extract(month from interval '1-02' year to month) as m from dual")
    q(mut &c, "extract interval negative", "select extract(day from interval '-3 04:05:06' day to second) as d, extract(hour from interval '-3 04:05:06' day to second) as h, extract(second from interval '-3 04:05:06' day to second) as s from dual")
    q(mut &c, "extract date", "select extract(year from date '2024-03-05') as y, extract(month from date '2024-03-05') as m, extract(day from date '2024-03-05') as d from dual")
    q(mut &c, "extract timestamp", "select extract(hour from timestamp '2024-03-05 10:11:12.5') as h, extract(minute from timestamp '2024-03-05 10:11:12.5') as m, extract(second from timestamp '2024-03-05 10:11:12.5') as s from dual")
    q(mut &c, "extract date diff", "select extract(day from date '2024-03-05' - date '2024-03-01') as d from dual")
    q(mut &c, "extract diff year", "select extract(year from timestamp '2024-03-05 10:00:00' - timestamp '2024-03-01 07:30:15.5') as y from dual")
    q(mut &c, "extract ym day", "select extract(day from interval '1-02' year to month) as d from dual")
    q(mut &c, "extract ds month", "select extract(month from interval '3 04:05:06' day to second) as m from dual")
    q(mut &c, "extract number", "select extract(day from 5) as d from dual")
    q(mut &c, "extract chain", "select extract(hour from numtodsinterval(extract(day from timestamp '2024-03-05 00:00:00' - timestamp '2024-03-01 00:00:00'), 'DAY') + numtodsinterval(5, 'HOUR')) as h from dual")
    q(mut &c, "extract round trip", "select extract(minute from (timestamp '2024-03-05 10:00:00' + numtodsinterval(95, 'MINUTE')) - timestamp '2024-03-05 10:00:00') as m from dual")
    q(mut &c, "extract sum", "select sum(extract(hour from t2 - t1)) as h from (select timestamp '2024-01-01 00:00:00' as t1, timestamp '2024-01-01 05:00:00' as t2 from dual union all select timestamp '2024-01-01 00:00:00', timestamp '2024-01-01 07:00:00' from dual)")
    x(mut &c, "batch table", "create table tt (id number, a timestamp, b timestamp, d date, e date)")
    x(mut &c, "batch insert", "insert into tt select level, timestamp '2024-01-01 00:00:00' + numtodsinterval(level, 'SECOND'), timestamp '2024-01-02 00:00:00', date '2024-01-01' + level, date '2024-03-01' from dual connect by level <= 1025")
    q(mut &c, "batch extract", "select count(*) as n, sum(extract(hour from b - a)) as h, sum(extract(minute from b - a)) as m, sum(extract(second from b - a)) as s, sum(extract(day from numtodsinterval(id, 'HOUR'))) as d from tt")
    q(mut &c, "batch date and utc", "select sum(e - d) as days, count(sys_extract_utc(a)) as u, min(extract(second from numtodsinterval(id / 4, 'SECOND'))) as s from tt")
    q(mut &c, "batch edges", "select id, extract(second from b - a) as s from tt where id in (1, 1024, 1025) order by id")
    q(mut &c, "batch compare", "select count(*) as n from tt where b - a > numtodsinterval(23, 'HOUR')")
    x(mut &c, "drop batch table", "drop table tt")
    c.logoff()
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
