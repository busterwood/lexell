// lexdb_exec: the index-to-scan switch (optimizer 19). The first table's index range
// is counted before any row is read: a scan is taken when the table has at
// most twice the range's entries (an index entry costs about two reads, a
// scanned row one). Results must match a plain scan (`kind + 0` cannot use the
// index). Not switched: a path chosen for its order, a correlated subquery
// (run per outer row), a write, a read-write block. The EXPLAIN ANALYZE lines
// were checked by hand (the ranges read include the bound's value: 9.5).
// expect: -- s: 5000 rows, kind = id % 10
// expect: create table s (id int primary key, kind int, v int) -> CREATE TABLE
// expect: insert into s select g, g % 10, g % 7 from generate_series(1, 5000) g -> INSERT 0 5000
// expect: create index s_kind on s (kind) -> CREATE INDEX
// expect: -- a short range: the index, its keys read once
// expect: explain analyze select id from s where kind < 1 -> scan s: index s_kind range (rows read 1000, kept 500)
// expect: select count(*) from s where kind < 1 -> [count] 500
// expect: explain analyze select id from s where kind = 3 -> scan s: index s_kind lookup (rows read 500, kept 500)
// expect: -- 2000 entries of 5000 rows: the index is still cheaper
// expect: explain analyze select id from s where kind < 3 -> scan s: index s_kind range (rows read 2000, kept 1500)
// expect: select count(*) from s where kind < 3 -> [count] 1500
// expect: -- 3500 entries of 5000 rows: a scan
// expect: explain analyze select id from s where kind < 6 -> scan s: index s_kind range (rows read 5000, kept 3000, switched to scan: the range holds over half the table)
// expect: select count(*) from s where kind < 6 -> [count] 3000
// expect: select count(*) from s where kind + 0 < 6 -> [count] 3000
// expect: select count(*) from s where kind < 6 and v = 0 -> [count] 428
// expect: select count(*) from s where kind + 0 < 6 and v = 0 -> [count] 428
// expect: select count(*) from s where kind >= 2 -> [count] 4000
// expect: -- an ORDER BY the index supplies is never switched
// expect: explain analyze select id from s where kind < 6 order by kind, id limit 2 -> scan s: index s_kind range (rows read 2, kept 2); order: the scan's; limit: stops the scan
// expect: select id from s where kind < 6 order by kind, id limit 2 -> [id] 10; 20
// expect: -- a LIMIT or an EXISTS may stop early: no switch
// expect: explain analyze select id from s where kind < 6 limit 1 -> 0 switched
// expect: select count(*) from s where exists (select 1 from s x where x.kind < 6) -> [count] 5000
// expect: explain analyze select count(*) from s where exists (select 1 from s x where x.kind < 6) -> 0 switched
// expect: -- a correlated subquery keeps its index (it runs per outer row)
// expect: create table c (id int primary key) -> CREATE TABLE
// expect: insert into c select g from generate_series(7, 9) g -> INSERT 0 3
// expect: select count(*) from c where (select count(*) from s where s.kind < c.id) > 3000 -> [count] 3
// expect: explain analyze select count(*) from c where (select count(*) from s where s.kind < c.id) > 3000 -> 0 switched
// expect: -- a read-write block keeps its index; a read-only one may switch
// expect: begin -> BEGIN
// expect: explain analyze select id from s where kind < 6 -> 0 switched
// expect: commit -> COMMIT
// expect: begin read only -> BEGIN
// expect: explain analyze select id from s where kind < 6 -> 1 switched
// expect: commit -> COMMIT
// expect: -- an INSERT ... SELECT (its reads noted) gets the same rows
// expect: create table s2 (id int primary key, kind int, v int) -> CREATE TABLE
// expect: insert into s2 select id, kind, v from s where kind < 6 -> INSERT 0 3000
// expect: -- a write keeps its index; its result is the same
// expect: update s set v = v where kind < 6 -> UPDATE 3000
// expect: delete from s where kind > 7 -> DELETE 1000
// expect: select count(*) from s -> [count] 4000
// expect: -- b: 20000 rows. 4000 entries: the index (a fixed budget would have scanned)
// expect: create table b (id int primary key, kind int) -> CREATE TABLE
// expect: insert into b select g, g % 10 from generate_series(1, 20000) g -> INSERT 0 20000
// expect: create index b_kind on b (kind) -> CREATE INDEX
// expect: explain analyze select id from b where kind < 1 -> scan b: index b_kind range (rows read 4000, kept 2000)
// expect: select count(*) from b where kind < 1 -> [count] 2000
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"

fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows {
                println(sql + " -> " + r.tag)
                return
            }
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name) }
            println(sql + " -> [" + strings.join(&names, ",") + "]" + (if len(lines) > 0 { " " } else { "" }) + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

// EXPLAIN ANALYZE without its last line (the time).
fn analyze(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for i in 0..len(r.rows) - 1 { append(mut &lines, lexdb_exec.text(&r.rows[i][0])) }
            println(sql + " -> " + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

// EXPLAIN ANALYZE: how many of its lines say a scan was switched to.
fn switched(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var n = 0
            for row in r.rows {
                if strings.indexOf(lexdb_exec.text(&row[0]), "switched to scan", 0) >= 0 { n += 1 }
            }
            println(sql + " -> " + n.toStr() + " switched")
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    println("-- s: 5000 rows, kind = id % 10")
    show(mut &s, "create table s (id int primary key, kind int, v int)")
    show(mut &s, "insert into s select g, g % 10, g % 7 from generate_series(1, 5000) g")
    show(mut &s, "create index s_kind on s (kind)")
    println("-- a short range: the index, its keys read once")
    analyze(mut &s, "explain analyze select id from s where kind < 1")
    show(mut &s, "select count(*) from s where kind < 1")
    analyze(mut &s, "explain analyze select id from s where kind = 3")
    println("-- 2000 entries of 5000 rows: the index is still cheaper")
    analyze(mut &s, "explain analyze select id from s where kind < 3")
    show(mut &s, "select count(*) from s where kind < 3")
    println("-- 3500 entries of 5000 rows: a scan")
    analyze(mut &s, "explain analyze select id from s where kind < 6")
    show(mut &s, "select count(*) from s where kind < 6")
    show(mut &s, "select count(*) from s where kind + 0 < 6")
    show(mut &s, "select count(*) from s where kind < 6 and v = 0")
    show(mut &s, "select count(*) from s where kind + 0 < 6 and v = 0")
    show(mut &s, "select count(*) from s where kind >= 2")
    println("-- an ORDER BY the index supplies is never switched")
    analyze(mut &s, "explain analyze select id from s where kind < 6 order by kind, id limit 2")
    show(mut &s, "select id from s where kind < 6 order by kind, id limit 2")
    println("-- a LIMIT or an EXISTS may stop early: no switch")
    switched(mut &s, "explain analyze select id from s where kind < 6 limit 1")
    show(mut &s, "select count(*) from s where exists (select 1 from s x where x.kind < 6)")
    switched(mut &s, "explain analyze select count(*) from s where exists (select 1 from s x where x.kind < 6)")
    println("-- a correlated subquery keeps its index (it runs per outer row)")
    show(mut &s, "create table c (id int primary key)")
    show(mut &s, "insert into c select g from generate_series(7, 9) g")
    show(mut &s, "select count(*) from c where (select count(*) from s where s.kind < c.id) > 3000")
    switched(mut &s, "explain analyze select count(*) from c where (select count(*) from s where s.kind < c.id) > 3000")
    println("-- a read-write block keeps its index; a read-only one may switch")
    show(mut &s, "begin")
    switched(mut &s, "explain analyze select id from s where kind < 6")
    show(mut &s, "commit")
    show(mut &s, "begin read only")
    switched(mut &s, "explain analyze select id from s where kind < 6")
    show(mut &s, "commit")
    println("-- an INSERT ... SELECT (its reads noted) gets the same rows")
    show(mut &s, "create table s2 (id int primary key, kind int, v int)")
    show(mut &s, "insert into s2 select id, kind, v from s where kind < 6")
    println("-- a write keeps its index; its result is the same")
    show(mut &s, "update s set v = v where kind < 6")
    show(mut &s, "delete from s where kind > 7")
    show(mut &s, "select count(*) from s")
    println("-- b: 20000 rows. 4000 entries: the index (a fixed budget would have scanned)")
    show(mut &s, "create table b (id int primary key, kind int)")
    show(mut &s, "insert into b select g, g % 10 from generate_series(1, 20000) g")
    show(mut &s, "create index b_kind on b (kind)")
    analyze(mut &s, "explain analyze select id from b where kind < 1")
    show(mut &s, "select count(*) from b where kind < 1")
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
