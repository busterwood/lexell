// lexdb_exec: the index-to-scan switch (optimizer 19). The first table's index range
// is counted before any row is read: a scan is taken when the table has at
// most twice the range's entries (an index entry costs about two reads, a
// scanned row one). Results must match a plain scan (`kind + 0` cannot use the
// index). Not switched: a path chosen for its order, a correlated subquery
// (run per outer row), a write, a read-write block. The EXPLAIN ANALYZE lines
// were checked by hand (the ranges read include the bound's value: 9.5).
// The rules mode keeps that rule; the cost mode (optimizer 38) uses the
// measured costs: a scan when the table has at most 16 times the range's
// entries (an index range's entry and its row 16, a scanned row 1, both in
// batches: lexdb.md 9.107; it was 3.75 when both were read row by row), a
// short range included (cases at the end).
// The queries switched read a column their index lacks (v, y): a range
// whose index holds every column used is read alone and never switched
// (9.107: no cheaper than its entries), as the first cases show.
// (The scan a range switches to skips the column leaves whose x, which
// follows the key, is past 1300 (design/lexdb.md 9.112): it reads 1386
// rows, not 20000.)
// expect: -- section 19's switch, which the rules mode keeps (the cost mode's, optimizer 38, at the end)
// expect: set lexdb_planner = rules -> SET
// expect: -- s: 5000 rows, kind = id % 10
// expect: create table s (id int primary key, kind int, v int) -> CREATE TABLE
// expect: insert into s select g, g % 10, g % 7 from generate_series(1, 5000) g -> INSERT 0 5000
// expect: create index s_kind on s (kind) -> CREATE INDEX
// expect: -- an index holding every column used: read alone, never switched
// expect: explain analyze select id from s where kind < 6 -> scan s: index s_kind range, index only (rows read 3500, kept 3000, batches 4)
// expect: -- a short range: the index, its keys read once
// expect: explain analyze select id, v from s where kind < 1 -> scan s: index s_kind range (rows read 1000, kept 500, batches 1)
// expect: select count(*) from s where kind < 1 -> [count] 500
// expect: explain analyze select id, v from s where kind = 3 -> scan s: index s_kind lookup (rows read 500, kept 500, batches 1)
// expect: -- 2000 entries of 5000 rows: the index is still cheaper
// expect: explain analyze select id, v from s where kind < 3 -> scan s: index s_kind range (rows read 2000, kept 1500, batches 2)
// expect: select count(*) from s where kind < 3 -> [count] 1500
// expect: -- 3500 entries of 5000 rows: a scan
// expect: explain analyze select id, v from s where kind < 6 -> scan s: index s_kind range (rows read 5000, kept 3000, batches 5, switched to scan: the range holds over half the table)
// expect: select count(*) from s where kind < 6 -> [count] 3000
// expect: select count(*) from s where kind + 0 < 6 -> [count] 3000
// expect: select count(*) from s where kind < 6 and v = 0 -> [count] 428
// expect: select count(*) from s where kind + 0 < 6 and v = 0 -> [count] 428
// expect: select count(*) from s where kind >= 2 -> [count] 4000
// expect: -- an ORDER BY the index supplies is never switched
// expect: explain analyze select id, v from s where kind < 6 order by kind, id limit 2 -> scan s: index s_kind range (rows read 2, kept 2); order: the scan's; limit: stops the scan
// expect: select id from s where kind < 6 order by kind, id limit 2 -> [id] 10; 20
// expect: -- a LIMIT or an EXISTS may stop early: no switch
// expect: explain analyze select id, v from s where kind < 6 limit 1 -> 0 switched
// expect: select count(*) from s where exists (select 1 from s x where x.kind < 6) -> [count] 5000
// expect: explain analyze select count(*) from s where exists (select 1 from s x where x.kind < 6) -> 0 switched
// expect: -- a correlated subquery keeps its index (it runs per outer row)
// expect: create table c (id int primary key) -> CREATE TABLE
// expect: insert into c select g from generate_series(7, 9) g -> INSERT 0 3
// expect: select count(*) from c where (select count(*) from s where s.kind < c.id) > 3000 -> [count] 3
// expect: explain analyze select count(*) from c where (select count(*) from s where s.kind < c.id) > 3000 -> 0 switched
// expect: -- a read-write block keeps its index; a read-only one may switch
// expect: begin -> BEGIN
// expect: explain analyze select id, v from s where kind < 6 -> 0 switched
// expect: commit -> COMMIT
// expect: begin read only -> BEGIN
// expect: explain analyze select id, v from s where kind < 6 -> 1 switched
// expect: commit -> COMMIT
// expect: -- an INSERT ... SELECT (its reads noted) gets the same rows
// expect: create table s2 (id int primary key, kind int, v int) -> CREATE TABLE
// expect: insert into s2 select id, kind, v from s where kind < 6 -> INSERT 0 3000
// expect: -- a write keeps its index; its result is the same
// expect: update s set v = v where kind < 6 -> UPDATE 3000
// expect: delete from s where kind > 7 -> DELETE 1000
// expect: select count(*) from s -> [count] 4000
// expect: -- b: 20000 rows. 4000 entries: the index (a fixed budget would have scanned)
// expect: create table b (id int primary key, kind int) -> CREATE TABLE
// expect: insert into b select g, g % 10 from generate_series(1, 20000) g -> INSERT 0 20000
// expect: create index b_kind on b (kind) -> CREATE INDEX
// expect: explain analyze select id from b where kind < 1 -> scan b: index b_kind range, index only (rows read 4000, kept 2000, batches 4)
// expect: select count(*) from b where kind < 1 -> [count] 2000
// expect: -- the cost mode (optimizer 38): an index range's entry and its row cost 16, a scanned row 1 (both in batches, 9.107), measured: a scan past 1/16 of the table
// expect: reset lexdb_planner -> RESET
// expect: create table w (id int primary key, x int, y int) -> CREATE TABLE
// expect: insert into w select g, g, g % 7 from generate_series(1, 20000) g -> INSERT 0 20000
// expect: create index w_x on w (x) -> CREATE INDEX
// expect: -- 1000 entries of 20,000 rows: the index; 1300: a scan (the rules: the index)
// expect: explain analyze select count(*), sum(y) from w where x <= 1000 -> scan w: index w_x range (rows read 1000, kept 1000, batches 1); aggregate
// expect: explain analyze select count(*), sum(y) from w where x <= 1300 -> scan w: index w_x range (rows read 1386, kept 1300, batches 2, switched to scan: cheaper than the range, by the measured costs); aggregate
// expect: select count(*), sum(y) from w where x <= 1300 -> [count,sum] 1300|3900
// expect: -- read alone (x only): the index, 6000 entries of them
// expect: explain analyze select count(*) from w where x <= 6000 -> scan w: index w_x range, index only (rows read 6000, kept 6000, batches 6); aggregate
// expect: -- a small table: a short range of 4 of 50 rows is scanned too; 3 is not
// expect: create table tiny (id int primary key, x int, y int) -> CREATE TABLE
// expect: insert into tiny select g, g, g % 7 from generate_series(1, 50) g -> INSERT 0 50
// expect: create index tiny_x on tiny (x) -> CREATE INDEX
// expect: explain analyze select count(*), sum(y) from tiny where x <= 4 -> scan tiny: index tiny_x range (rows read 50, kept 4, batches 1, switched to scan: cheaper than the range, by the measured costs); aggregate
// expect: explain analyze select count(*), sum(y) from tiny where x <= 3 -> scan tiny: index tiny_x range (rows read 3, kept 3, batches 1); aggregate
// expect: select count(*), sum(y) from tiny where x <= 4 -> [count,sum] 4|10
// expect: -- the rules mode keeps the index for each
// expect: set lexdb_planner = rules -> SET
// expect: explain analyze select count(*), sum(y) from w where x <= 1300 -> scan w: index w_x range (rows read 1300, kept 1300, batches 2); aggregate
// expect: explain analyze select count(*), sum(y) from tiny where x <= 4 -> scan tiny: index tiny_x range (rows read 4, kept 4, batches 1); aggregate
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "strings"

fn show(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows {
                println(sql + " -> " + r.tag)
                return
            }
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name) }
            println(sql + " -> [" + strings.join(&names, ",") + "]" + (if len(lines) > 0 { " " } else { "" }) + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

// EXPLAIN ANALYZE without its last line (the time).
fn analyze(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for i in 0..len(r.rows) - 1 { append(mut &lines, lexdb_exec.text(&r.rows[i][0])) }
            println(sql + " -> " + strings.join(&lines, "; "))
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

// EXPLAIN ANALYZE: how many of its lines say a scan was switched to.
fn switched(s: mut &lexdb_exec.Session, sql: str) {
    match s.exec(&sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var n = 0
            for row in r.rows {
                if strings.indexOf(&(lexdb_exec.text(&row[0])), "switched to scan", 0) >= 0 { n += 1 }
            }
            println(sql + " -> " + n.toStr() + " switched")
        }
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    println("-- section 19's switch, which the rules mode keeps (the cost mode's, optimizer 38, at the end)")
    show(mut &s, "set lexdb_planner = rules")
    println("-- s: 5000 rows, kind = id % 10")
    show(mut &s, "create table s (id int primary key, kind int, v int)")
    show(mut &s, "insert into s select g, g % 10, g % 7 from generate_series(1, 5000) g")
    show(mut &s, "create index s_kind on s (kind)")
    println("-- an index holding every column used: read alone, never switched")
    analyze(mut &s, "explain analyze select id from s where kind < 6")
    println("-- a short range: the index, its keys read once")
    analyze(mut &s, "explain analyze select id, v from s where kind < 1")
    show(mut &s, "select count(*) from s where kind < 1")
    analyze(mut &s, "explain analyze select id, v from s where kind = 3")
    println("-- 2000 entries of 5000 rows: the index is still cheaper")
    analyze(mut &s, "explain analyze select id, v from s where kind < 3")
    show(mut &s, "select count(*) from s where kind < 3")
    println("-- 3500 entries of 5000 rows: a scan")
    analyze(mut &s, "explain analyze select id, v from s where kind < 6")
    show(mut &s, "select count(*) from s where kind < 6")
    show(mut &s, "select count(*) from s where kind + 0 < 6")
    show(mut &s, "select count(*) from s where kind < 6 and v = 0")
    show(mut &s, "select count(*) from s where kind + 0 < 6 and v = 0")
    show(mut &s, "select count(*) from s where kind >= 2")
    println("-- an ORDER BY the index supplies is never switched")
    analyze(mut &s, "explain analyze select id, v from s where kind < 6 order by kind, id limit 2")
    show(mut &s, "select id from s where kind < 6 order by kind, id limit 2")
    println("-- a LIMIT or an EXISTS may stop early: no switch")
    switched(mut &s, "explain analyze select id, v from s where kind < 6 limit 1")
    show(mut &s, "select count(*) from s where exists (select 1 from s x where x.kind < 6)")
    switched(mut &s, "explain analyze select count(*) from s where exists (select 1 from s x where x.kind < 6)")
    println("-- a correlated subquery keeps its index (it runs per outer row)")
    show(mut &s, "create table c (id int primary key)")
    show(mut &s, "insert into c select g from generate_series(7, 9) g")
    show(mut &s, "select count(*) from c where (select count(*) from s where s.kind < c.id) > 3000")
    switched(mut &s, "explain analyze select count(*) from c where (select count(*) from s where s.kind < c.id) > 3000")
    println("-- a read-write block keeps its index; a read-only one may switch")
    show(mut &s, "begin")
    switched(mut &s, "explain analyze select id, v from s where kind < 6")
    show(mut &s, "commit")
    show(mut &s, "begin read only")
    switched(mut &s, "explain analyze select id, v from s where kind < 6")
    show(mut &s, "commit")
    println("-- an INSERT ... SELECT (its reads noted) gets the same rows")
    show(mut &s, "create table s2 (id int primary key, kind int, v int)")
    show(mut &s, "insert into s2 select id, kind, v from s where kind < 6")
    println("-- a write keeps its index; its result is the same")
    show(mut &s, "update s set v = v where kind < 6")
    show(mut &s, "delete from s where kind > 7")
    show(mut &s, "select count(*) from s")
    println("-- b: 20000 rows. 4000 entries: the index (a fixed budget would have scanned)")
    show(mut &s, "create table b (id int primary key, kind int)")
    show(mut &s, "insert into b select g, g % 10 from generate_series(1, 20000) g")
    show(mut &s, "create index b_kind on b (kind)")
    analyze(mut &s, "explain analyze select id from b where kind < 1")
    show(mut &s, "select count(*) from b where kind < 1")
    println("-- the cost mode (optimizer 38): an index range's entry and its row cost 16, a scanned row 1 (both in batches, 9.107), measured: a scan past 1/16 of the table")
    show(mut &s, "reset lexdb_planner")
    show(mut &s, "create table w (id int primary key, x int, y int)")
    show(mut &s, "insert into w select g, g, g % 7 from generate_series(1, 20000) g")
    show(mut &s, "create index w_x on w (x)")
    println("-- 1000 entries of 20,000 rows: the index; 1300: a scan (the rules: the index)")
    analyze(mut &s, "explain analyze select count(*), sum(y) from w where x <= 1000")
    analyze(mut &s, "explain analyze select count(*), sum(y) from w where x <= 1300")
    show(mut &s, "select count(*), sum(y) from w where x <= 1300")
    println("-- read alone (x only): the index, 6000 entries of them")
    analyze(mut &s, "explain analyze select count(*) from w where x <= 6000")
    println("-- a small table: a short range of 4 of 50 rows is scanned too; 3 is not")
    show(mut &s, "create table tiny (id int primary key, x int, y int)")
    show(mut &s, "insert into tiny select g, g, g % 7 from generate_series(1, 50) g")
    show(mut &s, "create index tiny_x on tiny (x)")
    analyze(mut &s, "explain analyze select count(*), sum(y) from tiny where x <= 4")
    analyze(mut &s, "explain analyze select count(*), sum(y) from tiny where x <= 3")
    show(mut &s, "select count(*), sum(y) from tiny where x <= 4")
    println("-- the rules mode keeps the index for each")
    show(mut &s, "set lexdb_planner = rules")
    analyze(mut &s, "explain analyze select count(*), sum(y) from w where x <= 1300")
    analyze(mut &s, "explain analyze select count(*), sum(y) from tiny where x <= 4")
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
