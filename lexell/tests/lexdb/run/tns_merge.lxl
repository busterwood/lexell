// lexdb over TNS: MERGE (design/lexdb-oracle.md, O3), checked against Oracle Database Free (generated
// by tests/lexdb/gen_oracle.py from oracle_merge_queries.txt): an upsert, UPDATE ... WHERE and DELETE
// WHERE, INSERT ... WHERE, one clause alone and in either order, sources that are tables, DUAL,
// subqueries and joins, ORA-30926 for a target row matched twice, NULL keys and the empty string, a
// table without a key, identity and sequence defaults, ORA-38104, constraints failing the whole
// statement, a transaction rolled back, and the errors of bad statements. Each answer is a label, then
// the row count, or the columns' names and rows, or error and the ORA- number.
// expect: create tgt: 0
// expect: tgt 1: 1
// expect: tgt 2: 1
// expect: tgt 3: 1
// expect: create src: 0
// expect: src 1: 1
// expect: src 2: 1
// expect: src 3: 1
// expect: src 4: 1
// expect: upsert: 4 / ID,NAME,QTY,NOTE = 1|'a'|10|NULL;2|'B'|25|NULL;3|'C'|37|NULL;4|'D'|9|NULL;5|'E'|11|NULL
// expect: after rollback: ID,NAME,QTY,NOTE = 1|'a'|10|NULL;2|'b'|20|NULL;3|'c'|30|NULL
// expect: update where: 1 / ID,NAME = 1|'a';2|'b';3|'C'
// expect: delete where: 2 / ID,NOTE = 1|NULL;2|'x'
// expect: delete where new values: 2 / ID,QTY = 1|10
// expect: update where and delete where: 1 / ID,NOTE = 1|NULL;3|NULL
// expect: insert where: 1 / ID,NAME,QTY = 1|'a'|10;2|'b'|20;3|'c'|30;5|'E'|0
// expect: update only: 2 / 2 / ID,NAME,QTY,NOTE = 1|'a'|10|NULL;2|'b'|20|NULL;3|'c'|30|NULL;4|'D'|9|NULL;5|'E'|11|NULL
// expect: insert first: 4 / ID,NAME,NOTE = 1|'a'|NULL;2|'b'|'upd';3|'c'|'upd';4|'D'|NULL;5|'E'|NULL
// expect: no alias: 2 / 2 / ID,NAME,QTY = 1|'a'|10;2|'B'|21;3|'C'|31
// expect: using dual: 1 / 1 / ID,NAME,NOTE = 1|'a'|'dual';2|'b'|NULL;3|'c'|NULL;99|'nn'|NULL
// expect: subquery source: 2 / 1 / 2 / ID,NAME,QTY,NOTE = 1|'one'|10|NULL;2|'b'|20|'b';3|'c'|3|'c';9|'nine'|0|NULL
// expect: no source rows: 0 / 0 / 4 / C,M = 7|1005
// expect: create dup: 0
// expect: dup 1: 1
// expect: dup 2: 1
// expect: dup 3: 1
// expect: dup update: error 30926 / 1 / ID,NAME = 1|'a';2|'b';3|'p'
// expect: dup insert only: 1 / error 1 / ID = 1;2;3;8
// expect: create nk: 0
// expect: nk 1: 1
// expect: nk 2: 1
// expect: null keys: 2 / K,V = 1|'x1';NULL|'n1';NULL|'n2' / 4 / ID,NAME,NOTE,N2 = 1|'a'|NULL|'a';2|'b'|NULL|'b';3|'c'|NULL|'c';4|NULL|NULL|'<null>';5|NULL|NULL|'<null>'
// expect: empty source value: 1 / ID,NAME = 2|NULL
// expect: create kl: 0
// expect: kl 1: 1
// expect: kl 2: 1
// expect: kl 3: 1
// expect: keyless: 3
// expect: keyless delete: 1
// expect: keyless rows: A,B = 1|'hit';1|'hit';3|'new'
// expect: create idt: 0
// expect: create seq: 0
// expect: create sqt: 0
// expect: identity insert: 3
// expect: identity rows: ID,V = 1|'a';2|'b';3|'c'
// expect: identity explicit: error 32795
// expect: identity update: error 32796
// expect: sequence default: 2
// expect: sequence nextval: 2
// expect: sequence rows: ID,V = 100|'p';101|'q';102|'p';103|'q'
// expect: update on column: error 38104
// expect: update on column 2: error 38104
// expect: not null update: error 1407
// expect: not null insert: error 1400
// expect: whole statement rows: ID,NAME = 2|'b'
// expect: unique violation: error 1
// expect: unique rows: C = 0
// expect: create par: 0
// expect: par 1: 1
// expect: par 2: 1
// expect: create kid: 0
// expect: kid ok: 2 / error 2291 / error 2290 / error 2291 / error 2292 / ID = 1;2
// expect: tx merge: 1 / NAME = 'in tx'
// expect: after tx rollback: NAME = 'a'
// expect: tx merge 2: 1
// expect: after commit: NAME = 'committed'
// expect: upper case: 4 / ID,NAME,NOTE = 1|'committed'|NULL;2|'b'|'UP';3|'c'|'UP';4|'D'|NULL;5|'E'|NULL
// expect: quoted names: 2 / ID,NOTE = 1|NULL;2|'q';3|'q'
// expect: unqualified where: 1 / ID,NOTE = 1|NULL;2|'w';3|NULL
// expect: unqualified delete where: 2 / ID,NOTE = 1|NULL;2|'w'
// expect: ambiguous on: error 918 / error 38101 / error 38101 / 3 / ID,NOTE = 1|NULL;2|'E';3|NULL;4|NULL;5|NULL
// expect: err no when: error 2000
// expect: err no parens: error 969
// expect: err delete alone: error 2000
// expect: err matched insert: error 2000
// expect: err not matched update: error 2000
// expect: err matched twice: error 2000
// expect: err not matched twice: error 2000
// expect: err by target: error 2000
// expect: err not enough values: error 947
// expect: err too many values: error 913
// expect: err no list not enough: error 947
// expect: err set column: error 904
// expect: err on column: error 904
// expect: err no target: error 942
// expect: err no source: error 942
// expect: err source column: error 904
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(sql.toStr(), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(sql.toStr(), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn q(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + qtext(c, sql)) }
fn x(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + xtext(c, sql)) }

// Statements and queries ("a ;; b ;; c") in one transaction, rolled back (t) or committed (u): each answer, joined by " / ".
fn tx(c: mut &oracle.Conn, label: &str, sqls: &str, commit: bool) {
    var out: []str = []
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for part in strings.split(sqls, " ;; ") {
            if strings.startsWith(&strings.toLowerAscii(part), "select") { append(mut &out, qtext(c2, part)) } else { append(mut &out, xtext(c2, part)) }
        }
        if !commit { return Err(sqldialect.inputError("rolled back")) }
        return Ok(0)
    })
    println(label + ": " + strings.join(&out, " / "))
}
fn t(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, false) }
fn u(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, true) }

fn connect(s: &str): oracle.Conn {
    match oracle.connect(s.toStr()) {
        Ok(c) { return c }
        Err(e) {
            println("connect: error " + e.code.toStr() + " " + e.msg)
            exit(1)
        }
    }
}

fn client(port: &str) {
    var c = connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb"))
    x(mut &c, "create tgt", "create table m_tgt (id number(10) primary key, name varchar2(20), qty number(10) default 0 not null, note varchar2(20))")
    x(mut &c, "tgt 1", "insert into m_tgt values (1, 'a', 10, null)")
    x(mut &c, "tgt 2", "insert into m_tgt values (2, 'b', 20, null)")
    x(mut &c, "tgt 3", "insert into m_tgt values (3, 'c', 30, null)")
    x(mut &c, "create src", "create table m_src (id number(10), name varchar2(20), qty number(10))")
    x(mut &c, "src 1", "insert into m_src values (2, 'B', 5)")
    x(mut &c, "src 2", "insert into m_src values (3, 'C', 7)")
    x(mut &c, "src 3", "insert into m_src values (4, 'D', 9)")
    x(mut &c, "src 4", "insert into m_src values (5, 'E', 11)")
    t(mut &c, "upsert", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.name = s.name, t.qty = t.qty + s.qty when not matched then insert (id, name, qty) values (s.id, s.name, s.qty) ;; select * from m_tgt order by id")
    q(mut &c, "after rollback", "select * from m_tgt order by id")
    t(mut &c, "update where", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.name = s.name where s.qty > 6 ;; select id, name from m_tgt order by id")
    t(mut &c, "delete where", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.note = 'x' delete where (t.id = 3) ;; select id, note from m_tgt order by id")
    t(mut &c, "delete where new values", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.qty = 0 delete where (t.qty = 0) ;; select id, qty from m_tgt order by id")
    t(mut &c, "update where and delete where", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.note = 'x' where t.id = 2 delete where (t.id = 2) ;; select id, note from m_tgt order by id")
    t(mut &c, "insert where", "merge into m_tgt t using m_src s on (t.id = s.id) when not matched then insert (id, name) values (s.id, s.name) where s.qty > 9 ;; select id, name, qty from m_tgt order by id")
    t(mut &c, "update only", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.name = lower(s.name) ;; merge into m_tgt t using m_src s on (t.id = s.id) when not matched then insert values (s.id, s.name, s.qty, null) ;; select * from m_tgt order by id")
    t(mut &c, "insert first", "merge into m_tgt t using m_src s on (t.id = s.id) when not matched then insert (id, name) values (s.id, s.name) when matched then update set t.note = 'upd' ;; select id, name, note from m_tgt order by id")
    t(mut &c, "no alias", "merge into m_tgt using m_src on (m_tgt.id = m_src.id) when matched then update set name = m_src.name ;; merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set name = s.name, qty = qty + 1 ;; select id, name, qty from m_tgt order by id")
    t(mut &c, "using dual", "merge into m_tgt t using dual on (t.id = 1) when matched then update set t.note = 'dual' when not matched then insert (id) values (1) ;; merge into m_tgt t using dual on (t.id = 99) when matched then update set t.note = 'dual' when not matched then insert (id, name) values (99, 'nn') ;; select id, name, note from m_tgt order by id")
    t(mut &c, "subquery source", "merge into m_tgt t using (select 9 id, 'nine' name from dual union all select 1, 'one' from dual) s on (t.id = s.id) when matched then update set t.name = s.name when not matched then insert (id, name) values (s.id, s.name) ;; merge into m_tgt t using (select count(*) c, 3 id from m_src where qty > 6) s on (t.id = s.id) when matched then update set t.qty = s.c ;; merge into m_tgt t using (select s.id, t2.name from m_src s join m_tgt t2 on t2.id = s.id) j on (t.id = j.id) when matched then update set t.note = j.name ;; select id, name, qty, note from m_tgt order by id")
    t(mut &c, "no source rows", "merge into m_tgt t using (select * from m_src where 1 = 0) s on (t.id = s.id) when matched then update set t.name = 'x' when not matched then insert (id) values (s.id) ;; merge into m_tgt t using (select 900 id from dual) s on (t.id = s.id) when matched then update set t.name = 'x' ;; merge into m_tgt t using m_src s on (1 = 0) when not matched then insert (id, name) values (s.id + 1000, s.name) ;; select count(*) c, max(id) m from m_tgt")
    x(mut &c, "create dup", "create table m_dup (id number(10), name varchar2(20))")
    x(mut &c, "dup 1", "insert into m_dup values (3, 'p')")
    x(mut &c, "dup 2", "insert into m_dup values (3, 'q')")
    x(mut &c, "dup 3", "insert into m_dup values (8, 'r')")
    t(mut &c, "dup update", "merge into m_tgt t using m_dup d on (t.id = d.id) when matched then update set t.name = d.name ;; merge into m_tgt t using m_dup d on (t.id = d.id) when matched then update set t.name = d.name where d.name = 'p' ;; select id, name from m_tgt order by id")
    t(mut &c, "dup insert only", "merge into m_tgt t using m_dup d on (t.id = d.id) when not matched then insert (id, name) values (d.id, d.name) ;; merge into m_tgt t using (select 50 id from dual union all select 50 from dual) d on (t.id = d.id) when not matched then insert (id) values (d.id) ;; select id from m_tgt order by id")
    x(mut &c, "create nk", "create table m_nk (k number, v varchar2(10))")
    x(mut &c, "nk 1", "insert into m_nk values (1, 'one')")
    x(mut &c, "nk 2", "insert into m_nk values (null, 'n1')")
    t(mut &c, "null keys", "merge into m_nk t using (select 1 k, 'x1' v from dual union all select null, 'n2' from dual) s on (t.k = s.k) when matched then update set t.v = s.v when not matched then insert (k, v) values (s.k, s.v) ;; select k, v from m_nk order by k, v ;; merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.note = '' when not matched then insert (id, name) values (s.id, '') ;; select id, name, note, nvl(name, '<null>') n2 from m_tgt order by id")
    t(mut &c, "empty source value", "merge into m_tgt t using (select 2 id, '' name from dual) s on (t.id = s.id) when matched then update set t.name = s.name ;; select id, name from m_tgt where id = 2")
    x(mut &c, "create kl", "create table m_kl (a number, b varchar2(10))")
    x(mut &c, "kl 1", "insert into m_kl values (1, 'x')")
    x(mut &c, "kl 2", "insert into m_kl values (1, 'x')")
    x(mut &c, "kl 3", "insert into m_kl values (2, 'y')")
    x(mut &c, "keyless", "merge into m_kl using (select 1 a from dual union all select 3 from dual) v on (m_kl.a = v.a) when matched then update set b = 'hit' when not matched then insert (a, b) values (v.a, 'new')")
    x(mut &c, "keyless delete", "merge into m_kl using (select 2 a from dual) v on (m_kl.a = v.a) when matched then update set b = 'gone' delete where (b = 'gone')")
    q(mut &c, "keyless rows", "select a, b from m_kl order by a, b")
    x(mut &c, "create idt", "create table m_idt (id number generated always as identity primary key, v varchar2(10))")
    x(mut &c, "create seq", "create sequence m_sq start with 100")
    x(mut &c, "create sqt", "create table m_sqt (id number default m_sq.nextval primary key, v varchar2(10))")
    x(mut &c, "identity insert", "merge into m_idt t using (select 'a' v from dual union all select 'b' from dual union all select 'c' from dual) s on (1 = 0) when not matched then insert (v) values (s.v)")
    q(mut &c, "identity rows", "select id, v from m_idt order by id")
    x(mut &c, "identity explicit", "merge into m_idt t using (select 9 id, 'z' v from dual) s on (t.id = s.id) when not matched then insert (id, v) values (s.id, s.v)")
    x(mut &c, "identity update", "merge into m_idt t using (select 'a' v from dual) s on (t.v = s.v) when matched then update set t.id = 5")
    x(mut &c, "sequence default", "merge into m_sqt t using (select 'p' v from dual union all select 'q' from dual) s on (1 = 0) when not matched then insert (v) values (s.v)")
    x(mut &c, "sequence nextval", "merge into m_sqt t using (select 'p' v from dual union all select 'q' from dual) s on (1 = 0) when not matched then insert (id, v) values (m_sq.nextval, s.v)")
    q(mut &c, "sequence rows", "select id, v from m_sqt order by id")
    x(mut &c, "update on column", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.id = 7")
    x(mut &c, "update on column 2", "merge into m_tgt t using m_src s on (t.id = s.id and t.name = s.name) when matched then update set t.name = 'z'")
    x(mut &c, "not null update", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.qty = null")
    x(mut &c, "not null insert", "merge into m_tgt t using (select 1000 id, 'bad' name from dual union all select 2, 'ok' from dual) s on (t.id = s.id) when matched then update set t.name = s.name when not matched then insert (id, name, qty) values (s.id, s.name, null)")
    q(mut &c, "whole statement rows", "select id, name from m_tgt where id in (2, 1000) order by id")
    x(mut &c, "unique violation", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.note = 'u' when not matched then insert (id, name) values (1, s.name)")
    q(mut &c, "unique rows", "select count(*) c from m_tgt where note = 'u'")
    x(mut &c, "create par", "create table m_par (id number primary key, tag varchar2(5))")
    x(mut &c, "par 1", "insert into m_par values (1, 'x')")
    x(mut &c, "par 2", "insert into m_par values (2, 'y')")
    x(mut &c, "create kid", "create table m_kid (id number primary key, p number references m_par, n number check (n > 0))")
    u(mut &c, "kid ok", "merge into m_kid k using (select 1 id, 1 p, 5 n from dual union all select 2, 2, 6 from dual) s on (k.id = s.id) when not matched then insert values (s.id, s.p, s.n) ;; merge into m_kid k using (select 3 id, 9 p, 5 n from dual) s on (k.id = s.id) when not matched then insert values (s.id, s.p, s.n) ;; merge into m_kid k using (select 3 id, 1 p, 0 n from dual) s on (k.id = s.id) when not matched then insert values (s.id, s.p, s.n) ;; merge into m_kid k using (select 1 id, 9 p from dual) s on (k.id = s.id) when matched then update set k.p = s.p ;; merge into m_par t using (select 1 id from dual) s on (t.id = s.id) when matched then update set t.tag = 'd' delete where (1 = 1) ;; select id from m_par order by id")
    t(mut &c, "tx merge", "merge into m_tgt t using (select 1 id from dual) s on (t.id = s.id) when matched then update set t.name = 'in tx' ;; select name from m_tgt where id = 1")
    q(mut &c, "after tx rollback", "select name from m_tgt where id = 1")
    u(mut &c, "tx merge 2", "merge into m_tgt t using (select 1 id from dual) s on (t.id = s.id) when matched then update set t.name = 'committed'")
    q(mut &c, "after commit", "select name from m_tgt where id = 1")
    t(mut &c, "upper case", "MERGE INTO M_TGT T USING M_SRC S ON (T.ID = S.ID) WHEN MATCHED THEN UPDATE SET T.NOTE = 'UP' WHEN NOT MATCHED THEN INSERT (ID, NAME) VALUES (S.ID, S.NAME) ;; select id, name, note from m_tgt order by id")
    t(mut &c, "quoted names", "merge into \"M_TGT\" \"T\" using \"M_SRC\" \"S\" on (\"T\".\"ID\" = \"S\".\"ID\") when matched then update set \"T\".\"NOTE\" = 'q' ;; select id, note from m_tgt order by id")
    t(mut &c, "unqualified where", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.note = 'w' where qty = 20 ;; select id, note from m_tgt order by id")
    t(mut &c, "unqualified delete where", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.note = 'w' delete where (qty = 30) ;; select id, note from m_tgt order by id")
    t(mut &c, "ambiguous on", "merge into m_tgt t using m_src s on (t.id = s.id and qty = 20) when matched then update set t.note = 'x' ;; merge into m_tgt t using m_src s on (t.id = s.id) when not matched then insert (id) values (t.id) ;; merge into m_tgt t using m_src s on (t.id = s.id) when not matched then insert (id) values (id) ;; merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.note = (select max(name) from m_src) where exists (select 1 from m_par p where p.id = t.id) when not matched then insert (id) values (s.id) where s.id in (select id from m_src where qty > 8) ;; select id, note from m_tgt order by id")
    x(mut &c, "err no when", "merge into m_tgt t using m_src s on (t.id = s.id)")
    x(mut &c, "err no parens", "merge into m_tgt t using m_src s on t.id = s.id when matched then update set t.name = s.name")
    x(mut &c, "err delete alone", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then delete")
    x(mut &c, "err matched insert", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then insert (id) values (1)")
    x(mut &c, "err not matched update", "merge into m_tgt t using m_src s on (t.id = s.id) when not matched then update set t.name = 'x'")
    x(mut &c, "err matched twice", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.name = 'x' when matched then update set t.name = 'y'")
    x(mut &c, "err not matched twice", "merge into m_tgt t using m_src s on (t.id = s.id) when not matched then insert (id) values (s.id) when not matched then insert (id) values (s.id)")
    x(mut &c, "err by target", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.name = s.name when not matched by target then insert (id) values (s.id)")
    x(mut &c, "err not enough values", "merge into m_tgt t using m_src s on (t.id = s.id) when not matched then insert (id, name) values (s.id)")
    x(mut &c, "err too many values", "merge into m_tgt t using m_src s on (t.id = s.id) when not matched then insert (id, name) values (s.id, 1, 2)")
    x(mut &c, "err no list not enough", "merge into m_tgt t using m_src s on (t.id = s.id) when not matched then insert values (s.id)")
    x(mut &c, "err set column", "merge into m_tgt t using m_src s on (t.id = s.id) when matched then update set t.nope = 1")
    x(mut &c, "err on column", "merge into m_tgt t using m_src s on (t.nope = s.id) when matched then update set t.name = 'x'")
    x(mut &c, "err no target", "merge into m_nope t using m_src s on (t.id = s.id) when matched then update set t.name = 'x'")
    x(mut &c, "err no source", "merge into m_tgt t using m_nope s on (t.id = s.id) when matched then update set t.name = 'x'")
    x(mut &c, "err source column", "merge into m_tgt t using m_src s on (t.id = s.nope) when matched then update set t.name = 'x'")
    c.logoff()
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
