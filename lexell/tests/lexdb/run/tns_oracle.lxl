// expect: to_char dates: TO_CHAR(HIRED,'YYYY-MM-DD'),TO_CHAR(HIRED,'DD-MON-YYYY'),TO_CHAR(HIRED,'DAY'),TO_CHAR(HIRED,'FMDDMONTH,YYYY'),TO_CHAR(HIRED) = '2020-01-15'|'15-JAN-2020'|'Wednesday'|'15 January, 2020'|'15-JAN-20'
// expect: to_char date parts: TO_CHAR(DATE'2024-03-05','DD/MM/RR'),TO_CHAR(DATE'2024-03-05','DDDDQJ'),TO_CHAR(DATE'2024-12-25','MONDY'),TO_CHAR(DATE'2024-03-05','HH12:MIAM') = '05/03/24'|'3 065 1 2460375'|'Dec WED'|'12:00 AM'
// expect: date arithmetic: HIRED+30,HIRED-1,DATE'2024-03-01'-DATE'2024-02-01',DATE'2024-03-01'-1.5 = '2020-02-14T00:00:00'|'2020-01-14T00:00:00'|29|'2024-02-28T12:00:00'
// expect: date difference: MAX(HIRED)-MIN(HIRED) = 532
// expect: add_months: ADD_MONTHS(DATE'2024-01-31',1),ADD_MONTHS(DATE'2024-02-29',12),ADD_MONTHS(DATE'2024-03-31',-1),ADD_MONTHS(DATE'2024-01-15',-13) = '2024-02-29T00:00:00'|'2025-02-28T00:00:00'|'2024-02-29T00:00:00'|'2022-12-15T00:00:00'
// expect: months_between: MONTHS_BETWEEN(DATE'2024-03-31',DATE'2024-02-29'),MONTHS_BETWEEN(DATE'2024-03-15',DATE'2024-01-15'),MONTHS_BETWEEN(DATE'2024-01-31',DATE'2024-03-31') = 1|2|-2
// expect: last_day next_day: LAST_DAY(DATE'2024-02-10'),LAST_DAY(DATE'2023-12-01'),NEXT_DAY(DATE'2024-02-10','MONDAY'),NEXT_DAY(DATE'2024-02-12','MON') = '2024-02-29T00:00:00'|'2023-12-31T00:00:00'|'2024-02-12T00:00:00'|'2024-02-19T00:00:00'
// expect: trunc dates: TRUNC(DATE'2024-05-17'),TRUNC(DATE'2024-05-17','MM'),TRUNC(DATE'2024-05-17','YYYY'),TRUNC(DATE'2024-05-17','Q'),TRUNC(TIMESTAMP'2024-05-1713:14:15','HH') = '2024-05-17T00:00:00'|'2024-05-01T00:00:00'|'2024-01-01T00:00:00'|'2024-04-01T00:00:00'|'2024-05-17T13:00:00'
// expect: trunc numbers: TRUNC(123.456),TRUNC(123.456,1),TRUNC(-123.456,-1),TRUNC(5),ROUND(123.456,1),CEIL(1.2),FLOOR(-1.2) = 123|123.4|-120|5|123.5|2|-2
// expect: sysdate: TRUNC(SYSDATE)=TRUNC(CURRENT_DATE),SYSDATE-SYSDATE,SYSDATE>DATE'2020-01-01',SYSTIMESTAMPISNOTNULL = true|0|true|true
// expect: user: USER,SYS_GUID()ISNOTNULL = 'SA'|true
