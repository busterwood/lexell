// lexdb's Oracle SQL surface (design/lexdb-oracle.md, stage O3), through the
// TNS door and lib/oracle: DUAL, SYSDATE, ROWNUM, FETCH FIRST and OFFSET, sequences
// (.NEXTVAL, .CURRVAL), NVL, NVL2, DECODE, ||, TO_CHAR, TO_DATE, TO_NUMBER,
// SUBSTR, INSTR, TRUNC, ADD_MONTHS, MONTHS_BETWEEN, LAST_DAY, NEXT_DAY, LISTAGG,
// MINUS, Oracle's type names, the empty string as NULL, names folded up,
// GENERATED AS IDENTITY, and (+) refused.
//
// VERIFIED against Oracle Database Free 23ai (gvenzl/oracle-free:slim) on 2026-11-13: each answer
// below is what that server gives for the statement (names and values), except where noted:
// USER is the login's name (SA here, APP there), DATE is a timestamp(0) (design/lexdb-oracle.md
// section 14), and `rownum before order` has no fixed answer on Oracle (its plan chose 4;3).
// Each line: a label, then the columns' names, then the rows (| between
// columns' values, ; between rows), or error and the ORA- number.
// expect: create emp: 0
// expect: insert 1: 1
// expect: insert 2: 1
// expect: insert 3: 1
// expect: insert 4 empty string: 1
// expect: select star: ID,NAME,SAL,HIRED,DEPT,MGR = 1|'Ann'|5000.50|'2020-01-15T00:00:00'|'ENG'|NULL;2|'Bob'|4000.00|'2021-06-30T00:00:00'|'OPS'|1;3|'Cy'|3000.00|NULL|'ENG'|1;4|'Di'|2000.00|NULL|NULL|NULL
// expect: dual: 1,'X' = 1|'x'
// expect: star from dual: DUMMY = 'X'
// expect: dummy: DUMMY = 'X'
// expect: expression names: 1+1,COUNT(*),UPPER(NAME),DBL = 2|1|'ANN'|2
// expect: empty is null: ID = 4
// expect: empty equals: ID = 
// expect: empty concat: NAME||DEPT||'!' = 'AnnENG!';'Di!'
// expect: null concat: 'A'||NULL||'B',NULL||NULL,CONCAT('X',NULL) = 'ab'|NULL|'x'
// expect: length empty: LENGTH(''),LENGTH(DEPT) = NULL|NULL
// expect: nvl: NVL(DEPT,'NONE'),NVL(MGR,-1) = 'ENG'|-1;'OPS'|1;'ENG'|1;'none'|-1
// expect: nvl2: NVL2(DEPT,'HAS','NO'),NVL2(NULL,1,2) = 'has'|2;'no'|2
// expect: decode: DECODE(DEPT,'ENG',1,'OPS',2,0),DECODE(DEPT,NULL,'N',DEPT),DECODE(1,2,'X') = 1|'ENG'|NULL;2|'OPS'|NULL;1|'ENG'|NULL;0|'n'|NULL
// expect: case: CASEWHENSAL>3500THEN'HI'ELSE'LO'END = 'hi';'hi';'lo';'lo'
// expect: division: 1/3,10/4,6/3,7/2 = 0.3333333333333333333333333333333333333|2.5|2|3.5
// expect: divide by zero: error 1476
// expect: arithmetic: 5-3,2*3+1,-4+1,MOD(7,3),POWER(2,10),SQRT(16) = 2|7|-3|1|1024|4
// expect: substr: SUBSTR('HELLO',2,3),SUBSTR('HELLO',-3),SUBSTR('HELLO',0,2),SUBSTR('HELLO',9),SUBSTR('HELLO',2,0) = 'ell'|'llo'|'he'|NULL|NULL
// expect: instr: INSTR('ABCABC','C'),INSTR('ABCABC','C',4),INSTR('ABCABC','C',1,2),INSTR('ABCABC','C',-1),INSTR('ABC','Z') = 3|6|6|6|0
// expect: string functions: UPPER('AB'),LOWER('AB'),INITCAP('HELLOWORLD'),LPAD('7',3,'0'),RPAD('AB',4,'*'),LTRIM('XXA','X'),RTRIM('AXX','X'),TRIM('B') = 'AB'|'ab'|'Hello World'|'007'|'ab**'|'a'|'a'|'b'
// expect: replace translate: REPLACE('BANANA','AN','AN'),REPLACE('BANANA','AN',''),REPLACE('BANANA','AN'),TRANSLATE('ABC','AB','XY') = 'bANANa'|'ba'|'ba'|'xyc'
// expect: to_char numbers: TO_CHAR(1234.5,'9,999.99'),TO_CHAR(-5,'9999'),TO_CHAR(5,'0000'),TO_CHAR(0.5),TO_CHAR(1.50),TO_CHAR(100),TO_CHAR(-0.25) = ' 1,234.50'|'   -5'|' 0005'|'.5'|'1.5'|'100'|'-.25'
// expect: to_char more: TO_CHAR(1234.5,'FM9,999.00'),TO_CHAR(5,'S99'),TO_CHAR(-0.5,'99.99PR'),TO_CHAR(1234,'9999') = '1,234.50'|' +5'|'  <.50>'|' 1234'
// expect: to_number: TO_NUMBER('12.5'),TO_NUMBER('1,234.5','9,999.9'),TO_NUMBER('-7') = 12.5|1234.5|-7
// expect: to_number error: error 1722
// expect: to_date: TO_DATE('2024-03-05','YYYY-MM-DD'),TO_DATE('15/03/202414:30','DD/MM/YYYYHH24:MI'),TO_DATE('05-MAR-24'),TO_DATE('12-31-2411:59PM','MM-DD-RRHH12:MIAM') = '2024-03-05T00:00:00'|'2024-03-15T14:30:00'|'2024-03-05T00:00:00'|'2024-12-31T23:59:00'
// expect: to_date names: TO_DATE('MARCH5,2024','MONTHDD,YYYY'),TO_DATE('5MAR2024','DDMONYYYY') = '2024-03-05T00:00:00'|'2024-03-05T00:00:00'
// expect: to_date errors: error 1843
