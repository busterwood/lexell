// lexdb_exec: enum types, checked against PostgreSQL 18 (generated by
// tests/lexdb/gen_pg.py from enum_queries.txt): CREATE TYPE ... AS ENUM, a
// column of one with a default, labels checked, ordered by their places (=,
// <, BETWEEN, ORDER BY, GROUP BY, with an index), ADD VALUE BEFORE and AFTER,
// the catalog's rows, casts, DROP TYPE and its refusals (9.90).
// Each expect line: a query's rows or tag, or ERROR and its SQLSTATE.
// expect: CREATE TYPE
// expect: CREATE TABLE
// expect: INSERT 0 3
// expect: INSERT 0 1
// expect: ERROR 22P02
// expect: b|sad;c|ok;d|ok;a|happy
// expect: a
// expect: b
// expect: a;b
// expect: a;b
// expect: b;c;d
// expect: sad|1;ok|2;happy|1
// expect: a;c;d;b
// expect: CREATE INDEX
// expect: a;c;d
// expect: ERROR 22P02
// expect: ALTER TYPE
// expect: UPDATE 1
// expect: b|sad;a|meh;c|ok;d|ok
// expect: ALTER TYPE
// expect: ERROR 42710
// expect: ALTER TYPE
// expect: ERROR 22023
// expect: ERROR 42704
// expect: sad;meh;ok;happy;ecstatic
// expect: mood|e|E
// expect: mood
// expect: USER-DEFINED|mood
// expect: happy
// expect: sad
// expect: ERROR 42710
// expect: ERROR 23505
// expect: CREATE TYPE
// expect: ERROR 42704
// expect: ERROR 2BP01
// expect: ERROR 42704
// expect: DROP TYPE
// expect: SELECT 4
// expect: 4
// expect: DROP TABLE
// expect: DROP TYPE
// expect: 0
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create type mood as enum ('sad', 'ok', 'happy')\ncreate table person (id int primary key, name text, m mood not null default 'ok')\ninsert into person values (1, 'a', 'happy'), (2, 'b', 'sad'), (3, 'c', 'ok')\ninsert into person (id, name) values (4, 'd')\ninsert into person values (5, 'e', 'angry')\nselect name, m from person order by m, name\nselect name from person where m > 'ok' order by name\nselect name from person where m = 'sad'\nselect name from person where m <> 'ok' order by name\nselect name from person where m in ('sad', 'happy') order by name\nselect name from person where m between 'sad' and 'ok' order by name\nselect m, count(*) from person group by m order by m\nselect name from person order by m desc, name\ncreate index person_m on person (m)\nselect name from person where m >= 'ok' order by m desc, name\nupdate person set m = 'meh' where id = 1\nalter type mood add value 'meh' before 'ok'\nupdate person set m = 'meh' where id = 1\nselect name, m from person order by m, name\nalter type mood add value 'ecstatic'\nalter type mood add value 'meh'\nalter type mood add value if not exists 'meh'\nalter type mood add value 'x' after 'nope'\nalter type nope add value 'x'\nselect e.enumlabel from pg_enum e join pg_type t on t.oid = e.enumtypid where t.typname = 'mood' order by e.enumsortorder\nselect typname, typtype, typcategory from pg_type where typname = 'mood'\nselect format_type(atttypid, atttypmod) from pg_attribute where attrelid = 'person'::regclass and attname = 'm'\nselect data_type, udt_name from information_schema.columns where table_name = 'person' and column_name = 'm'\nselect 'happy'::mood\nselect m::text from person where id = 2\ncreate type mood as enum ('x')\ncreate type dup as enum ('a', 'a')\ncreate type empty as enum ()\ncreate table t2 (x nosuch)\ndrop type mood\ndrop type nope\ndrop type if exists nope\ncreate table person2 as select * from person\nselect count(*) from person2\ndrop table person, person2\ndrop type mood, empty\nselect count(*) from pg_type where typname = 'mood'"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(90), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
