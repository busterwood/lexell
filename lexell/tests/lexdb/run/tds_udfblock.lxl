// lexdb over TDS: a scalar function called in a statement inside a batch with control flow, a procedure, EXEC, sp_executesql and a cursor's query
// (SELECT @v = f(x), INSERT, UPDATE and DELETE with a call, a WHILE loop), checked against SQL Server 2022 (generated by tests/lexdb/gen_mssql.py
// udfblock from mssql_udfblock_queries.txt; the Oracle door had this wrong, KNOWN-ISSUES.md). Each batch runs with SET lexdb_batch off and on;
// each expect line: "same: " and the batch's result sets and counts, or its error number.
// expect: ok
// expect: (3)
// expect: ok
// expect: ok
// expect: ok
// expect: same: y: 2;4;6
// expect: same: (1) / (1) / v: 2 / a,c: 1|10;2|20;3|30;102|0
// expect: same: (1) / (1) / a,c: 1|10;2|20;3|30;106|1
// expect: same: (1) / (1) / (1) / (1) / a,c: 1|20;2|20;3|30;10|3;102|0
// expect: same: (1) / (1) / (1) / (1) / (1) / a,c: 1|10;2|20;3|30;202|4;203|4
// expect: same: (1) / (1) / a,c: 1|10;2|20;3|30;306|5
// expect: same: (1) / a,c: 1|10;2|20;3|9
// expect: same: (1) / a,c: 1|10;3|30
// expect: same: (3) / v: 6
// expect: same: (1) / v: NULL
import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "@once CREATE TABLE ub (a int PRIMARY KEY, c int)\n@once INSERT INTO ub VALUES (1, 10), (2, 20), (3, 30)\n@once CREATE FUNCTION dbo.ubf(@x int) RETURNS int AS BEGIN RETURN @x * 2 END\n@once CREATE FUNCTION dbo.ubg(@x int) RETURNS int AS BEGIN DECLARE @r int = 0; IF @x > 1 SET @r = @x * 3 ELSE SET @r = 1; RETURN @r END\n@once CREATE PROCEDURE dbo.ubp @x int AS BEGIN DECLARE @v int; SELECT @v = dbo.ubf(a) FROM ub WHERE a = @x; INSERT INTO ub VALUES (@v + 100, 0); INSERT INTO ub VALUES (dbo.ubf(5), 3); UPDATE ub SET c = dbo.ubf(c) WHERE a = @x END\nSELECT dbo.ubf(a) AS y FROM ub ORDER BY a\nBEGIN TRANSACTION; DECLARE @v int; SELECT @v = dbo.ubf(a) FROM ub WHERE a = 1; INSERT INTO ub VALUES (@v + 100, 0); SELECT @v AS v; SELECT a, c FROM ub ORDER BY a; ROLLBACK\nBEGIN TRANSACTION; IF 1 = 1 BEGIN DECLARE @v int; SELECT @v = dbo.ubg(a) FROM ub WHERE a = 2; INSERT INTO ub VALUES (@v + 100, 1) END; SELECT a, c FROM ub ORDER BY a; ROLLBACK\nBEGIN TRANSACTION; EXEC dbo.ubp 1; SELECT a, c FROM ub ORDER BY a; ROLLBACK\nBEGIN TRANSACTION; DECLARE @i int = 0; WHILE @i < 2 BEGIN INSERT INTO ub SELECT dbo.ubf(a) + 200 + @i, 4 FROM ub WHERE a = 1; SET @i = @i + 1 END; SELECT a, c FROM ub ORDER BY a; ROLLBACK\nBEGIN TRANSACTION; EXEC('DECLARE @v int; SELECT @v = dbo.ubf(a) FROM ub WHERE a = 3; INSERT INTO ub VALUES (@v + 300, 5)'); SELECT a, c FROM ub ORDER BY a; ROLLBACK\nBEGIN TRANSACTION; EXEC sp_executesql N'UPDATE ub SET c = dbo.ubg(a) WHERE a = @p', N'@p int', 3; SELECT a, c FROM ub ORDER BY a; ROLLBACK\nBEGIN TRANSACTION; DELETE FROM ub WHERE a = dbo.ubf(1); SELECT a, c FROM ub ORDER BY a; ROLLBACK\nBEGIN TRY DECLARE @v int; SELECT @v = dbo.ubf(a) FROM ub; SELECT @v AS v END TRY BEGIN CATCH SELECT ERROR_NUMBER() AS e END CATCH\nDECLARE @v int; SELECT @v = dbo.ubf(NULL); SELECT @v AS v"
const BOTH = true   // each batch twice against lexdb, SET lexdb_batch = off and on
const MSGS = false   // an error with its line and text, not its number alone

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, strings.replaceAll(&v.toStr(), "\n", "\\n")) }       // (a newline in a value as \n: one line per batch)
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) {
            if MSGS {
                let ms = c.errors()
                if len(ms) > 0 { return "error " + ms[0].number.toStr() + " line " + ms[0].line.toStr() + ": " + ms[0].text }
            }
            return "error " + e.code.toStr()
        }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@lines " (\n in it is a newline: a batch of several lines), "@once " (in a BOTH suite, run once: setup and writes kept),
// "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                var single = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@lines ") {
                        // a batch of several lines: \n in the line is a newline
                        q = strings.replaceAll(&q[7..len(q)], "\\n", "\n")
                    } else if strings.startsWith(&q, "@once ") {
                        single = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 && BOTH && !single {
                    if oracle {
                        println("same: " + show(mut &c, &q, only))
                        continue
                    }
                    let a = show(mut &c, &"SET lexdb_batch = off", false)
                    let off = show(mut &c, &q, only)
                    let b = show(mut &c, &"SET lexdb_batch = on", false)
                    let on = show(mut &c, &q, only)
                    if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(72), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
