import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create schema rep\ncreate table emp (id int primary key, name text not null, dept int, salary numeric(10,2), active boolean default true)\ncreate table dept (id int primary key, title varchar(30))\ninsert into dept values (1, 'Eng'), (2, 'Ops'), (3, 'Empty')\ninsert into emp values (1, 'Ann', 1, 100.50, true), (2, 'Bob', 1, 90, true), (3, 'Cy', 2, 70, false), (4, 'Di', null, 50, true)\ncreate view active_emp as select id, name, dept, salary from emp where active\ncreate view emp_dept (emp, dept_title) as select e.name, d.title from emp e join dept d on d.id = e.dept\ncreate view dept_pay as select d.title, count(e.id) as n, sum(e.salary) as total from dept d left join emp e on e.dept = d.id group by d.title\ncreate view top_paid as select name, salary from active_emp where salary > 60\ncreate view rep.summary as with t as (select dept, max(salary) as top from emp group by dept) select dept, top from t where dept is not null\ncreate view colours as values (1, 'red'), (2, 'green')\nselect * from active_emp order by id\nselect * from emp_dept order by emp\nselect * from dept_pay order by title\nselect * from top_paid order by salary desc\nselect * from rep.summary order by dept\nselect * from colours order by column1\nselect a.name, d.title from active_emp a join dept d on d.id = a.dept order by 1\nselect count(*), sum(salary) from active_emp where dept = 1\nselect name from emp where id in (select id from top_paid) order by 1\nselect t.emp from emp_dept t where t.dept_title = 'Eng' order by 1\nselect v.x, v.y from emp_dept as v(x, y) order by 1\nselect (select n from dept_pay where title = 'Ops'), (select max(total) from dept_pay)\nselect emp from emp_dept\ncreate view active_emp as select 1\ncreate table active_emp (id int primary key)\ncreate or replace view active_emp as select id, name, dept, salary, active from emp where active\nselect * from active_emp order by id\ncreate or replace view active_emp as select id, name from emp\ncreate or replace view active_emp as select id, name as nm, dept, salary, active from emp\ncreate or replace view active_emp as select id, name, dept, salary::text, active from emp\ncreate view bad (a, b, c) as select 1, 2\ncreate view dup as select 1 as a, 2 as a\nselect table_schema, table_name, table_type from information_schema.tables where table_schema in ('public', 'rep') order by 2\nselect table_name, column_name, ordinal_position, data_type, is_nullable from information_schema.columns where table_name in ('active_emp', 'emp_dept', 'dept_pay', 'colours') order by 1, 3\nselect table_schema, table_name, check_option from information_schema.views where table_schema in ('public', 'rep') order by 2\nselect schemaname, viewname from pg_views where schemaname in ('public', 'rep') order by 2\nselect c.relname, c.relkind, c.relnatts from pg_class c join pg_namespace n on n.oid = c.relnamespace where n.nspname in ('public', 'rep') and c.relkind = 'v' order by 1\nselect a.attname, a.attnum, format_type(a.atttypid, -1) from pg_attribute a where a.attrelid = 'dept_pay'::regclass and a.attnum > 0 order by 2\nselect 'top_paid'::regclass::text, pg_get_viewdef('nope'::regclass)\ndrop table emp\ndrop view dept\ndrop table top_paid\ndrop view active_emp\ndrop view top_paid\ndrop view active_emp\nselect * from top_paid\ndrop view if exists nothing_here, colours\nselect count(*) from pg_views where viewname = 'colours'\ndrop table emp cascade\nselect table_name from information_schema.views where table_schema in ('public', 'rep') order by 1\ndrop schema rep cascade\nselect count(*) from pg_views where schemaname = 'rep'\nselect x.a, x.b from dept as x(a, b) where x.a < 3 order by 1\nselect * from dept x(a) order by a\nselect trim(trailing ';' from 'ab;;'), trim(leading 'x' from 'xxaxx'), trim(both 'x' from 'xxaxx'), trim(' a '), btrim('xax', 'x'), trim(both from '  b  '), ltrim('aab', 'a'), rtrim('baa', 'a')"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(82), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
