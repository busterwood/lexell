// expect: active_emp|id|1|integer|YES;active_emp|name|2|text|YES;active_emp|dept|3|integer|YES;active_emp|salary|4|numeric|YES;active_emp|active|5|boolean|YES;colours|column1|1|integer|YES;colours|column2|2|text|YES;dept_pay|title|1|character varying|YES;dept_pay|n|2|bigint|YES;dept_pay|total|3|numeric|YES;emp_dept|emp|1|text|YES;emp_dept|dept_title|2|character varying|YES
// expect: public|active_emp|NONE;public|colours|NONE;public|dept_pay|NONE;public|emp_dept|NONE;rep|summary|NONE;public|top_paid|NONE
// expect: public|active_emp;public|colours;public|dept_pay;public|emp_dept;rep|summary;public|top_paid
