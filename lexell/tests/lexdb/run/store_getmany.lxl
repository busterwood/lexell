// lexdb_store: getMany (design/lexdb.md 9.107) against get, key by key.
// A tree of 3,000 keys (a third of 0..9,000, so lookups miss too), some of
// whose values are stored apart (with a head kept in the leaf, and
// without), in a cache small enough that nodes are evicted and loaded
// while it runs. For each kind of transaction (a live one, a snapshot, a
// block), with and without its own writes (puts, deletes, a large value),
// lists of keys sorted, in random order, with repeats, before the first
// and after the last, run by getMany in one transaction and by get one by
// one in another made the same way, in full and in part: the same values,
// and the same reads noted, in the same order.
// expect: lists: 108, values the same: 108, reads the same: 108, reads noted: true
// expect: loads while running: true
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_base"

fn key(i: int): str { return "k" + strings.padLeft(&(i.toStr()), 5, '0') }

fn opts(): lexdb_store.Options {
    return lexdb_store.Options{cacheBytes: 96 * 1024, segBytes: 4 * 1024 * 1024, ckptBytes: 256 * 1024, snapNodes: 100000}
}

fn val(i: int): str {
    if i % 97 == 0 { return strings.repeat(&("v" + i.toStr()), 900) }        // stored apart
    return "v" + i.toStr()
}

// A transaction of kind (0 live, 1 snapshot, 2 block), with its own writes or not.
fn txn(st: &lexdb_store.Store, tree: int, kind: int, own: bool): lexdb_store.Txn {
    var t = if kind == 0 { lexdb_store.begin() } else if kind == 1 { st.beginSnapshot().unwrap() } else { st.beginBlock().unwrap() }
    if own {
        for i in 0..40 {
            let k = i * 211 % 9000
            if i % 3 == 0 { t.del(tree, key(k)) } else { t.put(tree, key(k), "own" + i.toStr()).unwrap() }
        }
        t.put(tree, key(4501), strings.repeat("big", 2000)).unwrap()
    }
    return t
}

fn show(o: &Option[str]): str {
    match o {
        Some(v) { return if len(v) > 40 { "long " + len(v).toStr() + " " + v[0..6] + v[len(v) - 6..len(v)] } else { v } }
        None { return "-" }
    }
}

fn keysOf(r: mut &lexdb_base.Rng, shape: int): []str {
    var ks: []str = []
    let n = 1 + r.below(300)
    if shape == 0 {
        // sorted, clustered: a run from a random start, some keys repeated
        var at = r.below(9000)
        for i in 0..n {
            append(mut &ks, key(at))
            if r.below(4) != 0 { at += 1 + r.below(3) }
        }
    } else if shape == 1 {
        for i in 0..n { append(mut &ks, key(r.below(9200))) }       // random order
    } else if shape == 2 {
        // sorted, spread over the whole tree
        var at = 0
        for i in 0..n {
            at += r.below(60)
            append(mut &ks, key(at))
        }
    } else {
        // the ends: before the first, after the last, and the first and last
        append(mut &ks, "a")
        append(mut &ks, key(0))
        for i in 0..n { append(mut &ks, key(8990 + r.below(20))) }
        append(mut &ks, "z")
        append(mut &ks, "")
    }
    return ks
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(7), opts(), fn(st: lexdb_store.Store): int {
        var t0 = lexdb_store.begin()
        let tree = st.createTree(mut &t0)
        st.commit(t0).unwrap()
        var at = 0
        while at < 9000 {
            var t = lexdb_store.begin()
            var j = 0
            while j < 300 && at < 9000 {
                if at % 3 == 0 {
                    if at % 194 == 0 { t.putRow(tree, key(at), val(at), 40).unwrap() } else { t.put(tree, key(at), val(at)).unwrap() }
                }
                at += 1
                j += 1
            }
            st.commit(t).unwrap()
        }
        st.checkpoint().unwrap()
        let loads0 = st.stats().loads
        var r = lexdb_base.rng(11)
        var lists = 0
        var sameV = 0
        var sameR = 0
        var anyReads = false
        for kind in 0..3 {
            for own in [false, true] {
                for part in [false, true] {
                    for rep in 0..9 {
                        let ks = keysOf(mut &r, rep % 4)
                        var a = txn(&st, tree, kind, own)
                        var b = txn(&st, tree, kind, own)
                        var va: []str = []
                        for k in ks {
                            let got = if part { st.getPart(mut &a, tree, k).unwrap() } else { st.get(mut &a, tree, k).unwrap() }
                            append(mut &va, show(&got))
                        }
                        var outs: []Option[str] = []
                        st.getMany(mut &b, tree, &ks, part, mut &outs).unwrap()
                        var vb: []str = []
                        for o in outs { append(mut &vb, show(&o)) }
                        lists += 1
                        if strings.join(&va, ",") == strings.join(&vb, ",") { sameV += 1 } else { println("values differ: kind " + kind.toStr() + " own " + own.toStr() + " part " + part.toStr() + " shape " + (rep % 4).toStr()) }
                        if a.readsText() == b.readsText() { sameR += 1 } else {
                            println("reads differ: kind " + kind.toStr() + " own " + own.toStr() + " shape " + (rep % 4).toStr())
                            println(a.readsText())
                            println(b.readsText())
                        }
                        if len(a.readsText()) > 0 { anyReads = true }
                        st.abort(a)
                        st.abort(b)
                    }
                }
            }
        }
        println("lists: " + lists.toStr() + ", values the same: " + sameV.toStr() + ", reads the same: " + sameR.toStr() + ", reads noted: " + anyReads.toStr())
        println("loads while running: " + (st.stats().loads > loads0).toStr())
        return 0
    }).unwrap()
}
