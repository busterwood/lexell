// lexdb_store: snapshots. Transfers commit while snapshot readers add up
// every account, one read at a time with other tasks running in between:
// each snapshot's total is the same, a key read twice in one snapshot gives
// the same value, and no snapshot aborts. With a small cache the nodes are
// evicted and loaded meanwhile. A snapshot that needs more old versions
// than the budget allows is cancelled with 72000.
// expect: snapshots 60 consistent 60 repeatable 60 failed 0
// expect: transfers done 300 total 120000
// expect: too old 72000
import "task"
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_base"

const ACCOUNTS = 1200

type Tally = record { snaps: int; consistent: int; repeatable: int; failed: int; transfers: int }

type Arg = record { st: lexdb_store.Store; tree: int; seed: int; tally: task.Shared[Tally] }

fn acct(i: int): str { return "a" + strings.padLeft(i.toStr(), 5, '0') }

fn num(o: Option[str]): int {
    match o {
        Some(s) { return strings.parseIntOpt(s).unwrapOr(0) }
        None { return 0 }
    }
}

fn mover(a: Arg): int {
    var r = lexdb_base.rng(a.seed)
    var done = 0
    while done < 50 {
        var t = lexdb_store.begin()
        let x = r.below(ACCOUNTS)
        var y = r.below(ACCOUNTS - 1)
        if y >= x { y += 1 }
        let vx = num(a.st.get(mut &t, a.tree, acct(x)).unwrap())
        let vy = num(a.st.get(mut &t, a.tree, acct(y)).unwrap())
        t.put(a.tree, acct(x), (vx - 7).toStr()).unwrap()
        t.put(a.tree, acct(y), (vy + 7).toStr()).unwrap()
        match a.st.commit(t) {
            Ok(_) { done += 1 }
            Err(e) { if e.state != lexdb_base.S_CONFLICT { panic(e.toStr()) } }
        }
        let yd = task.yield()
    }
    a.tally.with(fn(t: mut &Tally) { t.transfers += done })
    return 0
}

fn reader(a: Arg): int {
    var r = lexdb_base.rng(a.seed)
    for k in 0..10 {
        var t = a.st.beginSnapshot().unwrap()
        let probe = acct(r.below(ACCOUNTS))
        let first = num(a.st.get(mut &t, a.tree, probe).unwrap())
        var total = 0
        var ok = true
        var i = 0
        while i < ACCOUNTS {
            // a scan of 100 accounts at a time, other tasks running in between
            match a.st.scan(mut &t, a.tree, acct(i), acct(i + 100), fn(e: &lexdb_store.Entry): bool {
                total += strings.parseIntOpt(e.val).unwrapOr(0)
                return true
            }) {
                Ok(_) {}
                Err(e) { ok = false }
            }
            let yd = task.yield()
            i += 100
        }
        let again = num(a.st.get(mut &t, a.tree, probe).unwrap())
        let committed = a.st.commit(t).isOk()
        let fine = committed && ok
        a.tally.with(fn(tl: mut &Tally) {
            tl.snaps += 1
            if total == ACCOUNTS * 100 { tl.consistent += 1 }
            if first == again { tl.repeatable += 1 }
            if !fine { tl.failed += 1 }
        })
    }
    return 0
}

fn opts(): lexdb_store.Options {
    return lexdb_store.Options{cacheBytes: 20 * 2048, segBytes: 64 * 4096, ckptBytes: 16 * 4096, snapNodes: 100000, bufferedPages: false}
}

fn main() {
    let tally = task.shared(Tally{snaps: 0, consistent: 0, repeatable: 0, failed: 0, transfers: 0})
    var final = 0
    lexdb_store.run(lexdb_disk.sim(11), opts(), fn(st: lexdb_store.Store): int {
        var t = lexdb_store.begin()
        let tree = st.createTree(mut &t)
        for i in 0..ACCOUNTS { t.put(tree, acct(i), "100").unwrap() }
        st.commit(t).unwrap()
        task.scope(fn(s: mut &task.Scope) {
            for i in 0..6 { s.spawn(mover, Arg{st: st, tree: tree, seed: i + 1, tally: tally}) }
            for i in 0..6 { s.spawn(reader, Arg{st: st, tree: tree, seed: i + 100, tally: tally}) }
        })
        var c = lexdb_store.begin()
        st.scan(mut &c, tree, "", "", fn(e: &lexdb_store.Entry): bool {
            final += strings.parseIntOpt(e.val).unwrapOr(0)
            return true
        }).unwrap()
        return 0
    }).unwrap()
    tally.with(fn(t: mut &Tally) {
        println("snapshots " + t.snaps.toStr() + " consistent " + t.consistent.toStr() + " repeatable " +
                t.repeatable.toStr() + " failed " + t.failed.toStr())
        println("transfers done " + t.transfers.toStr() + " total " + final.toStr())
    })
    // A budget of 1 old version: a long snapshot is cancelled. (It was 3;
    // the 1,200 accounts took 4 leaves, and front coded (design/lexdb.md
    // 9.109) they take 3, so the 20 commits below keep at most 3 versions
    // the snapshot needs.)
    lexdb_store.run(lexdb_disk.sim(12), lexdb_store.Options{cacheBytes: 1000 * 2048, segBytes: 64 * 4096, ckptBytes: 16 * 4096, snapNodes: 1, bufferedPages: false}, fn(st: lexdb_store.Store): int {
        var t = lexdb_store.begin()
        let tree = st.createTree(mut &t)
        for i in 0..ACCOUNTS { t.put(tree, acct(i), "100").unwrap() }
        st.commit(t).unwrap()
        var snap = st.beginSnapshot().unwrap()
        for i in 0..20 {
            var w = lexdb_store.begin()
            w.put(tree, acct(i * 50), "1").unwrap()
            st.commit(w).unwrap()
        }
        match st.get(mut &snap, tree, acct(0)) {
            Ok(_) { println("too old: not cancelled") }
            Err(e) { println("too old " + e.state) }
        }
        st.abort(snap)
        return 0
    }).unwrap()
}
