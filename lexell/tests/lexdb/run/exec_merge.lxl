import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table tgt (id int primary key, name text, qty int not null default 0, note text)\ninsert into tgt values (1, 'a', 10, null), (2, 'b', 20, null), (3, 'c', 30, null)\ncreate table src (id int, name text, qty int)\ninsert into src values (2, 'B', 5), (3, 'C', 7), (4, 'D', 9), (5, 'E', 11)\nmerge into tgt t using src s on t.id = s.id when matched then update set name = s.name, qty = t.qty + s.qty when not matched then insert (id, name, qty) values (s.id, s.name, s.qty)\nselect * from tgt order by id\nmerge into tgt using (values (6, 'F', 1)) as v(id, name, qty) on tgt.id = v.id when not matched then insert values (v.id, v.name, default)\nselect * from tgt where id = 6\nmerge into tgt t using src s on t.id = s.id when matched and s.qty > 10 then delete when matched and s.qty > 6 then update set note = 'big' when matched then update set note = 'small' when not matched and s.qty < 10 then insert (id, name) values (s.id, s.name)\nselect * from tgt order by id\nmerge into tgt t using src s on t.id = s.id when matched and t.id = 2 then do nothing when matched and t.id = 3 then update set note = 'three'\nselect * from tgt where id in (2, 3) order by id\nmerge into tgt t using src s on t.id = s.id when not matched then do nothing\nmerge into tgt t using src s on t.id = s.id when matched then do nothing\nmerge into tgt t using (select 1 as id union all select 2) s on t.id = s.id when matched then delete\nselect * from tgt order by id\nmerge into tgt t using (select id, name from src where id > 3) s on t.id = s.id when matched then update set name = lower(s.name) when not matched then insert (id, name) values (s.id + 100, s.name)\nselect * from tgt order by id\nmerge into tgt t using (values (3, 'x'), (77, 'y')) as v (id, name) on t.id = v.id when matched then update set name = v.name when not matched then insert (id, name) values (v.id, v.name)\nselect * from tgt order by id\nmerge into tgt t using (select name, sum(qty) as q from src group by name) s on t.name = lower(s.name) when matched then update set qty = s.q\nselect * from tgt order by id\ncreate table dup (id int, name text)\ninsert into dup values (3, 'p'), (3, 'q'), (8, 'r')\nmerge into tgt t using dup d on t.id = d.id when matched then update set name = d.name\nmerge into tgt t using dup d on t.id = d.id when matched then delete\nmerge into tgt t using dup d on t.id = d.id when matched and d.name = 'p' then update set name = 'only p'\nselect * from tgt order by id\nmerge into tgt t using dup d on t.id = d.id when matched then do nothing when not matched then insert (id, name) values (d.id, d.name)\nselect * from tgt order by id\nmerge into tgt t using (values (50, 'a'), (50, 'b')) as v(id, name) on t.id = v.id when not matched then insert (id, name) values (v.id, v.name)\nselect count(*) from tgt where id = 50\nmerge into tgt t using (select * from src where false) s on t.id = s.id when matched then delete when not matched then insert (id) values (s.id)\nmerge into tgt t using (values (900, 'z')) as v(id, name) on t.id = v.id when matched then delete\nmerge into tgt t using (values (900, 'z')) as v(id, name) on t.id = v.id and false when not matched then insert (id, name) values (v.id, v.name)\nselect * from tgt where id = 900\ncreate table nk (k int, v text)\ninsert into nk values (1, 'one'), (null, 'n1')\nmerge into nk t using (values (1, 'x1'), (null, 'n2')) as s(k, v) on t.k = s.k when matched then update set v = s.v when not matched then insert (k, v) values (s.k, s.v)\nselect * from nk order by k nulls last, v\nmerge into nk t using (values (1, 'x2'), (null, 'n3')) as s(k, v) on t.k is not distinct from s.k when matched then update set v = s.v\nselect * from nk order by k nulls last, v\ncreate table kl (a int, b text)\ninsert into kl values (1, 'x'), (1, 'x'), (2, 'y')\nmerge into kl using (values (1), (3)) as v(a) on kl.a = v.a when matched then update set b = 'hit' when not matched then insert (a, b) values (v.a, 'new')\nselect * from kl order by a, b\nmerge into kl using (values (2)) as v(a) on kl.a = v.a when matched then delete\nselect * from kl order by a, b\ncreate table idt (id int generated always as identity primary key, v text)\nmerge into idt t using (values ('a'), ('b'), ('c')) as s(v) on false when not matched then insert (v) values (s.v)\nselect * from idt order by id\nmerge into idt t using (values (1, 'A'), (9, 'z')) as s(id, v) on t.id = s.id when matched then update set v = s.v\nmerge into idt t using (values (9, 'z')) as s(id, v) on t.id = s.id when not matched then insert (id, v) values (s.id, s.v)\nmerge into idt t using (values (9, 'z')) as s(id, v) on t.id = s.id when not matched then insert overriding system value values (s.id, s.v)\nmerge into idt t using (values (1, 'A')) as s(id, v) on t.id = s.id when matched then update set id = 5\ncreate sequence sq start 100\ncreate table sqt (id int default nextval('sq') primary key, ser serial, v text)\nmerge into sqt t using (values ('p'), ('q')) as s(v) on false when not matched then insert (v) values (s.v)\nselect * from sqt order by id\nmerge into sqt t using (values (1)) as s(n) on false when not matched then insert default values\nselect count(*) from sqt\nmerge into tgt t using (values (1, 5)) as s(id, n) on t.id = s.id when matched then update set qty = default, note = default\nselect * from tgt where id = 1\nmerge into tgt t using (values (1, 'multi', 77)) as s(id, n, q) on t.id = s.id when matched then update set (name, qty) = (s.n, s.q)\nselect * from tgt where id = 1\nmerge into tgt t using (values (1), (2), (900)) as s(id) on t.id = s.id when matched then update set note = 'kept' when not matched by source and t.id > 100 then delete when not matched by source then update set note = 'orphan' when not matched by target then insert (id, name) values (s.id + 1000, 'new')\nselect * from tgt order by id\nmerge into tgt t using (values (7)) as s(id) on t.id = s.id when not matched by target then insert (id, name) values (s.id, 'by target') when not matched by source then do nothing\nselect * from tgt where id = 7\nmerge into tgt t using (values (1, 'R1'), (60, 'R60')) as s(id, name) on t.id = s.id when matched then update set name = s.name when not matched then insert (id, name) values (s.id, s.name) returning merge_action(), t.id, t.name, s.name\nmerge into tgt t using (values (1), (61)) as s(id) on t.id = s.id when matched then delete when not matched then insert (id, name) values (s.id, 'ret') returning merge_action() as act, t.*\nmerge into tgt t using (values (2)) as s(id) on t.id = s.id when matched then delete when not matched by source and t.id = 1 then update set note = 'bysrc' returning merge_action(), id, s.id\nmerge into tgt t using (values (1, 'ok'), (1000, 'bad')) as s(id, name) on t.id = s.id when matched then update set name = s.name when not matched then insert (id, name, qty) values (s.id, s.name, null)\nselect name from tgt where id = 1\nmerge into tgt t using (values (1, 'ok')) as s(id, name) on t.id = s.id when matched then update set qty = null\nmerge into tgt t using (values (1, 'ok')) as s(id, name) on t.id = s.id when matched then update set id = 2\nmerge into tgt t using (values (1, 'ok')) as s(id, name) on t.id = s.id when matched then update set id = id + 5000\nselect id from tgt where id in (1, 5001) order by id\nbegin\nmerge into tgt t using (values (1)) as s(id) on t.id = s.id when matched then update set name = 'in tx'\nselect name from tgt where id = 1\nrollback\nselect name from tgt where id = 1\nbegin\nmerge into tgt t using (values (1)) as s(id) on t.id = s.id when matched then update set name = 'committed'\ncommit\nselect name from tgt where id = 1\nbegin\nmerge into tgt t using dup d on t.id = d.id when matched then update set name = 'x'\nselect 1\nrollback\nselect name from tgt where id = 3\ncreate table par (id int primary key)\ninsert into par values (1), (2)\ncreate table kid (id int primary key, p int references par, n int check (n > 0))\nmerge into kid k using (values (1, 1, 5), (2, 2, 6)) as s(id, p, n) on k.id = s.id when not matched then insert values (s.id, s.p, s.n)\nmerge into kid k using (values (3, 9, 5)) as s(id, p, n) on k.id = s.id when not matched then insert values (s.id, s.p, s.n)\nmerge into kid k using (values (3, 1, 0)) as s(id, p, n) on k.id = s.id when not matched then insert values (s.id, s.p, s.n)\nmerge into kid k using (values (1, 9)) as s(id, p) on k.id = s.id when matched then update set p = s.p\nmerge into par t using (values (1)) as s(id) on t.id = s.id when matched then delete\nmerge into par t using (values (3)) as s(id) on t.id = s.id when not matched then insert (id) values (s.id)\nselect * from par order by id\nwith w as (select 4 as id, 'cte' as name) merge into tgt t using w on t.id = w.id when matched then update set name = w.name when not matched then insert (id, name) values (w.id, w.name)\nselect * from tgt where id = 4\nmerge into tgt as t using src as s on t.id = s.id and s.qty > 100 when not matched and s.id = 2 then insert (id, name) values (s.id + 2000, 'cond')\nselect * from tgt where id = 2002\nmerge into tgt t using tgt s on t.id = s.id + 1 when matched then update set note = s.name\nselect id, note from tgt where id <= 4 order by id\nmerge into nope t using src s on t.id = s.id when matched then delete\nmerge into tgt t using nope s on t.id = s.id when matched then delete\nmerge into tgt t using src s on t.id = s.id when matched then update set nope = 1\nmerge into tgt t using src s on t.nope = s.id when matched then delete\nmerge into tgt t using src s on t.id = s.id when matched then insert (id) values (1)\nmerge into tgt t using src s on t.id = s.id when not matched then delete\nmerge into tgt t using src s on t.id = s.id\nmerge into tgt t using src s on t.id = s.id when matched then update set name = 'x' when\nmerge into tgt t using src s on t.id = s.id when not matched then insert (id, name) values (s.id)\nmerge into tgt t using src s on t.id = s.id when not matched then insert (id) values (s.id, s.name)\nmerge into tgt t using src s on t.id = s.id when matched then update set name = (select 1, 2)\nmerge into tgt t using src s on t.id = s.id when matched and exists (select 1 from par p where p.id = t.id) then update set note = (select max(name) from src) when not matched and s.id in (select id from src where qty > 100) then insert (id) values (s.id)\nselect id, note from tgt order by id limit 3\ndrop role if exists lx_mrg\ncreate role lx_mrg\ncreate table pv (id int primary key, v text)\ninsert into pv values (1, 'a'), (2, 'b')\ngrant select on pv to lx_mrg\ngrant select on src to lx_mrg\nset role lx_mrg\nmerge into pv using src on pv.id = src.id when matched then update set v = 'x'\nreset role\ngrant update on pv to lx_mrg\nset role lx_mrg\nmerge into pv using src on pv.id = src.id when matched then update set v = 'x'\nmerge into pv using src on pv.id = src.id when not matched then insert (id) values (src.id)\nmerge into pv using src on pv.id = src.id when matched then delete\nreset role\nrevoke select on src from lx_mrg\nset role lx_mrg\nmerge into pv using src on pv.id = src.id when matched then update set v = 'x'\nreset role"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(121), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
