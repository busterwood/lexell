// lexdb over TNS: the seventh bug slice (design/lexdb-robust.md, "The seventh bug slice"; KNOWN-ISSUES.md), checked against Oracle Database Free
// 23.26 (gen_oracle.py --check tns_bugs7): nested subprograms overloaded by their arguments' number, names and types (number, text, date, boolean;
// forward declarations, an inner scope's hiding the outer's), PLS-00307 for a call more than one fits, PLS-00306 for one none fits, PLS-00231 for a
// nested function called from SQL inside the unit (in USER_ERRORS, and ORA-06550 for a block); a SELECT * view keeps its columns as at CREATE
// when its table gains one (by name: Oracle expands * at CREATE); an assertion's DELETE or UPDATE of a table under NOT EXISTS checks the outer
// rows of the join key's values of the rows taken out only (NOVALIDATE over rows that already break it; VALIDATED; rows put earlier in the same
// transaction, a key changed). Each statement runs with set lexdb_batch = off (the row engine) and on: "same" and the answer, or DIFFERENT and
// both.
// expect: setup: 43 statements
// expect: same: A = 18
// expect: same: A = 28
// expect: same: OBJECT_NAME,STATUS = 'OV1'|'VALID';'OV2'|'VALID';'OV4'|'INVALID';'OV5'|'INVALID';'OV6'|'INVALID';'OV7'|'VALID';'OV8'|'VALID';'OV9'|'INVALID';'OVA'|'VALID';'OVB'|'VALID';'OVC'|'VALID';'OVD'|'VALID';'OVE'|'INVALID';'OVF'|'INVALID';'OVG'|'VALID'
// expect: same: NAME,LINE,POSITION,TEXT = 'OV4'|1|183|'PLS-00307: too many declarations of ''SQ'' match this call';'OV4'|1|176|'PL/SQL: Statement ignored';'OV5'|1|184|'PLS-00307: too many declarations of ''SQ'' match this call';'OV5'|1|177|'PL/SQL: Statement ignored';'OV6'|1|198|'PLS-00307: too many declarations of ''SQ'' match this call';'OV6'|1|191|'PL/SQL: Statement ignored';'OV9'|1|129|'PLS-00231: function ''SQ'' may not be used in SQL';'OV9'|1|129|'PL/SQL: ORA-03066: invalid PL/SQL expression';'OV9'|1|122|'PL/SQL: SQL Statement ignored';'OVE'|1|191|'PLS-00307: too many declarations of ''H'' match this call';'OVE'|1|169|'PL/SQL: Statement ignored';'OVF'|1|173|'PLS-00306: wrong number or types of arguments in call to ''H''';'OVF'|1|166|'PL/SQL: Statement ignored'
// expect: same: A = 22
// expect: same: A = 16
// expect: same: A = 401
// expect: same: A = 213
// expect: same: A = 2
// expect: same: A = 12
// expect: same: 0 / A = 18
// expect: same: error 6550
// expect: same: error 6550
// expect: same: A,B = 1|2
// expect: same: A,B,X = 1|2|11
// expect: same: A,B,K,M = 1|2|1|5
// expect: same: P,Q = 1|2
// expect: same: COLUMN_NAME = 'A';'B';'K';'M'
// expect: same: A,B = 1|2
// expect: same: N = 1
// expect: same: ASSERTION_NAME,VALIDATED = 'DPP_HAS'|'VALIDATED';'PROJ7_HAS_PERSON'|'NOT VALIDATED'
// expect: same: 1 / N = 2
// expect: same: error 8601
// expect: same: error 8601
// expect: same: N = 3
// expect: same: error 8601
// expect: same: 1 / ROLE = 'x'
// expect: same: 1 / N = 2
// expect: same: 1 / 1 / N = 1
// expect: same: error 8601
// expect: same: N = 3
// expect: same: error 8601
// expect: same: N = 3
// expect: same: 1 / 1 / 1 / N = 2
// expect: same: error 8601
// expect: same: 1 / N = 2
// expect: same: error 8601
// expect: same: error 8601
// expect: same: error 8601
// expect: same: N = 1
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table rs (a number)\ncreate or replace function ov1 (n number) return number is function sq(x number) return number is begin return x * x; end; function sq(x varchar2) return number is begin return length(x); end; begin return sq(n) + sq('ab'); end;\ncreate or replace function ov2 (n number) return number is function sq(x number) return number is begin return x * x; end; function sq(x number, y number) return number is begin return x * y; end; begin return sq(n) + sq(n, 3); end;\ncreate or replace function ov4 (n number) return number is function sq(x number) return number is begin return x * x; end; function sq(y number) return number is begin return y + 1; end; begin return sq(n); end;\ncreate or replace function ov5 (n number) return number is function sq(x number) return number is begin return x * x; end; function sq(x integer) return number is begin return x + 1; end; begin return sq(n); end;\ncreate or replace function ov6 (n number) return number is function sq(x number) return number is begin return x * x; end; function sq(x number, y number := 0) return number is begin return x * y; end; begin return sq(n); end;\ncreate or replace function ov7 (n number) return number is r number := 0; procedure pr(x number) is begin r := r + x; end; procedure pr(x number, y number) is begin r := r + x * y; end; begin pr(n); pr(n, 10); return r; end;\ncreate or replace function ov8 (n number) return number is function sq(x number) return number is begin return x * x; end; function sq(x date) return number is begin return 7; end; begin return sq(n) + sq(sysdate); end;\ncreate or replace function ov9 (n number) return number is r number; function sq(x number) return number is begin return x * x; end; begin select sq(3) into r from dual; return r; end;\ncreate or replace function ova (n number) return number is function f(x number) return number; function f(x varchar2) return number; function f(x varchar2) return number is begin return length(x) * 100; end; function f(x number) return number is begin return x + f('abc'); end; begin return f(n) + f(x => 'z'); end;\ncreate or replace function ovb (n number) return number is d date := date '2020-01-05'; function g(x number) return number is begin return 1; end; function g(x date) return number is begin return 2; end; function g(x varchar2) return number is begin return 3; end; begin return g(d) * 100 + g(n + 1) * 10 + g(to_char(n)); end;\ncreate or replace function ovc (n number) return number is function h(x number) return number is begin return 1; end; begin declare function h(x varchar2) return number is begin return 2; end; begin return h(n); end; end;\ncreate or replace function ovd (n number) return number is function h(a number, b varchar2) return number is begin return 1; end; function h(b number, a varchar2) return number is begin return 2; end; begin return h(a => 1, b => 'x') * 10 + h(b => 1, a => 'x'); end;\ncreate or replace function ove (n number) return number is function h(a boolean) return number is begin return 1; end; function h(a varchar2) return number is begin return 2; end; begin return h(true) * 10 + h(null); end;\ncreate or replace function ovf (n number) return number is function h(a varchar2) return number is begin return 2; end; function h(a date) return number is begin return 3; end; begin return h(true); end;\ncreate or replace function ovg (n number) return number is r number; function sq(x number) return number is begin return x * x; end; begin r := sq(2); update rs set a = a + r where a = (select max(a) from rs); return r; end;\ncreate table vt1 (a number, b number)\ninsert into vt1 values (1, 2)\ncreate view vv1 as select * from vt1\ncreate view vv2 as select vt1.*, a + 10 x from vt1\ncreate table vt2 (k number, m number)\ninsert into vt2 values (1, 5)\ncreate view vv3 as select vt1.*, vt2.* from vt1 join vt2 on vt2.k = vt1.a\ncreate view vv4 (p, q) as select * from vt1\nalter table vt1 add (c number)\nupdate vt1 set c = 3\ncreate table person7 (id number primary key, dept number not null, role varchar2(5))\ncreate table proj7 (id number primary key, dept number not null)\ninsert into person7 values (1, 1, 'boss')\ninsert into person7 values (3, 1, 'dev')\ninsert into person7 values (4, 5, 'dev')\ninsert into proj7 values (1, 1)\ninsert into proj7 values (2, 2)\ninsert into proj7 values (6, 5)\ncreate assertion proj7_has_person check (not exists (select 1 from proj7 p where not exists (select 1 from person7 e where e.dept = p.dept))) novalidate\ncreate table dpe (id number primary key, d number not null)\ncreate table dpp (id number primary key, d number not null)\ninsert into dpe values (1, 1)\ninsert into dpe values (2, 1)\ninsert into dpe values (3, 2)\ninsert into dpp values (1, 1)\ninsert into dpp values (2, 2)\ncreate assertion dpp_has check (not exists (select 1 from dpp p where not exists (select 1 from dpe e where e.d = p.d)))"

const QS = "select ov1(4) a from dual\nselect ov2(4) a from dual\nselect object_name, status from user_objects where object_name like 'OV%' order by 1\nselect name, line, position, text from user_errors where name like 'OV%' order by name, sequence\nselect ov7(2) a from dual\nselect ov8(3) a from dual\nselect ova(1) a from dual\nselect ovb(1) a from dual\nselect ovc(1) a from dual\nselect ovd(1) a from dual\ndeclare r number; function sq(x number) return number is begin return x * x; end; function sq(x varchar2) return number is begin return length(x); end; begin r := sq(4) + sq('ab'); insert into rs values (r); end; ;; select a from rs\ndeclare r number; function sq(x number) return number is begin return x * x; end; begin select sq(3) into r from dual; end;\ndeclare r number; function sq(x number) return number is begin return x * x; end; function sq(y number) return number is begin return y; end; begin r := sq(3); end;\nselect * from vv1\nselect * from vv2\nselect * from vv3\nselect * from vv4\nselect column_name from user_tab_columns where table_name = 'VV3' order by column_id\nselect a, b from vv1 where b = 2\nselect count(*) n from vv3 v join vt1 t on t.a = v.a\nselect assertion_name, validated from user_assertions where assertion_name in ('PROJ7_HAS_PERSON', 'DPP_HAS') order by 1\ndelete from person7 where id = 1 ;; select count(*) n from person7\ndelete from person7 where id in (1, 3)\nbegin delete from person7 where id = 1; delete from person7 where id = 3; end;\nselect count(*) n from person7\nupdate person7 set dept = 7 where id = 4\nupdate person7 set role = 'x' where id = 4 ;; select role from person7 where id = 4\nupdate person7 set dept = 5 where id = 3 ;; select count(*) n from person7 where dept = 5\nupdate person7 set dept = 5 where id = 3 ;; update person7 set dept = 1 where id = 4 ;; select count(*) n from person7 where dept = 5\nbegin insert into person7 values (9, 8, 'a'); insert into proj7 values (7, 8); delete from person7 where id = 9; end;\nselect count(*) n from proj7\nbegin insert into person7 values (9, 8, 'a'); insert into proj7 values (7, 8); update person7 set id = 10 where id = 9; delete from person7 where id = 10; end;\nselect count(*) n from person7\ninsert into person7 values (9, 1, 'a') ;; delete from person7 where id = 9 ;; delete from person7 where id = 1 ;; select count(*) n from person7\ndelete from person7 where dept = 1\ndelete from dpe where id = 1 ;; select count(*) n from dpe\ndelete from dpe where id = 3\ndelete from dpe where d = 1\nbegin update dpe set d = 2 where id = 1; update dpe set d = 2 where id = 2; end;\nselect count(*) n from dpe where d = 2"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(160), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
