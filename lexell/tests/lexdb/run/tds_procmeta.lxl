import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "create schema s1\ncreate procedure dbo.p1 @a int, @b varchar(20) = 'x', @c int output as select @a\ncreate procedure s1.p2 as select 1\ncreate function dbo.f1(@x int, @y decimal(10,2)) returns int as begin return @x end\ncreate function dbo.tv1(@x int) returns table as return select @x as a, 'z' as b\ncreate procedure dbo.p3 @d datetime2(3), @e nvarchar(max), @f bit, @g bigint = 5, @h float, @i decimal(19, 4), @j uniqueidentifier, @k varbinary(10), @l date, @m char(3), @n decimal(12, 4), @o nchar(4), @p smallint, @q tinyint, @r real, @s datetimeoffset(2), @t time(4), @u datetime, @v smalldatetime, @w varchar(max), @x binary(4), @y decimal(10, 4), @z xml as select 1\ncreate procedure dbo.p4 @a int, @b varchar(20), @c decimal(10, 2), @d bigint, @e bit, @f nvarchar(30) as select 1\n@sets exec sp_stored_procedures @sp_owner = 'dbo'\n@sets exec sp_stored_procedures @sp_name = 'p%', @sp_owner = 'dbo'\n@sets exec sp_stored_procedures @sp_owner = 's1'\n@sets exec sp_stored_procedures @sp_name = 'nothing'\n@sets exec sp_stored_procedures @sp_name = 'P1', @sp_owner = 'DBO'\n@sets exec sp_stored_procedures 'p1'\n@sets exec sp_stored_procedures 'p%', 'dbo'\n@sets exec sp_stored_procedures @sp_name = 'tv_'\n@sets exec sp_sproc_columns @procedure_owner = 'dbo', @procedure_name = 'f%'\n@sets exec sp_sproc_columns @procedure_name = 'p1'\n@sets exec sp_sproc_columns @procedure_name = 'p%', @procedure_owner = 's1'\n@sets exec sp_sproc_columns_100 @procedure_name = 'f1'\n@sets exec sp_sproc_columns @procedure_name = 'p1', @column_name = '@a'\n@sets exec sp_sproc_columns @procedure_name = 'p1', @column_name = '@%'\n@sets exec sp_sproc_columns @procedure_name = 'tv1'\n@sets exec sp_sproc_columns 'p1', 'dbo'\n@sets exec sp_sproc_columns_100 @procedure_name = 'p3'\n@sets exec sp_sproc_columns_100 @procedure_name = 'p3', @ODBCVer = 3\n@sets exec sp_sproc_columns @procedure_name = 'p4'\n@sets exec sp_sproc_columns @procedure_name = 'p4', @ODBCVer = 3\n@sets exec sp_sproc_columns_100 @procedure_name = 'p3', @column_name = '@d', @ODBCVer = 3\n@sets exec sp_sproc_columns @procedure_name = 'nothing'\ndrop procedure p1\n@sets exec sp_stored_procedures @sp_owner = 'dbo'\n@sets exec sp_sproc_columns @procedure_name = 'p1'\ncreate or alter procedure dbo.p1 @z int as select @z\n@sets exec sp_sproc_columns @procedure_name = 'p1'"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error. only: the result sets alone (a catalog procedure's own
// internal counts are the server's business).
fn show(c: mut &sqlserver.Conn, q: &str, only: bool): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else if !only {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// the connection string of another login (the oracle's logins are made by the batches, with this password; lexdb takes any)
fn asUser(dsn: &str, u: &str): str {
    var parts: []str = []
    for p in strings.split(dsn, ";") {
        let l = strings.toLowerAscii(&p)
        if len(p) == 0 || strings.startsWith(&l, "uid=") || strings.startsWith(&l, "pwd=") { continue }
        append(mut &parts, p.toStr())
    }
    append(mut &parts, "UID=" + u)
    append(mut &parts, "PWD=Lx_Pw0rd_7x")
    return strings.join(&parts, ";")
}

// A line may start with markers: "@sets " (result sets only), "@as NAME " (run as that login, a connection of its own), "@oracle "
// (only on the SQL Server oracle: "ok" on lexdb), "@lexdb " (only on lexdb).
fn batches(dsn: &str, oracle: bool) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            var names: []str = []
            var conns: []sqlserver.Conn = []
            let text: str = QUERIES
            for line in strings.lines(&text) {
                var q = line.toStr()
                var only = false
                var who = ""
                var skip = false
                while strings.startsWith(&q, "@") {
                    if strings.startsWith(&q, "@sets ") {
                        only = true
                        q = q[6..len(q)].toStr()
                    } else if strings.startsWith(&q, "@oracle ") {
                        if !oracle { skip = true }
                        q = q[8..len(q)].toStr()
                    } else if strings.startsWith(&q, "@lexdb ") {
                        if oracle { skip = true }
                        q = q[7..len(q)].toStr()
                    } else if strings.startsWith(&q, "@as ") {
                        let rest = q[4..len(q)].toStr()
                        let sp = strings.indexOf(&rest, " ", 0)
                        who = rest[0..sp].toStr()
                        q = rest[sp + 1..len(rest)].toStr()
                    } else { break }
                }
                if skip {
                    println("ok")
                    continue
                }
                if len(who) == 0 {
                    println(show(mut &c, &q, only))
                    continue
                }
                var at = -1
                for i in 0..len(names) { if names[i] == who { at = i } }
                if at < 0 {
                    match sqlserver.connect(&asUser(dsn, &who)) {
                        Ok(cx) {
                            append(mut &names, who.clone())
                            append(mut &conns, cx)
                            at = len(names) - 1
                        }
                        Err(e) {
                            println("connect " + who + ": error " + e.code.toStr())
                            continue
                        }
                    }
                }
                println(show(mut &conns[at], &q, only))
            }
            while len(conns) > 0 {
                var cx = pop(mut &conns)
                cx.close()
            }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"), false)
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn, true) }
        None {
            lexdb_store.run(lexdb_disk.sim(43), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
