// lexdb_exec: the fifth bug slice in the PostgreSQL door (design/lexdb-robust.md, "The fifth bug slice"): ALTER TABLE ... DROP COLUMN of a table
// views read, refused only when a view uses the column (2BP01: by name, through SELECT *, in WHERE, through a view over such a view; the SQL Server
// and Oracle doors drop it, tds_bugs5 and tns_bugs5), and CASCADE dropping those views and no others. Checked against PostgreSQL 18 (generated by
// tests/lexdb/gen_pg.py from bugs5_queries.txt). Each answer: the columns' names and the rows, or the tag, or ERROR and the SQLSTATE; each
// statement runs with lexdb_batch off and on (an "@once" one once, an "@tx" one in a transaction rolled back).
// expect: CREATE TABLE
// expect: INSERT 0 2
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: same: ERROR 2BP01
// expect: same: ERROR 2BP01
// expect: same: ERROR 2BP01
// expect: same: v: d1a,d1cnt
// expect: same: a|b: 1|2;4|
// expect: same: a: 1
// expect: same: a: 1;4
// expect: same: n: 2
// expect: ALTER TABLE
// expect: CREATE VIEW
// expect: same: ERROR 2BP01
// expect: same: v: d1a,d1b,d1cnt,d1s,d1vb,d1w
// expect: same: v: d1a,d1b,d1cnt,d1d,d1s,d1vb,d1w
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table d1 (a int, b int, c int)\n@once insert into d1 values (1, 2, 3), (4, null, 6)\n@once create view d1a as select a from d1\n@once create view d1b as select a, b from d1\n@once create view d1s as select * from d1\n@once create view d1w as select a from d1 where b > 0\n@once create view d1vb as select a from d1b\n@once create view d1cnt as select count(*) as n from d1\nalter table d1 drop column b\nalter table d1 drop column c\nalter table d1 drop column a\n@tx alter table d1 drop column b cascade; select string_agg(table_name, ',' order by table_name) as v from information_schema.views where table_schema = 'public' and table_name like 'd1%'\n@tx drop view d1s; alter table d1 drop column c; select * from d1 order by a\n@tx drop view d1s; alter table d1 drop column c; select * from d1w order by a\n@tx alter table d1 drop column b cascade; select * from d1a order by a\n@tx alter table d1 drop column b cascade; select n from d1cnt\n@once alter table d1 add column d int\n@once create view d1d as select a, d from d1\nalter table d1 drop column d\n@tx alter table d1 drop column d cascade; select string_agg(table_name, ',' order by table_name) as v from information_schema.views where table_schema = 'public' and table_name like 'd1%'\nselect string_agg(table_name, ',' order by table_name) as v from information_schema.views where table_schema = 'public' and table_name like 'd1%'"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(175), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
