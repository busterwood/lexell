import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table d1 (a number, b number, c number)\ninsert into d1 values (1, 2, 3)\ninsert into d1 values (4, null, 6)\ncreate view d1a as select a from d1\ncreate view d1cnt as select count(*) n from d1\ncreate table dg (id number primary key, name varchar2(20), age number)\ninsert into dg values (1, 'a', 30)\ncreate property graph dgg vertex tables (dg key (id) properties (id, name, age))\ncreate view dgv as select * from graph_table (dgg match (a is dg) columns (a.name as an))\ncreate or replace function okf (n number) return number is begin return n + 1; end;\ncreate table t4 (id number)\ninsert into t4 values (1)\ninsert into t4 values (null)\ncreate table t7 (id number, v number)\ninsert into t7 values (1, 2)\ncreate table t8 (id number generated always as identity, v number)\ninsert into t8 (v) values (1)\ncreate table t8d (id number generated by default as identity, v number)\ninsert into t8d (v) values (1)"

const QS = "alter table d1 add (x number) ;; create or replace view d1x as select a, x from d1 ;; create or replace view d1vx as select a from d1x ;; create or replace view d1s as select * from d1 ;; alter table d1 drop column x ;; select object_name, status from user_objects where object_name in ('D1A', 'D1CNT', 'D1X', 'D1VX', 'D1S') order by 1 ;; select a from d1a order by a ;; select n from d1cnt ;; select count(*) n from d1x ;; select n from d1cnt\nselect count(*) n from d1vx\nselect count(*) n from d1s\nselect name, type, line, position, rtrim(text, chr(10)) text, instr(text, chr(10)) nl from user_errors where name in ('D1X', 'D1VX', 'D1S') order by name, sequence\nalter table d1 add (x number) ;; select count(*) n from d1x ;; select a from d1vx order by a ;; alter table d1 drop column x\nalter table dg add (z number) ;; alter table dg drop column z ;; select an from dgv\nalter table dg add (age2 number) ;; create or replace property graph dgg2 vertex tables (dg key (id) properties (id, name, age2)) ;; create or replace view dgv2 as select * from graph_table (dgg2 match (a is dg) columns (a.age2 as g)) ;; alter table dg drop column age2 ;; select object_name, object_type, status from user_objects where object_name in ('DGG2', 'DGV2') order by 1 ;; select count(*) n from dgv2 ;; select an from dgv\nselect name, type, line, position, rtrim(text, chr(10)) text, instr(text, chr(10)) nl from user_errors where name = 'DGV2' order by sequence\nselect okf(1) from dual\nselect 5+okf(3) from dual\nselect okf(1)+okf(2), okf( -1 ), okf('1'), okf(null), okf(1.5) from dual\nselect okf(id) from t4 order by id\nselect okf(1) x, app.okf(2) from dual\nselect okf(okf(1)) from dual\nselect id, okf(1) from t4 where okf(2) = 3 order by id\ncreate or replace function f7 (n number) return number is begin return n * 2; end; ;; create or replace view v7 as select id, f7(v) w from t7 ;; select id, w from v7 ;; drop function f7 ;; select count(*) n from v7 ;; select 1 x from dual\nselect name, type, line, position, rtrim(text, chr(10)) text from user_errors where name = 'V7'\nselect object_name, status from user_objects where object_name = 'V7'\ncreate or replace procedure p7a is begin insert into t7 values (1, ); end;\ncreate or replace procedure p7b is n number; begin select count(*) into n from t7 where; end;\ncreate or replace procedure p7c is begin update t7 set v = where id = 1; end;\ncreate or replace procedure p7d is begin delete from t7 where id = = 1; end;\ncreate or replace procedure p7f is begin update t7 set v = (v + 1 where id = 1; end;\ncreate or replace procedure p7ok is begin update t7 set v = v where id = 1; end;\nselect object_name, status from user_objects where object_name like 'P7%' order by 1\nselect name, line, position, text from user_errors where name like 'P7%' order by name, sequence\nupdate t8 set id = 5\nupdate t8 set id = id\nupdate t8 set id = default\nupdate t8 set v = 2, id = 7 where v = 1\ninsert into t8 (id, v) values (3, 3)\nmerge into t8 a using (select 1 k from dual) s on (a.v = s.k) when matched then update set a.id = 9\nupdate t8d set id = 5 ;; select id, v from t8d\nselect id, v from t8"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(160), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
