// expect: same: NAME,LINE,POSITION,TEXT = 'P7A'|1|50|'PL/SQL: ORA-00936: missing expression';'P7A'|1|24|'PL/SQL: SQL Statement ignored';'P7B'|1|70|'PL/SQL: ORA-00936: missing expression';'P7B'|1|34|'PL/SQL: SQL Statement ignored';'P7C'|1|42|'PL/SQL: ORA-00936: missing expression';'P7C'|1|24|'PL/SQL: SQL Statement ignored';'P7D'|1|50|'PL/SQL: ORA-00936: missing expression';'P7D'|1|24|'PL/SQL: SQL Statement ignored';'P7F'|1|49|'PL/SQL: ORA-00907: missing right parenthesis';'P7F'|1|24|'PL/SQL: SQL Statement ignored'
