// lexdb over TNS: the OR of index paths (design/lexdb-optimizer.md 52), checked against Oracle Database Free
// (generated by tests/lexdb/gen_oracle.py from oracle_orpath_queries.txt): ORs of unique keys' points (read by
// them without statistics), of indexes' equalities, IN lists and ranges (scanned: no statistics), overlapping arms, NULLs,
// an empty arm, a text key, FETCH FIRST, GROUP BY, joins, an OR in a LEFT JOIN's ON, a correlated EXISTS, a
// division by zero (ORA-01476), an UPDATE under an OR. Each answer is a label, then the row count, or the
// columns' names and rows, or error and the ORA- number.
// expect: table: 0
// expect: rows: 10000
// expect: unique: 0
// expect: index a: 0
// expect: index bc: 0
// expect: index w: 0
// expect: table p: 0
// expect: rows p: 1000
// expect: unique arms: ID,U,A = 3|9|3;5|15|5;7|21|7;12|36|12;10000|30000|0
// expect: unique arms 2: N,S = 1|372
// expect: two indexes: N,S,LO,HI = 35|170515|5|9605
// expect: rows: ID,A,B = 5|5|65;405|5|265;539|139|7;805|5|465;1205|5|665;1539|339|7;1605|5|865;2005|5|65;2405|5|265;2539|139|7;2805|5|465;3205|5|665;3539|339|7;3605|5|865;4005|5|65;4405|5|265;4539|139|7;4805|5|465;5205|5|665;5539|339|7;5605|5|865;6005|5|65;6405|5|265;6539|139|7;6805|5|465;7205|5|665;7539|339|7;7605|5|865;8005|5|65;8405|5|265;8539|139|7;8805|5|465;9205|5|665;9539|339|7;9605|5|865
// expect: in lists: N,S = 92|437874
// expect: overlapping: N,S = 75|360375
// expect: primary key: N,S = 74|132051
// expect: composite: ID,B,C = 77|1|'c7';477|201|'c7';877|401|'c7';1277|601|'c7';1677|801|'c7';2077|1|'c7';2477|201|'c7';2877|401|'c7';3277|601|'c7';3677|801|'c7';4077|1|'c7';4477|201|'c7';4877|401|'c7';5277|601|'c7';5677|801|'c7';6077|1|'c7';6477|201|'c7';6877|401|'c7';7277|601|'c7';7677|801|'c7';8077|1|'c7';8477|201|'c7';8877|401|'c7';9277|601|'c7';9677|801|'c7'
// expect: null arm: N = 10
// expect: is null: N,S = 112|564611
// expect: empty arm: N = 10
// expect: text: ID,W = 3|'w3';17|'w17';23|'w23';317|'w17';323|'w23';403|'w103';617|'w17';623|'w23';803|'w203';917|'w17';923|'w23';1203|'w3'
// expect: fetch first: ID = 5;405;539;805;1205
// expect: group by: A,N = 5|25;6|25;139|5;339|5
// expect: join: N,S,M = 35|15958|'t0'
// expect: left join on: N,M = 300|1
// expect: left join where: N,S = 35|170515
// expect: exists: N = 50
// expect: two ors: N,S = 10|50390
// expect: division: error 1476
// expect: update: 35
// expect: updated: N,S = 125|619180
// expect: drop: 0
// expect: drop p: 0
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn q(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + qtext(c, sql)) }
fn x(c: mut &oracle.Conn, label: &str, sql: &str) { println(label + ": " + xtext(c, sql)) }

// Statements and queries ("a ;; b ;; c") in one transaction, rolled back (t) or committed (u): each answer, joined by " / ".
fn tx(c: mut &oracle.Conn, label: &str, sqls: &str, commit: bool) {
    var out: []str = []
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for part in strings.split(sqls, " ;; ") {
            if strings.startsWith(&strings.toLowerAscii(part), "select") { append(mut &out, qtext(c2, part)) } else { append(mut &out, xtext(c2, part)) }
        }
        if !commit { return Err(sqldialect.inputError("rolled back")) }
        return Ok(0)
    })
    println(label + ": " + strings.join(&out, " / "))
}
fn t(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, false) }
fn u(c: mut &oracle.Conn, label: &str, sqls: &str) { tx(c, label, sqls, true) }

fn connect(s: &str): oracle.Conn {
    match oracle.connect(&(s.toStr())) {
        Ok(c) { return c }
        Err(e) {
            println("connect: error " + e.code.toStr() + " " + e.msg)
            exit(1)
        }
    }
}

fn client(port: &str) {
    var c = connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb"))
    x(mut &c, "table", "create table o_t (id number(9) primary key, u number(9) not null, a number(9), b number(9), c varchar2(10), v number(9), w varchar2(20))")
    x(mut &c, "rows", "insert into o_t select level, level * 3, case when mod(level, 97) = 0 then null else mod(level, 400) end, mod(level * 13, 1000), 'c' || mod(level, 10), mod(level * 31, 1009), 'w' || mod(level, 300) from dual connect by level <= 10000")
    x(mut &c, "unique", "create unique index o_t_u on o_t (u)")
    x(mut &c, "index a", "create index o_t_a on o_t (a)")
    x(mut &c, "index bc", "create index o_t_bc on o_t (b, c)")
    x(mut &c, "index w", "create index o_t_w on o_t (w)")
    x(mut &c, "table p", "create table o_p (id number(9) primary key, g number(9), tag varchar2(10))")
    x(mut &c, "rows p", "insert into o_p select level - 1, mod(level - 1, 1000), 't' || mod(level - 1, 7) from dual connect by level <= 1000")
    q(mut &c, "unique arms", "select id, u, a from o_t where id in (3, 5, 7) or u = 36 or u = 30000 order by id")
    q(mut &c, "unique arms 2", "select count(*) as n, sum(v) as s from o_t where id = 12 or u = 36 or id = -1")
    q(mut &c, "two indexes", "select count(*) as n, sum(id) as s, min(id) as lo, max(id) as hi from o_t where a = 5 or b = 7")
    q(mut &c, "rows", "select id, a, b from o_t where a = 5 or b = 7 order by id")
    q(mut &c, "in lists", "select count(*) as n, sum(id) as s from o_t where a in (1, 2, 3) or b in (4, 5)")
    q(mut &c, "overlapping", "select count(*) as n, sum(id) as s from o_t where a = 5 or (a = 5 and b < 500) or a between 4 and 6")
    q(mut &c, "primary key", "select count(*) as n, sum(id) as s from o_t where id < 40 or a = 9 or id between 1000 and 1010")
    q(mut &c, "composite", "select id, b, c from o_t where (b = 3 and c > 'c5') or (b = 4 and c = 'c1') or a = 77 order by id")
    q(mut &c, "null arm", "select count(*) as n from o_t where a = null or b = 3")
    q(mut &c, "is null", "select count(*) as n, sum(id) as s from o_t where a is null or b = 3")
    q(mut &c, "empty arm", "select count(*) as n from o_t where a = -5 or b = 9")
    q(mut &c, "text", "select id, w from o_t where w = 'w17' or w = 'w23' or a = 3 order by id fetch first 12 rows only")
    q(mut &c, "fetch first", "select id from o_t where a = 5 or b = 7 order by id fetch first 5 rows only")
    q(mut &c, "group by", "select a, count(*) as n from o_t where a in (5, 6) or b = 7 group by a order by a")
    q(mut &c, "join", "select count(*) as n, sum(o_t.v) as s, min(o_p.tag) as m from o_t join o_p on o_p.id = o_t.b where o_t.a = 5 or o_t.b = 7")
    q(mut &c, "left join on", "select count(*) as n, count(o_t.id) as m from o_p left join o_t on o_t.id = o_p.g and (o_t.a = 5 or o_t.b = 7) where o_p.id < 300")
    q(mut &c, "left join where", "select count(*) as n, sum(o_t.id) as s from o_t left join o_p on o_p.id = o_t.b where o_t.a = 5 or o_t.b = 7")
    q(mut &c, "exists", "select count(*) as n from o_p where exists (select 1 from o_t where o_t.a = o_p.g or o_t.b = o_p.g) and o_p.id < 50")
    q(mut &c, "two ors", "select count(*) as n, sum(id) as s from o_t where (a = 5 or b = 7) and (a = 6 or b = 7 or b = 8)")
    q(mut &c, "division", "select id from o_t where (a = 9 or b = 7 or id = 1009) and 10 / v > 0")
    x(mut &c, "update", "update o_t set v = v + 1000 where a = 5 or b = 7")
    q(mut &c, "updated", "select count(*) as n, sum(id) as s from o_t where v >= 1000")
    x(mut &c, "drop", "drop table o_t purge")
    x(mut &c, "drop p", "drop table o_p purge")
    c.logoff()
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 128 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
