const QUERIES = "@once create table acc (id int primary key, salary numeric(10,2), pct int)\n@once insert into acc values (1, 100, 10), (2, 250.50, 5), (3, 80, 0)\n@once create function raise_to(p numeric) returns numeric language sql as $$ select 1 + p / 100 $$\n@once create function raise_to2(p numeric, q numeric) returns numeric language sql as $$ select 2 * (p / q) + 1 $$\n@once create procedure raise_pct(p numeric) language sql as $$ update acc set salary = salary * (1 + p / 100) where id = 1 $$\n@once create procedure raise_row(i int, p numeric) language sql as $$ update acc set salary = salary * (1 + p / 3) where id = i $$\n@once create procedure add_row(i int, p numeric) language sql as $$ insert into acc values (i, 10 * (1 + p / 4), 0) $$\nselect raise_to(10) as a, raise_to(2.5) as b, raise_to(0) as c, raise_to(null) as d\nselect raise_to2(10, 4) as a, raise_to2(1, 3) as b\n@once call raise_pct(10)\nselect id, salary from acc order by id\n@once call raise_row(2, 10)\nselect id, salary from acc order by id\n@once call add_row(4, 10)\nselect id, salary from acc where id = 4\nselect id, 1 + pct / 100.0 as f, salary * (1 + pct::numeric / 100) as s from acc order by id\nselect 1 + 10::numeric / 100 as a, 1 + 10 / 100 as b, 2 * (7::numeric / 2) as c\nselect 2147483647::int + 1\nselect 32767::smallint + 1::smallint\nselect 2147483647::int * 2\nselect (-2147483648)::int - 1\nselect 2147483647::int - -1\nselect 32767::smallint * 2::smallint\nselect 2147483647::int + 1 > 0\nselect 2147483647::int + 1::bigint as a, 2147483647::int::bigint + 1 as b\nselect 2147483646::int + 1 as ok\nselect -32768::smallint - 1::smallint\nselect case when false then 1 else 2147483647::int + 1 end\nselect coalesce(2147483647::int * 2, 0)\n@once create table ov (a int, b smallint, c bigint)\n@once insert into ov values (2147483647, 32767, 9223372036854775807)\nselect a + 1 from ov\nselect 2147483647::int + 1 from ov\nselect b + 1::smallint from ov\nselect b * 2 from ov\nselect c + 1 from ov\ninsert into ov values (2147483647::int + 1, 1, 1)\nselect 2147483647::int + a from ov\n@once create type mood as enum ('sad', 'ok', 'happy')\n@once create table moods (id int primary key, m mood)\n@once insert into moods values (1, 'sad'), (2, 'ok'), (3, 'happy'), (4, null)\nselect id, m < 'happy' as lt, m > 'ok' as gt, m <= 'ok' as le, m >= 'ok' as ge, m = 'ok' as eq, m <> 'ok' as ne from moods order by id\nselect 'ok'::mood < 'happy'::mood as a, 'happy'::mood < 'ok'::mood as b, 'ok'::mood > 'sad'::mood as c\nselect min(m) as lo, max(m) as hi from moods\nselect max(m) as hi from moods where id < 3\nselect min(m) as lo from moods where id > 3\nselect greatest('sad'::mood, 'happy'::mood, 'ok'::mood) as g, least('happy'::mood, 'ok'::mood) as l\nselect greatest(m, 'ok') as g, least(m, 'ok') as l from moods order by id\nselect m, count(*) from moods group by m order by m\nselect m, m < 'ok' as low from moods order by m\nselect id, case when m < 'happy' then 'low' else 'high' end as c from moods order by id\nselect m from moods where m between 'ok' and 'happy' order by id\nselect id, m from moods order by m desc\nselect m, row_number() over (order by m) as rn from moods order by id\nselect m, rank() over (order by m desc) as r from moods order by id\nselect distinct m from moods order by m\nselect count(*) from moods where m < 'ok'\nselect 'angry'::mood\nselect cast('angry' as mood)\nselect 'angry'::mood from moods\nselect m = 'angry' from moods\nselect id from moods where m = 'angry'\nselect id from moods where m > 'angry'\nselect max(m) < 'happy' as a from moods\nselect coalesce(m, 'sad'::mood) < 'ok' from moods order by id\n@once alter type mood add value 'ecstatic' after 'happy'\nselect 'ecstatic'::mood > 'happy'::mood as a\nselect max(m) from moods\n@once insert into moods values (5, 'ecstatic')\nselect max(m) as hi from moods\nselect id from moods where m >= 'happy' order by id\ninsert into moods values (6, 'angry')\nselect case when false then 1 else false end\nselect case when true then 1 when false then true end\nselect case when true then 'a' else 2 end\nselect case when true then 1 else 'a' end\nselect 1 union select true\nselect 1 union all select true\nselect 1 intersect select true\nselect 1 except select true\nselect true union select 1\nselect 1 union select date '2020-01-01'\nselect coalesce(1, true)\nselect coalesce(true, 1)\nselect coalesce(null, 1, true)\nselect coalesce(1, 'a')\nselect greatest(1, true)\nselect least(true, 1)\nvalues (1), (true)\nvalues (true), (1)\nvalues (1, 'a'), (2, 3)\nselect * from (values (1), (true)) s\nselect 1 = 'a'\nselect 'a' = 1\nselect 1 < 'a'\nselect 1 + 'a'\nselect 'a' + 1\nselect 1 - 'x'\nselect 2 * 'y'\nselect 1 = '1'\nselect 1 + '2'\nselect 1.5 = 'a'\nselect true = 'a'\nselect nullif(1, 'a')\nselect 1 in (1, 'a')\nselect 'a' in (1, 2)\nselect * from (values (1)) t(x) where x = 'a'\nselect 1 where 1 = 'a'\n@once create table mt (i int, t text, b boolean)\n@once insert into mt values (1, 'a', true), (2, '2', false)\nselect * from mt where i = 'a'\nselect * from mt where i = '2'\nselect i + 'x' from mt\nselect coalesce(i, t) from mt\nselect case when b then i else t end from mt\nselect i from mt union select t from mt\nselect i from mt union select b from mt\nselect t from mt union select i::text from mt order by 1\nselect i from mt union select 3 order by 1\nselect coalesce(t, 'z'), coalesce(i, 0), coalesce(1, 2.5), coalesce(1.5, 2) from mt order by i\nselect 1 union select 2.5 order by 1\nselect 1 union select null order by 1\nselect 'a' union select 'b' order by 1\nselect (select 1 union select true)\nselect interval '1' day as a, interval '2' hour as b, interval '3' minute as c, interval '4' second as d, interval '5' month as e, interval '6' year as f\nselect interval '90' minute as a, interval '-1' day as b, interval '1.5' day as c, interval '1.5' second as d\nselect interval '1-2' year to month as a, interval '-1-2' year to month as b, interval '14' month as c, interval '1' year to month as d\nselect interval '1 2:03:04' day to second as a, interval '2:03' hour to minute as b, interval '2:03:04' hour to second as c, interval '03:04' minute to second as d\nselect interval '1 2' day to hour as a, interval '1 2:3' day to minute as b, interval '4 5:6:7.8' day to second(2) as c\nselect interval '1.234567' second(3) as a, interval '1' second(3) as b\nselect interval '1' day + interval '2' hour as a, interval '1' day * 2 as b, interval '1' day < interval '25' hour as c\nselect date '2020-01-31' + interval '1' month as a, date '2020-01-01' + interval '1' year as b, timestamp '2020-01-01 10:00' + interval '90' minute as c\nselect extract(day from interval '3' day) as d, extract(hour from interval '3' hour) as h\nselect interval '1 year 3 months' year as a, interval '1 year 3 months' month as b, interval '1 day 5 hours' day as c, interval '1 day 5 hours' hour as d\nselect interval '1 day 5:06:07.123456' day to second(2) as a, interval '1 day 5:06:07' day to hour as b, interval '1 day 5:06:07' day to minute as c\nselect '1 day 5:06:07'::interval day to hour as a, '3'::interval hour as b, cast('1 2:03:04' as interval day to second) as c\nselect cast(interval '2 days 3 hours' as interval day) as a, cast(interval '1 year 2 months 3 days' as interval year to month) as b\nselect interval '1 2' year to month\nselect interval '1-14' year to month\nselect interval '5' second to minute\nselect interval 'x' day\n@once create table ivr (a interval year, b interval month, c interval day, d interval hour, e interval minute, f interval second, g interval year to month, h interval day to hour, i interval day to minute, j interval day to second, k interval hour to minute, l interval hour to second, m interval minute to second, n interval day to second(2), o interval second(1), p interval)\n@once insert into ivr values ('1 year 3 months', '1 year 3 months', '1 day 5 hours', '1 day 5 hours', '1 day 5 hours 6 minutes', '1 day 5 hours 6 minutes 7.891 seconds', '1 year 3 months 4 days', '1 day 5:06:07', '1 day 5:06:07', '1 day 5:06:07.891', '1 day 5:06:07', '1 day 5:06:07.891', '1 day 5:06:07.891', '1 day 5:06:07.891', '1.26', '1 day 5:06:07.891')\nselect * from ivr\nselect a::text, d::text from ivr\n@once create table dayc (day int, id int)\n@once insert into dayc values (7, 1)\nselect interval '1' day as x, day from dayc\nselect day, interval '2' hour as hr from dayc\nselect interval '1' hour hr, interval '1' minute as min\n@once create sequence sq9\n@once create table tq9 (id int default nextval('sq9'), v int)\ndrop sequence sq9\n@once insert into tq9 (v) values (1)\nselect * from tq9\n@once drop sequence sq9 cascade\n@once create sequence sq10\n@once create table tq10 (id bigint default nextval('sq10'::regclass) primary key, v int)\ndrop sequence sq10\n@once alter table tq10 alter column id drop default\n@once drop sequence sq10\n@once create sequence sq11\n@once create table tq11 (a int default 1 + nextval('sq11'), b int default nextval('sq11'))\ndrop sequence sq11\n@once drop table tq11\n@once drop sequence sq11\ncreate table pk2 (a int primary key, b int primary key)\ncreate table pk2 (a int primary key, b int, primary key (b))\ncreate table pk2 (a int, primary key (a), primary key (a))\ncreate table pk2 (a int, b int, c int primary key, primary key (a, b))\ncreate table pk2 (a int primary key primary key)\n@once create table pk2 (a int primary key, b int unique, c int)\nwith recursive r(n) as (select 1 union all select n + 1 from r) select * from r limit 3\nwith recursive r(n) as (select 1 union all select n + 1 from r) select n * 2 as d from r limit 5 offset 2\nwith recursive r(n) as (select 1 union all select n + 1 from r) select * from r limit 0\nwith recursive r(n) as (select 1 union all select n + 1 from r) select * from r fetch first 4 rows only\nwith recursive r(n) as (select 1 union select n + 1 from r) select * from r limit 4\nwith recursive r(n) as (select 1 union all select n + 1 from r) select count(*) from (select * from r limit 5) s\nwith recursive r(n) as (select 1 union all select n + 1 from r where n < 5) select * from r limit 3\nwith recursive r(n) as (select 1 union all select n + 1 from r where n < 5) select * from r limit 30\nwith recursive r(n, s) as (select 1, 'a' union all select n + 1, s || 'b' from r) select * from r limit 3\nwith recursive r(n) as (select 1 union all select n + 1 from r) select r.n from r limit 3\nwith recursive r(n) as (select 1 union all select n + 1 from r) select * from r limit 999"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(160), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
