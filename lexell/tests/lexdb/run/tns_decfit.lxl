// expect: same: A,B,C = 50.09677419354838709677419354838709677|12050.0967741935483870967741935483871|-50.09677419354838709677419354838709677
// expect: same: ID,M = 1|50.09710685483870967741935483870967742;2|50.09743914277180406212664277180406213;3000|51.09444631123058542413381123058542413
// expect: same: A,B,C,D = 1|1|1|3
