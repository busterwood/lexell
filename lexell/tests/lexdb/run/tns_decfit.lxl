// expect: same: A,B,N = 10.316151202749140893470790378006872851|10.30927835051546391752577319587628866|3000
// expect: same: K,A,B = 0|0.66797746838133701774896375810394303266|30.927835051546391752577319587628865979;1|0.64735891168030608991391221171219045532|30.907216494845360824742268041237113402;2|0.65766819003082155383143798490806674402|30.917525773195876288659793814432989691
// expect: same: ID,A,B = 1|0.017182130584192439862542955326460481133|0.030927835051546391752577319587628866;2|0.027491408934707903780068728522336769732|0.0412371134020618556701030927835051546;3|0.017182130584192439862542955326460481133|0.030927835051546391752577319587628866;4|0.027491408934707903780068728522336769732|0.0412371134020618556701030927835051546
// expect: same: A,B = NULL|NULL
import "task"
import "net"
import "strings"
import "oracle"
import "sqldialect"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_tns"

const SETUP = "create table dg (i number(10))\ninsert into dg select level - 1 from dual connect by level <= 10\ncreate table dt (id number(10) primary key, d date, t timestamp, x number)\ninsert into dt select n, date '2024-03-05' + n / 97, timestamp '2024-03-05 00:00:00' + numtodsinterval(n / 97, 'DAY'), n / 97 from (select p.i + q.i * 10 + r.i * 100 + w.i * 1000 + 1 n from dg p cross join dg q cross join dg r cross join dg w) z where n <= 3000\ncreate table dd (id number(10) primary key, d date)"

const QS = "select count(*) n, min(d) lo, max(d) hi, count(distinct d) nd, min(t) tlo, max(t) thi from dt\nselect id, d, t, x from dt where id in (1, 2, 3, 97, 1000, 3000) order by id\ninsert into dd select id, date '2024-03-05' + id / 97 from dt where id <= 500 ;; select count(*) n, count(distinct d) nd, max(d) hi from dd\ninsert into dd (id, d) values (1, date '2024-03-05' - 2 / 97) ;; update dd set d = d + 1 / 97 ;; select id, d from dd\nselect date '2024-03-05' + 2 / 97 a, date '2024-03-05' + 1 / 97 b, date '2024-03-05' - 2 / 97 c, 2 / 97 + date '2024-03-05' d from dual\nselect timestamp '2024-03-05 00:00:00' - 2 / 97 a, timestamp '2024-03-05 10:00:00.5' + 1 b, timestamp '2024-03-05 10:00:00.7' - 1 / 86400 c from dual\nselect date '2024-03-05' + 0.5 / 86400 a, date '2024-03-05' + 0.49999 / 86400 b, date '2024-03-05' - 0.5 / 86400 c, date '2024-03-05' + 1e-20 d, date '1950-03-05' - 2 / 97 e from dual\nselect id, d + x a, d - x b, x + d c from dt where id in (1, 2, 3, 3000) order by id\nselect date '2024-03-05' + 123456789012345678901234567890123456.78 from dual\nselect trunc(date '2024-03-05' + 2 / 97, 'MI') a, time_bucket(date '2024-03-05' + 2 / 97, interval '1' day, date '2000-01-01') b, round(date '2024-03-05' + 2 / 97, 'HH') c from dual\nselect trunc(d + x, 'HH') h, count(*) n from dt where id <= 300 group by trunc(d + x, 'HH') order by 1 fetch first 4 rows only\nselect round(extract(second from numtodsinterval(2 / 97, 'DAY')), 6) a, extract(minute from numtodsinterval(2 / 97, 'DAY')) b, round(extract(second from numtodsinterval(2 / 97, 'HOUR')), 6) c, extract(hour from numtodsinterval(0.99999999999999999999999999999999999999, 'HOUR')) d, round(extract(second from numtodsinterval(0.99999999999999999999999999999999999999, 'MINUTE')), 6) e from dual\nselect numtoyminterval(12345678.901234567890123456789012345678, 'YEAR') b, numtoyminterval(0.99999999999999999999999999999999999999, 'YEAR') c from dual\nselect numtodsinterval(1e30, 'SECOND') from dual\nselect round(extract(second from interval '1' day * (2 / 97)), 6) a, round(extract(second from (2 / 97) * interval '1' day), 6) b, round(extract(second from interval '1 02:03:04' day to second * (2 / 97)), 6) c, extract(minute from interval '1' day * (2 / 97)) e from dual\nselect id, extract(day from interval '1' hour * x) d, extract(hour from interval '1' hour * x) h, round(extract(second from interval '1' hour * x), 6) s from dt where id in (1, 2, 3000) order by id\nselect months_between(date '2024-03-05', date '2020-01-02') a, months_between(date '2024-03-05', date '1020-01-02') b, months_between(date '2020-01-02', date '2024-03-05') c from dual\nselect id, months_between(d, date '2020-01-02') m from dt where id in (1, 2, 3000) order by id\nselect width_bucket(12345678901234567890123456789012345678, 0.1, 99999999999999999999999999999999999999, 5) a, width_bucket(1.2345678901234567890123456789012345678, 0.1, 12345678901234567890123456789012345678, 5) b, width_bucket(99999999999999999999999999999999999998, 99999999999999999999999999999999999999, 0, 5) c, width_bucket(5, 10, 0.1, 5) d from dual\nselect width_bucket(x, 0.0000000000000000000000000000000000001, 30.9, 7) b, count(*) n from dt group by width_bucket(x, 0.0000000000000000000000000000000000001, 30.9, 7) order by 1\nselect percentile_cont(0.5) within group (order by x) a from (select 2 / 97 x from dual union all select 12345678901234567890123456789012345678 from dual)\nselect percentile_cont(2 / 97) within group (order by x) a, percentile_cont(1 / 3) within group (order by x) b, percentile_disc(2 / 97) within group (order by x) c from (select 1 x from dual union all select 2 from dual union all select 7 from dual)\nselect percentile_cont(0.5) within group (order by x) a from (select 2 / 97 x from dual union all select 1 / 3 from dual)\nselect percentile_disc(0.99999999999999999999999999999999999999) within group (order by x) a, percentile_disc(0.33333333333333333333333333333333333334) within group (order by x) b, percentile_cont(0.99999999999999999999999999999999999999) within group (order by x) c from (select 1 x from dual union all select 2 from dual union all select 3 from dual)\nselect percentile_cont(1 / 3) within group (order by x) a, percentile_disc(1 / 3) within group (order by x) b, count(*) n from dt\nselect mod(id, 3) k, percentile_cont(2 / 97) within group (order by x) a, percentile_disc(0.99999999999999999999999999999999999999) within group (order by x) b from dt group by mod(id, 3) order by 1\nselect id, percentile_cont(1 / 3) within group (order by x) over (partition by mod(id, 2)) a, percentile_disc(0.99999999999999999999999999999999999999) within group (order by x) over (partition by mod(id, 2)) b from dt where id <= 4 order by id\nselect percentile_cont(0.5) within group (order by x) a, percentile_disc(0.5) within group (order by x) b from dt where id < 0"

fn values(rows: &oracle.Rows, row: int): str {
    var out: []str = []
    for i in 0..rows.columnCount() {
        match rows.isNull(row, i) {
            Ok(n) {
                if n { append(mut &out, "NULL") } else {
                    match rows.value(row, i) {
                        Ok(v) { append(mut &out, v.toStr()) }
                        Err(e) { append(mut &out, "error " + e.code.toStr() + " " + e.msg) }
                    }
                }
            }
            Err(e) { append(mut &out, "error " + e.code.toStr()) }
        }
    }
    return strings.join(&out, "|")
}

// A query: its columns' names, then its rows; or error and the number.
fn qtext(c: mut &oracle.Conn, sql: &str): str {
    match c.query(&(sql.toStr()), &[]) {
        Ok(rows) {
            var names: []str = []
            for j in 0..rows.columnCount() { append(mut &names, rows.columnName(j).unwrap()) }
            var rs: []str = []
            for i in 0..rows.rowCount() { append(mut &rs, values(&rows, i)) }
            return strings.join(&names, ",") + " = " + strings.join(&rs, ";")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

// A statement: its row count, or error and the number.
fn xtext(c: mut &oracle.Conn, sql: &str): str {
    match c.run(&(sql.toStr()), &[]) {
        Ok(n) { return n.toStr() }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn one(c: mut &oracle.Conn, sql: &str): str {
    let low = strings.toLowerAscii(sql)
    if strings.startsWith(&low, "select") || strings.startsWith(&low, "with") { return qtext(c, sql) }
    return xtext(c, sql)
}

// A query, or statements ("a ;; b ;; c") in a transaction rolled back: each answer, joined by " / " (after an error, the
// last part, the check, after the rollback).
fn answer(c: mut &oracle.Conn, sqls: &str): str {
    if !strings.contains(sqls, " ;; ") { return one(c, sqls) }
    let parts = strings.split(sqls, " ;; ")
    var out: []str = []
    var failed = false
    let r = c.transaction(fn(c2: mut &oracle.Conn): Result[int, oracle.Error] {
        for i in 0..len(parts) {
            if failed { break }
            let a = one(c2, &parts[i])
            if strings.startsWith(&a, "error") { failed = true }
            append(mut &out, a)
        }
        return Err(sqldialect.inputError("rolled back"))
    })
    if failed { append(mut &out, one(c, &parts[len(parts) - 1])) }
    return strings.join(&out, " / ")
}

fn client(port: &str) {
    match oracle.connect(&("User Id=app;Password=app;Data Source=127.0.0.1:" + port + "/lexdb")) {
        Ok(c0) {
            var c = c0
            var n = 0
            let setup: str = SETUP
            for s in strings.lines(&setup) {
                match c.run(&(s.toStr()), &[]) {
                    Ok(_) { n += 1 }
                    Err(e) { println("setup: error " + e.code.toStr() + ": " + s) }
                }
            }
            println("setup: " + n.toStr() + " statements")
            let text: str = QS
            for q in strings.lines(&text) {
                let a = c.run(&("set lexdb_batch = off".toStr()), &[])
                let off = answer(mut &c, &q)
                let b = c.run(&("set lexdb_batch = on".toStr()), &[])
                let on = answer(mut &c, &q)
                if off == on { println("same: " + on) } else {
                    println("DIFFERENT: " + q)
                    println("  rows:    " + off)
                    println("  batches: " + on)
                }
            }
            c.logoff()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        let f = s.start(lexdb_tns.acceptLoop, lexdb_tns.AcceptArg{ln: ln, st: st.share()})
        client(&addr[10..len(addr)])
        { let stop = f }
    })
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(61), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024, snapNodes: 50000}, body).unwrap()
}
