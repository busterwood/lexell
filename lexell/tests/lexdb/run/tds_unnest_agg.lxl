// expect: id,s: 1|14;2|12;3|10;4|6;5|23;6|12;7|14;8|12;9|10;10|6;11|23;12|12;13|NULL;14|12;15|10;16|6;17|23;18|12;19|14;20|12;21|10;22|6;23|23;24|12;25|14;26|NULL;27|10;28|6;29|23;30|12;31|14;32|12;33|10;34|6;35|23;36|12;37|14;38|12;39|NULL;40|6
// expect: id: 1;2;3;4;5
// expect: id,n: 1|5;2|4;3|5;4|4;5|5;6|4;7|5;8|4;9|5;10|4;11|5;12|4;13|0;14|4;15|5;16|4;17|5;18|4;19|5;20|4;21|5;22|4;23|5;24|4;25|5;26|0;27|5;28|4;29|5;30|4;31|5;32|4;33|5;34|4;35|5;36|4;37|5;38|4;39|0;40|4
// expect: id,n,s: 1|5|14;2|4|12;3|5|10;4|4|6;5|5|23;6|4|12;7|5|14;8|4|12;9|5|10;10|4|6;11|5|23;12|4|12;13|0|NULL;14|4|12;15|5|10;16|4|6;17|5|23;18|4|12;19|5|14;20|4|12;21|5|10;22|4|6;23|5|23;24|4|12;25|5|14;26|0|NULL;27|5|10;28|4|6;29|5|23;30|4|12;31|5|14;32|4|12;33|5|10;34|4|6;35|5|23;36|4|12;37|5|14;38|4|12;39|0|NULL;40|4|6
// expect: id,k,n: 1|1|5;2|2|4;3|3|5;4|4|4;5|5|5;6|0|4;7|1|5;8|2|4;9|3|5;10|4|4;11|5|5;12|0|4;14|2|4;15|3|5;16|4|4;17|5|5;18|0|4;19|1|5;20|2|4;21|3|5;22|4|4;23|5|5;24|0|4;25|1|5;27|3|5;28|4|4;29|5|5;30|0|4;31|1|5;32|2|4;33|3|5;34|4|4;35|5|5;36|0|4;37|1|5;38|2|4;40|4|4
// expect: id,n: 1|5;2|4;3|5;4|4;5|5;6|4;7|5;8|4;9|5;10|4;11|5;12|4;13|NULL;14|4;15|5;16|4;17|5;18|4;19|5;20|4;21|5;22|4;23|5;24|4;25|5;26|NULL;27|5;28|4;29|5;30|4;31|5;32|4;33|5;34|4;35|5;36|4;37|5;38|4;39|NULL;40|4
