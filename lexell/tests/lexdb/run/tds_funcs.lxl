import "os"
import "strings"
import "task"
import "net"
import "sqlserver"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_wire"
import "../../../cmd/lexdb_tds"

const QUERIES = "SELECT SYSTEM_USER\nSELECT SYSTEM_USER AS who, SUSER_SNAME() AS sn, CASE WHEN SYSTEM_USER = SUSER_SNAME() THEN 1 ELSE 0 END AS same\nSELECT SYSTEM_USER()\nSELECT LEN(SYSTEM_USER), UPPER(SYSTEM_USER), SYSTEM_USER + N'!'\nCREATE TABLE audit (id int, who nvarchar(128) DEFAULT SYSTEM_USER, who2 nvarchar(128) DEFAULT (SYSTEM_USER), who3 varchar(30) DEFAULT SUSER_SNAME())\nINSERT INTO audit (id) VALUES (1)\nSELECT id, who, who2, who3 FROM audit\nSELECT QUOTENAME('abc'), QUOTENAME(N'a b'), QUOTENAME('a]b'), QUOTENAME(''), QUOTENAME('a[b')\nSELECT QUOTENAME('abc', '['), QUOTENAME('abc', ']'), QUOTENAME('abc', '\"'), QUOTENAME('abc', ''''), QUOTENAME('abc', '(' ), QUOTENAME('abc', ')'), QUOTENAME('abc', '<'), QUOTENAME('abc', '>'), QUOTENAME('abc', '{'), QUOTENAME('abc', '}'), QUOTENAME('abc', '`')\nSELECT QUOTENAME('a\"b', '\"'), QUOTENAME('a''b', ''''), QUOTENAME('a]b', '['), QUOTENAME('a)b', '('), QUOTENAME('a}b', '{'), QUOTENAME('a>b', '<'), QUOTENAME('a`b', '`')\nSELECT QUOTENAME('abc', '#'), QUOTENAME('abc', 'x'), QUOTENAME('abc', '[]'), QUOTENAME('abc', NULL)\nSELECT QUOTENAME(NULL), QUOTENAME(NULL, '\"'), QUOTENAME(NULL, NULL)\nSELECT LEN(QUOTENAME(REPLICATE('a', 128))), QUOTENAME(REPLICATE('a', 129)), QUOTENAME(REPLICATE('a', 129), '\"'), LEN(QUOTENAME(REPLICATE(N'b', 128), '\"'))\nSELECT QUOTENAME(REPLICATE(']', 128)), QUOTENAME(REPLICATE(']', 129))\nSELECT QUOTENAME(123), QUOTENAME(1.5), QUOTENAME(CAST('2024-03-05' AS date))\nSELECT QUOTENAME()\nSELECT QUOTENAME('a', '[', 'c')\nSELECT name, QUOTENAME(name) AS q FROM (VALUES ('x y'), ('z')) t(name)\nCREATE VIEW v_emp AS SELECT id, who FROM audit WHERE id > 0\nSELECT OBJECT_DEFINITION(OBJECT_ID('v_emp'))\nSELECT OBJECT_DEFINITION(OBJECT_ID('dbo.v_emp')), LEN(OBJECT_DEFINITION(OBJECT_ID('v_emp')))\nSELECT OBJECT_DEFINITION(OBJECT_ID('audit'))\nSELECT OBJECT_DEFINITION(0), OBJECT_DEFINITION(-1), OBJECT_DEFINITION(99999999), OBJECT_DEFINITION(NULL)\nSELECT OBJECT_DEFINITION(OBJECT_ID('nothing_here'))\nSELECT OBJECT_DEFINITION()\nSELECT name, OBJECT_DEFINITION(object_id) FROM sys.views WHERE name = 'v_emp'\nSELECT OBJECT_DEFINITION(object_id) FROM sys.objects WHERE name = 'v_emp'\nCREATE VIEW v_two AS SELECT  1  AS a,   2 AS b  -- a comment\nSELECT OBJECT_DEFINITION(OBJECT_ID('v_two'))\nCREATE SEQUENCE s_one START WITH 5 INCREMENT BY 2\nSELECT name, CAST(start_value AS bigint), CAST(increment AS bigint), CAST(current_value AS bigint), CAST(last_used_value AS bigint), is_exhausted FROM sys.sequences WHERE name = 's_one'\nSELECT NEXT VALUE FOR s_one\nSELECT name, CAST(current_value AS bigint), CAST(last_used_value AS bigint) FROM sys.sequences WHERE name = 's_one'\nSELECT NEXT VALUE FOR s_one\nSELECT NEXT VALUE FOR s_one\nSELECT name, CAST(current_value AS bigint), CAST(last_used_value AS bigint) FROM sys.sequences WHERE name = 's_one'\nALTER SEQUENCE s_one RESTART WITH 100\nSELECT name, CAST(current_value AS bigint), CAST(last_used_value AS bigint) FROM sys.sequences WHERE name = 's_one'\nSELECT NEXT VALUE FOR s_one\nSELECT CAST(current_value AS bigint), CAST(last_used_value AS bigint) FROM sys.sequences WHERE name = 's_one'\nCREATE SEQUENCE s_two AS bigint START WITH 1 INCREMENT BY -1 MINVALUE -10 MAXVALUE 1 CYCLE CACHE 3\nSELECT name, CAST(current_value AS bigint), CAST(last_used_value AS bigint), is_cycling FROM sys.sequences WHERE name = 's_two'\nSELECT NEXT VALUE FOR s_two\nSELECT NEXT VALUE FOR s_two\nSELECT name, CAST(current_value AS bigint), CAST(last_used_value AS bigint) FROM sys.sequences WHERE name = 's_two'\nSELECT COUNT(*), COUNT(last_used_value) FROM sys.sequences\nSELECT CAST(last_used_value AS bigint) + 1 FROM sys.sequences WHERE name = 's_one'\nSELECT name, last_used_value FROM sys.sequences WHERE name = 's_nothing'\nCREATE SEQUENCE s_three AS int START WITH 7\nSELECT CAST(current_value AS int), CAST(last_used_value AS int), CAST(start_value AS int), CAST(maximum_value AS int), is_exhausted FROM sys.sequences WHERE name = 's_three'\nINSERT INTO audit (id) VALUES (NEXT VALUE FOR s_three)\nSELECT CAST(current_value AS int), CAST(last_used_value AS int) FROM sys.sequences WHERE name = 's_three'\nCREATE SEQUENCE s_dflt AS int START WITH 1\nCREATE TABLE uses_seq (id int DEFAULT (NEXT VALUE FOR s_dflt), v int)\nINSERT INTO uses_seq (v) VALUES (1), (2), (3)\nSELECT CAST(current_value AS int), CAST(last_used_value AS int) FROM sys.sequences WHERE name = 's_dflt'\nCREATE TABLE ident_t (id int IDENTITY(10, 5) PRIMARY KEY, x int)\nSELECT name, CAST(seed_value AS int), CAST(increment_value AS int), CAST(last_value AS int) FROM sys.identity_columns WHERE object_id = OBJECT_ID('ident_t')\nINSERT INTO ident_t (x) VALUES (1), (2)\nSELECT name, CAST(seed_value AS int), CAST(increment_value AS int), CAST(last_value AS int) FROM sys.identity_columns WHERE object_id = OBJECT_ID('ident_t')\nSELECT QUOTENAME('abc', ''), QUOTENAME('abc', '\"x'), QUOTENAME('abc', ' '), QUOTENAME(CAST(1.50 AS decimal(5,2))), QUOTENAME(CAST(1 AS bit)), QUOTENAME(N'é')\nSELECT QUOTENAME('a]b]', ']'), QUOTENAME('[', '['), QUOTENAME(CAST(NULL AS varchar(5)), '['), QUOTENAME('a', CAST(NULL AS varchar(1))), LEN(QUOTENAME(REPLICATE(N'x', 128), '['))\nSELECT QUOTENAME(name) FROM sys.tables WHERE name = 'audit'\nCREATE SCHEMA s2\nCREATE VIEW s2.v3 AS SELECT 3 AS c;\nSELECT OBJECT_DEFINITION(OBJECT_ID('s2.v3')), LEN(OBJECT_DEFINITION(OBJECT_ID('s2.v3')))\nSELECT definition FROM sys.sql_modules WHERE object_id = OBJECT_ID('v_two')\nSELECT OBJECT_DEFINITION(OBJECT_ID('s_one')), OBJECT_DEFINITION(OBJECT_ID('ident_t')), OBJECT_DEFINITION(OBJECT_ID('v_emp') + 0)"

fn rows(r: &sqlserver.Rows): str {
    var names: []str = []
    for j in 0..r.columnCount() { append(mut &names, r.columnName(j).unwrap()) }
    var out: []str = []
    for i in 0..r.rowCount() {
        var cells: []str = []
        for j in 0..r.columnCount() {
            match r.value(i, j) {
                Ok(v) { append(mut &cells, v.toStr()) }
                Err(e) { append(mut &cells, "error " + e.code.toStr()) }
            }
        }
        append(mut &out, strings.join(&cells, "|"))
    }
    return strings.join(&names, ",") + ": " + strings.join(&out, ";")
}

// a batch's result sets and row counts, in order; or its error
fn show(c: mut &sqlserver.Conn, q: &str): str {
    match c.queryAll(&(q.toStr()), &[]) {
        Ok(r) {
            var parts: []str = []
            var shown = 0
            for n in r.counts {
                if n.resultSet >= 0 {
                    append(mut &parts, rows(&r.sets[n.resultSet]))
                    shown += 1
                } else {
                    append(mut &parts, "(" + n.rows.toStr() + ")")
                }
            }
            if shown == 0 { for s in r.sets { append(mut &parts, rows(&s)) } }
            if len(parts) == 0 { return "ok" }
            return strings.join(&parts, " / ")
        }
        Err(e) { return "error " + e.code.toStr() }
    }
}

fn batches(dsn: &str) {
    match sqlserver.connect(&(dsn.toStr())) {
        Ok(c0) {
            var c = c0
            let text: str = QUERIES
            for q in strings.lines(&text) { println(show(mut &c, &q)) }
            c.close()
        }
        Err(e) { println("connect: error " + e.code.toStr() + " " + e.msg) }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    task.scope(fn(s: mut &task.Scope) {
        let ln = net.listen("127.0.0.1:0").unwrap()
        let addr = ln.localAddr()
        lexdb_wire.configure(&st, &lexdb_wire.noAuth()).unwrap()
        let f = s.start(lexdb_tds.acceptLoop, lexdb_tds.AcceptArg{ln: ln, st: st.share()})
        batches(&("Server=127.0.0.1," + addr[10..len(addr)] + ";UID=sa;PWD=x;Encrypt=no"))
        { let stop = f }
    })
    return 0
}

fn main() {
    // LEXDB_MSSQL: the oracle, for the expect lines (gen_mssql.py)
    match os.env("LEXDB_MSSQL") {
        Some(dsn) { batches(&dsn) }
        None {
            lexdb_store.run(lexdb_disk.sim(36), lexdb_store.Options{cacheBytes: 64 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                                     snapNodes: 50000}, body).unwrap()
        }
    }
}
