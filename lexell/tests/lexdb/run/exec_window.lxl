// lexdb_exec: window functions (design/lexdb.md 9.46). Ranking (row_number,
// rank, dense_rank, percent_rank, cume_dist, ntile), values (lag, lead,
// first_value, last_value, nth_value) and aggregates over frames: ROWS,
// RANGE (offsets too), GROUPS, EXCLUDE; partitions, peers, named windows;
// over a grouped query's groups; with FILTER, DISTINCT, LIMIT, in a
// subquery; ORDER BY ... NULLS FIRST / LAST. The expected lines of the
// queries are PostgreSQL 16's own output for them (psql -At), but for the
// errors' and types' lines.
// expect: ranks: 1|3|3 2|2|2 3|3|3 4|3|2 5|1|1 6|1|1 7|1|1 8|1|1 9|2|2 10|4|3
// expect: row_number: 1|1 2|3 3|2 4|2 5|3 6|4 7|1 8|4 9|2 10|1
// expect: percent and cume: 1|0.5|0.8 2|1|1 3|0.5|0.8 4|0|0.2 5|0.25|0.4
// expect: ntile: 1|1|1 2|1|1 3|1|1 4|1|2 5|2|2 6|2|2 7|2|3 8|3|3 9|3|4 10|3|4
// expect: lag and lead: 1||100 2|100|90 3|120|95 4|100|95 5|90|80 6|95|150 7|95| 8|80|70 9|150|-1 10||-1
// expect: first last nth: 1|ann|ann| 2|ann|bob|bob 3|ann|cy|bob 4|dee|dee| 5|dee|eve|eve 6|dee|fay|eve 7|gus|gus| 8|ann|hal|bob 9|gus|ivy|ivy 10|dee|jo|eve
// expect: running: 1|100|1|100 2|220|2|120 3|320|3|120 4|410|4|120 5|505|5|120 6|600|6|120 7|680|7|120 8|830|8|150 9|830|8|150 10|900|9|150
// expect: peers: 10|70 7|150 4|240 5|430 6|430 1|630 3|630 2|750 8|900 9|900
// expect: rows: 1|220|280 2|320|270 3|310|325 4|285|230 5|280|220 6|270|70 7|325|70 8|230| 9|220| 10|70|
// expect: range: 10|17 7|21 4|26 5|19 6|19 1|19 3|19 2|2 8|8 9|9
// expect: range down: 9|9 8|8 2|2 1|4 3|4 5|15 6|15 4|15 7|7 10|10
// expect: groups: 10|17 7|21 4|22 5|19 6|19 1|17 3|17 2|14 8|19 9|17
// expect: exclude: 10|45||17 7|48|10|21 4|51|17|22 5|50|21|13 6|49|21|14 1|54|32|14 3|52|32|16 2|53|36|14 8|47|38|19 9|46|46|17
// expect: grouped: eng|470|1|900 hr|80|3|900 ops|350|2|900
// expect: filter and string_agg: 1|4|ann 2|4|ann,bob 3|4|ann,bob,cy 4|2|dee 5|2|dee,eve 6|2|dee,eve,fay 7|0|gus 8|4|ann,bob,cy,hal 9|0|gus,ivy 10|2|dee,eve,fay,jo
// expect: expressions: 1||11 2|20|13 3|-20|11 4|-10|10 5|5|10 6|0|10 7|-15|8 8|70|16 9|| 10||7
// expect: distinct: eng|4 hr|2 ops|4
// expect: limit: 8|9 2|8 1|6
// expect: top per group: eng|8 hr|7 ops|5
// expect: named: 1|1|100 2|2|220 3|3|320 4|1|90 5|2|185 6|3|280 7|1|80 8|4|470 9|2|80 10|4|350
// expect: nulls first: 9 10 7 4 5 6 1 3 2 8
// expect: nulls last: 8 2 1 3 5 6 4 7 10 9
// expect: none: 
// expect: limited: 1|10 2|10
// expect: bare named frame: 1|100 2|220 3|220 4|190 5|185 6|190 7|175 8|230 9|150 10|70
// expect: desc nulls: 1|4 2|3 3|4 4|8 5|6 6|6 7|9 8|2 9|1 10|10
// expect: shorthand: 1|100 2|220 3|220 4|190 5|185 6|190 7|175 8|230 9|150 10|70
// expect: where: 42P20 window functions are not allowed in WHERE
// expect: two directions: 1|6|3 2|8|2 3|7|4 4|3|7 5|4|5 6|5|6 7|2|8 8|9|1 9|10|10 10|1|9
// expect: where 42P20, group by 42P20, nested 42P20, in a definition 42P20, in an aggregate 42803
// expect: not a window function 42809, without OVER 42809, unknown window 42704, override order 42P20, copy a frame 42P20
// expect: range of two keys 42P20, groups unordered 42P20, negative 22013, ntile 22014, nth_value 22016, distinct 0A000, in UPDATE 42P20
// expect: described: rank:20,percent_rank:701,lag:25,sum:20,row_number:20
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_sql"
import "../../../cmd/lexdb_exec"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var out: []str = []
            for row in r.rows {
                var vs: []str = []
                for v in row { append(mut &vs, lexdb_exec.text(&v)) }
                append(mut &out, strings.join(&vs, "|"))
            }
            return strings.join(&out, " ")
        }
        Err(e) { return e.state + " " + e.msg }
    }
}

fn state(s: mut &lexdb_exec.Session, sql: &str): str { return q(s, sql)[0..5] }

fn opts(): lexdb_store.Options {
    return lexdb_store.Options{cacheBytes: 256 * 1024, segBytes: 1024 * 1024, ckptBytes: 512 * 1024, snapNodes: 100000}
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(46), opts(), fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st)
        let c1 = q(mut &s, &"create table emp (id int primary key, dept text, name text, sal int, bonus numeric(8,2))")
        let c2 = q(mut &s, &"insert into emp values (1,'eng','ann',100,1.5),(2,'eng','bob',120,null),(3,'eng','cy',100,2),(4,'ops','dee',90,0.5),(5,'ops','eve',95,null),(6,'ops','fay',95,3),(7,'hr','gus',80,1),(8,'eng','hal',150,4),(9,'hr','ivy',null,2),(10,'ops','jo',70,1)")
        println("ranks: " + q(mut &s, &"select id, rank() over w, dense_rank() over w from emp window w as (partition by dept order by sal desc nulls last) order by id"))
        println("row_number: " + q(mut &s, &"select id, row_number() over (partition by dept order by sal, id) from emp order by id"))
        println("percent and cume: " + q(mut &s, &"select id, percent_rank() over (order by sal), cume_dist() over (order by sal) from emp where id <= 5 order by id"))
        println("ntile: " + q(mut &s, &"select id, ntile(3) over (order by id), ntile(4) over (order by id) from emp order by id"))
        println("lag and lead: " + q(mut &s, &"select id, lag(sal) over (order by id), lead(sal, 2, -1) over (order by id) from emp order by id"))
        println("first last nth: " + q(mut &s, &"select id, first_value(name) over w, last_value(name) over w, nth_value(name, 2) over w from emp window w as (partition by dept order by id) order by id"))
        println("running: " + q(mut &s, &"select id, sum(sal) over (order by id), count(sal) over (order by id), max(sal) over (order by id) from emp order by id"))
        println("peers: " + q(mut &s, &"select id, sum(sal) over (order by sal) from emp order by sal nulls last, id"))
        println("rows: " + q(mut &s, &"select id, sum(sal) over (order by id rows between 1 preceding and 1 following), sum(sal) over (order by id rows between 3 following and 5 following) from emp order by id"))
        println("range: " + q(mut &s, &"select id, sum(id) over (order by sal range between 10 preceding and 10 following) from emp order by sal nulls last, id"))
        println("range down: " + q(mut &s, &"select id, sum(id) over (order by sal desc range between 5 preceding and current row) from emp order by sal desc nulls first, id"))
        println("groups: " + q(mut &s, &"select id, sum(id) over (order by sal groups between 1 preceding and 1 following) from emp order by sal nulls last, id"))
        println("exclude: " + q(mut &s, &"select id, sum(id) over (order by sal rows between unbounded preceding and unbounded following exclude current row), sum(id) over (order by sal range between unbounded preceding and current row exclude group), sum(id) over (order by sal groups between 1 preceding and 1 following exclude ties) from emp order by sal nulls last, id"))
        println("grouped: " + q(mut &s, &"select dept, sum(sal), rank() over (order by sum(sal) desc), sum(sum(sal)) over () from emp group by dept order by dept"))
        println("filter and string_agg: " + q(mut &s, &"select id, count(*) filter (where sal > 90) over (partition by dept), string_agg(name, ',') over (partition by dept order by id) from emp order by id"))
        println("expressions: " + q(mut &s, &"select id, sal - lag(sal) over (order by id), 100 * sal / sum(sal) over () from emp order by id"))
        println("distinct: " + q(mut &s, &"select distinct dept, count(*) over (partition by dept) from emp order by dept"))
        println("limit: " + q(mut &s, &"select id, rank() over (order by sal) r from emp order by r desc, id limit 3 offset 1"))
        println("top per group: " + q(mut &s, &"select dept, id from (select id, dept, row_number() over (partition by dept order by sal desc nulls last, id) rn from emp) x where rn = 1 order by dept"))
        println("named: " + q(mut &s, &"select id, count(*) over (w2), sum(sal) over (w1 rows between unbounded preceding and current row) from emp window w1 as (partition by dept order by id), w2 as (w1) order by id"))
        println("nulls first: " + q(mut &s, &"select id from emp order by sal nulls first, id"))
        println("nulls last: " + q(mut &s, &"select id from emp order by sal desc nulls last, id"))
        println("none: " + q(mut &s, &"select count(*) over () from emp where false"))
        println("limited: " + q(mut &s, &"select id, count(*) over () from emp limit 2"))
        println("bare named frame: " + q(mut &s, &"select id, sum(sal) over w from emp window w as (order by id rows between 1 preceding and current row) order by id"))
        println("desc nulls: " + q(mut &s, &"select id, rank() over (order by sal desc) from emp order by id"))
        println("shorthand: " + q(mut &s, &"select id, sum(sal) over (order by id rows 1 preceding) from emp order by id"))
        println("where: " + q(mut &s, &"select id from emp where row_number() over () > 1"))
        println("two directions: " + q(mut &s, &"select id, row_number() over (order by sal nulls last, id), row_number() over (order by sal desc nulls last, id) from emp order by id"))
        println("where " + state(mut &s, &"select id from emp where row_number() over () > 1") + ", group by " +
                state(mut &s, &"select dept from emp group by rank() over ()") + ", nested " +
                state(mut &s, &"select sum(rank() over ()) over () from emp") + ", in a definition " +
                state(mut &s, &"select rank() over (order by rank() over ()) from emp") + ", in an aggregate " +
                state(mut &s, &"select sum(row_number() over ()) from emp"))
        println("not a window function " + state(mut &s, &"select upper(name) over () from emp") + ", without OVER " +
                state(mut &s, &"select row_number() from emp") + ", unknown window " + state(mut &s, &"select rank() over nope from emp") +
                ", override order " + state(mut &s, &"select count(*) over (w order by id) from emp window w as (order by sal)") +
                ", copy a frame " + state(mut &s, &"select count(*) over (w) from emp window w as (order by sal rows unbounded preceding)"))
        println("range of two keys " + state(mut &s, &"select sum(sal) over (order by sal, id range between 1 preceding and current row) from emp") +
                ", groups unordered " + state(mut &s, &"select sum(sal) over (groups between 1 preceding and current row) from emp") +
                ", negative " + state(mut &s, &"select sum(sal) over (order by id rows between -1 preceding and current row) from emp") +
                ", ntile " + state(mut &s, &"select ntile(0) over () from emp") + ", nth_value " + state(mut &s, &"select nth_value(name, 0) over () from emp") +
                ", distinct " + state(mut &s, &"select count(distinct dept) over () from emp") + ", in UPDATE " +
                state(mut &s, &"update emp set sal = rank() over ()"))
        let ps = lexdb_sql.parse(&"select rank() over (), percent_rank() over (), lag(name) over (), sum(sal) over (), row_number() over (order by id) from emp").unwrap()
        let nt: []int = []
        var ds: []str = []
        for c in s.describe(&ps[0], &nt).unwrap() { append(mut &ds, c.name + ":" + c.oid.toStr()) }
        println("described: " + strings.join(&ds, ","))
        return 0
    }).unwrap()
}
