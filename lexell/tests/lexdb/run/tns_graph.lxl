const SETUP = "create table person (id number primary key, name varchar2(20), age number, city varchar2(20))\ncreate table company (id number primary key, name varchar2(20), founded number)\ncreate table knows (id number primary key, src number, dst number, since number)\ncreate table works_at (pid number, cid number, role varchar2(10), constraint wa_pk primary key (pid, cid))\ncreate table follows (id number primary key, a number, b number)\ncreate table town (tname varchar2(20) primary key, country varchar2(20))\ncreate table lives (pid number primary key, tname varchar2(20))\ninsert into person values (1, 'Ann', 30, 'Oslo')\ninsert into person values (2, 'Bob', 40, 'Rome')\ninsert into person values (3, 'Cid', 25, 'Oslo')\ninsert into person values (4, 'Dee', null, null)\ninsert into person values (5, 'Eve', 35, 'Pisa')\ninsert into company values (10, 'Acme', 1990)\ninsert into company values (11, 'Bolt', null)\ninsert into company values (12, 'Cogs', 2001)\ninsert into knows values (100, 1, 2, 2010)\ninsert into knows values (101, 2, 3, 2012)\ninsert into knows values (102, 3, 1, 2015)\ninsert into knows values (103, 1, 1, 2020)\ninsert into knows values (104, 1, null, 2021)\ninsert into knows values (105, null, 2, 2022)\ninsert into knows values (106, 5, 4, null)\ninsert into knows values (107, 2, 1, 2013)\ninsert into works_at values (1, 10, 'dev')\ninsert into works_at values (2, 10, 'ops')\ninsert into works_at values (3, 11, 'dev')\ninsert into works_at values (5, 12, null)\ninsert into town values ('Oslo', 'NO')\ninsert into town values ('Rome', 'IT')\ninsert into town values ('Lima', 'PE')\ninsert into lives values (1, 'Oslo')\ninsert into lives values (2, 'Rome')\ninsert into lives values (3, 'Oslo')\ninsert into lives values (4, null)\ninsert into lives values (5, 'Nowhere')\ncreate property graph social vertex tables (person label person label human properties (name, age * 2 as dbl, upper(city) as town), company, town key (tname)) edge tables (knows source key (src) references person (id) destination key (dst) references person (id), works_at source key (pid) references person (id) destination key (cid) references company (id) label works_at label job properties (role), follows source key (a) references person (id) destination key (b) references person (id), lives key (pid) source key (pid) references person (id) destination key (tname) references town (tname))\ncreate property graph twice vertex tables (person as p1 label a1 properties (id, name), person as p2 label a2 properties (id, name, age)) edge tables (knows source key (src) references p1 (id) destination key (dst) references p2 (id) no properties)\ncreate table emp (id number primary key, name varchar2(20), dept number)\ncreate table dept (id number primary key, dname varchar2(20))\ncreate table asg (eid number references emp (id), did number references dept (id), hours number, primary key (eid, did))\ninsert into dept values (1, 'Sales')\ninsert into dept values (2, 'Labs')\ninsert into emp values (1, 'Boss', 1)\ninsert into emp values (2, 'Wkr', 1)\ninsert into emp values (3, 'Sci', 2)\ninsert into asg values (2, 1, 10)\ninsert into asg values (3, 2, 20)\ninsert into asg values (3, 1, 5)\ncreate property graph org vertex tables (emp label staff, dept) edge tables (asg source emp destination dept properties all columns except (eid))\ncreate table gone (id number primary key, v number)\ncreate property graph broken vertex tables (gone, company)\ndrop table gone\ncreate table shrink (id number primary key, v number, w number)\ncreate property graph shrunk vertex tables (shrink properties (id, v))\nalter table shrink drop column v\ncreate view pview as select id, name from person where id < 4\ncreate property graph viewg vertex tables (pview key (id))\ncreate view gview as select * from graph_table (social match (a is person) -[e is knows]-> (b is person) columns (a.name as an, b.name as bn))\ncreate table nopk (a number, b number)"

const QS = "select * from graph_table (social match (a is person) -[e is knows]-> (b is person) columns (a.name as an, b.name as bn, e.since as s)) order by 1, 2, 3\nselect * from graph_table (social match (a is person) -[e is knows]-> (b is person) columns (a.name, b.name as bn)) order by 1, 2\nselect * from graph_table (social match (a) -[e]-> (b) columns (a.name as an, b.name as bn, e.since as s)) order by 1, 2, 3\nselect * from graph_table (social match (a) <-[e]- (b) columns (a.name as an, b.name as bn)) order by 1, 2\nselect * from graph_table (social match (a is person) -[e is knows]- (b) columns (a.name as an, b.name as bn, e.id as eid)) order by 1, 2, 3\nselect * from graph_table (social match (a) - (b) columns (a.id as ai, b.id as bi)) order by 1, 2\nselect * from graph_table (social match (a) -> (b) columns (a.id as ai, b.id as bi)) order by 1, 2\nselect * from graph_table (social match (a) <- (b) columns (a.id as ai, b.id as bi)) order by 1, 2\nselect * from graph_table (social match -[e]-> columns (e.id as eid)) order by 1\nselect * from graph_table (social match (a is person) -[e is knows]->{1,2} (b is person) columns (a.name as an, b.name as bn)) order by 1, 2\nselect * from graph_table (social match (a is person) -[e is knows]->{2} (b is person) columns (a.name as an, b.name as bn)) order by 1, 2\nselect * from graph_table (social match (a is person) -[e is knows]->{1,3} (b is person) columns (a.name as an, b.name as bn)) order by 1, 2\nselect a, count(*) n from graph_table (social match (x is person) -[e is knows]->{3} (y is person) columns (x.name as a)) group by a order by 1\nselect * from graph_table (social match (a is person) -[e is knows]->{,2} (b is person) columns (a.name as an, b.name as bn)) order by 1, 2\nselect * from graph_table (social match (a is person) -[e is knows]-{2} (b is person) columns (a.name as an, b.name as bn)) order by 1, 2\nselect * from graph_table (social match (a is person) <-[e is knows]-{1,2} (b is person) columns (