import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table e (x int)\n@once create table nb (id int primary key, k text, d date, iv interval, b bytea, rn text)\n@once insert into nb select i, case when i % 37 = 0 then null else 'k' || (i % 6) end, date '2024-01-01' + (i % 400), make_interval(hours => i % 50), case when i % 11 = 0 then null else decode(lpad(to_hex(i), 6, '0'), 'hex') end, (array['I', 'IV', 'XIV', 'MCMXCIV', 'xlix'])[1 + i % 5] from generate_series(1, 3000) i\nselect extract(week from date '2020-01-08')\nselect extract(year from d), count(*) from nb where id < 500 group by extract(year from d) order by 1\nselect extract(week from date '2020-01-08') as w, date_part('week', date '2020-01-08'), extract(epoch from interval '1 day')\nselect 1 is distinct from 2, 1 is not distinct from 2, null is distinct from 1\nselect k is distinct from 'k1', count(*) from nb group by 1 order by 1\nselect 0x1F, 0o17, 0b101, 1_000, 1_000.5, 0X1f, 0B11, 0O7, 0x_1F, 0x1_F, 1_0e1_0\nselect 9223372036854775807, 0x7FFFFFFFFFFFFFFF, 0x8000000000000000, 0xFFFFFFFFFFFFFFFFFFFF\nselect 0x80000000, pg_typeof(0x7fffffff), pg_typeof(0x80000000), pg_typeof(0b1)\nselect -0x10, 0x10 + 1, 1_000 * 2\nselect 0x\nselect 0b\nselect 0b2\nselect 1__000\nselect 1_000_\nselect 1_\nselect 12abc\nselect 1.5e\nselect '1_000'::int, '0x1F'::int, '0o17'::bigint, '0b101'::smallint, '1_000.5'::numeric, ' 0x1F '::int, '-0x10'::int, '+1_000'::int\nselect cast('1_000' as integer), cast('0x1f' as bigint)\nselect '0x'::int\nselect '_1'::int\nselect '1_'::int\nselect '1__0'::int\nselect '1_000'::float8\nselect '1_000.5'::int\nselect reverse('\\x0102'::bytea), reverse('abc'), reverse(''::bytea), reverse(null::bytea), pg_typeof(reverse('\\x01'::bytea))\nselect id, reverse(b) from nb where id in (1, 11, 255, 3000) order by id\nselect count(*), count(reverse(b)), min(reverse(b)) from nb\nselect to_number('MCMXCIV', 'RN'), to_number('  xiv', 'RN'), to_number('iv', 'rn'), to_number('XIV ', 'RN'), to_number('MMMCMXCIX', 'RN'), to_number('xiv', 'FMRN'), to_number('XIV', '  RN'), to_number('XIV 12', 'RN'), to_number('CMXC', 'RN')\nselect to_number('MMMM', 'RN')\nselect to_number('IIII', 'RN')\nselect to_number('IC', 'RN')\nselect to_number('VV', 'RN')\nselect to_number('', 'RN')\nselect to_number('XIVx', 'RN')\nselect rn, to_number(rn, 'RN'), count(*) from nb group by rn order by rn\nselect 1 || 2\nselect 1.5 || 2\nselect true || 1\nselect 1 || 'a', 'a' || 1, null || 1, 1 || null\nselect id || k from nb where id = 1\nselect count(*) from nb where id || 'x' = '7x'\nselect sum(x), avg(x), pg_typeof(sum(x)), pg_typeof(avg(x)) from (values (interval '3 hours'), (interval '1 day 2 hours'), (null)) v (x)\nselect avg(x) from (values (interval '1 month'), (interval '2 days')) v (x)\nselect sum(x), avg(x) from (values (interval '3 hours')) v (x) where false\nselect k, sum(iv), avg(iv), count(iv) from nb group by k order by k\nselect sum(iv), avg(iv) from nb where id > 2900\nselect nosuchfn(x) from e\nselect nosuchfn(x) from e where false\nselect x from e where nosuchfn(x) > 0\nselect nosuchfn(1)\nselect lpad('a', 1, 'b', 'c')"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = show(mut &s, &l)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = show(mut &s, &l)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(141), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
