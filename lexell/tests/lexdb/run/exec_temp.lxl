import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create table perm (id int primary key, v text)\ninsert into perm values (1, 'permanent'), (2, 'also')\ncreate temp table perm (id int primary key, v text)\ninsert into perm values (10, 'temporary')\nselect * from perm order by id\nselect * from public.perm order by id\nselect * from pg_temp.perm order by id\nupdate perm set v = 'changed' where id = 10\ndelete from public.perm where id = 2\nselect (select count(*) from perm), (select count(*) from public.perm)\nselect relname, relpersistence, relkind from pg_class where relname like 'perm%' order by 1, 2\nselect pg_table_is_visible('public.perm'::regclass), pg_table_is_visible('perm'::regclass)\nselect 'pg_temp.perm'::regclass::text, 'public.perm'::regclass::text\ndrop table perm\nselect * from perm order by id\ncreate temporary table tt (id serial primary key, v text default 'dflt' check (v <> 'bad'), n int unique, k int generated always as identity)\ninsert into tt (v, n) values ('a', 1), (default, 2)\ninsert into tt (v, n) values ('bad', 3)\ninsert into tt (v, n) values ('dup', 1)\nselect id, v, n, k from tt order by id\ncreate index tt_lower on tt (lower(v))\ncreate unique index tt_vn on tt (v, n) where n > 0\nselect v from tt where lower(v) = 'a'\nselect relname, relpersistence, relkind from pg_class where relname like 'tt%' order by 1\nselect table_type, table_schema like 'pg_temp%' from information_schema.tables where table_name = 'tt'\nselect column_name, column_default from information_schema.columns where table_name = 'tt' order by ordinal_position\nselect schemaname like 'pg_temp%', tablename from pg_tables where tablename = 'tt'\nselect indexname from pg_indexes where tablename = 'tt' order by 1\nselect count(*) from pg_namespace where nspname like 'pg_temp%' and oid = pg_my_temp_schema()\nselect pg_my_temp_schema() <> 0, pg_is_other_temp_schema(pg_my_temp_schema())\nselect nspname like 'pg_temp%' from pg_namespace n join pg_class c on c.relnamespace = n.oid where c.relname = 'tt'\nselect current_schema()\ncreate local temp table lt (a int)\ncreate global temporary table gt (a int)\ninsert into lt values (1)\nselect * from lt\ncreate temp table nokey (a int, b text)\ninsert into nokey values (1, 'x'), (1, 'x')\nupdate nokey set b = 'y' where a = 1\nselect * from nokey\nselect count(*) from pg_attribute where attrelid = 'nokey'::regclass and attnum > 0\ncreate temp table oc_del (a int primary key) on commit delete rows\ninsert into oc_del values (1)\nselect count(*) from oc_del\nbegin\ninsert into oc_del values (1), (2)\nselect count(*) from oc_del\ncommit\nselect count(*) from oc_del\nbegin\ninsert into oc_del values (3)\nrollback\nselect count(*) from oc_del\ncreate temp table oc_keep (a int) on commit preserve rows\ninsert into oc_keep values (1)\nselect count(*) from oc_keep\ncreate temp table oc_drop (a int) on commit drop\nselect * from oc_drop\nbegin\ncreate temp table oc_drop (a int) on commit drop\ninsert into oc_drop values (5)\nselect * from oc_drop\ncommit\nselect * from oc_drop\nbegin\ncreate temp table oc_drop2 (a int) on commit drop\nrollback\nselect * from oc_drop2\ncreate table bad_oc (a int) on commit delete rows\ncreate temp table ctas on commit delete rows as select 1 as x\ncreate temp table ctas2 as select id, v from public.perm\nselect * from ctas2\nselect relpersistence from pg_class where relname = 'ctas2'\nselect id * 2 as d into temp tinto from public.perm\nselect * from tinto\nselect relpersistence from pg_class where relname = 'tinto'\nselect 7 as s into temporary table tinto2\nselect * from tinto2\ncreate temp table if not exists tinto2 (z int)\ncreate temp table tinto2 (z int)\ncreate temp sequence tseq start 5\nselect nextval('tseq'), nextval('pg_temp.tseq'), currval('tseq')\nselect relpersistence, relkind from pg_class where relname = 'tseq'\nselect sequencename, schemaname like 'pg_temp%' from pg_sequences where sequencename = 'tseq'\ncreate temp view tv as select id, v from public.perm\nselect * from tv\ncreate view tv2 as select id from tt\nselect relname, relpersistence from pg_class where relname in ('tv', 'tv2') order by 1\ncreate view public.tv3 as select id from tt\ncreate schema s1\ncreate temp table s1.x (a int)\ncreate temp sequence s1.sq\ncreate temp view s1.vx as select 1\ncreate table pg_temp.made (a int)\nselect relpersistence from pg_class where relname = 'made'\ncreate table fkperm (a int references tt (id))\ncreate temp table fktemp (a int references public.perm (id))\ncreate temp table fkok (a int references tt (id) on delete cascade)\ninsert into fkok values (1)\ndelete from tt where id = 1\nselect count(*) from fkok\nalter table fkok add column b int\nalter table fkok rename to fkok2\nselect * from fkok2\nalter table fkok2 set schema s1\nalter table perm set schema pg_temp\ntruncate fkok2\nbegin read only\ninsert into nokey values (3, 'ro')\nupdate nokey set b = 'ro2' where a = 3\ndelete from nokey where a = 1\nselect * from nokey\ncreate temp table ro (a int)\nrollback\nbegin read only\ninsert into perm values (5, 'no')\nrollback\nbegin read only\ntruncate nokey\nrollback\nbegin\ncreate temp table inblock (a int)\ninsert into inblock values (1)\nsavepoint s\ncreate temp table inblock2 (a int)\nrollback to s\nselect * from inblock2\ncommit\nselect * from inblock\nbegin\ncreate temp table gone (a int)\nrollback\nselect * from gone\ndiscard temp\nselect count(*) from pg_class where relpersistence = 't'\nselect * from tt\nselect * from public.perm order by id\ncreate temp table again (a int)\nbegin\ndiscard temp\nselect * from again\nrollback\nselect * from again\nbegin\ndiscard all\nrollback\ndiscard all\nselect * from again\nselect count(*) from pg_class where relpersistence = 't'\ndrop table perm"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                // as a client sees them: a timestamptz in the session's zone (9.95)
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(96), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
