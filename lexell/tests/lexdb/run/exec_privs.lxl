// expect: SET
// expect: CREATE TABLE
// expect: INSERT 0 1
// expect: GRANT
// expect: CREATE VIEW
// expect: m
// expect: ERROR 42501
// expect: ALTER TABLE
// expect: CREATE INDEX
// expect: RESET
// expect: SET
// expect: 1|m|
// expect: ERROR 42501
// expect: ERROR 42501
// expect: ERROR 42501
// expect: RESET
// expect: mine|lx_alice
// expect: mine_v|lx_alice
// expect: f|t|f|t|t|t
// expect: t|f|t|t
// expect: lx_team|INSERT;lx_team|UPDATE
// expect: lx_team|lx_bob
// expect: mine|lx_alice;mine_v|lx_alice
// expect: ALTER TABLE
// expect: lx_bob
// expect: SET
// expect: ERROR 42501
// expect: ERROR 42501
// expect: RESET
// expect: SET
// expect: SET
// expect: RESET
// expect: SET
// expect: ERROR 42501
// expect: RESET
// expect: GRANT
// expect: SET
// expect: 1
// expect: RESET
// expect: REVOKE ROLE
// expect: SET
// expect: ERROR 42501
