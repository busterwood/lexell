// expect: 0
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "drop role if exists lx_alice, lx_bob, lx_team\ncreate role lx_alice login\ncreate role lx_bob login\ncreate role lx_team\ncreate table acc (id int primary key, who text, amount numeric(10,2))\ninsert into acc values (1, 'a', 10), (2, 'b', 20)\ncreate schema priv\ncreate table priv.notes (id int primary key, body text)\ninsert into priv.notes values (1, 'x')\ncreate view acc_small as select id, amount from acc where amount < 15\ncreate sequence s1\nset role lx_alice\nselect current_user, session_user = current_user\nselect * from acc\ninsert into acc values (3, 'c', 1)\ncreate table mine (id int primary key)\nreset role\ngrant select on acc to lx_alice\ngrant insert, update on acc to lx_team\ngrant lx_team to lx_bob\nset role lx_alice\nselect id from acc order by id\nupdate acc set amount = 0 where id = 1\nselect * from acc_small\nreset role\ngrant select on acc_small to lx_alice\nrevoke select on acc from lx_alice\nset role lx_alice\nselect * from acc_small\nselect * from acc\nreset role\nset role lx_bob\ninsert into acc values (3, 'c', 5)\nupdate acc set amount = 1\nupdate acc set amount = amount + 1 where id = 3\ndelete from acc where id = 3\ninsert into acc values (4, 'd', 1) returning id\nselect * from priv.notes\nreset role\ngrant usage on schema priv to lx_bob\nset role lx_bob\nselect * from priv.notes\nreset role\ngrant select on all tables in schema priv to lx_bob\nset role lx_bob\nselect * from priv.notes\nreset role\ngrant create on schema public to lx_alice\nset role lx_alice\ncreate table mine (id int primary key, v text)\ninsert into mine values (1, 'm')\ngrant select on mine to lx_bob\ncreate view mine_v as select v from mine\nselect * from mine_v\ndrop table acc\nalter table mine add column w int\ncreate index mine_v_idx on mine (v)\nreset role\nset role lx_bob\nselect * from mine\nselect * from mine_v\ninsert into mine values (2, 'n')\nalter table mine add column z int\nreset role\nselect tablename, tableowner from pg_tables where tablename = 'mine'\nselect viewname, viewowner from pg_views where viewname = 'mine_v'\nselect has_table_privilege('lx_alice', 'acc', 'SELECT'), has_table_privilege('lx_bob', 'acc', 'INSERT'), has_table_privilege('lx_bob', 'acc', 'DELETE'), has_table_privilege('lx_alice', 'mine', 'DELETE'), has_table_privilege('lx_bob', 'mine', 'select, insert'), has_table_privilege('lx_alice', 'acc_small', 'select')\nselect has_schema_privilege('lx_bob', 'priv', 'USAGE'), has_schema_privilege('lx_alice', 'priv', 'USAGE'), has_schema_privilege('lx_alice', 'public', 'CREATE'), has_schema_privilege('lx_bob', 'public', 'CREATE, USAGE')\nselect grantee, privilege_type from information_schema.table_privileges where table_name = 'acc' and grantee like 'lx_%' order by 1, 2\nselect r.rolname, m.rolname from pg_auth_members a join pg_roles r on r.oid = a.roleid join pg_roles m on m.oid = a.member where r.rolname like 'lx_%' order by 1\nselect c.relname, pg_get_userbyid(c.relowner) from pg_class c where c.relname in ('mine', 'mine_v') order by 1\nalter table mine owner to lx_bob\nselect tableowner from pg_tables where tablename = 'mine'\nset role lx_alice\ndrop table mine\nalter table mine owner to lx_alice\nreset role\nset role lx_bob\nset role lx_alice\nreset role\nset role lx_alice\nselect nextval('s1')\nreset role\ngrant usage on sequence s1 to lx_alice\nset role lx_alice\nselect nextval('s1')\nreset role\nrevoke lx_team from lx_bob\nset role lx_bob\ninsert into acc values (5, 'e', 1)\nreset role\ngrant select on acc to lx_nobody\ngrant usage on acc to lx_bob\ngrant select on nothing_here to lx_bob\ndrop role lx_alice\ndrop view mine_v\ndrop table mine\nrevoke create on schema public from lx_alice\nrevoke select on acc_small from lx_alice\nrevoke usage on sequence s1 from lx_alice\ndrop role lx_alice\nrevoke select on all tables in schema priv from lx_bob\nrevoke usage on schema priv from lx_bob\nrevoke insert, update on acc from lx_team\ndrop role lx_bob, lx_team\nselect count(*) from pg_roles where rolname like 'lx_%'"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(&r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(83), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000, bufferedPages: false}, body).unwrap()
}
