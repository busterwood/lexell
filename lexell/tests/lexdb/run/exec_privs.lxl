// expect: GRANT
// expect: REVOKE
// expect: SET
// expect: 1|10.00
// expect: ERROR 42501
// expect: RESET
// expect: SET
// expect: INSERT 0 1
// expect: UPDATE 3
// expect: ERROR 42501
// expect: ERROR 42501
// expect: ERROR 42501
// expect: ERROR 42501
