// expect: lx_alice|f
// expect: ERROR 42501
// expect: ERROR 42501
// expect: ERROR 42501
// expect: RESET
// expect: GRANT
// expect: GRANT
// expect: GRANT ROLE
// expect: SET
// expect: 1;2
// expect: ERROR 42501
