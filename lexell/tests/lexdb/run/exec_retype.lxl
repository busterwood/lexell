// lexdb_exec: ALTER TABLE ... ALTER COLUMN ... TYPE (design/lexdb.md 9.36).
// A widening (int to bigint, a longer varchar, more numeric precision)
// changes the catalog alone; any other change rewrites the table into new
// trees, its indexes on the column too (all of them when the column is in
// the key), and drops the old ones. "rewritten" says whether the store's
// trees changed; their number must not (the old ones are dropped), and
// shows when it does.
// expect: widened: ALTER TABLE, rewritten no, 1|10|5|abcde|1.25
// expect: to text: ALTER TABLE, rewritten yes, 10 2 30 by text order, by the index: 2, Index Scan using r_n
// expect: no automatic cast: 42804; bool: 42804, to text: ALTER TABLE true
// expect: with USING: ALTER TABLE, 2 10 30, by the index: 2
// expect: bad values: 22P02, all rows as before: 10|abcde 2|xy 30|7
// expect: shorter varchar: 22001; longer: ALTER TABLE, rewritten no
// expect: numeric: ALTER TABLE 1.3 2.5 -0.1, to int: ALTER TABLE 1 3 0, overflow: 22003
// expect: the key: ALTER TABLE, rewritten yes, 1 10 2 by text order, by key: 10, by k_w: 10 (Index Scan using k_w), then int again: ALTER TABLE 1 2 10
// expect: the key made equal: 23505
// expect: a unique index made equal: 23505 could not create unique index "u_v": Key (v)=(a) is duplicated.
// expect: a filtered index: 2 as text, 1 2 as int (Index Scan using f_f)
// expect: not null kept: 23502
// expect: using other columns: 1:a 2:a
// expect: two at once: bigint numeric, 10|2.00 2|5.00 30|0.00
// expect: large values: 6000 6000 tail, ALTER TABLE, rewritten yes
// expect: rolled back: integer
// expect: reopened: 10|2.00 2|5.00 30|0.00, bigint, by the index: 2
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var out: []str = []
            for row in r.rows {
                var vs: []str = []
                for v in row { append(mut &vs, lexdb_exec.text(&v)) }
                append(mut &out, strings.join(&vs, "|"))
            }
            return strings.join(&out, " ")
        }
        Err(e) { return e.state + " " + e.msg + (if len(e.detail) > 0 { ": " + e.detail } else { "" }) }
    }
}

fn state(s: mut &lexdb_exec.Session, sql: &str): str { return q(s, sql)[0..5] }

fn treeSet(st: &lexdb_store.Store): str {
    var ids: []str = []
    for t in st.trees() { append(mut &ids, t.toStr()) }
    return strings.join(&ids, ",")
}

// Runs an ALTER: its tag, and whether the trees changed.
fn alter(st: &lexdb_store.Store, s: mut &lexdb_exec.Session, sql: &str): str {
    let before = treeSet(st)
    let n = len(st.trees())
    let r = q(s, sql)
    let after = treeSet(st)
    return r + ", rewritten " + (if before == after { "no" } else { "yes" }) + (if len(st.trees()) == n { "" } else { ", trees " + n.toStr() + " to " + len(st.trees()).toStr() })
}

fn plan(s: mut &lexdb_exec.Session, sql: &str, want: &str): str {
    let p = q(s, &("explain " + sql))
    return if strings.contains(&p, want) { "Index Scan using " + want } else { p }
}

// The type of a column as a result's OID names it.
fn typeOf(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let o = rs[len(rs) - 1].cols[0].oid
            return if o == 20 { "bigint" } else if o == 23 { "integer" } else if o == 25 { "text" } else if o == 1700 { "numeric" } else { o.toStr() }
        }
        Err(e) { return e.state }
    }
}

fn opts(): lexdb_store.Options {
    return lexdb_store.Options{cacheBytes: 256 * 1024, segBytes: 1024 * 1024, ckptBytes: 512 * 1024, snapNodes: 100000, bufferedPages: false}
}

fn main() {
    let fs = lexdb_disk.sim(36)
    lexdb_store.run(fs, opts(), fn(st: lexdb_store.Store): int {
        lexdb_exec.bootstrap(&st).unwrap()
        var s = lexdb_exec.newSession(st)
        let c1 = q(mut &s, &"create table r (id int primary key, n int, s text, v varchar(5), m numeric(6,2), b bool)")
        let i1 = q(mut &s, &"insert into r values (1, 10, '5', 'abcde', 1.25, true), (2, 2, '0', 'xy', 2.5, false), (3, 30, '7', null, -0.05, null)")
        let x1 = q(mut &s, &"create index r_n on r (n)")
        let x2 = q(mut &s, &"create unique index r_v on r (v)")
        let x3 = q(mut &s, &"create index r_f on r (id) where n > 5")

        println("widened: " + alter(&st, mut &s, &"alter table r alter column n type bigint") + ", " +
                q(mut &s, &"select id, n, s, v, m from r where id = 1"))
        println("to text: " + alter(&st, mut &s, &"alter table r alter n type text") + ", " + q(mut &s, &"select n from r order by n") +
                " by text order, by the index: " + q(mut &s, &"select id from r where n = '2'") + ", " + plan(mut &s, &"select id from r where n = '2'", &"r_n"))
        let na = state(mut &s, &"alter table r alter n type int")
        let nb = state(mut &s, &"alter table r alter b type int")
        let bt = q(mut &s, &"alter table r alter b type text")
        println("no automatic cast: " + na + "; bool: " + nb + ", to text: " + bt + " " + q(mut &s, &"select b from r where id = 1"))
        println("with USING: " + q(mut &s, &"alter table r alter n type int using n::int") + ", " + q(mut &s, &"select n from r order by n") +
                ", by the index: " + q(mut &s, &"select id from r where n = 2"))
        let u1 = q(mut &s, &"update r set s = 'xy' where id = 2")
        println("bad values: " + state(mut &s, &"alter table r alter s type int using s::int") + ", all rows as before: " +
                q(mut &s, &"select n, coalesce(v, s) from r order by id"))
        let u2 = q(mut &s, &"update r set s = '0' where id = 2")
        println("shorter varchar: " + state(mut &s, &"alter table r alter v type varchar(3)") + "; longer: " +
                alter(&st, mut &s, &"alter table r alter v type varchar(10)"))

        let m1 = q(mut &s, &"alter table r alter m type numeric(4,1)")
        let mv1 = q(mut &s, &"select m from r order by id")
        let m2 = q(mut &s, &"alter table r alter m type int")
        let mv2 = q(mut &s, &"select m from r order by id")
        println("numeric: " + m1 + " " + mv1 + ", to int: " + m2 + " " + mv2 + ", overflow: " + state(mut &s, &"alter table r alter n type numeric(2,1)"))

        // the key
        let k1 = q(mut &s, &"create table k (id int primary key, w text)")
        let k2 = q(mut &s, &"insert into k values (1, 'a'), (2, 'b'), (10, 'c')")
        let k3 = q(mut &s, &"create index k_w on k (w)")
        let ka = alter(&st, mut &s, &"alter table k alter id type text")
        let kv = q(mut &s, &"select id from k order by id")
        let kk = q(mut &s, &"select id from k where id = '10'") + ", by k_w: " + q(mut &s, &"select id from k where w = 'c'") + " (" +
                 plan(mut &s, &"select id from k where w = 'c'", &"k_w") + ")"
        let kb = q(mut &s, &"alter table k alter id type int using id::int")
        println("the key: " + ka + ", " + kv + " by text order, by key: " + kk + ", then int again: " + kb + " " +
                q(mut &s, &"select id from k where w >= 'a' order by id"))
        let k4 = q(mut &s, &"create table k2 (id text primary key)")
        let k5 = q(mut &s, &"insert into k2 values ('1'), ('01')")
        println("the key made equal: " + state(mut &s, &"alter table k2 alter id type int using id::int"))
        let u3 = q(mut &s, &"create table u (id int primary key, v text)")
        let u4 = q(mut &s, &"insert into u values (1, 'a'), (2, 'A')")
        let u5 = q(mut &s, &"create unique index u_v on u (v)")
        println("a unique index made equal: " + q(mut &s, &"alter table u alter v type text using lower(v)"))
        // a filtered index whose predicate holds other rows under the new type
        let f1 = q(mut &s, &"create table f (id int primary key, s text)")
        let f2 = q(mut &s, &"insert into f values (1, '10'), (2, '9')")
        let f3 = q(mut &s, &"create index f_f on f (id) where s > '5'")
        let fb = q(mut &s, &"select id from f where s > '5' and id > 0")
        let f4 = q(mut &s, &"alter table f alter s type int using s::int")
        println("a filtered index: " + fb + " as text, " + q(mut &s, &"select id from f where s > '5' and id > 0") + " as int (" +
                plan(mut &s, &"select id from f where s > '5' and id > 0", &"f_f") + ")")
        let nn = q(mut &s, &"create table nn (id int primary key, x text not null)")
        let nn1 = q(mut &s, &"insert into nn values (1, 'a')")
        println("not null kept: " + state(mut &s, &"alter table nn alter x type int using null"))
        let o1 = q(mut &s, &"alter table u alter v type text using id::text || ':' || lower(v)")
        println("using other columns: " + q(mut &s, &"select v from u order by id"))

        // two at once (m is int now, n int)
        let t2 = q(mut &s, &"alter table r alter n type bigint, alter column m set data type numeric(8,2) using coalesce(m, 0) + n % 3")
        println("two at once: " + typeOf(mut &s, &"select n from r") + " " + typeOf(mut &s, &"select m from r") + ", " + q(mut &s, &"select n, m from r order by id"))

        // a table with large values: the rewrite moves them with their rows
        let l1 = q(mut &s, &"create table l (id int primary key, n int, body text)")
        let l2 = q(mut &s, &("insert into l values (1, 1, '" + strings.repeat("z", 5996) + "tail'), (2, 2, '" + strings.repeat("y", 6000) + "')"))
        println("large values: " + q(mut &s, &"select length(body) from l order by id") + " " + q(mut &s, &"select right(body, 4) from l where id = 1") + ", " +
                alter(&st, mut &s, &"alter table l alter n type text"))

        let bg = q(mut &s, &"begin")
        let rt = q(mut &s, &"alter table k alter id type bigint")
        let rb = q(mut &s, &"rollback")
        println("rolled back: " + typeOf(mut &s, &"select id from k"))
        return 0
    }).unwrap()

    lexdb_store.run(fs, opts(), fn(st: lexdb_store.Store): int {
        var s = lexdb_exec.newSession(st)
        println("reopened: " + q(mut &s, &"select n, m from r order by id") + ", " + typeOf(mut &s, &"select n from r") +
                ", by the index: " + q(mut &s, &"select id from r where n = 2"))
        return 0
    }).unwrap()
}
