// lexdb_exec: statements that ended the server (a Decimal operator given a result of more than 38 digits,
// design/lexdb-new-features.md 10) and now give PostgreSQL's answer: an interval times a numeric of 38 digits (in a
// select list, INSERT ... SELECT of 3,000 rows, UPDATE ... RETURNING, sum and avg), interval text with such a number of
// hours, days, weeks, months and years (and a year's fraction as whole months), SET TIME ZONE of such hours,
// width_bucket and div of 38-digit values, random(min, max) past an integer's span (22003). Checked against
// PostgreSQL 19 (generated by tests/lexdb/gen_pg.py from decfit_queries.txt). Each answer: the columns' names and the
// rows, or the tag, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off and on.
// expect: CREATE TABLE
// expect: INSERT 0 3000
// expect: same: n|lo|hi|nd: 3000|07:40:12.351158|2 years 6 mons 58 days 18:19:04.369089|3000
// expect: same: id|x|iv: 1|0.01030927835051546392|07:40:12.351158;2|0.02061855670103092784|15:20:24.788718;97|1.00000000000000000000|1 mon 1 day 00:00:01;1000|10.3092783505154639|10 mons 19 days 14:06:21.485163;3000|30.9278350515463918|2 years 6 mons 58 days 18:19:04.369089
// expect: same: a|b|c: 1 mon 8 days 06:31:07.897075|1 day 05:37:46.665707|01:14:04.444404
// expect: same: a|b|c: 24 days 07:12:00|3 days 04:00:00|-1 mons -7 days -00:53:21.231368
// expect: same: id|a|b: 1|00:15:27.835051|07:25:21.6192;2|00:30:55.670103|14:50:43.3248;3000|30 days 53:11:45.15464|2 years 6 mons 27 days 20:02:28.4928
// expect: same: s|a: 3 days 17:37:46.665707|00:00:01.867284
// expect: same: s|m: 46407:12:59.381442|00:30:55.670103
// expect: same: iv: 1 day 05:37:46.665707
// expect: same: id|iv: 1|09:28:09.32211;2|18:56:18.75089;3|28:24:28.073001
// expect: same: a|b|c|d: 01:14:04.444404|1 day 05:37:46.665707|8 days 15:24:26.659947|00:01:14.074073
// expect: same: a|b|c|d: 1 mon 7 days 00:53:19.9712|1 year 3 mons|123 years 5 mons|-1 days -01:14:04.444404
// expect: same: a|b|c|d: 01:14:04.444404|24:00:00|1 year|3 mons 15 days
// expect: same: a|b|c|d|e|f|g: 1 year|1 mon 15 days|5 years|100 years 1 mon|1 mon|1 year 7 mons 15 days|-1 years
// expect: SET
// expect: same: t: 2024-03-05 11:14:04+01:14:04
// expect: SET
// expect: same: t: 2024-03-05 08:45:56-01:14:04
// expect: SET
// expect: same: a|b|c: 1|1|100
// expect: same: b|n: 1|428;2|428;3|428;4|428;5|428;6|429;7|428;8|3
// expect: same: a|b|c|d|e|f: 17636684144620811271604938270017636682|-17636684144620811271604938270017636682|1763668414462081127160493827001763668|33333333333333333333333333333333333333|3|-3
// expect: same: id|d: 1|14727;2|29455;3000|44182621
// expect: same: ERROR 22003
// expect: same: a|b|c|d: t|3|5.5|-1000000000000000000000000000000
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table dq (id int primary key, x numeric, iv interval)\n@once insert into dq select i, i::numeric / 97, interval '1 month 1 day 1 second' * (i::numeric / 97) from generate_series(1, 3000) i\nselect count(*) n, min(iv) lo, max(iv) hi, count(distinct iv) nd from dq\nselect id, x, iv from dq where id in (1, 2, 97, 1000, 3000) order by id\nselect interval '1 month 1 day 1 second' * 1.2345678901234567890123456789012345678 a, interval '1 day' * 1.2345678901234567890123456789012345678 b, 1.2345678901234567890123456789012345678 * interval '1 hour' c\nselect interval '1 month' / 1.2345678901234567890123456789012345678 a, interval '3 days 4 hours' * 0.99999999999999999999999999999999999999 b, interval '-1 month -1 second' * 1.2345678901234567890123456789012345678 c\nselect id, interval '1 day 1 hour' * x a, x * interval '1 month' b from dq where id in (1, 2, 3000) order by id\nselect sum(interval '1 day' * x) s, avg(interval '1 second' * x) a from (values (1.2345678901234567890123456789012345678), (2.5)) v(x)\nselect sum(interval '1 hour' * x) s, max(interval '1 minute' * x) m from dq\n@tx insert into dq values (0, 1.2345678901234567890123456789012345678, interval '1 day' * 1.2345678901234567890123456789012345678) returning iv\n@tx update dq set iv = iv * 1.2345678901234567890123456789012345678 where id <= 3 returning id, iv\nselect '1.2345678901234567890123456789012345678 hours'::interval a, '1.2345678901234567890123456789012345678 days'::interval b, '1.2345678901234567890123456789012345678 weeks'::interval c, '1.2345678901234567890123456789012345678 minutes'::interval d\nselect '1.2345678901234567890123456789012345678 months'::interval a, '1.2345678901234567890123456789012345678 years'::interval b, '1.2345678901234567890123456789012345678 centuries'::interval c, '1 day 1.2345678901234567890123456789012345678 hours ago'::interval d\nselect interval '1.2345678901234567890123456789012345678 hours' a, '0.99999999999999999999999999999999999999 days'::interval b, '0.99999999999999999999999999999999999999 years'::interval c, '2.5 months 0.0625 years'::interval d\nselect '1.01 years'::interval a, '1.5 months'::interval b, '0.5 decades'::interval c, '1.001 centuries'::interval d, '0.0001 millennium'::interval e, '1.5 years 1.5 months'::interval f, '-1.01 years'::interval g\n@once set time zone '1.2345678901234567890123456789012345678'\nselect timestamptz '2024-03-05 10:00:00+00' t\n@once set time zone '-1.2345678901234567890123456789012345678'\nselect timestamptz '2024-03-05 10:00:00+00' t\n@once set time zone 'UTC'\nselect width_bucket(12345678901234567890123456789012345678, 0.1, 99999999999999999999999999999999999999, 5) a, width_bucket(5, 0.0000000000000000000000000000000000001, 12345678901234567890123456789012345678, 3) b, width_bucket(1e36, 0.3, 9999999999999999999999999999999999999.5, 1000) c\nselect width_bucket(x, 0.0000000000000000000000000000000000001, 30.9, 7) b, count(*) n from dq group by 1 order by 1\nselect div(12345678901234567890123456789012345678, 0.7) a, div(-12345678901234567890123456789012345678, 0.7) b, div(1.2345678901234567890123456789012345678, 0.0000000000000000000000000000000000007) c, div(1e37, 0.3) d, div(7, 2) e, div(-7.5, 2) f\nselect id, div(x * 1000000, 0.7) d from dq where id in (1, 2, 3000) order by id\nselect random(1e-30000, 1e30000)\nselect random(1, 1e30) between 1 and 1e30 a, scale(random(0.001, 12345678901234567890123456789012345)) b, random(5.5, 5.5) c, random(-1e30, -1e30) d"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(151), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
