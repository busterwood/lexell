// The fuzzer's long run (design/lexdb-fuzz.md), each statement against PostgreSQL 18's answer, with SET lexdb_batch = off
// and on (in a transaction rolled back each time).
// - W7: a correlated EXISTS, IN or NOT EXISTS hashed on its key with a filter checked per candidate (another outer
//   table's value) that reads the key's column too: the column was not output for the filter (read as NULL: no row).
// - W8: MIN or MAX read as the first value of an index's order also with a HAVING (whose aggregates are every row's).
// - O: smallint and integer arithmetic (+ - * /, unary minus, abs) of the wider type (two smallints a smallint), past
//   its range 22003, in the select list, WHERE, a later batch, an aggregate's argument, GROUP BY, a join, a correlated
//   subquery, UPDATE (into an integer, a smallint and a bigint column), an expression index; NULLs; bigint unchanged.
// - L: COALESCE evaluates its arguments up to the first not NULL (an error after it is never raised): constants,
//   columns, a subquery, three arguments, over batches, in WHERE and aggregates; a NULL first still reaches the error.
//   (PostgreSQL folds a constant 1 / 0 when it plans, so the errors here are a row's.)
// - Q: an integer compared with ANY / ALL of numerics or floats (a subquery's, an array's) as numbers, not each made a
//   bigint (22P02 before).
// - P: chars of different lengths in one column ('a  ' and 'a    ', a union's or a CASE's) are one value in GROUP BY
//   and DISTINCT (bpchar's =); a column of one char(n) as before.
// - S: a set-returning function in the select list makes its rows before DISTINCT, ORDER BY and LIMIT (PostgreSQL's
//   ProjectSet).
// - W12: a FROM subquery hashed on a key whose kind differs from its probe's (a float beside an integer or a numeric, a
//   date beside a timestamp) matched nothing: the subquery's rows are hashed by their values as they are.
// - W14: a correlated EXISTS, NOT EXISTS, IN or scalar subquery whose FROM has a LATERAL over its own tables, run once
//   and hashed on its key, found no rows: such a subquery is run per row (as E1's).
// - W15: x IN (a correlated subquery) looked up per row by the subquery's column (optimizer 50, 5c) through a filtered
//   index whose predicate the query does not imply missed the rows outside it.
// expect: W7 EXISTS, a filter on the key and another table: 3003, same: true
// expect: W7 EXISTS, the same outer table: 1072|1611426, same: true
// expect: W7 IN: 860|1289159, same: true
// expect: W7 NOT EXISTS: 859|1572149, same: true
// expect: W7 texts, two tables: a%b|a%b;a%b|a%b;a%b|a%b;a%b|a%b;a%b|zz;a%b|zz;zz|zz, same: true
// expect: W8 HAVING count(*): , same: true
// expect: W8 HAVING bool_and: , same: true
// expect: W8 HAVING the same MIN: 1, same: true
// expect: W8 HAVING true: 3000, same: true
// expect: O x * 7919, fits: 291862664000|2146049000, same: true
// expect: O x * 7919, a later row: ERROR 22003, same: true
// expect: O x * 7919, a later batch: ERROR 22003, same: true
// expect: O +: ERROR 22003, same: true
// expect: O -: ERROR 22003, same: true
// expect: O unary minus: ERROR 22003, same: true
// expect: O unary minus fits: -2147483647|-32767, same: true
// expect: O abs: ERROR 22003, same: true
// expect: O abs of a smallint: ERROR 22003, same: true
// expect: O / -1: ERROR 22003, same: true
// expect: O % -1: 0|-1073741824, same: true
// expect: O smallint + smallint: ERROR 22003, same: true
// expect: O smallint * integer fits: 65534|32768|32767, same: true
// expect: O types: smallint|smallint|smallint|smallint|smallint|smallint|integer|integer|bigint|integer|integer, same: true
// expect: O WHERE: ERROR 22003, same: true
// expect: O NULLs: 0|0|0, same: true
// expect: O GROUP BY: 0|1000|3003000;1|1000|2999000;2|1000|3001000, same: true
// expect: O a join: 9, same: true
// expect: O correlated: ERROR 22003, same: true
// expect: O correlated fits: 2000000000, same: true
// expect: O UPDATE an integer: ERROR 22003, same: true
// expect: O UPDATE fits: 1001, same: true
// expect: O UPDATE a smallint: ERROR 22003, same: true
// expect: O UPDATE a bigint: ERROR 22003, same: true
// expect: O UPDATE a bigint fits: 3000000000, same: true
// expect: O bigint: 6000|3003000, same: true
// expect: O an expression index: 1|4, same: true
// expect: L a constant first: 1, same: true
// expect: L a column first: 1;2;3, same: true
// expect: L a NULL first: ERROR 22012, same: true
// expect: L a subquery after: 1, same: true
// expect: L three arguments: 5|3, same: true
// expect: L over batches: 4506001500, same: true
// expect: L in WHERE, reached: ERROR 22012, same: true
// expect: L an aggregate's argument: 3000, same: true
// expect: Q = ALL, < ANY of a subquery: f|t|f|t, same: true
// expect: Q arrays: t|t|t|f, same: true
// expect: Q a column: 1|t|f;2|NULL|t, same: true
// expect: P GROUP BY a union of char(3) and char(5): |2;a|4;ab|2;b|2;NULL|2, same: true
// expect: P DISTINCT: 5, same: true
// expect: P count(DISTINCT): 4|12, same: true
// expect: P DISTINCT of a CASE: 5, same: true
// expect: P GROUP BY a CASE: |1;a|2;ab|1;b|1;NULL|1, same: true
// expect: P a column:      |1;a    |2;ab   |1;b    |1;NULL|1, same: true
// expect: P DISTINCT of a column:    ;a  ;ab ;b  ;NULL, same: true
// expect: S DISTINCT unnest: 1;2, same: true
// expect: S DISTINCT unnest, no ORDER BY: 2, same: true
// expect: S ORDER BY unnest: 3;2;1, same: true
// expect: S ORDER BY a name, LIMIT: 1;2, same: true
// expect: S over a table: 0;1;2;7, same: true
// expect: S over a table, ORDER BY two: 1|0;2|0;3|0, same: true
// expect: W12 a float = an integer: 2, same: true
// expect: W12 an integer = a float: 2, same: true
// expect: W12 a float = a numeric: 3, same: true
// expect: W12 a numeric = a float: 3, same: true
// expect: W12 a date = a timestamp: 3, same: true
// expect: W12 an integer = a numeric, hashed: 2|2, same: true
// expect: W12 a float = an integer over a join: 0|0;2|2, same: true
// expect: W14 EXISTS: 1|t;2|t;3|t;4|f, same: true
// expect: W14 NOT EXISTS in WHERE: 4, same: true
// expect: W14 a scalar count: 1|2;2|1;3|1;4|0, same: true
// expect: W14 IN: 1;2, same: true
// expect: W14 IN, not correlated: 1;2;4, same: true
// expect: W14 = ANY, not correlated: 2;3, same: true
// expect: W14 NOT IN, not correlated: 3;4, same: true
// expect: W15 IN through a filtered index: bb|bb;cc|cc, same: true
// expect: W15 NOT IN: 7, same: true
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_ops"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            var out: []str = []
            for r in rs {
                for row in r.rows {
                    var vs: []str = []
                    for k in 0..len(row) { append(mut &vs, if lexdb_ops.isNull(&row[k]) { "NULL" } else { s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 }) }) }
                    append(mut &out, strings.join(&vs, "|"))
                }
            }
            return strings.join(&out, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// each statement with the row engine and with batches, in a transaction rolled back
fn two(s: mut &lexdb_exec.Session, label: &str, sql: &str) {
    let x = q(s, &"set lexdb_batch = off")
    let b0 = q(s, &"begin")
    let off = q(s, sql)
    let r0 = q(s, &"rollback")
    let y = q(s, &"set lexdb_batch = on")
    let b1 = q(s, &"begin")
    let on = q(s, sql)
    let r1 = q(s, &"rollback")
    println(label + ": " + on + ", same: " + (off == on).toStr())
}

const SETUP = "create table s0 (id int primary key, a text, b int)\ninsert into s0 values (1, 'a%b', 5), (2, 'zz', 1), (3, NULL, NULL), (4, 'a%b', 0)\ninsert into s0 select i, 'r' || (i % 50), i % 7 from generate_series(5, 3000) i\nanalyze\ncreate table o0 (id int primary key, x int, s smallint, b bigint)\ninsert into o0 select i, i * 1000, (i % 30000)::smallint, i from generate_series(1, 3000) i\ninsert into o0 values (3001, 2147483647, 32767, 9223372036854775807), (3002, -2147483648, -32768, -9223372036854775807), (3003, NULL, NULL, NULL)\ncreate table o1 (x int, y int)\ninsert into o1 select i, i from generate_series(1, 1000) i\ncreate index o1_i on o1 ((x + 1))\ncreate table p0 (id int, c3 char(3), c5 char(5))\ninsert into p0 values (1, 'a', 'a'), (2, 'ab', 'ab  '), (3, 'b', 'a'), (4, NULL, NULL), (5, 'a', 'b'), (6, '', '')\ncreate table h0 (i int, n numeric(6,2), x float8, d date)\ninsert into h0 values (0, 0, 0, '2024-01-01'), (2, 2, 2, '2024-01-02'), (NULL, NULL, NULL, NULL), (3, 3.5, 3.5, '2024-01-03')\ncreate table e0 (id int, a0 text, a5 int)\ninsert into e0 values (1, 'a', 1), (2, 'b', 2), (3, 'b', NULL), (4, NULL, 1)\ncreate table j0 (a0 text, a1 text, a2 int)\ninsert into j0 values ('bb', 'bb', NULL), ('cc', 'cc', 5), ('dd', 'cc', 1)\ncreate index j0_i0 on j0 (a1, a2) where a2 > 2\ncreate index j0_i1 on j0 (a1, a0)"

const QS = "W7 EXISTS, a filter on the key and another table	select count(*) from s0 as q1 cross join (select * from s0 where id < 5) as q2 where exists (select 1 from s0 as q3 where q3.a = q1.a and q3.a <= q2.a)\nW7 EXISTS, the same outer table	select count(*), sum(q1.id) from s0 as q1 where exists (select 1 from s0 as q3 where q3.b = q1.b and q3.b <= q1.id % 4)\nW7 IN	select count(*), sum(q1.id) from s0 as q1 where q1.b in (select q3.b from s0 as q3 where q3.b = q1.b and q3.b < q1.id % 5)\nW7 NOT EXISTS	select count(*), sum(q1.id) from s0 as q1 where not exists (select 1 from s0 as q3 where q3.b = q1.b and q3.b * 1000 > q1.id)\nW7 texts, two tables	select q1.a, q2.a from s0 as q1 cross join s0 as q2 where q1.id < 5 and q2.id < 5 and exists (select 1 from s0 as q3 where q3.a = q1.a and q3.a <= q2.a and q3.id < 5) order by 1, 2\nW8 HAVING count(*)	select min(id) from s0 having count(*) > 5000\nW8 HAVING bool_and	select max(id) from s0 having bool_and(id < 100)\nW8 HAVING the same MIN	select min(id) from s0 having min(id) > 0\nW8 HAVING true	select max(id) from s0 having count(*) > 5\nO x * 7919, fits	select sum(x * 7919), max(x * 7919) from o0 where id <= 271\nO x * 7919, a later row	select max(x * 7919) from o0\nO x * 7919, a later batch	select count(*) from o0 where id > 2000 and x * 7919 > 0\nO +	select x + 1 from o0 where id = 3001\nO -	select x - 1 from o0 where id = 3002\nO unary minus	select -x from o0 where id = 3002\nO unary minus fits	select -x, -s from o0 where id = 3001\nO abs	select abs(x) from o0 where id = 3002\nO abs of a smallint	select abs(s) from o0 where id = 3002\nO / -1	select x / -1 from o0 where id = 3002\nO % -1	select x % -1, x / 2 from o0 where id = 3002\nO smallint + smallint	select s + s from o0 where id = 3001\nO smallint * integer fits	select s * 2, s + 1, -(-s) from o0 where id = 3001\nO types	select pg_typeof(s + s), pg_typeof(s - s), pg_typeof(s * s), pg_typeof(s / s), pg_typeof(-s), pg_typeof(abs(s)), pg_typeof(s + 1), pg_typeof(s + x), pg_typeof(s + b), pg_typeof(x * x), pg_typeof(abs(x)) from o0 where id = 1\nO WHERE	select count(*) from o0 where x * 2 > 0\nO NULLs	select count(x * 2), count(-s), count(abs(x)) from o0 where id = 3003\nO GROUP BY	select x / 1000 % 3 as k, count(*), sum(s + s) from o0 where id <= 3000 group by 1 order by 1\nO a join	select count(*) from o0 as a join o0 as c on c.id = a.id + 1 where a.id < 10\nO correlated	select (select o2.x * 1000 from o0 as o2 where o2.id = o0.id) from o0 where id = 3000\nO correlated fits	select (select o2.x * 1000 from o0 as o2 where o2.id = o0.id) from o0 where id = 2000\nO UPDATE an integer	update o0 set x = x + 1 where id = 3001\nO UPDATE fits	update o0 set x = x + 1 where id = 1 returning x\nO UPDATE a smallint	update o0 set s = s + 1 where id = 3001\nO UPDATE a bigint	update o0 set b = x * 1000000 where id = 3000\nO UPDATE a bigint fits	update o0 set b = b * 1000000 where id = 3000 returning b\nO bigint	select b * 2, b + x from o0 where id = 3000\nO an expression index	select count(*), min(y) from o1 where x + 1 = 5\nL a constant first	select coalesce(1, 1 / 0)\nL a column first	select coalesce(id, 1 / (id - id)) from o0 where id < 4 order by 1\nL a NULL first	select coalesce(x, 1 / (id - id)) from o0 where id = 3003\nL a subquery after	select coalesce(id, (select 1 / (o2.id - o2.id) from o0 as o2 where o2.id = 1)) from o0 where id = 1\nL three arguments	select coalesce(null, s, 1 / (id - id)), coalesce(null::int, null, 3) from o0 where id = 5\nL over batches	select sum(coalesce(x, 0) + coalesce(s, 1 / (id - id))) from o0 where id <= 3000\nL in WHERE, reached	select count(*) from o0 where coalesce(x, 1 / (id - id)) > 0\nL an aggregate's argument	select max(coalesce(b, 1 / (id - id))) from o0 where id <= 3000\nQ = ALL, < ANY of a subquery	select 1 = all (select 1.5), 1 < any (select 1.5), 2 > all (select 1.5 union select 2.5), 1 = all (select 1.0)\nQ arrays	select 1 = any (array[1.5, 1]), 3 = any (array[1.5, 3.0]), 2 > all (array[1.5::float8, 0.5]), 2 <> all (array[2.0, null])\nQ a column	select id, x = any (array[1000.0, null]), x >= all (select 1999.5) from o0 where id in (1, 2) order by id\nP GROUP BY a union of char(3) and char(5)	select rtrim(x), count(*) from (select c3 as x from p0 union all select c5 from p0) as d group by x order by 1\nP DISTINCT	select count(*) from (select distinct x from (select c3 as x from p0 union all select c5 from p0) as d) as e\nP count(DISTINCT)	select count(distinct x), count(*) from (select c3 as x from p0 union all select c5 from p0) as d\nP DISTINCT of a CASE	select count(*) from (select distinct case when id % 2 = 0 then c3 else c5 end as x from p0) as d\nP GROUP BY a CASE	select rtrim(x), count(*) from (select case when id % 2 = 0 then c3 else c5 end as x from p0) as d group by x order by 1\nP a column	select c5, count(*) from p0 group by c5 order by 1\nP DISTINCT of a column	select distinct c3 from p0 order by 1\nS DISTINCT unnest	select distinct unnest(array[2, 1, 2]) order by 1\nS DISTINCT unnest, no ORDER BY	select count(*) from (select distinct unnest(array[1, 1, 2]) as u) as d\nS ORDER BY unnest	select unnest(array[3, 1, 2]) order by 1 desc\nS ORDER BY a name, LIMIT	select unnest(array[3, 1, 2]) as u order by u limit 2\nS over a table	select distinct unnest(array[id % 3, 7]) as u from p0 order by u\nS over a table, ORDER BY two	select id, unnest(array[id, 0]) as u from p0 order by u, id limit 3\nW12 a float = an integer	select count(*) from h0 as a, (select cast(n as float8) as f from h0) as d where d.f = a.i\nW12 an integer = a float	select count(*) from h0 as a, (select i from h0) as d where d.i = a.x\nW12 a float = a numeric	select count(*) from h0 as a, (select x from h0) as d where d.x = a.n\nW12 a numeric = a float	select count(*) from h0 as a, (select n from h0) as d where d.n = a.x\nW12 a date = a timestamp	select count(*) from h0 as a, (select d from h0) as d2 where d2.d = a.d::timestamp\nW12 an integer = a numeric, hashed	select count(*), sum(a.i) from h0 as a, (select i from h0) as d where d.i = a.n\nW12 a float = an integer over a join	select a.i, d.f from h0 as a join (select cast(n as float8) as f from h0) as d on d.f = a.i order by 1\nW14 EXISTS	select id, exists (select 1 from e0 as q2 join lateral (select 1 as x8 from e0 as q4 where q4.a5 = q2.a5) as l3 on true where q2.a0 = q1.a0) from e0 as q1 order by id\nW14 NOT EXISTS in WHERE	select id from e0 as q1 where not exists (select 1 from e0 as q2 join lateral (select 0.5::float8 as x8 from e0 as q4 where q4.a5 = q2.a5) as l3 on true where q2.a0 = q1.a0) order by id\nW14 a scalar count	select id, (select count(*) from e0 as q2 join lateral (select q4.id from e0 as q4 where q4.a5 = q2.a5) as l3 on true where q2.a0 = q1.a0) from e0 as q1 order by id\nW14 IN	select id from e0 as q1 where q1.a5 in (select l3.x from e0 as q2 join lateral (select q4.a5 as x from e0 as q4 where q4.id = q2.id) as l3 on true where q2.a0 = q1.a0) order by id\nW14 IN, not correlated	select id from e0 as q1 where q1.a5 in (select l3.x from e0 as q2 join lateral (select q4.a5 as x from e0 as q4 where q4.id = q2.id) as l3 on true) order by id\nW14 = ANY, not correlated	select id from e0 as q1 where q1.id = any (select l3.x + 1 from e0 as q2 join lateral (select q4.a5 as x from e0 as q4 where q4.id = q2.id) as l3 on true) order by id\nW14 NOT IN, not correlated	select id from e0 as q1 where q1.id not in (select l3.x from e0 as q2 join lateral (select q4.a5 as x from e0 as q4 where q4.id = q2.id and q4.a5 is not null) as l3 on true) order by id\nW15 IN through a filtered index	select q1.a0, q2.a0 from j0 as q1, j0 as q2 where q2.a0 in (select q3.a1 from j0 as q3 where q3.a1 = q1.a0) order by 1, 2\nW15 NOT IN	select count(*) from j0 as q1, j0 as q2 where q2.a0 not in (select q3.a1 from j0 as q3 where q3.a1 = q1.a0)"

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let setup: str = SETUP
    for l in strings.lines(&setup) {
        let o = q(mut &s, &l)
        if strings.startsWith(&o, "ERROR") { println(l + ": " + o) }
    }
    let qs: str = QS
    for l in strings.lines(&qs) {
        let parts = strings.split(&l, "\t")
        two(mut &s, &parts[0], &parts[1])
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(98), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 4 * 1024 * 1024, ckptBytes: 2 * 1024 * 1024,
                                                           snapNodes: 100000}, body).unwrap()
}
