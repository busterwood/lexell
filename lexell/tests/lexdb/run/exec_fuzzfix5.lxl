// The fuzzer's long run (design/lexdb-fuzz.md), each statement against PostgreSQL 18's answer, with SET lexdb_batch = off
// and on (in a transaction rolled back each time).
// - O: smallint and integer arithmetic (+ - * /, unary minus, abs) of the wider type (two smallints a smallint), past
//   its range 22003, in the select list, WHERE, a later batch, an aggregate's argument, GROUP BY, a join, a correlated
//   subquery, UPDATE (into an integer, a smallint and a bigint column), an expression index; NULLs; bigint unchanged.
// - L: COALESCE evaluates its arguments up to the first not NULL (an error after it is never raised): constants,
//   columns, a subquery, three arguments, over batches, in WHERE and aggregates; a NULL first still reaches the error.
//   (PostgreSQL folds a constant 1 / 0 when it plans, so the errors here are a row's.)
// - Q: an integer compared with ANY / ALL of numerics or floats (a subquery's, an array's) as numbers, not each made a
//   bigint (22P02 before).
// expect: O x * 7919, fits: 291862664000|2146049000, same: true
// expect: O x * 7919, a later row: ERROR 22003, same: true
// expect: O x * 7919, a later batch: ERROR 22003, same: true
// expect: O +: ERROR 22003, same: true
// expect: O -: ERROR 22003, same: true
// expect: O unary minus: ERROR 22003, same: true
// expect: O unary minus fits: -2147483647|-32767, same: true
// expect: O abs: ERROR 22003, same: true
// expect: O abs of a smallint: ERROR 22003, same: true
// expect: O / -1: ERROR 22003, same: true
// expect: O % -1: 0|-1073741824, same: true
// expect: O smallint + smallint: ERROR 22003, same: true
// expect: O smallint * integer fits: 65534|32768|32767, same: true
// expect: O types: smallint|smallint|smallint|smallint|smallint|smallint|integer|integer|bigint|integer|integer, same: true
// expect: O WHERE: ERROR 22003, same: true
// expect: O NULLs: 0|0|0, same: true
// expect: O GROUP BY: 0|1000|3003000;1|1000|2999000;2|1000|3001000, same: true
// expect: O a join: 9, same: true
// expect: O correlated: ERROR 22003, same: true
// expect: O correlated fits: 2000000000, same: true
// expect: O UPDATE an integer: ERROR 22003, same: true
// expect: O UPDATE fits: 1001, same: true
// expect: O UPDATE a smallint: ERROR 22003, same: true
// expect: O UPDATE a bigint: ERROR 22003, same: true
// expect: O UPDATE a bigint fits: 3000000000, same: true
// expect: O bigint: 6000|3003000, same: true
// expect: O an expression index: 1|4, same: true
// expect: L a constant first: 1, same: true
// expect: L a column first: 1;2;3, same: true
// expect: L a NULL first: ERROR 22012, same: true
// expect: L a subquery after: 1, same: true
// expect: L three arguments: 5|3, same: true
// expect: L over batches: 4506001500, same: true
// expect: L in WHERE, reached: ERROR 22012, same: true
// expect: L an aggregate's argument: 3000, same: true
// expect: Q = ALL, < ANY of a subquery: f|t|f|t, same: true
// expect: Q arrays: t|t|t|f, same: true
// expect: Q a column: 1|t|f;2|NULL|t, same: true
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"
import "../../../cmd/lexdb_ops"

fn q(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            var out: []str = []
            for r in rs {
                for row in r.rows {
                    var vs: []str = []
                    for k in 0..len(row) { append(mut &vs, if lexdb_ops.isNull(&row[k]) { "NULL" } else { s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 }) }) }
                    append(mut &out, strings.join(&vs, "|"))
                }
            }
            return strings.join(&out, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// each statement with the row engine and with batches, in a transaction rolled back
fn two(s: mut &lexdb_exec.Session, label: &str, sql: &str) {
    let x = q(s, &"set lexdb_batch = off")
    let b0 = q(s, &"begin")
    let off = q(s, sql)
    let r0 = q(s, &"rollback")
    let y = q(s, &"set lexdb_batch = on")
    let b1 = q(s, &"begin")
    let on = q(s, sql)
    let r1 = q(s, &"rollback")
    println(label + ": " + on + ", same: " + (off == on).toStr())
}

const SETUP = "create table o0 (id int primary key, x int, s smallint, b bigint)\ninsert into o0 select i, i * 1000, (i % 30000)::smallint, i from generate_series(1, 3000) i\ninsert into o0 values (3001, 2147483647, 32767, 9223372036854775807), (3002, -2147483648, -32768, -9223372036854775807), (3003, NULL, NULL, NULL)\ncreate table o1 (x int, y int)\ninsert into o1 select i, i from generate_series(1, 1000) i\ncreate index o1_i on o1 ((x + 1))"

const QS = "O x * 7919, fits	select sum(x * 7919), max(x * 7919) from o0 where id <= 271\nO x * 7919, a later row	select max(x * 7919) from o0\nO x * 7919, a later batch	select count(*) from o0 where id > 2000 and x * 7919 > 0\nO +	select x + 1 from o0 where id = 3001\nO -	select x - 1 from o0 where id = 3002\nO unary minus	select -x from o0 where id = 3002\nO unary minus fits	select -x, -s from o0 where id = 3001\nO abs	select abs(x) from o0 where id = 3002\nO abs of a smallint	select abs(s) from o0 where id = 3002\nO / -1	select x / -1 from o0 where id = 3002\nO % -1	select x % -1, x / 2 from o0 where id = 3002\nO smallint + smallint	select s + s from o0 where id = 3001\nO smallint * integer fits	select s * 2, s + 1, -(-s) from o0 where id = 3001\nO types	select pg_typeof(s + s), pg_typeof(s - s), pg_typeof(s * s), pg_typeof(s / s), pg_typeof(-s), pg_typeof(abs(s)), pg_typeof(s + 1), pg_typeof(s + x), pg_typeof(s + b), pg_typeof(x * x), pg_typeof(abs(x)) from o0 where id = 1\nO WHERE	select count(*) from o0 where x * 2 > 0\nO NULLs	select count(x * 2), count(-s), count(abs(x)) from o0 where id = 3003\nO GROUP BY	select x / 1000 % 3 as k, count(*), sum(s + s) from o0 where id <= 3000 group by 1 order by 1\nO a join	select count(*) from o0 as a join o0 as c on c.id = a.id + 1 where a.id < 10\nO correlated	select (select o2.x * 1000 from o0 as o2 where o2.id = o0.id) from o0 where id = 3000\nO correlated fits	select (select o2.x * 1000 from o0 as o2 where o2.id = o0.id) from o0 where id = 2000\nO UPDATE an integer	update o0 set x = x + 1 where id = 3001\nO UPDATE fits	update o0 set x = x + 1 where id = 1 returning x\nO UPDATE a smallint	update o0 set s = s + 1 where id = 3001\nO UPDATE a bigint	update o0 set b = x * 1000000 where id = 3000\nO UPDATE a bigint fits	update o0 set b = b * 1000000 where id = 3000 returning b\nO bigint	select b * 2, b + x from o0 where id = 3000\nO an expression index	select count(*), min(y) from o1 where x + 1 = 5\nL a constant first	select coalesce(1, 1 / 0)\nL a column first	select coalesce(id, 1 / (id - id)) from o0 where id < 4 order by 1\nL a NULL first	select coalesce(x, 1 / (id - id)) from o0 where id = 3003\nL a subquery after	select coalesce(id, (select 1 / (o2.id - o2.id) from o0 as o2 where o2.id = 1)) from o0 where id = 1\nL three arguments	select coalesce(null, s, 1 / (id - id)), coalesce(null::int, null, 3) from o0 where id = 5\nL over batches	select sum(coalesce(x, 0) + coalesce(s, 1 / (id - id))) from o0 where id <= 3000\nL in WHERE, reached	select count(*) from o0 where coalesce(x, 1 / (id - id)) > 0\nL an aggregate's argument	select max(coalesce(b, 1 / (id - id))) from o0 where id <= 3000\nQ = ALL, < ANY of a subquery	select 1 = all (select 1.5), 1 < any (select 1.5), 2 > all (select 1.5 union select 2.5), 1 = all (select 1.0)\nQ arrays	select 1 = any (array[1.5, 1]), 3 = any (array[1.5, 3.0]), 2 > all (array[1.5::float8, 0.5]), 2 <> all (array[2.0, null])\nQ a column	select id, x = any (array[1000.0, null]), x >= all (select 1999.5) from o0 where id in (1, 2) order by id"

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let setup: str = SETUP
    for l in strings.lines(&setup) {
        let o = q(mut &s, &l)
        if strings.startsWith(&o, "ERROR") { println(l + ": " + o) }
    }
    let qs: str = QS
    for l in strings.lines(&qs) {
        let parts = strings.split(&l, "\t")
        two(mut &s, &parts[0], &parts[1])
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(98), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 4 * 1024 * 1024, ckptBytes: 2 * 1024 * 1024,
                                                           snapNodes: 100000}, body).unwrap()
}
