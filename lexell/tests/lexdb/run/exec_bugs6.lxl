// lexdb_exec: the sixth bug slice in the PostgreSQL door (design/lexdb-robust.md, "The sixth bug slice"): DROP TABLE under views refused (2BP01;
// the SQL Server and Oracle doors drop the table, tds_bugs6 and tns_bugs6) and CASCADE dropping them; information_schema.view_table_usage and
// view_column_usage. Checked against PostgreSQL 18 (generated by tests/lexdb/gen_pg.py from bugs6_queries.txt). Each answer: the columns' names
// and the rows, or the tag, or ERROR and the SQLSTATE; each statement runs with lexdb_batch off and on (an "@once" one once, an "@tx" one in a
// transaction rolled back).
// expect: CREATE TABLE
// expect: INSERT 0 1
// expect: CREATE VIEW
// expect: CREATE VIEW
// expect: CREATE TABLE
// expect: CREATE VIEW
// expect: same: ERROR 2BP01
// expect: same: v: 
// expect: same: v: d6v,d6vv
// expect: same: view_schema|view_name|table_schema|table_name: public|d6v|public|d6;public|d6vv|public|d6v;public|e6v|public|d6;public|e6v|public|e6
// expect: same: view_name|table_name|column_name: d6v|d6|a;d6vv|d6v|a;e6v|d6|a;e6v|e6|a;e6v|e6|c
// expect: CREATE VIEW
// expect: same: view_name|table_name|column_name: f6v|d6|a;f6v|d6|b
import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "@once create table d6 (a int, b int)\n@once insert into d6 values (1, 2)\n@once create view d6v as select a from d6\n@once create view d6vv as select a from d6v\n@once create table e6 (a int, c int)\n@once create view e6v as select d6.a, e6.c from d6 join e6 on e6.a = d6.a\ndrop table d6\n@tx drop table d6 cascade; select string_agg(table_name, ',' order by table_name) as v from information_schema.views where table_schema = 'public' and table_name like '%6v%'\n@tx drop table e6 cascade; select string_agg(table_name, ',' order by table_name) as v from information_schema.views where table_schema = 'public' and table_name like '%6v%'\nselect view_schema, view_name, table_schema, table_name from information_schema.view_table_usage where view_name like '%6v%' order by view_name, table_name\nselect view_name, table_name, column_name from information_schema.view_column_usage where view_name like '%6v%' order by view_name, table_name, column_name\n@once create view f6v as select * from d6\nselect view_name, table_name, column_name from information_schema.view_column_usage where view_name = 'f6v' order by column_name"

// the last result: its columns' names and every row (columns joined by |, rows by ;); or the tag; or the error
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag.clone() }
            var names: []str = []
            for c in r.cols { append(mut &names, c.name.clone()) }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for k in 0..len(row) { append(mut &cells, s.text(&row[k], if k < len(r.cols) { r.cols[k].oid } else { 0 })) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            return strings.join(&names, "|") + ": " + strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

// show, between BEGIN and ROLLBACK when t (an "@tx" line)
fn txShow(s: mut &lexdb_exec.Session, q: &str, t: bool): str {
    if !t { return show(s, q) }
    let a = show(s, &"begin")
    let r = show(s, q)
    let b = show(s, &"rollback")
    return r
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    let text: str = QUERIES
    for l in strings.lines(&text) {
        if strings.startsWith(&l, "@once ") {
            println(show(mut &s, &(l[6..len(l)].toStr())))
            continue
        }
        let t = strings.startsWith(&l, "@tx ")
        let q = if t { l[4..len(l)].toStr() } else { l.toStr() }
        let a = show(mut &s, &"set lexdb_batch = off")
        let off = txShow(mut &s, &q, t)
        let b = show(mut &s, &"set lexdb_batch = on")
        let on = txShow(mut &s, &q, t)
        if off == on { println("same: " + on) } else { println("DIFFERENT: " + off + " // batches: " + on) }
    }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(176), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
