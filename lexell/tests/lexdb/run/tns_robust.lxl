// expect: same: error 20001
// expect: same: A = 7
// expect: same: 0 / STATUS = 'INVALID' / LINE,POSITION,TEXT,ATTRIBUTE = 1|25|'PLS-00201: identifier ''NOTHERE'' must be declared'|'ERROR';1|25|'PL/SQL: Statement ignored'|'ERROR' / 0
// expect: same: OBJECT_NAME,STATUS = 'BAD2'|'INVALID'
// expect: same: LINE,TEXT = 1|'PLS-00201: identifier ''NOTHERE2'' must be declared';1|'PL/SQL: Statement ignored'
