// expect: same: A,B,C,D,E,F,G,H = 'acacac'|'aXcaXcaXc'|'abcaXcabc'|'abcaXcaXc'|'aXcaXcaXc'|'AXCaXc'|'abcabcabc'|'ac'
// expect: same: A,B,C,D = 'Smith, John'|'a_b_c'|'a[b]c'|'aandb'
// expect: same: A,B,C,D,E,F = 'line1'|4|NULL|'cd'|NULL|'b'
