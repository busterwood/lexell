// expect: book_author_title|t|f|2|3 2|CREATE UNIQUE INDEX book_author_title ON public.book USING btree (author_id, title) WHERE (price IS NOT NULL)|author_id|price IS NOT NULL;book_pkey|t|t|1|1|CREATE UNIQUE INDEX book_pkey ON public.book USING btree (id)|id|;book_title|f|f|1|2|CREATE INDEX book_title ON public.book USING btree (title)|title|
// expect: author_id;title
// expect: public|author|t;public|book|t;shop|orders|t
// expect: information_schema;pg_catalog;public;shop
// expect: author_id_seq|integer|1|1|2147483647|1|1|f;book_id_seq|bigint|1|1|9223372036854775807|1|1|f
// expect: book|shop.orders|author|t|f
// expect: ERROR 42P01
// expect: |book|integer||integer|integer|character varying
// expect: public.author_id_seq|public.book_id_seq|
// expect: character varying(50)|numeric(10,2)|timestamp with time zone|integer[]|timestamp(7) without time zone|boolean|"char"
// expect: bool|1|t|B|0|1000;int8|8|t|N|0|1016;int4|4|t|N|0|1007;text|-1|f|S|0|1009;_int4|-1|f|A|23|0;varchar|-1|f|S|0|1015;numeric|-1|f|N|0|1231;uuid|16|f|U|0|2951
// expect: SET
// expect: orders|book|t|shop
// expect: RESET
// expect: public|public
// expect: on
// expect: t|f|t|t|t|t
// expect: 20||a
// expect: abc|integer
// expect: 3|;2|b;1|a
// expect: 1|x;2|y
// expect: 1;2;3
// expect: 1|1;2|2;3|
// expect: 1|p;1|q;2|p;2|q
// expect: 4
// expect: a,*,c|1-2|3|"Abc"|abc|"select"
// expect: {"a" : 1, "b" : "x", "c" : null, "d" : true}
// expect: {book}|{}
// expect: BEGIN
// expect: INSERT 0 1
// expect: SAVEPOINT
// expect: ERROR 23505
// expect: ERROR 25P02
// expect: ROLLBACK
