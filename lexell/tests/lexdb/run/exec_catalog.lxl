// lexdb_exec: pg_catalog and information_schema, checked against PostgreSQL 18
// (generated by tests/lexdb/gen_pg.py from catalog_queries.txt): tables,
// columns, constraints, indexes and sequences as both describe them, the reg
// types, the catalog functions, ~, subscripts, VALUES, set-returning
// functions in a select list, ARRAY(subquery) and savepoints.
// Each expect line: a query's rows or tag, or ERROR and its SQLSTATE.
// expect: CREATE SCHEMA
// expect: CREATE TABLE
// expect: CREATE TABLE
// expect: CREATE INDEX
// expect: CREATE INDEX
// expect: CREATE TABLE
// expect: public|author|BASE TABLE;public|book|BASE TABLE;shop|orders|BASE TABLE
// expect: author|id|1|nextval('author_id_seq'::regclass)|NO|integer||32|2|0||int4|NO|;author|name|2||NO|character varying|50|||||varchar|NO|;author|born|3||YES|date|||||0|date|NO|;author|rating|4|0|YES|numeric||4|10|1||numeric|NO|;author|score|5|'-1'::integer|YES|integer||32|2|0||int4|NO|;book|id|1||NO|bigint||64|2|0||int8|YES|ALWAYS;book|title|2|'untitled'::text|NO|text||||||text|NO|;book|author_id|3||YES|integer||32|2|0||int4|NO|;book|price|4||YES|numeric||10|10|2||numeric|NO|;book|tags|5||YES|ARRAY||||||_text|NO|;book|qty|6||YES|integer||32|2|0||int4|NO|;orders|id|1||NO|integer||32|2|0||int4|NO|;orders|book_id|2||YES|bigint||64|2|0||int8|NO|;orders|qty|3|1|YES|integer||32|2|0||int4|NO|;orders|at|4|now()|YES|timestamp with time zone|||||6|timestamptz|NO|;orders|active|5|true|YES|boolean||||||bool|NO|
// expect: author_name_key|public|author|UNIQUE;author_pkey|public|author|PRIMARY KEY;book_author_id_fkey|public|book|FOREIGN KEY;book_pkey|public|book|PRIMARY KEY;orders_book_id_fkey|shop|orders|FOREIGN KEY;orders_pkey|shop|orders|PRIMARY KEY
// expect: author_name_key|author|name|1|;author_pkey|author|id|1|;book_author_id_fkey|book|author_id|1|1;book_pkey|book|id|1|;orders_book_id_fkey|orders|book_id|1|1;orders_pkey|orders|id|1|
// expect: book_author_id_fkey|author_pkey|NONE|NO ACTION|CASCADE;orders_book_id_fkey|book_pkey|NONE|RESTRICT|NO ACTION
// expect: author_score_check|(score >= '-1'::integer);qty_pos|(qty > 0)
// expect: public|author_id_seq|integer|32|1|1|2147483647|1|NO
// expect: information_schema;pg_catalog;public;shop
// expect: public|author|r|5|t|p;public|author_id_seq|S|3|f|p;public|author_name_key|i|1|f|p;public|author_pkey|i|1|f|p;public|book|r|6|t|p;public|book_author_title|i|2|f|p;public|book_id_seq|S|3|f|p;public|book_pkey|i|1|f|p;public|book_title|i|1|f|p;shop|orders|r|5|t|p;shop|orders_pkey|i|1|f|p
// expect: author|id|1|integer|t|t||0;author|name|2|character varying(50)|t|f||0;author|born|3|date|f|f||0;author|rating|4|numeric(4,1)|f|t||0;author|score|5|integer|f|t||0;book|id|1|bigint|t|f|a|0;book|title|2|text|t|t||0;book|author_id|3|integer|f|f||0;book|price|4|numeric(10,2)|f|f||0;book|tags|5|text[]|f|f||1;book|qty|6|integer|f|f||0;orders|id|1|integer|t|f||0;orders|book_id|2|bigint|f|f||0;orders|qty|3|integer|f|t||0;orders|at|4|timestamp with time zone|f|t||0;orders|active|5|boolean|f|t||0
// expect: author|id|nextval('author_id_seq'::regclass);author|rating|0;author|score|'-1'::integer;book|title|'untitled'::text;orders|active|true;orders|at|now();orders|qty|1
// expect: author_name_key|u|UNIQUE (name)|{2}|| | ;author_pkey|p|PRIMARY KEY (id)|{1}|| | ;book_author_id_fkey|f|FOREIGN KEY (author_id) REFERENCES author(id) ON DELETE CASCADE|{3}|{1}|a|c;book_pkey|p|PRIMARY KEY (id)|{1}|| | ;orders_book_id_fkey|f|FOREIGN KEY (book_id) REFERENCES book(id) ON UPDATE RESTRICT|{2}|{1}|r|a;orders_pkey|p|PRIMARY KEY (id)|{1}|| | 
// expect: qty_pos|CHECK (qty > 0)
