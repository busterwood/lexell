import "strings"
import "../../../cmd/lexdb_store"
import "../../../cmd/lexdb_disk"
import "../../../cmd/lexdb_exec"

const QUERIES = "create schema shop\ncreate table author (id serial primary key, name varchar(50) not null unique, born date, rating numeric(4,1) default 0, score int default -1 check (score >= -1))\ncreate table book (id bigint generated always as identity primary key, title text not null default 'untitled', author_id int references author(id) on delete cascade, price numeric(10,2), tags text[], qty int, constraint qty_pos check (qty > 0))\ncreate index book_title on book (title)\ncreate unique index book_author_title on book (author_id, title) where price is not null\ncreate table shop.orders (id int primary key, book_id bigint references book(id) on update restrict, qty int default 1, at timestamptz default now(), active boolean default true)\nselect table_schema, table_name, table_type from information_schema.tables where table_schema in ('public', 'shop') order by 1, 2\nselect table_name, column_name, ordinal_position, column_default, is_nullable, data_type, character_maximum_length, numeric_precision, numeric_precision_radix, numeric_scale, datetime_precision, udt_name, is_identity, identity_generation from information_schema.columns where table_schema in ('public', 'shop') order by table_name, ordinal_position\nselect constraint_name, table_schema, table_name, constraint_type from information_schema.table_constraints where table_schema in ('public', 'shop') and constraint_type <> 'CHECK' order by 1\nselect constraint_name, table_name, column_name, ordinal_position, position_in_unique_constraint from information_schema.key_column_usage where table_schema in ('public', 'shop') order by 1, 4\nselect constraint_name, unique_constraint_name, match_option, update_rule, delete_rule from information_schema.referential_constraints where constraint_schema in ('public', 'shop') order by 1\nselect constraint_name, check_clause from information_schema.check_constraints where constraint_schema = 'public' and constraint_name not like '%not_null' order by 1\nselect sequence_schema, sequence_name, data_type, numeric_precision, start_value, minimum_value, maximum_value, increment, cycle_option from information_schema.sequences order by 2\nselect schema_name from information_schema.schemata where schema_name in ('public', 'shop', 'pg_catalog', 'information_schema') order by 1\nselect n.nspname, c.relname, c.relkind, c.relnatts, c.relhasindex, c.relpersistence from pg_catalog.pg_class c join pg_catalog.pg_namespace n on n.oid = c.relnamespace where n.nspname in ('public', 'shop') order by 2\nselect c.relname, a.attname, a.attnum, format_type(a.atttypid, a.atttypmod), a.attnotnull, a.atthasdef, a.attidentity, a.attndims from pg_attribute a join pg_class c on c.oid = a.attrelid join pg_namespace n on n.oid = c.relnamespace where n.nspname in ('public', 'shop') and a.attnum > 0 and c.relkind = 'r' order by 1, 3\nselect c.relname, a.attname, pg_get_expr(d.adbin, d.adrelid) from pg_attrdef d join pg_class c on c.oid = d.adrelid join pg_attribute a on a.attrelid = d.adrelid and a.attnum = d.adnum order by 1, 2\nselect conname, contype, pg_get_constraintdef(oid), conkey, confkey, confupdtype, confdeltype from pg_constraint where conrelid in ('author'::regclass, 'book'::regclass, 'shop.orders'::regclass) and contype in ('p', 'u', 'f') order by 1\nselect conname, pg_get_constraintdef(oid, true) from pg_constraint where conrelid = 'book'::regclass and contype = 'c' order by 1\nselect confrelid::regclass, conrelid::regclass from pg_constraint where contype = 'f' order by conname\nselect schemaname, tablename, indexname, indexdef from pg_indexes where schemaname in ('public', 'shop') order by 3\nselect c.relname, i.indisunique, i.indisprimary, i.indnatts, i.indkey, pg_get_indexdef(i.indexrelid), pg_get_indexdef(i.indexrelid, 1, true), pg_get_expr(i.indpred, i.indrelid, true) from pg_index i join pg_class c on c.oid = i.indexrelid where i.indrelid = 'book'::regclass order by 1\nselect a.attname from pg_index i, unnest(i.indkey) k(n) join pg_attribute a on a.attnum = k.n where i.indexrelid = 'book_author_title'::regclass and a.attrelid = 'book'::regclass order by 1\nselect schemaname, tablename, hasindexes from pg_tables where schemaname in ('public', 'shop') order by 2\nselect nspname from pg_namespace where nspname in ('public', 'shop', 'pg_catalog', 'information_schema') order by 1\nselect c.relname, format_type(s.seqtypid, null), s.seqstart, s.seqincrement, s.seqmax, s.seqmin, s.seqcache, s.seqcycle from pg_sequence s join pg_class c on c.oid = s.seqrelid order by 1\nselect 'book'::regclass::text, 'shop.orders'::regclass::text, 'public.author'::regclass::text, pg_table_is_visible('book'::regclass), pg_table_is_visible('shop.orders'::regclass)\nselect 'nope'::regclass\nselect to_regclass('nope'), to_regclass('book')::text, to_regtype('integer')::text, to_regtype('nope'), 'int4'::regtype::text, 23::regtype, 'character varying'::regtype\nselect pg_get_serial_sequence('author', 'id'), pg_get_serial_sequence('book', 'id'), pg_get_serial_sequence('book', 'title')\nselect format_type(1043, 54), format_type(1700, 655366), format_type(1184, -1), format_type(1007, null), format_type(1114, 7), format_type(16, null), format_type(18, null)\nselect typname, typlen, typbyval, typcategory, typelem, typarray from pg_type where oid in (16, 20, 23, 25, 1043, 1007, 1700, 2950) order by oid\nset search_path to shop, public\nselect 'orders'::regclass::text, 'book'::regclass::text, pg_table_is_visible('shop.orders'::regclass), current_schema()\nreset search_path\nselect current_schema(), current_schema\nshow standard_conforming_strings\nselect 'abc' ~ '^a', 'abc' !~ 'b', 'ABC' ~* 'b', 'ABC' !~* 'd', 'x' OPERATOR(pg_catalog.~) 'x', 'book' ~ '^(book)$' COLLATE pg_catalog.default\nselect (array[10, 20, 30])[2], (array[10, 20, 30])[5], ('{a,b}'::text[])[1]\nselect pg_catalog.lower('ABC'), pg_catalog.format_type(23, null)\nselect * from (values (1, 'a'), (2, 'b'), (3, null)) as v(n, s) order by n desc\nvalues (1, 'x'), (2, 'y')\nselect 1 union all values (2) union all select 3 order by 1\nselect unnest(array[1, 2, 3]), generate_subscripts(array['a', 'b'], 1)\nselect n, unnest(array['p', 'q']) from (values (1), (2)) v(n) order by 1, 2\nselect count(*) from (select unnest(array[1, 2, 3, 4])) s\nselect array_to_string(array['a', null, 'c'], ',', '*'), array_to_string(array[1, 2], '-'), array_length(array[1, 2, 3], 1), quote_ident('Abc'), quote_ident('abc'), quote_ident('select')\nselect json_build_object('a', 1, 'b', 'x', 'c', null, 'd', true)\nselect array(select relname from pg_class where relname like 'book%' and relkind = 'r' order by 1), array(select 1 where false)\nbegin\ninsert into author (name) values ('A')\nsavepoint s1\ninsert into author (name) values ('A')\nselect count(*) from author\nrollback to savepoint s1\ninsert into author (name) values ('B')\nsavepoint s2\ninsert into author (name) values ('C')\nrollback to s2\nrelease savepoint s1\ncommit\nselect name from author order by 1\nsavepoint x\nbegin\nrollback to nope\nrollback"

// every row of the last result, columns joined by |, rows by ;; or the tag
fn show(s: mut &lexdb_exec.Session, q: &str): str {
    match s.exec(q) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            if !r.hasRows { return r.tag }
            var rows: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, lexdb_exec.text(&v)) }
                append(mut &rows, strings.join(&cells, "|"))
            }
            // psql shows a statement's tag after its RETURNING rows, not a SELECT's
            if r.tag != "" && !strings.startsWith(r.tag, "SELECT") && r.tag != "SHOW" { append(mut &rows, r.tag) }
            return strings.join(&rows, ";")
        }
        Err(e) { return "ERROR " + e.state }
    }
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    let text: str = QUERIES
    for q in strings.lines(&text) { println(show(mut &s, &q)) }
    s.close()
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(81), lexdb_store.Options{cacheBytes: 16 * 1024 * 1024, segBytes: 256 * 1024, ckptBytes: 128 * 1024,
                                                           snapNodes: 50000}, body).unwrap()
}
