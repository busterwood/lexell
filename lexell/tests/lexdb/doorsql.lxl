// doorsql: one statement through Lexell's own SQL Server or Oracle client,
// for the process tests (replica.py: design/lexdb.md 9.137).
//
//     doorsql tds|tns CONNECTION-STRING SQL
//
// Prints the rows (cells joined by "|", rows by ";") or "ok N" for a count,
// or "error N: message" (the server's number), and exits 0; exit 1 when it
// cannot connect ("connect: error N: message").
import "os"
import "strings"
import "sqlserver"
import "oracle"

fn main() {
    let a = os.arguments()
    if len(a) != 3 || (a[0] != "tds" && a[0] != "tns") {
        eprintln("usage: doorsql tds|tns CONNECTION-STRING SQL")
        exit(2)
    }
    if a[0] == "tds" { tdsRun(&a[1], &a[2]) } else { tnsRun(&a[1], &a[2]) }
}

fn tdsRun(cs: &str, sql: &str) {
    let got = sqlserver.connect(cs)
    if got.isErr() {
        let e = got.unwrapErr()
        println("connect: error " + e.code.toStr() + ": " + e.msg)
        exit(1)
    }
    var c = got.unwrap()
    match c.query(sql, &[]) {
        Ok(r) {
            if r.columnCount() == 0 {
                println("ok " + r.affected().toStr())
                return
            }
            var rows: []str = []
            for i in 0..r.rowCount() {
                var cells: []str = []
                for j in 0..r.columnCount() {
                    match r.value(i, j) {
                        Ok(v) { append(mut &cells, v.toStr()) }
                        Err(e) { append(mut &cells, "?") }
                    }
                }
                append(mut &rows, strings.join(&cells, "|"))
            }
            println(strings.join(&rows, ";"))
        }
        Err(e) { println("error " + e.code.toStr() + ": " + e.msg) }
    }
}

fn tnsRun(cs: &str, sql: &str) {
    let got = oracle.connect(cs)
    if got.isErr() {
        let e = got.unwrapErr()
        println("connect: error " + e.code.toStr() + ": " + strings.trim(&e.msg))
        exit(1)
    }
    var c = got.unwrap()
    let low = strings.toLowerAscii(&(strings.trim(sql)))
    if !strings.startsWith(&low, "select") && !strings.startsWith(&low, "with") {
        match c.run(sql, &[]) {
            Ok(n) { println("ok " + n.toStr()) }
            Err(e) { println("error " + e.code.toStr() + ": " + strings.trim(&e.msg)) }
        }
        return
    }
    match c.query(sql, &[]) {
        Ok(r) {
            var rows: []str = []
            for i in 0..r.rowCount() {
                var cells: []str = []
                for j in 0..r.columnCount() {
                    match r.value(i, j) {
                        Ok(v) { append(mut &cells, v.toStr()) }
                        Err(e) { append(mut &cells, "?") }
                    }
                }
                append(mut &rows, strings.join(&cells, "|"))
            }
            println(strings.join(&rows, ";"))
        }
        Err(e) { println("error " + e.code.toStr() + ": " + strings.trim(&e.msg)) }
    }
}
