// SPEC 11: withCapacity(n) is an empty array with room for n elements, its
// type the one expected where it is used. Appending past the room grows it
// as usual; the elements may be views (an array of &str); 0 makes no
// allocation; a negative capacity stops the program (exit 2).
// expect: 0 5 10 45
// expect: 0 3 12 6
// expect: b-c-d
// expect: 1 7
// expect: 0
// stderr: Lexell: negative array capacity at lang11_with_capacity.lxl:45
// exit: 2

type P = record { x: int; s: str }

fn views(s: &str): int {
    var vs: []&str = withCapacity(2)
    for i in 0..len(s) { append(mut &vs, &s[i..i + 1]) }
    return len(vs)
}

fn main() {
    var xs: []int = withCapacity(5)
    let n0 = len(xs)
    for i in 0..5 { append(mut &xs, i) }
    let n5 = len(xs)
    for i in 5..10 { append(mut &xs, i) }       // past the room
    var sum = 0
    for x in xs { sum += x }
    println(n0.toStr() + " " + n5.toStr() + " " + len(xs).toStr() + " " + sum.toStr())
    let text = "abcdefghijkl"
    var ps: []P = withCapacity(3)
    let p0 = len(ps)
    for i in 0..3 { append(mut &ps, P{x: i * 2, s: text[i..i + 1]}) }
    println(p0.toStr() + " " + len(ps).toStr() + " " + views(&text).toStr() + " " + (ps[0].x + ps[1].x + ps[2].x).toStr())
    let parts = "a-b-c-d"
    var rows: []&str = withCapacity(3)
    for i in 1..4 { append(mut &rows, &parts[i * 2..i * 2 + 1]) }
    println(rows[0] + "-" + rows[1] + "-" + rows[2])
    var nested: [][]int = withCapacity(1)
    append(mut &nested, withCapacity(4))
    append(mut &nested[0], 7)
    println(len(nested).toStr() + " " + nested[0][0].toStr() + "")
    var none: []str = withCapacity(0)
    println(len(none).toStr())
    let bad: []int = withCapacity(n0 - 1)
    println(len(bad).toStr())
}
