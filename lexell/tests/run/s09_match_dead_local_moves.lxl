// SPEC 9.3: a match on a local that is not used again consumes it (g: the arm owns e); one used
// again later, or matched inside a loop it is declared outside of, is borrowed (h, loopy).
// expect: w:bad3bad+badbadbad
type E = record { msg: str }
type R = closed { Ok(int); Err(E) }
fn wrap(e: E): str { return "w:" + e.msg }
fn f(n: int): R { return if n > 0 { R.Ok(n) } else { R.Err(E{msg: "bad" + ""}) } }
fn g(n: int): str {
    let r = f(n)
    return match r {               // r is dead after: moved, so e is owned
        R.Ok(k) { intToStr(k) }
        R.Err(e) { wrap(e) }
    }
}
fn h(n: int): str {
    let r = f(n)
    let s = match r {              // r used again below: borrowed, e is &E
        R.Ok(k) { intToStr(k) }
        R.Err(e) { e.msg.clone() }
    }
    match r { R.Ok(_) {} R.Err(e) { return s + "+" + e.msg } }
    return s
}
fn loopy(): str {
    let r = f(0)
    var out = ""
    for i in 0..2 {
        match r { R.Ok(_) {} R.Err(e) { out = out + e.msg } }   // in a loop: borrowed
    }
    return out
}
fn main() { println(g(0) + g(3) + h(0) + loopy()) }
