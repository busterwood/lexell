// SPEC 8: for x in a temporary array of owned elements consumes it; break, continue and return
// drop exactly what was not taken (run under LXL_CHECK).
// expect: abc
// expect: abc
// expect: saw 1
// expect: drop 1
// expect: drop 2
// expect: drop 3
// expect: drop 4
// expect: after break
// expect: drop 1
// expect: drop 2
// expect: drop 4
// expect: drop 3
// expect: 2
// expect: pt5
type D = record { id: int }
fn (d: mut &D) drop() { println("drop " + d.id.toStr()) }
type N = record { name: str }
fn ds(): []D { return [D{id: 1}, D{id: 2}, D{id: 3}, D{id: 4}] }
fn names(): []N { return [N{name: "a"}, N{name: "b"}, N{name: "c"}] }
fn firstBig(): int {
    for d in ds() {
        if d.id >= 2 { return d.id }      // return: the rest drop with the temporary
    }
    return 0
}
fn main() {
    var keep: []N = []
    for x in names() { append(mut &keep, x) }      // x is owned: moved, no clone
    println(keep[0].name + keep[1].name + keep[2].name)
    var xs = names()
    var out = ""
    for x in move(xs) { out = out + x.name }      // move(xs): consumes the variable
    println(out)
    for d in ds() {
        if d.id == 2 { continue }
        if d.id == 3 { break }                     // break: d 3 drops, then d 4 with the array
        println("saw " + d.id.toStr())
    }
    println("after break")
    println(firstBig())
    var odd: []N = []
    for x in [N{name: "p"}, N{name: "q"}, N{name: "r"}, N{name: "s"}, N{name: "t"}] { append(mut &odd, x) }
    println(odd[0].name + odd[4].name + intToStr(len(odd)))
}
