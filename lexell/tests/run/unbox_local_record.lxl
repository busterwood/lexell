// Boxed records that never escape live in a local (opt.lxl unbox): allocated and dropped in a
// loop, copied between locals, holding a string, made by an inlined constructor; and records that
// escape (passed on, returned, stored, moved into an Option, with a drop method), which keep
// their box. The outputs are the same either way.
// expect: 501500
// expect: 656700
// expect: names: n0=0 n1=1 n2=2 n3=3 n4=4
// expect: 75
// expect: 3
// expect: 7
// expect: some 2
// expect: 14
// expect: 15
// expect: made L0
// expect: drop L0
// expect: made L1
// expect: drop L1
// expect: 4 8
type Cell = record { v: int; w: int }

type Named = record { name: str; n: int }

type Outer = record { inner: Cell; k: int }

type Loud = record { name: str }

fn (l: mut &Loud) drop() { println("drop " + l.name) }

fn mk(i: int): Cell { return Cell{v: i, w: i * 2} }

fn keep(c: Cell): int { return c.v + c.w }

fn ret(i: int): Cell {
    let c = Cell{v: i, w: 1}
    return c
}

fn main() {
    var total = 0
    for i in 0..1000 {
        let c = Cell{v: i, w: 2}
        total += c.v + c.w
    }
    println(total.toStr())
    total = 0
    for i in 0..100 {
        let c = mk(i)
        let d = c
        total += d.v * d.w
    }
    println(total.toStr())
    var names = "names:"
    for i in 0..5 {
        let nm = Named{name: "n" + i.toStr(), n: i}
        names += " " + nm.name + "=" + nm.n.toStr()
    }
    println(names)
    var s = 0
    for i in 0..10 { s += keep(Cell{v: i, w: 3}) }
    println(s.toStr())
    var xs: []Cell = []
    for i in 0..4 {
        let c = Cell{v: i, w: i}
        append(mut &xs, c)
    }
    println(xs[3].v.toStr())
    let r = ret(7)
    println(r.v.toStr())
    var o: Option[Cell] = None
    for i in 0..3 {
        let c = Cell{v: i, w: 0}
        if i == 2 { o = Some(c) }
    }
    match &o {
        Some(c) { println("some " + c.v.toStr()) }
        None { println("none") }
    }
    for i in 0..2 {
        let o2 = Outer{inner: Cell{v: i, w: 5}, k: 9}
        println((o2.inner.v + o2.inner.w + o2.k).toStr())
    }
    for i in 0..2 {
        let l = Loud{name: "L" + i.toStr()}
        println("made " + l.name)
    }
    var m = Cell{v: 1, w: 1}
    for i in 0..3 { m = Cell{v: m.v + i, w: m.w * 2} }
    println(m.v.toStr() + " " + m.w.toStr())
}
