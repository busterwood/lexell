// s += x appends to an owned string in place: its buffer grows geometrically, so n appends cost
// O(total length) (design/consistency.md; it was a copy per append). Also when x is s itself or a
// slice of it, and on fields, elements and globals. Run with LXL_CHECK=1: nothing leaks.
// expect: abab
// expect: ababba
// expect: n=ab!
// expect: x1y yz
// expect: g:hi there
// expect: lit+more
// expect: 12345678901234567890 20
type P = record { name: str; n: int }
var G: str = ""
fn tail(s: &str): str { return s[1..].clone() }
fn main() {
    var s = "a" + "b"
    s += s
    println(s)
    s = "a" + "b"
    s += s
    s += &s[1..3]
    println(s)
    var p = P{name: "n=" + "", n: 1}
    p.name += "ab"
    p.name += "!"
    println(p.name)
    var xs = ["x" + "", "y" + ""]
    xs[0] += "1"
    xs[0] += xs[1]
    xs[1] += tail(&("zz" + ""))
    println(xs[0] + " " + xs[1])
    G += "hi"
    G += " there"
    println("g:" + G)
    var l = "lit"
    l += "+more"
    println(l)
    var d = ""
    for i in 0..20 { d += intToStr((i + 1) % 10) }
    println(d + " " + len(d).toStr())
}
