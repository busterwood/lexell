// Globals of any type holding no borrows (SPEC 5.2, design/consistency.md finding 3). One whose
// type has no constant form, or whose initializer calls a function, is initialized on first use
// (REG prints when main first reaches it) and dropped at exit if it was. G.with(f) lends it as
// mut &T: a Map, an array, a boxed record changed in place. Run with LXL_CHECK=1: no leaks.
// expect: start
// expect: 2 2 8
// expect: init registry
// expect: 2 hello, world 3
// expect: 3
// expect: drop registry 1
type Reg = record { names: []str; hits: int }
fn (r: mut &Reg) drop() { println("drop registry " + r.hits.toStr()) }
fn mkReg(): Reg { println("init registry"); return Reg{names: ["a" + ""], hits: 0} }
var COUNTS: Map[str, int] = newMap()
var CACHE: []int = []
var REG: Reg = mkReg()
var GREETING: str = "hello, " + "world"
var N: int = 3
fn bump(k: &str) {
    COUNTS.with(fn(m: mut &Map[str, int]) {
        let n = m.getOr(k, 0)
        m.put(k.clone(), n + 1)
    })
}
fn main() {
    println("start")
    bump("x")
    bump("x")
    bump("y")
    CACHE.with(fn(c: mut &[]int) { append(c, 7); append(c, 8) })
    println(COUNTS.clone().getOr(&"x", 0).toStr() + " " + len(CACHE).toStr() + " " + CACHE[1].toStr())
    REG.with(fn(r: mut &Reg) { r.hits += 1; append(mut &r.names, "b" + "") })
    REG.with(fn(r: mut &Reg) { println(len(r.names).toStr() + " " + GREETING + " " + N.toStr()) })
    CACHE = [1, 2, 3]
    println(len(CACHE).toStr())
}
