// SPEC 12: lxl output and printf in order: io.flushStdout before C writes, fflush after; C's
// unflushed output comes after Lexell's at exit (as tests/native/dyn_stdio.lxl).
// expect: lxl 1
// expect: C 1 flushed
// expect: lxl 2
// expect: lxl 3
// expect: C 2 at exit
import "io"
extern "c" fn printf(fmt: str, ...): i32
extern "c" fn fflush(f: ptr): i32
fn main() {
    println("lxl 1")
    io.flushStdout().unwrap()
    printf("C %d %s\n", i32(1), "flushed")
    fflush(nullPtr())
    println("lxl 2")
    printf("C %d at exit\n", i32(2))
    println("lxl 3")
}
