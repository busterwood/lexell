// Drops of chain types (emit.lxl selfLoop): a drop action that would push its own action for a
// child loops on it instead. The order of drops is unchanged: a field with a drop method in each
// node prints it, for a list, a tree (both children, either missing) and a long list (no stack).
// expect: drop l0
// expect: drop l1
// expect: drop l2
// expect: drop l3
// expect: --
// expect: drop tRRR
// expect: drop tRRL
// expect: drop tRR
// expect: drop tR
// expect: drop tLRR
// expect: drop tLRL
// expect: drop tLR
// expect: drop tL
// expect: drop t
// expect: --
// expect: drop fRR
// expect: drop fRL
// expect: drop fR
// expect: drop fLR
// expect: drop fLL
// expect: drop fL
// expect: drop f
// expect: --
// expect: long list dropped
type Loud = record { name: str }

fn (l: mut &Loud) drop() { println("drop " + l.name) }

type L = record { tag: Loud; next: Option[L] }

type T = record { tag: Loud; left: Option[T]; right: Option[T] }

type Q = record { v: int; next: Option[Q] }

fn list(n: int): Option[L] {
    var l: Option[L] = None
    for i in 0..n { l = Some(L{tag: Loud{name: "l" + i.toStr()}, next: move(l)}) }
    return l
}

fn tree(d: int, name: &str): Option[T] {
    if d == 0 { return None }
    let left = if d % 2 == 0 { tree(d - 1, &(name + "L")) } else { None }
    return Some(T{tag: Loud{name: name.clone()}, left: left, right: tree(d - 1, &(name + "R"))})
}

fn full(d: int, name: &str): T {
    if d == 0 { return T{tag: Loud{name: name.clone()}, left: None, right: None} }
    return T{tag: Loud{name: name.clone()}, left: Some(full(d - 1, &(name + "L"))), right: Some(full(d - 1, &(name + "R")))}
}

fn main() {
    var l = list(4)
    l = None
    println("--")
    var t = tree(4, "t")
    t = None
    println("--")
    var f = Some(full(2, "f"))
    f = None
    println("--")
    var q: Option[Q] = None
    for i in 0..1000000 { q = Some(Q{v: i, next: move(q)}) }
    q = None
    println("long list dropped")
}
