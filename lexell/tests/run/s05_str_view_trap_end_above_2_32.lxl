// A view whose end is 2^32 + 2, which wraps to 2 when cast to 32 bits: &s[1..b] on "hello".
// The bound is compared as 64 bits (b > len: rt_str_view in C, the inline view in native),
// so it traps: "string slice out of range", exit 3. A 32-bit compare would let b = 2 through.
// Only this view is bad.
// expect: before
// stderr: Lexell: string slice out of range at s05_str_view_trap_end_above_2_32.lxl:15
// exit: 3

fn main() {
    let s = "hello"
    let z = len(args()) - 1         // 0, unknown to the compiler
    println("before")
    var b = 4294967298
    b += z
    let v: &str = &s[1..b]
    println(v)
    println("not reached")
}
