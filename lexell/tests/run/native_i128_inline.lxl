// i128 arithmetic that the native backend makes inline: wrapping + - *, checked + and -
// (the overflow flag, not the carry), and checked negation; at and near the limits.
// expect: -5 -170141183460469231731687303715884105724 170141183460469231731687303715884105727 170141183460469231731687303715884105725
// expect: -5 -170141183460469231731687303715884105727
// expect: 15 -5 -1 0
// expect: -300000000000000000000 300000000000000000000
// expect: -170141183460469231431687303715884105728
fn main() {
    let mx: i128 = 170141183460469231731687303715884105727
    let mn: i128 = -mx - 1
    var x: i128 = 5
    println((0 -% x).toStr() + " " + (x +% mx).toStr() + " " + (mn -% 1).toStr() + " " + (mx *% 3).toStr())
    println((-x).toStr() + " " + (-mx).toStr())
    println((x + 10).toStr() + " " + (x - 10).toStr() + " " + (mn + mx).toStr() + " " + (mx - mx).toStr())
    var y: i128 = 0
    for i in 0..3 { y = y - i128(i) * 100000000000000000000 }
    println(y.toStr() + " " + (-y).toStr())
    println((mn - y).toStr())
}
