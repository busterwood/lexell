// A boxed record or closed type may hold borrows (SPEC 10 rule 1; design/consistency-designs.md,
// finding 2): a recursive syntax tree of &str views of its source, with no copies. It is
// borrow-class like a value type holding borrows. Run with LXL_CHECK=1: the boxes are freed.
// expect: (alpha + (beta + gamma))
// expect: betaxy
import "strings"
type Expr = closed { Name(&str); Num(int); Add(Expr, Expr) }
type Tok = record { text: &str; owned: str }
fn parse(ws: &[]&str, i: int): Expr {
    if i == len(ws) - 1 { return Expr.Name(ws[i]) }
    return Expr.Add(Expr.Name(ws[i]), parse(ws, i + 1))
}
fn show(e: &Expr): str {
    return match e {
        Expr.Name(n) { n.clone() }
        Expr.Num(k) { k.toStr() }
        Expr.Add(a, b) { "(" + show(a) + " + " + show(b) + ")" }
    }
}
fn main() {
    let src = "alpha beta gamma" + ""
    let ws = strings.split(&src, " ")
    let e = parse(&ws, 0)
    println(show(&e))
    let t = Tok{text: ws[1], owned: "x" + "y"}
    println(t.text + t.owned)
}
