// match h.f, where the local h is not used after the match, moves h.f (SPEC 9.3), as match
// move(h).f does: an arm keeps its binding with no clone, and h's other fields drop at the match.
// k is used after its match, so that match borrows k.e and k drops at the end.
// Run with LXL_CHECK=1: nothing leaks.
// expect: drop other
// expect: kept x
// expect: drop other
// expect: q
// expect: still 2
// expect: drop other

type Noisy = record { name: str }
fn (n: mut &Noisy) drop() { println("drop " + n.name) }

type E = closed { P(str); Q }
type H = record { e: E; other: Noisy; n: int }

fn main() {
    let h = H{e: E.P("x" + ""), other: Noisy{name: "other" + ""}, n: 1}
    let s = match h.e { E.P(a) { a } E.Q { "q" } }
    println("kept " + s)
    let g = H{e: E.Q, other: Noisy{name: "other" + ""}, n: 2}
    match g.e {
        E.P(a) { println(a) }
        E.Q { println("q") }
    }
    let k = H{e: E.P("y" + ""), other: Noisy{name: "other" + ""}, n: 2}
    match k.e { E.P(a) { } E.Q { } }
    println("still " + k.n.toStr())
}
