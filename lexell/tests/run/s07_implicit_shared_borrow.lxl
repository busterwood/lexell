// SPEC 7: a value passed to a shared borrow parameter is borrowed as if written &x; a temporary
// lives to the end of the statement (run under LXL_CHECK, so a leaked temporary fails).
// expect: 4453
// expect: pptmpppp
// expect: abcdabcd5544made!made!
// expect: abcd
type P = record { name: str; n: int }
fn show(s: &str): int { return len(s) }
fn showP(p: &P): str { return p.name.clone() }
fn mk(): str { return "made" + "!" }
fn mkP(): P { return P{name: "tmp" + "p", n: 1} }
fn twice[T: Show](x: &T): str { return x.toStr() + x.toStr() }
var G: int = 4
fn main() {
    let s = "abc" + "d"
    let p = P{name: "pp", n: 2}
    println(intToStr(show(s)) + intToStr(show(&s)) + intToStr(show(mk())) + intToStr(show("lit")))
    println(showP(p) + showP(mkP()) + p.name)
    println(twice(s) + twice(5) + twice(G) + twice(mk()))
    println(s)
}
