// A record or closed type without its own eq, hash or toStr gets them derived (SPEC 7.4), like
// clone: field by field in declaration order, when every part has the method and the type has no
// drop method. So such types can be compared, used as Map keys and printed. toStr quotes strings.
// Run with LXL_CHECK=1: nothing leaks.
// expect: P{x: 1, y: 2}
// expect: true true
// expect: Person{name: "Ann", age: 30, tags: Some(x)}
// expect: true
// expect: 3 Color.Green
// expect: Shape.Rect{w: 2, h: 3} Shape.Circle(1.5) Shape.Dot
// expect: true false
// expect: v1 none
// expect: Some(P{x: 5, y: 6})
// expect: List.Cons(1, List.Cons(2, List.Nil))
// expect: true true
type P = value record { x: int; y: int }
type Person = record { name: str; age: int; tags: Option[str] }
type Color = closed { Red; Green; Blue }
type Shape = closed { Circle(float); Rect { w: int; h: int }; Dot }
type Pair[A, B] = record { a: A; b: B }
type List = closed { Nil; Cons(int, List) }
fn main() {
    let p = P{x: 1, y: 2}
    println(p)
    println((p == P{x: 1, y: 2}).toStr() + " " + (p != P{x: 2, y: 2}).toStr())
    let q = Person{name: "Ann" + "", age: 30, tags: Some("x" + "")}
    println(q)
    println((q == Person{name: "Ann" + "", age: 30, tags: Some("x" + "")}).toStr())
    var m = newMap[Color, int]()
    m.put(Color.Red, 1)
    m.put(Color.Blue, 3)
    let g = Color.Green
    println(m.getOr(&Color.Blue, 0).toStr() + " " + g.toStr())
    let s = Shape.Rect{w: 2, h: 3}
    let c = Shape.Circle(1.5f)
    let dot = Shape.Dot
    println(s.toStr() + " " + c.toStr() + " " + dot.toStr())
    println((s == Shape.Rect{w: 2, h: 3}).toStr() + " " + (s == Shape.Dot).toStr())
    var pm = newMap[Pair[str, int], str]()
    pm.put(Pair{a: "k" + "", b: 1}, "v1" + "")
    println(pm.getOr(&Pair{a: "k" + "", b: 1}, "none" + "") + " " + pm.getOr(&Pair{a: "k" + "", b: 2}, "none" + ""))
    let o: Option[P] = Some(P{x: 5, y: 6})
    println(o)
    let l = List.Cons(1, List.Cons(2, List.Nil))
    println(l)
    println((l == List.Cons(1, List.Cons(2, List.Nil))).toStr() + " " + (l.hash() == List.Cons(1, List.Cons(2, List.Nil)).hash()).toStr())
}
