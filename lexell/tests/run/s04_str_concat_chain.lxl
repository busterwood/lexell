// a + b + c ...: a chain of str + is one concatenation sized once (check.lxl xChain); it reads
// as the nested form does: empty, static and heap parts, a part used twice, chains in arguments
// and conditions, long chains, and later operands that change an earlier one.
// expect: [] 0
// expect: [x] 1
// expect: [ab] 2
// expect: [a-b-c] 5
// expect: word3-7 7
// expect: [q-r-q] [q,q] [q,q,q]
// expect: 4096 4996
// expect: true
// expect: abcdefghi 9
// expect: 01234 5
// expect: x(yz)w
// expect: oldold!
// expect: G0+1
// expect: L:mid:2
// expect: s=ab-cd
// expect: 15 14
// expect: 6
// expect: pre<a.b>post
type B = value record { v: int }
fn (a: B) add(b: B): B { return B{v: a.v + b.v} }
type P = record {
    name: str
    tag: str
}
var G: str = "G0"
fn bump(): str { G = "G1"; return "1" }
fn grab(s: mut &str): str { let r = s.clone(); s += "?"; return r }
fn wrap(s: &str): str { return "<" + s + ">" }
fn show(s: &str) { println("[" + s + "] " + len(s).toStr()) }
fn main() {
    let e = ""
    show(e + "" + e)
    show("" + "x" + e)
    var a = "a"
    a += ""                         // heap or static: both read the same
    show(a + e + "b")
    show(a + "-" + "b" + "-" + "c")
    let i = 3
    let r = 7
    let w = "word" + i.toStr() + "-" + r.toStr()
    println(w + " " + len(w).toStr())
    let q = "q"
    println("[" + q + "-r-" + q + "] [" + q + "," + q + "] [" + q + "," + q + "," + q + "]")
    var big = ""
    for _ in 0..1024 { big += "abcd" }
    let huge = big + big[0..100] + "" + big[0..800]
    println(len(big).toStr() + " " + len(huge).toStr())
    println(a + "b" + "c" == "abc")
    println("a" + "b" + "c" + "d" + "e" + "f" + "g" + "h" + "i" + " " + len("a" + "b" + "c" + "d" + "e" + "f" + "g" + "h" + "i").toStr())
    var digits = ""
    digits = digits + "0" + "1" + "2" + "3" + "4"
    println(digits + " " + len(digits).toStr())
    println("x" + ("(" + "y" + "z" + ")") + "w")
    // a later operand changes an earlier one: it is read before, as each + reads it
    var s = "old"
    println(s + "" + grab(mut &s) + "!")
    println(G + "+" + bump())
    let p = P{name: "L", tag: "mid"}
    println(p.name + ":" + p.tag + ":" + (len(p.name) + 1).toStr())
    var acc = "s="
    acc += "a" + "b" + "-" + "cd"
    println(acc)
    let x = 1 + i + 4 + r
    let b = B{v: 4} + B{v: 5} + B{v: 5}
    println(x.toStr() + " " + b.v.toStr())
    let f = 1.5f + 2.0f + 2.5f
    println(f.toStr())
    println("pre" + wrap(&(a + "." + "b")) + "post")
}
