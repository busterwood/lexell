// A chain of + whose parts include x.toStr() or intToStr(x) of an int x (check.lxl xChain): the
// int is passed as a part and its text written straight into the result (rt_str_concat3 to 8).
// Every arity, signs and extremes, empty and lone parts, string parts of every short length
// (rt_cat_put's branches), evaluation order around calls that change the int, chains longer than 8,
// and a user function named intToStr (not std's: an ordinary call).
// expect: file.lxl:12 file.lxl:-3
// expect: x1:42x0-7
// expect: x00
// expect: a42b
// expect: a42b-7
// expect: <-9223372036854775808|9223372036854775807>
// expect: 0
// expect: -7
// expect: 5
// expect: 5
// expect: x126--58|-1
// expect: 1223334444555556666667777777
// expect: p12345678910
// expect: []0[abcdefghijklmnopqrst]
// expect: [a]1[abcdefghijklmnopqrs]
// expect: [ab]2[abcdefghijklmnopqr]
// expect: [abc]3[abcdefghijklmnopq]
// expect: [abcd]4[abcdefghijklmnop]
// expect: [abcde]5[abcdefghijklmno]
// expect: [abcdef]6[abcdefghijklmn]
// expect: [abcdefg]7[abcdefghijklm]
// expect: [abcdefgh]8[abcdefghijkl]
// expect: [abcdefghi]9[abcdefghijk]
// expect: [abcdefghij]10[abcdefghij]
// expect: [abcdefghijk]11[abcdefghi]
// expect: [abcdefghijkl]12[abcdefgh]
// expect: [abcdefghijklm]13[abcdefg]
// expect: [abcdefghijklmn]14[abcdef]
// expect: [abcdefghijklmno]15[abcde]
// expect: [abcdefghijklmnop]16[abcd]
// expect: [abcdefghijklmnopq]17[abc]
// expect: [abcdefghijklmnopqr]18[ab]
// expect: [abcdefghijklmnopqrs]19[a]
// expect: n1+2+3
// expect: pre-42-
// expect: i32 5 5!
// expect: w0-0w1--1000w2--2000w3--3000w4--4000
// expect: 0:1,-1,0.
// expect: 1:10,-10,9.
// expect: 2:100,-100,99.
// expect: 3:1000,-1000,999.
// expect: 4:10000,-10000,9999.
// expect: 5:100000,-100000,99999.
// expect: 6:1000000,-1000000,999999.
// expect: 7:10000000,-10000000,9999999.
// expect: 8:100000000,-100000000,99999999.
// expect: 9:1000000000,-1000000000,999999999.
// expect: 10:10000000000,-10000000000,9999999999.
// expect: 11:100000000000,-100000000000,99999999999.
// expect: 12:1000000000000,-1000000000000,999999999999.
// expect: 13:10000000000000,-10000000000000,9999999999999.
// expect: 14:100000000000000,-100000000000000,99999999999999.
// expect: 15:1000000000000000,-1000000000000000,999999999999999.
// expect: 16:10000000000000000,-10000000000000000,9999999999999999.
// expect: 17:100000000000000000,-100000000000000000,99999999999999999.
// expect: 18:1000000000000000000,-1000000000000000000,999999999999999999.
fn bump(n: mut &int): str {
    n += 1
    return "+"
}

type Holder = record { f: str; xs: []str }

// The first part is read through a borrow (not pure): the chain is joined early, to two parts.
fn tag(m: &Holder, line: int): str { return m.f + ":" + intToStr(line) }

fn s(k: int): str {
    var out = ""
    for i in 0..k { out += strFromBytes(&[byte(97 + i % 26)]) }
    return out
}

fn main() {
    let a = 42
    let b = -7
    let mn = -9223372036854775807 - 1
    let mx = 9223372036854775807
    let h = Holder{f: "file.lxl", xs: ["x0", "x1"]}
    println(tag(&h, 12) + " " + tag(&h, -3))
    println(h.xs[1] + ":" + a.toStr() + h.xs[0] + b.toStr())
    println(h.xs[0] + "" + 0.toStr())
    println("a" + a.toStr() + "b")
    println("a" + a.toStr() + "b" + b.toStr())
    println("<" + mn.toStr() + "|" + mx.toStr() + ">")
    println("" + 0.toStr() + "")
    println("" + b.toStr() + "")
    println("" + "" + 5.toStr())
    println(5.toStr() + "" + "")
    println("x" + intToStr(a * 3) + "-" + (a - 100).toStr() + "|" + intToStr(-1))
    println("" + 1.toStr() + 22.toStr() + 333.toStr() + 4444.toStr() + 55555.toStr() + 666666.toStr() + 7777777.toStr())
    println("p" + 1.toStr() + 2.toStr() + 3.toStr() + 4.toStr() + 5.toStr() + 6.toStr() + 7.toStr() + 8.toStr() + 9.toStr() + 10.toStr())
    for k in 0..20 { println("[" + s(k) + "]" + k.toStr() + "[" + s(20 - k) + "]") }
    var n = 1
    println("n" + n.toStr() + bump(mut &n) + n.toStr() + bump(mut &n) + n.toStr())
    var t = "pre"
    t += "-" + a.toStr() + "-"
    println(t)
    let i32v: i32 = 5
    println("i32 " + i32v.toStr() + " " + intToStr(int(i32v)) + "!")
    var parts: []str = []
    for i in 0..5 { append(mut &parts, "w" + i.toStr() + "-" + (i * -1000).toStr()) }
    var all = ""
    for p in parts { all += p }
    println(all)
    var tens = 1
    for d in 0..19 {
        println(d.toStr() + ":" + tens.toStr() + "," + (0 - tens).toStr() + "," + (tens - 1).toStr() + ".")
        if d < 18 { tens = tens * 10 }
    }
}
