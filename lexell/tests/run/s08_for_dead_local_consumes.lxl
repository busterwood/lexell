// for x in xs, where the local xs is not used after the loop (nor in its body), consumes xs as
// for x in move(xs) does (SPEC 8): x is an owned element, each drops at the end of its turn.
// expect: 1
// expect: drop 1
// expect: 2
// expect: drop 2
// expect: 0
// expect: ab
type D = record { id: int }
fn (d: mut &D) drop() { println("drop " + d.id.toStr()) }
fn main() {
    let ds = [D{id: 1}, D{id: 2}]
    for d in ds { println(d.id.toStr()) }
    println("0")
    let names = ["a" + "", "b" + ""]
    var out: []str = []
    for n in names { append(mut &out, n) }
    println(out[0] + out[1])
}
