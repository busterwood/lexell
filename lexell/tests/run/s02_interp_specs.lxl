import "math"

fn main() {
    // Integers: radix, prefix, zero-pad, sign, grouping, alignment
    let n = 255
    println($"{n:d} {n:x} {n:X} {n:#x} {n:#06x} {n:#b} {n:#o}")
    println($"{42:+d} {42: d} {-42:+d} {-42:05d}")
    println($"{1234567:,} {-1234567:,} {1234567:>12,}")
    let minInt = -9223372036854775807 - 1
    println($"{minInt:,}")
    let sm: i32 = -15
    let ub: byte = 10
    let u3: u32 = 3735928559
    let u6: u64 = 18446744073709551615
    println($"{sm:+05d} {ub:02x} {u3:#x} {u6:,}")
    let bigI: i128 = -1000000000000000000000
    let bigU: u128 = 340282366920938463463374607431768211455
    println($"{bigI:,}")
    println($"{bigU:#x}")

    // Floats: fixed, scientific, general, specials
    println($"{2.675f:.2f} {-0.0f:.1f} {12345.678f:,.2f}")
    println($"{1234.5f:.2e} {0.005f:.1E} {math.inf():+f} {math.nan():>5f}")

    // Decimals: scale, rounding, canonical, grouping, sign, alignment
    let d = 1234567.895m
    println($"{d:,.2f} {d:>15,.2f} {12.500m:c} {-0.001m:.2f} {5.0m:+07.2f}")

    // Strings and Show: alignment, fill, precision, quoting
    let word = "lex"
    println($"[{word:<6}] [{word:>6}] [{word:^7}] [{word:*^7}]")
    println($"[{"hello world":.5}] [{"a\nb\"c":q}]")
    println($"[{true:>6}]")
}
// expect: 255 ff FF 0xff 0x00ff 0b11111111 0o377
// expect: +42  42 -42 -0042
// expect: 1,234,567 -1,234,567    1,234,567
// expect: -9,223,372,036,854,775,808
// expect: -0015 0a 0xdeadbeef 18,446,744,073,709,551,615
// expect: -1,000,000,000,000,000,000,000
// expect: 0xffffffffffffffffffffffffffffffff
// expect: 2.68 -0.0 12,345.68
// expect: 1.23e+03 5.0E-03 +inf   NaN
// expect: 1,234,567.90    1,234,567.90 12.5 0.00 +005.00
// expect: [lex   ] [   lex] [  lex  ] [**lex**]
// expect: [hello] ["a\nb\"c"]
// expect: [  true]
