// for x in an owned array it consumes (check.lxl forConsume): the array reversed in place with two
// indices, then taken from the end, so x takes the elements in order; on break the rest are
// dropped with the array. Lengths 0 to 6, and a break part way.
// expect: 0:
// expect: 1: s0
// expect: 2: s0 s1
// expect: 3: s0 s1 s2
// expect: 4: s0 s1 s2 s3
// expect: 5: s0 s1 s2 s3 s4
// expect: 6: s0 s1 s2 s3 s4 s5
// expect: take L0
// expect: drop L0
// expect: take L1
// expect: drop L1
// expect: take L2
// expect: drop L2
// expect: drop L4
// expect: drop L3
// expect: end
type Loud = record { name: str }

fn (l: mut &Loud) drop() { println("drop " + l.name) }

fn mk(n: int): []str {
    var out: []str = []
    for i in 0..n { append(mut &out, "s" + i.toStr()) }
    return out
}

fn louds(n: int): []Loud {
    var out: []Loud = []
    for i in 0..n { append(mut &out, Loud{name: "L" + i.toStr()}) }
    return out
}

fn main() {
    for n in 0..7 {
        var line = n.toStr() + ":"
        for w in mk(n) { line += " " + w }
        println(line)
    }
    for l in louds(5) {
        println("take " + l.name)
        if l.name == "L2" { break }
    }
    println("end")
}
