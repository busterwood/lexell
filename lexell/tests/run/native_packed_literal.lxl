// Record literals whose 8-byte words are made up of small integer constants (x64gen fillEntries):
// stored as one word. Signed and unsigned fields, negative values, padding between, a word with a
// variable field (not packed), literals passed on the stack, nested and returned.
// expect: 1 2 3 4 5 6 7 T 8
// expect: -1 -2 0 0 0 0 -1 F -2147483648
// expect: 7 2 3 4 5 6 7 F 7
// expect: -1 2147483647 255 65535 4294967295 -9 -32768 T 7
// expect: 1 -1 1 1 1 1 1 T 1|-1 2147483647 255 65535 4294967295 -9 -32768 T 3|9 8 7 6 5 4 3 F 2|-1 2147483647 255 65535 4294967295 -9 -32768 T -4
// expect: 11 12 13 14 15 16 17 T 18 / -1 2147483647 255 65535 4294967295 -9 -32768 T 19
type P = value record { a: i32; b: i32; c: byte; d: u32; e: u32; f: int; g: i32; h: bool; i: i32 }

type W = value record { x: P; y: P }

fn show(p: P): str {
    return p.a.toStr() + " " + p.b.toStr() + " " + int(p.c).toStr() + " " + int(p.d).toStr() + " " + int(p.e).toStr() + " " +
        p.f.toStr() + " " + p.g.toStr() + " " + (if p.h { "T" } else { "F" }) + " " + p.i.toStr()
}

fn many(a: P, b: P, c: P, d: P): str { return show(a) + "|" + show(b) + "|" + show(c) + "|" + show(d) }

fn mk(v: i32): P { return P{a: -1, b: 2147483647, c: 255, d: 65535, e: 4294967295, f: -9, g: -32768, h: true, i: v} }

fn main() {
    let k: i32 = 7
    println(show(P{a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: true, i: 8}))
    println(show(P{a: -1, b: -2, c: 0, d: 0, e: 0, f: 0, g: -1, h: false, i: -2147483647 - 1}))
    println(show(P{a: k, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: false, i: k}))
    println(show(mk(k)))
    println(many(P{a: 1, b: -1, c: 1, d: 1, e: 1, f: 1, g: 1, h: true, i: 1}, mk(3), P{a: 9, b: 8, c: 7, d: 6, e: 5, f: 4, g: 3, h: false, i: 2}, mk(-4)))
    let w = W{x: P{a: 11, b: 12, c: 13, d: 14, e: 15, f: 16, g: 17, h: true, i: 18}, y: mk(19)}
    println(show(w.x) + " / " + show(w.y))
}
