// expect: 145465424
// expect: 460909571
// bools computed by an if-chain and only tested to jump (compiler/bfold.lxl under -O): and/or,
// jump when true/false, break and continue, the right operand with statements; the trace
// records which operands ran, in order.
var trace: int = 0
fn note(k: int, v: bool): bool {
    trace = trace * 7 + k
    trace = trace % 1000000007
    return v
}
fn isL(c: byte): bool { return c >= 'a' && c <= 'z' || c == '_' }
fn isD(c: byte): bool { return c >= '0' && c <= '9' }
fn run(s: &str): int {
    var acc = 0
    var i = 0
    while i < len(s) {
        let c = strByte(s, i)
        if isL(c) {
            while i < len(s) && (isL(strByte(s, i)) || isD(strByte(s, i))) { i += 1 }
            acc += 1
        } else if isD(c) {
            while i < len(s) && isD(strByte(s, i)) { i += 1 }
            acc += 10
        } else {
            i += 1
        }
    }
    // and, jump when true (break), with calls having effects
    var j = 0
    while true {
        j += 1
        if note(1, j > 3) && note(2, j % 2 == 0) { break }
        if j > 50 { break }
    }
    acc += j * 100
    // or, jump when true
    j = 0
    while true {
        j += 1
        if note(3, j > 7) || note(4, j == 5) { break }
    }
    acc += j * 1000
    // or, jump when false (loop condition)
    j = 0
    while note(5, j < 3) || note(6, j < 6) { j += 1 }
    acc += j * 10000
    // and with continue
    var k = 0
    for m in 0..20 {
        if note(7, m % 3 == 0) && note(8, m % 2 == 0) { continue }
        k += m
    }
    acc += k * 100000
    // nested: and of or
    j = 0
    while j < 30 && (note(9, j % 7 != 6) || note(10, j < 10)) { j += 1 }
    acc += j * 10000000
    return acc
}
fn main() {
    println(run("abc_1 23 x9y  _q 007 zz"))
    println(trace)
}
