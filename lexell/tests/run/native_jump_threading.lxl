// Jumps to a jmp go to its target (x64.thread, in layout): a match in a loop whose cases end in
// jumps to the jump back to the top, nested loops with break and continue, if chains whose
// branches all end in jumps to one place, and returns from a loop.
// expect: run 140000
// expect: stop 2
// expect: grid 921172
// expect: classify 844894
// expect: early 300 0
type Op = value closed { Inc(int); Dec(int); Skip; Stop }

// a match in a loop: each case jumps to the end of the match, where the jump back to the top is
fn run(code: &[]Op, n: int): int {
    var acc = 0
    var pc = 0
    var steps = 0
    while steps < n {
        steps += 1
        match code[pc % len(code)] {
            Op.Inc(k) { acc += k }
            Op.Dec(k) { acc -= k }
            Op.Skip { pc += 1 }
            Op.Stop { return acc }
        }
        pc += 1
    }
    return acc
}

// nested loops with break and continue: jumps to the jumps that end the inner loop
fn grid(n: int): int {
    var s = 0
    for i in 0..n {
        for j in 0..n {
            if j % 3 == 0 { continue }
            if j > i { break }
            if (i + j) % 5 == 0 {
                s += i
            } else if (i * j) % 7 == 1 {
                s -= j
            } else {
                s += 1
            }
        }
    }
    return s
}

// ifs whose branches all end in jumps to the same place
fn classify(x: int): int {
    var r = 0
    if x < 0 {
        r = 1
    } else if x == 0 {
        r = 2
    } else if x < 10 {
        if x % 2 == 0 { r = 3 } else { r = 4 }
    } else {
        r = 5
    }
    return r
}

fn early(xs: &[]int): int {
    for x in xs {
        if x > 100 { return x }
        if x < -100 { return -x }
    }
    return 0
}

fn main() {
    let code = [Op.Inc(3), Op.Skip, Op.Dec(1), Op.Inc(2), Op.Dec(5), Op.Inc(7)]
    println("run " + run(&code, 100000).toStr())
    let stop = [Op.Inc(1), Op.Inc(1), Op.Stop]
    println("stop " + run(&stop, 100).toStr())
    println("grid " + grid(300).toStr())
    var c = 0
    for x in -20..40 { c = c * 3 % 1000003 + classify(x) }
    println("classify " + c.toStr())
    println("early " + early(&[1, 2, -300, 5]).toStr() + " " + early(&[1, 2, 3]).toStr())
}
