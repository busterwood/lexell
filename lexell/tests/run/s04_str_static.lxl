// strStatic(s): a copy of s whose bytes are never freed (cap 0), so copies of it, and clones of
// records holding it, share the bytes. Run with LXL_CHECK=1: it is not counted as a leak.
// expect: n0 n0 n0
// expect: n1 n1 n1
// expect: 0 lit
// expect: k2 k2

type P = record { name: str; id: int }

fn main() {
    var keep: []str = []
    for i in 0..2 {
        let s = "n" + intToStr(i)
        let p = strStatic(s)
        append(mut &keep, p.clone())
        println(s + " " + p + " " + keep[i])
    }
    let e = strStatic("" + "")
    println(len(e).toStr() + " " + strStatic("lit"))
    let a = P{name: strStatic("k" + "2"), id: 2}
    let b = a.clone()
    println(a.name + " " + b.name)
}
