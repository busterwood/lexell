// expect: 42 820 0
// == on str: every length 0 to 40, equal, and a difference at each position (both ways).
fn mk(n: int, d: int, c: byte): str {
    var b: []byte = []
    for i in 0..n { append(mut &b, if i == d { c } else { byte(97 + i % 26) }) }
    return strFromBytes(&b)
}
fn main() {
    var eq = 0
    var ne = 0
    var bad = 0
    for n in 0..41 {
        let x = mk(n, -1, 'z')
        let y = mk(n, -1, 'z')
        if x == y { eq += 1 } else { bad += 1 }
        for d in 0..n {
            let z = mk(n, d, '#')
            if x == z || z == x { bad += 1 } else { ne += 1 }
        }
        if n > 0 && x == mk(n - 1, -1, 'z') { bad += 1 }
    }
    let s = "hello world"
    if s[0..5] == "hello" && s[6..11] == "world" && !(s[0..5] == "hellp") { eq += 1 } else { bad += 1 }
    println(eq.toStr() + " " + ne.toStr() + " " + bad.toStr())
}
