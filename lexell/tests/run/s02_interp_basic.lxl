type Point = value record { x: int; y: int }
type Item = record { name: str; price: Decimal }

fn greet[T: Show](who: &T, n: int): str {
    return $"hello {who}, count={n}"
}

fn bump(s: mut &str): str {
    s += "!"
    return s.clone()
}

fn mayFail(ok: bool): Result[int, str] {
    if ok { return Ok(7) }
    return Err("boom")
}

fn tryInterp(ok: bool): Result[str, str] {
    let prefix = "val=" + "ok"
    return Ok($"{prefix}:{try mayFail(ok)}")
}

fn main() {
    let name = "Ada"
    let age = 36
    let price = 19.99m
    let ok = true
    println($"hi {name}, age {age}, price {price}, ok={ok}")

    // Braces escaping and zero-interpolation string
    println($"{{literal}} and {{}}")
    println($"no holes here")

    // Owned string is borrowed, not moved
    let owned = "lex" + "ell"
    let s1 = $"{owned}!"
    println($"{s1} / {owned}")

    // Complex expressions inside braces: if, record literal, nested interp
    let p = Point{x: 3, y: 4}
    println($"point={p} inline={Point{x: 1, y: 2}}")
    println($"cond={if age >= 18 { "adult" } else { "minor" }}")
    println($"nested={$"[{name}:{age}]"}")

    // Derived toStr and rc str
    let it = Item{name: "tea", price: 3.50m}
    let r = rc("shared" + "!")
    println($"{it} / {r}")

    // Generic T: Show
    println(greet(&name, 2))
    println(greet(&p, 5))

    // Left-to-right evaluation with mutation
    var m = "ab" + ""
    println($"{m} -> {bump(mut &m)} -> {m}")

    // Raw multiline interpolated string
    let raw = $`line1: {name}\n
line2: {{ok}} = {age}`
    println(raw)

    // try inside interpolation (both Ok and Err paths must not leak)
    println(tryInterp(true).unwrap())
    println(tryInterp(false).unwrapErr())
}
// expect: hi Ada, age 36, price 19.99, ok=true
// expect: {literal} and {}
// expect: no holes here
// expect: lexell! / lexell
// expect: point=Point{x: 3, y: 4} inline=Point{x: 1, y: 2}
// expect: cond=adult
// expect: nested=[Ada:36]
// expect: Item{name: "tea", price: 3.50} / shared!
// expect: hello Ada, count=2
// expect: hello Point{x: 3, y: 4}, count=5
// expect: ab -> ab! -> ab!
// expect: line1: Ada\n
// expect: line2: {ok} = 36
// expect: val=ok:7
// expect: boom
