// SPEC 4.9: rc T handles: the value drops once, with the last handle (run under LXL_CHECK).
// expect: handles made
// expect: after keep
// expect: 2
// expect: end
// expect: drop 1
type D = record { id: int; tag: str }
fn (d: mut &D) drop() { println("drop " + d.id.toStr()) }
fn keep(r: rc D): int { return 1 }
fn main() {
    let a: rc D = rc(D{id: 1, tag: "one"})
    let b = a.share()
    let c = b.clone()
    println("handles made")
    let k = keep(c)                 // moves c in; dropped in keep: one handle fewer
    println("after keep")
    let xs: []rc D = [a.share(), a.share()]
    println(len(xs))
    let s: rc str = rc("text" + "!")
    let t = s.share()
    println("end")
}
