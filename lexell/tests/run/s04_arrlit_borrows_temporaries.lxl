// SPEC 4.2: elements of an array literal of shared borrows are borrowed; temporaries live to the
// end of the statement (run under LXL_CHECK).
// expect: [SET][user:1][30]
// expect: [GET][k7][user:1]
// expect: [a][b]
// expect: user:1
fn command(args: &[&str]): str {
    var out = ""
    for a in args { out = out + "[" + a + "]" }
    return out
}
fn mk(k: int): str { return "k" + intToStr(k) }
fn main() {
    let key = "user" + ":1"
    let n = 30
    println(command(&["SET", key, n.toStr()]))
    println(command(&["GET", mk(7), key]))
    var keys: []str = ["a" + "", "b" + ""]
    println(command(&keys))                      // &[]str as &[&str], as before
    println(key)
}
