// SPEC 4.9: reading through rc T: fields, methods, &T arguments, loops, ==.
// expect: notes 3 5 5
// expect: abc
// expect: hi! 2
// expect: a
// expect: true
// expect: xy
type Doc = record { title: str; words: []str }
fn (d: &Doc) count(): int { return len(d.words) }
fn titleLen(d: &Doc): int { return len(d.title) }
fn shout(s: &str): str { return s + "!" }
fn main() {
    let d: rc Doc = rc(Doc{title: "notes", words: ["a" + "", "b" + "", "c" + ""]})
    let e = d.share()
    println(d.title + " " + intToStr(d.count()) + " " + intToStr(titleLen(d)) + " " + intToStr(titleLen(&e)))
    var all = ""
    for w in d.words { all = all + w }
    println(all)
    let s: rc str = rc("hi" + "")
    println(shout(s) + " " + intToStr(len(s.toStr())))
    let first = &d.words[0]
    println(first)
    let a = rc(3)
    let b = rc(3)
    println(a == b)
    let ws: rc []str = rc(["x" + "", "y" + ""])
    for w in ws { print(w) }
    println("")
}
