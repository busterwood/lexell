// SPEC 4.1: the primitive types other than str are copy types: let b = a copies. (str is owned:
// s04_str_clone_independent.)
// expect: 1
// expect: 1
// expect: 2.5 2.5 true true
fn main() {
    let a = 1
    let b = a
    println(a)
    println(b)
    let f = 2.5f
    let g = f
    let t = true
    let u = t
    println(f.toStr() + " " + g.toStr() + " " + t.toStr() + " " + u.toStr())
}
