// Advanced interface values + escaping closures interop:
// derived Show/Serialize in box I, interface narrowing (&Speaker -> &Named,
// box Speaker -> box Named), generic T -> box Show and &T -> &Show across
// int/str/record, var reassignment drop, Map of box I / box fn, escaping
// closure capturing box Show, Option.map with box fn.
// expect: derived point Point{x: 3, y: 4}
// expect: derived json {"x":3,"y":4}
// expect: narrow ref Rex
// expect: narrow box Bolt
// expect: generic ref 7 | hi | Dog(Max)
// expect: generic box 9 | ok | Dog(Sam)
// expect: reassign drops 2
// expect: map handlers 11 20
// expect: clo captures box Dog(Ace)!
// expect: option map Some(42)

import "json"

type Named = interface {
    fn (&Self) name(): str
}

type Speaker = interface {
    fn (&Self) name(): str
    fn (&Self) sound(): str
}

type Point = value record {
    x: int
    y: int
}

type Dog = record {
    n: str
}

fn (d: &Dog) name(): str { return d.n.clone() }
fn (d: &Dog) sound(): str { return "woof" }
fn (d: &Dog) toStr(): str { return $"Dog({d.n})" }

var dropN: int = 0
type DropBox = record { id: int }
fn (d: &DropBox) toStr(): str { return $"DropBox({d.id})" }
fn (d: mut &DropBox) drop() { dropN += 1 }

fn takeNamed(n: &Named): str { return n.name() }
fn narrowRef(s: &Speaker): str { return takeNamed(s) }
fn takeShow(s: &Show): str { return s.toStr() }

fn genericShowRef[T: Show](x: &T): str {
    return takeShow(x)
}

fn genericBox[T: Show](x: T): box Show {
    return x
}

fn makeAnnouncer(who: box Show): box fn(): str {
    return fn() { return $"{who.toStr()}!" }
}

fn main() {
    // 1. Compiler-derived Show and Serialize through interface values
    let pt = Point{x: 3, y: 4}
    let bShow: box Show = pt
    let bSer: box Serialize = pt
    println($"derived point {bShow.toStr()}")
    println($"derived json {json.encode(&bSer)}")

    // 2. Interface narrowing: &Speaker -> &Named and box Speaker -> box Named
    let rex = Dog{n: "Rex"}
    println($"narrow ref {narrowRef(&rex)}")
    let sp: box Speaker = Dog{n: "Bolt"}
    let nm: box Named = sp
    println($"narrow box {nm.name()}")

    // 3. Generic &T -> &Show and T -> box Show for primitive, str (isRefByVal), and boxed record (isRefByVal)
    let i7 = 7
    let sHi = "hi"
    let dMax = Dog{n: "Max"}
    println($"generic ref {genericShowRef(&i7)} | {genericShowRef(&sHi)} | {genericShowRef(&dMax)}")
    let g1 = genericBox(9)
    let g2 = genericBox("ok")
    let g3 = genericBox(Dog{n: "Sam"})
    println($"generic box {g1.toStr()} | {g2.toStr()} | {g3.toStr()}")

    // 4. Reassigning var box Show drops previous value
    {
        var cur: box Show = DropBox{id: 1}
        cur = DropBox{id: 2}
        assert(cur.toStr() == "DropBox(2)")
    }
    println($"reassign drops {dropN}")

    // 5. Map[str, box fn(int): int]
    var routes: Map[str, box fn(int): int] = newMap()
    routes.put("inc", fn(x) { return x + 1 })
    routes.put("dbl", fn(x) { return x * 2 })
    let r1 = routes.at("inc")(10)
    let r2 = routes.find("dbl").unwrap()(10)
    println($"map handlers {r1} {r2}")

    // 6. Escaping closure capturing an owned box Show
    let ann = makeAnnouncer(Dog{n: "Ace"})
    println($"clo captures box {ann()}")

    // 7. Passing box fn to stdlib Option.map(&fn)
    let mul = box fn(x: int): int { return x * 2 }
    let opt = Some(21).map(&mul)
    println($"option map {opt}")
}
