// A function whose result is a shared borrow may have several borrowed parameters: the result
// borrows all of its arguments (SPEC 10 rule 5), as a result holding borrows does.
// expect: ab
// expect: qwlit

fn longer(a: &str, b: &str): &str { return if len(a) >= len(b) { a } else { b } }

fn main() {
    var x = "ab" + ""
    var y = "c" + ""
    let r = longer(&x, &y)
    println(r)
    x = "q"
    y = "w"
    println(x + y + longer("lit", &y))
}
