// SPEC 5.2: owned globals with value-only access: built-in reads in place, clone() for a copy,
// assignment drops the old value (run under LXL_CHECK).
// expect: a;b;
// expect: 4
// expect: dflt new 81
// expect: 3
type Cfg = value record { name: str; port: int }
var LOG: str = ""
var CFG: Cfg = Cfg{name: "dflt", port: 80}
var CACHE: Option[[]int] = None
fn note(s: &str) { LOG = LOG + s + ";" }
fn setCfg(n: &str) { CFG = Cfg{name: n.clone(), port: CFG.port + 1} }
fn total(o: &Option[[]int]): int {
    match o { Some(xs) { return len(xs) } None { return 0 } }
}
fn main() {
    note("a")
    note("b")
    println(LOG.clone())
    println(len(LOG))
    let c = CFG.clone()
    setCfg("new")
    println(c.name + " " + CFG.clone().name + " " + intToStr(CFG.port))
    CACHE = Some([1, 2, 3])
    let k = CACHE.clone()
    println(total(&k))
}
