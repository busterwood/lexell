// Wrapping multiplies by constants the native backend makes as a shift and an add or a subtract
// (x64gen leaMul: 2^j, 2^j + 1, 2^j - 1), for every kind, against the extremes; also from a
// local in a register and from a value in rax.
// expect: int -4530634812049005834
// expect: i32 1947134453
// expect: u32 562592189
// expect: u64 5360277134554724797
// expect: byte 34
fn r_int(x: int, y: int): int {
    var h: int = 0
    h = h *% 31 +% x *% 7 +% (x +% y) *% 7
    h = h *% 31 +% x *% 15 +% (x +% y) *% 15
    h = h *% 31 +% x *% 16 +% (x +% y) *% 16
    h = h *% 31 +% x *% 17 +% (x +% y) *% 17
    h = h *% 31 +% x *% 31 +% (x +% y) *% 31
    h = h *% 31 +% x *% 32 +% (x +% y) *% 32
    h = h *% 31 +% x *% 33 +% (x +% y) *% 33
    h = h *% 31 +% x *% 63 +% (x +% y) *% 63
    h = h *% 31 +% x *% 64 +% (x +% y) *% 64
    h = h *% 31 +% x *% 65 +% (x +% y) *% 65
    h = h *% 31 +% x *% 255 +% (x +% y) *% 255
    h = h *% 31 +% x *% 257 +% (x +% y) *% 257
    h = h *% 31 +% x *% 1023 +% (x +% y) *% 1023
    h = h *% 31 +% x *% 1025 +% (x +% y) *% 1025
    h = h *% 31 +% x *% 4096 +% (x +% y) *% 4096
    h = h *% 31 +% x *% 65535 +% (x +% y) *% 65535
    h = h *% 31 +% x *% 65537 +% (x +% y) *% 65537
    h = h *% 31 +% x *% 1073741823 +% (x +% y) *% 1073741823
    h = h *% 31 +% x *% 1073741824 +% (x +% y) *% 1073741824
    h = h *% 31 +% x *% 1073741825 +% (x +% y) *% 1073741825
    return h
}
fn t_int() {
    let xs: []int = [-9223372036854775807 - 1, -9223372036854775807, -4611686018427387904, -2147483648, -1000, -33, -1, 0, 1, 2, 33, 1000, 2147483647, 4294967295, 4611686018427387903, 9223372036854775807]
    var h: int = 0
    for x in xs { h = h *% 31 +% r_int(x, xs[1]) }
    println("int " + h.toStr())
}
fn r_i32(x: i32, y: i32): i32 {
    var h: i32 = 0
    h = h *% 31 +% x *% 7 +% (x +% y) *% 7
    h = h *% 31 +% x *% 15 +% (x +% y) *% 15
    h = h *% 31 +% x *% 16 +% (x +% y) *% 16
    h = h *% 31 +% x *% 17 +% (x +% y) *% 17
    h = h *% 31 +% x *% 31 +% (x +% y) *% 31
    h = h *% 31 +% x *% 32 +% (x +% y) *% 32
    h = h *% 31 +% x *% 33 +% (x +% y) *% 33
    h = h *% 31 +% x *% 63 +% (x +% y) *% 63
    h = h *% 31 +% x *% 64 +% (x +% y) *% 64
    h = h *% 31 +% x *% 65 +% (x +% y) *% 65
    h = h *% 31 +% x *% 255 +% (x +% y) *% 255
    h = h *% 31 +% x *% 257 +% (x +% y) *% 257
    h = h *% 31 +% x *% 1023 +% (x +% y) *% 1023
    h = h *% 31 +% x *% 1025 +% (x +% y) *% 1025
    h = h *% 31 +% x *% 4096 +% (x +% y) *% 4096
    h = h *% 31 +% x *% 65535 +% (x +% y) *% 65535
    h = h *% 31 +% x *% 65537 +% (x +% y) *% 65537
    h = h *% 31 +% x *% 1073741823 +% (x +% y) *% 1073741823
    h = h *% 31 +% x *% 1073741824 +% (x +% y) *% 1073741824
    h = h *% 31 +% x *% 1073741825 +% (x +% y) *% 1073741825
    return h
}
fn t_i32() {
    let xs: []i32 = [-2147483647 - 1, -2147483647, -1073741824, -1000, -33, -1, 0, 1, 2, 33, 1000, 1073741823, 2147483647]
    var h: i32 = 0
    for x in xs { h = h *% 31 +% r_i32(x, xs[1]) }
    println("i32 " + h.toStr())
}
fn r_u32(x: u32, y: u32): u32 {
    var h: u32 = 0
    h = h *% 31 +% x *% 7 +% (x +% y) *% 7
    h = h *% 31 +% x *% 15 +% (x +% y) *% 15
    h = h *% 31 +% x *% 16 +% (x +% y) *% 16
    h = h *% 31 +% x *% 17 +% (x +% y) *% 17
    h = h *% 31 +% x *% 31 +% (x +% y) *% 31
    h = h *% 31 +% x *% 32 +% (x +% y) *% 32
    h = h *% 31 +% x *% 33 +% (x +% y) *% 33
    h = h *% 31 +% x *% 63 +% (x +% y) *% 63
    h = h *% 31 +% x *% 64 +% (x +% y) *% 64
    h = h *% 31 +% x *% 65 +% (x +% y) *% 65
    h = h *% 31 +% x *% 255 +% (x +% y) *% 255
    h = h *% 31 +% x *% 257 +% (x +% y) *% 257
    h = h *% 31 +% x *% 1023 +% (x +% y) *% 1023
    h = h *% 31 +% x *% 1025 +% (x +% y) *% 1025
    h = h *% 31 +% x *% 4096 +% (x +% y) *% 4096
    h = h *% 31 +% x *% 65535 +% (x +% y) *% 65535
    h = h *% 31 +% x *% 65537 +% (x +% y) *% 65537
    h = h *% 31 +% x *% 1073741823 +% (x +% y) *% 1073741823
    h = h *% 31 +% x *% 1073741824 +% (x +% y) *% 1073741824
    h = h *% 31 +% x *% 1073741825 +% (x +% y) *% 1073741825
    return h
}
fn t_u32() {
    let xs: []u32 = [0, 1, 2, 33, 1000, 65535, 65536, 2147483647, 2147483648, 4294967294, 4294967295]
    var h: u32 = 0
    for x in xs { h = h *% 31 +% r_u32(x, xs[1]) }
    println("u32 " + h.toStr())
}
fn r_u64(x: u64, y: u64): u64 {
    var h: u64 = 0
    h = h *% 31 +% x *% 7 +% (x +% y) *% 7
    h = h *% 31 +% x *% 15 +% (x +% y) *% 15
    h = h *% 31 +% x *% 16 +% (x +% y) *% 16
    h = h *% 31 +% x *% 17 +% (x +% y) *% 17
    h = h *% 31 +% x *% 31 +% (x +% y) *% 31
    h = h *% 31 +% x *% 32 +% (x +% y) *% 32
    h = h *% 31 +% x *% 33 +% (x +% y) *% 33
    h = h *% 31 +% x *% 63 +% (x +% y) *% 63
    h = h *% 31 +% x *% 64 +% (x +% y) *% 64
    h = h *% 31 +% x *% 65 +% (x +% y) *% 65
    h = h *% 31 +% x *% 255 +% (x +% y) *% 255
    h = h *% 31 +% x *% 257 +% (x +% y) *% 257
    h = h *% 31 +% x *% 1023 +% (x +% y) *% 1023
    h = h *% 31 +% x *% 1025 +% (x +% y) *% 1025
    h = h *% 31 +% x *% 4096 +% (x +% y) *% 4096
    h = h *% 31 +% x *% 65535 +% (x +% y) *% 65535
    h = h *% 31 +% x *% 65537 +% (x +% y) *% 65537
    h = h *% 31 +% x *% 1073741823 +% (x +% y) *% 1073741823
    h = h *% 31 +% x *% 1073741824 +% (x +% y) *% 1073741824
    h = h *% 31 +% x *% 1073741825 +% (x +% y) *% 1073741825
    return h
}
fn t_u64() {
    let xs: []u64 = [0, 1, 2, 33, 1000, 4294967295, 4294967296, 9223372036854775807, 9223372036854775808, 18446744073709551614, 18446744073709551615]
    var h: u64 = 0
    for x in xs { h = h *% 31 +% r_u64(x, xs[1]) }
    println("u64 " + h.toStr())
}
fn r_byte(x: byte, y: byte): byte {
    var h: byte = 0
    h = h *% 31 +% x *% 7 +% (x +% y) *% 7
    h = h *% 31 +% x *% 15 +% (x +% y) *% 15
    h = h *% 31 +% x *% 16 +% (x +% y) *% 16
    h = h *% 31 +% x *% 17 +% (x +% y) *% 17
    h = h *% 31 +% x *% 31 +% (x +% y) *% 31
    h = h *% 31 +% x *% 32 +% (x +% y) *% 32
    h = h *% 31 +% x *% 33 +% (x +% y) *% 33
    h = h *% 31 +% x *% 63 +% (x +% y) *% 63
    h = h *% 31 +% x *% 64 +% (x +% y) *% 64
    h = h *% 31 +% x *% 65 +% (x +% y) *% 65
    h = h *% 31 +% x *% 255 +% (x +% y) *% 255
    return h
}
fn t_byte() {
    let xs: []byte = [0, 1, 2, 7, 8, 33, 127, 128, 200, 254, 255]
    var h: byte = 0
    for x in xs { h = h *% 31 +% r_byte(x, xs[1]) }
    println("byte " + h.toStr())
}
fn main() {
    t_int()
    t_i32()
    t_u32()
    t_u64()
    t_byte()
}
