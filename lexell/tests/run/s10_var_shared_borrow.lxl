// A var may hold a shared borrow (SPEC 10 rule 7): its initializer gives the roots it may borrow,
// later stores must borrow from those roots (or be static), and the roots stay frozen while the
// var is live. The freeze ends at the var's last use, also for a write to an element.
// expect: bb
// expect: a lit b
// expect: zzz

fn main() {
    var xs = ["a" + "", "bb" + ""]
    var best: &str = &xs[0]
    for i in 0..len(xs) {
        if len(xs[i]) > len(best) { best = &xs[i] }
    }
    println(best)
    let a = "a" + ""
    let b = "b" + ""
    var s: &str = if len(a) > 5 { &a } else { &b }
    s = &a
    let first = s.clone()
    s = "lit"
    println(first + " " + s + " " + (if len(a) > 5 { a.clone() } else { b.clone() }))
    xs[1] = "zzz"
    println(xs[1])
}
