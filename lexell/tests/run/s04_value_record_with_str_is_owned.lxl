// SPEC 4.3, 4.7 (design/owned-str.md): a value record holding a str is owned: let b = a moves it;
// a.clone() is an independent copy.
// expect: ann
// expect: bob ann
type N = value record { name: str; age: int }
fn main() {
    let a = N{name: "ann", age: 3}
    var b = a.clone()
    println(a.name)
    b.name = "bob"
    let c = a
    println(b.name + " " + c.name)
}
