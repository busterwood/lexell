// SPEC 4.9: rc str and rc []T read like the value: len, indexing, views, intrinsics, operators,
// and a &rc str returned as &str (run under LXL_CHECK).
// expect: 4 98 bc 97 true abcd! false
// expect: 5
// expect: cd
type Buf = record { data: rc str }
fn tail(b: &Buf): &str { return &b.data[2..] }
fn main() {
    let s: rc str = rc("ab" + "cd")
    let v: &str = &s[1..3]
    let u = s.share()
    println(intToStr(len(s)) + " " + intToStr(int(s[1])) + " " + v + " " + intToStr(int(strByte(s, 0))) + " " +
        (if s == "abcd" { "true" } else { "false" }) + " " + s + "!" + " " + (if u < s { "true" } else { "false" }))
    let xs: rc []int = rc([1, 2, 3])
    println(xs[1] + len(xs))
    let b = Buf{data: s.share()}
    println(tail(&b))
}
