// Doubles in one register through a chain of temporaries (x64gen joins: a local and the local
// its initializer reads only as its first operand, where that one's range ends), a store
// computed in the register of the temporary the statement before declared (fIntoTemp), and
// loads whose addresses set an integer local (addrCode): a pair loop as nbody's, a temporary
// read again on the right (no sharing), a temporary declared before a loop and read by the last
// declaration of its body (no sharing: it is live around the loop), temporaries read twice by
// later stores, and compound assignments of elements.
// expect: pairs 448113 -448113 30976
// expect: square 9000000 6000000
// expect: around 14000000 4000000
// expect: twice 2500000 5000000 3000000
// expect: compound 7750000 -4250000
type B = value record { x: float; y: float; z: float; vx: float; vy: float; vz: float; m: float }

fn show(v: float): str { return int(v * 1000000.0f).toStr() }

fn step(bs: mut &[]B, dt: float) {
    let n = len(bs)
    for i in 0..n {
        for j in i + 1..n {
            let dx = bs[i].x - bs[j].x
            let dy = bs[i].y - bs[j].y
            let dz = bs[i].z - bs[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * d2.sqrt())
            let mj = bs[j].m * mag
            bs[i].vx -= dx * mj
            bs[i].vy -= dy * mj
            bs[i].vz -= dz * mj
            let mi = bs[i].m * mag
            bs[j].vx += dx * mi
            bs[j].vy += dy * mi
            bs[j].vz += dz * mi
        }
    }
}

fn square(xs: &[]float, i: int): float {
    let t = xs[i] + 1.0f
    let d = t * t                 // t read again on the right
    return d + t
}

fn around(xs: &[]float, k: float): float {
    let t = k * 2.0f
    var acc = 0.0f
    for i in 0..len(xs) {
        acc += t
        let b = t * xs[i]         // the body's last declaration reads t, which the next round reads again
    }
    return acc
}

fn main() {
    var bs: []B = []
    for i in 0..4 {
        let f = float(i)
        append(mut &bs, B{x: f, y: f * f, z: 1.0f - f, vx: 0.0f, vy: 0.0f, vz: 0.0f, m: 1.0f + f})
    }
    for s in 0..100 { step(mut &bs, 0.01f) }
    println("pairs " + show(bs[0].vx) + " " + show(bs[1].vx * bs[1].m + bs[0].vx * bs[0].m + bs[2].vx * bs[2].m + bs[3].vx * bs[3].m - bs[0].vx) + " " + show(bs[3].vz))
    var xs: []float = [1.0f, 2.0f, 3.0f, 4.0f]
    println("square " + show(square(&xs, 1) - 3.0f) + " " + show(square(&xs, 0)))
    let a1 = around(&xs, 1.75f)
    println("around " + show(a1) + " " + show(xs[3]))
    var ps: []B = []
    append(mut &ps, B{x: 2.5f, y: 0.0f, z: 0.0f, vx: 1.0f, vy: 2.0f, vz: 0.0f, m: 0.0f})
    let t = ps[0].x
    ps[0].y = t + 2.5f             // t read again below
    ps[0].z = t * 1.2f
    println("twice " + show(ps[0].x) + " " + show(ps[0].y) + " " + show(ps[0].z))
    ps[0].vx += ps[0].x * 2.7f
    ps[0].vy -= ps[0].y * 1.25f
    println("compound " + show(ps[0].vx) + " " + show(ps[0].vy))
}
