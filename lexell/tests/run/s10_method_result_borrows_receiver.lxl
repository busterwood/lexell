// A method with a borrowed receiver that returns a borrow returns a borrow of the receiver; its
// other borrowed parameters are only read (SPEC 10 rule 5). Map.at and Map.atMut take the key
// by borrow, so a lookup does not clone the key.
// expect: 1 1 1 k
// expect: [2, 3]
// expect: b

type Pair = record { a: str; b: str }

fn (p: &Pair) pick(which: &str): &str { return if which == "a" { &p.a } else { &p.b } }

fn main() {
    var m = newMap[str, int]()
    m.put("k" + "", 1)
    let k = "k" + ""
    let v = m.at(&k)
    println(v.toStr() + " " + m.at(k).toStr() + " " + m.at("k").toStr() + " " + k)
    var ls = newMap[str, []int]()
    ls.put("x" + "", [2])
    let key = "x" + ""
    append(ls.atMut(&key), 3)
    let xs = ls.at(&key)
    println("[" + xs[0].toStr() + ", " + xs[1].toStr() + "]")
    let p = Pair{a: "a" + "", b: "b" + ""}
    let w = "z" + ""
    println(p.pick(&w))
}
