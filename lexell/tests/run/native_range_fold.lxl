    if x >= 97 && x <= 122 || x >= 65 && x <= 90 { m = m | 64 }
    if x >= 64 && x <= 79 || x >= 80 && x <= 95 { m = m | 128 }
    if x >= 72 && x <= 87 || x >= 88 && x <= 103 { m = m | 256 }
    if x >= 65 && x <= 90 || x >= 97 && x <= 122 || x == 95 { m = m | 512 }
    if !(x >= 48 && x <= 57) { m = m | 1024 }
    if x > 20 || x < 10 { m = m | 2048 }
    if x >= 32 && x <= 63 || x >= 0 && x <= 31 { m = m | 4096 }
    if x >= 1 && x <= 2147483646 { m = m | 8192 }
    if x >= 0 && x < 2147483647 { m = m | 16384 }
    if x >= 2147483640 && x <= 2147483646 { m = m | 32768 }
