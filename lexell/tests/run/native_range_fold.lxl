fn m_byte(x: byte): int {
    var m = 0
    if x >= 97 && x <= 122 { m = m | 1 }
    if x > 64 && x < 91 { m = m | 2 }
    if x <= 57 && x >= 48 { m = m | 4 }
    if x < 10 || x > 20 { m = m | 8 }
    if x >= 0 && x <= 0 { m = m | 16 }
    if x >= 65 && x <= 90 || x >= 97 && x <= 122 { m = m | 32 }
    if x >= 97 && x <= 122 || x >= 65 && x <= 90 { m = m | 64 }
    if x >= 64 && x <= 79 || x >= 80 && x <= 95 { m = m | 128 }
    if x >= 72 && x <= 87 || x >= 88 && x <= 103 { m = m | 256 }
    if x >= 65 && x <= 90 || x >= 97 && x <= 122 || x == 95 { m = m | 512 }
    if !(x >= 48 && x <= 57) { m = m | 1024 }
    if x > 20 || x < 10 { m = m | 2048 }
    if x >= 32 && x <= 63 || x >= 0 && x <= 31 { m = m | 4096 }
    return m
}
fn h_int(): int {
    var xs: []int = [-9223372036854775807 - 1, -2147483649, -2147483648, -2147483647, -2147483646, -101, -100, -99, -9, -8, -6, -5, -4, -1]
    for v in 0..300 { if v <= 299 { append(mut &xs, int(v)) } }
    for v in [9223372036854775807, 4294967295, 2147483648, 2147483647, 2147483646, 2147483645] { append(mut &xs, int(v)) }
    var h = 0
    var n = 0
    for x in xs {
        let m = m_int(x)
        h = h *% 1000003 +% m
        if (m & 32) != 0 { n += 1 }
    }
    println("int " + len(xs).toStr() + " " + n.toStr() + " " + h.toStr())
    return h
}
fn h_i32(): int {
    var xs: []i32 = [-2147483647 - 1, -2147483647, -2147483646, -101, -100, -99, -9, -8, -6, -5, -4, -1]
    for v in 0..300 { if v <= 299 { append(mut &xs, i32(v)) } }
    for v in [2147483647, 2147483646, 2147483645] { append(mut &xs, i32(v)) }
    var h = 0
    var n = 0
    for x in xs {
        let m = m_i32(x)
        h = h *% 1000003 +% m
        if (m & 32) != 0 { n += 1 }
    }
    println("i32 " + len(xs).toStr() + " " + n.toStr() + " " + h.toStr())
    return h
}
fn h_u32(): int {
    var xs: []u32 = [4294967295, 4294967294, 2147483648, 2147483647, 2147483646]
    for v in 0..300 { if v <= 299 { append(mut &xs, u32(v)) } }
