fn h_u64(): int {
    var xs: []u64 = [18446744073709551615, 18446744073709551614, 9223372036854775808, 9223372036854775807, 4294967296, 2147483647]
    for v in 0..300 { if v <= 299 { append(mut &xs, u64(v)) } }
    var h = 0
    var n = 0
    for x in xs {
        let m = m_u64(x)
        h = h *% 1000003 +% m
        if (m & 32) != 0 { n += 1 }
    }
    println("u64 " + len(xs).toStr() + " " + n.toStr() + " " + h.toStr())
    return h
}
fn h_byte(): int {
    var xs: []byte = []
    for v in 0..300 { if v <= 255 { append(mut &xs, byte(v)) } }
    var h = 0
    var n = 0
    for x in xs {
        let m = m_byte(x)
        h = h *% 1000003 +% m
        if (m & 32) != 0 { n += 1 }
    }
    println("byte " + len(xs).toStr() + " " + n.toStr() + " " + h.toStr())
    return h
}
fn main() {
    let a_int = h_int()
    let a_i32 = h_i32()
    let a_u32 = h_u32()
    let a_u64 = h_u64()
    let a_byte = h_byte()
}
