    if x >= 65 && x <= 90 || x >= 97 && x <= 122 { m = m | 32 }
    if x >= 97 && x <= 122 || x >= 65 && x <= 90 { m = m | 64 }
    if x >= 64 && x <= 79 || x >= 80 && x <= 95 { m = m | 128 }
    if x >= 72 && x <= 87 || x >= 88 && x <= 103 { m = m | 256 }
    if x >= 65 && x <= 90 || x >= 97 && x <= 122 || x == 95 { m = m | 512 }
    if !(x >= 48 && x <= 57) { m = m | 1024 }
    if x > 20 || x < 10 { m = m | 2048 }
    if x >= 32 && x <= 63 || x >= 0 && x <= 31 { m = m | 4096 }
    if x >= 1 && x <= 2147483646 { m = m | 8192 }
    if x >= 0 && x < 2147483647 { m = m | 16384 }
    if x >= 2147483640 && x <= 2147483646 { m = m | 32768 }
    if x >= -5 && x <= 5 { m = m | 65536 }
    if x < -100 || x > 100 { m = m | 131072 }
    if x > -2147483646 && x < 2147483646 { m = m | 262144 }
    if x >= -2147483647 && x <= -1 { m = m | 524288 }
    if x >= -8 && x <= -1 || x >= 0 && x <= 7 { m = m | 1048576 }
    return m
}
fn m_u32(x: u32): int {
    var m = 0
    if x >= 97 && x <= 122 { m = m | 1 }
    if x > 64 && x < 91 { m = m | 2 }
    if x <= 57 && x >= 48 { m = m | 4 }
    if x < 10 || x > 20 { m = m | 8 }
    if x >= 0 && x <= 0 { m = m | 16 }
