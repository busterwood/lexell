// A view with a computed negative start: &s[a..3] with a = -1. rt_str_view (C) and the inline
// view (native) both trap on a < 0: "string slice out of range", exit 3. Only this view is bad.
// expect: before
// stderr: Lexell: string slice out of range at s05_str_view_trap_neg_start.lxl:13
// exit: 3

fn main() {
    let s = "hello"
    let z = len(args()) - 1         // 0, unknown to the compiler
    println("before")
    var a = z
    a -= 1
    let v: &str = &s[a..3]
    println(v)
    println("not reached")
}
