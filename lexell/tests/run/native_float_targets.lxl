// Doubles computed in their destination register and loads of array elements as SSE memory
// operands (x64gen genFT, fMem), element addresses kept across stores (cse addrOnly): a
// destination read on the right (x = y - x, inside sqrt and a quotient), nested products and
// sums, sqrt of expressions, stores to one element then reads of it through another index
// equal to it, an index reassigned between uses, and a float converted to an index.
// expect: a 2500000
// expect: b 444444
// expect: c 3580171
// expect: d 185193614
// expect: e 0 25000000
// expect: f 700000
// expect: g 96375029
type P = value record { x: float; y: float; z: float; w: float; m: float }

fn show(v: float): str { return int(v * 1000000.0f).toStr() }

fn main() {
    var ps: []P = []
    for i in 0..7 {
        let f = float(i)
        append(mut &ps, P{x: f + 0.5f, y: 2.0f - f, z: f * f, w: 1.0f / (f + 1.0f), m: 3.0f + f})
    }
    var x = 1.5f
    let y = 4.0f
    x = y - x
    println("a " + show(x))
    x = y / (x * 2.0f + y)
    println("b " + show(x))
    x = (x * x + y * y).sqrt() - x
    println("c " + show(x))
    var acc = 0.0f
    for i in 0..len(ps) {
        for j in 0..len(ps) {
            let dx = ps[i].x - ps[j].x
            let dy = ps[i].y - ps[j].y
            let d2 = dx * dx + dy * dy + ps[i].z * ps[j].w
            let mag = 0.01f / (d2 * d2.sqrt() + 1.0f)
            ps[i].m -= dx * mag
            ps[j].m += dy * mag
            acc += ps[i].m - ps[j].m * ps[i].w
        }
    }
    println("d " + show(acc))
    var k = 2
    ps[k].x = ps[k].y * 3.0f
    k = 5
    ps[k].y = ps[2].x + ps[k].z
    println("e " + show(ps[2].x) + " " + show(ps[5].y))
    let fi = 3.7f
    ps[int(fi)].w = ps[int(fi)].w * 2.0f + ps[int(fi) + 1].w
    println("f " + show(ps[3].w))
    var s = 0.0f
    for p in &ps { s += p.x * p.y - p.z / (p.m + 10.0f) }
    println("g " + show(s))
}
