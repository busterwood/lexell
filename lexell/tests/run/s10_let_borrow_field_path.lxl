// SPEC 10, rule 4: a let borrow of a field freezes that field, not the whole variable.
// expect: 5
// expect: 8
// expect: 12
type In = record { a: int; b: str }
type D = record { s: str; pos: int; inner: In; xs: []int }
fn bump(n: mut &int) { n += 1 }
fn step(d: mut &D): int {
    let s = &d.s
    d.pos += 1                 // another field: allowed now
    bump(mut &d.pos)           // a mut borrow of another field: allowed
    d.inner.a = 5              // a deeper path elsewhere: allowed
    return len(s) + d.pos
}
fn step2(d: mut &D): int {
    let b = &d.inner.b
    d.inner.a += 1             // sibling below the same record: allowed
    return len(b) + d.inner.a
}
fn main() {
    var d = D{s: "abc", pos: 0, inner: In{a: 1, b: "xy"}, xs: [1, 2]}
    println(step(mut &d))
    println(step2(mut &d))
    let t = &d.s
    d.pos = 9
    println(len(t) + d.pos)
}
