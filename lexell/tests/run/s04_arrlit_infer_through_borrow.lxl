// SPEC 4.2: an array literal passed where a &[]T is expected takes T as its element type, so an empty
// [] needs no annotation.
// expect: 4
fn total(xs: &[]int): int { var t = 0; for x in xs { t += x }; return t }
fn names(xs: &[]str): int { return len(xs) }
fn main() {
    println(total([]) + total([1, 2]) + names([]) + names(["a"]))
}
