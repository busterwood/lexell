// design/owned-str.md issue 4: x.clone() is a deep copy of an array, record or closed type whose
// parts are cloneable; a type's own clone method wins; Map.get clones a record value.
// expect: root 4 changed 5
// expect: 13v
// expect: 23
// expect: n
// expect: opt
// expect: 101
// expect: 2changed5
type Node = record { name: str; kids: []Node }
type V = value record { tag: str; xs: []int }
type Shape = closed { Circle(int); Poly([]str); Named(Node) }
type Counted = record { n: int }
fn (c: &Counted) clone(): Counted { return Counted{n: c.n + 100} }   // its own clone wins
type Holder = record { c: Counted; label: str }
fn size(n: &Node): int {
    var k = 1
    for c in n.kids { k += size(&c) }
    return k
}
fn dupAll[T: Clone](x: &T): []T { return [x.clone(), x.clone()] }
fn main() {
    var t = Node{name: "root", kids: [Node{name: "a", kids: []}, Node{name: "b", kids: [Node{name: "c", kids: []}]}]}
    let u = t.clone()
    t.name = "changed"
    append(mut &t.kids, Node{name: "d", kids: []})
    println(u.name + " " + intToStr(size(&u)) + " " + t.name + " " + intToStr(size(&t)))
    var v = V{tag: "v", xs: [1, 2, 3]}
    let w = v.clone()
    v.xs[0] = 99
    println(intToStr(w.xs[0]) + intToStr(len(w.xs)) + w.tag)
    let grid = [["a", "b"], ["c"]]
    var g2 = grid.clone()
    append(mut &g2[0], "z")
    println(intToStr(len(grid[0])) + intToStr(len(g2[0])))
    let shapes = [Shape.Circle(3), Shape.Poly(["p", "q"]), Shape.Named(Node{name: "n", kids: []})]
    let s2 = shapes.clone()
    match s2[2] { Shape.Named(n) { println(n.name) } else {} }
    let o: Option[Node] = Some(Node{name: "opt", kids: []})
    let o2 = o.clone()
    match o2 { Some(n) { println(n.name) } None {} }
    let h = Holder{c: Counted{n: 1}, label: "h"}
    println(intToStr(h.clone().c.n))
    let many = dupAll(&t)
    println(intToStr(len(many)) + many[1].name + intToStr(size(&many[0])))
}
