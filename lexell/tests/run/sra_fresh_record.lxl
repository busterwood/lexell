// Records that never escape, and value records declared by a literal, become one local per field
// when their fields are only written and read one by one (opt.lxl scalars, fresh candidates):
// unboxed, literal (fields written in branches, compound assignment), floats. They stay records
// when copied whole and then written (copied), when their address is taken (byref), when a field
// is a record read whole and member by member (nested), and with a str field (strs: no leak
// under LXL_CHECK=1). byvalue passes the record whole to a function that is inlined.
// expect: unboxed 999000
// expect: literal 2004000
// expect: copied 600500
// expect: byref 1002000
// expect: byvalue 999000
// expect: nested 510500
// expect: floats 749250
// expect: strs 504390
type Cell = record { v: int; w: int }
type P = value record { a: int; b: int; c: int }
type Q = value record { p: P; k: int }
type F = value record { x: float; y: float }
type S = value record { name: str; n: int }

fn unboxed(n: int): int {
    var total = 0
    for i in 0..n {
        let c = Cell{v: i, w: 2}
        total = total + c.v * c.w
    }
    return total
}

fn literal(n: int): int {
    var s = 0
    for i in 0..n {
        var p = P{a: i, b: i * 2, c: 3}
        p.a = p.a + p.c
        p.b += 1
        if i % 2 == 0 { p.c = p.a } else { p.a = p.b }
        s = s + p.a + p.b + p.c
    }
    return s
}

fn copied(n: int): int {
    var s = 0
    for i in 0..n {
        var p = P{a: i, b: 1, c: 2}
        p.a = p.a + 1
        let q = p
        p.a = 100
        s = s + q.a + p.a
    }
    return s
}

fn sum3(p: &P): int { return p.a + p.b + p.c }

fn byRef(n: int): int {
    var s = 0
    for i in 0..n {
        var p = P{a: i, b: 2, c: 3}
        p.b = p.a
        s = s + sum3(&p)
    }
    return s
}

fn whole(p: P): int { return p.a * p.b - p.c }

fn byValue(n: int): int {
    var s = 0
    for i in 0..n {
        var p = P{a: i, b: 3, c: 1}
        p.c = i
        s = s + whole(p)
    }
    return s
}

fn nested(n: int): int {
    var s = 0
    for i in 0..n {
        var q = Q{p: P{a: i, b: 1, c: 2}, k: 5}
        q.p.a = q.p.a + q.k
        let pp = q.p
        s = s + pp.a + q.p.b + q.k
    }
    return s
}

fn floats(n: int): float {
    var s = 0.0f
    for i in 0..n {
        var f = F{x: float(i), y: 0.5f}
        f.y = f.y * f.x
        s = s + f.x + f.y
    }
    return s
}

fn strs(n: int): int {
    var t = 0
    for i in 0..n {
        var r = S{name: "n" + i.toStr(), n: i}
        r.n = r.n + len(r.name)
        r.name = "x"
        t = t + r.n + len(r.name)
    }
    return t
}

fn main() {
    println("unboxed " + unboxed(1000).toStr())
    println("literal " + literal(1000).toStr())
    println("copied " + copied(1000).toStr())
    println("byref " + byRef(1000).toStr())
    println("byvalue " + byValue(1000).toStr())
    println("nested " + nested(1000).toStr())
    println("floats " + floats(1000).toStr())
    println("strs " + strs(1000).toStr())
}
