// Parameters that arrive in rdi, rsi, r8 or r9 stay there when nothing after the entry changes
// them (x64gen arrivesQuiet): a comparator, six and eight parameters (r8 and r9; two on the
// stack), an aggregate result in memory (its address takes rdi), a parameter read after a call,
// doubles and integers mixed, a guard, narrow types, and calls through function values.
// expect: bykey 588
// expect: six 2 eight 43
// expect: make 6 7 13 42
// expect: after 38
// expect: mixed 5.25
// expect: guarded 7 22
// expect: narrow 1195
// expect: apply 29 0
type Rec = value record { key: int; name: str }
type Big = value record { a: int; b: int; c: int; d: int }

fn byKey(a: &Rec, b: &Rec): int { return a.key.cmp(&b.key) }

// six integer parameters: rdi, rsi, rdx, rcx, r8, r9 (r8 and r9 are quiet too)
fn six(a: int, b: int, c: int, d: int, e: int, f: int): int { return a - b + c * d - e * 3 + f }

// eight: the last two on the stack
fn eight(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int { return a + b * 2 + c - d + e + f * g - h }

// an aggregate result in memory: its address takes rdi, so a arrives in rsi
fn make(a: int, b: int): Big { return Big{a: a, b: b, c: a + b, d: a * b} }

// a parameter read after a call (it moves to a saved register)
fn after(x: int, y: int): int {
    let s = six(x, y, 1, 2, 3, 4)
    return s + x * y
}

// doubles and integers mixed
fn mixed(a: float, i: int, b: float, j: int): float { return a * float(i) + b - float(j) }

// a guard on a parameter, then work
fn guarded(n: int, k: int): int {
    if n < 0 { return k }
    return n * k + 1
}

// narrow parameters
fn narrow(a: byte, b: i32, c: bool): int { return int(a) + int(b) + (if c { 1000 } else { 0 }) }

fn apply(f: &fn(int, int): int, x: int, y: int): int { return f(x, y) }

fn main() {
    var rs: []Rec = []
    for i in 0..50 { append(mut &rs, Rec{key: (i * 37) % 50, name: "r" + i.toStr()}) }
    var s = 0
    for i in 0..49 { s = s + byKey(&rs[i], &rs[i + 1]) * i }
    println("bykey " + s.toStr())
    println("six " + six(1, 2, 3, 4, 5, 6).toStr() + " eight " + eight(1, 2, 3, 4, 5, 6, 7, 8).toStr())
    let m = make(6, 7)
    println("make " + m.a.toStr() + " " + m.b.toStr() + " " + m.c.toStr() + " " + m.d.toStr())
    println("after " + after(5, 9).toStr())
    println("mixed " + mixed(1.5f, 4, 2.25f, 3).toStr())
    println("guarded " + guarded(-1, 7).toStr() + " " + guarded(3, 7).toStr())
    println("narrow " + narrow(byte(200), i32(-5), true).toStr())
    let k = 11
    println("apply " + apply(fn(a: int, b: int): int { return a * k - b }, 3, 4).toStr() + " " + apply(six2, 8, 2).toStr())
}

fn six2(a: int, b: int): int { return six(a, b, a, b, a, b) }
