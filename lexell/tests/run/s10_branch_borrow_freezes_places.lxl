// A borrow given by an if or match expression freezes only the places its branches borrow
// (SPEC 10 rule 4): writes to the record's other fields go on while it is in scope.
// expect: a 1
// expect: a 5
// expect: b 7

type Cursor = record { at: str; started: bool; n: int }

fn step(cur: mut &Cursor, hi: &str, was: bool) {
    let to: &str = if was { &cur.at } else { hi }
    cur.started = true
    cur.n += 1
    println(to + " " + cur.n.toStr())
}

fn main() {
    var c = Cursor{at: "a" + "", started: false, n: 0}
    step(mut &c, "h", true)
    let s: &str = match c.n { 1 { &c.at } else { "lit" } }
    c.n = 5
    println(s + " " + c.n.toStr())
    var d = Cursor{at: "a" + "", started: false, n: 1}
    let hi = "b" + ""
    let t: &str = if d.n == 0 { &d.at } else if d.n == 1 { &hi } else { "lit" }
    d.n = 7
    println(t + " " + d.n.toStr())
}
