// In-range views of str locals and of members of a local record, built inline by the
// native backend (x64gen genView) and by rt_str_view in C: the bytes printed are checked.
// Start 0, middle, end, the empty view s[3..3], the whole string s[0..len]; bounds from a
// local record; a view assigned to a variable and re-sliced; a view in a loop whose bound
// changes. Every view is printed with its length, so an empty or shifted view shows.
// expect: [hel] 3
// expect: [] 0
// expect: [hello world] 11
// expect: [orld] 4
// expect: [] 0
// expect: [hello world] 11
// expect: [world] 5
// expect: [wor] 3
// expect: [d] 1
// expect: [hello] 5
// expect: [ world] 6
// expect: [ello world] 10
// expect: [llo] 3
// expect: [or] 2
// expect: [] 0
// expect: [h] 1
// expect: [he] 2
// expect: [hel] 3
// expect: [hell] 4
// expect: [hello] 5
// expect: done
// exit: 0

type Span = value record {
    lo: int
    hi: int
}

type Doc = record {
    text: str
    span: Span
}

fn show(v: &str) {
    println("[" + v + "] " + len(v).toStr())
}

fn main() {
    let s = "hello world"
    let n = len(s)
    let zero = 0
    let three = 3
    let five = 5
    show(&s[zero..three])
    show(&s[zero..zero])
    show(&s[zero..n])
    show(&s[n - 4..n])
    show(&s[three..three])
    show(&s[zero..n])

    let sp = Span{lo: 6, hi: 11}
    show(&s[sp.lo..sp.hi])
    show(&s[sp.lo..sp.lo + 3])
    show(&s[sp.hi - 1..sp.hi])

    // a str in a record, the bounds of the same record
    let d = Doc{text: "hello world", span: Span{lo: 0, hi: 5}}
    show(&d.text[d.span.lo..d.span.hi])
    show(&d.text[five..n])

    // a view assigned to a variable, then re-sliced
    var v: &str = &s[0..n]
    v = &v[1..]
    show(v)
    v = &v[1..4]
    show(v)
    let w: &str = &s[6..11]
    show(&w[1..3])

    // a view inside a loop, the end bound changing
    for k in 0..6 {
        show(&s[0..k])
    }
    println("done")
}
