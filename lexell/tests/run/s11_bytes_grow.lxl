// bytesGrow(mut &b, n) adds n zero bytes with one capacity check and returns
// where they start; the bytes are written by index (SPEC 11). A negative n
// stops the program (exit 2).
// expect: 0 0 4
// expect: 1 2 3 4 120
// expect: 7008 6998 231 0 0
// stderr: Lexell: bytesGrow: negative length at s11_bytes_grow.lxl:25
// exit: 2
fn main() {
    var b: []byte = []
    let a0 = bytesGrow(mut &b, 0)
    let a = bytesGrow(mut &b, 4)
    println(a0.toStr() + " " + a.toStr() + " " + len(b).toStr())
    for i in 0..4 { b[a + i] = byte(i + 1) }
    append(mut &b, 'x')
    println(int(b[0]).toStr() + " " + int(b[1]).toStr() + " " + int(b[2]).toStr() + " " + int(b[3]).toStr() + " " + int(b[4]).toStr())
    var last = 0
    for i in 0..1000 {
        last = bytesGrow(mut &b, 7)
        b[last + 6] = byte(i & 0xff)
    }
    let z = bytesGrow(mut &b, 3)
    println(len(b).toStr() + " " + last.toStr() + " " + int(b[last + 6]).toStr() + " " + int(b[last]).toStr() + " " + int(b[z + 2]).toStr())
    let n = -1
    let bad = bytesGrow(mut &b, n)
    println("not reached " + bad.toStr())
}
