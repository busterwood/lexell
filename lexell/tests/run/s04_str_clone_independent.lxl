// SPEC 4.1 (design/owned-str.md): str is owned: var b = a.clone() is an independent string, so
// appending to b leaves a as it was; let c = a moves a.
// expect: hello
// expect: hello world
// expect: hello
fn main() {
    let a = "hello" + ""
    var b = a.clone()
    b = b + " world"
    println(a)
    println(b)
    let c = a
    println(c)
}
