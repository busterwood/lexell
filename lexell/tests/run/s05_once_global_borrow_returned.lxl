// A borrow of a set-once global's value is static: a function without borrowed parameters may
// return it, and so may one that returns another borrow (SPEC 5.2, 10 rule 5). One shared record
// for the whole program, lent out.
// expect: UTC n1 UTC CET
type Zone = record { name: str; off: int }
var UTC: once Zone
var NAMES: once []str
fn utc(): &Zone { return UTC.get() }
fn first(): &str { return &NAMES.get()[0] }
fn pick(z: &Zone, useUtc: bool): &Zone { return if useUtc { UTC.get() } else { z } }
fn main() {
    UTC.set(Zone{name: "UTC" + "", off: 0})
    NAMES.set(["n" + "1"])
    let z = utc()
    let other = Zone{name: "CET" + "", off: 60}
    println(z.name + " " + first() + " " + pick(&other, true).name + " " + pick(&other, false).name)
}
