// A var borrow initialised from a static string takes its roots from the first store that borrows
// something (SPEC 10 rule 7), as a var of a type holding borrows does.
// expect: a
// expect: z

fn main() {
    var a = "a" + ""
    var s: &str = ""
    if len(a) > 0 { s = &a }
    println(s)
    a = "z"
    println(a)
}
