// A view whose end is past the string: &s[1..b] with b = len + 1 = 6 on "hello". The
// inline view (native) and rt_str_view (C) both trap: "string slice out of range", exit 3.
// Only this view is bad.
// expect: before
// stderr: Lexell: string slice out of range at s05_str_view_trap_end_past_len.lxl:15
// exit: 3

fn main() {
    let s = "hello"
    let z = len(args()) - 1         // 0, unknown to the compiler
    println("before")
    let n = len(s)
    var b = n
    b += 1 + z
    let v: &str = &s[1..b]
    println(v)
    println("not reached")
}
