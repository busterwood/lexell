// SPEC 11: array(n, v) clones an owned v into each element: the elements are independent.
// expect: 21xyx
// expect: 2
type N = record { s: str; xs: []int }
fn main() {
    var a = array(3, N{s: "x" + "", xs: [1]})
    append(mut &a[0].xs, 2)
    a[1].s = "y"
    println(intToStr(len(a[0].xs)) + intToStr(len(a[1].xs)) + a[0].s + a[1].s + a[2].s)
    let b = array(2, [5])
    println(len(b))
}
