// SPEC 9.1: taking apart a value record. One holding a str is owned: taking it apart needs a value,
// a clone (v stays usable) or the last use of a local (move).
// expect: hi 4
// expect: hi 3
// expect: 7
type V = value record { s: str; k: int }
type W = value record { v: V; z: int }
fn main() {
    let v = V{s: "hi", k: 3}
    var V{s, k} = v.clone()
    k += 1
    println(s + " " + k.toStr())
    println(v.s + " " + v.k.toStr())
    let w = W{v: v, z: 4}
    let W{v: inner, z} = move(w)
    println(inner.k + z)
}
