// A drop action of a recursive type keeps the values of its own type in a stack of its own
// (emit selfLoop, DSTACK) before the worklist when no drop method is reachable from the type:
// balanced trees, a tree whose left spine is far deeper than that stack (the rest on the
// worklist), nodes with strings and arrays in them, an exhaustive match's last arm untested
// (check: the arm is an else), and a type with a drop method, whose drops keep their order
// (the worklist alone).
// expect: balanced 4095 4095
// expect: spine 2000
// expect: strings 1023 2047
// expect: last 3 2 1
// expect: drop a1 a2 a3
type T = record { left: Option[T]; right: Option[T] }
type S = record { name: str; xs: []int; kids: Option[S]; next: Option[S] }
type D = record { tag: str; next: Option[D] }
type Shape = value closed { Dot; Line(int); Box(int, int) }

var dropped: str = ""

fn (d: mut &D) drop() { dropped = dropped + " " + d.tag }

fn build(n: int): Option[T] {
    if n == 0 { return None }
    return Some(T{left: build(n - 1), right: build(n - 1)})
}

fn count(t: &Option[T]): int {
    match t {
        Some(x) { return 1 + count(&x.left) + count(&x.right) }
        None { return 0 }
    }
}

fn spine(n: int): Option[T] {
    var t: Option[T] = None
    for i in 0..n { t = Some(T{left: move(t), right: Some(T{left: None, right: None})}) }
    return t
}

fn strs(n: int): Option[S] {
    if n == 0 { return None }
    return Some(S{name: "n" + n.toStr(), xs: [n, n + 1], kids: strs(n - 1), next: strs(n - 1)})
}

fn sumS(s: &Option[S]): int {
    match s {
        Some(x) { return 1 + sumS(&x.kids) + sumS(&x.next) }
        None { return 0 }
    }
}

fn lenS(s: &Option[S]): int {
    match s {
        Some(x) { return len(x.name) + lenS(&x.kids) + lenS(&x.next) }
        None { return 0 }
    }
}

fn arity(s: Shape): int {
    match s {
        Shape.Box(a, b) { return 3 }
        Shape.Line(a) { return 2 }
        Shape.Dot { return 1 }
    }
}

fn main() {
    var total = 0
    for r in 0..3 {
        let t = build(12)
        total = count(&t)
    }
    println("balanced " + total.toStr() + " " + count(&build(12)).toStr())
    let sp = spine(1000)
    println("spine " + count(&sp).toStr())
    let s = strs(10)
    println("strings " + sumS(&s).toStr() + " " + lenS(&s).toStr())
    println("last " + arity(Shape.Box(1, 2)).toStr() + " " + arity(Shape.Line(1)).toStr() + " " + arity(Shape.Dot).toStr())
    var d: Option[D] = None
    for i in 0..3 { d = Some(D{tag: "a" + (3 - i).toStr(), next: move(d)}) }
    d = None
    println("drop" + dropped)
}
