// SPEC 4.7: a type parameter constrained by Clone (or copy) is cloneable: array(n, x) of a T: Clone,
// and the built-in clone of a generic record of T, work per instance.
// expect: abab3x2x
// expect: 2
type W[T] = record { a: T; n: int }
fn fill[T: Clone](n: int, x: &T): []T { return array(n, x.clone()) }
fn dupw[T: Clone](w: &W[T]): W[T] { return w.clone() }
fn main() {
    let xs = fill(3, &("ab" + ""))
    let w = W[str]{a: "x" + "", n: 2}
    let v = dupw(&w)
    println(xs[0] + xs[2] + intToStr(len(xs)) + v.a + intToStr(v.n) + w.a)
    let ys = fill(2, &[1, 2])
    println(len(ys[1]))
}
