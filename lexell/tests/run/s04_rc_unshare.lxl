// SPEC 4.9: unshare lends the only handle's value in place, and copies a shared one first.
// expect: t2
// expect: t*3 t2
type Doc = record { title: str; words: []str }
fn (d: mut &Doc) add(w: &str) { append(mut &d.words, w.clone()) }
fn edit(d: mut &Doc) { d.title = d.title + "*" }
fn main() {
    var a: rc Doc = rc(Doc{title: "t", words: ["x" + ""]})
    let m = a.unshare()                 // the only handle: lent in place
    m.add("y")
    println(a.title + intToStr(len(a.words)))
    let b = a.share()
    a.unshare().add("z")                // shared: a gets its own copy first
    edit(a.unshare())
    println(a.title + intToStr(len(a.words)) + " " + b.title + intToStr(len(b.words)))
}
