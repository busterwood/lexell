// SPEC 9.1: a field of a temporary record can be moved out; the other fields drop at once.
// expect: p1 in2 y
// expect: p3!
// expect: drop 7
// expect: after q
// expect: 4
type In = record { a: []int; b: str }
type P = record { name: str; inner: In; n: int }
type V = value record { tag: str; xs: []str }
type D = record { id: int }
fn (d: mut &D) drop() { println("drop " + d.id.toStr()) }
type Q = record { d: D; s: str }
fn mk(k: int): P { return P{name: "p" + k.toStr(), inner: In{a: [k, k], b: "in"}, n: k} }
fn mv(): V { return V{tag: "t", xs: ["x", "y"]} }
fn mq(): Q { return Q{d: D{id: 7}, s: "q"} }
fn keep(s: str): str { return s + "!" }
fn main() {
    let a = mk(1).name                     // a field moved out of a temporary record
    let b = mk(2).inner                    // a record field
    let c = mv().xs                        // out of a temporary value record
    println(a + " " + b.b + intToStr(len(b.a)) + " " + c[1])
    println(keep(mk(3).name))              // as an argument
    let s = mq().s                         // the other field's drop runs now
    println("after " + s)
    let n = mk(4).n                        // a copy field: a read, nothing moved
    println(n)
}
