// An Option of a box is the box's pointer, None the null pointer (sema niche: a value type of two
// variants, one without fields and one with a box): lists and trees built, walked, cloned,
// compared, hashed, shown and dropped; arrays and maps of them; a user type with the empty
// variant first; an Option of an Option of a box (the outer one keeps its tag); an iterator whose
// next returns one; a Result made from a niche type; replace; a boxed closed type in an Option.
// expect: list 4950 100 true
// expect: clone 4950 eq true ne false
// expect: tree 1023 depth 10
// expect: array 3 none 2
// expect: map 2 hit 7
// expect: leaf 0 branch 42
// expect: nested some-none some-some none
// expect: iter 15
// expect: try 9 err
// expect: take 5 left none
// expect: shape Circle(2) none
// expect: show Some(Node{v: 1, next: None})
// expect: eq true false true hash true false
import "collections"

type Node = record { v: int; next: Option[Node] }
type Tree = record { left: Option[Tree]; right: Option[Tree] }
type Maybe[T: borrow] = value closed { Nothing; Just(T) }
type Res = value closed { Ok(Node); Bad }
type Shape = closed { Circle(int); Square(int) }

fn sum(l: &Option[Node]): int {
    match l {
        Some(n) { return n.v + sum(&n.next) }
        None { return 0 }
    }
}

fn count(l: &Option[Node]): int {
    var c = 0
    var cur = l
    while true {
        match cur {
            Some(n) {
                c += 1
                cur = &n.next
            }
            None { break }
        }
    }
    return c
}

fn build(d: int): Option[Tree] {
    if d == 0 { return None }
    return Some(Tree{left: build(d - 1), right: build(d - 1)})
}

fn nodes(t: &Option[Tree]): int {
    match t {
        Some(x) { return 1 + nodes(&x.left) + nodes(&x.right) }
        None { return 0 }
    }
}

fn depth(t: &Option[Tree]): int {
    match t {
        Some(x) { return 1 + depth(&x.left) }
        None { return 0 }
    }
}

type Walk = record { cur: Option[Node] }

fn (w: mut &Walk) next(): Option[Node] {
    let c = replace(mut &w.cur, None)
    match c {
        Some(n) {
            w.cur = n.next.clone()
            return Some(Node{v: n.v, next: None})
        }
        None { return None }
    }
}

fn get(ok: bool): Res {
    if ok { return Res.Ok(Node{v: 9, next: None}) }
    return Res.Bad
}

fn tryIt(ok: bool): Result[int, str] {
    match get(ok) {
        Res.Ok(n) { return Ok(n.v) }
        Res.Bad { return Err("err") }
    }
}

fn main() {
    var l: Option[Node] = None
    for i in 0..100 { l = Some(Node{v: i, next: move(l)}) }
    println("list " + sum(&l).toStr() + " " + count(&l).toStr() + " " + l.isSome().toStr())
    let c = l.clone()
    let other: Option[Node] = None
    println("clone " + sum(&c).toStr() + " eq " + (count(&c) == count(&l)).toStr() + " ne " + other.isSome().toStr())
    let t = build(10)
    println("tree " + nodes(&t).toStr() + " depth " + depth(&t).toStr())
    var arr: []Option[Node] = []
    for i in 0..5 { append(mut &arr, if i % 2 == 0 { Some(Node{v: i, next: None}) } else { None }) }
    var nn = 0
    var ss = 0
    for x in arr {
        match x {
            Some(_) { ss += 1 }
            None { nn += 1 }
        }
    }
    println("array " + ss.toStr() + " none " + nn.toStr())
    var m: Map[str, Option[Node]] = newMap()
    m.put("a", Some(Node{v: 7, next: None}))
    m.put("b", None)
    let hit = match m.get(&"a") {
        Some(o) { match o { Some(n) { n.v } None { -1 } } }
        None { -2 }
    }
    println("map " + m.size().toStr() + " hit " + hit.toStr())
    let a: Maybe[Node] = Maybe.Nothing
    let b: Maybe[Node] = Maybe.Just(Node{v: 42, next: None})
    let av = match a { Maybe.Just(n) { n.v } Maybe.Nothing { 0 } }
    let bv = match b { Maybe.Just(n) { n.v } Maybe.Nothing { 0 } }
    println("leaf " + av.toStr() + " branch " + bv.toStr())
    let o1: Option[Option[Node]] = Some(None)
    let o2: Option[Option[Node]] = Some(Some(Node{v: 1, next: None}))
    let o3: Option[Option[Node]] = None
    let d1 = match o1 { Some(x) { if x.isSome() { "some-some" } else { "some-none" } } None { "none" } }
    let d2 = match o2 { Some(x) { if x.isSome() { "some-some" } else { "some-none" } } None { "none" } }
    let d3 = match o3 { Some(x) { if x.isSome() { "some-some" } else { "some-none" } } None { "none" } }
    println("nested " + d1 + " " + d2 + " " + d3)
    var w = Walk{cur: None}
    var chain: Option[Node] = None
    for i in 1..6 { chain = Some(Node{v: i, next: move(chain)}) }
    w.cur = chain
    var it = 0
    for n in w { it += n.v }
    println("iter " + it.toStr())
    let r1 = match tryIt(true) { Ok(v) { v.toStr() } Err(e) { e } }
    let r2 = match tryIt(false) { Ok(v) { v.toStr() } Err(e) { e } }
    println("try " + r1 + " " + r2)
    var slot: Option[Node] = Some(Node{v: 5, next: None})
    let took = replace(mut &slot, None)
    let tv = match took { Some(n) { n.v } None { -1 } }
    println("take " + tv.toStr() + " left " + (if slot.isSome() { "some" } else { "none" }))
    let sh: Option[Shape] = Some(Shape.Circle(2))
    let sn: Option[Shape] = None
    let shs = match sh { Some(x) { match x { Shape.Circle(r) { "Circle(" + r.toStr() + ")" } Shape.Square(s) { "Square" } } } None { "none" } }
    println("shape " + shs + " " + (if sn.isSome() { "some" } else { "none" }))
    let one: Option[Node] = Some(Node{v: 1, next: None})
    println("show " + one.toStr())
    let two: Option[Node] = Some(Node{v: 1, next: None})
    let none2: Option[Node] = None
    println("eq " + (one == two).toStr() + " " + (one == none2).toStr() + " " + (none2 == other).toStr() + " hash " + (one.hash() == two.hash()).toStr() + " " + (one.hash() == none2.hash()).toStr())
}
