// expect: 23 12377 673
// expect: 24 12531 526
// a forward jump over 1 statements, in a loop
fn f1(x: int): int {
    var s = x
    for i in 0..10 {
        if i % 3 == 1 {
            s = (s ^ (i + 3)) & 1048575
        }
        s = s + 1
    }
    return s
}

// a loop of 1 statements: its back jump
fn w1(x: int): int {
    var s = x
    var i = 0
    while i < x % 7 + 5 {
        s = (s ^ (i +% 3)) & 1048575
        i += 1
    }
    return s
}

