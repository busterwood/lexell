// Small records allocated and freed by inline code (x64gen memInline, native/rt.c rt_mheap):
// lists long enough to span several 2 MB chunks (frees of blocks outside the current chunk take
// rt_free), records of several size classes, boxes kept across rounds, and the same again after
// a par.map has started its pool (the inline paths then call the runtime: inline_ok is 0).
// expect: before 39150405000 9
// expect: par 204
// expect: after 39150405000 9
import "par"

type N1 = record { v: int; next: Option[N1] }

type N3 = record { a: int; b: int; c: int; d: int; e: int; next: Option[N3] }

type Big = record { a: int; b: int; c: int; d: int; e: int; f: int; g: int; h: int; i: int; j: int; k: int; l: int; m: int; n: int }

fn list1(n: int): Option[N1] {
    var l: Option[N1] = None
    for i in 0..n { l = Some(N1{v: i, next: move(l)}) }
    return l
}

fn sum1(l: &Option[N1]): int {
    var s = 0
    var cur = l
    while true {
        match cur {
            Some(n) {
                s += n.v
                cur = &n.next
            }
            None { break }
        }
    }
    return s
}

fn list3(n: int): Option[N3] {
    var l: Option[N3] = None
    for i in 0..n { l = Some(N3{a: i, b: 1, c: 2, d: 3, e: 4, next: move(l)}) }
    return l
}

fn sum3(l: &Option[N3]): int {
    var s = 0
    var cur = l
    while true {
        match cur {
            Some(n) {
                s += n.a + n.e
                cur = &n.next
            }
            None { break }
        }
    }
    return s
}

fn rounds(tag: str) {
    var keep: []Big = []
    var total = 0
    for r in 0..3 {
        let a = list1(150000)
        let b = list3(60000)
        total += sum1(&a) + sum3(&b)
        append(mut &keep, Big{a: r, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0, i: 0, j: 0, k: 0, l: 0, m: 0, n: r * 2})
    }
    var kept = 0
    for x in keep { kept += x.a + x.n }
    println(tag + " " + total.toStr() + " " + kept.toStr())
}

fn main() {
    rounds("before")
    let xs = [1, 2, 3, 4, 5, 6, 7, 8]
    let ys = par.map(&xs, fn(x: &int): int { return x * x })
    var s = 0
    for y in ys { s += y }
    println("par " + s.toStr())
    rounds("after")
}
