// Exhaustive test for hardware-inlined checkedAdd/Sub/Mul and 128-bit conversions.
// expect: i64 -9020658609770795845
// expect: i32 -5356112697979569161
// expect: u32 7964167219571578051
// expect: u64 9407600643475494083
// expect: 3037000498
// expect: 27670116119154262017
// expect: 1999999999999999799
fn mixI(h: int, v: int): int { return (h ^ v) *% 1099511628211 }

fn mixU(h: u64, v: u64): u64 { return (h ^ v) *% u64(1099511628211) }

fn foldOpt(h: int, o: Option[int], noneTag: int): int {
    return match o { Some(v) { mixI(mixI(h, 1), v) } None { mixI(h, noneTag) } }
}

fn foldOptI32(h: int, o: Option[i32], noneTag: int): int {
    return match o { Some(v) { mixI(mixI(h, 1), int(v)) } None { mixI(h, noneTag) } }
}

fn foldOptU32(h: u64, o: Option[u32], noneTag: u64): u64 {
    return match o { Some(v) { mixU(mixU(h, u64(1)), u64(v)) } None { mixU(h, noneTag) } }
}

fn foldOptU64(h: u64, o: Option[u64], noneTag: u64): u64 {
    return match o { Some(v) { mixU(mixU(h, u64(1)), v) } None { mixU(h, noneTag) } }
}

fn main() {
    let i64s: []int = [0, 1, -1, 2, -2, 3037000499, 3037000500, -3037000500, 9223372036854775807, -9223372036854775807 - 1, 4611686018427387904, -4611686018427387904]
    var h64 = 1469598103934665603
    for a in i64s {
        for b in i64s {
            h64 = foldOpt(h64, a.checkedAdd(b), 2)
            h64 = foldOpt(h64, a.checkedSub(b), 3)
            h64 = foldOpt(h64, a.checkedMul(b), 4)
        }
    }
    println("i64 " + h64.toStr())

    let i32s: []i32 = [i32(0), i32(1), i32(-1), i32(2), i32(-2), i32(46340), i32(46341), i32(-46341), i32(2147483647), i32(-2147483647) - i32(1)]
    var h32 = 1469598103934665603
    for a in i32s {
        for b in i32s {
            h32 = foldOptI32(h32, a.checkedAdd(b), 2)
            h32 = foldOptI32(h32, a.checkedSub(b), 3)
            h32 = foldOptI32(h32, a.checkedMul(b), 4)
        }
    }
    println("i32 " + h32.toStr())

    let u32s: []u32 = [u32(0), u32(1), u32(2), u32(65535), u32(65536), u32(4294967295), u32(2147483648)]
    var hu32 = u64(1469598103934665603)
    for a in u32s {
        for b in u32s {
            hu32 = foldOptU32(hu32, a.checkedAdd(b), u64(2))
            hu32 = foldOptU32(hu32, a.checkedSub(b), u64(3))
            hu32 = foldOptU32(hu32, a.checkedMul(b), u64(4))
        }
    }
    println("u32 " + hu32.toStr())

    let u64s: []u64 = [u64(0), u64(1), u64(2), u64(4294967295), u64(4294967296), u64(0) -% u64(1), u64(1) << 63]
    var hu64 = u64(1469598103934665603)
    for a in u64s {
        for b in u64s {
            hu64 = foldOptU64(hu64, a.checkedAdd(b), u64(2))
            hu64 = foldOptU64(hu64, a.checkedSub(b), u64(3))
            hu64 = foldOptU64(hu64, a.checkedMul(b), u64(4))
        }
    }
    println("u64 " + hu64.toStr())

    // 128-bit widening & narrowing
    var acc: i128 = 0
    for a in i64s {
        let w = i128(a)
        acc += w
        if int(w) != a { println("FAIL i128 roundtrip") }
    }
    println(acc.toStr())
    var uacc: u128 = 0
    for a in u64s {
        let w = u128(a)
        uacc += w
    }
    println(uacc.toStr())

    // Test in a loop (as lexdb_vec.arith does)
    var xs: []int = [10, 20, -30, 1000000000, 9223372036854775807]
    var ys: []int = [3, -4, 5, 2000000000, 2]
    var sum = 0
    for i in 0..len(xs) {
        match xs[i].checkedMul(ys[i]) {
            Some(v) { sum += v }
            None { sum += -1 }
        }
    }
    println(sum.toStr())
}
