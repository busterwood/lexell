// Exhaustive differential test for hardware-inlined checkedAdd/Sub/Mul and 128-bit conversions.
fn checkI64(a: int, b: int) {
    let s1 = a.checkedAdd(b)
    let s2 = a.checkedSub(b)
    let s3 = a.checkedMul(b)
    print(match s1 { Some(v) { v.toStr() } None { "N" } } + " ")
    print(match s2 { Some(v) { v.toStr() } None { "N" } } + " ")
    println(match s3 { Some(v) { v.toStr() } None { "N" } })
}

fn checkI32(a: i32, b: i32) {
    let s1 = a.checkedAdd(b)
    let s2 = a.checkedSub(b)
    let s3 = a.checkedMul(b)
    print(match s1 { Some(v) { int(v).toStr() } None { "N" } } + " ")
    print(match s2 { Some(v) { int(v).toStr() } None { "N" } } + " ")
    println(match s3 { Some(v) { int(v).toStr() } None { "N" } })
}

fn checkU32(a: u32, b: u32) {
    let s1 = a.checkedAdd(b)
    let s2 = a.checkedSub(b)
    let s3 = a.checkedMul(b)
    print(match s1 { Some(v) { int(v).toStr() } None { "N" } } + " ")
    print(match s2 { Some(v) { int(v).toStr() } None { "N" } } + " ")
    println(match s3 { Some(v) { int(v).toStr() } None { "N" } })
}

fn checkU64(a: u64, b: u64) {
    let s1 = a.checkedAdd(b)
    let s2 = a.checkedSub(b)
    let s3 = a.checkedMul(b)
    print(match s1 { Some(v) { v.toStr() } None { "N" } } + " ")
    print(match s2 { Some(v) { v.toStr() } None { "N" } } + " ")
    println(match s3 { Some(v) { v.toStr() } None { "N" } })
}

fn main() {
    let i64s: []int = [0, 1, -1, 2, -2, 3037000499, 3037000500, -3037000500, 9223372036854775807, -9223372036854775807 - 1, 4611686018427387904, -4611686018427387904]
    for a in i64s { for b in i64s { checkI64(a, b) } }
    let i32s: []i32 = [i32(0), i32(1), i32(-1), i32(2), i32(-2), i32(46340), i32(46341), i32(-46341), i32(2147483647), i32(-2147483647) - i32(1)]
    for a in i32s { for b in i32s { checkI32(a, b) } }
    let u32s: []u32 = [u32(0), u32(1), u32(2), u32(65535), u32(65536), u32(4294967295), u32(2147483648)]
    for a in u32s { for b in u32s { checkU32(a, b) } }
    let u64s: []u64 = [u64(0), u64(1), u64(2), u64(4294967295), u64(4294967296), u64(0) -% u64(1), u64(1) << 63]
    for a in u64s { for b in u64s { checkU64(a, b) } }
    // 128-bit widening & narrowing
    var acc: i128 = 0
    for a in i64s {
        let w = i128(a)
        acc += w
        if int(w) != a { println("FAIL i128 roundtrip") }
    }
    println(acc.toStr())
    var uacc: u128 = 0
    for a in u64s {
        let w = u128(a)
        uacc += w
    }
    println(uacc.toStr())
    // Test in a loop (as lexdb_vec.arith does)
    var xs: []int = [10, 20, -30, 1000000000, 9223372036854775807]
    var ys: []int = [3, -4, 5, 2000000000, 2]
    var sum = 0
    for i in 0..len(xs) {
        match xs[i].checkedMul(ys[i]) {
            Some(v) { sum += v }
            None { sum += -1 }
        }
    }
    println(sum.toStr())
}
