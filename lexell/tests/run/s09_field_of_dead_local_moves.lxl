// A field of a local record (no drop method) that is not used afterwards moves out wherever it is
// read by value (SPEC 9.1), as move(h).f would: in a let, an argument, a return, an array
// literal. The record's other fields drop at that point. Run with LXL_CHECK=1: nothing leaks.
// expect: drop o1
// expect: let x
// expect: drop o2
// expect: y!
// expect: drop o3
// expect: r
// expect: t

type Noisy = record { name: str }
fn (n: mut &Noisy) drop() { println("drop " + n.name) }
type H = record { name: str; other: Noisy; n: int }
type V = value record { name: str; tag: str }

fn take(s: str): str { return s + "!" }

fn give(): str {
    let h = H{name: "r" + "", other: Noisy{name: "o3" + ""}, n: 3}
    return h.name
}

fn main() {
    let h = H{name: "x" + "", other: Noisy{name: "o1" + ""}, n: 1}
    let s = h.name
    println("let " + s)
    let g = H{name: "y" + "", other: Noisy{name: "o2" + ""}, n: 2}
    println(take(g.name))
    println(give())
    let v = V{name: "v" + "", tag: "t" + ""}
    let parts = [v.tag]
    println(parts[0])
}
