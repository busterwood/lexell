// SPEC 4.1, 9.1 (design/owned-str.md): a str field of an owned record is read through a borrow, or
// copied with clone(); it cannot be moved out of the record, which keeps it.
// expect: abc
// expect: abc
// expect: abc
type S = record { s: str; xs: []str }
fn main() {
    let a = S{s: "abc", xs: ["abc"]}
    let t = &a.s
    println(t)
    let u = a.s.clone()
    println(u)
    println(a.xs[0])
}
