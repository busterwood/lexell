// A view whose start is after its end: &s[a..2] with a = 3 (b < a). rt_str_view (C) and the
// inline view (native) both trap: "string slice out of range", exit 3. Only this view is bad.
// expect: before
// stderr: Lexell: string slice out of range at s05_str_view_trap_start_after_end.lxl:13
// exit: 3

fn main() {
    let s = "hello"
    let z = len(args()) - 1         // 0, unknown to the compiler
    println("before")
    var a = 3
    a += z
    let v: &str = &s[a..2]
    println(v)
    println("not reached")
}
