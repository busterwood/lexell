// A function may return a borrow of a set-once global (SPEC 5.2, 10 rule 5; changed 2026-11-18,
// this case used to expect an error). At exit GA is dropped first (reverse declaration order), so
// GB's drop method, calling cfg() after that, stops the program instead of reading freed memory.
// expect: 7
// exit: 12
type A = record { n: int; name: str }
type B = record { k: int }
fn (b: mut &B) drop() { println(cfg().name) }
var GB: once B
var GA: once A
fn cfg(): &A { return GA.get() }
fn main() {
    GB.set(B{k: 1})
    GA.set(A{n: 7, name: "x" + ""})
    println(cfg().n.toStr())
}
