// A borrow result with several borrowed parameters borrows all its arguments (SPEC 10 rule 5,
// changed 2026-11-18; this case used to expect the "exactly one" error): y stays frozen while r lives.
// error: borrowed by
fn pick(a: &[]int, b: &int): &int { return &a[0] }
fn main() {
    let xs: []int = [1]
    var y = 2
    let r = pick(&xs, &y)
    y = 3
    println(r.toStr())
}
