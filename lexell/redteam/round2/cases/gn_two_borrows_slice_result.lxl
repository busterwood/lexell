// A slice result with two borrowed parameters borrows both arguments (SPEC 10 rule 5): ys is
// frozen while the result lives, though the function returns a.
// error: borrowed by
fn pick(a: &[]int, b: &[]int): &[]int { return a }
fn main() {
    let xs: []int = [1]
    var ys: []int = [2]
    let r = pick(&xs, &ys)
    append(mut &ys, 4)
    println(len(r).toStr())
}
