// design/owned-str.md (issues 7, 13): s is owned, so the index call's mut &s conflicts with the
// borrow of s being indexed (SPEC 10 rule 3): an error, where a copy of s used to be indexed.
// error: 's' cannot be mutably borrowed here: an enclosing call already holds a borrow of it
fn ch(s: mut &str): int { s = "zzzz"; return 1 }
fn main() {
    var s = "abc" + ""
    s = s[ch(mut &s)..]
    println(s)
}
