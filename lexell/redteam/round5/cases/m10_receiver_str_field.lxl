// a str field of x as a receiver, and the argument moves x on one path. str's methods borrow
// their receiver (2026-11-14, design/borrow-inference.md), so x.name is borrowed while the call is
// made and moving x in the argument is refused (before, the receiver was a copy and this ran).
// error: 'x' was moved and has no value here
type D = record { v: int; name: str }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int {
    println("take " + intToStr(d.v))
    return 0
}
fn f(c: bool) {
    let x = D{v: 1, name: "ab" + "c"}
    println(x.name.cmp(&(if c { "" + intToStr(take(x)) } else { "abc" })))
}
fn main() {
    f(true)
    f(false)
}
