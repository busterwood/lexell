// the index of x.name[...] moves x on one path. x.name is owned (design/owned-str.md), so it is
// held while the index runs and the move is an error (no use after free); it used to be copied.
// error: 'x' cannot be moved here: it overlaps a borrow held by the call being evaluated
type D = record { v: int; name: str }
fn (d: mut &D) drop() { println("drop " + intToStr(d.v)) }
fn take(d: D): int { return 0 }
fn main() {
    let c = true
    let x = D{v: 1, name: "a" + "b"}
    println(x.name[if c { take(x) } else { 1 }])
}
