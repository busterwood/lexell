// unicode: Unicode 15.0.0 classification and simple case mapping.
//
//     unicode.isLetter(0x03B1)        // true (GREEK SMALL LETTER ALPHA)
//     unicode.lower(0x0391)           // 0x03B1
//     unicode.upper(0x03B1)           // 0x0391
//     unicode.category(0x1F600)       // "So"
//
// The data is unicode_data.lxl (generated from Go's Unicode tables). This
// module is classification and simple case mapping only: scripts and category
// aliases are regex_unicode's, and the full multi-code-point case fold is
// Markdown's own markdown_unicode table. A program that only classifies text
// does not pay for either.
//
// The predicates match Go's unicode package where the name is the same:
// isLetter is Lu|Ll|Lt|Lm|Lo, isDigit is Nd, isUpper is Lu, isLower is Ll
// (a titlecase letter such as U+01C5 is neither), isSpace is the Unicode
// White_Space property, and isPunct is the general category P. Punctuation
// is P only: symbols (Sc, Sk, Sm, So, as in "$" or "©") are not punctuation,
// which differs from CommonMark's wider "punctuation or symbol" set.

import "unicode_data" as ud

// Indices into ud.CLASS_NAMES. The first 38 names are the general categories
// in Unicode's order; the values are pinned here so the predicates do not scan
// CLASS_NAMES on every call. Keep them in step with ud.CLASS_NAMES if the
// generated table is ever regenerated with a different layout.
const CAT_L  = 6
const CAT_LL = 8
const CAT_LT = 11
const CAT_LU = 12
const CAT_M  = 13
const CAT_ND = 18
const CAT_P  = 21
const CAT_ZL = 35
const CAT_ZP = 36
const CAT_ZS = 37

// The specific general categories, as indices into ud.CLASS_NAMES, in table
// order. The composites (C, L, LC, M, N, P, S, Z) are omitted: every code
// point is in exactly one of these 30.
const CATS: []int = [1, 2, 3, 4, 5, 8, 9, 10, 11, 12, 14, 15, 16, 18, 19, 20,
    22, 23, 24, 25, 26, 27, 28, 30, 31, 32, 33, 35, 36, 37]

// The Unicode simple lowercase mapping of r: the lowercase form of a cased
// letter, else r. This is UnicodeData.txt's simple lowercase mapping (field
// 13), not full case folding: it never returns more than one code point.
pub fn lower(r: int): int { return ud.lower(r) }

// The Unicode simple uppercase mapping of r (UnicodeData.txt field 12), or r.
pub fn upper(r: int): int { return ud.upper(r) }

// The next code point of r's simple case-folding orbit, as Go's
// unicode.SimpleFold: A -> a -> A, K -> k -> K (Kelvin) -> K.
pub fn fold(r: int): int { return ud.simpleFold(r) }

// Whether r is a letter: any of Lu, Ll, Lt, Lm, Lo.
pub fn isLetter(r: int): bool { return ud.inClass(CAT_L, r) }

// Whether r is a decimal digit: general category Nd only.
pub fn isDigit(r: int): bool { return ud.inClass(CAT_ND, r) }

// Whether r has the Unicode White_Space property.
pub fn isSpace(r: int): bool { return ud.isSpace(r) }

// Whether r is an uppercase letter: general category Lu only. A titlecase
// letter (Lt) is neither upper nor lower.
pub fn isUpper(r: int): bool { return ud.inClass(CAT_LU, r) }

// Whether r is a lowercase letter: general category Ll only.
pub fn isLower(r: int): bool { return ud.inClass(CAT_LL, r) }

// Whether r is punctuation: general category P (Pc, Pd, Pe, Pf, Pi, Po,
// Ps). Symbols and marks are not punctuation.
pub fn isPunct(r: int): bool { return ud.inClass(CAT_P, r) }

// The general category of r as its short Unicode name ("Lu", "Ll", "Nd",
// "Zs", "Po", "So", ...). Unassigned code points are "Cn"; the generated
// tables cover every code point from U+0000 to U+10FFFF exactly once.
pub fn category(r: int): str {
    for i in CATS {
        if ud.inClass(i, r) { return ud.CLASS_NAMES[i] }
    }
    return "Cn"
}
