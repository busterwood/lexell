// errors: OS error text and Rust's debug quoting for paths.
//
// osError is Rust io::Error's Display form, "<text> (os error N)", which eza
// prints for path and write diagnostics. The text comes from io.errorText,
// the one errno-text source; there is no second errno table here.
//
// debugPath reproduces Rust's OsStr/Path Debug quoting: the path in double
// quotes; `\"`, `\'` and `\\` are backslash-escaped; NUL is \0; \t, \r and \n
// use the short escapes; every other byte below 0x20 and 0x7F becomes
// \u{h} with lowercase hex and no leading zeros; every other byte is copied
// unchanged, including bytes >= 0x80 whether or not they form valid UTF-8.

import "io"

// Error wrapping and construction over std.Error / std.WrappedError (with implicit Where).
pub type Wrapped = WrappedError

// Create a new standalone error carrying msg and its call-site location.
pub fn new(msg: &str, w: Where): Wrapped {
    return WrappedError{msg: msg.clone(), at: w, cause: None}
}

// Create a new standalone error already boxed as `box Error`.
pub fn boxNew(msg: &str, w: Where): box Error {
    return WrappedError{msg: msg.clone(), at: w, cause: None}
}

// Wrap any error E with context msg and its call-site location.
pub fn wrap[E: Error](err: E, msg: &str, w: Where): Wrapped {
    return WrappedError{msg: msg.clone(), at: w, cause: Some(err)}
}

// Wrap any error E with context msg and return it boxed as `box Error`.
pub fn boxWrap[E: Error](err: E, msg: &str, w: Where): box Error {
    return WrappedError{msg: msg.clone(), at: w, cause: Some(err)}
}

// Free-function form of Result.context(msg).
pub fn context[T, E: Error](r: Result[T, E], msg: &str, w: Where): Result[T, box Error] {
    match move(r) {
        Ok(x) { return Ok(x) }
        Err(e) { return Err(WrappedError{msg: msg.clone(), at: w, cause: Some(e)}) }
    }
}

// Rust io::Error's Display form for an OS error: "<text> (os error N)".
pub fn osError(errno: int): str {
    return io.errorText(errno) + " (os error " + intToStr(errno) + ")"
}

// The obo name for io.errorText, kept as an alias so a ported caller reads
// naturally. It deliberately adds no text of its own.
pub fn text(errno: int): str { return io.errorText(errno) }

// Append a lowercase hex byte with no leading zero (the \u{...} payload):
// 0 -> "0", 0x1b -> "1b", 0x7f -> "7f".
fn appendHexByte(out: mut &[]byte, b: byte) {
    let digits = "0123456789abcdef"
    let hi = int(b) / 16
    let lo = int(b) % 16
    if hi > 0 { append(out, strByte(digits, hi)) }
    append(out, strByte(digits, lo))
}

// Rust's OsStr/Path Debug quoting for one path, as eza prints it on stderr.
pub fn debugPath(p: &str): str {
    var out: []byte = []
    append(mut &out, '"')
    for i in 0..len(p) {
        let b = strByte(p, i)
        if b == '"' {
            append(mut &out, '\\')
            append(mut &out, '"')
        } else if b == '\'' {
            append(mut &out, '\\')
            append(mut &out, '\'')
        } else if b == '\\' {
            append(mut &out, '\\')
            append(mut &out, '\\')
        } else if b == '\t' {
            append(mut &out, '\\')
            append(mut &out, 't')
        } else if b == '\n' {
            append(mut &out, '\\')
            append(mut &out, 'n')
        } else if b == '\r' {
            append(mut &out, '\\')
            append(mut &out, 'r')
        } else if b == byte(0) {
            append(mut &out, '\\')
            append(mut &out, '0')
        } else if b < byte(0x20) || b == byte(0x7f) {
            append(mut &out, '\\')
            append(mut &out, 'u')
            append(mut &out, '{')
            appendHexByte(mut &out, b)
            append(mut &out, '}')
        } else {
            append(mut &out, b)
        }
    }
    append(mut &out, '"')
    return strFromBytes(&out)
}
