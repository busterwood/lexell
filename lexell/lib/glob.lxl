// glob: Unix-compatible path globbing.
//
//     let p = try glob.compile("cache/**/tmp?.log")
//     p.matches("cache/a/b/tmpx.log")        // true with globstar: true
//
// The defaults are bash's: `*`, `?` and `[...]` do not cross `/`; `*` and
// `?` do not match a leading `.`; `**` is just `*` unless `globstar` is set;
// character classes are ASCII (the C locale). Escapes use `\`. Brace and
// tilde expansion are shell features, not glob, and are not here.
//
// Matching is over Unicode code points, as bash is in a UTF-8 locale: `?`
// matches one code point, not one byte. An invalid UTF-8 part is one U+FFFD,
// as strings.decodeAt decodes it.
//
// `expand` walks a root and matches the paths relative to it; a pattern is
// relative (an absolute pattern is accepted but cannot match a relative
// walk). Paths are returned sorted.

import "strings"
import "fs"
import "io"

pub type Options = value record {
    pub dot: bool        // wildcards match a leading . (bash's dotglob)
    pub globstar: bool   // a whole ** component crosses directories
    pub caseFold: bool   // ASCII case folding
    pub classes: bool    // POSIX [[:alpha:]] and friends (ASCII)
}

pub fn defaults(): Options {
    return Options{dot: false, globstar: false, caseFold: false, classes: true}
}

// Why a pattern did not compile: the message and the code-point position.
pub type Error = value record {
    pub msg: str
    pub pos: int
}

pub fn (e: &Error) toStr(): str { return "glob: " + e.msg + " at " + e.pos.toStr() }

pub fn (a: &Error) eq(b: &Error): bool { return a.msg == b.msg && a.pos == b.pos }

// An expand error: a bad pattern or a filesystem error.
pub type ExpandError = value closed {
    Pattern(Error)
    Io(io.IoError)
}

pub fn (e: &ExpandError) toStr(): str {
    match e {
        ExpandError.Pattern(p) { return p.toStr() }
        ExpandError.Io(i) { return i.toStr() }
    }
}

pub fn (a: &ExpandError) eq(b: &ExpandError): bool {
    match a {
        ExpandError.Pattern(x) {
            match b {
                ExpandError.Pattern(y) { return x.eq(&y) }
                else { return false }
            }
        }
        ExpandError.Io(x) {
            match b {
                ExpandError.Io(y) { return x.eq(&y) }
                else { return false }
            }
        }
    }
}

const K_LIT = 0
const K_ANY = 1
const K_STAR = 2
const K_SET = 3
const K_NOTSET = 4

const SLASH = 47
const STAR = 42
const QUESTION = 63
const OPEN = 91
const CLOSE = 93
const BACKSLASH = 92
const BANG = 33
const CARET = 94
const DASH = 45
const COLON = 58

type Tok = value record {
    kind: int
    ch: int
    set: []int   // inclusive [lo, hi] pairs
}

type Comp = value record {
    toks: []Tok
    recursive: bool
}

pub type Pattern = record {
    comps: []Comp
    opts: Options
}

type SetParse = value record {
    set: []int
    neg: bool
    next: int
}

// ASCII case folding; the glob is locale-free.
fn foldCp(c: int): int {
    if c >= 65 && c <= 90 { return c + 32 }
    return c
}

fn classRanges(name: str): Result[[]int, str] {
    match name {
        "alpha" { return Ok([65, 90, 97, 122]) }
        "digit" { return Ok([48, 57]) }
        "alnum" { return Ok([48, 57, 65, 90, 97, 122]) }
        "upper" { return Ok([65, 90]) }
        "lower" { return Ok([97, 122]) }
        "space" { return Ok([9, 13, 32, 32]) }
        "blank" { return Ok([9, 9, 32, 32]) }
        "punct" { return Ok([33, 47, 58, 64, 91, 96, 123, 126]) }
        "print" { return Ok([32, 126]) }
        "graph" { return Ok([33, 126]) }
        "cntrl" { return Ok([0, 31, 127, 127]) }
        "xdigit" { return Ok([48, 57, 65, 70, 97, 102]) }
        else { return Err("unknown character class " + name) }
    }
}

fn parseSet(chars: &[int], start: int, opts: Options): Result[SetParse, Error] {
    let n = len(chars)
    var i = start + 1
    var neg = false
    if i < n && (chars[i] == BANG || chars[i] == CARET) {
        neg = true
        i += 1
    }
    var set: []int = []
    // A ] first in the set is a literal ].
    if i < n && chars[i] == CLOSE {
        append(mut &set, CLOSE)
        append(mut &set, CLOSE)
        i += 1
    }
    while true {
        if i >= n { return Err(Error{msg: "unclosed set", pos: start}) }
        if chars[i] == CLOSE {
            i += 1
            break
        }
        if opts.classes && chars[i] == OPEN && i + 1 < n && chars[i + 1] == COLON {
            var j = i + 2
            while j + 1 < n && !(chars[j] == COLON && chars[j + 1] == CLOSE) { j += 1 }
            if j + 1 >= n { return Err(Error{msg: "unclosed character class", pos: i}) }
            let name = strings.fromRunes(&chars[i + 2..j])
            match classRanges(name) {
                Ok(rs) {
                    for k in 0..len(rs) { append(mut &set, rs[k]) }
                }
                Err(msg) { return Err(Error{msg: msg, pos: i}) }
            }
            i = j + 2
            continue
        }
        var c = chars[i]
        i += 1
        if c == BACKSLASH && i < n {
            c = chars[i]
            i += 1
        }
        if i < n && chars[i] == DASH && i + 1 < n && chars[i + 1] != CLOSE {
            i += 1
            var d = chars[i]
            i += 1
            if d == BACKSLASH && i < n {
                d = chars[i]
                i += 1
            }
            append(mut &set, c)
            append(mut &set, d)
        } else {
            append(mut &set, c)
            append(mut &set, c)
        }
    }
    return Ok(SetParse{set: set, neg: neg, next: i})
}

// Splits a path at '/' and drops a trailing empty component (a/ is a).
fn splitPath(path: &str): []str {
    var out: []str = []
    var start = 0
    for i in 0..len(path) {
        if strByte(path, i) == '/' {
            append(mut &out, strSlice(path, start, i))
            start = i + 1
        }
    }
    append(mut &out, strSlice(path, start, len(path)))
    if len(out) > 1 && len(out[len(out) - 1]) == 0 { pop(mut &out) }
    return out
}

fn compOf(toks: []Tok, rec: bool): Comp {
    return Comp{toks: toks, recursive: rec}
}

pub fn compileWith(pattern: &str, opts: Options): Result[Pattern, Error] {
    let chars = strings.runes(pattern)
    var comps: []Comp = []
    var toks: []Tok = []
    var rec = false
    var i = 0
    while i < len(chars) {
        let c = chars[i]
        if c == SLASH {
            append(mut &comps, compOf(toks, rec))
            toks = []
            rec = false
            i += 1
            continue
        }
        if c == STAR {
            var j = i
            while j < len(chars) && chars[j] == STAR { j += 1 }
            let count = j - i
            if opts.globstar && count >= 2 && len(toks) == 0 && (j == len(chars) || chars[j] == SLASH) {
                rec = true
            } else {
                append(mut &toks, Tok{kind: K_STAR, ch: 0, set: []})
            }
            i = j
            continue
        }
        if c == QUESTION {
            append(mut &toks, Tok{kind: K_ANY, ch: 0, set: []})
            i += 1
            continue
        }
        if c == OPEN {
            var sp = try parseSet(&chars, i, opts)
            let set = replace(mut &sp.set, [])
            append(mut &toks, Tok{kind: if sp.neg { K_NOTSET } else { K_SET }, ch: 0, set: set})
            i = sp.next
            continue
        }
        if c == BACKSLASH && i + 1 < len(chars) {
            append(mut &toks, Tok{kind: K_LIT, ch: chars[i + 1], set: []})
            i += 2
            continue
        }
        append(mut &toks, Tok{kind: K_LIT, ch: c, set: []})
        i += 1
    }
    append(mut &comps, compOf(toks, rec))
    if len(comps) > 1 && len(comps[len(comps) - 1].toks) == 0 && !comps[len(comps) - 1].recursive {
        pop(mut &comps)
    }
    return Ok(Pattern{comps: comps, opts: opts})
}

pub fn compile(pattern: &str): Result[Pattern, Error] {
    return compileWith(pattern, defaults())
}

fn hidden(pc: &str, opts: Options): bool {
    return len(pc) > 0 && strByte(pc, 0) == '.' && !opts.dot
}

fn inSet(set: &[int], cp: int, fold: bool): bool {
    for i in 0..len(set) / 2 {
        if cp >= set[2 * i] && cp <= set[2 * i + 1] { return true }
    }
    if fold {
        let f = foldCp(cp)
        if f != cp {
            for i in 0..len(set) / 2 {
                if f >= set[2 * i] && f <= set[2 * i + 1] { return true }
            }
        }
    }
    return false
}

fn oneMatch(t: &Tok, cp: int, opts: Options): bool {
    match t.kind {
        K_LIT { return if opts.caseFold { foldCp(t.ch) == foldCp(cp) } else { t.ch == cp } }
        K_ANY { return true }
        K_SET { return inSet(&t.set, cp, opts.caseFold) }
        K_NOTSET { return !inSet(&t.set, cp, opts.caseFold) }
        else { return false }
    }
}

fn matchToks(toks: &[Tok], cps: &[int], opts: Options): bool {
    let n = len(cps)
    var prev = array(n + 1, false)
    prev[0] = true
    for tok in toks {
        var cur = array(n + 1, false)
        if tok.kind == K_STAR {
            cur[0] = prev[0]
            for j in 1..n + 1 { cur[j] = prev[j] || cur[j - 1] }
        } else {
            for j in 1..n + 1 { cur[j] = prev[j - 1] && oneMatch(&tok, cps[j - 1], opts) }
        }
        prev = cur
    }
    return prev[n]
}

fn compMatches(c: &Comp, pc: &str, opts: Options): bool {
    if hidden(pc, opts) {
        if len(c.toks) == 0 || c.toks[0].kind != K_LIT || c.toks[0].ch != 46 { return false }
    }
    return matchToks(&c.toks, &strings.runes(pc), opts)
}

fn matchComps(p: &Pattern, pi: int, path: &[]str, si: int, memo: mut &[]int, width: int): bool {
    let key = pi * width + si
    if memo[key] >= 0 { return memo[key] == 1 }
    var result = false
    if pi == len(p.comps) {
        result = si == len(path)
    } else {
        let c = &p.comps[pi]
        if c.recursive {
            if matchComps(p, pi + 1, path, si, memo, width) {
                result = true
            } else if si < len(path) && !hidden(&path[si], p.opts) && matchComps(p, pi, path, si + 1, memo, width) {
                result = true
            }
        } else if si < len(path) && compMatches(c, &path[si], p.opts) {
            result = matchComps(p, pi + 1, path, si + 1, memo, width)
        }
    }
    memo[key] = if result { 1 } else { 0 }
    return result
}

// Whether path matches the compiled pattern.
pub fn (p: &Pattern) matches(path: &str): bool {
    let parts = splitPath(path)
    let width = len(parts) + 1
    var memo = array((len(p.comps) + 1) * width, -1)
    return matchComps(p, 0, &parts, 0, mut &memo, width)
}

// compile then matches, with the compile error passed through. The language
// reserves `match`, so this convenience function is matchPath.
pub fn matchPath(pattern: &str, path: &str): Result[bool, Error] {
    match compile(pattern) {
        Ok(p) { return Ok(p.matches(path)) }
        Err(e) { return Err(e) }
    }
}

pub fn matchPathWith(pattern: &str, path: &str, opts: Options): Result[bool, Error] {
    match compileWith(pattern, opts) {
        Ok(p) { return Ok(p.matches(path)) }
        Err(e) { return Err(e) }
    }
}

// Escapes the characters that have a meaning in a pattern.
pub fn escape(s: &str): str {
    var b = newStrBuf()
    for i in 0..len(s) {
        let c = s[i]
        if c == STAR || c == QUESTION || c == OPEN || c == BACKSLASH { b.addByte(BACKSLASH) }
        b.addByte(c)
    }
    return b.toStr()
}

// Expands pattern under root, returning sorted paths relative to root.
// Symlinks are not followed. A pattern is relative to root.
pub fn expand(root: &str, pattern: &str, opts: Options): Result[[]str, ExpandError] {
    let pat = match compileWith(pattern, opts) {
        Ok(p) { p }
        Err(e) { return Err(ExpandError.Pattern(e)) }
    }
    let walkRoot = if len(root) == 0 { "." } else { root }
    var prefix: str = root
    if len(prefix) == 0 { prefix = "." }
    if !strings.endsWith(&prefix, "/") { prefix = prefix + "/" }
    var out: []str = []
    let r = fs.walk(&walkRoot, false, fn(p, e) {
        if p == walkRoot { return true }
        if !strings.startsWith(&p, &prefix) { return true }
        let rel = p[len(prefix)..]
        if pat.matches(&rel) { append(mut &out, rel) }
        return true
    })
    match r {
        Ok(_) {}
        Err(e) { return Err(ExpandError.Io(e)) }
    }
    sort(mut &out)
    return Ok(out)
}
