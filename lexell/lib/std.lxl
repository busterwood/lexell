// std: the prelude, imported into every module; its public names are visible
// unqualified. Everything here is ordinary Lexell code over the built-in
// intrinsics (SPEC 11). The compiler knows fromFraction (fractional literals),
// the variants Ok and Err (try) and the call-site type Where (SPEC 15).
//
// Contents: Option, Result, Unit, Where; Eq, Ord, Hash, Show and their
// primitive implementations; checked arithmetic and the float methods of the
// primitive types; print, println, eprintln; min, max; and the prelude names
// for Decimal, Map, StrBuf, sort and the basic string helpers, whose code
// lives in decimal, collections, strings and hash.

import "strings"
import "hash"
import "decimal"
import "collections"

// ---------------------------------------------------------------- core sums

// T: borrow (design/borrow-types.md): an Option may hold a borrow, Option[&T], or a value holding
// borrows; it is then second class like them.
pub type Option[T: borrow] = value closed { Some(T); None }
pub type Result[T: borrow, E: borrow] = value closed { Ok(T); Err(E) }
pub type Unit = value record {}

pub fn (o: &Option[T]) isSome(): bool {
    match o {
        Some(_) { return true }
        None { return false }
    }
}

pub fn (o: &Option[T]) isNone(): bool { return !o.isSome() }

pub fn (o: Option[T]) unwrap(): T {
    match move(o) {
        Some(x) { return x }
        None { panic("unwrap of None") }
    }
}

// The value, or a panic with msg.
pub fn (o: Option[T]) expect(msg: str): T {
    match move(o) {
        Some(x) { return x }
        None { panic(msg) }
    }
}

pub fn (o: Option[T]) unwrapOr(d: T): T {
    match move(o) {
        Some(x) { return x }
        None { return d }
    }
}

// The value passed through f, or None.
pub fn (o: Option[T]) map[U](f: &fn(T): U): Option[U] {
    match move(o) {
        Some(x) { return Some(f(x)) }
        None { return None }
    }
}

pub fn (a: &Option[T: Eq]) eq(b: &Option[T]): bool {
    match a {
        Some(x) {
            match b {
                Some(y) { return x == y }
                None { return false }
            }
        }
        None { return b.isNone() }
    }
}

pub fn (o: &Option[T: Show]) toStr(): str {
    match o {
        Some(x) { return "Some(" + x.toStr() + ")" }
        None { return "None" }
    }
}

pub fn (r: &Result[T, E]) isOk(): bool {
    match r {
        Ok(_) { return true }
        Err(_) { return false }
    }
}

pub fn (r: &Result[T, E]) isErr(): bool { return !r.isOk() }

// The Ok value; a panic on Err.
pub fn (r: Result[T, E]) unwrap(): T {
    match move(r) {
        Ok(x) { return x }
        Err(_) { panic("unwrap of Err") }
    }
}

// The Ok value, or a panic with msg.
pub fn (r: Result[T, E]) expect(msg: str): T {
    match move(r) {
        Ok(x) { return x }
        Err(_) { panic(msg) }
    }
}

pub fn (r: Result[T, E]) unwrapOr(d: T): T {
    match move(r) {
        Ok(x) { return x }
        Err(_) { return d }
    }
}

// The Err value; a panic on Ok.
pub fn (r: Result[T, E]) unwrapErr(): E {
    match move(r) {
        Ok(_) { panic("unwrapErr of Ok") }
        Err(e) { return e }
    }
}

// The Err value, or a panic with msg.
pub fn (r: Result[T, E]) expectErr(msg: str): E {
    match move(r) {
        Ok(_) { panic(msg) }
        Err(e) { return e }
    }
}

// The Ok value passed through f; an Err is kept.
pub fn (r: Result[T, E]) map[U](f: &fn(T): U): Result[U, E] {
    match move(r) {
        Ok(x) { return Ok(f(x)) }
        Err(e) { return Err(e) }
    }
}

// The Err value passed through f; an Ok is kept.
pub fn (r: Result[T, E]) mapErr[F](f: &fn(E): F): Result[T, F] {
    match move(r) {
        Ok(x) { return Ok(x) }
        Err(e) { return Err(f(e)) }
    }
}

// The Ok value as an Option (the error is dropped).
pub fn (r: Result[T, E]) ok(): Option[T] {
    match move(r) {
        Ok(x) { return Some(x) }
        Err(_) { return None }
    }
}

// The Err value as an Option (the value is dropped).
pub fn (r: Result[T, E]) err(): Option[E] {
    match move(r) {
        Ok(_) { return None }
        Err(e) { return Some(e) }
    }
}

pub fn (r: &Result[T: Show, E: Show]) toStr(): str {
    match r {
        Ok(x) { return "Ok(" + x.toStr() + ")" }
        Err(e) { return "Err(" + e.toStr() + ")" }
    }
}

pub fn (u: Unit) eq(other: &Unit): bool { return true }
pub fn (u: Unit) hash(): u64 { return 0 }
pub fn (u: Unit) toStr(): str { return "()" }

// ---------------------------------------------------------------- constraints

pub type Eq = interface { fn (&Self) eq(other: &Self): bool }
pub type Ord = interface { fn (&Self) cmp(other: &Self): int }
pub type Hash = interface { fn (&Self) hash(): u64 }
pub type Show = interface { fn (&Self) toStr(): str }

fn b2i(b: bool): int {
    if b { return 1 }
    return 0
}

fn cmpOf(lt: bool, gt: bool): int {
    if lt { return -1 }
    if gt { return 1 }
    return 0
}

const GOLDEN: u64 = 11400714819323198485
const M64: u128 = 0xffffffffffffffff

// The bits of a (two's complement) as a u64.
fn bitsOf(a: int): u64 { return u64(a & 9223372036854775807) | u64(b2i(a < 0)) << 63 }

pub fn (a: int) eq(b: &int): bool { return a == b }
pub fn (a: int) cmp(b: &int): int { return cmpOf(a < b, a > b) }
pub fn (a: int) hash(): u64 { return bitsOf(a) *% GOLDEN }
pub fn (a: int) toStr(): str { return intToStr(a) }

pub fn (a: i32) eq(b: &i32): bool { return a == b }
pub fn (a: i32) cmp(b: &i32): int { return cmpOf(a < b, a > b) }
pub fn (a: i32) hash(): u64 { return int(a).hash() }
pub fn (a: i32) toStr(): str { return intToStr(int(a)) }

pub fn (a: u32) eq(b: &u32): bool { return a == b }
pub fn (a: u32) cmp(b: &u32): int { return cmpOf(a < b, a > b) }
pub fn (a: u32) hash(): u64 { return int(a).hash() }
pub fn (a: u32) toStr(): str { return intToStr(int(a)) }

pub fn (a: u64) eq(b: &u64): bool { return a == b }
pub fn (a: u64) cmp(b: &u64): int { return cmpOf(a < b, a > b) }
pub fn (a: u64) hash(): u64 { return a *% GOLDEN }
pub fn (a: u64) toStr(): str { return u64ToStr(a) }

pub fn (a: byte) eq(b: &byte): bool { return a == b }
pub fn (a: byte) cmp(b: &byte): int { return cmpOf(a < b, a > b) }
pub fn (a: byte) hash(): u64 { return int(a).hash() }
pub fn (a: byte) toStr(): str { return intToStr(int(a)) }

pub fn (a: i128) eq(b: &i128): bool { return a == b }
pub fn (a: i128) cmp(b: &i128): int { return cmpOf(a < b, a > b) }
pub fn (a: i128) hash(): u64 { return hash.sipWords(u64(a & 18446744073709551615), bitsOf(int(a >> 64)), 1) }
pub fn (a: i128) toStr(): str { return i128ToStr(a) }

pub fn (a: u128) eq(b: &u128): bool { return a == b }
pub fn (a: u128) cmp(b: &u128): int { return cmpOf(a < b, a > b) }
pub fn (a: u128) hash(): u64 { return hash.sipWords(u64(a & M64), u64(a >> 64), 0) }
pub fn (a: u128) toStr(): str { return u128ToStr(a) }

// ---- checked arithmetic

// The integer operators stop the program on overflow, on a zero divisor and on
// MIN / -1 (exit 10). Where those come from input rather than a bug, the
// checked methods return None exactly where the operator would stop:
// a.checkedAdd(b), checkedSub, checkedMul, checkedDiv, checkedRem.

const I32_MIN: i128 = -2147483648
const I32_MAX: i128 = 2147483647
const I64_MIN: i128 = -9223372036854775808
const I64_MAX: i128 = 9223372036854775807
const U8_MAX: u128 = 255
const U32_MAX: u128 = 4294967295
const U64_MAX: u128 = 18446744073709551615
const I128_MIN: i128 = -170141183460469231731687303715884105727 - 1

fn fitI64(r: i128): Option[int] { return if r < I64_MIN || r > I64_MAX { None } else { Some(int(r)) } }
pub fn (a: int) checkedAdd(b: int): Option[int] { return fitI64(i128(a) + i128(b)) }
pub fn (a: int) checkedSub(b: int): Option[int] { return fitI64(i128(a) - i128(b)) }
pub fn (a: int) checkedMul(b: int): Option[int] { return fitI64(i128(a) * i128(b)) }
pub fn (a: int) checkedDiv(b: int): Option[int] { return if b == 0 { None } else { fitI64(i128(a) / i128(b)) } }
pub fn (a: int) checkedRem(b: int): Option[int] {
    return if b == 0 || (i128(a) == I64_MIN && b == -1) { None } else { Some(a % b) }
}

fn fitI32(r: i128): Option[i32] { return if r < I32_MIN || r > I32_MAX { None } else { Some(i32(r)) } }
pub fn (a: i32) checkedAdd(b: i32): Option[i32] { return fitI32(i128(a) + i128(b)) }
pub fn (a: i32) checkedSub(b: i32): Option[i32] { return fitI32(i128(a) - i128(b)) }
pub fn (a: i32) checkedMul(b: i32): Option[i32] { return fitI32(i128(a) * i128(b)) }
pub fn (a: i32) checkedDiv(b: i32): Option[i32] { return if b == 0 { None } else { fitI32(i128(a) / i128(b)) } }
pub fn (a: i32) checkedRem(b: i32): Option[i32] {
    return if b == 0 || (i128(a) == I32_MIN && b == -1) { None } else { Some(a % b) }
}

fn fitU32(r: u128): Option[u32] { return if r > U32_MAX { None } else { Some(u32(r)) } }
pub fn (a: u32) checkedAdd(b: u32): Option[u32] { return fitU32(u128(a) + u128(b)) }
pub fn (a: u32) checkedSub(b: u32): Option[u32] { return if a < b { None } else { Some(a - b) } }
pub fn (a: u32) checkedMul(b: u32): Option[u32] { return fitU32(u128(a) * u128(b)) }
pub fn (a: u32) checkedDiv(b: u32): Option[u32] { return if b == 0 { None } else { Some(a / b) } }
pub fn (a: u32) checkedRem(b: u32): Option[u32] { return if b == 0 { None } else { Some(a % b) } }

fn fitU64(r: u128): Option[u64] { return if r > U64_MAX { None } else { Some(u64(r)) } }
pub fn (a: u64) checkedAdd(b: u64): Option[u64] { return fitU64(u128(a) + u128(b)) }
pub fn (a: u64) checkedSub(b: u64): Option[u64] { return if a < b { None } else { Some(a - b) } }
pub fn (a: u64) checkedMul(b: u64): Option[u64] { return fitU64(u128(a) * u128(b)) }
pub fn (a: u64) checkedDiv(b: u64): Option[u64] { return if b == 0 { None } else { Some(a / b) } }
pub fn (a: u64) checkedRem(b: u64): Option[u64] { return if b == 0 { None } else { Some(a % b) } }

fn fitU8(r: u128): Option[byte] { return if r > U8_MAX { None } else { Some(byte(r)) } }
pub fn (a: byte) checkedAdd(b: byte): Option[byte] { return fitU8(u128(a) + u128(b)) }
pub fn (a: byte) checkedSub(b: byte): Option[byte] { return if a < b { None } else { Some(a - b) } }
pub fn (a: byte) checkedMul(b: byte): Option[byte] { return fitU8(u128(a) * u128(b)) }
pub fn (a: byte) checkedDiv(b: byte): Option[byte] { return if b == 0 { None } else { Some(a / b) } }
pub fn (a: byte) checkedRem(b: byte): Option[byte] { return if b == 0 { None } else { Some(a % b) } }

pub fn (a: i128) checkedAdd(b: i128): Option[i128] {
    let r = a +% b
    return if (a >= 0) == (b >= 0) && (r >= 0) != (a >= 0) { None } else { Some(r) }
}
pub fn (a: i128) checkedSub(b: i128): Option[i128] {
    let r = a -% b
    return if (a >= 0) != (b >= 0) && (r >= 0) != (a >= 0) { None } else { Some(r) }
}
pub fn (a: i128) checkedMul(b: i128): Option[i128] {
    if a == 0 || b == 0 { return Some(0) }
    if (a == -1 && b == I128_MIN) || (b == -1 && a == I128_MIN) { return None }
    let r = a *% b
    return if r / b != a { None } else { Some(r) }
}
pub fn (a: i128) checkedDiv(b: i128): Option[i128] {
    return if b == 0 || (a == I128_MIN && b == -1) { None } else { Some(a / b) }
}
pub fn (a: i128) checkedRem(b: i128): Option[i128] {
    return if b == 0 || (a == I128_MIN && b == -1) { None } else { Some(a % b) }
}

pub fn (a: u128) checkedAdd(b: u128): Option[u128] {
    let r = a +% b
    return if r < a { None } else { Some(r) }
}
pub fn (a: u128) checkedSub(b: u128): Option[u128] { return if a < b { None } else { Some(a - b) } }
pub fn (a: u128) checkedMul(b: u128): Option[u128] {
    if a == 0 { return Some(0) }
    let r = a *% b
    return if r / a != b { None } else { Some(r) }
}
pub fn (a: u128) checkedDiv(b: u128): Option[u128] { return if b == 0 { None } else { Some(a / b) } }
pub fn (a: u128) checkedRem(b: u128): Option[u128] { return if b == 0 { None } else { Some(a % b) } }

pub fn (a: float) eq(b: &float): bool { return a == b }
pub fn (a: float) cmp(b: &float): int { return cmpOf(a < b, a > b) }
// The shortest text that reads back as the same value: "0.1", "1e25",
// "1.5e-7", "-0"; NaN, inf and -inf by name. Exponent form is used below
// 1e-4 and from 1e17 (the %g rule at 17 digits).
pub fn (a: float) toStr(): str {
    if a != a { return "NaN" }
    let s = floatToStr(a)
    let e = strings.indexOf(s, "e", 0)
    if e < 0 { return s }
    // floatToStr writes %g exponents ("e+25", "e-07"); drop "+" and zeros
    var x = 0
    var neg = false
    for i in e + 1..len(s) {
        let c = strByte(s, i)
        if c == '-' { neg = true }
        if strings.isDigit(c) { x = x * 10 + int(c - '0') }
    }
    if neg { x = -x }
    var mant = strSlice(s, 0, e)
    // subnormals keep 15 digits from floatToStr; find the shortest one
    if x <= -308 { mant = shortestMantissa(a, mant, x) }
    return mant + "e" + intToStr(x)
}

// ------------------------------------------------------------ float math
// libm, as methods on float (methods of a primitive live in std); the math
// module adds constants, classification, parsing and fixed formatting. The
// functions are the runtime's own, not the C library's: sqrt, floor, ceil,
// trunc, roundEven, round, abs, copySign and fma are single instructions
// (SSE4.1, FMA3); the others are musl's (MIT; exp, exp2, log, log2 and pow are
// Arm's optimized-routines), within 1 ULP, the same bits on both backends.

extern "c" fn sqrt(x: float): float
extern "c" fn cbrt(x: float): float
extern "c" fn exp2(x: float): float
extern "c" fn expm1(x: float): float
extern "c" fn log1p(x: float): float
extern "c" fn fma(x: float, y: float, z: float): float
extern "c" fn pow(x: float, y: float): float
extern "c" fn exp(x: float): float
extern "c" fn log(x: float): float
extern "c" fn log2(x: float): float
extern "c" fn log10(x: float): float
extern "c" fn sin(x: float): float
extern "c" fn cos(x: float): float
extern "c" fn tan(x: float): float
extern "c" fn asin(x: float): float
extern "c" fn acos(x: float): float
extern "c" fn atan(x: float): float
extern "c" fn atan2(y: float, x: float): float
extern "c" fn sinh(x: float): float
extern "c" fn cosh(x: float): float
extern "c" fn tanh(x: float): float
extern "c" fn floor(x: float): float
extern "c" fn ceil(x: float): float
extern "c" fn trunc(x: float): float
extern "c" fn round(x: float): float
extern "c" fn rint(x: float): float
extern "c" fn fabs(x: float): float
extern "c" fn fmod(x: float, y: float): float
extern "c" fn hypot(x: float, y: float): float
extern "c" fn copysign(x: float, y: float): float

pub fn (x: float) sqrt(): float { return sqrt(x) }
pub fn (x: float) cbrt(): float { return cbrt(x) }
// x raised to y (C pow: 0^0 is 1, negative x needs an integral y).
pub fn (x: float) pow(y: float): float { return pow(x, y) }
pub fn (x: float) powi(n: int): float { return pow(x, float(n)) }
pub fn (x: float) exp(): float { return exp(x) }
// 2 raised to x.
pub fn (x: float) exp2(): float { return exp2(x) }
// exp(x) - 1, exact for small x.
pub fn (x: float) expm1(): float { return expm1(x) }
// ln(1 + x), exact for small x.
pub fn (x: float) ln1p(): float { return log1p(x) }
// x * y + z with one rounding (a single instruction, FMA3).
pub fn (x: float) fma(y: float, z: float): float { return fma(x, y, z) }
// The natural logarithm.
pub fn (x: float) ln(): float { return log(x) }
pub fn (x: float) log2(): float { return log2(x) }
pub fn (x: float) log10(): float { return log10(x) }
pub fn (x: float) sin(): float { return sin(x) }
pub fn (x: float) cos(): float { return cos(x) }
pub fn (x: float) tan(): float { return tan(x) }
pub fn (x: float) asin(): float { return asin(x) }
pub fn (x: float) acos(): float { return acos(x) }
pub fn (x: float) atan(): float { return atan(x) }
// The angle of the point (x, y): y.atan2(x), like C atan2(y, x).
pub fn (y: float) atan2(x: float): float { return atan2(y, x) }
pub fn (x: float) sinh(): float { return sinh(x) }
pub fn (x: float) cosh(): float { return cosh(x) }
pub fn (x: float) tanh(): float { return tanh(x) }
pub fn (x: float) floor(): float { return floor(x) }
pub fn (x: float) ceil(): float { return ceil(x) }
pub fn (x: float) trunc(): float { return trunc(x) }
// To the nearest integer, halves away from zero (C round).
pub fn (x: float) round(): float { return round(x) }
// To the nearest integer, halves to even.
pub fn (x: float) roundEven(): float { return rint(x) }
pub fn (x: float) abs(): float { return fabs(x) }
// The remainder of x / y with the sign of x (C fmod).
pub fn (x: float) mod(y: float): float { return fmod(x, y) }
pub fn (x: float) hypot(y: float): float { return hypot(x, y) }
pub fn (x: float) copySign(y: float): float { return copysign(x, y) }
pub fn (x: float) isNaN(): bool { return x != x }
pub fn (x: float) isInf(): bool { return x == x && x - x != x - x }
pub fn (x: float) isFinite(): bool { return x - x == x - x }

// The mantissa with the fewest digits m such that m * 10^x reads back as a
// (m is "-d.ddd" or "d.ddd", one digit before the point).
fn shortestMantissa(a: float, mant: str, x: int): str {
    var sign = ""
    var digits = newStrBuf()
    for i in 0..len(mant) {
        let c = strByte(mant, i)
        if c == '-' { sign = "-" }
        if strings.isDigit(c) { digits.addByte(c) }
    }
    let d = digits.toStr()
    for k in 1..len(d) {
        // d rounded half up to k digits; skip a carry out of the first digit
        var bytes = strToBytes(strSlice(d, 0, k))
        var carry = strByte(d, k) >= '5'
        var i = k - 1
        while carry && i >= 0 {
            if bytes[i] == '9' {
                bytes[i] = '0'
                i -= 1
            } else {
                bytes[i] += 1
                carry = false
            }
        }
        if !carry {
            let r = strFromBytes(&bytes)
            var m = sign + strSlice(r, 0, 1)
            if k > 1 { m += "." + strSlice(r, 1, k) }
            var back: float = 0.0f
            if parseFloat(m + "e" + intToStr(x), mut &back) && back == a { return m }
        }
    }
    return mant
}

pub fn (a: bool) eq(b: &bool): bool { return a == b }
pub fn (a: bool) hash(): u64 {
    if a { return GOLDEN }
    return 0
}
pub fn (a: bool) toStr(): str {
    if a { return "true" }
    return "false"
}

pub fn (a: str) eq(b: &str): bool { return a == b }
pub fn (a: str) cmp(b: &str): int { return cmpOf(a < b, a > b) }
pub fn (a: str) toStr(): str { return a }
pub fn (s: str) hash(): u64 { return hash.sipStr(&s) }

pub fn min[T: Ord + copy](a: T, b: T): T {
    if b < a { return b }
    return a
}

pub fn max[T: Ord + copy](a: T, b: T): T {
    if b > a { return b }
    return a
}

// ---------------------------------------------------------------- output

pub fn print[T: Show](x: T) { writeFd(1, x.toStr()) }
pub fn println[T: Show](x: T) { writeFd(1, x.toStr() + "\n") }
pub fn eprint[T: Show](x: T) { writeFd(2, x.toStr()) }
pub fn eprintln[T: Show](x: T) { writeFd(2, x.toStr() + "\n") }

// ---------------------------------------------------------------- Where

pub type Where = value record { p: ptr }

// The location of the call of here(), or the Where passed to it.
pub fn here(w: Where): Where { return w }

pub fn (w: Where) toStr(): str { return strFromC(w.p) }

// The text as a NUL-terminated C string (static: valid for the whole run).
pub fn (w: Where) cstr(): ptr { return w.p }

// ---- prelude facade: implementations live in their own modules
//
// These names stay in std so the prelude is convenient; the code is in
// collections, decimal, hash and strings.

pub type Decimal = decimal.Decimal
pub type Rounding = decimal.Rounding
pub type DecError = decimal.DecError

pub fn fromFraction(units: i128, scale: int): Decimal { return decimal.fromFraction(units, scale) }
pub fn decimalOf(n: int): Decimal { return decimal.decimalOf(n) }
pub fn sumDecimals(xs: &[Decimal]): Decimal { return decimal.sumDecimals(xs) }

pub type StrBuf = strings.StrBuf
pub fn newStrBuf(): StrBuf { return strings.newStrBuf() }

pub type Map[K: Eq + Hash, V] = collections.Map[K, V]
pub type MapIter[K: Eq + Hash, V] = collections.MapIter[K, V]
pub type MapEntry[K, V] = collections.MapEntry[K, V]

pub fn newMap[K: Eq + Hash, V](): Map[K, V] { return collections.newMap[K, V]() }
pub fn newMapWith[K: Eq + Hash, V](hashFn: fn(&K): u64): Map[K, V] { return collections.newMapWith[K, V](hashFn) }
pub fn fxHashStr(s: &str): u64 { return collections.fxHashStr(s) }
pub fn fxHashInt(x: int): u64 { return collections.fxHashInt(x) }
pub fn sort[T: Ord](xs: mut &[T]) { collections.sort(xs) }

pub fn sipHash13(k0: u64, k1: u64, s: &str): u64 { return hash.sipHash13(k0, k1, s) }
