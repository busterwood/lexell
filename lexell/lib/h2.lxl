// h2: shared RFC 9113 HTTP/2 constants, frame codec and validation used by
// lib/httpserver.lxl (server) and lib/http.lxl (client).
import "hpack"
import "strings"

type VB = vector[byte]

// SIMD 32-byte bulk append from &[byte] slice into mut &[]byte.
pub fn appendBytesSimd(dst: mut &[]byte, src: &[byte], off: int, n: int) {
    if n <= 0 { return }
    let at = bytesGrow(dst, n)
    var i = 0
    while i + 32 <= n {
        VB.load(src, off + i).store(dst, at + i)
        i += 32
    }
    while i < n {
        dst[at + i] = src[off + i]
        i += 1
    }
}

// SIMD 32-byte bulk append from &str slice into mut &[]byte.
pub fn appendStrSimd(dst: mut &[]byte, src: &str, off: int, n: int) {
    if n <= 0 { return }
    let at = bytesGrow(dst, n)
    var i = 0
    while i + 32 <= n {
        VB.load(src, off + i).store(dst, at + i)
        i += 32
    }
    while i < n {
        dst[at + i] = src[off + i]
        i += 1
    }
}

// SIMD 32-byte copy between non-overlapping byte slices.
pub fn copyBytesSimd(dst: mut &[byte], dstOff: int, src: &[byte], srcOff: int, n: int) {
    var i = 0
    while i + 32 <= n {
        VB.load(src, srcOff + i).store(dst, dstOff + i)
        i += 32
    }
    while i < n {
        dst[dstOff + i] = src[srcOff + i]
        i += 1
    }
}

// SIMD 32-byte in-place left shift: moves buf[srcOff..srcOff+n] to buf[0..n] (srcOff >= 0).
pub fn shiftLeftSimd(buf: mut &[byte], srcOff: int, n: int) {
    if srcOff <= 0 || n <= 0 { return }
    var i = 0
    while i + 32 <= n {
        let v = VB.load(buf, srcOff + i)
        v.store(buf, i)
        i += 32
    }
    while i < n {
        buf[i] = buf[srcOff + i]
        i += 1
    }
}

// Client connection preface (RFC 9113 section 3.4), 24 octets.
pub const PREFACE = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
pub const PREFACE_LEN = 24
pub const FRAME_HDR_LEN = 9

// Frame types (RFC 9113 section 6).
pub const F_DATA = 0
pub const F_HEADERS = 1
pub const F_PRIORITY = 2
pub const F_RST_STREAM = 3
pub const F_SETTINGS = 4
pub const F_PUSH_PROMISE = 5
pub const F_PING = 6
pub const F_GOAWAY = 7
pub const F_WINDOW_UPDATE = 8
pub const F_CONTINUATION = 9

// Frame flags.
pub const FL_END_STREAM = 0x01
pub const FL_ACK = 0x01
pub const FL_END_HEADERS = 0x04
pub const FL_PADDED = 0x08
pub const FL_PRIORITY = 0x20

// Settings identifiers (RFC 9113 section 6.5.2).
pub const SET_HEADER_TABLE_SIZE = 1
pub const SET_ENABLE_PUSH = 2
pub const SET_MAX_CONCURRENT_STREAMS = 3
pub const SET_INITIAL_WINDOW_SIZE = 4
pub const SET_MAX_FRAME_SIZE = 5
pub const SET_MAX_HEADER_LIST_SIZE = 6

// Error codes (RFC 9113 section 7).
pub const ERR_NO_ERROR = 0
pub const ERR_PROTOCOL_ERROR = 1
pub const ERR_INTERNAL_ERROR = 2
pub const ERR_FLOW_CONTROL_ERROR = 3
pub const ERR_SETTINGS_TIMEOUT = 4
pub const ERR_STREAM_CLOSED = 5
pub const ERR_FRAME_SIZE_ERROR = 6
pub const ERR_REFUSED_STREAM = 7
pub const ERR_CANCEL = 8
pub const ERR_COMPRESSION_ERROR = 9
pub const ERR_CONNECT_ERROR = 10
pub const ERR_ENHANCE_YOUR_CALM = 11
pub const ERR_INADEQUATE_SECURITY = 12
pub const ERR_HTTP_1_1_REQUIRED = 13

// Protocol defaults & bounds.
pub const DEFAULT_HEADER_TABLE_SIZE = 4096
pub const DEFAULT_INITIAL_WINDOW = 65535
pub const DEFAULT_MAX_FRAME_SIZE = 16384
pub const MAX_FRAME_SIZE_LIMIT = 16777215
pub const MAX_WINDOW = 2147483647
pub const MAX_STREAM_ID = 2147483647

pub fn errorName(code: int): str {
    if code == ERR_NO_ERROR { return "NO_ERROR" }
    if code == ERR_PROTOCOL_ERROR { return "PROTOCOL_ERROR" }
    if code == ERR_INTERNAL_ERROR { return "INTERNAL_ERROR" }
    if code == ERR_FLOW_CONTROL_ERROR { return "FLOW_CONTROL_ERROR" }
    if code == ERR_SETTINGS_TIMEOUT { return "SETTINGS_TIMEOUT" }
    if code == ERR_STREAM_CLOSED { return "STREAM_CLOSED" }
    if code == ERR_FRAME_SIZE_ERROR { return "FRAME_SIZE_ERROR" }
    if code == ERR_REFUSED_STREAM { return "REFUSED_STREAM" }
    if code == ERR_CANCEL { return "CANCEL" }
    if code == ERR_COMPRESSION_ERROR { return "COMPRESSION_ERROR" }
    if code == ERR_CONNECT_ERROR { return "CONNECT_ERROR" }
    if code == ERR_ENHANCE_YOUR_CALM { return "ENHANCE_YOUR_CALM" }
    if code == ERR_INADEQUATE_SECURITY { return "INADEQUATE_SECURITY" }
    if code == ERR_HTTP_1_1_REQUIRED { return "HTTP_1_1_REQUIRED" }
    return "ERR_" + intToStr(code)
}

// ---------------------------------------------------------------- frame structures

pub type FrameHeader = value record {
    pub length: int
    pub ftype: int
    pub flags: int
    pub streamId: int
}

pub type Setting = value record {
    pub id: int
    pub val: int
}

pub type Goaway = value record {
    pub lastStreamId: int
    pub code: int
    pub debug: str
}

pub type Span = value record {
    pub start: int
    pub end: int
}

// ---------------------------------------------------------------- frame encoding

pub fn putU16(out: mut &[]byte, v: int) {
    append(out, byte((v >> 8) & 0xff))
    append(out, byte(v & 0xff))
}

pub fn putU24(out: mut &[]byte, v: int) {
    append(out, byte((v >> 16) & 0xff))
    append(out, byte((v >> 8) & 0xff))
    append(out, byte(v & 0xff))
}

pub fn putU32(out: mut &[]byte, v: int) {
    append(out, byte((v >> 24) & 0xff))
    append(out, byte((v >> 16) & 0xff))
    append(out, byte((v >> 8) & 0xff))
    append(out, byte(v & 0xff))
}

pub fn readU16(b: &[byte], off: int): int {
    return (int(b[off]) << 8) | int(b[off + 1])
}

pub fn readU24(b: &[byte], off: int): int {
    return (int(b[off]) << 16) | (int(b[off + 1]) << 8) | int(b[off + 2])
}

pub fn readU32(b: &[byte], off: int): int {
    return (int(b[off]) << 24) | (int(b[off + 1]) << 16) | (int(b[off + 2]) << 8) | int(b[off + 3])
}

pub fn parseFrameHeader(b: &[byte]): FrameHeader {
    return FrameHeader{
        length: readU24(b, 0),
        ftype: int(b[3]),
        flags: int(b[4]),
        streamId: readU32(b, 5) & 0x7fffffff,
    }
}

pub fn putFrameHeaderAt(out: mut &[byte], at: int, length: int, ftype: int, flags: int, streamId: int) {
    let sid = streamId & 0x7fffffff
    out[at] = byte((length >> 16) & 0xff)
    out[at + 1] = byte((length >> 8) & 0xff)
    out[at + 2] = byte(length & 0xff)
    out[at + 3] = byte(ftype & 0xff)
    out[at + 4] = byte(flags & 0xff)
    out[at + 5] = byte((sid >> 24) & 0xff)
    out[at + 6] = byte((sid >> 16) & 0xff)
    out[at + 7] = byte((sid >> 8) & 0xff)
    out[at + 8] = byte(sid & 0xff)
}

pub fn putFrameHeader(out: mut &[]byte, length: int, ftype: int, flags: int, streamId: int) {
    let at = bytesGrow(out, FRAME_HDR_LEN)
    putFrameHeaderAt(out, at, length, ftype, flags, streamId)
}

pub fn putSettings(out: mut &[]byte, entries: &[]Setting) {
    putFrameHeader(out, len(entries) * 6, F_SETTINGS, 0, 0)
    for s in entries {
        putU16(out, s.id)
        putU32(out, s.val)
    }
}

pub fn putSettingsAck(out: mut &[]byte) {
    putFrameHeader(out, 0, F_SETTINGS, FL_ACK, 0)
}

pub fn putPing(out: mut &[]byte, ack: bool, data: &[byte]) {
    putFrameHeader(out, 8, F_PING, if ack { FL_ACK } else { 0 }, 0)
    let at = bytesGrow(out, 8)
    for i in 0..8 {
        out[at + i] = if i < len(data) { data[i] } else { byte(0) }
    }
}

pub fn putWindowUpdate(out: mut &[]byte, streamId: int, incr: int) {
    let at = bytesGrow(out, 13)
    putFrameHeaderAt(out, at, 4, F_WINDOW_UPDATE, 0, streamId)
    let v = incr & 0x7fffffff
    out[at + 9] = byte((v >> 24) & 0xff)
    out[at + 10] = byte((v >> 16) & 0xff)
    out[at + 11] = byte((v >> 8) & 0xff)
    out[at + 12] = byte(v & 0xff)
}

pub fn putRstStream(out: mut &[]byte, streamId: int, code: int) {
    let at = bytesGrow(out, 13)
    putFrameHeaderAt(out, at, 4, F_RST_STREAM, 0, streamId)
    out[at + 9] = byte((code >> 24) & 0xff)
    out[at + 10] = byte((code >> 16) & 0xff)
    out[at + 11] = byte((code >> 8) & 0xff)
    out[at + 12] = byte(code & 0xff)
}

pub fn putGoaway(out: mut &[]byte, lastStreamId: int, code: int, debug: &str) {
    putFrameHeader(out, 8 + len(debug), F_GOAWAY, 0, 0)
    putU32(out, lastStreamId & 0x7fffffff)
    putU32(out, code)
    appendStrSimd(out, debug, 0, len(debug))
}

// Emits a complete HPACK block as a HEADERS frame followed by zero or more
// CONTINUATION frames, each bounded by maxFrameSize.
pub fn putHeaderBlock(out: mut &[]byte, streamId: int, block: &[byte], endStream: bool, maxFrameSize: int) {
    let mfs = if maxFrameSize < DEFAULT_MAX_FRAME_SIZE { DEFAULT_MAX_FRAME_SIZE } else { maxFrameSize }
    if len(block) <= mfs {
        let fl = FL_END_HEADERS | (if endStream { FL_END_STREAM } else { 0 })
        putFrameHeader(out, len(block), F_HEADERS, fl, streamId)
        appendBytesSimd(out, block, 0, len(block))
        return
    }
    // First chunk in HEADERS
    let fl0 = if endStream { FL_END_STREAM } else { 0 }
    putFrameHeader(out, mfs, F_HEADERS, fl0, streamId)
    appendBytesSimd(out, block, 0, mfs)
    var off = mfs
    while off < len(block) {
        let rem = len(block) - off
        let n = if rem > mfs { mfs } else { rem }
        let fl = if off + n == len(block) { FL_END_HEADERS } else { 0 }
        putFrameHeader(out, n, F_CONTINUATION, fl, streamId)
        appendBytesSimd(out, block, off, n)
        off += n
    }
}

// Encodes fields directly into out as HEADERS (+ CONTINUATION if > maxFrameSize)
// with zero intermediate block allocation on the common single-frame path.
pub fn putHeaderBlockEncoded(enc: mut &hpack.Encoder, out: mut &[]byte, streamId: int, fields: &[]hpack.Field, endStream: bool, maxFrameSize: int) {
    let mfs = if maxFrameSize < DEFAULT_MAX_FRAME_SIZE { DEFAULT_MAX_FRAME_SIZE } else { maxFrameSize }
    let hdrAt = bytesGrow(out, FRAME_HDR_LEN)
    let blkStart = len(out)
    enc.encode(fields, out)
    let blkLen = len(out) - blkStart
    if blkLen <= mfs {
        let fl = FL_END_HEADERS | (if endStream { FL_END_STREAM } else { 0 })
        putFrameHeaderAt(out, hdrAt, blkLen, F_HEADERS, fl, streamId)
        return
    }
    // Rare oversized header block: copy out and split into HEADERS + CONTINUATION.
    var tmp = array(blkLen, byte(0))
    copyBytesSimd(mut &tmp, 0, out, blkStart, blkLen)
    // Trim out back to hdrAt by rebuilding? No: patch first chunk in-place and append CONTINUATIONs.
    let fl0 = if endStream { FL_END_STREAM } else { 0 }
    putFrameHeaderAt(out, hdrAt, mfs, F_HEADERS, fl0, streamId)
    // Truncate extra bytes past blkStart + mfs by shrinking via pop? Avoid pop loop: rewrite remaining chunks after mfs.
    let extra = blkLen - mfs
    var off = mfs
    // Overwrite from blkStart + mfs using a fresh tail buffer then copy back.
    var cont: []byte = withCapacity(extra + ((extra / mfs) + 1) * FRAME_HDR_LEN)
    while off < blkLen {
        let rem = blkLen - off
        let n = if rem > mfs { mfs } else { rem }
        let fl = if off + n == blkLen { FL_END_HEADERS } else { 0 }
        putFrameHeader(mut &cont, n, F_CONTINUATION, fl, streamId)
        appendBytesSimd(mut &cont, &tmp, off, n)
        off += n
    }
    // Grow out by (len(cont) - extra) and copy cont at blkStart + mfs.
    let needGrow = len(cont) - extra
    if needGrow > 0 { let _g = bytesGrow(out, needGrow) }
    copyBytesSimd(out, blkStart + mfs, &cont, 0, len(cont))
}

// Emits data as one or more DATA frames bounded by maxFrameSize. If data is
// empty and endStream is true, emits a zero-length DATA frame with END_STREAM.
pub fn putData(out: mut &[]byte, streamId: int, data: &[byte], endStream: bool, maxFrameSize: int) {
    let mfs = if maxFrameSize < DEFAULT_MAX_FRAME_SIZE { DEFAULT_MAX_FRAME_SIZE } else { maxFrameSize }
    if len(data) == 0 {
        if endStream { putFrameHeader(out, 0, F_DATA, FL_END_STREAM, streamId) }
        return
    }
    var off = 0
    while off < len(data) {
        let rem = len(data) - off
        let n = if rem > mfs { mfs } else { rem }
        let fl = if endStream && off + n == len(data) { FL_END_STREAM } else { 0 }
        putFrameHeader(out, n, F_DATA, fl, streamId)
        appendBytesSimd(out, data, off, n)
        off += n
    }
}

// Emits a str slice data[start..start+total] as one or more DATA frames without
// allocating an intermediate []byte.
pub fn putDataStr(out: mut &[]byte, streamId: int, data: &str, start: int, total: int, endStream: bool, maxFrameSize: int) {
    let mfs = if maxFrameSize < DEFAULT_MAX_FRAME_SIZE { DEFAULT_MAX_FRAME_SIZE } else { maxFrameSize }
    if total == 0 {
        if endStream { putFrameHeader(out, 0, F_DATA, FL_END_STREAM, streamId) }
        return
    }
    var off = 0
    while off < total {
        let rem = total - off
        let n = if rem > mfs { mfs } else { rem }
        let fl = if endStream && off + n == total { FL_END_STREAM } else { 0 }
        putFrameHeader(out, n, F_DATA, fl, streamId)
        appendStrSimd(out, data, start + off, n)
        off += n
    }
}

// ---------------------------------------------------------------- frame payload validation

// Removes optional PADDED framing from DATA or HEADERS payloads.
// Returns the unpadded [start..end) span or ERR_PROTOCOL_ERROR / ERR_FRAME_SIZE_ERROR.
pub fn unpad(payload: &[byte], flags: int): Result[Span, int] {
    if (flags & FL_PADDED) == 0 { return Ok(Span{start: 0, end: len(payload)}) }
    if len(payload) < 1 { return Err(ERR_FRAME_SIZE_ERROR) }
    let padLen = int(payload[0])
    if padLen >= len(payload) { return Err(ERR_PROTOCOL_ERROR) }
    return Ok(Span{start: 1, end: len(payload) - padLen})
}

// Strips optional PADDED and PRIORITY fields from a HEADERS frame payload.
// Also validates RFC 9113 section 5.3.1 (a stream cannot depend on itself)
// and section 6.2 (pad length vs remaining payload).
pub fn headersFragment(payload: &[byte], flags: int, streamId: int): Result[Span, int] {
    let padded = (flags & FL_PADDED) != 0
    let prio = (flags & FL_PRIORITY) != 0
    let fixedLen = (if padded { 1 } else { 0 }) + (if prio { 5 } else { 0 })
    if len(payload) < fixedLen { return Err(ERR_FRAME_SIZE_ERROR) }
    var start = 0
    var end = len(payload)
    if padded {
        let padLen = int(payload[0])
        if padLen > len(payload) - fixedLen { return Err(ERR_PROTOCOL_ERROR) }
        start = 1
        end = len(payload) - padLen
    }
    if prio {
        let dep = readU32(payload, start) & 0x7fffffff
        if dep == streamId { return Err(ERR_PROTOCOL_ERROR) }
        start += 5
    }
    return Ok(Span{start: start, end: end})
}

// Parses a non-ACK SETTINGS payload (RFC 9113 section 6.5).
pub fn parseSettings(payload: &[byte], maxEntries: int): Result[[]Setting, int] {
    if len(payload) % 6 != 0 { return Err(ERR_FRAME_SIZE_ERROR) }
    let count = len(payload) / 6
    if maxEntries > 0 && count > maxEntries { return Err(ERR_ENHANCE_YOUR_CALM) }
    var out: []Setting = withCapacity(count)
    for i in 0..count {
        let id = readU16(payload, i * 6)
        let val = readU32(payload, i * 6 + 2)
        if id == SET_ENABLE_PUSH && val != 0 && val != 1 { return Err(ERR_PROTOCOL_ERROR) }
        if id == SET_INITIAL_WINDOW_SIZE && (val < 0 || val > MAX_WINDOW) { return Err(ERR_FLOW_CONTROL_ERROR) }
        if id == SET_MAX_FRAME_SIZE && (val < DEFAULT_MAX_FRAME_SIZE || val > MAX_FRAME_SIZE_LIMIT) { return Err(ERR_PROTOCOL_ERROR) }
        append(mut &out, Setting{id: id, val: val})
    }
    return Ok(out)
}

pub fn parseRstStream(payload: &[byte]): Result[int, int] {
    if len(payload) != 4 { return Err(ERR_FRAME_SIZE_ERROR) }
    return Ok(readU32(payload, 0))
}

pub fn parseWindowUpdate(payload: &[byte]): Result[int, int] {
    if len(payload) != 4 { return Err(ERR_FRAME_SIZE_ERROR) }
    let incr = readU32(payload, 0) & 0x7fffffff
    if incr == 0 { return Err(ERR_PROTOCOL_ERROR) }
    return Ok(incr)
}

pub fn parseGoaway(payload: &[byte]): Result[Goaway, int] {
    if len(payload) < 8 { return Err(ERR_FRAME_SIZE_ERROR) }
    let lastId = readU32(payload, 0) & 0x7fffffff
    let code = readU32(payload, 4)
    let dbg = if len(payload) > 8 { strFromBytes(&payload[8..len(payload)]) } else { "" }
    return Ok(Goaway{lastStreamId: lastId, code: code, debug: dbg})
}

// ---------------------------------------------------------------- header validation (RFC 9113 section 8.2)

// 256-byte lowercase RFC 9113 tchar lookup table ('1' = valid, '0' = invalid).
const LOWER_TCHAR_LUT =
    "00000000000000000000000000000000" + // 0x00..0x1f
    "01011111001101101111111111000000" + // 0x20..0x3f: ! # $ % & ' * + - . 0-9
    "00000000000000000000000000000011" + // 0x40..0x5f: ^ _ (uppercase A-Z forbidden!)
    "11111111111111111111111111101010" + // 0x60..0x7f: ` a-z | ~
    "00000000000000000000000000000000" +
    "00000000000000000000000000000000" +
    "00000000000000000000000000000000" +
    "00000000000000000000000000000000"

fn isLowerTchar(c: byte): bool {
    return LOWER_TCHAR_LUT[int(c)] != '0'
}

// RFC 9113 section 8.2.1: regular header field names must be lowercase tokens.
pub fn isValidHeaderName(name: &str): bool {
    let n = len(name)
    if n == 0 { return false }
    var i = 0
    if n >= 32 {
        let va = VB.splat('a')
        let vz = VB.splat('z')
        let v0 = VB.splat('0')
        let v9 = VB.splat('9')
        let vDash = VB.splat('-')
        let vUnder = VB.splat('_')
        while i + 32 <= n {
            let v = VB.load(name, i)
            let ok = ((v >= va) & (v <= vz)) | ((v >= v0) & (v <= v9)) | (v == vDash) | (v == vUnder)
            var bad = ok.bitmask() ^ u64(0xffffffff)
            while bad != u64(0) {
                let p = i + int(bad.trailingZeros())
                if LOWER_TCHAR_LUT[int(name[p])] == '0' { return false }
                bad = bad & (bad - u64(1))
            }
            i += 32
        }
    }
    while i < n {
        if LOWER_TCHAR_LUT[int(name[i])] == '0' { return false }
        i += 1
    }
    return true
}

// 256-byte lookup table for valid HTTP/2 header value bytes (HTAB, 0x20..0x7e, 0x80..0xff).
const H2_VAL_LUT =
    "00000000010000000000000000000000" + // 0x00..0x1f: only HTAB (0x09)
    "11111111111111111111111111111111" + // 0x20..0x3f
    "11111111111111111111111111111111" + // 0x40..0x5f
    "11111111111111111111111111111110" + // 0x60..0x7f: 0x7f forbidden
    "11111111111111111111111111111111" +
    "11111111111111111111111111111111" +
    "11111111111111111111111111111111" +
    "11111111111111111111111111111111"

// RFC 9113 section 8.2.1: no NUL, CR, LF, other controls (except HTAB),
// and no leading or trailing SP / HTAB.
pub fn isValidHeaderValue(val: &str): bool {
    let n = len(val)
    if n > 0 && (val[0] == ' ' || val[0] == '\t' || val[n - 1] == ' ' || val[n - 1] == '\t') { return false }
    var i = 0
    if n >= 32 {
        let v20 = VB.splat(byte(0x20))
        let vTab = VB.splat('\t')
        let v7f = VB.splat(byte(0x7f))
        while i + 32 <= n {
            let v = VB.load(val, i)
            if (((v < v20) & (v != vTab)) | (v == v7f)).any() { return false }
            i += 32
        }
    }
    while i < n {
        if H2_VAL_LUT[int(val[i])] == '0' { return false }
        i += 1
    }
    return true
}

// RFC 9113 section 8.2.2: connection-specific header fields forbidden in HTTP/2.
pub fn isForbiddenHeader(name: &str): bool {
    let n = len(name)
    if n < 7 || n > 17 { return false }
    if n == 10 { return name == "connection" || name == "keep-alive" }
    if n == 7 { return name == "upgrade" }
    if n == 16 { return name == "proxy-connection" }
    if n == 17 { return name == "transfer-encoding" }
    return false
}

// RFC 9110 section 6.5.1: header fields forbidden in trailers (framing, routing,
// authentication, request modifiers, content/response-control headers).
pub fn isForbiddenTrailer(name: &str): bool {
    let n = len(name)
    if n == 2 && name == "te" { return true }
    if n == 3 && name == "age" { return true }
    if n == 4 && (name == "host" || name == "date" || name == "vary") { return true }
    if n == 5 && name == "range" { return true }
    if n == 6 && (name == "cookie" || name == "expect") { return true }
    if n == 7 && (name == "upgrade" || name == "trailer" || name == "expires" || name == "warning") { return true }
    if n == 8 && (name == "location" || name == "if-match" || name == "if-range") { return true }
    if n == 10 && (name == "connection" || name == "keep-alive" || name == "set-cookie") { return true }
    if n == 11 && name == "retry-after" { return true }
    if n == 12 && (name == "content-type" || name == "max-forwards") { return true }
    if n == 13 && (name == "authorization" || name == "cache-control" || name == "content-range" || name == "if-none-match") { return true }
    if n == 14 && name == "content-length" { return true }
    if n == 16 && (name == "proxy-connection" || name == "content-encoding" || name == "www-authenticate") { return true }
    if n == 17 && (name == "transfer-encoding" || name == "if-modified-since") { return true }
    if n == 18 && name == "proxy-authenticate" { return true }
    if n == 19 && (name == "proxy-authorization" || name == "if-unmodified-since") { return true }
    return false
}

// Checks a decoded trailer block (RFC 9113 section 8.1 / 8.2 & RFC 9110 section 6.5.1):
// no pseudo-headers, valid lowercase names, valid values, no forbidden trailer fields.
pub fn validateTrailers(fields: &[]hpack.Field): bool {
    for f in fields {
        if len(f.name) == 0 || f.name[0] == ':' { return false }
        if !isValidHeaderName(&f.name) || !isValidHeaderValue(&f.value) { return false }
        if isForbiddenHeader(&f.name) || isForbiddenTrailer(&f.name) { return false }
    }
    return true
}

// RFC 3986 section 3.1: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ).
pub fn isValidScheme(s: &str): bool {
    if len(s) == 0 { return false }
    let c0 = s[0]
    if !((c0 >= 'a' && c0 <= 'z') || (c0 >= 'A' && c0 <= 'Z')) { return false }
    for i in 1..len(s) {
        let c = s[i]
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
                 c == '+' || c == '-' || c == '.'
        if !ok { return false }
    }
    return true
}

// Trims leading and trailing HTTP optional whitespace (SP / HTAB).
pub fn trimOws(s: &str): str {
    var a = 0
    var b = len(s)
    while a < b && (s[a] == ' ' || s[a] == '\t') { a += 1 }
    while b > a && (s[b - 1] == ' ' || s[b - 1] == '\t') { b -= 1 }
    if a == 0 && b == len(s) { return s.clone() }
    return s[a..b].clone()
}

// RFC 9113 section 9.2.2: checks whether a negotiated TLS version & OpenSSL
// cipher suite name satisfy HTTP/2's AEAD + forward-secrecy requirements.
pub fn isGoodTlsCipher(version: &str, cipher: &str): bool {
    if version == "TLSv1.3" { return true }
    if version != "TLSv1.2" { return false }
    let pfs = strings.startsWith(cipher, "ECDHE-") || strings.startsWith(cipher, "DHE-")
    if !pfs { return false }
    return strings.contains(cipher, "-GCM-") || strings.contains(cipher, "CHACHA20-POLY1305") || strings.contains(cipher, "-CCM")
}
