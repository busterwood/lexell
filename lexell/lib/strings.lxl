// strings: searching, splitting, joining, replacing, trimming, case,
// integer parsing and formatting, padding, UTF-8, eza's natural name order
// and its QuoteSpaces escaping.
//
// str is a byte string. Indexes and lengths are in bytes; the rune functions
// decode UTF-8. Case functions change ASCII letters only: toLowerAscii does not
// import unicode, because the Unicode tables cost about 135 KB in every
// program that lowercases a byte and no example needs more than ASCII (eza's
// extension sort is ASCII, zoxide documents ASCII-only lower, jq has
// ascii_downcase and markdown has its own fold data). Callers that need full
// Unicode use unicode.lower. The module also owns StrBuf and the basic
// helpers that were once in std: substr, indexOf, startsWith, endsWith,
// contains, split (at a string), splitByte, trim, repeat, isSpace, isDigit
// and the Option-returning parseIntOpt.
//
// natcmp/natcmpFold reproduce natord-plus-plus 2.0.0, the crate behind eza's
// name order. They decode UTF-8 like the crate's char iterator and keep its
// documented partial lowercase table (lowerCp); see the comment there for the
// exact divergence from Rust's to_lowercase.

// ------------------------------------------------------------ searching

// The last index of sub in s, or -1.
pub fn lastIndexOf(s: &str, sub: &str): int {
    var i = len(s) - len(sub)
    while i >= 0 {
        if matches(s, i, sub) { return i }
        i -= 1
    }
    return -1
}

// The first index of byte c in s at or after from, or -1. A negative from
// counts as 0; from at or past the end gives -1.
pub fn indexOfByte(s: &str, c: byte, from: int): int {
    let start = if from < 0 { 0 } else { from }
    return strFindByte(s, start, c)
}

// The first index at or after from of a byte in set, or -1. set is a byte set:
// each of its bytes is sought, not a sequence. An empty set finds nothing and
// a negative from counts as 0.
pub fn indexOfAny(s: &str, set: &str, from: int): int {
    let start = if from < 0 { 0 } else { from }
    return strFindAny(s, start, set)
}

// The last index of byte c in s, or -1. No runtime reverse scan exists, so
// this walks backwards a byte at a time.
pub fn lastIndexOfByte(s: &str, c: byte): int {
    var i = len(s) - 1
    while i >= 0 {
        if strByte(s, i) == c { return i }
        i -= 1
    }
    return -1
}

// The number of non-overlapping occurrences of sub (sub not empty).
pub fn count(s: &str, sub: &str): int {
    if len(sub) == 0 { panic("strings.count: empty sub") }
    var n = 0
    var i = strFind(s, 0, sub)
    while i >= 0 {
        n += 1
        i = strFind(s, i + len(sub), sub)
    }
    return n
}

fn matches(s: &str, at: int, sub: &str): bool {
    if at < 0 || at + len(sub) > len(s) { return false }
    for j in 0..len(sub) {
        if strByte(s, at + j) != strByte(sub, j) { return false }
    }
    return true
}

// Whether a and b are equal ignoring ASCII case.
pub fn equalFoldAscii(a: &str, b: &str): bool {
    if len(a) != len(b) { return false }
    for i in 0..len(a) {
        if lowerByte(strByte(a, i)) != lowerByte(strByte(b, i)) { return false }
    }
    return true
}

// ------------------------------------------------------------ splitting
//
// The pieces are views (&str) of s: no copy and no count, valid while s is
// (design/borrow-types.md; s is frozen while they live). A piece converts to
// str where one is expected; owned(&pieces) keeps a whole array past s.

// The pieces of s between occurrences of sep (sep not empty); "" gives [""].
pub fn split(s: &str, sep: &str): []&str { return splitN(s, sep, -1) }

// At most n pieces (n < 0: all): the last one holds the rest of s.
pub fn splitN(s: &str, sep: &str, n: int): []&str {
    if len(sep) == 0 { panic("strings.split: empty separator") }
    var out: []&str = []
    var start = 0
    var i = strFind(s, 0, sep)
    while i >= 0 && (n < 0 || len(out) < n - 1) {
        append(mut &out, &s[start..i])
        start = i + len(sep)
        i = strFind(s, start, sep)
    }
    append(mut &out, &s[start..len(s)])
    return out
}

// The words of s: the runs of non-space bytes.
pub fn fields(s: &str): []&str {
    var out: []&str = []
    var i = 0
    while i < len(s) {
        while i < len(s) && isSpace(s[i]) { i += 1 }
        let start = i
        while i < len(s) && !isSpace(s[i]) { i += 1 }
        if i > start { append(mut &out, &s[start..i]) }
    }
    return out
}

// The pieces as owned strings, to keep past the text they view.
pub fn owned(pieces: &[]&str): []str {
    var out: []str = []
    for p in pieces { append(mut &out, p) }
    return out
}

// An iterator over the lines of a text: `for line in strings.lines(&text)`.
// Each line is a view without its '\n'; a final line without one is a line,
// and a text ending in '\n' has no empty line after it ("" has no lines).
pub type Lines = value record {
    text: &str
    pos: int
}

pub fn lines(text: &str): Lines { return Lines{text: text, pos: 0} }

pub fn (it: mut &Lines) next(): Option[&str] {
    let n = len(it.text)
    if it.pos >= n { return None }
    let start = it.pos
    var e = strFindByte(it.text, start, '\n')
    if e < 0 { e = n }
    it.pos = e + 1
    return Some(it.text[start..e])
}

// An iterator over the words of a text (fields', one at a time).
pub type Fields = value record {
    text: &str
    pos: int
}

pub fn fieldsIter(text: &str): Fields { return Fields{text: text, pos: 0} }

pub fn (it: mut &Fields) next(): Option[&str] {
    let n = len(it.text)
    var i = it.pos
    while i < n && isSpace(it.text[i]) { i += 1 }
    if i >= n {
        it.pos = n
        return None
    }
    let start = i
    while i < n && !isSpace(it.text[i]) { i += 1 }
    it.pos = i
    return Some(it.text[start..i])
}

// The text before and after the first sep, if s contains it: views of s.
pub type Cut = value record {
    pub before: &str
    pub after: &str
}

pub fn cut(s: &str, sep: &str): Option[Cut] {
    let i = strFind(s, 0, sep)
    if i < 0 { return None }
    return Some(Cut{before: s[0..i], after: s[i + len(sep)..len(s)]})
}

// The parts with sep between them. The parts are views (`&[&str]`): an array of views, or of
// owned strings (`&names`, read as views, SPEC 4.1), or a slice of either.
pub fn join(parts: &[&str], sep: &str): str {
    var b = newStrBuf()
    for i in 0..len(parts) {
        if i > 0 { b.add(sep) }
        b.add(parts[i])
    }
    return b.toStr()
}

// ------------------------------------------------------------ replacing

// s with every occurrence of old (not empty) replaced by new.
pub fn replaceAll(s: &str, old: &str, new: &str): str { return replaceN(s, old, new, -1) }

// s with the first n occurrences of old replaced (all when n < 0).
pub fn replaceN(s: &str, old: &str, new: &str, n: int): str {
    if len(old) == 0 { panic("strings.replace: empty pattern") }
    var b = newStrBuf()
    var start = 0
    var done = 0
    var i = indexOf(s, old, 0)
    while i >= 0 && (n < 0 || done < n) {
        b.add(&(strSlice(s, start, i)))
        b.add(new)
        start = i + len(old)
        done += 1
        i = indexOf(s, old, start)
    }
    if done == 0 { return s }
    b.add(&(strSlice(s, start, len(s))))
    return b.toStr()
}

// ------------------------------------------------------------ trimming

pub fn trimLeft(s: &str): str {
    var a = 0
    while a < len(s) && isSpace(strByte(s, a)) { a += 1 }
    return strSlice(s, a, len(s))
}

pub fn trimRight(s: &str): str {
    var b = len(s)
    while b > 0 && isSpace(strByte(s, b - 1)) { b -= 1 }
    return strSlice(s, 0, b)
}

// s without prefix, if it starts with it (else s).
pub fn trimPrefix(s: &str, prefix: &str): str {
    if startsWith(s, prefix) { return strSlice(s, len(prefix), len(s)) }
    return s
}

pub fn trimSuffix(s: &str, suffix: &str): str {
    if endsWith(s, suffix) { return strSlice(s, 0, len(s) - len(suffix)) }
    return s
}

// ------------------------------------------------------------ case

pub fn toUpperAscii(s: &str): str {
    var bs = strToBytes(s)
    for i in 0..len(bs) {
        if bs[i] >= 'a' && bs[i] <= 'z' { bs[i] -= 32 }
    }
    return strFromBytes(&bs)
}

pub fn toLowerAscii(s: &str): str {
    var bs = strToBytes(s)
    for i in 0..len(bs) { bs[i] = lowerByte(bs[i]) }
    return strFromBytes(&bs)
}

fn lowerByte(c: byte): byte {
    if c >= 'A' && c <= 'Z' { return c + 32 }
    return c
}

pub fn isLetter(c: byte): bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }
pub fn isAlnum(c: byte): bool { return isLetter(c) || isDigit(c) }

// C-locale isprint: 0x20..0x7E (printable ASCII, not DEL or a control byte).
pub fn isPrint(c: byte): bool { return c >= ' ' && c <= '~' }

// The blanks sort -n skips: space and tab only.
pub fn isBlank(c: byte): bool { return c == ' ' || c == '\t' }

// GNU wc's C-locale word byte: printable and not space (0x21..0x7E).
pub fn isWordByte(c: byte): bool { return isPrint(c) && c != ' ' }

// ------------------------------------------------------- eza name escaping
//
// eza's QuoteSpaces escaping (src/output/escape.rs). The rule:
//   1. needs = the name contains ' ' or '\'';
//   2. when quoteSpaces && needs, wrap in '"' if the name contains '\'',
//      otherwise in '\'';
//   3. \t, \n and \r become \\t, \\n, \\r; every other byte < 0x20 or 0x7f
//      becomes \u{h} with lowercase hex and no leading zeros; every other byte
//      is copied unchanged (including \\, ", ' and bytes >= 0x80);
//   4. quotes wrap the escaped bytes and embedded quotes are not escaped.
// With quoteSpaces=false no quote characters are added but controls are still
// escaped. The function is byte-wise and does not validate UTF-8.

// One lowercase hex digit, 0..15.
fn hexDigit(v: int): byte {
    if v < 10 { return byte(int('0') + v) }
    return byte(int('a') + (v - 10))
}

// Append the lowercase hex form of a byte with no leading zero: 0 -> "0",
// 0x1b -> "1b", 0x7f -> "7f" (the \u{...} payload of quoteName).
fn appendHexByte(b: mut &StrBuf, v: byte) {
    let hi = int(v) / 16
    let lo = int(v) % 16
    if hi > 0 { b.addByte(hexDigit(hi)) }
    b.addByte(hexDigit(lo))
}

pub fn quoteName(name: &str, quoteSpaces: bool): str {
    var needs = false
    var hasSingle = false
    for i in 0..len(name) {
        let b = strByte(name, i)
        if b == ' ' || b == '\'' { needs = true }
        if b == '\'' { hasSingle = true }
    }
    var quote = false
    var q: byte = '\''
    if quoteSpaces && needs {
        quote = true
        if hasSingle { q = '"' }
    }
    var b = newStrBuf()
    if quote { b.addByte(q) }
    for i in 0..len(name) {
        let c = strByte(name, i)
        if c == '\t' {
            b.add("\\t")
        } else if c == '\n' {
            b.add("\\n")
        } else if c == '\r' {
            b.add("\\r")
        } else if c < ' ' || c == 127 {
            b.add("\\u{")
            appendHexByte(mut &b, c)
            b.addByte('}')
        } else {
            b.addByte(c)
        }
    }
    if quote { b.addByte(q) }
    return b.toStr()
}

// The shared parent prefix of an input operand or symlink target: escape the
// whole parent once with the outer style, then:
//   "" for an empty parent; "/" for parent "/" (the escaped root already ends
//   in a separator, so none is added); otherwise the escaped parent plus "/".
// It does not append a name. "/tmp" gives "/tmp/", "x y/sub" gives
// "'x y/sub'/"; the caller appends the escaped name.
pub fn parentPrefix(parent: &str, quoteSpaces: bool): str {
    if len(parent) == 0 { return "" }
    let escaped = quoteName(parent, quoteSpaces)
    if parent == "/" { return escaped }
    return escaped + "/"
}

// ------------------------------------------------------------ integers

pub type ParseError = value closed {
    Empty           // no digits
    Invalid(int)    // the byte offset of the first byte that is not a digit
    OutOfRange      // does not fit in an int
}

pub fn (e: ParseError) toStr(): str {
    match e {
        ParseError.Empty { return "no digits" }
        ParseError.Invalid(at) { return "invalid digit at " + intToStr(at) }
        ParseError.OutOfRange { return "out of range" }
    }
}

pub fn (a: ParseError) eq(b: &ParseError): bool { return a.toStr() == b.toStr() }

// A decimal int with an optional sign: "42", "-7", "+3".
pub fn parseInt(s: &str): Result[int, ParseError] { return parseIntBase(s, 10) }

// An int in base 2..36 with an optional sign; letters in either case. No
// prefix ("0x") is accepted: strip it first.
pub fn parseIntBase(s: &str, base: int): Result[int, ParseError] {
    if base < 2 || base > 36 { panic("strings.parseIntBase: base must be 2..36") }
    var i = 0
    var neg = false
    if len(s) > 0 && (strByte(s, 0) == '-' || strByte(s, 0) == '+') {
        neg = strByte(s, 0) == '-'
        i = 1
    }
    if i == len(s) { return Err(ParseError.Empty) }
    var n: i128 = 0
    while i < len(s) {
        let d = digitValue(strByte(s, i))
        if d < 0 || d >= base { return Err(ParseError.Invalid(i)) }
        n = n * i128(base) + i128(d)
        if n > 9223372036854775808 { return Err(ParseError.OutOfRange) }
        i += 1
    }
    if neg { n = -n }
    if n > 9223372036854775807 { return Err(ParseError.OutOfRange) }
    return Ok(int(n))
}

fn digitValue(c: byte): int {
    if c >= '0' && c <= '9' { return int(c - '0') }
    if c >= 'a' && c <= 'z' { return int(c - 'a') + 10 }
    if c >= 'A' && c <= 'Z' { return int(c - 'A') + 10 }
    return -1
}

// n in base 2..36, lower-case letters, "-" when negative.
pub fn formatInt(n: int, base: int): str {
    if base < 2 || base > 36 { panic("strings.formatInt: base must be 2..36") }
    if n == 0 { return "0" }
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    var v = i128(n)
    var neg = false
    if v < 0 {
        neg = true
        v = -v
    }
    var bs: []byte = []
    while v > 0 {
        append(mut &bs, strByte(digits, int(v % i128(base))))
        v = v / i128(base)
    }
    if neg { append(mut &bs, '-') }
    reverseBytes(mut &bs)
    return strFromBytes(&bs)
}

fn reverseBytes(bs: mut &[]byte) {
    var i = 0
    var j = len(bs) - 1
    while i < j {
        swap(bs, i, j)
        i += 1
        j -= 1
    }
}

// n in lower-case hexadecimal ("ff"; "-1a" when negative).
pub fn hex(n: int): str { return formatInt(n, 16) }

// The 64 bits of n as hexadecimal, zero-padded to 16 digits.
pub fn hex64(n: u64): str {
    let digits = "0123456789abcdef"
    var bs = array(16, '0')
    var v = n
    var i = 15
    while v != 0 {
        bs[i] = strByte(digits, int(v & 15))
        v = v >> 4
        i -= 1
    }
    return strFromBytes(&bs)
}

// n in decimal, at least width digits with leading zeros: zeroPad(7, 3) is
// "007", zeroPad(-7, 3) is "-007".
pub fn zeroPad(n: int, width: int): str {
    var digits = intToStr(n)
    var sign = ""
    if n < 0 {
        sign = "-"
        digits = strSlice(digits, 1, len(digits))
    }
    return sign + padLeft(&digits, width, '0')
}

// n with sep between groups of three digits: 1234567 is "1,234,567".
pub fn groupDigits(n: int, sep: &str): str {
    let s = intToStr(n)
    var start = 0
    if n < 0 { start = 1 }
    var b = newStrBuf()
    b.add(&(strSlice(s, 0, start)))
    for i in start..len(s) {
        if i > start && (len(s) - i) % 3 == 0 { b.add(sep) }
        b.addByte(strByte(s, i))
    }
    return b.toStr()
}

// ------------------------------------------------------------ padding

// s with fill bytes before it, to width bytes (s itself if it is as long).
pub fn padLeft(s: &str, width: int, fill: byte): str {
    if len(s) >= width { return s }
    return strFromBytes(&array(width - len(s), fill)) + s
}

pub fn padRight(s: &str, width: int, fill: byte): str {
    if len(s) >= width { return s }
    return s + strFromBytes(&array(width - len(s), fill))
}

// s centred in width bytes; an odd fill byte goes on the right.
pub fn center(s: &str, width: int, fill: byte): str {
    if len(s) >= width { return s }
    let left = (width - len(s)) / 2
    return padRight(&(padLeft(s, len(s) + left, fill)), width, fill)
}

// ------------------------------------------------------------ UTF-8

// A code point decoded from UTF-8 and the number of bytes it took. Invalid
// input decodes as U+FFFD (ok false) and takes the maximal invalid subpart:
// one byte, or the bytes of a sequence that started well and was cut short
// ("\xE2\x82(" is one U+FFFD then "("), as Unicode recommends and Rust's
// from_utf8_lossy does.
pub type Decoded = value record {
    pub rune: int
    pub size: int
    pub ok: bool
}

pub const REPLACEMENT = 0xFFFD

// The code point starting at byte i of s (0 <= i < len(s)).
pub fn decodeAt(s: &str, i: int): Decoded {
    let c0 = int(strByte(s, i))
    if c0 < 0x80 { return Decoded{rune: c0, size: 1, ok: true} }
    var n = 0
    var r = 0
    var lo = 0x80   // the range of the second byte
    var hi = 0xBF
    if c0 >= 0xC2 && c0 <= 0xDF {
        n = 2
        r = c0 & 0x1F
    } else if c0 >= 0xE0 && c0 <= 0xEF {
        n = 3
        r = c0 & 0x0F
        if c0 == 0xE0 { lo = 0xA0 }   // no overlong forms
        if c0 == 0xED { hi = 0x9F }   // no surrogates
    } else if c0 >= 0xF0 && c0 <= 0xF4 {
        n = 4
        r = c0 & 0x07
        if c0 == 0xF0 { lo = 0x90 }
        if c0 == 0xF4 { hi = 0x8F }   // nothing past U+10FFFF
    } else {
        return Decoded{rune: REPLACEMENT, size: 1, ok: false}
    }
    for k in 1..n {
        if i + k >= len(s) { return Decoded{rune: REPLACEMENT, size: k, ok: false} }
        let c = int(strByte(s, i + k))
        if c < lo || c > hi { return Decoded{rune: REPLACEMENT, size: k, ok: false} }
        r = (r << 6) | (c & 0x3F)
        lo = 0x80
        hi = 0xBF
    }
    return Decoded{rune: r, size: n, ok: true}
}

// The code points of s.
pub fn runes(s: &str): []int {
    var out: []int = []
    var i = 0
    while i < len(s) {
        let d = decodeAt(s, i)
        append(mut &out, d.rune)
        i += d.size
    }
    return out
}

// The number of code points in s (each invalid byte counts as one).
pub fn runeCount(s: &str): int {
    var n = 0
    var i = 0
    while i < len(s) {
        i += decodeAt(s, i).size
        n += 1
    }
    return n
}

// Whether s is valid UTF-8.
pub fn isValidUtf8(s: &str): bool {
    var i = 0
    while i < len(s) {
        if strByte(s, i) < 0x80 {
            i += 1
        } else {
            let d = decodeAt(s, i)
            if !d.ok { return false }
            i += d.size
        }
    }
    return true
}

// Rust's message for the first invalid sequence in s, or None when s is
// valid UTF-8. The wording is std::str::Utf8Error's Display ("invalid utf-8
// sequence of N bytes from index I" / "incomplete utf-8 byte sequence from
// index I") with the byte index of the first bad sequence, as zoxide reports
// it. The N is the maximal invalid subpart decodeAt consumes: a cut-short
// sequence at the end of s is "incomplete", anything followed by more bytes is
// an "invalid ... sequence".
pub fn utf8Error(s: &str): Option[str] {
    var i = 0
    while i < len(s) {
        if strByte(s, i) < 0x80 {
            i += 1
            continue
        }
        let d = decodeAt(s, i)
        if d.ok {
            i += d.size
            continue
        }
        let c = int(strByte(s, i))
        if c < 0xC2 || c > 0xF4 || i + d.size < len(s) {
            return Some("invalid utf-8 sequence of " + intToStr(d.size) + " bytes from index " + intToStr(i))
        }
        return Some("incomplete utf-8 byte sequence from index " + intToStr(i))
    }
    return None
}

// s with each invalid part (decodeAt) replaced by U+FFFD; s itself when it
// is valid UTF-8.
pub fn lossy(s: &str): str {
    if isValidUtf8(s) { return s }
    var b = newStrBuf()
    var i = 0
    while i < len(s) {
        let d = decodeAt(s, i)
        if d.ok { b.add(s[i..i + d.size]) } else { addRune(mut &b, REPLACEMENT) }
        i += d.size
    }
    return b.toStr()
}

// ------------------------------------------------------- the eza name order
//
// natord-plus-plus 2.0.0 compares a sequence of chars: Unicode whitespace is
// skipped at the top of the outer loop, ASCII digit runs compare naturally and
// everything else compares by code point (folded for compare_ignore_case).
// The decoder is decodeAt, so invalid bytes compare as the U+FFFD that eza's
// lossy decode would produce. One code-point loop handles both forms: an ASCII
// byte steps without decoding, so there is no separate scan of the whole
// string before the comparison.

fn isDigitCp(cp: int): bool { return cp >= int('0') && cp <= int('9') }

fn signCp(a: int, b: int): int {
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

// Rust char::is_whitespace (the White_Space property): the exact set the
// reference's natord compares skip. ASCII space and 0x09..0x0D are included.
fn isUnicodeSpace(cp: int): bool {
    if cp == 0x20 { return true }
    if cp >= 0x09 && cp <= 0x0D { return true }
    if cp == 0x85 || cp == 0xA0 || cp == 0x1680 { return true }
    if cp >= 0x2000 && cp <= 0x200A { return true }
    if cp == 0x2028 || cp == 0x2029 || cp == 0x202F { return true }
    if cp == 0x205F || cp == 0x3000 { return true }
    return false
}

// Simple single-code-point Unicode lowercase for the common blocks: ASCII,
// Latin-1 Supplement, Latin Extended-A, the basic Greek and Cyrillic blocks and
// fullwidth A-Z. Rust's char::to_lowercase() is full Unicode lowercase; it can
// expand one character into several (U+0130 is "i" plus a combining dot) and it
// covers every script. Outside these blocks 1,234 scalar values (542 ranges)
// still compare by their original code point, the documented divergence;
// U+0130 is the only multi-character expansion and is deliberately left
// unfolded. This is eza fidelity, not a substitute for unicode.lower.
fn lowerCp(cp: int): int {
    if cp >= int('A') && cp <= int('Z') { return cp + 32 }
    if cp >= 0xC0 && cp <= 0xD6 { return cp + 32 }
    if cp >= 0xD8 && cp <= 0xDE { return cp + 32 }
    if cp >= 0x100 && cp <= 0x137 && cp != 0x130 && cp % 2 == 0 {
        return cp + 1
    }
    if cp >= 0x139 && cp <= 0x148 && cp % 2 == 1 { return cp + 1 }
    if cp >= 0x14A && cp <= 0x177 && cp % 2 == 0 { return cp + 1 }
    if cp == 0x178 { return 0xFF }
    if cp >= 0x179 && cp <= 0x17E && cp % 2 == 1 { return cp + 1 }
    if cp == 0x386 { return 0x3AC }
    if cp >= 0x388 && cp <= 0x38A { return cp + 37 }
    if cp == 0x38C { return 0x3CC }
    if cp >= 0x38E && cp <= 0x38F { return cp + 63 }
    if cp >= 0x391 && cp <= 0x3A1 { return cp + 32 }
    if cp >= 0x3A3 && cp <= 0x3AB { return cp + 32 }
    if cp == 0x3CF { return 0x3D7 }
    if cp >= 0x400 && cp <= 0x40F { return cp + 80 }
    if cp >= 0x410 && cp <= 0x42F { return cp + 32 }
    if cp >= 0xFF21 && cp <= 0xFF3A { return cp + 32 }
    return cp
}

// C-locale whitespace as natord skips it: space and 0x09..0x0D (std.isSpace
// omits VT and FF, and this comparator must keep the crate's set).
fn isNatSpace(c: byte): bool { return c == ' ' || (c >= '\t' && c <= '\r') }

// The ASCII byte form of the comparison (design Appendix A): fold selects
// ASCII A..Z folding; digits are unaffected. Whitespace is skipped only at the
// top of the outer loop, never inside a digit run.
//
// The first byte >= 0x80 hands the whole comparison to natcmpUtf8, so a pure
// ASCII name pays no pre-scan (eza compares names in every sort and tree
// walk). The hand-off is complete rather than resumable, which keeps the two
// forms' state machines independent; only a name with non-ASCII bytes pays to
// restart.
fn natcmpAscii(a: &str, b: &str, fold: bool): int {
    var i = 0
    var j = 0
    while true {
        while i < len(a) && isNatSpace(strByte(a, i)) { i += 1 }
        while j < len(b) && isNatSpace(strByte(b, j)) { j += 1 }
        if i == len(a) && j == len(b) { return 0 }
        if i == len(a) { return -1 }
        if j == len(b) { return 1 }
        let da = isDigit(strByte(a, i))
        let db = isDigit(strByte(b, j))
        if da && db {
            if strByte(a, i) == '0' || strByte(b, j) == '0' {
                // left-aligned matching: 015 < 12
                if strByte(a, i) != strByte(b, j) {
                    if strByte(a, i) < strByte(b, j) { return -1 }
                    return 1
                }
                i += 1
                j += 1
                while i < len(a) && j < len(b) && isDigit(strByte(a, i)) && isDigit(strByte(b, j)) {
                    if strByte(a, i) != strByte(b, j) {
                        if strByte(a, i) < strByte(b, j) { return -1 }
                        return 1
                    }
                    i += 1
                    j += 1
                }
                if i < len(a) && isDigit(strByte(a, i)) { return 1 }
                if j < len(b) && isDigit(strByte(b, j)) { return -1 }
                // both runs ended: continue the outer loop
            } else {
                // right-aligned matching: 15 < 123
                var last = 0
                while i < len(a) && j < len(b) && isDigit(strByte(a, i)) && isDigit(strByte(b, j)) {
                    if last == 0 && strByte(a, i) != strByte(b, j) {
                        if strByte(a, i) < strByte(b, j) { last = -1 } else { last = 1 }
                    }
                    i += 1
                    j += 1
                }
                if i < len(a) && isDigit(strByte(a, i)) { return 1 }
                if j < len(b) && isDigit(strByte(b, j)) { return -1 }
                if last != 0 { return last }
                // both runs ended equal: continue
            }
        } else {
            var ca = strByte(a, i)
            var cb = strByte(b, j)
            if ca >= 0x80 || cb >= 0x80 { return natcmpUtf8(a, b, fold) }
            if fold {
                if ca >= 'A' && ca <= 'Z' { ca = byte(ca + 32) }
                if cb >= 'A' && cb <= 'Z' { cb = byte(cb + 32) }
            }
            if ca < cb { return -1 }
            if ca > cb { return 1 }
            i += 1
            j += 1
        }
    }
}

// A decoded code point with rune -1 at the end of s. An ASCII byte is the
// common case in names, so it becomes a one-field step with no UTF-8 decode.
fn peekDecoded(s: &str, i: int): Decoded {
    if i >= len(s) { return Decoded{rune: -1, size: 0, ok: true} }
    let c = strByte(s, i)
    if c < 0x80 { return Decoded{rune: int(c), size: 1, ok: true} }
    return decodeAt(s, i)
}

// natord::compare_iter over decoded code points (fold selects lowerCp).
// pa/pb are the current decoded steps, so advancing is an index move plus a
// peek (one byte read for ASCII, decodeAt otherwise).
fn natcmpUtf8(a: &str, b: &str, fold: bool): int {
    var i = 0
    var j = 0
    var pa = peekDecoded(a, 0)
    var pb = peekDecoded(b, 0)
    while true {
        while pa.rune >= 0 && isUnicodeSpace(pa.rune) {
            i += pa.size
            pa = peekDecoded(a, i)
        }
        while pb.rune >= 0 && isUnicodeSpace(pb.rune) {
            j += pb.size
            pb = peekDecoded(b, j)
        }
        if pa.rune < 0 && pb.rune < 0 { return 0 }
        if pa.rune < 0 { return -1 }
        if pb.rune < 0 { return 1 }
        if isDigitCp(pa.rune) && isDigitCp(pb.rune) {
            if pa.rune == int('0') || pb.rune == int('0') {
                // left-aligned matching: 015 < 12
                if pa.rune != pb.rune { return signCp(pa.rune, pb.rune) }
                i += pa.size
                j += pb.size
                pa = peekDecoded(a, i)
                pb = peekDecoded(b, j)
                while pa.rune >= 0 && pb.rune >= 0 && isDigitCp(pa.rune) &&
                        isDigitCp(pb.rune) {
                    if pa.rune != pb.rune { return signCp(pa.rune, pb.rune) }
                    i += pa.size
                    j += pb.size
                    pa = peekDecoded(a, i)
                    pb = peekDecoded(b, j)
                }
                if pa.rune >= 0 && isDigitCp(pa.rune) { return 1 }
                if pb.rune >= 0 && isDigitCp(pb.rune) { return -1 }
                // both runs ended: continue the outer loop
            } else {
                // right-aligned matching: 15 < 123
                var last = 0
                while pa.rune >= 0 && pb.rune >= 0 && isDigitCp(pa.rune) &&
                        isDigitCp(pb.rune) {
                    if last == 0 && pa.rune != pb.rune { last = signCp(pa.rune, pb.rune) }
                    i += pa.size
                    j += pb.size
                    pa = peekDecoded(a, i)
                    pb = peekDecoded(b, j)
                }
                if pa.rune >= 0 && isDigitCp(pa.rune) { return 1 }
                if pb.rune >= 0 && isDigitCp(pb.rune) { return -1 }
                if last != 0 { return last }
                // both runs ended equal: continue
            }
        } else {
            var x = pa.rune
            var y = pb.rune
            if fold {
                x = lowerCp(x)
                y = lowerCp(y)
            }
            if x < y { return -1 }
            if x > y { return 1 }
            i += pa.size
            j += pb.size
            pa = peekDecoded(a, i)
            pb = peekDecoded(b, j)
        }
    }
}

// eza's name order: natord::compare (case-sensitive) and
// natord::compare_ignore_case (simple Unicode lowercase). -1, 0 or 1.
pub fn natcmp(a: &str, b: &str): int {
    return natcmpAscii(a, b, false)
}

pub fn natcmpFold(a: &str, b: &str): int {
    return natcmpAscii(a, b, true)
}

// The names used by the stdlib contract for the same eza order.
pub fn naturalCompare(a: &str, b: &str): int { return natcmp(a, b) }

pub fn naturalCompareFold(a: &str, b: &str): int { return natcmpFold(a, b) }

// Appends the UTF-8 encoding of r to b (U+FFFD for an invalid code point).
pub fn addRune(b: mut &StrBuf, r: int) {
    var c = r
    if c < 0 || c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF) { c = REPLACEMENT }
    if c < 0x80 {
        b.addByte(byte(c))
    } else if c < 0x800 {
        b.addByte(byte(0xC0 | (c >> 6)))
        b.addByte(byte(0x80 | (c & 0x3F)))
    } else if c < 0x10000 {
        b.addByte(byte(0xE0 | (c >> 12)))
        b.addByte(byte(0x80 | ((c >> 6) & 0x3F)))
        b.addByte(byte(0x80 | (c & 0x3F)))
    } else {
        b.addByte(byte(0xF0 | (c >> 18)))
        b.addByte(byte(0x80 | ((c >> 12) & 0x3F)))
        b.addByte(byte(0x80 | ((c >> 6) & 0x3F)))
        b.addByte(byte(0x80 | (c & 0x3F)))
    }
}

// The UTF-8 text of one code point.
pub fn fromRune(r: int): str {
    var b = newStrBuf()
    addRune(mut &b, r)
    return b.toStr()
}

// The UTF-8 text of code points.
pub fn fromRunes(rs: &[int]): str {
    var b = newStrBuf()
    for r in rs { addRune(mut &b, r) }
    return b.toStr()
}

// ---- StrBuf and the prelude string helpers
pub type StrBuf = record { bytes: []byte }

pub fn newStrBuf(): StrBuf { return StrBuf{bytes: []} }

pub fn (b: mut &StrBuf) add(s: &str) { appendStr(mut &b.bytes, s) }

pub fn (b: mut &StrBuf) addByte(c: byte) { append(mut &b.bytes, c) }

pub fn (b: mut &StrBuf) addInt(n: int) { b.add(&(intToStr(n))) }

pub fn (b: mut &StrBuf) addLine(s: str) {
    b.add(&s)
    append(mut &b.bytes, '\n')
}

// The number of bytes added so far.
pub fn (b: &StrBuf) size(): int { return len(b.bytes) }

pub fn (b: mut &StrBuf) clear() { replace(mut &b.bytes, []) }

pub fn (b: &StrBuf) toStr(): str { return strFromBytes(&b.bytes) }

// The bytes added so far, without copying them.
pub fn (b: &StrBuf) view(): &[]byte { return &b.bytes }

pub fn substr(s: &str, from: int, to: int): str { return strSlice(s, from, to) }

// The first index of sub in s at or after from, or -1. A negative from counts
// as 0, an empty sub is found at from, and from past the end gives -1.
pub fn indexOf(s: &str, sub: &str, from: int): int {
    let start = if from < 0 { 0 } else { from }
    let n = len(sub)
    if n == 0 {
        if start <= len(s) { return start }
        return -1
    }
    // Leave very short haystacks entirely to the scalar loop: the runtime call
    // costs more than the scan there. For longer ones the crossover grows with
    // the needle, because the runtime picks two needle bytes and reaches its
    // 16-byte loop only once a whole window fits; a one-byte needle is the
    // exception (its byte search always wins). Tuned on this tree.
    if len(s) >= 16 {
        if n == 1 { return strFind(s, start, sub) }
        let rem = len(s) - start
        let shortAt = if n <= 4 { 8 } else if n <= 7 { 2 * n + 4 } else { 3 * n + 6 }
        if rem >= shortAt { return strFind(s, start, sub) }
    }
    let first = strByte(sub, 0)
    var i = start
    while i + n <= len(s) {
        if strByte(s, i) == first && matchAt(s, i, sub) { return i }
        i += 1
    }
    return -1
}

// Whether sub occurs in s at byte offset at (which must leave room for it).
fn matchAt(s: &str, at: int, sub: &str): bool {
    for j in 0..len(sub) {
        if strByte(s, at + j) != strByte(sub, j) { return false }
    }
    return true
}

pub fn startsWith(s: &str, prefix: &str): bool {
    return len(prefix) <= len(s) && matchAt(s, 0, prefix)
}

pub fn endsWith(s: &str, suffix: &str): bool {
    return len(suffix) <= len(s) && matchAt(s, len(s) - len(suffix), suffix)
}

pub fn contains(s: &str, sub: &str): bool { return indexOf(s, sub, 0) >= 0 }

// The pieces of s between the bytes equal to sep ("" gives [""]).
pub fn splitByte(s: &str, sep: byte): []str {
    var out: []str = []
    var start = 0
    var i = strFindByte(s, start, sep)
    while i >= 0 {
        append(mut &out, strSlice(s, start, i))
        start = i + 1
        i = strFindByte(s, start, sep)
    }
    append(mut &out, strSlice(s, start, len(s)))
    return out
}

// s without leading and trailing ASCII whitespace.
pub fn trim(s: &str): str {
    var a = 0
    var b = len(s)
    while a < b && isSpace(strByte(s, a)) { a += 1 }
    while b > a && isSpace(strByte(s, b - 1)) { b -= 1 }
    return strSlice(s, a, b)
}

pub fn isSpace(c: byte): bool { return c == ' ' || c == '\n' || c == '\t' || c == '\r' }
pub fn isDigit(c: byte): bool { return c >= '0' && c <= '9' }

// A decimal int with an optional sign; None when s is not one or it overflows.
// lib/strings has parseInt with a Result that says why.
pub fn parseIntOpt(s: &str): Option[int] {
    var i = 0
    var neg = false
    if len(s) > 0 && (strByte(s, 0) == '-' || strByte(s, 0) == '+') {
        neg = strByte(s, 0) == '-'
        i = 1
    }
    if i == len(s) { return None }
    var n: i128 = 0
    while i < len(s) {
        let c = strByte(s, i)
        if c < '0' || c > '9' { return None }
        n = n * 10 + i128(c - '0')
        if n > 9223372036854775808 { return None }
        i += 1
    }
    if neg { n = -n }
    if n > 9223372036854775807 { return None }
    return Some(int(n))
}

pub fn repeat(s: &str, n: int): str {
    var b = newStrBuf()
    for i in 0..n { b.add(s) }
    return b.toStr()
}
