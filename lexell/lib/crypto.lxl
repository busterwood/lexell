// crypto: digests (SHA-1, SHA-256, SHA-384, SHA-512, MD5), streaming Hasher,
// HMAC (SHA-256, SHA-384, SHA-512), HKDF-SHA-256, PBKDF2 (SHA-256, SHA-512),
// AEAD (AES-128/256-GCM, ChaCha20-Poly1305), AES-CBC, Ed25519, X25519,
// ECDSA P-256, constant-time compare, random bytes, base64 and hex, over
// OpenSSL 3's libcrypto. Byte strings are `str` values holding any bytes.

import "base64" as b64
import "ffi"

pub type Error = value record { pub msg: str }

pub fn (e: &Error) toStr(): str { return "crypto: " + e.msg }

extern "crypto" fn EVP_sha1(): ptr
extern "crypto" fn EVP_sha256(): ptr
extern "crypto" fn EVP_sha384(): ptr
extern "crypto" fn EVP_sha512(): ptr
extern "crypto" fn EVP_md5(): ptr
extern "crypto" fn EVP_Digest(data: &[byte], n: int, md: mut &[byte], size: mut &[i32], t: ptr, impl: ptr): i32
extern "crypto" fn EVP_MD_CTX_new(): ptr
extern "crypto" fn EVP_MD_CTX_free(c: ptr)
extern "crypto" fn EVP_DigestInit_ex(c: ptr, t: ptr, impl: ptr): i32
extern "crypto" fn EVP_DigestUpdate(c: ptr, data: &[byte], n: int): i32
extern "crypto" fn EVP_DigestFinal_ex(c: ptr, md: mut &[byte], size: mut &[i32]): i32
extern "crypto" fn PKCS5_PBKDF2_HMAC(pass: &[byte], passlen: i32, salt: &[byte], saltlen: i32, iter: i32, md: ptr, keylen: i32, out: mut &[byte]): i32
extern "crypto" fn HMAC(md: ptr, key: &[byte], keylen: i32, d: &[byte], n: int, out: mut &[byte], outl: mut &[i32]): ptr
extern "crypto" fn pbkdf2Blocking(pass: &[byte], passlen: i32, salt: &[byte], saltlen: i32, iter: i32, md: ptr, keylen: i32, out: mut &[byte]): i32 as "PKCS5_PBKDF2_HMAC" blocking
extern "crypto" fn EVP_aes_128_cbc(): ptr
extern "crypto" fn EVP_aes_192_cbc(): ptr
extern "crypto" fn EVP_aes_256_cbc(): ptr
extern "crypto" fn EVP_aes_128_gcm(): ptr
extern "crypto" fn EVP_aes_256_gcm(): ptr
extern "crypto" fn EVP_chacha20_poly1305(): ptr
extern "crypto" fn EVP_CIPHER_CTX_new(): ptr
extern "crypto" fn EVP_CIPHER_CTX_free(c: ptr)
extern "crypto" fn EVP_CIPHER_CTX_set_padding(c: ptr, pad: i32): i32
extern "crypto" fn EVP_CIPHER_CTX_ctrl(c: ptr, kind: i32, arg: i32, p: ptr): i32
extern "crypto" fn EVP_CipherInit_ex(c: ptr, t: ptr, impl: ptr, key: ptr, iv: ptr, enc: i32): i32
extern "crypto" fn EVP_CipherUpdate(c: ptr, out: ptr, outl: mut &[i32], inp: &[byte], inl: i32): i32
extern "crypto" fn EVP_CipherFinal_ex(c: ptr, out: ptr, outl: mut &[i32]): i32
extern "crypto" fn EVP_PKEY_new_raw_private_key(kind: i32, e: ptr, priv: &[byte], len: int): ptr
extern "crypto" fn EVP_PKEY_new_raw_public_key(kind: i32, e: ptr, pubk: &[byte], len: int): ptr
extern "crypto" fn EVP_PKEY_get_raw_public_key(pkey: ptr, pubk: mut &[byte], len: mut &int): i32
extern "crypto" fn EVP_PKEY_free(pkey: ptr)
extern "crypto" fn EVP_PKEY_Q_keygen(libctx: ptr, propq: ptr, typeName: &str, ...): ptr
extern "crypto" fn EVP_PKEY_CTX_new(pkey: ptr, e: ptr): ptr
extern "crypto" fn EVP_PKEY_CTX_free(ctx: ptr)
extern "crypto" fn EVP_PKEY_derive_init(ctx: ptr): i32
extern "crypto" fn EVP_PKEY_derive_set_peer(ctx: ptr, peer: ptr): i32
extern "crypto" fn EVP_PKEY_derive(ctx: ptr, key: mut &[byte], keylen: mut &int): i32
extern "crypto" fn EVP_DigestSignInit(ctx: ptr, pctx: ptr, md: ptr, e: ptr, pkey: ptr): i32
extern "crypto" fn EVP_DigestSign(ctx: ptr, sig: mut &[byte], siglen: mut &int, tbs: &[byte], tbslen: int): i32
extern "crypto" fn EVP_DigestVerifyInit(ctx: ptr, pctx: ptr, md: ptr, e: ptr, pkey: ptr): i32
extern "crypto" fn EVP_DigestVerify(ctx: ptr, sig: &[byte], siglen: int, tbs: &[byte], tbslen: int): i32
extern "crypto" fn i2d_PUBKEY(pkey: ptr, pp: mut &ptr): i32
extern "crypto" fn d2i_PUBKEY(a: ptr, pp: mut &ptr, length: int): ptr
extern "crypto" fn i2d_PrivateKey(pkey: ptr, pp: mut &ptr): i32
extern "crypto" fn d2i_PrivateKey(kind: i32, a: ptr, pp: mut &ptr, length: int): ptr
extern "crypto" fn CRYPTO_memcmp(a: &[byte], b: &[byte], n: int): i32
extern "crypto" fn RAND_bytes(buf: mut &[byte], n: i32): i32
extern "crypto" fn ERR_get_error(): u64
extern "crypto" fn ERR_clear_error()
extern "crypto" fn ERR_reason_error_string(e: u64): str

fn failed(what: &str): Error {
    let e = ERR_get_error()
    ERR_clear_error()
    if e == 0 { return Error{msg: what + " failed"} }
    let r = ERR_reason_error_string(e)
    return Error{msg: what + ": " + (if r == "" { "error " + e.toStr() } else { r })}
}

const MAX_INPUT = 1 << 30

fn digest(t: ptr, size: int, data: &str, what: &str): Result[str, Error] {
    if len(data) > MAX_INPUT { return Err(Error{msg: what + ": input too large"}) }
    let d = strToBytes(data)
    var md = array(64, byte(0))
    var n = array(1, i32(0))
    if EVP_Digest(&d, len(d), mut &md, mut &n, t, nullPtr()) != 1 { return Err(failed(what)) }
    if int(n[0]) != size { return Err(Error{msg: what + ": digest of " + n[0].toStr() + " bytes"}) }
    return Ok(strFromBytes(&md[0..size]))
}

// The SHA-1 digest of data, 20 bytes.
pub fn sha1(data: &str): Result[str, Error] { return digest(EVP_sha1(), 20, data, "SHA-1") }

// The SHA-512 digest of data, 64 bytes.
pub fn sha512(data: &str): Result[str, Error] { return digest(EVP_sha512(), 64, data, "SHA-512") }

// The MD5 digest of data, 16 bytes (Oracle's session key arithmetic uses it).
pub fn md5(data: &str): Result[str, Error] { return digest(EVP_md5(), 16, data, "MD5") }

// PBKDF2 with HMAC-SHA-512 (RFC 8018): keyLen bytes from password and salt.
pub fn pbkdf2Sha512(password: &str, salt: &str, iterations: int, keyLen: int): Result[str, Error] {
    if iterations < 1 || iterations > 100000000 { return Err(Error{msg: "PBKDF2: " + iterations.toStr() + " iterations"}) }
    if keyLen < 1 || keyLen > 1024 { return Err(Error{msg: "PBKDF2: a key of " + keyLen.toStr() + " bytes"}) }
    if len(password) > MAX_INPUT || len(salt) > MAX_INPUT { return Err(Error{msg: "PBKDF2: input too large"}) }
    let p = strToBytes(password)
    let s = strToBytes(salt)
    var out = array(keyLen, byte(0))
    if PKCS5_PBKDF2_HMAC(&p, i32(len(p)), &s, i32(len(s)), i32(iterations), EVP_sha512(), i32(keyLen), mut &out) != 1 {
        return Err(failed("PBKDF2"))
    }
    return Ok(strFromBytes(&out))
}

// The SHA-256 digest of data, 32 bytes.
pub fn sha256(data: &str): Result[str, Error] { return digest(EVP_sha256(), 32, data, "SHA-256") }

// HMAC-SHA-256 (RFC 2104, OpenSSL's HMAC()) of data under key, 32 bytes.
pub fn hmacSha256(key: &str, data: &str): Result[str, Error] {
    if len(key) > MAX_INPUT || len(data) > MAX_INPUT { return Err(Error{msg: "HMAC-SHA-256: input too large"}) }
    let k = strToBytes(key)
    let d = strToBytes(data)
    var md = array(64, byte(0))
    var n = array(1, i32(0))
    if isNull(HMAC(EVP_sha256(), &k, i32(len(k)), &d, len(d), mut &md, mut &n)) { return Err(failed("HMAC-SHA-256")) }
    if int(n[0]) != 32 { return Err(Error{msg: "HMAC-SHA-256: digest of " + n[0].toStr() + " bytes"}) }
    return Ok(strFromBytes(&md[0..32]))
}

// PBKDF2 with HMAC-SHA-256 (RFC 8018, RFC 7914 section 11): keyLen bytes from
// password and salt. A large iteration count takes long: the call runs on the
// helper pool (a blocking extern, SPEC 12), so other tasks go on meanwhile.
pub fn pbkdf2Sha256(password: &str, salt: &str, iterations: int, keyLen: int): Result[str, Error] {
    if iterations < 1 || iterations > 100000000 { return Err(Error{msg: "PBKDF2: " + iterations.toStr() + " iterations"}) }
    if keyLen < 1 || keyLen > 1024 { return Err(Error{msg: "PBKDF2: a key of " + keyLen.toStr() + " bytes"}) }
    if len(password) > MAX_INPUT || len(salt) > MAX_INPUT { return Err(Error{msg: "PBKDF2: input too large"}) }
    let p = strToBytes(password)
    let s = strToBytes(salt)
    var out = array(keyLen, byte(0))
    if pbkdf2Blocking(&p, i32(len(p)), &s, i32(len(s)), i32(iterations), EVP_sha256(), i32(keyLen), mut &out) != 1 {
        ERR_clear_error()          // the error queue belongs to the helper thread that ran the call
        return Err(Error{msg: "PBKDF2 failed"})
    }
    return Ok(strFromBytes(&out))
}

// Base64 (RFC 4648 section 4: the standard alphabet, padded with "=").
pub fn base64(data: &str): str { return b64.encode(data) }

// The bytes of standard base64 text; None unless it is whole groups of four
// characters, with "=" only as the last one or two (padding is required), no
// white space and no other character. The unused bits of the last character
// are not checked (as libpq's decoder).
pub fn unbase64(text: &str): Option[str] { return b64.decodeStrict(text) }

// An EVP cipher context, freed when dropped.
type Ctx = record { p: ptr }

pub fn (c: mut &Ctx) drop() { if !isNull(c.p) { EVP_CIPHER_CTX_free(c.p) } }

fn aesCbc(key: &str, iv: &str, data: &str, encrypt: bool, padding: bool): Result[str, Error] {
    let what = if encrypt { "AES-CBC encrypt" } else { "AES-CBC decrypt" }
    let cipher = match len(key) {
        16 { EVP_aes_128_cbc() }
        24 { EVP_aes_192_cbc() }
        32 { EVP_aes_256_cbc() }
        else { return Err(Error{msg: what + ": a key of " + len(key).toStr() + " bytes"}) }
    }
    if len(iv) != 16 { return Err(Error{msg: what + ": an IV of " + len(iv).toStr() + " bytes"}) }
    if len(data) > MAX_INPUT { return Err(Error{msg: what + ": input too large"}) }
    if !padding && len(data) % 16 != 0 { return Err(Error{msg: what + ": " + len(data).toStr() + " bytes, not whole blocks"}) }
    let c = Ctx{p: EVP_CIPHER_CTX_new()}
    if isNull(c.p) { return Err(failed(&what)) }
    let km = ffi.copyBytes(key)
    let vm = ffi.copyBytes(iv)
    if EVP_CipherInit_ex(c.p, cipher, nullPtr(), km.ptr(), vm.ptr(), if encrypt { i32(1) } else { i32(0) }) != 1 { return Err(failed(&what)) }
    if EVP_CIPHER_CTX_set_padding(c.p, if padding { i32(1) } else { i32(0) }) != 1 { return Err(failed(&what)) }
    let d = strToBytes(data)
    let out = ffi.alloc(len(d) + 32)
    var n = array(1, i32(0))
    if EVP_CipherUpdate(c.p, out.ptr(), mut &n, &d, i32(len(d))) != 1 { return Err(failed(&what)) }
    let first = int(n[0])
    if first < 0 || first > len(d) + 16 { return Err(Error{msg: what + ": bad output length"}) }
    let tail = ffi.alloc(32)
    var m = array(1, i32(0))
    if EVP_CipherFinal_ex(c.p, tail.ptr(), mut &m) != 1 { return Err(failed(&what)) }
    let second = int(m[0])
    if second < 0 || second > 32 { return Err(Error{msg: what + ": bad final length"}) }
    var res = ffi.bytes(out.ptr(), first)
    if second > 0 { res += ffi.bytes(tail.ptr(), second) }
    return Ok(res)
}

// AES-CBC encryption with a 16-, 24- or 32-byte key. padding: PKCS #7
// (always a pad, a whole block when data is whole blocks); otherwise data
// must be whole blocks.
pub fn aesCbcEncrypt(key: &str, iv: &str, data: &str, padding: bool): Result[str, Error] {
    return aesCbc(key, iv, data, true, padding)
}

// AES-CBC decryption; padding: check and remove a PKCS #7 pad.
pub fn aesCbcDecrypt(key: &str, iv: &str, data: &str, padding: bool): Result[str, Error] {
    return aesCbc(key, iv, data, false, padding)
}

// n bytes from OpenSSL's random generator.
pub fn randomBytes(n: int): Result[str, Error] {
    if n < 0 || n > 1 << 20 { return Err(Error{msg: "random: " + n.toStr() + " bytes"}) }
    var b = array(n, byte(0))
    if n > 0 && RAND_bytes(mut &b, i32(n)) != 1 { return Err(failed("random")) }
    return Ok(strFromBytes(&b))
}

// Lowercase hex of the bytes of s.
pub fn hex(s: &str): str {
    let digits = "0123456789abcdef"
    var b = ""
    for i in 0..len(s) {
        b.addByte(digits[int(s[i] >> 4)])
        b.addByte(digits[int(s[i] & 15)])
    }
    return b
}

// The bytes of hex text (either case); None if it is not hex of whole bytes.
pub fn unhex(h: &str): Option[str] {
    if len(h) % 2 != 0 { return None }
    var b: []byte = []
    var i = 0
    while i < len(h) {
        let hi = hexDigit(h[i])
        let lo = hexDigit(h[i + 1])
        if hi < 0 || lo < 0 { return None }
        append(mut &b, byte(hi * 16 + lo))
        i += 2
    }
    return Some(strFromBytes(&b))
}

fn hexDigit(c: byte): int {
    if c >= '0' && c <= '9' { return int(c - '0') }
    if c >= 'a' && c <= 'f' { return int(c - 'a') + 10 }
    if c >= 'A' && c <= 'F' { return int(c - 'A') + 10 }
    return -1
}

// ---------------------------------------------------------------- constant-time compare

// Constant-time equality over byte strings. Returns false if lengths differ.
pub fn constantTimeEq(a: &str, b: &str): bool {
    if len(a) != len(b) { return false }
    if len(a) == 0 { return true }
    let ab = strToBytes(a)
    let bb = strToBytes(b)
    return CRYPTO_memcmp(&ab, &bb, len(ab)) == 0
}

// ---------------------------------------------------------------- SHA-384, HMAC-384/512, streaming Hasher

pub fn sha384(data: &str): Result[str, Error] { return digest(EVP_sha384(), 48, data, "SHA-384") }

fn hmacWith(md: ptr, size: int, key: &str, data: &str, what: &str): Result[str, Error] {
    if len(key) > MAX_INPUT || len(data) > MAX_INPUT { return Err(Error{msg: what + ": input too large"}) }
    let k = strToBytes(key)
    let d = strToBytes(data)
    var out = array(64, byte(0))
    var n = array(1, i32(0))
    if isNull(HMAC(md, &k, i32(len(k)), &d, len(d), mut &out, mut &n)) { return Err(failed(what)) }
    if int(n[0]) != size { return Err(Error{msg: what + ": digest of " + n[0].toStr() + " bytes"}) }
    return Ok(strFromBytes(&out[0..size]))
}

pub fn hmacSha384(key: &str, data: &str): Result[str, Error] { return hmacWith(EVP_sha384(), 48, key, data, "HMAC-SHA-384") }
pub fn hmacSha512(key: &str, data: &str): Result[str, Error] { return hmacWith(EVP_sha512(), 64, key, data, "HMAC-SHA-512") }

pub type HashAlg = value closed { Sha256; Sha384; Sha512; Sha1; Md5 }

pub type Hasher = record {
    ctx: ptr
    size: int
}

pub fn (h: mut &Hasher) drop() {
    if !isNull(h.ctx) {
        EVP_MD_CTX_free(h.ctx)
        h.ctx = nullPtr()
    }
}

pub fn newHasher(alg: HashAlg): Result[Hasher, Error] {
    let md = match alg {
        HashAlg.Sha256 { EVP_sha256() }
        HashAlg.Sha384 { EVP_sha384() }
        HashAlg.Sha512 { EVP_sha512() }
        HashAlg.Sha1 { EVP_sha1() }
        HashAlg.Md5 { EVP_md5() }
    }
    let sz = match alg {
        HashAlg.Sha256 { 32 }
        HashAlg.Sha384 { 48 }
        HashAlg.Sha512 { 64 }
        HashAlg.Sha1 { 20 }
        HashAlg.Md5 { 16 }
    }
    let c = EVP_MD_CTX_new()
    if isNull(c) { return Err(failed("Hasher")) }
    var h = Hasher{ctx: c, size: sz}
    if EVP_DigestInit_ex(h.ctx, md, nullPtr()) != 1 { return Err(failed("Hasher")) }
    return Ok(h)
}

pub fn (h: mut &Hasher) updateBytes(data: &[byte]): Result[Unit, Error] {
    if isNull(h.ctx) { return Err(Error{msg: "Hasher: already finished"}) }
    if len(data) == 0 { return Ok(Unit{}) }
    if EVP_DigestUpdate(h.ctx, data, len(data)) != 1 { return Err(failed("Hasher update")) }
    return Ok(Unit{})
}

pub fn (h: mut &Hasher) update(data: &str): Result[Unit, Error] {
    return h.updateBytes(data.bytes())
}

pub fn (var h: Hasher) finish(): Result[str, Error] {
    if isNull(h.ctx) { return Err(Error{msg: "Hasher: already finished"}) }
    var md = array(64, byte(0))
    var n = array(1, i32(0))
    if EVP_DigestFinal_ex(h.ctx, mut &md, mut &n) != 1 { return Err(failed("Hasher finish")) }
    if int(n[0]) != h.size { return Err(Error{msg: "Hasher: unexpected digest size"}) }
    return Ok(strFromBytes(&md[0..h.size]))
}

// ---------------------------------------------------------------- HKDF-SHA-256 (RFC 5869)

// HKDF-Extract with SHA-256. An empty salt uses 32 zero bytes per RFC 5869 §2.2.
pub fn hkdfExtractSha256(salt: &str, ikm: &str): Result[str, Error] {
    if len(salt) == 0 {
        let zeros = strFromBytes(&(array(32, byte(0))))
        return hmacSha256(&zeros, ikm)
    }
    return hmacSha256(salt, ikm)
}

// HKDF-Expand with SHA-256. length must be in 0..8160 (255 * 32).
pub fn hkdfExpandSha256(prk: &str, info: &str, length: int): Result[str, Error] {
    if length < 0 || length > 255 * 32 {
        return Err(Error{msg: "HKDF-Expand: invalid output length " + length.toStr()})
    }
    if len(prk) < 32 {
        return Err(Error{msg: "HKDF-Expand: PRK must be at least 32 bytes"})
    }
    if length == 0 { return Ok("") }
    let blocks = (length + 31) / 32
    var okm = ""
    var prev = ""
    for i in 1..blocks + 1 {
        var inp = prev.clone()
        inp += info
        inp.addByte(byte(i))
        prev = try hmacSha256(prk, &inp)
        okm += &prev
    }
    return Ok(okm[0..length].clone())
}

// One-shot HKDF-SHA-256 (Extract then Expand).
pub fn hkdfSha256(salt: &str, ikm: &str, info: &str, length: int): Result[str, Error] {
    let prk = try hkdfExtractSha256(salt, ikm)
    return hkdfExpandSha256(&prk, info, length)
}

// ---------------------------------------------------------------- AEAD (AES-GCM, ChaCha20-Poly1305)

const EVP_CTRL_AEAD_SET_IVLEN: i32 = 9
const EVP_CTRL_AEAD_GET_TAG: i32 = 16
const EVP_CTRL_AEAD_SET_TAG: i32 = 17
const AEAD_TAG_LEN = 16
const AEAD_NONCE_LEN = 12

fn aeadEncrypt(cipher: ptr, key: &str, nonce: &str, aad: &str, plaintext: &str, what: &str): Result[str, Error] {
    if len(nonce) != AEAD_NONCE_LEN {
        return Err(Error{msg: what + ": nonce must be 12 bytes, got " + len(nonce).toStr()})
    }
    if len(aad) > MAX_INPUT || len(plaintext) > MAX_INPUT {
        return Err(Error{msg: what + ": input too large"})
    }
    let c = Ctx{p: EVP_CIPHER_CTX_new()}
    if isNull(c.p) { return Err(failed(what)) }
    if EVP_CipherInit_ex(c.p, cipher, nullPtr(), nullPtr(), nullPtr(), i32(1)) != 1 { return Err(failed(what)) }
    if EVP_CIPHER_CTX_ctrl(c.p, EVP_CTRL_AEAD_SET_IVLEN, i32(len(nonce)), nullPtr()) != 1 { return Err(failed(what)) }
    let km = ffi.copyBytes(key)
    let nm = ffi.copyBytes(nonce)
    if EVP_CipherInit_ex(c.p, nullPtr(), nullPtr(), km.ptr(), nm.ptr(), i32(1)) != 1 { return Err(failed(what)) }
    var outl = array(1, i32(0))
    if len(aad) > 0 {
        let ab = strToBytes(aad)
        if EVP_CipherUpdate(c.p, nullPtr(), mut &outl, &ab, i32(len(ab))) != 1 { return Err(failed(what)) }
    }
    let outLen = if len(plaintext) > 0 { len(plaintext) } else { 1 }
    let outMem = ffi.alloc(outLen + 16)
    var written = 0
    if len(plaintext) > 0 {
        let pb = strToBytes(plaintext)
        if EVP_CipherUpdate(c.p, outMem.ptr(), mut &outl, &pb, i32(len(pb))) != 1 { return Err(failed(what)) }
        written = int(outl[0])
    }
    let finMem = ffi.alloc(16)
    var finl = array(1, i32(0))
    if EVP_CipherFinal_ex(c.p, finMem.ptr(), mut &finl) != 1 { return Err(failed(what)) }
    let tagMem = ffi.alloc(AEAD_TAG_LEN)
    if EVP_CIPHER_CTX_ctrl(c.p, EVP_CTRL_AEAD_GET_TAG, i32(AEAD_TAG_LEN), tagMem.ptr()) != 1 { return Err(failed(what)) }
    var res = if written > 0 { ffi.bytes(outMem.ptr(), written) } else { "" }
    if int(finl[0]) > 0 { res += ffi.bytes(finMem.ptr(), int(finl[0])) }
    res += ffi.bytes(tagMem.ptr(), AEAD_TAG_LEN)
    return Ok(res)
}

fn aeadDecrypt(cipher: ptr, key: &str, nonce: &str, aad: &str, sealed: &str, what: &str): Result[str, Error] {
    if len(nonce) != AEAD_NONCE_LEN {
        return Err(Error{msg: what + ": nonce must be 12 bytes, got " + len(nonce).toStr()})
    }
    if len(sealed) < AEAD_TAG_LEN {
        return Err(Error{msg: what + ": ciphertext shorter than 16-byte authentication tag"})
    }
    if len(aad) > MAX_INPUT || len(sealed) > MAX_INPUT {
        return Err(Error{msg: what + ": input too large"})
    }
    let ctLen = len(sealed) - AEAD_TAG_LEN
    let c = Ctx{p: EVP_CIPHER_CTX_new()}
    if isNull(c.p) { return Err(failed(what)) }
    if EVP_CipherInit_ex(c.p, cipher, nullPtr(), nullPtr(), nullPtr(), i32(0)) != 1 { return Err(failed(what)) }
    if EVP_CIPHER_CTX_ctrl(c.p, EVP_CTRL_AEAD_SET_IVLEN, i32(len(nonce)), nullPtr()) != 1 { return Err(failed(what)) }
    let km = ffi.copyBytes(key)
    let nm = ffi.copyBytes(nonce)
    if EVP_CipherInit_ex(c.p, nullPtr(), nullPtr(), km.ptr(), nm.ptr(), i32(0)) != 1 { return Err(failed(what)) }
    var outl = array(1, i32(0))
    if len(aad) > 0 {
        let ab = strToBytes(aad)
        if EVP_CipherUpdate(c.p, nullPtr(), mut &outl, &ab, i32(len(ab))) != 1 { return Err(failed(what)) }
    }
    let outMem = ffi.alloc(if ctLen > 0 { ctLen + 16 } else { 16 })
    var written = 0
    if ctLen > 0 {
        let cb = strToBytes(sealed[0..ctLen])
        if EVP_CipherUpdate(c.p, outMem.ptr(), mut &outl, &cb, i32(ctLen)) != 1 { return Err(failed(what)) }
        written = int(outl[0])
    }
    let tagMem = ffi.copyBytes(sealed[ctLen..])
    if EVP_CIPHER_CTX_ctrl(c.p, EVP_CTRL_AEAD_SET_TAG, i32(AEAD_TAG_LEN), tagMem.ptr()) != 1 { return Err(failed(what)) }
    let finMem = ffi.alloc(16)
    var finl = array(1, i32(0))
    if EVP_CipherFinal_ex(c.p, finMem.ptr(), mut &finl) != 1 {
        ERR_clear_error()
        return Err(Error{msg: what + ": authentication failed"})
    }
    var res = if written > 0 { ffi.bytes(outMem.ptr(), written) } else { "" }
    if int(finl[0]) > 0 { res += ffi.bytes(finMem.ptr(), int(finl[0])) }
    return Ok(res)
}

// AES-128-GCM (16-byte key) or AES-256-GCM (32-byte key) with 12-byte nonce.
// Returns ciphertext || 16-byte authentication tag.
pub fn aesGcmEncrypt(key: &str, nonce: &str, aad: &str, plaintext: &str): Result[str, Error] {
    let cipher = match len(key) {
        16 { EVP_aes_128_gcm() }
        32 { EVP_aes_256_gcm() }
        else { return Err(Error{msg: "AES-GCM encrypt: key must be 16 or 32 bytes, got " + len(key).toStr()}) }
    }
    return aeadEncrypt(cipher, key, nonce, aad, plaintext, "AES-GCM encrypt")
}

// Verifies the trailing 16-byte GCM tag and returns the plaintext.
pub fn aesGcmDecrypt(key: &str, nonce: &str, aad: &str, ciphertextAndTag: &str): Result[str, Error] {
    let cipher = match len(key) {
        16 { EVP_aes_128_gcm() }
        32 { EVP_aes_256_gcm() }
        else { return Err(Error{msg: "AES-GCM decrypt: key must be 16 or 32 bytes, got " + len(key).toStr()}) }
    }
    return aeadDecrypt(cipher, key, nonce, aad, ciphertextAndTag, "AES-GCM decrypt")
}

// ChaCha20-Poly1305 (RFC 8439) with 32-byte key and 12-byte nonce.
// Returns ciphertext || 16-byte Poly1305 tag.
pub fn chacha20Poly1305Encrypt(key: &str, nonce: &str, aad: &str, plaintext: &str): Result[str, Error] {
    if len(key) != 32 {
        return Err(Error{msg: "ChaCha20-Poly1305 encrypt: key must be 32 bytes, got " + len(key).toStr()})
    }
    return aeadEncrypt(EVP_chacha20_poly1305(), key, nonce, aad, plaintext, "ChaCha20-Poly1305 encrypt")
}

// Verifies the trailing 16-byte Poly1305 tag and returns the plaintext.
pub fn chacha20Poly1305Decrypt(key: &str, nonce: &str, aad: &str, ciphertextAndTag: &str): Result[str, Error] {
    if len(key) != 32 {
        return Err(Error{msg: "ChaCha20-Poly1305 decrypt: key must be 32 bytes, got " + len(key).toStr()})
    }
    return aeadDecrypt(EVP_chacha20_poly1305(), key, nonce, aad, ciphertextAndTag, "ChaCha20-Poly1305 decrypt")
}

// ---------------------------------------------------------------- Ed25519, X25519, ECDSA P-256

const NID_ED25519: i32 = 1087
const NID_X25519: i32 = 1034
const NID_EC: i32 = 408

pub type KeyPair = value record {
    pub priv: str
    pub pubKey: str
}

type PKey = record { p: ptr }
fn (k: mut &PKey) drop() { if !isNull(k.p) { EVP_PKEY_free(k.p) } }

type PKeyCtx = record { p: ptr }
fn (k: mut &PKeyCtx) drop() { if !isNull(k.p) { EVP_PKEY_CTX_free(k.p) } }

type MdCtx = record { p: ptr }
fn (m: mut &MdCtx) drop() { if !isNull(m.p) { EVP_MD_CTX_free(m.p) } }

fn rawPubFromPriv(nid: i32, privKey: &str, what: &str): Result[str, Error] {
    if len(privKey) != 32 {
        return Err(Error{msg: what + ": private key must be 32 bytes, got " + len(privKey).toStr()})
    }
    let pb = strToBytes(privKey)
    let pk = PKey{p: EVP_PKEY_new_raw_private_key(nid, nullPtr(), &pb, 32)}
    if isNull(pk.p) { return Err(failed(what)) }
    var out = array(32, byte(0))
    var outLen = 32
    if EVP_PKEY_get_raw_public_key(pk.p, mut &out, mut &outLen) != 1 || outLen != 32 {
        return Err(failed(what))
    }
    return Ok(strFromBytes(&out))
}

// Generates an Ed25519 key pair (32-byte raw seed priv, 32-byte raw pubKey).
pub fn ed25519Keygen(): Result[KeyPair, Error] {
    let priv = try randomBytes(32)
    let pubk = try ed25519PublicKey(&priv)
    return Ok(KeyPair{priv: priv, pubKey: pubk})
}

// Derives the 32-byte Ed25519 public key from a 32-byte raw private seed.
pub fn ed25519PublicKey(privKey: &str): Result[str, Error] {
    return rawPubFromPriv(NID_ED25519, privKey, "Ed25519 public key")
}

// Signs message with a 32-byte Ed25519 private key; returns a 64-byte signature.
pub fn ed25519Sign(privKey: &str, message: &str): Result[str, Error] {
    if len(privKey) != 32 {
        return Err(Error{msg: "Ed25519 sign: private key must be 32 bytes, got " + len(privKey).toStr()})
    }
    if len(message) > MAX_INPUT { return Err(Error{msg: "Ed25519 sign: message too large"}) }
    let pb = strToBytes(privKey)
    let pk = PKey{p: EVP_PKEY_new_raw_private_key(NID_ED25519, nullPtr(), &pb, 32)}
    if isNull(pk.p) { return Err(failed("Ed25519 sign")) }
    let mc = MdCtx{p: EVP_MD_CTX_new()}
    if isNull(mc.p) { return Err(failed("Ed25519 sign")) }
    if EVP_DigestSignInit(mc.p, nullPtr(), nullPtr(), nullPtr(), pk.p) != 1 { return Err(failed("Ed25519 sign")) }
    let mb = strToBytes(message)
    var sig = array(64, byte(0))
    var sigLen = 64
    if EVP_DigestSign(mc.p, mut &sig, mut &sigLen, &mb, len(mb)) != 1 || sigLen != 64 {
        return Err(failed("Ed25519 sign"))
    }
    return Ok(strFromBytes(&sig))
}

// Verifies a 64-byte Ed25519 signature under a 32-byte raw public key.
pub fn ed25519Verify(pubKey: &str, message: &str, signature: &str): Result[bool, Error] {
    if len(pubKey) != 32 {
        return Err(Error{msg: "Ed25519 verify: public key must be 32 bytes, got " + len(pubKey).toStr()})
    }
    if len(signature) != 64 { return Ok(false) }
    if len(message) > MAX_INPUT { return Err(Error{msg: "Ed25519 verify: message too large"}) }
    let kb = strToBytes(pubKey)
    let pk = PKey{p: EVP_PKEY_new_raw_public_key(NID_ED25519, nullPtr(), &kb, 32)}
    if isNull(pk.p) { return Err(failed("Ed25519 verify")) }
    let mc = MdCtx{p: EVP_MD_CTX_new()}
    if isNull(mc.p) { return Err(failed("Ed25519 verify")) }
    if EVP_DigestVerifyInit(mc.p, nullPtr(), nullPtr(), nullPtr(), pk.p) != 1 { return Err(failed("Ed25519 verify")) }
    let sb = strToBytes(signature)
    let mb = strToBytes(message)
    let r = EVP_DigestVerify(mc.p, &sb, 64, &mb, len(mb))
    if r == 1 { return Ok(true) }
    ERR_clear_error()
    return Ok(false)
}

// Generates an X25519 key pair (32-byte raw private and public keys).
pub fn x25519Keygen(): Result[KeyPair, Error] {
    let priv = try randomBytes(32)
    let pubk = try x25519PublicKey(&priv)
    return Ok(KeyPair{priv: priv, pubKey: pubk})
}

// Derives the 32-byte X25519 public key from a 32-byte private key.
pub fn x25519PublicKey(privKey: &str): Result[str, Error] {
    return rawPubFromPriv(NID_X25519, privKey, "X25519 public key")
}

// Computes the 32-byte X25519 ECDH shared secret.
pub fn x25519SharedSecret(privKey: &str, peerPubKey: &str): Result[str, Error] {
    if len(privKey) != 32 {
        return Err(Error{msg: "X25519: private key must be 32 bytes, got " + len(privKey).toStr()})
    }
    if len(peerPubKey) != 32 {
        return Err(Error{msg: "X25519: peer public key must be 32 bytes, got " + len(peerPubKey).toStr()})
    }
    let kb = strToBytes(privKey)
    let pk = PKey{p: EVP_PKEY_new_raw_private_key(NID_X25519, nullPtr(), &kb, 32)}
    if isNull(pk.p) { return Err(failed("X25519")) }
    let pb = strToBytes(peerPubKey)
    let peer = PKey{p: EVP_PKEY_new_raw_public_key(NID_X25519, nullPtr(), &pb, 32)}
    if isNull(peer.p) { return Err(failed("X25519")) }
    let ctx = PKeyCtx{p: EVP_PKEY_CTX_new(pk.p, nullPtr())}
    if isNull(ctx.p) { return Err(failed("X25519")) }
    if EVP_PKEY_derive_init(ctx.p) != 1 { return Err(failed("X25519")) }
    if EVP_PKEY_derive_set_peer(ctx.p, peer.p) != 1 { return Err(failed("X25519")) }
    var out = array(32, byte(0))
    var outLen = 32
    if EVP_PKEY_derive(ctx.p, mut &out, mut &outLen) != 1 || outLen != 32 { return Err(failed("X25519")) }
    return Ok(strFromBytes(&out))
}

// Generates an ECDSA P-256 key pair (DER private key, SPKI DER public key).
pub fn ecdsaP256Keygen(): Result[KeyPair, Error] {
    let pk = PKey{p: EVP_PKEY_Q_keygen(nullPtr(), nullPtr(), "EC", "P-256")}
    if isNull(pk.p) { return Err(failed("ECDSA P-256 keygen")) }
    var nilP = nullPtr()
    let privLen = int(i2d_PrivateKey(pk.p, mut &nilP))
    if privLen <= 0 { return Err(failed("ECDSA P-256 keygen")) }
    let privMem = ffi.alloc(privLen)
    var pp = privMem.ptr()
    if int(i2d_PrivateKey(pk.p, mut &pp)) != privLen { return Err(failed("ECDSA P-256 keygen")) }
    var nilP2 = nullPtr()
    let pubLen = int(i2d_PUBKEY(pk.p, mut &nilP2))
    if pubLen <= 0 { return Err(failed("ECDSA P-256 keygen")) }
    let pubMem = ffi.alloc(pubLen)
    var qp = pubMem.ptr()
    if int(i2d_PUBKEY(pk.p, mut &qp)) != pubLen { return Err(failed("ECDSA P-256 keygen")) }
    return Ok(KeyPair{priv: ffi.bytes(privMem.ptr(), privLen), pubKey: ffi.bytes(pubMem.ptr(), pubLen)})
}

// Signs message with a DER-encoded ECDSA P-256 private key using SHA-256.
pub fn ecdsaP256Sign(privDer: &str, message: &str): Result[str, Error] {
    if len(privDer) == 0 || len(message) > MAX_INPUT {
        return Err(Error{msg: "ECDSA P-256 sign: invalid input"})
    }
    let pm = ffi.copyBytes(privDer)
    var pp = pm.ptr()
    let pk = PKey{p: d2i_PrivateKey(NID_EC, nullPtr(), mut &pp, len(privDer))}
    if isNull(pk.p) { return Err(failed("ECDSA P-256 sign")) }
    let mc = MdCtx{p: EVP_MD_CTX_new()}
    if isNull(mc.p) { return Err(failed("ECDSA P-256 sign")) }
    if EVP_DigestSignInit(mc.p, nullPtr(), EVP_sha256(), nullPtr(), pk.p) != 1 { return Err(failed("ECDSA P-256 sign")) }
    let mb = strToBytes(message)
    var sig = array(128, byte(0))
    var sigLen = 128
    if EVP_DigestSign(mc.p, mut &sig, mut &sigLen, &mb, len(mb)) != 1 || sigLen <= 0 || sigLen > 128 {
        return Err(failed("ECDSA P-256 sign"))
    }
    return Ok(strFromBytes(&sig[0..sigLen]))
}

// Verifies a DER-encoded ECDSA P-256 SHA-256 signature under an SPKI DER public key.
pub fn ecdsaP256Verify(pubDer: &str, message: &str, signature: &str): Result[bool, Error] {
    if len(pubDer) == 0 || len(message) > MAX_INPUT {
        return Err(Error{msg: "ECDSA P-256 verify: invalid input"})
    }
    if len(signature) == 0 || len(signature) > 128 { return Ok(false) }
    let pm = ffi.copyBytes(pubDer)
    var pp = pm.ptr()
    let pk = PKey{p: d2i_PUBKEY(nullPtr(), mut &pp, len(pubDer))}
    if isNull(pk.p) { return Err(failed("ECDSA P-256 verify")) }
    let mc = MdCtx{p: EVP_MD_CTX_new()}
    if isNull(mc.p) { return Err(failed("ECDSA P-256 verify")) }
    if EVP_DigestVerifyInit(mc.p, nullPtr(), EVP_sha256(), nullPtr(), pk.p) != 1 { return Err(failed("ECDSA P-256 verify")) }
    let sb = strToBytes(signature)
    let mb = strToBytes(message)
    let r = EVP_DigestVerify(mc.p, &sb, len(sb), &mb, len(mb))
    if r == 1 { return Ok(true) }
    ERR_clear_error()
    return Ok(false)
}
