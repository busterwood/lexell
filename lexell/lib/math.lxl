// math: float constants, parsing, and formatting with a fixed number of
// decimals. The libm functions are float methods in std: x.sqrt(),
// x.pow(y), x.floor(), x.ln(), x.sin(), y.atan2(x), x.isNaN(), ...
//
// Floats print with x.toStr(), the shortest text that reads back as x.

import "strings"

pub const PI: float = 3.141592653589793f
pub const TAU: float = 6.283185307179586f
pub const E: float = 2.718281828459045f
pub const SQRT2: float = 1.4142135623730951f
pub const LN2: float = 0.6931471805599453f
pub const LN10: float = 2.302585092994046f

pub fn inf(): float {
    let one: float = 1.0f
    let zero: float = 0.0f
    return one / zero
}

pub fn nan(): float {
    let zero: float = 0.0f
    return zero / zero
}

// The float s denotes: decimal ("2.5", "-1e-7", ".5"), hexadecimal ("0x1p3"),
// "inf" or "nan" in any case; no spaces. None for anything else.
pub fn parse(s: &str): Option[float] {
    var f: float = 0.0f
    if len(s) > 0 && !strings.isSpace(strByte(s, 0)) && parseFloat(s, mut &f) { return Some(f) }
    return None
}

// x with exactly places decimals ("3.14" for PI, 2), rounding the shortest
// decimal form of x half to even: fixed(2.675, 2) is "2.68" (C's printf
// gives 2.67, from the binary value 2.67499999...). NaN and infinities print
// as by toStr; a negative result that rounds to zero has no sign.
pub fn fixed(x: float, places: int): str {
    if !x.isFinite() { return x.toStr() }
    var p = places
    if p < 0 { p = 0 }
    let s = x.abs().toStr()
    // s is digits with an optional point, then an optional exponent
    var digits = newStrBuf()
    var pow = 0
    var afterPoint = false
    var i = 0
    while i < len(s) {
        let c = strByte(s, i)
        if c == 'e' {
            pow += strings.parseIntOpt(&(strSlice(s, i + 1, len(s)))).unwrap()
            break
        }
        if c == '.' {
            afterPoint = true
        } else {
            digits.addByte(c)
            if afterPoint { pow -= 1 }
        }
        i += 1
    }
    // x = digits * 10^pow; the result is round(digits * 10^(pow + p)) / 10^p
    var r = digits.toStr()
    let shift = pow + p
    if shift >= 0 {
        r += strings.repeat("0", shift)
    } else {
        r = roundOff(&r, -shift)
    }
    while len(r) <= p { r = "0" + r }
    var out = strSlice(r, 0, len(r) - p)
    if p > 0 { out += "." + strSlice(r, len(r) - p, len(r)) }
    if x < 0.0f && !allZero(&r) { out = "-" + out }
    return out
}

// The decimal integer d with its last n digits removed, rounded half to even.
fn roundOff(d: &str, n: int): str {
    if n > len(d) { return "0" }
    let keep = len(d) - n
    var bytes = strToBytes(strSlice(d, 0, keep))
    let first = strByte(d, keep)
    var rest = false
    for j in keep + 1..len(d) {
        if strByte(d, j) != '0' { rest = true }
    }
    var lastOdd = false
    if keep > 0 { lastOdd = int(strByte(d, keep - 1) - '0') % 2 == 1 }
    if first > '5' || (first == '5' && (rest || lastOdd)) {
        var k = keep - 1
        var carry = true
        while carry && k >= 0 {
            if bytes[k] == '9' {
                bytes[k] = '0'
                k -= 1
            } else {
                bytes[k] += 1
                carry = false
            }
        }
        if carry { return "1" + strFromBytes(&bytes) }
    }
    if keep == 0 { return "0" }
    return strFromBytes(&bytes)
}

fn allZero(s: &str): bool {
    for i in 0..len(s) {
        if strByte(s, i) != '0' { return false }
    }
    return true
}

// x as an exact Decimal when x is finite and has at most 38 significant
// digits in its shortest form (it always does: at most 17).
pub fn toDecimal(x: float): Option[Decimal] {
    if !x.isFinite() { return None }
    match Decimal.parse(&(x.toStr())) {
        Ok(d) { return Some(d) }
        Err(_) { return None }
    }
}

// Whether a and b differ by at most tol times the larger magnitude (or by
// at most tol when both are near zero).
pub fn near(a: float, b: float, tol: float): bool {
    let d = (a - b).abs()
    if d <= tol { return true }
    return d <= tol * max(a.abs(), b.abs())
}

// ---------------------------------------------------------------- bit patterns

fn negNaN(x: float): bool {
    let one: float = 1.0f
    return one.copySign(x) < 0.0f
}

// A double's bits as they are in memory, and back: the runtimes' helpers.
extern "c" fn rtFloatBits(x: float): int as "lxllib_float_bits"
extern "c" fn rtFloatFromBits(b: int): float as "lxllib_float_from_bits"

// The exact IEEE 754 double bit pattern of x, as a 64-bit signed int (the
// sign bit is the int's high bit, so a negative number gives a negative int).
// A NaN is the canonical quiet NaN 0x7ff8000000000000 with x's sign.
pub fn bitsOf(x: float): int {
    if x != x {
        return 0x7ff8000000000000 | (if negNaN(x) { 1 << 63 } else { 0 })
    }
    return rtFloatBits(x)
}

// The float with IEEE 754 double bit pattern b; the inverse of bitsOf,
// including -0, the infinities, NaN and subnormals. Every NaN pattern gives
// the canonical quiet NaN with b's sign.
pub fn fromBits(b: int): float {
    if (b >> 52) & 0x7ff == 0x7ff && b & 0xfffffffffffff != 0 {
        let n = nan()
        return n.copySign(if b < 0 { -1.0f } else { 1.0f })
    }
    return rtFloatFromBits(b)
}

// The exact IEEE 754 single bit pattern of x, as a signed 32-bit int, rounded
// to nearest even as a float32 conversion is. A NaN is the canonical quiet
// NaN 0x7fc00000 with x's sign. bitsOf32Int gives the same pattern as an int,
// ready for appendU32LE/BE.
pub fn bitsOf32(x: float): i32 {
    let b64 = bitsOf(x)
    let neg = b64 < 0
    let e2 = (b64 >> 52) & 0x7ff
    let frac = b64 & 0xfffffffffffff
    if e2 == 0 && frac == 0 { return signed32(neg, 0) }
    if e2 == 0x7ff {
        if frac == 0 { return signed32(neg, 0x7f800000) }
        return signed32(neg, 0x7fc00000)
    }
    var sig = frac
    var p = 52
    var exp = e2 - 1023
    if e2 == 0 {
        // a double subnormal: value = frac * 2^-1074, p its top set bit
        var t = frac
        var k = 0
        while t > 1 {
            t = t >> 1
            k += 1
        }
        p = k
        exp = k - 1074
    } else {
        sig = frac | (1 << 52)
    }
    if exp < -126 {
        // float subnormal: value = sig * 2^(exp - p), and 2^-149 is the unit
        let shift = p - exp - 149
        var m = sig
        if shift > 0 { m = roundShift(sig, shift) } else { m = sig << -shift }
        if m >= (1 << 23) { m = 1 << 23 }
        return signed32(neg, m)
    }
    var m = sig
    if p > 23 {
        m = roundShift(sig, p - 23)
    } else if p < 23 {
        m = sig << (23 - p)
    }
    if m >= (1 << 24) {
        m = m >> 1
        exp += 1
    }
    if exp > 127 { return signed32(neg, 0x7f800000) }
    let field = ((exp + 127) << 23) | (m - (1 << 23))
    return signed32(neg, field)
}

// The single bit pattern of x as an int (the sign-extended i32 from bitsOf32),
// so appendU32LE/BE can write it directly.
pub fn bitsOf32Int(x: float): int {
    return int(bitsOf32(x))
}

// n >> shift, rounded to nearest with ties to even. n is below 2^63 here, so
// a shift of 63 or more leaves only a fraction below half and gives 0.
fn roundShift(n: int, shift: int): int {
    if shift >= 63 { return 0 }
    let q = n >> shift
    let rem = n & ((1 << shift) - 1)
    let half = 1 << (shift - 1)
    if rem > half || (rem == half && (q & 1) == 1) { return q + 1 }
    return q
}

fn signed32(neg: bool, field: int): i32 {
    let sign: i32 = if neg { -2147483647 - 1 } else { 0 }
    return sign | i32(field)
}

// The float with IEEE 754 single bit pattern b; the inverse of bitsOf32,
// including -0, the infinities, NaN and subnormals.
pub fn fromBits32(b: i32): float {
    return fromBits32Int(int(b))
}

// The float with the low 32 bits of b as IEEE 754 single bits. b may be any
// int, including the 0..0xffffffff of readU32LE or a signed readI32 pattern,
// so a codec needs no trapping i32 conversion.
pub fn fromBits32Int(b: int): float {
    let v = b
    let e = (v >> 23) & 0xff
    let m = v & 0x7fffff
    var f: float = 0.0f
    if e == 0xff {
        if m != 0 {
            let n = nan()
            return n.copySign(if v < 0 { -1.0f } else { 1.0f })
        }
        f = inf()
    } else if e == 0 {
        f = float(m) * rtFloatFromBits((1023 - 149) << 52)     // m * 2^-149: exact in a double
    } else {
        f = rtFloatFromBits(((e - 127 + 1023) << 52) | (m << 29))   // the same value, widened
    }
    return if ((v >> 31) & 1) == 1 { -f } else { f }
}
