// binary: little- and big-endian integer reads and writes over byte buffers.
//
// The reads take a byte slice (`&[byte]`) or a string of bytes (`&str`): the
// DB codecs hold wire messages in both forms, and a `&str` read must not copy
// the bytes. Indexing is bounds-checked by the language, so a read at an
// offset whose bytes are not all present traps. Callers validate a wire
// length before reading; these functions never read past the end silently.
//
// The writes append to or overwrite a `[]byte`, or append to a `StrBuf`
// through its public addByte. Values are truncated to the low 16, 32 or 64
// bits, so a signed value can be written without a cast: appendU32LE(mut &b,
// -1) writes ff ff ff ff.
//
// readU16/readU32 and their signed forms return `int` because every caller
// compares offsets, lengths and decoded numbers as int. readU64 returns `u64`
// for genuine unsigned 64-bit fields; readI64 returns the same 64 bits as an
// `int` (its raw two's-complement pattern), which is what the DB codecs and
// the float bit patterns need, and which avoids a trapped u64(-1).

// ---------------------------------------------------------------- reads, LE

// The unsigned 16-bit little-endian integer at b[at..at + 2].
pub fn readU16LE(b: &[byte], at: int): int {
    return int(b[at]) | (int(b[at + 1]) << 8)
}

// The unsigned 32-bit little-endian integer at b[at..at + 4].
pub fn readU32LE(b: &[byte], at: int): int {
    return (int(b[at])) | (int(b[at + 1]) << 8) | (int(b[at + 2]) << 16) | (int(b[at + 3]) << 24)
}

// The unsigned 64-bit little-endian integer at b[at..at + 8].
pub fn readU64LE(b: &[byte], at: int): u64 {
    return (u64(int(b[at]))) | (u64(int(b[at + 1])) << 8) | (u64(int(b[at + 2])) << 16) | (u64(int(b[at + 3])) << 24) | (u64(int(b[at + 4])) << 32) | (u64(int(b[at + 5])) << 40) | (u64(int(b[at + 6])) << 48) | (u64(int(b[at + 7])) << 56)
}

// The signed 16-bit little-endian integer at b[at..at + 2], sign-extended.
pub fn readI16LE(b: &[byte], at: int): int {
    let v = readU16LE(b, at)
    return if v >= 0x8000 { v - 0x10000 } else { v }
}

// The signed 32-bit little-endian integer at b[at..at + 4], sign-extended.
pub fn readI32LE(b: &[byte], at: int): int {
    let v = readU32LE(b, at)
    return if v >= 0x80000000 { v - 0x100000000 } else { v }
}

// The 64 bits of b[at..at + 8] as a little-endian int (its raw pattern).
pub fn readI64LE(b: &[byte], at: int): int {
    return (int(b[at])) | (int(b[at + 1]) << 8) | (int(b[at + 2]) << 16) | (int(b[at + 3]) << 24) | (int(b[at + 4]) << 32) | (int(b[at + 5]) << 40) | (int(b[at + 6]) << 48) | (int(b[at + 7]) << 56)
}

// ---------------------------------------------------------------- reads, BE

// The unsigned 16-bit big-endian integer at b[at..at + 2].
pub fn readU16BE(b: &[byte], at: int): int {
    return (int(b[at]) << 8) | int(b[at + 1])
}

// The unsigned 32-bit big-endian integer at b[at..at + 4].
pub fn readU32BE(b: &[byte], at: int): int {
    return (int(b[at]) << 24) | (int(b[at + 1]) << 16) | (int(b[at + 2]) << 8) | int(b[at + 3])
}

// The unsigned 64-bit big-endian integer at b[at..at + 8].
pub fn readU64BE(b: &[byte], at: int): u64 {
    return (u64(int(b[at])) << 56) | (u64(int(b[at + 1])) << 48) | (u64(int(b[at + 2])) << 40) | (u64(int(b[at + 3])) << 32) | (u64(int(b[at + 4])) << 24) | (u64(int(b[at + 5])) << 16) | (u64(int(b[at + 6])) << 8) | u64(int(b[at + 7]))
}

// The signed 16-bit big-endian integer at b[at..at + 2], sign-extended.
pub fn readI16BE(b: &[byte], at: int): int {
    let v = readU16BE(b, at)
    return if v >= 0x8000 { v - 0x10000 } else { v }
}

// The signed 32-bit big-endian integer at b[at..at + 4], sign-extended.
pub fn readI32BE(b: &[byte], at: int): int {
    let v = readU32BE(b, at)
    return if v >= 0x80000000 { v - 0x100000000 } else { v }
}

// The 64 bits of b[at..at + 8] as a big-endian int (its raw pattern).
pub fn readI64BE(b: &[byte], at: int): int {
    return (int(b[at]) << 56) | (int(b[at + 1]) << 48) | (int(b[at + 2]) << 40) | (int(b[at + 3]) << 32) | (int(b[at + 4]) << 24) | (int(b[at + 5]) << 16) | (int(b[at + 6]) << 8) | int(b[at + 7])
}

// ------------------------------------------------------------ reads, strings

// The unsigned 16-bit little-endian integer at s[at..at + 2]; no copy.
pub fn readU16LEStr(s: &str, at: int): int {
    return int(s[at]) | (int(s[at + 1]) << 8)
}

// The unsigned 16-bit big-endian integer at s[at..at + 2]; no copy.
pub fn readU16BEStr(s: &str, at: int): int {
    return (int(s[at]) << 8) | int(s[at + 1])
}

// The unsigned 32-bit little-endian integer at s[at..at + 4]; no copy.
pub fn readU32LEStr(s: &str, at: int): int {
    return (int(s[at])) | (int(s[at + 1]) << 8) | (int(s[at + 2]) << 16) | (int(s[at + 3]) << 24)
}

// The unsigned 32-bit big-endian integer at s[at..at + 4]; no copy.
pub fn readU32BEStr(s: &str, at: int): int {
    return (int(s[at]) << 24) | (int(s[at + 1]) << 16) | (int(s[at + 2]) << 8) | int(s[at + 3])
}

// The unsigned 64-bit little-endian integer at s[at..at + 8]; no copy.
pub fn readU64LEStr(s: &str, at: int): u64 {
    return (u64(int(s[at]))) | (u64(int(s[at + 1])) << 8) | (u64(int(s[at + 2])) << 16) | (u64(int(s[at + 3])) << 24) | (u64(int(s[at + 4])) << 32) | (u64(int(s[at + 5])) << 40) | (u64(int(s[at + 6])) << 48) | (u64(int(s[at + 7])) << 56)
}

// The unsigned 64-bit big-endian integer at s[at..at + 8]; no copy.
pub fn readU64BEStr(s: &str, at: int): u64 {
    return (u64(int(s[at])) << 56) | (u64(int(s[at + 1])) << 48) | (u64(int(s[at + 2])) << 40) | (u64(int(s[at + 3])) << 32) | (u64(int(s[at + 4])) << 24) | (u64(int(s[at + 5])) << 16) | (u64(int(s[at + 6])) << 8) | u64(int(s[at + 7]))
}

// The signed 16-bit little-endian integer at s[at..at + 2]; no copy.
pub fn readI16LEStr(s: &str, at: int): int {
    let v = readU16LEStr(s, at)
    return if v >= 0x8000 { v - 0x10000 } else { v }
}

// The signed 16-bit big-endian integer at s[at..at + 2]; no copy.
pub fn readI16BEStr(s: &str, at: int): int {
    let v = readU16BEStr(s, at)
    return if v >= 0x8000 { v - 0x10000 } else { v }
}

// The signed 32-bit little-endian integer at s[at..at + 4]; no copy.
pub fn readI32LEStr(s: &str, at: int): int {
    let v = readU32LEStr(s, at)
    return if v >= 0x80000000 { v - 0x100000000 } else { v }
}

// The signed 32-bit big-endian integer at s[at..at + 4]; no copy.
pub fn readI32BEStr(s: &str, at: int): int {
    let v = readU32BEStr(s, at)
    return if v >= 0x80000000 { v - 0x100000000 } else { v }
}

// The 64 bits at s[at..at + 8] as a little-endian int (its raw pattern).
pub fn readI64LEStr(s: &str, at: int): int {
    return (int(s[at])) | (int(s[at + 1]) << 8) | (int(s[at + 2]) << 16) | (int(s[at + 3]) << 24) | (int(s[at + 4]) << 32) | (int(s[at + 5]) << 40) | (int(s[at + 6]) << 48) | (int(s[at + 7]) << 56)
}

// The 64 bits at s[at..at + 8] as a big-endian int (its raw pattern).
pub fn readI64BEStr(s: &str, at: int): int {
    return (int(s[at]) << 56) | (int(s[at + 1]) << 48) | (int(s[at + 2]) << 40) | (int(s[at + 3]) << 32) | (int(s[at + 4]) << 24) | (int(s[at + 5]) << 16) | (int(s[at + 6]) << 8) | int(s[at + 7])
}

// --------------------------------------------------------------- append, LE

// Append the low 16 bits of v to b, little-endian.
pub fn appendU16LE(b: mut &[]byte, v: int) {
    append(b, byte(v & 0xff))
    append(b, byte((v >> 8) & 0xff))
}

// Append the low 32 bits of v to b, little-endian.
pub fn appendU32LE(b: mut &[]byte, v: int) {
    append(b, byte((v >> 0) & 0xff))
    append(b, byte((v >> 8) & 0xff))
    append(b, byte((v >> 16) & 0xff))
    append(b, byte((v >> 24) & 0xff))
}

// Append the low 64 bits of v to b, little-endian.
pub fn appendU64LE(b: mut &[]byte, v: int) {
    append(b, byte((v >> 0) & 0xff))
    append(b, byte((v >> 8) & 0xff))
    append(b, byte((v >> 16) & 0xff))
    append(b, byte((v >> 24) & 0xff))
    append(b, byte((v >> 32) & 0xff))
    append(b, byte((v >> 40) & 0xff))
    append(b, byte((v >> 48) & 0xff))
    append(b, byte((v >> 56) & 0xff))
}

// --------------------------------------------------------------- append, BE

// Append the low 16 bits of v to b, big-endian.
pub fn appendU16BE(b: mut &[]byte, v: int) {
    append(b, byte((v >> 8) & 0xff))
    append(b, byte(v & 0xff))
}

// Append the low 32 bits of v to b, big-endian.
pub fn appendU32BE(b: mut &[]byte, v: int) {
    append(b, byte((v >> 24) & 0xff))
    append(b, byte((v >> 16) & 0xff))
    append(b, byte((v >> 8) & 0xff))
    append(b, byte((v >> 0) & 0xff))
}

// Append the low 64 bits of v to b, big-endian.
pub fn appendU64BE(b: mut &[]byte, v: int) {
    append(b, byte((v >> 56) & 0xff))
    append(b, byte((v >> 48) & 0xff))
    append(b, byte((v >> 40) & 0xff))
    append(b, byte((v >> 32) & 0xff))
    append(b, byte((v >> 24) & 0xff))
    append(b, byte((v >> 16) & 0xff))
    append(b, byte((v >> 8) & 0xff))
    append(b, byte((v >> 0) & 0xff))
}

// ---------------------------------------------------------------- set, LE

// Overwrite b[at..at + 2] with the low 16 bits of v, little-endian. Traps
// when the two bytes are not all inside b.
pub fn setU16LE(b: mut &[]byte, at: int, v: int) {
    b[at] = byte(v & 0xff)
    b[at + 1] = byte((v >> 8) & 0xff)
}

// Overwrite b[at..at + 4] with the low 32 bits of v, little-endian.
pub fn setU32LE(b: mut &[]byte, at: int, v: int) {
    b[at] = byte((v >> 0) & 0xff)
    b[at + 1] = byte((v >> 8) & 0xff)
    b[at + 2] = byte((v >> 16) & 0xff)
    b[at + 3] = byte((v >> 24) & 0xff)
}

// Overwrite b[at..at + 8] with the low 64 bits of v, little-endian.
pub fn setU64LE(b: mut &[]byte, at: int, v: int) {
    b[at] = byte((v >> 0) & 0xff)
    b[at + 1] = byte((v >> 8) & 0xff)
    b[at + 2] = byte((v >> 16) & 0xff)
    b[at + 3] = byte((v >> 24) & 0xff)
    b[at + 4] = byte((v >> 32) & 0xff)
    b[at + 5] = byte((v >> 40) & 0xff)
    b[at + 6] = byte((v >> 48) & 0xff)
    b[at + 7] = byte((v >> 56) & 0xff)
}

// ---------------------------------------------------------------- set, BE

// Overwrite b[at..at + 2] with the low 16 bits of v, big-endian. Traps
// when the two bytes are not all inside b.
pub fn setU16BE(b: mut &[]byte, at: int, v: int) {
    b[at] = byte((v >> 8) & 0xff)
    b[at + 1] = byte(v & 0xff)
}

// Overwrite b[at..at + 4] with the low 32 bits of v, big-endian.
pub fn setU32BE(b: mut &[]byte, at: int, v: int) {
    b[at] = byte((v >> 24) & 0xff)
    b[at + 1] = byte((v >> 16) & 0xff)
    b[at + 2] = byte((v >> 8) & 0xff)
    b[at + 3] = byte((v >> 0) & 0xff)
}

// Overwrite b[at..at + 8] with the low 64 bits of v, big-endian.
pub fn setU64BE(b: mut &[]byte, at: int, v: int) {
    b[at] = byte((v >> 56) & 0xff)
    b[at + 1] = byte((v >> 48) & 0xff)
    b[at + 2] = byte((v >> 40) & 0xff)
    b[at + 3] = byte((v >> 32) & 0xff)
    b[at + 4] = byte((v >> 24) & 0xff)
    b[at + 5] = byte((v >> 16) & 0xff)
    b[at + 6] = byte((v >> 8) & 0xff)
    b[at + 7] = byte((v >> 0) & 0xff)
}

// ------------------------------------------------------------- StrBuf, LE

// Append the low 16 bits of v to the builder, little-endian.
pub fn addU16LE(b: mut &StrBuf, v: int) {
    b.addByte(byte(v & 0xff))
    b.addByte(byte((v >> 8) & 0xff))
}

// Append the low 32 bits of v to the builder, little-endian.
pub fn addU32LE(b: mut &StrBuf, v: int) {
    b.addByte(byte((v >> 0) & 0xff))
    b.addByte(byte((v >> 8) & 0xff))
    b.addByte(byte((v >> 16) & 0xff))
    b.addByte(byte((v >> 24) & 0xff))
}

// Append the low 64 bits of v to the builder, little-endian.
pub fn addU64LE(b: mut &StrBuf, v: int) {
    b.addByte(byte((v >> 0) & 0xff))
    b.addByte(byte((v >> 8) & 0xff))
    b.addByte(byte((v >> 16) & 0xff))
    b.addByte(byte((v >> 24) & 0xff))
    b.addByte(byte((v >> 32) & 0xff))
    b.addByte(byte((v >> 40) & 0xff))
    b.addByte(byte((v >> 48) & 0xff))
    b.addByte(byte((v >> 56) & 0xff))
}

// ------------------------------------------------------------- StrBuf, BE

// Append the low 16 bits of v to the builder, big-endian.
pub fn addU16BE(b: mut &StrBuf, v: int) {
    b.addByte(byte((v >> 8) & 0xff))
    b.addByte(byte(v & 0xff))
}

// Append the low 32 bits of v to the builder, big-endian.
pub fn addU32BE(b: mut &StrBuf, v: int) {
    b.addByte(byte((v >> 24) & 0xff))
    b.addByte(byte((v >> 16) & 0xff))
    b.addByte(byte((v >> 8) & 0xff))
    b.addByte(byte((v >> 0) & 0xff))
}

// Append the low 64 bits of v to the builder, big-endian.
pub fn addU64BE(b: mut &StrBuf, v: int) {
    b.addByte(byte((v >> 56) & 0xff))
    b.addByte(byte((v >> 48) & 0xff))
    b.addByte(byte((v >> 40) & 0xff))
    b.addByte(byte((v >> 32) & 0xff))
    b.addByte(byte((v >> 24) & 0xff))
    b.addByte(byte((v >> 16) & 0xff))
    b.addByte(byte((v >> 8) & 0xff))
    b.addByte(byte((v >> 0) & 0xff))
}
