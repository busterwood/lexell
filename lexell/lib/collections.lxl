// collections: array algorithms (stable sorting, binary search, reversal,
// insertion and removal, searching), Set, UniqueList, Heap, Map and sort.
//
// Map is the insertion-ordered hash map; sort is an unstable, allocation-free
// heap sort; sortBy/sortStable are the stable merge sorts. std keeps the
// prelude names Map, newMap, newMapWith and sort as aliases/wrappers.
// Algorithms that do not grow or shrink the array take a slice (&[T] /
// mut &[T]), so they work on part of an array too: sortBy(mut &xs[2..8], cmp).
// &xs and mut &xs pass as the whole array.

import "hash"

// ------------------------------------------------------------ sorting

// Sorts xs stably by cmp (negative: a before b, zero: keep their order,
// positive: b before a). Merge sort over indices, then the elements are
// permuted in place with swaps, so T may be owned. O(n log n) time, O(n)
// extra ints.

pub fn sortBy[T](xs: mut &[T], cmp: &fn(&T, &T): int) {
    let n = len(xs)
    if n < 2 { return }
    var idx = identity(n)
    var tmp = array(n, 0)
    var width = 1
    while width < n {
        var lo = 0
        while lo < n - width {
            let mid = lo + width
            let hi = min(lo + 2 * width, n)
            // merge the runs idx[lo..mid] and idx[mid..hi] into tmp
            var i = lo
            var j = mid
            for k in lo..hi {
                if j >= hi || (i < mid && cmp(&xs[idx[j]], &xs[idx[i]]) >= 0) {
                    tmp[k] = idx[i]
                    i += 1
                } else {
                    tmp[k] = idx[j]
                    j += 1
                }
            }
            for c in lo..hi { idx[c] = tmp[c] }
            lo += 2 * width
        }
        width *= 2
    }
    permute(xs, mut &idx)
}

// Stable sort by the natural order (cmp).
pub fn sortStable[T: Ord](xs: mut &[T]) { sortBy(xs, fn(a, b) { return a.cmp(b) }) }

fn identity(n: int): []int {
    var idx: []int = []
    for i in 0..n { append(mut &idx, i) }
    return idx
}

// Rearranges xs so that the new xs[i] is the old xs[idx[i]]; idx is used up
// (left as the identity). Follows each cycle with swaps.
fn permute[T](xs: mut &[T], idx: mut &[int]) {
    for start in 0..len(idx) {
        var cur = start
        while idx[cur] != start {
            let next = idx[cur]
            swap(xs, cur, next)
            idx[cur] = cur
            cur = next
        }
        idx[cur] = cur
    }
}

// Whether xs is in ascending order.
pub fn isSorted[T: Ord](xs: &[T]): bool {
    for i in 1..len(xs) {
        if xs[i] < xs[i - 1] { return false }
    }
    return true
}

// ------------------------------------------------------------ searching

// In a sorted xs: Ok(i) where xs[i] == x (some such i), or Err(i), the index
// where x would be inserted to keep xs sorted.
pub fn binarySearch[T: Ord](xs: &[T], x: &T): Result[int, int] {
    let i = lowerBound(xs, x)
    if i < len(xs) && !(x < xs[i]) { return Ok(i) }
    return Err(i)
}

// The first index i of the sorted xs with xs[i] >= x (len(xs) if none).
pub fn lowerBound[T: Ord](xs: &[T], x: &T): int {
    var lo = 0
    var hi = len(xs)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if xs[mid] < x {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

// The first index i of the sorted xs with xs[i] > x (len(xs) if none).
pub fn upperBound[T: Ord](xs: &[T], x: &T): int {
    var lo = 0
    var hi = len(xs)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if x < xs[mid] {
            hi = mid
        } else {
            lo = mid + 1
        }
    }
    return lo
}

pub fn contains[T: Eq](xs: &[T], x: &T): bool { return find(xs, x) >= 0 }

// The first index of x in xs, or -1.
pub fn find[T: Eq](xs: &[T], x: &T): int {
    for i in 0..len(xs) {
        if xs[i] == x { return i }
    }
    return -1
}

// The first index whose element satisfies pred, or -1.
pub fn findBy[T](xs: &[T], pred: &fn(&T): bool): int {
    for i in 0..len(xs) {
        if pred(&xs[i]) { return i }
    }
    return -1
}

// How many elements satisfy pred.
pub fn count[T](xs: &[T], pred: &fn(&T): bool): int {
    var n = 0
    for x in xs {
        if pred(x) { n += 1 }
    }
    return n
}

// Whether some element satisfies pred (false for an empty xs).
pub fn any[T](xs: &[T], pred: &fn(&T): bool): bool { return findBy(xs, pred) >= 0 }

// Whether every element satisfies pred (true for an empty xs).
pub fn all[T](xs: &[T], pred: &fn(&T): bool): bool {
    return findBy(xs, fn(x) { return !pred(x) }) < 0
}

pub fn equal[T: Eq](a: &[T], b: &[T]): bool {
    if len(a) != len(b) { return false }
    for i in 0..len(a) {
        if a[i] != b[i] { return false }
    }
    return true
}

// ------------------------------------------------------------ rearranging

pub fn reverse[T](xs: mut &[T]) {
    var i = 0
    var j = len(xs) - 1
    while i < j {
        swap(xs, i, j)
        i += 1
        j -= 1
    }
}

// Rotates xs left by k: the element at k moves to 0.
pub fn rotateLeft[T](xs: mut &[T], k: int) {
    let n = len(xs)
    if n == 0 { return }
    let s = ((k % n) + n) % n
    reverse(xs[0..s])
    reverse(xs[s..n])
    reverse(xs)
}

// Inserts x before index i (0 <= i <= len(xs)), shifting the rest up.
pub fn insert[T](xs: mut &[]T, i: int, x: T) {
    if i < 0 || i > len(xs) { panic("insert: index out of range") }
    append(xs, x)
    var j = len(xs) - 1
    while j > i {
        swap(xs, j, j - 1)
        j -= 1
    }
}

// Removes and returns xs[i], shifting the rest down.
pub fn removeAt[T](xs: mut &[]T, i: int): T {
    if i < 0 || i >= len(xs) { panic("removeAt: index out of range") }
    for j in i..len(xs) - 1 { swap(xs, j, j + 1) }
    return pop(xs)
}

// Removes and returns xs[i], moving the last element into its place (O(1),
// changes the order).
pub fn swapRemove[T](xs: mut &[]T, i: int): T {
    if i < 0 || i >= len(xs) { panic("swapRemove: index out of range") }
    swap(xs, i, len(xs) - 1)
    return pop(xs)
}

// Keeps the elements that satisfy pred, in order.
pub fn retain[T](xs: mut &[]T, pred: &fn(&T): bool) {
    var keep = 0
    for i in 0..len(xs) {
        if pred(&xs[i]) {
            swap(xs, keep, i)
            keep += 1
        }
    }
    while len(xs) > keep { pop(xs) }
}

// Removes consecutive duplicates (all duplicates, when xs is sorted).
pub fn dedup[T: Eq](xs: mut &[]T) {
    if len(xs) < 2 { return }
    var keep = 1
    for i in 1..len(xs) {
        if xs[i] != xs[keep - 1] {
            swap(xs, keep, i)
            keep += 1
        }
    }
    while len(xs) > keep { pop(xs) }
}

// ------------------------------------------------------------ copying

// A copy of xs[a..b] (the same as copyOf(xs[a..b])).
pub fn copyRange[T: copy](xs: &[T], a: int, b: int): []T {
    if a < 0 || b < a || b > len(xs) { panic("copyRange: range out of bounds") }
    return copyOf(xs[a..b])
}

// A new array of copies of the elements of xs.
pub fn copyOf[T: copy](xs: &[T]): []T {
    var out: []T = []
    for x in xs { append(mut &out, x) }
    return out
}

// Appends copies of the elements of ys to xs.
pub fn extend[T: copy](xs: mut &[]T, ys: &[T]) {
    for y in ys { append(xs, y) }
}

// The elements of xs for which pred holds, copied.
pub fn filter[T: copy](xs: &[T], pred: &fn(&T): bool): []T {
    var out: []T = []
    for x in xs {
        if pred(&x) { append(mut &out, x) }
    }
    return out
}

// f of each element.
pub fn mapTo[T, U](xs: &[T], f: &fn(&T): U): []U {
    var out: []U = []
    for i in 0..len(xs) { append(mut &out, f(&xs[i])) }
    return out
}

// ------------------------------------------------------------ Set

// A hash set: a Map to Unit. Elements keep their insertion order until one
// is removed (remove moves the last element into the hole).
pub type Set[T: Eq + Hash] = record {
    m: Map[T, Unit]
}

pub fn newSet[T: Eq + Hash](): Set[T] { return Set{m: newMap()} }

// A set of copies of the elements of xs.
pub fn setOf[T: Eq + Hash + copy](xs: &[T]): Set[T] {
    var s: Set[T] = newSet()
    for x in xs { s.add(x) }
    return s
}

pub fn (s: &Set[T]) size(): int { return s.m.size() }
pub fn (s: &Set[T]) isEmpty(): bool { return s.m.size() == 0 }
pub fn (s: &Set[T]) has(x: &T): bool { return s.m.has(x) }

// Adds x; whether it was new.
pub fn (s: mut &Set[T]) add(x: T): bool {
    if s.m.has(&x) { return false }
    s.m.put(x, Unit{})
    return true
}

// Removes x; whether it was there.
// Removes x, if present, in O(1); the last element moves into its place, so
// the order of the rest changes. removeStable keeps the order at O(size).
pub fn (s: mut &Set[T]) remove(x: &T): bool { return s.m.remove(x).isSome() }

// Removes x, if present, keeping the order of the remaining elements:
// O(size). Use remove when the order is not observed.
pub fn (s: mut &Set[T]) removeStable(x: &T): bool { return s.m.removeStable(x).isSome() }

pub fn (s: mut &Set[T]) clear() { s.m.clear() }

// Element i, 0 <= i < size(), for walking the set.
pub fn (s: &Set[T]) at(i: int): &T { return s.m.keyAt(i) }

// Calls f on each element, in the set's order.
pub fn (s: &Set[T]) each(f: &fn(&T)) { s.m.each(fn(k, u) { f(k) }) }

// The elements, in the set's order.
pub fn (s: &Set[T: copy]) items(): []T { return s.m.keys() }

// The elements, sorted.
pub fn (s: &Set[T: Ord + copy]) sorted(): []T {
    var xs = s.m.keys()
    sort(mut &xs)
    return xs
}

pub fn (a: &Set[T: copy]) union(b: &Set[T]): Set[T] {
    var out: Set[T] = newSet()
    a.each(fn(x) { out.add(x) })
    b.each(fn(x) { out.add(x) })
    return out
}

pub fn (a: &Set[T: copy]) intersect(b: &Set[T]): Set[T] { return a.filter(fn(x) { return b.has(x) }) }

pub fn (a: &Set[T: copy]) minus(b: &Set[T]): Set[T] { return a.filter(fn(x) { return !b.has(x) }) }

// The elements that satisfy pred, as a new set.
pub fn (a: &Set[T: copy]) filter(pred: &fn(&T): bool): Set[T] {
    var out: Set[T] = newSet()
    a.each(fn(x) { if pred(x) { out.add(x) } })
    return out
}

pub fn (a: &Set[T]) isSubset(b: &Set[T]): bool {
    for i in 0..a.size() {
        if !b.has(a.at(i)) { return false }
    }
    return true
}

pub fn (a: &Set[T]) eq(b: &Set[T]): bool { return a.size() == b.size() && a.isSubset(b) }

// ------------------------------------------------------------ UniqueList

// A list of unique elements, in insertion order. A port of busterwood/Goodies'
// UniqueList (C#), which was inspired by Python 3.6's dict. The elements live in
// dense arrays (their hashes and values, in insertion order); indexes is an
// open-addressing table of entry numbers, where a slot holds an entry number,
// FREE (never used: probing ends here) or DELETED (its entry was removed:
// probing goes on past it). The table is sized with a quarter of its slots
// spare and is rebuilt without its DELETED marks before the last FREE slot
// would be used, so probing always ends. has, indexOf, add and replace(i, x)
// are O(1) on average;
// removal shifts the later entries down, O(n). A slot is chosen from the hash
// mixed with a per-process seed, as Map does, so no sender can pick colliding
// elements.
pub type UniqueList[T: Eq + Hash] = record {
    indexes: []int   // per slot: an entry number, FREE or DELETED
    hashes: []u64    // per entry: the element's hash
    values: []T      // per entry, in insertion order
    cap: int         // the entry capacity (C#'s values.Length): the table grows when count + 1 >= cap
    tombs: int       // the DELETED slots of indexes
    seed: u64        // mixed into a hash before it picks a slot
}

const FREE = -1
const DELETED = -2
const SLOT_MIX: u64 = 11400714819323198485   // Fibonacci hashing (std's GOLDEN)

// Where a probe ended: slot and entry of the element (-1 when absent), and
// free, the slot it goes to (the first DELETED slot on its probe path, else
// the FREE slot that ended the probe).
type Lookup = value record { slot: int; entry: int; free: int }

extern "c" fn ulHashKey(i: int): u64 as "lxllib_hash_key"

// The per-process seed: SipHash of a name under the kernel's random key
// words, as std derives its own.
fn ulSeed(): u64 { return sipHash13(ulHashKey(0), ulHashKey(1), "UniqueList") }

// An empty list with room for three elements.
pub fn newUniqueList[T: Eq + Hash](): UniqueList[T] {
    return UniqueList{indexes: array(3, FREE), hashes: [], values: [], cap: 3, tombs: 0, seed: ulSeed()}
}

// A list of the distinct elements of xs, in their order.
pub fn uniqueListOf[T: Eq + Hash + copy](xs: &[T]): UniqueList[T] {
    var u: UniqueList[T] = newUniqueList()
    for x in xs { u.add(x) }
    return u
}

pub fn (u: &UniqueList[T]) size(): int { return len(u.values) }
pub fn (u: &UniqueList[T]) isEmpty(): bool { return len(u.values) == 0 }
pub fn (u: &UniqueList[T]) has(x: &T): bool { return u.find(x, x.hash()).entry >= 0 }

// The index of x in the list, or None.
pub fn (u: &UniqueList[T]) indexOf(x: &T): Option[int] {
    let p = u.find(x, x.hash())
    if p.entry < 0 { return None }
    return Some(p.entry)
}

// Element i, borrowed; stops the program (exit 3) when i is out of range.
pub fn (u: &UniqueList[T]) at(i: int): &T { return &u.values[i] }

// Adds x at the end. Whether it was new: false, and nothing changes, when x
// is already in the list.
pub fn (u: mut &UniqueList[T]) add(x: T): bool {
    if len(u.values) + 1 >= u.cap { u.resize() }
    let h = x.hash()
    var p = u.find(&x, h)
    if p.entry >= 0 { return false }
    if len(u.values) + 1 + u.tombs >= len(u.indexes) {
        // the new entry would leave no FREE slot: rebuild without the DELETED marks
        u.rebuild(len(u.indexes))
        p = u.find(&x, h)
    }
    append(mut &u.hashes, h)
    append(mut &u.values, x)
    if u.indexes[p.free] == DELETED { u.tombs -= 1 }
    u.indexes[p.free] = len(u.values) - 1
    return true
}

// Replaces the element equal to x, or adds x when there is none.
pub fn (u: mut &UniqueList[T]) addOrUpdate(x: T) {
    let p = u.find(&x, x.hash())
    if p.entry < 0 {
        u.add(x)
    } else {
        u.replace(p.entry, x)
    }
}

// Stores x at index i in place of the element there. Returns false, and
// changes nothing, when x is already in the list at another index (the
// elements stay unique); true otherwise. Stops the program (exit 3) when i is
// out of range.
pub fn (u: mut &UniqueList[T]) replace(i: int, x: T): bool {
    let oldH = u.hashes[i]
    let h = x.hash()
    let p = u.find(&x, h)
    if p.entry == i {
        replace(mut &u.values[i], x)
        return true
    }
    if p.entry >= 0 { return false }
    // x is new: the slot of entry i becomes DELETED, and x takes a slot
    let s = u.slotOf(i, oldH)
    u.indexes[s] = DELETED
    u.tombs += 1
    replace(mut &u.values[i], x)
    u.hashes[i] = h
    if len(u.values) + u.tombs >= len(u.indexes) {
        u.rebuild(len(u.indexes))
    } else {
        let q = u.find(&u.values[i], h)
        if u.indexes[q.free] == DELETED { u.tombs -= 1 }
        u.indexes[q.free] = i
    }
    return true
}

// Removes x; whether it was in the list. The later elements move down one (O(n)).
pub fn (u: mut &UniqueList[T]) remove(x: &T): bool {
    let p = u.find(x, x.hash())
    if p.entry < 0 { return false }
    u.removeEntry(p.slot, p.entry)
    return true
}

// Removes the element at index i, moves the later elements down one, and
// returns it (O(n)). Stops the program (exit 3) when i is out of range.
pub fn (u: mut &UniqueList[T]) removeAt(i: int): T {
    let s = u.slotOf(i, u.hashes[i])
    return u.removeEntry(s, i)
}

// Removes every element; the table keeps its size.
pub fn (u: mut &UniqueList[T]) clear() {
    replace(mut &u.indexes, array(len(u.indexes), FREE))
    replace(mut &u.hashes, [])
    replace(mut &u.values, [])
    u.tombs = 0
}

// Calls f on each element, in order.
pub fn (u: &UniqueList[T]) each(f: &fn(&T)) {
    for i in 0..len(u.values) { f(&u.values[i]) }
}

// The elements, in order.
pub fn (u: &UniqueList[T: copy]) items(): []T { return copyOf(&u.values) }

// A copy of the list.
pub fn (u: &UniqueList[T: copy]) copy(): UniqueList[T] {
    return UniqueList{indexes: copyOf(&u.indexes), hashes: copyOf(&u.hashes), values: copyOf(&u.values),
        cap: u.cap, tombs: u.tombs, seed: u.seed}
}

// The elements that satisfy pred, in order, as a new list.
pub fn (a: &UniqueList[T: copy]) filter(pred: &fn(&T): bool): UniqueList[T] {
    var out: UniqueList[T] = newUniqueList()
    a.each(fn(x) { if pred(x) { out.add(x) } })
    return out
}

// The elements of a, then the elements of b that a does not have.
pub fn (a: &UniqueList[T: copy]) union(b: &UniqueList[T]): UniqueList[T] {
    var out: UniqueList[T] = newUniqueList()
    a.each(fn(x) { out.add(x) })
    b.each(fn(x) { out.add(x) })
    return out
}

// The elements of a that b has, in a's order.
pub fn (a: &UniqueList[T: copy]) intersect(b: &UniqueList[T]): UniqueList[T] { return a.filter(fn(x) { return b.has(x) }) }

// The elements of a that b does not have, in a's order.
pub fn (a: &UniqueList[T: copy]) minus(b: &UniqueList[T]): UniqueList[T] { return a.filter(fn(x) { return !b.has(x) }) }

// The elements in exactly one of a and b: a minus b, then b minus a.
pub fn (a: &UniqueList[T: copy]) symmetricMinus(b: &UniqueList[T]): UniqueList[T] {
    var out: UniqueList[T] = a.minus(b)
    b.each(fn(x) { if !a.has(x) { out.add(x) } })
    return out
}

pub fn (a: &UniqueList[T]) isSubset(b: &UniqueList[T]): bool {
    for i in 0..a.size() {
        if !b.has(a.at(i)) { return false }
    }
    return true
}

pub fn (a: &UniqueList[T]) isSuperset(b: &UniqueList[T]): bool { return b.isSubset(a) }

pub fn (a: &UniqueList[T]) overlaps(b: &UniqueList[T]): bool {
    for i in 0..a.size() {
        if b.has(a.at(i)) { return true }
    }
    return false
}

// Whether a and b have the same elements (the order is not compared).
pub fn (a: &UniqueList[T]) eq(b: &UniqueList[T]): bool { return a.size() == b.size() && a.isSubset(b) }

// The table slot a hash starts probing at: the hash mixed with the seed, scaled
// to the table's length (the top bits, so every slot is reachable).
fn (u: &UniqueList[T]) home(h: u64): int {
    let x = (h ^ u.seed) *% SLOT_MIX
    return int(((x >> 32) * u64(len(u.indexes))) >> 32)
}

// The slot after s, wrapping round.
fn (u: &UniqueList[T]) after(s: int): int {
    if s + 1 == len(u.indexes) { return 0 }
    return s + 1
}

// The probe for x, whose hash is h: where x is, or where it goes.
fn (u: &UniqueList[T]) find(x: &T, h: u64): Lookup {
    var s = u.home(h)
    var firstDeleted = -1
    while true {
        let e = u.indexes[s]
        if e == FREE {
            let slotFree = if firstDeleted >= 0 { firstDeleted } else { s }
            return Lookup{slot: -1, entry: -1, free: slotFree}
        }
        if e == DELETED {
            if firstDeleted < 0 { firstDeleted = s }
        } else if u.hashes[e] == h && u.values[e] == x {
            return Lookup{slot: s, entry: e, free: firstDeleted}
        }
        s = u.after(s)
    }
}

// The index slot that points at entry e, whose hash is h.
fn (u: &UniqueList[T]) slotOf(e: int, h: u64): int {
    var s = u.home(h)
    while u.indexes[s] != e { s = u.after(s) }
    return s
}

// Removes entry e, which slot s points at: s becomes DELETED, the entries after
// e move down one (and the slots that point at them follow), and e's value is
// returned.
fn (u: mut &UniqueList[T]) removeEntry(s: int, e: int): T {
    u.indexes[s] = DELETED
    u.tombs += 1
    for i in 0..len(u.indexes) {
        if u.indexes[i] > e { u.indexes[i] = u.indexes[i] - 1 }
    }
    removeAt(mut &u.hashes, e)
    return removeAt(mut &u.values, e)
}

// Rebuilds the table with n slots, one for each entry, and no DELETED marks.
fn (u: mut &UniqueList[T]) rebuild(n: int) {
    replace(mut &u.indexes, array(n, FREE))
    u.tombs = 0
    for e in 0..len(u.values) {
        var s = u.home(u.hashes[e])
        while u.indexes[s] != FREE { s = u.after(s) }
        u.indexes[s] = e
    }
}

// Grows as C#'s Resize does: the entry capacity becomes twice the table length
// plus one, and the table has a quarter of its slots spare.
fn (u: mut &UniqueList[T]) resize() {
    let newCap = 2 * len(u.indexes) + 1
    u.cap = newCap
    u.rebuild(newCap * 5 / 4)
}

// ------------------------------------------------------------ Heap

// A binary min-heap: pop returns the smallest element (by cmp/<).
pub type Heap[T: Ord] = record {
    xs: []T
}

pub fn newHeap[T: Ord](): Heap[T] { return Heap{xs: []} }

pub fn (h: &Heap[T]) size(): int { return len(h.xs) }
pub fn (h: &Heap[T]) isEmpty(): bool { return len(h.xs) == 0 }

// The smallest element, borrowed; stops the program when empty.
pub fn (h: &Heap[T]) peek(): &T {
    if len(h.xs) == 0 { panic("Heap.peek: empty heap") }
    return &h.xs[0]
}

pub fn (h: mut &Heap[T]) push(x: T) {
    append(mut &h.xs, x)
    var i = len(h.xs) - 1
    while i > 0 {
        let parent = (i - 1) / 2
        if !(h.xs[i] < h.xs[parent]) { break }
        swap(mut &h.xs, i, parent)
        i = parent
    }
}

// Removes and returns the smallest element, if any.
pub fn (h: mut &Heap[T]) pop(): Option[T] {
    let n = len(h.xs)
    if n == 0 { return None }
    swap(mut &h.xs, 0, n - 1)
    let top = pop(mut &h.xs)
    var i = 0
    let m = n - 1
    while true {
        var c = 2 * i + 1
        if c >= m { break }
        if c + 1 < m && h.xs[c + 1] < h.xs[c] { c += 1 }
        if !(h.xs[c] < h.xs[i]) { break }
        swap(mut &h.xs, i, c)
        i = c
    }
    return Some(top)
}

pub fn sort[T: Ord](xs: mut &[T]) {
    let n = len(xs)
    var i = n / 2
    while i > 0 {
        i -= 1
        siftDown(xs, i, n)
    }
    var end = n
    while end > 1 {
        end -= 1
        swap(xs, 0, end)
        siftDown(xs, 0, end)
    }
}

fn siftDown[T: Ord](xs: mut &[T], start: int, end: int) {
    var root = start
    while true {
        var child = root * 2 + 1
        if child >= end { break }
        if child + 1 < end && xs[child] < xs[child + 1] { child += 1 }
        if xs[root] < xs[child] {
            swap(xs, root, child)
            root = child
        } else {
            break
        }
    }
}

// ---------------------------------------------------------------- Map

//
// A map's hasher is a function value in the map itself. newMap uses
// defaultHash, which calls K.hash() (SipHash-1-3 for str: HashDoS-resistant).
// newMapWith takes another hasher, such as fxHashStr or fxHashInt below.
//
// The Fx hasher (rustc-hash): rotate left 5, xor a word, multiply by the Fx
// constant. It is fast and NOT cryptographically secure. Use it only for
// trusted input (compiler tooling, internal tables): a Map built with it has
// no protection against hash flooding, because an attacker can choose keys
// that collide in the hash itself.
//
// fxHashStr hashes 8 bytes at a time (little-endian), then the 4-, 2- and
// 1-byte tail. fxHashInt mixes the 64-bit value the same way.
const FX_K: u64 = 0x517cc1b727220a95

fn fxMix(h: u64, word: u64): u64 { return (h << 5 | h >> 59) ^ word }

fn fxStep(h: u64, word: u64): u64 { return fxMix(h, word) *% FX_K }

pub fn fxHashStr(s: &str): u64 {
    var h: u64 = 0
    let n = len(s)
    let end = n - (n & 7)
    var i = 0
    while i < end {
        h = fxStep(h, strWord(s, i))
        i += 8
    }
    if end == n { return h }
    // The tail bytes, in little-endian order in t's low bits.
    var t: u64 = 0
    if n >= 8 {
        t = strWord(s, n - 8) >> (64 - 8 * (n & 7))
    } else {
        var j = 0
        while j < n {
            t |= u64(strByte(s, j)) << (8 * j)
            j += 1
        }
    }
    var rem = n & 7
    if rem >= 4 {
        h = fxStep(h, t & 0xffffffff)
        t = t >> 32
        rem -= 4
    }
    if rem >= 2 {
        h = fxStep(h, t & 0xffff)
        t = t >> 16
        rem -= 2
    }
    if rem >= 1 { h = fxStep(h, t & 0xff) }
    return h
}

pub fn fxHashInt(x: int): u64 { return fxStep(0, u64(x)) }

// The default hasher: the key type's Hash implementation, so str keys are
// SipHash-1-3 under the process's random key.
fn defaultHash[K: Hash](k: &K): u64 { return k.hash() }

//
// A hash map that keeps its entries in insertion order in three parallel
// arrays (keys, values, hashes) and finds them through an open-addressing
// index (linear probing, at most half full). keyAt(i)/valAt(i) for i in
// 0..size() walk the entries in insertion order. put appends; remove is the
// O(1) swap-remove (the last entry moves into the hole, so the order changes);
// removeStable shifts the tail down (O(size)) and keeps the order.
//
// A slot of the index is a u32: 0 when empty, else the entry number plus one
// in its low b bits (len(index) = 2^b, and there are at most 2^(b-1) + 1
// entries) and, above them, a tag: the 32 - b bits of the mixed hash right
// below the b bits that pick the home slot. A probe that meets another key's
// slot almost always sees a different tag and moves on without loading
// anything else; a lookup loads the slot, then the key it names.

pub type Map[K: Eq + Hash, V] = record {
    keys: []K
    vals: []V
    hashes: []u64
    index: []u32   // 0 or a tag and an entry number + 1; the length is a power of two, at most 2^32
    shift: int     // 64 - log2(len(index))
    seed: u64      // the process's hash.hashSeed(): where a hash's slots are is not predictable
    fast: bool     // true when hashFn is a supplied hasher, not the default K.hash()
    hashFn: fn(&K): u64  // the hasher: consulted when fast; newMapWith supplies it
}

type Probe = value record { slot: int; entry: int }

pub fn newMap[K: Eq + Hash, V](): Map[K, V] {
    return Map{keys: [], vals: [], hashes: [], index: array(8, u32(0)), shift: 61, seed: hash.hashSeed(),
        fast: false, hashFn: defaultHash[K]}
}

// A Map that hashes keys with hashFn instead of K.hash(). Use it for trusted
// input only: fxHashStr and fxHashInt are fast but not collision resistant.
pub fn newMapWith[K: Eq + Hash, V](hashFn: fn(&K): u64): Map[K, V] {
    return Map{keys: [], vals: [], hashes: [], index: array(8, u32(0)), shift: 61, seed: hash.hashSeed(),
        fast: true, hashFn: hashFn}
}

// The hash of a key at a call site: the supplied hasher, or K.hash() on the
// default path (direct, so a default Map pays one predictable branch). Written
// out at each site: a helper function would add a call around every hash.

// The mixed hash: (h ^ seed) * SLOT_MIX (Fibonacci hashing). Its top bits are the first slot.
// With the seed, keys whose hashes are known (the integers') still land in unknown slots.
fn (m: &Map[K, V]) mix(h: u64): u64 { return (h ^ m.seed) *% SLOT_MIX }

fn (m: &Map[K, V]) home(h: u64): int { return int(m.mix(h) >> m.shift) }

// The tag of mixed hash x: its bits below the home bits, in the slot bits above the entry.
fn (m: &Map[K, V]) tagOf(x: u64): u32 { return u32((x << (64 - m.shift)) >> 32) & ~u32(len(m.index) - 1) }

// The slot holding k, or the empty slot where it would go (entry -1).
fn (m: &Map[K, V]) find(k: &K, h: u64): Probe {
    let mask = len(m.index) - 1
    let low = u32(mask)
    let x = m.mix(h)
    let tag = m.tagOf(x)
    var i = int(x >> m.shift)
    while true {
        let s = m.index[i]
        if s == 0 { return Probe{slot: i, entry: -1} }
        let d = s ^ tag   // the entry number + 1 when the tags match
        if d <= low {
            let e = int(d) - 1
            if m.keys[e] == k { return Probe{slot: i, entry: e} }
        }
        i = (i + 1) & mask
    }
}

pub fn (m: &Map[K, V]) size(): int { return len(m.keys) }

pub fn (m: &Map[K, V]) has(k: &K): bool {
    let h = if m.fast { m.hashFn(k) } else { k.hash() }
    return m.find(k, h).entry >= 0
}

pub fn (m: &Map[K, V: copy]) get(k: &K): Option[V] {
    let h = if m.fast { m.hashFn(k) } else { k.hash() }
    let p = m.find(k, h)
    if p.entry < 0 { return None }
    return Some(m.vals[p.entry])
}

pub fn (m: &Map[K, V: copy]) getOr(k: &K, d: V): V {
    let h = if m.fast { m.hashFn(k) } else { k.hash() }
    let p = m.find(k, h)
    if p.entry < 0 { return d }
    return m.vals[p.entry]
}

// The value stored under k, borrowed from the map; stops the program if absent.
pub fn (m: &Map[K, V]) at(k: K): &V {
    let h = if m.fast { m.hashFn(&k) } else { k.hash() }
    let p = m.find(&k, h)
    if p.entry < 0 { panic("Map.at: no such key") }
    return &m.vals[p.entry]
}

// The value stored under k, mutably borrowed; stops the program if absent.
pub fn (m: mut &Map[K, V]) atMut(k: K): mut &V {
    let h = if m.fast { m.hashFn(&k) } else { k.hash() }
    let p = m.find(&k, h)
    if p.entry < 0 { panic("Map.atMut: no such key") }
    return mut &m.vals[p.entry]
}

// The value under k, mutably borrowed, after storing d there if k was
// absent: `let n = counts.atOrPut(word, 0); n += 1`.
pub fn (m: mut &Map[K, V]) atOrPut(k: K, d: V): mut &V {
    let h = if m.fast { m.hashFn(&k) } else { k.hash() }
    let p = m.find(&k, h)
    if p.entry >= 0 { return mut &m.vals[p.entry] }
    m.index[p.slot] = m.tagOf(m.mix(h)) | u32(len(m.keys) + 1)
    append(mut &m.keys, k)
    append(mut &m.vals, d)
    append(mut &m.hashes, h)
    if 2 * len(m.keys) > len(m.index) { m.grow() }
    return mut &m.vals[len(m.vals) - 1]
}

// Entry i in insertion order, 0 <= i < size().
pub fn (m: &Map[K, V]) keyAt(i: int): &K { return &m.keys[i] }
pub fn (m: &Map[K, V]) valAt(i: int): &V { return &m.vals[i] }
pub fn (m: mut &Map[K, V]) valAtMut(i: int): mut &V { return mut &m.vals[i] }

// Experimental (design/borrow-types.md): `for e in m.iter() { ... e.key ... e.value ... }` walks
// the entries in insertion order. The entries borrow the map, not the iterator, so they may be
// kept (and the map is frozen) while they are in scope.
pub type MapIter[K: Eq + Hash, V] = value record {
    m: &Map[K, V]
    i: int
}

pub type MapEntry[K, V] = value record {
    pub key: &K
    pub value: &V
}

pub fn (m: &Map[K, V]) iter(): MapIter[K, V] { return MapIter{m: m, i: 0} }

pub fn (it: mut &MapIter[K, V]) next(): Option[MapEntry[K, V]] {
    if it.i >= len(it.m.keys) { return None }
    let i = it.i
    it.i += 1
    return Some(MapEntry{key: &it.m.keys[i], value: &it.m.vals[i]})
}

// Calls f on each entry, in insertion order.
pub fn (m: &Map[K, V]) each(f: &fn(&K, &V)) {
    for i in 0..len(m.keys) { f(&m.keys[i], &m.vals[i]) }
}

// Calls f on each entry with a mutable value, in insertion order.
pub fn (m: mut &Map[K, V]) eachMut(f: &fn(&K, mut &V)) {
    for i in 0..len(m.keys) { f(&m.keys[i], mut &m.vals[i]) }
}

// The keys (values) in insertion order.
pub fn (m: &Map[K: copy, V]) keys(): []K {
    var out: []K = []
    for k in m.keys { append(mut &out, k) }
    return out
}

pub fn (m: &Map[K, V: copy]) values(): []V {
    var out: []V = []
    for v in m.vals { append(mut &out, v) }
    return out
}

// Stores v under k, replacing (and dropping) an older value.
pub fn (m: mut &Map[K, V]) put(k: K, v: V) {
    let h = if m.fast { m.hashFn(&k) } else { k.hash() }
    let p = m.find(&k, h)
    if p.entry >= 0 {
        replace(mut &m.vals[p.entry], v)
        return
    }
    m.index[p.slot] = m.tagOf(m.mix(h)) | u32(len(m.keys) + 1)
    append(mut &m.keys, k)
    append(mut &m.vals, v)
    append(mut &m.hashes, h)
    if 2 * len(m.keys) > len(m.index) { m.grow() }
}

// Removes k and returns its value, if it was there, in O(1): the last entry
// moves into the hole, so the insertion order of the remaining entries
// changes. removeStable keeps that order at O(size).
pub fn (m: mut &Map[K, V]) remove(k: &K): Option[V] {
    let h = if m.fast { m.hashFn(k) } else { k.hash() }
    let p = m.find(k, h)
    if p.entry < 0 { return None }
    m.unlink(p.slot)
    let last = len(m.keys) - 1
    if p.entry != last {
        // the last entry moves into the hole: repoint its slot
        let s = m.slotOf(last)
        m.index[s] = m.index[s] & ~u32(len(m.index) - 1) | u32(p.entry + 1)
        swap(mut &m.keys, p.entry, last)
        swap(mut &m.vals, p.entry, last)
        swap(mut &m.hashes, p.entry, last)
    }
    pop(mut &m.keys)
    pop(mut &m.hashes)
    return Some(pop(mut &m.vals))
}

// Removes k and returns its value, if it was there. The remaining entries keep
// their insertion order: the tail shifts down, so this costs O(size); use
// remove when the order does not matter.
pub fn (m: mut &Map[K, V]) removeStable(k: &K): Option[V] {
    let h = if m.fast { m.hashFn(k) } else { k.hash() }
    let p = m.find(k, h)
    if p.entry < 0 { return None }
    m.unlink(p.slot)
    let last = len(m.keys) - 1
    var i = p.entry
    while i < last {
        swap(mut &m.keys, i, i + 1)
        swap(mut &m.vals, i, i + 1)
        swap(mut &m.hashes, i, i + 1)
        i += 1
    }
    pop(mut &m.keys)
    pop(mut &m.hashes)
    let v = pop(mut &m.vals)
    // Removing the last entry shifts nothing, so no slot changed its entry
    // number; a middle removal decrements the numbers of the entries that
    // shifted. That is one pass over the index with no rehash.
    if p.entry != last { m.shiftEntries(p.entry) }
    return Some(v)
}

// Entry e was removed and the tail shifted down by one: every index slot that
// named an entry after e now names one less. The tags stay; only the low
// entry+1 field changes. O(len(index)), no hashing.
fn (m: mut &Map[K, V]) shiftEntries(e: int) {
    let low = u32(len(m.index) - 1)
    let cut = u32(e + 1)
    for i in 0..len(m.index) {
        let s = m.index[i]
        if s == 0 { continue }
        let num = s & low
        if num > cut { m.index[i] = (s & ~low) | (num - 1) }
    }
}

pub fn (m: mut &Map[K, V]) clear() {
    replace(mut &m.keys, [])
    replace(mut &m.vals, [])
    replace(mut &m.hashes, [])
    replace(mut &m.index, array(8, u32(0)))
    m.shift = 61
}

// The slot that points at entry e.
fn (m: &Map[K, V]) slotOf(e: int): int {
    let mask = len(m.index) - 1
    let low = u32(mask)
    let s = u32(e + 1)
    var i = m.home(m.hashes[e])
    while m.index[i] & low != s { i = (i + 1) & mask }
    return i
}

// Empties slot s, shifting later entries of its probe run back (no tombstones).
fn (m: mut &Map[K, V]) unlink(s: int) {
    let mask = len(m.index) - 1
    let low = u32(mask)
    var hole = s
    var j = (s + 1) & mask
    while m.index[j] != 0 {
        let h = m.home(m.hashes[int(m.index[j] & low) - 1])
        if (j - h) & mask >= (j - hole) & mask {
            m.index[hole] = m.index[j]
            hole = j
        }
        j = (j + 1) & mask
    }
    m.index[hole] = 0
}

fn (m: mut &Map[K, V]) grow() {
    let n = len(m.index) * 2
    if n > 4294967296 { panic("Map: more than 2^31 entries") }
    replace(mut &m.index, array(n, u32(0)))
    m.shift -= 1
    let mask = n - 1
    for e in 0..len(m.keys) {
        let x = m.mix(m.hashes[e])
        var i = int(x >> m.shift)
        while m.index[i] != 0 { i = (i + 1) & mask }
        m.index[i] = m.tagOf(x) | u32(e + 1)
    }
}

// ---------------------------------------------------------------- call sites

// Where a call is: the text "file:line", in the program's static data (a
// lang item, SPEC 15). A call of a library function (a module loaded from a
// library root) whose last parameter is a Where may leave that argument out:
// the compiler passes the call's own location. lib/task reports where a task
// parked, or where a with was opened, with it.
