// par: a par.map closure that can reach I/O, here two calls away, is refused
// with the chain of calls.
// error: par_kernel_io.lxl:12: par.map: the closure is not a kernel: it can reach I/O (writeFd)
import "par"
fn note(x: int) { println("item " + x.toStr()) }
fn work(x: &int): int {
    note(x)
    return x * 2
}
fn main() {
    let xs: []int = [1, 2, 3]
    let ys = par.map(&xs, fn(x: &int): int { return work(x) + 1 })
}
