// error: Shared[Node] can hold itself
// line: 6
// A cycle through an rc of a Shared is refused too: the Shared inside can change.
import "task"

type Node = record { name: str; next: Option[rc task.Shared[Node]] }

fn main() {
    let r: rc task.Shared[Node] = rc(task.shared(Node{name: "a", next: None}))
    r.with(fn(n) { n.next = Some(r.share()) })
    println("rc cycle made")
}
