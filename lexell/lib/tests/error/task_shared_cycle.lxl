// error: Shared[Node] can hold itself
// line: 7
// A Shared value whose type can reach that same Shared is refused: counted handles must not
// form cycles, which would never be freed (design/consistency.md, finding 1); use task.Weak.
import "task"

type Node = record { name: str; next: Option[task.Shared[Node]] }

fn main() {
    let a = task.shared(Node{name: "a", next: None})
    let b = a.share()
    a.with(fn(n) { n.next = Some(b.share()) })
    println("made a cycle")
}
