// error: it can reach the C function labs (declare it pure
// line: 10
// par.map refuses an extern not declared pure (SPEC 12, design/parallel.md 2.5).
import "par"
extern "c" fn labs(x: int): int
extern "c" fn strlen(s: &str): int
fn main() {
    var xs: []int = []
    for i in 0..1000 { append(mut &xs, i - 500) }
    let ys = par.map(&xs, fn(x: &int): int { return labs(x) })
    var t = 0
    for y in ys { t += y }
    println(t.toStr())
}
