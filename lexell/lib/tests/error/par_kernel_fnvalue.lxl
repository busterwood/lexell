// par: a call through a function value in a kernel may reach every function of
// its type whose address is taken, so one that prints refuses the kernel even
// when this call would pick the other.
// error: par.map: the closure is not a kernel: it can reach I/O (writeFd)
import "par"
fn quiet(x: int): int { return x + 1 }
fn loud(x: int): int {
    println(x.toStr())
    return x
}
fn pick(b: bool): fn(int): int { return if b { quiet } else { loud } }
fn main() {
    let f = pick(true)
    println(f(1).toStr())
    let xs: []int = [1, 2, 3]
    let ys = par.map(&xs, fn(x: &int): int {
        let g = pick(true)
        return g(x)
    })
}
