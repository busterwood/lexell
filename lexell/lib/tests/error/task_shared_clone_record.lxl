// error: Counter holds a task.Shared, which is shared, not copied
// line: 8
// clone() makes an independent copy; a record holding a Shared declares share() instead.
import "task"
type Counter = record { name: str; n: task.Shared[int] }
fn main() {
    let a = Counter{name: "a", n: task.shared(0)}
    let b = a.clone()
    b.n.with(fn(v) { v += 5 })
    a.n.with(fn(v) { println(v) })
}
