// par: a par.map closure may not park.
// error: par.map: the closure is not a kernel: it can reach a park or I/O (lxllib_task_yield)
import "par"
import "task"
fn main() {
    let xs: []int = [1, 2, 3]
    let ys = par.map(&xs, fn(x: &int): int {
        let r = task.yield()
        return x
    })
}
