// par: par.map's closure may read the variables around it but not change them.
// error: par.map: the closure changes 'total', which it captures: its runs share the variables around it, so it may only read them
import "par"
fn main() {
    let xs: []int = [1, 2, 3]
    var total = 0
    let ys = par.map(&xs, fn(x: &int): int {
        total += x
        return x
    })
}
