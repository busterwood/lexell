// par: par.map's closure is written at the call, so the compiler knows what runs.
// error: par.map needs its closure written at the call (a closure, or the name of a function), so that the compiler can check what the pool's threads run
import "par"
fn run(xs: &[]int, f: &fn(&int): int): []int { return par.map(xs, f) }
fn main() {
    let xs: []int = [1, 2, 3]
    let ys = run(&xs, fn(x: &int): int { return x })
}
