// An extern declared pure (SPEC 12) may be called from a par.map kernel: the declarer promises it
// does no I/O, shares no state and makes no callbacks.
// expect: 250000
import "par"
extern "c" fn labs(x: int): int pure
fn main() {
    var xs: []int = []
    for i in 0..1000 { append(mut &xs, i - 500) }
    let ys = par.map(&xs, fn(x: &int): int { return labs(x) })
    var t = 0
    for y in ys { t += y }
    println(t.toStr())
}
