// glob: Unix path semantics: * and ? stop at /, dotfiles need an explicit .,
// ** is recursive only with globstar, sets and ASCII POSIX classes, escapes,
// and expansion under a root.
// expect: literal true false
// expect: star true false false
// expect: question true false true true
// expect: set true true true true true
// expect: dot false true true
// expect: globstar true true true false
// expect: escape true false
// expect: errors true true
// expect: top top.txt
// expect: deep a/sub/y.txt a/x.txt b/z.txt top.txt
// expect: hidden .hidden.txt a/.hidden.txt a/sub/y.txt a/x.txt b/z.txt top.txt
// expect: bad true
// expect: io true
import "glob"
import "fs"
import "io"
import "os"

fn b(v: bool): str { return if v { "true" } else { "false" } }

fn text(xs: &[str]): str {
    var s = ""
    for i in 0..len(xs) {
        if i > 0 { s += " " }
        s += xs[i]
    }
    return s
}

fn check[T](r: Result[T, io.IoError]): T {
    match move(r) {
        Ok(v) { return v }
        Err(e) {
            eprintln("unexpected: " + e.toStr())
            exit(1)
        }
    }
}

fn main() {
    println("literal " + b(glob.matchPath("a/b", "a/b").unwrap()) + " " +
        b(glob.matchPath("a/b", "a/c").unwrap()))
    println("star " + b(glob.matchPath("a/*/b", "a/x/b").unwrap()) + " " +
        b(glob.matchPath("a/*/b", "a/x/y/b").unwrap()) + " " +
        b(glob.matchPath("*", "a/b").unwrap()))
    println("question " + b(glob.matchPath("a?c", "abc").unwrap()) + " " +
        b(glob.matchPath("a?c", "ac").unwrap()) + " " +
        b(glob.matchPath("?", "é").unwrap()) + " " + b(glob.matchPath("?", "😀").unwrap()))
    println("set " + b(glob.matchPath("[abc]", "b").unwrap()) + " " +
        b(glob.matchPath("[!abc]", "d").unwrap()) + " " +
        b(glob.matchPath("[^abc]", "d").unwrap()) + " " +
        b(glob.matchPath("[a-z]", "m").unwrap()) + " " +
        b(glob.matchPath("[[:digit:]][[:digit:]]", "42").unwrap()))

    println("dot " + b(glob.matchPath("*", ".hidden").unwrap()) + " " +
        b(glob.matchPath(".*", ".hidden").unwrap()) + " " +
        b(glob.matchPathWith("*", ".hidden", dotOpts()).unwrap()))

    var g = glob.defaults()
    g.globstar = true
    println("globstar " + b(glob.matchPathWith("a/**/b", "a/b", g).unwrap()) + " " +
        b(glob.matchPathWith("a/**/b", "a/x/b", g).unwrap()) + " " +
        b(glob.matchPathWith("a/**/b", "a/x/y/b", g).unwrap()) + " " +
        b(glob.matchPath("a/**/b", "a/x/y/b").unwrap()))

    println("escape " + b(glob.matchPath(&(glob.escape("a*b")), "a*b").unwrap()) + " " +
        b(glob.matchPath(&(glob.escape("a*b")), "axb").unwrap()))

    println("errors " + b(glob.compile("[abc").isErr()) + " " +
        b(glob.compile("[[:bogus:]]").isErr()))

    let base = "/tmp/lxl_lib_glob_" + os.pid().toStr()
    fs.removeAll(&base)
    check(fs.mkdirAll(&(fs.join(&base, "a/sub"))))
    check(fs.mkdirAll(&(fs.join(&base, "b"))))
    check(io.write(&(fs.join(&base, "top.txt")), ""))
    check(io.write(&(fs.join(&base, ".hidden.txt")), ""))
    check(io.write(&(fs.join(&base, "a/x.txt")), ""))
    check(io.write(&(fs.join(&base, "a/.hidden.txt")), ""))
    check(io.write(&(fs.join(&base, "a/sub/y.txt")), ""))
    check(io.write(&(fs.join(&base, "b/z.txt")), ""))

    println("top " + text(&glob.expand(&base, "*.txt", glob.defaults()).unwrap()))

    var deep = glob.defaults()
    deep.globstar = true
    println("deep " + text(&glob.expand(&base, "**/*.txt", deep).unwrap()))

    var hidden = glob.defaults()
    hidden.globstar = true
    hidden.dot = true
    println("hidden " + text(&glob.expand(&base, "**/*.txt", hidden).unwrap()))

    println("bad " + b(glob.expand(&base, "[abc", glob.defaults()).isErr()))
    println("io " + b(glob.expand(&(fs.join(&base, "missing")), "*", glob.defaults()).isErr()))
    fs.removeAll(&base)
}

fn dotOpts(): glob.Options {
    var o = glob.defaults()
    o.dot = true
    return o
}
