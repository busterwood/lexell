// time: strftime tokens (epoch, leap day, year end, ISO weeks, pass-through).
// expect: 1970-01-01 00:00:00 Thu Thursday Jan January 001 0 UTC +0000
// expect: 2024-02-29 00:00:00 Thu Feb 060 1709164800
// expect: 2024-12-31 23:59:59 Tue Dec 366 1735689599
// expect: 2024-02-29 13:45:07 13:45 02/29/24 01:45:07 PM Thu Feb 29 13:45:07 2024 02/29/24 13:45:07
// expect: [01][ 1][13][PM][pm][20][24][24]
// expect: [ 5][05] [29][29]
// expect: 060 365
// expect: Thu Thursday Feb February
// expect: 2020-W53-5 2025-W01-1 00 00 08 09
// expect: %Q|Feb|%|abc%
// expect: n true t true
// expect: 2024-02-29 13:45:07
import "time"

fn f(sec: int, fmt: str): str {
    let t = time.gmtimeOf(sec)
    return time.strftime(&t, &fmt, "UTC")
}

fn main() {
    println(f(0, "%Y-%m-%d %H:%M:%S %a %A %b %B %j %s %Z %z"))
    println(f(1709164800, "%Y-%m-%d %H:%M:%S %a %b %j %s"))
    println(f(1735689599, "%Y-%m-%d %H:%M:%S %a %b %j %s"))
    // 2024-02-29T13:45:07Z
    println(f(1709214307, "%F %T %R %D %r %c %x %X"))
    println(f(1709214307, "[%I][%l][%k][%p][%P][%C][%y][%g]"))
    // %e is space padded; %d is zero padded
    println(f(1709596800, "[%e][%d]") + " " + f(1709164800, "[%e][%d]"))
    println(f(1709164800, "%j") + " " + f(1703980800, "%j"))
    println(f(1709164800, "%a %A %b %B"))
    // 2021-01-01 is Friday of ISO week 53 of 2020; 2024-12-30 starts week 1 of 2025
    println(f(1609459200, "%G-W%V-%u") + " " + f(1735516800, "%G-W%V-%u") + " " + f(0, "%U %W") + " " +
        f(1709164800, "%U %W"))
    println(f(1709164800, "%Q|%h|%%|abc%"))
    let n = f(0, "%n")
    let t = f(0, "%t")
    println("n " + (n == "\n").toStr() + " t " + (t == "\t").toStr())
    let l = time.parseLocalDateTime("2024-02-29T13:45:07.25").unwrap()
    println(time.strftimeLocal(l, "%F %T", "UTC"))
}
