// par: an integer overflow in a kernel stops the program (exit 10).
// exit: 10
// stderr: Lexell: integer overflow at par_trap_overflow.lxl:9
import "par"

fn grow(x: &int): int {
    var v = 1
    for i in 0..100 { v += i }
    if x == 1500 { v = v * 9223372036854775807 }
    return v
}

fn main() {
    var xs: []int = []
    for i in 0..2000 { append(mut &xs, i) }
    let ys = par.map(&xs, grow)
    println("not reached")
}
