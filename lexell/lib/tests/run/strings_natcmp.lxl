// strings: natord-plus-plus 2.0.0, the order behind eza's name sort. Ported
// from archive/obo/tests/stdlib/strings_natcmp.obx: the crate's four lists
// (case-sensitive and folded), the equality classes, whitespace skipping, the
// sign contract (-1, 0, 1 exactly), the UTF-8 code-point layer, the documented
// partial lowercase table and lossy invalid-byte comparison.
// expect: strings natcmp ok
import "strings"

fn b1(a: int): str { return strFromBytes(&[byte(a)]) }

fn b2(a: int, b: int): str { return strFromBytes(&[byte(a), byte(b)]) }

fn b3(a: int, b: int, c: int): str { return strFromBytes(&[byte(a), byte(b), byte(c)]) }

fn ck(label: str, got: int, want: int): int {
    if got != want {
        println("FAIL " + label + ": got " + got.toStr() + " want " + want.toStr())
        return 1
    }
    return 0
}

fn ckList(label: str, xs: &[]str, fold: bool): int {
    var fails = 0
    var i = 1
    while i < len(xs) {
        var c = strings.natcmp(&xs[i - 1], &xs[i])
        if fold { c = strings.natcmpFold(&xs[i - 1], &xs[i]) }
        fails += ck(label + " pair " + i.toStr(), c, -1)
        i += 1
    }
    return fails
}

fn main() {
    var fails = 0

    // crate list 1: a < a0 < a1 < a1a < a1b < a2 < a10 < a20
    let l1: []str = ["a", "a0", "a1", "a1a", "a1b"]
    fails += ckList("natcmp list1a", &l1, false)
    fails += ckList("natcmpFold list1a", &l1, true)
    let l1b: []str = ["a1b", "a2", "a10", "a20"]
    fails += ckList("natcmp list1b", &l1b, false)
    fails += ckList("natcmpFold list1b", &l1b, true)

    // crate list 2
    let l2: []str = ["x2-g8", "x2-y7", "x2-y8", "x8-y8"]
    fails += ckList("natcmp list2", &l2, false)
    fails += ckList("natcmpFold list2", &l2, true)

    // crate list 3: leading-zero runs are left-aligned
    let l3: []str = ["1.001", "1.002", "1.010", "1.02", "1.1"]
    fails += ckList("natcmp list3a", &l3, false)
    fails += ckList("natcmpFold list3a", &l3, true)
    let l3b: []str = ["1.1", "1.3"]
    fails += ckList("natcmp list3b", &l3b, false)

    // crate list 4: the long interleaving of digits, spaces and dots
    let l4: []str = ["1-02", "1-2", "1-20", "10-20", "fred", "jane", "pic1",
        "pic2", "pic2a", "pic3", "pic4", "pic4   alpha", "pic 4 else",
        "pic4  last", "pic5", "pic5.07", "pic5.08", "pic5.13", "pic5.113",
        "pic 5 something", "pic 6", "pic   7", "pic100", "pic100a", "pic120",
        "pic121", "pic2000", "tom", "x2-g8", "x2-y7", "x2-y8", "x8-y8"]
    fails += ckList("natcmp list4", &l4, false)
    fails += ckList("natcmpFold list4", &l4, true)

    // digit-run rules: 2 < 10, 01 < 1, 0 < 00, rfc1 < rfc2 < rfc10
    fails += ck("natcmp 2 10", strings.natcmp("2", "10"), -1)
    fails += ck("natcmp 10 2", strings.natcmp("10", "2"), 1)
    fails += ck("natcmp 01 1", strings.natcmp("01", "1"), -1)
    fails += ck("natcmp 1 01", strings.natcmp("1", "01"), 1)
    fails += ck("natcmp 0 00", strings.natcmp("0", "00"), -1)
    fails += ck("natcmp 00 0", strings.natcmp("00", "0"), 1)
    fails += ck("natcmp rfc1 rfc2", strings.natcmp("rfc1", "rfc2"), -1)
    fails += ck("natcmp rfc2 rfc10", strings.natcmp("rfc2", "rfc10"), -1)
    fails += ck("natcmp rfc10 rfc1", strings.natcmp("rfc10", "rfc1"), 1)
    fails += ck("natcmpFold 2 10", strings.natcmpFold("2", "10"), -1)
    // the contract's names are the same comparator
    fails += ck("naturalCompare 2 10", strings.naturalCompare("2", "10"), -1)
    fails += ck("naturalCompareFold A a", strings.naturalCompareFold("A", "a"), 0)

    // equality classes carry their comparator: folding makes case equal, the
    // case-sensitive order does not
    fails += ck("fold A a", strings.natcmpFold("A", "a"), 0)
    fails += ck("fold a A", strings.natcmpFold("a", "A"), 0)
    fails += ck("fold README", strings.natcmpFold("README", "readme"), 0)
    fails += ck("natcmp A a", strings.natcmp("A", "a"), -1)
    fails += ck("natcmp README", strings.natcmp("README", "readme"), -1)
    fails += ck("fold B b", strings.natcmpFold("B", "b"), 0)
    fails += ck("fold pic4 space", strings.natcmpFold("pic4", "pic 4"), 0)
    fails += ck("fold pic4 space rev", strings.natcmpFold("pic 4", "pic4"), 0)
    fails += ck("fold a leading space", strings.natcmpFold("a", " a"), 0)

    // whitespace is skipped under both comparators, at the outer loop only
    fails += ck("natcmp pic4 space", strings.natcmp("pic4", "pic 4"), 0)
    fails += ck("natcmp pic4 space rev", strings.natcmp("pic 4", "pic4"), 0)
    fails += ck("natcmp a leading space", strings.natcmp("a", " a"), 0)
    fails += ck("natcmp leading both", strings.natcmp(" a", "  a"), 0)
    fails += ck("natcmp two inner", strings.natcmp("pic 4", "pic  4"), 0)
    fails += ck("natcmp trailing tab", strings.natcmp("a\t", "a"), 0)
    fails += ck("natcmp newline", strings.natcmp("a\n", " a"), 0)
    fails += ck("natcmp crlf", strings.natcmp("a\r\n", "a"), 0)
    let avt = b2(0x61, 11)
    fails += ck("natcmp trailing vt", strings.natcmp(&avt, "a"), 0)
    fails += ck("natcmp fold trailing ff", strings.natcmpFold("a", &avt), 0)

    // a whitespace-only string is equal to the empty string
    fails += ck("natcmp spaces empty", strings.natcmp("   ", ""), 0)
    fails += ck("natcmp tab empty", strings.natcmp("\t\r\n", ""), 0)

    // signs are exactly -1 and 1, including the first-difference memory path
    fails += ck("sign abc abd", strings.natcmp("abc", "abd"), -1)
    fails += ck("sign abd abc", strings.natcmp("abd", "abc"), 1)
    fails += ck("sign x99 x100", strings.natcmp("x99", "x100"), -1)
    fails += ck("sign x100 x99", strings.natcmp("x100", "x99"), 1)
    fails += ck("sign x0099 x100", strings.natcmp("x0099", "x100"), -1)
    fails += ck("sign x0100 x0099", strings.natcmp("x0100", "x0099"), 1)

    // UTF-8 code points compare by value, not by byte.
    fails += ck("utf8 e-acute z", strings.natcmp("é", "z"), 1)
    fails += ck("utf8 z e-acute", strings.natcmp("z", "é"), -1)
    fails += ck("utf8 a e-acute", strings.natcmp("a", "é"), -1)
    fails += ck("utf8 cjk z", strings.natcmp("中", "z"), 1)
    fails += ck("utf8 emoji cjk", strings.natcmp("😀", "中"), 1)
    fails += ck("utf8 emoji omega", strings.natcmp("😀", "Ω"), 1)
    // e + U+0301 is "e" first, so it sorts before precomposed é
    let ecomb = b3(0x65, 0xcc, 0x81)
    fails += ck("utf8 combining e-acute", strings.natcmp(&ecomb, "é"), -1)
    fails += ck("utf8 combining f", strings.natcmp(&ecomb, "f"), -1)
    // simple lowercase: Latin-1, Greek, Cyrillic and fullwidth pairs
    fails += ck("fold Eacute", strings.natcmpFold("É", "é"), 0)
    fails += ck("natcmp Eacute", strings.natcmp("É", "é"), -1)
    fails += ck("fold sigma", strings.natcmpFold("Σ", "σ"), 0)
    fails += ck("fold sigma final", strings.natcmpFold("ς", "σ"), -1)
    fails += ck("fold cyrillic", strings.natcmpFold("Ж", "ж"), 0)
    fails += ck("fold fullwidth", strings.natcmpFold("Ａ", "ａ"), 0)
    fails += ck("fold cjk unchanged", strings.natcmpFold("中", "中"), 0)
    // U+0130 is Rust to_lowercase's only multi-character expansion ("i" plus
    // U+0301). This build deliberately leaves it unfolded: it compares as
    // U+0130, after ASCII, where the reference folds it to "i"+dot (so its
    // "İ" vs "j" is Less, ours Greater). Pinned as the documented divergence.
    fails += ck("fold dotted I self", strings.natcmpFold("İ", "İ"), 0)
    fails += ck("natcmp dotted I j", strings.natcmp("İ", "j"), 1)
    fails += ck("fold dotted I j unfolded", strings.natcmpFold("İ", "j"), 1)
    // Rust char::is_whitespace: NBSP, NEL, EM SPACE and IDEOGRAPHIC SPACE are
    // skipped like ASCII space
    let nbsp = b2(0xc2, 0xa0)
    let nel = b2(0xc2, 0x85)
    let emsp = b3(0xe2, 0x80, 0x83)
    let ideosp = b3(0xe3, 0x80, 0x80)
    fails += ck("utf8 nbsp skip", strings.natcmp(&("a" + nbsp + "b"), "a b"), 0)
    fails += ck("utf8 nel skip", strings.natcmpFold(&("a" + nel + "b"), "ab"), 0)
    fails += ck("utf8 emsp skip", strings.natcmp(&("a" + emsp + "b"), "a\tb"), 0)
    fails += ck("utf8 ideosp skip", strings.natcmpFold(&("a" + ideosp + "b"), " ab"), 0)
    // invalid bytes compare as the U+FFFD that lossy() would produce; two
    // different invalid sequences are equal, and U+FFFD sorts after ASCII
    let lone = b1(0xff)
    let cont = b1(0x80)
    fails += ck("utf8 invalid equal", strings.natcmp(&lone, &cont), 0)
    fails += ck("utf8 invalid vs z", strings.natcmp(&lone, "z"), 1)
    fails += ck("utf8 invalid vs z fold", strings.natcmpFold(&cont, "z"), 1)
    fails += ck("utf8 invalid prefix", strings.natcmp(&(b2(0xff, 0x41)), "A"), 1)
    fails += ck("utf8 invalid suffix", strings.natcmp(&(b2(0x41, 0xff)), "A"), 1)

    if fails > 0 {
        println(fails.toStr() + " failures")
        exit(1)
    }
    println("strings natcmp ok")
}
