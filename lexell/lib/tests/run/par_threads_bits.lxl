// par.threads() reports worker count without starting the pool, and math.bitsOf/fromBits work in par.map.
// expect: ok
import "par"
import "math"

fn main() {
    let n = par.threads()
    if n < 1 { panic("par.threads < 1") }
    var xs: []float = []
    for i in 0..256 { append(mut &xs, float(i) + 0.5f) }
    let ys = par.map(&xs, fn(x: &float): float {
        return math.fromBits(math.bitsOf(x))
    })
    for i in 0..len(xs) {
        if ys[i] != xs[i] { panic("mismatch") }
    }
    println("ok")
}
