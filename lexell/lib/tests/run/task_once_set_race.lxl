// The race getOrSet avoids: check-then-set across a suspension. Two tasks find the set-once global
// empty, both build a value, and the second set stops the program (exit 12; SPEC 5.2).
// exit: 12
import "task"
type Zones = record { names: []str; loads: int }
fn (z: mut &Zones) drop() { println("drop zones " + z.loads.toStr()) }
var ZONES: once Zones
var LOADS: once task.Shared[int]
fn zones(): &Zones {
    if !ZONES.isSet() {
        var k = 0
        LOADS.get().with(fn(n) { n += 1; k = n })
        match task.sleep(5) { Ok(_) { } Err(_) { } }       // suspends: another task also finds ZONES empty
        ZONES.set(Zones{names: ["UTC" + "", "CET" + ""], loads: k})
    }
    return ZONES.get()
}
fn worker(i: int): int { return len(zones().names) + i }
fn main() {
    LOADS.set(task.shared(0))
    let r = task.scoped(fn(s: mut &task.Scope): int {
        var fs: []task.Future[int] = []
        for i in 0..3 { append(mut &fs, s.start(worker, i)) }
        return match task.all(fs) { Ok(xs) { len(xs) } Err(_) { -1 } }
    })
    println("first value kept: loads " + zones().loads.toStr())
    var total = 0
    LOADS.get().with(fn(n) { total = n })
    println("f ran " + total.toStr() + " times")
}
