// fmt: decimal digit count and right-aligned padding, eza's permission
// string for every type and setuid/setgid/sticky, and writePadded's bytes
// through an io.Writer.
// expect: 1 1 1 2 2 3 6 7
// expect: 0| 0|    7|42|1000001|  999999
// expect: .rw-r--r-- drwxr-xr-x lrwxrwxrwx |rw-r--r-- srwxr-xr-x .rwsr-xr-x .rwxr-sr-x drwxrwxrwt .rw-r--r-T brw-r--r-- crw-r--r-- ?---------
// expect: 0|    7|1000001
import "fmt"
import "io"

// One padded sequence: width 0, a wider width, and a width already exceeded.
fn writeSeq(w: mut &io.Writer) {
    fmt.writePadded(w, 0, 0)
    w.write("|")
    fmt.writePadded(w, 7, 5)
    w.write("|")
    fmt.writePadded(w, 1000001, 6)
    w.write("\n")
}

fn main() {
    // digits: non-negative decimal width, digits(0) is 1
    var widths = ""
    for n in [0, 1, 9, 10, 99, 100, 999999, 1000001] {
        if len(widths) > 0 { widths += " " }
        widths += fmt.digits(n).toStr()
    }
    println(widths)

    // appendPadded: width 0 means no padding; a wider width is spaces first
    var pad: []byte = []
    fmt.appendPadded(mut &pad, 0, 0)
    append(mut &pad, '|')
    fmt.appendPadded(mut &pad, 0, 2)
    append(mut &pad, '|')
    fmt.appendPadded(mut &pad, 7, 5)
    append(mut &pad, '|')
    fmt.appendPadded(mut &pad, 42, 1)
    append(mut &pad, '|')
    fmt.appendPadded(mut &pad, 1000001, 6)
    append(mut &pad, '|')
    fmt.appendPadded(mut &pad, 999999, 8)
    println(strFromBytes(&pad))

    // modeString: the nine design examples, then block, char and unknown
    println(fmt.modeString(0x81A4) + " " + fmt.modeString(0x41ED) + " " +
        fmt.modeString(0xA1FF) + " " + fmt.modeString(0x11A4) + " " +
        fmt.modeString(0xC1ED) + " " + fmt.modeString(0x89ED) + " " +
        fmt.modeString(0x85ED) + " " + fmt.modeString(0x43FF) + " " +
        fmt.modeString(0x83A4) + " " + fmt.modeString(0x61A4) + " " +
        fmt.modeString(0x21A4) + " " + fmt.modeString(0))

    // writePadded through a file Writer, read back and printed byte for byte
    let path = "fmt_pad.bin"
    var w = io.create(path).unwrap()
    writeSeq(mut &w)
    w.close().unwrap()
    print(io.read(path).unwrap())
}
