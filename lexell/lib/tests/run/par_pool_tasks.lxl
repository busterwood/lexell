// par: the task that calls par.map waits for its items; other tasks run
// meanwhile, and the map's results are the loop's.
// expect: ticks done
// expect: 332833500
import "par"
import "task"

fn tick(n: int): int {
    for i in 0..n { let r = task.sleep(1) }
    return n
}

fn heavy(x: &int): int {
    var s = 0
    for i in 0..20000 { s += (i * x) % 7 }
    return s - s + x * x
}

fn main() {
    var xs: []int = []
    for i in 0..1000 { append(mut &xs, i) }
    task.scope(fn(s: mut &task.Scope) {
        let f = s.start(tick, 5)
        let ys = par.map(&xs, heavy)
        var t = 0
        for y in ys { t += y }
        let n = f.wait().unwrap()
        println("ticks done")
        println(t.toStr())
    })
}
