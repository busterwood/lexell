// base64: the RFC 4648 section 10 vectors, every byte value, the strict and
// lenient decoders, and a round trip.
// expect: rfc [] [Zg==] [Zm8=] [Zm9v] [Zm9vYg==] [Zm9vYmE=] [Zm9vYmFy]
// expect: binary 
// expect: binary strict true
// expect: strict Some(f) Some(foobar) Some()
// expect: strict rejects true true true true true true true true
// expect: lenient Ok(f) Ok(foo) Ok(a) Ok(a) Ok(abcd) Ok(a) Ok()
// expect: lenient rejects Err(is not valid base64 data) Err(trailing base64 byte found)
// expect: round trip true
import "strings"

import "base64"

fn opt(r: Option[str]): str {
    match r {
        Some(v) { return "Some(" + v + ")" }
        None { return "None" }
    }
}

fn res(r: Result[str, str]): str {
    match r {
        Ok(v) { return "Ok(" + v + ")" }
        Err(e) { return "Err(" + e + ")" }
    }
}

fn main() {
    // RFC 4648 section 10
    var rfc = ""
    for v in ["", "f", "fo", "foo", "foob", "fooba", "foobar"] { rfc = rfc + "[" + base64.encode(v) + "] " }
    println("rfc " + strings.trim(rfc))

    // every byte value, as one binary string
    var all = ""
    for i in 0..256 { all = all + strFromBytes(&[byte(i)]) }
    let enc = base64.encode(all)
    println("binary " + enc)
    println("binary strict " + (base64.decodeStrict(enc).unwrapOr("?") == all).toStr())

    println("strict " + opt(base64.decodeStrict("Zg==")) + " " + opt(base64.decodeStrict("Zm9vYmFy")) + " " +
        opt(base64.decodeStrict("")))

    // unpadded, a short group, white space, a misplaced "=", trailing data
    println("strict rejects " + base64.decodeStrict("Zg").isNone().toStr() + " " +
        base64.decodeStrict("Zg=").isNone().toStr() + " " + base64.decodeStrict("Zm9vYg=").isNone().toStr() + " " +
        base64.decodeStrict("Zm9v ").isNone().toStr() + " " + base64.decodeStrict("Zm9v\n").isNone().toStr() + " " +
        base64.decodeStrict("Z=9v").isNone().toStr() + " " + base64.decodeStrict("Zg==Zg==").isNone().toStr() + " " +
        base64.decodeStrict("Zm9-").isNone().toStr())

    println("lenient " + res(base64.decodeLenient("Zg")) + " " + res(base64.decodeLenient("Zm9v")) + " " +
        res(base64.decodeLenient("YQ==")) + " " + res(base64.decodeLenient("YQ")) + " " +
        res(base64.decodeLenient("YWJjZA=")) + " " + res(base64.decodeLenient("YQ==junk")) + " " +
        res(base64.decodeLenient("=")))

    println("lenient rejects " + res(base64.decodeLenient("!!!")) + " " + res(base64.decodeLenient("Y")))

    var round = true
    for v in ["", "f", "fo", "foo", "foob", "fooba", "foobar", all] {
        if base64.decodeStrict(base64.encode(v)).unwrapOr("?") != v { round = false }
    }
    println("round trip " + round.toStr())
}
