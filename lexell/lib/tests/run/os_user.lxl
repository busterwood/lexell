// os: the real and effective ids, the user database, tempDir, and the
// existing userName/homeDir. No particular system user name is assumed.
// expect: effective ids are non-negative: true
// expect: uid matches the passwd entry: true
// expect: gid matches the passwd entry: true
// expect: userById(uid) is Some: true
// expect: userByName finds it: true
// expect: users has the uid: true
// expect: tempDir is absolute: true
// expect: TMPDIR is honored: true
// expect: a relative TMPDIR falls back: true
// expect: userName not empty: true
// expect: HOME set: /some/where
// expect: HOME empty is the passwd directory: true
// expect: HOME unset is the passwd directory: true
// expect: passwd directory is absolute: true
// expect: userName is USER: true
import "os"

fn main() {
    let u = os.uid()
    let g = os.gid()
    let eu = os.effectiveUid()
    println("effective ids are non-negative: " + (eu >= 0 && os.effectiveGid() >= 0).toStr())

    match os.userById(u) {
        Some(byId) {
            println("uid matches the passwd entry: " + (byId.uid == u).toStr())
            println("gid matches the passwd entry: " + (byId.gid == g).toStr())
            println("userById(uid) is Some: true")
            match os.userByName(byId.name) {
                Some(byName) { println("userByName finds it: " + (byName.uid == u).toStr()) }
                None { println("userByName finds it: false") }
            }
        }
        None {
            println("uid matches the passwd entry: false")
            println("gid matches the passwd entry: false")
            println("userById(uid) is Some: false")
            println("userByName finds it: false")
        }
    }

    var has = false
    for x in os.users() { if x.uid == u { has = true } }
    println("users has the uid: " + has.toStr())

    let t = os.tempDir()
    println("tempDir is absolute: " + (len(t) > 0 && t[0] == '/').toStr())
    os.setEnv("TMPDIR", "/lexell/tmp/test").unwrap()
    println("TMPDIR is honored: " + (os.tempDir() == "/lexell/tmp/test").toStr())
    os.setEnv("TMPDIR", "relative").unwrap()
    println("a relative TMPDIR falls back: " + (os.tempDir() == "/tmp").toStr())

    let name = os.userName()
    println("userName not empty: " + (len(name) > 0).toStr())
    os.setEnv("HOME", "/some/where").unwrap()
    println("HOME set: " + os.homeDir())
    os.setEnv("HOME", "").unwrap()
    let fromPasswd = os.homeDir()
    println("HOME empty is the passwd directory: " + (len(fromPasswd) > 0).toStr())
    os.unsetEnv("HOME").unwrap()
    println("HOME unset is the passwd directory: " + (os.homeDir() == fromPasswd).toStr())
    println("passwd directory is absolute: " + (len(fromPasswd) > 0 && fromPasswd[0] == '/').toStr())
    match os.env("USER") {
        Some(user) { println("userName is USER: " + (user == name).toStr()) }
        None { println("userName is USER: true") }      // no $USER: nothing to compare
    }
}
