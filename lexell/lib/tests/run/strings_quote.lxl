// strings: eza's QuoteSpaces escaping and parentPrefix. Ported from
// archive/obo/tests/stdlib/strings_quote.obx; controls are built with
// strFromBytes because a source literal cannot spell them all. Each \u{h} is
// closed before the next byte (ESC between x and y is x\u{1b}y), quotes wrap
// the escaped text without escaping embedded quotes, and both outer styles are
// pinned.
// expect: strings quote ok
import "strings"

fn b1(b: byte): str { return strFromBytes(&[byte(b)]) }

fn ckStr(label: str, got: str, want: str): int {
    if got != want {
        println("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        return 1
    }
    return 0
}

fn ckBool(label: str, got: bool, want: bool): int {
    if got != want {
        println("FAIL " + label + ": got " + got.toStr() + " want " + want.toStr())
        return 1
    }
    return 0
}

fn main() {
    var fails = 0

    // the plain table with quoteSpaces=true
    fails += ckStr("quote plain", strings.quoteName("plain", true), "plain")
    fails += ckStr("quote space", strings.quoteName("a b", true), "'a b'")
    fails += ckStr("quote apostrophe", strings.quoteName("it's", true), "\"it's\"")
    fails += ckStr("quote both", strings.quoteName("a b'c", true), "\"a b'c\"")
    fails += ckStr("quote dquote", strings.quoteName("a\"b c", true), "'a\"b c'")
    fails += ckStr("quote dquote apostrophe", strings.quoteName("a\"b'c d", true),
                   "\"a\"b'c d\"")
    fails += ckStr("quote backslash", strings.quoteName("back\\slash", true),
                   "back\\slash")
    fails += ckStr("quote tab", strings.quoteName("tab\there", true), "tab\\there")
    fails += ckStr("quote lf", strings.quoteName("line\nfeed", true), "line\\nfeed")
    fails += ckStr("quote cr", strings.quoteName("x\ry", true), "x\\ry")
    fails += ckStr("quote tab alone", strings.quoteName("\t", true), "\\t")
    fails += ckStr("quote dash", strings.quoteName("-dash", true), "-dash")
    fails += ckStr("quote space alone", strings.quoteName(" ", true), "' '")
    fails += ckStr("quote two spaces", strings.quoteName("a  b", true), "'a  b'")
    fails += ckStr("quote dquote alone", strings.quoteName("\"", true), "\"")

    // control bytes built from bytes: ESC, DEL, NUL, VT, FF, 0x1f and >= 0x80
    let esc = b1(0x78) + b1(27) + b1(0x79)
    fails += ckStr("quote esc", strings.quoteName(&esc, true), "x\\u{1b}y")

    let del = "del" + b1(127)
    fails += ckStr("quote del", strings.quoteName(&del, true), "del\\u{7f}")

    let nul = b1(0)
    fails += ckStr("quote nul", strings.quoteName(&nul, true), "\\u{0}")
    fails += ckStr("quote vt", strings.quoteName(&(b1(11)), true), "\\u{b}")
    fails += ckStr("quote ff", strings.quoteName(&(b1(12)), true), "\\u{c}")
    fails += ckStr("quote us", strings.quoteName(&(b1(31)), true), "\\u{1f}")

    let spEsc = "sp ace" + b1(27)
    fails += ckStr("quote spaced esc", strings.quoteName(&spEsc, true),
                   "'sp ace\\u{1b}'")

    let high = b1(255)
    fails += ckBool("quote high", strings.quoteName(&high, true) == high, true)
    let high2 = b1(128)
    fails += ckBool("quote high2", strings.quoteName(&high2, true) == high2, true)

    // quoteSpaces=false: no quotes, spaces and apostrophes raw, controls escaped
    fails += ckStr("noquote plain", strings.quoteName("plain", false), "plain")
    fails += ckStr("noquote space", strings.quoteName("a b", false), "a b")
    fails += ckStr("noquote apostrophe", strings.quoteName("it's", false), "it's")
    fails += ckStr("noquote both", strings.quoteName("a b'c", false), "a b'c")
    fails += ckStr("noquote dquote", strings.quoteName("a\"b c", false), "a\"b c")
    fails += ckStr("noquote tab", strings.quoteName("tab\there", false), "tab\\there")
    fails += ckStr("noquote lf", strings.quoteName("line\nfeed", false), "line\\nfeed")
    fails += ckStr("noquote cr", strings.quoteName("x\ry", false), "x\\ry")
    fails += ckStr("noquote esc", strings.quoteName(&esc, false), "x\\u{1b}y")
    fails += ckStr("noquote spaced esc", strings.quoteName(&spEsc, false), "sp ace\\u{1b}")
    fails += ckStr("noquote space alone", strings.quoteName(" ", false), " ")
    fails += ckStr("noquote tab alone", strings.quoteName("\t", false), "\\t")

    // parentPrefix: the whole parent is escaped once, then one separator
    fails += ckStr("prefix empty", strings.parentPrefix("", true), "")
    fails += ckStr("prefix empty noquote", strings.parentPrefix("", false), "")
    fails += ckStr("prefix root", strings.parentPrefix("/", true), "/")
    fails += ckStr("prefix root noquote", strings.parentPrefix("/", false), "/")
    fails += ckStr("prefix tmp", strings.parentPrefix("/tmp", true), "/tmp/")
    fails += ckStr("prefix tmp noquote", strings.parentPrefix("/tmp", false), "/tmp/")
    fails += ckStr("prefix spaced abs", strings.parentPrefix("/tmp/x y", true),
                   "'/tmp/x y'/")
    fails += ckStr("prefix spaced abs noquote", strings.parentPrefix("/tmp/x y", false),
                   "/tmp/x y/")
    fails += ckStr("prefix spaced", strings.parentPrefix("x y", true), "'x y'/")
    fails += ckStr("prefix spaced noquote", strings.parentPrefix("x y", false), "x y/")
    fails += ckStr("prefix spaced sub", strings.parentPrefix("x y/sub", true),
                   "'x y/sub'/")
    fails += ckStr("prefix spaced sub noquote", strings.parentPrefix("x y/sub", false),
                   "x y/sub/")
    fails += ckStr("prefix apostrophe", strings.parentPrefix("it's", true),
                   "\"it's\"/")
    fails += ckStr("prefix apostrophe noquote", strings.parentPrefix("it's", false),
                   "it's/")

    // composition with a quoted name: parent prefix, then the name
    fails += ckStr("compose tmp", strings.parentPrefix("/tmp", true) +
                   strings.quoteName("f", true), "/tmp/f")
    fails += ckStr("compose root", strings.parentPrefix("/", true) +
                   strings.quoteName("f", true), "/f")
    fails += ckStr("compose spaced parent", strings.parentPrefix("x y/sub", true) +
                   strings.quoteName("f", true), "'x y/sub'/f")
    fails += ckStr("compose both spaced", strings.parentPrefix("x y", true) +
                   strings.quoteName("a b", true), "'x y'/'a b'")
    // quoteName is a whole-string primitive: a whole path is escaped and
    // quoted as one unit; operand display composes parentPrefix + name.
    fails += ckStr("compose whole", strings.quoteName("x y/sub/link", true),
                   "'x y/sub/link'")

    if fails > 0 {
        println(fails.toStr() + " failures")
        exit(1)
    }
    println("strings quote ok")
}
