// realpath resolves a relative symlink chain, normalizes "." and "..", handles
// an absolute link target, returns ELOOP after more than 40 links, and passes
// a missing component's errno through.
// expect: chain true
// expect: normalize true
// expect: relative true
// expect: absolute true
// expect: loop 40 true
// expect: missing 2 true

import "io"
import "fs"
import "os"

fn check[T](r: Result[T, io.IoError]): T {
    match move(r) {
        Ok(v) { return v }
        Err(e) {
            eprintln("unexpected: " + e.toStr())
            exit(1)
        }
    }
}

fn main() {
    let base = "/tmp/lxl_lib_fs_realpath_" + os.pid().toStr()
    fs.removeAll(base)
    check(fs.mkdirAll(fs.join(base, "real/sub")))
    check(io.write(fs.join(base, "real/sub/file.txt"), "x"))
    let expected = check(fs.realpath(fs.join(base, "real/sub/file.txt")))
    check(fs.symlink("real/sub/file.txt", fs.join(base, "link1")))
    check(fs.symlink("link1", fs.join(base, "link2")))
    check(fs.symlink(expected, fs.join(base, "abs")))
    check(fs.symlink("self", fs.join(base, "self")))

    println("chain " + (check(fs.realpath(fs.join(base, "link2"))) == expected).toStr())
    println("normalize " +
        (check(fs.realpath(base + "/real/./sub/../sub/file.txt")) == expected).toStr())

    let old = os.cwd()
    match os.setCwd(base) {
        Ok(_) {}
        Err(e) {
            eprintln("setCwd: " + e.toStr())
            exit(1)
        }
    }
    let rel = check(fs.realpath("link2"))
    match os.setCwd(old) {
        Ok(_) {}
        Err(e) {
            eprintln("setCwd back: " + e.toStr())
            exit(1)
        }
    }
    println("relative " + (rel == expected).toStr())
    println("absolute " + (check(fs.realpath(fs.join(base, "abs"))) == expected).toStr())

    let loopErr = match fs.realpath(fs.join(base, "self")) {
        Ok(_) { -1 }
        Err(e) { e.errno }
    }
    println("loop 40 " + (loopErr == 40).toStr())
    let missingErr = match fs.realpath(fs.join(base, "absent")) {
        Ok(_) { -1 }
        Err(e) { e.errno }
    }
    println("missing 2 " + (missingErr == 2).toStr())

    check(fs.removeAll(base))
}
