// Decimal fast paths: cmp when the exponents match, and div when the scaled
// dividend and the divisor fit in 64 bits, next to cases that take the general
// path (mixed scales, 19-digit operands, the 64-bit boundary). Expected values
// are Python's exact decimal module (quantize with ROUND_HALF_EVEN for div).
// expect: 16 cases ok

var bad: int = 0

fn d(s: str): Decimal { return Decimal.parse(&s).unwrap() }

fn txt(r: Result[Decimal, DecError]): str {
    match r {
        Ok(v) { return v.toStr() }
        Err(e) { return "e" + e.code().toStr() }
    }
}

fn chk(what: str, got: str, want: str) {
    if got != want {
        println("FAIL " + what + ": got " + got + ", want " + want)
        bad += 1
    }
}

fn main() {
    // cmp: equal exponents (fast path) and mixed exponents (general path)
    chk("cmp 12.5 12.50", d("12.5").cmp(&d("12.50")).toStr(), "0")
    chk("cmp 1.5 1.25", d("1.5").cmp(&d("1.25")).toStr(), "1")
    chk("cmp -1.5 -1.25", d("-1.5").cmp(&d("-1.25")).toStr(), "-1")
    chk("cmp 0.10 0.1", d("0.10").cmp(&d("0.1")).toStr(), "0")
    chk("cmp 123.45 123.46", d("123.45").cmp(&d("123.46")).toStr(), "-1")
    chk("cmp -123.45 -123.46", d("-123.45").cmp(&d("-123.46")).toStr(), "1")
    chk("cmp 9999999999999999999.99 9999999999999999999.98", d("9999999999999999999.99").cmp(&d("9999999999999999999.98")).toStr(), "1")
    chk("cmp -9999999999999999999.99 -9999999999999999999.98", d("-9999999999999999999.99").cmp(&d("-9999999999999999999.98")).toStr(), "-1")
    chk("cmp 0.00 -0.00", d("0.00").cmp(&d("-0.00")).toStr(), "0")
    chk("cmp -5 5", d("-5").cmp(&d("5")).toStr(), "-1")

    // div: fast path (dividend times 10^scale fits 64 bits, divisor too)
    chk("div 123456789012.34 654321.5 2", txt(d("123456789012.34").div(d("654321.5"), 2, Rounding.HALF_EVEN)), "188679.10")
    chk("div 1.5 4 2", txt(d("1.5").div(d("4"), 2, Rounding.HALF_EVEN)), "0.38")
    chk("div 3.7 0.3 3", txt(d("3.7").div(d("0.3"), 3, Rounding.HALF_EVEN)), "12.333")
    // general path: 19-digit operands, and the 64-bit boundary (184467440737095517 * 100 > 2^64 - 1)
    chk("div 1234567890123456789 9876543210987654 2", txt(d("1234567890123456789").div(d("9876543210987654"), 2, Rounding.HALF_EVEN)), "125.00")
    chk("div 184467440737095517 7 2", txt(d("184467440737095517").div(d("7"), 2, Rounding.HALF_EVEN)), "26352491533870788.14")
    chk("div 184467440737095516 7 2", txt(d("184467440737095516").div(d("7"), 2, Rounding.HALF_EVEN)), "26352491533870788.00")

    println((16 - bad).toStr() + " cases ok")
}
