// hash.crc32c: the check value and the iSCSI vectors (RFC 3720 B.4); every
// length from 0 to 300 at offsets 0 to 15 against a table-driven reference
// (the hardware path's 8-byte steps and its tail); crc32cMore across every
// split of a buffer; an empty slice.
// expect: e3069283
// expect: 8a9136aa 62a8ab43 46dd794e 113fdb5c
// expect: lengths ok 4816
// expect: splits ok 301
// expect: empty 0
import "hash"
import "strings"

fn hex(c: u32): str { return strings.padLeft(&(strings.hex(int(c))), 8, '0') }

fn reference(b: &[byte]): u32 {
    var t: []u32 = []
    for i in 0..256 {
        var c = u32(i)
        for k in 0..8 { if c & 1 == 1 { c = (c >> 1) ^ 0x82F63B78 } else { c = c >> 1 } }
        append(mut &t, c)
    }
    var c: u32 = 0xFFFFFFFF
    for x in b { c = t[int((c ^ u32(x)) & 0xFF)] ^ (c >> 8) }
    return c ^ 0xFFFFFFFF
}

fn main() {
    let v = "123456789"
    var nine: []byte = []
    for i in 0..len(v) { append(mut &nine, v[i]) }
    println(hex(hash.crc32c(&nine)))
    let zeros = array(32, byte(0))
    let ones = array(32, byte(0xFF))
    var up: []byte = []
    var down: []byte = []
    for i in 0..32 {
        append(mut &up, byte(i))
        append(mut &down, byte(31 - i))
    }
    println(hex(hash.crc32c(&zeros)) + " " + hex(hash.crc32c(&ones)) + " " + hex(hash.crc32c(&up)) + " " + hex(hash.crc32c(&down)))
    var data: []byte = []
    var x: u64 = 88172645463325252
    for i in 0..320 {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        append(mut &data, byte(int(x & 0xFF)))
    }
    var ok = 0
    for from in 0..16 {
        for n in 0..301 {
            if from + n <= len(data) && hash.crc32c(&data[from..from + n]) == reference(&data[from..from + n]) { ok += 1 }
        }
    }
    println("lengths ok " + ok.toStr())
    let whole = hash.crc32c(&data[0..300])
    var splits = 0
    for k in 0..301 {
        if hash.crc32cMore(hash.crc32c(&data[0..k]), &data[k..300]) == whole { splits += 1 }
    }
    println("splits ok " + splits.toStr())
    let none: []byte = []
    println("empty " + hash.crc32c(&none).toStr())
}
