// Decimal mul, div and cmp: the 64-bit fast paths and the general paths they fall back to,
// at the edges (coefficients about 2^63, products with trailing zeros, exponents near the
// limits, the display-scale cap, every rounding mode, ties, signs).
// expect: 0 11330577356960322779
// expect: 1 5704562894130947319
// expect: -1 6467218898074666581
// expect: 2 2919446388494817755
// expect: 5 1607064157094232479
// expect: -5 14076514854847556927
// expect: 25 12327372740829993529
// expect: 4 12719501511304730496
// expect: 125 14663984759692109991
// expect: 8 8381812217263495319
// expect: 0.5 13510137458146599339
// expect: -0.25 16934275488213673049
// expect: 1.5 13964167191754546520
// expect: 12.34 13820840354468555990
// expect: -98.765 8267451024827477809
// expect: 9223372036854775807 5035844406569834156
// expect: -9223372036854775807 15895346983108086035
// expect: 9223372036854775808 17450975664152506068
// expect: -9223372036854775808 10013567735536140826
// expect: 922337203685477580.7 16828651634264370919
// expect: 0.000000009223372036854775807 5702948787573711521
// expect: 99999999999999999999 17429450473858957459
// expect: 1000000000 10903243859364262747
// expect: 1E+20 16093005383118245773
// expect: 3.000 1614789209485905306
// expect: 123456.7890 1582250023816698250
// expect: -0.001 10536777846800278623
// expect: 4294967296 16818478076707146825
// expect: 18446744073709551615 9022041526693358154
// expect: 1E-32760 17105691337451297768
// expect: 1E+32760 13088036045194651870
// expect: 7E-30000 6803804048193037746
// expect: 12345678901234567890123456789012345678 18383528155197524658
// expect: 0.00000000000000000001 7300640934414755674
// expect: 6.25E-10 3460132766019731861
// expect: -1.6E+10 9332198313407414472
fn d(s: &str): Decimal {
    match Decimal.parse(s) {
        Ok(x) { return x }
        Err(e) { println("bad " + s); return Decimal.zero() }
    }
}
fn show(x: Decimal): str { return x.toStr() + "/" + x.scale().toStr() }
fn mulOf(a: Decimal, b: Decimal): str {
    match a.mulExact(b) {
        Ok(r) { return show(r) + "=" + show(a * b) }
        Err(e) { return "E" + e.code().toStr() }
    }
}
fn main() {
    let vs: []str = ["0", "1", "-1", "2", "5", "-5", "25", "4", "125", "8", "0.5", "-0.25", "1.5", "12.34", "-98.765", "9223372036854775807", "-9223372036854775807", "9223372036854775808", "-9223372036854775808", "922337203685477580.7", "0.000000009223372036854775807", "99999999999999999999", "1000000000", "1E+20", "3.000", "123456.7890", "-0.001", "4294967296", "18446744073709551615", "1E-32760", "1E+32760", "7E-30000", "12345678901234567890123456789012345678", "0.00000000000000000001", "6.25E-10", "-1.6E+10"]
    let modes: []Rounding = [Rounding.HALF_EVEN, Rounding.HALF_AWAY, Rounding.HALF_TOWARD_ZERO, Rounding.TOWARD_ZERO, Rounding.AWAY, Rounding.FLOOR, Rounding.CEILING, Rounding.UNNECESSARY]
    var h: u64 = 0
    var lines = 0
    for x in vs {
        let a = d(&x)
        var row = ""
        for y in vs {
            let b = d(&y)
            row = row + " " + mulOf(a, b) + " " + (a.cmp(&b) + 1).toStr()
            for sc in [0, 2, 7, 19, 30] {
                for m in modes {
                    match a.div(b, sc, m) {
                        Ok(q) { row = row + " " + show(q) }
                        Err(e) { row = row + " E" + e.code().toStr() }
                    }
                }
            }
        }
        for i in 0..len(row) { h = h *% 1099511628211 ^ u64(strByte(row, i)) }
        println(x + " " + h.toStr())
    }
}
