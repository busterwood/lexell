// time: Duration, Period and Interval (their ISO 8601 text both ways, signs,
// rounding), and the arithmetic's edge cases: month ends, around the clock,
// before the epoch.
// expect: PT0S PT1H30M PT1.5S PT-1.5S PT25H PT0.000000001S PT-1H-1M-1.000000001S
// expect: PT1H30M PT26H PT-1H PT-30M PT1M30.25S PT-0.5S
// expect: bad: P PT 1H PT1.5H P1M PT1S1M PT1H2H PTS P1DT
// expect: P1Y2M3D P0D P-1Y2M P14D P1Y2M3D P1Y2M
// expect: bad: P1H PT1H P1.5D P1D1Y
// expect: P1Y2M3DT4H5M6.5S PT0S P-1Y-2M-3DT-4H P10M PT1H P1Y2M3DT4H5M6.5S
// expect: plus P1Y3M4DT4H5M7.5S neg P-1Y-2M-3DT-4H-5M-6.5S
// expect: round 2 -2 1 0.000002 -0.000002 0.000001
// expect: until P1M1D P-1M-1D P1Y P0D P11M30D -60 P-1M-29D
// expect: months 2024-02-29 2025-02-28 2024-04-30 2023-12-31 2028-02-29
// expect: clock 01:00:00 23:00:00 00:00:00 12:00:00.5
// expect: micros 1969-12-31T23:59:59.999999 -1 1 1000000
// expect: instant 2026-11-11T10:00:00.5 diff PT1H30M -PT1H30M PT-1H-30M
// expect: zone 2026-07-01T13:00:00+01:00 2026-01-01T12:00:00+00:00

import "time"
import "tz"

fn dp(s: str): str {
    match time.parseDuration(s) {
        Some(d) { return d.toStr() }
        None { return "none" }
    }
}

fn pp(s: str): str {
    match time.parsePeriod(s) {
        Some(p) { return p.toStr() }
        None { return "none" }
    }
}

fn ip(s: str): str {
    match time.parseInterval(s) {
        Some(i) { return i.toStr() }
        None { return "none" }
    }
}

fn bad(xs: &[]str, f: fn(str): str): str {
    var out = "bad:"
    for x in xs {
        if f(x) == "none" { out = out + " " + x } else { out = out + " [" + x + " parsed]" }
    }
    return out
}

fn d(s: str): time.Date { return time.parseDate(s).unwrap() }

fn secs(x: time.Duration): str {
    // seconds with a fraction, signed, trailing zeros dropped
    let neg = x.isNegative()
    let a = x.abs()
    var f = ""
    if a.nsec != 0 {
        var s = intToStr(a.nsec + 1000000000)
        s = strSlice(s, 1, 10)
        var n = 9
        while strByte(s, n - 1) == '0' { n -= 1 }
        f = "." + strSlice(s, 0, n)
    }
    return (if neg { "-" } else { "" }) + intToStr(a.sec) + f
}

fn main() {
    println(time.ZERO_DURATION.toStr() + " " + time.minutes(90).toStr() + " " + time.millis(1500).toStr() + " " +
            time.millis(-1500).toStr() + " " + time.hours(25).toStr() + " " + time.nanos(1).toStr() + " " +
            time.duration(-3661, -1).toStr())
    println(dp("PT1H30M") + " " + dp("P1DT2H") + " " + dp("-PT1H") + " " + dp("PT-1H30M") + " " + dp("pt1m30.25s") + " " + dp("PT-0.5S"))
    println(bad(&["P", "PT", "1H", "PT1.5H", "P1M", "PT1S1M", "PT1H2H", "PTS", "P1DT"], dp))
    println(time.period(1, 2, 3).toStr() + " " + time.period(0, 0, 0).toStr() + " " + time.period(-1, 2, 0).toStr() + " " +
            pp("P2W") + " " + pp("P1Y2M3D") + " " + time.period(0, 14, 0).normalized().toStr())
    println(bad(&["P1H", "PT1H", "P1.5D", "P1D1Y"], pp))
    let iv = time.interval(14, 3, time.duration(4 * 3600 + 5 * 60 + 6, 500000000))
    println(iv.toStr() + " " + time.ZERO_INTERVAL.toStr() + " " + ip("-P1Y2M3DT4H") + " " + ip("P1Y-2M") + " " +
            time.hours(1).toInterval().toStr() + " " + ip("P1Y2M3DT4H5M6.5S"))
    println("plus " + iv.plus(time.interval(1, 1, time.seconds(1))).toStr() + " neg " + iv.neg().toStr())
    // halves away from zero, to whole seconds and to microseconds
    let us = 1000
    println("round " + secs(time.millis(1500).roundTo(1000000000)) + " " + secs(time.millis(-1500).roundTo(1000000000)) + " " +
            secs(time.duration(1, 499999999).roundTo(1000000000)) + " " + secs(time.nanos(1500).roundTo(us)) + " " +
            secs(time.nanos(-1500).roundTo(us)) + " " + secs(time.nanos(1499).roundTo(us)))
    println("until " + d("2026-01-31").until(d("2026-03-01")).toStr() + " " + d("2026-03-01").until(d("2026-01-31")).toStr() + " " +
            d("2024-02-29").until(d("2025-02-28")).toStr() + " " + d("2026-05-05").until(d("2026-05-05")).toStr() + " " +
            d("2025-01-01").until(d("2025-12-31")).toStr() + " " + d("2026-03-01").daysUntil(d("2025-12-31")).toStr() + " " +
            d("2026-10-31").until(d("2026-09-01")).toStr())
    println("months " + d("2024-01-31").addMonths(1).toStr() + " " + d("2024-02-29").addYears(1).toStr() + " " +
            d("2024-03-31").addMonths(1).toStr() + " " + d("2024-01-31").addMonths(-1).toStr() + " " +
            d("2024-02-29").addYears(4).toStr())
    let eleven = time.timeOfDay(23, 0, 0, 0).unwrap()
    let one = time.timeOfDay(1, 0, 0, 0).unwrap()
    println("clock " + eleven.plus(time.hours(2)).toStr() + " " + one.plus(time.hours(-2)).toStr() + " " +
            eleven.plus(time.hours(25 * 24 + 1)).toStr() + " " + time.MIDNIGHT.plus(time.millis(-43199500)).toStr())
    let before = time.fromMicros(-1)
    println("micros " + time.localOf(before).toStr() + " " + before.unixMicros().toStr() + " " + time.fromMicros(1).unixMicros().toStr() +
            " " + time.fromMicros(1000000).unixMicros().toStr())
    let l = time.parseLocalDateTime("2026-11-11T08:30:00.5").unwrap()
    let t0 = l.atUtc()
    let t1 = t0.plus(time.minutes(90))
    println("instant " + time.localOf(t1).toStr() + " diff " + t0.until(t1).toStr() + " " + ("-" + t1.until(t0).neg().toStr()) + " " +
            t1.until(t0).toStr())
    let z = tz.fromSpec("GMT0BST,M3.5.0/1,M10.5.0")
    let summer = z.instantOf(time.parseLocalDateTime("2026-07-01T13:00").unwrap())
    let winter = z.instantOf(time.parseLocalDateTime("2026-01-01T12:00").unwrap())
    println("zone " + z.offsetDateTime(summer).toStr() + " " + z.offsetDateTime(winter).toStr())
}
