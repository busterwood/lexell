// redis: live coverage for the wrappers the basic live test does not use:
// setEx, setNx, expire/ttl, hdel/hlen/hexists, rpop/llen, srem, SCAN,
// MULTI/EXEC, WATCH, binary values, pub/sub and a BLPOP read timeout.
// Skipped (exit 77) unless LXL_REDIS_LIVE=1 and a server answers; LXL_REDIS
// sets the URL (default redis://127.0.0.1:6379/15).
// expect: extra name lxl-extra
// expect: extra setex true v
// expect: extra setnx false true
// expect: extra expire true true
// expect: extra hash 2 true 1 1
// expect: extra list 2 b 1
// expect: extra set 1 true
// expect: extra scan true
// expect: extra publish 0
// expect: extra tx true [OK, 1] false
// expect: extra watch [OK]
// expect: extra bin 3 true
// expect: extra sub 3
// expect: extra pub 1
// expect: extra msg 3 hello
// expect: extra timeout timeout
import "os"
import "task"
import "redis"

fn opt(o: Option[str]): str { match o { Some(s) { return s } None { return "none" } } }

fn main() {
    if os.envOr("LXL_REDIS_LIVE", "") != "1" { exit(77) }
    let url = os.envOr("LXL_REDIS", "redis://127.0.0.1:6379/15")
    var cfg = match redis.parseUrl(&url) { Ok(x) { x } Err(_) { exit(77) } }
    cfg.clientName = "lxl-extra"
    var maybe: Option[redis.Conn] = None
    match redis.connectWith(&cfg) {
        Ok(x) { maybe = Some(x) }
        Err(_) { exit(77) }
    }
    var c = maybe.unwrap()
    let base = "lxl:extra:" + os.pid().toStr()
    let k1 = base + ":1"
    let k2 = base + ":2"
    let h = base + ":h"
    let l = base + ":l"
    let s = base + ":s"
    c.del(&[k1, k2, h, l, s]).unwrap()
    println("extra name " + opt(c.command(&["CLIENT", "GETNAME"]).unwrap().text()))
    c.setEx(&k1, "v", 60).unwrap()
    println("extra setex " + (c.ttl(&k1).unwrap() > 0).toStr() + " " + opt(c.get(&k1).unwrap()))
    println("extra setnx " + c.setNx(&k1, "x").unwrap().toStr() + " " + c.setNx(&k2, "x").unwrap().toStr())
    println("extra expire " + c.expire(&k2, 60).unwrap().toStr() + " " + (c.ttl(&k2).unwrap() > 0).toStr())
    c.hset(&h, "a", "1").unwrap()
    c.hset(&h, "b", "2").unwrap()
    println("extra hash " + c.hlen(&h).unwrap().toStr() + " " + c.hexists(&h, "a").unwrap().toStr() + " " +
            c.hdel(&h, &["a"]).unwrap().toStr() + " " + c.hlen(&h).unwrap().toStr())
    c.rpush(&l, &["a", "b"]).unwrap()
    println("extra list " + c.llen(&l).unwrap().toStr() + " " + opt(c.rpop(&l).unwrap()) + " " + c.llen(&l).unwrap().toStr())
    c.sadd(&s, &["a", "b"]).unwrap()
    println("extra set " + c.srem(&s, &["a"]).unwrap().toStr() + " " + c.sismember(&s, "b").unwrap().toStr())
    var cur = "0"
    var found = false
    while true {
        let page = c.scan(&cur, &(base + "*"), 10).unwrap()
        for x in page.keys { if x == k1 { found = true } }
        cur = page.cursor
        if cur == "0" { break }
    }
    println("extra scan " + found.toStr())
    println("extra publish " + c.publish(&(base + ":ch"), "nobody").unwrap().toStr())
    c.multi().unwrap()
    let tx = c.inTransaction()
    c.command(&["SET", k2, "1"]).unwrap()
    c.command(&["INCR", base + ":n"]).unwrap()
    let ex = c.exec().unwrap()
    println("extra tx " + tx.toStr() + " " + ex.toStr() + " " + c.inTransaction().toStr())
    c.command(&["WATCH", k1]).unwrap()
    c.multi().unwrap()
    c.command(&["SET", k1, "2"]).unwrap()
    let wx = c.exec().unwrap()
    println("extra watch " + wx.toStr())
    let bin = "a\0b"
    c.set(&(base + ":bin"), &bin).unwrap()
    let got = c.get(&(base + ":bin")).unwrap().unwrap()
    println("extra bin " + len(got).toStr() + " " + (got == bin).toStr())
    c.del(&[k1, k2, h, l, s, base + ":bin", base + ":n"]).unwrap()
    c.close()

    task.scope(fn(sc: mut &task.Scope) {
        var sub = redis.connectWith(&cfg).unwrap()
        var publisher = redis.connectWith(&cfg).unwrap()
        let conf = sub.subscribe(&[base + ":ch"]).unwrap()
        println("extra sub " + conf.count().toStr())
        println("extra pub " + publisher.publish(&(base + ":ch"), "hello").unwrap().toStr())
        let msg = sub.next().unwrap()
        let text = match msg {
            redis.Value.Push(xs) { if len(xs) == 3 { xs[2].toStr() } else { "" } }
            redis.Value.Array(xs) { if len(xs) == 3 { xs[2].toStr() } else { "" } }
            else { "" }
        }
        println("extra msg " + msg.count().toStr() + " " + text)
        sub.close()
        publisher.close()
    })

    var tc = cfg
    tc.timeoutMs = 20
    var t = redis.connectWith(&tc).unwrap()
    match t.command(&["BLPOP", base + ":none", "1"]) {
        Ok(_) { println("extra timeout ok") }
        Err(e) { println("extra timeout " + e.kind.toStr()) }
    }
    t.close()
}
