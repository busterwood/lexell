// uuid: RFC 9562 nil/max, parse (both forms and every error path), the byte
// conversion, deterministic v4From/v7At layouts, the RFC 4122 v5 DNS vector,
// Map keys with equal UUIDs, and unsigned 128-bit cmp/hash order.
// needs: ssl
// expect: nil 00000000-0000-0000-0000-000000000000 true
// expect: max ffffffff-ffff-ffff-ffff-ffffffffffff false
// expect: parse canonical 6ba7b810-9dad-11d1-80b4-00c04fd430c8
// expect: parse bare 6ba7b810-9dad-11d1-80b4-00c04fd430c8
// expect: parse upper 6ba7b810-9dad-11d1-80b4-00c04fd430c8
// expect: parse round true
// expect: parse errors uuid: length 35: want 36 or 32 | uuid: length 37: want 36 or 32 | uuid: hyphen expected at byte 8 | uuid: non-hex at byte 4 | uuid: length 0: want 36 or 32 | uuid: non-hex at byte 20 | uuid: length 37: want 36 or 32
// expect: fromBytes round true
// expect: fromBytes errors uuid: length 0: want 16 bytes | uuid: length 15: want 16 bytes | uuid: length 17: want 16 bytes
// expect: v4From 00010203-0405-4607-8809-0a0b0c0d0e0f 4 2
// expect: v4 4 2 true
// expect: v7At 018bcfe5-6800-7001-8203-040506070809 7 2
// expect: v7 order true
// expect: v5 2ed6657d-e927-568b-95e1-2665a8aea6a2
// expect: map 7 true 1
// expect: order true true true true true true
// expect: hash true true
// expect: version 15 0
// expect: variants 0 0 2 6 7
import "uuid"

fn msg(r: Result[uuid.Uuid, uuid.Error]): str {
    match r {
        Ok(u) { return u.toStr() }
        Err(e) { return e.toStr() }
    }
}

fn bytesEq(a: &[]byte, b: &[]byte): bool {
    if len(a) != len(b) { return false }
    for i in 0..len(a) {
        if a[i] != b[i] { return false }
    }
    return true
}

fn main() {
    let canonical = "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
    let bare = "6ba7b8109dad11d180b400c04fd430c8"
    let upper = "6BA7B810-9DAD-11D1-80B4-00C04FD430C8"

    let n = uuid.nil()
    let m = uuid.max()
    println("nil " + n.toStr() + " " + uuid.isNil(&n).toStr())
    println("max " + m.toStr() + " " + uuid.isNil(&m).toStr())

    let a = uuid.parse(canonical).unwrap()
    println("parse canonical " + a.toStr())
    println("parse bare " + uuid.parse(bare).unwrap().toStr())
    println("parse upper " + uuid.parse(upper).unwrap().toStr())
    println("parse round " + (uuid.parse(upper).unwrap().toStr() == canonical).toStr())

    let short = "6ba7b810-9dad-11d1-80b4-00c04fd430c"
    let long = canonical + "0"
    let misplaced = "6ba7b8109-dad-11d1-80b4-00c04fd430c8"
    let badhex = "6ba7g810-9dad-11d1-80b4-00c04fd430c8"
    let spaced = "6ba7b810-9dad-11d1-8 b4-00c04fd430c8"
    let leading = " " + canonical
    println("parse errors " + msg(uuid.parse(short)) + " | " + msg(uuid.parse(long)) + " | " +
        msg(uuid.parse(misplaced)) + " | " + msg(uuid.parse(badhex)) + " | " + msg(uuid.parse("")) + " | " +
        msg(uuid.parse(spaced)) + " | " + msg(uuid.parse(leading)))

    var bs: []byte = []
    for i in 0..16 { append(mut &bs, byte(i)) }
    let fromB = uuid.fromBytes(&bs).unwrap()
    println("fromBytes round " + bytesEq(&fromB.bytes(), &bs).toStr())
    var b15: []byte = []
    var b17: []byte = []
    for i in 0..15 { append(mut &b15, byte(i)) }
    for i in 0..17 { append(mut &b17, byte(i)) }
    var empty: []byte = []
    println("fromBytes errors " + msg(uuid.fromBytes(&empty)) + " | " + msg(uuid.fromBytes(&b15)) + " | " +
        msg(uuid.fromBytes(&b17)))

    let v4f = uuid.v4From(&bs).unwrap()
    println("v4From " + v4f.toStr() + " " + v4f.version().toStr() + " " + v4f.variant().toStr())
    let v4a = uuid.v4().unwrap()
    let v4b = uuid.v4().unwrap()
    println("v4 " + v4a.version().toStr() + " " + v4a.variant().toStr() + " " +
        (v4a.toStr() != v4b.toStr()).toStr())

    var tail: []byte = []
    for i in 0..10 { append(mut &tail, byte(i)) }
    let v7a = uuid.v7At(1700000000000, &tail).unwrap()
    println("v7At " + v7a.toStr() + " " + v7a.version().toStr() + " " + v7a.variant().toStr())
    let v7b = uuid.v7At(1700000000001, &tail).unwrap()
    println("v7 order " + (v7a.cmp(&v7b) < 0).toStr())

    match uuid.v5(&a, "www.example.com") {
        Ok(u) { println("v5 " + u.toStr()) }
        Err(e) { println("v5 error " + e.toStr()) }
    }

    var map: Map[uuid.Uuid, int] = newMap()
    let b = uuid.parse(bare).unwrap()
    map.put(a, 7)
    println("map " + map.get(&b).unwrapOr(-1).toStr() + " " + map.has(&a).toStr() + " " + map.size().toStr())

    let x = uuid.parse("00000000-0000-0000-0000-000000000001").unwrap()
    let y = uuid.parse("00000000-0000-0000-0000-000000000002").unwrap()
    let z = uuid.parse("80000000-0000-0000-0000-000000000000").unwrap()
    println("order " + (n.cmp(&x) < 0).toStr() + " " + (x.cmp(&y) < 0).toStr() + " " +
        (y.cmp(&z) < 0).toStr() + " " + (uuid.max().cmp(&z) > 0).toStr() + " " +
        (uuid.max().cmp(&n) > 0).toStr() + " " + (n.cmp(&n) == 0).toStr())

    println("hash " + (a.eq(&b)).toStr() + " " + (a.hash() == b.hash()).toStr())

    let vf = uuid.parse("00000000-0000-f000-8000-000000000000").unwrap()
    println("version " + vf.version().toStr() + " " + uuid.nil().version().toStr())

    let ncs = uuid.parse("00000000-0000-0000-7fff-000000000000").unwrap()
    let micro = uuid.parse("00000000-0000-0000-c000-000000000000").unwrap()
    let future = uuid.parse("00000000-0000-0000-e000-000000000000").unwrap()
    println("variants " + ncs.variant().toStr() + " " + uuid.nil().variant().toStr() + " " +
        a.variant().toStr() + " " + micro.variant().toStr() + " " + future.variant().toStr())
}
