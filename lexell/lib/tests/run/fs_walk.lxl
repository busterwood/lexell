// walk visits root and the tree below it, reports link kinds, honours a false
// return as "do not descend", follows a link to a directory only when asked,
// and skips (never loops on) a link back to a directory already walked.
// expect: root paths true
// expect: skip subtree true
// expect: follow links true
// expect: cycle skipped true

import "io"
import "fs"
import "os"

fn check[T](r: Result[T, io.IoError]): T {
    match move(r) {
        Ok(v) { return v }
        Err(e) {
            eprintln("unexpected: " + e.toStr())
            exit(1)
        }
    }
}

fn text(xs: &[str]): str {
    var s = ""
    for i in 0..len(xs) {
        if i > 0 { s += " " }
        s += xs[i]
    }
    return s
}

fn has(xs: &[str], x: str): bool {
    for y in xs {
        if y == x { return true }
    }
    return false
}

fn main() {
    let base = "/tmp/lxl_lib_fs_walk_" + os.pid().toStr()
    let root = fs.join(base, "root")
    let target = fs.join(base, "target")
    fs.removeAll(base)
    check(fs.mkdirAll(fs.join(root, "sub")))
    check(fs.mkdirAll(fs.join(root, "sub2")))
    check(fs.mkdirAll(target))
    check(io.write(fs.join(root, "a.txt"), "a"))
    check(io.write(fs.join(root, "sub/b.txt"), "b"))
    check(io.write(fs.join(root, "sub2/d.txt"), "d"))
    check(io.write(fs.join(target, "t.txt"), "t"))
    check(fs.symlink("../target", fs.join(root, "link")))
    check(fs.symlink(".", fs.join(root, "loop")))

    var seen: []str = []
    check(fs.walk(root, false, fn(p, e) {
        append(mut &seen, p)
        return true
    }))
    sort(mut &seen)
    var want: []str = [root, fs.join(root, "a.txt"), fs.join(root, "sub"),
        fs.join(root, "sub/b.txt"), fs.join(root, "sub2"), fs.join(root, "sub2/d.txt"),
        fs.join(root, "link"), fs.join(root, "loop")]
    sort(mut &want)
    println("root paths " + (text(&seen) == text(&want)).toStr())

    let skip = fs.join(root, "sub")
    var skipped: []str = []
    check(fs.walk(root, false, fn(p, e) {
        append(mut &skipped, p)
        return p != skip
    }))
    sort(mut &skipped)
    var wantSkip: []str = [root, fs.join(root, "a.txt"), skip,
        fs.join(root, "sub2"), fs.join(root, "sub2/d.txt"),
        fs.join(root, "link"), fs.join(root, "loop")]
    sort(mut &wantSkip)
    println("skip subtree " + (text(&skipped) == text(&wantSkip)).toStr())

    var followed: []str = []
    check(fs.walk(root, true, fn(p, e) {
        append(mut &followed, p)
        return true
    }))
    sort(mut &followed)
    var wantFollow: []str = [root, fs.join(root, "a.txt"), skip,
        fs.join(root, "sub/b.txt"), fs.join(root, "sub2"), fs.join(root, "sub2/d.txt"),
        fs.join(root, "link"), fs.join(root, "link/t.txt"),
        fs.join(root, "loop")]
    sort(mut &wantFollow)
    println("follow links " + (text(&followed) == text(&wantFollow)).toStr())
    println("cycle skipped " + (!has(&followed, fs.join(root, "loop/a.txt")) &&
        !has(&followed, fs.join(root, "loop/sub"))).toStr())

    check(fs.removeAll(base))
}
