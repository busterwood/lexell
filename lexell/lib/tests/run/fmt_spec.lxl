import "fmt"

fn main() {
    println(fmt.intFmt(42, "+06d").unwrap())
    println(fmt.intFmt(255, "#X").unwrap())
    println(fmt.uintFmt(u64(1024), "#b").unwrap())
    println(fmt.floatFmt(3.14159f, ".3f").unwrap())
    println(fmt.floatFmt(0.001234f, ".2e").unwrap())
    println(fmt.decimalFmt(98765.432m, ",.2f").unwrap())
    println(fmt.decimalFmt(98765.400m, "c").unwrap())
    println(fmt.strFmt("hi", "_^6").unwrap())
    println(fmt.strFmt("a\tb", "q").unwrap())

    println(fmt.apply("Hello, {}! You have {:>4} messages.", &["Ada", "12"]).unwrap())
    println(fmt.apply("{1} before {0} ({{{0}}})", &["first", "second"]).unwrap())

    // Errors
    println(fmt.intFmt(1, ".2f").isErr())
    println(fmt.strFmt("a", "x").isErr())
    println(fmt.apply("missing {}", &[]).isErr())
    println(fmt.apply("mix {} {0}", &["a"]).isErr())
    println(fmt.apply("bad } brace", &[]).isErr())
}
// expect: +00042
// expect: 0XFF
// expect: 0b10000000000
// expect: 3.142
// expect: 1.23e-03
// expect: 98,765.43
// expect: 98765.4
// expect: __hi__
// expect: "a\tb"
// expect: Hello, Ada! You have   12 messages.
// expect: second before first ({first})
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
