// time: strptime round trips, names, %s, %p, errors and the leftover decision.
// expect: 2024-02-29 13:45:07 2024-02-29T13:45:07 1709214307
// expect: 2024-02-29T13:45:07 1709214307
// expect: 2024-02-29T13:45:07 4 59
// expect: 13 0 12
// expect: 1970-01-01 00:00:00
// expect: bad date bad month bad text bad format
// expect: strict err rest 10 2024-01-02 junk
// expect: 2024-02-29T13:45:07 2024-02-29T00:00:00 2024-01-01T00:00:00
// expect: 2024-01-02T00:00:00 2024-01-02T00:00:00
import "time"

fn bad(s: str, fmt: str): bool {
    match time.strptime(&s, &fmt) {
        Ok(_) { return false }
        Err(_) { return true }
    }
}

fn hourOf(s: str, fmt: str): str {
    match time.strptime(&s, &fmt) {
        Ok(t) { return t.hour.toStr() }
        Err(_) { return "err" }
    }
}

fn main() {
    let a = time.strptime("2024-02-29 13:45:07", "%Y-%m-%d %H:%M:%S").unwrap()
    let l = time.localDateTimeOf(a).unwrap()
    println(time.strftime(&a, "%Y-%m-%d %H:%M:%S", "UTC") + " " + l.toStr() + " " + l.atUtc().sec.toStr())

    let z = time.strptime("2024-02-29T13:45:07Z", "%Y-%m-%dT%H:%M:%SZ").unwrap()
    println(time.localDateTimeOf(z).unwrap().toStr() + " " + time.strftime(&z, "%s", "UTC"))

    let n = time.strptime("Thu Feb 29 13:45:07 2024", "%a %b %e %H:%M:%S %Y").unwrap()
    println(time.localDateTimeOf(n).unwrap().toStr() + " " + n.wday.toStr() + " " + n.yday.toStr())

    println(hourOf("01:05:00 PM", "%I:%M:%S %p") + " " + hourOf("12:00:00 AM", "%I:%M:%S %p") + " " +
        hourOf("12:00:00 PM", "%I:%M:%S %p"))

    let e = time.strptime("0", "%s").unwrap()
    println(time.strftime(&e, "%F %T", "UTC"))

    println((if bad("2024-02-30", "%Y-%m-%d") { "bad date" } else { "BAD date" }) + " " +
        (if bad("2024-13-01", "%Y-%m-%d") { "bad month" } else { "BAD month" }) + " " +
        (if bad("not a date", "%Y-%m-%d") { "bad text" } else { "BAD text" }) + " " +
        (if bad("2024-01-02", "%Y/%m/%d") { "bad format" } else { "BAD format" }))

    let strict = bad("2024-01-02junk", "%Y-%m-%d")
    // strptime wants all of s; strptimePrefix reports where it stopped.
    let p = time.strptimePrefix("2024-01-02junk", "%Y-%m-%d").unwrap()
    let tail = strSlice("2024-01-02junk", p.rest, len("2024-01-02junk"))
    let spaced = bad("2024-01-02 ", "%Y-%m-%d")
    println("strict " + (if strict && spaced { "err" } else { "BAD" }) + " rest " + p.rest.toStr() + " " +
        time.strftime(&p.tm, "%F", "UTC") + " " + tail)

    let ft = time.strptime("2024-02-29 13:45:07", "%F %T").unwrap()
    let d = time.strptime("02/29/24", "%D").unwrap()
    let pct = time.strptime("01% 2024", "%d%% %Y").unwrap()
    println(time.localDateTimeOf(ft).unwrap().toStr() + " " + time.localDateTimeOf(d).unwrap().toStr() + " " +
        time.localDateTimeOf(pct).unwrap().toStr())

    let zn = time.strptime("2024-01-02 GMT", "%Y-%m-%d %Z").unwrap()
    let zo = time.strptime("2024-01-02 +05:30", "%Y-%m-%d %z").unwrap()
    println(time.localDateTimeOf(zn).unwrap().toStr() + " " + time.localDateTimeOf(zo).unwrap().toStr())
}
