// math.bitsOf/fromBits and the 32-bit variants against the IEEE 754 patterns,
// including signed zero, the infinities, NaN, subnormals, the largest finite
// value and the round-to-nearest-even edges.
// expect: 0000000000000000 8000000000000000 3ff0000000000000 bff8000000000000 400921f9f01b866e
// expect: 7ff0000000000000 fff0000000000000 7ff8000000000000 fff8000000000000 true true
// expect: 1 -0 5e-324 1.7976931348623157e308
// expect: 0000000000000001 000fffffffffffff
// expect: round trip 0
// expect: 00000000 80000000 3f800000 bfc00000 40490fd0 7f800000 ff800000 7fc00000 00000001
// expect: 1 -1.5 -0 inf true
// expect: 3f800000 3f800002 3f800001 7f800000
// expect: -1.5 3f800000 80000000
import "math"
import "strings"

fn word(n: int): str {
    return strings.padLeft(&(strings.hex(n & 0xffffffff)), 8, '0')
}

fn h64(b: int): str {
    return word(b >> 32) + word(b)
}

fn h32(b: i32): str {
    return word(int(b))
}

fn main() {
    let zero: float = 0.0f
    let one: float = 1.0f
    let m15: float = -1.5f
    let pi: float = 3.14159f
    println(h64(math.bitsOf(zero)) + " " + h64(math.bitsOf(-zero)) + " " + h64(math.bitsOf(one)) + " " +
        h64(math.bitsOf(m15)) + " " + h64(math.bitsOf(pi)))

    let pinf = math.inf()
    let ninf = -pinf
    let qnan = math.fromBits(0x7ff8000000000000)
    let nn = math.fromBits(-2251799813685248)
    println(h64(math.bitsOf(pinf)) + " " + h64(math.bitsOf(ninf)) + " " + h64(math.bitsOf(qnan)) + " " +
        h64(math.bitsOf(nn)) + " " + qnan.isNaN().toStr() + " " + nn.isNaN().toStr())

    let negZero = -9223372036854775807 - 1
    println(math.fromBits(0x3ff0000000000000).toStr() + " " + math.fromBits(negZero).toStr() + " " +
        math.fromBits(1).toStr() + " " + math.fromBits(0x7fefffffffffffff).toStr())

    println(h64(math.bitsOf(math.fromBits(1))) + " " + h64(math.bitsOf(math.fromBits(0x000fffffffffffff))))

    var bad = 0
    for b in [0, 1, -4616189618054758400, 0x3ff0000000000000, negZero, 0x7fefffffffffffff,
        0x7ff0000000000000, -2251799813685248, 0x7ff8000000000000, 0x000fffffffffffff,
        0x0000000000000001] {
        if math.bitsOf(math.fromBits(b)) != b { bad += 1 }
    }
    println("round trip " + intToStr(bad))

    println(h32(math.bitsOf32(zero)) + " " + h32(math.bitsOf32(-zero)) + " " + h32(math.bitsOf32(one)) + " " +
        h32(math.bitsOf32(m15)) + " " + h32(math.bitsOf32(pi)) + " " + h32(math.bitsOf32(pinf)) + " " +
        h32(math.bitsOf32(ninf)) + " " + h32(math.bitsOf32(math.fromBits32(i32(0x7fc00000)))) + " " +
        h32(math.bitsOf32(math.fromBits32(i32(1)))))

    println(math.fromBits32(i32(0x3f800000)).toStr() + " " + math.fromBits32(-1077936128).toStr() + " " +
        math.fromBits32(-2147483647 - 1).toStr() + " " + math.fromBits32(i32(0x7f800000)).toStr() + " " +
        math.fromBits32(i32(0x7fc00000)).isNaN().toStr())

    println(h32(math.bitsOf32(math.fromBits(0x3ff0000010000000))) + " " +
        h32(math.bitsOf32(math.fromBits(0x3ff0000030000000))) + " " +
        h32(math.bitsOf32(math.fromBits(0x3ff0000020000000))) + " " +
        h32(math.bitsOf32(math.fromBits(0x7fe0000000000000))))

    // The int forms take the 0..0xffffffff a readU32 gives, without an i32
    // conversion that would trap on the high bit.
    println(math.fromBits32Int(3217031168).toStr() + " " + word(math.bitsOf32Int(one)) + " " +
        word(math.bitsOf32Int(-zero)))
}
