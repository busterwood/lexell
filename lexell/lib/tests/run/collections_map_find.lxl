// Map.find(&k): the value under k, borrowed, or None (no copy of the value, no stop when absent).
// expect: a long value
// expect: none
// expect: found
fn main() {
    var m = newMap[str, str]()
    m.put("k" + "", "a long value" + "")
    let key = "k" + ""
    match m.find(&key) { Some(v) { println(v) } None { println("none") } }
    match m.find(&("z" + "")) { Some(v) { println(v) } None { println("none") } }
    let r = m.find("k")
    if r.isSome() { println("found") }
}
