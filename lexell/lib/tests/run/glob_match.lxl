// zoxide_glob (cmd/, not a library module): Rust-glob syntax. `*` and `?` stay inside one path
// component, `**` crosses separators as a whole component, sets and escapes
// compile, and the error positions and messages are Rust's.
// expect: star T T F
// expect: any T F F F T
// expect: slashstar T T F F
// expect: recstar T T T F
// expect: rec T T T T
// expect: mid T T T F
// expect: lead T T T
// expect: set T F T F F T F T F
// expect: edge T F T T
// expect: esc T F T F T F
// expect: err 0:range 0:range 0:range 0:range 1:range
// expect: rec 2:rec 0:rec 0:rec 2:wild 4:wild
// expect: uni T T T F F T F
// expect: empty T F F
// expect: utf8 T T F T
// expect: conv T F 1:range
// expect: deep F
// expect: relaxed T F T F F
// expect: relaxq T F T F T
// expect: relaxrec T T T T F
// expect: relaxset T F T F F T F
// expect: relerr 1:range 0:rec 2:wild
// expect: lit T F F T F
// expect: lituni T F T
// expect: wild T T F T T F F

import "strings"

import "../../../cmd/zoxide_glob" as glob

fn tf(v: bool): str { return if v { "T" } else { "F" } }

fn r(pattern: str, path: str): str {
    match glob.compile(&pattern) {
        Ok(p) { return tf(p.matches(&path)) }
        Err(_) { return "err" }
    }
}

fn errOf(e: glob.Error): str {
    var k = "other"
    if e.msg == "invalid range pattern" {
        k = "range"
    } else if e.msg == "recursive wildcards must form a single path component" {
        k = "rec"
    } else if e.msg == "wildcards are either regular `*` or recursive `**`" {
        k = "wild"
    }
    return e.pos.toStr() + ":" + k
}

fn err(pattern: str): str {
    match glob.compile(&pattern) {
        Ok(_) { return "ok" }
        Err(e) { return errOf(e) }
    }
}

fn rc(pattern: str, path: str): str {
    match glob.matchPath(&pattern, &path) {
        Ok(v) { return tf(v) }
        Err(e) { return errOf(e) }
    }
}

// The zoxide-compatible mode: wildcards and sets may cross '/'.
fn rr(pattern: str, path: str): str {
    match glob.compile(&pattern) {
        Ok(p) { return tf(p.matchesRelaxed(&path)) }
        Err(_) { return "err" }
    }
}

fn rre(pattern: str, path: str): str {
    match glob.compile(&pattern) {
        Ok(p) { return tf(p.matchesRelaxed(&path)) }
        Err(e) { return errOf(e) }
    }
}

fn main() {
    println("star " + r("*", "") + " " + r("*", "abc") + " " + r("*", "a/b"))
    println("any " + r("?", "a") + " " + r("?", "") + " " + r("?", "ab") + " " +
        r("?", "/") + " " + r("?", "é"))
    println("slashstar " + r("foo/*", "foo/bar") + " " + r("foo/*", "foo/") + " " +
        r("foo/*", "foo/a/b") + " " + r("foo/*", "foo"))
    println("recstar " + r("foo/**", "foo/a") + " " + r("foo/**", "foo/a/b") + " " +
        r("foo/**", "foo/") + " " + r("foo/**", "foo"))
    println("rec " + r("**", "") + " " + r("**", "a") + " " + r("**", "a/b") + " " +
        r("**", "/"))
    println("mid " + r("a/**/b", "a/b") + " " + r("a/**/b", "a/x/b") + " " +
        r("a/**/b", "a/x/y/b") + " " + r("a/**/b", "a/x"))
    println("lead " + r("**/b", "b") + " " + r("**/b", "a/b") + " " + r("**/b", "a/x/b"))
    println("set " + r("[abc]", "a") + " " + r("[abc]", "d") + " " + r("[a-z]", "q") + " " +
        r("[a-z]", "A") + " " + r("[!abc]", "a") + " " + r("[!abc]", "d") + " " +
        r("[^abc]", "a") + " " + r("[^abc]", "d") + " " + r("[/]", "/"))
    println("edge " + r("[]]", "]") + " " + r("[!]]", "]") + " " + r("[!]]", "x") + " " +
        r("[a-]", "-"))
    println("esc " + r("\\*", "*") + " " + r("\\*", "x") + " " + r("\\?", "?") + " " +
        r("\\?", "x") + " " + r("\\\\", "\\") + " " + r("\\*", ""))
    println("err " + err("[") + " " + err("[abc") + " " + err("[!abc") + " " +
        err("[]") + " " + err("a["))
    println("rec " + err("**a") + " " + err("a**") + " " + err("a**b") + " " +
        err("***") + " " + err("a/***"))
    println("uni " + r("caf?", "café") + " " + r("?", "é") + " " + r("[é-ê]", "ê") + " " +
        r("[é-ê]", "e") + " " + r("*", "日本/語") + " " + r("**", "日本/語") + " " +
        r("Foo", "foo"))
    println("empty " + r("", "") + " " + r("", "x") + " " + r("", "/"))
    println("utf8 " + r("\xFF", "\xFE") + " " + r("?", "\xFF") + " " +
        r("?", "\xFF\xFE") + " " + r("\xFF*", "\xFE\xFD"))
    println("conv " + rc("a/*", "a/b") + " " + rc("a/*", "a/b/c") + " " + rc("a[", "a"))
    println("deep " + r(strings.repeat("*a", 200) + "b", strings.repeat("a", 400)))
    println("relaxed " + rr("a/*", "a/b/c") + " " + r("a/*", "a/b/c") + " " +
        rr("a/*", "a/") + " " + rr("a/*", "a") + " " + rr("a/*", "abcd"))
    println("relaxq " + rr("a/?", "a/b") + " " + rr("a/?", "a/b/c") + " " +
        rr("a?b", "a/b") + " " + r("a?b", "a/b") + " " + rr("?", "/"))
    println("relaxrec " + rr("a/**/b", "a/x/y/b") + " " + r("a/**/b", "a/x/y/b") + " " +
        rr("**", "a/b/c") + " " + r("**", "a/b/c") + " " + rr("a/**/b", "a/x"))
    println("relaxset " + rr("a[/]b", "a/b") + " " + r("a[/]b", "a/b") + " " +
        rr("[a/]", "/") + " " + r("[a/]", "/") + " " + rr("[ab]", "/") + " " +
        rr("[!a]", "/") + " " + r("[!a]", "/"))
    println("relerr " + rre("a[", "a") + " " + rre("a**", "a") + " " + rre("***", "a"))
    // An escaped pattern of only literals takes the string-compare fast path:
    // \/ and \  are literal '/' and ' '.
    println("lit " + r("\\/home/a\\ b", "/home/a b") + " " +
        r("\\/home/a\\ b", "/home/a  b") + " " + r("\\/home/a\\ b", "/home/a b/") + " " +
        rr("\\/home/a\\ b", "/home/a b") + " " + rr("\\/home/a\\ b", "/home/ab"))
    println("lituni " + r("café", "café") + " " + r("café", "cafe") + " " +
        rr("日本/語", "日本/語"))
    // Any wildcard keeps the DP path: the two modes still differ on '/'.
    println("wild " + r("a*b", "axxb") + " " + r("a*b", "ab") + " " + r("a*b", "a/b") + " " +
        rr("a*b", "a/b") + " " + r("a*b", "aXb") + " " + r("a*b", "a") + " " +
        r("a*b", "ab?"))
}
