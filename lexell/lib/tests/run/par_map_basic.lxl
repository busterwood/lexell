// par: par.map gives what a loop would, in order: ints, strings built from the
// items and from a captured value, records holding arrays, a named function,
// a generic function's instance, an empty slice, and results that keep
// strings of the input (their counts are the caller's).
// expect: 10 20 30 40 50
// expect: 1 4 9 16 25
// expect: r0-x r1-x r2-x r3-x
// expect: 0:[] 1:[0] 2:[0,1] 3:[0,1,2]
// expect: 0
// expect: 3 3 3
// expect: alpha beta gamma
// expect: 6
import "par"

type Row = record { name: str; n: int }
type Out = record { n: int; parts: []int }

fn sq(x: &int): int { return x * x }

fn sp(s: str): str { return if len(s) > 0 { s + " " } else { s } }

fn twice[T: copy](x: &T): T { return x }

fn upto(r: &Row): Out {
    var ps: []int = []
    for i in 0..r.n { append(mut &ps, i) }
    return Out{n: r.n, parts: ps}
}

fn show(o: &Out): str {
    var s = o.n.toStr() + ":["
    for i in 0..len(o.parts) {
        if i > 0 { s = s + "," }
        s = s + o.parts[i].toStr()
    }
    return s + "]"
}

fn main() {
    let xs: []int = [1, 2, 3, 4, 5]
    let k = 10
    let ys = par.map(&xs, fn(x: &int): int { return x * k })
    var line = ""
    for y in ys { line = sp(line) + y.toStr() }
    println(line)
    let zs = par.map(&xs, sq)
    line = ""
    for z in zs { line = sp(line) + z.toStr() }
    println(line)
    var rows: []Row = []
    for i in 0..4 { append(mut &rows, Row{name: "r" + i.toStr(), n: i}) }
    let suffix = "-x"
    let names = par.map(&rows, fn(r: &Row): str { return r.name + suffix })
    line = ""
    for s in names { line = sp(line) + s }
    println(line)
    let outs = par.map(&rows, upto)
    line = ""
    for o in outs { line = sp(line) + show(&o) }
    println(line)
    let none: []int = []
    let e = par.map(&none, sq)
    println(len(e).toStr())
    let threes: []int = [3, 3, 3]
    let t = par.map(&threes, twice[int])
    println(t[0].toStr() + " " + t[1].toStr() + " " + t[2].toStr())
    let words: []str = ["alpha", "beta", "gamma"]
    let same = par.map(&words, fn(w: &str): str { return w })
    println(same[0] + " " + same[1] + " " + same[2])
    var total = 0
    for o in outs { total += len(o.parts) }
    println(total.toStr())
}
