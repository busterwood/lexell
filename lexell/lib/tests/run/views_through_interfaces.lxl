// A shared borrow &U satisfies the interfaces U satisfies (Eq, Ord, Hash, Show; not those needing
// mut &Self): generic code calls U's methods on the borrowed value. With sort, dedup, equal, min
// and max declared for borrow type parameters, views can be sorted and compared with no copies.
// expect: apple,apple,banana,fig,pear
// expect: 4 true
// expect: banana fig
import "strings"
import "collections"
fn main() {
    let text = "pear apple fig banana apple" + ""
    var ws = strings.split(&text, " ")
    sort(mut &ws)
    println(strings.join(&ws, ","))
    collections.dedup(mut &ws)
    println(len(ws).toStr() + " " + collections.equal(&ws, &ws).toStr())
    let hi = max(ws[0], ws[1])
    let lo = min(ws[2], ws[3])
    println(hi + " " + lo)
}
