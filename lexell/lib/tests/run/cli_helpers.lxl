// cli_helpers: argv() against args(), and the token predicates used by parse.
// These pin the split rule on its own: a trailing '=' does not split, a split
// needs a non-empty name and at least one byte after the '=', and a non-split
// long name is the whole rest after "--".
//
// The obo original also checked that the runner passed a scratch directory;
// the lxl conformance runner passes only the program path, so here argv() must
// simply match args() and hold at least the program.
// expect: cli helpers ok
import "cli"

fn fail(what: str) {
    println("FAIL " + what)
    exit(1)
}

fn checkInt(label: str, got: int, want: int) {
    if got != want { fail(label + ": got " + got.toStr() + " want " + want.toStr()) }
}

fn checkByte(label: str, got: byte, want: byte) {
    if got != want { fail(label + ": got " + got.toStr() + " want " + want.toStr()) }
}

fn checkStr(label: str, got: str, want: str) {
    if got != want { fail(label + ": got [" + got + "] want [" + want + "]") }
}

fn checkBool(label: str, got: bool, want: bool) {
    if got != want { fail(label + ": got " + got.toStr() + " want " + want.toStr()) }
}

fn main() {
    // argv() is args() including argv[0]
    let a = args()
    let v = cli.argv()
    checkInt("argv len", len(v), len(a))
    for i in 0..len(a) { checkStr("argv " + i.toStr(), v[i], a[i]) }
    checkBool("argv has program", len(v) >= 1, true)

    // shortName: a[i], or the byte 0 outside the string
    checkByte("shortName 0", cli.shortName("-xQ", 0), '-')
    checkByte("shortName 1", cli.shortName("-xQ", 1), 'x')
    checkByte("shortName 2", cli.shortName("-xQ", 2), 'Q')
    checkByte("shortName 3", cli.shortName("-xQ", 3), byte(0))
    checkByte("shortName -1", cli.shortName("-xQ", -1), byte(0))
    checkByte("shortName empty", cli.shortName("", 0), byte(0))
    checkByte("shortName a", cli.shortName("a", 0), 'a')
    checkByte("shortName --", cli.shortName("--", 1), '-')

    // isLong: at least "--x" (the bare "--" is the terminator, not long)
    checkBool("isLong empty", cli.isLong(""), false)
    checkBool("isLong dash", cli.isLong("-"), false)
    checkBool("isLong terminator", cli.isLong("--"), false)
    checkBool("isLong short", cli.isLong("-a"), false)
    checkBool("isLong short long", cli.isLong("-ab"), false)
    checkBool("isLong x", cli.isLong("--x"), true)
    checkBool("isLong three", cli.isLong("---"), true)
    checkBool("isLong three x", cli.isLong("---x"), true)
    checkBool("isLong empty name", cli.isLong("--=x"), true)
    checkBool("isLong trailing dashes", cli.isLong("a--"), false)

    // longName: "" for non-long; the split name or the whole rest
    checkStr("longName empty", cli.longName(""), "")
    checkStr("longName short", cli.longName("-a"), "")
    checkStr("longName terminator", cli.longName("--"), "")
    checkStr("longName x", cli.longName("--x"), "x")
    checkStr("longName three x", cli.longName("---x"), "-x")
    checkStr("longName split", cli.longName("--sort=name"), "sort")
    checkStr("longName double equals", cli.longName("--foo=="), "foo")
    checkStr("longName trailing equals", cli.longName("--foo="), "foo=")
    checkStr("longName empty prefix", cli.longName("--=x"), "=x")
    checkStr("longName two equals", cli.longName("--a=b=c"), "a")
    checkStr("longName dash name", cli.longName("---=x"), "-")

    // hasLongValue: the same split rule
    checkBool("hasValue empty", cli.hasLongValue(""), false)
    checkBool("hasValue short", cli.hasLongValue("-a"), false)
    checkBool("hasValue x", cli.hasLongValue("--x"), false)
    checkBool("hasValue split", cli.hasLongValue("--sort=name"), true)
    checkBool("hasValue double", cli.hasLongValue("--foo=="), true)
    checkBool("hasValue triple", cli.hasLongValue("--a=b=c"), true)
    checkBool("hasValue dash name", cli.hasLongValue("---=x"), true)
    checkBool("hasValue trailing", cli.hasLongValue("--foo="), false)
    checkBool("hasValue empty prefix", cli.hasLongValue("--=x"), false)

    // longValue: the bytes after the first '=' when the token splits
    checkStr("longValue empty", cli.longValue(""), "")
    checkStr("longValue short", cli.longValue("-a"), "")
    checkStr("longValue x", cli.longValue("--x"), "")
    checkStr("longValue split", cli.longValue("--sort=name"), "name")
    checkStr("longValue double", cli.longValue("--foo=="), "=")
    checkStr("longValue two equals", cli.longValue("--a=b=c"), "b=c")
    checkStr("longValue dash name", cli.longValue("---=x"), "x")
    checkStr("longValue trailing", cli.longValue("--foo="), "")
    checkStr("longValue empty prefix", cli.longValue("--=x"), "")

    println("cli helpers ok")
}
