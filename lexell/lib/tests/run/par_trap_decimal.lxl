// par: a Decimal overflow in a kernel stops the program as in a loop: its
// message on stderr, exit 10.
// exit: 10
// stderr: Lexell: decimal overflow
import "par"

fn big(x: &int): Decimal {
    var d = 1.0m
    if x == 1200 {
        for i in 0..10000 { d = d * 1000000.0m }
    }
    return d
}

fn main() {
    var xs: []int = []
    for i in 0..2000 { append(mut &xs, i) }
    let ys = par.map(&xs, big)
    println("not reached")
}
