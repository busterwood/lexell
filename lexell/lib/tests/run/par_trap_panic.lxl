// par: a panic in a kernel, wherever it runs, stops the program with its
// message and line (exit 12), as in a loop.
// exit: 12
// stderr: Lexell: panic: item 777 at par_trap_panic.lxl:10
import "par"

fn check(x: &int): int {
    var s = 0
    for i in 0..1000 { s += i % 3 }
    if x == 777 { panic("item " + x.toStr()) }
    return s
}

fn main() {
    var xs: []int = []
    for i in 0..2000 { append(mut &xs, i) }
    let ys = par.map(&xs, check)
    println("not reached")
}
