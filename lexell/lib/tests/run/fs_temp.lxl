// createTemp makes distinct, exclusively created files with mode 0600;
// writeAtomic writes through a temporary in the same directory, replaces the
// target and leaves no temporary behind.
// expect: distinct true
// expect: mode 0600 true
// expect: atomic content hello
// expect: no temps true
// expect: overwrite true

import "io"
import "fs"
import "os"

fn check[T](r: Result[T, io.IoError]): T {
    match move(r) {
        Ok(v) { return v }
        Err(e) {
            eprintln("unexpected: " + e.toStr())
            exit(1)
        }
    }
}

fn main() {
    let dir = "/tmp/lxl_lib_fs_temp_" + os.pid().toStr()
    fs.removeAll(dir)
    check(fs.mkdirAll(dir))

    var w1 = check(fs.createTemp(dir, "t"))
    w1.write("one")
    check(w1.close())
    var w2 = check(fs.createTemp(dir, "t"))
    w2.write("two")
    check(w2.close())
    let names = check(fs.listNames(dir))
    let distinct = len(names) == 2 && names[0] != names[1]
    println("distinct " + distinct.toStr())
    let m1 = check(fs.stat(fs.join(dir, names[0]))).perm() & 0x1FF
    let m2 = check(fs.stat(fs.join(dir, names[1]))).perm() & 0x1FF
    println("mode 0600 " + (m1 == 0x180 && m2 == 0x180).toStr())

    for n in names { check(fs.remove(fs.join(dir, n))) }
    let target = fs.join(dir, "out.txt")
    check(fs.writeAtomic(target, "hello"))
    println("atomic content " + check(io.read(target)))
    let left = check(fs.listNames(dir))
    println("no temps " + (len(left) == 1 && left[0] == "out.txt").toStr())
    check(fs.writeAtomic(target, "bye"))
    println("overwrite " + (check(io.read(target)) == "bye").toStr())

    check(fs.removeAll(dir))
}
