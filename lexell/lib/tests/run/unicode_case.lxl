// unicode: Unicode 15.0.0 classification and simple case mapping.
// The expected categories are unicodedata 15.0.0's: 0041 Lu, 0061 Ll,
// 0030 Nd, 0020 Zs, 000A Cc, 0378 Cn (unassigned), 0301 Mn, 01C5 Lt.
// expect: ascii true true true true true true true true
// expect: digits true true true false
// expect: neg false false false false true true true false false
// expect: latin1 true true true true 233 233 Ll Lu
// expect: greek true true true true 945 963 962 Ll Lu
// expect: cyrillic true true true true 1103
// expect: han true false false false Lo 20320
// expect: emoji false false false false So 128512
// expect: space true true true true true true true false true Zs Zs
// expect: punct true true false true true true true false true true Po Po Sc Pc Pd Ps Pe So Po Po
// expect: cat Lu Ll Nd Zs Cc Cn Mn Lt
// expect: title false false true 454
// expect: special 223 223 105 107 383
// expect: case 201 913 931 223
// expect: fold 97 65 8490 75 962 7838 304
// expect: cherokee 43888 true true Lu Ll
// expect: range false false Cn Cn -1 1114112
import "unicode"

fn b(v: bool): str { return if v { "true" } else { "false" } }

fn main() {
    // ASCII: letters, a digit, space, comma, and case.
    println("ascii " + b(unicode.isLetter(0x41)) + " " + b(unicode.isLetter(0x61)) + " " +
        b(unicode.isLetter(0x7A)) + " " + b(unicode.isDigit(0x35)) + " " + b(unicode.isSpace(0x20)) + " " +
        b(unicode.isPunct(0x2C)) + " " + b(unicode.isUpper(0x41)) + " " + b(unicode.isLower(0x61)))
    // isDigit is Nd: Arabic-Indic U+0663 and fullwidth U+FF15 are digits,
    // Roman numeral U+2160 (Nl) is not.
    println("digits " + b(unicode.isDigit(0x35)) + " " + b(unicode.isDigit(0x663)) + " " +
        b(unicode.isDigit(0xFF15)) + " " + b(unicode.isDigit(0x2160)))
    // Negatives: a digit is not a letter, "$" is a symbol (Sc), not punctuation.
    println("neg " + b(unicode.isLetter(0x35)) + " " + b(unicode.isDigit(0x41)) + " " +
        b(unicode.isSpace(0x41)) + " " + b(unicode.isPunct(0x24)) + " " + b(unicode.isPunct(0x21)) + " " +
        b(unicode.isPunct(0x5F)) + " " + b(unicode.isPunct(0x28)) + " " + b(unicode.isUpper(0x61)) + " " +
        b(unicode.isLower(0x41)))
    // Latin-1: é U+00E9 is Ll, É U+00C9 is Lu and lowers to it.
    println("latin1 " + b(unicode.isLetter(0xE9)) + " " + b(unicode.isLetter(0xC9)) + " " +
        b(unicode.isLower(0xE9)) + " " + b(unicode.isUpper(0xC9)) + " " +
        unicode.lower(0xC9).toStr() + " " + unicode.lower(0xE9).toStr() + " " +
        unicode.category(0xE9) + " " + unicode.category(0xC9))
    // Greek: α U+03B1 / Α U+0391; Σ U+03A3 folds to σ U+03C3, not ς U+03C2,
    // and the already-lowercase final sigma is unchanged.
    println("greek " + b(unicode.isLetter(0x3B1)) + " " + b(unicode.isLetter(0x391)) + " " +
        b(unicode.isUpper(0x391)) + " " + b(unicode.isLower(0x3B1)) + " " +
        unicode.lower(0x391).toStr() + " " + unicode.lower(0x3A3).toStr() + " " +
        unicode.lower(0x3C2).toStr() + " " + unicode.category(0x3B1) + " " + unicode.category(0x391))
    // Cyrillic: я U+044F / Я U+042F.
    println("cyrillic " + b(unicode.isLetter(0x44F)) + " " + b(unicode.isLetter(0x42F)) + " " +
        b(unicode.isUpper(0x42F)) + " " + b(unicode.isLower(0x44F)) + " " + unicode.lower(0x42F).toStr())
    // Han 你 U+4F60 is a letter (Lo) but not a digit.
    println("han " + b(unicode.isLetter(0x4F60)) + " " + b(unicode.isDigit(0x4F60)) + " " +
        b(unicode.isSpace(0x4F60)) + " " + b(unicode.isPunct(0x4F60)) + " " +
        unicode.category(0x4F60) + " " + unicode.lower(0x4F60).toStr())
    // Emoji U+1F600 is So: not a letter, digit, space or punctuation.
    println("emoji " + b(unicode.isLetter(0x1F600)) + " " + b(unicode.isDigit(0x1F600)) + " " +
        b(unicode.isSpace(0x1F600)) + " " + b(unicode.isPunct(0x1F600)) + " " +
        unicode.category(0x1F600) + " " + unicode.lower(0x1F600).toStr())
    // Unicode white space: NBSP U+00A0 and ideographic space U+3000 are Zs;
    // TAB, VT, NEL, LS, PS are white space; ZWSP U+200B (Cf) is not.
    println("space " + b(unicode.isSpace(0xA0)) + " " + b(unicode.isSpace(0x3000)) + " " +
        b(unicode.isSpace(0x09)) + " " + b(unicode.isSpace(0x0B)) + " " + b(unicode.isSpace(0x85)) + " " +
        b(unicode.isSpace(0x2028)) + " " + b(unicode.isSpace(0x2029)) + " " + b(unicode.isSpace(0x200B)) + " " +
        b(unicode.isSpace(0x1680)) + " " + unicode.category(0xA0) + " " + unicode.category(0x3000))
    // Punctuation: every P subcategory; © U+00A9 is So, not P.
    println("punct " + b(unicode.isPunct(0x21)) + " " + b(unicode.isPunct(0x22)) + " " +
        b(unicode.isPunct(0x24)) + " " + b(unicode.isPunct(0x5F)) + " " + b(unicode.isPunct(0x2D)) + " " +
        b(unicode.isPunct(0x28)) + " " + b(unicode.isPunct(0x29)) + " " + b(unicode.isPunct(0xA9)) + " " +
        b(unicode.isPunct(0x2026)) + " " + b(unicode.isPunct(0x3002)) + " " +
        unicode.category(0x21) + " " + unicode.category(0x22) + " " + unicode.category(0x24) + " " +
        unicode.category(0x5F) + " " + unicode.category(0x2D) + " " + unicode.category(0x28) + " " +
        unicode.category(0x29) + " " + unicode.category(0xA9) + " " + unicode.category(0x2026) + " " +
        unicode.category(0x3002))
    println("cat " + unicode.category(0x41) + " " + unicode.category(0x61) + " " +
        unicode.category(0x30) + " " + unicode.category(0x20) + " " + unicode.category(0x0A) + " " +
        unicode.category(0x378) + " " + unicode.category(0x301) + " " + unicode.category(0x1C5))
    // Titlecase U+01C5 (Dž) is Lt: neither upper nor lower, and lowers to
    // U+01C6 (dž) through its fold orbit.
    println("title " + b(unicode.isUpper(0x1C5)) + " " + b(unicode.isLower(0x1C5)) + " " +
        b(unicode.isLetter(0x1C5)) + " " + unicode.lower(0x1C5).toStr())
    // Multi-code-point folds and simple-lowercase exceptions:
    // ẞ U+1E9E -> ß U+00DF, ß unchanged, İ U+0130 -> i U+0069 (UnicodeData's
    // simple mapping; full lowercase is i + U+0307), Kelvin sign -> k,
    // long s U+017F is already Ll.
    println("special " + unicode.lower(0x1E9E).toStr() + " " + unicode.lower(0xDF).toStr() + " " +
        unicode.lower(0x130).toStr() + " " + unicode.lower(0x212A).toStr() + " " +
        unicode.lower(0x17F).toStr())
    // Simple upper mappings and simple case folding (Go's unicode.ToUpper/SimpleFold).
    println("case " + unicode.upper(0xE9).toStr() + " " + unicode.upper(0x3B1).toStr() + " " +
        unicode.upper(0x3C3).toStr() + " " + unicode.upper(0xDF).toStr())
    println("fold " + unicode.fold(0x41).toStr() + " " + unicode.fold(0x61).toStr() + " " +
        unicode.fold(0x6B).toStr() + " " + unicode.fold(0x212A).toStr() + " " +
        unicode.fold(0x3A3).toStr() + " " + unicode.fold(0xDF).toStr() + " " + unicode.fold(0x130).toStr())
    // Cherokee capital U+13A0 -> lowercase U+AB70 through the fold orbit.
    println("cherokee " + unicode.lower(0x13A0).toStr() + " " + b(unicode.isUpper(0x13A0)) + " " +
        b(unicode.isLower(0xAB70)) + " " + unicode.category(0x13A0) + " " + unicode.category(0xAB70))
    // Values outside Unicode are not letters, are Cn, and lower to themselves.
    println("range " + b(unicode.isLetter(-1)) + " " + b(unicode.isDigit(0x110000)) + " " +
        unicode.category(-1) + " " + unicode.category(0x110000) + " " + unicode.lower(-1).toStr() + " " +
        unicode.lower(0x110000).toStr())
}
