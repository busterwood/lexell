// A string is its own buffer (design/consistency.md: StrBuf is gone): s.clear() keeps the buffer,
// += and addByte/addInt/addLine append in place, so one reused string can be a lookup key with no
// key made per lookup; s.bytes() lends its bytes as a slice. Run with LXL_CHECK=1: no leaks.
// expect: 2 1 0
// expect: k:1|a-b
// expect: 4 4
fn main() {
    var m = newMap[str, int]()
    m.put("k:1" + "", 2)
    m.put("k:2" + "", 1)
    var b = ""
    var found: []int = []
    for i in 1..4 {
        b.clear()
        b += "k:"
        b.addInt(i)
        append(mut &found, m.getOr(&b, 0))
    }
    println(found[0].toStr() + " " + found[1].toStr() + " " + found[2].toStr())
    b.clear()
    b += "k:1"
    b.addByte('|')
    b += "a"
    b.addByte('-')
    b += "b"
    println(b)
    var l = ""
    l.addLine("ab")
    l += "c"
    println(len(l).toStr() + " " + len(l.bytes()).toStr())
}
