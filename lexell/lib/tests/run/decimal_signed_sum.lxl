// Sums at equal exponents near the 38-digit limit, where the signed
// coefficients' sum passes 2^127 (about 1.7e38): same signs are added as
// magnitudes, different signs as signed values.
// expect: Inexact Inexact
// expect: 100000000000000000000000000000000000000
// expect: -100000000000000000000000000000000000000
// expect: 0 -1 1
// expect: -1 0 1
fn d(s: str): Decimal { return Decimal.parse(&s).unwrap() }
fn code(r: Result[Decimal, DecError]): str {
    match r {
        Ok(x) { return x.toStr() }
        Err(_) { return "Inexact" }
    }
}
fn main() {
    let nines = d("99999999999999999999999999999999999999")
    println(code(nines.addExact(nines)) + " " + code(nines.neg().addExact(nines.neg())))
    let half = d("50000000000000000000000000000000000000")
    println(half + half)
    println(half.neg() + half.neg())
    println((nines - nines).toStr() + " " + (nines.neg() + d("99999999999999999999999999999999999998")).toStr() + " " + (nines + d("-99999999999999999999999999999999999998")).toStr())
    println(nines.neg().cmp(&nines).toStr() + " " + nines.cmp(&nines).toStr() + " " + nines.cmp(&nines.neg()).toStr())
}
