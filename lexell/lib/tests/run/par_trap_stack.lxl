// par: unbounded recursion in a kernel is a stack overflow (exit 4).
// exit: 4
// stderr: Lexell: stack overflow
import "par"

fn down(n: int): int {
    if n == 0 { return 0 }
    return down(n + 1) + 1
}

fn deep(x: &int): int {
    if x == 900 { return down(1) }
    return x
}

fn main() {
    var xs: []int = []
    for i in 0..2000 { append(mut &xs, i) }
    let ys = par.map(&xs, deep)
    println("not reached")
}
