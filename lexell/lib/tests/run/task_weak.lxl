// task.Weak (design/consistency.md, finding 1): sh.weak() is a handle that does not keep the
// value; upgrade() gives a Shared while one exists, None after. A child can point back at its
// parent weakly without a cycle of handles. Run with LXL_CHECK=1: nothing leaks.
// expect: kid of root
// expect: true
// expect: drop root
// expect: false
import "task"
type Parent = record { name: str; kids: []task.Shared[Child] }
type Child = record { name: str; parent: task.Weak[Parent] }
fn (p: mut &Parent) drop() { println("drop " + p.name) }
fn consume(x: task.Shared[Parent]) {}

fn main() {
    let p = task.shared(Parent{name: "root" + "", kids: []})
    let c = task.shared(Child{name: "kid" + "", parent: p.weak()})
    p.with(fn(x: mut &Parent) { append(mut &x.kids, c.share()) })
    c.with(fn(k: mut &Child) {
        match k.parent.upgrade() {
            Some(pp) { pp.with(fn(x: mut &Parent) { println(k.name + " of " + x.name) }) }
            None { println("orphan") }
        }
    })
    let w = p.weak()
    let w2 = w.share()
    println(w.upgrade().isSome().toStr())
    consume(p)                            // the last strong handle of the parent: dropped
    println(w2.upgrade().isSome().toStr())
}
