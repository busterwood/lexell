// strings: utf8Error's Rust wording, the C-locale byte predicates, and the
// existing ASCII-only toLower contract. toLower stays ASCII on purpose: the
// unicode tables are not imported by this module (see the strings header).
// expect: valid none none
// expect: truncated incomplete utf-8 byte sequence from index 0 | incomplete utf-8 byte sequence from index 1
// expect: continuation invalid utf-8 sequence of 2 bytes from index 0 | invalid utf-8 sequence of 1 bytes from index 0
// expect: index invalid utf-8 sequence of 1 bytes from index 2 | invalid utf-8 sequence of 1 bytes from index 2
// expect: more incomplete utf-8 byte sequence from index 0 | invalid utf-8 sequence of 1 bytes from index 0
// expect: print true true false false true | blank true true false false | word true true false false false
// expect: lower hello, world 123
import "strings"

fn b1(v: byte): str { return strFromBytes(&[byte(v)]) }

fn b2(a: int, b: int): str { return strFromBytes(&[byte(a), byte(b)]) }

fn b3(a: int, b: int, c: int): str { return strFromBytes(&[byte(a), byte(b), byte(c)]) }

fn b(v: bool): str { return if v { "true" } else { "false" } }

fn show(o: Option[str]): str {
    match o {
        Some(m) { return m }
        None { return "none" }
    }
}

fn main() {
    // valid UTF-8, ASCII and multibyte, has no error
    println("valid " + show(strings.utf8Error("hello")) + " " +
            show(strings.utf8Error(&("h" + b2(0xC3, 0xA9) + "llo"))))

    // a cut-short sequence at the end is "incomplete", at the byte index
    println("truncated " + show(strings.utf8Error(&(b2(0xE2, 0x82)))) + " | " +
            show(strings.utf8Error(&("a" + b2(0xE2, 0x82)))))

    // a well-started sequence followed by a non-continuation is "invalid";
    // the reported length is the maximal invalid subpart (E2 82), not one byte
    println("continuation " + show(strings.utf8Error(&(b3(0xE2, 0x82, 0x28)))) + " | " +
            show(strings.utf8Error(&(b1(0xFF)))))

    // the index counts bytes consumed by earlier valid text
    println("index " + show(strings.utf8Error(&("ok" + b1(0x80) + "x"))) + " | " +
            show(strings.utf8Error(&(b2(0xC3, 0xA9) + b1(0xFF)))))

    // a truncated 4-byte sequence is incomplete; an overlong C0 is invalid
    println("more " + show(strings.utf8Error(&(b3(0xF0, 0x9F, 0x98)))) + " | " +
            show(strings.utf8Error(&(b2(0xC0, 0xAF)))))

    // isPrint 0x20..0x7E, isBlank space and tab, isWordByte printable non-space
    println("print " + b(strings.isPrint(' ')) + " " + b(strings.isPrint('~')) + " " +
            b(strings.isPrint(byte(127))) + " " + b(strings.isPrint(byte(31))) + " " +
            b(strings.isPrint('A')) + " | blank " + b(strings.isBlank(' ')) + " " +
            b(strings.isBlank('\t')) + " " + b(strings.isBlank('\n')) + " " +
            b(strings.isBlank('a')) + " | word " + b(strings.isWordByte('!')) + " " +
            b(strings.isWordByte('a')) + " " + b(strings.isWordByte(' ')) + " " +
            b(strings.isWordByte(byte(127))) + " " + b(strings.isWordByte(byte(128))))

    // toLower is ASCII-only (A-Z), by design
    println("lower " + strings.toLowerAscii("HeLLo, WORLD 123"))
}
