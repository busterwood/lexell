// par: kernels may use the library's pure parts: Decimal (whose overflow stop
// writes to stderr and exits), floats and their text, strings.split, a
// compiled regex read through a capture, Map (hashing with the process key),
// and sortBy with a comparator closure.
// expect: 147.50 120 30 10 3 1
// expect: 1147.50 320 30 10 3 1
// expect: 1247.50 520 30 10 3 1
// expect: 1347.50 720 30 10 3 1
import "par"
import "strings"
import "regex"
import "collections"

type Row = record { desk: str; amount: Decimal; rate: float; tags: str }

fn main() {
    var rows: []Row = []
    for i in 0..40 {
        append(mut &rows, Row{desk: "d" + (i % 3).toStr(), amount: Decimal.parse(&("1" + i.toStr() + ".25")).unwrap(),
            rate: 1.5f + float(i), tags: "a,b," + i.toStr()})
    }
    let re = regex.compile("[0-9]+").unwrap()
    let idx: []int = [0, 1, 2, 3]
    let parts = par.map(&idx, fn(c: &int): str {
        var total = 0.00m
        var fl = 0.0f
        var ntag = 0
        var digits = 0
        var m: Map[str, Decimal] = newMap()
        var i = c * 10
        while i < c * 10 + 10 {
            let r = &rows[i]
            total = total + r.amount
            fl += r.rate * 2.0f
            let ps = strings.split(&r.tags, ",")
            ntag += len(ps)
            if re.isMatch(&r.tags) { digits += 1 }
            m.put(r.desk, m.getOr(&r.desk, 0.00m) + r.amount)
            i += 1
        }
        var ks: []int = []
        for j in 0..10 { append(mut &ks, 10 - j) }
        collections.sortBy(mut &ks, fn(a: &int, b: &int): int { return a - b })
        return total.toStr() + " " + fl.toStr() + " " + ntag.toStr() + " " + digits.toStr() + " " + m.size().toStr() +
            " " + ks[0].toStr()
    })
    for p in parts { println(p) }
}
