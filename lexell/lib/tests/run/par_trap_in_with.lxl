// par: par.map waits like any park, so inside Shared.with it stops the program
// (exit 13).
// exit: 13
// expect: inside
// stderr: Lexell: a task parked inside Shared.with (the with at par_trap_in_with.lxl:13) at par_trap_in_with.lxl:16
import "par"
import "task"

fn sq(x: &int): int { return x * x }

fn main() {
    let sh = task.shared(1)
    sh.with(fn(x: mut &int) {
        println("inside")
        let xs: []int = [1, 2]
        let ys = par.map(&xs, sq)
        println("not reached")
    })
}
