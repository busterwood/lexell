// collections.sortBy: stable, a permutation, sorted, for sizes around its insertion runs (16) and
// merge widths, few and many distinct keys, ascending, descending and equal inputs, and owned
// elements (strings).
// expect: 320 cases, 0 bad
import "collections"

type R = record { key: int; at: int; name: str }

fn check(n: int, keys: int, mode: int, seed: int): str {
    var rs: []R = []
    var x = seed
    for i in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648
        let k = if mode == 0 { x % keys } else if mode == 1 { i / 3 } else if mode == 2 { (n - i) / 2 } else { 7 }
        append(mut &rs, R{key: k, at: i, name: "s" + i.toStr()})
    }
    collections.sortBy(mut &rs, fn(a: &R, b: &R): int { return a.key.cmp(&b.key) })
    var seen = array(n, false)
    for i in 0..n {
        if seen[rs[i].at] { return "dup" }
        seen[rs[i].at] = true
        if rs[i].name != "s" + rs[i].at.toStr() { return "name" }
        if i > 0 {
            if rs[i].key < rs[i - 1].key { return "order" }
            if rs[i].key == rs[i - 1].key && rs[i].at < rs[i - 1].at { return "unstable" }
        }
    }
    return "ok"
}

fn main() {
    var bad = 0
    var runs = 0
    let sizes = [0, 1, 2, 3, 15, 16, 17, 31, 32, 33, 47, 63, 64, 65, 100, 255, 256, 257, 1000, 4097]
    for n in sizes {
        for keys in [1, 2, 5, 1000000] {
            for mode in 0..4 {
                let r = check(n, keys, mode, n * 7 + keys + mode)
                runs += 1
                if r != "ok" {
                    println(n.toStr() + " " + keys.toStr() + " " + mode.toStr() + ": " + r)
                    bad += 1
                }
            }
        }
    }
    println(runs.toStr() + " cases, " + bad.toStr() + " bad")
}
