// StrBuf.text(): the buffer's bytes as a &str without a copy, so a reused buffer can be a lookup
// key; it borrows the buffer (no add while it is used), and a clone of it is a copy.
// expect: 2 1 0
// expect: abc
// expect: abcd 4
fn main() {
    var m = newMap[str, int]()
    m.put("k:1" + "", 2)
    m.put("k:2" + "", 1)
    var b = newStrBuf()
    var found: []int = []
    for i in 1..4 {
        b.clear()
        b.add("k:")
        b.addInt(i)
        append(mut &found, m.getOr(b.text(), 0))
    }
    println(found[0].toStr() + " " + found[1].toStr() + " " + found[2].toStr())
    var c = newStrBuf()
    c.add("abc")
    let t = c.text()
    let kept = t.clone()
    println(kept)
    c.addByte('d')
    println(c.text() + " " + len(c.text()).toStr())
}
