// par: kernels on the pool's threads copy, keep and drop strings of the input
// and of their captures; their counts are made right when the map ends, so
// the results outlive the input and nothing leaks.
// expect: 2000 items, 16000 bytes
// expect: name-0007 name-1999 shared
// expect: 3998000
import "par"

type Rec = record { name: str; n: int }

fn main() {
    var recs: []Rec = []
    for i in 0..2000 {
        var d = i.toStr()
        while len(d) < 4 { d = "0" + d }
        append(mut &recs, Rec{name: "name-" + d, n: i})
    }
    let tag = "shared" + ""
    var kept: []str = []
    var outs: [][]str = []
    {
        let input = recs
        outs = par.map(&input, fn(r: &Rec): []str {
            var tmp: []str = []
            for k in 0..5 { append(mut &tmp, r.name) }
            let first = tmp[0]
            return [first, tag, r.name]
        })
    }
    var bytes = 0
    for o in outs { bytes += len(o[0]) - 1 }
    println(len(outs).toStr() + " items, " + bytes.toStr() + " bytes")
    println(outs[7][0] + " " + outs[1999][2] + " " + outs[3][1])
    let nums: []int = [0, 1, 2, 3]
    var big: []int = []
    for i in 0..2000 { append(mut &big, i) }
    let sums = par.map(&nums, fn(q: &int): int {
        var s = 0
        for v in big { if v % 4 == q { s += v } }
        return s * 2
    })
    var t = 0
    for s in sums { t += s }
    println(t.toStr())
}
