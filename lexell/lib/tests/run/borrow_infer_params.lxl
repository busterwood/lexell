// borrow inference (design/borrow-inference.md): str parameters that their
// functions only read are passed without a count. The cases where it must not
// change what a program does: a borrowed function also called with fresh
// strings, moved locals and through a function value; recursion; a parameter
// read, copied and passed on; a member of a record local; the same local
// passed twice; a borrowed parameter's string kept in a result after a copy;
// a kernel of par.map; a task parking inside a borrowed function.
// expect: 3 1 0
// expect: 6
// expect: abc!abc!
// expect: 21
// expect: deep 5
// expect: rec-x 5
// expect: two 8
// expect: kept [k1 k2 k3]
// expect: 5 5 5
// expect: task 2 slept
// expect: done
import "par"
import "task"

type Rec = record { name: str; n: int }

fn width(s: str): int { return len(s) }

fn classify(s: str): int {
    if len(s) > 3 { return 1 }
    return 0
}

fn twice(s: str): str { return s + s }

fn nested(s: str): int { return width(s) + classify(s) * 10 }

fn depth(s: str, n: int): int {
    if n == 0 { return width(s) }
    return depth(s, n - 1)
}

fn both(a: str, b: str): int { return len(a) + len(b) }

fn keepCopy(s: str): []str {
    let c = s
    return [c]
}

fn napLen(s: str): int {
    let r = task.sleep(1)
    return len(s)
}

fn sleeper(n: int): int {
    let r = task.sleep(2)
    return n
}

fn main() {
    let a = "abc"
    let b = "x"
    println(width(a).toStr() + " " + width(b).toStr() + " " + classify(a).toStr())
    println(width(a + b + "yy").toStr())
    let f = twice
    println(f(a + "!"))
    let longer = "abcdefghij" + b
    println(nested(longer).toStr())
    println("deep " + depth("hello", 200).toStr())
    let r = Rec{name: "rec-" + b, n: 5}
    println(r.name + " " + width(r.name).toStr())
    let t = "two" + "!"
    println("two " + both(t, t).toStr())
    var kept: []str = []
    for i in 1..4 {
        let k = "k" + i.toStr()
        let got = keepCopy(k)
        append(mut &kept, got[0])
    }
    println("kept [" + kept[0] + " " + kept[1] + " " + kept[2] + "]")
    let words: []str = ["alpha", "bravo", "gamma"]
    let ws = par.map(&words, fn(w: &str): int { return width(w) })
    println(ws[0].toStr() + " " + ws[1].toStr() + " " + ws[2].toStr())
    task.scope(fn(s: mut &task.Scope) {
        let fut = s.start(sleeper, 2)
        let msg = "slept"
        let n = napLen(msg)
        println("task " + fut.wait().unwrap().toStr() + " " + msg)
    })
    println("done")
}
