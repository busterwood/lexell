// zstd module: one-shot and streaming compression/decompression, levels,
// frame checksums, multi-frame streams, maxOut limits, and error paths.
// needs: zstd
// expect: version ok true
// expect: levels ok true
// expect: empty roundtrip true
// expect: levels roundtrip true
// expect: large 250k true
// expect: multiframe true
// expect: streaming roundtrip true
// expect: streaming flush true
// expect: checksum detects flip true
// expect: maxOut exact true
// expect: maxOut overflow true
// expect: errors true true true true true

import "zstd"
import "strings"

fn main() {
    println($"version ok {zstd.versionNumber() >= 10400}")
    println($"levels ok {zstd.minLevel() < 0 && zstd.defaultLevel() >= 1 && zstd.maxLevel() >= 19}")

    // 1. Empty payload round-trip
    let emptyComp = zstd.compress("").unwrap()
    println($"empty roundtrip {len(emptyComp) > 0 && zstd.decompress(&emptyComp).unwrap() == ""}")

    // 2. Compression levels (negative fast, default, high)
    let sample = strings.repeat("Zstandard balances speed and compression ratio.\n", 80)
    var lvlOk = true
    for lvl in [-3, 1, 3, 9, 15] {
        let c = zstd.compressLevel(&sample, lvl).unwrap()
        if zstd.decompress(&c).unwrap() != sample { lvlOk = false }
    }
    println($"levels roundtrip {lvlOk}")

    // 3. Large (> 200 KiB) binary + repetitive payload
    var big = ""
    for i in 0..250000 {
        big.addByte(byte((i * 17 + (i / 131)) & 255))
    }
    let bigComp = zstd.compress(&big).unwrap()
    println($"large 250k {len(bigComp) < len(big) && zstd.decompress(&bigComp).unwrap() == big}")

    // 4. Concatenated multi-frame zstd stream
    let f1 = zstd.compress("frame one; ").unwrap()
    let f2 = zstd.compress("frame two; ").unwrap()
    let f3 = zstd.compress("frame three!").unwrap()
    let multi = f1 + f2 + f3
    println($"multiframe {zstd.decompress(&multi).unwrap() == "frame one; frame two; frame three!"}")

    // 5. Streaming Compressor + Decompressor across small chunks
    var comp = zstd.newCompressor(3).unwrap()
    comp.setChecksum(true).unwrap()
    var sComp = ""
    var pos = 0
    while pos < len(big) {
        let end = if pos + 11117 < len(big) { pos + 11117 } else { len(big) }
        sComp += comp.write(big[pos..end]).unwrap()
        pos = end
    }
    sComp += comp.finish().unwrap()
    var decomp = zstd.newDecompressor().unwrap()
    var sOut = ""
    pos = 0
    while pos < len(sComp) {
        let end = if pos + 251 < len(sComp) { pos + 251 } else { len(sComp) }
        sOut += decomp.write(sComp[pos..end]).unwrap()
        pos = end
    }
    decomp.finish().unwrap()
    println($"streaming roundtrip {sOut == big && decomp.isDone()}")

    // 6. Streaming flush
    var sc = zstd.newCompressor(1).unwrap()
    var sd = zstd.newDecompressor().unwrap()
    let c1 = sc.write("chunk-1|").unwrap() + sc.flush().unwrap()
    let o1 = sd.write(&c1).unwrap()
    let c2 = sc.write("chunk-2").unwrap() + sc.finish().unwrap()
    let o2 = sd.write(&c2).unwrap()
    sd.finish().unwrap()
    println($"streaming flush {o1 == "chunk-1|" && o2 == "chunk-2"}")

    // 7. Frame checksum detects bit flip in trailer
    var cchk = zstd.newCompressor(3).unwrap()
    cchk.setChecksum(true).unwrap()
    let framed = cchk.write("integrity check payload").unwrap() + cchk.finish().unwrap()
    var flipped = strToBytes(&framed)
    flipped[len(flipped) - 1] = flipped[len(flipped) - 1] ^ byte(1)
    let badFramed = strFromBytes(&flipped)
    println($"checksum detects flip {zstd.decompress(&badFramed).isErr()}")

    // 8. Decompression bomb / maxOut limit checks
    let bigText = strings.repeat("Z", 150000)
    let bigTextComp = zstd.compress(&bigText).unwrap()
    println($"maxOut exact {zstd.decompressMax(&bigTextComp, 150000).unwrap() == bigText}")
    println($"maxOut overflow {zstd.decompressMax(&bigTextComp, 149999).isErr()}")

    // 9. Error paths: empty, corrupt, truncated, bad level, double finish
    let errEmpty = zstd.decompress("").isErr()
    let errCorrupt = zstd.decompress("definitely not zstd").isErr()
    let errTrunc = zstd.decompress(bigComp[0..len(bigComp) - 4]).isErr()
    let errLevel = zstd.compressLevel("abc", zstd.maxLevel() + 10).isErr()
    let errAgain = comp.finish().isErr()
    println($"errors {errEmpty} {errCorrupt} {errTrunc} {errLevel} {errAgain}")
}
