// hpack: RFC 7541 HPACK header compression for HTTP/2.
//
// Strict decoder with bounded header-list size (defends against HPACK bombs),
// 4-bit nibble Huffman DFA with exact RFC 7541 section 5.2 EOS/padding checks,
// and an encoder with static/dynamic table lookup, Huffman encoding and
// never-indexed protection for sensitive headers.
import "hpack_data" as hd

type VB = vector[byte]

fn appendStrSimd(dst: mut &[]byte, s: &str) {
    let n = len(s)
    if n == 0 { return }
    let at = bytesGrow(dst, n)
    var i = 0
    while i + 32 <= n {
        VB.load(s, i).store(dst, at + i)
        i += 32
    }
    while i < n {
        dst[at + i] = s[i]
        i += 1
    }
}

pub type Field = value record {
    pub name: str
    pub value: str
}

pub type Error = value closed {
    Truncated
    BadIndex
    BadInt
    BadHuffman
    TableSize
    TooLarge
    TooMany
}

pub fn (e: Error) toStr(): str {
    match e {
        Error.Truncated { return "truncated HPACK block" }
        Error.BadIndex { return "invalid HPACK index" }
        Error.BadInt { return "invalid HPACK integer" }
        Error.BadHuffman { return "invalid HPACK Huffman string" }
        Error.TableSize { return "invalid HPACK dynamic table size update" }
        Error.TooLarge { return "header list too large" }
        Error.TooMany { return "too many header fields" }
    }
}

// ---------------------------------------------------------------- dynamic table

// Dynamic table: entries stored oldest-first in ents[head..len(ents)].
// Index 0 in HPACK dynamic numbering (index 62 overall) is ents[len(ents) - 1].
type DynTable = record {
    ents: []Field
    head: int
    size: int          // sum of (len(name) + len(value) + 32)
    maxSize: int
}

fn newDynTable(maxSize: int): DynTable {
    return DynTable{ents: [], head: 0, size: 0, maxSize: maxSize}
}

fn (t: &DynTable) count(): int { return len(t.ents) - t.head }

fn (t: mut &DynTable) evictTo(limit: int) {
    while t.size > limit && t.head < len(t.ents) {
        let e = &t.ents[t.head]
        t.size -= len(e.name) + len(e.value) + 32
        t.ents[t.head] = Field{name: "", value: ""}
        t.head += 1
    }
    if t.head == len(t.ents) {
        t.ents = []
        t.head = 0
        t.size = 0
    } else if t.head >= 64 && t.head * 2 >= len(t.ents) {
        let keep = len(t.ents) - t.head
        var next: []Field = withCapacity(keep)
        for i in t.head..len(t.ents) {
            append(mut &next, replace(mut &t.ents[i], Field{name: "", value: ""}))
        }
        t.ents = next
        t.head = 0
    }
}

fn (t: mut &DynTable) setMaxSize(n: int) {
    t.maxSize = n
    t.evictTo(n)
}

fn (t: mut &DynTable) add(name: &str, value: &str) {
    let esize = len(name) + len(value) + 32
    if esize > t.maxSize {
        t.evictTo(0)
        return
    }
    t.evictTo(t.maxSize - esize)
    append(mut &t.ents, Field{name: name.clone(), value: value.clone()})
    t.size += esize
}

// ---------------------------------------------------------------- integer & Huffman codec

const MAX_INT = 2147483647

type IntRes = value record {
    val: int
    next: int
}

// Decodes an RFC 7541 section 5.1 integer with an N-bit prefix starting at data[pos].
fn decodeInt(data: &[byte], pos: int, prefixBits: int): Result[IntRes, Error] {
    if pos >= len(data) { return Err(Error.Truncated) }
    let mask = (1 << prefixBits) - 1
    var val = int(data[pos]) & mask
    var i = pos + 1
    if val < mask { return Ok(IntRes{val: val, next: i}) }
    var shift = 0
    var steps = 0
    while true {
        if i >= len(data) { return Err(Error.Truncated) }
        if steps >= 5 { return Err(Error.BadInt) }
        let b = int(data[i])
        i += 1
        let chunk = b & 0x7f
        if shift >= 28 && chunk > 7 { return Err(Error.BadInt) }
        let add = chunk << shift
        if val > MAX_INT - add { return Err(Error.BadInt) }
        val += add
        if (b & 0x80) == 0 { return Ok(IntRes{val: val, next: i}) }
        shift += 7
        steps += 1
    }
    return Err(Error.BadInt)
}

fn encodeInt(out: mut &[]byte, prefixByte: int, prefixBits: int, val: int) {
    let mask = (1 << prefixBits) - 1
    if val < mask {
        append(out, byte(prefixByte | val))
        return
    }
    append(out, byte(prefixByte | mask))
    var v = val - mask
    while v >= 128 {
        append(out, byte((v & 0x7f) | 0x80))
        v = v >> 7
    }
    append(out, byte(v))
}

// Decodes an RFC 7541 section 5.2 Huffman-encoded byte slice, bounded by maxOut bytes.
pub fn decodeHuffman(src: &[byte], maxOut: int): Result[str, Error] {
    let n = len(src)
    if n == 0 { return Ok("") }
    var cap = n * 2
    if cap > maxOut { cap = maxOut }
    if cap < 16 { cap = 16 }
    var out = array(cap, byte(0))
    var outN = 0
    var state = 0
    for i in 0..n {
        let b = int(src[i])
        // high nibble
        let t1 = int(hd.HUFF_DFA[state * 16 + (b >> 4)])
        if (t1 & hd.HUFF_FAIL) != 0 { return Err(Error.BadHuffman) }
        if (t1 & hd.HUFF_EMIT) != 0 {
            if outN >= maxOut { return Err(Error.TooLarge) }
            if outN >= len(out) {
                var nc = len(out) * 2
                if nc > maxOut { nc = maxOut }
                var nb = array(nc, byte(0))
                var k = 0
                while k + 32 <= outN {
                    VB.load(&out, k).store(mut &nb, k)
                    k += 32
                }
                while k < outN { nb[k] = out[k]; k += 1 }
                out = nb
            }
            out[outN] = byte((t1 >> 8) & 0xff)
            outN += 1
        }
        state = t1 & 0xff
        // low nibble
        let t2 = int(hd.HUFF_DFA[state * 16 + (b & 0x0f)])
        if (t2 & hd.HUFF_FAIL) != 0 { return Err(Error.BadHuffman) }
        if (t2 & hd.HUFF_EMIT) != 0 {
            if outN >= maxOut { return Err(Error.TooLarge) }
            if outN >= len(out) {
                var nc = len(out) * 2
                if nc > maxOut { nc = maxOut }
                var nb = array(nc, byte(0))
                var k = 0
                while k + 32 <= outN {
                    VB.load(&out, k).store(mut &nb, k)
                    k += 32
                }
                while k < outN { nb[k] = out[k]; k += 1 }
                out = nb
            }
            out[outN] = byte((t2 >> 8) & 0xff)
            outN += 1
        }
        state = t2 & 0xff
    }
    if hd.HUFF_ACCEPT[state] == byte(0) { return Err(Error.BadHuffman) }
    return Ok(strFromBytes(&out[0..outN]))
}

// Exact encoded byte length of s under RFC 7541 Huffman coding.
pub fn huffmanLen(s: &str): int {
    var bits = 0
    for i in 0..len(s) {
        bits += int(hd.HUFF_LEN[int(s[i])])
    }
    return (bits + 7) / 8
}

// Appends the Huffman encoding of s (with trailing 1-bit EOS padding) to out,
// knowing exact output length hlen in advance.
fn encodeHuffmanLen(out: mut &[]byte, s: &str, hlen: int) {
    if hlen == 0 { return }
    let base = bytesGrow(out, hlen)
    var pos = base
    var acc: u64 = 0
    var nbits = 0
    for i in 0..len(s) {
        let idx = int(s[i])
        let code = u64(hd.HUFF_CODE[idx])
        let clen = int(hd.HUFF_LEN[idx])
        acc = (acc << clen) | code
        nbits += clen
        if nbits >= 32 {
            nbits -= 32
            let w = acc >> nbits
            out[pos] = byte((w >> 24) & 0xff)
            out[pos + 1] = byte((w >> 16) & 0xff)
            out[pos + 2] = byte((w >> 8) & 0xff)
            out[pos + 3] = byte(w & 0xff)
            pos += 4
        }
    }
    while nbits >= 8 {
        nbits -= 8
        out[pos] = byte((acc >> nbits) & 0xff)
        pos += 1
    }
    if nbits > 0 {
        let pad = 8 - nbits
        out[pos] = byte(((acc << pad) | ((u64(1) << pad) - 1)) & 0xff)
    }
}

// Appends the Huffman encoding of s (with trailing 1-bit EOS padding) to out.
pub fn encodeHuffman(out: mut &[]byte, s: &str) {
    encodeHuffmanLen(out, s, huffmanLen(s))
}

type StrRes = value record {
    s: str
    next: int
}

fn decodeString(data: &[byte], pos: int, maxOut: int): Result[StrRes, Error] {
    if pos >= len(data) { return Err(Error.Truncated) }
    let huff = (int(data[pos]) & 0x80) != 0
    let lr = try decodeInt(data, pos, 7)
    let slen = lr.val
    let start = lr.next
    if slen < 0 || slen > len(data) - start { return Err(Error.Truncated) }
    if huff {
        let s = try decodeHuffman(&data[start..start + slen], maxOut)
        return Ok(StrRes{s: s, next: start + slen})
    }
    if slen > maxOut { return Err(Error.TooLarge) }
    return Ok(StrRes{s: strFromBytes(&data[start..start + slen]), next: start + slen})
}

fn encodeString(out: mut &[]byte, s: &str) {
    let hlen = huffmanLen(s)
    if hlen < len(s) {
        encodeInt(out, 0x80, 7, hlen)
        encodeHuffmanLen(out, s, hlen)
    } else {
        encodeInt(out, 0x00, 7, len(s))
        appendStrSimd(out, s)
    }
}

// ---------------------------------------------------------------- decoder

pub type Decoder = record {
    dyn: DynTable
    hardMax: int        // maximum allowed dynamic table size (SETTINGS_HEADER_TABLE_SIZE)
    needSizeUpdate: bool // peer ACKed a lower SETTINGS_HEADER_TABLE_SIZE (RFC 7541 4.2)
}

pub fn newDecoder(maxTableSize: int): Decoder {
    let m = if maxTableSize < 0 { 0 } else { maxTableSize }
    return Decoder{dyn: newDynTable(m), hardMax: m, needSizeUpdate: false}
}

// Starts a decoder that accepts the RFC default 4096 table until SETTINGS ACK,
// while also allowing an advertised size > 4096 as soon as the peer reacts.
pub fn newDecoderWithDefault(advertisedMax: int): Decoder {
    let adv = if advertisedMax < 0 { 0 } else { advertisedMax }
    let hm = if adv > 4096 { adv } else { 4096 }
    return Decoder{dyn: newDynTable(4096), hardMax: hm, needSizeUpdate: false}
}

// Updates the maximum allowed dynamic table size (after peer ACKs our SETTINGS).
pub fn (d: mut &Decoder) setMaxTableSize(n: int) {
    let m = if n < 0 { 0 } else { n }
    if m < d.dyn.maxSize {
        d.needSizeUpdate = true
    }
    d.hardMax = m
    if d.dyn.maxSize > m { d.dyn.setMaxSize(m) }
}

pub fn (d: &Decoder) dynamicSize(): int { return d.dyn.size }

fn (d: &Decoder) lookup(idx: int): Result[Field, Error] {
    if idx <= 0 { return Err(Error.BadIndex) }
    if idx <= hd.STATIC_COUNT {
        return Ok(Field{name: hd.STATIC_NAME[idx].clone(), value: hd.STATIC_VAL[idx].clone()})
    }
    let di = idx - hd.STATIC_COUNT - 1
    let cnt = d.dyn.count()
    if di >= cnt { return Err(Error.BadIndex) }
    let e = &d.dyn.ents[len(d.dyn.ents) - 1 - di]
    return Ok(Field{name: e.name.clone(), value: e.value.clone()})
}

fn (d: &Decoder) lookupName(idx: int): Result[str, Error] {
    if idx <= 0 { return Err(Error.BadIndex) }
    if idx <= hd.STATIC_COUNT { return Ok(hd.STATIC_NAME[idx].clone()) }
    let di = idx - hd.STATIC_COUNT - 1
    let cnt = d.dyn.count()
    if di >= cnt { return Err(Error.BadIndex) }
    return Ok(d.dyn.ents[len(d.dyn.ents) - 1 - di].name.clone())
}

// Decodes a complete HPACK header block. Enforces RFC 7541 section 4.1 list
// size (sum of len(name) + len(value) + 32) <= maxListBytes and field count
// <= maxFields while decoding, stopping immediately on HPACK bombs.
pub fn (d: mut &Decoder) decode(data: &[byte], maxListBytes: int, maxFields: int): Result[[]Field, Error] {
    var out: []Field = withCapacity(8)
    var pos = 0
    var listBytes = 0
    var allowSizeUpdate = true
    var sawSizeUpdate = false
    while pos < len(data) {
        let b = int(data[pos])
        if (b & 0xe0) != 0x20 && d.needSizeUpdate && !sawSizeUpdate {
            return Err(Error.TableSize)
        }
        if (b & 0x80) != 0 {
            // 6.1 Indexed Header Field
            allowSizeUpdate = false
            var idx = 0
            if (b & 0x7f) < 127 {
                idx = b & 0x7f
                pos += 1
            } else {
                let r = try decodeInt(data, pos, 7)
                pos = r.next
                idx = r.val
            }
            if len(out) >= maxFields { return Err(Error.TooMany) }
            let f = try d.lookup(idx)
            let cost = len(f.name) + len(f.value) + 32
            if listBytes + cost > maxListBytes { return Err(Error.TooLarge) }
            listBytes += cost
            append(mut &out, f)
        } else if (b & 0xc0) == 0x40 {
            // 6.2.1 Literal Header Field with Incremental Indexing
            allowSizeUpdate = false
            let r = try decodeInt(data, pos, 6)
            pos = r.next
            if len(out) >= maxFields { return Err(Error.TooMany) }
            let rem = maxListBytes - listBytes - 32
            if rem < 0 { return Err(Error.TooLarge) }
            var name = ""
            if r.val == 0 {
                let StrRes{s: ns, next: nnext} = try decodeString(data, pos, rem)
                name = ns
                pos = nnext
            } else {
                name = try d.lookupName(r.val)
                if len(name) > rem { return Err(Error.TooLarge) }
            }
            let StrRes{s: vs, next: vnext} = try decodeString(data, pos, rem - len(name))
            pos = vnext
            let cost = len(name) + len(vs) + 32
            if listBytes + cost > maxListBytes { return Err(Error.TooLarge) }
            listBytes += cost
            d.dyn.add(&name, &vs)
            append(mut &out, Field{name: name, value: vs})
        } else if (b & 0xe0) == 0x20 {
            // 6.3 Dynamic Table Size Update (only at the start of a header block)
            if !allowSizeUpdate { return Err(Error.TableSize) }
            let r = try decodeInt(data, pos, 5)
            pos = r.next
            if r.val > d.hardMax { return Err(Error.TableSize) }
            d.dyn.setMaxSize(r.val)
            sawSizeUpdate = true
            d.needSizeUpdate = false
        } else {
            // 6.2.2 Literal without Indexing (0x00) / 6.2.3 Never Indexed (0x10)
            allowSizeUpdate = false
            let r = try decodeInt(data, pos, 4)
            pos = r.next
            if len(out) >= maxFields { return Err(Error.TooMany) }
            let rem = maxListBytes - listBytes - 32
            if rem < 0 { return Err(Error.TooLarge) }
            var name = ""
            if r.val == 0 {
                let StrRes{s: ns, next: nnext} = try decodeString(data, pos, rem)
                name = ns
                pos = nnext
            } else {
                name = try d.lookupName(r.val)
                if len(name) > rem { return Err(Error.TooLarge) }
            }
            let StrRes{s: vs, next: vnext} = try decodeString(data, pos, rem - len(name))
            pos = vnext
            let cost = len(name) + len(vs) + 32
            if listBytes + cost > maxListBytes { return Err(Error.TooLarge) }
            listBytes += cost
            append(mut &out, Field{name: name, value: vs})
        }
    }
    return Ok(out)
}

// ---------------------------------------------------------------- encoder

pub type Encoder = record {
    dyn: DynTable
    hardMax: int        // our own dynamic table cap (default 4096)
    sizeDirty: bool     // peer changed SETTINGS_HEADER_TABLE_SIZE; emit update(s) next block
    minPending: int     // lowest size seen since last block (RFC 7541 4.2)
    targetSize: int     // final target size to emit
}

pub fn newEncoder(maxTableSize: int): Encoder {
    let m = if maxTableSize < 0 { 0 } else { maxTableSize }
    return Encoder{dyn: newDynTable(m), hardMax: m, sizeDirty: false, minPending: m, targetSize: m}
}

// Applies the peer's SETTINGS_HEADER_TABLE_SIZE (capped at our hardMax).
pub fn (e: mut &Encoder) setMaxTableSize(n: int) {
    var m = if n < 0 { 0 } else { n }
    if m > e.hardMax { m = e.hardMax }
    if !e.sizeDirty {
        if m == e.dyn.maxSize { return }
        e.sizeDirty = true
        e.minPending = m
        e.targetSize = m
    } else {
        if m < e.minPending { e.minPending = m }
        e.targetSize = m
    }
    e.dyn.setMaxSize(m)
}

fn isSensitive(name: &str): bool {
    let n = len(name)
    if n != 6 && n != 10 && n != 13 && n != 19 { return false }
    if n == 6 { return name == "cookie" }
    if n == 10 { return name == "set-cookie" }
    if n == 13 { return name == "authorization" }
    return name == "proxy-authorization"
}

// Whether a header is worth indexing into the encoder's dynamic table.
fn shouldIndex(name: &str, value: &str): bool {
    let n = len(name)
    // Skip high-cardinality per-request headers that churn the table
    if n == 5 && name == ":path" && len(value) > 64 { return false }
    if n == 14 && name == "content-length" { return false }
    if n == 12 && name == "x-request-id" { return false }
    if len(name) + len(value) + 32 > 1024 { return false }
    return true
}

type SearchRes = value record {
    idx: int
    exact: bool
}

// O(1) RFC 7541 Appendix A static table lookup dispatched by (name[0], len(name)).
fn searchStatic(name: &str, value: &str): SearchRes {
    let n = len(name)
    if n < 3 || n > 27 { return SearchRes{idx: 0, exact: false} }
    let c0 = name[0]
    let empty = len(value) == 0
    if c0 == ':' {
        if n == 7 {
            if name == ":status" {
                if len(value) == 3 {
                    if value == "200" { return SearchRes{idx: 8, exact: true} }
                    if value == "204" { return SearchRes{idx: 9, exact: true} }
                    if value == "206" { return SearchRes{idx: 10, exact: true} }
                    if value == "304" { return SearchRes{idx: 11, exact: true} }
                    if value == "400" { return SearchRes{idx: 12, exact: true} }
                    if value == "404" { return SearchRes{idx: 13, exact: true} }
                    if value == "500" { return SearchRes{idx: 14, exact: true} }
                }
                return SearchRes{idx: 8, exact: false}
            }
            if name == ":method" {
                if value == "GET" { return SearchRes{idx: 2, exact: true} }
                if value == "POST" { return SearchRes{idx: 3, exact: true} }
                return SearchRes{idx: 2, exact: false}
            }
            if name == ":scheme" {
                if value == "http" { return SearchRes{idx: 6, exact: true} }
                if value == "https" { return SearchRes{idx: 7, exact: true} }
                return SearchRes{idx: 6, exact: false}
            }
        } else if n == 5 && name == ":path" {
            if value == "/" { return SearchRes{idx: 4, exact: true} }
            if value == "/index.html" { return SearchRes{idx: 5, exact: true} }
            return SearchRes{idx: 4, exact: false}
        } else if n == 10 && name == ":authority" {
            return SearchRes{idx: 1, exact: empty}
        }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'c' {
        if n == 12 && name == "content-type" { return SearchRes{idx: 31, exact: empty} }
        if n == 14 && name == "content-length" { return SearchRes{idx: 28, exact: empty} }
        if n == 13 {
            if name == "cache-control" { return SearchRes{idx: 24, exact: empty} }
            if name == "content-range" { return SearchRes{idx: 30, exact: empty} }
        }
        if n == 6 && name == "cookie" { return SearchRes{idx: 32, exact: empty} }
        if n == 16 {
            if name == "content-encoding" { return SearchRes{idx: 26, exact: empty} }
            if name == "content-language" { return SearchRes{idx: 27, exact: empty} }
            if name == "content-location" { return SearchRes{idx: 29, exact: empty} }
        }
        if n == 19 && name == "content-disposition" { return SearchRes{idx: 25, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'd' {
        if n == 4 && name == "date" { return SearchRes{idx: 33, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'a' {
        if n == 6 && name == "accept" { return SearchRes{idx: 19, exact: empty} }
        if n == 15 {
            if name == "accept-encoding" {
                return SearchRes{idx: 16, exact: value == "gzip, deflate"}
            }
            if name == "accept-language" { return SearchRes{idx: 17, exact: empty} }
        }
        if n == 14 && name == "accept-charset" { return SearchRes{idx: 15, exact: empty} }
        if n == 13 {
            if name == "accept-ranges" { return SearchRes{idx: 18, exact: empty} }
            if name == "authorization" { return SearchRes{idx: 23, exact: empty} }
        }
        if n == 3 && name == "age" { return SearchRes{idx: 21, exact: empty} }
        if n == 5 && name == "allow" { return SearchRes{idx: 22, exact: empty} }
        if n == 27 && name == "access-control-allow-origin" { return SearchRes{idx: 20, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'e' {
        if n == 4 && name == "etag" { return SearchRes{idx: 34, exact: empty} }
        if n == 6 && name == "expect" { return SearchRes{idx: 35, exact: empty} }
        if n == 7 && name == "expires" { return SearchRes{idx: 36, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 's' {
        if n == 6 && name == "server" { return SearchRes{idx: 54, exact: empty} }
        if n == 10 && name == "set-cookie" { return SearchRes{idx: 55, exact: empty} }
        if n == 25 && name == "strict-transport-security" { return SearchRes{idx: 56, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'i' {
        if n == 8 {
            if name == "if-match" { return SearchRes{idx: 39, exact: empty} }
            if name == "if-range" { return SearchRes{idx: 42, exact: empty} }
        }
        if n == 13 && name == "if-none-match" { return SearchRes{idx: 41, exact: empty} }
        if n == 17 && name == "if-modified-since" { return SearchRes{idx: 40, exact: empty} }
        if n == 19 && name == "if-unmodified-since" { return SearchRes{idx: 43, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'l' {
        if n == 4 && name == "link" { return SearchRes{idx: 45, exact: empty} }
        if n == 8 && name == "location" { return SearchRes{idx: 46, exact: empty} }
        if n == 13 && name == "last-modified" { return SearchRes{idx: 44, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'r' {
        if n == 5 && name == "range" { return SearchRes{idx: 50, exact: empty} }
        if n == 7 {
            if name == "referer" { return SearchRes{idx: 51, exact: empty} }
            if name == "refresh" { return SearchRes{idx: 52, exact: empty} }
        }
        if n == 11 && name == "retry-after" { return SearchRes{idx: 53, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'p' {
        if n == 18 && name == "proxy-authenticate" { return SearchRes{idx: 48, exact: empty} }
        if n == 19 && name == "proxy-authorization" { return SearchRes{idx: 49, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'v' {
        if n == 4 && name == "vary" { return SearchRes{idx: 59, exact: empty} }
        if n == 3 && name == "via" { return SearchRes{idx: 60, exact: empty} }
        return SearchRes{idx: 0, exact: false}
    }
    if c0 == 'h' && n == 4 && name == "host" { return SearchRes{idx: 38, exact: empty} }
    if c0 == 'u' && n == 10 && name == "user-agent" { return SearchRes{idx: 58, exact: empty} }
    if c0 == 'f' && n == 4 && name == "from" { return SearchRes{idx: 37, exact: empty} }
    if c0 == 'm' && n == 12 && name == "max-forwards" { return SearchRes{idx: 47, exact: empty} }
    if c0 == 't' && n == 17 && name == "transfer-encoding" { return SearchRes{idx: 57, exact: empty} }
    if c0 == 'w' && n == 16 && name == "www-authenticate" { return SearchRes{idx: 61, exact: empty} }
    return SearchRes{idx: 0, exact: false}
}

fn (e: &Encoder) searchDynamic(name: &str, value: &str, sensitive: bool): SearchRes {
    let n = len(e.dyn.ents)
    if n == e.dyn.head { return SearchRes{idx: 0, exact: false} }
    let nlen = len(name)
    let vlen = len(value)
    var nameIdx = 0
    var i = n - 1
    while i >= e.dyn.head {
        let ent = &e.dyn.ents[i]
        if len(ent.name) == nlen && ent.name == name {
            let idx = hd.STATIC_COUNT + (n - i)
            if !sensitive && len(ent.value) == vlen && ent.value == value {
                return SearchRes{idx: idx, exact: true}
            }
            if nameIdx == 0 { nameIdx = idx }
        }
        i -= 1
    }
    return SearchRes{idx: nameIdx, exact: false}
}

// Encodes fields into an HPACK header block appended to out.
pub fn (e: mut &Encoder) encode(fields: &[]Field, out: mut &[]byte) {
    if e.sizeDirty {
        if e.minPending < e.targetSize {
            encodeInt(out, 0x20, 5, e.minPending)
        }
        encodeInt(out, 0x20, 5, e.targetSize)
        e.sizeDirty = false
    }
    for f in fields {
        let sens = isSensitive(&f.name)
        var bestIdx = 0
        var checkedDyn = false
        if !sens && len(f.value) > 0 && len(f.name) > 0 && f.name[0] != ':' {
            if len(f.name) == 14 && f.name == "content-length" {
                checkedDyn = true
            } else {
                checkedDyn = true
                let dr = e.searchDynamic(&f.name, &f.value, false)
                if dr.exact {
                    if dr.idx < 127 { append(out, byte(0x80 | dr.idx)) } else { encodeInt(out, 0x80, 7, dr.idx) }
                    continue
                }
                bestIdx = dr.idx
            }
        }
        let sr = searchStatic(&f.name, &f.value)
        if sr.exact && !sens {
            if sr.idx < 127 { append(out, byte(0x80 | sr.idx)) } else { encodeInt(out, 0x80, 7, sr.idx) }
            continue
        }
        if sr.idx > 0 { bestIdx = sr.idx }
        if !checkedDyn {
            let dr = e.searchDynamic(&f.name, &f.value, sens)
            if dr.exact && !sens {
                if dr.idx < 127 { append(out, byte(0x80 | dr.idx)) } else { encodeInt(out, 0x80, 7, dr.idx) }
                continue
            }
            if bestIdx == 0 { bestIdx = dr.idx }
        }
        let esize = len(f.name) + len(f.value) + 32
        if !sens && esize <= e.dyn.maxSize && shouldIndex(&f.name, &f.value) {
            // Literal with Incremental Indexing (0x40, 6-bit prefix)
            encodeInt(out, 0x40, 6, bestIdx)
            if bestIdx == 0 { encodeString(out, &f.name) }
            encodeString(out, &f.value)
            e.dyn.add(&f.name, &f.value)
        } else {
            // Never Indexed (0x10) for sensitive headers, else Without Indexing (0x00)
            let pfx = if sens { 0x10 } else { 0x00 }
            encodeInt(out, pfx, 4, bestIdx)
            if bestIdx == 0 { encodeString(out, &f.name) }
            encodeString(out, &f.value)
        }
    }
}
