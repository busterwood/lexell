// tds: the Tabular Data Stream protocol of Microsoft SQL Server, TDS 7.4,
// written from Microsoft's specification [MS-TDS] (design/tds.md). The API
// for programs is `sqlserver`; this module is the protocol under it.
//
//   - packets: the 8-byte header (type, status with EOM, length, SPID,
//     packet id); a message is cut into packets of the negotiated size and
//     joined again on the way in (packets, parseHeader).
//   - PRELOGIN (preloginRequest, parsePrelogin) and the TLS handshake carried
//     inside PRELOGIN packets (tls.lxl's memory mode), then TLS records
//     straight on the socket: for the whole connection (Encrypt=yes), or for
//     the LOGIN7 packet only when the client and the server both have
//     encryption off (Encrypt=no).
//   - LOGIN7 with SQL authentication (login7; the password scrambled as
//     MS-TDS 2.2.6.4 says, and sent inside TLS).
//   - SQLBatch (sqlBatch: ALL_HEADERS with the transaction descriptor, then
//     the text in UTF-16LE).
//   - RPC to sp_executesql (executeSql) with typed parameters (Param:
//     intParam, floatParam, bitParam, textParam, bytesParam, decimalParam,
//     nullParam and typeInfoOf from a SQL type name), OUTPUT ones too, and
//     table-valued ones (tableParam); RPC to a procedure by its name
//     (procCall).
//   - bulk load: INSERT BULK, then the rows in a BULK_LOAD message
//     (bulkColumnsQuery, bulkWriter, bulkLoad, Session.bulkData), or sent
//     a packet at a time as they are encoded (Session.bulkSend, sendPart),
//     and ended unloaded by IGNORE (cancelPart).
//   - Transaction Manager requests (tmRequest): begin, commit, rollback.
//   - the reply's tokens (decode): COLMETADATA, ROW, NBCROW, DONE,
//     DONEPROC, DONEINPROC (every row count kept), ERROR, INFO, LOGINACK,
//     ENVCHANGE, FEATUREEXTACK, ORDER, RETURNSTATUS, RETURNVALUE, and the
//     ones skipped by their length (COLINFO, TABNAME, SSPI, SESSIONSTATE,
//     FEDAUTHINFO, OFFSET).
//   - the values: tinyint, smallint, int, bigint (and INTN), real and float
//     (FLTN, exact), bit (BITN), nchar and nvarchar (UTF-16LE, strict),
//     char and varchar with a UTF-8 collation or code page 1252 or
//     ISO-8859-1, binary and varbinary as bytes; (max) types (PLP chunks)
//     and text, ntext and image too; decimal and numeric (Decimal, from the
//     sign and magnitude), money and smallmoney (Decimal of scale 4), date,
//     time(n), datetime2(n), datetimeoffset(n) (time's civil types),
//     datetime and smalldatetime, uniqueidentifier (canonical text), xml
//     (text). A varchar of another code page, sql_variant, UDTs and every
//     other type decode to Cell.Failed with a message naming the code page
//     or the type: reading that cell is an error, the rest of the row is
//     not. cellText gives a cell's text as SQL Server and ODBC write it.
//   - Session: a logged-in connection (open, batch, executeSql, transact),
//     its state (database, language, collation, packet size, transaction
//     descriptor, ...) kept from ENVCHANGE, and the last call's ERRORs and
//     INFOs.
//
// The decoder never traps on what the server sends: every length and count
// is checked against the bytes there are before it is used, nothing is
// allocated from a length alone, and a malformed reply is Err(E_PROTOCOL).
// A reply is limited in size (Session.maxReply) and in cells decoded
// (maxReply / 8).
//
// Errors are sqldialect.DbError: E_PROTOCOL (the server's bytes make no
// sense), E_IO (the socket or TLS failed, the server closed the connection),
// E_CANCELLED and E_TIMEOUT (the task's cancellation or deadline), E_LIMIT,
// E_INPUT; and the server's own errors with its error number as the code.
// After an error on the wire (anything but the server's own ERROR tokens and
// E_INPUT) the session is broken: its later calls fail with E_IO at once.

import "net"
import "tls"
import "io"
import "strings"
import "sqldialect"
import "math"
import "codepage"
import "time"
import "sqlrows"

pub type Error = sqldialect.DbError

// Packet types (MS-TDS 2.2.3.1.1).
pub const PT_SQLBATCH = 1
pub const PT_RPC = 3
pub const PT_REPLY = 4
pub const PT_ATTENTION = 6
pub const PT_LOGIN7 = 16
pub const PT_PRELOGIN = 18

pub const STATUS_EOM = 1
pub const STATUS_IGNORE = 2       // with EOM: the server drops the message (MS-TDS 2.2.3.1.2)
pub const STATUS_RESET = 8        // RESETCONNECTION, on a request's first packet (MS-TDS 2.2.3.1.2)
pub const HEADER = 8
pub const MIN_PACKET = 512
pub const MAX_PACKET = 32767
pub const DEFAULT_PACKET = 4096

pub const TDS74 = 0x74000004

// PRELOGIN's ENCRYPTION values.
pub const ENCRYPT_OFF = 0
pub const ENCRYPT_ON = 1
pub const ENCRYPT_NOT_SUP = 2
pub const ENCRYPT_REQ = 3

// Tokens (MS-TDS 2.2.7).
pub const TK_OFFSET = 0x78
pub const TK_RETURNSTATUS = 0x79
pub const TK_COLMETADATA = 0x81
pub const TK_ALTMETADATA = 0x88
pub const TK_DATACLASSIFICATION = 0xA3
pub const TK_TABNAME = 0xA4
pub const TK_COLINFO = 0xA5
pub const TK_ORDER = 0xA9
pub const TK_ERROR = 0xAA
pub const TK_INFO = 0xAB
pub const TK_RETURNVALUE = 0xAC
pub const TK_LOGINACK = 0xAD
pub const TK_FEATUREEXTACK = 0xAE
pub const TK_ROW = 0xD1
pub const TK_NBCROW = 0xD2
pub const TK_ALTROW = 0xD3
pub const TK_ENVCHANGE = 0xE3
pub const TK_SESSIONSTATE = 0xE4
pub const TK_SSPI = 0xED
pub const TK_FEDAUTHINFO = 0xEE
pub const TK_DONE = 0xFD
pub const TK_DONEPROC = 0xFE
pub const TK_DONEINPROC = 0xFF

// DONE status bits.
pub const DONE_MORE = 0x1
pub const DONE_ERROR = 0x2
pub const DONE_INXACT = 0x4
pub const DONE_COUNT = 0x10
pub const DONE_ATTN = 0x20
pub const DONE_SRVERROR = 0x100

// ENVCHANGE types.
pub const ENV_DATABASE = 1
pub const ENV_LANGUAGE = 2
pub const ENV_CHARSET = 3
pub const ENV_PACKETSIZE = 4
pub const ENV_COLLATION = 7
pub const ENV_BEGINTRAN = 8
pub const ENV_COMMITTRAN = 9
pub const ENV_ROLLBACKTRAN = 10
pub const ENV_TRANENDED = 17
pub const ENV_RESETACK = 18
pub const ENV_ROUTING = 20

// FEATUREEXT ids.
pub const FEATURE_UTF8 = 0x0A

// Data types (MS-TDS 2.2.5.4).
pub const T_NULL = 0x1F
pub const T_INT1 = 0x30
pub const T_BIT = 0x32
pub const T_INT2 = 0x34
pub const T_INT4 = 0x38
pub const T_DATETIM4 = 0x3A
pub const T_FLT4 = 0x3B
pub const T_MONEY = 0x3C
pub const T_DATETIME = 0x3D
pub const T_FLT8 = 0x3E
pub const T_MONEY4 = 0x7A
pub const T_INT8 = 0x7F
pub const T_GUID = 0x24
pub const T_INTN = 0x26
pub const T_DECIMAL = 0x37
pub const T_NUMERIC = 0x3F
pub const T_BITN = 0x68
pub const T_DECIMALN = 0x6A
pub const T_NUMERICN = 0x6C
pub const T_FLTN = 0x6D
pub const T_MONEYN = 0x6E
pub const T_DATETIMN = 0x6F
pub const T_DATEN = 0x28
pub const T_TIMEN = 0x29
pub const T_DATETIME2N = 0x2A
pub const T_DATETIMEOFFSETN = 0x2B
pub const T_CHAR = 0x2F
pub const T_VARCHAR = 0x27
pub const T_BINARY = 0x2D
pub const T_VARBINARY = 0x25
pub const T_BIGVARBIN = 0xA5
pub const T_BIGVARCHR = 0xA7
pub const T_BIGBINARY = 0xAD
pub const T_BIGCHAR = 0xAF
pub const T_NVARCHAR = 0xE7
pub const T_NCHAR = 0xEF
pub const T_XML = 0xF1
pub const T_UDT = 0xF0
pub const T_TEXT = 0x23
pub const T_IMAGE = 0x22
pub const T_NTEXT = 0x63
pub const T_SSVARIANT = 0x62

// How a type's values are framed (Column.framing).
const F_FIXED = 0        // Column.size bytes, never NULL
const F_BYTE = 1         // a length byte (0: NULL)
const F_USHORT = 2       // a 2-byte length (0xFFFF: NULL)
const F_TEXT = 3         // a text pointer (length byte 0: NULL), a timestamp, a 4-byte length
const F_PLP = 4          // partially length-prefixed: an 8-byte total, then chunks
const F_VARIANT = 5      // a 4-byte length (0: NULL)
const F_NONE = 6         // NULLTYPE: no bytes, always NULL

const PLP_NULL: u64 = 0xFFFFFFFFFFFFFFFF
pub const MAX_REPLY = 268435456        // 256 MiB: the default limit of one reply
pub const ABORT_MS = 5000              // how long ATTENTION's acknowledgement is waited for, whatever the task's state

// ---------------------------------------------------------------- errors

fn proto(msg: &str): Error { return sqldialect.dbError(sqldialect.E_PROTOCOL, &("tds: " + msg)) }

fn ioErr(msg: &str): Error { return sqldialect.dbError(sqldialect.E_IO, &("tds: " + msg)) }

fn ioFail(e: io.IoError): Error {
    if e.isCancelled() { return sqldialect.dbError(sqldialect.E_CANCELLED, "tds: cancelled") }
    if e.isTimeout() { return sqldialect.dbError(sqldialect.E_TIMEOUT, "tds: deadline passed") }
    return ioErr(&(e.toStr()))
}

fn tlsFail(e: tls.Error): Error {
    if e.kind == tls.Kind.Cancelled { return sqldialect.dbError(sqldialect.E_CANCELLED, "tds: cancelled") }
    if e.kind == tls.Kind.Timeout { return sqldialect.dbError(sqldialect.E_TIMEOUT, "tds: deadline passed") }
    if e.kind == tls.Kind.Io { return ioErr(&(e.cause.toStr())) }
    return ioErr(&(e.toStr()))
}

// ---------------------------------------------------------------- writing

fn put8(b: mut &[]byte, v: int) { append(b, byte(v & 0xff)) }

fn put16(b: mut &[]byte, v: int) {
    append(b, byte(v & 0xff))
    append(b, byte((v >> 8) & 0xff))
}

fn put32(b: mut &[]byte, v: int) {
    for k in 0..4 { append(b, byte((v >> (8 * k)) & 0xff)) }
}

fn put16be(b: mut &[]byte, v: int) {
    append(b, byte((v >> 8) & 0xff))
    append(b, byte(v & 0xff))
}

fn set16(b: mut &[]byte, at: int, v: int) {
    b[at] = byte(v & 0xff)
    b[at + 1] = byte((v >> 8) & 0xff)
}

fn set32(b: mut &[]byte, at: int, v: int) {
    for k in 0..4 { b[at + k] = byte((v >> (8 * k)) & 0xff) }
}

fn set16be(b: mut &[]byte, at: int, v: int) {
    b[at] = byte((v >> 8) & 0xff)
    b[at + 1] = byte(v & 0xff)
}

// ---------------------------------------------------------------- UTF-16

// s, strict UTF-8, as UTF-16LE code units. Err names the first byte that is
// not valid UTF-8.
pub fn toUtf16(s: &str): Result[[]byte, str] {
    var out: []byte = []
    var i = 0
    while i < len(s) {
        let c = s[i]
        if c < 0x80 {
            append(mut &out, c)
            append(mut &out, byte(0))
            i += 1
            continue
        }
        let d = strings.decodeAt(s, i)
        if !d.ok { return Err("invalid UTF-8 at byte " + i.toStr()) }
        if d.rune >= 0x10000 {
            put16(mut &out, 0xd800 + ((d.rune - 0x10000) >> 10))
            put16(mut &out, 0xdc00 + ((d.rune - 0x10000) & 0x3ff))
        } else {
            put16(mut &out, d.rune)
        }
        i += d.size
    }
    return Ok(out)
}

// UTF-16LE bytes as UTF-8. Err for an odd number of bytes or a surrogate
// that is not part of a pair (SQL Server's nvarchar can hold one).
pub fn fromUtf16(b: &str): Result[str, str] { return utf16Of(&b) }

fn utf16Of(b: &str): Result[str, str] {
    if len(b) % 2 != 0 { return Err("UTF-16 text has an odd number of bytes") }
    var ascii = true
    var k = 0
    while k < len(b) {
        if b[k + 1] != 0 || b[k] >= 0x80 {
            ascii = false
            break
        }
        k += 2
    }
    if ascii {
        var a = array(len(b) / 2, byte(0))
        for j in 0..len(a) { a[j] = b[2 * j] }
        return Ok(strFromBytes(&a))
    }
    var out = newStrBuf()
    var i = 0
    while i < len(b) {
        var u = int(b[i]) | (int(b[i + 1]) << 8)
        if u >= 0xd800 && u <= 0xdfff {
            let lo = if i + 3 < len(b) { int(b[i + 2]) | (int(b[i + 3]) << 8) } else { 0 }
            if u >= 0xdc00 || lo < 0xdc00 || lo > 0xdfff {
                return Err("invalid UTF-16: lone surrogate at unit " + (i / 2).toStr())
            }
            u = 0x10000 + ((u - 0xd800) << 10) + (lo - 0xdc00)
            i += 2
        }
        strings.addRune(mut &out, u)
        i += 2
    }
    return Ok(out.toStr())
}

// ---------------------------------------------------------------- packets

// The packets of one message of type ptype: the payload cut into pieces of
// at most packetSize - 8 bytes, each after its header (SPID 0, packet ids
// from 1, modulo 256); the last one has EOM. An empty payload is one packet.
pub fn packets(ptype: int, payload: &str, packetSize: int): []byte { return packetsWith(ptype, payload, packetSize, 0) }

// packets with first's bits in the first packet's status (STATUS_RESET).
pub fn packetsWith(ptype: int, payload: &str, packetSize: int, first: int): []byte {
    let room = packetSize - HEADER
    var out: []byte = []
    var off = 0
    var id = 1
    while true {
        let n = min(len(payload) - off, room)
        let last = off + n == len(payload)
        put8(mut &out, ptype)
        put8(mut &out, (if last { STATUS_EOM } else { 0 }) | (if id == 1 { first } else { 0 }))
        put16be(mut &out, n + HEADER)
        put16be(mut &out, 0)
        put8(mut &out, id % 256)
        put8(mut &out, 0)
        appendStr(mut &out, payload[off..off + n])
        id += 1
        off += n
        if last { break }
    }
    return out
}

// One packet onto out: its type, status, id (modulo 256) and payload.
fn packetInto(out: mut &[]byte, ptype: int, status: int, id: int, payload: &[byte]) {
    put8(out, ptype)
    put8(out, status)
    put16be(out, len(payload) + HEADER)
    put16be(out, 0)
    put8(out, id % 256)
    put8(out, 0)
    for x in payload { append(out, x) }
}

// A packet header.
pub type Header = value record {
    pub ptype: int
    pub status: int
    pub length: int      // the packet's, header included
    pub spid: int
    pub id: int
}

// The header in the first 8 bytes of h. E_PROTOCOL for a length below 8.
pub fn parseHeader(h: &[byte]): Result[Header, Error] {
    if len(h) < HEADER { return Err(proto("a packet header needs 8 bytes")) }
    // a TLS handshake record (type 22) first: TDS 8.0's strict encryption, which starts with TLS (not supported here: the
    // connection is closed at once, not left waiting for a packet its length asks for)
    if h[0] == 22 && h[1] == 3 { return Err(proto("a TLS record where a TDS packet is expected (encrypt=strict, TDS 8.0, is not supported)")) }
    let n = (int(h[2]) << 8) | int(h[3])
    if n < HEADER { return Err(proto(&("a packet length of " + n.toStr()))) }
    return Ok(Header{ptype: int(h[0]), status: int(h[1]), length: n, spid: (int(h[4]) << 8) | int(h[5]), id: int(h[6])})
}

// ---------------------------------------------------------------- PRELOGIN

const PL_VERSION = 0
const PL_ENCRYPTION = 1
const PL_INSTOPT = 2
const PL_THREADID = 3
const PL_MARS = 4
const PL_TERMINATOR = 0xFF

// PRELOGIN's payload from the client: VERSION, ENCRYPTION (encrypt),
// INSTOPT (the default instance), THREADID 0, MARS off.
pub fn preloginRequest(encrypt: int): str {
    // option table: 5 options of 5 bytes, then the terminator; data from 26
    var b: []byte = []
    let lens = [6, 1, 1, 4, 1]
    var at = 26
    for i in 0..5 {
        put8(mut &b, i)
        put16be(mut &b, at)
        put16be(mut &b, lens[i])
        at += lens[i]
    }
    put8(mut &b, PL_TERMINATOR)
    for x in [0, 1, 0, 0, 0, 0] { put8(mut &b, x) }      // VERSION: 0.1.0, sub-build 0
    put8(mut &b, encrypt)
    put8(mut &b, 0)                                     // INSTOPT: "" (the default instance)
    put32(mut &b, 0)                                    // THREADID
    put8(mut &b, 0)                                     // MARS off
    return strFromBytes(&b)
}

// The server's PRELOGIN answer.
pub type Prelogin = value record {
    pub version: str        // "16.0.4135.0": major, minor, build, sub-build
    pub encryption: int     // ENCRYPT_*
    pub instance: int       // INSTOPT: 0 when the instance name matched (-1: absent)
    pub mars: int           // -1: absent
}

// The options of a PRELOGIN payload. E_PROTOCOL when the table or an
// option's data is out of bounds, or ENCRYPTION is missing.
pub fn parsePrelogin(p: &str): Result[Prelogin, Error] {
    var r = Prelogin{version: "", encryption: -1, instance: -1, mars: -1}
    var i = 0
    while true {
        if i >= len(p) { return Err(proto("PRELOGIN: the option table has no terminator")) }
        let tok = int(p[i])
        if tok == PL_TERMINATOR { break }
        if i + 5 > len(p) { return Err(proto("PRELOGIN: a truncated option")) }
        let off = (int(p[i + 1]) << 8) | int(p[i + 2])
        let n = (int(p[i + 3]) << 8) | int(p[i + 4])
        if off + n > len(p) { return Err(proto(&("PRELOGIN: option " + tok.toStr() + " is out of bounds"))) }
        if tok == PL_VERSION {
            if n < 6 { return Err(proto(&("PRELOGIN: VERSION is " + n.toStr() + " bytes"))) }
            r.version = int(p[off]).toStr() + "." + int(p[off + 1]).toStr() + "." +
                        ((int(p[off + 2]) << 8) | int(p[off + 3])).toStr() + "." +
                        ((int(p[off + 4]) << 8) | int(p[off + 5])).toStr()
        } else if tok == PL_ENCRYPTION {
            if n < 1 { return Err(proto("PRELOGIN: ENCRYPTION is empty")) }
            r.encryption = int(p[off])
        } else if tok == PL_INSTOPT {
            if n > 0 { r.instance = int(p[off]) }
        } else if tok == PL_MARS {
            if n > 0 { r.mars = int(p[off]) }
        }
        i += 5
    }
    if r.encryption < 0 { return Err(proto("PRELOGIN: no ENCRYPTION option")) }
    return Ok(r)
}

// ---------------------------------------------------------------- LOGIN7

// What LOGIN7 sends. Every text is at most 128 characters (UTF-16 units).
pub type Login = value record {
    pub hostName: str        // the client's machine
    pub userName: str
    pub password: str
    pub appName: str
    pub serverName: str      // the server as the client named it
    pub library: str         // the client library's name
    pub language: str        // "" : the login's default
    pub database: str        // "" : the login's default
    pub packetSize: int
    pub clientPid: int
    pub utf8: bool           // ask for UTF8_SUPPORT (FEATUREEXT)
}

// The password as LOGIN7 carries it: UTF-16LE, each byte's halves swapped
// and XORed with 0xA5 (MS-TDS 2.2.6.4). It is not encryption: TLS is.
pub fn scramble(units: &[byte]): []byte {
    var out = array(len(units), byte(0))
    for i in 0..len(units) {
        let b = int(units[i])
        out[i] = byte((((b << 4) & 0xf0) | (b >> 4)) ^ 0xa5)
    }
    return out
}

fn units(s: &str, what: &str): Result[[]byte, Error] {
    let u = match toUtf16(s) {
        Ok(x) { x }
        Err(e) { return Err(sqldialect.inputError(&(what + ": " + e))) }
    }
    if len(u) / 2 > 128 { return Err(sqldialect.inputError(&(what + " is longer than 128 characters"))) }
    return Ok(u)
}

// The LOGIN7 payload (TDS 7.4, SQL authentication). E_INPUT for a text that
// is not UTF-8 or is too long (the message names the field, never its value).
pub fn login7(l: &Login): Result[str, Error] {
    let host = try units(&l.hostName, "the host name")
    let user = try units(&l.userName, "the user name")
    let pw = scramble(&try units(&l.password, "the password"))
    let app = try units(&l.appName, "the application name")
    let server = try units(&l.serverName, "the server name")
    let lib = try units(&l.library, "the library name")
    let lang = try units(&l.language, "the language")
    let db = try units(&l.database, "the database")
    if l.packetSize < MIN_PACKET || l.packetSize > MAX_PACKET {
        return Err(sqldialect.inputError(&("a packet size outside " + MIN_PACKET.toStr() + " to " + MAX_PACKET.toStr())))
    }
    var h = array(94, byte(0))
    set32(mut &h, 4, TDS74)
    set32(mut &h, 8, l.packetSize)
    set32(mut &h, 12, 0x00000001)              // ClientProgVer
    set32(mut &h, 16, l.clientPid)
    h[24] = byte(0xE0)                          // fUseDB, fDatabase (fatal), fSetLang
    h[25] = byte(0x03)                          // fLanguage (fatal), fODBC
    h[26] = byte(0)                             // TypeFlags: fSQLType default, read-write
    h[27] = byte(if l.utf8 { 0x18 } else { 0x08 })   // fUnknownCollationHandling, fExtension
    set32(mut &h, 32, 0x0409)                   // ClientLCID
    var data: []byte = []
    field(mut &h, mut &data, 36, &host)
    field(mut &h, mut &data, 40, &user)
    field(mut &h, mut &data, 44, &pw)
    field(mut &h, mut &data, 48, &app)
    field(mut &h, mut &data, 52, &server)
    var extAt = -1
    if l.utf8 {
        set16(mut &h, 56, 94 + len(data))
        set16(mut &h, 58, 4)
        extAt = len(data)
        put32(mut &data, 0)                     // the offset of FeatureExt, set below
    } else {
        set16(mut &h, 56, 94 + len(data))
    }
    field(mut &h, mut &data, 60, &lib)
    field(mut &h, mut &data, 64, &lang)
    field(mut &h, mut &data, 68, &db)
    set16(mut &h, 78, 94 + len(data))           // SSPI: none
    set16(mut &h, 82, 94 + len(data))           // AtchDBFile: none
    set16(mut &h, 86, 94 + len(data))           // ChangePassword: none
    if extAt >= 0 {
        set32(mut &data, extAt, 94 + len(data))
        put8(mut &data, FEATURE_UTF8)
        put32(mut &data, 0)
        put8(mut &data, 0xFF)                   // the end of the features
    }
    set32(mut &h, 0, 94 + len(data))
    appendStr(mut &h, strFromBytes(&data))
    return Ok(strFromBytes(&h))
}

fn field(h: mut &[]byte, data: mut &[]byte, at: int, u: &[]byte) {
    set16(h, at, 94 + len(data))
    set16(h, at + 2, len(u) / 2)
    for b in u { append(data, b) }
}

// ---------------------------------------------------------------- SQLBatch

// The SQLBatch payload: ALL_HEADERS with the transaction descriptor (8
// bytes; zeros outside a transaction) and one outstanding request, then the
// text in UTF-16LE. E_INPUT for text that is not UTF-8.
pub fn sqlBatch(sql: &str, txn: &str): Result[str, Error] {
    if len(txn) != 8 { return Err(sqldialect.inputError("a transaction descriptor is 8 bytes")) }
    var b: []byte = []
    allHeaders(mut &b, txn)
    let text = match toUtf16(sql) {
        Ok(x) { x }
        Err(e) { return Err(sqldialect.inputError(&("SQL text: " + e))) }
    }
    appendStr(mut &b, strFromBytes(&text))
    return Ok(strFromBytes(&b))
}

pub fn noTransaction(): str { return "\x00\x00\x00\x00\x00\x00\x00\x00" }

fn allHeaders(b: mut &[]byte, txn: &str) {
    put32(b, 22)          // ALL_HEADERS' total length
    put32(b, 18)          // this header's length
    put16(b, 2)           // transaction descriptor
    appendStr(b, txn)
    put32(b, 1)           // outstanding requests
}

// ---------------------------------------------------------------- RPC

pub const PROC_EXECUTESQL = 10
pub const MAX_PARAMS = 2098            // SQL Server's 2100, less sp_executesql's @stmt and @params

// A parameter of an RPC as it is sent: its name ("" for a positional one),
// whether it is an OUTPUT parameter, whether it is the parameter's default
// (fDefaultValue: only an empty table parameter is sent so), the type
// sp_executesql's @params declares for it ("bigint", "nvarchar(4000)",
// "decimal(12,2)", "dbo.Items READONLY"), its TYPE_INFO and its value
// (TYPE_VARBYTE; a table parameter's rows), both as bytes.
pub type Param = value record {
    pub name: str
    pub output: bool
    pub byDefault: bool
    pub declared: str
    pub typeInfo: str
    pub data: str
}

// The 5 bytes of a collation.
pub fn collationBytes(c: &Collation): str {
    var b: []byte = []
    put32(mut &b, (c.lcid & 0xFFFFF) | ((c.flags & 0xFF) << 20) | ((c.version & 0xF) << 28))
    put8(mut &b, c.sortId)
    return strFromBytes(&b)
}

fn param(declared: &str, ti: &[]byte, data: &[]byte): Param {
    return Param{name: "", output: false, byDefault: false, declared: declared, typeInfo: strFromBytes(ti), data: strFromBytes(data)}
}

// A bigint parameter (INTN of 8 bytes).
pub fn intParam(n: int): Param {
    var d: []byte = []
    put8(mut &d, 8)
    for k in 0..8 { put8(mut &d, (n >> (8 * k)) & 0xff) }
    return param("bigint", &[byte(T_INTN), byte(8)], &d)
}

// A bit parameter.
pub fn bitParam(v: bool): Param { return param("bit", &[byte(T_BITN), byte(1)], &[byte(1), byte(if v { 1 } else { 0 })]) }

// The IEEE 754 double bits of f, exactly (math.bitsOf; kept for its callers).
pub fn bitsOfFloat(f: float): int { return math.bitsOf(f) }

// A float parameter (FLTN of 8 bytes, the exact bits). E_NONFINITE for NaN
// and the infinities, and E_INPUT for subnormal numbers (below
// 2.2250738585072014e-308 in magnitude, not zero), which SQL Server's float
// has not: its own CAST makes them 0, the ODBC driver refuses them, and the
// server would keep the bits if they were sent.
pub fn floatParam(f: float): Result[Param, Error] {
    if !f.isFinite() { return Err(sqldialect.dbError(sqldialect.E_NONFINITE, "SQL Server float has no NaN or Infinity")) }
    if f != 0.0f && f < 2.2250738585072014e-308f && f > -2.2250738585072014e-308f {
        return Err(sqldialect.inputError(&("SQL Server float has no subnormal numbers: " + f.toStr())))
    }
    let bits = bitsOfFloat(f)
    var d: []byte = []
    put8(mut &d, 8)
    for k in 0..8 { put8(mut &d, (bits >> (8 * k)) & 0xff) }
    return Ok(param("float", &[byte(T_FLTN), byte(8)], &d))
}

// PLP data: the total length, one chunk, the terminator.
fn plp(d: mut &[]byte, s: &str) {
    for k in 0..8 { put8(d, (len(s) >> (8 * k)) & 0xff) }
    plpChunks(d, s)
}

// PLP data of unknown total length (PLP_UNKNOWN_LEN), one chunk, the
// terminator: what a bulk load's rows need (with the length known, the
// server misreads them: error 4804).
fn plpUnknown(d: mut &[]byte, s: &str) {
    put8(d, 0xFE)
    for k in 0..7 { put8(d, 0xFF) }
    plpChunks(d, s)
}

fn plpChunks(d: mut &[]byte, s: &str) {
    if len(s) > 0 {
        put32(d, len(s))
        appendStr(d, s)
    }
    put32(d, 0)
}

// UTF-16 text as an nvarchar value: its length then the text, or PLP for
// max (of unknown length when unknown).
fn textData(d: mut &[]byte, u: &[]byte, max: bool, unknown: bool) {
    if max && unknown {
        plpUnknown(d, &(strFromBytes(u)))
    } else if max {
        plp(d, &(strFromBytes(u)))
    } else {
        put16(d, len(u))
        for x in u { append(d, x) }
    }
}

// Bytes as a varbinary value: their length then the bytes, or PLP for max
// (of unknown length when unknown).
fn bytesData(d: mut &[]byte, b: &str, max: bool, unknown: bool) {
    if max && unknown {
        plpUnknown(d, b)
    } else if max {
        plp(d, b)
    } else {
        put16(d, len(b))
        appendStr(d, b)
    }
}

// An nvarchar parameter: nvarchar(4000) up to 4,000 UTF-16 units, else
// nvarchar(max) (PLP). E_INPUT for text that is not UTF-8.
pub fn textParam(s: &str, coll: &Collation): Result[Param, Error] { return textParamOf(s, coll, false) }

// An nvarchar(max) parameter, however short (an input-output one: the
// value that comes back has the type that went in).
pub fn longTextParam(s: &str, coll: &Collation): Result[Param, Error] { return textParamOf(s, coll, true) }

fn textParamOf(s: &str, coll: &Collation, long: bool): Result[Param, Error] {
    let u = match toUtf16(s) {
        Ok(x) { x }
        Err(e) { return Err(sqldialect.inputError(&("text value: " + e))) }
    }
    var ti: []byte = []
    put8(mut &ti, T_NVARCHAR)
    var d: []byte = []
    let max = long || len(u) > 8000
    put16(mut &ti, if max { 0xFFFF } else { 8000 })
    appendStr(mut &ti, collationBytes(coll))
    textData(mut &d, &u, max, false)
    return Ok(param(if max { "nvarchar(max)" } else { "nvarchar(4000)" }, &ti, &d))
}

// A varbinary parameter: varbinary(8000) up to 8,000 bytes, else
// varbinary(max) (PLP).
pub fn bytesParam(b: &str): Param { return bytesParamOf(b, false) }

// A varbinary(max) parameter, however short (as longTextParam).
pub fn longBytesParam(b: &str): Param { return bytesParamOf(b, true) }

fn bytesParamOf(b: &str, long: bool): Param {
    var ti: []byte = []
    put8(mut &ti, T_BIGVARBIN)
    var d: []byte = []
    let max = long || len(b) > 8000
    put16(mut &ti, if max { 0xFFFF } else { 8000 })
    bytesData(mut &d, &b, max, false)
    return param(if max { "varbinary(max)" } else { "varbinary(8000)" }, &ti, &d)
}

// The bytes of a decimal(p, s) value after its sign: 4, 8, 12 or 16.
fn decimalBytes(p: int): int {
    if p <= 9 { return 4 }
    if p <= 19 { return 8 }
    if p <= 28 { return 12 }
    return 16
}

// A decimal(p, s) parameter with p and s from the value: s its display
// scale (or more, when it has more fraction digits), p its digits from the
// first nonzero integer digit to the last fraction digit, at least s and at
// least 1. E_DEC_RANGE when that is more than 38 digits.
pub fn decimalParam(d: Decimal): Result[Param, Error] {
    let x = try decimalParts(d)
    return Ok(decimalParamOf(x.neg, x.m, x.p, x.s))
}

// A decimal(38, s) parameter, s the value's scale as decimalParam's (an
// input-output one: the value that comes back is a decimal(38, s)).
pub fn wideDecimalParam(d: Decimal): Result[Param, Error] {
    let x = try decimalParts(d)
    return Ok(decimalParamOf(x.neg, x.m, 38, x.s))
}

// A decimal as SQL Server stores it: sign, magnitude, precision and scale.
type DecParts = value record { neg: bool; m: u128; p: int; s: int }

// decimalParam's precision and scale for d, and its magnitude at that scale.
fn decimalParts(d: Decimal): Result[DecParts, Error] {
    let t = try sqldialect.decimalText(d, 38)
    let body = if len(t) > 0 && t[0] == '-' { t[1..] } else { t }
    let dot = strings.indexOfByte(&body, '.', 0)
    let ip = if dot < 0 { body } else { body[..dot] }
    let fp = if dot < 0 { "" } else { body[dot + 1..] }
    var lead = 0
    while lead < len(ip) && ip[lead] == '0' { lead += 1 }
    let s = len(fp)
    let p = max(len(ip) - lead + s, max(s, 1))
    if p > 38 || s > 38 { return Err(sqldialect.dbError(sqldialect.E_DEC_RANGE, &(d.toStr() + " does not fit SQL Server's decimal(38)"))) }
    var m: u128 = 0
    let digits = ip[lead..] + fp
    for i in 0..len(digits) {
        let c = digits[i]
        if c < '0' || c > '9' { return Err(sqldialect.dbError(sqldialect.E_DEC_RANGE, &(d.toStr() + " does not fit SQL Server's decimal(38)"))) }
        m = m * 10 + u128(c - '0')
    }
    return Ok(DecParts{neg: d.isNeg(), m: m, p: p, s: s})
}

// A decimal value of precision p: its length, sign and magnitude.
fn decimalData(d: mut &[]byte, neg: bool, m: u128, p: int) {
    let n = decimalBytes(p)
    put8(d, n + 1)
    put8(d, if neg { 0 } else { 1 })
    for k in 0..n { append(d, byte(int((m >> (8 * k)) & 0xff))) }
}

fn decimalParamOf(neg: bool, m: u128, p: int, s: int): Param {
    var d: []byte = []
    decimalData(mut &d, neg, m, p)
    return param(&("decimal(" + p.toStr() + "," + s.toStr() + ")"), &[byte(T_DECIMALN), byte(17), byte(p), byte(s)], &d)
}

// A NULL parameter of the declared SQL type `declared` ("int",
// "varbinary(max)", "decimal(10,2)", "datetime2(7)", ...: the names
// typeInfoOf knows). E_INPUT for another.
pub fn nullParam(declared: &str, coll: &Collation): Result[Param, Error] {
    let ti = try typeInfoOf(declared, coll)
    var d: []byte = []
    nullData(mut &d, &ti)
    return Ok(Param{name: "", output: false, byDefault: false, declared: declared, typeInfo: ti, data: strFromBytes(&d)})
}

// NULL as a value of the type whose TYPE_INFO is ti.
fn nullData(d: mut &[]byte, ti: &str) {
    let t = int(strByte(ti, 0))
    let isMax = len(ti) >= 3 && strByte(ti, 1) == 0xFF && strByte(ti, 2) == 0xFF
    if isMax || t == T_XML {
        for k in 0..8 { put8(d, 0xFF) }             // PLP NULL
    } else if t == T_BIGVARCHR || t == T_BIGCHAR || t == T_NVARCHAR || t == T_NCHAR || t == T_BIGVARBIN || t == T_BIGBINARY {
        put16(d, 0xFFFF)
    } else {
        put8(d, 0)
    }
}

// The TYPE_INFO for a parameter of the SQL type named t (lower or upper
// case; the database's collation for text types): bit, tinyint, smallint,
// int, bigint, real, float, decimal(p,s) and numeric(p,s), money,
// smallmoney, date, time(n), datetime2(n), datetimeoffset(n), datetime,
// smalldatetime, uniqueidentifier, char(n), varchar(n|max), nchar(n),
// nvarchar(n|max), binary(n), varbinary(n|max), xml. E_INPUT for another.
pub fn typeInfoOf(t: &str, coll: &Collation): Result[str, Error] {
    let low = strings.toLowerAscii(&(strings.trim(t)))
    let open = strings.indexOfByte(&low, '(', 0)
    let base = strings.trim(if open < 0 { &low } else { low[..open] })
    var args: []str = []
    if open >= 0 {
        if low[len(low) - 1] != ')' { return Err(sqldialect.inputError(&("a type name without its ')': " + t))) }
        for a in strings.split(low[open + 1..len(low) - 1], ",") { append(mut &args, strings.trim(a)) }
    }
    let bad = sqldialect.inputError(&("a type that parameters cannot have yet: " + t))
    // the text goes into sp_executesql's declaration list as it is: only a type name and its
    // numbers, never anything the server would read as more SQL
    for i in 0..len(low) {
        let c = strByte(low, i)
        if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '(' || c == ')' || c == ',' || c == ' ') {
            return Err(bad)
        }
    }
    let sized = base == "decimal" || base == "numeric" || base == "time" || base == "datetime2" ||
                base == "datetimeoffset" || base == "char" || base == "varchar" || base == "nchar" ||
                base == "nvarchar" || base == "binary" || base == "varbinary"
    if open >= 0 && !sized { return Err(bad) }
    var b: []byte = []
    let n0 = if len(args) > 0 { strings.parseIntOpt(&args[0]) } else { None }
    match base {
        "bit" { for x in [T_BITN, 1] { put8(mut &b, x) } }
        "tinyint" { for x in [T_INTN, 1] { put8(mut &b, x) } }
        "smallint" { for x in [T_INTN, 2] { put8(mut &b, x) } }
        "int" { for x in [T_INTN, 4] { put8(mut &b, x) } }
        "bigint" { for x in [T_INTN, 8] { put8(mut &b, x) } }
        "real" { for x in [T_FLTN, 4] { put8(mut &b, x) } }
        "float" { for x in [T_FLTN, 8] { put8(mut &b, x) } }
        "money" { for x in [T_MONEYN, 8] { put8(mut &b, x) } }
        "smallmoney" { for x in [T_MONEYN, 4] { put8(mut &b, x) } }
        "datetime" { for x in [T_DATETIMN, 8] { put8(mut &b, x) } }
        "smalldatetime" { for x in [T_DATETIMN, 4] { put8(mut &b, x) } }
        "uniqueidentifier" { for x in [T_GUID, 16] { put8(mut &b, x) } }
        "date" { put8(mut &b, T_DATEN) }
        "xml" { for x in [T_XML, 0] { put8(mut &b, x) } }
        "decimal", "numeric" {
            let p = if len(args) > 0 { n0.unwrapOr(-1) } else { 18 }
            let s = if len(args) > 1 { strings.parseIntOpt(&args[1]).unwrapOr(-1) } else { 0 }
            if p < 1 || p > 38 || s < 0 || s > p || len(args) > 2 { return Err(bad) }
            for x in [T_DECIMALN, 17, p, s] { put8(mut &b, x) }
        }
        "time", "datetime2", "datetimeoffset" {
            let s = if len(args) > 0 { n0.unwrapOr(-1) } else { 7 }
            if s < 0 || s > 7 || len(args) > 1 { return Err(bad) }
            put8(mut &b, if base == "time" { T_TIMEN } else if base == "datetime2" { T_DATETIME2N } else { T_DATETIMEOFFSETN })
            put8(mut &b, s)
        }
        "char", "varchar", "nchar", "nvarchar", "binary", "varbinary" {
            let wide = base == "nchar" || base == "nvarchar"
            let isVar = base == "varchar" || base == "nvarchar" || base == "varbinary"
            let limit = if wide { 4000 } else { 8000 }
            var size = 1
            if len(args) == 1 && args[0] == "max" {
                if !isVar { return Err(bad) }
                size = 0xFFFF
            } else if len(args) == 1 {
                let n = n0.unwrapOr(-1)
                if n < 1 || n > limit { return Err(bad) }
                size = if wide { 2 * n } else { n }
            } else if len(args) > 1 {
                return Err(bad)
            } else if wide {
                size = 2
            }
            let code = match base {
                "char" { T_BIGCHAR }
                "varchar" { T_BIGVARCHR }
                "nchar" { T_NCHAR }
                "nvarchar" { T_NVARCHAR }
                "binary" { T_BIGBINARY }
                else { T_BIGVARBIN }
            }
            put8(mut &b, code)
            put16(mut &b, size)
            if base != "binary" && base != "varbinary" { appendStr(mut &b, collationBytes(coll)) }
        }
        else { return Err(bad) }
    }
    return Ok(strFromBytes(&b))
}

// The RPC payload that runs sp_executesql (ProcID 10) on sql, with @params
// declaring each parameter (named, in order) and then the parameters. E_INPUT
// for SQL text that is not UTF-8 and for more than MAX_PARAMS parameters.
pub fn executeSql(sql: &str, params: &[Param], txn: &str, coll: &Collation): Result[str, Error] {
    if len(txn) != 8 { return Err(sqldialect.inputError("a transaction descriptor is 8 bytes")) }
    if len(params) > MAX_PARAMS { return Err(sqldialect.inputError(&("more than " + MAX_PARAMS.toStr() + " parameters"))) }
    var b: []byte = []
    allHeaders(mut &b, txn)
    put16(mut &b, 0xFFFF)
    put16(mut &b, PROC_EXECUTESQL)
    put16(mut &b, 0)                                   // OptionFlags
    let stmt = match textParam(sql, coll) {
        Ok(p) { p }
        Err(e) { return Err(sqldialect.inputError(&("SQL text: " + e.msg))) }
    }
    rpcParam(mut &b, &stmt)
    var decl = newStrBuf()
    for i in 0..len(params) {
        if i > 0 { decl.add(", ") }
        decl.add(&(params[i].name + " " + params[i].declared))
        if params[i].output { decl.add(" OUTPUT") }
    }
    let ds = try textParam(&(decl.toStr()), coll)
    rpcParam(mut &b, &ds)
    for p in params {
        if !validParamName(&p.name) {
            return Err(sqldialect.inputError("a parameter's name must be @ and 1 to 127 letters, digits or _ @ # $"))
        }
        rpcParam(mut &b, &p)
    }
    return Ok(strFromBytes(&b))
}

pub const MAX_PROC_PARAMS = 2100
pub const MAX_PROC_NAME = 1000          // UTF-16 units: four parts of 128 characters, quoted, fit

// The RPC payload that runs the procedure proc by its name (ProcNameLength
// and ProcName, not a ProcID): "dbo.Orders_Add", "[my proc]", "#p",
// "db.dbo.p". The server takes the name as an object name, never as SQL
// text. Parameters with no name are positional and come first; the rest
// are named, in any order, and a procedure's parameter not given takes its
// default. E_INPUT for a name that is empty, not UTF-8, longer than
// MAX_PROC_NAME units or holds a NUL; for a positional parameter after a
// named one, a name that is not one, and more than MAX_PROC_PARAMS
// parameters.
pub fn procCall(proc: &str, params: &[Param], txn: &str): Result[str, Error] {
    if len(txn) != 8 { return Err(sqldialect.inputError("a transaction descriptor is 8 bytes")) }
    if len(params) > MAX_PROC_PARAMS { return Err(sqldialect.inputError(&("more than " + MAX_PROC_PARAMS.toStr() + " parameters"))) }
    let u = match toUtf16(proc) {
        Ok(x) { x }
        Err(_) { return Err(sqldialect.inputError("a procedure's name must be UTF-8")) }
    }
    if len(u) == 0 || len(u) / 2 > MAX_PROC_NAME || strings.contains(&proc, "\x00") {
        return Err(sqldialect.inputError(&("a procedure's name is 1 to " + MAX_PROC_NAME.toStr() + " characters, without NUL")))
    }
    var b: []byte = []
    allHeaders(mut &b, txn)
    put16(mut &b, len(u) / 2)
    for x in u { append(mut &b, x) }
    put16(mut &b, 0)                                   // OptionFlags
    var named = false
    for p in params {
        if len(p.name) == 0 {
            if named { return Err(sqldialect.inputError("a positional parameter after a named one")) }
        } else {
            if !validParamName(&p.name) {
                return Err(sqldialect.inputError("a parameter's name must be @ and 1 to 127 letters, digits or _ @ # $"))
            }
            named = true
        }
        rpcParam(mut &b, &p)
    }
    return Ok(strFromBytes(&b))
}

// "@" then 1 to 127 ASCII letters, digits or _ @ # $ (a regular identifier, which the name is
// declared as in sp_executesql's parameter list).
pub fn validParamName(n: &str): bool {
    if len(n) < 2 || len(n) > 128 || strByte(n, 0) != '@' { return false }
    for i in 1..len(n) {
        let c = strByte(n, i)
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '@' ||
             c == '#' || c == '$') {
            return false
        }
    }
    return true
}

fn rpcParam(b: mut &[]byte, p: &Param) {
    let u = toUtf16(&p.name).unwrapOr([])
    put8(b, len(u) / 2)
    for x in u { append(b, x) }
    put8(b, (if p.output { 1 } else { 0 }) | (if p.byDefault { PARAM_DEFAULT } else { 0 }))   // fByRefValue, fDefaultValue
    appendStr(b, p.typeInfo)
    appendStr(b, p.data)
}

// ---------------------------------------------------------------- table-valued parameters

pub const T_TABLE = 0xF3                // TVPTYPE
pub const PARAM_DEFAULT = 2             // an RPC parameter's StatusFlags: fDefaultValue
pub const MAX_TABLE_COLUMNS = 1024
const TVP_NULL = 0xFFFF                 // no column metadata: the type's default, an empty table
const TVP_END = 0
const TVP_ROW = 1
const COL_DEFAULT = 0x200               // TvpColumnMetaData Flags: fDefault, the value not sent

// What a column of a table parameter holds, from its values.
type ColKind = value closed {
    Unknown                             // only NULLs so far
    Int
    Float
    Bool
    Text
    Bytes
    Dec
}

// A column of a table parameter as its values make it: its kind, whether
// it needs (max), and for decimals the most digits before and after the
// point.
type TableCol = record {
    kind: ColKind
    long: bool
    bulk: bool                          // in a bulk load's rows: PLP of unknown length
    intDigits: int
    scale: int
}

fn kindName(k: ColKind): str {
    return match k {
        ColKind.Unknown { "NULL" }
        ColKind.Int { "int" }
        ColKind.Float { "float" }
        ColKind.Bool { "bool" }
        ColKind.Text { "text" }
        ColKind.Bytes { "bytes" }
        ColKind.Dec { "decimal" }
    }
}

// The UTF-16 units of UTF-8 text: one per character, two above U+FFFF.
fn utf16Units(s: &str): int {
    var n = 0
    for i in 0..len(s) {
        let c = strByte(s, i)
        if c < 0x80 || c >= 0xC0 { n += 1 }
        if c >= 0xF0 { n += 1 }
    }
    return n
}

// The decimal digits of n's magnitude (0 has none: decimal(1,0) holds it).
fn intDigits(n: int): int {
    var m = intMagnitude(n)
    var k = 0
    while m > 0 {
        m = m / 10
        k += 1
    }
    return k
}

fn intMagnitude(n: int): u128 { return if n < 0 { u128(-(n + 1)) + 1 } else { u128(n) } }

// Takes value v into col's kind, or E_INPUT when the column (named by
// what: "column 1", "column [price]") already holds values of another
// kind. An int goes into a decimal column.
fn (col: mut &TableCol) take(v: &sqldialect.Value, what: &str): Result[Unit, Error] {
    var k = ColKind.Unknown
    match v {
        sqldialect.Value.Null { return Ok(Unit{}) }
        sqldialect.Value.Int(n) {
            col.intDigits = max(col.intDigits, intDigits(n))
            k = ColKind.Int
        }
        sqldialect.Value.Float(_) { k = ColKind.Float }
        sqldialect.Value.Bool(_) { k = ColKind.Bool }
        sqldialect.Value.Text(t) {
            if utf16Units(&t) > 4000 { col.long = true }
            k = ColKind.Text
        }
        sqldialect.Value.Bytes(b) {
            if len(b) > 8000 { col.long = true }
            k = ColKind.Bytes
        }
        sqldialect.Value.Dec(d) {
            let x = try decimalParts(d)
            col.intDigits = max(col.intDigits, x.p - x.s)
            col.scale = max(col.scale, x.s)
            k = ColKind.Dec
        }
    }
    if col.kind == ColKind.Unknown || col.kind == k { col.kind = k } else if col.kind == ColKind.Int && k == ColKind.Dec {
        col.kind = k
    } else if !(col.kind == ColKind.Dec && k == ColKind.Int) {
        return Err(sqldialect.inputError(&(what + " has " + kindName(col.kind) + " and " + kindName(k) + " values")))
    }
    return Ok(Unit{})
}

// The column's TYPE_INFO: bigint, float, bit, nvarchar(4000|max),
// varbinary(8000|max), decimal(p,s) wide enough for every value, and for a
// column of NULLs nullType ("" for nvarchar(4000)).
fn (col: &TableCol) typeInfo(nullType: &str, coll: &Collation): Result[str, Error] {
    if col.kind == ColKind.Unknown && len(nullType) > 0 { return typeInfoOf(nullType, coll) }
    var b: []byte = []
    match col.kind {
        ColKind.Int { for x in [T_INTN, 8] { put8(mut &b, x) } }
        ColKind.Float { for x in [T_FLTN, 8] { put8(mut &b, x) } }
        ColKind.Bool { for x in [T_BITN, 1] { put8(mut &b, x) } }
        ColKind.Bytes {
            put8(mut &b, T_BIGVARBIN)
            put16(mut &b, if col.long { 0xFFFF } else { 8000 })
        }
        ColKind.Dec {
            let p = max(col.intDigits + col.scale, 1)
            if p > 38 {
                return Err(sqldialect.dbError(sqldialect.E_DEC_RANGE, &("a decimal column needs " + p.toStr() +
                                              " digits: SQL Server's decimal has 38")))
            }
            for x in [T_DECIMALN, 17, p, col.scale] { put8(mut &b, x) }
        }
        else {
            put8(mut &b, T_NVARCHAR)
            put16(mut &b, if col.long { 0xFFFF } else { 8000 })
            appendStr(mut &b, collationBytes(coll))
        }
    }
    return Ok(strFromBytes(&b))
}

// v as a value of the column whose TYPE_INFO is ti.
fn (col: &TableCol) put(d: mut &[]byte, v: &sqldialect.Value, ti: &str): Result[Unit, Error] {
    match v {
        sqldialect.Value.Null { nullData(d, ti) }
        sqldialect.Value.Int(n) {
            if col.kind == ColKind.Dec {
                var m = intMagnitude(n)
                for k in 0..col.scale { m = m * 10 }
                decimalData(d, n < 0, m, max(col.intDigits + col.scale, 1))
            } else {
                put8(d, 8)
                for k in 0..8 { put8(d, (n >> (8 * k)) & 0xff) }
            }
        }
        sqldialect.Value.Float(f) { appendStr(d, (try floatParam(f)).data) }
        sqldialect.Value.Bool(x) {
            put8(d, 1)
            put8(d, if x { 1 } else { 0 })
        }
        sqldialect.Value.Text(t) {
            let u = match toUtf16(t) {
                Ok(x) { x }
                Err(e) { return Err(sqldialect.inputError(&("text value: " + e))) }
            }
            textData(d, &u, col.long, col.bulk)
        }
        sqldialect.Value.Bytes(b) { bytesData(d, &b, col.long, col.bulk) }
        sqldialect.Value.Dec(x) {
            let parts = try decimalParts(x)
            var m = parts.m
            for k in parts.s..col.scale { m = m * 10 }
            decimalData(d, parts.neg, m, max(col.intDigits + col.scale, 1))
        }
    }
    return Ok(Unit{})
}

fn isNull(v: &sqldialect.Value): bool {
    match v {
        sqldialect.Value.Null { return true }
        else { return false }
    }
}

// A regular identifier of at most 128 characters: a letter, _, @ or #,
// then letters, digits and _ @ # $ (ASCII).
fn validIdentifier(n: &str): bool {
    if len(n) < 1 || len(n) > 128 { return false }
    for i in 0..len(n) {
        let c = strByte(n, i)
        let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '@' || c == '#'
        if !(letter || (i > 0 && ((c >= '0' && c <= '9') || c == '$'))) { return false }
    }
    return true
}

// B_VARCHAR: a length in UTF-16 units (one byte), then the text.
fn putBVarchar(b: mut &[]byte, s: &str) {
    let u = toUtf16(s).unwrapOr([])
    put8(b, len(u) / 2)
    for x in u { append(b, x) }
}

// A table-valued parameter of the table type typeName ("Items" or
// "dbo.Items": a user-defined table type of the current database), its rows
// as rows. Every row has a value for every column of the type, in the
// type's order; each column's type comes from its values (as a parameter's:
// bigint, float, bit, nvarchar, varbinary, decimal(p,s) wide enough for all
// of them, ints too), and the server converts it to the column's. A column
// whose values are all NULL goes as nullTypes[i] (a name typeInfoOf knows),
// or nvarchar(4000) when that is "" or missing. The columns in defaults
// (0-based) are the server's to fill (fDefault: an identity or computed
// column, or one whose DEFAULT is wanted): their values are not sent, and
// must be NULL. No rows sends the type's default, an empty table. E_INPUT
// for a type name that is not one or two regular identifiers, rows of
// different lengths, more than MAX_TABLE_COLUMNS columns, a column with
// values of two kinds (other than int and decimal), a null type
// typeInfoOf does not know, a default column out of range or with a value.
pub fn tableParam(typeName: &str, rows: &[[]sqldialect.Value], nullTypes: &[str], defaults: &[int],
                  coll: &Collation): Result[Param, Error] {
    let parts = strings.split(&typeName, ".")
    if len(parts) > 2 || !validIdentifier(&parts[len(parts) - 1]) || (len(parts) == 2 && !validIdentifier(&parts[0])) {
        return Err(sqldialect.inputError("a table type's name must be type or schema.type, regular identifiers"))
    }
    var ti: []byte = []
    put8(mut &ti, T_TABLE)
    put8(mut &ti, 0)                                   // DbName: the current database's
    putBVarchar(mut &ti, if len(parts) == 2 { parts[0] } else { "" })
    putBVarchar(mut &ti, parts[len(parts) - 1])
    var d: []byte = []
    if len(rows) == 0 {
        put16(mut &ti, TVP_NULL)
        put8(mut &ti, TVP_END)
        put8(mut &d, TVP_END)
        return Ok(Param{name: "", output: false, byDefault: true, declared: typeName + " READONLY",
                        typeInfo: strFromBytes(&ti), data: strFromBytes(&d)})
    }
    let n = len(rows[0])
    if n < 1 || n > MAX_TABLE_COLUMNS {
        return Err(sqldialect.inputError(&("a table parameter has 1 to " + MAX_TABLE_COLUMNS.toStr() + " columns, not " + n.toStr())))
    }
    var byServer: []bool = []
    for i in 0..n { append(mut &byServer, false) }
    for k in defaults {
        if k < 0 || k >= n {
            return Err(sqldialect.inputError(&("default column " + k.toStr() + " out of range (" + n.toStr() + " columns)")))
        }
        byServer[k] = true
    }
    var cols: []TableCol = []
    for i in 0..n { append(mut &cols, TableCol{kind: ColKind.Unknown, long: false, bulk: false, intDigits: 0, scale: 0}) }
    for r in 0..len(rows) {
        if len(rows[r]) != n {
            return Err(sqldialect.inputError(&("row " + (r + 1).toStr() + " of a table parameter has " + len(rows[r]).toStr() +
                                             " values, row 1 has " + n.toStr())))
        }
        for i in 0..n {
            if !byServer[i] {
                try cols[i].take(&rows[r][i], &("column " + (i + 1).toStr()))
            } else if !isNull(&rows[r][i]) {
                return Err(sqldialect.inputError(&("row " + (r + 1).toStr() + " has a value for default column " + i.toStr() +
                                                 ": the server fills it, so it must be NULL")))
            }
        }
    }
    put16(mut &ti, n)
    var infos: []str = []
    for i in 0..n {
        let nt = if i < len(nullTypes) { nullTypes[i] } else { "" }
        let info = try cols[i].typeInfo(&nt, coll)
        put32(mut &ti, 0)                              // UserType
        put16(mut &ti, if byServer[i] { 1 | COL_DEFAULT } else { 1 })   // Flags: fNullable, fDefault
        appendStr(mut &ti, info)
        put8(mut &ti, 0)                               // ColName: none
        append(mut &infos, info)
    }
    put8(mut &ti, TVP_END)                             // no ordering metadata
    for r in 0..len(rows) {
        put8(mut &d, TVP_ROW)
        for i in 0..n {
            if !byServer[i] { try cols[i].put(mut &d, &rows[r][i], &infos[i]) }
        }
    }
    put8(mut &d, TVP_END)
    return Ok(Param{name: "", output: false, byDefault: false, declared: typeName + " READONLY",
                    typeInfo: strFromBytes(&ti), data: strFromBytes(&d)})
}

// ---------------------------------------------------------------- bulk load

pub const PT_BULK = 7

// The SQL type the column's TYPE_INFO is, as INSERT BULK's column list
// declares it: typeInfo's choice, by name.
fn (col: &TableCol) sqlType(nullType: &str): str {
    return match col.kind {
        ColKind.Int { "bigint" }
        ColKind.Float { "float" }
        ColKind.Bool { "bit" }
        ColKind.Bytes { if col.long { "varbinary(max)" } else { "varbinary(8000)" } }
        ColKind.Dec { "decimal(" + max(col.intDigits + col.scale, 1).toStr() + "," + col.scale.toStr() + ")" }
        ColKind.Text { if col.long { "nvarchar(max)" } else { "nvarchar(4000)" } }
        ColKind.Unknown { if len(nullType) > 0 { strings.toLowerAscii(&(strings.trim(nullType))) } else { "nvarchar(4000)" } }
    }
}

// A name in brackets, ] doubled: a delimited identifier.
fn bracketed(n: &str): str {
    var out = newStrBuf()
    out.add("[")
    for i in 0..len(n) {
        let c: str = n[i..i + 1]
        out.add(&(if c == "]" { "]]" } else { c }))
    }
    out.add("]")
    return out.toStr()
}

// What a bulk load sends: the INSERT BULK statement, then the BULK_LOAD
// message (COLMETADATA, a ROW per row, DONE).
pub type BulkLoad = value record {
    pub statement: str
    pub payload: str
}

// The INSERT BULK options, in WITH (...).
pub type BulkOptions = value record {
    pub tablock: bool               // TABLOCK: a table lock for the load
    pub checkConstraints: bool      // CHECK_CONSTRAINTS: else CHECK and FOREIGN KEY constraints are not checked
    pub fireTriggers: bool          // FIRE_TRIGGERS: else INSERT triggers do not run
    pub keepNulls: bool             // KEEP_NULLS: else a NULL goes in as the column's DEFAULT, if it has one
}

// The checked name of a table: one to three regular identifiers (a
// #temporary table's name too).
pub fn validTableName(t: &str): bool {
    let parts = strings.split(t, ".")
    if len(parts) > 3 { return false }
    for p in parts {
        if !validIdentifier(&p) { return false }
    }
    return true
}

// The query whose COLMETADATA describes a bulk load's destination columns
// (bulkLoad's dest): no rows. E_INPUT for a table name that is not
// validTableName, no columns, more than MAX_TABLE_COLUMNS, or a column
// name that is empty, longer than 128 characters or not UTF-8.
pub fn bulkColumnsQuery(table: &str, names: &[str]): Result[str, Error] {
    if !validTableName(&table) {
        return Err(sqldialect.inputError("a table's name must be one to three regular identifiers"))
    }
    if len(names) < 1 || len(names) > MAX_TABLE_COLUMNS {
        return Err(sqldialect.inputError(&("a bulk load has 1 to " + MAX_TABLE_COLUMNS.toStr() + " columns, not " + len(names).toStr())))
    }
    var q = newStrBuf()
    q.add("SELECT TOP 0 ")
    for i in 0..len(names) {
        if len(names[i]) < 1 || utf16Units(&names[i]) > 128 || toUtf16(&names[i]).isErr() {
            return Err(sqldialect.inputError("a column's name is 1 to 128 characters of UTF-8"))
        }
        if i > 0 { q.add(", ") }
        q.add(&(bracketed(&names[i])))
    }
    q.add(&(" FROM " + table))
    return Ok(q.toStr())
}

fn binaryType(t: int): bool { return t == T_BIGVARBIN || t == T_BIGBINARY || t == T_VARBINARY || t == T_BINARY || t == T_IMAGE }

fn intType(t: int): bool { return t == T_INTN || t == T_INT1 || t == T_INT2 || t == T_INT4 || t == T_INT8 }
fn exactType(t: int): bool { return t == T_DECIMALN || t == T_NUMERICN || t == T_DECIMAL || t == T_NUMERIC }
fn moneyType(t: int): bool { return t == T_MONEYN || t == T_MONEY || t == T_MONEY4 }

// A bulk load under way: its INSERT BULK statement, each column's type (as
// it goes in COLMETADATA, fixed before the first row is sent), and the
// encoded bytes not yet sent (buf: COLMETADATA, then a ROW per row, then
// DONE).
pub type BulkWriter = record {
    pub statement: str
    cols: []TableCol
    infos: []str
    names: []str
    pub rows: int                   // the rows added so far
    pub buf: []byte
}

// The bulk load of rows into table, whose columns dest describes (the
// COLMETADATA of bulkColumnsQuery's result), in the rows' order, with
// first the first rows to go (the writer has them added). Each column
// goes as the type its first rows make it, as a table parameter's
// (tableParam), and the server converts it to the table's as an INSERT
// does, with these differences so that later rows fit:
//
//   - text and bytes go as (max) for a (max) or xml column (the server
//     takes no other type there, error 4816) and as nvarchar(4000) and
//     varbinary(8000) otherwise, whatever the values;
//   - a decimal goes as decimal(38, s), s the most decimal places of the
//     first rows' values and at least a decimal or numeric column's scale
//     (4 for money): an Int in such a column goes as a decimal too;
//   - a column whose first rows are all NULL goes as the column's own
//     kind: bigint for an integer column, bit, float, decimal(38, s) for
//     decimal, numeric and money, varbinary for a binary one, else
//     nvarchar.
//
// A column's nullability is dest's: the server refuses a load that differs
// (error 4816). E_INPUT for rows of another length than dest, a column with
// values of two kinds (but int and decimal), and a value its column's type
// cannot carry (BulkWriter.add).
pub fn bulkWriter(table: &str, dest: &[Column], first: &[[]sqldialect.Value], opts: &BulkOptions,
                  coll: &Collation): Result[BulkWriter, Error] {
    if !validTableName(&table) {
        return Err(sqldialect.inputError("a table's name must be one to three regular identifiers"))
    }
    let n = len(dest)
    if n < 1 || n > MAX_TABLE_COLUMNS {
        return Err(sqldialect.inputError(&("a bulk load has 1 to " + MAX_TABLE_COLUMNS.toStr() + " columns, not " + n.toStr())))
    }
    var cols: []TableCol = []
    var names: []str = []
    for i in 0..n {
        append(mut &cols, TableCol{kind: ColKind.Unknown, long: false, bulk: true, intDigits: 0, scale: 0})
        append(mut &names, "column " + bracketed(&dest[i].name))
    }
    for r in 0..len(first) {
        try rowLength(&first[r], r, n)
        for i in 0..n { try cols[i].take(&first[r][i], &names[i]) }
    }
    var b: []byte = []
    put8(mut &b, TK_COLMETADATA)
    put16(mut &b, n)
    var infos: []str = []
    var decl = newStrBuf()
    decl.add(&("INSERT BULK " + table + " ("))
    for i in 0..n {
        let t = dest[i].tdsType
        cols[i].long = dest[i].size < 0 || t == T_XML
        if cols[i].kind == ColKind.Unknown {
            cols[i].kind = if intType(t) { ColKind.Int } else if t == T_BITN || t == T_BIT { ColKind.Bool }
                else if t == T_FLTN || t == T_FLT4 || t == T_FLT8 { ColKind.Float }
                else if exactType(t) || moneyType(t) { ColKind.Dec }
                else if binaryType(t) { ColKind.Bytes } else { ColKind.Text }
        }
        if cols[i].kind == ColKind.Int && (exactType(t) || moneyType(t)) { cols[i].kind = ColKind.Dec }
        if cols[i].kind == ColKind.Dec {
            let s = max(cols[i].scale, if exactType(t) { dest[i].scale } else if moneyType(t) { 4 } else { 0 })
            if cols[i].intDigits + s > 38 {
                return Err(sqldialect.dbError(sqldialect.E_DEC_RANGE, &(names[i] + " needs " + (cols[i].intDigits + s).toStr() +
                                              " digits: SQL Server's decimal has 38")))
            }
            cols[i].scale = s
            cols[i].intDigits = 38 - s
        }
        let info = try cols[i].typeInfo(&"", coll)
        put32(mut &b, 0)                               // UserType
        put16(mut &b, (dest[i].flags & 1) | 8)          // Flags: dest's fNullable, usUpdateable read/write
        appendStr(mut &b, info)
        putBVarchar(mut &b, &dest[i].name)
        append(mut &infos, info)
        if i > 0 { decl.add(", ") }
        decl.add(&(bracketed(&dest[i].name) + " " + cols[i].sqlType(&"")))
    }
    decl.add(")")
    var with: []str = []
    if opts.tablock { append(mut &with, "TABLOCK") }
    if opts.checkConstraints { append(mut &with, "CHECK_CONSTRAINTS") }
    if opts.fireTriggers { append(mut &with, "FIRE_TRIGGERS") }
    if opts.keepNulls { append(mut &with, "KEEP_NULLS") }
    if len(with) > 0 { decl.add(&(" WITH (" + strings.join(&with, ", ") + ")")) }
    var bw = BulkWriter{statement: decl.toStr(), cols: cols, infos: infos, names: names, rows: 0, buf: b}
    try bw.add(first)
    return Ok(bw)
}

fn rowLength(row: &[]sqldialect.Value, r: int, n: int): Result[Unit, Error] {
    if len(row) != n {
        return Err(sqldialect.inputError(&("row " + (r + 1).toStr() + " has " + len(row).toStr() + " values for " +
                                         n.toStr() + " columns")))
    }
    return Ok(Unit{})
}

// Adds rows to the load, encoded onto buf. All or none: E_INPUT (buf as it
// was) for a row of another length, or a value its column's type cannot
// carry: another kind of value (an Int fits a decimal column), text of
// more than 4,000 UTF-16 units or bytes of more than 8,000 for a column
// that is not (max), a decimal with more decimal places than its column
// has (E_DEC_RANGE: more integer digits than it has room for). Rows count
// from 1 over the whole load.
pub fn (bw: mut &BulkWriter) add(rows: &[[]sqldialect.Value]): Result[Unit, Error] {
    let n = len(bw.cols)
    var b: []byte = []
    for r in 0..len(rows) {
        try rowLength(&rows[r], bw.rows + r, n)
        put8(mut &b, TK_ROW)
        for i in 0..n {
            match bw.cols[i].fits(&rows[r][i]) {
                Some(e) { return Err(sqldialect.dbError(e.code, &("row " + (bw.rows + r + 1).toStr() + ", " + bw.names[i] + ": " + e.msg))) }
                None {}
            }
            try bw.cols[i].put(mut &b, &rows[r][i], &bw.infos[i])
        }
    }
    for x in b { append(mut &bw.buf, x) }
    bw.rows += len(rows)
    return Ok(Unit{})
}

fn decRange(d: &str, scale: int): Option[Error] {
    return Some(sqldialect.dbError(sqldialect.E_DEC_RANGE, &(d + " has more integer digits than decimal(38," + scale.toStr() + ") has room for")))
}

fn misfit(why: &str): Option[Error] { return Some(sqldialect.inputError(why)) }

// Why v does not fit the column's type, or None.
fn (col: &TableCol) fits(v: &sqldialect.Value): Option[Error] {
    var k = ColKind.Unknown
    match v {
        sqldialect.Value.Null { return None }
        sqldialect.Value.Int(x) {
            if col.kind == ColKind.Dec && intDigits(x) > col.intDigits { return decRange(&(x.toStr()), col.scale) }
            k = ColKind.Int
        }
        sqldialect.Value.Float(_) { k = ColKind.Float }
        sqldialect.Value.Bool(_) { k = ColKind.Bool }
        sqldialect.Value.Text(t) {
            let u = utf16Units(&t)
            if col.kind == ColKind.Text && !col.long && u > 4000 {
                return misfit(&("text of " + u.toStr() + " UTF-16 units goes as nvarchar(4000): the column is not (max)"))
            }
            k = ColKind.Text
        }
        sqldialect.Value.Bytes(x) {
            if col.kind == ColKind.Bytes && !col.long && len(x) > 8000 {
                return misfit(&(len(x).toStr() + " bytes go as varbinary(8000): the column is not (max)"))
            }
            k = ColKind.Bytes
        }
        sqldialect.Value.Dec(d) {
            k = ColKind.Dec
            if col.kind == ColKind.Dec {
                let x = match decimalParts(d) {
                    Ok(p) { p }
                    Err(e) { return Some(e) }
                }
                if x.s > col.scale {
                    return misfit(&(d.toStr() + " has " + x.s.toStr() + " decimal places: the column goes as decimal(38," +
                                col.scale.toStr() + "), from its first rows"))
                }
                if x.p - x.s > col.intDigits { return decRange(&(d.toStr()), col.scale) }
            }
        }
    }
    if k == col.kind || (k == ColKind.Int && col.kind == ColKind.Dec) { return None }
    return misfit(&("a " + kindName(k) + " value: the column goes as " + col.sqlType(&"") + ", from its first rows"))
}

// Ends the load's rows: DONE onto buf.
pub fn (bw: mut &BulkWriter) end() {
    put8(mut &bw.buf, TK_DONE)
    put16(mut &bw.buf, 0)                               // Status
    put16(mut &bw.buf, 0)                               // CurCmd
    for k in 0..8 { put8(mut &bw.buf, 0) }              // DoneRowCount
}

// The whole bulk load of rows (bulkWriter with every row, ended): the
// statement and the BULK_LOAD message.
pub fn bulkLoad(table: str, dest: &[Column], rows: &[[]sqldialect.Value], opts: &BulkOptions,
                coll: &Collation): Result[BulkLoad, Error] {
    var bw = try bulkWriter(&table, dest, rows, opts, coll)
    bw.end()
    return Ok(BulkLoad{statement: bw.statement, payload: strFromBytes(&bw.buf)})
}

// ---------------------------------------------------------------- transactions

pub const PT_TRANSACTION = 14
pub const TM_BEGIN_XACT = 5
pub const TM_COMMIT_XACT = 7
pub const TM_ROLLBACK_XACT = 8

// A Transaction Manager request (packet type 14): TM_BEGIN_XACT (with the
// isolation level unchanged), TM_COMMIT_XACT or TM_ROLLBACK_XACT (with no
// new transaction after it), for the transaction descriptor txn.
pub fn tmRequest(kind: int, txn: &str): str {
    var b: []byte = []
    allHeaders(mut &b, txn)
    put16(mut &b, kind)
    if kind == TM_BEGIN_XACT {
        put8(mut &b, 0)            // isolation level: the session's
        put8(mut &b, 0)            // name: none
    } else {
        put8(mut &b, 0)            // name: none
        put8(mut &b, 0)            // fBeginXact: no new transaction
    }
    return strFromBytes(&b)
}

// ---------------------------------------------------------------- requests, as a server reads them

// The transaction descriptor in a request's ALL_HEADERS (zeros when none),
// and where the request's own data starts. E_PROTOCOL when malformed.
pub type Headers = value record { pub txn: str; pub end: int }

pub fn allHeadersOf(d: &str): Result[Headers, Error] {
    if len(d) < 4 { return Err(proto("a request without ALL_HEADERS")) }
    var c = cursor(&(d.toStr()))
    let total = try c.u32("ALL_HEADERS")
    if total < 4 || total > len(d) { return Err(proto("ALL_HEADERS out of bounds")) }
    var txn = noTransaction()
    while c.pos < total {
        let at = c.pos
        let n = try c.u32("a header")
        if n < 6 || at + n > total { return Err(proto("a header out of bounds")) }
        let kind = try c.u16("a header")
        if kind == 2 && n >= 14 { txn = try c.take(8, "the transaction descriptor") }
        c.pos = at + n
    }
    return Ok(Headers{txn: txn, end: total})
}

// A parameter of an RPC as a server reads it (MS-TDS 2.2.6.6): its name ("":
// positional), whether it is OUTPUT (fByRefValue) or its default
// (fDefaultValue), its type and its value.
pub type RpcParam = record {
    pub name: str
    pub output: bool
    pub byDefault: bool
    pub column: Column
    pub value: Cell
    pub table: Option[TableValue]     // a table-valued parameter (column.tdsType T_TABLE; value Null)
}

// A table-valued parameter as a server reads it (MS-TDS 2.2.5.5.5, TVP_TYPE_INFO
// and its rows): the type's name in its three parts (as sent; "" when not),
// its columns (flags: COL_DEFAULT for a column whose values are not sent,
// the server's to fill; name: ColName, usually ""), and its rows, a Cell
// for every column but those. isDefault: TVP_NULL_TOKEN, no metadata (the
// type's default, an empty table).
pub type TableValue = record {
    pub db: str
    pub schema: str
    pub typeName: str
    pub columns: []Column
    pub rows: [][]Cell
    pub isDefault: bool
}

// Whether a table-valued parameter's column is the server's to fill (fDefault).
pub fn (c: &Column) byServer(): bool { return (c.flags & COL_DEFAULT) != 0 }

// The most rows plus values a table-valued parameter read by parseRpc may
// hold (a request is at most what the server reads whole; this bounds the
// memory its cells take).
pub const MAX_TABLE_CELLS = 8388608

const TVP_ORDER_UNIQUE = 0x10
const TVP_COLUMN_ORDERING = 0x11

// A parameter's TYPE_INFO, its value after it: as a column's, but text,
// ntext and image without a table name, and their values without a text
// pointer: the length (0xFFFFFFFF NULL), then the bytes (SqlClient sends a
// long string as ntext).
fn paramTypeInfo(c: mut &Cur, col: mut &Column): Result[Unit, Error] {
    if col.tdsType == T_TEXT || col.tdsType == T_NTEXT || col.tdsType == T_IMAGE {
        col.framing = F_TEXT
        col.size = try c.u32("TYPE_INFO")
        if col.tdsType != T_IMAGE { col.collation = try parseCollation(&(try c.take(5, "TYPE_INFO"))) }
        return Ok(Unit{})
    }
    return typeInfo(c, col)
}

fn paramValue(c: mut &Cur, col: &Column): Result[Cell, Error] {
    if col.tdsType == T_TEXT || col.tdsType == T_NTEXT || col.tdsType == T_IMAGE {
        let vlen = try c.u32("a parameter's value")
        if vlen == 0xFFFFFFFF { return Ok(Cell.Null) }
        return Ok(decodeValue(col, &(try c.take(vlen, "a parameter's value"))))
    }
    return readValue(c, col)
}

// TVP_TYPE_INFO after its TVPTYPE byte, then the rows (TVP_ROW_TOKEN and a
// TYPE_VARBYTE per column sent, ..., TVP_END_TOKEN). E_PROTOCOL for
// anything malformed: no columns, more than MAX_TABLE_COLUMNS, a column of
// a table type, an unknown token, more than MAX_TABLE_CELLS
// rows and values, a column count of a type's default with rows after it.
fn tableValue(c: mut &Cur): Result[TableValue, Error] {
    var tv = TableValue{db: "", schema: "", typeName: "", columns: [], rows: [], isDefault: false}
    tv.db = try c.bvarchar("a table type's database")
    tv.schema = try c.bvarchar("a table type's schema")
    tv.typeName = try c.bvarchar("a table type's name")
    let n = try c.u16("a table-valued parameter's column count")
    if n == TVP_NULL {
        tv.isDefault = true
    } else {
        if n < 1 || n > MAX_TABLE_COLUMNS {
            return Err(proto(&("a table-valued parameter of " + n.toStr() + " columns (1 to " + MAX_TABLE_COLUMNS.toStr() + ")")))
        }
        for i in 0..n {
            let userType = try c.u32("a table-valued parameter's column")
            let flags = try c.u16("a table-valued parameter's column")
            var col = column(try c.u8("a table-valued parameter's column type"))
            if col.tdsType == T_TABLE { return Err(proto("a table-valued parameter's column of a table type")) }
            let t = col.tdsType
            if (t == T_DECIMALN || t == T_NUMERICN) && c.left() >= 3 && int(c.s[c.pos + 1]) == 0 {
                // mssql-jdbc's column of a table without rows, its precision unknown: decimal(0, 0), taken as 38
                col.framing = F_BYTE
                col.size = try c.u8("TYPE_INFO")
                let p = try c.u8("TYPE_INFO")
                col.precision = 38
                col.scale = try c.u8("TYPE_INFO")
                if col.size != 5 && col.size != 9 && col.size != 13 && col.size != 17 { return Err(proto(&(col.typeName() + " with length " + col.size.toStr()))) }
                if col.scale > 38 { return Err(proto(&(col.typeName() + " with scale " + col.scale.toStr()))) }
            } else {
                try paramTypeInfo(c, mut &col)
            }
            col.userType = userType
            col.flags = flags
            col.name = try c.bvarchar("a table-valued parameter's column name")
            append(mut &tv.columns, col)
        }
    }
    // TVP_ORDER_UNIQUE, TVP_COLUMN_ORDERING (hints: read, not kept), then TVP_END_TOKEN
    while true {
        let t = try c.u8("a table-valued parameter's metadata")
        if t == TVP_END { break }
        if t == TVP_ORDER_UNIQUE {
            let k = try c.u16("TVP_ORDER_UNIQUE")
            try c.skip(3 * k, "TVP_ORDER_UNIQUE")
        } else if t == TVP_COLUMN_ORDERING {
            let k = try c.u16("TVP_COLUMN_ORDERING")
            try c.skip(2 * k, "TVP_COLUMN_ORDERING")
        } else {
            return Err(proto(&("a table-valued parameter's metadata token 0x" + strings.hex(t))))
        }
    }
    var cells = 0
    while true {
        let t = try c.u8("a table-valued parameter's row")
        if t == TVP_END { break }
        if t != TVP_ROW { return Err(proto(&("a table-valued parameter's row token 0x" + strings.hex(t)))) }
        if tv.isDefault { return Err(proto("rows in a table-valued parameter sent as its default")) }
        cells += 1 + len(tv.columns)
        if cells > MAX_TABLE_CELLS {
            return Err(proto(&("a table-valued parameter of more than " + MAX_TABLE_CELLS.toStr() + " rows and values")))
        }
        var row: []Cell = []
        for i in 0..len(tv.columns) {
            if !tv.columns[i].byServer() { append(mut &row, try paramValue(c, &tv.columns[i])) }
        }
        append(mut &tv.rows, row)
    }
    return Ok(tv)
}

// One procedure call of an RPC request: a well-known procedure by its id
// (PROC_EXECUTESQL and the rest; procName "") or a procedure by its name
// (procId 0), its option flags, its parameters.
pub type RpcCall = record {
    pub procId: int
    pub procName: str
    pub options: int
    pub params: []RpcParam
}

pub const PROC_PREPARE = 11
pub const PROC_EXECUTE = 12
pub const PROC_PREPEXEC = 13
pub const PROC_PREPEXECRPC = 14
pub const PROC_UNPREPARE = 15

// An RPC request's calls (several in one request, each after a batch
// separator). E_PROTOCOL for anything malformed; a type this decoder does
// not know is E_PROTOCOL too. A table-valued parameter's rows are in its
// table (tableValue).
pub fn parseRpc(d: &str): Result[[]RpcCall, Error] {
    let h = try allHeadersOf(&d)
    var c = cursor(&d)
    c.pos = h.end
    var calls: []RpcCall = []
    while c.left() > 0 {
        var call = RpcCall{procId: 0, procName: "", options: 0, params: []}
        let n = try c.u16("the procedure")
        if n == 0xFFFF {
            call.procId = try c.u16("the procedure's id")
        } else {
            call.procName = try text16(&(try c.take(2 * n, "the procedure's name")), "the procedure's name")
        }
        call.options = try c.u16("the option flags")
        while c.left() > 0 {
            let b = int(strByte(c.s, c.pos))
            if b == 0xFF || b == 0xFE || b == 0x80 {
                c.pos += 1                                  // the next call
                break
            }
            let name = try c.bvarchar("a parameter's name")
            let status = try c.u8("a parameter's status")
            var col = column(try c.u8("a parameter's type"))
            col.name = name
            var v = Cell.Null
            var table: Option[TableValue] = None
            if col.tdsType == T_TABLE {
                col.framing = F_NONE
                table = Some(try tableValue(mut &c))
            } else {
                try paramTypeInfo(mut &c, mut &col)
                v = try paramValue(mut &c, &col)
            }
            append(mut &call.params, RpcParam{name: name, output: (status & 1) != 0, byDefault: (status & 2) != 0, column: col, value: v,
                                              table: table})
        }
        append(mut &calls, call)
    }
    return Ok(calls)
}

// ---------------------------------------------------------------- reading

// A position in a byte string, with an end.
type Cur = value record { s: str; pos: int; end: int }

fn cursor(s: &str): Cur { return Cur{s: s, pos: 0, end: len(s)} }

fn (c: &Cur) left(): int { return c.end - c.pos }

fn (c: &Cur) need(n: int, what: &str): Result[Unit, Error] {
    if n < 0 || n > c.end - c.pos {
        return Err(proto(&(what + ": " + n.toStr() + " bytes needed, " + (c.end - c.pos).toStr() + " left")))
    }
    return Ok(Unit{})
}

fn (c: mut &Cur) u8(what: &str): Result[int, Error] {
    try c.need(1, what)
    let v = int(c.s[c.pos])
    c.pos += 1
    return Ok(v)
}

fn (c: mut &Cur) u16(what: &str): Result[int, Error] {
    try c.need(2, what)
    let v = int(c.s[c.pos]) | (int(c.s[c.pos + 1]) << 8)
    c.pos += 2
    return Ok(v)
}

fn (c: mut &Cur) u32(what: &str): Result[int, Error] {
    try c.need(4, what)
    var v = 0
    for k in 0..4 { v = v | (int(c.s[c.pos + k]) << (8 * k)) }
    c.pos += 4
    return Ok(v)
}

// A little-endian integer of n bytes (1 to 8), sign-extended when signed.
fn (c: mut &Cur) le(n: int, signed: bool, what: &str): Result[int, Error] {
    try c.need(n, what)
    var v = 0
    for k in 0..n { v = v | (int(c.s[c.pos + k]) << (8 * k)) }
    if signed && n < 8 && ((v >> (8 * n - 1)) & 1) == 1 { v = v - (1 << (8 * n)) }
    c.pos += n
    return Ok(v)
}

fn (c: mut &Cur) u64(what: &str): Result[u64, Error] {
    try c.need(8, what)
    var v: u64 = 0
    for k in 0..8 { v = v | (u64(c.s[c.pos + k]) << (8 * k)) }
    c.pos += 8
    return Ok(v)
}

fn (c: mut &Cur) take(n: int, what: &str): Result[str, Error] {
    try c.need(n, what)
    let v = c.s[c.pos..c.pos + n]
    c.pos += n
    return Ok(v)
}

fn (c: mut &Cur) skip(n: int, what: &str): Result[Unit, Error] {
    try c.need(n, what)
    c.pos += n
    return Ok(Unit{})
}

// A cursor over the next n bytes; c moves past them.
fn (c: mut &Cur) sub(n: int, what: &str): Result[Cur, Error] {
    try c.need(n, what)
    let r = Cur{s: c.s, pos: c.pos, end: c.pos + n}
    c.pos += n
    return Ok(r)
}

fn text16(b: &str, what: &str): Result[str, Error] {
    match fromUtf16(b) {
        Ok(t) { return Ok(t) }
        Err(e) { return Err(proto(&(what + ": " + e))) }
    }
}

// B_VARCHAR: a length byte (characters), then UTF-16LE.
fn (c: mut &Cur) bvarchar(what: &str): Result[str, Error] {
    let n = try c.u8(what)
    return text16(&(try c.take(2 * n, what)), what)
}

// US_VARCHAR: a 2-byte length (characters), then UTF-16LE.
fn (c: mut &Cur) usvarchar(what: &str): Result[str, Error] {
    let n = try c.u16(what)
    return text16(&(try c.take(2 * n, what)), what)
}

// ---------------------------------------------------------------- collations

// A column's or the database's collation (MS-TDS 2.2.5.1.2): the Windows
// locale id, the comparison flags, the version and a SQL sort order id (0 for
// a Windows collation).
pub type Collation = value record {
    pub lcid: int
    pub flags: int       // bit 0 IgnoreCase, ..., 4 Binary, 5 Binary2, 6 UTF8
    pub version: int
    pub sortId: int
}

pub fn noCollation(): Collation { return Collation{lcid: 0, flags: 0, version: 0, sortId: 0} }

// The 5 bytes of a COLLATION.
pub fn parseCollation(b: &str): Result[Collation, Error] {
    if len(b) != 5 { return Err(proto(&("a collation of " + len(b).toStr() + " bytes"))) }
    var w = 0
    for k in 0..4 { w = w | (int(b[k]) << (8 * k)) }
    return Ok(Collation{lcid: w & 0xFFFFF, flags: (w >> 20) & 0xFF, version: (w >> 28) & 0xF, sortId: int(b[4])})
}

pub fn (c: &Collation) utf8(): bool { return (c.flags & 0x40) != 0 }

// The code page of char and varchar data in this collation: 65001 for
// UTF-8; from the SQL sort order when there is one this table knows, else
// from the locale's language; 0 when neither is known.
pub fn (c: &Collation) codePage(): int {
    if c.utf8() { return 65001 }
    let s = c.sortId
    if s >= 30 && s <= 34 { return 437 }
    if s >= 51 && s <= 54 { return 1252 }
    if (s >= 40 && s <= 44) || s == 49 || (s >= 55 && s <= 61) { return 850 }
    let lang = c.lcid & 0x3FF
    let sub = (c.lcid >> 10) & 0x3F
    match lang {
        0x09, 0x0C, 0x07, 0x0A, 0x10, 0x13, 0x16, 0x06, 0x14, 0x1D, 0x0B, 0x0F, 0x03, 0x2D, 0x21, 0x36, 0x38, 0x3E,
        0x41, 0x56 { return 1252 }
        0x05, 0x0E, 0x15, 0x18, 0x1B, 0x1C, 0x24 { return 1250 }
        0x1A { return if sub == 3 || sub == 7 { 1251 } else { 1250 } }   // Serbian Cyrillic; else Croatian, Serbian Latin
        0x19, 0x22, 0x23, 0x02, 0x2F, 0x3F, 0x40, 0x44, 0x50 { return 1251 }
        0x08 { return 1253 }
        0x1F, 0x2C, 0x43 { return 1254 }
        0x0D { return 1255 }
        0x01, 0x29, 0x20 { return 1256 }
        0x25, 0x26, 0x27 { return 1257 }
        0x2A { return 1258 }
        0x1E { return 874 }
        0x11 { return 932 }
        0x04 { return if sub == 1 || sub == 3 || sub == 5 { 950 } else { 936 } }
        0x12 { return 949 }
        else { return 0 }
    }
}

// "code page 1252 (LCID 0x0409, sort order 52)"
pub fn (c: &Collation) describe(): str {
    let cp = c.codePage()
    let what = if cp == 0 { "an unknown code page" } else { "code page " + cp.toStr() }
    return what + " (LCID 0x" + strings.padLeft(&(strings.hex(c.lcid)), 4, '0') + ", sort order " +
           c.sortId.toStr() + ")"
}

// ---------------------------------------------------------------- columns

// A result column as COLMETADATA describes it.
pub type Column = value record {
    pub name: str
    pub tdsType: int        // T_*
    pub size: int           // the type's length: bytes, or -1 for (max)
    pub precision: int
    pub scale: int
    pub collation: Collation
    pub flags: int          // bit 0: nullable
    pub userType: int
    framing: int
}

fn column(t: int): Column {
    return Column{name: "", tdsType: t, size: 0, precision: 0, scale: 0, collation: noCollation(), flags: 0,
                  userType: 0, framing: F_FIXED}
}

// The SQL Server name of a column's type: "int", "nvarchar", "float", ...
pub fn (c: &Column) typeName(): str {
    let t = c.tdsType
    match t {
        T_INT1 { return "tinyint" }
        T_INT2 { return "smallint" }
        T_INT4 { return "int" }
        T_INT8 { return "bigint" }
        T_INTN {
            match c.size {
                1 { return "tinyint" }
                2 { return "smallint" }
                4 { return "int" }
                else { return "bigint" }
            }
        }
        T_BIT, T_BITN { return "bit" }
        T_FLT4 { return "real" }
        T_FLT8 { return "float" }
        T_FLTN { return if c.size == 4 { "real" } else { "float" } }
        T_NVARCHAR { return "nvarchar" }
        T_NCHAR { return "nchar" }
        T_BIGVARCHR, T_VARCHAR { return "varchar" }
        T_BIGCHAR, T_CHAR { return "char" }
        T_BIGVARBIN, T_VARBINARY { return "varbinary" }
        T_BIGBINARY, T_BINARY { return "binary" }
        T_TEXT { return "text" }
        T_NTEXT { return "ntext" }
        T_IMAGE { return "image" }
        T_GUID { return "uniqueidentifier" }
        T_DECIMAL, T_DECIMALN { return "decimal" }
        T_NUMERIC, T_NUMERICN { return "numeric" }
        T_MONEY { return "money" }
        T_MONEY4 { return "smallmoney" }
        T_MONEYN { return if c.size == 4 { "smallmoney" } else { "money" } }
        T_DATETIME { return "datetime" }
        T_DATETIM4 { return "smalldatetime" }
        T_DATETIMN { return if c.size == 4 { "smalldatetime" } else { "datetime" } }
        T_DATEN { return "date" }
        T_TIMEN { return "time" }
        T_DATETIME2N { return "datetime2" }
        T_DATETIMEOFFSETN { return "datetimeoffset" }
        T_XML { return "xml" }
        T_UDT { return "udt" }
        T_SSVARIANT { return "sql_variant" }
        T_NULL { return "null" }
        else { return "type 0x" + strings.hex(t) }
    }
}

// TYPE_INFO (MS-TDS 2.2.5.6) into col.
fn typeInfo(c: mut &Cur, col: mut &Column): Result[Unit, Error] {
    let what = "TYPE_INFO"
    let t = col.tdsType
    match t {
        T_NULL { col.framing = F_NONE }
        T_INT1, T_BIT { col.size = 1 }
        T_INT2 { col.size = 2 }
        T_INT4, T_DATETIM4, T_FLT4, T_MONEY4 { col.size = 4 }
        T_MONEY, T_DATETIME, T_FLT8, T_INT8 { col.size = 8 }
        T_GUID, T_INTN, T_BITN, T_FLTN, T_MONEYN, T_DATETIMN {
            col.framing = F_BYTE
            col.size = try c.u8(&what)
            let ok = match t {
                T_INTN { col.size == 1 || col.size == 2 || col.size == 4 || col.size == 8 }
                T_BITN { col.size == 1 }
                T_FLTN, T_MONEYN, T_DATETIMN { col.size == 4 || col.size == 8 }
                else { col.size == 16 }
            }
            if !ok { return Err(proto(&(col.typeName() + " with length " + col.size.toStr()))) }
        }
        T_DECIMAL, T_NUMERIC, T_DECIMALN, T_NUMERICN {
            col.framing = F_BYTE
            col.size = try c.u8(&what)
            col.precision = try c.u8(&what)
            col.scale = try c.u8(&what)
            // (bcp declares 19 in a bulk load's COLMETADATA; its values are 17 at most)
            if col.size != 5 && col.size != 9 && col.size != 13 && col.size != 17 && col.size != 19 {
                return Err(proto(&(col.typeName() + " with length " + col.size.toStr())))
            }
            if col.precision < 1 || col.precision > 38 || col.scale > col.precision {
                return Err(proto(&(col.typeName() + "(" + col.precision.toStr() + ", " + col.scale.toStr() + ")")))
            }
        }
        T_DATEN {
            col.framing = F_BYTE
            col.size = 3
        }
        T_TIMEN, T_DATETIME2N, T_DATETIMEOFFSETN {
            col.framing = F_BYTE
            col.size = if t == T_TIMEN { 5 } else if t == T_DATETIME2N { 8 } else { 10 }      // the largest, at scale 7
            col.scale = try c.u8(&what)
            if col.scale > 7 { return Err(proto(&(col.typeName() + " with scale " + col.scale.toStr()))) }
        }
        T_CHAR, T_VARCHAR, T_BINARY, T_VARBINARY {
            col.framing = F_BYTE
            col.size = try c.u8(&what)
            if t == T_CHAR || t == T_VARCHAR { col.collation = try parseCollation(&(try c.take(5, &what))) }
        }
        T_BIGVARBIN, T_BIGBINARY, T_BIGVARCHR, T_BIGCHAR, T_NVARCHAR, T_NCHAR {
            col.size = try c.u16(&what)
            col.framing = F_USHORT
            if col.size == 0xFFFF {
                if t == T_BIGBINARY || t == T_BIGCHAR || t == T_NCHAR {
                    return Err(proto(&(col.typeName() + " cannot be (max)")))
                }
                col.size = -1
                col.framing = F_PLP
            }
            if t != T_BIGVARBIN && t != T_BIGBINARY { col.collation = try parseCollation(&(try c.take(5, &what))) }
        }
        T_TEXT, T_NTEXT, T_IMAGE {
            col.framing = F_TEXT
            col.size = try c.u32(&what)
            if t != T_IMAGE { col.collation = try parseCollation(&(try c.take(5, &what))) }
            let parts = try c.u8(&what)                     // the table's name, in parts
            for i in 0..parts { let p = try c.usvarchar(&what) }
        }
        T_XML {
            col.framing = F_PLP
            col.size = -1
            if try c.u8(&what) != 0 {
                let a = try c.bvarchar(&what)
                let b = try c.bvarchar(&what)
                let s = try c.usvarchar(&what)
            }
        }
        T_UDT {
            col.framing = F_PLP
            col.size = try c.u16(&what)
            let a = try c.bvarchar(&what)
            let b = try c.bvarchar(&what)
            let n = try c.bvarchar(&what)
            let q = try c.usvarchar(&what)
        }
        T_SSVARIANT {
            col.framing = F_VARIANT
            col.size = try c.u32(&what)
        }
        else { return Err(proto(&("unknown data type 0x" + strings.hex(t)))) }
    }
    return Ok(Unit{})
}

// ---------------------------------------------------------------- values

// A value of a row.
pub type Cell = value closed {
    Null
    Int(int)          // the integer types and bit
    Float(float)      // real and float, exact
    Text(str)         // nchar, nvarchar, ntext; char, varchar, text (by their collation); xml
    Bytes(str)        // binary, varbinary, image
    Dec(Decimal)      // decimal and numeric (display scale: the column's), money and smallmoney (scale 4)
    Date(time.Date)                       // date
    Time(time.TimeOfDay)                  // time(n)
    DateTime(time.LocalDateTime)          // datetime2(n), datetime, smalldatetime
    Offset(time.OffsetDateTime)           // datetimeoffset(n): the local date-time and its offset
    Guid(str)         // uniqueidentifier: the canonical text, "6F9619FF-8B86-D011-B42D-00C04FC964FF"
    Failed(str)       // a value that could not be decoded: why ("code page 1251 ...", "type sql_variant ...")
}

// The float with IEEE 754 double bits b (math.fromBits).
pub fn floatOfBits(b: int): float { return math.fromBits(b) }

// The float with IEEE 754 single bits b (0 to 2^32 - 1), exactly (math.fromBits32Int; bit 31
// spread above it, so a NaN keeps its sign).
pub fn floatOfBits32(b: int): float {
    return math.fromBits32Int(if (b >> 31) & 1 == 1 { b | ~0xffffffff } else { b & 0xffffffff })
}

fn unsupported(col: &Column): Cell {
    return Cell.Failed("type " + col.typeName() + " is not supported yet")
}

// One value of col (ROW, MS-TDS 2.2.7.19): its bytes by the type's framing,
// then decoded.
fn readValue(c: mut &Cur, col: &Column): Result[Cell, Error] {
    let what = "a value of column " + col.name
    match col.framing {
        F_NONE { return Ok(Cell.Null) }
        F_FIXED { return Ok(decodeValue(col, &(try c.take(col.size, &what)))) }
        F_BYTE {
            let n = try c.u8(&what)
            if n == 0 { return Ok(Cell.Null) }
            if n > col.size { return Err(proto(&(what + ": " + n.toStr() + " bytes for a size of " + col.size.toStr()))) }
            return Ok(decodeValue(col, &(try c.take(n, &what))))
        }
        F_USHORT {
            let n = try c.u16(&what)
            if n == 0xFFFF { return Ok(Cell.Null) }
            if n > col.size { return Err(proto(&(what + ": " + n.toStr() + " bytes for a size of " + col.size.toStr()))) }
            return Ok(decodeValue(col, &(try c.take(n, &what))))
        }
        F_TEXT {
            let tp = try c.u8(&what)
            if tp == 0 { return Ok(Cell.Null) }
            try c.skip(tp + 8, &what)                     // the text pointer and its timestamp
            let n = try c.u32(&what)
            return Ok(decodeValue(col, &(try c.take(n, &what))))
        }
        F_PLP {
            let total = try c.u64(&what)
            if total == PLP_NULL { return Ok(Cell.Null) }
            var b: []byte = []
            while true {
                let n = try c.u32(&what)
                if n == 0 { break }
                appendStr(mut &b, &(try c.take(n, &what)))
            }
            if total != PLP_NULL - 1 && u64(len(b)) != total {
                return Err(proto(&(what + ": PLP chunks of " + len(b).toStr() + " bytes for a total of " + total.toStr())))
            }
            return Ok(decodeValue(col, &(strFromBytes(&b))))
        }
        else {
            let n = try c.u32(&what)
            if n == 0 { return Ok(Cell.Null) }
            try c.skip(n, &what)
            return Ok(unsupported(col))
        }
    }
}

// The bytes b of a non-NULL value of col as a Cell.
fn decodeValue(col: &Column, b: &str): Cell {
    let t = col.tdsType
    match t {
        T_INT1, T_INT2, T_INT4, T_INT8, T_INTN, T_BIT, T_BITN {
            let n = len(b)
            if n != 1 && n != 2 && n != 4 && n != 8 { return Cell.Failed("an integer of " + n.toStr() + " bytes") }
            var v = 0
            for k in 0..n { v = v | (int(b[k]) << (8 * k)) }
            if t == T_BIT || t == T_BITN { return Cell.Int(if v != 0 { 1 } else { 0 }) }
            if n > 1 && n < 8 && ((v >> (8 * n - 1)) & 1) == 1 { v = v - (1 << (8 * n)) }   // tinyint is unsigned
            return Cell.Int(v)
        }
        T_FLT4, T_FLT8, T_FLTN {
            if len(b) != 4 && len(b) != 8 { return Cell.Failed("a float of " + len(b).toStr() + " bytes") }
            var v = 0
            for k in 0..len(b) { v = v | (int(b[k]) << (8 * k)) }
            if len(b) == 4 { return Cell.Float(floatOfBits32(v)) }
            return Cell.Float(floatOfBits(v))
        }
        T_NVARCHAR, T_NCHAR, T_NTEXT {
            match fromUtf16(b) {
                Ok(s) { return Cell.Text(s) }
                Err(e) { return Cell.Failed(e) }
            }
        }
        T_BIGVARCHR, T_BIGCHAR, T_TEXT, T_VARCHAR, T_CHAR {
            if !col.collation.utf8() {
                let cp = col.collation.codePage()
                if !codepage.supported(cp) {
                    return Cell.Failed("varchar data in " + col.collation.describe() + ": only UTF-8 collations, code page 1252 and ISO-8859-1 are supported yet")
                }
                match codepage.decode(cp, &b) {
                    Ok(s) { return Cell.Text(s) }
                    Err(e) { return Cell.Failed(e) }
                }
            }
            if !strings.isValidUtf8(b) { return Cell.Failed("invalid UTF-8 in a UTF-8 collation") }
            return Cell.Text(b)
        }
        T_BIGVARBIN, T_BIGBINARY, T_IMAGE, T_VARBINARY, T_BINARY { return Cell.Bytes(b) }
        T_DECIMAL, T_NUMERIC, T_DECIMALN, T_NUMERICN { return decimalCell(&b, col.scale) }
        T_MONEY, T_MONEY4, T_MONEYN { return moneyCell(&b) }
        T_DATEN {
            if len(b) != 3 { return Cell.Failed("a date of " + len(b).toStr() + " bytes") }
            match dateOf3(&b, 0) {
                Some(d) { return Cell.Date(d) }
                None { return Cell.Failed("a date out of range") }
            }
        }
        T_TIMEN, T_DATETIME2N, T_DATETIMEOFFSETN { return timeCell(t, &b, col.scale) }
        T_DATETIME, T_DATETIM4, T_DATETIMN { return datetimeCell(&b) }
        T_GUID {
            if len(b) != 16 { return Cell.Failed("a uniqueidentifier of " + len(b).toStr() + " bytes") }
            return Cell.Guid(guidText(b))
        }
        T_XML {
            // UTF-16LE, possibly after a byte order mark
            let x = if len(b) >= 2 && b[0] == 0xFF && b[1] == 0xFE { b[2..] } else { b }
            match fromUtf16(&x) {
                Ok(s) { return Cell.Text(s) }
                Err(e) { return Cell.Failed(e) }
            }
        }
        else { return unsupported(col) }
    }
}

// ---------------------------------------------------------------- exact and civil values

// Days from 1970-01-01 back to 0001-01-01 (date, datetime2) and to
// 1900-01-01 (datetime, smalldatetime).
const DAYS_0001 = -719162
const DAYS_1900 = -25567
const MAX_DAY = 3652058          // 9999-12-31, in days since 0001-01-01

// The unsigned little-endian integer of b[at..at + n] (n at most 7).
fn leOf(b: &str, at: int, n: int): int {
    var v = 0
    for k in 0..n { v = v | (int(b[at + k]) << (8 * k)) }
    return v
}

fn pow10i(n: int): int {
    var v = 1
    for i in 0..n { v = v * 10 }
    return v
}

// decimal and numeric (MS-TDS 2.2.5.5.1.6): a sign byte (1 positive, 0
// negative), then the magnitude, 4, 8, 12 or 16 bytes little-endian, the
// value magnitude * 10^-scale. The magnitude goes straight into a Decimal
// with the column's scale as its display scale.
fn decimalCell(b: &str, scale: int): Cell {
    let n = len(b) - 1
    // (SQL Server always sends 4, 8, 12 or 16 bytes of magnitude, the client's parameter (mssql-jdbc) as many as the value needs)
    if n < 1 || n > 16 { return Cell.Failed("a decimal of " + len(b).toStr() + " bytes") }
    if scale < 0 || scale > 38 { return Cell.Failed("a decimal with scale " + scale.toStr()) }
    var m: u128 = 0
    for k in 0..n { m = m | (u128(b[1 + k]) << (8 * k)) }
    let most: u128 = 99999999999999999999999999999999999999
    if m > most { return Cell.Failed("a decimal of more than 38 digits") }
    let units = if b[0] == 0 { -i128(m) } else { i128(m) }
    return Cell.Dec(fromFraction(units, scale))
}

// money: the high 32 bits (signed) then the low 32 bits of a count of
// 1/10,000; smallmoney: a signed 32-bit count. Display scale 4.
fn moneyCell(b: &str): Cell {
    if len(b) == 4 {
        var v = leOf(b, 0, 4)
        if v >= 0x80000000 { v -= 0x100000000 }
        return Cell.Dec(Decimal.fromUnits(v, 4))
    }
    if len(b) != 8 { return Cell.Failed("a money value of " + len(b).toStr() + " bytes") }
    var hi = leOf(b, 0, 4)
    if hi >= 0x80000000 { hi -= 0x100000000 }
    return Cell.Dec(Decimal.fromUnits((hi << 32) | leOf(b, 4, 4), 4))
}

// The date of 3 bytes at b[at..]: days since 0001-01-01, at most 9999-12-31.
fn dateOf3(b: &str, at: int): Option[time.Date] {
    let days = leOf(b, at, 3)
    if days > MAX_DAY { return None }
    return Some(time.dateOfDays(days + DAYS_0001))
}

// The bytes of time(n), and of the time part of datetime2(n) and
// datetimeoffset(n): 3 for n 0 to 2, 4 for 3 and 4, 5 for 5 to 7.
pub fn timeBytes(scale: int): int {
    if scale <= 2 { return 3 }
    if scale <= 4 { return 4 }
    return 5
}

// time(n), datetime2(n) and datetimeoffset(n) (MS-TDS 2.2.5.5.1.8): a count
// of 10^-n seconds since midnight, then for datetime2 the date (3 bytes),
// for datetimeoffset the date and a signed 2-byte offset in minutes. A
// datetimeoffset's time and date are UTC; the local date-time is UTC plus
// the offset.
fn timeCell(t: int, b: &str, scale: int): Cell {
    if scale < 0 || scale > 7 { return Cell.Failed("a time with scale " + scale.toStr()) }
    let tn = timeBytes(scale)
    let want = if t == T_TIMEN { tn } else if t == T_DATETIME2N { tn + 3 } else { tn + 5 }
    if len(b) != want { return Cell.Failed("a " + (if t == T_TIMEN { "time" } else if t == T_DATETIME2N { "datetime2" } else { "datetimeoffset" }) +
                                        "(" + scale.toStr() + ") of " + len(b).toStr() + " bytes") }
    let units = leOf(b, 0, tn)
    if units >= 86400 * pow10i(scale) { return Cell.Failed("a time of day past midnight") }
    let tod = time.TimeOfDay{nanos: units * pow10i(9 - scale)}
    if t == T_TIMEN { return Cell.Time(tod) }
    let d = match dateOf3(b, tn) {
        Some(x) { x }
        None { return Cell.Failed("a date out of range") }
    }
    let l = time.LocalDateTime{date: d, time: tod}
    if t == T_DATETIME2N { return Cell.DateTime(l) }
    var off = leOf(b, tn + 3, 2)
    if off >= 0x8000 { off -= 0x10000 }
    match l.atUtc().atOffset(off) {
        Some(o) { return Cell.Offset(o) }
        None { return Cell.Failed("an offset of " + off.toStr() + " minutes") }
    }
}

// datetime: signed days since 1900-01-01 (4 bytes), then 1/300 seconds since
// midnight (4 bytes); smalldatetime: unsigned days since 1900-01-01 and
// minutes since midnight (2 bytes each).
//
// datetime's ticks become milliseconds rounded to the nearest, (ticks * 10
// + 1) / 3: .000, .003, .007, .010, ... This is the server's own text for
// the value (CONVERT style 121, and what ODBC gives), and writing that text
// back gives the same tick. (CAST to datetime2(7) rounds to 100 ns instead:
// .0033333 for one tick.)
fn datetimeCell(b: &str): Cell {
    if len(b) == 4 {
        let mins = leOf(b, 2, 2)
        if mins >= 1440 { return Cell.Failed("a smalldatetime of " + mins.toStr() + " minutes") }
        return Cell.DateTime(time.LocalDateTime{date: time.dateOfDays(leOf(b, 0, 2) + DAYS_1900),
                                                time: time.TimeOfDay{nanos: mins * 60000000000}})
    }
    if len(b) != 8 { return Cell.Failed("a datetime of " + len(b).toStr() + " bytes") }
    var days = leOf(b, 0, 4)
    if days >= 0x80000000 { days -= 0x100000000 }
    let ticks = leOf(b, 4, 4)
    if days < -53690 || days > 2958463 || ticks >= 25920000 { return Cell.Failed("a datetime out of range") }
    let ms = (ticks * 10 + 1) / 3
    return Cell.DateTime(time.LocalDateTime{date: time.dateOfDays(days + DAYS_1900), time: time.TimeOfDay{nanos: ms * 1000000}})
}

const HEXU = "0123456789ABCDEF"

// The canonical text of a uniqueidentifier's 16 bytes: the first three
// groups are little-endian integers (4, 2 and 2 bytes), the last two the
// bytes in order.
pub fn guidText(b: &str): str { return guidOf(&b) }

fn guidOf(b: &str): str {
    let order = [3, 2, 1, 0, -1, 5, 4, -1, 7, 6, -1, 8, 9, -1, 10, 11, 12, 13, 14, 15]
    var out = newStrBuf()
    for k in order {
        if k < 0 {
            out.addByte('-')
        } else {
            let v = int(b[k])
            out.addByte(HEXU[v >> 4])
            out.addByte(HEXU[v & 15])
        }
    }
    return out.toStr()
}

// The 16 bytes of a uniqueidentifier's text (as guidText writes it, either
// case, braces allowed); None when it is not one.
pub fn guidBytes(s: &str): Option[str] {
    var t: str = s
    if len(t) == 38 && t[0] == '{' && t[37] == '}' { t = t[1..37] }
    if len(t) != 36 || t[8] != '-' || t[13] != '-' || t[18] != '-' || t[23] != '-' { return None }
    let hexDigits = t[0..8] + t[9..13] + t[14..18] + t[19..23] + t[24..36]
    let raw = match sqldialect.unhex(&hexDigits) {
        Some(x) { x }
        None { return None }
    }
    let order = [3, 2, 1, 0, 5, 4, 7, 6, 8, 9, 10, 11, 12, 13, 14, 15]
    var out = array(16, byte(0))
    for i in 0..16 { out[i] = raw[order[i]] }
    return Some(strFromBytes(&out))
}

fn pad(n: int, width: int): str { return strings.padLeft(&(n.toStr()), width, '0') }

// "13:45:07" and n digits of fraction: "13:45:07.1234567" for n = 7.
fn timeText(t: &time.TimeOfDay, n: int): str {
    var s = pad(t.hour(), 2) + ":" + pad(t.minute(), 2) + ":" + pad(t.second(), 2)
    if n > 0 { s = s + "." + pad(t.nano() / pow10i(9 - n), n) }
    return s
}

// The text of a non-NULL cell of col as SQL Server writes it (CONVERT style
// 121, which is also ODBC's): decimals with the column's scale, "2026-11-05",
// "13:45:07.1234567" (time(n) with n fraction digits), "2026-11-05
// 13:45:07.1234567" (datetime2(n)), "2026-11-05 13:45:07.1234567 +01:30"
// (datetimeoffset(n)), "2026-11-05 13:45:07.003" (datetime: always 3
// digits), "2026-11-05 13:45:00" (smalldatetime), the uniqueidentifier's
// canonical text; integers' and floats' digits; text as it is. None for
// NULL, binary and a cell that failed.
pub fn cellText(col: &Column, c: &Cell): Option[str] {
    match c {
        Cell.Text(t) { return Some(t) }
        Cell.Int(n) { return Some(n.toStr()) }
        Cell.Float(f) { return Some(f.toStr()) }
        Cell.Dec(d) { return Some(d.toStr()) }
        Cell.Date(d) { return Some(d.toStr()) }
        Cell.Time(t) { return Some(timeText(&t, col.scale)) }
        Cell.DateTime(l) {
            let t = col.tdsType
            let n = if t == T_DATETIME2N { col.scale } else if t == T_DATETIM4 || (t == T_DATETIMN && col.size == 4) { 0 } else { 3 }
            return Some(l.date.toStr() + " " + timeText(&l.time, n))
        }
        Cell.Offset(o) {
            let a = if o.offset < 0 { -o.offset } else { o.offset }
            return Some(o.local.date.toStr() + " " + timeText(&o.local.time, col.scale) + (if o.offset < 0 { " -" } else { " +" }) +
                        pad(a / 60, 2) + ":" + pad(a % 60, 2))
        }
        Cell.Guid(g) { return Some(g) }
        else { return None }
    }
}

// ---------------------------------------------------------------- replies

// An ERROR or INFO token.
pub type Message = value record {
    pub number: int
    pub state: int
    pub class: int          // severity: 0 to 10 information, 11 and up errors
    pub text: str
    pub server: str
    pub proc: str
    pub line: int
}

// "Msg 208, Level 16, State 1, Line 1: Invalid object name 'nope'."
pub fn (m: &Message) toStr(): str {
    return "Msg " + m.number.toStr() + ", Level " + m.class.toStr() + ", State " + m.state.toStr() + ", Line " +
           m.line.toStr() + ": " + m.text
}

// An ENVCHANGE token: the new and old values as text for the text types
// (database, language, character set, packet size, ...), as bytes for the
// others (collation, transaction descriptors).
pub type EnvChange = value record { pub kind: int; pub newValue: str; pub oldValue: str }

pub type LoginAck = value record {
    pub iface: int
    pub tdsVersion: int     // 0x74000004 for TDS 7.4
    pub progName: str       // "Microsoft SQL Server"
    pub version: str        // "16.0.4135"
}

pub type Feature = value record { pub id: int; pub data: str }

pub type Done = value record {
    pub token: int          // TK_DONE, TK_DONEPROC, TK_DONEINPROC
    pub status: int         // DONE_*
    pub curCmd: int
    pub count: int
}

// The rows of one COLMETADATA and the ROWs after it.
pub type ResultSet = record {
    pub columns: []Column
    pub rows: [][]Cell
    pub count: int          // the row count its DONE gave, or -1
}

// A reply, decoded.
pub type Reply = record {
    pub results: []ResultSet
    pub errors: []Message
    pub infos: []Message
    pub envs: []EnvChange
    pub loginAck: Option[LoginAck]
    pub features: []Feature
    pub dones: []Done
    pub returnStatus: Option[int]   // the last RETURNSTATUS
    pub statuses: []int             // every RETURNSTATUS, in order
    pub returnValues: []ReturnValue
    pub counts: []StatementCount    // every DONE, DONEPROC and DONEINPROC with a row count, in order
    pub affected: int       // the count of the last DONE that ends no result set, or -1
    open: bool              // the last result set has had no DONE yet
}

// A statement's row count (a DONE token with DONE_COUNT): the rows its
// result set has, or the rows it changed.
pub type StatementCount = value record {
    pub token: int          // TK_DONE, TK_DONEPROC or TK_DONEINPROC
    pub rows: int
    pub resultSet: int      // the index in Reply.results of the result set it ends, or -1
}

// A RETURNVALUE token: an output parameter of an RPC (status 1), or the
// value of a user-defined function (status 2).
pub type ReturnValue = record {
    pub ordinal: int
    pub name: str
    pub status: int
    pub column: Column      // its type (name: the parameter's)
    pub value: Cell
}

pub fn emptyReply(): Reply {
    return Reply{results: [], errors: [], infos: [], envs: [], loginAck: None, features: [], dones: [],
                 returnStatus: None, statuses: [], returnValues: [], counts: [], affected: -1, open: false}
}

// Decodes a reply's token stream, up to and including its final DONE (one
// without DONE_MORE). E_PROTOCOL for anything malformed: a length or count
// past the end, an unknown token or type, a ROW before any COLMETADATA,
// bytes after the final DONE, no final DONE. E_LIMIT past maxCells cells.
// A reply ends with a DONE without DONE_MORE, or (an RPC's) with a DONEPROC
// without DONE_MORE.
pub fn decode(data: &str, maxCells: int): Result[Reply, Error] {
    var r = emptyReply()
    var c = cursor(data)
    var cols: []Column = []
    var haveCols = false
    var cells = 0
    var final = false
    var procEnd = false
    while c.left() > 0 {
        procEnd = false
        if final { return Err(proto(&(c.left().toStr() + " bytes after the final DONE"))) }
        let tok = try c.u8("a token")
        match tok {
            TK_COLMETADATA {
                cols = try colMetadata(mut &c)
                haveCols = true
                var copy: []Column = []
                for x in cols { append(mut &copy, x) }
                if len(cols) > 0 {
                    append(mut &r.results, ResultSet{columns: copy, rows: [], count: -1})
                    r.open = true
                }
            }
            TK_ROW, TK_NBCROW {
                if !haveCols || len(r.results) == 0 { return Err(proto("a row before any COLMETADATA")) }
                cells += len(cols)
                if cells > maxCells { return Err(sqldialect.dbError(sqldialect.E_LIMIT, &("tds: a reply of more than " +
                                                 maxCells.toStr() + " values"))) }
                let row = try readRow(mut &c, &cols, tok == TK_NBCROW)
                let k = len(r.results) - 1
                append(mut &r.results[k].rows, row)
            }
            TK_DONE, TK_DONEPROC, TK_DONEINPROC {
                let d = Done{token: tok, status: try c.u16("DONE"), curCmd: try c.u16("DONE"), count: 0}
                let n = try c.u64("DONE")
                var done = d
                done.count = if n > 9223372036854775807 { -1 } else { int(n) }
                if (done.status & DONE_COUNT) != 0 {
                    append(mut &r.counts, StatementCount{token: tok, rows: done.count,
                                                         resultSet: if r.open { len(r.results) - 1 } else { -1 }})
                    if r.open {
                        let k = len(r.results) - 1
                        r.results[k].count = done.count
                    } else {
                        r.affected = done.count
                    }
                }
                r.open = false
                append(mut &r.dones, done)
                if tok == TK_DONE && (done.status & DONE_MORE) == 0 { final = true }
                if tok == TK_DONEPROC && (done.status & DONE_MORE) == 0 { procEnd = true }
            }
            TK_ERROR, TK_INFO {
                let m = try message(mut &c)
                if tok == TK_ERROR { append(mut &r.errors, m) } else { append(mut &r.infos, m) }
            }
            TK_ENVCHANGE { append(mut &r.envs, try envChange(mut &c)) }
            TK_LOGINACK { r.loginAck = Some(try loginAck(mut &c)) }
            TK_FEATUREEXTACK {
                while true {
                    let id = try c.u8("FEATUREEXTACK")
                    if id == 0xFF { break }
                    let n = try c.u32("FEATUREEXTACK")
                    append(mut &r.features, Feature{id: id, data: try c.take(n, "FEATUREEXTACK")})
                }
            }
            TK_RETURNSTATUS {
                let v = try c.le(4, true, "RETURNSTATUS")
                r.returnStatus = Some(v)
                append(mut &r.statuses, v)
            }
            TK_RETURNVALUE {
                cells += 1
                if cells > maxCells { return Err(sqldialect.dbError(sqldialect.E_LIMIT, &("tds: a reply of more than " +
                                                 maxCells.toStr() + " values"))) }
                append(mut &r.returnValues, try returnValue(mut &c))
            }
            TK_ORDER, TK_COLINFO, TK_TABNAME, TK_SSPI {
                let n = try c.u16("a token's length")
                try c.skip(n, &("token 0x" + strings.hex(tok)))
            }
            TK_SESSIONSTATE, TK_FEDAUTHINFO {
                let n = try c.u32("a token's length")
                try c.skip(n, &("token 0x" + strings.hex(tok)))
            }
            TK_OFFSET { try c.skip(4, "OFFSET") }
            TK_ALTMETADATA, TK_ALTROW { return Err(proto("COMPUTE results (ALTMETADATA, ALTROW) are not supported")) }
            TK_DATACLASSIFICATION { return Err(proto("DATACLASSIFICATION is not supported (it was not asked for)")) }
            else { return Err(proto(&("unknown token 0x" + strings.padLeft(&(strings.hex(tok)), 2, '0')))) }
        }
    }
    if !final && !procEnd { return Err(proto("the reply ended before its final DONE")) }
    return Ok(r)
}

// RETURNVALUE (MS-TDS 2.2.7.18): ordinal, name, status, user type, flags,
// TYPE_INFO, the value. Encrypted values (Always Encrypted) are E_PROTOCOL:
// the client never asks for them.
fn returnValue(c: mut &Cur): Result[ReturnValue, Error] {
    let what = "RETURNVALUE"
    let ordinal = try c.u16(&what)
    let name = try c.bvarchar(&what)
    let status = try c.u8(&what)
    let userType = try c.u32(&what)
    let flags = try c.u16(&what)
    if (flags & 0x0800) != 0 { return Err(proto("an encrypted RETURNVALUE")) }
    var col = column(try c.u8(&what))
    col.userType = userType
    col.flags = flags
    col.name = name
    try typeInfo(mut &c, mut &col)
    let v = try readValue(mut &c, &col)
    return Ok(ReturnValue{ordinal: ordinal, name: name, status: status, column: col, value: v})
}

// COLMETADATA's columns, the token's body at d[at..] (after its 0x81): the
// columns and where the token ends. A server reads a bulk load's with it
// (lexdb's TDS endpoint); Err when the bytes end inside it or make no sense.
pub type Metadata = record { pub cols: []Column; pub end: int }

pub fn parseColMetadata(d: &str, at: int): Result[Metadata, Error] {
    var c = Cur{s: d.toStr(), pos: at, end: len(d)}
    let cols = try colMetadata(mut &c)
    return Ok(Metadata{cols: cols, end: c.pos})
}

// Whether a column's values are PLP (a (max) type, xml, a UDT): scanRow
// gives such a value's chunks, each after its 4-byte length, up to the
// terminator.
pub fn (col: &Column) isPlp(): bool { return col.framing == F_PLP }

// The non-NULL value of col whose bytes are b (a PLP value's chunks
// joined) as a Cell.
pub fn decodeCell(col: &Column, b: &str): Cell { return decodeValue(col, b) }

fn colMetadata(c: mut &Cur): Result[[]Column, Error] {
    let n = try c.u16("COLMETADATA")
    var cols: []Column = []
    if n == 0xFFFF { return Ok(cols) }                  // no metadata
    for i in 0..n {
        let userType = try c.u32("COLMETADATA")
        let flags = try c.u16("COLMETADATA")
        var col = column(try c.u8("COLMETADATA"))
        col.userType = userType
        col.flags = flags
        try typeInfo(mut &c, mut &col)
        col.name = try c.bvarchar("a column name")
        append(mut &cols, col)
    }
    return Ok(cols)
}

fn readRow(c: mut &Cur, cols: &[]Column, nbc: bool): Result[[]Cell, Error] {
    var nulls = ""
    if nbc { nulls = try c.take((len(cols) + 7) / 8, "NBCROW's null bitmap") }
    var row: []Cell = []
    for i in 0..len(cols) {
        if nbc && ((int(nulls[i / 8]) >> (i % 8)) & 1) == 1 {
            append(mut &row, Cell.Null)
        } else {
            append(mut &row, try readValue(mut &c, &cols[i]))
        }
    }
    return Ok(row)
}

fn message(c: mut &Cur): Result[Message, Error] {
    let n = try c.u16("ERROR/INFO")
    var s = try c.sub(n, "ERROR/INFO")
    let number = try s.le(4, true, "ERROR/INFO")
    let state = try s.u8("ERROR/INFO")
    let class = try s.u8("ERROR/INFO")
    let text = try s.usvarchar("ERROR/INFO")
    let server = try s.bvarchar("ERROR/INFO")
    let procName = try s.bvarchar("ERROR/INFO")
    let line = try s.u32("ERROR/INFO")
    return Ok(Message{number: number, state: state, class: class, text: text, server: server, proc: procName, line: line})
}

fn envChange(c: mut &Cur): Result[EnvChange, Error] {
    let n = try c.u16("ENVCHANGE")
    var s = try c.sub(n, "ENVCHANGE")
    let kind = try s.u8("ENVCHANGE")
    match kind {
        1, 2, 3, 4, 5, 6, 13, 19 {
            let nv = try s.bvarchar("ENVCHANGE")
            let ov = if s.left() > 0 { try s.bvarchar("ENVCHANGE") } else { "" }
            return Ok(EnvChange{kind: kind, newValue: nv, oldValue: ov})
        }
        7, 8, 9, 10, 11, 12, 16, 17, 18 {
            let nn = try s.u8("ENVCHANGE")
            let nv = try s.take(nn, "ENVCHANGE")
            var ov = ""
            if s.left() > 0 {
                let on = try s.u8("ENVCHANGE")
                ov = try s.take(on, "ENVCHANGE")
            }
            return Ok(EnvChange{kind: kind, newValue: nv, oldValue: ov})
        }
        else { return Ok(EnvChange{kind: kind, newValue: try s.take(s.left(), "ENVCHANGE"), oldValue: ""}) }
    }
}

fn loginAck(c: mut &Cur): Result[LoginAck, Error] {
    let n = try c.u16("LOGINACK")
    var s = try c.sub(n, "LOGINACK")
    let iface = try s.u8("LOGINACK")
    let v = try s.take(4, "LOGINACK")
    let tdsv = (int(v[0]) << 24) | (int(v[1]) << 16) | (int(v[2]) << 8) | int(v[3])
    let prog = try s.bvarchar("LOGINACK")
    let major = try s.u8("LOGINACK")
    let minor = try s.u8("LOGINACK")
    let hi = try s.u8("LOGINACK")
    let lo = try s.u8("LOGINACK")
    return Ok(LoginAck{iface: iface, tdsVersion: tdsv, progName: prog,
                       version: major.toStr() + "." + minor.toStr() + "." + (hi * 256 + lo).toStr()})
}

// ---------------------------------------------------------------- transport

// What a session reads and writes through: plain TCP, or TLS over it.
type Stream = value closed {
    Plain(net.Conn)
    Tls(tls.Conn)
    Gone
}

fn (s: &Stream) isTls(): bool {
    match s {
        Stream.Tls(_) { return true }
        else { return false }
    }
}

// The TLS connection, taken out for a call that changes it (a match binds
// it read-only); s.put gives it back.
fn (s: mut &Stream) takeTls(): tls.Conn {
    match replace(s, Stream.Gone) {
        Stream.Tls(t) { return t }
        else { panic("tds: not a TLS stream") }
    }
}

fn (s: mut &Stream) put(t: tls.Conn) { let old = replace(s, Stream.Tls(t)) }

// Whether the idle connection can be used again, without parking (net's and
// tls's quiet: the server has not closed it and has sent nothing unasked).
fn (s: mut &Stream) quiet(): bool {
    if s.isTls() {
        var t = s.takeTls()
        let q = t.quiet()
        s.put(t)
        return q
    }
    match s {
        Stream.Plain(c) { return c.quiet() }
        else { return false }
    }
}

// The milliseconds left before the deadline dl (monotonic ns), at least 1;
// E_TIMEOUT once it has passed.
fn msLeft(dl: int): Result[int, Error] {
    let left = dl - time.monotonicNs()
    if left <= 0 { return Err(sqldialect.dbError(sqldialect.E_TIMEOUT, &("tds: no acknowledgement of ATTENTION within " + ABORT_MS.toStr() + " ms"))) }
    return Ok(max(1, left / 1000000))
}

// Reads what has arrived. dl < 0: the task's own cancellation and deadline
// apply; else they do not and dl (monotonic ns) is the deadline: cleanup
// after a cancellation (design/pool.md, stage 5).
fn (s: mut &Stream) read(b: mut &[byte], dl: int, w: Where): Result[int, Error] {
    let ms = if dl < 0 { -1 } else { try msLeft(dl) }
    if s.isTls() {
        var t = s.takeTls()
        let r = if ms < 0 { t.read(b, w) } else { t.readFor(b, ms, w) }
        s.put(t)
        return match r {
            Ok(n) { Ok(n) }
            Err(e) { Err(tlsFail(e)) }
        }
    }
    match s {
        Stream.Plain(c) {
            return match if ms < 0 { c.read(b, w) } else { c.readFor(b, ms, w) } {
                Ok(n) { Ok(n) }
                Err(e) { Err(ioFail(e)) }
            }
        }
        else { return Err(ioErr("the connection is closed")) }
    }
}

fn (s: mut &Stream) write(data: &[byte], dl: int, w: Where): Result[Unit, Error] {
    let ms = if dl < 0 { -1 } else { try msLeft(dl) }
    if s.isTls() {
        var t = s.takeTls()
        let r = if ms < 0 { t.write(data, w) } else { t.writeFor(data, ms, w) }
        s.put(t)
        return match r {
            Ok(_) { Ok(Unit{}) }
            Err(e) { Err(tlsFail(e)) }
        }
    }
    match s {
        Stream.Plain(c) {
            return match if ms < 0 { c.write(data, w) } else { c.writeFor(data, ms, w) } {
                Ok(_) { Ok(Unit{}) }
                Err(e) { Err(ioFail(e)) }
            }
        }
        else { return Err(ioErr("the connection is closed")) }
    }
}

// Bytes read ahead from the stream: buf[pos..end].
type Inbox = record { buf: []byte; pos: int; end: int }

// Reads more of the stream onto the inbox, after what it holds (moved to
// the front first). E_IO when the server closes the connection.
fn fillInbox(s: mut &Stream, ib: mut &Inbox, dl: int, w: Where): Result[Unit, Error] {
    if ib.pos > 0 {
        let n = ib.end - ib.pos
        for k in 0..n { ib.buf[k] = ib.buf[ib.pos + k] }
        ib.pos = 0
        ib.end = n
    }
    let e = ib.end
    let n = try s.read(mut &ib.buf[e..], dl, w)
    if n == 0 { return Err(ioErr("the server closed the connection")) }
    ib.end = e + n
    return Ok(Unit{})
}

// A message read: its packets' type and their payloads joined.
pub type Received = value record { pub ptype: int; pub data: str; pub status: int }

// A connection's packets: written a message at a time, read a message at a
// time (every packet up to the one with EOM).
//
// Reading is resumable: a packet is taken from the inbox only once all of it
// is in, and the payloads of the message being received stay in msg until
// its last packet. So a read that the task's cancellation or deadline ends
// loses nothing, and the session can read the rest of the reply afterwards.
pub type Transport = record {
    s: Stream
    inbox: Inbox             // 65,536 bytes: room for any packet (its length is 16 bits)
    pub packetSize: int
    msg: []byte              // the payloads of the message being received
    msgType: int             // its packets' type, -1 before its first
    msgStatus: int           // its first packet's status (a server reads RESETCONNECTION there)
}

pub fn transport(sock: net.Conn): Transport {
    return Transport{s: Stream.Plain(sock), inbox: Inbox{buf: array(65536, byte(0)), pos: 0, end: 0},
                     packetSize: DEFAULT_PACKET, msg: [], msgType: -1, msgStatus: 0}
}

// Sends one message as packets of the current packet size.
//
// Each packet is written by itself: under TLS, SQL Server reads a packet
// from its own TLS records, and drops the connection when one record holds
// the end of a packet and the start of the next.
pub fn (t: mut &Transport) send(ptype: int, payload: &str, w: Where): Result[Unit, Error] { return t.sendWith(ptype, payload, 0, -1, w) }

// send with first's bits in the first packet's status, and a deadline dl
// as Stream.read has. A write that fails may have sent part of a packet:
// the connection cannot be used after it.
fn (t: mut &Transport) sendWith(ptype: int, payload: &str, first: int, dl: int, w: Where): Result[Unit, Error] {
    let b = packetsWith(ptype, payload, t.packetSize, first)
    return t.writePackets(&b, dl, w)
}

// Writes whole packets: under TLS each by itself.
fn (t: mut &Transport) writePackets(b: &[]byte, dl: int, w: Where): Result[Unit, Error] {
    if !t.s.isTls() { return t.s.write(b, dl, w) }
    var off = 0
    while off < len(b) {
        let n = (int(b[off + 2]) << 8) | int(b[off + 3])
        try t.s.write(&b[off..off + n], dl, w)
        off += n
    }
    return Ok(Unit{})
}

// Reads one message. E_LIMIT when its payload passes limit bytes (the rest
// of it is not read), E_PROTOCOL for packets of different types. When the
// task's cancellation or deadline ends it, what has come stays (partial).
pub fn (t: mut &Transport) receive(limit: int, w: Where): Result[Received, Error] {
    while true {
        let p = try t.nextPacket(-1, w)
        if t.msgType < 0 {
            t.msgType = p.ptype
            t.msgStatus = p.status
        } else if p.ptype != t.msgType {
            return Err(proto(&("a packet of type " + p.ptype.toStr() + " inside a message of type " + t.msgType.toStr())))
        }
        if len(t.msg) + len(p.data) > limit {
            return Err(sqldialect.dbError(sqldialect.E_LIMIT, &("tds: a reply larger than " + limit.toStr() + " bytes")))
        }
        appendStr(mut &t.msg, p.data)
        if p.eom { break }
    }
    let r = Received{ptype: t.msgType, data: strFromBytes(&t.msg), status: t.msgStatus}
    t.msg = []
    t.msgType = -1
    return Ok(r)
}

// The part of a message that receive had read when it was ended, and its
// packets' type (-1: none); the transport no longer holds it.
fn (t: mut &Transport) takePartial(): Received {
    let r = Received{ptype: t.msgType, data: strFromBytes(&t.msg), status: t.msgStatus}
    t.msg = []
    t.msgType = -1
    return r
}

// One packet of a message.
pub type Packet = value record { pub ptype: int; pub eom: bool; pub data: str; pub status: int }

// Reads one packet (a stream reads its reply a packet at a time).
pub fn (t: mut &Transport) receivePacket(w: Where): Result[Packet, Error] { return t.nextPacket(-1, w) }

// The next packet, taken from the inbox once all of it is in, reading the
// stream as needed (dl as Stream.read has).
fn (t: mut &Transport) nextPacket(dl: int, w: Where): Result[Packet, Error] {
    while true {
        let have = t.inbox.end - t.inbox.pos
        if have >= HEADER {
            let at = t.inbox.pos
            let h = try parseHeader(&t.inbox.buf[at..at + HEADER])
            if have >= h.length {
                t.inbox.pos = at + h.length
                return Ok(Packet{ptype: h.ptype, eom: (h.status & STATUS_EOM) != 0, data: strFromBytes(&t.inbox.buf[at + HEADER..at + h.length]),
                              status: h.status})
            }
        }
        try fillInbox(mut &t.s, mut &t.inbox, dl, w)
    }
    return Err(proto("unreachable"))
}

fn (t: &Transport) buffered(): bool { return t.inbox.pos < t.inbox.end }

// Puts TLS over the socket, with an engine whose handshake is done.
pub fn (t: mut &Transport) startTls(e: tls.Engine): Result[Unit, Error] {
    if t.buffered() { return Err(proto("bytes after the TLS handshake")) }
    match replace(mut &t.s, Stream.Gone) {
        Stream.Plain(c) {
            t.s = Stream.Tls(tls.over(e, c))
            return Ok(Unit{})
        }
        else { return Err(ioErr("TLS on a connection that is not plain")) }
    }
}

// Ends TLS without close_notify (encryption for the login only); bytes
// that arrived after the last record are read next, as plain bytes.
pub fn (t: mut &Transport) stopTls(): Result[Unit, Error] {
    match replace(mut &t.s, Stream.Gone) {
        Stream.Tls(c) {
            let tls.Detached{sock: sock, rest: rest} = c.detach()
            t.s = Stream.Plain(sock)
            if len(rest) > 0 {
                var b = rest
                for k in t.inbox.pos..t.inbox.end { append(mut &b, t.inbox.buf[k]) }
                let n = len(b)
                if n > len(t.inbox.buf) { t.inbox.buf = array(n, byte(0)) }
                for k in 0..n { t.inbox.buf[k] = b[k] }
                t.inbox.pos = 0
                t.inbox.end = n
            }
            return Ok(Unit{})
        }
        else { return Err(ioErr("the connection is not encrypted")) }
    }
}

// ---------------------------------------------------------------- sessions

// How a connection is encrypted (Encrypt=).
pub type Encrypt = value closed {
    Mandatory      // yes: TLS for the whole connection, or no connection
    Optional       // no: TLS for the login at least; the whole connection if the server requires it
    Strict         // TDS 8.0: not supported yet
}

// Where and how to connect: sqlserver fills it from a connection string.
pub type Config = value record {
    pub host: str
    pub port: int
    pub user: str
    pub password: str
    pub database: str
    pub appName: str
    pub encrypt: Encrypt
    pub trustServerCertificate: bool    // tls's insecureSkipVerify
    pub hostNameInCertificate: str      // "" : host
    pub packetSize: int
}

// The encryption a session got.
pub type Encryption = value closed {
    Full         // TLS for everything
    LoginOnly    // TLS for the LOGIN7 packet only (both sides had encryption off)
    Off          // none (the server does not support encryption, and Encrypt=no)
}

pub fn (e: Encryption) toStr(): str {
    match e {
        Encryption.Full { return "full" }
        Encryption.LoginOnly { return "login only" }
        Encryption.Off { return "off" }
    }
}

// A logged-in connection.
pub type Session = record {
    t: Transport
    pub encryption: Encryption
    pub tdsVersion: int
    pub serverName: str          // LOGINACK's program name, "Microsoft SQL Server"
    pub serverVersion: str       // "16.0.4135"
    pub preloginVersion: str
    pub database: str
    pub collation: Collation
    pub utf8: bool               // the server acknowledged UTF8_SUPPORT
    pub maxReply: int            // bytes a reply may have (MAX_REPLY)
    pub broken: bool             // a request failed on the wire: no more requests
    txn: str                     // the transaction descriptor, 8 bytes
    pub infos: []Message         // the INFO messages of the last request (login: "Changed database context ...")
    pub errors: []Message        // the ERROR messages of the last request
    pub language: str            // ENVCHANGE 2: "us_english"
    pub charset: str             // ENVCHANGE 3 (TDS 7 servers send none)
    pub sortLocale: str          // ENVCHANGE 5: the Unicode sorting locale id
    pub sortFlags: str           // ENVCHANGE 6: the Unicode comparison flags
    pub mirrorPartner: str       // ENVCHANGE 13: the database mirroring partner
    pub userInstance: str        // ENVCHANGE 19
    pub resets: int              // ENVCHANGE 18: RESETCONNECTION acknowledged, so many times
    rr: RowReader                // a reply read a row at a time (stream)
    part: int                    // the packets sent of a message sent in parts (sendPart), 0 when none is
    resetNext: bool              // the next request asks for RESETCONNECTION
    login: Restored              // the login's database, language and collation: a reset returns to them
}

// What RESETCONNECTION gives back: the session's state after its login. The
// server sends no ENVCHANGE for them with the reset's acknowledgement.
type Restored = value record { database: str; language: str; collation: Collation }

fn addrOf(host: &str, port: int): str {
    if strings.indexOf(host, ":", 0) >= 0 { return "[" + host + "]:" + port.toStr() }
    return host + ":" + port.toStr()
}

// The first ERROR of a reply as the error of a call: its number as the code.
pub fn serverError(m: &Message): Error {
    return Error{code: m.number, state: "", msg: m.text}
}

// Connects, negotiates encryption in PRELOGIN, runs the TLS handshake
// inside PRELOGIN packets, and logs in with LOGIN7. Every step parks only
// the task. The server's login error (18456 "Login failed for user ...")
// comes back with its number as the code.
pub fn open(cfg: &Config, w: Where): Result[Session, Error] {
    if cfg.encrypt == Encrypt.Strict {
        return Err(sqldialect.inputError("Encrypt=strict (TDS 8.0) is not supported yet"))
    }
    let sock = match net.dial(&(addrOf(&cfg.host, cfg.port)), w) {
        Ok(c) { c }
        Err(e) { return Err(ioFail(e)) }
    }
    sock.setNoDelay(true)
    var t = transport(sock)
    let want = if cfg.encrypt == Encrypt.Mandatory { ENCRYPT_ON } else { ENCRYPT_OFF }
    try t.send(PT_PRELOGIN, &(preloginRequest(want)), w)
    let m = try t.receive(65536, w)
    if m.ptype != PT_REPLY && m.ptype != PT_PRELOGIN {
        return Err(proto(&("a PRELOGIN answer in a packet of type " + m.ptype.toStr())))
    }
    let pre = try parsePrelogin(&m.data)
    let srv = pre.encryption & 0x7F
    var enc = Encryption.Full
    if want == ENCRYPT_ON {
        if srv != ENCRYPT_ON && srv != ENCRYPT_REQ {
            return Err(ioErr("the server does not support encryption (Encrypt=yes needs it)"))
        }
    } else if srv == ENCRYPT_OFF {
        enc = Encryption.LoginOnly
    } else if srv == ENCRYPT_NOT_SUP {
        enc = Encryption.Off
    } else if srv != ENCRYPT_ON && srv != ENCRYPT_REQ {
        return Err(proto(&("PRELOGIN: encryption value " + srv.toStr())))
    }
    if enc != Encryption.Off { try handshake(mut &t, cfg, w) }
    let login = Login{hostName: hostName(), userName: cfg.user, password: cfg.password, appName: cfg.appName,
                      serverName: cfg.host, library: "lxl tds", language: "", database: cfg.database,
                      packetSize: cfg.packetSize, clientPid: 0, utf8: true}
    try t.send(PT_LOGIN7, &(try login7(&login)), w)
    if enc == Encryption.LoginOnly { try t.stopTls() }
    let a = try t.receive(MAX_REPLY, w)
    if a.ptype != PT_REPLY { return Err(proto(&("a login answer in a packet of type " + a.ptype.toStr()))) }
    var r = try decode(&a.data, MAX_REPLY / 8)
    if len(r.errors) > 0 { return Err(serverError(&r.errors[0])) }
    let ack = match r.loginAck {
        Some(x) { x }
        None { return Err(proto("the login's answer has no LOGINACK")) }
    }
    if ack.tdsVersion < 0x72090002 {
        return Err(proto(&("the server speaks TDS version 0x" + strings.hex(ack.tdsVersion) + ", older than 7.2")))
    }
    var s = Session{t: t, encryption: enc, tdsVersion: ack.tdsVersion, serverName: ack.progName,
                    serverVersion: ack.version, preloginVersion: pre.version, database: "", collation: noCollation(),
                    utf8: false, maxReply: MAX_REPLY, broken: false, resetNext: false, txn: noTransaction(), infos: replace(mut &r.infos, []),
                    errors: [], language: "", charset: "", sortLocale: "", sortFlags: "", mirrorPartner: "",
                    userInstance: "", resets: 0, rr: noReader(), part: 0,
                    login: Restored{database: "", language: "", collation: noCollation()}}
    for f in r.features {
        if f.id == FEATURE_UTF8 && len(f.data) >= 1 && f.data[0] != 0 { s.utf8 = true }
    }
    for e in r.envs {
        if e.kind == ENV_ROUTING { return Err(ioErr("the server redirects the connection elsewhere (routing), which is not supported yet")) }
    }
    try s.apply(&r.envs)
    s.login = Restored{database: s.database, language: s.language, collation: s.collation}
    return Ok(s)
}

// The TLS handshake through PRELOGIN packets (MS-TDS 2.2.6.5), then the
// engine over the socket.
fn handshake(t: mut &Transport, cfg: &Config, w: Where): Result[Unit, Error] {
    var o = tls.defaults()
    o.insecureSkipVerify = cfg.trustServerCertificate
    let ctx = match tls.client(o) {
        Ok(c) { c }
        Err(e) { return Err(tlsFail(e)) }
    }
    let name = if len(cfg.hostNameInCertificate) > 0 { cfg.hostNameInCertificate } else { cfg.host }
    var e = match ctx.engine(&name) {
        Ok(x) { x }
        Err(x) { return Err(tlsFail(x)) }
    }
    while true {
        let r = e.handshake()
        let out = e.takeOutput()
        if len(out) > 0 { try t.send(PT_PRELOGIN, &(strFromBytes(&out)), w) }
        let done = match r {
            Ok(d) { d }
            Err(x) { return Err(tlsFail(x)) }
        }
        if done { break }
        let m = try t.receive(1048576, w)
        if m.ptype != PT_PRELOGIN && m.ptype != PT_REPLY {
            return Err(proto(&("a TLS handshake packet of type " + m.ptype.toStr())))
        }
        e.feed(&strToBytes(m.data))
    }
    return t.startTls(e)
}

fn hostName(): str {
    match io.read("/proc/sys/kernel/hostname") {
        Ok(h) {
            let n = strings.trim(&h)
            if len(n) > 0 && len(n) <= 128 { return n }
        }
        Err(_) {}
    }
    return "localhost"
}

// Applies ENVCHANGE tokens (MS-TDS 2.2.7.9): the database, language,
// collation and packet size, and the transaction descriptor (begin, commit,
// rollback, enlist and defect, transaction ended) are applied; the
// character set, Unicode sort locale and flags, the mirroring partner, the
// user instance and RESETCONNECTION's acknowledgement are kept. Routing (20)
// at login is refused by open; promotion (15) and the DTC manager's address
// (16) are distributed transactions, which this client does not ask for.
fn (s: mut &Session) apply(envs: &[]EnvChange): Result[Unit, Error] {
    for e in envs {
        match e.kind {
            ENV_DATABASE { s.database = e.newValue }
            ENV_LANGUAGE { s.language = e.newValue }
            ENV_CHARSET { s.charset = e.newValue }
            5 { s.sortLocale = e.newValue }
            6 { s.sortFlags = e.newValue }
            13 { s.mirrorPartner = e.newValue }
            19 { s.userInstance = e.newValue }
            ENV_RESETACK {
                s.resets += 1
                s.database = s.login.database
                s.language = s.login.language
                s.collation = s.login.collation
            }
            ENV_COLLATION { if len(e.newValue) == 5 { s.collation = try parseCollation(&e.newValue) } }
            ENV_PACKETSIZE {
                let n = match strings.parseIntOpt(&e.newValue) {
                    Some(x) { x }
                    None { return Err(proto(&("a packet size of " + e.newValue))) }
                }
                if n < MIN_PACKET || n > MAX_PACKET { return Err(proto(&("a packet size of " + n.toStr()))) }
                s.t.packetSize = n
            }
            ENV_BEGINTRAN, 11 {
                if len(e.newValue) != 8 { return Err(proto(&("a transaction descriptor of " + len(e.newValue).toStr() + " bytes"))) }
                s.txn = e.newValue
            }
            ENV_COMMITTRAN, ENV_ROLLBACKTRAN, ENV_TRANENDED, 12 { s.txn = noTransaction() }
            else {}
        }
    }
    return Ok(Unit{})
}

pub fn (s: &Session) packetSize(): int { return s.t.packetSize }

// Whether a transaction is open (the server has given a descriptor).
pub fn (s: &Session) inTransaction(): bool { return s.txn != noTransaction() }

// Runs a batch: sends SQLBatch and decodes the whole reply. The reply's
// ERROR tokens are in reply.errors (and Session.errors), not an Err: the
// caller decides. Err is E_INPUT for SQL text that is not UTF-8, or a
// failure on the wire, after which the session is broken.
pub fn (s: mut &Session) batch(sql: &str, w: Where): Result[Reply, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    let payload = try sqlBatch(sql, &s.txn)
    return s.request(PT_SQLBATCH, &payload, w)
}

// Runs sql through sp_executesql with the parameters (named by the caller:
// @p1, @p2, ...), as batch does otherwise.
pub fn (s: mut &Session) executeSql(sql: &str, params: &[Param], w: Where): Result[Reply, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    let payload = try executeSql(sql, params, &s.txn, &s.collation)
    return s.request(PT_RPC, &payload, w)
}

// Runs the procedure proc by its name with the parameters (procCall), as
// batch does otherwise.
pub fn (s: mut &Session) callProc(proc: &str, params: &[Param], w: Where): Result[Reply, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    let payload = try procCall(proc, params, &s.txn)
    return s.request(PT_RPC, &payload, w)
}

// Sends the BULK_LOAD message of a bulk load whose INSERT BULK statement
// the server has accepted (in a batch just before): the reply's DONE has
// the rows loaded.
pub fn (s: mut &Session) bulkData(payload: str, w: Where): Result[Reply, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    return s.request(PT_BULK, &payload, w)
}

// Sends what the bulk load has encoded and not sent (sendPart): its whole
// packets, or with last (after end) all of it. The bulk load's INSERT BULK
// must have been accepted just before.
pub fn (s: mut &Session) bulkSend(bw: mut &BulkWriter, last: bool, w: Where): Result[Unit, Error] {
    let n = try s.sendPart(PT_BULK, &bw.buf, last, w)
    if n > 0 {
        var rest: []byte = []
        for i in n..len(bw.buf) { append(mut &rest, bw.buf[i]) }
        bw.buf = rest
    }
    return Ok(Unit{})
}

// Sends a Transaction Manager request: TM_BEGIN_XACT, TM_COMMIT_XACT or
// TM_ROLLBACK_XACT, for the current transaction.
pub fn (s: mut &Session) transact(kind: int, w: Where): Result[Reply, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    return s.request(PT_TRANSACTION, &(tmRequest(kind, &s.txn)), w)
}

// Whether an idle session's connection is still there: nothing read ahead
// and the stream quiet (a pool's check before it hands the connection out
// again; no I/O that parks).
pub fn (s: mut &Session) quiet(): bool {
    if s.broken || s.rr.active || s.t.inbox.pos < s.t.inbox.end { return false }
    return s.t.s.quiet()
}

// Asks for RESETCONNECTION on the next request (a pool gives the session
// back): the server resets the session's state (temporary tables, SET
// options, the database and language of the login) before running it. No
// I/O.
pub fn (s: mut &Session) resetOnNext() { s.resetNext = true }

// Sends a request, with RESETCONNECTION when it was asked for. A failure
// breaks the session: part of a packet may have gone.
fn (s: mut &Session) sendRequest(ptype: int, payload: &str, w: Where): Result[Unit, Error] {
    let first = if s.resetNext { STATUS_RESET } else { 0 }
    match s.t.sendWith(ptype, payload, first, -1, w) {
        Ok(_) {}
        Err(e) {
            s.broken = true
            return Err(e)
        }
    }
    s.resetNext = false
    return Ok(Unit{})
}

fn (s: mut &Session) request(ptype: int, payload: &str, w: Where): Result[Reply, Error] {
    try s.settle(w)
    try s.sendRequest(ptype, payload, w)
    return s.reply(w)
}

// Sends part of a message of type ptype (a bulk load's rows as they are
// encoded): the whole packets in data now, keeping at least one byte back,
// or with last all of it, the final packet with EOM. The first packet of a
// message asks for RESETCONNECTION when it was asked for. Returns how many
// bytes of data went (data[..n]); read the reply with partReply. A failure
// breaks the session: part of a packet may have gone.
pub fn (s: mut &Session) sendPart(ptype: int, data: &[]byte, last: bool, w: Where): Result[int, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    if s.part == 0 { try s.settle(w) }
    let room = s.t.packetSize - HEADER
    var out: []byte = []
    var off = 0
    while len(data) - off > room || (last && (off < len(data) || (off == 0 && s.part == 0))) {
        let n = min(len(data) - off, room)
        let eom = last && off + n == len(data)
        s.part += 1
        let status = (if eom { STATUS_EOM } else { 0 }) | (if s.part == 1 && s.resetNext { STATUS_RESET } else { 0 })
        packetInto(mut &out, ptype, status, s.part, &data[off..off + n])
        off += n
        if eom { break }
    }
    if len(out) > 0 {
        match s.t.writePackets(&out, -1, w) {
            Ok(_) {}
            Err(e) {
                s.broken = true
                s.part = 0
                return Err(e)
            }
        }
        s.resetNext = false
    }
    if last { s.part = 0 }
    return Ok(off)
}

// Ends a message of type ptype that sendPart has begun, or that the server
// awaits (a bulk load's rows after INSERT BULK) with none of it sent yet,
// without the server acting on it: an empty last packet with IGNORE, then
// the server's reply read (SQL Server's: INFO 3621, "The statement has
// been terminated").
pub fn (s: mut &Session) cancelPart(ptype: int, w: Where): Result[Reply, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    var out: []byte = []
    packetInto(mut &out, ptype, STATUS_EOM | STATUS_IGNORE, s.part + 1, &[])
    s.part = 0
    match s.t.writePackets(&out, -1, w) {
        Ok(_) {}
        Err(e) {
            s.broken = true
            return Err(e)
        }
    }
    return s.reply(w)
}

// The reply to a message sent in parts.
pub fn (s: mut &Session) partReply(w: Where): Result[Reply, Error] { return s.reply(w) }

// Reads and decodes the reply to the request just sent.
fn (s: mut &Session) reply(w: Where): Result[Reply, Error] {
    let got = match s.t.receive(s.maxReply, w) {
        Ok(x) { x }
        Err(e) { return Err(s.abandon(e, w)) }
    }
    if got.ptype != PT_REPLY {
        s.broken = true
        return Err(proto(&("a reply in a packet of type " + got.ptype.toStr())))
    }
    let decoded = decode(&got.data, s.maxReply / 8)
    if decoded.isErr() { s.broken = true }
    let reply = try decoded
    s.infos = []
    for m in reply.infos { append(mut &s.infos, m) }
    s.errors = []
    for m in reply.errors { append(mut &s.errors, m) }
    try s.apply(&reply.envs)
    return Ok(reply)
}

fn recoverable(e: &Error): bool { return e.code == sqldialect.E_CANCELLED || e.code == sqldialect.E_TIMEOUT }

// receive was ended while it read a reply. When the task's cancellation or
// deadline ended it, the server is told to stop (ATTENTION) and the rest of
// the reply is read and dropped, its ENVCHANGEs applied (settle, within
// ABORT_MS whatever the task's state), so the session is usable again and
// e is the call's error. Any other failure, or one of that cleanup, breaks
// the session.
fn (s: mut &Session) abandon(e: Error, w: Where): Error {
    let part = s.t.takePartial()
    if !recoverable(&e) || (part.ptype >= 0 && part.ptype != PT_REPLY) {
        s.broken = true
        return e
    }
    s.rr = noReader()
    s.rr.active = true
    s.rr.data = part.data
    match s.settle(w) {
        Ok(_) {}
        Err(_) {}                         // broken by settle
    }
    return e
}

// ---------------------------------------------------------------- streamed replies (stage T3)

// A reply read a token at a time, so a result set's rows are decoded as
// they arrive and never all held: data[pos..] are the bytes received and not
// yet decoded (a row may span packets: the rest of a packet is joined to the
// next one); eom: the reply's last packet is in.
type RowReader = record {
    active: bool            // a reply is being read: settle ends it before another request
    data: str
    pos: int
    eom: bool
    cols: []Column          // the columns of the result set being read
    inRows: bool            // inside the first result set: nextRow gives its rows
    starts: []int           // the current row's values: data[starts[i]..starts[i] + lens[i]]
    lens: []int             // -1: NULL
    attnDone: bool          // the DONE acknowledging an ATTENTION has been read
}

fn noReader(): RowReader {
    return RowReader{active: false, data: "", pos: 0, eom: false, cols: [], inRows: false, starts: [], lens: [], attnDone: false}
}

const EV_ROW = 1        // a ROW or NBCROW: its values are in starts and lens
const EV_COLS = 2       // a COLMETADATA with columns
const EV_DONE = 3       // a DONE, DONEPROC or DONEINPROC
const EV_END = 4        // the end of the reply
const EV_OTHER = 5      // another token, applied
const EV_SHORT = -1     // the bytes end inside the token
pub const ROW_SHORT = EV_SHORT

// Where a ROW (an NBCROW when nbc) at d[at..] has each value, into starts
// and lens (-1 for NULL; starts and lens hold one per column), and the
// position after it; ROW_SHORT when d ends
// first. E_PROTOCOL for a length its column's type cannot have.
pub fn scanRow(d: &str, at: int, cols: &[]Column, nbc: bool, starts: mut &[]int, lens: mut &[]int): Result[int, Error] {
    let n = len(d)
    let nc = len(cols)
    var p = at
    if nbc {
        p += (nc + 7) / 8
        if p > n { return Ok(EV_SHORT) }
    }
    for i in 0..nc {
        starts[i] = p
        lens[i] = -1
        if nbc && ((int(d[at + i / 8]) >> (i % 8)) & 1) == 1 { continue }
        let f = cols[i].framing
        let size = cols[i].size
        if f == F_FIXED {
            if p + size > n { return Ok(EV_SHORT) }
            starts[i] = p
            lens[i] = size
            p += size
        } else if f == F_BYTE {
            if p + 1 > n { return Ok(EV_SHORT) }
            let k = int(d[p])
            p += 1
            if k > 0 {
                if k > size { return Err(proto(&("a value of column " + cols[i].name + ": " + k.toStr() + " bytes for a size of " + size.toStr()))) }
                if p + k > n { return Ok(EV_SHORT) }
                starts[i] = p
                lens[i] = k
                p += k
            }
        } else if f == F_USHORT {
            if p + 2 > n { return Ok(EV_SHORT) }
            let k = int(d[p]) | (int(d[p + 1]) << 8)
            p += 2
            if k != 0xFFFF {
                if k > size { return Err(proto(&("a value of column " + cols[i].name + ": " + k.toStr() + " bytes for a size of " + size.toStr()))) }
                if p + k > n { return Ok(EV_SHORT) }
                starts[i] = p
                lens[i] = k
                p += k
            }
        } else if f == F_PLP {
            if p + 8 > n { return Ok(EV_SHORT) }
            var total: u64 = 0
            for k in 0..8 { total = total | (u64(d[p + k]) << (8 * k)) }
            p += 8
            if total != PLP_NULL {
                let start = p
                var sum = 0
                while true {
                    if p + 4 > n { return Ok(EV_SHORT) }
                    let k = leOf(d, p, 4)
                    p += 4
                    if k == 0 { break }
                    if p + k > n { return Ok(EV_SHORT) }
                    p += k
                    sum += k
                }
                if total != PLP_NULL - 1 && u64(sum) != total {
                    return Err(proto(&("a value of column " + cols[i].name + ": PLP chunks of " + sum.toStr() + " bytes for a total of " + total.toStr())))
                }
                starts[i] = start
                lens[i] = p - start
            }
        } else if f == F_TEXT {
            if p + 1 > n { return Ok(EV_SHORT) }
            let tp = int(d[p])
            p += 1
            if tp > 0 {
                if p + tp + 12 > n { return Ok(EV_SHORT) }
                p += tp + 8                          // the text pointer and its timestamp
                let k = leOf(d, p, 4)
                p += 4
                if p + k > n { return Ok(EV_SHORT) }
                starts[i] = p
                lens[i] = k
                p += k
            }
        } else if f == F_VARIANT {
            if p + 4 > n { return Ok(EV_SHORT) }
            let k = leOf(d, p, 4)
            p += 4
            if k > 0 {
                if p + k > n { return Ok(EV_SHORT) }
                starts[i] = p
                lens[i] = k
                p += k
            }
        }
    }
    return Ok(p)
}

// Reads the next packet of the reply onto what is left of data (dl as
// Stream.read has).
fn (s: mut &Session) more(dl: int, w: Where): Result[Unit, Error] {
    if s.rr.eom { return Err(proto("the reply ends inside a token")) }
    let p = try s.t.nextPacket(dl, w)
    if p.ptype != PT_REPLY { return Err(proto(&("a reply in a packet of type " + p.ptype.toStr()))) }
    let rest = len(s.rr.data) - s.rr.pos
    if rest + len(p.data) > s.maxReply {
        return Err(sqldialect.dbError(sqldialect.E_LIMIT, &("tds: a token larger than " + s.maxReply.toStr() + " bytes")))
    }
    s.rr.data = if rest == 0 { p.data } else { s.rr.data[s.rr.pos..] + p.data }
    s.rr.pos = 0
    s.rr.eom = p.eom
    return Ok(Unit{})
}

fn knownToken(t: int): bool {
    match t {
        TK_COLMETADATA, TK_ROW, TK_NBCROW, TK_DONE, TK_DONEPROC, TK_DONEINPROC, TK_ERROR, TK_INFO, TK_ENVCHANGE,
        TK_RETURNSTATUS, TK_RETURNVALUE, TK_ORDER, TK_COLINFO, TK_TABNAME, TK_SSPI, TK_SESSIONSTATE, TK_FEDAUTHINFO,
        TK_OFFSET { return true }
        else { return false }
    }
}

// Decodes the token at data[pos..] (EV_*), reading packets as it needs
// them. A token is applied only once it is whole.
fn (s: mut &Session) step(dl: int, w: Where): Result[int, Error] {
    while true {
        if s.rr.pos >= len(s.rr.data) {
            if s.rr.eom { return Ok(EV_END) }
            try s.more(dl, w)
            continue
        }
        let ev = try s.token()
        if ev != EV_SHORT { return Ok(ev) }
        try s.more(dl, w)
    }
    return Ok(EV_END)
}

fn (s: mut &Session) token(): Result[int, Error] {
    let tok = int(s.rr.data[s.rr.pos])
    if !knownToken(tok) {
        if tok == TK_ALTMETADATA || tok == TK_ALTROW { return Err(proto("COMPUTE results (ALTMETADATA, ALTROW) are not supported")) }
        return Err(proto(&("unknown token 0x" + strings.padLeft(&(strings.hex(tok)), 2, '0'))))
    }
    if tok == TK_ROW || tok == TK_NBCROW {
        if len(s.rr.cols) == 0 { return Err(proto("a row before any COLMETADATA")) }
        let end = try scanRow(&s.rr.data, s.rr.pos + 1, &s.rr.cols, tok == TK_NBCROW, mut &s.rr.starts, mut &s.rr.lens)
        if end < 0 { return Ok(EV_SHORT) }
        s.rr.pos = end
        return Ok(EV_ROW)
    }
    var c = Cur{s: s.rr.data, pos: s.rr.pos + 1, end: len(s.rr.data)}
    match s.other(tok, mut &c) {
        Ok(ev) {
            s.rr.pos = c.pos
            return Ok(ev)
        }
        Err(e) {
            if !s.rr.eom { return Ok(EV_SHORT) }    // cut off: decoded again with the next packet
            return Err(e)
        }
    }
}

// A token other than a row, from c; applied to the session only when whole.
fn (s: mut &Session) other(tok: int, c: mut &Cur): Result[int, Error] {
    match tok {
        TK_COLMETADATA {
            let cols = try colMetadata(c)
            if len(cols) == 0 { return Ok(EV_OTHER) }
            s.rr.starts = array(len(cols), 0)
            s.rr.lens = array(len(cols), -1)
            s.rr.cols = cols
            return Ok(EV_COLS)
        }
        TK_DONE, TK_DONEPROC, TK_DONEINPROC {
            let status = try c.u16("DONE")
            try c.skip(10, "DONE")
            if (status & DONE_ATTN) != 0 { s.rr.attnDone = true }
            return Ok(EV_DONE)
        }
        TK_ERROR, TK_INFO {
            let m = try message(c)
            if tok == TK_ERROR { append(mut &s.errors, m) } else { append(mut &s.infos, m) }
        }
        TK_ENVCHANGE {
            let e = try envChange(c)
            try s.apply(&[e])
        }
        TK_RETURNSTATUS { try c.skip(4, "RETURNSTATUS") }
        TK_RETURNVALUE { let v = try returnValue(c) }
        TK_ORDER, TK_COLINFO, TK_TABNAME, TK_SSPI {
            let n = try c.u16("a token's length")
            try c.skip(n, &("token 0x" + strings.hex(tok)))
        }
        TK_SESSIONSTATE, TK_FEDAUTHINFO {
            let n = try c.u32("a token's length")
            try c.skip(n, &("token 0x" + strings.hex(tok)))
        }
        else { try c.skip(4, "OFFSET") }
    }
    return Ok(EV_OTHER)
}

// The session is broken after a failure on the wire; the stream is over.
fn (s: mut &Session) fail(e: Error): Error {
    s.broken = true
    s.rr = noReader()
    return e
}

// A stream's read ended by e. The task's cancellation or deadline loses no
// bytes (the transport's reads resume), so the reply is cancelled
// (settle, within ABORT_MS whatever the task's state) and the session stays
// usable; any other failure breaks it.
fn (s: mut &Session) interrupted(e: Error, w: Where): Error {
    if !recoverable(&e) { return s.fail(e) }
    match s.settle(w) {
        Ok(_) {}
        Err(_) {}                         // broken by settle
    }
    return e
}

// Sends a request whose reply is read a row at a time, and reads it up to
// its first result set with columns: Ok(true), its columns streamColumns()
// and its rows nextRow(); Ok(false) when the reply ended without one. The
// reply's first ERROR before the result set is the Err (the rest of the
// reply is read first). A stream left unfinished is ended (ATTENTION) by
// the next request, or settle.
fn (s: mut &Session) startStream(ptype: int, payload: &str, w: Where): Result[bool, Error] {
    s.rr = noReader()
    s.rr.active = true
    s.infos = []
    s.errors = []
    match s.sendRequest(ptype, payload, w) {
        Ok(_) {}
        Err(e) { return Err(s.fail(e)) }
    }
    while true {
        let ev = match s.step(-1, w) {
            Ok(x) { x }
            Err(e) { return Err(s.interrupted(e, w)) }
        }
        if ev == EV_COLS {
            if len(s.errors) > 0 {
                let first = serverError(&s.errors[0])
                try s.settle(w)
                return Err(first)
            }
            s.rr.inRows = true
            return Ok(true)
        }
        if ev == EV_END {
            s.rr.active = false
            if len(s.errors) > 0 { return Err(serverError(&s.errors[0])) }
            return Ok(false)
        }
    }
    return Ok(false)
}

// batch and executeSql with the reply read a row at a time (startStream).
pub fn (s: mut &Session) streamBatch(sql: &str, w: Where): Result[bool, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    try s.settle(w)
    let payload = try sqlBatch(sql, &s.txn)
    return s.startStream(PT_SQLBATCH, &payload, w)
}

pub fn (s: mut &Session) streamExecuteSql(sql: &str, params: &[Param], w: Where): Result[bool, Error] {
    if s.broken { return Err(ioErr("the connection is broken by an earlier error")) }
    try s.settle(w)
    let payload = try executeSql(sql, params, &s.txn, &s.collation)
    return s.startStream(PT_RPC, &payload, w)
}

// Whether a streamed reply is still being read.
pub fn (s: &Session) streaming(): bool { return s.rr.active }

// The columns of the streamed result set.
pub fn (s: &Session) streamColumns(): &[]Column { return &s.rr.cols }

// The current row of the stream (after nextRow gave true): value i is
// rowData()[rowStarts()[i]..] for rowLens()[i] bytes, length -1 for NULL.
pub fn (s: &Session) rowData(): &str { return &s.rr.data }
pub fn (s: &Session) rowStarts(): &[]int { return &s.rr.starts }
pub fn (s: &Session) rowLens(): &[]int { return &s.rr.lens }

// Moves to the next row of the first result set: true, or false at its end,
// when the rest of the reply has been read (later result sets are read and
// skipped; their ERRORs are kept in errors with the first's).
pub fn (s: mut &Session) nextRow(w: Where): Result[bool, Error] {
    if !s.rr.inRows { return Ok(false) }
    while true {
        let ev = match s.step(-1, w) {
            Ok(x) { x }
            Err(e) { return Err(s.interrupted(e, w)) }
        }
        if ev == EV_ROW { return Ok(true) }
        if ev == EV_DONE || ev == EV_COLS || ev == EV_END {
            s.rr.inRows = false
            while ev != EV_END {
                let e2 = match s.step(-1, w) {
                    Ok(x) { x }
                    Err(e) { return Err(s.interrupted(e, w)) }
                }
                if e2 == EV_END { break }
            }
            s.rr.active = false
            s.rr.data = ""
            s.rr.pos = 0
            return Ok(false)
        }
    }
    return Ok(false)
}

// Ends a reply that is still being read (a stream, or a request whose task
// was cancelled or passed its deadline): sends ATTENTION and reads up to the
// DONE that acknowledges it, so the connection is idle again. Its rows and
// messages are dropped; its ENVCHANGEs are applied. The I/O ignores the
// task's cancellation and deadline and takes ABORT_MS at most (E_TIMEOUT
// after, and the session is broken), so a cancelled task can end its own
// reply. Nothing to do when no reply is open.
pub fn (s: mut &Session) settle(w: Where): Result[Unit, Error] {
    if !s.rr.active { return Ok(Unit{}) }
    s.rr.inRows = false
    if s.broken || (s.rr.eom && s.rr.pos >= len(s.rr.data)) {
        s.rr = noReader()
        return Ok(Unit{})
    }
    let dl = time.monotonicNs() + ABORT_MS * 1000000
    s.rr.attnDone = false
    match s.t.sendWith(PT_ATTENTION, "", 0, dl, w) {
        Ok(_) {}
        Err(e) { return Err(s.fail(e)) }
    }
    while true {
        let ev = match s.step(dl, w) {
            Ok(x) { x }
            Err(e) { return Err(s.fail(e)) }
        }
        if ev == EV_END {
            if s.rr.attnDone { break }
            s.rr.eom = false             // the acknowledgement comes in a message of its own
        }
    }
    s.rr = noReader()
    s.errors = []
    return Ok(Unit{})
}

// ---------------------------------------------------------------- streamed values (sqlrows)

// A column for sqlrows: wire is the TDS type, aux its framing and (for text
// types) its code page << 4 (65001: a UTF-8 collation).
pub fn describe(cols: &[]Column): []sqlrows.Column {
    var out: []sqlrows.Column = []
    for c in cols {
        let t = c.tdsType
        let textual = t == T_BIGVARCHR || t == T_BIGCHAR || t == T_TEXT || t == T_VARCHAR || t == T_CHAR
        let cp = if textual { c.collation.codePage() } else { 0 }
        let nullable = if (c.flags & 1) != 0 { sqlrows.NULLABLE_YES } else { sqlrows.NULLABLE_NO }
        append(mut &out, sqlrows.column(&c.name, &(typeText(&c)), kindsOf(&c), nullable, t, c.size, c.precision, c.scale,
                                        c.framing | (cp << 4)))
    }
    return out
}

// "decimal(12,2)", "nvarchar", "datetime2(7)", ...
fn typeText(c: &Column): str {
    let t = c.tdsType
    if t == T_DECIMAL || t == T_DECIMALN || t == T_NUMERIC || t == T_NUMERICN {
        return c.typeName() + "(" + c.precision.toStr() + "," + c.scale.toStr() + ")"
    }
    if t == T_TIMEN || t == T_DATETIME2N || t == T_DATETIMEOFFSETN { return c.typeName() + "(" + c.scale.toStr() + ")" }
    return c.typeName()
}

// What a column can be read as (design/db-streaming.md, section 3).
fn kindsOf(c: &Column): int {
    let t = c.tdsType
    match t {
        T_INT1, T_INT2, T_INT4, T_INT8, T_INTN { return sqlrows.kinds(&[sqlrows.Kind.Int, sqlrows.Kind.Decimal]) }
        T_BIT, T_BITN { return sqlrows.kinds(&[sqlrows.Kind.Bool, sqlrows.Kind.Int]) }
        T_FLT4, T_FLT8, T_FLTN { return sqlrows.kinds(&[sqlrows.Kind.Float]) }
        T_DECIMAL, T_DECIMALN, T_NUMERIC, T_NUMERICN {
            if c.scale == 0 && c.precision <= 18 { return sqlrows.kinds(&[sqlrows.Kind.Decimal, sqlrows.Kind.Int]) }
            return sqlrows.kinds(&[sqlrows.Kind.Decimal])
        }
        T_MONEY, T_MONEY4, T_MONEYN { return sqlrows.kinds(&[sqlrows.Kind.Decimal]) }
        T_NVARCHAR, T_NCHAR, T_NTEXT, T_BIGVARCHR, T_BIGCHAR, T_TEXT, T_VARCHAR, T_CHAR, T_XML, T_GUID {
            return sqlrows.kinds(&[sqlrows.Kind.Text])
        }
        T_BIGVARBIN, T_BIGBINARY, T_IMAGE, T_VARBINARY, T_BINARY { return sqlrows.kinds(&[sqlrows.Kind.Bytes]) }
        T_DATEN { return sqlrows.kinds(&[sqlrows.Kind.Date]) }
        T_TIMEN { return sqlrows.kinds(&[sqlrows.Kind.Time]) }
        T_DATETIME2N, T_DATETIME, T_DATETIM4, T_DATETIMN { return sqlrows.kinds(&[sqlrows.Kind.DateTime]) }
        T_DATETIMEOFFSETN { return sqlrows.kinds(&[sqlrows.Kind.OffsetDateTime]) }
        else { return 0 }
    }
}

// A value's bytes: PLP chunks joined, others as they are.
fn plain(b: &str, col: &sqlrows.Column): str {
    if (col.aux & 15) != F_PLP { return b }
    var out = newStrBuf()
    var p = 0
    while p + 4 <= len(b) {
        let k = leOf(b, p, 4)
        p += 4
        if k == 0 { break }
        out.add(b[p..p + k])
        p += k
    }
    return out.toStr()
}

fn failure(c: &Cell): Error {
    match c {
        Cell.Failed(why) { return sqldialect.dbError(sqldialect.E_TYPE, why) }
        else { return sqldialect.dbError(sqldialect.E_TYPE, "an unexpected value") }
    }
}

fn typeErr(msg: &str): Error { return sqldialect.dbError(sqldialect.E_TYPE, msg) }

fn sInt(b: &str, col: &sqlrows.Column): Result[int, Error] {
    let t = col.wire
    let n = len(b)
    match t {
        T_INT1, T_INT2, T_INT4, T_INT8, T_INTN, T_BIT, T_BITN {
            if n != 1 && n != 2 && n != 4 && n != 8 { return Err(typeErr(&("an integer of " + n.toStr() + " bytes"))) }
            var v = 0
            for k in 0..n { v = v | (int(b[k]) << (8 * k)) }
            if t == T_BIT || t == T_BITN { return Ok(if v != 0 { 1 } else { 0 }) }
            if n > 1 && n < 8 && ((v >> (8 * n - 1)) & 1) == 1 { v = v - (1 << (8 * n)) }
            return Ok(v)
        }
        T_DECIMAL, T_DECIMALN, T_NUMERIC, T_NUMERICN {
            if col.scale != 0 { return Err(sqlrows.wrongKind(col, "int")) }
            let c = decimalCell(b, 0)
            match c {
                Cell.Dec(d) {
                    match d.toInt(Rounding.UNNECESSARY) {
                        Ok(v) { return Ok(v) }
                        Err(_) { return Err(typeErr(&(d.toStr() + " does not fit an int"))) }
                    }
                }
                else { return Err(failure(&c)) }
            }
        }
        else { return Err(sqlrows.wrongKind(col, "int")) }
    }
}

fn sDecimal(b: &str, col: &sqlrows.Column): Result[Decimal, Error] {
    let t = col.wire
    match t {
        T_DECIMAL, T_DECIMALN, T_NUMERIC, T_NUMERICN, T_MONEY, T_MONEY4, T_MONEYN {
            let c = if t == T_MONEY || t == T_MONEY4 || t == T_MONEYN { moneyCell(b) } else { decimalCell(b, col.scale) }
            match c {
                Cell.Dec(d) { return Ok(d) }
                else { return Err(failure(&c)) }
            }
        }
        T_INT1, T_INT2, T_INT4, T_INT8, T_INTN { return Ok(decimalOf(try sInt(b, col))) }
        T_FLT4, T_FLT8, T_FLTN { return Err(sqldialect.dbError(sqldialect.E_INEXACT, "a binary float is not exact as a decimal")) }
        else { return Err(sqlrows.wrongKind(col, "Decimal")) }
    }
}

fn sFloat(b: &str, col: &sqlrows.Column): Result[float, Error] {
    let t = col.wire
    if t != T_FLT4 && t != T_FLT8 && t != T_FLTN { return Err(sqlrows.wrongKind(col, "float")) }
    if len(b) == 4 { return Ok(floatOfBits32(leOf(b, 0, 4))) }
    if len(b) != 8 { return Err(typeErr(&("a float of " + len(b).toStr() + " bytes"))) }
    var v = 0
    for k in 0..8 { v = v | (int(b[k]) << (8 * k)) }
    return Ok(floatOfBits(v))
}

fn utf16Text(b: &str): Result[str, Error] {
    match utf16Of(b) {
        Ok(s) { return Ok(s) }
        Err(e) { return Err(typeErr(&e)) }
    }
}

fn sText(b: &str, col: &sqlrows.Column): Result[str, Error] {
    let t = col.wire
    match t {
        T_NVARCHAR, T_NCHAR, T_NTEXT {
            if (col.aux & 15) != F_PLP { return utf16Text(b) }
            return utf16Text(&plain(b, col))
        }
        T_BIGVARCHR, T_BIGCHAR, T_TEXT, T_VARCHAR, T_CHAR {
            let cp = col.aux >> 4
            let v = plain(b, col)
            if cp != 65001 {
                if !codepage.supported(cp) {
                    return Err(typeErr(&("varchar data in code page " + cp.toStr() +
                                       ": only UTF-8 collations, code page 1252 and ISO-8859-1 are supported yet")))
                }
                match codepage.decode(cp, &v) {
                    Ok(s) { return Ok(s) }
                    Err(e) { return Err(typeErr(&e)) }
                }
            }
            if !strings.isValidUtf8(&v) { return Err(typeErr("invalid UTF-8 in a UTF-8 collation")) }
            return Ok(v)
        }
        T_GUID {
            if len(b) != 16 { return Err(typeErr(&("a uniqueidentifier of " + len(b).toStr() + " bytes"))) }
            return Ok(guidOf(b))
        }
        T_XML {
            let v = plain(b, col)
            return utf16Text(if len(v) >= 2 && v[0] == 0xFF && v[1] == 0xFE { &v[2..] } else { &v })
        }
        else { return Err(sqlrows.wrongKind(col, "text")) }
    }
}

fn sBytes(b: &str, col: &sqlrows.Column): Result[str, Error] {
    let t = col.wire
    if t != T_BIGVARBIN && t != T_BIGBINARY && t != T_IMAGE && t != T_VARBINARY && t != T_BINARY {
        return Err(sqlrows.wrongKind(col, "bytes"))
    }
    return Ok(plain(b, col))
}

fn sBool(b: &str, col: &sqlrows.Column): Result[bool, Error] {
    if col.wire != T_BIT && col.wire != T_BITN { return Err(sqlrows.wrongKind(col, "bool")) }
    if len(b) != 1 { return Err(typeErr(&("a bit of " + len(b).toStr() + " bytes"))) }
    return Ok(b[0] != 0)
}

fn sDate(b: &str, col: &sqlrows.Column): Result[time.Date, Error] {
    if col.wire != T_DATEN { return Err(sqlrows.wrongKind(col, "date")) }
    if len(b) != 3 { return Err(typeErr(&("a date of " + len(b).toStr() + " bytes"))) }
    match dateOf3(b, 0) {
        Some(d) { return Ok(d) }
        None { return Err(typeErr("a date out of range")) }
    }
}

fn sTime(b: &str, col: &sqlrows.Column): Result[time.TimeOfDay, Error] {
    if col.wire != T_TIMEN { return Err(sqlrows.wrongKind(col, "time")) }
    let c = timeCell(T_TIMEN, b, col.scale)
    match c {
        Cell.Time(t) { return Ok(t) }
        else { return Err(failure(&c)) }
    }
}

fn sDateTime(b: &str, col: &sqlrows.Column): Result[time.LocalDateTime, Error] {
    let t = col.wire
    if t != T_DATETIME2N && t != T_DATETIME && t != T_DATETIM4 && t != T_DATETIMN { return Err(sqlrows.wrongKind(col, "date-time")) }
    let c = if t == T_DATETIME2N { timeCell(t, b, col.scale) } else { datetimeCell(b) }
    match c {
        Cell.DateTime(l) { return Ok(l) }
        else { return Err(failure(&c)) }
    }
}

fn sOffset(b: &str, col: &sqlrows.Column): Result[time.OffsetDateTime, Error] {
    if col.wire != T_DATETIMEOFFSETN { return Err(sqlrows.wrongKind(col, "date-time with offset")) }
    let c = timeCell(T_DATETIMEOFFSETN, b, col.scale)
    match c {
        Cell.Offset(o) { return Ok(o) }
        else { return Err(failure(&c)) }
    }
}

// How sqlrows.RowView decodes TDS values.
pub fn codec(): sqlrows.Codec {
    return sqlrows.Codec{int: sInt, decimal: sDecimal, float: sFloat, text: sText, bytes: sBytes, bool: sBool, date: sDate,
                         time: sTime, dateTime: sDateTime, offsetDateTime: sOffset}
}
