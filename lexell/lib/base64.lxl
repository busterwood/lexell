// base64: the standard alphabet of RFC 4648 section 4. `str` values hold
// bytes, as in `crypto` and the wire codecs; nothing here checks UTF-8.
//
// Two decoders, because the callers differ: `decodeStrict` is the padded,
// whole-groups-of-four decoder (crypto.unbase64, pgwire), and `decodeLenient`
// is jq 1.7.1's `@base64d` (`=` ends the data, unpadded input is accepted).

const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

type VB = vector[byte]

// Exact 2-table vpshufb validation + high-nibble offset LUTs for RFC 4648 base64 decode.
const B64_HI_LUT = "\x00\x00\x03\x04\x08\x10\x08\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x03\x04\x08\x10\x08\x10\x00\x00\x00\x00\x00\x00\x00\x00"
const B64_LO_LUT = "\x14\x1c\x1c\x1c\x1c\x1c\x1c\x1c\x1c\x1c\x18\x0a\x08\x08\x08\x09\x14\x1c\x1c\x1c\x1c\x1c\x1c\x1c\x1c\x1c\x18\x0a\x08\x08\x08\x09"
const B64_OFF_LUT = "\x00\x00\x10\x04\xbf\xbf\xb9\xb9\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x10\x04\xbf\xbf\xb9\xb9\x00\x00\x00\x00\x00\x00\x00\x00"

// Base64 of data: the standard alphabet, padded with "=".
pub fn encode(data: &str): str {
    let n = len(data)
    if n == 0 { return "" }
    let outLen = ((n + 2) / 3) * 4
    var out: []byte = array(outLen, byte(0))
    var i = 0
    var o = 0
    if n >= 24 {
        let v26 = VB.splat(byte(26))
        let v52 = VB.splat(byte(52))
        let v62 = VB.splat(byte(62))
        let v63 = VB.splat(byte(63))
        let v65 = VB.splat(byte(65))
        let v71 = VB.splat(byte(71))
        let v252 = VB.splat(byte(252))
        let vPlus = VB.splat('+')
        let vSlash = VB.splat('/')
        while i + 24 <= n {
            var k = 0
            while k < 24 {
                let b0 = int(data[i + k])
                let b1 = int(data[i + k + 1])
                let b2 = int(data[i + k + 2])
                out[o] = byte(b0 >> 2)
                out[o + 1] = byte(((b0 & 3) << 4) | (b1 >> 4))
                out[o + 2] = byte(((b1 & 15) << 2) | (b2 >> 6))
                out[o + 3] = byte(b2 & 63)
                o += 4
                k += 3
            }
            let base = o - 32
            let v = VB.load(&out, base)
            let mLo = v >= v26
            let mDg = v >= v52
            let m62 = v == v62
            let m63 = v == v63
            var d = mLo.select(v71, v65)
            d = mDg.select(v252, d)
            var res = v +% d
            res = m62.select(vPlus, res)
            res = m63.select(vSlash, res)
            res.store(mut &out, base)
            i += 24
        }
    }
    while i + 3 <= n {
        let v = (int(data[i]) << 16) | (int(data[i + 1]) << 8) | int(data[i + 2])
        out[o] = ALPHABET[(v >> 18) & 63]
        out[o + 1] = ALPHABET[(v >> 12) & 63]
        out[o + 2] = ALPHABET[(v >> 6) & 63]
        out[o + 3] = ALPHABET[v & 63]
        i += 3
        o += 4
    }
    let rest = n - i
    if rest == 1 {
        let v = int(data[i]) << 16
        out[o] = ALPHABET[(v >> 18) & 63]
        out[o + 1] = ALPHABET[(v >> 12) & 63]
        out[o + 2] = '='
        out[o + 3] = '='
    } else if rest == 2 {
        let v = (int(data[i]) << 16) | (int(data[i + 1]) << 8)
        out[o] = ALPHABET[(v >> 18) & 63]
        out[o + 1] = ALPHABET[(v >> 12) & 63]
        out[o + 2] = ALPHABET[(v >> 6) & 63]
        out[o + 3] = '='
    }
    return strFromBytes(&out)
}

fn value(c: byte): int {
    if c >= 'A' && c <= 'Z' { return int(c - 'A') }
    if c >= 'a' && c <= 'z' { return int(c - 'a') + 26 }
    if c >= '0' && c <= '9' { return int(c - '0') + 52 }
    if c == '+' { return 62 }
    if c == '/' { return 63 }
    return -1
}

// The bytes of standard base64 text; None unless it is whole groups of four
// characters, with "=" only as the last one or two (padding is required), no
// white space and no other character. The unused bits of the last character
// are not checked (as libpq's decoder).
pub fn decodeStrict(text: &str): Option[str] {
    let n = len(text)
    if n == 0 { return Some("") }
    if n % 4 != 0 { return None }
    let padEnd = if text[n - 1] == '=' { if text[n - 2] == '=' { 2 } else { 1 } } else { 0 }
    var out: []byte = array((n / 4) * 3 - padEnd, byte(0))
    var i = 0
    var o = 0
    let simdLim = n - 4
    if simdLim >= 32 {
        let v0f = VB.splat(byte(0x0f))
        let vZero = VB.zero()
        let vHiLut = VB.load(&B64_HI_LUT, 0)
        let vLoLut = VB.load(&B64_LO_LUT, 0)
        let vOffLut = VB.load(&B64_OFF_LUT, 0)
        let vPlus = VB.splat('+')
        let vOffPl = VB.splat(byte(19))
        var tmp: []byte = array(32, byte(0))
        while i + 32 <= simdLim {
            let v = VB.load(text, i)
            let hi = v >> 4
            let valid = vLoLut.shuffle(v & v0f) & vHiLut.shuffle(hi)
            if (valid == vZero).any() { return None }
            let delta = (v == vPlus).select(vOffPl, vOffLut.shuffle(hi))
            (v +% delta).store(mut &tmp, 0)
            var k = 0
            while k < 32 {
                let d0 = int(tmp[k])
                let d1 = int(tmp[k + 1])
                let d2 = int(tmp[k + 2])
                let d3 = int(tmp[k + 3])
                out[o] = byte((d0 << 2) | (d1 >> 4))
                out[o + 1] = byte(((d1 & 15) << 4) | (d2 >> 2))
                out[o + 2] = byte(((d2 & 3) << 6) | d3)
                o += 3
                k += 4
            }
            i += 32
        }
    }
    while i < n {
        let last = i + 4 == n
        var pad = 0
        var v = 0
        for k in 0..4 {
            let c = text[i + k]
            if c == '=' {
                if !last || k < 2 { return None }
                pad += 1
                v = v << 6
            } else {
                if pad > 0 { return None }
                let d = value(c)
                if d < 0 { return None }
                v = (v << 6) | d
            }
        }
        out[o] = byte((v >> 16) & 255)
        o += 1
        if pad < 2 { out[o] = byte((v >> 8) & 255); o += 1 }
        if pad < 1 { out[o] = byte(v & 255); o += 1 }
        i += 4
    }
    return Some(strFromBytes(&out))
}

// jq 1.7.1's @base64d: invalid characters are an error, "=" ends the data,
// unpadded input is accepted, and a single leftover character is "trailing
// base64 byte found". The error text is jq's message fragment, without the
// value it qualifies. Output bytes are not checked for UTF-8; a caller that
// needs text validates them (jq's `json.validUtf8`).
pub fn decodeLenient(s: &str): Result[str, str] {
    let n = len(s)
    if n == 0 { return Ok("") }
    var out: []byte = array((n / 4) * 3 + 3, byte(0))
    var i = 0
    var o = 0
    if n >= 32 {
        let v0f = VB.splat(byte(0x0f))
        let vZero = VB.zero()
        let vHiLut = VB.load(&B64_HI_LUT, 0)
        let vLoLut = VB.load(&B64_LO_LUT, 0)
        let vOffLut = VB.load(&B64_OFF_LUT, 0)
        let vPlus = VB.splat('+')
        let vOffPl = VB.splat(byte(19))
        var tmp: []byte = array(32, byte(0))
        while i + 32 <= n {
            let v = VB.load(s, i)
            let hi = v >> 4
            let valid = vLoLut.shuffle(v & v0f) & vHiLut.shuffle(hi)
            if (valid == vZero).any() { break }
            let delta = (v == vPlus).select(vOffPl, vOffLut.shuffle(hi))
            (v +% delta).store(mut &tmp, 0)
            var k = 0
            while k < 32 {
                let d0 = int(tmp[k])
                let d1 = int(tmp[k + 1])
                let d2 = int(tmp[k + 2])
                let d3 = int(tmp[k + 3])
                out[o] = byte((d0 << 2) | (d1 >> 4))
                out[o + 1] = byte(((d1 & 15) << 4) | (d2 >> 2))
                out[o + 2] = byte(((d2 & 3) << 6) | d3)
                o += 3
                k += 4
            }
            i += 32
        }
    }
    var acc = 0
    var bits = 0
    var seen = i
    while i < n {
        let c = s[i]
        if c == '=' { break }
        let v = value(c)
        if v < 0 { return Err("is not valid base64 data") }
        acc = ((acc << 6) | v) & 0xFFFF
        bits += 6
        seen += 1
        if bits >= 8 {
            bits -= 8
            out[o] = byte((acc >> bits) & 255)
            o += 1
        }
        i += 1
    }
    if seen % 4 == 1 { return Err("trailing base64 byte found") }
    return Ok(strFromBytes(&out[0..o]))
}
