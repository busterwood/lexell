// base64: the standard alphabet of RFC 4648 section 4. `str` values hold
// bytes, as in `crypto` and the wire codecs; nothing here checks UTF-8.
//
// Two decoders, because the callers differ: `decodeStrict` is the padded,
// whole-groups-of-four decoder (crypto.unbase64, pgwire), and `decodeLenient`
// is jq 1.7.1's `@base64d` (`=` ends the data, unpadded input is accepted).

const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// Base64 of data: the standard alphabet, padded with "=".
pub fn encode(data: &str): str {
    var b = newStrBuf()
    var i = 0
    while i + 3 <= len(data) {
        let v = (int(data[i]) << 16) | (int(data[i + 1]) << 8) | int(data[i + 2])
        b.addByte(ALPHABET[(v >> 18) & 63])
        b.addByte(ALPHABET[(v >> 12) & 63])
        b.addByte(ALPHABET[(v >> 6) & 63])
        b.addByte(ALPHABET[v & 63])
        i += 3
    }
    let rest = len(data) - i
    if rest == 1 {
        let v = int(data[i]) << 16
        b.addByte(ALPHABET[(v >> 18) & 63])
        b.addByte(ALPHABET[(v >> 12) & 63])
        b.addByte('=')
        b.addByte('=')
    } else if rest == 2 {
        let v = (int(data[i]) << 16) | (int(data[i + 1]) << 8)
        b.addByte(ALPHABET[(v >> 18) & 63])
        b.addByte(ALPHABET[(v >> 12) & 63])
        b.addByte(ALPHABET[(v >> 6) & 63])
        b.addByte('=')
    }
    return b.toStr()
}

fn value(c: byte): int {
    if c >= 'A' && c <= 'Z' { return int(c - 'A') }
    if c >= 'a' && c <= 'z' { return int(c - 'a') + 26 }
    if c >= '0' && c <= '9' { return int(c - '0') + 52 }
    if c == '+' { return 62 }
    if c == '/' { return 63 }
    return -1
}

// The bytes of standard base64 text; None unless it is whole groups of four
// characters, with "=" only as the last one or two (padding is required), no
// white space and no other character. The unused bits of the last character
// are not checked (as libpq's decoder).
pub fn decodeStrict(text: &str): Option[str] {
    let n = len(text)
    if n % 4 != 0 { return None }
    var out: []byte = []
    var i = 0
    while i < n {
        let last = i + 4 == n
        var pad = 0
        var v = 0
        for k in 0..4 {
            let c = text[i + k]
            if c == '=' {
                if !last || k < 2 { return None }
                pad += 1
                v = v << 6
            } else {
                if pad > 0 { return None }
                let d = value(c)
                if d < 0 { return None }
                v = (v << 6) | d
            }
        }
        append(mut &out, byte((v >> 16) & 255))
        if pad < 2 { append(mut &out, byte((v >> 8) & 255)) }
        if pad < 1 { append(mut &out, byte(v & 255)) }
        i += 4
    }
    return Some(strFromBytes(&out))
}

// jq 1.7.1's @base64d: invalid characters are an error, "=" ends the data,
// unpadded input is accepted, and a single leftover character is "trailing
// base64 byte found". The error text is jq's message fragment, without the
// value it qualifies. Output bytes are not checked for UTF-8; a caller that
// needs text validates them (jq's `json.validUtf8`).
pub fn decodeLenient(s: &str): Result[str, str] {
    var out: []byte = []
    var acc = 0
    var bits = 0
    var n = 0
    for i in 0..len(s) {
        let c = s[i]
        if c == '=' { break }
        let v = value(c)
        if v < 0 { return Err("is not valid base64 data") }
        acc = ((acc << 6) | v) & 0xFFFF
        bits += 6
        n += 1
        if bits >= 8 {
            bits -= 8
            append(mut &out, byte((acc >> bits) & 255))
        }
    }
    if n % 4 == 1 { return Err("trailing base64 byte found") }
    return Ok(strFromBytes(&out))
}
