// design/experiments/heap_trim: whole-chunk retire and reuse (runtime-memory.md 8).
// Build with the compiler on this branch.

extern "c" fn a(n: int): ptr as "lxllib_alloc"
extern "c" fn f(p: ptr) as "lxllib_free"
extern "c" fn heapstat() as "lxllib_heapstat"
extern "c" fn heaptrim(): int as "lxllib_heaptrim"
extern "c" fn usleep(us: u32): i32

fn main() {
    var ps: []ptr = []
    var i = 0
    while i < 1000000 { append(mut &ps, a(16)); i = i + 1 }
    for p in ps { f(p) }
    ps = []
    println("-- after free")
    heapstat()
    var n = 1
    while n > 0 { n = heaptrim() }
    println("-- after trim")
    heapstat()
    var qs: []ptr = []
    i = 0
    while i < 1000000 { append(mut &qs, a(16)); i = i + 1 }
    for p in qs { f(p) }
    qs = []
    println("-- after refill and free")
    heapstat()
    usleep(3000000)
}
