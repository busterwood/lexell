// design/experiments/heap_trim: the batches probe (runtime-memory.md 7).
// Build with the instrumented lxlc from heap-trim.patch.

extern "c" fn a(n: int): ptr as "lxllib_alloc"
extern "c" fn f(p: ptr) as "lxllib_free"
extern "c" fn heapstat() as "lxllib_heapstat"

fn main() {
    var live: []ptr = []
    var tmp: []ptr = []
    var round = 0
    while round < 20 {
        var i = 0
        while i < 50000 {
            append(mut &tmp, a(16))
            i = i + 1
        }
        var j = 0
        while j < 1000 {
            append(mut &live, a(8 + (j % 16) * 16))
            j = j + 1
        }
        round = round + 1
    }
    for p in tmp { f(p) }
    tmp = []
    heapstat()
    if len(live) < 0 { println("x") }
}
