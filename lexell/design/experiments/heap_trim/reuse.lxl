// design/experiments/heap_trim: the reuse probe (runtime-memory.md 7).
// Build with the instrumented lxlc from heap-trim.patch.

extern "c" fn a(n: int): ptr as "lxllib_alloc"
extern "c" fn f(p: ptr) as "lxllib_free"
extern "c" fn heapstat() as "lxllib_heapstat"
extern "c" fn heaptrim() as "lxllib_heaptrim"
extern "c" fn usleep(us: u32): i32

fn fill(): []ptr {
    var ps: []ptr = []
    var i = 0
    while i < 1000000 {
        append(mut &ps, a(16))
        i = i + 1
    }
    return ps
}

fn main() {
    var ps = fill()
    for p in ps { f(p) }
    ps = []
    println("-- after free")
    heapstat()
    heaptrim()
    println("-- after trim")
    heapstat()
    var qs = fill()
    for p in qs { f(p) }
    qs = []
    println("-- after reuse and free")
    heapstat()
    usleep(1000000)
}
