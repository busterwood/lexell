// design/experiments/heap_trim: the live_before probe (runtime-memory.md 7).
// Build with the instrumented lxlc from heap-trim.patch.

extern "c" fn a(n: int): ptr as "lxllib_alloc"
extern "c" fn f(p: ptr) as "lxllib_free"
extern "c" fn heapstat() as "lxllib_heapstat"

fn main() {
    var live: []ptr = []
    var i = 0
    while i < 20000 {
        append(mut &live, a(8 + (i % 16) * 16))
        i = i + 1
    }
    var tmp: []ptr = []
    i = 0
    while i < 800000 {
        append(mut &tmp, a(16))
        i = i + 1
    }
    for p in tmp { f(p) }
    tmp = []
    heapstat()
    if len(live) < 0 { println("x") }
}
