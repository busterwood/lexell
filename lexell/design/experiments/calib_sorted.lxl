// An index range read in key order (lexdb-optimizer.md section 47) against
// the same range in the index's order and against a scan: per row, in
// nanoseconds and in units of a scanned row, on settled tables (loaded,
// VACUUMed, ANALYZEd and checkpointed in a first store run, measured in a
// second, as section 45's programs), the median of 5.
//   scan     the table scanned whole, its rows filtered (k + 0 < x: no
//            index serves it): per row of the table, the unit
//   plain    the index t_k's range, its rows read in the index's order (a
//            batch's 1,024 keys sorted: 9.107), per row of the range
//   sorted   the same range, its keys sorted whole, its rows read in key
//            order (section 47), per row of the range
// t.k is a permutation of t.id, so a range's rows are scattered over t.
// Two tables: wide (about TPC-H orders' width) and narrow (three integers).
import "../../cmd/lexdb_store"
import "../../cmd/lexdb_disk"
import "../../cmd/lexdb_exec"
import "../../cmd/lexdb_plan"
import "../../cmd/lexdb_sql"
import "time"

const N = 1000000

fn exec(s: mut &lexdb_exec.Session, sql: &str) {
    match s.exec(sql) {
        Ok(_) {}
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

fn med(s: mut &lexdb_exec.Session, sql: &str): int {
    exec(s, sql)
    var ts: []int = []
    for i in 0..5 {
        let t0 = time.monotonicNs()
        exec(s, sql)
        append(mut &ts, time.monotonicNs() - t0)
    }
    for i in 1..len(ts) {
        var j = i
        while j > 0 && ts[j - 1] > ts[j] {
            let x = ts[j - 1]
            ts[j - 1] = ts[j]
            ts[j] = x
            j -= 1
        }
    }
    return ts[2]
}

fn plan(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(&("explain " + sql)) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var out = ""
            for row in r.rows { out = out + lexdb_sql.text(&row[0]) + "; " }
            return out
        }
        Err(e) { return e.msg }
    }
}

// tenths of a unit
fn units(ns: int, unit: int): str {
    let t = (ns * 10 + unit / 2) / unit
    return (t / 10).toStr() + "." + (t % 10).toStr()
}

fn table(s: mut &lexdb_exec.Session, name: &str) {
    lexdb_plan.setKeyOrder(lexdb_plan.KO_COST)
    let scan = med(s, &("select sum(c) from " + name + " where k + 0 < " + (N / 2).toStr()))
    let unit = scan / N
    println(name + ": scan " + unit.toStr() + " ns a row    plan: " + plan(s, &("select sum(c) from " + name + " where k + 0 < 10")))
    println("  share     rows     plain ns (units)    sorted ns (units)    sorted/plain")
    for per in [1, 5, 10, 20, 50, 100, 200, 500] {
        // per: tenths of a percent of the table
        let n = N / 1000 * per
        let q = "select sum(c) from " + name + " where k < " + n.toStr()
        lexdb_plan.setKeyOrder(lexdb_plan.KO_PLAIN)
        let p = med(s, &q)
        let pp = plan(s, &q)
        lexdb_plan.setKeyOrder(lexdb_plan.KO_SORTED)
        let o = med(s, &q)
        let op = plan(s, &q)
        println("  " + (per / 10).toStr() + "." + (per % 10).toStr() + "%  " + n.toStr() + "    " + (p / n).toStr() + " (" + units(p / n, unit) + ")    " +
                (o / n).toStr() + " (" + units(o / n, unit) + ")    " + units(o * 100, p * 10))
        if per == 50 { println("    plans: " + pp + " | " + op) }
    }
    lexdb_plan.setKeyOrder(lexdb_plan.KO_COST)
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    exec(mut &s, &"set max_statement_mem = 0")
    let n = N.toStr()
    for x in [
        "create table wide (id int primary key, k int, c int, d date, pri text, clerk text, total numeric(12,2), cmt text)",
        "insert into wide select g, (g * 7919) % " + n + ", g % 97, date '1992-01-01' + (g % 2400), '" + "1-URGENT" + "', 'Clerk#' || (g % 1000), (g % 100000) * 1.25, 'a comment about order ' || g || ' of some length'" +
            " from generate_series(1, " + n + ") g",
        "create index wide_k on wide (k)",
        "create table narrow (id int primary key, k int, c int)",
        "insert into narrow select g, (g * 7919) % " + n + ", g % 97 from generate_series(1, " + n + ") g",
        "create index narrow_k on narrow (k)",
        "analyze",
        "vacuum wide", "vacuum narrow",
    ] { exec(mut &s, &x) }
    st.checkpointAll().unwrap()
    return 0
}

fn measure(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st.share())
    exec(mut &s, &"set max_statement_mem = 0")
    table(mut &s, &"wide")
    table(mut &s, &"narrow")
    return 0
}

fn main() {
    let fs = lexdb_disk.sim(5)
    let o = lexdb_store.Options{cacheBytes: 2048 * 1024 * 1024, segBytes: 64 * 1024 * 1024, ckptBytes: 256 * 1024 * 1024, snapNodes: 1000000}
    lexdb_store.run(fs.share(), o, body).unwrap()
    lexdb_store.run(fs, o, measure).unwrap()
}
