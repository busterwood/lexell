// A workload of realistic queries (lexdb-optimizer.md section 34), run under
// the cost planner (after ANALYZE) and the rules planner, in one process:
// per query the median time of 5 runs after a warm-up, both plans, and
// whether both give the same rows. A TPC-H-like schema of about 1.1 million
// rows, in memory (the cache holds it all), so the times are the plans' CPU.
//   lexell/compiler/out/lxlc lexell/design/experiments/workload.lxl -o /tmp/wl && /tmp/wl
import "../../cmd/lexdb_store"
import "../../cmd/lexdb_disk"
import "../../cmd/lexdb_exec"
import "strings"
import "time"

const RUNS: int = 5

fn exec(s: mut &lexdb_exec.Session, sql: &str) {
    match s.exec(sql) {
        Ok(_) {}
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

// The rows of a query as one text (its checksum is compared between modes),
// or the error.
fn rowsText(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(sql) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for row in r.rows {
                var cells: []str = []
                for v in row { append(mut &cells, if lexdb_exec.isNull(&v) { "NULL" } else { lexdb_exec.text(&v) }) }
                append(mut &lines, strings.join(&cells, "|"))
            }
            return len(r.rows).toStr() + " rows: " + strings.join(&lines, ";")
        }
        Err(e) { return "ERROR " + e.state + " " + e.msg }
    }
}

fn plan(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(&("explain " + sql)) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var lines: []str = []
            for row in r.rows { append(mut &lines, lexdb_exec.text(&row[0])) }
            return strings.join(&lines, "; ")
        }
        Err(e) { return "ERROR " + e.msg }
    }
}

// A short checksum of a text (FNV-1a, 32 bits).
fn sum(t: &str): str {
    var h = 2166136261
    for i in 0..len(t) {
        h = (h ^ int(t[i])) * 16777619 % 4294967296
    }
    return h.toStr()
}

// The median of RUNS timed runs, in microseconds.
fn timeIt(s: mut &lexdb_exec.Session, sql: &str): int {
    exec(s, sql)                        // warm
    var ts: []int = []
    for i in 0..RUNS {
        let t0 = time.monotonicNs()
        exec(s, sql)
        append(mut &ts, (time.monotonicNs() - t0) / 1000)
    }
    // insertion sort
    for i in 1..len(ts) {
        var j = i
        while j > 0 && ts[j - 1] > ts[j] {
            let x = ts[j - 1]
            ts[j - 1] = ts[j]
            ts[j] = x
            j -= 1
        }
    }
    return ts[len(ts) / 2]
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    exec(mut &s, &"set max_statement_mem = 0")
    let t0 = time.monotonicNs()
    for x in [
        "create table region (id int primary key, name text)",
        "insert into region select g, 'r' || g from generate_series(0, 4) g",
        "create table nation (id int primary key, region int, name text)",
        "insert into nation select g, g % 5, 'n' || g from generate_series(0, 24) g",
        "create table supplier (id int primary key, nation int, name text)",
        "insert into supplier select g, g % 25, 's' || g from generate_series(1, 1000) g",
        "create index supplier_nation on supplier (nation)",
        "create table customer (id int primary key, nation int, name text, segment text)",
        "insert into customer select g, g % 25, 'c' || g, 'seg' || (g % 5) from generate_series(1, 20000) g",
        "create index customer_nation on customer (nation)",
        "create table part (id int primary key, brand text, type text, size int)",
        "insert into part select g, 'Brand#' || (g % 25), 'type' || (g % 150), g % 50 + 1 from generate_series(1, 20000) g",
        "create index part_brand on part (brand)",
        "create table partsupp (part int, supp int, cost int, primary key (part, supp))",
        "insert into partsupp select (g - 1) / 4 + 1, ((g - 1) * 7) % 1000 + 1, g % 1000 + 1 from generate_series(1, 80000) g",
        "create index partsupp_supp on partsupp (supp)",
        "create table orders (id int primary key, cust int, odate date, status text, total int)",
        "insert into orders select g, (g * 7) % 20000 + 1, date '2020-01-01' + (g % 1460), case when g % 10 = 0 then 'P' when g % 3 = 0 then 'F' else 'O' end, g % 100000 from generate_series(1, 200000) g",
        "create index orders_cust on orders (cust)",
        "create index orders_odate on orders (odate)",
        "create table lineitem (ord int, line int, part int, supp int, qty int, price int, shipdate date, primary key (ord, line))",
        "insert into lineitem select (g - 1) / 4 + 1, (g - 1) % 4 + 1, (g * 13) % 20000 + 1, (g * 7) % 1000 + 1, g % 50 + 1, g % 1000, date '2020-01-01' + ((g / 4) % 1460) + g % 30 from generate_series(1, 800000) g",
        "create index lineitem_part on lineitem (part)",
        "create index lineitem_ship on lineitem (shipdate)",
    ] { exec(mut &s, &x) }
    println("load: " + ((time.monotonicNs() - t0) / 1000000).toStr() + " ms")
    let t1 = time.monotonicNs()
    exec(mut &s, &"analyze")
    println("analyze: " + ((time.monotonicNs() - t1) / 1000000).toStr() + " ms")
    exec(mut &s, &"set statement_timeout = 30000")
    let qs = [
        // OLTP
        "select o.id, o.odate, l.line, p.brand, l.qty from orders o join lineitem l on l.ord = o.id join part p on p.id = l.part where o.id = 12345 order by l.line",
        "select id, odate, total from orders where cust = 777 order by odate desc limit 10",
        "select o.id, l.line, p.type from customer c join orders o on o.cust = c.id join lineitem l on l.ord = o.id join part p on p.id = l.part where c.id = 4242 order by o.id, l.line",
        "select s.name, ps.cost from partsupp ps join supplier s on s.id = ps.supp join nation n on n.id = s.nation where ps.part = 999 order by ps.cost limit 1",
        // FROM written in a poor order
        "select l.line, l.qty from lineitem l join orders o on o.id = l.ord where o.id = 54321 order by l.line",
        "select count(*) from lineitem l join part p on p.id = l.part join orders o on o.id = l.ord where o.cust = 1234",
        // reports
        "select n.name, sum(l.price * l.qty) from lineitem l join orders o on o.id = l.ord join customer c on c.id = o.cust join nation n on n.id = c.nation where o.odate >= date '2021-03-01' and o.odate < date '2021-04-01' group by n.name order by 2 desc",
        "select n.name, sum(l.price) from customer c join orders o on o.cust = c.id join lineitem l on l.ord = o.id join supplier s on s.id = l.supp join nation n on n.id = s.nation join region r on r.id = n.region where r.name = 'r2' and c.nation = s.nation and o.odate >= date '2022-01-01' and o.odate < date '2022-02-01' group by n.name order by 2 desc",
        "select count(*), sum(l.qty) from lineitem l join part p on p.id = l.part where p.brand = 'Brand#13' and l.shipdate >= date '2021-06-01' and l.shipdate < date '2021-07-01'",
        "select c.id, sum(o.total) from customer c join orders o on o.cust = c.id where c.segment = 'seg3' and o.odate >= date '2022-04-01' and o.odate < date '2022-07-01' group by c.id order by 2 desc limit 10",
        "select count(*) from orders o join lineitem l on l.ord = o.id join part p on p.id = l.part where o.status = 'P' and l.qty > 45 and p.size < 5",
        "select count(*) from lineitem l join part p on p.id = l.part join supplier s on s.id = l.supp join orders o on o.id = l.ord join customer c on c.id = o.cust where p.brand = 'Brand#7' and c.segment = 'seg1' and o.odate >= date '2021-01-01' and o.odate < date '2021-02-01'",
        "select count(*) from customer c where c.nation = 3 and exists (select 1 from orders o where o.cust = c.id and o.odate >= date '2023-12-01')",
        "select l.ord, l.line, l.shipdate from lineitem l join part p on p.id = l.part where p.brand = 'Brand#13' order by l.shipdate desc limit 20",
    ]
    var totalCost = 0
    var totalRules = 0
    for i in 0..len(qs) {
        let q = &qs[i]
        exec(mut &s, &"set lexdb_planner = cost")
        let pc = plan(mut &s, q)
        let rc = sum(&rowsText(mut &s, q))
        let tc = timeIt(mut &s, q)
        exec(mut &s, &"set lexdb_planner = rules")
        let pr = plan(mut &s, q)
        let rr = sum(&rowsText(mut &s, q))
        let tr = timeIt(mut &s, q)
        totalCost += tc
        totalRules += tr
        println("Q" + (i + 1).toStr() + ": cost " + tc.toStr() + " us, rules " + tr.toStr() + " us, rows " +
                (if rc == rr { "same" } else { "DIFFER" }))
        println("  sql:   " + q)
        println("  cost:  " + pc)
        println("  rules: " + pr)
    }
    println("total: cost " + totalCost.toStr() + " us, rules " + totalRules.toStr() + " us")
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 2048 * 1024 * 1024, segBytes: 64 * 1024 * 1024, ckptBytes: 256 * 1024 * 1024, snapNodes: 2000000, bufferedPages: false}, body).unwrap()
}
