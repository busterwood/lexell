// The join costs measured again with joins over batches (lexdb.md 9.102,
// lexdb-optimizer.md section 39): per row, in nanoseconds, in memory, with
// batches on and off. calib.lxl (section 36) measured a hash join's build
// and probe together; here they are apart:
//   scan     a full scan's row (sum of a column): the unit
//   probe    a probe per outer row (d2, 200,000 rows, joins s, 1,000 rows
//            hashed on a column with no index: every outer row matches)
//   probetx  the same on a text key (s.lab = d2.lab)
//   miss     the same, no outer row matching (probe without a joined row)
//   build    an inner row read once and hashed (dk, 1,000 rows, LEFT JOIN
//            t, 200,000 rows hashed on a column with no index: a LEFT JOIN
//            keeps its order)
//   pklook   a lookup by the whole primary key, per outer row (d, 20,000
//            rows, joins t by its key; the rules planner takes it)
// Each time is the median of 5.
import "../../cmd/lexdb_store"
import "../../cmd/lexdb_disk"
import "../../cmd/lexdb_exec"
import "time"

fn exec(s: mut &lexdb_exec.Session, sql: &str) {
    match s.exec(sql) {
        Ok(_) {}
        Err(e) { println(sql + " -> " + e.state + " " + e.msg) }
    }
}

fn med(s: mut &lexdb_exec.Session, sql: &str): int {
    exec(s, sql)
    var ts: []int = []
    for i in 0..5 {
        let t0 = time.monotonicNs()
        exec(s, sql)
        append(mut &ts, time.monotonicNs() - t0)
    }
    for i in 1..len(ts) {
        var j = i
        while j > 0 && ts[j - 1] > ts[j] {
            let x = ts[j - 1]
            ts[j - 1] = ts[j]
            ts[j] = x
            j -= 1
        }
    }
    return ts[2]
}

fn plan(s: mut &lexdb_exec.Session, sql: &str): str {
    match s.exec(&("explain " + sql)) {
        Ok(rs) {
            let r = &rs[len(rs) - 1]
            var out = ""
            for row in r.rows { out = out + lexdb_exec.text(&row[0]) + "; " }
            return out
        }
        Err(e) { return e.msg }
    }
}

fn run(s: mut &lexdb_exec.Session, on: bool) {
    exec(s, &(if on { "set lexdb_batch = on" } else { "set lexdb_batch = off" }))
    println(if on { "batches on" } else { "batches off" })
    let scan = med(s, &"select sum(v) from t")
    println("  scan     " + (scan / 200000).toStr() + " ns a row")
    let d2 = med(s, &"select sum(x) from d2")
    let pq = "select sum(s.v) from d2 join s on s.u = d2.x"
    let pr = med(s, &pq)
    println("  probe    " + ((pr - d2) / 200000).toStr() + " ns an outer row (joined)    plan: " + plan(s, &pq))
    let tq = "select sum(s.v) from d2 join s on s.lab = d2.lab"
    let tp = med(s, &tq)
    println("  probetx  " + ((tp - d2) / 200000).toStr() + " ns an outer row, a text key (joined)    plan: " + plan(s, &tq))
    let mq = "select sum(s.v) from d2 join s on s.u = d2.x + 5000"
    let mi = med(s, &mq)
    println("  miss     " + ((mi - d2) / 200000).toStr() + " ns an outer row (none joined)")
    let dk = med(s, &"select sum(x) from dk")
    let bq = "select sum(t.v) from dk left join t on t.u = dk.x"
    let bu = med(s, &bq)
    println("  build    " + ((bu - dk) / 200000).toStr() + " ns an inner row read and hashed    plan: " + plan(s, &bq))
    let d = med(s, &"select sum(x) from d")
    exec(s, &"set lexdb_planner = rules")
    let lq = "select sum(t.v) from d join t on t.id = d.x"
    let lk = med(s, &lq)
    println("  pklook   " + ((lk - d) / 20000).toStr() + " ns an outer row    plan: " + plan(s, &lq))
    exec(s, &"set lexdb_planner = cost")
}

fn body(st: lexdb_store.Store): int {
    lexdb_exec.bootstrap(&st).unwrap()
    var s = lexdb_exec.newSession(st)
    exec(mut &s, &"set max_statement_mem = 0")
    for x in [
        "create table t (id int primary key, u int, k int, v int, pad text)",
        "insert into t select g, 300000 - g, g % 10000, g % 97, 'row ' || g from generate_series(1, 200000) g",
        "create table s (id int primary key, u int, v int, lab text)",
        "insert into s select g, g, g % 97, 'label ' || g from generate_series(1, 1000) g",
        "create table d (id int primary key, x int)",
        "insert into d select g, (g * 37) % 200000 + 1 from generate_series(1, 20000) g",
        "create table dk (id int primary key, x int)",
        "insert into dk select g, 300000 - (g * 37) % 200000 - 1 from generate_series(1, 1000) g",
        "create table d2 (id int primary key, x int, lab text)",
        "insert into d2 select g, g % 1000 + 1, 'label ' || (g % 1000 + 1) from generate_series(1, 200000) g",
        "analyze",
    ] { exec(mut &s, &x) }
    run(mut &s, true)
    run(mut &s, false)
    return 0
}

fn main() {
    lexdb_store.run(lexdb_disk.sim(5), lexdb_store.Options{cacheBytes: 1024 * 1024 * 1024, segBytes: 64 * 1024 * 1024, ckptBytes: 256 * 1024 * 1024, snapNodes: 1000000, bufferedPages: false}, body).unwrap()
}
