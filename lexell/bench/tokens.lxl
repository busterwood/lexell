// A compiler-like workload: tokenise a source file into token records, then
// intern every identifier in a hash table of string buckets. Identifiers are
// views of the source (no copies): the table holds borrows of `data`.
type Token = value record { kind: int; text: &str; line: int }

fn isLetter(c: byte): bool { return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' }
fn isDigit(c: byte): bool { return c >= '0' && c <= '9' }

fn scan(src: &str): []Token {
    var toks: []Token = []
    var i = 0
    var line = 1
    while i < len(src) {
        let c = strByte(src, i)
        if c == '\n' {
            line += 1
            i += 1
        } else if isLetter(c) {
            let start = i
            while i < len(src) && (isLetter(strByte(src, i)) || isDigit(strByte(src, i))) {
                i += 1
            }
            append(mut &toks, Token{kind: 1, text: src[start..i], line: line})
        } else if isDigit(c) {
            while i < len(src) && isDigit(strByte(src, i)) { i += 1 }
            append(mut &toks, Token{kind: 2, text: "", line: line})
        } else if c == ' ' || c == '\t' {
            i += 1
        } else {
            append(mut &toks, Token{kind: 3, text: "", line: line})
            i += 1
        }
    }
    return toks
}

fn hash(s: &str): int {
    var h = 5381
    for i in 0..len(s) { h = (h * 33 + int(strByte(s, i))) & 0xFFFFFF }
    return h
}

fn main() {
    let a = args()
    var data = ""
    if readFile(a[1], mut &data) != 0 { exit(1) }
    var tokens = 0
    var unique = 0
    for round in 0..200 {
        let toks = scan(data)
        // The first store borrows `data`, so the table is rooted before the
        // loop. Bucket 0 holds an empty view that no identifier equals.
        var table: [][]&str = [[data[0..0]]]
        for i in 1..1024 { append(mut &table, []) }
        for t in toks {
            if t.kind == 1 {
                let k = hash(t.text) % len(table)
                var found = false
                for name in table[k] {
                    if name == t.text {
                        found = true
                        break
                    }
                }
                if !found {
                    append(mut &table[k], t.text)
                    unique += 1
                }
            }
        }
        tokens += len(toks)
    }
    println(tokens.toStr() + " " + unique.toStr())
}
