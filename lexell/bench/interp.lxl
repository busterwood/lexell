// An interpreter loop: a stack machine whose instructions are an enum with payloads, run by a
// match in a loop (the shape of a bytecode VM, or of lexdb's and the compiler's tree walks). The
// program sums i * i % 7 for i below N, 17 instructions an iteration.
type Op = value closed { Push(int); Load(int); Store(int); Add; Mul; Mod; Lt; Jz(int); Jmp(int); Halt }

fn program(): []Op {
    return [
        Op.Load(0), Op.Load(2), Op.Lt, Op.Jz(17),                      // while i < n
        Op.Load(1), Op.Load(0), Op.Load(0), Op.Mul, Op.Push(7), Op.Mod,
        Op.Add, Op.Store(1),                                           //   sum += i * i % 7
        Op.Load(0), Op.Push(1), Op.Add, Op.Store(0),                   //   i += 1
        Op.Jmp(0),
        Op.Halt
    ]
}

fn run(code: &[]Op, n: int): int {
    var stack = array(16, 0)
    var sp = 0
    var locals = [0, 0, n]
    var pc = 0
    while true {
        match code[pc] {
            Op.Push(v) {
                stack[sp] = v
                sp += 1
                pc += 1
            }
            Op.Load(k) {
                stack[sp] = locals[k]
                sp += 1
                pc += 1
            }
            Op.Store(k) {
                sp -= 1
                locals[k] = stack[sp]
                pc += 1
            }
            Op.Add {
                sp -= 1
                stack[sp - 1] = stack[sp - 1] + stack[sp]
                pc += 1
            }
            Op.Mul {
                sp -= 1
                stack[sp - 1] = stack[sp - 1] * stack[sp]
                pc += 1
            }
            Op.Mod {
                sp -= 1
                stack[sp - 1] = stack[sp - 1] % stack[sp]
                pc += 1
            }
            Op.Lt {
                sp -= 1
                stack[sp - 1] = if stack[sp - 1] < stack[sp] { 1 } else { 0 }
                pc += 1
            }
            Op.Jz(t) {
                sp -= 1
                pc = if stack[sp] == 0 { t } else { pc + 1 }
            }
            Op.Jmp(t) { pc = t }
            Op.Halt { return locals[1] }
        }
    }
    return 0
}

fn main() {
    let code = program()
    println(run(&code, 10000000).toStr())
}
