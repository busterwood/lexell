// Two-dimensional loops: a 400 x 400 matrix product over arrays of rows of floats (i, k, j
// order), five times. The entries are small whole numbers, so every sum is exact and the
// checksum is the same whatever order a compiler adds in.
fn matrix(n: int, seed: int): [][]float {
    var m: [][]float = []
    for i in 0..n {
        var row = array(n, 0.0f)
        for j in 0..n { row[j] = float((i * seed + j * 7) % 11 - 5) }
        append(mut &m, row)
    }
    return m
}

fn mul(a: &[][]float, b: &[][]float, n: int): [][]float {
    var c: [][]float = []
    for i in 0..n {
        var row = array(n, 0.0f)
        for k in 0..n {
            let aik = a[i][k]
            let bk = &b[k]
            for j in 0..n { row[j] += aik * bk[j] }
        }
        append(mut &c, row)
    }
    return c
}

fn main() {
    let n = 400
    let a = matrix(n, 3)
    let b = matrix(n, 5)
    var total = 0
    for r in 0..5 {
        let c = mul(&a, &b, n)
        var s = 0.0f
        for i in 0..n {
            for j in 0..n { s += c[i][j] * float((i * n + j) % 13 + r) }
        }
        total += int(s)
    }
    println(total.toStr())
}
