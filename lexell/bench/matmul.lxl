// Two-dimensional loops: a 400 x 400 matrix product over arrays of rows of floats (i, k, j
// order), five times. The entries are small whole numbers, so every sum is exact and the
// checksum is the same whatever order a compiler adds in.
type VF = vector[float]

fn matrix(n: int, seed: int): [][]float {
    var m: [][]float = []
    for i in 0..n {
        var row = array(n, 0.0f)
        for j in 0..n { row[j] = float((i * seed + j * 7) % 11 - 5) }
        append(mut &m, row)
    }
    return m
}

fn axpy(dst: mut &[float], src: &[float], a: float) {
    let va = VF.splat(a)
    let l1 = VF.lanes
    let step = VF.lanes * 2
    var j = 0
    while j + step <= len(dst) && j + step <= len(src) {
        let s0 = VF.load(src, j)
        let s1 = VF.load(src, j + l1)
        let r0 = va.fma(s0, VF.load(dst, j))
        let r1 = va.fma(s1, VF.load(dst, j + l1))
        r0.store(dst, j)
        r1.store(dst, j + l1)
        j += step
    }
    while j + l1 <= len(dst) && j + l1 <= len(src) {
        let s = VF.load(src, j)
        let r = va.fma(s, VF.load(dst, j))
        r.store(dst, j)
        j += l1
    }
    if j < len(dst) && j < len(src) {
        va.fma(VF.loadPartial(src, j, 0.0f), VF.loadPartial(dst, j, 0.0f)).storePartial(dst, j)
    }
}

fn mul(a: &[][]float, b: &[][]float, n: int): [][]float {
    var c: [][]float = []
    for i in 0..n {
        var row = array(n, 0.0f)
        for k in 0..n {
            axpy(mut &row, &b[k], a[i][k])
        }
        append(mut &c, row)
    }
    return c
}

fn main() {
    let n = 400
    let a = matrix(n, 3)
    let b = matrix(n, 5)
    var total = 0
    for r in 0..5 {
        let c = mul(&a, &b, n)
        var s = 0.0f
        for i in 0..n {
            for j in 0..n { s += c[i][j] * float((i * n + j) % 13 + r) }
        }
        total += int(s)
    }
    println(total.toStr())
}
