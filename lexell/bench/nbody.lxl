// Floating point: the n-body simulation of the Sun and the four giant planets (symplectic
// integrator, the Computer Language Benchmarks Game's arithmetic in the same order), the energy
// printed before and after as integers (times 1e9, truncated), so every port prints the same.
type Body = value record { x: float; y: float; z: float; vx: float; vy: float; vz: float; mass: float }

const SOLAR: float = 39.47841760435743f     // 4 * PI * PI
const DPY: float = 365.24f

fn bodies(): []Body {
    var bs: []Body = [
        Body{x: 0.0f, y: 0.0f, z: 0.0f, vx: 0.0f, vy: 0.0f, vz: 0.0f, mass: SOLAR},
        Body{x: 4.84143144246472090e+00f, y: -1.16032004402742839e+00f, z: -1.03622044471123109e-01f,
            vx: 1.66007664274403694e-03f * DPY, vy: 7.69901118419740425e-03f * DPY, vz: -6.90460016972063023e-05f * DPY,
            mass: 9.54791938424326609e-04f * SOLAR},
        Body{x: 8.34336671824457987e+00f, y: 4.12479856412430479e+00f, z: -4.03523417114321381e-01f,
            vx: -2.76742510726862411e-03f * DPY, vy: 4.99852801234917238e-03f * DPY, vz: 2.30417297573763929e-05f * DPY,
            mass: 2.85885980666130812e-04f * SOLAR},
        Body{x: 1.28943695621391310e+01f, y: -1.51111514016986312e+01f, z: -2.23307578892655734e-01f,
            vx: 2.96460137564761618e-03f * DPY, vy: 2.37847173959480950e-03f * DPY, vz: -2.96589568540237556e-05f * DPY,
            mass: 4.36624404335156298e-05f * SOLAR},
        Body{x: 1.53796971148509165e+01f, y: -2.59193146099879641e+01f, z: 1.79258772950371181e-01f,
            vx: 2.68067772490389322e-03f * DPY, vy: 1.62824170038242295e-03f * DPY, vz: -9.51592254519715870e-05f * DPY,
            mass: 5.15138902046611451e-05f * SOLAR}
    ]
    var px = 0.0f
    var py = 0.0f
    var pz = 0.0f
    for b in bs {
        px += b.vx * b.mass
        py += b.vy * b.mass
        pz += b.vz * b.mass
    }
    bs[0].vx = -px / SOLAR
    bs[0].vy = -py / SOLAR
    bs[0].vz = -pz / SOLAR
    return bs
}

fn advance(bs: mut &[]Body, dt: float) {
    let n = len(bs)
    for i in 0..n {
        for j in i + 1..n {
            let dx = bs[i].x - bs[j].x
            let dy = bs[i].y - bs[j].y
            let dz = bs[i].z - bs[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * d2.sqrt())
            let mj = bs[j].mass * mag
            bs[i].vx -= dx * mj
            bs[i].vy -= dy * mj
            bs[i].vz -= dz * mj
            let mi = bs[i].mass * mag
            bs[j].vx += dx * mi
            bs[j].vy += dy * mi
            bs[j].vz += dz * mi
        }
    }
    for i in 0..n {
        bs[i].x += dt * bs[i].vx
        bs[i].y += dt * bs[i].vy
        bs[i].z += dt * bs[i].vz
    }
}

fn energy(bs: &[]Body): float {
    var e = 0.0f
    let n = len(bs)
    for i in 0..n {
        let b = bs[i]
        e += 0.5f * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j in i + 1..n {
            let dx = b.x - bs[j].x
            let dy = b.y - bs[j].y
            let dz = b.z - bs[j].z
            e -= b.mass * bs[j].mass / (dx * dx + dy * dy + dz * dz).sqrt()
        }
    }
    return e
}

fn main() {
    var bs = bodies()
    let before = int(energy(&bs) * 1e9f)
    for s in 0..5000000 { advance(mut &bs, 0.01f) }
    println(before.toStr() + " " + int(energy(&bs) * 1e9f).toStr())
}
