#!/bin/sh
# cpu-boost on|off: turn the CPU's frequency boost on or off.
#
# Benchmarks compare engines at a fixed clock: with boost on, a core's
# speed depends on how many other cores are busy and how warm the machine
# is (this Ryzen 7 8745HS boosts to ~4.97 GHz, base ~3.8 GHz), so the same
# query moves 10-25% between runs. bench/tpch/run.sh turns boost off for a
# run and restores it after, through this helper.
#
# Installed root-owned in /usr/local/sbin and allowed without a password
# for exactly its two arguments (see bench/tpch/README.md):
#   sudo install -o root -g root -m 0755 cpu-boost /usr/local/sbin/cpu-boost
#   chris ALL=(root) NOPASSWD: /usr/local/sbin/cpu-boost on, /usr/local/sbin/cpu-boost off
set -eu
f=/sys/devices/system/cpu/cpufreq/boost
case "${1-}" in
    on)  echo 1 > "$f" ;;
    off) echo 0 > "$f" ;;
    *)   echo "usage: cpu-boost on|off" >&2; exit 2 ;;
esac
