// par.map (design/parallel.md): CPU-bound kernels over 64 chunks, and the cost of a call.
//     par hash      strings built and counted in a Map per chunk
//     par decimal   Decimal sums and products per chunk
//     par format    floats formatted and parsed back per chunk
//     par calls     100,000 maps of 8 trivial items
// Run with LXL_PAR=0, 1, 3, 7 for 1, 2, 4 and 8 threads (the calling thread works too).
import "par"

fn hashChunk(c: &int): int {
    var m: Map[str, int] = newMap()
    var acc = 0
    for i in 0..100000 {
        let k = "key" + ((i * 7919 + c) % 5000).toStr()
        m.put(k, m.getOr(&k, 0) + i)
        acc += len(k)
    }
    return acc + m.size()
}

fn decChunk(c: &int): int {
    var s = 0.00m
    var p = 1.0000m
    for i in 0..100000 {
        let d = Decimal.parse(((i + c) % 1000).toStr() + ".25").unwrap()
        s = s + d
        p = (p * 1.0001m).round(4).unwrap()
    }
    return len(s.toStr()) + len(p.toStr())
}

fn fmtChunk(c: &int): int {
    var n = 0
    for i in 0..50000 {
        let x = float(i + c) / 7.0f
        let t = x.toStr()
        n += len(t)
    }
    return n
}

fn one(x: &int): int { return x + 1 }

fn main() {
    let a = args()
    let mode = if len(a) > 1 { a[1] } else { "hash" }
    var idx: []int = []
    for c in 0..64 { append(mut &idx, c) }
    var t = 0
    if mode == "hash" {
        for r in par.map(&idx, hashChunk) { t += r }
    } else if mode == "decimal" {
        for r in par.map(&idx, decChunk) { t += r }
    } else if mode == "format" {
        for r in par.map(&idx, fmtChunk) { t += r }
    } else {
        let small: []int = [1, 2, 3, 4, 5, 6, 7, 8]
        for k in 0..100000 {
            for r in par.map(&small, one) { t += r }
        }
    }
    println(t)
}
