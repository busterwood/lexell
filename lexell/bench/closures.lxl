// Closures and calls through function values: 200,000 records sorted three times by stable sorts
// with comparator closures (by key; by name, then key; by key descending, the direction captured),
// and an array of functions applied to every key. Each port sorts stably, so the orders and the
// checksums are the same.
import "collections"

type Rec = value record { key: int; name: str }

fn inc(v: int): int { return v + 1 }
fn triple(v: int): int { return v * 3 }
fn low(v: int): int { return v % 1000 }
fn seventh(v: int): int { return v / 7 }

fn digest(rs: &[]Rec): int {
    var h = 0
    for r in rs { h = (h * 31 + r.key) % 1000000007 }
    return h
}

fn main() {
    let n = 200000
    var rs: []Rec = []
    var x = 12345
    for i in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648
        append(mut &rs, Rec{key: x % 1000000, name: "n" + (x / 1000 % 50000).toStr()})
    }
    collections.sortBy(mut &rs, fn(a: &Rec, b: &Rec): int { return a.key.cmp(&b.key) })
    let h1 = digest(&rs)
    collections.sortBy(mut &rs, fn(a: &Rec, b: &Rec): int {
        let c = a.name.cmp(&b.name)
        return if c != 0 { c } else { a.key.cmp(&b.key) }
    })
    let h2 = digest(&rs)
    let dir = -1
    collections.sortBy(mut &rs, fn(a: &Rec, b: &Rec): int { return dir * a.key.cmp(&b.key) })
    let h3 = digest(&rs)
    let fs: []fn(int): int = [inc, triple, low, seventh]
    var t = 0
    for round in 0..20 {
        for i in 0..n { t += fs[(i + round) % 4](rs[i].key) }
    }
    println(h1.toStr() + " " + h2.toStr() + " " + h3.toStr() + " " + t.toStr())
}
