// The sieve of Eratosthenes: the primes up to n, found again each round.
// Each prime's multiples are marked from its square, stepping by the prime;
// the counting pass sums 32 flags per iteration with vector[byte].
type VB = vector[byte]

fn main() {
    let n = 10000000
    let vZero = VB.zero()
    var count = 0
    var round = 0
    while round < 30 {
        var prime = array(n + 1, byte(1))
        prime[0] = byte(0)
        prime[1] = byte(0)
        var i = 2
        while i * i <= n {
            if prime[i] != byte(0) {
                var j = i * i
                while j <= n {
                    prime[j] = byte(0)
                    j = j + i
                }
            }
            i = i + 1
        }
        count = 0
        var k = 0
        for v in VB.chunks(&prime, mut &k) {
            count += (v != vZero).bitmask().countOnes()
        }
        let tail = VB.loadPartial(&prime, k, byte(0))
        count += (tail != vZero).bitmask().countOnes()
        round = round + 1
    }
    println(count)
}
