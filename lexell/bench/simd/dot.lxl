// Float dot product: total = sum over rounds of sum a[i] * b[i], n = 65536.
// The scalar lxl reference for the SIMD design note; the C versions are
// bench/simd/dot.c and dot_avx2.c.
fn main() {
    let n = 65536
    let rounds = 4000
    var a: []float = []
    var b: []float = []
    var i = 0
    while i < n {
        append(mut &a, float(i) * 0.5f)
        append(mut &b, float(i) * 0.25f + 1.0f)
        i = i + 1
    }
    var total = 0.0f
    var r = 0
    while r < rounds {
        var s = 0.0f
        i = 0
        while i < n {
            s = s + a[i] * b[i]
            i = i + 1
        }
        total = total + s
        r = r + 1
    }
    println(total)
}
