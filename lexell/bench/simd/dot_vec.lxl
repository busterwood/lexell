// Float dot product using explicit vector[float] with FMA and 4 accumulators
// (matching bench/simd/dot_avx2.c): total = sum over rounds of sum a[i] * b[i], n = 65536.
type VF = vector[float]

fn main() {
    let n = 65536
    let rounds = 4000
    var a: []float = []
    var b: []float = []
    var i = 0
    while i < n {
        append(mut &a, float(i) * 0.5f)
        append(mut &b, float(i) * 0.25f + 1.0f)
        i = i + 1
    }
    var total = 0.0f
    var r = 0
    let l1 = VF.lanes
    let l2 = VF.lanes * 2
    let l3 = VF.lanes * 3
    let step = VF.lanes * 4
    while r < rounds {
        var s0 = VF.zero()
        var s1 = VF.zero()
        var s2 = VF.zero()
        var s3 = VF.zero()
        i = 0
        while i + step <= len(a) && i + step <= len(b) {
            s0 = VF.load(&a, i).fma(VF.load(&b, i), s0)
            s1 = VF.load(&a, i + l1).fma(VF.load(&b, i + l1), s1)
            s2 = VF.load(&a, i + l2).fma(VF.load(&b, i + l2), s2)
            s3 = VF.load(&a, i + l3).fma(VF.load(&b, i + l3), s3)
            i += step
        }
        while i + l1 <= len(a) && i + l1 <= len(b) {
            s0 = VF.load(&a, i).fma(VF.load(&b, i), s0)
            i += l1
        }
        if i < len(a) && i < len(b) {
            s0 = VF.loadPartial(&a, i, 0.0f).fma(VF.loadPartial(&b, i, 0.0f), s0)
        }
        total = total + ((s0 + s1) + (s2 + s3)).sum()
        r = r + 1
    }
    println(total)
}
