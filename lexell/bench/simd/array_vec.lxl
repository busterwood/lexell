// Array indexing: read and write elements across an array built with append,
// using explicit vector[int] loads/stores and wrapping vector arithmetic.
type VI = vector[int]

fn main() {
    let n = 1000000
    var a: []int = []
    var i = 0
    while i < n {
        append(mut &a, i)
        i = i + 1
    }
    var total = 0
    var r = 0
    while r < 800 {
        let vr = VI.splat(r)
        var acc = VI.zero()
        let m = len(a)
        i = 0
        while i + VI.lanes <= m {
            let v = VI.load(&a, i) +% vr
            v.store(mut &a, i)
            acc = acc +% v
            i += VI.lanes
        }
        if i < m {
            let tail = VI.loadPartial(&a, i, 0) +% vr
            tail.storePartial(mut &a, i)
            var t = 0
            while t < m - i {
                total += tail.lane(t)
                t += 1
            }
        }
        total += acc.sum()
        r = r + 1
    }
    println(total)
}
