// A reference to a reference slot: a `mut &P` parameter can be reassigned so that
// the caller's P reference names another object. A residency optimization that
// reads (*x) once at entry must keep that write (the caller's slot), not turn it
// into a write to its local copy. This is the shape the reverted `pin` pass
// miscompiled in regex.obx's compileOnePass: Regex.onepass was never assigned and
// the one-pass program stayed empty.
// expect: 11 9
// expect: 9
type P = record { a: int }

fn bump(x: mut &P, n: int): int {
    let a = x.a
    let b = x.a
    if n > 0 {
        let old = replace(x, P{a: 9})
    }
    return x.a + a + b
}

fn main() {
    var p = P{a: 1}
    let r = bump(mut &p, 1)
    println(r.toStr() + " " + p.a.toStr())
    var q = P{a: 2}
    let old = replace(mut &q, P{a: 9})
    println(q.a.toStr())
}
