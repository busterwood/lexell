// errors: OS error text and Rust's debug quoting for paths.
//
// osError is Rust io::Error's Display form, "<text> (os error N)", which eza
// prints for path and write diagnostics. The text comes from io.errorText,
// the one errno-text source; there is no second errno table here.
//
// debugPath reproduces Rust's OsStr/Path Debug quoting: the path in double
// quotes; `\"`, `\'` and `\\` are backslash-escaped; NUL is \0; \t, \r and \n
// use the short escapes; every other byte below 0x20 and 0x7F becomes
// \u{h} with lowercase hex and no leading zeros; every other byte is copied
// unchanged, including bytes >= 0x80 whether or not they form valid UTF-8.

import "io"

// Rust io::Error's Display form for an OS error: "<text> (os error N)".
pub fn osError(errno: int): str {
    return io.errorText(errno) + " (os error " + intToStr(errno) + ")"
}

// The obo name for io.errorText, kept as an alias so a ported caller reads
// naturally. It deliberately adds no text of its own.
pub fn text(errno: int): str { return io.errorText(errno) }

// Append a lowercase hex byte with no leading zero (the \u{...} payload):
// 0 -> "0", 0x1b -> "1b", 0x7f -> "7f".
fn appendHexByte(out: mut &[]byte, b: byte) {
    let digits = "0123456789abcdef"
    let hi = int(b) / 16
    let lo = int(b) % 16
    if hi > 0 { append(out, strByte(digits, hi)) }
    append(out, strByte(digits, lo))
}

// Rust's OsStr/Path Debug quoting for one path, as eza prints it on stderr.
pub fn debugPath(p: str): str {
    var out: []byte = []
    append(mut &out, '"')
    for i in 0..len(p) {
        let b = strByte(p, i)
        if b == '"' {
            append(mut &out, '\\')
            append(mut &out, '"')
        } else if b == '\'' {
            append(mut &out, '\\')
            append(mut &out, '\'')
        } else if b == '\\' {
            append(mut &out, '\\')
            append(mut &out, '\\')
        } else if b == '\t' {
            append(mut &out, '\\')
            append(mut &out, 't')
        } else if b == '\n' {
            append(mut &out, '\\')
            append(mut &out, 'n')
        } else if b == '\r' {
            append(mut &out, '\\')
            append(mut &out, 'r')
        } else if b == byte(0) {
            append(mut &out, '\\')
            append(mut &out, '0')
        } else if b < byte(0x20) || b == byte(0x7f) {
            append(mut &out, '\\')
            append(mut &out, 'u')
            append(mut &out, '{')
            appendHexByte(mut &out, b)
            append(mut &out, '}')
        } else {
            append(mut &out, b)
        }
    }
    append(mut &out, '"')
    return strFromBytes(&out)
}
