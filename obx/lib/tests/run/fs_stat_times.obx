// Stat gains atime and ctime (the runtime's fields 9 and 10) at the end of the
// record. A freshly created and written file has non-negative times that are
// close to each other; ctime is the creation/status-change time, so it cannot
// be meaningfully older than mtime.
// expect: times sane true
// expect: lstat times sane true

import "io"
import "fs"
import "os"

fn check[T](r: Result[T, io.IoError]): T {
    match move(r) {
        Ok(v) { return v }
        Err(e) {
            eprintln("unexpected: " + e.toStr())
            exit(1)
        }
    }
}

fn sane(s: fs.Stat): bool {
    return s.atime >= 0 && s.ctime >= 0 && s.mtime >= 0 &&
        s.ctime + 2 >= s.mtime && s.atime <= s.mtime + 2
}

fn main() {
    let dir = "/tmp/obx_lib_fs_stat_times_" + os.pid().toStr()
    fs.removeAll(dir)
    check(fs.mkdirAll(dir))
    let path = fs.join(dir, "stamp.txt")
    check(io.write(path, "stamp"))
    let st = check(fs.stat(path))
    println("times sane " + sane(st).toStr())
    if !sane(st) {
        println("mtime " + st.mtime.toStr() + " atime " + st.atime.toStr() + " ctime " + st.ctime.toStr())
    }
    let lst = check(fs.lstat(path))
    println("lstat times sane " + sane(lst).toStr())
    check(fs.removeAll(dir))
}
