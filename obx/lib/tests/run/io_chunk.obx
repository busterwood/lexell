// io.ChunkReader: an empty input, a chunk smaller than the buffer, two full
// buffers, a read error after close, and fill repeatedly at the end of input.
// expect: empty 0 0
// expect: empty again 0
// expect: small 3 97 99 0 0
// expect: small again 0
// expect: exact 65536 65536 131072 97 98 0
// expect: sized 4 4 97 100 2 101 102 0
// expect: closed -9
import "fs"
import "io"
import "os"

fn main() {
    let base = "/tmp/obx_io_chunk_" + os.pid().toStr()

    let emptyPath = base + "_empty"
    io.write(emptyPath, "").unwrap()
    let emptySrc = io.open(emptyPath).unwrap()
    var empty = io.newChunkReader(emptySrc)
    let e1 = empty.fill()
    let e2 = empty.fill()
    println("empty " + e1.toStr() + " " + e2.toStr())
    println("empty again " + empty.fill().toStr())

    let smallPath = base + "_small"
    io.write(smallPath, "abc").unwrap()
    let smallSrc = io.open(smallPath).unwrap()
    var small = io.newChunkReader(smallSrc)
    let s1 = small.fill()
    let s2 = small.fill()
    println("small " + s1.toStr() + " " + int(small.buf[0]).toStr() + " " +
        int(small.buf[s1 - 1]).toStr() + " " + s2.toStr() + " " + small.fill().toStr())
    println("small again " + small.fill().toStr())

    // exactly two buffers: 'a' * 65536 then 'b' * 65536
    var abuf = newStrBuf()
    var bbuf = newStrBuf()
    for i in 0..65536 {
        abuf.addByte('a')
        bbuf.addByte('b')
    }
    let exactPath = base + "_exact"
    io.write(exactPath, abuf.toStr() + bbuf.toStr()).unwrap()
    let exactSrc = io.open(exactPath).unwrap()
    var exact = io.newChunkReader(exactSrc)
    let x1 = exact.fill()
    let first = int(exact.buf[0])
    let x2 = exact.fill()
    let second = int(exact.buf[0])
    let x3 = exact.fill()
    println("exact " + len(exact.buf).toStr() + " " + x1.toStr() + " " + (x1 + x2).toStr() + " " +
        first.toStr() + " " + second.toStr() + " " + x3.toStr())

    // an explicit smaller buffer is honored: 4 bytes, then the 2-byte tail
    let sizedPath = base + "_sized"
    io.write(sizedPath, "abcdef").unwrap()
    let sizedSrc = io.open(sizedPath).unwrap()
    var sized = io.newChunkReaderSize(sizedSrc, 4)
    let z1 = sized.fill()
    let za = int(sized.buf[0])
    let zd = int(sized.buf[3])
    let z2 = sized.fill()
    let ze = int(sized.buf[0])
    let zf = int(sized.buf[1])
    let z3 = sized.fill()
    println("sized " + len(sized.buf).toStr() + " " + z1.toStr() + " " + za.toStr() + " " +
        zd.toStr() + " " + z2.toStr() + " " + ze.toStr() + " " + zf.toStr() + " " + z3.toStr())

    // a closed descriptor: fill reports minus EBADF, and keeps doing so
    var badSrc = io.open(smallPath).unwrap()
    badSrc.close().unwrap()
    var bad = io.newChunkReader(badSrc)
    println("closed " + bad.fill().toStr())

    fs.remove(emptyPath).unwrap()
    fs.remove(smallPath).unwrap()
    fs.remove(exactPath).unwrap()
    fs.remove(sizedPath).unwrap()
}
