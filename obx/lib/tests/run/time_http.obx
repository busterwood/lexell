// time: httpDate is RFC 7231 IMF-fixdate in GMT, byte for byte.
// expect: Thu, 01 Jan 1970 00:00:00 GMT
// expect: Thu, 05 Nov 2026 13:45:07 GMT
// expect: Thu, 29 Feb 2024 00:00:00 GMT
// expect: Fri, 05 Jan 2024 00:00:00 GMT
// expect: Wed, 31 Dec 1969 23:59:59 GMT
// expect: exact
import "time"

fn main() {
    let a = time.httpDate(0)
    let b = time.httpDate(1793886307)
    let c = time.httpDate(1709164800)
    let d = time.httpDate(1704412800)
    let e = time.httpDate(-1)
    println(a)
    println(b)
    println(c)
    println(d)
    println(e)
    var ok = true
    if a != "Thu, 01 Jan 1970 00:00:00 GMT" { ok = false }
    if b != "Thu, 05 Nov 2026 13:45:07 GMT" { ok = false }
    if c != "Thu, 29 Feb 2024 00:00:00 GMT" { ok = false }
    if d != "Fri, 05 Jan 2024 00:00:00 GMT" { ok = false }
    if e != "Wed, 31 Dec 1969 23:59:59 GMT" { ok = false }
    if len(a) != 29 { ok = false }
    if ok { println("exact") }
}
