// io.copy, io.count and io.readAll: a small file, an empty file, and reads and
// writes on closed descriptors.
// expect: copy 12 true
// expect: count 12
// expect: readAll 12 true
// expect: empty copy 0
// expect: empty count 0
// expect: empty readAll 0 true
// expect: closed read count 9
// expect: closed read all 9
// expect: closed read copy 9
// expect: closed write copy 9
import "fs"
import "io"
import "os"

fn main() {
    let base = "/tmp/obx_io_copy_" + os.pid().toStr()
    let srcPath = base + "_src"
    let dstPath = base + "_dst"
    let emptyPath = base + "_empty"
    let data = "hello\nworld\n"
    io.write(srcPath, data).unwrap()
    io.write(emptyPath, "").unwrap()

    var src = io.open(srcPath).unwrap()
    var dst = io.create(dstPath).unwrap()
    let total = io.copy(mut &dst, mut &src).unwrap()
    dst.close().unwrap()
    src.close().unwrap()
    println("copy " + total.toStr() + " " + (io.read(dstPath).unwrap() == data).toStr())

    var countSrc = io.open(srcPath).unwrap()
    let counted = io.count(mut &countSrc).unwrap()
    countSrc.close().unwrap()
    println("count " + counted.toStr())

    var allSrc = io.open(srcPath).unwrap()
    let all = io.readAll(mut &allSrc).unwrap()
    allSrc.close().unwrap()
    println("readAll " + len(all).toStr() + " " + (all == data).toStr())

    var emptySrc = io.open(emptyPath).unwrap()
    var emptyDst = io.create(dstPath).unwrap()
    let emptyCopy = io.copy(mut &emptyDst, mut &emptySrc).unwrap()
    emptyDst.close().unwrap()
    println("empty copy " + emptyCopy.toStr())
    var emptyCountSrc = io.open(emptyPath).unwrap()
    println("empty count " + io.count(mut &emptyCountSrc).unwrap().toStr())
    var emptyAllSrc = io.open(emptyPath).unwrap()
    let emptyAll = io.readAll(mut &emptyAllSrc).unwrap()
    println("empty readAll " + len(emptyAll).toStr() + " " + (emptyAll == "").toStr())

    var closedRead = io.open(srcPath).unwrap()
    closedRead.close().unwrap()
    match io.count(mut &closedRead) {
        Ok(n) { println("closed read count " + n.toStr()) }
        Err(e) { println("closed read count " + e.errno.toStr()) }
    }
    match io.readAll(mut &closedRead) {
        Ok(s) { println("closed read all " + len(s).toStr()) }
        Err(e) { println("closed read all " + e.errno.toStr()) }
    }
    var closedSrc = io.open(srcPath).unwrap()
    closedSrc.close().unwrap()
    var sink = io.create(dstPath).unwrap()
    match io.copy(mut &sink, mut &closedSrc) {
        Ok(n) { println("closed read copy " + n.toStr()) }
        Err(e) { println("closed read copy " + e.errno.toStr()) }
    }
    sink.close().unwrap()

    var writeSrc = io.open(srcPath).unwrap()
    var closedDst = io.create(dstPath).unwrap()
    closedDst.close().unwrap()
    match io.copy(mut &closedDst, mut &writeSrc) {
        Ok(n) { println("closed write copy " + n.toStr()) }
        Err(e) { println("closed write copy " + e.errno.toStr()) }
    }

    fs.remove(srcPath).unwrap()
    fs.remove(dstPath).unwrap()
    fs.remove(emptyPath).unwrap()
}
