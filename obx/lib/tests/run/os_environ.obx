// os: the process environment. The test sets its own variable and assumes
// nothing about the rest of the environment.
// expect: environ has the set variable: true
// expect: value splits at the first =: true
// expect: every entry has a name: true
// expect: entry gone after unset: true
import "os"

fn main() {
    let name = "OBX_LIB_OS_ENVIRON_" + os.pid().toStr()
    os.unsetEnv(name).unwrap()
    os.setEnv(name, "first=second").unwrap()

    var found = false
    var valueOk = false
    for e in os.environ() {
        if e.name == name {
            found = true
            valueOk = e.value == "first=second"
        }
    }
    println("environ has the set variable: " + found.toStr())
    println("value splits at the first =: " + valueOk.toStr())

    var namesOk = true
    for e in os.environ() {
        if len(e.name) == 0 || indexOf(e.name, "=", 0) >= 0 { namesOk = false }
    }
    println("every entry has a name: " + namesOk.toStr())

    os.unsetEnv(name).unwrap()
    var gone = true
    for e in os.environ() { if e.name == name { gone = false } }
    println("entry gone after unset: " + gone.toStr())
}
