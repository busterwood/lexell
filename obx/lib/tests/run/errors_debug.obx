// errors: Rust OsStr/Path Debug quoting (debugPath) and the Rust-shaped
// OS error Display (osError). Expected debug forms are the rustc OsStr forms:
// quotes, \" \' \\, \0, the \t \r \n short escapes, \u{h} with lowercase hex
// for other controls and DEL, and every other byte copied unchanged (valid
// UTF-8 as characters, bytes >= 0x80 even when they are not valid UTF-8).
// The osError checks compare against io.errorText, the one errno-text source,
// so they do not pin a locale beyond what io.errorText itself does.
// expect: "missing" "a b" ""
// expect: "a\'b" "a\"b" "a\\b"
// expect: "a\tb" "a\rb" "a\nb"
// expect: "a\0b" "\u{1}" "\u{7f}"
// expect: "café" true true
// expect: true true true
// expect: true true true
import "errors"
import "io"

fn one(a: byte): str {
    var b: []byte = array(1, byte(0))
    b[0] = a
    return strFromBytes(&b)
}

fn b3(a: byte, b: byte, c: byte): str {
    var out: []byte = array(3, byte(0))
    out[0] = a
    out[1] = b
    out[2] = c
    return strFromBytes(&out)
}

// Whether debugPath passes byte a through inside the quotes: 0xFF and a lone
// 0x80 are copied byte-wise, not escaped and not lossily replaced.
fn copiesByte(a: byte): bool {
    var want: []byte = array(3, byte(0))
    want[0] = '"'
    want[1] = a
    want[2] = '"'
    return errors.debugPath(one(a)) == strFromBytes(&want)
}

fn osOk(n: int): bool {
    return errors.osError(n) == io.errorText(n) + " (os error " + intToStr(n) + ")"
}

fn main() {
    // simple ASCII names are just quoted
    println(errors.debugPath("missing") + " " + errors.debugPath("a b") + " " + errors.debugPath(""))
    // the Rust escapes: apostrophe, double quote and backslash
    println(errors.debugPath("a'b") + " " + errors.debugPath("a\"b") + " " + errors.debugPath("a\\b"))
    // tab, CR and LF use the short escapes
    println(errors.debugPath("a\tb") + " " + errors.debugPath("a\rb") + " " + errors.debugPath("a\nb"))
    // NUL, another control and DEL use \0 or \u{h} with lowercase hex
    println(errors.debugPath(b3('a', byte(0), 'b')) + " " + errors.debugPath(one(byte(1))) + " " +
        errors.debugPath(one(byte(127))))
    // valid UTF-8 is copied; 0xFF and a lone 0x80 are copied unchanged too
    println(errors.debugPath("caf\xC3\xA9") + " " + copiesByte(byte(0xFF)).toStr() + " " +
        copiesByte(byte(0x80)).toStr())
    // osError: io.errorText plus " (os error N)", including the unknown fallback
    println(osOk(2).toStr() + " " + osOk(13).toStr() + " " + osOk(99).toStr())
    // text is the obo name for io.errorText, not a second table
    println((errors.text(2) == io.errorText(2)).toStr() + " " +
        (errors.text(13) == io.errorText(13)).toStr() + " " +
        (errors.text(99) == io.errorText(99)).toStr())
}
