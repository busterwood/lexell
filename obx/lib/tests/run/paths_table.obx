// paths_table: the lexical path primitives. isAbsolute/hasTrailingSlash/
// isDotName, the Rust Path::join shape, extension (Path::extension shape), and
// the lastComponent/parentOf table (verified against rustc 1.87).
//
// The obo table also checked the eza operand-display normalization built from
// parentOf + lastComponent + strings.parentPrefix. That belongs to the strings
// workstream: quoteName/parentPrefix are not in obx/lib/strings.obx yet, so
// those checks stay in the obo corpus until they land. No paths code is
// involved beyond the parentOf/lastComponent cases below.
// expect: paths table ok
import "paths"

fn checkStr(label: str, got: str, want: str) {
    if got != want {
        panic("paths " + label + ": got \"" + got + "\", want \"" + want + "\"")
    }
}

fn checkBool(label: str, got: bool, want: bool) {
    if got != want {
        panic("paths " + label + ": got " + got.toStr() + ", want " + want.toStr())
    }
}

fn lastEq(label: str, p: str, want: str) {
    checkStr("last " + label, paths.lastComponent(p), want)
}

fn parentEq(label: str, p: str, want: str) {
    checkStr("parent " + label, paths.parentOf(p), want)
}

fn extEq(label: str, p: str, want: str) {
    checkStr("extension " + label, paths.extension(p), want)
}

fn joinEq(label: str, a: str, b: str, want: str) {
    checkStr("join " + label, paths.join(a, b), want)
}

fn main() {
    // isAbsolute: non-empty and starts with '/'
    checkBool("abs empty", paths.isAbsolute(""), false)
    checkBool("abs root", paths.isAbsolute("/"), true)
    checkBool("abs double", paths.isAbsolute("//"), true)
    checkBool("abs a", paths.isAbsolute("a"), false)
    checkBool("abs dot", paths.isAbsolute("./a"), false)
    checkBool("abs a slash", paths.isAbsolute("/a"), true)
    checkBool("abs space", paths.isAbsolute(" "), false)
    checkBool("abs dotdot", paths.isAbsolute(".."), false)

    // hasTrailingSlash: non-empty and ends with '/'
    checkBool("trail empty", paths.hasTrailingSlash(""), false)
    checkBool("trail root", paths.hasTrailingSlash("/"), true)
    checkBool("trail double", paths.hasTrailingSlash("//"), true)
    checkBool("trail a", paths.hasTrailingSlash("a"), false)
    checkBool("trail a/", paths.hasTrailingSlash("a/"), true)
    checkBool("trail a//", paths.hasTrailingSlash("a//"), true)
    checkBool("trail a/b", paths.hasTrailingSlash("a/b"), false)
    checkBool("trail ./", paths.hasTrailingSlash("./"), true)
    checkBool("trail dot", paths.hasTrailingSlash("."), false)

    // isDotName: exactly "." or ".."
    checkBool("dotname dot", paths.isDotName("."), true)
    checkBool("dotname dotdot", paths.isDotName(".."), true)
    checkBool("dotname three", paths.isDotName("..."), false)
    checkBool("dotname empty", paths.isDotName(""), false)
    checkBool("dotname a", paths.isDotName("a"), false)
    checkBool("dotname ./", paths.isDotName("./"), false)
    checkBool("dotname dot space", paths.isDotName(". "), false)
    checkBool("dotname space dot", paths.isDotName(" ."), false)

    // extension: the design table
    extEq("bashrc", ".bashrc", "")
    extEq("tar.gz", "a.tar.gz", "gz")
    extEq("a dot", "a.", "")
    extEq("a..b", "a..b", "b")
    extEq("dotdot", "..", "")
    extEq("dot", ".", "")
    extEq("empty", "", "")
    // extension: component-aware cases verified with rustc 1.87
    extEq("sub", "a/b.c", "c")
    extEq("hidden sub", "dir/.hidden", "")
    extEq("trailing slash", "a/b.c/", "c")
    extEq("dotdot x", "..x", "x")
    extEq("a..", "a..", "")
    extEq("three dots", "...", "")
    extEq("x/", "x/.", "")
    extEq("hidden ext", "a/.b.c", "c")
    extEq("root", "/", "")
    extEq("dot component skipped", "a.b/.", "b")
    extEq("hidden targz", "x/.tar.gz/.", "gz")
    extEq("b..c", "a/b..c", "c")
    extEq("d no ext", "a/b..c/d", "")
    extEq("file dot", "file.", "")
    extEq("c dot", "a.b/c.", "")
    extEq("double slash", "a/b//c.d", "d")
    extEq("dot component", "d/./e.txt", "txt")
    extEq("hidden trailing", "a/.hidden/", "")

    // join: the design table and the Rust spellings
    joinEq("empty empty", "", "", "")
    joinEq("empty a", "", "a", "a")
    joinEq("a empty", "a", "", "a/")
    joinEq("a/ empty", "a/", "", "a/")
    joinEq("a b", "a", "b", "a/b")
    joinEq("a/ b", "a/", "b", "a/b")
    joinEq("root b", "/", "b", "/b")
    joinEq("a /b", "a", "/b", "/b")
    joinEq("a ../b", "a", "../b", "a/../b")
    joinEq("dot dotdot", ".", "..", "./..")
    joinEq("root dotdot", "/", "..", "/..")
    joinEq("dir/ dotdot", "dir/", "..", "dir/..")
    joinEq("a// b", "a//", "b", "a//b")
    joinEq("double root b", "//", "b", "//b")
    joinEq("a//b c", "a//b", "c", "a//b/c")
    joinEq("a dot", "a", ".", "a/.")
    joinEq("dot empty", ".", "", "./")
    joinEq("a/ /b", "a/", "/b", "/b")
    joinEq("root root", "/", "/", "/")
    joinEq("no cleaning", "a", "../b", "a/../b")

    // lastComponent/parentOf: the design table
    lastEq("root", "/", "/")
    parentEq("root", "/", "")
    lastEq("dot", ".", ".")
    parentEq("dot", ".", "")
    lastEq("dotdot", "..", "..")
    parentEq("dotdot", "..", "")
    lastEq("empty", "", ".")
    parentEq("empty", "", "")
    lastEq("a", "a", "a")
    parentEq("a", "a", "")
    lastEq("a/", "a/", "a")
    parentEq("a/", "a/", "")
    lastEq("a/b", "a/b", "b")
    parentEq("a/b", "a/b", "a")
    lastEq("a//b", "a//b", "b")
    parentEq("a//b", "a//b", "a")
    lastEq("a/./b", "a/./b", "b")
    parentEq("a/./b", "a/./b", "a")
    lastEq("./a", "./a", "a")
    parentEq("./a", "./a", ".")
    lastEq("/a", "/a", "a")
    parentEq("/a", "/a", "/")
    lastEq("/a/b", "/a/b", "b")
    parentEq("/a/b", "/a/b", "/a")
    lastEq("//a", "//a", "a")
    parentEq("//a", "//a", "/")
    lastEq("/tmp/dir/", "/tmp/dir/", "dir")
    parentEq("/tmp/dir/", "/tmp/dir/", "/tmp")

    // lastComponent/parentOf: the verified spellings beyond the design table
    lastEq("//a/b", "//a/b", "b")
    parentEq("//a/b", "//a/b", "//a")
    lastEq("/./a/b", "/./a/b", "b")
    parentEq("/./a/b", "/./a/b", "/./a")
    lastEq("a/..//b", "a/..//b", "b")
    parentEq("a/..//b", "a/..//b", "a/..")
    lastEq("a/././b", "a/././b", "b")
    parentEq("a/././b", "a/././b", "a")
    lastEq("///a/b", "///a/b", "b")
    parentEq("///a/b", "///a/b", "///a")
    lastEq("/a//b", "/a//b", "b")
    parentEq("/a//b", "/a//b", "/a")
    lastEq("a/b//c//", "a/b//c//", "c")
    parentEq("a/b//c//", "a/b//c//", "a/b")
    lastEq("..//a", "..//a", "a")
    parentEq("..//a", "..//a", "..")
    lastEq(".././a", ".././a", "a")
    parentEq(".././a", ".././a", "..")
    lastEq("a/../b", "a/../b", "b")
    parentEq("a/../b", "a/../b", "a/..")
    lastEq("././a", "././a", "a")
    parentEq("././a", "././a", ".")
    lastEq("./a/./b/", "./a/./b/", "b")
    parentEq("./a/./b/", "./a/./b/", "./a")
    lastEq("x//y//", "x//y//", "y")
    parentEq("x//y//", "x//y//", "x")
    lastEq("a/./", "a/./", "a")
    parentEq("a/./", "a/./", "")
    lastEq("a/b/", "a/b/", "b")
    parentEq("a/b/", "a/b/", "a")
    lastEq("/../a", "/../a", "a")
    parentEq("/../a", "/../a", "/..")
    lastEq("/..", "/..", "..")
    parentEq("/..", "/..", "/")
    lastEq("/.", "/.", "/")
    parentEq("/.", "/.", "")
    lastEq("./", "./", ".")
    parentEq("./", "./", "")
    lastEq("...", "...", "...")
    parentEq("...", "...", "")
    lastEq("spaced", "a b/c d", "c d")
    parentEq("spaced", "a b/c d", "a b")
    lastEq("spaced one", "a b", "a b")
    parentEq("spaced one", "a b", "")
    lastEq("hidden", "a/.hidden/", ".hidden")
    parentEq("hidden", "a/.hidden/", "a")
    lastEq("dot comp", "d/./e.txt", "e.txt")
    parentEq("dot comp", "d/./e.txt", "d")

    println("paths table ok")
}
