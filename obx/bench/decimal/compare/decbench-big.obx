// 38-digit cases for obx's Decimal: 38-digit add, 19x19 mul, 38-digit parse
// and 38-digit format. Matched with DecBenchBig.java; .NET's decimal cannot
// represent these (96-bit, 28-29 digits).

import "time"

const N: int = 4096

var SEED: u64 = 0x2545f4914f6cdd1d

fn next(): u64 {
    SEED = SEED +% 0x9e3779b97f4a7c15
    var z = SEED
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    return z ^ (z >> 31)
}

fn below(n: int): int { return int(next() % u64(n)) }

fn p10(k: int): u128 {
    var x: u128 = 1
    for i in 0..k { x = x * 10 }
    return x
}

fn coefNZ(d: int): u128 {
    let lo = p10(d - 1)
    let range = 9 * lo
    var c = lo + u128(next()) % range
    if c % 10 == 0 { c += 1 }
    return c
}

fn coefBig(d: int): u128 {
    let lo = p10(d - 1)
    let range = 9 * lo
    let r = (u128(next()) << 64) | u128(next())
    var c = lo + r % range
    if c % 10 == 0 { c += 1 }
    return c
}

fn dec(c: u128, scale: int, neg: bool): Decimal {
    var u = i128(c)
    if neg { u = -u }
    return fromFraction(u, scale)
}

fn pad(c: u128, n: int): str {
    var s = u128ToStr(c)
    while len(s) < n { s = "0" + s }
    return s
}

fn resHash(d: Decimal): u64 {
    var x = u64(d.coefficient() & 0xffffffffffffffff) ^ u64(d.scale())
    if d.isNeg() { x = x ^ 1 }
    return x
}

fn benchAdd(xs: &[]Decimal, ys: &[]Decimal, reps: int): u64 {
    var a: u64 = 0
    for r in 0..reps {
        for i in 0..N { a = a +% resHash(xs[i].add(ys[i])) }
    }
    return a
}

fn benchMul(xs: &[]Decimal, ys: &[]Decimal, reps: int): u64 {
    var a: u64 = 0
    for r in 0..reps {
        for i in 0..N { a = a +% resHash(xs[i].mul(ys[i])) }
    }
    return a
}

fn benchParse(xs: &[]str, reps: int): u64 {
    var a: u64 = 0
    for r in 0..reps {
        for i in 0..N {
            match Decimal.parse(xs[i]) {
                Ok(d) { a = a +% resHash(d) }
                Err(e) { a = a +% 5 }
            }
        }
    }
    return a
}

fn benchFormat(xs: &[]Decimal, reps: int): u64 {
    var a: u64 = 0
    for r in 0..reps {
        for i in 0..N { a = a +% u64(len(xs[i].toStr())) }
    }
    return a
}

fn report(name: str, best: int, acc: u64, reps: int) {
    let ops = reps * N
    let ns = float(best) / float(ops)
    println(name + " " + ns.toStr() + " " + acc.toStr())
}

fn main() {
    var xs38: []Decimal = []
    var ys38: []Decimal = []
    var xm: []Decimal = []
    var ym: []Decimal = []
    var fmts: []Decimal = []
    var parseStrs: []str = []

    for i in 0..N {
        let a = coefBig(37)
        let na = below(4) == 0
        append(mut &xs38, dec(a, 2, na))
        let b = coefBig(37)
        append(mut &ys38, dec(b, 2, false))

        let ma = coefNZ(19)
        let nma = below(2) == 0
        append(mut &xm, dec(ma, 4, nma))
        let mb = coefNZ(19)
        append(mut &ym, dec(mb, 3, false))

        let digits = pad(coefBig(38), 38)
        var t = strSlice(digits, 0, 34) + "." + strSlice(digits, 34, 38)
        if below(3) == 0 { t = "-" + t }
        append(mut &parseStrs, t)

        let fc = coefBig(38)
        let nf = below(3) == 0
        append(mut &fmts, dec(fc, 2, nf))
    }

    var best = -1
    var acc: u64 = 0
    for k in 0..7 {
        let t0 = time.monotonicNs()
        acc = benchAdd(&xs38, &ys38, 1000)
        let dt = time.monotonicNs() - t0
        if best < 0 || dt < best { best = dt }
    }
    report("add37", best, acc, 1000)

    best = -1
    for k in 0..7 {
        let t0 = time.monotonicNs()
        acc = benchMul(&xm, &ym, 1000)
        let dt = time.monotonicNs() - t0
        if best < 0 || dt < best { best = dt }
    }
    report("mul19", best, acc, 1000)

    best = -1
    for k in 0..7 {
        let t0 = time.monotonicNs()
        acc = benchParse(&parseStrs, 500)
        let dt = time.monotonicNs() - t0
        if best < 0 || dt < best { best = dt }
    }
    report("parse38", best, acc, 500)

    best = -1
    for k in 0..7 {
        let t0 = time.monotonicNs()
        acc = benchFormat(&fmts, 250)
        let dt = time.monotonicNs() - t0
        if best < 0 || dt < best { best = dt }
    }
    report("format38", best, acc, 250)
}
